<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.macro.thetadata-backfill.plist
  launchd keepalive for the ThetaData EOD backfill job.

  Behaviour:
    • Runs theta_backfill_keepalive.sh on login (RunAtLoad=true).
    • KeepAlive={SuccessfulExit=false} + ThrottleInterval=60s:
        - exit 0 (universe pass complete, or normal clean finish) → launchd does NOT restart.
        - exit non-zero (crash, duplicate guard) → launchd restarts after 60 s.
    • The wrapper checks _manifest.json first; if the universe pass is marked complete it
      exits 0 and launchd stops restarting — no infinite loop after the work is done.
    • The duplicate guard exits 1 so launchd retries until the running instance finishes.

  Install / uninstall — see scripts/launchd/theta_backfill_keepalive.sh header
  or research/THETADATA_OPS_RUNBOOK.md §3.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macro.thetadata-backfill</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/chriswong/Documents/Cluade/Macro Dashboard/scripts/launchd/theta_backfill_keepalive.sh</string>
    </array>

    <!-- Start immediately on load / login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart only on non-zero exit (crash or duplicate guard); exit-0 = done, no restart -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Wait 60 s before restarting (prevents tight-loop if the job crashes immediately) -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- Working directory: the ops worktree; the wrapper also cd's there explicitly -->
    <key>WorkingDirectory</key>
    <string>/Users/chriswong/theta-ops-wt</string>

    <!-- Redirect stdout/stderr so launchd itself captures the pre-cd guard message -->
    <key>StandardOutPath</key>
    <string>/Users/chriswong/theta-ops-wt/backfill.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/chriswong/theta-ops-wt/backfill.log</string>

    <!-- Only run for the specific user session — not as a system daemon -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
