[Unit]
Description=Mastermind Admin console (deployed, authenticated)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/macro
# Secrets live here (root-only 0600). The leading '-' makes it optional so the
# unit still loads if the file is briefly absent — deployed mode is forced by the
# --deployed flag below, and the app refuses to start without ADMIN_PASSWORD
# (settings.startup_check), so a missing file fails CLOSED, never open.
EnvironmentFile=-/etc/macro-admin.env
# Use the same refreshable Codex account state as macro-api so every deployed
# AI surface sees the same Claude OAuth + Codex subscription pool.
Environment=CODEX_HOME=/var/lib/macro-codex
Environment=CODEX_ACCOUNT_HOMES=/var/lib/macro-codex:/var/lib/macro-codex-2
Environment=CODEX_PROVIDER_ENABLED=1
StateDirectory=macro-codex macro-codex-2
StateDirectoryMode=0700
# ── Site Access Gate env (optional; admin reads/writes the same store) ────────
# SITE_GATE_STATE=/var/lib/macro-api/site_gate.json  # blocklist store (must match macro-api.service)
# Bind loopback only; Caddy reverse-proxies admin.mastermind-x.com → here.
ExecStart=/opt/macro/.venv/bin/python -m admin --deployed --host 127.0.0.1 --port 8787
Restart=always
RestartSec=2
# Read-only git porcelain (status/rev-parse) runs in /opt/macro on every summary;
# stop git taking optional index/refs locks so a read-mostly tree never trips it.
Environment=GIT_OPTIONAL_LOCKS=0

# Hardening — the console writes nothing to disk (config edits go out via the
# GitHub API). ProtectSystem=full (not strict) leaves /opt writable for git's
# opportunistic index refresh, matching macro-api.service; everything else locked.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
