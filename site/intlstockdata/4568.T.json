6\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9\uff088 \u5929\u524d\uff09", "\u6446\u52a8\u4f4e\u70b9\u5df2\u73b0\uff08\u4e70\u65b9\u62d2\u7edd\u4e86\u8be5\u4f4e\u70b9\uff09", "\u4ecd\u4f4d\u4e8e 10 \u65e5\u5747\u7ebf\u4e4b\u4e0b", "\u65e5\u7ebf\u52a8\u91cf\u8ddd\u8f6c\u4e3a\u5411\u4e0a\u7ea6 0 \u6839 K \u7ebf"], "early_note_zh": "", "liq_regime": null, "liq_effect": null, "liq_line": "", "liq_line_zh": "", "macro_effect": null, "macro_pen": 0, "macro_drag": null, "macro_beta": 0.0, "macro_line": "", "macro_line_zh": "", "age_days": 0, "age_capped": false, "prev_state": "COUNTERTREND BOUNCE", "signal_date": "2026-06-16", "strength": "strong", "strength_zh": "\u5f3a", "age_line": "\u23f1 DOWNTREND signal just triggered today (fresh cross from UNCONFIRMED TURN). Signal strength: strong (score -80/100).", "age_line_zh": "\u23f1 \u4e0b\u8dcc\u8d8b\u52bf\u4fe1\u53f7\u4e8e\u4eca\u65e5\u521a\u521a\u89e6\u53d1\uff08\u5168\u65b0\u4ea4\u53c9\uff0c\u81ea\u672a\u786e\u8ba4\u8f6c\u5411\u7ffb\u8f6c\uff09\u3002 \u4fe1\u53f7\u5f3a\u5ea6\uff1a\u5f3a\uff08\u8bc4\u5206 -80/100\uff09\u3002", "age_short": "today", "age_short_zh": "\u4eca\u65e5", "eq_score": -70.0, "eq_grade": "strong", "eq_grade_zh": "\u5f3a", "eq_dir": "down", "eq_badge": "\u25bc -70", "eq_label": "Entry quality: strong sell/exit-setup (-70)", "eq_label_zh": "\u5165\u573a\u8d28\u91cf\uff1a\u5f3a\u5356\u51fa/\u79bb\u573a\u5f62\u6001\uff08-70\uff09", "eq_tip": "How well-timed & low-risk THIS entry is \u2014 near the cycle high, a fresh momentum turn, and with-trend. Measured: entries near the pivot drew ~30% smaller drawdowns than chasers far above it \u2014 risk control, NOT a return forecast.", "eq_tip_zh": "\u8861\u91cf\u5f53\u524d\u5165\u573a\u7684\u65f6\u673a\u4e0e\u98ce\u9669\u2014\u2014\u8d34\u8fd1\u5468\u671f\u9ad8\u70b9\u3001\u52a8\u91cf\u65b0\u8fd1\u8f6c\u5411\u3001\u4e14\u987a\u52bf\u3002\u5b9e\u6d4b\uff1a\u8d34\u8fd1\u67a2\u8f74\u7684\u5165\u573a\uff0c\u5176\u56de\u64a4\u6bd4\u8fdc\u79bb\u67a2\u8f74\u7684\u