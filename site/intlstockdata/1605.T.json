ign.", "translation_zh": "\u4e0a\u4e00\u5468\u671f\u5728\u540e\u534a\u6bb5\u89c1\u9876\uff08\u201c\u53f3\u79fb\u201d\uff09\u2014\u2014\u5f3a\u5468\u671f\u89c1\u9876\u504f\u665a\uff0c\u5c5e\u4e8e\u5065\u5eb7\u4e0a\u6da8\u8d8b\u52bf\u7684\u4fe1\u53f7\u3002"}, "early_note": "", "early_tier": null, "early_dir": null, "why_zh": "\u5931\u8d25\u5468\u671f\u2014\u2014\u4ef7\u683c\u8dcc\u7834\u4e86\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9\uff0c\u5386\u53f2\u4e0a\u8fd9\u901a\u5e38\u610f\u5473\u7740\u66f4\u5927\u7684\u8d8b\u52bf\u6b63\u5728\u6389\u5934\u5411\u4e0b\uff08\u7ea6 80% \u7684\u60c5\u5f62\uff09\u3002", "next_zh": "\u89c2\u671b\uff0c\u76f4\u81f3\u65b0\u7684\u65e5\u7ebf\u5468\u671f\u4f4e\u70b9\u5f62\u6210\u5e76\u786e\u8ba4\u3002", "regime_line_zh": "\u5927\u5c40\uff1a\u770b\u7a7a \u2014 \u5468\u7ebf\u52a8\u91cf\u4e3a\u8d1f\uff08\u6295\u8d44\u8005\u5468\u671f\u7b2c 25 \u5468 \u00b7 \u65e5\u7ebf\u5468\u671f\u7b2c 11 \u5929\uff09\u3002", "summary_line_zh": "\u77ed\u671f\uff08\u65e5\u7ebf\uff09\uff1a\u4e0b\u8dcc\u8d8b\u52bf\u3002\u5927\u5c40\uff08\u9006\u52bf\uff09\uff1a\u770b\u7a7a\u3002", "points_zh": ["\u5927\u5c40\u4e3a\u770b\u7a7a\uff08\u5bf9\u65e5\u7ebf\u591a\u5934\u800c\u8a00\u5c5e\u9006\u52bf\uff09", "\u26a0 \u5931\u8d25\u5468\u671f\u2014\u2014\u4ef7\u683c\u8dcc\u7834\u4e86\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9", "\u4ecd\u4f4d\u4e8e 10 \u65e5\u5747\u7ebf\u4e4b\u4e0b", "\u65e5\u7ebf\u52a8\u91cf\u521a\u521a\u5411\u4e0b\u4ea4\u53c9"], "early_note_zh": "", "liq_regime": null, "liq_effect": null, "liq_line": "", "liq_line_zh": "", "macro_effect": null, "macro_pen": 0, "macro_drag": null, "macro_beta": 0.0, "macro_line": "", "macro_line_zh": "", "age_days": 0, "age_capped": false, "prev_state": "BOTTOM WATCH", "signal_date": "2026-06-16", "strength": "strong", "strength_zh": "\u5f3a", "age_line": "\u23f1 DOWNTREND signal just triggered today (fresh cross from NEARING A LOW). Signal strength: strong (score -80/100).", "age_line_zh": "\u23f1 \u4e0b\u8dcc\u