eg", "weekly_line_zh": "\u5468\u7ebf\uff08\u6295\u8d44\u8005\uff09\u5468\u671f\uff1a\u7b2c 6 \u5468\uff0c\u5178\u578b\u5468\u671f\u4e3a 16\u201326 \u5468", "weekly_phase_zh": "\u65e9\u671f\u2014\u2014\u66f4\u5927\u7684\u4e0a\u884c\u6bb5\u4ecd\u6709\u5145\u8db3\u7a7a\u95f4", "translation": "The last cycle peaked mid-way \u2014 a neutral, balanced structure.", "translation_zh": "\u4e0a\u4e00\u5468\u671f\u5728\u4e2d\u6bb5\u89c1\u9876\u2014\u2014\u7ed3\u6784\u4e2d\u6027\u3001\u5747\u8861\u3002"}, "early_note": "", "early_tier": null, "early_dir": null, "why_zh": "\u7ed3\u6784\u6df7\u5408\u3002", "next_zh": "\u5173\u6ce8 10 \u65e5\u5747\u7ebf\u4e0e\u5468\u671f\u5929\u6570\u3002", "regime_line_zh": "\u5927\u5c40\uff1a\u770b\u591a \u2014 \u5468\u7ebf\u52a8\u91cf\u4e3a\u6b63\uff1b\u4f46\u6b63\u8d8b\u5411\u5468\u7ebf\u5411\u4e0b\u4ea4\u53c9\uff08\u6295\u8d44\u8005\u5468\u671f\u7b2c 6 \u5468 \u00b7 \u65e5\u7ebf\u5468\u671f\u7b2c 27 \u5929\uff09\u3002", "summary_line_zh": "\u77ed\u671f\uff08\u65e5\u7ebf\uff09\uff1a\u63a5\u8fd1\u4f4e\u70b9\u3002\u5927\u5c40\uff08\u987a\u52bf\uff09\uff1a\u770b\u591a\u3002", "points_zh": ["\u5927\u5c40\u4e3a\u770b\u591a\uff08\u5bf9\u65e5\u7ebf\u591a\u5934\u800c\u8a00\u5c5e\u987a\u52bf\uff09", "\u5b8f\u89c2\uff1a\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u6536\u7f29\u2014\u2014\u5bf9\u6982\u7387\u5c5e\u9700\u8c28\u614e", "\u6446\u52a8\u4f4e\u70b9\u5df2\u73b0\uff08\u4e70\u65b9\u62d2\u7edd\u4e86\u8be5\u4f4e\u70b9\uff09", "\u4ecd\u4f4d\u4e8e 10 \u65e5\u5747\u7ebf\u4e4b\u4e0b"], "early_note_zh": "", "liq_regime": "contracting", "liq_effect": "cautionary", "liq_line": "Macro headwind: US net liquidity is contracting \u2014 buy setups have historically had worse odds and deeper drawdowns here, so demand extra confirmation and smaller size. An odds edge, not a forecast.", "liq_line_zh": "\u5b8f\u89c2\u9006\u98ce\uff1a\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u6b63\u5728\u6536\u7f29\u2014\u2014\u5728\u6b64\u73af\u5883\u4e0b\u4e70\u5165\u5f62\u6001\u5386\u53f2\u4e0a\