\u2014\u5206\u6570\u8d8a\u9ad8\uff0c\u4f4e\u70b9\u5b88\u4f4f\u7684\u6982\u7387\u8d8a\u5927\u3002\u8fd9\u662f\u98ce\u9669/\u6301\u4e45\u6027\uff0c\u5e76\u975e\u6536\u76ca\u9884\u6d4b\u3002", "bc_knife": "high", "bc_knife_line": "\u26a0 Deep washout \u2014 price is 27% below its 200-day, a broken primary trend. Measured: setups this stretched below the 200-day held the cycle low only ~37% of the time and drew a ~\u221222% tail (violent bounces, rarely the durable low). Treat as knife-risk \u2014 wait for it to reclaim the 10-day average and size small. The score above is already tempered for this.", "bc_knife_line_zh": "\u26a0 \u6df1\u5ea6\u8d85\u5356\u2014\u2014\u4ef7\u683c\u8f83 200 \u65e5\u5747\u7ebf\u4f4e\u7ea6 27%\uff08\u4e3b\u8d8b\u52bf\u5df2\u7834\uff09\u3002\u5b9e\u6d4b\uff1a\u5982\u6b64\u8fdc\u4f4e\u4e8e 200 \u65e5\u7ebf\u7684\u5f62\u6001\uff0c\u4ec5\u7ea6 37% \u5b88\u4f4f\u5468\u671f\u4f4e\u70b9\uff0c\u4e14\u56de\u64a4\u5c3e\u90e8\u7ea6 \u221222%\uff08\u53cd\u5f39\u731b\u70c8\uff0c\u4f46\u5f88\u5c11\u662f\u6301\u4e45\u4f4e\u70b9\uff09\u3002\u89c6\u4e3a\u300c\u63a5\u98de\u5200\u300d\u98ce\u9669\u2014\u2014\u7b49\u5176\u6536\u590d 10 \u65e5\u5747\u7ebf\u540e\u518d\u5c0f\u4ed3\u53c2\u4e0e\u3002\u4e0a\u65b9\u5206\u6570\u5df2\u636e\u6b64\u6253\u6298\u3002", "bottom_confidence": 1.5, "alignment": {"aligned": false, "near": false, "tier": null, "score": 0.0, "quality": 0.0, "entry_tier": null, "entry_tier_zh": null, "reason": null, "reason_zh": null, "weekly": "falling", "three_day": "falling", "daily": "turning", "weekly_ok": false, "three_day_ok": false, "three_day_trigger": null, "daily_ok": false, "daily_trigger": null, "overextended": false, "days_to_cross": null, "knife": 1.0, "have_tf": true, "blocked": true, "line": "Weekly falling \u00b7 3-Day \u00b7 \u00b7 Daily \u2014", "line_zh": "\u5468\u7ebf\u5468\u7ebf\u4ecd\u4e0b\u884c \u00b7 3\u65e5\u00b7 \u00b7 \u65e5\u7ebf\u2014"}}, "alerts": {"pinned": {"type": "ladder", "filter": "signal", "dir": "down", "pinne