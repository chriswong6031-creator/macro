y", "weekly_line_zh": "\u5468\u7ebf\uff08\u6295\u8d44\u8005\uff09\u5468\u671f\uff1a\u7b2c 46 \u5468\uff0c\u5178\u578b\u5468\u671f\u4e3a 16\u201326 \u5468", "weekly_phase_zh": "\u903e\u671f\u2014\u2014\u66f4\u5927\u7684\u5468\u671f\u5df2\u88ab\u62c9\u4f38\uff0c\u9884\u8ba1\u6ce2\u52a8\u52a0\u5267", "translation": "The last cycle peaked in its FIRST half ('left-translated') \u2014 weak cycles top early, so this hints the bigger trend is tiring.", "translation_zh": "\u4e0a\u4e00\u5468\u671f\u5728\u524d\u534a\u6bb5\u89c1\u9876\uff08\u201c\u5de6\u79fb\u201d\uff09\u2014\u2014\u5f31\u5468\u671f\u89c1\u9876\u504f\u65e9\uff0c\u8fd9\u6697\u793a\u66f4\u5927\u7684\u8d8b\u52bf\u6b63\u5728\u8d70\u5f31\u3002"}, "early_note": "", "early_tier": null, "early_dir": null, "why_zh": "\u7ed3\u6784\u6df7\u5408\u3002 \u4e0a\u4e00\u5468\u671f\u4e3a\u5de6\u79fb\u7ed3\u6784\uff08\u89c1\u9876\u504f\u65e9\uff09\u2014\u2014\u5c5e\u4e8e\u770b\u7a7a\u7684\u7ed3\u6784\u6027\u4fe1\u53f7\u3002", "next_zh": "\u5173\u6ce8 10 \u65e5\u5747\u7ebf\u4e0e\u5468\u671f\u5929\u6570\u3002", "regime_line_zh": "\u5927\u5c40\uff1a\u770b\u7a7a \u2014 \u5468\u7ebf\u52a8\u91cf\u521a\u521a\u5411\u4e0a\u4ea4\u53c9\uff1b\u6295\u8d44\u8005\u5468\u671f\u5931\u8d25\uff08\u8dcc\u7834\u8d77\u59cb\u4f4e\u70b9\uff09\uff1b\u6295\u8d44\u8005\u5468\u671f\u5df2\u903e\u671f\uff1b\u4e0a\u4e00\u5468\u671f\u5de6\u79fb\uff08\u89c1\u9876\u504f\u65e9\uff09\uff08\u6295\u8d44\u8005\u5468\u671f\u7b2c 46 \u5468 \u00b7 \u5df2\u5931\u8d25 \u00b7 \u65e5\u7ebf\u5468\u671f\u7b2c 22 \u5929\uff09\u3002", "summary_line_zh": "\u77ed\u671f\uff08\u65e5\u7ebf\uff09\uff1a\u63a5\u8fd1\u4f4e\u70b9\u3002\u5927\u5c40\uff08\u9006\u52bf\uff09\uff1a\u770b\u7a7a\u3002", "points_zh": ["\u5927\u5c40\u4e3a\u770b\u7a7a\uff08\u5bf9\u65e5\u7ebf\u591a\u5934\u800c\u8a00\u5c5e\u9006\u52bf\uff09", "\u5b8f\u89c2\uff1a\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u6536\u7f29\u2014\u2014\u5bf9\u6982\u7387\u5c5e\u9700\u8c28\u614e", "\u6446\u52a8\u4f4e\u70b9\u5df2\u73b0\uff08\u4e70\u65b