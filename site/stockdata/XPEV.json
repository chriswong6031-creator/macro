text_zh": "\u4e0b\u8dcc\u8d8b\u52bf\u2014\u2014\u89c2\u671b\uff0c\u76f4\u81f3\u65b0\u7684\u5468\u671f\u4f4e\u70b9\u5f62\u6210\u5e76\u786e\u8ba4\u3002"}, "cycle_plain": {"daily_line": "Daily cycle: day 27 of a typical 36\u201342 trading days", "daily_phase": "mid-cycle \u2014 trending", "daily_line_zh": "\u65e5\u7ebf\u5468\u671f\uff1a\u7b2c 27 \u5929\uff0c\u5178\u578b\u5468\u671f\u4e3a 36\u201342 \u4e2a\u4ea4\u6613\u65e5", "daily_phase_zh": "\u5468\u671f\u4e2d\u6bb5\u2014\u2014\u8d8b\u52bf\u8fd0\u884c\u4e2d", "weekly_line": "Weekly (investor) cycle: week 29 of a typical 16\u201326 weeks", "weekly_phase": "overdue \u2014 the bigger cycle is stretched, expect more volatility", "weekly_line_zh": "\u5468\u7ebf\uff08\u6295\u8d44\u8005\uff09\u5468\u671f\uff1a\u7b2c 29 \u5468\uff0c\u5178\u578b\u5468\u671f\u4e3a 16\u201326 \u5468", "weekly_phase_zh": "\u903e\u671f\u2014\u2014\u66f4\u5927\u7684\u5468\u671f\u5df2\u88ab\u62c9\u4f38\uff0c\u9884\u8ba1\u6ce2\u52a8\u52a0\u5267", "translation": "The last cycle peaked in its FIRST half ('left-translated') \u2014 weak cycles top early, so this hints the bigger trend is tiring.", "translation_zh": "\u4e0a\u4e00\u5468\u671f\u5728\u524d\u534a\u6bb5\u89c1\u9876\uff08\u201c\u5de6\u79fb\u201d\uff09\u2014\u2014\u5f31\u5468\u671f\u89c1\u9876\u504f\u65e9\uff0c\u8fd9\u6697\u793a\u66f4\u5927\u7684\u8d8b\u52bf\u6b63\u5728\u8d70\u5f31\u3002"}, "early_note": "", "early_tier": null, "early_dir": null, "why_zh": "\u5931\u8d25\u5468\u671f\u2014\u2014\u4ef7\u683c\u8dcc\u7834\u4e86\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9\uff0c\u5386\u53f2\u4e0a\u8fd9\u901a\u5e38\u610f\u5473\u7740\u66f4\u5927\u7684\u8d8b\u52bf\u6b63\u5728\u6389\u5934\u5411\u4e0b\uff08\u7ea6 80% \u7684\u60c5\u5f62\uff09\u3002 \u4e0a\u4e00\u5468\u671f\u4e3a\u5de6\u79fb\u7ed3\u6784\uff08\u89c1\u9876\u504f\u65e9\uff09\u2014\u2014\u5c5e\u4e8e\u770b\u7a7a\u7684\u7ed3\u6784\u6027\u4fe1\u53f7\u3002", "next_zh": "\u89c2\u671b\uff0c\u76f4\u81f3\u65b0\u7684\u65e5\u7ebf\u5468\u671f\u4f4e\u70b9\u5f62\u6210\u5e76\u786e\u8ba4\u3002", "regime_line_zh": "\u5927\u5c40\uff1a\u770b\u7a7a \u2014 \u5468\u7ebf\u52a8\u91cf\u4e3a\u8d1f\uff1b\u6295\u8d44\u8005\u5468\u671f\u5931\u8d25\uff08\u8dcc\u7834\u8d77\u59cb\u4f4e\u70b9\uff09\uff1b\u6295\u8d44\u8005\u5468\u671f\u5df2\u903e\u671f\uff1b\u4e0a\u4e00\u5468\u671f\u5de6\u79fb\uff08\u89c1\u9876\u504f\u65e9\uff09\uff08\u6295\u8d44\u8005\u5468\u671f\u7b2c 29 \u5468 \u00b7 \u5df2\u5931\u8d25 \u00b7 \u65e5\u7ebf\u5468\u671f\u4e8e 12 \u5929\u524d\u8dcc\u7834\u5176\u8d77\u59cb\u4f4e\u70b9\uff09\u3002", "summary_line_zh": "\u77ed\u671f\uff08\u65e5\u7ebf\uff09\uff1a\u4e0b\u8dcc\u8d8b\u52bf\u3002\u5927\u5c40\uff08\u9006\u52bf\uff09\uff1a\u770b\u7a7a\u3002", "points_zh": ["\u5927\u5c40\u4e3a\u770b\u7a7a\uff08\u5bf9\u65e5\u7ebf\u591a\u5934\u800c\u8a00\u5c5e\u9006\u52bf\uff09", "\u5b8f\u89c2\uff1a\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u6536\u7f29\u2014\u2014\u5bf9\u6982\u7387\u5c5e\u9700\u8c28\u614e", "\u26a0 \u5931\u8d25\u5468\u671f\u2014\u2014\u4ef7\u683c\u8dcc\u7834\u4e86\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9\uff0812 \u5929\u524d\uff09", "\u6446\u52a8\u4f4e\u70b9\u5df2\u73b0\uff08\u4e70\u65b9\u62d2\u7edd\u4e86\u8be5\u4f4e\u70b9\uff09", "\u4ecd\u4f4d\u4e8e 10 \u65e5\u5747\u7ebf\u4e4b\u4e0b", "\u4e0a\u4e00\u5468\u671f\u89c1\u9876\u504f\u65e9\uff08\u8d8b\u52bf\u8d70\u5f31\u7684\u6697\u793a\uff09"], "early_note_zh": "", "liq_regime": "contracting", "liq_effect": "cautionary", "liq_line": "Macro headwind: US net liquidity is contracting \u2014 buy setups have historically had worse odds and deeper drawdowns here, so demand extra confirmation and smaller size. An odds edge, not a forecast.", "liq_line_zh": "\u5b8f\u89c2\u9006\u98ce\uff1a\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u6b63\u5728\u6536\u7f29\u2014\u2014\u5728\u6b64\u73af\u5883\u4e0b\u4e70\u5165\u5f62\u6001\u5386\u53f2\u4e0a\u80dc\u7387\u66f4\u4f4e\u3001\u56de\u64a4\u66f4\u6df1\uff0c\u56e0\u6b64\u5e94\u8981\u6c42\u66f4\u591a\u786e\u8ba4\u5e76\u964d\u4f4e\u4ed3\u4f4d\u300