 "\u4ecd\u4f4d\u4e8e 10 \u65e5\u5747\u7ebf\u4e4b\u4e0b", "\u65e5\u7ebf\u52a8\u91cf\u8ddd\u8f6c\u4e3a\u5411\u4e0a\u7ea6 2 \u6839 K \u7ebf"], "early_note_zh": "", "liq_regime": "neutral", "liq_effect": "neutral", "liq_line": "US net liquidity is neutral right now \u2014 no macro tilt either way on the odds.", "liq_line_zh": "\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u76ee\u524d\u4e2d\u6027\u2014\u2014\u5bf9\u6982\u7387\u6ca1\u6709\u65b9\u5411\u6027\u5f71\u54cd\u3002", "macro_effect": null, "macro_pen": 0, "macro_drag": null, "macro_beta": 0.0, "macro_line": "", "macro_line_zh": "", "age_days": 11, "age_capped": false, "prev_state": "BOTTOM WATCH", "signal_date": "2026-06-02", "strength": "strong", "strength_zh": "\u5f3a", "age_line": "\u23f1 DOWNTREND signal triggered 11 trading days ago (~2026-06-02), switching from NEARING A LOW. Signal strength: strong (score -80/100).", "age_line_zh": "\u23f1 \u4e0b\u8dcc\u8d8b\u52bf\u4fe1\u53f7\u4e8e 11 \u4e2a\u4ea4\u6613\u65e5\u524d\u89e6\u53d1\uff08\u7ea6 2026-06-02\uff09\uff0c\u81ea\u63a5\u8fd1\u4f4e\u70b9\u5207\u6362\u800c\u6765\u3002 \u4fe1\u53f7\u5f3a\u5ea6\uff1a\u5f3a\uff08\u8bc4\u5206 -80/100\uff09\u3002", "age_short": "11d ago", "age_short_zh": "11\u5929\u524d", "eq_score": -25.0, "eq_grade": "light", "eq_grade_zh": "\u504f\u5f31", "eq_dir": "down", "eq_badge": "\u25bc -25", "eq_label": "Entry quality: light sell/exit-setup (-25)", "eq_label_zh": "\u5165\u573a\u8d28\u91cf\uff1a\u504f\u5f31\u5356\u51fa/\u79bb\u573a\u5f62\u6001\uff08-25\uff09", "eq_tip": "How well-timed & low-risk THIS entry is \u2014 near the cycle high, a fresh momentum turn, and with-trend. Measured: entries near the pivot drew ~30% smaller drawdowns than chasers far above it \u2014 risk control, NOT a return forecast.", "eq_tip_zh": "\u8861\u91cf\u5f53\u524d\u5165\u573a\u7684\u65f6\u673a\u4e0e\u98ce\u9669\u2014\u2014\u8d34\u8fd1\u5468\u671f\u9ad8\u70b9\u3001\u52a8\u91cf\u65b0\u8fd1\u8f6c\u5411\u3001\u4e14\u987a\u52bf\u3002\u5b9e\u6d4b\uff1a\u8d34\u8fd1\u67a