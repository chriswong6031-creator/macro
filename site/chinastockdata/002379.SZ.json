 and size small. The score above is already tempered for this.", "bc_knife_line_zh": "\u26a0 \u6df1\u5ea6\u8d85\u5356\u2014\u2014\u4ef7\u683c\u8f83 200 \u65e5\u5747\u7ebf\u4f4e\u7ea6 26%\uff08\u4e3b\u8d8b\u52bf\u5df2\u7834\uff09\u3002\u5b9e\u6d4b\uff1a\u5982\u6b64\u8fdc\u4f4e\u4e8e 200 \u65e5\u7ebf\u7684\u5f62\u6001\uff0c\u4ec5\u7ea6 37% \u5b88\u4f4f\u5468\u671f\u4f4e\u70b9\uff0c\u4e14\u56de\u64a4\u5c3e\u90e8\u7ea6 \u221222%\uff08\u53cd\u5f39\u731b\u70c8\uff0c\u4f46\u5f88\u5c11\u662f\u6301\u4e45\u4f4e\u70b9\uff09\u3002\u89c6\u4e3a\u300c\u63a5\u98de\u5200\u300d\u98ce\u9669\u2014\u2014\u7b49\u5176\u6536\u590d 10 \u65e5\u5747\u7ebf\u540e\u518d\u5c0f\u4ed3\u53c2\u4e0e\u3002\u4e0a\u65b9\u5206\u6570\u5df2\u636e\u6b64\u6253\u6298\u3002", "bottom_confidence": 3.0}, "alpha": {"alpha": 0.3, "resid_ann": 10.4, "total_mom": 87.7, "rev_1m": -18.5, "rev_pctile": 7.0, "sector_rank": 37, "sector_n": 122, "entry": "neutral", "rs": 67.0, "rs3m": 1.0, "rs6m": 7.0, "rs12m": 57.0}, "conviction": {"score": 36, "band": "low", "band_en": "Low", "band_zh": "\u504f\u5f31", "composite_z": -0.268, "verdict": "Hold off \u2014 timing against you", "verdict_zh": "\u6682\u7f13 \u2014 \u65f6\u673a\u4e0d\u5229", "drivers": ["residual momentum"], "cautions": ["cycle: DOWNTREND"], "trust_tier": {"tier": "reversal", "en": "Reversal context \u2014 validated but high-variance, not a buy list", "zh": "\u5747\u503c\u56de\u5f52\u53c2\u8003 \u2014 \u5df2\u9a8c\u8bc1\u4f46\u9ad8\u6ce2\u52a8\uff0c\u975e\u4e70\u5165\u6e05\u5355", "css": "tt-reversal"}, "regime": null, "axes": {"selection": {"z": 0.3, "pct": 55, "present": ["alpha"], "kind": "residual momentum", "kind_zh": "\u6b8b\u5dee\u52a8\u91cf", "basis": [{"leg": "alpha", "label": "momentum", "label_zh": "\u52a8\u91cf", "tier": "context", "z": 0.3}]}, "entry": {"z": -1.0133333333333334, "pct": 35, "present": ["urgency", "off-high", "rsi"], "blocked": true}, "tailwind": {"z": -0.6692776277100484, "pct": 40, "present": ["theme"]}, "quality": {"z": null, "pct"