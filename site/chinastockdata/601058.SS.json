 knife-risk \u2014 wait for it to reclaim the 10-day average and size small. The score above is already tempered for this.", "bc_knife_line_zh": "\u26a0 \u6df1\u5ea6\u8d85\u5356\u2014\u2014\u4ef7\u683c\u8f83 200 \u65e5\u5747\u7ebf\u4f4e\u7ea6 19%\uff08\u4e3b\u8d8b\u52bf\u5df2\u7834\uff09\u3002\u5b9e\u6d4b\uff1a\u5982\u6b64\u8fdc\u4f4e\u4e8e 200 \u65e5\u7ebf\u7684\u5f62\u6001\uff0c\u4ec5\u7ea6 37% \u5b88\u4f4f\u5468\u671f\u4f4e\u70b9\uff0c\u4e14\u56de\u64a4\u5c3e\u90e8\u7ea6 \u221222%\uff08\u53cd\u5f39\u731b\u70c8\uff0c\u4f46\u5f88\u5c11\u662f\u6301\u4e45\u4f4e\u70b9\uff09\u3002\u89c6\u4e3a\u300c\u63a5\u98de\u5200\u300d\u98ce\u9669\u2014\u2014\u7b49\u5176\u6536\u590d 10 \u65e5\u5747\u7ebf\u540e\u518d\u5c0f\u4ed3\u53c2\u4e0e\u3002\u4e0a\u65b9\u5206\u6570\u5df2\u636e\u6b64\u6253\u6298\u3002", "bottom_confidence": 1.1}, "alpha": {"alpha": -0.18, "resid_ann": -15.5, "total_mom": 5.7, "rev_1m": -4.1, "rev_pctile": 54.0, "sector_rank": 65, "sector_n": 116, "entry": "neutral", "rs": 28.0, "rs3m": 40.0, "rs6m": 9.0, "rs12m": 36.0}, "anticipation": {"asset": "", "asset_class": "cn_equity", "as_of": "2026-06-22", "anticipation_index": 77.6, "index_band": "extreme", "confluence_value": 0.368, "n_go_legs": 7, "vol_cone_ann": 0.455, "horizons": {"short": {"range_td": [1, 10], "window_td": 5, "p_up": 0.43, "conviction": "TOSS_UP", "direction": "coin-flip", "direction_scored": false, "ret_q": {"p5": -7.74, "p25": -3.53, "p50": -0.21, "p75": 3.62, "p95": 8.22}, "dd_avg": -2.64, "dd_tail": -9.14, "mfe_med": 2.18, "cell_n": 296, "thin": false, "underpowered": false, "r_hat": null, "oos_r2": null, "dir_legs": null}, "medium": {"range_td": [21, 63], "window_td": 42, "p_up": 0.43, "conviction": "LEAN", "direction": "down-lean", "direction_scored": false, "ret_q": {"p5": -19.99, "p25": -14.04, "p50": -2.81, "p75": 9.61, "p95": 27.61}, "dd_avg": -10.71, "dd_tail": -22.84, "mfe_med": 6.9, "cell_n": 295, "thin": false, "underpowered": false, "r_hat": null, "oos_r2": null, "dir_legs": null}, 