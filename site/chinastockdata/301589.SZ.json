4f4f\u300d\u7684\u6bd4\u4f8b\u63d0\u5347\u7ea6 19 \u4e2a\u767e\u5206\u70b9\u2014\u2014\u5206\u6570\u8d8a\u9ad8\uff0c\u4f4e\u70b9\u5b88\u4f4f\u7684\u6982\u7387\u8d8a\u5927\u3002\u8fd9\u662f\u98ce\u9669/\u6301\u4e45\u6027\uff0c\u5e76\u975e\u6536\u76ca\u9884\u6d4b\u3002", "bc_knife": "elevated", "bc_knife_line": "\u26a0 Deep washout \u2014 price is 15% below its 200-day, a broken primary trend. Measured: setups this stretched below the 200-day held the cycle low only ~37% of the time and drew a ~\u221222% tail (violent bounces, rarely the durable low). Treat as knife-risk \u2014 wait for it to reclaim the 10-day average and size small. The score above is already tempered for this.", "bc_knife_line_zh": "\u26a0 \u6df1\u5ea6\u8d85\u5356\u2014\u2014\u4ef7\u683c\u8f83 200 \u65e5\u5747\u7ebf\u4f4e\u7ea6 15%\uff08\u4e3b\u8d8b\u52bf\u5df2\u7834\uff09\u3002\u5b9e\u6d4b\uff1a\u5982\u6b64\u8fdc\u4f4e\u4e8e 200 \u65e5\u7ebf\u7684\u5f62\u6001\uff0c\u4ec5\u7ea6 37% \u5b88\u4f4f\u5468\u671f\u4f4e\u70b9\uff0c\u4e14\u56de\u64a4\u5c3e\u90e8\u7ea6 \u221222%\uff08\u53cd\u5f39\u731b\u70c8\uff0c\u4f46\u5f88\u5c11\u662f\u6301\u4e45\u4f4e\u70b9\uff09\u3002\u89c6\u4e3a\u300c\u63a5\u98de\u5200\u300d\u98ce\u9669\u2014\u2014\u7b49\u5176\u6536\u590d 10 \u65e5\u5747\u7ebf\u540e\u518d\u5c0f\u4ed3\u53c2\u4e0e\u3002\u4e0a\u65b9\u5206\u6570\u5df2\u636e\u6b64\u6253\u6298\u3002", "bottom_confidence": 11.1, "alignment": {"aligned": true, "near": false, "tier": "PRIME", "score": 260.2, "quality": 60.2, "entry_tier": "Prime entry", "entry_tier_zh": "\u9ec4\u91d1\u5165\u573a", "reason": "3D MACD turned up from below zero; weekly basing", "reason_zh": "3\u65e5 MACD \u5728\u96f6\u8f74\u4e0b\u65b9\u4e0a\u62d0\uff1b\u5468\u7ebf\u7b51\u5e95", "weekly": "basing", "three_day": "turning", "daily": "rising", "weekly_ok": true, "three_day_ok": true, "three_day_trigger": "macd_trough", "daily_ok": true, "daily_trigger": "early", "overextended": false, "days_to_cross": 2, "knife": 0.41, "have_tf": true, "blocked": fals