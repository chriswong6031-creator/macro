ructure.", "translation_zh": "\u4e0a\u4e00\u5468\u671f\u5728\u4e2d\u6bb5\u89c1\u9876\u2014\u2014\u7ed3\u6784\u4e2d\u6027\u3001\u5747\u8861\u3002"}, "early_note": "", "early_tier": null, "early_dir": null, "why_zh": "\u5931\u8d25\u5468\u671f\u2014\u2014\u4ef7\u683c\u8dcc\u7834\u4e86\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9\uff0c\u5386\u53f2\u4e0a\u8fd9\u901a\u5e38\u610f\u5473\u7740\u66f4\u5927\u7684\u8d8b\u52bf\u6b63\u5728\u6389\u5934\u5411\u4e0b\uff08\u7ea6 80% \u7684\u60c5\u5f62\uff09\u3002", "next_zh": "\u89c2\u671b\uff0c\u76f4\u81f3\u65b0\u7684\u65e5\u7ebf\u5468\u671f\u4f4e\u70b9\u5f62\u6210\u5e76\u786e\u8ba4\u3002", "regime_line_zh": "\u5927\u5c40\uff1a\u770b\u7a7a \u2014 \u5468\u7ebf\u52a8\u91cf\u4e3a\u8d1f\uff1b\u6295\u8d44\u8005\u5468\u671f\u5931\u8d25\uff08\u8dcc\u7834\u8d77\u59cb\u4f4e\u70b9\uff09\uff1b\u6295\u8d44\u8005\u5468\u671f\u5df2\u903e\u671f\uff08\u6295\u8d44\u8005\u5468\u671f\u7b2c 34 \u5468 \u00b7 \u5df2\u5931\u8d25 \u00b7 \u65e5\u7ebf\u5468\u671f\u4e8e 28 \u5929\u524d\u8dcc\u7834\u5176\u8d77\u59cb\u4f4e\u70b9\uff09\u3002", "summary_line_zh": "\u77ed\u671f\uff08\u65e5\u7ebf\uff09\uff1a\u4e0b\u8dcc\u8d8b\u52bf\u3002\u5927\u5c40\uff08\u9006\u52bf\uff09\uff1a\u770b\u7a7a\u3002", "points_zh": ["\u5927\u5c40\u4e3a\u770b\u7a7a\uff08\u5bf9\u65e5\u7ebf\u591a\u5934\u800c\u8a00\u5c5e\u9006\u52bf\uff09", "\u5b8f\u89c2\uff1a\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u4e2d\u6027\u2014\u2014\u5bf9\u6982\u7387\u5c5e\u65e0\u65b9\u5411\u6027\u5f71\u54cd", "\u26a0 \u5931\u8d25\u5468\u671f\u2014\u2014\u4ef7\u683c\u8dcc\u7834\u4e86\u542f\u52a8\u672c\u5468\u671f\u7684\u4f4e\u70b9\uff0828 \u5929\u524d\uff09", "\u4ecd\u4f4d\u4e8e 10 \u65e5\u5747\u7ebf\u4e4b\u4e0b"], "early_note_zh": "", "liq_regime": "neutral", "liq_effect": "neutral", "liq_line": "US net liquidity is neutral right now \u2014 no macro tilt either way on the odds.", "liq_line_zh": "\u7f8e\u56fd\u51c0\u6d41\u52a8\u6027\u76ee\u524d\u4e2d\u6027\u2014\u2014\u5bf9\u6982\u7387\u6ca1\u6709\u65b9\u5411\u6027\u