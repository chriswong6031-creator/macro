ense, industrial, HealthTech, capital equipment, communications, and enterprise markets. The company has a strategic collaboration with Advanced Micro Devices, Inc. for the development of Helios, a rack-scale AI platform. The company was incorporated in 1994 and is headquartered in Toronto, Canada.", "sector": "Technology", "industry": "Electronic Components"}, "valuation": {"pe": 40.79966, "pb": 18.469856, "ps": 3.9903278, "roe": 52.45, "net_margin": 6.95, "debt_to_equity": 44.881, "div_yield": null, "rev_growth": 52.8, "market_cap": 55023824896.0, "forward_pe": 22.525177, "peg": null, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 40.79966, "pb_sector_med": 7.676889, "roe_sector_med": 12.76, "div_yield_sector_med": 0.74}, "archetype": "quality_compounder", "archetype_label": "Quality compounder", "archetype_label_zh": "\u4f18\u8d28\u590d\u5229\u80a1", "consensus": {"n_analysts": 8, "target_mean": 678.0048, "target_high": 802.9106, "target_low": 624.536, "rating_mean": 1.28571, "rating": "Strong Buy", "rating_zh": "\u5f3a\u529b\u4e70\u5165", "upside_pct": 41.7}, "positioning": {"shares_short": 1192294.0, "days_to_cover": 2.67, "short_pct_float": 1.05, "held_insiders": 1.11, "held_institutions": 72.2}}, "earnings": {"next_date": "2026-07-27", "surprises": [{"date": "2026-04-27", "eps": 2.16, "est": 2.08, "surprise_pct": 3.8}, {"date": "2026-01-28", "eps": 1.89, "est": 1.76, "surprise_pct": 7.3}, {"date": "2025-10-27", "eps": 1.58, "est": 1.49, "surprise_pct": 6.0}, {"date": "2025-07-28", "eps": 1.39, "est": 1.23, "surprise_pct": 12.7}]}, "factor_beta": {"oil": 0.066, "gold": -0.276, "cad": 0.127, "r2": 0.24, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1"}}