al equipment, communications, and enterprise markets. The company has a strategic collaboration with Advanced Micro Devices, Inc. for the development of Helios, a rack-scale AI platform. The company was incorporated in 1994 and is headquartered in Toronto, Canada.", "sector": "Technology", "industry": "Electronic Components"}, "valuation": {"pe": 49.009563, "pb": 22.068304, "ps": 4.699295, "roe": 52.45, "net_margin": 6.95, "debt_to_equity": 44.881, "div_yield": null, "rev_growth": 52.8, "market_cap": 64799989760.0, "forward_pe": 26.91372, "peg": null, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 49.009563, "pb_sector_med": 7.295758, "roe_sector_med": 12.76, "div_yield_sector_med": 0.73}, "archetype": "quality_compounder", "archetype_label": "Quality compounder", "archetype_label_zh": "\u4f18\u8d28\u590d\u5229\u80a1", "consensus": {"n_analysts": 8, "target_mean": 667.9737, "target_high": 791.0315, "target_low": 615.29596, "rating_mean": 1.28571, "rating": "Strong Buy", "rating_zh": "\u5f3a\u529b\u4e70\u5165", "upside_pct": 18.5}, "positioning": {"shares_short": 1376592.0, "days_to_cover": 3.09, "short_pct_float": 1.21, "held_insiders": 1.11, "held_institutions": 72.0}}, "earnings": {"next_date": "2026-07-27", "surprises": [{"date": "2026-04-27", "eps": 2.16, "est": 2.08, "surprise_pct": 3.8}, {"date": "2026-01-28", "eps": 1.89, "est": 1.76, "surprise_pct": 7.3}, {"date": "2025-10-27", "eps": 2.31, "est": 1.38, "surprise_pct": 67.6}, {"date": "2025-07-28", "eps": 1.39, "est": 1.23, "surprise_pct": 12.7}]}, "factor_beta": {"oil": 0.061, "gold": -0.252, "cad": 0.105, "r2": 0.24, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1"}}