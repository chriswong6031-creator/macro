ct consulting; and perpetual funds, long-dated funds, and separately managed accounts. Colliers International Group Inc. was founded in 1972 and is headquartered in Toronto, Canada.", "sector": "Real Estate", "industry": "Real Estate Services"}, "valuation": {"pe": 56.616383, "pb": 3.1214132, "ps": 1.1713076, "roe": 8.53, "net_margin": 1.45, "debt_to_equity": 94.229, "div_yield": 0.31, "rev_growth": 15.1, "market_cap": 6712486912.0, "forward_pe": 10.958037, "peg": null, "payout": 18.4, "five_yr_yield": 0.22, "pe_sector_med": 27.698795, "pb_sector_med": 0.9395103, "roe_sector_med": 3.42, "div_yield_sector_med": 4.35}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 3, "target_mean": 218.54549, "target_high": 262.589, "target_low": 187.66171, "rating_mean": null, "upside_pct": 66.4}, "positioning": {"shares_short": 348362.0, "days_to_cover": 4.3, "short_pct_float": null, "held_insiders": 11.06, "held_institutions": 86.5}}, "earnings": {"next_date": "2026-07-30", "surprises": [{"date": "2026-05-05", "eps": 0.91, "est": 0.93, "surprise_pct": -2.3}, {"date": "2026-02-13", "eps": 2.34, "est": 2.45, "surprise_pct": -4.5}, {"date": "2025-11-04", "eps": 1.64, "est": 1.57, "surprise_pct": 4.3}, {"date": "2025-07-31", "eps": 1.72, "est": 1.48, "surprise_pct": 16.4}]}, "factor_beta": {"oil": -0.029, "gold": -0.271, "cad": 0.173, "r2": 0.23, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1"}}