ers located in the Democratic Republic of Congo. The company was formerly known as Ivanplats Limited and changed its name to Ivanhoe Mines Ltd. in August 2013. The company was incorporated in 1993 and is based in Vancouver, Canada.", "sector": "Basic Materials", "industry": "Other Industrial Metals & Mining"}, "valuation": {"pe": 82.0, "pb": 1.8245711, "ps": 28.680286, "roe": 1.95, "net_margin": 24.86, "debt_to_equity": 21.705, "div_yield": null, "rev_growth": 114.9, "market_cap": 15204108288.0, "forward_pe": 17.502623, "peg": null, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 14.985508, "pb_sector_med": 2.9965653, "roe_sector_med": 14.53, "div_yield_sector_med": 0.94}, "archetype": "growth", "archetype_label": "Growth", "archetype_label_zh": "\u6210\u957f\u80a1", "consensus": {"n_analysts": 15, "target_mean": 14.71218, "target_high": 19.701271, "target_low": 12.44246, "rating_mean": 2.0, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 38.0}, "positioning": {"shares_short": 22925622.0, "days_to_cover": 6.31, "short_pct_float": null, "held_insiders": 44.91, "held_institutions": 37.7}}, "earnings": {"next_date": "2026-07-29", "surprises": [{"date": "2026-02-18", "eps": 0.04, "est": 0.04, "surprise_pct": 5.6}, {"date": "2025-10-29", "eps": 0.02, "est": 0.01, "surprise_pct": 120.5}, {"date": "2025-07-30", "eps": 0.03, "est": 0.04, "surprise_pct": -32.0}, {"date": "2025-04-29", "eps": 0.1, "est": 0.07, "surprise_pct": 48.8}]}, "factor_beta": {"oil": 0.027, "gold": 0.225, "cad": -0.272, "r2": 0.36, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 0, "n_sells": 118, "buy_value": null, "sell_value": 12288921, "net_value": -12288921, "buy_shares": 0, "sell_shares": 1038623, "net_shares": -1038623, "distinct_buyers": 0, "distinct_sellers": 7, "recent": [{"date": "2026-05-21", "insider": "Makhesha, Setha Patricia", "role": "Director", "action": "sell", 