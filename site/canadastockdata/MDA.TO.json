endurance uncrewed aerial vehicle surveillance services. Further, operates as an owner and operator of the RADARSAT-2 Earth observation satellite; and is involved in the operation of MDA CHORUS, an Earth observation mission. It serves governments and space agencies, commercial space companies, and defense and aerospace prime contractors in the space industry. The company was formerly known as MDA Ltd. and changed its name to MDA Space Ltd. in May 2024. MDA Space Ltd. was incorporated in 1969 and is headquartered in Brampton, Canada.", "sector": "Industrials", "industry": "Aerospace & Defense"}, "valuation": {"pe": 66.725, "pb": 4.976228, "ps": 3.5289345, "roe": null, "net_margin": 2.24, "debt_to_equity": null, "div_yield": null, "rev_growth": 0.2, "market_cap": 7406527488.0, "forward_pe": 32.643127, "peg": null, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 33.742035, "pb_sector_med": 2.878458, "roe_sector_med": 10.91, "div_yield_sector_med": 1.14}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 11, "target_mean": 63.45455, "target_high": 73.0, "target_low": 53.0, "rating_mean": 1.75, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 18.9}, "positioning": {"shares_short": 2847225.0, "days_to_cover": 1.84, "short_pct_float": null, "held_insiders": 8.85, "held_institutions": 70.6}}, "earnings": {"next_date": "2026-08-06", "surprises": [{"date": "2026-05-07", "eps": 0.38, "est": 0.32, "surprise_pct": 20.2}, {"date": "2026-03-04", "eps": 0.45, "est": 0.4, "surprise_pct": 12.9}, {"date": "2025-11-14", "eps": 0.35, "est": 0.35, "surprise_pct": 1.4}, {"date": "2025-08-07", "eps": 0.38, "est": 0.3, "surprise_pct": 25.0}]}, "factor_beta": {"oil": -0.03, "gold": -0.138, "cad": 0.337, "r2": 0.13, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}