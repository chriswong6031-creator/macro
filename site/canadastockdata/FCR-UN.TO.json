nt, First Capital now holds substantially all its real property portfolio through flow-through entities, namely subsidiary partnerships and trusts. First Capital Real Estate Investment Trust is incorporated in Ontario, Canada and its head office is located at 85 Hanna Avenue, Suite 400, Toronto, Ontario, M6K 3S3. First Capital Real Estate Investment Trust was established on November 10, 1993 and incorporated in Ontario, Canada.", "sector": "Real Estate", "industry": "REIT - Retail"}, "valuation": {"pe": 4.5853176, "pb": 1.0093907, "ps": 6.794972, "roe": 23.77, "net_margin": 148.27, "debt_to_equity": 82.295, "div_yield": 3.84, "rev_growth": 4.7, "market_cap": 4912146432.0, "forward_pe": 17.118519, "peg": null, "payout": 17.75, "five_yr_yield": 4.35, "pe_sector_med": 27.433737, "pb_sector_med": 0.9324706, "roe_sector_med": 3.42, "div_yield_sector_med": 4.34}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 9, "target_mean": 24.34444, "target_high": 24.5, "target_low": 24.0, "rating_mean": null, "upside_pct": 5.3}, "positioning": {"shares_short": 1134490.0, "days_to_cover": 1.94, "short_pct_float": null, "held_insiders": 0.58, "held_institutions": 45.0}}, "earnings": {"next_date": "2026-07-28", "surprises": [{"date": "2015-05-04", "eps": 0.21, "est": 0.19, "surprise_pct": 9.9}, {"date": "2015-02-11", "eps": 0.21, "est": 0.21, "surprise_pct": -1.9}, {"date": "2014-11-03", "eps": 0.18, "est": 0.2, "surprise_pct": -9.6}, {"date": "2014-07-29", "eps": 0.36, "est": 0.2, "surprise_pct": 77.3}]}, "factor_beta": {"oil": -0.042, "gold": -0.032, "cad": 0.058, "r2": 0.11, "n": 504}}