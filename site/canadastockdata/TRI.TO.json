tion and changed its name to Thomson Reuters Corporation in April 2008. The company was founded in 1799 and is headquartered in Toronto, Canada. Thomson Reuters Corporation is a subsidiary of The Woodbridge Company Limited.", "sector": "Industrials", "industry": "Specialty Business Services"}, "valuation": {"pe": 23.237114, "pb": 3.0834248, "ps": 6.420192, "roe": 12.73, "net_margin": 19.93, "debt_to_equity": 22.85, "div_yield": 3.2, "rev_growth": 9.8, "market_cap": 49197928448.0, "forward_pe": 15.961356, "peg": 1.2452, "payout": 71.35, "five_yr_yield": 1.51, "pe_sector_med": 33.742035, "pb_sector_med": 2.878458, "roe_sector_med": 10.91, "div_yield_sector_med": 1.14}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 8, "target_mean": 174.76268, "target_high": 198.2103, "target_low": 135.20583, "rating_mean": 1.77778, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 55.1}, "positioning": {"shares_short": 3299120.0, "days_to_cover": 4.47, "short_pct_float": null, "held_insiders": 70.53, "held_institutions": 28.5}}, "earnings": {"next_date": "2026-08-05", "surprises": [{"date": "2026-05-05", "eps": 1.23, "est": 1.21, "surprise_pct": 1.3}, {"date": "2026-02-05", "eps": 1.09, "est": 1.08, "surprise_pct": 0.8}, {"date": "2025-11-04", "eps": 0.86, "est": 0.84, "surprise_pct": 2.9}, {"date": "2025-08-06", "eps": 0.88, "est": 0.85, "surprise_pct": 4.5}]}, "factor_beta": {"oil": 0.096, "gold": -0.233, "cad": -0.094, "r2": 0.07, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1"}}