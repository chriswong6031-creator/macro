ce, and guaranteed and partially guaranteed annuity products through multiple distribution channels, including insurance agents, brokers, banks, financial planners, and direct marketing. The Corporate and Other segment is involved in the property and casualty reinsurance businesses; and run-off reinsurance operations, including variable annuities, and accident and health. The company also manages timberland and agricultural portfolios; and engages in the insurance agency, broker dealer, investment counseling, portfolio and mutual fund management, property and casualty insurance, and fund and investment management businesses. In addition, it provides integrated banking products and services, as well as offers asset management services. The company was incorporated in 1887 and is headquartered in Toronto, Canada.", "sector": "Financial Services", "industry": "Insurance - Life"}, "valuation": {"pe": 16.417868, "pb": 1.9437716, "ps": 2.9627364, "roe": 12.56, "net_margin": 20.04, "debt_to_equity": 44.278, "div_yield": 3.28, "rev_growth": 12.1, "market_cap": 94893481984.0, "forward_pe": 11.541875, "peg": 0.776, "payout": 52.02, "five_yr_yield": 4.58, "pe_sector_med": 18.344086, "pb_sector_med": 2.239689, "roe_sector_med": 11.97, "div_yield_sector_med": 2.73}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 15, "target_mean": 55.38, "target_high": 61.0, "target_low": 41.7, "rating_mean": 2.06667, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": -2.8}, "positioning": {"shares_short": 31077238.0, "days_to_cover": 2.68, "short_pct_float": null, "held_insiders": 0.02, "held_institutions": 54.3}}, "earnings": {"next_date": "2026-08-05", "surprises": [{"date": "2026-05-13", "eps": 1.06, "est": 1.09, "surprise_pct": -3.0}, {"date": "2026-02-11", "eps": 1.12, "est": 1.06, "surprise_pct": 5.2}, {"date": "2025-11-12", "eps": 1.02, "est": 1.07, "surprise_pct": -4.4}, {"date": "2025-08-0