ns, dealers, contractor supply yards, and wholesalers, as well as industrial customers for further processing or as components for other products in Canada, the United States, the United Kingdom, Europe, and internationally. The company was founded in 1955 and is headquartered in Vancouver, Canada.", "sector": "Basic Materials", "industry": "Lumber & Wood Production"}, "valuation": {"pe": null, "pb": 1.0123287, "ps": 1.4544234, "roe": -18.56, "net_margin": -21.87, "debt_to_equity": 9.542, "div_yield": 1.85, "rev_growth": -8.6, "market_cap": 7762257920.0, "forward_pe": 30.1099, "peg": null, "payout": 72.19, "five_yr_yield": 1.44, "pe_sector_med": 16.232433, "pb_sector_med": 3.4302921, "roe_sector_med": 14.53, "div_yield_sector_med": 0.9}, "archetype": "speculative_unprofitable", "archetype_label": "Speculative / unprofitable", "archetype_label_zh": "\u6295\u673a\uff0f\u672a\u76c8\u5229", "consensus": {"n_analysts": 2, "target_mean": 108.2259, "target_high": 113.379456, "target_low": 103.07235, "rating_mean": 2.0, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 9.2}, "positioning": {"shares_short": 1851699.0, "days_to_cover": 10.2, "short_pct_float": null, "held_insiders": 32.34, "held_institutions": 58.5}}, "earnings": {"next_date": "2026-07-29", "surprises": [{"date": "2026-04-29", "eps": -2.4, "est": -1.24, "surprise_pct": -93.5}, {"date": "2026-02-11", "eps": -2.15, "est": -2.41, "surprise_pct": 10.8}, {"date": "2025-10-22", "eps": -2.59, "est": -1.43, "surprise_pct": -81.7}, {"date": "2025-07-23", "eps": -0.38, "est": 0.17, "surprise_pct": -322.0}]}, "factor_beta": {"oil": -0.064, "gold": -0.081, "cad": -0.124, "r2": 0.15, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}