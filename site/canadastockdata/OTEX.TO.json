mpany serves G10K organizations, enterprise companies, public sector agencies, mid-market companies, small and medium-sized businesses, and direct consumers. Open Text Corporation was incorporated in 1991 and is headquartered in Waterloo, Canada.", "sector": "Technology", "industry": "Software - Application"}, "valuation": {"pe": 10.682593, "pb": 1.3329666, "ps": 1.4584217, "roe": 12.76, "net_margin": 9.91, "debt_to_equity": 161.833, "div_yield": 4.97, "rev_growth": 2.2, "market_cap": 7595332096.0, "forward_pe": 4.9160123, "peg": null, "payout": 52.79, "five_yr_yield": 2.86, "pe_sector_med": 40.79966, "pb_sector_med": 7.676889, "roe_sector_med": 12.76, "div_yield_sector_med": 0.74}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 1, "target_mean": 32.136635, "target_high": 32.136635, "target_low": 32.136635, "rating_mean": 2.75, "rating": "Hold", "rating_zh": "\u6301\u6709", "upside_pct": 2.7}, "positioning": {"shares_short": 10699053.0, "days_to_cover": 2.99, "short_pct_float": 4.51, "held_insiders": 2.15, "held_institutions": 97.2}}, "earnings": {"next_date": "2026-08-06", "surprises": [{"date": "2026-05-07", "eps": 1.01, "est": 0.92, "surprise_pct": 9.7}, {"date": "2026-02-05", "eps": 1.13, "est": 1.03, "surprise_pct": 10.2}, {"date": "2025-11-05", "eps": 1.05, "est": 0.99, "surprise_pct": 6.1}, {"date": "2025-08-07", "eps": 0.97, "est": 0.83, "surprise_pct": 17.1}]}, "factor_beta": {"oil": 0.008, "gold": -0.214, "cad": 0.099, "r2": 0.21, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1"}}