. It offers its products through multiple distribution channels, such as brokers, direct-to-consumer, and managing general agent (MGA) platforms. The company was formerly known as ING Canada Inc. and changed its name to Intact Financial Corporation in 2009. Intact Financial Corporation was founded in 1809 and is based in Toronto, Canada.", "sector": "Financial Services", "industry": "Insurance - Property & Casualty"}, "valuation": {"pe": 14.544727, "pb": 2.4420445, "ps": 1.8324941, "roe": 17.19, "net_margin": 13.06, "debt_to_equity": 23.328, "div_yield": 2.12, "rev_growth": 4.5, "market_cap": 48289886208.0, "forward_pe": 14.483377, "peg": null, "payout": 29.07, "five_yr_yield": 1.96, "pe_sector_med": 18.344086, "pb_sector_med": 2.239689, "roe_sector_med": 11.97, "div_yield_sector_med": 2.73}, "archetype": "quality_compounder", "archetype_label": "Quality compounder", "archetype_label_zh": "\u4f18\u8d28\u590d\u5229\u80a1", "consensus": {"n_analysts": 13, "target_mean": 313.92307, "target_high": 372.0, "target_low": 275.0, "rating_mean": 2.0, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 14.9}, "positioning": {"shares_short": 1437754.0, "days_to_cover": 3.93, "short_pct_float": null, "held_insiders": 0.3, "held_institutions": 47.3}}, "earnings": {"next_date": "2026-07-28", "surprises": [{"date": "2026-05-05", "eps": 4.61, "est": 4.08, "surprise_pct": 13.1}, {"date": "2026-02-10", "eps": 5.89, "est": 4.69, "surprise_pct": 25.5}, {"date": "2025-11-04", "eps": 4.46, "est": 4.21, "surprise_pct": 6.0}, {"date": "2025-07-29", "eps": 5.23, "est": 4.01, "surprise_pct": 30.5}]}, "factor_beta": {"oil": -0.052, "gold": -0.059, "cad": -0.113, "r2": 0.1, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 0, "n_sells": 3, "buy_value": null, "sell_value": 4973803, "net_value": -4973803, "buy_shares": 0, "sell_shares": 30761, "net_shares": -30761, "distinct_buyers": 0, 