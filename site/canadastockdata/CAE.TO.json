e of flight simulation training devices; and ab initio pilot training and crew sourcing services, as well as airline operations digital solutions. The Defense and Security segment operates as a training and simulation provider that delivers scalable and platform-independent solutions to enable and enhance force readiness and security for defense forces, original equipment manufacturers (OEMs), government agencies, and public safety organizations. The company was formerly known as CAE Industries Ltd. and changed its name to CAE Inc. in 1993. CAE Inc. was incorporated in 1947 and is headquartered in Saint-Laurent, Canada.", "sector": "Industrials", "industry": "Aerospace & Defense"}, "valuation": {"pe": 36.474228, "pb": 2.145803, "ps": 2.3144648, "roe": 6.23, "net_margin": 6.37, "debt_to_equity": 60.025, "div_yield": null, "rev_growth": 4.0, "market_cap": 11373279232.0, "forward_pe": 23.32327, "peg": null, "payout": 0.0, "five_yr_yield": 1.4, "pe_sector_med": 33.856, "pb_sector_med": 2.9292743, "roe_sector_med": 11.26, "div_yield_sector_med": 1.14}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 14, "target_mean": 42.78571, "target_high": 50.0, "target_low": 24.0, "rating_mean": 2.0, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 20.9}, "positioning": {"shares_short": 4498431.0, "days_to_cover": 5.7, "short_pct_float": null, "held_insiders": 0.17, "held_institutions": 84.7}}, "earnings": {"next_date": "2026-08-11", "surprises": [{"date": "2026-05-21", "eps": 0.42, "est": 0.42, "surprise_pct": 0.7}, {"date": "2026-02-12", "eps": 0.34, "est": 0.3, "surprise_pct": 11.5}, {"date": "2025-11-11", "eps": 0.23, "est": 0.2, "surprise_pct": 14.9}, {"date": "2025-08-12", "eps": 0.21, "est": 0.21, "surprise_pct": -1.2}]}, "factor_beta": {"oil": -0.058, "gold": -0.254, "cad": 0.186, "r2": 0.25, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1