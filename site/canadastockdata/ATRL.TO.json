quity, undertaking complex financial modeling, and managing its infrastructure investments, such as bridges and highways, mass transit systems, power facilities, energy infrastructure, water treatment plants, and social infrastructure. Additionally, it offers staff augmentation services. The company was formerly known as SNC-Lavalin Group Inc. and changed its name to AtkinsR\u00e9alis in September 2023. AtkinsR\u00e9alis Group Inc. was founded in 1911 and is headquartered in Montreal, Canada.", "sector": "Industrials", "industry": "Engineering & Construction"}, "valuation": {"pe": 5.3857512, "pb": 2.5429585, "ps": 1.1909751, "roe": 56.97, "net_margin": 23.15, "debt_to_equity": 24.445, "div_yield": 0.1, "rev_growth": 17.8, "market_cap": 13642359808.0, "forward_pe": 17.214567, "peg": 0.6871, "payout": 0.51, "five_yr_yield": 0.19, "pe_sector_med": 33.856, "pb_sector_med": 2.9292743, "roe_sector_med": 11.26, "div_yield_sector_med": 1.14}, "archetype": "quality_compounder", "archetype_label": "Quality compounder", "archetype_label_zh": "\u4f18\u8d28\u590d\u5229\u80a1", "consensus": {"n_analysts": 15, "target_mean": 114.53333, "target_high": 131.0, "target_low": 99.0, "rating_mean": 1.53333, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 36.5}, "positioning": {"shares_short": 1478444.0, "days_to_cover": 2.64, "short_pct_float": null, "held_insiders": 0.24, "held_institutions": 48.3}}, "earnings": {"next_date": "2026-08-06", "surprises": [{"date": "2026-05-14", "eps": 0.56, "est": 0.59, "surprise_pct": -5.8}, {"date": "2026-02-27", "eps": 1.0, "est": 0.97, "surprise_pct": 2.9}, {"date": "2025-11-13", "eps": 1.1, "est": 0.88, "surprise_pct": 25.2}, {"date": "2025-08-07", "eps": 13.32, "est": 0.7, "surprise_pct": 1802.9}]}, "factor_beta": {"oil": 0.027, "gold": -0.084, "cad": -0.085, "r2": 0.24, "n": 504}, "insider": {"lean": "buying", "window_days": 180, "n_buys": 4, "n_sells": 4, "buy_value": 3746907, "sell_value": 1455524, "net_value": 2291383, "buy_shares": 