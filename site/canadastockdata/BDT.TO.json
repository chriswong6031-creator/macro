quefied natural gas, natural resources, nuclear, power, renewable energy, and water and wastewater sectors. Bird Construction Inc. was founded in 1920 and is based in Mississauga, Canada.", "sector": "Industrials", "industry": "Engineering & Construction"}, "valuation": {"pe": 64.84042, "pb": 7.824134, "ps": 0.9752352, "roe": 11.5, "net_margin": 1.43, "debt_to_equity": 88.188, "div_yield": 1.38, "rev_growth": 9.2, "market_cap": 3376830976.0, "forward_pe": 16.422817, "peg": null, "payout": 93.33, "five_yr_yield": 3.52, "pe_sector_med": 33.742035, "pb_sector_med": 2.878458, "roe_sector_med": 10.91, "div_yield_sector_med": 1.14}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 8, "target_mean": 63.375, "target_high": 72.0, "target_low": 57.0, "rating_mean": 1.5, "rating": "Strong Buy", "rating_zh": "\u5f3a\u529b\u4e70\u5165", "upside_pct": 4.0}, "positioning": {"shares_short": 941870.0, "days_to_cover": 3.0, "short_pct_float": null, "held_insiders": 2.95, "held_institutions": 27.2}}, "earnings": {"next_date": "2026-08-12", "surprises": [{"date": "2026-05-13", "eps": 0.25, "est": 0.2, "surprise_pct": 27.4}, {"date": "2026-03-11", "eps": -0.25, "est": 0.46, "surprise_pct": -153.8}, {"date": "2025-11-12", "eps": 0.57, "est": 0.54, "surprise_pct": 5.9}, {"date": "2025-08-13", "eps": 0.5, "est": 0.5, "surprise_pct": 0.1}]}, "factor_beta": {"oil": 0.084, "gold": -0.203, "cad": -0.65, "r2": 0.21, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}