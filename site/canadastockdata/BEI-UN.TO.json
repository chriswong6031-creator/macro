mmunity across Canada creating exceptional Resident Member experiences. Differentiated by its peak performance culture, Boardwalk is committed to delivering exceptional service, product quality and experience to our Resident Members who reward us with high retention and market leading operating results, which in turn, lead to higher free cash flow and investment returns, stable monthly distributions, and value creation for all our stakeholders. Boardwalk Real Estate Investment Trust was incorporated in 1983 in Alberta, Canada.", "sector": "Real Estate", "industry": "REIT - Residential"}, "valuation": {"pe": 70.81319, "pb": 0.63776726, "ps": 5.2537117, "roe": 1.18, "net_margin": 9.04, "debt_to_equity": 80.698, "div_yield": 2.61, "rev_growth": 0.9, "market_cap": 3348710400.0, "forward_pe": 13.710639, "peg": null, "payout": 181.32, "five_yr_yield": 2.01, "pe_sector_med": 27.433737, "pb_sector_med": 0.9324706, "roe_sector_med": 3.42, "div_yield_sector_med": 4.34}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 11, "target_mean": 79.15909, "target_high": 86.25, "target_low": 74.5, "rating_mean": 2.18182, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 22.8}, "positioning": {"shares_short": 815271.0, "days_to_cover": 5.37, "short_pct_float": null, "held_insiders": 17.69, "held_institutions": 38.2}}, "earnings": {"next_date": "2026-07-28", "surprises": [{"date": "2016-05-12", "eps": 1.11, "est": 0.68, "surprise_pct": 62.8}, {"date": "2016-02-18", "eps": 2.36, "est": 0.8, "surprise_pct": 194.5}, {"date": "2015-11-12", "eps": 0.78, "est": 0.89, "surprise_pct": -12.2}, {"date": "2015-05-14", "eps": 1.19, "est": 0.74, "surprise_pct": 61.0}]}, "factor_beta": {"oil": -0.012, "gold": -0.113, "cad": 0.193, "r2": 0.11, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}