 Linamar Corporation was founded in 1964 and is headquartered in Guelph, Canada.", "sector": "Consumer Cyclical", "industry": "Auto Parts"}, "valuation": {"pe": 9.799047, "pb": 0.96522415, "ps": 0.57265073, "roe": 10.51, "net_margin": 5.9, "debt_to_equity": null, "div_yield": 1.13, "rev_growth": 5.5, "market_cap": 6092496384.0, "forward_pe": 7.7534394, "peg": null, "payout": 11.05, "five_yr_yield": 1.33, "pe_sector_med": 28.347433, "pb_sector_med": 7.2476773, "roe_sector_med": 28.14, "div_yield_sector_med": 1.61}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 6, "target_mean": 105.33333, "target_high": 119.0, "target_low": 99.0, "rating_mean": null, "upside_pct": 2.4}, "positioning": {"shares_short": 534850.0, "days_to_cover": 4.34, "short_pct_float": null, "held_insiders": 36.01, "held_institutions": 22.4}}, "earnings": {"next_date": "2026-08-12", "surprises": [{"date": "2026-05-05", "eps": 3.28, "est": 2.81, "surprise_pct": 16.8}, {"date": "2026-03-04", "eps": 2.28, "est": 1.99, "surprise_pct": 14.8}, {"date": "2025-11-12", "eps": 2.51, "est": 2.41, "surprise_pct": 4.1}, {"date": "2025-08-13", "eps": 2.81, "est": 2.75, "surprise_pct": 2.2}]}, "factor_beta": {"oil": -0.022, "gold": -0.223, "cad": 0.378, "r2": 0.26, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 0, "n_sells": 3, "buy_value": null, "sell_value": 239747, "net_value": -239747, "buy_shares": 0, "sell_shares": 3428, "net_shares": -3428, "distinct_buyers": 0, "distinct_sellers": 3, "recent": [{"date": "2026-05-14", "insider": "Havasi, Csaba", "role": "Officer", "action": "sell", "shares": 3000, "value": 212610.0}, {"date": "2026-03-24", "insider": "Merchant, Christopher John", "role": "Officer", "action": "sell", "shares": 1, "value": 61.0}, {"date": "2026-01-14", "insider": "Drolc, Alexander", "role": "Officer",