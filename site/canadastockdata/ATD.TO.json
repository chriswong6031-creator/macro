nduras, Indonesia, Macau, Mexico, New Zealand, Saudi Arabia, South Africa, Tanzania, the United Arab Emirates, and Vietnam. The company was formerly known as Actidev Inc. and changed its name to Alimentation Couche-Tard Inc. in December 1994. Alimentation Couche-Tard Inc. was founded in 1980 and is headquartered in Laval, Canada.", "sector": "Consumer Cyclical", "industry": "Specialty Retail"}, "valuation": {"pe": 20.903225, "pb": 3.830956, "ps": 1.055431, "roe": 18.16, "net_margin": 3.71, "debt_to_equity": 75.868, "div_yield": 0.97, "rev_growth": -22.1, "market_cap": 77351698432.0, "forward_pe": 18.666615, "peg": null, "payout": 19.81, "five_yr_yield": 0.84, "pe_sector_med": 29.226242, "pb_sector_med": 2.9117618, "roe_sector_med": 14.36, "div_yield_sector_med": 1.9}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 19, "target_mean": 93.41429, "target_high": 107.57192, "target_low": 83.74458, "rating_mean": 1.8, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 10.9}, "positioning": {"shares_short": 4244002.0, "days_to_cover": 2.19, "short_pct_float": null, "held_insiders": 19.08, "held_institutions": 33.9}}, "earnings": {"next_date": "2026-06-23", "surprises": [{"date": "2026-03-17", "eps": 0.81, "est": 0.83, "surprise_pct": -1.9}, {"date": "2025-11-24", "eps": 0.78, "est": 0.74, "surprise_pct": 4.9}, {"date": "2025-09-02", "eps": 0.78, "est": 0.76, "surprise_pct": 2.7}, {"date": "2025-06-25", "eps": 0.46, "est": 0.48, "surprise_pct": -3.7}]}, "factor_beta": {"oil": -0.083, "gold": -0.054, "cad": -0.135, "r2": 0.15, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}