nd exports; and various other logistics processes. In addition, the company offers consulting, implementation, and training services, as well as maintenance and support services. It serves transportation providers, such as air, ocean, and truck modes; logistics service providers, including third-party logistics providers, freight forwarders, and customs brokers; and distribution-intensive companies, such as retailers, manufacturers, distributors, and mobile business service providers through subscription, transactional or perpetual license basis. The Descartes Systems Group Inc. was incorporated in 1981 and is headquartered in Waterloo, Canada.", "sector": "Technology", "industry": "Software - Application"}, "valuation": {"pe": 34.783974, "pb": 3.7045217, "ps": 11.347407, "roe": 11.42, "net_margin": 23.35, "debt_to_equity": 0.499, "div_yield": null, "rev_growth": 14.7, "market_cap": 8554514944.0, "forward_pe": 21.616137, "peg": 1.5251, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 40.79966, "pb_sector_med": 7.8605638, "roe_sector_med": 12.76, "div_yield_sector_med": 0.74}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 1, "target_mean": 132.91545, "target_high": 132.91545, "target_low": 132.91545, "rating_mean": 1.57143, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 33.1}, "positioning": {"shares_short": 1690548.0, "days_to_cover": 6.03, "short_pct_float": null, "held_insiders": 0.06, "held_institutions": 93.4}}, "earnings": {"next_date": "2026-09-02", "surprises": [{"date": "2026-06-03", "eps": 0.56, "est": 0.63, "surprise_pct": -10.0}, {"date": "2026-03-11", "eps": 0.53, "est": 0.56, "surprise_pct": -5.8}, {"date": "2025-12-03", "eps": 0.51, "est": 0.61, "surprise_pct": -16.1}, {"date": "2025-09-03", "eps": 0.48, "est": 0.52, "surprise_pct": -7.0}]}, "factor_beta": {"oil": 0.023, "gold": -0.414, "cad": -0.217, "r2": 0.17, "n": 504, "primary": "gold", "pr