ncluding digital customer experience management and the digital transformation of IT and customer experience systems; digital trust, safety, and security; AI data services; and generative AI solutions in customer experience. The company was formerly known as TELUS Communications Inc. and changed its name to TELUS Corporation in February 2005. TELUS Corporation was incorporated in 1998 and is based in Vancouver, Canada.", "sector": "Communication Services", "industry": "Telecom Services"}, "valuation": {"pe": 27.55, "pb": 1.6583066, "ps": 1.2703204, "roe": 3.74, "net_margin": 4.57, "debt_to_equity": 190.139, "div_yield": 10.06, "rev_growth": -0.6, "market_cap": 25809098752.0, "forward_pe": 16.632458, "peg": 1.0141, "payout": 278.23, "five_yr_yield": 6.18, "pe_sector_med": 8.949522, "pb_sector_med": 1.6352599, "roe_sector_med": 31.49, "div_yield_sector_med": 5.09}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 17, "target_mean": 20.27941, "target_high": 30.0, "target_low": 16.75, "rating_mean": null, "upside_pct": 22.7}, "positioning": {"shares_short": 47267283.0, "days_to_cover": 7.09, "short_pct_float": null, "held_insiders": 0.06, "held_institutions": 50.8}}, "earnings": {"next_date": "2026-07-31", "surprises": [{"date": "2026-05-08", "eps": 0.23, "est": 0.22, "surprise_pct": 5.5}, {"date": "2026-02-12", "eps": 0.2, "est": 0.25, "surprise_pct": -19.8}, {"date": "2025-11-07", "eps": 0.24, "est": 0.27, "surprise_pct": -9.7}, {"date": "2025-08-01", "eps": 0.22, "est": 0.24, "surprise_pct": -7.1}]}, "factor_beta": {"oil": -0.053, "gold": -0.003, "cad": 0.081, "r2": 0.02, "n": 504}}