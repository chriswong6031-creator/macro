uartered in Waterloo, Canada.", "sector": "Technology", "industry": "Software - Infrastructure"}, "valuation": {"pe": 99.76923, "pb": 7.295758, "ps": 13.843044, "roe": 7.26, "net_margin": 9.69, "debt_to_equity": 30.134, "div_yield": null, "rev_growth": 10.1, "market_cap": 7601216000.0, "forward_pe": 45.99917, "peg": 1.5777, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 49.009563, "pb_sector_med": 7.295758, "roe_sector_med": 12.76, "div_yield_sector_med": 0.73}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 2, "target_mean": 5.8453984, "target_high": 6.122418, "target_low": 5.5683784, "rating_mean": 3.0, "rating": "Hold", "rating_zh": "\u6301\u6709", "upside_pct": -54.9}, "positioning": {"shares_short": 9441674.0, "days_to_cover": 1.6, "short_pct_float": 1.61, "held_insiders": 0.35, "held_institutions": 46.6}}, "earnings": {"next_date": "2026-06-25", "surprises": [{"date": "2026-04-09", "eps": 0.06, "est": 0.04, "surprise_pct": 38.5}, {"date": "2025-12-18", "eps": 0.02, "est": 0.04, "surprise_pct": -50.0}, {"date": "2025-09-25", "eps": 0.04, "est": 0.01, "surprise_pct": 185.7}, {"date": "2025-06-24", "eps": 0.02, "est": null, "surprise_pct": 669.2}]}, "factor_beta": {"oil": 0.006, "gold": -0.249, "cad": 0.055, "r2": 0.13, "n": 504, "primary": "gold", "primary_label": "Gold", "primary_label_zh": "\u9ec4\u91d1"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 0, "n_sells": 19, "buy_value": null, "sell_value": 1660528, "net_value": -1660528, "buy_shares": 0, "sell_shares": 438052, "net_shares": -438052, "distinct_buyers": 0, "distinct_sellers": 4, "recent": [{"date": "2026-04-02", "insider": "Armstrong-Owen (Jennifer)", "role": "Officer", "action": "sell", "shares": 29908, "value": 106472.0}, {"date": "2026-04-02", "insider": "Armstrong-Owen (Jennifer)", "role": "Officer", "action": "sell", "shares": 2888, "value": 10281.0}, {"date": "2026-04-02", "insider": 