sate; and engages in the liquids blending activities. The Marketing segment offers propane, butane, condensate, and iso-octane, as well as natural gas and crude oil. The company was formerly known as Keyera Facilities Income Fund and changed its name to Keyera Corp. in January 2011. Keyera Corp. was founded in 1998 and is headquartered in Calgary, Canada.", "sector": "Energy", "industry": "Oil & Gas Midstream"}, "valuation": {"pe": 72.40506, "pb": 5.1957493, "ps": 2.0511315, "roe": 6.71, "net_margin": 2.81, "debt_to_equity": 249.097, "div_yield": 3.66, "rev_growth": -26.1, "market_cap": 13115506688.0, "forward_pe": 18.414309, "peg": 1.8931, "payout": 270.89, "five_yr_yield": 5.46, "pe_sector_med": 28.485619, "pb_sector_med": 2.8986645, "roe_sector_med": 9.6, "div_yield_sector_med": 3.16}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 14, "target_mean": 60.92857, "target_high": 68.0, "target_low": 53.0, "rating_mean": 1.92857, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 6.5}, "positioning": {"shares_short": 9004392.0, "days_to_cover": 5.53, "short_pct_float": null, "held_insiders": 0.3, "held_institutions": 47.0}}, "earnings": {"next_date": "2026-08-06", "surprises": [{"date": "2026-05-14", "eps": 0.2, "est": 0.13, "surprise_pct": 55.3}, {"date": "2026-02-12", "eps": 0.55, "est": 0.42, "surprise_pct": 28.7}, {"date": "2025-11-14", "eps": 0.4, "est": 0.51, "surprise_pct": -22.6}, {"date": "2025-08-07", "eps": 0.55, "est": 0.36, "surprise_pct": 53.1}]}, "factor_beta": {"oil": 0.139, "gold": -0.099, "cad": -0.013, "r2": 0.15, "n": 504, "primary": "oil", "primary_label": "Oil", "primary_label_zh": "\u539f\u6cb9"}}