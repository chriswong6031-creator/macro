opane, butane, condensate, and iso-octane, as well as natural gas and crude oil. The company was formerly known as Keyera Facilities Income Fund and changed its name to Keyera Corp. in January 2011. Keyera Corp. was founded in 1998 and is headquartered in Calgary, Canada.", "sector": "Energy", "industry": "Oil & Gas Midstream"}, "valuation": {"pe": 73.97468, "pb": 5.308384, "ps": 2.681884, "roe": 6.71, "net_margin": 2.81, "debt_to_equity": 249.097, "div_yield": 3.7, "rev_growth": -26.1, "market_cap": 17148713984.0, "forward_pe": 18.618816, "peg": 1.8931, "payout": 270.89, "five_yr_yield": 5.46, "pe_sector_med": 29.153393, "pb_sector_med": 2.7928689, "roe_sector_med": 9.6, "div_yield_sector_med": 3.32}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 14, "target_mean": 62.92857, "target_high": 68.0, "target_low": 53.0, "rating_mean": 1.78571, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 7.7}, "positioning": {"shares_short": 10409209.0, "days_to_cover": 3.86, "short_pct_float": null, "held_insiders": 0.29, "held_institutions": 46.0}}, "earnings": {"next_date": "2026-08-06", "surprises": [{"date": "2026-05-14", "eps": 0.2, "est": 0.13, "surprise_pct": 55.3}, {"date": "2026-02-12", "eps": 0.55, "est": 0.42, "surprise_pct": 28.7}, {"date": "2025-11-14", "eps": 0.4, "est": 0.51, "surprise_pct": -22.6}, {"date": "2025-08-07", "eps": 0.35, "est": 0.4, "surprise_pct": -11.4}]}, "factor_beta": {"oil": 0.137, "gold": -0.096, "cad": -0.006, "r2": 0.15, "n": 504, "primary": "oil", "primary_label": "Oil", "primary_label_zh": "\u539f\u6cb9"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 1, "n_sells": 1, "buy_value": 14988, "sell_value": 2123850, "net_value": -2108862, "buy_shares": 500, "sell_shares": 50000, "net_shares": -49500, "distinct_buyers": 1, "distinct_sellers": 1, "recent": [{"date": "2026-05-19", "insider": "Bertram (James Vanc