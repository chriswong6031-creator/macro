nchise-owned retail food, and associate-owned drug stores, including in-store pharmacies, health care services, health and beauty products, apparel, and other general merchandise. This segment offers credit card and banking services, guaranteed investment certificates, loyalty program, insurance brokerage services, and telecommunication services. The Choice Properties segment owns, develops, and manages commercial and residential properties, which are leased to necessity-based tenants and logistics providers. The company markets its products under the Shoppers Drug Mart, Joe Fresh, President's Choice Bank, PC Financial, no name, Farmer's Market, T&T, Life Brand, and PC Optimum brands. The company was founded in 1882 and is based in Toronto, Canada. George Weston Limited is a subsidiary of Wittington Investments, Limited.", "sector": "Consumer Defensive", "industry": "Grocery Stores"}, "valuation": {"pe": 38.11111, "pb": 9.560532, "ps": 0.5960088, "roe": 19.38, "net_margin": 1.79, "debt_to_equity": 163.632, "div_yield": 1.24, "rev_growth": 4.2, "market_cap": 38797787136.0, "forward_pe": 19.045786, "peg": 1.2777, "payout": 44.14, "five_yr_yield": 1.5, "pe_sector_med": 29.226242, "pb_sector_med": 2.9117618, "roe_sector_med": 14.36, "div_yield_sector_med": 1.9}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 8, "target_mean": 107.875, "target_high": 121.0, "target_low": 74.0, "rating_mean": null, "upside_pct": 4.8}, "positioning": {"shares_short": 1119988.0, "days_to_cover": 2.86, "short_pct_float": null, "held_insiders": 59.72, "held_institutions": 14.9}}, "earnings": {"next_date": "2026-07-28", "surprises": [{"date": "2026-03-04", "eps": 0.72, "est": 1.2, "surprise_pct": -40.0}, {"date": "2025-11-14", "eps": 1.37, "est": 1.32, "surprise_pct": 4.2}, {"date": "2025-07-29", "eps": 1.02, "est": 1.12, "surprise_pct": -9.2}, {"date": "2025-05-06", "eps": 0.86, "est": 0.91, "surprise_pct