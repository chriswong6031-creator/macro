astructure, utility infrastructure, and industrial infrastructure market sectors. The Concessions segment engages in the development, financing, building, and operation of construction projects by way of public-private partnership contract structures. This segment also provides development of domestic international public-private partnership; private finance solution; developing strategic partnerships; leading and/or participating in development teams; and operations and maintenance of infrastructure assets services. Aecon Group Inc. was formerly known as Prefac Concrete Co. Ltd. and changed its name to Aecon Group Inc. in June 2001. The company was founded in 1867 and is headquartered in Toronto, Canada.", "sector": "Industrials", "industry": "Engineering & Construction"}, "valuation": {"pe": 77.5, "pb": 2.878458, "ps": 0.54664195, "roe": 3.57, "net_margin": 0.62, "debt_to_equity": 60.132, "div_yield": 1.82, "rev_growth": 18.4, "market_cap": 3077606144.0, "forward_pe": 24.446356, "peg": null, "payout": 138.64, "five_yr_yield": 4.55, "pe_sector_med": 33.742035, "pb_sector_med": 2.878458, "roe_sector_med": 10.91, "div_yield_sector_med": 1.14}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 11, "target_mean": 52.18182, "target_high": 62.0, "target_low": 46.0, "rating_mean": 2.63636, "rating": "Hold", "rating_zh": "\u6301\u6709", "upside_pct": 16.1}, "positioning": {"shares_short": 2336395.0, "days_to_cover": 4.71, "short_pct_float": null, "held_insiders": 0.71, "held_institutions": 31.0}}, "earnings": {"next_date": "2026-07-30", "surprises": [{"date": "2026-04-28", "eps": -0.21, "est": -0.22, "surprise_pct": 5.1}, {"date": "2026-03-05", "eps": 0.52, "est": 0.33, "surprise_pct": 56.4}, {"date": "2025-10-29", "eps": 0.53, "est": 0.45, "surprise_pct": 18.0}, {"date": "2025-07-31", "eps": -0.09, "est": 0.04, "surprise_pct": -319.6}]}, "factor_beta": {"oil": 0.011, "gold": -0.156, "cad