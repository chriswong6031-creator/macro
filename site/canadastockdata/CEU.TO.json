 was incorporated in 1986 and is headquartered in Calgary, Canada.", "sector": "Energy", "industry": "Oil & Gas Equipment & Services"}, "valuation": {"pe": 17.164948, "pb": 4.1645823, "ps": 1.380441, "roe": 25.22, "net_margin": 8.29, "debt_to_equity": 55.706, "div_yield": 1.17, "rev_growth": 7.8, "market_cap": 3510774528.0, "forward_pe": 13.259431, "peg": null, "payout": 18.81, "five_yr_yield": 2.05, "pe_sector_med": 29.153393, "pb_sector_med": 2.7928689, "roe_sector_med": 9.6, "div_yield_sector_med": 3.32}, "archetype": "quality_compounder", "archetype_label": "Quality compounder", "archetype_label_zh": "\u4f18\u8d28\u590d\u5229\u80a1", "consensus": {"n_analysts": 8, "target_mean": 21.75, "target_high": 24.0, "target_low": 19.0, "rating_mean": 2.0, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 30.6}, "positioning": {"shares_short": 3477890.0, "days_to_cover": 7.34, "short_pct_float": null, "held_insiders": 2.37, "held_institutions": 54.4}}, "earnings": {"next_date": "2026-08-06", "surprises": [{"date": "2026-05-08", "eps": 0.24, "est": 0.24, "surprise_pct": 1.1}, {"date": "2026-03-10", "eps": 0.32, "est": 0.23, "surprise_pct": 40.4}, {"date": "2025-11-13", "eps": 0.18, "est": 0.21, "surprise_pct": -15.1}, {"date": "2025-08-07", "eps": 0.23, "est": 0.18, "surprise_pct": 30.7}]}, "factor_beta": {"oil": 0.273, "gold": -0.18, "cad": -0.372, "r2": 0.27, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 0, "n_sells": 27, "buy_value": null, "sell_value": 20597665, "net_value": -20597665, "buy_shares": 0, "sell_shares": 1564598, "net_shares": -1564598, "distinct_buyers": 0, "distinct_sellers": 11, "recent": [{"date": "2026-05-22", "insider": "Hooks (John Michael)", "role": "Director", "action": "sell", "shares": 133800, "value": 1832123.0}, {"date": "2026-04-01", "insider": "Armour (Spencer Davis III)", "role": "Director", "action": "sell", "shares": 1, "val