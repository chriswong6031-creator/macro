d polymer components. The Aftermarket Operations segment engages in the sale of aftermarket parts and services for transit buses, coaches, and medium-duty/cutaway buses. In addition, the company offers heavy-duty transit buses under the New Flyer brand name; single and double-deck buses under the and Alexander Dennis brand; motor coaches under he MCI brand name; and low-floor cutaway, and medium-duty buses under the ARBOC brand, as well as sells aftermarket parts under the NFI Parts brand. It also engages in infrastructure solutions, connected vehicles and diagnostics, and aftermarket, warranty, and service. NFI Group Inc. was founded in 1895 and is headquartered in Winnipeg, Canada.", "sector": "Consumer Cyclical", "industry": "Auto Manufacturers"}, "valuation": {"pe": null, "pb": 3.3074024, "ps": 0.7544886, "roe": -19.08, "net_margin": -3.43, "debt_to_equity": 221.048, "div_yield": null, "rev_growth": 0.1, "market_cap": 2727568128.0, "forward_pe": 11.595728, "peg": null, "payout": 0.0, "five_yr_yield": 4.33, "pe_sector_med": 33.856, "pb_sector_med": 2.9292743, "roe_sector_med": 11.26, "div_yield_sector_med": 1.14}, "archetype": "speculative_unprofitable", "archetype_label": "Speculative / unprofitable", "archetype_label_zh": "\u6295\u673a\uff0f\u672a\u76c8\u5229", "consensus": {"n_analysts": 8, "target_mean": 27.302845, "target_high": 29.43392, "target_low": 25.552677, "rating_mean": 1.5, "rating": "Strong Buy", "rating_zh": "\u5f3a\u529b\u4e70\u5165", "upside_pct": 19.2}, "positioning": {"shares_short": 1397577.0, "days_to_cover": 4.54, "short_pct_float": null, "held_insiders": 0.42, "held_institutions": 36.6}}, "earnings": {"next_date": "2026-07-30", "surprises": [{"date": "2026-05-07", "eps": 0.18, "est": 0.17, "surprise_pct": 3.9}, {"date": "2026-03-11", "eps": 1.39, "est": 0.85, "surprise_pct": 64.5}, {"date": "2025-11-06", "eps": 0.1, "est": 0.1, "surprise_pct": null}, {"date": "2025-07-31", "eps": 0.09, "est": 0.09, "surprise_pct": 2.1}]}, "factor_beta": {"