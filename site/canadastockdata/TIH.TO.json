ry, on-highway truck engines, industrial, demolition and waste management markets. The CIMCO segment is involved in the design, engineering, fabrication, installation, and after-sale support of refrigeration systems in industrial and recreational markets, as well as supplies thermal management solutions. This segment primarily serves beverage and food processing, cold storage, food distribution, mining, and recreational ice rink sectors. Toromont Industries Ltd. was founded in 1961 and is headquartered in Concord, Canada.", "sector": "Industrials", "industry": "Industrial Distribution"}, "valuation": {"pe": 33.742035, "pb": 5.148202, "ps": 3.2346036, "roe": 16.27, "net_margin": 9.64, "debt_to_equity": 25.188, "div_yield": 1.03, "rev_growth": 12.7, "market_cap": 17276946432.0, "forward_pe": 25.619759, "peg": null, "payout": 33.7, "five_yr_yield": 1.4, "pe_sector_med": 33.856, "pb_sector_med": 2.9292743, "roe_sector_med": 11.26, "div_yield_sector_med": 1.14}, "archetype": "quality_compounder", "archetype_label": "Quality compounder", "archetype_label_zh": "\u4f18\u8d28\u590d\u5229\u80a1", "consensus": {"n_analysts": 9, "target_mean": 227.55556, "target_high": 242.0, "target_low": 190.0, "rating_mean": null, "upside_pct": 7.4}, "positioning": {"shares_short": 1176940.0, "days_to_cover": 4.63, "short_pct_float": null, "held_insiders": 0.04, "held_institutions": 44.7}}, "earnings": {"next_date": "2026-07-28", "surprises": [{"date": "2026-04-28", "eps": 1.13, "est": 1.07, "surprise_pct": 5.8}, {"date": "2026-02-10", "eps": 1.92, "est": 1.89, "surprise_pct": 1.4}, {"date": "2025-10-30", "eps": 1.72, "est": 1.57, "surprise_pct": 9.2}, {"date": "2025-07-29", "eps": 1.52, "est": 1.49, "surprise_pct": 1.8}]}, "factor_beta": {"oil": -0.075, "gold": -0.097, "cad": -0.132, "r2": 0.16, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 0, "n_sells": 39, "buy_value": null, "sell_va