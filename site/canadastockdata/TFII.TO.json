xpedited transportation, flatbed, tank, container, and dedicated services. This segment also carries full loads directly from the customer to the destination using a closed van or specialized equipment. The Logistics segment provides asset-light logistics services, including brokerage, freight forwarding, and transportation management, as well as small package parcel delivery. As of December 31, 2025, it operates 12,927 trucks, 40,687 trailers, and 6,194 independent contractors. The company was formerly known as TransForce Inc. and changed its name to TFI International Inc. in December 2016. TFI International Inc. was founded in 1957 and is headquartered in Saint-Laurent, Canada.", "sector": "Industrials", "industry": "Trucking"}, "valuation": {"pe": 43.566, "pb": 4.806442, "ps": 2.2749655, "roe": 11.26, "net_margin": 3.79, "debt_to_equity": 119.569, "div_yield": 1.14, "rev_growth": -0.8, "market_cap": 17902583808.0, "forward_pe": 21.946371, "peg": null, "payout": 51.25, "five_yr_yield": 1.26, "pe_sector_med": 33.856, "pb_sector_med": 2.9292743, "roe_sector_med": 11.26, "div_yield_sector_med": 1.14}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 10, "target_mean": 207.24924, "target_high": 246.83743, "target_low": 153.8878, "rating_mean": 1.83333, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": -4.9}, "positioning": {"shares_short": 695577.0, "days_to_cover": 3.03, "short_pct_float": null, "held_insiders": 6.34, "held_institutions": 80.4}}, "earnings": {"next_date": "2026-07-28", "surprises": [{"date": "2026-04-27", "eps": 0.69, "est": 0.61, "surprise_pct": 13.3}, {"date": "2026-02-17", "eps": 1.09, "est": 0.85, "surprise_pct": 27.9}, {"date": "2025-10-30", "eps": 1.2, "est": 1.2, "surprise_pct": 0.1}, {"date": "2025-07-28", "eps": 1.34, "est": 1.23, "surprise_pct": 8.6}]}, "factor_beta": {"oil": -0.092, "gold": -0.292, "cad": 0.348, "r2": 0.21, "n": 504, "primary":