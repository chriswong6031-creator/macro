 Alberta. The company was formerly known as Athabasca Oil Sands Corp. and changed its name to Athabasca Oil Corporation in May 2012. Athabasca Oil Corporation was incorporated in 2006 and is headquartered in Calgary, Canada.", "sector": "Energy", "industry": "Oil & Gas E&P"}, "valuation": {"pe": 24.6, "pb": 2.8986645, "ps": 4.002803, "roe": 11.43, "net_margin": 16.39, "debt_to_equity": 10.872, "div_yield": null, "rev_growth": 8.1, "market_cap": 5357879808.0, "forward_pe": 12.209514, "peg": null, "payout": 0.0, "five_yr_yield": null, "pe_sector_med": 28.485619, "pb_sector_med": 2.8986645, "roe_sector_med": 9.6, "div_yield_sector_med": 3.16}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 9, "target_mean": 12.72222, "target_high": 14.5, "target_low": 11.0, "rating_mean": 2.0, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 14.9}, "positioning": {"shares_short": 32008652.0, "days_to_cover": 13.92, "short_pct_float": null, "held_insiders": 1.39, "held_institutions": 39.4}}, "earnings": {"next_date": "2026-07-29", "surprises": [{"date": "2026-05-06", "eps": 0.1, "est": 0.11, "surprise_pct": -9.1}, {"date": "2026-03-04", "eps": 0.1, "est": 0.13, "surprise_pct": -23.1}, {"date": "2025-10-29", "eps": 0.14, "est": 0.14, "surprise_pct": -3.5}, {"date": "2025-07-24", "eps": 0.11, "est": 0.14, "surprise_pct": -21.4}]}, "factor_beta": {"oil": 0.491, "gold": -0.212, "cad": -0.005, "r2": 0.43, "n": 504, "primary": "oil", "primary_label": "Oil", "primary_label_zh": "\u539f\u6cb9"}}