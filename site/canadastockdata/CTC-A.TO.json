pates in loyalty programs, as well as sells its products through online. The CT REIT segment operates as a closed-end real estate investment trust that holds a portfolio of properties comprising Canadian Tire stores, Canadian Tire anchored retail developments, industrial properties, mixed-use commercial property, and development properties. The Financial Services segment provides consumer credit cards; in-store financing to consumers; insurance products, and retail and broker deposits; and savings accounts and guaranteed investment certificates. Canadian Tire Corporation, Limited was founded in 1922 and is headquartered in Toronto, Canada.", "sector": "Consumer Cyclical", "industry": "Specialty Retail"}, "valuation": {"pe": 16.10157, "pb": 1.7601712, "ps": 0.6244173, "roe": 10.83, "net_margin": 3.63, "debt_to_equity": 159.236, "div_yield": 3.69, "rev_growth": 3.3, "market_cap": 10258989056.0, "forward_pe": 12.254959, "peg": null, "payout": 58.88, "five_yr_yield": 3.93, "pe_sector_med": 27.068047, "pb_sector_med": 6.8998218, "roe_sector_med": 28.14, "div_yield_sector_med": 1.86}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 10, "target_mean": 193.5, "target_high": 216.0, "target_low": 165.0, "rating_mean": 2.8, "rating": "Hold", "rating_zh": "\u6301\u6709", "upside_pct": -0.8}, "positioning": {"shares_short": 1305303.0, "days_to_cover": 4.94, "short_pct_float": null, "held_insiders": 2.04, "held_institutions": 38.5}}, "earnings": {"next_date": null, "surprises": [{"date": "2026-05-14", "eps": 2.02, "est": 1.81, "surprise_pct": 11.5}, {"date": "2026-02-18", "eps": 4.47, "est": 3.8, "surprise_pct": 17.5}, {"date": "2025-11-06", "eps": 3.78, "est": 2.84, "surprise_pct": 33.2}, {"date": "2025-08-07", "eps": 3.57, "est": 3.93, "surprise_pct": -9.2}]}, "factor_beta": {"oil": -0.042, "gold": -0.089, "cad": -0.172, "r2": 0.1, "n": 504, "primary": "usdcad", "pr