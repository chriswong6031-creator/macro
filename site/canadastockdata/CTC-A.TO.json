ed retail developments, industrial properties, mixed-use commercial property, and development properties. The Financial Services segment provides consumer credit cards; in-store financing to consumers; insurance products, and retail and broker deposits; and savings accounts and guaranteed investment certificates. Canadian Tire Corporation, Limited was founded in 1922 and is headquartered in Toronto, Canada.", "sector": "Consumer Cyclical", "industry": "Specialty Retail"}, "valuation": {"pe": 15.39752, "pb": 1.6818169, "ps": 0.5966213, "roe": 10.83, "net_margin": 3.63, "debt_to_equity": 159.236, "div_yield": 3.86, "rev_growth": 3.3, "market_cap": 9802308608.0, "forward_pe": 11.761972, "peg": null, "payout": 58.88, "five_yr_yield": 3.93, "pe_sector_med": 24.380182, "pb_sector_med": 7.2476773, "roe_sector_med": 28.14, "div_yield_sector_med": 2.74}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 11, "target_mean": 193.18182, "target_high": 216.0, "target_low": 165.0, "rating_mean": 2.81818, "rating": "Hold", "rating_zh": "\u6301\u6709", "upside_pct": 3.7}, "positioning": {"shares_short": 1212916.0, "days_to_cover": 4.74, "short_pct_float": null, "held_insiders": 2.04, "held_institutions": 38.3}}, "earnings": {"next_date": null, "surprises": [{"date": "2026-05-14", "eps": 2.02, "est": 1.81, "surprise_pct": 11.5}, {"date": "2026-02-18", "eps": 4.47, "est": 3.8, "surprise_pct": 17.5}, {"date": "2025-11-06", "eps": 3.78, "est": 2.84, "surprise_pct": 33.2}, {"date": "2025-08-07", "eps": 3.57, "est": 3.93, "surprise_pct": -9.2}]}, "factor_beta": {"oil": -0.046, "gold": -0.088, "cad": -0.135, "r2": 0.1, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}