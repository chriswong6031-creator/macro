ze warehouse stores. Additionally, the company also offers gasoline. The North West Company Inc. was formerly known as North West Company Fund and changed its name to The North West Company Inc. in January 2011. The North West Company Inc. Inc was founded in 1668 and is headquartered in Winnipeg, Canada.", "sector": "Consumer Defensive", "industry": "Grocery Stores"}, "valuation": {"pe": 17.075861, "pb": 2.901506, "ps": 0.90800494, "roe": 18.21, "net_margin": 5.45, "debt_to_equity": 55.284, "div_yield": 3.36, "rev_growth": -1.5, "market_cap": 2350347264.0, "forward_pe": 13.004885, "peg": null, "payout": 56.21, "five_yr_yield": 3.81, "pe_sector_med": 29.226242, "pb_sector_med": 2.9117618, "roe_sector_med": 14.36, "div_yield_sector_med": 1.9}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 4, "target_mean": 60.25, "target_high": 63.0, "target_low": 58.0, "rating_mean": 1.25, "rating": "Strong Buy", "rating_zh": "\u5f3a\u529b\u4e70\u5165", "upside_pct": 21.7}, "positioning": {"shares_short": 737687.0, "days_to_cover": 5.48, "short_pct_float": null, "held_insiders": 0.12, "held_institutions": 36.1}}, "earnings": {"next_date": "2026-09-08", "surprises": [{"date": "2026-06-09", "eps": 0.62, "est": 0.67, "surprise_pct": -7.0}, {"date": "2026-04-08", "eps": 0.9, "est": 0.85, "surprise_pct": 5.1}, {"date": "2025-12-09", "eps": 0.89, "est": 0.82, "surprise_pct": 8.9}, {"date": "2025-09-08", "eps": 0.81, "est": 0.76, "surprise_pct": 6.2}]}, "factor_beta": {"oil": -0.039, "gold": 0.016, "cad": 0.164, "r2": 0.04, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}, "insider": {"lean": "selling", "window_days": 180, "n_buys": 2, "n_sells": 1, "buy_value": 62729, "sell_value": 67489, "net_value": -4760, "buy_shares": 2000, "sell_shares": 1729, "net_shares": 271, "distinct_buyers": 1, "distinct_sellers": 1, "recent": [{"date": "20