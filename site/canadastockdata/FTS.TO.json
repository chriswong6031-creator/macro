d generating capacity of 145 MW; and on Prince Edward Island with a generating capacity of 90 MW. Additionally, it provides integrated electric utility service to approximately 70,000 customers in Ontario; approximately 280,000 customers in Newfoundland; approximately 35,000 customers on Grand Cayman, Cayman Islands; and approximately 92,000 customers on Maritime Electric. It also owns and operates approximately 91,100 circuit Kilometers (km) of distribution lines; and approximately 51,700 km of natural gas pipelines. Fortis Inc. was founded in 1885 and is headquartered in St. John's, Canada.", "sector": "Utilities", "industry": "Utilities - Regulated Electric"}, "valuation": {"pe": 23.663717, "pb": 1.7944704, "ps": 3.3381815, "roe": 7.46, "net_margin": 14.73, "debt_to_equity": 133.697, "div_yield": 3.18, "rev_growth": 1.9, "market_cap": 40842649600.0, "forward_pe": 20.706104, "peg": 2.822, "payout": 74.04, "five_yr_yield": 3.77, "pe_sector_med": 29.42857, "pb_sector_med": 2.486844, "roe_sector_med": 3.02, "div_yield_sector_med": 3.18}, "archetype": "dividend_defensive", "archetype_label": "Dividend / defensive", "archetype_label_zh": "\u9ad8\u80a1\u606f\u9632\u5fa1", "consensus": {"n_analysts": 15, "target_mean": 79.36667, "target_high": 85.0, "target_low": 71.0, "rating_mean": 2.8125, "rating": "Hold", "rating_zh": "\u6301\u6709", "upside_pct": -1.1}, "positioning": {"shares_short": 7130382.0, "days_to_cover": 3.41, "short_pct_float": null, "held_insiders": 0.2, "held_institutions": 56.4}}, "earnings": {"next_date": "2026-07-31", "surprises": [{"date": "2026-05-06", "eps": 0.99, "est": 1.0, "surprise_pct": -0.8}, {"date": "2026-02-12", "eps": 0.9, "est": 0.85, "surprise_pct": 5.9}, {"date": "2025-11-04", "eps": 0.87, "est": 0.85, "surprise_pct": 2.2}, {"date": "2025-08-01", "eps": 0.76, "est": 0.7, "surprise_pct": 8.3}]}, "factor_beta": {"oil": -0.028, "gold": 0.038, "cad": 0.103, "r2": 0.01, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh