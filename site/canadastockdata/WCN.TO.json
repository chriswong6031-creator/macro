uids, drill cuttings, completion fluids, and flowback water; production wastes and produced water during a well's operating life; contaminated soils that require treatment during site reclamation; and substances, which require clean-up after a spill, reserve pit clean-up, or pipeline rupture. Waste Connections, Inc. was founded in 1997 and is based in Woodbridge, Canada.", "sector": "Industrials", "industry": "Waste Management"}, "valuation": {"pe": 40.78559, "pb": 5.3014536, "ps": 6.28713, "roe": 13.12, "net_margin": 10.97, "debt_to_equity": 117.097, "div_yield": 0.81, "rev_growth": 6.4, "market_cap": 60415356928.0, "forward_pe": 27.00017, "peg": 1.8722, "payout": 32.44, "five_yr_yield": 0.68, "pe_sector_med": 36.786964, "pb_sector_med": 3.064072, "roe_sector_med": 11.26, "div_yield_sector_med": 1.26}, "archetype": "mixed", "archetype_label": "Mixed profile", "archetype_label_zh": "\u6df7\u5408\u7279\u5f81", "consensus": {"n_analysts": 7, "target_mean": 257.00223, "target_high": 317.57373, "target_low": 199.18013, "rating_mean": 1.51852, "rating": "Buy", "rating_zh": "\u4e70\u5165", "upside_pct": 8.1}, "positioning": {"shares_short": 1431387.0, "days_to_cover": 3.9, "short_pct_float": 0.65, "held_insiders": 0.25, "held_institutions": 90.7}}, "earnings": {"next_date": "2026-07-22", "surprises": [{"date": "2026-04-22", "eps": 1.23, "est": 1.18, "surprise_pct": 3.9}, {"date": "2026-02-11", "eps": 1.29, "est": 1.27, "surprise_pct": 1.5}, {"date": "2025-10-21", "eps": 1.44, "est": 1.38, "surprise_pct": 4.4}, {"date": "2025-07-23", "eps": 1.29, "est": 1.25, "surprise_pct": 2.8}]}, "factor_beta": {"oil": 0.038, "gold": -0.09, "cad": -0.22, "r2": 0.07, "n": 504, "primary": "usdcad", "primary_label": "CAD", "primary_label_zh": "\u52a0\u5143"}}