{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "Evidence run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "collector_version",
    "run_id",
    "run_started_at",
    "repository",
    "repo_head_sha",
    "working_tree_dirty",
    "browser_name",
    "device_scale_factor",
    "source_parity_method"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "collector_version": {"type": "string", "minLength": 40, "maxLength": 40},
    "run_id": {"type": "string"},
    "repo_head_sha": {"type": "string", "minLength": 40, "maxLength": 40}
  }
}
