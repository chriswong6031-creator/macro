__pycache__/
*.pyc
.DS_Store
.env
site/_tmp/
site/stockdata/
site/ohlc/
site/stockbrief/
site/chinastockdata/
site/hkstockdata/
site/canadastockdata/
site/intlstockdata/
site/chinaohlc/
site/canadaohlc/
site/intlohlc/
