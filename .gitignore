# trial_ledger.jsonl and live_ledger.jsonl are append-only result ledgers.
# promotion_queue.json is the Fable-adjudicated promotion candidate list.
!data/oracle/compounds/registry.jsonl
!data/oracle/compounds/trial_ledger.jsonl
!data/oracle/compounds/live_ledger.jsonl
!data/oracle/promotion_queue.json
data/oracle/memory_active_analogues.json
# P9 Hypothesis Inbox — append-only governance data, committed per constitution.
# hypothesis_state.json is also governance data (tracks graded ids + sentinel line count).
!data/oracle/hypothesis_inbox.jsonl
!data/oracle/hypothesis_state.json

