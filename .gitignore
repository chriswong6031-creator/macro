.venv/
.review_venv/
__pycache__/
*.pyc
.DS_Store
.env
# VPS deploy artifact: Caddy's served root is an atomic rsync mirror of site/,
# living OUTSIDE the git work-tree so `git reset --hard` can't expose a partial
# file (app/deploy/update.sh + Caddyfile). Box-only; never committed.
site.served/
site/_tmp/
site/stockdata/
site/ohlc/
site/stockbrief/
site/chinastockdata/
site/hkstockdata/
site/canadastockdata/
site/intlstockdata/
site/chinaohlc/
site/canadaohlc/
site/intlohlc/
site/hkohlc/
site/intraday/
# machine-consumable contract plane (scripts/build_feeds.py) — R2-only by design,
# regenerated every daily run; consumers read the R2 _manifest.json, never git
site/feeds/
# live intraday overlay — runtime artifact written by scripts/build_live_overlay (intraday
# cron) and by the offline test path; never committed (the cron force-pushes / re-emits it).
site/live/
# Polygon hourly bars for the 4H chart timeframe — regenerable + daily-changing, so
# cached cross-job in CI (actions/cache) rather than committed; site/intraday is the
# force-tracked, shipped artifact.
data/intraday/
# Financial-news fetch cache (engine/financial_news) — transient 12h fetch cache,
# regenerated every build. NOT committed: a keyless local cache must never shadow
# CI's keyed (Polygon/Finnhub) fetch within the TTL window.
data/financial_news/
data/breadth/_closes_cache.parquet
data/smallcap_breadth/_closes_cache.parquet
data/midcap_breadth/_closes_cache.parquet
data/china_breadth/_closes_cache.parquet
data/hk_breadth/_closes_cache.parquet
data/canada_breadth/_closes_cache.parquet
# hk_shorts: positions.parquet + turnover.parquet + coverage.json are GIT-tracked
# (NOT R2) because they are not regenerable without re-scraping and are critical
# evidence for the H2a phase-0 test.  Only the _closes_cache-equivalent rebuild
# artifacts are excluded (none exist for this store).
# NOTE: data/hk_shorts/ is intentionally NOT listed here — all files are committed.
# hk_placements (H-PLC, W1c): events.parquet + coverage.json are GIT-tracked (NOT R2)
# — tiny append-only event store (~1.5k rows/yr), evidence for the post-placement
# drift accrual. data/hk_placements/ intentionally NOT listed here.
# data-quality audit revision baselines: a daily-changing full copy of the macro series
# (machine state for backwards-revision detection), cached cross-run in CI rather than
# committed. The audit JSON reports under data/quality/*.json ARE committed (trend artifact).
data/quality/baselines/
# Leading-leg validation caches (regenerated by scripts/validate_*.py): the EDGAR 13D/13G
# quarterly backfill (~7MB) + the yfinance price panels (~14MB). Only the small gate JSONs
# + reports are committed; these heavy caches are never.
data/beneficial_ownership/_backfill/
data/index_reconstitution/prices.parquet
data/index_reconstitution/prices_attempted.json
data/index_reconstitution/ohlc.parquet
data/index_reconstitution/ohlc_attempted.json
# IPO Radar ticker→CIK map cache (regenerable from SEC company_tickers.json; ~170KB)
data/ipo/ticker_cik.json
# Derived insider-panel concat (40MB) — regenerated by build_factors_page from the
# committed data/sec_insider/panel/ per-quarter cache; never commit the rebuild.

# LLM digest cache (regenerable; never commit — would ship a stale-floor digest)
data/catalyst/digest_cache/
data/catalyst/stockbrief_cache/

# Event-calendar fetch caches (regenerable; keyless TreasuryDirect + keyed FRED
# release/dates). Date-stamped & ephemeral — never commit.
data/macro/news_cache/
data/macro/auction_cache/
data/macro/release_cache/

# China macro-news build-time flash cache (engine/china_news.py — Eastmoney
# 全球财经快讯). Date-stamped & ephemeral — never commit. (The CCTV 新闻联播
# policy-tone series data/china_news/cctv_tone.parquet IS versioned.)
data/china_news/flash_cache/
# CCTV 新闻联播 raw archive shards (W4 backfill). Projected ≈43MB total — under
# the 150MB commit threshold, but shards are gitignored because the long backfill
# scrape outlives this PR. A single follow-up commit will land all shards once the
# scrape completes. The derived tone history (cctv_tone_history.parquet) IS versioned.
data/china_news/cctv_archive/*.parquet

# News-vector GDELT fetch cache (regenerable, date-stamped). The append-only PIT
# event store data/news_vector/events.parquet is NOT ignored — it must persist &
# accrue forward vintages (like data/prediction_markets/snapshots.parquet).
data/news_vector/fetch_cache/

# Large local-only research/build caches (regenerable; kept out of the deploy repo
# so the daily CI `git add data/` never re-commits & grows them). Not on origin/main.
data/breadth/_closes_deep.parquet
data/breadth/_closes_delisted.parquet
data/breadth/_closes_delisted_1500.parquet
data/breadth/sp500_pit_membership.parquet
data/china_search/closes_deep.parquet
data/sec_insider/insider_panel.parquet
# deep-history close panel for the deep factor IC scorecard (offline backfill via
# scripts.sue_deep_phase0; the small deep ic_scorecard.json IS committed, the 54MB panel is not).
data/edgar/sue_deep_closes.parquet

# Admin dashboard: local-only secrets / GA4 service-account keys (never commit)
admin/.env
admin/secrets/
admin/*service-account*.json
admin/*-sa.json

# dev-only fast-render view-model cache (scripts/render_macro_fast.py)
data/_dev_macro_vm.pkl

# Signal track-record log — un-ignored (w0-stageB #1139): maturation-fill semantics
# make row-level JSONL append-only awkward; parquet append-only is repo practice.
# Size tripwire in scripts/audit_sizes.py guards against runaway growth.
# data/signal_archive/track_record.parquet  <-- intentionally tracked

# Signal track-record audit scratch output (reader writes this; git-ignored)
research/signal_engine/_track_record_audit.md
data/edgar/company_tickers.json

# Special Situations: fetched filing-text cache + LLM summary cache (regenerable)
data/special_situations/doc_cache/
data/special_situations/digest_cache/
# raw digest capture / reverse-engineering evidence (private; digest_db.parquet is the committed artifact)
research/_recon_raw/

# live intraday overlay output (regenerated each intraday run; not a committed artifact)
site/live/

# options-flow transient caches (re-downloadable; keep out of git)
# Options Alpha §A8: data/massive_flat/ and data/massive_flatfiles/ are dead stray dirs; do not write to them.
data/massive_flat/
data/massive_flatfiles/
data/options_flow/_*.parquet
# heavy per-ticker stores — served from Cloudflare R2 (scripts/publish_r2.py), not committed/deployed
site/subsectorohlc/
site/subsectorohlc_china/
site/subsectorohlc_russell/
site/subsectorohlc_nasdaq/

# A/B risk-gate per-day divergence dump (~3MB, 13k+ rows) — the committed summary
# (calibration/ab_risk_gate.json) carries the stats + the event-window replay rows.
calibration/ab_risk_gate_divergence.jsonl

# Expanded HSCI universe deep OHLCV store (R2-only, ~65 MB initial and growing).
# Per-ticker parquets served from Cloudflare R2 via scripts/publish_r2 --dirs hk_stocks_ext.
# Committed files in the same dir (_universe.json, _checkpoint.json) are NOT ignored.
data/hk_stocks_ext/*.parquet

# Massive.com whole-market daily OHLCV derived store (R2-only; Setup-Species §7 W0.6a).
# Per-ticker parquets published via scripts/publish_r2 --dirs massive_stock_day.
# Committed: data/massive_stock_day/_manifest.json (freshness anchor for audit_r2)
#            data/massive_stock_day/_backfill_state.json (resume state)
# ~12,400 tickers × ~350 rows = ~240 MB total — must NOT be committed to git.
data/massive_stock_day/*.parquet
# Options Alpha §A4/A8: raw Massive.com options day-agg cache.
# Local cache + R2-published via publish_r2 --dirs massive_options_day.
# NEVER committed to git; content is re-downloadable from massive.com entitlement.
# See research/OPTIONS_ALPHA_MASTERPLAN.md §3 rulings A4 and A8.
data/massive_options_day/
# ThetaData Phase-A T1 backfill store (rulings A4/A8 + §7.2 of LIVE_ORDER_FLOW_BRAINSTORM).
# ~30–80 GB raw EOD chains + OI + Greeks; published to R2 via publish_r2 --dirs thetadata_eod.
# NEVER committed to git; re-downloadable from ThetaData entitlement.
# Committed (git-tracked): _backfill_state.json (resume state) + _manifest.json (R2 anchor).
data/thetadata_eod/eod/
data/thetadata_eod/oi/
data/thetadata_eod/greeks/
# Negation: keep the committed state + manifest files tracked even though the data subdirs above are excluded
!data/thetadata_eod/_backfill_state.json
!data/thetadata_eod/_manifest.json
# (NOT R2) — not regenerable without re-scraping; critical H2a phase-0 evidence.
# data/hk_shorts/ is intentionally NOT listed here; all files are committed.
# ---- Slice G store decisions (2026-07-03) ------------------------------------
# CIRO short-position panel: data/ciro_short/ is GIT-tracked (not R2).
# ~114 report-dates x ~2,500 TSX rows = ~285k rows = ~14MB -- inside git threshold.
# positions.parquet and coverage.json are intentionally committed so the CSPR
# history (2021-10->) accrues in the repo. data/ciro_short/ is NOT gitignored.
#
# Canada insider -- new append-only store vs legacy blob:
#   data/canada_insider/transactions.parquet -- GIT-tracked (new; accumulates history)
#   data/canada_insider/insider.parquet      -- GIT-tracked (legacy; kept 1 month for
#                                              migration safety, phase out 2026-08-03)
# Both are small (<5MB), non-regenerable, git-tracked. Not gitignored.

# ObsidianBrain vault (own git repo; view over memory/ + research/, lives inside this folder)
ObsidianBrain/

# Oracle rotation panel parquets (O0 — built off-render on Mac, published to R2).
# manifest.json MAY be committed in a later PR once it stabilises; for now it is
# also excluded to avoid stale snapshots in git.
# Mirror pattern: data/massive_stock_day/*.parquet above.
data/oracle/*.parquet
data/oracle/manifest.json
# Oracle graph outputs (O1) — heavy JSON artifacts; published to R2 per D5
data/oracle/graph_s.json
data/oracle/graph_m.json
# Oracle P3 gauntlet outputs — heavy JSON artifacts; results MD is committed, JSON is not
# p3_results.json is NOT committed (regenerate via: python scripts/oracle_gauntlet_p3.py --data-dir <DATA_DIR>)
data/oracle/gauntlet/p3_results.json
# p3_trial_ledger.json IS committed: it is the registration record and must be in git.
# The negation below overrides the gitignore for that specific file only.
data/oracle/gauntlet/p3_trial_ledger.json
!data/oracle/gauntlet/p3_trial_ledger.json
