# pre-built so the path is safe before any data ever lands here.
data/private/

# SLF-001 SEC FTD collector (feat/slf001-sec-ftd-collector-phase0).
# panel.parquet is 184MB / 22.4M rows — R2 data-plane law: must NOT enter git.
# Mirrors pattern: data/massive_stock_day/*.parquet above.
# The store dir (data/sec_ftd/) itself is a real tracked dir; parquets are excluded.
# _manifest.json (freshness anchor, if created) is kept via negation.
data/sec_ftd/*.parquet

# chain-heat smoke output (--no-publish writes to CWD = repo root; must not enter git).
# Documented smoke command in ops/launchd/com.macro.chainheat.plist and module docstring.
chain_heat_current.json
!data/sec_ftd/_manifest.json

# W5-B Options Tape Signed Pilot (feat/w5b-options-tape-pilot).
# Per-ticker parquets are R2-plane only (projected 10-50 GB at 500 names x full backfill).
# Mirrors pattern: data/massive_stock_day/*.parquet above.
# _backfill_state.json is NOT git-tracked (it lives under data/ which is gitignored).
# On a fresh checkout the state file is absent; the build detects this and starts from scratch,
# pulling the full date range for any underlyings not yet in completed_dates.
# The *.parquet ignore already permits the JSON (only *.parquet is blocked), so
# git-adding the state file is possible if persistence across checkouts is needed;
# currently it is not added — nightly CI always runs on the host machine, not a fresh checkout.
data/options_tape_signed/*.parquet

