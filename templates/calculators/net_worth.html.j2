{#=============================================================================
  calculators/net_worth.html.j2 — Net Worth Calculator
  Clones the flagship position_size.html.j2 structure exactly (CONTRACT §6 DOM +
  §7-style pure compute/self-check, §8 explainer + copy laws). Net worth =
  total assets − total liabilities; every input optional, sum what's filled.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('net-worth', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Add up what you own, subtract what you owe, and the difference is your net worth. Fill in only the lines that apply — blanks count as zero.',
   '把你拥有的加起来，减去你欠下的，两者之差就是你的净资产。只需填写适用的项目——留空即计为零。') }}</p>

<div class="calc-in">
  <label class="ci ci-wide"><span class="ci-l">{{ t('Assets — what you own', '资产——你拥有的') }} <span class="hint">{{ t('all optional', '均可选') }}</span></span></label>
  <label class="ci"><span class="ci-l">{{ t('Cash & savings ($)', '现金与存款（$）') }}</span>
    <input id="cash" inputmode="decimal" autocomplete="off" placeholder="25,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Investments ($)', '投资（$）') }} <span class="hint">{{ t('brokerage, stocks', '证券、股票') }}</span></span>
    <input id="invest" inputmode="decimal" autocomplete="off" placeholder="80,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Retirement accounts ($)', '退休账户（$）') }}</span>
    <input id="retire" inputmode="decimal" autocomplete="off" placeholder="120,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Real estate ($)', '房地产（$）') }} <span class="hint">{{ t('market value', '市值') }}</span></span>
    <input id="realestate" inputmode="decimal" autocomplete="off" placeholder="450,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Vehicles ($)', '车辆（$）') }}</span>
    <input id="vehicles" inputmode="decimal" autocomplete="off" placeholder="20,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Other assets ($)', '其他资产（$）') }}</span>
    <input id="otherassets" inputmode="decimal" autocomplete="off" placeholder="5,000"></label>

  <label class="ci ci-wide"><span class="ci-l">{{ t('Liabilities — what you owe', '负债——你欠下的') }} <span class="hint">{{ t('all optional', '均可选') }}</span></span></label>
  <label class="ci"><span class="ci-l">{{ t('Mortgage ($)', '房贷（$）') }} <span class="hint">{{ t('balance owed', '剩余本金') }}</span></span>
    <input id="mortgage" inputmode="decimal" autocomplete="off" placeholder="320,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Student & other loans ($)', '学生贷款及其他（$）') }}</span>
    <input id="loans" inputmode="decimal" autocomplete="off" placeholder="30,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Credit card debt ($)', '信用卡欠款（$）') }}</span>
    <input id="creditcard" inputmode="decimal" autocomplete="off" placeholder="6,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Other debts ($)', '其他债务（$）') }}</span>
    <input id="otherdebts" inputmode="decimal" autocomplete="off" placeholder="4,000"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('net worth', '净资产') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in any of the lines above to see your net worth.', '填入上方任意项目即可查看净资产。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Total assets', '总资产') }}</dt><dd id="out-assets">—</dd></div>
    <div><dt>{{ t('Total liabilities', '总负债') }}</dt><dd id="out-liab">—</dd></div>
    <div><dt>{{ t('Debt-to-asset ratio', '资产负债率') }}</dt><dd id="out-dta">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('Your net worth is everything you <strong>own</strong> minus everything you <strong>owe</strong>. Add up your assets — cash, investments, retirement, property, vehicles — then subtract your liabilities — mortgage, loans, card balances. The number that remains is a single snapshot of your financial standing on this day. It can be positive, zero, or negative, and the sign matters less than the direction it moves over time.',
   '你的净资产，就是你所<strong>拥有</strong>的一切，减去你所<strong>欠下</strong>的一切。把资产加起来——现金、投资、退休金、房产、车辆——再减去负债——房贷、贷款、信用卡余额。剩下的数字，是你今天财务状况的一张快照。它可以为正、为零，或为负；相比正负号，它随时间移动的方向更重要。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Total assets</strong> = sum of everything you own', '<strong>总资产</strong> = 你拥有的一切之和') }}<br>
{{ t('<strong>Total liabilities</strong> = sum of everything you owe', '<strong>总负债</strong> = 你欠下的一切之和') }}<br>
{{ t('<strong>Net worth</strong> = Total assets − Total liabilities', '<strong>净资产</strong> = 总资产 − 总负债') }}<br>
{{ t('Debt-to-asset ratio = 100 × Total liabilities ÷ Total assets', '资产负债率 = 100 × 总负债 ÷ 总资产') }}
</div>
<p>{{ t('The debt-to-asset ratio is the share of your assets that is financed by debt. At 0% you owe nothing against what you own; at 100% your debts equal your assets and your net worth is zero; above 100% you owe more than you own, so net worth is negative. It is the same picture as net worth, expressed as a ratio that is easy to compare across very different balance sheets.',
   '资产负债率，是你的资产中由债务支撑的那一部分占比。为 0% 时，你对所拥有的东西毫无欠款；为 100% 时，债务恰好等于资产，净资产为零；超过 100% 时，你欠的比拥有的还多，净资产因此为负。它与净资产是同一幅图景，只是用一个便于在差异极大的资产负债表间比较的比率来表达。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a household owns <span class="num">$300,000</span> in total assets — a home, a brokerage account, some cash — and owes <span class="num">$180,000</span> in total, mostly a mortgage.',
   '假设一个家庭拥有总资产 <span class="num">$300,000</span>——一套住房、一个证券账户、一些现金——总共欠款 <span class="num">$180,000</span>，其中大部分是房贷。') }}</p>
<ul>
<li>{{ t('Net worth = <span class="num">300,000 − 180,000 = $120,000</span>', '净资产 = <span class="num">300,000 − 180,000 = $120,000</span>') }}</li>
<li>{{ t('Debt-to-asset ratio = <span class="num">100 × 180,000 ÷ 300,000 = 60%</span>', '资产负债率 = <span class="num">100 × 180,000 ÷ 300,000 = 60%</span>') }}</li>
<li>{{ t('So <span class="num">60%</span> of what the household owns is financed by debt, leaving <span class="num">$120,000</span> of genuinely owned value.',
   '因此，家庭所拥有的东西中有 <span class="num">60%</span> 由债务支撑，剩下 <span class="num">$120,000</span> 是真正属于自己的净值。') }}</li>
</ul>
</div>
<p>{{ t('A positive net worth is not the whole story. A household with $120,000 net worth and a 60% debt ratio is more exposed than one with the same net worth and a 20% ratio — the first carries far more debt against its assets, and is more sensitive to falling asset prices or rising rates.',
   '正的净资产并非全部。一个净资产 $120,000、负债率 60% 的家庭，比另一个同样净资产但负债率 20% 的家庭承担更大风险——前者的资产背负着多得多的债务，对资产价格下跌或利率上升也更为敏感。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Counting the asset, forgetting the loan', '只算资产，忘了贷款') }}</span>
<p>{{ t('The most common mistake is entering a home or car at its full market value while leaving out the loan against it. A $450,000 house with a $320,000 mortgage adds only $130,000 to your net worth, not $450,000. Always pair each financed asset with its outstanding balance: enter the property in the assets column and the mortgage in the liabilities column so the two net correctly.',
   '最常见的错误，是按全额市值填入房产或车辆，却漏掉了针对它的贷款。一套 $450,000 的住房若还欠 $320,000 房贷，实际只为你的净资产增加 $130,000，而非 $450,000。务必把每一项有贷款的资产与其未偿余额配对：在资产栏填入房产，在负债栏填入房贷，两者才能正确相抵。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('Net worth is a clean snapshot, but a snapshot leaves things out. A few honest limits:',
   '净资产是一张干净的快照，但快照总有遗漏之处。几点诚实的局限：') }}</p>
<ul>
<li>{{ t('<strong>Values are estimates.</strong> Homes, private businesses and cars are worth what they sell for, not what you type in. Use conservative market values, and remember a sale may bring costs — commissions, taxes — that shrink the real figure.',
   '<strong>估值只是估计。</strong>房产、私人企业和车辆值多少，取决于它们能卖出的价格，而非你填入的数字。请采用保守的市值，并记住出售可能产生成本——佣金、税费——从而缩水真实数字。') }}</li>
<li>{{ t('<strong>Liquidity is invisible here.</strong> Two people with identical net worth can be worlds apart if one holds mostly cash and the other mostly a house that takes months to sell. Net worth does not tell you what you could spend tomorrow.',
   '<strong>流动性在这里看不见。</strong>两个净资产相同的人可能天差地别——若一人主要持有现金，另一人主要持有一套要数月才能卖出的房子。净资产不会告诉你明天能动用多少。') }}</li>
<li>{{ t('<strong>It is a moment, not a trend.</strong> One reading means little. The value comes from tracking the same calculation over months and years, so the direction — rising, flat, or falling — becomes visible.',
   '<strong>它是一个瞬间，而非一段趋势。</strong>单次读数意义有限。真正的价值来自于在数月乃至数年间持续用同一方法计算，从而让方向——上升、持平或下降——变得清晰可见。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('Net worth is what you own minus what you owe. Track the same number over time — the trend tells you more than any single reading.',
   '净资产就是所拥有的减去所欠下的。持续追踪同一个数字——趋势比任何单次读数都更能说明问题。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('See what a growing balance can become with the <a href="' ~ rel ~ 'tools/calculators/compounding.html">compound growth calculator</a>, or measure a portfolio’s annual growth with the <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR calculator</a>.',
   '用 <a href="' ~ rel ~ 'tools/calculators/compounding.html">复利增长计算器</a>看看不断增长的余额能变成什么，或用 <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR 计算器</a>衡量投资组合的年化增长。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (net worth = assets − liabilities) ────────────────────────
  // inputs: {assets:[...], liabs:[...]} — arrays of numbers (NaN for blank).
  // Returns an outputs object, or {ok:false, msg} when nothing is filled in.
  // Blank/invalid lines count as zero; never returns NaN/Infinity.
  function compute(inp){
    function sum(arr, any){
      var t=0;
      for(var i=0;i<arr.length;i++){
        var v=arr[i];
        if(isFinite(v)){ t+=v; any.filled=true; }
      }
      return t;
    }
    var any={filled:false};
    var totalAssets = sum(inp.assets, any);
    var totalLiabilities = sum(inp.liabs, any);
    if(!any.filled) return {ok:false, msg:"Fill in any of the lines above to see your net worth."};
    var netWorth = totalAssets - totalLiabilities;
    var dta = totalAssets > 0 ? (100 * totalLiabilities / totalAssets) : null; // null = no assets to ratio against
    return {
      ok:true,
      totalAssets: totalAssets,
      totalLiabilities: totalLiabilities,
      netWorth: netWorth,
      dta: dta,
      negative: netWorth < 0
    };
  }

  // ── §6 self-check: run the canonical fixtures on load, console.error on drift ─
  var WORKED_EXAMPLES = [
    { in:{assets:[300000], liabs:[180000]}, want:{netWorth:120000, totalAssets:300000, totalLiabilities:180000, dta:60} },
    { in:{assets:[25000,80000,120000,450000,20000,5000], liabs:[320000,30000,6000,4000]},
      want:{netWorth:340000, totalAssets:700000, totalLiabilities:360000} },
    { in:{assets:[40000], liabs:[55000]}, want:{netWorth:-15000, totalAssets:40000, totalLiabilities:55000, dta:137.5} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, k;
      if(!got.ok){ console.error("net-worth self-check "+i+": compute failed", got); return; }
      for(k in w){ if(Math.abs(got[k] - w[k]) > 0.01){
        console.error("net-worth self-check "+i+" mismatch on "+k+": got "+got[k]+" want "+w[k]); } }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var ASSET_IDS = ["cash","invest","retire","realestate","vehicles","otherassets"];
    var LIAB_IDS  = ["mortgage","loans","creditcard","otherdebts"];
    var els = {};
    ASSET_IDS.concat(LIAB_IDS).forEach(function(id){ els[id]=$(id); });
    var outMain=$("out-main"), outPlain=$("out-plain"),
        outAssets=$("out-assets"), outLiab=$("out-liab"), outDta=$("out-dta"),
        copyBtn=$("copy-result"), copied=$("copied");

    function numFrom(el){ var v=parseFloat((el.value||"").replace(/,/g,"").trim()); return isFinite(v)?v:NaN; }
    function money(n){
      var neg = n < 0, a = Math.abs(n);
      return (neg?"−$":"$") + a.toLocaleString("en-US",{minimumFractionDigits:0,maximumFractionDigits:0});
    }
    function dash(){
      outMain.textContent="—"; outMain.className="";
      [outAssets,outLiab,outDta].forEach(function(e){e.textContent="—"; e.className="";});
    }

    var last=null;
    function render(){
      var inp={
        assets: ASSET_IDS.map(function(id){ return numFrom(els[id]); }),
        liabs:  LIAB_IDS.map(function(id){ return numFrom(els[id]); })
      };
      var res=compute(inp); last=res;
      if(!res.ok){ dash(); outPlain.textContent=res.msg; outPlain.className="co-plain"; return; }
      outMain.textContent = money(res.netWorth);
      outAssets.textContent = money(res.totalAssets);
      outLiab.textContent = money(res.totalLiabilities);
      outDta.textContent = res.dta===null ? "—" : res.dta.toFixed(res.dta<10?1:(res.dta % 1 === 0 ? 0 : 1)) + "%";
      // Law 3: plain-word interpretation under the number
      var plain;
      if(res.negative){
        outMain.className="neg"; outDta.className="neg";
        plain = "You owe " + money(-res.netWorth) + " more than you own. Chipping away at the highest-cost debt is what moves this toward zero and then positive.";
        outPlain.className="co-plain warn";
      } else {
        outMain.className=""; outDta.className="";
        var dtaTxt = res.dta===null
          ? "with no assets recorded yet"
          : res.dta.toFixed(res.dta<10?1:(res.dta % 1 === 0 ? 0 : 1)) + "% of your assets is financed by debt";
        plain = "You own " + money(res.netWorth) + " more than you owe — " + dtaTxt + ".";
        outPlain.className="co-plain";
      }
      outPlain.textContent = plain;
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      var dta = last.dta===null ? "n/a" : (last.dta.toFixed(last.dta % 1 === 0 ? 0 : 1) + "%");
      return "Net worth: " + money(last.netWorth) +
        " · assets " + money(last.totalAssets) +
        " · liabilities " + money(last.totalLiabilities) +
        " · debt-to-asset " + dta + " — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    ASSET_IDS.concat(LIAB_IDS).forEach(function(id){
      els[id].addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
