{#=============================================================================
  calculators/sharpe_ratio.html.j2 — Sharpe Ratio Calculator
  Clones the position_size.html.j2 flagship structure EXACTLY. Implements the
  Sharpe formula from the brief: sharpe = (Rp − Rf)/σ (require σ>0); if an
  annualize-from-k factor is given, annualizedSharpe = sharpe·√k. Explainer
  body follows §8 structure: direct answer → formula → worked example → common
  trap → where it breaks → links. compute() is PURE; wire() does all DOM I/O;
  WORKED_EXAMPLES self-checks on load (console.error on drift, silent green).
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('sharpe-ratio', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter a portfolio’s return, the risk-free rate, and the volatility (standard deviation) of its returns. You get the Sharpe ratio — the excess return earned per unit of risk taken.',
   '填入组合的收益率、无风险利率，以及收益的波动率（标准差），即可得到夏普比率——每承担一单位风险所换来的超额收益。') }}</p>

<div class="calc-in">
  <label class="ci"><span class="ci-l">{{ t('Portfolio return Rp (%)', '组合收益率 Rp（%）') }}</span>
    <input id="rp" inputmode="decimal" autocomplete="off" placeholder="12"></label>
  <label class="ci"><span class="ci-l">{{ t('Risk-free rate Rf (%)', '无风险利率 Rf（%）') }} <span class="hint">{{ t('T-bill / cash', '国债 / 现金') }}</span></span>
    <input id="rf" inputmode="decimal" autocomplete="off" placeholder="3"></label>
  <label class="ci"><span class="ci-l">{{ t('Std deviation σ (%)', '标准差 σ（%）') }} <span class="hint">{{ t('of returns', '收益的') }}</span></span>
    <input id="sd" inputmode="decimal" autocomplete="off" placeholder="15"></label>
  <label class="ci"><span class="ci-l">{{ t('Annualize from periods/yr', '按每年周期数年化') }} <span class="hint">{{ t('optional — 12 / 252', '可选——12 / 252') }}</span></span>
    <input id="k" inputmode="decimal" autocomplete="off" placeholder="—"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('Sharpe', '夏普') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in return, risk-free rate and σ to see the Sharpe ratio.', '填入收益率、无风险利率与 σ 即可得到夏普比率。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Excess return', '超额收益') }}</dt><dd id="out-excess">—</dd></div>
    <div><dt>{{ t('Per unit of risk', '每单位风险') }}</dt><dd id="out-perrisk">—</dd></div>
    <div><dt>{{ t('Annualized Sharpe', '年化夏普') }}</dt><dd id="out-annual">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('The Sharpe ratio is your <strong>excess return</strong> divided by its <strong>volatility</strong>. Excess return is what the portfolio earned <em>above</em> a risk-free rate — the return you could have had for taking no risk at all; volatility is the standard deviation of those returns. Dividing one by the other answers a single question: how much return did each unit of risk actually buy?',
   '夏普比率就是<strong>超额收益</strong>除以其<strong>波动率</strong>。超额收益是组合在无风险利率<em>之上</em>多赚的部分——无风险利率是你不承担任何风险也能拿到的回报；波动率则是这些收益的标准差。两者相除回答的是同一个问题：每一单位风险，究竟换来了多少收益？') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Excess return</strong> = Rp − Rf', '<strong>超额收益</strong> = Rp − Rf') }}<br>
{{ t('<strong>Sharpe</strong> = ( Rp − Rf ) ÷ σ', '<strong>夏普</strong> = ( Rp − Rf ) ÷ σ') }}<br>
{{ t('<strong>Annualized</strong> = Sharpe × √k', '<strong>年化</strong> = 夏普 × √k') }}<span class="mut"> {{ t('(k = periods per year: 12 monthly, 252 daily)', '（k = 每年周期数：月度 12、日度 252）') }}</span>
</div>
<p>{{ t('The ratio is unit-free: a Sharpe of 0.60 means the portfolio earned 0.60 units of excess return for every unit of volatility. The optional √k step rescales a ratio measured over short periods — monthly or daily returns — up to an annual figure so it can be compared with others quoted per year. σ must be greater than zero; a portfolio with no variation in its returns has no risk to divide by.',
   '该比率没有单位：夏普为 0.60，意味着每一单位波动率带来 0.60 单位的超额收益。可选的 √k 步骤，把按短周期（月度或日度）测得的比率放大到年度口径，以便与他人按年报出的数字比较。σ 必须大于零；收益毫无波动的组合，没有可供相除的风险。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a portfolio returned <span class="num">12%</span> over a year while cash (the risk-free rate) paid <span class="num">3%</span>. The standard deviation of its returns was <span class="num">15%</span>.',
   '假设某组合一年收益 <span class="num">12%</span>，同期现金（无风险利率）为 <span class="num">3%</span>，其收益的标准差为 <span class="num">15%</span>。') }}</p>
<ul>
<li>{{ t('Excess return = <span class="num">12 − 3 = 9%</span>', '超额收益 = <span class="num">12 − 3 = 9%</span>') }}</li>
<li>{{ t('Sharpe = <span class="num">9 ÷ 15 = 0.60</span>', '夏普 = <span class="num">9 ÷ 15 = 0.60</span>') }}</li>
</ul>
</div>
<p>{{ t('A Sharpe of 0.60 says the portfolio was paid 0.60 units of excess return for each unit of risk it carried. A second portfolio that also returned 12% but swung twice as hard — σ of 30% — would score just 0.30. Same headline return, half the risk-adjusted quality. That is the whole point: the Sharpe ratio refuses to reward a return that was bought with outsized volatility.',
   '夏普 0.60 表示：组合每承担一单位风险，就获得 0.60 单位的超额收益。另一个同样收益 12%、但波动大一倍——σ 为 30%——的组合，只能得 0.30。名义收益相同，风险调整后的质量却减半。这正是关键所在：夏普比率不会奖励一份靠过大波动换来的收益。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Comparing ratios measured over different periods', '比较不同周期口径的比率') }}</span>
<p>{{ t('A Sharpe ratio computed from monthly returns is not comparable to one computed from annual returns — the monthly figure is roughly √12 smaller. Before you rank two funds by Sharpe, make sure both are on the same clock. That is what the annualize step is for: convert the short-period ratio up by √k so like sits next to like. Quoting a raw monthly Sharpe as if it were annual quietly flatters or punishes the number by a factor of more than three.',
   '用月度收益算出的夏普比率，与用年度收益算出的并不可比——月度数字大约要小 √12 倍。在按夏普给两只基金排名之前，先确认两者用的是同一把尺子。年化步骤正是为此而设：把短周期比率乘以 √k 放大，让同类与同类相比。把原始月度夏普当作年度口径引用，会悄悄地把这个数字美化或贬低三倍以上。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('The Sharpe ratio is a convention, not a law — a useful summary with real blind spots. As a rough reading: below 1 is often called subpar, 1 to 2 good, above 2 very good — but those bands are habit, not truth, and they shift with the market regime and the measurement window. A few honest limits:',
   '夏普比率是一种惯例，而非定律——它是有用的概括，却有实实在在的盲点。作为粗略参照：低于 1 常被称为一般，1 到 2 为良好，2 以上为优秀——但这些区间是习惯，不是真理，会随市场环境与测量窗口而变。几点诚实的局限：') }}</p>
<ul>
<li>{{ t('<strong>It penalizes upside volatility.</strong> Standard deviation counts a big up-month as “risk” exactly like a big down-month. A portfolio that mostly surprises to the upside is scored as if those surprises were dangerous. The Sortino ratio, which divides by downside deviation only, was built to address this.',
   '<strong>它惩罚向上的波动。</strong>标准差把一个大涨月与一个大跌月同样算作「风险」。一个多为向上惊喜的组合，会被当作那些惊喜很危险来打分。索提诺比率——只用下行标准差相除——正是为解决这一点而生。') }}</li>
<li>{{ t('<strong>It assumes returns are roughly normal.</strong> Real returns have fat tails and skew; strategies that sell options or carry hidden crash risk can post a lovely Sharpe for years and then give it all back in a week. A high ratio built on a short, calm sample can be a mirage.',
   '<strong>它假设收益大致服从正态分布。</strong>真实收益有肥尾与偏度；卖出期权、或暗藏崩盘风险的策略，可能连续多年报出漂亮的夏普，然后在一周内悉数吐回。建立在短暂平静样本上的高比率，可能只是海市蜃楼。') }}</li>
<li>{{ t('<strong>The risk-free rate and window are choices.</strong> Which cash rate you subtract, and how long a window you measure, both move the number. Two honest analysts can compute different Sharpe ratios for the same fund. Treat it as one lens among several, not a verdict.',
   '<strong>无风险利率与窗口都是选择。</strong>你减去哪个现金利率、测量多长的窗口，都会改变结果。两位诚实的分析师，可能为同一只基金算出不同的夏普比率。把它当作众多视角之一，而非最终定论。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('A high return means little until you know what volatility it cost. The Sharpe ratio prices that trade-off — but read it beside the shape of the returns, not on its own.',
   '在你知道一份收益付出了多少波动之前，高收益本身意义有限。夏普比率为这一取舍定价——但要把它与收益的分布形态放在一起读，而非孤立地看。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('Turn a raw gain into an annual rate with the <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR calculator</a>, or size a single trade by risk with the <a href="' ~ rel ~ 'tools/calculators/position-size.html">position size calculator</a>.',
   '用 <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR 计算器</a> 把原始收益换算成年化利率，或用 <a href="' ~ rel ~ 'tools/calculators/position-size.html">仓位计算器</a> 按风险为单笔交易定仓。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (brief formula — do not re-derive) ────────────────────────
  // inputs: {Rp return%, Rf risk-free%, sd stddev%, k periods/yr (optional)}.
  // Returns an outputs object, or {ok:false, msg} for invalid input. Never NaN.
  function compute(inp){
    var Rp=inp.Rp, Rf=inp.Rf, sd=inp.sd, k=inp.k;
    if(!isFinite(Rp)) return {ok:false, msg:"Enter the portfolio's return."};
    if(!isFinite(Rf)) return {ok:false, msg:"Enter the risk-free rate."};
    if(!isFinite(sd)) return {ok:false, msg:"Enter the standard deviation of returns."};
    if(!(sd>0)) return {ok:false, msg:"Standard deviation must be above zero — with no volatility there is no risk to divide by."};
    var excess = Rp - Rf;
    var sharpe = excess / sd;
    var hasK = isFinite(k) && k>0;
    var annualized = hasK ? sharpe * Math.sqrt(k) : null;
    return {
      ok:true, excess:excess, sharpe:sharpe,
      hasK:hasK, k:hasK?k:null, annualized:annualized
    };
  }

  // interpretation band (convention, not law — mirrors the explainer)
  function band(s){
    if(s < 0)   return "negative — the portfolio trailed cash after adjusting for risk";
    if(s < 1)   return "below 1 — commonly read as subpar";
    if(s <= 2)  return "between 1 and 2 — commonly read as good";
    return "above 2 — commonly read as very good";
  }

  // ── §6 self-check: run the canonical fixtures on load, console.error on drift ─
  var WORKED_EXAMPLES = [
    { in:{Rp:12, Rf:3, sd:15},        want:{sharpe:0.60, excess:9} },
    { in:{Rp:8,  Rf:2, sd:12, k:12},  want:{sharpe:0.50, annualized:1.7320508} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, key;
      if(!got.ok){ console.error("sharpe-ratio self-check "+i+": compute failed", got); return; }
      for(key in w){ if(Math.abs(got[key] - w[key]) > 0.001){
        console.error("sharpe-ratio self-check "+i+" mismatch on "+key+": got "+got[key]+" want "+w[key]); } }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var els = { rp:$("rp"), rf:$("rf"), sd:$("sd"), k:$("k") };
    var outMain=$("out-main"), outPlain=$("out-plain"),
        outExcess=$("out-excess"), outPer=$("out-perrisk"), outAnnual=$("out-annual"),
        copyBtn=$("copy-result"), copied=$("copied");

    function numFrom(el){ var raw=(el.value||"").replace(/,/g,"").trim();
      if(raw==="") return NaN; var v=parseFloat(raw); return isFinite(v)?v:NaN; }
    function ratio(n){ return n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function pct(n){ return (n>=0?"+":"") + n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}) + "%"; }
    function dash(){ outMain.textContent="—";
      [outExcess,outPer,outAnnual].forEach(function(e){e.textContent="—"; e.className="";}); }

    var last=null;
    function render(){
      var inp={ Rp:numFrom(els.rp), Rf:numFrom(els.rf), sd:numFrom(els.sd), k:numFrom(els.k) };
      var res=compute(inp); last=res;
      if(!res.ok){ dash(); outPlain.textContent=res.msg; outPlain.className="co-plain"; return; }
      outMain.textContent = ratio(res.sharpe);
      outExcess.textContent = pct(res.excess);
      outExcess.className = res.excess>=0 ? "pos" : "neg";
      outPer.textContent = ratio(res.sharpe);
      outAnnual.textContent = res.hasK ? ratio(res.annualized) : "—";
      // Law 3: plain-word interpretation under the number
      var plain = "Each unit of risk earned " + ratio(res.sharpe) +
        " units of excess return — " + band(res.sharpe) + ".";
      if(res.hasK){
        plain += " Annualized from " + res.k.toLocaleString("en-US") +
          " periods a year, the Sharpe is " + ratio(res.annualized) + ".";
      }
      plain += " Bands are convention, not a rule.";
      outPlain.textContent = plain;
      outPlain.className="co-plain";
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      var s = "Sharpe ratio: " + ratio(last.sharpe) +
        " · excess return " + pct(last.excess);
      if(last.hasK) s += " · annualized " + ratio(last.annualized) + " (" + last.k + "/yr)";
      return s + " — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    ["rp","rf","sd","k"].forEach(function(id){
      els[id].addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
