{#=============================================================================
  calculators/margin.html.j2 — Margin & Buying Power Calculator
  Clone of the position_size.html.j2 flagship: identical page structure; only
  the form fields, compute()/render()/copyLine() + WORKED_EXAMPLES, and the
  explainer prose differ. Reg-T style margin math (CONTRACT §7-family style).

  compute() is PURE (no DOM); wire() does all DOM reads/writes; WORKED_EXAMPLES
  runs each fixture through compute() on load and console.error's any mismatch
  (silent when green). Never render NaN/Infinity; empty/invalid → a plain-word
  sentence in .co-plain and "—" in the number. Inputs accept commas.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('margin', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter your account equity and the margin requirements. You get the buying power that equity unlocks, your leverage, how many shares you could hold at a given price, and the price that would trigger a margin call on a fully-margined long.',
   '填入你的账户净值与保证金要求，即可得到——该净值所释放的购买力、杠杆倍数、在给定价格下可持有的股数，以及在满仓做多时触发追加保证金通知的价格。') }}</p>

<div class="calc-in">
  <label class="ci"><span class="ci-l">{{ t('Account equity ($)', '账户净值（$）') }}</span>
    <input id="equity" inputmode="decimal" autocomplete="off" placeholder="10,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Initial margin (%)', '初始保证金（%）') }} <span class="hint">{{ t('Reg-T is 50', 'Reg-T 为 50') }}</span></span>
    <input id="initial" inputmode="decimal" autocomplete="off" placeholder="50"></label>
  <label class="ci"><span class="ci-l">{{ t('Maintenance margin (%)', '维持保证金（%）') }} <span class="hint">{{ t('typically 25', '通常 25') }}</span></span>
    <input id="maint" inputmode="decimal" autocomplete="off" placeholder="25"></label>
  <label class="ci"><span class="ci-l">{{ t('Entry price ($)', '入场价（$）') }} <span class="hint">{{ t('for share count', '用于算股数') }}</span></span>
    <input id="price" inputmode="decimal" autocomplete="off" placeholder="50"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('buying power', '购买力') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in equity and the margin requirements to see your buying power.', '填入净值与保证金要求即可查看购买力。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Leverage', '杠杆') }}</dt><dd id="out-lev">—</dd></div>
    <div><dt>{{ t('Max shares at entry', '入场价可持股数') }}</dt><dd id="out-shares">—</dd></div>
    <div><dt>{{ t('Position value', '仓位价值') }}</dt><dd id="out-pos">—</dd></div>
    <div><dt>{{ t('Margin-call price', '追缴价格') }}</dt><dd id="out-call">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('Your <strong>buying power</strong> is your account equity divided by the initial margin requirement — at Reg-T’s 50%, $10,000 of equity controls $20,000 of stock, or <strong>2:1 leverage</strong>. That extra reach cuts both ways: the same move that doubles your gain also doubles your loss, and a big enough loss triggers a <strong>margin call</strong> that can force you to sell at exactly the wrong moment.',
   '你的<strong>购买力</strong>等于账户净值除以初始保证金要求——在 Reg-T 的 50% 下，$10,000 净值可操控 $20,000 的股票，即 <strong>2:1 杠杆</strong>。这份额外的操控力是双刃剑：让收益翻倍的那个波动，也会让亏损翻倍；而足够大的亏损会触发<strong>追加保证金通知</strong>，可能迫使你在最糟的时刻卖出。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Buying power</strong> = Equity ÷ (Initial margin% ÷ 100)', '<strong>购买力</strong> = 净值 ÷ (初始保证金% ÷ 100)') }}<br>
{{ t('<strong>Leverage</strong> = 100 ÷ Initial margin%', '<strong>杠杆</strong> = 100 ÷ 初始保证金%') }}<br>
{{ t('<strong>Max shares</strong> = floor( Buying power ÷ Entry )', '<strong>可持股数</strong> = 向下取整( 购买力 ÷ 入场价 )') }}<br>
{{ t('<strong>Margin-call price</strong> = Entry × (1 − Init% ÷ 100) ÷ (1 − Maint% ÷ 100)', '<strong>追缴价格</strong> = 入场价 × (1 − 初始% ÷ 100) ÷ (1 − 维持% ÷ 100)') }}
</div>
<p>{{ t('The call-price formula assumes a fully-margined long — you borrowed the maximum the initial requirement allows, so your starting equity is exactly the initial margin on the position. As the price falls, your equity falls faster than the position value; the call fires the moment equity drops to the maintenance requirement.',
   '追缴价格公式假设满仓做多——你借入了初始保证金允许的上限，因此起始净值恰好等于该仓位的初始保证金。价格下跌时，你的净值下跌得比仓位价值更快；当净值降至维持保证金水平的那一刻，追缴便触发。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a trader has <span class="num">$10,000</span> of equity, a <span class="num">50%</span> initial requirement and a <span class="num">25%</span> maintenance requirement, and buys at <span class="num">$50.00</span>.',
   '假设一位交易者有 <span class="num">$10,000</span> 净值、<span class="num">50%</span> 初始保证金要求、<span class="num">25%</span> 维持保证金要求，并在 <span class="num">$50.00</span> 入场。') }}</p>
<ul>
<li>{{ t('Buying power = <span class="num">10,000 ÷ 0.50 = $20,000</span>', '购买力 = <span class="num">10,000 ÷ 0.50 = $20,000</span>') }}</li>
<li>{{ t('Leverage = <span class="num">100 ÷ 50 = 2:1</span>', '杠杆 = <span class="num">100 ÷ 50 = 2:1</span>') }}</li>
<li>{{ t('Max shares = <span class="num">floor(20,000 ÷ 50) = 400</span>', '可持股数 = <span class="num">向下取整(20,000 ÷ 50) = 400</span>') }}</li>
<li>{{ t('Margin-call price = <span class="num">50 × 0.50 ÷ 0.75 = $33.33</span> — a 33% drop wipes out the maintenance cushion.',
   '追缴价格 = <span class="num">50 × 0.50 ÷ 0.75 = $33.33</span>——约 33% 的跌幅即耗尽维持保证金的缓冲。') }}</li>
</ul>
</div>
<p>{{ t('Notice the call comes long before the position is worthless: the stock only has to fall a third for the borrowed money to eat through the cushion. Without the loan, that same $50 stock at $33.33 would just be a paper loss you could wait out.',
   '注意追缴远在仓位归零之前就会到来：股价只需下跌三分之一，借来的钱便会吃穿缓冲。若没有借款，同一只 $50 的股票跌到 $33.33 只是一笔可以慢慢等待的账面浮亏。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Treating buying power as free money', '把购买力当成免费的钱') }}</span>
<p>{{ t('Seeing $20,000 of buying power on $10,000 of equity tempts many traders to fill it — but every borrowed dollar carries interest and shrinks the distance to a margin call. Using the full 2:1 means a 25% drop in the stock can cut your equity in half and force a sale near the lows. Leverage is a tool for conviction, not a default setting; holding cash in reserve is what lets you survive the drop and add, rather than being forced out at it.',
   '在 $10,000 净值上看到 $20,000 购买力，会诱使许多交易者把它填满——但每一块借来的钱都要付利息，并缩短到追缴的距离。用满 2:1 意味着股价下跌 25% 就可能让净值腰斩，并在低点附近被迫卖出。杠杆是用于高把握时刻的工具，而非默认设置；留有现金储备，才能让你熬过下跌并加仓，而不是在低点被强平出局。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('This math gives a clean Reg-T snapshot for a single long. Real accounts carry frictions it does not model. A few honest limits:',
   '这套算法为单笔做多给出干净的 Reg-T 快照，但真实账户还有它未纳入模型的种种摩擦。几点诚实的局限：') }}</p>
<ul>
<li>{{ t('<strong>Broker house rules.</strong> Brokers may set maintenance requirements well above the 25% regulatory floor — often 30–40%, higher still for volatile or concentrated names. Your real call price can be closer than this tool shows.',
   '<strong>券商自定规则。</strong>券商可将维持保证金要求设得远高于 25% 的监管下限——通常 30–40%，对波动大或高度集中的标的更高。你真实的追缴价格可能比本工具显示的更近。') }}</li>
<li>{{ t('<strong>Margin interest and pattern-day rules.</strong> Borrowed cash accrues interest daily, and accounts under $25,000 face pattern-day-trading limits. Neither shows up in the buying-power number.',
   '<strong>保证金利息与日内交易规则。</strong>借入的现金按日计息，且低于 $25,000 的账户还受日内交易（PDT）限制。这两者都不会体现在购买力数字里。') }}</li>
<li>{{ t('<strong>Gaps beat the call price.</strong> A margin call assumes the price passes smoothly through the trigger. An overnight gap can open below it, so the forced liquidation fills lower than the call price and the loss runs deeper than the math suggests.',
   '<strong>跳空会击穿追缴价。</strong>追缴计算假设价格平滑地穿过触发点。而隔夜跳空可能直接低开于该价位之下，强制平仓的成交价因此低于追缴价，亏损也比公式所示更深。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('Buying power is borrowed reach, not extra capital — leverage multiplies the loss and the loss is what brings the call.',
   '购买力是借来的操控范围，而非额外的资本——杠杆会放大亏损，而正是亏损引来追缴。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('Size a leveraged trade off risk with the <a href="' ~ rel ~ 'tools/calculators/position-size.html">position size calculator</a>, or go deeper in the lesson on <a href="' ~ rel ~ 'learn/risk/position-sizing.html">position sizing</a>.',
   '用 <a href="' ~ rel ~ 'tools/calculators/position-size.html">仓位计算器</a>为杠杆交易按风险定仓，或在这节课中深入了解 <a href="' ~ rel ~ 'learn/risk/position-sizing.html">仓位管理</a>。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (Reg-T style margin — do not re-derive) ───────────────────
  // inputs: {E equity, im initial%, mm maint%, p entry}. Returns an outputs
  // object, or {ok:false, msg} for invalid input. Never returns NaN/Infinity.
  function compute(inp){
    var E=inp.E, im=inp.im, mm=inp.mm, p=inp.p;
    if(!(E>0)) return {ok:false, msg:"Enter your account equity above zero."};
    if(!(im>0)) return {ok:false, msg:"Enter the initial margin requirement (Reg-T is 50%)."};
    if(im>100) return {ok:false, msg:"Initial margin can't exceed 100%."};
    if(!(mm>0)) return {ok:false, msg:"Enter the maintenance margin requirement (often 25%)."};
    if(mm>100) return {ok:false, msg:"Maintenance margin can't exceed 100%."};
    if(mm>=im) return {ok:false, msg:"Maintenance margin must be below the initial requirement — otherwise a call would fire at entry."};
    if(!(p>0)) return {ok:false, msg:"Enter an entry price to count shares."};
    var buyingPower = E / (im/100);
    var leverage = 100 / im;
    var maxShares = Math.floor(buyingPower / p);
    var positionValue = maxShares * p;
    var marginCallPrice = p * (1 - im/100) / (1 - mm/100);
    return {
      ok:true, buyingPower:buyingPower, leverage:leverage, maxShares:maxShares,
      positionValue:positionValue, marginCallPrice:marginCallPrice
    };
  }

  // ── self-check: run the canonical fixtures on load, console.error on drift ──
  var WORKED_EXAMPLES = [
    { in:{E:10000, im:50, mm:25, p:50}, want:{buyingPower:20000, leverage:2, maxShares:400, marginCallPrice:33.333333} },
    { in:{E:25000, im:40, mm:30, p:100}, want:{buyingPower:62500, leverage:2.5, maxShares:625, marginCallPrice:85.714286} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, k;
      if(!got.ok){ console.error("margin self-check "+i+": compute failed", got); return; }
      for(k in w){ if(Math.abs(got[k] - w[k]) > 0.01){
        console.error("margin self-check "+i+" mismatch on "+k+": got "+got[k]+" want "+w[k]); } }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var els = { equity:$("equity"), initial:$("initial"), maint:$("maint"), price:$("price") };
    var outMain=$("out-main"), outPlain=$("out-plain"),
        outLev=$("out-lev"), outShares=$("out-shares"), outPos=$("out-pos"), outCall=$("out-call"),
        copyBtn=$("copy-result"), copied=$("copied");

    function numFrom(el){ var v=parseFloat((el.value||"").replace(/,/g,"").trim()); return isFinite(v)?v:NaN; }
    function money(n){ return "$" + n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function levStr(x){ return (x % 1 === 0 ? x.toFixed(0) : x.toFixed(2).replace(/0+$/,"").replace(/\.$/,"")) + ":1"; }
    function dash(){ outMain.textContent="—";
      [outLev,outShares,outPos,outCall].forEach(function(e){e.textContent="—"; e.className="";}); }

    var last=null;
    function render(){
      var inp={ E:numFrom(els.equity), im:numFrom(els.initial), mm:numFrom(els.maint), p:numFrom(els.price) };
      var res=compute(inp); last=res;
      if(!res.ok){ dash(); outPlain.textContent=res.msg; outPlain.className="co-plain"; return; }
      outMain.textContent   = money(res.buyingPower);
      outLev.textContent    = levStr(res.leverage);
      outShares.textContent = res.maxShares.toLocaleString("en-US");
      outPos.textContent    = money(res.positionValue);
      outCall.textContent   = money(res.marginCallPrice);
      // Law 3: plain-word interpretation under the number
      var plain = money(res.buyingPower) + " of buying power — " + levStr(res.leverage) +
        " leverage. At " + money(inp.p) + " that's up to " + res.maxShares.toLocaleString("en-US") +
        " shares; a fully-margined long would face a margin call near " + money(res.marginCallPrice) + ".";
      outPlain.textContent = plain; outPlain.className="co-plain";
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      return "Margin: " + money(last.buyingPower) + " buying power · " + levStr(last.leverage) +
        " leverage · " + last.maxShares.toLocaleString("en-US") + " shares · call near " +
        money(last.marginCallPrice) + " — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    ["equity","initial","maint","price"].forEach(function(id){
      els[id].addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
