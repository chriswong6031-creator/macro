{#=============================================================================
  calculators/dividend.html.j2 — Dividend Calculator (income cluster)
  Clones the position_size.html.j2 flagship structure. Dividend income + an
  optional DRIP (reinvest) vs take-cash projection over n years, with dividend
  growth g%. compute() is PURE; wire() does all DOM; WORKED_EXAMPLES self-checks
  the §6 fixtures on load. Never renders NaN/Infinity; empty/invalid → plain-word
  sentence in .co-plain and "—" in numbers. Inputs accept commas.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('dividend', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter what you’re investing, the share price and the annual dividend per share. You get the yearly and monthly income it throws off — and, if you add a growth rate and a horizon, how that income compounds with reinvestment.',
   '填入你的投资金额、股价与每股年度股息，即可得到它产生的年度与月度收入；再填入增长率与年限，还能看到收入在股息再投资下如何复利增长。') }}</p>

<div class="calc-in">
  <label class="ci"><span class="ci-l">{{ t('Amount invested ($)', '投资金额（$）') }}</span>
    <input id="amount" inputmode="decimal" autocomplete="off" placeholder="10,000"></label>
  <label class="ci"><span class="ci-l">{{ t('Share price ($)', '股价（$）') }}</span>
    <input id="price" inputmode="decimal" autocomplete="off" placeholder="50"></label>
  <label class="ci"><span class="ci-l">{{ t('Annual dividend / share ($)', '每股年度股息（$）') }}</span>
    <input id="dps" inputmode="decimal" autocomplete="off" placeholder="2"></label>
  <label class="ci"><span class="ci-l">{{ t('Dividend growth / yr (%)', '每年股息增长（%）') }} <span class="hint">{{ t('optional', '可选') }}</span></span>
    <input id="growth" inputmode="decimal" autocomplete="off" placeholder="0"></label>
  <div class="ci ci-wide">
    <span class="ci-l">{{ t('Reinvest dividends?', '是否再投资股息？') }} <span class="hint">{{ t('for the projection', '用于测算') }}</span></span>
    <div class="ci-seg" role="radiogroup" data-name="mode" aria-label="Reinvest or take cash">
      <button class="on" type="button" data-v="reinvest">{{ t('Reinvest', '再投资') }}</button><button type="button" data-v="cash">{{ t('Take cash', '领取现金') }}</button>
    </div>
  </div>
  <label class="ci"><span class="ci-l">{{ t('Horizon (years)', '年限（年）') }} <span class="hint">{{ t('optional', '可选') }}</span></span>
    <input id="years" inputmode="decimal" autocomplete="off" placeholder="10"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('per year', '每年') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in the amount, share price and dividend per share to see the income.', '填入金额、股价与每股股息即可查看收入。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Dividend yield', '股息率') }}</dt><dd id="out-yield">—</dd></div>
    <div><dt>{{ t('Monthly income', '月度收入') }}</dt><dd id="out-monthly">—</dd></div>
    <div><dt>{{ t('Shares', '股数') }}</dt><dd id="out-shares">—</dd></div>
    <div><dt>{{ t('Projected income / yr', '测算年度收入') }}</dt><dd id="out-projincome">—</dd></div>
    <div><dt>{{ t('Projected value', '测算总价值') }}</dt><dd id="out-projvalue">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('Your annual dividend income is simply the <strong>number of shares you own</strong> times the <strong>dividend per share</strong>. Shares come from your amount invested divided by the share price; the yield is the dividend per share as a percent of that price. Divide the yearly income by twelve for a monthly figure — though most companies actually pay quarterly.',
   '你的年度股息收入，就是<strong>持有股数</strong>乘以<strong>每股股息</strong>。股数等于投资金额除以股价；股息率则是每股股息占股价的百分比。把年度收入除以十二即得月度数字——尽管多数公司实际上按季度派息。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Shares</strong> = Amount ÷ Share price', '<strong>股数</strong> = 金额 ÷ 股价') }}<br>
{{ t('<strong>Annual income</strong> = Shares × Dividend per share', '<strong>年度收入</strong> = 股数 × 每股股息') }}<br>
{{ t('<strong>Dividend yield</strong> = 100 × Dividend per share ÷ Share price', '<strong>股息率</strong> = 100 × 每股股息 ÷ 股价') }}<br>
{{ t('Monthly income = Annual income ÷ 12', '月度收入 = 年度收入 ÷ 12') }}
</div>
<p>{{ t('Add a growth rate and a horizon and the projection compounds. If you <em>reinvest</em>, each year’s dividends buy more shares (we hold the price constant to isolate the dividend effect), and the dividend per share itself grows by your growth rate — two engines turning together. If you <em>take the cash</em>, the share count stays put and only the per-share dividend grows.',
   '再填入增长率与年限，测算便开始复利。若你选择<em>再投资</em>，每年的股息会买入更多股份（我们保持股价不变，以单独呈现股息效应），同时每股股息本身也按你的增长率提高——两台引擎同时运转。若你<em>领取现金</em>，股数保持不变，仅每股股息增长。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a trader puts <span class="num">$10,000</span> into a stock at <span class="num">$50.00</span> a share that pays <span class="num">$2.00</span> in annual dividends per share.',
   '假设一位交易者以每股 <span class="num">$50.00</span> 投入 <span class="num">$10,000</span> 于一只每股年派息 <span class="num">$2.00</span> 的股票。') }}</p>
<ul>
<li>{{ t('Shares = <span class="num">10,000 ÷ 50 = 200</span>', '股数 = <span class="num">10,000 ÷ 50 = 200</span>') }}</li>
<li>{{ t('Annual income = <span class="num">200 × 2 = $400</span>', '年度收入 = <span class="num">200 × 2 = $400</span>') }}</li>
<li>{{ t('Dividend yield = <span class="num">100 × 2 ÷ 50 = 4.00%</span>', '股息率 = <span class="num">100 × 2 ÷ 50 = 4.00%</span>') }}</li>
<li>{{ t('Monthly income = <span class="num">400 ÷ 12 = $33.33</span>', '月度收入 = <span class="num">400 ÷ 12 = $33.33</span>') }}</li>
</ul>
</div>
<p>{{ t('That $400 is the income at today’s dividend. Hold for a decade with the dividend growing 6% a year and reinvested, and both the share count and the per-share payout climb — the yearly income can end up well above where it started, which is the quiet appeal of dividend growth.',
   '这 $400 是按当前股息计的收入。若持有十年、股息每年增长 6% 并再投资，股数与每股派息都会攀升——年度收入最终可远高于起点，这正是股息增长的静默魅力。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Chasing the highest yield', '追逐最高股息率') }}</span>
<p>{{ t('A very high yield is often a warning, not a bargain. Yield is the dividend divided by the price — so when a stock’s price falls hard, the yield mechanically spikes even as the business weakens. If the company then cuts the dividend, the income you were counting on shrinks and the price can fall further. A yield far above a company’s peers deserves a look at <em>why</em> before it deserves your capital.',
   '极高的股息率往往是警讯，而非便宜货。股息率等于股息除以价格——所以当股价大跌时，即便基本面在恶化，股息率也会机械性地飙升。若公司随后削减股息，你所依赖的收入会缩水，价格还可能进一步下跌。远高于同业的股息率，先要弄清<em>为何如此</em>，再谈是否投入资本。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('The base income math is exact; the projection is a clean model, not a forecast. A few honest limits:',
   '基础收入的算法是精确的；测算则是一个干净的模型，而非预测。几点诚实的局限：') }}</p>
<ul>
<li>{{ t('<strong>Prices don’t stand still.</strong> The projection holds the share price constant to isolate the dividend. In reality the share price moves, which changes what reinvested dividends buy and the total value of the holding.',
   '<strong>价格并非静止。</strong>测算为单独呈现股息而保持股价不变。现实中股价会波动，从而改变再投资股息所能买入的份额，以及持仓的总价值。') }}</li>
<li>{{ t('<strong>Dividends aren’t promised.</strong> A dividend is declared by the board each period, not guaranteed. Growth rates are assumptions — payouts can be frozen or cut, and a steady growth rate is a smooth line drawn over a bumpy reality.',
   '<strong>股息并非承诺。</strong>股息由董事会每期决议，而非保证。增长率是假设——派息可能被冻结或削减，恒定的增长率只是画在崎岖现实之上的一条平滑曲线。') }}</li>
<li>{{ t('<strong>Taxes and fractional shares.</strong> This ignores dividend taxes, which reduce what you actually reinvest, and assumes fractional shares can be bought. Both shift the real outcome.',
   '<strong>税收与零股。</strong>此处忽略了会减少你实际再投资金额的股息税，并假设可买入零股。二者都会改变真实结果。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('Income today is arithmetic; income in ten years is an assumption. Treat the yearly figure as fact and the projection as a scenario.',
   '当下的收入是算术；十年后的收入是假设。把年度数字当作事实，把测算当作情景。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('See how reinvestment stacks up over time with the <a href="' ~ rel ~ 'tools/calculators/compounding.html">compounding calculator</a>, or measure a holding’s growth rate with the <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR calculator</a>.',
   '用 <a href="' ~ rel ~ 'tools/calculators/compounding.html">复利计算器</a>看再投资如何随时间累积，或用 <a href="' ~ rel ~ 'tools/calculators/cagr.html">CAGR 计算器</a>衡量一项持仓的增长率。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (income + optional DRIP/cash projection) ──────────────────
  // inputs: {A amount, p price, D dps, g growthPct, n years, reinvest bool}.
  // Returns an outputs object, or {ok:false, msg} for invalid input. Never NaN.
  function compute(inp){
    var A=inp.A, p=inp.p, D=inp.D, g=inp.g, n=inp.n, reinvest=inp.reinvest;
    if(!(A>0)) return {ok:false, msg:"Enter the amount you're investing."};
    if(!(p>0)) return {ok:false, msg:"Enter the share price."};
    if(!(D>=0)) return {ok:false, msg:"Enter the annual dividend per share (0 or more)."};
    var shares = A / p;
    var annualIncome = shares * D;
    var yieldPct = 100 * D / p;
    var monthly = annualIncome / 12;

    var out = {
      ok:true, shares:shares, annualIncome:annualIncome, yieldPct:yieldPct,
      monthly:monthly, reinvest:reinvest, hasProj:false
    };

    // projection only when a positive horizon is given
    if(n>0){
      var gr = (isFinite(g) && g!==null) ? g/100 : 0;
      var sh = shares, dps = D, yrs = Math.floor(n), cumCash = 0;
      if(reinvest){
        for(var i=0; i<yrs; i++){
          var inc = sh * dps;         // this year's dividend income
          sh += (p>0 ? inc / p : 0);  // buy more shares at a constant price
          dps = dps * (1 + gr);       // dividend per share grows
        }
      } else {
        // share count fixed; each year's dividend is taken as cash and piles up
        for(var j=0; j<yrs; j++){ cumCash += sh * dps; dps = dps * (1 + gr); }
      }
      out.hasProj = true;
      out.projYears = yrs;
      out.projIncome = sh * dps;      // projected annual income after n years
      out.cumCash = cumCash;          // total dividends collected (cash mode)
      // holding value is constant-price; in cash mode add the cash collected so
      // the figure isn't a static "= amount invested" that looks like a bug
      out.projValue  = reinvest ? (sh * p) : (sh * p + cumCash);
    }
    return out;
  }

  // ── §6 self-check: run the canonical fixtures on load, console.error on drift ─
  var WORKED_EXAMPLES = [
    { in:{A:10000, p:50, D:2, g:0, n:0, reinvest:true},
      want:{shares:200, annualIncome:400, yieldPct:4, monthly:400/12} },
    { in:{A:10000, p:50, D:2, g:6, n:10, reinvest:true},
      want:{shares:200, annualIncome:400, yieldPct:4} },
    { in:{A:20000, p:40, D:1.6, g:0, n:0, reinvest:false},
      want:{shares:500, annualIncome:800, yieldPct:4, monthly:800/12} },
    // pin the reinvest loop: 200 sh earn $400, buy 8 sh → 208 sh × $2 = $416/yr, value 208×50
    { in:{A:10000, p:50, D:2, g:0, n:1, reinvest:true},
      want:{projIncome:416, projValue:10400} },
    // pin cash mode: 200 sh × $2 = $400 collected; value = holding $10,000 + $400 cash
    { in:{A:10000, p:50, D:2, g:0, n:1, reinvest:false},
      want:{projIncome:400, cumCash:400, projValue:10400} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, k;
      if(!got.ok){ console.error("dividend self-check "+i+": compute failed", got); return; }
      for(k in w){ if(Math.abs(got[k] - w[k]) > 0.01){
        console.error("dividend self-check "+i+" mismatch on "+k+": got "+got[k]+" want "+w[k]); } }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var els = { amount:$("amount"), price:$("price"), dps:$("dps"), growth:$("growth"), years:$("years") };
    var seg = document.querySelector('.ci-seg[data-name="mode"]');
    var outMain=$("out-main"), outPlain=$("out-plain"),
        outYield=$("out-yield"), outMonthly=$("out-monthly"), outShares=$("out-shares"),
        outProjInc=$("out-projincome"), outProjVal=$("out-projvalue"),
        copyBtn=$("copy-result"), copied=$("copied");

    var reinvest = true;

    function numFrom(el){ var v=parseFloat((el.value||"").replace(/,/g,"").trim()); return isFinite(v)?v:NaN; }
    function money(n){ return "$" + n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function sharesFmt(n){ return n.toLocaleString("en-US",{minimumFractionDigits:0,maximumFractionDigits:2}); }
    function dash(){ outMain.textContent="—";
      [outYield,outMonthly,outShares,outProjInc,outProjVal].forEach(function(e){e.textContent="—"; e.className="";}); }

    var last=null;
    function render(){
      var inp={
        A:numFrom(els.amount), p:numFrom(els.price), D:numFrom(els.dps),
        g:numFrom(els.growth), n:numFrom(els.years), reinvest:reinvest
      };
      var res=compute(inp); last=res;
      if(!res.ok){ dash(); outPlain.textContent=res.msg; outPlain.className="co-plain"; return; }
      outMain.textContent = money(res.annualIncome);
      outYield.textContent = res.yieldPct.toFixed(2) + "%";
      outMonthly.textContent = money(res.monthly);
      outShares.textContent = sharesFmt(res.shares);

      if(res.hasProj){
        outProjInc.textContent = money(res.projIncome); outProjInc.className="pos";
        outProjVal.textContent = money(res.projValue);
      } else {
        outProjInc.textContent = "—"; outProjInc.className="";
        outProjVal.textContent = "—"; outProjVal.className="";
      }

      // Law 3: plain-word interpretation under the number
      var plain = "That's " + money(res.annualIncome) + " a year — about " +
        money(res.monthly) + " a month — a " + res.yieldPct.toFixed(2) +
        "% dividend yield on " + sharesFmt(res.shares) + " shares.";
      if(res.hasProj){
        var verb = res.reinvest ? "reinvested" : "taken as cash";
        plain += " After " + res.projYears + " year" + (res.projYears===1?"":"s") +
          " with dividends " + verb + ", the yearly income projects to " +
          money(res.projIncome) + ".";
      }
      outPlain.textContent = plain; outPlain.className="co-plain";
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      var s = "Dividend income: " + money(last.annualIncome) + "/yr (" +
        money(last.monthly) + "/mo) at a " + last.yieldPct.toFixed(2) + "% yield on " +
        sharesFmt(last.shares) + " shares";
      if(last.hasProj){
        s += " · after " + last.projYears + "y " +
          (last.reinvest?"reinvested":"cash") + ": " + money(last.projIncome) + "/yr";
      }
      return s + " — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    if(seg){
      seg.addEventListener("click", function(e){
        var b = e.target.closest("button[data-v]"); if(!b) return;
        reinvest = (b.getAttribute("data-v") === "reinvest");
        [].forEach.call(seg.querySelectorAll("button"), function(x){ x.classList.toggle("on", x===b); });
        render();
      });
    }
    ["amount","price","dps","growth","years"].forEach(function(id){
      els[id].addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
