{#=============================================================================
  calculators/percentage_gain_loss.html.j2 — cloned from position_size.html.j2
  Implements CONTRACT §6 DOM + §8 copy laws. Formula (per build brief):
    pct = 100·(X−E)/E ; dollarChange = (X−E)·(Q||1)
    on a loss (pct<0): recoveryPct = 100·(−pct)/(100+pct)  — the drawdown-
    recovery mirror: the gain from the lower price needed to reach E again.
  compute() is PURE; wire() does all DOM I/O; WORKED_EXAMPLES self-checks on
  load (console.error on drift, silent when green). Never renders NaN/Infinity.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('percentage-gain-loss', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter the price you bought at and the price you sold (or would sell) at. You get the percent change, the dollar profit or loss if you add a share count, and — on a loss — the gain you’d need to climb back to break-even.',
   '填入你的买入价与卖出价（或拟卖出价），即可得到涨跌幅；填入股数还能算出盈亏金额；若是亏损，还会显示要回到成本价所需的涨幅。') }}</p>

<div class="calc-in">
  <label class="ci"><span class="ci-l">{{ t('Buy price ($)', '买入价（$）') }}</span>
    <input id="buy" inputmode="decimal" autocomplete="off" placeholder="50"></label>
  <label class="ci"><span class="ci-l">{{ t('Sell price ($)', '卖出价（$）') }}</span>
    <input id="sell" inputmode="decimal" autocomplete="off" placeholder="60"></label>
  <label class="ci ci-wide"><span class="ci-l">{{ t('Shares', '股数') }} <span class="hint">{{ t('optional — for dollar P/L', '可选——用于计算盈亏金额') }}</span></span>
    <input id="qty" inputmode="decimal" autocomplete="off" placeholder="200"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('change', '涨跌幅') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in the buy and sell prices to see the percent change.', '填入买入价与卖出价即可查看涨跌幅。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Dollar P/L', '盈亏金额') }}</dt><dd id="out-dollar">—</dd></div>
    <div><dt>{{ t('Gain to break even', '回本所需涨幅') }}</dt><dd id="out-recover">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('The percent change between two prices is the <strong>difference divided by the price you started at</strong>, times 100 — so a move from $50 to $60 is a $10 gain on a $50 base, or +20%. Multiply the raw dollar move by your share count for the profit or loss in cash. And when the result is a loss, the percentage that recovered it back to break-even is <em>larger</em> than the percentage you lost — a fact worth internalizing.',
   '两个价格之间的涨跌幅，就是<strong>差额除以起始价格</strong>再乘以 100——所以从 $50 涨到 $60，是在 $50 的基础上涨了 $10，即 +20%。把每股的价格变动乘以股数，就得到以现金计的盈亏。而当结果为亏损时，把它拉回成本价所需的涨幅，会<em>大于</em>你亏掉的跌幅——这一点值得牢记。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Percent change</strong> = 100 × ( Sell − Buy ) ÷ Buy', '<strong>涨跌幅</strong> = 100 × ( 卖出 − 买入 ) ÷ 买入') }}<br>
{{ t('<strong>Dollar P/L</strong> = ( Sell − Buy ) × Shares', '<strong>盈亏金额</strong> = ( 卖出 − 买入 ) × 股数') }}<br>
{{ t('<strong>Gain to break even</strong> = 100 × ( −change% ) ÷ ( 100 + change% )', '<strong>回本所需涨幅</strong> = 100 × ( −涨跌幅% ) ÷ ( 100 + 涨跌幅% )') }}
</div>
<p>{{ t('The break-even line only appears on a loss. It answers a different question than “how much did I lose”: it asks how far the <em>lower</em> price has to rise to reach your original cost again. Because the climb starts from a smaller base, the required gain always exceeds the loss — lose 20% and you need +25% back; lose 50% and you need +100%.',
   '回本涨幅一行只在亏损时出现。它回答的是与「我亏了多少」不同的另一个问题：<em>更低</em>的价格要涨多少，才能回到你最初的成本。由于起点更低，所需涨幅总是大于亏损幅度——亏 20% 需涨 +25%，亏 50% 则需涨 +100%。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a trader buys at <span class="num">$100.00</span> and later sells <span class="num">200</span> shares at <span class="num">$50.00</span>.',
   '假设一位交易者以 <span class="num">$100.00</span> 买入，之后以 <span class="num">$50.00</span> 卖出 <span class="num">200</span> 股。') }}</p>
<ul>
<li>{{ t('Percent change = <span class="num">100 × (50 − 100) ÷ 100 = −50.00%</span>', '涨跌幅 = <span class="num">100 × (50 − 100) ÷ 100 = −50.00%</span>') }}</li>
<li>{{ t('Dollar P/L = <span class="num">(50 − 100) × 200 = −$10,000</span>', '盈亏金额 = <span class="num">(50 − 100) × 200 = −$10,000</span>') }}</li>
<li>{{ t('Gain to break even = <span class="num">100 × 50 ÷ (100 − 50) = +100%</span> — the $50 price must double to reach $100 again.',
   '回本所需涨幅 = <span class="num">100 × 50 ÷ (100 − 50) = +100%</span>——$50 的价格必须翻倍才能回到 $100。') }}</li>
</ul>
</div>
<p>{{ t('The gain and the loss are not symmetric. Halving your money reads as a clean “−50%,” but undoing it takes a full double. This asymmetry is the quiet reason large drawdowns are so costly: the deeper the hole, the steeper the climb out.',
   '涨幅与跌幅并不对称。资金腰斩看上去只是干脆的「−50%」，但要弥补它却需要整整翻倍。这种不对称，正是大幅回撤代价高昂的隐秘原因：坑挖得越深，爬出来的坡就越陡。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Adding gains and losses as if they cancel', '把涨跌幅当作可以相互抵消') }}</span>
<p>{{ t('A +50% gain followed by a −50% loss does not leave you flat. Start at $100, gain 50% to $150, then lose 50% of $150 — you land at $75, down 25%. Percentages compound off a moving base, so they can’t simply be added or subtracted across periods. To combine two moves, multiply the growth factors (1.5 × 0.5 = 0.75), not the percentages.',
   '先涨 50%、再跌 50%，并不会让你回到原点。从 $100 涨 50% 到 $150，再从 $150 跌 50%——你落在 $75，净跌 25%。百分比是在不断变动的基数上复利计算的，因此不能在不同时期间简单相加或相减。要合并两段变动，应把增长因子相乘（1.5 × 0.5 = 0.75），而非把百分比相加。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('This is clean arithmetic on two prices. It stays honest only as long as those two prices are the whole story — and often they aren’t:',
   '这是对两个价格的干净算术。只有当这两个价格就是全部时它才诚实——而现实往往并非如此：') }}</p>
<ul>
<li>{{ t('<strong>Costs are ignored.</strong> Commissions, spread, slippage and taxes all sit between the quoted change and the money that actually reaches your account. A small percentage move can be entirely eaten by frictions.',
   '<strong>忽略了成本。</strong>佣金、买卖价差、滑点与税费，都夹在报出的涨跌幅和真正到账的钱之间。一次小幅变动，可能被这些摩擦成本完全吞掉。') }}</li>
<li>{{ t('<strong>Dividends and splits.</strong> Raw price change misses cash paid out along the way, and a stock split changes the price without changing value — compare split-adjusted prices, not headline quotes.',
   '<strong>股息与拆股。</strong>单看价格变动，会漏掉期间派发的现金，而拆股会在不改变价值的情况下改变价格——应比较复权后的价格，而非表面报价。') }}</li>
<li>{{ t('<strong>Percent ≠ dollars ≠ risk.</strong> A big percentage on a tiny position can matter less than a small percentage on a large one. Read the percent change alongside how much was at stake, not on its own.',
   '<strong>百分比 ≠ 金额 ≠ 风险。</strong>小仓位上的大百分比，重要性可能不及大仓位上的小百分比。要把涨跌幅与所投入的规模一并来看，而非孤立地读它。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('A gain and the loss it reverses are never the same size — the smaller your base, the harder it works to climb back.',
   '一段涨幅与它所弥补的跌幅，从来不是同一个大小——基数越小，爬回原点就越吃力。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('See how deep drawdowns compound in the <a href="' ~ rel ~ 'tools/calculators/drawdown-recovery.html">drawdown-recovery calculator</a>, or study how gains and losses combine in the lesson on <a href="' ~ rel ~ 'learn/risk/risk-reward-expectancy.html">risk, reward and expectancy</a>.',
   '在 <a href="' ~ rel ~ 'tools/calculators/drawdown-recovery.html">回撤修复计算器</a>中看看深度回撤如何累积，或在 <a href="' ~ rel ~ 'learn/risk/risk-reward-expectancy.html">风险、回报与期望值</a> 这节课中学习涨跌如何叠加。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (build-brief formula — do not re-derive) ──────────────────
  // inputs: {E buy, X sell, Q shares|NaN}. Returns an outputs object, or
  // {ok:false,msg} for invalid input. Never returns NaN/Infinity.
  function compute(inp){
    var E=inp.E, X=inp.X, Q=inp.Q;
    if(!(E>0)) return {ok:false, msg:"Enter your buy price above zero."};
    if(!isFinite(X)) return {ok:false, msg:"Enter your sell price."};
    var pct = 100 * (X - E) / E;
    var hasQty = isFinite(Q) && Q > 0;
    var dollar = (X - E) * (hasQty ? Q : 1);
    var isLoss = pct < 0;
    // recovery: gain from the lower price needed to return to the buy price.
    // 100·(−pct)/(100+pct); guard the degenerate X<=0 (pct<=−100) case.
    var recoveryPct = null;
    if(isLoss && (100 + pct) > 0) recoveryPct = 100 * (-pct) / (100 + pct);
    return {
      ok:true, pct:pct, dollar:dollar, hasQty:hasQty,
      isLoss:isLoss, isGain:pct>0, recoveryPct:recoveryPct,
      total:(X<=0)
    };
  }

  // ── §6 self-check: run the canonical fixtures on load, console.error on drift ─
  var WORKED_EXAMPLES = [
    { in:{E:50,  X:60, Q:NaN}, want:{pct:20} },
    { in:{E:100, X:50, Q:NaN}, want:{pct:-50, recoveryPct:100} },
    { in:{E:100, X:50, Q:200}, want:{pct:-50, dollar:-10000, recoveryPct:100} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, k;
      if(!got.ok){ console.error("percentage-gain-loss self-check "+i+": compute failed", got); return; }
      for(k in w){
        var g = got[k];
        if(g === null || Math.abs(g - w[k]) > 0.01){
          console.error("percentage-gain-loss self-check "+i+" mismatch on "+k+": got "+g+" want "+w[k]); }
      }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var els = { buy:$("buy"), sell:$("sell"), qty:$("qty") };
    var outMain=$("out-main"), outPlain=$("out-plain"),
        outDollar=$("out-dollar"), outRecover=$("out-recover"),
        copyBtn=$("copy-result"), copied=$("copied");

    function numFrom(el){ var v=parseFloat((el.value||"").replace(/,/g,"").trim()); return isFinite(v)?v:NaN; }
    function money(n){ var s=(n<0?"-":"")+"$"+Math.abs(n).toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); return s; }
    function signPct(n){ return (n>=0?"+":"") + n.toFixed(2) + "%"; }
    function dash(){ outMain.textContent="—"; outMain.className="";
      [outDollar,outRecover].forEach(function(e){e.textContent="—"; e.className="";}); }

    var last=null;
    function render(){
      var inp={ E:numFrom(els.buy), X:numFrom(els.sell), Q:numFrom(els.qty) };
      var res=compute(inp); last=res;
      if(!res.ok){ dash(); outPlain.textContent=res.msg; outPlain.className="co-plain"; return; }

      outMain.textContent = signPct(res.pct);
      outMain.className = res.isGain ? "" : (res.isLoss ? "" : "");

      // dollar P/L (only meaningful when a share count is given)
      if(res.hasQty){ outDollar.textContent = money(res.dollar);
        outDollar.className = res.dollar>0 ? "pos" : (res.dollar<0 ? "neg" : ""); }
      else { outDollar.textContent = "—"; outDollar.className=""; }

      // break-even climb (only on a loss)
      if(res.isLoss && res.recoveryPct!==null){ outRecover.textContent = "+" + res.recoveryPct.toFixed(2) + "%";
        outRecover.className="neg"; }
      else if(res.isLoss && res.recoveryPct===null){ outRecover.textContent = "—"; outRecover.className=""; }
      else { outRecover.textContent = "—"; outRecover.className=""; }

      // Law 3: plain-word interpretation under the number
      var plain;
      if(res.isGain){
        plain = "A gain of " + signPct(res.pct) + " from " + money(inp.E) + " to " + money(inp.X) + ".";
        if(res.hasQty) plain += " On " + inp.Q.toLocaleString("en-US") + " shares that's " + money(res.dollar) + " in profit.";
      } else if(res.isLoss){
        plain = "A loss of " + res.pct.toFixed(2) + "% from " + money(inp.E) + " to " + money(inp.X) + ".";
        if(res.hasQty) plain += " On " + inp.Q.toLocaleString("en-US") + " shares that's " + money(res.dollar) + ".";
        if(res.recoveryPct!==null) plain += " It would take a +" + res.recoveryPct.toFixed(2) + "% gain from here to break even.";
        else plain += " The price has fallen to zero or below — there is no gain that recovers it.";
      } else {
        plain = "No change — the sell price equals the buy price.";
      }
      outPlain.textContent = plain; outPlain.className="co-plain";
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      var inp={ E:numFrom(els.buy), X:numFrom(els.sell), Q:numFrom(els.qty) };
      var s = "Percent change: " + signPct(last.pct) + " (" + money(inp.E) + " → " + money(inp.X) + ")";
      if(last.hasQty) s += " · " + money(last.dollar) + " on " + inp.Q.toLocaleString("en-US") + " shares";
      if(last.isLoss && last.recoveryPct!==null) s += " · needs +" + last.recoveryPct.toFixed(2) + "% to break even";
      return s + " — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    ["buy","sell","qty"].forEach(function(id){ els[id].addEventListener("input", render); });
    render();
  });
})();
</script>
{% endblock %}
