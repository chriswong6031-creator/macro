{#=============================================================================
  calculators/covered_call.html.j2 — Covered Call Return Calculator
  Clones the flagship position_size.html.j2 structure (CONTRACT §6 DOM + §6
  self-check + §8 explainer structure). Formulas per the covered-call spec:
  income (static) return, return-if-called, break-even, and an illustrative
  annualized-if-called figure when days-to-expiration is supplied.

  Context set by the builder (per CONTRACT §5): page{slug:'covered-call', ...},
  rel, site, toc, related, cta.

  compute() is PURE (no DOM); wire() does all DOM reads/writes; WORKED_EXAMPLES
  runs each fixture through compute() on load and console.error's any mismatch
  (silent when green). Never render NaN/Infinity; empty/invalid → a plain-word
  sentence in .co-plain and "—" in the numbers. Inputs accept commas.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('covered-call', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter your cost basis, the call strike you sold, and the premium you collected. You get the income if the stock stays flat, the total return if it’s called away, and the break-even — per 100 shares.',
   '填入你的持股成本、卖出的看涨期权行权价，以及收到的权利金，即可得到——股价持平时的收入、被行权（call away）时的总回报，以及保本价（每 100 股）。') }}</p>

<div class="calc-in">
  <label class="ci"><span class="ci-l">{{ t('Cost basis ($/share)', '成本价（$/股）') }}</span>
    <input id="basis" inputmode="decimal" autocomplete="off" placeholder="100"></label>
  <label class="ci"><span class="ci-l">{{ t('Call strike ($)', '行权价（$）') }} <span class="hint">{{ t('the price you sold', '你卖出的价位') }}</span></span>
    <input id="strike" inputmode="decimal" autocomplete="off" placeholder="105"></label>
  <label class="ci"><span class="ci-l">{{ t('Premium received ($/share)', '收到的权利金（$/股）') }}</span>
    <input id="prem" inputmode="decimal" autocomplete="off" placeholder="3"></label>
  <label class="ci"><span class="ci-l">{{ t('Days to expiration', '到期天数') }} <span class="hint">{{ t('optional', '选填') }}</span></span>
    <input id="days" inputmode="decimal" autocomplete="off" placeholder="30"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span><span class="co-unit">{{ t('if called', '被行权') }}</span></div>
  <p class="co-plain" id="out-plain">{{ t('Fill in cost basis, strike and premium to see the return.', '填入成本价、行权价与权利金即可查看回报。') }}</p>
  <dl class="co-rows">
    <div><dt>{{ t('Static (income) return', '静态（收入）回报') }}</dt><dd id="out-static">—</dd></div>
    <div><dt>{{ t('Break-even price', '保本价') }}</dt><dd id="out-breakeven">—</dd></div>
    <div><dt>{{ t('Downside protection', '下行保护') }}</dt><dd id="out-protect">—</dd></div>
    <div><dt>{{ t('Annualized if called', '被行权年化') }}</dt><dd id="out-annual">—</dd></div>
  </dl>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>
{% endblock %}

{% block article_body %}
<p>{{ t('A covered call earns you the <strong>premium</strong> up front in exchange for capping your upside at the <strong>strike</strong>. Two returns matter: the <strong>static return</strong> — the income you keep if the stock stays flat and the option expires worthless — and the <strong>return if called</strong> — the total gain if the stock finishes above the strike and your shares are sold at it. Both are measured against your cost basis.',
   '备兑看涨期权（covered call）让你预先赚取<strong>权利金</strong>，代价是把上涨空间封顶在<strong>行权价</strong>。有两个回报值得关注：<strong>静态回报</strong>——若股价持平、期权作废，你留下的收入；以及<strong>被行权回报</strong>——若股价收在行权价之上、股票以行权价被卖出时的总收益。两者都以你的成本价为基准衡量。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Static return %</strong> = 100 × premium ÷ cost basis', '<strong>静态回报 %</strong> = 100 × 权利金 ÷ 成本价') }}<br>
{{ t('<strong>Return if called %</strong> = 100 × (strike − basis + premium) ÷ basis', '<strong>被行权回报 %</strong> = 100 × (行权价 − 成本价 + 权利金) ÷ 成本价') }}<br>
{{ t('<strong>Break-even</strong> = cost basis − premium', '<strong>保本价</strong> = 成本价 − 权利金') }}<br>
{{ t('<strong>Annualized if called %</strong> = 100 × ( (1 + return if called)^(365 ÷ days) − 1 )', '<strong>被行权年化 %</strong> = 100 × ( (1 + 被行权回报)^(365 ÷ 天数) − 1 )') }}
</div>
<p>{{ t('The premium does double duty: it is your income <em>and</em> your first line of downside protection — the stock can fall by the premium before you’re underwater, which is exactly the break-even. The annualized figure simply scales the if-called return to a full year; it assumes the same trade could be repeated at the same pace, which is a big assumption.',
   '权利金一物两用：既是你的收入，<em>也是</em>你的第一道下行保护——股价可以下跌至多一个权利金的幅度你才开始亏损，这个点正是保本价。年化数字只是把被行权回报按比例换算成整年；它假设同样的交易能以同样的节奏反复进行——这是一个很大的假设。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a trader owns shares at a <span class="num">$100.00</span> cost basis and sells a one-month call at the <span class="num">$105</span> strike, collecting <span class="num">$3.00</span> per share. Days to expiration: <span class="num">30</span>.',
   '假设某交易者以 <span class="num">$100.00</span> 的成本持股，卖出一个月后到期、行权价 <span class="num">$105</span> 的看涨期权，每股收取 <span class="num">$3.00</span> 权利金。到期天数：<span class="num">30</span>。') }}</p>
<ul>
<li>{{ t('Static return = <span class="num">100 × 3 ÷ 100 = 3.00%</span> — the income if the stock is flat.', '静态回报 = <span class="num">100 × 3 ÷ 100 = 3.00%</span>——股价持平时的收入。') }}</li>
<li>{{ t('Return if called = <span class="num">100 × (105 − 100 + 3) ÷ 100 = 8.00%</span>.', '被行权回报 = <span class="num">100 × (105 − 100 + 3) ÷ 100 = 8.00%</span>。') }}</li>
<li>{{ t('Break-even = <span class="num">100 − 3 = $97.00</span>.', '保本价 = <span class="num">100 − 3 = $97.00</span>。') }}</li>
<li>{{ t('Annualized if called = <span class="num">100 × (1.08^(365÷30) − 1) ≈ 155%</span> — hypothetical, if repeated every month for a year.', '被行权年化 = <span class="num">100 × (1.08^(365÷30) − 1) ≈ 155%</span>——假设性数字，前提是每月重复一整年。') }}</li>
</ul>
</div>
<p>{{ t('That ~155% headline is the number covered-call marketing loves to quote — and it is illustrative only. It presumes you can re-sell a call at the same premium, twelve times, with the stock landing just right each time. The honest figures here are the 3% you actually collect this month and the 8% ceiling if the shares are called.',
   '这个约 155% 的醒目数字，正是备兑看涨营销最爱引用的——但它仅供说明。它假设你能以同样的权利金反复卖出看涨期权十二次，且每次股价都恰到好处。真正诚实的数字，是你这个月实际收到的 3%，以及股票被行权时 8% 的上限。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Treating the annualized number as a forecast', '把年化数字当成预测') }}</span>
<p>{{ t('The annualized-if-called figure is a scaling, not a promise. It quietly assumes the trade repeats perfectly all year — same premium, same favorable close — and it ignores the months the stock falls (where the premium only softens the loss) or gaps far above the strike (where you leave the extra upside on the table). A single good month annualized to triple digits is a hypothetical, not an expected return.',
   '被行权年化数字是一种换算，而非承诺。它悄悄假设交易全年完美重复——同样的权利金、同样有利的收盘价——却忽略了股价下跌的月份（那时权利金只是减轻亏损），以及远高于行权价的跳空（那时你放弃了额外的上涨）。把一个好月份年化成三位数，只是假设，而非预期回报。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('This math gives a clean picture of one covered call at expiration. A few honest limits:',
   '这套算法清晰地描绘了单个备兑看涨期权在到期时的情形。几点诚实的局限：') }}</p>
<ul>
<li>{{ t('<strong>Capped upside.</strong> If the stock rockets past the strike, your gain stops at the strike plus premium — the return if called is your ceiling, no matter how high it runs.',
   '<strong>上涨封顶。</strong>若股价一飞冲天越过行权价，你的收益止步于行权价加权利金——无论涨多高，被行权回报就是你的天花板。') }}</li>
<li>{{ t('<strong>Real downside remains.</strong> The premium cushions a fall only down to the break-even; below that you lose money on the shares, and a large drop dwarfs the income collected.',
   '<strong>真实下行仍在。</strong>权利金只能缓冲下跌到保本价为止；再往下你就在股票上亏钱，一次大跌足以让收到的收入相形见绌。') }}</li>
<li>{{ t('<strong>Taxes, fees, dividends, and early assignment.</strong> This calculator ignores commissions, the tax treatment of premium and any called-away gain, dividends you may lose to early assignment, and the chance of being assigned before expiration. All shift the real outcome.',
   '<strong>税费、股息与提前行权。</strong>本计算器不计佣金、权利金与被行权收益的税务处理、可能因提前行权而失去的股息，以及到期前被指派行权的可能。这些都会改变真实结果。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('A covered call trades your upside above the strike for income today. Judge it by the premium you keep and the ceiling you accept — not by an annualized number that assumes a perfect year.',
   '备兑看涨期权，是用行权价以上的上涨空间，换取今天的收入。用你留下的权利金和你接受的上限来评判它——而不是用一个假设完美一整年的年化数字。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('See what a single closed trade actually returned with the <a href="' ~ rel ~ 'tools/calculators/trade-profit.html">trade profit calculator</a>, or weigh a stop against a target with the <a href="' ~ rel ~ 'tools/calculators/risk-reward.html">risk-to-reward calculator</a>.',
   '用 <a href="' ~ rel ~ 'tools/calculators/trade-profit.html">交易盈亏计算器</a>看单笔平仓交易的实际回报，或用 <a href="' ~ rel ~ 'tools/calculators/risk-reward.html">盈亏比计算器</a>权衡止损与目标。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (covered-call spec — do not re-derive) ────────────────────
  // inputs: {c basis, K strike, prem premium, d daysToExp (optional, 0 = none)}.
  // Returns an outputs object, or {ok:false, msg} for invalid input.
  // Never returns NaN/Infinity.
  function compute(inp){
    var c=inp.c, K=inp.K, prem=inp.prem, d=inp.d;
    if(!(c>0)) return {ok:false, msg:"Enter a cost basis above zero."};
    if(!(K>0)) return {ok:false, msg:"Enter the call strike you sold."};
    if(!(prem>0)) return {ok:false, msg:"Enter the premium you received per share."};
    var staticReturnPct = 100 * prem / c;
    var ifCalledReturnPct = 100 * (K - c + prem) / c;
    var breakeven = c - prem;
    var downsideProtectionPct = 100 * prem / c;
    var hasDays = isFinite(d) && d > 0;
    var annualizedIfCalled = null;
    if(hasDays){
      annualizedIfCalled = 100 * (Math.pow(1 + ifCalledReturnPct/100, 365/d) - 1);
      if(!isFinite(annualizedIfCalled)) annualizedIfCalled = null;
    }
    return {
      ok:true,
      staticReturnPct:staticReturnPct,
      ifCalledReturnPct:ifCalledReturnPct,
      breakeven:breakeven,
      downsideProtectionPct:downsideProtectionPct,
      hasDays:hasDays,
      annualizedIfCalled:annualizedIfCalled,
      strikeBelowBasis: K < c
    };
  }

  // ── §6 self-check: run the canonical fixtures on load, console.error on drift ─
  var WORKED_EXAMPLES = [
    { in:{c:100, K:105, prem:3, d:30}, want:{staticReturnPct:3, ifCalledReturnPct:8, breakeven:97, annualizedIfCalled:155.08} },
    { in:{c:50,  K:52,  prem:1.5, d:0}, want:{staticReturnPct:3, ifCalledReturnPct:7, breakeven:48.5} }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, i){
      var got = compute(ex.in), w = ex.want, k;
      if(!got.ok){ console.error("covered-call self-check "+i+": compute failed", got); return; }
      for(k in w){
        if(got[k]===null || Math.abs(got[k] - w[k]) > 0.5){
          console.error("covered-call self-check "+i+" mismatch on "+k+": got "+got[k]+" want "+w[k]); } }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var els = { basis:$("basis"), strike:$("strike"), prem:$("prem"), days:$("days") };
    var outMain=$("out-main"), outUnit=null, outPlain=$("out-plain"),
        outStatic=$("out-static"), outBreak=$("out-breakeven"),
        outProtect=$("out-protect"), outAnnual=$("out-annual"),
        copyBtn=$("copy-result"), copied=$("copied");

    function numFrom(el){ var v=parseFloat((el.value||"").replace(/,/g,"").trim()); return isFinite(v)?v:NaN; }
    function money(n){ return "$" + n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function pct(n){ return n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}) + "%"; }
    function dash(){ outMain.textContent="—";
      [outStatic,outBreak,outProtect,outAnnual].forEach(function(e){e.textContent="—"; e.className="";}); }

    var last=null;
    function render(){
      var inp={ c:numFrom(els.basis), K:numFrom(els.strike), prem:numFrom(els.prem), d:numFrom(els.days) };
      var res=compute(inp); last=res;
      if(!res.ok){ dash(); outPlain.textContent=res.msg; outPlain.className="co-plain"; return; }

      outMain.textContent = res.ifCalledReturnPct.toFixed(2) + "%";
      outStatic.textContent  = pct(res.staticReturnPct);
      outBreak.textContent   = money(res.breakeven);
      outProtect.textContent = pct(res.downsideProtectionPct);
      outStatic.className = "pos";
      outAnnual.textContent  = res.hasDays ? pct(res.annualizedIfCalled) : "—";

      // Law 3: plain-word interpretation under the number
      var plain = "You keep " + pct(res.staticReturnPct) + " as income if the stock stays flat, "
        + "and make " + pct(res.ifCalledReturnPct) + " in total if it’s called away at the strike. "
        + "Break-even is " + money(res.breakeven) + " — below that, the premium no longer covers the loss.";
      if(res.hasDays && res.annualizedIfCalled !== null){
        plain += " Annualized, the if-called return is " + pct(res.annualizedIfCalled)
          + " — illustrative only, if the trade repeated all year.";
      }
      if(res.strikeBelowBasis){
        plain = "Your strike is below your cost basis, so being called locks in a loss even after the premium. " + plain;
        outPlain.className = "co-plain warn";
      } else {
        outPlain.className = "co-plain";
      }
      outPlain.textContent = plain;
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      var s = "Covered call: static " + pct(last.staticReturnPct)
        + " · if called " + pct(last.ifCalledReturnPct)
        + " · break-even " + money(last.breakeven);
      if(last.hasDays && last.annualizedIfCalled !== null){
        s += " · ~" + pct(last.annualizedIfCalled) + " annualized (hypothetical)";
      }
      return s + " — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    ["basis","strike","prem","days"].forEach(function(id){
      els[id].addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
