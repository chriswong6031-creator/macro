{#=============================================================================
  calculators/portfolio_rebalancing.html.j2 — Portfolio Rebalancing Calculator
  Clones the flagship position_size.html.j2 STRUCTURE. Implements the
  rebalancing formula (target weights → buy/sell actions) + the §6
  WORKED_EXAMPLES self-check. Explainer body follows §8 structure:
  direct answer → formula → worked example → common trap → where it breaks
  → links. Fully bilingual EN/ZH (calculators are the §8 dual-DOM exception).

  Context set by the builder (per CONTRACT §5): page{slug:'portfolio-rebalancing',
  family:'page', title, description, canonical, url_path, section:'tools',
  breadcrumbs}, rel, site, related, cta.
=============================================================================#}
{% extends "seo_calculator_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}

{% block calc_glyph %}{{ glyphs.glyph('portfolio-rebalancing', 'crown') }}{% endblock %}

{% block calc_form %}
<p class="cc-lede">{{ t('Enter what each holding is worth today and the weight you want it to carry. Add any new cash you’re putting in. You get the exact dollar buys and sells that pull the portfolio back to your targets.',
   '填入每个持仓当前的价值和你希望它占的比重，再加上你打算投入的新增现金，即可得到——把组合拉回目标权重所需的——每笔确切的买入与卖出金额。') }}</p>

<div class="calc-in prc-in">
  <div class="ci ci-wide prc-head" aria-hidden="true">
    <span class="prc-hcol">{{ t('Holding', '持仓') }}</span>
    <span class="prc-hcol">{{ t('Current value ($)', '当前价值（$）') }}</span>
    <span class="prc-hcol">{{ t('Target weight (%)', '目标权重（%）') }}</span>
  </div>

  <div class="ci ci-wide prc-row">
    <input class="prc-name" data-i="0" autocomplete="off" placeholder="A">
    <input class="prc-val"  data-i="0" inputmode="decimal" autocomplete="off" placeholder="6,000">
    <input class="prc-tgt"  data-i="0" inputmode="decimal" autocomplete="off" placeholder="50">
  </div>
  <div class="ci ci-wide prc-row">
    <input class="prc-name" data-i="1" autocomplete="off" placeholder="B">
    <input class="prc-val"  data-i="1" inputmode="decimal" autocomplete="off" placeholder="4,000">
    <input class="prc-tgt"  data-i="1" inputmode="decimal" autocomplete="off" placeholder="50">
  </div>
  <div class="ci ci-wide prc-row">
    <input class="prc-name" data-i="2" autocomplete="off" placeholder="C (optional)">
    <input class="prc-val"  data-i="2" inputmode="decimal" autocomplete="off" placeholder="">
    <input class="prc-tgt"  data-i="2" inputmode="decimal" autocomplete="off" placeholder="">
  </div>
  <div class="ci ci-wide prc-row">
    <input class="prc-name" data-i="3" autocomplete="off" placeholder="D (optional)">
    <input class="prc-val"  data-i="3" inputmode="decimal" autocomplete="off" placeholder="">
    <input class="prc-tgt"  data-i="3" inputmode="decimal" autocomplete="off" placeholder="">
  </div>
  <div class="ci ci-wide prc-row">
    <input class="prc-name" data-i="4" autocomplete="off" placeholder="E (optional)">
    <input class="prc-val"  data-i="4" inputmode="decimal" autocomplete="off" placeholder="">
    <input class="prc-tgt"  data-i="4" inputmode="decimal" autocomplete="off" placeholder="">
  </div>

  <label class="ci ci-wide"><span class="ci-l">{{ t('New cash to add ($)', '新增现金（$）') }} <span class="hint">{{ t('optional', '可选') }}</span></span>
    <input id="newcash" inputmode="decimal" autocomplete="off" placeholder="0"></label>
</div>

<div class="calc-out" aria-live="polite">
  <div class="co-main"><span id="out-main">—</span></div>
  <p class="co-plain" id="out-plain">{{ t('Enter at least two holdings with a value and a target weight.', '至少填入两个持仓的价值和目标权重。') }}</p>
  <dl class="co-rows" id="out-list"></dl>
  <div class="prc-foot" id="out-foot" hidden>
    <div><span class="prc-flabel">{{ t('Portfolio total', '组合总值') }}</span><span class="prc-fval" id="out-total">—</span></div>
    <div><span class="prc-flabel">{{ t('Total to trade', '需交易总额') }}</span><span class="prc-fval" id="out-turnover">—</span></div>
  </div>
</div>

<div class="calc-actions">
  <button class="gbtn" id="copy-result" type="button">{{ t('Copy result', '复制结果') }}</button>
  <span class="copied" id="copied" role="status">{{ t('Copied', '已复制') }}</span>
</div>

<style>
  .prc-head, .prc-row{display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,.9fr); gap:10px; align-items:center;}
  .prc-head{padding:0 2px 2px;}
  .prc-hcol{font-family:var(--num); font-size:var(--fs-micro); letter-spacing:.06em; text-transform:uppercase; color:var(--ink-3);}
  .prc-hcol:not(:first-child){text-align:right;}
  .prc-row input{font-family:var(--num); font-size:16px; font-variant-numeric:tabular-nums;
    background:var(--tile); border:1px solid var(--hair-strong); border-radius:var(--r-md); color:var(--ink-1);
    padding:10px 12px; width:100%; outline:none; transition:border-color .16s,box-shadow .16s;}
  .prc-row input:focus{border-color:var(--link); box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 20%,transparent);}
  .prc-row input::placeholder{color:var(--ink-3); opacity:.7;}
  .prc-row .prc-name{font-family:var(--font-ui); text-align:left;}
  .prc-row .prc-val, .prc-row .prc-tgt{text-align:right;}
  .prc-foot{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px 20px;
    margin:16px 0 0; padding-top:14px; border-top:1px solid var(--hair);}
  .prc-foot > div{display:flex; flex-direction:column; gap:2px;}
  .prc-flabel{font-family:var(--num); font-size:var(--fs-label); color:var(--ink-3); letter-spacing:.04em; text-transform:uppercase;}
  .prc-fval{font-family:var(--num); font-variant-numeric:tabular-nums; font-size:var(--fs-num-lg); font-weight:800; color:var(--ink-1); line-height:1.1;}
  .co-rows dd.buy{color:var(--up);} .co-rows dd.sell{color:var(--down);}
  .co-rows .prc-sub{font-family:var(--font-ui); font-size:var(--fs-sm); font-weight:400; color:var(--ink-3); text-transform:none; letter-spacing:0;}
  @media (max-width:560px){
    .prc-head{display:none;}
    .prc-row{grid-template-columns:1fr 1fr; gap:8px;}
    .prc-row .prc-name{grid-column:1 / -1;}
  }
</style>
{% endblock %}

{% block article_body %}
<p>{{ t('Rebalancing trades are the gap between what each holding is worth <strong>now</strong> and what it <strong>should</strong> be worth at your target weight. Add up every holding (plus any new cash), multiply that total by each target weight to get a dollar goal, and the difference from today’s value is your buy or sell. Positions that have run ahead get trimmed; positions that have lagged get topped up.',
   '再平衡交易，就是每个持仓<strong>现在</strong>的价值与它按目标权重<strong>应有</strong>价值之间的差额。把所有持仓（加上新增现金）相加得到总值，用总值乘以每个目标权重得到金额目标，与今天价值的差就是该买还是该卖。涨过头的持仓被减仓，落后的持仓被补仓。') }}</p>

<h2 id="formula"><span class="est-h2-mark">01</span>{{ t('The formula', '公式') }}</h2>
<div class="formula">
{{ t('<strong>Total</strong> = Σ current values + new cash', '<strong>总值</strong> = Σ 当前价值 + 新增现金') }}<br>
{{ t('<strong>Target value</strong> = Total × Target% ÷ 100', '<strong>目标价值</strong> = 总值 × 目标% ÷ 100') }}<br>
{{ t('<strong>Action</strong> = Target value − Current value', '<strong>操作金额</strong> = 目标价值 − 当前价值') }}<br>
{{ t('Positive = buy · Negative = sell', '正值 = 买入 · 负值 = 卖出') }}<br>
{{ t('<strong>Drift</strong> = Current% − Target%', '<strong>偏移</strong> = 当前% − 目标%') }}
</div>
<p>{{ t('Drift is how far a holding has wandered from its target weight — the number that tells you <em>why</em> a trade is needed. A holding at 60% of the book against a 50% target has drifted +10 points; the sell brings it home. Target weights should add up to 100%; if they don’t, the tool flags it rather than quietly assuming the rest is cash.',
   '偏移衡量一个持仓离目标权重漂移了多远——它告诉你<em>为什么</em>需要这笔交易。一个占组合 60%、目标为 50% 的持仓，偏移了 +10 个百分点；卖出把它拉回原位。目标权重应加总为 100%；若不满足，工具会提示，而不会默默假设其余是现金。') }}</p>

<h2 id="worked"><span class="est-h2-mark">02</span>{{ t('A worked example', '一个算例') }}</h2>
<div class="worked">
<span class="co-h">{{ t('Worked example', '算例') }}</span>
<p>{{ t('Suppose a trader holds <span class="num">$6,000</span> of A and <span class="num">$4,000</span> of B, and wants each at <span class="num">50%</span>. No new cash is added.',
   '假设一位交易者持有 <span class="num">$6,000</span> 的 A 和 <span class="num">$4,000</span> 的 B，希望两者各占 <span class="num">50%</span>，且不投入新增现金。') }}</p>
<ul>
<li>{{ t('Total = <span class="num">6,000 + 4,000 = $10,000</span>', '总值 = <span class="num">6,000 + 4,000 = $10,000</span>') }}</li>
<li>{{ t('A target value = <span class="num">10,000 × 50 ÷ 100 = $5,000</span>; action = <span class="num">5,000 − 6,000 = −$1,000</span> → sell $1,000',
   'A 目标价值 = <span class="num">10,000 × 50 ÷ 100 = $5,000</span>；操作 = <span class="num">5,000 − 6,000 = −$1,000</span> → 卖出 $1,000') }}</li>
<li>{{ t('B target value = <span class="num">$5,000</span>; action = <span class="num">5,000 − 4,000 = +$1,000</span> → buy $1,000',
   'B 目标价值 = <span class="num">$5,000</span>；操作 = <span class="num">5,000 − 4,000 = +$1,000</span> → 买入 $1,000') }}</li>
<li>{{ t('A had drifted to <span class="num">60%</span> (+10), B to <span class="num">40%</span> (−10). Selling $1,000 of A and buying $1,000 of B lands both at 50/50.',
   'A 已漂移至 <span class="num">60%</span>（+10），B 至 <span class="num">40%</span>（−10）。卖出 $1,000 的 A、买入 $1,000 的 B，两者回到 50/50。') }}</li>
</ul>
</div>
<p>{{ t('Notice the trades net to zero here because no cash was added — every dollar sold funds a dollar bought. When you add new cash, the tool can often reach the targets by buying only, with no sells at all: fresh money flows first to the most underweight holdings.',
   '注意这里的买卖净额为零，因为没有投入现金——每卖出一元都用于买入一元。当你投入新增现金时，工具往往可以只靠买入达到目标、完全无需卖出：新钱会优先流向最被低配的持仓。') }}</p>

<h2 id="trap"><span class="est-h2-mark">03</span>{{ t('The common trap', '常见陷阱') }}</h2>
<div class="callout warn">
<span class="co-h">{{ t('Rebalancing too often, and ignoring the cost', '再平衡过于频繁，且忽视成本') }}</span>
<p>{{ t('Every rebalance is a real transaction — it can trigger commissions, bid-ask spreads, and, in a taxable account, capital-gains tax on the winners you trim. Chasing an exact target after every small wiggle can quietly cost more than the drift it corrects. Many long-term portfolios rebalance on a schedule (say, once or twice a year) or only when a holding drifts past a set band (for example ±5 points), not on every fluctuation. This tool shows the trades; whether the drift is worth acting on is a separate judgment about cost and taxes.',
   '每一次再平衡都是一笔真实交易——可能产生佣金、买卖价差，在应税账户中还会对减仓的盈利部分征收资本利得税。每有小幅波动就去追求精确目标，其代价可能悄然超过它所纠正的偏移。许多长期组合按固定周期再平衡（比如每年一到两次），或只在持仓偏移超出设定区间（例如 ±5 个百分点）时才动手，而非每次波动都调整。本工具展示交易金额；这点偏移是否值得动手，是关于成本与税务的另一重判断。') }}</p>
</div>

<h2 id="limits"><span class="est-h2-mark">04</span>{{ t('Where this breaks', '它的局限') }}</h2>
<p>{{ t('The math splits a total cleanly into target slices. It does not know the frictions of moving real money. A few honest limits:',
   '这套算法能把一个总值干净地切成目标份额，但它并不了解真实资金流动中的摩擦。几点诚实的局限：') }}</p>
<ul>
<li>{{ t('<strong>Whole shares and lot sizes.</strong> A $1,000 buy of a $340 stock isn’t exactly three shares. Real orders round to whole shares (or fixed lots), so you’ll land near the target dollar amount, not precisely on it.',
   '<strong>整股与最小交易单位。</strong>用 $1,000 买一只 $340 的股票并不正好是三股。真实下单要取整到整股（或固定手数），因此你只能落在接近目标的金额附近，而非精确命中。') }}</li>
<li>{{ t('<strong>Taxes and costs aren’t modeled.</strong> The action amounts are pre-tax and pre-fee. In a taxable account, selling a winner to rebalance can realize a gain; weigh that before trimming.',
   '<strong>未计入税费。</strong>操作金额是税前、费前的。在应税账户中，为再平衡而卖出盈利持仓可能实现应税收益；减仓前请权衡这一点。') }}</li>
<li>{{ t('<strong>Target weights, not a view.</strong> This tool executes the weights you type — it takes no position on <em>whether</em> those weights are wise. Deciding the target allocation is the harder, prior question.',
   '<strong>只是目标权重，而非观点。</strong>本工具执行你填入的权重——它不评判这些权重<em>是否</em>明智。决定目标配置本身，是更难、更靠前的一步。') }}</li>
</ul>

<div class="callout key">
<span class="co-h">{{ t('The one line to remember', '记住这一句') }}</span>
<p>{{ t('Rebalancing sells what has grown and buys what has lagged — a discipline, not a forecast. The trades are simple; the judgment is when they’re worth the cost.',
   '再平衡卖出涨多的、买入落后的——这是一种纪律，而非预测。交易本身很简单；难的是判断何时值得为之付出成本。') }}</p>
</div>

<p class="mut" style="font-family:var(--font-ui); font-size:13.5px;">{{ t('Size each new buy with the <a href="' ~ rel ~ 'tools/calculators/position-size.html">position size calculator</a>, or read the lesson on <a href="' ~ rel ~ 'learn/risk/position-sizing.html">position sizing</a>.',
   '用 <a href="' ~ rel ~ 'tools/calculators/position-size.html">仓位计算器</a>为每笔新买入定仓，或阅读关于 <a href="' ~ rel ~ 'learn/risk/position-sizing.html">仓位管理</a> 的课程。') }}</p>
{% endblock %}

{% block calc_script %}
<script>
(function(){
  "use strict";

  // ── pure compute (CONTRACT §7-style — do not re-derive) ────────────────────
  // inputs: { holdings:[{name, value, target}], newCash }.
  // total = Σvalue + newCash; per holding target$ = total*target/100;
  // action = target$ - value (>0 buy, <0 sell); currentPct = 100*value/Σvalue;
  // drift = currentPct - target. Returns outputs object or {ok:false,msg}.
  // Never returns NaN/Infinity.
  function compute(inp){
    var raw = (inp.holdings || []).filter(function(h){ return h && (h.value>0) && (h.target>0); });
    if(raw.length < 2) return {ok:false, msg:"Enter at least two holdings, each with a value and a target weight."};
    var newCash = (inp.newCash>0) ? inp.newCash : 0;
    var sumVal = 0, sumTgt = 0, i;
    for(i=0;i<raw.length;i++){ sumVal += raw[i].value; sumTgt += raw[i].target; }
    if(!(sumVal>0)) return {ok:false, msg:"Enter a current value above zero for at least two holdings."};
    var total = sumVal + newCash;
    var rows = [], turnover = 0;
    for(i=0;i<raw.length;i++){
      var h = raw[i];
      var targetVal = total * h.target / 100;
      var action = targetVal - h.value;           // >0 buy, <0 sell
      var currentPct = 100 * h.value / sumVal;
      var drift = currentPct - h.target;
      turnover += Math.abs(action);
      rows.push({
        name: h.name || ("#" + (i+1)),
        value: h.value, target: h.target,
        targetVal: targetVal, action: action,
        side: action > 0.005 ? "buy" : (action < -0.005 ? "sell" : "hold"),
        currentPct: currentPct, drift: drift
      });
    }
    var targetsOff = Math.abs(sumTgt - 100) > 0.5;
    return {
      ok:true, rows:rows, total:total, sumVal:sumVal, newCash:newCash,
      sumTargets:sumTgt, targetsOff:targetsOff, turnover:turnover
    };
  }

  // ── §6 self-check: run the canonical fixtures on load, console.error on drift ─
  var WORKED_EXAMPLES = [
    // A $6,000 t50, B $4,000 t50, no cash → sell $1,000 A, buy $1,000 B; total 10,000
    { in:{ holdings:[{name:"A",value:6000,target:50},{name:"B",value:4000,target:50}], newCash:0 },
      want:{ total:10000, action0:-1000, action1:1000, turnover:2000 } },
    // add $2,000 cash → total 12,000, each target 6,000; A buy 0, B buy 2,000
    { in:{ holdings:[{name:"A",value:6000,target:50},{name:"B",value:4000,target:50}], newCash:2000 },
      want:{ total:12000, action0:0, action1:2000, turnover:2000 } }
  ];
  (function selfCheck(){
    WORKED_EXAMPLES.forEach(function(ex, idx){
      var got = compute(ex.in), w = ex.want;
      if(!got.ok){ console.error("portfolio-rebalancing self-check "+idx+": compute failed", got); return; }
      var checks = {
        total: got.total, action0: got.rows[0].action, action1: got.rows[1].action, turnover: got.turnover
      };
      for(var k in w){ if(Math.abs(checks[k] - w[k]) > 0.5){
        console.error("portfolio-rebalancing self-check "+idx+" mismatch on "+k+": got "+checks[k]+" want "+w[k]); } }
    });
  })();

  // ── DOM wiring (all reads/writes here; compute stays pure) ─────────────────
  document.addEventListener("DOMContentLoaded", function(){
    var $ = function(id){ return document.getElementById(id); };
    var names = [].slice.call(document.querySelectorAll(".prc-name"));
    var vals  = [].slice.call(document.querySelectorAll(".prc-val"));
    var tgts  = [].slice.call(document.querySelectorAll(".prc-tgt"));
    var cashEl = $("newcash");
    var outMain=$("out-main"), outPlain=$("out-plain"), outList=$("out-list"),
        outFoot=$("out-foot"), outTotal=$("out-total"), outTurn=$("out-turnover"),
        copyBtn=$("copy-result"), copied=$("copied");

    function numFrom(el){ var v=parseFloat((el.value||"").replace(/,/g,"").trim()); return isFinite(v)?v:NaN; }
    function money0(n){ return "$" + Math.round(n).toLocaleString("en-US"); }
    function money2(n){ return "$" + n.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function readHoldings(){
      var out=[];
      for(var i=0;i<vals.length;i++){
        out.push({ name:(names[i] && names[i].value ? names[i].value.trim() : ""),
                   value:numFrom(vals[i]), target:numFrom(tgts[i]) });
      }
      return out;
    }

    var last=null;
    function render(){
      var inp={ holdings:readHoldings(), newCash:numFrom(cashEl) };
      var res=compute(inp); last=res;
      if(!res.ok){
        outMain.textContent="—";
        outPlain.textContent=res.msg; outPlain.className="co-plain";
        outList.innerHTML=""; outFoot.hidden=true;
        return;
      }

      // per-holding rows
      outList.innerHTML="";
      res.rows.forEach(function(r){
        var div=document.createElement("div");
        var dt=document.createElement("dt");
        dt.textContent=r.name;
        var dd=document.createElement("dd");
        if(r.side==="hold"){ dd.textContent="Hold"; }
        else {
          dd.textContent=(r.side==="buy"?"Buy ":"Sell ")+money0(Math.abs(r.action));
          dd.className=r.side;
        }
        var sub=document.createElement("span");
        sub.className="prc-sub";
        var driftTxt=(r.drift>=0?"+":"")+r.drift.toFixed(r.drift===0?0:1);
        sub.textContent=" · "+r.currentPct.toFixed(0)+"% now vs "+r.target.toFixed(r.target%1?1:0)+"% target ("+driftTxt+")";
        dd.appendChild(sub);
        div.appendChild(dt); div.appendChild(dd);
        outList.appendChild(div);
      });

      // headline sentence in #out-main (this calc's co-main is a sentence)
      var moves = res.rows.filter(function(r){ return r.side!=="hold"; })
        .sort(function(a,b){ return Math.abs(b.action)-Math.abs(a.action); });
      var lead;
      if(!moves.length){
        lead = "Already on target — no trades needed.";
      } else {
        var parts = moves.slice(0,3).map(function(r){
          return (r.side==="buy"?"buy ":"sell ")+money0(Math.abs(r.action))+" "+r.name;
        });
        lead = parts.join(", ");
        if(moves.length>3) lead += ", …";
        lead = lead.charAt(0).toUpperCase()+lead.slice(1);
        lead += ".";
      }
      outMain.textContent = lead;

      // Law 3: plain-word interpretation
      var plain;
      if(!moves.length){
        plain = "Every holding already sits at its target weight, so nothing needs to be traded.";
      } else {
        plain = "These trades move each holding to its target weight, turning over "
          + money0(res.turnover) + " across the portfolio.";
        if(res.newCash>0) plain += " Your new cash is put to work first.";
      }
      if(res.targetsOff){
        plain = "Heads up: your target weights add to " + res.sumTargets.toFixed(res.sumTargets%1?1:0)
          + "%, not 100% — the rest is treated as staying uninvested. " + plain;
        outPlain.className="co-plain warn";
      } else {
        outPlain.className="co-plain";
      }
      outPlain.textContent = plain;

      outTotal.textContent = money2(res.total);
      outTurn.textContent  = money2(res.turnover);
      outFoot.hidden=false;
    }

    function copyLine(){
      if(!last || !last.ok) return "";
      var moves=last.rows.filter(function(r){return r.side!=="hold";})
        .sort(function(a,b){return Math.abs(b.action)-Math.abs(a.action);});
      if(!moves.length) return "Portfolio rebalancing: already on target — no trades needed. — mastermind-x.com";
      var parts=moves.map(function(r){
        return (r.side==="buy"?"Buy ":"Sell ")+money0(Math.abs(r.action))+" "+r.name;
      });
      return "Rebalance: " + parts.join(" · ")
        + " · turnover " + money0(last.turnover)
        + " (total " + money0(last.total) + ") — mastermind-x.com";
    }
    copyBtn.addEventListener("click", function(){
      var line=copyLine(); if(!line) return;
      var done=function(){ copied.classList.add("show"); setTimeout(function(){copied.classList.remove("show");},1600); };
      if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(line).then(done,done); }
      else { var ta=document.createElement("textarea"); ta.value=line; document.body.appendChild(ta); ta.select();
        try{document.execCommand("copy");}catch(e){} document.body.removeChild(ta); done(); }
    });

    names.concat(vals).concat(tgts).concat([cashEl]).forEach(function(el){
      el.addEventListener("input", render);
    });
    render();
  });
})();
</script>
{% endblock %}
