      {% endif %}
    </div>
    {% if TR.status != 'scored' %}
    {# ACCRUING — the honest, intentional pre-grade state. Every render logs the ranked
       board with its as-of close; forward excess vs the HSI grades it at 21d / 63d. #}
    <p class="tr-lead">{{ t('The board is being tracked in public. Scores appear once enough 21d and 63d results land.', '看板正在公开跟踪。等21日与63日结果足够后自动显示分数。') }}</p>
    <div class="tr-timeline">
      <div class="tr-step ts-now">
        <div class="ts-k">{{ t('Accruing since', '开始累积') }}</div>
        <div class="ts-v">{{ TR.first_write or '2026-07-03' }}</div>
        <div class="ts-sub">{{ TR.n_calls }} {{ t('board calls logged', '看板结论已记录') }}{% if TR.n_graded %} · {{ TR.n_graded }} {{ t('graded', '已评分') }}{% endif %}</div>
      </div>
      {% if TR.first_21d_read %}
      <div class="tr-step">
        <div class="ts-k">{{ t('First 21-day read', '首次21日读数') }}</div>
        <div class="ts-v">≈ {{ TR.first_21d_read }}</div>
        <div class="ts-sub">{{ t('first single matured cross-section', '首个成熟横截面') }}</div>
      </div>
      {% endif %}
      {% if TR.first_stable_read %}
      <div class="tr-step">
        <div class="ts-k">{{ t('Stable rank-IC read', '稳定排名IC读数') }}</div>
        <div class="ts-v">≈ {{ TR.first_stable_read }}</div>
        <div class="ts-sub">{{ t('≥5 matured dates (late-Aug)', '≥5个成熟日期（8月下旬）') }}</div>
      </div>
      {% endif %}
    </div>
    <p class="tr-foot">{{ t('Hit-rate shows how often calls beat the Hang Seng. Rank-IC checks whether higher ranks did better. Delisted-name losses may be missing.', '命中率显示结论跑赢恒指的频率。排名IC检查高排名是否表现更好。退市亏损可能缺失。') }}</p>
    {% else %}
    {# SCORED — the gate cleared. Per-horizon rank-IC + per-group hit-rates. #}
    <p class="tr-lead">{{ t('Enough history has landed. The board is now graded in public.', '历史数据已足够。看板开始公开评分。') }}</p>
    {% if TR.horizons %}
    <table class="tr-tbl">
      <thead><tr>
        <th>{{ t('Horizon', '周期') }}</th><th>{{ t('n graded', 'n 已评分') }}</th>
        <th>{{ t('rank-IC', '排名IC') }}</th><th>{{ t('IC dates', 'IC日期数') }}</th>
        <th>{{ t('buy hit-rate', '买入命中率') }}</th>
      </tr></thead>
