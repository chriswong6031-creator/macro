          {% endif %}
          <div class="ww-meta">
            {% if w.rsi is not none %}RSI {{ '%.0f'|format(w.rsi) }}{% endif %}
            {% if w.dist_200dma is not none %} · {{ '%+.0f'|format(w.dist_200dma * 100) }}% 200dma{% endif %}
            {% if w.price is not none %} · {{ '%.2f'|format(w.price) }}{% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="ww-empty"><span class="l-en">No washout candidates with confluence signals today.</span><span class="l-zh">今日无共振点火候选股。</span></div>
