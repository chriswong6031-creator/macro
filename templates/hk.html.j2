            {% endfor %}
          </div>
        </div>
        {% endif %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Sector heatmap · biggest names','板块热力图 · 龙头个股') }}</div>
        <div id="hk-hm-embed"></div>
        <div class="hkx-receipt">{{ t('Cross-market strip: HK dollar, offshore yuan, HK interest rate, US dollar, gold, fear gauge.','跨市场条：港元、离岸人民币、香港利率、美元、黄金、恐慌指数。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-sentiment: Mood & Fear #}
  <div class="hkx-dlg" id="hkx-dlg-sentiment">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('Mood & Fear — what\'s inside','市场情绪 — 详细内容') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('A single fear-to-greed score built from 8 different market signals, plus Hong Kong\'s own fear gauge (the VHSI — like America\'s VIX).','由8个不同市场信号构成的单一恐慌-贪婪评分，加上香港自身的恐慌指数（VHSI — 类似美国的VIX）。') }}</div>
