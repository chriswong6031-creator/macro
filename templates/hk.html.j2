  <!-- ===================== WHAT TO ACT ON NOW (sector entry-timing board) ===================== -->
  {% if actions and (actions.buy_now or actions.buy_soon or actions.get('on_the_run') or actions.take_profits or actions.hold or actions.avoid) %}
  <style>
  .act-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .act-col { background: var(--panel2); border: 1px solid var(--line); border-radius: 9px; padding: 9px 11px; }
  .act-col h3 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 6px; }
  .act-item { font-size: 12.5px; padding: 3px 0; border-bottom: 1px solid var(--line); }
  .act-item:last-child { border-bottom: none; }
  .act-item .an { font-weight: 600; color: var(--text); }
  .act-item .at { font-size: 10.5px; color: var(--muted); }
  .act-now h3 { color: var(--up); } .act-soon h3 { color: var(--info); }
  .act-run h3 { color: #8b5cf6; }   /* neutral violet — NOT green/buy */
  .act-tp h3 { color: var(--warn); } .act-avoid h3 { color: var(--down); } .act-hold h3 { color: var(--muted); }
  </style>
  <div class="panel span12" id="act-now">
    <h2>⚡ {{ t('What to act on now — sectors', '当前可操作 — 板块') }}
      {{ help("The HK sector groups bucketed by the cycle ladder’s entry-timing call — the same engine as the US action board. A structure / risk map, not an allocation rule: ON THE RUN = in favour but extended (do not chase; add on a pullback); the reduce side (take profits / avoid) is the risk read. HK has no validated single-stock edge — this is sector positioning.", "香港板块按周期阶梯的入场时机分桶 — 与美国操作板同一引擎。这是结构／风险图，而非配置规则：顺势运行 = 看好但已延伸（勿追高；回调加仓）；减仓侧（止盈／回避）是风险判读。香港无经验证的个股优势 — 这是板块定位。") }}
    </h2>
    <div class="act-grid">
      {% macro sactcol(cls, title_en, title_zh, items) %}
      {% if items %}
      <div class="act-col {{ cls }}">
        <h3>{{ t(title_en, title_zh) }} · {{ items|length }}</h3>
        {% for it in items %}
        <div class="act-item"><a class="an" href="sectors/{{ it.ticker }}.html">{{ td(it.name) }}</a>
          <div class="at">{{ td(it.label) }}{% if it.days is not none %} · ~{{ it.days }}{{ t('d', '天') }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% endmacro %}
      {{ sactcol('act-now', 'Buy zone', '买入区', actions.buy_now) }}
      {{ sactcol('act-soon', 'Setting up', '即将到位', actions.buy_soon) }}
      {{ sactcol('act-run', "ON THE RUN — don't chase", '顺势运行 — 勿追高', actions.get('on_the_run', [])) }}
      {{ sactcol('act-tp', 'Take profits', '止盈', actions.take_profits) }}
      {{ sactcol('act-hold', 'Hold', '持有', actions.hold) }}
      {{ sactcol('act-avoid', 'Avoid', '回避', actions.avoid) }}
    </div>
  </div>
  {% endif %}
  {% endif %}

  <!-- ===================== STANDOUT STOCKS (relative-strength cards) ===================== -->
  {% if mode == 'stocks' and setups and setups.health %}
  {# HEALTH BANNER (§5.5) — every degraded leg this render (tailwind suppressed,
     southbound store stale, ledger write failed). Kills silent fail-open. Bilingual. #}
  <div class="panel span12 health-banner">
    <p class="hb-h">⚠ {{ t('Data health — degraded legs this render', '数据健康 —— 本次渲染的降级项') }}</p>
    <ul class="hb-list">
      {% for h in setups.health %}
      <li class="hb-item hb-{{ h.leg }}"><span class="l-en">{{ h.en }}</span><span class="l-zh">{{ h.zh }}</span></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if mode == 'stocks' and setups and setups.buy %}
  <div class="panel span12" id="standouts">
    <h2>{{ t('⚡ Top conviction — the HK Stock Desk', '⚡ 最高确信 — 港股研判台') }}
      <span class="note" style="text-transform:none">· {{ t('cycle-aligned bottoming · southbound flow + A/H value + beta-neutral RS', '周期共振筑底 · 南向资金 + A/H 价值 + 贝塔中性相对强度') }}</span>
      {{ help("Shows HK names whose weekly, 3-day and daily cycles are turning up, then ranks them by flow, A/H value and beta-neutral strength.", "显示周线、3日、日线开始转上的港股，再按资金流、A/H 价值与贝塔中性强度排序。") }}
    </h2>
    {# THE ONE board-note (§7.2). Board mechanics only — the "screen, not a buy list" caveat
       lives once in the desk manifest above + the per-card tier badge. #}
    <p class="note" style="margin:0 0 2px;text-transform:none">{{ t('Aligned names first; near-aligned names are backfills. Rank is a screen, not a promise.', '共振个股优先；临近共振为补位。排名是筛选，不是承诺。') }}</p>
    <div class="nbgrid" data-showmore-rows="3">
    {% for n in setups.buy %}
      {% set _d = n.dir or 'caution' %}
      {% set c = n.conviction %}
      {# W6 tier-driven chrome (§7 item 1): the card accent is keyed to the ENTRY WINDOW
         state so the board feels ALIVE — open-now warm, pullback cool, wait muted. #}
      {% set _ewk = (n.entry_window.kind if n.entry_window else none) %}
      {% set _ewcls = 'ew-open-now' if _ewk == 'open-now' else ('ew-pullback' if _ewk == 'pullback' else ('ew-wait' if _ewk else '')) %}
      <a class="nbcard nb-{{ _d }}{% if _ewcls %} {{ _ewcls }}{% endif %}" href="hk_lookup.html#{{ n.ticker }}">
        <div class="nb-top">
          <span class="nb-tk">{{ n.ticker }}</span>
          <span class="nb-nm">{{ n.name }}</span>
          {% if n.price is not none %}<span class="nb-px" data-sym="{{ n.ticker }}" data-mkt="hk">{{ '%.2f'|format(n.price) }}</span>{% endif %}
        </div>
        <div class="nb-sub">{% if n.sector %}<span>{{ t(n.sector, n.sector_zh or n.sector) }}</span>{% endif %}{% if n.off_high is not none %}<span>{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}</div>
        {% if n.spark_svg %}{{ n.spark_svg | safe }}{% endif %}
        {# RIPE-LIST CARD LEAD (§7.1) — one plain-English mechanism-first sentence,
           assembled in the builder from the fresh flow/value/alignment state + the
           derived entry window. Additive; leads the card body, replacing nothing. #}
        {% if n.lead %}
        <div class="nb-lead"><span class="l-en">{{ n.lead.en }}</span><span class="l-zh">{{ n.lead.zh }}</span></div>
        {% endif %}
        {% if n.group or n.entry_window %}
        <div class="nb-ripe">
          {% if n.group %}<span class="nb-grp grp-{{ 'open' if n.group == 'entry_open' else 'set' }}">{{ t('Entry open', '入场开启') if n.group == 'entry_open' else t('Setting up', '蓄势中') }}</span>{% endif %}
          {% if n.entry_window and n.entry_window.kind %}<span class="nb-ewin ew-{{ n.entry_window.kind }}"><span class="l-en">{{ n.entry_window.en }}</span><span class="l-zh">{{ n.entry_window.zh }}</span></span>{% endif %}
          {% if n.washout_2w %}<span class="nb-port pt-wash" data-tip-en="Higher-timeframe oversold bounce. Context only." data-tip-zh="高周期超卖反弹。仅背景。">{{ t('2W washout', '2周超卖') }}<span class="ev-tag et-accruing">{{ t('accruing', '累积') }}</span></span>{% endif %}
          {% if n.extended %}<span class="nb-port pt-ext" data-tip-en="Stretched above its 200-day trend. Context only." data-tip-zh="高于200日趋势。仅背景。">{{ t('extended', '过热') }}<span class="ev-tag et-context">{{ t('context', '背景') }}</span></span>{% endif %}
        </div>
        {% endif %}
        {% if c %}
        <div class="nb-conv">
          {% if c.score is not none %}<span class="nb-cscore band-{{ c.band }}" data-tip-en="Edge percentile. Not a probability." data-tip-zh="优势百分位。不是概率。">{{ c.score }}</span>{% endif %}
          <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
        </div>
        {% set al = c.alignment %}
        {% if al and al.line %}
        {# multi-timeframe ENTRY gate (engine.cycles.mtf_alignment): a low-risk SWING entry
           must be a FRESH turn from a low — weekly bear-recovering/basing + 3-day cross from
           oversold (<25) + daily just-crossed. 🟢 Prime/Armed = confirmed; 🟡 Approaching =
           early backfill (not yet a buy). The reason states WHY it qualifies. #}
        <div class="nb-align{{ ' nba-near' if n.align_tier == 'near' else '' }}" data-tip-en="{{ al.line }}" data-tip-zh="{{ al.line_zh }}">
          <span class="nba-mark">{{ '🟡' if n.align_tier == 'near' else '🟢' }}</span>
          <span class="nba-line"><span class="l-en">{{ al.reason or al.line }}</span><span class="l-zh">{{ al.reason_zh or al.line_zh }}</span></span>
          {% if al.entry_tier %}<span class="nba-tag">{{ t(al.entry_tier, al.entry_tier_zh) }}</span>{% endif %}
        </div>
        {% endif %}
        <div class="nb-axes">
          {% for ax, lbl, lbl_zh in [('selection','EDGE','优势'),('entry','ENT','入场'),('tailwind','TWD','顺风'),('quality','QUAL','质量')] %}
          {% set a = c.axes[ax] %}
          <div class="nb-ax{{ ' ax-na' if a.pct is none else '' }}" title="{{ lbl }}{% if a.pct is not none %} {{ a.pct }}/100{% else %} — no data{% endif %}">
            <div class="axl">{{ t(lbl, lbl_zh) }}</div>
            <div class="axt"><div class="axf" style="width:{{ a.pct if a.pct is not none else 0 }}%"></div></div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% set es = n.entry_signal %}
        {% if es and es.status %}
        {# ENTRY-timing gauge (US-parity gauge 2): buy now / wait for the pullback / extended,
           with the buy-zone price. Compact HK skin — the WHEN/AT-WHAT-PRICE the conviction
           score must never be mistaken for. #}
        <div class="nb-entry nbe-{{ es.status }}" data-tip-en="Entry timing and price zone." data-tip-zh="入场时机与价格区间。">
          <span class="nbe-dot a{{ es.act_level }}"></span>
          <span class="nbe-status"><span class="l-en">{{ es.headline }}</span><span class="l-zh">{{ es.headline_zh }}</span></span>
          {% if es.buy_zone and es.buy_zone.high is not none %}
          <span class="nbe-zone" data-tip-en="Buy zone" data-tip-zh="买入区">{{ '%.2f'|format(es.buy_zone.low) }}{% if es.buy_zone.high != es.buy_zone.low %}–{{ '%.2f'|format(es.buy_zone.high) }}{% endif %}{% if es.buy_zone.pct_from_spot is not none %} ({{ '%+.1f'|format(es.buy_zone.pct_from_spot) }}%){% endif %}</span>
          {% endif %}
        </div>
        {% endif %}
        <div class="nb-bot">
          {% if n.label %}<span class="nb-state">{{ td(n.label) }}</span>{% endif %}
          {% set _rs = n.risk_sizing %}{% if _rs and _rs.size_mult is not none %}<span class="nb-size {{ 'sz-up' if _rs.size_mult >= 1.1 else ('sz-dn' if _rs.size_mult <= 0.9 else '') }}" data-tip-en="Suggested size: less for volatile names, more for calmer names." data-tip-zh="建议仓位：波动大少配，波动小多配。">⚖ {{ '%.2f'|format(_rs.size_mult) }}×</span>{% endif %}
        </div>
        {% if n.alpha is not none or n.alpha_entry %}
        <div class="nb-alpha">
          {% if n.alpha is not none %}<span class="nb-az {{ 'az-up' if n.alpha>0 else ('az-dn' if n.alpha<0 else '') }}" data-tip-en="Relative strength vs the HK universe." data-tip-zh="相对港股整体的强弱。">RS {{ '%+.2f'|format(n.alpha) }}</span>{% endif %}
          {% if n.sector_rank %}<span class="nb-rk" data-tip-en="Rank within its sector by relative strength" data-tip-zh="按相对强度在其板块内排名">#{{ n.sector_rank }}/{{ n.sector_n }}</span>{% endif %}
          {% if n.alpha_entry == 'pullback' %}<span class="nb-ent ent-good" data-tip-en="A leader that has cooled off (RSI≤55) — a less-stretched entry" data-tip-zh="已回落的强势股（RSI≤55）— 较不过热的入场">{{ t('pullback', '回调') }}</span>
          {% elif n.alpha_entry == 'extended' %}<span class="nb-ent ent-warn" data-tip-en="Stretched (RSI≥70) — short-term reversal risk" data-tip-zh="过热（RSI≥70）— 短线反转风险">{{ t('extended', '过热') }}</span>{% endif %}
        </div>
        {% endif %}
        {% if n.southbound or n.ah_value %}
        <div class="nb-flow">
          {# W6 evidence tags (§7.3): each why-now chip carries an et-validated / et-accruing / et-context
             colour-coding + a tooltip citing its phase-0 report. A/H = the near-GO (DSR 0.879)
             → visual priority via fl-lead. SB flow decays at render lag (H1 NO-GO) → context. #}
          {% if n.southbound and n.southbound.accum_z is not none %}
          {% set sbz = n.southbound.accum_z %}
          <span class="{{ 'fl-buy' if sbz>=0.6 else ('fl-sell' if sbz<=-0.6 else '') }}" data-tip-en="Mainland Connect is adding or trimming this name. Positioning context." data-tip-zh="内地港股通正在加仓或减仓该股。持仓背景。">🇨🇳 {{ t('SB', '南向') }} {{ '%+.1f'|format(sbz) }}{% if n.southbound.own_pct is not none %} · {{ n.southbound.own_pct }}%{% endif %}<span class="ev-tag et-context">{{ t('context', '背景') }}</span></span>
          {% endif %}
          {% if n.ah_value and n.ah_value.z is not none %}
          <span class="fl-val{{ ' fl-lead' if n.ah_value.cheap else '' }}" data-tip-en="A/H value: H-share looks cheap or rich vs its mainland A-share twin." data-tip-zh="A/H 价值：H股相对A股孪生便宜或偏贵。">A/H {{ '%+.1f'|format(n.ah_value.z) }}{% if n.ah_value.cheap %} · {{ t('cheap H', 'H 便宜') }}{% endif %}<span class="ev-tag et-accruing">{{ t('near-GO', '临近达标') }}</span></span>
          {% endif %}
          {# SFC reportable-short CONTEXT chip (H2a — ACCRUE-labelled, reports/h2a-phase0.md).
             own-history days-to-cover percentile; correct-signed (high shorts -> softer fwd
             returns) but sub-threshold (DSR 0.32), so it is CONTEXT, never a rank input. #}
          {% if n.sfc_short and n.sfc_short.pctile is not none %}
          <span class="{{ 'fl-short' if n.sfc_short.pctile >= 75 else '' }}" data-tip-en="Short interest level vs this name's own history. Context only." data-tip-zh="淡仓相对该股自身历史的位置。仅背景。">🩳 {{ t('shorts', '淡仓') }} P{{ n.sfc_short.pctile }}<span class="ev-tag et-accruing">{{ t('accruing', '累积') }}</span></span>
          {% endif %}
        </div>
        {% endif %}
        {% if c %}
        {# volatility black hole (vol_squeeze) chip #}
        {% set _vs = c.vol_squeeze %}
        {% if _vs and _vs.state in ['COILED','FIRED_UP','FIRED_DOWN','EXPANSION'] %}
        <div class="nb-vf">
          <span class="nb-vchip {{ {'COILED':'vf-coil','FIRED_UP':'vf-up','FIRED_DOWN':'vf-down','EXPANSION':'vf-exp'}[_vs.state] }}" data-tip-en="{{ 'Volatility is compressed; a move may be setting up.' if _vs.state=='COILED' else 'Volatility has already expanded; quiet entry may be gone.' }}" data-tip-zh="{{ '波动压缩，可能在酝酿行情。' if _vs.state=='COILED' else '波动已扩张，安静入场点可能已过。' }}">{% if _vs.state=='COILED' %}🌀 {{ t('Move loading','蓄势待发') }}{% elif _vs.state=='FIRED_UP' %}🚀 {{ t('Firing↑','向上突破') }}{% elif _vs.state=='FIRED_DOWN' %}🔻 {{ t('Firing↓','向下突破') }}{% else %}💥 {{ t('Already moving','已在异动') }}{% endif %}</span>
        </div>{% endif %}
        {% if c.cautions %}<div class="nb-cau"><button class="nb-cau-btn" type="button" aria-label="Caution notes ({{ c.cautions|length }})"><span class="l-en">⚠ Caution</span><span class="l-zh">⚠ 注意</span><span class="nb-cau-badge">{{ c.cautions|length }}</span></button><div class="nb-cau-pop" role="tooltip">{% for cau in c.cautions %}<span class="cau-row"><span class="l-en">{{ cau }}</span><span class="l-zh">{{ c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau }}</span></span>{% endfor %}</div></div>{% endif %}
        {% if c.notes %}{% for nt in c.notes %}<div class="nb-note nb-note-{{ nt.kind }}"><span class="l-en">ℹ {{ nt.en }}</span><span class="l-zh">ℹ {{ nt.zh }}</span></div>{% endfor %}{% endif %}
        <div class="nb-tier"><span class="l-en">{{ c.trust_tier.en }}</span><span class="l-zh">{{ c.trust_tier.zh }}</span></div>
        {% endif %}
      </a>
    {% endfor %}
    </div>
    {% if setups.watch %}
    <div class="watch-strip">
      <p class="ws-h">👁 {{ t('On watch — strong edge, blocked entry (wait for a base)', '观察名单 — 优势强但入场受阻（等待筑底）') }}</p>
      <div class="watch-grid">
        {% for w in setups.watch %}
        {% set wc = w.conviction %}
        <a href="hk_lookup.html#{{ w.ticker }}" class="{{ 'wg-knife' if w.watch_reason == 'knife' else ('wg-plc' if w.watch_reason == 'placement' else '') }}" title="{{ wc.verdict if wc else '' }}">
          <span class="wg-tk">{{ w.ticker }} {% if wc and wc.score is not none %}<span class="note" style="font-weight:600">· {{ wc.score }}</span>{% endif %}</span>
          <span class="wg-v">{{ w.name }}{% if wc %} — <span class="l-en">{{ wc.verdict }}</span><span class="l-zh">{{ wc.verdict_zh }}</span>{% endif %}</span>
          {# FALLING-KNIFE reason chip (H4 phase-0 KILL — reports/h4-phase0.md). A deepest-
             quintile 3M loser pushed OUT of the entry groups: they keep falling, not rebound. #}
          {% if w.watch_reason == 'knife' %}
          <span class="wg-knife-chip" data-tip-en="Very weak 3-month trend. Held out until it turns." data-tip-zh="3个月趋势很弱。等待转向前排除。">
            <span class="l-en">🔻 very weak trend — wait</span>
            <span class="l-zh">🔻 趋势很弱 — 等待</span>
          </span>
          {% endif %}
          {# H-PLC placement/rights dilution chip (masterplan §3, W1c). A dilutive top-up
             placement / rights issue / open offer inside the trailing 90d window — fresh
             dilution + discounted-stock overhang; held OUT of the entry groups. Renders on
             any flagged watch name (incl. knife demotes carrying a placement stamp too). #}
          {% if w.placement_flag and w.placement_info %}
          <span class="wg-plc-chip" data-tip-en="Recent dilution. Held out for 90 days." data-tip-zh="近期摊薄。90天内排除。">
            <span class="l-en">💸 recent dilution — wait</span>
            <span class="l-zh">💸 近期摊薄 — 等待</span>
          </span>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% if setups.laggards %}
    <p class="note" style="margin:13px 0 5px;text-transform:none;color:var(--down);font-weight:700">⚠ {{ t('Weakest conviction (laggards) — distribution / avoid:', '确信度最弱（落后股）— 派发／回避：') }}</p>
    <p style="margin:0;line-height:2">
      {% for r in setups.laggards %}<a href="hk_lookup.html#{{ r.ticker }}" style="margin-right:14px;white-space:normal;overflow-wrap:anywhere"><b>{{ r.ticker }}</b> <span class="note">{{ r.name }}</span> <span class="neg">{{ '%+.2f'|format(r.alpha) }}</span></a>{% endfor %}
    </p>
    {% endif %}
  </div>
  {% endif %}
  {# ===== WASHOUT WATCH / 洗盘点火 ===== SEPARATE BLOCK — renders even when eligible:0 (the
     whole point: carve out names the main board hides in risk-off / decline phase).
     Condition: mode == 'stocks' AND setups exists. Renders with empty state when no candidates. #}
  {% if mode == 'stocks' and setups is not none %}
  <div class="panel span12" id="washout-watch">
    <h2>🔥 <span class="l-en">Washout Watch</span><span class="l-zh">洗盘点火</span>
      <span class="note" style="text-transform:none">· <span class="l-en">igniting · unconfirmed · high-risk / context</span><span class="l-zh">点火中 · 未确认 · 高风险 / 仅参考</span></span>
    </h2>
    {# ===== WASHOUT WATCH / 洗盘点火 — igniting · unconfirmed · high-risk ===== #}
    {# Renders even when eligible:0 (the whole point — names ignored by the main board). #}
    {% set _ww = setups.washout_watch if setups else none %}
    <div class="ww-strip">
      <p class="ww-h">{{ t('Deep-decline names with confluence ignition evidence', '深度回调个股共振点火证据') }}</p>
