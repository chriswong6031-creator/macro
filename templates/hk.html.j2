        <div class="hkx-kv"><span class="hkx-k">{{ t('Stocks above 50d MA','50日均线上方个股') }}</span><span class="hkx-v {{ 'hkx-up' if _lead.broad_breadth_pct >= 50 else 'hkx-dn' }}">{{ '%d'|format(_lead.broad_breadth_pct|int) }}%</span></div>
        {% if _lead.copy_en is defined and _lead.copy_en %}
        <p style="font-size:11.5px;color:var(--muted);margin:4px 0 0"><span class="l-en">{{ _lead.copy_en }}</span><span class="l-zh">{{ _lead.copy_zh if _lead.copy_zh is defined else _lead.copy_en }}</span></p>
        {% endif %}
        {% endif %}
        {% else %}
