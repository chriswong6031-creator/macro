  {# dlg-playbook: What To Do #}
  <div class="hkx-dlg" id="hkx-dlg-playbook">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('What To Do — the full playbook','操作建议 — 完整操盘手册') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('How to position for the current market, in plain steps — plus the sectors to favour and avoid, and where we are in the cycle.','用简明步骤说明当前市场的仓位思路 — 包括偏好和回避的板块，以及我们在周期中的位置。') }}</div>
