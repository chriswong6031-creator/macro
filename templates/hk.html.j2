    {%- set _ldr_members = _ldr.get('members') or [] -%}
    {%- set _ldr_n_above = (_ldr_members | selectattr('above_rising_ma10', 'equalto', true) | list | length) -%}
    {%- set _ldr_n_total = _ldr_members | length -%}
    {%- set _ldr_breadth = _ldr.get('broad_breadth_pct') -%}
    {%- set _ldr_study_n = _ldr.get('study_n') -%}
    {%- set _ldr_fwd = _ldr.get('study_hsi_fwd40_mean') -%}
    {%- set _ldr_coh_fwd = _ldr.get('study_cohort_fwd60_mean') -%}
    {%- set _ldr_confirming = _ldr.get('breadth_confirming') -%}
    <div class="hkrv-banner" id="hkrv-banner-a">
      <div class="hkrv-banner-top">
        <span class="hkrv-banner-icon">⚡</span>
        <div>
          <div class="hkrv-banner-title">
            {%- if _ldr_confirming -%}
            <span class="l-en">Broad market joining in</span><span class="l-zh">大盘跟进中</span>
            {%- else -%}
            <span class="l-en">Leaders moving first</span><span class="l-zh">龙头先行</span>
            {%- endif -%}
          </div>
          <div class="hkrv-banner-line">
            {%- if _ldr_confirming -%}
            <span class="l-en">Mega-caps are participating and broad breadth is now confirming.</span>
            <span class="l-zh">大型龙头正在参与，大盘广度正在同步确认。</span>
            {%- else -%}
            <span class="l-en">Mega-caps are participating; the broad market hasn't confirmed yet.</span>
            <span class="l-zh">大型龙头正在参与，大盘尚未确认。</span>
            {%- endif -%}
          </div>
        </div>
        <div class="hkrv-stance-chip">
          {%- if _ldr_confirming -%}
          <span class="l-en">Get ready</span><span class="l-zh">准备就绪</span>
          {%- else -%}
          <span class="l-en">Watch — don't chase</span><span class="l-zh">观察，勿追高</span>
          {%- endif -%}
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <button class="hkrv-why-toggle" type="button" onclick="(function(b){var p=document.getElementById('hkrv-pop-a');p.classList.toggle('hkrv-pop-open');b.textContent=p.classList.contains('hkrv-pop-open')?'▴ Why — close':'▾ Why — details';})(this)">&#9662; Why &#8212; details</button>
        <span style="font-size:11px;color:var(--muted)">
          <span class="l-en">{{ _ldr_n_above }} of {{ _ldr_n_total }} mega-caps above rising 10-day MA{% if _ldr_breadth is not none %} · {{ _ldr_breadth | round | int }}% broad breadth{% endif %}</span>
          <span class="l-zh">{{ _ldr_n_total }}只龙头中{{ _ldr_n_above }}只高于上升10日均线{% if _ldr_breadth is not none %} · 大盘广度{{ _ldr_breadth | round | int }}%{% endif %}</span>
        </span>
      </div>
      {%- if not _ldr_confirming and _ldr_study_n and _ldr_coh_fwd is not none %}
      <div style="font-size:11px;color:var(--muted);margin-top:2px">
        <span class="l-en">In {{ _ldr_study_n }} past episodes like this, the leaders themselves kept climbing while the broad index went nowhere.</span>
        <span class="l-zh">过去{{ _ldr_study_n }}次类似情形中，龙头自身持续上涨，大盘指数原地踏步。</span>
      </div>
      {%- endif %}
      <div class="hkrv-pop" id="hkrv-pop-a">
        <div class="hkrv-pop-row">
          <span class="hkrv-pop-lbl"><span class="l-en">What fired</span><span class="l-zh">触发依据</span></span>
          <span class="l-en">{{ _ldr_n_above }} of {{ _ldr_n_total }} mega-caps above a rising 10-day average (cohesion up from {{ ((_ldr.get('cohesion_10d_ago') or 0) * 100) | round | int }}% ten sessions ago).</span>
          <span class="l-zh">{{ _ldr_n_total }}只龙头中{{ _ldr_n_above }}只高于上升10日均线（10日前占比{{ ((_ldr.get('cohesion_10d_ago') or 0) * 100) | round | int }}%）。</span>
        </div>
        {%- if _ldr_breadth is not none -%}
        <div class="hkrv-pop-row">
          <span class="hkrv-pop-lbl"><span class="l-en">Broad market</span><span class="l-zh">大盘情况</span></span>
          {%- if _ldr_confirming -%}
          <span class="l-en">{{ _ldr_breadth | round | int }}% of stocks above their 50-day average — confirming.</span>
          <span class="l-zh">{{ _ldr_breadth | round | int }}%个股高于其50日均线 — 正在确认。</span>
          {%- else -%}
          <span class="l-en">{{ _ldr_breadth | round | int }}% of stocks above their 50-day average — not confirmed.</span>
          <span class="l-zh">{{ _ldr_breadth | round | int }}%个股高于其50日均线 — 尚未确认。</span>
          {%- endif -%}
        </div>
        {%- endif -%}
        {%- if _ldr_study_n and _ldr_fwd is not none -%}
        <div class="hkrv-pop-row">
          <span class="hkrv-pop-lbl"><span class="l-en">History</span><span class="l-zh">历史参考</span></span>
          {%- if _ldr_coh_fwd is not none -%}
          <span class="l-en">{{ _ldr_study_n }} similar episodes since 2016: the leaders themselves kept gaining ({{ '%+.1f' | format(_ldr_coh_fwd) }}% over 60 sessions) while the broad index did not follow ({{ '%+.1f' | format(_ldr_fwd) }}% over 40 sessions).</span>
          <span class="l-zh">2016年以来{{ _ldr_study_n }}次类似情形：龙头自身持续上涨（60日约{{ '%+.1f' | format(_ldr_coh_fwd) }}%），大盘指数并未跟进（40日均回报约{{ '%+.1f' | format(_ldr_fwd) }}%）。</span>
          {%- else -%}
          <span class="l-en">{{ _ldr_study_n }} similar episodes since 2016: the broad index did not follow — the leaders themselves gained while the index moved ~{{ '%+.1f' | format(_ldr_fwd) }}% over 40 sessions.</span>
          <span class="l-zh">2016年以来{{ _ldr_study_n }}次类似情形：大盘指数并未跟进 — 指数40日均回报约{{ '%+.1f' | format(_ldr_fwd) }}%。</span>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="hkrv-pop-row">
          <span class="hkrv-pop-lbl"><span class="l-en">Calibration</span><span class="l-zh">定标</span></span>
          <span class="l-en">A heads-up, not a buy signal.</span>
          <span class="l-zh">这是预警，不是买入信号。</span>
        </div>
      </div>
    </div>
    {%- endif -%}
    {# ===== END HKRV-W3 banner ===== #}
    {% set _hk_buy = actions.get('buy_now', []) %}
    {% set _hk_pull = actions.get('on_the_run', []) + actions.get('hold', []) %}
    {% set _hk_bot = actions.get('buy_soon', []) %}
    {% set _hk_red = actions.get('take_profits', []) + actions.get('avoid', []) %}
    <div class="anv2-grid">
      {%- macro _hk_anrow(it, lane) -%}
      {%- set _hk_sc = (sectors_by_ticker.get(it.ticker) if sectors_by_ticker is defined else none) -%}
      <div class="anv2-row" data-rpop>
        {#- Hover decision card — the SAME component the US board uses
            (templates/_decision_card.html.j2). HK's act-now board is sector-only,
            so this is the sector variant: setup read, cycle metrics, one stance. -#}
        {%- set _hk_tone = 'up' if it.dir == 'up' else ('dn' if it.dir == 'dn' else 'warn') -%}
        {%- set _hk_stats = [] -%}
        {%- set _hk_trust = [] -%}
        {%- if _hk_sc is not none and _hk_sc.get('mom20') is not none -%}
          {%- set _ = _hk_stats.append({'label': ('20d move','20日动能'), 'val': '%+.1f%%'|format(_hk_sc.get('mom20')),
                                        'tone': 'up' if _hk_sc.get('mom20') >= 0 else 'dn', 'sub': ('vs the market','相对大盘')}) -%}
        {%- endif -%}
        {%- if _hk_sc is not none and _hk_sc.get('mom60') is not none -%}
          {%- set _ = _hk_stats.append({'label': ('60d move','60日动能'), 'val': '%+.1f%%'|format(_hk_sc.get('mom60')),
                                        'tone': 'up' if _hk_sc.get('mom60') >= 0 else 'dn', 'sub': ('vs the market','相对大盘')}) -%}
        {%- endif -%}
        {%- if _hk_sc is not none and _hk_sc.get('eq_badge') is not none -%}
          {%- set _ = _hk_stats.append({'label': ('Entry','入场'), 'val': _hk_sc.get('eq_badge'),
                                        'sub': ('timing quality','时机质量')}) -%}
        {%- elif _hk_sc is not none and _hk_sc.get('pctile') is not none -%}
          {%- set _ = _hk_stats.append({'label': ('Strength rank','强度排名'), 'val': '%.0f'|format(_hk_sc.get('pctile')) ~ 'p',
                                        'sub': ('vs its own year','对比自身一年')}) -%}
        {%- endif -%}
        {%- if _hk_sc is not none and _hk_sc.get('above200') is not none -%}
          {%- set _ = _hk_trust.append({'tone': 'up' if _hk_sc.get('above200') else '',
                                        'en': ('▲ Above the 200-day' if _hk_sc.get('above200') else 'Below the 200-day'),
                                        'zh': ('▲ 高于200日均线' if _hk_sc.get('above200') else '低于200日均线')}) -%}
        {%- endif -%}
        {%- set _hk_sub_en -%}
        {%- if it.days is not none %}Signal ~{{ it.days }}d{% endif -%}
        {%- if it.days is not none and _hk_sc is not none and _hk_sc.get('dc_day') is not none %} · {% endif -%}
        {%- if _hk_sc is not none and _hk_sc.get('dc_day') is not none %}cycle day {{ _hk_sc.get('dc_day') }}{% endif -%}
        {%- endset -%}
        {%- set _hk_sub_zh -%}
        {%- if it.days is not none %}信号约 {{ it.days }} 天{% endif -%}
        {%- if it.days is not none and _hk_sc is not none and _hk_sc.get('dc_day') is not none %} · {% endif -%}
        {%- if _hk_sc is not none and _hk_sc.get('dc_day') is not none %}周期第 {{ _hk_sc.get('dc_day') }} 日{% endif -%}
        {%- endset -%}
        {{ dc.dc_card({
          'kind': 'sector', 'mark': '🏛', 'tone': _hk_tone,
          'eyebrow': ('Sector pulse · ' ~ it.ticker, '板块脉搏 · ' ~ it.ticker),
          'name': (td(it.name),),
          'tag': (td(it.label),) if it.label else none,
          'kicker': ('Current setup','当前形态'),
          'read': ('Entry open today','今日入场窗口开启') if lane == 'buy'
                  else (('Turning up from the low','自低位回升') if lane == 'bot'
                  else (('Momentum fading','动能转弱') if lane == 'red'
                  else ('In favour — but it has run','仍看好 — 但已上涨'))),
          'sub': (_hk_sub_en|trim, _hk_sub_zh|trim),
          'trust': _hk_trust, 'stats': _hk_stats,
          'takeaway': ('A clean entry is open today.','今日入场窗口干净。') if lane == 'buy'
                  else (('Turning up from the low — watch it, do not chase it.','自低位回升 — 观察为主，不要追。') if lane == 'bot'
                  else (('Momentum is fading — protect gains and avoid fresh adds.','动能转弱 — 保护利润，避免加仓。') if lane == 'red'
                  else ('Still in favour, but it has run — wait for a dip.','仍然看好，但已上涨 — 等回调。'))),
          'foot': ('Click row for the full sector view','点击查看完整板块详情'),
          'foot_b': (it.ticker ~ ' ↗',),
        }) }}
        </span>
        <div class="anv2-row-top">
          <a class="anv2-name anv2-name-link" href="sectors/{{ it.ticker }}.html">{{ td(it.name) }}<span class="anv2-go" aria-hidden="true">↗</span></a>
        </div>
        <div class="anv2-chips">
          {% if lane == 'buy' %}
          <span class="anv2-chip anv2-chip-reco-enter">{{ t('ENTRY NOW', '现在入场') }}</span>
          {% elif lane == 'pull' and it in actions.get('on_the_run', []) %}
          <span class="anv2-chip anv2-chip-tag">{{ t('WAIT FOR DIP', '等待回调') }}</span>
          {% elif lane == 'pull' %}
          <span class="anv2-chip anv2-chip-reco-hold">{{ t('HOLD', '持有') }}</span>
          {% elif lane == 'bot' %}
          <span class="anv2-chip anv2-chip-trough">{{ t('SETTING UP', '形态形成中') }}</span>
          {% if it.get('label') == 'TURN IN PROGRESS' %}<span class="act-turn-chip">{{ t('TURN IN PROGRESS', '转向进行中') }}</span>{% endif %}
          {% elif it in actions.get('avoid', []) %}
          <span class="anv2-chip anv2-chip-reco-avoid">{{ t('AVOID', '回避') }}</span>
          {% else %}
          <span class="anv2-chip anv2-chip-reco-trim">{{ t('TAKE PROFITS', '止盈') }}</span>
          {% endif %}
        </div>
        <div class="anv2-stat">{{ td(it.label) }}{% if it.days is not none %} · ~{{ it.days }}{{ t('d', '天') }}{% endif %} · {{ it.ticker }}</div>
      </div>
      {%- endmacro -%}
      {%- macro _hk_anlane(lane, cls, title_en, title_zh, sub_en, sub_zh, items, lane_id) -%}
      <div class="anv2-lane anv2-lane--{{ cls }}" id="{{ lane_id }}">
        <div class="anv2-lane-hd">
          <div class="anv2-lane-title"><span class="l-en">{{ title_en }}</span><span class="l-zh">{{ title_zh }}</span><span class="anv2-lane-count">({{ items|length }})</span></div>
          <div class="anv2-lane-sub"><span class="l-en">{{ sub_en }}</span><span class="l-zh">{{ sub_zh }}</span></div>
        </div>
        <div class="anv2-lane-body lst-wrap">
          <div class="anv2-lst lst-collapse lst-cap4 is-collapsed">
            {% for it in items %}{{ _hk_anrow(it, lane) }}{% endfor %}
            {% if not items %}<div class="anv2-empty">{{ t('No sectors in this lane today.', '今天此栏暂无板块。') }}</div>{% endif %}
          </div>
          {% if items|length > 4 %}<button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more', '显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less', '收起') }} ▴</span></button>{% endif %}
        </div>
      </div>
      {%- endmacro -%}
      {{ _hk_anlane('buy', 'buy', 'Buy Now', '立即买入', 'Clean entry point today', '今日有干净入场点', _hk_buy, 'anv2-buy') }}
      {{ _hk_anlane('pull', 'pull', 'In Favour', '看好', 'Hold or wait for a dip — do not chase', '持有或等待回调 — 勿追高', _hk_pull, 'anv2-pull') }}
      {{ _hk_anlane('bot', 'bot', 'Bottoming Watch', '洗盘观察', 'Setting up near a cycle low — watch only', '接近周期低点 — 仅观察', _hk_bot, 'anv2-bot') }}
      {{ _hk_anlane('red', 'red', 'Reduce / Avoid', '减仓 / 回避', 'Trend weakening — take profits or stay away', '趋势转弱 — 止盈或回避', _hk_red, 'anv2-red') }}
    </div>
  </div>
  {% endif %}
  {% endif %}

  <!-- ===================== PROPHET — HK stock signals (relative-strength cards) ===================== -->
  {% if mode == 'stocks' and setups and setups.buy %}
  {# ── W8-G: JSON data block — feeds StockTable.init(); one row per buy name in system order ── #}
  {% set _hk_st_rows = [] %}
  {% for _hn in setups.buy %}
    {% set _hk_conv = _hn.get('conviction') or {} %}
    {% set _hk_sb = _hn.get('southbound') or {} %}
    {% set _hk_ah = _hn.get('ah_value') or {} %}
    {% set _hk_es = _hn.get('entry_signal') or {} %}
    {% set _hk_bz = _hk_es.get('buy_zone') or {} %}
    {% set _hk_al = _hk_conv.get('alignment') or {} %}
    {% set _hk_row = {
      'ticker':       _hn.ticker,
      'name':         _hn.name or '',
      'name_zh':      _hn.get('name_zh') or '',
      'sector':       _hn.sector or '',
      'sector_zh':    _hn.sector_zh or '',
      'price':        _hn.get('price'),
      'off_high':     _hn.get('off_high'),
      'conviction':   _hk_conv.get('score'),
      'alpha':        _hn.get('alpha'),
      'edge_z':       _hn.get('edge_z'),
      'sb_z':         _hk_sb.get('accum_z'),
      'sb_own':       _hk_sb.get('own_pct'),
      'ah_z':         _hk_ah.get('z'),
      'ah_cheap':     true if _hk_ah.get('cheap') else false,
      'group':        _hn.get('group') or 'setting_up',
      'align_tier':   _hn.get('align_tier') or '',
      'washout_2w':   true if _hn.get('washout_2w') else false,
    } %}
    {% set _ = _hk_st_rows.append(_hk_row) %}
  {% endfor %}
  <script type="application/json" id="stocktable-data">
  {
    "rows": {{ _hk_st_rows | tojson }},
    "as_of": {{ (setups.as_of or '') | tojson }}
  }
  </script>
  <div class="panel span12" id="standouts">
    <h2>⚡ {{ t('Prophet — HK stock signals', '先知 — 港股信号') }}
      <span class="note" style="text-transform:none">· {{ t('Bottoming names, ranked by flow, value and strength', '筑底个股，按资金、价值与强度排序') }}</span>
      {{ help("Shows HK names whose weekly, 3-day and daily cycles are turning up, then ranks them by three cleaner edges — southbound flow, A/H value, and strength after removing global-risk beta. Entry-open group first, then setting-up. A screen, not a promise.", "显示周线、3日、日线开始转上的港股，再按三条较干净的优势排序 —— 南向资金、A/H 价值、剥离全球风险贝塔后的强度。入场开启组优先，蓄势中次之。这是筛选，不是承诺。") }}
      {# W8-G: grid/table view toggle #}
      <span class="st-view-toggle" id="st-view-toggle" role="group" data-tip-en="Switch between grid and table view" data-tip-zh="切换卡片视图与表格视图">
        <button id="st-btn-grid" aria-selected="true" onclick="StockTable._setView('grid')">⊞ <span class="l-en">Grid</span><span class="l-zh">卡片</span></button>
        <button id="st-btn-table" aria-selected="false" onclick="StockTable._setView('table')">☰ <span class="l-en">Table</span><span class="l-zh">表格</span></button>
      </span>
    </h2>
    {# THE ONE board-note (§7.2). Board mechanics only — the "screen, not a buy list" caveat
       lives once in the desk manifest above + the per-card tier badge. #}
    <p class="note" style="margin:0 0 2px;text-transform:none">{{ t('Only names with a fresh entry signal make this board. Entry-open group first, then setting-up. Rank is a screen, not a promise.', '仅收录出现新入场信号的个股。入场开启组优先，蓄势中次之。排名是筛选，不是承诺。') }}</p>
    {# Data-health note (§5.5) demoted to ONE muted glance-tier line; the raw leg messages
       (ledger-write / store-stale plumbing) live in the ? tip, never on Tier 1. #}
    {% if setups.health %}
    {% set _hmsg = (setups.health | map(attribute='en') | join(' · ')) %}
    {% set _hmsg_zh = (setups.health | map(attribute='zh') | join(' · ')) %}
    <p class="note st-health" style="margin:0 0 2px;text-transform:none;color:var(--muted)">◐ <span class="l-en">Some inputs didn't update this render — ranks may be a day old.</span><span class="l-zh">部分数据本次未更新 —— 排名可能为上一交易日。</span>{{ help(_hmsg, _hmsg_zh) }}</p>
    {% endif %}
    {# ── W8-G: count chips row intentionally hidden — HK uses group taxonomy (entry_open/setting_up),
       not the CN stage taxonomy (ENTRY/RAN_LATE/RIPENING/KNIFE). Kept in DOM so stocktable.js
       _updateCountChips has a target, but never made visible (display:none both modes). ── #}
    <div id="st-count-chips" style="display:none!important"></div>

    {# ── W8-G: table view mount point ─────────────────────────────────── #}
    <div id="stocktable-wrap"></div>

    {# ── W8-G: grid section (hidden in table mode by CSS .nb-grid-section) ── #}
    {{ pv.pv_css() }}
    <div class="nb-grid-section">
    <div class="nbgrid" data-showmore-rows="3">
    {% for n in setups.buy %}
      {# ═══ PROPHET CARD (flagship redesign 2026-07-21) — HK ripe-list grid. Old nbcard
         retired; disclosures demoted, not deleted: verdict + entry headline + §7.1 mechanism
         lead + A/H-cheap / southbound context → verb-chip tooltip; cautions + already-moving
         → ⚠N popover; alignment/tier/flow detail → hk_lookup analyzer. Table view
         (stocktable.js) and the watch-strip below are untouched. #}
      {% set c = n.conviction %}
      {% set es = n.entry_signal %}
      {% set _st = es.status if (es and es.status) else none %}
      {% set _verb = 'buy' if _st in ('buy_now','partial')
               else ('near' if _st in ('buy_soon','await_confluence')
               else ('hold' if _st in ('hold','topping')
               else ('avoid' if _st in ('exit','avoid')
               else ('wait' if _st else 'near')))) %}
      {% set _lbl = (n.label or '')|upper %}
      {% set _stage = 4 if ('RALLY' in _lbl or 'UPTREND' in _lbl)
               else (1 if ('BOTTOM' in _lbl or 'BOUNCE' in _lbl)
               else (3 if (_st in ('buy_now','partial') or n.group == 'entry_open') else 2)) %}
      {% set _vs = c.vol_squeeze if c else none %}
      {% set _fl = namespace(rows=[]) %}
      {% if c %}{% for cau in (c.cautions or []) %}{% set _z = c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau %}{% set _fl.rows = _fl.rows + [(cau, _z)] %}{% endfor %}{% endif %}
      {% if _vs and _vs.state in ('FIRED_UP','EXPANSION') %}{% set _fl.rows = _fl.rows + [("Already moving — don't chase above the zone", '已在异动 — 勿在买区上方追高')] %}{% endif %}
      {% set _ctx_en = ((' — ' ~ n.lead.en) if n.lead else '') ~ ((' · cheap H vs its A twin' if (n.ah_value and n.ah_value.cheap) else '')) ~ ((' · mainland Connect adding' if (n.southbound and n.southbound.accum_z is not none and n.southbound.accum_z >= 0.6) else '')) %}
      {% set _ctx_zh = ((' — ' ~ n.lead.zh) if n.lead else '') ~ ((' · H 较 A 股便宜' if (n.ah_value and n.ah_value.cheap) else '')) ~ ((' · 南向资金加仓' if (n.southbound and n.southbound.accum_z is not none and n.southbound.accum_z >= 0.6) else '')) %}
      {% set _tip_en = ((c.verdict if c else '') ~ (' · ' if (c and es) else '') ~ (es.headline if es else '')) ~ _ctx_en %}
      {% set _tip_zh = ((c.verdict_zh if c else '') ~ (' · ' if (c and es) else '') ~ (es.headline_zh if es else '')) ~ _ctx_zh %}
      {% set _bz = es.buy_zone if es else none %}
      {% set _zk = ('readd' if _verb == 'hold' else ('active' if _verb in ('buy','near') else 'muted')) if (_bz and _bz.high is not none) else ('confirm' if _verb in ('wait','near') else 'none') %}
      {{ pv.pv_card({
        'href': 'hk_lookup.html#' ~ n.ticker, 'tk': n.ticker, 'mkt': 'hk',
        'name': n.name, 'sec': n.sector, 'sec_zh': n.sector_zh or n.sector,
        'price_txt': ('%.2f'|format(n.price)) if n.price is not none else none,
        'verb': _verb, 'tip_en': _tip_en, 'tip_zh': _tip_zh,
        'edge': (c.score if (c and c.score is not none) else none),
        'edge_tip_en': 'Edge percentile — within-market rank by the flow · value · exposure screen. Not a probability and not a validated buy list.',
        'edge_tip_zh': '优势百分位 — 按资金·价值·敞口筛选在市场内的排名。不是概率，也不是已验证的买入清单。',
        'stage': _stage, 'spark': n.get('spark_svg'),
        'zone_kind': _zk,
        'zone_lo': ('%.2f'|format(_bz.low)) if (_bz and _bz.low is not none) else none,
        'zone_hi': ('%.2f'|format(_bz.high)) if (_bz and _bz.high is not none) else none,
        'date': (n.get('signal') or {}).get('asof') or setups.get('as_of'),
        'flags': _fl.rows
      }) }}
    {% endfor %}
    </div>
    </div>{# /nb-grid-section #}
    {% if setups.watch %}
    <div class="watch-strip">
      <p class="ws-h">👁 {{ t('On watch — strong edge, blocked entry (wait for a base)', '观察名单 — 优势强但入场受阻（等待筑底）') }}</p>
      <div class="watch-grid">
        {% for w in setups.watch %}
        {% set wc = w.conviction %}
        <a href="hk_lookup.html#{{ w.ticker }}" class="{{ 'wg-knife' if w.watch_reason == 'knife' else ('wg-plc' if w.watch_reason == 'placement' else '') }}" title="{{ wc.verdict if wc else '' }}">
          <span class="wg-tk">{{ w.ticker }} {% if wc and wc.score is not none %}<span class="note" style="font-weight:600">· {{ wc.score }}</span>{% endif %}</span>
          <span class="wg-v">{{ w.name }}{% if wc %} — <span class="l-en">{{ wc.verdict }}</span><span class="l-zh">{{ wc.verdict_zh }}</span>{% endif %}</span>
          {# FALLING-KNIFE reason chip (H4 phase-0 KILL — reports/h4-phase0.md). A deepest-
             quintile 3M loser pushed OUT of the entry groups: they keep falling, not rebound. #}
          {% if w.watch_reason == 'knife' %}
          <span class="wg-knife-chip" data-tip-en="Very weak 3-month trend. Held out until it turns." data-tip-zh="3个月趋势很弱。等待转向前排除。">
            <span class="l-en">🔻 very weak trend — wait</span>
            <span class="l-zh">🔻 趋势很弱 — 等待</span>
          </span>
          {% endif %}
          {# H-PLC placement/rights dilution chip (masterplan §3, W1c). A dilutive top-up
             placement / rights issue / open offer inside the trailing 90d window — fresh
             dilution + discounted-stock overhang; held OUT of the entry groups. Renders on
             any flagged watch name (incl. knife demotes carrying a placement stamp too). #}
          {% if w.placement_flag and w.placement_info %}
          <span class="wg-plc-chip" data-tip-en="Recent dilution. Held out for 90 days." data-tip-zh="近期摊薄。90天内排除。">
            <span class="l-en">💸 recent dilution — wait</span>
            <span class="l-zh">💸 近期摊薄 — 等待</span>
          </span>
          {% endif %}
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% if setups.laggards %}
    <p class="note" style="margin:13px 0 5px;text-transform:none;color:var(--down);font-weight:700">⚠ {{ t('Weakest — avoid', '最弱 — 回避') }}</p>
    <p style="margin:0;line-height:2">
      {% for r in setups.laggards %}<a href="hk_lookup.html#{{ r.ticker }}" style="margin-right:14px;white-space:normal;overflow-wrap:anywhere"><b>{{ r.ticker }}</b> <span class="note">{{ r.name }}</span> <span class="neg">{{ '%+.2f'|format(r.alpha) }}</span></a>{% endfor %}
    </p>
    {% endif %}
  </div>
  {% endif %}

  <!-- ===================== TRACK RECORD — receipt chip + popup (shared partial) — sits with Prophet ===================== -->
  {% if mode == 'stocks' and track_record %}
  {% set TR = track_record %}
  {% set _hk_h21 = (TR.horizons | selectattr('h', 'equalto', '21d') | list | first) if TR.horizons else none %}
  {% if TR.status == 'scored' and _hk_h21 and _hk_h21.hit_rate_21d is not none %}
    {% set _hk_state = 'scored' %}
    {% set _hk_stats = {
      'win_rate_pct': (_hk_h21.hit_rate_21d * 100)|round|int,
      'avg_pct': none, 'n_resolved': _hk_h21.n, 'n_up': none, 'n_stopped': none, 'n_flat': none,
      'n_calls': TR.n_calls,
    } %}
  {% else %}
    {% set _hk_state = 'accruing' %}
    {% set _hk_stats = {
      'n_calls': TR.n_calls, 'first_write': (TR.first_write or '2026-07-03'),
      'first_read_est': (TR.first_21d_read or TR.first_stable_read or '2026-08-24'),
      'n_suspended': TR.n_suspended if (TR.n_suspended is defined) else none,
    } %}
  {% endif %}
  {% set trd = {
    'market': 'hk', 'state': _hk_state, 'stats': _hk_stats,
    'data_url': 'factordata/hk_track_ledger.json',
    'eyebrow_en': 'Hong Kong board · vs Hang Seng', 'eyebrow_zh': '港股榜单 · 对比恒指',
    'bench_en': 'Hang Seng', 'bench_zh': '恒生指数',
    'series': none, 'as_of': (TR.as_of if (TR.as_of is defined) else none),
    'deep_link': none, 'up_class': 'pos', 'dn_class': 'neg',
    'note_en': 'Every nightly board is logged and graded against forward excess return vs the Hang Seng. No delisting archive yet — names that vanish leave the sample, so losses can be understated.',
    'note_zh': '每晚榜单都会记录，并按相对恒指的前瞻超额收益评分。暂无退市名库——消失的个股会离开样本，因此亏损可能被低估。',
  } %}
  <div class="panel span12" id="track-record" style="display:flex;justify-content:center;padding:16px">{% include '_track_record_dlg.html.j2' %}</div>
  {% endif %}

  {# ======= 1D VELOCITY DESK — fast movers (hk_stocks.html only) — moved AFTER Prophet (IA revamp 2026-07-22)
     Spec: HK_PICK_LAB_MASTERPLAN_BY_FABLE.md §4 + §7. VM key: hk_1d_velocity_desk.
     Degrades gracefully when the key is absent (block hidden). Mechanics live in the ? tip. #}
  {% if mode == 'stocks' %}
  {% set _vd = hk_1d_velocity_desk if hk_1d_velocity_desk is defined else none %}
  {% if _vd %}
  <!-- ===================== 1D VELOCITY DESK (fast movers, HK native 1D signal) ===================== -->
  <div class="panel span12" id="hk-velocity-desk">
    <h2 style="margin:0 0 4px">⚡ {{ t('Fast movers — 1-day momentum', '快速异动 — 1日动能') }}
      {{ help("HK names that printed several 1-day momentum triggers today — MACD/StochRSI cross-up, an ADR overnight gap, or a washout turn — then ran. No price limits in HK, so a name that runs the same day shows real demand. A heads-up, not a buy signal.", "今日打印多个1日动能触发的港股 —— MACD/StochRSI 交叉上穿、ADR 隔夜跳空，或洗盘转身 —— 并随即上涨。港股无涨跌停，当日即涨显示真实需求。这是提示，非买入信号。") }}
    </h2>
    {% set _vd_asof = _vd.get('as_of') %}
    {% if _vd_asof %}
    <p class="note" style="font-size:11px;margin:0 0 10px;color:var(--muted)">{{ t('as of', '截至') }} {{ _vd_asof }}</p>
    {% endif %}
    {% set _vd_picks = _vd.get('picks') or [] %}
    {% if _vd_picks %}
    <div class="nbgrid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px" data-showmore-rows="2">
      {% for n in _vd_picks %}
      <div class="nbcard nb-up" style="cursor:default">
        <div class="nb-id">
          <div class="nb-tkrow">
            <span class="nb-tk">{{ n.get('ticker','') }}</span>
            {% set _np = n.get('close') %}
            {% if _np is not none %}<span class="nb-px" data-sym="{{ n.get('ticker','') }}" data-mkt="hk">{{ 'HK$%.2f'|format(_np) }}</span>{% endif %}
          </div>
          <div class="nb-nm">
            <span class="l-en">{{ n.get('name') or '' }}</span>
            <span class="l-zh">{{ n.get('name_zh') or n.get('name') or '' }}</span>
          </div>
          {% set _ns = n.get('sector','') %}
          {% if _ns %}<div class="nb-secrow"><span class="nb-sec">{{ _ns }}</span></div>{% endif %}
        </div>
        <div class="nb-ctx">
          {% set _cc = n.get('confluence_count') %}
          {% if _cc is not none %}<span class="chip c-muted" style="font-size:10px">{{ _cc }} {{ t('trigger', '项触发') if _cc == 1 else t('triggers', '项触发') }}</span>{% endif %}
          {% if n.get('washout_state') %}<span class="nb-washout" style="font-size:10px"><span class="l-en">{{ n.get('washout_state') }}</span><span class="l-zh">{{ n.get('washout_state') }}</span></span>{% endif %}
          {% if n.get('adr_gap_pct') is not none %}<span class="chip c-muted" style="font-size:10px">ADR {{ '%+.1f'|format(n.get('adr_gap_pct') * 100) if n.get('adr_gap_pct') else '' }}%</span>{% endif %}
          {% if n.get('knife_risk') %}<span class="chip" style="font-size:10px;color:var(--down)">⚠ <span class="l-en">knife</span><span class="l-zh">刀口</span></span>{% endif %}
          {% if n.get('beta_role') %}<span class="chip c-muted" style="font-size:10px">{{ n.get('beta_role') }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% if _vd_picks|length > 6 %}
    <button class="lst-more" type="button" aria-expanded="false" style="margin-top:8px"><span class="lm-show">{{ t('Show more', '显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less', '收起') }} ▴</span></button>
    {% endif %}
    {% else %}
    <p class="note" style="text-transform:none;font-size:12.5px;color:var(--muted)">{{ t('No fast movers today.', '今日无快速异动。') }}</p>
    {% endif %}
    <p class="note" style="margin:10px 0 0;font-size:11px;color:var(--muted)">
      <span class="l-en">Measured vs the market over 21 sessions · fills next close · track record accruing — not a buy list</span>
      <span class="l-zh">以21个交易日相对大盘衡量 · 次日收盘成交 · 记录累积中 — 非买入清单</span>
    </p>
  </div>
  {% endif %}{# /_vd #}
  {% endif %}{# /mode == 'stocks' velocity desk #}

  {# ===== WASHOUT WATCH / 洗盘点火 ===== SEPARATE BLOCK — renders even when eligible:0 (the
     whole point: carve out names the main board hides in risk-off / decline phase).
     Condition: mode == 'stocks' AND setups exists. Renders with empty state when no candidates.
     IA revamp 2026-07-22: FULL cards only for igniting names (ignition_watch); every other
     watch name collapses to a compact chip row (Law-4 — the repeated per-card text was a
     constant; it now lives once in the shared footer). #}
  {% if mode == 'stocks' and setups is not none %}
  {% set _ww = setups.washout_watch if setups else none %}
  {% set _ww_hot = (_ww | selectattr('state', 'equalto', 'ignition_watch') | list) if _ww else [] %}
  {% set _ww_cold = (_ww | rejectattr('state', 'equalto', 'ignition_watch') | list) if _ww else [] %}
  <div class="panel span12" id="washout-watch">
    <h2>🔥 {{ t('Washout Watch — deep decliners trying to turn', '洗盘观察 — 深跌股尝试转身') }}
      <span class="note" style="text-transform:none">· {{ t("High risk, unconfirmed — watch, don't chase.", '高风险、未确认 — 观察，勿追。') }}</span>
    </h2>
    <div class="ww-strip">
      {% if _ww %}
      {# Macro helpers — chip renderers for each 1-day turn signal (per-name detail on hover) #}
      {% macro _ww_chip(sig) %}{% if sig == 'ADR_GAP_UP' %}<span class="ww-chip wc-adr" title="ADR implied gap up">ADR↑</span>{% elif sig == 'BEAR_EXHAUST' %}<span class="ww-chip wc-bear" title="CBBC bear skew exhaustion">CBBC熊挤仓</span>{% elif sig == 'BUYBACK' %}<span class="ww-chip wc-buy" title="Recent corporate buyback">回购</span>{% elif sig == 'NARRATIVE' %}<span class="ww-chip wc-narr" title="Attention spike + tone turning up">舆情</span>{% elif sig == 'SB_ACCUM' %}<span class="ww-chip wc-sb" title="Southbound accumulating">南向↑</span>{% elif sig == 'RSI_RECLAIM' %}<span class="ww-chip wc-rsi" title="RSI oversold reclaim — turning up">RSI反抽</span>{% elif sig == 'CATALYST_CONTEXT' %}<span class="ww-chip wc-cat" title="Imminent scheduled catalyst">催化</span>{% endif %}{% endmacro %}
      {% if _ww_hot %}
      {# FULL cards — names with ignition evidence (golden-bordered) #}
      <div class="ww-grid">
        {% for w in _ww_hot %}
        <a class="ww-card ww-ignite" href="hk_lookup.html#{{ w.ticker }}">
          <span class="ww-tk">{{ w.ticker }}</span>
          {% if w.name %}<span class="ww-nm">{{ w.name }}</span>{% endif %}
          <span class="ww-state st-ignite"><span class="l-en">igniting</span><span class="l-zh">点火中</span></span>
          <div class="ww-chips">
            {% for sig in w.confluence_signals %}{{ _ww_chip(sig) }}{% endfor %}
            {% if w.knife_risk %}<span class="ww-chip wc-knife" title="Deepest 3M loser — falling knife risk">🔻刀锋</span>{% endif %}
          </div>
          {% if w.entry_hint %}
          <div class="ww-hint"><span class="l-en">{{ w.entry_hint.en }}</span><span class="l-zh">{{ w.entry_hint.zh }}</span></div>
          {% endif %}
          <div class="ww-meta">
            {% if w.rsi is not none %}RSI {{ '%.0f'|format(w.rsi) }}{% endif %}
            {% if w.dist_200dma is not none %} · {{ '%+.0f'|format(w.dist_200dma * 100) }}% 200dma{% endif %}
            {% if w.price is not none %} · {{ '%.2f'|format(w.price) }}{% endif %}
          </div>
        </a>
        {% endfor %}
      </div>
      {% endif %}
      {% if _ww_cold %}
      {# COMPACT chip row — ticker + name only; RSI / distance / price on hover (data-tip). #}
      <div class="ww-cold-wrap">
        {% if _ww_hot %}<p class="ww-cold-h">{{ t('Also watching', '同时观察') }}</p>{% endif %}
        <div class="ww-cold-row">
          {% for w in _ww_cold %}
          <a class="ww-cold-chip" href="hk_lookup.html#{{ w.ticker }}"
            data-tip-en="{% if w.rsi is not none %}RSI {{ '%.0f'|format(w.rsi) }}{% endif %}{% if w.dist_200dma is not none %} · {{ '%+.0f'|format(w.dist_200dma * 100) }}% vs 200-day{% endif %}{% if w.price is not none %} · HK${{ '%.2f'|format(w.price) }}{% endif %}"
            data-tip-zh="{% if w.rsi is not none %}RSI {{ '%.0f'|format(w.rsi) }}{% endif %}{% if w.dist_200dma is not none %} · {{ '%+.0f'|format(w.dist_200dma * 100) }}% 相对200日{% endif %}{% if w.price is not none %} · HK${{ '%.2f'|format(w.price) }}{% endif %}">
            <span class="ww-cold-tk">{{ w.ticker }}</span>{% if w.name %}<span class="ww-cold-nm">{{ w.name }}</span>{% endif %}{% if w.knife_risk %}<span class="ww-cold-knife" title="Deepest 3M loser — falling knife risk">🔻</span>{% endif %}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {# ONE shared footer replaces the repeated per-card "context only / no reclaim / monitoring" text. #}
      <p class="ww-foot"><span class="l-en">A heads-up, not a buy signal — none has confirmed a turn. We log these forward to earn promotion later.</span><span class="l-zh">这是提示，非买入信号 —— 均未确认转向。持续记录，待后续晋级评估。</span></p>
      {% else %}
      <div class="ww-empty"><span class="l-en">No washout candidates trying to turn today.</span><span class="l-zh">今日无尝试转身的洗盘候选股。</span></div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# ===================== 🇨🇳 MAINLAND MONEY (merged 2026-07-22) =====================
     Merges the old "Smart-money flows" panel + the "Southbound & A/H combined" panel into
     ONE glance-tier panel. Row 1 = the three sbah-cards (southbound flow / flow-vs-price /
     A/H premium). Then the ilx chart. Row 2 = the per-name accumulating/distributing table.
     ONE as-of, ONE footer. Southbound values are pre-scaled to 亿 in build_hk._internals_vm. #}
  {% set _mm_sb = internals.southbound if (internals and internals.southbound) else none %}
  {% set _mm_div = internals.sb_divergence if (internals and internals.sb_divergence and internals.sb_divergence.state != 'insufficient') else none %}
  {% set _mm_sm = setups.southbound_summary if (setups and setups.southbound_summary) else none %}
  {% if mode == 'stocks' and (_mm_sb or _mm_div or ah or _mm_sm) %}
  {% set _mm_asof = (_mm_sm.as_of if _mm_sm else none) or (setups.as_of if setups else none) %}
  <div class="panel span12" id="mainland-money">
    <h2>🇨🇳 {{ t('Mainland money', '内地资金') }}
      <span class="note" style="text-transform:none">· {{ t("Southbound flow — and where it's going", '南向资金 — 以及流向哪里') }}{% if _mm_asof %} · {{ _mm_asof }}{% endif %}</span>
      {{ help("Mainland money flowing into HK through Southbound Connect: how much (net flow), whether that flow is backing the HSI price trend, how cheap HK-listed H-shares look vs their mainland A-share twins, and which single names the mainland is adding to or trimming. A liquidity backdrop, not a buy signal.", "内地资金通过南向港股通流入港股：规模（净流入）、该资金是否支持恒指价格趋势、港股 H 相对 A 股孪生有多便宜、以及内地正在加仓或减仓哪些个股。流动性背景，非买入信号。") }}
    </h2>
    {# Row 1 — the three cross-market read cards (values scaled to 亿) #}
    <div class="sbah-grid">
      {% if _mm_sb %}{% set sb = _mm_sb %}
      {% set _sbsig = 'in' if (sb.net_z >= 0.4 and sb.cum_20d >= 0) else ('out' if sb.net_z <= -0.4 else 'neu') %}
      <div class="sbah-card">
        <div class="sbah-head">
          <span class="sbah-t">{{ t('Southbound flow', '南向资金') }}</span>
          <span class="sbah-sig sig-{{ _sbsig }}">{% if _sbsig=='in' %}{{ t('▲ Inflow','▲ 流入') }}{% elif _sbsig=='out' %}{{ t('▼ Outflow','▼ 流出') }}{% else %}{{ t('◦ Balanced','◦ 均衡') }}{% endif %}</span>
        </div>
        <div class="stat-row">
          <div><span class="v {{ 'pos' if sb.cum_20d>=0 else 'neg' }}">{{ '{:+,.0f}'.format(sb.cum_20d) }}</span><div class="note">{{ t('20d net (¥100M)', '20日净额(亿)') }}</div></div>
          <div><span class="v {{ 'pos' if sb.net_z>=0 else 'neg' }}">{{ '%+.1f'|format(sb.net_z) }}σ</span><div class="note">{{ t('vs 1y', '对比一年') }}</div></div>
          <div><span class="v">{{ sb.pos_days_20 }}/20</span><div class="note">{{ t('net-buy days', '净买入') }}</div></div>
        </div>
