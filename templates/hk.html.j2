        <span class="muted" style="font-size:11px">{{ t('sectors as of', '板块截至') }} {{ latest.date }}</span>
      </div>
    </div>
    {# ===== HKRV-W3: leadership banner — rendered ONLY when leaders are participating ===== #}
    {%- set _ldr = setups.get('leadership') if setups else none -%}
