  {% if mode != 'macro' %}
  <!-- RC-R14: HK rotation events strip (display/context tier only) -->
  <div class="panel span12" id="rc-events-hk-panel">
<style>
  #rc-events-hk-panel h2 { font-size:16px; font-weight:800; letter-spacing:-.015em; margin:0 0 4px; }
  .rc-sub-hk { color:var(--muted); font-size:12px; margin:0 0 10px; max-width:84ch; line-height:1.5; }
  .rc-grid-hk { display:flex; flex-wrap:wrap; gap:10px; }
  .rc-card-hk { flex:1 1 300px; min-width:260px; border-radius:12px; border:1px solid var(--line);
    background:var(--panel2); padding:12px 14px; }
  .rc-card-hk.rc-major { border-top:3px solid var(--warn); }
  .rc-card-hk.rc-notable { border-top:3px solid var(--link); }
  .rc-hd-hk { display:flex; align-items:baseline; gap:7px; margin-bottom:5px; flex-wrap:wrap; }
  .rc-title-hk { font-weight:800; font-size:13px; }
  .rc-sev-hk { font-size:9.5px; font-weight:700; text-transform:uppercase; padding:2px 7px; border-radius:6px;
    background:color-mix(in srgb,var(--muted) 15%,transparent); color:var(--muted); letter-spacing:.04em; }
  .rc-sev-hk.major { background:color-mix(in srgb,var(--warn) 20%,transparent); color:var(--warn); }
  .rc-sev-hk.notable { background:color-mix(in srgb,var(--link) 16%,transparent); color:var(--link); }
  .rc-day-hk { font-size:11px; color:var(--muted); margin-left:auto; font-variant-numeric:tabular-nums; }
  .rc-copy-hk { font-size:12.5px; line-height:1.55; }
  .rc-receipts-hk { margin-top:6px; font-size:10.5px; color:var(--muted); font-variant-numeric:tabular-nums; }
  .rc-stale-hk { font-style:italic; }
  .rc-quiet-hk { color:var(--muted); font-size:12.5px; padding:6px 0; }
  .rc-sb-hk { margin-top:8px; font-size:11px; color:var(--muted); line-height:1.6; }
  .rc-sb-hk b { color:var(--text); }
  .rc-caveat-hk { margin-top:8px; font-size:10.5px; color:var(--muted); line-height:1.55; }
</style>
    <h2 id="rc-events-hk">⟲ {{ t('HK Basket Rotation Events', '港股篮子轮动事件') }}</h2>
    <p class="rc-sub-hk">{{ t(
      'Leadership handoffs across curated HK thematic baskets: blowoff-crash on one basket + fresh-low turn on a peer + pair ratio confirming. Display/context tier — no rank, gate, or size anywhere. Binding kills: no cycle-position entry-confluence, southbound flow is context only (never a detector input, HKRV-R2).',
      '精选港股主题篮子间的领导权交接：某篮子冲顶崩落 + 同类篮子自新低回升 + 比值确认。仅展示/上下文层——不排名、不设门控、不调仓。约束条款：不做周期位置叠加，南向资金仅作上下文（绝非检测器输入，HKRV-R2）。') }}</p>
    <div id="rc-events-hk-content"><p class="rc-quiet-hk"><span class="l-en">Loading…</span><span class="l-zh">加载中…</span></p></div>
<script>
(function(){
'use strict';
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function t(en,zh){return isZh()&&zh?zh:en;}
function pc(v,dp){return v==null?'—':((v>0?'+':'')+(v*100).toFixed(dp==null?1:dp)+'%');}

function renderHk(ev){
  var el=document.getElementById('rc-events-hk-content');
  if(!el) return;
  var html='';
  var active=(ev&&ev.active)||[];
  if(!active.length){
    html+='<p class="rc-quiet-hk">'+t('No active HK basket rotation events — quiet state is valid.',
      '当前无活跃港股篮子轮动事件——安静状态是有效状态。')+'</p>';
  }else{
    var sevRank={major:0,notable:1,standard:2};
    active=active.slice().sort(function(a,b){
      var d=(sevRank[a.severity]!=null?sevRank[a.severity]:9)-(sevRank[b.severity]!=null?sevRank[b.severity]:9);
      return d!==0?d:String(b.started||'').localeCompare(String(a.started||''));
    });
    html+='<div class="lst-wrap"><div class="rc-grid-hk lst-collapse lst-cap4 is-collapsed">';
    active.forEach(function(e){
      var sev=e.severity||'standard';
      var title=isZh()
        ? esc(e.from_leg.name_zh)+' → '+esc(e.to_leg.name_zh)+'（'+esc(e.sector_name_zh)+'）'
        : esc(e.from_leg.name_en)+' → '+esc(e.to_leg.name_en)+' ('+esc(e.sector_name_en)+')';
      var r=e.receipts||{};
      var rec='';
      if(r.blowoff&&r.turn&&r.ratio){
        rec=t('blowoff ','冲顶 ')+'−'+(r.blowoff.drawdown_pct*100).toFixed(0)+'%'
          +' · '+t('off low ','低点回升 ')+pc(r.turn.off_low_pct)
          +' · '+t('ratio ','比值 ')+pc(r.ratio.ratio_chg_10s)+'/10s';
        if(!e.confirmed_tonight){
          rec+=' <span class="rc-stale-hk">'+t('(as of last confirmation)','（截至最近一次确认）')+'</span>';
        }
      }
      html+='<div class="rc-card-hk rc-'+esc(sev)+'">'
        +'<div class="rc-hd-hk"><span class="rc-sev-hk '+esc(sev)+'">'+esc(sev)+'</span>'
        +'<span class="rc-title-hk">'+title+'</span>'
        +'<span class="rc-day-hk">'+t('day ','第')+esc(e.day_n)+t('',' 天')+' · '+esc(e.started)+'</span></div>'
        +'<div class="rc-copy-hk">'+esc(isZh()?e.copy_zh:e.copy_en)+'</div>'
        +(rec?'<div class="rc-receipts-hk">'+rec+'</div>':'')
        +'</div>';
    });
    html+='</div>';
    if(active.length>4){
      html+='<button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">'
        +t('Show more','显示更多')+' ▾</span><span class="lm-hide">'+t('Show less','收起')+' ▴</span></button>';
    }
    html+='</div>';
  }

  // ── Southbound context line (display receipt only — never a detector input) ──────
  // Aggregate net z (252d) from china_connect/southbound; n_adding from hk_southbound/summary.
  // Binding: per-name southbound as confirmer = NULL (HKRV-R2); as timing leg = REJECTED.
  var sbCtx=(ev&&ev.southbound_ctx)||null;
  var sbHtml='<div class="rc-sb-hk">';
  if(sbCtx&&sbCtx.net_z!=null){
    var nz=sbCtx.net_z;
    var nzStr=(nz>=0?'+':'')+nz.toFixed(2)+'σ';
    sbHtml+='<b>'+t('Southbound net z','南向净买入z')+': '+esc(nzStr)+'</b>';
    if(nz>1) sbHtml+=t(' (elevated inflow)',' （流入偏强）');
    else if(nz<-1) sbHtml+=t(' (elevated outflow)',' （流出偏强）');
    if(sbCtx.n_adding!=null) sbHtml+=' · '+t('names adding','个股南向加仓')+': <b>'+esc(sbCtx.n_adding)+'</b>';
    sbHtml+=' — ';
  }else{
    sbHtml+=t('Southbound aggregate flow: —','南向资金聚合流向：—')+' — ';
  }
  sbHtml+='<span style="font-style:italic">'+t('context only — not a detector input or confirmation criterion',
    '仅作上下文参考——不作检测器输入或确认标准')+'</span></div>';
  html+=sbHtml;

  html+='<div class="rc-caveat-hk">'
    +t('Display/context tier only — no rank, gate, or size anywhere. Southbound shown as context receipt, never a witness or gate (HKRV-R2). Events ledgered append-only; expected-NULL until RC-R9 studies mature. as-of: ',
       '仅展示/上下文层——不排名、不设门控、不调仓位。南向资金仅作上下文凭据（HKRV-R2，绝非见证或门控）。事件按只增账本记录；在RC-R9研究成熟前为预期无效应声明。截至：')
    +esc((ev&&ev.as_of)||'—')+'</div>';
  el.innerHTML=html;
}

function loadHk(){
  fetch('marketdata/rotation_events_hk.json',{cache:'no-cache'})
    .then(function(r){return r.ok?r.json():null;}).catch(function(){return null;})
    .then(function(data){
      if(!data){
        var el=document.getElementById('rc-events-hk-content');
        if(el) el.innerHTML='<p class="rc-quiet-hk"><span class="l-en">HK rotation-event data unavailable.</span><span class="l-zh">港股轮动事件数据暂不可用。</span></p>';
        return;
      }
      renderHk(data);
    });
}
loadHk();
var _rcHkObs=new MutationObserver(loadHk);
_rcHkObs.observe(document.documentElement,{attributes:true,attributeFilter:['data-lang']});
})();
</script>
  </div>
  {% endif %}{# /mode != macro — RC-R14 HK rotation events #}

  {% if mode != 'macro' %}
  <!-- ===================== SOUTHBOUND & A/H — combined flow + cross-listing value (item 12) ===================== -->
  {% if (internals and internals.southbound) or (internals and internals.sb_divergence) or ah %}
  <div class="panel span12" id="sb-ah-combined">
    <h2>{{ t('🇭🇰 Southbound &amp; A/H', '🇭🇰 南向资金与 A/H') }} <span class="note" style="text-transform:none">· {{ t('mainland flow · flow-vs-price · cross-listing value — with a read on each', '内地资金 · 资金对价格 · 跨市场估值 — 每项附带解读') }}</span>
      {{ help("Three cross-market reads in one: daily southbound flow (mainland money into HK), whether that flow confirms or diverges from the HSI trend, and the A/H premium (how cheap HK-listed H-shares are vs their mainland A-share twins). Each carries a plain read. Display context, not a buy signal.", "三个跨市场读数合一：每日南向资金（内地资金流入港股）、该资金是否与恒指趋势一致或背离、以及 A/H 溢价（港股 H 相对 A 股孪生有多便宜）。每项附带简明解读。仅背景，非买卖信号。") }}</h2>
    <div class="sbah-grid">
      {# 1. Southbound flow — deterministic inflow/outflow read from 20d net + z #}
      {% if internals and internals.southbound %}{% set sb = internals.southbound %}
      {% set _sbsig = 'in' if (sb.net_z >= 0.4 and sb.cum_20d >= 0) else ('out' if sb.net_z <= -0.4 else 'neu') %}
      <div class="sbah-card">
        <div class="sbah-head">
          <span class="sbah-t">{{ t('Southbound flow', '南向资金') }}</span>
          <span class="sbah-sig sig-{{ _sbsig }}">{% if _sbsig=='in' %}{{ t('▲ Inflow','▲ 流入') }}{% elif _sbsig=='out' %}{{ t('▼ Outflow','▼ 流出') }}{% else %}{{ t('◦ Balanced','◦ 均衡') }}{% endif %}</span>
        </div>
        <div class="stat-row">
          <div><span class="v {{ 'pos' if sb.cum_20d>=0 else 'neg' }}">{{ '%+.0f'|format(sb.cum_20d) }}</span><div class="note">{{ t('20d net (¥100M)', '20日净额(亿)') }}</div></div>
          <div><span class="v {{ 'pos' if sb.net_z>=0 else 'neg' }}">{{ '%+.1f'|format(sb.net_z) }}σ</span><div class="note">{{ t('vs 1y', '对比一年') }}</div></div>
          <div><span class="v">{{ sb.pos_days_20 }}/20</span><div class="note">{{ t('net-buy days', '净买入') }}</div></div>
        </div>
        <div class="sbah-read"><span class="l-en">{{ 'Mainland is adding — a liquidity tailwind for HK.' if _sbsig=='in' else ('Mainland is trimming — a liquidity drag.' if _sbsig=='out' else 'Flow roughly balanced — no strong tilt.') }}</span><span class="l-zh">{{ '内地在加仓 — 港股流动性顺风。' if _sbsig=='in' else ('内地在减仓 — 流动性拖累。' if _sbsig=='out' else '资金大致均衡 — 无明显倾向。') }}</span></div>
      </div>
      {% endif %}
      {# 2. Flow vs price — reuse the engine's confirms/diverges state as the read #}
      {% if internals and internals.sb_divergence and internals.sb_divergence.state != 'insufficient' %}{% set d = internals.sb_divergence %}
      {% set _dsig = 'in' if d.state=='confirms' else ('out' if d.state=='diverges' else 'neu') %}
      <div class="sbah-card">
        <div class="sbah-head">
          <span class="sbah-t">{{ t('Flow vs price', '资金 vs 价格') }}</span>
          <span class="sbah-sig sig-{{ _dsig }}">{% if _dsig=='in' %}{{ t('✓ Confirms','✓ 同向') }}{% elif _dsig=='out' %}{{ t('⚠ Diverges','⚠ 背离') }}{% else %}{{ t('◦ Mixed','◦ 中性') }}{% endif %}</span>
        </div>
        <div class="stat-row">
          <div><span class="v {{ 'pos' if d.flow_z>=0 else 'neg' }}">{{ '%+.1f'|format(d.flow_z) }}σ</span><div class="note">{{ t('flow trend', '资金趋势') }}</div></div>
          <div><span class="v {{ 'pos' if d.px_ret_pct>=0 else 'neg' }}">{{ '%+.1f'|format(d.px_ret_pct) }}%</span><div class="note">{{ t('HSI', '恒指') }} {{ d.window_d }}{{ t('d','日') }}</div></div>
        </div>
        <div class="sbah-read"><span class="l-en">{{ 'Flow is backing the price trend — cleaner.' if _dsig=='in' else ('Flow and price disagree — watch for a turn.' if _dsig=='out' else 'No clear agreement between flow and price.') }}</span><span class="l-zh">{{ '资金支持价格趋势 — 更干净。' if _dsig=='in' else ('资金与价格背离 — 留意转向。' if _dsig=='out' else '资金与价格无明显一致。') }}</span></div>
      </div>
      {% endif %}
      {# 3. A/H premium — percentile read (high A-over-H = H-shares cheap = value) #}
      {% if ah %}
      {% set _ahsig = 'in' if (ah.pctile is not none and ah.pctile >= 65) else ('out' if (ah.pctile is not none and ah.pctile <= 35) else 'neu') %}
      <div class="sbah-card">
        <div class="sbah-head">
          <span class="sbah-t">{{ t('A/H premium', 'A/H 溢价') }}</span>
          <span class="sbah-sig sig-{{ _ahsig }}">{% if _ahsig=='in' %}{{ t('H cheap','H 便宜') }}{% elif _ahsig=='out' %}{{ t('H rich','H 偏贵') }}{% else %}{{ t('◦ Fair','◦ 中性') }}{% endif %}</span>
        </div>
        <div class="stat-row">
          <div><span class="v">{{ '%+.1f'|format(ah.premium_pct) }}%</span><div class="note">{{ t('A-over-H', 'A 高于 H') }} ({{ ah.n_pairs }})</div></div>
          {% if ah.pctile is not none %}<div><span class="v">{{ ah.pctile }}%ile</span><div class="note">{{ t('vs 3y', '对比3年') }}</div></div>{% endif %}
          {% if ah.chg_1y is not none %}<div><span class="v {{ 'neg' if ah.chg_1y<0 else 'pos' }}">{{ '%+.1f'|format(ah.chg_1y) }}pp</span><div class="note">{{ t('1y', '一年') }}</div></div>{% endif %}
        </div>
        <div class="sbah-read"><span class="l-en">{{ 'H-shares look cheap vs their A twins — a value tilt.' if _ahsig=='in' else ('H-shares rich vs A — value edge gone.' if _ahsig=='out' else 'A/H spread near its 3y norm.') }}</span><span class="l-zh">{{ 'H 股相对 A 股便宜 — 价值倾向。' if _ahsig=='in' else ('H 股相对 A 偏贵 — 价值优势消退。' if _ahsig=='out' else 'A/H 价差接近三年常态。') }}</span></div>
        {% if ah.pairs %}<table class="sbah-pairs"><tbody>
        {% for p in ah.pairs[:4] %}<tr><td class="l">{{ p.name }} <span class="note">{{ p.h }}</span></td><td>{{ '%+.1f'|format(p.premium_pct) }}%</td></tr>{% endfor %}
        </tbody></table>{% endif %}
      </div>
      {% endif %}
    </div>
    {% if internals and internals.southbound and internals.southbound.chart_html %}{{ internals.southbound.chart_html | safe }}{% endif %}
  </div>
  {% endif %}

  {% endif %}{# /mode != macro — southbound flow #}



</div>

<div class="foot">
  {{ t('Built', '生成于') }} {{ built }}<br>
  <span class="made">© 2026 Mastermind Inc</span>
</div>

