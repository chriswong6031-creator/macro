  {# dlg-sector: Sectors #}
  <div class="hkx-dlg" id="hkx-dlg-sector">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('Sectors — what\'s inside','板块 — 详细内容') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('Which parts of the HK market are hot, turning up, or best avoided — and how broad the buying is.','港股哪些板块正热、转强，或最好回避 — 以及买盘的广度如何。') }}</div>
        {# ── Setups-based plain-word lists (populated from standouts; available even when
              the sector constituent store is empty on dev/fast-render). ── #}
        {% set _su = setups if setups is defined and setups else {} %}
        {% set _lead = _su.leadership if _su.leadership is defined and _su.leadership else {} %}
        {% set _buys_sec = _su.buy if _su.buy is defined and _su.buy else [] %}
        {% set _watch_sec = _su.watch if _su.watch is defined and _su.watch else [] %}
        {% set _lagg_sec = _su.laggards if _su.laggards is defined and _su.laggards else [] %}
        {% set _wash_sec = _su.washout_watch if _su.washout_watch is defined and _su.washout_watch else [] %}
        {% if _buys_sec or _watch_sec or _lagg_sec or _wash_sec %}
        {% if _buys_sec or _watch_sec %}
        <div class="hkx-eyebrow">{{ t('Turning up — cheap and getting bought','转强 — 便宜且被资金买入') }}</div>
        <div class="hkx-chips">
          {% for s in (_buys_sec + _watch_sec)[:6] %}
          <span class="hkx-chip turn">{{ t(s.name, s.name_zh if s.name_zh is defined else s.name) }}</span>
          {% endfor %}
        </div>
        {% endif %}
        {% if _lagg_sec %}
        <div class="hkx-eyebrow">{{ t('Avoid — lagging or unconfirmed','回避 — 滞涨或未确认') }}</div>
        <div class="hkx-chips">
          {% for s in _lagg_sec[:6] %}
          <span class="hkx-chip hot">{{ t(s.name, s.name_zh if s.name_zh is defined else s.name) }}</span>
          {% endfor %}
        </div>
        {% endif %}
        {# Breadth context line from leadership cohesion data #}
        {% if _lead and _lead.broad_breadth_pct is defined and _lead.broad_breadth_pct is not none %}
        <div class="hkx-eyebrow">{{ t('How broad is the buying','买盘广度') }}</div>
        <div class="hkx-kv"><span class="hkx-k">{{ t('Stocks above 50d MA','50日均线上方个股') }}</span><span class="hkx-v {{ 'hkx-up' if _lead.broad_breadth_pct >= 50 else 'hkx-dn' }}">{{ '%d'|format(_lead.broad_breadth_pct|int) }}%</span></div>
        {% if _lead.copy_en is defined and _lead.copy_en %}
        <p style="font-size:11.5px;color:var(--muted);margin:4px 0 0"><span class="l-en">{{ _lead.copy_en }}</span><span class="l-zh">{{ _lead.copy_zh if _lead.copy_zh is defined else _lead.copy_en }}</span></p>
        {% endif %}
        {% endif %}
        {% else %}
        <p style="font-size:12px;color:var(--muted)">{{ t('Building sector picture…','板块数据积累中…') }}</p>
        {% endif %}
        {# Ranked sector table — shows when constituent store is populated (nightly runner) #}
        {% if sectors %}
        <div class="hkx-sep" style="margin:10px 0"></div>
        <div class="hkx-eyebrow">{{ t('All sectors — ranked','全部板块 — 排名') }}</div>
        <table class="hkx-mt">
          <tr><th>{{ t('Sector','板块') }}</th><th class="r">{{ t('20d RS','20日相对') }}</th><th class="r">{{ t('State','状态') }}</th></tr>
          {% for s in sectors %}
          <tr>
            <td>{{ t(s.name.en if s.name is mapping else s.name, s.name.zh if s.name is mapping else s.name) }}</td>
            <td class="r {{ 'hkx-up' if (s.mom20 is not none and s.mom20 >= 0) else 'hkx-dn' }}">{{ ('%+.1f'|format(s.mom20) + '%') if s.mom20 is not none else '—' }}</td>
            <td class="r"><span class="hkx-stword {{ 'ok' if s.dir == 'up' else ('bad' if s.dir == 'down' else 'warn') }}">{{ t(s.label or s.dir, s.label or s.dir) }}</span></td>
          </tr>
          {% endfor %}
        </table>
        {% endif %}
        <div class="hkx-receipt">{{ t('Display-only — not a buy or sell call.','仅供展示 — 非买卖指令。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-property: HK Home Prices #}
  <div class="hkx-dlg" id="hkx-dlg-property">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
