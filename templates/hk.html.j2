          <span class="nbe-zone" data-tip-en="Buy zone" data-tip-zh="买入区">{{ '%.2f'|format(es.buy_zone.low) }}{% if es.buy_zone.high != es.buy_zone.low %}–{{ '%.2f'|format(es.buy_zone.high) }}{% endif %}{% if es.buy_zone.pct_from_spot is not none %} ({{ '%+.1f'|format(es.buy_zone.pct_from_spot) }}%){% endif %}</span>
          {% endif %}
        </div>
        {% endif %}
        <div class="nb-bot">
          {% if n.label %}<span class="nb-state">{{ td(n.label) }}</span>{% endif %}
