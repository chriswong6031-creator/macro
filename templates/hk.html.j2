        <p style="font-size:13px;margin:0 0 12px"><span class="l-en">{{ _cb.summary or '' }}</span><span class="l-zh">{{ _cbzh.get('summary') or _cb.summary or '' }}</span></p>
        {% if _cb.regime_read %}
        <div class="hkx-eyebrow">{{ t('Regime read','周期解读') }}</div>
        <p style="font-size:12.5px;color:var(--muted);margin:0 0 12px"><span class="l-en">{{ _cb.regime_read or '' }}</span><span class="l-zh">{{ _cbzh.get('regime_read') or _cb.regime_read or '' }}</span></p>
