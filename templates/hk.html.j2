        <div class="hkx-kv"><span class="hkx-k">{{ t('Constructive (bull)','建设性（多）') }}</span><span class="hkx-v hkx-up">{{ signal_stack.n_bull }}</span></div>
        <div class="hkx-kv"><span class="hkx-k">{{ t('Cautionary (bear)','谨慎（空）') }}</span><span class="hkx-v hkx-dn">{{ signal_stack.n_bear }}</span></div>
        <div class="hkx-kv"><span class="hkx-k">{{ t('Total signals','信号总数') }}</span><span class="hkx-v">{{ signal_stack.n }}</span></div>
