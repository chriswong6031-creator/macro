      {% set _cb = cbbc_map.bellwethers[0] %}
      <div class="hkx-kv"{% if cbbc_map.banner %} style="opacity:.55"{% endif %}><span class="hkx-k">{{ t('Leverage bets','杠杆仓位') }}</span><span class="hkx-v"><span class="hkx-stword {{ 'bad' if 'bear' in (_cb.leverage_state or '') else ('ok' if 'bull' in (_cb.leverage_state or '') else 'warn') }}">{{ t('Lean bearish','偏空') if 'bear' in (_cb.leverage_state or '') else (t('Lean bullish','偏多') if 'bull' in (_cb.leverage_state or '') else ('—' if _cb.leverage_state == 'no_data' else t('Balanced','均衡'))) }}</span></span></div>
      {% if _cb.bull_outstanding is not none and _cb.bear_outstanding is not none %}
      {% set _tot = _cb.bull_outstanding + _cb.bear_outstanding %}
