          <span class="ww-state {{ _stcls }}">{% if _wst == 'ignition_watch' %}<span class="l-en">igniting</span><span class="l-zh">点火中</span>{% elif _wst == 'pullback_entry_watch' %}<span class="l-en">pullback watch</span><span class="l-zh">回调观察</span>{% elif _wst == 'chase_risk' %}<span class="l-en">chase risk</span><span class="l-zh">追涨风险</span>{% else %}<span class="l-en">washout watch</span><span class="l-zh">洗盘观察</span>{% endif %}</span>
          <div class="ww-chips">
            {% for sig in w.confluence_signals %}{{ _ww_chip(sig) }}{% endfor %}
