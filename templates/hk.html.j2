    {% endfor %}
    {% else %}
    {# Fallback: just show peg + world mood vchips as mini tiles #}
    {% if gv and gv.peg %}
    <div class="hkx-card hkx-cat{{ ' peg-warn' if gv.peg.level > 7.83 else '' }}" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-policy')">
      <div class="cat-tag">{{ t('USD/HKD','美元/港元') }}</div>
      <div class="cat-val {{ 'hkx-tt-dn' if gv.peg.level > 7.83 else '' }}">{{ '%.4f'|format(gv.peg.level) }}</div>
      {% if gv.peg.level > 7.83 %}<div style="font-size:9px;color:var(--warn);margin-top:2px">{{ t('near weak edge','接近弱方') }}</div>{% endif %}
