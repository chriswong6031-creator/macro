        {% if c %}
        <div class="nb-conv">
          {% if c.score is not none %}<span class="nb-cscore band-{{ c.band }}" data-tip-en="Edge percentile. Not a probability." data-tip-zh="优势百分位。不是概率。">{{ c.score }}</span>{% endif %}
          <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
        </div>
        {% set al = c.alignment %}
        {% if al and al.line %}
        {# multi-timeframe ENTRY gate (engine.cycles.mtf_alignment): a low-risk SWING entry
           must be a FRESH turn from a low — weekly bear-recovering/basing + 3-day cross from
           oversold (<25) + daily just-crossed. 🟢 Prime/Armed = confirmed; 🟡 Approaching =
           early backfill (not yet a buy). The reason states WHY it qualifies. #}
        <div class="nb-align{{ ' nba-near' if n.align_tier == 'near' else '' }}" data-tip-en="{{ al.line }}" data-tip-zh="{{ al.line_zh }}">
          <span class="nba-mark">{{ '🟡' if n.align_tier == 'near' else '🟢' }}</span>
          <span class="nba-line"><span class="l-en">{{ al.reason or al.line }}</span><span class="l-zh">{{ al.reason_zh or al.line_zh }}</span></span>
          {% if al.entry_tier %}<span class="nba-tag">{{ t(al.entry_tier, al.entry_tier_zh) }}</span>{% endif %}
        </div>
        {% endif %}
        {% endif %}
        {% set es = n.entry_signal %}
        {% if es and es.status %}
        {# ENTRY-timing gauge (US-parity gauge 2): buy now / wait for the pullback / extended,
