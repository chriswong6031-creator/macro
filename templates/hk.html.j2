        <div class="hkx-kv"><span class="hkx-k">{{ t('Score','评分') }}</span><span class="hkx-v">{{ ms.score }}/100</span></div>
        {% if ms.flip_en %}<div class="hkx-kv"><span class="hkx-k">{{ t('What would flip it','转折条件') }}</span><span class="hkx-v">{{ t(ms.flip_en, ms.flip_zh) }}</span></div>{% endif %}
        {% endif %}
        {% if command_panel and command_panel.verdict %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Verdict','结论') }}</div>
        <div class="hkx-kv"><span class="hkx-k">{{ t('Overall','综合') }}</span><span class="hkx-v">{{ t(command_panel.verdict.label_en, command_panel.verdict.label_zh or command_panel.verdict.label_en) if command_panel.verdict.label_en is defined else '—' }}</span></div>
        {% endif %}
        {% if pb %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Sector playbook','板块操盘') }}</div>
        {% if pb.preferred %}<div class="hkx-kv"><span class="hkx-k">{{ t('Favour','偏好') }}</span><span class="hkx-v">{% for x in pb.preferred %}<span class="hkx-nchip">{{ td(x.name) }}</span>{% endfor %}</span></div>{% endif %}
        {% if pb.leaders %}<div class="hkx-kv"><span class="hkx-k">{{ t('Leaders','领先') }}</span><span class="hkx-v">{% for x in pb.leaders %}<span class="hkx-nchip">{{ td(x.name) }}</span>{% endfor %}</span></div>{% endif %}
        {% if pb.avoid %}<div class="hkx-kv"><span class="hkx-k">{{ t('Avoid','回避') }}</span><span class="hkx-v">{% for x in pb.avoid %}<span class="hkx-nchip" style="color:var(--down)">{{ td(x.name) }}</span>{% endfor %}</span></div>{% endif %}
