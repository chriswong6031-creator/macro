  <a class="panel span12 aibrief-card" href="aibrief.html">
    <span class="abc-ic">🧠</span>
    <span class="abc-mid">
      <span class="abc-tit">{{ t('AI Daily Brief · China & cross-asset synthesis', 'AI 每日简报 · 中国与跨资产综合') }}</span>
      <span class="abc-sub muted sm">{{ t('AI reads the Hong Kong & China dashboards in one place — regime, where signals conflict, the policy/liquidity thesis and what to watch. Research context only, never a signal.', 'AI 在一处解读中港看板 — 周期、信号冲突、政策／流动性假设与后续关注。仅供研究参考，绝非交易信号。') }}</span>
    </span>
    <span class="abc-go">→</span>
  </a>

  <!-- GLOBAL RISK OVERLAY — HK's primary high-frequency driver -->
  {% if gv %}
  <div class="panel span12" id="global-risk">
    <h2>{{ t('Global Risk Overlay', '全球风险开关') }} · {{ t('HK\'s primary driver', '香港主驱动') }}</h2>
    <div class="hero">
      <span class="risk-badge {{ 'c-up' if gv.state=='Risk-on' else ('c-down' if gv.state=='Risk-off' else 'c-muted') }}">{{ td(gv.state) }}</span>
      <div class="metric"><span class="v {{ 'pos' if (gv.score or 0)>=0 else 'neg' }}">{{ '%+.2f'|format(gv.score) }}</span><span class="k">{{ t('Composite score', '综合评分') }}</span></div>
      {% if gv.peg %}
      <div class="metric" style="flex:1 1 280px;min-width:240px">
        <div class="peg-wrap">
          <div style="display:flex;align-items:baseline;gap:8px">
            <span class="v">{{ '%.4f'|format(gv.peg.level) }}</span>
            <span class="chip c-muted">{{ td(gv.peg.state) }}</span>
          </div>
          <div class="peg-gauge"><span class="peg-marker" style="left:{{ (gv.peg.distance*100)|round|int }}%"></span></div>
          <div class="peg-ends"><span>{{ t('7.75 strong / inflow', '7.75 强方 / 流入') }}</span><span>{{ t('7.85 weak / outflow', '7.85 弱方 / 流出') }}</span></div>
        </div>
        <span class="k">{{ t('HKD peg band', '港元联汇区间') }}</span>
      </div>
      {% endif %}
    </div>
    {% if gv.factors %}
    <div class="factor-grid">
      {% for f in gv.factors %}
      <div class="factor">
        <span class="dot {{ 'c-up' if f.risk=='on' else ('c-down' if f.risk=='off' else 'c-muted') }}"></span>
        <span>{{ td(f.label) }}</span>
        <span class="fz {{ 'pos' if (f.z or 0)>=0 else 'neg' }}">{{ '%+.2f'|format(f.z) }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <p class="note" style="margin:13px 0 0">{{ t('Global risk plus the HKD peg is HK\'s main fast-moving driver. Current state, not a forecast.', '全球风险加港元联汇是香港最主要的高频驱动。当前状态，非预测。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== FIRED ALERTS (today) ===================== -->
  {% set ALERTS = latest.alerts %}
  {% if ALERTS %}
  <div class="panel span12" id="hk-fired-alerts">
    <h2>🚨 {{ t('Fired alerts (today)', '已触发警报（今日）') }}
      {{ help("Alerts fire only when something important changes. Click one to jump to its panel.", "只有重要变化才触发警报。点击可跳到对应面板。") }}
    </h2>
    {% for a in ALERTS %}
      <a class="alert alert-{{ a.severity }}" {% if a.anchor %}href="#{{ a.anchor }}"{% endif %}>
        <div class="alert-head">
          <span class="alert-ico">{{ a.icon }}</span>
          <b><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></b>
          {% if a.anchor %}<span class="alert-jump">{{ t('View panel ↓', '查看面板 ↓') }}</span>{% endif %}
        </div>
        <div class="alert-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
        {% if a.what_en %}<div class="alert-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh or a.what_en }}</span></div>{% endif %}
        {% if a.edge_en %}<div class="alert-edge"><b>{{ t('Conviction:', '可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
      </a>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ===================== SIGNAL STACK — consolidated cross-subsystem read ===================== -->
  {% if signal_stack %}
  <div class="panel span12" id="signal-stack">
    <h2>{{ t('Signal stack — where the evidence agrees & disagrees', '信号堆栈 — 证据在何处一致、在何处分歧') }}
      {{ help("A quick map of which signals agree and which one disagrees most.", "快速显示哪些信号一致，以及最大分歧在哪里。") }}
    </h2>
    <div class="sstack-grid">
      <div class="sstack-legs">
        {% for leg in signal_stack.legs %}
        <div class="sstack-leg">
          <span class="sstack-dot tone-{{ leg.tone }}"></span>
          <span class="sstack-name">{{ t(leg.label_en, leg.label_zh) }}{% if leg.tier == 'context' %}<span class="sstack-tier">{{ t('context', '背景') }}</span>{% endif %}</span>
          <span class="sstack-state tone-{{ leg.tone }}">{{ t(leg.state_en, leg.state_zh) }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="sstack-verdict">
        <div class="sstack-final tone-{{ signal_stack.anchor_tone }}">{{ t('Final', '结论') }}: <b>{{ t(signal_stack.final_en, signal_stack.final_zh) }}</b></div>
        {% if signal_stack.agreement_pct is not none %}
        <div class="sstack-agree">{{ t('Regime agreement', '周期一致度') }} <b>{{ signal_stack.agreement_pct }}%</b>{% if signal_stack.quality_en %} — {{ t(signal_stack.quality_en, signal_stack.quality_zh) }}{% endif %}</div>
        {% endif %}
        <div class="sstack-tally"><b class="tone-up">{{ signal_stack.n_bull }}</b> {{ t('constructive', '建设性') }} · <b>{{ signal_stack.n_flat }}</b> {{ t('neutral', '中性') }} · <b class="tone-down">{{ signal_stack.n_bear }}</b> {{ t('cautionary', '谨慎') }} {{ t('of', '／共') }} {{ signal_stack.n }}</div>
        {% if signal_stack.contradiction_en %}
        <div class="sstack-contra">⚠ {{ t('Main contradiction', '主要矛盾') }}: {{ t(signal_stack.contradiction_en, signal_stack.contradiction_zh) }}</div>
        {% else %}
        <div class="sstack-contra ok">✓ {{ t('Broad agreement — no leg is fighting the regime', '广泛一致 — 没有腿与周期相左') }}</div>
        {% endif %}
      </div>
    </div>
    <p class="note" style="margin:10px 0 0;text-transform:none;font-size:11px">{{ t('Summary only. It does not change the score.', '仅为汇总。不改变评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== MARKET SNAPSHOT (cross-asset tiles) ===================== -->
  {% if market_tiles %}
  <div class="panel span12" id="market-snapshot">
    <h2>{{ t('Market snapshot', '市场快照') }}
      {{ help("One-glance levels for HK: tech, peg, yuan, gold, dollar and HIBOR.", "一眼看香港关键水平：科技、联汇、人民币、黄金、美元与 HIBOR。") }}
    </h2>
    <div class="mtiles">
      {% for tl in market_tiles %}
      <div class="mtile">
        <div class="mtile-top"><span class="mtile-lbl">{{ tl.label }}</span><span class="mtile-tag">{{ tl.tag }}</span></div>
        <div class="mtile-val">{{ tl.level }}</div>
        <div class="mtile-chg {{ tl.tone }}">{{ tl.chg }} ({{ tl.pct }})</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- ===================== DRAWDOWN & SLOWDOWN RISK (uncalibrated, display-only) ===================== -->
  {% if latest.conditions and latest.conditions.recession and latest.conditions.recession.score is not none %}
  {% set CO = latest.conditions %}
  <div class="panel span12" id="hk-risk">
    <h2>{{ t('HK drawdown & slowdown risk', '香港回撤与放缓风险') }}
      <span class="note" style="text-transform:none">· {{ t('uncalibrated · display only', '未校准 · 仅展示') }}</span>
      {{ help("Two HK risk gauges: slowdown pressure and drawdown stress. Display-only; not scored.", "两个香港风险仪表：放缓压力与回撤压力。仅展示，不评分。") }}
    </h2>
    <div class="grid" style="gap:18px">
      <div class="span6">
        <div style="display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'neg' if CO.recession.score>=60 else ('warn' if CO.recession.score>=40 else 'pos') }}">{{ CO.recession.score|round|int }}</span>
          <span class="sub">{{ t('Slowdown score', '放缓评分') }} · {{ t(CO.recession.label, {'low':'低','elevated':'偏高','high':'高'}.get(CO.recession.label, CO.recession.label)) }}</span>
        </div>
        <div class="dial"><i style="left:{{ CO.recession.score }}%"></i></div>
        <div class="dial-ends"><span>{{ t('expansion', '扩张') }}</span><span>{{ t('contraction', '收缩') }}</span></div>
        <table style="margin-top:8px">
          <tbody>
          {% for lg in CO.recession.legs if lg.active %}
          <tr><td class="l">{{ t(lg.label, lg.label_zh) }}</td>
            <td>{{ '%.0f'|format(lg.points) if lg.points is not none else '—' }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {% if CO.recession_html %}<div class="chart">{{ CO.recession_html | safe }}</div>{% endif %}
      </div>
      <div class="span6">
        {% if CO.drawdown_risk and CO.drawdown_risk.score is not none %}
        <div style="display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'neg' if CO.drawdown_risk.score>=60 else ('warn' if CO.drawdown_risk.score>=40 else 'pos') }}">{{ CO.drawdown_risk.score|round|int }}</span>
          <span class="sub">{{ t('Drawdown-risk percentile', '回撤风险分位') }} · {{ t(CO.drawdown_risk.band, {'calm':'平静','low':'低','elevated':'偏高','high':'高','extreme':'极端'}.get(CO.drawdown_risk.band, CO.drawdown_risk.band)) }}</span>
        </div>
        <div class="dial"><i style="left:{{ CO.drawdown_risk.score }}%"></i></div>
        <div class="dial-ends"><span>{{ t('calm', '平静') }}</span><span>{{ t('fragile', '脆弱') }}</span></div>
        {% if CO.drawdown_html %}<div class="chart">{{ CO.drawdown_html | safe }}</div>{% endif %}
        {% endif %}
        {% if property %}
        <div style="margin-top:14px;display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'pos' if property.regime.tone=='up' else ('neg' if property.regime.tone=='down' else '') }}">{{ property.ccl.level }}</span>
          <span class="sub">{{ t('Centaline CCL', '中原城市领先指数') }} · {{ t(property.regime.label_en, property.regime.label_zh) }}{% if property.ccl.chg_52w is not none %} · {{ '%+.1f'|format(property.ccl.chg_52w) }}% {{ t('YoY', '同比') }}{% endif %}</span>
        </div>
        {% endif %}
      </div>
    </div>
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">{{ t('Context only. Not part of the regime score.', '仅作背景。不计入周期评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== WHAT'S DRIVING THE TAPE (market drivers) ===================== -->
  {% if latest.market_drivers and latest.market_drivers.verdict not in [none, 'unknown'] %}
  {% set MD = latest.market_drivers %}
  <div class="panel span12" id="market-drivers">
    <h2>{{ t("What's driving the HK tape", '香港市场驱动因素') }}
      <span class="note" style="text-transform:none">· {{ t('past week', '过去一周') }}{% if MD.window_d %} · {{ MD.window_d }}d z{% endif %}</span>
      {{ help("Explains recent HK moves by matching cross-asset fingerprints. No news feed; not a signal.", "用跨资产指纹解释近期港股走势。无新闻源；不是信号。") }}
    </h2>
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:10px">
      <span class="chip c-{{ 'info' if MD.verdict=='clear' else ('warn' if MD.verdict=='mixed' else 'muted') }}"><span class="l-en">{{ MD.verdict }}</span><span class="l-zh">{{ MD.verdict_zh }}</span></span>
      <span style="font-size:18px;font-weight:800">{{ t(MD.primary_label, MD.primary_label_zh) }}</span>
      <span class="sub">{{ t('confidence', '置信度') }} <span class="l-en">{{ MD.confidence }}</span><span class="l-zh">{{ MD.confidence_zh }}</span> · {{ t('agreement', '一致度') }} {{ (MD.agreement*100)|round|int }}%</span>
    </div>
    <p class="note" style="margin:8px 0 8px;text-transform:none"><span class="l-en">{{ MD.direction }}</span><span class="l-zh">{{ MD.direction_zh }}</span></p>
    {% if MD.evidence_legs %}
    <div style="display:flex;flex-direction:column;gap:5px;max-width:560px">
      {% for lg in MD.evidence_legs %}
      {% set w = (([lg.z|abs, 3]|min)/3*50)|round(1) %}
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:0 0 160px;font-size:12.5px">{{ t(lg.en, lg.zh) }}</span>
        <div style="flex:1;height:9px;border-radius:5px;background:var(--panel2);position:relative">
          <i style="position:absolute;top:0;height:100%;border-radius:5px;{{ 'right:50%;background:var(--down)' if lg.z<0 else 'left:50%;background:var(--up)' }};width:{{ w }}%"></i>
          <span style="position:absolute;left:50%;top:-2px;height:13px;width:1px;background:var(--muted)"></span>
        </div>
        <span class="sub" style="flex:0 0 48px;text-align:right">{{ '%+.1f'|format(lg.z) }}σ</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if MD.runner_up_label %}<p class="sub" style="margin:8px 0 0">{{ t('Runner-up', '次因') }}: {{ t(MD.runner_up_label, MD.runner_up_label_zh) }}</p>{% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none"><span class="l-en">{{ MD.note }}{% if MD.invalidation %} · {{ MD.invalidation }}{% endif %}</span><span class="l-zh">确定性的香港跨资产归因 — 区制解读，而非信号；从不决定评分或象限。{% if MD.invalidation_zh %} · {{ MD.invalidation_zh }}{% endif %}</span></p>
  </div>
  {% endif %}

  <!-- ===================== FEAR ↔ EUPHORIA + RORO ===================== -->
  {% if latest.fear_euphoria %}
  {% set FE = latest.fear_euphoria %}
  <div class="panel span12" id="fear-euphoria">
    <h2>{{ t('🌡️ Fear ↔ Euphoria — HK regime synthesis', '🌡️ 恐惧 ↔ 欣喜 — 香港情绪综合') }}
      <span class="note" style="text-transform:none">{% if FE.roro is not none %}· RORO {{ '%+.2f'|format(FE.roro) }} ({{ td(FE.roro_state) }}){% endif %}{% if FE.warming_up %} · {{ t('history warming up', '历史预热中') }}{% endif %}</span>
      {{ help("0-100 sentiment gauge for HK risk-on vs risk-off. Display-only.", "0-100 的香港风险偏好/规避情绪计。仅展示。") }}
    </h2>
    {% if FE.fe_score is not none %}
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <span class="bignum">{{ FE.fe_score }}</span>
      <span class="chip c-{{ 'down' if FE.fe_score>=75 else ('up' if FE.fe_score<=25 else 'muted') }}" style="font-size:15px">{{ t(FE.band, FE.band_zh) }}</span>
      <span class="sub">{{ t('0 = Panic · 100 = Euphoria', '0＝恐慌 · 100＝欣喜') }}</span>
    </div>
    <div class="dial"><i style="left:{{ FE.fe_score }}%"></i></div>
    <div class="dial-ends"><span>{{ t('Panic', '恐慌') }}</span><span>{{ t('Neutral', '中性') }}</span><span>{{ t('Euphoria', '欣喜') }}</span></div>
    {% endif %}
    {% if FE.chart_html %}<div class="chart">{{ FE.chart_html | safe }}</div>{% endif %}
    {% if FE.legs %}
    <h3>{{ t('Risk-on / risk-off legs (percentile)', '风险偏好分腿（分位）') }}</h3>
    <div style="display:flex;flex-direction:column;gap:5px;max-width:600px">
      {% for lg in FE.legs %}
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:0 0 180px;font-size:12.5px">{{ t(lg.name_en, lg.name_zh) }}</span>
        <div style="flex:1;height:9px;border-radius:5px;background:var(--panel2);position:relative">
          <i style="position:absolute;top:0;left:0;height:100%;border-radius:5px;background:{{ 'var(--up)' if lg.lean=='risk-on' else ('var(--down)' if lg.lean=='risk-off' else 'var(--muted)') }};width:{{ lg.pct }}%"></i>
        </div>
        <span class="sub" style="flex:0 0 34px;text-align:right">{{ lg.pct }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if FE.confirmation %}
    <p class="note" style="margin:9px 0 0;text-transform:none">{{ t('Cross-asset confirmation', '跨资产确认') }}:
      <b><span class="l-en">{{ FE.confirmation.verdict_en }}</span><span class="l-zh">{{ FE.confirmation.verdict_zh }}</span></b>
      — {{ FE.confirmation.n_on }} {{ t('risk-on', '偏多') }} / {{ FE.confirmation.n_off }} {{ t('risk-off', '偏空') }}.</p>
    {% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('Display-only sentiment synthesis — never scored into the HK regime.', '仅展示的情绪综合 — 从不计入香港区制评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== HK MACRO CALENDAR (HK / US / China, display-only) ===================== -->
  {% if calendar %}
  <div class="panel span12" id="hk-calendar">
    <h2>📅 {{ t('Macro calendar — HK · US · China', '宏观日历 — 香港 · 美国 · 中国') }}
      <span class="note" style="text-transform:none">· {{ t('next 14 days', '未来14天') }}</span>
      {{ help("Upcoming HK, US and China releases that can move the Hang Seng. Calendar context only.", "可能影响恒指的香港、美国与中国数据日程。仅日历背景。") }}
    </h2>
    {% if imminent %}<p class="note" style="margin:0 0 8px;text-transform:none"><b>{{ t('Imminent', '临近') }}:</b> <span class="l-en">{{ imminent.en }}</span><span class="l-zh">{{ imminent.zh }}</span></p>{% endif %}
    <table>
      <thead><tr><th class="l">{{ t('Date', '日期') }}</th><th class="l">{{ t('In', '距今') }}</th><th class="l">{{ t('Release', '数据') }}</th><th class="l">{{ t('Region', '地区') }}</th></tr></thead>
      <tbody>
      {% for c in calendar %}
      <tr>
        <td class="l">{{ c.date }}</td>
        <td class="l note">+{{ c.days_until }}{{ t('d', '天') }}</td>
        <td class="l">{% if c.importance=='high' %}<b>{{ t(c.name_en, c.name_zh) }}</b>{% else %}{{ t(c.name_en, c.name_zh) }}{% endif %}</td>
        <td class="l"><span class="chip c-{{ 'info' if c.region=='HK' else ('warn' if c.region=='US' else 'muted') }}" style="font-size:10.5px">{{ c.region }}</span></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">{{ t('Scheduling context only — never scored, no event-risk dampener, no news API.', '仅日程背景 — 从不评分、无事件风险衰减、无新闻接口。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== SCHEDULED-CATALYST CALENDAR (display-only) ===================== -->
  {# Structural, deterministic, dated catalysts: index reviews, Stock Connect eligibility,
     MSCI / FTSE rebalances. Forward 45-day window. Display context only; never scored. #}
  <div class="panel span12" id="hk-catalyst-calendar">
    <h2>📋 <span class="l-en">Scheduled Catalysts · next 45d</span><span class="l-zh">日程催化 · 未来45天</span>
      <span class="note" style="text-transform:none">· <span class="l-en">Index reviews · Stock Connect · MSCI / FTSE</span><span class="l-zh">指数检讨 · 沪深港通 · MSCI / 富时</span></span>
      {{ help("Deterministic, dated structural catalysts known in advance: HSI/HS-TECH index reviews, Stock Connect eligibility updates, MSCI and FTSE rebalances. Display context only — not a signal, not scored.", "可提前知晓的日程性结构催化剂：恒指/恒科季度检讨、沪深港通标的更新、MSCI与富时再平衡。仅展示背景，不构成信号，不计入评分。") }}
    </h2>
    {% if catalyst_imminent %}
    <p class="note" style="margin:0 0 8px;text-transform:none">
      <b>{{ t('Imminent', '临近') }}:</b>
      <span class="l-en">{{ catalyst_imminent.en }}</span>
      <span class="l-zh">{{ catalyst_imminent.zh }}</span>
    </p>
    {% endif %}
    {% if catalyst_strip %}
    <div class="evbanner" style="flex-wrap:wrap;gap:6px 8px">
      <span class="ev-h">🗓 <span class="l-en">Upcoming</span><span class="l-zh">即将发生</span></span>
      <span class="ev-list" style="flex-wrap:wrap">
        {% for c in catalyst_strip[:6] %}
        <span class="ev-chip {% if c.imminent %}cat-imminent{% endif %}"
              style="{% if c.imminent %}border:1px solid color-mix(in srgb,var(--warn) 55%,transparent);{% endif %}"
              title="{{ c.effective_date }} · {{ c.scope }}{% if c.provisional %} [provisional]{% endif %}">
          <span class="l-en">{{ c.name_en | truncate(42, True, '…') }}</span>
          <span class="l-zh">{{ c.name_zh | truncate(20, True, '…') }}</span>
          <span class="ev-rg">{{ c.type | replace('_REVIEW','') | replace('STOCK_CONNECT','SC') }}</span>
          <span class="ev-d">
            {% if c.days_until <= 0 %}{{ t('today','今日') }}{% else %}+{{ c.days_until }}{{ t('d','天') }}{% endif %}
          </span>
          {% if c.provisional %}<span class="ev-rg" style="opacity:.7">~</span>{% endif %}
        </span>
        {% endfor %}
      </span>
    </div>
    {% if catalyst_strip | length > 6 %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">
      +{{ catalyst_strip | length - 6 }} {{ t('more in 45-day window', '项（45天窗口内）') }}
    </p>
    {% endif %}
    <table style="margin-top:10px">
      <thead>
        <tr>
          <th class="l"><span class="l-en">Type</span><span class="l-zh">类型</span></th>
          <th class="l"><span class="l-en">Catalyst</span><span class="l-zh">催化事件</span></th>
          <th class="l"><span class="l-en">Announce</span><span class="l-zh">公告日</span></th>
          <th class="l"><span class="l-en">Effective</span><span class="l-zh">生效日</span></th>
          <th class="l"><span class="l-en">In</span><span class="l-zh">距今</span></th>
          <th class="l"><span class="l-en">Scope</span><span class="l-zh">范围</span></th>
        </tr>
      </thead>
      <tbody>
        {% for c in catalyst_strip %}
        <tr {% if c.imminent %}style="background:color-mix(in srgb,var(--warn) 6%,transparent)"{% endif %}>
          <td class="l"><span class="chip c-muted" style="font-size:10px">{{ c.type | replace('_REVIEW','') | replace('STOCK_CONNECT','SC') }}</span></td>
          <td class="l">
            <span class="l-en">{{ c.name_en }}</span>
            <span class="l-zh">{{ c.name_zh }}</span>
            {% if c.provisional %}<span class="note" style="font-size:10px"> ~</span>{% endif %}
          </td>
          <td class="l note">{{ c.announce_date }}</td>
          <td class="l">{{ c.effective_date }}</td>
          <td class="l note">+{{ c.days_until }}{{ t('d','天') }}</td>
          <td class="l note" style="font-size:11px">{{ c.scope }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="note" style="text-transform:none">— <span class="l-en">No scheduled catalysts in the next 45 days.</span><span class="l-zh">未来45天内无已知日程催化剂。</span></p>
    {% endif %}
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">
      <span class="l-en">Display context only — never scored. ~ = date is provisional (rule-computed; verify against official release).</span>
      <span class="l-zh">仅展示背景，从不评分。~ = 日期为预估（规则推算；请以官方公告为准）。</span>
    </p>
  </div>

  <!-- ===================== HK PROPERTY (Centaline CCL) ===================== -->
  {% if property %}
  <div class="panel span6" id="hk-property">
    <h2>🏗️ {{ t('HK residential property', '香港住宅地产') }} <span class="note" style="text-transform:none">· {{ t('Centaline CCL', '中原城市领先指数') }}</span>
      {{ help("Hong Kong home-price trend. Important wealth/credit context, never scored.", "香港楼价趋势。重要财富/信贷背景，从不评分。") }}
    </h2>
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <span class="bignum {{ 'pos' if property.regime.tone=='up' else ('neg' if property.regime.tone=='down' else '') }}">{{ property.ccl.level }}</span>
      <span class="chip c-{{ 'up' if property.regime.tone=='up' else ('down' if property.regime.tone=='down' else 'muted') }}" style="font-size:14px">{{ t(property.regime.label_en, property.regime.label_zh) }}</span>
      <span class="sub">{{ t('pctile', '分位') }} {{ property.ccl.pctile }}</span>
    </div>
    <div class="sub" style="margin:6px 0 0">
      {% if property.ccl.chg_13w is not none %}{{ t('13-week', '13周') }} <b class="{{ 'pos' if property.ccl.chg_13w>=0 else 'neg' }}">{{ '%+.1f'|format(property.ccl.chg_13w) }}%</b>{% endif %}
      {% if property.ccl.chg_52w is not none %} · {{ t('1-year', '一年') }} <b class="{{ 'pos' if property.ccl.chg_52w>=0 else 'neg' }}">{{ '%+.1f'|format(property.ccl.chg_52w) }}%</b>{% endif %}
      {% if property.ccl.mass %} · {{ t('Mass', '大型屋苑') }} {{ property.ccl.mass }}{% endif %}
      · {{ t('as of', '截至') }} {{ property.ccl.asof }}
    </div>
    {% if property.chart_html %}<div class="chart">{{ property.chart_html | safe }}</div>{% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('Display / context only — never scored into the HK regime.', '仅展示／背景 — 从不计入香港区制评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== HK VALUATION (PE / PB market-median) ===================== -->
  {% if valuation %}
  <div class="panel span6" id="hk-valuation">
    <h2>{{ t('HK index valuation', '香港指数估值') }} <span class="note" style="text-transform:none">· {{ t('PE / PB market-median', '市盈率／市净率 中位数') }}</span>
      {{ help("Market PE/PB for a large-cap HK cohort, shown vs its own history. Display-only.", "香港大盘样本的市盈率/市净率，并与自身历史比较。仅展示。") }}
    </h2>
    <div style="display:flex;gap:26px;flex-wrap:wrap">
      {% if valuation.pe %}
      <div>
        <div style="display:flex;align-items:baseline;gap:8px"><span class="bignum">{{ valuation.pe.level }}</span><span class="sub">{{ t('PE (TTM)', '市盈率') }}</span></div>
        <div class="sub">{{ t('pctile', '分位') }} {{ valuation.pe.pctile }}{% if valuation.pe.chg_1y is not none %} · {{ '%+.1f'|format(valuation.pe.chg_1y) }}% {{ t('1y', '一年') }}{% endif %}</div>
      </div>
      {% endif %}
      {% if valuation.pb %}
      <div>
        <div style="display:flex;align-items:baseline;gap:8px"><span class="bignum">{{ valuation.pb.level }}</span><span class="sub">{{ t('PB', '市净率') }}</span></div>
        <div class="sub">{{ t('pctile', '分位') }} {{ valuation.pb.pctile }}{% if valuation.pb.chg_1y is not none %} · {{ '%+.1f'|format(valuation.pb.chg_1y) }}% {{ t('1y', '一年') }}{% endif %}</div>
      </div>
      {% endif %}
    </div>
    {% if valuation.pe_chart_html %}<div class="chart">{{ valuation.pe_chart_html | safe }}</div>{% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{% if valuation.n %}{{ valuation.n }} {{ t('names · ', '只成分 · ') }}{% endif %}{% if valuation.pe %}{{ valuation.pe.span }} · {% endif %}{{ t('display-only valuation context.', '仅展示的估值背景。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== OFFICIAL A-H PREMIUM INDEX ===================== -->
  {% if ah_official %}
  <div class="panel span6" id="ah-premium">
    <h2>{{ t('A/H premium — official index', 'A/H 溢价 — 官方指数') }} <span class="note" style="text-transform:none">· {{ t('~190 dual-listed pairs', '约190只两地上市') }}</span>
      {{ help("Shows how expensive A-shares are vs their HK H-share twins. High premium means H-shares are cheaper.", "显示A股相对香港H股孪生贵多少。高溢价表示H股更便宜。") }}
    </h2>
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      {% if ah_official.premium_pct is not none %}<span class="bignum">{{ ah_official.premium_pct }}%</span>
      <span class="sub">{{ t('reconstructed daily index', '重构日度指数') }} · {{ t('pctile', '分位') }} {{ ah_official.pctile }}{% if ah_official.chg_1y is not none %} · {{ '%+.1f'|format(ah_official.chg_1y) }}pp {{ t('1y', '一年') }}{% endif %}</span>{% endif %}
    </div>
    {% if ah_official.spot_mean is not none %}<div class="sub" style="margin:6px 0 0">{{ t('Today, market-wide', '今日全市场') }}: {{ t('mean', '均值') }} <b>{{ ah_official.spot_mean }}%</b>{% if ah_official.spot_median is not none %} · {{ t('median', '中位') }} {{ ah_official.spot_median }}%{% endif %}{% if ah_official.n_pairs %} · {{ ah_official.n_pairs }} {{ t('pairs', '对') }}{% endif %}</div>{% endif %}
    {% if ah_official.chart_html %}<div class="chart">{{ ah_official.chart_html | safe }}</div>{% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('Display-only — never scored. Lean on the trend / percentile, not the absolute level.', '仅展示 — 从不评分。关注趋势／分位，而非绝对水平。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== SOUTHBOUND MOMENTUM (per-channel) ===================== -->
  {% if sb_channels %}
  <div class="panel span6" id="southbound">
    <h2>🇭🇰 {{ t('Southbound flow momentum', '南向资金动能') }} <span class="note" style="text-transform:none">· {{ t('per Connect channel', '分互联互通通道') }}</span>
      {{ help("Mainland money buying HK through Stock Connect, split by Shanghai and Shenzhen channels.", "内地资金通过港股通买入香港，并拆分为沪市与深市通道。") }}
    </h2>
    <table>
      <thead><tr><th class="l">{{ t('Channel', '通道') }}</th><th>{{ t('Net (today)', '今日净额') }}</th><th>{{ t('20d', '20日') }}</th><th>{{ t('60d', '60日') }}</th></tr></thead>
      <tbody>
      {% for k in ['sh', 'sz'] if sb_channels[k] %}
      {% set c = sb_channels[k] %}
      <tr>
        <td class="l">{{ t(c.label_en, c.label_zh) }}</td>
        <td class="{{ 'pos' if c.net>=0 else 'neg' }}">{{ '%+.1f'|format(c.net) }}</td>
        <td class="{{ 'pos' if c.sum_20d>=0 else 'neg' }}">{{ '%+.0f'|format(c.sum_20d) }}</td>
        <td class="{{ 'pos' if c.sum_60d>=0 else 'neg' }}">{{ '%+.0f'|format(c.sum_60d) }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('Net flows in ¥100m (亿元). Additive to the combined southbound series. Display-only.', '净额单位亿元。对合并南向序列为补充。仅展示。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== SMART-MONEY NAMES (southbound per-stock, macro) ===================== -->
  {% if setups and setups.southbound_summary %}
  {% set SM = setups.southbound_summary %}
  <div class="panel span6" id="smart-money-names">
    <h2>🇨🇳 {{ t('Smart-money names', '聪明钱个股') }} <span class="note" style="text-transform:none">· {{ t('mainland is adding / trimming', '内地加仓／减仓') }}</span>
      {{ help("Which HK names mainland money is adding to or trimming. Display-only flow context.", "内地资金正在加仓或减仓哪些港股。仅资金背景。") }}
    </h2>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 18px">
      <div>
        <div class="sub pos" style="font-weight:700;margin-bottom:3px">↑ {{ t('Adding', '加仓') }}</div>
        {% for r in SM.buying[:5] %}<div style="display:flex;justify-content:space-between;font-size:12px;padding:2px 0"><a href="hk_stocks.html">{{ r.ticker }}</a><span class="pos">+{{ r.chg5_pct }}%</span></div>{% endfor %}
      </div>
      <div>
        <div class="sub neg" style="font-weight:700;margin-bottom:3px">↓ {{ t('Trimming', '减仓') }}</div>
        {% for r in SM.selling[:5] %}<div style="display:flex;justify-content:space-between;font-size:12px;padding:2px 0"><a href="hk_stocks.html">{{ r.ticker }}</a><span class="neg">{{ r.chg5_pct }}%</span></div>{% endfor %}
      </div>
    </div>
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">{{ t('Per-stock southbound holdings (5-day Δ). The where, not the how-much. Display-only — full desk on the', '个股南向持股（5日变化）。资金流向，而非流量。仅展示 —— 完整研判台见') }}
      <a href="hk_stocks.html" style="color:var(--link);font-weight:600">{{ t('HK Stock Desk', '港股研判台') }}</a>.</p>
  </div>
  {% endif %}

  {% endif %}{# /mode != stocks — macro group 1 (hero, index health, global risk overlay) #}

  {% if mode != 'macro' %}
  <!-- ===================== GLOBAL-RISK SCREENER (consolidated · toggle) ===================== -->
  {% if hk_scoreboard and hk_scoreboard.modes and hk_scoreboard.modes.all %}
  {% set RS = hk_scoreboard.risk_state %}
  <div class="panel span12" id="hk-screener">
    <h2>{{ t('🌐 Global-risk screener — amplifiers, cushions, the full list', '🌐 全球风险筛选 — 放大器、缓冲、全名单') }}
      <span class="note" style="text-transform:none">· {{ t('beta to global risk (S&P 500, overnight)', '对全球风险的贝塔（标普500·隔夜）') }}{% if hk_scoreboard.as_of %} · {{ hk_scoreboard.as_of }}{% endif %}</span>
      {{ help("HK single names are mostly risk exposures. Amplifiers move more with global risk; cushions move less.", "港股个股主要是风险敞口。放大器更随全球风险波动；缓冲股波动较小。") }}
    </h2>
    <p class="note" style="margin:0 0 12px;text-transform:none">
      {% if RS == 'Risk-on' %}{{ t('Global risk is <b>ON</b> — amplifiers are the leveraged play; cushions lag the rally.', '全球风险<b>开启</b> — 放大器是杠杆首选；缓冲滞后于上涨。') }}
      {% elif RS == 'Risk-off' %}{{ t('Global risk is <b>OFF</b> — amplifiers draw down more; cushions defend.', '全球风险<b>关闭</b> — 放大器回撤更大；缓冲防守。') }}
      {% else %}{{ t('Global risk is <b>neutral</b> — these are exposures, not a tilt; amplifiers will move more in EITHER direction when the regime turns.', '全球风险<b>中性</b> — 这是敞口而非倾向；当风险状态转变时，放大器在任一方向都会波动更大。') }}{% endif %}
      {{ t('Current state:', '当前状态：') }} <b>{{ RS }}</b>.
    </p>
    <div class="sb-seg" role="tablist" aria-label="screener mode">
      <button role="tab" data-mode="amplifiers" aria-selected="true">{{ t('⚡ Amplifiers', '⚡ 放大器') }}</button>
      <button role="tab" data-mode="cushions" aria-selected="false">{{ t('🛡 Cushions', '🛡 缓冲') }}</button>
      <button role="tab" data-mode="all" aria-selected="false">{{ t('🌐 All names', '🌐 全部') }}</button>
    </div>
    <p class="note sb-cap" id="sb-cap"><!-- per-mode caption injected by JS --></p>
    <table class="sb-table"><thead id="sb-head"></thead><tbody id="sb-body"></tbody></table>
    <p class="note" style="margin:8px 0 0;font-size:11px">{{ t('Beta to S&P 500 overnight. Descriptive exposure, not a return forecast.', '对隔夜标普500的贝塔。描述性敞口，非收益预测。') }}</p>
    <script type="application/json" id="sb-data">{{ hk_scoreboard.modes | tojson }}</script>
    <script>
    (function () {
      var DATA;
      try { DATA = JSON.parse(document.getElementById('sb-data').textContent); } catch (e) { return; }
      var head = document.getElementById('sb-head'), body = document.getElementById('sb-body'),
          cap = document.getElementById('sb-cap'),
          seg = document.querySelector('#hk-screener .sb-seg');
      function bl(en, zh) { return '<span class="l-en">' + en + '</span><span class="l-zh">' + (zh || en) + '</span>'; }
      function ladDir(d) { return d === 'up' ? 'up' : (d === 'down' ? 'down' : 'flat'); }
      var TILT = { favored: ['favored', '占优'], exposed: ['exposed', '最受冲击'], lag: ['lags', '滞后'], neutral: ['—', '—'] };
      var COL = {
        stock: { en: 'Stock', zh: '个股', l: true, key: function (r) { return r.ticker; },
          cell: function (r) { return '<a href="hk_lookup.html#' + r.ticker + '"><b>' + r.ticker + '</b></a>' + (r.name ? ' <span class="note">' + r.name + '</span>' : ''); } },
        sector: { en: 'Sector', zh: '板块', l: true, key: function (r) { return r.sector || ''; },
          cell: function (r) { return '<span class="note">' + bl(r.sector || '—', r.sector_zh || r.sector || '—') + '</span>'; } },
        price: { en: 'Price', zh: '价格', key: function (r) { return r.price; },
          cell: function (r) { return r.price != null ? r.price.toFixed(2) : '—'; } },
        beta: { en: 'β', zh: 'β', key: function (r) { return r.beta; }, def: 'desc',
          cell: function (r) { return r.beta != null ? '<b>' + r.beta.toFixed(2) + '</b>' : '—'; } },
        pct: { en: '%ile', zh: '分位', key: function (r) { return r.beta_pct; },
          cell: function (r) { return r.beta_pct != null ? '<span class="note">' + Math.round(r.beta_pct) + '</span>' : '—'; } },
        tilt: { en: 'in this regime', zh: '当前状态下', l: true, key: null,
          cell: function (r) { var tk = TILT[r.tilt] || TILT.neutral; return '<span class="gb-tilt gb-' + (r.tilt || 'neutral') + '">' + bl(tk[0], tk[1]) + '</span>'; } },
        sb: { en: 'Southbound', zh: '南向', key: function (r) { return r.sb_z; }, def: 'desc',
          cell: function (r) { if (r.sb_z == null) return '—'; var cl = r.sb_z >= 0.6 ? 'pos' : (r.sb_z <= -0.6 ? 'neg' : ''); var own = r.sb_own != null ? ' <span class="note">' + r.sb_own + '%</span>' : ''; return '<span class="' + cl + '">' + (r.sb_z >= 0 ? '+' : '') + r.sb_z.toFixed(1) + '</span>' + own; } },
        ah: { en: 'A/H val', zh: 'A/H', key: function (r) { return r.ah_z; }, def: 'desc',
          cell: function (r) { if (r.ah_z == null) return '—'; var cl = r.ah_z >= 0.4 ? 'pos' : ''; return '<span class="' + cl + '">' + (r.ah_z >= 0 ? '+' : '') + r.ah_z.toFixed(1) + '</span>'; } },
        conv: { en: 'Conv', zh: '确信', key: function (r) { return r.conv; }, def: 'desc',
          cell: function (r) { return r.conv != null ? '<b>' + r.conv + '</b>' : '—'; } },
        cycle: { en: 'Cycle', zh: '周期', l: true, key: null,
          cell: function (r) { return r.cycle ? '<span class="lad ' + ladDir(r.cycle_dir) + '">' + bl(r.cycle, r.cycle_zh || r.cycle) + '</span>' : '—'; } }
      };
      var ORDER = ['stock', 'sector', 'beta', 'pct', 'tilt', 'sb', 'ah', 'conv', 'cycle'];
      var MODES = {
        amplifiers: { def: 'desc',
          cap: bl('Highest global-risk beta — global cyclicals (tech, miners, CXO) that move MORE with the regime. The leveraged play in Risk-on; the most exposed in Risk-off. Exposure context for sizing.', '全球风险贝塔最高 —— 随风险状态波动更大的全球周期股（科技、矿业、CXO）。风险偏好时为杠杆首选；风险规避时敞口最大。用于定仓的敞口背景。') },
        cushions: { def: 'asc',
          cap: bl('Lowest global-risk beta — domestic-defensive names (SOE energy, staples, telecom) that move LESS with the regime. They lag a rally but defend in a drawdown. For risk-aware exposure, not return maximization.', '全球风险贝塔最低 —— 随风险状态波动更小的本地防御股（国企能源、必需消费、电信）。上涨时滞后，回撤时防守。用于风险可控的敞口，而非收益最大化。') },
        all: { def: 'desc',
          cap: bl('The full HK universe ranked by global-risk beta — sort any column to screen. High beta = global cyclical (amplifier); low beta = domestic-defensive (cushion). Descriptive exposure for sizing.', '按全球风险贝塔排序的完整港股范围 —— 点击任意列筛选。高贝塔＝全球周期（放大器）；低贝塔＝本地防御（缓冲）。用于定仓的描述性敞口。') }
      };
      var cur = 'amplifiers', sortCol = null, sortDir = 'desc';
      function render() {
        var cols = ORDER.map(function (c) { return COL[c]; });
        cap.innerHTML = MODES[cur].cap;
        var hh = '<tr>';
        cols.forEach(function (c, i) {
          var sortable = c.key !== null;
          var arrow = sortable ? '<span class="sarrow">' + (sortCol === i ? (sortDir === 'desc' ? '↓' : '↑') : '↕') + '</span>' : '';
          hh += '<th class="' + (c.l ? 'l ' : '') + (sortable ? 'th-sort ' : '') + (sortCol === i ? 'sorted' : '') + '"'
              + (sortable ? ' data-i="' + i + '"' : '') + '>' + bl(c.en, c.zh) + arrow + '</th>';
        });
        head.innerHTML = hh + '</tr>';
        var rows = DATA[cur] ? DATA[cur].slice() : [];
        if (sortCol !== null && cols[sortCol] && cols[sortCol].key) {
          var kf = cols[sortCol].key, sg = sortDir === 'desc' ? -1 : 1;
          rows.sort(function (a, b) {
            var va = kf(a), vb = kf(b);
            if (va == null) va = -Infinity; if (vb == null) vb = -Infinity;
            if (typeof va === 'string' || typeof vb === 'string')
              return sg * String(va).localeCompare(String(vb), undefined, { numeric: true });
            return sg * (va - vb);
          });
        }
        body.innerHTML = rows.map(function (r) {
          return '<tr>' + cols.map(function (c) { return '<td class="' + (c.l ? 'l' : '') + '">' + c.cell(r) + '</td>'; }).join('') + '</tr>';
        }).join('') || '<tr><td>—</td></tr>';
      }
      function setMode(m) {
        cur = m;
        var d = MODES[cur].def;
        // default sort = the beta column (index 3), direction per mode
        sortCol = ORDER.indexOf('beta'); sortDir = d;
        Array.prototype.forEach.call(seg.querySelectorAll('button'), function (b) {
          b.setAttribute('aria-selected', b.getAttribute('data-mode') === m ? 'true' : 'false');
        });
        render();
      }
      seg.addEventListener('click', function (e) {
        var b = e.target.closest('button[data-mode]'); if (!b) return;
        setMode(b.getAttribute('data-mode'));
      });
      head.addEventListener('click', function (e) {
        var th = e.target.closest('th.th-sort'); if (!th) return;
        var i = parseInt(th.getAttribute('data-i'), 10);
        if (sortCol === i) sortDir = sortDir === 'desc' ? 'asc' : 'desc';
        else { sortCol = i; sortDir = 'desc'; }
        render();
      });
      setMode('amplifiers');
    })();
    </script>
  </div>
  {% endif %}

  {% endif %}{# /mode != macro — global-risk screener (exposure) #}

  {% if mode != 'stocks' %}
  {% if pb %}
  <!-- ===================== WHERE WE ARE + WHAT'S NEXT ===================== -->
  {% if pb.progress %}
  <div class="panel span6">
    <h2>{{ t('Where we are in this regime', '我们身处此周期何处') }}
      {{ help("How old this regime is compared with past similar regimes. Context only.", "当前周期年龄与历史同类周期比较。仅背景。") }}</h2>
    <div class="lifebar">
      <div class="zone" style="left:0;width:{{ pb.progress.zone_early_pct }}%;background:color-mix(in srgb,var(--up) 32%,var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_early_pct }}%;width:{{ pb.progress.zone_mid_pct - pb.progress.zone_early_pct }}%;background:color-mix(in srgb,var(--warn) 32%,var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_mid_pct }}%;width:{{ 100 - pb.progress.zone_mid_pct }}%;background:color-mix(in srgb,var(--down) 32%,var(--panel))"></div>
      <div class="marker" style="left:{{ pb.progress.bar_pct }}%"></div>
    </div>
    <div class="lifelabels"><span>{{ t('young', '年轻') }}</span><span>{{ t('mid-life', '中年') }}</span><span>{{ t('old', '年老') }}</span></div>
    <p class="note" style="margin:10px 0 0">{{ t(
      pb.progress.age_days|string + ' trading days in, vs a median of ' + pb.progress.median_days|string + ' across ' + pb.progress.n_history|string + ' past ' + latest.quad_name + ' periods.',
      '已运行 ' + pb.progress.age_days|string + ' 个交易日，对比 ' + pb.progress.n_history|string + ' 段过往同象限周期的中位数 ' + pb.progress.median_days|string + ' 个交易日。') }}</p>
  </div>
  {% endif %}
  {% if pb.next_list %}
  <div class="panel span6">
    <h2>{{ t("What's likely next", '接下来可能发生什么') }}
      {{ help("What usually came next after similar regimes. Base rates, not forecasts.", "类似周期之后通常出现什么。基础概率，非预测。") }}</h2>
    {% for n in pb.next_list %}
    <div class="prob">
      <span class="nm">{{ t(n.name, n.name_zh) }}</span>
      <span class="bar"><i style="width:{{ n.prob_pct }}%;background:var(--q{{ n.code[1] }})"></i></span>
      <span class="pc">{{ n.prob_pct }}%</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ===================== HOW TO TRADE NOW (exposure dial) ===================== -->
  <div class="panel span12">
    <h2>{{ t('How to trade the current regime', '如何交易当前周期') }}
      {{ help("The dial says how much risk current HK conditions support. Sector names are filters, not buy calls.", "刻度盘显示当前香港环境支持多少风险。板块名称是过滤器，不是买入指令。") }}</h2>
    {% if pb.quad_meaning %}<p class="note" style="margin:0 0 10px">{{ t(pb.quad_meaning.en, pb.quad_meaning.zh) }}</p>{% endif %}
    <div class="pdial">
      {% set pmap = {'DEFENSIVE':'on-def','CAREFUL':'on-car','NEUTRAL':'on-neu','CONSTRUCTIVE':'on-con','AGGRESSIVE':'on-agg'} %}
      {% set pzh = {'DEFENSIVE':'防御','CAREFUL':'谨慎','NEUTRAL':'中性','CONSTRUCTIVE':'积极','AGGRESSIVE':'进取'} %}
      {% for p in ['DEFENSIVE','CAREFUL','NEUTRAL','CONSTRUCTIVE','AGGRESSIVE'] %}
        <span class="{{ pmap[p] if pb.dial.posture==p }}">{{ t(p, pzh[p]) }}</span>
      {% endfor %}
    </div>
    {% for sign, r_en, r_zh in pb.dial.reasons %}
      <div class="reason"><span class="sig sig-{{ {'+':'p','-':'m','i':'i'}[sign] }}">{{ {'+':'+','-':'−','i':'i'}[sign] }}</span> <span>{{ t(r_en, r_zh) }}</span></div>
    {% endfor %}
    <div class="grid" style="margin-top:14px">
      <div class="span4">
        <h3>🎯 {{ t('Framework-preferred sectors', '框架偏好板块') }}{% if pb.pref_agreement is not none %} <span class="note" style="text-transform:none">· {{ t('tape agrees', '盘面一致') }} {{ (pb.pref_agreement*100)|round|int }}%</span>{% endif %}</h3>
        {% for x in pb.preferred %}
          <div class="pcard"><span class="calltag tag-pref">{{ t('PREFERRED', '偏好') }}</span><a href="sectors/{{ x.slug }}.html"><b>{{ td(x.name) }}</b></a>{% if x.rank %} <span class="note">{{ t('RS', '相对') }} #{{ x.rank }}/12</span>{% endif %}</div>
        {% else %}<p class="note">—</p>{% endfor %}
      </div>
      <div class="span4">
        <h3>✅ {{ t('Confirmed leaders', '已确认领先') }} <span class="note" style="text-transform:none">· {{ t('uptrend + momentum', '上涨趋势 + 动量') }}</span></h3>
        {% for x in pb.leaders %}
          <div class="pcard"><span class="calltag tag-lead">{{ t('LEADER', '领先') }}</span><a href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b></a>{% if x.mom20 is not none %} <span class="pos">{{ '%+.1f'|format(x.mom20) }}</span>{% endif %}</div>
        {% else %}<p class="note">{{ t('None confirmed — stay close to the index.', '无确认领先 — 紧贴指数。') }}</p>{% endfor %}
      </div>
      <div class="span4">
        <h3>🚫 {{ t('Avoid right now', '现在回避') }} <span class="note" style="text-transform:none">· {{ t('downtrend / topping', '下跌 / 见顶') }}</span></h3>
        {% for x in pb.avoid %}
          <div class="pcard"><span class="calltag tag-avoid">{{ t('AVOID', '回避') }}</span><a href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b></a> <span class="note">{{ td(x.state) }}</span></div>
        {% else %}<p class="note">{{ t('Nothing triggers the avoid rules.', '当前无标的触发回避规则。') }}</p>{% endfor %}
      </div>
    </div>
    {% if pb.honesty %}<p class="note" style="margin-top:10px">⚖️ {{ t(pb.honesty.en, pb.honesty.zh) }}</p>{% endif %}
    <p class="note" style="margin:10px 0 0;text-transform:none"><a href="hk_stocks.html" style="color:var(--link);font-weight:600">→ {{ t('HK stock & exposure board — amplifiers vs cushions, sectors & flows', '港股与敞口看板 — 放大器 vs 缓冲、板块与资金流') }}</a></p>
  </div>
  {% endif %}

  <!-- ===================== REGIME TIME MACHINE ===================== -->
  {% if lifespan_rows %}
  <div class="panel span12" id="time-machine" data-timeline="hk_regime_timeline.json">
    <h2>{{ t('⏳ Regime time machine', '⏳ 周期时光机') }}
      {{ help("Drag to replay the HK regime through history. No look-ahead.", "拖动可回放香港周期历史。无前视。") }}
    </h2>
    <div class="tm-wrap">
      <canvas id="tm-canvas" class="tm-canvas"></canvas>
      <input id="tm-range" class="tm-range" type="range" min="0" max="0" value="0" aria-label="Scrub regime history">
    </div>
    <div class="tm-controls">
      <button class="tm-btn tm-play" id="tm-play" aria-label="play/pause" title="Play / pause"><span class="tm-play-ico"></span></button>
      <span class="tm-presets">
        <button class="tm-btn" data-tm-jump="now">{{ t('Now', '现在') }}</button>
        <button class="tm-btn" data-tm-jump="2015-04-27">{{ t('2015 rally', '2015 行情') }}</button>
        <button class="tm-btn" data-tm-jump="2018-01-26">{{ t('2018 peak', '2018 高点') }}</button>
        <button class="tm-btn" data-tm-jump="2020-03-23">{{ t('2020 COVID', '2020 疫情') }}</button>
        <button class="tm-btn" data-tm-jump="2021-02-17">{{ t('2021 HS-TECH top', '2021 恒科见顶') }}</button>
      </span>
    </div>
    <div class="tm-readout">
      <div class="tm-asof">
        <span class="tm-date" id="tm-date">—</span>
        <span class="tm-state-tag is-live" id="tm-tag">—</span>
      </div>
      <div class="tm-badges">
        <span class="badge" id="tm-quad">—</span>
        <span class="badge" id="tm-trans">—</span>
        <span class="kv">{{ t('agreement', '一致度') }} <b id="tm-conf">—</b></span>
        <span class="kv">{{ t('cycle', '周期') }} <b id="tm-cyc">—</b></span>
        <span class="kv">{{ t('liquidity', '流动性') }} <b id="tm-liq">—</b></span>
      </div>
      <div class="tm-gauges">
        <div class="tm-gauge">
          <div class="tm-glabel"><span>{{ t('Growth', '增长') }}</span><span class="sub" id="tm-g-v">—</span></div>
          <div class="gauge"><i id="tm-g-i" style="left:50%"></i></div>
        </div>
        <div class="tm-gauge">
          <div class="tm-glabel"><span>{{ t('Inflation', '通胀') }}</span><span class="sub" id="tm-i-v">—</span></div>
          <div class="gauge"><i id="tm-i-i" style="left:50%"></i></div>
        </div>
      </div>
      <div class="tm-flags" id="tm-flags"></div>
    </div>
  </div>
  {% endif %}

  <!-- honest calibration framing -->
  <div class="panel span12">
    <h2>{{ t('How to read this', '如何解读') }}</h2>
    <p class="note">{{ t(
      'Read HK as a risk-context map: China fundamentals, global risk, and HK market structure. It is not a standalone buy trigger.',
      '将香港视为风险背景图：内地基本面、全球风险与香港市场结构。它不是独立买入触发器。') }}</p>
    <p class="note" style="margin-top:8px">{{ t(
      'History gives base rates, not predictions. Use the dial to size risk, then check the live drivers.',
      '历史提供基础概率，不是预测。先用刻度盘衡量风险，再看实时驱动。') }}</p>
  </div>

  {% endif %}{# /mode != stocks — macro group 2 (where/next, how-to-trade, time machine, calibration) #}

  {% if mode != 'macro' %}
  <!-- sector rotation board -->
  <div class="panel span8">
    <h2>{{ t('Sector Rotation', '板块轮动') }} <span class="note" style="text-transform:none">· {{ t('RS vs HSI', '相对恒生指数') }}</span></h2>
    <table class="sortable">
      <thead><tr>
        <th class="l">{{ t('Sector', '板块') }}</th>
        <th>{{ t('Rank', '排名') }}</th>
        <th>{{ t('20d RS', '20日相对') }}</th>
        <th>{{ t('60d RS', '60日相对') }}</th>
        <th>{{ t('200d', '200日') }}</th>
        <th>{{ t('%ile', '分位') }}</th>
        <th class="l">{{ t('Cycle state', '周期状态') }}</th>
      </tr></thead>
      <tbody>
      {% for s in sectors %}
        <tr>
          <td class="l"><a href="sectors/{{ s.ticker }}.html">{{ td(s.name) }}</a></td>
          <td>{{ s.rank if s.rank is not none else '—' }}</td>
          <td class="{{ 'pos' if (s.mom20 or 0)>=0 else 'neg' }}">{{ '%+.1f'|format(s.mom20) if s.mom20 is not none else '—' }}</td>
          <td class="{{ 'pos' if (s.mom60 or 0)>=0 else 'neg' }}">{{ '%+.1f'|format(s.mom60) if s.mom60 is not none else '—' }}</td>
          <td>{{ '↑' if s.above200 else '↓' }}</td>
          <td>{{ s.pctile|round|int if s.pctile is not none else '—' }}</td>
          <td class="l"><span class="lad {{ 'up' if s.dir=='up' else ('down' if s.dir=='down' else 'flat') }}">{{ td(s.label or s.state) }}</span>{% if s.age_short %}<span class="agechip" title="when this signal last crossed">⏱ {{ t(s.age_short, s.age_short_zh) }}</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {% endif %}{# /mode != macro — sector rotation #}

  {% if mode != 'stocks' %}
  <!-- breadth + cross-market ratios -->
  <div class="panel span4">
    <h2>{{ t('Breadth & Ratios', '宽度与比价') }}</h2>
    {% if breadth %}
    <p class="note" style="margin:0 0 6px">{{ t('Market breadth' if breadth.full else 'Large-cap breadth', '市场广度' if breadth.full else '大盘宽度') }} — {{ t('how many stocks are participating', '有多少股票在参与') }} ({{ breadth.n_members }} {{ t('names', '只') }})</p>
    <p class="{{ breadth.tone }}" style="margin:0 0 10px; font-size:12.5px; line-height:1.45">
      {{ t('Participation looks', '参与度看起来') }}
      <b>{% if breadth.state=='broad' %}{{ t('broad', '广泛') }}{% elif breadth.state=='thin' %}{{ t('thin', '稀薄') }}{% else %}{{ t('mixed', '参差') }}{% endif %}</b> —
      <b>{{ breadth.pct_above_50 }}%</b> {{ t('above 50-day', '在50日上方') }},
      <b>{{ breadth.pct_above_200 }}%</b> {{ t('above 200-day', '在200日上方') }};
      {{ t('net new highs', '净新高') }} <b>{{ '%+d'|format(breadth.net_nh) }}</b>.
      <span class="muted">{% if breadth.state=='broad' %}{{ t('Broad participation confirms the move.', '广泛参与确认了走势。') }}{% elif breadth.state=='thin' %}{{ t('Few names hold trend — rallies are fragile.', '守住趋势的个股很少 — 反弹脆弱。') }}{% else %}{{ t('No clear breadth edge either way.', '广度上无明显方向优势。') }}{% endif %}</span>
    </p>
    {% if full_breadth %}
    <p class="note" style="margin:0 0 10px;text-transform:none;font-size:12px">{{ t('Full main board', '全主板') }} ({{ full_breadth.n_members }} {{ t('names', '只') }}):
      <span class="pos">{{ full_breadth.adv }}</span> {{ t('up', '涨') }} / <span class="neg">{{ full_breadth.dec }}</span> {{ t('down', '跌') }} ·
      <b>{{ full_breadth.pct_up }}%</b> {{ t('green', '上涨') }} <span class="muted">({{ full_breadth.asof }})</span></p>
    {% endif %}
    <table>
      <tr><td class="l">{{ t('advancing vs declining', '上涨对下跌') }}</td><td><span class="pos">{{ breadth.adv }}</span> / <span class="neg">{{ breadth.dec }}</span></td></tr>
      <tr><td class="l">{{ t('% above 50-day', '50日上方占比') }}</td><td>{{ breadth.pct_above_50 }}% <span class="note">({{ '%+.0f'|format(breadth.pct50_chg20) }})</span></td></tr>
      <tr><td class="l">{{ t('% above 200-day', '200日上方占比') }}</td><td>{{ breadth.pct_above_200 }}%</td></tr>
      <tr><td class="l">{{ t('New highs − lows', '新高−新低') }}</td><td>{{ breadth.nh }} − {{ breadth.nl }}</td></tr>
      <tr><td class="l">{{ t('A-D line (20d)', '腾落线(20日)') }}</td><td class="{{ 'pos' if breadth.ad_trend=='up' else 'neg' }}">{{ '↑' if breadth.ad_trend=='up' else '↓' }}</td></tr>
    </table>
    {% endif %}
    {% if pair %}
    <p class="note" style="margin:12px 0 4px">{{ t('Key ratios (20d %)', '关键比价(20日%)') }}</p>
    <table>
      {% if pair.hshare_hsi %}<tr><td class="l">{{ t('H-shares / HSI', '国企/恒指') }}</td><td class="{{ 'pos' if pair.hshare_hsi.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.hshare_hsi.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.tech_hsi %}<tr><td class="l">{{ t('HS-TECH / HSI', '恒生科技/恒指') }}</td><td class="{{ 'pos' if pair.tech_hsi.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.tech_hsi.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.cyc_def %}<tr><td class="l">{{ t('Cyclical / Defensive', '周期/防御') }}</td><td class="{{ 'pos' if pair.cyc_def.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.cyc_def.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.usdhkd %}<tr><td class="l">{{ t('USD / HKD (peg)', '美元/港元（联汇）') }}</td><td class="{{ 'neg' if pair.usdhkd.chg_20d_pct>=0 else 'pos' }}">{{ '%+.1f'|format(pair.usdhkd.chg_20d_pct) }}</td></tr>{% endif %}
    </table>
    {% endif %}
  </div>

  {% endif %}{# /mode != stocks — breadth & ratios #}

  {% if mode != 'macro' %}
  <!-- ===================== SOUTHBOUND FLOW (南向资金) ===================== -->
  {% if internals and internals.southbound %}{% set sb = internals.southbound %}
  <div class="panel span6">
    <h2>{{ t('🇭🇰 Southbound flow', '🇭🇰 南向资金') }} <span class="note" style="text-transform:none">· {{ t('mainland → Hong Kong', '内地 → 香港') }}</span>
      {{ help("Daily mainland money flowing into HK stocks. Key liquidity context.", "每日内地资金流入港股。关键流动性背景。") }}</h2>
    <div class="stat-row">
      <div><span class="v {{ 'pos' if sb.cum_20d>=0 else 'neg' }}">{{ '%+.0f'|format(sb.cum_20d) }}</span><div class="note">{{ t('20d net (¥100M)', '20日净额(亿元)') }}</div></div>
      <div><span class="v {{ 'pos' if sb.net_z>=0 else 'neg' }}">{{ '%+.1f'|format(sb.net_z) }}σ</span><div class="note">{{ t('today vs 1y', '今日 vs 一年') }}</div></div>
      {% if sb.hold_mktcap %}<div><span class="v">{{ '{:,}'.format(sb.hold_mktcap) }}</span><div class="note">{{ t('mainland holdings (¥100M)', '内地持仓(亿元)') }}</div></div>{% endif %}
      <div><span class="v">{{ sb.pos_days_20 }}/20</span><div class="note">{{ t('net-buy days', '净买入天数') }}</div></div>
    </div>
    {{ sb.chart_html | safe }}
  </div>
  {% endif %}

  <!-- ===== SOUTHBOUND vs PRICE DIVERGENCE (display-only context) ===== -->
  {% if internals and internals.sb_divergence %}{% set d = internals.sb_divergence %}
  <div class="panel span6">
    <h2>{{ t('🔀 Southbound vs price', '🔀 南向 vs 价格') }} <span class="note" style="text-transform:none">· {{ t('flow trend vs HSI trend', '资金趋势 vs 恒指趋势') }}</span>
      {{ help("Checks whether southbound flow and Hang Seng price trend agree. Context only.", "检查南向资金趋势与恒指价格趋势是否一致。仅背景。") }}</h2>
    {% if d.state == 'insufficient' %}
    <div class="note">{{ t('Not enough history to compare.', '历史数据不足，暂无法比较。') }}</div>
    {% else %}
    <div class="stat-row">
      <div><span class="v">{{ t('Confirms','同向') if d.state=='confirms' else (t('Diverges','背离') if d.state=='diverges' else t('Mixed','中性')) }}</span><div class="note">{{ t('flow vs price', '资金 vs 价格') }} · {{ d.window_d }}{{ t('d', '日') }}</div></div>
      <div><span class="v {{ 'pos' if d.flow_z>=0 else 'neg' }}">{{ '%+.1f'|format(d.flow_z) }}σ</span><div class="note">{{ t('southbound flow trend', '南向资金趋势') }}</div></div>
      <div><span class="v {{ 'pos' if d.px_ret_pct>=0 else 'neg' }}">{{ '%+.1f'|format(d.px_ret_pct) }}%</span><div class="note">{{ t('HSI', '恒指') }} {{ d.window_d }}{{ t('d', '日') }}</div></div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% endif %}{# /mode != macro — southbound flow #}

  {% if mode != 'stocks' %}
  <!-- ===================== HKMA PEG FUNDING ===================== -->
