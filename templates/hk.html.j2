      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('Scheduled events over the next two weeks that can move the HK market — from Hong Kong, the US, and mainland China.','未来两周可能影响港股市场的定期事件 — 来自香港、美国和中国内地。') }}</div>
        {% if event_strip %}
        <table class="hkx-mt">
