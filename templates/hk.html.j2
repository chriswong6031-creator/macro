  /* ===== combined Southbound & A/H section (flow + cross-listing value, each with a read) ===== */
  #sb-ah-combined .sbah-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(228px,1fr));gap:11px;margin:6px 0 10px}
  #sb-ah-combined .sbah-card{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:11px 13px}
  #sb-ah-combined .sbah-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
