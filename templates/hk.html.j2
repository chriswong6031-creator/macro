        <div class="hkx-kv"><span class="hkx-k">{{ t('Dollar direction','美元方向') }}</span>
          <span class="hkx-v"><span class="l-en">{{ _usd_en }}</span><span class="l-zh">{{ _usd_zh }}</span></span>
        </div>
        {%- if _fxc.stale is defined and _fxc.stale and _fxc.built_date is defined and _fxc.built_date %}
