                <span class="row-pop-val"><span class="l-en">{{ _hksce.get('text') or '' }}</span><span class="l-zh">{{ _hksce.get('text_zh') or _hksce.get('text') or '' }}</span>{% if _hk_sc.get('age_short') is not none %} <span class="mut">· <span class="l-en">{{ _hk_sc.get('age_short') }}</span><span class="l-zh">{{ _hk_sc.get('age_short_zh') or _hk_sc.get('age_short') }}</span></span>{% endif %}</span></div>
