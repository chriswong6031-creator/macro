  {# dlg-aibrief: AI Summary #}
  <div class="hkx-dlg" id="hkx-dlg-aibrief">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('AI Summary — China & Hong Kong','AI简报 — 中国与香港') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
