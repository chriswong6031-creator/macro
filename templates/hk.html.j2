  <script>
  (function(){
  var _hkxOpen=null,_hkxPop=null;
  var _hkHmMounted=false;
  function hkxOpenDlg(id){
    if(document.querySelector('.hm-ov'))return;
    var d=document.getElementById(id);if(!d)return;
    document.querySelectorAll('.hkx-dlg.open').forEach(function(x){x.classList.remove('open','hkx-in','hkx-closing');});
    d.classList.add('open');document.body.style.overflow='hidden';_hkxOpen=d;
    requestAnimationFrame(function(){requestAnimationFrame(function(){d.classList.add('hkx-in');});});
    /* Lazy-mount the HK heatmap the first time the Markets dialog opens — mirrors
       china.html.j2:3391-3394; container must be visible before mountScorecard. */
    if(id==='hkx-dlg-markets'&&!_hkHmMounted){
      var mountHm=function(){
        if(_hkHmMounted||!d.classList.contains('open')||!window.MMHeatmap||!MMHeatmap.mountScorecard)return;
        _hkHmMounted=true;
        try{MMHeatmap.mountScorecard('hk-hm-embed','marketdata/hk_heatmap.json');}
        catch(e){_hkHmMounted=false;}
      };
      if(window.MMHeatmap)mountHm();
      else if(window.mmLoadHeatmap)window.mmLoadHeatmap().then(mountHm).catch(function(){});
    }
    /* Replay the ilx / Signal-Ink charts in this dialog once the panel entrance has
       settled — mirrors china.html.j2:cnxOpenDlg, so every open re-animates the ink. */
    if(window.ilxReveal){setTimeout(function(){ilxReveal(d);},340);}
  }
  /* IN-PAGE ilx charts (Hang Seng / fear gauge history / breadth waterline) are new on this
     page — every chart here used to live in a dialog, revealed by the handler above. An
     in-page figure otherwise relies solely on illus.js's IntersectionObserver, so anything
     above the fold at load could stay at its undrawn start state and render as an empty
     card. ilxReveal() is illus.js's documented fallback: it skips figures the observer
     already handled and skips display-hidden dialog charts, so only in-page ones backfill. */
  (function(){
    var go=function(){ if(window.ilxReveal){ ilxReveal(document); } };
    if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){setTimeout(go,60);});}
    else{setTimeout(go,60);}
  })();
  function hkxCloseDlg(){
    if(document.querySelector('.hm-ov'))return;
    if(!_hkxOpen)return;
    var el=_hkxOpen;_hkxOpen=null;
    var panel=el.querySelector('.hkx-dlg-panel');
    el.classList.add('hkx-closing');el.classList.remove('hkx-in');
    var fired=false;
    var done=function(){if(fired)return;fired=true;if(panel)panel.removeEventListener('transitionend',onEnd);el.classList.remove('open','hkx-closing');};
    var onEnd=function(e){if(e.target===panel)done();};
    if(panel)panel.addEventListener('transitionend',onEnd);
    setTimeout(done,360);document.body.style.overflow='';
  }
  function hkxTogglePop(id,ev){
    ev.stopPropagation();
    var p=document.getElementById(id);var was=p.classList.contains('open');
    hkxClosePops();if(!was){p.classList.add('open');_hkxPop=p;}
  }
  function hkxClosePops(){document.querySelectorAll('.hkx-pop.open').forEach(function(p){p.classList.remove('open')});_hkxPop=null;}
  document.addEventListener('click',function(e){if(_hkxPop&&!_hkxPop.contains(e.target))hkxClosePops();});
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'){
      if(document.querySelector('.hm-ov'))return;
      if(_hkxPop)hkxClosePops();else hkxCloseDlg();
    }
  });
  document.addEventListener('click',function(e){
    var btn=e.target.closest('[data-hkx-dlg]');
    if(btn){hkxOpenDlg(btn.getAttribute('data-hkx-dlg'));return;}
  });
  window.hkxOpenDlg=hkxOpenDlg;
  window.hkxCloseDlg=hkxCloseDlg;
  window.hkxTogglePop=hkxTogglePop;
  window.hkxClosePops=hkxClosePops;
  })();
  </script>
