<style>
  .rc-strip { margin:0 0 12px; }
  .rc-strip-quiet { color:var(--muted); font-size:12px; margin:0; }
  .rc-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .rc-chip { display:inline-flex; align-items:baseline; gap:6px; padding:5px 11px; border-radius:9px;
    border:1px solid var(--line); background:var(--panel2); font-size:12px; line-height:1.3; cursor:help;
    text-decoration:none; color:var(--fg); }
  .rc-chip.rc-major { border-color:color-mix(in srgb,var(--warn) 45%,var(--line)); }
  .rc-chip.rc-notable { border-color:color-mix(in srgb,var(--link) 40%,var(--line)); }
  .rc-chip .rc-arrow { color:var(--muted); }
  .rc-chip .rc-sect { color:var(--muted); }
  .rc-chip .rc-days { color:var(--muted); font-variant-numeric:tabular-nums; font-size:11px; }
</style>
<script>
(function(){
'use strict';
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function t(en,zh){return isZh()&&zh?zh:en;}
function renderStrip(ev){
  var el=document.getElementById('rc-events-hk-strip');
  if(!el) return;
  var active=(ev&&ev.active)||[];
  if(!active.length){
    el.innerHTML='<p class="rc-strip-quiet">'+t('No rotation handoffs in progress.','当前无轮动接力。')+'</p>';
    return;
  }
  var sevRank={major:0,notable:1,standard:2};
  active=active.slice().sort(function(a,b){
    var d=(sevRank[a.severity]!=null?sevRank[a.severity]:9)-(sevRank[b.severity]!=null?sevRank[b.severity]:9);
    return d!==0?d:String(b.started||'').localeCompare(String(a.started||''));
  });
  var chips=active.map(function(e){
    var sev=e.severity||'standard';
    var from=isZh()?e.from_leg.name_zh:e.from_leg.name_en;
    var to=isZh()?e.to_leg.name_zh:e.to_leg.name_en;
    var sect=isZh()?e.sector_name_zh:e.sector_name_en;
    var copy=isZh()?e.copy_zh:e.copy_en;   // full sentence -> native title (JSON copy, not t()-macro)
    return '<a class="rc-chip rc-'+esc(sev)+'" href="baskets.html" title="'+esc(copy||'')+'">'
      +'⟲ <b>'+esc(from)+'</b> <span class="rc-arrow">→</span> <b>'+esc(to)+'</b>'
      +' <span class="rc-sect">('+esc(sect)+')</span>'
      +' <span class="rc-days">· '+esc(e.day_n)+t('d','天')+'</span></a>';
  }).join('');
  el.innerHTML='<div class="rc-chips">'+chips+'</div>';
}
function loadStrip(){
  fetch('marketdata/rotation_events_hk.json',{cache:'no-cache'})
    .then(function(r){return r.ok?r.json():null;}).catch(function(){return null;})
    .then(function(data){
      if(!data){
        var el=document.getElementById('rc-events-hk-strip');
        if(el) el.innerHTML='<p class="rc-strip-quiet">'+t('No rotation handoffs in progress.','当前无轮动接力。')+'</p>';
        return;
      }
      renderStrip(data);
    });
}
loadStrip();
var _rcStripObs=new MutationObserver(loadStrip);
_rcStripObs.observe(document.documentElement,{attributes:true,attributeFilter:['data-lang']});
})();
</script>
