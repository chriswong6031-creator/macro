  body.page-hk table.hkx-mt th{font-size:9.5px;letter-spacing:.7px;text-transform:uppercase;color:var(--muted);text-align:left;padding:6px 8px;border-bottom:1px solid rgba(255,255,255,.09)}
  body.page-hk table.hkx-mt td{padding:7px 8px;border-bottom:1px solid rgba(255,255,255,.05)}
  body.page-hk table.hkx-mt td.r,body.page-hk table.hkx-mt th.r{text-align:right}
  body.page-hk .hkx-tt-dn{color:var(--down);font-weight:650} body.page-hk .hkx-tt-up{color:var(--up);font-weight:650} body.page-hk .hkx-tt-fl{color:var(--warn);font-weight:650}
  body.page-hk .hkx-cols2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  @media(max-width:980px){body.page-hk .hkx-cols2{grid-template-columns:1fr}}
  /* Mechanic #6: 2-col dialog with minmax(0,1fr) */
  body.page-hk .hkx-hm-wrap{border:1px solid rgba(255,255,255,.09);border-radius:12px;background:rgba(255,255,255,.02);padding:12px}
  body.page-hk .hkx-freshbar{background:rgba(224,160,48,.10);border:1px solid rgba(224,160,48,.3);border-radius:12px;padding:8px 14px;font-size:12px;color:var(--warn);margin-bottom:14px}
  body.page-hk .hkx-nchip{display:inline-block;font-size:10px;font-weight:650;border-radius:6px;padding:2px 8px;margin:2px 4px 0 0;background:rgba(255,255,255,.06);color:var(--muted)}
  /* Dial (VHSI gauge) */
  body.page-hk .hkx-dial{width:100%;max-width:200px;margin:0 auto;display:block}
  body.page-hk .hkx-dial-word{text-align:center;font-size:14px;font-weight:700;color:var(--warn);margin-top:-4px}
  body.page-hk .hkx-dial-sub{text-align:center;font-size:10.5px;color:var(--muted)}

  /* Mechanic #5: Dialog animation (China #2592 spec) */
  body.page-hk .hkx-dlg{position:fixed;inset:0;display:none;align-items:flex-start;justify-content:center;z-index:200;overflow:auto;padding:5vh 16px}
  body.page-hk .hkx-dlg.open{display:flex}
  body.page-hk .hkx-dlg-backdrop{position:fixed;inset:0;background:rgba(5,8,12,.6);backdrop-filter:blur(6px)}
  body.page-hk .hkx-dlg-panel{position:relative;width:min(900px,94vw);background:rgba(13,17,24,.94);border:1px solid rgba(255,255,255,.14);border-radius:20px;box-shadow:0 30px 90px rgba(0,0,0,.6);backdrop-filter:blur(28px) saturate(1.4);margin-bottom:6vh}
  body.page-hk .hkx-dlg-head{display:flex;align-items:center;justify-content:space-between;padding:16px 22px;border-bottom:1px solid rgba(255,255,255,.09)}
  body.page-hk .hkx-dlg-title{font-size:13px;font-weight:700;letter-spacing:.7px;text-transform:uppercase}
  body.page-hk .hkx-dlg-close{background:none;border:1px solid rgba(255,255,255,.16);color:var(--text);width:28px;height:28px;border-radius:50%;font-size:15px;cursor:pointer;line-height:1}
  body.page-hk .hkx-dlg-body{padding:18px 22px 22px}
  /* Mechanic #6: dialog body 2-col with minmax(0,1fr) */
  body.page-hk .hkx-dlg-body .hkx-cols2{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  @media(max-width:980px){body.page-hk .hkx-dlg-body .hkx-cols2{grid-template-columns:minmax(0,1fr)}}
  body.page-hk .hkx-dlg-body :is(.js-plotly-plot,.plotly-graph-div){max-width:100%!important}
  body.page-hk table.hkx-mt{display:block;max-width:100%;overflow-x:auto}
  @media(prefers-reduced-motion:no-preference){
    body.page-hk .hkx-dlg-backdrop{opacity:0;transition:opacity 240ms ease-out}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-backdrop{opacity:1}
    body.page-hk .hkx-dlg-panel{opacity:0;transform:translateY(14px) scale(.965);transition:opacity 320ms cubic-bezier(.22,.9,.26,1.02),transform 320ms cubic-bezier(.22,.9,.26,1.02)}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-panel{opacity:1;transform:translateY(0) scale(1)}
    body.page-hk .hkx-dlg.hkx-closing .hkx-dlg-backdrop{transition-duration:180ms}
    body.page-hk .hkx-dlg.hkx-closing .hkx-dlg-panel{transition-duration:180ms}
    body.page-hk .hkx-dlg-body > *{opacity:0;transform:translateY(10px);transition:opacity 300ms ease-out,transform 300ms cubic-bezier(.22,.9,.26,1.02)}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *{opacity:1;transform:translateY(0)}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *:nth-child(1){transition-delay:60ms}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *:nth-child(2){transition-delay:100ms}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *:nth-child(3){transition-delay:140ms}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *:nth-child(4){transition-delay:180ms}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *:nth-child(5){transition-delay:220ms}
    body.page-hk .hkx-dlg.hkx-in .hkx-dlg-body > *:nth-child(n+6){transition-delay:0ms}
    body.page-hk .hkx-dlg.hkx-closing .hkx-dlg-body > *{transition-delay:0ms!important}
  }
  @media(prefers-reduced-motion:reduce){
    body.page-hk .hkx-dlg.open .hkx-dlg-backdrop{opacity:1}
    body.page-hk .hkx-dlg.open .hkx-dlg-panel{opacity:1;transform:none}
    body.page-hk .hkx-dlg.open .hkx-dlg-body > *{opacity:1;transform:none}
  }

  /* Mechanic #9: light-mode — exact US tokens */
  [data-theme="light"] body.page-hk{--mx5-glass-bg:rgba(255,255,255,.82);--mx5-glass-border:rgba(0,0,0,.06);--mx5-pop-bg:rgba(255,255,255,.97)}
  [data-theme="light"] body.page-hk .hkx-card{box-shadow:0 4px 24px rgba(0,0,0,.09),0 1px 0 rgba(255,255,255,.95) inset}
  [data-theme="light"] body.page-hk .hkx-card[role="button"]:hover{background:rgba(255,255,255,.92);border-color:rgba(0,0,0,.14);box-shadow:0 6px 24px rgba(0,0,0,.12)}
  [data-theme="light"] body.page-hk .hkx-pop{background:rgba(255,255,255,.98);border-color:rgba(0,0,0,.1);box-shadow:0 8px 32px rgba(0,0,0,.13)}
  [data-theme="light"] body.page-hk .hkx-dlg-panel{background:rgba(255,255,255,.98);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-hk .hkx-dlg-backdrop{background:rgba(20,24,30,.34)}
  [data-theme="light"] body.page-hk .hkx-dlg-head{border-bottom-color:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-hk .hkx-dlg-close{border-color:rgba(0,0,0,.18)}
  [data-theme="light"] body.page-hk .hkx-hm-wrap{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-hk .hkx-links a,[data-theme="light"] body.page-hk .hkx-dh{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-hk .hkx-hero-left{border-right-color:rgba(0,0,0,.08)}
  [data-theme="light"] body.page-hk .hkx-row,[data-theme="light"] body.page-hk .hkx-kv,[data-theme="light"] body.page-hk .hkx-foot,[data-theme="light"] body.page-hk .hkx-stk,[data-theme="light"] body.page-hk .hkx-receipt,[data-theme="light"] body.page-hk table.hkx-mt td,[data-theme="light"] body.page-hk table.hkx-mt th,[data-theme="light"] body.page-hk .hkx-sep{border-color:rgba(0,0,0,.08)}
  [data-theme="light"] body.page-hk .hkx-pop-bar,[data-theme="light"] body.page-hk .hkx-fbar,[data-theme="light"] body.page-hk .hkx-heat i.n{background:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-hk .hkx-hbtn{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.12)}
  [data-theme="light"] body.page-hk .hkx-hbtn:hover{background:rgba(0,0,0,.06)}
  [data-theme="light"] body.page-hk .hkx-chip:not(.hot):not(.turn),[data-theme="light"] body.page-hk .hkx-ev,[data-theme="light"] body.page-hk .hkx-nchip{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-hk .hkx-regime-pill{border-color:rgba(0,0,0,.12)}
  [data-theme="light"] body.page-hk .hkx-chip.hot,[data-theme="light"] body.page-hk .hkx-imp.high{color:#b4232a}
  [data-theme="light"] body.page-hk .hkx-chip.turn{color:#1f7a44}
  [data-theme="light"] body.page-hk .hkx-tkr-btn{color:#2456a8}
</style>
</head>
<body{% if mode != 'stocks' %} class="page-hk"{% endif %}>

<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search HK stocks"
      placeholder="Search any stock — US, China, HK, Canada & more…" data-ph-zh="搜索任意股票 — 美股、A 股、港股、加股等…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="grid">

  {# FRESHNESS SENTINEL BANNER — shown at page top in BOTH modes when HK data is stale
     or degraded. The sentinel is a fail-open gate: it renders WITH a loud banner rather
     than blocking. "—" is used for null/missing values (never blank). #}
  {% if freshness and freshness.verdict in ('stale', 'degraded') and freshness.banner_message %}
  {% set _fv = freshness.verdict %}
  {% set _fb = freshness.banner_message %}
  <div class="panel span12 health-banner" id="hk-freshness-banner" style="{% if _fv == 'stale' %}border-color:color-mix(in srgb,var(--down) 50%,var(--line));background:color-mix(in srgb,var(--down) 7%,var(--panel));{% endif %}">
    <p class="hb-h">{% if _fv == 'stale' %}&#9888; {{ t('HK data STALE — do not act on displayed values', '港股数据已过期 — 请勿依据当前数值操作') }}{% else %}&#9888; {{ t('HK data degraded — some stores behind', '港股数据降级 — 部分数据来源落后') }}{% endif %}</p>
    <ul class="hb-list">
      <li class="hb-item"><span class="l-en">{{ _fb.en }}</span><span class="l-zh">{{ _fb.zh }}</span></li>
      {% if freshness.expected_session %}<li class="hb-item" style="color:var(--muted)"><span class="l-en">Expected session: {{ freshness.expected_session }}</span><span class="l-zh">预期交易日：{{ freshness.expected_session }}</span></li>{% endif %}
    </ul>
  </div>
  {% endif %}

  {% if mode != 'stocks' %}
  {# ==================== HK MX5 GLANCE+POPUP MACRO DASHBOARD ==================== #}
  {% if market_state %}{% set ms = market_state %}{% endif %}
  {# --- score gauge dasharray: track 157 total (semicircle) --- #}
  {% if ms is defined and ms %}
  {% set _score = ms.score|default(0)|int %}
  {% set _score_dash = (_score / 100 * 157)|int %}
  {% set _mscolor = ms.color|default('yellow') %}
  {% endif %}
  {# MX5 HERO #}
  <div class="hkx-aurora"></div>
  <div class="hkx-wrap ms-front ms ms-{{ ms.color if ms is defined and ms else 'yellow' }}" id="ms-front">

  {# HERO card #}
  {# hero root carries ms-front + ms-{color} so the class-driven gauge/pill CSS
     (.ms-green .hkx-gauge-fill etc.) actually has an ancestor to key on; solo
     class collapses the empty history panel until the score log accrues. #}
  <div class="hkx-card hkx-hero ms-front ms-{{ ms.color if (ms is defined and ms) else 'yellow' }}{{ ' hkx-hero-solo' if not (ms_history and ms_history|length >= 2) }}" id="hkx-hero-card">
    <div class="hkx-hero-left">
      {# regime pill = the macro QUAD word (mockup: "Stagflation"), bound from the
         signal-stack macro-regime leg so the zh twin is engine-supplied, never invented. #}
      {% set _mrleg = (signal_stack.legs | selectattr('label_en', 'equalto', 'Macro regime') | list | first) if (signal_stack and signal_stack.legs) else none %}
      {% if _mrleg %}
      <span class="hkx-regime-pill ms-{{ ms.color if (ms is defined and ms) else 'yellow' }}"><span class="hkx-rp-dot"></span>{{ t(_mrleg.state_en, _mrleg.state_zh) }}</span>
      {% elif ms is defined and ms %}
      <span class="hkx-regime-pill ms-{{ ms.color }}"><span class="hkx-rp-dot"></span>{{ t(ms.label_en, ms.label_zh) }}</span>
      {% else %}
      <span class="hkx-regime-pill ms-yellow"><span class="hkx-rp-dot"></span>{{ t('Mixed', '混合') }}</span>
      {% endif %}
      <span class="hkx-live-pill" id="ms-live-pill"><span class="hkx-lp-dot"></span>{{ t('AS OF', '截至') }} {{ latest.date if latest else '—' }}</span>
      <div class="hkx-gauge-row">
        <svg class="hkx-gauge-svg" viewBox="0 0 120 78" aria-hidden="true">
          <path d="M12 68 A50 50 0 0 1 108 68" fill="none" stroke="rgba(255,255,255,.09)" stroke-width="9" stroke-linecap="round"/>
          {% if ms is defined and ms %}
          {# stroke colour is CLASS-driven (.ms-* .hkx-gauge-fill) so it always
             matches the verdict class, never a baked colour (China #2595 lesson) #}
          <path class="hkx-gauge-fill" d="M12 68 A50 50 0 0 1 108 68" fill="none"
                stroke-width="9" stroke-linecap="round"
                stroke-dasharray="{{ _score_dash }} 200"/>
          {# needle (US idiom): rotate around arc centre (60,68); score 0→-90°…100→+90°;
             accents class-driven via .ms-* #}
          <g class="hkx-gauge-needle" transform="rotate({{ (((ms.score or 0) * 1.8) - 90) | round(1) }} 60 68)">
            <line x1="60" y1="68" x2="60" y2="31" stroke="var(--text)" stroke-width="2" stroke-linecap="round" opacity=".45"/>
            <circle class="hkx-needle-hub" cx="60" cy="68" r="5"/>
            <circle class="hkx-needle-core" cx="60" cy="68" r="1.8"/>
            <circle class="hkx-needle-tip" cx="60" cy="30" r="2.6"/>
          </g>
          {% endif %}
        </svg>
        <div>
          <div class="hkx-score-line">
            <span class="hkx-big-score" id="ms-score"
                  style="color:{{ 'var(--up)' if (ms is defined and ms and ms.color == 'green') else ('var(--warn)' if (ms is defined and ms and ms.color == 'yellow') else 'var(--down)') }}">{{ ms.score if ms is defined and ms else '—' }}</span>
            <span class="hkx-verdict" id="ms-word">{{ t(ms.label_en, ms.label_zh) if ms is defined and ms else '—' }}</span>
          </div>
          <div style="position:relative;height:5px;border-radius:3px;margin-top:7px;width:150px;background:linear-gradient(90deg,var(--down) 0%,var(--down) 42%,var(--warn) 42%,var(--warn) 60%,var(--up) 60%)">
            {% if ms is defined and ms %}<div style="position:absolute;top:-2px;left:{{ ms.score }}%;width:2px;height:9px;background:#fff;border-radius:1px"></div>{% endif %}
          </div>
          <div style="display:flex;justify-content:space-between;width:150px;font-size:8px;color:var(--muted);margin-top:2px">
            <span>{{ t('0 nervous','0 紧张') }}</span><span>42</span><span>{{ t('60+ calm','60+ 平稳') }}</span>
          </div>
        </div>
      </div>
      {% if ms is defined and ms %}
      <p class="hkx-thesis v-thesis">{{ t(ms.headline_en, ms.headline_zh or ms.headline_en) }}</p>
      <div class="hkx-flip v-flip">→ {{ t(ms.flip_en, ms.flip_zh) }}</div>
      {% endif %}
      <div class="hkx-hero-btns" style="position:relative">
        {% if signal_stack %}
        <button class="hkx-hbtn" onclick="hkxTogglePop('hkx-pop-signals',event)">&#x21B1; {{ t(signal_stack.n_bull|string + ' of ' + signal_stack.n|string + ' signals positive', signal_stack.n_bull|string + '/' + signal_stack.n|string + ' 信号偏多') }} <span class="hkx-hbtn-n">&#x25BE;</span></button>
        {% endif %}
        {% if ms is defined and ms and ms.radar is defined and ms.radar %}
        <button class="hkx-hbtn" style="{{ 'border-color:rgba(224,100,100,.5)' if ms.color == 'red' else '' }}" onclick="hkxTogglePop('hkx-pop-risk',event)">&#9888; {{ t('Drop risk', '回撤风险') }} · <span class="hkx-hbtn-n" style="{{ 'color:var(--down)' if ms.color == 'red' else '' }}">{{ t(ms.radar.label_en, ms.radar.label_zh or ms.radar.label_en) }}</span> &#x25BE;</button>
        {% endif %}
        {# signals popover #}
        <div class="hkx-pop" id="hkx-pop-signals">
          <div class="hkx-pop-h">{{ t('The checks', '信号详情') }}</div>
          {% if ms is defined and ms and ms.components is defined %}
          {% for c in ms.components %}
          <div class="hkx-pop-row">
            <div class="hkx-pop-rt"><span>{{ t(c.label_en, c.label_zh) }}</span><b style="color:{{ 'var(--up)' if c.tone == 'bull' else ('var(--down)' if c.tone == 'bear' else 'var(--warn)') }}">{{ c.score }}</b></div>
            <div class="hkx-pop-bar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'bull' else ('var(--down)' if c.tone == 'bear' else 'var(--warn)') }}"></i></div>
          </div>
          {% endfor %}
          {% else %}
          <p style="font-size:12px;color:var(--muted)">{{ t('Building…','数据积累中…') }}</p>
          {% endif %}
          <span class="hkx-pop-link" onclick="hkxClosePops();hkxOpenDlg('hkx-dlg-read')">{{ t('See the full read ↓','查看完整读数 ↓') }}</span>
        </div>
        {# risk popover #}
        <div class="hkx-pop" id="hkx-pop-risk" style="left:auto">
          <div class="hkx-pop-h">{{ t('Chance of a pullback','回撤概率') }}</div>
          {% if ms is defined and ms and ms.radar is defined and ms.radar %}
          {% set _rad = ms.radar %}
          <div class="hkx-pop-big"><span style="color:var(--down)">{{ ((_rad.dd21 * 100)|round|int)|string + '%' if _rad.dd21 is defined and _rad.dd21 else '—' }}</span><span style="font-size:12.5px;color:var(--down)">{{ t('21-day chance','21日概率') }}</span></div>
          <div class="hkx-pop-sub">{{ t(_rad.do_en, _rad.do_zh or _rad.do_en) if _rad.do_en is defined and _rad.do_en else '' }}</div>
          {% for s in _rad.scares[:3] if _rad.scares is defined %}
          <div class="hkx-pop-row">
            <div class="hkx-pop-rt"><span>{{ t(s.label_en, s.label_zh) }}</span><b>{{ s.band if s.band is defined else '' }}</b></div>
            <div class="hkx-pop-bar"><i style="width:{{ s.score }}%;background:var(--down)"></i></div>
          </div>
          {% endfor %}
          {% else %}
          <p style="font-size:12px;color:var(--muted)">{{ t('Building…','数据积累中…') }}</p>
          {% endif %}
          <span class="hkx-pop-link" onclick="hkxClosePops();hkxOpenDlg('hkx-dlg-risk')">{{ t('See the full risk read ↓','查看完整风险 ↓') }}</span>
        </div>
      </div>
      <div class="hkx-hero-vitals">
        {% if gv and gv.peg %}
        <div class="hkx-vchip{% if gv.peg.level > 7.83 %} hkx-vchip-warn{% endif %}">{{ t('HK$', '港元') }} <b>{{ '%.4f'|format(gv.peg.level) }}</b>{% if gv.peg.level > 7.83 %} — {{ t('near weak edge','接近弱方') }}{% endif %}</div>
        {% endif %}
        {% if gv %}
        <div class="hkx-vchip{% if gv.state == 'Risk-off' %} hkx-vchip-warn{% endif %}">{{ t('World mood', '全球情绪') }} <b>{{ td(gv.state) }}</b></div>
        {% endif %}
      </div>
    </div>
    <div class="hkx-hero-right">
      <div class="hkx-path-h"><span>{{ t('Last sessions','近期走势') }}</span><span id="ms-date">{{ latest.date if latest else '' }}</span></div>
      {% if ms_history and ms_history|length >= 2 %}
      {# render score history path #}
      {% set _hw = 560 %}{% set _hh = 200 %}
      {% set _n = ms_history|length %}
      <svg class="hkx-path-svg" viewBox="0 0 {{ _hw }} 240" aria-hidden="true">
        <rect x="20" y="20" width="{{ _hw - 40 }}" height="50" fill="rgba(69,184,115,.06)"/>
        <rect x="20" y="130" width="{{ _hw - 40 }}" height="50" fill="rgba(224,100,100,.06)"/>
        <line x1="20" y1="105" x2="{{ _hw - 20 }}" y2="105" stroke="rgba(224,160,48,.35)" stroke-dasharray="4 4" stroke-width="1"/>
        <text x="{{ _hw - 22 }}" y="34" font-size="9" fill="var(--up)" text-anchor="end">{{ t('Calm / buy','平稳/买') }}</text>
        <text x="{{ _hw - 22 }}" y="102" font-size="9" fill="var(--warn)" text-anchor="end">{{ t('Mixed','混合') }}</text>
        <text x="{{ _hw - 22 }}" y="182" font-size="9" fill="var(--down)" text-anchor="end">{{ t('Nervous / sell','紧张/卖') }}</text>
        {% set _pts = [] %}
        {% for h in ms_history %}
          {% set _x = (loop.index0 / (_n - 1) * (_hw - 40) + 20)|int %}
          {% set _y = ((1 - h.score / 100) * 180 + 20)|int %}
          {% if _pts.append(_x|string + ' ' + _y|string) %}{% endif %}
        {% endfor %}
        <path d="M{{ _pts|join(' L') }}" fill="none" stroke="{{ 'var(--up)' if (ms is defined and ms and ms.color == 'green') else ('var(--warn)' if (ms is defined and ms and ms.color == 'yellow') else 'var(--down)') }}" stroke-width="2.2" stroke-linejoin="round"/>
        <circle cx="{{ _pts[-1].split(' ')[0] }}" cy="{{ _pts[-1].split(' ')[1] }}" r="4.5" fill="{{ 'var(--up)' if (ms is defined and ms and ms.color == 'green') else ('var(--warn)' if (ms is defined and ms and ms.color == 'yellow') else 'var(--down)') }}"/>
        <text x="30" y="230" font-size="9" fill="var(--muted)">{{ ms_history[0].date if ms_history[0].date is defined else '' }}</text>
        <text x="{{ _hw - 22 }}" y="230" font-size="9" fill="var(--muted)" text-anchor="end">{{ ms_history[-1].date if ms_history[-1].date is defined else '' }}</text>
      </svg>
      {% else %}
      <div style="height:200px;display:flex;align-items:center;justify-content:center;border:1px dashed rgba(255,255,255,.12);border-radius:10px;font-size:11px;color:var(--muted);margin-top:8px">{{ t('Building score history…','正在积累历史分数…') }}</div>
      {% endif %}
    </div>
  </div>{# /.hkx-hero #}

  {# TILES — 4 index tiles #}
  <div class="hkx-secbar"><b>{{ t('HONG KONG DASHBOARD','香港仪表盘') }} <span style="opacity:.5;font-weight:500">香港仪表盘</span></b><span>{{ latest.date if latest else '—' }}</span></div>
  <div class="hkx-tiles">
    {% if index_health %}
    {% for ih in index_health[:4] %}
    <div class="hkx-card hkx-tile" role="button" tabindex="0"
         onclick="hkxOpenDlg('hkx-dlg-markets')">
      <div class="hkx-tile-sym">{{ ih.ticker }}</div>
      <div class="hkx-tile-nm">{{ t(ih.label, ih.label_zh if ih.label_zh is defined else ih.label) }}</div>
      <div class="hkx-tile-px">{{ ih.price if ih.price is not none else '—' }}</div>
      <div class="hkx-tile-chg chg {{ 'up' if (ih.chg is not none and ih.chg >= 0) else 'dn' }}">{{ ('%+.1f'|format(ih.chg) + '%') if ih.chg is not none else '—' }}</div>
    </div>
    {% endfor %}
    {% else %}
    {# fallback placeholder tiles #}
    <div class="hkx-card hkx-tile" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-markets')"><div class="hkx-tile-sym">HSI</div><div class="hkx-tile-nm">{{ t("Hang Seng","恒生指数") }}</div><div class="hkx-tile-px">—</div><div class="hkx-tile-chg">—</div></div>
    <div class="hkx-card hkx-tile" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-markets')"><div class="hkx-tile-sym">HSCEI</div><div class="hkx-tile-nm">{{ t("H-Shares","H股") }}</div><div class="hkx-tile-px">—</div><div class="hkx-tile-chg">—</div></div>
    <div class="hkx-card hkx-tile" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-markets')"><div class="hkx-tile-sym">HSTECH</div><div class="hkx-tile-nm">{{ t("HK Tech","港科技") }}</div><div class="hkx-tile-px">—</div><div class="hkx-tile-chg">—</div></div>
    <div class="hkx-card hkx-tile" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-markets')"><div class="hkx-tile-sym">000001.SS</div><div class="hkx-tile-nm">{{ t("Shanghai","上证") }}</div><div class="hkx-tile-px">—</div><div class="hkx-tile-chg">—</div></div>
    {% endif %}
  </div>

  {# ROW 1: What To Do + Coming Up #}
  <div class="hkx-rack2">
    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-playbook')">
      <div class="hkx-ctitle">{{ t('What To Do','操作建议') }}</div>
      {% if signal_stack and signal_stack.legs %}
      {% for leg in signal_stack.legs[:5] %}
      <div class="hkx-row">
        <span class="hkx-ic">{{ '🟢' if leg.tone == 'up' else ('🔴' if leg.tone == 'down' else '🟡') }}</span>
        <div class="hkx-tx"><b>{{ t(leg.label_en, leg.label_zh) }}</b><span class="hkx-sub">{{ t(leg.state_en, leg.state_zh) }}</span></div>
      </div>
      {% endfor %}
      {% elif ms is defined and ms %}
      <div class="hkx-row"><span class="hkx-ic">🛡</span><div class="hkx-tx"><b>{{ t(ms.headline_en, ms.headline_zh or ms.headline_en) }}</b></div></div>
      {% else %}
      <div class="hkx-row"><span class="hkx-ic">⌁</span><div class="hkx-tx"><b>{{ t('Signals building…','信号积累中…') }}</b></div></div>
      {% endif %}
    </div>
    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-events')">
      <div class="hkx-ctitle">{{ t('Coming Up','近期事件') }}<span style="margin-left:auto;font-size:10px;color:var(--muted)">{{ t('NEXT 2 WEEKS','未来2周') }}</span></div>
      {% if event_strip %}
      <div style="font-size:11.5px;color:var(--muted);margin-bottom:8px">{{ event_strip|length }} {{ t('events ahead','个事件') }}</div>
      <div class="hkx-estrip">
        {% for ev in event_strip[:4] %}
        <div class="hkx-ev">
          <div class="hkx-ev-en">{{ t(ev.name_en, ev.name_zh) }}</div>
          <div class="hkx-ev-ed">{{ ev.md if ev.md is defined else '—' }}</div>
          {% if ev.importance == 'high' %}<span class="hkx-imp high">{{ t('BIG','重要') }}</span>{% elif ev.importance == 'medium' %}<span class="hkx-imp med">{{ t('MED','中') }}</span>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p style="font-size:12px;color:var(--muted)">{{ t('No major events in the next 2 weeks.','未来2周暂无重要事件。') }}</p>
      {% endif %}
    </div>
  </div>

  {# ROW 2: Pullback Risk OR Top Stocks + Mood & Fear + Sector Temperature #}
  <div class="hkx-rack3">
    {# conditional: can_force = True → Pullback card; False → Top Stocks card #}
    {% if latest and latest.risk_radar is defined and latest.risk_radar and latest.risk_radar.can_force %}
    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-risk')"
         style="{{ 'border-color:rgba(224,100,100,.35)' if ms is defined and ms and ms.color == 'red' else '' }}">
      <div class="hkx-ctitle">{{ t('Chance of a Pullback','回撤风险') }}<span class="hkx-alert-pill" style="{{ 'background:rgba(224,100,100,.16);color:var(--down)' if ms is defined and ms and ms.color == 'red' else '' }}">{{ t('HIGH','高') if ms is defined and ms and ms.color == 'red' else t('WATCH','观察') }}</span></div>
      {% if ms is defined and ms and ms.radar is defined and ms.radar %}
      {% set _rad = ms.radar %}
      <div class="hkx-bignum" style="color:var(--down)">{{ ((_rad.dd21 * 100)|round|int)|string + '%' if _rad.dd21 is defined and _rad.dd21 else t('Elevated','偏高') }}</div>
      <div class="hkx-bigsub" style="color:var(--down)">{{ t(_rad.do_en, _rad.do_zh or _rad.do_en) if _rad.do_en is defined and _rad.do_en else t('Raise some cash','适当减仓') }}</div>
      {% for s in _rad.scares[:2] if _rad.scares is defined %}
      <div class="hkx-kv"><span class="hkx-k">{{ t(s.label_en, s.label_zh) }}</span><span class="hkx-v">{{ s.band if s.band is defined else '—' }}</span></div>
      {% endfor %}
      {% else %}
      <div class="hkx-bignum">—</div>
      {% endif %}
      <div class="hkx-foot">{{ t("HK's swings come mostly from outside — global moves, not local problems.",'香港波动主要来自外部，而非本地问题。') }}</div>
    </div>
    {% else %}
    <div class="hkx-card">
      <div class="hkx-ctitle">{{ t('Stocks Worth Watching','值得关注的个股') }}<span style="margin-left:auto;font-size:10px;color:var(--muted)">{{ t('FROM THE STOCK BOARD','来自港股看板') }}</span></div>
      {% if top_setups and top_setups|length > 0 %}
      {% for s in top_setups[:5] %}
      <div class="hkx-stk">
        <a class="hkx-tkr-btn" href="hk_lookup.html#{{ s.ticker }}">{{ t(s.name, s.name_zh) if s.name is defined else s.ticker }}</a>
        <div class="hkx-stk-meta"><b>{{ s.ticker }}</b> · {{ t(s.sector, s.sector_zh if s.sector_zh is defined else s.sector) if s.sector is defined else '' }}</div>
        <span class="hkx-stage">{{ t(s.label, s.label_zh) if s.label is defined else '' }}</span>
      </div>
      {% endfor %}
      {% elif setups and setups.watch %}
      {% for s in setups.watch[:5] %}
      <div class="hkx-stk">
        <a class="hkx-tkr-btn" href="hk_lookup.html#{{ s.ticker }}">{{ t(s.name, s.name_zh) if s.name is defined else s.ticker }}</a>
        <div class="hkx-stk-meta"><b>{{ s.ticker }}</b> · {{ t(s.sector, s.sector_zh if s.sector_zh is defined else s.sector) if s.sector is defined else '' }}</div>
        <span class="hkx-stage">{{ t(s.label, s.label_zh) if s.label is defined else '' }}</span>
      </div>
      {% endfor %}
      {% else %}
      <p style="font-size:12px;color:var(--muted)">{{ t('No setups ready right now.','暂无就绪的设置。') }}</p>
      {% endif %}
      <a class="hkx-screener-btn" href="hk_stocks.html">{{ t('See all HK stocks →','查看全部港股 →') }}</a>
    </div>
    {% endif %}

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-sentiment')">
      <div class="hkx-ctitle">{{ t('Mood & Fear','市场情绪') }}</div>
      {% if vhsi %}
      {% set _vhsi_angle = (vhsi.pctile / 100 * 180 - 90)|int %}
      <svg class="hkx-dial" viewBox="0 0 200 108">
        <defs><linearGradient id="hkdg" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="var(--down)"/><stop offset=".5" stop-color="var(--warn)"/><stop offset="1" stop-color="var(--up)"/></linearGradient></defs>
        <path d="M18 96 A82 82 0 0 1 182 96" fill="none" stroke="url(#hkdg)" stroke-width="11" stroke-linecap="round" opacity=".8"/>
        {# needle angle: pctile 0=left(-90deg), 100=right(+90deg) #}
        {% set _nx = (100 + 80 * ((vhsi.pctile / 100 * 2 - 1) * 0.866))|int %}
        {% set _ny = (96 - 80 * (1 - (vhsi.pctile / 100 * 2 - 1) * (vhsi.pctile / 100 * 2 - 1)) ** 0.5)|int %}
        <line x1="100" y1="96" x2="{{ _nx }}" y2="{{ _ny }}" stroke="var(--text)" stroke-width="2.4"/>
        <circle cx="100" cy="96" r="5" fill="var(--text)"/>
        <text x="16" y="106" font-size="9" fill="var(--muted)">{{ t('FEAR','恐慌') }}</text>
        <text x="150" y="106" font-size="9" fill="var(--muted)">{{ t('GREED','贪婪') }}</text>
      </svg>
      <div class="hkx-dial-word">{{ vhsi.level }} · {{ t('VHSI','恒指波动') }}</div>
      <div class="hkx-dial-sub">{{ vhsi.pctile }}{{ t('th pctile','百分位') }}</div>
      {% else %}
      <div style="height:80px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px">{{ t('Building…','积累中…') }}</div>
      {% endif %}
    </div>

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-sector')">
      <div class="hkx-ctitle">{{ t('Which Sectors Are Hot','板块温度') }}</div>
      {% if sectors %}
      {# hot = top 3 by mom20 desc #}
      {% set _hot_secs = sectors|selectattr('mom20','defined')|selectattr('mom20','ne',none)|list|sort(attribute='mom20',reverse=true)|list %}
      {% set _turn_secs = sectors|selectattr('dir','eq','up')|list %}
      {% if _hot_secs %}
      <div class="hkx-lbl">{{ t('Hot — already run, don’t chase','热门 — 已涨，勿追') }}</div>
      <div class="hkx-chips">{% for s in _hot_secs[:3] %}<span class="hkx-chip hot">{{ t(s.name.en if s.name is mapping else s.name, s.name.zh if s.name is mapping else s.name) }}</span>{% endfor %}</div>
      {% endif %}
      {% if _turn_secs %}
      <div class="hkx-lbl">{{ t('Turning up — cheap and getting bought','转强 — 便宜且被资金买入') }}</div>
      <div class="hkx-chips">{% for s in _turn_secs[:3] %}<span class="hkx-chip turn">{{ t(s.name.en if s.name is mapping else s.name, s.name.zh if s.name is mapping else s.name) }}</span>{% endfor %}</div>
      {% endif %}
      <div class="hkx-lbl">{{ t('Sector heat · green = leading · red = lagging','板块温度 · 绿=领涨 · 红=滞涨') }}</div>
      <div class="hkx-heat">
        {% for s in sectors[:12] %}
        <i class="{{ 'c' if (s.mom20 is not none and s.mom20 < -1) else ('c2' if (s.mom20 is not none and s.mom20 < 0) else ('n' if (s.mom20 is none) else ('h3' if s.mom20 < 1 else ('h2' if s.mom20 < 3 else '')))) }}"></i>
        {% endfor %}
      </div>
      {% else %}
      <p style="font-size:12px;color:var(--muted)">{{ t('Building…','积累中…') }}</p>
      {% endif %}
    </div>
  </div>

  {# ROW 3: Currency & Rates + Mainland Buying + Overnight & Leverage #}
  <div class="hkx-rack3">
    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-policy')">
      <div class="hkx-ctitle">{{ t('Currency & Interest Rates','货币与利率') }}</div>
      {% if gv and gv.peg %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('HK dollar','港元') }}</span><span class="hkx-v"><span class="hkx-stword {{ 'bad' if gv.peg.level > 7.83 else 'ok' }}">{{ '%.4f'|format(gv.peg.level) }}</span>{% if gv.peg.level > 7.83 %} — {{ t('near its weak edge','接近弱方') }}{% endif %}</span></div>
      {# peg band bar #}
      <div class="hkx-pegband"><div class="hkx-mark" style="left:{{ ((gv.peg.level - 7.75) / 0.10 * 100)|int }}%"></div><div class="hkx-ends"><span>{{ t('strong 7.75','强 7.75') }}</span><span>{{ t('weak 7.85','弱 7.85') }}</span></div></div>
      {% endif %}
      {% if funding %}
      <div class="hkx-kv" style="margin-top:12px"><span class="hkx-k">{{ t('HK interest rate','香港利率') }}</span><span class="hkx-v"><span class="hkx-stword warn">{{ funding.hibor_1m }}%</span> {{ t('HIBOR 1m','HIBOR 1月') }}</span></div>
      {% endif %}
      <div class="hkx-kv"><span class="hkx-k">{{ t("China's central bank",'中国央行') }}</span><span class="hkx-v"><span class="hkx-stword ok">{{ t('Supportive','支持') }}</span></span></div>
      <div class="hkx-foot">{{ t("HK's borrowing costs follow US rates; HK company profits follow China's economy.",'香港借贷成本随美联储；港股盈利随中国经济。') }}</div>
    </div>

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-flows')">
      <div class="hkx-ctitle">{{ t('Mainland Buying & Value','南向资金与价值') }}</div>
      {% if internals and internals.southbound and internals.southbound.net is not none %}
      {% set _sbn = internals.southbound.net %}
      {% set _sbn_bn = (_sbn / 1000)|round(1) %}
      <div class="hkx-bignum" style="color:{{ 'var(--up)' if _sbn >= 0 else 'var(--down)' }}">{{ '~¥%.0fbn'|format(_sbn_bn|abs) }}</div>
      <div class="hkx-bigsub" style="color:{{ 'var(--up)' if _sbn >= 0 else 'var(--down)' }}">{{ t('Mainland money bought HK today','内地今日净买入港股') if _sbn >= 0 else t('Mainland money sold HK today','内地今日净卖出港股') }}</div>
      {% if internals.southbound.pos_days_20 is not none %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('How often lately','近期频率') }}</span><span class="hkx-v">{{ t('bought on','净买入') }} {{ internals.southbound.pos_days_20 }} {{ t('of last 20 days','天（近20日）') }}</span></div>
      {% endif %}
      {% else %}
      <div class="hkx-bignum">—</div>
      {% endif %}
      {% if ah_official and ah_official.premium_pct is not none %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('A bargain too','估值优势') }}</span><span class="hkx-v">{{ t('A/H premium','A/H溢价') }} {{ '%.1f'|format(ah_official.premium_pct) }}% ({{ ah_official.pctile }}{{ t('th pctile','百分位') }})</span></div>
      {% endif %}
      <div class="hkx-foot">{{ t('Mainland money is HK\'s steady buyer — and HK is the cheaper of the two markets.','内地资金是港股最稳定的买家，港股估值更便宜。') }}</div>
    </div>

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-overnight')">
      <div class="hkx-ctitle">{{ t('Overnight & Leverage','隔夜与杠杆') }}</div>
      {% if adr_bridge and adr_bridge.composite %}
      {% set _adr = adr_bridge.composite %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('US overnight read','美股隔夜读数') }}</span><span class="hkx-v"><span class="hkx-stword {{ 'ok' if (_adr.bellwether_implied_open_pct is not none and _adr.bellwether_implied_open_pct > 0.2) else ('bad' if (_adr.bellwether_implied_open_pct is not none and _adr.bellwether_implied_open_pct < -0.2) else 'warn') }}">{{ ('%.1f'|format(_adr.bellwether_implied_open_pct) + '%') if _adr.bellwether_implied_open_pct is not none else '—' }}</span>{{ t(' implied open',' 隐含开盘') }}</span></div>
      {% if _adr.gap_context %}<div style="font-size:11px;color:var(--muted);margin-bottom:8px">{{ t(_adr.gap_context, _adr.gap_context) }}</div>{% endif %}
      {% else %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('US overnight read','美股隔夜读数') }}</span><span class="hkx-v">—</span></div>
      {% endif %}
      {% if cbbc_map and cbbc_map.bellwethers %}
      {% set _cb = cbbc_map.bellwethers[0] %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('Leverage bets','杠杆仓位') }}</span><span class="hkx-v"><span class="hkx-stword {{ 'bad' if _cb.leverage_state == 'bearish' else ('ok' if _cb.leverage_state == 'bullish' else 'warn') }}">{{ t('Lean bearish','偏空') if _cb.leverage_state == 'bearish' else (t('Lean bullish','偏多') if _cb.leverage_state == 'bullish' else t('Balanced','均衡')) }}</span></span></div>
      {% if _cb.bull_outstanding is not none and _cb.bear_outstanding is not none %}
      {% set _tot = _cb.bull_outstanding + _cb.bear_outstanding %}
      <div class="hkx-bbar">
        <span class="hkx-bull" style="width:{{ (_cb.bull_outstanding / _tot * 100)|int }}%"></span>
        <span class="hkx-bear" style="width:{{ (_cb.bear_outstanding / _tot * 100)|int }}%"></span>
      </div>
      {% endif %}
      {% endif %}
      <div class="hkx-foot">{{ t('An early read on tomorrow\'s open, plus where crowded leveraged bets could speed up a move.','对明日开盘的早期读数，以及集中杠杆仓位可能加速行情的位置。') }}</div>
    </div>
  </div>

  {# ROW 4: News & Filings + Property + AI Brief #}
  <div class="hkx-rack3">
    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-news')">
      <div class="hkx-ctitle">{{ t('News & Company Filings','新闻与公司公告') }}</div>
