  [data-theme="light"] body.page-hk{--mx5-glass-bg:rgba(255,255,255,.82);--mx5-glass-border:rgba(0,0,0,.06);--mx5-pop-bg:rgba(255,255,255,.97)}
  [data-theme="light"] body.page-hk .hkx-card{box-shadow:0 4px 24px rgba(0,0,0,.09),0 1px 0 rgba(255,255,255,.95) inset}
  [data-theme="light"] body.page-hk .hkx-card[role="button"]:hover{background:rgba(255,255,255,.92);border-color:rgba(0,0,0,.14);box-shadow:0 6px 24px rgba(0,0,0,.12)}
  [data-theme="light"] body.page-hk .hkx-pop{background:rgba(255,255,255,.98);border-color:rgba(0,0,0,.1);box-shadow:0 8px 32px rgba(0,0,0,.13)}
  [data-theme="light"] body.page-hk .hkx-dlg-panel{background:rgba(255,255,255,.98);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-hk .hkx-dlg-backdrop{background:rgba(20,24,30,.34)}
  [data-theme="light"] body.page-hk .hkx-dlg-head{border-bottom-color:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-hk .hkx-dlg-close{border-color:rgba(0,0,0,.18)}
  [data-theme="light"] body.page-hk .hkx-hm-wrap{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-hk .hkx-links a,[data-theme="light"] body.page-hk .hkx-dh{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-hk .hkx-hero-left{border-right-color:rgba(0,0,0,.08)}
  [data-theme="light"] body.page-hk .hkx-row,[data-theme="light"] body.page-hk .hkx-kv,[data-theme="light"] body.page-hk .hkx-foot,[data-theme="light"] body.page-hk .hkx-stk,[data-theme="light"] body.page-hk .hkx-receipt,[data-theme="light"] body.page-hk table.hkx-mt td,[data-theme="light"] body.page-hk table.hkx-mt th,[data-theme="light"] body.page-hk .hkx-sep{border-color:rgba(0,0,0,.08)}
  [data-theme="light"] body.page-hk .hkx-pop-bar,[data-theme="light"] body.page-hk .hkx-fbar,[data-theme="light"] body.page-hk .hkx-heat i.n{background:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-hk .hkx-hbtn{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.12)}
  [data-theme="light"] body.page-hk .hkx-hbtn:hover{background:rgba(0,0,0,.06)}
  [data-theme="light"] body.page-hk .hkx-chip:not(.hot):not(.turn),[data-theme="light"] body.page-hk .hkx-ev,[data-theme="light"] body.page-hk .hkx-nchip{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-hk .hkx-regime-pill{border-color:rgba(0,0,0,.12)}
  [data-theme="light"] body.page-hk .hkx-chip.hot,[data-theme="light"] body.page-hk .hkx-imp.high{color:#b4232a}
  [data-theme="light"] body.page-hk .hkx-chip.turn{color:#1f7a44}
  [data-theme="light"] body.page-hk .hkx-tkr-btn{color:#2456a8}

  /* ═══════════════════════════════════════════════════════════════════
     MX5 SCORECARD SYSTEM — ported from templates/dashboard.html.j2 (US macro
     exemplar), re-scoped body.page-macro.mx4-grid → body.page-hk. Components:
     A hero regime odometer · B 60-session verdict-band path · C combined
     index face · D sentiment odometer. Accent routes through --up/--warn/--down
     so STATE drives the glance AND the zh 红涨绿跌 swap flips it. */
  /* ── v5 glass tokens (HK layer) ── */
  body.page-hk{
    --mx5-glass-bg:      rgba(16,22,30,.55);
    --mx5-pop-bg:        rgba(13,18,26,.96);
    --mx5-glass-border:  rgba(255,255,255,.12);
    --mx5-glass-shadow:  0 8px 32px rgba(0,0,0,.55), 0 1.5px 0 rgba(255,255,255,.07) inset;
    --mx5-blur:          blur(20px);
    --mx5-radius-card:   18px;
    --mx5-radius-pill:   999px;
    --mx5-accent:        var(--up,#22d97a);
    --mx5-accent-glow:   color-mix(in srgb,var(--up) 30%,transparent);
    --mx5-accent-dim:    color-mix(in srgb,var(--up) 10%,transparent);
    --mx5-warn:          var(--warn,#f59e0b);
    --mx5-warn-dim:      color-mix(in srgb,var(--warn) 10%,transparent);
    --mx5-accent-ink:    var(--up);
    --mx5-warn-ink:      var(--warn);
    --mx5-hover-bg:      rgba(22,29,38,.62);
    --mx5-hover-border:  rgba(255,255,255,.16);
    --mx5-hover-shadow:  0 6px 24px rgba(0,0,0,.25);
    --mx5-focus-ring:    0 0 0 2px color-mix(in srgb,var(--up) 55%,transparent);
    --ink-1: var(--text);
    --ink-2: var(--muted);
    --ink-3: color-mix(in srgb,var(--muted) 70%,transparent);
  }
  [data-theme="light"] body.page-hk{
    --mx5-glass-shadow:  0 4px 24px rgba(0,0,0,.09), 0 1px 0 rgba(255,255,255,.95) inset;
    --mx5-accent-ink:    #17753f;
    --mx5-warn-ink:      #9c6212;
    --mx5-hover-bg:      rgba(255,255,255,.92);
    --mx5-hover-border:  rgba(0,0,0,.14);
    --mx5-hover-shadow:  0 6px 24px rgba(0,0,0,.12);
  }
  /* STATE → accent (routes through --up/--warn/--down → flips in zh) */
  body.page-hk .mx5-score-green  { --mx5-gauge: var(--up);   --mx5-accent: var(--up);   }
  body.page-hk .mx5-score-yellow { --mx5-gauge: var(--warn); --mx5-accent: var(--warn); }
  body.page-hk .mx5-score-red    { --mx5-gauge: var(--down); --mx5-accent: var(--down); }

  /* ── A · Hero gauge cluster ── */
  body.page-hk .mx5-sc-gauge-row{display:flex;align-items:center;gap:20px;margin-bottom:14px;flex-wrap:wrap;
    --mx5-accent-glow:color-mix(in srgb,var(--mx5-accent) 30%,transparent);
    --mx5-accent-dim:color-mix(in srgb,var(--mx5-accent) 10%,transparent);}
  body.page-hk .mx5-gauge-svg{width:176px;height:127px;overflow:visible;display:block;flex-shrink:0;}
  [data-theme="light"] body.page-hk .mx5-gauge-svg > text{fill:rgba(10,16,24,.42);}
  [data-theme="light"] body.page-hk .mx5-gauge-svg path:first-of-type{stroke:rgba(10,16,24,.10);}
  [data-theme="light"] body.page-hk .mx5-gauge-svg g[stroke]{stroke:rgba(10,16,24,.20);}
  /* CSS wins over SVG presentation attr → arc + numeral recolour by state (var() resolves here) */
  body.page-hk #mx5-gauge-arc-fill { stroke: var(--mx5-gauge, #f59e0b); }
  /* The big score beside the gauge already states the number; the in-arc numeral +
     "/100" collided with the needle hub at glance size → hidden (remove-one-accessory).
     The arc fill + needle still encode the 0–100 position visually. */
  body.page-hk #mx5-score-numeral,
  body.page-hk .mx5-gauge-svg text:last-of-type{ display:none; }
  /* needle accent parts recolour by state (CSS property beats the SVG fill/stroke attr)
     so the hub ring, core dot + tip flip 红涨绿跌 in zh alongside the arc + numeral */
  body.page-hk .mx5-needle-ring{stroke:var(--mx5-gauge,#f59e0b);}
  body.page-hk .mx5-needle-fill{fill:var(--mx5-gauge,#f59e0b);}
  body.page-hk .mx5-score-line{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;}
  body.page-hk .mx5-verdict-word{white-space:nowrap;font-size:19px;font-weight:700;color:var(--ink-1);}
  body.page-hk .mx5-big-score{font-size:60px;font-weight:800;line-height:.95;color:var(--mx5-accent-ink);
    text-shadow:0 0 40px var(--mx5-accent-glow);letter-spacing:-.035em;font-variant-numeric:tabular-nums;}
  body.page-hk .mx5-score-green .mx5-big-score{color:var(--up);text-shadow:0 0 36px color-mix(in srgb,var(--up) 30%,transparent);}
  body.page-hk .mx5-score-yellow .mx5-big-score{color:var(--warn);text-shadow:0 0 36px color-mix(in srgb,var(--warn) 30%,transparent);}
  body.page-hk .mx5-score-red .mx5-big-score{color:var(--down);text-shadow:0 0 36px color-mix(in srgb,var(--down) 30%,transparent);}
  body.page-hk .mx5-sub-line{font-size:11px;color:var(--mx5-accent-ink);font-weight:600;margin-top:3px;}
  body.page-hk .mx5-score-yellow .mx5-sub-line{color:var(--mx5-warn-ink);}
  body.page-hk .mx5-score-red .mx5-sub-line{color:var(--down);}

  /* ── B · 60-session path panel ── */
  body.page-hk .mx5-sc-right{display:flex;flex-direction:column;flex:1;min-width:0;}
  body.page-hk .mx5-path-header{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;}
  body.page-hk .mx5-path-title{font-size:11px;font-weight:700;letter-spacing:.10em;text-transform:uppercase;color:var(--ink-3);}
  body.page-hk .mx5-path-meta{font-size:11px;color:var(--ink-3);}
  body.page-hk .mx5-path-plot{position:relative;flex:1;min-height:180px;display:flex;}
  body.page-hk .mx5-path-svg{display:block;width:100%;flex:1;min-height:180px;overflow:visible;touch-action:pan-y;}
  body.page-hk .mx5-path-labels{position:absolute;inset:0;pointer-events:none;font-family:Inter,-apple-system,sans-serif;font-size:11px;line-height:1;}
  body.page-hk .mx5-path-labels > span{position:absolute;white-space:nowrap;}
  body.page-hk .mx5-pl-y{left:4px;transform:translateY(-50%);color:var(--ink-3);font-variant-numeric:tabular-nums;}
  body.page-hk .mx5-pl-zone{right:10px;transform:translateY(-50%);font-weight:600;}
  body.page-hk .mx5-pl-zone.on{color:color-mix(in srgb,var(--up) 78%,transparent);}
  body.page-hk .mx5-pl-zone.mid{color:color-mix(in srgb,var(--warn) 80%,transparent);}
  body.page-hk .mx5-pl-zone.off{color:color-mix(in srgb,var(--down) 78%,transparent);}
  body.page-hk .mx5-pl-x{top:96.4%;color:var(--ink-3);}
  body.page-hk .mx5-pl-today{width:9px;height:9px;border-radius:50%;transform:translate(-50%,-50%);background:currentColor;box-shadow:0 0 6px currentColor;}
  body.page-hk .mx5-path-cross{position:absolute;top:0;width:1px;height:100%;background:linear-gradient(rgba(255,255,255,.28),rgba(255,255,255,.06));opacity:0;transform:translateX(-1px);pointer-events:none;transition:opacity .12s ease-out;will-change:left,opacity;}
  body.page-hk .mx5-path-dot{position:absolute;width:11px;height:11px;border-radius:50%;background:var(--mx5-accent);border:2px solid var(--mx5-pop-bg,#0d121a);box-shadow:0 0 10px var(--mx5-accent-glow),0 0 0 1px rgba(255,255,255,.25);opacity:0;pointer-events:none;transform:translate(-50%,-50%);transition:opacity .12s ease-out;will-change:left,top,opacity;}
  body.page-hk .mx5-path-tip{position:absolute;z-index:6;pointer-events:none;display:flex;flex-direction:column;gap:2px;padding:8px 11px;border-radius:10px;background:rgba(15,19,26,.72);border:1px solid rgba(255,255,255,.12);box-shadow:0 8px 30px rgba(0,0,0,.5);backdrop-filter:blur(16px) saturate(1.3);-webkit-backdrop-filter:blur(16px) saturate(1.3);opacity:0;transform:translate(-50%,calc(-100% - 14px)) translateY(4px);transition:opacity .13s ease-out,transform .13s ease-out;white-space:nowrap;}
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){body.page-hk .mx5-path-tip{background:var(--mx5-pop-bg,rgba(13,18,26,.98));}}
  [data-theme="light"] body.page-hk .mx5-path-tip{background:rgba(255,255,255,.82);border-color:rgba(0,0,0,.10);box-shadow:0 8px 30px rgba(0,0,0,.16);}
  body.page-hk .mx5-path-tip.show{opacity:1;transform:translate(-50%,calc(-100% - 14px));}
  body.page-hk .mx5-path-tip-date{font-size:11px;font-weight:600;letter-spacing:.03em;color:var(--ink-3);text-transform:uppercase;}
  [data-theme="light"] body.page-hk .mx5-path-tip-date{color:rgba(0,0,0,.5);}
  body.page-hk .mx5-path-tip-row{display:flex;align-items:baseline;gap:7px;}
  body.page-hk .mx5-path-tip-score{font-size:16px;font-weight:800;line-height:1;color:var(--ink-1);font-variant-numeric:tabular-nums;}
  [data-theme="light"] body.page-hk .mx5-path-tip-score{color:rgba(0,0,0,.9);}
  body.page-hk .mx5-path-tip-verdict{font-size:12px;font-weight:600;}
  @media(max-width:820px){body.page-hk .mx5-sc-right{display:none;}}

  /* ── C · Combined-index face + market grid ── */
  body.page-hk .sxg-face.mx5-card-face{display:flex;flex-direction:column;padding:16px 18px 12px;cursor:pointer;
    border-radius:var(--mx5-radius-card);background:var(--mx5-glass-bg);border:1px solid var(--mx5-glass-border);
    backdrop-filter:var(--mx5-blur);box-shadow:var(--mx5-glass-shadow);user-select:none;position:relative;
    font:inherit;text-align:left;width:100%;color:inherit;box-sizing:border-box;
    transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;margin-bottom:14px;}
  body.page-hk .sxg-face.mx5-card-face::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(135deg,rgba(255,255,255,.04) 0%,transparent 55%);pointer-events:none;}
  body.page-hk .sxg-face.mx5-card-face:hover{background:var(--mx5-hover-bg);border-color:var(--mx5-hover-border);box-shadow:var(--mx5-hover-shadow);transform:translateY(-1px);}
  body.page-hk .sxg-face.mx5-card-face:focus-visible{outline:none;box-shadow:var(--mx5-focus-ring),var(--mx5-hover-shadow);}
  body.page-hk .mx5-face-eyebrow{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);display:flex;align-items:center;gap:6px;margin-bottom:12px;position:relative;}
  body.page-hk .mx5-face-eyebrow::after{content:'';flex:1;height:1px;background:color-mix(in srgb,var(--line,var(--muted)) 35%,transparent);}
  body.page-hk .mx5-mkt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media(max-width:1100px){body.page-hk .mx5-mkt-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){body.page-hk .mx5-mkt-grid{grid-template-columns:1fr 1fr;}}
  body.page-hk .mx5-mkt-tile{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:14px 16px 11px;position:relative;overflow:hidden;transition:background .2s ease-out,border-color .2s ease-out;}
  [data-theme="light"] body.page-hk .mx5-mkt-tile{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.07);}
  body.page-hk .mx5-mkt-ticker{font-size:11px;font-weight:700;letter-spacing:.07em;color:var(--ink-3);text-transform:uppercase;margin-bottom:3px;}
  body.page-hk .mx5-mkt-sub{font-size:11px;color:var(--ink-3);letter-spacing:.04em;text-transform:uppercase;margin-bottom:4px;}
  body.page-hk .mx5-mkt-price{font-size:18px;font-weight:700;line-height:1;color:var(--ink-1);margin-bottom:4px;font-variant-numeric:tabular-nums;}
  body.page-hk .mx5-mkt-delta{font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;}
  body.page-hk .mx5-mkt-delta.up{color:var(--up);}
  body.page-hk .mx5-mkt-delta.dn{color:var(--down);}
  body.page-hk .mx5-face-open{font-size:11px;color:var(--ink-3);margin-top:12px;font-weight:600;}

  /* ── D · Sentiment odometer (Mood & Fear) ── */
  /* HK dial = inverted VHSI: high fear → needle LEFT (panic). fg-fear→--down, fg-greed→--up,
     neutral→--warn; --fg-col routes through those so it flips 红涨绿跌 in zh. */
  body.page-hk .fg-greed{--fg-col:var(--up)} body.page-hk .fg-fear{--fg-col:var(--down)} body.page-hk .fg-neutral{--fg-col:var(--warn)}
  body.page-hk #hkx-sentiment .fg-mark-s{stroke:var(--fg-col)} body.page-hk #hkx-sentiment .fg-mark-f{fill:var(--fg-col)}
  body.page-hk #hkx-sentiment .fg-lab-panic{fill:var(--down)} body.page-hk #hkx-sentiment .fg-lab-euph{fill:var(--up)}
  body.page-hk .mx5-sentiment-dial-wrap{text-align:center;margin-bottom:4px;}
  body.page-hk .mx5-sentiment-zone-text{font-size:15px;font-weight:700;color:var(--fg-col,var(--warn));text-align:center;margin-bottom:3px;}
  body.page-hk .mx5-sentiment-label{font-size:11px;color:var(--ink-3);text-align:center;margin-top:2px;}

  /* ── AI BRIEF DIALOG — ABX v2 shared body (.aib2-*); ZH-safe blue accent by default ── */
{% include "_aibrief_css.j2" %}
</style>
</head>
<body{% if mode != 'stocks' %} class="page-hk"{% endif %}>

{% include "_site_nav.html.j2" %}

<div class="grid">

  {# FRESHNESS SENTINEL BANNER — shown at page top in BOTH modes when HK data is stale
     or degraded. The sentinel is a fail-open gate: it renders WITH a loud banner rather
     than blocking. "—" is used for null/missing values (never blank). #}
  {% if freshness and freshness.verdict in ('stale', 'degraded') and freshness.banner_message %}
  {% set _fv = freshness.verdict %}
  {% set _fb = freshness.banner_message %}
  {% if _fv == 'stale' %}
  {# STALE → loud red panel: plain-word headline, ONE message line, muted expected session. #}
  <div class="panel span12 hk-fresh-stale" id="hk-freshness-banner">
    <p class="hb-h">&#9888; {{ t('HK data problem — numbers may be from an older session', '港股数据异常 — 数值可能来自较早交易日') }}</p>
    <p class="hb-msg"><span class="l-en">{{ _fb.en }}</span><span class="l-zh">{{ _fb.zh }}</span></p>
    {% if freshness.expected_session %}<p class="hb-exp"><span class="l-en">Expected session {{ freshness.expected_session }}</span><span class="l-zh">预期交易日 {{ freshness.expected_session }}</span></p>{% endif %}
  </div>
  {% else %}
  {# DEGRADED → one thin amber line, not a tall panel. #}
  <div class="span12 hk-fresh-degraded" id="hk-freshness-banner">
    <span class="hfd-i">&#9680;</span> <span class="l-en">{{ _fb.en }}</span><span class="l-zh">{{ _fb.zh }}</span>
  </div>
  {% endif %}
  {% endif %}

  {% if mode != 'stocks' %}
  {# ==================== HK MX5 GLANCE+POPUP MACRO DASHBOARD ==================== #}
  {% if market_state %}{% set ms = market_state %}{% endif %}
  {# --- score gauge dasharray: track 157 total (semicircle) --- #}
  {% if ms is defined and ms %}
  {% set _score = ms.score|default(0)|int %}
  {% set _score_dash = (_score / 100 * 157)|int %}
  {% set _mscolor = ms.color|default('yellow') %}
  {# ── mx5 hero-gauge geometry (US idiom): arc centre (70,75) r=56; ARC_LEN=π·56=175.93.
     filled=score/100·ARC_LEN; needle -90°(score0) → +90°(score100). No JS math. ── #}
  {% set _mx5_arc_len = 175.93 %}
  {% set _mx5_filled = (_score / 100 * _mx5_arc_len) | round(1) %}
  {% set _mx5_gap = (_mx5_arc_len - _mx5_filled) | round(1) %}
  {% set _mx5_needle_deg = (_score / 100 * 180 - 90) | round(1) %}
  {% set _mx5_sc_cls = 'mx5-score-green' if _mscolor == 'green' else ('mx5-score-yellow' if _mscolor == 'yellow' else 'mx5-score-red') %}
  {# fallback hex for SVG presentation attrs (var() can't resolve in an attribute); the
     .mx5-score-* CSS rules recolour arc/numeral/needle via the fill/stroke PROPERTY so
     the real colour + zh 红涨绿跌 flip come from --up/--warn/--down. #}
  {% set _mx5_sc_col = '#45b873' if _mscolor == 'green' else ('#f59e0b' if _mscolor == 'yellow' else '#e06464') %}
  {% set _mx5_sc_glow = 'rgba(69,184,115,.7)' if _mscolor == 'green' else ('rgba(245,158,11,.7)' if _mscolor == 'yellow' else 'rgba(224,100,100,.7)') %}
  {% endif %}
  {# MX5 HERO — aurora class baked from market state color #}
  <div class="hkx-aurora{{ ' au-yellow' if (ms is defined and ms and ms.color == 'yellow') else (' au-red' if (ms is defined and ms and ms.color == 'red') else '') }}" aria-hidden="true"><div class="au-a3"></div></div>
  <div class="hkx-wrap ms-front ms ms-{{ ms.color if ms is defined and ms else 'yellow' }}" id="ms-front">

  {# HERO card #}
  {# hero root carries ms-front + ms-{color} so the class-driven gauge/pill CSS
     (.ms-green .hkx-gauge-fill etc.) actually has an ancestor to key on; solo
     class collapses the empty history panel until the score log accrues. #}
  <div class="hkx-card hkx-hero ms-front ms-{{ ms.color if (ms is defined and ms) else 'yellow' }}{{ ' hkx-hero-solo' if not (ms_history and ms_history|length >= 2) }}" id="hkx-hero-card">
    <div class="hkx-hero-left">
      {# regime pill = the macro QUAD word (mockup: "Stagflation"), bound from the
         signal-stack macro-regime leg so the zh twin is engine-supplied, never invented. #}
      {% set _mrleg = (signal_stack.legs | selectattr('label_en', 'equalto', 'Macro regime') | list | first) if (signal_stack and signal_stack.legs) else none %}
      {% if _mrleg %}
      <span class="hkx-regime-pill ms-{{ ms.color if (ms is defined and ms) else 'yellow' }}"><span class="hkx-rp-dot"></span>{{ t(_mrleg.state_en, _mrleg.state_zh) }}</span>
      {% elif ms is defined and ms %}
      <span class="hkx-regime-pill ms-{{ ms.color }}"><span class="hkx-rp-dot"></span>{{ t(ms.label_en, ms.label_zh) }}</span>
      {% else %}
      <span class="hkx-regime-pill ms-yellow"><span class="hkx-rp-dot"></span>{{ t('Mixed', '混合') }}</span>
      {% endif %}
      <span class="hkx-live-pill" id="ms-live-pill"><span class="hkx-lp-dot"></span>{{ t('AS OF', '截至') }} {{ latest.date if latest else '—' }}</span>
      {# ── A · MX5 regime odometer (US idiom: glowing-needle semicircle) ── #}
      <div class="mx5-sc-gauge-row {{ _mx5_sc_cls if ms is defined and ms else 'mx5-score-yellow' }}">
        <svg class="mx5-gauge-svg" viewBox="0 -4 140 101" fill="none"
             aria-label="{{ ms.label_en if ms is defined and ms else 'Regime' }} — score {{ _score if ms is defined and ms else 0 }}">
          <defs>
            <filter id="mx5NeedleGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="2.5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="mx5ArcGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          {# Track #}
          <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round" fill="none"/>
          {% if ms is defined and ms %}
          {# Filled arc — dasharray baked by Jinja; recoloured by state via #mx5-gauge-arc-fill CSS #}
          <path id="mx5-gauge-arc-fill"
                d="M 14 75 A 56 56 0 0 1 126 75" stroke="{{ _mx5_sc_col }}" stroke-width="10" stroke-linecap="round" fill="none"
                stroke-dasharray="{{ _mx5_filled }} {{ _mx5_gap }}" filter="url(#mx5ArcGlow)"/>
          {% endif %}
          {# Tick marks at 0/25/50/75/100 #}
          <g stroke="rgba(255,255,255,.22)" stroke-width="1.2">
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-90 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(0 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(90 70 75)"/>
          </g>
          <text x="14"  y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">0</text>
          <text x="70"  y="10" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">50</text>
          <text x="126" y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">100</text>
          {% if ms is defined and ms %}
          {# Needle — rotation baked by Jinja; accent parts recolour by state (.mx5-needle-*) #}
          <g id="mx5-gauge-needle" transform="rotate({{ _mx5_needle_deg }} 70 75)" filter="url(#mx5NeedleGlow)">
            <line x1="70" y1="75" x2="70" y2="24" stroke="rgba(255,255,255,.30)" stroke-width="5" stroke-linecap="round"/>
            <polygon points="69,75 71,75 70.5,24 69.5,24" fill="white" opacity=".94"/>
            <circle cx="70" cy="75" r="7"  fill="rgba(255,255,255,.10)"/>
            <circle class="mx5-needle-ring" cx="70" cy="75" r="4.5" stroke="{{ _mx5_sc_col }}" stroke-width="1.5" fill="rgba(8,12,18,.8)"/>
            <circle class="mx5-needle-fill" cx="70" cy="75" r="2"  fill="{{ _mx5_sc_col }}"/>
            <circle class="mx5-needle-fill" cx="70" cy="25.5" r="2.5" fill="{{ _mx5_sc_col }}" style="filter:drop-shadow(0 0 4px {{ _mx5_sc_col }})"/>
          </g>
          {# Score numeral inside arc #}
          <text id="mx5-score-numeral"
                x="70" y="62" fill="{{ _mx5_sc_col }}" font-size="24" font-weight="800"
                text-anchor="middle" font-family="Inter,-apple-system,sans-serif"
                style="filter:drop-shadow(0 0 10px {{ _mx5_sc_glow }})">{{ _score }}</text>
          <text x="70" y="73" fill="rgba(255,255,255,.32)" font-size="11"
                text-anchor="middle" font-family="Inter,-apple-system,sans-serif">/ 100</text>
          {% endif %}
        </svg>
        <div style="min-width:0">
          <div class="mx5-score-line">
            <span class="mx5-big-score" id="ms-score">{{ _score if ms is defined and ms else '—' }}</span>
            <span class="mx5-verdict-word" id="ms-word"><span class="l-en">{{ ms.label_en if ms is defined and ms else '—' }}</span><span class="l-zh">{{ (ms.label_zh or ms.label_en) if ms is defined and ms else '—' }}</span></span>
          </div>
          <div class="mx5-sub-line">
            <span class="l-en">{{ {'green':'GREEN — trend-following supported','yellow':'YELLOW — trade with caution','red':'RED — defend capital first'}.get(_mscolor,'') if ms is defined and ms else '' }}</span>
            <span class="l-zh">{{ {'green':'偏多 — 顺势而为受支撑','yellow':'谨慎操作','red':'优先保住本金'}.get(_mscolor,'') if ms is defined and ms else '' }}</span>
          </div>
        </div>
      </div>
      {% if ms is defined and ms %}
      <p class="hkx-thesis v-thesis">{{ t(ms.headline_en, ms.headline_zh or ms.headline_en) }}</p>
      <div class="hkx-flip v-flip">→ {{ t(ms.flip_en, ms.flip_zh) }}</div>
      {% endif %}
      <div class="hkx-hero-btns" style="position:relative">
        {% if signal_stack %}
        <button class="hkx-hbtn" onclick="hkxTogglePop('hkx-pop-signals',event)">&#x21B1; {{ t(signal_stack.n_bull|string + ' of ' + signal_stack.n|string + ' signals positive', signal_stack.n_bull|string + '/' + signal_stack.n|string + ' 信号偏多') }} <span class="hkx-hbtn-n">&#x25BE;</span></button>
        {% endif %}
        {% if ms is defined and ms and ms.radar is defined and ms.radar %}
        <button class="hkx-hbtn" style="{{ 'border-color:rgba(224,100,100,.5)' if ms.color == 'red' else '' }}" onclick="hkxTogglePop('hkx-pop-risk',event)">&#9888; {{ t('Drop risk', '回撤风险') }} · <span class="hkx-hbtn-n" style="{{ 'color:var(--down)' if ms.color == 'red' else '' }}">{{ t(ms.radar.label_en, ms.radar.label_zh or ms.radar.label_en) }}</span> &#x25BE;</button>
        {% endif %}
        {# signals popover #}
        <div class="hkx-pop" id="hkx-pop-signals">
          <div class="hkx-pop-h">{{ t('The checks', '信号详情') }}</div>
          {% if ms is defined and ms and ms.components is defined %}
          {% for c in ms.components %}
          <div class="hkx-pop-row">
            <div class="hkx-pop-rt"><span>{{ t(c.label_en, c.label_zh) }}</span><b style="color:{{ 'var(--up)' if c.tone == 'bull' else ('var(--down)' if c.tone == 'bear' else 'var(--warn)') }}">{{ c.score }}</b></div>
            <div class="hkx-pop-bar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'bull' else ('var(--down)' if c.tone == 'bear' else 'var(--warn)') }}"></i></div>
          </div>
          {% endfor %}
          {% else %}
          <p style="font-size:12px;color:var(--muted)">{{ t('Building…','数据积累中…') }}</p>
          {% endif %}
          <span class="hkx-pop-link" onclick="hkxClosePops();hkxOpenDlg('hkx-dlg-read')">{{ t('See the full read ↓','查看完整读数 ↓') }}</span>
        </div>
        {# risk popover #}
        <div class="hkx-pop" id="hkx-pop-risk" style="left:auto">
          <div class="hkx-pop-h">{{ t('Chance of a pullback','回撤概率') }}</div>
          {% if ms is defined and ms and ms.radar is defined and ms.radar %}
          {% set _rad = ms.radar %}
          <div class="hkx-pop-big"><span style="color:var(--down)">{{ ((_rad.dd21 * 100)|round|int)|string + '%' if _rad.dd21 is defined and _rad.dd21 else '—' }}</span><span style="font-size:12.5px;color:var(--down)">{{ t('21-day chance','21日概率') }}</span></div>
          <div class="hkx-pop-sub">{{ t(_rad.do_en, _rad.do_zh or _rad.do_en) if _rad.do_en is defined and _rad.do_en else '' }}</div>
          {% for s in _rad.scares[:3] if _rad.scares is defined %}
          <div class="hkx-pop-row">
            <div class="hkx-pop-rt"><span>{{ t(s.label_en, s.label_zh) }}</span><b>{{ s.band if s.band is defined else '' }}</b></div>
            <div class="hkx-pop-bar"><i style="width:{{ s.score }}%;background:var(--down)"></i></div>
          </div>
          {% endfor %}
          {% else %}
          <p style="font-size:12px;color:var(--muted)">{{ t('Building…','数据积累中…') }}</p>
          {% endif %}
          <span class="hkx-pop-link" onclick="hkxClosePops();hkxOpenDlg('hkx-dlg-risk')">{{ t('See the full risk read ↓','查看完整风险 ↓') }}</span>
        </div>
      </div>
      {# vchips REMOVED from hero — now in cross-asset strip below index tiles #}
    </div>
    <div class="hkx-hero-right">
      {# ── B · MX5 60-session verdict-band path (US idiom) ── #}
      {% set _mx5_hist = ms_history if (ms_history is defined and ms_history and ms_history | length >= 2) else none %}
      {% set _mx5_hist_n = _mx5_hist | length if _mx5_hist else 0 %}
      <div class="mx5-sc-right">
      <div class="mx5-path-header">
        <span class="mx5-path-title">
          <span class="l-en">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}{{ _mx5_hist_n }}-session path{% else %}60-session path{% endif %}</span>
          <span class="l-zh">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}近 {{ _mx5_hist_n }} 交易日走势{% else %}60 交易日走势{% endif %}</span>
        </span>
        <span class="mx5-path-meta"><span class="l-en">Score vs time</span><span class="l-zh">综合评分 · 时序</span></span>
      </div>
      {% if _mx5_hist %}
      {# Plot band x∈[PX0,PX0+PXW] y∈[PY0(score100),PYB(score0)]. Verdict bands: risk-off<42,
         mixed 42–60, risk-on ≥60 (same engine thresholds as US). HK ms_history rows use .date. #}
      {% set _ph_n = _mx5_hist | length %}
      {% set PX0 = 44 %}{% set PXW = 944 %}{% set PY0 = 10 %}{% set PYB = 194 %}
      {% set _mx5_mos_en = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
      {% set _ph_yfor = PYB - PY0 %}
      {% set _y100 = PY0 %}
      {% set _y75  = (PY0 + 25.0/100 * _ph_yfor) | round(2) %}
      {% set _y60  = (PY0 + 40.0/100 * _ph_yfor) | round(2) %}
      {% set _y50  = (PY0 + 50.0/100 * _ph_yfor) | round(2) %}
      {% set _y42  = (PY0 + 58.0/100 * _ph_yfor) | round(2) %}
      {% set _y25  = (PY0 + 75.0/100 * _ph_yfor) | round(2) %}
      {% set _y0   = PYB %}
      {% set _ph_pts_line = [] %}
      {% set _ph_json = [] %}
      {% for row in _mx5_hist %}
        {% set _ph_x = (PX0 + (loop.index0 / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
        {% set _row_s = row.score if (row.score is defined and row.score is not none) else 50 %}
        {% set _ph_y = (PY0 + (100 - _row_s) / 100 * _ph_yfor) | round(2) %}
        {% set _rv = 'Risk-on' if _row_s >= 60 else ('Mixed' if _row_s >= 42 else 'Risk-off') %}
        {% set _rvz = '偏多' if _row_s >= 60 else ('中性' if _row_s >= 42 else '偏空') %}
        {% if _ph_pts_line.append(_ph_x ~ ',' ~ _ph_y) %}{% endif %}
        {% if _ph_json.append({'d': row.date, 'md': (_mx5_mos_en[row.date[5:7]|int] ~ ' ' ~ (row.date[8:10]|int)) if (row.date and row.date|length >= 10) else '', 'mz': ((row.date[5:7]|int)|string ~ '月' ~ (row.date[8:10]|int)|string) if (row.date and row.date|length >= 10) else '', 's': row.score, 'v': _rv, 'vz': _rvz, 'x': _ph_x, 'y': _ph_y}) %}{% endif %}
      {% endfor %}
      {% set _ph_nticks = [_ph_n, 5] | min %}
      {% set _ph_tick_idx = [] %}
      {% if _ph_n <= 6 %}
        {% for i in range(_ph_n) %}{% if _ph_tick_idx.append(i) %}{% endif %}{% endfor %}
      {% else %}
        {% for k in range(_ph_nticks + 1) %}{% if _ph_tick_idx.append((k / _ph_nticks * (_ph_n - 1)) | round | int) %}{% endif %}{% endfor %}
      {% endif %}
      <div class="mx5-path-plot">
      <svg class="mx5-path-svg" viewBox="0 0 1000 224" preserveAspectRatio="none"
           data-points='{{ _ph_json | tojson }}'
           data-px0="{{ PX0 }}" data-pxw="{{ PXW }}" data-py0="{{ PY0 }}" data-pyb="{{ PYB }}"
           data-vbw="1000" data-vbh="224"
           role="img" aria-label="{{ _mx5_hist_n }}-session HK score path, {{ _mx5_hist[0].score }} to {{ _mx5_hist[-1].score }}">
        <defs>
          <linearGradient id="mx5PathAreaGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="{{ _mx5_sc_col }}" stop-opacity=".40"/>
            <stop offset="62%"  stop-color="{{ _mx5_sc_col }}" stop-opacity=".07"/>
            <stop offset="100%" stop-color="{{ _mx5_sc_col }}" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <rect x="0" y="{{ _y100 }}" width="1000" height="{{ (_y60 - _y100) | round(2) }}" fill="rgba(34,217,122,.045)"/>
        <rect x="0" y="{{ _y60 }}"  width="1000" height="{{ (_y42 - _y60) | round(2) }}" fill="rgba(245,158,11,.045)"/>
        <rect x="0" y="{{ _y42 }}"  width="1000" height="{{ (_y0 - _y42) | round(2) }}" fill="rgba(239,68,68,.045)"/>
        <line x1="0" y1="{{ _y60 }}" x2="1000" y2="{{ _y60 }}" stroke="rgba(34,217,122,.22)" stroke-width="1" stroke-dasharray="2,5"/>
        <line x1="0" y1="{{ _y42 }}" x2="1000" y2="{{ _y42 }}" stroke="rgba(239,68,68,.20)" stroke-width="1" stroke-dasharray="2,5"/>
        <g stroke="rgba(255,255,255,.06)" stroke-width="1">
          <line x1="{{ PX0 }}" y1="{{ _y100 }}" x2="988" y2="{{ _y100 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y75 }}"  x2="988" y2="{{ _y75 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y50 }}"  x2="988" y2="{{ _y50 }}" stroke-dasharray="4,5"/>
          <line x1="{{ PX0 }}" y1="{{ _y25 }}"  x2="988" y2="{{ _y25 }}"/>
        </g>
        <path d="M{{ _ph_pts_line | join(' L') }} L{{ (PX0 + PXW) | round(2) }},{{ PYB }} L{{ PX0 }},{{ PYB }} Z" fill="url(#mx5PathAreaGrad)" stroke="none"/>
        <polyline points="{{ _ph_pts_line | join(' ') }}" fill="none" stroke="{{ _mx5_sc_col }}" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" opacity=".92"/>
        <line x1="{{ PX0 }}" y1="{{ PYB }}" x2="988" y2="{{ PYB }}" stroke="rgba(255,255,255,.16)" stroke-width="1"/>
        <g font-size="11" font-family="Inter,-apple-system,sans-serif">
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          <line x1="{{ _tx }}" y1="{{ PYB }}" x2="{{ _tx }}" y2="{{ (PYB + 4) | round(1) }}" stroke="rgba(255,255,255,.20)" stroke-width="1"/>
        {% endfor %}
        </g>
        {% set _ph_last_x = (PX0 + PXW) | round(2) %}
        {% set _ph_last_y = (PY0 + (100 - _mx5_hist[-1].score) / 100 * _ph_yfor) | round(2) %}
      </svg>
      <div class="mx5-path-labels" aria-hidden="true">
        <span class="mx5-pl-y" style="top:{{ (_y100 / 224 * 100) | round(2) }}%">100</span>
        <span class="mx5-pl-y" style="top:{{ (_y75  / 224 * 100) | round(2) }}%">75</span>
        <span class="mx5-pl-y" style="top:{{ (_y50  / 224 * 100) | round(2) }}%">50</span>
        <span class="mx5-pl-y" style="top:{{ (_y25  / 224 * 100) | round(2) }}%">25</span>
        <span class="mx5-pl-y" style="top:{{ (_y0   / 224 * 100) | round(2) }}%">0</span>
        <span class="mx5-pl-zone on"  style="top:{{ ((_y100 + 13) / 224 * 100) | round(2) }}%"><span class="l-en">Calm</span><span class="l-zh">平稳</span></span>
        <span class="mx5-pl-zone mid" style="top:{{ (((_y60 + _y42) / 2) / 224 * 100) | round(2) }}%"><span class="l-en">Mixed</span><span class="l-zh">中性</span></span>
        <span class="mx5-pl-zone off" style="top:{{ ((_y0 - 7) / 224 * 100) | round(2) }}%"><span class="l-en">Nervous</span><span class="l-zh">紧张</span></span>
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          {% set _txf = 'translate(0,-50%)' if loop.first else ('translate(-100%,-50%)' if loop.last else 'translate(-50%,-50%)') %}
          {% set _tdate = _mx5_hist[_ti].date %}
          {% if _tdate and _tdate|length >= 10 %}
          <span class="mx5-pl-x" style="left:{{ (_tx / 1000 * 100) | round(3) }}%;transform:{{ _txf }}"><span class="l-en">{{ _mx5_mos_en[_tdate[5:7]|int] }} {{ _tdate[8:10]|int }}</span><span class="l-zh">{{ _tdate[5:7]|int }}月{{ _tdate[8:10]|int }}</span></span>
          {% endif %}
        {% endfor %}
        <span class="mx5-pl-today" style="left:{{ (_ph_last_x / 1000 * 100) | round(3) }}%;top:{{ (_ph_last_y / 224 * 100) | round(3) }}%;color:{{ _mx5_sc_col }}"></span>
      </div>
      <div class="mx5-path-cross" aria-hidden="true"></div>
      <div class="mx5-path-dot" aria-hidden="true"></div>
      <div class="mx5-path-tip" role="status" aria-live="off">
        <span class="mx5-path-tip-date"></span>
        <span class="mx5-path-tip-row"><b class="mx5-path-tip-score"></b><span class="mx5-path-tip-verdict"></span></span>
      </div>
      </div>{# /mx5-path-plot #}
      {% else %}
      <div style="flex:1;display:flex;align-items:center;justify-content:center;">
        <span style="font-size:12px;color:var(--muted)"><span class="l-en">Path chart — accruing from nightly log.</span><span class="l-zh">走势图 — 每晚积累中。</span></span>
      </div>
      {% endif %}
      </div>{# /mx5-sc-right #}
    </div>
  </div>{# /.hkx-hero #}
  {# ── B · Path-chart hover enhancement (ported from US dashboard.html.j2 ~7141) —
     pure progressive layer; chart is fully legible without it. Reads data-points
     (viewBox x/y baked) + live bounding rect → maps viewBox→screen for a pixel-crisp
     crosshair/dot/tooltip despite preserveAspectRatio="none". COL reads house
     --up/--warn/--down at runtime so the dot honours the zh 红涨绿跌 swap. ── #}
  <script>
  (function(){
    var svg = document.querySelector('.mx5-sc-right .mx5-path-svg[data-points]');
    if(!svg) return;
    var plot = svg.closest('.mx5-path-plot'); if(!plot) return;
    var cross = plot.querySelector('.mx5-path-cross');
    var dot   = plot.querySelector('.mx5-path-dot');
    var tip   = plot.querySelector('.mx5-path-tip');
    if(!cross || !dot || !tip) return;
    var tDate = tip.querySelector('.mx5-path-tip-date');
    var tScore= tip.querySelector('.mx5-path-tip-score');
    var tVerd = tip.querySelector('.mx5-path-tip-verdict');
    var pts;
    try { pts = JSON.parse(svg.getAttribute('data-points') || '[]'); } catch(e){ return; }
    if(!pts.length) return;
    var VBW = +(svg.getAttribute('data-vbw')||1000);
    var VBH = +(svg.getAttribute('data-vbh')||224);
    /* resolve house tokens so the dot/verdict flip 红涨绿跌 with the page */
    function col(v){
      var cs = getComputedStyle(document.body);
      var on = (cs.getPropertyValue('--up')||'#45b873').trim();
      var off= (cs.getPropertyValue('--down')||'#e06464').trim();
      var mid= (cs.getPropertyValue('--warn')||'#f59e0b').trim();
      return v==='Risk-on' ? on : (v==='Risk-off' ? off : mid);
    }
    function isZh(){
      var el=document.documentElement;
      return (el.getAttribute('data-lang')||'').slice(0,2)==='zh';
    }
    function nearest(clientX){
      var r = svg.getBoundingClientRect();
      var vx = (clientX - r.left) / r.width * VBW;
      var best=0, bd=Infinity;
      for(var i=0;i<pts.length;i++){
        var d=Math.abs(pts[i].x - vx);
        if(d<bd){ bd=d; best=i; }
      }
      return best;
    }
    function show(i){
      var p = pts[i]; if(!p) return;
      var r = svg.getBoundingClientRect();
      var pr = plot.getBoundingClientRect();
      var sx = (p.x / VBW) * r.width  + (r.left - pr.left);
      var sy = (p.y / VBH) * r.height + (r.top  - pr.top);
      cross.style.left = sx + 'px';   cross.style.opacity = '1';
      dot.style.left = sx + 'px';     dot.style.top = sy + 'px';
      dot.style.background = col(p.v);
      dot.style.opacity = '1';
      tDate.textContent = isZh() ? (p.mz || p.d) : (p.md || p.d);
      tScore.textContent = p.s;
      tVerd.textContent = isZh() ? (p.vz||p.v) : p.v;
      tVerd.style.color = col(p.v);
      var half = tip.offsetWidth/2 || 60;
      var clx = Math.max(half+2, Math.min(pr.width-half-2, sx));
      tip.style.left = clx + 'px';
      tip.style.top  = sy + 'px';
      tip.classList.add('show');
    }
    function hide(){ cross.style.opacity='0'; dot.style.opacity='0'; tip.classList.remove('show'); }
    var raf=0, lastX=0;
    function onMove(clientX){
      lastX=clientX;
      if(raf) return;
      raf=requestAnimationFrame(function(){ raf=0; show(nearest(lastX)); });
    }
    svg.addEventListener('mousemove', function(e){ onMove(e.clientX); });
    svg.addEventListener('mouseleave', hide);
    svg.addEventListener('touchstart', function(e){ if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX)); }, {passive:true});
    svg.addEventListener('touchmove', function(e){ if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX)); }, {passive:true});
    svg.addEventListener('touchend', function(){ setTimeout(hide, 1400); }, {passive:true});
    document.addEventListener('langchange', function(){ if(tip.classList.contains('show')) show(nearest(lastX)); });
  })();
  </script>

