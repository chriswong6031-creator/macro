  {# =================== DIALOGS =================== #}

  {# dlg-read: The Full Read #}
  <div class="hkx-dlg" id="hkx-dlg-read">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('The Full Read — What\'s Behind the Score','完整读数 — 评分详解') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('The score (0–100) blends several checks into one read of how risky the Hong Kong market looks right now. Below 42 = nervous / play defence, 42–59 = mixed, 60+ = calm. It confirms what\'s already happening — it\'s not a forecast.','评分（0–100）把多项检查融合为一个读数，反映当前港股市场的风险程度。低于42=紧张/防御，42–59=混合，60+=平稳。确认已发生的事，不是预测。') }}</div>
        {% if ms is defined and ms and ms.components is defined %}
        <div class="hkx-eyebrow">{{ t('The checks · today','今日各项检查') }} {{ ms.score }}/100</div>
        {% for c in ms.components %}
        <div class="hkx-frow">
          <span>{{ t(c.label_en, c.label_zh) }}</span>
          <span><div class="hkx-fbar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'bull' else ('var(--down)' if c.tone == 'bear' else 'var(--warn)') }}"></i></div></span>
          <span class="hkx-fscore" style="color:{{ 'var(--up)' if c.tone == 'bull' else ('var(--down)' if c.tone == 'bear' else 'var(--warn)') }}">{{ c.score }}</span>
        </div>
        {% endfor %}
        {% endif %}
        {% if signal_stack and signal_stack.legs %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Signal stack','信号堆栈') }}</div>
        {% for leg in signal_stack.legs %}
        <div class="hkx-frow">
          <span>{{ t(leg.label_en, leg.label_zh) }}</span>
          <span><div class="hkx-fbar"><i style="width:{{ leg.score if leg.score is defined else 50 }}%;background:{{ 'var(--up)' if leg.tone == 'bull' else ('var(--down)' if leg.tone == 'bear' else 'var(--warn)') }}"></i></div></span>
          <span class="hkx-fscore" style="color:{{ 'var(--up)' if leg.tone == 'bull' else ('var(--down)' if leg.tone == 'bear' else 'var(--warn)') }}">{{ t(leg.state_en, leg.state_zh) }}</span>
        </div>
        {% endfor %}
        <div class="hkx-receipt">{{ t('Signal tally:','信号汇总：') }} <b class="hkx-up">{{ signal_stack.n_bull }}</b> {{ t('bull','多') }} · <b>{{ signal_stack.n - signal_stack.n_bull - signal_stack.n_bear }}</b> {{ t('neutral','中性') }} · <b class="hkx-dn">{{ signal_stack.n_bear }}</b> {{ t('bear','空') }} {{ t('of','共') }} {{ signal_stack.n }}</div>
        {% endif %}
        {% if index_health %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('The trend across timeframes','多周期走势') }}</div>
        <table class="hkx-mt">
          <tr><th>{{ t('Index','指数') }}</th><th class="r">{{ t('Price','价格') }}</th><th class="r">{{ t('Chg','涨跌') }}</th><th class="r">{{ t('DD','回撤') }}</th><th class="r">{{ t('RSI','RSI') }}</th></tr>
          {% for ih in index_health %}
          <tr><td>{{ t(ih.label, ih.label_zh if ih.label_zh is defined else ih.label) }}</td>
          <td class="r">{{ ih.price if ih.price is not none else '—' }}</td>
          <td class="r {{ 'hkx-up' if (ih.chg is not none and ih.chg >= 0) else 'hkx-dn' }}">{{ ('%+.1f'|format(ih.chg) + '%') if ih.chg is not none else '—' }}</td>
          <td class="r">{{ ('%.1f'|format(ih.dd) + '%') if ih.dd is not none else '—' }}</td>
          <td class="r">{{ ih.rsi|round|int if ih.rsi is not none else '—' }}</td></tr>
          {% endfor %}
        </table>
        {% endif %}
        <div class="hkx-receipt">{{ t('Display-only. A synthesis of signals shown elsewhere; it never scores, sizes or feeds the regime engine.','仅供展示。是本页其他信号的综合；绝不评分、定仓或进入周期引擎。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-policy: Currency & Rates #}
  <div class="hkx-dlg" id="hkx-dlg-policy">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('Currency & Interest Rates','货币与利率') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('Hong Kong has an unusual setup: its <b>currency is pinned to the US dollar</b>, so its <b>interest rates follow America\'s</b>. But most big HK-listed companies earn their money in mainland China, so their <b>profits follow China\'s economy</b>. Two different engines.','香港有独特的结构：<b>货币与美元挂钩</b>，因此<b>利率跟随美国</b>。但大多数在港上市公司在内地赚钱，所以<b>盈利跟随中国经济</b>。两台不同的引擎。') | safe }}</div>
        <div class="hkx-dlg-body hkx-cols2">
          <div>
            <div class="hkx-eyebrow">{{ t('The currency link','联汇') }}</div>
            {% if gv and gv.peg %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 6px">
              <span class="hkx-bignum">{{ '%.4f'|format(gv.peg.level) }}</span>
              {% if gv.peg.level > 7.83 %}<span class="hkx-alert-pill" style="background:rgba(224,100,100,.16);color:var(--down);margin:0">{{ t('NEAR WEAK EDGE','接近弱方') }}</span>{% endif %}
            </div>
            <div class="hkx-pegband" style="height:28px"><div class="hkx-mark" style="left:{{ ((gv.peg.level - 7.75) / 0.10 * 100)|int }}%"></div><div class="hkx-ends"><span>{{ t('strong 7.75','强 7.75') }}</span><span>{{ t('weak 7.85','弱 7.85') }}</span></div></div>
            <div class="hkx-kv" style="margin-top:16px"><span class="hkx-k">{{ t('State','状态') }}</span><span class="hkx-v">{{ td(gv.peg.state) }}</span></div>
            {% endif %}
            {% if funding %}
            <div class="hkx-kv"><span class="hkx-k">{{ t('Cash in the system','系统内资金') }}</span><span class="hkx-v">{{ '{:,}'.format(funding.agg_balance) }} {{ t('HK$M','百万港元') }}</span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('HIBOR overnight','隔夜HIBOR') }}</span><span class="hkx-v">{{ funding.hibor_on }}%</span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('HIBOR 1-month','1月HIBOR') }}</span><span class="hkx-v">{{ funding.hibor_1m }}%</span></div>
            {% endif %}
          </div>
          <div>
            <div class="hkx-eyebrow">{{ t('The profit engine (China)','盈利引擎（中国）') }}</div>
            {% if internals and internals.pboc %}
            <div class="hkx-kv"><span class="hkx-k">{{ t("China's central bank",'中国央行') }}</span><span class="hkx-v"><span class="hkx-stword ok">{{ t('Supportive','支持') }}</span></span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('RRR (big banks)','大行存准率') }}</span><span class="hkx-v">{{ internals.pboc.rrr_big }}%</span></div>
            {% endif %}
            {% if funding and funding.base_rate %}
            <div class="hkx-kv"><span class="hkx-k">{{ t('Base rate','基准利率') }}</span><span class="hkx-v">{{ funding.base_rate }}%</span></div>
            {% endif %}
          </div>
        </div>
        <div class="hkx-receipt">{{ t('When the two engines pull apart, the currency & interest-rate side usually wins on short-term timing.','当两台引擎分歧时，货币与利率面通常在短期节奏上占主导。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-flows: Mainland Buying & Value #}
  <div class="hkx-dlg" id="hkx-dlg-flows">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
