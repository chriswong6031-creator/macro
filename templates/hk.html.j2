        <span class="hkx-ic">{{ '💰' if f.buyback_flag else ('⚠' if f.dilution_flag else '📈') }}</span>
        <div class="hkx-tx">
          <b>{{ t(f.title_en, f.title_en) }}</b>
          <span class="hkx-sub">{{ f.ticker }} · {{ t(f.category, f.category) }}</span>
        </div>
      </div>
      {% endfor %}
      <div class="hkx-view-all">{{ filing_bus.tape|length }} {{ t('company filings','公司公告') }} · {{ t('see all →','查看全部 →') }}</div>
      {% else %}
      <div class="hkx-row"><span class="hkx-ic">📋</span><div class="hkx-tx"><b>{{ t('No major filings today.','今日暂无重要公告。') }}</b></div></div>
      {% endif %}
    </div>

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-property')">
      <div class="hkx-ctitle">{{ t('HK Home Prices','香港楼市') }}</div>
      {% if property and property.regime and property.regime.label_en %}
      <div class="hkx-bignum" style="font-size:22px;color:var(--warn)">{{ t(property.regime.label_en, property.regime.label_zh or property.regime.label_en) }}</div>
      <div class="hkx-bigsub" style="color:var(--muted)">{{ t('off the lows · prices firming a little','企稳回升') if property.ccl and property.ccl.chg_13w is not none and property.ccl.chg_13w > 0 else '' }}</div>
      {% if property.ccl %}
      <div class="hkx-kv"><span class="hkx-k">{{ t('Last 3 months','近3个月') }}</span><span class="hkx-v">{{ ('%+.1f'|format(property.ccl.chg_13w) + '%') if property.ccl.chg_13w is not none else '—' }}</span></div>
      {% endif %}
      {% else %}
      <div class="hkx-bignum" style="font-size:22px">—</div>
      {% endif %}
      <div class="hkx-foot">{{ t('A slow read on local wealth — property matters for HK confidence.','本地财富慢指标 — 楼市关乎港股信心。') }}</div>
    </div>

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-aibrief')">
      <div class="hkx-ctitle">{{ t('AI Summary','AI简报') }}</div>
      {% if china_brief %}
      {% set _cb = china_brief %}
      {% set _cbzh = _cb.zh if _cb.zh is defined and _cb.zh else {} %}
