      <div class="cat-tag">{{ tile.tag if tile.tag is defined else tile.label }}</div>
      {# tone is pos/neg/neu from market_tiles builder #}
      {% set _tone_cls = 'hkx-tt-up' if tile.tone in ('pos','bull') else ('hkx-tt-dn' if tile.tone in ('neg','bear') else '') %}
      <div class="cat-val {{ _tone_cls }}">{{ tile.level if tile.level is defined else '—' }}</div>
      {% if tile.chg is not none and tile.chg is defined and tile.chg is number %}
      <div class="cat-chg {{ 'hkx-tt-up' if (tile.chg >= 0) else 'hkx-tt-dn' }}">{{ ('%+.2f'|format(tile.chg)) }}</div>
