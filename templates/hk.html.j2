        <div class="hkx-stk-meta"><b>{{ s.ticker }}</b> · {{ t(s.sector, s.sector_zh if s.sector_zh is defined else s.sector) if s.sector is defined else '' }}</div>
        <span class="hkx-stage">{{ t(s.label, s.label_zh) if s.label is defined else '' }}</span>
      </div>
      {% endfor %}
      {% elif setups and setups.watch %}
      {% for s in setups.watch[:5] %}
      <div class="hkx-stk">
        <a class="hkx-tkr-btn" href="hk_lookup.html#{{ s.ticker }}">{{ t(s.name, s.name_zh) if s.name is defined else s.ticker }}</a>
        <div class="hkx-stk-meta"><b>{{ s.ticker }}</b> · {{ t(s.sector, s.sector_zh if s.sector_zh is defined else s.sector) if s.sector is defined else '' }}</div>
        <span class="hkx-stage">{{ t(s.label, s.label_zh) if s.label is defined else '' }}</span>
      </div>
      {% endfor %}
      {% else %}
      <p style="font-size:12px;color:var(--muted)">{{ t('No setups ready right now.','暂无就绪的设置。') }}</p>
      {% endif %}
      <a class="hkx-screener-btn" href="hk_stocks.html">{{ t('See all HK stocks →','查看全部港股 →') }}</a>
    </div>
    {% endif %}

    {# ── D · MX5 Market-Sentiment odometer (US idiom), wired to VHSI (inverted:
       high VHSI percentile = high fear → needle LEFT/PANIC). fg-fear→--down,
       fg-greed→--up, neutral→--warn drive --fg-col so it flips 红涨绿跌 in zh. ── #}
    {% set _hk_pct = vhsi.pctile if (vhsi and vhsi.pctile is not none) else none %}
    {# dial 0..100 = calm→fearful mapped so RIGHT=euphoria(low fear), LEFT=panic(high fear) #}
    {% set _hk_dial = (100 - _hk_pct) if _hk_pct is not none else 50 %}
    {% set _hk_zone_cls = 'fg-greed' if _hk_dial > 60 else ('fg-fear' if _hk_dial < 40 else 'fg-neutral') %}
    {% set _hk_zone_en = 'Calm' if _hk_dial > 60 else ('Fearful' if _hk_dial < 40 else 'Neutral') %}
    {% set _hk_zone_zh = '平静' if _hk_dial > 60 else ('恐慌' if _hk_dial < 40 else '中性') %}
    {% set _hk_fg_needle_rot = (_hk_dial / 100 * 180 - 90) | round(1) %}
    <div class="hkx-card {{ _hk_zone_cls }}" id="hkx-sentiment" role="button" tabindex="0" aria-haspopup="dialog" onclick="hkxOpenDlg('hkx-dlg-sentiment')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();hkxOpenDlg('hkx-dlg-sentiment');}">
      <div class="hkx-ctitle">{{ t('Mood & Fear','市场情绪') }}</div>
      {# Stance line — high pctile = fearful = be careful; low = greedy = watch for euphoria #}
      {% if _hk_pct is not none %}
      <div style="font-size:11px;color:var(--muted);margin-bottom:8px">
        {% if _hk_pct >= 75 %}{{ t('Fear elevated — worth watching carefully','恐慌偏高 — 值得谨慎观察') }}
        {% elif _hk_pct <= 25 %}{{ t('Greed elevated — not a chase signal','贪婪偏高 — 非追涨信号') }}
        {% else %}{{ t('Fear normal — watch, don\'t chase','恐慌正常 — 观察，勿追') }}{% endif %}
      </div>
      {% endif %}
      {% if vhsi %}
      <div class="mx5-sentiment-dial-wrap">
        <svg viewBox="0 0 380 212" style="width:100%;max-width:320px;height:180px;display:inline-block;overflow:visible">
          <defs>
            <linearGradient id="hkSentGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="#ef4444"/>
              <stop offset="35%"  stop-color="#f59e0b"/>
              <stop offset="65%"  stop-color="#22d97a"/>
              <stop offset="100%" stop-color="#22d97a"/>
            </linearGradient>
            <filter id="hkDialGlow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="18" stroke-linecap="round"/>
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="url(#hkSentGrad)" stroke-width="18" stroke-linecap="round" opacity=".55"/>
          <g filter="url(#hkDialGlow)">
            <line class="fg-mark-s" x1="190" y1="185" x2="190" y2="30"
                  stroke-width="4" stroke-linecap="round"
                  transform="rotate({{ _hk_fg_needle_rot }}, 190, 185)"/>
            <circle class="fg-mark-s" cx="190" cy="185" r="9"  fill="rgba(8,12,18,.8)" stroke-width="2.5"/>
            <circle class="fg-mark-f" cx="190" cy="185" r="4"/>
          </g>
          <text class="l-en fg-lab-panic" x="26"  y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">PANIC</text>
          <text class="l-zh fg-lab-panic" x="26"  y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">恐慌</text>
          <text class="l-en fg-lab-euph" x="354" y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">EUPHORIA</text>
          <text class="l-zh fg-lab-euph" x="354" y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">亢奋</text>
        </svg>
      </div>
      <div class="mx5-sentiment-zone-text"><span class="l-en">{{ _hk_zone_en }}</span><span class="l-zh">{{ _hk_zone_zh }}</span></div>
      <div class="mx5-sentiment-label">
        <span class="l-en">HK fear gauge {{ vhsi.level }} &middot; {{ _hk_pct | int }}th of its range</span>
        <span class="l-zh">港股恐慌指数 {{ vhsi.level }} &middot; 历史第 {{ _hk_pct | int }} 分位</span>
      </div>
      {% if flow_charts and flow_charts.vhsi %}
      {# the gauge shows today; this shows how today compares with the last two years,
         anchored at the ~20 long-run middle (above = jumpier tape than normal). #}
      <div class="hkx-lbl">{{ t('Two years of fear &amp; calm &middot; middle of its range = 20','近两年恐慌与平静 &middot; 区间中值 = 20') | safe }}</div>
      <div class="hkx-ilx">{{ flow_charts.vhsi | safe }}</div>
      {% endif %}
      {% else %}
      <div style="height:80px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px">{{ t('Building…','积累中…') }}</div>
      {% endif %}
    </div>

    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-sector')">
      <div class="hkx-ctitle">{{ t('Which Sectors Are Hot','板块温度') }}</div>
      {# Stance line — breadth-based #}
      {% if breadth and breadth.pct_above_50 is not none %}
      <div style="font-size:11px;color:var(--muted);margin-bottom:8px">
        {% if breadth.pct_above_50 >= 60 %}{{ t('Broad — most stocks participating','广泛 — 多数个股参与') }}
        {% elif breadth.pct_above_50 >= 40 %}{{ t('Mixed — rotation only, watch breadth','混合 — 仅轮动，观察广度') }}
        {% else %}{{ t('Narrow — stay selective','偏窄 — 保持精选') }}{% endif %}
      </div>
      {% endif %}
      {% if sectors %}
      {# hot = top 3 by mom20 desc #}
      {% set _hot_secs = sectors|selectattr('mom20','defined')|selectattr('mom20','ne',none)|list|sort(attribute='mom20',reverse=true)|list %}
      {% set _turn_secs = sectors|selectattr('dir','eq','up')|list %}
      {% if _hot_secs %}
      <div class="hkx-lbl">{{ t('Hot — already run, don’t chase','热门 — 已涨，勿追') }}</div>
      <div class="hkx-chips">{% for s in _hot_secs[:3] %}<span class="hkx-chip hot">{{ t(s.name.en if s.name is mapping else s.name, s.name.zh if s.name is mapping else s.name) }}</span>{% endfor %}</div>
      {% endif %}
      {% if _turn_secs %}
      <div class="hkx-lbl">{{ t('Turning up — cheap and getting bought','转强 — 便宜且被资金买入') }}</div>
      <div class="hkx-chips">{% for s in _turn_secs[:3] %}<span class="hkx-chip turn">{{ t(s.name.en if s.name is mapping else s.name, s.name.zh if s.name is mapping else s.name) }}</span>{% endfor %}</div>
      {% endif %}
      <div class="hkx-lbl">{{ t('Sector heat · green = leading · red = lagging','板块温度 · 绿=领涨 · 红=滞涨') }}</div>
      <div class="hkx-heat">
        {# each cell names its sector + 20-day move on hover; the strip was unlabelled cells
           with no way to tell which sector any cell was. #}
        {% for s in sectors[:12] %}
        {% set _m = s.mom20 %}
        <i class="{{ 'c' if (_m is not none and _m < -1) else ('c2' if (_m is not none and _m < 0) else ('n' if (_m is none) else ('h3' if _m < 1 else ('h2' if _m < 3 else 'h')))) }}"
           data-tip-en="{{ (s.name.en if s.name is mapping else s.name) }}{{ ': %+.1f%% over 20 days'|format(_m) if _m is not none else ': no 20-day reading' }}"
           data-tip-zh="{{ (s.name.zh if s.name is mapping else s.name) }}{{ '：20日 %+.1f%%'|format(_m) if _m is not none else '：暂无20日数据' }}"></i>
        {% endfor %}
      </div>
      <div class="hkx-heat-legend"><span class="heat-up">{{ t('▲ Heating','▲ 升温') }}</span><span class="heat-dn">{{ t('Cooling ▼','降温 ▼') }}</span></div>
      {% if flow_charts and flow_charts.breadth %}
      {# the stance line at the top of this card is one breadth number; this is the shape
         behind it, anchored at the 50% waterline (above = more than half the market up) #}
      <div class="hkx-lbl">{{ t('How many stocks are above their 50-day line','站上50日线的个股占比') }}</div>
      <div class="hkx-ilx">{{ flow_charts.breadth | safe }}</div>
      {% endif %}
      {% else %}
      <p style="font-size:12px;color:var(--muted)">{{ t('Building…','积累中…') }}</p>
      {% endif %}
    </div>
  </div>

  {# ROW 3: Currency & Rates + Mainland Buying + Overnight & Leverage #}
  <div class="hkx-rack3">
    <div class="hkx-card" role="button" tabindex="0" onclick="hkxOpenDlg('hkx-dlg-policy')">
      <div class="hkx-ctitle">{{ t('Currency & Interest Rates','货币与利率') }}</div>
      {# Stance line: peg state drives the read #}
      {% if gv and gv.peg %}
      <div style="font-size:11px;color:var(--muted);margin-bottom:8px">
        {% if gv.peg.level > 7.83 %}{{ t('Peg near weak edge — HKMA may defend','联汇接近弱方 — 金管局或介入') }}
        {% elif gv.peg.level < 7.77 %}{{ t('Peg near strong edge — watch','联汇接近强方 — 注意') }}
        {% else %}{{ t('Peg stable — watch rates for direction','联汇平稳 — 关注利率方向') }}{% endif %}
