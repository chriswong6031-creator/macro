    <p class="note" style="margin:0 0 6px">{{ t('Market breadth' if breadth.full else 'Large-cap breadth', '市场广度' if breadth.full else '大盘宽度') }} — {{ t('how many stocks are participating', '有多少股票在参与') }} ({{ breadth.n_members }} {{ t('names', '只') }})</p>
    <p class="{{ breadth.tone }}" style="margin:0 0 10px; font-size:12.5px; line-height:1.45">
      {{ t('Participation looks', '参与度看起来') }}
      <b>{% if breadth.state=='broad' %}{{ t('broad', '广泛') }}{% elif breadth.state=='thin' %}{{ t('thin', '稀薄') }}{% else %}{{ t('mixed', '参差') }}{% endif %}</b> —
      <b>{{ breadth.pct_above_50 }}%</b> {{ t('above 50-day', '在50日上方') }},
      <b>{{ breadth.pct_above_200 }}%</b> {{ t('above 200-day', '在200日上方') }};
      {{ t('net new highs', '净新高') }} <b>{{ '%+d'|format(breadth.net_nh) }}</b>.
      <span class="muted">{% if breadth.state=='broad' %}{{ t('Broad participation confirms the move.', '广泛参与确认了走势。') }}{% elif breadth.state=='thin' %}{{ t('Few names hold trend — rallies are fragile.', '守住趋势的个股很少 — 反弹脆弱。') }}{% else %}{{ t('No clear breadth edge either way.', '广度上无明显方向优势。') }}{% endif %}</span>
    </p>
    {% if full_breadth %}
    <p class="note" style="margin:0 0 10px;text-transform:none;font-size:12px">{{ t('Full main board', '全主板') }} ({{ full_breadth.n_members }} {{ t('names', '只') }}):
      <span class="pos">{{ full_breadth.adv }}</span> {{ t('up', '涨') }} / <span class="neg">{{ full_breadth.dec }}</span> {{ t('down', '跌') }} ·
      <b>{{ full_breadth.pct_up }}%</b> {{ t('green', '上涨') }} <span class="muted">({{ full_breadth.asof }})</span></p>
    {% endif %}
    <table>
      <tr><td class="l">{{ t('advancing vs declining', '上涨对下跌') }}</td><td><span class="pos">{{ breadth.adv }}</span> / <span class="neg">{{ breadth.dec }}</span></td></tr>
      <tr><td class="l">{{ t('% above 50-day', '50日上方占比') }}</td><td>{{ breadth.pct_above_50 }}% <span class="note">({{ '%+.0f'|format(breadth.pct50_chg20) }})</span></td></tr>
      <tr><td class="l">{{ t('% above 200-day', '200日上方占比') }}</td><td>{{ breadth.pct_above_200 }}%</td></tr>
      <tr><td class="l">{{ t('New highs − lows', '新高−新低') }}</td><td>{{ breadth.nh }} − {{ breadth.nl }}</td></tr>
      <tr><td class="l">{{ t('A-D line (20d)', '腾落线(20日)') }}</td><td class="{{ 'pos' if breadth.ad_trend=='up' else 'neg' }}">{{ '↑' if breadth.ad_trend=='up' else '↓' }}</td></tr>
    </table>
    {% endif %}
    {% if pair %}
    <p class="note" style="margin:12px 0 4px">{{ t('Key ratios (20d %)', '关键比价(20日%)') }}</p>
    <table>
      {% if pair.hshare_hsi %}<tr><td class="l">{{ t('H-shares / HSI', '国企/恒指') }}</td><td class="{{ 'pos' if pair.hshare_hsi.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.hshare_hsi.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.tech_hsi %}<tr><td class="l">{{ t('HS-TECH / HSI', '恒生科技/恒指') }}</td><td class="{{ 'pos' if pair.tech_hsi.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.tech_hsi.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.cyc_def %}<tr><td class="l">{{ t('Cyclical / Defensive', '周期/防御') }}</td><td class="{{ 'pos' if pair.cyc_def.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.cyc_def.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.usdhkd %}<tr><td class="l">{{ t('USD / HKD (peg)', '美元/港元（联汇）') }}</td><td class="{{ 'neg' if pair.usdhkd.chg_20d_pct>=0 else 'pos' }}">{{ '%+.1f'|format(pair.usdhkd.chg_20d_pct) }}</td></tr>{% endif %}
    </table>
    {% endif %}
  </div>

  {% endif %}{# /mode != stocks — breadth & ratios #}

  {% if mode != 'macro' %}
  <!-- ===================== SOUTHBOUND FLOW (南向资金) ===================== -->
  {% if internals and internals.southbound %}{% set sb = internals.southbound %}
  <div class="panel span6">
    <h2>{{ t('🇭🇰 Southbound flow', '🇭🇰 南向资金') }} <span class="note" style="text-transform:none">· {{ t('mainland → Hong Kong', '内地 → 香港') }}</span>
      {{ help("Net daily Stock-Connect southbound flow — mainland money buying HK-listed shares, the single most-watched HK liquidity tell (HK has no central retail-margin disclosure). z-score vs the trailing year; 20-day cumulative net; mainland holdings of HK stock.", "每日南向净流入 — 内地资金买入港股，香港最受关注的流动性指标（香港无集中的散户两融披露）。相对过去一年的 z 分数；20 日累计净额；内地持有港股市值。") }}</h2>
    <div class="stat-row">
      <div><span class="v {{ 'pos' if sb.cum_20d>=0 else 'neg' }}">{{ '%+.0f'|format(sb.cum_20d) }}</span><div class="note">{{ t('20d net (¥100M)', '20日净额(亿元)') }}</div></div>
      <div><span class="v {{ 'pos' if sb.net_z>=0 else 'neg' }}">{{ '%+.1f'|format(sb.net_z) }}σ</span><div class="note">{{ t('today vs 1y', '今日 vs 一年') }}</div></div>
      {% if sb.hold_mktcap %}<div><span class="v">{{ '{:,}'.format(sb.hold_mktcap) }}</span><div class="note">{{ t('mainland holdings (¥100M)', '内地持仓(亿元)') }}</div></div>{% endif %}
      <div><span class="v">{{ sb.pos_days_20 }}/20</span><div class="note">{{ t('net-buy days', '净买入天数') }}</div></div>
    </div>
    {{ sb.chart_html | safe }}
  </div>
  {% endif %}

  <!-- ===== SOUTHBOUND vs PRICE DIVERGENCE (display-only context) ===== -->
  {% if internals and internals.sb_divergence %}{% set d = internals.sb_divergence %}
  <div class="panel span6">
    <h2>{{ t('🔀 Southbound vs price', '🔀 南向 vs 价格') }} <span class="note" style="text-transform:none">· {{ t('flow trend vs HSI trend', '资金趋势 vs 恒指趋势') }}</span>
      {{ help("Context only, not a buy/sell call: does the ~quarter southbound-net FLOW trend pull the same way as the Hang Seng PRICE trend? 'Confirms' = both up or both down; 'Diverges' = flow and price disagree (read the two numbers for which way). Descriptive conditioning, NOT scored into the regime.", "仅供参考，非买卖信号：约一个季度的南向净流入趋势是否与恒生指数价格趋势方向一致？「同向」＝同涨同跌；「背离」＝资金与价格方向相反（看两个数字判断方向）。描述性背景，不计入周期评分。") }}</h2>
    {% if d.state == 'insufficient' %}
    <div class="note">{{ t('Not enough history to compare.', '历史数据不足，暂无法比较。') }}</div>
    {% else %}
    <div class="stat-row">
      <div><span class="v">{{ t('Confirms','同向') if d.state=='confirms' else (t('Diverges','背离') if d.state=='diverges' else t('Mixed','中性')) }}</span><div class="note">{{ t('flow vs price', '资金 vs 价格') }} · {{ d.window_d }}{{ t('d', '日') }}</div></div>
      <div><span class="v {{ 'pos' if d.flow_z>=0 else 'neg' }}">{{ '%+.1f'|format(d.flow_z) }}σ</span><div class="note">{{ t('southbound flow trend', '南向资金趋势') }}</div></div>
      <div><span class="v {{ 'pos' if d.px_ret_pct>=0 else 'neg' }}">{{ '%+.1f'|format(d.px_ret_pct) }}%</span><div class="note">{{ t('HSI', '恒指') }} {{ d.window_d }}{{ t('d', '日') }}</div></div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% endif %}{# /mode != macro — southbound flow #}

  {% if mode != 'stocks' %}
  <!-- ===================== HKMA PEG FUNDING ===================== -->
  {% if funding %}
  <div class="panel span6" id="peg-funding">
    <h2>{{ t('HKMA peg funding', '金管局联汇流动性') }} <span class="note" style="text-transform:none">· {{ t('Aggregate Balance + HIBOR', '总结余 + HIBOR') }}</span>
      {{ help("The Aggregate Balance is HK banks' settlement liquidity; it mechanically SHRINKS when the HKMA sells USD to defend the 7.85 weak-side peg — the real driver of HIBOR spikes and HSI funding headwinds. Falling balance + rising HIBOR = tightening.", "总结余是香港银行体系的结算流动性；当金管局卖出美元捍卫 7.85 弱方兑换保证时会机械性收缩 — 这是 HIBOR 抽升与港股资金面逆风的真正成因。总结余下降＋HIBOR 上行＝收紧。") }}</h2>
    <div class="stat-row">
      <div><span class="v">{{ '{:,}'.format(funding.agg_balance) }}</span><div class="note">{{ t('Aggregate Balance (HK$M)', '总结余(百万港元)') }}{% if funding.agg_chg_1y_pct is not none %} · <span class="{{ 'neg' if funding.agg_chg_1y_pct<0 else 'pos' }}">{{ '%+.0f'|format(funding.agg_chg_1y_pct) }}% {{ t('1y', '年') }}</span>{% endif %}</div></div>
      {% if funding.hibor_on is not none %}<div><span class="v">{{ funding.hibor_on }}%</span><div class="note">{{ t('HIBOR overnight', '隔夜 HIBOR') }}</div></div>{% endif %}
      {% if funding.hibor_1m is not none %}<div><span class="v">{{ funding.hibor_1m }}%</span><div class="note">{{ t('HIBOR 1-month', '1 个月 HIBOR') }}</div></div>{% endif %}
      {% if funding.twi is not none %}<div><span class="v">{{ funding.twi }}</span><div class="note">{{ t('HKD TWI', '港汇指数') }}</div></div>{% endif %}
    </div>
    {{ funding.chart_html | safe }}
  </div>
  {% endif %}

  {% endif %}{# /mode != stocks — HKMA peg funding #}

  {% if mode != 'macro' %}
  <!-- ===================== AH PREMIUM (computed basket) ===================== -->
  {% if ah %}
  <div class="panel span6">
    <h2>{{ t('AH premium', 'AH 溢价') }} <span class="note" style="text-transform:none">· {{ t('A-share vs HK-listed H twin', 'A股 对 H股') }}</span>
      {{ help("For dual-listed companies, how much DEARER the Shanghai/Shenzhen A-share trades vs its Hong-Kong-listed H-share twin (FX-adjusted, equal-weight basket). A high premium = the H/HK line is the cheaper way to own the same company; a low/compressing premium = that value gap has closed. Lean on the trend + percentile, not the absolute level (computed basket, not the official index).", "对于两地上市公司，沪深 A 股相对其香港上市 H 股的溢价（经汇率调整、等权篮子）。溢价高＝以 H/港股持有同一公司更便宜；溢价低/收窄＝价值差已收敛。请关注趋势与分位，而非绝对水平（自算篮子，非官方指数）。") }}</h2>
    <div class="stat-row">
      <div><span class="v">{{ '%+.1f'|format(ah.premium_pct) }}%</span><div class="note">{{ t('basket A-over-H', '篮子 A 高于 H') }} ({{ ah.n_pairs }} {{ t('pairs', '对') }})</div></div>
      {% if ah.pctile is not none %}<div><span class="v">{{ ah.pctile }}%ile</span><div class="note">{{ t('vs 3y range', '对比3年区间') }}</div></div>{% endif %}
      {% if ah.chg_1y is not none %}<div><span class="v {{ 'neg' if ah.chg_1y<0 else 'pos' }}">{{ '%+.1f'|format(ah.chg_1y) }}pp</span><div class="note">{{ t('1y change', '一年变化') }}</div></div>{% endif %}
    </div>
    {{ ah.chart_html | safe }}
    <table style="margin-top:8px"><thead><tr><th class="l">{{ t('Pair', '配对') }}</th><th>{{ t('A-over-H %', 'A 高于 H %') }}</th></tr></thead><tbody>
    {% for p in ah.pairs[:6] %}<tr><td class="l">{{ p.name }} <span class="note">{{ p.h }}</span></td><td>{{ '%+.1f'|format(p.premium_pct) }}%</td></tr>{% endfor %}
    </tbody></table>
  </div>
  {% endif %}

  {% endif %}{# /mode != macro — AH premium #}

  {% if mode != 'stocks' %}
  <!-- ===================== CHINA EARNINGS BACKDROP ===================== -->
  {% if internals and (internals.credit or internals.pboc) %}
  <div class="panel span6">
    <h2>{{ t('China earnings backdrop', '中国盈利背景') }} <span class="note" style="text-transform:none">· {{ t('drives HSI fundamentals', '驱动恒指基本面') }}</span>
      {{ help("HSI is ~75% China earnings, so the Mainland credit + policy cycle is the fundamental driver. The credit impulse (社融脉冲) historically leads risk assets ~2 quarters; PBoC RRR cuts free bank liquidity.", "恒指约 75% 为中国盈利，故内地信贷与政策周期是基本面驱动。社融脉冲历史上领先风险资产约两个季度；央行降准释放银行体系流动性。") }}</h2>
    <div class="stat-row">
      {% if internals.credit and internals.credit.credit_impulse is not none %}<div><span class="v {{ 'pos' if internals.credit.credit_impulse>=0 else 'neg' }}">{{ '%+.1f'|format(internals.credit.credit_impulse) }}</span><div class="note">{{ t('credit impulse (社融)', '社融脉冲') }}{% if internals.credit.credit_impulse_6mo is not none %} · {{ t('6mo ago', '半年前') }} {{ '%+.1f'|format(internals.credit.credit_impulse_6mo) }}{% endif %}</div></div>{% endif %}
      {% if internals.pboc %}<div><span class="v">{{ internals.pboc.rrr_big }}%</span><div class="note">{{ t('RRR (big banks)', '大行存准率') }} · <span class="{{ 'pos' if internals.pboc.bias=='easing' else ('neg' if internals.pboc.bias=='tightening' else '') }}">{{ td(internals.pboc.bias) }}</span></div></div>{% endif %}
    </div>
    {% if internals.credit and internals.credit.impulse_html %}{{ internals.credit.impulse_html | safe }}{% endif %}
  </div>
  {% endif %}

  <!-- MTF cards for the leaders -->
  <div class="panel span12">
    <h2>{{ t('Cycle Detail — Sector Leaders', '周期详情 — 领先板块') }}</h2>
    <div class="mtf-grid">
      {% for s in sectors[:6] %}
      <div class="mtf-card">
        <div class="mtf-name"><a href="sectors/{{ s.ticker }}.html">{{ td(s.name) }}</a> <span class="lad {{ 'up' if s.dir=='up' else ('down' if s.dir=='down' else 'flat') }}">{{ td(s.label or s.state) }}</span></div>
        <div class="mtf" data-mtf='{{ s.mtf_json }}'></div>
      </div>
      {% endfor %}
    </div>
  </div>

  {% endif %}{# /mode != stocks — macro group 3 (China earnings backdrop, sector-leader cycle detail) #}

</div>

<div class="foot">
  {{ t('Built', '生成于') }} {{ built }} ·
  {{ t('Free public data (yfinance), mechanical &amp; backtested · not investment advice',
        '免费公开数据（yfinance），机械化并经回测 · 非投资建议') }}<br>
  {{ t('HSI 1986→; sectors are deep synthetic baskets of curated HK large-caps; regime classified 2006→.',
        '恒生指数始于1986年；板块为精选香港大盘股的深度合成篮子；周期分类始于2006年。') }}
</div>

<script src="theme.js"></script>
<script src="mtf.js"></script>
<script src="charts.js"></script>
<script src="tablesort.js"></script>
<script src="timemachine.js"></script>
</body>
</html>
