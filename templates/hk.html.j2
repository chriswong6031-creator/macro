<script>
/* W8-G: StockTable init — standout board table view (HK market).
   Wired only on the stocks mode page (setups.buy exists); safe no-op if element absent.
   HK-specific columns: group, ticker, name, sector, price (HKD), off_high, conviction,
   alpha (63d RS z), edge_z, sb_z (southbound accum z), ah_z (A/H value z), washout_2w.
   No mcap/cap_bucket/days_since_signal/tier — not on HK rows. No stage/zone — HK uses group. */
(function(){
  if (!window.StockTable) return;  /* stocktable.js not loaded */
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum;

  var GROUP_LABELS = {
    "entry_open":  ["Entry open", "入场开启"],
    "setting_up":  ["Setting up", "蓄势中"]
  };
  var ALIGN_LABELS = {
    "aligned": ["Aligned", "共振"],
    "near":    ["Near", "临近"]
  };
  var SECZH = {
    "Technology":"科技","Industrials":"工业","Basic Materials":"原材料",
    "Financial Services":"金融","Consumer Cyclical":"可选消费",
    "Healthcare":"医疗保健","Utilities":"公用事业","Consumer Defensive":"必需消费",
    "Energy":"能源","Communication Services":"通信服务","Real Estate":"房地产",
    "Telecom & Utilities":"电信与公用事业","Consumer":"消费","Finance":"金融",
    "Financial":"金融","Technology & Telecom":"科技与电信"
  };

  function groupBadge(group) {
    var lbl = GROUP_LABELS[group] || [group || "—", group || "—"];
    var cls = group === "entry_open" ? "st-chip-entry" : "st-chip-rip";
    return '<span class="st-chip ' + cls + '">' + b(lbl[0], lbl[1]) + '</span>';
  }

  var cols = [
    { key:"_group_display", labelEn:"Group", labelZh:"组别", default:true, sortable:false,
      fmt:function(v,r){ return groupBadge(r.group); },
      tip:{en:"Entry open = confluence buyable + in/near buy zone. Setting up = aligned but awaiting entry.",
           zh:"入场开启 = 汇流可买入 + 位于买入区附近。蓄势中 = 已共振但等待入场。"} },
    { key:"ticker", labelEn:"Ticker", labelZh:"代码", default:true, sortable:true,
      fmt:function(v,r){
        return '<b>' + esc(v||'') + '</b>';
      }},
    { key:"name", labelEn:"Name", labelZh:"名称", default:true, sortable:true,
      fmt:function(v,r){
        if (!v) return '<span class="st-muted">—</span>';
        var zh = r.name_zh || v;
        return b(esc(v), esc(zh));
      }},
    { key:"sector", labelEn:"Sector", labelZh:"板块", default:true, sortable:true,
      fmt:function(v,r){
        if (!v) return '<span class="st-muted">—</span>';
        var zh = r.sector_zh || SECZH[v] || v;
        return b(esc(v), esc(zh));
      }},
    { key:"price", labelEn:"Price HK$", labelZh:"价格(港元)", default:true, sortable:true, right:true,
      fmt:function(v){ return v==null ? '<span class="st-muted">—</span>' : fn(v,2); },
      tip:{en:"Last close price in HKD",zh:"最近收盘价（港元）"} },
    { key:"off_high", labelEn:"Off High", labelZh:"距高点", default:true, sortable:true, right:true,
      fmt:function(v){ return v==null ? '<span class="st-muted">—</span>' : fp(v,1); },
      tip:{en:"% off 52-week high",zh:"距52周高点百分比"} },
    { key:"conviction", labelEn:"Score", labelZh:"评分", default:true, sortable:true, right:true,
      fmt:function(v){
        if (v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v);
        var cls = n>=70 ? 'st-pos' : n>=40 ? '' : 'st-neg';
        return '<span class="' + cls + '">' + n + '</span>';
      },
      tip:{en:"HK conviction score — edge percentile (not a win-rate). Fused: southbound flow + A/H value + beta-neutral RS.",
           zh:"港股确信评分 — 优势百分位（非胜率）。融合：南向资金 + A/H 价值 + 贝塔中性相对强度。"} },
    { key:"alpha", labelEn:"3M RS z", labelZh:"3月相对强度z", default:true, sortable:true, right:true,
      fmt:function(v){ return v==null ? '<span class="st-muted">—</span>' :
        '<span class="' + (v>=0 ? 'st-pos' : 'st-neg') + '">' + fn(v,2) + '</span>'; },
      tip:{en:"63-day relative return z-score within HK board universe (descriptive context, not a rank input)",
           zh:"63日收益率z分数（港股看板宇宙内的描述性背景，非排序输入）"} },
    { key:"edge_z", labelEn:"Edge z", labelZh:"综合优势z", default:true, sortable:true, right:true,
      fmt:function(v){ return v==null ? '<span class="st-muted">—</span>' :
        '<span class="' + (v>=0 ? 'st-pos' : 'st-neg') + '">' + fn(v,2) + '</span>'; },
      tip:{en:"Fused HK edge z (southbound + A/H value + beta-neutral RS). Primary rank input.",
           zh:"融合港股优势z（南向资金 + A/H价值 + 贝塔中性强度）。主要排序输入。"} },
    { key:"sb_z", labelEn:"SB flow z", labelZh:"南向资金z", default:true, sortable:true, right:true,
      fmt:function(v,r){
        if (v==null) return '<span class="st-muted">—</span>';
        var cls = v>=0.6 ? 'st-pos' : v<=-0.6 ? 'st-neg' : '';
        var own = r.sb_own!=null ? ' <span class="st-muted">(' + fn(r.sb_own,1) + '%)</span>' : '';
        return '<span class="' + cls + '">' + fn(v,2) + '</span>' + own;
      },
      tip:{en:"Southbound Connect accumulation z-score. Context only — H1 NO-GO (not a standalone edge).",
           zh:"南向资金累积z分数。仅供参考 — H1未通过（不作为独立优势）。"} },
    { key:"ah_z", labelEn:"A/H z", labelZh:"A/H价值z", default:true, sortable:true, right:true,
      fmt:function(v,r){
        if (v==null) return '<span class="st-muted">—</span>';
        var cls = r.ah_cheap ? 'st-pos' : '';
        return '<span class="' + cls + '">' + fn(v,2) + (r.ah_cheap ? ' <span style="font-size:9px">H</span>' : '') + '</span>';
      },
      tip:{en:"A/H value z — H-share cheap vs A-share twin when positive. Near-GO (DSR 0.879).",
           zh:"A/H价值z — 正值表示H股相对A股孪生便宜。临近通过（DSR 0.879）。"} },
    { key:"align_tier", labelEn:"Alignment", labelZh:"共振级别", default:false, sortable:true,
      fmt:function(v){
        if (!v) return '<span class="st-muted">—</span>';
        var lbl = ALIGN_LABELS[v] || [v, v];
        var cls = v==='aligned' ? 'st-pos' : '';
        return '<span class="' + cls + '">' + b(lbl[0], lbl[1]) + '</span>';
      },
      tip:{en:"Aligned = weekly+3D+daily all turning up (PRIME/ARMED). Near = backfill.",
           zh:"共振 = 周线+3日+日线均向上（精英/武装）。临近 = 补位。"} },
    { key:"washout_2w", labelEn:"2W washout", labelZh:"双周洗盘", default:false, sortable:true,
      fmt:function(v){ return v ? '<span class="st-pos">✓</span>' : '<span class="st-muted">—</span>'; },
      tip:{en:"2-week StochRSI washout-reclaim cross (CN port, display context, no rank effect yet)",
           zh:"双周随机RSI洗盘回升穿越（CN移植，展示背景，暂无排序效果）"} },
  ];

  /* use a non-colliding key for the derived group+display column */
  cols[0].key = '_group_display_key';

  /* ── view persistence ── */
  var LS_VIEW = 'mdx_stocktable_hk_view';
  var currentView = localStorage.getItem(LS_VIEW) || 'grid';

  function applyView(v) {
    currentView = v;
    localStorage.setItem(LS_VIEW, v);
    var standouts = document.getElementById('standouts');
    var chipsEl   = document.getElementById('st-count-chips');
    var gbtn = document.getElementById('st-btn-grid');
    var tbtn = document.getElementById('st-btn-table');
    if (!standouts) return;
    if (v === 'table') {
      standouts.classList.add('st-table-mode');
      /* HK: count-chips uses CN stage taxonomy — never shown (element stays display:none) */
      if (gbtn) gbtn.setAttribute('aria-selected','false');
      if (tbtn) tbtn.setAttribute('aria-selected','true');
    } else {
      standouts.classList.remove('st-table-mode');
      if (gbtn) gbtn.setAttribute('aria-selected','true');
      if (tbtn) tbtn.setAttribute('aria-selected','false');
    }
  }

  StockTable._setView = applyView;

  /* ── init ── */
  /* Filter dropdown labels — single active language per option (matches CN board). */
  var SECTOR_LABELS = {};
  Object.keys(SECZH).forEach(function(k){ SECTOR_LABELS[k] = [k, SECZH[k]]; });
  StockTable.init({
    dataId:      'stocktable-data',
    containerId: 'stocktable-wrap',
    market:      'hk',
    linkPattern: 'hk_lookup.html#{ticker}',
    columns:     cols,
    optionLabels: { sector: SECTOR_LABELS },
    searchPlaceholder: ['Search name or theme…','搜索名称或主题…'],
  });

  /* restore persisted view */
  applyView(currentView);
})();
</script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge). */
(function(){
  function placePop(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  /* Tap the button → toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      /* close any other open popovers */
      document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      if (!wasOpen){ placePop(wrap); wrap.classList.add('nb-cau-open'); }
    } else {
      /* outside tap: close all */
      if (!e.target.closest('.nb-cau-pop')){
        document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      }
    }
  }, true);
  /* Also position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var wrap = e.target.closest && e.target.closest('.nb-cau');
    if (wrap) placePop(wrap);
  }, true);
})();
</script>
