  <div class="panel span6">
    <h2>{{ t('AH premium', 'AH 溢价') }} <span class="note" style="text-transform:none">· {{ t('A-share vs HK-listed H twin', 'A股 对 H股') }}</span>
      {{ help("A-share premium vs HK-listed H-share twins. High premium means H-shares are cheaper.", "A股相对香港H股孪生的溢价。高溢价表示H股更便宜。") }}</h2>
    <div class="stat-row">
      <div><span class="v">{{ '%+.1f'|format(ah.premium_pct) }}%</span><div class="note">{{ t('basket A-over-H', '篮子 A 高于 H') }} ({{ ah.n_pairs }} {{ t('pairs', '对') }})</div></div>
      {% if ah.pctile is not none %}<div><span class="v">{{ ah.pctile }}%ile</span><div class="note">{{ t('vs 3y range', '对比3年区间') }}</div></div>{% endif %}
      {% if ah.chg_1y is not none %}<div><span class="v {{ 'neg' if ah.chg_1y<0 else 'pos' }}">{{ '%+.1f'|format(ah.chg_1y) }}pp</span><div class="note">{{ t('1y change', '一年变化') }}</div></div>{% endif %}
    </div>
    {{ ah.chart_html | safe }}
    <table style="margin-top:8px"><thead><tr><th class="l">{{ t('Pair', '配对') }}</th><th>{{ t('A-over-H %', 'A 高于 H %') }}</th></tr></thead><tbody>
    {% for p in ah.pairs[:6] %}<tr><td class="l">{{ p.name }} <span class="note">{{ p.h }}</span></td><td>{{ '%+.1f'|format(p.premium_pct) }}%</td></tr>{% endfor %}
    </tbody></table>
  </div>
  {% endif %}

  {% endif %}{# /mode != macro — AH premium #}

  {% if mode != 'stocks' %}
  <!-- ===================== CHINA EARNINGS BACKDROP ===================== -->
  {% if internals and (internals.credit or internals.pboc) %}
  <div class="panel span6">
    <h2>{{ t('China earnings backdrop', '中国盈利背景') }} <span class="note" style="text-transform:none">· {{ t('drives HSI fundamentals', '驱动恒指基本面') }}</span>
      {{ help("HSI earnings are mostly China-driven, so credit and policy matter.", "恒指盈利大多由中国驱动，因此信贷与政策很重要。") }}</h2>
    <div class="stat-row">
      {% if internals.credit and internals.credit.credit_impulse is not none %}<div><span class="v {{ 'pos' if internals.credit.credit_impulse>=0 else 'neg' }}">{{ '%+.1f'|format(internals.credit.credit_impulse) }}</span><div class="note">{{ t('credit impulse (社融)', '社融脉冲') }}{% if internals.credit.credit_impulse_6mo is not none %} · {{ t('6mo ago', '半年前') }} {{ '%+.1f'|format(internals.credit.credit_impulse_6mo) }}{% endif %}</div></div>{% endif %}
      {% if internals.pboc %}<div><span class="v">{{ internals.pboc.rrr_big }}%</span><div class="note">{{ t('RRR (big banks)', '大行存准率') }} · <span class="{{ 'pos' if internals.pboc.bias=='easing' else ('neg' if internals.pboc.bias=='tightening' else '') }}">{{ td(internals.pboc.bias) }}</span></div></div>{% endif %}
    </div>
    {% if internals.credit and internals.credit.impulse_html %}{{ internals.credit.impulse_html | safe }}{% endif %}
  </div>
  {% endif %}

  <!-- MTF cards for the leaders -->
  <div class="panel span12">
    <h2>{{ t('Cycle Detail — Sector Leaders', '周期详情 — 领先板块') }}</h2>
    <div class="mtf-grid">
      {% for s in sectors[:6] %}
      <div class="mtf-card">
        <div class="mtf-name"><a href="sectors/{{ s.ticker }}.html">{{ td(s.name) }}</a> <span class="lad {{ 'up' if s.dir=='up' else ('down' if s.dir=='down' else 'flat') }}">{{ td(s.label or s.state) }}</span></div>
        <div class="mtf" data-mtf='{{ s.mtf_json }}'></div>
      </div>
      {% endfor %}
    </div>
  </div>

  {% endif %}{# /mode != stocks — macro group 3 (China earnings backdrop, sector-leader cycle detail) #}

</div>

<div class="foot">
  {{ t('Built', '生成于') }} {{ built }}<br>
  <span class="made">© 2026 MastermindX Inc</span>
</div>

<script src="theme.js"></script>
<script src="mtf.js"></script>
<script src="charts.js"></script>
<script src="tablesort.js"></script>
<script src="timemachine.js"></script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge). */
(function(){
  function placePop(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  /* Tap the button → toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      /* close any other open popovers */
      document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      if (!wasOpen){ placePop(wrap); wrap.classList.add('nb-cau-open'); }
    } else {
      /* outside tap: close all */
      if (!e.target.closest('.nb-cau-pop')){
        document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      }
    }
  }, true);
  /* Also position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var wrap = e.target.closest && e.target.closest('.nb-cau');
    if (wrap) placePop(wrap);
  }, true);
})();
</script>
</body>
</html>
