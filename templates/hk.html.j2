            <div class="hkx-eyebrow">{{ t('The profit engine (China)','盈利引擎（中国）') }}</div>
            {% if internals and internals.pboc %}
            <div class="hkx-kv"><span class="hkx-k">{{ t("China's central bank",'中国央行') }}</span><span class="hkx-v"><span class="hkx-stword ok">{{ t('Supportive','支持') }}</span></span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('RRR (big banks)','大行存准率') }}</span><span class="hkx-v">{{ internals.pboc.rrr_big }}%</span></div>
            {% endif %}
            {% if funding and funding.base_rate %}
            <div class="hkx-kv"><span class="hkx-k">{{ t('Base rate','基准利率') }}</span><span class="hkx-v">{{ funding.base_rate }}%</span></div>
            {% endif %}
            {% if funding and funding.twi is not none %}
            <div class="hkx-kv"><span class="hkx-k">{{ t('Trade-weighted HKD','贸易加权港元') }}</span><span class="hkx-v">{{ '%.1f'|format(funding.twi) }}</span></div>
            {% endif %}
          </div>
        </div>
        {# Aggregate Balance chart — system liquidity trend #}
        {% if funding and funding.chart_html %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Aggregate Balance — system liquidity','综合结余 — 系统流动性') }}</div>
        <div style="max-width:100%;overflow:hidden">{{ funding.chart_html | safe }}</div>
        {% endif %}
        {# Catalyst strip: upcoming HK rate-sensitive events #}
        {% if catalyst_strip %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Key dates ahead','关键日期') }}</div>
        {% for cat in catalyst_strip[:4] %}
        <div class="hkx-kv"><span class="hkx-k">{{ t(cat.name_en, cat.name_zh) if cat.name_en is defined else '—' }}</span><span class="hkx-v">{{ cat.date if cat.date is defined else '—' }}</span></div>
        {% endfor %}
        {% endif %}
        <div class="hkx-receipt">{{ t('When the two engines pull apart, the currency & interest-rate side usually wins on short-term timing.','当两台引擎分歧时，货币与利率面通常在短期节奏上占主导。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-flows: Mainland Buying & Value #}
  <div class="hkx-dlg" id="hkx-dlg-flows">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('Mainland Buying & Value','南向资金与价值') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('Mainland investors can buy Hong Kong shares through a link called <b>Stock Connect</b>. When they\'re net buyers, it\'s a vote of confidence in HK — and it\'s HK\'s steadiest source of demand.','内地投资者可通过<b>沪深港通</b>买入港股。净买入时，是对港股的信心投票，也是港股最稳定的需求来源。') | safe }}</div>
        <div class="hkx-cols2">
          <div>
            <div class="hkx-eyebrow">{{ t('Mainland money into Hong Kong','内地资金流入港股') }}</div>
            {% if internals and internals.southbound %}
            {% set sb = internals.southbound %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 8px">
              {# Two bugs lived on this line: the divisor (field is 亿, so bn = 亿/10, not /1000)
                 and Jinja filter precedence — `sb.net / 1000|abs` applies abs() to 1000, not to
                 the quotient, so a negative day leaked through as "~¥-0bn". Parenthesise. #}
              <span class="hkx-bignum" style="color:{{ 'var(--up)' if (sb.net is not none and sb.net >= 0) else 'var(--down)' }}">{{ t('~¥%.1fbn'|format((sb.net / 10)|abs), '~%.0f亿'|format(sb.net|abs)) if sb.net is not none else '—' }}</span>
              {# pill-buy/pill-sell CSS classes use color-mix over var(--up)/var(--down) → auto-flip in zh #}
              <span class="hkx-alert-pill {{ 'pill-buy' if (sb.net is not none and sb.net >= 0) else 'pill-sell' }}" style="margin:0">{{ t('NET BUYING','净买入') if (sb.net is not none and sb.net >= 0) else t('NET SELLING','净卖出') }}</span>
            </div>
            {% if sb.cum_20d is not none %}<div class="hkx-kv"><span class="hkx-k">{{ t('Last 20 days','近20日') }}</span><span class="hkx-v">{{ t('~¥%.0fbn'|format((sb.cum_20d / 10)|abs), '~%.0f亿'|format(sb.cum_20d|abs)) }} {{ t('total','合计') }}</span></div>{% endif %}
            {% if sb.pos_days_20 is not none %}<div class="hkx-kv"><span class="hkx-k">{{ t('How often','频率') }}</span><span class="hkx-v">{{ t('bought on','买入') }} {{ sb.pos_days_20 }} {{ t('of 20 days','天（共20日）') }}</span></div>{% endif %}
            {% else %}
            <p style="font-size:12px;color:var(--muted)">—</p>
            {% endif %}
          </div>
          <div>
            <div class="hkx-eyebrow">{{ t('Why HK is a bargain','港股为何更便宜') }}</div>
            {% if ah_official and ah_official.premium_pct is not none %}
            <div class="hkx-kv"><span class="hkx-k">{{ t('A/H premium','A/H溢价') }}</span><span class="hkx-v">{{ '%.1f'|format(ah_official.premium_pct) }}%</span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('Percentile','历史分位') }}</span><span class="hkx-v">{{ ah_official.pctile }}{{ t('th','百分位') }}</span></div>
            {% if ah_official.chart_html %}
            <div style="max-width:100%;overflow:hidden;margin-top:8px">{{ ah_official.chart_html | safe }}</div>
            {% endif %}
            {% else %}
            <p style="font-size:12px;color:var(--muted)">—</p>
            {% endif %}
            {# Valuation (PE/PB) #}
            {% if valuation and (valuation.pe is defined or valuation.pb is defined) %}
            <div class="hkx-sep" style="margin:10px 0"></div>
            <div class="hkx-eyebrow">{{ t('Valuation','估值') }}</div>
            <div class="hkx-val-pair">
              {% if valuation.pe is defined and valuation.pe %}
              <div>
                <div class="hkx-kv"><span class="hkx-k">{{ t('P/E','市盈率') }}</span><span class="hkx-v">{{ '%.1f'|format(valuation.pe.level) if valuation.pe.level is not none else '—' }}</span></div>
                <div class="hkx-kv"><span class="hkx-k">{{ t('Pctile','历史分位') }}</span><span class="hkx-v">{{ (valuation.pe.pctile ~ t('th','百分位')) if valuation.pe.pctile is not none else '—' }}</span></div>
              </div>
              {% endif %}
              {% if valuation.pb is defined and valuation.pb %}
              <div>
                <div class="hkx-kv"><span class="hkx-k">{{ t('P/B','市净率') }}</span><span class="hkx-v">{{ '%.2f'|format(valuation.pb.level) if valuation.pb.level is not none else '—' }}</span></div>
                <div class="hkx-kv"><span class="hkx-k">{{ t('Pctile','历史分位') }}</span><span class="hkx-v">{{ (valuation.pb.pctile ~ t('th','百分位')) if valuation.pb.pctile is not none else '—' }}</span></div>
              </div>
              {% endif %}
            </div>
            {% endif %}
          </div>
        </div>
        {# Southbound flow chart #}
        {% if internals and internals.southbound and internals.southbound.chart_html %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Cumulative southbound flow','南向资金累计走势') }}</div>
        <div style="max-width:100%;overflow:hidden">{{ internals.southbound.chart_html | safe }}</div>
        {% endif %}
        {# Per-channel SH/SZ split #}
        {% if sb_channels and (sb_channels.sh is defined or sb_channels.sz is defined) %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Shanghai vs Shenzhen connect','沪股通 vs 深股通') }}</div>
        <div class="hkx-cols2">
          {% if sb_channels.sh %}
          <div>
            <div class="hkx-eyebrow" style="margin-top:0">{{ t(sb_channels.sh.label_en, sb_channels.sh.label_zh) if sb_channels.sh.label_en is defined else t('Shanghai','沪') }}</div>
            {# collectors/hk_connect_channels.py emits these in 亿 (¥100M) already — the old
               "¥%.0fM" label was off by 100x and the /1000 for the 20d total by another 100x.
               bn = 亿 / 10; ZH shows 亿 natively. #}
            <div class="hkx-kv"><span class="hkx-k">{{ t('Today','今日') }}</span><span class="hkx-v {{ 'hkx-up' if (sb_channels.sh.net is not none and sb_channels.sh.net >= 0) else 'hkx-dn' }}">{{ t('¥%+.1fbn'|format(sb_channels.sh.net / 10), '%+.0f亿'|format(sb_channels.sh.net)) if sb_channels.sh.net is not none else '—' }}</span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('20d','20日') }}</span><span class="hkx-v">{{ t('¥%+.0fbn'|format(sb_channels.sh.sum_20d / 10), '%+.0f亿'|format(sb_channels.sh.sum_20d)) if (sb_channels.sh.sum_20d is defined and sb_channels.sh.sum_20d is not none) else '—' }}</span></div>
          </div>
          {% endif %}
          {% if sb_channels.sz %}
          <div>
            <div class="hkx-eyebrow" style="margin-top:0">{{ t(sb_channels.sz.label_en, sb_channels.sz.label_zh) if sb_channels.sz.label_en is defined else t('Shenzhen','深') }}</div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('Today','今日') }}</span><span class="hkx-v {{ 'hkx-up' if (sb_channels.sz.net is not none and sb_channels.sz.net >= 0) else 'hkx-dn' }}">{{ t('¥%+.1fbn'|format(sb_channels.sz.net / 10), '%+.0f亿'|format(sb_channels.sz.net)) if sb_channels.sz.net is not none else '—' }}</span></div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('20d','20日') }}</span><span class="hkx-v">{{ t('¥%+.0fbn'|format(sb_channels.sz.sum_20d / 10), '%+.0f亿'|format(sb_channels.sz.sum_20d)) if (sb_channels.sz.sum_20d is defined and sb_channels.sz.sum_20d is not none) else '—' }}</span></div>
          </div>
          {% endif %}
        </div>
        {% endif %}
        <div class="hkx-receipt">{{ t('Steady mainland buying is the clearest sign of mainland confidence in HK — a cushion, not a stand-alone buy signal.','稳定的南向资金是内地对港股信心最直接的体现 — 是托底，而非单独买入信号。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-overnight: Overnight & Leverage #}
  <div class="hkx-dlg" id="hkx-dlg-overnight">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('Overnight Read & Leverage','隔夜读数与杠杆') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-cols2">
          <div>
            <div class="hkx-eyebrow">{{ t('Overnight US read','美股隔夜读数') }}</div>
            <div class="hkx-plain" style="margin-top:0">{{ t('Several big HK companies also trade in New York (as "ADRs") while Hong Kong is closed. How they moved overnight gives an early hint of tomorrow\'s HK open.','多家大型港股公司在纽约也有上市（ADR），港股关市期间可参考。隔夜走势是明日港股开盘的早期提示。') }}</div>
            {% if adr_bridge and adr_bridge.composite %}
            {% set _adr = adr_bridge.composite %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 6px">
              <span class="hkx-bignum" style="font-size:22px;color:{{ 'var(--up)' if (_adr.bellwether_implied_open_pct is not none and _adr.bellwether_implied_open_pct > 0.2) else ('var(--down)' if (_adr.bellwether_implied_open_pct is not none and _adr.bellwether_implied_open_pct < -0.2) else 'var(--warn)') }}">{{ (('%+.1f'|format(_adr.bellwether_implied_open_pct)) + '%') if _adr.bellwether_implied_open_pct is not none else '—' }}</span>
            </div>
            <div class="hkx-kv"><span class="hkx-k">{{ t('Implied HK open','隐含港股开盘') }}</span><span class="hkx-v">{{ (('%+.1f'|format(_adr.bellwether_implied_open_pct)) + '%') if _adr.bellwether_implied_open_pct is not none else '—' }}</span></div>
            {% if _adr.gap_context %}<div style="font-size:11px;color:var(--muted);margin-top:6px">{{ _adr.gap_context }}</div>{% endif %}
            {% endif %}
            {# Per-name ADR moves #}
            {% if adr_bridge and adr_bridge.names is defined and adr_bridge.names %}
            <div class="hkx-sep" style="margin:10px 0"></div>
            <div class="hkx-eyebrow">{{ t('Individual ADR moves','个股ADR走势') }}</div>
            <table class="hkx-mt">
              <tr><th>{{ t('Name','名称') }}</th><th class="r">{{ t('Implied open','隐含开盘') }}</th></tr>
              {% for adr in adr_bridge.names[:6] %}
              <tr>
                <td>{{ t(adr.hk_name_en, adr.hk_name_zh) if (adr.hk_name_en is defined and adr.hk_name_zh is defined) else (adr.hk_name_en if adr.hk_name_en is defined else adr.hk_ticker) }}</td>
                <td class="r {{ 'hkx-up' if (adr.implied_open_gap_pct is defined and adr.implied_open_gap_pct is not none and adr.implied_open_gap_pct >= 0) else 'hkx-dn' }}">{{ ('%+.1f'|format(adr.implied_open_gap_pct) + '%') if (adr.implied_open_gap_pct is defined and adr.implied_open_gap_pct is not none) else '—' }}</td>
              </tr>
              {% endfor %}
            </table>
            {% endif %}
            <div style="font-size:11px;color:var(--muted);margin-top:6px">{{ t('A heads-up, not a forecast — the feed can lag and gaps often fill.','提前预警，不是预测 — 数据可能滞后，且缺口通常会填补。') }}</div>
          </div>
          <div>
            <div class="hkx-eyebrow">{{ t('Leverage bets (CBBC/warrants)','杠杆仓位（牛熊证/认股证）') }}</div>
            <div class="hkx-plain" style="margin-top:0">{{ t('Hong Kong has popular <b>leveraged bets</b> on big stocks. When lots pile up at one price level, a move through it can trigger forced buying or selling — speeding up the move.','香港有流行的<b>杠杆产品</b>押注大盘股。当大量仓位集中在某价位时，一旦突破可能触发强制买卖，加速行情。') | safe }}</div>
            {% if cbbc_map and cbbc_map.bellwethers %}
            {% for cb in cbbc_map.bellwethers[:2] %}
            <div class="hkx-kv"{% if cbbc_map.banner %} style="opacity:.55"{% endif %}><span class="hkx-k">{{ cb.name_en if cb.name_en is defined else '—' }}</span><span class="hkx-v"><span class="hkx-stword {{ 'bad' if 'bear' in (cb.leverage_state or '') else ('ok' if 'bull' in (cb.leverage_state or '') else 'warn') }}">{{ t('Bearish','偏空') if 'bear' in (cb.leverage_state or '') else (t('Bullish','偏多') if 'bull' in (cb.leverage_state or '') else ('—' if cb.leverage_state == 'no_data' else t('Balanced','均衡'))) }}</span></span></div>
            {% if cb.bull_outstanding is not none and cb.bear_outstanding is not none %}
            {% set _tot = cb.bull_outstanding + cb.bear_outstanding %}
            <div class="hkx-bbar"{% if cbbc_map.banner %} style="opacity:.55"{% endif %}><span class="hkx-bull" style="width:{{ (cb.bull_outstanding / _tot * 100)|int }}%"></span><span class="hkx-bear" style="width:{{ (cb.bear_outstanding / _tot * 100)|int }}%"></span></div>
            {% endif %}
            {% endfor %}
            {% endif %}
            {% if cbbc_map and cbbc_map.banner %}
            <div style="font-size:11px;color:var(--warn);margin-top:6px"><span class="l-en">{{ cbbc_map.banner.en }}</span><span class="l-zh">{{ cbbc_map.banner.zh }}</span></div>
            {% endif %}
            {% if cbbc_map and cbbc_map.sld_banner %}
            <div style="font-size:11px;color:var(--warn);margin-top:6px"><span class="l-en">{{ cbbc_map.sld_banner.en }}</span><span class="l-zh">{{ cbbc_map.sld_banner.zh }}</span></div>
            {% endif %}
            {% if cbbc_map and (cbbc_map.sld_freshness == 'stale' or cbbc_map.sld_pdftotext_available is sameas false) %}
            <div style="font-size:10.5px;color:var(--muted);margin-top:4px">
              <span class="l-en">Forced-buy/sell price levels come from exchange listing documents (~21 filings per weekday); newest document on file: {{ cbbc_map.sld_max_issue_date or '—' }}.{% if cbbc_map.sld_pdftotext_available is sameas false %} The document reader on our data host failed its last run — being fixed.{% endif %}</span>
              <span class="l-zh">强制买卖价位来自交易所上市文件（每个交易日约21份）；库中最新文件日期：{{ cbbc_map.sld_max_issue_date or '—' }}。{% if cbbc_map.sld_pdftotext_available is sameas false %}数据主机的文件读取工具上次运行失败，正在修复。{% endif %}</span>
            </div>
            {% endif %}
          </div>
        </div>
        <div class="hkx-receipt">{{ t('Both are HK-specific tools: the overnight read looks forward to the open; the leverage map shows where a move could speed up.','两者均为港股特有工具：隔夜读数预判开盘；杠杆图显示行情可能加速的位置。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-news: News & Filings #}
  <div class="hkx-dlg" id="hkx-dlg-news">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('News & Company Filings','新闻与公司公告') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('Two things here: <b>official company filings</b> (buybacks, share sales, results) from the Hong Kong exchange, and <b>which names are getting news attention</b> right now.','两项内容：来自港交所的<b>公司公告</b>（回购、配股、业绩），以及<b>哪些个股正在获得新闻关注</b>。') | safe }}</div>
        {% if filing_bus and filing_bus.tape %}
        <div class="hkx-eyebrow">{{ t('Company filings','公司公告') }}</div>
        {% set _s = filing_bus.summary %}
        {% if _s %}
        <div class="hkx-fsum">
          <span class="l-en">This week:</span><span class="l-zh">本周：</span>
          <span><b class="u">{{ _s.buyback }}</b> {{ t('buybacks','回购') }}</span>
          <span><b class="d">{{ _s.placement }}</b> {{ t('placements','配股') }}</span>
          <span><b class="i">{{ _s.results }}</b> {{ t('results','业绩') }}</span>
          {% if _s.other %}<span><b>{{ _s.other }}</b> {{ t('other','其他') }}</span>{% endif %}
        </div>
        {% endif %}
        {% for f in filing_bus.tape[:10] %}
        <div class="hkx-frw">
          <span class="dt">{{ f.date }}</span>
          <span class="hkx-tp {{ f.bucket }}">{{ t(f.pill_en, f.pill_zh) }}</span>
          <span class="co">{{ t(f.name_en, f.name_zh) if f.name_en else f.ticker }}</span>
          <span class="rd">{{ t(f.read_en, f.read_zh) }}</span>
        </div>
        {% endfor %}
        {% else %}
        <p style="font-size:12px;color:var(--muted)">{{ t('No major filings today.','今日暂无重要公告。') }}</p>
        {% endif %}
        {# News-attention entities — plain-word state per name with real data; an honest
           null line when coverage is still warming up (Design Doctrine Law 5). #}
        {% if hk_narrative and hk_narrative.entities %}
        <div class="hkx-sep"></div>
        <div class="hkx-eyebrow">{{ t('Names getting news attention','获得新闻关注的个股') }}</div>
        {% if hk_narrative.warming_up %}
        <div class="hkx-warm">{{ t('News coverage tracking is still warming up','新闻关注度追踪仍在积累中') }} — {{ hk_narrative.n_watched }} {{ t('names watched, too little history to read yet.','只个股跟踪中，历史数据尚不足以解读。') }}</div>
        {% else %}
        <div class="hkx-chips">
          {% for ent in hk_narrative.live_entities %}
          <span class="hkx-nchip"><b><span class="l-en">{{ ent.name_en }}</span><span class="l-zh">{{ ent.name_zh or ent.name_en }}</span></b><span class="st">{{ t(ent.state_en, ent.state_zh) }}</span></span>
          {% endfor %}
        </div>
        {% endif %}
        <div class="hkx-fresh">{{ t('Weakest evidence tier — news volume, not a buy signal.','最弱证据层 — 新闻热度，非买入信号。') }}{% if hk_narrative.is_stale %} · {{ t('slow-moving','缓慢更新') }}{% endif %} · {{ t('as of','截至') }} {{ hk_narrative.as_of }}</div>
        {% endif %}
        <div class="hkx-receipt">{{ t('Official filings from the Hong Kong exchange. Buyback = company buying its own shares (supports price). Placement = new shares sold (dilution). News attention comes from English-language news volume; it is context, not a signal.','来自港交所的正式公告。回购 = 公司买回自家股份（支撑股价）。配股 = 新发股份（稀释）。新闻关注度来自英文媒体报道量，仅为背景，非信号。') }}</div>
      </div>
    </div>
  </div>

  {# dlg-risk: Pullback Risk #}
  <div class="hkx-dlg" id="hkx-dlg-risk">
    <div class="hkx-dlg-backdrop" onclick="hkxCloseDlg()"></div>
    <div class="hkx-dlg-panel">
      <div class="hkx-dlg-head"><span class="hkx-dlg-title">{{ t('Chance of a Pullback — what\'s inside','回撤概率 — 详细内容') }}</span><button class="hkx-dlg-close" onclick="hkxCloseDlg()">×</button></div>
      <div class="hkx-dlg-body">
        <div class="hkx-plain">{{ t('How likely a sharp drop is over the next few weeks, and why. It reads what has already turned — it doesn\'t predict.','未来几周出现急跌的可能性及原因。读取已经转向的内容 — 不是预测。') }}</div>
        {% if ms is defined and ms and ms.radar is defined and ms.radar %}
        {% set _rad = ms.radar %}
