          <td class="r">{{ ih.rsi|round|int if ih.rsi is not none else '—' }}</td></tr>
          {% endfor %}
        </table>
        {% endif %}
        <div class="hkx-receipt">{{ t('Display-only. A synthesis of signals shown elsewhere; it never scores, sizes or feeds the regime engine.','仅供展示。是本页其他信号的综合；绝不评分、定仓或进入周期引擎。') }}</div>
      </div>
    </div>
