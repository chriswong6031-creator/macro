{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if mode == 'stocks' %}{{ t('Hong Kong Stock & Exposure Board', '香港个股与敞口看板') }}{% else %}{{ t('Hong Kong Regime', '香港周期') }}{% endif %} — {{ latest.date }}</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font: 14px/1.5 -apple-system,
         "Segoe UI", Roboto, Helvetica, sans-serif; margin: 0; padding: 18px; }
  @media (min-width: 1100px) { body { padding: 26px max(40px, calc((100vw - 1500px) / 2)); } }
  html[data-lang="zh"] body { font-family: "PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",-apple-system,sans-serif; }
  a { text-decoration: none; color: var(--link); }
  h1 { font-size: 21px; margin: 0 0 2px; color: var(--text); }
  h2 { font-size: 13px; margin: 0 0 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(12, 1fr); }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 15px 17px; }
  .span12 { grid-column: span 12; } .span8 { grid-column: span 8; }
  .span6 { grid-column: span 6; } .span4 { grid-column: span 4; }
  @media (max-width: 900px) { .span8, .span6, .span4 { grid-column: span 12; } }

  /* regime hero */
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .quad-badge { font-size: 22px; font-weight: 800; padding: 8px 18px; border-radius: 13px; color: #fff; }
  .quad-Q1 { background: var(--q1); } .quad-Q2 { background: var(--q2); color: #1a1a1a; }
  .quad-Q3 { background: var(--q3); } .quad-Q4 { background: var(--q4); }
  .metric { display: flex; flex-direction: column; gap: 1px; }
  .metric .v { font-size: 18px; font-weight: 700; color: var(--text); }
  .metric .k { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .chip { display: inline-block; padding: 3px 11px; border-radius: 12px; font-weight: 600; font-size: 12.5px;
          background: color-mix(in srgb, var(--c, var(--muted)) 16%, var(--panel));
          color: color-mix(in srgb, var(--c, var(--muted)) 82%, var(--text)); }
  .c-up { --c: var(--up); } .c-down { --c: var(--down); } .c-warn { --c: var(--warn); }
  .c-info { --c: var(--info); } .c-muted { --c: var(--muted); }

  /* global-risk-beta regime tilt (amplifiers vs cushions) */
  .gb-tilt { display:inline-block; font-size:11px; font-weight:700; padding:2px 8px;
             border-radius:9px; border:1px solid var(--line); white-space:nowrap; }
  .gb-favored { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
                border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .gb-exposed { background:color-mix(in srgb,var(--down) 16%,transparent); color:var(--down);
                border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .gb-lag,.gb-neutral { background:var(--panel2,var(--panel)); color:var(--muted); }
  /* consolidated stock-screener: segmented mode toggle (parallels china.html) */
  .sb-seg { display:inline-flex; flex-wrap:wrap; gap:4px; padding:4px; border-radius:11px;
            background:var(--panel2,color-mix(in srgb,var(--muted) 10%,var(--panel)));
            border:1px solid var(--line); margin:2px 0 14px; }
  .sb-seg button { font:inherit; font-size:12.5px; font-weight:600; cursor:pointer;
            border:1px solid transparent; background:transparent; color:var(--muted);
            padding:6px 13px; border-radius:8px; line-height:1.2; transition:all .14s ease;
            white-space:nowrap; }
  .sb-seg button:hover { color:var(--text); }
  .sb-seg button[aria-selected="true"] { background:var(--panel); color:var(--text);
            border-color:var(--line); box-shadow:var(--popover-shadow,0 1px 3px rgba(0,0,0,.12)); }
  .sb-cap { margin:0 0 12px; text-transform:none; line-height:1.55; }
  .sb-table th.th-sort { cursor:pointer; user-select:none; }
  .sb-table th.th-sort:hover { color:var(--text); }
  .sb-table th.sorted { color:var(--text); }
  .sb-table .sarrow { font-size:9px; opacity:.32; margin-left:3px; font-weight:700; }
  .sb-table th.sorted .sarrow { opacity:.9; color:var(--link); }

  /* global risk overlay (HK-specific) */
  .risk-badge { font-size: 20px; font-weight: 800; padding: 7px 16px; border-radius: 12px;
                background: color-mix(in srgb, var(--c, var(--muted)) 20%, var(--panel));
                color: color-mix(in srgb, var(--c, var(--muted)) 88%, var(--text)); }
  .peg-wrap { margin: 14px 0 4px; }
  .peg-gauge { position: relative; height: 8px; border-radius: 5px; margin: 7px 0 4px;
               background: linear-gradient(90deg, var(--up) 0%, color-mix(in srgb, var(--muted) 60%, var(--panel)) 50%, var(--down) 100%); }
  .peg-marker { position: absolute; top: -4px; width: 4px; height: 16px; border-radius: 3px;
                background: var(--text); transform: translateX(-50%); box-shadow: 0 0 0 2px var(--panel); }
  .peg-ends { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--muted); }
  .factor-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 7px 14px; margin-top: 12px; }
  .factor { display: flex; align-items: center; gap: 7px; font-size: 12.5px; }
  .factor .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto;
                 background: color-mix(in srgb, var(--c, var(--muted)) 85%, transparent); }
  .factor .fz { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--muted); font-weight: 600; }

  /* regime hero: growth/inflation gauges + quad map + meaning (US/China parity) */
  .herogauges { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 22px; max-width: 600px; margin: 18px 0 2px; }
  .hg-l { display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; margin-bottom: 6px; }
  .hg-l .hv { font-variant-numeric: tabular-nums; }
  .qmeaning { font-size: 13.5px; line-height: 1.55; margin: 16px 0 2px; color: var(--text); }
  .regwatch { font-size: 13px; font-weight: 600; margin: 8px 0 0; padding: 7px 11px; border-radius: 9px;
              background: color-mix(in srgb, var(--warn) 14%, var(--panel)); color: color-mix(in srgb, var(--warn) 88%, var(--text)); }
  .qmap { display: grid; grid-template-columns: 92px 1fr 1fr; gap: 8px; margin: 18px 0 4px; }
  .qmap .ax { font-size: 11px; color: var(--muted); display: flex; align-items: center; justify-content: center; text-align: center; line-height: 1.3; }
  .qmap .cell { border-radius: 12px; padding: 14px 18px; color: #fff; font-weight: 700; font-size: 16px; opacity: .4;
                display: flex; flex-direction: column; justify-content: center; min-height: 132px; transition: opacity .15s; }
  .qmap .cell small { display: block; font-weight: 500; font-size: 11.5px; opacity: .92; margin-top: 6px; line-height: 1.4; }
  .qmap .cell.cur { opacity: 1; box-shadow: inset 0 0 0 2px var(--text); }
  @media (max-width: 900px) { .qmap .cell { min-height: 92px; font-size: 14px; } }
  .qmap .q1 { background: var(--q1); } .qmap .q2 { background: var(--q2); color: #1a1a1a; }
  .qmap .q3 { background: var(--q3); } .qmap .q4 { background: var(--q4); }

  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: right; padding: 5px 8px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 500; }
  th:first-child, td:first-child, td.l, th.l { text-align: left; }
  .pos { color: var(--up); } .neg { color: var(--down); }
  .lad { display: inline-block; padding: 1px 9px; border-radius: 10px; font-size: 11.5px; font-weight: 700;
         background: color-mix(in srgb, var(--c, var(--muted)) 16%, var(--panel));
         color: color-mix(in srgb, var(--c, var(--muted)) 82%, var(--text)); }
  .lad.up { --c: var(--up); } .lad.down { --c: var(--down); } .lad.flat { --c: var(--muted); }
  .agechip { font-size: 10.5px; font-weight: 700; color: var(--muted); white-space: nowrap; margin-left: 5px; }
  .note { font-size: 12.5px; color: var(--muted); line-height: 1.6; }
  .sub { font-size: 11.5px; color: var(--muted); }
  .mtf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .mtf-card .mtf-name { font-weight: 700; font-size: 13.5px; margin-bottom: 6px; color: var(--text); }
  h3 { font-size: 12.5px; margin: 12px 0 6px; color: var(--text); }

  /* ---- playbook: lifespan bar + next-quad odds + exposure dial -------------- */
  .lifebar { position: relative; height: 16px; border-radius: 8px; overflow: hidden; margin: 12px 0 3px; background: var(--panel2); }
  .lifebar .zone { position: absolute; top: 0; height: 100%; }
  .lifebar .marker { position: absolute; top: -2px; height: calc(100% + 4px); width: 3px; background: var(--text); border-radius: 2px; box-shadow: 0 0 0 1px var(--panel); }
  .lifelabels { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--muted); }
  .prob { display: flex; align-items: center; gap: 9px; margin: 7px 0; }
  .prob .nm { flex: 0 0 96px; font-size: 12.5px; font-weight: 600; }
  .prob .bar { flex: 1; height: 14px; background: var(--panel2); border-radius: 7px; overflow: hidden; }
  .prob .bar i { display: block; height: 100%; border-radius: 7px; }
  .prob .pc { flex: 0 0 38px; text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .pdial { display: flex; gap: 4px; margin: 6px 0 12px; }
  .pdial > span { flex: 1; text-align: center; font-size: 11.5px; font-weight: 700; padding: 7px 4px; border-radius: 8px;
                background: var(--panel2); color: var(--muted); border: 1px solid var(--line); }
  .pdial .on-def { background: color-mix(in srgb, var(--down) 80%, var(--panel)); color: #fff; border-color: transparent; }
  .pdial .on-car { background: color-mix(in srgb, var(--warn) 75%, var(--panel)); color: #1a1a1a; border-color: transparent; }
  .pdial .on-neu { background: color-mix(in srgb, var(--muted) 55%, var(--panel)); color: var(--text); border-color: transparent; }
  .pdial .on-con { background: color-mix(in srgb, var(--up) 62%, var(--panel)); color: #fff; border-color: transparent; }
  .pdial .on-agg { background: color-mix(in srgb, var(--up) 88%, var(--panel)); color: #fff; border-color: transparent; }
  .reason { display: flex; align-items: flex-start; gap: 8px; font-size: 12.5px; margin: 5px 0; line-height: 1.45; }
  .sig { flex: none; width: 17px; height: 17px; border-radius: 50%; font-size: 11px; font-weight: 800; line-height: 17px; text-align: center; }
  .sig-p { background: color-mix(in srgb, var(--up) 22%, var(--panel)); color: var(--up); }
  .sig-m { background: color-mix(in srgb, var(--down) 22%, var(--panel)); color: var(--down); }
  .sig-i { background: color-mix(in srgb, var(--muted) 22%, var(--panel)); color: var(--muted); }
  .pcard { background: var(--panel2); border: 1px solid var(--line); border-radius: 9px; padding: 7px 10px; margin: 6px 0; font-size: 12.5px; }
  .calltag { display: inline-block; font-size: 10px; font-weight: 700; padding: 1px 7px; border-radius: 8px; margin-right: 6px; text-transform: uppercase; letter-spacing: .03em; }
  .tag-pref { background: color-mix(in srgb, var(--info) 18%, var(--panel)); color: color-mix(in srgb, var(--info) 85%, var(--text)); }
  .tag-lead { background: color-mix(in srgb, var(--up) 18%, var(--panel)); color: color-mix(in srgb, var(--up) 85%, var(--text)); }
  .tag-avoid { background: color-mix(in srgb, var(--down) 18%, var(--panel)); color: color-mix(in srgb, var(--down) 85%, var(--text)); }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%;
          border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:4px; }
  .help .tip { display:none; position:absolute; bottom:140%; left:50%; transform:translateX(-50%); width:280px; background:var(--panel);
               border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text);
               font-weight:400; text-transform:none; letter-spacing:normal; box-shadow:var(--popover-shadow); }
  .help:hover .tip { display:block; }
  .stat-row { display:flex; flex-wrap:wrap; gap:18px; align-items:baseline; margin:2px 0 10px; }
  .stat-row .v { font-size:22px; font-weight:800; color:var(--text); }
  table.sortable th.th-sort { cursor: pointer; user-select: none; }
  table.sortable th.sorted { color: var(--text); }
  table.sortable th .sarrow { font-size: 9px; opacity: .32; margin-left: 3px; font-weight: 700; }
  table.sortable th.sorted .sarrow { opacity: .9; color: var(--link); }

  /* ---- regime time machine (timemachine.js) -------------------------------- */
  #time-machine .tm-wrap { position: relative; margin: 4px 0 2px; }
  .tm-canvas { display: block; width: 100%; height: 56px; cursor: ew-resize; border-radius: 8px; touch-action: none; }
  .tm-range { -webkit-appearance: none; appearance: none; width: 100%; height: 16px; background: transparent; margin: 2px 0 0; cursor: ew-resize; }
  .tm-range::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--line); }
  .tm-range::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 16px; height: 16px; margin-top: -6px; border-radius: 50%; background: var(--text); border: 2px solid var(--panel); box-shadow: 0 1px 4px rgba(0,0,0,.35); }
  .tm-range::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--text); border: 2px solid var(--panel); }
  .tm-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin: 8px 0 12px; }
  .tm-presets { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .tm-btn { font: inherit; font-size: 12px; font-weight: 600; color: var(--text); background: var(--panel2); border: 1px solid var(--line); border-radius: 7px; padding: 5px 11px; cursor: pointer; }
  .tm-btn:hover { border-color: var(--link); }
  .tm-play { display: inline-flex; align-items: center; gap: 7px; }
  .tm-play-ico { width: 0; height: 0; border-style: solid; border-width: 6px 0 6px 10px; border-color: transparent transparent transparent var(--text); }
  .tm-play.is-playing .tm-play-ico { width: 9px; height: 11px; border: none; border-left: 3px solid var(--text); border-right: 3px solid var(--text); }
  .tm-readout { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .tm-asof { display: flex; align-items: baseline; gap: 10px; margin-bottom: 9px; }
  .tm-date { font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .tm-state-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: 10px; }
  .tm-state-tag.is-live { color: color-mix(in srgb, var(--up) 85%, var(--text)); background: color-mix(in srgb, var(--up) 16%, var(--panel)); }
  .tm-state-tag.is-hist { color: var(--muted); background: color-mix(in srgb, var(--muted) 16%, var(--panel)); }
  .tm-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .tm-gauges { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; margin: 12px 0 4px; }
  @media (max-width: 640px) { .tm-gauges { grid-template-columns: 1fr; } }
  .tm-glabel { display: flex; justify-content: space-between; font-size: 12.5px; font-weight: 600; margin-bottom: 4px; font-variant-numeric: tabular-nums; }
  .tm-flags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .badge { display: inline-block; padding: 3px 11px; border-radius: 11px; font-weight: 700; font-size: 12.5px; }
  .badge.quad-Q1 { background: var(--q1); color: #fff; } .badge.quad-Q2 { background: var(--q2); color: #1a1a1a; }
  .badge.quad-Q3 { background: var(--q3); color: #fff; } .badge.quad-Q4 { background: var(--q4); color: #fff; }
  .badge.state-STABLE { background: color-mix(in srgb, var(--muted) 16%, var(--panel)); color: color-mix(in srgb, var(--muted) 82%, var(--text)); }
  .kv { font-size: 12.5px; color: var(--muted); } .kv b { color: var(--text); font-variant-numeric: tabular-nums; }
  .gauge { position: relative; height: 6px; border-radius: 3px; background: linear-gradient(90deg, var(--down), var(--line) 50%, var(--up)); }
  .gauge i { position: absolute; top: 50%; width: 12px; height: 12px; border-radius: 50%; background: var(--text); border: 2px solid var(--panel); transform: translate(-50%,-50%); }
  .foot { margin-top: 26px; color: var(--muted); font-size: 12px; text-align: center; line-height: 1.7; }
  /* major-index health strip (macro page) */
  .idx-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  @media (max-width: 760px) { .idx-grid { grid-template-columns: 1fr; } }
  .idx-tile { background: var(--panel2); border: 1px solid var(--line); border-radius: 9px; padding: 10px 12px; }
  .idx-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .idx-px { font-variant-numeric: tabular-nums; color: var(--muted); }
  .idx-row, .idx-trend { display: flex; justify-content: space-between; font-size: 12px; gap: 8px; }
  .idx-trend { margin-top: 3px; color: var(--muted); }
  .idx-grid .pos { color: var(--up); } .idx-grid .neg { color: var(--down); } .idx-grid .warn { color: var(--warn); }
  /* nav split-dropdown (macro / stocks / lookup) */
  .nav-dd { position: relative; }
  .nav-dd .caret { font-size: 9px; opacity: .6; }
  .nav-dd-menu { position: absolute; top: calc(100% + 6px); left: 0; min-width: 210px; background: var(--panel);
    border: 1px solid var(--line); border-radius: 11px; box-shadow: 0 12px 34px rgba(0,0,0,.28); padding: 6px;
    opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .16s, transform .16s, visibility .16s; z-index: 70; }
  .nav-dd:hover > .nav-dd-menu, .nav-dd:focus-within > .nav-dd-menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .nav-dd-menu a { display: block; padding: 7px 10px; border-radius: 8px; font-size: 13px; color: var(--muted); text-decoration: none; white-space: nowrap; }
  .nav-dd-menu a:hover, .nav-dd-menu a.active { background: var(--panel2); color: var(--text); }
  /* ---- standout-stock cards (mirror of the US dashboard) -------------------- */
  .nch { display: block; width: 100%; margin: 7px 0 5px; border-radius: 5px; background: var(--panel2); }
  .nbgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(196px, 1fr)); gap: 10px; margin-top: 11px; }
  a.nbcard { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px;
            padding: 9px 11px 10px; border-left: 3px solid var(--muted);
            display: flex; flex-direction: column; gap: 4px; color: var(--text);
            transition: transform .12s, box-shadow .12s, border-color .12s; }
  a.nbcard:hover { transform: translateY(-2px); box-shadow: 0 5px 18px rgba(0,0,0,.22); border-color: var(--link); }
  .nbcard.nb-up { border-left-color: var(--up); }
  .nbcard.nb-down { border-left-color: var(--down); }
  .nbcard.nb-caution { border-left-color: var(--warn); }
  .nb-top { display: flex; align-items: baseline; gap: 6px; }
  .nb-tk { font-weight: 800; font-size: 14px; color: var(--text); letter-spacing: .01em; }
  .nb-nm { font-size: 10px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
  .nb-px { font-weight: 700; font-size: 13px; color: var(--text); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .nb-sub { display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); }
  .nbcard .nch { background: transparent; margin: 4px 0 2px; }
  .nb-bot { display: flex; align-items: center; gap: 6px; margin-top: 1px; }
  .nb-state { font-size: 10px; font-weight: 800; letter-spacing: .02em; padding: 1px 7px; border-radius: 8px; }
  .nb-up .nb-state { color: var(--up); background: color-mix(in srgb, var(--up) 15%, var(--panel)); }
  .nb-down .nb-state { color: var(--down); background: color-mix(in srgb, var(--down) 15%, var(--panel)); }
  .nb-caution .nb-state { color: var(--warn); background: color-mix(in srgb, var(--warn) 15%, var(--panel)); }
  .nb-alpha { display: flex; align-items: center; gap: 6px; font-size: 9.5px; margin-top: 2px; flex-wrap: wrap; }
  .nb-az { font-weight: 800; font-variant-numeric: tabular-nums; padding: 0 5px; border-radius: 7px;
           background: var(--panel); border: 1px solid var(--line); color: var(--muted); }
  .nb-az.az-up { color: var(--up); border-color: color-mix(in srgb, var(--up) 38%, var(--line)); }
  .nb-az.az-dn { color: var(--down); border-color: color-mix(in srgb, var(--down) 38%, var(--line)); }
  .nb-rk { color: var(--muted); font-variant-numeric: tabular-nums; }
  .nb-ent { font-weight: 700; padding: 0 5px; border-radius: 7px; }
  .ent-good { color: var(--up); background: color-mix(in srgb, var(--up) 14%, var(--panel)); }
  .ent-warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 16%, var(--panel)); }
  /* ---- unified Conviction Profile on each standout card (SCREEN framing) ----- */
  .nb-conv { display: flex; align-items: center; gap: 7px; margin: 5px 0 1px; }
  .nb-cscore { font-size: 13px; font-weight: 800; font-variant-numeric: tabular-nums;
               min-width: 30px; text-align: center; padding: 1px 5px; border-radius: 8px;
               border: 1px solid var(--line); color: var(--text); }
  .nb-cscore.band-high { color: var(--up); border-color: color-mix(in srgb, var(--up) 45%, var(--line));
                         background: color-mix(in srgb, var(--up) 12%, var(--panel)); }
  .nb-cscore.band-constructive { color: var(--g-cold); border-color: color-mix(in srgb, var(--g-cold) 40%, var(--line)); }
  .nb-cscore.band-neutral { color: var(--muted); }
  .nb-cscore.band-low { color: var(--down); border-color: color-mix(in srgb, var(--down) 35%, var(--line)); }
  .nb-verdict { font-size: 10.5px; font-weight: 700; line-height: 1.25; color: var(--text); }
  .nb-axes { display: flex; gap: 4px; margin-top: 3px; }
  .nb-ax { flex: 1; }
  .nb-ax .axl { font-size: 8px; color: var(--muted); letter-spacing: .03em; }
  .nb-ax .axt { height: 3px; border-radius: 2px; background: var(--line); margin-top: 1px; overflow: hidden; }
  .nb-ax .axf { height: 100%; background: var(--g-cold); border-radius: 2px; }
  .nb-ax.ax-na .axf { background: transparent; }
  .nb-cau { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 3px; }
  .nb-cau span { font-size: 8.5px; font-weight: 700; padding: 0 4px; border-radius: 6px;
                 color: var(--warn); background: color-mix(in srgb, var(--warn) 13%, var(--panel)); }
  .nb-tier { font-size: 8px; color: var(--muted); margin-top: 3px; letter-spacing: .02em; }

  /* ---- US/China-parity panels ported to HK (dial / bignum / alerts / risk gauges) ---- */
  .dial { position: relative; height: 9px; border-radius: 5px; margin: 6px 0 3px;
          background: linear-gradient(90deg, var(--up), var(--warn) 55%, var(--down)); }
  .dial.rev { background: linear-gradient(90deg, var(--down), var(--warn) 45%, var(--up)); }
  .dial i { position: absolute; top: -3px; width: 4px; height: 15px; border-radius: 2px; background: var(--text); transform: translateX(-50%); box-shadow: 0 0 0 2px var(--panel); }
  .dial-ends { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--muted); }
  .bignum { font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1; }
  /* fired alerts (ported from the US/China dashboard) */
  .alert { display: block; padding: 10px 13px; border-radius: 8px; margin: 8px 0;
           background: var(--panel2, var(--panel)); border-left: 3px solid var(--muted);
           color: var(--text); transition: transform .12s, box-shadow .12s; }
  a.alert:hover { transform: translateX(2px); box-shadow: 0 3px 14px rgba(0,0,0,.22); }
  .alert-high { border-left-color: var(--down); }
  .alert-warn { border-left-color: var(--warn); }
  .alert-info { border-left-color: var(--info); }
  .alert-head { display: flex; align-items: baseline; gap: 8px; }
  .alert-ico { font-size: 15px; flex: none; line-height: 1; }
  .alert-head b { font-size: 13.5px; color: var(--text); }
  .alert-jump { margin-left: auto; font-size: 11px; font-weight: 700;
                color: var(--link); flex: none; white-space: nowrap; }
  .alert-detail { margin: 6px 0 0; font-size: 12.5px; color: var(--text); font-variant-numeric: tabular-nums; }
  .alert-what { margin: 6px 0 0; padding-top: 6px; border-top: 1px solid var(--line);
                font-size: 12px; color: var(--muted); line-height: 1.5; }
  .alert-edge { margin: 5px 0 0; font-size: 12px; color: var(--text); line-height: 1.45; }
  .alert-edge b { color: var(--muted); font-weight: 600; }
  /* AI master brief */
  .ai-brief .mb-sum { font-size: 15px; font-weight: 600; margin: 0 0 10px; }
  .ai-brief .mb-sec { margin: 10px 0; } .ai-brief .mb-h { font-weight: 600; color: var(--link); margin: 0 0 4px; }
  .ai-brief .mb-list { margin: 4px 0 0 18px; padding: 0; } .ai-brief .mb-list li { margin: 3px 0; }
  .ai-brief .mb-foot { margin-top: 12px; color: var(--muted); font-size: 12px; }
</style>
</head>
<body>

<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search" data-lib="hkstockdata/index.json" data-target="hk_lookup.html">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search HK stocks"
      placeholder="Search any HK stock…" data-ph-zh="搜索任意港股…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="aibrief.html">🧠 {{ t('AI Daily Brief', 'AI每日简报') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="grid">

  {% if mode == 'stocks' %}
  <!-- ===================== HK STOCK & EXPOSURE BOARD HEADER ===================== -->
  <div class="panel span12" id="stocks-header">
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <h1 style="margin:0">🇭🇰 {{ t('HK Stock & Exposure Board', '港股与敞口看板') }}</h1>
      <span class="quad-badge quad-{{ latest.quad }}">{{ td(latest.quad_name) }}</span>
      {% if gv and gv.state %}<span class="risk-badge {{ 'c-up' if gv.state=='Risk-on' else ('c-down' if gv.state=='Risk-off' else 'c-muted') }}">{{ td(gv.state) }}</span>{% endif %}
    </div>
    <p class="note" style="margin:8px 0 0;text-transform:none"><b>{{ t('Exposure & risk context', '敞口与风险背景') }}</b> — {{ t('HK has no validated stock-picking edge; this is beta / sector positioning, not alpha. Each name is read by its beta to global risk and its sector, conditioned on the live risk state.', '香港没有经验证的选股优势；这是贝塔／板块定位，而非阿尔法。每只股票按其对全球风险的贝塔与所属板块解读，并结合实时风险状态。') }}
      <a href="hk.html" style="color:var(--link);font-weight:600">← {{ t('HK macro dashboard', '香港宏观看板') }}</a></p>
  </div>
  {% endif %}

  <!-- ===================== STANDOUT STOCKS (relative-strength cards) ===================== -->
  {% if mode == 'stocks' and setups and setups.buy %}
  <div class="panel span12" id="standouts">
    <h2>{{ t('⚡ Standout individual stocks', '⚡ 表现突出的个股') }}
      <span class="note" style="text-transform:none">· {{ t('strongest relative strength · exposure context, not a validated edge', '相对强度最强 · 敞口背景，非已验证优势') }}</span>
      {{ help("The HK names with the strongest cross-sectional RELATIVE STRENGTH — each stock's ~3-month return z-scored against the HK universe. IMPORTANT: Hong Kong has <b>no validated stock-picking edge</b> (residual momentum is dead on a 40-year panel; research/CHINA_HK_STOCK_SIGNALS.md). So unlike the US / China boards this is NOT a selection-alpha shortlist — it is a relative-strength / exposure READ shown for parity, ranked by recent leadership with each name's price-cycle state for context. The <b>extended</b> tag (RSI≥70) flags a stretched name (reversal risk); <b>pullback</b> a leader that has cooled off. The validated HK read is the global-risk exposure board below. Context to size and confirm — never a buy list.", "相对强度最强的港股 —— 每只股票近3个月收益相对港股全体做 z 标准化。重要：香港<b>没有经验证的选股优势</b>（在40年面板上残差动量无效；research/CHINA_HK_STOCK_SIGNALS.md）。因此与美国／中国看板不同，这不是选股阿尔法名单 —— 而是为保持一致性展示的相对强度／敞口读数，按近期领先排序并标注各股价格周期状态作为背景。<b>extended</b>（RSI≥70）表示过热（反转风险）；<b>pullback</b> 表示已回落的强势股。香港已验证的读数是下方的全球风险敞口看板。用于定仓与确认的背景 —— 绝非买入清单。") }}
    </h2>
    <p class="note" style="margin:0 0 2px;text-transform:none">{{ t('Ranked by ~3-month relative strength vs the HK universe; each card carries the unified Conviction profile (four axes + a single honest verdict). HK has no validated selection edge, so the trust tier reads "screen" and the verdict never says "Buy" — the cycle state caps it. Relative-strength / exposure context, not a buy list.', '按近3个月相对港股全体的相对强度排序；每张卡片附带统一确信度画像（四条维度＋一个诚实结论）。香港没有经验证的选股优势，故信任等级为“筛选”，结论永不显示“买入” —— 周期状态会封顶。相对强度／敞口背景，而非买入清单。') }}</p>
    <div class="nbgrid" data-showmore="12">
    {% for n in setups.buy %}
      {% set _d = n.dir or 'caution' %}
      {% set c = n.conviction %}
      <a class="nbcard nb-{{ _d }}" href="hk_lookup.html#{{ n.ticker }}">
        <div class="nb-top">
          <span class="nb-tk">{{ n.ticker }}</span>
          <span class="nb-nm">{{ n.name }}</span>
          {% if n.price is not none %}<span class="nb-px">{{ '%.2f'|format(n.price) }}</span>{% endif %}
        </div>
        <div class="nb-sub">{% if n.sector %}<span>{{ t(n.sector, n.sector_zh or n.sector) }}</span>{% endif %}{% if n.off_high is not none %}<span>{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}</div>
        {% if n.spark_svg %}{{ n.spark_svg | safe }}{% endif %}
        {% if c %}
        <div class="nb-conv">
          {% if c.score is not none %}<span class="nb-cscore band-{{ c.band }}" title="Unified Conviction score — within-market percentile (display skin, not a probability). HK has no validated selection edge — this is a screen. · 统一确信度分 — 市场内百分位（展示，非概率）。香港无经验证的选股优势 — 这是筛选。">{{ c.score }}</span>{% endif %}
          <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
        </div>
        <div class="nb-axes">
          {% for ax, lbl, lbl_zh in [('selection','RS','相对'),('entry','ENT','入场'),('tailwind','TWD','顺风'),('quality','QUAL','质量')] %}
          {% set a = c.axes[ax] %}
          <div class="nb-ax{{ ' ax-na' if a.pct is none else '' }}" title="{{ lbl }}{% if a.pct is not none %} {{ a.pct }}/100{% else %} — no data{% endif %}">
            <div class="axl">{{ t(lbl, lbl_zh) }}</div>
            <div class="axt"><div class="axf" style="width:{{ a.pct if a.pct is not none else 0 }}%"></div></div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        <div class="nb-bot">
          {% if n.label %}<span class="nb-state">{{ td(n.label) }}</span>{% endif %}
        </div>
        {% if n.alpha is not none or n.alpha_entry %}
        <div class="nb-alpha">
          {% if n.alpha is not none %}<span class="nb-az {{ 'az-up' if n.alpha>0 else ('az-dn' if n.alpha<0 else '') }}" title="Cross-sectional relative strength (z) — ~3-month return vs the HK universe. A descriptive leadership read, not a validated alpha. · 横截面相对强度（z）— 近3个月相对港股全体的收益。描述性领先读数，非已验证阿尔法。">RS {{ '%+.2f'|format(n.alpha) }}</span>{% endif %}
          {% if n.sector_rank %}<span class="nb-rk" title="Rank within its sector by relative strength · 按相对强度在其板块内排名">#{{ n.sector_rank }}/{{ n.sector_n }}</span>{% endif %}
          {% if n.alpha_entry == 'pullback' %}<span class="nb-ent ent-good" title="A leader that has cooled off (RSI≤55) — a less-stretched entry · 已回落的强势股（RSI≤55）— 较不过热的入场">{{ t('pullback', '回调') }}</span>
          {% elif n.alpha_entry == 'extended' %}<span class="nb-ent ent-warn" title="Stretched (RSI≥70) — short-term reversal risk · 过热（RSI≥70）— 短线反转风险">{{ t('extended', '过热') }}</span>{% endif %}
        </div>
        {% endif %}
        {% if c %}
        {% if c.cautions %}<div class="nb-cau">{% for cau in c.cautions %}<span class="l-en">⚠ {{ cau }}</span><span class="l-zh">⚠ {{ c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau }}</span>{% endfor %}</div>{% endif %}
        <div class="nb-tier"><span class="l-en">{{ c.trust_tier.en }}</span><span class="l-zh">{{ c.trust_tier.zh }}</span></div>
        {% endif %}
      </a>
    {% endfor %}
    </div>
    {% if setups.laggards %}
    <p class="note" style="margin:13px 0 5px;text-transform:none;color:var(--down);font-weight:700">⚠ {{ t('Weakest relative strength (laggards) — distribution risk:', '相对强度最弱（落后股）— 派发风险：') }}</p>
    <p style="margin:0;line-height:2">
      {% for r in setups.laggards %}<a href="hk_lookup.html#{{ r.ticker }}" style="margin-right:14px;white-space:normal;overflow-wrap:anywhere"><b>{{ r.ticker }}</b> <span class="note">{{ r.name }}</span> <span class="neg">{{ '%+.2f'|format(r.alpha) }}</span></a>{% endfor %}
    </p>
    {% endif %}
    <p class="note" style="margin:8px 0 0;font-size:11px">{{ t('Relative strength is descriptive, not predictive: HK has no validated stock-picking edge (residual momentum is dead on a 40-year panel). For the validated read, use the global-risk exposure board below. A research surface to size and confirm — not a buy list.', '相对强度是描述性的，而非预测性的：香港没有经验证的选股优势（40年面板上残差动量无效）。已验证的读数请使用下方的全球风险敞口看板。用于研究、定仓与确认的面板 —— 而非买入清单。') }}</p>
  </div>
  {% endif %}

  {% if mode != 'stocks' %}
  <!-- regime hero -->
  <div class="panel span8" id="regime-hero">
    <h1>{{ t('Hong Kong Regime', '香港周期') }}</h1>
    <h2 style="margin-top:1px">{{ t('Market Regime', '市场周期') }} · {{ latest.date }}</h2>
    <div class="hero">
      <span class="quad-badge quad-{{ latest.quad }}">{{ td(latest.quad_name) }}</span>
      <div class="metric"><span class="v {{ 'pos' if latest.growth_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.growth_score) }}</span><span class="k">{{ t('Growth', '增长') }}</span></div>
      <div class="metric"><span class="v {{ 'pos' if latest.inflation_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.inflation_score) }}</span><span class="k">{{ t('Inflation', '通胀') }}</span></div>
      <div class="metric"><span class="v">{{ (latest.confidence*100)|round|int }}%</span><span class="k">{{ t('Confidence', '置信度') }}</span></div>
      <div class="metric"><span class="chip c-info">{{ t('Dual liquidity', '双重流动性') }} {{ td(latest.liquidity_overlay) }}</span><span class="k">{{ t('Liquidity', '流动性') }}</span></div>
      <div class="metric"><span class="chip c-muted">{{ td(latest.cycle_tag) }}</span><span class="k">{{ t('Cycle', '周期阶段') }}</span></div>
      {% if vhsi %}<div class="metric"><span class="chip {{ 'c-warn' if vhsi.level>=23 else 'c-muted' }}">{{ vhsi.level }}</span><span class="k">{{ t('VHSI fear', '恒指波幅') }} · {{ vhsi.pctile }}%ile</span></div>{% endif %}
    </div>

    <!-- growth / inflation gauges -->
    <div class="herogauges">
      <div><div class="hg-l"><span>{{ t('Growth', '增长') }} <span class="muted" style="font-weight:400">{{ t('falling ↔ rising', '下行 ↔ 上行') }}</span></span><span class="hv {{ 'pos' if latest.growth_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.growth_score) }}</span></div><div class="gauge"><i style="left:{{ ((latest.growth_score+1)/2*100)|round(1) }}%"></i></div></div>
      <div><div class="hg-l"><span>{{ t('Inflation', '通胀') }} <span class="muted" style="font-weight:400">{{ t('falling ↔ rising', '下行 ↔ 上行') }}</span></span><span class="hv {{ 'pos' if latest.inflation_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.inflation_score) }}</span></div><div class="gauge"><i style="left:{{ ((latest.inflation_score+1)/2*100)|round(1) }}%"></i></div></div>
    </div>

    <!-- the four market regimes (growth × inflation) — today's outlined -->
    <div class="qmap">
      <span class="ax"></span>
      <span class="ax">{{ t('inflation falling ↓', '通胀下行 ↓') }}</span>
      <span class="ax">{{ t('inflation rising ↑', '通胀上行 ↑') }}</span>
      <span class="ax">{{ t('growth rising ↑', '增长上行 ↑') }}</span>
      <span class="cell q1{{ ' cur' if latest.quad=='Q1' }}">{{ t('GOLDILOCKS', '理想增长') }}<small>{{ t('internet, tech, quality', '互联网、科技、质量') }}</small></span>
      <span class="cell q2{{ ' cur' if latest.quad=='Q2' }}">{{ t('REFLATION', '再通胀') }}<small>{{ t('energy, materials, banks', '能源、材料、银行') }}</small></span>
      <span class="ax">{{ t('growth falling ↓', '增长下行 ↓') }}</span>
      <span class="cell q4{{ ' cur' if latest.quad=='Q4' }}">{{ t('GROWTH SCARE', '增长恐慌') }}<small>{{ t('defensives & utilities', '防御与公用') }}</small></span>
      <span class="cell q3{{ ' cur' if latest.quad=='Q3' }}">{{ t('STAGFLATION', '滞胀') }}<small>{{ t('the dangerous one', '最危险的那一种') }}</small></span>
    </div>

    {% if pb and pb.quad_meaning %}<p class="qmeaning">{{ t(pb.quad_meaning.en, pb.quad_meaning.zh) }}</p>{% endif %}
    {% if latest.pending_quad in ['Q1','Q2','Q3','Q4'] and latest.pending_days %}
    <p class="regwatch">⚠️ {{ t('Regime watch', '周期预警') }}: {{ t('evidence is building toward', '证据正在累积，指向') }} <b>{{ td({'Q1':'Goldilocks','Q2':'Reflation','Q3':'Stagflation','Q4':'Growth scare'}[latest.pending_quad]) }}</b> ({{ latest.pending_days }}{{ t(' day(s) so far; the label flips after 7)', ' 天；标签将在第7天翻转）') }}</p>{% endif %}
    {% if latest.confirming %}<p class="note" style="margin:12px 0 0">{{ t('Confirming', '确认') }}: {{ latest.confirming|join(', ') }}{% if latest.contradicting %} · {{ t('Contradicting', '矛盾') }}: {{ latest.contradicting|join(', ') }}{% endif %}</p>{% endif %}
  </div>

  <!-- benchmark cycle card -->
  {% if benchmark %}
  <div class="panel span4">
    <h2>{{ td(benchmark.name) }}</h2>
    <div style="font-size:20px;font-weight:800">{{ '%.2f'|format(benchmark.price) }} <span class="{{ 'pos' if benchmark.chg>=0 else 'neg' }}" style="font-size:14px">{{ '%+.2f'|format(benchmark.chg) }}%</span></div>
    <div style="margin:4px 0 8px"><span class="lad {{ 'up' if benchmark.dir=='up' else ('down' if benchmark.dir=='down' else 'flat') }}">{{ td(benchmark.label or benchmark.state) }}</span></div>
    <div class="mtf" data-mtf='{{ benchmark.mtf_json }}'></div>
  </div>
  {% endif %}

  <!-- ===================== MAJOR HK INDEXES — HEALTH & RISK ===================== -->
  {% if index_health %}
  <div class="panel span12" id="index-health">
    <h2>{{ t('Major HK index — health & risk', '香港主要指数 — 健康度与风险') }}
      {{ help("How the market itself is doing, before the macro engine. Price, % below the 52-week high (drawdown), trend vs the 50/200-day averages, and RSI(14) for the major HK indexes (Hang Seng TECH is the 3033.HK ETF, the cleanest stored HSTECH exposure). RSI &gt; 70 is stretched, &lt; 30 is washed out.", "在看宏观引擎之前，先看市场本身。各主要香港指数的价格、距52周高点的回撤、相对50/200日均线的趋势、RSI(14)（恒生科技采用 3033.HK ETF，为库内最干净的恒生科技敞口）。RSI &gt; 70 偏热，&lt; 30 超卖。") }}
    </h2>
    <div class="idx-grid">
      {% for ix in index_health %}
      <div class="idx-tile">
        <div class="idx-top"><b>{{ t(ix.label, ix.label_zh) }}</b> <span class="idx-px">{{ '%.2f'|format(ix.price) }}</span></div>
        <div class="idx-row">
          <span class="{{ 'pos' if ix.dd >= -1 else ('warn' if ix.dd >= -10 else 'neg') }}">{{ '%+.1f'|format(ix.dd) }}% {{ t('off high', '距高点') }}</span>
          <span>RSI {{ ix.rsi if ix.rsi is not none else '—' }}</span>
        </div>
        <div class="idx-trend">
          <span class="{{ 'pos' if ix.above200 else ('' if ix.above200 is none else 'neg') }}">{{ '✓' if ix.above200 else ('—' if ix.above200 is none else '✕') }} 200d</span>
          <span class="{{ 'pos' if ix.above50 else 'neg' }}">{{ '✓' if ix.above50 else '✕' }} 50d</span>
        </div>
      </div>
      {% endfor %}
    </div>
    <p class="note" style="margin:10px 0 0;text-transform:none">{{ t('Looking at individual HK names?', '想看个股？') }}
      <a href="hk_stocks.html" style="color:var(--link);font-weight:600">→ {{ t('HK stock & exposure board', '港股与敞口看板') }}</a></p>
  </div>
  {% endif %}

  <!-- GLOBAL RISK OVERLAY — HK's primary high-frequency driver -->
  {% if gv %}
  <div class="panel span12" id="global-risk">
    <h2>{{ t('Global Risk Overlay', '全球风险开关') }} · {{ t('HK\'s primary driver', '香港主驱动') }}</h2>
    <div class="hero">
      <span class="risk-badge {{ 'c-up' if gv.state=='Risk-on' else ('c-down' if gv.state=='Risk-off' else 'c-muted') }}">{{ td(gv.state) }}</span>
      <div class="metric"><span class="v {{ 'pos' if (gv.score or 0)>=0 else 'neg' }}">{{ '%+.2f'|format(gv.score) }}</span><span class="k">{{ t('Composite score', '综合评分') }}</span></div>
      {% if gv.peg %}
      <div class="metric" style="flex:1 1 280px;min-width:240px">
        <div class="peg-wrap">
          <div style="display:flex;align-items:baseline;gap:8px">
            <span class="v">{{ '%.4f'|format(gv.peg.level) }}</span>
            <span class="chip c-muted">{{ td(gv.peg.state) }}</span>
          </div>
          <div class="peg-gauge"><span class="peg-marker" style="left:{{ (gv.peg.distance*100)|round|int }}%"></span></div>
          <div class="peg-ends"><span>{{ t('7.75 strong / inflow', '7.75 强方 / 流入') }}</span><span>{{ t('7.85 weak / outflow', '7.85 弱方 / 流出') }}</span></div>
        </div>
        <span class="k">{{ t('HKD peg band', '港元联汇区间') }}</span>
      </div>
      {% endif %}
    </div>
    {% if gv.factors %}
    <div class="factor-grid">
      {% for f in gv.factors %}
      <div class="factor">
        <span class="dot {{ 'c-up' if f.risk=='on' else ('c-down' if f.risk=='off' else 'c-muted') }}"></span>
        <span>{{ td(f.label) }}</span>
        <span class="fz {{ 'pos' if (f.z or 0)>=0 else 'neg' }}">{{ '%+.2f'|format(f.z) }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <p class="note" style="margin:13px 0 0">{{ t('Hong Kong is ~2x more globally sensitive than the Mainland — this risk-on/off composite (dollar, volatility, US equity, copper/gold, USD-CNY, EM) plus the HKD peg is HK\'s primary high-frequency driver. It is a concurrent risk STATE, not a forecast.', '香港对全球因素的敏感度约为内地的2倍——此风险开关综合指标（美元、波动率、美股、铜金比、美元兑人民币、新兴市场）加上港元联系汇率，是香港最主要的高频驱动。它是同步的风险状态，而非预测。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== FIRED ALERTS (today) ===================== -->
  {% set ALERTS = latest.alerts %}
  {% if ALERTS %}
  <div class="panel span12" id="hk-fired-alerts">
    <h2>🚨 {{ t('Fired alerts (today)', '已触发警报（今日）') }}
      {{ help("Alerts fire only when something CHANGES — a confidence drop, a peg approaching the weak side, a risk-state flip, a HIBOR spike, a southbound surge — never just because a level is high. Rare by design; read every one. Click any alert to jump to its panel. All display-only — never scored into the regime.", "警报只在某物发生变化时触发 — 置信度下降、港元逼近弱方、风险开关翻转、HIBOR 飙升、南向激增 — 绝不仅因水平偏高而触发。刻意设计得稀少；每一条都要读。点击警报可跳转其面板。全部仅展示 — 从不计入区制评分。") }}
    </h2>
    {% for a in ALERTS %}
      <a class="alert alert-{{ a.severity }}" {% if a.anchor %}href="#{{ a.anchor }}"{% endif %}>
        <div class="alert-head">
          <span class="alert-ico">{{ a.icon }}</span>
          <b><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></b>
          {% if a.anchor %}<span class="alert-jump">{{ t('View panel ↓', '查看面板 ↓') }}</span>{% endif %}
        </div>
        <div class="alert-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
        {% if a.what_en %}<div class="alert-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh or a.what_en }}</span></div>{% endif %}
        {% if a.edge_en %}<div class="alert-edge"><b>{{ t('Conviction:', '可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
      </a>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ===================== SIGNAL STACK — consolidated cross-subsystem read ===================== -->
  {% if signal_stack %}
  <div class="panel span12" id="signal-stack">
    <h2>{{ t('Signal stack — where the evidence agrees & disagrees', '信号堆栈 — 证据在何处一致、在何处分歧') }}
      {{ help("Don't ask 'is it bullish?' — ask 'which parts of the evidence disagree?'. This collapses the dashboard's subsystem reads into one stack: each leg's lean, the regime-core agreement, and the single biggest contradiction. It re-presents signals detailed below — it invents nothing and is never scored. SCORED legs (quad, growth, global risk, dual liquidity) drive the regime; CONTEXT legs are positioning colour only.", "不要问'是不是看多？'，而要问'证据的哪些部分相互矛盾？'。这把仪表盘各子系统读数汇聚为一个堆栈：每条腿的倾向、周期核心一致度，以及最大的那条矛盾。它只是对下方详述信号的再呈现 — 不创造新信号，也从不计入评分。已评分腿（象限、增长、全球风险、双重流动性）驱动周期；背景腿仅为仓位色彩。") }}
    </h2>
    <div class="sstack-grid">
      <div class="sstack-legs">
        {% for leg in signal_stack.legs %}
        <div class="sstack-leg">
          <span class="sstack-dot tone-{{ leg.tone }}"></span>
          <span class="sstack-name">{{ t(leg.label_en, leg.label_zh) }}{% if leg.tier == 'context' %}<span class="sstack-tier">{{ t('context', '背景') }}</span>{% endif %}</span>
          <span class="sstack-state tone-{{ leg.tone }}">{{ t(leg.state_en, leg.state_zh) }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="sstack-verdict">
        <div class="sstack-final tone-{{ signal_stack.anchor_tone }}">{{ t('Final', '结论') }}: <b>{{ t(signal_stack.final_en, signal_stack.final_zh) }}</b></div>
        {% if signal_stack.agreement_pct is not none %}
        <div class="sstack-agree">{{ t('Regime agreement', '周期一致度') }} <b>{{ signal_stack.agreement_pct }}%</b>{% if signal_stack.quality_en %} — {{ t(signal_stack.quality_en, signal_stack.quality_zh) }}{% endif %}</div>
        {% endif %}
        <div class="sstack-tally"><b class="tone-up">{{ signal_stack.n_bull }}</b> {{ t('constructive', '建设性') }} · <b>{{ signal_stack.n_flat }}</b> {{ t('neutral', '中性') }} · <b class="tone-down">{{ signal_stack.n_bear }}</b> {{ t('cautionary', '谨慎') }} {{ t('of', '／共') }} {{ signal_stack.n }}</div>
        {% if signal_stack.contradiction_en %}
        <div class="sstack-contra">⚠ {{ t('Main contradiction', '主要矛盾') }}: {{ t(signal_stack.contradiction_en, signal_stack.contradiction_zh) }}</div>
        {% else %}
        <div class="sstack-contra ok">✓ {{ t('Broad agreement — no leg is fighting the regime', '广泛一致 — 没有腿与周期相左') }}</div>
        {% endif %}
      </div>
    </div>
    <p class="note" style="margin:10px 0 0;text-transform:none;font-size:11px">{{ t('Display-only consolidation of the signals detailed below — it changes no score. The agreement % is the regime-core confidence; the legs are context.', '仅为下方详述信号的展示性汇总 — 不改变任何评分。一致度为周期核心置信度；各腿为背景。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== MARKET SNAPSHOT (cross-asset tiles) ===================== -->
  {% if market_tiles %}
  <div class="panel span12" id="market-snapshot">
    <h2>{{ t('Market snapshot', '市场快照') }}
      {{ help("The headline cross-asset levels HK keys off, in one glance — the HS-TECH index, the USD/HKD peg, the offshore yuan, gold, the US dollar and overnight HIBOR — each with its 1-day move. A quick orientation; the read and the why live in the panels below. Tone is inverted where a higher level is risk-off (a weaker HKD / yuan, a stronger dollar).", "一眼看尽香港所依赖的跨资产关键水平 — 恒生科技、美元兑港元联汇、离岸人民币、黄金、美元指数与隔夜 HIBOR — 各附其单日变动。用于快速定位；解读与原因见下方面板。当水平上行代表避险时（港元/人民币走弱、美元走强），色彩反转。") }}
    </h2>
    <div class="mtiles">
      {% for tl in market_tiles %}
      <div class="mtile">
        <div class="mtile-top"><span class="mtile-lbl">{{ tl.label }}</span><span class="mtile-tag">{{ tl.tag }}</span></div>
        <div class="mtile-val">{{ tl.level }}</div>
        <div class="mtile-chg {{ tl.tone }}">{{ tl.chg }} ({{ tl.pct }})</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- ===================== DRAWDOWN & SLOWDOWN RISK (uncalibrated, display-only) ===================== -->
  {% if latest.conditions and latest.conditions.recession and latest.conditions.recession.score is not none %}
  {% set CO = latest.conditions %}
  <div class="panel span12" id="hk-risk">
    <h2>{{ t('HK drawdown & slowdown risk', '香港回撤与放缓风险') }}
      <span class="note" style="text-transform:none">· {{ t('uncalibrated · display only', '未校准 · 仅展示') }}</span>
      {{ help("Two HK-native risk gauges, both 0–100. UNCALIBRATED: HK history is short and globally coupled, so no measured forward-drawdown edge is claimed — the bands are each gauge's OWN history percentiles, and these stay descriptive context, never scored. <b>Slowdown</b> blends China PMI, PPI deflation, the M1−M2 scissors, southbound drought, HKD-peg funding stress and the China GDP / IP trend (HSI earnings are ~75% China-driven). <b>Drawdown risk</b> is the rank-percentile of stacked HK stress legs — slowdown, VHSI, peg stress, a HIBOR spike and breadth collapse.", "两个香港本土风险仪表，均为 0–100。未校准：香港历史短且与全球高度耦合，不声称任何前瞻回撤优势 — 区间为各仪表自身的历史分位，仅作描述性背景，从不计入评分。<b>放缓</b>融合中国 PMI、PPI 通缩、M1−M2 剪刀差、南向流出、港元联汇资金压力与中国 GDP／工业增加值趋势（恒指盈利约 75% 由中国驱动）。<b>回撤风险</b>是各香港压力腿（放缓、VHSI、联汇压力、HIBOR 飙升、宽度崩塌）的排名分位。") }}
    </h2>
    <div class="grid" style="gap:18px">
      <div class="span6">
        <div style="display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'neg' if CO.recession.score>=60 else ('warn' if CO.recession.score>=40 else 'pos') }}">{{ CO.recession.score|round|int }}</span>
          <span class="sub">{{ t('Slowdown score', '放缓评分') }} · {{ t(CO.recession.label, {'low':'低','elevated':'偏高','high':'高'}.get(CO.recession.label, CO.recession.label)) }}</span>
        </div>
        <div class="dial"><i style="left:{{ CO.recession.score }}%"></i></div>
        <div class="dial-ends"><span>{{ t('expansion', '扩张') }}</span><span>{{ t('contraction', '收缩') }}</span></div>
        <table style="margin-top:8px">
          <tbody>
          {% for lg in CO.recession.legs if lg.active %}
          <tr><td class="l">{{ t(lg.label, lg.label_zh) }}</td>
            <td>{{ '%.0f'|format(lg.points) if lg.points is not none else '—' }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {% if CO.recession_html %}<div class="chart">{{ CO.recession_html | safe }}</div>{% endif %}
      </div>
      <div class="span6">
        {% if CO.drawdown_risk and CO.drawdown_risk.score is not none %}
        <div style="display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'neg' if CO.drawdown_risk.score>=60 else ('warn' if CO.drawdown_risk.score>=40 else 'pos') }}">{{ CO.drawdown_risk.score|round|int }}</span>
          <span class="sub">{{ t('Drawdown-risk percentile', '回撤风险分位') }} · {{ t(CO.drawdown_risk.band, {'calm':'平静','low':'低','elevated':'偏高','high':'高','extreme':'极端'}.get(CO.drawdown_risk.band, CO.drawdown_risk.band)) }}</span>
        </div>
        <div class="dial"><i style="left:{{ CO.drawdown_risk.score }}%"></i></div>
        <div class="dial-ends"><span>{{ t('calm', '平静') }}</span><span>{{ t('fragile', '脆弱') }}</span></div>
        {% if CO.drawdown_html %}<div class="chart">{{ CO.drawdown_html | safe }}</div>{% endif %}
        {% endif %}
        {% if property %}
        <div style="margin-top:14px;display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'pos' if property.regime.tone=='up' else ('neg' if property.regime.tone=='down' else '') }}">{{ property.ccl.level }}</span>
          <span class="sub">{{ t('Centaline CCL', '中原城市领先指数') }} · {{ t(property.regime.label_en, property.regime.label_zh) }}{% if property.ccl.chg_52w is not none %} · {{ '%+.1f'|format(property.ccl.chg_52w) }}% {{ t('YoY', '同比') }}{% endif %}</span>
        </div>
        {% endif %}
      </div>
    </div>
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">{{ t('Uncalibrated, display-only context — HK history is short / globally coupled, so no forward-drawdown edge is claimed. Bands are own-history percentiles. Never scored into the quad / axes / playbook.', '未校准的展示性背景 — 香港历史短且与全球高度耦合，不声称前瞻回撤优势。区间为历史分位。从不计入象限／轴／策略评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== WHAT'S DRIVING THE TAPE (market drivers) ===================== -->
  {% if latest.market_drivers and latest.market_drivers.verdict not in [none, 'unknown'] %}
  {% set MD = latest.market_drivers %}
  <div class="panel span12" id="market-drivers">
    <h2>{{ t("What's driving the HK tape", '香港市场驱动因素') }}
      <span class="note" style="text-transform:none">· {{ t('past week', '过去一周') }}{% if MD.window_d %} · {{ MD.window_d }}d z{% endif %}</span>
      {{ help("Deterministic cross-asset attribution — which macro <b>fingerprint</b> best explains the last week's HK moves. NO news feed: it z-scores HK cross-asset legs (global S&P/VIX/dollar/EM, China stimulus spillover via H-shares & southbound, HKD-peg & HIBOR funding stress, US-rate repricing, tech-internet leadership and a VHSI/breadth washout) and attributes the day to the driver whose legs line up best. A regime READ, never a signal — it never gates the quad or any score.", "确定性的跨资产归因 — 哪个宏观<b>指纹</b>最能解释过去一周的香港走势。无新闻源：它对香港跨资产分腿（全球标普/VIX/美元/新兴市场、经 H 股与南向的中国刺激外溢、港元联汇与 HIBOR 资金压力、美息重定价、科技互联网领涨、以及 VHSI/宽度的出清）进行 z 标准化，并把当下归因于分腿最吻合的驱动。这是区制解读，而非信号 — 从不决定象限或任何评分。") }}
    </h2>
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:10px">
      <span class="chip c-{{ 'info' if MD.verdict=='clear' else ('warn' if MD.verdict=='mixed' else 'muted') }}"><span class="l-en">{{ MD.verdict }}</span><span class="l-zh">{{ MD.verdict_zh }}</span></span>
      <span style="font-size:18px;font-weight:800">{{ t(MD.primary_label, MD.primary_label_zh) }}</span>
      <span class="sub">{{ t('confidence', '置信度') }} <span class="l-en">{{ MD.confidence }}</span><span class="l-zh">{{ MD.confidence_zh }}</span> · {{ t('agreement', '一致度') }} {{ (MD.agreement*100)|round|int }}%</span>
    </div>
    <p class="note" style="margin:8px 0 8px;text-transform:none"><span class="l-en">{{ MD.direction }}</span><span class="l-zh">{{ MD.direction_zh }}</span></p>
    {% if MD.evidence_legs %}
    <div style="display:flex;flex-direction:column;gap:5px;max-width:560px">
      {% for lg in MD.evidence_legs %}
      {% set w = (([lg.z|abs, 3]|min)/3*50)|round(1) %}
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:0 0 160px;font-size:12.5px">{{ t(lg.en, lg.zh) }}</span>
        <div style="flex:1;height:9px;border-radius:5px;background:var(--panel2);position:relative">
          <i style="position:absolute;top:0;height:100%;border-radius:5px;{{ 'right:50%;background:var(--down)' if lg.z<0 else 'left:50%;background:var(--up)' }};width:{{ w }}%"></i>
          <span style="position:absolute;left:50%;top:-2px;height:13px;width:1px;background:var(--muted)"></span>
        </div>
        <span class="sub" style="flex:0 0 48px;text-align:right">{{ '%+.1f'|format(lg.z) }}σ</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if MD.runner_up_label %}<p class="sub" style="margin:8px 0 0">{{ t('Runner-up', '次因') }}: {{ t(MD.runner_up_label, MD.runner_up_label_zh) }}</p>{% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none"><span class="l-en">{{ MD.note }}{% if MD.invalidation %} · {{ MD.invalidation }}{% endif %}</span><span class="l-zh">确定性的香港跨资产归因 — 区制解读，而非信号；从不决定评分或象限。{% if MD.invalidation_zh %} · {{ MD.invalidation_zh }}{% endif %}</span></p>
  </div>
  {% endif %}

  <!-- ===================== FEAR ↔ EUPHORIA + RORO ===================== -->
  {% if latest.fear_euphoria %}
  {% set FE = latest.fear_euphoria %}
  <div class="panel span12" id="fear-euphoria">
    <h2>{{ t('🌡️ Fear ↔ Euphoria — HK regime synthesis', '🌡️ 恐惧 ↔ 欣喜 — 香港情绪综合') }}
      <span class="note" style="text-transform:none">{% if FE.roro is not none %}· RORO {{ '%+.2f'|format(FE.roro) }} ({{ td(FE.roro_state) }}){% endif %}{% if FE.warming_up %} · {{ t('history warming up', '历史预热中') }}{% endif %}</span>
      {{ help("A 0–100 sentiment synthesis: the rolling-5y percentile of an HK risk-on/risk-off (RORO) composite. The RORO is the equal-weight mean of causal-z legs — copper/gold, the S&P, EM equity, southbound smart-money and breadth (risk-ON), against VIX, a stronger dollar, a weaker yuan, VHSI, a weak-side peg, the A/H premium and rising HIBOR (risk-OFF). The confirmation tally shows whether the legs agree or the tape is internally divergent. Display-only — never scored.", "0–100 的情绪综合：香港风险偏好（RORO）综合指标的滚动 5 年分位。RORO 是因果 z 分腿的等权平均 — 铜/金、标普、新兴市场股票、南向聪明钱与宽度（偏多），对 VIX、美元走强、人民币走弱、VHSI、弱方联汇、A/H 溢价与 HIBOR 上行（偏空）。确认计数显示各腿是否一致、或市场内部背离。仅展示 — 从不评分。") }}
    </h2>
    {% if FE.fe_score is not none %}
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <span class="bignum">{{ FE.fe_score }}</span>
      <span class="chip c-{{ 'down' if FE.fe_score>=75 else ('up' if FE.fe_score<=25 else 'muted') }}" style="font-size:15px">{{ t(FE.band, FE.band_zh) }}</span>
      <span class="sub">{{ t('0 = Panic · 100 = Euphoria', '0＝恐慌 · 100＝欣喜') }}</span>
    </div>
    <div class="dial"><i style="left:{{ FE.fe_score }}%"></i></div>
    <div class="dial-ends"><span>{{ t('Panic', '恐慌') }}</span><span>{{ t('Neutral', '中性') }}</span><span>{{ t('Euphoria', '欣喜') }}</span></div>
    {% endif %}
    {% if FE.chart_html %}<div class="chart">{{ FE.chart_html | safe }}</div>{% endif %}
    {% if FE.legs %}
    <h3>{{ t('Risk-on / risk-off legs (percentile)', '风险偏好分腿（分位）') }}</h3>
    <div style="display:flex;flex-direction:column;gap:5px;max-width:600px">
      {% for lg in FE.legs %}
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:0 0 180px;font-size:12.5px">{{ t(lg.name_en, lg.name_zh) }}</span>
        <div style="flex:1;height:9px;border-radius:5px;background:var(--panel2);position:relative">
          <i style="position:absolute;top:0;left:0;height:100%;border-radius:5px;background:{{ 'var(--up)' if lg.lean=='risk-on' else ('var(--down)' if lg.lean=='risk-off' else 'var(--muted)') }};width:{{ lg.pct }}%"></i>
        </div>
        <span class="sub" style="flex:0 0 34px;text-align:right">{{ lg.pct }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if FE.confirmation %}
    <p class="note" style="margin:9px 0 0;text-transform:none">{{ t('Cross-asset confirmation', '跨资产确认') }}:
      <b><span class="l-en">{{ FE.confirmation.verdict_en }}</span><span class="l-zh">{{ FE.confirmation.verdict_zh }}</span></b>
      — {{ FE.confirmation.n_on }} {{ t('risk-on', '偏多') }} / {{ FE.confirmation.n_off }} {{ t('risk-off', '偏空') }}.</p>
    {% endif %}
