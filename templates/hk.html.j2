    border:1px solid var(--c,var(--muted));color:var(--c,var(--muted));background:color-mix(in srgb,var(--c,var(--muted)) 13%,transparent)}
  #sb-ah-combined .sig-in{--c:var(--up)}
  #sb-ah-combined .sig-out{--c:var(--down)}
  #sb-ah-combined .sig-neu{--c:var(--muted)}
