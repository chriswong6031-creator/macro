{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro chip(en, zh='', cls='') -%}
<span class="chip{% if cls %} chip-{{ cls }}{% endif %}"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Options Screener — IV, GEX, flow · 期权筛选台</title>
{% set seo_title = "Options Screener — Mastermind" %}{% set seo_desc = "Screen options by IV, gamma exposure and flow — find where positioning is extreme. Updated daily." %}{% set seo_path = "options_screener.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body { padding:24px max(40px,calc((100vw - 1400px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; font-weight:600; letter-spacing:.2px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:14px; }
  .muted { color:var(--muted); } .sm { font-size:12px; } .xs { font-size:11px; }
  .pos { color:var(--up); } .neg { color:var(--down); }

  /* ---- chip row ---- */
  .toprow { display:flex; flex-wrap:wrap; align-items:baseline; gap:8px 12px; margin-bottom:14px; }
  .chip { display:inline-block; font-size:11px; font-weight:600; padding:3px 9px; border-radius:20px;
    border:1px solid var(--line); background:var(--panel2); color:var(--muted); white-space:nowrap; }
  .chip-ok  { color:var(--up);   border-color:var(--up);   background:color-mix(in srgb,var(--up) 10%, transparent); }
  .chip-warn{ color:var(--orange); border-color:var(--orange); background:color-mix(in srgb,var(--orange) 10%, transparent); }
  .chip-soft{ color:var(--muted); border-color:var(--muted); font-style:italic; }

  /* ---- honest-box ---- */
  .honest-box { font-size:12px; line-height:1.55; color:var(--muted); background:var(--panel2); border:1px solid var(--line);
    border-radius:10px; padding:10px 14px; margin-bottom:14px; }
  .honest-box strong { color:var(--text); }

  /* ---- filter panel ---- */
  .filter-panel { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:10px; }
  .filter-toggle-btn { display:none; background:none; border:1px solid var(--line); border-radius:8px;
    padding:6px 14px; font:inherit; font-size:13px; color:var(--text); cursor:pointer; margin-bottom:10px; }
  @media (max-width:899px) {
    .filter-toggle-btn { display:inline-flex; align-items:center; gap:6px; }
    .filter-body { display:none; }
    .filter-body.open { display:block; }
  }
  @media (min-width:900px) {
    .filter-body { display:block !important; }
  }
  .filter-row { display:flex; flex-wrap:wrap; gap:8px 14px; align-items:center; margin-bottom:10px; }
  .filter-row:last-child { margin-bottom:0; }
  .filter-row input[type=text], .filter-row select {
    padding:7px 10px; border:1px solid var(--line); border-radius:9px;
    background:var(--panel2); color:var(--text); font:inherit; font-size:13px; cursor:pointer; }
  .filter-row input[type=text] { flex:1 1 180px; max-width:280px; cursor:text; }
  .filter-row input[type=text]:focus, .filter-row select:focus { outline:none; border-color:var(--info); }
  .filter-label { font-size:12px; color:var(--muted); display:flex; align-items:center; gap:4px; white-space:nowrap; }
  .filter-pair { display:flex; align-items:center; gap:4px; }
  .filter-pair input[type=number] { width:72px; padding:6px 8px; border:1px solid var(--line); border-radius:8px;
    background:var(--panel2); color:var(--text); font:inherit; font-size:12px; }
  .filter-pair input[type=number]:focus { outline:none; border-color:var(--info); }
  .filter-pair .sep { font-size:11px; color:var(--muted); }
  .filter-badge { display:inline-block; font-size:10px; font-weight:700; padding:1px 6px; border-radius:10px;
    background:var(--info); color:#fff; margin-left:6px; vertical-align:middle; }
  .filter-clear-btn { background:none; border:1px solid var(--line); border-radius:8px; padding:5px 12px;
    font:inherit; font-size:12px; color:var(--muted); cursor:pointer; }
  .filter-clear-btn:hover { border-color:var(--text); color:var(--text); }

  /* ---- preset chips ---- */
  .preset-row { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
  .preset-chip { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:600;
    padding:4px 11px; border-radius:20px; border:1px solid var(--line); background:var(--panel2);
    color:var(--muted); cursor:pointer; white-space:nowrap; transition:border-color .15s, color .15s; }
  .preset-chip:hover { border-color:var(--info); color:var(--text); }
  .preset-chip.active { border-color:var(--info); color:var(--info); background:color-mix(in srgb,var(--info) 10%, transparent); }

  /* ---- view + sort controls ---- */
  .ctrl-row { display:flex; flex-wrap:wrap; gap:8px 12px; align-items:center; margin-bottom:10px; }
  .ctrl-row select { padding:7px 10px; border:1px solid var(--line); border-radius:9px;
    background:var(--panel2); color:var(--text); font:inherit; font-size:13px; cursor:pointer; }
  .ctrl-row label { font-size:12px; color:var(--muted); }
  .view-chips { display:flex; gap:6px; }
  .view-chip { font-size:12px; font-weight:600; padding:5px 13px; border-radius:20px;
    border:1px solid var(--line); background:var(--panel2); color:var(--muted); cursor:pointer; }
  .view-chip.active { border-color:var(--info); color:var(--info); background:color-mix(in srgb,var(--info) 10%, transparent); }
  .export-btn { background:none; border:1px solid var(--line); border-radius:8px; padding:6px 13px;
    font:inherit; font-size:12px; color:var(--muted); cursor:pointer; margin-left:auto; }
  .export-btn:hover { border-color:var(--text); color:var(--text); }

  /* ---- screener table ---- */
  .tbl-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  table.sc-tbl { width:100%; border-collapse:collapse; font-size:12.5px; }
  table.sc-tbl thead th { text-align:right; color:var(--muted); font-weight:500; padding:7px 10px 5px;
    border-bottom:2px solid var(--line); white-space:nowrap; position:sticky; top:0; background:var(--panel); z-index:2; }
  table.sc-tbl thead th:first-child,
  table.sc-tbl thead th.left { text-align:left; }
  table.sc-tbl thead th.sortable { cursor:pointer; user-select:none; }
  table.sc-tbl thead th.sortable:hover { color:var(--text); }
  table.sc-tbl thead th.sorted { color:var(--text); }
  table.sc-tbl thead th .sarrow { font-size:9px; opacity:.35; margin-left:3px; font-weight:700; }
  table.sc-tbl thead th.sorted .sarrow { opacity:.9; color:var(--link); }
  table.sc-tbl tbody td { padding:6px 10px; border-bottom:1px solid var(--line); text-align:right;
    font-variant-numeric:tabular-nums; }
  table.sc-tbl tbody td:first-child,
  table.sc-tbl tbody td.left { text-align:left; }
  table.sc-tbl tbody tr:hover td { background:var(--panel2); }
  table.sc-tbl tbody .tk { font-weight:700; font-size:13px; }
  table.sc-tbl tbody .na { color:var(--muted); }

  /* ---- sticky first column ---- */
  table.sc-tbl thead th:first-child,
  table.sc-tbl tbody td:first-child { position:sticky; left:0; z-index:1; background:var(--panel); }
  table.sc-tbl tbody tr:hover td:first-child { background:var(--panel2); }

  /* ---- column view visibility ---- */
  /* overview cols */
  .col-flow     { display:none; }
  .col-pos      { display:none; }
  .col-ov       { display:table-cell; }
  /* flow view */
  body.view-flow   .col-ov   { display:none; }
  body.view-flow   .col-flow { display:table-cell; }
  /* positioning view */
  body.view-pos    .col-ov   { display:none; }
  body.view-pos    .col-pos  { display:table-cell; }
  /* always-on columns */
  .col-always   { display:table-cell !important; }

  /* ---- young badge ---- */
  .young-badge { font-size:10px; font-weight:600; padding:1px 5px; border-radius:5px;
    background:color-mix(in srgb,var(--orange) 15%, transparent);
    color:var(--orange); border:1px solid var(--orange); white-space:nowrap; vertical-align:middle; margin-left:4px; }

  /* ---- tone chip ---- */
  .tone { font-size:11px; font-weight:600; padding:2px 7px; border-radius:12px; white-space:nowrap; }
  .tone-call { color:var(--up);   background:color-mix(in srgb,var(--up) 12%, transparent);   border:1px solid var(--up); }
  .tone-put  { color:var(--down); background:color-mix(in srgb,var(--down) 12%, transparent); border:1px solid var(--down); }
  .tone-neu  { color:var(--muted); border:1px solid var(--line); background:transparent; }

  /* ---- gamma regime chip ---- */
  .grec { font-size:11px; font-weight:600; padding:2px 7px; border-radius:12px; white-space:nowrap; }
  .grec-long  { color:var(--up);   background:color-mix(in srgb,var(--up) 10%, transparent);   border:1px solid var(--up); }
  .grec-short { color:var(--down); background:color-mix(in srgb,var(--down) 10%, transparent); border:1px solid var(--down); }

  /* ---- coverage stamp ---- */
  .cov-stamp { font-size:11px; color:var(--muted); margin-top:8px; line-height:1.6; }

  /* ---- help popover ---- */
  .help { display:inline-flex; align-items:center; justify-content:center; width:14px; height:14px; border-radius:50%;
    border:1px solid var(--muted); color:var(--muted); font-size:9px; font-weight:700; cursor:help;
    position:relative; vertical-align:middle; margin-left:4px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%);
    width:260px; background:var(--panel); border:1px solid var(--line); padding:9px 11px;
    border-radius:8px; z-index:60; font-size:11.5px; line-height:1.45; color:var(--text); font-weight:400;
    box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto; text-align:left; white-space:normal;
    max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }

  /* ---- responsive hide ---- */
  @media (max-width:900px) {
    .sc-hide-sm { display:none !important; }
  }
  @media (max-width:640px) {
    .sc-hide-xs { display:none !important; }
  }
</style>
</head>
<body>
{% set nav_search_placeholder_en = 'Search any stock - US, China, HK, Canada and more...' %}
{% set nav_search_placeholder_zh = '搜索任意股票 - 美股、A股、港股、加股等...' %}
{% include "_site_nav.html.j2" ignore missing %}

<div class="toprow">
  <h1>{{ t('Options Screener', '期权筛选台') }}</h1>
  {{ chip('EOD · display-only', 'EOD · 仅供展示') }}
  {{ chip(coverage.n_names|string ~ ' names', coverage.n_names|string ~ ' 个标的') }}
  {% if coverage.tape_flow_present %}
  {{ chip('tape-flow present', '逐笔流量已就位', 'ok') }}
  {% endif %}
  <span class="muted sm">{{ t('built', '构建于') }} {{ built }}</span>
</div>

<div class="honest-box">
  <strong>{{ t('Coverage & data provenance', '覆盖范围与数据说明') }}</strong> ·
  {{ t(
    'IV · GEX · walls · max-pain: Polygon.io options chain snapshots, ' ~ coverage.n_names|string ~ ' underlyings, daily since 2026-06-15 (accruing). '
    ~ 'IV-rank = percentile within available history — labelled "young (n=Xd)" when fewer than '
    ~ coverage.young_threshold|string ~ ' calendar days are stored; do NOT treat a young IV-rank as a '
    ~ coverage.young_threshold|string ~ '-day percentile. '
    ~ 'Options flow (volume · premium · P/C ratio): ' ~ coverage.n_names|string ~ ' names, last trading session. '
    ~ 'Net-premium tone is a labeled heuristic only — magnitude is reliable, direction is SOFT (signing incomplete). '
    ~ 'Implied-move proxy = IV30 × √(30÷365) × 100%. '
    ~ 'Skew (put-skew pp): ' ~ coverage.n_skew|string ~ ' names from ~30-day tenor snapshots; skew = OTM-put IV minus ATM-call IV in percentage points. '
    ~ 'IV-spread (vs peers): ' ~ coverage.n_ivspread|string ~ ' names; spread relative to same-day cross-sectional median (positive = wider than peers). '
    ~ 'Skew and IV-spread are display-only context — the chain panel is still too narrow and short to treat either as a forward predictor. '
    ~ 'Rel. volume: ' ~ coverage.n_relvol|string ~ ' names; today\'s option volume vs own 20-session average. '
    ~ 'Nothing here feeds any score or rank path.',

    'IV · GEX · 墙位 · 最大痛点：Polygon.io 期权链快照，'
    ~ coverage.n_names|string ~ ' 个标的，每日数据自 2026-06-15 起累积。'
    ~ 'IV分位 = 当前IV30在可用历史中的百分位——当历史不足 '
    ~ coverage.young_threshold|string ~ ' 个日历日时，标注"young (n=Xd)"；请勿将 young 分位视为完整 '
    ~ coverage.young_threshold|string ~ ' 日历史分位。'
    ~ '期权流量（成交量 · 权利金 · 认沽/认购比）：' ~ coverage.n_names|string ~ ' 个标的，最近交易日数据。'
    ~ '净权利金方向为启发式标签——量级可靠，方向为软性参考（签名机制尚未完整）。'
    ~ '隐含波动幅度 = IV30 × √(30÷365) × 100%。'
    ~ '偏斜（认沽溢价pp）：' ~ coverage.n_skew|string ~ ' 个标的，约30日到期期权快照；偏斜 = 虚值认沽IV减平值认购IV（百分点）。'
    ~ 'IV价差（相对同业）：' ~ coverage.n_ivspread|string ~ ' 个标的；相对同日截面中位数的价差（正值=高于同业）。'
    ~ '偏斜与IV价差仅为展示性参考——期权链数据仍偏窄偏短，请勿作为前瞻指标使用。'
    ~ '相对成交量：' ~ coverage.n_relvol|string ~ ' 个标的；当日期权成交量相对自身20日均值。'
    ~ '本页所有数据均不进入任何评分或排名流程。'
  ) }}
</div>

<!-- ===== FILTER PANEL ===== -->
<div class="filter-panel">
  <button class="filter-toggle-btn" id="os-filter-toggle" type="button">
    <span class="l-en">Filters</span><span class="l-zh">筛选</span>
    <span id="os-filter-badge" class="filter-badge" style="display:none"></span>
  </button>
  <div class="filter-body" id="os-filter-body">

    <!-- Row 1: text + sector + gex tier + gamma regime + net-prem tone -->
    <div class="filter-row">
      <input id="os-search" type="text"
        placeholder="Filter ticker or sector…"
        data-ph-zh="按代码或行业筛选…"
        autocomplete="off" spellcheck="false">

      <label class="filter-label">
        {{ t('Sector', '行业') }}
        <select id="os-sector">
          <option value="" data-en="All sectors" data-zh="全部行业">All sectors</option>
        </select>
      </label>

      <label class="filter-label">
        {{ t('GEX tier', 'GEX层级') }}
        <select id="os-tier">
          <option value="" data-en="All" data-zh="全部">All</option>
          <option value="full">full</option>
          <option value="lite">lite</option>
        </select>
      </label>

      <label class="filter-label">
        {{ t('Gamma regime', 'Gamma态势') }}
        <span class="help">?<span class="tip">{{ t(
          'Long gamma: dealers hold net long gamma and lean against moves — they sell rallies and buy dips. Short gamma: dealers hold net short gamma and chase moves — they buy rallies and sell dips.',
          '多Gamma：做市商净持有多Gamma，倾向于对冲价格变动——逢涨卖出、逢跌买入。空Gamma：做市商净持有空Gamma，倾向于追随价格变动——逢涨买入、逢跌卖出。'
        ) }}</span></span>
        <select id="os-regime">
          <option value="" data-en="All" data-zh="全部">All</option>
          <option value="long" data-en="Long" data-zh="多Gamma">Long</option>
          <option value="short" data-en="Short" data-zh="空Gamma">Short</option>
        </select>
      </label>

      <label class="filter-label">
        {{ t('Net-prem tone', '净权利金方向') }}
        <select id="os-tone">
          <option value="" data-en="All" data-zh="全部">All</option>
          <option value="call-leaning" data-en="Call-leaning" data-zh="偏认购">Call-leaning</option>
          <option value="put-leaning" data-en="Put-leaning" data-zh="偏认沽">Put-leaning</option>
          <option value="neutral" data-en="Neutral" data-zh="中性">Neutral</option>
        </select>
      </label>

      <button class="filter-clear-btn" id="os-clear-btn" type="button">{{ t('Clear all', '清除全部') }}</button>
    </div>

    <!-- Row 2: numeric ranges -->
    <div class="filter-row">
      <span class="filter-label">
        IV30 %
        <span class="filter-pair">
          <input type="number" id="f-iv30-min" placeholder="min" step="0.1">
          <span class="sep">–</span>
          <input type="number" id="f-iv30-max" placeholder="max" step="0.1">
        </span>
      </span>

      <span class="filter-label">
        {{ t('IV Rank', 'IV分位') }}
        <span class="filter-pair">
          <input type="number" id="f-ivrank-min" placeholder="min" min="0" max="100">
          <span class="sep">–</span>
          <input type="number" id="f-ivrank-max" placeholder="max" min="0" max="100">
        </span>
      </span>

      <span class="filter-label">
        {{ t('Impl. move %', '隐含波幅%') }}
        <span class="filter-pair">
          <input type="number" id="f-impl-min" placeholder="min" step="0.1">
          <span class="sep">–</span>
          <input type="number" id="f-impl-max" placeholder="max" step="0.1">
        </span>
      </span>

      <span class="filter-label">
        {{ t('P/C ratio', 'P/C比') }}
        <span class="filter-pair">
          <input type="number" id="f-pc-min" placeholder="min" step="0.01">
          <span class="sep">–</span>
          <input type="number" id="f-pc-max" placeholder="max" step="0.01">
        </span>
      </span>

      <span class="filter-label">
        {{ t('Volume', '成交量') }}
        <span class="filter-pair">
          <input type="number" id="f-vol-min" placeholder="min" min="0">
          <span class="sep">–</span>
          <input type="number" id="f-vol-max" placeholder="max" min="0">
        </span>
      </span>
    </div>

    <!-- Row 3: more numeric ranges -->
    <div class="filter-row">
      <span class="filter-label">
        {{ t('Gross prem $M', '总权利金$M') }}
        <span class="filter-pair">
          <input type="number" id="f-prem-min" placeholder="min" step="0.1">
          <span class="sep">–</span>
          <input type="number" id="f-prem-max" placeholder="max" step="0.1">
        </span>
      </span>

      <span class="filter-label">
        {{ t('0DTE share %', '0DTE占比%') }}
        <span class="filter-pair">
          <input type="number" id="f-dte-min" placeholder="min" min="0" max="100">
          <span class="sep">–</span>
          <input type="number" id="f-dte-max" placeholder="max" min="0" max="100">
        </span>
      </span>

      <span class="filter-label">
        {{ t('Rel vol ×', '相对成交量×') }}
        <span class="help">?<span class="tip">{{ t(
          "Today's option volume vs the name's own 20-day average. 2× = double normal activity.",
          "当日期权成交量相对自身20日均值。2× = 为正常水平的两倍。"
        ) }}</span></span>
        <span class="filter-pair">
          <input type="number" id="f-relvol-min" placeholder="min" step="0.1">
          <span class="sep">–</span>
          <input type="number" id="f-relvol-max" placeholder="max" step="0.1">
        </span>
      </span>

      <span class="filter-label">
        {{ t('Put-skew pp', '认沽溢价pp') }}
        <span class="help">?<span class="tip">{{ t(
          'How much more expensive downside puts are vs at-the-money calls, in IV percentage points — higher = richer crash protection priced in.',
          '虚值认沽期权相对平值认购期权的IV溢价（百分点）——越高代表市场为下行风险定价越贵。'
        ) }}</span></span>
        <span class="filter-pair">
          <input type="number" id="f-skew-min" placeholder="min" step="0.1">
          <span class="sep">–</span>
          <input type="number" id="f-skew-max" placeholder="max" step="0.1">
        </span>
      </span>

      <span class="filter-label">
        {{ t('|Flip dist| % max', '|翻转距离|%上限') }}
        <span class="help">?<span class="tip">{{ t(
          'How far spot sits from the strike where dealer gamma flips sign — absolute value. ≤1% = very close to flip point.',
          '现价距Gamma符号翻转点的距离（绝对值）。≤1%代表非常接近翻转点。'
        ) }}</span></span>
        <span class="filter-pair"><input type="number" id="f-flip-max" placeholder="max" step="0.1" min="0"></span>
      </span>

      <span class="filter-label">
        {{ t('IV-spread pp', 'IV价差pp') }}
        <span class="help">?<span class="tip">{{ t(
          'IV-spread vs same-day peer group median. Positive = wider IV spread than peers. From ~30-day options.',
          '相对同日同业中位数的IV价差。正值 = IV价差高于同业。基于约30日期权。'
        ) }}</span></span>
        <span class="filter-pair">
          <input type="number" id="f-ivsp-min" placeholder="min" step="0.1">
          <span class="sep">–</span>
          <input type="number" id="f-ivsp-max" placeholder="max" step="0.1">
        </span>
      </span>
    </div>

  </div><!-- /filter-body -->
</div><!-- /filter-panel -->

<!-- ===== PRESET CHIPS ===== -->
