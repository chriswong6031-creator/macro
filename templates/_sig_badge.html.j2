{#- User-facing entry-status badge for the Standout grids. Detailed methodology belongs only
    on approved methodology surfaces; this shared partial exposes meaning and caution only. -#}
{%- if sig -%}{%- if sig.htf_s1 %}<span class="sig-gate sig-htf-s1" data-tip-en="Higher-timeframe support is present. Context only; not a buy signal." data-tip-zh="当前有较长周期的支撑。仅供参考，不是买入信号。"><span class="l-en">S1</span><span class="l-zh">S1</span></span>{% endif %}{%- endif -%}
{%- if sig and sig.eligible -%}
{%- set _tc = sig.tier_cascade -%}
{%- set _pending = (sig.sub == 'pending') -%}
{%- if _tc == 'T1' and not _pending -%}{%- set _k = 'take' -%}
{%- elif _tc == 'T1' and _pending -%}{%- set _k = 'pending' -%}
{%- elif _tc == 'T2' -%}{%- set _k = 't2' -%}
{%- elif _tc == 'T3' -%}{%- set _k = 't3' -%}
{%- elif _tc == 'T4' -%}{%- set _k = 't4' -%}
{%- else -%}{%- set _k = ('take' if sig.tier == 'take' else (sig.sub or 'early')) -%}{%- endif -%}
{%- set _style = {'take':'take','pending':'pending','t2':'t2','t3':'early','t4':'early','early':'early'}[_k] -%}
{%- set _glyph = {'take':'✓','pending':'◔','t2':'★','t3':'⋯','t4':'·','early':'⋯'}[_k] -%}
{%- set _en = {'take':'CONFIRMED','pending':'CONFIRMING','t2':'PRIME','t3':'APPROACHING','t4':'FIRST SPARK','early':'APPROACHING'}[_k] -%}
{%- set _zh = {'take':'确认','pending':'确认中','t2':'最佳入场','t3':'临近','t4':'初现','early':'临近'}[_k] -%}
{%- set _why = {'take':'CONFIRMED: the entry read is active. Check the wider setup and your risk plan before acting.','pending':'CONFIRMING: the setup is improving but has not confirmed. Wait for it to hold.','t2':'PRIME: an early, higher-conviction entry window. It is not a promise.','t3':'APPROACHING: an early entry read that is not confirmed yet. It may change.','t4':'FIRST SPARK: the earliest and least-certain entry read. Treat it as a watch.','early':'APPROACHING: the entry read is close but not confirmed.'}[_k] -%}
{%- set _why_zh = {'take':'CONFIRMED（已确认）：入场判断已生效。操作前请结合整体布局和自己的风险计划。','pending':'CONFIRMING（确认中）：布局正在改善，但还没确认。等它站稳再说。','t2':'PRIME（最佳入场）：较早、信心较高的入场窗口。它不是承诺。','t3':'APPROACHING（临近）：较早的入场判断，尚未确认，仍可能变化。','t4':'FIRST SPARK（初现）：最早、也最不确定的入场判断。先放进观察列表。','early':'APPROACHING（临近）：入场判断已接近，但还没确认。'}[_k] -%}
<span class="sig-gate sig-{{ _style }}" data-tip-en="{{ _why }}{% if sig.provisional %} PROVISIONAL — this early read may change before it confirms.{% endif %} Confirm the sector, leadership and your stop before acting.{% if sig.asof %} · {{ sig.asof|e }}{% endif %}" data-tip-zh="{{ _why_zh }}{% if sig.provisional %} 暂定——这个较早的判断在确认前可能变化。{% endif %} 操作前请确认板块、龙头与止损。{% if sig.asof %} · {{ sig.asof|e }}{% endif %}">{{ _glyph }} <span class="l-en">{{ _en }}</span><span class="l-zh">{{ _zh }}</span>{%- if sig.provisional %} <span class="prov-flag" data-tip-en="Provisional — this early read may change before it confirms. Treat it as a watch, not an entry." data-tip-zh="暂定——这个较早的判断在确认前可能变化。请先观察，不要当作已确认的入场点。"><span class="l-en">provisional</span><span class="l-zh">暂定</span></span>{%- endif -%}</span>
{%- endif -%}
