{#- Validated-confluence buy-GATE badge for the Standout grids (every country). Expects
    `sig` = the compact engine/signal_gate verdict attached to the card row (row['signal']).
    Renders the owner's WEIGHTED tier cascade (TIERED_CASCADE.md): T1 master (held BUY or
    forming) -> T2 early -> T3 approaching (2D cross projected ~1-2d) -> T4 earliest. The
    tier·weight tag distinguishes them at a glance; the existing styles (take/pending/early)
    carry the colour so no new CSS is needed. A T3 additionally carries the PROVISIONAL
    "may repaint" flag (sig.provisional, W6 #22): it is projected off the incomplete 2D
    bucket and a measured 23.8% US / 15.1% CN of T3 fresh fires repaint when it completes
    (calibration/provisional_replay.json). Bilingual; one source of truth so all grids
    render identically. Renders nothing when not eligible. -#}
{%- if sig -%}{%- if sig.htf_s1 %}<span class="sig-gate sig-htf-s1" data-tip-en="S1 · 2-week + 3-day confluence — higher-timeframe sponsorship (display-only)" data-tip-zh="S1 · 2周+3日共振 — 高周期确认（仅展示）"><span class="l-en">S1</span><span class="l-zh">S1</span></span>{% endif %}{%- endif -%}
{%- if sig and sig.eligible -%}
{%- set _tc = sig.tier_cascade -%}
{%- set _pending = (sig.sub == 'pending') -%}
{%- if _tc == 'T1' and not _pending -%}{%- set _k = 'take' -%}
{%- elif _tc == 'T1' and _pending -%}{%- set _k = 'pending' -%}
{%- elif _tc == 'T2' -%}{%- set _k = 't2' -%}
{%- elif _tc == 'T3' -%}{%- set _k = 't3' -%}
{%- elif _tc == 'T4' -%}{%- set _k = 't4' -%}
{%- else -%}{%- set _k = ('take' if sig.tier == 'take' else (sig.sub or 'early')) -%}{%- endif -%}
{%- set _style = {'take':'take','pending':'pending','t2':'t2','t3':'early','t4':'early','early':'early'}[_k] -%}
{%- set _glyph = {'take':'✓','pending':'◔','t2':'◑','t3':'⋯','t4':'·','early':'⋯'}[_k] -%}
{%- set _en = {'take':'BUY','pending':'forming','t2':'early✓','t3':'approaching','t4':'earliest','early':'approaching'}[_k] -%}
{%- set _zh = {'take':'买入','pending':'形成中','t2':'提前✓','t3':'临近','t4':'最早','early':'临近'}[_k] -%}
{%- set _why = {'take':'3D MACD-RSI × 3D StochRSI confluence, buy-filter endorsed — the master confirmation.','pending':'master confluence buy just fired; forward reclaim-and-hold confirmation pending.','t2':'T2 — confirmed early entry: 2-day RSI-MACD cross completed + 3-day StochRSI support. Historically fires days ahead of the T1 master confirmation and fills closer to the recent trough; completed-bar signal with low repaint.','t3':'3D StochRSI already crossed and the 2D MACD-RSI cross is PROJECTED within ~1–2 days — an early PREDICTION, not yet confirmed. May repaint — roughly 1 in 4 US fires (1 in 7 CN) un-cross within 4 sessions.','t4':'2D MACD-RSI projected + 2D StochRSI crossed, above the 200-day MA — the EARLIEST tier (lowest weight, anti-falling-knife).','early':'2D-MACD pre-cross advance-warning.'}[_k] -%}
{%- set _why_zh = {'take':'3日MACD-RSI×3日StochRSI全面共振，买入过滤器已背书——主确认信号。','pending':'主层买入共振刚刚触发；等待向前的收复确认。','t2':'T2 — 已确认的提前入场层：2日RSI-MACD已完成金叉 + 3日StochRSI支持。历史上通常领先T1主确认数日、成交价更贴近近期低点；基于已完成K线、重绘率低。','t3':'3日StochRSI已上穿，2日MACD-RSI预计在约1–2日内交叉——提前预判，尚未确认。可能重绘——美股约四分之一（A股约七分之一）的信号会在4个交易日内取消交叉。','t4':'2日MACD-RSI预投影 + 2日StochRSI已上穿，且在200日均线上方——最早层（权重最低，防止追跌刀）。','early':'2日MACD预交叉提前警示。'}[_k] -%}
<span class="sig-gate sig-{{ _style }}" data-tip-en="{{ _why }}{% if sig.tier_cascade %} Tier {{ sig.tier_cascade }} · weight {{ sig.weight }}.{% endif %}{% if sig.tier_sub %} {{ 'deep-oversold' if sig.tier_sub == 'deep' else 'shallow pullback' }} cross.{% endif %}{% if sig.bars_to_cross is not none %} ~{{ sig.bars_to_cross }} 2D-bars to the cross.{% endif %}{% if sig.provisional %} PROVISIONAL — projected off the incomplete 2D bucket and may repaint when it completes: a measured 23.8% of US T3 fresh fires (41/172) and 15.1% of CN (8/53) vanish within 4 sessions (calibration/provisional_replay.json, W6 #22).{% endif %} ONE door — confirm sector/leadership + your stop before acting.{% if sig.state %} · {{ sig.state|e }}{% endif %}{% if sig.asof %} · {{ sig.asof|e }}{% endif %}" data-tip-zh="{{ _why_zh }}{% if sig.tier_cascade %} 层级{{ sig.tier_cascade }}·权重{{ sig.weight }}。{% endif %}{% if sig.provisional %}T3为暂定评级：基于未完成的2日K线桶预测，桶完成后可能重绘（实测美股23.8%、中国15.1%的T3新信号消失）。{% endif %} 一扇门——操作前请确认板块/龙头与止损。{% if sig.state %} · {{ sig.state|e }}{% endif %}{% if sig.asof %} · {{ sig.asof|e }}{% endif %}">{{ _glyph }} <span class="l-en">{{ _en }}</span><span class="l-zh">{{ _zh }}</span>{%- if sig.tier_cascade %} <span class="sig-w">{{ sig.tier_cascade }}·{{ '%.1f'|format(sig.weight) }}</span>{%- endif -%}{%- if sig.provisional %} <span class="prov-flag" data-tip-en="Provisional — may repaint. This T3 grade is projected off the INCOMPLETE 2-day bucket; when the bucket completes, a measured 23.8% of US T3 fresh fires (41/172) and 15.1% of CN (8/53) un-cross or veto-flicker within 4 sessions (calibration/provisional_replay.json, W6 #22). T1/T2 measured 5.3%/8.8% — below the flip criterion, unflagged." data-tip-zh="暂定 — 可能重绘：该T3评级基于未完成的2日K线桶预测；桶完成后，实测美股23.8%（41/172）、中国15.1%（8/53）的T3新信号在4个交易日内消失。"><span class="l-en">provisional</span><span class="l-zh">暂定</span></span>{%- endif -%}</span>
{%- endif -%}
