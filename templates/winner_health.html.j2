} %}
{# One number governs scale (§3.3). Above it, the CALM group rolls up (its
   absence is itself the complete reading) and the AGING groups go compact —
   dropping the picture, never the reading. #}
{% set BIG_GROUP = 55 %}

{% set WH = wh if (wh is defined and wh is not none) else none %}
{# §8 contract note 1, MANDATORY: a top-level `states` with no `tiers` renders as
   the primary tier ALONE. That keeps every existing fixture valid and means a
   half-migrated builder degrades to today's page rather than to a blank one. #}
{% set TIERS = (WH.tiers if (WH and WH.tiers) else ([{
     'key':'primary', 'readable':True, 'figure':'r126',
     'library':(WH.library if (WH and WH.library) else {}),
     'states':(WH.states if (WH and WH.states) else {}),
     'theme_counts':(WH.theme_counts if WH else none)}] if WH else [])) %}
{# Page-level `warm` is the ONLY page-scale null and it pre-empts every tier
   state (§4.10 row 1). #}
{% set MODE = 'warm' if (not WH or WH.null_state) else 'board' %}
{# The page-scale flatline signature renders only when ALL THREE tiers are clear,
   so the quiet-night picture stays rare and stays memorable (§4.8). #}
{% set ns_all = namespace(clear=true, maxn=0, any=false) %}
{% for T in TIERS %}
  {%- set st = T.states or {} -%}
  {%- set _n1 = (st.get('extended_healthy') or []) | length -%}
  {%- set _n2 = (st.get('extended_watch') or []) | length -%}
  {%- set _n3 = (st.get('thinning') or []) | length -%}
  {%- set _n4 = (st.get('breaking') or []) | length -%}
  {%- set _n0 = (st.get('no_read') or []) | length -%}
  {%- set _nt = _n1 + _n2 + _n3 + _n4 + _n0 -%}
  {%- if _nt > ns_all.maxn %}{% set ns_all.maxn = _nt %}{% endif -%}
  {%- if _nt %}{% set ns_all.any = true %}{% endif -%}
  {%- if (not T.readable) or (_n2 + _n3 + _n4 + _n0) > 0 or _nt == 0 %}{% set ns_all.clear = false %}{% endif -%}
{% endfor %}
{% set ALL_CLEAR = ns_all.clear and ns_all.any %}
