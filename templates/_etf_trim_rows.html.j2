{# ── M6a "Being trimmed" — the secondary graded shelf ────────────────────────
   Renders the whole <details> block, because on the gated build the shelf does
   not exist at all (nothing free to head it) and hydration has to put back the
   entitled build's exact markup — summary included.

   Params: `rows` (trims). No tier logic. #}
{% from "_etf_macros.html.j2" import t, logo, spark, stance, money, srcword %}
{% from "_icons.html.j2" import icon %}
<details>
  <summary><span class="sh-ic">{{ icon('profits') }}</span>{{ t('Being trimmed', '正在减持') }} <span class="sh-sub">— {{ t('what managers are cutting — a weaker tell than buying', '经理人正在削减的仓位——其信号强度弱于买入') }}</span><span class="sh-caret">▸</span></summary>
  <div class="sh-body">
    <div class="atbl-wrap">
    <table class="atbl">
      <thead><tr>
        <th>{{ t('stock', '个股') }}</th><th>{{ t('fund · theme', '基金 · 主题') }}</th>
        <th class="r">{{ t('conviction cut', '信念削减') }}</th><th class="hide-sm">{{ t('trend', '走势') }}</th><th>{{ t('what to do', '如何应对') }}</th>
      </tr></thead>
      <tbody>
      {% for r in rows %}
      {% set cp = r.conviction_pp or 0 %}
      <tr>
        <td><div class="stock-cell">{{ logo(r.ticker) }}<span class="st-txt"><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a><span class="nm">{{ clean_name(r.name) }}</span></span></div></td>
        <td class="fundcell"><b>{{ r.etf }}</b>{% if r.is_active %} <i class="am" data-tip-en="Actively managed fund — a person chooses the holdings, so its moves are picks rather than flows" data-tip-zh="主动管理基金——持仓由经理人挑选，其动作属于选股而非资金流">{{ t('active', '主动') }}</i>{% endif %}<br><span class="themetag">{{ td(r.category) if r.category else (td(r.sector) if r.sector else '—') }}</span></td>
        <td class="r"><span class="conv d">{{ "%+.2f" | format(cp) }}<i>pp</i></span>{% if r.is_exit %} <span class="mini exit">{{ t('all out', '清仓') }}</span>{% endif %}
          <div class="tsz">{{ money(r.get('total_usd'), r.get('mv_available', true)) }}{{ srcword(r.get('driver')) }}</div>
        </td>
        <td class="hide-sm">{{ spark(r.weight_series) }}</td>
        <td>{{ stance(r.stance) }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </div>
</details>
