{% set nav_prefix = '../' %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ group_name }} — Subsector Confluence</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="../theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 'Inter',-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:20px 0 30px; }
  a { text-decoration:none; color:inherit; }
  .wrap { padding:14px 16px; }
  @media (min-width:1100px){ .wrap{ padding:16px max(28px,calc((100vw - 1320px)/2)); } }
  .back { color:var(--muted); font-size:12.5px; display:inline-block; margin:2px 2px 12px; }
  .dh { display:flex; flex-wrap:wrap; align-items:flex-start; gap:8px 18px; margin:2px 2px 6px; }
  .dh h1 { font-size:22px; margin:0; font-weight:800; letter-spacing:-.015em; }
  .dh .sct { color:var(--muted); font-size:12px; margin-top:3px; text-transform:uppercase; letter-spacing:.03em; }
  .dh .badges { display:flex; gap:7px; align-items:center; margin-left:auto; flex-wrap:wrap; }
  .tier { font-weight:800; font-size:12px; padding:2px 8px; border-radius:6px; color:#fff; }
  .tier.T1{ background:var(--up); } .tier.T2{ background:#3da564; } .tier.T3{ background:var(--info); } .tier.T4{ background:#6b7cc4; } .tier.none{ background:var(--g-mid); color:var(--muted); }
  .pill { font-size:11px; font-weight:700; padding:2px 9px; border-radius:10px; border:1px solid var(--line); }
  .pill.buy{ color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,transparent); }
  .pill.avoid{ color:var(--down); border-color:color-mix(in srgb,var(--down) 45%,transparent); }
  .pill.neutral{ color:var(--muted); } .pill.tactical,.pill.late{ color:var(--orange); }
  .action { color:var(--text); font-size:13px; background:var(--panel); border:1px solid var(--line); border-left:3px solid var(--link); border-radius:9px; padding:9px 12px; margin:10px 2px 4px; max-width:108ch; }
  .stats { display:flex; flex-wrap:wrap; gap:6px 18px; color:var(--muted); font-size:11.5px; margin:8px 2px 14px; }
  .stats b { color:var(--text); font-weight:600; }
  .chart-card { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:8px; margin:6px 0 18px; }
  #chart-host { width:100%; min-height:420px; }
  h2 { font-size:15px; font-weight:700; margin:18px 2px 8px; }
  table.tbl { width:100%; border-collapse:collapse; font-size:12.5px; }
  table.tbl th { text-align:left; color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.03em; padding:6px 9px; border-bottom:1px solid var(--line); white-space:nowrap; }
  table.tbl td { padding:7px 9px; border-bottom:1px solid var(--line); white-space:nowrap; }
  table.tbl tr:hover td { background:var(--panel); }
  .tk { font-weight:700; } .num { font-variant-numeric:tabular-nums; } .pos{ color:var(--up); } .neg{ color:var(--down); }
  tr.buyable td { background:color-mix(in srgb,var(--up) 7%,transparent); }
  .foot { color:var(--muted); font-size:11px; margin:22px 2px 0; line-height:1.6; max-width:108ch; border-top:1px solid var(--line); padding-top:12px; }
</style>
</head>
<body>
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <a class="ai-brief-link" href="{{ back_href | default('../subsectors.html') }}">💫 {{ t('All subsectors', '全部子行业') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language"><span class="pill"></span><span class="opt en-opt" data-l="en">EN</span><span class="opt zh-opt" data-l="zh">中文</span></div>
  </div>
</nav>

<div class="wrap">
  <a class="back" href="{{ back_href | default('../subsectors.html') }}">← {{ t('Subsector Confluence', '子行业汇聚') }}</a>
  <div id="app"></div>
</div>

<footer class="site-footer">
  <span class="made">© 2026 Mastermind Inc</span>
</footer>

<script src="../lightweight-charts-v5.js"></script>
<script src="../chart.js"></script>
<script>
const DETAIL = {{ detail_json|safe }};
const CHART_KEY = {{ (chart_key | tojson) if chart_key else 'null' }};
const HAS_SIGNALS = {{ 'true' if has_signals else 'false' }};
const L = (en, zh) => `<span class="l-en">${en}</span><span class="l-zh">${zh == null ? en : zh}</span>`;
const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const tierB = t => `<span class="tier ${t || 'none'}">${t || '—'}</span>`;
const sgn = (x, d = 1) => (x == null || isNaN(x)) ? '<span class="num">–</span>' : `<span class="num ${x >= 0 ? 'pos' : 'neg'}">${x >= 0 ? '+' : ''}${Number(x).toFixed(d)}</span>`;

function render() {
  const g = DETAIL.group || {}, e = g.entry || {}, r = g.regime || {};
  const app = document.getElementById('app');
  const cls = g['class'];
  const badge = e.tier ? tierB(e.tier) + (e.buyable ? ' <span class="pill buy">' + (cls === 'forming' ? 'FORMING' : 'ENTRY-NOW') + '</span>' : '') : '';
  const reg = `<span class="pill ${r.side || 'neutral'}">${esc(r.label || r.state || '—')}</span>`;
  const nP = g.n_priced || g.n_members;
  const thin = g.reliability === 'low' ? `<span class="pill late" title="fewer than 6 priced members — an equal-weight index this thin is driven by 1–2 names">⚠ ${L('thin · ' + nP + ' names', '偏薄 · ' + nP + ' 只')}</span>` : '';
  const kindLabel = DETAIL.kind_label_en ? L(DETAIL.kind_label_en, DETAIL.kind_label_zh || DETAIL.kind_label_en)
    : DETAIL.kind === 'concept' ? L('同花顺 concept basket', '同花顺概念篮子')
    : DETAIL.kind === 'basket' ? L('thematic basket', '主题篮子')
    : DETAIL.kind === 'sector' ? L('amalgamated complex', '汇聚综合体')
    : L('S&amp;P 500 sub-industry', '标普500子行业');
  let h = `<div class="dh"><div><h1>${esc(g.label)}${g.label_zh ? ` <span style="color:var(--muted);font-weight:600;font-size:.66em">${esc(g.label_zh)}</span>` : ''}</h1><div class="sct">${esc(g.sector_zh || g.sector)} · ${kindLabel}</div></div>`
    + `<div class="badges">${badge} ${reg} ${thin}</div></div>`;
  if (thin) h += `<div class="action" style="border-left-color:var(--orange)">${L('⚠ Low-confidence: this concept has fewer than 6 priced members, so the equal-weight index is driven by 1–2 stocks and its tier &amp; regime read is high-variance. Judge the members individually.', '⚠ 低可信：该概念有价成分少于6只，等权指数由1-2只个股主导，层级与状态读数高波动。请逐一判断成分股。')}</div>`;
  if (r.action) h += `<div class="action">${esc(r.action)}${e.reason ? ' · <span style="color:var(--muted)">' + esc(e.reason) + '</span>' : ''}</div>`;
  h += `<div class="stats">`
    + `<span>${L('as of', '截至')} <b>${esc(g.as_of)}</b></span>`
    + `<span>${L('members', '成分')} <b>${g.n_priced || g.n_members}</b>${g.n_members && g.n_priced && g.n_priced !== g.n_members ? '/' + g.n_members : ''}</span>`
    + (r.rsi_3d != null ? `<span>3D RSI <b>${Math.round(r.rsi_3d)}</b> · StochRSI <b>${Math.round(r.stoch_3d)}</b></span>` : '')
    + (e.ticks != null ? `<span>${L('cross age', '交叉时长')} <b>${e.ticks} ${L('tick(s)', '格')}</b></span>` : '')
    + (e.bars_to_cross != null ? `<span>${L('to cross', '距交叉')} <b>~${e.bars_to_cross}</b></span>` : '')
    + (r.rs_60d != null ? `<span>RS60 ${sgn(r.rs_60d)}</span>` : '')
    + (e.above200 != null ? `<span>${e.above200 ? L('above 200d ✓', '在200日上方 ✓') : L('below 200d', '在200日下方')}</span>` : '')
    + `</div>`;
  h += `<div class="chart-card"><div id="chart-host"></div><div style="color:var(--muted);font-size:10.5px;padding:4px 6px">${L('Equal-weight synthetic index (level rebased to 1.0 at first bar). BUY/SELL/cut markers = the confluence cascade read on this index — display only.', '等权合成指数（首根归一为1.0的水平）。买/卖/止损标记 = 本指数上的汇聚级联研判——仅供展示。')}</div></div>`;

  // member table
  const ms = g.members || [];
  if (ms.length) {
    h += `<h2>📊 ${L('Members — which names are firing', '成分——哪些个股在触发')}</h2>`;
    h += `<table class="tbl"><thead><tr><th>${L('Ticker', '代码')}</th><th>${L('Price', '价格')}</th><th>${L('Own tier', '自身层级')}</th><th>${L('20d', '20日')}</th><th>${L('vs subsector', '相对子行业')}</th><th>${L('Regime', '状态')}</th></tr></thead><tbody>`;
    h += ms.map(m => `<tr class="${m.stock_buyable ? 'buyable' : ''}"><td class="tk"><a href="${DETAIL.stock_base || '../stock.html#'}${encodeURIComponent(m.ticker)}">${esc(m.ticker)}</a>${m.name_zh ? ` <span style="color:var(--muted);font-weight:400;font-size:.85em">${esc(m.name_zh)}</span>` : ''}</td>`
      + `<td class="num">${m.price == null ? '–' : m.price.toFixed(2)}</td>`
      + `<td>${tierB(m.stock_tier)}</td>`
      + `<td>${sgn(m.ret_20d)}</td>`
      + `<td>${sgn(m.vs_basket)}</td>`
      + `<td style="color:var(--muted);font-size:11px">${esc(m.stock_state || '')}${m.behaves_as && m.behaves_as.home_id !== (g.basket_id || g.key) ? ` · <span class="pill behavesas" title="${esc((m.behaves_as.homes || []).map(h => h.label + ' r20 ' + (h.corr20 == null ? '–' : h.corr20.toFixed(2))).join('; '))}">↔ ${L('behaves-as ' + esc(m.behaves_as.home_label || ''), '类同 ' + esc(m.behaves_as.home_label_zh || m.behaves_as.home_label || ''))}</span>` : ''}</td></tr>`).join('');
    h += `</tbody></table>`;
  }
  h += `<div class="foot">${L('Equal-weight, today’s membership (descriptive, survivorship-tinted — not an out-of-sample backtest). EOD daily; calendar 3D buckets. Leak-free cascade. One door — confirm before acting; not alpha.', '等权，当前成分（描述性，含幸存者偏差——非样本外回测）。日终数据；日历三日分桶。无未来函数级联。仅一道门——行动前请确认；非阿尔法。')}</div>`;
  app.innerHTML = h;

  if (CHART_KEY && window.StockChart) {
    try {
      window.StockChart.mount(document.getElementById('chart-host'), CHART_KEY, {
        name: g.label, ohlcDir: '../' + (DETAIL.ohlc_dir || 'subsectorohlc'),
        signalsDir: HAS_SIGNALS ? '../' + (DETAIL.sig_dir || 'subsector_signals') : undefined
      });
    } catch (err) { console.error('chart mount failed', err); }
  }
}
render();
document.addEventListener('langchange', render);
</script>
<script src="../theme.js"></script>
</body>
</html>
