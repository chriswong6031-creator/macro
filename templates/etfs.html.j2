              {'rows': fl_theme, 'en': 'Theme funds', 'zh': '主题基金',
               'ren': 'read on where the money goes', 'rzh': '看资金流向哪里'},
              {'rows': fl_sector, 'en': 'Sector funds', 'zh': '行业基金',
               'ren': 'read on where the money goes', 'rzh': '看资金流向哪里'}] -%}
        {%- if grp.rows %}
        <div class="fl-g">
          <div class="fl-gh"><span class="fl-gn">{{ t(grp.en, grp.zh) }}</span><span class="fl-gc">{{ grp.rows | length }}</span><span class="fl-gr">{{ t(grp.ren, grp.rzh) }}</span></div>
          <div class="fl-list">
          {%- for c in grp.rows|sort(attribute='fund') -%}
          {#- a fund whose registry name IS its ticker (the ARK feeds) prints the
              ticker once, not twice -#}
          <span class="fu {% if not c.n_snapshots %}s0{% elif c.stale_days is not none and c.stale_days <= 3 %}s1{% elif c.stale_days is not none and c.stale_days <= 10 %}s2{% else %}s3{% endif %}"><b>{{ c.fund }}</b><span>{% if c.fund_name and c.fund_name != c.fund %}{{ c.fund_name }}{% endif %}</span>{% if c.unofficial %}<u>{{ t('3rd', '第三方') }}</u>{% endif %}{% if c.stale_days and c.stale_days > 3 %}<u>{{ c.stale_days }}d</u>{% endif %}<i>{{ c.n_snapshots }}</i></span>
          {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
        {%- endfor %}
        {% else %}<p class="muted" style="margin:14px 0 0">{{ t('No funds registered in the coverage directory yet.', '覆盖目录中尚未登记任何基金。') }}</p>{% endif %}
      </div>
    </details>
  </section>

{# ═══════════════ disclosure ═══════════════ #}
  {# "DISPLAY context" / "展示性背景" was internal tier vocabulary on a page that
