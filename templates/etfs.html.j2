<link rel="stylesheet" href="theme.css">
<style>
/* ═══ tokens: layered on theme.css (dark default) — components inherit light/dark ═══ */
:root{--card:var(--panel);--grid:var(--line);--ink:#eef2f7;
  --faint:color-mix(in srgb,var(--muted) 72%,var(--bg));
  --amber:#fbbf24;--teal:#2dd4bf;--ch-a:#8b96f8;--ch-b:#2dd4bf;--ch-c:#fbbf24;
  --lift:#54c39a;--drag:#e58a97;--accent:var(--ch-b);
  /* glass surface tokens for the tier wall's floating card. special_situations
     defines these locally too — theme.css ships no --surface family, so pasting
     the wall CSS without them renders a transparent-but-working card, which is
     exactly the failure mode a review misses (W2 spec §B3.2). Dark first: this
     :root IS the dark default on this page. */
  --surface: color-mix(in srgb, var(--card) 80%, transparent);
  --surface-brd: color-mix(in srgb, var(--text) 13%, transparent);
  --surface-shadow: 0 20px 52px -22px rgba(3,7,18,.66), 0 6px 18px -10px rgba(3,7,18,.44),
                    inset 0 1px 0 color-mix(in srgb,#fff 7%,transparent)}
html[data-theme="light"]{--ink:#141b26;--faint:color-mix(in srgb,var(--muted) 82%,var(--bg));
  --amber:#b45309;--teal:#0f766e;--ch-a:#4559dc;--ch-b:#0f766e;--ch-c:#b45309;
  --lift:#2f9270;--drag:#c65b6e;
  --surface: color-mix(in srgb, var(--card) 72%, transparent);
  --surface-brd: color-mix(in srgb, var(--ink) 12%, transparent);
  --surface-shadow: 0 14px 36px -20px rgba(20,32,64,.22), 0 4px 12px -6px rgba(20,32,64,.12),
                    inset 0 1px 0 rgba(255,255,255,.72)}
/* zh 红涨绿跌 (operator ruling): accumulate/trim are DIRECTION reads → swap. */
html[data-lang="zh"]{--lift:#e58a97;--drag:#54c39a}
html[data-theme="light"][data-lang="zh"]{--lift:#c65b6e;--drag:#2f9270}
*{box-sizing:border-box}
body{margin:0;padding:18px 0 0;background:var(--bg);color:var(--text);
  font-family:var(--font-ui),Inter,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 64px}
a{color:var(--link);text-decoration:none}
.faint{color:var(--faint)}.muted{color:var(--muted)}
.pos{color:var(--lift)}.neg{color:var(--drag)}

/* ═══ hero ═══ */
.eh{padding:26px 0 6px;animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.eh-brand{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.eh-brand h1{margin:0;font-size:25px;font-weight:800;letter-spacing:-.022em;color:var(--ink)}
.eh-brand .gn{background:linear-gradient(94deg,var(--ch-a),var(--ch-b) 52%,var(--ch-c));-webkit-background-clip:text;background-clip:text;color:transparent}
.eh-brand .tag{font-size:13px;color:var(--muted)}
.eh-verdict{font-size:clamp(20px,3vw,28px);font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1.3;margin:16px 0 8px;max-width:920px}
.eh-verdict b{background:linear-gradient(94deg,var(--ch-a),var(--ch-b) 60%,var(--ch-c));-webkit-background-clip:text;background-clip:text;color:transparent}
/* T5 stance line — the free build's Law-1 read, from rotation context only.
   Its highlight IS directional (risk-on / risk-off), so it rides --lift/--drag
   and flips correctly under 中文; the neutral case takes plain ink. */
.stance-line{font-size:16px;line-height:1.5;color:var(--ink);font-weight:600;margin:16px 0 8px;max-width:760px}
.stance-line .st.u{color:var(--lift)}.stance-line .st.d{color:var(--drag)}.stance-line .st.n{color:var(--ink)}
.eh-asof{display:block;font-size:12.5px;color:var(--muted);line-height:1.7}
.eh-asof .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--lift);animation:txBreathe 2.8s ease-in-out infinite;vertical-align:middle;margin-right:5px}
/* hero tiles */
.eh-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}
@media(max-width:760px){.eh-tiles{grid-template-columns:1fr}}
.tile{position:relative;background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:16px 18px;overflow:hidden;
  animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.tile:nth-child(2){animation-delay:.06s}.tile:nth-child(3){animation-delay:.12s}
.tile::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:var(--tc,var(--accent))}
.tile.t-lift{--tc:var(--lift)}.tile.t-drag{--tc:var(--drag)}.tile.t-accent{--tc:var(--ch-a)}.tile.t-neutral{--tc:var(--faint)}
/* the free build's honest-total tile: a count is not a direction, so it takes
   the brand link ink rather than an up/down one that 中文 would flip */
.tile.t-link{--tc:var(--link)}
.tile .tk{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.tile .tv{font-size:27px;font-weight:800;letter-spacing:-.02em;color:var(--ink);line-height:1.1;margin:5px 0 2px;font-variant-numeric:tabular-nums}
.tile .tm{font-size:12px;color:var(--faint);line-height:1.4}
.tile .tstance{margin-top:9px}

/* ═══ section chrome ═══ */
.sec{margin-top:38px}
.sec-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:0 0 3px}
.sec-head .sh-dot{width:8px;height:8px;border-radius:3px;background:var(--sc,var(--accent));align-self:center;flex:none}
.sec-head h2{margin:0;font-size:13px;font-weight:800;color:var(--ink);text-transform:uppercase;letter-spacing:.07em}
.sec-sub{font-size:13px;color:var(--muted);margin:0 0 15px;max-width:760px;line-height:1.5}
.card{background:var(--card);border:1px solid var(--grid);border-radius:18px;padding:20px 22px;position:relative;overflow:hidden;
  animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.card::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:var(--accent)}

/* ═══ stance pill ═══ */
.stpill{display:inline-flex;align-items:center;gap:6px;padding:4px 11px;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap;cursor:help;
  background:color-mix(in srgb,var(--sp,var(--muted)) 12%,var(--card));color:var(--sp,var(--muted));border:1px solid color-mix(in srgb,var(--sp,var(--muted)) 26%,var(--grid))}
.stpill .stdot{width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}
.st-act{--sp:var(--lift)}.st-act .stdot,.st-ready .stdot{animation:txBreathe 2.4s ease-in-out infinite}
.st-ready{--sp:var(--teal)}.st-watch{--sp:var(--link)}.st-trim{--sp:var(--amber)}.st-aside{--sp:var(--faint)}.st-ignore{--sp:var(--faint)}

/* ═══ breadth constellation ═══ */
.bdots{display:inline-flex;align-items:center;gap:3px;line-height:1}
.bdots i{width:9px;height:9px;border-radius:50%;display:inline-block;flex:none}
.bdots i.up{background:var(--lift)}.bdots i.dn{background:var(--drag)}
.bdots i.sep{width:1px;height:12px;border-radius:0;background:var(--grid);margin:0 2px}
.bdots i.ov{width:auto;height:auto;border-radius:0;font-size:10px;font-weight:800;color:var(--lift);font-style:normal;margin-left:1px}

/* ═══ pressure bar ═══ */
.pbar{position:relative;display:block;height:8px;background:color-mix(in srgb,var(--grid) 55%,var(--card));border-radius:999px;width:100%}
.pb-mid{position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--faint);opacity:.45}
.pb-fill{position:absolute;top:0;bottom:0;border-radius:999px;animation:txGrow .8s cubic-bezier(.2,.7,.3,1) both}
.pb-fill.u{left:50%;transform-origin:left;background:linear-gradient(90deg,color-mix(in srgb,var(--lift) 22%,transparent),color-mix(in srgb,var(--lift) 62%,transparent))}
.pb-fill.d{right:50%;transform-origin:right;background:linear-gradient(270deg,color-mix(in srgb,var(--drag) 22%,transparent),color-mix(in srgb,var(--drag) 62%,transparent))}

/* ═══ consensus board (signature) ═══ */
.cb-head,.cb-row{display:grid;grid-template-columns:30px minmax(148px,1.35fr) 116px minmax(116px,1fr) 168px;gap:16px;align-items:center}
.cb-head{padding:0 2px 9px;font-size:10.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--grid)}
.cb-head .r{text-align:right}
.cb-row{padding:12px 2px}
.cb-row+.cb-row{border-top:1px solid color-mix(in srgb,var(--grid) 62%,transparent)}
.cb-rank{font-size:14px;font-weight:800;color:var(--faint);font-variant-numeric:tabular-nums;text-align:center}
.cb-row:nth-child(-n+4) .cb-rank{color:var(--accent)}
.stock-cell{display:flex;align-items:center;gap:9px;min-width:0}
.stock-cell .st-txt{min-width:0}
.stock-cell .st-txt b{display:block;font-size:14px;color:var(--ink);line-height:1.15}
.stock-cell .st-txt .nm{display:block;font-size:11.5px;color:var(--muted);line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:190px}
.themetag{display:inline-block;margin-top:2px;padding:0 7px;border-radius:6px;font-size:10px;font-weight:700;letter-spacing:.01em;
  background:color-mix(in srgb,var(--muted) 13%,var(--card));color:var(--muted)}
.cb-net{text-align:right;font-variant-numeric:tabular-nums}
.cb-net .v{font-size:13.5px;font-weight:800}.cb-net .v.u{color:var(--lift)}.cb-net .v.d{color:var(--drag)}
.cb-pres{display:flex;flex-direction:column;gap:5px}
.cb-flags{display:flex;gap:5px;flex-wrap:wrap;margin-top:3px}
.mini{display:inline-block;padding:0 7px;border-radius:6px;font-size:10px;font-weight:800;letter-spacing:.02em}
.mini.new{background:color-mix(in srgb,var(--lift) 16%,var(--card));color:var(--lift)}
.mini.exit{background:color-mix(in srgb,var(--drag) 15%,var(--card));color:var(--drag)}
.mini.contested{background:color-mix(in srgb,var(--amber) 16%,var(--card));color:var(--amber)}
.mini.active{background:color-mix(in srgb,var(--ch-a) 15%,var(--card));color:var(--ch-a)}
/* the whose-conviction hover popover */
.cb-who{position:relative;display:inline-flex}
.cb-who .who-src{font-size:11px;color:var(--muted);cursor:help;border-bottom:1px dashed var(--grid)}
.cb-who .who-pop{display:none;position:absolute;left:0;top:20px;z-index:40;width:230px;padding:10px 12px;border-radius:11px;
  background:var(--card);border:1px solid var(--grid);box-shadow:0 14px 34px -14px rgba(9,17,40,.4);font-size:12px;line-height:1.5;color:var(--text)}
.cb-who:hover .who-pop{display:block}
.who-pop .wl{display:flex;justify-content:space-between;gap:10px;padding:2px 0}
.who-pop .wl b{color:var(--ink)}
.who-pop .wl .wv.u{color:var(--lift)}.who-pop .wl .wv.d{color:var(--drag)}
@media(max-width:720px){
  .cb-head{display:none}
  .cb-row{grid-template-columns:26px 1fr auto;gap:11px;row-gap:9px;padding:13px 2px}
  .cb-net,.cb-pres{grid-column:2/-1}
  .cb-stance-cell{grid-column:2/-1}
}

/* ═══ fresh conviction cards ═══ */
.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:14px}
.fc{position:relative;background:var(--card);border:1px solid var(--grid);border-radius:15px;padding:15px 16px;overflow:hidden;
  animation:txUp .5s cubic-bezier(.2,.7,.3,1) both}
.fc::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:var(--lift)}
.fc-top{display:flex;align-items:center;gap:9px}
.fc-top .st-txt b{display:block;font-size:14.5px;color:var(--ink);line-height:1.1}
.fc-top .st-txt .nm{display:block;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px}
.fc-mid{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:12px 0 9px}
.fc-mid .fund-n{font-size:12px;color:var(--muted)}
.fc-mid .fund-n b{color:var(--ink);font-weight:800}
.fc-conv{font-size:12px;font-weight:800;color:var(--lift);font-variant-numeric:tabular-nums}
.fc-funds{display:flex;flex-wrap:wrap;gap:4px;margin-top:2px}
.fchip{padding:1px 7px;border-radius:6px;font-size:10.5px;font-weight:700;background:color-mix(in srgb,var(--muted) 13%,var(--card));color:var(--muted)}
.fchip.act{background:color-mix(in srgb,var(--ch-a) 14%,var(--card));color:var(--ch-a)}
.fc-foot{margin-top:11px;padding-top:10px;border-top:1px solid color-mix(in srgb,var(--grid) 60%,transparent)}

/* ═══ rotation rail (market backdrop) ═══ */
.rr{display:grid;grid-template-columns:1.05fr 1.25fr 1.05fr;gap:16px}
@media(max-width:900px){.rr{grid-template-columns:1fr}}
.rrc{position:relative;background:var(--card);border:1px solid var(--grid);border-radius:18px;padding:19px 20px;overflow:hidden;
  animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.rrc:nth-child(2){animation-delay:.06s}.rrc:nth-child(3){animation-delay:.12s}
.rrc::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:var(--rc,var(--accent))}
.rrc.c-risk{--rc:var(--ch-a)}.rrc.c-sect{--rc:var(--ch-b)}.rrc.c-style{--rc:var(--ch-c)}
.rrc .rr-eyebrow{font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--rc,var(--accent))}
.rrc .rr-state{font-size:23px;font-weight:800;letter-spacing:-.02em;color:var(--ink);line-height:1.1;margin:8px 0 3px}
.rrc .rr-read{font-size:12px;color:var(--muted);line-height:1.45}
.rr-legs{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.leg{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:8px;font-size:11px;font-weight:600;background:color-mix(in srgb,var(--grid) 45%,var(--card));color:var(--text)}
.leg .ar{font-size:9px}.leg.u{color:var(--lift)}.leg.d{color:var(--drag)}
/* sector ladder */
.slad{display:flex;flex-direction:column;gap:7px;margin-top:11px}
.slad .sl{display:grid;grid-template-columns:20px 74px 1fr auto;gap:9px;align-items:center;font-size:12px}
.slad .sl .rk{font-size:10.5px;font-weight:800;color:var(--faint);text-align:center;font-variant-numeric:tabular-nums}
.slad .sl .nm{font-weight:700;color:var(--ink)}
.slad .sl .track{position:relative;height:7px;border-radius:999px;background:color-mix(in srgb,var(--grid) 55%,var(--card))}
.slad .sl .track i{position:absolute;left:50%;top:0;bottom:0;border-radius:999px;animation:txGrow .7s ease both}
.slad .sl .track i.u{transform-origin:left;background:color-mix(in srgb,var(--lift) 55%,transparent)}
.slad .sl .track i.d{right:50%;left:auto;transform-origin:right;background:color-mix(in srgb,var(--drag) 55%,transparent)}
.slad .sl .mv{font-size:11px;font-weight:700;font-variant-numeric:tabular-nums;text-align:right;min-width:44px}
.slad .sl .mv.u{color:var(--lift)}.slad .sl .mv.d{color:var(--drag)}
/* style tug-of-war */
.tug{display:flex;flex-direction:column;gap:11px;margin-top:6px}
.tug .tw{font-size:12px}
.tug .tw .lab{display:flex;justify-content:space-between;gap:8px;margin-bottom:4px}
.tug .tw .lab .nm{font-weight:700;color:var(--ink)}
.tug .tw .lab .ld{font-size:11px;font-weight:700;color:var(--ch-c)}
.tug .tw .bar{position:relative;height:8px;border-radius:999px;background:color-mix(in srgb,var(--grid) 55%,var(--card))}
.tug .tw .bar .mid{position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--faint);opacity:.4}
.tug .tw .bar i{position:absolute;left:50%;top:0;bottom:0;border-radius:999px;animation:txGrow .7s ease both;
  background:color-mix(in srgb,var(--ch-c) 48%,transparent)}
.tug .tw .bar i.u{transform-origin:left}
.tug .tw .bar i.d{right:50%;left:auto;transform-origin:right}

/* ═══ accumulation table ═══ */
.atbl{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.atbl th{text-align:left;padding:0 10px 9px;font-size:10.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--grid)}
.atbl td{padding:10px;border-bottom:1px solid color-mix(in srgb,var(--grid) 60%,transparent);vertical-align:middle}
.atbl tr:last-child td{border-bottom:none}
.atbl th.r,.atbl td.r{text-align:right}
.atbl .conv{font-weight:800}.atbl .conv.u{color:var(--lift)}.atbl .conv.d{color:var(--drag)}
.fundcell b{color:var(--ink)}
.atbl-wrap{overflow-x:auto}
@media(max-width:640px){.atbl .hide-sm{display:none}}

/* ═══ shelf (trims / coverage) ═══ */
.shelf details{background:var(--card);border:1px solid var(--grid);border-radius:16px;margin-bottom:12px;overflow:hidden}
.shelf summary{list-style:none;cursor:pointer;padding:15px 20px;display:flex;align-items:center;gap:12px;font-size:14px;font-weight:700;color:var(--ink);transition:background .18s}
.shelf summary::-webkit-details-marker{display:none}
.shelf summary:hover{background:color-mix(in srgb,var(--accent) 5%,var(--card))}
.shelf summary .sh-ic{flex:none;width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;background:color-mix(in srgb,var(--accent) 10%,var(--card))}
.shelf summary .sh-sub{font-weight:500;color:var(--muted);font-size:12.5px}
.shelf summary .sh-caret{margin-left:auto;flex:none;font-size:11px;color:var(--faint);transition:transform .25s}
.shelf details[open] summary .sh-caret{transform:rotate(90deg)}
.shelf .sh-body{padding:4px 20px 20px;border-top:1px solid var(--grid)}
.fdot{display:inline-block;width:9px;height:9px;border-radius:50%;vertical-align:middle;margin-right:6px}
/* Freshness is a DATA-QUALITY status, not a market direction. It must NOT ride
   --lift/--drag: those flip under html[data-lang="zh"] (红涨绿跌), which painted
   "fresh" red and "stale" green in the first ZH render of the W2 mockup. Fixed
   semantic inks, identical in both languages. Same rule for any pass/fail tint. */
.fdot.fresh{background:#1FA971}.fdot.aging{background:#f0b429}.fdot.stale{background:#e06464}
.fdot.none{background:var(--muted)}
.fstale{color:#e06464}
.tag3p{display:inline-block;padding:1px 7px;border-radius:6px;font-size:10px;font-weight:700;background:color-mix(in srgb,var(--muted) 13%,var(--card));color:var(--muted);border:1px solid var(--grid)}

/* ═══ disclosure ═══ */
.disc{font-size:12px;color:var(--muted);margin:30px 0 0;padding-top:16px;border-top:1px solid var(--grid);line-height:1.6}
.disc b{color:var(--ink)}

/* ═══ tk logo ═══ */
.tk-logo{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:6px;overflow:hidden;flex:0 0 26px;
  background:transparent}
.tk-logo img{width:26px;height:26px;object-fit:contain;display:block}
/* Fallback for a ticker with no CDN icon (the .png 404s → onerror swaps this in).
   At 9px the 4-character ticker overran the 26px tile and the parent's
   overflow:hidden sheared it on BOTH sides; size the type to the tile instead. */
.tk-fb{font-size:8px;font-weight:800;letter-spacing:-.04em;line-height:1;white-space:nowrap;color:var(--muted);align-items:center;justify-content:center;width:26px;height:26px}
.spark{display:inline-block;vertical-align:middle}

/* ═══ ? tip ═══ */
.txq{position:relative;display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;
  border:1px solid var(--grid);color:var(--muted);font-size:10px;font-weight:700;cursor:help;flex:none;margin-left:5px;vertical-align:middle}
.txq .txq-tip{display:none;position:absolute;top:22px;right:-8px;z-index:50;width:266px;padding:10px 12px;border-radius:11px;
  background:var(--card);border:1px solid var(--grid);box-shadow:0 14px 34px -14px rgba(9,17,40,.42);
  font-size:12px;font-weight:500;color:var(--text);line-height:1.5;text-transform:none;letter-spacing:0;text-align:left}
.txq:hover .txq-tip,.txq:focus .txq-tip{display:block}

/* ═══ tier gate (SEO Supercharge W2 — docs/TIER_PREVIEW_PATTERN.md) ═══
   Transliterated from the shipped special_situations idiom into THIS page's
   token vocabulary: --card / --grid are already aliased above, --blue becomes
   --link, and the --surface family is defined in :root. #8b5cf6 (the lock
   violet) stays a hard-coded hex, identical to the reference. The CTA gradient
   is brand blue → violet, NEVER signal amber (terminal paywall lesson).
   None of these elements carries directional colour: a gate is not a market
   read, so the 红涨绿跌 flip must not touch it. */
.gate-pill{margin-left:2px;padding:2px 8px;border-radius:999px;font-size:9.5px;font-weight:800;letter-spacing:.08em;
  color:#8b5cf6;background:color-mix(in srgb,#8b5cf6 13%,transparent);
  border:1px solid color-mix(in srgb,#8b5cf6 34%,transparent);text-transform:none}
@keyframes ghPulse{0%,100%{opacity:.45}50%{opacity:.85}}
.gh{border-radius:6px;background:linear-gradient(90deg,var(--grid),color-mix(in srgb,var(--grid) 45%,transparent));
  animation:ghPulse 2.4s ease-in-out infinite}
/* consensus-board skeletons — the walled board's shape, none of its content */
.cb-ghosts{border:1px solid var(--grid);border-radius:14px;overflow:hidden;background:var(--card)}
.cbg-hd,.cbg-row{display:grid;grid-template-columns:34px 1.7fr 1fr 1.5fr 1.05fr;gap:14px;align-items:center}
.cbg-hd{padding:10px 16px;border-bottom:1px solid var(--grid);font-size:9.5px;font-weight:800;letter-spacing:.09em;
  text-transform:uppercase;color:var(--faint)}
.cbg-row{padding:13px 16px;border-bottom:1px solid color-mix(in srgb,var(--text) 6%,transparent)}
.cbg-row:last-child{border-bottom:0}
.gh-rank{width:15px;height:12px}
.gh-tkr{width:48px;height:12px;margin-bottom:6px}
.gh-nm{width:78%;height:9px}
.gh-dots{width:66px;height:10px}
.gh-bar{width:100%;height:9px}
.gh-pill{width:96px;height:20px;border-radius:999px}
@media(max-width:720px){.cbg-hd{display:none}.cbg-row{grid-template-columns:26px 1fr;row-gap:9px}}
/* gate note — it EXPLAINS, it never sells. No CTA button lives here. */
.gate-note{display:flex;align-items:flex-start;gap:8px;margin:0 0 14px;padding:11px 14px;border-radius:12px;
  font-size:12.5px;line-height:1.5;color:var(--muted);
  background:color-mix(in srgb,#8b5cf6 7%,transparent);border:1px solid color-mix(in srgb,#8b5cf6 22%,transparent)}
.gate-note svg{width:14px;height:14px;flex:none;margin-top:2px;color:#8b5cf6}
.gate-note a{color:var(--link)}
/* the page's ONE tier wall, at "Every add, by fund" — after the free backdrop */
.tier-wall{position:relative;margin:6px 0 4px;isolation:isolate}
.tw-ghosts{display:flex;flex-direction:column;gap:10px;padding-top:4px}
.tw-ghost{border:1px solid var(--grid);border-radius:14px;background:color-mix(in srgb,var(--card) 55%,transparent);
  padding:18px 20px}
.tw-ghost .gh-tkr{width:64px;height:14px;margin-bottom:11px}
.tw-ghost .gh-line{width:70%;height:10px;margin-bottom:8px}
.tw-ghost .gh-line.short{width:38%;margin-bottom:0}
.tw-card{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(560px,94%);text-align:center;
  padding:30px 30px 26px;border-radius:20px;background:var(--surface);border:1px solid var(--surface-brd);
  box-shadow:var(--surface-shadow);-webkit-backdrop-filter:saturate(180%) blur(22px);backdrop-filter:saturate(180%) blur(22px)}
.tw-lock{width:28px;height:28px;color:#8b5cf6;margin-bottom:12px}
.tw-h{font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink);line-height:1.25;margin-bottom:9px}
.tw-p{font-size:13px;line-height:1.6;color:var(--muted);max-width:450px;margin:0 auto 18px}
.tw-acts{display:flex;flex-direction:column;align-items:center;gap:8px}
.tw-btn{display:inline-flex;align-items:center;justify-content:center;padding:11px 26px;border-radius:12px;
  text-decoration:none;font-size:13.5px;font-weight:700;color:#fff;
  background:linear-gradient(135deg,var(--link),#8b5cf6);
  box-shadow:0 8px 22px -10px color-mix(in srgb,#8b5cf6 70%,transparent);transition:transform .18s,box-shadow .18s}
.tw-btn:hover{transform:translateY(-1px);box-shadow:0 12px 28px -10px color-mix(in srgb,#8b5cf6 80%,transparent)}
.tw-note{font-size:11px;color:var(--faint)}
.tw-signed{margin-top:12px;font-size:12px}
.tw-signed a{color:var(--link);text-decoration:none;border-bottom:1px solid color-mix(in srgb,var(--link) 40%,transparent)}
@media(max-width:900px){
  /* Below the ghost stack's usable width the absolute card overlaps the lede
     above it; drop the ghosts and let the card flow. */
  .tw-ghosts{display:none}
  .tw-card{position:static;transform:none;width:100%;padding:26px 20px 22px}
}

/* ═══ motion ═══ */
@keyframes txUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes txBreathe{0%,100%{opacity:.5;transform:scale(.82)}50%{opacity:1;transform:scale(1.12)}}
@keyframes txGrow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@media (prefers-reduced-motion:reduce){
  .eh,.tile,.card,.rrc,.fc{animation:none}
  .pb-fill,.slad .sl .track i,.tug .tw .bar i,.eh-asof .dot,.stdot{animation:none}
  /* the tier gate's skeleton shimmer is decorative — kill it by name, not by
     hoping the wildcard below covers animations (it only covers transitions) */
  .gh{animation:none}
  .tw-btn{transition:none}
  *{transition:none!important}
}
</style>
</head>
<body>

{% include "_site_nav.html.j2" %}

<div class="wrap">

{# ═══════════════ HERO ═══════════════ #}
  <header class="eh">
    <div class="eh-brand">
      <h1>🐳 {{ t('Real fund moves', '基金真实动作') }}</h1>
      <span class="tag">{{ t('where thematic & active managers are building conviction', '主题与主动经理人积累信念之处') }}</span>
    </div>
    {# Hero read. Entitled: the graded verdict line (which themes managers are
       building into) — that is a summary of the walled board, so the free build
       must not carry it. Free: the T5 stance line, derived from the rotation
       backdrop ONLY (public ETF ratio momentum), which is on this page in full
       and therefore checkable by the reader. Same mount either way so hydration
       restores the entitled line without moving the DOM. #}
    <div id="etf-hero-read">
      {%- if gate %}
      {%- if board and board.stance %}
      <p class="stance-line"><span class="st {{ board.stance.tone }}">{{ b(board.stance.head) }}</span> — {{ b(board.stance.rest) }}</p>
      {%- endif %}
      {%- elif board and board.verdict %}
      {{ hero_verdict(board.verdict) }}
      {%- endif %}
    </div>
    <div class="eh-asof"><span class="dot"></span>
      {% if board and board.coverage %}{{ t('Tracking', '追踪') }} <b>{{ board.coverage.funds }}</b>&nbsp;{{ t('curated & active funds', '精选与主动基金') }} · {% endif %}
      {{ t('updated each filing cycle', '每个披露周期更新') }} · {{ generated_utc }} UTC
      {{ help("Universe = curated THEMATIC / industry funds (SPDR sector, Global X, VanEck, First Trust, Sprott, Amplify, Defiance, Bitwise, Invesco, Roundhill) plus ACTIVELY managed funds (ARK). Broad-index trackers (SPY/QQQ) are excluded — their moves are reconstitution noise, not a curated read. We diff each fund's daily holdings, strip out mechanical creation/redemption flow AND the price move, and keep the manager's actual conviction per name, measured in percentage POINTS of fund weight committed. Cash & money-market lines are excluded. Lagged filing data — context, never a buy list.",
      "范围 = 精选主题／行业基金（SPDR 板块、Global X、VanEck、First Trust、Sprott、Amplify、Defiance、Bitwise、Invesco、Roundhill）加主动管理基金（ARK）。宽基指数基金（SPY/QQQ）已排除——其动作是再平衡噪音而非精选解读。我们比对每只基金的每日持仓，剔除机械性申购／赎回资金流及价格变动，留下经理人对每只个股的真实信念，以投入的基金权重百分点衡量。现金与货币市场科目已排除。此为滞后的披露数据——仅供参考，非买入清单。") }}
    </div>

    {# Three honest tiles — no ghost ever opens this page (T-B1). On the gated
       build the builder has already swapped tile 1 from the graded
       "Strongest consensus / <ticker> / <stance>" for the deterministic,
       non-graded total "On the board / {n} names"; tiles 2 and 3 are counts and
       rotation context, free either way. #}
    <div id="etf-hero-tiles">{% if board and board.tiles %}{{ hero_tiles(board.tiles) }}{% endif %}</div>
  </header>

{# ═══════════════ CONSENSUS BOARD (signature) ═══════════════ #}
  <section class="sec" style="--sc:var(--ch-b)">
    <div class="sec-head"><span class="sh-dot"></span>
      <h2>{{ t('The consensus board', '共识看板') }}</h2>
      {% if gate and gate.total %}<span class="gate-pill">{{ t('Essential', 'Essential') }}</span>{% endif %}</div>
    <p class="sec-sub">{{ t('Stocks the most funds are accumulating at once — a name many managers back together is a far stronger read than one fund’s bet. Sorted by how broad the agreement is, then how much conviction sits behind it.', '被最多基金同时增持的个股——多位经理人共同押注，其信号远强于单只基金的下注。先按共识广度排序，再看背后的信念规模。') }}</p>
    {# `gate.total` and not just `gate`: with a genuinely empty board there is
       nothing withheld, so the honest "Building —" state below must still be
       reachable on a gated build (B§9.11). #}
    {% if gate and gate.total %}
    {# It explains, it does not sell — the one ask lives at M5, after the reader
       has had the whole rotation backdrop for free. #}
    <div class="gate-note" id="etf-board-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span>
        <span class="l-en">{{ gate.total }} names sit on the board, ranked by how many funds are backing each one. Members see the names, the conviction behind them, and what we’d do about each. The rotation backdrop below is open to everyone.</span>
        <span class="l-zh">看板上共有 {{ gate.total }} 只个股，按增持基金数量排名。会员可查看个股名称、背后的信念规模，以及我们对每只个股的应对建议。下方的轮动情况对所有人开放。</span>
      </span>
    </div>
    {% endif %}
    <div id="etf-board-mount">
    {% if gate and gate.total %}
    <div class="cb-ghosts" aria-hidden="true">
      <div class="cbg-hd">
        <span>#</span>
        <span>{{ t('stock', '个股') }}</span>
        <span>{{ t('funds in', '参与基金') }}</span>
        <span>{{ t('net conviction', '净信念') }}</span>
        <span>{{ t('what to do', '如何应对') }}</span>
      </div>
      {% for _ in range(5) %}
      <div class="cbg-row"><div class="gh gh-rank"></div>
        <div><div class="gh gh-tkr"></div><div class="gh gh-nm"></div></div>
        <div class="gh gh-dots"></div><div class="gh gh-bar"></div><div class="gh gh-pill"></div></div>
      {% endfor %}
    </div>
    {% elif favored %}
    {% with rows = favored, scale = (board.scale.consensus_pp if board and board.scale else 1) %}{% include "_etf_board_rows.html.j2" %}{% endwith %}
    {% else %}
    {# Reachable ONLY on an ungated build: the {% if gate %} arm above owns the
       walled case. Left unguarded, this "Building —" line would print over 40
       rows that exist and are simply not free — an outright lie to the visitor
       we are asking to pay (docs/TIER_PREVIEW_PATTERN.md, empty-state trap). #}
    <div class="card"><p class="muted" style="margin:0">{{ t('Building — cross-fund consensus appears once at least two funds hold overlapping conviction on the same name.', '构建中 — 当至少两只基金对同一个股产生重叠信念后，跨基金共识即会显示。') }}</p></div>
    {% endif %}
    </div>
  </section>

{# ═══════════════ FRESH CONVICTION ═══════════════
   Walled and OMITTED on the gated build — heading included. A second ghost
   stack directly under the consensus board's would be nagging (Doctrine Law 4),
   and a heading with nothing under it is worse than no heading. The section
   still ships `hidden` so hydration can fill it and un-hide it in place,
   keeping the entitled DOM order identical to today's. #}
  {% if (board and board.fresh) or (gate and gate.has_fresh) %}
  <section class="sec" style="--sc:var(--lift)" id="etf-fresh-sec"{% if gate %} hidden{% endif %}>
    <div class="sec-head"><span class="sh-dot"></span>
      <h2>{{ t('Fresh conviction', '全新建仓') }}</h2></div>
    <p class="sec-sub">{{ t('Brand-new positions managers just opened this cycle — a manager starting a fresh stake is a stronger tell than adding to an old one.', '经理人本轮刚刚开立的全新仓位——开一笔新仓比加码旧仓更能说明问题。') }}</p>
    <div id="etf-fresh-mount">{% if not gate %}{% with rows = board.fresh %}{% include "_etf_fresh_cards.html.j2" %}{% endwith %}{% endif %}</div>
  </section>
  {% endif %}

{# ═══════════════ MARKET BACKDROP (rotation) ═══════════════ #}
  {% if board and board.rotation %}
  {% set ro = board.rotation %}
  <section class="sec" style="--sc:var(--ch-a)">
    <div class="sec-head"><span class="sh-dot"></span>
      <h2>{{ t('The market they’re buying into', '他们正买入的市场') }}</h2></div>
    <p class="sec-sub">{{ t('The rotation backdrop for every move above — accumulation into a supportive tape confirms; against it, be more skeptical. Descriptive momentum context, never a buy list.', '上述每一笔动作的轮动情况——顺势增持是确认，逆势增持则需更谨慎。描述性动量背景，非买入清单。') }}</p>
    <div class="rr">
      {# risk #}
      <div class="rrc c-risk">
        <div class="rr-eyebrow">{{ t('Risk backdrop', '风险环境') }}</div>
        <div class="rr-state">{{ b(ro.risk.label) }}</div>
        <div class="rr-read">{{ b(ro.risk.read) }}</div>
        <div class="rr-legs">
          {% for lg in ro.risk.legs %}
          <span class="leg {{ 'u' if (lg.dir or 0) > 0 else 'd' if (lg.dir or 0) < 0 else '' }}">
            <span class="ar">{{ '▲' if (lg.dir or 0) > 0 else '▼' if (lg.dir or 0) < 0 else '·' }}</span>{{ b(lg.label) }}</span>
          {% endfor %}
        </div>
      </div>
      {# sector leadership #}
      <div class="rrc c-sect">
        <div class="rr-eyebrow">{{ t('Sector leadership', '板块领导力') }}</div>
        <div class="rr-state" style="font-size:16px">{{ t('60-day momentum', '60日动量') }}{{ help('Trailing 60-session price momentum for each of the 11 GICS sector SPDRs, ranked. Positive = the sector has been leading; the bar grows from the centre. A sector leading here is a tailwind for funds accumulating names inside it.', '11 个 GICS 板块 SPDR 的过去 60 个交易日价格动量排名。正值=该板块一直领先；柱状从中心生长。领先的板块对增持其成分股的基金构成顺风。') }}</div>
        <div class="slad">
          {% set mx = ro.sector.mom_max or 1 %}
          {% for r in ro.sector.rows %}
          {% set m = r.mom60 or 0 %}
          <div class="sl">
            <span class="rk">{{ r.rank }}</span>
            <span class="nm">{{ b(r.label) }}</span>
            <span class="track"><i class="{{ 'u' if m >= 0 else 'd' }}" style="width:{{ "%.0f" | format((((m if m >= 0 else -m) / mx) * 50) if mx else 0) }}%"></i></span>
            <span class="mv {{ 'u' if m >= 0 else 'd' }}">{{ "%+.1f" | format(m) }}%</span>
          </div>
          {% endfor %}
        </div>
      </div>
      {# style tug of war #}
      <div class="rrc c-style">
        <div class="rr-eyebrow">{{ t('Style rotation', '风格轮动') }}</div>
        <div class="rr-state" style="font-size:16px">{{ t('who’s leading', '谁在领先') }}{{ help('Trailing ratio momentum between paired style ETFs (e.g. IWM/SPY = small vs large). The bar leans toward whichever side is leading over the last ~20 sessions. Tells you the style regime the fund moves are happening inside.', '成对风格 ETF 之间的比值动量（如 IWM/SPY = 小盘对大盘）。柱状偏向过去约 20 个交易日领先的一侧。它告诉你基金动作所处的风格环境。') }}</div>
        <div class="tug">
          {% for s in ro.style %}
          {% set tl = s.tilt or 0 %}{% set c20 = s.chg20 or 0 %}
          <div class="tw {{ 'up' if tl > 0 else 'dn' if tl < 0 else '' }}">
            <div class="lab"><span class="nm">{{ b(s.label) }}</span><span class="ld">{{ b(s.lead) }}</span></div>
            <div class="bar"><span class="mid"></span><i class="{{ 'u' if c20 >= 0 else 'd' }}" style="width:{{ "%.0f" | format([((c20 if c20 >= 0 else -c20) * 8), 50] | min) }}%"></i></div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {# From ro.disclaimer (engine constants), NOT from the shipped pulse JSON —
       that file is a render lane behind this page and used to carry internal
       "Display-only" vocabulary this public page must never print.
       The date is the OPPOSITE way round on purpose: etf_pulse.json refreshes
       under render scope `baskets` while this page bakes under `macro` (W2 spec
       §B9.6), so this module's freshness must come from its own data source —
       the pulse's as_of — never be implied by the hero's bake stamp. A stale
       backdrop then shows its real date instead of masquerading as current;
       no as_of, no date line. #}
    <p class="faint" style="font-size:11.5px;margin:11px 2px 0">{{ b(ro.disclaimer) }}{% if ro.as_of %} · {{ t('prices through', '数据截至') }} {{ ro.as_of }}{% endif %}</p>
  </section>
  {% endif %}

{# ═══════════════ BROWSE BY FUND — accumulation ═══════════════ #}
  <section class="sec" style="--sc:var(--accent)">
    <div class="sec-head"><span class="sh-dot"></span>
      <h2>{{ t('Every add, by fund', '逐基金增持明细') }}</h2>
      {% if gate and gate.n_buys %}<span class="gate-pill">{{ t('Essential', 'Essential') }}</span>{% endif %}</div>
    <p class="sec-sub">{{ t('The individual buys behind the board — each fund’s strongest add this cycle, highest conviction first. Conviction is the weight the manager actively committed, after stripping price and flows.', '看板背后的单笔买入——每只基金本轮最强增持，信念最高者优先。信念=剔除价格与资金流后经理人主动投入的权重。') }}</p>
    <div id="etf-accum-mount">
    {# `gate.n_buys` and not just `gate` — same empty-state guard as the board. #}
    {% if gate and gate.n_buys %}
    {# The page's ONE ask, placed here on purpose: by this point the reader has
       had the entire rotation backdrop and the full fund directory for free. #}
    <div class="tier-wall" id="etf-tier-wall">
      <div class="tw-ghosts" aria-hidden="true">
        {# FOUR ghosts, not three: with three the absolutely-positioned .tw-card
           overflows the stack and overlaps the section lede above it. #}
        {% for _ in range(4) %}
        <div class="tw-ghost"><div class="gh gh-tkr"></div><div class="gh gh-line"></div><div class="gh gh-line short"></div></div>
        {% endfor %}
      </div>
      <div class="tw-card">
        <svg class="tw-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <div class="tw-h">
          <span class="l-en">{{ gate.n_buys }} individual buys, across {{ gate.n_funds }} funds, are open to members</span>
          <span class="l-zh">来自 {{ gate.n_funds }} 只基金的 {{ gate.n_buys }} 笔买入向会员开放</span>
        </div>
        <div class="tw-p">
          <span class="l-en">You’re reading which funds we track and the market they’re buying into. Members also get
            every name on the consensus board, each fund’s strongest adds, what’s being trimmed, and what we’d do
            about each one.</span>
          <span class="l-zh">你正在查看我们追踪的基金以及它们所买入的市场。会员另可获取共识看板上的全部个股、
            每只基金的最强增持、正在减持的仓位，以及我们对每一项的应对建议。</span>
        </div>
        <div class="tw-acts">
          <a class="tw-btn" href="plans.html">{{ t('See plans', '查看方案') }}</a>
          <span class="tw-note">{{ t('7-day Pro trial · cancel anytime', 'Pro 7 天试用 · 随时取消') }}</span>
        </div>
        <div class="tw-signed" id="etf-tw-signin" hidden>
          <a href="#" data-act="signin">{{ t('Already a member? Sign in', '已是会员？登录') }}</a>
        </div>
      </div>
    </div>
    {% elif accumulation %}
    {% with rows = accumulation %}{% include "_etf_accumulation_rows.html.j2" %}{% endwith %}
    {% else %}
    {# Ungated only — same empty-state trap as the consensus board above. #}
    <div class="card"><p class="muted" style="margin:0">{{ t('Building — the collector writes one full-holdings snapshot per fund per day; conviction-ranked adds appear once each fund has at least two snapshots.', '构建中 — 采集器每天为每只基金写入一份完整持仓快照；当每只基金至少有两个快照后，按信念排序的增持即会显示。') }}</p></div>
    {% endif %}
    </div>
  </section>

{# ═══════════════ SHELF — trims + coverage ═══════════════ #}
  <section class="sec shelf" style="--accent:var(--drag)">
    {# Trims are graded and explicitly secondary — walled and omitted, with the
       mount kept so hydration restores the entitled shelf in place. #}
    <div id="etf-trims-mount">{% if not gate and trims %}{% with rows = trims %}{% include "_etf_trim_rows.html.j2" %}{% endwith %}{% endif %}</div>

    {# Coverage & freshness — the free tier's anchor, and the one block a crawler
       most needs to see: 77 named funds, each with a theme, a snapshot count and
       an honest freshness state. No score, no ranking, no call. It opens by
       DEFAULT on both builds (T-B3 ruling): a collapsed <details> may never be
       crawled, and unifying the state keeps the two builds structurally
       identical rather than differing in a way a reader could notice. #}
    <details open>
      <summary><span class="sh-ic">📡</span>{{ t('Coverage & freshness', '覆盖范围与新鲜度') }} <span class="sh-sub">— {{ t('every tracked fund; any stale feed surfaces here', '所有已追踪基金；任何陈旧数据源都会在此暴露') }}{% if coverage %} · {{ t('all', '共显示') }} {{ coverage | length }} {{ t('shown', '只') }}{% endif %}</span><span class="sh-caret">▶</span></summary>
      <div class="sh-body">
        {% if coverage %}
        <div class="atbl-wrap">
        <table class="atbl">
          <thead><tr>
            <th>{{ t('fund', '基金') }}</th><th class="hide-sm">{{ t('name', '名称') }}</th>
            <th>{{ t('theme', '主题') }}</th><th class="r">{{ t('snapshots', '快照') }}</th>
            <th class="hide-sm">{{ t('latest', '最新') }}</th><th>{{ t('freshness', '新鲜度') }}</th>
          </tr></thead>
          <tbody>
          {% for c in coverage %}
          <tr>
            <td><b>{{ c.fund }}</b>{% if c.unofficial %} <span class="tag3p">{{ t('3rd-party', '第三方') }}</span>{% endif %}</td>
            <td class="hide-sm muted">{{ c.fund_name }}</td>
            <td>{% if c.is_active %}<span class="mini active">{{ t('active', '主动') }}</span>{% elif c.category %}<span class="themetag">{{ td(c.category) }}</span>{% else %}<span class="faint">—</span>{% endif %}</td>
            <td class="r muted">{{ c.n_snapshots }}</td>
            <td class="hide-sm muted">{{ c.latest_asof if c.latest_asof else '—' }}</td>
            <td>
              {% if c.n_snapshots == 0 %}<span class="fdot none"></span><span class="muted">{{ t('no data yet', '暂无数据') }}</span>
              {% elif c.stale_days is not none and c.stale_days <= 3 %}<span class="fdot fresh"></span><span class="muted">{{ t('fresh', '新鲜') }}</span>
              {% elif c.stale_days is not none and c.stale_days <= 10 %}<span class="fdot aging"></span><span class="muted">{{ t('aging', '渐旧') }}{% if c.stale_days %} · {{ c.stale_days }}{{ t('d', '天') }}{% endif %}</span>
              {% else %}<span class="fdot stale"></span><span class="fstale"><b>{{ t('stale', '陈旧') }}</b></span>{% if c.stale_days is not none %} <span class="muted">· {{ c.stale_days }}{{ t('d', '天') }}</span>{% endif %}{% endif %}
            </td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
        </div>
        {% else %}<p class="muted" style="margin:0">{{ t('No funds registered in the coverage directory yet.', '覆盖目录中尚未登记任何基金。') }}</p>{% endif %}
      </div>
    </details>
  </section>

{# ═══════════════ disclosure ═══════════════ #}
  {# "DISPLAY context" / "展示性背景" was internal tier vocabulary on a page that
     is now anonymous-public and indexed. Same Doctrine Law 2 fix as the rotation
     disclaimer; the meaning ("not a timed buy signal") is unchanged. #}
  <p class="disc">{{ t(
    "How to read this: fund managers accumulating a name is context on a lagged filing cadence — where curated & active money is going, not a timed buy signal. The stance answers “so what do I do?” in plain words; the honest default is “watch — don’t chase” until a name has both broad backing and a forming setup.",
    "如何解读：基金经理人增持某只个股属于滞后披露节奏下的背景信息——反映精选与主动资金的去向，而非择时买入信号。“如何应对”以平实用语回答“那我该怎么做”；在个股同时具备广泛支持与正在形成的形态之前，诚实的默认立场是“观望——勿追”。") }}
    {{ t("Coverage: SPDR, Global X, VanEck, First Trust, Sprott, Amplify, Defiance, Bitwise, ARK, Invesco and Roundhill are verified daily holdings feeds (with shares). iShares and Schwab are blocked at source but reachable via a labelled third-party feed; Vanguard publishes no free daily feed. A fund missing here failed today’s fetch and is skipped, never crashing the page.",
    "覆盖范围：SPDR、Global X、VanEck、First Trust、Sprott、Amplify、Defiance、Bitwise、ARK、Invesco 与 Roundhill 为已验证的每日持仓数据（含份额）。iShares 与嘉信在源头被屏蔽，但可通过带标注的第三方数据源触达；Vanguard 无免费每日数据。此处缺失的基金为今日抓取失败并被跳过，绝不会使页面崩溃。") }}</p>

</div>

<script src="theme.js"></script>
{% if gate %}
<script>
(function(){
  /* ══════════ tier gate — attempt-hydrate ══════════
     On the gated build this document holds NO graded row: the consensus board,
     the fresh-conviction cards, every per-fund add and the trim shelf live in
     GATE.payload, which config/site_access.yml enforces as Essential+
     (premium.enforced_early) whatever PAYWALL_ENABLED says. The SERVER decides
     who sees them — nothing here is load-bearing. We ask; on 403 the wall stays
     exactly as baked. See docs/TIER_PREVIEW_PATTERN.md.
     Ported from special_situations.html.j2, including both traps it solves. */
  var GATE = {{ (gate or None) | tojson }};
  if(!GATE || !GATE.payload) return;

  /* Session trampoline: the shared cookie carries a ~1h access token, so a
     long-idle member can be signed in with a token the server will reject.
     getSession() refreshes and rewrites the cookie before we ask. No-op when
     signed out. */
  function freshSession(){
    try{
      if(window.MDXAuth && window.MDXAuth.client && window.MDXAuth.hasSession && window.MDXAuth.hasSession()){
        return window.MDXAuth.client()
          .then(function(sb){ return sb.auth.getSession(); })
          .catch(function(){});
      }
    }catch(e){}
    return Promise.resolve();
  }

  /* theme.js may still be settling when this runs, so MDXAuth can be undefined.
     Wait for its first auth broadcast, with a timeout so a missing or broken
     auth layer still lets the request through (the server re-decides). */
  function whenAuthSettled(){
    return new Promise(function(resolve){
      var done = false;
      function go(){ if(done) return; done = true; resolve(); }
      if(window.MDXAuth) { go(); return; }
      window.addEventListener('mdx-auth', go);
      setTimeout(go, 3000);
    });
  }

  function fill(id, html){
    var el = document.getElementById(id);
    if(el && html) el.innerHTML = html;
    return el;
  }

  function hydrate(p){
    /* Same DOM order as the entitled build — nothing moves, blocks just fill. */
    fill('etf-board-mount', p.board_html);
    if(p.fresh_html){
      fill('etf-fresh-mount', p.fresh_html);
      var fs = document.getElementById('etf-fresh-sec');
      if(fs) fs.hidden = false;
    }
    fill('etf-accum-mount', p.accumulation_html);   /* this removes the wall */
    fill('etf-trims-mount', p.trims_html);
    fill('etf-hero-read', p.verdict_html);
    fill('etf-hero-tiles', p.tiles_html);
    /* belt and braces: the wall and the gate note must not survive a payload
       whose accumulation block came back empty */
    var wall = document.getElementById('etf-tier-wall');
    if(wall) wall.remove();
    var note = document.getElementById('etf-board-note');
    if(note) note.remove();
    document.querySelectorAll('.gate-pill').forEach(function(el){ el.remove(); });
    /* The ? tips and the .cb-who popovers need no re-wiring: the tips are the
       site-wide LENS, which is delegated from document, and .cb-who opens on
       CSS :hover. There are no <select>s or placeholders on this page, so there
       is nothing for an i18n relabel pass to do either — the bilingual spans
       are .l-en/.l-zh, which CSS switches. */
  }

  whenAuthSettled()
    .then(freshSession)
    .then(function(){ return fetch(GATE.payload, { credentials: 'same-origin', cache: 'no-store' }); })
    .then(function(r){ if(!r || !r.ok) throw new Error('locked'); return r.json(); })
    .then(hydrate)
    .catch(function(){
      /* Locked (or offline): the wall stays exactly as rendered. Offer sign-in
         when there is no session at all — a member on a fresh browser would
         otherwise only see an upgrade CTA. */
      var si = document.getElementById('etf-tw-signin');
      var signedIn = false;
      try{ signedIn = !!(window.MDXAuth && window.MDXAuth.user && window.MDXAuth.user()); }catch(e){}
      if(si && !signedIn){
        si.hidden = false;
        var a = si.querySelector('[data-act="signin"]');
        if(a) a.addEventListener('click', function(ev){
          ev.preventDefault();
          try{ window.MDXAuth.open('signin'); }catch(e){ location.href = 'plans.html'; }
        });
      }
    });
})();
</script>
{% endif %}
<footer class="site-footer">
  <span class="made">© 2026 MastermindX Inc</span>
</footer>
</body>
</html>
