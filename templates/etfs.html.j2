    {{ t("Coverage: SPDR, Global X, VanEck, First Trust, Sprott, Amplify, Defiance, Bitwise, ARK, Invesco and Roundhill are verified daily holdings feeds (with shares). iShares and Schwab are blocked at source but reachable via a labelled third-party feed; Vanguard publishes no free daily feed. A fund missing here failed today’s fetch and is skipped, never crashing the page.",
    "覆盖范围：SPDR、Global X、VanEck、First Trust、Sprott、Amplify、Defiance、Bitwise、ARK、Invesco 与 Roundhill 为已验证的每日持仓数据（含份额）。iShares 与嘉信在源头被屏蔽，但可通过带标注的第三方数据源触达；Vanguard 无免费每日数据。此处缺失的基金为今日抓取失败并被跳过，绝不会使页面崩溃。") }}</p>

</div>

<script src="theme.js"></script>
{% if gate %}
<script>
(function(){
  /* ══════════ tier gate — attempt-hydrate ══════════
     On the gated build this document holds NO graded row: the consensus board,
     the fresh-conviction cards, every per-fund add and the trim shelf live in
     GATE.payload, which config/site_access.yml enforces as Essential+
     (premium.enforced_early) whatever PAYWALL_ENABLED says. The SERVER decides
     who sees them — nothing here is load-bearing. We ask; on 403 the wall stays
     exactly as baked. See docs/TIER_PREVIEW_PATTERN.md.
     Ported from special_situations.html.j2, including both traps it solves. */
  var GATE = {{ (gate or None) | tojson }};
  if(!GATE || !GATE.payload) return;

  /* Session trampoline: the shared cookie carries a ~1h access token, so a
     long-idle member can be signed in with a token the server will reject.
     getSession() refreshes and rewrites the cookie before we ask. No-op when
     signed out. */
  function freshSession(){
    try{
      if(window.MDXAuth && window.MDXAuth.client && window.MDXAuth.hasSession && window.MDXAuth.hasSession()){
        return window.MDXAuth.client()
          .then(function(sb){ return sb.auth.getSession(); })
          .catch(function(){});
      }
    }catch(e){}
    return Promise.resolve();
  }

  /* theme.js may still be settling when this runs, so MDXAuth can be undefined.
     Wait for its first auth broadcast, with a timeout so a missing or broken
     auth layer still lets the request through (the server re-decides). */
  function whenAuthSettled(){
    return new Promise(function(resolve){
      var done = false;
      function go(){ if(done) return; done = true; resolve(); }
      if(window.MDXAuth) { go(); return; }
      window.addEventListener('mdx-auth', go);
      setTimeout(go, 3000);
    });
  }

  function fill(id, html){
    var el = document.getElementById(id);
    if(el && html) el.innerHTML = html;
    return el;
  }

  function hydrate(p){
    /* Same DOM order as the entitled build — nothing moves, blocks just fill. */
    fill('etf-board-mount', p.board_html);
    if(p.fresh_html){
      fill('etf-fresh-mount', p.fresh_html);
      var fs = document.getElementById('etf-fresh-sec');
      if(fs) fs.hidden = false;
    }
    fill('etf-accum-mount', p.accumulation_html);   /* this removes the wall */
    fill('etf-trims-mount', p.trims_html);
    fill('etf-hero-read', p.verdict_html);
    fill('etf-hero-tiles', p.tiles_html);
    /* belt and braces: the wall and the gate note must not survive a payload
       whose accumulation block came back empty */
    var wall = document.getElementById('etf-tier-wall');
    if(wall) wall.remove();
    var note = document.getElementById('etf-board-note');
    if(note) note.remove();
    document.querySelectorAll('.gate-pill').forEach(function(el){ el.remove(); });
    /* The ? tips need no re-wiring (page-local CSS :hover) and neither do the
       .cb-who popovers. The hydrated rows DO carry LENS [data-tip-en] targets —
       the breadth constellation, the money-source line, the size strip — and
       LENS is delegated from document, so those bind with nothing to do here.
       There are no <select>s or placeholders on this page either, so an i18n
       relabel pass has no work: the bilingual spans are .l-en/.l-zh, which CSS
       switches. */
  }

  whenAuthSettled()
    .then(freshSession)
    .then(function(){ return fetch(GATE.payload, { credentials: 'same-origin', cache: 'no-store' }); })
    .then(function(r){ if(!r || !r.ok) throw new Error('locked'); return r.json(); })
    .then(hydrate)
    .catch(function(){
      /* Locked (or offline): the wall stays exactly as rendered. Offer sign-in
         when there is no session at all — a member on a fresh browser would
         otherwise only see an upgrade CTA. */
      var si = document.getElementById('etf-tw-signin');
      var signedIn = false;
      try{ signedIn = !!(window.MDXAuth && window.MDXAuth.user && window.MDXAuth.user()); }catch(e){}
      if(si && !signedIn){
        si.hidden = false;
        var a = si.querySelector('[data-act="signin"]');
        if(a) a.addEventListener('click', function(ev){
          ev.preventDefault();
          try{ window.MDXAuth.open('signin'); }catch(e){ location.href = 'plans.html'; }
        });
      }
    });
})();
</script>
{% endif %}
