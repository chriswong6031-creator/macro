{% macro flowrow(r) -%}
      <tr>
        <td class="l"><b>{{ r.etf }}</b> <span class="muted">{{ r.etf_name }}{% if r.category %} · {{ td(r.category) }}{% endif %}</span></td>
        <td class="l"><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted">{{ r.name }}</span></td>
        <td class="l muted">{{ td(r.sector) if r.sector else "—" }}</td>
        <td class="r muted">{% if r.weight_pct is not none %}{{ "%.2f" | format(r.weight_pct) }}%{% else %}—{% endif %}</td>
        <td class="r {{ 'pos' if r.conviction_pp >= 0 else 'neg' }}"><b>{{ "%+.2f" | format(r.conviction_pp) }}pp</b>{% if r.is_new %} <span class="tag tag-active" title="brand-new position — the fund just initiated a stake">{{ t('NEW', '新建') }}</span>{% elif r.is_exit %} <span class="tag tag-passive" title="fully exited — the fund sold out of this position entirely">{{ t('EXITED', '清仓') }}</span>{% endif %}</td>
        <td class="r muted">{% if r.is_new %}{{ t('initiated', '新建仓') }}{% elif r.is_exit %}{{ t('sold out', '已清仓') }}{% elif r.active_chg_pct is not none %}{{ "%+.0f" | format(r.active_chg_pct) }}%{% else %}—{% endif %}</td>
        <td class="l">{% if r.is_active %}<span class="tag tag-active">{{ t('manager conviction', '经理人信念') }}</span>{% else %}<span class="tag tag-passive">{{ t('curated basket', '精选篮子') }}</span>{% endif %}</td>
        <td class="l">{% if r.ladder %}<span class="state st-{{ r.ladder.state | replace(' ', '_') }}">{{ td(r.ladder.label) }}</span>{% if r.confirmed %} ✅{% endif %}{% else %}<span class="muted">—</span>{% endif %}{% if r.vol and r.vol.surging %} <span title="volume {{ r.vol.ratio }}× recent avg">📊</span>{% endif %}</td>
        <td class="l muted">{{ r.window }}</td>
      </tr>
{%- endmacro %}
{% macro flowhead() -%}
      <tr>
        <th class="l">{{ t('fund', '基金') }}</th>
        <th class="l">{{ t('stock', '个股') }}</th>
        <th class="l">{{ t('sector', '板块') }}</th>
        <th class="r">{{ t('weight', '权重') }}</th>
        <th class="r">{{ t('conviction Δwt', '信念权重Δ') }}{{ help("Conviction = the percentage POINTS of the fund's weight that the manager actively committed to this name, after stripping out price moves and fund in/outflows. We rank on this, NOT raw % change, so a 0.1%→0.2% double (big % but trivial size) never outranks a real add to an already-meaningful position. Positive = accumulating.", "信念 = 在剔除价格变动与基金申赎后，经理人主动投入该股的权重百分点。我们据此排序，而非原始百分比变化，因此 0.1%→0.2% 的翻倍（百分比大但仓位微不足道）绝不会盖过对已具规模仓位的真实增持。正值=增持。") }}</th>
        <th class="r">{{ t('share Δ', '份额Δ') }}</th>
        <th class="l">{{ t('type', '类型') }}</th>
        <th class="l">{{ t('technical', '技术面') }}</th>
        <th class="l">{{ t('window', '窗口') }}</th>
      </tr>
{%- endmacro %}
  <div class="panel">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px">
      <h1>🐳 {{ t('Real fund moves', '基金真实动作') }}</h1>
      <span class="muted">{{ t('where thematic & active managers are putting real conviction', '主题与主动经理人真正下注之处') }}</span>
    </div>
    <p class="muted" style="margin:10px 0 0">{{ t(
      "For each fund we diff its daily holdings and strip out mechanical creation/redemption flow AND the price move, leaving the manager's actual conviction per name — measured in percentage POINTS of fund weight committed, not raw share %. We rank accumulation by that conviction, so a real add to a meaningful position beats a tiny position doubling. Cash, FX and money-market lines are excluded.",
      "对每只基金，我们比对其每日持仓，剔除机械性的申购／赎回资金流以及价格变动，留下经理人对每只个股的真实信念——以投入的基金权重百分点衡量，而非原始份额百分比。我们按该信念对增持排序，因此对有意义仓位的真实增持会胜过微小仓位的翻倍。现金、外汇与货币市场科目已排除。") }}
      {{ help("Universe = curated THEMATIC / industry funds (SPDR sector, Global X) plus ACTIVELY managed funds (ARK). Broad-index trackers (SPY/QQQ) are deliberately excluded — they just mirror the whole market, so their 'moves' are reconstitution noise, not a curated read. The 'type' tag tells you whether a move is a discretionary manager's conviction or a curated index basket. Where a holding has price history, its cycle state shows (✅ = accumulation that also has a forming buy setup). Needs ≥2 daily snapshots to appear.",
      "范围 = 精选的主题／行业基金（SPDR 板块、Global X）加上主动管理基金（ARK）。宽基指数基金（SPY/QQQ）被刻意排除——它们只是镜像整个市场，其“动作”是再平衡噪音而非精选解读。“类型”标签会告诉你某动作是主动经理人的信念还是精选指数篮子。若持仓有价格历史，会显示其周期状态（✅=增持同时出现正在形成的买入形态）。需要≥2个每日快照才会显示。") }}
    </p>
  </div>

  <div class="panel">
    <h2>{{ t('🟢 Accumulating — strongest conviction first', '🟢 增持中 — 信念最强者优先') }}</h2>
    {% if accumulation %}
    <table>
      {{ flowhead() }}
      {% for r in accumulation %}{{ flowrow(r) }}{% endfor %}
    </table>
    {% else %}
    <p class="muted">{{ t('Building — the collector writes one full-holdings snapshot per fund per day; conviction-ranked decisions appear once each fund has at least two snapshots.', '构建中 — 采集器每天为每只基金写入一份完整持仓快照；当每只基金至少有两个快照后，按信念排序的决策即会显示。') }}</p>
    {% endif %}
  </div>

  {% if trims %}
  <div class="panel">
    <details>
      <summary><b>{{ t('🔴 Trimming', '🔴 减持中') }}</b> <span class="muted">{{ t('— positions managers are actively cutting (secondary signal)', '— 经理人正在主动削减的仓位（次要信号）') }}</span></summary>
      <table style="margin-top:10px">
        {{ flowhead() }}
        {% for r in trims %}{{ flowrow(r) }}{% endfor %}
      </table>
    </details>
  </div>
  {% endif %}

  <div class="panel">
    <p class="muted" style="font-size:12px;margin:0">{{ t(
      "Coverage: SPDR / State Street, ARK and Global X are verified daily holdings feeds (with shares). iShares and Schwab are blocked by anti-bot / consent walls, and Vanguard publishes no free daily feed, so those funds are absent. A fund missing here failed today's fetch and is skipped, never crashing the page. See LIMITATIONS.md.",
      "覆盖范围：SPDR／道富、ARK 与 Global X 为已验证的每日持仓数据（含份额）。iShares 与嘉信因反爬／同意墙被屏蔽，Vanguard 无免费每日数据，故这些基金缺失。此处缺失的基金为今日抓取失败并被跳过，绝不会使页面崩溃。详见 LIMITATIONS.md。") }}
      {{ t('Generated', '生成于') }} {{ generated_utc }} UTC</p>
  </div>

<script src="theme.js"></script>
<footer class="site-footer">
  <span class="made">Made with ❤️ in Canada</span>
