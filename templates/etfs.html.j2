          <span class="fl-s"><b>{{ coverage | length }}</b>{{ t('funds tracked', '只基金在追踪') }}</span>
          <span class="fl-s"><b>{{ fl_current | length }}</b>{{ t('filed in the last three days', '近三日已披露') }}</span>
          <span class="fl-s"><b>{{ coverage | map(attribute='sponsor') | select | unique | list | length }}</b>{{ t('sponsors', '家发行商') }}</span>
          <span class="fl-lg"><span class="fdot fresh"></span>{{ t('current', '最新') }}<span class="fdot aging"></span>{{ t('a few days behind', '落后数日') }}<span class="fdot stale"></span>{{ t('stale', '陈旧') }}</span>
        </div>
        {%- for grp in [
              {'rows': fl_active, 'en': 'Active managers', 'zh': '主动管理基金',
