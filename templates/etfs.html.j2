{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{# ---- logo(ticker): eager company logo via the nvstly CDN, onerror hides the
       img and reveals the ticker-text fallback (heatmap.js pattern) ---- #}
{% macro logo(ticker) -%}
<span class="tk-logo"><img src="https://cdn.jsdelivr.net/gh/nvstly/icons@main/ticker_icons/{{ ticker | upper }}.png" alt="" loading="eager" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';"><span class="tk-fb" style="display:none">{{ ticker | upper | truncate(4, true, '') }}</span></span>
{%- endmacro %}
{# ---- spark(series): min-max normalized inline-SVG sparkline (~72x18), no JS.
       up-colored if last>=first else down. em dash when <2 points. ---- #}
{% macro spark(series) -%}
{%- if series and (series | length) >= 2 -%}
  {%- set lo = series | min -%}
  {%- set hi = series | max -%}
  {%- set n = series | length -%}
  {%- set rng = (hi - lo) -%}
  {%- set up = (series[-1] >= series[0]) -%}
  <svg class="spark" viewBox="0 0 72 18" width="72" height="18" preserveAspectRatio="none" aria-hidden="true"><polyline fill="none" stroke="{{ 'var(--up)' if up else 'var(--down)' }}" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" points="
  {%- for v in series -%}
    {{ "%.1f" | format(1.0 + (loop.index0 / (n - 1)) * 70.0) }},{{ "%.1f" | format(16.0 - (((v - lo) / rng) if rng > 0 else 0.5) * 14.0) }}{{ ' ' }}
  {%- endfor -%}
  "/></svg>
{%- else -%}
  <span class="muted">—</span>
{%- endif -%}
{%- endmacro %}
