{# Row-rendering macros now live in _etf_macros.html.j2 so the four row partials
   (_etf_board_rows / _etf_fresh_cards / _etf_accumulation_rows / _etf_trim_rows)
   render from the SAME source as this page — the tier-preview split's one-source
   rule (docs/TIER_PREVIEW_PATTERN.md §checklist-1). Call sites are unchanged. #}
{% from "_etf_macros.html.j2" import t, b, help, logo, spark, stance, breadth, presbar, hero_verdict, hero_tiles %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# SEO head, W2/T-B4 (ruled): the SERP line trades house voice for search intent.
   "Real fund moves" is a phrase nobody types; "which stocks fund managers are
   buying" is the question this page answers, in the searcher's own words. Brand
   suffix kept, <title> and seo_title unified (they used to disagree), and the h1
   is deliberately UNCHANGED — the voice stays on the page, only the SERP moves. #}
<title>Which Stocks Fund Managers Are Buying — MastermindX</title>
{# The fund count is COUNTED, never typed: it said 77 while the universe was 103,
   and a hardcoded number in the SERP line goes stale on the quiet side (nothing
   renders wrong, the description just starts lying). Counted the same way the
   page's own "Tracking N" line counts — funds with at least one snapshot — so
   the two can never disagree. Falls back to the number-free phrasing rather than
   printing 0 or 1 when the coverage directory is empty. #}
{% set seo_title = "Which Stocks Fund Managers Are Buying — MastermindX" %}{% set seo_n_funds = (coverage | selectattr('n_snapshots') | list | length) if coverage else 0 %}{% set seo_desc = ("Track which stocks " ~ seo_n_funds ~ " thematic and active ETFs are accumulating" if seo_n_funds > 1 else "Track which stocks thematic and active ETFs are accumulating") ~ " — cross-fund consensus, brand-new positions and the sector rotation backdrop, updated each filing cycle." %}{% set seo_path = "etfs.html" %}
{% include "_seo_head.html.j2" %}
