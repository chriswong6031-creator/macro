{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Subsector Confluence — Market Intelligence</title>
{% set seo_title = "US Subsector Confluence — Mastermind" %}{% set seo_desc = "US subsectors ranked by signal confluence — where trend, breadth and flows agree, and which groups are quietly turning. Updated nightly." %}{% set seo_path = "subsectors.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 'Inter',-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:22px 0 30px; }
  a { text-decoration:none; color:inherit; }
  .wrap { padding:16px; }
  @media (min-width:1100px){ .wrap{ padding:18px max(28px,calc((100vw - 1560px)/2)); } }
  .sc-head { display:flex; flex-wrap:wrap; align-items:flex-end; gap:6px 22px; margin:8px 2px 6px; }
  .sc-head h1 { font-size:23px; margin:0; font-weight:800; letter-spacing:-.015em; }
  .sc-head .asof { color:var(--muted); font-size:12px; margin-left:auto; }
  .sc-head h1.sc-titletip { cursor:help; }
  .sc-head h1 .sc-info { font-size:14px; color:var(--muted); font-weight:600; vertical-align:middle; margin-left:1px; }
  .sc-head h1.sc-titletip:hover .sc-info, .sc-head h1.sc-titletip:focus-visible .sc-info { color:var(--link); }
  .sc-tabs { display:flex; flex-wrap:wrap; gap:6px; margin:6px 2px 16px; border-bottom:1px solid var(--line); }
  .sc-tab { padding:8px 14px; cursor:pointer; font-weight:600; color:var(--muted); border-bottom:2px solid transparent; margin-bottom:-1px; }
  .sc-tab.on { color:var(--text); border-bottom-color:var(--link); }
  .sc-tab .n { color:var(--muted); font-weight:500; font-size:12px; }
  .sec { margin:22px 0 8px; }
  .sec h2 { font-size:15px; font-weight:700; margin:0 2px 3px; display:flex; align-items:center; gap:8px; }
  .sec .desc { color:var(--muted); font-size:11.5px; margin:0 2px 10px; max-width:92ch; }
  .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(238px,1fr)); gap:10px; }
  .card { background:var(--panel); border:1px solid var(--line); border-left-width:3px; border-radius:11px; padding:11px 12px; display:block; transition:border-color .12s,transform .08s; }
  .card:hover { transform:translateY(-1px); border-color:var(--link); }
  .card .top { display:flex; justify-content:space-between; align-items:flex-start; gap:8px; }
  .card .nm { font-weight:700; font-size:13.5px; line-height:1.25; }
  .card .sct { color:var(--muted); font-size:10.5px; margin-top:1px; text-transform:uppercase; letter-spacing:.03em; }
  .card .row2 { display:flex; align-items:center; gap:6px; margin-top:9px; flex-wrap:wrap; }
  .card .meta { color:var(--muted); font-size:11px; margin-top:7px; line-height:1.45; }
  .tier { font-weight:800; font-size:11px; padding:1px 6px; border-radius:5px; letter-spacing:.02em; color:#fff; }
  .tier.T1{ background:var(--up); } .tier.T2{ background:#3da564; } .tier.T3{ background:var(--info); } .tier.T4{ background:#6b7cc4; }
  .tier.none{ background:var(--g-mid); color:var(--muted); }
  /* zh 红涨绿跌: T2 bullish tier badge swaps green→red */
  html[data-lang="zh"] .tier.T2{ background:#d04545; }
  .pill { font-size:10.5px; font-weight:700; padding:1px 7px; border-radius:9px; border:1px solid var(--line); }
  .pill.buy{ color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,transparent); }
  .pill.avoid{ color:var(--down); border-color:color-mix(in srgb,var(--down) 45%,transparent); }
  .pill.neutral{ color:var(--muted); }
  .pill.tactical,.pill.late{ color:var(--orange); border-color:color-mix(in srgb,var(--orange) 45%,transparent); }
  /* RC-R7 dual-membership "behaves-as" chip — a name on this card that tracks a differently-read peer basket. */
  .pill.behavesas{ color:var(--cyan,#38bdf8); border-color:color-mix(in srgb,var(--cyan,#38bdf8) 45%,transparent); background:color-mix(in srgb,var(--cyan,#38bdf8) 8%,transparent); }
  table.tbl { width:100%; border-collapse:collapse; font-size:12.5px; }
  table.tbl th { text-align:left; color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.03em; padding:6px 9px; border-bottom:1px solid var(--line); cursor:pointer; white-space:nowrap; }
  table.tbl td { padding:7px 9px; border-bottom:1px solid var(--line); white-space:nowrap; }
  table.tbl tr:hover td { background:var(--panel); }
  .tk { font-weight:700; }
  .num { font-variant-numeric:tabular-nums; }
  .pos{ color:var(--up); } .neg{ color:var(--down); }
  .scbar { display:inline-block; height:7px; border-radius:4px; background:var(--up); vertical-align:middle; }
  .legend { color:var(--muted); font-size:11px; margin:6px 2px 0; }
  .sc-foot { color:var(--muted); font-size:11px; margin:24px 2px 0; line-height:1.65; max-width:108ch; border-top:1px solid var(--line); padding-top:12px; }
  .sc-collapsed .sc-xtra { display:none; }
  .sc-more { margin:8px 2px 0; font:600 12px/1.4 inherit; color:var(--link); background:none; border:1px solid var(--line); border-radius:8px; padding:5px 12px; cursor:pointer; transition:border-color .12s,background .12s; }
  .sc-more:hover { border-color:var(--link); background:color-mix(in srgb,var(--link) 8%,transparent); }
  .secstrip { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:7px; }
  .secstrip .s { background:var(--panel); border:1px solid var(--line); border-radius:9px; padding:8px 10px; }
  .secstrip .s .snm { font-weight:700; font-size:12px; }
  .empty { color:var(--muted); padding:14px; }
  .qp { font-size:10px; font-weight:700; padding:1px 7px; border-radius:9px; border:1px solid; }
  .star-badge { font-size:12px; }
  /* per-tab running / coiling columns */
  .lead-cols { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  @media (max-width:820px){ .lead-cols{ grid-template-columns:1fr; } }
  .lead-col h2 { font-size:14px; }
  .lcards { display:grid; grid-template-columns:repeat(auto-fill,minmax(202px,1fr)); gap:8px; }
  .lcard { border:1px solid var(--line); border-left-width:3px; border-radius:10px; padding:9px 11px; background:var(--panel); }
  .lcard .lc-top { display:flex; justify-content:space-between; align-items:center; gap:6px; }
  .lcard .lc-nm { font-weight:700; font-size:12.5px; line-height:1.2; }
  .lcard .lc-sub { color:var(--muted); font-size:10px; text-transform:uppercase; letter-spacing:.03em; margin-top:2px; }
  .lcard .lc-row { display:flex; gap:5px; align-items:center; margin-top:7px; flex-wrap:wrap; }
  .lcard .lc-meta { color:var(--muted); font-size:10.5px; margin-top:6px; font-variant-numeric:tabular-nums; }
  .lcard .lc-tf { font-size:10.5px; margin-top:6px; display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
  .lcard .lc-tf .tfc { font-weight:700; font-variant-numeric:tabular-nums; }
  .lc-filtered { color:var(--muted); font-size:10.5px; margin-top:9px; line-height:1.45; padding-top:8px; border-top:1px dashed var(--line); }
  .lcard .lc-macro { color:var(--down); font-size:10px; margin-top:5px; font-weight:600; }
  /* Nasdaq Internals panel (TI-R4) */
  .ni-ew-chip { display:inline-flex; flex-wrap:wrap; align-items:center; gap:4px 10px; background:var(--panel); border:1px solid var(--line); border-radius:9px; padding:6px 12px; font-size:12.5px; margin:4px 0 8px; }
</style>
</head>
<body>
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <a class="ai-brief-link" href="subsector_rotation.html">🌀 {{ t('Rotation map', '轮动图') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language"><span class="pill"></span><span class="opt en-opt" data-l="en">EN</span><span class="opt zh-opt" data-l="zh">中文</span></div>
  </div>
</nav>

<div class="wrap">
  <div class="sc-head">
    <h1 class="sc-titletip" tabindex="0"
      data-tip-en="Every sub-industry as its own basket, scored for entry timing. ENTRY-NOW = a subsector that just turned buyable; the double-gate then finds stocks firing inside a subsector with the wind at its back. A timing map — confirm before acting."
      data-tip-zh="将每个子行业视作独立篮子，按入场时机评分。现可入场=刚转为可买的子行业；双重闸门再筛出在顺风子行业中触发的个股。择时图——行动前请确认。">💫 {{ t('Subsector Confluence', '子行业汇聚') }} <span class="sc-info" aria-hidden="true">ⓘ</span></h1>
    <div class="asof" id="sc-asof"></div>
  </div>

  <div class="sc-tabs">
    <div class="sc-tab on" data-tab="subsectors">{{ t('S&amp;P 500 Subsectors', '标普500子行业') }} <span class="n" id="tabn-sub"></span></div>
    <div class="sc-tab" data-tab="nasdaq">{{ t('Nasdaq-100', '纳斯达克100') }} <span class="n" id="tabn-ndx"></span></div>
    <div class="sc-tab" data-tab="russell">{{ t('Russell-2000', '罗素2000') }} <span class="n" id="tabn-rut"></span></div>
    <div class="sc-tab" data-tab="baskets">{{ t('Thematic Baskets', '主题篮子') }} <span class="n" id="tabn-bas"></span></div>
  </div>

  <div id="sc-app"><div class="empty">{{ t('Loading…', '加载中…') }}</div></div>

  <div class="sc-foot">{{ t('Built', '生成于') }} {{ generated_utc }}</div>
</div>

<footer class="site-footer">
  <span class="made">© 2026 Mastermind Inc</span>
</footer>

<script src="theme.js"></script>
<script src="subsectors.js"></script>
</body>
</html>
