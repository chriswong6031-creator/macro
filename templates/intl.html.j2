<div class="panel">
  <div class="row">
    {% if mode == 'stocks' %}
    <h1>🌍 {{ t('International Stock Dashboard', '国际股票看板') }}</h1>
    {% else %}
    <h1>🌍 {{ t('International Economies', '国际经济体') }}</h1>
    {% endif %}
    <span style="flex:1"></span>
    <span class="muted small">{{ t('data through', '数据截至') }} {{ latest.date }} · {{ t('built', '生成') }} {{ built }}</span>
  </div>
  {% if mode == 'stocks' %}
  <p class="muted small" style="margin:6px 0 0">{{ t('Standout names pooled from the top constituents of Japan, South Korea, Taiwan, the UK and Europe — ranked by sector-neutral residual momentum computed WITHIN each market (a relative-strength lens, not a forward-edge claim). Each name is flagged by country. Search any name from the box above.', '汇集日本、韩国、台湾、英国与欧洲主要成分股中的精选个股 — 按各自市场内部的板块中性残差动量排名（相对强弱视角，非前瞻收益主张）。每只个股标注所属国家。可在上方搜索框查询。') }}
    <a href="intl.html" style="color:var(--link);font-weight:600">← {{ t('Macro comparison', '宏观对比') }}</a></p>
  {% else %}
  <p class="muted small" style="margin:6px 0 0">{{ t('A side-by-side health check on five major economies outside the US/China bloc. Regime, recession & equity-risk reads are descriptive and history-anchored (display-only, never a scored buy/sell). Macro is keyless (FRED OECD + ECB); some CPI prints lag and Taiwan is data-limited — shown honestly with as-of dates.', '对美中之外五大经济体的并排健康检查。周期、衰退与股市风险读数均为描述性、以历史锚定（仅供展示，不构成买卖评分）。宏观数据无需密钥（FRED OECD + ECB）；部分 CPI 数据滞后，台湾数据受限 — 均如实标注截至日期。') }}
    <a href="intl_stocks.html" style="color:var(--link);font-weight:600">→ {{ t('Stock dashboard', '股票看板') }}</a></p>
  {% endif %}
</div>

{% if mode != 'stocks' %}{# ================= MACRO COMPARISON ================= #}

<!-- ===== Global hero ===== -->
<div class="panel">
  <div class="row" style="gap:22px">
    <div>
      <h2 style="margin-bottom:4px">{{ t('Global read', '全局读数') }}</h2>
      <div style="font-size:18px;font-weight:800">{{ t('Dominant regime', '主导周期') }}: {{ td(S.dominant_quad) }}</div>
    </div>
    <span style="flex:1"></span>
    <div><div class="muted small">{{ t('Economies', '经济体') }}</div><b style="font-size:20px">{{ S.n }}</b></div>
    <div><div class="muted small">{{ t('Recession-watch', '衰退观察') }}</div><b style="font-size:20px" class="{{ 'neg' if S.recession_watch else '' }}">{{ S.recession_watch }}</b></div>
    <div><div class="muted small">{{ t('Equity drawdown-watch', '股市回撤观察') }}</div><b style="font-size:20px" class="{{ 'neg' if S.drawdown_watch else '' }}">{{ S.drawdown_watch }}</b></div>
    <div><div class="muted small">{{ t('Avg recession score', '平均衰退分') }}</div><b style="font-size:20px">{{ num(S.avg_recession, '', 0) }}</b></div>
  </div>
</div>

<!-- ===== Comparison grid (centerpiece) ===== -->
<div class="panel">
  <h2>{{ t('Cross-country comparison', '跨国对比') }} {{ help('Every economy on the same axes. Regime = growth×inflation quad (with confidence). Recession & drawdown-risk are 0-100 history-anchored display gauges. Real yield = 10y − latest CPI. CPI/GDP/unemployment show the latest official print with its as-of month (greyed when stale — FRED OECD series are discontinued for several economies).', '所有经济体使用相同坐标轴。周期 = 增长×通胀象限（含置信度）。衰退与回撤风险为 0-100 历史锚定展示型刻度。实际收益 = 10年 − 最新 CPI。CPI/GDP/失业率显示最新官方数据及截至月份（滞后则置灰 — 多国 FRED OECD 序列已停更）。') }}</h2>
  <div class="gridwrap">
  <table class="cmp">
    <thead><tr>
      <th class="l eco">{{ t('Economy', '经济体') }}</th>
      <th class="l">{{ t('Regime', '周期') }}</th>
      <th class="grp">{{ t('Recession', '衰退') }}</th>
      <th class="grp">{{ t('Policy', '政策利率') }}</th>
      <th>{{ t('10y', '10年') }}</th>
      <th>{{ t('Curve', '曲线') }}</th>
      <th>{{ t('Real 10y', '实际10年') }}</th>
      <th class="grp">{{ t('CPI', 'CPI') }}</th>
      <th>{{ t('GDP', 'GDP') }}</th>
      <th>{{ t('Unemp', '失业') }}</th>
      <th class="grp">{{ t('FX 3m', '汇率3月') }}</th>
      <th>{{ t('Off high', '距高点') }}</th>
      <th>{{ t('DD risk', '回撤风险') }}</th>
      <th class="l">{{ t('Equity stretch', '股市拉伸') }}</th>
    </tr></thead>
    <tbody>
    {% for r in records %}
      {% set m = r.macro %} {% set e = r.equity %} {% set af = r.macro_asof %}
      <tr>
        <td class="l eco"><span class="flg">{{ r.flag }}</span>{{ t(r.name, r.name_zh) }}{% if r.data_limited %} <span class="chip caut" title="thin keyless macro">{{ t('data-limited', '数据有限') }}</span>{% endif %}</td>
        <td class="l"><span class="quad q-{{ r.quad }}">{{ td(r.quad_name) }}</span> <span class="muted small">{{ num(r.confidence,'',2) }}</span></td>
        <td class="grp"><span class="gbar"><span class="gfill g-{{ r.recession_band }}" style="width:{{ r.recession_score or 0 }}%"></span></span>{{ num(r.recession_score,'',0) }}</td>
        <td class="grp">{{ num(m.policy_rate,'%',2) }}</td>
        <td>{{ num(m.yield_10y,'%',2) }}</td>
        <td class="{{ 'neg' if m.curve is not none and m.curve < 0 }}">{{ num(m.curve,'',2) }}</td>
        <td>{{ num(m.real_yield,'',2) }}</td>
        <td class="grp">{{ num(m.cpi_yoy,'%',1) }}{% if af.cpi_yoy %}<span class="stale"> {{ af.cpi_yoy }}</span>{% endif %}</td>
        <td>{{ num(m.gdp_yoy,'%',1) }}</td>
        <td>{{ num(m.unemployment,'%',1) }}</td>
        <td class="grp {{ 'neg' if m.fx_strength_3m is not none and m.fx_strength_3m < 0 else 'pos' if m.fx_strength_3m }}">{{ num(m.fx_strength_3m,'%',1) }}</td>
        <td class="{{ 'neg' if e.off_52w_high is not none and e.off_52w_high < -5 }}">{{ num(e.off_52w_high,'%',1) }}</td>
        <td><span class="gbar"><span class="gfill g-{{ e.drawdown_band }}" style="width:{{ e.drawdown_risk or 0 }}%"></span></span>{{ num(e.drawdown_risk,'',0) }}</td>
        <td class="l">{% if e.ext_grade == 'parabolic' %}<span class="chip warn">{{ t('parabolic', '抛物') }}</span>{% elif e.ext_grade == 'stretched' %}<span class="chip caut">{{ t('stretched', '拉伸') }}</span>{% elif e.bubble_flag %}<span class="chip caut">{{ t('hot', '过热') }}</span>{% else %}<span class="muted small">{{ t('normal', '正常') }}</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="caveat" style="margin-top:9px">{{ t('Display-only / descriptive — no per-country forward backtest is claimed and nothing here feeds a scored signal. No keyless implied-vol exists for these markets, so equity stretch uses own-history extension (in-trend / stretched / parabolic).', '仅供展示 / 描述性 — 不作任何分国前瞻回测主张，亦不构成评分信号。这些市场无免密钥隐含波动率，故股市拉伸采用自身历史的扩张度（趋势内／拉伸／抛物）。') }}</p>
</div>

<!-- ===== Regime heatmap (growth × inflation) ===== -->
<div class="panel">
  <h2>{{ t('Regime map — growth × inflation', '周期图 — 增长 × 通胀') }}</h2>
  <div class="scatter">
    <div class="axx"></div><div class="axy"></div>
    <div class="ql" style="left:6px;top:6px">↖ {{ t('Stagflation', '滞胀') }}</div>
    <div class="ql" style="right:6px;top:6px">{{ t('Reflation', '再通胀') }} ↗</div>
    <div class="ql" style="left:6px;bottom:6px">↙ {{ t('Growth-scare', '增长恐慌') }}</div>
    <div class="ql" style="right:6px;bottom:6px">{{ t('Goldilocks', '金发女孩') }} ↘</div>
    {% for h in heatmap %}
      {% set gx = ((h.growth or 0) + 1) / 2 * 100 %}
      {% set iy = (1 - ((h.inflation or 0) + 1) / 2) * 100 %}
      <div class="pt" style="left:{{ '%.1f'|format(gx) }}%;top:{{ '%.1f'|format(iy) }}%" title="{{ h.name }}: g={{ h.growth }} i={{ h.inflation }}">
        <div class="e">{{ h.flag }}</div><div class="n">{{ h.cc }}</div>
      </div>
    {% endfor %}
  </div>
  <p class="caveat" style="margin-top:8px">{{ t('Horizontal = growth score, vertical = inflation score (−1…+1). Most economies cluster risk-on (growth positive); the inflation axis leans on each economy current CPI direction where fresh, plus oil and the long-yield trend.', '横轴 = 增长得分，纵轴 = 通胀得分（−1…+1）。多数经济体聚集于风险偏好区（增长为正）；通胀轴在数据新鲜处采用各自当前 CPI 方向，并结合油价与长端收益趋势。') }}</p>
</div>

<!-- ===== Rankings ===== -->
<div class="panel">
  <h2>{{ t('Where each economy ranks', '各经济体排名') }}</h2>
  <div class="ranks">
    {% for key in ['recession_score','drawdown_risk','real_yield','yield_10y'] %}
      {% set rk = rankings.get(key) %}
      {% if rk %}
      <div>
        <h3>{{ t(rk.label_en, rk.label_zh) }}</h3>
        {% set vals = rk.rows | map(attribute='value') | list %}
        {% set vmax = vals | map('abs') | max %}
        {% for row in rk.rows %}
          <div class="rb"><span class="flg">{{ row.flag }}</span><span style="width:54px" class="muted">{{ row.cc }}</span>
            <span class="bar"><span class="bf" style="width:{{ '%.0f'|format((row.value|abs) / (vmax or 1) * 100) }}%;background:{{ 'var(--down)' if rk.risk_high else 'var(--up)' }}"></span></span>
            <span class="v">{{ '%.1f'|format(row.value) }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<!-- ===== Eurozone periphery ===== -->
{% if periphery %}
<div class="panel">
  <h2>🇪🇺 {{ t('Eurozone fragmentation — peripheral spreads over Bund', '欧元区分化 — 外围国相对德债利差') }} {{ help('Peripheral 10y yields minus the German Bund, in basis points. Widening = stress / fragmentation risk in the periphery; tightening = convergence. The classic Eurozone tail-risk gauge.', '外围国 10 年期收益率减德国国债，单位基点。走阔 = 外围压力／分化风险；收窄 = 收敛。经典的欧元区尾部风险指标。') }}</h2>
  <table class="sb">
    <thead><tr><th class="l">{{ t('Spread', '利差') }}</th><th>{{ t('bps', '基点') }}</th><th>{{ t('3m change', '3月变化') }}</th><th class="l">{{ t('Read', '读数') }}</th></tr></thead>
    <tbody>
    {% for sp in periphery.spreads %}
      <tr>
        <td class="l"><span class="flg">{{ sp.flag }}</span>{{ sp.label }}</td>
        <td>{{ num(sp.bps,' bps',0) }}</td>
        <td class="{{ 'neg' if sp.widening else 'pos' }}">{% if sp.chg3m_bps is not none %}{{ '%+.0f'|format(sp.chg3m_bps) }}{% else %}—{% endif %}</td>
        <td class="l">{% if sp.widening %}<span class="chip caut">{{ t('widening', '走阔') }}</span>{% else %}<span class="chip ok">{{ t('tightening', '收窄') }}</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="caveat" style="margin-top:7px">{{ t('As of', '截至') }} {{ periphery.asof }} · {{ t('display-only context', '仅供参考的背景') }}</p>
</div>
{% endif %}

<!-- ===== Honesty footer ===== -->
<div class="panel">
  <h2>{{ t('Method & honest limits', '方法与诚实声明') }}</h2>
  <ul class="small muted" style="margin:0;padding-left:18px;line-height:1.7">
    <li>{{ t('All keyless: equity indices & FX via Yahoo; macro via FRED OECD/ECB CSV; the stock universe via iShares UCITS holdings files.', '全部免密钥：股指与汇率来自 Yahoo；宏观来自 FRED OECD/ECB CSV；个股范围来自 iShares UCITS 持仓文件。') }}</li>
    <li>{{ t('Regime / recession / drawdown / bubble reads are descriptive and history-anchored — no forward edge is claimed and none drives a scored buy/sell.', '周期／衰退／回撤／泡沫读数均为描述性且以历史锚定 — 不主张前瞻优势，且不驱动评分买卖。') }}</li>
    <li>{{ t('CPI: FRED OECD series are discontinued for Japan (2021) and lag for the UK/Korea — shown with as-of dates and dropped from scoring when stale. Eurozone uses current Eurostat HICP.', 'CPI：日本（2021 年）FRED OECD 序列已停更，英国／韩国滞后 — 标注截至日期并在过时时退出评分。欧元区采用当前 Eurostat HICP。') }}</li>
    <li>{{ t('Taiwan has the thinnest keyless macro coverage (no yields/CPI on FRED) — flagged data-limited; its read leans on the equity tape.', '台湾的免密钥宏观覆盖最薄（FRED 无收益率/CPI）— 标注数据有限；其读数依赖股市行情。') }}</li>
    <li>{{ t('No keyless implied-vol (VSTOXX / Nikkei-VI / VKOSPI) is available, so equity risk uses realised vol + own-history extension.', '无免密钥隐含波动率（VSTOXX / 日经VI / VKOSPI），故股市风险采用已实现波动率 + 自身历史扩张度。') }}</li>
  </ul>
</div>

{% else %}{# ================= STOCK DASHBOARD ================= #}

<!-- ===== What to act on now (sector board) ===== -->
<div class="panel">
  <h2>{{ t('What to act on now — sector rotation', '现在该关注什么 — 板块轮动') }} {{ help('Region × GICS-sector equal-weight baskets built from the pooled universe constituents, ranked by 3-month relative strength. Each row is flagged by market so you know where the sector is (the buyable analogue is a country/regional sector ETF). Display-only RS — not a forward-edge claim.', '由汇总成分股构建的 地区 × GICS 板块 等权篮子，按 3 个月相对强弱排名。每行标注所属市场（可买入的对应物为相应国家／地区的板块 ETF）。仅展示相对强弱 — 非前瞻收益主张。') }}</h2>
  {% if sector_board %}
  <table class="sb sortable">
    <thead><tr><th>#</th><th class="l">{{ t('Market', '市场') }}</th><th class="l">{{ t('Sector', '板块') }}</th><th>{{ t('60d', '60日') }}</th><th>{{ t('20d', '20日') }}</th><th>{{ t('Trend', '趋势') }}</th><th>{{ t('Names', '数量') }}</th></tr></thead>
    <tbody>
    {% for s in sector_board %}
      <tr class="{{ 'hidden sbmore' if loop.index > 14 }}">
        <td>{{ s.rank }}</td>
        <td class="l"><span class="flg">{{ s.flag }}</span>{{ s.market }}</td>
        <td class="l">{{ s.sector }}</td>
        <td class="{{ 'pos' if s.mom_60d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_60d) }}%</td>
        <td class="{{ 'pos' if s.mom_20d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_20d) }}%</td>
        <td>{% if s.above_trend %}<span class="chip ok">{{ t('up', '上') }}</span>{% else %}<span class="chip">{{ t('down', '下') }}</span>{% endif %}</td>
        <td>{{ s.n }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if sector_board|length > 14 %}<button class="more-btn" data-more="sbmore">{{ t('Show all', '显示全部') }} ({{ sector_board|length }})</button>{% endif %}
  {% else %}<p class="muted small">{{ t('Sector board unavailable.', '板块数据不可用。') }}</p>{% endif %}
</div>

<!-- ===== Standout stocks ===== -->
<div class="panel">
  <h2>{{ t('Standout individual stocks', '个股精选') }} {{ help('Pooled from every market top constituents, ranked by sector-neutral residual momentum computed within each name own market (alpha-led, with the cycle entry as timing). Flagged by country. A relative-strength lens — not a forward-edge claim.', '汇集各市场主要成分股，按各自市场内部的板块中性残差动量排名（阿尔法主导，周期入场为时机）。标注国家。相对强弱视角 — 非前瞻收益主张。') }}</h2>
  {% set buys = (setups.buy if setups else []) %}
  {% if buys %}
  <div class="cards">
    {% for b in buys %}
    <a class="card {{ 'hidden stmore' if loop.index > 12 }}" href="intl_stock.html#{{ b.ticker }}">
      <div class="hd"><span class="flg">{{ b.flag }}</span><span class="tk">{{ b.ticker }}</span>
        <span style="flex:1"></span>
        {% if b.dir %}<span class="lad {{ b.dir }}">{{ b.label or b.state }}</span>{% endif %}</div>
      <div class="muted small" style="margin:3px 0">{{ b.name }}{% if b.sector %} · {{ b.sector }}{% endif %}</div>
      {% if b.spark_svg %}{{ b.spark_svg|safe }}{% endif %}
      <div class="row small" style="gap:10px;margin-top:5px">
        {% if b.alpha is defined and b.alpha is not none %}<span>α <b>{{ '%+.2f'|format(b.alpha) }}</b></span>{% endif %}
        {% if b.price is not none %}<span class="muted">{{ b.price }}</span>{% endif %}
        {% if b.off_high is not none %}<span class="muted">{{ '%.0f'|format(b.off_high) }}% {{ t('off high', '距高') }}</span>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
  {% if buys|length > 12 %}<button class="more-btn" data-more="stmore">{{ t('Show more', '显示更多') }} ({{ buys|length }})</button>{% endif %}
  <p class="caveat" style="margin-top:10px">{{ t('Standout within its own market — alpha is sector-neutral residual momentum computed per market, never pooled raw across currencies. Click a card for the full cycle / momentum breakdown.', '相对其所在市场的精选 — 阿尔法为各市场内部计算的板块中性残差动量，绝不跨币种原始汇总。点击卡片查看完整周期／动量拆解。') }}</p>
  {% else %}<p class="muted small">{{ t('Standouts unavailable — universe still building.', '精选不可用 — 个股库构建中。') }}</p>{% endif %}
</div>

{% endif %}

<script>
document.querySelectorAll('.more-btn[data-more]').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.querySelectorAll('.' + btn.dataset.more).forEach(function(el){ el.classList.remove('hidden'); });
    btn.style.display = 'none';
  });
});
</script>
<script src="theme.js"></script>
<script src="tablesort.js"></script>
</body>
</html>
