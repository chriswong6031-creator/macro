        <span class="rk">{{ t('Real 10y', '实际10年') }}</span><span class="rv {{ 'neg' if r.real_yield is not none and r.real_yield < 0 }}">{{ num(r.real_yield,'',2) }}</span>
        <span class="rk">{{ t('Carry vs US', '对美套息') }}</span><span class="rv {{ 'pos' if r.carry_vs_us is not none and r.carry_vs_us > 0 else 'neg' if r.carry_vs_us is not none and r.carry_vs_us < 0 }}">{% if r.carry_vs_us is not none %}{{ '%+.2f'|format(r.carry_vs_us) }}{% else %}—{% endif %}</span>
