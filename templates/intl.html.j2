  <table class="cmp">
    <thead><tr>
      <th class="l eco">{{ t('Economy', '经济体') }}</th>
      <th class="l">{{ t('1Y · USD', '1年 · 美元') }}</th>
      <th class="l">{{ t('Regime', '周期') }}</th>
      <th class="l">{{ t('State', '状态') }}</th>
      <th class="grp">{{ t('Recession', '衰退') }}</th>
      <th class="grp">{{ t('Policy', '政策利率') }}</th>
      <th>{{ t('10y', '10年') }}</th>
      <th>{{ t('Curve', '曲线') }}</th>
      <th>{{ t('Real 10y', '实际10年') }}</th>
      <th class="grp">{{ t('CPI', 'CPI') }}</th>
      <th>{{ t('GDP', 'GDP') }}</th>
      <th>{{ t('Unemp', '失业') }}</th>
      <th class="grp">{{ t('FX 3m', '汇率3月') }}</th>
      <th>{{ t('Off high', '距高点') }}</th>
      <th>{{ t('Drawdown', '回撤') }} {{ help('Realized damage from the 252-day high — how much has already been lost, not a forward risk estimate.', '距252日高点的已实现回撤——衡量已损失多少，而非前瞻风险预估。') }}</th>
      <th class="l">{{ t('Market state', '市场状态') }}</th>
    </tr></thead>
    <tbody>
    {% for r in records %}
      {% set m = r.macro %} {% set e = r.equity %} {% set af = r.macro_asof %}
