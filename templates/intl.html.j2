<!-- ===== Growth × inflation regime map ===== -->
<div class="panel">
  <h2>{{ t('Regime map — growth × inflation', '周期图 — 增长 × 通胀') }} {{ help('Where each economy sits on the macro clock. Horizontal = growth score, vertical = inflation score (−1…+1). Reflation (top-right) and Goldilocks (bottom-right) are growth-positive; Stagflation (top-left) and Growth-scare (bottom-left) are growth-negative. The inflation axis leans on each economy’s current CPI direction where fresh, plus oil and the long-yield trend.', '每个经济体在宏观时钟上的位置。横轴 = 增长得分，纵轴 = 通胀得分（−1…+1）。再通胀（右上）与金发女孩（右下）增长为正；滞胀（左上）与增长恐慌（左下）增长为负。通胀轴在数据新鲜处采用各自当前 CPI 方向，并结合油价与长端收益趋势。') }}</h2>
  <div class="scatter">
    <div class="axx"></div><div class="axy"></div>
    <div class="ql" style="left:8px;top:8px">↖ {{ t('Stagflation', '滞胀') }}</div>
    <div class="ql" style="right:8px;top:8px">{{ t('Reflation', '再通胀') }} ↗</div>
    <div class="ql" style="left:8px;bottom:8px">↙ {{ t('Growth-scare', '增长恐慌') }}</div>
    <div class="ql" style="right:8px;bottom:8px">{{ t('Goldilocks', '金发女孩') }} ↘</div>
    {% for h in heatmap %}
      {% set gx = 13 + ([[h.growth or 0, -1]|max, 1]|min + 1) / 2 * 74 %}
      {% set iy = 13 + (1 - ([[h.inflation or 0, -1]|max, 1]|min + 1) / 2) * 74 %}
      <div class="pt" style="left:{{ '%.1f'|format(gx) }}%;top:{{ '%.1f'|format(iy) }}%" title="{{ h.name }}: g={{ h.growth }} i={{ h.inflation }}">
        <div class="e">{{ h.flag }}</div><div class="n">{{ h.cc }}</div>
      </div>
    {% endfor %}
  </div>
  <p class="caveat" style="margin-top:8px">{{ t('Most economies cluster risk-on (growth positive). Descriptive snapshot of the growth/inflation mix — not a forward forecast.', '多数经济体聚集于风险偏好区（增长为正）。增长／通胀组合的描述性快照 — 非前瞻预测。') }}</p>
</div>

<!-- ===== Correlation & diversification heatmap ===== -->
{% if CR %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('Cross-market correlation', '跨市场相关性') }} {{ help('Pairwise correlation of the daily USD-return streams (the five international markets + the US) over the trailing window. High everywhere = these markets move together and offer little diversification; lower = real diversification on offer. The average off-diagonal is the one-number read.', '过去窗口内各市场每日美元收益的两两相关性（五个国际市场 + 美国）。处处偏高 = 同涨同跌、分散价值低；偏低 = 存在真正的分散空间。平均非对角值为单一读数。') }}</h2>
    <span style="flex:1"></span>{% if CR.avg_offdiag is not none %}<span class="sub">{{ t('avg', '平均') }} <b style="color:var(--text)">{{ '%.2f'|format(CR.avg_offdiag) }}</b> · {{ CR.window_d }}d</span>{% endif %}</div>
  <div class="heatwrap">
    <table class="heat">
      <thead><tr><th></th>{% for k in CR.order %}<th>{{ CR.labels[k].flag }} {{ k }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for rk in CR.order %}
        {% set ri = loop.index0 %}
        <tr><th class="l">{{ CR.labels[rk].flag }} {{ rk }}</th>
          {% for ck in CR.order %}
            {% set v = CR.cells[ri][loop.index0] %}
            {% if rk == ck %}<td class="diag" style="background:var(--muted)">1</td>
            {% elif v is none %}<td style="background:var(--panel2);color:var(--muted)">—</td>
            {% else %}{% set pct = ([[v, 0]|max, 1]|min * 100)|round|int %}
            <td style="background:color-mix(in srgb, var(--down) {{ pct }}%, var(--up))">{{ '%.2f'|format(v) }}</td>{% endif %}
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="caveat" style="margin-top:9px">{% if CR.read_en %}{{ t(CR.read_en, CR.read_zh) }} · {% endif %}{{ t('Redder = more correlated (less diversification); greener = lower correlation. USD weekly returns (week-end closes, so the five markets’ different holiday calendars line up without injecting spurious zero-return days). Display-only.', '越红 = 相关性越高（分散越少）；越绿 = 相关性越低。美元周度收益（采用周末收盘价，使五个市场不同的假期日历对齐，避免引入虚假的零收益日）。仅供展示。') }}</p>
</div>
{% endif %}

<!-- ===== Rankings ===== -->
<div class="panel">
  <h2>{{ t('Where each economy ranks', '各经济体排名') }}</h2>
  <div class="ranks">
    {% for key in ['recession_score','drawdown_risk','real_yield','yield_10y'] %}
      {% set rk = rankings.get(key) %}
      {% if rk %}
      <div>
        <h3>{{ t(rk.label_en, rk.label_zh) }}</h3>
        {% set vals = rk.rows | map(attribute='value') | list %}
        {% set vmax = vals | map('abs') | max %}
        {% for row in rk.rows %}
          <div class="rb"><span class="flg">{{ row.flag }}</span><span style="width:54px" class="muted">{{ row.cc }}</span>
            <span class="bar"><span class="bf" style="width:{{ '%.0f'|format((row.value|abs) / (vmax or 1) * 100) }}%;background:{{ 'var(--down)' if rk.risk_high else 'var(--up)' }}"></span></span>
            <span class="v">{{ '%.1f'|format(row.value) }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<!-- ===== Method & honest limits ===== -->
<div class="panel">
  <h2>{{ t('Method & honest limits', '方法与诚实声明') }}</h2>
  <ul class="small muted" style="margin:0;padding-left:18px;line-height:1.7">
    <li>{{ t('All keyless: equity indices & FX via Yahoo; macro via FRED OECD/ECB CSV; the stock universe via iShares UCITS holdings files.', '全部免密钥：股指与汇率来自 Yahoo；宏观来自 FRED OECD/ECB CSV；个股范围来自 iShares UCITS 持仓文件。') }}</li>
    <li>{{ t('USD performance rebuilds each price index in dollars (index × FX, or ÷ FX for USD-quoted pairs like USD/JPY); the equity and currency legs are both measured on the same calendar and sum exactly to the USD return. These are PRICE-return indices (no dividends) — fine for cross-market comparison, not a total-return claim.', '美元表现将每个价格指数以美元重建（指数 × 汇率，USD 报价对如美元／日元则 ÷ 汇率）；股票腿与货币腿在同一日历上计量，且精确相加等于美元收益。这些是价格指数（不含股息）—— 适合跨市场对比，非全收益主张。') }}</li>
    <li>{{ t('US-vs-world rotation & correlation use the S&P 500 PRICE index for an apples-to-apples comparison with the other price indices. Relative strength is a focus lens, not a scored signal.', '美国对全球轮动与相关性采用标普500价格指数，以与其他价格指数同口径对比。相对强弱是聚焦视角，非评分信号。') }}</li>
    <li>{{ t('Regime / recession / drawdown / bubble reads are descriptive and history-anchored — no forward edge is claimed and none drives a scored buy/sell.', '周期／衰退／回撤／泡沫读数均为描述性且以历史锚定 — 不主张前瞻优势，且不驱动评分买卖。') }}</li>
    <li>{{ t('CPI: FRED OECD series are discontinued for Japan (2021) and lag for the UK/Korea — shown with as-of dates and dropped from scoring when stale. Eurozone uses current Eurostat HICP.', 'CPI：日本（2021 年）FRED OECD 序列已停更，英国／韩国滞后 — 标注截至日期并在过时时退出评分。欧元区采用当前 Eurostat HICP。') }}</li>
    <li>{{ t('Taiwan has the thinnest keyless macro coverage (no yields/CPI on FRED) — flagged data-limited; its read leans on the equity tape. The liquidity impulse is ECB-only (the one clean keyless weekly CB series).', '台湾的免密钥宏观覆盖最薄（FRED 无收益率/CPI）— 标注数据有限；其读数依赖股市行情。流动性脉冲仅含欧央行（唯一干净的免密钥周度央行序列）。') }}</li>
    <li>{{ t('No keyless implied-vol (VSTOXX / Nikkei-VI / VKOSPI) is available, so equity risk uses realised vol + own-history extension.', '无免密钥隐含波动率（VSTOXX / 日经VI / VKOSPI），故股市风险采用已实现波动率 + 自身历史扩张度。') }}</li>
  </ul>
</div>

{% else %}{# ================= STOCK DASHBOARD ================= #}

<!-- ===== What to act on now (sector board) ===== -->
<div class="panel">
  <h2>{{ t('What to act on now — sector rotation', '现在该关注什么 — 板块轮动') }} {{ help('Region × GICS-sector equal-weight baskets built from the pooled universe constituents, ranked by 3-month relative strength. Each row is flagged by market so you know where the sector is (the buyable analogue is a country/regional sector ETF). Display-only RS — not a forward-edge claim.', '由汇总成分股构建的 地区 × GICS 板块 等权篮子，按 3 个月相对强弱排名。每行标注所属市场（可买入的对应物为相应国家／地区的板块 ETF）。仅展示相对强弱 — 非前瞻收益主张。') }}</h2>
  {% if sector_board %}
  <table class="sb sortable">
    <thead><tr><th>#</th><th class="l">{{ t('Market', '市场') }}</th><th class="l">{{ t('Sector', '板块') }}</th><th>{{ t('60d', '60日') }}</th><th>{{ t('20d', '20日') }}</th><th>{{ t('Trend', '趋势') }}</th><th>{{ t('Names', '数量') }}</th></tr></thead>
    <tbody>
    {% for s in sector_board %}
      <tr class="{{ 'hidden sbmore' if loop.index > 14 }}">
        <td>{{ s.rank }}</td>
        <td class="l"><span class="flg">{{ s.flag }}</span>{{ s.market }}</td>
        <td class="l">{{ s.sector }}</td>
        <td class="{{ 'pos' if s.mom_60d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_60d) }}%</td>
        <td class="{{ 'pos' if s.mom_20d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_20d) }}%</td>
        <td>{% if s.above_trend %}<span class="chip ok">{{ t('up', '上') }}</span>{% else %}<span class="chip">{{ t('down', '下') }}</span>{% endif %}</td>
        <td>{{ s.n }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if sector_board|length > 14 %}<button class="more-btn" data-more="sbmore">{{ t('Show all', '显示全部') }} ({{ sector_board|length }})</button>{% endif %}
  {% else %}<p class="muted small">{{ t('Sector board unavailable.', '板块数据不可用。') }}</p>{% endif %}
</div>

<!-- ===== Standout stocks ===== -->
<div class="panel">
  <h2>{{ t('Standout individual stocks', '个股精选') }} {{ help('Pooled from every market top constituents, ranked by sector-neutral residual momentum computed within each name own market (alpha-led, with the cycle entry as timing). Flagged by country. A relative-strength lens — not a forward-edge claim.', '汇集各市场主要成分股，按各自市场内部的板块中性残差动量排名（阿尔法主导，周期入场为时机）。标注国家。相对强弱视角 — 非前瞻收益主张。') }}</h2>
  {% set buys = (setups.buy if setups else []) %}
  {% if buys %}
  <div class="cards">
    {% for b in buys %}
    <a class="card {{ 'hidden stmore' if loop.index > 12 }}" href="intl_stock.html#{{ b.ticker }}">
      <div class="hd"><span class="flg">{{ b.flag }}</span><span class="tk">{{ b.ticker }}</span>
        <span style="flex:1"></span>
        {% if b.dir %}<span class="lad {{ b.dir }}">{{ b.label or b.state }}</span>{% endif %}</div>
      <div class="muted small" style="margin:3px 0">{{ b.name }}{% if b.sector %} · {{ b.sector }}{% endif %}</div>
      {% if b.spark_svg %}{{ b.spark_svg|safe }}{% endif %}
      <div class="row small" style="gap:10px;margin-top:5px">
        {% if b.alpha is defined and b.alpha is not none %}<span>α <b>{{ '%+.2f'|format(b.alpha) }}</b></span>{% endif %}
        {% if b.price is not none %}<span class="muted">{{ b.price }}</span>{% endif %}
        {% if b.off_high is not none %}<span class="muted">{{ '%.0f'|format(b.off_high) }}% {{ t('off high', '距高') }}</span>{% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
  {% if buys|length > 12 %}<button class="more-btn" data-more="stmore">{{ t('Show more', '显示更多') }} ({{ buys|length }})</button>{% endif %}
  <p class="caveat" style="margin-top:10px">{{ t('Standout within its own market — alpha is sector-neutral residual momentum computed per market, never pooled raw across currencies. Click a card for the full cycle / momentum breakdown.', '相对其所在市场的精选 — 阿尔法为各市场内部计算的板块中性残差动量，绝不跨币种原始汇总。点击卡片查看完整周期／动量拆解。') }}</p>
  {% else %}<p class="muted small">{{ t('Standouts unavailable — universe still building.', '精选不可用 — 个股库构建中。') }}</p>{% endif %}
</div>

{% endif %}

<script>
document.querySelectorAll('.more-btn[data-more]').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.querySelectorAll('.' + btn.dataset.more).forEach(function(el){ el.classList.remove('hidden'); });
    btn.style.display = 'none';
  });
});
</script>

{% if mode != 'stocks' and perf and perf.leaderboard %}
<script>window.INTL_PERF = {{ perf | tojson }};</script>
<script>
(function(){
  var P = window.INTL_PERF; if (!P || !P.leaderboard) return;
  var board = document.getElementById('lb-board'); if (!board) return;
  function fmt(x){ return (x >= 0 ? '+' : '') + x.toFixed(1) + '%'; }
  function render(h){
    var rows = P.leaderboard.filter(function(b){ return b.returns[h]; });
    rows.sort(function(a, b){ return b.returns[h].usd - a.returns[h].usd; });
    var maxabs = 1;
    rows.forEach(function(r){ var x = r.returns[h]; maxabs = Math.max(maxabs, Math.abs(x.usd), Math.abs(x.local)); });
    function px(v){ return 50 + (v / maxabs) * 48; }   // % on the axis, 0 at centre (50%)
    board.innerHTML = rows.map(function(r){
      var x = r.returns[h], usd = x.usd, loc = x.local, fxc = x.fx;
      var x0 = px(0), xl = px(loc), xu = px(usd);
      var eqL = Math.min(x0, xl), eqW = Math.abs(xl - x0);
      var fxL = Math.min(xl, xu), fxW = Math.abs(xu - xl);
      var fxCls = fxc >= 0 ? 'fx-pos' : 'fx-neg';
      return '<div class="lb-row">'
        + '<div class="eco"><span class="flg">' + r.flag + '</span><span>'
          + '<span class="l-en">' + r.name + '</span><span class="l-zh">' + (r.name_zh || r.name) + '</span>'
          + '<small>' + r.index_name + '</small></span></div>'
        + '<div class="lb-spark">' + (r.spark_svg || '') + '</div>'
        + '<div class="lb-bar"><div class="axis"></div>'
          + '<div class="lb-seg equity" style="left:' + eqL + '%;width:' + eqW + '%"></div>'
          + '<div class="lb-seg ' + fxCls + '" style="left:' + fxL + '%;width:' + fxW + '%"></div>'
          + '<div class="lb-usd" style="left:' + xu + '%"></div></div>'
        + '<div class="lb-vals"><span class="big ' + (usd >= 0 ? 'pos' : 'neg') + '">' + fmt(usd) + '</span>'
          + '<small><span class="l-en">eq </span><span class="l-zh">股 </span>' + fmt(loc)
          + ' · <span class="l-en">fx </span><span class="l-zh">汇 </span>' + fmt(fxc) + '</small></div>'
        + '</div>';
    }).join('');
  }
  render('12m');
  var seg = document.getElementById('lb-seg');
  if (seg) seg.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click', function(){
      seg.querySelectorAll('button').forEach(function(b){ b.classList.remove('on'); });
      btn.classList.add('on'); render(btn.dataset.h);
    });
  });
})();
</script>
{% endif %}
<script src="theme.js"></script>
<script src="tablesort.js"></script>
</body>
</html>
