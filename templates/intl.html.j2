        {# vel_20d: 20-day yield velocity — arrow + value, Tier-2 z-score tip #}
        {% if r.vel_20d_bp is defined and r.vel_20d_bp is not none %}
        {% set _vdir = '↑' if r.vel_20d_bp > 0 else '↓' if r.vel_20d_bp < 0 else '→' %}
        {% set _vcls = 'neg' if r.vel_20d_bp > 0 else 'pos' if r.vel_20d_bp < 0 else '' %}
        {% set _vz_tip_en = '20-day yield velocity: ' ~ ('%+.1f'|format(r.vel_20d_bp)) ~ ' bp. Z-score vs 3y: ' ~ ('%+.2f'|format(r.vel_20d_z) if r.vel_20d_z is defined and r.vel_20d_z is not none else '—') ~ '. Rising yields = bond price headwind.' %}
        {% set _vz_tip_zh = '20日利率变化速度：' ~ ('%+.1f'|format(r.vel_20d_bp)) ~ ' bp。相对3年Z分数：' ~ ('%+.2f'|format(r.vel_20d_z) if r.vel_20d_z is defined and r.vel_20d_z is not none else '—') ~ '。利率上升 = 债券价格逆风。' %}
        <span class="rk">{{ t('10y vel 20d', '10年20日速度') }}</span>
