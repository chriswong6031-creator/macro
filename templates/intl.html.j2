      <tr>
        <td class="l eco"><span class="flg">{{ r.flag }}</span>{{ t(r.name, r.name_zh) }}{% if r.data_limited %} <span class="chip caut">{{ t('data-limited', '数据有限') }}</span>{% endif %}</td>
        <td class="l">{% if sb and sb[0].spark_svg %}{{ sb[0].spark_svg|safe }}{% else %}<span class="muted">—</span>{% endif %}</td>
        <td class="l"><span class="quad q-{{ r.quad }}">{{ td(r.quad_name) }}</span> <span class="muted small">{{ num(r.confidence,'',2) }}</span></td>
        <td class="l">
          {% if _rt %}
            <span class="ts-chip ts-{{ _rt.state }}">
              <span class="l-en">{{ _rt.state_en }}</span><span class="l-zh">{{ _rt.state_zh }}</span>
            </span>
          {% else %}<span class="muted small">—</span>{% endif %}
        </td>
        <td class="grp"><span class="gbar"><span class="gfill g-{{ r.recession_band }}" style="width:{{ r.recession_score or 0 }}%"></span></span>{{ num(r.recession_score,'',0) }}</td>
        <td class="grp">{{ num(m.policy_rate,'%',2) }}</td>
        <td>{{ num(m.yield_10y,'%',2) }}</td>
        <td class="{{ 'neg' if m.curve is not none and m.curve < 0 }}">{{ num(m.curve,'',2) }}</td>
        <td>{{ num(m.real_yield,'',2) }}</td>
        <td class="grp">{{ num(m.cpi_yoy,'%',1) }}{% if af.cpi_yoy %}<span class="stale"> {{ af.cpi_yoy }}</span>{% endif %}</td>
        <td>{{ num(m.gdp_yoy,'%',1) }}</td>
        <td>{{ num(m.unemployment,'%',1) }}</td>
        <td class="grp {{ 'neg' if m.fx_strength_3m is not none and m.fx_strength_3m < 0 else 'pos' if m.fx_strength_3m }}">{{ num(m.fx_strength_3m,'%',1) }}</td>
        <td class="{{ 'neg' if e.off_52w_high is not none and e.off_52w_high < -5 }}">{{ num(e.off_52w_high,'%',1) }}</td>
        <td><span class="gbar"><span class="gfill g-{{ e.drawdown_band }}" style="width:{{ e.drawdown_risk or 0 }}%"></span></span>{{ num(e.drawdown_risk,'',0) }}</td>
        <td class="l">
          {% if _rt %}
            <span class="ts-chip ts-{{ _rt.state }}">
              <span class="l-en">{{ _rt.state_en }}</span><span class="l-zh">{{ _rt.state_zh }}</span>
            </span>
          {% elif e.ext_grade == 'parabolic' %}<span class="chip warn">{{ t('parabolic', '抛物') }}</span>
          {% elif e.ext_grade == 'stretched' %}<span class="chip caut">{{ t('stretched', '拉伸') }}</span>
          {% elif e.bubble_flag %}<span class="chip caut">{{ t('hot', '过热') }}</span>
          {% else %}<span class="muted small">{{ t('normal', '正常') }}</span>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="caveat" style="margin-top:9px">{{ t("Descriptive only. Equity stretch uses each market's own history.", '仅描述。股市拉伸按各市场自身历史衡量。') }}</p>
</div>

