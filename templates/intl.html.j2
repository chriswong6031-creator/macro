        <span class="rk">{{ t('52-week', '52周') }}</span><span class="rv {{ 'neg' if (LQ.chg_52w or 0) < 0 else 'pos' }}">{% if LQ.chg_52w is not none %}{{ '%+.1f'|format(LQ.chg_52w) }}%{% else %}—{% endif %}</span>
        <span class="rk">{{ t('As of', '截至') }}</span><span class="rv" style="font-weight:600;color:var(--muted)">{{ LQ.asof }}</span>
