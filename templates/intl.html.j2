{% if mode == 'stocks' %}
<div class="panel">
  <div class="row">
    <h1>🌍 {{ t('International Stock Dashboard', '国际股票看板') }}</h1>
    <span style="flex:1"></span>
    <span class="muted small">{{ t('data through', '数据截至') }} {{ latest.date }} · {{ t('built', '生成') }} {{ built }}</span>
  </div>
  <p class="muted small" style="margin:6px 0 0">{{ t('Standout names from major non-US markets, ranked within their own market. Search any name above.', '主要非美市场精选个股，按各自市场内部排序。可在上方搜索。') }}
    <a href="intl.html" style="color:var(--link);font-weight:600">← {{ t('Macro comparison', '宏观对比') }}</a></p>
</div>
{% endif %}

{% if mode != 'stocks' %}{# ================= MACRO COMPARISON ================= #}
{% set GR = perf.global_read if perf else None %}
{% set RK = perf.risk_appetite if perf else None %}
{% set RG = perf.rrg if perf else None %}
{% set CR = perf.correlation if perf else None %}
{% set LB = perf.leaderboard if perf else [] %}

<!-- ===== Flagship stage hero ===== -->
<div class="stage">
  <span class="stage-flag">🌍 {{ t('Global Macro Compass', '全球宏观罗盘') }}</span>
  <div class="stage-h1">{{ t('International Economies', '国际经济体') }}</div>
  {% if GR %}<p class="stage-read">{{ t(GR.en, GR.zh) }}</p>{% endif %}
  <div class="kpis">
    <div class="kpi"><div class="k">{{ t('Dominant regime', '主导周期') }}</div>
      <div class="v">{{ td(S.dominant_quad) }}</div><div class="s">{{ S.n }} {{ t('economies', '经济体') }}</div></div>
    {% if RK %}<div class="kpi"><div class="k">{{ t('Risk appetite', '风险偏好') }}</div>
      <div class="v {{ RK.tone }}">{{ RK.score|int }} <span class="s" style="font-size:12px;font-weight:600">/100</span></div>
      <div class="dial" style="--p:{{ '%.2f'|format(RK.score/100) }}"></div>
      <div class="s">{{ t(RK.label_en, RK.label_zh) }} · {{ RK.breadth_above_200d }} {{ t('above 200d', '站上200日') }}</div></div>{% endif %}
    {% if RG %}<div class="kpi"><div class="k">{{ t('US vs World', '美国 vs 全球') }}</div>
      <div class="v" style="font-size:15px;line-height:1.2">{{ t(RG.tilt_en, RG.tilt_zh) }}</div>
      <div class="s">{{ RG.n_leading }}/{{ RG.n }} {{ t('ex-US markets gaining', '非美市场占优') }}</div></div>{% endif %}
    {% if LB %}{% set bestr = LB[0] %}{% set bh = (bestr.returns.get('12m') or bestr.returns.get('6m') or bestr.returns.get('3m') or bestr.returns.get('ytd') or bestr.returns.get('1m')) %}
    {% if bh %}<div class="kpi"><div class="k">{{ t('USD leader', '美元领涨') }}</div>
      <div class="v up">{{ bestr.flag }} {{ bestr.cc }}</div>
      <div class="s">{{ '%+.0f'|format(bh.usd) }}% {{ t('in USD', '美元计') }}</div></div>{% endif %}{% endif %}
    <div class="kpi"><div class="k">{{ t('Recession-watch', '衰退观察') }}</div>
      <div class="v {{ 'warn' if S.recession_watch else '' }}">{{ S.recession_watch }}</div>
      <div class="s">{{ t('of', '共') }} {{ S.n }} · {{ t('drawdown-watch', '回撤观察') }} {{ S.drawdown_watch }}</div></div>
    {% if CR and CR.avg_offdiag is not none %}<div class="kpi"><div class="k">{{ t('Avg correlation', '平均相关性') }}</div>
      <div class="v">{{ '%.2f'|format(CR.avg_offdiag) }}</div><div class="s">{{ t('cross-market, USD', '跨市场，美元') }}</div></div>{% endif %}
  </div>
  <p class="caveat" style="margin-top:13px">{{ t('data through', '数据截至') }} {{ latest.date }} · {{ t('built', '生成') }} {{ built }} · {{ t('context only', '仅作背景') }}
    · <a href="intl_stocks.html" style="color:var(--link);font-weight:700">{{ t('Stock dashboard', '股票看板') }} →</a></p>
</div>

<!-- ===== USD performance leaderboard (centerpiece) ===== -->
{% if LB %}
<div class="panel accent">
  <div class="sec-h"><h2>{{ t('Performance in US dollars', '以美元计的表现') }} {{ help('Shows each market in USD, split into local stock return and currency effect. Price return only.', '以美元看各市场表现，并拆成股市涨跌与汇率影响。仅价格回报。') }}</h2>
    <span class="sub">{{ t('local equity + currency = USD return', '本币股票 + 货币 = 美元收益') }}</span>
    <span style="flex:1"></span>
    <div class="seg" id="lb-seg">{% for h in perf.horizons %}<button type="button" data-h="{{ h.key }}"{% if h.key == '12m' %} class="on"{% endif %}>{{ t(h.en, h.zh) }}</button>{% endfor %}</div>
  </div>
  <div class="lb" id="lb-board"></div>
  <div class="lb-legend">
    <span><i style="background:color-mix(in srgb,var(--info) 55%,transparent)"></i>{{ t('local equity', '本币股票') }}</span>
    <span><i style="background:var(--up)"></i>{{ t('currency tailwind', '货币顺风') }}</span>
    <span><i style="background:var(--down)"></i>{{ t('currency drag', '货币拖累') }}</span>
    <span><i style="background:var(--text);width:3px;height:13px;border-radius:2px"></i>{{ t('net USD return', '美元净收益') }}</span>
  </div>
</div>
{% endif %}

<!-- ===== US vs the World rotation (RRG) ===== -->
{% if RG %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('US vs the World — capital rotation', '美国 vs 全球 — 资本轮动') }} {{ help('Maps who is beating the US and whether that lead is improving or fading. Display-only.', '显示谁跑赢美国，以及领先是在增强还是减弱。仅展示。') }}</h2>
    <span style="flex:1"></span><span class="tilt {{ RG.tilt }}">{{ t(RG.tilt_en, RG.tilt_zh) }}</span></div>
  <div class="twocol">
    <div class="rrg">
      <div class="ax h"></div><div class="ax v"></div>
      <div class="ql impr">↖ {{ t('Improving', '改善') }}</div><div class="ql lead">{{ t('Leading', '领先') }} ↗</div>
      <div class="ql lag">↙ {{ t('Lagging', '落后') }}</div><div class="ql weak">{{ t('Weakening', '走弱') }} ↘</div>
      <div class="axl" style="left:6px;top:50%;transform:translateY(-50%)">{{ t('behind US', '落后美国') }}</div>
      <div class="axl" style="right:6px;top:50%;transform:translateY(-50%)">{{ t('ahead', '领先') }}</div>
      {% for r in RG.rows %}
        {% set lv = [[r.rs_level, 60]|max, 140]|min %}
        {% set mo = [[r.rs_mom, -25]|max, 25]|min %}
        {% set xp = 8 + (lv - 60) / 80 * 84 %}
        {% set yp = 8 + (25 - mo) / 50 * 84 %}
        <div class="pt q-{{ r.q }}" style="left:{{ '%.1f'|format(xp) }}%;top:{{ '%.1f'|format(yp) }}%" title="{{ r.name }} · level {{ r.rs_level }} · mom {{ r.rs_mom }}">
          <div class="dot"></div><div class="e">{{ r.flag }}</div><div class="n">{{ r.cc }}</div>
        </div>
      {% endfor %}
    </div>
    <div>
      <table class="sb">
        <thead><tr><th class="l">{{ t('Market', '市场') }}</th><th class="l">{{ t('Phase', '阶段') }}</th><th>{{ t('vs US 3m', '对美3月') }}</th><th>{{ t('6m', '6月') }}</th><th>{{ t('12m', '12月') }}</th></tr></thead>
        <tbody>
        {% for r in RG.rows %}
          <tr><td class="l"><span class="flg">{{ r.flag }}</span>{{ t(r.name, r.name_zh) }}</td>
            <td class="l"><span class="tilt q-{{ r.q }}" style="padding:2px 8px;font-size:11px">{% if r.q=='lead' %}{{ t('Leading','领先') }}{% elif r.q=='impr' %}{{ t('Improving','改善') }}{% elif r.q=='weak' %}{{ t('Weakening','走弱') }}{% else %}{{ t('Lagging','落后') }}{% endif %}</span></td>
            <td class="{{ 'pos' if (r.rel_ret.get('3m') or 0) >= 0 else 'neg' }}">{% if r.rel_ret.get('3m') is not none %}{{ '%+.1f'|format(r.rel_ret['3m']) }}%{% else %}—{% endif %}</td>
            <td class="{{ 'pos' if (r.rel_ret.get('6m') or 0) >= 0 else 'neg' }}">{% if r.rel_ret.get('6m') is not none %}{{ '%+.1f'|format(r.rel_ret['6m']) }}%{% else %}—{% endif %}</td>
            <td class="{{ 'pos' if (r.rel_ret.get('12m') or 0) >= 0 else 'neg' }}">{% if r.rel_ret.get('12m') is not none %}{{ '%+.1f'|format(r.rel_ret['12m']) }}%{% else %}—{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="caveat" style="margin-top:10px">{{ t('Positive = beat the S&P 500 over that window. Relative-strength lens only.', '正值 = 该周期跑赢标普500。仅相对强弱视角。') }}</p>
    </div>
  </div>
</div>
{% endif %}

<!-- ===== Cross-country comparison grid (the reference table) ===== -->
<div class="panel">
  <h2>{{ t('Cross-country comparison', '跨国对比') }} {{ help('Same scorecard for every economy: regime, recession risk, rates, CPI, FX, and equity stretch.', '每个经济体用同一套表：周期、衰退风险、利率、CPI、汇率与股市拉伸。') }}</h2>
  <div class="gridwrap">
  <table class="cmp">
    <thead><tr>
      <th class="l eco">{{ t('Economy', '经济体') }}</th>
      <th class="l">{{ t('1Y · USD', '1年 · 美元') }}</th>
      <th class="l">{{ t('Regime', '周期') }}</th>
      <th class="grp">{{ t('Recession', '衰退') }}</th>
      <th class="grp">{{ t('Policy', '政策利率') }}</th>
      <th>{{ t('10y', '10年') }}</th>
      <th>{{ t('Curve', '曲线') }}</th>
      <th>{{ t('Real 10y', '实际10年') }}</th>
      <th class="grp">{{ t('CPI', 'CPI') }}</th>
      <th>{{ t('GDP', 'GDP') }}</th>
      <th>{{ t('Unemp', '失业') }}</th>
      <th class="grp">{{ t('FX 3m', '汇率3月') }}</th>
      <th>{{ t('Off high', '距高点') }}</th>
      <th>{{ t('DD risk', '回撤风险') }}</th>
      <th class="l">{{ t('Equity stretch', '股市拉伸') }}</th>
    </tr></thead>
    <tbody>
    {% for r in records %}
      {% set m = r.macro %} {% set e = r.equity %} {% set af = r.macro_asof %}
      {% set sb = (LB | selectattr('cc', 'equalto', r.cc) | list) %}
      <tr>
        <td class="l eco"><span class="flg">{{ r.flag }}</span>{{ t(r.name, r.name_zh) }}{% if r.data_limited %} <span class="chip caut" title="thin keyless macro">{{ t('data-limited', '数据有限') }}</span>{% endif %}</td>
        <td class="l">{% if sb and sb[0].spark_svg %}{{ sb[0].spark_svg|safe }}{% else %}<span class="muted">—</span>{% endif %}</td>
        <td class="l"><span class="quad q-{{ r.quad }}">{{ td(r.quad_name) }}</span> <span class="muted small">{{ num(r.confidence,'',2) }}</span></td>
        <td class="grp"><span class="gbar"><span class="gfill g-{{ r.recession_band }}" style="width:{{ r.recession_score or 0 }}%"></span></span>{{ num(r.recession_score,'',0) }}</td>
        <td class="grp">{{ num(m.policy_rate,'%',2) }}</td>
        <td>{{ num(m.yield_10y,'%',2) }}</td>
        <td class="{{ 'neg' if m.curve is not none and m.curve < 0 }}">{{ num(m.curve,'',2) }}</td>
        <td>{{ num(m.real_yield,'',2) }}</td>
        <td class="grp">{{ num(m.cpi_yoy,'%',1) }}{% if af.cpi_yoy %}<span class="stale"> {{ af.cpi_yoy }}</span>{% endif %}</td>
        <td>{{ num(m.gdp_yoy,'%',1) }}</td>
        <td>{{ num(m.unemployment,'%',1) }}</td>
        <td class="grp {{ 'neg' if m.fx_strength_3m is not none and m.fx_strength_3m < 0 else 'pos' if m.fx_strength_3m }}">{{ num(m.fx_strength_3m,'%',1) }}</td>
        <td class="{{ 'neg' if e.off_52w_high is not none and e.off_52w_high < -5 }}">{{ num(e.off_52w_high,'%',1) }}</td>
        <td><span class="gbar"><span class="gfill g-{{ e.drawdown_band }}" style="width:{{ e.drawdown_risk or 0 }}%"></span></span>{{ num(e.drawdown_risk,'',0) }}</td>
        <td class="l">{% if e.ext_grade == 'parabolic' %}<span class="chip warn">{{ t('parabolic', '抛物') }}</span>{% elif e.ext_grade == 'stretched' %}<span class="chip caut">{{ t('stretched', '拉伸') }}</span>{% elif e.bubble_flag %}<span class="chip caut">{{ t('hot', '过热') }}</span>{% else %}<span class="muted small">{{ t('normal', '正常') }}</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="caveat" style="margin-top:9px">{{ t('Descriptive only. Equity stretch uses each market’s own history.', '仅描述。股市拉伸按各市场自身历史衡量。') }}</p>
</div>

<!-- ===== Rates & curve desk ===== -->
{% if rates %}
{% set AN = rates.anchor %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('Rates & curve desk', '利率与曲线室') }} {{ help('Compares yield curves, real yields, 10-year yield drift, and carry vs the US.', '比较收益率曲线、实际利率、10年利率变化，以及相对美国的套息。') }}</h2>
    <span style="flex:1"></span>
    {% if AN.y10 is not none %}<span class="sub">{{ t('US anchor', '美国锚') }}: <b style="color:var(--text)">{{ AN.y10 }}%</b> 10y · {{ AN.y2 }}% 2y · {{ t('curve', '曲线') }} {{ '%+.2f'|format(AN.curve) if AN.curve is not none else '—' }}</span>{% endif %}
  </div>
  <div class="rdesk">
    {% for r in rates.rows %}
    <div class="rcard">
      <div class="rh"><span class="flg">{{ r.flag }}</span><b>{{ t(r.name, r.name_zh) }}</b>
        <span class="shape {{ r.shape }}">{{ t(r.shape_en, r.shape_zh) }}</span></div>
      {% if r.y10 is not none %}
      <div class="curve" style="--c:{% if r.shape=='inverted' %}var(--down){% elif r.shape=='flat' %}var(--warn){% else %}var(--link){% endif %}">
        {% set sx = [[(r.short or 0) / 7 * 100, 4]|max, 96]|min %}
        {% set tx = [[r.y10 / 7 * 100, 4]|max, 96]|min %}
        <div class="ln" style="left:{{ '%.0f'|format([sx, tx]|min) }}%;width:{{ '%.0f'|format((sx - tx)|abs) }}%"></div>
        <div class="d" style="left:{{ '%.0f'|format(sx) }}%"></div><div class="lab" style="left:{{ '%.0f'|format(sx) }}%">3m {{ num(r.short,'',1) }}</div>
        <div class="d" style="left:{{ '%.0f'|format(tx) }}%"></div><div class="lab" style="left:{{ '%.0f'|format(tx) }}%">10y {{ num(r.y10,'',1) }}</div>
      </div>
      <div class="rgrid">
        <span class="rk">{{ t('Curve 10y−3m', '曲线 10年−3月') }}</span><span class="rv {{ 'neg' if r.curve is not none and r.curve < 0 }}">{{ num(r.curve,'',2) }}</span>
        <span class="rk">{{ t('Real 10y', '实际10年') }}</span><span class="rv {{ 'neg' if r.real_yield is not none and r.real_yield < 0 }}">{{ num(r.real_yield,'',2) }}</span>
        <span class="rk">{{ t('Carry vs US', '对美套息') }}</span><span class="rv {{ 'pos' if r.carry_vs_us is not none and r.carry_vs_us > 0 else 'neg' if r.carry_vs_us is not none and r.carry_vs_us < 0 }}">{% if r.carry_vs_us is not none %}{{ '%+.2f'|format(r.carry_vs_us) }}{% else %}—{% endif %}</span>
        <span class="rk">{{ t('10y · 3m drift', '10年 · 3月漂移') }}</span><span class="rv {{ 'neg' if r.y10_chg3m is not none and r.y10_chg3m > 0 else 'pos' if r.y10_chg3m is not none and r.y10_chg3m < 0 }}">{% if r.y10_chg3m is not none %}{{ '%+.2f'|format(r.y10_chg3m) }}{% else %}—{% endif %}</span>
      </div>
      {% if r.spark_svg %}<div style="margin-top:8px;opacity:.85">{{ r.spark_svg|safe }}</div>{% endif %}
      {% else %}
      <p class="muted small" style="margin:6px 0">{{ t('No keyless yield curve for this market — read leans on the equity tape.', '该市场无免密钥收益率曲线 — 读数依赖股市行情。') }}</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="twocol" style="margin-top:14px">
    <!-- Eurozone periphery -->
    {% if rates.periphery %}
    <div>
      <h3>🇪🇺 {{ t('Eurozone fragmentation — peripheral spreads over Bund', '欧元区分化 — 外围国相对德债利差') }} {{ help('Wider spreads mean more Eurozone stress; tighter spreads mean calmer conditions.', '利差走阔代表欧元区压力上升；收窄代表环境更稳。') }}</h3>
      <table class="sb">
        <thead><tr><th class="l">{{ t('Spread', '利差') }}</th><th>{{ t('bps', '基点') }}</th><th>{{ t('3m', '3月') }}</th><th class="l">{{ t('Read', '读数') }}</th></tr></thead>
        <tbody>
        {% for sp in rates.periphery.spreads %}
          <tr><td class="l"><span class="flg">{{ sp.flag }}</span>{{ t(sp.label, sp.label_zh) }}</td>
            <td>{{ num(sp.bps,' bps',0) }}</td>
            <td class="{{ 'neg' if sp.widening else 'pos' }}">{% if sp.chg3m_bps is not none %}{{ '%+.0f'|format(sp.chg3m_bps) }}{% else %}—{% endif %}</td>
            <td class="l">{% if sp.widening %}<span class="chip caut">{{ t('widening', '走阔') }}</span>{% else %}<span class="chip ok">{{ t('tightening', '收窄') }}</span>{% endif %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      <p class="caveat" style="margin-top:6px">{{ t('As of', '截至') }} {{ rates.periphery.asof }}</p>
    </div>
    {% endif %}
    <!-- ECB liquidity impulse -->
    {% if rates.liquidity %}
    {% set LQ = rates.liquidity %}
    <div class="rcard {{ '' }}" style="align-self:start">
      <div class="rh"><span class="flg">🏦</span><b>{{ t('ECB balance-sheet impulse', '欧央行资产负债表脉冲') }}</b>
        <span class="shape {{ 'inverted' if LQ.draining else 'normal' }}" style="--c:{{ 'var(--down)' if LQ.draining else 'var(--up)' }}">{{ t('QT', '缩表') if LQ.draining else t('easing', '宽松') }}</span></div>
      <div class="rgrid">
        <span class="rk">{{ t('Total assets', '总资产') }}</span><span class="rv">€{{ '%.2f'|format(LQ.level_eur_tn) }}T</span>
        <span class="rk">{{ t('13-week', '13周') }}</span><span class="rv {{ 'neg' if (LQ.chg_13w or 0) < 0 else 'pos' }}">{% if LQ.chg_13w is not none %}{{ '%+.1f'|format(LQ.chg_13w) }}%{% else %}—{% endif %}</span>
        <span class="rk">{{ t('52-week', '52周') }}</span><span class="rv {{ 'neg' if (LQ.chg_52w or 0) < 0 else 'pos' }}">{% if LQ.chg_52w is not none %}{{ '%+.1f'|format(LQ.chg_52w) }}%{% else %}—{% endif %}</span>
        <span class="rk">{{ t('As of', '截至') }}</span><span class="rv" style="font-weight:600;color:var(--muted)">{{ LQ.asof }}</span>
      </div>
      {% if LQ.spark_svg %}<div style="margin-top:8px;opacity:.85">{{ LQ.spark_svg|safe }}</div>{% endif %}
      <p class="caveat" style="margin-top:6px">{{ t(LQ.read_en, LQ.read_zh) }} · {{ t('ECB-only clean weekly series.', '仅欧央行周度序列。') }}</p>
    </div>
    {% endif %}
  </div>
</div>
{% endif %}

<!-- ===== Growth × inflation regime map ===== -->
<div class="panel">
  <h2>{{ t('Regime map — growth × inflation', '周期图 — 增长 × 通胀') }} {{ help('Places each economy on the growth/inflation clock. Right side = better growth; top = more inflation pressure.', '把每个经济体放在增长/通胀时钟上。右侧增长更好；上方通胀压力更高。') }}</h2>
  <div class="scatter">
    <div class="axx"></div><div class="axy"></div>
    <div class="ql" style="left:8px;top:8px">↖ {{ t('Stagflation', '滞胀') }}</div>
    <div class="ql" style="right:8px;top:8px">{{ t('Reflation', '再通胀') }} ↗</div>
    <div class="ql" style="left:8px;bottom:8px">↙ {{ t('Growth-scare', '增长恐慌') }}</div>
    <div class="ql" style="right:8px;bottom:8px">{{ t('Goldilocks', '金发女孩') }} ↘</div>
    {% for h in heatmap %}
      {% set gx = 13 + ([[h.growth or 0, -1]|max, 1]|min + 1) / 2 * 74 %}
      {% set iy = 13 + (1 - ([[h.inflation or 0, -1]|max, 1]|min + 1) / 2) * 74 %}
      <div class="pt" style="left:{{ '%.1f'|format(gx) }}%;top:{{ '%.1f'|format(iy) }}%" title="{{ h.name }}: g={{ h.growth }} i={{ h.inflation }}">
        <div class="e">{{ h.flag }}</div><div class="n">{{ h.cc }}</div>
      </div>
    {% endfor %}
  </div>
  <p class="caveat" style="margin-top:8px">{{ t('Snapshot only, not a forecast.', '仅快照，非预测。') }}</p>
</div>

<!-- ===== Correlation & diversification heatmap ===== -->
{% if CR %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('Cross-market correlation', '跨市场相关性') }} {{ help('Shows whether markets are moving together. Lower correlation means better diversification.', '显示各市场是否同涨同跌。相关性越低，分散越好。') }}</h2>
    <span style="flex:1"></span>{% if CR.avg_offdiag is not none %}<span class="sub">{{ t('avg', '平均') }} <b style="color:var(--text)">{{ '%.2f'|format(CR.avg_offdiag) }}</b> · {{ CR.window_d }}d</span>{% endif %}</div>
  <div class="heatwrap">
    <table class="heat">
      <thead><tr><th></th>{% for k in CR.order %}<th>{{ CR.labels[k].flag }} {{ k }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for rk in CR.order %}
        {% set ri = loop.index0 %}
        <tr><th class="l">{{ CR.labels[rk].flag }} {{ rk }}</th>
          {% for ck in CR.order %}
            {% set v = CR.cells[ri][loop.index0] %}
            {% if rk == ck %}<td class="diag" style="background:var(--muted)">1</td>
            {% elif v is none %}<td style="background:var(--panel2);color:var(--muted)">—</td>
            {% else %}{% set pct = ([[v, 0]|max, 1]|min * 100)|round|int %}
            <td style="background:color-mix(in srgb, var(--down) {{ pct }}%, var(--up))">{{ '%.2f'|format(v) }}</td>{% endif %}
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="caveat" style="margin-top:9px">{% if CR.read_en %}{{ t(CR.read_en, CR.read_zh) }} · {% endif %}{{ t('Red = more correlated; green = more diversifying. Display-only.', '红 = 相关更高；绿 = 更能分散。仅展示。') }}</p>
</div>
{% endif %}

<!-- ===== Rankings ===== -->
<div class="panel">
  <h2>{{ t('Where each economy ranks', '各经济体排名') }}</h2>
  <div class="ranks">
    {% for key in ['recession_score','drawdown_risk','real_yield','yield_10y'] %}
      {% set rk = rankings.get(key) %}
      {% if rk %}
      <div>
        <h3>{{ t(rk.label_en, rk.label_zh) }}</h3>
        {% set vals = rk.rows | map(attribute='value') | list %}
        {% set vmax = vals | map('abs') | max %}
        {% for row in rk.rows %}
          <div class="rb"><span class="flg">{{ row.flag }}</span><span style="width:54px" class="muted">{{ row.cc }}</span>
            <span class="bar"><span class="bf" style="width:{{ '%.0f'|format((row.value|abs) / (vmax or 1) * 100) }}%;background:{{ 'var(--down)' if rk.risk_high else 'var(--up)' }}"></span></span>
            <span class="v">{{ '%.1f'|format(row.value) }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% else %}{# ================= STOCK DASHBOARD ================= #}

<!-- ===== What to act on now (sector board) ===== -->
<div class="panel">
  <h2>{{ t('What to act on now — sector rotation', '现在该关注什么 — 板块轮动') }} {{ help('Ranks regional sectors by 3-month relative strength. Display-only.', '按3个月相对强弱排列地区板块。仅展示。') }}</h2>
  {% if sector_board %}
  <table class="sb sortable">
    <thead><tr><th>#</th><th class="l">{{ t('Market', '市场') }}</th><th class="l">{{ t('Sector', '板块') }}</th><th>{{ t('60d', '60日') }}</th><th>{{ t('20d', '20日') }}</th><th>{{ t('Trend', '趋势') }}</th><th>{{ t('Names', '数量') }}</th></tr></thead>
    <tbody>
    {% for s in sector_board %}
      <tr class="{{ 'hidden sbmore' if loop.index > 14 }}">
        <td>{{ s.rank }}</td>
        <td class="l"><span class="flg">{{ s.flag }}</span>{{ s.market }}</td>
        <td class="l">{{ s.sector }}</td>
        <td class="{{ 'pos' if s.mom_60d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_60d) }}%</td>
        <td class="{{ 'pos' if s.mom_20d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_20d) }}%</td>
        <td>{% if s.above_trend %}<span class="chip ok">{{ t('up', '上') }}</span>{% else %}<span class="chip">{{ t('down', '下') }}</span>{% endif %}</td>
        <td>{{ s.n }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if sector_board|length > 14 %}<button class="more-btn" data-more="sbmore">{{ t('Show all', '显示全部') }} ({{ sector_board|length }})</button>{% endif %}
  {% else %}<p class="muted small">{{ t('Sector board unavailable.', '板块数据不可用。') }}</p>{% endif %}
</div>

<!-- ===== Standout stocks ===== -->
<div class="panel">
  <h2>{{ t('Standout individual stocks', '个股精选') }} {{ help('Stocks showing stronger momentum than peers in their own market and sector. Not a forecast.', '相对本市场、本板块更强的个股。非预测。') }}</h2>
  {% set buys = (setups.buy if setups else []) %}
  {% if buys %}
  <div class="cards">
    {% for b in buys %}
    <a class="card {{ 'hidden stmore' if loop.index > 12 }}" href="intl_stock.html#{{ b.ticker }}">
      <div class="hd"><span class="flg">{{ b.flag }}</span><span class="tk">{{ b.ticker }}</span>
        <span style="flex:1"></span>
        {% if b.dir %}<span class="lad {{ b.dir }}">{{ b.label or b.state }}</span>{% endif %}</div>
      <div class="muted small" style="margin:3px 0">{{ b.name }}{% if b.sector %} · {{ b.sector }}{% endif %}</div>
      {% if b.spark_svg %}{{ b.spark_svg|safe }}{% endif %}
      <div class="row small" style="gap:10px;margin-top:5px">
        {% if b.alpha is defined and b.alpha is not none %}<span>α <b>{{ '%+.2f'|format(b.alpha) }}</b></span>{% endif %}
        {% if b.price is not none %}<span class="nb-px muted" data-sym="{{ b.ticker }}" data-mkt="intl">{{ b.price }}</span>{% endif %}
        {% if b.off_high is not none %}<span class="muted">{{ '%.0f'|format(b.off_high) }}% {{ t('off high', '距高') }}</span>{% endif %}
      </div>
      {# volatility black hole (vol_squeeze) chip — single-stock vol black hole, close-only #}
      {% set _vs = b.vol_squeeze %}
      {% if _vs and _vs.state in ['COILED','FIRED_UP','FIRED_DOWN','EXPANSION'] %}
      <div class="nb-vf">
        <span class="nb-vchip {{ {'COILED':'vf-coil','FIRED_UP':'vf-up','FIRED_DOWN':'vf-down','EXPANSION':'vf-exp'}[_vs.state] }}" data-tip-en="{{ 'Volatility is compressed; a move may be setting up.' if _vs.state=='COILED' else 'Volatility has already expanded.' }}" data-tip-zh="{{ '波动压缩，可能在酝酿行情。' if _vs.state=='COILED' else '波动已扩张。' }}">{% if _vs.state=='COILED' %}🌀 {{ t('Move loading','蓄势待发') }}{% elif _vs.state=='FIRED_UP' %}🚀 {{ t('Firing↑','向上突破') }}{% elif _vs.state=='FIRED_DOWN' %}🔻 {{ t('Firing↓','向下突破') }}{% else %}💥 {{ t('Already moving','已在异动') }}{% endif %}</span>
      </div>{% endif %}
      {# forward-cone honesty note (favourable risk SHAPE the factor axes don't price) #}
      {% if b.notes %}{% for nt in b.notes %}<div class="nb-note nb-note-{{ nt.kind }}"><span class="l-en">ℹ {{ nt.en }}</span><span class="l-zh">ℹ {{ nt.zh }}</span></div>{% endfor %}{% endif %}
    </a>
    {% endfor %}
  </div>
  {% if buys|length > 12 %}<button class="more-btn" data-more="stmore">{{ t('Show more', '显示更多') }} ({{ buys|length }})</button>{% endif %}
  <p class="caveat" style="margin-top:10px">{{ t('Each card is ranked against its own market. Click for details.', '每张卡片都相对自身市场排序。点击查看详情。') }}</p>
  {% else %}<p class="muted small">{{ t('Standouts unavailable — universe still building.', '精选不可用 — 个股库构建中。') }}</p>{% endif %}
</div>

{% endif %}

<script>
document.querySelectorAll('.more-btn[data-more]').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.querySelectorAll('.' + btn.dataset.more).forEach(function(el){ el.classList.remove('hidden'); });
    btn.style.display = 'none';
  });
});
</script>

{% if mode != 'stocks' and perf and perf.leaderboard %}
<script>window.INTL_PERF = {{ perf | tojson }};</script>
<script>
(function(){
  var P = window.INTL_PERF; if (!P || !P.leaderboard) return;
  var board = document.getElementById('lb-board'); if (!board) return;
  function fmt(x){ return (x >= 0 ? '+' : '') + x.toFixed(1) + '%'; }
  function render(h){
    var rows = P.leaderboard.filter(function(b){ return b.returns[h]; });
    rows.sort(function(a, b){ return b.returns[h].usd - a.returns[h].usd; });
    var maxabs = 1;
    rows.forEach(function(r){ var x = r.returns[h]; maxabs = Math.max(maxabs, Math.abs(x.usd), Math.abs(x.local)); });
    function px(v){ return 50 + (v / maxabs) * 48; }   // % on the axis, 0 at centre (50%)
    board.innerHTML = rows.map(function(r){
      var x = r.returns[h], usd = x.usd, loc = x.local, fxc = x.fx;
      var x0 = px(0), xl = px(loc), xu = px(usd);
      var eqL = Math.min(x0, xl), eqW = Math.abs(xl - x0);
      var fxL = Math.min(xl, xu), fxW = Math.abs(xu - xl);
      var fxCls = fxc >= 0 ? 'fx-pos' : 'fx-neg';
      return '<div class="lb-row">'
        + '<div class="eco"><span class="flg">' + r.flag + '</span><span>'
          + '<span class="l-en">' + r.name + '</span><span class="l-zh">' + (r.name_zh || r.name) + '</span>'
          + '<small>' + r.index_name + '</small></span></div>'
        + '<div class="lb-spark">' + (r.spark_svg || '') + '</div>'
        + '<div class="lb-bar"><div class="axis"></div>'
          + '<div class="lb-seg equity" style="left:' + eqL + '%;width:' + eqW + '%"></div>'
          + '<div class="lb-seg ' + fxCls + '" style="left:' + fxL + '%;width:' + fxW + '%"></div>'
          + '<div class="lb-usd" style="left:' + xu + '%"></div></div>'
        + '<div class="lb-vals"><span class="big ' + (usd >= 0 ? 'pos' : 'neg') + '">' + fmt(usd) + '</span>'
          + '<small><span class="l-en">eq </span><span class="l-zh">股 </span>' + fmt(loc)
          + ' · <span class="l-en">fx </span><span class="l-zh">汇 </span>' + fmt(fxc) + '</small></div>'
        + '</div>';
    }).join('');
  }
  render('12m');
  var seg = document.getElementById('lb-seg');
  if (seg) seg.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click', function(){
      seg.querySelectorAll('button').forEach(function(b){ b.classList.remove('on'); });
      btn.classList.add('on'); render(btn.dataset.h);
    });
  });
})();
</script>
{% endif %}
<script src="theme.js"></script>
<script src="tablesort.js"></script>
</body>
</html>
