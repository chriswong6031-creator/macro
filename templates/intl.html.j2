    <span class="sub">{{ t('local equity + currency = USD return', '本币股票 + 货币 = 美元收益') }}</span>
    {% if bench_note is defined and bench_note %}<span class="muted small" style="margin-left:4px">{{ bench_note }}</span>{% endif %}
    <span style="flex:1"></span>
    <div class="seg" id="lb-seg">
      {% if rotation_ranks %}<button type="button" data-h="__rank__" class="on">{{ t('Rotation rank', '轮动排名') }}</button>{% endif %}
