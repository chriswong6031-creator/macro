      {{ help('Flags countries where structural vulnerabilities coincide: debt-to-GDP above 70% and rising, fiscal deficit below −5% of GDP, or current account deficit below −3% of GDP. BIS credit gap where available. Source: IMF WEO 2025. Annual data — updates with IMF WEO releases. Berg &amp; Pattillo (1999) criterion adapted. Presence of a flag = vulnerabilities exist, not that a crisis is imminent; most historically flagged countries did not experience a crisis.', '标记存在结构性脆弱因素的国家：债务/GDP超过70%且上升、财政赤字低于GDP的−5%，或经常账户赤字低于GDP的−3%。BIS信用缺口（可用时）。来源：IMF WEO 2025。年度数据——随IMF WEO发布更新。改编自Berg &amp; Pattillo（1999）标准。有标记 = 脆弱性存在，不代表危机即将发生；历史上大多数预警未演变为危机。') }}</h2>
    <span class="sub">{{ t('Slow-moving structural vulnerabilities — not a timing signal', '缓慢变化的结构性脆弱因素——非择时信号') }}</span>
  </div>

  {%- set VULN = RD.get('vulnerability') %}
  {%- if VULN and VULN.get('countries') %}
    {%- set flagged = VULN.get('countries') | selectattr('fragile', 'equalto', true) | list %}
    {%- if not flagged %}
    <p class="muted" style="font-size:13px;line-height:1.6;padding:12px 0;">
      {{ t('No economy currently shows three or more concurrent structural warnings — the fragility map is clear.', '目前没有经济体同时亮起三项及以上结构性预警——脆弱性地图暂无标记。') }}
    </p>
    {%- endif %}
    {%- for c in flagged[:3] %}
    <div class="ird-frag-row">
      <span style="font-size:20px;flex-shrink:0;">{{ c.get('flag', '🌐') }}</span>
      <div>
        <div class="ird-frag-country">{{ t(c.get('name_en', c.get('cc','')), c.get('name_zh', c.get('cc',''))) }}</div>
        <span class="ird-frag-desc">{{ t(c.get('desc_en', ''), c.get('desc_zh', '')) }}</span>
        <div class="ird-frag-tags">
          {%- for tag in c.get('tags', []) %}
          <span class="chip warn" style="font-size:10px;padding:1px 6px;">{{ t(tag.get('en',''), tag.get('zh','')) }}</span>
          {%- endfor %}
        </div>
      </div>
    </div>
    {%- endfor %}
    {%- if flagged | length > 3 %}
    <details style="margin-top:8px;">
      <summary class="more-btn" style="list-style:none;cursor:pointer;">
        {{ t('View all ' + (flagged|length|string) + ' flagged countries →', '查看全部' + (flagged|length|string) + '个预警国家 →') }}
      </summary>
      <div style="margin-top:8px;">
        {%- for c in flagged[3:] %}
        <div class="ird-frag-row">
          <span style="font-size:20px;flex-shrink:0;">{{ c.get('flag', '🌐') }}</span>
          <div>
            <div class="ird-frag-country">{{ t(c.get('name_en', c.get('cc','')), c.get('name_zh', c.get('cc',''))) }}</div>
            <span class="ird-frag-desc">{{ t(c.get('desc_en',''), c.get('desc_zh','')) }}</span>
          </div>
        </div>
        {%- endfor %}
      </div>
    </details>
    {%- endif %}
  {%- else %}
    {# vulnerability is null — honest null with plain-words explanation #}
    <p class="muted" style="font-size:13px;line-height:1.6;padding:12px 0;">
      {{ t('Fragility data updates with the IMF World Economic Outlook — available here after the next WEO release. This is a slow-moving lens: it changes annually, not daily.', '脆弱性数据随IMF《世界经济展望》更新——下次WEO发布后将在此呈现。这是缓慢变化的视角：按年更新，非按日。') }}
    </p>
  {%- endif %}

  <p class="caveat ird-asof">
    {{ t('Slow-moving fundamentals — flags fragility, not timing; most historical warnings did not become crises.', '缓慢变化的基本面指标——揭示脆弱性，非择时信号；历史上大多数预警并未演变为危机。') }}
    {{ help('Berg &amp; Pattillo (1999) criterion adapted: debt &gt;70% GDP and rising, fiscal balance &lt;−5%, current account &lt;−3%. Source: IMF WEO 2025. BIS credit gap where available. Annual data — updates with IMF WEO releases.', 'Berg &amp; Pattillo（1999）改编标准：债务&gt;70% GDP且上升，财政余额&lt;−5%，经常账户&lt;−3%。来源：IMF WEO 2025。BIS信用缺口（可用时）。年度数据——随IMF WEO发布更新。') }}
    {{ t('Data as of IMF WEO 2025 (where available)', '数据来源：IMF WEO 2025（可用时）') }}
  </p>
</div><!-- /fragility -->

{% endif %}{# end risk_desk section #}

{# ── CGL Directed Pressure Table (CGL W1, 2026-07-17).
   Shows who is pressing on whom right now — one row per market, sorted by
   pressure pct descending. Outer guard: CGL is defined AND non-empty. Renders
   NOTHING when the artifact is absent (progressive enhancement; zero visual
   change to existing layout). Plain-word glance tier only: no "GFEVD", "VAR",
   "spillover matrix", no raw percentile numbers. Level → Low/Building/High pill.
   Receipts (linkage weight) live in the chip labels — each chip shows the source
   name and weight%. Nulls-printed: data gaps disclosed in a footer line. #}
{% if CGL is defined and CGL and mode != 'stocks' %}
{#- helpers -#}
{%- set _cgl_pressure = CGL.pressure if CGL.pressure is defined else {} -%}
{%- set _cgl_severity = CGL.severity if CGL.severity is defined else {} -%}
{%- set _cgl_gaps = CGL.gaps if CGL.gaps is defined else [] -%}
{#- market display names EN/ZH — covers all 11 CGL markets -#}
{%- set _cgl_mkt_names = {
  'us': ('United States', '美国'),
  'cn': ('China',         '中国'),
  'hk': ('Hong Kong',     '香港'),
  'ca': ('Canada',        '加拿大'),
  'kr': ('South Korea',   '韩国'),
  'jp': ('Japan',         '日本'),
  'tw': ('Taiwan',        '台湾'),
  'in': ('India',         '印度'),
  'au': ('Australia',     '澳大利亚'),
  'gb': ('United Kingdom','英国'),
  'ez': ('Euro area',     '欧元区')
} -%}
{#- collect + sort rows by pct desc -#}
{%- set _cgl_rows = namespace(v=[]) -%}
{%- for mkt, blk in _cgl_pressure.items() -%}
  {%- if blk -%}
    {%- set _pct = blk.pct if (blk.pct is defined and blk.pct is not none) else 0 -%}
    {%- set _cgl_rows.v = _cgl_rows.v + [{'mkt': mkt, 'blk': blk, 'pct': _pct}] -%}
  {%- endif -%}
{%- endfor -%}
{%- set _cgl_sorted = _cgl_rows.v | sort(attribute='pct', reverse=true) -%}
<div class="panel">
  <div class="sec-h">
    <h2>{{ t('Where crash pressure is flowing now', '冲击压力的实时流向') }}
      {{ help('How much inbound pressure each market is absorbing from markets that are actually falling — measured from economic linkages and current crash depth. Low / Building / High reflects the severity relative to the past two years. Top sources show which markets are driving the pressure. Source: trade, financial and supply-chain linkages blended with recent price action. Display only — not a signal to trade.', '每个市场正在吸收多少来自真实下跌市场的输入压力——由经济联系与当前跌幅共同衡量。低/升温/高反映过去两年的相对严重程度。压力来源显示哪些市场是主要驱动力。数据来源：贸易、金融与供应链联系，结合近期价格走势。仅作展示，非交易信号。') }}</h2>
    <span class="sub">{{ t('Measured from market connections and who is actually falling', '由市场关联与实际下跌方共同衡量') }}</span>
  </div>
  {%- if _cgl_sorted %}
  <div style="margin-top:8px;">
    {%- for row in _cgl_sorted %}
    {%- set mkt = row.mkt -%}
    {%- set blk = row.blk -%}
    {%- set _names = _cgl_mkt_names.get(mkt, (mkt, mkt)) -%}
    {%- set _lv = blk.level if (blk.level is defined and blk.level) else 'low' -%}
    {%- set _lv_chip = 'warn' if _lv == 'high' else ('caut' if _lv == 'moderate' else 'ok') -%}
    {%- set _svr = _cgl_severity.get(mkt, {}) -%}
    {%- set _is_source = _svr and (_svr.sigma is defined) and (_svr.sigma is not none) and (_svr.sigma >= 0.5) -%}
    {%- set _pct_bar = ((blk.pct if blk.pct is not none else 0) * 100) | round | int -%}
    <div class="ird-tx-row" style="align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--line);">
      <span style="min-width:120px;font-size:12.5px;font-weight:600;">
        <span class="l-en">{{ _names[0] }}</span><span class="l-zh">{{ _names[1] }}</span>
      </span>
      <span class="chip {{ _lv_chip }}" style="font-size:10px;padding:1px 6px;white-space:nowrap;">
        {%- if _lv == 'high' %}<span class="l-en">High</span><span class="l-zh">高</span>
        {%- elif _lv == 'moderate' %}<span class="l-en">Building</span><span class="l-zh">升温</span>
        {%- else %}<span class="l-en">Low</span><span class="l-zh">低</span>
        {%- endif %}
      </span>
      <div class="ird-tx-bar-wrap" style="flex:1;min-width:40px;max-width:90px;">
        <div class="ird-tx-bar" style="width:{{ _pct_bar }}%"></div>
      </div>
      {%- if blk.top_exporters is defined and blk.top_exporters %}
      <span style="display:flex;flex-wrap:wrap;gap:3px;flex:1;min-width:0;">
        {%- for exp in blk.top_exporters[:3] %}
        {%- set _en = exp.name_en if (exp.name_en is defined and exp.name_en) else (exp.market if exp.market is defined else '?') -%}
        {%- set _zh = exp.name_zh if (exp.name_zh is defined and exp.name_zh) else _en -%}
        {%- set _wt = ((exp.weight * 100) | round(0) | int | string ~ '%') if (exp.weight is defined and exp.weight is not none) else '' -%}
        <span class="rrx-rec-chip" style="font-size:10px;">
          <span class="l-en">{{ _en }}{% if _wt %} ({{ _wt }}){% endif %}</span>
          <span class="l-zh">{{ _zh }}{% if _wt %} ({{ _wt }}){% endif %}</span>
        </span>
        {%- endfor %}
      </span>
      {%- endif %}
      {%- if _is_source %}
      <span class="chip warn" style="font-size:9.5px;padding:1px 5px;white-space:nowrap;">
        <span class="l-en">exporting risk</span><span class="l-zh">风险输出方</span>
      </span>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  {%- else %}
  <p class="muted small">{{ t('Directed pressure data not available yet', '定向传导压力数据暂不可用') }}</p>
  {%- endif %}
  {%- if _cgl_gaps %}
  <p class="caveat ird-asof" style="margin-top:8px;">
    <span class="l-en">Some links running on structural weights only tonight ({{ _cgl_gaps | length }} data gaps).</span>
    <span class="l-zh">今晚部分联系仅依靠结构权重运行（{{ _cgl_gaps | length }} 项数据缺口）。</span>
  </p>
  {%- endif %}
</div><!-- /cgl-directed-pressure -->
{% endif %}{# end CGL directed pressure #}

<!-- ===== ACT 4 — reference desk (deep dive) ===== -->
<div class="act-h"><span class="aq">{{ t('The deep dive', '深入细察') }}</span><span class="as">{{ t('Regime clock, cross-market correlations and league tables — the why behind the reads.', '周期时钟、跨市场相关性与排行——各项读数背后的「为什么」。') }}</span></div>
<details class="ref-fold">
  <summary><span class="rf-t">{{ t('Regimes, correlations & rankings', '周期、相关性与排名') }}</span><span class="rf-s">{{ t('Growth × inflation map · correlation heatmap · league tables', '增长×通胀图 · 相关性热力图 · 排行榜') }}</span><span class="rf-caret" aria-hidden="true">▾</span></summary>
<!-- ===== Growth × inflation regime map ===== -->
<div class="panel">
  <h2>{{ t('Regime map — growth × inflation', '周期图 — 增长 × 通胀') }} {{ help('Places each economy on the growth/inflation clock. Right side = better growth; top = more inflation pressure.', '把每个经济体放在增长/通胀时钟上。右侧增长更好；上方通胀压力更高。') }}</h2>
  <div class="scatter">
    <div class="axx"></div><div class="axy"></div>
    <div class="ql" style="left:8px;top:8px">↖ {{ t('Stagflation', '滞胀') }}</div>
    <div class="ql" style="right:8px;top:8px">{{ t('Reflation', '再通胀') }} ↗</div>
    <div class="ql" style="left:8px;bottom:8px">↙ {{ t('Growth-scare', '增长恐慌') }}</div>
    <div class="ql" style="right:8px;bottom:8px">{{ t('Goldilocks', '金发女孩') }} ↘</div>
    {% for h in heatmap %}
      {% set gx = 13 + ([[h.growth or 0, -1]|max, 1]|min + 1) / 2 * 74 %}
      {% set iy = 13 + (1 - ([[h.inflation or 0, -1]|max, 1]|min + 1) / 2) * 74 %}
      <div class="pt" style="left:{{ '%.1f'|format(gx) }}%;top:{{ '%.1f'|format(iy) }}%" title="{{ h.name }}: g={{ h.growth }} i={{ h.inflation }}">
        <div class="e">{{ h.flag }}</div><div class="n">{{ h.cc }}</div>
      </div>
    {% endfor %}
  </div>
  <p class="caveat" style="margin-top:8px">{{ t('Snapshot only, not a forecast.', '仅快照，非预测。') }}</p>
</div>

<!-- ===== Correlation & diversification heatmap ===== -->
{% if CR %}
<div class="panel">
  <div class="sec-h"><h2>{{ t('Cross-market correlation', '跨市场相关性') }} {{ help('Shows whether markets are moving together. Lower correlation means better diversification.', '显示各市场是否同涨同跌。相关性越低，分散越好。') }}</h2>
    <span style="flex:1"></span>{% if CR.avg_offdiag is not none %}<span class="sub">{{ t('avg', '平均') }} <b style="color:var(--text)">{{ '%.2f'|format(CR.avg_offdiag) }}</b> · {{ CR.window_d }}d</span>{% endif %}</div>
  <div class="heatwrap">
    <table class="heat">
      <thead><tr><th></th>{% for k in CR.order %}<th>{{ CR.labels[k].flag }} {{ k }}</th>{% endfor %}</tr></thead>
      <tbody>
      {% for rk in CR.order %}
        {% set ri = loop.index0 %}
        <tr><th class="l">{{ CR.labels[rk].flag }} {{ rk }}</th>
          {% for ck in CR.order %}
            {% set v = CR.cells[ri][loop.index0] %}
            {% if rk == ck %}<td class="diag" style="background:var(--muted)">1</td>
            {% elif v is none %}<td style="background:var(--panel2);color:var(--muted)">—</td>
            {% else %}{% set pct = ([[v, 0]|max, 1]|min * 100)|round|int %}
            <td style="background:color-mix(in srgb, var(--down) {{ pct }}%, var(--up))">{{ '%.2f'|format(v) }}</td>{% endif %}
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="caveat" style="margin-top:9px">{% if CR.read_en %}{{ t(CR.read_en, CR.read_zh) }} · {% endif %}{{ t('Red = more correlated; green = more diversifying. Display-only.', '红 = 相关更高；绿 = 更能分散。仅展示。') }}</p>
</div>
{% endif %}

<!-- ===== Rankings ===== -->
<div class="panel">
  <h2>{{ t('Where each economy ranks', '各经济体排名') }}</h2>
  <div class="ranks">
    {# ---- mom20 momentum ranking (prepended, guarded) ---- #}
    {% if rotation_ranks is defined and rotation_ranks %}
    <div>
      <h3>{{ t('20d momentum — rotation rank', '20日动能 — 轮动排名') }}</h3>
      {% for rr in rotation_ranks %}
        <div class="rb"><span class="flg">{{ rr.flag if rr.flag is defined else '' }}</span><span style="width:54px" class="muted">{{ rr.cc }}</span>
          <span class="bar"><span class="bf" style="width:{{ '%.0f'|format([[rr.score, 0]|max, 3]|min / 3 * 100) }}%;background:{{ 'var(--down)' if rr.gov is defined and rr.gov < 1 else 'var(--link)' }}"></span></span>
          <span class="v">#{{ rr.rank }}</span>
          {% if rr.note_en is defined and rr.note_en %}<span class="muted small" style="margin-left:4px"><span class="l-en">{{ rr.note_en }}</span><span class="l-zh">{{ rr.note_zh if rr.note_zh is defined else rr.note_en }}</span></span>{% endif %}
        </div>
      {% endfor %}
    </div>
    {% endif %}
    {% for key in ['recession_score','drawdown_risk','real_yield','yield_10y'] %}
      {% set rk = rankings.get(key) %}
      {% if rk %}
      <div>
        <h3>{{ t(rk.label_en, rk.label_zh) }}</h3>
        {% set vals = rk.rows | map(attribute='value') | list %}
        {% set vmax = vals | map('abs') | max %}
        {% for row in rk.rows %}
          <div class="rb"><span class="flg">{{ row.flag }}</span><span style="width:54px" class="muted">{{ row.cc }}</span>
            <span class="bar"><span class="bf" style="width:{{ '%.0f'|format((row.value|abs) / (vmax or 1) * 100) }}%;background:{{ 'var(--down)' if rk.risk_high else 'var(--up)' }}"></span></span>
            <span class="v">{{ '%.1f'|format(row.value) }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

</details><!-- /ref-fold B -->

{% else %}{# ================= STOCK DASHBOARD ================= #}

<!-- ===== What to act on now (sector board) ===== -->
<div class="panel">
  <h2>{{ t('What to act on now — sector rotation', '现在该关注什么 — 板块轮动') }} {{ help('Ranks regional sectors by 3-month relative strength. Display-only.', '按3个月相对强弱排列地区板块。仅展示。') }}</h2>
  {% if sector_board %}
  <table class="sb sortable">
    <thead><tr><th>#</th><th class="l">{{ t('Market', '市场') }}</th><th class="l">{{ t('Sector', '板块') }}</th><th>{{ t('60d', '60日') }}</th><th>{{ t('20d', '20日') }}</th><th>{{ t('Trend', '趋势') }}</th><th>{{ t('Names', '数量') }}</th></tr></thead>
    <tbody>
    {% for s in sector_board %}
      <tr class="{{ 'hidden sbmore' if loop.index > 14 }}">
        <td>{{ s.rank }}</td>
        <td class="l"><span class="flg">{{ s.flag }}</span>{{ s.market }}</td>
        <td class="l">{{ s.sector }}</td>
        <td class="{{ 'pos' if s.mom_60d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_60d) }}%</td>
        <td class="{{ 'pos' if s.mom_20d > 0 else 'neg' }}">{{ '%+.1f'|format(s.mom_20d) }}%</td>
        <td>{% if s.above_trend %}<span class="chip ok">{{ t('up', '上') }}</span>{% else %}<span class="chip">{{ t('down', '下') }}</span>{% endif %}</td>
        <td>{{ s.n }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if sector_board|length > 14 %}<button class="more-btn" data-more="sbmore">{{ t('Show all', '显示全部') }} ({{ sector_board|length }})</button>{% endif %}
  {% else %}<p class="muted small">{{ t('Sector board unavailable.', '板块数据不可用。') }}</p>{% endif %}
</div>

<!-- ===== Standout stocks ===== -->
<div class="panel">
  <h2>{{ t('Prophet Stock Signals', '先知选股') }} {{ help('Stocks showing stronger momentum than peers in their own market and sector. Not a forecast.', '相对本市场、本板块更强的个股。非预测。') }}</h2>
  {% set buys = (setups.buy if setups else []) %}
  {% if buys %}
  {# shared progressive "See more" — theme.js initShowMore inserts the .sm-bar
     (Show N more / Show all / Show fewer) after this grid, matching the US /
     China / HK / Canada standout boards. 3 rows shown initially, per width. #}
  {{ pv.pv_css() }}
  <div class="cards" data-showmore-rows="3">
    {% for b in buys %}
    {# ═══ PROPHET CARD (flagship redesign 2026-07-21) — INTL momentum screen. No entry
       gauge exists for INTL (residual momentum, unvalidated), so verbs stay honest: never
       a solid BUY — near/hold/wait/avoid from the cycle label + direction. The Edge slot
       carries the momentum-screen α reading under a "Mom" label (not a validated score);
       vol-squeeze fired + forward-cone honesty notes fold into the ⚠N popover. #}
    {% set _lbl = ((b.label or b.state or '')|upper) %}
    {% set _verb = 'near' if ('BUY' in _lbl or 'TURN' in _lbl)
             else ('hold' if ('RALLY' in _lbl or 'UPTREND' in _lbl)
             else ('wait' if ('BOTTOM' in _lbl or 'BOUNCE' in _lbl)
             else ('avoid' if ('TOP' in _lbl or 'ROLL' in _lbl or 'DECLINE' in _lbl or b.dir == 'down')
             else ('near' if b.dir == 'up' else 'wait')))) %}
    {% set _stage = 4 if ('RALLY' in _lbl or 'UPTREND' in _lbl)
             else (3 if 'BUY' in _lbl
             else (2 if 'TURN' in _lbl
             else (1 if ('BOTTOM' in _lbl or 'BOUNCE' in _lbl) else 0))) %}
    {% set _vs = b.vol_squeeze %}
    {% set _fl = namespace(rows=[]) %}
    {% if _vs and _vs.state in ('FIRED_UP','EXPANSION') %}{% set _fl.rows = _fl.rows + [('Already moving — quiet entry may be gone', '已在异动 — 安静入场点可能已过')] %}{% endif %}
    {% if b.notes %}{% for nt in b.notes %}{% set _fl.rows = _fl.rows + [(nt.en, nt.zh or nt.en)] %}{% endfor %}{% endif %}
    {% set _tip_en = ((b.label or b.state or '') ~ ' — stronger momentum than market peers; a screen, not a forecast') ~ (' · volatility coiled' if (_vs and _vs.state == 'COILED') else '') %}
    {% set _tip_zh = ((b.label or b.state or '') ~ ' — 相对本市场动量更强；筛选，非预测') ~ (' · 波动压缩' if (_vs and _vs.state == 'COILED') else '') %}
    {{ pv.pv_card({
      'href': 'intl_stock.html#' ~ b.ticker, 'tk': b.ticker, 'mkt': 'intl', 'flag': b.flag,
      'name': b.name, 'sec': b.sector,
      'price_txt': (b.price ~ '') if b.price is not none else none,
      'verb': _verb, 'tip_en': _tip_en, 'tip_zh': _tip_zh,
      'edge': none,
      'edge_txt': ('%+.2f'|format(b.alpha)) if (b.alpha is defined and b.alpha is not none) else none,
      'edge_label_en': 'Mom', 'edge_label_zh': '动量',
      'edge_tip_en': 'Momentum screen reading (residual α vs its own market) — not a validated score.',
      'edge_tip_zh': '动量筛选读数（相对自身市场的残差α）— 不是经验证评分。',
      'stage': _stage, 'spark': b.get('spark_svg'),
      'zone_kind': 'note',
      'zone_note_en': 'Momentum screen — no entry zone',
      'zone_note_zh': '动量筛选 — 无买入区',
      'date': (setups.get('as_of') if setups else none),
      'flags': _fl.rows
    }) }}
    {% endfor %}
  </div>
  <p class="caveat" style="margin-top:10px">{{ t('Each card is ranked against its own market. Click for details.', '每张卡片都相对自身市场排序。点击查看详情。') }}</p>
  {% else %}<p class="muted small">{{ t('Prophet signals unavailable — universe still building.', '先知选股不可用 — 个股库构建中。') }}</p>{% endif %}
</div>

{% endif %}

</main><!-- /intl-flow -->

<script>
document.querySelectorAll('.more-btn[data-more]').forEach(function(btn){
  btn.addEventListener('click', function(){
    document.querySelectorAll('.' + btn.dataset.more).forEach(function(el){ el.classList.remove('hidden'); });
    btn.style.display = 'none';
  });
});
</script>

{% if mode != 'stocks' and perf and perf.leaderboard %}
{# perf carries a server-side pd.Series under 'bench' (not JSON-serializable) — strip it before tojson #}
{% set _perf_json = {} %}
{% for _pk, _pv in perf.items() if _pk != 'bench' %}{% set _ = _perf_json.__setitem__(_pk, _pv) %}{% endfor %}
<script>window.INTL_PERF = {{ _perf_json | tojson }};</script>
{% if rotation_ranks is defined and rotation_ranks %}
<script>window.INTL_RANKS = {{ rotation_ranks | tojson }};</script>
{% endif %}
<script>
(function(){
  var P = window.INTL_PERF; if (!P || !P.leaderboard) return;
  var board = document.getElementById('lb-board'); if (!board) return;
  // Build cc -> rotation rank lookup
  var rankLookup = {};
  if (window.INTL_RANKS) {
    window.INTL_RANKS.forEach(function(rr){ rankLookup[rr.cc] = rr; });
  }
  // Build cc -> turn state lookup (from leaderboard entries that carry turn)
  var turnLookup = {};
  P.leaderboard.forEach(function(r){ if (r.turn) { turnLookup[r.cc] = r.turn; } });

  function fmt(x){ return (x >= 0 ? '+' : '') + x.toFixed(1) + '%'; }
  function stateChip(cc){
    var t = turnLookup[cc]; if (!t) return '';
    return '<span class="ts-chip ts-' + t.state + '" style="margin-left:4px">'
      + '<span class="l-en">' + (t.state_en || t.state) + '</span>'
      + '<span class="l-zh">' + (t.state_zh || t.state) + '</span></span>';
  }

  function render(h){
    var rows;
    if (h === '__rank__') {
      // Rotation-rank order: sorted by rank ascending; fall back to all leaderboard rows
      rows = P.leaderboard.slice();
      rows.sort(function(a, b){
        var ra = rankLookup[a.cc], rb = rankLookup[b.cc];
        if (ra && rb) return ra.rank - rb.rank;
        if (ra) return -1; if (rb) return 1;
        return 0;
      });
      // For display, use 12m returns if available (bars still show returns)
      var maxabs = 1;
      rows.forEach(function(r){
        var x = r.returns && r.returns['12m'];
        if (x) maxabs = Math.max(maxabs, Math.abs(x.usd || 0), Math.abs(x.local || 0));
      });
      function px2(v){ return 50 + (v / maxabs) * 48; }
      board.innerHTML = rows.map(function(r){
        var rr = rankLookup[r.cc];
        var x = r.returns && r.returns['12m'];
        var usd = x ? x.usd : null, loc = x ? x.local : null, fxc = x ? x.fx : null;
        var barHtml = '';
        if (x) {
          var x0 = px2(0), xl = px2(loc), xu = px2(usd);
          var eqL = Math.min(x0, xl), eqW = Math.abs(xl - x0);
          var fxL = Math.min(xl, xu), fxW = Math.abs(xu - xl);
          var fxCls = fxc >= 0 ? 'fx-pos' : 'fx-neg';
          barHtml = '<div class="lb-bar"><div class="axis"></div>'
            + '<div class="lb-seg equity" style="left:' + eqL + '%;width:' + eqW + '%"></div>'
            + '<div class="lb-seg ' + fxCls + '" style="left:' + fxL + '%;width:' + fxW + '%"></div>'
            + '<div class="lb-usd" style="left:' + xu + '%"></div></div>';
        } else {
          barHtml = '<div class="lb-bar"><div class="axis"></div></div>';
        }
        var rankLabel = rr ? '#' + rr.rank : '';
        var noteHtml = rr && rr.note_en ? '<small class="muted" style="display:block"><span class="l-en">' + rr.note_en + '</span><span class="l-zh">' + (rr.note_zh || rr.note_en) + '</span></small>' : '';
        return '<div class="lb-row">'
          + '<div class="eco"><span class="flg">' + r.flag + '</span><span>'
            + '<span class="l-en">' + r.name + '</span><span class="l-zh">' + (r.name_zh || r.name) + '</span>'
            + '<small>' + r.index_name + '</small></span>'
            + stateChip(r.cc) + '</div>'
          + '<div class="lb-spark">' + (r.spark_svg || '') + '</div>'
          + barHtml
          + '<div class="lb-vals"><span class="big">' + rankLabel + '</span>'
            + (x ? '<small><span class="l-en">12m USD </span><span class="l-zh">12月美元 </span>' + fmt(usd) + '</small>' : '')
            + noteHtml + '</div>'
          + '</div>';
      }).join('');
    } else {
      rows = P.leaderboard.filter(function(b){ return b.returns[h]; });
      rows.sort(function(a, b){ return b.returns[h].usd - a.returns[h].usd; });
      var maxabs = 1;
      rows.forEach(function(r){ var x = r.returns[h]; maxabs = Math.max(maxabs, Math.abs(x.usd), Math.abs(x.local)); });
      function px(v){ return 50 + (v / maxabs) * 48; }
      board.innerHTML = rows.map(function(r){
        var x = r.returns[h], usd = x.usd, loc = x.local, fxc = x.fx;
        var x0 = px(0), xl = px(loc), xu = px(usd);
        var eqL = Math.min(x0, xl), eqW = Math.abs(xl - x0);
        var fxL = Math.min(xl, xu), fxW = Math.abs(xu - xl);
        var fxCls = fxc >= 0 ? 'fx-pos' : 'fx-neg';
        return '<div class="lb-row">'
          + '<div class="eco"><span class="flg">' + r.flag + '</span><span>'
            + '<span class="l-en">' + r.name + '</span><span class="l-zh">' + (r.name_zh || r.name) + '</span>'
            + '<small>' + r.index_name + '</small></span>'
            + stateChip(r.cc) + '</div>'
          + '<div class="lb-spark">' + (r.spark_svg || '') + '</div>'
          + '<div class="lb-bar"><div class="axis"></div>'
            + '<div class="lb-seg equity" style="left:' + eqL + '%;width:' + eqW + '%"></div>'
            + '<div class="lb-seg ' + fxCls + '" style="left:' + fxL + '%;width:' + fxW + '%"></div>'
            + '<div class="lb-usd" style="left:' + xu + '%"></div></div>'
          + '<div class="lb-vals"><span class="big ' + (usd >= 0 ? 'pos' : 'neg') + '">' + fmt(usd) + '</span>'
            + '<small><span class="l-en">eq </span><span class="l-zh">股 </span>' + fmt(loc)
            + ' · <span class="l-en">fx </span><span class="l-zh">汇 </span>' + fmt(fxc) + '</small></div>'
          + '</div>';
      }).join('');
    }
  }
  // Default: rotation rank if available, else 12m
  var defaultH = window.INTL_RANKS ? '__rank__' : '12m';
  render(defaultH);
  var seg = document.getElementById('lb-seg');
  if (seg) seg.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click', function(){
      seg.querySelectorAll('button').forEach(function(b){ b.classList.remove('on'); });
      btn.classList.add('on'); render(btn.dataset.h);
    });
  });
})();
</script>
{% endif %}
<script>
/* World Command hero — activate state-tinted aurora + orchestrated scroll-reveal */
(function(){
  try {
    var wc = document.querySelector('.wc[data-aur]');
    if (wc) { (wc.getAttribute('data-aur')||'').split(/\s+/).forEach(function(c){ if(c) document.body.classList.add(c); }); }
  } catch(e){}
  var mq = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
  if (mq && mq.matches) return;
  try {
    var flow = document.querySelector('.intl-flow');
    if (!flow || !('IntersectionObserver' in window)) return;
    var els = flow.querySelectorAll(':scope > .panel, :scope > .ird-stage, :scope > .ird-twocol, :scope > details.ref-fold, :scope > .act-h');
    var io = new IntersectionObserver(function(ents){
      ents.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -6% 0px', threshold: 0.03 });
    els.forEach(function(el){ el.classList.add('reveal'); io.observe(el); });
  } catch(e){}
})();
</script>
<script src="theme.js"></script>
<script src="tablesort.js"></script>
</body>
</html>
