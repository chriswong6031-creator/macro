<!-- ── THE RANKED FEED ────────────────────────────────────────────────── -->
<div class="feed" id="feed">
{% for a in alerts %}
  {% set sevcls = 'crit' if a.severity=='critical' else ('major' if a.severity=='major' else 'minor') %}
  {% set v = a.validation %}
  <div class="ac sev-{{ sevcls }}" data-sev="{{ a.severity }}" data-tier="{{ a.tier }}" data-src="{{ a.source }}"
       data-cluster="{{ a.cluster }}" data-life="{{ a.lifecycle }}" data-emit="{{ a.ts }}" data-age="{{ a.age_days }}"
       data-id="{{ a.alert_id }}" data-q="{{ hay(a)|trim }}">
    <div class="rail">
      <div class="pr">{{ a.priority }}</div>
      <div class="prbar"><i class="bg-{{ sevcls }}" style="width:{{ a.priority }}%"></i></div>
      <div class="prl">{{ t('priority','优先级') }}{{ help(
        'Triage priority 0-100 — how much this should grab attention NOW, not a probability it is right. = conviction ' ~ a.priority_components.conviction[0] ~ ' (' ~ a.priority_components.conviction[1] ~ ') + severity ' ~ a.priority_components.severity[0] ~ ' (' ~ a.priority_components.severity[1] ~ ') + recency ' ~ a.priority_components.recency[0] ~ ' (' ~ a.priority_components.recency[1] ~ ') + cross-asset ' ~ a.priority_components.cross_asset[0] ~ ' (' ~ a.priority_components.cross_asset[1] ~ ').',
        '分诊优先级 0-100 — 表示此刻该给多少注意力，并非判断正确的概率。= 信念 ' ~ a.priority_components.conviction[0] ~ ' + 严重度 ' ~ a.priority_components.severity[0] ~ ' + 新鲜度 ' ~ a.priority_components.recency[0] ~ ' + 跨资产 ' ~ a.priority_components.cross_asset[0] ~ '。') }}</div>
    </div>
    <div class="body">
      <div class="meta">
        <span class="src">{{ a.source_icon }} {{ t(a.source_label, a.source_label_zh) }}</span>
        <span class="sevpill bd-{{ sevcls }} c-{{ sevcls }}"><span class="dot bg-{{ sevcls }}"></span>{{ t(a.severity, {'critical':'关键','major':'重要','minor':'次要'}[a.severity]) }}</span>
        {% if a.lifecycle=='new' %}<span class="lifepill life-new">🆕 {{ t('new','新') }}</span>
        {% elif a.lifecycle=='persisting' %}<span class="lifepill life-persisting">↻ {{ t('persisting','持续') }} {{ a.streak_days }}{{ t('d','天') }}</span>
        {% elif a.lifecycle=='fading' %}<span class="lifepill life-fading">{{ t('fading','消退') }}</span>{% endif %}
        <span class="mono">{{ a.ts[:10] }}{% if a.age_days==0 %} · {{ t('today','今天') }}{% elif a.age_days==1 %} · {{ t('1d ago','1天前') }}{% else %} · {{ a.age_days }}{{ t('d ago','天前') }}{% endif %}</span>
        {% if a.fire_count>1 %}<span class="muted">· {{ t('fired','触发') }} <b class="mono">{{ a.fire_count }}×</b>{% if a.streak_days>0 %} {{ t('over','历') }} {{ a.streak_days }}{{ t('d','天') }}{% endif %}</span>{% endif %}
      </div>
      <div class="hl">{{ t(a.headline, a.headline_zh) }}</div>
      {% if a.detail %}<div class="dt">{{ t(a.detail[:200], a.detail_zh[:200]) }}</div>{% endif %}
      <div class="row2">
        {% set acls = {'high-conviction':'a-high','reduce risk':'a-reduce','confirm first':'a-confirm','watch':'a-watch','context':'a-context'}[a.action] %}
        <span class="pill {{ acls }}">→ {{ t(a.action, a.action_zh) }}</span>
        {% if a.cross_asset_tag != 'neutral' %}
        <span class="tag {{ a.cross_asset_tag }}">{{ '✓' if a.cross_asset_tag=='confirm' else '⚠' }} {{ t('tape ' ~ a.cross_asset_tag, '盘面' ~ ({'confirm':'佐证','diverge':'背离'}[a.cross_asset_tag])) }}</span>
        {% endif %}
        {% if a.asset and a.asset not in (a.source, 'macro', 'rates', 'vector') and a.asset|length <= 6 %}
        <span class="tag ticker">{{ a.asset }}</span>{% endif %}
        <a class="lnk sm" href="{{ a.link }}">{{ t('open','打开') }} →</a>
      </div>
      <!-- validation: a measured number ONLY where it exists; quiet & honest otherwise -->
      <div class="val">
        {% set vmap = {
          'backtested': ('vp-backtested','BACKTESTED ✓','已回测 ✓'),
          'scored': ('vp-scored','SCORED','已计分'),
          'confirmer': ('vp-confirmer','CONFIRMER','确认项'),
          'calibrated': ('vp-calibrated','CALIBRATED','已校准'),
          'no_edge': ('vp-no_edge','TESTED · NO EDGE','已检验·无边际'),
          'underpowered': ('vp-underpowered','UNTESTABLE','样本不足'),
          'documented': ('vp-documented','not backtested','未回测'),
          'display': ('vp-display','display','仅展示'),
          'killed': ('vp-killed','NO-GO','否决') } %}
        {% set vv = vmap.get(v.verdict, vmap['documented']) %}
        <span class="vpill {{ vv[0] }}">{{ t(vv[1], vv[2]) }}</span>
        {% if v.hit is not none %}<span class="mono">{{ t('hit','命中') }} {{ pct(v.hit) }}{% if v.horizon %} @{{ v.horizon }}{% endif %}</span>{% endif %}
        {% if v.ic is not none %}<span class="mono">IC {{ '%+.3f'|format(v.ic) }}</span>{% endif %}
        {% if v.dsr is not none %}<span class="mono">DSR {{ '%.2f'|format(v.dsr) }}</span>{% endif %}
        {% if v.note %}<span class="muted">— {{ t(v.note[:120], (v.note_zh or v.note)[:120]) }}</span>{% endif %}
        {{ help(
           (v.note or 'No standalone backtest for this alert family — the conviction is documented, not measured as a timing signal.') ~ (('  Validated as: ' ~ v.scorecard_name ~ '.') if v.scorecard_name else '') ~ '  See Signal Lab for the full battery.',
           (v.note_zh or v.note or '该警报族无独立回测 — 信念有据可查，但未作为择时信号度量。') ~ (('  验证为：' ~ v.scorecard_name ~ '。') if v.scorecard_name else '') ~ '  详见信号实验室。') }}
        <a class="lnk" href="{{ v.link }}">{{ t('Signal Lab','信号实验室') }} →</a>
      </div>
    </div>
  </div>
{% else %}
  <div class="panel empty">
    <div class="big">{{ t('A quiet tape.','盘面平静。') }}</div>
    {{ t('No cross-asset alerts in the window. A quiet tape is a position too — nothing here needs your attention right now.','窗口内无跨资产警报。平静的盘面本身也是一种仓位 — 此刻无需你的关注。') }}
  </div>
{% endfor %}
  <div class="panel empty" id="noresults">
    <div class="big">{{ t('Nothing matches these filters.','没有符合当前筛选的警报。') }}</div>
    {{ t('Try widening the priority or story filter, or clear the search.','请放宽优先级或脉络筛选，或清除搜索。') }}
    <button type="button" class="freset" id="reset2">{{ t('Reset all','重置全部') }}</button>
  </div>
</div>

<!-- ── METHODOLOGY (kept honest, moved out of the way) ────────────────── -->
<div class="panel" style="margin-top:14px">
  <details class="method">
    <summary>{{ t('How this board ranks — and why it refuses to fake a hit-rate','本看板如何排序 — 以及为何拒绝编造命中率') }}</summary>
    <dl>
      <dt>{{ t('Triage priority (0-100)','分诊优先级 (0-100)') }}</dt>
      <dd>{{ t('A transparent sum of four parts: conviction (act 40 / watch 22 / context 8), severity (critical 30 / major 18 / minor 6), recency (fresh 20 → old 2), and cross-asset agreement (+10 confirm, −6 diverge). It tells you what to LOOK at first. It is explicitly NOT a probability the call is correct.','四部分的透明加总：信念（执行40／观察22／背景8）、严重度（关键30／重要18／次要6）、新鲜度（新20→旧2）、跨资产一致性（佐证+10、背离−6）。它告诉你先看什么，明确不是判断正确的概率。') }}</dd>
      <dt>{{ t('Severity you can trust — corroboration, not volume','可信的严重度 — 靠佐证，而非音量') }}</dt>
      <dd>{{ t("Each engine has its own 'high/medium' scale, so a single-name flag can read as loud as a credit blow-out. We re-tier every alert by its TRUE cross-asset importance, then cap it back down unless something corroborates it — a measured edge, agreement from the cross-asset tape, or genuine persistence (it kept firing for days). A severity band is only ever LOWERED, never inflated, so nothing shouts louder than it has earned.",'每个引擎有自己的“高／中”刻度，使单一个股信号看起来与信用崩溃一样响。我们按真正的跨资产重要性重新分级，再予以回调 — 除非有佐证：可测边际、跨资产盘面的一致性，或真实的持续性（连日反复触发）。严重度只会被下调，绝不虚高，因此没有信号会喊得超过它应得的音量。') }}</dd>
      <dt>{{ t('Persistence is signal','持续性即信号') }}</dt>
      <dd>{{ t("A flag that re-fires every day for a week is stickier than a one-off — a plain de-duplicated list throws that away. We keep the fire count and streak so a persisting alert earns its place, and show it on the card ('fired 9× over 22d').",'连续一周每天触发的信号比一次性的更具黏性 — 普通去重列表会将其丢弃。我们保留触发次数与连续天数，使持续型警报凭此立足，并在卡片上显示（“22天内触发9次”）。') }}</dd>
      <dt>{{ t('Measured edge, or honest silence','可测边际，或坦诚沉默') }}</dt>
      <dd>{{ t("A hit-rate / IC / Deflated-Sharpe appears ONLY where the validation layer actually measured that signal family (the recession composite, the regime quad, the BTC risk regime, the commodity risk index). For condition-based alerts never backtested as timing signals, we say 'documented, not backtested' rather than invent a number.",'只有当验证层确实度量过该信号族（衰退综合、机制四象限、比特币风险机制、商品风险指数）时，才显示命中率／IC／去偏夏普。对于从未作为择时信号回测的条件型警报，我们标注“有据可查，但未回测”，而非编造数字。') }}</dd>
    </dl>
  </details>
</div>

<div class="panel">
  <p class="src muted sm" style="margin:0">
    {{ t('Assembler','汇编') }}: engine/alert_triage.py · {{ t('feeds','数据源') }}: macro / bonds / forex / vector / commodity / themes / rotation / single-name ·
    {{ t('window','窗口') }} {{ window_days }}{{ t('d','天') }} · {{ t('as-of','截至') }} {{ asof or '—' }} ·
    {{ t('rendered','生成') }} {{ generated_utc }} UTC</p>
</div>

<script>
(function(){
  var feed = document.getElementById('feed');
  var cards = Array.prototype.slice.call(feed.querySelectorAll('.ac'));
  var sel = { sev:'all', cl:'all', quick:null, q:'' };

  // ---- "new since your last visit" badges (per-browser, localStorage) ------
  try {
    var LASTKEY = 'alerts_last_visit';
    var prev = parseInt(localStorage.getItem(LASTKEY) || '0', 10);
    var newest = 0;
    cards.forEach(function(c){
      var ts = Date.parse((c.dataset.emit||'').slice(0,10)) || 0;
      if (ts > newest) newest = ts;
      if (prev && ts > prev) { var d=document.createElement('span'); d.className='newdot'; c.querySelector('.rail').appendChild(d); }
    });
    localStorage.setItem(LASTKEY, String(Math.max(newest, Date.now())));
  } catch(e){}

  // ---- chip counts ----------------------------------------------------------
  function count(pred){ return cards.filter(pred).length; }
  document.querySelectorAll('.fbtn[data-grp]').forEach(function(b){
    var grp = b.dataset.grp, f = b.dataset.f, cnt = b.querySelector('.cnt');
    if (!cnt || f==='all') return;
    var n = grp==='sev'
      ? (f==='act' ? count(function(c){return c.dataset.tier==='act';}) : count(function(c){return c.dataset.sev===f;}))
      : count(function(c){return c.dataset.cluster===f;});
    cnt.textContent = n;
  });

  // ---- apply filters (AND across dimensions) --------------------------------
  var showN = document.getElementById('showN');
  var noRes = document.getElementById('noresults');
  function matches(c){
    if (sel.sev!=='all'){ if (sel.sev==='act'){ if(c.dataset.tier!=='act') return false; } else if (c.dataset.sev!==sel.sev) return false; }
    if (sel.cl!=='all' && c.dataset.cluster!==sel.cl) return false;
    if (sel.quick==='new' && c.dataset.age!=='0') return false;
    if (sel.quick==='persisting' && c.dataset.life!=='persisting') return false;
    if (sel.q){ if ((c.dataset.q||'').indexOf(sel.q)===-1) return false; }
    return true;
  }
  function apply(){
    var shown = 0;
    cards.forEach(function(c){ var ok = matches(c); c.classList.toggle('hide', !ok); if(ok) shown++; });
    if (showN) showN.textContent = shown;
    if (noRes) noRes.style.display = (shown===0 && cards.length) ? '' : 'none';
    writeHash();
  }

  // ---- URL hash state (shareable) -------------------------------------------
  function writeHash(){
    var p = [];
    if (sel.sev!=='all') p.push('sev='+sel.sev);
    if (sel.cl!=='all') p.push('cl='+sel.cl);
    if (sel.quick) p.push('q='+sel.quick);
    if (sel.q) p.push('s='+encodeURIComponent(sel.q));
    var h = p.join('&');
    try { history.replaceState(null,'', h ? '#'+h : location.pathname+location.search); } catch(e){}
  }
  function readHash(){
    var h = (location.hash||'').replace(/^#/,''); if(!h) return;
    h.split('&').forEach(function(kv){
      var i = kv.indexOf('='); if(i<0) return;
      var k = kv.slice(0,i), val = decodeURIComponent(kv.slice(i+1));
      if (k==='sev') sel.sev = val;
      else if (k==='cl') sel.cl = val;
      else if (k==='q') sel.quick = val;
      else if (k==='s') sel.q = val.toLowerCase();
    });
  }

  // ---- wire chips -----------------------------------------------------------
  function setActive(grp, f){
    document.querySelectorAll('.fbtn[data-grp="'+grp+'"]').forEach(function(x){
      var on = x.dataset.f===f; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on));
    });
  }
  function setQuick(){
    document.querySelectorAll('.fbtn.quick').forEach(function(x){
      var on = x.dataset.quick===sel.quick; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on));
    });
  }
  document.querySelectorAll('.fbtn[data-grp]').forEach(function(b){
    b.addEventListener('click', function(){
      var grp = b.dataset.grp; sel[grp] = b.dataset.f; setActive(grp, b.dataset.f); apply();
    });
  });
  document.querySelectorAll('.fbtn.quick').forEach(function(b){
    b.addEventListener('click', function(){
      var q = b.dataset.quick; sel.quick = (sel.quick===q ? null : q);
      setQuick();
      apply();
    });
  });
  // storyline cards -> cluster filter
  document.querySelectorAll('.story').forEach(function(s){
    s.addEventListener('click', function(){
      var cl = s.dataset.story;
      sel.cl = (sel.cl===cl ? 'all' : cl);
      setActive('cl', sel.cl);
      document.querySelectorAll('.story').forEach(function(x){ x.classList.toggle('on', x.dataset.story===sel.cl); });
      apply();
      feed.scrollIntoView({behavior: (matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'), block:'start'});
    });
  });
  // search box
  var qbox = document.getElementById('q');
  if (qbox) {
    qbox.addEventListener('input', function(){ sel.q = qbox.value.trim().toLowerCase(); apply(); });
    // lang-aware placeholder (EN in the attribute, ZH in data-ph-zh; theme.js fires 'langchange')
    var phEn = qbox.placeholder, phZh = qbox.getAttribute('data-ph-zh') || phEn;
    var setPh = function(){ qbox.placeholder = document.documentElement.getAttribute('data-lang')==='zh' ? phZh : phEn; };
    setPh(); document.addEventListener('langchange', setPh);
  }
  // reset
  function reset(){
    sel = { sev:'all', cl:'all', quick:null, q:'' };
    if (qbox) qbox.value = '';
    setActive('sev','all'); setActive('cl','all'); setQuick();
    document.querySelectorAll('.story').forEach(function(x){ x.classList.remove('on'); });
    apply();
  }
  var r1=document.getElementById('reset'), r2=document.getElementById('reset2');
  if(r1) r1.addEventListener('click', reset); if(r2) r2.addEventListener('click', reset);

  // ---- restore from hash, then paint ---------------------------------------
  readHash();
  if (qbox && sel.q) qbox.value = sel.q;
  setActive('sev', sel.sev); setActive('cl', sel.cl); setQuick();
  document.querySelectorAll('.story').forEach(function(x){ x.classList.toggle('on', x.dataset.story===sel.cl); });
  apply();
})();
</script>
<script src="theme.js"></script>
</body>
</html>
