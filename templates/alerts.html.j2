  <p class="src muted sm" style="margin:0">
    {{ t('Assembler','汇编') }}: engine/alert_triage.py · {{ t('feeds','数据源') }}: macro / bonds / forex / vector / commodity ·
    {{ t('window','窗口') }} {{ window_days }}{{ t('d','天') }} · {{ t('as-of','截至') }} {{ asof or '—' }} ·
    {{ t('rendered','生成') }} {{ generated_utc }} UTC</p>
</div>

<script>
(function(){
  var sel = {sev:'all', src:'all'};
  function apply(){
    document.querySelectorAll('#feed .ac').forEach(function(c){
      var okS = sel.sev==='all'
        || (sel.sev==='act' ? c.dataset.tier==='act' : c.dataset.sev===sel.sev);
      var okR = sel.src==='all' || c.dataset.src===sel.src;
      c.style.display = (okS && okR) ? '' : 'none';
    });
  }
  document.querySelectorAll('.fbtn').forEach(function(b){
    b.addEventListener('click', function(){
      var grp = b.dataset.grp;
      document.querySelectorAll('.fbtn[data-grp="'+grp+'"]').forEach(function(x){ x.classList.remove('on'); });
      b.classList.add('on');
      sel[grp==='sev'?'sev':'src'] = b.dataset.f;
      apply();
    });
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
