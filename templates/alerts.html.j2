{% set br = board_read or {} %}
{% set stance = br.stance or 'mixed' %}
<!-- ── HERO: the desk read ────────────────────────────────────────────── -->
<div class="hero">
  <div class="hero-top">
    <h1>🚨 {{ t('Alert Command Center', '警报指挥中心') }}</h1>
    <span class="hero-eyebrow">{{ t('the tape right now','当下盘面') }} · {{ t('last','近') }} {{ window_days }}{{ t('d','天') }}</span>
    <span style="flex:1"></span>
    {% if summary.new_today %}<span class="hero-eyebrow c-info">● <b class="mono">{{ summary.new_today }}</b> {{ t('new today','今日新增') }}</span>{% endif %}
  </div>
  <div class="hero-grid">
    <div>
      <div class="stance {{ stance }}">
        <span class="word">{{ t(
          {'risk-off':'RISK-OFF','mixed':'MIXED','constructive':'CONSTRUCTIVE'}[stance],
          {'risk-off':'偏防御','mixed':'喜忧参半','constructive':'偏进攻'}[stance]) }}</span>
        <span class="badge {{ 'c-crit' if stance=='risk-off' else ('c-major' if stance=='mixed' else 'c-ok') }}">
          {{ t('pressure','压力') }} <span class="mono">{{ br.score if br.score is not none else '—' }}</span>/100</span>
      </div>
      <p class="read-line">{{ t(br.one_liner or 'A quiet tape — no cross-asset alerts of note in the window.',
                               br.one_liner_zh or '盘面平静 — 窗口内无值得注意的跨资产警报。') }}
        {{ help('This is a DESCRIPTIVE read of what is firing right now plus the documented macro backdrop — not a forecast and not a probability the market falls. The pressure gauge is a transparent blend of how many act-tier and cross-asset-confirmed stress alerts are live; its parts are named in the sentence.',
                '这是对当前触发情况与有据可查的宏观背景的描述性解读 — 并非预测，也不是市场下跌的概率。压力表是执行级与获跨资产佐证的压力类警报数量的透明混合；其构成已在句中列明。') }}</p>
      <div class="gauge">
        <div class="gauge-track"><div class="gauge-mark" style="left:calc({{ br.score if br.score is not none else 0 }}% - 1px)"></div></div>
        <div class="gauge-scale"><span>{{ t('constructive','偏进攻') }}</span><span>{{ t('mixed','喜忧参半') }}</span><span>{{ t('risk-off','偏防御') }}</span></div>
      </div>
    </div>
    <div>
      <div class="score">
        <div class="s act"><div class="n mono">{{ summary.actionable }}</div><div class="lab">{{ t('act now','立即行动') }}{{ help('Act-tier: a true cross-asset stress or regime call worth sizing around today.','执行级：值得今日据以调整仓位的真正跨资产压力或机制信号。') }}</div></div>
        <div class="s watch"><div class="n mono">{{ summary.major }}</div><div class="lab">{{ t('worth watching','值得关注') }}</div></div>
        <div class="s"><div class="n mono">{{ summary.persisting }}</div><div class="lab">{{ t('persisting','持续中') }}{{ help('Flags that have re-fired across several days rather than a one-off — stickier, and easy to lose in a plain de-duplicated list.','已连续数日反复触发（而非一次性）的信号 — 黏性更强，在普通去重列表中容易被忽略。') }}</div></div>
        <div class="s"><div class="n mono">{{ summary.total }}</div><div class="lab">{{ t('live alerts','活跃警报') }}</div></div>
      </div>
      {% if volume and volume.state %}
      <span class="vol-pill">{{ '▲' if volume.state=='busier' else ('▼' if volume.state=='quieter' else '▬') }}
        {{ t('last 7d','近7天') }} <b class="mono">{{ volume.last_7d }}</b> {{ t('fires','次触发') }} ·
        <b>{{ t({'busier':'busier','quieter':'quieter','normal':'normal'}[volume.state],
                 {'busier':'更繁忙','quieter':'更平静','normal':'正常'}[volume.state]) }}</b>
        {{ t('than usual','于往常') }} (<span class="mono">{{ volume.ratio }}×</span>){{ help('Alert firings in the last 7 days vs this window own trailing weekly rate. Tells you if it is a genuinely loud week or ambient chatter. Descriptive.','近7天的警报触发次数对比本窗口自身的滚动周均值。用于判断这是真正嘈杂的一周还是背景噪音。描述性指标。') }}</span>
      {% endif %}
    </div>
  </div>
</div>

<!-- ── STORYLINES: the whole board as a handful of stories ────────────── -->
{% if storylines %}
<div class="panel">
  <h2>{{ t('The stories behind the alerts','警报背后的脉络') }}
    {{ help('Related alerts collapse into one narrative so the board reads as a few stories, not dozens of disconnected rows. Click a story to filter the feed to it.','相关警报归并为一条脉络，使看板呈现为若干故事，而非几十条零散记录。点击某条脉络可将下方信息流筛选至该类。') }}</h2>
  <div class="stories">
  {% for s in storylines %}
    <button type="button" class="story cl-{{ s.cluster }}" data-story="{{ s.cluster }}">
      <div class="st-top">
        <span class="st-ic">{{ s.icon }}</span>
        <span class="st-name">{{ t(s.label, s.label_zh) }}</span>
        <span class="st-cnt">{{ s.count }}</span>
      </div>
      {% if s.gist %}<div class="st-gist">{{ t(s.gist, s.gist_zh) }}</div>{% endif %}
      <div class="st-line">{{ t(s.top_headline[:70], (s.top_headline_zh or s.top_headline)[:70]) }}</div>
      <div class="st-tags">
        {% if s.act %}<span class="st-tag act">⚡ {{ s.act }} {{ t('act','执行') }}</span>{% endif %}
        {% if s.critical %}<span class="st-tag act">{{ s.critical }} {{ t('critical','关键') }}</span>{% endif %}
        {% if s.persisting %}<span class="st-tag persist">↻ {{ s.persisting }} {{ t('persisting','持续') }}</span>{% endif %}
        {% for tk in s.assets[:5] %}<span class="asset-chip">{{ tk }}</span>{% endfor %}
      </div>
    </button>
  {% endfor %}
  </div>
</div>
{% endif %}

<!-- ── BACKDROP: the shared context every alert is read against ───────── -->
<div class="panel">
  <h2>{{ t('Backdrop — the context every alert is read against','背景 — 解读每条警报的共同语境') }}</h2>
  <div class="ctx">
    <div class="cell">
      <div class="k">{{ t('Market regime','市场机制') }}</div>
      <div class="vv">{{ t(regime.quad_name or regime.quad or '—', regime.quad_name_zh or regime.quad_name or regime.quad or '—') }}</div>
      <div class="vsub">{{ t('cycle','周期') }}: {{ regime.cycle or '—' }}{% if regime.transition %} · {{ regime.transition }}{% endif %}</div>
    </div>
    <div class="cell">
      <div class="k">{{ t('Cross-asset tape','跨资产盘面') }} {{ help('Kritzman-Page absorption: are the major markets moving as one bet or genuinely separate? A CONCENTRATED tape corroborates a stress alert; a DIVERSIFIED one argues against chasing it.','吸收比（Kritzman-Page）：主要市场是同一押注还是真正分散？集中的盘面会佐证压力类警报；分散的盘面则不支持追入。') }}</div>
      <div class="vv {{ 'ca-diverge' if cross_asset.verdict=='concentrated' else ('ca-confirm' if cross_asset.verdict=='diversified') }}">{{ t((cross_asset.verdict or '—')|upper, cross_asset.verdict_zh or (cross_asset.verdict or '—')|upper) }}</div>
      <div class="vsub">{{ t('moving together','同向变动') }}: {{ cross_asset.dominant_cluster|join(', ') if cross_asset.dominant_cluster else '—' }}</div>
    </div>
    <div class="cell">
      <div class="k">{{ t('Risk backdrop','风险背景') }}</div>
      <div class="vv">{{ t('recession','衰退') }}: {{ t(risk_backdrop.recession_band or '—', risk_backdrop.recession_band_zh or risk_backdrop.recession_band or '—') }}</div>
      <div class="vsub">{{ t('drawdown','回撤') }}: {{ t(risk_backdrop.drawdown_band or '—', risk_backdrop.drawdown_band_zh or risk_backdrop.drawdown_band or '—') }} · NFCI {{ t(risk_backdrop.nfci_state or '—', risk_backdrop.nfci_state_zh or risk_backdrop.nfci_state or '—') }}</div>
    </div>
    <div class="cell">
      <div class="k">{{ t('Next catalyst','下一个催化剂') }} {{ help('The nearest high-impact US event. Acting INTO a major print (CPI/FOMC/auction) is itself a risk — size for the event, not just the signal.','最近的高影响美国事件。在重大数据（CPI/FOMC/拍卖）前行动本身即是风险 — 应为事件而非仅为信号定仓。') }}</div>
      {% if events.next %}
      <div class="vv">{{ events.next.type }} · {{ events.next.md }}</div>
      <div class="vsub">{% if events.next.days is not none %}{{ t('in','还有') }} {{ events.next.days }}{{ t('d','天') }}{% endif %}{% if events.next.time_et %} · {{ events.next.time_et }} ET{% endif %}</div>
      {% else %}<div class="vv">—</div><div class="vsub">{{ t('none in the next 2 weeks','未来两周无') }}</div>{% endif %}
    </div>
  </div>
</div>

<!-- ── FILTER BAR (sticky) ────────────────────────────────────────────── -->
<div class="filterbar">
  <div class="row">
    <label class="fsearch">🔍 <input type="text" id="q" autocomplete="off" placeholder="Filter by ticker, theme or keyword…" data-ph-zh="按代码、主题或关键词筛选…" aria-label="Filter alerts"></label>
