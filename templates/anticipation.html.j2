{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Anticipation — multi-horizon forward outcome cones</title>
{% set seo_title = "Anticipation: Forward Outcome Cones — Mastermind" %}{% set seo_desc = "Multi-horizon forward outcome cones — the range of likely paths for major assets, drawn from historical analogs." %}{% set seo_path = "anticipation.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(34px,calc((100vw - 1320px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:21px; margin:0; }
  h2 { font-size:15px; margin:26px 0 4px; }
  .muted { color:var(--muted); } .sm { font-size:12px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:14px; margin-top:10px; }
  .tagline { color:var(--muted); font-size:12.5px; max-width:96ch; margin:4px 0 0; line-height:1.55; }
  .asof { font-size:12px; color:var(--muted); }
  .banner { border-radius:10px; padding:11px 14px; margin:12px 0; font-size:13px; background:var(--panel2); border:1px solid var(--line); display:flex; gap:9px; align-items:flex-start; }
  .banner b { color:var(--text); }
  .chip { display:inline-block; font-size:11px; padding:2px 8px; margin:0 5px 5px 0; border-radius:7px; background:var(--panel2); border:1px solid var(--line); color:var(--muted); }
  .chip.warn { background:rgba(250,204,21,.12); border-color:rgba(250,204,21,.4); color:var(--warn); }
  .chip.hot { background:rgba(239,68,68,.12); border-color:rgba(239,68,68,.4); color:var(--down); }
  .chip.ok  { background:rgba(34,197,94,.12); border-color:rgba(34,197,94,.4); color:var(--up); }
  /* selector */
  .selwrap { margin:12px 0 2px; }
  .selgrp { margin:6px 0; }
  .selgrp .gl { font-size:10.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-right:8px; }
  .pick { display:inline-block; cursor:pointer; font-size:12.5px; font-weight:600; padding:4px 10px; margin:0 5px 6px 0; border-radius:8px; background:var(--panel); border:1px solid var(--line); color:var(--text); }
  .pick:hover { border-color:var(--link); color:var(--link); }
  .pick.on { background:var(--accent,#5aa7ff); border-color:var(--accent,#5aa7ff); color:#fff; }
  /* hero */
  .hero { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:14px; align-items:start; }
  @media (max-width:880px){ .hero{ grid-template-columns:1fr; } }
  .htitle { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .htitle .nm { font-size:24px; font-weight:700; }
  .htitle .grp { font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .idxbadge { font-size:11px; font-weight:700; padding:2px 9px; border-radius:7px; text-transform:uppercase; letter-spacing:.04em; }
  .b-calm{background:rgba(34,197,94,.14);color:var(--up);} .b-elevated{background:rgba(250,204,21,.16);color:var(--warn);}
  .b-high{background:rgba(249,115,22,.16);color:#f97316;} .b-extreme{background:rgba(239,68,68,.16);color:var(--down);}
  .cards { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:10px; }
  @media (max-width:560px){ .cards{ grid-template-columns:1fr; } }
  /* two-block horizon card: DIRECTION (top, colored) + RISK (bottom, neutral) */
  .hc { background:var(--panel2); border:1px solid var(--line); border-left:3px solid var(--line); border-radius:10px; padding:0; overflow:hidden; }
  .hc.up { border-left-color:var(--up); } .hc.down { border-left-color:var(--down); }
  .hc .hk { font-size:11px; color:var(--muted); padding:8px 11px 0; }
  .hc .dblock { padding:5px 11px 9px; }
  .hc .dlab, .hc .rlab { font-size:9.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  .hc .dirv { font-size:15px; font-weight:700; margin-top:1px; }
  .hc .pup { float:right; font-variant-numeric:tabular-nums; font-weight:700; }
  .hc .why { font-size:11px; color:var(--muted); margin-top:3px; line-height:1.4; }
  .hc .pill { display:inline-block; font-size:10px; padding:1px 6px; border-radius:6px; margin-top:5px; }
  .hc .pill.ok { background:rgba(34,197,94,.14); color:var(--up); }
  .hc .pill.flip { background:var(--panel); color:var(--muted); border:1px solid var(--line); }
  .hc .rblock { padding:7px 11px 9px; border-top:1px solid var(--line); background:var(--panel); }
  .hc .rv { font-size:14px; font-variant-numeric:tabular-nums; margin-top:1px; }
  .hc .rv2 { font-size:11.5px; color:var(--muted); margin-top:1px; }
  .hc.thin { opacity:.72; }
  .dir-up{color:var(--up);} .dir-down{color:var(--down);} .dir-flip{color:var(--muted);}
  .legend { background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:9px 13px; margin:12px 0; font-size:12px; color:var(--muted); line-height:1.75; }
  .legend b{color:var(--text);font-weight:600;}
  .help{position:relative;cursor:help;border-bottom:1px dotted var(--muted);}
  .help .tip{visibility:hidden;position:absolute;left:0;top:135%;z-index:30;width:300px;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:11.5px;color:var(--text);line-height:1.5;box-shadow:0 4px 16px rgba(0,0,0,.25);max-height:min(60vh,420px);overflow-y:auto;overscroll-behavior:contain;}
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before{content:'';position:absolute;top:100%;left:-30px;right:-30px;height:10px;}
  .help:hover .tip{visibility:visible;}
  .drv { display:flex; align-items:center; gap:8px; font-size:12.5px; margin:5px 0; }
  .drv .lab { flex:0 0 178px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .drv .bar { flex:1; position:relative; height:14px; }
  .drv .bar i { position:absolute; top:0; height:14px; border-radius:3px; }
  .drv .bar i.up { left:50%; background:rgba(34,197,94,.55); }
  .drv .bar i.dn { right:50%; background:rgba(239,68,68,.55); }
  .drv .bar i.dispo { background:transparent; border:1px dashed var(--line); }
  .drv .vv { flex:0 0 42px; text-align:right; font-variant-numeric:tabular-nums; }
  .drv .sc { flex:0 0 14px; text-align:center; font-size:10px; color:var(--up); }
  /* table */
  .ts { overflow-x:auto; margin-top:8px; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { padding:7px 9px; border-bottom:1px solid var(--line); white-space:nowrap; }
  th { color:var(--muted); font-weight:500; text-align:right; cursor:pointer; }
  th:first-child,td:first-child { text-align:left; }
  td.num,th.num { text-align:right; font-variant-numeric:tabular-nums; }
  tbody tr { cursor:pointer; }
  tbody tr:hover { background:var(--panel2); }
  tbody tr.on { background:rgba(90,167,255,.10); }
  .tband { font-size:10.5px; font-weight:700; padding:1px 6px; border-radius:6px; }
  footer { color:var(--muted); font-size:11.5px; margin-top:28px; border-top:1px solid var(--line); padding-top:12px; max-width:98ch; line-height:1.6; }
  .conebox svg { width:100%; height:auto; display:block; }
</style>
</head>
<body>
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;">
  <h1>🔮 {{ t('Anticipation', '预判') }}</h1>
  <span class="asof">{{ t('as of', '截至') }} <span id="asof"></span> · <span id="ngo"></span></span>
</div>
<p class="tagline">{{ t(
  'Two separate reads per asset: (1) a RISK cone — the range of returns and the typical / worst drawdown over each horizon (always shown, the validated core); and (2) a DIRECTION lean — P(up), shown in color ONLY where it passed out-of-sample validation. Everywhere else, direction is the coin-flip it measurably is.',
  '每个标的有两类读数：(1) 风险锥 — 各周期的收益区间与常见/最坏回撤（始终显示，经验证的核心）；(2) 方向倾向 — 上涨概率，仅在通过样本外验证处以彩色显示。其余皆为实测的抛硬币。') }}</p>

<div class="legend">
  {{ t('HOW TO READ', '如何阅读') }}: &nbsp;
  <span class="dir-up">▲ {{ t('up-lean (green, validated)', '偏多（绿色，已验证）') }}</span> &nbsp;·&nbsp;
  <span class="dir-flip">▬ {{ t('coin-flip (grey, not predictable)', '抛硬币（灰色，不可预测）') }}</span> &nbsp;·&nbsp;
  <span class="dir-down">▼ {{ t('down-lean (red, validated)', '偏空（红色，已验证）') }}</span><br>
  <b>{{ t('Cone', '锥体') }}</b> = {{ t('return range p05–p95; the red lower half is the downside / drawdown.', '收益区间 p05–p95；红色下半部为下行 / 回撤。') }} &nbsp;
  <b>{{ t('Stretch / Fragility', '拉伸 / 脆弱度') }}</b> = {{ t('how stretched vs the asset’s OWN history → only WIDENS the cone (display-only, NOT a valuation or sell call).', '相对自身历史的拉伸程度 → 仅使锥体更宽（仅展示，并非估值或卖出信号）。') }}
</div>

<div class="selwrap" id="selwrap"></div>

<div class="hero">
  <div>
    <div class="htitle" id="htitle"></div>
    <div class="panel conebox" id="conebox"></div>
    <div class="cards" id="cards"></div>
  </div>
  <div>
    <div class="panel">
      <h2 style="margin-top:0">{{ t('Drivers', '驱动因子') }} <span class="sm muted">({{ t('★ = validated / scored · dashed = display-only', '★ = 已验证/计分 · 虚线 = 仅展示') }})</span></h2>
      <div id="drivers"></div>
    </div>
    <div class="panel" id="trust"></div>
  </div>
</div>

<h2>{{ t('All assets — ranked by anticipation index (stress)', '全部标的 — 按预判指数（压力）排序') }}</h2>
<p class="sub muted sm">{{ t('Higher index = more confluence stress (a wider, more left-skewed cone), NOT a sell call. Click a row to load its cone.',
  '指数越高 = 合流压力越大（锥体更宽、更左偏），并非卖出信号。点击行加载其锥体。') }}</p>
<div class="ts panel" style="padding:4px 8px;">
  <table id="tbl">
    <thead><tr>
      <th data-k="name">{{ t('Asset', '标的') }}</th>
      <th data-k="anticipation_index" class="num">{{ t('Stretch', '拉伸') }}</th>
      <th class="num">{{ t('Band', '区间') }}</th>
      <th data-k="s_typ" class="num">{{ t('Short dip (typ/worst)', '短期回撤 常见/最坏') }}</th>
      <th data-k="m_p50" class="num">{{ t('Med return / worst dip', '中期 收益/最坏回撤') }}</th>
      <th class="num">{{ t('Direction (validated)', '方向（已验证）') }}</th>
      <th>{{ t('Top driver', '首要驱动') }}</th>
    </tr></thead>
    <tbody id="tbody"></tbody>
  </table>
</div>

<footer>
  {{ t(
    'Read-only analytics for informational purposes only — NOT investment advice and NOT a buy/sell list. The cone is the empirical forward distribution conditioned on the current confluence state (Growth-at-Risk style), calibrated point-in-time on the validated GO legs only (data/regime/anticipation_gate.json); display-only legs are shown for context but never score. Short-horizon direction is a measured coin-flip; the per-name LONG cone is effective-N under-powered and should be read against the sector cone. Method + evidence: research/ANTICIPATION_ENGINE.md and research/ANTICIPATION_PHASE0.md.',
    '仅供参考的只读分析 — 非投资建议，也非买卖清单。锥体为以当前合流状态为条件的经验前瞻分布（Growth-at-Risk 思路），仅在经验证的 GO 因子上做时点校准（data/regime/anticipation_gate.json）；仅展示因子作为背景，不计分。短期方向为实测抛硬币；个股长周期锥体有效样本不足，应对照行业锥体阅读。方法与证据：research/ANTICIPATION_ENGINE.md 与 research/ANTICIPATION_PHASE0.md。') }}
  {{ t('Generated', '生成于') }} {{ generated_utc }}.
</footer>

<script id="cone-data" type="application/json">{{ data_json|safe }}</script>
<script>
(function(){
  var DATA = JSON.parse(document.getElementById('cone-data').textContent);
  var A = DATA.assets, BY = {}; A.forEach(function(a){ BY[a.asset]=a; });
  var HN = ['short','medium','long'];
  function T(en,zh){ return '<span class="l-en">'+en+'</span><span class="l-zh">'+(zh||en)+'</span>'; }
  function f1(x){ return (x==null||isNaN(x))?'—':(Math.round(x*10)/10); }
  function pct(x){ return (x==null||isNaN(x))?'—':((x>=0?'+':'')+f1(x)+'%'); }
  document.getElementById('asof').textContent = DATA.as_of||'';
  document.getElementById('ngo').innerHTML = (DATA.go_legs?DATA.go_legs.length:0)+' '+T('validated legs','已验证因子');

  function Y(ret, lo, hi, top, bot){ return top + (hi-ret)/(hi-lo)*(bot-top); }
  function renderCone(a){
    var hs = HN.map(function(n){ return [n, a.horizons[n]]; }).filter(function(p){ return p[1] && p[1].ret_q; });
    if(!hs.length) return '<p class="muted sm" style="padding:20px">'+T('No cone — insufficient history.','无锥体 — 历史不足。')+'</p>';
    var lo=0, hi=0;
    hs.forEach(function(p){ var q=p[1].ret_q; lo=Math.min(lo,q.p5); hi=Math.max(hi,q.p95); });
    lo*=1.08; hi*=1.08; if(hi-lo<8){hi+=4;lo-=4;}
    var W=680,H=300,top=28,bot=262;
    var X={now:72}; var xs=[210,410,625]; hs.forEach(function(p,i){ X[p[0]]=xs[i] || (210+i*140); });
    var y0=Y(0,lo,hi,top,bot);
    function edge(key){ var pts='M72,'+y0; hs.forEach(function(p){ pts+=' L'+X[p[0]]+','+Y(p[1].ret_q[key],lo,hi,top,bot); }); return pts; }
    function rev(key){ var pts=''; for(var i=hs.length-1;i>=0;i--){ pts+=' L'+X[hs[i][0]]+','+Y(hs[i][1].ret_q[key],lo,hi,top,bot); } return pts+' L72,'+y0; }
    var rib_up = edge('p95')+rev('p75')+' Z';
    var rib_iqr= edge('p75')+rev('p25')+' Z';
    var rib_dn = edge('p25')+rev('p5')+' Z';
    var med = edge('p50');
    // y ticks
    var ticks='', step = (hi-lo)>120?40:((hi-lo)>50?20:10);
    for(var v=Math.ceil(lo/step)*step; v<=hi; v+=step){ var yy=Y(v,lo,hi,top,bot);
      ticks+='<line x1="60" y1="'+yy+'" x2="650" y2="'+yy+'" style="stroke:var(--line)" stroke-width="0.5"/>'+
             '<text x="54" y="'+(yy+3)+'" text-anchor="end" style="fill:var(--muted)" font-size="11">'+(v>0?'+':'')+v+'%</text>'; }
    var xlab='<text x="72" y="280" style="fill:var(--muted)" font-size="11">'+T('now','现在')+'</text>';
    var meta=DATA.horizons_meta||{short:[1,10],medium:[21,63],long:[126,252]};
    hs.forEach(function(p){ var m=meta[p[0]]||[]; var nm={short:'short',medium:'medium',long:'long'}[p[0]];
      var nmzh={short:'短期',medium:'中期',long:'长期'}[p[0]];
      xlab+='<text x="'+X[p[0]]+'" y="280" text-anchor="middle" style="fill:var(--text)" font-size="11.5">'+T(nm,nmzh)+' '+(m[0]||'')+'–'+(m[1]||'')+'d</text>'; });
    var lastH=hs[hs.length-1], lx=X[lastH[0]];
    var endlab='<text x="'+(lx+4)+'" y="'+(Y(lastH[1].ret_q.p95,lo,hi,top,bot)+3)+'" style="fill:#A32D2D" font-size="11">p95 '+pct(lastH[1].ret_q.p95)+'</text>'+
               '<text x="'+(lx+4)+'" y="'+(Y(lastH[1].ret_q.p5,lo,hi,top,bot)+3)+'" style="fill:#A32D2D" font-size="11">p05 '+pct(lastH[1].ret_q.p5)+'</text>';
    return '<svg viewBox="0 0 '+W+' '+H+'" role="img" aria-label="forward outcome cone">'+ticks+
      '<line x1="60" y1="'+y0+'" x2="650" y2="'+y0+'" style="stroke:var(--muted)" stroke-width="1" stroke-dasharray="1 4"/>'+
      '<path d="'+rib_up+'" fill="#888780" fill-opacity="0.10"/>'+
      '<path d="'+rib_iqr+'" fill="#888780" fill-opacity="0.20"/>'+
      '<path d="'+rib_dn+'" fill="#E24B4A" fill-opacity="0.18"/>'+
      '<path d="'+med+'" fill="none" style="stroke:var(--text)" stroke-width="1.4" stroke-dasharray="5 4"/>'+
      '<circle cx="72" cy="'+y0+'" r="2.5" style="fill:var(--muted)"/>'+xlab+endlab+'</svg>'+
      '<div class="sm muted" style="margin-top:4px">'+T('Bands p05–p95; downside tail emphasized; median dashed (coin-flip short-horizon). Each horizon computed on its own window.','区间 p05–p95；强调下行尾部；中位线虚线（短期抛硬币）。各周期各自独立窗口计算。')+'</div>';
  }

  function bandClass(b){ return 'b-'+(b||'calm'); }
  var BANDWORD={calm:['low','低'],elevated:['moderate','中等'],high:['high','偏高'],extreme:['very high','很高']};
  var LEGLAB={real_rate:['real rates','实际利率'],copper_gold:['copper/gold cyclical impulse','铜金周期脉冲'],
    oil_vrp:['oil vol premium','油波动溢价'],oil_mom:['oil momentum','油价动量'],credit:['credit spreads','信用利差'],
    term:['yield curve','收益率曲线'],gold:['gold','黄金'],vrp:['volatility premium','波动率溢价'],
    tsmom:['price trend','价格趋势'],dollar:['the dollar','美元'],netliq:['net liquidity','净流动性'],mtg:['mortgage rates','按揭利率']};
  function legName(h){ if(!h.dir_legs||!h.dir_legs.length) return null; return LEGLAB[h.dir_legs[0]]||[h.dir_legs[0],h.dir_legs[0]]; }
  function setAsset(tk){
    var a=BY[tk]; if(!a) return;
    document.querySelectorAll('.pick').forEach(function(e){ e.classList.toggle('on', e.dataset.tk===tk); });
    document.querySelectorAll('#tbody tr').forEach(function(e){ e.classList.toggle('on', e.dataset.tk===tk); });
    var bw=BANDWORD[a.index_band]||['n/a','—'];
    var idxTip=T('Percentile of how stretched / fragile this asset looks vs its OWN history (trend extension, vol regime, deterioration velocity). Display-only: a higher score only makes the cone WIDER and more left-skewed. It is NOT a valuation, a crash forecast, or a sell signal.','相对自身历史的拉伸/脆弱度百分位（趋势拉伸、波动率状态、恶化速度）。仅展示：分数越高仅使锥体更宽、更左偏。并非估值、崩盘预测或卖出信号。');
    document.getElementById('htitle').innerHTML =
      '<span class="nm">'+a.asset+'</span><span class="grp">'+a.name+' · '+a.group+'</span>'+
      '<span class="idxbadge '+bandClass(a.index_band)+' help">'+T('Stretch/Fragility','拉伸/脆弱度')+' '+(a.anticipation_index!=null?Math.round(a.anticipation_index):'—')+'/100 · '+T(bw[0],bw[1])+'<span class="tip">'+idxTip+'</span></span>'+
      (a.macro?'<span class="chip '+(a.macro.stress_pct>=70?'hot':(a.macro.stress_pct>=50?'warn':'ok'))+'">'+T('market stress','市场压力')+' '+Math.round(a.macro.stress_pct)+'% · '+T('widens cone','加宽锥体')+' ×'+a.macro.width_mult+'</span>':'');
    document.getElementById('conebox').innerHTML = renderCone(a);
    // horizon cards — DIRECTION block (colored) + RISK block (neutral), split
    var ch='';
    HN.forEach(function(n){ var h=a.horizons[n]; if(!h) return; var rq=h.ret_q||{};
      var nm={short:'Short',medium:'Medium',long:'Long'}[n], nmzh={short:'短期',medium:'中期',long:'长期'}[n];
      var scored=h.direction_scored;
      var cls = scored ? (h.direction==='up-lean'?'up':(h.direction==='down-lean'?'down':'')) : '';
      var dcls = scored ? (h.direction==='up-lean'?'dir-up':(h.direction==='down-lean'?'dir-down':'dir-flip')) : 'dir-flip';
      var arrow = (scored && h.direction==='up-lean')?'▲':((scored && h.direction==='down-lean')?'▼':'▬');
      var dword = !scored ? T('Coin-flip','抛硬币') : (h.direction==='up-lean'?T('Up-lean','偏多'):(h.direction==='down-lean'?T('Down-lean','偏空'):T('Neutral','中性')));
      var pu = Math.round((h.p_up||0.5)*100);
      var pill = scored ? '<span class="pill ok">✓ '+T('validated OOS','已验证OOS')+'</span>'
                 : '<span class="pill flip">'+(n==='short'?T('not predictable here','此处不可预测'):T('coin-flip','抛硬币'))+'</span>';
      var ln = legName(h);
      var why = scored ? '<div class="why">'+T('driven by','驱动：')+' '+(ln?T(ln[0],ln[1]):T('a validated signal','已验证信号'))+' · OOS-R² '+(h.oos_r2!=null?h.oos_r2:'—')+'</div>'
                : '<div class="why">'+T('no validated directional signal here','此处无已验证方向信号')+'</div>';
      ch+='<div class="hc '+cls+(h.thin?' thin':'')+'">'+
        '<div class="hk">'+T(nm,nmzh)+' · '+(h.range_td?h.range_td.join('–'):'')+'d</div>'+
        '<div class="dblock"><div class="dlab">'+T('DIRECTION','方向')+'</div>'+
          '<div class="dirv '+dcls+'">'+arrow+' '+dword+'<span class="pup">'+T('P(up)','上涨概率')+' '+pu+'%</span></div>'+
          why+pill+'</div>'+
        '<div class="rblock"><div class="rlab">'+T('RISK · validated','风险 · 已验证')+'</div>'+
          '<div class="rv"><span class="neg">'+T('typical dip','常见回撤')+' '+pct(h.dd_avg)+'</span> · <span class="neg">'+T('worst','最坏')+' '+pct(h.dd_tail)+'</span></div>'+
          '<div class="rv2">'+T('median return','中位收益')+' '+pct(rq.p50)+(h.thin?' · '+T('low-n','样本少'):'')+'</div>'+
        '</div></div>';
    });
    document.getElementById('cards').innerHTML = ch;
    // drivers
    var dh=''; (a.drivers||[]).forEach(function(d){ var up=d.value>=0?'':'up', dn=d.value>=0?'dn':'';
      // oriented "higher=worse": positive value = dangerous (down pressure) -> red bar on left
      var danger=d.value>=0; var w=Math.min(48,Math.abs(d.value)*16);
      var bar = d.display_only
        ? '<i class="dispo" style="'+(danger?'right:50%':'left:50%')+';width:'+w+'%"></i>'
        : '<i class="'+(danger?'dn':'up')+'" style="width:'+w+'%"></i>';
      dh+='<div class="drv"><span class="lab">'+T(d.label.en,d.label.zh)+'</span><span class="bar">'+bar+'</span>'+
        '<span class="vv">'+(d.value>=0?'+':'')+d.value+'</span><span class="sc">'+(d.scored?'★':'')+'</span></div>';
    });
    document.getElementById('drivers').innerHTML = dh || '<span class="muted sm">—</span>';
    // trust
    var cav=(a.caveats||[]).map(function(c){ return '<li>'+c+'</li>'; }).join('');
    document.getElementById('trust').innerHTML =
      '<h2 style="margin-top:0">'+T('Trust & honesty','可信度与诚实')+'</h2>'+
      '<div>'+
        '<span class="chip ok">'+T('cone validated','锥体已验证')+'</span>'+
        '<span class="chip">'+T('direction display-only','方向仅展示')+'</span>'+
        '<span class="chip'+(a.horizons.long&&a.horizons.long.underpowered?' warn':'')+'">'+T('long n','长周期 n')+' '+((a.horizons.long||{}).cell_n||0)+'</span>'+
        (a.macro?'<span class="chip">'+T('macro overlay','宏观叠加')+' '+(a.macro.go_legs||[]).length+'</span>':'')+
      '</div><ul class="tagline" style="margin:8px 0 0;padding-left:18px">'+cav+'</ul>';
  }

  // selector
  var groups=[['index','Index','指数'],['sector','Sectors','板块'],['theme','Themes','主题'],['stock','Watchlist','自选']];
  var sh=''; groups.forEach(function(g){ var items=A.filter(function(a){return a.group===g[0];});
    if(!items.length) return; sh+='<div class="selgrp"><span class="gl">'+T(g[1],g[2])+'</span>';
    items.forEach(function(a){ sh+='<span class="pick" data-tk="'+a.asset+'">'+a.asset+'</span>'; }); sh+='</div>'; });
  document.getElementById('selwrap').innerHTML=sh;
  document.querySelectorAll('.pick').forEach(function(e){ e.addEventListener('click',function(){ setAsset(e.dataset.tk); }); });

  // table
  function shortTyp(a){ var h=a.horizons.short||{}; return h.dd_avg; }
  function rowHtml(a){ var s=a.horizons.short||{}, m=a.horizons.medium||{}, l=a.horizons.long||{};
    // surface the scored lean from WHICHEVER horizon validated (medium first, else long)
    var sc = m.direction_scored ? {d:m,tag:'med'} : (l.direction_scored ? {d:l,tag:'long'} : null);
    var dcell;
    if(sc){ var up=sc.d.direction==='up-lean'; dcell='<span class="'+(up?'dir-up':'dir-down')+'">'+(up?'▲':'▼')+' '+(up?T('up','偏多'):T('down','偏空'))+' '+sc.tag+' ✓</span>'; }
    else { dcell='<span class="dir-flip">▬ '+T('coin-flip','抛硬币')+'</span>'; }
    var bw=BANDWORD[a.index_band]||['n/a','—'];
    var top=(a.drivers||[])[0];
    return '<tr data-tk="'+a.asset+'"><td><b>'+a.asset+'</b> <span class="muted sm">'+a.name+'</span></td>'+
      '<td class="num"><span class="tband '+bandClass(a.index_band)+'">'+(a.anticipation_index!=null?Math.round(a.anticipation_index):'—')+'</span></td>'+
      '<td class="num muted sm">'+T(bw[0],bw[1])+'</td>'+
      '<td class="num">'+pct(s.dd_avg)+' / <span class="neg">'+pct(s.dd_tail)+'</span></td>'+
      '<td class="num">'+pct((m.ret_q||{}).p50)+' / <span class="neg">'+pct(m.dd_tail)+'</span></td>'+
      '<td class="num sm">'+dcell+'</td>'+
      '<td class="muted sm">'+(top?T(top.label.en,top.label.zh)+(top.scored?' ★':''):'—')+'</td></tr>';
  }
  var sortK='anticipation_index', sortDesc=true;
  function renderTable(){ var rows=A.slice().sort(function(x,y){
      var vx,vy; if(sortK==='name'){vx=x.asset;vy=y.asset;} else if(sortK==='s_typ'){vx=shortTyp(x);vy=shortTyp(y);}
      else if(sortK==='m_p50'){vx=(x.horizons.medium||{}).ret_q?x.horizons.medium.ret_q.p50:0;vy=(y.horizons.medium||{}).ret_q?y.horizons.medium.ret_q.p50:0;}
      else {vx=x[sortK];vy=y[sortK];}
      if(vx==null)vx=-1e9; if(vy==null)vy=-1e9;
      if(vx<vy)return sortDesc?1:-1; if(vx>vy)return sortDesc?-1:1; return 0; });
    document.getElementById('tbody').innerHTML=rows.map(rowHtml).join('');
    document.querySelectorAll('#tbody tr').forEach(function(e){ e.addEventListener('click',function(){ setAsset(e.dataset.tk); }); });
    var cur=document.querySelector('.pick.on'); if(cur){ var t=cur.dataset.tk; var r=document.querySelector('#tbody tr[data-tk="'+t+'"]'); if(r)r.classList.add('on'); }
  }
  document.querySelectorAll('#tbl th[data-k]').forEach(function(th){ th.addEventListener('click',function(){
    var k=th.dataset.k; if(sortK===k)sortDesc=!sortDesc; else {sortK=k;sortDesc=(k!=='name');} renderTable(); }); });
  renderTable();
  setAsset(A[0].asset);
})();
</script>
<script src="theme.js"></script>
</body>
</html>
