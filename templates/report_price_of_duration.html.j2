    <div class="pod-gauge" style="--pod-c:var(--pod-red)"><b>10.35%</b><div class="pod-gauge-label">{{ t('CCC &amp; lower OAS · Aug 20 official close', 'CCC 及以下 OAS · 8 月 20 日官方收盘') }}</div></div>
  </div>
