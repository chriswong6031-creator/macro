{% block body_scripts %}
<script>
(function(){
  var legacy=document.querySelector('.pod-legacy');
  if(legacy){
    [].slice.call(legacy.querySelectorAll('.pod-figure')).forEach(function(figure){
      var slot=document.querySelector('[data-figure-slot="'+figure.id+'"]');
      if(slot) slot.replaceWith(figure);
    });
    legacy.remove();
  }
  var figures=[].slice.call(document.querySelectorAll('.pod-figure'));
  if(!figures.length) return;
  var reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced||!('IntersectionObserver' in window)){
    figures.forEach(function(f){ f.classList.add('is-visible'); });
    return;
  }
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  },{threshold:.18,rootMargin:'0px 0px -8% 0px'});
  figures.forEach(function(f){
    var rect=f.getBoundingClientRect();
    if(rect.top<window.innerHeight*.92&&rect.bottom>0){
      f.classList.add('is-visible');
      return;
    }
    f.classList.add('pod-motion-pending');
    io.observe(f);
    window.setTimeout(function(){
      f.classList.remove('pod-motion-pending');
      f.classList.add('is-visible');
      io.unobserve(f);
    },4000);
  });
})();
</script>
{% endblock %}
