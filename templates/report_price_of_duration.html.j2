      <tr><td>{{ t('Long-end Treasury pressure [F]', '美债长端压力 [F]') }}</td><td>{{ t('A sovereign buyers&rsquo; strike', '主权债务买家罢买') }}</td></tr>
      <tr><td>{{ t('Dollar / gold behavior changed [F/I]', '美元 / 黄金行为已改变 [F/I]') }}</td><td>{{ t('An imminent U.S. default', '美国即将违约') }}</td></tr>
      <tr><td>{{ t('Long-duration buybacks enlarged [F]', '长久期回购规模扩大 [F]') }}</td><td>{{ t('QE or formal yield-curve control', '量化宽松或正式收益率曲线控制') }}</td></tr>
      <tr><td>{{ t('Foreign holdings softened [F]', '海外持仓有所走弱 [F]') }}</td><td>{{ t('Wholesale foreign abandonment', '海外投资者全面撤离') }}</td></tr>
