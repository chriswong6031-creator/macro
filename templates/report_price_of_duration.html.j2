{% extends "article_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}

{% block art_kicker %}{{ t('Mastermind Research · Macro · Rates · AI · Digital Assets', 'Mastermind 研究 · 宏观 · 利率 · AI · 数字资产') }}{% endblock %}

{% block head_extra %}{{ super() }}
<style>
{% raw %}
  /* The Price of Duration — report-scoped editorial and figure system. */
  .pod {
    --pod-blue:#5b8def;
    --pod-gold:#d6a84b;
    --pod-teal:#36a995;
    --pod-red:#d85b62;
    --pod-violet:#8f7bd8;
    --pod-ink:var(--text);
    --pod-grid:color-mix(in srgb,var(--line) 72%,transparent);
  }
  .pod .pod-deck {
    margin:4px 0 22px;
    color:var(--muted);
    font-size:13px;
    line-height:1.55;
    border-left:2px solid var(--pod-gold);
    padding-left:12px;
  }
  .pod .pod-snapshot {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:9px;
    margin:18px 0 10px;
  }
  .pod .pod-gauge {
    min-width:0;
    border:1px solid var(--line);
    background:linear-gradient(145deg,var(--panel2),color-mix(in srgb,var(--panel) 88%,var(--pod-c,var(--pod-blue))));
    border-radius:12px;
    padding:12px 12px 11px;
    box-shadow:var(--card-shadow);
    position:relative;
    overflow:hidden;
  }
  .pod .pod-gauge::before {
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    width:3px;
    background:var(--pod-c,var(--pod-blue));
  }
  .pod .pod-gauge b {
    display:block;
    font-size:21px;
    line-height:1;
    letter-spacing:-.025em;
    font-variant-numeric:tabular-nums;
    color:var(--text);
  }
  .pod .pod-gauge-label {
    margin-top:6px;
    color:var(--muted);
    font-size:10.5px;
    line-height:1.35;
  }
  .pod .pod-asof {
    color:var(--muted);
    font-size:10.5px;
    line-height:1.45;
    margin:8px 0 22px;
  }
  .pod .pod-thesis {
    margin:25px 0;
    border:1px solid color-mix(in srgb,var(--pod-gold) 44%,var(--line));
    border-radius:18px;
    padding:25px 28px;
    position:relative;
    overflow:hidden;
    background:
      radial-gradient(circle at 92% 12%,color-mix(in srgb,var(--pod-gold) 17%,transparent),transparent 34%),
      linear-gradient(135deg,color-mix(in srgb,var(--pod-blue) 10%,var(--panel)),var(--panel));
    box-shadow:var(--card-shadow);
  }
  .pod .pod-thesis::before {
    content:"";
    position:absolute;
    left:0;
    top:0;
    bottom:0;
    width:4px;
    background:linear-gradient(180deg,var(--pod-gold),var(--pod-blue));
  }
  .pod .pod-thesis p {
    margin:0;
    font-size:19px;
    line-height:1.55;
    letter-spacing:-.012em;
    font-weight:650;
  }
  .pod .pod-thesis small {
    display:block;
    margin-bottom:8px;
    color:var(--pod-gold);
    font-size:10.5px;
    text-transform:uppercase;
    letter-spacing:.15em;
    font-weight:800;
  }
  .pod .pod-proof-key {
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin:14px 0 20px;
  }
  .pod .pod-proof-chip {
    display:inline-flex;
    gap:5px;
    align-items:center;
    border:1px solid var(--line);
    border-radius:999px;
    padding:4px 8px;
    color:var(--muted);
    font-size:10.5px;
    background:var(--panel2);
  }
  .pod sup.ev {
    display:inline-block;
    font-size:9px;
    font-weight:850;
    line-height:1;
    padding:2px 4px;
    border-radius:4px;
    margin-left:2px;
    vertical-align:2px;
  }
  .pod .ev-f { color:#218754; background:color-mix(in srgb,#46b87a 15%,transparent); }
  .pod .ev-c { color:#3f71c5; background:color-mix(in srgb,#5b8def 15%,transparent); }
  .pod .ev-i { color:#765fc1; background:color-mix(in srgb,#8f7bd8 15%,transparent); }
  .pod .ev-s { color:#a76c16; background:color-mix(in srgb,#d6a84b 18%,transparent); }
  html[data-theme="dark"] .pod .ev-f { color:#55c98e; }
  html[data-theme="dark"] .pod .ev-c { color:#81aaf0; }
  html[data-theme="dark"] .pod .ev-i { color:#b5a4ef; }
  html[data-theme="dark"] .pod .ev-s { color:#e4bb68; }

  .pod .pod-figure {
    margin:27px 0;
    border:1px solid var(--line);
    border-radius:18px;
    padding:16px 17px 13px;
    background:
      linear-gradient(var(--panel),var(--panel)) padding-box,
      linear-gradient(135deg,var(--pod-blue),var(--pod-gold)) border-box;
    box-shadow:var(--card-shadow);
    overflow:hidden;
  }
  .pod .pod-figure-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:12px;
  }
  .pod .pod-figure-head b {
    font-size:11px;
    letter-spacing:.11em;
    text-transform:uppercase;
    color:var(--text);
  }
  .pod .pod-figure-head span {
    color:var(--muted);
    font-size:9.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .pod .pod-figure svg {
    display:block;
    width:100%;
    height:auto;
    overflow:visible;
  }
  .pod .pod-figure figcaption {
    margin-top:11px;
    padding-top:9px;
    border-top:1px dashed var(--line);
    color:var(--muted);
    font-size:11.5px;
    line-height:1.55;
  }
  .pod .pod-svg-text { fill:var(--text); font-family:var(--font-ui); }
  .pod .pod-svg-muted { fill:var(--muted); font-family:var(--font-ui); }
  .pod .pod-svg-grid { stroke:var(--pod-grid); }
  .pod .pod-node {
    fill:color-mix(in srgb,var(--panel2) 92%,transparent);
    stroke:var(--line);
  }
  .pod .pod-arrow {
    fill:none;
    stroke:var(--pod-blue);
    stroke-width:2.2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }
  .pod .pod-arrow-gold { stroke:var(--pod-gold); }
  .pod .pod-arrow-teal { stroke:var(--pod-teal); }
  .pod .pod-arrow-red { stroke:var(--pod-red); }
  .pod .pod-reveal {
    opacity:1;
    transform:none;
    transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1);
  }
  .pod .pod-figure.pod-motion-pending .pod-reveal {
    opacity:0;
    transform:translateY(7px);
  }
  .pod .pod-figure.is-visible .pod-reveal {
    opacity:1;
    transform:none;
  }
  .pod .pod-figure.is-visible .pod-reveal:nth-of-type(2) { transition-delay:.12s; }
  .pod .pod-figure.is-visible .pod-reveal:nth-of-type(3) { transition-delay:.24s; }
  .pod .pod-figure.is-visible .pod-reveal:nth-of-type(4) { transition-delay:.36s; }
  .pod .pod-figure.is-visible .pod-reveal:nth-of-type(5) { transition-delay:.48s; }
  .pod .pod-draw {
    stroke-dasharray:760;
    stroke-dashoffset:0;
    transition:stroke-dashoffset 1.15s cubic-bezier(.3,.7,.2,1);
  }
  .pod .pod-figure.pod-motion-pending .pod-draw { stroke-dashoffset:760; }
  .pod .pod-figure.is-visible .pod-draw { stroke-dashoffset:0; }

  .pod .pod-accounting {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin:17px 0 23px;
  }
  .pod .pod-ledger {
    border:1px solid var(--line);
    border-radius:14px;
    padding:15px 16px;
    background:var(--panel2);
  }
  .pod .pod-ledger h3 {
    margin:0 0 9px;
    font-size:13px;
  }
  .pod .pod-ledger.good { border-top:3px solid var(--pod-teal); }
  .pod .pod-ledger.bad { border-top:3px solid var(--pod-red); }
  .pod .pod-ledger ul { margin:0; padding-left:18px; }
  .pod .pod-ledger li { margin:5px 0; font-size:12.5px; line-height:1.48; }
  .pod .pod-callout {
    border-left:3px solid var(--pod-c,var(--pod-blue));
    background:color-mix(in srgb,var(--pod-c,var(--pod-blue)) 8%,var(--panel2));
    border-radius:0 12px 12px 0;
    padding:13px 15px;
    margin:18px 0;
  }
  .pod .pod-callout b {
    color:var(--pod-c,var(--pod-blue));
    display:block;
    font-size:11px;
    letter-spacing:.1em;
    text-transform:uppercase;
    margin-bottom:5px;
  }
  .pod .pod-callout p:last-child { margin-bottom:0; }
  .pod .pod-plain {
    margin:18px 0;
    border:1px solid var(--line);
    border-radius:14px;
    padding:15px 17px;
    background:var(--panel2);
  }
  .pod .pod-plain > b {
    display:block;
    margin-bottom:6px;
    color:var(--pod-gold);
    font-size:10.5px;
    text-transform:uppercase;
    letter-spacing:.12em;
  }
  .pod .pod-table-wrap { overflow-x:auto; margin:18px 0 25px; border:1px solid var(--line); border-radius:14px; }
  .pod table.pod-table { width:100%; min-width:680px; border-collapse:collapse; background:var(--panel); }
  .pod table.pod-table th,
  .pod table.pod-table td { border-bottom:1px solid var(--line); padding:10px 11px; vertical-align:top; }
  .pod table.pod-table th {
    background:var(--panel2);
    color:var(--muted);
    font-size:10px;
    letter-spacing:.075em;
    text-transform:uppercase;
    text-align:left;
  }
  .pod table.pod-table td { font-size:12px; line-height:1.45; }
  .pod table.pod-table tr:last-child td { border-bottom:0; }
  .pod .pod-rule {
    border:0;
    border-top:1px solid var(--line);
    margin:29px 0;
  }
  .pod .pod-copy p { margin:0 0 15px; }
  .pod .pod-copy blockquote {
    margin:20px 0;
    padding:16px 19px;
    border-left:3px solid var(--pod-gold);
    background:var(--panel2);
    border-radius:0 12px 12px 0;
    font-size:17px;
    line-height:1.55;
    font-weight:650;
  }
  .pod .pod-copy h3 { margin-top:28px; scroll-margin-top:88px; }
  .pod .pod-strongline {
    font-size:17px;
    line-height:1.5;
    font-weight:750;
    letter-spacing:-.01em;
    color:var(--text);
    margin:19px 0;
  }
  .pod .pod-source-list {
    display:grid;
    gap:8px;
    margin:14px 0;
  }
  .pod .pod-source-list a {
    display:block;
    padding:10px 12px;
    border:1px solid var(--line);
    border-radius:10px;
    background:var(--panel2);
    font-size:12px;
  }
  .pod .pod-note {
    color:var(--muted);
    font-size:11.5px;
    line-height:1.55;
  }

  /* Editorial V2 — Wave 1 composition shell. The shared article base still owns
     the hero, active TOC, callouts and compact data tables. These rules compose
     those primitives into the denser Fable-quality report rhythm. */
  .pod .pod-v2-shell { display:block; }
  .pod .pod-legacy[hidden] { display:none !important; }
  .pod .statband {
    display:grid;
    grid-template-columns:repeat(5,minmax(0,1fr));
    gap:10px;
    margin:2px 0 12px;
  }
  .pod .stat {
    min-width:0;
    position:relative;
    overflow:hidden;
    min-height:116px;
    padding:14px 14px 13px;
    border:1px solid var(--line);
    border-radius:14px;
    background:
      radial-gradient(circle at 100% 0,color-mix(in srgb,var(--sc,var(--pod-blue)) 14%,transparent),transparent 52%),
      var(--panel2);
    box-shadow:var(--card-shadow);
  }
  .pod .stat::before {
    content:"";
    position:absolute;
    inset:0 auto 0 0;
    width:3px;
    background:var(--sc,var(--pod-blue));
  }
  .pod .stat .sk {
    display:block;
    color:var(--muted);
    font-size:9.5px;
    line-height:1.25;
    letter-spacing:.1em;
    text-transform:uppercase;
    font-weight:750;
  }
  .pod .stat .sv {
    display:block;
    margin-top:8px;
    color:var(--text);
    font-size:23px;
    line-height:1;
    letter-spacing:-.025em;
    font-weight:780;
    font-variant-numeric:tabular-nums;
  }
  .pod .stat .sl {
    display:block;
    margin-top:8px;
    color:var(--muted);
    font-size:10.5px;
    line-height:1.35;
  }
  .pod .pod-v2-asof {
    margin:0 0 17px;
    color:var(--muted);
    font-size:10.5px;
    line-height:1.5;
  }
  .pod .pod-bottom-line {
    margin:15px 0 26px;
    padding:20px 22px;
    border-left-width:4px;
  }
  .pod .pod-bottom-line .co-h {
    color:#2f9e63;
    font-size:10.5px;
    letter-spacing:.13em;
    text-transform:uppercase;
  }
  html[data-theme="dark"] .pod .pod-bottom-line .co-h { color:#55c98e; }
  .pod .pod-bottom-line p {
    margin:0;
    font-size:16px;
    line-height:1.62;
    letter-spacing:-.006em;
  }
  .pod .pod-section-kicker {
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:8px;
    margin:4px 0 13px;
    color:var(--muted);
    font-size:10px;
    letter-spacing:.09em;
    text-transform:uppercase;
    font-weight:750;
  }
  .pod .pod-section-kicker::before {
    content:"";
    width:22px;
    height:2px;
    border-radius:2px;
    background:linear-gradient(90deg,var(--pod-gold),var(--pod-blue));
  }
  .pod .pod-intro-grid {
    display:grid;
    grid-template-columns:minmax(0,1.35fr) minmax(220px,.65fr);
    gap:18px;
    align-items:start;
    margin:8px 0 19px;
  }
  .pod .pod-intro-grid .pod-copy p:first-child { margin-top:0; }
  .pod .pod-mechanism-card {
    border:1px solid color-mix(in srgb,var(--pod-gold) 38%,var(--line));
    border-radius:15px;
    padding:16px;
    background:linear-gradient(150deg,color-mix(in srgb,var(--pod-gold) 10%,var(--panel2)),var(--panel2));
  }
  .pod .pod-mechanism-card .mk {
    display:block;
    color:var(--pod-gold);
    font-size:9.5px;
    letter-spacing:.11em;
    text-transform:uppercase;
    font-weight:800;
  }
  .pod .pod-mechanism-card strong {
    display:block;
    margin:7px 0 9px;
    font-size:18px;
    line-height:1.28;
    letter-spacing:-.015em;
  }
  .pod .pod-mechanism-card p {
    margin:0;
    color:var(--muted);
    font-size:12px;
    line-height:1.55;
  }
  .pod .pod-loop {
    display:grid;
    grid-template-columns:repeat(6,minmax(0,1fr));
    gap:0;
    margin:17px 0 20px;
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    background:var(--panel2);
  }
  .pod .pod-loop-step {
    position:relative;
    padding:12px 18px 12px 11px;
    min-height:74px;
    border-right:1px solid var(--line);
  }
  .pod .pod-loop-step:last-child { border-right:0; }
  .pod .pod-loop-step:not(:last-child)::after {
    content:"→";
    position:absolute;
    z-index:2;
    top:26px;
    right:-8px;
    width:16px;
    color:var(--pod-gold);
    background:var(--panel2);
    text-align:center;
    font-weight:800;
  }
  .pod .pod-loop-step b {
    display:block;
    font-size:11px;
    line-height:1.25;
  }
  .pod .pod-loop-step small {
    display:block;
    margin-top:5px;
    color:var(--muted);
    font-size:9.5px;
    line-height:1.3;
  }
  .pod .pod-stage-band {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:10px;
    margin:17px 0 22px;
  }
  .pod .pod-stage {
    border:1px solid var(--line);
    border-top:3px solid var(--stage,var(--pod-blue));
    border-radius:12px;
    padding:13px 14px;
    background:var(--panel2);
  }
  .pod .pod-stage b { display:block; font-size:12px; }
  .pod .pod-stage p { margin:6px 0 0; color:var(--muted); font-size:11px; line-height:1.42; }
  .pod .pod-split-figure {
    display:grid;
    grid-template-columns:minmax(0,1.25fr) minmax(240px,.75fr);
    gap:14px;
    align-items:stretch;
    margin:16px 0 20px;
  }
  .pod .pod-split-figure .pod-figure { margin:0; }
  .pod .pod-equation {
    display:flex;
    flex-direction:column;
    justify-content:center;
    border:1px solid var(--line);
    border-radius:18px;
    padding:18px;
    background:
      radial-gradient(circle at 100% 0,color-mix(in srgb,var(--pod-violet) 18%,transparent),transparent 45%),
      var(--panel2);
  }
  .pod .pod-equation .eq-k {
    color:var(--pod-violet);
    font-size:9.5px;
    letter-spacing:.12em;
    text-transform:uppercase;
    font-weight:800;
  }
  .pod .pod-equation .eq-main {
    margin:13px 0;
    font-size:18px;
    line-height:1.3;
    font-weight:780;
    letter-spacing:-.015em;
  }
  .pod .pod-equation .eq-rule {
    height:1px;
    margin:7px 0;
    background:linear-gradient(90deg,var(--pod-violet),transparent);
  }
  .pod .pod-equation p { margin:4px 0 0; color:var(--muted); font-size:11px; line-height:1.5; }
  .pod .pod-status-grid {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:10px;
    margin:18px 0 24px;
  }
  .pod .vcard {
    min-width:0;
    border:1px solid var(--line);
    border-top:3px solid var(--vc,var(--pod-blue));
    border-radius:13px;
    padding:13px 14px;
    background:var(--panel2);
  }
  .pod .vcard .vtag {
    display:inline-flex;
    align-items:center;
    gap:6px;
    color:var(--vc,var(--pod-blue));
    font-size:9.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    font-weight:800;
  }
  .pod .vcard .vtag::before {
    content:"";
    width:7px;
    height:7px;
    border-radius:50%;
    background:currentColor;
    box-shadow:0 0 0 3px color-mix(in srgb,currentColor 16%,transparent);
  }
  .pod .vcard h3 { margin:9px 0 5px; font-size:14px; }
  .pod .vcard p { margin:0; color:var(--muted); font-size:11px; line-height:1.45; }
  .pod .pod-regime-strip {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:10px;
    margin:16px 0 20px;
  }
  .pod .pod-regime-card {
    min-width:0;
    border:1px solid var(--line);
    border-top:3px solid var(--rc,var(--pod-blue));
    border-radius:13px;
    padding:13px 14px;
    background:var(--panel2);
  }
  .pod .pod-regime-card .rp {
    color:var(--rc,var(--pod-blue));
    font-size:23px;
    line-height:1;
    font-weight:800;
    font-variant-numeric:tabular-nums;
  }
  .pod .pod-regime-card b { display:block; margin-top:7px; font-size:12px; line-height:1.25; }
  .pod .pod-regime-card p { margin:6px 0 0; color:var(--muted); font-size:10.5px; line-height:1.4; }
  .pod .pod-compact { margin-top:12px; margin-bottom:24px; }
  .pod .pod-compact th,
  .pod .pod-compact td { font-size:11.5px; line-height:1.35; padding:7px 8px; }
  .pod .pod-shell-rail {
    display:flex;
    flex-wrap:wrap;
    gap:7px;
    margin:10px 0 15px;
  }
  .pod .pod-shell-rail .chip { font-size:10px; padding:5px 8px; }
  .pod .pod-dashboard td:first-child { width:25%; }
  .pod .pod-timeline {
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:10px;
    margin:16px 0 24px;
  }
  .pod .pod-gate {
    border:1px solid var(--line);
    border-radius:13px;
    padding:13px 14px;
    background:var(--panel2);
  }
  .pod .pod-gate .gk { color:var(--pod-gold); font-size:9px; letter-spacing:.1em; text-transform:uppercase; font-weight:800; }
  .pod .pod-gate b { display:block; margin:7px 0 4px; font-size:12px; }
  .pod .pod-gate p { margin:0; color:var(--muted); font-size:10.5px; line-height:1.4; }
  .pod .pquote {
    position:relative;
    overflow:hidden;
    margin:23px 0;
    padding:23px 26px;
    border:1px solid var(--line);
    border-radius:17px;
    background:linear-gradient(135deg,color-mix(in srgb,var(--pod-blue) 13%,var(--panel)),color-mix(in srgb,var(--pod-gold) 10%,var(--panel)));
  }
  .pod .pquote::before {
    content:"\201C";
    position:absolute;
    top:-21px;
    left:13px;
    color:var(--pod-blue);
    opacity:.16;
    font:96px/1 Georgia,serif;
  }
  .pod .pquote p { position:relative; margin:0; font-size:16px; line-height:1.55; font-weight:650; }

  @media(max-width:720px) {
    .pod .statband { grid-template-columns:repeat(2,minmax(0,1fr)); }
