    <span class="pod-proof-chip"><sup class="ev ev-i">I</sup>{{ t('Mastermind inference', 'Mastermind 推断') }}</span>
    <span class="pod-proof-chip"><sup class="ev ev-s">S</sup>{{ t('Scenario / desk estimate', '情景 / 本台估计') }}</span>
