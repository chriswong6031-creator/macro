{# /help — deterministic directory over existing product owners. No editorial corpus. #}
{% macro t(en, zh) -%}
<span class="l-en">{{ en|replace('&amp;', '&')|forceescape }}</span><span class="l-zh">{{ zh|replace('&amp;', '&')|forceescape }}</span>
{%- endmacro %}
{% macro t_text(en, zh) -%}{{ en }} / {{ zh }}{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Help — MastermindX</title>
{% set seo_title = "Help — MastermindX" %}
{% set seo_desc = "Market Reference, Methodology, Support, account and billing links." %}
{% set seo_path = "help.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',th||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
/* DARK TREATMENT: an open command-centre canvas; quiet luminance and a thin
   cyan instrument rail separate the fixed destinations without a panel slab. */
*{box-sizing:border-box}
body{margin:0;padding-top:18px;background:var(--bg);color:var(--text);font:14.5px/1.55 var(--font-ui);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
.help-shell{max-width:1120px;margin:0 auto;padding:clamp(28px,5vw,64px) clamp(18px,4vw,44px) 80px}
.help-hero{max-width:760px;padding:18px 0 34px;position:relative}
.help-hero::before{content:"";position:absolute;left:-28px;top:10px;bottom:34px;width:2px;background:linear-gradient(180deg,var(--link),transparent)}
.help-kicker{display:block;margin:0 0 14px;color:var(--muted);font:650 11px/1 var(--font-mono);letter-spacing:.14em;text-transform:uppercase}
.help-hero h1{margin:0;font:760 clamp(34px,6vw,64px)/1 var(--font-ui);letter-spacing:-.045em}
.help-owners{margin:16px 0 0;color:var(--muted);font-size:clamp(14px,2vw,16px)}
.help-controls{display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:14px;align-items:center;padding:16px 0 24px;border-top:1px solid var(--line)}
.help-search{position:relative;max-width:520px}
.help-search input{width:100%;min-height:44px;padding:10px 42px 10px 14px;border:1px solid var(--line);border-radius:var(--r-ctl,8px);background:var(--panel2);color:var(--text);font:inherit;outline:none}
.help-search input:focus{border-color:var(--link);box-shadow:0 0 16px -5px color-mix(in srgb,var(--link) 55%,transparent)}
.help-search svg{position:absolute;right:14px;top:13px;width:18px;height:18px;fill:none;stroke:var(--muted);stroke-width:1.8}
.help-filters{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px}
.help-filter{min-height:44px;padding:8px 13px;border:1px solid var(--line);border-radius:var(--r-pill,999px);background:transparent;color:var(--muted);font:650 12px/1 var(--font-ui);cursor:pointer}
.help-filter:hover,.help-filter[aria-pressed="true"]{border-color:color-mix(in srgb,var(--link) 65%,var(--line));color:var(--text);background:var(--panel2)}
.help-meta{display:flex;justify-content:space-between;gap:16px;margin:0 0 13px;color:var(--muted);font:600 11px/1.4 var(--font-mono);letter-spacing:.08em;text-transform:uppercase}
.help-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:transparent}
.help-card{min-width:0;min-height:138px;padding:21px 22px;background:var(--bg);box-shadow:0 0 0 1px var(--line);display:flex;flex-direction:column;justify-content:space-between;gap:24px;transition:background .16s ease,transform .16s ease}
.help-card:hover,.help-card:focus-visible{background:var(--panel);outline:none;transform:translateY(-1px)}
.help-card[hidden]{display:none}
.help-card-top{display:flex;align-items:center;gap:10px;color:var(--muted);font:650 10px/1 var(--font-mono);letter-spacing:.1em;text-transform:uppercase}
.help-state{margin-left:auto;color:var(--ink-ok,var(--ok));letter-spacing:.04em}
.help-card[data-entry-state="unknown"]{cursor:not-allowed}
.help-card[data-entry-state="unknown"] .help-state{color:var(--muted)}
.help-card[data-entry-state="unknown"]:hover{transform:none}
.help-card-title{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;font:680 clamp(18px,2.3vw,24px)/1.2 var(--font-ui);letter-spacing:-.02em}
.help-arrow{color:var(--link);font:400 24px/1 var(--font-ui);transition:transform .16s ease}
.help-card:hover .help-arrow{transform:translateX(3px)}
.help-state-panel{padding:44px 22px;border:1px dashed var(--line);color:var(--muted);text-align:center;font:650 12px/1.5 var(--font-mono);letter-spacing:.08em;text-transform:uppercase}
.help-state-panel[hidden]{display:none}

/* LIGHT TREATMENT: a cool research-workspace canvas with white material cards,
   crisp hairlines and short shadows. No dark-theme glow is carried onto paper. */
html[data-theme="light"] .help-hero::before{background:var(--link)}
html[data-theme="light"] .help-search input{background:var(--panel);box-shadow:0 1px 2px color-mix(in srgb,var(--text) 7%,transparent)}
html[data-theme="light"] .help-search input:focus{box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 16%,transparent)}
html[data-theme="light"] .help-grid{gap:12px;background:transparent;border:0}
html[data-theme="light"] .help-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-card,12px);box-shadow:0 8px 24px color-mix(in srgb,var(--text) 7%,transparent)}
html[data-theme="light"] .help-card:hover,html[data-theme="light"] .help-card:focus-visible{border-color:color-mix(in srgb,var(--link) 45%,var(--line));box-shadow:0 12px 28px color-mix(in srgb,var(--text) 11%,transparent)}

@media (max-width:760px){
  .help-controls{grid-template-columns:1fr;align-items:stretch}
  .help-search{max-width:none}
  .help-filters{justify-content:flex-start}
}
@media (max-width:600px){
  .help-shell{padding:24px 16px 58px}
  .help-hero{padding:12px 12px 28px}
  .help-hero::before{left:0;top:8px;bottom:28px}
  .help-grid{grid-template-columns:1fr}
  .help-card{min-height:118px;padding:18px}
  html[data-theme="light"] .help-grid{gap:10px}
}
@media (prefers-reduced-motion:reduce){.help-card,.help-arrow{transition:none}.help-card:hover{transform:none}}
</style>
{% set rel = '' %}
{% include "_public_chrome_css.html.j2" %}
</head>
<body class="public-page">
{% include "_public_nav.html.j2" %}

<main class="help-shell" id="help-directory" data-directory-state="{{ directory_state }}">
  <header class="help-hero">
    <span class="help-kicker">{{ t('Resources', '资源') }}</span>
    <h1>{{ t('Help', '帮助') }}</h1>
    <p class="help-owners">{{ t('Market Reference', '市场参考') }} · {{ t('Methodology', '方法论') }} · {{ t('Support', '支持') }} · {{ t('Account', '账户') }}</p>
  </header>

{% if entries %}
  <section class="help-controls" aria-label="{{ t_text('Search and filter', '搜索与筛选') }}">
    <div class="help-search">
      <input id="help-search" type="search" autocomplete="off"
             aria-label="{{ t_text('Search', '搜索') }}"
             data-ph-en="Search" data-ph-zh="搜索" placeholder="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg>
    </div>
    <div class="help-filters" role="group" aria-label="{{ t_text('Filter', '筛选') }}">
      <button class="help-filter" type="button" data-category="all" aria-pressed="true">{{ t('All', '全部') }}</button>
{% for category in categories %}
      <button class="help-filter" type="button" data-category="{{ category.id }}" aria-pressed="false">{{ t(category.label_en, category.label_zh) }}</button>
{% endfor %}
    </div>
  </section>

  <div class="help-meta">
    <span>{{ t('Resources', '资源') }}</span>
    <span id="help-result-count" role="status" aria-live="polite">{{ entries|length }}</span>
  </div>
  <section class="help-grid" aria-label="{{ t_text('Help', '帮助') }}">
{% for entry in entries %}
{% if entry.state == 'complete' %}
      <a class="help-card" id="help-{{ entry.id }}" href="{{ entry.href }}"
         data-help-card data-entry-state="complete" data-category="{{ entry.category }}"
         data-search="{{ entry.label_en|lower }} {{ entry.label_zh }} {{ entry.href|lower }}">
        <span class="help-card-top">{{ t(entry.category_en, entry.category_zh) }}<span class="help-state">{{ t('Available', '可用') }}</span></span>
        <strong class="help-card-title">{{ t(entry.label_en, entry.label_zh) }}<span class="help-arrow" aria-hidden="true">↗</span></strong>
      </a>
{% else %}
      <article class="help-card" id="help-{{ entry.id }}" data-help-card data-entry-state="unknown" data-category="{{ entry.category }}" data-search="{{ entry.label_en|lower }} {{ entry.label_zh }}" aria-disabled="true">
        <span class="help-card-top">{{ t(entry.category_en, entry.category_zh) }}<span class="help-state">{{ t(entry.status_en, entry.status_zh) }}</span></span>
        <strong class="help-card-title">{{ t(entry.label_en, entry.label_zh) }}</strong>
      </article>
{% endif %}
{% endfor %}
  </section>
  <div class="help-state-panel" data-empty-state="empty" role="status" aria-live="polite" hidden>{{ t('No matching links', '没有匹配链接') }} · 0</div>
{% else %}
  <div class="help-state-panel" data-empty-state="empty" role="status" aria-live="polite">{{ t('No links available', '暂无可用链接') }} · 0</div>
{% endif %}
</main>

{% include "_public_footer.html.j2" %}
<script src="theme.js"></script>
{% include "_public_chrome_js.html.j2" %}
<script>
(function(){
  'use strict';
  var root=document.getElementById('help-directory');
  if(!root)return;
  var query=document.getElementById('help-search');
  if(!query)return;
  var count=document.getElementById('help-result-count');
  var empty=root.querySelector('[data-empty-state]');
  var cards=Array.prototype.slice.call(root.querySelectorAll('[data-help-card]'));
  var buttons=Array.prototype.slice.call(root.querySelectorAll('[data-category]'));
  var category='all';
  function normal(value){return (value||'').toLocaleLowerCase().trim();}
  function paint(){
    var needle=normal(query.value), visible=0, completeVisible=0;
    cards.forEach(function(card){
      var categoryMatch=category==='all'||card.getAttribute('data-category')===category;
      var searchMatch=!needle||normal(card.getAttribute('data-search')).indexOf(needle)!==-1;
      card.hidden=!(categoryMatch&&searchMatch);
      if(!card.hidden){
        visible+=1;
        if(card.getAttribute('data-entry-state')==='complete')completeVisible+=1;
      }
    });
    count.textContent=String(visible);
    empty.hidden=visible!==0;
    root.setAttribute('data-directory-state',visible?(completeVisible?'complete':'unknown'):'empty');
  }
  buttons.forEach(function(button){button.addEventListener('click',function(){
    category=button.getAttribute('data-category');
    buttons.forEach(function(other){other.setAttribute('aria-pressed',String(other===button));});
    paint();
  });});
  query.addEventListener('input',paint);
  function paintLanguage(){
    var zh=document.documentElement.getAttribute('data-lang')==='zh';
    query.setAttribute('placeholder',query.getAttribute(zh?'data-ph-zh':'data-ph-en'));
    query.setAttribute('aria-label',query.getAttribute(zh?'data-ph-zh':'data-ph-en'));
  }
  document.addEventListener('langchange',paintLanguage);
  paintLanguage();
})();
</script>
</body>
</html>
