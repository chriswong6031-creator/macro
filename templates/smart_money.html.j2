{# ---- D. Two half-width cards: sector consensus + grade-A ---- #}
<div class="sm-2half">

  {# D1. Sector rotation consensus #}
  <div class="sm-card">
    <div class="board-h">
      <span class="bt">{{ t('Sector Rotation Consensus','板块轮动共识') }}</span>
      {% if d_consensus %}
        {%- set _fol_meta = (desk.get('follow') or {}).get('meta') or {} -%}
        {%- set _nc_pr = _fol_meta.get('n_proven_rotators') -%}
        {%- set _nc_fd = (_fol_meta.get('n_fade') or 0) -%}
        <span class="chip-fresh">n {{ _nc_pr if _nc_pr is not none else '—' }} {{ t('proven rotators','经验证轮动者') }} · {{ _nc_fd }} {{ t('fade excluded','淡出排除') }}</span>
      {% endif %}
    </div>
    <div class="board-note">{{ t('IQ-weighted sector delta (pp). Descriptive screen — n printed, not a forecast.','IQ加权板块变化（百分点）。描述性筛选——样本量已打印，非预测。') }}</div>
    {% if d_consensus %}
      {%- set _cs_mx = namespace(v=0.0) -%}
      {%- for _cr in d_consensus -%}{%- set _a = (_cr.get('iq_weighted_delta_pp') or 0) | abs -%}{%- if _a > _cs_mx.v -%}{%- set _cs_mx.v = _a -%}{%- endif -%}{%- endfor -%}
      <ul class="rotbars">
      {% for _cr in d_consensus %}
        {%- set _npp = _cr.get('iq_weighted_delta_pp') or 0 -%}
        {%- set _w = (((_npp | abs) / _cs_mx.v) * 50) | round(1) if _cs_mx.v > 0 else 0 -%}
        {%- set _tb = (_cr.get('top_buys') or []) | map(attribute='ticker') | list -%}
        <li data-tip-en="breadth: {{ _cr.get('breadth_up') or 0 }} up / {{ _cr.get('breadth_down') or 0 }} down · top buys: {{ _tb | join(', ') or '—' }}" data-tip-zh="广度：{{ _cr.get('breadth_up') or 0 }} 上升 / {{ _cr.get('breadth_down') or 0 }} 下降 · 主要买入：{{ _tb | join(', ') or '—' }}">
          <span class="rb-lab">{{ _cr.get('sector') or '—' }}</span>
          <span class="rb-track"><i class="rb-fill {{ 'pos' if _npp >= 0 else 'neg' }}" style="width:{{ _w }}%"></i></span>
          <span class="rb-val num {{ 'r-pos' if _npp >= 0 else 'r-neg' }}">{{ "%+.1f" | format(_npp) }}pp</span>
          <span class="sub num">{{ _cr.get('breadth_up') or 0 }}/{{ _cr.get('breadth_down') or 0 }}</span>
        </li>
      {% endfor %}
      </ul>
    {% else %}<p class="follow-empty">{{ t('Not computed this run.','本次未计算。') }}</p>{% endif %}
  </div>

  {# D2. Grade-A Q1 report card #}
  <div class="sm-card">
    <div class="board-h">
      <span class="bt">{{ t('Grade-A Report Card','A级成绩单') }}</span>
      {% if d_grade_a is not none and d_grade_a.get('as_of') %}
        <span class="frozen-chip">{{ t('FROZEN','已冻结') }}</span>
        <span class="chip-fresh">{{ t('as of','截至') }} {{ d_grade_a.get('as_of') or '—' }}</span>
      {% endif %}
    </div>
    <div class="board-note">{{ t('One cohort, one quarter — receipts, not a base rate. Decision-weighted 60d excess vs SPY from the common anchor date.','一个队列，一个季度——凭证而非基准利率。自公共锚定日起60日决策加权超额对标标普。') }}</div>
    {% if d_grade_a is not none and d_grade_a.get('rows') %}
      <table class="sm-t" style="margin-top:6px">
        <thead><tr>
          <th class="l">{{ t('Fund','基金') }}</th>
          <th>{{ t('n','n') }}</th>
          <th>{{ t('60d DW excess','60日DW超额') }}</th>
          <th>{{ t('New / Add · 60d excess','新建/加仓 · 60日超额') }}</th>
          <th>{{ t('Hit 60d','60日胜率') }}</th>
        </tr></thead>
        <tbody>
        {%- set _ga_rows = d_grade_a.get('rows') or [] -%}
        {%- set _ga_best_ex = (_ga_rows[0].get('dw_excess_60d') if _ga_rows else none) -%}
        {%- for _ga_r in _ga_rows -%}
          {%- set _ga_ex = _ga_r.get('dw_excess_60d') -%}
          {%- set _is_best = (_ga_ex is not none and _ga_best_ex is not none and _ga_ex == _ga_best_ex) -%}
          <tr {{ 'class="feat"' if _is_best else '' }}>
            <td class="l">{{ _ga_r.get('name') or _ga_r.get('fund') or '—' }}</td>
            <td class="num sub">{{ _ga_r.get('n_priced') if _ga_r.get('n_priced') is not none else '—' }}</td>
            <td>{{ exret(_ga_r.get('dw_excess_60d')) }}</td>
            <td class="sub">{{ exret(_ga_r.get('new_dw_excess_60d')) }} / {{ exret(_ga_r.get('add_dw_excess_60d')) }}</td>
            <td class="num">{{ hit(_ga_r.get('hit_60d')) }}</td>
          </tr>
        {%- endfor -%}
        </tbody>
      </table>
      <div class="hon-note" style="margin-top:8px">{{ t('Frozen study — one cohort, one quarter. See research/ for the full memo.','冻结研究——一个队列，一个季度。详见 research/ 中的完整备忘录。') }}</div>
    {% else %}<p class="follow-empty">{{ t('Grade-A card not available this run.','本次未获A级成绩单。') }}</p>{% endif %}
  </div>

</div>{# /sm-2half #}

<p class="disc" style="margin-top:14px">{{ t(
  'Follow Desk — scan bounds: tracked funds only (n printed above), historical quarters in the store. 13F lag ~45 days. Scores are descriptive composites; not a forecast, not a buy signal.',
  '跟随台——扫描范围：仅跟踪基金（样本量见上）及存储中的历史季度。13F约45天滞后。分数为描述性综合指标；非预测，非买入信号。'
) }}</p>

{% else %}{# no followability data #}
<div class="sm-card"><p class="follow-empty">{{ t('Follow Desk not computed this build — follow, best-buys, and consensus boards will appear on the next successful run.','本次构建未计算跟随台——跟随、最佳买入及共识看板将在下次成功构建时出现。') }}</p></div>
{% endif %}{# /followability #}

{# ======================================================================== #}
{# S2.5 CONSENSUS FLOW (v3)                                                  #}
{# ======================================================================== #}
{#- v3 macros — defined OUTSIDE the section guard (see S1.5 note). -#}
{%- macro fl_logo(tk) -%}
<img class="tlogo" src="https://cdn.jsdelivr.net/gh/nvstly/icons@main/ticker_icons/{{ tk }}.png" loading="eager" onerror="this.style.display='none'" alt="">
{%- endmacro -%}
{%- macro fl_usdn(v) -%}
  {%- if v is none -%}—{%- else -%}
    {%- set a = v | abs -%}
    {{- '−' if v < 0 else '+' -}}
    {%- if a >= 1000000000 -%}${{ "%.1f" | format(a / 1000000000) }}B
    {%- elif a >= 1000000 -%}${{ "%.1f" | format(a / 1000000) }}M
    {%- elif a >= 1000 -%}${{ "%.0f" | format(a / 1000) }}K
    {%- else -%}${{ "%.0f" | format(a) }}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}
{%- macro fl_comp(v) -%}
  {%- if v is mapping -%}
    {%- set v = v.get('value') if v.get('value') is not none else v.get('points') -%}
  {%- endif -%}
  {%- if v is none -%}—
  {%- elif v is number -%}
    {%- if v == (v | round(0)) -%}{{ v | int }}{%- else -%}{{ "%.2f" | format(v) }}{%- endif -%}
  {%- else -%}{{ v }}
  {%- endif -%}
{%- endmacro -%}
{% macro flow_row(row, i) %}
    {% set _nb = row.get('n_buying') or 0 %}
    {% set _ns = row.get('n_selling') or 0 %}
    {% set _tot = _nb + _ns %}
    <tr>
      <td class="l rk num">{{ i }}</td>
      <td class="l">{{ fl_logo(row.get('ticker') or '') }}<span class="tk">{{ row.get('ticker') or '—' }}</span> <span class="sub2">{{ (row.get('issuer') or '') | title }}</span></td>
      <td><span class="bbar" data-tip-en="{{ _nb }} buying · {{ _ns }} selling" data-tip-zh="{{ _nb }} 买入 · {{ _ns }} 卖出">{% if _tot > 0 %}<i class="bi" style="width:{{ ((_nb / _tot) * 100) | round(1) }}%"></i><i class="bo" style="width:{{ ((_ns / _tot) * 100) | round(1) }}%"></i>{% endif %}</span> <span class="num sub">{{ _nb }}/{{ _ns }}</span></td>
      <td class="num">{{ "%+.1f" | format(row.get('gw_breadth') or 0) }}</td>
      <td class="num">{{ "%+d" | format(row.get('d_funds_qoq') or 0) }}</td>
      <td class="num">{{ fl_usdn(row.get('est_flow_usd')) }}</td>
      <td class="l">
        {% set _bf = row.get('buy_funds') or [] %}
        {% set _sf = row.get('sell_funds') or [] %}
        <details class="fl">
          <summary>{{ _bf | length }} {{ t('in','入') }} / {{ _sf | length }} {{ t('out','出') }}</summary>
          <div class="fl-body">
            {% for _f in _bf %}<span class="mchip">{{ _f.get('name') or _f.get('slug') or '—' }} · {{ _f.get('grade') or '—' }} · {{ _f.get('action') or '' }} {{ pctf(_f.get('pct_book')) }}</span>{% endfor %}
            {% for _f in _sf %}<span class="mchip">{{ _f.get('name') or _f.get('slug') or '—' }} · {{ _f.get('grade') or '—' }} · {{ _f.get('action') or '' }}</span>{% endfor %}
          </div>
        </details>
      </td>
    </tr>
{% endmacro %}
{% macro rot_bars(groups) %}
  {% if groups %}
  {% set _mx = namespace(v=0.0) %}
  {% for _g in groups %}{% set _a = (_g.get('net_pp') or 0) | abs %}{% if _a > _mx.v %}{% set _mx.v = _a %}{% endif %}{% endfor %}
  <ul class="rotbars">
  {% for _g in groups %}
    {% set _npp = _g.get('net_pp') or 0 %}
    {% set _w = (((_npp | abs) / _mx.v) * 50) | round(1) if _mx.v > 0 else 0 %}
    <li data-tip-en="into: {{ (_g.get('top_names_in') or []) | map(attribute='ticker') | join(', ') or '—' }} · out of: {{ (_g.get('top_names_out') or []) | map(attribute='ticker') | join(', ') or '—' }}" data-tip-zh="轮入：{{ (_g.get('top_names_in') or []) | map(attribute='ticker') | join(', ') or '—' }} · 轮出：{{ (_g.get('top_names_out') or []) | map(attribute='ticker') | join(', ') or '—' }}">
      <span class="rb-lab">{{ t(_g.get('label') or _g.get('key') or '—', _g.get('label_zh') or _g.get('label') or _g.get('key') or '—') }}</span>
      <span class="rb-track"><i class="rb-fill {{ 'pos' if _npp >= 0 else 'neg' }}" style="width:{{ _w }}%"></i></span>
      <span class="rb-val num {{ 'r-pos' if _npp >= 0 else 'r-neg' }}">{{ "%+.1f" | format(_npp) }}pp</span>
      <span class="sub num">{{ _g.get('n_funds_in') or 0 }}/{{ _g.get('n_funds_out') or 0 }}</span>
    </li>
  {% endfor %}
  </ul>
  {% else %}<p class="sub">{{ t('Unavailable this build.','本次构建不可用。') }}</p>{% endif %}
{% endmacro %}
{% set d_flow = desk.get('flow') or {} %}
{% if d_flow %}
{% set fl_stock = d_flow.get('stock') or {} %}
