{% extends "report_base.html.j2" %}
{% block title %}{{ t('13F Smart-Money Tracker — who made the excellent trades', '13F 聪明钱追踪 — 谁做出了卓越交易') }}{% endblock %}

{% block base_css %}
  .sm { --num: "SF Mono", ui-monospace, "DejaVu Sans Mono", monospace; max-width:1180px; margin:0 auto; }
  .sm-eyebrow { font:600 12px/1 var(--num); letter-spacing:.14em; text-transform:uppercase; color:var(--muted); }
  .sm h1 { font-size:clamp(25px,4vw,37px); margin:.28em 0 .12em; letter-spacing:-.01em; }
  .sm-sub { color:var(--muted); max-width:800px; font-size:14px; line-height:1.55; }
  .sm-meta { display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 4px; }
  .sm-meta .chip { font-family:var(--num); }
  .sm-sec { margin:34px 0 8px; }
  .sm-sec h2 { font-size:18px; margin:0 0 3px; display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .sm-sec .h-note { font-size:12px; color:var(--muted); font-weight:400; }
  .num { font-family:var(--num); }
  /* excess-return colours (NOT tied to the zh red=up swap — base provides r-pos/r-neg) */
  .big { font:650 25px/1.05 var(--num); }
  .grade { display:inline-flex; align-items:center; justify-content:center; min-width:24px; height:24px; padding:0 6px;
           border-radius:7px; font:700 13px/1 var(--num); border:1px solid var(--line); }
  .grade.A { color:#0f8a4a; border-color:#0f8a4a66; background:#0f8a4a14; }
  .grade.B { color:#3b82f6; border-color:#3b82f666; background:#3b82f614; }
  .grade.C { color:#c98a1a; border-color:#c98a1a66; background:#c98a1a14; }
  .grade.D { color:#d23f3f; border-color:#d23f3f66; background:#d23f3f14; }
  .grade.na { color:var(--muted); }
  html[data-theme="dark"] .grade.A { color:#3fc07e; } html[data-theme="dark"] .grade.C { color:#e0a93a; }
  html[data-theme="dark"] .grade.D { color:#ef6a6a; }

  /* ---- featured head-to-head ---- */
  .sm-vs { display:grid; grid-template-columns:1fr auto 1fr; gap:0; align-items:stretch; margin-top:10px; }
  @media(max-width:760px){ .sm-vs { grid-template-columns:1fr; } .sm-vs .vs-mid { flex-direction:row; padding:10px 0; } }
  .vs-card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 18px; }
  .vs-card.win { border-left:4px solid var(--up); }
  .vs-card.lag { border-left:4px solid var(--down); }
  .vs-mid { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; padding:0 14px; }
  .vs-mid .vs-gap { font:700 22px/1 var(--num); }
  .vs-mid .vs-lab { font:600 9px/1.2 var(--num); letter-spacing:.1em; text-transform:uppercase; color:var(--muted); text-align:center; }
  .vs-role { font:600 10px/1 var(--num); letter-spacing:.12em; text-transform:uppercase; }
  .vs-card.win .vs-role { color:var(--up); } .vs-card.lag .vs-role { color:var(--down); }
  .vs-name { font-size:18px; font-weight:700; margin:5px 0 2px; }
  .vs-stat { display:flex; gap:18px; flex-wrap:wrap; margin:10px 0 6px; }
  .vs-stat .k { font:600 9px/1.2 var(--num); letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .vs-stat .v { font:650 18px/1.1 var(--num); margin-top:3px; }
  .vs-list { margin:8px 0 0; padding:0; list-style:none; }
  .vs-list li { display:flex; align-items:baseline; gap:8px; padding:4px 0; border-top:1px solid var(--line); font-size:12.5px; }
  .vs-list li .tk { font:700 12.5px/1 var(--num); min-width:46px; }
  .vs-list li .act { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .vs-sig { font-size:11.5px; color:var(--muted); margin-top:9px; }

  /* ---- tables ---- */
  table.sm-t { width:100%; border-collapse:collapse; font-size:12.5px; margin-top:6px; }
  table.sm-t th { text-align:right; font:600 9.5px/1.2 var(--num); letter-spacing:.05em; text-transform:uppercase;
                  color:var(--muted); padding:6px 9px 8px; border-bottom:1px solid var(--line); white-space:nowrap; }
  table.sm-t th.l, table.sm-t td.l { text-align:left; }
  table.sm-t td { padding:7px 9px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
  table.sm-t tbody tr:hover { background:var(--panel2); }
  table.sm-t tr.feat td { background:color-mix(in srgb, var(--up) 7%, transparent); }
  table.sm-t .tk { font:700 12.5px/1 var(--num); }
  table.sm-t .rk { color:var(--muted); font-family:var(--num); }
  .star { color:#e0a93a; }
  .act-pill { font:600 9px/1 var(--num); padding:3px 6px; border-radius:5px; border:1px solid var(--line); color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
  .act-pill.new, .act-pill.add { color:var(--up); border-color:color-mix(in srgb, var(--up) 40%, transparent); }
  .act-pill.trim, .act-pill.exit { color:var(--down); border-color:color-mix(in srgb, var(--down) 40%, transparent); }
  .sub { font-size:10.5px; color:var(--muted); }
  .sub2 { opacity:.72; font-weight:500; }

  /* ---- two-board grid + per-fund drilldown ---- */
  .sm-2col { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  @media(max-width:820px){ .sm-2col { grid-template-columns:1fr; } }
  .sm-card { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:13px 15px; margin-top:12px; }
  details.fund { background:var(--panel); border:1px solid var(--line); border-radius:11px; margin-top:10px; }
  details.fund > summary { list-style:none; cursor:pointer; padding:12px 15px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  details.fund > summary::-webkit-details-marker { display:none; }
  details.fund[open] > summary { border-bottom:1px solid var(--line); }
  .fund .f-name { font-weight:700; font-size:14.5px; }
  .fund .f-body { padding:6px 15px 14px; }
  .rot-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media(max-width:680px){ .rot-grid { grid-template-columns:1fr; } }
  .rot-h { font:600 9.5px/1 var(--num); letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin:4px 0 2px; }
  .rot-h.into { color:var(--up); } .rot-h.out { color:var(--down); }
  .mini { width:100%; border-collapse:collapse; font-size:12px; }
  .mini td { padding:4px 6px; border-top:1px solid var(--line); text-align:right; white-space:nowrap; }
  .mini td.l { text-align:left; }
  .mini .tk { font:700 12px/1 var(--num); }
  .hold { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
  .hold .h-pill { font:600 10.5px/1 var(--num); padding:4px 8px; border-radius:999px; border:1px solid var(--line); background:var(--panel2); }
  .disc { background:var(--panel2); border:1px solid var(--line); border-left:3px solid var(--info); border-radius:10px;
          padding:11px 14px; margin:14px 0 4px; font-size:12px; line-height:1.55; color:var(--muted); }
{% endblock %}

{% block content %}
{#- ---- formatting helpers -------------------------------------------------- -#}
{% macro exret(v, dp=0) -%}
  {%- if v is none -%}<span class="mut">—</span>
  {%- else -%}<span class="num {{ 'r-pos' if v >= 0 else 'r-neg' }}">{{ "%+.{}f".format(dp) | format(v * 100) }}%</span>
  {%- endif -%}
{%- endmacro %}
{% macro pctf(v, dp=1) -%}{%- if v is none -%}—{%- else -%}{{ "%.{}f".format(dp) | format(v) }}%{%- endif -%}{%- endmacro %}
{% macro hit(v) -%}{%- if v is none -%}—{%- else -%}{{ "%.0f" | format(v * 100) }}%{%- endif -%}{%- endmacro %}
{% macro gradeb(g) -%}<span class="grade {{ g if g in ['A','B','C','D'] else 'na' }}">{{ g if g != 'n/a' else '—' }}</span>{%- endmacro %}
{% macro usd(v) -%}
  {%- if not v -%}—{%- elif v >= 1e9 -%}${{ "%.1f" | format(v / 1e9) }}B{%- elif v >= 1e6 -%}${{ "%.0f" | format(v / 1e6) }}M{%- else -%}${{ "%.0f" | format(v) }}{%- endif -%}
{%- endmacro %}
{% macro tradeline(tr) -%}
  {{ exret(tr.since_excess) }} <span class="sub">({{ tr.ticker }} {{ "%+.0f" | format((tr.since_abs or 0) * 100) }}% vs SPY {{ "%+.0f" | format((tr.spy_since or 0) * 100) }}%, {{ tr.hold_days }}{{ t('d','天') }})</span>
{%- endmacro %}

<div class="sm">

  <div class="sm-eyebrow">{{ t('Institutional 13F · super-investor track record', '机构 13F · 超级投资者交易记录') }}</div>
  <h1>{{ t('Smart-Money Trade Tracker', '聪明钱交易追踪器') }}</h1>
  <p class="sm-sub">{{ t(
     'Who actually made the excellent trades. Every curated super-investor\'s new / add / trim / exit is entered on its public 13F filing date and graded by return vs SPY — so skill (the rotation that worked) is separated from a rising tide.',
     '谁真正做出了卓越交易。每位精选超级投资者的新建/加仓/减仓/清仓都以其 13F 公开申报日为入场点，并以相对标普500的超额收益评分——把"奏效的轮动"（真本事）与"水涨船高"区分开。') }}</p>

  <div class="sm-meta">
    <span class="chip">{{ t('As of', '截至') }} {{ trk.as_of or '—' }}</span>
    <span class="chip">{{ t('Latest filing', '最新申报') }} {{ trk.latest_filing or '—' }}</span>
    <span class="chip">{{ t('Priced through', '价格更新至') }} {{ trk.coverage.price_thru or '—' }}</span>
    <span class="chip">{{ trk.coverage.funds }} {{ t('funds', '基金') }} · {{ trk.coverage.trades_scored }} {{ t('scored trades', '已评分交易') }}</span>
    <span class="chip">{{ t('Benchmark', '基准') }} {{ trk.benchmark }}</span>
  </div>

  {#- ============================ FEATURED ============================ -#}
  {% if trk.featured %}
  {% set w = trk.featured.winner %}{% set l = trk.featured.laggard %}
  <div class="sm-sec">
    <h2>{{ t('The quality gap', '质量差距') }}
      <span class="h-note">{{ t('two managers, two playbooks — graded on what they bought and how it has done since', '两位经理，两套打法——以"买了什么、之后表现如何"评分') }}</span></h2>
  </div>
  <div class="sm-vs">
    <div class="vs-card win">
      <div class="vs-role">★ {{ t('Rotated into the leaders', '轮动进入领涨') }}</div>
      <div class="vs-name">{{ w.name }} {{ gradeb(w.grade) }}</div>
      <div class="vs-stat">
        <div><div class="k">{{ t('Median excess', '中位超额') }}</div><div class="v">{{ exret(w.median_buy_excess) }}</div></div>
        <div><div class="k">{{ t('Buy hit-rate', '买入胜率') }}</div><div class="v">{{ hit(w.buy_hit_rate) }}</div></div>
        <div><div class="k">{{ t('63d skill', '63日技巧') }}</div><div class="v">{{ exret(w.avg_buy_excess_h) }}</div></div>
        <div><div class="k">{{ t('Realised', '已实现') }}</div><div class="v sub2">{{ exret(w.avg_buy_excess) }}</div></div>
      </div>
      {% if w.best_trade %}<div class="vs-sig">{{ t('Signature trade', '代表交易') }}: <b class="num">{{ w.best_trade.ticker }}</b> {{ w.best_trade.action }} {{ w.best_trade.period_end }} → {{ tradeline(w.best_trade) }}</div>{% endif %}
      {% if w.rotation_into %}
      <div class="rot-h into" style="margin-top:11px">{{ t('Latest rotation into', '最新轮入') }}</div>
      <ul class="vs-list">
        {% for tr in w.rotation_into %}
        <li><span class="tk">{{ tr.ticker }}</span><span class="act">{{ tr.action }} · {{ pctf(tr.pct_portfolio) }}</span><span style="margin-left:auto">{{ exret(tr.since_excess) }}</span></li>
        {% endfor %}
      </ul>{% endif %}
    </div>
    <div class="vs-mid">
      <div class="vs-lab">{{ t('Median excess gap', '中位超额差距') }}</div>
      <div class="vs-gap">{{ exret(trk.featured.excess_gap) }}</div>
      {% if trk.featured.hit_gap is not none %}<div class="vs-lab">{{ t('hit-rate', '胜率') }} {{ hit(w.buy_hit_rate) }} {{ t('vs', '对') }} {{ hit(l.buy_hit_rate) }}</div>{% endif %}
      {% if trk.featured.realised_gap is not none %}<div class="vs-lab" style="margin-top:4px">{{ t('realised P&L gap', '已实现盈亏差距') }} {{ exret(trk.featured.realised_gap) }}</div>{% endif %}
    </div>
    <div class="vs-card lag">
      <div class="vs-role">{{ t('Concentrated the laggards', '集中持有落后股') }}</div>
      <div class="vs-name">{{ l.name }} {{ gradeb(l.grade) }}</div>
      <div class="vs-stat">
        <div><div class="k">{{ t('Median excess', '中位超额') }}</div><div class="v">{{ exret(l.median_buy_excess) }}</div></div>
        <div><div class="k">{{ t('Buy hit-rate', '买入胜率') }}</div><div class="v">{{ hit(l.buy_hit_rate) }}</div></div>
        <div><div class="k">{{ t('63d skill', '63日技巧') }}</div><div class="v">{{ exret(l.avg_buy_excess_h) }}</div></div>
        <div><div class="k">{{ t('Realised', '已实现') }}</div><div class="v sub2">{{ exret(l.avg_buy_excess) }}</div></div>
      </div>
      {% if l.worst_trade %}<div class="vs-sig">{{ t('Costliest buy', '最贵买入') }}: <b class="num">{{ l.worst_trade.ticker }}</b> {{ l.worst_trade.action }} {{ l.worst_trade.period_end }} → {{ tradeline(l.worst_trade) }}</div>{% endif %}
      {% if l.rotation_into %}
      <div class="rot-h out" style="margin-top:11px">{{ t('Latest rotation into', '最新轮入') }}</div>
      <ul class="vs-list">
        {% for tr in l.rotation_into %}
        <li><span class="tk">{{ tr.ticker }}</span><span class="act">{{ tr.action }} · {{ pctf(tr.pct_portfolio) }}</span><span style="margin-left:auto">{{ exret(tr.since_excess) }}</span></li>
        {% endfor %}
      </ul>{% endif %}
    </div>
  </div>
  {% endif %}

  {#- ============================ LEADERBOARD ============================ -#}
  <div class="sm-sec">
    <h2>{{ t('Fund leaderboard', '基金排行榜') }}
      <span class="h-note">{{ t('ranked by MEDIAN trade excess vs SPY (outlier-robust); realised mean & 63-day skill shown alongside; graded A–D cross-sectionally', '按交易超额收益中位数排名（相对标普·抗异常值）；并列显示已实现均值与63日技巧；横截面 A–D 评级') }}</span></h2>
  </div>
  <table class="sm-t">
    <thead><tr>
      <th class="l">#</th><th class="l">{{ t('Fund', '基金') }}</th><th>{{ t('Grade', '评级') }}</th>
      <th>{{ t('Median excess', '中位超额') }}</th><th>{{ t('Realised mean', '已实现均值') }}</th><th>{{ t('63d skill', '63日技巧') }}</th>
      <th>{{ t('Hit', '胜率') }}</th><th>{{ t('Buys', '买入数') }}</th><th>{{ t('Priced', '可定价') }}</th>
      <th class="l">{{ t('Best buy', '最佳买入') }}</th><th class="l">{{ t('Worst buy', '最差买入') }}</th>
    </tr></thead>
    <tbody>
    {% for r in trk.leaderboard %}
      <tr class="{{ 'feat' if r.featured else '' }}">
        <td class="l rk">{{ r.rank if r.rank else '—' }}</td>
        <td class="l">{% if r.featured %}<span class="star">★</span> {% endif %}{{ r.name }}</td>
        <td>{{ gradeb(r.grade) }}</td>
        <td><b>{{ exret(r.median_buy_excess) }}</b></td>
        <td class="sub2">{{ exret(r.avg_buy_excess) }}</td>
        <td>{{ exret(r.avg_buy_excess_h) }}</td>
        <td class="num">{{ hit(r.buy_hit_rate) }}</td>
        <td class="num">{{ r.n_buys }}</td>
        <td class="num sub">{{ pctf(r.coverage_pct, 0) if r.coverage_pct is not none else '—' }}</td>
        <td class="l">{% if r.best_trade %}<span class="tk">{{ r.best_trade.ticker }}</span> {{ exret(r.best_trade.since_excess) }}{% else %}—{% endif %}</td>
        <td class="l">{% if r.worst_trade %}<span class="tk">{{ r.worst_trade.ticker }}</span> {{ exret(r.worst_trade.since_excess) }}{% else %}—{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p class="sub" style="margin-top:7px">{{ t('“Median excess” is the ranking key (one or two long-held winners cannot mint a grade). “Realised mean” is the variable-hold P&L (outlier-sensitive). “63d skill” is the filing-anchored fixed-horizon read. “Priced” = share of the fund\'s resolvable moves we could price (off-index ADRs/small-caps are dropped).', '“中位超额”为排名依据（一两笔长期持有的赢家无法虚抬评级）。“已实现均值”为可变持有期盈亏（对异常值敏感）。“63日技巧”为以申报日为锚的固定持有期口径。“可定价”=该基金可解析操作中能够定价的比例（非指数 ADR／小盘股被剔除）。') }}</p>

  {#- ============================ BEST / WORST BOARDS ============================ -#}
  <div class="sm-sec">
    <h2>{{ t('Best & worst trades', '最佳与最差交易') }}
      <span class="h-note">{{ t('biggest SPY-relative winners and losers among conviction buys (≥ 1% of book), since the filing', '在重仓买入（≥账面1%）中，相对标普最大的赢家与输家，自申报起算') }}</span></h2>
  </div>
  <div class="sm-2col">
    <div>
      <div class="rot-h into">{{ t('Best buys', '最佳买入') }}</div>
      <table class="sm-t">
        <thead><tr><th class="l">{{ t('Fund', '基金') }}</th><th class="l">{{ t('Ticker', '标的') }}</th><th>{{ t('Move', '动作') }}</th><th>{{ t('Quarter', '季度') }}</th><th>{{ t('Conv', '仓位') }}</th><th>{{ t('Excess', '超额') }}</th><th>{{ t('Hold', '持有') }}</th></tr></thead>
        <tbody>
        {% for tr in trk.best_trades %}
          <tr><td class="l">{{ tr.name }}</td><td class="l"><span class="tk">{{ tr.ticker }}</span></td>
            <td><span class="act-pill {{ tr.action }}">{{ tr.action }}</span></td><td class="num">{{ tr.period_end }}</td>
            <td class="num">{{ pctf(tr.pct_portfolio) }}</td><td>{{ exret(tr.since_excess) }}</td><td class="sub">{{ tr.hold_days }}{{ t('d','天') }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div>
      <div class="rot-h out">{{ t('Worst buys', '最差买入') }}</div>
      <table class="sm-t">
        <thead><tr><th class="l">{{ t('Fund', '基金') }}</th><th class="l">{{ t('Ticker', '标的') }}</th><th>{{ t('Move', '动作') }}</th><th>{{ t('Quarter', '季度') }}</th><th>{{ t('Conv', '仓位') }}</th><th>{{ t('Excess', '超额') }}</th><th>{{ t('Hold', '持有') }}</th></tr></thead>
        <tbody>
        {% for tr in trk.worst_trades %}
          <tr><td class="l">{{ tr.name }}</td><td class="l"><span class="tk">{{ tr.ticker }}</span></td>
            <td><span class="act-pill {{ tr.action }}">{{ tr.action }}</span></td><td class="num">{{ tr.period_end }}</td>
            <td class="num">{{ pctf(tr.pct_portfolio) }}</td><td>{{ exret(tr.since_excess) }}</td><td class="sub">{{ tr.hold_days }}{{ t('d','天') }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {#- ============================ PER-FUND ROTATION ============================ -#}
  <div class="sm-sec">
    <h2>{{ t('Per-fund rotation', '各基金轮动') }}
      <span class="h-note">{{ t('what each fund rotated into vs out of last quarter — tap to expand', '每只基金上季度的轮入与轮出——点击展开') }}</span></h2>
  </div>
  {% for r in trk.leaderboard %}
    {% set f = trk.by_fund.get(r.slug) %}
    {% if f %}
    <details class="fund" {{ 'open' if r.featured else '' }}>
      <summary>
        {% if r.featured %}<span class="star">★</span>{% endif %}
        <span class="rk num">{{ r.rank if r.rank else '—' }}</span>
        <span class="f-name">{{ f.name }}</span>
        {{ gradeb(r.grade) }}
        <span class="sub">{{ t('median', '中位') }} {{ exret(r.median_buy_excess) }} · {{ t('hit', '胜率') }} {{ hit(r.buy_hit_rate) }} · {{ r.n_buys }} {{ t('buys', '买入') }}{% if r.coverage_pct is not none %} · {{ pctf(r.coverage_pct, 0) }} {{ t('priced', '可定价') }}{% endif %}</span>
        <span class="sub" style="margin-left:auto">{{ usd(f.book_value_usd) }} · {{ f.period_end }}</span>
      </summary>
      <div class="f-body">
        <div class="rot-grid">
          <div>
            <div class="rot-h into">{{ t('Rotated into', '轮入') }} ({{ f.rotation.into | length }})</div>
            <table class="mini"><tbody>
            {% for tr in f.rotation.into %}
              <tr><td class="l"><span class="tk">{{ tr.ticker }}</span> <span class="act-pill {{ tr.action }}">{{ tr.action }}</span></td>
                  <td>{{ pctf(tr.pct_portfolio) }}</td><td>{{ exret(tr.since_excess) }}</td></tr>
            {% else %}<tr><td class="l sub">{{ t('no new buys last quarter', '上季度无新买入') }}</td></tr>{% endfor %}
            </tbody></table>
          </div>
          <div>
            <div class="rot-h out">{{ t('Rotated out of', '轮出') }} ({{ f.rotation.out | length }})</div>
            <table class="mini"><tbody>
            {% for tr in f.rotation.out %}
              <tr><td class="l"><span class="tk">{{ tr.ticker }}</span> <span class="act-pill {{ tr.action }}">{{ tr.action }}</span></td>
                  <td class="sub">{% if tr.shares_change_pct is defined and tr.shares_change_pct is not none %}{{ "%+.0f" | format(tr.shares_change_pct) }}% {{ t('sh','股') }}{% endif %}</td><td>{{ exret(tr.since_excess) }}</td></tr>
            {% else %}<tr><td class="l sub">{{ t('no sells last quarter', '上季度无卖出') }}</td></tr>{% endfor %}
            </tbody></table>
          </div>
        </div>
        {% if f.rotation.top_holdings %}
        <div class="rot-h" style="margin-top:12px">{{ t('Current top holdings', '当前主要持仓') }}</div>
        <div class="hold">
          {% for h in f.rotation.top_holdings %}
            <span class="h-pill"><b class="num">{{ h.ticker }}</b> {{ pctf(h.pct) }} <span class="act-pill {{ h.action }}">{{ h.action }}</span></span>
          {% endfor %}
        </div>{% endif %}
      </div>
    </details>
    {% endif %}
  {% endfor %}

  <div class="disc">{{ t(trk.note.en, trk.note.zh) }}</div>
  <p class="sub" style="margin-top:8px">{{ t('Generated', '生成于') }} {{ generated_utc }}</p>

</div>
{% endblock %}
