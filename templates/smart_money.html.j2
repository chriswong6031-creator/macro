{# WIRE FILTER JS                                                            #}
{# ======================================================================== #}
{% endblock %}

{% block body_scripts %}
<script>
(function(){
/* v3 wire view — the ONE owner of wire-row visibility: axis filter × stepped
   see-more expansion. Applied via INLINE style only; CSS-class visibility would
   fight the inline styles (tape-band lesson). */
var filters = document.getElementById('wire-filters');
var wireList = document.getElementById('wire-list');
var wireMoreRow = document.getElementById('wire-more-row');
var wireMoreBtn = document.getElementById('wire-more-btn');
var wireAllBtn = document.getElementById('wire-all-btn');
var wireFewerBtn = document.getElementById('wire-fewer-btn');
var wireShownN = document.getElementById('wire-shown-n');
var wireTotalN = document.getElementById('wire-total-n');
var wireHiddenN = document.getElementById('wire-hidden-n');
var WIRE_FOLD = 20;   /* newest N shown by default, per active axis */
var WIRE_STEP = 40;   /* rows revealed per "See more" click */
var wireAxis = 'all';
var wireExtra = 0; /* rows revealed beyond the first WIRE_FOLD */

function applyWireView(){
  if(!wireList) return;
  var visible = 0, matching = 0;
  var budget = WIRE_FOLD + wireExtra;
  /* rows are newest-first in the DOM; show the first `budget` that match the
     active axis, hide the rest. `visible` only climbs on shown rows, so once the
     budget is spent every later match stays folded. */
  wireList.querySelectorAll('li[data-axis]').forEach(function(li){
    var axisMatch = (wireAxis === 'all') || (li.getAttribute('data-axis') === wireAxis);
    if(axisMatch) matching++;
    var show = axisMatch && (visible < budget);
    li.style.display = show ? '' : 'none';
    if(show) visible++;
  });
  var hidden = matching - visible;
  if(wireShownN) wireShownN.textContent = String(visible);
  if(wireTotalN) wireTotalN.textContent = String(matching);
  if(wireHiddenN) wireHiddenN.textContent = String(hidden);
  if(wireMoreBtn) wireMoreBtn.style.display = hidden > 0 ? '' : 'none';
  if(wireAllBtn) wireAllBtn.style.display = hidden > 0 ? '' : 'none';
  if(wireFewerBtn) wireFewerBtn.style.display = (hidden === 0 && wireExtra > 0) ? '' : 'none';
  if(wireMoreRow) wireMoreRow.style.display = (hidden > 0 || wireExtra > 0) ? '' : 'none';
}

if(filters && wireList){
  filters.addEventListener('click', function(e){
    var pill = e.target.closest('.fpill');
    if(!pill) return;
    wireAxis = pill.getAttribute('data-axis') || 'all';
    filters.querySelectorAll('.fpill').forEach(function(p){ p.classList.remove('on'); });
    pill.classList.add('on');
    applyWireView();
  });
}
if(wireMoreBtn) wireMoreBtn.addEventListener('click', function(){ wireExtra += WIRE_STEP; applyWireView(); });
if(wireAllBtn) wireAllBtn.addEventListener('click', function(){ wireExtra = 1e9; applyWireView(); });
if(wireFewerBtn) wireFewerBtn.addEventListener('click', function(){ wireExtra = 0; applyWireView(); });
if(wireList) applyWireView();

/* smFold shared controller — all .smfold-btn buttons self-contained via onclick.
   Initiations filter pills (inside #sec-ideas details) */
var initFilters = document.getElementById('init-filters');
var initBody = document.getElementById('init-body');
if(initFilters && initBody){
  initFilters.addEventListener('click', function(e){
    var pill = e.target.closest('.fpill');
    if(!pill) return;
    var f = pill.getAttribute('data-filter');
    if(f === 'all'){
      initFilters.querySelectorAll('.fpill').forEach(function(p){ p.classList.remove('on'); });
      pill.classList.add('on');
    } else {
      pill.classList.toggle('on');
    }
    var active = [];
    initFilters.querySelectorAll('.fpill.on[data-filter]').forEach(function(p){
      var ff = p.getAttribute('data-filter');
      if(ff !== 'all') active.push(ff);
    });
    if(active.length === 0){
      var allPill = initFilters.querySelector('[data-filter="all"]');
      if(allPill) allPill.classList.add('on');
    } else {
      var allPill2 = initFilters.querySelector('[data-filter="all"]');
      if(allPill2) allPill2.classList.remove('on');
    }
    if(initBody) initBody.querySelectorAll('tr[data-turnover]').forEach(function(tr){
      if(active.length === 0){ tr.style.display = ''; return; }
      var show = true;
      active.forEach(function(fc){
        if(fc === 'lowturn' && tr.getAttribute('data-turnover') !== 'low') show = false;
        if(fc === 'newonly' && tr.getAttribute('data-action') !== 'new') show = false;
        if(fc === 'bigbook' && parseFloat(tr.getAttribute('data-pct')||'0') < 3) show = false;
      });
      tr.style.display = show ? '' : 'none';
    });
  });
}
})();
</script>
{% endblock %}
