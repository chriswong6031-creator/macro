<table class="sm-t">
  <thead><tr>
    <th class="l">{{ t('Filed','申报日') }}</th>
    <th class="l">{{ t('Ticker','标的') }}</th>
    <th class="l">{{ t('Fund(s)','基金') }}</th>
    <th>{{ t('Action','动作') }}</th>
    <th>{{ t('Rank in fund','基金内排名') }}</th>
    <th>{{ t('Tilt','权重偏差') }}</th>
    <th>{{ t('% book','仓位%') }}</th>
    <th>{{ t('# funds','基金数') }}</th>
    <th>{{ t('Turnover','换手') }}</th>
    <th>{{ t('Since filing','自申报') }}</th>
    <th>{{ t('Persisted?','是否延续') }}</th>
  </tr></thead>
  <tbody id="init-body">
  {% for row in d_init[:50] %}
    {% set funds = row.get('funds') or [] %}
    {% set first_fund = funds[0] if funds else {} %}
    {% set extra = (funds | length) - 1 %}
    {% set fund_display = first_fund.get('name', '') %}
    {% set tt3 = first_fund.get('turnover_tier') or '' %}
    {% set action3 = first_fund.get('action') or '' %}
    {% set rank3 = first_fund.get('rank') %}
    {% set tilt3 = first_fund.get('tilt') %}
    {% set pct3 = first_fund.get('pct_book') %}
    <tr data-turnover="{{ tt3 }}" data-action="{{ action3 }}" data-pct="{{ pct3 or 0 }}">
      <td class="l num mut">{{ row.filing_date or '—' }}</td>
      <td class="l"><span class="tk">{{ row.ticker }}</span></td>
      <td class="l">{{ fund_display }}{% if extra > 0 %} <span class="mut">· +{{ extra }}</span>{% endif %}</td>
      <td><span class="act-pill {{ action3 }}">{{ action3 }}</span></td>
      <td class="num">{{ ('#' ~ rank3) if rank3 else '—' }}</td>
      <td class="num">{{ ("%+.1f" | format(tilt3)) if tilt3 is not none else '—' }}</td>
      <td class="num">{{ pctf(pct3) }}</td>
      <td class="num">{{ row.n_funds_initiating or 1 }}</td>
      <td>
        {% if tt3 == 'low' %}<span class="tier low">LOW</span>
        {% elif tt3 == 'med' %}<span class="tier moderate">MED</span>
        {% elif tt3 == 'high' %}<span class="tier elevated">HIGH</span>
        {% else %}<span class="sub">—</span>{% endif %}
      </td>
      <td>{{ exret(row.get('since_excess')) }}</td>
      <td class="num mut">{{ t(row.persistence, row.persistence) if row.get('persistence') else t('pending','待确认') }}</td>
    </tr>
  {% else %}
    <tr><td colspan="11" class="l sub">{{ t('No initiations this cycle.','本周期暂无新建仓。') }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>

