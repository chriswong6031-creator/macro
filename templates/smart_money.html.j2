  </div>

  {# -- Form-4 lane (daily): top net sells -- #}
  <div class="sm-card">
    <div class="board-h">
      <span class="bt">{{ t('Top net sells','净卖出榜') }}</span>
      <span class="chip-fresh t-green"><span class="fdot"></span>{{ t('Form 4 daily · as of','Form 4 日频 · 截至') }} {{ ii_q.get('asof') or '—' }} · {{ ii_q.get('window_days') or 90 }}{{ t('d','天') }}</span>
    </div>
    <div class="board-note">{{ t('Ranked by most-negative net open-market $. Insider selling is weak evidence — much of it is planned (10b5-1) or diversification; context only.','按公开市场净卖出金额排名。内部人卖出证据较弱——多为预设计划（10b5-1）或分散化操作；仅作背景参考。') }}</div>
    {% set _tns = d_ii.get('top_net_sells') or [] %}
    {% if _tns %}
    <table class="sm-t">
      <thead><tr><th class="l">#</th><th class="l">{{ t('Ticker','标的') }}</th><th>{{ t('Net $','净额') }}</th><th>{{ t('B/S','买/卖') }}</th><th>{{ t('Buyers','买入人') }}</th><th>{{ t('Last','最新') }}</th><th>{{ t('Panel score','面板分') }}</th></tr></thead>
      <tbody>
      {% for row in _tns[:8] %}{{ ii_flow_row(row, loop.index) }}{% endfor %}
      </tbody>
    </table>
    {% if _tns | length > 8 %}
    <details class="fullboard">
      <summary>{{ t('Full board','完整榜单') }} ({{ _tns | length }})</summary>
      <table class="sm-t"><tbody>
      {% for row in _tns[8:] %}{{ ii_flow_row(row, loop.index + 8) }}{% endfor %}
      </tbody></table>
    </details>
    {% endif %}
    {% else %}<p class="sub">{{ t('Form-4 lane unavailable this build.','本次构建Form-4通道不可用。') }}</p>{% endif %}
  </div>

  {# -- SEC panel lane (~45d lag): C-suite open-market buys -- #}
  <div class="sm-card">
    <div class="board-h">
      <span class="bt">{{ t('C-suite open-market buys','高管公开市场买入') }}</span>
