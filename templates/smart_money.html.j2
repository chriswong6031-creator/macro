{# -- c) models card: one visible board via segmented control (prebuilt DOM) -- #}
{% if fl_models %}
<div class="sm-card">
  <div class="board-h">
    <span class="bt">{{ t('Models — descriptive boards','模型——描述性榜单') }}</span>
    <span class="chip-fresh t-red"><span class="fdot"></span>{{ t('13F lane · filing-date clock','13F通道 · 申报日时钟') }}</span>
  </div>
  <div class="filters" id="model-seg" style="margin:8px 0 2px">
    <span class="fpill on" data-model="most_favored">{{ t('Most favored','最受青睐') }}</span>
    <span class="fpill" data-model="conviction_buys">{{ t('Conviction buys','高信念买入') }}</span>
    <span class="fpill" data-model="asymmetric">{{ t('Uncrowded conviction','冷门高信念') }}</span>
    <span class="fpill" data-model="rotating_out">{{ t('Rotating out','轮出榜') }}</span>
  </div>
  <div class="board-note">{{ t('Descriptive rank — not a forecast. These composites earn a forward record through the pre-registered L5 ledger cohort; no performance claim is made before it matures.','描述性排名——并非预测。这些合成指标通过预登记的L5账本队列积累前瞻记录；在其成熟前不作任何表现声明。') }}</div>
  <div id="model-panels">
    {% for _mkey in ['most_favored','conviction_buys','asymmetric','rotating_out'] %}
    {% set _mb = fl_models.get(_mkey) or {} %}
    {% set _mrows = _mb.get('rows') or [] %}
    <div class="model-panel{{ ' on' if loop.first else '' }}" data-model="{{ _mkey }}">
      {% if _mb.get('method_en') %}<div class="board-note">{{ t(_mb.get('method_en'), _mb.get('method_zh') or _mb.get('method_en')) }}{% if _mb.get('asof') %} · {{ t('as of','截至') }} {{ _mb.get('asof') }}{% endif %}</div>{% endif %}
      {% if _mrows %}
      <table class="sm-t">
        {% if _mkey == 'conviction_buys' %}
        <thead><tr><th class="l">#</th><th class="l">{{ t('Ticker','标的') }}</th><th class="l">{{ t('Buyer','买家') }}</th><th>{{ t('Grade','评级') }}</th><th>{{ t('Conviction','信念分') }}</th><th>{{ t('Buyer record','买家历史') }}</th><th class="l">{{ t('Components','构成') }}</th></tr></thead>
        {% elif _mkey == 'asymmetric' %}
        <thead><tr><th class="l">#</th><th class="l">{{ t('Ticker','标的') }}</th><th>{{ t('Conviction','信念分') }}</th><th>{{ t('Holders','持有基金数') }}</th><th>{{ t('Crowding','拥挤度') }}</th><th class="l">{{ t('Components','构成') }}</th></tr></thead>
        {% elif _mkey == 'rotating_out' %}
        <thead><tr><th class="l">#</th><th class="l">{{ t('Ticker','标的') }}</th><th>{{ t('GW breadth','加权广度') }}</th><th>{{ t('Sellers','卖出基金数') }}</th><th>{{ t('Intensity','强度') }}</th><th class="l">{{ t('Components','构成') }}</th></tr></thead>
        {% else %}
        <thead><tr><th class="l">#</th><th class="l">{{ t('Ticker','标的') }}</th><th>{{ t('Composite','综合分') }}</th><th class="l">{{ t('Components','构成') }}</th></tr></thead>
        {% endif %}
        <tbody>
        {% for row in _mrows %}
          <tr>
            <td class="l rk num">{{ loop.index }}</td>
            <td class="l">{{ fl_logo(row.get('ticker') or '') }}<span class="tk">{{ row.get('ticker') or '—' }}</span> <span class="sub2">{{ (row.get('issuer') or '') | title }}</span></td>
            {% if _mkey == 'conviction_buys' %}
              {% set _cv = row.get('conviction') %}
              {% set _br = row.get('buyer_base_rate') or {} %}
              <td class="l sub">{{ row.get('fund_name') or row.get('fund') or row.get('slug') or '—' }}</td>
              <td>{{ gradeb(row.get('grade') or 'n/a') }}</td>
              <td class="num">{% if _cv is mapping %}{{ fl_comp(_cv.get('score')) }}{% if _cv.get('tier') %} <span class="mchip">{{ _cv.get('tier') }}</span>{% endif %}{% else %}{{ fl_comp(_cv) }}{% endif %}</td>
              <td class="num">{% if _br %}{{ exret(_br.get('median_excess')) }} · {{ hit(_br.get('hit_rate')) }} <span class="sub">(n {{ _br.get('n') or 0 }})</span>{% else %}—{% endif %}</td>
            {% elif _mkey == 'asymmetric' %}
              {% set _cv = row.get('conviction') %}
              <td class="num">{% if _cv is mapping %}{{ fl_comp(_cv.get('score')) }}{% if _cv.get('tier') %} <span class="mchip">{{ _cv.get('tier') }}</span>{% endif %}{% else %}{{ fl_comp(_cv) }}{% endif %}</td>
              <td class="num">{{ row.get('n_funds') if row.get('n_funds') is not none else '—' }}</td>
              {% set _ctier = row.get('crowding_tier') or 'unavail' %}
              <td><span class="tier {{ _ctier }}">{{ _ctier | upper }}</span></td>
            {% elif _mkey == 'rotating_out' %}
              <td class="num">{{ "%+.1f" | format(row.get('gw_breadth') or 0) }}</td>
              <td class="num">{{ row.get('n_selling') or 0 }}</td>
              <td class="num">{{ fl_comp(row.get('intensity')) }}</td>
            {% else %}
              <td class="num">{{ fl_comp(row.get('composite') if row.get('composite') is not none else row.get('score')) }}</td>
            {% endif %}
            <td class="l">{% for _ck, _cvv in (row.get('components') or {}).items() %}<span class="mchip">{{ _ck }} {{ fl_comp(_cvv) }}</span>{% endfor %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}<p class="sub">{{ t('Board unavailable this build.','本次构建该榜单不可用。') }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}
{% endif %}

