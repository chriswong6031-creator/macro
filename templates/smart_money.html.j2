<div class="sm-sec" id="sec-dossier">
  <h2>{{ t('Ticker dossier','个股档案') }}</h2>
  <span class="h-note">{{ t('one name, every lens — independent blocks, independent clocks, no composite','单个标的，所有视角——独立数据块，独立时间戳，无合成指标') }}</span>
</div>

<div class="sm-search">
  {# EN literal in placeholder + data-ph-zh, relabeled by JS — t() spans inside an
     attribute terminate it at the first inner quote (see options_screener.html.j2) #}
  <input type="text" id="dossier-input" placeholder="Search ticker…" data-ph-zh="搜索标的…" autocomplete="off">
  <span id="dossier-hint" class="chip-fresh" style="display:none"></span>
</div>
<div id="dossier-card">
  <div class="dossier-grid" id="dossier-grid"></div>
  <p class="sub" style="margin-top:8px">{{ t('Independent lenses, independent clocks — never blended.','独立视角，独立时间戳——切勿混合解读。') }}</p>
</div>

{# Inline ticker index for autocomplete (small subset — only tickers from gp+crowding+initiations) #}
{# Build index dicts via Jinja2 loops (no dict comprehension syntax in Jinja2) #}
{% set _idx_ns = namespace(sm={}, crowd={}) %}
{% for row in (d_gp + d_crowd + d_init) %}
  {% if row.ticker %}
    {% set _ = _idx_ns.sm.update({row.ticker: (row.issuer or row.ticker)}) %}
  {% endif %}
{% endfor %}
{% for row in d_crowd %}
  {% if row.ticker %}
    {% set _ = _idx_ns.crowd.update({row.ticker: row}) %}
  {% endif %}
{% endfor %}
<script>
(function(){
var _smIdx = {{ _idx_ns.sm | tojson }};
var _crowdIdx = {{ _idx_ns.crowd | tojson }};
var _actIdx = {};
{% for row in d_act %}
{% if row.ticker %}
if(!_actIdx["{{ row.ticker | e }}"]) _actIdx["{{ row.ticker | e }}"] = [];
_actIdx["{{ row.ticker | e }}"].push({{ row | tojson }});
{% endif %}
{% endfor %}

/* freshness axes */
var _axes = {{ (d_fresh.get('axes') or []) | tojson }};
function _axisByKey(k){ return _axes.find(function(a){return a.key===k;})||{}; }

var inp = document.getElementById('dossier-input');
var hint = document.getElementById('dossier-hint');
var card = document.getElementById('dossier-card');
var grid = document.getElementById('dossier-grid');
var _smCache = null;
var _deskCache = null;

/* lang-aware placeholder — theme.js dispatches 'langchange' on document */
var _phEn = inp ? inp.placeholder : '';
var _phZh = inp ? (inp.getAttribute('data-ph-zh') || _phEn) : '';
function _applyPhLang(){
  if(inp) inp.placeholder = document.documentElement.getAttribute('data-lang') === 'zh' ? _phZh : _phEn;
}
_applyPhLang();
document.addEventListener('langchange', _applyPhLang);

function _tierClass(tier){ return 't-'+(tier||'amber'); }
function _chip(tier,label){
  var a = _axisByKey(tier)||{};
  var tc = _tierClass(a.tier||'amber');
  return '<span class="chip-fresh '+tc+'"><span class="fdot"></span>'+label+'</span>';
}
function _exret(v){
  if(v===null||v===undefined) return '<span class="mut">—</span>';
  var pct = (v*100).toFixed(1);
  var cls = v>=0?'r-pos':'r-neg';
  return '<span class="num '+cls+'">'+(v>=0?'+':'')+pct+'%</span>';
}
function _usd(v){
  if(!v) return '—';
  if(v>=1e9) return '$'+(v/1e9).toFixed(1)+'B';
  if(v>=1e6) return '$'+(v/1e6).toFixed(0)+'M';
  return '$'+v.toFixed(0);
}

function _renderDossier(ticker){
  var issuer = _smIdx[ticker]||ticker;
  hint.style.display='inline-flex';
  hint.textContent = ticker + (issuer&&issuer!==ticker?' — '+issuer:'');
  card.style.display='block';
  grid.innerHTML='<p class="sub">Loading…</p>';

  function _build(smData, deskData){
    var bt = (smData&&smData.by_ticker&&smData.by_ticker[ticker])||{};
    var crowdRow = _crowdIdx[ticker]||null;
    var actRows = _actIdx[ticker]||[];

    /* 13F block */
    var ax13f = _axisByKey('13f');
    var holders = bt.holders||[];
    var hhi = bt.ownership_hhi;
    var series = (bt.trend&&bt.trend.holders_series)||[];
    var sfm = bt.since_filing||{};
    var vip = bt.vip||[];
    var b13f = '<div class="axisblock">';
    b13f += '<div class="ab-h"><span class="axis-tag axis-13f">13F '+t_en('ownership','ownership')+'</span>'+_chip('13f','as of '+(ax13f.asof||'?')+' · '+(ax13f.lag_note||''))+'</div>';
    b13f += '<div class="ab-body">';
    b13f += holders.length+' '+'tracked holders'+(bt.agg_value_usd?' · '+_usd(bt.agg_value_usd):'')+(hhi?' · HHI '+hhi.toFixed(3):'');
    if(sfm.ex_spy_pct!==undefined) b13f += ' · since filing '+_exret(sfm.ex_spy_pct);
    b13f += '<br>';
    vip.slice(0,3).forEach(function(h){b13f+='<span class="mut">'+h.fund_name+'</span> <span class="act-pill '+(h.action||'')+'">'+h.action+'</span> '+h.pct_portfolio.toFixed(1)+'% · ';});
    if(crowdRow){
      var _dteStr=crowdRow.days_to_exit!=null?(crowdRow.days_to_exit<0.05?'<0.1':crowdRow.days_to_exit.toFixed(1)):'—';
      b13f += '<br>Days-to-exit: '+_dteStr+' <span class="tier '+(crowdRow.crowding_tier||'low')+'">'+(crowdRow.crowding_tier||'').toUpperCase()+'</span>';
      var eb=crowdRow.entry_band||{};
      if(eb.p50) b13f += ' · entry P50 $'+eb.p50.toFixed(2)+' <span class="mut">(proxy)</span>';
      if(eb.n_underwater!=null&&eb.n) b13f += ' · '+eb.n_underwater+'/'+eb.n+' underwater';
    }
    b13f += '</div></div>';

    /* 13D/G block */
    var ax13dg = _axisByKey('13dg');
    var b13dg = '<div class="axisblock">';
    b13dg += '<div class="ab-h"><span class="axis-tag axis-13dg">13D/G</span>'+_chip('13dg',(ax13dg.asof||'?')+' · '+(ax13dg.lag_note||''))+'</div>';
    b13dg += '<div class="ab-body">';
    if(actRows.length){
      actRows.slice(0,3).forEach(function(r){
        b13dg += r.date_filed+' '+r.filer+' '+r.form+' <span class="tier '+(r.state||'other')+'">'+(r.state||'').toUpperCase()+'</span><br>';
      });
    } else {
      b13dg += 'No live activist state for this ticker.';
    }
    b13dg += '</div></div>';

    /* Insider block */
    var axins = _axisByKey('insider');
    var bins = '<div class="axisblock">';
    bins += '<div class="ab-h"><span class="axis-tag axis-form4">Insider · Form 4</span>'+_chip('insider',(axins.asof||'?'))+'</div>';
    bins += '<div class="ab-body">Data via Form 4 wire — see S1 wire filtered to Insider for this ticker.</div></div>';

    /* Short block */
    var bsh = '<div class="axisblock">';
    bsh += '<div class="ab-h"><span class="axis-tag axis-short">Short — two clocks</span>';
    if(crowdRow){
      var sv=crowdRow.short_volume||{};
      var axsv=_axisByKey('short_volume');
      bsh += _chip('short_volume','vol '+(axsv.asof||sv.asof||'?'));
    }
    bsh += '</div><div class="ab-body">';
    if(crowdRow){
      var sv2=crowdRow.short_volume||{};
      var si2=crowdRow.short_interest||{};
      bsh += 'Short-vol ratio '+(sv2.ratio!=null?(sv2.ratio*100).toFixed(1)+'%':'—');
      if(sv2.trend_pp!=null) bsh += ' · trend '+(sv2.trend_pp>=0?'+':'')+sv2.trend_pp.toFixed(1)+'pp';
      if(sv2.ratio_z!=null) bsh += ' · z '+(sv2.ratio_z>=0?'+':'')+sv2.ratio_z.toFixed(2)+' <span class="mut">(daily)</span>';
      bsh += '<br>Short interest: days-to-cover '+(si2.days_to_cover!=null?si2.days_to_cover.toFixed(1):'—');
      if(si2.si_change_pct!=null) bsh += ' · ΔSI '+(si2.si_change_pct>=0?'+':'')+si2.si_change_pct.toFixed(1)+'%';
      if(si2.settlement_date) bsh += ' <span class="mut">(settle '+si2.settlement_date+')</span>';
    } else {
      bsh += 'No short data for this ticker.';
    }
    bsh += '</div></div>';

    grid.innerHTML = b13f + b13dg + bins + bsh;
  }

  if(_smCache && _deskCache){ _build(_smCache,_deskCache); return; }
  var loaded={sm:false,desk:false};
  function tryBuild(){if(loaded.sm&&loaded.desk) _build(_smCache,_deskCache);}
  fetch('factordata/smartmoney.json').then(function(r){return r.json();}).then(function(d){_smCache=d;loaded.sm=true;tryBuild();}).catch(function(){_smCache={};loaded.sm=true;tryBuild();});
  fetch('factordata/smartmoney_desk.json').then(function(r){return r.json();}).then(function(d){_deskCache=d;loaded.desk=true;tryBuild();}).catch(function(){_deskCache={};loaded.desk=true;tryBuild();});
}

function t_en(en,zh){ return en; }

var tickers = Object.keys(_smIdx);
var _ac = null;
inp.addEventListener('input',function(){
  var v=inp.value.trim().toUpperCase();
  if(!v){card.style.display='none';hint.style.display='none';return;}
  if(tickers.indexOf(v)>=0){_renderDossier(v);return;}
  /* simple autocomplete highlight */
  var matches=tickers.filter(function(t){return t.startsWith(v);});
  if(matches.length===1){_renderDossier(matches[0]);}
});
inp.addEventListener('keydown',function(e){if(e.key==='Enter'){var v=inp.value.trim().toUpperCase();if(tickers.indexOf(v)>=0)_renderDossier(v);}});
})();
</script>

