</div>

{# Featured head-to-head compact card #}
{% if trk.featured %}
{% set w = trk.featured.winner %}{% set l = trk.featured.laggard %}
<div class="sm-vs">
  <div class="vs-card win">
    <div class="vs-role">&#9733; {{ t('Higher-quality rotation','更高质量轮动') }}</div>
    <div class="vs-name">{% if w.get('slug') %}<a class="fund-link" href="fund_{{ w.get('slug') }}.html">{{ w.name }}</a>{% else %}{{ w.name }}{% endif %} {{ gradeb(w.grade) }}</div>
    <div class="vs-stat">
      <div><div class="k">{{ t('Median excess','中位超额') }}</div><div class="v">{{ exret(w.median_buy_excess) }}</div></div>
      <div><div class="k">{{ t('Hit','胜率') }}</div><div class="v">{{ hit(w.buy_hit_rate) }}</div></div>
      <div><div class="k">{{ t('63d','63日') }}</div><div class="v">{{ exret(w.avg_buy_excess_h) }}</div></div>
    </div>
    {% if w.best_trade %}<div class="vs-sig">{{ t('Signature','代表') }}: <b class="num">{{ w.best_trade.ticker }}</b> {{ w.best_trade.action }} → {{ exret(w.best_trade.since_excess) }}</div>{% endif %}
    {% if w.rotation_into %}
    <div class="rot-h into" style="margin-top:10px">{{ t('Latest into','最新轮入') }}</div>
    <ul class="vs-list">
      {% for tr in w.rotation_into[:4] %}
      <li><span class="vtk">{{ tr.ticker }}</span><span class="vact">{{ tr.action }}</span><span style="margin-left:auto">{{ exret(tr.since_excess) }}</span></li>
      {% endfor %}
    </ul>{% endif %}
  </div>
  <div class="vs-mid">
    <div class="vs-lab">{{ t('Median excess gap','中位超额差') }}</div>
    <div class="vs-gap">{{ exret(trk.featured.excess_gap) }}</div>
    {% if trk.featured.hit_gap is not none %}<div class="vs-lab">{{ t('hit','胜率') }} {{ hit(w.buy_hit_rate) }} {{ t('vs','对') }} {{ hit(l.buy_hit_rate) }}</div>{% endif %}
  </div>
  <div class="vs-card lag">
    <div class="vs-role">{{ t('Lower-quality rotation','较低质量轮动') }}</div>
    <div class="vs-name">{% if l.get('slug') %}<a class="fund-link" href="fund_{{ l.get('slug') }}.html">{{ l.name }}</a>{% else %}{{ l.name }}{% endif %} {{ gradeb(l.grade) }}</div>
    <div class="vs-stat">
      <div><div class="k">{{ t('Median excess','中位超额') }}</div><div class="v">{{ exret(l.median_buy_excess) }}</div></div>
      <div><div class="k">{{ t('Hit','胜率') }}</div><div class="v">{{ hit(l.buy_hit_rate) }}</div></div>
      <div><div class="k">{{ t('63d','63日') }}</div><div class="v">{{ exret(l.avg_buy_excess_h) }}</div></div>
    </div>
    {% if l.worst_trade %}<div class="vs-sig">{{ t('Costliest buy','最贵买入') }}: <b class="num">{{ l.worst_trade.ticker }}</b> {{ l.worst_trade.action }} → {{ exret(l.worst_trade.since_excess) }}</div>{% endif %}
    {% if l.rotation_into %}
    <div class="rot-h out" style="margin-top:10px">{{ t('Latest into','最新轮入') }}</div>
    <ul class="vs-list">
      {% for tr in l.rotation_into[:4] %}
      <li><span class="vtk">{{ tr.ticker }}</span><span class="vact">{{ tr.action }}</span><span style="margin-left:auto">{{ exret(tr.since_excess) }}</span></li>
      {% endfor %}
    </ul>{% endif %}
  </div>
</div>
{% endif %}

<div class="banner">{{ t(
  'Grades are descriptive ranks within a curated survivor cohort — funds tracked because they are notable in 2026. They measure what filings did after their filing dates, not a manager-selection edge.',
  '评级为精选幸存者队列中的描述性排名——追踪的基金在2026年具有代表性。衡量的是申报日后的持仓表现，而非经理选择能力。'
) }}</div>

<div class="sm-card">
<table class="sm-t">
  <thead><tr>
    <th class="l">#</th>
    <th class="l">{{ t('Fund','基金') }}</th>
    <th>{{ t('Grade','评级') }}</th>
    <th>{{ t('Follow','跟随') }}</th>
    <th data-tip-en="Median excess return vs SPY after filing date" data-tip-zh="申报日后相对标普中位超额收益">{{ t('Typical edge vs market','市场典型优势') }}</th>
    <th data-tip-en="Sell timing: median excess return after sell date" data-tip-zh="卖出时机：卖出后中位超额收益">{{ t('Sell timing','卖出时机') }}</th>
    <th>{{ t('Hit','胜率') }}</th>
    <th>{{ t('Turnover','换手') }}</th>
    <th>{{ t('Hold (q)','持有(季)') }}</th>
    <th data-tip-en="Top-10 holdings as % of book" data-tip-zh="前10大持仓占账面比例">{{ t('Concentration','集中度') }}</th>
    <th>{{ t('Qtr history','分季历史') }}</th>
    <th>{{ t('Reliability','稳定性') }}</th>
    <th class="l">{{ t('Style','风格') }}</th>
  </tr></thead>
  <tbody>
  {% for r in trk.leaderboard %}
    {% set is_closed = r.get('status') == 'closed' %}
    <tr class="{{ 'feat' if r.featured else '' }}{{ ' closed' if is_closed else '' }}">
      <td class="l rk num">{{ r.rank if r.get('rank') else '—' }}</td>
      <td class="l">
        {% if r.featured %}<span class="star">&#9733;</span> {% endif %}
        <a class="fund-link" href="fund_{{ r.slug }}.html">{{ r.name }}</a>
        {% if is_closed %}<span class="chip-fresh" style="margin-left:4px">{{ t('closed','已关闭') }}</span>{% endif %}
      </td>
      <td>{{ gradeb(r.grade) }}</td>
      <td>
        {%- set _fol_slug = r.get('slug') or '' -%}
        {%- set _fol_entry = ((desk.get('follow') or {}).get('followability') or {}).get(_fol_slug) -%}
        {%- if _fol_entry is not none -%}
          {%- set _ft = _fol_entry.get('follow_tier') or 'insufficient' -%}
          {%- set _fs = _fol_entry.get('follow_score') -%}
          {%- if _ft == 'follow' -%}<span class="ftier follow" data-tip-en="FOLLOW score {{ _fs }}" data-tip-zh="跟随 分{{ _fs }}">{{ t('Follow','跟随') }}</span>
          {%- elif _ft == 'watch' -%}<span class="ftier watch" data-tip-en="WATCH score {{ _fs }}" data-tip-zh="观察 分{{ _fs }}">{{ t('Watch','观察') }}</span>
          {%- elif _ft == 'fade' -%}<span class="ftier fade" data-tip-en="FADE score {{ _fs }}" data-tip-zh="淡出 分{{ _fs }}">{{ t('Fade','淡出') }}</span>
          {%- else -%}<span class="ftier insufficient" data-tip-en="LOW DATA" data-tip-zh="数据不足">{{ t('LOW DATA','数据不足') }}</span>
          {%- endif -%}
        {%- else -%}<span class="sub">—</span>
        {%- endif -%}
      </td>
      {%- set _dc = r.get('decay') -%}
      {%- set _dc_h21 = (_dc.get('h21') if _dc else none) -%}
      {%- set _dc_h126 = (_dc.get('h126') if _dc else none) -%}
      <td data-tip-en="decay: {{ exret(_dc_h21.med) if _dc_h21 else '—' }} (21d) → {{ exret(_dc_h126.med) if _dc_h126 else '—' }} (126d)" data-tip-zh="衰减：{{ exret(_dc_h21.med) if _dc_h21 else '—' }}（21天）→ {{ exret(_dc_h126.med) if _dc_h126 else '—' }}（126天）"><b>{{ exret(r.median_buy_excess) }}</b></td>
      <td>{{ exret(r.sell_skill) }}</td>
      <td class="num">{{ hit(r.buy_hit_rate) }}</td>
      <td>
        {% set tt = r.get('turnover_tier') or '' %}
        {% if tt == 'low' %}<span class="tier low">LOW {{ pctf(r.get('turnover_pct')) }}</span>
        {% elif tt == 'med' %}<span class="tier moderate">MED {{ pctf(r.get('turnover_pct')) }}</span>
        {% elif tt == 'high' %}<span class="tier elevated">HIGH {{ pctf(r.get('turnover_pct')) }}</span>
        {% else %}<span class="sub">—</span>{% endif %}
      </td>
      <td class="num">{{ r.get('holding_period_q') if r.get('holding_period_q') is not none else '—' }}</td>
      <td class="num">{{ pctf(r.get('concentration_pct'), 0) if r.get('concentration_pct') is not none else '—' }}</td>
      <td>
        {#- v3: per-quarter median-excess sparkbar. sparkbar() assumes a
            non-negative series, so values are shifted by the series min
            (v - min) before rendering — shape only, zero line not preserved. -#}
        {% set _qv = namespace(vals=[]) %}
        {% for _q in (r.get('quarter_history') or []) %}{% if _q.get('median_excess') is not none %}{% set _qv.vals = _qv.vals + [_q.get('median_excess')] %}{% endif %}{% endfor %}
        {% if _qv.vals | length >= 2 %}
          {% set _qmin = _qv.vals | min %}
          {% set _qs = namespace(vals=[]) %}
          {% for _v in _qv.vals %}{% set _qs.vals = _qs.vals + [_v - _qmin] %}{% endfor %}
          <span class="spark" data-tip-en="median buy excess by quarter — min-shifted shape, not a zero-based scale" data-tip-zh="分季买入中位超额——按最小值平移的形态图，非零基准">{{ sparkbar(_qs.vals) }}</span>
        {% else %}<span class="sub">—</span>{% endif %}
      </td>
      <td>
        {% set _rel = r.get('reliability') or {} %}
        {% set _rtr = _rel.get('trend') %}
        {% if _rtr in ('improving','stable','deteriorating') %}
          {% set _rcls = 'up' if _rtr == 'improving' else ('down' if _rtr == 'deteriorating' else 'flat') %}
          <span class="rely {{ _rcls }}" data-tip-en="recent 4q vs all-time median excess: {{ "%+.1f" | format((_rel.get('recent4_median') or 0) * 100) }}% vs {{ "%+.1f" | format((_rel.get('alltime_median') or 0) * 100) }}% · positive-quarter share {{ "%.0f" | format((_rel.get('pos_share') or 0) * 100) }}%" data-tip-zh="最近4季对全期中位超额：{{ "%+.1f" | format((_rel.get('recent4_median') or 0) * 100) }}% vs {{ "%+.1f" | format((_rel.get('alltime_median') or 0) * 100) }}% · 正超额季占比 {{ "%.0f" | format((_rel.get('pos_share') or 0) * 100) }}%">{{ t('improving','走强') if _rtr == 'improving' else (t('deteriorating','走弱') if _rtr == 'deteriorating' else t('stable','稳定')) }}</span>
        {% else %}<span class="sub">—</span>{% endif %}
      </td>
      <td class="l sub">{{ r.get('style') or '—' }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

{# Per-fund rotation accordion — top 10 by follow score, rest folded #}
