      <td class="num">{{ _nf }}</td>
      <td class="sub num">{{ (_row.get('freshness_d') or '—') }}{{ t('d ago','天前') }}</td>
      <td>{{ exret(_row.get('since_excess_med')) }}</td>
    </tr>
  {%- endfor -%}
  </tbody>
</table>
{%- if d_best_buys | length > 20 -%}
<div class="smfold-more-row">
  <button type="button" class="smfold-btn" onclick="(function(el){el.closest('.sm-card').querySelectorAll('.bb-fold-row').forEach(function(r){r.style.display='';});el.parentNode.style.display='none';})(this)">{{ t('See more','展开更多') }} ({{ [d_best_buys | length - 20, 0] | max }})</button>
</div>
{%- endif -%}
</div>
