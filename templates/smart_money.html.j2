          {%- set _cfr = _fr.get('crowd_follow_rate') -%}
          <span class="num" data-tip-en="n {{ _fr.get('n_new_tracked') or 0 }} new positions tracked · median next-q excess {{ exret_t(_fr.get('median_next_q_excess')) }}" data-tip-zh="{{ _fr.get('n_new_tracked') or 0 }} 个新仓被追踪 · 下季中位超额 {{ exret_t(_fr.get('median_next_q_excess')) }}">{{ pctf(_cfr * 100, 0) if _cfr is not none else '—' }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        {%- if _streak > 0 -%}<span class="num" style="color:var(--down)">{{ _streak }}</span>{%- endif -%}
      </td>
    </tr>
  {%- endfor -%}
  {#- Second pass: unscored (insufficient) funds -#}
  {%- for _slug in _fns.un -%}
    {%- set _fe = d_followability[_slug] -%}
    {%- set _slv = _fe.get('sleeves') or {} -%}
    {%- set _riq = _fe.get('rotation_iq') or {} -%}
    {%- set _fr = _fe.get('front_run') or {} -%}
    {%- set _streak = _fe.get('loser_streak_q') or 0 -%}
    {%- set _fol_loop.i = _fol_loop.i + 1 -%}
    <tr>
      <td class="l rk num">{{ _fol_loop.i }}</td>
      <td class="l"><a class="fund-link" href="fund_{{ _slug }}.html">{{ _slug }}</a></td>
      <td><span class="ftier insufficient">{{ t('LOW DATA','数据不足') }}</span></td>
      <td><span class="sub">—</span></td>
      <td>
        {%- set _sn = (_slv.get('new') or {}) -%}
        {%- if _sn.get('median_excess') is not none -%}
          {{ exret(_sn.get('median_excess')) }} <span class="sub">n {{ _sn.get('n') or 0 }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        {%- set _sa = (_slv.get('add') or {}) -%}
        {%- if _sa.get('median_excess') is not none -%}
          {{ exret(_sa.get('median_excess')) }} <span class="sub">n {{ _sa.get('n') or 0 }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        {%- if _riq.get('score') is not none -%}
          <span class="num" data-tip-en="hit rate {{ hit(_riq.get('hit_rate')) }} · n {{ _riq.get('n_calls') or 0 }} calls across {{ _riq.get('n_quarters') or 0 }} quarters" data-tip-zh="方向胜率 {{ hit(_riq.get('hit_rate')) }} · {{ _riq.get('n_calls') or 0 }} 次调仓 / {{ _riq.get('n_quarters') or 0 }} 个季度">{{ _riq.get('score') }}</span>
        {%- elif _riq.get('n_calls') -%}
          <span class="sub" data-tip-en="hit rate {{ hit(_riq.get('hit_rate')) }} · n {{ _riq.get('n_calls') or 0 }} calls — insufficient for score" data-tip-zh="方向胜率 {{ hit(_riq.get('hit_rate')) }} · {{ _riq.get('n_calls') or 0 }} 次调仓 — 样本不足">n {{ _riq.get('n_calls') }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td><span class="sub">—</span></td>
      <td>
        {%- if _streak > 0 -%}<span class="num" style="color:var(--down)">{{ _streak }}</span>{%- endif -%}
      </td>
    </tr>
  {%- endfor -%}
  </tbody>
</table>
</div>

