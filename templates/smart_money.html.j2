{% extends "report_base.html.j2" %}
{% block title %}{{ t('Ownership Intelligence Desk — 13F Smart-Money Context', '持仓情报台 — 13F 聪明钱背景参考') }}{% endblock %}

{% block base_css %}
/* ---- core tokens ---- */
.sm { --numf:"SF Mono",ui-monospace,"DejaVu Sans Mono",monospace; max-width:1220px; margin:0 auto; }
.sm .num { font-family:var(--numf); font-variant-numeric:tabular-nums; }
.grade { display:inline-flex; align-items:center; justify-content:center; min-width:22px; height:22px;
         padding:0 5px; border-radius:6px; font:700 12px/1 var(--numf); border:1px solid var(--line); }
.grade.A { color:#1f9a55; border-color:#1f9a5566; background:#1f9a5514; }
.grade.B { color:#3b82f6; border-color:#3b82f666; background:#3b82f614; }
.grade.C { color:#c98a1a; border-color:#c98a1a66; background:#c98a1a14; }
.grade.D { color:#d23f3f; border-color:#d23f3f66; background:#d23f3f14; }
.grade.na { color:var(--muted); }
html[data-theme="dark"] .grade.A { color:#3fc07e; }
html[data-theme="dark"] .grade.C { color:#e0a93a; }
html[data-theme="dark"] .grade.D { color:#ef6a6a; }

/* ---- axis tags ---- */
.axis-tag { font:600 9px/1 var(--numf); letter-spacing:.08em; text-transform:uppercase;
            padding:3px 6px; border-radius:5px; border:1px solid var(--line); color:var(--muted); }
.axis-13f  { color:#c9a24a; border-color:#c9a24a55; }
.axis-13fa { color:#c9a24a; border-color:#c9a24a55; }
.axis-13dg { color:#5b9bf0; border-color:#5b9bf055; }
.axis-form4 { color:#45b873; border-color:#45b87355; }
.axis-short { color:#b07fd8; border-color:#b07fd855; }

/* ---- freshness chips ---- */
.chip-fresh { display:inline-flex; align-items:center; gap:5px; padding:2px 9px;
              border-radius:100px; font:600 10.5px/1.6 var(--numf); letter-spacing:.03em;
              white-space:nowrap; border:1px solid var(--line); color:var(--muted); background:var(--panel2); }
.chip-fresh .fdot { width:7px; height:7px; border-radius:50%; display:inline-block; }
.t-green { color:var(--up); } .t-green .fdot { background:var(--up); }
.t-amber { color:#e0a030; } .t-amber .fdot { background:#e0a030; }
.t-red { color:var(--down); } .t-red .fdot { background:var(--down); }

/* ---- tier pills ---- */
.tier { font:600 10px/1 var(--numf); padding:3px 7px; border-radius:5px;
        letter-spacing:.05em; text-transform:uppercase; }
.tier.elevated { color:var(--down); background:rgba(224,100,100,.12); border:1px solid rgba(224,100,100,.35); }
.tier.moderate { color:#e0a030; background:rgba(224,160,48,.1); border:1px solid rgba(224,160,48,.3); }
.tier.low { color:var(--muted); background:var(--panel2); border:1px solid var(--line); }
.tier.unavail { color:var(--muted); background:transparent; border:1px dashed var(--line); }
.tier.activist { color:#5b9bf0; background:rgba(91,155,240,.1); border:1px solid rgba(91,155,240,.35); }
.tier.flip { color:#5b9bf0; background:rgba(91,155,240,.1); border:1px solid rgba(91,155,240,.35); }
.tier.custodial { color:var(--muted); background:var(--panel2); border:1px solid var(--line); }

/* ---- turnover tier ---- */
.tlow { color:var(--muted); background:var(--panel2); border:1px solid var(--line); }
.tmed { color:#e0a030; background:rgba(224,160,48,.1); border:1px solid rgba(224,160,48,.3); }
.thigh { color:var(--down); background:rgba(224,100,100,.12); border:1px solid rgba(224,100,100,.35); }

/* ---- S0 command deck ---- */
.sm-deck { background:var(--panel); border:1px solid var(--line); border-radius:16px;
           padding:20px 22px; display:grid; grid-template-columns:1.2fr 1fr 1.4fr; gap:22px;
           margin-bottom:10px; }
@media(max-width:960px){ .sm-deck { grid-template-columns:1fr; } }
.sm-deck .deck-eyebrow { font:600 11px/1 var(--numf); letter-spacing:.14em;
                          text-transform:uppercase; color:var(--muted); }
.sm-deck h1 { font-size:clamp(22px,3vw,30px); margin:.25em 0 .1em; letter-spacing:-.01em; }
.sm-deck .deck-sub { color:var(--muted); font-size:12.5px; max-width:420px; }
.sm-clock { border-left:1px solid var(--line); border-right:1px solid var(--line);
            padding:0 22px; display:flex; flex-direction:column; justify-content:center; gap:4px; }
@media(max-width:960px){ .sm-clock { border:0; border-top:1px solid var(--line);
                                     border-bottom:1px solid var(--line); padding:14px 0; } }
.sm-clock .ck { font:600 9.5px/1 var(--numf); letter-spacing:.1em;
                text-transform:uppercase; color:var(--muted); }
.sm-clock .bignum { font:700 30px/1 var(--numf); }
.sm-clock .bignum span { font-size:14px; color:var(--muted); font-weight:600; }
.sm-clock .qstate { font:600 11px/1.5 var(--numf); color:#e0a030; }
.sm-gridbox .gbk { font:600 9.5px/1 var(--numf); letter-spacing:.1em;
                    text-transform:uppercase; color:var(--muted); margin-bottom:7px;
                    display:flex; justify-content:space-between; }
.dots-grid { display:grid; grid-template-columns:repeat(18,14px); gap:5px; }
.dots-grid i { width:10px; height:10px; border-radius:50%; border:1.5px solid var(--muted);
               display:block; }
.dots-grid i.df { background:var(--up); border-color:var(--up); }
.dots-grid i.dp { border-color:#e0a030; }
.axis-rail { display:flex; flex-wrap:wrap; gap:7px; margin-top:12px; }
.hon-note { margin-top:12px; font-size:11px; color:var(--muted);
            border-top:1px solid var(--line); padding-top:10px; }

/* ---- section headers ---- */
.sm-sec { margin:34px 0 10px; display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
.sm-sec::after { content:''; flex:1; height:1px; background:var(--line); align-self:center; }
.sm-sec h2 { font-size:17px; margin:0; }
.sm-sec .h-note { font-size:12px; color:var(--muted); font-weight:400; }

/* ---- cards / banners ---- */
.sm-card { background:var(--panel); border:1px solid var(--line); border-radius:12px;
           padding:14px 16px; margin-top:10px; overflow-x:auto; }
.banner { font-size:11.5px; color:var(--muted); background:var(--panel2); border:1px solid var(--line);
          border-left:3px solid var(--info); border-radius:9px; padding:8px 12px; margin:8px 0 4px;
          line-height:1.55; }
.banner.hazard { border-left-color:var(--down); }

/* ---- wire ---- */
.wire { list-style:none; margin:0; padding:0; }
.wire li { display:flex; align-items:center; gap:10px; padding:7px 2px;
           border-top:1px solid var(--line); font-size:12.3px; flex-wrap:wrap; }
.wire .wd { font:600 11px/1 var(--numf); color:var(--muted); min-width:74px; }
.wire .wtk { font:700 12.3px/1 var(--numf); min-width:52px; }
.wire .wdesc { color:var(--text); }
.wire .wasof { margin-left:auto; }
.filters { display:flex; gap:6px; flex-wrap:wrap; margin:6px 0 4px; }
.filters .fpill { font:600 11px/1.8 var(--numf); padding:2px 11px; border-radius:99px;
                  border:1px solid var(--line); color:var(--muted); cursor:pointer; user-select:none; }
.filters .fpill.on { color:var(--text); border-color:var(--info); background:rgba(91,155,240,.08); }
.wire-count { font-size:11.5px; color:var(--muted); margin:6px 0 2px; }

/* ---- act pills ---- */
.act-pill { font:600 9px/1 var(--numf); padding:3px 6px; border-radius:5px; border:1px solid var(--line);
            color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
.act-pill.new,.act-pill.add { color:var(--up); border-color:rgba(69,184,115,.4); }
.act-pill.trim,.act-pill.exit { color:var(--down); border-color:rgba(224,100,100,.4); }

/* ---- tables ---- */
table.sm-t { width:100%; border-collapse:collapse; font-size:12.3px; margin-top:6px; }
table.sm-t th { text-align:right; font:600 9.5px/1.25 var(--numf); letter-spacing:.05em;
                text-transform:uppercase; color:var(--muted); padding:6px 8px 7px;
                border-bottom:1px solid var(--line); white-space:nowrap; }
table.sm-t th.l, table.sm-t td.l { text-align:left; }
table.sm-t td { padding:6px 8px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
table.sm-t tbody tr:hover { background:var(--panel2); }
table.sm-t td .tk { font:700 12.3px/1 var(--numf); }
table.sm-t tr.feat td { background:color-mix(in srgb, var(--up) 6%, transparent); }
table.sm-t tr.closed td { opacity:.55; }
table.sm-t .rk { color:var(--muted); font-family:var(--numf); }
.sub { font-size:10.5px; color:var(--muted); }
.sub2 { opacity:.72; font-weight:500; }
.star { color:#e0a030; }
.spark { font-family:var(--numf); font-size:11px; letter-spacing:1px; color:var(--info); }

/* ---- vs card ---- */
.sm-vs { display:grid; grid-template-columns:1fr auto 1fr; gap:0; align-items:stretch; margin-top:10px; }
@media(max-width:760px){ .sm-vs { grid-template-columns:1fr; } .vs-mid { flex-direction:row; padding:10px 0; } }
.vs-card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:14px 16px; }
.vs-card.win { border-left:4px solid var(--up); }
.vs-card.lag { border-left:4px solid var(--down); }
.vs-mid { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; padding:0 14px; }
.vs-mid .vs-gap { font:700 22px/1 var(--numf); }
.vs-mid .vs-lab { font:600 9px/1.2 var(--numf); letter-spacing:.1em; text-transform:uppercase;
                  color:var(--muted); text-align:center; }
.vs-role { font:600 10px/1 var(--numf); letter-spacing:.12em; text-transform:uppercase; }
.vs-card.win .vs-role { color:var(--up); } .vs-card.lag .vs-role { color:var(--down); }
.vs-name { font-size:17px; font-weight:700; margin:5px 0 2px; }
.vs-stat { display:flex; gap:14px; flex-wrap:wrap; margin:10px 0 6px; }
.vs-stat .k { font:600 9px/1.2 var(--numf); letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
.vs-stat .v { font:650 17px/1.1 var(--numf); margin-top:3px; }
.vs-list { margin:8px 0 0; padding:0; list-style:none; }
.vs-list li { display:flex; align-items:baseline; gap:8px; padding:4px 0;
              border-top:1px solid var(--line); font-size:12px; }
.vs-list li .vtk { font:700 12px/1 var(--numf); min-width:44px; }
.vs-list li .vact { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
.vs-sig { font-size:11.5px; color:var(--muted); margin-top:8px; }

/* ---- per-fund accordion ---- */
details.fund { background:var(--panel); border:1px solid var(--line); border-radius:11px; margin-top:9px; }
details.fund > summary { list-style:none; cursor:pointer; padding:11px 15px;
                         display:flex; align-items:center; gap:11px; flex-wrap:wrap; font-size:13px; }
details.fund > summary::-webkit-details-marker { display:none; }
details.fund[open] > summary { border-bottom:1px solid var(--line); }
.fund .f-name { font-weight:700; font-size:14px; }
.fund .f-body { padding:6px 15px 14px; }
.rot-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
@media(max-width:680px){ .rot-grid { grid-template-columns:1fr; } }
.rot-h { font:600 9.5px/1 var(--numf); letter-spacing:.1em; text-transform:uppercase;
         color:var(--muted); margin:4px 0 2px; }
.rot-h.into { color:var(--up); } .rot-h.out { color:var(--down); }
.mini { width:100%; border-collapse:collapse; font-size:12px; }
.mini td { padding:4px 6px; border-top:1px solid var(--line); text-align:right; white-space:nowrap; }
.mini td.l { text-align:left; }
.mini .tk { font:700 12px/1 var(--numf); }
.hold { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
.hold .h-pill { font:600 10.5px/1 var(--numf); padding:4px 8px; border-radius:999px;
               border:1px solid var(--line); background:var(--panel2); }

/* ---- S7 dossier ---- */
.sm-search { display:flex; gap:8px; margin:8px 0; align-items:center; flex-wrap:wrap; }
.sm-search input { flex:1; max-width:340px; background:var(--panel2); border:1px solid var(--line);
                   border-radius:9px; color:var(--text); font:600 13px var(--numf);
                   padding:8px 13px; outline:none; }
.sm-search input:focus { border-color:var(--info); }
.dossier-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:10px; }
@media(max-width:820px){ .dossier-grid { grid-template-columns:1fr; } }
.axisblock { border:1px solid var(--line); border-radius:10px; padding:11px 13px; background:var(--panel2); }
.axisblock .ab-h { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }
.axisblock .ab-body { font-size:12.3px; line-height:1.6; }
#dossier-card { display:none; }

/* ---- S8 ledger ---- */
.ledgrid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:10px; }
@media(max-width:960px){ .ledgrid { grid-template-columns:1fr 1fr; } }
@media(max-width:600px){ .ledgrid { grid-template-columns:1fr; } }
.led { background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:12px 14px; }
.led .led-nm { font-weight:700; font-size:12.5px; margin-bottom:3px; }
.led .led-rule { font-size:10.5px; color:var(--muted); min-height:36px; margin-bottom:6px; }
.led .led-row { display:flex; justify-content:space-between; font:600 11px/1.9 var(--numf); }
.led .led-row .lk { color:var(--muted); font-weight:500; }

/* ---- misc ---- */
.disc { background:var(--panel2); border:1px solid var(--line); border-left:3px solid var(--info);
        border-radius:10px; padding:11px 14px; margin:14px 0 4px; font-size:12px;
        line-height:1.55; color:var(--muted); }
.sm-2col { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
@media(max-width:820px){ .sm-2col { grid-template-columns:1fr; } }
{% endblock %}

{% block content %}
{#- ===== MACRO HELPERS ===== -#}
{% macro exret(v, dp=0) -%}
  {%- if v is none -%}<span class="mut">—</span>
  {%- else -%}<span class="num {{ 'r-pos' if v >= 0 else 'r-neg' }}">{{ "%+.{}f".format(dp) | format(v * 100) }}%</span>
  {%- endif -%}
{%- endmacro %}
{% macro pctf(v, dp=1) -%}{%- if v is none -%}—{%- else -%}{{ "%.{}f".format(dp) | format(v) }}%{%- endif -%}{%- endmacro %}
{% macro hit(v) -%}{%- if v is none -%}—{%- else -%}{{ "%.0f" | format(v * 100) }}%{%- endif -%}{%- endmacro %}
{% macro gradeb(g) -%}<span class="grade {{ g if g in ['A','B','C','D'] else 'na' }}">{{ g if g != 'n/a' else '—' }}</span>{%- endmacro %}
{% macro usd(v) -%}
  {%- if not v -%}—{%- elif v >= 1e9 -%}${{ "%.1f" | format(v / 1e9) }}B{%- elif v >= 1e6 -%}${{ "%.0f" | format(v / 1e6) }}M{%- else -%}${{ "%.0f" | format(v) }}{%- endif -%}
{%- endmacro %}
{% macro tradeline(tr) -%}
  {{ exret(tr.since_excess) }} <span class="sub">({{ tr.ticker }} {{ "%+.0f" | format((tr.since_abs or 0) * 100) }}% vs SPY {{ "%+.0f" | format((tr.spy_since or 0) * 100) }}%, {{ tr.hold_days }}{{ t('d','天') }})</span>
{%- endmacro %}
{% macro sparkbar(series) -%}
{%- set chars = ['▁','▂','▃','▄','▅','▆','▇','█'] -%}
{%- if series and series | length > 0 -%}
{%- set maxv = series | max -%}
{%- set out = namespace(s='') -%}
{%- for v in series[-6:] -%}
  {%- if maxv and maxv > 0 -%}
    {%- set idx = ((v / maxv) * 7) | int -%}
    {%- set out.s = out.s ~ chars[idx if idx < 8 else 7] -%}
  {%- else -%}
    {%- set out.s = out.s ~ '▁' -%}
  {%- endif -%}
{%- endfor -%}
{{ out.s }}
{%- else -%}—{%- endif -%}
{%- endmacro %}

{#- ===== set desk shorthand ===== -#}
{% set d_fresh = desk.get('freshness') or {} %}
{% set d_wire = desk.get('wire') or [] %}
{% set d_wire_show = desk.get('wire_display') or d_wire[:60] %}
{% set d_gp = desk.get('grand_portfolio') or [] %}
{% set d_crowd = desk.get('crowding') or [] %}
{% set d_init = desk.get('initiations') or [] %}
{% set d_act = desk.get('activists') or [] %}
{% set d_led = desk.get('ledger') or {} %}

<div class="sm">

{# ======================================================================== #}
{# S0 COMMAND DECK                                                           #}
{# ======================================================================== #}
<div class="sm-deck">

  {# Left: title + eyebrow + axis rail #}
  <div>
    <div class="deck-eyebrow">{{ t('Institutional 13F · Context Only · Never a Buy List', '机构 13F · 仅供背景参考 · 非买入清单') }}</div>
    <h1>{{ t('Ownership Intelligence Desk', '持仓情报台') }}</h1>
    <div class="deck-sub">{{ t('Who owns what, who just moved, and how stale each lens is. Five independent axes — read separately, never blended.', '谁持有什么、谁刚刚移仓，以及每个数据源的时效。五条独立视角——分开解读，切勿混合。') }}</div>
    <div class="axis-rail">
      {% for ax in d_fresh.get('axes') or [] %}
        {% set tc = 't-' ~ (ax.tier or 'amber') %}
        <span class="chip-fresh {{ tc }}"><span class="fdot"></span>{{ ax.label }} · {{ t('as of','截至') }} {{ ax.asof }} — {{ ax.lag_note }}</span>
      {% endfor %}
    </div>
  </div>

  {# Centre: filing clock #}
  <div class="sm-clock">
    <div class="ck">{{ t('Next 13F deadline · Q2 2026','下一13F截止日 · 2026年Q2') }}</div>
    <div class="bignum">{{ d_fresh.get('days_to_deadline') or '—' }} <span>{{ t('days','天') }} · {{ d_fresh.get('next_deadline') or '—' }}</span></div>
    {% set qs = d_fresh.get('quarter_state') or '' %}
    {% if qs == 'window_open' %}
      {% set filed_ct = (d_fresh.get('filed_pending') or []) | selectattr('status','equalto','filed') | list | length %}
      {% set total_ct = (d_fresh.get('filed_pending') or []) | rejectattr('status','equalto','closed') | list | length %}
      <div class="qstate">{{ t('FILING WINDOW OPEN','申报窗口已开启') }} — {{ filed_ct }}/{{ total_ct }} {{ t('funds filed','家基金已申报') }}</div>
    {% elif qs == 'closed' %}
      <div class="qstate" style="color:var(--muted)">{{ t('WINDOW CLOSED','窗口已关闭') }}</div>
    {% else %}
      <div class="qstate" style="color:var(--muted)">{{ qs }}</div>
    {% endif %}
    <div class="ck" style="margin-top:6px">{{ t('Quarter on display: Q1 2026 (period end Mar 31)','展示季度：2026年Q1（期末3月31日）') }}</div>
  </div>

  {# Right: dot grid #}
  <div class="sm-gridbox">
    <div class="gbk">
      <span>{{ t('Filed vs pending — Q2 2026 window','已申报 vs 待申报 — 2026年Q2窗口') }}</span>
      <span>&#9679; {{ t('filed','已申报') }} · &#9675; {{ t('pending','待申报') }}</span>
    </div>
    <div class="dots-grid">
      {% for fp in d_fresh.get('filed_pending') or [] %}
        {% if fp.get('status') == 'filed' %}
          <i class="df" title="{{ fp.slug }} — filed {{ fp.filing_date }}"></i>
        {% elif fp.get('status') == 'closed' %}
          <i style="opacity:.3" title="{{ fp.slug }} — closed"></i>
        {% else %}
          <i class="dp" title="{{ fp.slug }} — pending"></i>
        {% endif %}
      {% endfor %}
    </div>
    <div class="hon-note">{{ t(
      '13F = quarterly, ~45-day lag, long-only US listed ≥$100M. No shorts, no cash, no non-US positions. This desk is context — ownership is never a directional signal here.',
      '13F = 季度披露，约45天滞后，仅含美股多头且持仓≥1亿美元。不含空头、现金或非美股仓位。本台仅为背景参考——持仓数据在此永远不是方向性信号。'
    ) }}</div>
  </div>

</div>{# /sm-deck #}

{# ======================================================================== #}
{# S1 OWNERSHIP EVENT WIRE                                                   #}
{# ======================================================================== #}
<div class="sm-sec">
  <h2>{{ t('Ownership event wire','持仓事件播报') }}</h2>
  <span class="h-note">{{ t('newest events per axis (of ' ~ (d_wire | length) ~ ' in the feed) — each row carries its own clock', '各轴最新事件（数据流共' ~ (d_wire | length) ~ '条）——每行带独立时间戳') }}</span>
</div>

<div class="filters" id="wire-filters">
  <span class="fpill on" data-axis="all">{{ t('All','全部') }}</span>
  <span class="fpill" data-axis="13f">{{ t('13F','13F') }}</span>
  <span class="fpill" data-axis="13fa">{{ t('Amendments','修正案') }}</span>
  <span class="fpill" data-axis="13dg">{{ t('13D/G','13D/G') }}</span>
  <span class="fpill" data-axis="insider">{{ t('Insider','内部人') }}</span>
</div>

<div class="sm-card">
  <p class="wire-count">{{ t('Showing ' ~ (d_wire_show | length) ~ ' of ' ~ (d_wire | length) ~ ' (balanced per axis) — full feed in the data file','展示' ~ (d_wire_show | length) ~ '条，共' ~ (d_wire | length) ~ '条（按轴均衡）——完整记录见数据文件') }}</p>
  <ul class="wire" id="wire-list">
  {% for row in d_wire_show %}
    {% set ax_raw = row.get('axis') or '' %}
    {% set is_amend = row.get('type') == '13f_amendment' %}
    {% set ax = 'insider' if ax_raw[:5] == 'form4' else ('13fa' if is_amend else ax_raw) %}
    {% set axis_class = 'axis-form4' if ax == 'insider' else ('axis-13f' if ax == '13fa' else 'axis-' ~ ax) %}
    {% if ax == '13f' %}{% set axis_label = '13F' %}
    {% elif ax == '13fa' %}{% set axis_label = '13F/A' %}
    {% elif ax == '13dg' %}{% set axis_label = row.get('type') or '13D/G' %}
    {% elif ax == 'insider' %}{% set axis_label = 'FORM4' %}
    {% elif ax == 'short' %}{% set axis_label = 'SHORT' %}
    {% else %}{% set axis_label = ax | upper %}{% endif %}

    {# Build description from action + magnitude + fund #}
    {% set action = row.get('action') or '' %}
    {% set fund = row.get('fund') or row.get('slug') or '' %}
    {% set mag = row.get('magnitude') %}
    {% set unit = row.get('unit') or '' %}
    {% if action == '13d' %}{% set desc_en = fund ~ ' files 13D' ~ ((' — ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action == '13g' %}{% set desc_en = fund ~ ' files 13G' ~ ((' — ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action == 'amendment' %}{% set desc_en = fund ~ ' files amendment' ~ ((' — ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action == 'flip' %}{% set desc_en = fund ~ ' converts 13G → 13D (passive → active)' %}
    {% elif action in ('new','add') %}{% set desc_en = fund ~ ' ' ~ action ~ ((' ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action in ('trim','exit') %}{% set desc_en = fund ~ ' ' ~ action ~ ((' ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif ax == 'insider' %}
      {% set nb = row.get('n_buys') or 0 %}{% set ns = row.get('n_sells') or 0 %}
      {% set net = row.get('net_usd') or 0 %}
      {% set net_mn = (net / 1000000) | round(1) %}
      {% set desc_en = 'insider cluster — ' ~ nb ~ ' buy' ~ ('s' if nb != 1 else '') ~ ', ' ~ ns ~ ' sell' ~ ('s' if ns != 1 else '') ~ ', net ' ~ ('+' if net >= 0 else '−') ~ '$' ~ (net_mn | abs) ~ 'M' %}
    {% else %}{% set desc_en = fund ~ ' ' ~ action %}{% endif %}

    {% set asof_note = row.get('asof_note') or '' %}
    {% set ax_tier = 'green' if ax in ('13dg','insider','short') else ('amber' if ax == '13fa' else ('amber' if ax == 'short_interest' else 'red')) %}

    <li data-axis="{{ ax }}">
      <span class="wd num">{{ row.get('date') or '' }}</span>
      <span class="axis-tag {{ axis_class }}">{{ axis_label }}</span>
      <span class="wtk num">{{ row.get('ticker') or '' }}</span>
      <span class="wdesc">{{ desc_en | e }}</span>
      <span class="chip-fresh t-{{ ax_tier }} wasof"><span class="fdot"></span>{{ asof_note | e }}</span>
    </li>
  {% else %}
    <li><span class="sub">{{ t('No wire events available.','暂无播报事件。') }}</span></li>
  {% endfor %}
  </ul>
</div>

