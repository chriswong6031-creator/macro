          <span class="mut">{{ t('accruing','积累中') }}</span>
        {% endif %}
      </span>
    </div>
    {% endfor %}
    <div class="led-row">
      <span class="lk">{{ t('status','状态') }}</span>
      <span class="mut">{{ lrec.get('status') or '—' }}</span>
    </div>
  </div>
{% else %}
  <div class="led"><div class="led-nm">{{ t('No ledger data','暂无账本数据') }}</div></div>
{% endfor %}
</div>

