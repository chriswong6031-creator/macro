{#- v3 macros — defined OUTSIDE the section guard (see S1.5 note). -#}
{% macro flow_row(row, i) %}
    {% set _nb = row.get('n_buying') or 0 %}
    {% set _ns = row.get('n_selling') or 0 %}
    {% set _tot = _nb + _ns %}
    <tr>
      <td class="l rk num">{{ i }}</td>
      <td class="l">{{ fl_logo(row.get('ticker') or '') }}<span class="tk">{{ row.get('ticker') or '—' }}</span> <span class="sub2">{{ (row.get('issuer') or '') | title }}</span></td>
      <td><span class="bbar" data-tip-en="{{ _nb }} buying · {{ _ns }} selling" data-tip-zh="{{ _nb }} 买入 · {{ _ns }} 卖出">{% if _tot > 0 %}<i class="bi" style="width:{{ ((_nb / _tot) * 100) | round(1) }}%"></i><i class="bo" style="width:{{ ((_ns / _tot) * 100) | round(1) }}%"></i>{% endif %}</span> <span class="num sub">{{ _nb }}/{{ _ns }}</span></td>
      <td class="num">{{ "%+.1f" | format(row.get('gw_breadth') or 0) }}</td>
      <td class="num">{{ "%+d" | format(row.get('d_funds_qoq') or 0) }}</td>
      <td class="num">{{ fl_usdn(row.get('est_flow_usd')) }}</td>
      <td class="l">
        {% set _bf = row.get('buy_funds') or [] %}
        {% set _sf = row.get('sell_funds') or [] %}
        <details class="fl">
          <summary>{{ _bf | length }} {{ t('in','入') }} / {{ _sf | length }} {{ t('out','出') }}</summary>
          <div class="fl-body">
            {% for _f in _bf %}<span class="mchip">{% if _f.get('slug') %}<a class="fund-link" href="fund_{{ _f.get('slug') }}.html">{{ _f.get('name') or _f.get('slug') }}</a>{% else %}{{ _f.get('name') or '—' }}{% endif %} · {{ _f.get('grade') or '—' }} · {{ _f.get('action') or '' }} {{ pctf(_f.get('pct_book')) }}</span>{% endfor %}
            {% for _f in _sf %}<span class="mchip">{% if _f.get('slug') %}<a class="fund-link" href="fund_{{ _f.get('slug') }}.html">{{ _f.get('name') or _f.get('slug') }}</a>{% else %}{{ _f.get('name') or '—' }}{% endif %} · {{ _f.get('grade') or '—' }} · {{ _f.get('action') or '' }}</span>{% endfor %}
          </div>
        </details>
      </td>
    </tr>
{% endmacro %}
{% macro rot_bars(groups) %}
  {% if groups %}
  {% set _mx = namespace(v=0.0) %}
  {% for _g in groups %}{% set _a = (_g.get('net_pp') or 0) | abs %}{% if _a > _mx.v %}{% set _mx.v = _a %}{% endif %}{% endfor %}
  <ul class="rotbars">
  {% for _g in groups %}
    {% set _npp = _g.get('net_pp') or 0 %}
    {% set _w = (((_npp | abs) / _mx.v) * 50) | round(1) if _mx.v > 0 else 0 %}
    <li data-tip-en="into: {{ (_g.get('top_names_in') or []) | map(attribute='ticker') | join(', ') or '—' }} · out of: {{ (_g.get('top_names_out') or []) | map(attribute='ticker') | join(', ') or '—' }}" data-tip-zh="轮入：{{ (_g.get('top_names_in') or []) | map(attribute='ticker') | join(', ') or '—' }} · 轮出：{{ (_g.get('top_names_out') or []) | map(attribute='ticker') | join(', ') or '—' }}">
      <span class="rb-lab">{{ t(_g.get('label') or _g.get('key') or '—', _g.get('label_zh') or _g.get('label') or _g.get('key') or '—') }}</span>
      <span class="rb-track"><i class="rb-fill {{ 'pos' if _npp >= 0 else 'neg' }}" style="width:{{ _w }}%"></i></span>
      <span class="rb-val num {{ 'r-pos' if _npp >= 0 else 'r-neg' }}">{{ "%+.1f" | format(_npp) }}pp</span>
      <span class="sub num">{{ _g.get('n_funds_in') or 0 }}/{{ _g.get('n_funds_out') or 0 }}</span>
    </li>
  {% endfor %}
  </ul>
  {% else %}<p class="sub">{{ t('Unavailable this build.','本次构建不可用。') }}</p>{% endif %}
{% endmacro %}
