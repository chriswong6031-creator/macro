{# S1.5 INSIDER INTELLIGENCE (v3)                                            #}
{# ======================================================================== #}
{#- v3 macros — defined OUTSIDE the section guard so a missing data key never
    leaves a macro undefined. Logos per F10: yes here, never on wire rows. -#}
{%- macro ii_logo(tk) -%}
<img class="tlogo" src="https://cdn.jsdelivr.net/gh/nvstly/icons@main/ticker_icons/{{ tk }}.png" loading="eager" onerror="this.style.display='none'" alt="">
{%- endmacro -%}
{%- macro ii_usdn(v) -%}
  {%- if v is none -%}—{%- else -%}
    {%- set a = v | abs -%}
    {{- '−' if v < 0 else '+' -}}
    {%- if a >= 1000000000 -%}${{ "%.1f" | format(a / 1000000000) }}B
    {%- elif a >= 1000000 -%}${{ "%.1f" | format(a / 1000000) }}M
    {%- elif a >= 1000 -%}${{ "%.0f" | format(a / 1000) }}K
    {%- else -%}${{ "%.0f" | format(a) }}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}
{% macro ii_flow_row(row, i) %}
    {# SM2-R3: quiver (daily Form-4) and panel (SEC bulk role) stay as separate
       sub-dicts, each with its own clock — never summed. The $ columns read the
       quiver lane; the score column reads the panel lane, side by side only. #}
    {% set _q = row.get('quiver') or {} %}
    {% set _ps = row.get('panel') or {} %}
    <tr>
      <td class="l rk num">{{ i }}</td>
      <td class="l">{{ ii_logo(row.get('ticker') or '') }}<span class="tk">{{ row.get('ticker') or '—' }}</span>{% if row.get('roster_hit') %} <span class="mchip" data-tip-en="held by tracked 13F funds" data-tip-zh="受追踪13F基金持有">13F</span>{% endif %}</td>
      <td class="num {{ 'r-pos' if (_q.get('net_usd') or 0) >= 0 else 'r-neg' }}">{{ ii_usdn(_q.get('net_usd')) }}</td>
      <td class="num">{{ _q.get('n_buys') or 0 }}/{{ _q.get('n_sells') or 0 }}</td>
      <td class="num">{{ _q.get('n_buyers') if _q.get('n_buyers') is not none else '—' }}</td>
      <td class="num sub">{{ _q.get('last_date') or '—' }}</td>
      <td>{% if _ps.get('score') is not none %}<span class="ip-score" data-tip-en="insider-power score — SEC panel lane, own clock, never summed with the $ columns" data-tip-zh="内部人力度分——SEC面板通道，独立时钟，绝不与金额列相加">{{ _ps.get('score') | round(0) | int }}{% if _ps.get('signal') %} · {{ _ps.get('signal') }}{% endif %}</span>{% else %}<span class="sub">—</span>{% endif %}</td>
    </tr>
{% endmacro %}
{% macro ii_cs_row(row, i) %}
    <tr>
      <td class="l rk num">{{ i }}</td>
      <td class="l">{{ ii_logo(row.get('ticker') or '') }}<span class="tk">{{ row.get('ticker') or '—' }}</span></td>
      <td class="l"><span class="role-pill">{{ row.get('role_label') or '—' }}</span>{% if row.get('title') %} <span class="sub2">{{ row.get('title') }}</span>{% endif %}</td>
      <td class="num">{{ usd(row.get('usd')) }}</td>
      <td class="num">{% if row.get('price') %}${{ "%.2f" | format(row.get('price')) }}{% else %}—{% endif %}</td>
      <td class="num sub">{{ row.get('trans_date') or '—' }}</td>
      <td class="num sub">{{ row.get('filing_date') or '—' }}</td>
    </tr>
{% endmacro %}
{% macro ii_cl_row(row, i) %}
    <tr>
      <td class="l rk num">{{ i }}</td>
      <td class="l">{{ ii_logo(row.get('ticker') or '') }}<span class="tk">{{ row.get('ticker') or '—' }}</span></td>
      <td class="num">{{ row.get('n_officer_buyers') or 0 }}</td>
      <td class="num">{{ usd(row.get('buy_usd')) }}</td>
      <td class="num sub">{{ row.get('last_date') or '—' }}</td>
    </tr>
{% endmacro %}
{% set d_ii = desk.get('insider_intel') or {} %}
{% if d_ii %}
{% set ii_q = d_ii.get('quiver') or {} %}
{% set ii_p = d_ii.get('panel') or {} %}
<div class="sm-sec" id="sec-insider">
  <h2>{{ t('Insider intelligence','内部人情报') }}</h2>
  <span class="h-note">{{ t('two lanes, two clocks — daily Form-4 flow vs the SEC bulk role panel — side by side only, never blended','两条通道、两个时钟——每日Form-4资金流与SEC批量角色面板——仅并列展示，绝不混合') }}</span>
</div>

<div class="banner">{{ t(
  'Descriptive flow, not a signal. Open-market trades only (P/S transaction codes) — grants and awards are excluded. The Form-4 lane is daily; the SEC role panel lags ~45 days. Each board carries its own clock; nothing is combined across lanes.',
  '描述性资金流，并非信号。仅含公开市场交易（P/S交易代码）——不含授予与奖励。Form-4通道为日频；SEC角色面板滞后约45天。每个榜单带各自时钟；不同通道的数据绝不合并。'
) }}</div>

<div class="ii-grid">

  {# -- Form-4 lane (daily): top net buys -- #}
  <div class="sm-card">
    <div class="board-h">
      <span class="bt">{{ t('Top net buys','净买入榜') }}</span>
      <span class="chip-fresh t-green"><span class="fdot"></span>{{ t('Form 4 daily · as of','Form 4 日频 · 截至') }} {{ ii_q.get('asof') or '—' }} · {{ ii_q.get('window_days') or 90 }}{{ t('d','天') }}</span>
    </div>
    <div class="board-note">{{ t('Ranked by net open-market $ over the window. The panel-score column is the SEC-panel lane shown side by side — never summed with the $ columns.','按窗口期公开市场净买入金额排名。面板分列来自SEC面板通道，仅并列展示——绝不与金额列相加。') }}{% if ii_q.get('filter') == 'ad_code_only' %} <span class="mchip">{{ t('A/D-code fallback — grants may leak in','A/D代码回退——可能混入授予') }}</span>{% endif %}</div>
    {% set _tnb = d_ii.get('top_net_buys') or [] %}
    {% if _tnb %}
    <table class="sm-t">
      <thead><tr><th class="l">#</th><th class="l">{{ t('Ticker','标的') }}</th><th>{{ t('Net $','净额') }}</th><th>{{ t('B/S','买/卖') }}</th><th>{{ t('Buyers','买入人') }}</th><th>{{ t('Last','最新') }}</th><th>{{ t('Panel score','面板分') }}</th></tr></thead>
