{# HERO: SEC-FOLLOW — Managers worth following                               #}
{# ======================================================================== #}
{% set d_follow = desk.get('follow') or {} %}
{% set d_fol_meta = d_follow.get('meta') or {} %}
{% set d_followability = d_follow.get('followability') or {} %}
{% set d_best_buys = d_follow.get('best_buys') or [] %}
{% set d_small_mid = d_follow.get('small_mid') or [] %}
{% set d_consensus = d_follow.get('sector_consensus') or [] %}
{% set d_grade_a = d_follow.get('grade_a') %}
{% set d_fol_memory = d_follow.get('memory') or {} %}

<div class="sm-sec" id="sec-follow">
  <h2>{{ t('Managers worth following','值得跟随的基金经理') }}</h2>
</div>
<p class="sm-sec-sub">{{ t('Ranked by follow-worthiness and a four-quarter record — where to research first, not a buy list.','按跟随价值与近四季战绩排序——先研究哪家，不是买入清单。') }}</p>

{% if d_fol_memory and d_fol_memory.get('board') %}
{%- set _mem_board = d_fol_memory.get('board') or [] -%}
{%- set _mem_funds = d_fol_memory.get('funds') or {} -%}
{%- set _mem_quarters = d_fol_memory.get('quarters') or [] -%}

{# ---- a) MEMORY HERO CARDS (top 5) ---- #}
<div class="mem-cards">
{%- for _slug in _mem_board[:5] -%}
  {%- set _mf = _mem_funds.get(_slug) or {} -%}
  {%- set _mname = _mf.get('name') or _slug -%}
  {%- set _mgrade = _mf.get('grade') -%}
  {%- set _mbyq = _mf.get('by_quarter') or [] -%}
  {%- set _mbeat = _mf.get('quarters_beat') or 0 -%}
  {%- set _mscored = _mf.get('quarters_scored') or 0 -%}
  {%- set _mavg = _mf.get('avg_dw_excess_60d') -%}
  {%- set _fol_entry = d_followability.get(_slug) -%}
  <a class="mem-card" href="fund_{{ _slug }}.html">
    <div class="mc-name">{{ _mname }} {% if _mgrade %}{{ gradeb(_mgrade) }}{% endif %}</div>
    <div class="mc-dots">
      {%- for _qe in _mbyq -%}
        {%- if _qe is none -%}<span class="qdot nd" data-tip-en="not enough data" data-tip-zh="数据不足"></span>
        {%- elif _qe.get('beat') is sameas true -%}<span class="qdot beat" data-tip-en="{{ _qe.get('period_end') or '' }} beat" data-tip-zh="{{ _qe.get('period_end') or '' }} 跑赢"></span>
        {%- elif _qe.get('beat') is sameas false -%}<span class="qdot miss" data-tip-en="{{ _qe.get('period_end') or '' }} missed" data-tip-zh="{{ _qe.get('period_end') or '' }} 落后"></span>
        {%- else -%}<span class="qdot nd" data-tip-en="not enough data" data-tip-zh="数据不足"></span>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="mc-line"><span class="l-en">Beat the market in <b class="mc-edge">{{ _mbeat }}</b> of {{ _mscored }} quarters</span><span class="l-zh">近{{ _mscored }}季中<b class="mc-edge">{{ _mbeat }}</b>季跑赢大盘</span></div>
    {%- if _mavg is not none -%}
    <div class="mc-line">{{ t('Typical 60-day edge:','典型60日超额：') }} <span class="mc-edge {{ 'r-pos' if _mavg >= 0 else 'r-neg' }}">{{ '%+.1f'|format(_mavg * 100) }}pp</span></div>
    {%- endif -%}
    {%- if _fol_entry is not none -%}
      {%- set _ft = _fol_entry.get('follow_tier') or 'insufficient' -%}
      {%- if _ft == 'follow' -%}<div class="mc-line"><span class="ftier follow">{{ t('Follow','跟随') }}</span></div>
      {%- elif _ft == 'watch' -%}<div class="mc-line"><span class="ftier watch">{{ t('Watch','观察') }}</span></div>
      {%- endif -%}
    {%- endif -%}
  </a>
{%- endfor -%}
</div>
<p class="mem-legend">{{ t('● beat market · ● missed · ◌ not enough data','●跑赢大盘 ●落后 ◌数据不足') }}</p>

{# ---- b) Quarterly report card table ---- #}
<div style="margin-top:18px">
  <h3 style="font-size:14px;margin:0 0 4px">{{ t('Quarterly report card — last four quarters','季度成绩单——近四个季度') }}</h3>
  <p class="sm-sec-sub" style="margin:0 0 8px">{{ t('Every tracked fund\'s new buys, scored 60 days after each filing landed, weighted by size of bet.','每家基金的新买入，在披露落地60天后计分，按下注规模加权。') }}</p>
</div>
<div class="sm-card" id="mem-rc-card">
<table class="sm-t">
  <thead><tr>
