{% set d_follow = desk.get('follow') or {} %}
{% set d_fol_meta = d_follow.get('meta') or {} %}
{% set d_followability = d_follow.get('followability') or {} %}
{% set d_best_buys = d_follow.get('best_buys') or [] %}
{% set d_small_mid = d_follow.get('small_mid') or [] %}
{% set d_consensus = d_follow.get('sector_consensus') or [] %}
{% set d_grade_a = d_follow.get('grade_a') %}

<div class="sm-sec" id="sec-follow">
  <h2>{{ t('Follow Desk','跟随台') }}</h2>
  <span class="h-note">{{ t(
    'ranked by follow-worthiness — where to research first, not a buy list',
    '按跟随价值排序——优先研究对象，非买入清单'
  ) }}</span>
</div>

<div class="follow-banner">{{ t(
  'Ranked by follow-worthiness — where to research first, NOT a buy list. 13F positions are ~45 days stale; historically 13F crowding warns more than it confirms. Scores are descriptive with n printed.',
  '按跟随价值排序——优先研究对象，非买入清单。13F持仓约有45天滞后；历史上13F聚集更多起警示作用而非确认。分数为描述性指标，附样本量。'
) }}</div>

{% if d_followability %}

{# ---- A. WHO TO FOLLOW table ---- #}
<div class="sm-card">
<table class="sm-t">
  <thead><tr>
    <th class="l">#</th>
    <th class="l">{{ t('Fund','基金') }}</th>
    <th>{{ t('Tier','层级') }}</th>
    <th>{{ t('Follow score','跟随分') }}</th>
    <th>{{ t('New sleeve','新建仓') }}</th>
    <th>{{ t('Add sleeve','加仓') }}</th>
    <th>{{ t('Rotation IQ','轮动IQ') }}</th>
    <th>{{ t('Front-run','领先跑') }}</th>
    <th>{{ t('Streak','连跌') }}</th>
  </tr></thead>
  <tbody>
  {#- Two-pass sort: (score, slug) pairs for scored, slug-only list for insufficient.
      namespace is required because Jinja2 loop-scoped set does NOT propagate to outer scope. -#}
  {%- set _fns = namespace(sc=[], un=[]) -%}
  {%- for _s, _e in d_followability.items() -%}
    {%- if _e.get('follow_score') is not none -%}
      {%- set _fns.sc = _fns.sc + [(_e.get('follow_score'), _s)] -%}
    {%- else -%}
      {%- set _fns.un = _fns.un + [_s] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set _sc_srt = _fns.sc | sort(reverse=true) -%}
  {%- set _fol_loop = namespace(i=0) -%}
  {#- Render scored rows first, then unscored -#}
  {%- for _fscore, _slug in _sc_srt -%}
    {%- set _fe = d_followability[_slug] -%}
    {%- set _ft = _fe.get('follow_tier') or 'insufficient' -%}
    {%- set _fs = _fe.get('follow_score') -%}
    {%- set _comp = _fe.get('components') or {} -%}
    {%- set _slv = _fe.get('sleeves') or {} -%}
    {%- set _riq = _fe.get('rotation_iq') or {} -%}
    {%- set _fr = _fe.get('front_run') or {} -%}
    {%- set _streak = _fe.get('loser_streak_q') or 0 -%}
    {%- set _fade_row = (_ft == 'fade') -%}
    {%- set _fol_loop.i = _fol_loop.i + 1 -%}
    <tr {{ 'style="opacity:.6"' if _fade_row else '' }}>
      <td class="l rk num">{{ _fol_loop.i }}</td>
      <td class="l"><a class="fund-link" href="fund_{{ _slug }}.html">{{ _slug }}</a>
        {%- if _fade_row %} <span class="sub">({{ t('excluded from boards','已排除出榜') }})</span>{% endif %}
      </td>
      <td>
        {%- if _ft == 'follow' -%}<span class="ftier follow">{{ t('FOLLOW','跟随') }}</span>
        {%- elif _ft == 'watch' -%}<span class="ftier watch">{{ t('WATCH','观察') }}</span>
        {%- elif _ft == 'fade' -%}<span class="ftier fade">{{ t('FADE','淡出') }}</span>
        {%- else -%}<span class="ftier insufficient">{{ t('LOW DATA','数据不足') }}</span>
        {%- endif -%}
      </td>
      <td>
        {%- if _fs is not none -%}
