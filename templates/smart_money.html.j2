  <h2>{{ t('Per-fund rotation','各基金轮动') }}</h2>
  <span class="h-note">{{ t('what each fund rotated into vs out of last quarter — tap to expand', '每只基金上季度的轮入与轮出——点击展开') }}</span>
</div>
{% for r in trk.leaderboard %}
