    <tr><td colspan="8" class="l sub">{{ t('No active activist situations.','暂无维权情况。') }}</td></tr>
  {% endfor %}
  </tbody>
</table>

{% if act_other %}
<details style="margin-top:10px">
  <summary style="cursor:pointer;padding:8px 4px;font-size:12.3px;color:var(--muted)">
    {{ t('passive &amp; other filings','被动及其他申报') }} ({{ act_other | length }})
  </summary>
  <table class="sm-t" style="margin-top:6px">
    <thead><tr>
      <th class="l">{{ t('Filed','申报日') }}</th>
      <th class="l">{{ t('Filer','申报人') }}</th>
      <th class="l">{{ t('Ticker','标的') }}</th>
      <th>{{ t('Form','表格') }}</th>
      <th>{{ t('State','状态') }}</th>
      <th>{{ t('Signal','信号') }}</th>
      <th>{{ t('Tracked holders','追踪持有者') }}</th>
      <th>{{ t('Since filing','自申报') }}</th>
    </tr></thead>
    <tbody>
    {% for row in act_other %}
      {% set st2 = row.get('state') or 'other' %}
      <tr>
        <td class="l num mut">{{ row.date_filed }}</td>
        <td class="l mut">{{ row.filer }}</td>
        <td class="l"><span class="tk mut">{{ row.ticker }}</span></td>
        <td class="num mut">{{ row.form }}</td>
        <td><span class="tier custodial">{{ st2 | upper }}</span></td>
