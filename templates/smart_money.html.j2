    <th>{{ t('Record','战绩') }}</th>
    <th>{{ t('Quarters beat','跑赢季数') }}</th>
    <th>{{ t('Typical 60-day edge','典型60日超额') }}</th>
    <th>{{ t('Picks scored','已计分买入') }}</th>
  </tr></thead>
