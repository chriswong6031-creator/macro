{# ---- Initiations: full research queue (demoted to details) ---- #}
<details style="margin-top:16px">
  <summary style="cursor:pointer;font-weight:500; font-size:12px; line-height:1.8;color:var(--muted);padding:4px 0">{{ t('Full research queue — every new position ≥1% of a book','完整研究队列——所有≥1%仓位的新建仓') }} ({{ d_init | length }})</summary>
