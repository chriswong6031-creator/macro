      <td class="num" data-tip-en="max incr pct {{ pctf(_row.get('incr_pct_max') or 0, 2) }} · sum {{ pctf(_row.get('incr_pct_sum') or 0, 2) }} · new=book %, add=incremental slice added" data-tip-zh="最大增量% {{ pctf(_row.get('incr_pct_max') or 0, 2) }} · 合计 {{ pctf(_row.get('incr_pct_sum') or 0, 2) }} · 新建仓=占仓位%, 加仓=新增切片">{{ pctf(_row.get('incr_pct_max') or 0, 1) }}</td>
      <td class="num">{{ _nf }}</td>
