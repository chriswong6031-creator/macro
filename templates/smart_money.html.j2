      <th>{{ t('Action','动作') }}</th>
      <th>{{ t('Rank in fund','基金内排名') }}</th>
      <th>{{ t('Tilt','权重偏差') }}</th>
      <th>{{ t('% book','仓位%') }}</th>
      <th>{{ t('# funds','基金数') }}</th>
      <th>{{ t('Turnover','换手') }}</th>
      <th>{{ t('Since filing','自申报') }}</th>
