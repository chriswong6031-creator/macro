<div class="sm-sec" id="sec-crowding">
  <h2>{{ t('Crowding &amp; unwind radar','拥挤度与平仓预警') }}</h2>
  <span class="h-note">{{ t('the one direction standing law permits: hazard / de-escalation','现行规则唯一允许的方向性读法：危险/降温') }}</span>
</div>

<div class="banner hazard">{{ t(
  'A crowded name carries elevated unwind risk — this is a hazard readout, not a buy or a sell. Short columns are separate axes with their own clocks; nothing here is combined into a score. Prior phase-0 on crowding fragility printed a weak, non-robust drawdown effect — this board accrues against that prior.',
  '拥挤个股存在更高的平仓风险——这是危险预警，而非买卖信号。空头相关列属独立视角，有各自的时间戳；此处数据不会合并为评分。早期阶段0对拥挤脆弱性的测试得到了弱且不稳健的回撤效应——本板块正在针对该先验持续积累数据。'
) }}</div>

{% set sv_asof = (d_crowd[0].get('short_volume') or {}).get('asof') if d_crowd else '' %}
{% set si_settle = (d_crowd[0].get('short_interest') or {}).get('settlement_date') if d_crowd else '' %}

<div class="sm-card">
<table class="sm-t">
  <thead><tr>
    <th class="l">{{ t('Ticker','标的') }}</th>
    <th>{{ t('Holders','持有者') }}</th>
    <th>{{ t('Agg $','总金额') }}</th>
    <th>{{ t('HHI','集中度') }}</th>
    <th>{{ t('Days-to-exit','平仓天数') }}</th>
    <th>{{ t('Crowding','拥挤度') }}</th>
    <th>{{ t('Entry band P50','入场中位价') }}</th>
    <th>{{ t('Underwater','水下数') }}</th>
    <th>{{ t('Short vol trend','空头量趋势') }} <span style="text-transform:none;font-weight:400">({{ t('daily','日频') }}{% if sv_asof %} · {{ sv_asof }}{% endif %})</span></th>
    <th>{{ t('Days-to-cover','回补天数') }} <span style="text-transform:none;font-weight:400">({{ t('settle','结算') }}{% if si_settle %} {{ si_settle }}{% endif %})</span></th>
  </tr></thead>
  <tbody>
  {% for row in d_crowd %}
    {% set ct = row.get('crowding_tier') or 'unavail' %}
    {% set sv = row.get('short_volume') or {} %}
    {% set si = row.get('short_interest') or {} %}
    {% set eb = row.get('entry_band') or {} %}
    <tr>
      <td class="l"><span class="tk">{{ row.ticker }}</span></td>
      <td class="num">{{ row.n_funds }}</td>
      <td class="num">{{ usd(row.agg_value_usd) }}</td>
      <td class="num">{{ "%.3f" | format(row.hhi) if row.get('hhi') is not none else '—' }}</td>
      <td class="num">{% if row.get('days_to_exit') is not none %}{% if row.days_to_exit < 0.05 %}&lt;0.1{% else %}{{ "%.1f" | format(row.days_to_exit) }}{% endif %}{% else %}—{% endif %}</td>
      <td><span class="tier {{ ct }}">{{ ct | upper }}</span></td>
      <td class="num">{% if eb.get('p50') %}${{ "%.2f" | format(eb.p50) }} <span class="mut">{{ t('proxy','估算') }}</span>{% else %}—{% endif %}</td>
      <td class="num">{% if eb.get('n_underwater') is not none and eb.get('n') %}{{ eb.n_underwater }} / {{ eb.n }}{% else %}—{% endif %}</td>
      <td class="num">
        {% if sv.get('trend_pp') is not none %}
          <span class="{{ 'r-pos' if sv.trend_pp >= 0 else 'r-neg' }}">{{ "%+.1f" | format(sv.trend_pp) }}pp</span>
          {% if sv.get('ratio_z') is not none %}<span class="sub"> z {{ "%+.2f" | format(sv.ratio_z) }}</span>{% endif %}
        {% else %}—{% endif %}
      </td>
      <td class="num">{{ "%.1f" | format(si.days_to_cover) if si.get('days_to_cover') is not none else '—' }}</td>
    </tr>
  {% else %}
    <tr><td colspan="10" class="l sub">{{ t('No crowding data available.','暂无拥挤度数据。') }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>

