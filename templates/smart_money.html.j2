  {%- set _rc_shown = namespace(n=0) -%}
  {#- Ranked funds first -#}
  {%- for _slug in (_mem_board or []) -%}
    {%- set _mf = _mem_funds.get(_slug) or {} -%}
    {%- set _mname = _mf.get('name') or _slug -%}
    {%- set _mbyq = _mf.get('by_quarter') or [] -%}
    {%- set _mbeat = _mf.get('quarters_beat') or 0 -%}
    {%- set _mscored = _mf.get('quarters_scored') or 0 -%}
    {%- set _mavg = _mf.get('avg_dw_excess_60d') -%}
    {%- set _mn_scored = namespace(total=0) -%}
    {%- for _qe in _mbyq -%}{%- if _qe is not none and _qe.get('n_priced') is not none -%}{%- set _mn_scored.total = _mn_scored.total + (_qe.get('n_priced') or 0) -%}{%- endif -%}{%- endfor -%}
    {%- set _rc_shown.n = _rc_shown.n + 1 -%}
    <tr{%- if _rc_shown.n > 20 %} class="sm-fold-row" style="display:none"{%- endif %}>
      <td class="l"><a class="fund-link" href="fund_{{ _slug }}.html">{{ _mname }}</a></td>
      <td>
        <span class="mc-dots" style="display:inline-flex;gap:4px">
        {%- for _qe in _mbyq -%}
          {%- if _qe is none -%}<span class="qdot nd" data-tip-en="not enough data" data-tip-zh="数据不足"></span>
          {%- elif _qe.get('beat') is sameas true -%}<span class="qdot beat" data-tip-en="{{ _qe.get('period_end') or '' }} beat" data-tip-zh="{{ _qe.get('period_end') or '' }} 跑赢"></span>
          {%- elif _qe.get('beat') is sameas false -%}<span class="qdot miss" data-tip-en="{{ _qe.get('period_end') or '' }} missed" data-tip-zh="{{ _qe.get('period_end') or '' }} 落后"></span>
          {%- else -%}<span class="qdot nd" data-tip-en="not enough data" data-tip-zh="数据不足"></span>
          {%- endif -%}
        {%- endfor -%}
        </span>
      </td>
      <td class="num">{{ _mbeat }}/{{ _mscored }}</td>
      <td>
        {%- if _mavg is not none -%}<span class="num {{ 'r-pos' if _mavg >= 0 else 'r-neg' }}">{{ '%+.1f'|format(_mavg * 100) }}pp</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td class="num">{{ _mn_scored.total if _mn_scored.total > 0 else '—' }}</td>
    </tr>
  {%- endfor -%}
  {#- Unranked funds after fold -#}
  {%- for _slug in (_mem_funds.keys() | list) -%}
    {%- if _slug not in (_mem_board or []) -%}
      {%- set _mf = _mem_funds.get(_slug) or {} -%}
      {%- set _mname = _mf.get('name') or _slug -%}
      {%- set _mbyq = _mf.get('by_quarter') or [] -%}
      {%- set _rc_shown.n = _rc_shown.n + 1 -%}
      <tr class="sm-fold-row" style="display:none">
        <td class="l"><a class="fund-link" href="fund_{{ _slug }}.html">{{ _mname }}</a> <span class="sub">{{ t('not enough data yet','数据不足') }}</span></td>
        <td>
          <span class="mc-dots" style="display:inline-flex;gap:4px">
          {%- for _qe in _mbyq -%}
            {%- if _qe is none -%}<span class="qdot nd" data-tip-en="not enough data" data-tip-zh="数据不足"></span>
            {%- elif _qe.get('beat') is sameas true -%}<span class="qdot beat"></span>
            {%- elif _qe.get('beat') is sameas false -%}<span class="qdot miss"></span>
            {%- else -%}<span class="qdot nd"></span>
            {%- endif -%}
          {%- endfor -%}
          </span>
        </td>
        <td class="sub">—</td><td class="sub">—</td><td class="sub">—</td>
      </tr>
    {%- endif -%}
  {%- endfor -%}
  </tbody>
</table>
{%- if ((_mem_board | length) + ((_mem_funds.keys() | list | length) - (_mem_board | length))) > 20 -%}
<div class="smfold-more-row" id="mem-rc-fold">
  <button type="button" class="smfold-btn" onclick="(function(el){el.closest('.sm-card').querySelectorAll('.sm-fold-row').forEach(function(r){r.style.display='';});el.parentNode.style.display='none';})(this)">{{ t('See more','展开更多') }}</button>
</div>
{%- endif -%}
<p class="hon-note" style="margin-top:8px">{{ t('Descriptive record, not a forecast — 13F filings arrive ~45 days late; scores start at each quarter\'s filing deadline.','描述性战绩，非预测——13F披露滞后约45天；计分自每季申报截止日起算。') }}</p>
</div>
{% else %}{# no memory data #}
<div class="sm-card" style="padding:16px"><p class="follow-empty">{{ t('Fund memory not computed this build — will appear after the next successful run.','本次构建未计算基金记忆——将在下次成功构建后出现。') }}</p></div>
{% endif %}

<div class="follow-banner" style="margin-top:14px">{{ t(
  'Ranked by follow-worthiness — where to research first, NOT a buy list. 13F positions are ~45 days stale; historically 13F crowding warns more than it confirms. Scores are descriptive composites with n printed.',
  '按跟随价值排序——优先研究对象，非买入清单。13F持仓约有45天滞后；历史上13F聚集更多起警示作用而非确认。分数为描述性综合指标，附样本量。'
) }}</div>

{% if d_followability %}
{# ---- c) Follow table (cap 20 + fold) with renamed columns + 4Q dots ---- #}
<div class="sm-card" id="follow-tbl-card">
<table class="sm-t">
  <thead><tr>
    <th class="l">#</th>
    <th class="l">{{ t('Fund','基金') }}</th>
    <th>{{ t('Tier','层级') }}</th>
    <th>{{ t('Follow score','跟随分') }}</th>
    <th>{{ t('Record','近四季') }}</th>
    <th>{{ t('New sleeve','新建仓') }}</th>
    <th>{{ t('Add sleeve','加仓') }}</th>
    <th>{{ t('Sector timing','板块择时') }}</th>
    <th>{{ t('Cold quarters','连续落后季数') }}</th>
  </tr></thead>
  <tbody>
  {%- set _fns = namespace(sc=[], un=[]) -%}
  {%- for _s, _e in d_followability.items() -%}
    {%- if _e.get('follow_score') is not none -%}
      {%- set _fns.sc = _fns.sc + [(_e.get('follow_score'), _s)] -%}
    {%- else -%}
      {%- set _fns.un = _fns.un + [_s] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set _sc_srt = _fns.sc | sort(reverse=true) -%}
  {%- set _fol_loop = namespace(i=0) -%}
  {%- for _fscore, _slug in _sc_srt -%}
    {%- set _fe = d_followability[_slug] -%}
    {%- set _ft = _fe.get('follow_tier') or 'insufficient' -%}
    {%- set _fs = _fe.get('follow_score') -%}
    {%- set _comp = _fe.get('components') or {} -%}
    {%- set _slv = _fe.get('sleeves') or {} -%}
    {%- set _riq = _fe.get('rotation_iq') or {} -%}
    {%- set _streak = _fe.get('loser_streak_q') or 0 -%}
    {%- set _fade_row = (_ft == 'fade') -%}
    {%- set _fol_loop.i = _fol_loop.i + 1 -%}
    {%- set _mf_entry = (d_fol_memory.get('funds') or {}).get(_slug) or {} -%}
    {%- set _mbyq = _mf_entry.get('by_quarter') or [] -%}
    <tr {{ 'style="opacity:.6"' if _fade_row else '' }}{%- if _fol_loop.i > 20 %} class="fol-fold-row" style="display:none"{%- endif %}>
      <td class="l rk num">{{ _fol_loop.i }}</td>
      <td class="l"><a class="fund-link" href="fund_{{ _slug }}.html">{{ _slug }}</a>
        {%- if _fade_row %} <span class="sub">（{{ t('excluded from boards','已排除出榜') }}）</span>{% endif %}
      </td>
      <td>
        {%- if _ft == 'follow' -%}<span class="ftier follow">{{ t('Follow','跟随') }}</span>
        {%- elif _ft == 'watch' -%}<span class="ftier watch">{{ t('Watch','观察') }}</span>
        {%- elif _ft == 'fade' -%}<span class="ftier fade">{{ t('Fade','淡出') }}</span>
        {%- else -%}<span class="ftier insufficient">{{ t('LOW DATA','数据不足') }}</span>
        {%- endif -%}
      </td>
      <td>
        {%- if _fs is not none -%}
          <span class="fsc-bar"><i style="width:{{ _fs }}%"></i></span>
          <span class="num" style="margin-left:5px" data-tip-en="edge {{ _comp.get('edge') if _comp.get('edge') is not none else '—' }} · consistency {{ _comp.get('consistency') if _comp.get('consistency') is not none else '—' }} · durability {{ _comp.get('durability') if _comp.get('durability') is not none else '—' }} · sell {{ _comp.get('sell') if _comp.get('sell') is not none else '—' }} · n penalty {{ _comp.get('n_penalty') if _comp.get('n_penalty') is not none else '—' }}" data-tip-zh="优势 {{ _comp.get('edge') if _comp.get('edge') is not none else '—' }} · 一致性 {{ _comp.get('consistency') if _comp.get('consistency') is not none else '—' }} · 持久性 {{ _comp.get('durability') if _comp.get('durability') is not none else '—' }} · 卖出 {{ _comp.get('sell') if _comp.get('sell') is not none else '—' }} · n惩罚 {{ _comp.get('n_penalty') if _comp.get('n_penalty') is not none else '—' }}">{{ _fs }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        <span style="display:inline-flex;gap:4px">
        {%- for _qe in _mbyq -%}
          {%- if _qe is none -%}<span class="qdot nd"></span>
          {%- elif _qe.get('beat') is sameas true -%}<span class="qdot beat"></span>
          {%- elif _qe.get('beat') is sameas false -%}<span class="qdot miss"></span>
          {%- else -%}<span class="qdot nd"></span>
          {%- endif -%}
        {%- endfor -%}
        {%- if not _mbyq -%}<span class="sub">—</span>{%- endif -%}
        </span>
      </td>
      <td>
        {%- set _sn = (_slv.get('new') or {}) -%}
        {%- if _sn.get('median_excess') is not none -%}
          {{ exret(_sn.get('median_excess')) }} <span class="sub">n {{ _sn.get('n') or 0 }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        {%- set _sa = (_slv.get('add') or {}) -%}
        {%- if _sa.get('median_excess') is not none -%}
          {{ exret(_sa.get('median_excess')) }} <span class="sub">n {{ _sa.get('n') or 0 }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        {%- if _riq.get('score') is not none -%}
          <span class="num" data-tip-en="hit rate {{ hit(_riq.get('hit_rate')) }} · n {{ _riq.get('n_calls') or 0 }} calls across {{ _riq.get('n_quarters') or 0 }} quarters" data-tip-zh="方向胜率 {{ hit(_riq.get('hit_rate')) }} · {{ _riq.get('n_calls') or 0 }} 次调仓 / {{ _riq.get('n_quarters') or 0 }} 个季度">{{ _riq.get('score') }}</span>
        {%- else -%}<span class="sub">—</span>{%- endif -%}
      </td>
      <td>
        {%- if _streak > 0 -%}<span class="num" style="color:var(--down)">{{ _streak }}</span>{%- endif -%}
      </td>
    </tr>
  {%- endfor -%}
  {#- LOW-DATA tail: show count only, not all-dash rows -#}
  {%- if _fns.un -%}
    <tr>
      <td colspan="9" class="l sub" style="padding-top:8px">
        {{ _fns.un | length }}{{ t(' more funds tracked — not enough scored buys yet','家基金在跟踪中——已计分买入不足') }}
      </td>
    </tr>
  {%- endif -%}
  </tbody>
</table>
{%- if _sc_srt | length > 20 -%}
<div class="smfold-more-row" id="fol-tbl-fold">
  <button type="button" class="smfold-btn" onclick="(function(el){el.closest('.sm-card').querySelectorAll('.fol-fold-row').forEach(function(r){r.style.display='';});el.parentNode.style.display='none';})(this)">{{ t('See more','展开更多') }} ({{ [(_sc_srt | length) - 20, 0] | max }})</button>
</div>
{%- endif -%}
</div>

{% else %}{# no followability data #}
<div class="sm-card"><p class="follow-empty">{{ t('Follow Desk not computed this build — follow, best-buys, and consensus boards will appear on the next successful run.','本次构建未计算跟随台——跟随、最佳买入及共识看板将在下次成功构建时出现。') }}</p></div>
{% endif %}{# /followability #}

<p class="disc" style="margin-top:14px">
{{ t('Seeded by the frozen Q1-2026 grade-A study — receipts:','源自冻结的2026年一季度A级研究——凭据：') }}
research/smart_money_grade_a_q1_2026.md
</p>

{# ======================================================================== #}
{# S1 OWNERSHIP EVENT WIRE                                                   #}
{# ======================================================================== #}
<div class="sm-sec" id="sec-wire">
  <h2>{{ t('What just moved','最新动向') }}</h2>
  <span class="h-note">{{ t('Every ownership event as it lands — newest first.','每一条持仓事件，最新在前。') }}</span>
</div>

<div class="filters" id="wire-filters">
  <span class="fpill on" data-axis="all">{{ t('All','全部') }}</span>
  <span class="fpill" data-axis="13f">{{ t('13F','13F') }}</span>
  <span class="fpill" data-axis="13fa">{{ t('Amendments','修正案') }}</span>
  <span class="fpill" data-axis="13dg">{{ t('13D/G','13D/G') }}</span>
  <span class="fpill" data-axis="insider">{{ t('Insider','内部人') }}</span>
</div>

<div class="sm-card">
  <p class="wire-count">{{ t('Showing','展示') }} <span class="num" id="wire-shown-n">{{ [d_wire | length, WIRE_FOLD] | min }}</span> / <span class="num" id="wire-total-n">{{ d_wire | length }}</span> {{ t('— the newest ' ~ WIRE_FOLD ~ ' across all axes; the full feed is loaded on this page','——所有轴最新' ~ WIRE_FOLD ~ '条；完整数据流已加载于本页') }}</p>
  <ul class="wire" id="wire-list">
  {#- Render the FULL wire with progressive disclosure. The fold is the newest
      WIRE_FOLD rows across all axes (wire is newest-first); "See more" reveals the
      rest client-side. The JS re-derives the fold for the active axis filter
      (first WIRE_FOLD matching rows), so the counts above are recomputed on load. -#}
  {% for row in d_wire %}
    {% set _fold01 = 1 if loop.index0 < WIRE_FOLD else 0 %}
    {% set ax_raw = row.get('axis') or '' %}
    {% set is_amend = row.get('type') == '13f_amendment' %}
    {% set ax = 'insider' if ax_raw[:5] == 'form4' else ('13fa' if is_amend else ax_raw) %}
    {% set axis_class = 'axis-form4' if ax == 'insider' else ('axis-13f' if ax == '13fa' else 'axis-' ~ ax) %}
    {% if ax == '13f' %}{% set axis_label = '13F' %}
    {% elif ax == '13fa' %}{% set axis_label = '13F/A' %}
    {% elif ax == '13dg' %}{% set axis_label = row.get('type') or '13D/G' %}
    {% elif ax == 'insider' %}{% set axis_label = 'FORM4' %}
    {% elif ax == 'short' %}{% set axis_label = 'SHORT' %}
    {% else %}{% set axis_label = ax | upper %}{% endif %}

    {# Build description from action + magnitude + fund #}
    {% set action = row.get('action') or '' %}
    {% set fund = row.get('fund') or row.get('slug') or '' %}
    {% set mag = row.get('magnitude') %}
    {% set unit = row.get('unit') or '' %}
    {% if action == '13d' %}{% set desc_en = fund ~ ' files 13D' ~ ((' — ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action == '13g' %}{% set desc_en = fund ~ ' files 13G' ~ ((' — ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action == 'amendment' %}{% set desc_en = fund ~ ' files amendment' ~ ((' — ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action == 'flip' %}{% set desc_en = fund ~ ' converts 13G → 13D (passive → active)' %}
    {% elif action in ('new','add') %}{% set desc_en = fund ~ ' ' ~ action ~ ((' ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif action in ('trim','exit') %}{% set desc_en = fund ~ ' ' ~ action ~ ((' ' ~ (mag | string) ~ unit) if mag else '') %}
    {% elif ax == 'insider' %}
      {% set nb = row.get('n_buys') or 0 %}{% set ns = row.get('n_sells') or 0 %}
      {% set net = row.get('net_usd') or 0 %}
      {% set net_mn = (net / 1000000) | round(1) %}
      {% set desc_en = 'insider cluster — ' ~ nb ~ ' buy' ~ ('s' if nb != 1 else '') ~ ', ' ~ ns ~ ' sell' ~ ('s' if ns != 1 else '') ~ ', net ' ~ ('+' if net >= 0 else '−') ~ '$' ~ (net_mn | abs) ~ 'M' %}
    {% else %}{% set desc_en = fund ~ ' ' ~ action %}{% endif %}

    {% set asof_note = row.get('asof_note') or '' %}
    {% set ax_tier = 'green' if ax in ('13dg','insider','short') else ('amber' if ax == '13fa' else ('amber' if ax == 'short_interest' else 'red')) %}

    {%- set _wire_fund_slug = row.get('slug') or '' -%}
    {%- set _wire_fol_entry = d_followability.get(_wire_fund_slug) if _wire_fund_slug else none -%}
    {%- set _wire_is_followed = (_wire_fol_entry is not none and _wire_fol_entry.get('follow_tier') == 'follow') -%}
    <li data-axis="{{ ax }}" data-fold="{{ _fold01 }}"{% if not _fold01 %} style="display:none"{% endif %}>
      <span class="wd num">{{ row.get('date') or '' }}</span>
      <span class="axis-tag {{ axis_class }}">{{ axis_label }}</span>
      <span class="wtk num">{{ row.get('ticker') or '' }}</span>
      <span class="wdesc">{{ desc_en | e }}</span>
      {%- if _wire_is_followed -%}
      <span class="followed-chip">{{ t('Followed fund','重点跟随基金') }}</span>
      {%- endif -%}
      <span class="chip-fresh t-{{ ax_tier }} wasof"><span class="fdot"></span>{{ asof_note | e }}</span>
    </li>
  {% else %}
    <li><span class="sub">{{ t('No wire events available.','暂无播报事件。') }}</span></li>
  {% endfor %}
  </ul>
  {% set _wire_hidden0 = [(d_wire | length) - WIRE_FOLD, 0] | max %}
  <div class="wire-more-row" id="wire-more-row"{% if _wire_hidden0 <= 0 %} style="display:none"{% endif %}>
    <button type="button" class="wire-more" id="wire-more-btn">{{ t('See more','展开更多') }} (<span class="num" id="wire-hidden-n">{{ _wire_hidden0 }}</span>)</button>
    <button type="button" class="wire-more" id="wire-all-btn">{{ t('Show all','全部展开') }}</button>
    <button type="button" class="wire-more" id="wire-fewer-btn" style="display:none">{{ t('Show fewer','收起') }}</button>
  </div>
</div>

