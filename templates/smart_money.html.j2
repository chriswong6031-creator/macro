{# S6 ACTIVIST SITUATION MONITOR                                             #}
{# ======================================================================== #}
<div class="sm-sec" id="sec-activists">
  <h2>{{ t('Activist situation monitor','维权情况监控') }}</h2>
  <span class="h-note">{{ t('13D/G stream, ~5–10 day lag — the timeliest ownership lens on this desk','13D/G数据流，约5–10天滞后——本台最及时的持仓视角') }}</span>
</div>

{% set act_active = d_act | selectattr('state','in',['activist','flip']) | list %}
{% set act_other = d_act | rejectattr('state','in',['activist','flip']) | list %}

<div class="sm-card">
<table class="sm-t">
  <thead><tr>
    <th class="l">{{ t('Filed','申报日') }}</th>
    <th class="l">{{ t('Filer','申报人') }}</th>
    <th class="l">{{ t('Ticker','标的') }}</th>
    <th>{{ t('Form','表格') }}</th>
    <th>{{ t('State','状态') }}</th>
    <th>{{ t('Signal','信号') }}</th>
    <th>{{ t('Tracked holders','追踪持有者') }}</th>
    <th>{{ t('Since filing','自申报') }}</th>
