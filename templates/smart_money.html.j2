        </div>
        <div>
          <div class="rot-h out">{{ t('Rotated out of','轮出') }} ({{ f.rotation.out | length }})</div>
          <table class="mini"><tbody>
          {% for tr in f.rotation.out %}
            <tr><td class="l"><span class="tk">{{ tr.ticker }}</span> <span class="act-pill {{ tr.action }}">{{ tr.action }}</span></td>
                <td class="sub">{% if tr.get('shares_change_pct') is not none %}{{ "%+.0f" | format(tr.shares_change_pct) }}%{% endif %}</td>
                <td>{{ exret(tr.since_excess) }}</td></tr>
          {% else %}<tr><td class="l sub">{{ t('no sells last quarter','上季度无卖出') }}</td></tr>{% endfor %}
          </tbody></table>
        </div>
      </div>
      {% if f.rotation.top_holdings %}
      <div class="rot-h" style="margin-top:12px">{{ t('Current top holdings','当前主要持仓') }}</div>
      <div class="hold">
        {% for h in f.rotation.top_holdings %}
          <span class="h-pill"><b class="num">{{ h.ticker }}</b> {{ pctf(h.pct) }} <span class="act-pill {{ h.action }}">{{ h.action }}</span></span>
