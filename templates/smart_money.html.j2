        {%- for _fe in (_row.get('funds') or []) -%}
          {%- set _fft = _fe.get('follow_tier') or 'insufficient' -%}
          <span class="mchip ftier {{ _fft }}" style="font-size:9px">{{ _fe.get('name') or _fe.get('slug') or '—' }} · <span class="act-pill {{ _fe.get('action') or '' }}">{{ _fe.get('action') or '' }}</span> {{ pctf(_fe.get('incr_pct') or 0, 1) }}</span>
