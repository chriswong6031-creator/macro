{# ---- Best Buys board (cap 20 + fold) ---- #}
{% if d_best_buys %}
<div class="sm-card">
<table class="sm-t">
  <thead><tr>
    <th class="l">#</th>
    <th class="l">{{ t('Ticker','代码') }}</th>
    <th class="l">{{ t('Sector','行业') }}</th>
    <th>{{ t('Cap','市值') }}</th>
    <th>{{ t('Desk score','台面分') }}</th>
    <th class="l">{{ t('Funds','基金') }}</th>
    <th>{{ t('Conviction','信念') }}</th>
    <th class="num">{{ t('n','n') }}</th>
    <th>{{ t('Filed','申报') }}</th>
    <th>{{ t('Since filing','申报后') }}</th>
  </tr></thead>
  <tbody>
  {%- set _bb_fold = namespace(n=0) -%}
  {%- for _row in d_best_buys -%}
    {%- set _bb_fold.n = _bb_fold.n + 1 -%}
    {%- set _show = (_bb_fold.n <= 20) -%}
    {%- set _nf = _row.get('n_funds') or 0 -%}
