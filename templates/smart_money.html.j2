      <td class="num">{{ row.get('signal') or '—' }}</td>
      <td class="num">{{ row.n_tracked_holders if row.get('n_tracked_holders') is not none else '—' }}</td>
      <td>{{ exret(row.get('since_excess')) }}</td>
