<body class="public-page">
{% include "_public_nav.html.j2" %}

<div class="wrap">

  <header class="hero">
    <span class="eyebrow">{{ t('Email settings', '邮件设置') }}</span>
    {#- the EN word-space lives INSIDE the l-en span: markup whitespace between the two
        spans would print a stray gap after the ZH full-width comma -#}
    <h1>{{ t('One click. ', '一键退订，') }}<span class="accent">{{ t('No more marketing email.', '不再收到营销邮件。') }}</span></h1>
    <p class="sub">{{ t('Account emails — receipts, sign-in links, support replies — keep coming either way.',
                        '账户邮件——收据、登录链接、客服回复——不受影响，照常送达。') }}</p>
  </header>

  <section class="panel">
    <div class="p-head">
      <span class="mlab">
        <span class="lb lb-ready">{{ t('Marketing email: on', '营销邮件：已开启') }}</span>
        <span class="lb lb-off">{{ t('Marketing email: off', '营销邮件：已关闭') }}</span>
        <span class="lb lb-bad">{{ t('Link not valid', '链接无效') }}</span>
      </span>
    </div>

    <div class="p-body">

      <div class="err" role="alert">
        <span class="ic"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M10 6.5v4.2M10 13.6v.1"/></svg></span>
        <span>{{ t('That didn\'t go through. Try again, or write to <a href="mailto:support@mastermind-x.com">support@mastermind-x.com</a>.',
                   '没有成功。请重试，或发邮件至 <a href="mailto:support@mastermind-x.com">support@mastermind-x.com</a>。') }}</span>
      </div>

      {#- ── READY: the only state with a live button. Nothing has happened yet. ── -#}
      <div class="st st-ready">
        <p class="lede">{{ t('Press the button and we stop sending marketing email to this address.',
                             '点击下面的按钮，我们就不再向这个邮箱发送营销邮件。') }}</p>
        <div class="act">
          <button class="btn" type="button" id="u-go">{{ t('Unsubscribe', '退订') }}</button>
          <span class="note">{{ t('Nothing changes until you press it.', '在你点击之前，什么都不会改变。') }}</span>
        </div>
      </div>

      {#- ── OFF: the choice is recorded. ─────────────────────────────────────── -#}
      <div class="st st-off">
        <div class="seal"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg></div>
        <h2>{{ t('Marketing emails are off.', '营销邮件已关闭。') }}</h2>
        <p>{{ t('We stopped marketing email to <b class="addr" data-addr>this address</b>. Receipts, sign-in links and replies from support still reach you.',
                '我们已停止向 <b class="addr" data-addr>这个邮箱</b> 发送营销邮件。收据、登录链接以及客服回复，照常送达。') }}</p>
        <p class="refused">{{ t('This one cannot be switched back on here: the address bounced or reported us as spam. Write to <a href="mailto:support@mastermind-x.com">support@mastermind-x.com</a> if that was a mistake.',
                                '这个邮箱无法在此重新开启：这个地址曾经退信，或将我们标记为垃圾邮件。如果这是误会，请发邮件至 <a href="mailto:support@mastermind-x.com">support@mastermind-x.com</a>。') }}</p>
        {#- The way back is deliberately a second, quieter action — never the default,
            and never pre-selected. The note is the PIN §7.4 rule applied to a page:
            one honest exit, no win-back. -#}
        <div class="act">
          <button class="btn btn-ghost" type="button" id="u-back">{{ t('Turn them back on', '重新开启') }}</button>
          <span class="note">{{ t('We will not email to ask you to reconsider.', '我们不会再发邮件劝你回来。') }}</span>
