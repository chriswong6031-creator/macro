<script>
/* /unsubscribe.html page JS. One job: take the token out of the URL and, WHEN THE READER
   PRESSES A BUTTON, post it to POST /api/email/unsubscribe (app/unsubscribe.py, SEE W4).

   No session, no Supabase client, no auth header — the signed token IS the authorisation,
   which is the whole point of the page. Origin resolution mirrors support.html.j2 /
   mm_brain.js: window.MM_BRAIN_CFG.api, '' meaning same origin.

   The token is never written back into the DOM or the URL by this script, and no state
   here is persisted: a shared or forwarded link leaves nothing behind in the browser. */
(function () {
  'use strict';
  var H = document.documentElement;
  var $ = function (s) { return document.querySelector(s); };
  var API = ((window.MM_BRAIN_CFG && window.MM_BRAIN_CFG.api) || '').replace(/\/$/, '');

  /* Read ?t= without URLSearchParams so the page keeps working in the older in-app
     browsers some mail clients still embed. */
  function param(name) {
    var m = new RegExp('[?&]' + name + '=([^&#]*)').exec(location.search || '');
    return m ? decodeURIComponent(m[1].replace(/\+/g, ' ')) : '';
  }
  var TOKEN = param('t');

  /* The undo capability, and the ONLY place it ever exists. The token in the URL
     authorises `unsubscribe` and nothing else — the action is inside its signature — so
     "turn them back on" needs a resubscribe-scoped token, and the server mints one only
     for the request that actually recorded the opt-out. It lives in this closure: never in
     the URL, never in the DOM, never in an email, and gone when the tab closes. */
  var UNDO = '';

  /* A missing token is decided here, with no request: the server would answer the same
     400, and asking it would mean the page briefly offers a button that cannot work. */
  if (!TOKEN) H.setAttribute('data-unsub', 'bad');

  function paintAddr(masked) {
    if (!masked) return;   /* keep the dual-language "this address" the markup ships with:
                              an empty mask used to render "We stopped marketing email to
                              ." — a sentence with a hole where its object should be */
    Array.prototype.forEach.call(document.querySelectorAll('[data-addr]'), function (b) {
      b.textContent = masked;
    });
  }

  function send(action, btn) {
    var tok = action === 'resubscribe' ? UNDO : TOKEN;
    if (!TOKEN) { H.setAttribute('data-unsub', 'bad'); return; }
    if (!tok) { H.setAttribute('data-err', '1'); return; }
    H.removeAttribute('data-refused');
    H.removeAttribute('data-err');
    if (btn) btn.setAttribute('aria-busy', 'true');
    fetch(API + '/api/email/unsubscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ t: tok, action: action })
    }).then(function (r) {
      /* 400 is the server saying the token does not verify. For the unsubscribe press
         that IS the dead-link story the `bad` panel exists to tell. For an undo it is
         not — the opt-out on screen is real and recorded — so the step stays and the bar
         says the retry failed. Anything else that is not ok is ours, either way. */
      if (r.status === 400 && action !== 'resubscribe') {
        H.setAttribute('data-unsub', 'bad'); return null;
      }
      if (!r.ok) { H.setAttribute('data-err', '1'); return null; }
      return r.json();
    }).then(function (j) {
      if (!j) return;                                   /* already handled */
      paintAddr(j.email_masked);
      if (j.refused) H.setAttribute('data-refused', '1');
      UNDO = j.resubscribe_token || '';
      if (UNDO) H.setAttribute('data-undo', '1'); else H.removeAttribute('data-undo');
      H.setAttribute('data-unsub', j.state === 'subscribed' ? 'on' : 'off');
    }).catch(function () {
      /* data-err, NOT data-unsub: the reader's step, its label and its button all stay
         exactly as they were. Overwriting the state here is how a failed "turn them back
         on" used to leave an "Unsubscribe" button under a "try again" bar. */
      H.setAttribute('data-err', '1');
    }).then(function () {
      if (btn) btn.removeAttribute('aria-busy');
    });
  }

  var go = $('#u-go');
  if (go) go.addEventListener('click', function () { send('unsubscribe', go); });
  var back = $('#u-back');
  if (back) back.addEventListener('click', function () { send('resubscribe', back); });
  var off = $('#u-off');
  if (off) off.addEventListener('click', function () { send('unsubscribe', off); });

  /* theme.js dispatches langchange on DOCUMENT and it does not bubble, so a window
     listener would silently never fire. Nothing here is language-dependent today —
     the dual spans are CSS — but the hook is where the next person will look. */
  document.addEventListener('langchange', function () { /* dual spans handle themselves */ });
})();
</script>
</body>
</html>
