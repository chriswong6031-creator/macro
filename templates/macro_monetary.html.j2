{#
  Macro Command — the suite hub (F01 / Macro Command P1).

  ONE dashboard page for the fourteen `macro_*` research workspaces, guided
  reading rather than a KPI grid: the page opens on one plain-word sentence
  ("The Read"), not a wall of numbers. Frozen spec:
  research/... (see the F01 Macro Command masterplan) §2.7/§2.8/§6.2.

  DS header (§12 items 2-3, orchestrator rulings R1/R2):
  - Archetype: `command_center` ("Command Center"),
    research/MASTER_PRODUCT_DESIGN_SYSTEM_V1.md §10 row A, copied verbatim.
  - `.mc-panel` SUPERSEDES `.mq-card` on this page: no `.mq-card` is rendered
    inside site/macro_monetary.html. The 14 deep-link `macro_<slug>.html`
    pages keep their own `.mq-card` system unchanged (§6.3).

  Three things it deliberately does NOT do, because each is a closed
  construction rather than a missing feature:

    * It does not score, rank or fuse the fourteen workspaces into one reading
      (DNR:KILL-FUSED-COMPOSITE, DNR:KILL-REGIME-SCORECARD). The sidebar order
      is a fixed reading order (SECTIONS in scripts/build_macro_suite_pages.py)
      and never changes with the data.
    * The Read is a verbatim pass-through of each workspace's own reviewed
      state label, joined by fixed connectives — never a judgment, never fused.
    * It does not present machine text: no raw slug, no internal state id, no
      untranslated stat name is on screen outside a `<details>` subtree.

  P1 (this packet) ships the shell, rail, hash routing, tokens and panel
  stubs only — no content computation. Every non-Overview panel's default
  content is the honest offer line to its own workspace page (deviation from
  the frozen spec's literal "twelve E1 states" for P1, ruled by the
  orchestrator under G4: the literal E1 "why" sentence would be false for a
  section whose source HAS published). Panels carry no stance / primer /
  caption / watching copy in P1 — placeholder copy there would be machine
  text; a later packet ships the reviewed copy.
#}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro bl(node) -%}
{%- if node %}{{ t(node.en, node.zh) }}{% endif -%}
{%- endmacro %}
{% import "_macro_command_macros.html.j2" as m %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }} — MastermindX</title>
{% set seo_title = page_seo_title %}
{% set seo_desc = page_seo_desc %}
{% set seo_path = page_seo_path %}
{% include "_seo_head.html.j2" %}
<script src="macro_suite_boot.js"></script>
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="macro_suite.css">
<link rel="stylesheet" href="macro_command.css">
</head>
<body class="mq-page mc-page">
{% include "_site_nav.html.j2" %}

<main class="mc-shell" id="mc-shell">

  <a class="mc-skip" href="#mc-content">{{ t("Skip to today's read", '跳到今日读数') }}</a>

  <nav class="mc-rail" id="mc-rail" aria-labelledby="mc-rail-label">
    <p class="mc-rail-label" id="mc-rail-label">{{ t('Sections', '板块') }}</p>
    <ul class="mc-rail-list">
      {%- for s in sections %}
      <li class="mc-rail-item">
        <a class="mc-rail-link{{ ' is-current' if s.first else '' }}"
           href="#{{ s.id }}" data-mc-section="{{ s.id }}"
           {%- if s.first %} aria-current="page"{% endif %}>
          <span class="mc-rail-bar" aria-hidden="true"></span>
          <span class="mc-rail-text">{{ bl(s.label) }}</span>
          {%- if s.tone %}<span class="mc-rail-dot mq-tone-{{ s.tone }}" aria-hidden="true"></span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ul>

    {# ANALYST — mount the sitewide widget; the bare link is the degraded fallback only (§8) #}
    {%- if analyst.mountable %}
    <button type="button" class="mc-analyst" data-mc-analyst
            data-mc-analyst-label-en="Macro Command" data-mc-analyst-label-zh="宏观指挥台">
      <span class="mc-analyst-mark" aria-hidden="true">◈</span>
      <span class="mc-analyst-text">{{ t('Ask the analyst', '向分析师提问') }}</span>
    </button>
    {%- else %}
    <a class="mc-analyst" href="chat.html">
      <span class="mc-analyst-mark" aria-hidden="true">◈</span>
      <span class="mc-analyst-text">{{ t('Ask the analyst', '向分析师提问') }}</span>
    </a>
    {%- endif %}
  </nav>

  <div class="mc-content" id="mc-content">

    <header class="mc-command">
      <p class="mc-eyebrow">
        <span class="mc-eyebrow-suite">{{ t('Macro & Monetary', '宏观与货币') }}</span>
        <span class="mc-eyebrow-sep" aria-hidden="true">·</span>
        {%- if read.as_of %}
        <span class="mc-eyebrow-asof">
          {# G2b: the plain word is INSIDE the visible text; the machine value is only in datetime= #}
          <span class="mc-asof-word">{{ t('Data to', '数据截至') }}</span>
          <time datetime="{{ read.as_of }}">{{ bl(read.as_of_display) }}</time>
        </span>
        {%- else %}
        <span class="mc-eyebrow-asof mc-absent">{{ t('No dated reading yet', '暂无带日期的读数') }}</span>
        {%- endif %}
      </p>
      <h1 class="mc-title">{{ t('Macro Command', '宏观指挥台') }}</h1>

      {# THE READ — one sentence, deterministic, single-workspace pass-through only (G3) #}
      {{ m.read_block(read) }}

      {# THE STATE STRIP — the same seven readings in the scanning register, plus data coverage #}
      {{ m.state_strip(strip) }}
    </header>

    {%- for s in sections %}
    <section class="mc-panel" id="{{ s.id }}" data-mc-panel="{{ s.id }}"
             aria-labelledby="{{ s.id }}-h" tabindex="-1">
      <div class="mc-panel-head">
        <h2 class="mc-panel-title" id="{{ s.id }}-h">{{ bl(s.label) }}</h2>
        {%- if s.question %}<p class="mc-panel-question">{{ bl(s.question) }}</p>{% endif %}
      </div>

      {%- if s.stance %}
      <p class="mc-stance mq-tone-{{ s.stance.tone }}">
        <span class="mc-stance-bar" aria-hidden="true"></span>
        <span class="mq-sr">{{ t('What this means for you', '这对你意味着什么') }}: </span>
        <span class="mc-stance-text">{{ bl(s.stance.text) }}</span>
      </p>
      {%- endif %}

      {%- if s.primer %}
      <details class="mc-primer"{{ ' open' if s.primer_open else '' }}>
        <summary>{{ t('New to this? 30 seconds', '第一次看？30 秒读懂') }}</summary>
        <div class="mc-primer-body">{{ bl(s.primer) }}</div>
      </details>
      {%- endif %}

      {%- if s.subtabs %}
      <div class="mc-subtabs" role="tablist" aria-label="{{ s.subtab_group_en }}">
        {%- for tab in s.subtabs %}
        <button type="button" class="mc-subtab" role="tab" id="{{ tab.id }}-t"
                data-mc-subtab="{{ tab.id }}" aria-controls="{{ tab.id }}"
                aria-selected="{{ 'true' if tab.first else 'false' }}"
                tabindex="{{ '0' if tab.first else '-1' }}">{{ bl(tab.label) }}</button>
        {%- endfor %}
      </div>
      {%- endif %}

      <div class="mc-figure" data-mc-figure>
        {%- if s.first %}
        <p class="mc-figure-building">{{ t('This overview is being built. Each section on the left opens its full workspace.',
                                             '总览正在建设中。左侧每个板块均可打开其完整工作区。') }}</p>
        {%- elif s.subtabs %}
        {# D8: the DEFAULT (no-JS) content is an honest null with a real destination, for EACH tab body.
           The pending line is hidden in the document and unhidden by JS at boot; both tab bodies ship
           unhidden in the served document (R3) — JS applies the roving hide/show once it runs (§6.2). #}
        <p class="mc-figure-pending" hidden data-mc-pending>{{ t('Loading this section…', '正在载入本板块…') }}</p>
        {%- for tab in s.subtabs %}
        <div class="mc-figure-tabbody" data-mc-tabbody="{{ tab.id }}" id="{{ tab.id }}"
             role="tabpanel" aria-labelledby="{{ tab.id }}-t">
          <p class="mc-figure-offer" data-mc-offer>
            <a class="mc-deep" href="{{ tab.deep_href }}">{{ t('The full chart for this section lives on its workspace page →',
                                                                 '本板块的完整图表位于其工作区页面 →') }}</a>
          </p>
        </div>
        {%- endfor %}
        {%- else %}
        {# D8: the DEFAULT (no-JS) content is an honest null with a real destination.
           The pending line is hidden in the document and unhidden by JS at boot. #}
        <p class="mc-figure-pending" hidden data-mc-pending>{{ t('Loading this section…', '正在载入本板块…') }}</p>
        <p class="mc-figure-offer" data-mc-offer>
          <a class="mc-deep" href="{{ s.deep_href }}">{{ t('The full chart for this section lives on its workspace page →',
                                                             '本板块的完整图表位于其工作区页面 →') }}</a>
        </p>
        {%- endif %}
      </div>
      {%- if s.caption %}<p class="mc-caption">{{ bl(s.caption) }}</p>{% endif %}

      {%- if s.watching %}
      <div class="mc-watch">
        <h3 class="mc-watch-title">{{ t("What we're watching", '我们在观察什么') }}</h3>
        <ul class="mc-watch-list">
          {%- for w in s.watching %}<li>{{ bl(w) }}</li>{% endfor %}
        </ul>
      </div>
      {%- endif %}

      <details class="mc-details">
        <summary>{{ t('Details, methods and sources', '细节、方法与来源') }}</summary>
        <div class="mc-details-body">
          {# §1.3: the workspace's own title, once, as the deep link. Overview has
             no single workspace of its own, so it lists all fourteen (real
             registry titles/hrefs, closed suite order — never invented copy). #}
          <ul class="mc-details-links">
            {%- for link in s.detail_links %}
            <li><a href="{{ link.href }}">{{ bl(link.title) }}</a></li>
            {%- endfor %}
          </ul>
        </div>
      </details>
    </section>
    {%- endfor %}
  </div>
</main>
<script src="macro_command.js" defer></script>
<script src="theme.js" defer></script>
</body>
</html>
