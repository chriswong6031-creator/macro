{#- ===========================================================================
    _track_record_dlg.html.j2 — the shared "Track record" receipt chip + popup.

    ONE component, four host pages (us_stocks, china, hk, canada). The stat line
    itself IS the button; clicking it opens an in-page popup dashboard — no page
    navigation. Self-contained: its own scoped CSS (every selector prefixed
    `trd-`) and its own JS (no dependency on mx5OpenDlg or any host CSS beyond the
    shared theme.css token :root, which all four families link).

    Design (Fable main-loop spec 2026-07-20 + DESIGN_DOCTRINE.md):
      • Signature = the live sparkline. The chip's icon is the desk's OWN win-rate
        curve, drawn from trd.series — different per market per night. The receipt
        you can see before you click.
      • Accent = stance color. --trd-accent binds to the host up-colour when the
        desk is winning, --link when mixed, host down-colour when cold. Because the
        host swaps --up/--down at :root for zh, the accent flips green↔red with the
        language automatically — never a hard-coded hex.
      • Glance tier: state + one plain line on the chip; every technical (CI, base
        rate, grading rule) is demoted to a hover or into the dialog. One as-of,
        one merged footnote (Law 4). No overclaiming vocabulary. No CJK inside title=.

    Host contract — set `trd` (a dict) then `{% include %}` (bare include carries
    both context vars AND the host t() macro; verified). See §1 of the spec.
    Colored numbers use trd.up_class / trd.dn_class (the HOST's semantic classes).
    =========================================================================== #}
{%- if trd %}
{%- set _up = trd.up_class if trd.up_class else 'az-up' -%}
{%- set _dn = trd.dn_class if trd.dn_class else 'az-dn' -%}
{%- set _st = trd.stats or {} -%}
{%- set _series = trd.series if (trd.series is defined and trd.series) else none -%}
{#- Accent stance band. scored → win_rate_pct; interim → hit_pct; else neutral. -#}
{%- set _band = 'neutral' -%}
{%- if trd.state == 'scored' and (_st.get('win_rate_pct') is not none) -%}
  {%- if _st.win_rate_pct >= 55 -%}{% set _band = 'up' %}{%- elif _st.win_rate_pct < 45 -%}{% set _band = 'dn' %}{%- endif -%}
{%- elif trd.state == 'interim' and (_st.get('hit_pct') is not none) -%}
  {%- if _st.hit_pct >= 55 -%}{% set _band = 'up' %}{%- elif _st.hit_pct < 45 -%}{% set _band = 'dn' %}{%- endif -%}
{%- endif -%}

<style>
/* ── trd tokens: fallback chains so all four CSS families resolve ──────────────
   Every var falls back through theme.css :root (--gbtn-*, --panel2, --text …),
   then to a literal so a single missing var never drops the whole declaration
   (the color-mix-undefined-var trap). Accent is set per-band by the .trd-band-*
   class below, so the chip, sparkline and card numbers all read one stance. */
.trd-wrap{
  --trd-accent: var(--link, #7aa7e0);
  --trd-bg:     var(--gbtn-bg, color-mix(in srgb, var(--panel2, var(--panel, #181b21)) 52%, transparent));
  --trd-bg-hi:  var(--gbtn-bg-hover, color-mix(in srgb, var(--panel2, var(--panel, #181b21)) 76%, transparent));
  --trd-brd:    var(--gbtn-brd, color-mix(in srgb, var(--text, #d7dce3) 12%, transparent));
  --trd-sheen:  var(--gbtn-sheen, rgba(255,255,255,.09));
  --trd-panel:  var(--panel2, var(--panel, #181b21));
  --trd-panel1: var(--panel, #181b21);
  --trd-line:   var(--line, #2a2f3a);
  --trd-text:   var(--text, #d7dce3);
  --trd-muted:  var(--muted, #8b93a1);
  --trd-link:   var(--link, #7aa7e0);
  --trd-warn:   var(--warn, #e0a030);
  display:inline-flex;max-width:100%;
}
.trd-band-up{ --trd-accent: var(--up, #45b873); }
.trd-band-dn{ --trd-accent: var(--down, #e06464); }
.trd-band-neutral{ --trd-accent: var(--link, #7aa7e0); }

/* ── the chip / button ──────────────────────────────────────────────────────
   Elevates the .gbtn glass DNA — never clones .board-track-toggle. */
.trd-btn{
  display:inline-flex;align-items:center;gap:9px;
  border-radius:999px;padding:8px 15px 8px 12px;
  border:1px solid color-mix(in srgb, var(--trd-accent) 35%, var(--trd-brd));
  background:var(--trd-bg);
  -webkit-backdrop-filter:blur(12px) saturate(140%);backdrop-filter:blur(12px) saturate(140%);
  box-shadow:inset 0 1px 0 var(--trd-sheen), 0 1px 2px rgba(3,7,18,.18);
  color:var(--trd-text);font:600 12.5px/1 var(--font-ui,inherit);
  cursor:pointer;position:relative;overflow:hidden;isolation:isolate;
  -webkit-tap-highlight-color:transparent;max-width:100%;
  transition:border-color .22s ease, transform .12s ease, box-shadow .22s ease;
}
.trd-btn::after{ /* diagonal sheen sweep on hover */
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:linear-gradient(115deg,transparent 30%,color-mix(in srgb,var(--trd-accent) 22%,transparent) 48%,transparent 66%);
  transform:translateX(-120%);transition:transform .5s ease;
}
.trd-btn:hover{ transform:translateY(-1px);
  border-color:color-mix(in srgb, var(--trd-accent) 55%, var(--trd-brd));
  background:var(--trd-bg-hi); }
.trd-btn:hover::after{ transform:translateX(120%); }
.trd-btn:active{ transform:scale(.985); }
.trd-btn:focus-visible{ outline:2px solid var(--trd-accent);outline-offset:2px; }
.trd-btn.trd-is-open{
  border-color:var(--trd-accent);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--trd-accent) 30%,transparent),
             inset 0 1px 0 var(--trd-sheen), 0 0 14px color-mix(in srgb,var(--trd-accent) 22%,transparent);
}
/* sparkline icon */
.trd-spark{ display:block;flex:none;width:40px;height:14px;overflow:visible; }
.trd-spark path{ fill:none;stroke:var(--trd-accent);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;
  filter:drop-shadow(0 0 3px color-mix(in srgb,var(--trd-accent) 60%,transparent)); }
/* label + stat */
.trd-lead{ color:var(--trd-muted);font-weight:600; }
.trd-stat{ color:var(--trd-text);font-weight:600;white-space:nowrap; }
.trd-stat b{ color:var(--trd-accent);font-weight:700; }
.trd-sep{ color:var(--trd-muted);margin:0 2px; }
/* chevron affordance */
.trd-chev{ display:inline-flex;align-items:center;justify-content:center;flex:none;
  width:18px;height:18px;border-radius:50%;
  border:1px solid color-mix(in srgb,var(--trd-accent) 40%,var(--trd-brd));
  transition:transform .2s ease,border-color .2s ease; }
.trd-chev svg{ width:9px;height:9px;display:block;stroke:var(--trd-accent);stroke-width:2.4;
  stroke-linecap:round;stroke-linejoin:round;fill:none; }
.trd-btn:hover .trd-chev{ transform:translateX(2px);border-color:var(--trd-accent); }

@media (prefers-reduced-motion: no-preference){
  /* sparkline draw-in, once on load */
  .trd-spark path.trd-live{ stroke-dasharray:120;stroke-dashoffset:120;animation:trd-draw .9s ease-out .15s forwards; }
  @keyframes trd-draw{ to{ stroke-dashoffset:0; } }
  /* slow breathing halo — scored/interim winning states only; NOT accruing
     (nothing to brag about — honesty in motion). Quieter than .gbtn-cta. */
  .trd-btn.trd-breathe{ animation:trd-breathe 3.8s ease-in-out infinite; }
  @keyframes trd-breathe{
    0%,100%{ box-shadow:inset 0 1px 0 var(--trd-sheen), 0 1px 2px rgba(3,7,18,.18); }
    50%{ box-shadow:inset 0 1px 0 var(--trd-sheen), 0 0 0 4px color-mix(in srgb,var(--trd-accent) 12%,transparent), 0 1px 2px rgba(3,7,18,.18); }
  }
}

/* ── dialog shell ───────────────────────────────────────────────────────────*/
html.trd-lock{ overflow:hidden; }
html.trd-lock body{ overflow:hidden;position:fixed;width:100%; }
.trd-dlg{ display:none;position:fixed;inset:0;z-index:9200; }
.trd-dlg.trd-open{ display:block; }
.trd-backdrop{ position:absolute;inset:0;background:rgba(3,6,10,.55);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);opacity:0;transition:opacity .28s ease; }
.trd-dlg.trd-in .trd-backdrop{ opacity:1; }
.trd-panel{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  box-sizing:border-box;
  width:min(94vw,1020px);max-width:1020px;max-height:min(86vh,900px);
  display:flex;flex-direction:column;
  background:color-mix(in srgb,var(--trd-panel1) 92%, #05070d);
  border:1px solid color-mix(in srgb,var(--trd-text) 12%,transparent);
  border-radius:18px;overflow:hidden;
  box-shadow:0 40px 120px rgba(0,0,0,.6),0 2px 0 rgba(255,255,255,.05) inset;
  opacity:0;transition:opacity .1s ease;
}
@supports ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .trd-panel{ background:color-mix(in srgb,var(--trd-panel1) 82%, transparent);
    -webkit-backdrop-filter:blur(26px) saturate(1.4);backdrop-filter:blur(26px) saturate(1.4); }
}
[data-theme="light"] .trd-panel{ background:#ffffff;border-color:rgba(0,0,0,.06);
  box-shadow:0 32px 96px rgba(0,0,0,.16),0 0 0 1px rgba(0,0,0,.04); }
@media (prefers-reduced-motion: no-preference){
  .trd-panel{ transform:translate(-50%,calc(-50% + 14px)) scale(.985);
    transition:opacity .34s ease, transform .34s cubic-bezier(.22,.9,.26,1); }
  .trd-dlg.trd-in .trd-panel{ opacity:1;transform:translate(-50%,-50%) scale(1); }
  .trd-dlg.trd-closing .trd-backdrop,.trd-dlg.trd-closing .trd-panel{ transition-duration:.18s; }
  .trd-dlg.trd-closing .trd-backdrop{ opacity:0; }
  .trd-dlg.trd-closing .trd-panel{ opacity:0;transform:translate(-50%,calc(-50% + 8px)) scale(.99); }
}
.trd-dlg.trd-in .trd-panel{ opacity:1; }

/* sticky header */
.trd-hd{ position:sticky;top:0;z-index:3;flex:none;
  padding:18px 22px 14px;display:flex;align-items:flex-start;gap:14px;
  background:color-mix(in srgb,var(--trd-panel1) 92%, #05070d);
  border-bottom:1px solid color-mix(in srgb,var(--trd-text) 8%,transparent); }
[data-theme="light"] .trd-hd{ background:#ffffff;border-bottom-color:rgba(0,0,0,.07); }
.trd-hd-txt{ flex:1;min-width:0; }
.trd-eyebrow{ font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--trd-muted); }
.trd-title{ font-size:19px;font-weight:800;line-height:1.15;margin:2px 0 3px;color:var(--trd-text); }
.trd-sub{ font-size:12.5px;line-height:1.35;color:var(--trd-muted);max-width:62ch; }
.trd-close{ flex:none;width:32px;height:32px;border-radius:50%;cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;
  border:1px solid var(--trd-brd);background:var(--trd-bg);color:var(--trd-muted);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  box-shadow:inset 0 1px 0 var(--trd-sheen);transition:color .18s,border-color .18s,transform .12s; }
.trd-close:hover{ color:var(--trd-text);border-color:color-mix(in srgb,var(--trd-text) 30%,var(--trd-brd)); }
.trd-close:active{ transform:scale(.94); }
.trd-close:focus-visible{ outline:2px solid var(--trd-accent);outline-offset:2px; }
.trd-close svg{ width:13px;height:13px;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;fill:none; }

.trd-body{ overflow-y:auto;padding:16px 22px 20px;flex:1; }
@media (prefers-reduced-motion: no-preference){
  .trd-dlg.trd-in .trd-stg{ opacity:0;transform:translateY(8px);animation:trd-rise .4s ease forwards; }
  .trd-dlg.trd-in .trd-stg-1{ animation-delay:.06s; } .trd-dlg.trd-in .trd-stg-2{ animation-delay:.10s; }
  .trd-dlg.trd-in .trd-stg-3{ animation-delay:.14s; } .trd-dlg.trd-in .trd-stg-4{ animation-delay:.18s; }
  @keyframes trd-rise{ to{ opacity:1;transform:none; } }
}

/* Zone A — verdict cards */
.trd-ribbon{ margin:0 0 14px;padding:9px 13px;border-radius:10px;font-size:12px;line-height:1.4;
  background:color-mix(in srgb,var(--trd-warn) 14%,transparent);
  border:1px solid color-mix(in srgb,var(--trd-warn) 34%,transparent);color:var(--trd-text); }
.trd-cards{ display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px; }
.trd-card{ padding:14px;border-radius:12px;border:1px solid var(--trd-line);
  background:color-mix(in srgb,var(--trd-panel) 60%,transparent); }
.trd-card-k{ font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--trd-muted); }
.trd-card-v{ font-size:26px;font-weight:700;line-height:1.1;margin:4px 0 2px;font-variant-numeric:tabular-nums; }
.trd-card-v.trd-accented{ color:var(--trd-accent); }
.trd-card-m{ font-size:10.5px;line-height:1.35;color:var(--trd-muted); }
.trd-card.trd-card-wide{ grid-column:1 / -1; }
/* segmented resolved bar */
.trd-segbar{ display:flex;height:8px;border-radius:5px;overflow:hidden;margin:8px 0 6px;background:var(--trd-line); }
.trd-seg{ height:100%;transition:none; }
.trd-seg-up{ background:var(--up,#45b873); } .trd-seg-dn{ background:var(--down,#e06464); }
.trd-seg-flat{ background:var(--trd-muted); }
@media (prefers-reduced-motion: no-preference){ .trd-seg{ width:0;transition:width .6s ease .2s; } .trd-dlg.trd-in .trd-seg{ /* width set inline */ } }
.trd-seg-legend{ font-size:10.5px;color:var(--trd-muted); }
.trd-seg-legend b.trd-up{ color:var(--up,#45b873); } .trd-seg-legend b.trd-dn{ color:var(--down,#e06464); }
/* timeline card (accruing) */
.trd-tl{ margin-top:2px; }
.trd-tl-bar{ position:relative;height:6px;border-radius:4px;background:var(--trd-line);margin:10px 0 6px;overflow:visible; }
.trd-tl-fill{ position:absolute;left:0;top:0;bottom:0;border-radius:4px;
  background:linear-gradient(90deg,color-mix(in srgb,var(--trd-accent) 30%,transparent),var(--trd-accent)); }
.trd-tl-now{ position:absolute;top:-3px;width:12px;height:12px;border-radius:50%;
  background:var(--trd-accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--trd-accent) 25%,transparent);transform:translateX(-50%); }
.trd-tl-ends{ display:flex;justify-content:space-between;font-size:10.5px;color:var(--trd-muted); }

/* Zone B — filter rail + table */
.trd-rail{ position:sticky;top:0;z-index:2;display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center;
  padding:10px 0 12px;margin-bottom:6px;border-bottom:1px solid var(--trd-line);
  background:color-mix(in srgb,var(--trd-panel1) 92%,#05070d); }
[data-theme="light"] .trd-rail{ background:#ffffff; }
.trd-chips{ display:inline-flex;flex-wrap:wrap;gap:6px; }
.trd-chip{ font:600 11.5px/1 var(--font-ui,inherit);padding:6px 11px;border-radius:999px;cursor:pointer;
  border:1px solid var(--trd-brd);background:transparent;color:var(--trd-muted);
  transition:background .15s,color .15s,border-color .15s;white-space:nowrap; }
.trd-chip:hover{ color:var(--trd-text);border-color:color-mix(in srgb,var(--trd-text) 26%,var(--trd-brd)); }
.trd-chip[aria-pressed="true"]{ background:color-mix(in srgb,var(--trd-accent) 22%,transparent);
  color:var(--trd-text);border-color:color-mix(in srgb,var(--trd-accent) 55%,transparent); }
.trd-chip:focus-visible{ outline:2px solid var(--trd-accent);outline-offset:2px; }
.trd-search,.trd-sel{ font:500 12px/1 var(--font-ui,inherit);padding:6px 10px;border-radius:8px;
  border:1px solid var(--trd-brd);background:color-mix(in srgb,var(--trd-panel) 50%,transparent);color:var(--trd-text); }
.trd-search{ min-width:130px; } .trd-search::placeholder{ color:var(--trd-muted); }
.trd-search:focus-visible,.trd-sel:focus-visible{ outline:2px solid var(--trd-accent);outline-offset:1px; }
.trd-rail-grow{ flex:1;min-width:6px; }

.trd-tbl-wrap{ overflow-x:auto;border-radius:10px;border:1px solid var(--trd-line); }
.trd-tbl{ width:100%;border-collapse:collapse;font-size:12px; }
.trd-tbl th{ text-align:left;font-size:10.5px;font-weight:700;letter-spacing:.02em;color:var(--trd-muted);
  padding:8px 10px;border-bottom:1px solid var(--trd-line);white-space:nowrap;
  background:color-mix(in srgb,var(--trd-panel) 40%,transparent);position:sticky;top:0; }
.trd-tbl th.trd-num{ text-align:right; }
.trd-tbl th.trd-sortable{ cursor:pointer;user-select:none; }
.trd-tbl th.trd-sortable:hover{ color:var(--trd-text); }
.trd-sort-ar{ opacity:.4;font-size:9px;margin-left:2px; }
.trd-tbl th[aria-sort="ascending"] .trd-sort-ar,.trd-tbl th[aria-sort="descending"] .trd-sort-ar{ opacity:1;color:var(--trd-accent); }
.trd-tbl td{ padding:7px 10px;border-bottom:1px solid color-mix(in srgb,var(--trd-line) 55%,transparent);vertical-align:middle;white-space:nowrap; }
.trd-tbl td.trd-num{ text-align:right;font-variant-numeric:tabular-nums; }
.trd-tbl tr:last-child td{ border-bottom:none; }
.trd-tk{ font-weight:700;color:var(--trd-text); }
.trd-tk a{ color:inherit;text-decoration:none;border-bottom:1px solid transparent; }
.trd-tk a:hover{ border-bottom-color:currentColor; }
.trd-sub-cell{ display:block;font-size:10px;color:var(--trd-muted);font-weight:400; }
.trd-mut{ color:var(--trd-muted); }
.trd-dot{ display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:middle; }
.trd-dot-up{ background:var(--up,#45b873); } .trd-dot-dn{ background:var(--down,#e06464); }
.trd-dot-flat{ background:var(--trd-muted); } .trd-dot-early{ background:var(--trd-warn); }
.trd-flag{ font-size:10px;color:var(--trd-muted);margin-left:4px;cursor:help; }
@media (prefers-reduced-motion: no-preference){
  .trd-tbl tbody tr.trd-anim{ opacity:0;transform:translateY(8px);animation:trd-rowin .22s ease forwards; }
  @keyframes trd-rowin{ to{ opacity:1;transform:none; } }
}
/* shimmer skeleton */
.trd-skel{ border-radius:8px;background:linear-gradient(90deg,var(--trd-line) 25%,color-mix(in srgb,var(--trd-line) 40%,transparent) 50%,var(--trd-line) 75%);
  background-size:200% 100%; }
@media (prefers-reduced-motion: no-preference){ .trd-skel{ animation:trd-shimmer 1.3s linear infinite; } }
@keyframes trd-shimmer{ to{ background-position:-200% 0; } }
.trd-skel-row{ height:34px;margin:6px 0; } .trd-skel-card{ height:78px; }
.trd-err{ padding:20px;text-align:center;color:var(--trd-muted);font-size:12.5px;line-height:1.5; }
.trd-retry{ margin-top:8px;font:600 12px/1 var(--font-ui,inherit);padding:6px 14px;border-radius:999px;cursor:pointer;
  border:1px solid var(--trd-brd);background:var(--trd-bg);color:var(--trd-text); }
.trd-retry:hover{ border-color:color-mix(in srgb,var(--trd-accent) 50%,var(--trd-brd)); }

/* pagination */
.trd-pg{ display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:center;margin-top:12px; }
.trd-pg-btn{ font:600 12px/1 var(--font-ui,inherit);min-width:30px;padding:6px 9px;border-radius:8px;cursor:pointer;
  border:1px solid var(--trd-brd);background:transparent;color:var(--trd-muted);transition:background .15s,color .15s,border-color .15s; }
.trd-pg-btn:hover:not(:disabled){ color:var(--trd-text);border-color:color-mix(in srgb,var(--trd-text) 26%,var(--trd-brd)); }
.trd-pg-btn[aria-current="page"]{ background:color-mix(in srgb,var(--trd-accent) 22%,transparent);
  color:var(--trd-text);border-color:color-mix(in srgb,var(--trd-accent) 55%,transparent); }
.trd-pg-btn:disabled{ opacity:.4;cursor:default; }
.trd-pg-btn:focus-visible{ outline:2px solid var(--trd-accent);outline-offset:2px; }
.trd-pg-ell{ color:var(--trd-muted);padding:0 2px; }
.trd-pg-count{ font-size:11px;color:var(--trd-muted);margin-left:6px; }

/* Zone C — footer */
.trd-ft{ flex:none;padding:12px 22px;border-top:1px solid color-mix(in srgb,var(--trd-text) 8%,transparent);
  display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;justify-content:space-between;
  background:color-mix(in srgb,var(--trd-panel1) 92%,#05070d); }
[data-theme="light"] .trd-ft{ background:#ffffff;border-top-color:rgba(0,0,0,.07); }
.trd-ft-note{ flex:1;min-width:220px;font-size:10.5px;line-height:1.45;color:var(--trd-muted); }
.trd-ft-link{ font:600 11.5px/1 var(--font-ui,inherit);padding:6px 12px;border-radius:999px;white-space:nowrap;
  border:1px solid var(--trd-brd);background:var(--trd-bg);color:var(--trd-link);text-decoration:none;
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px); }
.trd-ft-link:hover{ border-color:color-mix(in srgb,var(--trd-link) 50%,var(--trd-brd)); }

/* ── mobile: bottom sheet ≤700px ─────────────────────────────────────────────*/
@media (max-width:700px){
  .trd-panel{ left:0;top:auto;bottom:0;transform:none;width:100vw;max-width:100vw;
    max-height:92vh;border-radius:16px 16px 0 0;border-bottom:none; }
  @media (prefers-reduced-motion: no-preference){
    .trd-panel{ transform:translateY(16px);transition:opacity .3s ease,transform .3s cubic-bezier(.22,.9,.26,1); }
    .trd-dlg.trd-in .trd-panel{ transform:translateY(0); }
    .trd-dlg.trd-closing .trd-panel{ transform:translateY(16px); }
  }
  .trd-hd,.trd-body,.trd-ft{ padding-left:16px;padding-right:16px; }
  .trd-title{ font-size:17px; }
}
</style>

{%- set _m = trd.market -%}
{#- ─────────────────────────────────────────────────────────────────────────
    THE CHIP — server-rendered stat so it reads correctly with JS off.
    ───────────────────────────────────────────────────────────────────────── -#}
<span class="trd-wrap trd-band-{{ _band }}">
<button type="button" id="trd-btn" class="trd-btn{% if trd.state in ('scored','interim') and _band == 'up' %} trd-breathe{% endif %}"
        aria-haspopup="dialog" aria-expanded="false" aria-controls="trd-dlg">
  {#- sparkline: the desk's own curve. No <span> inside the svg. -#}
  {%- if _series and (_series | length) >= 4 -%}
    {%- set _mn = _series | min -%}{%- set _mx = _series | max -%}
    {%- set _rng = (_mx - _mn) if (_mx - _mn) > 0 else 1 -%}
    {%- set _n = _series | length -%}
  <svg class="trd-spark" viewBox="0 0 40 14" aria-hidden="true" preserveAspectRatio="none">
    <path class="trd-live" d="M{% for v in _series %}{{ '%.1f'|format(loop.index0 * (40 / (_n - 1))) }},{{ '%.1f'|format(12 - ((v - _mn) / _rng) * 10) }}{{ ' L' if not loop.last else '' }}{% endfor %}"/>
  </svg>
  {%- else -%}
  <svg class="trd-spark" viewBox="0 0 40 14" aria-hidden="true" preserveAspectRatio="none">
    <path d="M0,10 L8,10 L12,4 L17,12 L22,7 L30,8 L40,6"/>
  </svg>
  {%- endif -%}
  {#- label + stat, per state -#}
  <span class="trd-stat"><span class="trd-lead">{{ t('Track record', '往绩') }}</span>
    {%- if trd.state == 'scored' and _st.get('win_rate_pct') is not none -%}
      <span class="trd-sep">·</span><span class="l-en"><b>{{ _st.win_rate_pct }}% win</b>{% if _st.get('avg_pct') is not none %} · {{ '%+g'|format(_st.avg_pct) }}% avg{% endif %}</span><span class="l-zh"><b>胜率 {{ _st.win_rate_pct }}%</b>{% if _st.get('avg_pct') is not none %} · 平均 {{ '%+g'|format(_st.avg_pct) }}%{% endif %}</span>
    {%- elif trd.state == 'interim' and _st.get('hit_pct') is not none -%}
      <span class="trd-sep">·</span><span class="l-en"><b>{{ _st.hit_pct }}% ahead of {{ trd.bench_en or 'the index' }}</b> · early</span><span class="l-zh"><b>{{ _st.hit_pct }}% 暂跑赢{{ trd.bench_zh or '指数' }}</b> · 初期</span>
    {%- else -%}
      <span class="trd-sep">·</span><span class="l-en">building{% if _st.get('n_calls') is not none %} · {{ _st.n_calls }} calls logged{% endif %}</span><span class="l-zh">累积中{% if _st.get('n_calls') is not none %} · 已记录 {{ _st.n_calls }} 笔{% endif %}</span>
    {%- endif -%}
  </span>
  <span class="trd-chev" aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M4.5 2.5 L8 6 L4.5 9.5"/></svg></span>
</button>
</span>

{#- ─────────────────────────────────────────────────────────────────────────
    THE DIALOG
    ───────────────────────────────────────────────────────────────────────── -#}
<div class="trd-wrap trd-band-{{ _band }}" style="display:contents">
<div id="trd-dlg" class="trd-dlg" role="dialog" aria-modal="true" aria-labelledby="trd-dlg-title" data-url="{{ trd.data_url or '' }}" data-market="{{ _m }}" data-state="{{ trd.state }}"
     data-bench-en="{{ trd.bench_en or '' }}" data-bench-zh="{{ trd.bench_zh or '' }}" data-up-class="{{ _up }}" data-dn-class="{{ _dn }}">
  <div class="trd-backdrop" data-trd-close></div>
  <div class="trd-panel">
    <div class="trd-hd">
      <div class="trd-hd-txt">
        <div class="trd-eyebrow"><span class="l-en">{{ trd.eyebrow_en or 'Board track record' }}</span><span class="l-zh">{{ trd.eyebrow_zh or '榜单往绩' }}</span></div>
        <div class="trd-title" id="trd-dlg-title">{{ t('Track record', '榜单往绩') }}</div>
        <div class="trd-sub">
          {%- if trd.state == 'scored' and _st.get('win_rate_pct') is not none -%}
            {%- if _st.win_rate_pct >= 60 -%}<span class="l-en">Worth following — wins are outrunning stops.</span><span class="l-zh">值得跟踪——盈多于损。</span>
            {%- elif _st.win_rate_pct >= 45 -%}<span class="l-en">Mixed so far — treat picks as ideas to check, not auto-buys.</span><span class="l-zh">喜忧参半——榜单是线索，不是自动买入。</span>
            {%- else -%}<span class="l-en">Cold stretch — stops are outrunning wins. Be picky.</span><span class="l-zh">近期偏冷——止损多于盈利，需精选。</span>{%- endif -%}
          {%- elif trd.state == 'interim' -%}
            <span class="l-en">Early read only — not final grades yet. Watch, don't lean on it.</span><span class="l-zh">仅为初期读数——尚非最终成绩，参考勿依赖。</span>
          {%- else -%}
            <span class="l-en">Too early to score — every call is logged and will be graded.</span><span class="l-zh">暂无法评分——每笔信号都已记录，将逐一打分。</span>
          {%- endif -%}
        </div>
      </div>
      <button type="button" class="trd-close" data-trd-close aria-label="Close">
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12"/></svg>
      </button>
    </div>

    <div class="trd-body">
      {#- ── Zone A — verdict cards (server-rendered) ──────────────────────── -#}
      <div class="trd-stg trd-stg-1">
      {%- if trd.state == 'interim' -%}
      <div class="trd-ribbon"><span class="l-en">Early read — marked to latest close, not final grades.{% if _st.get('first_mature') %} First matured grades ~{{ _st.first_mature }}.{% endif %}</span><span class="l-zh">初期读数——按最新收盘标记，非最终成绩。{% if _st.get('first_mature') %}首批成熟评分约 {{ _st.first_mature }}。{% endif %}</span></div>
      {%- endif -%}
      <div class="trd-cards">
      {%- if trd.state == 'scored' -%}
        <div class="trd-card">
          <div class="trd-card-k">{{ t('Win rate', '胜率') }}</div>
          <div class="trd-card-v trd-accented">{{ _st.get('win_rate_pct', '—') }}%</div>
          <div class="trd-card-m" data-tip-en="A win = a pick that left the board up more than 2% from its surfaced price. Flat names (within ±2%) don't count either way.{% if _st.get('wilson_lo_pct') is not none %} Typical range {{ _st.wilson_lo_pct }}–{{ _st.wilson_hi_pct }}% given {{ _st.get('n_resolved','') }} picks.{% endif %}" data-tip-zh="胜＝上榜后较上榜价上涨超过 2% 的标的。持平（±2% 以内）不计入任何一方。{% if _st.get('wilson_lo_pct') is not none %}按 {{ _st.get('n_resolved','') }} 笔样本，典型区间 {{ _st.wilson_lo_pct }}–{{ _st.wilson_hi_pct }}%。{% endif %}"><span class="l-en">resolved picks that rose</span><span class="l-zh">已了结且上涨的占比</span></div>
        </div>
        <div class="trd-card">
          <div class="trd-card-k">{{ t('Avg move', '平均涨跌') }}</div>
          <div class="trd-card-v {{ _up if (_st.get('avg_pct') or 0) >= 0 else _dn }}">{% if _st.get('avg_pct') is not none %}{{ '%+g'|format(_st.avg_pct) }}%{% else %}—{% endif %}</div>
          <div class="trd-card-m"><span class="l-en">surfaced price → latest, all resolved</span><span class="l-zh">上榜价→最新价，全部已了结</span></div>
        </div>
        <div class="trd-card trd-card-wide">
          <div class="trd-card-k">{{ t('Resolved', '已了结') }}</div>
          <div class="trd-card-v">{{ _st.get('n_resolved', '—') }}</div>
          {%- set _nu = _st.get('n_up', 0) or 0 -%}{%- set _ns = _st.get('n_stopped', 0) or 0 -%}{%- set _nf = _st.get('n_flat', 0) or 0 -%}{%- set _tot = (_nu + _ns + _nf) if (_nu + _ns + _nf) > 0 else 1 -%}
          <div class="trd-segbar" role="img" aria-label="up / flat / stopped mix">
            <span class="trd-seg trd-seg-up" data-w="{{ (100 * _nu / _tot)|round(1) }}" style="width:{{ (100 * _nu / _tot)|round(1) }}%"></span>
            <span class="trd-seg trd-seg-flat" data-w="{{ (100 * _nf / _tot)|round(1) }}" style="width:{{ (100 * _nf / _tot)|round(1) }}%"></span>
            <span class="trd-seg trd-seg-dn" data-w="{{ (100 * _ns / _tot)|round(1) }}" style="width:{{ (100 * _ns / _tot)|round(1) }}%"></span>
          </div>
          <div class="trd-seg-legend"><b class="trd-up">{{ _nu }}</b> {{ t('up', '涨') }} · {{ _nf }} {{ t('flat', '持平') }} · <b class="trd-dn">{{ _ns }}</b> {{ t('stopped', '止损') }}</div>
        </div>
        {%- if _st.get('n_onboard') is not none -%}
        <div class="trd-card">
          <div class="trd-card-k">{{ t('On board now', '目前在榜') }}</div>
          <div class="trd-card-v">{{ _st.n_onboard }}</div>
          <div class="trd-card-m"><span class="l-en">still riding, not yet resolved</span><span class="l-zh">仍在榜、尚未了结</span></div>
        </div>
        {%- endif -%}
      {%- elif trd.state == 'interim' -%}
        <div class="trd-card">
          <div class="trd-card-k"><span class="l-en">Ahead of {{ trd.bench_en or 'index' }}</span><span class="l-zh">暂跑赢{{ trd.bench_zh or '指数' }}</span></div>
          <div class="trd-card-v trd-accented">{{ _st.get('hit_pct', '—') }}%</div>
          <div class="trd-card-m" data-tip-en="Of logged picks, the share ahead of {{ trd.bench_en or 'the index' }} right now — unrealized.{% if _st.get('ci_lo_pct') is not none %} Range {{ _st.ci_lo_pct }}–{{ _st.ci_hi_pct }}%.{% endif %}" data-tip-zh="已记录标的中当前领先{{ trd.bench_zh or '指数' }}的占比——未实现。{% if _st.get('ci_lo_pct') is not none %}区间 {{ _st.ci_lo_pct }}–{{ _st.ci_hi_pct }}%。{% endif %}"><span class="l-en">of logged picks, right now</span><span class="l-zh">已记录标的中当前领先占比</span></div>
        </div>
        <div class="trd-card">
          <div class="trd-card-k">{{ t('Median edge', '超额中位') }}</div>
          <div class="trd-card-v {{ _up if (_st.get('median_excess_pct') or 0) >= 0 else _dn }}">{% if _st.get('median_excess_pct') is not none %}{{ '%+g'|format(_st.median_excess_pct) }}%{% else %}—{% endif %}</div>
          <div class="trd-card-m"><span class="l-en">vs {{ trd.bench_en or 'index' }} · unrealized</span><span class="l-zh">相对{{ trd.bench_zh or '指数' }} · 未实现</span></div>
        </div>
        <div class="trd-card">
          <div class="trd-card-k">{{ t('Logged', '已记录') }}</div>
          <div class="trd-card-v">{{ _st.get('n', '—') }}</div>
          <div class="trd-card-m"><span class="l-en">picks{% if _st.get('since') %} since {{ _st.since }}{% endif %}{% if _st.get('median_hold') is not none %} · median hold {{ _st.median_hold }} sessions{% endif %}</span><span class="l-zh">标的{% if _st.get('since') %}，自 {{ _st.since }} 起{% endif %}{% if _st.get('median_hold') is not none %} · 中位持有 {{ _st.median_hold }} 个交易日{% endif %}</span></div>
        </div>
      {%- else -%}
        <div class="trd-card">
          <div class="trd-card-k">{{ t('Calls logged', '已记录信号') }}</div>
          <div class="trd-card-v trd-accented">{{ _st.get('n_calls', '—') }}</div>
          <div class="trd-card-m"><span class="l-en">every board pick, stamped nightly</span><span class="l-zh">每晚记录在案</span></div>
        </div>
        <div class="trd-card">
          <div class="trd-card-k">{{ t('First read', '首次评分') }}</div>
          <div class="trd-card-v">{{ _st.get('first_read_est', '—') }}</div>
          <div class="trd-card-m"><span class="l-en">when 21-day grades mature</span><span class="l-zh">21日评分成熟之时</span></div>
        </div>
        <div class="trd-card trd-card-wide trd-tl">
          <div class="trd-card-k">{{ t('Building in public', '公开累积中') }}</div>
          <div class="trd-tl-bar"><span class="trd-tl-fill" style="width:22%"></span><span class="trd-tl-now" style="left:22%"></span></div>
          <div class="trd-tl-ends"><span>{{ _st.get('first_write', '—') }}</span><span>{{ _st.get('first_read_est', '—') }}</span></div>
          {%- if (_st.get('n_suspended') or 0) > 0 -%}
          <div class="trd-card-m" style="margin-top:6px"><span class="l-en">{{ _st.n_suspended }} suspended names excluded</span><span class="l-zh">{{ _st.n_suspended }} 只停牌股已剔除</span></div>
          {%- endif -%}
        </div>
      {%- endif -%}
      </div>{# /trd-cards #}
      </div>{# /stg-1 #}

      {#- ── Zone B — filter rail + ledger table (client-side, lazy) ────────── -#}
      <div class="trd-stg trd-stg-2">
      <div class="trd-rail" id="trd-rail" role="toolbar" aria-label="Filter ledger">
        <div class="trd-chips" id="trd-status-chips" data-market="{{ _m }}"></div>
        <input type="search" class="trd-search" id="trd-search" data-ph-en="Find a stock" data-ph-zh="搜索股票" aria-label="Find a stock">
        <div class="trd-chips" id="trd-window-chips"></div>
        {%- if _m == 'us' -%}<select class="trd-sel" id="trd-sector" aria-label="Sector"></select>{%- endif -%}
        <span class="trd-rail-grow"></span>
      </div>
      <div id="trd-tbl-mount">
        <div class="trd-err" style="display:none"></div>
      </div>
      <div class="trd-pg" id="trd-pg"></div>
      </div>{# /stg-2 #}
    </div>{# /trd-body #}

    {#- ── Zone C — footer (one merged note, one as-of) ──────────────────────-#}
    <div class="trd-ft">
      <div class="trd-ft-note"><span class="l-en">{{ trd.note_en }}{% if trd.as_of %} As of {{ trd.as_of }}.{% endif %}</span><span class="l-zh">{{ trd.note_zh }}{% if trd.as_of %} 截至 {{ trd.as_of }}。{% endif %}</span></div>
      {%- if trd.deep_link -%}
      <a class="trd-ft-link" href="{{ trd.deep_link }}"><span class="l-en">Methodology &amp; full history ↗</span><span class="l-zh">方法与完整历史 ↗</span></a>
      {%- endif -%}
    </div>
  </div>{# /trd-panel #}
</div>{# /trd-dlg #}
</div>{# /trd-wrap dialog band #}

<script>
(function(){
  var btn = document.getElementById('trd-btn');
  var dlg = document.getElementById('trd-dlg');
  if(!btn || !dlg || dlg.dataset.trdInit) return;
  dlg.dataset.trdInit = '1';
  var panel = dlg.querySelector('.trd-panel');
  var closeBtn = dlg.querySelector('.trd-close');
  var isZh = function(){ return document.documentElement.getAttribute('data-lang') === 'zh'; };
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var scrollY = 0, loaded = false, DATA = null;

  // ── open / close ──────────────────────────────────────────────────────────
  function open(){
    scrollY = window.scrollY || 0;
    dlg.classList.add('trd-open');
    document.documentElement.classList.add('trd-lock');
    document.body.style.top = (-scrollY) + 'px';
    btn.setAttribute('aria-expanded','true'); btn.classList.add('trd-is-open');
    requestAnimationFrame(function(){ requestAnimationFrame(function(){ dlg.classList.add('trd-in'); }); });
    (closeBtn || panel).focus();
    if(!loaded) loadLedger();
    animateCards();
  }
  function close(){
    dlg.classList.add('trd-closing'); dlg.classList.remove('trd-in');
    btn.setAttribute('aria-expanded','false'); btn.classList.remove('trd-is-open');
    var done = function(){
      dlg.classList.remove('trd-open','trd-closing');
      document.documentElement.classList.remove('trd-lock');
      document.body.style.top = '';
      window.scrollTo(0, scrollY);
      btn.focus();
      panel.removeEventListener('transitionend', done);
    };
    if(reduce){ done(); } else { var t=setTimeout(done, 260); panel.addEventListener('transitionend', function h(){ clearTimeout(t); done(); }, {once:true}); }
  }
  btn.addEventListener('click', function(){ dlg.classList.contains('trd-open') ? close() : open(); });
  dlg.querySelectorAll('[data-trd-close]').forEach(function(el){ el.addEventListener('click', close); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && dlg.classList.contains('trd-open')) close(); });
  // focus trap (lightweight)
  dlg.addEventListener('keydown', function(e){
    if(e.key !== 'Tab') return;
    var f = dlg.querySelectorAll('button,a[href],input,select,[tabindex]:not([tabindex="-1"])');
    f = Array.prototype.filter.call(f, function(x){ return x.offsetParent !== null; });
    if(!f.length) return;
    var first = f[0], last = f[f.length-1];
    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  });

  // ── count-up on verdict cards ─────────────────────────────────────────────
  var animated = false;
  function animateCards(){
    if(animated) return; animated = true;
    if(reduce) return;
    dlg.querySelectorAll('.trd-card-v').forEach(function(el){
      var final = el.textContent;
      var m = final.match(/^([+-]?)(\d+(?:\.\d+)?)(.*)$/);
      if(!m) return;
      var sign = m[1], target = parseFloat(m[2]), suffix = m[3], dec = (m[2].split('.')[1]||'').length;
      var t0 = null, dur = 600, running = true;
      // Safety net: if rAF never advances (throttled/background tab), snap to the
      // real value — the server-rendered number must never be left stuck at 0.
      var guard = setTimeout(function(){ if(running){ running = false; el.textContent = final; } }, dur + 120);
      function step(ts){ if(!running) return; if(!t0) t0 = ts; var p = Math.min((ts - t0)/dur, 1);
        var e = 1 - Math.pow(1 - p, 3); var v = (target * e).toFixed(dec);
        el.textContent = sign + v + suffix;
        if(p < 1){ requestAnimationFrame(step); } else { running = false; clearTimeout(guard); el.textContent = final; } }
      el.textContent = sign + '0' + (dec? '.'+'0'.repeat(dec):'') + suffix;
      requestAnimationFrame(step);
    });
    // segment bars grow from 0 via CSS transition. Snap back with a timeout guard
    // so a throttled rAF can never leave the bar collapsed at 0.
    dlg.querySelectorAll('.trd-seg').forEach(function(s){ var w = s.getAttribute('data-w'); s.style.width='0%';
      requestAnimationFrame(function(){ requestAnimationFrame(function(){ s.style.width = w + '%'; }); });
      setTimeout(function(){ s.style.width = w + '%'; }, 120); });
  }

  // ── ledger table ──────────────────────────────────────────────────────────
  var mount = document.getElementById('trd-tbl-mount');
  var pgEl = document.getElementById('trd-pg');
  var state = { status:'all', win:'all', q:'', sector:'all', sortKey:'d', sortDir:-1, page:1 };
  var PAGE = 25;
  var market = dlg.dataset.market, benchEn = dlg.dataset.benchEn, benchZh = dlg.dataset.benchZh;
  var upC = dlg.dataset.upClass || 'az-up', dnC = dlg.dataset.dnClass || 'az-dn';
  var T = { // tiny bilingual helper
    en:{ all:'All', up:'Up', stopped:'Stopped', flat:'Flat', early:'Early', matured:'Matured', suspended:'Suspended',
         beat:'Beat index', lag:'Lagged', onboard:'On board', stock:'Stock', logged:'Logged', entry:'Entry', latest:'Latest',
         move:'Move %', vs:'vs '+(benchEn||'index')+' %', days:'Days', status:'Status', find:'Find a stock',
         prev:'Prev', next:'Next', err:'Ledger unavailable right now — the numbers above are still current.', retry:'Retry',
         win90:'90d', win30:'30d', winall:'All', of:'of' },
    zh:{ all:'全部', up:'上涨', stopped:'止损', flat:'持平', early:'初期', matured:'已成熟', suspended:'停牌',
         beat:'跑赢', lag:'跑输', onboard:'在榜', stock:'个股', logged:'上榜', entry:'入场', latest:'最新',
         move:'涨跌', vs:'超额', days:'天数', status:'状态', find:'搜索股票',
         prev:'上一页', next:'下一页', err:'台账暂时不可用——上方数据仍然有效。', retry:'重试',
         win90:'90天', win30:'30天', winall:'全部', of:'共' }
  };
  function L(k){ return (isZh()? T.zh : T.en)[k]; }

  function statusChipDefs(){
    if(market === 'cn') return [['all','all'],['matured','matured'],['early','early']];
    if(market === 'us') return [['all','all'],['up','up'],['stopped','stopped'],['flat','flat']];
    return [['all','all'],['early','early']]; // hk/ca
  }
  function buildRail(){
    var host = document.getElementById('trd-status-chips'); host.innerHTML='';
    statusChipDefs().forEach(function(d){
      var b=document.createElement('button'); b.type='button'; b.className='trd-chip'; b.dataset.status=d[0];
      b.setAttribute('aria-pressed', d[0]===state.status ? 'true':'false');
      b.textContent = L(d[1]); b.dataset.k=d[1];
      b.addEventListener('click', function(){ state.status=d[0]; state.page=1; syncPressed(host,'status'); render(); });
      host.appendChild(b);
    });
    // suspended chip if any suspended rows exist
    var win = document.getElementById('trd-window-chips'); win.innerHTML='';
    [['all','winall'],['90d','win90'],['30d','win30']].forEach(function(d){
      var b=document.createElement('button'); b.type='button'; b.className='trd-chip'; b.dataset.win=d[0]; b.dataset.k=d[1];
      b.setAttribute('aria-pressed', d[0]===state.win ? 'true':'false'); b.textContent=L(d[1]);
      b.addEventListener('click', function(){ state.win=d[0]; state.page=1; syncPressed(win,'win'); render(); });
      win.appendChild(b);
    });
    var s = document.getElementById('trd-search'); if(s){ s.placeholder = L('find');
      var deb; s.addEventListener('input', function(){ clearTimeout(deb); deb=setTimeout(function(){ state.q=s.value.trim().toLowerCase(); state.page=1; render(); }, 150); }); }
    if(market === 'us'){ var sel=document.getElementById('trd-sector'); if(sel && DATA){
      var secs = {}; DATA.rows.forEach(function(r){ if(r.sec) secs[r.sec]=1; });
      var opts = '<option value="all">'+(isZh()?'全部板块':'All sectors')+'</option>';
      Object.keys(secs).sort().forEach(function(x){ opts += '<option value="'+esc(x)+'">'+esc(x)+'</option>'; });
      sel.innerHTML = opts;
      sel.value = state.sector; if(sel.value !== state.sector){ state.sector = 'all'; sel.value = 'all'; }
      if(!sel.dataset.trdWired){ sel.dataset.trdWired = '1';
        sel.addEventListener('change', function(){ state.sector=sel.value; state.page=1; render(); }); }
    }}
  }
  function syncPressed(host, attr){ host.querySelectorAll('.trd-chip').forEach(function(c){ c.setAttribute('aria-pressed', c.dataset[attr]===state[attr]?'true':'false'); }); }

  function loadLedger(){
    loaded = true;
    var url = dlg.dataset.url; if(!url){ showError(); return; }
    mount.innerHTML = skeleton();
    fetch(url, {cache:'no-cache'}).then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); })
      .then(function(j){ DATA = j; buildRail(); render(); })
      .catch(function(){ showError(); });
  }
  function skeleton(){
    var s = '<div class="trd-tbl-wrap" style="border:none"><div style="padding:4px">';
    for(var i=0;i<6;i++) s += '<div class="trd-skel trd-skel-row"></div>';
    return s + '</div></div>';
  }
  function showError(){
    mount.innerHTML = '<div class="trd-err">'+L('err')+'<br><button type="button" class="trd-retry">'+L('retry')+'</button></div>';
    var rb = mount.querySelector('.trd-retry'); if(rb) rb.addEventListener('click', function(){ loaded=false; loadLedger(); });
  }

  function filtered(){
    if(!DATA) return [];
    var now = DATA.as_of ? new Date(DATA.as_of) : new Date();
    return DATA.rows.filter(function(r){
      if(state.status !== 'all'){
        if(state.status === 'matured'){ if(!r.m) return false; }
        else if(state.status === 'early'){ if(r.st !== 'early' && r.m) return false; }
        else if(r.st !== state.status) return false;
      }
      if(state.sector !== 'all' && r.sec !== state.sector) return false;
      if(state.q){ var hay = ((r.t||'')+' '+(r.nm||'')).toLowerCase(); if(hay.indexOf(state.q) < 0) return false; }
      if(state.win !== 'all' && r.d){ var days = (now - new Date(r.d))/86400000; var lim = state.win==='90d'?90:30; if(days > lim) return false; }
      return true;
    });
  }
  function sorted(rows){
    var k = state.sortKey, dir = state.sortDir;
    return rows.slice().sort(function(a,b){
      var av=a[k], bv=b[k];
      if(k==='d'){ av = av||''; bv = bv||''; return av<bv?-dir:av>bv?dir:0; }
      av = (av==null)? -Infinity : av; bv = (bv==null)? -Infinity : bv;
      return (av-bv)*dir;
    });
  }
  var STDOT = { up:'trd-dot-up', stopped:'trd-dot-dn', flat:'trd-dot-flat', early:'trd-dot-early', beat:'trd-dot-up', lag:'trd-dot-dn', onboard:'trd-dot-flat' };
  function stWord(st){ var mp = { up:L('up'), stopped:L('stopped'), flat:L('flat'), early:L('early'), beat:L('beat'), lag:L('lag'), onboard:L('onboard') }; return mp[st]||st; }
  var FLAG = { locked:{en:'Locked-limit day excluded', zh:'一字板剔除'}, susp:{en:'Suspended', zh:'停牌'}, delisted:{en:'Delisted', zh:'退市'} };

  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function primaryCol(){ return (market==='us') ? 'p' : 'x'; } // CN/HK/CA grade on excess

  function render(){
    if(!DATA) return;
    var rows = sorted(filtered());
    var total = rows.length;
    var pages = Math.max(1, Math.ceil(total/PAGE));
    if(state.page > pages) state.page = pages;
    var start = (state.page-1)*PAGE;
    var pageRows = rows.slice(start, start+PAGE);
    var pcol = primaryCol();
    var moveHdr = (market==='us') ? L('move') : L('vs');
    var zh = isZh();
    var h = '<div class="trd-tbl-wrap"><table class="trd-tbl"><thead><tr>';
    h += '<th>'+L('stock')+'</th>';
    h += sortTh('d', L('logged'));
    h += '<th class="trd-num trd-mut">'+L('entry')+'</th>';
    h += '<th class="trd-num trd-mut">'+L('latest')+'</th>';
    h += sortTh(pcol, moveHdr, true);
    h += sortTh('dy', L('days'), true);
    h += '<th>'+L('status')+'</th>';
    h += '</tr></thead><tbody>';
    if(!pageRows.length){ h += '<tr><td colspan="7" class="trd-mut" style="text-align:center;padding:18px">'+(zh?'无匹配记录':'No matching rows')+'</td></tr>'; }
    pageRows.forEach(function(r, i){
      var mv = r[pcol];
      var mvCls = (mv==null)?'trd-mut':(mv>=0?upC:dnC);
      var mvTxt = (mv==null)?'—':((mv>=0?'+':'')+ (Math.round(mv*10)/10) + '%');
      var tk = esc(r.t);
      var tkInner = (market==='us') ? '<a href="stock.html#'+tk+'">'+tk+'</a>' : tk;
      var subInfo = r.sec || r.grp || '';
      var flags = (r.fl||[]).map(function(f){ var d=FLAG[f]; return d? '<span class="trd-flag" data-tip-en="'+d.en+'" data-tip-zh="'+d.zh+'">⚑</span>':''; }).join('');
      h += '<tr class="'+(reduce?'':'trd-anim')+'" style="'+(reduce?'':'animation-delay:'+Math.min(i,25)*12+'ms')+'">';
      h += '<td><span class="trd-tk">'+tkInner+'</span>'+flags+(subInfo?'<span class="trd-sub-cell">'+esc(subInfo)+'</span>':'')+'</td>';
      h += '<td class="trd-num trd-mut">'+esc(r.d||'—')+'</td>';
      h += '<td class="trd-num trd-mut">'+(r.e!=null?r.e:'—')+'</td>';
      h += '<td class="trd-num trd-mut">'+(r.l!=null?r.l:'—')+'</td>';
      h += '<td class="trd-num '+mvCls+'">'+mvTxt+'</td>';
      h += '<td class="trd-num trd-mut">'+(r.dy!=null?r.dy:'—')+'</td>';
      h += '<td><span class="trd-dot '+(STDOT[r.st]||'trd-dot-flat')+'"></span>'+stWord(r.st)+'</td>';
      h += '</tr>';
    });
    h += '</tbody></table></div>';
    mount.innerHTML = h;
    mount.querySelectorAll('th.trd-sortable').forEach(function(th){ th.addEventListener('click', function(){
      var k = th.dataset.k; if(state.sortKey===k){ state.sortDir *= -1; } else { state.sortKey=k; state.sortDir = -1; } render(); }); });
    renderPg(total, pages, start, pageRows.length);
  }
  function sortTh(key, label, num){
    var dir = state.sortKey===key ? (state.sortDir>0?'ascending':'descending') : 'none';
    var ar = state.sortKey===key ? (state.sortDir>0?'▲':'▼') : '▲▼';
    return '<th class="trd-sortable'+(num?' trd-num':'')+'" data-k="'+key+'" aria-sort="'+dir+'" tabindex="0" role="button">'+label+'<span class="trd-sort-ar">'+ar+'</span></th>';
  }
  function renderPg(total, pages, start, shown){
    var zh = isZh();
    var h = '<button type="button" class="trd-pg-btn" '+(state.page<=1?'disabled':'')+' data-pg="prev">‹ '+L('prev')+'</button>';
    var win = 5, half = Math.floor(win/2);
    var lo = Math.max(1, state.page-half), hi = Math.min(pages, lo+win-1); lo = Math.max(1, hi-win+1);
    if(lo>1){ h += pgNum(1); if(lo>2) h += '<span class="trd-pg-ell">…</span>'; }
    for(var p=lo;p<=hi;p++) h += pgNum(p);
    if(hi<pages){ if(hi<pages-1) h += '<span class="trd-pg-ell">…</span>'; h += pgNum(pages); }
    h += '<button type="button" class="trd-pg-btn" '+(state.page>=pages?'disabled':'')+' data-pg="next">'+L('next')+' ›</button>';
    var from = total? (start+1) : 0;
    h += '<span class="trd-pg-count">'+from+'–'+(start+shown)+' '+L('of')+' '+total+'</span>';
    pgEl.innerHTML = h;
    pgEl.querySelectorAll('.trd-pg-btn[data-pg]').forEach(function(b){ b.addEventListener('click', function(){
      var d=b.dataset.pg; if(d==='prev'&&state.page>1)state.page--; else if(d==='next'&&state.page<pages)state.page++; else if(!isNaN(+d))state.page=+d; render(); }); });
  }
  function pgNum(p){ return '<button type="button" class="trd-pg-btn" '+(p===state.page?'aria-current="page"':'')+' data-pg="'+p+'">'+p+'</button>'; }

  // re-render chips/labels on language flip so ZH copy stays live
  var langObs = new MutationObserver(function(){ if(DATA){ buildRail(); render(); } });
  langObs.observe(document.documentElement, {attributes:true, attributeFilter:['data-lang']});
})();
</script>
{%- endif %}
