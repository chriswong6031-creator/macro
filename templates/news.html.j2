{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{# ---- vm bindings (all null-safe) ---------------------------------------- #}
{% set heads       = (macro_news.headlines if macro_news and macro_news.headlines else []) %}
{% set SYN         = (macro_news.synthesis if macro_news and macro_news.synthesis else {}) %}
{% set SYN_CHANNELS = (SYN.top_channels if SYN.top_channels else []) %}
{% set SYN_TICKERS  = (SYN.top_tickers  if SYN.top_tickers  else []) %}
{# bilingual channel-slug labels from engine/macro_news.CHANNEL_LABEL — raw slugs
   never render on glance surfaces (doctrine Law 2); older cached payloads without
   the dict degrade to de-underscored words. #}
{% set CHL         = (macro_news.channel_label if macro_news and macro_news.channel_label else {}) %}
{% set RA_COND     = ((latest.conditions or {}).get('risk_appetite') or {} if latest and latest.conditions else {}) %}

{# financial_news: from vm (loaded by build_site from site/news/financial.json).
   Guard types — may be None/missing; all access via .get() #}
{% set _fn = financial_news if financial_news is mapping else {} %}
{% set _fn_market = (_fn.get('market') if _fn.get('market') is iterable and _fn.get('market') is not string else [])|select('mapping')|list %}
{% set _fn_mag7   = _fn.get('mag7') if _fn.get('mag7') is mapping else {} %}
{% set _fn_providers = _fn.get('providers') if _fn.get('providers') is mapping else {} %}
{% set _fn_polygon_ok = _fn_providers.get('polygon', False) %}

{# Split heads into event heads (Delta Board) and context heads (old accordion) #}
{% set ev_heads = [] %}
{% set ctx_heads = [] %}
{% for h in heads %}
  {% if h.get('event') %}
    {% set _ = ev_heads.append(h) %}
  {% else %}
    {% set _ = ctx_heads.append(h) %}
  {% endif %}
{% endfor %}
{# ZH-mode honesty: kept US-source headlines whose title_zh translation is missing
   (render-lane cache miss) fall back to the English original; disclose it. #}
{% set n_zh_missing = heads|rejectattr('title_zh')|list|length %}

{# macro_releases: from vm (loaded by build_site from site/news/macro_releases.json).
   Artifacts are sibling-wave JSON, so guard the pinned schema TYPES too: a valid-JSON
   artifact with cards as a string / non-mapping entries must degrade, not raise. #}
{% set releases = (macro_releases.get('cards') if macro_releases is mapping else none) %}
{% set releases = ((releases if releases is iterable and releases is not string else [])|select('mapping')|list) %}

{# rejected: from vm (loaded from site/news/rejected.json) #}
{% set rejected_all = [] %}
{% set _rej_feeds = (news_rejected.get('feeds') if news_rejected is mapping else none) %}
{% if _rej_feeds is mapping %}
  {% for feed_key in ['macro', 'financial', 'rss'] %}
    {% set feed_list = _rej_feeds.get(feed_key) %}
    {% set feed_list = ((feed_list if feed_list is iterable and feed_list is not string else [])|select('mapping')|list) %}
    {% for r in feed_list %}{% set _ = rejected_all.append(r) %}{% endfor %}
  {% endfor %}
{% endif %}

{# calibration: from vm (loaded from site/news/calibration.json) — may be absent (W4 not yet live) #}
{% set calib = news_calibration if news_calibration is mapping and news_calibration else None %}
{% set calib_classes = (calib.get('classes') if calib else none) %}
{% set calib_classes = ((calib_classes if calib_classes is iterable and calib_classes is not string else [])|select('mapping')|list) %}

{# Executive counters #}
{% set n_events    = ev_heads|length %}
{% set n_releases  = releases|length %}
{% set n_rejected  = rejected_all|length %}
{% set n_context   = ctx_heads|length %}
{% set n_src = (heads|map(attribute='domain')|reject('none')|unique|list|length) if heads else 0 %}

{# dominant reject reason — most common reason in the rejected list #}
{% set _rej_reason = namespace(top='') %}
{% if rejected_all %}
  {% set _rej_counts = namespace(d={}) %}
  {% for r in rejected_all %}
    {% set reason = r.get('reason') or 'unknown' %}
    {% set cur = _rej_counts.d.get(reason, 0) %}
    {% set _ = _rej_counts.d.update({reason: cur + 1}) %}
  {% endfor %}
  {% set _max = namespace(v=0) %}
  {% for reason, cnt in _rej_counts.d.items() %}
    {% if cnt > _max.v %}{% set _max.v = cnt %}{% set _rej_reason.top = reason %}{% endif %}
  {% endfor %}
{% endif %}

{# theme labels #}
{% set TL = {'monetary':['Fed','美联储'],'inflation':['Inflation','通胀'],'labor':['Labor','就业'],'growth':['Growth','增长'],'credit':['Rates','利率'],'fiscal':['Fiscal','财政'],'earnings':['Earnings','业绩'],'guidance':['Guidance','指引'],'analyst':['Analysts','分析师'],'deals':['Deals','并购/IPO'],'capital_return':['Buybacks','回购/分红'],'stocks':['Stocks','个股'],'macro':['Macro','宏观']} %}

{# event-type labels — keys mirror engine/news_events.py _EVENT_CLASSES names #}
{% set EVL = {'earnings_result':['Earnings Result','财报发布'],'preannouncement':['Preannouncement','业绩预告'],'guidance_raise':['Guidance Raise','上调指引'],'guidance_cut':['Guidance Cut','下调指引'],'analyst_estimate_revision':['Estimate Revision','盈测调整'],'rating_change':['Rating Change','评级变动'],'mna_confirmed':['M&amp;A Confirmed','并购确认'],'mna_rumor':['M&amp;A Rumor','并购传闻'],'equity_offering':['Equity Offering','股票增发'],'buyback':['Buyback','股票回购'],'dividend_change':['Dividend Change','股息变动'],'contract_award':['Contract Award','合同中标'],'customer_win':['Customer Win','赢得客户'],'customer_loss':['Customer Loss','客户流失'],'product_launch':['Product Launch','产品发布'],'product_delay':['Product Delay','产品延期'],'management_change':['Management Change','管理层变动'],'activist_campaign':['Activist','股东维权'],'litigation':['Litigation','诉讼'],'regulatory_probe':['Regulatory Probe','监管调查'],'bankruptcy_restructuring':['Restructuring','破产重组'],'policy_trade_control':['Trade Controls','贸易管制'],'macro_release':['Macro Release','宏观数据']} %}

{# source-tier labels #}
{% set TIERL = {'official':['Official','官方'],'tier1':['Tier 1','一级来源'],'quality':['Quality','精选来源'],'stock_wire':['Wire','快讯']} %}

{# centrality labels — NEWS-DD-06 #}
{% set CENTRL = {'primary':['Central','核心'],'secondary':['Secondary','次要'],'incidental':['Incidental','附带']} %}

{# reject-reason label dict — NEWS-DD-06/07
   Full vocabulary from engine/news_common.py low_value_reason() plus families being added.
   Unknown slugs get a prettified fallback — never block render on a missing key. #}
{% set REJL = {
  'empty_title':              ['Empty title','标题为空'],
  'pickmill_byline':          ['Pick-mill author','选股文章作者'],
  'stock_pick_roundup':       ['Stock pick list','选股清单'],
  'calendar_preview':         ['Calendar preview','日历预览'],
  'routine_fund_distribution':['Fund distribution notice','基金分配公告'],
  'lifestyle_content':        ['Lifestyle content','生活类内容'],
  'personal_finance_advice':  ['Personal finance advice','个人理财建议'],
  'macro_release_stub':       ['Bare release title','无正文的数据发布'],
  'analyst_report_stub':      ['Analyst report stub','模板化分析师报告'],
  'dividend_declaration_stub':['Dividend declaration','股息公告'],
  'morning_aggregator':       ['Morning aggregator','早间汇总'],
  'duplicate':                ['Duplicate','重复'],
  'low_quality':              ['Low quality','质量不足'],
  'paywall':                  ['Paywalled','付费墙'],
  'generic_recap':            ['Generic recap','通用回顾'],
  'unknown':                  ['Other','其他']
} %}

{# ---- direction helpers --------------------------------------------------- #}
{% macro dir_badge(direction) %}
  {% if direction == 'bullish' %}<span class="nb-dir bull">{{ t('Bullish','利多') }}</span>
  {% elif direction == 'bearish' %}<span class="nb-dir bear">{{ t('Bearish','利空') }}</span>
  {% elif direction == 'mixed' %}<span class="nb-dir mix">{{ t('Mixed','多空交织') }}</span>
  {% else %}<span class="nb-dir info">{{ t('Info','信息') }}</span>{% endif %}
{% endmacro %}

{# NEWS-DD-03: plain-word novelty label; numeric z moves to data-tip #}
{% macro fmt_nov(v) %}
  {% if v is not none and v != '' %}
    {% set fv = v|float %}
    {% set fabs = fv|abs %}
    {% if fabs > 1.5 %}
      {% set cls = 'nov-high' %}{% set en_lbl = 'Unusual' %}{% set zh_lbl = '罕见' %}
    {% elif fabs > 0.75 %}
      {% set cls = 'nov-mid' %}{% set en_lbl = 'Notable' %}{% set zh_lbl = '值得注意' %}
    {% else %}
      {% set cls = 'nov-low' %}{% set en_lbl = 'Routine' %}{% set zh_lbl = '常规' %}
    {% endif %}
    <span class="{{ cls }}" data-tip-en="z={{ '%+.2f'|format(fv) }}" data-tip-zh="z={{ '%+.2f'|format(fv) }}">
      <span class="l-en">{{ en_lbl }}</span><span class="l-zh">{{ zh_lbl }}</span></span>
  {% else %}—{% endif %}
{% endmacro %}

{% block title %}News Intelligence Boards — Market &amp; Macro Deltas{% endblock %}

{% block base_css %}
  body { padding-bottom:52px; }
  @media(min-width:1180px){ body{ padding-left:max(18px,calc((100vw - 1240px)/2)); padding-right:max(18px,calc((100vw - 1240px)/2)); } }
  .nx-shell { max-width:1200px; margin:0 auto; }

  /* ---- page header ---- */
  .nx-head { display:flex; flex-wrap:wrap; align-items:flex-end; gap:14px 20px; margin:22px 0 18px; }
  .nx-title { font-size:30px; font-weight:800; letter-spacing:-.02em; margin:0; line-height:1.05; }
  html[data-lang="zh"] .nx-title { letter-spacing:0; }
  .nx-sub { color:var(--muted); font-size:13px; margin:6px 0 0; max-width:70ch; line-height:1.55; }
  .disc-note { color:var(--muted); font-size:11.5px; margin:4px 0 0; max-width:70ch; line-height:1.5; font-style:italic; }

  /* ---- executive read strip ---- */
  .exec-strip { display:flex; flex-wrap:wrap; gap:10px; margin:0 0 20px; }
  .exec-chip { background:var(--panel); border:1px solid var(--line); border-radius:8px;
               padding:8px 14px; display:flex; align-items:center; gap:8px; }
  .exec-chip .ec-n { font-size:18px; font-weight:800; font-variant-numeric:tabular-nums; min-width:28px; }
  .exec-chip .ec-l { font-size:11.5px; color:var(--muted); line-height:1.3; }
  .exec-chip.ev .ec-n { color:var(--link); }
  .exec-chip.rel .ec-n { color:var(--up); }
  .exec-chip.rej .ec-n { color:var(--warn); }
  .exec-chip.ctx .ec-n { color:var(--muted); }
  .exec-line { flex:1 1 100%; color:var(--muted); font-size:12.5px; padding:5px 0; align-self:center; }

  /* ---- board container ---- */
  .board { background:var(--panel); border:1px solid var(--line); border-radius:12px;
           box-shadow:var(--card-shadow); overflow:hidden; margin-bottom:20px; }
  .board-head { display:flex; align-items:center; gap:10px; padding:14px 18px 12px;
                border-bottom:1px solid var(--line); }
  .board-head h2 { font-size:14px; font-weight:800; margin:0; text-transform:none;
                   letter-spacing:0; color:var(--text); }
  .board-badge { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
                 padding:2px 8px; border-radius:6px; border:1px solid var(--line);
                 background:var(--panel2); color:var(--muted); }
  .board-count { margin-left:auto; color:var(--muted); font-size:12px; font-variant-numeric:tabular-nums; }
  .board-note { color:var(--muted); font-size:11.5px; padding:10px 18px; border-bottom:1px solid var(--line); }
  .board-stance { color:var(--muted); font-size:11.5px; font-style:italic;
                  padding:8px 18px; border-bottom:1px solid var(--line); background:color-mix(in srgb,var(--link) 3%,var(--panel)); }
  .board-empty { padding:28px 20px; text-align:center; color:var(--muted); font-size:13px; }
  /* aged-item chip (NEWS-DD-02) */
  .ev-aged { font-size:10px; color:var(--muted); border:1px solid var(--line);
             border-radius:5px; padding:1px 6px; vertical-align:middle; }
  /* ? help tip button (NEWS-DD-04/08) */
  .help-tip { display:inline-flex; align-items:center; justify-content:center;
              width:16px; height:16px; border-radius:50%; border:1px solid var(--line);
              color:var(--muted); font-size:10px; font-weight:700; cursor:default;
              vertical-align:middle; margin-left:5px; user-select:none; }

  /* ---- collapsible board wrapper ---- */
  .board-toggle > summary { list-style:none; cursor:pointer; }
  .board-toggle > summary::-webkit-details-marker { display:none; }
  .bh-arrow { color:var(--muted); font-size:11px; transition:transform .2s; margin-left:auto; }
  .board-toggle[open] .bh-arrow { transform:rotate(180deg); }

  /* ---- event card (Delta Board) ---- */
  .ev-card { border-bottom:1px solid var(--line); padding:13px 18px; }
  .ev-card:last-child { border-bottom:0; }
  .ev-card-top { display:flex; flex-wrap:wrap; gap:8px; align-items:flex-start; }
  .ev-title { font-size:14px; font-weight:650; line-height:1.35; flex:1 1 300px; min-width:0; }
  .ev-title a { color:var(--text); }
  .ev-title a:hover { color:var(--link); }
  .ev-badges { display:flex; flex-wrap:wrap; gap:5px; align-items:center; flex-shrink:0; }
  .nb-event { font-size:10px; font-weight:800; padding:2px 8px; border-radius:6px;
              --c:var(--link); color:color-mix(in srgb,var(--c) 90%,var(--text));
              border:1px solid color-mix(in srgb,var(--c) 45%,var(--line));
              background:color-mix(in srgb,var(--c) 12%,var(--panel)); white-space:nowrap; }
  /* event badge colours — keyed to engine/news_events.py _EVENT_CLASSES names */
  .ev-guidance_cut{--c:#e04040} .ev-guidance_raise{--c:#3aaa6a} .ev-preannouncement{--c:#e08b45}
  .ev-earnings_result{--c:#5ab6b0} .ev-analyst_estimate_revision{--c:#7aa7e0}
  .ev-rating_change{--c:#7aa7e0} .ev-contract_award{--c:#3aaa6a}
  .ev-customer_win{--c:#3aaa6a} .ev-customer_loss{--c:#e04040}
  .ev-product_launch{--c:#9cbf5a} .ev-product_delay{--c:#e04040}
  .ev-management_change{--c:#e0a030} .ev-regulatory_probe{--c:#e04040}
  .ev-litigation{--c:#e04040} .ev-equity_offering{--c:#e08b45} .ev-buyback{--c:#7aa7e0}
  .ev-dividend_change{--c:#e0a030} .ev-mna_confirmed{--c:#d45f88} .ev-mna_rumor{--c:#a78bfa}
  .ev-activist_campaign{--c:#a78bfa} .ev-macro_release{--c:#5ab6b0}
  .ev-policy_trade_control{--c:#e08b45} .ev-bankruptcy_restructuring{--c:#e04040}
  .nb-dir { font-size:10px; font-weight:700; padding:2px 7px; border-radius:6px;
            border:1px solid var(--line); white-space:nowrap; }
  .nb-dir.bull { color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,var(--line)); background:color-mix(in srgb,var(--up) 8%,var(--panel)); }
  .nb-dir.bear { color:var(--down); border-color:color-mix(in srgb,var(--down) 45%,var(--line)); background:color-mix(in srgb,var(--down) 8%,var(--panel)); }
  .nb-dir.mix  { color:var(--warn); border-color:color-mix(in srgb,var(--warn) 45%,var(--line)); background:color-mix(in srgb,var(--warn) 8%,var(--panel)); }
  .nb-dir.info { color:var(--muted); }
  .ev-meta { display:flex; flex-wrap:wrap; gap:10px; margin:7px 0 0; font-size:11.5px; color:var(--muted); }
  .ev-meta .em-item { display:flex; align-items:center; gap:4px; }
  .ev-meta .em-k { font-size:10px; text-transform:uppercase; letter-spacing:.04em; }
  .ev-meta .em-v { font-weight:600; color:var(--text); }
  .nov-high { color:var(--link); font-weight:700; }
  .nov-mid  { color:var(--text); font-weight:600; }
  .nov-low  { color:var(--muted); }
  .ev-nums  { display:flex; flex-wrap:wrap; gap:6px; margin:6px 0 0; }
  .ev-num-pill { font-size:11px; font-weight:700; padding:2px 8px; border-radius:6px;
                 border:1px solid var(--line); background:var(--panel2); color:var(--text); }
  .ev-theme-pill { font-size:10px; font-weight:700; padding:2px 7px; border-radius:999px;
                   --c:var(--link); color:color-mix(in srgb,var(--c) 84%,var(--text));
                   border:1px solid color-mix(in srgb,var(--c) 40%,var(--line));
                   background:color-mix(in srgb,var(--c) 10%,var(--panel)); }
  .th-monetary{--c:#7aa7e0}.th-inflation{--c:#e08b45}.th-labor{--c:#45b873}.th-growth{--c:#9cbf5a}
  .th-credit{--c:#a78bfa}.th-fiscal{--c:#e0a030}.th-earnings{--c:#45b873}.th-guidance{--c:#e08b45}
  .th-analyst{--c:#7aa7e0}.th-deals{--c:#d45f88}.th-capital_return{--c:#e0a030}
  .th-stocks{--c:#5ab6b0}.th-macro{--c:var(--muted)}
  .tier-badge { font-size:10px; padding:2px 6px; border-radius:5px; border:1px solid var(--line);
                color:var(--muted); background:var(--panel2); }
  .tier-1 { color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,var(--line)); }
  .tier-2 { color:var(--link); border-color:color-mix(in srgb,var(--link) 40%,var(--line)); }

  /* ---- macro release card ---- */
  .rel-card { border-bottom:1px solid var(--line); padding:13px 18px; }
  .rel-card:last-child { border-bottom:0; }
  .rel-top { display:flex; flex-wrap:wrap; gap:8px; align-items:flex-start; margin-bottom:6px; }
  .rel-name { font-size:14px; font-weight:700; flex:1 1 200px; }
  .rel-size { font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:6px; border:1px solid var(--line); }
  .sz-large   { color:var(--down);  border-color:color-mix(in srgb,var(--down) 45%,var(--line));  background:color-mix(in srgb,var(--down) 8%,var(--panel)); }
  .sz-notable { color:var(--warn);  border-color:color-mix(in srgb,var(--warn) 45%,var(--line));  background:color-mix(in srgb,var(--warn) 8%,var(--panel)); }
  .sz-inline  { color:var(--muted); }
  .rel-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:8px; margin-top:4px; }
  .rel-cell { background:var(--panel2); border:1px solid var(--line); border-radius:7px; padding:7px 10px; }
  .rel-cell .rck { font-size:10px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
  .rel-cell .rcv { font-size:14px; font-weight:700; margin-top:2px; font-variant-numeric:tabular-nums; }
  .rel-cell .rcsub { font-size:11px; color:var(--muted); margin-top:1px; }
  .rel-summary { font-size:12.5px; color:var(--muted); margin-top:6px; line-height:1.5; font-style:italic; }
  .rel-dir-bull { color:var(--up); } .rel-dir-bear { color:var(--down); } .rel-dir-neutral { color:var(--muted); }

  /* ---- theme pulse ---- */
  .pulse-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:10px; padding:14px 18px; }
  .pulse-cell { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; }
  .pulse-cell .pt-label { font-size:11.5px; font-weight:700; margin-bottom:4px; }
  .pulse-cell .pt-count { font-size:20px; font-weight:800; font-variant-numeric:tabular-nums; }
  .pulse-cell .pt-meta { font-size:10.5px; color:var(--muted); margin-top:2px; }
  .pulse-cell .pt-bar { height:3px; border-radius:2px; background:var(--link); opacity:.5; margin-top:5px; }

  /* ---- context accordion (demoted) ---- */
  .na-item { border-bottom:1px solid var(--line); }
  .na-item:last-of-type { border-bottom:0; }
  .na-item[open] { background:color-mix(in srgb,var(--link) 4%,transparent); }
  .na-sum { list-style:none; cursor:pointer; display:grid; grid-template-columns:auto minmax(0,1fr) auto;
            align-items:center; gap:11px; padding:11px 18px; }
  .na-sum::-webkit-details-marker { display:none; }
  .na-sum:hover { background:color-mix(in srgb,var(--link) 5%,transparent); }
  .na-theme { display:inline-flex; align-items:center; padding:2px 8px; border-radius:999px; font-size:10px;
              font-weight:800; white-space:nowrap;
              --c:var(--link); color:color-mix(in srgb,var(--c) 84%,var(--text));
              border:1px solid color-mix(in srgb,var(--c) 40%,var(--line));
              background:color-mix(in srgb,var(--c) 12%,var(--panel)); }
  .na-htitle { font-size:13.5px; font-weight:600; line-height:1.35; color:var(--text); min-width:0; }
  .na-right { display:inline-flex; align-items:center; gap:8px; white-space:nowrap; }
  .na-src { color:var(--muted); font-size:11px; }
  .na-chev { color:var(--muted); font-size:11px; transition:transform .2s; }
  .na-item[open] .na-chev { transform:rotate(180deg); }
  .na-body { padding:0 18px 13px; display:grid; gap:8px; }
  .na-summary { font-size:13px; line-height:1.55; color:var(--text); margin:0; max-width:74ch; }
  .na-tags { display:flex; flex-wrap:wrap; gap:5px; }
  .na-pill { display:inline-flex; align-items:center; gap:3px; border:1px solid var(--line);
             border-radius:6px; padding:2px 7px; font-size:10px; color:var(--muted); background:var(--panel2); }
  .na-pill.tk { color:var(--link); border-color:color-mix(in srgb,var(--link) 40%,var(--line)); }
  .na-read { justify-self:start; color:var(--link); font-size:12px; font-weight:700; }
  .na-when { color:var(--muted); font-size:11px; }
  /* ZH-mode note for untranslated headlines (NWS-04) */
  .na-zh-note { display:none; }
  html[data-lang="zh"] .na-zh-note { display:block; color:var(--muted); font-size:11px;
    padding:6px 18px 10px; font-style:italic; }

  /* ---- reject log ---- */
  .rej-group { border-bottom:1px solid var(--line); }
  .rej-group:last-child { border-bottom:0; }
  .rej-group-head { display:flex; align-items:center; gap:10px; padding:9px 18px; }
  .rej-reason { font-size:11.5px; font-weight:700; color:var(--warn);
                border:1px solid color-mix(in srgb,var(--warn) 40%,var(--line));
                background:color-mix(in srgb,var(--warn) 8%,var(--panel));
                border-radius:6px; padding:2px 8px; }
  .rej-group-count { font-size:11px; color:var(--muted); }
  .rej-table { width:100%; border-collapse:collapse; font-size:12px; }
  .rej-table th { font-size:10px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted);
                  font-weight:700; padding:4px 18px; text-align:left; border-bottom:1px solid var(--line); }
  .rej-table td { padding:5px 18px; border-bottom:1px solid var(--line); color:var(--text); }
  .rej-table tr:last-child td { border-bottom:0; }
  .rej-table .rt-dom { color:var(--muted); font-size:11px; }
  .rej-cap-note { color:var(--muted); font-size:11px; padding:6px 18px; font-style:italic; }

  /* ---- calibration board ---- */
  .calib-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:10px; padding:14px 18px; }
  .calib-cell { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; }
  .calib-cell .cc-event { font-size:11px; font-weight:700; margin-bottom:3px; color:var(--text); }
  .calib-cell .cc-verdict { font-size:10px; font-weight:800; padding:2px 7px; border-radius:6px;
                             border:1px solid var(--line); display:inline-block; margin-bottom:5px; }
  .vd-insuf  { color:var(--muted); }
  .vd-cand   { color:var(--up);   border-color:color-mix(in srgb,var(--up)   45%,var(--line)); background:color-mix(in srgb,var(--up)   8%,var(--panel)); }
  .vd-noedge { color:var(--down); border-color:color-mix(in srgb,var(--down) 45%,var(--line)); background:color-mix(in srgb,var(--down) 8%,var(--panel)); }
  .vd-ctx    { color:var(--link); border-color:color-mix(in srgb,var(--link) 45%,var(--line)); background:color-mix(in srgb,var(--link) 8%,var(--panel)); }
  .calib-cell .cc-n   { font-size:11px; color:var(--muted); }
  .calib-cell .cc-row { display:flex; gap:10px; flex-wrap:wrap; font-size:11px; color:var(--muted); margin-top:3px; }
  .calib-cell .cc-hit { font-weight:700; color:var(--text); }
  .calib-accruing { padding:20px 20px; text-align:center; color:var(--muted); font-size:13px; }

  /* ---- financial wires board (NWS-05) ---- */
  .mag7-row { display:flex; flex-wrap:wrap; gap:8px; padding:12px 18px; border-bottom:1px solid var(--line); }
  .mag7-chip { display:inline-flex; align-items:center; gap:5px; background:var(--panel2);
               border:1px solid var(--line); border-radius:6px; padding:4px 10px; font-size:11.5px; }
  .mag7-chip .m7t { font-weight:800; color:var(--link); }
  .mag7-chip .m7n { color:var(--muted); font-size:10.5px; }
  .fn-degraded { color:var(--warn); font-size:11.5px; padding:10px 18px; font-style:italic;
                 border-bottom:1px solid var(--line); }

  /* ---- rail ---- */
  .news-layout { display:grid; grid-template-columns:minmax(0,1fr) 310px; gap:20px; align-items:start; }
  .rail { display:grid; gap:14px; position:sticky; top:12px; }
  .rail-card { background:var(--panel); border:1px solid var(--line); border-radius:10px;
               box-shadow:var(--card-shadow); padding:15px; }
  .rail-card h2 { margin:0 0 10px; font-size:11.5px; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); }
  html[data-lang="zh"] .rail-card h2 { letter-spacing:0; }
  .rail-line { display:flex; gap:9px; align-items:flex-start; padding:7px 0; border-bottom:1px solid var(--line); }
  .rail-line:last-child { border-bottom:0; }
  .rail-date { flex:0 0 64px; color:var(--muted); font-size:11px; font-variant-numeric:tabular-nums; }
  .rail-main { min-width:0; font-size:12px; line-height:1.4; }
  .rail-tag { display:inline-flex; align-items:center; justify-content:center; min-width:38px;
              padding:1px 6px; border-radius:6px; border:1px solid var(--line);
              color:var(--link); font-size:10px; font-weight:800; margin-right:4px; }
  .odds-row { display:grid; grid-template-columns:1fr auto auto; gap:8px; align-items:baseline;
              font-size:12px; padding:3px 0; }
  .odds-row .o { color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .r-pos { color:var(--up); font-size:11px; } .r-neg { color:var(--down); font-size:11px; }
  .mut { color:var(--muted); font-size:12px; }
  .hidden { display:none !important; }

  @media(max-width:900px){
    .news-layout { grid-template-columns:1fr; }
    .rail { position:static; }
  }
  @media(max-width:560px){
    .nx-title { font-size:24px; }
    .na-sum { grid-template-columns:auto minmax(0,1fr); }
    .na-right { grid-column:1/-1; justify-content:flex-start; }
    .exec-strip { gap:8px; }
  }
{% endblock %}

{% block content %}
<main class="nx-shell">

  {# ---- page header ---- #}
  <header class="nx-head">
    <div>
      <h1 class="nx-title">{{ t('News Intelligence Boards', '新闻情报面板') }}</h1>
      <p class="nx-sub">{{ t(
        'Structured macro &amp; market deltas — event-typed headlines, parsed data releases, theme intensity and the full reject log. Context layer only; nothing here feeds any score or allocation.',
        '结构化宏观与市场变化 — 事件分类头条、已解析数据发布、主题强度及完整筛出日志。仅为背景层；任何内容均不进入评分或配置。') }}</p>
      {% if macro_news_disclaimer %}
      <p class="disc-note"><span class="l-en">{{ macro_news_disclaimer }}</span><span class="l-zh">{{ macro_news_disclaimer_zh or macro_news_disclaimer }}</span></p>
      {% endif %}
    </div>
  </header>

  {# ---- executive read strip ---- #}
  {# <!-- nx-exec-strip --> #}
  <div class="exec-strip">
    <div class="exec-chip ev">
      <span class="ec-n">{{ n_events }}</span>
      <span class="ec-l">{{ t('Event<br>deltas', '事件<br>变化') }}</span>
    </div>
    <div class="exec-chip rel">
      <span class="ec-n">{{ n_releases }}</span>
      <span class="ec-l">{{ t('Parsed<br>releases', '已解析<br>数据发布') }}</span>
    </div>
    <div class="exec-chip rej">
      <span class="ec-n">{{ n_rejected }}</span>
      {# NEWS-DD-07: translate the top reject reason slug in the exec strip #}
      {% set _top_rej_lbl = REJL.get(_rej_reason.top) %}
      <span class="ec-l l-en">{{ n_rejected }} filtered out{% if _rej_reason.top %} (top: {% if _top_rej_lbl %}{{ _top_rej_lbl[0] }}{% else %}{{ _rej_reason.top|replace('_',' ') }}{% endif %}){% endif %}</span>
      <span class="ec-l l-zh">{{ n_rejected }} 条已筛出{% if _rej_reason.top %}（主因：{% if _top_rej_lbl %}{{ _top_rej_lbl[1] }}{% else %}{{ _rej_reason.top|replace('_',' ') }}{% endif %}）{% endif %}</span>
    </div>
    <div class="exec-chip ctx">
      <span class="ec-n">{{ n_context }}</span>
      <span class="ec-l">{{ t('Other macro<br>headlines', '其他宏观<br>头条') }}</span>
    </div>
    {% if n_src > 0 or (macro_news and macro_news.n_raw) %}
    <span class="exec-line">
      <span class="l-en">
        {{ n_src }} source{{ 's' if n_src != 1 else '' }}
        {% if macro_news and macro_news.n_raw %} · {{ macro_news.n_raw }} scanned · {{ macro_news.n_kept or heads|length }} kept{% endif %}
        {% if macro_news and macro_news.fetched_at %} · <span class="rel-time" data-ts="{{ macro_news.fetched_at }}"></span>{% endif %}
      </span>
      <span class="l-zh">
        {{ n_src }} 个来源
        {% if macro_news and macro_news.n_raw %} · {{ macro_news.n_raw }} 条已扫描 · {{ macro_news.n_kept or heads|length }} 条保留{% endif %}
      </span>
    </span>
    {% endif %}
  </div>

  <div class="news-layout">
    <div>

      {# ==================================================================== #}
      {# A. DELTA BOARD — event-typed headlines                               #}
      {# <!-- nx-delta-board --> #}
      {# ==================================================================== #}
      <section class="board" id="nxDeltaBoard">
        <div class="board-head">
          <h2>{{ t('Event Delta Board', '事件变化面板') }}</h2>
          <span class="board-badge">{{ t('DELTA DESK', '变化台') }}</span>
          <span class="board-count">{{ n_events }} {{ t('events', '事件') }}</span>
        </div>
        {# NEWS-DD-08: one plain sentence note #}
        <div class="board-note">
          <span class="l-en">Headlines with a detected corporate or macro event, most recent first; items more than 5 days old are flagged.</span>
          <span class="l-zh">检测到企业或宏观事件的头条，最新优先；超过5天的条目会标注提示。{% if n_zh_missing > 0 %}部分标题来自英文信源，暂以原文显示。{% endif %}</span>
        </div>
        {# NEWS-DD-01: stance line — Delta Board #}
        <div class="board-stance">
          <span class="l-en">Background read — check what's happening, don't chase these headlines.</span>
          <span class="l-zh">背景阅读 — 了解动态，不必追随这些头条。</span>
        </div>
        {% if ev_heads %}
          {% for h in ev_heads %}
          {# NEWS-DD-02: aged chip — flag cards older than 5 days #}
          {% set _is_aged = namespace(v=False) %}
          {% if h.get('seendate') %}
            {# age check: seendate prefix compare against today approximation; JS handles display #}
            {# We use a CSS class on the card; JS fills the chip text dynamically #}
          {% endif %}
          {# <!-- ev-card --> #}
          <div class="ev-card" data-seendate="{{ h.get('seendate','') }}">
            <div class="ev-card-top">
              <div class="ev-title">
                {% if h.get('url') %}
                  <a href="{{ h.url }}" target="_blank" rel="noopener"><span class="l-en">{{ h.title }}</span><span class="l-zh">{{ h.get('title_zh') or h.title }}</span></a>
                {% else %}
                  <span class="l-en">{{ h.title }}</span><span class="l-zh">{{ h.get('title_zh') or h.title }}</span>
                {% endif %}
                {# aged chip injected by JS; placeholder hidden until JS runs #}
                <span class="ev-aged" style="display:none" data-aged-en="older item" data-aged-zh="较早消息"></span>
              </div>
              <div class="ev-badges">
                {% if h.get('event') %}
                  {% set ev = h.event %}
                  {% set _ev_type = ev.get('event_type') or ev.get('name','') %}
                  {% set _evl = EVL.get(_ev_type) %}
                  <span class="nb-event ev-{{ _ev_type }}">{% if _evl %}{{ t(_evl[0], _evl[1]) }}{% else %}{{ _ev_type|replace('_',' ')|title }}{% endif %}</span>
                  {{ dir_badge(ev.get('direction','')) }}
                {% endif %}
                {% if h.get('theme') %}
                  <span class="ev-theme-pill th-{{ h.theme }}">{{ t(TL.get(h.theme, [h.theme,h.theme])[0], TL.get(h.theme, [h.theme,h.theme])[1]) }}</span>
                {% endif %}
              </div>
            </div>
            {# meta row #}
            <div class="ev-meta">
              <span class="em-item">
                <span class="em-k">{{ t('Novelty','新颖度') }}</span>
                {# NEWS-DD-03: plain-word novelty label; numeric z in data-tip #}
                <span class="em-v">{{ fmt_nov(h.get('novelty_z')) }}</span>
              </span>
              {# NEWS-DD-06: centrality — show plain label, not raw slug #}
              {% if h.get('centrality') and h.centrality != 'incidental' %}
              <span class="em-item">
                <span class="em-k">{{ t('Focus','聚焦') }}</span>
                {% set _cl = CENTRL.get(h.centrality) %}
                <span class="em-v">{% if _cl %}{{ t(_cl[0], _cl[1]) }}{% else %}{{ h.centrality|replace('_',' ')|title }}{% endif %}</span>
              </span>
              {% endif %}
              {% if h.get('echo') %}
                {% set echo = h.echo %}
                <span class="em-item">
                  <span class="em-k">{{ t('Echo','回响') }}</span>
                  <span class="em-v">{{ echo.get('n_sources',0) }} {{ t('src','来源') }} · {{ echo.get('n_desks',0) }} {{ t('desk','台') }}</span>
                </span>
              {% endif %}
              {% if h.get('source_tier') %}
              <span class="em-item">
                {% set _tl = TIERL.get(h.source_tier) %}
                <span class="tier-badge tier-{{ h.source_tier }}">{% if _tl %}{{ t(_tl[0], _tl[1]) }}{% else %}T{{ h.source_tier }}{% endif %}</span>
                <span class="em-v">{{ h.source_name or h.get('domain','') }}</span>
              </span>
              {% else %}
              <span class="em-item">
                <span class="em-v">{{ h.source_name or h.get('domain','') }}</span>
              </span>
              {% endif %}
              {% if h.get('seendate') %}
              <span class="em-item">
                <span class="na-when rel-time" data-ts="{{ h.seendate }}"></span>
              </span>
              {% endif %}
            </div>
            {# NEWS-DD-09: extracted numbers — use real engine keys: percentages + usd_all #}
            {% if h.get('event') and h.event.get('numbers') %}
              {% set nums = h.event.numbers %}
              {% set num_items = [] %}
              {# percentages key (engine/news_events.py extract_numbers) #}
              {% if nums.get('percentages') %}{% for v in nums.percentages[:3] %}{% set _ = num_items.append(('%.1f%%'|format(v))) %}{% endfor %}{% endif %}
              {# usd_all: classify into B (≥1B) or M (≥1M) inline #}
              {% if nums.get('usd_all') %}
                {% set _usd_shown = namespace(n=0) %}
                {% for v in nums.usd_all %}
                  {% if _usd_shown.n < 3 %}
                    {% if v|abs >= 1000000000 %}
                      {% set _ = num_items.append(('$%.1fB'|format(v / 1000000000))) %}
                    {% elif v|abs >= 1000000 %}
                      {% set _ = num_items.append(('$%.0fM'|format(v / 1000000))) %}
                    {% else %}
                      {% set _ = num_items.append(('$%.0fK'|format(v / 1000))) %}
                    {% endif %}
                    {% set _usd_shown.n = _usd_shown.n + 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              {# eps is a scalar float (not a list) #}
              {% if nums.get('eps') is number %}{% set _ = num_items.append(('EPS $%.2f'|format(nums.eps))) %}{% endif %}
              {% if num_items %}
              <div class="ev-nums">
                {% for v in num_items %}<span class="ev-num-pill">{{ v }}</span>{% endfor %}
              </div>
              {% endif %}
            {% endif %}
            {# tickers #}
            {% if h.get('tickers') %}
            <div class="ev-nums" style="margin-top:4px">
              {% for tk in h.tickers[:6] %}<span class="na-pill tk">{{ tk }}</span>{% endfor %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
          <div class="board-empty">{{ t('No event-typed headlines in this window. All kept items are in the section below.', '本窗口内无类型化事件头条。所有保留条目均在下方。') }}</div>
        {% endif %}
      </section>

      {# ==================================================================== #}
      {# B. MACRO RELEASE BOARD                                               #}
      {# <!-- nx-release-board --> #}
      {# ==================================================================== #}
      <section class="board" id="nxReleaseBoard">
        <div class="board-head">
          <h2>{{ t('Macro Release Board', '宏观数据发布面板') }}</h2>
          <span class="board-badge">{{ t('DATA DESK', '数据台') }}</span>
          <span class="board-count">{{ n_releases }} {{ t('releases', '发布') }}</span>
        </div>
        {# NEWS-DD-08: one plain sentence; fix "last 10 days" lie — release window is cadence-tiered #}
        <div class="board-note">
          <span class="l-en">Most recent FRED print per series, shown within its release cycle. No consensus feed — surprise measured against prior and recent history only.</span>
          <span class="l-zh">每个系列最新FRED数据，按其发布周期展示。无一致预期数据 — 偏差仅与前值及近期历史对比。</span>
        </div>
        {# NEWS-DD-01: stance line — Release Board #}
        <div class="board-stance">
          <span class="l-en">Data check — these prints confirm the regime, not a trade trigger.</span>
          <span class="l-zh">数据核查 — 这些数据确认当前格局，不是交易信号。</span>
        </div>
        {% if releases %}
          {% for card in releases %}
          <div class="rel-card">
            <div class="rel-top">
              <span class="rel-name">
                <span class="l-en">{{ card.get('display_name') or card.get('release','?') }}</span>
                <span class="l-zh">{{ card.get('display_name') or card.get('release','?') }}</span>
              </span>
              {% if card.get('surprise_size') %}
                <span class="rel-size sz-{{ card.surprise_size }}">{{ card.surprise_size|upper }}</span>
              {% endif %}
              {% set dir = card.get('direction_tag','') %}
              {% if dir == 'bullish' %}<span class="rel-dir-bull">{{ t('↑ Bullish read','↑ 利多解读') }}</span>
              {% elif dir == 'bearish' %}<span class="rel-dir-bear">{{ t('↓ Bearish read','↓ 利空解读') }}</span>
              {% endif %}
            </div>
            <div class="rel-grid">
              <div class="rel-cell">
                <div class="rck">{{ t('Actual','实际') }}</div>
                <div class="rcv">{{ card.get('actual') if card.get('actual') is not none else '—' }}</div>
                <div class="rcsub">{{ card.get('period','') }}</div>
              </div>
              <div class="rel-cell">
                <div class="rck">{{ t('Prior (revised)','前值（修正）') }}</div>
                <div class="rcv">{{ card.get('prior') if card.get('prior') is not none else '—' }}</div>
                <div class="rcsub">{{ card.get('prior_label','vs revised prior') }}</div>
              </div>
              {% if card.get('deltas') is mapping %}
                {% set d = card.deltas %}
                {% if d.get('vs_prior') is number %}
                <div class="rel-cell">
                  <div class="rck">{{ t('Δ vs prior','Δ 较前值') }}</div>
                  <div class="rcv">{{ '%+.4g'|format(d.vs_prior) }}</div>
                </div>
                {% endif %}
              {% endif %}
              {% if card.get('z3y') is number %}
              <div class="rel-cell">
                <div class="rck">{{ t('vs 3y range','较3年区间') }}</div>
                <div class="rcv {{ 'rel-dir-bull' if card.z3y > 1.5 else 'rel-dir-bear' if card.z3y < -1.5 else '' }}"
                     data-tip-en="z-score vs 3y history: {{ '%+.2f'|format(card.z3y) }}"
                     data-tip-zh="较3年历史z分数：{{ '%+.2f'|format(card.z3y) }}">
                  {# NEWS-DD-03: plain word instead of raw z value on Tier 1 #}
                  {% if card.z3y > 1.5 %}{{ t('High','偏高') }}{% elif card.z3y < -1.5 %}{{ t('Low','偏低') }}{% else %}{{ t('In range','区间内') }}{% endif %}
                </div>
              </div>
              {% endif %}
            </div>
            {% if card.get('summary') %}
            <div class="rel-summary">{{ card.summary }}</div>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
          <div class="board-empty">{{ t('No releases parsed in the window. FRED data fetches may be off or the window is quiet.', '窗口内无已解析数据发布。FRED数据获取可能已关闭或窗口平静。') }}</div>
        {% endif %}
      </section>

      {# ==================================================================== #}
      {# C. THEME PULSE                                                        #}
      {# <!-- nx-theme-pulse --> #}
      {# ==================================================================== #}
      <section class="board" id="nxThemePulse">
        <div class="board-head">
          <h2>{{ t('Theme Pulse', '主题脉冲') }}</h2>
          <span class="board-badge">{{ t('NEWS-SIDE ONLY', '仅新闻侧') }}</span>
        </div>
        {# NEWS-DD-08: compress note; NEWS-DD-01: stance embedded #}
        <div class="board-note">
          <span class="l-en">Headline count and peak novelty per theme from today's kept set — a texture read, not a signal.</span>
          <span class="l-zh">今日保留集中各主题的头条数量及最高新颖度 — 纹理参考，非信号。</span>
        </div>
        {% set ns_pulse = namespace(items=[]) %}
        {% for key, labels in TL.items() %}
          {% set ns_theme = namespace(count=0, max_nov=None) %}
          {% for h in heads %}
            {% if h.get('theme') == key %}
              {% set ns_theme.count = ns_theme.count + 1 %}
              {% if h.get('novelty_z') is not none %}
                {% set nv = h.novelty_z|float %}
                {% if ns_theme.max_nov is none or nv > ns_theme.max_nov %}
                  {% set ns_theme.max_nov = nv %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if ns_theme.count > 0 %}
            {% set _ = ns_pulse.items.append({'key': key, 'label_en': labels[0], 'label_zh': labels[1], 'count': ns_theme.count, 'max_nov': ns_theme.max_nov}) %}
          {% endif %}
        {% endfor %}
        {% if ns_pulse.items %}
        <div class="pulse-grid">
          {% for item in ns_pulse.items|sort(attribute='count', reverse=True) %}
          <div class="pulse-cell">
            <div class="pt-label th-{{ item.key }} ev-theme-pill" style="width:fit-content">{{ t(item.label_en, item.label_zh) }}</div>
            <div class="pt-count">{{ item.count }}</div>
            {# NEWS-DD-03: plain-word novelty label in pulse meta; numeric z in data-tip #}
            <div class="pt-meta">
              {{ t('headline','条头条') }}{{ 's' if item.count != 1 else '' }}
              {% if item.max_nov is not none %}
                · {{ fmt_nov(item.max_nov) }}
              {% endif %}
            </div>
            {% set pct = ([item.count, 20]|min / 20 * 100)|int %}
            <div class="pt-bar" style="width:{{ pct }}%"></div>
          </div>
          {% endfor %}
        </div>
        {% else %}
          <div class="board-empty">{{ t('No headlines in the window.', '窗口内无头条。') }}</div>
        {% endif %}
      </section>

      {# ==================================================================== #}
      {# D. OTHER MACRO HEADLINES — demoted accordion, collapsed by default   #}
      {# NEWS-DD-09: renamed from 'Context Headlines' — NWS-05                #}
      {# <!-- nx-context-section --> #}
      {# ==================================================================== #}
      <details class="board board-toggle" id="nxContextSection">
        <summary class="board-head">
          {# NEWS-DD-09: renamed board heading (drop CONTEXT-ONLY badge) #}
          <h2>{{ t('Other macro headlines', '其他宏观头条') }}</h2>
          <span class="board-count">{{ n_context }} {{ t('items', '条目') }}</span>
          <span class="bh-arrow">▾</span>
        </summary>
        {# NEWS-DD-08: one plain sentence + NWS-08 stale-retention note merged in #}
        <div class="board-note">
          <span class="l-en">Macro-relevant background without a detected event — a reference read, not a trading cue. Official releases are kept up to ~45 days; wire items ~5 days.</span>
          <span class="l-zh">无检测事件的宏观相关背景 — 参考阅读，非交易提示。官方发布最长保留约45天，快讯约5天。{% if n_zh_missing > 0 %}部分标题来自英文信源，暂以原文显示。{% endif %}</span>
        </div>
        {# NEWS-DD-01: stance line — Context Headlines #}
        <div class="board-stance">
          <span class="l-en">Background read — don't chase these headlines.</span>
          <span class="l-zh">背景阅读 — 不必追随这些头条。</span>
        </div>
        {# NWS-04 note superseded by the conditional n_zh_missing note in the board note (#2661) #}
        {% if ctx_heads %}
          {% for h in ctx_heads %}
          <details class="na-item"
            data-theme="{{ h.get('theme','') }}"
            data-search="{{ ((h.get('title') or '') ~ ' ' ~ (h.get('domain') or '') ~ ' ' ~ (h.get('source_name') or '') ~ ' ' ~ (h.get('theme') or ''))|lower }}">
            <summary class="na-sum">
              <span class="na-theme th-{{ h.get('theme','') }}">{{ t(TL.get(h.get('theme',''), [h.get('theme',''), h.get('theme','')])[0], TL.get(h.get('theme',''), [h.get('theme',''), h.get('theme','')])[1]) }}</span>
              <span class="na-htitle"><span class="l-en">{{ h.get('title','') }}</span><span class="l-zh">{{ h.get('title_zh') or h.get('title','') }}</span></span>
              <span class="na-right">
                <span class="na-src">{{ h.get('source_name') or h.get('domain','') }}</span>
                <span class="na-chev">▾</span>
              </span>
            </summary>
            <div class="na-body">
              <div class="na-tags">
                {% for c in (h.get('channels') or [])[:4] %}{% set _cl = CHL.get(c) or [c|replace('_',' '), c|replace('_',' ')] %}<span class="na-pill">{{ t(_cl[0], _cl[1]) }}</span>{% endfor %}
                {% for tk in (h.get('tickers') or [])[:5] %}<span class="na-pill tk">{{ tk }}</span>{% endfor %}
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                {% if h.get('url') %}<a class="na-read" href="{{ h.url }}" target="_blank" rel="noopener">{{ t('Read source','阅读原文') }} →</a>{% endif %}
                {% if h.get('seendate') %}<span class="na-when rel-time" data-ts="{{ h.seendate }}"></span>{% endif %}
              </div>
            </div>
          </details>
          {% endfor %}
        {% else %}
          <div class="board-empty">{{ t('All kept headlines had event classes — nothing here.', '所有保留头条均有事件类型，此处无条目。') }}</div>
        {% endif %}
      </details>

      {# ==================================================================== #}
      {# E. REJECT LOG                                                         #}
      {# <!-- nx-reject-log --> #}
      {# ==================================================================== #}
      <details class="board board-toggle" id="nxRejectLog">
        <summary class="board-head">
          <h2>{{ t('Reject Log', '筛出日志') }}</h2>
          <span class="board-badge">{{ t('AUDIT', '审计') }}</span>
          <span class="board-count">{{ n_rejected }} {{ t('filtered out', '已筛出') }}</span>
          <span class="bh-arrow">▾</span>
        </summary>
        {% if news_rejected is mapping and news_rejected %}
        {# NEWS-DD-08: one plain sentence note #}
        <div class="board-note">
          <span class="l-en">Headlines dropped across all feeds, grouped by reason.</span>
          <span class="l-zh">所有信源中已筛出的头条，按原因分组。</span>
        </div>
        {% set rej_by_reason = namespace(d={}) %}
        {% for r in rejected_all %}
          {% set reason = r.get('reason') or 'unknown' %}
          {% set existing = rej_by_reason.d.get(reason, []) %}
          {% set _ = existing.append(r) %}
          {% set _ = rej_by_reason.d.update({reason: existing}) %}
        {% endfor %}
        {% set display_cap = namespace(remaining=50) %}
        {% for reason, items in rej_by_reason.d.items() %}
          {% if display_cap.remaining > 0 %}
          <div class="rej-group">
            <div class="rej-group-head">
              {# NEWS-DD-07: translate reject reason slug via REJL dict #}
              {% set _rl = REJL.get(reason) %}
              <span class="rej-reason">{% if _rl %}{{ t(_rl[0], _rl[1]) }}{% else %}{{ reason|replace('_',' ')|title }}{% endif %}</span>
              <span class="rej-group-count">{{ items|length }} {{ t('items','条') }}</span>
            </div>
            <table class="rej-table">
              <thead><tr>
                <th>{{ t('Title','标题') }}</th>
                <th>{{ t('Domain','域名') }}</th>
              </tr></thead>
              <tbody>
              {% set shown = namespace(n=0) %}
              {% for r in items %}
                {% if shown.n < display_cap.remaining and shown.n < 10 %}
                <tr>
                  <td>{{ r.get('title') or '—' }}</td>
                  <td class="rt-dom">{{ r.get('domain') or '—' }}</td>
                </tr>
                {% set shown.n = shown.n + 1 %}
                {% endif %}
              {% endfor %}
              </tbody>
            </table>
            {% if items|length > 10 %}
            <div class="rej-cap-note">{{ t('... and ' ~ (items|length - 10) ~ ' more', '...及另' ~ (items|length - 10) ~ '条') }}</div>
            {% endif %}
            {% set display_cap.remaining = display_cap.remaining - ([items|length, 10]|min) %}
          </div>
          {% endif %}
        {% endfor %}
        {% else %}
          <div class="board-empty">{{ t('No reject log available. Run build_news.py to populate.', '暂无筛出日志。请运行 build_news.py 生成。') }}</div>
        {% endif %}
      </details>

      {# ==================================================================== #}
      {# F. CALIBRATION BOARD                                                  #}
      {# <!-- nx-calibration-board --> #}
      {# ==================================================================== #}
      <details class="board board-toggle" id="nxCalibrationBoard">
        <summary class="board-head">
          {# NEWS-DD-04: ? tip on h2 carries mechanics (sanctioned Tier-2 home) #}
          <h2>{{ t('Event Class Calibration', '事件类别校准') }}
            <span class="help-tip"
              data-tip-en="How verdicts work: fewer than 30 graded events → still gathering; Wilson lower bound above 50% → shows a pattern; Wilson upper bound below 50% → no pattern found; otherwise context-only. Wilson interval is a confidence-adjusted hit-rate bound. Nothing here drives any signal until an authority gate is passed (not live yet)."
              data-tip-zh="裁决规则：少于30条已评级事件 → 仍在积累；Wilson下界超50% → 显示规律；Wilson上界低于50% → 未发现规律；否则为背景层。Wilson区间为置信度调整后的命中率边界。本处任何结果均不进入信号，直到获取授权（尚未上线）。">?</span>
          </h2>
          <span class="board-badge">{{ t('ACCRUING', '积累中') }}</span>
          {% if calib %}<span class="board-count">{{ calib_classes|length }} {{ t('classes', '类别') }}</span>{% endif %}
          <span class="bh-arrow">▾</span>
        </summary>
        {% if calib and calib_classes %}
        {# NEWS-DD-04: Tier-1 note is one plain sentence; mechanics moved to ? tip on h2 #}
        <div class="board-note">
          <span class="l-en">Tracking whether each event type actually moves prices — still gathering data; nothing here drives any signal yet.</span>
          <span class="l-zh">追踪各事件类别是否真正影响价格 — 仍在积累数据；此处任何结果均不驱动信号。</span>
        </div>
        {# NEWS-DD-01: stance line — Calibration Board #}
        <div class="board-stance">
          <span class="l-en">Still gathering evidence — nothing here drives a signal yet.</span>
          <span class="l-zh">仍在收集证据 — 此处尚无信号驱动。</span>
        </div>
        <div class="calib-grid">
          {% for cls in calib_classes %}
          {% set verdict = cls.get('verdict','insufficient') %}
          <div class="calib-cell">
            <div class="cc-event">{{ cls.get('event_type','?')|replace('_',' ')|title }}</div>
            {% if verdict == 'insufficient' %}
              <span class="cc-verdict vd-insuf">{{ t('accruing (n=' ~ cls.get('n_graded',0) ~ ')','积累中(n=' ~ cls.get('n_graded',0) ~ ')') }}</span>
            {% elif verdict == 'candidate' %}
              <span class="cc-verdict vd-cand">{{ t('Shows a pattern','显示规律') }}</span>
            {% elif verdict == 'no_edge' %}
              <span class="cc-verdict vd-noedge">{{ t('No pattern found','未发现规律') }}</span>
            {% else %}
              <span class="cc-verdict vd-ctx">{{ t('Context only','仅背景') }}</span>
            {% endif %}
            <div class="cc-n">{{ cls.get('n','?') }} {{ t('logged','已记录') }} · {{ cls.get('n_graded','?') }} {{ t('graded','已评级') }}</div>
            <div class="cc-row">
              {% if cls.get('hit_5d') is number %}<span>5d: <span class="cc-hit">{{ '%.0f%%'|format(cls.hit_5d * 100) }}</span></span>{% endif %}
              {% if cls.get('hit_21d') is number %}<span>21d: <span class="cc-hit">{{ '%.0f%%'|format(cls.hit_21d * 100) }}</span></span>{% endif %}
              {# NEWS-DD-06: direction label — translate bullish/mixed/bearish #}
              {% if cls.get('direction') %}
                {% if cls.direction == 'bullish' %}<span>{{ t('↑ Upside','↑ 利多') }}</span>
                {% elif cls.direction == 'bearish' %}<span>{{ t('↓ Downside','↓ 利空') }}</span>
                {% elif cls.direction == 'mixed' %}<span>{{ t('Mixed','分歧') }}</span>
                {% elif cls.direction == 'informational' %}<span>{{ t('Informational','信息') }}</span>
                {% else %}<span>{{ cls.direction }}</span>{% endif %}
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% if calib.get('reject_audit') is mapping %}
          {% set ra = calib.reject_audit %}
          {% set ra_classes = (ra.get('classes') if ra.get('classes') is iterable and ra.get('classes') is not string else [])|select('mapping')|list %}
          <div class="board-note" style="border-top:1px solid var(--line)">
            <span class="l-en">Reject audit: {{ ra.get('n_sampled',0) }} sampled · {{ ra.get('n_graded',0) }} graded
              {% if ra_classes %}
                {% set _rac0 = ra_classes[0] %}
                {% set _rac0_rl = REJL.get(_rac0.get('reason','')) %}
                — top reason: {% if _rac0_rl %}{{ _rac0_rl[0] }}{% else %}{{ _rac0.get('reason','?') }}{% endif %} (avg 21d: {{ '%.1f%%'|format(_rac0.get('avg_rel_21d',0)) if _rac0.get('avg_rel_21d') is number else 'n/a' }})
              {% endif %}
            </span>
            <span class="l-zh">筛出审计：{{ ra.get('n_sampled',0) }} 已抽样 · {{ ra.get('n_graded',0) }} 已评级</span>
          </div>
        {% endif %}
        {% elif calib and calib.get('schema') %}
          <div class="calib-accruing">{{ t('Calibration is accruing — no event classes graded yet. This board will populate as events accrue forward-return data over coming days.', '校准积累中 — 暂无事件类别评级。随着事件积累前向收益数据，此面板将在后续天数逐步填充。') }}</div>
        {% else %}
          <div class="calib-accruing">{{ t('Calibration accruing — artifact not yet generated. Run the news calibration wave to populate this board.', '校准积累中 — 尚未生成结果文件。请运行新闻校准波次以填充此面板。') }}</div>
        {% endif %}
      </details>

      {# ==================================================================== #}
      {# G. COMPANY & MARKET WIRES — NWS-05                                   #}
      {# financial.json market/mag7 arrays rendered here                       #}
      {# <!-- nx-wires-board --> #}
      {# ==================================================================== #}
      <details class="board board-toggle" id="nxWiresBoard">
        <summary class="board-head">
          <h2>{{ t('Company &amp; market wires', '公司与市场快讯') }}</h2>
          <span class="board-badge">{{ t('WIRES', '快讯') }}</span>
          {% if _fn_market %}<span class="board-count">{{ _fn_market|length }} {{ t('items', '条目') }}</span>{% endif %}
          <span class="bh-arrow">▾</span>
        </summary>
        {# NEWS-DD-01: stance line — Wires Board #}
        <div class="board-stance">
          <span class="l-en">Background read — don't chase these headlines.</span>
          <span class="l-zh">背景阅读 — 不必追随这些快讯。</span>
        </div>
        {# NWS-05: ticker-tagged coverage degraded warning #}
        {% if not _fn_polygon_ok %}
        <div class="fn-degraded">
          <span class="l-en">Ticker-tagged coverage is degraded right now — some company items may be missing.</span>
          <span class="l-zh">标的标注覆盖当前降级 — 部分公司条目可能缺失。</span>
        </div>
        {% endif %}
        {# mag7 chip row (display only — no links) #}
        {% if _fn_mag7 %}
        <div class="mag7-row">
          {% for ticker, info in _fn_mag7.items() %}
            {% if info is mapping %}
              {% set hl_count = (info.get('headlines') if info.get('headlines') is iterable and info.get('headlines') is not string else [])|list|length %}
              {% if hl_count > 0 %}
              <span class="mag7-chip">
                <span class="m7t">{{ ticker }}</span>
                <span class="m7n">{{ hl_count }}</span>
              </span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
        {# market items accordion — same na-item idiom, capped at 20 #}
        {% if _fn_market %}
          {% for item in _fn_market[:20] %}
          <details class="na-item">
            <summary class="na-sum">
              <span class="na-theme th-stocks">{{ t('Wire','快讯') }}</span>
              <span class="na-htitle">{{ item.get('title','') }}</span>
              <span class="na-right">
                <span class="na-src">{{ item.get('source') or item.get('domain','') }}</span>
                <span class="na-chev">▾</span>
              </span>
            </summary>
            <div class="na-body">
              <div class="na-tags">
                {% for tk in (item.get('tickers') or [])[:6] %}<span class="na-pill tk">{{ tk }}</span>{% endfor %}
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
                {% if item.get('url') %}<a class="na-read" href="{{ item.url }}" target="_blank" rel="noopener">{{ t('Read source','阅读原文') }} →</a>{% endif %}
                {% if item.get('seendate') %}<span class="na-when rel-time" data-ts="{{ item.seendate }}"></span>{% endif %}
              </div>
            </div>
          </details>
          {% endfor %}
          {% if _fn_market|length > 20 %}
          <div class="rej-cap-note">{{ t('Showing 20 of ' ~ _fn_market|length ~ ' items','显示20条，共' ~ _fn_market|length ~ '条') }}</div>
          {% endif %}
        {% else %}
          <div class="board-empty">
            <span class="l-en">No market wire items available.</span>
            <span class="l-zh">暂无市场快讯条目。</span>
          </div>
        {% endif %}
      </details>

    </div>

    {# ---- right rail ---- #}
    <aside class="rail">
      <section class="rail-card">
        <h2>{{ t('Upcoming catalysts', '即将到来的催化') }}</h2>
        {% for c in macro_catalysts[:8] %}
        <div class="rail-line">
          <div class="rail-date">{{ c.date }}{% if c.time_et %}<br>{{ c.time_et }} ET{% endif %}</div>
          <div class="rail-main"><span class="rail-tag">{{ c.type }}</span>{{ t(c.label, c.get('label_zh') or c.label) }}</div>
        </div>
        {% else %}
        <p class="mut">{{ t('No scheduled catalysts in the window.', '窗口内无排定催化。') }}</p>
        {% endfor %}
      </section>

      <section class="rail-card">
        <h2>{{ t('High-impact calendar', '高影响日程') }}</h2>
        {% for s in event_strip %}
        <div class="rail-line">
          <div class="rail-date">{{ s.dow }} {{ s.md }}{% if s.time_et %}<br>{{ s.time_et }} ET{% endif %}</div>
          <div class="rail-main"><span class="rail-tag">{{ s.type }}</span>{{ t(s.label, s.get('label_zh') or s.label) }}</div>
        </div>
        {% else %}
        <p class="mut">{{ t('No top-tier US prints in the window.', '窗口内无一线美国数据。') }}</p>
        {% endfor %}
      </section>

      {% if prediction_markets and prediction_markets.events %}
      <section class="rail-card">
        <h2>{{ t('Market-implied odds', '市场隐含概率') }}</h2>
        {% for e in prediction_markets.events[:3] %}
        <div class="rail-line" style="display:block">
          <div class="rail-main" style="font-weight:700;margin-bottom:4px">{{ t(e.label_en, e.label_zh) }}</div>
          {% for o in e.outcomes[:3] %}
          <div class="odds-row"><span class="o">{{ o.outcome }}</span><b>{{ o.prob }}%</b>{% if o.chg_pp is not none and o.chg_pp != 0 %}<span class="{{ 'r-pos' if o.chg_pp > 0 else 'r-neg' }}">{{ '%+.1f'|format(o.chg_pp) }}</span>{% else %}<span></span>{% endif %}</div>
          {% endfor %}
        </div>
        {% endfor %}
        <p class="mut" style="font-size:10px;margin:4px 0 0">{{ t('Crowd expectation, not a forecast.', '群体预期，非预测。') }}</p>
      </section>
      {% endif %}

      <section class="rail-card">
        <h2>{{ t('Feed intelligence', '新闻情报') }}</h2>
        {% if SYN.read %}<div class="rail-line"><div class="rail-date">{{ t('Read','读数') }}</div><div class="rail-main">{{ t(SYN.read, SYN.get('read_zh') or SYN.read) }}</div></div>{% endif %}
        <div class="rail-line">
          <div class="rail-date">{{ t('Channels','通道') }}</div>
          <div class="rail-main">{% for c in SYN_CHANNELS[:5] %}<span class="rail-tag">{{ t(c.get('label_en') or c.name|replace('_',' '), c.get('label_zh') or c.get('label_en') or c.name|replace('_',' ')) }}</span>{% else %}<span class="mut">{{ t('No channel cluster yet','暂无通道聚类') }}</span>{% endfor %}</div>
        </div>
        <div class="rail-line">
          <div class="rail-date">{{ t('Tickers','标的') }}</div>
          <div class="rail-main">{% for tk in SYN_TICKERS[:6] %}<span class="rail-tag">{{ tk.ticker }}</span>{% else %}<span class="mut">{{ t('No proxy tags yet','暂无代理标的') }}</span>{% endfor %}</div>
        </div>
        {% if RA_COND.get('news_sentiment_state') %}
        <div class="rail-line">
          <div class="rail-date">{{ t('SF-Fed','旧金山联储') }}</div>
          <div class="rail-main">{{ t('Sentiment','情绪') }}: <b class="{{ 'r-pos' if RA_COND.get('news_sentiment_state')=='optimistic' else 'r-neg' }}">{{ t('optimistic','乐观') if RA_COND.get('news_sentiment_state')=='optimistic' else t('pessimistic','悲观') }}</b>{% if RA_COND.get('news_sentiment_z') is not none %} · z {{ '%+.1f'|format(RA_COND.get('news_sentiment_z')) }}{% endif %}</div>
        </div>
        {% endif %}
      </section>

      {# NEWS-DD-05: NDI/EPU/GPR rail — gloss acronyms in plain words; percentile phrasing #}
      {% if ndi %}
      <section class="rail-card">
        <h2>{{ t('Narrative texture', '叙事纹理') }}</h2>
        {% if ndi.get('ndi') is not none %}
        <div class="rail-line">
          <div class="rail-date">{{ t('Index','指数') }}</div>
          <div class="rail-main">
            <b data-tip-en="Narrative-Dominance Index: composite of policy uncertainty, geopolitical risk and market volatility text signals (0–100)" data-tip-zh="叙事主导指数：政策不确定性、地缘风险与市场波动文本信号的综合（0–100）">{{ ndi.get('ndi') }}/100</b>
            <span class="mut"> · {{ t('a texture read, not a signal','纹理参考，非信号') }}</span>
          </div>
        </div>
        {% endif %}
        {% set L = (ndi.get('legs') or {}) %}
        {% if L.get('epu') is mapping and L.epu.get('pct') is not none %}
        <div class="rail-line">
          <div class="rail-date">{{ t('Policy','政策') }}</div>
          <div class="rail-main"
               data-tip-en="Economic Policy Uncertainty index — how much news discussion is uncertainty-laden"
               data-tip-zh="经济政策不确定性指数 — 新闻中的政策不确定性程度">
            {# Express percentile as plain words: top X% #}
            {% set _pct = L.epu.pct %}
            <b>{% if _pct >= 90 %}{{ t('Very high (top ~' ~ ((100-_pct)|int) ~ '%)','非常高（前~' ~ ((100-_pct)|int) ~ '%）') }}{% elif _pct >= 70 %}{{ t('Elevated (~' ~ _pct|int ~ ' pct)','偏高（~' ~ _pct|int ~ ' 百分位）') }}{% elif _pct <= 20 %}{{ t('Low (~' ~ _pct|int ~ ' pct)','偏低（~' ~ _pct|int ~ ' 百分位）') }}{% else %}{{ t('Moderate (~' ~ _pct|int ~ ' pct)','适中（~' ~ _pct|int ~ ' 百分位）') }}{% endif %}</b>
          </div>
        </div>
        {% endif %}
        {% if L.get('gpr_threat') is mapping and L.gpr_threat.get('pct') is not none %}
        <div class="rail-line">
          <div class="rail-date">{{ t('Geo risk','地缘') }}</div>
          <div class="rail-main"
               data-tip-en="Geopolitical Risk index — frequency of conflict-threat language in global media"
               data-tip-zh="地缘政治风险指数 — 全球媒体中冲突威胁词频">
            {% set _pct = L.gpr_threat.pct %}
            <b>{% if _pct >= 90 %}{{ t('Very high (top ~' ~ ((100-_pct)|int) ~ '%)','非常高（前~' ~ ((100-_pct)|int) ~ '%）') }}{% elif _pct >= 70 %}{{ t('Elevated (~' ~ _pct|int ~ ' pct)','偏高（~' ~ _pct|int ~ ' 百分位）') }}{% elif _pct <= 20 %}{{ t('Low (~' ~ _pct|int ~ ' pct)','偏低（~' ~ _pct|int ~ ' 百分位）') }}{% else %}{{ t('Moderate (~' ~ _pct|int ~ ' pct)','适中（~' ~ _pct|int ~ ' 百分位）') }}{% endif %}</b>
          </div>
        </div>
        {% endif %}
        {% if L.get('vix') is mapping and L.vix.get('pct') is not none %}
        <div class="rail-line">
          <div class="rail-date">VIX</div>
          <div class="rail-main">
            {% set _pct = L.vix.pct %}
            <b>{% if _pct >= 90 %}{{ t('Very high (top ~' ~ ((100-_pct)|int) ~ '%)','非常高（前~' ~ ((100-_pct)|int) ~ '%）') }}{% elif _pct >= 70 %}{{ t('Elevated (~' ~ _pct|int ~ ' pct)','偏高（~' ~ _pct|int ~ ' 百分位）') }}{% elif _pct <= 20 %}{{ t('Low (~' ~ _pct|int ~ ' pct)','偏低（~' ~ _pct|int ~ ' 百分位）') }}{% else %}{{ t('Moderate (~' ~ _pct|int ~ ' pct)','适中（~' ~ _pct|int ~ ' 百分位）') }}{% endif %}</b>
          </div>
        </div>
        {% endif %}
      </section>
      {% endif %}

    </aside>
  </div>
</main>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  // relative-time stamps
  function rel(ts){
    var d=new Date(ts); if(isNaN(d)) return '';
    var s=Math.max(0,(Date.now()-d.getTime())/1000), zh=document.documentElement.getAttribute('data-lang')==='zh';
    if(s<90) return zh?'刚刚':'just now';
    var m=Math.round(s/60); if(m<60) return zh?(m+' 分钟前'):(m+' min ago');
    var h=Math.round(m/60); if(h<48) return zh?(h+' 小时前'):(h+' h ago');
    var dd=Math.round(h/24); return zh?(dd+' 天前'):(dd+' d ago');
  }
  function stamps(){
    var isZh=document.documentElement.getAttribute('data-lang')==='zh';
    document.querySelectorAll('.rel-time[data-ts]').forEach(function(el){
      var ts=el.getAttribute('data-ts'); if(!ts) return;
      var r=rel(ts); if(!r) return;
      el.textContent=(el.classList.contains('na-when')?'':(isZh?'更新于 ':'Updated '))+r;
    });
  }
  // NEWS-DD-02: aged chip — mark event cards older than 5 days
  function markAged(){
    var isZh=document.documentElement.getAttribute('data-lang')==='zh';
    var cutoff=Date.now()-5*24*60*60*1000;
    document.querySelectorAll('.ev-card[data-seendate]').forEach(function(card){
      var ts=card.getAttribute('data-seendate'); if(!ts) return;
      var d=new Date(ts); if(isNaN(d)) return;
      var chip=card.querySelector('.ev-aged');
      if(!chip) return;
      if(d.getTime()<cutoff){
        chip.textContent=isZh?chip.getAttribute('data-aged-zh'):chip.getAttribute('data-aged-en');
        chip.style.display='inline';
      }
    });
  }
  document.addEventListener('langchange', stamps);
  document.addEventListener('langchange', markAged);
  stamps();
  markAged();
})();
</script>
{% endblock %}
