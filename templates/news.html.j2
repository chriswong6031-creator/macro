{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}

{# =========================================================================== #}
{#  MARKETS NEWS — 2026 revamp. mx5-idiom, importance-ranked, aged, decluttered. #}
{#  Reads a single unified `news_feed` (built in build_site: macro + financial,   #}
{#  deduped, aged, ranked by rank_score, lane-tagged) plus the release board,     #}
{#  calendar, market-implied odds and a collapsed diagnostics drawer. Everything  #}
{#  here is DISPLAY-ONLY — news never feeds a score (house firewall intact).      #}
{# =========================================================================== #}

{# ---- unified feed (from build_site; null-safe) --------------------------- #}
{% set FEED = (news_feed if news_feed is iterable and news_feed is not string else [])|select('mapping')|list %}
{% set LEAD = FEED[0] if FEED else None %}
{% set MOVERS = FEED[1:4] if FEED|length > 1 else [] %}

{# ---- macro synthesis / sentiment / labels ------------------------------- #}
{% set SYN = (macro_news.synthesis if macro_news and macro_news.synthesis else {}) %}
{% set heads = (macro_news.headlines if macro_news and macro_news.headlines else []) %}
{% set RA = ((latest.conditions or {}).get('risk_appetite') or {} if latest and latest.conditions else {}) %}
{% set NS_STATE = RA.get('news_sentiment_state') %}
{% set NS_Z = RA.get('news_sentiment_z') %}

{# ---- release board / calendar / odds (null-safe) ------------------------ #}
{% set releases = (macro_releases.get('cards') if macro_releases is mapping else none) %}
{% set releases = ((releases if releases is iterable and releases is not string else [])|select('mapping')|list) %}
{% set catalysts = (macro_catalysts if macro_catalysts is iterable and macro_catalysts is not string else []) %}
{% set estrip = (event_strip if event_strip is iterable and event_strip is not string else []) %}
{% set pmkts = (prediction_markets.events if prediction_markets is mapping and prediction_markets.events else []) %}

{# ---- diagnostics (collapsed drawer) ------------------------------------- #}
{% set rejected_all = [] %}
{% set _rej_feeds = (news_rejected.get('feeds') if news_rejected is mapping else none) %}
{% if _rej_feeds is mapping %}
  {% for fk in ['macro','financial','rss'] %}
    {% set fl = _rej_feeds.get(fk) %}
    {% set fl = ((fl if fl is iterable and fl is not string else [])|select('mapping')|list) %}
    {% for r in fl %}{% set _ = rejected_all.append(r) %}{% endfor %}
  {% endfor %}
{% endif %}
{% set calib = news_calibration if news_calibration is mapping and news_calibration else None %}
{% set calib_classes = (calib.get('classes') if calib else none) %}
{% set calib_classes = ((calib_classes if calib_classes is iterable and calib_classes is not string else [])|select('mapping')|list) %}

{# ---- label dictionaries (raw slugs never render on glance surfaces) ------ #}
{% set TL = {'monetary':['Fed','美联储'],'inflation':['Inflation','通胀'],'labor':['Jobs','就业'],'growth':['Growth','增长'],'credit':['Rates','利率'],'fiscal':['Fiscal','财政'],'earnings':['Earnings','业绩'],'guidance':['Guidance','指引'],'analyst':['Analysts','分析师'],'deals':['Deals','并购'],'capital_return':['Buybacks','回购'],'stocks':['Stocks','个股'],'macro':['Macro','宏观']} %}
{% set LANEL = {'markets':['Markets','市场'],'macro':['Macro','宏观'],'fed':['Fed','美联储'],'companies':['Companies','公司']} %}
{% set THEME_WHY = {'monetary':['Rate-path relevant','影响利率路径'],'inflation':['Inflation read','通胀信号'],'labor':['Jobs read','就业信号'],'growth':['Growth read','增长信号'],'credit':['Rates & credit','利率与信用'],'fiscal':['Fiscal / policy','财政/政策'],'earnings':['Earnings mover','财报驱动'],'guidance':['Outlook change','指引变动'],'analyst':['Analyst action','分析师动作'],'deals':['M&amp;A / deal','并购交易'],'capital_return':['Capital return','资本回报'],'stocks':['Single-stock move','个股异动'],'macro':['Market context','市场背景']} %}
{% set EVL = {'earnings_result':['Earnings','财报'],'preannouncement':['Preannounce','业绩预告'],'guidance_raise':['Guidance ↑','上调指引'],'guidance_cut':['Guidance ↓','下调指引'],'analyst_estimate_revision':['Estimate rev.','盈测调整'],'rating_change':['Rating','评级'],'mna_confirmed':['M&amp;A','并购'],'mna_rumor':['M&amp;A rumor','并购传闻'],'equity_offering':['Offering','增发'],'buyback':['Buyback','回购'],'dividend_change':['Dividend','股息'],'contract_award':['Contract','中标'],'product_launch':['Launch','发布'],'product_delay':['Delay','延期'],'management_change':['Mgmt change','管理层'],'activist_campaign':['Activist','维权'],'litigation':['Litigation','诉讼'],'regulatory_probe':['Probe','监管调查'],'bankruptcy_restructuring':['Restructuring','重组'],'policy_trade_control':['Trade controls','贸易管制'],'macro_release':['Data release','数据发布']} %}

{# ---- helper: a story's plain-word "why it matters" ----------------------- #}
{% macro why(h) -%}
  {%- set w = THEME_WHY.get(h.theme, THEME_WHY['macro']) -%}
  {{ t(w[0], w[1]) }}
{%- endmacro %}

{# ---- helper: direction chip from an event / sentiment -------------------- #}
{% macro dirchip(h) -%}
  {%- set ev = h.event or {} -%}
  {%- set d = (ev.direction if ev is mapping else none) or h.ai_sentiment or h.sentiment -%}
  {%- if d in ['bullish','pos','positive','up'] -%}
    <span class="nx-chip dir-up">{{ t('Positive','偏多') }}</span>
  {%- elif d in ['bearish','neg','negative','down'] -%}
    <span class="nx-chip dir-down">{{ t('Negative','偏空') }}</span>
  {%- elif d in ['mixed'] -%}
    <span class="nx-chip dir-mixed">{{ t('Mixed','分化') }}</span>
  {%- endif -%}
{%- endmacro %}

{# ---- helper: theme / lane chip ------------------------------------------- #}
{% macro themechip(h) -%}
  {%- set tl = TL.get(h.theme) -%}
  {%- if tl -%}<span class="nx-chip th-{{ h.theme }}">{{ t(tl[0], tl[1]) }}</span>
  {%- else -%}{%- set ll = LANEL.get(h.lane or 'markets') -%}<span class="nx-chip th-{{ h.lane or 'markets' }}">{{ t(ll[0], ll[1]) }}</span>{%- endif -%}
{%- endmacro %}

{% block title %}Markets News — What matters now · Mastermind{% endblock %}

{%- block head_extra %}
{% set seo_title = "Markets News — Mastermind" %}
{% set seo_desc = "The market-moving business and macro news that matters now — importance-ranked, fresh, and de-noised. Stocks, the Fed, the economy and companies in one board." %}
{% set seo_path = "news.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
/* ===================== MARKETS NEWS — mx5 idiom ===================== */
.nxx{ --num:var(--font-mono,ui-monospace,"SF Mono",SFMono-Regular,"Cascadia Mono","JetBrains Mono",Menlo,Consolas,monospace);
  --nx-card:color-mix(in srgb, var(--panel) 80%, transparent);
  --nx-card-solid:var(--panel);
  --nx-card2:color-mix(in srgb, var(--panel2) 78%, transparent);
  --nx-brd:color-mix(in srgb, var(--text) 12%, transparent);
  --nx-hair:color-mix(in srgb, var(--line) 82%, transparent);
  --nx-blur:blur(16px) saturate(135%);
  --nx-radius:16px;
  --nx-shadow:0 12px 34px -18px rgba(0,0,0,.5), inset 0 1px 0 color-mix(in srgb,#fff 6%,transparent);
  position:relative; z-index:1; max-width:1200px; margin:0 auto; }
.nxx .num{ font-family:var(--num); font-variant-numeric:tabular-nums; letter-spacing:-.01em; }
.nxx a{ color:inherit; }

/* aurora backdrop — fixed, low-opacity, gentle breathe (opacity only) */
.nx-aurora{ position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
.nx-aurora::before,.nx-aurora::after{ content:""; position:absolute; width:60vw; height:60vw;
  border-radius:50%; filter:blur(90px); opacity:.5; }
.nx-aurora::before{ top:-18vw; left:-10vw;
  background:radial-gradient(circle, color-mix(in srgb,var(--link) 30%,transparent) 0%, transparent 70%);
  animation:nxAur 12s ease-in-out infinite; }
.nx-aurora::after{ bottom:-22vw; right:-12vw;
  background:radial-gradient(circle, color-mix(in srgb,var(--up) 22%,transparent) 0%, transparent 70%);
  animation:nxAur 15s ease-in-out infinite reverse; }
@keyframes nxAur{ 0%,100%{ opacity:.38; } 50%{ opacity:.62; } }

/* header */
.nx-head{ padding:8px 0 14px; }
.nx-eyebrow{ font-size:11px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--muted);
  display:flex; align-items:center; gap:8px; }
.nx-eyebrow .live{ width:7px; height:7px; border-radius:50%; background:var(--up);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--up) 26%,transparent); }
.nx-title{ font-size:30px; font-weight:800; letter-spacing:-.02em; margin:6px 0 4px; line-height:1.08;
  background:linear-gradient(110deg, var(--text) 0%, color-mix(in srgb,var(--link) 70%, var(--text)) 100%);
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
.nx-sub{ color:var(--muted); font-size:13px; max-width:60ch; }
.nx-updated{ font-size:11.5px; color:var(--muted); margin-top:6px; }
.nx-updated .num{ color:var(--text); }

/* ---- HERO ---- */
.nx-hero{ display:grid; grid-template-columns:minmax(0,1.55fr) minmax(0,1fr); gap:14px; margin:6px 0 20px; }
.nx-lead{ position:relative; padding:20px; border-radius:var(--nx-radius);
  background:var(--nx-card); border:1px solid var(--nx-brd); box-shadow:var(--nx-shadow);
  -webkit-backdrop-filter:var(--nx-blur); backdrop-filter:var(--nx-blur); overflow:hidden; }
.nx-lead::after{ content:""; position:absolute; inset:0; pointer-events:none; border-radius:inherit;
  box-shadow:inset 0 0 60px -20px var(--acc, var(--link)); opacity:0; animation:nxBreathe 4s ease-in-out infinite; }
@keyframes nxBreathe{ 0%,100%{ opacity:0; } 50%{ opacity:.55; } }
.nx-lead-eyebrow{ font-size:10.5px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;
  color:var(--acc, var(--link)); margin-bottom:10px; }
.nx-lead-row{ display:flex; gap:18px; align-items:flex-start; }
.nx-lead-body{ flex:1; min-width:0; }
.nx-lead-title{ display:block; font-size:22px; font-weight:800; line-height:1.22; letter-spacing:-.015em;
  margin-bottom:10px; text-wrap:balance; }
.nx-lead-title:hover{ color:var(--link); }
.nx-lead-why{ font-size:13px; color:var(--muted); margin:2px 0 12px; }
.nx-chips{ display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
.nx-lead-meta{ margin-top:12px; font-size:11.5px; color:var(--muted); display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
.nx-lead-meta .src{ color:var(--text); font-weight:600; }

/* impact ring (rank_score 0-100) */
.nx-impact{ --v:0; --acc:var(--link); flex:0 0 auto; width:60px; height:60px; border-radius:50%;
  display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative;
  background:conic-gradient(var(--acc) calc(var(--v)*1%), color-mix(in srgb,var(--text) 12%,transparent) 0); }
.nx-impact::before{ content:""; position:absolute; inset:4px; border-radius:50%; background:var(--nx-card-solid); }
.nx-impact b{ position:relative; font-size:17px; font-weight:800; line-height:1; font-family:var(--num); }
.nx-impact small{ position:relative; display:block; width:100%; padding:0 6px; margin-top:4px;
  font-size:8px; line-height:1; letter-spacing:.06em; text-align:center; white-space:nowrap;
  overflow:hidden; color:var(--muted); text-transform:uppercase; }

/* movers column */
.nx-movers{ display:flex; flex-direction:column; gap:8px; }
.nx-movers-hd{ font-size:10.5px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); padding:2px; }
.nx-mover{ display:flex; gap:10px; align-items:flex-start; padding:11px 12px; border-radius:12px;
  background:var(--nx-card2); border:1px solid var(--nx-hair); transition:border-color .18s, transform .18s; }
.nx-mover:hover{ border-color:var(--nx-brd); transform:translateY(-1px); }
.nx-mover-rank{ flex:0 0 auto; font-size:12px; font-weight:800; font-family:var(--num); color:var(--acc,var(--link));
  width:20px; text-align:center; padding-top:1px; }
.nx-mover-body{ min-width:0; }
.nx-mover-title{ font-size:13px; font-weight:600; line-height:1.3; display:block; }
.nx-mover-title:hover{ color:var(--link); }
.nx-mover-meta{ font-size:10.5px; color:var(--muted); margin-top:4px; display:flex; gap:6px; flex-wrap:wrap; align-items:center; }

/* ---- PULSE strip ---- */
.nx-pulse{ display:flex; flex-wrap:wrap; gap:8px; align-items:center; padding:12px 14px; margin-bottom:16px;
  border-radius:14px; background:var(--nx-card2); border:1px solid var(--nx-hair); }
.nx-pulse-lbl{ font-size:10.5px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); margin-right:2px; }
.nx-heat{ display:inline-flex; align-items:center; gap:5px; font-size:11.5px; font-weight:600; padding:4px 10px; border-radius:100px;
  background:color-mix(in srgb,var(--c,var(--muted)) 13%,transparent); color:color-mix(in srgb,var(--c,var(--muted)) 88%,var(--text));
  border:1px solid color-mix(in srgb,var(--c,var(--muted)) 28%,transparent); }
.nx-heat b{ font-family:var(--num); }
.nx-pulse-sent{ margin-left:auto; font-size:11.5px; color:var(--muted); display:inline-flex; align-items:center; gap:6px; }
.nx-pulse-sent .dot{ width:8px; height:8px; border-radius:50%; }

/* ---- CONTROLS: segmented + search ---- */
.nx-controls{ display:flex; gap:10px; align-items:center; margin-bottom:14px; flex-wrap:wrap; }
.seg{ display:inline-flex; gap:3px; padding:3px; border-radius:100px; background:var(--nx-card2); border:1px solid var(--nx-hair); }
.seg-btn{ appearance:none; border:0; background:transparent; color:var(--muted); font-family:inherit; font-size:12px; font-weight:600;
  padding:6px 13px; border-radius:100px; cursor:pointer; transition:background .16s,color .16s; white-space:nowrap; }
.seg-btn:hover{ color:var(--text); }
.seg-btn.on{ background:color-mix(in srgb,var(--link) 90%, var(--panel)); color:#fff; }
.nx-search{ flex:1; min-width:180px; max-width:360px; position:relative; }
.nx-search input{ width:100%; font-family:inherit; font-size:13px; color:var(--text); padding:9px 12px 9px 32px;
  border-radius:100px; background:var(--nx-card2); border:1px solid var(--nx-hair); outline:none; transition:border-color .16s; }
.nx-search input:focus{ border-color:color-mix(in srgb,var(--link) 55%,transparent); }
.nx-search svg{ position:absolute; left:11px; top:50%; transform:translateY(-50%); opacity:.5; }
.nx-count{ font-size:11px; color:var(--muted); font-family:var(--num); }

/* ---- FEED ---- */
.nx-feed{ display:flex; flex-direction:column; gap:9px; }
.nx-story{ display:flex; gap:13px; align-items:flex-start; padding:14px 15px; border-radius:14px;
  background:var(--nx-card); border:1px solid var(--nx-hair); box-shadow:var(--nx-shadow);
  -webkit-backdrop-filter:var(--nx-blur); backdrop-filter:var(--nx-blur); transition:border-color .18s, transform .18s; }
.nx-story:hover{ border-color:var(--nx-brd); transform:translateY(-1px); }
.nx-story.hide{ display:none; }
.nx-rankdot{ flex:0 0 auto; width:34px; height:34px; border-radius:9px; display:grid; place-items:center;
  font-family:var(--num); font-size:13px; font-weight:800; color:var(--acc,var(--link));
  background:color-mix(in srgb,var(--acc,var(--link)) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--acc,var(--link)) 26%,transparent); }
.nx-story-main{ min-width:0; flex:1; }
.nx-story-title{ font-size:15px; font-weight:600; line-height:1.32; display:block; letter-spacing:-.005em; }
.nx-story-title:hover{ color:var(--link); }
.nx-story .nx-chips{ margin-top:8px; }
.nx-meta{ margin-top:8px; font-size:11px; color:var(--muted); display:flex; flex-wrap:wrap; gap:7px; align-items:center; }
.nx-meta .src{ color:var(--text); font-weight:600; }
.nx-tk{ font-family:var(--num); font-size:10.5px; font-weight:700; color:var(--link);
  background:color-mix(in srgb,var(--link) 12%,transparent); padding:1px 6px; border-radius:5px; }
.nx-more{ margin:14px auto 4px; display:block; }
.nx-empty{ text-align:center; color:var(--muted); font-size:13px; padding:30px; }

/* ---- generic tinted chip ---- */
.nx-chip{ display:inline-flex; align-items:center; gap:4px; font-size:10.5px; font-weight:600; line-height:1.5;
  padding:2px 8px; border-radius:100px; white-space:nowrap;
  background:color-mix(in srgb,var(--c,var(--muted)) 14%,transparent);
  color:color-mix(in srgb,var(--c,var(--muted)) 90%,var(--text));
  border:1px solid color-mix(in srgb,var(--c,var(--muted)) 28%,transparent); }
.nx-chip.evt{ --c:var(--link); font-family:var(--num); }
.nx-chip.ai{ --c:var(--info); }
.nx-chip.tier{ --c:var(--muted); }
.dir-up{ --c:var(--up); } .dir-down{ --c:var(--down); } .dir-mixed{ --c:var(--warn); }
/* theme / lane hues */
.th-monetary,.th-fed{ --c:#c77dff; } .th-credit{ --c:#3fb6c0; }
.th-inflation{ --c:#e0973a; } .th-labor{ --c:#5b8def; } .th-growth{ --c:#46b87a; }
.th-fiscal{ --c:#d0877a; } .th-macro,.th-markets{ --c:#5b8def; }
.th-earnings,.th-guidance,.th-stocks,.th-companies{ --c:#46b87a; }
.th-analyst{ --c:#b48ead; } .th-deals,.th-capital_return{ --c:#e0973a; }

/* ---- two-column: releases + rail ---- */
.nx-cols{ display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:16px; margin-top:26px; align-items:start; }
.nx-sec-hd{ display:flex; align-items:center; gap:8px; margin:0 0 12px; font-size:15px; font-weight:800; letter-spacing:-.01em; }
.nx-sec-hd::before{ content:""; width:3px; height:16px; border-radius:2px; background:var(--link); }
.nx-sec-hd .n{ font-size:11px; font-weight:700; color:var(--muted); font-family:var(--num); }
.nx-rel-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:10px; }
.nx-rel{ padding:13px 14px; border-radius:12px; background:var(--nx-card); border:1px solid var(--nx-hair); }
.nx-rel-top{ display:flex; justify-content:space-between; align-items:baseline; gap:8px; margin-bottom:8px; }
.nx-rel-name{ font-size:13px; font-weight:700; }
.nx-rel-read{ font-size:11px; font-weight:700; }
.nx-rel-read.up{ color:var(--up); } .nx-rel-read.down{ color:var(--down); }
.nx-rel-cells{ display:flex; gap:14px; flex-wrap:wrap; }
.nx-rel-cell .k{ font-size:9.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
.nx-rel-cell .v{ font-size:15px; font-weight:800; font-family:var(--num); }
.nx-rel-sum{ margin-top:8px; font-size:11.5px; color:var(--muted); font-style:italic; }
.nx-badge{ font-size:9.5px; font-weight:700; letter-spacing:.05em; padding:2px 7px; border-radius:100px; }
.nx-badge.big{ background:color-mix(in srgb,var(--act) 16%,transparent); color:var(--act); }
.nx-badge.notable{ background:color-mix(in srgb,var(--warn) 16%,transparent); color:var(--warn); }

/* ---- rail ---- */
.nx-rail{ display:flex; flex-direction:column; gap:14px; position:sticky; top:14px; }
.nx-rail-card{ padding:14px; border-radius:14px; background:var(--nx-card); border:1px solid var(--nx-hair); }
.nx-rail-hd{ font-size:11px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:10px; }
.nx-line{ display:flex; gap:8px; align-items:baseline; padding:6px 0; border-top:1px solid var(--nx-hair); font-size:12px; }
.nx-line:first-of-type{ border-top:0; }
.nx-line .d{ font-family:var(--num); font-size:11px; color:var(--muted); flex:0 0 auto; min-width:44px; }
.nx-line .lbl{ flex:1; }
.nx-odds{ display:flex; justify-content:space-between; font-size:11.5px; padding:3px 0; }
.nx-odds .p{ font-family:var(--num); font-weight:700; }
.nx-rail-note{ font-size:10.5px; color:var(--muted); margin-top:8px; }

/* ---- diagnostics drawer ---- */
.nx-diag{ margin-top:26px; border-radius:12px; background:var(--nx-card2); border:1px solid var(--nx-hair); overflow:hidden; }
.nx-diag>summary{ cursor:pointer; padding:12px 14px; font-size:12px; font-weight:600; color:var(--muted); list-style:none; display:flex; gap:8px; align-items:center; }
.nx-diag>summary::-webkit-details-marker{ display:none; }
.nx-diag>summary::before{ content:"▸"; transition:transform .2s; }
.nx-diag[open]>summary::before{ transform:rotate(90deg); }
.nx-diag-body{ padding:0 14px 14px; font-size:11.5px; color:var(--muted); }
.nx-diag h4{ font-size:11px; text-transform:uppercase; letter-spacing:.08em; margin:12px 0 6px; color:var(--muted); }
.nx-diag table{ width:100%; border-collapse:collapse; font-size:11px; }
.nx-diag td{ padding:3px 6px; border-top:1px solid var(--nx-hair); vertical-align:top; }
.nx-diag .rej-reason{ color:var(--warn); font-weight:600; }
.nx-disc{ margin:22px 0 0; font-size:11px; color:var(--muted); font-style:italic; }

/* ======================= INTELLIGENCE DESK =======================
   The durable story layer above the arrival wire: clustered developments,
   evidence receipts, market context, and review-only X drafts. */
.nxi{ --nxi-accent:var(--info);
  /* the fold's hairline spine. --nx-hair is mixed off --line and all but
     vanishes on the dark panel, so the timeline rule is --text-derived (the
     same fix the wire's spine needed) and holds its weight in both themes. */
  --nxi-spine:color-mix(in srgb,var(--text) 15%,transparent);
  margin:0 0 18px; border-radius:20px; overflow:hidden;
  background:linear-gradient(145deg,color-mix(in srgb,var(--panel) 93%,transparent),
    color-mix(in srgb,var(--panel2) 82%,transparent));
  border:1px solid color-mix(in srgb,var(--nxi-accent) 24%,var(--nx-brd));
  box-shadow:0 18px 48px -30px color-mix(in srgb,var(--nxi-accent) 46%,transparent),
    var(--nx-shadow); -webkit-backdrop-filter:var(--nx-blur); backdrop-filter:var(--nx-blur); }
.nxi[hidden]{ display:none; }
.nxi-head{ display:grid; grid-template-columns:minmax(0,1fr) auto; gap:18px; padding:20px;
  border-bottom:1px solid var(--nx-hair); }
.nxi-kicker{ display:flex; align-items:center; gap:8px; color:var(--nxi-accent); font-size:10.5px;
  font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
.nxi-pulse{ width:8px; height:8px; border-radius:50%; background:var(--nxi-accent);
  box-shadow:0 0 0 4px color-mix(in srgb,var(--nxi-accent) 15%,transparent); }
.nxi[data-state="quiet"] .nxi-pulse{ background:transparent; border:1.5px solid var(--muted); box-shadow:none; }
.nxi-title{ margin:6px 0 4px; font-size:21px; line-height:1.16; font-weight:850; letter-spacing:-.02em; }
.nxi-sub{ margin:0; max-width:72ch; color:var(--muted); font-size:12.5px; line-height:1.5; }
.nxi-health{ align-self:center; min-width:152px; padding:10px 12px; border-radius:12px;
  background:color-mix(in srgb,var(--nxi-accent) 7%,transparent);
  border:1px solid color-mix(in srgb,var(--nxi-accent) 18%,transparent); }
.nxi-health strong{ display:block; font-size:12px; }
.nxi-health span{ display:block; margin-top:3px; color:var(--muted); font-size:10.5px; }
.nxi-metrics{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-bottom:1px solid var(--nx-hair); }
.nxi-metric{ padding:12px 16px; border-right:1px solid var(--nx-hair); }
.nxi-metric:last-child{ border-right:0; }
.nxi-metric b{ display:block; font-family:var(--num); font-size:19px; letter-spacing:-.02em; }
.nxi-metric span{ display:block; margin-top:2px; color:var(--muted); font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
.nxi-toolbar{ display:flex; gap:8px; align-items:center; flex-wrap:wrap; padding:12px 16px 4px; }
.nxi-filter{ appearance:none; border:1px solid var(--nx-hair); background:transparent; color:var(--muted);
  border-radius:100px; padding:5px 10px; font:600 11px/1.2 inherit; cursor:pointer; }
.nxi-filter:hover{ color:var(--text); border-color:var(--nx-brd); }
.nxi-filter.on{ color:var(--text); background:color-mix(in srgb,var(--nxi-accent) 12%,transparent);
  border-color:color-mix(in srgb,var(--nxi-accent) 36%,transparent); }
.nxi-toolbar-note{ margin-left:auto; color:var(--muted); font-size:10.5px; }
.nxi-list{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; padding:10px 16px 16px; }
.nxi-story{ min-width:0; border:1px solid var(--nx-hair); border-radius:14px; overflow:hidden;
  background:color-mix(in srgb,var(--panel) 78%,transparent); }
.nxi-story[data-stage="high_impact"]{ border-color:color-mix(in srgb,var(--act) 42%,var(--nx-hair)); }
.nxi-story[data-hidden="true"]{ display:none; }
.nxi-main{ padding:14px; }
.nxi-topline{ display:flex; gap:7px; align-items:center; flex-wrap:wrap; margin-bottom:8px; }
.nxi-stage,.nxi-lane,.nxi-sourcecount{ display:inline-flex; align-items:center; gap:4px; border-radius:100px;
  padding:2px 7px; font-size:9.5px; font-weight:750; letter-spacing:.05em; }
.nxi-stage{ color:var(--text); background:color-mix(in srgb,var(--muted) 13%,transparent);
  border:1px solid color-mix(in srgb,var(--muted) 24%,transparent); }
.nxi-stage.high_impact{ background:color-mix(in srgb,var(--act) 13%,transparent);
  border-color:color-mix(in srgb,var(--act) 32%,transparent); color:var(--act); }
.nxi-stage.confirmed{ background:color-mix(in srgb,var(--info) 11%,transparent);
  border-color:color-mix(in srgb,var(--info) 28%,transparent); color:var(--info); }
.nxi-lane,.nxi-sourcecount{ color:var(--muted); border:1px solid var(--nx-hair); }
.nxi-time{ margin-left:auto; color:var(--muted); font:10px/1.2 var(--num); }
.nxi-headline{ margin:0; font-size:15px; line-height:1.32; letter-spacing:-.008em; text-wrap:balance; }
.nxi-brief{ margin:7px 0 0; color:color-mix(in srgb,var(--text) 82%,var(--muted));
  font-size:12px; line-height:1.5; }
.nxi-why{ margin:9px 0 0; padding-left:9px; border-left:2px solid color-mix(in srgb,var(--nxi-accent) 38%,transparent);
  color:var(--muted); font-size:11.5px; line-height:1.45; }
.nxi-chips{ display:flex; flex-wrap:wrap; gap:5px; margin-top:10px; }
.nxi-chip{ border-radius:6px; padding:2px 6px; color:var(--muted); background:var(--nx-card2);
  border:1px solid var(--nx-hair); font-size:9.5px; }
.nxi-chip.market{ color:var(--text); font-family:var(--num); }
.nxi-chip.ticker{ color:var(--link); font-family:var(--num); font-weight:750; }
/* A story losing attention should READ quieter than one gaining it — but not in
   colour: red/green inverts under the zh convention, and the market chip beside
   it is deliberately neutral. The dashed edge is the same "less" grammar the
   wire uses on a single-report node, and the chip's own words already say it. */
.nxi-chip.pace-cooling{ border-style:dashed; }
/* zh only: this card is still showing the English original because no cached
   twin has been attached yet. ONE marker per card (Law 4 — a constant belongs
   once), set in the topline with the card's other provenance, italic like the
   wire's original-source marker. */
.nxi-orig{ color:var(--muted); font-size:9.5px; font-style:italic; }
.nxi-more{ border-top:1px solid var(--nx-hair); }
.nxi-more>summary{ list-style:none; cursor:pointer; padding:9px 14px; display:flex; gap:8px;
  align-items:center; color:var(--muted); font-size:11px; font-weight:650; }
.nxi-more>summary::-webkit-details-marker{ display:none; }
.nxi-more>summary::after{ content:"+"; margin-left:auto; font-family:var(--num); }
.nxi-more[open]>summary::after{ content:"−"; }
.nxi-detail{ display:grid; gap:12px; padding:0 14px 14px; }
.nxi-detail h4{ margin:0 0 6px; color:var(--muted); font-size:9.5px; letter-spacing:.12em; text-transform:uppercase; }
.nxi-evidence{ display:flex; flex-direction:column; gap:5px; }
.nxi-source{ display:flex; gap:8px; align-items:flex-start; padding:7px 8px; border-radius:8px;
  background:var(--nx-card2); font-size:10.5px; }
.nxi-source a{ color:var(--link); font-weight:650; }
.nxi-source span{ color:var(--muted); }

/* ---- the fold's two quiet receipt groups ----
   Source receipts above are filled pills (someone else published something).
   These two are drawn instead — a hairline spine and a left rule — so the three
   groups are told apart peripherally, and both stay visibly subordinate to the
   headline and the links. No hue, no motion: the wire below owns this page's
   one moving part, and every colour here would be a second one. */
.nxi-track{ display:grid; }
.nxi-tick{ position:relative; display:grid; grid-template-columns:32px 13px minmax(0,1fr);
  align-items:start; padding:3px 0; font-size:10.5px; line-height:1.5; }
.nxi-tick::before{ content:""; position:absolute; left:35px; top:0; bottom:0; width:1px;
  background:var(--nxi-spine); }
.nxi-tick:first-child::before{ top:10px; }
.nxi-tick:last-child::before{ bottom:auto; height:11px; }
/* A spine that STOPS at the last node claims that node is where the story
   began. When rows are clipped it is not, so the rule runs on and fades out —
   the wire's own way of saying the cut is depth, not the end of the thread. */
.nxi-track.is-clipped .nxi-tick:last-child::before{ bottom:-7px; height:auto;
  -webkit-mask-image:linear-gradient(to bottom,#000 38%,transparent 100%);
  mask-image:linear-gradient(to bottom,#000 38%,transparent 100%); }
.nxi-tick-age{ text-align:right; padding-right:9px; color:var(--muted);
  font:10px/1.6 var(--num); font-variant-numeric:tabular-nums;
  white-space:nowrap; overflow:hidden; }
.nxi-tick-node{ position:relative; }
/* FORM carries the kind, the label carries the meaning: a ROUND node is an
   arrival (the first report, a masthead joining), a SQUARE node is a change of
   state. Nothing here is load-bearing — every row says it in words too. */
.nxi-tick-node::after{ content:""; position:absolute; left:0; top:7px; width:7px; height:7px;
  box-sizing:border-box; border-radius:50%; z-index:1; background:var(--nx-card-solid);
  border:1.5px solid color-mix(in srgb,var(--text) 34%,transparent); }
.nxi-tick[data-kind="first_report"] .nxi-tick-node::after{
  background:color-mix(in srgb,var(--text) 52%,transparent);
  border-color:color-mix(in srgb,var(--text) 52%,transparent); }
.nxi-tick[data-kind="stage"] .nxi-tick-node::after{ border-radius:1px; }
.nxi-tick-label{ min-width:0; color:color-mix(in srgb,var(--text) 74%,transparent);
  overflow-wrap:anywhere; }
.nxi-tick-src{ color:var(--muted); }
.nxi-track-rest{ margin:3px 0 0 45px; color:var(--muted); font-size:10px; }
/* zh time units are two glyphs where English uses one letter ("28分钟" measures
   41px against "28m"), so the gutter is sized per language rather than clipped.
   Higher specificity than the 560px rule below on purpose: the string does not
   get shorter on a narrow screen.
   The track carries the age cell's own 9px padding-right (box-sizing is border-
   box repo-wide), so the 41px string needs 41+9 before any slack: at 46 the
   content box was 37px and the row silently clipped its LEADING glyph — an age
   that reads "8分钟" when the story is 28 minutes old, which is a wrong figure
   rather than a visibly cut one. 55/58/68 restores the intended 5px slack and
   keeps the spine and rest offsets on the same arithmetic (track + 3.5, +13). */
html[data-lang="zh"] .nxi-tick{ grid-template-columns:55px 13px minmax(0,1fr); }
html[data-lang="zh"] .nxi-tick::before{ left:58px; }
html[data-lang="zh"] .nxi-track-rest{ margin-left:68px; }
.nxi-facts{ display:flex; flex-direction:column; gap:6px; }
.nxi-fact{ padding-left:9px; border-left:2px solid color-mix(in srgb,var(--muted) 34%,transparent);
  font-size:10.5px; line-height:1.55; color:color-mix(in srgb,var(--text) 76%,transparent); }
/* house law: the mono face carries FIGURES, never words — "as of" stays in the
   text face and only the date crosses over. */
.nxi-asof{ color:var(--muted); font-size:9.5px; white-space:nowrap; }
.nxi-stampnum{ font-family:var(--num); font-variant-numeric:tabular-nums; }

.nxi-draft{ padding:10px; border-radius:10px; background:color-mix(in srgb,var(--nxi-accent) 6%,var(--nx-card2));
  border:1px solid color-mix(in srgb,var(--nxi-accent) 18%,var(--nx-hair)); }
.nxi-draft p{ margin:0; white-space:pre-wrap; font-size:11.5px; line-height:1.48; }
/* Which post this draft IS, in the same micro-caps voice as the group labels —
   read before the text, because a 280-character wire and a long post ask for
   very different review. */
.nxi-shape{ display:block; margin:0 0 5px; color:var(--muted); font-size:9px;
  font-weight:800; letter-spacing:.13em; text-transform:uppercase; }
.nxi-draftbar{ display:flex; gap:7px; align-items:center; margin-top:8px; color:var(--muted); font-size:9.5px; }
.nxi-copy{ appearance:none; margin-left:auto; cursor:pointer; border:1px solid color-mix(in srgb,var(--nxi-accent) 32%,transparent);
  background:transparent; color:var(--nxi-accent); border-radius:100px; padding:4px 9px; font:700 10px/1 inherit; }
.nxi-empty{ padding:24px 18px; color:var(--muted); font-size:12px; text-align:center; }
.nxi-state{ padding:20px; }
.nxi-state strong{ display:block; font-size:13px; }
.nxi-state p{ max-width:62ch; margin:5px 0 0; color:var(--muted); font-size:12px; line-height:1.5; }
.nxi-footer{ display:flex; justify-content:space-between; gap:12px; align-items:center; padding:10px 16px;
  border-top:1px solid var(--nx-hair); color:var(--muted); font-size:10.5px; }
.nxi-showmore{ appearance:none; border:0; background:transparent; color:var(--nxi-accent);
  font:700 11px/1 inherit; cursor:pointer; }
@media(max-width:760px){
  .nxi-head{ grid-template-columns:1fr; } .nxi-health{ min-width:0; }
  .nxi-list{ grid-template-columns:1fr; }
}
@media(max-width:560px){
  .nxi-head{ padding:16px; } .nxi-title{ font-size:19px; }
  .nxi-metrics{ grid-template-columns:repeat(2,1fr); }
  .nxi-metric:nth-child(2){ border-right:0; }
  .nxi-metric:nth-child(-n+2){ border-bottom:1px solid var(--nx-hair); }
  .nxi-toolbar-note{ width:100%; margin-left:0; }
  /* narrow the timeline's age gutter so the label column keeps its measure */
  .nxi-tick{ grid-template-columns:27px 13px minmax(0,1fr); }
  .nxi-tick::before{ left:30px; }
  .nxi-track-rest{ margin-left:40px; }
}

/* ======================= LIVE WIRE (B4b) =======================
   The page's ONE achromatic instrument. Everything above it is edited and
   colour-coded (ranked cards, tinted theme chips); the wire is the raw feed,
   so it is deliberately drained of hue. Colour appears in exactly two places —
   the state lamp and the newest item's node — and the panel is carried instead
   by its structure: a time gutter, an arrival spine, and a node whose FORM
   encodes how well the item is sourced (doctrine §7: non-verbal encodings that
   need no vocabulary). Hidden until the client has something honest to show. */
.nxw{ margin:0 0 18px; border-radius:var(--nx-radius); overflow:hidden;
  /* The page's --nx-hair is mixed off --line, which all but vanishes on the dark
     panel. The spine IS this panel, so it gets a --text-derived rule that holds
     its weight in both themes. */
  --nxw-spine:color-mix(in srgb, var(--text) 17%, transparent);
  --nxw-rule:color-mix(in srgb, var(--text) 11%, transparent);
  background:var(--nx-card); border:1px solid var(--nx-brd); box-shadow:var(--nx-shadow);
  -webkit-backdrop-filter:var(--nx-blur); backdrop-filter:var(--nx-blur); }
.nxw[hidden]{ display:none; }

/* header */
.nxw-hd{ padding:14px 16px 12px; border-bottom:1px solid var(--nxw-rule); }
.nxw-hd-main{ min-width:0; }
.nxw-eyebrow{ display:flex; align-items:center; gap:7px; font-size:10.5px; font-weight:700;
  letter-spacing:.16em; text-transform:uppercase; color:var(--muted); }
.nxw-lamp{ flex:0 0 auto; width:7px; height:7px; border-radius:50%;
  background:color-mix(in srgb,var(--text) 26%,transparent); }
.nxw[data-state="live"] .nxw-lamp{ background:var(--info);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--info) 20%,transparent); }
/* stale = the WIRE has gone quiet (newest item older than the stale window), not
   the daemon. The lamp hollows out, the newest-node accent is withdrawn, and the
   header says so in words — nothing here may keep signalling "live". */
.nxw[data-state="stale"] .nxw-lamp{ background:transparent;
  border:1.5px solid color-mix(in srgb,var(--text) 34%,transparent); }
.nxw-stale{ font-weight:700; letter-spacing:.06em; text-transform:uppercase;
  color:color-mix(in srgb,var(--text) 52%,transparent); }
.nxw-title{ font-size:15px; font-weight:800; letter-spacing:-.012em; margin:6px 0 3px; }
.nxw-sub{ font-size:12px; color:var(--muted); max-width:64ch; }
.nxw-meta{ margin-top:6px; font-size:10.5px; color:var(--muted); }
.nxw-meta .num{ color:color-mix(in srgb,var(--text) 74%,transparent); font-weight:600; }

/* The wire has NO filter row of its own: the page's All/Markets/Macro/Fed/
   Companies segment sits directly above and drives both lists. A second,
   near-duplicate pill row six inches from the first is two controls for one job. */
/* an empty LANE is the reader's filter, not a dead wire — it reads as a sentence,
   not as a blank box, and names the way back */
.nxw-lanenone{ margin:0; padding:18px 16px 16px 74px; font-size:12.5px; color:var(--muted); }
@media(max-width:560px){ .nxw-lanenone{ padding-left:20px; } }

/* list + arrival spine */
/* The window is capped so the wire never pushes the ranked board off the page.
   The fade tells you the clip is depth, not a broken row. */
.nxw-list{ max-height:394px; overflow-y:auto; overscroll-behavior:contain; padding:4px 16px 8px 0;
  -webkit-mask-image:linear-gradient(to bottom, #000 calc(100% - 34px), transparent 100%);
  mask-image:linear-gradient(to bottom, #000 calc(100% - 34px), transparent 100%); }
.nxw-list::-webkit-scrollbar{ width:8px; }
.nxw-list::-webkit-scrollbar-thumb{ background:var(--nxw-spine); border-radius:100px; }
.nxw-item{ position:relative; display:flex; align-items:flex-start; padding:9px 0; }
.nxw-item::before{ content:""; position:absolute; left:62px; top:0; bottom:0; width:1px;
  background:var(--nxw-spine); }
.nxw-item:first-child::before{ top:11px; }
.nxw-item:last-child::before{ bottom:auto; height:11px; }
.nxw-age{ flex:0 0 52px; text-align:right; padding-right:11px; font-family:var(--num); font-size:10.5px;
  font-variant-numeric:tabular-nums; letter-spacing:-.02em; color:var(--muted); line-height:1.95;
  white-space:nowrap; overflow:hidden; }
.nxw-node{ flex:0 0 21px; align-self:stretch; position:relative; }
.nxw-node::after{ content:""; position:absolute; left:0; top:6px; width:9px; height:9px; box-sizing:border-box;
  border-radius:50%; border:1.5px solid color-mix(in srgb,var(--text) 40%,transparent);
  background:var(--nx-card-solid); z-index:1; }
/* node FORM = how well sourced: filled = matched to the original;
   ringed dot = two or more independent sources; dashed = a single report */
.nxw-node[data-corr="verified"]::after{ background:color-mix(in srgb,var(--text) 60%,transparent);
  border-color:color-mix(in srgb,var(--text) 60%,transparent); }
.nxw-node[data-corr="sources"]::before{ content:""; position:absolute; left:3px; top:9px;
  width:3px; height:3px; border-radius:50%; z-index:2;
  background:color-mix(in srgb,var(--text) 58%,transparent); }
.nxw-node[data-corr="reports"]::after{ border-style:dashed;
  border-color:color-mix(in srgb,var(--text) 32%,transparent); }
/* wording the client does not recognise: plain ring, neither filled nor dashed */
.nxw-node[data-corr="neutral"]::after{ border-style:solid; }
/* the single accent + the single motion: the newest arrival */
.nxw[data-state="live"] .nxw-item.is-newest .nxw-node::after{ border-color:var(--info);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--info) 15%,transparent); animation:nxwLamp 2.8s ease-in-out infinite; }
@keyframes nxwLamp{ 0%,100%{ opacity:1; } 50%{ opacity:.5; } }

.nxw-body{ flex:1; min-width:0; padding-left:12px; }
.nxw-text{ margin:0; font-size:13.5px; line-height:1.5; font-weight:500; color:var(--text);
  letter-spacing:-.003em; text-wrap:pretty; }
.nxw-line{ margin-top:5px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;
  font-size:10.5px; color:var(--muted); }
.nxw-cls{ font-weight:700; letter-spacing:.09em; text-transform:uppercase;
  color:color-mix(in srgb,var(--text) 58%,transparent); }
.nxw-corr{ font-weight:600; }
.nxw-tapewrap{ display:inline-flex; align-items:baseline; gap:4px; }
.nxw-tape{ font-family:var(--num); font-variant-numeric:tabular-nums; font-weight:600;
  color:color-mix(in srgb,var(--text) 66%,transparent); }
.nxw-tapesfx{ opacity:.75; }
.nxw-orig{ font-style:italic; opacity:.8; }
.nxw-item.is-new{ animation:nxwIn .34s cubic-bezier(.22,.9,.3,1) both; }
@keyframes nxwIn{ from{ opacity:0; transform:translateY(-4px); } to{ opacity:1; transform:none; } }

/* honest non-list states: loading skeleton, quiet desk, signed-out, unreachable */
.nxw-state{ padding:20px 18px 22px 20px; }
.nxw-state .h{ font-size:13.5px; font-weight:700; color:var(--text); margin:0 0 4px; }
.nxw-state .s{ font-size:12px; color:var(--muted); margin:0; max-width:58ch; }
.nxw-state .cta{ appearance:none; font-family:inherit; margin-top:12px; cursor:pointer;
  display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:700; color:var(--info);
  background:transparent; border:1px solid color-mix(in srgb,var(--info) 40%,transparent);
  padding:7px 14px; border-radius:100px; transition:background .16s, border-color .16s; }
.nxw-state .cta:hover{ background:color-mix(in srgb,var(--info) 10%,transparent);
  border-color:color-mix(in srgb,var(--info) 65%,transparent); }
/* footer: one footnote + the quiet X handles */
.nxw-ft{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:11px 16px;
  border-top:1px solid var(--nxw-rule); background:color-mix(in srgb,var(--panel2) 40%,transparent); }
.nxw-note{ flex:1 1 260px; font-size:11px; color:var(--muted); }
.nxw-social{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.nxw-social>span{ font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase;
  color:var(--muted); margin-right:1px; }
.nxw-x{ display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:700;
  font-family:var(--num); color:color-mix(in srgb,var(--text) 80%,transparent); white-space:nowrap;
  padding:5px 11px; border-radius:100px; border:1px solid var(--nxw-rule);
  transition:color .16s, border-color .16s, background .16s; }
.nxw-x:hover{ color:var(--text); border-color:var(--nx-brd);
  background:color-mix(in srgb,var(--text) 6%,transparent); }
.nxw-x:focus-visible{ outline:2px solid var(--info); outline-offset:2px; }
.nxw-x svg{ width:10px; height:10px; flex:0 0 auto; }

@media(max-width:560px){
  .nxw-item::before{ left:52px; }
  .nxw-age{ flex-basis:44px; }
  .nxw-text{ font-size:13px; }
}
@media(prefers-reduced-motion:reduce){
  .nxw-item.is-new{ animation:none; }
  .nxw .nxw-item.is-newest .nxw-node::after{ animation:none; }
}
@media(pointer:coarse){ .nxw .nxw-item.is-newest .nxw-node::after{ animation:none; } }

/* ---- responsive ---- */
@media(max-width:900px){
  .nx-hero{ grid-template-columns:1fr; }
  .nx-cols{ grid-template-columns:1fr; }
  .nx-rail{ position:static; }
  .nx-title{ font-size:25px; }
}
@media(max-width:560px){
  .nx-lead{ padding:16px; } .nx-lead-title{ font-size:19px; }
  .nx-lead-row{ gap:14px; } .nx-impact{ width:50px; height:50px; }
  .nx-controls{ gap:8px; } .nx-search{ order:3; max-width:none; flex-basis:100%; }
}
/* motion / perf gates (mobile-perf law: opacity-only, killed on reduce/touch) */
@media(prefers-reduced-motion:reduce){ .nx-aurora::before,.nx-aurora::after,.nx-lead::after{ animation:none; } }
@media(pointer:coarse){ .nx-aurora::before,.nx-aurora::after,.nx-lead::after{ animation:none; } }
{% endblock %}

{% block content %}
<div class="nxx">
<div class="nx-aurora" aria-hidden="true"></div>

<header class="nx-head">
  <div class="nx-eyebrow"><span class="live"></span>{{ t('Markets News','市场新闻') }}</div>
  <h1 class="nx-title">{{ t('What matters now','当下要闻') }}</h1>
  <p class="nx-sub">{{ t('The market-moving business and macro news that matters now — importance-ranked, fresh, and de-noised.','此刻真正影响市场的商业与宏观新闻——按重要性排序、保持新鲜、去除噪音。') }}</p>
  <div class="nx-updated">{{ t('Updated','更新于') }} <span class="rel-time num" data-ts="{{ macro_news.fetched_at if macro_news else '' }}"></span>
    {% if FEED %}· <span class="num">{{ FEED|length }}</span> {{ t('stories ranked','条已排序') }}{% endif %}</div>
</header>

{# ============================ HERO ============================ #}
{% if LEAD %}
{% set lead_acc = 'var(--up)' if (LEAD.event and LEAD.event.direction in ['bullish']) or LEAD.ai_sentiment=='pos' or LEAD.sentiment=='pos' else ('var(--down)' if (LEAD.event and LEAD.event.direction in ['bearish']) or LEAD.ai_sentiment=='neg' or LEAD.sentiment=='neg' else 'var(--link)') %}
<section class="nx-hero">
  <div class="nx-lead" style="--acc:{{ lead_acc }};">
    <div class="nx-lead-eyebrow">{{ t('Top story','头条') }}</div>
    <div class="nx-lead-row">
      <div class="nx-impact" style="--v:{{ (LEAD.rank_score or 0)|round|int }}; --acc:{{ lead_acc }};">
        <b>{{ (LEAD.rank_score or 0)|round|int }}</b><small>{{ t('impact','影响') }}</small>
      </div>
      <div class="nx-lead-body">
        <a class="nx-lead-title" href="{{ LEAD.url }}" target="_blank" rel="noopener">{{ t(LEAD.title|e, (LEAD.title_zh or LEAD.title)|e) }}</a>
        <div class="nx-lead-why">{{ why(LEAD) }}</div>
        <div class="nx-chips">
          {{ themechip(LEAD) }}
          {% if LEAD.event and LEAD.event.event_type and EVL.get(LEAD.event.event_type) %}<span class="nx-chip evt">{{ t(EVL[LEAD.event.event_type][0], EVL[LEAD.event.event_type][1]) }}</span>{% endif %}
          {{ dirchip(LEAD) }}
          {% if LEAD.get('ai_importance') is not none %}<span class="nx-chip ai">✦ {{ t('AI-scored','AI评分') }}</span>{% endif %}
          {% for tk in (LEAD.tickers or [])[:4] %}<span class="nx-tk">{{ tk }}</span>{% endfor %}
        </div>
        <div class="nx-lead-meta">
          <span class="src">{{ LEAD.source_name or LEAD.source or LEAD.domain }}</span>
          <span>· <span class="rel-time" data-ts="{{ LEAD.seendate }}"></span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="nx-movers">
    <div class="nx-movers-hd">{{ t('Also big','同样重要') }}</div>
    {% for m in MOVERS %}
    {% set macc = 'var(--up)' if (m.event and m.event.direction=='bullish') or m.ai_sentiment=='pos' or m.sentiment=='pos' else ('var(--down)' if (m.event and m.event.direction=='bearish') or m.ai_sentiment=='neg' or m.sentiment=='neg' else 'var(--link)') %}
    <a class="nx-mover" href="{{ m.url }}" target="_blank" rel="noopener" style="--acc:{{ macc }};">
      <div class="nx-mover-rank">{{ loop.index + 1 }}</div>
      <div class="nx-mover-body">
        <span class="nx-mover-title">{{ t(m.title|e, (m.title_zh or m.title)|e) }}</span>
        <div class="nx-mover-meta">{{ themechip(m) }}<span>{{ m.source_name or m.source or m.domain }}</span>·<span class="rel-time" data-ts="{{ m.seendate }}"></span></div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ============================ PULSE ============================ #}
{% set theme_counts = {} %}
{% for h in heads %}
  {% if h.theme %}{% set _ = theme_counts.update({h.theme: theme_counts.get(h.theme,0)+1}) %}{% endif %}
{% endfor %}
{% if theme_counts %}
<div class="nx-pulse">
  <span class="nx-pulse-lbl">{{ t('Theme pulse','主题热度') }}</span>
  {% for th, cnt in (theme_counts.items()|sort(attribute='1', reverse=true))[:7] %}
    {% set tl = TL.get(th) %}
    <span class="nx-heat th-{{ th }}">{{ t(tl[0] if tl else th, tl[1] if tl else th) }} <b>{{ cnt }}</b></span>
  {% endfor %}
  {% if NS_STATE %}
  <span class="nx-pulse-sent"><span class="dot" style="background:{{ 'var(--up)' if NS_STATE in ['optimistic','positive'] else 'var(--down)' }};"></span>
    {{ t('News tone','新闻情绪') }}: {{ t('upbeat','偏乐观') if NS_STATE in ['optimistic','positive'] else t('cautious','偏谨慎') }}</span>
  {% endif %}
</div>
{% endif %}

{# ============================ CONTROLS + FEED ============================ #}
{% if FEED %}
<div class="nx-controls">
  <div class="seg" id="nxSeg" role="tablist">
    <button class="seg-btn on" data-lane="all">{{ t('All','全部') }}</button>
    <button class="seg-btn" data-lane="markets">{{ t('Markets','市场') }}</button>
    <button class="seg-btn" data-lane="macro">{{ t('Macro','宏观') }}</button>
    <button class="seg-btn" data-lane="fed">{{ t('Fed','美联储') }}</button>
    <button class="seg-btn" data-lane="companies">{{ t('Companies','公司') }}</button>
  </div>
  <div class="nx-search">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <input type="search" id="nxSearch" data-ph-en="Search headlines, tickers…" data-ph-zh="搜索标题、代码…" placeholder="Search headlines, tickers…" aria-label="Search news">
  </div>
  <span class="nx-count" id="nxCount"></span>
</div>
{% endif %}

{# ==================== INTELLIGENCE DESK ====================
   Client-hydrated from the host-local story store. Hidden on a true 404 so a
   deployment with no daemon artifact does not advertise a dead feature. #}
<section class="nxi" id="nxIntel" data-state="loading" hidden>
  <div class="nxi-head">
    <div>
      <div class="nxi-kicker"><span class="nxi-pulse"></span>{{ t('Live story graph','实时事件图谱') }}</div>
      <h2 class="nxi-title">{{ t('Intelligence Desk','情报工作台') }}</h2>
      <p class="nxi-sub">{{ t('One developing story per card — repeated reports merged, source receipts attached, market context checked, and X drafts held for review.','每张卡片对应一个持续发展的事件——合并重复报道、附上来源依据、核对市场背景，并将 X 草稿留待审核。') }}</p>
    </div>
    <div class="nxi-health">
      <strong id="nxIntelHealth">{{ t('Connecting to the desk','正在连接工作台') }}</strong>
      <span id="nxIntelUpdated"></span>
    </div>
  </div>
  <div class="nxi-metrics" id="nxIntelMetrics" hidden>
    <div class="nxi-metric"><b id="nxiActive">—</b><span>{{ t('Active stories','活跃事件') }}</span></div>
    <div class="nxi-metric"><b id="nxiConfirmed">—</b><span>{{ t('Confirmed','已确认') }}</span></div>
    <div class="nxi-metric"><b id="nxiDrafts">—</b><span>{{ t('Draft-ready','草稿就绪') }}</span></div>
    <div class="nxi-metric"><b id="nxiSources">—</b><span>{{ t('Sources in view','当前来源') }}</span></div>
  </div>
  <div class="nxi-toolbar" id="nxIntelToolbar" hidden>
    <button class="nxi-filter on" data-intel-filter="all">{{ t('All stories','全部事件') }}</button>
    <button class="nxi-filter" data-intel-filter="high_impact">{{ t('High impact','高影响') }}</button>
    <button class="nxi-filter" data-intel-filter="confirmed">{{ t('Confirmed','已确认') }}</button>
    <button class="nxi-filter" data-intel-filter="draft">{{ t('Draft ready','草稿就绪') }}</button>
    <span class="nxi-toolbar-note">{{ t('Outbound posting is separate and remains review-gated.','对外发布为独立流程，仍需人工审核。') }}</span>
  </div>
  <div class="nxi-list" id="nxIntelList" hidden></div>
  <div class="nxi-state" id="nxIntelState" hidden></div>
  <div class="nxi-footer" id="nxIntelFooter" hidden>
    <span>{{ t('Context, not a trade signal. Open a card for evidence and draft provenance.','这里是背景信息，不是交易信号。展开卡片可查看证据与草稿来源。') }}</span>
    <button class="nxi-showmore" id="nxIntelMore" hidden>{{ t('Show more stories','显示更多事件') }}</button>
  </div>
</section>

{# ==================== LIVE WIRE (B4b) ====================
   Client-hydrated from /live/wires.json (free_registered — see config/site_access.yml).
   Ships HIDDEN and stays hidden when the wire is not published at this deployment:
   a feature that is not live must not advertise its own absence. Every other
   outcome — signed out, quiet desk, unreachable — gets an honest named state,
   never a blank list. #}
<section class="nxw" id="nxWire" data-state="loading" hidden>
  <div class="nxw-hd">
    <div class="nxw-hd-main">
      <div class="nxw-eyebrow"><span class="nxw-lamp"></span>{{ t('Live wire','实时快讯') }}</div>
      <h2 class="nxw-title">{{ t('What just crossed','最新快讯') }}</h2>
      <p class="nxw-sub">{{ t('Every headline our desk sees, in the order it landed.','我们的编辑台收到的每一条消息，按到达顺序排列。') }}</p>
      <div class="nxw-meta" id="nxWireMeta"></div>
    </div>
  </div>

  <div class="nxw-list" id="nxWireList" hidden></div>
  <div class="nxw-state" id="nxWireState" hidden></div>

  <div class="nxw-ft">
    <div class="nxw-note">{{ t('Context, not a trade signal — the ranked board below is the edited read.','这里是背景信息，不是交易信号——下方排序榜才是经过筛选的解读。') }}</div>
    <div class="nxw-social">
      <span>{{ t('On X','X 账号') }}</span>
      <a class="nxw-x" href="https://x.com/mastermindx001" target="_blank" rel="noopener"
         data-tip-en="The evidence desk. Charts, state changes and receipts from the same engines that build this page."
         data-tip-zh="证据台账号。图表、状态变化与依据，来自构建本页的同一套引擎。">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.22-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.11l11.97 15.64Z"/></svg>@mastermindx001</a>
    </div>
  </div>
</section>

{% if FEED %}
<section class="nx-feed" id="nxFeed">
  {% for h in FEED %}
  {% set acc = 'var(--up)' if (h.event and h.event.direction=='bullish') or h.ai_sentiment=='pos' or h.sentiment=='pos' else ('var(--down)' if (h.event and h.event.direction=='bearish') or h.ai_sentiment=='neg' or h.sentiment=='neg' else 'var(--link)') %}
  <article class="nx-story{{ ' hide' if loop.index0 >= 24 else '' }}" data-lane="{{ h.lane or 'markets' }}"
           data-idx="{{ loop.index0 }}"
           data-search="{{ ((h.title or '') ~ ' ' ~ (h.tickers|join(' ') if h.tickers else '') ~ ' ' ~ (h.source_name or h.source or h.domain or ''))|lower|e }}"
           style="--acc:{{ acc }};">
    <div class="nx-rankdot">{{ (h.rank_score or 0)|round|int }}</div>
    <div class="nx-story-main">
      <a class="nx-story-title" href="{{ h.url }}" target="_blank" rel="noopener">{{ t(h.title|e, (h.title_zh or h.title)|e) }}</a>
      <div class="nx-chips">
        {{ themechip(h) }}
        {% if h.event and h.event.event_type and EVL.get(h.event.event_type) %}<span class="nx-chip evt">{{ t(EVL[h.event.event_type][0], EVL[h.event.event_type][1]) }}</span>{% endif %}
        {{ dirchip(h) }}
        {% if h.get('ai_importance') is not none %}<span class="nx-chip ai">✦ AI</span>{% endif %}
      </div>
      <div class="nx-meta">
        <span class="src">{{ h.source_name or h.source or h.domain }}</span>
        <span>·</span><span class="rel-time" data-ts="{{ h.seendate }}"></span>
        {% for tk in (h.tickers or [])[:5] %}<span class="nx-tk">{{ tk }}</span>{% endfor %}
      </div>
    </div>
  </article>
  {% endfor %}
  <div class="nx-empty" id="nxEmpty" style="display:none;">{{ t('No stories match — try another lane or clear the search.','没有匹配的新闻——换个分类或清空搜索。') }}</div>
</section>
{% if FEED|length > 24 %}<button class="gbtn nx-more" id="nxMore">{{ t('Show more','显示更多') }} <span class="num">(+{{ FEED|length - 24 }})</span></button>{% endif %}
{% else %}
<div class="nx-empty">{{ t('The news tape is quiet right now — check back shortly.','新闻此刻较为平静——稍后再来。') }}</div>
{% endif %}

{# ==================== RELEASES + RAIL ==================== #}
<div class="nx-cols">
  <main>
    {% if releases %}
    <h2 class="nx-sec-hd">{{ t('Latest economic releases','最新经济数据') }} <span class="n">{{ releases|length }}</span></h2>
    <div class="nx-rel-grid">
      {% for c in releases[:8] %}
      <div class="nx-rel">
        <div class="nx-rel-top">
          <span class="nx-rel-name">{{ c.display_name or c.release }}</span>
          {% if c.surprise_size == 'large' %}<span class="nx-badge big">{{ t('Large','大幅') }}</span>
          {% elif c.surprise_size == 'notable' %}<span class="nx-badge notable">{{ t('Notable','显著') }}</span>{% endif %}
        </div>
        {% if c.direction_tag %}<div class="nx-rel-read {{ 'up' if c.direction_tag in ['bullish','up'] else 'down' if c.direction_tag in ['bearish','down'] else '' }}">
          {{ t('↑ Bullish read','↑ 偏多解读') if c.direction_tag in ['bullish','up'] else t('↓ Bearish read','↓ 偏空解读') if c.direction_tag in ['bearish','down'] else t('Neutral','中性') }}</div>{% endif %}
        <div class="nx-rel-cells">
          {% if c.get('actual') is not none %}<div class="nx-rel-cell"><div class="k">{{ t('Actual','实际') }}{% if c.period %} · {{ c.period }}{% endif %}</div><div class="v">{{ c.actual }}</div></div>{% endif %}
          {% if c.get('prior') is not none %}<div class="nx-rel-cell"><div class="k">{{ c.prior_label or t('Prior','前值') }}</div><div class="v">{{ c.prior }}</div></div>{% endif %}
        </div>
        {% if c.summary %}<div class="nx-rel-sum">{{ c.summary }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </main>

  <aside class="nx-rail">
    {% if catalysts or estrip %}
    <div class="nx-rail-card">
      <div class="nx-rail-hd">{{ t('Calendar ahead','未来日程') }}</div>
      {% for c in catalysts[:5] %}
      <div class="nx-line"><span class="d">{{ c.date[5:] if c.date else '' }}{% if c.time_et %} {{ c.time_et }}{% endif %}</span>
        <span class="lbl">{{ t(c.label|e, (c.label_zh or c.label)|e) }}</span></div>
      {% endfor %}
      {% for s in estrip[:5] %}
      <div class="nx-line"><span class="d">{{ s.dow }} {{ s.md }}</span><span class="lbl">{{ t(s.label|e, (s.label_zh or s.label)|e) }}</span></div>
      {% endfor %}
      {% if not catalysts and not estrip %}<div class="nx-rail-note">{{ t('No scheduled events in the window.','窗口内暂无排定事件。') }}</div>{% endif %}
    </div>
    {% endif %}

    {% if pmkts %}
    <div class="nx-rail-card">
      <div class="nx-rail-hd">{{ t('Market-implied odds','市场隐含概率') }}</div>
      {% for e in pmkts[:3] %}
      <div style="margin-bottom:8px;">
        <div style="font-size:11.5px;font-weight:600;margin-bottom:3px;">{{ t(e.label_en|e, (e.label_zh or e.label_en)|e) }}</div>
        {% for o in (e.outcomes or [])[:3] %}
        <div class="nx-odds"><span>{{ o.outcome }}</span><span class="p">{{ o.prob }}%</span></div>
        {% endfor %}
      </div>
      {% endfor %}
      <div class="nx-rail-note">{{ t('Crowd expectation, not a forecast.','群体预期，非预测。') }}</div>
    </div>
    {% endif %}

    {% if SYN.top_tickers or SYN.top_channels %}
    <div class="nx-rail-card">
      <div class="nx-rail-hd">{{ t('In focus','焦点') }}</div>
      {% if SYN.top_tickers %}<div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;">{% for tk in SYN.top_tickers[:8] %}<span class="nx-tk">{{ tk }}</span>{% endfor %}</div>{% endif %}
      {% if NS_STATE %}<div class="nx-rail-note">{{ t('News tone','新闻情绪') }}: <b style="color:{{ 'var(--up)' if NS_STATE in ['optimistic','positive'] else 'var(--down)' }};">{{ t('upbeat','偏乐观') if NS_STATE in ['optimistic','positive'] else t('cautious','偏谨慎') }}</b>{% if NS_Z is not none %} <span class="num">(z {{ NS_Z|round(1) }})</span>{% endif %}</div>{% endif %}
    </div>
    {% endif %}
  </aside>
</div>

{# ==================== DIAGNOSTICS (collapsed) ==================== #}
{% if rejected_all or calib_classes %}
<details class="nx-diag">
  <summary>{{ t('Newsroom diagnostics','新闻室诊断') }} <span class="num" style="color:var(--muted)">({{ rejected_all|length }} {{ t('filtered','已过滤') }}{% if calib_classes %} · {{ calib_classes|length }} {{ t('classes','类别') }}{% endif %})</span></summary>
  <div class="nx-diag-body">
    <p>{{ t('Advanced: how the de-noising filter and event-class calibration are performing. Nothing here changes what you see above; it is the newsroom&#39;s own scorecard.','进阶：去噪过滤器与事件类别校准的运行情况。此处不影响上方内容，仅为新闻室自评。') }}</p>
    {% if rejected_all %}
    <h4>{{ t('Filtered out','已过滤') }}</h4>
    <table><tbody>
      {% for r in rejected_all[:12] %}
      <tr><td class="rej-reason">{{ (r.reason or 'other')|replace('_',' ') }}</td><td>{{ (r.title or '')[:80]|e }}</td><td class="num">{{ r.domain }}</td></tr>
      {% endfor %}
    </tbody></table>
    {% endif %}
    {% if calib_classes %}
    <h4>{{ t('Event-class calibration (accruing)','事件类别校准（累积中）') }}</h4>
    <table><tbody>
      {% for cc in calib_classes[:10] %}
      <tr><td>{{ (cc.event_type or '')|replace('_',' ')|title }}</td><td class="num">n={{ cc.n or 0 }}</td><td>{{ cc.verdict or 'accruing' }}</td></tr>
      {% endfor %}
    </tbody></table>
    {% endif %}
  </div>
</details>
{% endif %}

{% if macro_news_disclaimer %}<p class="nx-disc">{{ t(macro_news_disclaimer, macro_news_disclaimer_zh or macro_news_disclaimer) }}</p>{% endif %}
</div>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  // ---- relative-time stamps (bilingual; re-run on language change) ----
  function rel(ts){
    if(!ts) return '';
    var t=Date.parse(ts); if(isNaN(t)) return '';
    var s=Math.max(0,(Date.now()-t)/1000), zh=document.documentElement.getAttribute('data-lang')==='zh';
    if(s<60) return zh?'刚刚':'just now';
    var m=s/60; if(m<60) return Math.floor(m)+(zh?'分钟前':'m ago');
    var h=m/60; if(h<24) return Math.floor(h)+(zh?'小时前':'h ago');
    var d=h/24; return Math.floor(d)+(zh?'天前':'d ago');
  }
  function stamps(){ document.querySelectorAll('.rel-time[data-ts]').forEach(function(el){ el.textContent=rel(el.getAttribute('data-ts')); }); }
  stamps(); window.addEventListener('langchange', stamps);

  // ---- bilingual search placeholder (set here, never as t() inside an attribute) ----
  function setPh(){ var s=document.getElementById('nxSearch'); if(!s) return;
    var zh=document.documentElement.getAttribute('data-lang')==='zh';
    s.placeholder = s.getAttribute(zh?'data-ph-zh':'data-ph-en') || s.placeholder; }
  setPh(); window.addEventListener('langchange', setPh);

  // ---- lane + search filter over the ranked feed ----
  var feed=document.getElementById('nxFeed');
  if(feed){
    var stories=[].slice.call(feed.querySelectorAll('.nx-story'));
    var seg=document.getElementById('nxSeg'), search=document.getElementById('nxSearch');
    var countEl=document.getElementById('nxCount'), emptyEl=document.getElementById('nxEmpty');
    var moreBtn=document.getElementById('nxMore');
    var lane='all', q='', expanded=false, CAP=24;
    function apply(){
      var shown=0;
      stories.forEach(function(el){
        var okLane = lane==='all' || el.getAttribute('data-lane')===lane;
        var okQ = !q || (el.getAttribute('data-search')||'').indexOf(q)>=0;
        var within = expanded || q || lane!=='all' || shown<CAP;
        if(okLane && okQ){
          if(within){ el.classList.remove('hide'); shown++; }
          else { el.classList.add('hide'); }
        } else { el.classList.add('hide'); }
      });
      var total=stories.filter(function(el){
        var okLane=lane==='all'||el.getAttribute('data-lane')===lane;
        var okQ=!q||(el.getAttribute('data-search')||'').indexOf(q)>=0; return okLane&&okQ;
      }).length;
      if(countEl) countEl.textContent = total+(document.documentElement.getAttribute('data-lang')==='zh'?' 条':' shown');
      if(emptyEl) emptyEl.style.display = total? 'none':'block';
      if(moreBtn) moreBtn.style.display = (!expanded && !q && lane==='all' && total>CAP)? '':'none';
    }
    if(seg) seg.addEventListener('click', function(e){
      var b=e.target.closest('.seg-btn'); if(!b) return;
      seg.querySelectorAll('.seg-btn').forEach(function(x){ x.classList.remove('on'); });
      b.classList.add('on'); lane=b.getAttribute('data-lane'); apply();
    });
    if(search) search.addEventListener('input', function(){ q=this.value.trim().toLowerCase(); apply(); });
    if(moreBtn) moreBtn.addEventListener('click', function(){ expanded=true; apply(); });
    window.addEventListener('langchange', apply);
    apply();
  }

  // ---- INTELLIGENCE DESK -----------------------------------------------------
  // The daemon merges fast arrivals into durable story packets at
  // /live/intelligence.json. Every visible string derived from a source or draft
  // is assigned through textContent; nothing from the live payload becomes HTML.
  (function(){
    var box=document.getElementById('nxIntel');
    if(!box || !window.fetch) return;
    var listEl=document.getElementById('nxIntelList');
    var stateEl=document.getElementById('nxIntelState');
    var metricsEl=document.getElementById('nxIntelMetrics');
    var toolbarEl=document.getElementById('nxIntelToolbar');
    var footerEl=document.getElementById('nxIntelFooter');
    var moreEl=document.getElementById('nxIntelMore');
    var healthEl=document.getElementById('nxIntelHealth');
    var updatedEl=document.getElementById('nxIntelUpdated');
    if(!listEl || !stateEl) return;

    var URL_='live/intelligence.json', POLL=(window.LIVE_POLL_SEC||60)*1000;
    var TIMEOUT=10000, CAP=8, stories=[], health={}, updatedAt='', filter='all';
    var expanded=false, mode='loading', inflight=false, timerId=null;
    // The payload carries up to 12 timeline rows; the fold shows the newest few
    // and counts the rest. The receipts above it must stay the bigger group.
    var TL_SHOWN=6, FACTS_SHOWN=3, SHAPE_ORDER=['wire','analysis','long_post'];

    function zh(){ return document.documentElement.getAttribute('data-lang')==='zh'; }
    function tx(en,zv){ return zh() ? zv : en; }
    function text(node,value){ node.textContent=String(value==null?'':value); return node; }
    function el(tag,cls,value){
      var node=document.createElement(tag); if(cls) node.className=cls;
      if(value!=null) text(node,value); return node;
    }
    function age(value){
      var ms=Date.parse(String(value||'')); if(!isFinite(ms)) return tx('recent','刚刚');
      var mins=Math.max(0,Math.floor((Date.now()-ms)/60000));
      if(mins<1) return tx('now','刚刚');
      if(mins<60) return mins+tx('m','分钟');
      var hrs=Math.floor(mins/60); if(hrs<24) return hrs+tx('h','小时');
      return Math.floor(hrs/24)+tx('d','天');
    }
    function stageLabel(stage){
      return ({
        high_impact:tx('High impact','高影响'),
        confirmed:tx('Confirmed','已确认'),
        developing:tx('Developing','发展中')
      })[stage] || tx('Developing','发展中');
    }
    function knownContext(value){
      var map={
        'Primary source':tx('Primary source','第一手来源'),
        'Multiple reports':tx('Multiple reports','多方报道'),
        'Single report':tx('Single report','单一报道'),
        'Rising':tx('Attention rising','关注升温'),
        'Cooling':tx('Attention cooling','关注降温'),
        'New':tx('New arrival','新近出现'),
        'Active':tx('Still active','持续跟踪'),
        'Primary / top-tier':tx('Primary / top-tier','一手／顶级来源'),
        'Established press':tx('Established press','主流媒体'),
        'Aggregator':tx('Aggregator','聚合来源'),
        'Unrated source':tx('Source not yet rated','来源尚未评级')
      };
      return map[String(value||'')] || String(value||'');
    }
    // ONE vocabulary for a post's shape, shared by the content-route chips and
    // the review queue, so the fold can never label the same thing two ways —
    // and never with the raw slug (a machine slug is prettified, not printed).
    function shapeLabel(value){
      var slug=String(value||'');
      var map={
        wire:tx('Wire','快讯'),
        analysis:tx('Analysis','分析'),
        thread:tx('Long post','长帖'),
        long_post:tx('Long post','长帖')
      };
      return map[slug] || slug.replace(/[_-]+/g,' ')
        .replace(/^./,function(c){ return c.toUpperCase(); });
    }
    // Canonical slots: one draft per shape, the wire first. A payload with no
    // `shape` on any draft predates the slots — render it exactly as before
    // (the newest two) rather than inventing an order it never had.
    function draftSlots(drafts){
      if(!drafts.some(function(d){ return d.shape; })){
        return drafts.slice().reverse().slice(0,2);
      }
      var seen={}, slots=[];
      drafts.forEach(function(d){
        var key=String(d.shape||'');
        if(seen[key]) return;
        seen[key]=true; slots.push(d);
      });
      slots.sort(function(a,b){
        var ai=SHAPE_ORDER.indexOf(String(a.shape||''));
        var bi=SHAPE_ORDER.indexOf(String(b.shape||''));
        return (ai<0?9:ai)-(bi<0?9:bi);
      });
      return slots.slice(0,3);
    }
    // zh prefers the cached twin; with no twin the card shows the English
    // original and says so ONCE, the way an evidence row already does.
    function readable(story){
      var enHead=String(story.headline||''), enBrief=String(story.brief||'');
      if(enBrief===enHead) enBrief='';
      var headline=enHead, brief=enBrief, original=false;
      if(zh()){
        if(story.headline_zh) headline=String(story.headline_zh); else original=true;
        if(enBrief){
          if(story.brief_zh) brief=String(story.brief_zh); else original=true;
        }
      }
      if(brief===headline) brief='';
      return {
        headline:headline||tx('Untitled development','未命名事件'),
        brief:brief, original:original
      };
    }
    function tickKind(value){
      var slug=String(value||'');
      return (slug==='first_report'||slug==='stage') ? slug : 'new_source';
    }
    // In a chronology, an unreadable stamp is not "recent" — saying so would
    // claim a freshness the row cannot support. It reads as unknown instead.
    function tickAge(value){
      return isFinite(Date.parse(String(value||''))) ? age(value) : '—';
    }
    // A freshness stamp, not a timestamp: the month-day is enough inside the
    // current year, and an off-year artifact prints its year rather than lying
    // about how recent it is. Anything that is not a date is not a figure, so
    // it is dropped rather than set in the numeral face.
    function asOf(value){
      var m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(value||'').trim());
      if(!m) return '';
      return (Number(m[1])===new Date().getFullYear()) ? (m[2]+'-'+m[3]) : m[0];
    }
    function timelineGroup(story){
      var rows=(story.timeline||[]).filter(function(r){
        return r && typeof r==='object' && (r.label_en||r.label_zh);
      });
      if(!rows.length) return null;
      var wrap=el('div','');
      wrap.appendChild(el('h4','',tx('Development timeline','事件进展')));
      var track=el('div','nxi-track'+(rows.length>TL_SHOWN?' is-clipped':''));
      rows.slice(0,TL_SHOWN).forEach(function(row){
        var tick=el('div','nxi-tick');
        tick.setAttribute('data-kind',tickKind(row.kind));
        tick.appendChild(el('div','nxi-tick-age',tickAge(row.ts)));
        tick.appendChild(el('div','nxi-tick-node'));
        var label=zh()?(row.label_zh||row.label_en):(row.label_en||row.label_zh);
        var body=el('div','nxi-tick-label',label);
        // The engine's label already names the source; append it only if a
        // future label template stops doing so, never as a repeat.
        var name=String(row.source_name||'');
        if(name && String(label||'').indexOf(name)<0){
          body.appendChild(el('span','nxi-tick-src',' · '+name));
        }
        tick.appendChild(body); track.appendChild(tick);
      });
      wrap.appendChild(track);
      var rest=rows.length-TL_SHOWN;
      if(rest>0){
        wrap.appendChild(el('p','nxi-track-rest',
          tx('+'+rest+' earlier','另有 '+rest+' 条更早')));
      }
      return wrap;
    }
    // Facts our own engines hold about the names in this story — separate
    // provenance from the press receipts above, so it gets its own group and
    // its own as-of. The `kind` slug stays machine-side; the line says it.
    function factsGroup(story){
      var rows=(story.engine_context||[]).filter(function(r){
        return r && typeof r==='object' && (r.line_en||r.line_zh);
      });
      if(!rows.length) return null;
      var wrap=el('div','');
      wrap.appendChild(el('h4','',tx('From our own data','我们的数据')));
      var list=el('div','nxi-facts');
      rows.slice(0,FACTS_SHOWN).forEach(function(row){
        var line=zh()?(row.line_zh||row.line_en):(row.line_en||row.line_zh);
        var node=el('div','nxi-fact',line);
        var stamp=asOf(row.as_of);
        if(stamp){
          var mark=el('span','nxi-asof',' · '+tx('as of ','数据截至 '));
          mark.appendChild(el('span','nxi-stampnum',stamp));
          node.appendChild(mark);
        }
        list.appendChild(node);
      });
      wrap.appendChild(list); return wrap;
    }
    function draftReady(story){
      return (story.drafts||[]).some(function(d){ return d && d.status==='review'; });
    }
    function matches(story){
      if(filter==='all') return true;
      if(filter==='high_impact') return story.stage==='high_impact';
      if(filter==='confirmed') return story.stage==='confirmed'||story.stage==='high_impact';
      if(filter==='draft') return draftReady(story);
      return true;
    }
    function safeUrl(value){
      var raw=String(value||''); return /^https?:\/\//i.test(raw) ? raw : '';
    }
    function copyButton(draft){
      var b=el('button','nxi-copy',tx('Copy draft','复制草稿'));
      b.type='button';
      b.addEventListener('click',function(){
        var value=String(draft.text||'');
        if(!navigator.clipboard || !navigator.clipboard.writeText){
          text(b,tx('Copy unavailable','无法复制')); return;
        }
        navigator.clipboard.writeText(value).then(function(){
          text(b,tx('Copied','已复制'));
          setTimeout(function(){ text(b,tx('Copy draft','复制草稿')); },1400);
        }).catch(function(){ text(b,tx('Copy failed','复制失败')); });
      });
      return b;
    }
    function storyCard(story){
      var card=el('article','nxi-story'); card.setAttribute('data-stage',String(story.stage||'developing'));
      var main=el('div','nxi-main'), top=el('div','nxi-topline');
      top.appendChild(el('span','nxi-stage '+String(story.stage||'developing'),stageLabel(story.stage)));
      var lane=zh()?(story.lane_label_zh||story.lane_label_en):(story.lane_label_en||story.lane);
      top.appendChild(el('span','nxi-lane',lane||tx('Markets','市场')));
      var n=Math.max(1,Number(story.source_count||1));
      top.appendChild(el('span','nxi-sourcecount',n+' '+tx(n===1?'source':'sources','个来源')));
      var body=readable(story);
      if(body.original){
        top.appendChild(el('span','nxi-orig',tx('English original','英文原文')));
      }
      top.appendChild(el('span','nxi-time',age(story.updated_at)));
      main.appendChild(top);
      main.appendChild(el('h3','nxi-headline',body.headline));
      if(body.brief) main.appendChild(el('p','nxi-brief',body.brief));
      var why=zh()?(story.why_it_matters_zh||story.why_it_matters_en):story.why_it_matters_en;
      if(why) main.appendChild(el('p','nxi-why',why));
      var chips=el('div','nxi-chips'), ctx=story.context||{};
      ['evidence','pace','source_quality'].forEach(function(k){
        if(!ctx[k]) return;
        var cls='nxi-chip'+
          ((k==='pace'&&String(ctx[k])==='Cooling') ? ' pace-cooling' : '');
        chips.appendChild(el('span',cls,knownContext(ctx[k])));
      });
      // `market` is served null once its stamp goes stale, so the chip simply
      // does not appear. It stays neutral on purpose: a red/green move flips
      // meaning under the zh convention, and this is context, not a call.
      if(story.market && story.market.label){
        chips.appendChild(el('span','nxi-chip market',
          story.market.label+' · '+tx('session move','本交易日变动')));
      }
      (story.tickers||[]).slice(0,5).forEach(function(t){
        chips.appendChild(el('span','nxi-chip ticker','$'+String(t).replace(/^\$/,'')));
      });
      if(chips.childNodes.length) main.appendChild(chips);
      card.appendChild(main);

      var evidence=(story.evidence||[]).filter(function(x){ return x&&typeof x==='object'; });
      var drafts=(story.drafts||[]).filter(function(x){ return x&&x.text; });
      var details=document.createElement('details'); details.className='nxi-more';
      details.appendChild(el('summary','',
        tx('Evidence & content','证据与内容')+' · '+evidence.length+' / '+drafts.length));
      var detail=el('div','nxi-detail');
      var routes=(story.content_routes||[]).filter(function(x){return x;});
      if(routes.length){
        var routeWrap=el('div',''), routeChips=el('div','nxi-chips');
        routeWrap.appendChild(el('h4','',tx('Content routes','内容路径')));
        routes.forEach(function(route){
          routeChips.appendChild(el('span','nxi-chip',shapeLabel(route)));
        });
        routeWrap.appendChild(routeChips); detail.appendChild(routeWrap);
      }
      if(evidence.length){
        var evWrap=el('div',''), evList=el('div','nxi-evidence');
        evWrap.appendChild(el('h4','',tx('Source receipts','来源依据')));
        evidence.slice(0,8).forEach(function(source){
          var row=el('div','nxi-source'), lead=el('div','');
          var href=safeUrl(source.url);
          if(href){
            var a=el('a','',source.name||tx('Open source','打开来源'));
            a.href=href; a.target='_blank'; a.rel='noopener'; lead.appendChild(a);
          }else lead.appendChild(el('strong','',source.name||tx('Source','来源')));
          lead.appendChild(el('span','',
            ' · '+age(source.published_at)+(zh()?tx(' · English source',' · 英文原文'):'')));
          row.appendChild(lead); evList.appendChild(row);
        });
        evWrap.appendChild(evList); detail.appendChild(evWrap);
      }
      var track=timelineGroup(story); if(track) detail.appendChild(track);
      var facts=factsGroup(story); if(facts) detail.appendChild(facts);
      if(drafts.length){
        var drWrap=el('div',''); drWrap.appendChild(el('h4','',tx('Review queue','审核队列')));
        draftSlots(drafts).forEach(function(draft){
          var dr=el('div','nxi-draft');
          // `origin` (wire vs llm) is machine provenance for the review tools.
          // It is deliberately NOT a badge here: who typed the first pass is
          // not the reader's business, and the review gate is the same either way.
          if(draft.shape) dr.appendChild(el('div','nxi-shape',shapeLabel(draft.shape)));
          dr.appendChild(el('p','',draft.text));
          var bar=el('div','nxi-draftbar');
          var status=draft.status==='review'?tx('Ready for review','可供审核'):tx('Needs editing','需要编辑');
          var chars=Number(draft.characters||String(draft.text).length);
          // 280 is the WIRE ceiling; printing it against an analysis or a long
          // post would invent a limit that shape does not have.
          var size=(!draft.shape||draft.shape==='wire')
            ? (chars+'/280') : (chars+tx(' chars','字'));
          bar.appendChild(el('span','',status+' · '+size));
          bar.appendChild(copyButton(draft)); dr.appendChild(bar); drWrap.appendChild(dr);
        });
        detail.appendChild(drWrap);
      }else{
        detail.appendChild(el('p','nxi-brief',
          tx('No draft yet. The evidence is retained for the next Content Studio pass.','尚无草稿。证据已保留，等待下一次内容工作台处理。')));
      }
      details.appendChild(detail); card.appendChild(details);
      return card;
    }
    function render(){
      listEl.textContent='';
      var filtered=stories.filter(matches), shown=expanded?filtered:filtered.slice(0,CAP);
      shown.forEach(function(story){ listEl.appendChild(storyCard(story)); });
      listEl.hidden=!shown.length; stateEl.hidden=!!shown.length;
      if(!shown.length){
        stateEl.textContent='';
        stateEl.appendChild(el('strong','',tx('No stories in this view','此视图暂无事件')));
        stateEl.appendChild(el('p','',
          tx('Nothing to act on — choose another filter or wait for the next confirmed development.','无需操作——请选择其他筛选条件，或等待下一条已确认进展。')));
      }
      if(moreEl){
        moreEl.hidden=expanded||filtered.length<=CAP;
        text(moreEl,tx('Show '+(filtered.length-CAP)+' more','再显示 '+(filtered.length-CAP)+' 条'));
      }
      if(footerEl) footerEl.hidden=false;
    }
    function setMetric(id,value){ var node=document.getElementById(id); if(node) text(node,Number(value||0)); }
    function showDesk(payload){
      health=payload.health||{}; stories=Array.isArray(payload.stories)?payload.stories.filter(function(s){
        return s && s.id && s.headline;
      }):[];
      updatedAt=payload.updated_at||'';
      mode='ok'; box.hidden=false; box.setAttribute('data-state',health.state||'quiet');
      if(metricsEl) metricsEl.hidden=false; if(toolbarEl) toolbarEl.hidden=false;
      setMetric('nxiActive',health.active_stories);
      setMetric('nxiConfirmed',health.confirmed);
      setMetric('nxiDrafts',health.draft_ready);
      setMetric('nxiSources',health.sources_online);
      if(healthEl) text(healthEl,health.state==='live'?tx('Desk is ingesting','工作台正在接收数据'):tx('Desk is quiet','工作台当前平静'));
      if(updatedEl) text(updatedEl,tx('Updated ','更新于 ')+age(updatedAt));
      expanded=false; render();
    }
    function stateCopy(kind){
      return ({
        gate:[tx('Sign in to open the Intelligence Desk','登录后查看情报工作台'),
          tx('The story graph, source receipts, and review drafts are available to registered accounts.','事件图谱、来源依据与审核草稿仅向注册账户开放。')],
        down:[tx('The Intelligence Desk is reconnecting','情报工作台正在重新连接'),
          tx('Nothing to do — the live wire and ranked board use separate paths and remain available.','无需操作——实时快讯与排序新闻使用独立路径，仍可继续查看。')],
        quiet:[tx('The desk is quiet','工作台当前平静'),
          tx('No active stories cleared the evidence floor. Nothing to act on; ingestion continues.','目前没有事件达到证据门槛。无需操作，系统仍在持续接收数据。')]
      })[kind] || null;
    }
    function showState(kind){
      var copy=stateCopy(kind)||stateCopy('down'); mode=kind; box.hidden=false;
      box.setAttribute('data-state','quiet'); listEl.hidden=true;
      if(metricsEl) metricsEl.hidden=true; if(toolbarEl) toolbarEl.hidden=true;
      if(footerEl) footerEl.hidden=true;
      stateEl.textContent=''; stateEl.hidden=false;
      stateEl.appendChild(el('strong','',copy[0])); stateEl.appendChild(el('p','',copy[1]));
      if(healthEl) text(healthEl,copy[0]); if(updatedEl) text(updatedEl,'');
    }
    function absent(){ mode='absent'; box.hidden=true; if(timerId){clearInterval(timerId);timerId=null;} }
    function poll(){
      if(inflight || mode==='absent' || document.hidden) return;
      inflight=true;
      var ctrl=('AbortController' in window)?new AbortController():null;
      var timeout=ctrl?setTimeout(function(){try{ctrl.abort();}catch(e){}},TIMEOUT):0;
      fetch(URL_,{credentials:'same-origin',cache:'no-store',signal:ctrl&&ctrl.signal})
        .then(function(r){
          if(r.status===404){absent();return null;}
          if(r.status===401||r.status===403){showState('gate');return null;}
          if(r.status===503){
            return r.text().then(function(body){
              if(body&&body.indexOf('site_access_temporarily_unavailable')>=0){absent();return null;}
              throw new Error('http 503');
            });
          }
          if(!r.ok) throw new Error('http '+r.status);
          return r.json();
        })
        .then(function(payload){
          if(!payload) return;
          if(String(payload.schema||'')!=='intelligence.desk/v1') throw new Error('schema');
          if(!Array.isArray(payload.stories)||!payload.stories.length){showState('quiet');return;}
          showDesk(payload);
        })
        .catch(function(){ if(mode!=='ok'&&mode!=='absent') showState('down'); })
        .then(function(){ if(timeout)clearTimeout(timeout); inflight=false; });
    }
    if(toolbarEl) toolbarEl.addEventListener('click',function(e){
      var b=e.target.closest&&e.target.closest('.nxi-filter'); if(!b)return;
      toolbarEl.querySelectorAll('.nxi-filter').forEach(function(x){x.classList.remove('on');});
      b.classList.add('on'); filter=b.getAttribute('data-intel-filter')||'all'; expanded=false; render();
    });
    if(moreEl) moreEl.addEventListener('click',function(){expanded=true;render();});
    window.addEventListener('langchange',function(){
      if(mode==='ok') showDesk({health:health,stories:stories,updated_at:updatedAt});
      else if(stateCopy(mode)) showState(mode);
    });
    document.addEventListener('visibilitychange',function(){if(!document.hidden)poll();});
    poll(); timerId=setInterval(poll,POLL);
  })();

  // ---- LIVE WIRE (B4b) ------------------------------------------------------
  // Hydrates from the wires.v1 payload the fastlane daemon publishes to
  // /live/wires.json. That asset is free_registered (config/site_access.yml), so
  // the SERVER is the gate and this client only ever asks — every response,
  // including a refusal, is reported honestly rather than as an empty list.
  // Follows the live.js conventions: relative URL, 60s poll, hidden-tab pause,
  // 10s abort. Item text is third-party wire copy and is written with
  // textContent only — never innerHTML.
  (function(){
    var box = document.getElementById('nxWire');
    if(!box || !window.fetch) return;
    var listEl  = document.getElementById('nxWireList');
    var stateEl = document.getElementById('nxWireState');
    var metaEl  = document.getElementById('nxWireMeta');
    var segEl   = document.getElementById('nxSeg');
    if(!listEl || !stateEl) return;

    var URL_ = 'live/wires.json';
    var POLL = (window.LIVE_POLL_SEC || 60) * 1000;
    var STALE_MIN = window.LIVE_STALE_MIN || 20;
    var TIMEOUT = 10000, CAP = 40;
    var items = [], seen = {}, painted = false, updatedAt = null;

    // The page's lane taxonomy and the wire's event classes are different
    // vocabularies, so the mapping is stated once, here, rather than guessed per
    // render. macro_print answers to BOTH Macro and Fed — a CPI or claims print is
    // exactly what the Fed lane's reader came for, and leaving Fed permanently
    // empty would read as a broken panel rather than an honest filter.
    var LANES = {
      macro_print:  ['macro', 'fed'],
      policy:       ['macro'],
      geopolitical: ['macro'],
      company_news: ['companies'],
      earnings:     ['companies']
    };
    function lanesFor(cls){ return LANES[String(cls || '')] || ['markets']; }
    function currentLane(){
      if(!segEl) return 'all';
      var on = segEl.querySelector('.seg-btn.on');
      return (on && on.getAttribute('data-lane')) || 'all';
    }
    function inLane(it, lane){
      return lane === 'all' || lanesFor(it['class']).indexOf(lane) >= 0;
    }
    var mode = null, inflight = false, pollTimer = 0;

    // Freshness is a property of the NEWS, not of the daemon. `updated_at` is
    // re-stamped every tick whether or not anything crossed, so trusting it would
    // pulse "live" over a three-day-old window on a quiet feed. Age the panel off
    // the newest item instead, and say "stale" when the wire has gone silent.
    function isStale(){
      var newest = 0;
      for(var i = 0; i < items.length; i++){
        var t = Date.parse(items[i].ts || '');
        if(!isNaN(t) && t > newest) newest = t;
      }
      if(!newest) return true;                       // no parseable time => don't claim live
      return (Date.now() - newest) / 60000 > STALE_MIN;
    }

    function isZh(){ return document.documentElement.getAttribute('data-lang')==='zh'; }

    // Compact age for the time gutter. The page-wide rel() ("18m ago") wraps in a
    // fixed column and breaks the tabular alignment the gutter exists for, so the
    // wire uses a 3-character form instead.
    function shortAge(iso){
      if(!iso) return '';
      var ms = Date.parse(iso); if(isNaN(ms)) return '';
      var s = Math.max(0, (Date.now() - ms) / 1000), zh = isZh();
      if(s < 60) return zh ? '刚刚' : 'now';
      var m = s / 60; if(m < 60) return Math.floor(m) + (zh ? '分钟' : 'm');
      var h = m / 60; if(h < 24) return Math.floor(h) + (zh ? '小时' : 'h');
      return Math.floor(h / 24) + (zh ? '天' : 'd');
    }
    function el(tag, cls, text){
      var n = document.createElement(tag);
      if(cls) n.className = cls;
      if(text != null) n.textContent = text;   // never innerHTML: wire copy is third-party
      return n;
    }

    // The payload's `corroboration` is engine-supplied English display text
    // ("verified" | "N sources" | "reports"). Map it to a node FORM plus a plain
    // word in both languages: a user-facing surface never shows a single-source
    // relay as a confirmed fact.
    function corrOf(raw){
      var s = String(raw || '').trim(), m = s.match(/^(\d+)\s+sources?$/i);
      if(/^verified$/i.test(s)) return { form:'verified', en:'matched to the original', zh:'已比对原文',
        tEn:'We checked this against the original post itself.',
        tZh:'我们已与原始帖文本身核对。' };
      if(m) return { form:'sources', en:m[1]+' sources', zh:m[1]+' 家来源',
        tEn:'Carried by '+m[1]+' distinct feeds or accounts we watch. A count, '
            +'not a check on independence — some may be syndicating one original.',
        tZh:'我们监看的 '+m[1]+' 个不同信源或账号都发布了这条消息。这只是数量，'
            +'并非独立性核实——其中一些可能转载自同一原始来源。' };
      if(/^reports$/i.test(s)) return { form:'reports', en:'single report', zh:'仅单一来源',
        tEn:'One feed only, not yet carried anywhere else. Read it as a report, not a fact.',
        tZh:'目前只有一个信源，尚未见其他方跟进。请当作报道看待，而非既成事实。' };
      // Unknown wording from a future engine revision: show it verbatim in EN, fall
      // back to the plain word in ZH (never leak raw English into the ZH surface),
      // and use the NEUTRAL node form — an unrecognised label is not evidence of
      // weak sourcing, so it must not be drawn as the single-report form.
      return s ? { form:'neutral', en:s, zh:'来源信息', tEn:'', tZh:'' } : null;
    }

    function renderList(){
      var zh = isZh(), keep = listEl.scrollTop;
      // Mark EVERY item in the payload as seen, not just the slice currently on
      // screen: `seen` answers "did this arrive while the reader was here", and
      // scoping it to the filtered view made a filter switch animate months-old
      // items as fresh arrivals.
      var fresh = {};
      items.forEach(function(it){ if(!seen[it.id]) fresh[it.id] = 1; });
      var lane = currentLane();
      var shown = items.filter(function(it){ return inLane(it, lane); }).slice(0, CAP);
      items.forEach(function(it){ seen[it.id] = 1; });
      listEl.textContent = '';
      shown.forEach(function(it, i){
        var row = el('div','nxw-item');
        if(i === 0) row.classList.add('is-newest');
        if(painted && fresh[it.id]) row.classList.add('is-new');
        var age = el('time','nxw-age num', shortAge(it.ts) || '—');
        if(it.ts) age.setAttribute('datetime', String(it.ts));
        row.appendChild(age);
        var c = corrOf(it.corroboration);
        var node = el('span','nxw-node');
        node.setAttribute('data-corr', c ? c.form : 'reports');
        row.appendChild(node);
        // press_lane composes BOTH rail paths as "<body> · <tape_stamp>", so the
        // stamp is always already inside `en`. Lift it back out and re-render it
        // from the structured field, which is the only way it can carry its window
        // in words ("since this crossed") and be translated at all.
        var tape = String(it.tape_stamp || '');
        var text = String((zh && it.zh ? it.zh : it.en) || '');
        if(tape && !(zh && it.zh)){
          var tail = ' · ' + tape;
          if(text.slice(-tail.length) === tail) text = text.slice(0, -tail.length);
        }
        var body = el('div','nxw-body');
        body.appendChild(el('p','nxw-text', text));
        var line = el('div','nxw-line');
        var label = zh ? (it.label_zh || it.label_en) : it.label_en;   // never the raw class slug
        if(label) line.appendChild(el('span','nxw-cls', String(label)));
        if(c){
          // .lens-term is the house affordance for an explained inline term:
          // dotted underline + the shared hover/focus accent. tabindex makes the
          // panel's whole epistemic payload reachable without a mouse.
          var cs = el('span', c.tEn ? 'nxw-corr lens-term' : 'nxw-corr', zh ? c.zh : c.en);
          if(c.tEn){
            cs.setAttribute('data-tip-en', c.tEn);
            cs.setAttribute('data-tip-zh', c.tZh);
            cs.setAttribute('tabindex', '0');
          }
          line.appendChild(cs);
        }
        // The engine's tape stamp is a bare "LABEL ±X.X%"; on X the surrounding
        // sentence supplies the window, so here we say it — a number on a glance
        // surface arrives with its meaning.
        if(tape){
          var tw = el('span','nxw-tapewrap');
          tw.appendChild(el('span','nxw-tape', tape));
          tw.appendChild(el('span','nxw-tapesfx', zh ? '自该消息出现以来' : 'since this crossed'));
          line.appendChild(tw);
        }
        // Honest ZH disclosure: this item has no Chinese twin yet, so say so
        // rather than passing English off as translated.
        if(zh && !it.zh) line.appendChild(el('span','nxw-orig','英文原文'));
        if(line.childNodes.length) body.appendChild(line);
        row.appendChild(body);
        listEl.appendChild(row);
      });
      if(!shown.length){
        // The reader filtered, not the wire failed. Say which of the two it is.
        var lbl = segEl && segEl.querySelector('.seg-btn.on');
        var name = lbl ? lbl.textContent.trim() : '';
        listEl.appendChild(el('p','nxw-lanenone', isZh()
          ? ('「' + name + '」暂无快讯——切换到「全部」可查看完整快讯。')
          : ('Nothing on the wire under ' + name + ' — switch to All for the full wire.')));
      }
      listEl.scrollTop = keep;
      painted = true;
    }

    function renderMeta(stale){
      if(!metaEl) return;
      var zh = isZh(), src = {}, lane = currentLane(), n = 0, newestTs = null;
      items.forEach(function(it){
        if(!inLane(it, lane)) return;
        n++;
        if(newestTs === null) newestTs = it.ts;   // items arrive newest-first
        var a = String(it.attribution || '').trim(); if(a) src[a] = 1;
      });
      var ns = Object.keys(src).length;
      metaEl.textContent = '';
      if(stale){
        // Say it in words as well as in the lamp: a quiet wire is a fact about
        // the news, and a reader must not have to decode a grey dot to learn it.
        metaEl.appendChild(el('span','nxw-stale', zh ? '暂无新消息' : 'Nothing new for a while'));
        metaEl.appendChild(document.createTextNode(' · '));
      }
      // Lane-scoped, like the counts beside it: with a filter on, "latest" must
      // mean the latest thing the reader can actually see.
      metaEl.appendChild(document.createTextNode(zh ? '最新一条 ' : 'Latest '));
      metaEl.appendChild(el('span','num', rel(newestTs || updatedAt)
                            || (zh ? '时间未知' : 'time unknown')));
      metaEl.appendChild(document.createTextNode(' · '));
      metaEl.appendChild(el('span','num', String(n)));
      metaEl.appendChild(document.createTextNode(zh ? ' 条' : ' items'));
      if(ns){
        metaEl.appendChild(document.createTextNode(zh ? ' · 来自 ' : ' from '));
        metaEl.appendChild(el('span','num', String(ns)));
        metaEl.appendChild(document.createTextNode(zh ? ' 家来源' : ' sources'));
      }
    }

    var STATE_COPY = {
      gate: { h:['Sign in to see the live wire','登录后查看实时快讯'],
              s:['The wire is open to every registered account. Your session has ended — sign back in and it picks up where it left off.',
                 '实时快讯对所有已注册账户开放。您的登录状态已失效——重新登录即可继续查看。'],
              cta:['Sign in','登录'] },
      down: { h:['The live wire is not reachable right now','实时快讯暂时无法连接'],
              s:['Nothing to do — the ranked board below is built on a separate path and is current. The wire reconnects on its own.',
                 '无需操作——下方的排序榜由另一条链路生成，数据仍是最新的。快讯会自行重连。'] },
      quiet:{ h:['The desk is quiet','编辑台暂时安静'],
              s:['Nothing has crossed in the last few hours. Nothing to act on — the ranked board below is current.',
                 '最近几小时没有新消息进来。无需操作——下方的排序榜仍是最新的。'] }
    };

    function showState(kind){
      var d = STATE_COPY[kind]; if(!d) return;
      var zh = isZh();
      box.setAttribute('data-state', kind);
      listEl.hidden = true;
      stateEl.textContent = '';
      stateEl.appendChild(el('p','h', zh ? d.h[1] : d.h[0]));
      stateEl.appendChild(el('p','s', zh ? d.s[1] : d.s[0]));
      if(d.cta){
        var b = el('button','cta', zh ? d.cta[1] : d.cta[0]);
        b.type = 'button';
        b.addEventListener('click', function(){
          // theme.js owns the modal; if it failed to load, the landing's own
          // ?signin=1 entry point is the house fallback (the same place the
          // Caddy regwall redirects a signed-out HTML request to).
          if(window.MDXAuth && window.MDXAuth.open) window.MDXAuth.open('signin');
          else window.location.href = 'index.html?signin=1';
        });
        stateEl.appendChild(b);
      }
      if(metaEl) metaEl.textContent = '';
      stateEl.hidden = false;
      box.hidden = false;
    }

    function showList(stale){
      box.setAttribute('data-state', stale ? 'stale' : 'live');
      stateEl.hidden = true;
      renderList(); renderMeta(stale);
      listEl.hidden = false;
      box.hidden = false;
    }

    function repaint(){
      if(mode === 'absent'){ box.hidden = true; return; }
      if(mode === 'ok') { items.length ? showList(box.getAttribute('data-state') === 'stale') : showState('quiet'); }
      else if(mode === 'gate') showState('gate');
      else if(mode === 'down') showState('down');
    }

    // A settled negative is settled: hiding the panel or parking it on "not
    // reachable" while a no-store fetch keeps firing every 60s in every open tab
    // is pure background load for an answer that will not change without a
    // deploy. Both terminal states stop the timer; a revisit re-polls.
    function stop(){ if(pollTimer){ clearInterval(pollTimer); pollTimer = 0; } }

    function absent(){ mode = 'absent'; box.hidden = true; stop(); }

    function poll(){
      if(inflight) return;
      // The FIRST load always runs: a preview pane reports document.hidden from
      // the start, and a panel stuck on "loading" there is a false negative.
      if(mode !== null && document.hidden) return;
      inflight = true;
      var ctrl = ('AbortController' in window) ? new AbortController() : null;
      var timer = ctrl ? setTimeout(function(){ try{ ctrl.abort(); }catch(e){} }, TIMEOUT) : 0;
      fetch(URL_, { credentials:'same-origin', cache:'no-store', signal: ctrl && ctrl.signal })
        .then(function(r){
          // 404 = the wire is not published at this deployment. A feature that is
          // not live must not advertise its own absence, so the panel stays hidden.
          if(r.status === 404){ absent(); return null; }
          if(r.status === 401 || r.status === 403){ mode = 'gate'; showState('gate'); return null; }
          // Defence in depth for the edge: until the Caddyfile exclusion for
          // /live/wires.json is deployed, a MISSING file is rewritten by the
          // @reg_asset_err handler into this exact 503 body. That is the
          // not-published case wearing a server-error costume — read it as
          // absent, not as a broken wire. Any OTHER 503 stays a real fault.
          if(r.status === 503){
            return r.text().then(function(t){
              if(t && t.indexOf('site_access_temporarily_unavailable') >= 0){ absent(); return null; }
              throw new Error('http 503');
            });
          }
          if(!r.ok) throw new Error('http ' + r.status);
          return r.json();
        })
        .then(function(d){
          if(!d) return;
          if(String(d.schema || '') !== 'wires.v1') throw new Error('schema');
          items = (Array.isArray(d.items) ? d.items : []).filter(function(x){
            return x && x.id && (x.en || x.zh);
          });
          updatedAt = d.updated_at || null;
          mode = 'ok';
          if(!items.length){ showState('quiet'); return; }
          showList(isStale());
        })
        .catch(function(){
          if(mode === 'ok' || mode === 'absent') return;   // a blip keeps the last good window
          mode = 'down'; showState('down'); stop();
        })
        .then(function(){ if(timer) clearTimeout(timer); inflight = false; });
    }

    // The shared segment owns the lane; the wire just listens. A separate
    // listener on the same element is order-independent — it reads the button that
    // was clicked rather than the class the feed's handler is mid-way through
    // setting.
    if(segEl) segEl.addEventListener('click', function(e){
      var b = e.target.closest && e.target.closest('.seg-btn');
      if(b && mode === 'ok' && items.length) { renderList(); renderMeta(isStale()); }
    });
    window.addEventListener('langchange', repaint);
    document.addEventListener('visibilitychange', function(){
      if(document.hidden) return;
      if(mode === 'absent') return;                        // settled: nothing to re-ask
      if(!pollTimer) pollTimer = setInterval(poll, POLL);   // a 'down' tab retries on return
      poll();
    });
    poll();
    pollTimer = setInterval(poll, POLL);
  })();
})();
</script>
{% endblock %}
