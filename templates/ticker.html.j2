<script>
(function(){
  /* Terminal chart embed: src carries current theme + lang; retint on toggle. */
  var frame = document.getElementById('chart-frame');
  var ifr = document.getElementById('chart-embed');
  if (frame && ifr) {
    var loaded = false;
    function src(){
      var d = document.documentElement;
      var u = ifr.getAttribute('data-embed');
      if ((d.getAttribute('data-theme') || 'dark') === 'light') u += '&theme=light';
      if (d.getAttribute('data-lang') === 'zh') u += '&lang=zh';
      return u;
    }
    ifr.addEventListener('load', function(){ if (ifr.getAttribute('src')) { loaded = true; frame.classList.add('loaded'); frame.classList.remove('failed'); } });
    ifr.setAttribute('src', src());
    // 'failed' catches hard failures only (origin unreachable / frame blocked) —
    // a served page always fires load; /embed/chart renders its own empty states.
    setTimeout(function(){ if (!loaded) frame.classList.add('failed'); }, 8000);
    new MutationObserver(function(){
      var next = src();
      if (ifr.getAttribute('src') !== next) { loaded = false; frame.classList.remove('loaded'); ifr.setAttribute('src', next); }
    }).observe(document.documentElement, {attributes: true, attributeFilter: ['data-theme', 'data-lang']});
  }

  /* Reveal-on-scroll */
  var rvs = document.querySelectorAll('.rv');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, {rootMargin: '0px 0px -8% 0px', threshold: 0.06});
    rvs.forEach(function(el){ io.observe(el); });
  } else {
    rvs.forEach(function(el){ el.classList.add('in'); });
  }

  /* Sticky strip after hero + scroll-spy */
  var hero = document.getElementById('top'), strip = document.getElementById('v6strip');
  if (hero && strip && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(es){
      strip.classList.toggle('vis', !es[0].isIntersecting);
      strip.setAttribute('aria-hidden', es[0].isIntersecting ? 'true' : 'false');
    }, {rootMargin: '-56px 0px 0px 0px'}).observe(hero);
    var links = {};
    document.querySelectorAll('#v6jumps a').forEach(function(a){ links[a.getAttribute('href').slice(1)] = a; });
    var spy = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if (e.isIntersecting) {
          Object.keys(links).forEach(function(k){ links[k].classList.remove('is-on'); });
          var l = links[e.target.id]; if (l) l.classList.add('is-on');
        }
      });
    }, {rootMargin: '-30% 0px -60% 0px'});
    Object.keys(links).forEach(function(id){ var el = document.getElementById(id); if (el) spy.observe(el); });
  }
})();
</script>


<script>
/* dsrOpenDlg — the macro.html mx5 dialog system (focus trap, scroll lock,
   double-rAF entrance, animated close, Escape + backdrop, #dlg- deep links). */
(function(){
  var _active=null,_trigger=null,_scrollY=0;
  function _reduced(){return !!(window.matchMedia&&window.matchMedia('(prefers-reduced-motion:reduce)').matches);}
  function _focusables(d){return d.querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])');}
  function _trap(d,e){
    if(e.key!=='Tab')return;
    var f=_focusables(d);if(!f.length)return;
    var first=f[0],last=f[f.length-1];
    if(e.shiftKey){if(document.activeElement===first){e.preventDefault();last.focus();}}
    else{if(document.activeElement===last){e.preventDefault();first.focus();}}
  }
  function _teardown(d){
    d.classList.remove('open','dsr-in','dsr-closing');
    d.removeAttribute('aria-modal');
    if(d._trapH){d.removeEventListener('keydown',d._trapH);delete d._trapH;}
    var bd=d.querySelector('.dsr-dlg-backdrop');
    if(bd&&bd._h){bd.removeEventListener('click',bd._h);delete bd._h;}
    if(d._timer){clearTimeout(d._timer);delete d._timer;}
  }
  function _release(){
    document.documentElement.classList.remove('dsr-dlg-lock');
    document.body.style.top='';
    window.scrollTo(0,_scrollY);
  }
  window.dsrOpenDlg=function(id){
    if(_active){_teardown(_active);_active=null;}
    var d=document.getElementById(id);if(!d)return;
    _trigger=document.activeElement;_active=d;
    d.classList.remove('dsr-closing');
    d.classList.add('open');d.setAttribute('aria-modal','true');
    if(!document.documentElement.classList.contains('dsr-dlg-lock')){
      _scrollY=window.pageYOffset||document.documentElement.scrollTop||0;
      document.body.style.top=(-_scrollY)+'px';
      document.documentElement.classList.add('dsr-dlg-lock');
    }
    if(_reduced()){d.classList.add('dsr-in');}
    else{requestAnimationFrame(function(){requestAnimationFrame(function(){if(_active===d)d.classList.add('dsr-in');});});}
    var f=_focusables(d);if(f.length)f[0].focus();
    d._trapH=function(e){_trap(d,e);};d.addEventListener('keydown',d._trapH);
    var bd=d.querySelector('.dsr-dlg-backdrop');
    if(bd){bd._h=function(){window.dsrCloseDlg();};bd.addEventListener('click',bd._h);}
  };
  window.dsrCloseDlg=function(){
    if(!_active)return;
    var d=_active;_active=null;_release();
    var trig=_trigger;_trigger=null;
    var refocus=function(){if(trig&&typeof trig.focus==='function')trig.focus();};
    if(_reduced()){_teardown(d);refocus();return;}
    d.classList.add('dsr-closing');d.classList.remove('dsr-in');
    var done=function(){_teardown(d);refocus();};
    d._timer=setTimeout(done,340);
  };
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&_active){e.stopImmediatePropagation();window.dsrCloseDlg();}
  },true);
  function _hash(){var h=(location.hash||'').slice(1);if(h&&h.indexOf('dlg-')===0)window.dsrOpenDlg(h);}
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',_hash);}else{_hash();}
})();
</script>

</body>
