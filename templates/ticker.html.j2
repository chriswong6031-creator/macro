  {%- set pn = signal_history.pinned -%}
  <div class="pinned-bar">
    <div class="pinned-hl {{ 'pos' if pn.dir == 'up' else ('neg' if pn.dir == 'down' else 'warn') }}">
      {{ t(pn.headline, pn.headline_zh) if pn.headline_zh else pn.headline }}
    </div>
