{%- endmacro -%}
{% set nav_prefix = '../' %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ticker }} — {{ name }}: signals, options &amp; factor profile | Mastermind</title>
