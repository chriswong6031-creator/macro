      </div>
    </div>
    {% endfor %}
    {% if signal_history.n_total > 15 %}
    <p class="sm muted" style="margin-top:6px;">{{ t('Showing last 15 of', '显示最近15条，共') }} {{ signal_history.n_total }} {{ t('signals', '条信号') }}</p>
