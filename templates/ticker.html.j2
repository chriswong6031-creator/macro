<!-- lazy chart loader -->
<script>
window.loadInteractiveChart = (function(){
  var _loaded = false;
  return function(btn){
    if(_loaded) return;
    _loaded = true;
    btn.disabled = true;
    btn.textContent = '...';
    var s1 = document.createElement('script');
    s1.src = '../lightweight-charts-v5.js';
    s1.onload = function(){
      var s2 = document.createElement('script');
      s2.src = '../chart.js';
      s2.onload = function(){
        var mount = document.getElementById('chart-mount');
        if(mount && window.StockChart){
          mount.style.display = 'block';
          window.StockChart.mount(mount, '{{ ticker }}', {
            name: '{{ name | replace("'", "\\'") }}',
            ohlcDir: '../ohlc'
          });
          btn.style.display = 'none';
        }
      };
      document.head.appendChild(s2);
    };
    document.head.appendChild(s1);
  };
})();
</script>

