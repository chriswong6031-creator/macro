  <main class="yq-main">
{% if chart and chart.svg_present %}
<div class="mod"><section id="chart">
<h2>{{ t('Price Chart', '价格图表') }}</h2>
<div class="panel chart-wrap">
  {% if chart.svg_present %}
  <div class="chart-svg-box">{{ chart.svg | safe }}</div>
  {% endif %}
  <div class="chart-actions">
    <button class="btn-ghost" id="chart-lazy-btn" onclick="loadInteractiveChart(this)" style="cursor:pointer;">{{ t('Interactive chart', '互动图表') }}</button>
    <a class="btn-ghost" href="https://app.mastermind-x.com/terminal?sym={{ ticker }}&from=macro" rel="noopener noreferrer" target="_blank">{{ t('Full chart in Terminal', '终端完整图表') }} ↗</a>
  </div>
  <div id="chart-mount"></div>
</div>
</section></div>
{% endif %}
{% if stats %}
<div class="mod"><section id="stats">
<h2>{{ t('Key Statistics', '关键统计') }}</h2>
<div class="stat-grid">
  {% if stats.price %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Price', '价格') }}</div>
    <div class="stat-v">$<span class="nb-px" data-sym="{{ ticker }}" data-mkt="us">{{ stats.price }}</span></div>
    {% if stats.range_52w_en %}<div class="stat-sub">{{ t(stats.range_52w_en, stats.range_52w_zh) }}</div>{% endif %}
  </div>
  {% endif %}
  {% if stats.mktcap %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Market Cap', '市值') }}</div>
    <div class="stat-v">{{ stats.mktcap }}</div>
    {% if stats.volume_en %}<div class="stat-sub">{{ t(stats.volume_en, stats.volume_zh) }}</div>{% endif %}
  </div>
  {% endif %}
  {% if stats.trailing_pe %}
  <div class="stat-card">
    <div class="stat-k">{{ t('P/E Ratio', '市盈率') }}</div>
    <div class="stat-v">{{ stats.trailing_pe }}</div>
    {% if stats.trailing_pe_med %}<div class="stat-sub">{{ stats.trailing_pe_med }}</div>{% endif %}
  </div>
  {% endif %}
  {% if stats.forward_pe %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Forward P/E', '预测市盈率') }}</div>
    <div class="stat-v">{{ stats.forward_pe }}</div>
    {% if stats.eps %}<div class="stat-sub">{{ t('EPS', '每股收益') }} {{ stats.eps }}</div>{% endif %}
  </div>
  {% endif %}
  {% if stats.beta %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Beta', '贝塔') }}</div>
    <div class="stat-v">{{ stats.beta }}</div>
    {% if stats.beta_en %}<div class="stat-sub">{{ t(stats.beta_en, stats.beta_zh) }}</div>{% endif %}
  </div>
  {% endif %}
  {% if stats.div_yield %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Dividend Yield', '股息收益率') }}</div>
    <div class="stat-v">{{ stats.div_yield }}</div>
  </div>
  {% endif %}
  {% if stats.rsi %}
  <div class="stat-card">
    <div class="stat-k">{{ t('RSI (14)', 'RSI（14）') }}</div>
    <div class="stat-v">{{ stats.rsi }}</div>
    {% if stats.rsi_zone_en %}<div class="stat-sub">{{ t(stats.rsi_zone_en, stats.rsi_zone_zh) }}</div>{% endif %}
  </div>
  {% endif %}
  {% if stats.next_earnings %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Next Earnings', '下次财报') }}</div>
    <div class="stat-v" style="font-size:13px;">{{ stats.next_earnings }}</div>
  </div>
  {% endif %}
  {% if stats.hv_pctile %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Volatility Rank', '波动率分位') }}</div>
    <div class="stat-v">{{ stats.hv_pctile }}</div>
    <div class="stat-sub">{{ t('hist. vol. percentile', '历史波动率分位数') }}</div>
  </div>
  {% endif %}
  {% if stats.short_pct_float %}
  <div class="stat-card">
    <div class="stat-k">{{ t('Short Interest', '空头兴趣') }}</div>
    <div class="stat-v" style="font-size:13px;">{{ stats.short_pct_float }}</div>
  </div>
  {% endif %}
</div>
</section></div>
{% endif %}
{% if performance %}
<div class="mod"><section id="performance">
<h2>{{ t('Performance', '价格表现') }}</h2>
<div class="panel">
  <table class="perf-table">
    <thead>
      <tr>
        <th>{{ t('Period', '周期') }}</th>
        <th>{{ ticker }}</th>
        {% if performance[0].spy_ret %}<th>S&amp;P 500</th><th>{{ t('vs Index', '对比指数') }}</th>{% endif %}
      </tr>
    </thead>
    <tbody>
    {% for row in performance %}
    <tr>
      <td class="muted">{{ t(row.label_en, row.label_zh) }}</td>
      <td class="{{ 'pos' if row.positive else 'neg' }}" style="font-weight:700;">{{ row.ticker_ret }}</td>
      {% if performance[0].spy_ret %}<td class="muted">{{ row.spy_ret or '' }}</td>
      <td class="muted sm">{{ t(row.verdict_en, row.verdict_zh) if row.verdict_en else '' }}</td>{% endif %}
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
</section></div>
{% endif %}
{% if technicals %}
<div class="mod"><section id="technicals">
<h2>{{ t('Technicals', '技术面') }}</h2>
<div class="panel">
  {% if technicals.active_signals %}
  <div class="panel-hd">{{ t('Active signals', '活跃信号') }}</div>
  <div class="chip-row">{% for sig in technicals.active_signals %}<span class="chip">{{ sig }}</span>{% endfor %}</div>
  {% endif %}
  <div style="margin-top:12px;">
    {% if technicals.rsi %}
    <div class="tech-row">
      <span class="tk">{{ t('RSI (14)', 'RSI（14）') }}</span>
      <span>{{ technicals.rsi }}</span>
      {% if technicals.rsi_zone_en %}<span class="chip {{ 'neg' if technicals.rsi_zone_en == 'Overbought' else ('pos' if technicals.rsi_zone_en == 'Oversold' else '') }}">{{ t(technicals.rsi_zone_en, technicals.rsi_zone_zh) }}</span>{% endif %}
    </div>
    {% endif %}
    {% if technicals.ma50_en %}
    <div class="tech-row">
      <span class="tk">{{ t('vs 50-day', '相对50日均线') }}</span>
      <span class="{{ 'pos' if technicals.above50 else 'neg' }}">{{ technicals.ma50_en }}</span>
    </div>
    {% endif %}
    {% if technicals.ma200_en %}
    <div class="tech-row">
      <span class="tk">{{ t('vs 200-day', '相对200日均线') }}</span>
      <span class="{{ 'pos' if technicals.above200 else 'neg' }}">{{ technicals.ma200_en }}</span>
    </div>
    {% endif %}
    {% if technicals.adx %}
    <div class="tech-row">
      <span class="tk">{{ t('Trend strength (ADX)', '趋势强度（ADX）') }}</span>
      <span>{{ technicals.adx }}</span>
      {% if technicals.adx_word_en %}<span class="muted sm">{{ t(technicals.adx_word_en, technicals.adx_word_zh) }}</span>{% endif %}
    </div>
    {% endif %}
    {% if technicals.hv_pctile %}
    <div class="tech-row">
      <span class="tk">{{ t('Volatility rank', '波动率分位') }}</span>
      <span>{{ technicals.hv_pctile }}{{ t(' percentile', ' 分位') }}</span>
    </div>
    {% endif %}
    {% if technicals.squeeze_en %}
    <div class="tech-row">
      <span class="tk">{{ t('Vol squeeze', '波动压缩') }}</span>
      <span class="warn">{{ t(technicals.squeeze_en, technicals.squeeze_zh) }}</span>
    </div>
    {% endif %}
  </div>
  {% if technicals.buy_zone or technicals.chase_above or technicals.stop %}
  <div style="margin-top:14px;">
    <div class="sm muted" style="margin-bottom:6px;">{{ t('Engine reference levels — not advice', '引擎参考水平 — 非投资建议') }}</div>
    <div class="levels-row">
      {% if technicals.buy_zone %}<div class="level-card entry"><div class="level-k">{{ t('Buy zone', '买入区间') }}</div><div class="level-v pos">{{ technicals.buy_zone }}</div></div>{% endif %}
      {% if technicals.chase_above %}<div class="level-card chase"><div class="level-k">{{ t("Don't chase above", '不追高于') }}</div><div class="level-v warn">{{ technicals.chase_above }}</div></div>{% endif %}
      {% if technicals.stop %}<div class="level-card stop"><div class="level-k">{{ t('Stop', '止损') }}</div><div class="level-v neg">{{ technicals.stop }}</div></div>{% endif %}
    </div>
    {% if technicals.entry_headline_en %}<div class="sm muted" style="margin-top:6px;">{{ t(technicals.entry_headline_en, technicals.entry_headline_zh) }}</div>{% endif %}
  </div>
  {% endif %}
</div>
</section></div>
{% endif %}
{% if earnings %}
<div class="mod"><section id="earnings">
<h2>{{ t('Earnings', '财务业绩') }}</h2>
<div class="panel">
  {% if earnings.days_to_next is not none and earnings.days_to_next >= 0 %}
  <div class="earns-countdown">
    <div class="days">{{ earnings.days_to_next }}</div>
    <div class="days-label">{{ t('days until next report', '天后公布财报') }}</div>
    {% if earnings.next_date %}<div class="sm muted" style="margin-top:4px">{{ earnings.next_date }}</div>{% endif %}
  </div>
  {% elif earnings.last_date %}
  <div class="panel-hd">{{ t('Last reported:', '上次报告：') }} {{ earnings.last_date }}</div>
  {% endif %}
  {% if earnings.rev_en %}<p class="sm" style="margin-top:10px;">{{ t(earnings.rev_en, earnings.rev_zh) }}</p>{% endif %}
  {% if earnings.sue_en %}<p class="sm">{{ t(earnings.sue_en, earnings.sue_zh) }}</p>{% endif %}
  {% if earnings.pead_en %}<p class="sm muted">{{ t(earnings.pead_en, earnings.pead_zh) }}</p>{% endif %}
  {% if earnings.surprises %}
  <table class="surprise-table">
    <thead><tr>
      <th>{{ t('Quarter', '季度') }}</th>
      <th>EPS</th>
      <th>{{ t('Consensus', '预期') }}</th>
      <th>{{ t('Surprise', '超预期') }}</th>
    </tr></thead>
    <tbody>
    {% for s in earnings.surprises %}
    <tr>
      <td>{{ s.qtr }}</td>
      <td>${{ '%.2f'|format(s.eps|float(0)) }}</td>
      <td class="muted">${{ '%.2f'|format(s.consensus|float(0)) }}</td>
      <td class="{{ 'pos' if s.surprise_pct|float(0) > 0 else 'neg' }}" style="font-weight:700;">
        {{ '+' if s.surprise_pct|float(0) > 0 else '' }}{{ '%.1f'|format(s.surprise_pct|float(0)) }}%
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if earnings.avg_surprise_pct %}<p class="sm muted" style="margin-top:6px;">{{ t('Average surprise', '平均超预期') }}: {{ earnings.avg_surprise_pct }}</p>{% endif %}
  {% endif %}
  {% if placeholders and placeholders.transcripts %}
  <div class="placeholder-line">{{ t('Earnings call transcripts — coming soon', '财报电话会议记录 — 即将上线') }}</div>
  {% endif %}
</div>
</section></div>
{% endif %}
{% if valuation %}
<div class="mod"><section id="valuation">
<h2>{{ t('Valuation', '估值') }}</h2>
<div class="panel">
  <table class="val-table">
    <thead><tr>
      <th>{{ t('Multiple', '指标') }}</th>
      <th>{{ ticker }}</th>
      <th>{{ t('Sector median', '行业中位') }}</th>
      <th>{{ t('Cheaper than', '相对便宜') }}</th>
    </tr></thead>
    <tbody>
    {% for row in valuation %}
    <tr>
      <td class="muted">{{ t(row.label_en, row.label_zh) }}</td>
      <td style="font-weight:700;">{{ row.value }}</td>
      <td class="muted">{{ row.sector_med if row.sector_med else '—' }}</td>
      <td>
        {% if row.cheap is not none %}
        <div class="cheap-bar-bg"><div class="cheap-bar-fill" style="width:{{ row.cheap }}%;background:{% if row.cheap >= 55 %}var(--up){% elif row.cheap <= 30 %}var(--down){% else %}var(--warn){% endif %};height:100%;border-radius:3px;"></div></div>
        <span class="sm muted" style="margin-left:4px;">{{ '%.0f'|format(row.cheap) }}%</span>
        {% else %}—{% endif %}
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if placeholders and placeholders.analyst_targets %}
  <div class="placeholder-line">{{ t('Analyst price targets — coming soon', '分析师目标价 — 即将上线') }}</div>
  {% endif %}
</div>
</section></div>
{% endif %}
{% if financials %}
<div class="mod"><section id="financials">
<h2>{{ t('Financials', '财务数据') }}</h2>
<div class="panel">
  {%- set fyears = financials.years -%}
  {%- set n_years = fyears | length -%}
  <div class="fin-grid">
    {% if financials.revenue and financials.revenue | select('ne', '') | list %}
    <div class="fin-card">
      <div class="fin-card-title">{{ t('Revenue', '营业收入') }}</div>
      {%- set rev_max = namespace(v=1) -%}
      {%- for v in financials.revenue -%}{%- if v -%}{%- set vn = v|replace('$','')|replace('B','')|replace('M','')|replace('T','')|float(0) -%}{%- if vn > rev_max.v -%}{%- set rev_max.v = vn -%}{%- endif -%}{%- endif -%}{%- endfor -%}
      <div class="fin-bars">
        {% for i in range(n_years) %}
        {%- set rv = financials.revenue[i] if i < financials.revenue|length else '' -%}
        {%- set rv_n = rv|replace('$','')|replace('B','')|replace('M','')|replace('T','')|float(0) if rv else 0 -%}
        <div class="fin-bar-wrap">
          <div class="fin-bar-val">{{ rv if rv else '' }}</div>
          <div class="fin-bar" style="height:{{ [((rv_n / rev_max.v) * 50)|int, 2]|max }}px;"></div>
          <div class="fin-bar-label">{{ fyears[i] }}</div>
        </div>
        {% endfor %}
      </div>
      {% if financials.rev_cagr %}<div class="sm muted" style="margin-top:6px">{{ t('5yr CAGR', '5年复合增速') }}: <strong>{{ financials.rev_cagr }}</strong></div>{% endif %}
    </div>
    {% endif %}
    {% if financials.eps and financials.eps | select('ne', '') | list %}
    <div class="fin-card">
      <div class="fin-card-title">{{ t('Earnings Per Share', '每股收益') }}</div>
      {%- set eps_max = namespace(v=0.01) -%}
      {%- for v in financials.eps -%}{%- if v -%}{%- set vn = v|float(0)|abs -%}{%- if vn > eps_max.v -%}{%- set eps_max.v = vn -%}{%- endif -%}{%- endif -%}{%- endfor -%}
      <div class="fin-bars">
        {% for i in range(n_years) %}
        {%- set ev = financials.eps[i] if i < financials.eps|length else '' -%}
        {%- set ev_n = ev|float(0) if ev else 0 -%}
        <div class="fin-bar-wrap">
          <div class="fin-bar-val">{{ '$'+ev if ev else '' }}</div>
          <div class="fin-bar {% if ev_n < 0 %}neg{% endif %}" style="height:{{ [(ev_n|abs / eps_max.v * 50)|int, 2]|max }}px;{% if ev_n < 0 %}background:var(--down);{% endif %}"></div>
          <div class="fin-bar-label">{{ fyears[i] }}</div>
        </div>
        {% endfor %}
      </div>
      {% if financials.eps_cagr %}<div class="sm muted" style="margin-top:6px">{{ t('5yr CAGR', '5年复合增速') }}: <strong>{{ financials.eps_cagr }}</strong></div>{% endif %}
    </div>
    {% endif %}
    {% if financials.fcf and financials.fcf | select('ne', '') | list %}
    <div class="fin-card">
      <div class="fin-card-title">{{ t('Free Cash Flow', '自由现金流') }}</div>
      {%- set fcf_max = namespace(v=0.01) -%}
      {%- for v in financials.fcf -%}{%- if v -%}{%- set vn = v|replace('$','')|replace('B','')|replace('M','')|float(0)|abs -%}{%- if vn > fcf_max.v -%}{%- set fcf_max.v = vn -%}{%- endif -%}{%- endif -%}{%- endfor -%}
      <div class="fin-bars">
        {% for i in range(n_years) %}
        {%- set fv = financials.fcf[i] if i < financials.fcf|length else '' -%}
        {%- set fv_n = fv|replace('$','')|replace('B','')|replace('M','')|float(0) if fv else 0 -%}
        <div class="fin-bar-wrap">
          <div class="fin-bar-val">{{ fv if fv else '' }}</div>
          <div class="fin-bar" style="height:{{ [(fv_n|abs / fcf_max.v * 50)|int, 2]|max }}px;"></div>
          <div class="fin-bar-label">{{ fyears[i] }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  {% if financials.margins %}
  <div style="margin-top:16px;">
    <div class="sm muted" style="margin-bottom:8px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">{{ t('Margins', '利润率') }}</div>
    {% for k, lbl_en, lbl_zh in [('gross_margin','Gross margin','毛利率'),('op_margin','Operating margin','营业利润率'),('net_margin','Net margin','净利率'),('fcf_margin','FCF margin','自由现金流利润率')] %}
    {%- set mv = financials.margins[k] -%}
    {%- if mv is not none -%}
    <div class="margin-bar-row">
      <span class="mbr-k">{{ t(lbl_en, lbl_zh) }}</span>
      <div class="margin-bar-bg"><div class="margin-bar-fill" style="width:{{ [mv|float(0)|abs, 100]|min }}%;"></div></div>
      <span class="margin-bar-val">{{ '%.1f'|format(mv|float(0)) }}%</span>
    </div>
    {%- endif -%}
    {% endfor %}
  </div>
  {% endif %}
  {% if financials.roe is not none or financials.roa is not none %}
  <div class="cagr-row" style="margin-top:12px;">
    {% if financials.roe is not none %}<div class="cagr-chip"><span class="cv {{ 'pos' if financials.roe|float(0) > 15 else '' }}">{{ '%.1f'|format(financials.roe|float(0)) }}%</span><span class="ck">{{ t('Return on Equity', '股本回报率') }}</span></div>{% endif %}
    {% if financials.roa is not none %}<div class="cagr-chip"><span class="cv">{{ '%.1f'|format(financials.roa|float(0)) }}%</span><span class="ck">{{ t('Return on Assets', '资产回报率') }}</span></div>{% endif %}
  </div>
  {% endif %}
  {% if financials.leverage_rows %}
  <div class="sm muted" style="margin-top:16px;margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">{{ t('Leverage', '杠杆') }}</div>
  <table class="kv-table">{% for row in financials.leverage_rows %}<tr><td>{{ t(row.label_en, row.label_zh) }}</td><td>{{ row.value }}</td></tr>{% endfor %}</table>
  {% endif %}
  {% if financials.cap_rows %}
  <div class="sm muted" style="margin-top:14px;margin-bottom:4px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">{{ t('Capital Allocation', '资本配置') }}</div>
  <table class="kv-table">{% for row in financials.cap_rows %}<tr><td>{{ t(row.label_en, row.label_zh) }}</td><td>{{ row.value }}</td></tr>{% endfor %}</table>
  {% endif %}
  <div class="chip-row" style="margin-top:12px;">
    {% if financials.piotroski is not none %}<span class="chip {{ 'pos' if financials.piotroski >= 7 else ('warn' if financials.piotroski >= 5 else 'neg') }}">{{ t('Piotroski','皮奥特罗斯基') }} {{ financials.piotroski }}/{{ financials.piotroski_of or 9 }}</span>{% endif %}
    {% if financials.altman_zone %}<span class="chip {{ 'pos' if financials.altman_zone=='safe' else ('warn' if financials.altman_zone=='grey' else 'neg') }}">{{ t('Altman Z','阿尔特曼Z') }}: {{ financials.altman_zone }}{% if financials.altman_z %} ({{ '%.1f'|format(financials.altman_z|float(0)) }}){% endif %}</span>{% endif %}
    {% if financials.aq_headline_en %}<span class="chip warn">{{ t(financials.aq_headline_en, financials.aq_headline_zh) }}</span>{% endif %}
  </div>
</div>
</section></div>
{% endif %}
{% if gauges %}
<div class="mod"><section id="gauges">
<h2>{{ t('Snapshot Gauges', '综合指标') }}</h2>
<div class="gauge-grid">
  {% if gauges.valuation %}
  <div class="gauge-card">
    <div class="gauge-title">{{ t('Valuation vs Sector', '估值相对行业') }}</div>
    {%- set vpct = gauges.valuation.pct | float(0) -%}
    <div class="gauge-val {{ 'pos' if vpct > 55 else ('neg' if vpct < 30 else '') }}">
      {{ t(gauges.valuation.verdict_en, gauges.valuation.verdict_zh) }}
    </div>
    {# marker: cheap percentile plots toward the green (cheap) end #}
    <div class="val-bar-wrap">
      <div class="val-bar-marker" style="left:{{ '%.0f' | format(100 - ([0, [vpct, 100] | min] | max)) }}%;"></div>
    </div>
    <div class="gauge-sub">{{ t(gauges.valuation.sub_en, gauges.valuation.sub_zh) }}</div>
  </div>
  {% endif %}

  {% if gauges.beta %}
  <div class="gauge-card">
    <div class="gauge-title">{{ t('Beta', '市场敏感度') }}</div>
    {%- set bval = gauges.beta.beta | float(1) -%}
    <div class="gauge-val">{{ gauges.beta.beta }}×</div>
    {%- if gauges.beta.gauge_pct_override is defined and gauges.beta.gauge_pct_override is not none -%}
      {%- set bpct = gauges.beta.gauge_pct_override | int -%}
    {%- else -%}
      {%- set bclamp = ([0.2, [bval, 3.0] | min] | max) -%}
      {%- set bpct = ((bclamp - 0.2) / 2.8 * 100) | int -%}
    {%- endif -%}
    <div class="beta-track-wrap">
      <div class="beta-track">
        <div class="beta-thumb" style="left:{{ bpct }}%;"></div>
        <div class="beta-mid"></div>
      </div>
      <div class="beta-labels"><span>0.2</span><span>1×</span><span>3×</span></div>
    </div>
    <div class="gauge-sub">{{ t(gauges.beta.label_en, gauges.beta.label_zh) }}</div>
  </div>
  {% endif %}

  {% if gauges.health %}
  <div class="gauge-card">
    <div class="gauge-title">{{ t('Financial Health', '财务健康') }}</div>
    {%- set pio_parts = (gauges.health.piotroski or '0/9').split('/') -%}
    {%- set pio_n = pio_parts[0] | int(0) -%}
    {%- set pio_of = pio_parts[1] | int(9) if pio_parts | length > 1 else 9 -%}
    <div class="gauge-val {{ 'pos' if pio_n >= 7 else ('warn' if pio_n >= 5 else 'neg') }}">
      {{ gauges.health.piotroski }}
    </div>
    <div class="pio-dots">
      {% for i in range(pio_of) %}<div class="pio-dot {{ 'on' if i < pio_n else '' }}"></div>{% endfor %}
    </div>
    {% if gauges.health.altman_zone %}
    <div><span class="chip {{ 'pos' if gauges.health.altman_zone == 'safe' else ('warn' if gauges.health.altman_zone == 'grey' else 'neg') }}">{{ t('Altman', '阿尔特曼') }}: {{ gauges.health.altman_zone }}</span></div>
    {% endif %}
    <div class="gauge-sub">{{ t(gauges.health.verdict_en, gauges.health.verdict_zh) }}</div>
  </div>
  {% endif %}

  {% if gauges.dividend %}
  <div class="gauge-card">
    <div class="gauge-title">{{ t('Dividend', '分红') }}</div>
    <div class="gauge-val pos">{{ gauges.dividend.yield_str }}</div>
    <div class="gauge-sub">{{ t(gauges.dividend.verdict_en, gauges.dividend.verdict_zh) }}</div>
  </div>
  {% else %}
  <div class="gauge-card">
    <div class="gauge-title">{{ t('Dividend', '分红') }}</div>
    <div class="gauge-val muted">—</div>
    <div class="gauge-sub">{{ t('Does not pay a dividend', '不派发股息') }}</div>
  </div>
  {% endif %}
</div>
</section></div>
{% endif %}
{% if why_moving %}
