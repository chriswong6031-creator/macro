<script data-dbase src="../data_base.js"></script>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="../theme.css">
<style>
/* ── design tokens ─────────────────────────────────────────────────────────
   Two voices, typographically enforced: everything the ENGINE says (numbers,
   levels, stamps, eyebrows) is monospace; every plain-word interpretation is
   the sans. Teal (--acc) is reserved for the machine's voice; green/red are
   strictly directional facts. */
*{box-sizing:border-box;}
:root{--mono:ui-monospace,"SF Mono","Cascadia Code",Menlo,Consolas,monospace;
      --acc:var(--link);
      --hair:color-mix(in srgb,var(--line) 55%,transparent);}
body{background:var(--bg);color:var(--text);font:14px/1.6 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif;margin:0;padding:0;}
a{text-decoration:none;color:inherit;}
.num,.stat-v,.gauge-val,.level-v,.gex-v,.price-big,.strip-price,.price-chg,.earns-countdown .days,
.perf-table td:not(:first-child),.val-table td:not(:first-child),.surprise-table td:not(:first-child),
.kv-table td:last-child,.holder-table td:nth-child(n+3),.timeline .dt,.cagr-chip .cv,.margin-bar-val
{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.01em;}
/* ── macro.html glass system (the canonical exemplar) ── */
:root{--glass-bg:rgba(16,22,30,.55);--glass-border:rgba(255,255,255,.12);
      --glass-shadow:0 8px 32px rgba(0,0,0,.55),0 1.5px 0 rgba(255,255,255,.07) inset;
      --glass-hover-bg:rgba(22,29,38,.62);--glass-hover-border:rgba(255,255,255,.16);
      --glass-hover-shadow:0 12px 40px rgba(0,0,0,.55),0 1.5px 0 rgba(255,255,255,.09) inset;
      --radius:18px;--dlg-bg:rgba(13,17,24,.88);--dlg-pop:rgba(13,18,26,.96);}
[data-theme="light"] body{--glass-bg:rgba(255,255,255,.82);--glass-border:rgba(0,0,0,.09);
      --glass-shadow:0 8px 32px rgba(0,0,0,.10),0 1.5px 0 rgba(255,255,255,.85) inset;
      --glass-hover-bg:rgba(255,255,255,.92);--glass-hover-border:rgba(0,0,0,.14);
      --glass-hover-shadow:0 12px 40px rgba(0,0,0,.14);--dlg-bg:#ffffff;--dlg-pop:rgba(255,255,255,.98);}
/* aurora backdrop — stance-tinted (au-pos green · au-warn amber · au-neg red) */
.aurora{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;}
.aurora::before{content:"";position:absolute;width:900px;height:700px;top:-200px;left:-150px;border-radius:50%;filter:blur(90px);background:radial-gradient(ellipse,color-mix(in srgb,var(--up) 12%,transparent) 0%,transparent 70%);}
.aurora::after{content:"";position:absolute;width:700px;height:600px;bottom:-100px;right:-100px;border-radius:50%;filter:blur(90px);background:radial-gradient(ellipse,rgba(99,102,241,.10) 0%,transparent 70%);}
.aurora.au-warn::before{background:radial-gradient(ellipse,color-mix(in srgb,var(--warn) 11%,transparent) 0%,transparent 70%);}
.aurora.au-neg::before{background:radial-gradient(ellipse,color-mix(in srgb,var(--down) 11%,transparent) 0%,transparent 70%);}
.page-wrap{position:relative;z-index:1;}
/* Yahoo-style layout: slim left nav · main column · right rail */
.yq{display:grid;grid-template-columns:132px minmax(0,1fr) 296px;gap:26px;margin-top:14px;align-items:start;}
.yq-nav{position:sticky;top:56px;display:flex;flex-direction:column;gap:2px;font-size:12.5px;padding-top:4px;}
.yq-nav a{padding:5px 10px;border-left:2px solid transparent;color:var(--muted);border-radius:0 7px 7px 0;}
.yq-nav a:hover{color:var(--text);border-left-color:var(--acc);background:color-mix(in srgb,var(--acc) 6%,transparent);}
.yq-main{min-width:0;display:flex;flex-direction:column;gap:18px;}
.yq-rail{min-width:0;display:flex;flex-direction:column;gap:18px;}
@media(max-width:1180px){.yq{grid-template-columns:minmax(0,1fr) 280px;}.yq-nav{display:none;}}
@media(max-width:880px){.yq{grid-template-columns:minmax(0,1fr);}.yq-rail{grid-row:auto;}}
.mod{background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius);box-shadow:var(--glass-shadow);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:18px 20px 16px;min-width:0;overflow:hidden;}
.mod section{margin:0;}
.mod h2{font:600 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 14px;display:flex;align-items:center;gap:10px;}
.mod h2::before{content:'';width:10px;height:1px;background:var(--acc);flex-shrink:0;}
.mod h2::after{content:'';flex:1;height:1px;background:var(--hair);}
@media(max-width:600px){.mod{padding:14px 13px 12px;border-radius:14px;}}
/* deck: the modular scorecard grid (legacy — deck removed) */
.deck{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px;margin-top:16px;}
.card{grid-column:span 3;background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius);box-shadow:var(--glass-shadow);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:16px 17px 14px;display:flex;flex-direction:column;gap:8px;min-width:0;cursor:pointer;transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;}
.card:hover{background:var(--glass-hover-bg);border-color:var(--glass-hover-border);box-shadow:var(--glass-hover-shadow);transform:translateY(-1px);}
.card:focus-visible{outline:2px solid var(--acc);outline-offset:2px;}
.card.c6{grid-column:span 6;}.card.c12{grid-column:span 12;cursor:default;}
.card.c12:hover{transform:none;background:var(--glass-bg);}
@media(max-width:1020px){.card{grid-column:span 4;}.card.c6{grid-column:span 8;}}
@media(max-width:760px){.deck{gap:10px;}.card{grid-column:span 6;}.card.c6,.card.c12{grid-column:span 12;}}
@media(max-width:640px){.card,.card.c6{grid-column:span 12;}}
.card-eyebrow{font:600 9.5px/1 var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;justify-content:space-between;gap:8px;}
.card-eyebrow .ce-hint{font-size:11px;letter-spacing:0;opacity:0;transition:opacity .2s;color:var(--acc);text-transform:none;}
.card:hover .ce-hint{opacity:1;}
.card-big{font-size:19px;font-weight:750;letter-spacing:-.015em;line-height:1.2;}
.card-big.num{font-size:22px;}
.card-fact{font-size:11.5px;color:var(--muted);line-height:1.45;display:flex;justify-content:space-between;gap:10px;}
.card-fact b{color:var(--text);font-weight:600;font-family:var(--mono);}
.card-stance{font-size:11.5px;line-height:1.4;margin-top:auto;padding-top:6px;}
.muted{color:var(--muted);}.sm{font-size:12px;}.pos{color:var(--up);}.neg{color:var(--down);}.warn{color:var(--warn);}.neu{color:var(--muted);}
/* dialogs — the mx5OpenDlg system, verbatim mechanics */
html.dsr-dlg-lock{overflow:hidden;}
html.dsr-dlg-lock .sticky-strip{visibility:hidden;}
html.dsr-dlg-lock body{overflow:hidden;position:fixed;width:100%;}
.dsr-dlg{display:none;position:fixed;inset:0;z-index:300;align-items:center;justify-content:center;}
.dsr-dlg.open{display:flex;}
.dsr-dlg-backdrop{position:absolute;inset:0;background:rgba(3,6,10,.58);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);}
.dsr-dlg-panel{position:relative;z-index:1;max-width:960px;width:calc(100% - 48px);max-height:82vh;background:var(--dlg-bg);border:1px solid rgba(255,255,255,.10);border-radius:var(--radius);backdrop-filter:blur(28px) saturate(1.4);-webkit-backdrop-filter:blur(28px) saturate(1.4);box-shadow:0 40px 120px rgba(0,0,0,.72),0 2px 0 rgba(255,255,255,.06) inset;overflow-y:auto;display:flex;flex-direction:column;}
[data-theme="light"] .dsr-dlg-panel{border-color:rgba(0,0,0,.08);box-shadow:0 32px 96px rgba(0,0,0,.18);}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.dsr-dlg-panel{background:var(--dlg-pop);}}
.dsr-dlg-header{display:flex;align-items:center;justify-content:space-between;padding:18px 24px 14px;position:sticky;top:0;z-index:2;background:var(--dlg-bg);backdrop-filter:blur(20px) saturate(1.4);-webkit-backdrop-filter:blur(20px) saturate(1.4);border-bottom:1px solid rgba(255,255,255,.07);}
[data-theme="light"] .dsr-dlg-header{border-bottom-color:rgba(0,0,0,.07);}
.dsr-dlg-title{font:700 12px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
.dsr-dlg-close{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.07);border:none;cursor:pointer;color:var(--muted);font-size:18px;line-height:1;font-family:inherit;flex-shrink:0;transition:background .15s;}
.dsr-dlg-close:hover{background:rgba(255,255,255,.14);}
.dsr-dlg-body{padding:22px 24px 26px;flex:1;overflow-y:auto;overflow-x:hidden;}
.dsr-dlg-body section{margin:0 0 26px;}
.dsr-dlg-body h2{font:600 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0 0 12px;display:flex;align-items:center;gap:10px;}
.dsr-dlg-body h2::before{content:'';width:10px;height:1px;background:var(--acc);flex-shrink:0;}
.dsr-dlg-body h2::after{content:'';flex:1;height:1px;background:var(--hair);}
@media(prefers-reduced-motion:no-preference){
  .dsr-dlg-backdrop{opacity:0;transition:opacity 240ms ease-out;}
  .dsr-dlg.dsr-in .dsr-dlg-backdrop{opacity:1;}
  .dsr-dlg-panel{opacity:0;transform:translateY(14px) scale(.965);transition:opacity 320ms cubic-bezier(.22,.9,.26,1.02),transform 320ms cubic-bezier(.22,.9,.26,1.02);}
  .dsr-dlg.dsr-in .dsr-dlg-panel{opacity:1;transform:translateY(0) scale(1);}
  .dsr-dlg.dsr-closing .dsr-dlg-backdrop,.dsr-dlg.dsr-closing .dsr-dlg-panel{transition-duration:180ms;}
  .dsr-dlg-body > *{opacity:0;transform:translateY(10px);transition:opacity 300ms ease-out,transform 300ms cubic-bezier(.22,.9,.26,1.02);}
  .dsr-dlg.dsr-in .dsr-dlg-body > *{opacity:1;transform:translateY(0);}
  .dsr-dlg.dsr-in .dsr-dlg-body > *:nth-child(1){transition-delay:60ms;}
  .dsr-dlg.dsr-in .dsr-dlg-body > *:nth-child(2){transition-delay:100ms;}
  .dsr-dlg.dsr-in .dsr-dlg-body > *:nth-child(3){transition-delay:140ms;}
  .dsr-dlg.dsr-in .dsr-dlg-body > *:nth-child(n+4){transition-delay:170ms;}
  .dsr-closing .dsr-dlg-body > *{transition-delay:0ms!important;}
}
@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;}
  .dsr-dlg.open .dsr-dlg-backdrop,.dsr-dlg.open .dsr-dlg-panel,.dsr-dlg.open .dsr-dlg-body > *{opacity:1;transform:none;}
}
@media(max-width:700px){
  .dsr-dlg{align-items:flex-end;}
  .dsr-dlg-panel{width:calc(100% - 24px);max-width:none;max-height:85vh;border-radius:var(--radius) var(--radius) 0 0;margin:0 12px;}
  .dsr-dlg-close{width:44px;height:44px;font-size:22px;}
  .dsr-dlg-body{padding:18px 16px 26px;}
  .dsr-dlg-header{padding:14px 16px 10px;}
}

/* ── layout ── */
.page-wrap{max-width:1240px;margin:0 auto;padding:0 22px 48px;}
@media(min-width:1100px){.page-wrap{padding:0 40px 56px;}}
@media(max-width:600px){.page-wrap{padding:0 14px 36px;}}

/* ── sticky strip ── */
.sticky-strip{position:sticky;top:0;z-index:200;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line);padding:0 22px;display:flex;align-items:center;gap:14px;height:44px;overflow:hidden;}
@media(min-width:1100px){.sticky-strip{padding:0 40px;}}
@media(max-width:600px){.sticky-strip{padding:0 14px;gap:8px;}}
.strip-ticker{font-size:15px;font-weight:800;letter-spacing:.01em;}
.strip-price{font-size:14px;font-variant-numeric:tabular-nums;font-weight:600;}
.strip-spacer{flex:1;}
.strip-btn{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;padding:5px 11px;border-radius:8px;background:var(--link);color:#fff;white-space:nowrap;}
.strip-btn:hover{opacity:.88;}
@media(max-width:480px){.strip-ticker-name,.strip-sep{display:none;}}

/* ── section nav ── */
.section-nav{display:flex;gap:6px;flex-wrap:wrap;padding:16px 0 6px;overflow-x:auto;scrollbar-width:none;}
.section-nav::-webkit-scrollbar{display:none;}
.snav-chip{display:inline-flex;align-items:center;font-size:11.5px;padding:4px 11px;border-radius:20px;background:var(--panel2);border:1px solid var(--line);color:var(--muted);white-space:nowrap;cursor:pointer;}
.snav-chip:hover{border-color:var(--muted);color:var(--text);}
[id]{scroll-margin-top:56px;}

/* ── hero ── */
.breadcrumb{font:500 11px/1 var(--mono);letter-spacing:.06em;color:var(--muted);padding:16px 0 0;text-transform:uppercase;}
.breadcrumb a:hover{color:var(--acc);}
.hero{background:var(--glass-bg);border:1px solid var(--glass-border);border-radius:var(--radius);box-shadow:var(--glass-shadow);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:22px 26px 18px;margin-top:16px;}
@media(max-width:600px){.hero{padding:16px 14px 14px;}}
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px 36px;align-items:start;}
@media(max-width:820px){.hero-grid{grid-template-columns:1fr;gap:10px;}}
.hero-eyebrow{font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.hero-top{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;}
.hero h1{font-size:clamp(34px,4.6vw,52px);font-weight:900;margin:0;letter-spacing:-.035em;line-height:.95;}
.hero h1 a{color:inherit;}
.hero h1 a:hover{color:var(--acc);}
.hero-name{font-size:15px;color:var(--muted);font-weight:500;}
.price-block{display:flex;align-items:baseline;gap:12px;margin:0;flex-wrap:wrap;justify-content:flex-end;text-align:right;}
@media(max-width:820px){.price-block{justify-content:flex-start;text-align:left;}}
.price-big{font-size:clamp(28px,3.2vw,38px);font-weight:700;letter-spacing:-.02em;}
.price-chg{font-size:14px;font-weight:600;}
/* verdict stamp: the machine's ruling, boxed like a stamped receipt */
.verdict-stamp{border:1px solid color-mix(in srgb,var(--acc) 28%,var(--line));background:color-mix(in srgb,var(--acc) 4%,transparent);padding:10px 14px 12px;min-width:230px;max-width:330px;}
.verdict-stamp .vs-hd{font:500 9.5px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:12px;margin-bottom:8px;}
.verdict-stamp .vs-hd .vs-asof{color:color-mix(in srgb,var(--acc) 75%,var(--muted));}
@media(max-width:820px){.verdict-stamp{max-width:none;width:100%;}}
/* level rail — the signature: engine levels pinned on the 52-week axis */
.rail{margin:18px 0 0;padding:34px 0 14px;position:relative;}
.rail-legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:14px;}
.rl-chip{display:inline-flex;align-items:center;gap:6px;font:500 10.5px/1 var(--mono);color:var(--muted);}
.rl-chip b{color:var(--text);font-weight:700;}
.rl-dot{width:7px;height:7px;border-radius:50%;display:inline-block;background:var(--muted);}
.rl-dot.now{background:var(--acc);box-shadow:0 0 6px color-mix(in srgb,var(--acc) 50%,transparent);}
.rl-dot.stop{background:var(--down);}
.rl-dot.chase{background:var(--warn);}
.rl-dot.buy{background:var(--up);}
.rl-dot.wall{background:transparent;border:1.5px solid var(--muted);}
.card-chart-mini{margin:2px -4px -6px;overflow:hidden;border-radius:12px;}
.card-chart-mini svg{width:100%;height:auto;display:block;}
.chart-svg-box svg,.card-chart-mini svg{max-width:100%;}
body{overflow-x:hidden;}
.rail-axis{position:relative;height:2px;background:linear-gradient(to right,var(--hair),var(--line) 12%,var(--line) 88%,var(--hair));}
.rail-band{position:absolute;top:-3px;height:8px;background:color-mix(in srgb,var(--up) 22%,transparent);border-left:1px solid color-mix(in srgb,var(--up) 55%,transparent);border-right:1px solid color-mix(in srgb,var(--up) 55%,transparent);}
.rail-tick{position:absolute;width:2px;transform:translateX(-50%);}
.rail-tick.lane-top{top:-9px;height:20px;}
.rail-tick.lane-bot{top:-2px;height:13px;}
.rail-tick .rt-label{position:absolute;left:50%;transform:translateX(-50%);white-space:nowrap;font:500 9.5px/1.35 var(--mono);letter-spacing:.02em;text-align:center;background:color-mix(in srgb,var(--bg) 86%,transparent);padding:1px 4px;border-radius:3px;}
.rail-tick.lane-top .rt-label{bottom:24px;}
.rail-tick.lane-bot .rt-label{top:17px;}
.rail-tick.lane-top.tier1{height:32px;top:-21px;}
.rail-tick.lane-top.tier1 .rt-label{bottom:36px;}
.rail-tick.lane-top.tier2{height:46px;top:-35px;}
.rail-tick.lane-top.tier2 .rt-label{bottom:50px;}
.rail-tick.lane-bot.tier1{height:30px;}
.rail-tick.lane-bot.tier1 .rt-label{top:34px;}
.rail-tick.lane-bot.tier2{height:47px;}
.rail-tick.lane-bot.tier2 .rt-label{top:51px;}
.rail-tick.now{z-index:2;}
.rail-tick .rt-price{display:block;font-weight:700;color:var(--text);}
.rail-tick .rt-name{display:block;color:var(--muted);}
.rail-tick.now{background:var(--acc);width:3px;}
.rail-tick.now .rt-price{color:var(--acc);}
.rail-tick.now::after{content:'';position:absolute;top:-4px;left:50%;transform:translateX(-50%);width:7px;height:7px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 3px color-mix(in srgb,var(--acc) 22%,transparent);}
.rail-tick.stop{background:var(--down);}
.rail-tick.stop .rt-price{color:var(--down);}
.rail-tick.chase{background:var(--warn);}
.rail-tick.chase .rt-price{color:var(--warn);}
.rail-tick.buy{background:var(--up);}
.rail-tick.buy .rt-price{color:var(--up);}
.rail-tick.wall{background:var(--muted);opacity:.75;}
.rail-ends{display:flex;justify-content:space-between;font:500 9.5px/1 var(--mono);color:var(--muted);margin-top:20px;}
.rail-cap{font:500 9.5px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);position:absolute;top:2px;left:0;}
@media(max-width:600px){.rail-tick.lane-bot .rt-name{display:none;}.rail{padding-bottom:28px;}}
.stance-chip{display:inline-flex;align-items:center;font-size:12.5px;font-weight:700;padding:4px 13px;border-radius:10px;margin:6px 0;}
.stance-chip.pos{background:color-mix(in srgb,var(--up) 12%,var(--panel));border:1px solid color-mix(in srgb,var(--up) 35%,var(--line));color:var(--up);}
.stance-chip.neg{background:color-mix(in srgb,var(--down) 12%,var(--panel));border:1px solid color-mix(in srgb,var(--down) 35%,var(--line));color:var(--down);}
.stance-chip.warn{background:color-mix(in srgb,var(--warn) 12%,var(--panel));border:1px solid color-mix(in srgb,var(--warn) 35%,var(--line));color:var(--warn);}
.stance-chip.neu{background:var(--panel2);border:1px solid var(--line);color:var(--muted);}
/* one restrained pulse on the stance chip for the live-price freshness dot */
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--up);display:inline-block;margin-left:6px;animation:livepulse 3s ease-in-out infinite;}
@keyframes livepulse{0%,100%{opacity:1;}50%{opacity:.3;}}
.hero-desc{font-size:13.5px;color:var(--muted);margin:4px 0 6px;max-width:72ch;line-height:1.55;}
.hero-inv{font-size:12.5px;color:var(--muted);border-left:2px solid var(--warn);padding:5px 10px;margin:8px 0;max-width:70ch;}
.hero-asof{font-size:11.5px;color:var(--muted);margin-top:6px;}
.chip-row{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0;}
.chip{display:inline-flex;align-items:center;font-size:11px;padding:2px 9px;border-radius:7px;background:var(--panel2);border:1px solid var(--line);color:var(--muted);}
.chip.pos{color:var(--up);border-color:color-mix(in srgb,var(--up) 38%,var(--line));background:color-mix(in srgb,var(--up) 10%,var(--panel2));}
.chip.neg{color:var(--down);border-color:color-mix(in srgb,var(--down) 38%,var(--line));background:color-mix(in srgb,var(--down) 10%,var(--panel2));}
.chip.warn{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 38%,var(--line));background:color-mix(in srgb,var(--warn) 10%,var(--panel2));}
.cta-row{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0 4px;}
.btn-primary{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;padding:8px 18px;border-radius:10px;background:var(--link);color:#fff;transition:opacity .15s;}
.btn-primary:hover{opacity:.88;}
.btn-ghost{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:600;padding:7px 14px;border-radius:10px;background:var(--panel2);border:1px solid var(--line);color:var(--muted);transition:border-color .15s,color .15s;}
.btn-ghost:hover{border-color:var(--muted);color:var(--text);}

/* ── panels: two voices — "card" (interpretive, soft) vs table readouts
      (flat, rule-topped; applied via the section-level table styling) ── */
.panel{background:color-mix(in srgb,var(--panel) 72%,transparent);border:1px solid var(--hair);border-radius:10px;padding:16px 18px;margin-top:8px;}
.panel-hd{font:500 10px/1.5 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}

/* ── stat grid: flat data tiles, hairline-edged — terminal density ── */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px 22px;margin-top:4px;}
@media(max-width:900px){.stat-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.stat-grid{grid-template-columns:1fr 1fr;gap:12px 14px;}}
.stat-card{border-left:2px solid var(--hair);padding:2px 0 2px 12px;transition:border-color .15s;}
.stat-card:hover{border-left-color:var(--acc);}
.stat-k{font:500 9.5px/1 var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px;}
.stat-v{font-size:17px;font-weight:600;}
.stat-sub{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.4;}

/* ── chart ── */
.chart-wrap{margin-top:8px;}
.chart-svg-box{width:100%;overflow:hidden;border-radius:10px;}
.chart-svg-box svg{width:100%;height:auto;display:block;}
.chart-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
#chart-mount{display:none;margin-top:10px;height:340px;border-radius:10px;overflow:hidden;border:1px solid var(--line);}

/* ── gauge row ── */
.gauge-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:8px;}
@media(max-width:900px){.gauge-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:480px){.gauge-grid{grid-template-columns:1fr 1fr;}}
.gauge-card{background:color-mix(in srgb,var(--panel) 72%,transparent);border:1px solid var(--hair);border-radius:10px;padding:14px 15px;display:flex;flex-direction:column;gap:8px;transition:border-color .15s;}
.gauge-card:hover{border-color:color-mix(in srgb,var(--acc) 35%,var(--line));}
.gauge-title{font:500 9.5px/1 var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.1em;}
.gauge-val{font-size:19px;font-weight:600;}
.gauge-sub{font-size:11.5px;color:var(--muted);line-height:1.45;}
/* instrument bars: slim track, vertical tick marker (not a slider thumb) */
.val-bar-wrap{position:relative;height:4px;background:linear-gradient(to right,var(--up),var(--warn),var(--down));margin:7px 0;opacity:.9;}
.val-bar-marker{position:absolute;top:50%;transform:translate(-50%,-50%);width:2px;height:14px;background:var(--text);border-radius:0;box-shadow:0 0 0 1px var(--bg);}
.beta-track-wrap{margin:7px 0;}
.beta-track{position:relative;height:4px;background:var(--line);margin-bottom:6px;}
.beta-thumb{position:absolute;top:-5px;width:2px;height:14px;background:var(--acc);transform:translateX(-50%);box-shadow:0 0 0 1px var(--bg);border-radius:0;}
.beta-mid{position:absolute;top:-3px;left:calc((1 - 0.2) / 2.8 * 100%);width:1px;height:10px;background:var(--muted);opacity:.5;}
.beta-labels{display:flex;justify-content:space-between;font:500 9.5px/1 var(--mono);color:var(--muted);}
/* piotroski: square segments, a meter not confetti */
.pio-dots{display:flex;gap:3px;flex-wrap:wrap;}
.pio-dot{width:12px;height:6px;border-radius:1px;background:var(--line);}
.pio-dot.on{background:var(--up);}

/* ── performance ── */
.perf-table{width:100%;border-collapse:collapse;font-size:13px;}
.perf-table th{font-size:10.5px;color:var(--muted);font-weight:600;text-align:left;padding:4px 8px 6px;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--line);}
.perf-table td{padding:6px 8px;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);vertical-align:middle;}
.perf-bar{display:inline-block;height:5px;border-radius:2px;vertical-align:middle;margin-left:6px;min-width:2px;}
.season-strip{display:grid;grid-template-columns:repeat(12,1fr);gap:3px;margin-top:8px;}
.season-cell{border-radius:4px;padding:5px 2px;text-align:center;font-size:9.5px;font-weight:600;}
.season-label{font-size:9px;color:var(--muted);text-align:center;margin-top:2px;}
.season-this{outline:2px solid var(--link);outline-offset:-1px;}

/* ── financials ── */
.fin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:8px;}
@media(max-width:900px){.fin-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:480px){.fin-grid{grid-template-columns:1fr;}}
.fin-card{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 14px;}
.fin-card-title{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;}
.fin-bars{display:flex;align-items:flex-end;gap:3px;height:52px;}
.fin-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;}
.fin-bar{background:var(--link);border-radius:2px 2px 0 0;min-height:2px;width:100%;opacity:.8;}
.fin-bar-label{font-size:8.5px;color:var(--muted);text-align:center;white-space:nowrap;}
.fin-bar-val{font-size:8.5px;color:var(--text);text-align:center;white-space:nowrap;margin-top:2px;}
.kv-table{width:100%;font-size:12.5px;border-collapse:collapse;margin-top:6px;}
.kv-table td{padding:4px 0;vertical-align:top;}
.kv-table td:first-child{color:var(--muted);width:55%;padding-right:6px;}
.kv-table td:last-child{font-weight:600;text-align:right;}
.kv-sep{border-top:1px solid var(--line);}
.margin-bar-row{display:flex;align-items:center;gap:8px;font-size:12px;padding:3px 0;}
.margin-bar-row .mbr-k{color:var(--muted);flex:1;}
.margin-bar-bg{flex:2;height:5px;border-radius:3px;background:var(--line);overflow:hidden;}
.margin-bar-fill{height:100%;border-radius:3px;background:var(--link);}
.margin-bar-val{width:40px;text-align:right;font-weight:600;font-size:12px;}
.cagr-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px;}
.cagr-chip{display:inline-flex;flex-direction:column;align-items:center;padding:6px 12px;background:var(--panel);border:1px solid var(--line);border-radius:8px;}
.cagr-chip .cv{font-size:16px;font-weight:800;}
.cagr-chip .ck{font-size:10px;color:var(--muted);}

/* ── valuation ── */
.val-table{width:100%;border-collapse:collapse;font-size:13px;}
.val-table th{font-size:10.5px;color:var(--muted);font-weight:600;padding:4px 8px 6px;text-align:left;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--line);}
.val-table td{padding:6px 8px;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);vertical-align:middle;}
.val-table td:last-child{text-align:right;}
.cheap-bar-bg{display:inline-block;width:60px;height:5px;border-radius:3px;background:var(--line);vertical-align:middle;overflow:hidden;}
.cheap-bar-fill{height:100%;border-radius:3px;}

/* ── earnings ── */
.earns-countdown{text-align:center;padding:18px 10px 10px;background:var(--panel2);border-radius:10px;border:1px solid var(--line);}
.earns-countdown .days{font-size:36px;font-weight:900;font-variant-numeric:tabular-nums;line-height:1;}
.earns-countdown .days-label{font-size:12px;color:var(--muted);margin-top:3px;}
.surprise-table{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:10px;}
.surprise-table td,.surprise-table th{padding:5px 8px;text-align:right;}
.surprise-table th{font-size:10.5px;color:var(--muted);font-weight:600;text-align:left;border-bottom:1px solid var(--line);text-transform:uppercase;letter-spacing:.04em;}
.surprise-table td:first-child{text-align:left;color:var(--muted);}
.surprise-bar{display:inline-block;height:4px;border-radius:2px;vertical-align:middle;margin-left:4px;min-width:2px;}

/* ── technicals ── */
.tech-consensus-bar{height:8px;border-radius:4px;background:var(--line);overflow:hidden;margin:8px 0;}
.tech-consensus-fill{height:100%;border-radius:4px;background:var(--up);}
.tech-row{display:flex;align-items:baseline;gap:8px;padding:5px 0;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);font-size:13px;}
.tech-row:last-child{border-bottom:0;}
.tech-row .tk{color:var(--muted);flex:1;font-size:12px;}
.levels-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px;}
.level-card{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 11px;text-align:center;}
.level-k{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;}
.level-v{font-size:15px;font-weight:800;font-variant-numeric:tabular-nums;}
.level-card.entry{border-color:color-mix(in srgb,var(--up) 40%,var(--line));}
.level-card.chase{border-color:color-mix(in srgb,var(--warn) 40%,var(--line));}
.level-card.stop{border-color:color-mix(in srgb,var(--down) 40%,var(--line));}

/* ── options ── */
.gex-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px;}
@media(max-width:600px){.gex-grid{grid-template-columns:repeat(2,1fr);}}
.gex-cell{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:9px 11px;}
.gex-k{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:3px;}
.gex-v{font-size:15px;font-weight:720;font-variant-numeric:tabular-nums;}

/* ── why moving ── */
.why-row{display:flex;align-items:flex-start;gap:10px;padding:7px 0;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);font-size:13px;}
.why-row:last-child{border-bottom:0;}
.why-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.why-dot.active{background:var(--up);}
.why-dot.quiet{background:var(--line);}
.why-cat{color:var(--muted);width:90px;flex-shrink:0;font-size:12px;}
.why-line{flex:1;line-height:1.45;}

/* ── ownership ── */
.holder-table{width:100%;border-collapse:collapse;font-size:12.5px;}
.holder-table th{font-size:10.5px;color:var(--muted);font-weight:600;padding:4px 8px 6px;text-align:left;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--line);}
.holder-table td{padding:6px 8px;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);vertical-align:middle;}
.grade-chip{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:5px;font-size:11px;font-weight:700;}
.grade-chip.A{background:color-mix(in srgb,var(--up) 18%,var(--panel2));color:var(--up);}
.grade-chip.B{background:color-mix(in srgb,var(--warn) 18%,var(--panel2));color:var(--warn);}
.grade-chip.C{background:var(--panel2);color:var(--muted);}

/* ── peers ── */
.peers-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin-top:8px;}
.peer-card{background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:10px 12px;transition:transform .15s,border-color .15s;}
.peer-card:hover{transform:translateY(-1px);border-color:var(--muted);}
.peer-card .ptk{font-size:14px;font-weight:720;color:var(--link);}
.peer-card .pnm{font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

/* ── themes ── */
.basket-row{display:flex;align-items:flex-start;gap:10px;padding:6px 0;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);font-size:13px;}
.basket-row:last-child{border-bottom:0;}
.basket-name{font-weight:600;color:var(--link);}
.basket-name:hover{text-decoration:underline;}
.basket-theme{font-size:12px;color:var(--muted);flex:1;}

/* ── signal history ── */
.pinned-bar{background:color-mix(in srgb,var(--warn) 10%,var(--panel2));border:1px solid color-mix(in srgb,var(--warn) 30%,var(--line));border-radius:10px;padding:12px 14px;margin-top:8px;}
.pinned-hl{font-size:13px;font-weight:700;}
.pinned-detail{font-size:12.5px;color:var(--muted);margin-top:4px;}
.timeline .ev{display:flex;gap:10px;padding:5px 0;border-top:1px solid color-mix(in srgb,var(--line) 50%,transparent);font-size:12.5px;align-items:flex-start;}
.timeline .ev:first-child{border-top:0;}
.timeline .dt{color:var(--muted);width:82px;flex:0 0 82px;font-size:11.5px;font-variant-numeric:tabular-nums;padding-top:2px;}
.ev-dir{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.ev-dir.up{background:var(--up);}
.ev-dir.down{background:var(--down);}
.ev-dir.caution{background:var(--warn);}
.ev-dir.neutral{background:var(--muted);}
.ev-body{flex:1;}
.ev-hl{font-weight:600;line-height:1.35;}
.ev-detail{font-size:11.5px;color:var(--muted);margin-top:2px;line-height:1.4;}

/* ── company profile ── */
.profile-text{font-size:13.5px;line-height:1.65;color:var(--text);margin-top:6px;}
.falsifier-list{list-style:none;padding:0;margin:8px 0;display:flex;flex-direction:column;gap:4px;}
.falsifier-list li{font-size:12.5px;color:var(--muted);padding-left:16px;position:relative;}
.falsifier-list li::before{content:'!';position:absolute;left:0;color:var(--warn);font-weight:700;}

/* ── AI brief ── */
.brief-body{font-size:13px;line-height:1.6;}
.brief-section h3{font-size:12px;font-weight:700;margin:12px 0 4px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;}
.brief-section ul{margin:0;padding-left:18px;}
.brief-section li{margin:2px 0;}
.brief-disc{font-size:11px;color:var(--muted);margin-top:10px;padding:6px 10px;background:var(--panel2);border-radius:6px;border:1px solid var(--line);}

/* ── CTA band: flat, accent-edged — an instruction, not an ad ── */
.cta-band{background:color-mix(in srgb,var(--acc) 5%,var(--panel));border:1px solid var(--hair);border-left:3px solid var(--acc);border-radius:0 10px 10px 0;padding:24px 28px;margin:46px 0 0;}
.cta-inner{display:flex;align-items:center;gap:24px;flex-wrap:wrap;}
.cta-copy{flex:1;min-width:240px;}
.cta-hl{font-size:18px;font-weight:720;margin-bottom:6px;}
.cta-sub{font-size:13px;color:var(--muted);line-height:1.5;}
.cta-actions{display:flex;gap:10px;flex-shrink:0;flex-wrap:wrap;}
.cta-btn-primary{padding:10px 22px;background:var(--link);color:#fff;border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;transition:opacity .15s;}
.cta-btn-primary:hover{opacity:.85;}
.cta-btn-secondary{padding:10px 22px;background:transparent;color:var(--text);border:1px solid var(--line);border-radius:8px;font-weight:600;font-size:14px;text-decoration:none;transition:border-color .15s;}
.cta-btn-secondary:hover{border-color:var(--muted);}
.site-footer{margin-top:40px;border-top:1px solid var(--line);padding:18px 0 32px;color:var(--muted);font-size:12px;line-height:1.7;}
.footer-inner a{color:var(--link);}
.footer-inner a:hover{text-decoration:underline;}

/* ── news ── */
.news-row{padding:6px 0;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);font-size:13px;}
.news-row:last-child{border-bottom:0;}
.news-row a{color:var(--link);}
.news-row a:hover{text-decoration:underline;}
.news-src{color:var(--muted);font-size:11.5px;margin-left:6px;}
.news-date{color:var(--muted);font-size:11.5px;margin-left:6px;}

/* ── factor profile ── */
.factor-row2{display:flex;align-items:center;gap:10px;padding:5px 0;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent);font-size:13px;}
.factor-row2:last-child{border-bottom:0;}
.factor-bar-bg{flex:1;height:5px;border-radius:3px;background:var(--line);overflow:hidden;max-width:100px;}
.factor-bar-fill{height:100%;border-radius:3px;}
.factor-bar-fill.pos{background:var(--up);}
.factor-bar-fill.neg{background:var(--down);}

/* ── footer ── */
footer{color:var(--muted);font-size:11.5px;margin-top:28px;border-top:1px solid var(--line);padding-top:14px;max-width:95ch;}
/* ── misc ── */
.placeholder-line{font-size:12px;color:var(--muted);padding:8px 0;border-top:1px solid var(--line);margin-top:6px;}
@media(max-width:720px){
  .gauge-grid,.fin-grid,.gex-grid,.levels-row{grid-template-columns:repeat(2,1fr);}
  .stat-grid{grid-template-columns:repeat(2,1fr);}
  .perf-table td,.perf-table th{padding:4px 5px;}
  .cta-band{padding:16px 16px;}
}
</style>
</head>
<body>
<div class="aurora{% if hero and hero.stance_class == 'warn' %} au-warn{% elif hero and hero.stance_class == 'neg' %} au-neg{% endif %}" aria-hidden="true"></div>
{% include "_site_nav.html.j2" %}
<main>

<!-- ── Sticky strip ── -->
<div class="sticky-strip">
  <span class="strip-ticker">{{ ticker }}</span>
  <span class="strip-ticker-name muted sm">{{ name }}</span>
  <span class="strip-sep muted">·</span>
  <span class="strip-price">
    {%- if hero and hero.price -%}
    <span class="nb-px" data-sym="{{ ticker }}" data-mkt="us">${{ hero.price }}</span>
    {%- endif -%}
  </span>
  {% if hero %}<span class="stance-chip {{ hero.stance_class or 'neu' }}" style="font-size:11px;padding:2px 9px;">{{ t(hero.stance_en, hero.stance_zh) }}</span>{% endif %}
  <span class="strip-spacer"></span>
  <a class="strip-btn" href="https://app.mastermind-x.com/terminal?sym={{ ticker }}&from=macro" rel="noopener noreferrer" target="_blank">{{ t('Terminal', '终端') }} ↗</a>
</div>

<div class="page-wrap">

<!-- ── Breadcrumb ── -->
<p class="breadcrumb">
  <a href="../stocks/index.html">{{ t('All coverage', '所有股票') }}</a>
  {% if hero and hero.sector %} · <span class="muted">{{ hero.sector }}</span>{% endif %}
</p>

<!-- ── Hero ── -->
<section class="hero" id="hero">
  <div class="hero-grid">
    <div>
      <div class="hero-eyebrow">{{ name }}{% if hero and hero.sector %} · {{ hero.sector }}{% endif %}</div>
      <div class="hero-top">
        <h1><a href="https://app.mastermind-x.com/terminal?sym={{ ticker }}&from=macro" rel="noopener noreferrer" target="_blank">{{ ticker }}</a></h1>
        <div class="price-block">
          <span class="price-big">
            {%- if hero and hero.price -%}
            $<span class="nb-px" data-sym="{{ ticker }}" data-mkt="us">{{ hero.price }}</span>
            {%- else -%}—
            {%- endif -%}
          </span>
          {% if not stale %}<span class="live-dot" title="Updated intraday"></span>{% endif %}
        </div>
      </div>

      {% if hero and hero.desc_en %}
      <div class="hero-desc">{{ t(hero.desc_en, hero.desc_zh) }}</div>
      {% endif %}

      {% if hero %}
      <div class="chip-row">
        {% if hero.arch_label_en %}<span class="chip">{{ t(hero.arch_label_en, hero.arch_label_zh) }}</span>{% endif %}
        {% if hero.mktcap_label_en %}<span class="chip">{{ t(hero.mktcap_label_en, hero.mktcap_label_zh) }}</span>{% endif %}
        {% if stats and stats.mktcap %}<span class="chip">{{ stats.mktcap }}</span>{% endif %}
      </div>
      {% endif %}
    </div>

    {% if hero %}
    <div class="verdict-stamp">
      <div class="vs-hd"><span>{{ t('Engine stance', '引擎立场') }}</span><span class="vs-asof">{{ freshness }}</span></div>
      <span class="stance-chip {{ hero.stance_class or 'neu' }}">
        {{ t(hero.stance_en, hero.stance_zh) }}
      </span>
      {% if hero.inv_en %}
      <div class="hero-inv"><span class="l-en">{{ hero.inv_en }}</span><span class="l-zh">{{ hero.inv_zh }}</span></div>
      {% endif %}
      {% if stale %}<div class="sm warn">{{ t('Data may be stale', '数据可能已过期') }}</div>{% endif %}
    </div>
    {% endif %}
  </div>

  {% if hero and hero.rail %}
  <div class="rail" aria-hidden="true">
    <span class="rail-cap">{{ t('Engine levels · 52-week range', '引擎点位 · 52周区间') }}</span>
    <div class="rail-axis">
      {% if hero.rail.band %}
      <div class="rail-band" style="left:{{ hero.rail.band.lo_pct }}%;width:{{ hero.rail.band.hi_pct - hero.rail.band.lo_pct }}%;"></div>
      {% endif %}
      {% for tk in hero.rail.ticks %}
      <div class="rail-tick {{ tk.cls }} lane-{{ tk.lane }}{% if tk.get('tier') %} tier{{ tk.tier }}{% endif %}" style="left:{{ tk.pct }}%;">
        <span class="rt-label"><span class="rt-price">{{ tk.price }}</span></span>
      </div>
      {% endfor %}
    </div>
    <div class="rail-ends"><span>{{ hero.rail.lo }}</span><span>{{ hero.rail.hi }}</span></div>
    <div class="rail-legend">
      {% for tk in hero.rail.ticks %}<span class="rl-chip"><i class="rl-dot {{ tk.cls }}"></i>{{ t(tk.label_en, tk.label_zh) }} <b>{{ tk.price }}</b></span>{% endfor %}
      {% if hero.rail.band %}<span class="rl-chip"><i class="rl-dot buy"></i>{{ t(hero.rail.band.label_en, hero.rail.band.label_zh) }} <b>{{ hero.rail.band.price }}</b></span>{% endif %}
    </div>
  </div>
  {% endif %}

  <div class="cta-row">
    <a class="btn-primary" href="https://app.mastermind-x.com/terminal?sym={{ ticker }}&from=macro" rel="noopener noreferrer" target="_blank">{{ t('Open in Terminal', '打开终端') }} ↗</a>
    <button class="btn-ghost" onclick="(function(){var u=window.location.href;if(navigator.clipboard){navigator.clipboard.writeText(u);}else{var t=document.createElement('textarea');t.value=u;document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);}this.textContent=document.documentElement.getAttribute('data-lang')==='zh'?'已复制!':'Copied!';})()" style="cursor:pointer;">{{ t('Copy link', '复制链接') }}</button>
    <a class="btn-ghost" href="../stocks/index.html">{{ t('All coverage', '所有股票') }}</a>
    <span class="hero-asof" style="align-self:center;margin-left:auto;">{{ t('Data through', '数据截至') }} {{ freshness }} · {{ t('regenerated nightly', '每日更新') }}</span>
  </div>
</section>



