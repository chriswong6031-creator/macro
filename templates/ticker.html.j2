{%- macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro -%}
{% set nav_prefix = '../' %}
{% set terminal_url = 'https://app.mastermind-x.com/terminal?sym=' ~ ticker ~ '&from=macro' %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ ticker }} — {{ name }}: signals, options &amp; factor profile | Mastermind</title>
{% if stale %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ meta_desc }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="{{ ticker }} — {{ name }}: signals &amp; factor profile">
<meta property="og:description" content="{{ meta_desc }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="article">
{% if og_image_url %}<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ og_image_url }}">{% endif %}
<link rel="dns-prefetch" href="https://app.mastermind-x.com">
<link rel="preconnect" href="https://app.mastermind-x.com" crossorigin>
<script type="application/ld+json">{{ jsonld_str | safe }}</script>
<script data-dbase src="../data_base.js"></script>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);document.documentElement.classList.add('has-js');}catch(e){}</script>
<link rel="stylesheet" href="../theme.css">
<style>
/* ══ dossier v6 ═══════════════════════════════════════════════════════════
   One voice: Inter (--font-ui) everywhere; numbers are tabular Inter, never
   monospace. The page is tinted by the engine stance (--stance): aurora,
   hero ribbon and ladder all derive from the same verdict. */
*{box-sizing:border-box;}
:root{--stance:var(--muted);
      --hair:color-mix(in srgb,var(--line) 60%,transparent);
      --v6-radius:18px;}
body.st-pos{--stance:var(--up);}
body.st-warn{--stance:var(--warn);}
body.st-neg{--stance:var(--down);}
html body{font:400 13.5px/1.55 var(--font-ui);background:var(--bg);color:var(--text);margin:0;padding:24px 0 0;-webkit-font-smoothing:antialiased;}  /* 24px top gap = check_nav_gap contract */
a{text-decoration:none;color:inherit;}
.num{font-variant-numeric:tabular-nums;letter-spacing:-.01em;}
.pos{color:var(--up);}.neg{color:var(--down);}.wrn{color:var(--warn);}.mut{color:var(--muted);}
.sm{font-size:12px;}

/* aurora — stance-tinted room light (plain gradients: no filter cost) */
.aurora{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;}
.aurora::before{content:"";position:absolute;width:1100px;height:780px;top:-260px;left:-180px;
  background:radial-gradient(closest-side,color-mix(in srgb,var(--stance) 9%,transparent) 0%,transparent 78%);}
.aurora::after{content:"";position:absolute;width:820px;height:640px;bottom:-160px;right:-140px;
  background:radial-gradient(closest-side,color-mix(in srgb,var(--info) 6%,transparent) 0%,transparent 78%);}

/* sticky jump strip */
.strip{position:fixed;top:0;left:0;right:0;z-index:220;display:flex;align-items:center;gap:12px;height:48px;
  padding:0 22px;background:color-mix(in srgb,var(--bg) 86%,transparent);
  backdrop-filter:blur(18px) saturate(150%);-webkit-backdrop-filter:blur(18px) saturate(150%);
  border-bottom:1px solid var(--hair);transform:translateY(-100%);transition:transform .3s cubic-bezier(.22,.9,.26,1.02);}
.strip.vis{transform:translateY(0);}
.strip .stk{font-size:14.5px;font-weight:800;}
.strip .stp{font-size:13.5px;font-weight:650;}
.schip{font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;white-space:nowrap;
  color:var(--stance);background:color-mix(in srgb,var(--stance) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--stance) 30%,transparent);}
.strip nav{display:flex;gap:2px;margin-left:6px;overflow-x:auto;scrollbar-width:none;flex:1;}
.strip nav::-webkit-scrollbar{display:none;}
.strip nav a{font-size:12px;color:var(--muted);padding:5px 10px;border-radius:8px;white-space:nowrap;}
.strip nav a:hover{color:var(--text);background:var(--gbtn-bg);}
.strip nav a.is-on{color:var(--text);background:color-mix(in srgb,var(--link) 14%,transparent);}
@media(max-width:760px){.strip nav{display:none;}.strip .sname{display:none;}}

/* layout */
.page-wrap{position:relative;z-index:1;max-width:1240px;margin:0 auto;padding:0 26px 60px;}
.crumb{font-size:11.5px;font-weight:550;color:var(--muted);padding:18px 2px 0;letter-spacing:.02em;}
.crumb a:hover{color:var(--link);}
.crumb b{color:var(--text);font-weight:600;}

/* module chrome */
.mod{background:var(--glass-bg);border:1px solid var(--glass-brd);border-radius:var(--v6-radius);
  box-shadow:var(--glass-shadow);backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);
  padding:20px 24px 22px;min-width:0;}
.mod-hd{display:flex;align-items:baseline;gap:10px;margin:0 0 16px;padding-bottom:12px;border-bottom:1px solid var(--hair);}
.mod-hd h2{display:flex;align-items:center;gap:10px;margin:0;font-size:15.5px;font-weight:650;letter-spacing:-.01em;}
.mod-hd h2::before{content:"";width:3px;height:15px;border-radius:2px;flex-shrink:0;
  background:linear-gradient(180deg,var(--link),color-mix(in srgb,var(--link) 30%,transparent));}
.mod-hd .hint{margin-left:auto;font-size:11.5px;color:var(--muted);font-weight:500;white-space:nowrap;display:flex;align-items:center;gap:8px;}
.mod-ft{margin-top:14px;padding-top:10px;border-top:1px solid var(--hair);font-size:11.5px;color:var(--muted);line-height:1.5;}

/* reveal-on-scroll (html.js gated; reduced-motion opts out; no-JS shows all) */
html.has-js .rv{opacity:0;transform:translateY(16px);}
html.has-js .rv.in{opacity:1;transform:none;transition:opacity .55s ease,transform .55s cubic-bezier(.22,.9,.26,1.02);transition-delay:var(--d,0ms);}
@media(prefers-reduced-motion:reduce){html.has-js .rv{opacity:1;transform:none;transition:none;}}

/* hero */
.hero{position:relative;margin-top:14px;padding:26px 30px 0;overflow:hidden;}
.hero::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;
  background:linear-gradient(180deg,var(--stance),color-mix(in srgb,var(--stance) 12%,transparent));}
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px 48px;align-items:start;}
.eyebrow{font-size:10.5px;font-weight:650;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);}
.hero h1{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 16px;margin:6px 0 0;
  font-size:clamp(38px,4.8vw,54px);font-weight:900;letter-spacing:-.04em;line-height:.95;}
.hero h1 a:hover{color:var(--link);}
.hero h1 .co{font-size:15px;font-weight:550;letter-spacing:0;color:var(--muted);}
.hero-desc{margin:12px 0 0;max-width:66ch;font-size:13px;line-height:1.6;color:var(--muted);}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0 0;}
.chip6{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:3px 10px;
  border-radius:999px;background:var(--gbtn-bg);border:1px solid var(--gbtn-brd);color:var(--muted);}
.px-block{text-align:right;min-width:230px;}
.px-big{font-size:clamp(32px,3.6vw,44px);font-weight:750;letter-spacing:-.025em;line-height:1;}
.px-chg{display:inline-flex;align-items:center;gap:6px;margin-top:8px;font-size:13.5px;font-weight:650;}
.px-chg .pill6{padding:2px 9px;border-radius:8px;}
.px-chg.pos .pill6{background:color-mix(in srgb,var(--up) 13%,transparent);border:1px solid color-mix(in srgb,var(--up) 30%,transparent);}
.px-chg.neg .pill6{background:color-mix(in srgb,var(--down) 13%,transparent);border:1px solid color-mix(in srgb,var(--down) 30%,transparent);}
.live-dot{width:6px;height:6px;border-radius:50%;background:var(--up);display:inline-block;animation:v6lp 3s ease-in-out infinite;}
@keyframes v6lp{0%,100%{opacity:1;}50%{opacity:.25;}}
.wk52{margin-top:16px;}
.wk52 .lbls{display:flex;justify-content:space-between;gap:14px;font-size:10.5px;color:var(--muted);margin-bottom:5px;}
.wk52 .lbls b{color:var(--text);font-weight:650;}
.wk52 .track{position:relative;height:4px;border-radius:3px;background:var(--line);}
.wk52 .fill{position:absolute;top:0;bottom:0;left:0;border-radius:3px;
  background:linear-gradient(90deg,color-mix(in srgb,var(--link) 40%,transparent),var(--link));}
.wk52 .dotp{position:absolute;top:50%;transform:translate(-50%,-50%);
  width:10px;height:10px;border-radius:50%;background:var(--text);box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 35%,transparent);}
.stance-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:22px -30px 0;padding:13px 30px;
  border-top:1px solid var(--hair);background:color-mix(in srgb,var(--stance) 5%,transparent);}
.stance-big{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:750;padding:6px 14px;border-radius:10px;
  color:var(--stance);background:color-mix(in srgb,var(--stance) 13%,transparent);
  border:1px solid color-mix(in srgb,var(--stance) 32%,transparent);}
.stance-line{flex:1;min-width:260px;font-size:12.5px;color:var(--muted);line-height:1.5;}
.asof{font-size:11px;color:var(--muted);white-space:nowrap;}
@media(prefers-reduced-motion:no-preference){
  html.has-js .hi{opacity:0;transform:translateY(12px);animation:v6hin .6s cubic-bezier(.22,.9,.26,1.02) forwards;}
  html.has-js .hi2{animation-delay:.08s;}html.has-js .hi3{animation-delay:.16s;}html.has-js .hi4{animation-delay:.24s;}
  @keyframes v6hin{to{opacity:1;transform:none;}}
}

/* chart module */
.chart-mod{margin-top:20px;padding:0;overflow:hidden;}
.chart-mod .mod-hd{padding:16px 24px 12px;margin:0;border-bottom:1px solid var(--hair);}
.chart-frame{position:relative;height:clamp(360px,42vw,520px);background:color-mix(in srgb,#0b0d11 40%,transparent);}
[data-theme="light"] .chart-frame{background:color-mix(in srgb,var(--panel2) 55%,transparent);}
.chart-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;opacity:0;transition:opacity .45s ease;}
.chart-frame.loaded iframe{opacity:1;}
.chart-skel{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px;overflow:hidden;}
.chart-skel::before{content:"";position:absolute;inset:0;
  background:linear-gradient(100deg,transparent 30%,color-mix(in srgb,var(--text) 4%,transparent) 50%,transparent 70%);
  transform:translateX(-100%);animation:v6sk 1.6s ease-in-out infinite;}
@media(prefers-reduced-motion:reduce){.chart-skel::before{animation:none;}}
@keyframes v6sk{to{transform:translateX(100%);}}
.chart-frame.loaded .chart-skel,.chart-frame.failed .chart-skel{display:none;}
.chart-fallback{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--muted);font-size:13px;text-align:center;padding:20px;}
.chart-frame.failed .chart-fallback{display:flex;}
.chart-ft{display:flex;align-items:center;gap:14px;flex-wrap:wrap;padding:10px 24px 14px;border-top:1px solid var(--hair);}
.powered{margin-left:auto;display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:650;color:var(--muted);}
.powered:hover{color:var(--link);}
.powered .bolt{width:16px;height:16px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;
  background:linear-gradient(135deg,var(--link),var(--info));color:#0f1115;font-size:10px;font-weight:900;}

/* two-column zone */
.cols{display:grid;grid-template-columns:minmax(0,1fr) 322px;gap:20px;margin-top:20px;align-items:start;}
.main-col,.rail-col{display:flex;flex-direction:column;gap:20px;min-width:0;}

/* ladder */
.lrow{position:relative;display:grid;grid-template-columns:84px 18px minmax(0,1fr) auto;gap:0 10px;align-items:center;
  padding:9px 6px;border-radius:12px;transition:background .18s;}
.lrow:hover{background:color-mix(in srgb,var(--panel2) 55%,transparent);}
.lrow .lpx{font-size:13.5px;font-weight:700;text-align:right;}
.lrow .lnode{position:relative;display:flex;align-items:center;justify-content:center;height:100%;}
.lrow .lnode::before{content:"";position:absolute;top:-10px;bottom:-10px;width:2px;background:var(--hair);}
.lrow:first-child .lnode::before{top:50%;}
.lrow.llast .lnode::before{bottom:50%;}
.ldot{position:relative;z-index:1;width:9px;height:9px;border-radius:50%;background:var(--muted);box-shadow:0 0 0 3px var(--panel);}
.ldot.wall{background:transparent;border:2px solid var(--muted);width:8px;height:8px;}
.ldot.chase{background:var(--warn);}
.ldot.buy{background:var(--up);}
.ldot.stop{background:var(--down);}
.lrow .lk{font-size:12.5px;font-weight:600;line-height:1.25;}
.lrow .lk small{display:block;font-size:11px;font-weight:500;color:var(--muted);margin-top:1px;}
.lrow .ld{font-size:11.5px;font-weight:650;color:var(--muted);}
.lrow.now{background:color-mix(in srgb,var(--stance) 8%,var(--panel2));
  border:1px solid color-mix(in srgb,var(--stance) 26%,transparent);box-shadow:0 8px 22px -12px rgba(3,7,18,.8);
  margin:3px -2px;padding:11px 8px;}
.lrow.now .lpx{font-size:15px;color:var(--text);}
.lrow.now .ldot{background:var(--stance);box-shadow:0 0 0 3px var(--panel),0 0 10px color-mix(in srgb,var(--stance) 60%,transparent);}
.lband{position:relative;margin:2px 0 2px 102px;padding:7px 12px;border-radius:10px;
  background:color-mix(in srgb,var(--up) 8%,transparent);border:1px dashed color-mix(in srgb,var(--up) 35%,transparent);
  font-size:11.5px;color:var(--up);font-weight:600;line-height:1.4;}

/* key-value rows */
.kv6 .r6{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:7px 0;border-bottom:1px solid var(--hair);font-size:12.5px;}
.kv6 .r6:last-child{border-bottom:0;}
.kv6 .k6{color:var(--muted);}
.kv6 .v6{font-weight:650;text-align:right;}

/* technicals */
.trow{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--hair);font-size:12.5px;flex-wrap:wrap;}
.trow:last-child{border-bottom:0;}
.trow .tk{color:var(--muted);flex:0 0 130px;}
.trow .tv6{font-weight:650;}
.minitrack{position:relative;flex:1;max-width:150px;min-width:90px;height:5px;border-radius:3px;background:var(--line);}
.minitrack .zone{position:absolute;top:0;bottom:0;left:30%;right:30%;background:color-mix(in srgb,var(--muted) 22%,transparent);border-radius:3px;}
.minitrack .mk{position:absolute;top:50%;transform:translate(-50%,-50%);width:2.5px;height:13px;border-radius:2px;background:var(--warn);}
.okx{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:2px 9px;border-radius:999px;}
.okx.y{color:var(--up);background:color-mix(in srgb,var(--up) 12%,transparent);}
.okx.n{color:var(--down);background:color-mix(in srgb,var(--down) 12%,transparent);}
.okx.w{color:var(--warn);background:color-mix(in srgb,var(--warn) 12%,transparent);}
.okx.q{color:var(--muted);background:color-mix(in srgb,var(--muted) 12%,transparent);}
.sigchips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px;}

/* earnings */
.earn-top{display:grid;grid-template-columns:auto minmax(0,1fr);gap:20px;align-items:center;}
.cring{position:relative;width:92px;height:92px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;
  background:conic-gradient(var(--link) calc(var(--p)*1%),color-mix(in srgb,var(--line) 60%,transparent) 0);}
.cring::before{content:"";position:absolute;inset:7px;border-radius:50%;background:var(--panel);}
.cring .cd{position:relative;text-align:center;line-height:1.05;}
.cring .cd b{font-size:24px;font-weight:800;}
.cring .cd > span{display:block;font-size:9.5px;color:var(--muted);font-weight:600;letter-spacing:.05em;text-transform:uppercase;margin-top:2px;}
.sbars{display:flex;align-items:flex-end;gap:10px;height:78px;margin-top:10px;}
.sbar{flex:1;max-width:64px;display:flex;flex-direction:column;align-items:center;gap:4px;}
.sbar i{width:100%;max-width:44px;border-radius:5px 5px 2px 2px;background:linear-gradient(180deg,var(--up),color-mix(in srgb,var(--up) 45%,transparent));}
.sbar i.m{background:linear-gradient(180deg,var(--down),color-mix(in srgb,var(--down) 45%,transparent));}
.sbar b{font-size:10.5px;font-weight:700;}
.sbar span{font-size:9.5px;color:var(--muted);}

/* tables */
.vt{width:100%;border-collapse:collapse;font-size:12.5px;}
.vt th{font-size:10.5px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;text-align:left;padding:2px 8px 8px;border-bottom:1px solid var(--hair);}
.vt td{padding:8px;border-bottom:1px solid var(--hair);}
.vt tr:last-child td{border-bottom:0;}
.vt td:nth-child(n+2){text-align:right;}
.vt td.b{font-weight:700;}
.cheapbar{display:inline-flex;align-items:center;gap:8px;justify-content:flex-end;}
.cheapbar .cb{width:74px;height:5px;border-radius:3px;background:var(--line);overflow:hidden;}
.cheapbar .cb i{display:block;height:100%;border-radius:3px;}

/* financials */
.fin3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.fcard{background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--hair);border-radius:13px;padding:13px 14px;min-width:0;}
.fcard .ft{font-size:11px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;}
.fcard .fbars{display:flex;align-items:flex-end;gap:5px;height:70px;margin-top:10px;}
.fcard .fb{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;min-width:0;}
.fcard .fb i{width:100%;border-radius:4px 4px 2px 2px;background:linear-gradient(180deg,var(--link),color-mix(in srgb,var(--link) 35%,transparent));}
.fcard .fb i.dn6{background:linear-gradient(180deg,var(--down),color-mix(in srgb,var(--down) 35%,transparent));}
.fcard .fb b{font-size:8.5px;font-weight:600;color:var(--text);white-space:nowrap;}
.fcard .fb span{font-size:9px;color:var(--muted);}
.fcard .fcagr{margin-top:9px;font-size:11px;color:var(--muted);}
.fcard .fcagr b{color:var(--text);}
.mrow{display:flex;align-items:center;gap:10px;padding:5px 0;font-size:12px;}
.mrow .mk{color:var(--muted);flex:0 0 130px;}
.mrow .mtr{flex:1;height:5px;border-radius:3px;background:var(--line);overflow:hidden;}
.mrow .mtr i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,color-mix(in srgb,var(--link) 50%,transparent),var(--link));}
.mrow .mv{width:52px;text-align:right;font-weight:650;font-size:12px;}
.hchips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;}
.pio{display:inline-flex;align-items:center;gap:2.5px;padding:5px 10px;border-radius:9px;background:var(--gbtn-bg);border:1px solid var(--gbtn-brd);}
.pio b{font-size:11px;margin-right:5px;}
.pio i{width:9px;height:5px;border-radius:1.5px;background:var(--line);}
.pio i.on6{background:var(--up);}
.kv2{display:grid;grid-template-columns:1fr 1fr;gap:4px 26px;margin-top:14px;}
.kv2 .r6{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:6px 0;border-bottom:1px solid var(--hair);font-size:12.5px;}
.kv2 .k6{color:var(--muted);}
.kv2 .v6{font-weight:650;text-align:right;}
.kv2 h4{grid-column:1/-1;margin:6px 0 2px;font-size:11px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;}

/* why moving */
.why .wr{display:flex;gap:12px;align-items:flex-start;padding:8px 10px;border-radius:11px;font-size:12.5px;margin:2px -10px;}
.why .wr.wr-on{background:color-mix(in srgb,var(--up) 6%,transparent);}
.why .wd{width:8px;height:8px;border-radius:50%;background:var(--line);flex-shrink:0;margin-top:5px;}
.why .wr.wr-on .wd{background:var(--up);box-shadow:0 0 8px color-mix(in srgb,var(--up) 55%,transparent);}
.why .wc{flex:0 0 90px;color:var(--muted);font-size:11.5px;padding-top:1px;}
.why .wl{flex:1;line-height:1.5;min-width:200px;}

/* options tiles */
.otiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.otile{background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--hair);border-radius:12px;padding:11px 13px;min-width:0;}
.otile .ok6{font-size:10.5px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.otile .ov{font-size:16.5px;font-weight:720;margin-top:4px;}
.otile .ob{position:relative;height:4px;border-radius:3px;background:var(--line);margin-top:8px;overflow:hidden;}
.otile .ob i{position:absolute;top:0;bottom:0;left:0;background:linear-gradient(90deg,color-mix(in srgb,var(--warn) 50%,transparent),var(--warn));border-radius:3px;}

/* holders */
.gchip{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:7px;font-size:11px;font-weight:800;background:var(--panel2);color:var(--muted);}
.gchip.A{background:color-mix(in srgb,var(--up) 16%,transparent);color:var(--up);}
.gchip.B{background:color-mix(in srgb,var(--warn) 16%,transparent);color:var(--warn);}

/* timeline */
.tl{position:relative;padding-left:20px;}
.tl::before{content:"";position:absolute;left:5px;top:8px;bottom:8px;width:2px;background:var(--hair);}
.tev{position:relative;padding:7px 0 7px 6px;}
.tev::before{content:"";position:absolute;left:-19px;top:13px;width:8px;height:8px;border-radius:50%;background:var(--muted);box-shadow:0 0 0 3px var(--panel);}
.tev.up::before{background:var(--up);}
.tev.down::before{background:var(--down);}
.tev.caution::before{background:var(--warn);}
.tev .td{font-size:11px;color:var(--muted);font-weight:600;}
.tev .th{font-size:12.5px;font-weight:600;margin-top:1px;}
.tev .tx{font-size:11.5px;color:var(--muted);margin-top:1px;line-height:1.45;}
.pinned6{background:color-mix(in srgb,var(--warn) 7%,transparent);border:1px solid color-mix(in srgb,var(--warn) 26%,transparent);
  border-radius:12px;padding:11px 14px;margin-bottom:12px;font-size:12.5px;}
.pinned6 .ph{display:block;font-weight:700;}
.pinned6 .pd{color:var(--muted);font-size:11.5px;}

/* style DNA + watch items */
.dna .dr{display:flex;align-items:center;gap:12px;padding:6px 0;font-size:12.5px;}
.dna .dk{flex:0 0 118px;color:var(--muted);}
.dna .dtr{position:relative;flex:1;height:6px;border-radius:4px;background:var(--line);}
.dna .dtr::before{content:"";position:absolute;left:50%;top:-3px;bottom:-3px;width:1.5px;background:color-mix(in srgb,var(--muted) 45%,transparent);}
.dna .dtr i{position:absolute;top:0;bottom:0;border-radius:4px;}
.dna .dtr i.p{left:50%;background:linear-gradient(90deg,color-mix(in srgb,var(--up) 45%,transparent),var(--up));}
.dna .dtr i.n{right:50%;background:linear-gradient(270deg,color-mix(in srgb,var(--down) 45%,transparent),var(--down));}
.dna .dw{flex:0 0 96px;text-align:right;font-size:11.5px;font-weight:650;}
.watch{list-style:none;padding:0;margin:8px 0 0;}
.watch li{margin:5px 0;font-size:12.5px;color:var(--muted);line-height:1.5;padding-left:18px;position:relative;}
.watch li::before{content:"⚠";position:absolute;left:0;font-size:11px;color:var(--warn);}
.subhd{font-size:11px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin:14px 0 6px;}

/* seasonality */
.seas{display:grid;grid-template-columns:repeat(6,1fr);gap:5px;}
.seas .sc{aspect-ratio:1.25/1;border-radius:9px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
  background:var(--panel2);font-size:11px;font-weight:700;}
.seas .sc span{font-size:9px;font-weight:600;color:var(--muted);}
.seas .sc.cur{outline:2px solid var(--link);outline-offset:1px;}

/* news / themes / peers */
.nrow{padding:9px 0;border-bottom:1px solid var(--hair);font-size:12.5px;line-height:1.45;}
.nrow:last-child{border-bottom:0;}
.nrow a{font-weight:550;}
.nrow a:hover{color:var(--link);}
.nrow .nm{display:block;font-size:11px;color:var(--muted);margin-top:2px;}
.throw{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--hair);font-size:12.5px;flex-wrap:wrap;}
.throw:last-child{border-bottom:0;}
.throw a{font-weight:650;color:var(--link);}
.throw a:hover{text-decoration:underline;}
.throw .tm{flex:1;color:var(--muted);font-size:11.5px;min-width:120px;}
.peers{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;}
.pcard{background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--hair);border-radius:12px;padding:10px 12px;min-width:0;
  transition:transform .16s,border-color .16s,background .16s;}
.pcard:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--link) 40%,var(--hair));background:color-mix(in srgb,var(--panel2) 80%,transparent);}
.pcard b{font-size:13.5px;font-weight:750;color:var(--link);}
.pcard span{display:block;font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.pcard small{display:block;font-size:10.5px;color:var(--muted);margin-top:3px;}

/* rail CTA + band */
.railcta{background:linear-gradient(150deg,color-mix(in srgb,var(--link) 14%,var(--panel)),color-mix(in srgb,var(--info) 7%,var(--panel)));
  border:1px solid color-mix(in srgb,var(--link) 30%,transparent);}
.railcta h3{margin:0 0 6px;font-size:14.5px;font-weight:750;}
.railcta p{margin:0 0 14px;font-size:12px;color:var(--muted);line-height:1.55;}
.cta-band{margin-top:26px;padding:30px 34px;display:flex;align-items:center;gap:26px;flex-wrap:wrap;
  background:linear-gradient(120deg,color-mix(in srgb,var(--link) 12%,var(--panel)) 0%,var(--glass-bg) 60%);
  border:1px solid color-mix(in srgb,var(--link) 26%,var(--glass-brd));}
.cta-band .cc{flex:1;min-width:250px;}
.cta-band h2{margin:0 0 6px;font-size:19px;font-weight:800;letter-spacing:-.02em;}
.cta-band p{margin:0;font-size:12.5px;color:var(--muted);line-height:1.55;}
.brief-list{margin:4px 0 0;padding-left:18px;}
.brief-list li{margin:3px 0;font-size:12.5px;line-height:1.5;}

/* footer */
.site-footer6{margin-top:34px;padding-top:18px;border-top:1px solid var(--hair);color:var(--muted);font-size:11.5px;line-height:1.7;}
.site-footer6 a{color:var(--link);}
.site-footer6 a:hover{text-decoration:underline;}


/* ── popup dashboards (dsr-dlg — macro.html mx5 mechanics) ── */
html.dsr-dlg-lock{overflow:hidden;}
html.dsr-dlg-lock .strip{visibility:hidden;}
html.dsr-dlg-lock body{overflow:hidden;position:fixed;width:100%;}
.dsr-dlg{display:none;position:fixed;inset:0;z-index:300;align-items:center;justify-content:center;}
.dsr-dlg.open{display:flex;}
.dsr-dlg-backdrop{position:absolute;inset:0;background:rgba(3,6,10,.58);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);}
.dsr-dlg-panel{position:relative;z-index:1;max-width:880px;width:calc(100% - 48px);max-height:84vh;
  background:color-mix(in srgb,var(--panel) 94%,transparent);border:1px solid var(--glass-brd);border-radius:var(--v6-radius);
  backdrop-filter:blur(28px) saturate(1.4);-webkit-backdrop-filter:blur(28px) saturate(1.4);
  box-shadow:0 40px 120px rgba(0,0,0,.72),0 2px 0 rgba(255,255,255,.06) inset;overflow-y:auto;display:flex;flex-direction:column;}
.dsr-dlg-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 22px 13px;position:sticky;top:0;z-index:2;
  background:color-mix(in srgb,var(--panel) 96%,transparent);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--hair);}
.dsr-dlg-title{font-size:15px;font-weight:700;letter-spacing:-.01em;display:flex;align-items:center;gap:10px;}
.dsr-dlg-title::before{content:"";width:3px;height:15px;border-radius:2px;background:linear-gradient(180deg,var(--stance),color-mix(in srgb,var(--stance) 25%,transparent));}
.dsr-dlg-close{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;
  background:var(--gbtn-bg);border:1px solid var(--gbtn-brd);cursor:pointer;color:var(--muted);font-size:17px;line-height:1;font-family:inherit;flex-shrink:0;transition:background .15s,color .15s;}
.dsr-dlg-close:hover{background:var(--gbtn-bg-hover);color:var(--text);}
.dsr-dlg-body{padding:18px 22px 24px;flex:1;overflow-y:auto;overflow-x:hidden;}
.dpanel{margin:0 0 20px;}
.dpanel:last-child{margin-bottom:0;}
.dpanel h3{margin:0 0 10px;font-size:12px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;}
.dpanel .dfoot{margin-top:8px;font-size:11.5px;color:var(--muted);line-height:1.5;}
.dcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;}
.dcard{background:color-mix(in srgb,var(--panel2) 55%,transparent);border:1px solid var(--hair);border-radius:12px;padding:11px 13px;}
.dcard .dk{font-size:10.5px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;}
.dcard .dv{font-size:16px;font-weight:750;margin-top:4px;}
.dkv .r6d{display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:7px 0;border-bottom:1px solid var(--hair);font-size:12.5px;}
.dkv .r6d:last-child{border-bottom:0;}
.dkv .r6d .k{color:var(--muted);}
.dkv .r6d .vv{font-weight:650;text-align:right;}
.dtable{width:100%;border-collapse:collapse;font-size:12.5px;}
.dtable th{font-size:10.5px;font-weight:650;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;text-align:right;padding:2px 8px 7px;border-bottom:1px solid var(--hair);white-space:nowrap;}
.dtable th:first-child{text-align:left;}
.dtable td{padding:7px 8px;border-bottom:1px solid var(--hair);text-align:right;font-variant-numeric:tabular-nums;}
.dtable td:first-child{text-align:left;color:var(--muted);}
.dtable tr:last-child td{border-bottom:0;}
.dtable-wrap{overflow-x:auto;margin:0 -4px;padding:0 4px;}
.dnotes{list-style:none;margin:0;padding:0;}
.dnotes li{font-size:12.5px;line-height:1.55;padding:5px 0 5px 16px;position:relative;}
.dnotes li::before{content:"·";position:absolute;left:2px;font-weight:900;}
@media(prefers-reduced-motion:no-preference){
  .dsr-dlg-backdrop{opacity:0;transition:opacity 240ms ease-out;}
  .dsr-dlg.dsr-in .dsr-dlg-backdrop{opacity:1;}
  .dsr-dlg-panel{opacity:0;transform:translateY(14px) scale(.965);transition:opacity 320ms cubic-bezier(.22,.9,.26,1.02),transform 320ms cubic-bezier(.22,.9,.26,1.02);}
  .dsr-dlg.dsr-in .dsr-dlg-panel{opacity:1;transform:translateY(0) scale(1);}
  .dsr-dlg.dsr-closing .dsr-dlg-backdrop,.dsr-dlg.dsr-closing .dsr-dlg-panel{transition-duration:180ms;}
  .dsr-dlg-body > .dpanel{opacity:0;transform:translateY(10px);transition:opacity 300ms ease-out,transform 300ms cubic-bezier(.22,.9,.26,1.02);}
  .dsr-dlg.dsr-in .dsr-dlg-body > .dpanel{opacity:1;transform:translateY(0);}
  .dsr-dlg.dsr-in .dsr-dlg-body > .dpanel:nth-child(1){transition-delay:60ms;}
  .dsr-dlg.dsr-in .dsr-dlg-body > .dpanel:nth-child(2){transition-delay:100ms;}
  .dsr-dlg.dsr-in .dsr-dlg-body > .dpanel:nth-child(n+3){transition-delay:140ms;}
  .dsr-closing .dsr-dlg-body > .dpanel{transition-delay:0ms!important;}
}
@media(max-width:700px){
  .dsr-dlg{align-items:flex-end;}
  .dsr-dlg-panel{width:calc(100% - 20px);max-width:none;max-height:88vh;border-radius:var(--v6-radius) var(--v6-radius) 0 0;margin:0 10px;}
  .dsr-dlg-close{width:42px;height:42px;font-size:21px;}
  .dsr-dlg-body{padding:15px 15px 24px;}
}

/* ── responsive (media queries AFTER base rules, always) ── */
@media(max-width:980px){.cols{grid-template-columns:1fr;}}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr;gap:12px;}.px-block{text-align:left;}}
@media(max-width:760px){.chart-mod .mod-hd{flex-wrap:wrap;}}
@media(max-width:640px){
  .page-wrap{padding:0 14px 44px;}
  .mod{padding:16px 15px 17px;border-radius:15px;}
  .hero{padding:20px 18px 0;}
  .stance-row{margin:18px -18px 0;padding:12px 18px;}
  .chart-mod .mod-hd{padding:13px 15px 10px;}
  .chart-ft{padding:9px 15px 12px;}
  .fin3{grid-template-columns:1fr;}
  .earn-top{grid-template-columns:1fr;}
  .kv2{grid-template-columns:1fr;}
  .otiles{grid-template-columns:repeat(2,1fr);}
}
</style>
</head>
<body class="st-{{ (hero.stance_class if hero and hero.stance_class else 'neu') }}">
<div class="aurora" aria-hidden="true"></div>
{% include "_site_nav.html.j2" %}
<main>

<!-- sticky jump strip (revealed after the hero scrolls past) -->
<div class="strip" id="v6strip" aria-hidden="true">
  <span class="stk">{{ ticker }}</span>
  <span class="sname mut sm">{{ name }}</span>
  {% if hero and hero.price %}<span class="stp num">$<span class="nb-px" data-sym="{{ ticker }}" data-mkt="us">{{ hero.price }}</span></span>{% endif %}
  {% if hero %}<span class="schip">{{ t(hero.stance_en, hero.stance_zh) }}</span>{% endif %}
  <nav id="v6jumps">
    <a href="#chart">{{ t('Chart', '图表') }}</a>
    {% if ladder %}<a href="#levels">{{ t('Levels', '点位') }}</a>{% endif %}
    {% if technicals %}<a href="#technicals">{{ t('Technicals', '技术面') }}</a>{% endif %}
    {% if earnings %}<a href="#earnings">{{ t('Earnings', '财报') }}</a>{% endif %}
    {% if valuation %}<a href="#valuation">{{ t('Valuation', '估值') }}</a>{% endif %}
    {% if financials %}<a href="#financials">{{ t('Financials', '财务') }}</a>{% endif %}
    {% if options %}<a href="#options">{{ t('Options', '期权') }}</a>{% endif %}
    {% if ownership %}<a href="#ownership">{{ t('Holders', '持仓') }}</a>{% endif %}
    {% if news %}<a href="#news">{{ t('News', '新闻') }}</a>{% endif %}
  </nav>
  <a class="gbtn gbtn-sm" href="{{ terminal_url }}" rel="noopener noreferrer" target="_blank">{{ t('Terminal', '终端') }} ↗</a>
</div>

<div class="page-wrap">
{% set deep_ids = [] %}
{% if deep %}{% for d in deep.dialogs %}{% set _ = deep_ids.append(d.id) %}{% endfor %}{% endif %}

<p class="crumb">
  <a href="index.html">{{ t('Stocks', '股票') }}</a> <span class="mut">/</span>
  {% if hero and hero.sector %}<span class="mut">{{ hero.sector }}</span> <span class="mut">/</span>{% endif %}
  <b>{{ ticker }}</b>
</p>

<!-- ═ HERO ═ -->
<header class="mod hero" id="top">
  <div class="hero-grid">
    <div>
      <div class="eyebrow hi">{{ name }}{% if hero and hero.sector %} · {{ hero.sector }}{% endif %}</div>
      <h1 class="hi hi2"><a href="{{ terminal_url }}" rel="noopener noreferrer" target="_blank">{{ ticker }}</a>
        <span class="co">{{ t('US listed · USD', '美股 · 美元') }}</span></h1>
      {% if hero and hero.desc_en %}
      <p class="hero-desc hi hi3">{{ t(hero.desc_en, hero.desc_zh) }}</p>
      {% endif %}
      {% if hero %}
      <div class="chips hi hi3">
        {% if stats and stats.mktcap %}<span class="chip6">{{ t(hero.mktcap_label_en or 'Market cap', hero.mktcap_label_zh or '市值') }} · {{ stats.mktcap }}</span>
        {% elif hero.mktcap_label_en %}<span class="chip6">{{ t(hero.mktcap_label_en, hero.mktcap_label_zh) }}</span>{% endif %}
        {% if hero.arch_label_en %}<span class="chip6">{{ t(hero.arch_label_en, hero.arch_label_zh) }}</span>{% endif %}
        {% if hero.sector %}<span class="chip6">{{ hero.sector }}</span>{% endif %}
      </div>
      {% endif %}
    </div>
    <div class="px-block hi hi2">
      <div class="px-big num">
        {%- if hero and hero.price -%}
        $<span class="nb-px" data-sym="{{ ticker }}" data-mkt="us">{{ hero.price }}</span>
        {%- else -%}—{%- endif -%}
      </div>
      {% if hero and hero.chg %}
      <div class="px-chg {{ 'pos' if hero.chg.pos else 'neg' }}">
        <span class="pill6 num">{{ hero.chg.abs }} · {{ hero.chg.pct }}</span>
        {% if not stale %}<span class="live-dot"></span>{% endif %}
      </div>
      {% elif not stale %}
      <div class="px-chg pos"><span class="live-dot"></span></div>
      {% endif %}
      {% if hero and hero.range52 %}
      <div class="wk52">
        <div class="lbls"><span>{{ t('52w low', '52周低') }} <b class="num">{{ hero.range52.lo }}</b></span><span>{{ t('high', '高') }} <b class="num">{{ hero.range52.hi }}</b></span></div>
        <div class="track"><div class="fill" style="width:{{ hero.range52.pos_pct }}%;"></div><div class="dotp" style="left:{{ hero.range52.pos_pct }}%;"></div></div>
      </div>
      {% endif %}
    </div>
  </div>
  {% if hero %}
  <div class="stance-row hi hi4">
    <span class="stance-big">{{ t(hero.stance_en, hero.stance_zh) }}</span>
    {% if hero.inv_en %}
    <span class="stance-line"><span class="l-en">{{ hero.inv_en }}</span><span class="l-zh">{{ hero.inv_zh }}</span></span>
    {% endif %}
    <span class="asof">{{ t('Engine read', '引擎解读') }} · {{ freshness }}{% if stale %} · <span class="wrn">{{ t('may be stale', '可能过期') }}</span>{% endif %}</span>
  </div>
  {% endif %}
</header>

<!-- ═ CHART — full content width; Mastermind Terminal embed ═ -->
<section class="mod chart-mod rv" id="chart">
  <div class="mod-hd">
    <h2>{{ t('Price chart', '价格图表') }}</h2>
    <div class="hint">
      <span>{{ t('daily · interactive', '日线 · 可交互') }}</span>
      <a class="gbtn gbtn-sm" href="{{ terminal_url }}" rel="noopener noreferrer" target="_blank">{{ t('Open in Terminal', '打开终端') }} ↗</a>
    </div>
  </div>
  <div class="chart-frame" id="chart-frame">
    <div class="chart-skel">{{ t('Loading chart…', '图表加载中…') }}</div>
    <iframe id="chart-embed" title="{{ ticker }} interactive price chart"
      loading="eager" allowtransparency="true" referrerpolicy="strict-origin-when-cross-origin"
      data-embed="https://app.mastermind-x.com/embed/chart?symbol={{ ticker }}&transparent=1&range=1Y"></iframe>
    <div class="chart-fallback">
      <span>{{ t('The interactive chart could not load here.', '互动图表暂时无法在此加载。') }}</span>
      <a class="gbtn" href="{{ terminal_url }}" rel="noopener noreferrer" target="_blank">{{ t('Open the live chart in Terminal', '在终端中打开实时图表') }} ↗</a>
    </div>
    <noscript><div class="chart-fallback" style="display:flex;position:static;height:100%;">
      <a class="gbtn" href="{{ terminal_url }}" rel="noopener noreferrer" target="_blank">{{ t('Open the live chart in Terminal', '在终端中打开实时图表') }} ↗</a>
    </div></noscript>
  </div>
  <div class="chart-ft">
    <span class="sm mut">{{ t('Candles, volume and moving averages — pan and zoom inside the chart.', '蜡烛图、成交量与均线 — 图内可缩放拖动。') }}</span>
    <a class="powered" href="{{ terminal_url }}" rel="noopener noreferrer" target="_blank"><span class="bolt">M</span>{{ t('Mastermind Terminal — live & interactive', 'Mastermind 终端 — 实时互动') }} ↗</a>
  </div>
</section>

<!-- ═ MAIN + RAIL (rail begins under the chart) ═ -->
<div class="cols">
  <div class="main-col">

  {% if technicals %}
  <section class="mod rv" id="technicals">
    <div class="mod-hd"><h2>{{ t('Technicals', '技术面') }}</h2><span class="hint">{{ t('daily bars', '日线数据') }} · {{ freshness }} {% if 'technicals' in deep_ids %}<button class="gbtn gbtn-sm" onclick="dsrOpenDlg('dlg-technicals')">{{ t('Full detail', '完整数据') }}</button>{% endif %}</span></div>
    {% if technicals.active_signals %}
    {%- set shortsigs = [] -%}
    {%- for sig in technicals.active_signals -%}
      {%- if sig|length <= 42 and shortsigs|length < 4 -%}{%- set _ = shortsigs.append(sig) -%}{%- endif -%}
    {%- endfor -%}
    {% if shortsigs %}<div class="sigchips">{% for sig in shortsigs %}<span class="okx q">{{ sig }}</span>{% endfor %}</div>{% endif %}
    {% endif %}
    {% if technicals.rsi %}
    {%- set rsiv = technicals.rsi|float(50) -%}
    <div class="trow">
      <span class="tk">{{ t('Momentum (RSI 14)', '动量（RSI 14）') }}</span>
      <span class="tv6 num">{{ technicals.rsi }}</span>
      <div class="minitrack"><div class="zone"></div><div class="mk" style="left:{{ '%.0f'|format([[rsiv, 100]|min, 0]|max) }}%;"></div></div>
      {% if technicals.rsi_zone_en %}<span class="okx {{ 'n' if technicals.rsi_zone_en == 'Overbought' else ('y' if technicals.rsi_zone_en == 'Oversold' else 'q') }}">{{ t(technicals.rsi_zone_en, technicals.rsi_zone_zh) }}</span>{% endif %}
    </div>
    {% endif %}
    {% if technicals.ma50_en %}
