<div class="panel">
  <div class="kpis">
    <div><div class="k">{{ t('Leader', '领跑') }}</div><div class="v">{{ t(R.leader.name, R.leader.name_zh) if R.leader.name else '—' }}</div></div>
    <div><div class="k">{{ t('Challenger', '挑战者') }}</div><div class="v" style="font-size:15px;color:var(--muted)">{{ t(R.challenger.name, R.challenger.name_zh) if R.challenger.name else '—' }}</div></div>
    <div><div class="k">{{ t('Lead margin', '领先优势') }}</div><div class="v">{{ R.margin if R.margin is not none else '—' }}</div></div>
    <div><div class="k">{{ t('Breadth of rotation', '轮动广度') }}</div><div class="v">{{ R.breadth_of_rotation.eligible }}/{{ R.breadth_of_rotation.total }}
      <span class="chip" style="vertical-align:middle">{{ t(R.breadth_of_rotation.view, {'broad':'广泛','narrowing':'收窄','narrow':'狭窄'}.get(R.breadth_of_rotation.view, R.breadth_of_rotation.view)) }}</span></div></div>
  </div>
  <p class="tagline">{{ t(
	    'Broad leadership is healthier. Narrow leadership raises the cash dial.',
	    '领跑越广越健康；领跑越窄，现金刻度越高。') }}</p>
</div>

<!-- ============ 04 THE WORKHORSE BACKTEST (honest) ============ -->
{% set B = d.backtest %}
{% if B.sectors %}
<h2><span class="idx">04</span>{{ t('What is actually validated — sector backtest', '真正验证过的 — 行业回测') }}</h2>
<p class="sub">{{ t(
	  'Theme baskets are short. The algorithm is tested on long sector history below.',
	  '主题篮子历史较短。算法在下方长期行业历史上检验。') }}
  <span class="muted">({{ B.sectors.span[0] }} → {{ B.sectors.span[1] }})</span></p>

{% if B.gate_helps == False %}
<div class="banner crash">⚠ <b>{{ t('Experimental in this market', '本市场属实验性') }}</b> — {{ t(
	  'local history did not prove the trend gate. Treat this allocation as experimental.',
	  '本地历史未证明趋势门有效。请将此配置视为实验性。') }}</div>
{% endif %}
{% if B.borrowed_from %}
<div class="banner dom">ℹ {{ t(
	  d.market_en + ' local history is thin, so the table uses proxy history (' + B.borrowed_from + '). Read as a prior, not local proof.',
	  d.market_zh + '本地历史较薄，所以下表使用代理历史（' + B.borrowed_from + '）。这是先验，不是本地证明。') }}</div>
{% endif %}
<div class="panel">
  <div class="ts"><table>
    <thead><tr><th>{{ t('Strategy', '策略') }}</th><th class="num">CAGR</th><th class="num">Sharpe</th><th class="num">{{ t('Max DD', '最大回撤') }}</th><th class="num" title="avg return in the worst-decile down months">{{ t('Crash months', '崩盘月') }}</th><th class="num" title="deflated Sharpe — survives multiple testing if >=0.90">DSR</th></tr></thead>
    <tbody>
    {% for key, lab, labzh in [('dual','Dual-momentum book (this engine)','双动量组合（本引擎）'),('rel','Relative-momentum only','仅相对动量'),('buyhold','Equal-weight buy & hold','等权买入持有')] %}
    {% set s = B.sectors[key] %}{% if s %}
    <tr{% if key=='dual' %} style="background:rgba(90,167,255,.07)"{% endif %}>
      <td>{% if key=='dual' %}<b>{{ t(lab, labzh) }}</b>{% else %}{{ t(lab, labzh) }}{% endif %}</td>
      <td class="num">{{ (s.cagr*100)|round(1) }}%</td>
      <td class="num">{{ s.sharpe }}</td>
      <td class="num neg">{{ (s.max_dd*100)|round(1) }}%</td>
      <td class="num neg">{{ (s.worst_decile_ret*100)|round(1) if s.worst_decile_ret is not none else '—' }}%</td>
      <td class="num">{% if s.dsr is not none %}<b class="{{ 'pos' if s.dsr>=0.9 else 'muted' }}">{{ s.dsr }}</b>{% else %}—{% endif %}</td>
    </tr>
    {% endif %}{% endfor %}
    </tbody>
  </table></div>
  {% if B.sectors.tsmom %}
  <p class="tagline" style="margin-top:10px"><b>{{ t('The validated edge is risk control, not alpha.', '验证过的优势是风险控制，而非阿尔法。') }}</b>
    {{ t('Above vs below the trend gate, forward return is statistically identical, but Sharpe is', '在趋势门上方 vs 下方，前瞻收益在统计上一致，但夏普为') }}
    <b>{{ B.sectors.tsmom.above_trend.sharpe }}</b> {{ t('vs', '对') }} <b>{{ B.sectors.tsmom.below_trend.sharpe }}</b>
    {{ t('and the bad-month tail is', '且坏月尾部为') }} <b>{{ (B.sectors.tsmom.above_trend.p05*100)|round(1) }}%</b> {{ t('vs', '对') }} <b>{{ (B.sectors.tsmom.below_trend.p05*100)|round(1) }}%</b>.
	    {{ t('Rank shows where to look; trend decides whether to be in.', '排名说明看哪里；趋势决定是否在场。') }}</p>
  {% endif %}
  {% if B.verdict %}
  <div class="verdict">
    {% for k, lab, labzh in [('relative_momentum','Momentum rank','动量排名'),('absolute_trend_gate','Trend gate','趋势门'),('basket_extension','Basket crowding','篮子拥挤'),('rotation_timing','Rotation timing','轮动择时')] %}
    {% if B.verdict[k] %}<div class="vcard"><b>{{ t(lab, labzh) }}</b><br><span class="muted">{{ B.verdict[k] }}</span></div>{% endif %}
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}

