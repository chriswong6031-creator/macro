<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro pct(x, plus=True) -%}{% if x is none %}—{% else %}{{ ('+' if plus and x>=0 else '') }}{{ (x*100)|round(1) }}%{% endif %}{%- endmacro %}
{% macro zfmt(x) -%}{% if x is none %}—{% else %}{{ ('+' if x>=0 else '') }}{{ x|round(2) }}σ{% endif %}{%- endmacro %}
