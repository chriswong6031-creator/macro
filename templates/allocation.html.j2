<!-- live desk: falsifiable per-theme leans (fetched client-side; degrades to the contract above) -->
<div id="thematic-desk" data-region="{{ d.region }}" style="margin-top:12px">
  <div class="story" style="margin:6px 0 2px">{{ t('Desk read — falsifiable hypotheses, graded over time', '桌面解读 — 可证伪假设，长期被打分') }}
    <span class="chip">{{ t('display-only', '仅展示') }}</span><span id="td-track" class="chip" style="display:none"></span></div>
  <p class="tagline" style="margin-top:0">{{ t(
	    "Desk leans are dated hypotheses, not a buy list or sizing rule.",
	    '桌面倾向是带日期的假设，不是买入清单或仓位规则。') }}</p>
  <p id="td-backdrop" class="tagline" style="display:none;margin-top:2px"></p>
  <p id="td-regime" class="story" style="display:none;font-size:13.5px"></p>
  <div id="td-cards" class="cards-td"></div>
  <p id="td-watch" class="tagline" style="display:none;margin-top:8px"></p>
  <details id="td-panel-wrap" style="display:none;margin-top:6px">
    <summary class="muted" style="font-size:12px;cursor:pointer">{{ t('What the analysts argued (adversarial panel)', '分析师论点（对抗式专家组）') }}</summary>
    <div id="td-panel"></div>
  </details>
  <p id="td-empty" class="tagline" style="display:none">{{ t(
	    'Live desk note is not generated yet. The guardrails above still apply.',
	    '实时桌面简报尚未生成。上方约束仍然适用。') }}</p>
</div>

{% if d.region == 'us' %}
<!-- theme-discovery radar (US): coherent NEW name-groups not yet in a basket — for review -->
<h2><span class="idx">06</span>{{ t('Candidate themes — discovery radar', '候选主题 — 发现雷达') }}
  <span class="chip">{{ t('display-only · for human review', '仅展示 · 供人工审阅') }}</span></h2>
<p class="sub">{{ t(
	  'New clusters for human review. Watchlist context only, never a buy list.',
	  '供人工审阅的新聚类。仅作观察背景，绝非买入清单。') }}</p>
<div class="panel"><div id="td-candidates" class="muted sm">{{ t('Loading…', '加载中…') }}</div></div>
{% endif %}

<footer>
  {{ t('Generated', '生成于') }} {{ generated_utc }}<br>
  <span class="made">© 2026 MastermindX Inc</span>
</footer>
<script>
// ---- PR2 strategic playbook: buy/sell entries · risk over time · rotation alerts ----
const ALLOC = {{ data_json|safe }};
const ROT_ALERTS = {{ rotation_alerts_json|safe }};
const RISK_HIST = {{ risk_history_json|safe }};
const ACT_NOW = {{ act_now_json|safe }};
const STANDOUTS = {{ standouts_json|default('{}')|safe }};   // theme id -> # members on the US standout buy board
const L = (en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`;
// ★N badge: how many individual standouts back this theme (the allocation→stock bridge)
const sbBadge = id => { const n=STANDOUTS[id]; return n?` <span class="sb-badge" title="${n} member(s) on the US standout buy board">★${n}</span>`:''; };
const esc = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const bid = s => /^[a-z0-9_-]+$/i.test(s||'') ? s : '';

function renderEntries(){
  const el=document.getElementById('playbook-entries'); if(!el) return;
  const alloc=ALLOC.allocation||{}, an=ACT_NOW||null;
  const held=new Set((alloc.weights||[]).map(w=>w.id));
  // BUY/HOLD: the de-overlapped trending book + (US) clean-entry buys not already held
  let buy=(alloc.weights||[]).map(w=>`<a class="prow" href="basket/${bid(w.id)}.html">
    <span class="pverb" style="color:var(--up);border-color:var(--up)">${L('HOLD / ADD','持有/加仓')}</span>
    <span class="pn">#${w.rank} ${L(esc(w.name),esc(w.name_zh))}${sbBadge(w.id)}</span><span class="pw">${Math.round((w.weight||0)*100)}%</span></a>`);
  if(an && an.buy){ an.buy.filter(x=>!held.has(x.id)).forEach(x=>{
    const v=x.action==='enter'?['ENTER','建仓']:['ACCUMULATE','加仓'];
    buy.push(`<a class="prow" href="basket/${bid(x.id)}.html"><span class="pverb" style="color:#16a34a;border-color:#16a34a">${L(v[0],v[1])}</span>
      <span class="pn">${L(esc(x.name),esc(x.name_zh))}${sbBadge(x.id)}</span><span class="pw">${x.score}</span></a>`); }); }
  // in-favour themes WITHOUT a clean entry (the honest act_now split) — shown, never hidden,
  // with a muted "wait for a pullback" verb. Descriptive presentation, not a signal.
  if(an && an.add_on_pullback){ an.add_on_pullback.filter(x=>!held.has(x.id)).forEach(x=>{
    buy.push(`<a class="prow" href="basket/${bid(x.id)}.html" title="${esc(x.reason_en||'in favour, but no clean-entry setup right now')}"><span class="pverb" style="color:var(--warn);border-color:var(--warn)">${L('WAIT — PULLBACK','等待回调')}</span>
      <span class="pn">${L(esc(x.name),esc(x.name_zh))}${sbBadge(x.id)}</span><span class="pw">${x.score}</span></a>`); }); }
  // REDUCE/AVOID: (US) act_now reduce + crowded held + de-overlapped displaced (context)
  let sell=[];
  if(an && an.reduce){ an.reduce.forEach(x=>{ const v=x.action==='avoid'?['AVOID','回避','#ef4444']:['TRIM','减仓','#f97316'];
    sell.push(`<a class="prow" href="basket/${bid(x.id)}.html"><span class="pverb" style="color:${v[2]};border-color:${v[2]}">${L(v[0],v[1])}</span>
      <span class="pn">${L(esc(x.name),esc(x.name_zh))}</span><span class="pw">${x.score}</span></a>`); }); }
  (alloc.weights||[]).filter(w=>w.crowded).forEach(w=>sell.push(`<div class="prow"><span class="pverb" style="color:var(--warn);border-color:var(--warn)">${L('SIZE DOWN','降仓')}</span><span class="pn">${L(esc(w.name),esc(w.name_zh))}</span><span class="pw">${L('crowded','拥挤')}</span></div>`));
  if(!sell.length) sell.push(`<div class="muted" style="padding:10px 2px;font-size:12px">${L('Nothing flagged to reduce right now.','当前无需减仓的标的。')}</div>`);
  const moreBtn=n=>n>5?`<button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">${L('Show more','显示更多')} ▾</span><span class="lm-hide">${L('Show less','收起')} ▴</span></button>`:'';
  const pCol=(cls,head,arr,empty)=>`<div class="pcol lst-wrap"><h4 class="${cls}">${head} <span class="muted" style="font-size:11px">(${arr.length})</span></h4>${arr.length?`<div class="plist lst-collapse is-collapsed">${arr.join('')}</div>${moreBtn(arr.length)}`:empty}</div>`;
  el.innerHTML=pCol('buy',`✅ ${L('Add / hold now','现在加仓 / 持有')}`,buy,'<div class="muted" style="padding:10px 2px;font-size:12px">'+L('No themes above trend — sit in cash.','无主题处于趋势上方 — 持有现金。')+'</div>')
    +pCol('sell',`🔻 ${L('Reduce / avoid','减仓 / 回避')}`,sell,'');
}

function renderRiskTime(){
  const el=document.getElementById('risk-time'); if(!el) return;
  const alloc=ALLOC.allocation||{}, cash=alloc.cash, crash=(alloc.crash_overlay||{}).active;
  const pts=(RISK_HIST||[]).map(h=>h.cash).filter(v=>v!=null);
  let spark=`<span class="muted" style="font-size:12px">${L('history accruing','历史累积中')}</span>`;
  if(pts.length>=2){ const w=320,hh=46,mn=Math.min(...pts),mx=Math.max(...pts),sp=(mx-mn)||1;
    const d=pts.map((v,i)=>`${i?'L':'M'}${(i/(pts.length-1)*w).toFixed(1)} ${(hh-3-(v-mn)/sp*(hh-7)).toFixed(1)}`).join(' ');
    spark=`<svg width="${w}" height="${hh}" viewBox="0 0 ${w} ${hh}"><path d="${d}" fill="none" stroke="${cssv('--muted')}" stroke-width="1.6"/></svg>`; }
  const posture = cash==null?['—','—',cssv('--muted')] : crash?['DE-RISKED','已去风险',cssv('--down')] : cash>=0.5?['DEFENSIVE','防守',cssv('--warn')] : cash>=0.25?['BALANCED','均衡',cssv('--text')] : ['RISK-ON','进攻',cssv('--up')];
  el.innerHTML=`<div style="display:flex;align-items:center;gap:22px;flex-wrap:wrap">
    <div><div class="riskbig" style="color:${posture[2]}">${cash==null?'—':Math.round(cash*100)+'%'}</div><div class="muted" style="font-size:11px">${L('suggested cash','建议现金')}</div></div>
    <div><div style="font-size:16px;font-weight:700;color:${posture[2]}">${L(posture[0],posture[1])}</div><div class="muted" style="font-size:11px">${L('risk posture now','当前风险姿态')}</div></div>
    <div style="margin-left:auto">${spark}<div class="muted" style="font-size:10.5px">${L('cash % over time','现金% 历时')}</div></div>
  </div>${crash?`<div class="muted" style="font-size:12px;margin-top:8px;color:var(--down)">🛑 ${L('Momentum-crash de-risk active — book halved to cash.','动量崩盘去风险激活 — 组合减半至现金。')}</div>`:''}`;
}

function renderRotAlerts(){
  const el=document.getElementById('rot-alerts'); if(!el) return;
  const evs=(ROT_ALERTS||[]).slice(0,14);
  if(!evs.length){ el.innerHTML=`<div class="muted" style="font-size:12px">${L('No playbook changes recorded yet — the book is steady. Changes accrue here run over run.','尚无手册变化记录 — 组合稳定。变化将逐次累积于此。')}</div>`; return; }
  el.innerHTML=`<div style="display:flex;justify-content:flex-end"><a href="alerts.html" class="muted" style="font-size:11px;text-decoration:underline">${L('Alert Center →','警报中心 →')}</a></div>`+
    evs.map(e=>`<div class="palert"><span class="pdt">${esc((e.ts||'').slice(0,10))}</span><span class="sev-${esc(e.severity)}">${L(esc(e.headline),esc(e.headline_zh||e.headline))}</span></div>`).join('');
}
(function(){ function go(){ renderEntries(); renderRiskTime(); renderRotAlerts(); }
  if(document.readyState!=='loading') go(); else document.addEventListener('DOMContentLoaded',go); })();
</script>
<script src="ai_desk_thematic.js"></script>
<script src="theme.js"></script>
</body>
</html>
