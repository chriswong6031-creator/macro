{#- Mastermind News — about the wire.
    Copy law: no performance claims, no statistics, no numerals, no accuracy
    or track-record claims. Say what it covers, whose it is, and that it is
    educational. -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>About — {{ pub.label }}</title>
<meta name="description" content="What {{ pub.label }} covers, who writes it, and how it handles a mistake.">
<link rel="canonical" href="{{ pub.base_url }}/about.html">
<link rel="alternate" type="application/rss+xml" title="{{ pub.label }}" href="/feed.xml">
<meta property="og:site_name" content="{{ pub.label }}">
<meta property="og:title" content="About {{ pub.label }}">
<meta property="og:description" content="What {{ pub.label }} covers, who writes it, and how it handles a mistake.">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ pub.base_url }}/about.html">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="About {{ pub.label }}">
<meta name="twitter:description" content="What {{ pub.label }} covers, who writes it, and how it handles a mistake.">
<meta name="theme-color" content="#0B0E13">
<link rel="stylesheet" href="{{ css_href }}">
</head>
<body>
<a class="skip" href="#main">Skip to the page</a>

<header class="mast">
  <div class="wrap">
    <div class="mast-in">
      <a class="mast-name" href="/">{{ pub.label }}</a>
      <span class="mast-fill" aria-hidden="true"></span>
      <span class="mast-dom">{{ pub.domain }}</span>
    </div>
    <nav class="mast-nav" aria-label="Sections">
      <a href="/">The wire</a>
      <a href="/about.html" aria-current="page">About</a>
      <a href="/feed.xml">Feed</a>
    </nav>
  </div>
</header>

<main id="main">
  <div class="wrap">
    <div class="page">
      <p class="page-eyebrow">The desk</p>
      <h1 class="page-h">About {{ pub.label }}</h1>
      <div class="page-body">
        <p>{{ pub.label }} is a markets wire. The Brief is its desk, and it files short
        notes on what moved in a session and what appears to be behind it — the kind of
        thing you read standing up, between a screen and a meeting, then close.</p>

        <p>Every note carries the date and the minute it cleared the desk, and the front
        page runs newest first, so the top of the page is always the most recent thing we
        know. Copy here is machine-assisted and checked against the desk's own sources
        before it goes out. Treat that check as a floor rather than a promise: when a
        piece is wrong, the correction runs on the piece itself, dated and in plain sight,
        instead of a quiet edit.</p>

        <p>The wire is part of <a href="{{ flagship_url }}">Mastermind</a>, our markets
        research desk. Everything published here is educational. It is not investment
        advice, none of it is tailored to your situation, and markets involve risk.</p>
      </div>
    </div>
  </div>
</main>

<footer class="foot">
  <div class="wrap">
    <div class="foot-in">
      <p class="foot-disc">{{ footer_text }}</p>
      <p class="foot-meta">
        <span class="foot-c">&copy; Mastermind</span>
        <a href="/about.html" aria-current="page">About this wire</a>
        <a href="/feed.xml">Feed</a>
        <a href="{{ flagship_url }}">Part of Mastermind</a>
      </p>
    </div>
  </div>
</footer>

</body>
</html>
