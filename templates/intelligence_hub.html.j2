{% import "_desk_grader_panel.html.j2" as dg %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{#- inline SVG icons (Lucide-style, currentColor). Icons carry exactly ONE meaning on
    this page — "a desk" — plus the two inline markers (a dated event, a data channel).
    Section marks use the accent tick instead, so an icon always means something. -#}
{% macro ic(name) -%}
{% set P = {
  'news':     '<path d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2M7.5 8.5h6M7.5 12h6M7.5 15.5h4"/>',
  'alt':      '<path d="M3 21h18M5 21V9m5 12V5m5 16v-8m5 8V3"/>',
  'radar':    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12 19 7"/>',
  'board':    '<rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M8 14l2.5-3 2.5 2 3-4"/>',
  'policy':   '<path d="M3 21h18M5 21V10m4 11V10m6 11V10m4 11V10M12 3 3 8h18z"/>',
  'pulse':    '<path d="M3 12h4l2.5-7 4 14 2.5-7H21"/>',
  'cal':      '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3.5v3m8-3v3"/>'
} %}
<svg class="ic-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ P.get(name,'')|safe }}</svg>
{%- endmacro %}
{#- 5-desk agreement matrix: one dot per desk coloured by direction. A non-verbal
    encoding — it needs no vocabulary, so the conviction bar it replaced is gone. -#}
{% macro matrix(dirs, conv=none, nconf=none) -%}
<span class="mtx" data-tip-en="Which desks read this name the same way — news · alt-data · radar · buy-board · policy. Green up, red down, grey no lean, empty means that desk never looked.{% if conv is not none %} Agreement score {{ conv|round|int }}{% if nconf %} across {{ nconf }} desk{{ 's' if nconf != 1 else '' }}{% endif %}.{% endif %}"
  data-tip-zh="哪些台对该标的读法一致 —— 新闻 · 另类数据 · 雷达 · 买入榜 · 政策。绿色看多，红色看空，灰色无倾向，空白表示该台从未覆盖。{% if conv is not none %}一致度 {{ conv|round|int }}{% if nconf %}，来自 {{ nconf }} 个台{% endif %}。{% endif %}">
{%- for k in ['news','alt','radar','standout','policy'] -%}
{% set d = dirs.get(k) %}
<span class="cell {{ 'up' if d==1 else 'dn' if d==-1 else 'nz' if d==0 else 'off' }}"></span>
{%- endfor -%}
</span>
{%- endmacro %}
{#- lifecycle stage chip — the plain-word stance that heads every row -#}
{% set STAGE_ZH = {'emerging':'萌芽','early':'早期','consensus':'共识','exhausted':'透支','distribution':'派发','building':'酝酿','discovery':'发掘','faltering':'走弱'} %}
{% macro stage(s) -%}
<span class="chip st-{{ s }}"><span class="l-en">{{ s }}</span><span class="l-zh">{{ STAGE_ZH.get(s, s) }}</span></span>
{%- endmacro %}
{#- room-left rail: how much of the move the engine still reads as un-priced.
    ONE receipt explains the encoding per panel (band legend / rail label) rather than
    thirty identical hovers — a constant belongs in the panel, once. -#}
{% set ROOM_EN = "How much of the move this page still reads as un-priced. Built from where the name sits in its own range, how loud the tape around it already is, and how far it has already run. The colour says which way the desks lean: green up, red down — so a high reading on a red row means most of the fall is still ahead." %}
{% set ROOM_ZH = "本页判断该标的还有多少幅度尚未被消化。依据它在自身区间中的位置、周围盘面已经多喧闹、以及已经跑了多远。颜色表示各台的方向倾向：绿色偏多，红色偏空 —— 因此红色行上的高数值意味着大部分跌幅仍在前方。" %}
{% macro roomrail(e, accent='var(--info)') -%}
<div class="room" style="--accent:{{ accent }}">
  <span class="lab" data-tip-en="{{ ROOM_EN }}" data-tip-zh="{{ ROOM_ZH }}">{{ t('room left', '剩余空间') }}</span>
  <span class="trk"><i style="width:{{ ((e or 0)*100)|round|int }}%"></i></span>
  <span class="v">{{ ((e or 0)*100)|round|int }}%</span>
</div>
{%- endmacro %}
{#- ⚡ prime-entry badge — the owner's T1-T4 confluence verdict. i18n via the
    data-tip-en/zh popover pattern (NEVER translated text in a title= attribute). -#}
{% macro entrybadge(eg) -%}
{% if eg %}{% if eg.get('buyable') %}<span class="chip en-buy" data-tip-en="Validated confluence buy · tier {{ eg.get('tier') or '—' }}" data-tip-zh="已验证共振买入 · 层级 {{ eg.get('tier') or '—' }}">⚡ <span class="l-en">entry</span><span class="l-zh">入场</span>{% if eg.get('tier') %} {{ eg.tier }}{% endif %}</span>{% endif %}{% endif %}
{%- endmacro %}
{#- price-trajectory state. Only the shape words live here — the off-high and
    relative-strength figures already arrive inside edge_drivers, so printing them
    twice in one row was the same fact wearing two hats. -#}
{% macro tstate(tr) -%}
{% if tr %}{% if tr.get('rolling_over') %}<span class="chip warn"><span class="l-en">rolling over</span><span class="l-zh">见顶回落</span></span>{% elif tr.get('basing') %}<span class="chip good"><span class="l-en">basing</span><span class="l-zh">筑底</span></span>{% endif %}{% endif %}
{%- endmacro %}
{#- edge drivers: the row-specific reasons. Replaces the stage-templated sentence
    that used to repeat itself verbatim down every row of the ledger. -#}
{% macro drivers(ds) -%}
{% if ds %}<div class="drv">{% for d in ds %}{% if d.startswith('⚠') %}<span class="cau">{{ d|e }}</span>{% else %}<b>{{ d|e }}</b>{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
{%- endmacro %}
{#- flags, de-duplicated against the stage chip that already says the same thing -#}
{% set FLAG_ZH = {'early_edge':'早期优势','discovery':'发掘','stealth_accumulation':'隐性吸筹','crowded_top':'拥挤','confirmed_trend':'趋势确认','theme_wide':'主题共振','fading':'退潮','policy_conflict':'政策相悖','policy_aligned':'政策顺风','catalyst':'催化','isolated':'孤立','velocity_spike':'加速'} %}
{% set FLAG_SKIP = ['emerging','early','exhausted','distribution','fading','discovery'] %}
{% macro flags(fs) -%}
{% set keep = [] %}{% for f in (fs or []) %}{% if f not in FLAG_SKIP %}{% set _ = keep.append(f) %}{% endif %}{% endfor %}
{%- for f in keep[:2] %}<span class="chip {{ 'crowd' if f=='crowded_top' else 'good' if f in ['confirmed_trend','theme_wide','stealth_accumulation','policy_aligned'] else 'bad' if f=='policy_conflict' else 'cat' if f=='catalyst' else 'info' if f in ['early_edge','velocity_spike'] else 'mut' }}"><span class="l-en">{{ f.replace('_',' ') }}</span><span class="l-zh">{{ FLAG_ZH.get(f, f.replace('_',' ')) }}</span></span>{% endfor %}
{%- endmacro %}
{#- desk track-record state. The chip's own label is machine-generated (qledger D10,
    never hand-written) so it rides the hover as the receipt; Tier 1 shows only the
    translated state word, the STAGE_ZH slug-to-label pattern the doctrine ratifies. -#}
{% set QL_ZH = {'UNGRADED':'未评分','ACCRUING':'评分中','GRADED':'已评分'} %}
{% macro qlword(chip) -%}
{% set c = chip or {'state':'UNGRADED','css_class':'ql-ungraded','label':'UNGRADED · n=0','label_zh':'未评级 · n=0'} %}
<span class="gw {{ c.css_class }}"><span class="l-en">{{ (c.state or 'UNGRADED')|lower }}</span><span class="l-zh">{{ QL_ZH.get(c.state, '未评分') }}</span></span>
{%- endmacro %}
{% set _ql = qledger_chips or {} %}
{% set MC = hub.macro_context or {} %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Intelligence Hub</title>
{% set seo_title = "Intelligence Hub — Mastermind" %}{% set seo_desc = "Ranked market intelligence across signal desks — what is emerging now, ranked by how much of the move is still ahead rather than by consensus." %}{% set seo_path = "intelligence_hub.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  /* ══ Intelligence Hub ══════════════════════════════════════════════════════
     The page is an instrument, not a poster. One hairline system, one radius,
     one card fill, mono reserved for figures, and a single bright element — the
     room-left spine down the Command ledger — which draws the page's own thesis
     (how much of the move is still ahead) as the structure of the list itself.

     Removed 2026-07-30 (operator order): the ambient sky canvas and its sun. A
     drifting starfield behind four hundred figures competes with the only thing
     on the page that matters, and the sun's 220px glow washed the top cards.
     `sky.js` stays in the tree — start.html still owns that treatment.
     ────────────────────────────────────────────────────────────────────────── */
  body.page-hub{ margin:0; background:var(--bg); color:var(--text); font-family:var(--font-ui);
    --r:10px;
    --card:color-mix(in srgb,var(--panel) 92%,transparent);
    --card-2:color-mix(in srgb,var(--panel) 62%,transparent);
    --hair:color-mix(in srgb,var(--line) 78%,transparent);
    --hair-soft:color-mix(in srgb,var(--line) 44%,transparent);
    --dim:color-mix(in srgb,var(--text) 74%,transparent);
    --cat:#8b5cf6;
    --fig:var(--font-mono); }
  .hub-wrap{ max-width:1200px; margin:0 auto; padding:6px 20px 64px; position:relative; z-index:1; }
  body.page-hub > .site-nav{ max-width:1200px; margin:14px auto 6px; padding:0 20px; }
  .ic-svg{ width:14px; height:14px; flex:none; vertical-align:middle; }
  /* every figure on the page is mono + tabular; words never are */
  .f{ font-family:var(--fig); font-variant-numeric:tabular-nums; }

  /* ── hero: identity left, market state right, one rule under both ── */
  .hh{ display:grid; grid-template-columns:minmax(0,1fr) auto; gap:16px 32px; align-items:end;
    margin:16px 0 0; padding-bottom:17px; border-bottom:1px solid var(--hair); }
  @media(max-width:880px){ .hh{ grid-template-columns:1fr; align-items:start; } }
  .eyebrow{ display:inline-flex; align-items:center; gap:8px; font-size:10.5px; font-weight:700;
    letter-spacing:.13em; text-transform:uppercase; color:var(--muted); }
  .eyebrow time{ font-family:var(--fig); letter-spacing:.04em; }
  .live{ width:6px; height:6px; border-radius:50%; background:var(--ok); position:relative; flex:none; }
  .live::after{ content:""; position:absolute; inset:-4px; border-radius:50%;
    border:1.5px solid var(--ok); opacity:.5; animation:hp 2.6s ease-out infinite; }
  @keyframes hp{ 0%{ transform:scale(.55); opacity:.55 } 100%{ transform:scale(1.75); opacity:0 } }
  .hh h1{ font-size:clamp(29px,3.7vw,41px); font-weight:800; letter-spacing:-.033em; line-height:1.03;
    margin:10px 0 8px; color:var(--text); }
  .deck{ margin:0; font-size:14px; line-height:1.5; color:var(--dim); max-width:58ch; }
  .deck .lens-q{ vertical-align:baseline; }
  /* market state: an instrument readout, not another row of pills */
  .state{ display:flex; flex-wrap:wrap; align-items:baseline; row-gap:9px; }
  .state i{ font-style:normal; display:inline-flex; align-items:baseline; gap:7px; padding:0 15px;
    border-left:1px solid var(--hair); font-size:10px; font-weight:700; letter-spacing:.11em;
    text-transform:uppercase; color:var(--muted); white-space:nowrap; }
  .state i:first-child{ border-left:0; padding-left:0; }
  /* the engine hands these down lower-cased ("mid", "expanding"); capitalise at render
     so the readout doesn't mix cases beside "Goldilocks" / "Hawkish" */
  .state b{ font-size:13px; font-weight:700; letter-spacing:-.008em; text-transform:capitalize;
    color:var(--text); }
  .state i.hot b{ color:var(--up); }
  @media(max-width:880px){ .state i:first-child{ padding-left:0 } .state{ margin-top:4px } }

  /* ── desk rail: six links, one container, hairline cells ── */
  .rail{ display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); margin:18px 0 2px;
    border:1px solid var(--hair); border-radius:var(--r); background:var(--card); overflow:hidden; }
  .rl{ display:flex; align-items:center; gap:8px; min-width:0; padding:11px 13px;
    text-decoration:none; color:var(--text); font-size:12.5px; font-weight:600;
    border-left:1px solid var(--hair-soft); transition:background .16s ease, color .16s ease; }
  .rl:first-child{ border-left:0; }
  .rl:hover{ background:color-mix(in srgb,var(--info) 9%,transparent); color:var(--info); }
  .rl .ic-svg{ color:var(--muted); transition:color .16s ease; }
  .rl:hover .ic-svg{ color:var(--info); }
  .rl .rn{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rl .gw{ margin-left:auto; font-size:9px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; white-space:nowrap; }
  .rl .lamp{ width:6px; height:6px; border-radius:50%; flex:none; background:var(--down); }
  .rl .lamp.on{ background:var(--ok); }
  .ql-chip-ungraded, .gw.ql-ungraded{ color:var(--muted); }
  .ql-chip-accruing{ color:var(--warn); }
  .ql-chip-graded-pos{ color:var(--up); }
  .ql-chip-graded-neg{ color:var(--down); }
  @media(max-width:1040px){
    .rail{ grid-template-columns:repeat(3,minmax(0,1fr)); }
    .rl{ border-left:1px solid var(--hair-soft); }
    .rl:nth-child(3n+1){ border-left:0; }
    .rl:nth-child(n+4){ border-top:1px solid var(--hair-soft); }
  }
  @media(max-width:620px){
    .rail{ grid-template-columns:repeat(2,minmax(0,1fr)); }
    .rl{ border-left:1px solid var(--hair-soft); }
    .rl:nth-child(3n+1){ border-left:1px solid var(--hair-soft); }
    .rl:nth-child(odd){ border-left:0; }
    .rl:nth-child(n+3){ border-top:1px solid var(--hair-soft); }
    .rl .gw{ display:none; }
  }

  /* ── section mark: an accent tick, a label, a rule, a count ── */
  .band{ display:flex; align-items:center; gap:11px; margin:34px 0 12px; }
  .band .tick{ width:3px; height:14px; border-radius:2px; flex:none;
    background:var(--accent,var(--info)); }
  .band h2{ margin:0; font-size:11.5px; font-weight:800; letter-spacing:.11em; text-transform:uppercase;
    color:var(--text); white-space:nowrap; }
  .band .ln{ flex:1; height:1px; min-width:14px;
    background:linear-gradient(90deg,var(--hair),transparent 94%); }
  .band .n{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:11.5px;
    font-weight:700; color:var(--muted); flex:none; }
  .band .legend{ display:inline-flex; align-items:center; gap:6px; flex:none; font-size:10px;
    font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .band .legend .lg{ width:3px; height:12px; border-radius:2px;
    background:linear-gradient(to top,var(--up) 62%,var(--hair-soft) 62%); }
  @media(max-width:620px){ .band .legend{ display:none } }

  /* ── one card system ── */
  .card{ border:1px solid var(--hair); border-radius:var(--r); background:var(--card); }
  .empty{ font-size:12.5px; color:var(--muted); padding:11px 0; }
  /* Stance line — every signal band answers "so what do I do" ONCE, here, in plain
     words (DESIGN_DOCTRINE Law 1 + Law 4). This is what the stage-templated sentence
     that used to reprint itself on every row was reaching for. */
  .stance{ font-size:11.5px; line-height:1.5; color:var(--muted); margin:-3px 0 11px; max-width:78ch; }
  .stance b{ color:color-mix(in srgb,var(--text) 80%,transparent); font-weight:600; }

  /* ── one chip system: state · good · caution · bad · catalyst · neutral ── */
  .chip{ font-size:9.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase;
    padding:2px 7px; border-radius:5px; white-space:nowrap; flex:none;
    background:color-mix(in srgb,var(--muted) 15%,transparent); color:var(--muted); }
  .chip.good, .chip.st-early{ background:color-mix(in srgb,var(--up) 17%,transparent); color:var(--up); }
  .chip.info, .chip.st-emerging, .chip.st-discovery{
    background:color-mix(in srgb,var(--info) 20%,transparent); color:var(--info); }
  .chip.warn, .chip.crowd, .chip.st-faltering{
    background:color-mix(in srgb,var(--warn) 20%,transparent); color:var(--warn); }
  .chip.bad, .chip.st-exhausted, .chip.st-distribution{
    background:color-mix(in srgb,var(--down) 17%,transparent); color:var(--down); }
  .chip.cat{ background:color-mix(in srgb,var(--cat) 20%,transparent);
    color:color-mix(in srgb,var(--cat) 68%,var(--text)); }
  .chip.en-buy{ display:inline-flex; align-items:center; gap:3px; cursor:help;
    background:color-mix(in srgb,var(--up) 22%,transparent); color:var(--up);
    box-shadow:0 0 0 1px color-mix(in srgb,var(--up) 38%,transparent) inset; }
  .chip.src{ background:color-mix(in srgb,var(--info) 14%,transparent); color:var(--info); }

  /* ── shared row atoms ── */
  .tk{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-weight:700; font-size:14.5px;
    letter-spacing:-.015em; }
  .px{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:11px; color:var(--muted);
    white-space:nowrap; }
  .nm{ font-size:10.5px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .score{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:20px; font-weight:700;
    letter-spacing:-.035em; color:var(--text); line-height:1; }
  .rd{ font-size:12px; line-height:1.45; color:var(--dim); }
  .drv{ font-size:10.5px; line-height:1.5; color:var(--muted); margin-top:5px; }
  .drv b{ color:color-mix(in srgb,var(--text) 80%,transparent); font-weight:600; }
  .drv .cau{ color:var(--warn); }
  .cline{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
  .watch{ font-size:10px; color:var(--muted); margin-top:5px; }
  .watch b{ color:color-mix(in srgb,var(--text) 72%,transparent); font-weight:600; }

  /* room-left rail — the figure keeps the precision the bar can only suggest */
  .room{ display:flex; align-items:center; gap:9px; }
  .room .lab{ font-size:9px; font-weight:700; letter-spacing:.09em; text-transform:uppercase;
    color:var(--muted); white-space:nowrap; }
  .room .trk{ flex:1; min-width:36px; height:3px; border-radius:2px; background:var(--hair-soft);
    overflow:hidden; }
  .room .trk i{ display:block; height:100%; background:var(--accent,var(--info)); }
  .room .v{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:11px;
    font-weight:700; color:color-mix(in srgb,var(--text) 84%,transparent); }

  /* ── agreement matrix ── */
  .mtx{ display:inline-flex; gap:3px; align-items:center; cursor:help; }
  .mtx .cell{ width:8px; height:14px; border-radius:2px; background:var(--hair-soft); }
  .mtx .cell.up{ background:var(--up); } .mtx .cell.dn{ background:var(--down); }
  .mtx .cell.nz{ background:color-mix(in srgb,var(--muted) 55%,transparent); }
  .mtx .cell.off{ background:color-mix(in srgb,var(--line) 40%,transparent); }

  /* ── emerging: the page's hero. The only cards that get an accent edge. ──
     Card faces are uniform by construction (no prose block one card carries and its
     siblings don't) and the bottom strip is pushed down with margin-top:auto, so the
     room-left rails line up across the row instead of leaving a hollow band under
     the shortest card. Never `align-items:start` — that hides a void, it can't fix it. */
  .ecards{ display:grid; gap:12px; grid-template-columns:repeat(auto-fill,minmax(272px,1fr)); }
  .ecard{ position:relative; padding:14px 15px 13px; overflow:hidden;
    display:flex; flex-direction:column; }
  .ecard.lead::before{ content:""; position:absolute; inset:0 auto 0 0; width:2px;
    background:var(--accent,var(--info)); }
  /* the figure stays pinned to the top-right corner however far the chips wrap */
  .ecard .et{ display:flex; align-items:baseline; gap:8px 7px; flex-wrap:wrap; padding-right:38px; }
  .ecard .et .score, .ecard .et .dscore{ position:absolute; top:12px; right:15px; margin:0; }
  .ecard .nm{ margin-top:3px; }
  .ecard .rd{ margin:8px 0 0; }
  .ecard .room{ margin-top:auto; padding-top:11px; border-top:1px solid var(--hair-soft); }
  .ecard .foot{ margin-top:7px; font-size:10px; color:var(--muted);
    display:flex; align-items:center; gap:5px; }
  .ecard .foot .ic-svg{ width:12px; height:12px; }

  /* ── discovery: same anatomy, quieter, no accent edge. The reason clamps to two
        lines so fourteen cards can't each set their own height. ── */
  .dcard .rd{ display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
    overflow:hidden; }
  .dscore{ font-family:var(--fig); font-variant-numeric:tabular-nums;
    font-size:15px; font-weight:700; color:var(--info); }
  .dchan{ font-size:10px; color:var(--muted); margin-top:auto; padding-top:8px;
    display:flex; align-items:center; gap:5px; min-width:0; }
  .dchan .ic-svg{ width:12px; height:12px; flex:none; }
  .dchan .ch{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  /* ── two-up alert panels ── */
  /* minmax(0,1fr), not 1fr: the catalyst briefs are nowrap-ellipsised, and a bare 1fr
     resolves to minmax(auto,1fr) — their min-content width would let that column push
     the other panel down to a sliver */
  .alerts{ display:grid; gap:12px; grid-template-columns:minmax(0,1fr) minmax(0,1fr); margin-top:6px; }
  /* minmax(0,…) here too — a bare 1fr is minmax(auto,1fr) and the nowrap briefs would
     set the column's min-content width, scrolling the whole page sideways on mobile */
  @media(max-width:820px){ .alerts{ grid-template-columns:minmax(0,1fr); } }
  .panel{ padding:13px 15px 14px; }
  .panel h3{ display:flex; align-items:center; gap:10px; margin:0 0 3px; font-size:11px;
    font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:var(--text); }
  .panel h3 .tick{ width:3px; height:12px; border-radius:2px; flex:none; background:var(--accent,var(--info)); }
  .panel h3 .n{ margin-left:auto; font-family:var(--fig); font-variant-numeric:tabular-nums;
    font-size:11px; font-weight:700; color:var(--muted); letter-spacing:0; }
  /* row-scoped, so the "View all" overlay can move these rows out of the panel
     and they still lay out; separators stay in-flow-only (the overlay draws its own) */
  .arow{ display:flex; align-items:center; gap:10px; padding:8px 0; font-size:12px; }
  .panel .arow{ border-top:1px solid var(--hair-soft); }
  .arow .tk{ font-size:12.5px; min-width:48px; flex:none; }
  .arow .ab{ color:var(--dim); line-height:1.4; min-width:0; flex:1; }
  .arow .age{ margin-left:auto; font-family:var(--fig); font-size:10px; color:var(--muted);
    white-space:nowrap; }
  .arow .pct{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:11.5px;
    font-weight:700; color:var(--down); }
  /* one line per catalyst, ellipsised: two-line briefs made this panel taller than
     its neighbour and parked a dead band under the shorter one */
  .arow.cat-row .ab{ display:flex; align-items:center; gap:8px; overflow:hidden; }
  .arow.cat-row .cb{ min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

  /* ══ Command ledger — the signature ════════════════════════════════════════
     One container, thirty rows, no per-row card. A single rule runs down the
     left edge and each row's segment fills from the bottom by how much of the
     move is still ahead — so scrolling the ledger shows the edge draining away.
     The bar is the shape; the mono figure beside the score keeps the precision.
     ─────────────────────────────────────────────────────────────────────────── */
  .led{ border:1px solid var(--hair); border-radius:var(--r); background:var(--card); overflow:hidden; }
  .led-row{ display:grid; grid-template-columns:26px 150px 52px 55px minmax(0,1fr);
    align-items:center; gap:0 14px; padding:10px 15px 10px 0; min-height:58px; }
  .led > .led-row + .led-row{ border-top:1px solid var(--hair-soft); }
  .sp{ align-self:stretch; position:relative; }
  .sp::before{ content:""; position:absolute; left:11px; top:0; bottom:0; width:3px;
    background:linear-gradient(to top, var(--sp-c) var(--sp-p), var(--hair-soft) var(--sp-p)); }
  .led-row .id{ min-width:0; }
  .led-row .id .tkline{ display:flex; align-items:baseline; gap:7px; }
  .led-row .score{ text-align:right; }
  .led-row .rmv{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:11px;
    font-weight:700; color:var(--muted); text-align:right; }
  @media(max-width:820px){
    .led-row{ grid-template-columns:22px 118px 46px minmax(0,1fr); gap:0 11px; }
    .led-row .mtxc{ display:none; }
    .sp::before{ left:9px; }
  }

  /* ── track record: the plain read, with the study panel folded beneath ── */
  .trh{ display:grid; gap:11px; grid-template-columns:repeat(auto-fill,minmax(258px,1fr)); }
  .trc{ padding:12px 14px 13px; }
  .trc .th{ display:flex; align-items:center; gap:8px; margin-bottom:9px; }
  .trc .th .h{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:12.5px;
    font-weight:700; letter-spacing:-.01em; }
  .trc .th .chip{ margin-left:auto; }
  .trg{ display:grid; grid-template-columns:1fr 1fr; gap:9px 14px; }
  .trcell{ min-width:0; }
  .trlab{ display:block; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
    color:var(--muted); margin-bottom:3px; line-height:1.35; }
  .trval{ font-family:var(--fig); font-variant-numeric:tabular-nums; font-size:13.5px; font-weight:700;
    color:var(--text); }
  .trval.pos{ color:var(--up); } .trval.neg{ color:var(--down); }
  .trans{ font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; }
  .trans.ok{ color:var(--up); } .trans.bad{ color:var(--down); }
  .note{ font-size:12px; line-height:1.55; color:var(--dim); padding:12px 15px; }
  .note b{ color:var(--text); }

  /* ── sector heat: one container, one column of bars ──
     Six scattered cards each drew their meter at a different x-offset and width, so
     the one comparison the panel exists to make — which sector is hottest — had to be
     done by reading numbers. Aligned in a single list the bars share a scale and the
     ranking is legible without any vocabulary at all. */
  .slist{ overflow:hidden; }
  .srow{ display:grid; grid-template-columns:46px minmax(110px,200px) minmax(70px,1fr) auto;
    align-items:center; gap:0 14px; padding:10px 15px; font-size:12.5px; }
  .slist > .srow + .srow{ border-top:1px solid var(--hair-soft); }
  .srow .etf{ font-family:var(--fig); font-size:9.5px; font-weight:700; letter-spacing:.03em;
    padding:2px 5px; border-radius:5px; text-align:center;
    background:color-mix(in srgb,var(--info) 14%,transparent); color:var(--info); }
  .srow .snm{ font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
    display:flex; align-items:center; gap:7px; min-width:0; }
  .srow .meter{ height:4px; border-radius:2px; background:var(--hair-soft); overflow:hidden; }
  .srow .meter i{ display:block; height:100%; background:var(--accent,var(--info)); }
  .srow .sf{ font-size:10px; color:var(--muted); display:flex; gap:12px; white-space:nowrap; }
  .srow .sf b{ font-family:var(--fig); font-variant-numeric:tabular-nums;
    color:color-mix(in srgb,var(--text) 80%,transparent); }
  @media(max-width:620px){
    .srow{ grid-template-columns:46px minmax(0,1fr) auto; row-gap:8px; }
    .srow .meter{ grid-column:1 / -1; }
  }

  footer.hf{ margin-top:32px; padding-top:15px; border-top:1px solid var(--hair);
    font-size:11px; color:var(--muted); line-height:1.6; }
  footer.hf time{ font-family:var(--fig); }
  @media (prefers-reduced-motion:reduce){
    .rl, .rl .ic-svg{ transition:none; }
    .live::after{ animation:none; }
  }
</style>
</head>
<body class="page-hub">
{% include "_site_nav.html.j2" %}

<div class="hub-wrap">
  {# ── hero: the deck is one line; the method lives one click away (Tier 2) ── #}
  <header class="hh">
    <div>
      <span class="eyebrow"><span class="live"></span>{{ t('Live', '实时') }}
        {%- if built %} · <time datetime="{{ built }}">{{ built[:10] }}</time>{% endif %}</span>
      <h1>{{ t('Intelligence Hub', '情报中心') }}</h1>
      <p class="deck">{{ t('What still has room to run — surfaced before the crowd arrives.',
                          '仍有上行空间的机会 —— 抢在人群之前浮出水面。') }}
        <button class="lens-q" type="button" aria-label="How this page ranks names"
          data-tip-en="Ranked by genuine signal × how much of the move is still ahead × whether a leading desk fired before the crowd. Deliberately NOT ranked by how many desks agree — agreement is a lagging condition, so a crowd favourite that has already run is demoted. Five desks vote on each name: news flow, alt-data, divergence radar, buy-board, policy intent. Context only, never a trade trigger."
          data-tip-zh="排序依据：真实信号 × 行情尚未走完的幅度 × 领先信号台是否抢在人群之前发动。刻意不按「多少台一致」排序 —— 一致性是滞后条件，因此已经跑完的人群宠儿会被下调。五台对每个标的投票：新闻流、另类数据、背离雷达、买入榜、政策意图。仅供参考，绝非交易触发。">?</button></p>
    </div>
    <div class="state">
      {% if MC.regime %}<i class="hot">{{ t('Regime', '格局') }} <b>{{ MC.regime }}{% if MC.quad %} {{ MC.quad }}{% endif %}</b></i>{% endif %}
      {% if MC.cycle %}<i>{{ t('Cycle', '周期') }} <b>{{ MC.cycle }}</b></i>{% endif %}
      {% if MC.liquidity %}<i>{{ t('Liquidity', '流动性') }} <b>{{ MC.liquidity }}</b></i>{% endif %}
      {% if MC.fed_stance %}<i>{{ t('Fed', '美联储') }} <b>{{ MC.fed_stance }}</b></i>{% endif %}
    </div>
  </header>

  {# ── desk rail. Purpose + grading receipt ride the hover; Tier 1 keeps the
        name, the live lamp and the translated grading state. ── #}
  <div class="rail">
    {% set DK = [('news','News','新闻流','news.html','News flow — the tape','新闻流 —— 盘面'),
                 ('alt_data','Alt-Data','另类数据','alt_data.html','Smart-money signal','聪明钱信号'),
                 ('radar','Radar','背离雷达','radar.html','Divergence radar — activity vs price','背离雷达 —— 活跃度对比价格'),
                 ('standout','Buy-Board','买入榜','us_stocks.html','Prophet buy signals','先知买入信号'),
                 ('policy','Policy','政策观察','policy_watch.html','Policy watch — realpolitik intent','政策观察 —— 政策实际意图'),
                 ('special','Special','特殊事件','special_situations.html','Special situations — dated catalysts','特殊事件 —— 有日期的催化')] %}
    {% set DICON = {'news':'news','alt_data':'alt','radar':'radar','standout':'board','policy':'policy','special':'cal'} %}
    {% for key,label,label_zh,href,desc,desc_zh in DK %}
    {% set live = (hub.desks.get(key) or {}).get('live') %}
    {% set qc = _ql.get(key) %}
    <a class="rl" href="{{ href }}"
       data-tip-en="{{ desc }} · {{ 'live' if live else 'offline' }} · track record: {{ (qc.label if qc else 'UNGRADED · n=0') }}"
       data-tip-zh="{{ desc_zh }} · {{ '在线' if live else '离线' }} · track record: {{ (qc.label_zh if qc else '未评级 · n=0') }}">
      {{ ic(DICON.get(key,'news')) }}<span class="rn">{{ t(label, label_zh) }}</span>{{ qlword(qc) }}<span class="lamp {{ 'on' if live else '' }}"></span>
    </a>{% endfor %}
  </div>

  {# ── EMERGING EDGE — the pre-consensus hero ── #}
  {% set EM = hub.emerging or [] %}{% set EX = hub.exhausted or [] %}{% set CA = hub.catalysts or [] %}
  <div class="band" style="--accent:var(--info)"><span class="tick"></span>
    <h2>{{ t('Emerging edge', '萌芽优势') }}</h2><span class="ln"></span><span class="n">{{ EM|length }}</span></div>
  <div class="stance">{{ t("A leading desk is positioned; the tape has not confirmed yet. <b>Watch — don't chase.</b>",
                          '领先信号台已建仓，盘面尚未确认。<b>观察 —— 不要追高。</b>') }}</div>
  {% if EM %}
  <div class="ecards">
    {% for d in EM %}
    <div class="card ecard lead" style="--accent:{{ 'var(--info)' if d.stage=='emerging' else 'var(--up)' }}">
      <div class="et"><span class="tk">{{ d.ticker }}</span>{% if d.price is not none %}<span class="nb-px px" data-sym="{{ d.ticker }}" data-mkt="us">${{ '%.2f'|format(d.price) }}</span>{% endif %}
        {{ stage(d.stage) }}{{ entrybadge(d.entry_gate) }}{{ tstate(d.trajectory) }}
        <span class="score">{{ d.opportunity_score|round|int }}</span></div>
      {% if d.name and d.name != d.ticker %}<div class="nm">{{ d.name|e }}</div>{% endif %}
      {{ drivers(d.edge_drivers) }}
      {{ roomrail(d.edge_remaining, 'var(--info)' if d.stage=='emerging' else 'var(--up)') }}
      {% if d.catalyst and d.catalyst.live %}<div class="foot">{{ ic('cal') }} {{ d.catalyst.category|e }}{% if d.catalyst.days_since is not none %} · {{ d.catalyst.days_since }}{{ t('d ago','天前') }}{% endif %}</div>{% endif %}
    </div>{% endfor %}
  </div>
  {% else %}<div class="empty">{{ t('Nothing emerging today — the tape is led by names that have already moved.', '今日无萌芽机会 —— 盘面由已经发动的标的主导。') }}</div>{% endif %}

  {# ── DISCOVERY — leading signals the desks dropped or never read ── #}
  {% if hub.discovery %}
  <div class="band" style="--accent:var(--info)"><span class="tick"></span>
    <h2>{{ t('Discovery', '发掘') }}</h2><span class="ln"></span>
    <span class="legend">{{ t('what the desks miss', '各台遗漏之处') }}</span>
    <span class="n">{{ hub.discovery|length }}</span></div>
  <div class="stance">{{ t('Leads no desk has picked up yet. <b>Watch</b> — a lead is not a signal.',
                          '尚无信号台采纳的线索。<b>观察</b> —— 线索不等于信号。') }}</div>
  {# one row on the face, the rest behind the shared "View all" overlay #}
  <div class="lst-wrap" data-ovl-title-en="Discovery — what the desks miss" data-ovl-title-zh="发掘 —— 各台遗漏之处" data-ovl-accent="var(--info)">
  <div class="ecards lst-collapse lst-cap4 is-collapsed">
    {% for d in hub.discovery %}{% set dd = d.discovery or {} %}
    <div class="card ecard dcard">
      <div class="et"><span class="tk">{{ d.ticker }}</span>{% if d.price is not none %}<span class="nb-px px" data-sym="{{ d.ticker }}" data-mkt="us">${{ '%.2f'|format(d.price) }}</span>{% endif %}
        <span class="chip src">{{ (dd.source or '')|replace('_',' ')|e }}</span>
        {% if dd.off_desk %}<span class="chip good">{{ t('off-desk','非台内') }}</span>{% endif %}
        <span class="dscore">{{ ((dd.disc_score or 0)*100)|round|int }}</span></div>
      <div class="rd" style="margin-top:8px">{{ dd.reason|e }}</div>
      {# prettify the machine slugs — raw `github_momentum` is banned at glance tier #}
      {% if dd.channels %}<div class="dchan">{{ ic('pulse') }} <span class="ch">{{ dd.channels|map('replace','_',' ')|join(' · ')|e }}</span></div>{% endif %}
    </div>{% endfor %}
  </div>
  <button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more','显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>
  </div>
  {% endif %}

  {# ── exhausted (fade) + dated catalysts. Both lists used to reprint one
        stage-templated sentence on every row; a constant belongs in the panel,
        not per row (DESIGN_DOCTRINE Law 4), so the rows now carry only what
        actually varies. Full lists sit behind the shared "View all" overlay. ── #}
  <div class="alerts">
    <div class="card panel" style="--accent:var(--down)"
         data-ovl-title-en="Exhausted — already run" data-ovl-title-zh="透支 —— 已跑完" data-ovl-accent="var(--down)">
      <h3><span class="tick"></span>{{ t('Exhausted — already run', '透支 —— 已跑完') }} <span class="n">{{ EX|length }}</span></h3>
      <div class="stance" style="margin:2px 0 6px">{{ t('Desks lean bearish and price is rolling over. <b>De-risk — not a long.</b>', '各台偏空且价格见顶回落。<b>降低风险 —— 不宜做多。</b>') }}</div>
      {#- the stage chip earns its place only when the list actually holds more than one
          stage; seven identical chips are a constant, and a constant belongs to the
          panel, not to every row (DESIGN_DOCTRINE Law 4) -#}
      {% set EX_STAGES = EX|map(attribute='stage')|reject('none')|unique|list %}
      {% if EX %}<div class="lst-wrap"><div class="lst-collapse is-collapsed">
      {% for d in EX %}<div class="arow">
        <span class="tk">{{ d.ticker }}</span>{% if EX_STAGES|length > 1 %}{{ stage(d.stage) }}{% endif %}
        <span class="ab">{{ t('room left','剩余空间') }} <span class="pct">{{ (d.edge_remaining*100)|round|int }}%</span></span></div>{% endfor %}
      </div>
      <button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more','显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button></div>
      {% else %}<div class="empty">{{ t('Nothing flagged exhausted today.', '今日无透支标的。') }}</div>{% endif %}
    </div>
    <div class="card panel" style="--accent:var(--cat)"
         data-ovl-title-en="Dated catalysts" data-ovl-title-zh="有日期的催化" data-ovl-accent="var(--cat)">
      <h3><span class="tick"></span>{{ t('Dated catalysts', '有日期的催化') }} <span class="n">{{ CA|length }}</span></h3>
      <div class="stance" style="margin:2px 0 6px">{{ t('Events with a known date. <b>Context for timing — not a reason to buy.</b>', '有确定日期的事件。<b>用于把握时点 —— 而非买入理由。</b>') }}</div>
      {% if CA %}<div class="lst-wrap"><div class="lst-collapse is-collapsed">
      {% for d in CA %}{% set c = d.catalyst or {} %}<div class="arow cat-row">
        <span class="tk">{{ d.ticker }}</span>
        <span class="ab"><span class="chip cat">{{ c.category|e }}</span>{% if c.brief %}<span class="cb">{{ c.brief|e }}</span>{% endif %}</span>
        {%- if c.days_since is not none %}<span class="age">{{ c.days_since }}{{ t('d','天') }}</span>{% endif %}</div>{% endfor %}
      </div>
      <button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more','显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button></div>
      {% else %}<div class="empty">{{ t('No fresh dated catalysts in-universe.', '覆盖范围内暂无新催化事件。') }}</div>{% endif %}
    </div>
  </div>

  {# ── COMMAND LEDGER ── #}
  <div class="band" style="--accent:var(--up)"><span class="tick"></span>
    <h2>{{ t('Command', '指挥榜') }}</h2><span class="ln"></span>
    <span class="legend" data-tip-en="{{ ROOM_EN }}" data-tip-zh="{{ ROOM_ZH }}"><span class="lg"></span>{{ t('room left', '剩余空间') }}</span>
    <span class="n">{{ hub.command|length }}</span></div>
  <div class="stance">{{ t('Most room left first. <b>Nothing here is an entry unless it carries ⚡.</b>',
                          '剩余空间最大者居前。<b>未带 ⚡ 者均非入场信号。</b>') }}</div>
  <div class="lst-wrap" data-ovl-title-en="Command — ranked by opportunity" data-ovl-title-zh="指挥榜 —— 按机会值排序" data-ovl-accent="var(--up)">
  <div class="led lst-collapse is-collapsed">
    {% for d in hub.command %}
    {% set acc = 'var(--info)' if d.stage=='emerging' else 'var(--down)' if d.stage in ['exhausted','distribution'] else 'var(--up)' if d.lean>0 else 'var(--info)' %}
    <div class="led-row">
      <span class="sp" style="--sp-c:{{ acc }};--sp-p:{{ ((d.edge_remaining or 0)*100)|round|int }}%"></span>
      <div class="id">
        <div class="tkline"><span class="tk">{{ d.ticker }}</span>{% if d.price is not none %}<span class="nb-px px" data-sym="{{ d.ticker }}" data-mkt="us">${{ '%.2f'|format(d.price) }}</span>{% endif %}</div>
        {% if d.name and d.name != d.ticker %}<div class="nm">{{ d.name|e }}</div>{% endif %}
      </div>
      <div><div class="score">{{ d.opportunity_score|round|int }}</div>
        <div class="rmv">{{ ((d.edge_remaining or 0)*100)|round|int }}%</div></div>
      <div class="mtxc">{{ matrix(d.directions, d.composite_conviction, d.n_confirm) }}</div>
      <div>
        <div class="cline">{{ stage(d.stage) }}{{ entrybadge(d.entry_gate) }}{{ tstate(d.trajectory) }}{{ flags(d.flags) }}
          {%- if d.leading_gap and d.leading_gap>0 %}<span class="chip info">{{ t('leads by','领先') }} +{{ d.leading_gap }}</span>{% endif %}</div>
        {{ drivers(d.edge_drivers) }}
        {% if d.falsifier %}<div class="watch">{{ t('Watching', '关注') }}: <b>{{ d.falsifier|e }}</b></div>{% endif %}
      </div>
    </div>{% endfor %}
  </div>
  <button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more','显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>
  </div>

  {# ── TRACK RECORD — one band: the plain read, then the study panel folded ── #}
  {% set TR = hub.track_record %}
  <div class="band" style="--accent:var(--ok)"><span class="tick"></span>
    <h2>{{ t('Track record', '历史战绩') }}</h2><span class="ln"></span>
    <span class="legend">{{ t('is the edge real?', '优势是否真实？') }}</span></div>
  {% if TR and TR.n_snapshots %}
  {% if not TR.any_matured %}
  <div class="card note">
    <b>{{ t('Measuring', '测量中') }}</b> — {{ t('every call this page makes is recorded and scored against what the stock actually did next.', '本页的每一次判断都会被记录，并以标的之后的实际走势评分。') }}
    <span class="f">{{ TR.n_snapshots }}</span> {{ t('recorded so far; the first scores land as the 5 / 10 / 21 / 63-day marks pass.', '条判断已记录；待 5 / 10 / 21 / 63 天周期走完即产出首批评分。') }}
  </div>
  {% else %}
  <div class="trh">
    {% for h, e in TR.horizons.items() %}{% if e.get('n_matured') %}
    {% set ic_v = e.get('opportunity_ic') if e.get('opportunity_ic') is not none else e.get('opportunity_ic_pooled') %}
    {% set ic_pooled = e.get('opportunity_ic') is none and e.get('opportunity_ic_pooled') is not none %}
    {% set stg = e.get('by_stage') or {} %}
    <div class="card trc">
      <div class="th"><span class="h">{{ h }}{{ t('d', '天') }}</span>
        {% if TR.proven.get(h) %}<span class="chip good" data-tip-en="Cleared the pre-registered significance bar at this horizon" data-tip-zh="该周期已通过预登记的显著性检验">{{ t('proven', '已验证') }}</span>
        {% else %}<span class="chip" data-tip-en="Still accruing scored calls at this horizon — shown, not yet trusted" data-tip-zh="该周期样本仍在累积 —— 仅展示，尚未采信">{{ t('measuring', '测量中') }}</span>{% endif %}</div>
      <div class="trg">
        <div class="trcell" data-tip-en="Does a higher rank from this page actually go with a better return {{ h }} trading days later, measured against SPY? Above zero = yes.{% if ic_pooled %} Thin sample here, so the value is pooled across horizons (~).{% endif %}" data-tip-zh="本页排名越高，{{ h }} 个交易日后相对标普的收益是否真的越好？大于零 = 是。{% if ic_pooled %}该周期样本较少，取跨周期合并值（~）。{% endif %}">
          <span class="trlab">{{ t('rank skill', '排名预测力') }}</span>
          <b class="trval {{ 'pos' if ic_v is not none and ic_v > 0 else 'neg' if ic_v is not none and ic_v < 0 else '' }}">{% if ic_v is not none %}{{ '%+.3f'|format(ic_v) }}{{ '~' if ic_pooled else '' }}{% else %}—{% endif %}</b>
        </div>
        <div class="trcell" data-tip-en="Calls that have reached this horizon and been scored" data-tip-zh="已到期并完成评分的判断数">
          <span class="trlab">{{ t('scored', '已评分') }}</span>
          <b class="trval">{{ '{:,}'.format(e.n_matured) }}</b>
        </div>
        {% if stg.get('emerging') %}{% set em = stg.emerging.mean_fwd_rel*100 %}
        <div class="trcell" data-tip-en="Average return against SPY for names this page tagged 'emerging'. A real edge shows up positive." data-tip-zh="被标记「萌芽」的标的相对标普的平均收益。真实优势应为正。">
          <span class="trlab">{{ t('emerging beat SPY?', '萌芽跑赢标普？') }}</span>
          <b class="trval">{{ '%+.1f'|format(em) }}%</b> <span class="trans {{ 'ok' if em > 0 else 'bad' }}">{{ t('yes','是') if em > 0 else t('no','否') }}</span>
        </div>{% endif %}
        {% if stg.get('exhausted') %}{% set exv = stg.exhausted.mean_fwd_rel*100 %}
        <div class="trcell" data-tip-en="Average return against SPY for names tagged 'exhausted'. These are fade calls, so the call worked when this is negative." data-tip-zh="被标记「透支」的标的相对标普的平均收益。此为看跌判断，因此为负时判断成立。">
          <span class="trlab">{{ t('exhausted lagged SPY?', '透支跑输标普？') }}</span>
          <b class="trval">{{ '%+.1f'|format(exv) }}%</b> <span class="trans {{ 'ok' if exv < 0 else 'bad' }}">{{ t('yes','是') if exv < 0 else t('no','否') }}</span>
        </div>{% endif %}
      </div>
    </div>{% endif %}{% endfor %}
  </div>
  {% endif %}
  {% endif %}

  {# UNIFIED FORWARD DESK GRADER — Tier-3 mechanics, shipped folded #}
  {{ dg.styles() }}
  {{ dg.panel(hub.desk_grader) }}

  {# ── sector heat ── #}
  {% if hub.sector_heat %}
  <div class="band" style="--accent:var(--orange)"><span class="tick"></span>
    <h2>{{ t('Sector heat', '板块热度') }}</h2><span class="ln"></span>
    <span class="legend">{{ t('where the desks cluster', '各台聚集之处') }}</span></div>
  <div class="card slist">
    {% for s in hub.sector_heat %}
    <div class="srow" style="--accent:{{ 'var(--up)' if s.net_lean>0 else 'var(--down)' if s.net_lean<0 else 'var(--info)' }}"
         data-tip-en="Average conviction across the {{ s.n }} name{{ 's' if s.n != 1 else '' }} the desks surfaced here: {{ s.mean_conviction }} of 100. The bars share one scale, so a longer bar is a hotter sector." data-tip-zh="各台在此板块入选的 {{ s.n }} 个标的平均信念度：{{ s.mean_conviction }} / 100。各条形共用同一标尺，越长表示越热。">
      <span class="etf">{{ s.etf }}</span>
      <span class="snm">{{ s.name|e }}{% if s.policy_tilt %}<span class="chip {{ 'good' if s.policy_tilt>0 else 'bad' }}">{{ t('policy', '政策') }} {{ '↑' if s.policy_tilt>0 else '↓' }}</span>{% endif %}</span>
      <span class="meter"><i style="width:{{ s.mean_conviction }}%"></i></span>
      <span class="sf"><span><b>{{ s.n }}</b> {{ t('names', '标的') }}</span>
        {% if s.early_edge %}<span style="color:var(--info)"><b>{{ s.early_edge }}</b> {{ t('early', '早期') }}</span>{% endif %}
        {% if s.crowded_top %}<span style="color:var(--warn)"><b>{{ s.crowded_top }}</b> {{ t('crowded', '拥挤') }}</span>{% endif %}</span>
    </div>{% endfor %}
  </div>
  {% endif %}

  <footer class="hf">
    {{ t('Built', '生成于') }} <time datetime="{{ built }}">{{ built[:16].replace('T',' ') }}</time> UTC ·
    {% if hub.n_universe %}{{ t('scanned', '扫描') }} <span class="f">{{ '{:,}'.format(hub.n_universe) }}</span> {{ t('names', '标的') }} · {% endif %}
    {{ hub.disclaimer|e }}
  </footer>
</div>
<script src="theme.js"></script>
{# intraday progressive enhancement: live (~15-min) prices on the surfaced names.
   No-ops if not configured/served — the slow-brain scores stay nightly. #}
</body>
</html>
