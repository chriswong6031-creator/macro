{% import "_desk_grader_panel.html.j2" as dg %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{#- inline SVG icons (Lucide-style, currentColor) -#}
{% macro ic(name) -%}
{% set P = {
  'command':  '<path d="M12 3v3m0 12v3m9-9h-3M6 12H3m13.5-6.5-2 2m-7 7-2 2m11 0-2-2m-7-7-2-2"/><circle cx="12" cy="12" r="3.2"/>',
  'news':     '<path d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2M7.5 8.5h6M7.5 12h6M7.5 15.5h4"/>',
  'alt':      '<path d="M3 21h18M5 21V9m5 12V5m5 16v-8m5 8V3"/>',
  'radar':    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12 19 7"/>',
  'board':    '<rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M8 14l2.5-3 2.5 2 3-4"/>',
  'policy':   '<path d="M3 21h18M5 21V10m4 11V10m6 11V10m4 11V10M12 3 3 8h18z"/>',
  'edge':     '<path d="m13 3-9 11h7l-1 7 9-11h-7z"/>',
  'warn':     '<path d="M12 3 2.5 20h19zM12 10v4m0 3v.5"/>',
  'sector':   '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2.1 5L8.5 15.5l2.1-5z"/>',
  'pulse':    '<path d="M3 12h4l2.5-7 4 14 2.5-7H21"/>',
  'cal':      '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3.5v3m8-3v3"/>'
} %}
<svg class="ic-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
  stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ P.get(name,'')|safe }}</svg>
{%- endmacro %}
{#- 5-desk agreement matrix: one dot per desk coloured by direction -#}
{% macro matrix(dirs) -%}
<span class="mtx" title="news · alt · radar · board · policy">
{%- for k in ['news','alt','radar','standout','policy'] -%}
{% set d = dirs.get(k) %}
<span class="cell {{ 'up' if d==1 else 'dn' if d==-1 else 'nz' if d==0 else 'off' }}"></span>
{%- endfor -%}
</span>
{%- endmacro %}
{#- lifecycle stage chip (the V2 headline read) -#}
{% set STAGE_ZH = {'emerging':'萌芽','early':'早期','consensus':'共识','exhausted':'透支','distribution':'派发','building':'酝酿','discovery':'发掘'} %}
{% macro stage(s) -%}
<span class="stage {{ s }}"><span class="l-en">{{ s }}</span><span class="l-zh">{{ STAGE_ZH.get(s, s) }}</span></span>
{%- endmacro %}
{#- edge-remaining bar (0..1 → % of the move still ahead) -#}
{% macro edgebar(e) -%}
<div class="edge"><span class="lab"><span class="l-en">edge left</span><span class="l-zh">剩余空间</span></span>
<span class="ebar"><i style="width:{{ ((e or 0)*100)|round|int }}%"></i></span>
<span class="ev">{{ ((e or 0)*100)|round|int }}%</span></div>
{%- endmacro %}
{#- ⚡ prime-entry badge — the owner's validated T1-T4 confluence verdict. i18n via the
    data-tip-en/zh popover pattern (NEVER translated text in a title= attribute). -#}
{% macro entrybadge(eg) -%}
{% if eg %}{% if eg.get('buyable') %}<span class="egate buy" data-tip-en="Validated confluence buy · tier {{ eg.get('tier') or '—' }}" data-tip-zh="已验证共振买入 · 层级 {{ eg.get('tier') or '—' }}">⚡ <span class="l-en">entry</span><span class="l-zh">入场</span>{% if eg.get('tier') %} {{ eg.tier }}{% endif %}</span>{% elif eg.get('flat_sell') %}<span class="egate no" data-tip-en="Not a confluence buy (flat/sell)" data-tip-zh="非共振买入（观望/卖出）"><span class="l-en">no entry</span><span class="l-zh">无入场</span></span>{% endif %}{% endif %}
{%- endmacro %}
{#- honest price-trajectory chips: off-high %, RS pp, rolling-over/basing state -#}
{% macro tchips(tr) -%}
{% if tr %}<div class="tchips">
{%- if tr.get('off_high_252') is not none %}<span class="tchip {{ 'bad' if tr.off_high_252 <= -0.15 else '' }}">{{ (tr.off_high_252*100)|round|int }}% <span class="l-en">off high</span><span class="l-zh">距高点</span></span>{% endif %}
{%- if tr.get('rs_vs_spy_60d') is not none %}<span class="tchip {{ 'good' if tr.rs_vs_spy_60d > 0 else 'bad' }}">{{ '%+d'|format(tr.rs_vs_spy_60d|round|int) }}pp <span class="l-en">RS 60d</span><span class="l-zh">相对强度</span></span>{% endif %}
{%- if tr.get('rolling_over') %}<span class="tchip bad"><span class="l-en">rolling over</span><span class="l-zh">见顶回落</span></span>{% elif tr.get('basing') %}<span class="tchip good"><span class="l-en">basing</span><span class="l-zh">筑底</span></span>{% endif %}
</div>{% endif %}
{%- endmacro %}
{#- qledger honesty chip macro (D10) -#}
{% macro ql_chip(chip) -%}
{% if chip %}<span class="ql-chip {{ chip.css_class }}"><span class="l-en">{{ chip.label }}</span><span class="l-zh">{{ chip.label_zh }}</span></span>{% else %}<span class="ql-chip ql-chip-ungraded"><span class="l-en">UNGRADED · n=0</span><span class="l-zh">未评级 · n=0</span></span>{% endif %}
{%- endmacro %}
{% set _ql = qledger_chips or {} %}
{% set MC = hub.macro_context or {} %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Intelligence Hub', '情报中心') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  body.page-hub{ margin:0; background:var(--bg); color:var(--text);
    font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
  #sky{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden;--cs:clamp(120px,13vw,214px)}
  @media(max-width:560px){ #sky{--cs:clamp(92px,26vw,124px)} }
  #sky-stars{position:absolute;inset:0;width:100%;height:100%;display:block}
  #sky-sun{position:absolute;width:var(--cs);height:var(--cs);border-radius:50%;
    transform:translate(-50%,calc(-50% + 80vh));opacity:0;
    transition:transform 1.7s cubic-bezier(.16,.78,.29,1),opacity 1.25s ease}
  #sky[data-sky="day"] #sky-sun{transform:translate(-50%,-50%);opacity:1}
  #sky-sun{background:radial-gradient(circle at 50% 50%,#fffdf7 0%,#fff2cc 20%,#ffd87f 40%,#ffb84d 58%,rgba(255,156,54,.34) 76%,transparent 84%);
    box-shadow:0 0 46px 6px rgba(255,226,150,.6),0 0 110px 28px rgba(255,192,92,.38),0 0 220px 86px rgba(255,170,68,.18)}
  .hub-wrap{ max-width:1240px; margin:0 auto; padding:10px 18px 72px; position:relative; z-index:1; }
  body.page-hub > .site-nav{ max-width:1240px; margin:14px auto 8px; padding:0 18px; }
  .ic-svg{ width:15px;height:15px;flex:none;vertical-align:middle; }
  /* hero */
  .hh{ margin:14px 0 8px; }
  .hh .eyebrow{ display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:500;color:var(--muted);
    padding:4px 12px;border-radius:999px;background:color-mix(in srgb,var(--panel) 70%,transparent);
    border:1px solid color-mix(in srgb,var(--line) 75%,transparent);backdrop-filter:blur(8px); }
  .hh .live{ width:7px;height:7px;border-radius:50%;background:var(--ok);position:relative; }
  .hh .live::after{ content:"";position:absolute;inset:-4px;border-radius:50%;border:1.5px solid var(--ok);opacity:.5;animation:hp 2.4s ease-out infinite; }
  @keyframes hp{0%{transform:scale(.6);opacity:.6}100%{transform:scale(1.7);opacity:0}}
  .hh h1{ font-size:clamp(30px,4.6vw,50px);font-weight:800;letter-spacing:-.022em;margin:11px 0 5px;
    background:linear-gradient(110deg,var(--text),color-mix(in srgb,var(--info) 65%,var(--text)) 60%,color-mix(in srgb,var(--text) 50%,transparent));
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
    text-shadow:0 1px 36px color-mix(in srgb,var(--info) 24%,transparent); }
  .hh p{ margin:0;color:var(--muted);max-width:720px;font-size:14.5px;line-height:1.5; }
  /* macro command bar */
  .cmdbar{ display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 4px; }
  .cmdbar .mc{ font-size:12px;font-weight:600;padding:6px 12px;border-radius:10px;display:inline-flex;gap:7px;align-items:center;
    background:color-mix(in srgb,var(--panel) 72%,transparent);border:1px solid color-mix(in srgb,var(--line) 75%,transparent); }
  .cmdbar .mc b{ color:var(--text);font-weight:700; } .cmdbar .mc span{ color:var(--muted); }
  .cmdbar .mc.hot{ border-color:color-mix(in srgb,var(--up) 50%,var(--line));color:var(--up); }
  .posture{ margin:8px 0 2px;font-size:13px;color:color-mix(in srgb,var(--text) 78%,transparent);
    padding:10px 14px;border-left:3px solid var(--info);border-radius:0 12px 12px 0;
    background:color-mix(in srgb,var(--info) 7%,transparent); }
  /* desk status board */
  .desks{ display:grid;gap:11px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin:16px 0 6px; }
  .desk{ padding:13px 14px;border-radius:14px;text-decoration:none;display:block;transition:.16s ease;
    background:color-mix(in srgb,var(--panel) 80%,transparent);border:1px solid color-mix(in srgb,var(--line) 80%,transparent); }
  .desk:hover{ transform:translateY(-3px);border-color:color-mix(in srgb,var(--info) 45%,var(--line)); }
  .desk .dh{ display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--text); }
  .desk .dh .dot{ width:7px;height:7px;border-radius:50%;margin-left:auto;background:var(--down); }
  .desk .dh .dot.on{ background:var(--ok);box-shadow:0 0 8px color-mix(in srgb,var(--ok) 70%,transparent); }
  .desk small{ display:block;margin-top:5px;color:var(--muted);font-size:11.5px; }
  /* band header */
  .band{ display:flex;align-items:center;gap:12px;margin:30px 0 13px; }
  .band h2{ font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:0;
    white-space:nowrap;display:flex;align-items:center;gap:7px; }
  .band h2 .ic-svg{ color:var(--accent,var(--info)); }
  .band .ln{ flex:1;height:1px;background:linear-gradient(90deg,var(--line),transparent); }
  .band .cnt{ font-size:11.5px;color:color-mix(in srgb,var(--text) 52%,transparent);white-space:nowrap; }
  /* glass */
  .glass{ background:color-mix(in srgb,var(--panel) 82%,transparent);border:1px solid color-mix(in srgb,var(--line) 82%,transparent);
    border-radius:15px;backdrop-filter:blur(13px) saturate(1.08);box-shadow:inset 0 1px 0 color-mix(in srgb,#fff 6%,transparent),0 8px 26px -18px rgba(0,0,0,.5); }
  .acc{ position:relative;overflow:hidden; }
  .acc::before{ content:"";position:absolute;top:0;left:0;right:0;height:2.5px;background:linear-gradient(90deg,var(--accent,var(--info)),transparent 78%);opacity:.85; }
  /* alert cards */
  .alerts{ display:grid;gap:13px;grid-template-columns:1fr 1fr; }
  @media(max-width:760px){ .alerts{ grid-template-columns:1fr; } }
  .alert{ padding:14px 15px; }
  .alert h3{ font-size:13px;font-weight:700;margin:0 0 10px;display:flex;align-items:center;gap:8px; }
  .alert h3 .ic-svg{ width:16px;height:16px; }
  .alert .arow{ display:flex;align-items:center;gap:9px;padding:8px 0;border-top:1px solid color-mix(in srgb,var(--line) 55%,transparent); }
  .alert .arow:first-of-type{ border-top:0; }
  .alert .tk{ font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:12.5px;min-width:52px; }
  .alert .rd{ font-size:12px;color:color-mix(in srgb,var(--text) 70%,transparent);line-height:1.35; }
  /* command list */
  .cmd{ display:flex;flex-direction:column;gap:8px; }
  .row{ display:grid;grid-template-columns:122px 52px 86px 1fr;gap:12px;align-items:center;padding:11px 14px; }
  @media(max-width:760px){ .row{ grid-template-columns:92px 46px 1fr;gap:9px; } .row .conv{ display:none; } }
  .row .id .tk{ font-family:ui-monospace,Menlo,monospace;font-weight:800;font-size:14px; }
  .row .id .nm{ font-size:10.5px;color:var(--muted);display:block;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px; }
  .convbar{ position:relative;height:7px;border-radius:99px;background:color-mix(in srgb,var(--line) 60%,transparent);overflow:hidden; }
  .convbar i{ position:absolute;inset:0 auto 0 0;border-radius:99px;background:linear-gradient(90deg,var(--info),var(--up)); }
  .convbar.dn i{ background:linear-gradient(90deg,var(--warn),var(--down)); }
  .convn{ font-size:11px;color:var(--muted);margin-top:3px;text-align:right; }
  .conf{ font-size:11px;font-weight:700;text-align:center;color:var(--muted); }
  .conf b{ font-size:15px;color:var(--text);display:block; }
  .rd2{ font-size:12.5px;color:color-mix(in srgb,var(--text) 76%,transparent);line-height:1.4; }
  .flags{ display:flex;gap:5px;flex-wrap:wrap;margin-top:5px; }
  .fl{ font-size:9.5px;font-weight:700;letter-spacing:.02em;padding:1px 7px;border-radius:6px;text-transform:uppercase;
    background:color-mix(in srgb,var(--text) 9%,transparent);color:var(--muted); }
  .fl.edge,.fl.stealth{ background:color-mix(in srgb,var(--info) 22%,transparent);color:var(--info); }
  .fl.crowd{ background:color-mix(in srgb,var(--warn) 24%,transparent);color:var(--warn); }
  .fl.conf{ background:color-mix(in srgb,var(--up) 20%,transparent);color:var(--up); }
  .fl.fade,.fl.conflict{ background:color-mix(in srgb,var(--down) 20%,transparent);color:var(--down); }
  .fl.pol{ background:color-mix(in srgb,#8b5cf6 22%,transparent);color:#a78bfa; }
  .fl.iso{ background:color-mix(in srgb,var(--orange,var(--warn)) 18%,transparent);color:var(--orange,var(--warn)); }
  .peers{ font-size:9.5px;font-weight:600;color:color-mix(in srgb,var(--text) 50%,transparent);
    font-family:ui-monospace,Menlo,monospace;padding:1px 4px; }
  /* agreement matrix */
  .mtx{ display:inline-flex;gap:3px;align-items:center; }
  .mtx .cell{ width:9px;height:14px;border-radius:3px;background:color-mix(in srgb,var(--line) 70%,transparent); }
  .mtx .cell.up{ background:var(--up); } .mtx .cell.dn{ background:var(--down); }
  .mtx .cell.nz{ background:color-mix(in srgb,var(--muted) 60%,transparent); }
  .mtx .cell.off{ background:color-mix(in srgb,var(--line) 45%,transparent);opacity:.5; }
  .fal{ font-size:10.5px;color:color-mix(in srgb,var(--text) 50%,transparent);margin-top:4px; }
  .fal b{ color:color-mix(in srgb,var(--down) 80%,var(--text));font-weight:600; }
  /* sector heat */
  .heat{ display:grid;gap:9px;grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); }
  .sec{ padding:11px 13px; }
  .sec .sh{ display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700; }
  .sec .etf{ font-family:ui-monospace,Menlo,monospace;font-size:10px;padding:1px 6px;border-radius:6px;
    background:color-mix(in srgb,var(--info) 16%,transparent);color:var(--info); }
  .sec .pol{ margin-left:auto;font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:6px; }
  .sec .pol.up{ background:color-mix(in srgb,var(--up) 20%,transparent);color:var(--up); }
  .sec .pol.dn{ background:color-mix(in srgb,var(--down) 20%,transparent);color:var(--down); }
  .sec .meter{ height:6px;border-radius:99px;margin:8px 0 6px;background:color-mix(in srgb,var(--line) 60%,transparent);overflow:hidden; }
  .sec .meter i{ display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--info),var(--up)); }
  .sec small{ font-size:10.5px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap; }
  .sec small b{ color:var(--text); }
  .disc{ font-size:11px;color:color-mix(in srgb,var(--text) 48%,transparent);margin-top:14px;line-height:1.5; }
  .empty{ font-size:12.5px;color:var(--muted);padding:9px 0; }
  /* ── V2: lifecycle stage chip + edge-remaining + opportunity ── */
  .stage{ font-size:9.5px;font-weight:800;letter-spacing:.03em;text-transform:uppercase;padding:2px 7px;border-radius:6px;white-space:nowrap; }
  .stage.emerging{ background:color-mix(in srgb,var(--info) 26%,transparent);color:var(--info);box-shadow:0 0 0 1px color-mix(in srgb,var(--info) 35%,transparent) inset; }
  .stage.early{ background:color-mix(in srgb,var(--up) 20%,transparent);color:var(--up); }
  .stage.consensus{ background:color-mix(in srgb,var(--muted) 22%,transparent);color:var(--muted); }
  .stage.exhausted{ background:color-mix(in srgb,var(--down) 20%,transparent);color:var(--down); }
  .stage.distribution{ background:color-mix(in srgb,var(--down) 16%,transparent);color:var(--down); }
  .stage.faltering{ background:color-mix(in srgb,var(--warn) 22%,transparent);color:var(--warn);box-shadow:0 0 0 1px color-mix(in srgb,var(--warn) 30%,transparent) inset; }
  .stage.discovery{ background:color-mix(in srgb,var(--info) 24%,transparent);color:var(--info);box-shadow:0 0 0 1px color-mix(in srgb,var(--info) 35%,transparent) inset; }
  .stage.building{ background:color-mix(in srgb,var(--text) 10%,transparent);color:var(--muted); }
  /* ⚡ prime-entry badge (validated T1-T4 confluence) + honest price chips */
  .egate{ display:inline-flex;align-items:center;gap:3px;font-size:9px;font-weight:800;letter-spacing:.03em;
    padding:2px 6px;border-radius:6px;white-space:nowrap;cursor:default; }
  .egate.buy{ background:color-mix(in srgb,var(--up) 24%,transparent);color:var(--up);box-shadow:0 0 0 1px color-mix(in srgb,var(--up) 40%,transparent) inset; }
  .egate.no{ background:color-mix(in srgb,var(--muted) 16%,transparent);color:var(--muted); }
  .tchips{ display:flex;flex-wrap:wrap;gap:5px;margin-top:5px; }
  .tchip{ font-size:9px;font-weight:700;padding:1.5px 6px;border-radius:5px;white-space:nowrap;
    background:color-mix(in srgb,var(--line) 55%,transparent);color:color-mix(in srgb,var(--text) 70%,transparent); }
  .tchip.bad{ background:color-mix(in srgb,var(--down) 16%,transparent);color:var(--down); }
  .tchip.good{ background:color-mix(in srgb,var(--up) 16%,transparent);color:var(--up); }
  /* discovery cards */
  .dcard .et .src{ font-size:8.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:2px 6px;border-radius:5px;
    background:color-mix(in srgb,var(--info) 16%,transparent);color:var(--info); }
  .dcard .off{ font-size:8.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:2px 6px;border-radius:5px;
    background:color-mix(in srgb,var(--up) 18%,transparent);color:var(--up);margin-left:4px; }
  .dcard .dscore{ margin-left:auto;font-size:15px;font-weight:800;color:var(--info); }
  .dcard .dchan{ font-size:10.5px;color:color-mix(in srgb,var(--text) 64%,transparent);line-height:1.4;margin-top:5px; }
  .opp{ display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:46px; }
  .opp b{ font-size:19px;font-weight:800;line-height:1;letter-spacing:-.02em;
    background:linear-gradient(120deg,var(--info),var(--up));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent; }
  .opp small{ font-size:8.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-top:2px; }
  .edge{ display:flex;align-items:center;gap:7px;margin-top:5px; }
  .edge .lab{ font-size:9.5px;color:var(--muted);white-space:nowrap;text-transform:uppercase;letter-spacing:.03em; }
  .edge .ebar{ position:relative;flex:1;height:5px;border-radius:99px;background:color-mix(in srgb,var(--line) 60%,transparent);overflow:hidden;max-width:120px; }
  .edge .ebar i{ position:absolute;inset:0 auto 0 0;border-radius:99px;background:linear-gradient(90deg,var(--warn),var(--up)); }
  .edge .ev{ font-size:9.5px;font-weight:700;color:color-mix(in srgb,var(--text) 70%,transparent);min-width:26px; }
  .drv{ font-size:10px;color:color-mix(in srgb,var(--text) 55%,transparent);margin-top:3px;line-height:1.3; }
  .drv b{ color:color-mix(in srgb,var(--up) 80%,var(--text));font-weight:600; }
  /* emerging hero cards */
  .ecards{ display:grid;gap:11px;grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); }
  .ecard{ padding:13px 14px;position:relative; }
  .ecard .et{ display:flex;align-items:center;gap:8px;margin-bottom:3px; }
  .ecard .et .tk{ font-family:ui-monospace,Menlo,monospace;font-weight:800;font-size:15px; }
  .ecard .et .nm{ font-size:10px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
  .ecard .et .oppn{ margin-left:auto;font-size:17px;font-weight:800;
    background:linear-gradient(120deg,var(--info),var(--up));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent; }
  .ecard .erd{ font-size:11.5px;color:color-mix(in srgb,var(--text) 74%,transparent);line-height:1.4;margin:6px 0 2px; }
  /* catalyst rows */
  .cats{ display:grid;gap:8px;grid-template-columns:1fr 1fr; }
  @media(max-width:760px){ .cats{ grid-template-columns:1fr; } }
  .catrow{ display:flex;align-items:flex-start;gap:9px;padding:9px 12px; }
  .catrow .tk{ font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:12.5px;min-width:50px; }
  .catrow .cb{ font-size:11px;color:color-mix(in srgb,var(--text) 68%,transparent);line-height:1.35; }
  .catrow .ct{ font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.03em;padding:2px 7px;border-radius:6px;white-space:nowrap;
    background:color-mix(in srgb,#8b5cf6 20%,transparent);color:#a78bfa; }
  .catrow .age{ font-size:9.5px;color:var(--muted);white-space:nowrap;margin-left:auto; }
  /* live price chip (patched intraday by live.js) */
  .nb-px{ font-family:ui-monospace,Menlo,monospace;font-size:10.5px;font-weight:700;
    color:color-mix(in srgb,var(--text) 72%,transparent);white-space:nowrap; }
  .ecard .et .nb-px, .dcard .et .nb-px{ margin-left:2px; }
  footer.hf{ margin-top:30px;padding-top:16px;border-top:1px solid color-mix(in srgb,var(--line) 70%,transparent);font-size:11px;color:var(--muted);line-height:1.6; }
  @media (prefers-reduced-motion:reduce){ .desk,.row{transition:none} .hh .live::after{animation:none} }
  /* qledger honesty chips (D10) */
  .ql-chip { display:inline-flex; align-items:center; font:700 9px/1 ui-monospace,Menlo,monospace;
    letter-spacing:.05em; text-transform:uppercase; padding:2px 7px; border-radius:6px;
    border:1px solid; white-space:nowrap; vertical-align:middle; min-width:0; flex-shrink:0; }
  .ql-chip-ungraded { background:color-mix(in srgb,var(--muted) 12%,transparent);
    color:var(--muted); border-color:color-mix(in srgb,var(--muted) 28%,transparent); }
  .ql-chip-accruing { background:color-mix(in srgb,var(--warn) 14%,transparent);
    color:var(--warn); border-color:color-mix(in srgb,var(--warn) 35%,transparent); }
  .ql-chip-graded-pos { background:color-mix(in srgb,var(--up) 14%,transparent);
    color:var(--up); border-color:color-mix(in srgb,var(--up) 35%,transparent); }
  .ql-chip-graded-neg { background:color-mix(in srgb,var(--down) 14%,transparent);
    color:var(--down); border-color:color-mix(in srgb,var(--down) 35%,transparent); }
  .desk-chips { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:5px; }
  /* China Lens module (W0.2) */
  .cl-badge{ font-size:9px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;
    padding:2px 7px;border-radius:5px;
    background:color-mix(in srgb,#f59e0b 18%,transparent);color:#f59e0b;margin-left:7px; }
  .cl-wrap{ margin-top:0; }
  .cl-headline{ font-size:13.5px;font-weight:600;color:var(--text);margin-bottom:10px;line-height:1.4; }
  .cl-chips{ display:flex;flex-wrap:wrap;gap:7px;margin-bottom:12px; }
  .cl-chip{ font-size:11.5px;font-weight:600;padding:5px 11px;border-radius:9px;cursor:default;
    background:color-mix(in srgb,var(--panel) 78%,transparent);
    border:1px solid color-mix(in srgb,var(--line) 75%,transparent); }
  .cl-chip-stale{ border-color:color-mix(in srgb,var(--warn) 45%,var(--line));
    color:var(--warn); }
  .cl-rows{ display:flex;flex-direction:column;gap:9px;margin-bottom:12px; }
  .cl-row{ display:flex;align-items:center;gap:10px;padding:9px 0;
    border-top:1px solid color-mix(in srgb,var(--line) 50%,transparent); }
  .cl-row:first-child{ border-top:0; }
  .cl-sector{ font-size:13px;font-weight:700;min-width:120px; }
  @media(max-width:560px){ .cl-sector{ min-width:80px;font-size:12px; } }
  .cl-fresh{ display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:10px;margin-bottom:10px; }
  .cl-fresh-label{ font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em; }
  .cl-dot{ font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:5px;cursor:default;
    text-transform:uppercase;letter-spacing:.03em; }
  .cl-dot-ok{ background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok); }
  .cl-dot-stale{ background:color-mix(in srgb,var(--down) 16%,transparent);color:var(--down); }
  .cl-footer{ margin-top:10px;padding-top:8px;
    border-top:1px solid color-mix(in srgb,var(--line) 50%,transparent); }
  .cl-link{ font-size:12px;font-weight:600;color:var(--info);text-decoration:none; }
  .cl-link:hover{ text-decoration:underline; }
</style>
</head>
<body class="page-hub">
<div id="sky" aria-hidden="true"><canvas id="sky-stars"></canvas><div id="sky-sun"></div></div>
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search"><span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search" placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div></div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language"><span class="pill"></span><span class="opt en-opt" data-l="en">EN</span><span class="opt zh-opt" data-l="zh">中文</span></div>
  </div>
</nav>

<div class="hub-wrap">
  <header class="hh">
    <span class="eyebrow"><span class="live"></span>{{ t('Central command · five desks fused', '中枢指挥 · 五台融合') }}
      {%- if built %} · <time datetime="{{ built }}">{{ built[:10] }}</time>{% endif %}</span>
    <h1>{{ t('Intelligence Hub', '情报中心') }}</h1>
    <p>{{ t('Ranked by EDGE REMAINING — genuine signal × how much of the move is still ahead × a leading desk firing before the crowd — not by how many desks agree (agreement is a lagging, consensus condition). The hero is what is EMERGING: a leading desk positioning into a quiet tape with room to run. The crowd-favourite that has already run is demoted on purpose. Context only, never a trade trigger.',
            '按「剩余空间」排序 —— 真实信号 × 行情尚未走完的幅度 × 领先信号台抢在人群之前发动 —— 而非看多少台一致（一致性是滞后的共识状态）。主推「萌芽」机会：领先信号台在安静的盘面中悄悄建仓、仍有上行空间。已经跑完的人群宠儿被刻意下调。仅供参考，绝非交易触发。') }}</p>
  </header>

  {# ── macro command frame ── #}
  <div class="cmdbar">
    {% if MC.regime %}<span class="mc hot"><b>{{ MC.regime }}</b>{% if MC.quad %} <span>{{ MC.quad }}</span>{% endif %}</span>{% endif %}
    {% if MC.cycle %}<span class="mc">{{ t('Cycle', '周期') }} <b>{{ MC.cycle }}</b></span>{% endif %}
    {% if MC.liquidity %}<span class="mc">{{ t('Liquidity', '流动性') }} <b>{{ MC.liquidity }}</b></span>{% endif %}
    {% if MC.fed_stance %}<span class="mc">{{ t('Fed', '美联储') }} <b>{{ MC.fed_stance }}</b></span>{% endif %}
    {% if hub.n_emerging %}<span class="mc hot">{{ t('Emerging', '萌芽') }} <b>{{ hub.n_emerging }}</b></span>{% endif %}
    {% if hub.n_discovery %}<span class="mc hot" style="border-color:color-mix(in srgb,var(--info) 50%,var(--line));color:var(--info)">{{ t('Discovery', '发掘') }} <b>{{ hub.n_discovery }}</b></span>{% endif %}
    {% if hub.counts and hub.counts.catalyst %}<span class="mc">{{ t('Catalysts', '催化') }} <b>{{ hub.counts.catalyst }}</b></span>{% endif %}
    {% if hub.n_actionable %}<span class="mc">{{ t('Actionable', '可操作') }} <b>{{ hub.n_actionable }}</b></span>{% endif %}
    {% if hub.n_universe %}<span class="mc">{{ t('Universe', '覆盖') }} <b>{{ hub.n_universe }}</b></span>{% endif %}
  </div>
  {% if MC.posture %}<div class="posture">{{ ic('command') }} {{ MC.posture }}</div>{% endif %}

  {# ── desk status board ── #}
  <div class="desks">
    {% set DK = [('news','News','news.html','News flow · the tape'),
                 ('alt_data','Alt-Data','alt_data.html','Smart-money signal'),
                 ('radar','Divergence Radar','radar.html','Activity vs price'),
                 ('standout','Buy-Board','us_stocks.html','Factor standouts'),
                 ('policy','Policy Watch','policy_watch.html','Realpolitik intent'),
                 ('special','Special Sits','special_situations.html','Dated catalysts')] %}
    {% set DICON = {'news':'news','alt_data':'alt','radar':'radar','standout':'board','policy':'policy','special':'cal'} %}
    {% for key,label,href,desc in DK %}{% set live = (hub.desks.get(key) or {}).get('live') %}
    <a class="desk" href="{{ href }}">
      <div class="dh">{{ ic(DICON.get(key,'command')) }} {{ label }}<span class="dot {{ 'on' if live else '' }}"></span></div>
      <small>{{ desc }}{% if not live %} · {{ t('offline', '离线') }}{% endif %}</small>
      <div class="desk-chips">{{ ql_chip(_ql.get(key)) }}</div>
    </a>{% endfor %}
  </div>

  {# ── CHINA LENS (W0.2) — context-only, reads china_intel/briefing.json packet ── #}
  {# Module is omitted entirely if china packet is None (briefing absent/stale). #}
  {% if china %}
  {# Freshness: briefing.json is built at 08:30 UTC (asia lane) while the hub builds at 02:00 UTC.
     The briefing is typically ~18h old at hub build time — surface age honestly. #}
  <div id="china-lens" class="band"><h2 style="--accent:#f59e0b">{{ ic('sector') }}
    {{ t('China Lens', '中国观察') }}
    <span class="cl-badge">{{ t('Context only', '上下文') }}</span></h2>
    <span class="ln"></span>
    {% if china.asof_age_days is not none %}
    <span class="cnt" data-tip-en="briefing.json is built in the asia lane (~08:30 UTC); hub builds at 02:00 UTC — typical lag ~18h" data-tip-zh="简报在亚洲收盘后生成（约北京时间16:30），与情报中枢更新时差约18小时">
      {{ t('as of', '截至') }} {{ china.as_of }}
      {% if china.asof_age_days == 0 %}{{ t('(today)', '（今日）') }}
      {% elif china.asof_age_days == 1 %}{{ t('(1d ago)', '（1天前）') }}
      {% else %}{{ t('(' ~ china.asof_age_days ~ 'd ago)', '（' ~ china.asof_age_days ~ '天前）') }}{% endif %}
    </span>
    {% endif %}
  </div>
  <div class="glass acc cl-wrap" style="--accent:#f59e0b;padding:14px 16px">
    {# Headline row — derived mechanically from what_changed / top conviction #}
    <div class="cl-headline">{{ china.headline }}</div>

    {# Chips row: RORO band, PBoC stance, news band #}
    <div class="cl-chips">
      {% set rg = china.regime or {} %}
      {% set po = china.policy or {} %}
      {% set nw = china.news or {} %}
      {% if rg.band_en %}
      <span class="cl-chip"
        data-tip-en="RORO state: {{ rg.roro_state or '—' }}"
        data-tip-zh="风险偏好状态：{{ rg.roro_state or '—' }}">
        <span class="l-en">CN Sentiment: {{ rg.band_en }}</span>
        <span class="l-zh">CN情绪：{{ rg.band_zh or rg.band_en }}</span>
      </span>
      {% endif %}
      {% if po.stance_label_en %}
      <span class="cl-chip {{ 'cl-chip-stale' if po.stale else '' }}"
        data-tip-en="PBoC stance{{ ' (data may be stale)' if po.stale else '' }}"
        data-tip-zh="央行立场{{ '（数据可能较旧）' if po.stale else '' }}">
        <span class="l-en">PBoC: {{ po.stance_label_en }}</span>
        <span class="l-zh">央行：{{ po.stance_label_zh or po.stance_label_en }}</span>
      </span>
      {% endif %}
      {% if nw.band_label_en %}
      <span class="cl-chip"
        data-tip-en="China news sentiment band"
        data-tip-zh="中国新闻情绪区间">
        <span class="l-en">News: {{ nw.band_label_en }}</span>
        <span class="l-zh">新闻：{{ nw.band_label_zh or nw.band_label_en }}</span>
      </span>
      {% endif %}
      {% if china.flagged_ticker_count %}
      <span class="cl-chip"
        data-tip-en="{{ china.flagged_ticker_count }} flagged tickers — see china_intel.html for detail"
        data-tip-zh="{{ china.flagged_ticker_count }} 只关注标的 — 详情见中国情报页">
        {{ china.flagged_ticker_count }} <span class="l-en">flagged tickers</span><span class="l-zh">关注标的</span>
      </span>
      {% endif %}
    </div>

    {# Top-2 conviction rows — reuse existing stage() / edgebar() macros #}
    {% if china.conviction %}
    <div class="cl-rows">
      {% for row in china.conviction %}
      <div class="cl-row">
        <div class="cl-sector">
          <span class="l-en">{{ row.sector_en }}</span><span class="l-zh">{{ row.sector_zh or row.sector_en }}</span>
        </div>
        {{ stage(row.stage) }}
        {% if row.edge_remaining is not none %}{{ edgebar(row.edge_remaining) }}{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {# Surface freshness dots — one dot per surface, stale = red #}
    {% if china.surfaces %}
    <div class="cl-fresh">
      <span class="cl-fresh-label">{{ t('surfaces:', '数据面：') }}</span>
      {% for sname, sinfo in china.surfaces.items() %}
      <span class="cl-dot {{ 'cl-dot-stale' if sinfo.stale else 'cl-dot-ok' }}"
        data-tip-en="{{ sname }}: {{ sinfo.asof }}{{ ' (stale >3d)' if sinfo.stale else '' }}"
        data-tip-zh="{{ sname }}：{{ sinfo.asof }}{{ '（数据偏旧，超过3天）' if sinfo.stale else '' }}">{{ sname }}</span>
      {% endfor %}
    </div>
    {% endif %}

    {# Footer link to china_intel.html #}
    <div class="cl-footer">
      <a href="{{ china.links.detail }}" class="cl-link">
        {{ t('Full China report →', '查看中国完整报告 →') }}
      </a>
    </div>
  </div>
  {# END CHINA LENS #}
  {% endif %}

  {# ── EMERGING EDGE — the pre-consensus hero (highest value) ── #}
  {% set EM = hub.emerging or [] %}{% set EX = hub.exhausted or [] %}{% set CA = hub.catalysts or [] %}
  <div class="band"><h2 style="--accent:var(--info)">{{ ic('edge') }} {{ t('Emerging edge — before the crowd', '萌芽优势 —— 抢在人群之前') }}</h2><span class="ln"></span>
    <span class="cnt">{{ t('a leading desk firing into a quiet tape, with room to run', '领先信号台在安静盘面发动，仍有上行空间') }}</span></div>
  {% if EM %}
  <div class="ecards">
    {% for d in EM %}
    <div class="glass acc ecard" style="--accent:{{ 'var(--info)' if d.stage=='emerging' else 'var(--up)' }}">
      <div class="et"><span class="tk">{{ d.ticker }}</span>{% if d.price is not none %}<span class="nb-px" data-sym="{{ d.ticker }}" data-mkt="us">${{ '%.2f'|format(d.price) }}</span>{% endif %}{{ stage(d.stage) }}{{ entrybadge(d.entry_gate) }}
        <span class="oppn">{{ d.opportunity_score|round|int }}</span></div>
      <div class="nm" style="font-size:10.5px;color:var(--muted)">{{ d.name }}</div>
      <div class="erd">{{ d.read }}</div>
      {{ edgebar(d.edge_remaining) }}
      {{ tchips(d.trajectory) }}
      {% if d.edge_drivers %}<div class="drv">{% for dr in d.edge_drivers %}{% if dr.startswith('⚠') %}<span style="color:var(--warn)">{{ dr }}</span>{% else %}<b>{{ dr }}</b>{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
      {% if d.catalyst and d.catalyst.live %}<div class="drv">{{ ic('cal') }} {{ d.catalyst.category }}{% if d.catalyst.days_since is not none %} · {{ d.catalyst.days_since }}{{ t('d ago','天前') }}{% endif %}</div>{% endif %}
    </div>{% endfor %}
  </div>
  {% else %}<div class="empty">{{ t('No emerging pre-consensus setups today — the tape is led by names that have already moved.', '今日无萌芽期的领先机会 —— 盘面由已经发动的标的主导。') }}</div>{% endif %}

  {# ── DISCOVERY — off-desk / ignored leading signals (needles in the haystack) ── #}
  {% if hub.discovery %}
  <div class="band"><h2 style="--accent:var(--info)">{{ ic('radar') }} {{ t('Discovery — what the desks miss', '发掘 —— 各台遗漏之处') }}</h2><span class="ln"></span>
    <span class="cnt">{{ t('a leading signal the five desks dropped or never read', '五台丢弃或从未读取的领先信号') }}</span></div>
  <div class="ecards">
    {% for d in hub.discovery %}{% set dd = d.discovery or {} %}
    <div class="glass acc ecard dcard" style="--accent:var(--info)">
      <div class="et"><span class="tk">{{ d.ticker }}</span>{% if d.price is not none %}<span class="nb-px" data-sym="{{ d.ticker }}" data-mkt="us">${{ '%.2f'|format(d.price) }}</span>{% endif %}
        <span class="src">{{ (dd.source or '')|replace('_',' ') }}</span>
        {% if dd.off_desk %}<span class="off">{{ t('off-desk','非台内') }}</span>{% endif %}
        <span class="dscore">{{ ((dd.disc_score or 0)*100)|round|int }}</span></div>
      <div class="erd">{{ dd.reason }}</div>
      {% if dd.channels %}<div class="dchan">{{ ic('pulse') }} {{ dd.channels|join(' · ') }}</div>{% endif %}
      <div class="drv" style="margin-top:6px">{{ stage(d.stage) }}
        <span style="color:var(--muted)">· {{ t('surfaced into the command list','已上榜可见') if d.stage != 'discovery' else t('not yet on any desk','尚未进入任何信号台') }}</span></div>
    </div>{% endfor %}
  </div>
  {% endif %}

  {# ── exhausted (fade) + live catalysts ── #}
  <div class="alerts" style="margin-top:18px">
    <div class="glass acc alert" style="--accent:var(--down)">
      <h3>{{ ic('warn') }} {{ t('Exhausted — already run, fade-risk', '透支 —— 已跑完，派发风险') }} <span class="cnt">{{ EX|length }}</span></h3>
      {% if EX %}{% for d in EX[:8] %}<div class="arow">
        <span class="tk">{{ d.ticker }}</span>
        <span class="rd">{{ stage(d.stage) }} <b style="color:var(--down)">{{ (d.edge_remaining*100)|round|int }}%</b> {{ t('edge left','剩余') }} · {{ d.read }}</span></div>{% endfor %}
      {% else %}<div class="empty">{{ t('Nothing flagged exhausted today.', '今日无透支标的。') }}</div>{% endif %}
    </div>
    <div class="glass acc alert" style="--accent:#a78bfa">
      <h3>{{ ic('cal') }} {{ t('Live catalysts — dated events', '在途催化 —— 有确定日期的事件') }} <span class="cnt">{{ CA|length }}</span></h3>
      {% if CA %}{% for d in CA[:8] %}{% set c = d.catalyst or {} %}<div class="arow">
        <span class="tk">{{ d.ticker }}</span>
        <span class="rd"><span class="ct" style="font-size:9px;padding:1px 6px;border-radius:5px;background:color-mix(in srgb,#8b5cf6 18%,transparent);color:#a78bfa">{{ c.category }}</span>
          {%- if c.days_since is not none %} <span style="color:var(--muted)">{{ c.days_since }}{{ t('d ago','天前') }}</span>{% endif %}
          {%- if c.brief %}<br>{{ c.brief|truncate(120) }}{% endif %}</span></div>{% endfor %}
      {% else %}<div class="empty">{{ t('No fresh dated catalysts in-universe.', '覆盖范围内暂无新催化事件。') }}</div>{% endif %}
    </div>
  </div>

  {# ── command list (ranked by OPPORTUNITY = edge remaining × signal) ── #}
  <div class="band"><h2 style="--accent:var(--up)">{{ ic('command') }} {{ t('Command — ranked by opportunity', '指挥榜 —— 按机会值排序') }}</h2><span class="ln"></span>
    <span class="cnt">{{ t('edge remaining × signal × leading gap', '剩余空间 × 信号 × 领先差') }}</span></div>
  <div class="cmd">
    {% for d in hub.command %}
    <div class="glass acc row" style="--accent:{{ 'var(--info)' if d.stage=='emerging' else 'var(--up)' if d.lean>0 else 'var(--down)' if d.lean<0 else 'var(--info)' }}">
      <div class="id"><span class="tk">{{ d.ticker }}</span>{% if d.price is not none %}<span class="nb-px" data-sym="{{ d.ticker }}" data-mkt="us">${{ '%.2f'|format(d.price) }}</span>{% endif %}<span class="nm">{{ d.name }}</span>{{ matrix(d.directions) }}</div>
      <div class="opp"><b>{{ d.opportunity_score|round|int }}</b><small>{{ t('opp','机会') }}</small></div>
      <div class="conv">
        <div class="convbar {{ 'dn' if d.lean<0 else '' }}"><i style="width:{{ d.composite_conviction }}%"></i></div>
        <div class="convn">{{ t('conv','信念') }} {{ d.composite_conviction|round|int }} · {{ d.n_confirm }}{{ t('d','台') }}</div>
      </div>
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px">{{ stage(d.stage) }}{{ entrybadge(d.entry_gate) }}
          {% if d.leading_gap and d.leading_gap>0 %}<span style="font-size:9.5px;color:var(--info);font-weight:700">{{ t('leads crowd by','领先') }} +{{ d.leading_gap }}</span>{% endif %}</div>
        <div class="rd2">{{ d.read }}</div>
        {{ edgebar(d.edge_remaining) }}
        {{ tchips(d.trajectory) }}
        <div class="flags">{% for f in d.flags %}{% if f not in ['emerging'] %}<span class="fl {{ 'edge' if f in ['early_edge','discovery'] else 'stealth' if f=='stealth_accumulation' else 'crowd' if f=='crowded_top' else 'conf' if f in ['confirmed_trend','theme_wide'] else 'fade' if f=='fading' else 'conflict' if f=='policy_conflict' else 'pol' if f in ['policy_aligned','catalyst'] else 'iso' if f=='isolated' else '' }}">{{ f.replace('_',' ') }}</span>{% endif %}{% endfor %}
          {%- if d.peers %}<span class="peers" title="basket peers also confirming">+{{ d.peer_confirm }} {{ t('peers', '同伴') }}: {{ d.peers|join(' ') }}</span>{% endif %}</div>
        {% if d.falsifier %}<div class="fal">{{ t('Falsifier', '证伪点') }}: <b>{{ d.falsifier }}</b></div>{% endif %}
      </div>
    </div>{% endfor %}
  </div>

  {# ── SIGNAL SCORECARD — the falsifiable track-record (measure, don't assert) ── #}
  {% set TR = hub.track_record %}
  {% if TR and TR.n_snapshots %}
  <div class="band"><h2 style="--accent:var(--ok)">{{ ic('pulse') }} {{ t('Signal scorecard — is the edge real?', '信号记分卡 —— 优势是否真实？') }}</h2><span class="ln"></span>
    <span class="cnt">{{ t('the hub graded against realized forward returns', '以实际前瞻收益检验本台') }}</span></div>
  {% if not TR.any_matured %}
  <div class="glass acc" style="padding:13px 16px;font-size:12.5px;color:color-mix(in srgb,var(--text) 80%,transparent);line-height:1.5">
    {{ ic('cal') }} <b>{{ t('Measuring', '测量中') }}</b> — {{ t('the hub records every claim it makes (opportunity rank + lifecycle stage) and grades it against realized SPY-relative forward returns.', '本台记录每一次判断（机会排名 + 生命周期阶段），并以实际相对SPY的前瞻收益评分。') }}
    <b>{{ TR.n_snapshots }}</b> {{ t('claims recorded; grading begins as the 5 / 10 / 21 / 63-day horizons elapse. Until a signal clears a Newey-West significance bar it is shown but not trusted.', '条判断已记录；待 5 / 10 / 21 / 63 天周期走完即开始评分。信号通过 Newey-West 显著性检验前，仅展示、不被采信。') }}
  </div>
  {% else %}
  <div class="heat">
    {% for h, e in TR.horizons.items() %}{% if e.n_matured %}
    <div class="glass acc sec">
      <div class="sh">{{ h }}{{ t('d', '天') }} {{ t('horizon', '周期') }}
        <span class="etf">{{ t('IC', '信息系数') }}
          {%- if e.opportunity_ic is not none %} {{ '%+.3f'|format(e.opportunity_ic) }}
          {%- elif e.opportunity_ic_pooled is not none %} {{ '%+.3f'|format(e.opportunity_ic_pooled) }}~
          {%- else %} —{% endif %}</span>
        {% if TR.proven.get(h) %}<span class="pol up">{{ t('proven', '已验证') }}</span>{% else %}<span class="pol" style="background:color-mix(in srgb,var(--muted) 22%,transparent);color:var(--muted)">{{ t('measuring', '测量中') }}</span>{% endif %}</div>
      <small><span>{{ t('n', '样本') }} <b>{{ e.n_matured }}</b></span>
        {% if e.by_stage.emerging %}<span style="color:var(--up)">{{ t('emerging', '萌芽') }} <b>{{ '%+.1f'|format(e.by_stage.emerging.mean_fwd_rel*100) }}%</b></span>{% endif %}
        {% if e.by_stage.exhausted %}<span style="color:var(--down)">{{ t('exhausted', '透支') }} <b>{{ '%+.1f'|format(e.by_stage.exhausted.mean_fwd_rel*100) }}%</b></span>{% endif %}</small>
    </div>{% endif %}{% endfor %}
  </div>
  {% if TR.lead_time_d %}<div class="drv" style="margin-top:8px">{{ ic('edge') }} {{ t('Measured lead-time', '测得领先期') }}: <b>{{ TR.lead_time_d }}{{ t('d', '天') }}</b> · {{ t('where the opportunity-IC peaks', '机会IC峰值所在') }}</div>{% endif %}
  {% endif %}
  {% endif %}

  {# ── sector heat ── #}
  {% if hub.sector_heat %}
  <div class="band"><h2 style="--accent:var(--orange)">{{ ic('sector') }} {{ t('Sector heat', '板块热度') }}</h2><span class="ln"></span>
    <span class="cnt">{{ t('where the desks cluster', '各台聚集之处') }}</span></div>
  <div class="heat">
    {% for s in hub.sector_heat %}
    <div class="glass acc sec" style="--accent:{{ 'var(--up)' if s.net_lean>0 else 'var(--down)' if s.net_lean<0 else 'var(--info)' }}">
      <div class="sh"><span class="etf">{{ s.etf }}</span> {{ s.name }}
        {% if s.policy_tilt %}<span class="pol {{ 'up' if s.policy_tilt>0 else 'dn' }}">{{ t('policy', '政策') }} {{ '↑' if s.policy_tilt>0 else '↓' }}</span>{% endif %}</div>
      <div class="meter"><i style="width:{{ s.mean_conviction }}%"></i></div>
      <small><span>{{ t('mean', '均') }} <b>{{ s.mean_conviction }}</b></span><span>{{ t('names', '名') }} <b>{{ s.n }}</b></span>
        {% if s.early_edge %}<span style="color:var(--info)">{{ t('edge', '优势') }} <b>{{ s.early_edge }}</b></span>{% endif %}
        {% if s.crowded_top %}<span style="color:var(--warn)">{{ t('crowded', '拥挤') }} <b>{{ s.crowded_top }}</b></span>{% endif %}</small>
    </div>{% endfor %}
  </div>
  {% endif %}

  {# ── UNIFIED FORWARD DESK GRADER (5/10/20/30/60/90d, level+velocity, leave-tracking) ── #}
  {{ dg.styles() }}
  {{ dg.panel(hub.desk_grader) }}

  <footer class="hf">
    {{ t('Built', '生成于') }} <time datetime="{{ built }}">{{ built[:16].replace('T',' ') }}</time> UTC ·
    {{ hub.disclaimer }}
  </footer>
</div>
<script src="theme.js"></script>
<script defer src="sky.js"></script>
{# intraday progressive enhancement: live (~15-min) prices + nightly-band divergence chips on
   the surfaced names. No-ops if not configured/served — the slow-brain scores stay nightly. #}
</body>
</html>
