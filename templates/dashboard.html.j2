            data-tip-zh="流动性（仅供展示，不影响排名）——20日中位数成交金额{% if _adv_m is not none %}：${{ '%.1f'|format(_adv_m) }}M/日{% endif %}。等级：{{ _lt }}。按日均量10%建仓天数——$10万：{% if _d100 is not none %}{{ '%.1f'|format(_d100) }}天{% else %}N/A{% endif %}；$100万：{% if _d1m is not none %}{{ '%.1f'|format(_d1m) }}天{% else %}N/A{% endif %}。仅为参考。"
          ><span class="l-en">{{ _lt }}</span><span class="l-zh">{{ {'deep':'深度','ok':'良好','thin':'偏薄','illiquid':'流动性差'}.get(_lt, _lt) }}</span></span>
          {% endif %}
          {% set _sph = n.get('sector_pulse') %}
          {% if _sph and _sph.get('heat') and _sph.heat != 'idle' %}
