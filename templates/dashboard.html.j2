  </div>
  <!-- MRI-R39a: track-record panel-level overlay -->
  <div class="rr-tr-overlay" id="rr-tr-overlay" role="dialog" aria-modal="true" aria-labelledby="rr-tr-title-el">
    <div class="rr-tr-sheet" id="rr-tr-sheet">
      <div class="rr-tr-hdr">
        <div class="rr-tr-title" id="rr-tr-title-el">
          <span class="l-en">Release Radar — Track record</span>
          <span class="l-zh">数据发布雷达 — 评分记录</span>
        </div>
        <button type="button" class="rr-tr-close" id="rr-tr-close" aria-label="Close">&#215;</button>
      </div>
      <div id="rr-tr-body"></div>
      <div class="rr-tr-do-note">
