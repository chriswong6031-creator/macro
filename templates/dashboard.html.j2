<script>
/* Keep .help tooltips on-screen: flip below the icon when it's near the top of
   the viewport, and clamp horizontally near the left/right edges. Hover-only,
   no layout cost until you point at a "?". */
(function(){
  function place(h){
    var r = h.getBoundingClientRect(), vw = window.innerWidth;
    h.classList.toggle('below', r.top < 240);
    h.classList.remove('edge-left','edge-right');
    if (r.left > vw - 170) h.classList.add('edge-right');
    else if (r.left < 170) h.classList.add('edge-left');
  }
  document.addEventListener('pointerover', function(e){
    var h = e.target.closest && e.target.closest('.help');
    if (h) place(h);
  }, true);
})();
</script>
