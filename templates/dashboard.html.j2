  <div class="nb-disp disp-{{ _dr_mac.state }}" id="selection-regime-chip"
       data-tip-en="Selection regime — cross-sectional dispersion lens (L3, NW Rails). When names fan out (high dispersion / low pairwise correlation) stock-selection historically earns more; a macro-driven tape (low dispersion / high correlation) mutes it. DISPLAY-ONLY: gross_mult_live=1.0 — this chip does NOT move any score, gate, or sizing. Shadow tilt ×{{ _dr_mac.shadow_gross_mult }} is a hand-picked prior with no measured edge (US_BOARD_MEASUREMENT §Study 3). Dispersion pctile {{ _dr_mac.dispersion_pctile }} · avg pairwise corr {{ _dr_mac.avg_corr }}. DISP-GATE-1 shadow study pre-registered in research/dispersion/L3_PREREG.md."
       data-tip-zh="选股环境 — 横截面离散度镜头（L3，NW Rails）。仅供展示：gross_mult_live=1.0，不影响任何评分、门槛或仓位。">
    <span class="disp-ic">{{ '🎯' if _dr_mac.state == 'lean_in' else ('🌫️' if _dr_mac.state == 'lean_out' else '⚖️') }}</span>
    <b><span class="l-en">{{ t('Selection regime', '选股环境') }}: {{ _dr_mac.label }}</span><span class="l-zh">选股环境: {{ _dr_mac.label_zh }}</span></b>
    <span class="disp-meta">{{ _dr_mac.dispersion_pctile }}th {{ t('pctile', '百分位') }}{% if _dr_mac.avg_corr is not none %} · {{ t('avg corr', '平均相关') }} {{ _dr_mac.avg_corr }}{% endif %} · <span class="disp-shadow" data-tip-en="shadow prior — not applied to sizing" data-tip-zh="先验倾向 — 未应用于仓位">{{ t('suggested', '建议倾向') }} ×{{ _dr_mac.shadow_gross_mult }}</span></span>
  </div>
  {% endif %}

  <!-- ===================== SENTIMENT REGIME — Froth & Fragility + Fear↔Euphoria + Fear/Greed composite (context-only lenses; collapsed by default) ===================== -->
  {# Stage-B: macro mode renders sentiment inside the RISK tray (sx-risk-v2 above).
     This standalone section is kept for: (a) stocks mode rendering; (b) CI test extraction
     by text-landmark (test_fear_euphoria.py, test_froth_fragility.py extract this snippet).
     Hidden via CSS for macro mode to avoid duplicate DOM. #}
  {% if mode == 'stocks' and (froth_fragility or fear_euphoria or fear_greed) %}
  {% set ff = froth_fragility %}
  {% set FE = fear_euphoria %}
  {% set FG = fear_greed %}
  {% set _fgbandzh = {'Extreme Fear':'极度恐惧','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Extreme Greed':'极度贪婪'} %}
  {% set _bandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'} %}
  <details class="panel span12 fold mx-sent-band" id="sentiment-regime">
    <summary>{{ t('Sentiment &amp; Froth','情绪与狂热') }}
      {{ help("Sentiment context lenses — Fear/Greed composite, froth/fragility gauge, and fear↔euphoria synthesis. None of these call direction or size trades.","情绪背景视角 — 恐惧/贪婪合成、狂热/脆弱指标及恐惧↔欣喜综合。均不判断方向或决定仓位。") }}
      <span class="fold-stat">{% if FG %}{{ t('Fear/Greed','恐惧/贪婪') }} {{ t(FG.label_en, _fgbandzh.get(FG.label_en, FG.label_en)) }} {{ FG.dial }}/100{% endif %}{% if ff and ff.band %} · {{ t('Froth','狂热') }} {{ t(ff.band|capitalize, ff.band_zh) }}{% endif %}{% if FE %} · {{ t('Fear↔Euphoria','恐惧↔欣喜') }} {{ t(FE.band, _bandzh.get(FE.band, FE.band)) }}{% endif %}</span>
      <span class="fold-caret">▾</span>
    </summary>
    <div class="mx-sent-grid">

      <!-- Fear / Greed composite (P1.2) — mx compact col -->
      {% if fear_greed %}
      {% set FG = fear_greed %}
      {% set _fgbandzh = {'Extreme Fear':'极度恐惧','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Extreme Greed':'极度贪婪'} %}
      {% set _fgc = 'var(--down)' if FG.dial < 30 else ('var(--warn)' if FG.dial < 45 else ('var(--up)' if FG.dial > 55 else 'var(--muted)')) %}
      <section id="fear-greed" class="mx-sent-col">
        <div class="mx-sent-label">{{ t('Fear / Greed sentiment context','恐惧/贪婪情绪参考') }} {{ help('Equal-weight z-mean of qualifying market indicators (legs), each oriented so a positive z-score points toward greed. Display-only context — not a signal, not a timed call, never scored.','合格市场指标（分量）的等权 z 均值，每项方向均以正 z 为贪婪。仅供展示参考 — 非信号，非择时判断，不计分。') }}</div>
        <div class="mx-sent-val" style="color:{{ _fgc }}">{{ FG.dial }}</div>
        <div class="mx-sent-band-label">{{ t(FG.label_en, _fgbandzh.get(FG.label_en, FG.label_en)) }} <span class="muted">/100</span></div>
        <div class="mx-grad-track" style="position:relative">
          <span class="mx-grad-marker" style="left:calc({{ FG.dial }}% - 3px)"></span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:9.5px;color:var(--muted);margin-top:2px">
          <span>{{ t('Fear','恐惧') }}</span><span>{{ t('Neutral','中性') }}</span><span>{{ t('Greed','贪婪') }}</span>
        </div>
        <div class="muted sm" style="margin-top:8px">{{ FG.n_legs_qualifying }} {{ t('legs','分量') }} · <a href="macro_signals.html#fear-greed-detail" class="muted">{{ t('full →','完整 →') }}</a></div>
        {% if FG.young_tiles is defined and FG.young_tiles %}
        <div class="mx-sent-young">
          <div class="mx-sent-label" style="margin-top:8px">{{ t('Context tiles','背景指标') }}</div>
          {% for tile in FG.young_tiles %}
          <div class="mx-sent-tile"><span class="l-en">{{ tile.name_en }}</span><span class="l-zh">{{ tile.name_zh or tile.name_en }}</span>{% if tile.value is not none %}: {{ tile.value }}{% endif %}</div>
          {% endfor %}
        </div>
        {% endif %}
      </section>
      {% endif %}

      <!-- Froth & Fragility — mx compact col -->
      {% if froth_fragility %}
      {% set ff = froth_fragility %}
      {% set ffc = 'var(--up)' if ff.band == 'calm' else ('var(--warn)' if ff.band in ['watch','elevated'] else 'var(--down)') %}
      {% set ax = ff.face_a.score if ff.face_a.score is not none else 0 %}
      {% set bx = ff.face_b.score if ff.face_b.score is not none else 0 %}
      <section id="froth-fragility" class="mx-sent-col">
        <div class="mx-sent-label">{{ t('Froth & Fragility','狂热与脆弱') }} {{ help('A top-risk gauge for froth: retail euphoria plus hidden distribution. Only euphoric AND fragile together is a real top risk. Context only.','顶部风险计：零售狂热叠加隐性派发。唯有同时出现才是真正的顶部风险。仅供参考。') }}</div>
        {% if ff.headline is not none %}
        <div class="mx-sent-val" style="color:{{ ffc }}">{{ ff.headline|round|int }}</div>
        <div class="mx-sent-band-label">{{ t(ff.band|capitalize, ff.band_zh) }} <span class="muted">/100</span></div>
        {% else %}
        <div class="mx-sent-band-label muted">{{ t('—','—') }}</div>
        {% endif %}
        {% if ff.quadrant_en %}
        <div style="margin-top:4px;font-weight:700;font-size:12.5px;color:{{ ffc }}">{{ t(ff.quadrant_en, ff.quadrant_zh) }}
          {% if ff.provisional %}<span class="badge sm" style="margin-left:6px">{{ t('provisional','暂定') }}</span>{% endif %}
          {% if ff.unwind_risk %}<span class="badge sm" style="margin-left:6px;color:var(--down)">⚠ {{ t('unwind risk','解构风险') }}</span>{% endif %}
        </div>
        {% elif ff.provisional %}<div class="muted sm" style="margin-top:4px">{{ t('provisional','暂定') }}</div>
        {% endif %}
        <div class="mx-froth-items" style="margin-top:10px">
          <div class="mx-froth-item">
            <span class="mx-froth-label">{{ t('Euphoria','欣喜') }}</span>
            <div class="mx-froth-bar-wrap"><div class="mx-froth-bar" style="width:{{ [ax,100]|min }}%;background:var(--warn)"></div></div>
            <span class="mx-froth-val">{{ ax|round|int }}</span>
          </div>
          <div class="mx-froth-item">
            <span class="mx-froth-label">{{ t('Fragility / distribution','脆弱／派发') }}</span>
            <div class="mx-froth-bar-wrap"><div class="mx-froth-bar" style="width:{{ [bx,100]|min }}%;background:var(--down)"></div></div>
            <span class="mx-froth-val">{{ bx|round|int }}</span>
          </div>
        </div>
        <div class="muted sm" style="margin-top:6px">{% if ff.track_record and ff.track_record.n %}{{ t('Forward record','前瞻记录') }}: {{ ff.track_record.n }} {{ t('firings','次触发') }} · {{ (ff.track_record.hit_rate * 100)|round|int }}% {{ t('hit','命中') }}. {% else %}{{ t('Forward record accruing.','前瞻记录积累中。') }} {% endif %}{{ t('Display-only — the response is sizing, not selection.','仅供展示——应对是调整仓位，而非选股。') }}</div>
      </section>
      {% endif %}

      <!-- Fear ↔ Euphoria — mx compact col -->
      {% if fear_euphoria %}
      {% set FE = fear_euphoria %}
      {% set _bandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'} %}
      {% set _fec = 'var(--down)' if FE.fe_score < 30 else ('var(--warn)' if FE.fe_score < 50 else ('var(--up)' if FE.fe_score > 70 else 'var(--muted)')) %}
      <section class="mx-sent-col">
        <div class="mx-sent-label">{{ t('Fear ↔ Euphoria: regime synthesis','恐惧 ↔ 欣喜：周期综合') }} {{ help('Where the market sits between fear and euphoria, built from cross-asset risk appetite, stress read and capitulation. Context only.','市场处于恐惧与欣喜之间的位置，由跨资产风险偏好、压力读数与投降指标合成。仅供参考。') }}</div>
        <div class="mx-sent-val" style="color:{{ _fec }}">{{ FE.fe_score }}</div>
        <div class="mx-sent-band-label">{{ t(FE.band, _bandzh.get(FE.band, FE.band)) }} <span class="muted">/100</span></div>
        <div class="mx-grad-track" style="position:relative">
          <span class="mx-grad-marker" style="left:calc({{ FE.fe_score }}% - 3px)"></span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:9.5px;color:var(--muted);margin-top:2px">
          <span>{{ t('Panic','恐慌') }}</span><span>{{ t('Fear','恐惧') }}</span><span>{{ t('Neutral','中性') }}</span><span>{{ t('Greed','贪婪') }}</span><span>{{ t('Euphoria','欣喜') }}</span>
        </div>
        {% if FE.roro is not none %}<div class="muted sm" style="margin-top:8px">RORO {{ '%+.2f'|format(FE.roro) }}{% if FE.roro_state %} · {{ td(FE.roro_state) }}{% endif %}</div>{% endif %}
      </section>
      {% endif %}

    </div>
    <a href="macro_signals.html" class="muted sm" style="display:inline-block;margin-top:12px">{{ t('Full breakdown →','完整拆解 →') }}</a>
  </details>
  {% endif %}

  <!-- ===================== CROSS-ASSET MACRO — Rates & inflation transmission + Bonds & FX cross-check (merged scorecard; context-only) ===================== -->
  {% set _rit = latest.rate_inflation_transmission if (latest.rate_inflation_transmission and latest.rate_inflation_transmission.state) else None %}
  {% set _cac = latest.cross_asset_confirm if (latest.cross_asset_confirm and latest.cross_asset_confirm.verdict not in [none, 'unknown']) else None %}
  {% if mode == 'stocks' and (_rit or _cac) %}
  <div class="panel span12" id="cross-asset-macro">
    <div class="mx-panel-hdr">
      <span class="mx-panel-eyebrow">{{ t('Cross-Asset Check','跨资产校验') }}</span>
      <a href="transmission.html" style="margin-left:auto;font-size:12px;font-weight:600">{{ t('Transmission →', '传导 →') }}</a>
    </div>
    <h2 style="margin-top:0">{{ t('Rates, bonds &amp; FX — cross-asset check', '利率、债券与外汇 — 跨资产校验') }}
      {{ help("Context only. Rates & inflation: who today's rates and inflation help or hurt (green = tailwind, red = headwind). Bonds & FX: bonds and the dollar move first, so do they confirm the stock read? Agree = support; diverge = a yellow flag. Full cause-and-effect on the Transmission page.", "仅供参考。利率与通胀：当前利率与通胀利好或利空谁（绿＝顺风，红＝逆风）。债券与外汇：债券和美元先动，它们是否确认股市？一致＝有支撑；背离＝黄旗。完整因果见“传导”页面。") }}
    </h2>
    <div class="mx-asset-grid" style="grid-template-columns:1fr 1fr">

      <!-- Rates & inflation — who it helps, who it hurts -->
      {% if _rit %}
      {% set rit = _rit %}
      <section class="mx-asset-tile" style="border-radius:10px;padding:14px 16px">
        <h3 style="margin-top:0">{{ t('Rates & inflation — who it helps, who it hurts', '利率与通胀 — 利好谁、利空谁') }}
          {{ help("How today's interest rates and inflation help or hurt each asset class. Green = tailwind, red = headwind. It's a read on pressure, not a buy/sell call. The full cause-and-effect breakdown is on the Transmission page.", "当前利率与通胀如何利好或利空各类资产。绿色＝顺风，红色＝逆风。这是对压力的判断，而非买卖信号。完整的因果分解见“传导”页面。") }}
        </h3>
        <div style="display:flex;flex-wrap:wrap;gap:8px 18px;margin:4px 0 12px;font-size:13px">
          <span>{{ t('Rates','利率') }}: <b><span class="l-en">{{ rit.state.rates.label.en }}</span><span class="l-zh">{{ rit.state.rates.label.zh }}</span></b></span>
          <span>{{ t('Inflation','通胀') }}: <b><span class="l-en">{{ rit.state.inflation.label.en }}</span><span class="l-zh">{{ rit.state.inflation.label.zh }}</span></b></span>
          <span>{{ t('Expectations','预期') }}: <b><span class="l-en">{{ rit.state.expectations.label.en }}</span><span class="l-zh">{{ rit.state.expectations.label.zh }}</span></b></span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:13px">
          <div><span class="tone-down" style="font-weight:700">{{ t('Headwind','逆风') }}</span>
            {% for h in rit.headwinds[:3] %}<div style="margin-top:5px;display:flex;justify-content:space-between;gap:10px;align-items:baseline"><span><span class="l-en">{{ h.label.en }}</span><span class="l-zh">{{ h.label.zh }}</span></span> <b class="wind head">{{ '%.2f'|format(h.net) }}</b></div>{% else %}<div class="muted">—</div>{% endfor %}
          </div>
          <div><span class="tone-up" style="font-weight:700">{{ t('Tailwind','顺风') }}</span>
            {% for h in rit.tailwinds[:3] %}<div style="margin-top:5px;display:flex;justify-content:space-between;gap:10px;align-items:baseline"><span><span class="l-en">{{ h.label.en }}</span><span class="l-zh">{{ h.label.zh }}</span></span> <b class="wind tail">+{{ '%.2f'|format(h.net) }}</b></div>{% else %}<div class="muted">—</div>{% endfor %}
          </div>
        </div>
        <p class="muted sm" style="margin:10px 0 0">{{ t('A read on risk, not return — context only.', '仅作风险判断而非回报，仅供参考。') }}</p>
      </section>
      {% endif %}

      <!-- Bonds & FX cross-check — do they confirm stocks? -->
      {% if _cac %}
      {% set cac = _cac %}
      {% set _cvtone = 'up' if cac.verdict == 'confirm' else ('down' if cac.verdict == 'diverge' else 'flat') %}
      <section class="mx-asset-tile" style="border-radius:10px;padding:14px 16px">
        <h3 style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:0">{{ t('Bonds & FX cross-check — do they confirm stocks?', '债券与外汇交叉验证 — 是否确认股票？') }}
          <span class="badge tone-{{ _cvtone }}">{{ t(cac.verdict, cac.verdict_zh) }}{% if cac.agree_pct is not none %} · {{ cac.agree_pct }}%{% endif %}</span>
          {{ help("Bonds and the dollar move faster than stocks, so this checks whether they agree with the stock-market read. They AGREE = the move has support; they DIVERGE = a yellow flag worth watching. Context only, never a buy/sell signal.", "债券与美元比股票反应更快，因此本面板检查它们是否认同股市读数。一致＝走势有支撑；背离＝值得留意的黄旗。仅供参考，绝非买卖信号。") }}
        </h3>
        <div style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid var({{ '--up' if _cvtone=='up' else ('--down' if _cvtone=='down' else '--muted') }});border-radius:8px;padding:10px 12px;font-weight:600">
          {{ t(cac.headline_en, cac.headline_zh) }}
        </div>
        {% if cac.cycle %}
        <div class="muted sm" style="margin-top:8px">
          {{ t('Cycle clock', '周期时钟') }}: {{ t('equities', '股票') }} <b>{{ td(cac.cycle.equity) if cac.cycle.equity else '—' }}</b>
          · {{ t('bonds', '债券') }} <b>{{ t(cac.cycle.bonds_en or cac.cycle.bonds or '—', cac.cycle.bonds_zh or cac.cycle.bonds or '—') }}</b>
          {% if cac.cycle.fx_regime %} · {{ t('dollar-smile', '美元微笑') }} <b>{{ t(cac.cycle.fx_regime, cac.cycle.fx_regime_zh or cac.cycle.fx_regime) }}</b>{% endif %}
        </div>
        {% endif %}
        <div style="display:flex;flex-direction:column;gap:6px;margin-top:10px">
          {% for leg in cac.legs %}
          <div style="display:flex;gap:8px;align-items:flex-start">
            <span class="sstack-dot tone-{{ leg.tone }}" style="margin-top:5px;flex:0 0 auto"></span>
            <div><b>{{ t(leg.label_en, leg.label_zh) }}</b> — <span class="muted">{{ t(leg.detail_en, leg.detail_zh) }}</span></div>
          </div>
          {% endfor %}
        </div>
        {% if cac.caution_flags %}
        <div style="margin-top:10px">
          <div class="sm" style="font-weight:600;margin-bottom:4px">{{ t('Watch flags', '关注信号') }}</div>
          {% for f in cac.caution_flags %}
          <div class="sm" style="padding:4px 8px;margin:3px 0;border-left:3px solid var({{ '--down' if f.severity=='high' else ('--warn' if f.severity=='medium' else '--muted') }});background:var(--panel2);border-radius:4px">{{ t(f.en, f.zh) }}</div>
          {% endfor %}
        </div>
        {% endif %}
        <p class="muted sm" style="margin:10px 0 0">{{ t(cac.note_en, cac.note_zh) }}</p>
      </section>
      {% endif %}

    </div>
  </div>
  {% endif %}

  {% if mode == 'stocks' %}{# index-health panel: suppressed for macro mode (content moved to MARKETS tray in v2) #}
  <!-- ===================== MAJOR US INDEXES — HEALTH & RISK ===================== -->
  <div class="panel span12" id="index-health">
    <div class="mx-panel-hdr">
      <span class="mx-panel-eyebrow">{{ t('Index Health','指数健康度') }}</span>
    </div>
    <h2 style="margin-top:0">{{ t('Major US indexes — health & drawdown risk', '美国主要指数 — 健康度与回撤风险') }}
      {{ help("How the market itself is doing, before the economy. Price, % below the 52-week high (drawdown), trend vs the 50/200-day averages, and RSI(14) for the four major US indexes — alongside the validated macro de-risk read that drives the allocation strategy.", "在看经济之前，先看市场本身。四大美国指数的价格、距52周高点的回撤、相对50/200日均线的趋势、RSI(14) — 以及驱动仓位策略的经验证宏观降险读数。") }}
    </h2>
    <div class="idx-grid">
      {% for ix in index_health %}
      <div class="idx-tile">
        <div class="idx-top"><span class="idx-name"><b>{{ t(ix.label, ix.label_zh) }}</b><span class="idx-tkr">{{ ix.ticker|replace('_','') }}</span></span> <span class="idx-chg {{ 'pos' if ix.chg > 0 else ('neg' if ix.chg < 0 else 'muted') }}">{{ '%+.2f'|format(ix.chg) }}%</span></div>
        <div class="idx-row">
          <span class="idx-px">{{ '%.2f'|format(ix.price) }}</span>
          <span class="{{ 'pos' if ix.dd >= -1 else ('warn' if ix.dd >= -10 else 'neg') }}">{{ '%+.1f'|format(ix.dd) }}% {{ t('off high', '距高点') }}</span>
          <span>RSI {{ ix.rsi if ix.rsi is not none else '—' }}</span>
        </div>
        <div class="idx-trend">
          <span class="{{ 'pos' if ix.above200 else 'neg' }}">{{ '✓' if ix.above200 else '✕' }} 200d</span>
          <span class="{{ 'pos' if ix.above50 else 'neg' }}">{{ '✓' if ix.above50 else '✕' }} 50d</span>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="idx-risk">
      {% set dr = latest.conditions.drawdown_risk %}
      {% set rc = latest.conditions.recession %}
      {# Slow macro/credit drawdown gauge. Relabelled to the engine's OWN lagging identity
         (dr.label/dr.label_zh) so it no longer collides word-for-word with the leading Risk
         Radar banner above — a different NAME + 63d horizon stops 15 vs 91 reading as one
         metric self-contradicting. Since the PIT re-measure (#887) every band carries a
         measured conditional probability (low ~10% vs base ~19%) — still lagging, never
         shown as "calm". See the radar reconciliation note just below the grid. #}
      <div class="idx-gauge">
        <div class="idx-gk" data-tip-en="Slow macro/credit composite (recession risk, NFCI, EBP, HY OAS) · lags price · 63-day horizon · for near-term timing see the Risk Radar above" data-tip-zh="慢速宏观/信用综合（衰退风险、NFCI、EBP、高收益利差）· 滞后于价格 · 63日窗口 · 近端择时见上方风险雷达">
          {% if dr and dr.label %}{{ t(dr.label, dr.label_zh or dr.label) }}{% else %}{{ t('Macro/credit drawdown pressure (lagging)', '宏观/信用回撤压力（滞后）') }}{% endif %}
          {{ help('A SLOW macro/credit composite (recession risk, NFCI, EBP, HY OAS) over a 63-day horizon — it LAGS price, so a low read here is NOT a near-term all-clear: the probability is measured point-in-time against the base rate (low band ~10% vs base ~19%), but it moves slowly and after price. For the leading, near-term (≤21d) drawdown-odds read, trust the Risk Radar at the top of the Market State board above. The two answer different questions and can legitimately disagree.', '慢速的宏观/信用综合指标（衰退风险、NFCI、EBP、高收益利差），观察窗口为63日 — 它滞后于价格，因此此处读数偏低并不代表近端“安全”：该概率为时点法实测值（低区间约10%，基准约19%），但变化缓慢且滞后于价格。近端（≤21日）的领先回撤概率，请以上方市场状态板顶部的风险雷达为准。两者回答的是不同问题，出现分歧属正常。') }}
        </div>
        <div class="idx-gv">{{ dr.score|round|int if dr and dr.score is not none else '—' }}<small>/100{% if dr and dr.lead_lag %} · {{ t('lagging', '滞后') }}{% endif %}</small></div>
        {% if dr and dr.dd10_prob_pct is not none and dr.dd10_prob_informative %}
        {# is_base_rate branch retired with #887 — every band is a measured PIT prob #}
        <div class="muted" style="font-size:11px">{{ t('P(≥10% / 63d)', '概率(≥10%/63日)') }} <b>{{ dr.dd10_prob_pct }}%</b></div>
        {% endif %}
      </div>
      <div class="idx-gauge">
        <div class="idx-gk">{{ t('Recession risk', '衰退风险') }}</div>
        <div class="idx-gv">{{ rc.score|round|int if rc and rc.score is not none else '—' }}<small>/100</small></div>
