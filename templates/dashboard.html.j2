    {% set _nalerts = (alerts|length if alerts else 0) + (1 if (latest.dislocation and latest.dislocation.dislocation_active) else 0) %}
    {% endif %}
    {# ── V2 HERO — row-ledger hero (replaces ms-oneline + ms-front board) ── #}
    {% if market_state %}



    {# V2 HERO — the ms-verdict section lives inside the score panel;
       v-thesis p is styled as the gradient headline;
       ms-alerts-wrap moves into the hero context area;
       ms-front provides the color scope (.ms-green/.ms-yellow/.ms-red). #}
    <div class="mx2-hero ms-front{% if market_state %} ms ms-{{ market_state.color }}{% endif %}">
      {# ms-verdict section wraps ALL guard-required IDs: ms-word, ms-score, ms-tick, regime-asof.
         check_ms_board_coherence.py uses _SECTION regex to find them inside this tag. #}
      <section class="ms-verdict">
        {# v-thesis as gradient headline #}
        <p class="v-thesis{{ (' ms-' + MS.color) if market_state else '' }}">{{ t(MS.headline_en, MS.headline_zh) }}</p>
        {% for o in MS.overrides %}<p class="v-override"><span class="ic">⚠</span>{{ t(o.note_en, o.note_zh) }}</p>{% endfor %}
        {% if MS.flip_en %}<p class="v-flip">{{ t(MS.flip_en, MS.flip_zh) }}</p>{% endif %}
        <div class="hero-sub mx2-hero-sub">
          <span class="l-en">{{ td(latest.quad_name) }} &nbsp;·&nbsp; {{ td(latest.transition_state) }} &nbsp;·&nbsp; <span id="regime-asof">{{ latest.date }}</span></span>
          <span class="l-zh">{{ td(latest.quad_name) }} &nbsp;·&nbsp; {{ td(latest.transition_state) }} &nbsp;·&nbsp; <span>{{ latest.date }}</span></span>
        </div>

      <div class="mx2-hero-row">
        {# Score panel — ms-score, ms-word, ms-tick all inside ms-verdict (guard requirement) #}
        <div class="mx2-score-block">
          <div class="mx2-score-top">
            <span class="v-score" id="ms-score">{{ MS.score }}</span>
            <span class="v-outof">/100</span>
            <div class="mx2-score-label-stack">
              <span class="mx2-score-label">{{ t('Market state','市场状态') }}</span>
              <p class="v-word" id="ms-word"><span class="l-en">{{ MS.label_en }}</span><span class="l-zh">{{ MS.label_zh }}</span><span class="arr">{{ _va }}</span></p>
            </div>
            <div class="mx2-score-live-wrap">
              <span class="ms-live" id="ms-live-pill"></span>
              <span class="ms-date" id="ms-date" style="display:none">{{ MS.asof }}</span>
            </div>
          </div>
          <div class="mx2-prog-wrap">
            <div class="mx2-prog-track">
              <div class="mx2-prog-fill" style="width:{{ MS.score }}%"></div>
              <span class="tick" id="ms-tick" style="left:{{ MS.score }}%"></span>
            </div>
            <div class="mx2-prog-labels">
              <span class="l-en">Risk-off 0</span><span class="l-zh">避险 0</span>
              <span class="l-en">Mixed 50</span><span class="l-zh">混合 50</span>
              <span class="l-en">100 Risk-on</span><span class="l-zh">100 偏好</span>
            </div>
          </div>
        </div>

        {# Dominant driver context card + fired-alerts pill #}
        <div class="mx2-hero-ctx">
          <div>
            {% if MS.radar and MS.radar.state %}
            <strong class="l-en">{{ t(MS.radar.label_en, MS.radar.label_zh) }}:</strong>
            <span class="l-en"> {{ MS.radar.do_en }}</span>
