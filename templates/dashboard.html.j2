      <span class="sbx-stamp" id="sbx-stamp"><span class="sbx-dot"></span><span class="l-en">last close · {{ breadth_panel.asof }}</span><span class="l-zh">截至收盘 · {{ breadth_panel.asof }}</span></span>
    </div>
    <div class="sbx-grid">
      <div class="sbx-bar-card" role="button" tabindex="0" aria-haspopup="dialog" onclick="sbxDlg(1)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sbxDlg(1);}">
