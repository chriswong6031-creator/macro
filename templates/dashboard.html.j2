{# the mini history chart + stats shown inside a nowcast hover popover #}
{% macro nchart(nh) -%}
{% if nh and nh.svg %}{{ nh.svg }}
<span class="npstat"><span>{{ nh.years }}y</span><span><span class="l-en">range</span><span class="l-zh">区间</span> {{ nh.lo }}–{{ nh.hi }}%</span><span><span class="l-en">now</span><span class="l-zh">现值</span> <b>{{ nh.last }}%</b></span></span>
<span class="muted" style="font-size:10px;display:block;margin-top:2px">{% if nh.kind=='inflation' %}<span class="l-en">Dashed line = 2% Fed target · trend vs ~3 months ago.</span><span class="l-zh">虚线＝美联储 2% 目标 · 趋势对比约三个月前。</span>{% else %}<span class="l-en">Dashed line = 0% (stall) · trend = recent direction.</span><span class="l-zh">虚线＝0%（停滞）· 趋势＝近期方向。</span>{% endif %}</span>{% endif %}
{%- endmacro %}
{# Zeberg-style mini cycle chart: grey recession shading + zero baseline + blue trend +
   red momentum. mom/trend/rec are equal-length arrays (None allowed). #}
{% macro bcspark(mom, trend, rec, w=320, h=52) -%}
{%- set vals = (mom|reject('none')|list) + (trend|reject('none')|list) -%}
{%- set n = mom|length -%}
{%- if vals|length > 1 and n > 1 -%}
{%- set amax = [vals|map('abs')|max, 0.5]|max -%}
{%- set mid = h/2 -%}
<svg viewBox="0 0 {{ w }} {{ h }}" preserveAspectRatio="none" style="width:100%;height:{{ h }}px;display:block" role="img">
{%- if rec -%}{%- for i in range(rec|length) -%}{%- if rec[i] -%}<rect x="{{ (i/(n-1)*w)|round(2) }}" y="0" width="{{ (w/(n-1)+0.6)|round(2) }}" height="{{ h }}" fill="var(--muted)" opacity="0.16"/>{%- endif -%}{%- endfor -%}{%- endif -%}
<line x1="0" y1="{{ mid }}" x2="{{ w }}" y2="{{ mid }}" stroke="var(--line)" stroke-width="1"/>
<polyline fill="none" stroke="#4c8bf5" stroke-width="1.4" opacity="0.85" points="{% for i in range(trend|length) %}{% if trend[i] is not none %}{{ (i/(n-1)*w)|round(2) }},{{ (mid - trend[i]/amax*(mid-4))|round(2) }} {% endif %}{% endfor %}"/>
<polyline fill="none" stroke="#e0443e" stroke-width="1.6" points="{% for i in range(mom|length) %}{% if mom[i] is not none %}{{ (i/(n-1)*w)|round(2) }},{{ (mid - mom[i]/amax*(mid-4))|round(2) }} {% endif %}{% endfor %}"/>
</svg>
{%- else -%}<div class="muted sm">—</div>{%- endif -%}
{%- endmacro %}
