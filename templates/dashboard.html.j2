            {% if n.alpha_sector_rank %}<span class="nb-rk" data-tip-en="Rank within its GICS sector by sector-neutral momentum" data-tip-zh="按行业中性动量在其 GICS 行业内的排名">#{{ n.alpha_sector_rank }}/{{ n.alpha_sector_n }}</span>{% endif %}
