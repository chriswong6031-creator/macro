}
[data-theme="light"] body.page-macro .rsx-xref-row{background:rgba(34,197,94,.04);border-color:rgba(34,197,94,.18);}
body.page-macro .rsx-xref-text{color:var(--ink-2,rgba(255,255,255,.62));line-height:1.5;}
/* rsx-xref-btn — gbtn-up glass recipe (macro sweep 2026-07); onclick contract kept */
body.page-macro .rsx-xref-btn{
  font-size:11px;font-weight:600;padding:5px 12px;border-radius:999px;cursor:pointer;
  border:1px solid color-mix(in srgb, var(--up) 45%, var(--gbtn-brd));
  background:linear-gradient(180deg, color-mix(in srgb, var(--up) 12%, var(--gbtn-bg)), var(--gbtn-bg));
  -webkit-backdrop-filter:blur(12px) saturate(140%);backdrop-filter:blur(12px) saturate(140%);
  box-shadow:inset 0 1px 0 var(--gbtn-sheen);
  color:color-mix(in srgb,var(--up,#22c55e) 80%,white);
  transition:background .2s ease,border-color .2s ease,transform .16s ease,box-shadow .25s ease;
}
body.page-macro .rsx-xref-btn:hover{
  background:linear-gradient(180deg, color-mix(in srgb, var(--up) 20%, var(--gbtn-bg)), var(--gbtn-bg));
  border-color:color-mix(in srgb, var(--up) 60%, var(--gbtn-brd));transform:translateY(-1px);
  box-shadow:inset 0 1px 0 var(--gbtn-sheen),0 8px 20px -10px color-mix(in srgb, var(--up) 45%, transparent);
}
body.page-macro .rsx-xref-btn:active{transform:translateY(0) scale(.985);box-shadow:inset 0 1px 0 var(--gbtn-sheen);}
@media (prefers-reduced-motion: reduce){ body.page-macro .rsx-xref-btn,body.page-macro .rsx-xref-btn:hover,body.page-macro .rsx-xref-btn:active{transform:none;} }
/* Dialog-level merged footer */
body.page-macro .rsx-dlg-footer{
