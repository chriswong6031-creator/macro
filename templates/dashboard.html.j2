          {# --- the VERIFIERS: dealer-gamma "Options check" + IV-spread directional lean + vol black hole --- #}
          {% set _gc = c.gex_confirm %}{% set _vs = c.vol_squeeze %}{% set _iv = c.iv_spread_confirm %}
