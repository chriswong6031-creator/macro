              <td>{% set sg = r.signal if (r.signal is defined) else none %}{% if sg and sg.tier_cascade in ('T1','T2') %}<span class="ts-buy ok" title="Confirmed: 2D MACD-RSI × 3D StochRSI crossed within ~6 days, still constructive · 已确认：2日MACD-RSI×3日StochRSI约近6日内交叉、仍具建设性">{{ t('Buy zone', '买入区') }}</span>{% elif sg and sg.tier_cascade == 'T3' %}<span class="ts-buy soon" title="Anticipation: 3D StochRSI crossed, 2D MACD-RSI about to cross (next 1-2 bars) · 预期：3日StochRSI已上穿、2日MACD-RSI即将交叉（未来1-2根K线）">{{ t('About to cross', '即将交叉') }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
