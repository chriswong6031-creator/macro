    {% else %}
    <p class="muted">{{ t('Building…', '构建中…') }}</p>
    {% endif %}
  </div>
  {% endif %}{# /relief-radar — macro only #}

  <!-- ===== FEAR <-> EUPHORIA SYNTHESIS (display-only conditioning lens) ===== -->
  {% if mode != 'stocks' %}
  <div class="panel span12" id="fear-euphoria">
    <h2>🌡️ {{ t('Fear ↔ Euphoria: regime synthesis', '恐惧 ↔ 欣喜：周期综合') }}
      {{ help("A conditioning lens, NOT a signal. It synthesises components this dashboard already computes — the cross-asset RORO risk-appetite composite, the dislocation verdict and the capitulation gauge — into one Fear↔Euphoria regime read. It does NOT score direction or size positions, and never feeds the quad, the macro-risk score or any axis. 'Contrarian at extremes' is regime-dependent: fear is buyable only when the Fed put is present; in put-absent regimes extreme fear can be a falling knife.", "这是环境视角，不是信号。它综合本仪表盘已计算的成分 — 跨资产 RORO 风险偏好综合、错位读数与投降指标 — 形成单一的恐惧↔欣喜周期读数。它不评分方向、不决定仓位，也绝不进入象限、宏观风险评分或任何轴。'极端时反向操作'取决于周期：只有在美联储托底在位时，恐惧才可买入；托底缺失时，极端恐惧可能是下跌中的刀子。") }}
      <a href="gex.html" class="muted" style="font-size:12px;font-weight:400;float:right">{{ t('dealer gamma →','交易商 gamma →') }}</a>
    </h2>
    <p class="muted sm" style="margin:-4px 0 10px">{{ t('A regime read, not a signal — it synthesises existing components and never scores direction or sizes positions.', '这是周期读数而非信号 — 仅综合已有成分，绝不评分方向或决定仓位。') }}</p>
    {% if fear_euphoria %}
    {% set FE = fear_euphoria %}
    {% set DL = latest.dislocation %}
    {% set FCAP = (latest.conditions or {}).capitulation %}
    {% set FCOMP = (latest.conditions or {}).complacency %}
    {% set _bandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'} %}
    <div class="grid">

      <!-- 0-100 Fear<->Euphoria gauge -->
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700">{{ t('Fear ↔ Euphoria', '恐惧 ↔ 欣喜') }}
          <span style="font-size:22px">{{ FE.fe_score }}</span><span class="muted" style="font-size:13px">/100</span>
          <span class="badge" style="font-size:11px;vertical-align:middle;background:var(--panel)">{{ t(FE.band, _bandzh.get(FE.band, FE.band)) }}</span>
          {% if FE.roro is not none %}<span class="muted sm" style="float:right">RORO {{ '%+.2f'|format(FE.roro) }}{% if FE.roro_state %} <span class="pill" style="background:var(--panel)">{{ td(FE.roro_state) }}</span>{% endif %}</span>{% endif %}
        </div>
        <div class="pgauge" style="width:100%"><i style="left: {{ FE.fe_score }}%"></i></div>
        <div class="pends"><span>← {{ t('Fear', '恐惧') }}</span><span>{{ t('Euphoria', '欣喜') }} →</span></div>
        <div class="pends" style="margin-top:3px">
          <span{% if FE.band=='Panic' %} style="color:var(--text);font-weight:700"{% endif %}>{{ t('Panic', '恐慌') }}</span>
          <span{% if FE.band=='Fear' %} style="color:var(--text);font-weight:700"{% endif %}>{{ t('Fear', '恐惧') }}</span>
          <span{% if FE.band=='Neutral' %} style="color:var(--text);font-weight:700"{% endif %}>{{ t('Neutral', '中性') }}</span>
          <span{% if FE.band=='Greed' %} style="color:var(--text);font-weight:700"{% endif %}>{{ t('Greed', '贪婪') }}</span>
          <span{% if FE.band=='Euphoria' %} style="color:var(--text);font-weight:700"{% endif %}>{{ t('Euphoria', '欣喜') }}</span>
        </div>
        <div class="muted sm" style="margin-top:8px">{{ t("Today's score is the rolling-5-year percentile of the RORO composite (valid after ~2.5y). 'Contrarian at extremes' is regime-dependent — see the dislocation read below.", '今日评分为 RORO 综合的滚动五年百分位（约 2.5 年后有效）。"极端时反向操作"取决于周期 — 见下方错位读数。') }}</div>
      </div>

      <!-- 7-leg decomposition (neutral fill, no green/red) -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('What is driving it', '驱动因素') }} <span class="muted sm">{{ t('7 RORO legs', '7 项 RORO 分量') }}</span>
          {{ help("The seven cross-asset legs of the RORO composite, each shown as its signed contribution (risk-on positive) and its own rolling-5-year percentile. Six fear legs are negated so that, like the headline, higher = more risk-on; copper/gold enters positive. Bars are deliberately neutral-coloured — this is a regime decomposition, not a buy/sell on any leg.", "RORO 综合的七项跨资产分量，各自显示其带符号贡献（偏好风险为正）及其滚动五年百分位。六项恐惧分量取负，使其与总览一致：越高越偏好风险；铜／金以正向计入。柱状刻意采用中性色 — 这是周期拆解，而非对任一分量的买卖。") }}</div>
        {% for leg in FE.legs %}
        <div style="display:flex;align-items:center;gap:8px;margin:5px 0">
          <span style="flex:0 0 132px;font-size:12px">{{ t(leg.name_en, leg.name_zh) }}</span>
          <div style="flex:1;height:7px;border-radius:4px;background:var(--line);overflow:hidden"><div style="height:100%;width:{{ leg.pct }}%;background:var(--muted)"></div></div>
          <span class="muted sm" style="flex:0 0 96px;text-align:right">{{ '%+.2f'|format(leg.value) }} · {{ td(leg.lean) }}</span>
        </div>
        {% endfor %}
      </div>

      <!-- positioning + dislocation + capitulation -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        {% if FE.positioning %}
        {% set P = FE.positioning %}
        <div style="font-weight:700;margin-bottom:4px">{{ t('Positioning vs price', '持仓与价格') }}
          <span class="badge" style="font-size:11px;background:var(--panel);float:right">
            {% if P.chip=='confirms' %}{{ t('positioning confirms', '持仓与价格一致') }}
            {% elif P.chip=='diverges' %}{{ t('positioning diverges', '持仓与价格背离') }}
            {% else %}{{ t('positioning mixed', '持仓信号混杂') }}{% endif %}</span>
          {{ help("A DESCRIPTIVE read of whether smart-money positioning agrees with the price trend — never a buy/sell. Bullish if COT speculators are washed out OR insider Form-4 breadth is net-buying; bearish if COT is crowded long OR insiders are net-selling. 'Confirms' = positioning leans the same way price is trending; 'diverges' = the opposite; 'mixed' when the two positioning sources disagree.", "对聪明钱持仓是否与价格趋势一致的描述性读数 — 绝非买卖建议。当 COT 投机者被清洗 或 内部人 Form-4 净买入时偏多；当 COT 拥挤做多 或 内部人净卖出时偏空。'一致'＝持仓方向与价格趋势相同；'背离'＝相反；当两个持仓来源不一致时为'混杂'。") }}</div>
        <div class="muted sm">{{ t('COT spec', 'COT 投机') }}: {% if P.cot_washed_out %}{{ t('washed out', '已清洗') }}{% elif P.cot_crowded_long %}{{ t('crowded long', '拥挤做多') }}{% else %}{{ t('neutral', '中性') }}{% endif %}
          · {{ t('insider breadth', '内部人广度') }} {{ '%+.0f'|format(P.insider_breadth * 100) }}%
          · {{ t('price', '价格') }} {{ t('up', '上行') if P.price_up else t('down', '下行') }}</div>
        {% endif %}

        {% if DL %}
        <div class="kv" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--line)">{{ t('Dislocation read', '错位读数') }}
          <b style="float:right">{{ td(DL.verdict) }}</b></div>
        <div class="muted sm">{{ t('Fed put', '美联储托底') }}: <b>{{ td(DL.put_state) if DL.put_state else (t('Put present','托底在位') if DL.fed_put else t('Put ABSENT','托底缺失')) }}</b>
          {% if DL.inputs and DL.inputs.spy_drawdown_pct is not none %} · {{ t('S&P drawdown', '标普回撤') }} {{ DL.inputs.spy_drawdown_pct }}%{% endif %}</div>
        {% if DL.capitulation_caveat %}<div class="sm" style="margin-top:4px;color:var(--muted)">⚠ {{ DL.capitulation_caveat }}</div>{% endif %}
        {% endif %}

        {% if FCAP and FCAP.score is not none %}
        <div class="kv" style="margin-top:8px">{{ t('Capitulation', '投降') }}
          <b style="float:right">{{ FCAP.score }}/3 {{ t('signals', '信号') }}</b></div>
        {% if FCAP.signals_firing %}<div class="muted sm">{{ FCAP.signals_firing | join(' · ') }}</div>{% endif %}
        {% if FCAP.measured_bounce_pct is not none %}<div class="muted sm">{{ t('measured bounce', '实测反弹') }} {{ '%+.1f'|format(FCAP.measured_bounce_pct) }}% ({{ FCAP.measured_hit_pct }}% {{ t('hit', '命中') }})</div>{% endif %}
        {% endif %}

        {# Complacency / hidden-fragility — the euphoria-side MIRROR of the
           capitulation block above. Display-only conjunction (calm AND weak),
           neutral styling, never scored. #}
        {% if FCOMP and FCOMP.state %}
        {% set _cl = [] %}
        {% if FCOMP.vix_low %}{% set _ = _cl.append(t('VIX low', 'VIX 偏低')) %}{% endif %}
        {% if FCOMP.contango %}{% set _ = _cl.append(t('steep contango', '陡峭正向')) %}{% endif %}
        {% set _fl = [] %}
        {% if FCOMP.breadth_div %}{% set _ = _fl.append(t('breadth not confirming', '广度未确认')) %}{% endif %}
        {% if FCOMP.credit_widen %}{% set _ = _fl.append(t('HY credit widening', '高收益走阔')) %}{% endif %}
        <div class="kv" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--line)">{{ t('Complacency', '自满') }}
          {{ help("The euphoria-side MIRROR of the capitulation gauge. Capitulation marks extreme fear (a measured bounce); this marks the opposite tail — a CALM surface (VIX in the bottom quartile of its 2-year range, a steep-contango term structure) sitting over WEAKENING internals (the index near its 1-year high while fewer stocks hold their 200-day average, and high-yield credit quietly widening). 'Hidden fragility' fires ONLY on the conjunction — calm AND weak together. It is NOT a timing signal and is never scored: a low VIX is persistent and roughly neutral for forward returns, and the fragility only bites when a catalyst arrives. Context for position-sizing humility, not a sell.", "投降指标的欣喜一侧镜像。投降标记极端恐惧（实测反弹）；本指标标记相反一端 — 平静的表象（VIX 处于两年区间最低四分位、陡峭的正向期限结构）叠加走弱的内部结构（指数接近一年高点，但守住 200 日均线的个股越来越少，且高收益信用悄然走阔）。'隐性脆弱'仅在两者同时出现时触发 — 又平静又虚弱。它不是择时信号，也从不参与评分：低 VIX 具有持续性、对未来收益大致中性，脆弱只有催化剂到来时才发作。它用于仓位上的谦逊，而非卖出建议。") }}
          <b style="float:right">{% if FCOMP.state=='hidden_fragility' %}⚠ {{ t('hidden fragility', '隐性脆弱') }}{% elif FCOMP.state=='watch' %}{{ t('watch', '留意') }}{% elif FCOMP.state=='calm' %}{{ t('calm', '平静') }}{% else %}{{ t('neutral', '中性') }}{% endif %}</b></div>
        {% if FCOMP.warning %}
        <div class="muted sm">{{ _cl|join(' · ') }} <span style="opacity:.55">{{ t('over', '叠加') }}</span> {{ _fl|join(' · ') }}</div>
        {% elif FCOMP.state=='calm' %}
        <div class="muted sm">{{ _cl|join(' · ') if _cl else t('calm surface', '表象平静') }} · {{ t('internals confirming', '内部确认') }}</div>
        {% endif %}
        <div class="muted sm" style="margin-top:1px">
          {%- if FCOMP.vix_pctile is not none %}VIX {{ (FCOMP.vix_pctile*100)|round|int }}%ile{% endif %}
          {%- if FCOMP.vix_term is not none %} · vix/3m {{ '%.2f'|format(FCOMP.vix_term) }}{% endif %}
          {%- if FCOMP.breadth_above200_pctile is not none %} · %&gt;200dma {{ (FCOMP.breadth_above200_pctile*100)|round|int }}%ile{% endif %}
          {%- if FCOMP.hy_oas_chg_21d_bp is not none %} · HY {{ '%+.0f'|format(FCOMP.hy_oas_chg_21d_bp) }}bp/mo{% endif %}
        </div>
        <div class="muted sm" style="margin-top:2px">{{ t('Display-only mirror of capitulation — never scored.', '投降指标的纯展示镜像 — 从不评分。') }}</div>
        {% endif %}

        {% if latest.cross_asset and latest.cross_asset.get('absorption_ratio') is not none %}
        <div class="kv" style="margin-top:8px">{{ t('Cross-asset absorption', '跨资产吸收') }}
          <b style="float:right">{{ '%.2f'|format(latest.cross_asset.absorption_ratio) }}{% if latest.cross_asset.get('verdict') %} · {{ td(latest.cross_asset.verdict) }}{% endif %}</b></div>
        {% endif %}
      </div>

    </div>
    {% else %}
    <p class="muted">{{ t('Building…', '构建中…') }}</p>
    {% endif %}
  </div>
  {% endif %}{# /fear-euphoria — macro only #}

  <!-- ======================= ACTION BOARD ======================= -->
  {% if mode != 'macro' %}
  {% if action_board %}
  <div class="panel span12">
    <h2>⚡ {{ t('What to act on now', '当前可操作') }}
      {{ help("Your at-a-glance starting point. Built from each sector's own price cycle (and standout individual stocks): what's a confirmed buy today, what's setting up to buy within a few days, what to take profits on, and what to leave alone. 'Days' are rough trajectory estimates, not promises. Click any name for the full breakdown.", "你的一眼总览起点。基于每个板块自身的价格周期（及表现突出的个股）：今日已确认的买入、几天内即将构筑的买入、需止盈的、以及该放手不管的。'天数'是粗略的轨迹估计，并非承诺。点击任意名称查看完整拆解。") }}
    </h2>
    <div class="actiongrid">
      <div class="actcol act-buy">
        <div class="acth">🟢 {{ t('BUY ZONE — confirmed now', '买入区 — 已确认') }}</div>
        {% for x in action_board.buy_now %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.age_short %}<span class="actage">⏱ {{ t(x.age_short, x.age_short_zh) }}</span>{% endif %}{% if x.eq_badge %}<span class="eqmini eq-{{ x.eq_dir }}" title="{{ x.eq_tip }}">{{ x.eq_badge }}</span>{% endif %}<span class="acttag">{{ td(x.label) }}</span></a>
        {% else %}<p class="muted sm">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-soon">
        <div class="acth">🔵 {{ t('SETTING UP — buy soon', '构筑中 — 即将买入') }}</div>
        {% for x in action_board.buy_soon %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.get('days') is not none %}<span class="acteta">~{{ x.days }}d</span>{% endif %}</a>
        {% else %}<p class="muted sm">{{ t('No imminent setups.', '暂无临近的构筑。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-trim">
        <div class="acth">🟠 {{ t('TAKE PROFITS / topping', '止盈／做顶') }}</div>
        {% for x in action_board.take_profits %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.age_short %}<span class="actage">⏱ {{ t(x.age_short, x.age_short_zh) }}</span>{% endif %}{% if x.eq_badge %}<span class="eqmini eq-{{ x.eq_dir }}" title="{{ x.eq_tip }}">{{ x.eq_badge }}</span>{% endif %}<span class="acttag">{{ td(x.label) }}</span></a>
        {% else %}<p class="muted sm">{{ t('Nothing topping.', '无标的做顶。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-hold">
        <div class="acth">⚪ {{ t('HOLD / avoid', '持有／回避') }}</div>
        {% for x in action_board.hold %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ t("hold — don't chase", '持有 — 勿追高') }}</span></a>
        {% endfor %}
        {% for x in action_board.avoid %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ t("wait", '等待') if x.tag == "WAIT" else t("avoid", '回避') }}</span></a>
        {% endfor %}
      </div>
    </div>
    {% set _su = us_standouts if (us_standouts and us_standouts.buy) else None %}
    {% if _su or action_board.notable %}
    <div class="notable">
      <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
        <span style="font-weight:700;font-size:13px">{{ t('Standout individual stocks', '表现突出的个股') }}</span>
        {% if _su %}<span class="muted" style="font-size:11.5px">{{ _su.buy|length }} {{ t('of', '/') }} {{ _su.eligible }} {{ t('cleared the +0.5 α floor · ranked across the full S&P 1500 by validated residual momentum · each card carries the unified Conviction profile (cycle state caps the verdict)', '只通过 +0.5 α 门槛 · 在整个标普1500内按已验证残差动量排序 · 每张卡片附带统一确信度画像（周期状态会封顶结论）') }}
          {{ help("The bench is ranked by the VALIDATED sector-neutral residual-momentum leg (α) across the full S&P 1500 — so it surfaces leaders that aren't in any sector ETF's top-10. Each card then carries the unified Conviction profile: four transparent axes (selection / entry / tailwind / quality) and a single honest verdict. The price-cycle state is a HARD modifier — a name in a downtrend or topping can never read 'Buy', it reads 'strong name, wrong tape' — which is why this card and the stock's own page never disagree. The 0-100 score is a within-market percentile DISPLAY skin (not a probability); the composite is shown as context until a deep Phase-0 clears it. Click any card for the full breakdown.", "榜单按已验证的行业中性残差动量（α）在整个标普1500内排序——因此能发掘不在任何行业ETF前十大持仓中的领涨股。每张卡片再附带统一确信度画像：四条透明维度（选股／入场／顺风／质量）与一个诚实结论。价格周期状态是硬性修正项——处于下行或做顶的个股永远不会显示“买入”，而显示“强势但趋势不利”——这正是该卡片与个股自身页面永不矛盾的原因。0-100 分是市场内百分位的展示皮肤（非概率）；在深度 Phase-0 通过前，综合分仅作情境展示。点击任意卡片查看完整拆解。") }}</span>{% endif %}
        {% if not _su %}<span class="muted" style="font-size:11.5px">{{ t('from each sector’s top-10 holdings · grouped by cycle entry, ranked by sector-neutral momentum (α)', '来自各板块前十大持仓 · 按周期入场分组，以行业中性动量（α）排序') }}
          {{ help("Every sector ETF's top-10 holdings are run through the SAME price-cycle engine as the sectors. A name earns a card only when its cycle signal is decisive — a confirmed buy (BUY ZONE), an imminent turn (BOTTOMING), or a sell (TOPPING). The cycle state GROUPS the cards (it places risk — a defined entry + exit); WITHIN each group they're ordered by the validated sector-neutral residual momentum (α — market + sector beta stripped). We Phase-0 tested blending the cycle timing INTO the rank (reports/setup-score-phase0.md, survivorship-clean S&P 500, 12y) and it did NOT improve forward returns — it diluted α — so the order rides α and the cycle/pullback is shown as risk-placement CONTEXT, not a return signal. A soft per-sector cap keeps one hot sector from crowding the board. The α / #rank / pullback line and the 👤 insider chip are context inputs, NOT standalone buy signals. Click any card for the full breakdown.", "每个板块 ETF 的前十大持仓都用与板块相同的价格周期引擎分析。只有当个股的周期信号具决定性时才会获得卡片 — 已确认买入（买入区）、即将转向（筑底）或卖出（做顶）。周期状态对卡片进行分组（它摆放风险 — 明确的入场与出场）；在每组内部，按已验证的行业中性残差动量（α — 已剥离大盘与行业 beta）排序。我们做了 Phase-0 检验，把周期择时混入排序（reports/setup-score-phase0.md，无幸存者偏差的标普500，12年），结果并未改善前瞻收益 — 反而稀释了 α — 因此排序以 α 为准，周期/回调作为风险摆位的情境展示，而非收益信号。软性的单一板块上限可避免强势板块挤占整版。卡片上的 α / #排名 / 回调一行以及 👤 内部人买入标记均为情境输入，并非独立买入信号。点击任意卡片查看完整拆解。") }}</span>{% endif %}
      </div>
      {% if market_gamma %}
      <div class="gamma-note gn-{{ market_gamma.regime }}">
        {% if market_gamma.regime == 'short' %}<span class="gn-ic">🌀</span>
          <b>{{ t('Short-gamma market', '空头 Gamma 市场') }}</b> — {{ t('S&P 500 trades', '标普500 现') }} {{ '%.1f'|format(market_gamma.spot_vs_flip_pct | abs) }}% {{ t('below its dealer gamma-flip', '低于做市商 Gamma 翻转位') }} ({{ market_gamma.flip }}): {{ t('dealer hedging AMPLIFIES moves — momentum extends but reversals snap back hard. Wider stops; don’t chase entries.', '做市商对冲会放大波动 — 动量延伸但反转剧烈。放宽止损，不要追高入场。') }}
        {% else %}<span class="gn-ic">⚖</span>
          <b>{{ t('Long-gamma market', '多头 Gamma 市场') }}</b> — {{ t('S&P 500 trades', '标普500 现') }} {{ '%.1f'|format(market_gamma.spot_vs_flip_pct) }}% {{ t('above its dealer gamma-flip', '高于做市商 Gamma 翻转位') }} ({{ market_gamma.flip }}): {{ t('dealer hedging DAMPENS moves — ranges hold and breakouts tend to fade. Fade extremes; breakouts need confirmation.', '做市商对冲会抑制波动 — 区间维持，突破易回落。逢极端反向，突破需确认。') }}
        {% endif %}
        {{ help("The whole-market dealer-gamma regime, from the VALIDATED index dealer-gamma read (S&P 500, engine.gex_engine — the same that drives the dealer-gamma board). ABOVE the gamma 'flip' strike dealers are net long gamma and hedge AGAINST price (pinning, vol suppressed); BELOW it they are short gamma and hedge WITH price (amplifying). This is market-wide vol CONTEXT for the setups below — how moves behave right now — NOT a per-stock signal. An estimate from delayed CBOE chains, not ground truth.", "全市场做市商 Gamma 状态，来自已验证的指数做市商 Gamma 读数（标普500，engine.gex_engine — 与做市商 Gamma 看板同源）。在 Gamma“翻转”行权价之上，做市商净多头 Gamma，逆价格对冲（钉住、压制波动）；之下则为空头 Gamma，顺价格对冲（放大波动）。这是对下方布局的全市场波动情境 — 当下波动的表现方式 — 并非个股信号。基于延迟的 CBOE 链估算，并非真实值。") }}
        <span class="gn-cav">{{ t('market-wide context, not a per-stock signal · est., as of', '全市场情境，非个股信号 · 估算，截至') }} {{ market_gamma.asof }}</span>
      </div>
      {% endif %}
