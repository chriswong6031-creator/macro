            </div>
          </div>
        </div>
        {% elif _weakest %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon mx5-ai-yellow">
            <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
