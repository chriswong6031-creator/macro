    {% set _alv5_all = alerts if alerts else [] %}
    {# Sort: warn severity first, then info #}
    {% set _alv5_sorted = (_alv5_all | selectattr('severity','in',('warn','high','critical')) | list) + (_alv5_all | rejectattr('severity','in',('warn','high','critical')) | list) %}
    {% set _alv5_top = _alv5_sorted[:3] %}
    {% set _alv5_total = _alv5_all | length %}
    <div class="sxg-face mx5-card-face" role="button" tabindex="0" aria-haspopup="dialog" onclick="mx5OpenDlg('dlg-news')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();mx5OpenDlg('dlg-news');}">
      <div class="mx5-card-title-row">
        <div class="mx5-card-title"><span class="l-en">Alerts Centre</span><span class="l-zh">警报中心</span></div>
        {% if _alv5_total > 0 %}
        <div class="mx5-card-badge" style="color:var(--mx5-warn-ink);background:var(--mx5-warn-dim);border:1px solid rgba(245,158,11,.20);">
          <span class="l-en">{{ _alv5_total }} FIRED</span>
          <span class="l-zh">{{ _alv5_total }} 条触发</span>
        </div>
        {% endif %}
      </div>
      {% if _alv5_top %}
      <div class="mx5-alerts-list">
        {% for a in _alv5_top %}
        {% set _asev = 'warn' if a.severity in ('warn','high','critical') else 'info' %}
        <div class="mx5-alert-item {{ _asev }}">
          <div class="mx5-alert-dot {{ _asev }}"></div>
          <div class="mx5-alert-content">
            <div class="mx5-alert-title {{ _asev }}">
              <span class="l-en">{{ a.plain_en }}</span>
              <span class="l-zh">{{ a.plain_zh or a.plain_en }}</span>
            </div>
            <div class="mx5-alert-detail">
              <span class="l-en">{{ a.message[:120] }}{% if a.message | length > 120 %}…{% endif %}</span>
              <span class="l-zh">{{ (a.message_zh or a.message)[:80] }}{% if (a.message_zh or a.message) | length > 80 %}…{% endif %}</span>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="mx5-alert-footer">
        <span>
          <span class="l-en">Showing {{ _alv5_top | length }} of {{ _alv5_total }} fired</span>
          <span class="l-zh">显示 {{ _alv5_top | length }} / {{ _alv5_total }} 条</span>
        </span>
        <button type="button" class="mx5-alert-footer-link" onclick="event.stopPropagation();mx5OpenDlg('dlg-news')">
          <span class="l-en">View all &#8594;</span>
          <span class="l-zh">查看全部 &#8594;</span>
        </button>
