}
body.page-macro .mx2-hero-ctx strong{color:var(--text)}
body.page-macro .mx2-hero-ctx .mx2-alerts-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}

/* ── Island system color tokens per section ── */
body.page-macro{
  --isle-evidence:#20c0a0;
  --isle-events:#e0a030;
  --isle-markets:#4d8ef5;
  --isle-risk:#e05c5c;
  --isle-policy:#a070e8;
  --isle-brief:#38c472;
  --isle-news:#7a8494;
  --isle-deep:#4d8ef5;
  /* tri-layer shadow stack */
  --island-shadow-tight:0 2px 10px rgba(0,0,0,.6);
