          <span class="l-zh"><b>{{ _c_zh }}</b>（{{ _conf | round(2) }} / 1）— {% if _c_en == 'low' %}不需太多新证据即可改变该判断{% elif _c_en == 'moderate' %}仍在检验{% else %}得到今日输入充分支撑{% endif %}</span>
        </span>
      </div>
      {% endif %}
      {# Stance footer — provisional warning when margin thin or conviction low #}
      {% set _m_val = _fc.get('margin') %}
      {% if (_m_val is not none and _m_val < 0.15) or (_conf is not none and _conf is number and _conf < 0.33) %}
      <div class="mxfs-stance">{{ t('Treat the label as provisional — lean on the risk score, not the regime name.','该标签宜视为临时——以风险评分为主，勿依赖周期名称。') }}</div>
