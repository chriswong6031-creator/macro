/* Restyle existing #ms-word el */
body.page-macro .mx2-score-block .v-word{font-size:15px;font-weight:800;color:var(--ms-c,var(--up));margin:0;padding:0}
body.page-macro .mx2-score-block .v-word .arr{margin-left:4px}
/* Progress bar — wraps existing #ms-tick */
body.page-macro .mx2-prog-wrap{display:flex;flex-direction:column;gap:0}
body.page-macro .mx2-prog-track{
