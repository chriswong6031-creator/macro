}
body.page-macro.mx4-grid .mx5-fed-hist-col{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
}
body.page-macro.mx4-grid .mx5-fed-hist-bar{width:100%;border-radius:2px 2px 0 0;}
body.page-macro.mx4-grid .mx5-fed-hist-name{
  font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));text-align:center;
}
body.page-macro.mx4-grid .mx5-fed-policy-note{
  margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.07);
