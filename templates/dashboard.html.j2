{% macro help(text) -%}
<span class="help">?<span class="tip">{{ text }}</span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Macro Regime Dashboard — {{ latest.date }}</title>
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
  :root {
    --bg: #0f1115; --panel: #181b21; --panel2: #1e222a; --text: #d7dce3;
    --muted: #8b93a1; --line: #2a2f3a;
    --q1: #2e9e4f; --q2: #d4a017; --q3: #d04545; --q4: #3f78d8;
    --warn: #e0a030; --act: #e05555; --ok: #3da564;
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font: 14px/1.5 -apple-system,
         "Segoe UI", Roboto, Helvetica, sans-serif; margin: 0; padding: 18px; }
  a { color: #7aa7e0; text-decoration: none; }
  h1 { font-size: 20px; margin: 0 0 2px; }
  h2 { font-size: 15px; margin: 0 0 10px; color: var(--muted);
       text-transform: uppercase; letter-spacing: .06em; }
  h3 { font-size: 13px; margin: 14px 0 6px; color: var(--text); }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(12, 1fr); }
  .panel { background: var(--panel); border: 1px solid var(--line);
           border-radius: 10px; padding: 14px 16px; }
  .span12 { grid-column: span 12; } .span8 { grid-column: span 8; }
  .span6 { grid-column: span 6; } .span4 { grid-column: span 4; }
  @media (max-width: 900px) { .span8, .span6, .span4 { grid-column: span 12; } }

  .badge { display: inline-block; padding: 3px 12px; border-radius: 14px;
           font-weight: 600; font-size: 13px; }
  .quad-Q1 { background: var(--q1); color: #fff; }
  .quad-Q2 { background: var(--q2); color: #1a1a1a; }
  .quad-Q3 { background: var(--q3); color: #fff; }
  .quad-Q4 { background: var(--q4); color: #fff; }
  .state-STABLE { background: #2a2f3a; color: var(--text); }
  .state-WEAKENING { background: var(--warn); color: #1a1a1a; }
  .state-TRANSITIONING { background: #e07b30; color: #1a1a1a; }
  .state-NEW_REGIME { background: var(--act); color: #fff; }
  .kv { color: var(--muted); } .kv b { color: var(--text); font-weight: 600; }
  .navbtn { background: var(--panel2); border: 1px solid var(--line); color: #7aa7e0;
            padding: 5px 14px; border-radius: 8px; font-size: 13px; }

  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: right; padding: 4px 8px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 500; }
  th:first-child, td:first-child { text-align: left; }
  td.l, th.l { text-align: left; }
  .pos { color: #5fbf7f; } .neg { color: #e07070; }

  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; }
  .pill-ok { background: #1d3326; color: #6fce8f; }
  .pill-stale { background: #38301a; color: #d8b75a; }
  .pill-failed, .pill-dead { background: #3a2020; color: #e08080; }
  .pill-blocked { background: #2b2b33; color: #a8a8c0; }

  .alert { padding: 8px 12px; border-radius: 8px; margin: 6px 0;
           background: var(--panel2); border-left: 3px solid var(--muted); }
  .alert-act { border-left-color: var(--act); }
  .alert-warn { border-left-color: var(--warn); }
  .muted { color: var(--muted); }
  .chart { width: 100%; }
  .topline { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }

  .help { display: inline-flex; align-items: center; justify-content: center;
          width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--muted);
          color: var(--muted); font-size: 10px; font-weight: 600; cursor: help;
          position: relative; vertical-align: middle; margin-left: 5px; flex: none; }
  .help .tip { display: none; position: absolute; bottom: 140%; left: 50%;
               transform: translateX(-50%); width: 290px; background: #262b35;
               border: 1px solid #3a4150; padding: 9px 11px; border-radius: 8px;
               z-index: 60; font-size: 12px; line-height: 1.45; color: var(--text);
               text-align: left; font-weight: 400; text-transform: none;
               letter-spacing: normal; box-shadow: 0 6px 18px rgba(0,0,0,.5);
               pointer-events: none; white-space: normal; }
  .help:hover .tip { display: block; }
  th .help .tip { bottom: auto; top: 140%; }

  .dial { display: flex; gap: 4px; margin: 8px 0 12px; }
  .dial span { flex: 1; text-align: center; padding: 6px 2px; border-radius: 6px;
               background: var(--panel2); color: var(--muted); font-size: 11px;
               font-weight: 600; letter-spacing: .04em; }
  .dial .active-DEFENSIVE { background: var(--act); color: #fff; }
  .dial .active-CAREFUL { background: #e07b30; color: #1a1a1a; }
  .dial .active-NEUTRAL { background: #4a5160; color: #fff; }
  .dial .active-CONSTRUCTIVE { background: #3f8f5f; color: #fff; }
  .dial .active-AGGRESSIVE { background: var(--ok); color: #fff; }
  @media (max-width: 520px) { .dial span { font-size: 8.5px; padding: 5px 1px; } }
  .reason { margin: 4px 0; padding-left: 24px; position: relative; }
  .reason b.sig { position: absolute; left: 0; width: 17px; text-align: center;
                  border-radius: 4px; font-size: 12px; }
  .sig-p { background: #1d3326; color: #6fce8f; } .sig-m { background: #3a2020; color: #e08080; }
  .sig-i { background: #2b2f3a; color: #9fb4d8; }

  .card { background: var(--panel2); border: 1px solid var(--line); border-radius: 8px;
          padding: 10px 12px; margin: 6px 0; }
  .card b.tk { font-size: 14px; }
  .calltag { float: right; font-size: 11px; font-weight: 700; padding: 1px 8px;
             border-radius: 9px; }
  .tag-lead { background: #1d3326; color: #6fce8f; }
  .tag-avoid { background: #3a2020; color: #e08080; }
  .tag-watch { background: #2b3340; color: #9fc0e8; }

  .chip { display: inline-block; padding: 2px 9px; margin: 2px 3px 2px 0;
          border-radius: 10px; font-size: 12px; background: var(--panel2); }
  .chip-pos { border: 1px solid #2e6e44; color: #6fce8f; }
  .chip-neg { border: 1px solid #6e2e2e; color: #e08080; }

  .gauge { position: relative; height: 10px; border-radius: 5px; margin: 6px 0 2px;
           background: linear-gradient(90deg, #e07070 0%, #4a5160 50%, #5fbf7f 100%); opacity:.9; }
  .gauge i { position: absolute; top: -4px; width: 4px; height: 18px; background: #fff;
             border-radius: 2px; }

  /* regime lifespan bar */
  .lifebar { position: relative; height: 16px; border-radius: 8px; overflow: hidden;
             background: var(--panel2); margin: 8px 0 4px; }
  .lifebar .zone { position: absolute; top: 0; bottom: 0; }
  .lifebar .marker { position: absolute; top: -2px; bottom: -2px; width: 4px;
                     background: #fff; border-radius: 2px; z-index: 5; }
  .lifelabels { display: flex; justify-content: space-between; font-size: 11px;
                color: var(--muted); }

  /* next-regime probability bars */
  .prob { display: flex; align-items: center; gap: 10px; margin: 7px 0; }
  .prob .nm { width: 110px; font-weight: 600; font-size: 13px; flex: none; }
  .prob .bar { flex: 1; height: 14px; background: var(--panel2); border-radius: 7px;
               overflow: hidden; }
  .prob .bar i { display: block; height: 100%; border-radius: 7px; }
  .prob .pc { width: 44px; text-align: right; font-weight: 600; flex: none; }

  .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; font-size: 12px; }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px;
              margin-right: 5px; vertical-align: -1px; }
  details.howto { margin-top: 10px; }
  details.howto summary { cursor: pointer; color: #7aa7e0; font-size: 13px; }
  details.howto div { background: var(--panel2); border-radius: 8px; padding: 12px 14px;
                      margin-top: 8px; font-size: 13px; line-height: 1.6; }
  ul.compact { margin: 4px 0; padding-left: 18px; } ul.compact li { margin: 3px 0; }
</style>
</head>
<body>
<div class="grid">

  <!-- ======================= HEADER ======================= -->
  <div class="panel span12">
    <div class="topline">
      <h1>Macro Regime Dashboard</h1>
      <span class="badge quad-{{ latest.quad }}">{{ latest.quad_name }}</span>
      {{ help("The market 'weather' right now — NOT a calendar quarter. Four regimes based on whether growth and inflation are rising or falling: GOLDILOCKS (green) = growth up, inflation down — historically the friendliest for stocks. REFLATION (yellow) = both heating up — favors energy, banks, industrials. STAGFLATION (red) = inflation up, growth rolling over — historically the most dangerous. GROWTH SCARE (blue) = both falling — favors defensives and bonds. The label changes only after 7 straight days of evidence (or one extreme shock day).") }}
      <span class="badge state-{{ latest.transition_state }}">{{ latest.transition_state }}</span>
      {{ help("The transition radar — is the current regime ending? STABLE: no warning signs, trust the label. WEAKENING: 2+ warning signals — stop adding regime-dependent bets. TRANSITIONING: 3+ warnings — the regime is probably ending before the label flips; reduce risk now. NEW REGIME: the label just changed this week.") }}
      <span class="kv">signal agreement <b>{{ (latest.confidence * 100) | round | int }}%</b></span>
      {{ help("How many of the underlying indicators point the same way. Above ~45%: well-supported. 30-45%: moderate. Below 30%: indicators disagree — expect chop and trust the transition radar more than the label.") }}
      <span class="kv">Fed liquidity <b>{{ latest.liquidity_overlay }}</b></span>
      {{ help("Money the Fed system is adding to or draining from markets (balance sheet minus reverse-repo minus Treasury account, 4-week trend). EXPANDING has historically been the single most reliable tailwind for stocks (~73% positive months in our backtest). CONTRACTING is a persistent headwind.") }}
      <span class="kv">cycle <b>{{ latest.cycle_tag }}</b></span>
      {{ help("Rough position in the multi-year business cycle (yield curve + credit spreads + breadth). EARLY: recovering after stress — usually the best risk/reward. MID: expansion cruising. LATE: keep one eye on the exit. Context only.") }}
      <span style="flex:1"></span>
      <a class="navbtn" href="history.html">📈 History & charts</a>
      <a class="navbtn" href="weekly.html">📋 Weekly report</a>
    </div>
    <details class="howto">
      <summary>New here? How to read this page in 60 seconds</summary>
      <div>
        <b>1.</b> The colored badge is the market regime — the "weather" (not a calendar quarter!). The second badge is the transition radar — whether that weather is about to change.<br>
        <b>2.</b> <b>Where we are</b> shows how far along this regime likely is. <b>What's likely next</b> gives the historical odds of each path and what to do about it. <b>How to trade it</b> turns today's conditions into a posture and concrete names.<br>
        <b>3.</b> Everything below that is supporting evidence. Hover any <span class="help">?</span> for a plain-English explanation. <span class="pos">Green = risk-friendly</span>, <span class="neg">red = risk-hostile</span>.<br>
        <b>4.</b> This is a context machine with measured odds, not a crystal ball.
      </div>
    </details>
  </div>

  {% if latest.alerts %}
  <div class="panel span12">
    <h2>Fired alerts (today)
      {{ help("Alerts fire only when something CHANGES — a warning level escalating, a crossing, a sign flip — never just because a level is high. They're rare by design; read every one.") }}
    </h2>
    {% for a in latest.alerts %}
      <div class="alert alert-{{ a.severity }}"><b>{{ a.rule }}</b> — {{ a.message }}</div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ======================= NOW ======================= -->
  {% if pb %}
  <div class="panel span6">
    <h2>Where we are in this regime
      {{ help("Compares this regime's age against every " + latest.quad_name + " period since 2007 in this exact classifier. Regimes don't die of old age — but the older one gets relative to history, the more weight every warning flag deserves.") }}
    </h2>
    <p style="font-size:14.5px; margin: 2px 0 6px"><b>{{ pb.headline.split('. Posture')[0] }}.</b></p>
    {% if pb.progress %}
    <div class="lifebar">
      <div class="zone" style="left:0; width:{{ pb.progress.zone_early_pct }}%; background:#1d3326"></div>
      <div class="zone" style="left:{{ pb.progress.zone_early_pct }}%; width:{{ pb.progress.zone_mid_pct - pb.progress.zone_early_pct }}%; background:#38301a"></div>
      <div class="zone" style="left:{{ pb.progress.zone_mid_pct }}%; width:{{ 100 - pb.progress.zone_mid_pct }}%; background:#3a2020"></div>
      <div class="marker" style="left:{{ pb.progress.bar_pct }}%"></div>
    </div>
    <div class="lifelabels"><span>young</span><span>mid-life</span><span>old</span></div>
    <p style="margin:10px 0 4px"><b>{{ pb.progress.phase | upper }}</b> — {{ pb.progress.phase_note }}.</p>
    <p class="muted" style="margin:4px 0">
      {{ pb.progress.age_days }} trading days in, vs a median of {{ pb.progress.median_days }}
      across {{ pb.progress.n_history }} past {{ latest.quad_name }} periods.
      {{ pb.progress.pct_longer | round | int }}% of them lasted longer than this one has so far{% if pb.progress.median_remaining_days %} —
      and those that did typically ran another ~{{ pb.progress.median_remaining_days }} trading days
      (≈{{ (pb.progress.median_remaining_days / 5) | round(1) }} weeks){% endif %}.
      {{ help("Historical base rates from this classifier's own 2007-present history — odds and typical paths, not predictions. A young regime + STABLE radar = let winners run. An old regime + warnings = the odds of a shift compound.") }}
    </p>
    {% else %}
    <p class="muted">Not enough regime history for lifespan statistics yet.</p>
    {% endif %}
  </div>

  <!-- ======================= NEXT ======================= -->
  <div class="panel span6">
    <h2>What's likely next — and how to trade it
      {{ help("Simple historical frequencies: across every " + latest.quad_name + " period since 2007, which regime came next. These are base rates, not forecasts — but they tell you which playbook to keep warm. The watch names below are NOT buys yet; the evidence says anticipating rotations loses money — wait for the trend to confirm.") }}
    </h2>
    {% for n in pb.next_list %}
    <div class="prob">
      <span class="nm">{{ n.name }}</span>
      <span class="bar"><i style="width:{{ n.prob_pct }}%; background: var(--q{{ n.code[1] }})"></i></span>
      <span class="pc">{{ n.prob_pct }}%</span>
    </div>
    {% endfor %}
    {% if pb.watchlist %}
      <h3>Accumulation watchlist for that shift</h3>
      {% for x in pb.watchlist %}
        <div class="card"><span class="calltag tag-watch">WATCH — DON'T BUY YET</span>
          <b class="tk">{{ x.ticker }}</b> · {{ x.name }}<br>
          <span class="muted">{{ x.why }}</span></div>
      {% endfor %}
    {% endif %}
    <h3>The signals that would announce the shift</h3>
    <ul class="compact muted">
      {% for t in pb.triggers %}<li>{{ t }}</li>{% endfor %}
    </ul>
  </div>

  <!-- ======================= TRADE IT ======================= -->
  <div class="panel span12">
    <h2>How to trade the current regime
      {{ help("Built from conditions that held up in both halves of a 2007-2026 backtest. The dial is the headline: how much risk current conditions support. Sector calls below it are risk filters and confirmation tools — our research found no stable 'this sector will outperform' signal at monthly horizons, so anyone selling you that is curve-fitting.") }}
    </h2>
    <div class="dial">
      {% for p in ["DEFENSIVE","CAREFUL","NEUTRAL","CONSTRUCTIVE","AGGRESSIVE"] %}
        <span class="{{ 'active-' + p if pb.dial.posture == p }}">{{ p }}</span>
      {% endfor %}
    </div>
    {% for sign, r in pb.dial.reasons %}
      <div class="reason"><b class="sig sig-{{ {'+':'p','-':'m','i':'i'}[sign] }}">{{ {'+':'+','-':'−','i':'i'}[sign] }}</b> {{ r }}</div>
    {% endfor %}

    <div class="grid" style="margin-top:12px">
      <div class="span6">
        <h3>✅ Confirmed leadership — where participation is real
          {{ help("Sectors in an established uptrend vs the market with momentum still positive and not yet stretched. Descriptive — where the market's money already is. Use it to place exposure you already intend to take.") }}
        </h3>
        {% for x in pb.leaders %}
          <div class="card"><span class="calltag tag-lead">LEADER</span>
            <b class="tk">{{ x.ticker }}</b> · {{ x.name }}<br>
            <span class="muted">{{ x.why }}</span></div>
        {% else %}
          <p class="muted">No sector currently qualifies — leadership is either stretched or unconfirmed. That itself is information: stay close to the index.</p>
        {% endfor %}
        {% if pb.momentum_tilt.tickers %}
          <p class="muted" style="font-size:12px">Longer-horizon tilt: <b>
            {%- for t in pb.momentum_tilt.tickers %}{{ t.ticker }}{{ ", " if not loop.last }}{% endfor -%}
          </b> {{ help(pb.momentum_tilt.note) }}</p>
        {% endif %}
      </div>
      <div class="span6">
        <h3>🚫 Avoid right now — the evidence-backed don'ts
          {{ help("The strongest findings in our sector backtest were about what NOT to do: chasing stretched leaders lost 55% of the time; buying below-trend bounces lost in every variant tested. These warnings carry more statistical weight than any buy signal on this page.") }}
        </h3>
        {% for x in pb.avoid %}
          <div class="card"><span class="calltag tag-avoid">{{ x.call }}</span>
            <b class="tk">{{ x.ticker }}</b> · {{ x.name }}<br>
            <span class="muted">{{ x.why }}</span></div>
        {% else %}
          <p class="muted">Nothing currently triggers the avoid rules.</p>
        {% endfor %}
      </div>
    </div>
    <p class="muted" style="font-size:12px; margin-top:8px">⚖️ {{ pb.honesty }}</p>
  </div>
  {% endif %}

  <!-- ======================= SIGNALS ======================= -->
  <div class="panel span6">
    <h2>The two dials behind the regime
      {{ help("The regime label comes from two scores between -1 and +1, built from market prices (which lead) plus a small weight on economic data (which confirms). Growth above zero + inflation below zero = Goldilocks, and so on. The white marker is today.") }}
    </h2>
    <p style="margin:8px 0 0"><b>Growth: {{ "RISING" if latest.growth_score >= 0 else "FALLING" }}</b>
      <span class="muted">({{ "%+.2f" | format(latest.growth_score) }} of ±1 · agreement {{ (latest.growth_confidence * 100) | round | int }}%)</span>
      {{ help("Is the economy's growth impulse improving or deteriorating, as priced by markets: copper vs gold, consumer discretionary vs staples, small vs large caps, cyclical vs defensive sectors, the 2-year yield, breadth — confirmed slowly by payrolls and industrial production.") }}
    </p>
    <div class="gauge"><i style="left: {{ ((latest.growth_score + 1) / 2 * 100) | round(1) }}%"></i></div>
    <p style="margin:10px 0 0"><b>Inflation pressure: {{ "RISING" if latest.inflation_score >= 0 else "FALLING" }}</b>
      <span class="muted">({{ "%+.2f" | format(latest.inflation_score) }} of ±1 · agreement {{ (latest.inflation_confidence * 100) | round | int }}%)</span>
      {{ help("Is inflation pressure building or cooling, as priced by markets: bond-market inflation expectations, oil, energy-sector strength, and inflation-winner vs inflation-loser sector baskets.") }}
    </p>
    <div class="gauge"><i style="left: {{ ((latest.inflation_score + 1) / 2 * 100) | round(1) }}%"></i></div>

    <h3>What's voting for this regime
      {{ help("Each chip is one indicator inside the two dials. Green chips point WITH the regime call; red chips point AGAINST it. Lots of red = shaky ground (and lower 'signal agreement').") }}
    </h3>
    <div>
      {% for c in components_confirming %}<span class="chip chip-pos">{{ c }}</span>{% endfor %}
      {% for c in components_contradicting %}<span class="chip chip-neg">{{ c }}</span>{% endfor %}
      {% if not components_confirming and not components_contradicting %}<span class="muted">all quiet</span>{% endif %}
    </div>

    <h3>Weakest link
      {{ help("Of everything currently supporting the regime call, this indicator is closest to flipping sides — the single thing most likely to change the picture.") }}
    </h3>
    <p class="muted">{{ flip_plain }}</p>

    {% if latest.preference_check %}
    <h3>Does the market agree with the regime?
      {{ help("The regime implies certain sectors should lead. This checks whether they actually ARE. Agreement strengthens the call; disagreement is an early warning — when the tape stops cooperating with the story, the story is often about to change.") }}
    </h3>
    <p class="muted">{{ latest.preference_check.note }}
      {% if latest.preference_check.actual_ranks %}
        ({% for t, r in latest.preference_check.actual_ranks.items() %}{{ t }} is #{{ r }}{{ ", " if not loop.last }}{% endfor %} of {{ latest.sector_rs | length }})
      {% endif %}
    </p>
    {% endif %}
  </div>

  <!-- ======================= INTERNALS ======================= -->
  <div class="panel span6">
    <h2>Market internals — risk appetite gauges
      {{ help("Simple ratios between two assets; each answers a question about investor mood. Direction over the last 20 days matters more than the level. Green = moved in the risk-friendly direction.") }}
    </h2>
    <table>
      <tr><th class="l">gauge</th><th>20d change</th><th class="l">what it's saying</th></tr>
      {% for r in internals %}
      <tr>
        <td class="l">{{ r.label }} {{ help(r.tip) }}</td>
        <td class="{{ 'pos' if r.good else 'neg' }}">{{ "%+.2f" | format(r.chg) }}%</td>
        <td class="l muted">{{ r.verdict }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <!-- ======================= SECTORS ======================= -->
  <div class="panel span6">
    <h2>Sector scoreboard
      {{ help("Every sector vs the S&P 500 (so 'up' means beating the market). Sorted by 3-month relative momentum.") }}
    </h2>
    <table>
      <tr>
        <th class="l">sector</th>
        <th>stage {{ help("Rotation cycle position, from its trend vs the market: IMPROVING = momentum turning up, trend not yet confirmed (historically too early to buy!). LEADING = confirmed uptrend. WEAKENING = above trend, losing momentum. LAGGING = downtrend. Healthy sequence: improving → leading → weakening → lagging.") }}</th>
        <th>1mo {{ help("20-trading-day change in its ratio vs SPY — short-term relative momentum.") }}</th>
        <th>3mo {{ help("60-trading-day change vs SPY — the medium-term trend the playbook keys off.") }}</th>
        <th>year pos. {{ help("Where today's relative strength sits within its past year: 95 = near its yearly high vs the market (strong but possibly stretched), 5 = near its yearly low.") }}</th>
      </tr>
      {% for r in sector_rows %}
      <tr>
        <td class="l"><b>{{ r.ticker }}</b> <span class="muted">{{ r.name }}</span></td>
        <td><span class="pill" style="background:{{ r.stage_color }};color:{{ r.stage_fg }}">{{ r.stage }}</span></td>
        <td class="{{ 'pos' if r.mom_20d_pct > 0 else 'neg' }}">{{ "%+.1f" | format(r.mom_20d_pct) }}%</td>
        <td class="{{ 'pos' if r.mom_60d_pct > 0 else 'neg' }}">{{ "%+.1f" | format(r.mom_60d_pct) }}%</td>
        <td>{{ r.pctile_252d | round | int }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <div class="panel span6">
    <h2>Fed liquidity — the money tide
      {{ help("Top: net money in the system (Fed balance sheet minus reverse-repo minus the Treasury's account), in billions. Bottom: its 4-week change — the impulse. Green above the dotted line = expanding (historically the most reliable tailwind); red below = contracting.") }}
    </h2>
    <div class="chart">{{ chart_liquidity | safe }}</div>
  </div>

  <div class="panel span6">
    <h2>Credit stress & market breadth
      {{ help("Top: the extra yield junk-bond investors demand — the market's best early smoke detector; rising = stress building; below ~4% is calm. Bottom: % of S&P 500 stocks above their 50-day average — participation. Strong indexes with collapsing breadth are fragile.") }}
    </h2>
    <div class="chart">{{ chart_credit_breadth | safe }}</div>
  </div>

  <!-- ======================= POSITIONING ======================= -->
  <div class="panel span6">
    <h2>Who's positioned how
      {{ help("What different investor groups are doing — futures speculators (weekly, 3-day lag), active managers (NAAIM), the options market. The percentile column is the key: near 100 = most crowded in decades (contrarian warning), near 0 = washed out.") }}
    </h2>
    <table>
      <tr><th class="l">input</th><th>latest</th><th>percentile {{ help("Where today's reading sits in all stored history: 99 = more extreme than 99% of readings — crowded trades tend to reverse eventually. 50 = normal.") }}</th><th>as of</th></tr>
      {% for p in positioning %}
      <tr><td class="l">{{ p.name }} {{ help(p.tip) }}</td><td>{{ p.value }}</td><td>{{ p.pctile }}</td><td class="muted">{{ p.asof }}</td></tr>
      {% endfor %}
    </table>
  </div>

  <!-- ======================= HOLDINGS / FLOWS ======================= -->
  <div class="panel span12">
    <h2>Star fund managers' real moves
      {{ help("Daily holdings of the watchlist funds (ARK etc.) with mechanical flow effects stripped out — what's left is genuine manager conviction, visible the day after they trade.") }}
    </h2>
    {% if holdings_changes %}
      <table>
        <tr><th class="l">fund</th><th class="l">position</th><th>active chg</th><th>window</th></tr>
        {% for h in holdings_changes %}
        <tr><td class="l">{{ h.fund }}</td><td class="l">{{ h.position }}</td>
            <td class="{{ 'pos' if h.pct > 0 else 'neg' }}">{{ "%+.1f" | format(h.pct) }}%</td>
            <td class="muted">{{ h.window }}</td></tr>
        {% endfor %}
      </table>
    {% else %}
      <p class="muted">No significant manager moves in the current window (needs a few trading days of snapshots).</p>
    {% endif %}

    <h2 style="margin-top:16px">Where ETF money is flowing
      {{ help("Daily money in/out of each sector's main ETF, from share creations/redemptions (ΔShares × price). Positive = money entering. History builds from June 2026.") }}
    </h2>
    {% if flows_html %}
      {{ flows_html | safe }}
    {% else %}
      <p class="muted">Collecting — needs at least two daily snapshots per fund.</p>
    {% endif %}
  </div>

  <!-- ======================= HEALTH ======================= -->
  <div class="panel span12">
    <h2>Data health
      {{ help("Every data source this dashboard depends on. OK = fresh. STALE = no new data lately (signal confidence reduced automatically). FAILED = today's fetch broke (yesterday's data still used). BLOCKED = a known, documented limitation — not a malfunction. DEAD = failed 3+ runs and paused until it recovers.") }}
    </h2>
    <table>
      <tr><th class="l">source</th><th class="l">status</th><th>rows</th><th>last data</th><th class="l">note</th></tr>
      {% for s in health %}
      <tr>
        <td class="l">{{ s.name }}</td>
        <td class="l"><span class="pill pill-{{ s.status }}">{{ s.status }}</span></td>
        <td>{{ s.rows }}</td><td>{{ s.last_date or "—" }}</td>
        <td class="l muted">{{ s.error or "" }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted">A failed source never crashes the dashboard — affected signals just lose confidence until it heals.
       Generated {{ generated_utc }} UTC · <a href="history.html">history & charts</a> ·
       <a href="weekly.html">weekly deep-dive</a> · <a href="validation_timeline.html">full 2007→ backtest</a></p>
  </div>

</div>
</body>
</html>
