  --mx5-accent:        #22d97a;
  --mx5-accent-glow:   rgba(34,217,122,.30);
  --mx5-accent-dim:    rgba(34,217,122,.10);
  --mx5-warn:          #f59e0b;
  --mx5-warn-dim:      rgba(245,158,11,.10);
  /* v5.3 audit round: TEXT-role accents. Fills keep the bright hue above;
     text uses these so light mode swaps in the darker, ≥4.5:1 accent
     (theme.css already provides --up/--warn darkened for light). */
  --mx5-accent-ink:    var(--mx5-accent);
  --mx5-warn-ink:      var(--mx5-warn);
}
[data-theme="light"] body.page-macro.mx4-grid {
  --mx5-glass-bg:      rgba(255,255,255,.82);
  --mx5-pop-bg:        rgba(255,255,255,.97);
  --mx5-glass-border:  rgba(0,0,0,.06);
  --mx5-glass-shadow:  0 4px 24px rgba(0,0,0,.09), 0 1px 0 rgba(255,255,255,.95) inset;
  --mx5-glass-hover:   0 8px 32px rgba(0,0,0,.13), 0 1px 0 rgba(255,255,255,.95) inset;
  /* Dedicated dark accents for TEXT on the light glass card (>=4.5:1 vs ~#f6f7fa).
     Deliberately darker than the site-wide --up/--warn (which are tuned ~3.4:1
     for other surfaces); fills above keep the bright #22d97a / #f59e0b. */
  --mx5-accent-ink:    #17753f;
  --mx5-warn-ink:      #9c6212;
}
/* ── v5.3 UNIFIED card hover (Order 5): ONE idiom for every grid card/face.
   No accent-colored tints anywhere — border brightens, surface lifts ~2%,
   translateY(-1px), soft ambient shadow. Same both directions, 200ms ease-out. */
body.page-macro.mx4-grid {
  --mx5-hover-bg:      rgba(22,29,38,.62);
  --mx5-hover-border:  rgba(255,255,255,.16);
  --mx5-hover-shadow:  0 6px 24px rgba(0,0,0,.25);
  --mx5-focus-ring:    0 0 0 2px rgba(34,217,122,.55);
}
[data-theme="light"] body.page-macro.mx4-grid {
  --mx5-hover-bg:      rgba(255,255,255,.92);
  --mx5-hover-border:  rgba(0,0,0,.14);
  --mx5-hover-shadow:  0 6px 24px rgba(0,0,0,.12);
}

/* ── Aurora backdrop (fixed position, grid-view only) ───────────── */
body.page-macro.mx4-grid .mx5-aurora{
  position:fixed;inset:0;
  pointer-events:none;z-index:0;overflow:hidden;
}
body.page-macro.mx4-grid .mx5-aurora::before{
  content:"";position:absolute;
  width:900px;height:700px;top:-200px;left:-150px;
  border-radius:50%;filter:blur(90px);
  background:radial-gradient(ellipse,rgba(34,217,122,.12) 0%,transparent 70%);
}
body.page-macro.mx4-grid .mx5-aurora::after{
  content:"";position:absolute;
  width:700px;height:600px;bottom:-100px;right:-100px;
  border-radius:50%;filter:blur(90px);
  background:radial-gradient(ellipse,rgba(99,102,241,.10) 0%,transparent 70%);
}
body.page-macro.mx4-grid .mx5-aurora .mx5-a3{
  position:absolute;width:600px;height:500px;
  top:40%;left:50%;transform:translate(-50%,-50%);
  border-radius:50%;filter:blur(90px);
  background:radial-gradient(ellipse,rgba(34,217,122,.07) 0%,transparent 70%);
}
body.page-macro.mx4-grid .mx5-aurora .mx5-a4{
  position:absolute;width:800px;height:600px;bottom:-150px;left:20%;
  border-radius:50%;filter:blur(90px);
  background:radial-gradient(ellipse,rgba(99,102,241,.08) 0%,transparent 70%);
}
[data-theme="light"] body.page-macro.mx4-grid .mx5-aurora::before{background:radial-gradient(ellipse,rgba(14,165,98,.06) 0%,transparent 70%);}
[data-theme="light"] body.page-macro.mx4-grid .mx5-aurora::after {background:radial-gradient(ellipse,rgba(99,102,241,.05) 0%,transparent 70%);}
[data-theme="light"] body.page-macro.mx4-grid .mx5-aurora .mx5-a3{background:radial-gradient(ellipse,rgba(14,165,98,.04) 0%,transparent 70%);}
[data-theme="light"] body.page-macro.mx4-grid .mx5-aurora .mx5-a4{background:radial-gradient(ellipse,rgba(99,102,241,.04) 0%,transparent 70%);}
@media(prefers-reduced-motion:reduce){
  body.page-macro.mx4-grid .mx5-aurora::before,
  body.page-macro.mx4-grid .mx5-aurora::after,
  body.page-macro.mx4-grid .mx5-aurora .mx5-a3{animation:none;}
  /* Order 5: unified hover — no motion (instant, no lift) under reduced-motion */
  body.page-macro.mx4-grid .sxg-face.mx5-card-face,
  body.page-macro.mx4-grid .mx5-card[role="button"],
  body.page-macro.mx4-grid .mx5-mkt-tile{transition:none!important;}
  body.page-macro.mx4-grid .sx:hover .sxg-face.mx5-card-face,
  body.page-macro.mx4-grid .sxg-face.mx5-card-face:hover,
  body.page-macro.mx4-grid .mx5-card[role="button"]:hover,
  body.page-macro.mx4-grid .mx5-mkt-tile:hover,
  body.page-macro.mx4-grid .mx5-mkt-tile.up:hover,
  body.page-macro.mx4-grid .mx5-mkt-tile.dn:hover{transform:none!important;}
}

/* ── Command Scorecard — #regime-radar restyled in grid view ─────── */
/* In grid view, #regime-radar becomes a two-column glass card:
   left = gauge cluster, right = 60-session path (hidden ≤700px) */
body.page-macro.mx4-grid #regime-radar{
  background:var(--mx5-glass-bg);
  border:1px solid var(--mx5-glass-border);
  border-radius:var(--mx5-radius-card);
  backdrop-filter:var(--mx5-blur);
  box-shadow:var(--mx5-glass-shadow);
  padding:0;overflow:visible;
  display:grid;
  /* Order 2: ~30:70 left:right (more room for the command cluster, less for the chart) */
  grid-template-columns:minmax(0,3fr) minmax(0,7fr);
  gap:0;
  min-height:320px;
  position:relative;
}
/* Ledger view: restore normal panel look */
body.page-macro:not(.mx4-grid) #regime-radar{
  display:block;padding:19px 21px;
}
@media(max-width:1100px){
  body.page-macro.mx4-grid #regime-radar{grid-template-columns:minmax(0,34fr) minmax(0,66fr);}
}
@media(max-width:700px){
  body.page-macro.mx4-grid #regime-radar{grid-template-columns:1fr;}
}

/* ── mx2-hero: hidden in grid view (scorecard replaces it) ── */
body.page-macro.mx4-grid #regime-radar .mx2-hero{
  display:none!important;
}
/* ── alerts toggle + misc hero bits: hidden in grid ── */
body.page-macro.mx4-grid #regime-radar .ms-head,
body.page-macro.mx4-grid #regime-radar .ms-oneline,
body.page-macro.mx4-grid #regime-radar .howto,
body.page-macro.mx4-grid #regime-radar > script + div > .ms-head{
  display:none;
}

/* ── Scorecard left cluster ──────────────────────────────────────── */
body.page-macro.mx4-grid .mx5-sc-left{
  padding:28px 26px 22px;
  border-right:1px solid rgba(255,255,255,.07);
  display:flex;flex-direction:column;
  position:relative;overflow:visible;
}
[data-theme="light"] body.page-macro.mx4-grid .mx5-sc-left{
  border-right-color:rgba(0,0,0,.06);
}
body.page-macro.mx4-grid .mx5-sc-gauge-row{
  display:flex;align-items:center;gap:20px;margin-bottom:16px;
}
body.page-macro.mx4-grid .mx5-gauge-svg{
  /* Order 2: scaled up ~1.37× (viewBox unchanged → JS gauge math contract intact) */
  width:192px;height:120px;overflow:visible;display:block;flex-shrink:0;
}

/* Regime pill (Order 3: smaller + never clips — sizes to content, no fixed width) */
body.page-macro.mx4-grid .mx5-regime-pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 11px;border-radius:var(--mx5-radius-pill);
  border:1px solid var(--mx5-accent);background:var(--mx5-accent-dim);
  font-size:11px;font-weight:600;color:var(--mx5-accent-ink);
  letter-spacing:.02em;margin-bottom:10px;line-height:1.3;
  max-width:100%;box-sizing:border-box;white-space:nowrap;width:auto;
}
/* The pill's text span must not be forced to shrink below its content */
body.page-macro.mx4-grid .mx5-regime-pill > span{flex:0 0 auto;}
body.page-macro.mx4-grid .mx5-regime-pill .mx5-dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--mx5-accent);box-shadow:0 0 6px var(--mx5-accent-glow);
}

/* Score + verdict beside gauge */
body.page-macro.mx4-grid .mx5-score-line{
  display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;
}
/* verdict word never breaks mid-word; wraps as a whole unit if the column is tight */
body.page-macro.mx4-grid .mx5-verdict-word{white-space:nowrap;}
body.page-macro.mx4-grid .mx5-big-score{
  font-size:68px;font-weight:800;line-height:.95;color:var(--mx5-accent-ink);
  text-shadow:0 0 40px var(--mx5-accent-glow);
  letter-spacing:-.035em;font-variant-numeric:tabular-nums;
}
body.page-macro.mx4-grid .mx5-verdict-word{
  font-size:19px;font-weight:700;color:var(--ink-1,var(--text,rgba(255,255,255,.92)));
}
body.page-macro.mx4-grid .mx5-sub-line{
  font-size:11px;color:var(--mx5-accent-ink);font-weight:600;margin-top:3px;
}
/* score color by state */
body.page-macro.mx4-grid.ms-green-page .mx5-big-score,
body.page-macro.mx4-grid .mx5-score-green .mx5-big-score{color:var(--up,#22d97a);text-shadow:0 0 36px rgba(34,217,122,.3);}
body.page-macro.mx4-grid.ms-yellow-page .mx5-big-score,
body.page-macro.mx4-grid .mx5-score-yellow .mx5-big-score{color:var(--warn,#f59e0b);text-shadow:0 0 36px rgba(245,158,11,.3);}
body.page-macro.mx4-grid.ms-red-page .mx5-big-score,
body.page-macro.mx4-grid .mx5-score-red .mx5-big-score{color:var(--down,#ef4444);text-shadow:0 0 36px rgba(239,68,68,.3);}
/* v6 — STATE drives the hero glance (operator order 2026-07-13). The gauge arc, needle
   accent, glow and score numeral all follow the risk-STATE band (--mx5-gauge), never a fixed
   rainbow or the regime hue — so a caution/Mixed state reads amber, not "green/go". --mx5-gauge
   and --mx5-accent route through --up/--warn/--down, so they also honour the zh 红涨绿跌 swap
   (risk-on=red, risk-off=green in Chinese). The slow regime (e.g. Goldilocks) is demoted to a
   neutral label so it never competes with the stance colour. */
body.page-macro.mx4-grid .mx5-score-green  { --mx5-gauge: var(--up);   --mx5-accent: var(--up);   }
body.page-macro.mx4-grid .mx5-score-yellow { --mx5-gauge: var(--warn); --mx5-accent: var(--warn); }
body.page-macro.mx4-grid .mx5-score-red    { --mx5-gauge: var(--down); --mx5-accent: var(--down); }
body.page-macro.mx4-grid .mx5-sc-gauge-row {
  --mx5-accent-glow: color-mix(in srgb, var(--mx5-accent) 30%, transparent);
  --mx5-accent-dim:  color-mix(in srgb, var(--mx5-accent) 10%, transparent);
}
/* CSS wins over the SVG presentation attribute, so the arc + numeral recolour by state
   (and var() resolves here, unlike in a bare SVG stroke="" attribute). */
body.page-macro.mx4-grid #mx5-gauge-arc-fill { stroke: var(--mx5-gauge, #f59e0b); }
body.page-macro.mx4-grid #mx5-score-numeral  { fill: var(--mx5-gauge, #f59e0b); }
/* Regime pill → neutral grey label (state owns the glance colour now) */
body.page-macro.mx4-grid .mx5-regime-pill { border-color: var(--line); background: transparent; color: var(--muted); }
body.page-macro.mx4-grid .mx5-regime-pill .mx5-dot { background: var(--muted); box-shadow: none; }

/* Thesis + flip */
body.page-macro.mx4-grid .mx5-thesis{
  font-size:13px;font-weight:450;line-height:1.55;
  color:var(--ink-1,rgba(255,255,255,.92));
  margin:12px 0 10px;
  padding-left:0;
}
body.page-macro.mx4-grid .mx5-flip{
  font-size:11px;color:var(--ink-2,rgba(255,255,255,.6));
  padding:8px 11px;
  background:var(--mx5-warn-dim);
  border:1px solid rgba(245,158,11,.18);
  border-radius:9px;line-height:1.5;
}
body.page-macro.mx4-grid .mx5-flip-arrow{color:var(--mx5-warn-ink);}

/* Popover trigger buttons row */
body.page-macro.mx4-grid .mx5-btn-row{
  display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;
  position:relative;
}
body.page-macro.mx4-grid .mx5-sc-btn{
  display:inline-flex;align-items:center;gap:6px;
  padding:7px 13px;border-radius:var(--mx5-radius-pill);
  border:1px solid var(--mx5-glass-border);
  background:var(--mx5-glass-bg);backdrop-filter:blur(12px);
  color:var(--ink-2,rgba(255,255,255,.6));
  font-size:11px;font-weight:600;cursor:pointer;
  font-family:inherit;
  transition:color .15s,border-color .15s,background .15s;
}
body.page-macro.mx4-grid .mx5-sc-btn:hover{
  color:var(--ink-1,rgba(255,255,255,.92));
  border-color:rgba(255,255,255,.20);
  background:rgba(255,255,255,.14);
}
body.page-macro.mx4-grid .mx5-sc-btn[aria-expanded="true"]{
  color:var(--ink-1,rgba(255,255,255,.92));
  border-color:rgba(255,255,255,.24);
  background:rgba(255,255,255,.16);
}
body.page-macro.mx4-grid .mx5-sc-btn-warn{
  color:var(--mx5-warn-ink);
  border-color:rgba(245,158,11,.28);
  background:rgba(245,158,11,.07);
}
body.page-macro.mx4-grid .mx5-sc-btn-warn:hover{
  background:rgba(245,158,11,.13);border-color:rgba(245,158,11,.40);
}
body.page-macro.mx4-grid .mx5-sc-btn-warn[aria-expanded="true"]{
  background:rgba(245,158,11,.13);border-color:rgba(245,158,11,.40);
}
body.page-macro.mx4-grid .mx5-sc-btn:focus-visible{
  outline:2px solid var(--link,#22d97a);outline-offset:2px;
}

/* ── 60-session path panel (right) ──────────────────────────────── */
body.page-macro.mx4-grid .mx5-sc-right{
  padding:22px 28px 20px;display:flex;flex-direction:column;
}
body.page-macro.mx4-grid .mx5-path-header{
  display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px;
}
body.page-macro.mx4-grid .mx5-path-title{
  font-size:11px;font-weight:700;letter-spacing:.10em;
  text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));
}
body.page-macro.mx4-grid .mx5-path-meta{font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));}
/* Plot wrapper hosts the SVG + the screen-space JS hover overlays */
body.page-macro.mx4-grid .mx5-path-plot{
  position:relative;flex:1;min-height:190px;display:flex;
}
body.page-macro.mx4-grid .mx5-path-svg{
  display:block;width:100%;flex:1;min-height:190px;overflow:visible;
  touch-action:pan-y;
}
/* Axis-label + today-marker overlay — screen-space HTML so glyphs and the dot are
   never distorted by the SVG's preserveAspectRatio="none" fill-stretch. Positioned
   by % of the plot box (which the SVG fills exactly) so they track the gridlines. */
body.page-macro.mx4-grid .mx5-path-labels{
  position:absolute;inset:0;pointer-events:none;
  font-family:-apple-system,Inter,sans-serif;font-size:11px;line-height:1;
}
body.page-macro.mx4-grid .mx5-path-labels span{position:absolute;white-space:nowrap;}
body.page-macro.mx4-grid .mx5-pl-y{
  left:6px;transform:translateY(-50%);
  color:var(--ink-3,rgba(255,255,255,.32));font-variant-numeric:tabular-nums;
}
body.page-macro.mx4-grid .mx5-pl-zone{
  right:14px;transform:translateY(-50%);font-weight:600;
}
body.page-macro.mx4-grid .mx5-pl-zone.on{color:rgba(34,217,122,.62);}
body.page-macro.mx4-grid .mx5-pl-zone.mid{color:rgba(245,158,11,.66);}
body.page-macro.mx4-grid .mx5-pl-zone.off{color:rgba(239,68,68,.60);}
/* zh 红涨绿跌: Risk-on(偏多)=bullish→red, Risk-off(偏空)=bearish→green (mid amber stays) */
html[data-lang="zh"] body.page-macro.mx4-grid .mx5-pl-zone.on{color:rgba(239,68,68,.60);}
html[data-lang="zh"] body.page-macro.mx4-grid .mx5-pl-zone.off{color:rgba(34,217,122,.62);}
body.page-macro.mx4-grid .mx5-pl-x{
  top:96.4%;color:var(--ink-3,rgba(255,255,255,.34));
}
body.page-macro.mx4-grid .mx5-pl-today{
  width:9px;height:9px;border-radius:50%;
  transform:translate(-50%,-50%);
  background:currentColor;box-shadow:0 0 6px currentColor;
}
/* ── Hover enhancement layer (Order 1c) — pure screen-space, hidden until JS shows ── */
body.page-macro.mx4-grid .mx5-path-cross{
  position:absolute;top:0;width:1px;height:100%;
  background:linear-gradient(rgba(255,255,255,.28),rgba(255,255,255,.06));
  opacity:0;transform:translateX(-1px);pointer-events:none;
  transition:opacity .12s ease-out;will-change:left,opacity;
}
body.page-macro.mx4-grid .mx5-path-dot{
  position:absolute;width:11px;height:11px;border-radius:50%;
  background:var(--mx5-accent);border:2px solid var(--mx5-pop-bg,#0d121a);
  box-shadow:0 0 10px var(--mx5-accent-glow),0 0 0 1px rgba(255,255,255,.25);
  opacity:0;pointer-events:none;transform:translate(-50%,-50%);
  transition:opacity .12s ease-out;will-change:left,top,opacity;
}
body.page-macro.mx4-grid .mx5-path-tip{
  position:absolute;z-index:6;pointer-events:none;
  display:flex;flex-direction:column;gap:2px;
  padding:8px 11px;border-radius:10px;
  background:rgba(15,19,26,.72);
  border:1px solid rgba(255,255,255,.12);
  box-shadow:0 8px 30px rgba(0,0,0,.5);
  backdrop-filter:blur(16px) saturate(1.3);-webkit-backdrop-filter:blur(16px) saturate(1.3);
  opacity:0;transform:translate(-50%,calc(-100% - 14px)) translateY(4px);
  transition:opacity .13s ease-out,transform .13s ease-out;
  white-space:nowrap;
}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  body.page-macro.mx4-grid .mx5-path-tip{background:var(--mx5-pop-bg,rgba(13,18,26,.98));}
}
[data-theme="light"] body.page-macro.mx4-grid .mx5-path-tip{
  background:rgba(255,255,255,.82);border-color:rgba(0,0,0,.10);
  box-shadow:0 8px 30px rgba(0,0,0,.16);
}
body.page-macro.mx4-grid .mx5-path-tip.show{opacity:1;transform:translate(-50%,calc(-100% - 14px));}
body.page-macro.mx4-grid .mx5-path-tip-date{
  font-size:11px;font-weight:600;letter-spacing:.03em;
  color:var(--ink-3,rgba(255,255,255,.5));text-transform:uppercase;
}
[data-theme="light"] body.page-macro.mx4-grid .mx5-path-tip-date{color:rgba(0,0,0,.5);}
body.page-macro.mx4-grid .mx5-path-tip-row{display:flex;align-items:baseline;gap:7px;}
body.page-macro.mx4-grid .mx5-path-tip-score{
  font-size:16px;font-weight:800;line-height:1;color:var(--ink-1,rgba(255,255,255,.95));
  font-variant-numeric:tabular-nums;
}
[data-theme="light"] body.page-macro.mx4-grid .mx5-path-tip-score{color:rgba(0,0,0,.9);}
body.page-macro.mx4-grid .mx5-path-tip-verdict{font-size:12px;font-weight:600;}
@media(prefers-reduced-motion:reduce){
  body.page-macro.mx4-grid .mx5-path-cross,
  body.page-macro.mx4-grid .mx5-path-dot,
  body.page-macro.mx4-grid .mx5-path-tip{transition:none;}
}
/* Hidden on mobile (spec §0) */
@media(max-width:700px){
  body.page-macro.mx4-grid .mx5-sc-right{display:none;}
}
/* D4: prevent horizontal scroll at narrow viewports — reduce padding, gauge, score */
@media(max-width:560px){
  body.page-macro.mx4-grid .mx5-sc-left{padding:16px 12px 14px;}
  body.page-macro.mx4-grid .mx5-sc-gauge-row{gap:10px;margin-bottom:10px;}
  body.page-macro.mx4-grid .mx5-gauge-svg{width:90px;height:58px;}
  body.page-macro.mx4-grid .mx5-big-score{font-size:34px;}
  body.page-macro.mx4-grid .mx5-verdict-word{font-size:13px;}
}

/* ── Popover system ─────────────────────────────────────────────── */
/* Fixed dim backdrop (z-90) */
.mx5-popover-backdrop{
  display:none;position:fixed;inset:0;
  background:rgba(0,0,0,.32);z-index:90;
}
.mx5-popover-backdrop.open{display:block;}

/* Popover panel */
.mx5-popover{
  display:none;position:absolute;z-index:100;
  background:var(--mx5-pop-bg,rgba(13,18,26,.96));
  border:1px solid var(--mx5-glass-border,rgba(255,255,255,.12));
  border-radius:var(--mx5-radius-card,18px);
  backdrop-filter:blur(32px);
  box-shadow:0 24px 64px rgba(0,0,0,.72),0 1.5px 0 rgba(255,255,255,.09) inset;
  padding:24px;min-width:320px;max-width:440px;
  top:calc(100% + 8px);left:0;
  transform-origin:top left;
}
.mx5-popover.open{display:block;}
@media(prefers-reduced-motion:no-preference){
  .mx5-popover{
    opacity:0;transform:scale(.97) translateY(-8px);
    transition:opacity 220ms cubic-bezier(.22,.68,0,1.2),transform 220ms cubic-bezier(.22,.68,0,1.2);
  }
  .mx5-popover.open{opacity:1;transform:scale(1) translateY(0);}
}
/* Right-anchored popover */
.mx5-popover.mx5-pop-right{left:auto;right:0;transform-origin:top right;}

/* Lift the parent card above the backdrop when popover open (stacking context fix) */
body.page-macro.mx4-grid #regime-radar.mx5-pop-open{
  z-index:95;position:relative;
}
.mx5-popover-title{
  font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:18px;
}

/* Mobile bottom-sheet (spec §0 — ≤700px) */
@media(max-width:700px){
  /* Remove backdrop-filter from hero card when popover open — backdrop-filter creates a
     new containing block that traps position:fixed children (CSS spec §9.3.1).
     Without this the bottom-sheet sticks to the card edge, not the viewport bottom. */
  body.page-macro.mx4-grid #regime-radar.mx5-pop-open{
    backdrop-filter:none!important;
    -webkit-backdrop-filter:none!important;
  }
  .mx5-popover{
    position:fixed!important;
    left:12px!important;right:12px!important;
    bottom:0!important;top:auto!important;
    max-width:none;width:auto;min-width:0!important; /* D3: override 320px base min-width so left/right:12px fully constrains at ≤344px */
    max-height:70vh;overflow-y:auto;
    border-radius:var(--mx5-radius-card) var(--mx5-radius-card) 0 0;
    transform-origin:bottom center;
    background:var(--mx5-pop-bg,rgba(13,18,26,.96));
    padding-top:44px; /* room for the sticky close bar */
  }
  /* Sticky close bar at top of bottom-sheet */
  .mx5-pop-close-bar{
    display:flex;align-items:center;justify-content:space-between;
    position:sticky;top:0;z-index:2;
    background:var(--mx5-pop-bg,rgba(13,18,26,.96));
    padding:12px 4px 10px;
    margin:-44px -24px 14px; /* full-bleed to popover edges */
  }
  .mx5-pop-close-handle{
    width:36px;height:4px;border-radius:2px;
    background:rgba(255,255,255,.18);margin:0 auto;
  }
  .mx5-pop-close-btn{
    display:flex;align-items:center;justify-content:center;
    width:32px;height:32px;border-radius:50%;
    background:rgba(255,255,255,.08);border:none;cursor:pointer;
    color:var(--ink-2,rgba(255,255,255,.6));font-size:18px;line-height:1;
    font-family:inherit;flex-shrink:0;
  }
  .mx5-pop-close-btn:hover{background:rgba(255,255,255,.14);}
  /* Touch target ≥44px for popover trigger buttons */
  body.page-macro.mx4-grid .mx5-sc-btn{min-height:44px;padding-top:10px;padding-bottom:10px;}
  @media(prefers-reduced-motion:no-preference){
    .mx5-popover{opacity:0;transform:translateY(20px);}
    .mx5-popover.open{opacity:1;transform:translateY(0);}
  }
}
/* Close bar hidden on desktop (bottom-sheet is mobile-only) */
@media(min-width:701px){
  .mx5-pop-close-bar{display:none;}
}

/* ── Factor breakdown (inside popover) ─────────────────────────── */
.mx5-factors-inner{display:flex;flex-direction:column;gap:14px;}
.mx5-factor-row{display:flex;flex-direction:column;gap:6px;}
.mx5-factor-header{display:flex;justify-content:space-between;align-items:baseline;}
.mx5-factor-name{font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));font-weight:500;}
.mx5-factor-score{font-size:16px;font-weight:700;color:var(--ink-1,rgba(255,255,255,.92));}
.mx5-factor-score.weak{color:var(--mx5-warn-ink);}
.mx5-factor-bar-track{height:7px;border-radius:4px;background:rgba(255,255,255,.07);position:relative;}
.mx5-factor-bar-fill{height:100%;border-radius:4px;position:relative;
  background:linear-gradient(90deg,rgba(34,217,122,.45),var(--mx5-accent));}
.mx5-factor-bar-fill.weak{background:linear-gradient(90deg,rgba(245,158,11,.45),var(--mx5-warn));}
.mx5-factor-bar-fill::after{
  content:"";position:absolute;right:-2px;top:-3px;
  width:13px;height:13px;border-radius:50%;
  background:var(--mx5-accent);box-shadow:0 0 7px var(--mx5-accent-glow),0 0 16px var(--mx5-accent-glow);
}
.mx5-factor-bar-fill.weak::after{
  background:var(--mx5-warn);box-shadow:0 0 7px rgba(245,158,11,.5);
}
.mx5-factor-weak-tag{
  font-size:11px;color:var(--mx5-warn-ink);font-weight:700;letter-spacing:.05em;margin-top:3px;
}

/* ── Risk Scare Ladder (inside popover) ─────────────────────────── */
.mx5-scare-dominant-row{display:flex;align-items:baseline;gap:10px;margin-bottom:6px;}
.mx5-scare-dominant-num{font-size:48px;font-weight:800;letter-spacing:-.03em;color:var(--mx5-warn-ink);line-height:1;}
.mx5-scare-dominant-title{font-size:15px;font-weight:700;color:var(--mx5-warn-ink);}
.mx5-scare-driver{font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:20px;line-height:1.5;}
.mx5-scare-list{display:flex;flex-direction:column;gap:13px;}
.mx5-scare-item{display:flex;flex-direction:column;gap:4px;}
.mx5-scare-item-header{display:flex;justify-content:space-between;align-items:baseline;}
.mx5-scare-item-name{font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));font-weight:500;}
.mx5-scare-item-val{font-size:14px;font-weight:700;}
.mx5-scare-item-val.top{color:var(--mx5-warn-ink);}
.mx5-scare-item-val.lower{color:var(--ink-2,rgba(255,255,255,.6));}
.mx5-scare-meter{height:5px;border-radius:3px;background:rgba(255,255,255,.07);overflow:hidden;}
.mx5-scare-fill{height:100%;border-radius:3px;}
.mx5-scare-fill.hi {background:linear-gradient(90deg,rgba(245,158,11,.5),var(--mx5-warn));}
.mx5-scare-fill.mid{background:rgba(245,158,11,.55);}
.mx5-scare-fill.lo {background:rgba(245,158,11,.35);}
.mx5-scare-item-label{font-size:11px;color:var(--mx5-warn-ink);font-weight:600;letter-spacing:.04em;}

/* Popover footer */
.mx5-pop-footer{
  margin-top:16px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08);
  font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));
}
[data-theme="light"] .mx5-pop-footer{border-top-color:rgba(0,0,0,.07);}
.mx5-pop-footer-link{
  background:none;border:none;cursor:pointer;font-size:11px;font-weight:600;
  color:var(--mx5-accent-ink);font-family:inherit;padding:0;
  text-decoration:underline;text-decoration-color:transparent;
  transition:text-decoration-color .15s;
}
.mx5-pop-footer-link:hover{text-decoration-color:var(--mx5-accent-ink);}

/* ══════════════════════════════════════════════════════════════════
   v5.1 — mx5OpenDlg centered dialog system (§2 addendum)
   Desktop: centered fixed glass dialog 980px / 82vh
   Mobile ≤700px: bottom sheet, 12px sides, 85vh, sticky close bar
   ══════════════════════════════════════════════════════════════════ */

/* Scroll-lock while dialog open */
/* v5.3 audit round M03: the document scroller is <html>, not <body>, so
   body{overflow:hidden} alone leaked wheel/scroll to the background. Lock the
   real scroller: html.mx5-dlg-lock pins the page while a dialog is open; JS
   restores scrollY on close (position:fixed keeps iOS from scrolling <html>). */
html.mx5-dlg-lock{ overflow:hidden; }
html.mx5-dlg-lock body{ overflow:hidden; position:fixed; width:100%; }
body.mx5-dlg-open{ overflow:hidden; }

/* Backdrop dim */
.mx5-dlg{
  display:none;position:fixed;inset:0;z-index:200;
  align-items:center;justify-content:center;
}
.mx5-dlg.open{ display:flex; }
.mx5-dlg-backdrop{
  position:absolute;inset:0;
  background:rgba(3,6,10,.58);
  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);
}

/* ── Order 4: FROSTED glass panel ──────────────────────────────────
   Deep blur + saturate; translucent fill (legibility verified over the hero);
   inner hairline + deep soft shadow. @supports fallback to near-opaque fill
   when backdrop-filter is unavailable. backdrop-filter creates a containing
   block + its own stacking context — sticky header inside still works because
   it is a normal-flow descendant of this scroll container. */
.mx5-dlg-panel{
  position:relative;z-index:1;
  max-width:980px;width:calc(100% - 48px);
  max-height:82vh;
  background:rgba(13,17,24,.88);
  border:1px solid rgba(255,255,255,.10);
  border-radius:var(--mx5-radius-card,18px);
  backdrop-filter:blur(28px) saturate(1.4);
  -webkit-backdrop-filter:blur(28px) saturate(1.4);
  box-shadow:0 40px 120px rgba(0,0,0,.72),
             0 2px 0 rgba(255,255,255,.06) inset,
             0 0 0 1px rgba(255,255,255,.04);
  overflow-y:auto;
  display:flex;flex-direction:column;
}
[data-theme="light"] .mx5-dlg-panel{
  background:rgba(255,255,255,.82);
  border-color:rgba(255,255,255,.6);
  box-shadow:0 32px 96px rgba(0,0,0,.18),
             0 1px 0 rgba(255,255,255,.9) inset,
             0 0 0 1px rgba(0,0,0,.04);
}
/* No blur support → near-opaque fill so body copy stays ≥4.5:1 over any bg */
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .mx5-dlg-panel{background:var(--mx5-pop-bg,rgba(13,18,26,.98));}
  [data-theme="light"] .mx5-dlg-panel{background:var(--mx5-pop-bg,rgba(255,255,255,.98));}
}
/* v5.3 audit round M09: dialogs whose whole body is one compact row (Deep
   Context = a single strip of linked-surface shortcuts) size to their content
   instead of the full 980px shell, so the panel isn't mostly empty. */
.mx5-dlg-panel-narrow{ max-width:640px; }

/* Dialog header (sticky). Frosted panel is translucent, so the sticky header needs
   its own denser fill + blur or scrolled body copy bleeds through the title. */
.mx5-dlg-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:20px 26px 16px;
  position:sticky;top:0;z-index:2;
  background:rgba(13,17,24,.92);
  backdrop-filter:blur(20px) saturate(1.4);-webkit-backdrop-filter:blur(20px) saturate(1.4);
  border-bottom:1px solid rgba(255,255,255,.07);
}
[data-theme="light"] .mx5-dlg-header{
  background:rgba(255,255,255,.88);border-bottom-color:rgba(0,0,0,.07);
}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
  .mx5-dlg-header{background:var(--mx5-pop-bg,rgba(13,18,26,.98));}
  [data-theme="light"] .mx5-dlg-header{background:var(--mx5-pop-bg,rgba(255,255,255,.98));}
}
.mx5-dlg-title{
  font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  color:var(--ink-3,rgba(255,255,255,.36));
}
.mx5-dlg-close{
  display:flex;align-items:center;justify-content:center;
  width:32px;height:32px;border-radius:50%;
  background:rgba(255,255,255,.07);border:none;cursor:pointer;
  color:var(--ink-2,rgba(255,255,255,.6));font-size:18px;line-height:1;
  font-family:inherit;flex-shrink:0;
  transition:background .15s;
}
.mx5-dlg-close:hover{background:rgba(255,255,255,.14);}
.mx5-dlg-close:focus-visible{outline:2px solid var(--link,#22d97a);outline-offset:2px;}

/* Dialog body */
.mx5-dlg-body{
  padding:24px 26px 28px;flex:1;overflow-y:auto;
}

/* ── Order 4: entrance / exit animation (desktop) ──────────────────
   .open just makes it display:flex (start state painted). JS then adds
   .mx5-dlg-in on the next frame so these transitions actually run.
   Backdrop fades 240ms; panel opacity + translateY(14px) + scale(.965)
   over 320ms; interior sections stagger-fade-up 40ms apart (cap 5).
   Close reverses at ~180ms (JS removes .mx5-dlg-in, then hides). */
@media(prefers-reduced-motion:no-preference){
  .mx5-dlg-backdrop{
    opacity:0;transition:opacity 240ms ease-out;
  }
  .mx5-dlg.mx5-dlg-in .mx5-dlg-backdrop{opacity:1;}
  .mx5-dlg-panel{
    opacity:0;transform:translateY(14px) scale(.965);
    transition:opacity 320ms cubic-bezier(.22,.9,.26,1.02),
               transform 320ms cubic-bezier(.22,.9,.26,1.02);
  }
  .mx5-dlg.mx5-dlg-in .mx5-dlg-panel{opacity:1;transform:translateY(0) scale(1);}
  /* faster close */
  .mx5-dlg.mx5-dlg-closing .mx5-dlg-backdrop{transition-duration:180ms;}
  .mx5-dlg.mx5-dlg-closing .mx5-dlg-panel{transition-duration:180ms;}
  /* interior stagger — first 5 direct children of the body rise in sequence */
  .mx5-dlg-body > *{
    opacity:0;transform:translateY(10px);
    transition:opacity 300ms ease-out,transform 300ms cubic-bezier(.22,.9,.26,1.02);
  }
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *{opacity:1;transform:translateY(0);}
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *:nth-child(1){transition-delay:60ms;}
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *:nth-child(2){transition-delay:100ms;}
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *:nth-child(3){transition-delay:140ms;}
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *:nth-child(4){transition-delay:180ms;}
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *:nth-child(5){transition-delay:220ms;}
  /* cap: children 6+ simply appear with the panel (no stagger, no delay) */
  .mx5-dlg.mx5-dlg-in .mx5-dlg-body > *:nth-child(n+6){transition-delay:0ms;}
  .mx5-dlg-closing .mx5-dlg-body > *{transition-delay:0ms!important;}
}
/* Reduced-motion OR no-JS: fully visible the instant .open lands (never stuck at 0) */
@media(prefers-reduced-motion:reduce){
  .mx5-dlg.open .mx5-dlg-backdrop{opacity:1;}
  .mx5-dlg.open .mx5-dlg-panel{opacity:1;transform:none;}
  .mx5-dlg.open .mx5-dlg-body > *{opacity:1;transform:none;}
}

/* Mobile bottom sheet (≤700px) */
@media(max-width:700px){
  .mx5-dlg{ align-items:flex-end; }
  .mx5-dlg-panel{
    width:calc(100% - 24px);max-width:none;
    max-height:85vh;
    border-radius:var(--mx5-radius-card,18px) var(--mx5-radius-card,18px) 0 0;
    margin:0 12px;
  }
  /* 44px min-touch on header close button */
  .mx5-dlg-close{width:44px;height:44px;font-size:22px;}
  /* No horizontal overflow inside dialogs at narrow widths */
  .mx5-dlg-body{padding:20px 18px 28px;overflow-x:hidden;}
  .mx5-dlg-header{padding:16px 18px 12px;}
  /* Order 4: bottom-sheet slide-up (translateY(100%)→0, 260ms) */
  @media(prefers-reduced-motion:no-preference){
    .mx5-dlg-panel{
      opacity:1;transform:translateY(100%) scale(1);
      transition:transform 260ms cubic-bezier(.22,.9,.26,1.02);
    }
    .mx5-dlg.mx5-dlg-in .mx5-dlg-panel{transform:translateY(0) scale(1);}
    .mx5-dlg.mx5-dlg-closing .mx5-dlg-panel{transition-duration:200ms;}
  }
  @media(prefers-reduced-motion:reduce){
    .mx5-dlg.open .mx5-dlg-panel{transform:translateY(0);}
  }
}
/* Extra-narrow (320px) — prevent any horizontal bleed */
@media(max-width:360px){
  .mx5-dlg-panel{margin:0 6px;width:calc(100% - 12px);}
  .mx5-dlg-idx-grid{grid-template-columns:1fr!important;}
  .mx5-dlg-dd-row{grid-template-columns:1fr 1fr!important;}
}

/* ── S2: Dialog interior components ─────────────────────────────── */

/* Section eyebrow inside dialogs */
.mx5-dlg-eyebrow{
  font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
  color:var(--ink-3,rgba(255,255,255,.36));margin:0 0 14px;
}
[data-theme="light"] .mx5-dlg-eyebrow{color:rgba(0,0,0,.38);}

/* Section divider (thin separator between content blocks) */
.mx5-dlg-sep{
  height:1px;background:rgba(255,255,255,.07);margin:22px 0;
}
[data-theme="light"] .mx5-dlg-sep{background:rgba(0,0,0,.07);}

/* Dominant driver callout (RISK dialog top) */
.mx5-dlg-driver-hd{
  display:flex;align-items:center;gap:14px;margin-bottom:20px;
  padding:16px 18px;
  background:rgba(255,255,255,.04);border-radius:12px;
  border:1px solid rgba(255,255,255,.09);
}
[data-theme="light"] .mx5-dlg-driver-hd{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.07);}
.mx5-dlg-driver-icon{
  width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;font-size:18px;
  background:rgba(239,68,68,.13);
}
.mx5-dlg-driver-label{font-size:13px;font-weight:700;margin-bottom:3px;}
.mx5-dlg-driver-sub{font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));}
[data-theme="light"] .mx5-dlg-driver-sub{color:rgba(0,0,0,.45);}

/* Heads-up chips row (fed stance, turning point) */
.mx5-dlg-chips-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;}
.mx5-dlg-chip{
  display:inline-flex;align-items:center;padding:4px 12px;
  border-radius:20px;font-size:11px;font-weight:600;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  color:var(--ink-2,rgba(255,255,255,.6));
}
[data-theme="light"] .mx5-dlg-chip{background:rgba(0,0,0,.05);border-color:rgba(0,0,0,.1);color:rgba(0,0,0,.6);}

/* Drawdown box row inside dialogs */
.mx5-dlg-dd-row{
  display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:16px 0;
}
@media(max-width:700px){.mx5-dlg-dd-row{grid-template-columns:repeat(2,1fr);}}
.mx5-dlg-dd-box{
  padding:14px 12px;text-align:center;
  background:rgba(255,255,255,.03);border-radius:12px;
  border:1px solid rgba(255,255,255,.07);
}
[data-theme="light"] .mx5-dlg-dd-box{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.06);}
.mx5-dlg-dd-horizon{
  font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:6px;
}
[data-theme="light"] .mx5-dlg-dd-horizon{color:rgba(0,0,0,.38);}
.mx5-dlg-dd-val{font-size:22px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;margin-bottom:4px;}
.mx5-dlg-dd-sub{font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));}
[data-theme="light"] .mx5-dlg-dd-sub{color:rgba(0,0,0,.38);}

/* Six-factor deep rows (SIGNALS dialog) */
.mx5-dlg-factor-row{
  display:grid;grid-template-columns:minmax(120px,1.4fr) 1fr 52px;
  align-items:center;gap:14px;
  padding:12px 14px;
  background:rgba(255,255,255,.03);border-radius:12px;
  border:1px solid rgba(255,255,255,.06);
  margin-bottom:8px;
}
[data-theme="light"] .mx5-dlg-factor-row{background:rgba(0,0,0,.025);border-color:rgba(0,0,0,.06);}
.mx5-dlg-factor-row.weakest{border-color:rgba(245,158,11,.25);}
.mx5-dlg-factor-name{font-size:12px;font-weight:700;}
.mx5-dlg-factor-read{font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:3px;line-height:1.4;}
[data-theme="light"] .mx5-dlg-factor-read{color:rgba(0,0,0,.42);}
.mx5-dlg-factor-bar{position:relative;height:7px;border-radius:4px;background:rgba(255,255,255,.08);}
[data-theme="light"] .mx5-dlg-factor-bar{background:rgba(0,0,0,.09);}
.mx5-dlg-factor-fill{position:absolute;left:0;top:0;height:100%;border-radius:4px;opacity:.85;}
.mx5-dlg-factor-score{font-size:16px;font-weight:800;text-align:right;font-variant-numeric:tabular-nums;}
/* Bar tick labels (0 / 50 / 100) */
.mx5-dlg-bar-ticks{display:flex;justify-content:space-between;margin-top:4px;font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));}
@media(max-width:700px){.mx5-dlg-bar-ticks{display:none;}}

/* Weakest-leg callout (SIGNALS dialog) */
.mx5-dlg-weakest-callout{
  display:flex;gap:12px;align-items:flex-start;
  padding:14px 16px;
  background:rgba(245,158,11,.07);border-radius:12px;
  border:1px solid rgba(245,158,11,.2);
  margin:4px 0 16px;
}
.mx5-dlg-weakest-icon{
  width:32px;height:32px;border-radius:8px;flex-shrink:0;
  background:rgba(245,158,11,.14);display:flex;align-items:center;justify-content:center;
}
.mx5-dlg-weakest-label{font-size:13px;font-weight:700;color:var(--mx5-warn,#f59e0b);margin-bottom:3px;}
.mx5-dlg-weakest-sub{font-size:11px;color:var(--ink-2,rgba(255,255,255,.6));}
[data-theme="light"] .mx5-dlg-weakest-sub{color:rgba(0,0,0,.55);}

/* MTF tape table (inside SIGNALS dialog) */
.mx5-dlg-mtf-tbl{width:100%;border-collapse:collapse;font-size:11.5px;margin-top:10px;}
.mx5-dlg-mtf-tbl th{
  text-align:left;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ink-3,rgba(255,255,255,.36));padding:0 0 8px;
}
[data-theme="light"] .mx5-dlg-mtf-tbl th{color:rgba(0,0,0,.38);}
.mx5-dlg-mtf-tbl th:not(:first-child){text-align:center;}
