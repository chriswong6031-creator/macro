{# Compact display label for a GICS sector / narrative-basket name on the standout cards
   (declutter). Maps the long names to short forms and strips the "(Equal-Weight)" /
   "（等权）" tag; unknown names fall through (minus the EW tag). DISPLAY-ONLY — never
   touches slugs, data, links or scoring. #}
{% macro secshort(name) -%}
{%- set _n = name | string -%}
{%- set _abbr = {
  'Communication Services (Equal-Weight)':'Comm Svcs','Communication Services':'Comm Svcs',
  'Consumer Discretionary (Equal-Weight)':'Cons Disc','Consumer Discretionary':'Cons Disc',
  'Consumer Staples (Equal-Weight)':'Cons Stpl','Consumer Staples':'Cons Stpl',
  'Information Technology (Equal-Weight)':'Info Tech','Information Technology':'Info Tech',
  'Technology (Equal-Weight)':'Technology','Health Care (Equal-Weight)':'Health Care',
  'Financials (Equal-Weight)':'Financials','Industrials (Equal-Weight)':'Industrials',
  'Materials (Equal-Weight)':'Materials','Energy (Equal-Weight)':'Energy',
  'Utilities (Equal-Weight)':'Utilities','Real Estate (Equal-Weight)':'Real Estate',
  'Magnificent Seven':'Mag 7','Power & Grid Buildout':'Pwr Buildout',
  'Data-Center Power & Cooling':'DC Power','Crypto & Digital Assets':'Crypto',
  'Crypto & Digital Rails':'Crypto Rails','Critical Minerals & Rare Earths':'Rare Earths',
  'AI Neoclouds & HPC Hosting':'AI Neoclouds','AI Agents & Applications':'AI Agents',
  'AI Infrastructure':'AI Infra','AI Semiconductors':'AI Semis',
  'AI Software & Platforms':'AI Software','Semiconductor Equipment (WFE)':'Semi Equip',
  'Semiconductor Equipment':'Semi Equip','Memory, HBM & Storage':'Memory/HBM',
  'Industrial Distribution & Capital Goods':'Ind Distrib','Reshoring & Industrial Capex':'Reshoring',
  'Defense & Aerospace':'Defense','Managed Care & Insurers':'Managed Care',
  'Insurance & Brokers':'Insurance','Payments & Fintech':'Payments',
  'Nuclear & SMR Power':'Nuclear/SMR','Uranium & Nuclear Fuel':'Uranium',
  'GLP-1 & Obesity':'GLP-1','Travel & Experiences':'Travel',
  'Robotics & Automation':'Robotics','US Energy Complex':'US Energy',
  'Non-AI Software':'Non-AI SW','Non-AI Tech & Hardware':'Non-AI HW',
  'Regional Banks':'Reg Banks',
} -%}
{%- if _n in _abbr -%}{{ _abbr[_n] }}{%- else -%}{{ _n | replace(' (Equal-Weight)','') | replace('（等权）','') }}{%- endif -%}
{%- endmacro %}
{# Companion to secshort() for the "What to act on now" board: shortens long EN
   labels on the nb-pulse-heat theme chip and the actiongrid .actitem theme/sector
   labels so they stop bleeding out of their flex cells. Unlike secshort() this
   KEEPS the "(Equal-Weight)" tag (compressed to "(EW)") rather than stripping it.
   EN display only — ZH labels are already short. DISPLAY-ONLY. #}
{% macro dispshort(name) -%}
{%- set _n = name | string -%}
{%- set _abbr = {
  'Consumer Staples':'Cons Staples','Consumer Discretionary':'Cons Disc',
  'Communication Services':'Comm Services','Reshoring & Industrial Capex':'Industrial Capex',
} -%}
{%- set _base = _n | replace(' (Equal-Weight)','') -%}
{%- set _ew = ' (EW)' if ' (Equal-Weight)' in _n else '' -%}
{%- if _base in _abbr -%}{{ _abbr[_base] }}{{ _ew }}{%- else -%}{{ _base }}{{ _ew }}{%- endif -%}
{%- endmacro %}
