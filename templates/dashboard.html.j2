  {# dlg-evidence: Evidence six-factor breakdown — S2 redesign #}
  <div class="mx5-dlg" id="dlg-evidence" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Signals — Evidence Breakdown</span><span class="l-zh">信号 — 依据分析</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Composite read — bind to MS (same object as hero) so glance and drill-down never disagree #}
        {% if MS %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Composite Score</span><span class="l-zh">综合评分</span></div>
        <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:20px">
          {% set _dlge_col = 'var(--up)' if MS.score >= 60 else ('var(--warn)' if MS.score >= 42 else 'var(--down)') %}
          <span style="font-size:40px;font-weight:900;font-variant-numeric:tabular-nums;color:{{ _dlge_col }};line-height:1">{{ MS.score }}</span>
          <div>
            <div style="font-size:14px;font-weight:700;color:{{ _dlge_col }}">
              <span class="l-en">{{ MS.label_en }}</span>
              <span class="l-zh">{{ MS.label_zh or MS.label_en }}</span>
            </div>
            <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:3px">
              <span class="l-en">Blended 0–100 · ≥60 risk-on · 42–59 mixed · &lt;42 risk-off</span>
              <span class="l-zh">合成 0-100 · ≥60 偏多 · 42-59 混合 · &lt;42 避险</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# — Six factor rows — #}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Six Factors</span><span class="l-zh">六大因子</span></div>
        {% if MS2 and MS2.components %}
        {% set _dlge_weakest = (MS2.components | sort(attribute='score') | first) if MS2.components else none %}
        {% for c in MS2.components %}
        {% set _ec = 'var(--up)' if c.tone == 'good' else ('var(--down)' if c.tone == 'bad' else 'var(--warn)') %}
        {% set _is_wk = (_dlge_weakest and c.label_en == _dlge_weakest.label_en) %}
        <div class="mx5-dlg-factor-row{{ ' weakest' if _is_wk }}">
          <div>
            <div class="mx5-dlg-factor-name">
              <span class="l-en">{{ c.label_en }}</span><span class="l-zh">{{ c.label_zh or c.label_en }}</span>
              {% if _is_wk %}<span class="v2chip c-warn" style="font-size:9px;padding:1px 5px;margin-left:6px;vertical-align:middle"><span class="l-en">WEAKEST</span><span class="l-zh">最弱</span></span>{% endif %}
            </div>
            {% if c.read_en is defined and c.read_en %}
            <div class="mx5-dlg-factor-read"><span class="l-en">{{ c.read_en }}</span><span class="l-zh">{{ c.read_zh or c.read_en }}</span></div>
            {% endif %}
          </div>
          <div>
            <div class="mx5-dlg-factor-bar"><div class="mx5-dlg-factor-fill" style="width:{{ [c.score,100]|min }}%;background:{{ _ec }}"></div></div>
            <div class="mx5-dlg-bar-ticks"><span>0</span><span>50</span><span>100</span></div>
          </div>
          <div class="mx5-dlg-factor-score" style="color:{{ _ec }}">{{ c.score }}</div>
        </div>
        {% endfor %}

        {# — Weakest leg callout — #}
        {% if _dlge_weakest %}
        <div class="mx5-dlg-weakest-callout">
          <div class="mx5-dlg-weakest-icon">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <div>
            <div class="mx5-dlg-weakest-label"><span class="l-en">Watch: {{ _dlge_weakest.label_en }}</span><span class="l-zh">关注：{{ _dlge_weakest.label_zh or _dlge_weakest.label_en }}</span></div>
            <div class="mx5-dlg-weakest-sub">
              <span class="l-en">Weakest leg at {{ _dlge_weakest.score }}/100 — the closest flip-trigger. Confirms what has already turned; does not forecast.</span>
              <span class="l-zh">最弱分项 {{ _dlge_weakest.score }}/100，最接近翻转触发点。确认已转向信号，不预测未来。</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# — Multi-timeframe tape — #}
        {% if MS2 and MS2.mtf and MS2.mtf.indices %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Multi-Timeframe Tape · Broad US Market</span><span class="l-zh">多周期趋势 · 美股大盘</span></div>
        <table class="mx5-dlg-mtf-tbl">
          <thead><tr>
            <th><span class="l-en">Index</span><span class="l-zh">指数</span></th>
            <th>1D</th><th>3D</th><th>7D</th><th>30D</th>
            <th style="text-align:right"><span class="l-en">Confluence</span><span class="l-zh">合流</span></th>
          </tr></thead>
          <tbody>
          {% for r in MS2.mtf.indices %}
          <tr>
            <td style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">{{ r.label_en }}</span><span class="l-zh">{{ r.label_zh or r.label_en }}</span></td>
            {% for tf in ['D','3D','W','M'] %}{% set cell = r.cells[tf] %}
            <td>{% if cell %}<span class="ms-cell2 {{ cell.tone }}"><span class="ar">{{ cell.arrow }}</span><span class="rsi">{{ cell.rsi|round|int if cell.rsi is not none else '·' }}</span></span>{% else %}<span class="ms-cell2 flat"><span class="ar">·</span></span>{% endif %}</td>
            {% endfor %}
            <td style="text-align:right"><span class="mx5-dlg-mtf-conf {{ r.tone }}"><span class="l-en">{{ r.confluence_en }}</span><span class="l-zh">{{ r.confluence_zh or r.confluence_en }}</span></span></td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
        {% endif %}

        {# — Footnote — #}
        <div class="mx5-dlg-sep"></div>
        <div style="display:flex;align-items:flex-start;gap:10px;font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.5">
          <span class="v2-display-badge" style="flex-shrink:0;margin-top:1px"><span class="l-en">DISPLAY-ONLY</span><span class="l-zh">仅展示</span></span>
          <span>
            <span class="l-en">Confirms what has already turned — does not forecast. Gauntlet applies at promotion only. {{ 'as of ' ~ MS2.asof if (MS2 and MS2.asof is defined and MS2.asof) else '' }}</span>
            <span class="l-zh">确认已转向信号，不预测未来。{{ MS2.asof ~ ' 数据' if (MS2 and MS2.asof is defined and MS2.asof) else '' }}</span>
          </span>
        </div>

        {% else %}
        <p style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));margin-top:16px"><span class="l-en">No signal data available.</span><span class="l-zh">暂无信号数据。</span></p>
        {% endif %}

      </div>
    </div>
  </div>

  {# dlg-events: Events catalysts + fed market pricing + release-radar link — S2 redesign #}
  <div class="mx5-dlg" id="dlg-events" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Events — Week Ahead &amp; Market Pricing</span><span class="l-zh">事件 — 本周日历与市场定价</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Week-ahead calendar cards — #}
        {% if macro_catalysts %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">This Week</span><span class="l-zh">本周</span></div>
        <div class="mx5-dlg-cal-grid">
          {% for c in macro_catalysts[:8] %}
          {% set _bdg = 'high' if c.impact == 'high' else ('med' if c.impact == 'med' else 'low') %}
          {% set _lbl_zh = c.get('label_zh') or c.label %}
          <div class="mx5-dlg-cal-card{{ ' hot' if c.impact == 'high' }}">
            <div class="mx5-dlg-cal-date">{{ _mos2[c.date[5:7]|int] }} {{ c.date[8:10]|int }}</div>
            <div class="mx5-dlg-cal-title">
              <span class="l-en">{{ c.label }}</span>
              <span class="l-zh">{{ _lbl_zh }}</span>
            </div>
            <div class="mx5-dlg-cal-meta">
              {% if c.time_et %}<span class="mx5-dlg-cal-time">{{ c.time_et }} ET</span>{% endif %}
              <span class="mx5-dlg-cal-badge {{ _bdg }}">
                <span class="l-en">{{ c.impact | upper }}</span>
                <span class="l-zh">{{ {'high':'高','med':'中','low':'低'}.get(c.impact, c.impact) }}</span>
              </span>
            </div>
            {# Typical move plain line — if engine provides typical_move or move_context #}
            {% if c.get('typical_move') or c.get('move_context') %}
            <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:7px;line-height:1.4">
              <span class="l-en">{{ c.get('typical_move') or c.get('move_context') }}</span>
              <span class="l-zh">{{ c.get('typical_move_zh') or c.get('move_context_zh') or c.get('typical_move') or c.get('move_context') }}</span>
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {# — Fed prediction market pricing — #}
        {# Outcome enum → ZH display map, shared by this strip and dlg-fed below #}
        {% set _fed_out_zh = {'No change':'按兵不动','Rate cut':'降息','Rate hike':'加息','25bps cut':'降息25bp','50bps cut':'降息50bp','25bps hike':'加息25bp','25 bps increase':'加息25bp','25 bps decrease':'降息25bp','50+ bps increase':'加息50bp以上','50+ bps decrease':'降息50bp以上','0.1%':'0.1%','0.2%':'0.2%','0.3%':'0.3%','0.4%':'0.4%'} %}
        {% if prediction_markets and prediction_markets.events %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Fed · Market Pricing</span><span class="l-zh">美联储 · 市场定价</span></div>
        <div class="mx5-dlg-fed-strip">
          {% for e in prediction_markets.events[:4] %}
          {% set _top = (e.outcomes | sort(attribute='prob', reverse=true)) | first %}
          <div class="mx5-dlg-fed-item">
            <span class="mx5-dlg-fed-desc"><span class="l-en">{{ e.label_en if e.label_en is defined else e.name }}</span><span class="l-zh">{{ e.label_zh if e.label_zh is defined else (e.label_en if e.label_en is defined else e.name) }}</span></span>
            <span class="mx5-dlg-fed-val"><span class="num">{{ _top.outcome }} {{ _top.prob }}%</span></span>
            {% if _top.chg_pp is not none and _top.chg_pp != 0 %}<span class="mx5-dlg-fed-chg {{ 'pos' if _top.chg_pp > 0 else 'neg' }}"><span class="l-en">{{ '%+.1f'|format(_top.chg_pp) }} pts</span><span class="l-zh">{{ '%+.1f'|format(_top.chg_pp) }} 个百分点</span></span>{% endif %}
          </div>
          {% if loop.first and _top.prob is defined and _top.prob is not none %}
          {# Plain read for headline row — derive odds in plain "X in N" language #}
          {% set _fed_prob = _top.prob | float %}
          {% set _fed_odds_n = ((_fed_prob / 10) | round | int) %}
          {% set _fed_zh_digit = {1:'一',2:'两',3:'三',4:'四',5:'五',6:'六',7:'七',8:'八',9:'九'}.get(_fed_odds_n) %}
          <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));padding:4px 0 2px;line-height:1.4">
            <span class="l-en">Market sees ~{{ _fed_odds_n }} in 10 odds of &ldquo;{{ _top.outcome }}&rdquo;.</span>
            <span class="l-zh">市场认为「{{ _fed_out_zh.get(_top.outcome, _top.outcome) }}」的概率{% if _fed_zh_digit %}约{{ _fed_zh_digit }}成{% else %}约为{{ _fed_prob | round | int }}%{% endif %}。</span>
          </div>
          {% endif %}
          {% endfor %}
          <div class="mx5-dlg-fed-src">Polymarket</div>
        </div>
        {% endif %}

        {# — Release Radar link — #}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Data Release Radar</span><span class="l-zh">数据发布雷达</span></div>
        <div style="margin-bottom:16px;font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));line-height:1.5">
          <span class="l-en">For projection vs benchmark skew, revision expectations, and historical reaction patterns — open the Release Radar below.</span>
          <span class="l-zh">如需查看预测与基准的偏差、修订预期和历史反应规律，请在下方打开数据发布雷达。</span>
        </div>
        <button class="mx5-dlg-rr-link" type="button" onclick="mx5CloseDlg(); if(window.mmOpenFirstRR) window.mmOpenFirstRR();" aria-label="Open Release Radar">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          <span class="l-en">Open Release Radar</span>
          <span class="l-zh">打开数据发布雷达</span>
        </button>

        {% if not macro_catalysts and not (prediction_markets and prediction_markets.events) %}
        <p style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));margin-top:16px"><span class="l-en">No events data available.</span><span class="l-zh">暂无事件数据。</span></p>
        {% endif %}

      </div>
    </div>
  </div>

  {# dlg-markets: Index health + sector heat + heatmap + cross-asset — S2 redesign #}
  <div class="mx5-dlg" id="dlg-markets" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Markets — Index Health &amp; Cross-Asset</span><span class="l-zh">市场 — 指数健康度与跨资产</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Index deep cards — #}
        {% if index_health %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Index Health</span><span class="l-zh">指数健康度</span></div>
        {% set _dlgm_ix_nm = {'SPY': 'S&P 500', 'QQQ': 'Nasdaq 100', 'DJI': 'Dow Jones', '_DJI': 'Dow Jones', 'RUT': 'Russell 2000', '_RUT': 'Russell 2000'} %}
        <div class="mx5-dlg-idx-grid">
          {% for ix in index_health %}
          {% set _dlgm_sym = ix.ticker | replace('_','') %}
          {% set _dlgm_chg = ix.chg if (ix.chg is defined and ix.chg is not none) else none %}
          {% set _dlgm_dir = ('up' if _dlgm_chg > 0 else ('dn' if _dlgm_chg < 0 else '')) if _dlgm_chg is not none else '' %}
          {% set _dlgm_col = ('var(--up)' if _dlgm_chg > 0 else ('var(--down)' if _dlgm_chg < 0 else 'var(--text)')) if _dlgm_chg is not none else 'var(--text)' %}
          <div class="mx5-dlg-idx-card">
            <div class="mx5-dlg-idx-ticker">{{ _dlgm_sym }}</div>
            <div class="mx5-dlg-idx-name">{{ _dlgm_ix_nm.get(ix.ticker, ix.label if ix.label is defined else _dlgm_sym) }}</div>
            <div class="mx5-dlg-idx-px nb-px" data-sym="{{ _dlgm_sym }}" data-mkt="us" data-bare>{{ '{:,.2f}'.format(ix.price) }}</div>
            <div class="mx5-dlg-idx-chg {{ _dlgm_dir }} nb-chg" data-sym="{{ _dlgm_sym }}" data-mkt="us">{% if _dlgm_chg is not none %}{{ '%+.2f'|format(_dlgm_chg) }}%{% else %}—{% endif %}</div>
            <div class="mx5-dlg-idx-chips">
              {# Distance from high — plain words #}
              {% set _dlgm_dd = ix.dd if (ix.dd is defined and ix.dd is not none) else none %}
              {% if _dlgm_dd is not none %}<span class="mx5-dlg-idx-chip {{ 'ok' if _dlgm_dd >= -1 else ('wn' if _dlgm_dd >= -10 else 'mt') }}" title="Distance from 52-week high">{{ '%+.1f'|format(_dlgm_dd) }}% <span class="l-en">off high</span><span class="l-zh">距高</span></span>{% endif %}
              {# Trend vs 50d MA #}
              {% if ix.above50 is defined %}
              <span class="mx5-dlg-idx-chip {{ 'ok' if ix.above50 else 'mt' }}" title="vs 50-day moving average"><span class="l-en">{{ 'Above' if ix.above50 else 'Below' }} 50-day {{ '✓' if ix.above50 else '✕' }}</span><span class="l-zh">{{ '高于' if ix.above50 else '低于' }}50日线 {{ '✓' if ix.above50 else '✕' }}</span></span>
              {% endif %}
              {# Trend vs 200d MA #}
              {% if ix.above200 is defined %}
              <span class="mx5-dlg-idx-chip {{ 'ok' if ix.above200 else 'mt' }}" title="vs 200-day moving average"><span class="l-en">{{ 'Above' if ix.above200 else 'Below' }} 200-day {{ '✓' if ix.above200 else '✕' }}</span><span class="l-zh">{{ '高于' if ix.above200 else '低于' }}200日线 {{ '✓' if ix.above200 else '✕' }}</span></span>
              {% endif %}
              {# RSI — plain-word read, not raw number #}
              {% if ix.rsi is not none %}
              {% set _dlgm_rsi_word = 'Overbought' if ix.rsi >= 70 else ('Oversold' if ix.rsi <= 30 else 'Neutral') %}
              {% set _dlgm_rsi_zh = '超买' if ix.rsi >= 70 else ('超卖' if ix.rsi <= 30 else '中性') %}
              <span class="mx5-dlg-idx-chip {{ 'wn' if ix.rsi >= 70 or ix.rsi <= 30 else 'mt' }}" title="RSI(14) = {{ ix.rsi }}"><span class="l-en">{{ _dlgm_rsi_word }}</span><span class="l-zh">{{ _dlgm_rsi_zh }}</span></span>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {# — Sector hot / cold columns — #}
        {% if sector_heat %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Sector Temperature</span><span class="l-zh">板块温度</span></div>
        <div class="mx5-dlg-sector-cols">
          <div>
            <div class="mx5-dlg-sector-col-head"><span class="l-en">Leading sectors</span><span class="l-zh">领涨板块</span></div>
            {% for _ht in (sector_heat.get('heating') or [])[:5] %}
            <div class="mx5-dlg-sector-row">
              <span class="mx5-dlg-sector-arr heat">&#9650;</span>
              <span class="mx5-dlg-sector-name"><span class="l-en">{{ _ht.get('name') }}</span><span class="l-zh">{{ _ht.get('name_zh') or _ht.get('name') }}</span></span>
              <span class="mx5-dlg-sector-rk">#{{ _ht.get('rank') }}</span>
            </div>
            {% endfor %}
          </div>
          <div>
            <div class="mx5-dlg-sector-col-head"><span class="l-en">Lagging sectors</span><span class="l-zh">滞涨板块</span></div>
            {% for _ct in (sector_heat.get('cooling') or [])[:5] %}
            <div class="mx5-dlg-sector-row">
              <span class="mx5-dlg-sector-arr cool">&#9661;</span>
              <span class="mx5-dlg-sector-name"><span class="l-en">{{ _ct.get('name') }}</span><span class="l-zh">{{ _ct.get('name_zh') or _ct.get('name') }}</span></span>
              <span class="mx5-dlg-sector-rk">#{{ _ct.get('rank') }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {# — S&P Heatmap — heatmap.js mounts on first #heatmap-scorecard instance in DOM;
           the island's #heatmap-scorecard is the canonical mount point.
           Here we show the same container only when the dialog is open so the JS can re-use it.
           The slot below stays empty (heatmap.js mounts on the island's id first); this is a
           fallback visual placeholder that explains where the chart lives. #}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">S&amp;P 500 Sector Heatmap</span><span class="l-zh">标普500板块热力图</span></div>
        <div class="mx5-dlg-heatmap-wrap">
          {# mx5-dlg-heatmap-head removed (1.2); eyebrow above already names section #}
          {# Point to the canonical heatmap-scorecard in the island; dialog delegates to it #}
          <div id="dlg-heatmap-scorecard" style="min-height:120px"></div>
          {# Mobile-only full heatmap link (hidden >700px; heatmap.js hides Expand on touch/small screens) #}
          <div class="mx5-dlg-hm-mobile-link">
            <a href="sector_heatmap.html"><span class="l-en">Full heatmap page →</span><span class="l-zh">完整热力图页 →</span></a>
          </div>
        </div>

        {# — Cross-asset tiles — 8 key macro variables — #}
        {% set _dlgm_ca = latest.cross_asset if (latest.cross_asset is defined and latest.cross_asset) else {} %}
        {% if _dlgm_ca or (vix is defined and vix) %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Key Rates &amp; Volatility</span><span class="l-zh">关键利率与波动率</span></div>
        <div class="mx5-dlg-asset-row">
          {% if _dlgm_ca.get('us10y') is not none %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl"><span class="l-en">10Y Treasury</span><span class="l-zh">10年期国债</span></div>
            <div class="mx5-dlg-asset-val" style="color:var(--text)">{{ '%.2f'|format(_dlgm_ca.get('us10y')) }}%</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">rate</span><span class="l-zh">利率</span></div>
          </div>
          {% endif %}
          {% if _dlgm_ca.get('us2y') is not none %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl"><span class="l-en">2Y Treasury</span><span class="l-zh">2年期国债</span></div>
            <div class="mx5-dlg-asset-val" style="color:var(--text)">{{ '%.2f'|format(_dlgm_ca.get('us2y')) }}%</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">rate</span><span class="l-zh">利率</span></div>
          </div>
          {% endif %}
          {% if _dlgm_ca.get('fed_funds') is not none %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl"><span class="l-en">Fed Funds</span><span class="l-zh">联邦基金</span></div>
            <div class="mx5-dlg-asset-val" style="color:var(--text)">{{ '%.2f'|format(_dlgm_ca.get('fed_funds')) }}%</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">target</span><span class="l-zh">目标利率</span></div>
          </div>
          {% endif %}
          {% if _dlgm_ca.get('real10y') is not none %}
          {% set _dlgm_r10c = 'var(--down)' if _dlgm_ca.get('real10y') > 2.0 else ('var(--warn)' if _dlgm_ca.get('real10y') > 0.5 else 'var(--up)') %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl"><span class="l-en">Real 10Y</span><span class="l-zh">实际10年期</span></div>
            <div class="mx5-dlg-asset-val" style="color:{{ _dlgm_r10c }}">{{ '%.2f'|format(_dlgm_ca.get('real10y')) }}%</div>
            <div class="mx5-dlg-asset-ctx">TIPS</div>
          </div>
          {% endif %}
          {% if _dlgm_ca.get('curve_2s10s') is not none %}
          {% set _dlgm_curc = 'var(--down)' if _dlgm_ca.get('curve_2s10s') < 0 else 'var(--up)' %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl">2s10s <span class="l-en">Curve</span><span class="l-zh">曲线</span></div>
            <div class="mx5-dlg-asset-val" style="color:{{ _dlgm_curc }}">{{ '%+.0f'|format(_dlgm_ca.get('curve_2s10s') * 100) }}bp</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">{{ 'inverted' if _dlgm_ca.get('curve_2s10s') < 0 else 'normal' }}</span><span class="l-zh">{{ '倒挂' if _dlgm_ca.get('curve_2s10s') < 0 else '正常' }}</span></div>
          </div>
          {% endif %}
          {% if _dlgm_ca.get('dxy') is not none %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl">DXY <span class="l-en">Dollar</span><span class="l-zh">美元</span></div>
            <div class="mx5-dlg-asset-val" style="color:var(--text)">{{ '%.1f'|format(_dlgm_ca.get('dxy')) }}</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">index</span><span class="l-zh">指数</span></div>
          </div>
          {% endif %}
          {% if vix is defined and vix is not none and vix.last is defined and vix.last is not none %}
          {% set _dlgm_vixlv = vix.last %}
          {% set _dlgm_vixc = 'var(--down)' if _dlgm_vixlv > 25 else ('var(--warn)' if _dlgm_vixlv > 18 else 'var(--up)') %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl">VIX</div>
            <div class="mx5-dlg-asset-val" style="color:{{ _dlgm_vixc }}">{{ '%.1f'|format(_dlgm_vixlv) }}</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">{{ 'stress' if _dlgm_vixlv > 25 else ('watch' if _dlgm_vixlv > 18 else 'calm') }}</span><span class="l-zh">{{ '紧张' if _dlgm_vixlv > 25 else ('警惕' if _dlgm_vixlv > 18 else '平静') }}</span></div>
          </div>
          {% endif %}
          {% if _dlgm_ca.get('hy_oas') is not none %}
          {% set _dlgm_hyc = 'var(--down)' if _dlgm_ca.get('hy_oas') > 5.0 else ('var(--warn)' if _dlgm_ca.get('hy_oas') > 3.5 else 'var(--up)') %}
          <div class="mx5-dlg-asset-tile">
            <div class="mx5-dlg-asset-lbl"><span class="l-en">HY Spread</span><span class="l-zh">高收益利差</span></div>
            <div class="mx5-dlg-asset-val" style="color:{{ _dlgm_hyc }}">{{ '%.0f'|format(_dlgm_ca.get('hy_oas') * 100) }}bp</div>
            <div class="mx5-dlg-asset-ctx"><span class="l-en">credit</span><span class="l-zh">信用</span></div>
          </div>
          {% endif %}
        </div>
        {% endif %}

        {% if not index_health and not sector_heat %}
        <p style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));margin-top:16px"><span class="l-en">No market data available.</span><span class="l-zh">暂无市场数据。</span></p>
        {% endif %}

      </div>
    </div>
  </div>

  {# dlg-risk: Risk scare ladder + drawdown boxes + sentiment — S2 redesign #}
  {% if market_state %}
  <div class="mx5-dlg" id="dlg-risk" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Risk — Scare Ladder &amp; Sentiment</span><span class="l-zh">风险 — 压力梯度与情绪</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Dominant driver header — #}
        {% set _dlgr_rdr = market_state.radar if market_state.radar is defined else {} %}
        {% set _dlgr_state = _dlgr_rdr.state if _dlgr_rdr else 'unknown' %}
        {% set _dlgr_col = 'var(--down)' if _dlgr_state in ('risk-off','high') else ('var(--warn)' if _dlgr_state in ('elevated','caution') else 'var(--up)') %}
        <div class="mx5-dlg-driver-hd">
          <div class="mx5-dlg-driver-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="{{ _dlgr_col }}" stroke-width="2" stroke-linecap="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div>
            <div class="mx5-dlg-driver-label" style="color:{{ _dlgr_col }}">
              <span class="l-en">{{ (_dlgr_rdr.label_en if _dlgr_rdr.label_en is defined else _dlgr_state) | title }}</span>
              <span class="l-zh">{{ _dlgr_rdr.label_zh if (_dlgr_rdr.label_zh is defined and _dlgr_rdr.label_zh) else (_dlgr_rdr.label_en if _dlgr_rdr.label_en is defined else _dlgr_state) }}</span>
            </div>
            {% if _dlgr_rdr.do_en is defined and _dlgr_rdr.do_en %}
            <div class="mx5-dlg-driver-sub">
              <span class="l-en">{{ _dlgr_rdr.do_en }}</span>
              <span class="l-zh">{{ _dlgr_rdr.do_zh if (_dlgr_rdr.do_zh is defined and _dlgr_rdr.do_zh) else _dlgr_rdr.do_en }}</span>
            </div>
            {% endif %}
            {% if _dlgr_rdr.top_score is defined and _dlgr_rdr.top_score is not none %}
            <div class="mx5-dlg-driver-sub" style="margin-top:3px">
              <span class="l-en">Intensity {{ _dlgr_rdr.top_score }}/100</span>
              <span class="l-zh">强度 {{ _dlgr_rdr.top_score }}/100</span>
            </div>
            {% endif %}
          </div>
        </div>

        {# — Heads-up chips: fed stance + turning point — #}
        {% set _dlgr_fed_st = (latest.fed_stance.stance if (latest.fed_stance is defined and latest.fed_stance and latest.fed_stance.stance is defined and latest.fed_stance.stance != 'unknown') else none) %}
        {% set _dlgr_tp = (latest.turning_point if (latest.turning_point is defined and latest.turning_point and latest.turning_point.present is defined and latest.turning_point.present) else none) %}
        {% if _dlgr_fed_st or _dlgr_tp %}
        <div class="mx5-dlg-chips-row">
          {% if _dlgr_fed_st %}
          {% set _dlgr_fsc = 'var(--down)' if _dlgr_fed_st in ('hawkish','very-hawkish') else ('var(--up)' if _dlgr_fed_st in ('dovish','very-dovish') else 'var(--warn)') %}
          {% set _dlgr_fsl = {'hawkish':'Hawkish','very-hawkish':'Very Hawkish','dovish':'Dovish','very-dovish':'Very Dovish','neutral':'Neutral'} %}
          {% set _dlgr_fszh = {'hawkish':'鹰派','very-hawkish':'强鹰派','dovish':'鸽派','very-dovish':'强鸽派','neutral':'中性'} %}
          <span class="mx5-dlg-chip" style="border-color:{{ _dlgr_fsc }};color:{{ _dlgr_fsc }}">
            <span class="l-en">Fed: {{ _dlgr_fsl.get(_dlgr_fed_st, _dlgr_fed_st) }}</span>
            <span class="l-zh">美联储：{{ _dlgr_fszh.get(_dlgr_fed_st, _dlgr_fed_st) }}</span>
          </span>
          {% endif %}
          {% if _dlgr_tp %}
          <span class="mx5-dlg-chip" style="border-color:var(--warn);color:var(--warn)">
            <span class="l-en">Turning point watch</span>
            <span class="l-zh">拐点观察中</span>
          </span>
          {% endif %}
        </div>
        {% endif %}

        {# — Radar + ignition banner cards — #}
        {% if MS.radar and MS.radar.state %}{{ rrc.risk_radar_card(MS.radar, latest.risk_radar.scares if latest.risk_radar else none) }}{% endif %}
        {% if latest.ignition_radar %}{{ igc.ignition_radar_card(latest.ignition_radar) }}{% endif %}

        {# — Scare ladder — #}
        {% if latest.risk_radar and latest.risk_radar.scares %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Risk Ladder — What to Watch</span><span class="l-zh">风险梯度 — 需关注的因素</span></div>
        <div class="scare-ladder" style="margin-bottom:0">
          {% for sc in latest.risk_radar.scares %}
          {% set _sc_s2 = sc.score if (sc.score is defined and sc.score is not none) else 0 %}
          {% set _scc = ('sc-band-high' if _sc_s2 >= 70 else ('sc-band-watch' if _sc_s2 >= 50 else ('sc-band-elev' if _sc_s2 >= 35 else 'sc-band-calm'))) %}
          {% set _scband = (sc.band if sc.band is defined and sc.band else ('WATCH' if _sc_s2 >= 50 else ('ELEVATED' if _sc_s2 >= 35 else 'CALM'))) %}
          {% set _scband_zh = {'WATCH':'警惕','ELEVATED':'走高','CALM':'平静','HIGH':'高危'}.get(_scband, _scband) %}
          <div class="scare-row">
            <span class="sc-name">
              <span class="l-en">{{ sc.label_en if sc.label_en is defined else (sc.name_en if sc.name_en is defined else sc.name) }}</span>
              <span class="l-zh">{{ sc.label_zh if sc.label_zh is defined else (sc.name_zh if sc.name_zh is defined else sc.name) }}</span>
              {# Plain-word description — one sentence per scare; engine may provide desc_en/desc_zh #}
              {% if sc.desc_en is defined and sc.desc_en %}
              <div style="font-size:10px;font-weight:400;color:var(--ink-3,rgba(255,255,255,.36));margin-top:3px;line-height:1.4">
                <span class="l-en">{{ sc.desc_en }}</span>
                <span class="l-zh">{{ sc.desc_zh if (sc.desc_zh is defined and sc.desc_zh) else sc.desc_en }}</span>
              </div>
              {% endif %}
            </span>
            <div class="sc-bar-track"><div class="sc-bar-fill" style="width:{{ [_sc_s2,100]|min }}%;background:{{ 'var(--down)' if _sc_s2 >= 70 else ('var(--warn)' if _sc_s2 >= 35 else 'var(--muted)') }}"></div></div>
            <span class="sc-score" style="color:{{ 'var(--down)' if _sc_s2 >= 70 else ('var(--warn)' if _sc_s2 >= 35 else 'var(--muted)') }}">{{ sc.score }}</span>
            <span class="sc-band {{ _scc }}">
              <span class="l-en">{{ _scband }}</span>
              <span class="l-zh">{{ _scband_zh }}</span>
            </span>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {# — Drawdown probability boxes — #}
        {% set _dlgr_rdr_data = latest.risk_radar if (latest.risk_radar is defined and latest.risk_radar) else none %}
        {% set _dlgr_rdr_r = market_state.radar if (market_state and market_state.radar is defined) else {} %}
        {% if _dlgr_rdr_r and (_dlgr_rdr_r.dd5 is defined or _dlgr_rdr_r.dd10 is defined or _dlgr_rdr_r.dd21 is defined) %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Drawdown Probability — Model Estimates</span><span class="l-zh">回撤概率 — 模型估计</span></div>
        <div class="mx5-dlg-dd-row">
          {% if _dlgr_rdr_r.dd5 is defined and _dlgr_rdr_r.dd5 is not none %}
          <div class="mx5-dlg-dd-box">
            <div class="mx5-dlg-dd-horizon"><span class="l-en">5-day</span><span class="l-zh">5日</span></div>
            <div class="mx5-dlg-dd-val" style="color:{{ 'var(--down)' if _dlgr_rdr_r.dd5 > 0.15 else ('var(--warn)' if _dlgr_rdr_r.dd5 > 0.06 else 'var(--up)') }}">{{ (_dlgr_rdr_r.dd5 * 100)|round|int }}%</div>
            <div class="mx5-dlg-dd-sub"><span class="l-en">≥5% drop odds</span><span class="l-zh">≥5%下跌概率</span></div>
          </div>
          {% endif %}
          {% if _dlgr_rdr_r.dd10 is defined and _dlgr_rdr_r.dd10 is not none %}
          <div class="mx5-dlg-dd-box">
            <div class="mx5-dlg-dd-horizon"><span class="l-en">10-day</span><span class="l-zh">10日</span></div>
            <div class="mx5-dlg-dd-val" style="color:{{ 'var(--down)' if _dlgr_rdr_r.dd10 > 0.20 else ('var(--warn)' if _dlgr_rdr_r.dd10 > 0.10 else 'var(--up)') }}">{{ (_dlgr_rdr_r.dd10 * 100)|round|int }}%</div>
            <div class="mx5-dlg-dd-sub"><span class="l-en">≥5% drop odds</span><span class="l-zh">≥5%下跌概率</span></div>
          </div>
          {% endif %}
          {% if _dlgr_rdr_r.dd21 is defined and _dlgr_rdr_r.dd21 is not none %}
          {% set _dlgr_dd21_base = (_dlgr_rdr_r.drawdown_prob.base * 100)|round(1) if (_dlgr_rdr_r.drawdown_prob is defined and _dlgr_rdr_r.drawdown_prob and _dlgr_rdr_r.drawdown_prob.base is not none) else none %}
          <div class="mx5-dlg-dd-box" style="{{ 'border-color:rgba(245,158,11,.25)' if _dlgr_rdr_r.dd21 > 0.12 else '' }}">
            <div class="mx5-dlg-dd-horizon"><span class="l-en">21-day</span><span class="l-zh">21日</span></div>
            <div class="mx5-dlg-dd-val" style="color:{{ 'var(--down)' if _dlgr_rdr_r.dd21 > 0.25 else ('var(--warn)' if _dlgr_rdr_r.dd21 > 0.12 else 'var(--up)') }}">{{ (_dlgr_rdr_r.dd21 * 100)|round|int }}%</div>
            <div class="mx5-dlg-dd-sub">{% if _dlgr_dd21_base is not none %}<span class="l-en">base {{ _dlgr_dd21_base }}%</span><span class="l-zh">基准 {{ _dlgr_dd21_base }}%</span>{% else %}<span class="l-en">≥10% drop odds</span><span class="l-zh">≥10%下跌概率</span>{% endif %}</div>
          </div>
          {% endif %}
          {% set _dlgr_pk = _dlgr_rdr_r.drawdown_prob.peak if (_dlgr_rdr_r.drawdown_prob is defined and _dlgr_rdr_r.drawdown_prob) else none %}
          {% set _dlgr_pk_ago = _dlgr_rdr_r.drawdown_prob.peak_days_ago if (_dlgr_rdr_r.drawdown_prob is defined and _dlgr_rdr_r.drawdown_prob) else none %}
          {% if _dlgr_pk is not none %}
          <div class="mx5-dlg-dd-box">
            <div class="mx5-dlg-dd-horizon"><span class="l-en">Peak</span><span class="l-zh">峰值</span></div>
            <div class="mx5-dlg-dd-val">{{ (_dlgr_pk * 100)|round|int }}%</div>
            <div class="mx5-dlg-dd-sub">{% if _dlgr_pk_ago is not none %}<span class="l-en">{{ _dlgr_pk_ago }}d ago</span><span class="l-zh">{{ _dlgr_pk_ago }}天前</span>{% endif %}</div>
          </div>
          {% endif %}
        </div>
        <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.5;margin-bottom:8px">
          <span class="l-en">Model estimates vs historical base rates (SPY proxy). Display-only — not forecasts.</span>
          <span class="l-zh">模型估计，依历史基准率校准（SPY代理）。仅供展示，非预测。</span>
        </div>
        {% endif %}

        {# MX2-SENTIMENT block — RELOCATED from risk tray; content byte-verbatim #}
        {% set _rdr2 = market_state.radar if market_state.radar is defined else {} %}
        {% set _rdr_state2 = _rdr2.state if _rdr2 else 'unknown' %}
        {% set _rdr_col2 = 'var(--down)' if _rdr_state2 == 'risk-off' else ('var(--orange,var(--warn))' if _rdr_state2 in ('elevated','caution') else 'var(--up)') %}
        <div style="margin-top:20px">
        {# MX2-SENTIMENT-START #}
        {% set ff = froth_fragility if froth_fragility is defined else none %}
        {% set fe = fear_euphoria if fear_euphoria is defined else none %}
        {% set fg = fear_greed if fear_greed is defined else none %}
        {% if ff is not none or fe is not none or fg is not none %}
          {% set _ff_score = (ff.score if (ff.score is defined and ff.score is not none) else (ff.headline if (ff.headline is defined and ff.headline is not none) else none)) if ff is not none else none %}
          {% set _ff_x = ff.euphoria_z if (ff is not none and ff.euphoria_z is defined) else none %}
          {% set _ff_y = ff.fragility_z if (ff is not none and ff.fragility_z is defined) else none %}
          {% set ax = (_ff_x * 16.67 + 50) | round | int if _ff_x is not none else ((ff.face_a.score | round | int) if (ff is not none and ff.face_a is defined and ff.face_a.score is defined and ff.face_a.score is not none) else none) %}
          {% set bx = (_ff_y * 16.67 + 50) | round | int if _ff_y is not none else ((ff.face_b.score | round | int) if (ff is not none and ff.face_b is defined and ff.face_b.score is defined and ff.face_b.score is not none) else none) %}
          {% set _fg_val = fg.dial if (fg and fg.dial is defined and fg.dial is not none) else none %}
          {% set _fg_zone = fg.label_en if (fg and fg.label_en is defined) else 'Neutral' %}
          {% set _fg_zh = fg.label_zh if (fg and fg.label_zh is defined) else _fg_zone %}
          {% set _fe_bull = fe.bull_pct if (fe and fe.bull_pct is defined and fe.bull_pct is not none) else none %}
          {% set _fe_bear = fe.bear_pct if (fe and fe.bear_pct is defined and fe.bear_pct is not none) else none %}

          <div class="mx2-risk-section" id="sentiment-regime">
            <div class="mx2-risk-section-hd">{{ t('Fear ↔ Euphoria: regime synthesis','恐惧 ↔ 欣喜：周期综合') }}</div>
            {% if fe is not none and fe.fe_score is defined and fe.fe_score is not none %}
            {% set _bandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'} %}
            <div class="mx2-sent-row">
              <div class="mx2-sent-key"><span class="num">{{ fe.fe_score }}</span>
                <span class="chip {{ 'c-down' if fe.band in ['Panic','Fear'] else ('c-up' if fe.band in ['Greed','Euphoria'] else 'c-muted') }}">{{ t(fe.band, _bandzh.get(fe.band, fe.band)) }}</span>
              </div>
              <div class="mx2-sent-bar"><div class="mx2-sent-fill" style="width:{{ fe.fe_score }}%;background:{{ 'var(--down)' if fe.fe_score < 30 else ('var(--warn)' if fe.fe_score < 50 else 'var(--up)') }}"></div></div>
            </div>
            <div class="grad-labels" style="display:flex;justify-content:space-between;font-size:9px;color:var(--muted);margin-bottom:6px">
              <span>{{ t('Panic','恐慌') }}</span><span>{{ t('Fear','恐惧') }}</span><span>{{ t('Neutral','中性') }}</span><span>{{ t('Greed','贪婪') }}</span><span>{{ t('Euphoria','欣喜') }}</span>
            </div>
            {% endif %}

            {% if _fg_val is not none %}
            <div class="mx2-sent-row">
              <div class="mx2-sent-key">{{ t('Fear/Greed','恐贪指数') }}</div>
              <div class="mx2-sent-bar"><div class="mx2-sent-fill" style="width:{{ _fg_val }}%;background:{{ 'var(--down)' if _fg_val < 30 else ('var(--up)' if _fg_val >= 65 else 'var(--warn)') }}"></div></div>
              <div class="mx2-sent-val"><span class="num">{{ _fg_val|round|int }}</span>
                <span class="l-en">{{ _fg_zone }}</span><span class="l-zh">{{ _fg_zh }}</span></div>
            </div>
            {% endif %}

            {% if _ff_score is not none %}
            <div class="mx2-sent-row" id="froth-fragility">
              <div class="mx2-sent-key">{{ t('Froth & Fragility','狂热与脆弱') }}</div>
              <div class="mx2-sent-bar"><div class="mx2-sent-fill" style="width:{{ _ff_score }}%;background:{{ 'var(--warn)' if _ff_score >= 60 else 'var(--muted)' }}"></div></div>
              <div class="mx2-sent-val"><span class="num">{{ _ff_score|round|int }}</span>
                {% if ff.band is defined and ff.band %}<span class="l-en">{{ ff.band|capitalize }}</span><span class="l-zh">{{ ff.band_zh if (ff.band_zh is defined and ff.band_zh) else ff.band }}</span>{% endif %}
                {% if ff.provisional is defined and ff.provisional %}<span class="l-en muted"> provisional</span><span class="l-zh muted"> 暂定</span>{% endif %}
              </div>
            </div>
            {% endif %}

            {% if _fe_bull is not none %}
            <div class="mx2-sent-row">
              <div class="mx2-sent-key">{{ t('Bulls/Bears','多/空') }}</div>
              <div class="mx2-sent-bar"><div class="mx2-sent-fill" style="width:{{ _fe_bull }}%;background:{{ 'var(--up)' if _fe_bull >= 55 else ('var(--down)' if _fe_bull < 35 else 'var(--warn)') }}"></div></div>
              <div class="mx2-sent-val"><span class="num">{{ _fe_bull }}%</span> <span class="l-en">bull</span><span class="l-zh">多头</span></div>
            </div>
            {% endif %}

            {% if ff is not none and ff.quadrant_en is defined and ff.quadrant_en %}
            <div class="muted sm" style="margin:4px 0"><span class="l-en">{{ ff.quadrant_en }}</span><span class="l-zh">{{ ff.quadrant_zh if (ff.quadrant_zh is defined and ff.quadrant_zh) else ff.quadrant_en }}</span></div>
            {% endif %}
            {% if ax is not none and bx is not none %}
            <div class="froth-split">
              <div class="froth-split-item"><div class="froth-split-lbl">{{ t('Euphoria','欣喜') }}</div><div class="froth-split-val">{{ ax|round|int }}</div></div>
              <div class="froth-split-item"><div class="froth-split-lbl"><span class="l-en">Fragility / distribution</span><span class="l-zh">脆弱／派发</span></div><div class="froth-split-val">{{ bx|round|int }}</div></div>
            </div>
            <div class="muted sm" style="margin-top:8px">{% if ff.track_record and ff.track_record.n %}{{ t('Forward record','前瞻记录') }}: {{ ff.track_record.n }} {{ t('firings','次触发') }} · {{ (ff.track_record.hit_rate * 100)|round|int }}% {{ t('hit','命中') }}. {% else %}{{ t('Forward record accruing.','前瞻记录积累中。') }} {% endif %}{{ t('Display-only — the response is sizing, not selection.','仅供展示——应对是调整仓位，而非选股。') }}</div>
            {% endif %}
          </div>
          {% endif %}{# /froth_fragility card gate #}

        {# MX2-SENTIMENT-END #}
        </div>

      </div>
    </div>
  </div>
  {% endif %}{# /market_state — dlg-risk #}

  {# dlg-policy: Policy lever + repricing #}
  {% if policy_lever is defined and policy_lever %}
  <div class="mx5-dlg" id="dlg-policy" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Policy — Lever State &amp; Repricing</span><span class="l-zh">政策 — 杠杆状态与重定价</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        <div id="dlg-policy-lever-card">
          {% set _DPL = policy_lever %}
          {% set _dpl_s = _DPL.get('state') or 'QUIET' %}
          {% set _dplc = 'c-down' if _dpl_s == 'ARMED' else ('c-warn' if _dpl_s == 'ELEVATED' else 'c-muted') %}
          {# State header #}
          <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px">
            <span class="chip {{ _dplc }}" style="font-size:15px;padding:6px 16px;font-weight:700">
              <span class="l-en">{{ _dpl_s }}</span><span class="l-zh">{{ {'ARMED':'已触发','ELEVATED':'警戒','QUIET':'平静'}.get(_dpl_s, _dpl_s) }}</span>
            </span>
            <div>
              <div style="font-size:13px;font-weight:600"><span class="l-en">{{ {'ARMED':'Active repricing in progress','ELEVATED':'Elevated — watch for market repricing','QUIET':'No active policy pressure'}.get(_dpl_s,'') }}</span><span class="l-zh">{{ {'ARMED':'重定价进行中','ELEVATED':'警戒 — 留意市场重定价','QUIET':'当前无积极政策压力'}.get(_dpl_s,'') }}</span></div>
              {% if _DPL.get('as_of') %}<div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">As of {{ _DPL.as_of }}</span><span class="l-zh">截至 {{ _DPL.as_of }}</span></div>{% endif %}
            </div>
          </div>
          {# Framing note (plain-word) #}
          {% if _DPL.get('framing') %}
          <div style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));line-height:1.6;margin-bottom:16px;padding:10px 14px;background:rgba(255,255,255,.04);border-radius:8px">
            <span class="l-en">{{ _DPL.framing }}</span><span class="l-zh">{{ _DPL.get('framing_zh') or _DPL.framing }}</span>
          </div>
          {% endif %}
          {# Fed stance row #}
          {% set _dpl_fed = (latest.fed_stance.stance if (latest is defined and latest.fed_stance is defined and latest.fed_stance and latest.fed_stance.stance is defined and latest.fed_stance.stance != 'unknown') else none) %}
          {% if _dpl_fed %}
          {% set _dpl_fsl = {'hawkish':'Hawkish — leaning toward tighter policy','very-hawkish':'Very Hawkish — strong tightening bias','dovish':'Dovish — leaning toward rate cuts','very-dovish':'Very Dovish — strong easing bias','neutral':'Neutral — no clear lean'} %}
          {% set _dpl_fsl_zh = {'hawkish':'鹰派 — 倾向收紧政策','very-hawkish':'超鹰派 — 强烈收紧倾向','dovish':'鸽派 — 倾向降息','very-dovish':'超鸽派 — 强烈宽松倾向','neutral':'中性 — 无明确倾向'} %}
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:rgba(255,255,255,.04);border-radius:8px;margin-bottom:8px">
            <span style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6))"><span class="l-en">Fed stance</span><span class="l-zh">美联储立场</span></span>
            <span style="font-size:12px;font-weight:600"><span class="l-en">{{ _dpl_fsl.get(_dpl_fed, _dpl_fed) }}</span><span class="l-zh">{{ _dpl_fsl_zh.get(_dpl_fed, _dpl_fed) }}</span></span>
          </div>
          {% endif %}
          {# Flip confirmation #}
          {% if flip_confirmation is defined and flip_confirmation and flip_confirmation.last_event is defined %}
          {% set _DFC = flip_confirmation %}
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:rgba(255,255,255,.04);border-radius:8px;margin-bottom:8px">
            <span style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6))"><span class="l-en">Last confirmed flip</span><span class="l-zh">最近确认翻转</span></span>
            <span style="font-size:12px;font-weight:600;font-variant-numeric:tabular-nums">{{ _DFC.last_event.event_date }}</span>
          </div>
          {% if _DFC.last_event.get('description') or _DFC.last_event.get('description_zh') %}
          <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.6;margin-bottom:8px;padding-left:4px">
            <span class="l-en">{{ _DFC.last_event.get('description','') }}</span><span class="l-zh">{{ _DFC.last_event.get('description_zh') or _DFC.last_event.get('description','') }}</span>
          </div>
          {% endif %}
          {% endif %}
          {# Repricing components #}
          {% set _dplrepr = _DPL.get('repricing_components') %}
          {% if _dplrepr %}
          <div class="mx5-dlg-sep"></div>
          <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:10px"><span class="l-en">Active repricing channels</span><span class="l-zh">活跃重定价渠道</span></div>
          <div style="display:flex;flex-direction:column;gap:8px">
            {% for r in _dplrepr %}
            <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:rgba(245,158,11,.05);border:1px solid rgba(245,158,11,.14);border-radius:8px">
              <span style="font-size:12px"><span class="l-en">{{ r.label_en if r.label_en is defined else r.name }}</span><span class="l-zh">{{ r.label_zh if r.label_zh is defined else (r.name_zh if r.name_zh is defined else r.name) }}</span></span>
              <span class="chip c-warn" style="font-size:11px;padding:2px 8px"><span class="l-en">Active</span><span class="l-zh">活跃</span></span>
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {# Jawboning counts #}
          {% if _DPL.get('jawboning') %}
          {% set _DJW = _DPL.jawboning %}
          {% if _DJW.get('n_7d') is not none %}
          <div class="mx5-dlg-sep"></div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:rgba(255,255,255,.04);border-radius:8px;margin-bottom:8px">
            <span style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6))"><span class="l-en">Jawboning events (7 day / 30 day)</span><span class="l-zh">政策发声次数（7日 / 30日）</span></span>
            <span style="font-size:13px;font-weight:700;font-variant-numeric:tabular-nums">{{ _DJW.n_7d }} / {{ _DJW.n_30d }}</span>
          </div>
          {% if _DJW.get('last_alert_summary') %}
          <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.6;padding-left:4px">
            <span class="l-en">{{ _DJW.last_alert_summary }}</span><span class="l-zh">{{ _DJW.get('last_alert_summary_zh') or _DJW.last_alert_summary }}</span>
          </div>
          {% endif %}
          {% endif %}
          {% endif %}
          {# Disclaimer #}
          <div class="mx5-dlg-sep"></div>
          <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));line-height:1.6">
            <span class="l-en">Context only — not a forecast.</span>
            <span class="l-zh">仅供参考 — 非预测。</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}{# /policy_lever — dlg-policy #}

  {# dlg-aibrief: AI Brief synthesis (v5.2 rebuild 1.5) #}
  {% if mode != 'stocks' %}
  <div class="mx5-dlg" id="dlg-aibrief" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">AI Brief — Synthesis</span><span class="l-zh">AI简报 — 综合</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {# Header row: icon + title + date + badge. No outer <a> wrapper. #}
        <div class="isle-aibrief-hdr">
          <div class="isle-aibrief-icon">AI</div>
          <div>
            <div style="font-size:13px;font-weight:700;color:var(--text)"><span class="l-en">AI Daily Brief · cross-asset synthesis</span><span class="l-zh">AI 每日简报 · 跨资产综合</span></div>
            <div class="num" style="font-size:11px;color:var(--muted)">{% if master_brief is defined and master_brief and master_brief.get('state_asof') %}{{ master_brief.get('state_asof') }}{% else %}{{ latest.date if latest.date else generated_utc[:10] }}{% endif %}</div>
          </div>
          {# Mandatory house-law note — never delete #}
          <span class="isle-aibrief-badge"><span class="l-en">A read-through of existing signals — not a signal source</span><span class="l-zh">仅为现有信号的汇总解读 — 非独立信号源</span></span>
        </div>
        {# Full brief body when master_brief is present #}
        {% if master_brief is defined and master_brief and master_brief.get('summary') %}
        {% set _mb_zh = master_brief.get('zh') or {} %}
        {# 1. Summary — lead paragraph #}
        <div style="font-size:14px;font-weight:600;color:var(--text);line-height:1.7;margin-bottom:14px">
          <span class="l-en">{{ master_brief.get('summary') }}</span>
          <span class="l-zh">{{ _mb_zh.get('summary') or master_brief.get('summary') }}</span>
        </div>
        {# 2. Regime read #}
        {% if master_brief.get('regime_read') is not none and master_brief.get('regime_read') %}
        <div style="font-size:13px;color:var(--text);line-height:1.7;margin-bottom:14px">
          <span class="l-en">{{ master_brief.get('regime_read') }}</span>
          <span class="l-zh">{{ _mb_zh.get('regime_read') or master_brief.get('regime_read') }}</span>
        </div>
        {% endif %}
        {# 3. Conflicts #}
        {% if master_brief.get('conflicts') is not none and master_brief.get('conflicts') %}
        {% set _mb_conflicts_zh = _mb_zh.get('conflicts') or [] %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Where signals disagree</span><span class="l-zh">信号分歧</span></div>
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px">
          {% for _ci in master_brief.get('conflicts') %}
          {% set _ci_zh = _mb_conflicts_zh[loop.index0] if _mb_conflicts_zh and loop.index0 < _mb_conflicts_zh|length else _ci %}
          <div style="font-size:12px;color:var(--text);line-height:1.6;padding:8px 12px;background:rgba(255,255,255,.03);border-radius:8px;border-left:2px solid rgba(255,255,255,.12)">
            <span class="l-en">{{ _ci }}</span>
            <span class="l-zh">{{ _ci_zh }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {# 4. Rotation check #}
        {% if master_brief.get('rotation_check') is not none and master_brief.get('rotation_check') %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Rotation</span><span class="l-zh">轮动</span></div>
        <div style="font-size:13px;color:var(--text);line-height:1.7;margin-bottom:14px">
          <span class="l-en">{{ master_brief.get('rotation_check') }}</span>
          <span class="l-zh">{{ _mb_zh.get('rotation_check') or master_brief.get('rotation_check') }}</span>
        </div>
        {% endif %}
        {# 5. Transmission #}
        {% if master_brief.get('transmission') is not none and master_brief.get('transmission') %}
        {% set _mb_tx_zh = _mb_zh.get('transmission') or [] %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Transmission</span><span class="l-zh">传导</span></div>
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px">
          {% for _ti in master_brief.get('transmission') %}
          {% set _ti_zh = _mb_tx_zh[loop.index0] if _mb_tx_zh and loop.index0 < _mb_tx_zh|length else _ti %}
          <div style="font-size:12px;color:var(--text);line-height:1.6;padding:8px 12px;background:rgba(255,255,255,.03);border-radius:8px;border-left:2px solid rgba(255,255,255,.12)">
            <span class="l-en">{{ _ti }}</span>
            <span class="l-zh">{{ _ti_zh }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {# 6. Watch items #}
        {% if master_brief.get('watch_items') is not none and master_brief.get('watch_items') %}
        {% set _mb_wi_zh = _mb_zh.get('watch_items') or [] %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">What to watch</span><span class="l-zh">关注事项</span></div>
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px">
          {% for _wi in master_brief.get('watch_items') %}
          {% set _wi_zh = _mb_wi_zh[loop.index0] if _mb_wi_zh and loop.index0 < _mb_wi_zh|length else _wi %}
          <div style="font-size:12px;color:var(--text);line-height:1.6;padding:8px 12px;background:rgba(255,255,255,.03);border-radius:8px;border-left:2px solid rgba(255,255,255,.12)">
            <span class="l-en">{{ _wi }}</span>
            <span class="l-zh">{{ _wi_zh }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {# 7. Footer receipt line — confidence + asof + degraded_reason #}
        {% set _mb_conf = master_brief.get('confidence') %}
        {% set _mb_deg = master_brief.get('degraded_reason') %}
        <div style="font-size:11px;color:var(--muted);line-height:1.5;margin-bottom:12px">
          {% if _mb_conf is not none and _mb_conf %}<span class="l-en">Confidence: {{ _mb_conf }}</span><span class="l-zh">置信度：{{ _mb_conf }}</span>{% endif %}
          {% if _mb_conf is not none and _mb_conf and master_brief.get('state_asof') %} · {% endif %}
          {% if master_brief.get('state_asof') is not none and master_brief.get('state_asof') %}<span>as of {{ master_brief.get('state_asof') }}</span>{% endif %}
          {% if _mb_deg is not none and _mb_deg %}
          <div style="margin-top:4px"><span class="l-en">Today's brief ran degraded: {{ _mb_deg }}</span><span class="l-zh">今日简报为降级运行：{{ _mb_deg }}</span></div>
          {% endif %}
        </div>
        {# 8. Footer link to full brief page #}
        <div class="isle-aibrief-footer"><span></span><a href="aibrief.html" class="isle-aibrief-link"><span class="l-en">Full brief page (China &amp; Bitcoin lenses) →</span><span class="l-zh">完整简报页（中国与比特币视角）→</span></a></div>
        {% else %}
        {# Fallback teaser when master_brief is absent #}
        {% if macro_news is defined and macro_news and macro_news.synthesis and macro_news.synthesis.get('read') %}
        {% set _dlg_syn = macro_news.synthesis %}
        {% set _dlg_ch_zh = {'monetary':'美联储与利率','inflation':'通胀','labor':'就业','growth':'增长','credit':'信贷','fiscal':'财政','fiscal_trade':'财政与贸易','earnings':'业绩','guidance':'指引','analyst':'分析师','deals':'并购','capital_return':'回购','stocks':'个股','macro':'宏观','rates':'利率','stock_wire':'个股快讯'} %}
        {% set _dlg_ch_en = {'capital_return':'buybacks','fiscal_trade':'fiscal & trade','stock_wire':'stock wire','monetary':'Fed & rates'} %}
        <div class="isle-aibrief-body">
          <span class="l-en">{{ _dlg_syn.get('high_impact_count', 0) }} high-impact item{{ 's' if _dlg_syn.get('high_impact_count', 0) != 1 }} today{% if _dlg_syn.get('dominant_channel') %} · dominant: <strong>{{ _dlg_ch_en.get(_dlg_syn.dominant_channel, _dlg_syn.dominant_channel|replace('_',' ')) }}</strong>{% endif %}</span>
          <span class="l-zh">今日 {{ _dlg_syn.get('high_impact_count', 0) }} 条高影响信息{% if _dlg_syn.get('dominant_channel') %} · 主导：<strong>{{ _dlg_ch_zh.get(_dlg_syn.dominant_channel, _dlg_syn.dominant_channel) }}</strong>{% endif %}</span>
        </div>
        {% else %}
        <div class="isle-aibrief-body">{{ t('AI reads every dashboard in one place — the regime, where signals conflict, the rotation thesis and what to watch next. Research context only, never a signal.', 'AI 在一处解读每个看板 — 周期、信号冲突、轮动假设与后续关注。仅供研究参考，绝非交易信号。') }}</div>
        {% endif %}
        <div class="isle-aibrief-footer"><span></span><a href="aibrief.html" class="isle-aibrief-link">{{ t('Full AI brief →','完整 AI 简报 →') }}</a></div>
        {% endif %}
      </div>
    </div>
  </div>

  {# dlg-news: Alerts + market intelligence #}
  <div class="mx5-dlg" id="dlg-news" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">News — Market Intelligence</span><span class="l-zh">新闻 — 市场情报</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {# All fired alerts #}
        {% if alerts %}
        {% set _dlg_alv5_all = alerts %}
        {% set _dlg_alv5_sorted = (_dlg_alv5_all | selectattr('severity','in',('warn','high','critical')) | list) + (_dlg_alv5_all | rejectattr('severity','in',('warn','high','critical')) | list) %}
        <div class="isle-head"><div class="isle-head-dot"></div><span class="isle-head-label"><span class="l-en">All Fired Alerts</span><span class="l-zh">全部触发警报</span></span><div class="isle-head-line"></div></div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px">
          {% for a in _dlg_alv5_sorted %}
          {% set _asev2 = 'warn' if a.severity in ('warn','high','critical') else 'info' %}
          <div style="display:flex;gap:10px;padding:12px;background:{{ 'rgba(245,158,11,.06)' if _asev2=='warn' else 'rgba(255,255,255,.03)' }};border-radius:10px;border:1px solid {{ 'rgba(245,158,11,.18)' if _asev2=='warn' else 'rgba(255,255,255,.06)' }}">
            <div style="width:8px;height:8px;border-radius:50%;background:{{ 'var(--mx5-warn)' if _asev2=='warn' else 'var(--ink-3,rgba(255,255,255,.36))' }};flex-shrink:0;margin-top:5px"></div>
            <div>
              <div style="font-size:13px;font-weight:600;color:{{ 'var(--mx5-warn)' if _asev2=='warn' else 'var(--ink-1,rgba(255,255,255,.92))' }};margin-bottom:4px"><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh or a.plain_en }}</span></div>
              <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.5"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {# Headlines #}
        {% if macro_news and macro_news.headlines %}
        <div class="isle-head"><div class="isle-head-dot"></div><span class="isle-head-label"><span class="l-en">Market Intelligence</span><span class="l-zh">市场情报</span></span><div class="isle-head-line"></div></div>
        {% set _dlg_TL_nb = {'monetary':['Fed','美联储'],'inflation':['Inflation','通胀'],'labor':['Labor','就业'],'growth':['Growth','增长'],'credit':['Rates','利率'],'fiscal':['Fiscal','财政'],'earnings':['Earnings','业绩'],'guidance':['Guidance','指引'],'analyst':['Analysts','分析师'],'deals':['Deals','并购/IPO'],'capital_return':['Buybacks','回购/分红'],'stocks':['Stocks','个股'],'macro':['Macro','宏观']} %}
        <div class="nb-acc" style="margin-top:12px">
          {% for h in macro_news.headlines[:10] %}
          {% set _dlg_tl = _dlg_TL_nb.get(h.theme, [h.theme, h.theme]) %}
          <details class="nb-item"{% if loop.first %} open{% endif %}>
            <summary class="nb-sum">
              <span class="nb-theme">{{ t(_dlg_tl[0], _dlg_tl[1]) }}</span>
              <span class="nb-htitle"><span class="l-en">{{ h.title }}</span><span class="l-zh">{{ h.title_zh or h.title }}</span></span>
            </summary>
            <div class="nb-body">
              <a class="nb-read" href="{{ h.url }}" target="_blank" rel="noopener">{{ t('Read source','阅读原文') }} →</a>
            </div>
          </details>
          {% endfor %}
        </div>
        {% endif %}
        <div style="margin-top:16px;text-align:center">
          <a href="news.html" style="color:var(--link);font-weight:700;font-size:13px">{{ t('Open the full news feed →','打开完整新闻流 →') }}</a>
        </div>
      </div>
    </div>
  </div>

