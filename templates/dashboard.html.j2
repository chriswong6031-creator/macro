  .dash-tw-asof { font-size:10px; color:var(--muted); margin-left:auto; }
  .dash-tw-sub { font-size:11.5px; color:var(--text); opacity:.8; margin:-3px 0 7px; }
  .dash-tw-rows { display:flex; flex-direction:column; gap:5px; }
