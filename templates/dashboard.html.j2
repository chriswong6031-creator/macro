@media(max-width:390px){body.page-macro .mx-idx-health-grid{grid-template-columns:1fr 1fr}}

/* ── NEWS board chrome (mx additions) ── */
body.page-macro #now-board .mx-ni-top{display:flex;align-items:center;gap:6px;margin-bottom:3px;flex-wrap:wrap}
body.page-macro #now-board .mx-ni-tag{font-size:9px;font-weight:700;letter-spacing:.06em;padding:2px 6px;border-radius:4px;text-transform:uppercase}
body.page-macro #now-board .mx-ni-tag.macro{background:color-mix(in srgb,var(--warn) 12%,transparent);color:var(--warn);border:1px solid color-mix(in srgb,var(--warn) 22%,transparent)}
body.page-macro #now-board .mx-ni-tag.earnings{background:color-mix(in srgb,var(--q2) 14%,transparent);color:var(--q2);border:1px solid color-mix(in srgb,var(--q2) 25%,transparent)}
body.page-macro #now-board .mx-ni-tag.stocks{background:color-mix(in srgb,var(--info) 14%,transparent);color:var(--info);border:1px solid color-mix(in srgb,var(--info) 25%,transparent)}
body.page-macro #now-board .mx-ni-date{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
body.page-macro #now-board .mx-ni-score{font-size:10px;font-weight:700;color:var(--muted);margin-left:auto}
body.page-macro #now-board .mx-ni-impact{font-size:10px;font-weight:700;padding:1px 6px;border-radius:4px}
body.page-macro #now-board .mx-ni-impact.high{background:color-mix(in srgb,var(--warn) 14%,transparent);color:var(--warn);border:1px solid color-mix(in srgb,var(--warn) 22%,transparent)}
body.page-macro #now-board .mx-ni-impact.med{background:color-mix(in srgb,var(--info) 12%,transparent);color:var(--info);border:1px solid color-mix(in srgb,var(--info) 20%,transparent)}

/* ── LINK-OUT strip ── */
body.page-macro .mx-linkout-strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:9px;margin-top:0}
body.page-macro .mx-linkout-card{display:flex;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px;text-decoration:none;transition:border-color .15s,transform .15s,box-shadow .15s}
body.page-macro .mx-linkout-card:hover{border-color:var(--link);transform:translateY(-1px);box-shadow:0 4px 14px rgba(0,0,0,.25);text-decoration:none}
body.page-macro .mx-lc-icon{font-size:18px;flex-shrink:0}
body.page-macro .mx-lc-title{font-size:12px;font-weight:700;color:var(--text)}
body.page-macro .mx-lc-sub{font-size:10px;color:var(--muted);margin-top:2px}
@media(max-width:390px){body.page-macro .mx-linkout-strip{grid-template-columns:1fr}}

/* ── DISLOCATION + HEALTH light chrome ── */
body.page-macro .mx-panel-hdr{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
