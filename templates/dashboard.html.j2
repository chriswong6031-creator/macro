            <span title="signal triggered {{ n.signal_date }} · 信号触发 {{ n.signal_date }}">⏱ {{ t(n.age_short, n.age_short_zh) if n.age_short else (n.signal_date or '') }}</span>
          </div>
          {% if n.alpha_z is not none or n.insider_buyers or n.sue_z %}
