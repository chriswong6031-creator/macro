      <section id="fear-greed" style="flex:1 1 320px;min-width:0;border-left:3px solid {{ _fgc }};padding-left:14px">
        <h3 style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:0">{{ t('Fear / Greed sentiment context','恐惧/贪婪情绪参考') }}
