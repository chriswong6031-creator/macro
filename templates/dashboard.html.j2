  {# ── mx5OpenDlg dialog system (v5.1) — macro mode only ── #}
  <script>
  (function(){
    /* Aurora @property polyfill */
    if(CSS && CSS.registerProperty){
      try{ CSS.registerProperty({name:'--isle-aurora-angle',syntax:'<angle>',inherits:false,initialValue:'0deg'}); }catch(e){}
    }

    /* ── mx5OpenDlg / mx5CloseDlg ─────────────────────────────────
       Centered glass dialog (≥701px) / bottom sheet (≤700px).
       focus-trap: Tab cycles within dialog; focus restores on close.
       body scroll lock while open; aria-modal; reduced-motion aware.
    ─────────────────────────────────────────────────────────────── */
    var _dlgActive = null;
    var _dlgTrigger = null;
    var _dlgScrollY = 0;   /* page scroll captured at first dialog open (M03 scroll lock) */

    /* Release the document scroll lock and restore the saved scroll position.
       Idempotent — safe to call even if no dialog locked the page. */
    function _dlgReleaseScroll(){
      if(!document.documentElement.classList.contains('mx5-dlg-lock')) return;
      document.documentElement.classList.remove('mx5-dlg-lock');
      document.body.style.top = '';
      window.scrollTo(0, _dlgScrollY);
    }

    function _focusFirst(dlg){
      var focusable = dlg.querySelectorAll('button,a[href],[tabindex]:not([tabindex="-1"])');
      if(focusable.length) focusable[0].focus();
    }

    function _trapTab(dlg, e){
      if(e.key !== 'Tab') return;
      var focusable = Array.prototype.slice.call(
        dlg.querySelectorAll('button:not([disabled]),a[href],[tabindex]:not([tabindex="-1"])'));
      if(!focusable.length) return;
      var first = focusable[0], last = focusable[focusable.length-1];
      if(e.shiftKey){ if(document.activeElement===first){ e.preventDefault(); last.focus(); } }
      else { if(document.activeElement===last){ e.preventDefault(); first.focus(); } }
    }

    function _prefReduced(){
      return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches);
    }
    /* Immediate teardown (no animation) — used when switching dialogs or as fallback. */
    function _dlgTeardown(dlg, restoreFocus){
      dlg.classList.remove('open','mx5-dlg-in','mx5-dlg-closing');
      dlg.removeAttribute('aria-modal');
      if(dlg._trapHandler){ dlg.removeEventListener('keydown', dlg._trapHandler); delete dlg._trapHandler; }
      var bd = dlg.querySelector('.mx5-dlg-backdrop');
      if(bd && bd._clickH){ bd.removeEventListener('click', bd._clickH); delete bd._clickH; }
      if(dlg._closeTimer){ clearTimeout(dlg._closeTimer); delete dlg._closeTimer; }
      if(dlg._endH){ var pnl0=dlg.querySelector('.mx5-dlg-panel'); if(pnl0) pnl0.removeEventListener('transitionend', dlg._endH); delete dlg._endH; }
      if(restoreFocus && _dlgTrigger && typeof _dlgTrigger.focus === 'function') _dlgTrigger.focus();
    }

    window.mx5OpenDlg = function(id){
      /* Close any open scorecard popovers first */
      if(window.mx5CloseAllPopovers) window.mx5CloseAllPopovers();
      /* Switching dialogs: tear the previous one down instantly (no lingering animation). */
      if(_dlgActive){ _dlgTeardown(_dlgActive, false); _dlgActive = null; }
      var dlg = document.getElementById(id);
      if(!dlg) return;
      /* Heatmap adoption: on first open of dlg-markets, move #heatmap-scorecard into the
         dialog placeholder so it renders at 920px dialog scale (idempotent). */
      if(id === 'dlg-markets'){
        var hmSrc = document.getElementById('heatmap-scorecard');
        var hmDst = document.getElementById('dlg-heatmap-scorecard');
        if(hmSrc && hmDst && hmDst !== hmSrc.parentNode){
          hmDst.appendChild(hmSrc);
          var stage = document.querySelector('.mx5-hm-stage');
          if(stage && stage.parentNode) stage.parentNode.removeChild(stage);
          window.dispatchEvent(new Event('resize'));
        }
      }
      _dlgTrigger = document.activeElement;
      _dlgActive = dlg;
      dlg.classList.remove('mx5-dlg-closing');
      /* 1) make it displayed (start state painted) */
      dlg.classList.add('open');
      dlg.setAttribute('aria-modal','true');
      /* Scroll lock (M03): lock the real scroller (<html>) and freeze <body> at the
         current scrollY so wheel/trackpad/arrow scrolling can't leak to the page
         behind the modal. Capture only on first open (switching dialogs is a no-op). */
      if(!document.documentElement.classList.contains('mx5-dlg-lock')){
        _dlgScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
        document.body.style.top = (-_dlgScrollY) + 'px';
        document.documentElement.classList.add('mx5-dlg-lock');
      }
      document.body.classList.add('mx5-dlg-open');
      /* 2) next frame(s): add .mx5-dlg-in so opacity/transform transitions actually run.
         Double rAF guarantees the start state is committed before the class flips. */
      if(_prefReduced()){
        dlg.classList.add('mx5-dlg-in');
      } else {
        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          if(_dlgActive === dlg) dlg.classList.add('mx5-dlg-in');
        }); });
      }
      _focusFirst(dlg);
      dlg._trapHandler = function(e){ _trapTab(dlg, e); };
      dlg.addEventListener('keydown', dlg._trapHandler);
      /* backdrop click */
      var bd = dlg.querySelector('.mx5-dlg-backdrop');
      if(bd){ bd._clickH = function(){ window.mx5CloseDlg(); }; bd.addEventListener('click', bd._clickH); }
    };

    window.mx5CloseDlg = function(){
      if(!_dlgActive) return;
      var dlg = _dlgActive;
      _dlgActive = null;               /* free the slot immediately so re-entrancy is safe */
      document.body.classList.remove('mx5-dlg-open');
      _dlgReleaseScroll();
      dlg.removeAttribute('aria-modal');
      if(dlg._trapHandler){ dlg.removeEventListener('keydown', dlg._trapHandler); delete dlg._trapHandler; }
      var bd = dlg.querySelector('.mx5-dlg-backdrop');
      if(bd && bd._clickH){ bd.removeEventListener('click', bd._clickH); delete bd._clickH; }
      var trig = _dlgTrigger; _dlgTrigger = null;
      var refocus = function(){ if(trig && typeof trig.focus === 'function') trig.focus(); };
      if(_prefReduced()){
        _dlgTeardown(dlg, false); refocus(); return;
      }
      /* 3) reverse the entrance: remove .mx5-dlg-in, add .mx5-dlg-closing (faster),
         wait for the panel's transitionend, THEN remove .open (hide). Timeout fallback
         so a missed transitionend never leaves the dialog stuck visible. */
      dlg.classList.add('mx5-dlg-closing');
      dlg.classList.remove('mx5-dlg-in');
      var pnl = dlg.querySelector('.mx5-dlg-panel');
      var done = function(){
        if(dlg._closeTimer){ clearTimeout(dlg._closeTimer); delete dlg._closeTimer; }
        if(dlg._endH && pnl){ pnl.removeEventListener('transitionend', dlg._endH); delete dlg._endH; }
        dlg.classList.remove('open','mx5-dlg-closing');
        refocus();
      };
      dlg._endH = function(e){ if(e.target === pnl && (e.propertyName === 'transform' || e.propertyName === 'opacity')) done(); };
      if(pnl) pnl.addEventListener('transitionend', dlg._endH);
      dlg._closeTimer = setTimeout(done, 340);
    };

    /* Escape handler: dialog > scorecard popover > release radar modal guards */
    document.addEventListener('keydown', function(e){
      if(e.key !== 'Escape') return;
      /* INT-01: guard release-radar modal/overlay open states */
      var overlay = document.getElementById('rr-modal-overlay');
      if(overlay && overlay.classList.contains('open')) return;
      var trOverlay = document.querySelector('.rr-tr-overlay');
      if(trOverlay && trOverlay.classList.contains('is-open')) return;
      if(_dlgActive){ e.stopImmediatePropagation(); window.mx5CloseDlg(); return; }
    }, true /* capture — runs before the popover handler which uses bubble */);

  })();
  </script>
  {% endif %}{# /if mode != 'stocks' #}



  {# ===================== POLICY-LEVER ARMED/QUIET CARD (Policy-Shock W2-F) =====================
     Display-only conditions context — not a signal, not a forecast.
     PS-R1: card copy never reads or attributes intent; the canonical framing line
     ("not intent, not timing") is the REQUIRED disclaimer and is exempt (PS-A3).
     PS-R3: reads policy_lever.json (site artifact); never feeds scoring.
     PS-R4: no probabilities anywhere in this block.
     Jinja missing-key gotcha guard: every nested access uses the 'defined' test or
     dict.get() notation ('d.key is defined') before accessing — NEVER 'if d.key is not none'
     on a potentially MISSING key (crashes with UndefinedError).
     Stage-B: macro mode uses the policy tray (sx-policy-v2) above; this standalone
     card is kept for stocks mode only.
  #}
  {# Fallback policy-lever-card: renders in NON-macro mode, OR in macro mode only when market_state is absent
     (v2 sx-policy tray handles it when market_state is present). CI test (test_policy_lever.py) uses
     market_state=None fixture so this fallback must be reachable in macro mode. #}
  {% if (mode != 'macro' or not market_state) and policy_lever is defined and policy_lever %}
  {% set PL = policy_lever %}
  {% set _pl_state = PL.get('state') or 'QUIET' %}
  {% set _pl_state_color = 'var(--down)' if _pl_state == 'ARMED' else ('var(--orange)' if _pl_state == 'ELEVATED' else 'var(--muted)') %}
  {# MX POLICY BAND — 3-col layout: col1=Policy Lever state+rows, col2=lever details (repricing-style), col3=flip confirmation summary.
     id="policy-lever-card" is preserved here for deep-link + CI test (tests/test_policy_lever.py checks string presence). #}
  <div class="panel span12" id="policy-lever-card">
    <div class="mx-eyebrow">{{ t('Policy-Lever Conditions & Repricing','政策杠杆条件与重新定价') }}
      {{ help("Conditions that make violent overnight reversals more likely — not a forecast, not a signal. ARMED = semis drawdown deep (≤−15%) AND an oil technical curl; ELEVATED = one of the two; QUIET = neither. Display-only context (Policy-Shock W2-F). Drawdown and arming are descriptive; no probabilities.", "使剧烈隔夜反转更可能发生的条件 — 不是预测，不是信号。触发=半导体回撤深（≤−15%）且石油技术卷曲；警戒=两者之一；平静=均无。仅供展示（政策冲击 W2-F）。回撤和触发均为描述性指标，不含概率。") }}
    </div>
    <div class="mx-policy-band">

      {# COL 1 — Policy-Lever state chip + key rows #}
      <div class="mx-pcol">
        <div class="mx-pcol-label">{{ t('Policy Lever','政策杠杆') }}</div>
        <div class="mx-pcol-state">
          <span class="mx-chip {{ 'mx-c-down' if _pl_state == 'ARMED' else ('mx-c-warn' if _pl_state == 'ELEVATED' else 'mx-c-muted') }}" style="font-size:13px;padding:4px 12px">
            <span class="l-en">{{ _pl_state }}</span><span class="l-zh">{{ {'ARMED':'已触发','ELEVATED':'警戒','QUIET':'平静'}.get(_pl_state, _pl_state) }}</span>
          </span>
        </div>
        {# Favored complex drawdown as first labeled row #}
        {% if PL.get('favored_complex') is defined %}
        {% set _FC = PL.get('favored_complex') or {} %}
        {% if _FC.get('drawdown_pct') is not none %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Favored complex','偏好板块') }}</span>
          <span class="mx-delta-chip {{ 'mx-delta-dn' if _FC.drawdown_pct <= -15 else 'mx-delta-mu' }}">
            {{ _FC.get('basket', [])|join('/') }} {{ '%+.1f'|format(_FC.drawdown_pct) }}%
          </span>
        </div>
        {% endif %}
        {% if _FC.get('basket_caveat') %}
        <div class="mx-pcol-sub" style="color:var(--warn)"><span class="l-en">{{ _FC.basket_caveat }}</span><span class="l-zh">{{ _FC.get('basket_caveat_zh') or _FC.basket_caveat }}</span></div>
        {% endif %}
        {% endif %}
        {# Jawboning row #}
        {% if PL.get('jawboning') is defined %}
        {% set _JW = PL.get('jawboning') or {} %}
        {% if _JW.get('n_7d') is not none %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Jawboning 7d/30d','政策发声 7日/30日') }}</span>
          <span class="mx-delta-chip mx-delta-mu">{{ _JW.n_7d }} / {{ _JW.n_30d }}</span>
        </div>
        {% endif %}
        {% if _JW.get('last_alert_summary') %}
        <div class="mx-pcol-sub"><span class="l-en">{{ _JW.get('last_alert_summary') or '' }}</span><span class="l-zh">{{ _JW.get('last_alert_summary_zh') or _JW.get('last_alert_summary') or '' }}</span></div>
        {% endif %}
        {% endif %}
        {# Calendar note #}
        {% if PL.get('calendar') is defined %}
        {% set _CAL = PL.get('calendar') or {} %}
        {% if _CAL.get('context_note') %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key" style="font-size:10.5px"><span class="l-en">{{ _CAL.get('context_note') or '' }}</span><span class="l-zh">{{ _CAL.get('context_note_zh') or _CAL.get('context_note') or '' }}</span></span>
        </div>
        {% endif %}
        {% endif %}
        {% if PL.get('framing') %}
        <div class="mx-pcol-sub"><span class="l-en">{{ PL.framing }}</span><span class="l-zh">{{ PL.get('framing_zh') or '' }}</span></div>
        {% endif %}
        <div class="mx-pcol-sub">{{ t('Display-only · W2-F · as of','仅供展示 · W2-F · 截至') }} {{ PL.get('as_of') or '' }}</div>
      </div>

      {# COL 2 — Levers: arming state as labeled rows with delta chips #}
      <div class="mx-pcol">
        <div class="mx-pcol-label">{{ t('Lever Arming Status','杠杆触发状态') }}</div>
        {% if PL.get('levers') %}
        {% for lv in PL.levers %}
        {% set _arm = lv.get('arming') %}
        {% set _is_armed = _arm.get('armed') if _arm is not none else false %}
        <div class="mx-prog-row">
          <div class="mx-prog-label-row">
            <span class="muted"><span class="l-en">{{ lv.get('name') or '' }}</span><span class="l-zh">{{ lv.get('name_zh') or lv.get('name') or '' }}</span>{% if lv.get('asset') %} <span style="font-size:9.5px">({{ lv.asset }})</span>{% endif %}</span>
            {% if _arm is not none %}
            <span class="mx-delta-chip {{ 'mx-delta-dn' if _is_armed else 'mx-delta-mu' }}">
              <span class="l-en">{{ 'ARMED' if _is_armed else 'quiet' }}</span>
              <span class="l-zh">{{ '已触发' if _is_armed else '平静' }}</span>
            </span>
            {% else %}
            <span class="mx-delta-chip mx-delta-mu"><span class="l-en">n/a</span><span class="l-zh">不适用</span></span>
            {% endif %}
          </div>
          {% if _arm is not none %}
          <div class="mx-prog-track"><div class="mx-prog-fill" style="width:{{ '100' if _is_armed else '15' }}%;background:{{ 'var(--down)' if _is_armed else 'var(--muted)' }}"></div></div>
          {% if _arm.get('days_in_base') is not none or _arm.get('flatness') is not none %}
          <div style="font-size:10px;color:var(--muted);margin-top:2px">{% if _arm.get('days_in_base') is not none %}{{ _arm.days_in_base }}d base{% endif %}{% if _arm.get('flatness') is not none %} · flat={{ '%.2f'|format(_arm.flatness) }}{% endif %}</div>
          {% endif %}
          {% if _arm.get('basing') or _arm.get('stoch_curl') or _arm.get('macd_curl') %}
