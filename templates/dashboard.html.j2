    {#- Compact decision card for a SECTOR row. Keep this payload intentionally
        glanceable: one setup read, at most three decision metrics, one visual timing
        cue, and one short takeaway. Full model prose belongs on the linked detail page.
        DO NOT REBUILD LAW #1513: FRESH BUY is the worst state on the board (not a buy
        edge); its state tag is warn, never green/up. -#}
    {%- macro ab_sector_pop(x) -%}
    {%- set _reduce_labels = ['TOP WATCH','ROLLING OVER','DECLINE','COUNTERTREND BOUNCE'] -%}
    {%- set _warn_labels = ['FRESH BUY','BOTTOM WATCH','NEARING A LOW','BOTTOMING','BASING','ACCUMULATION'] -%}
    {%- set _up_labels = ['RALLY ON','TURN SIGNALED','UPTREND','BUY ZONE'] -%}
    {%- set _lbl = x.get('label', '') -%}
    {%- set _stag_tone = 'dn' if _lbl in _reduce_labels else ('warn' if _lbl in _warn_labels else ('up' if _lbl in _up_labels else '')) -%}
    <div class="rp-src row-pop-decision" hidden>
      <div class="row-pop-decision-hd">
        <span class="row-pop-mark row-pop-mark--sector" aria-hidden="true">🏛</span>
        <span class="row-pop-heading">
          <span class="row-pop-eyebrow"><span class="l-en">Sector pulse</span><span class="l-zh">板块脉搏</span> · {{ x.ticker }}</span>
          <span class="row-pop-name"><span class="l-en">{{ x.name|e }}</span><span class="l-zh">{{ tr(x.name)|e }}</span></span>
        </span>
        <span class="row-pop-tag {{ _stag_tone }}">{{ td(x.label) }}</span>
      </div>

      <div class="row-pop-summary">
        <span class="row-pop-summary-copy">
          <span class="row-pop-kicker"><span class="l-en">Current setup</span><span class="l-zh">当前形态</span></span>
          <strong>
            {%- if _lbl in _up_labels -%}<span class="l-en">Trend confirmed</span><span class="l-zh">趋势已确认</span>
            {%- elif _lbl in _warn_labels -%}<span class="l-en">Early turn</span><span class="l-zh">早期转向</span>
            {%- elif _lbl in _reduce_labels -%}<span class="l-en">Momentum fading</span><span class="l-zh">动能转弱</span>
            {%- else -%}<span class="l-en">Wait for clarity</span><span class="l-zh">等待明朗</span>{%- endif -%}
          </strong>
          <span class="row-pop-sub">
            {%- if x.get('age_short') -%}<span class="l-en">Signal {{ x.age_short }}</span><span class="l-zh">信号 {{ x.get('age_short_zh', x.age_short) }}</span>{%- endif -%}
            {%- if x.get('age_short') and x.get('dc_day') is not none and x.get('dc_day') is defined %} · {% endif -%}
            {%- if x.get('dc_day') is not none and x.get('dc_day') is defined -%}<span class="l-en">cycle day {{ x.dc_day }}</span><span class="l-zh">周期第 {{ x.dc_day }} 日</span>{%- endif -%}
          </span>
        </span>
        {%- if x.get('rsi_3d') is not none and x.get('rsi_3d') is defined and x.get('stoch_3d') is not none and x.get('stoch_3d') is defined %}
        <span class="row-pop-bars" aria-label="3-day momentum">
          <span><em>RSI</em><i><b style="--bar:{{ '%.0f'|format(x.rsi_3d) }}%"></b></i><strong>{{ '%.0f'|format(x.rsi_3d) }}</strong></span>
          <span><em>STO</em><i><b style="--bar:{{ '%.0f'|format(x.stoch_3d) }}%"></b></i><strong>{{ '%.0f'|format(x.stoch_3d) }}</strong></span>
        </span>
        {%- endif %}
      </div>

      {%- if (x.get('rs_60d') is not none and x.get('rs_60d') is defined) or x.get('eq_badge') or (x.get('buy_zone') is not none and x.get('n_holdings')) %}
      <div class="row-pop-stats">
        {%- if x.get('rs_60d') is not none and x.get('rs_60d') is defined %}
        <span class="row-pop-stat">
          <span class="row-pop-lbl"><span class="l-en">60d lead</span><span class="l-zh">60日领先</span></span>
          <strong class="{{ 'up' if x.rs_60d >= 0 else 'dn' }}">{{ '%+.1f'|format(x.rs_60d) }}%</strong>
          <small><span class="l-en">vs SPY</span><span class="l-zh">相对SPY</span></small>
        </span>
        {%- endif %}
        {%- if x.get('eq_badge') %}
        <span class="row-pop-stat">
          <span class="row-pop-lbl"><span class="l-en">Entry</span><span class="l-zh">入场</span></span>
          <strong class="{{ 'up' if x.eq_dir == 'up' else ('dn' if x.eq_dir == 'down' else '') }}">{{ x.eq_badge }}</strong>
          <small><span class="l-en">timing quality</span><span class="l-zh">时机质量</span></small>
        </span>
        {%- endif %}
        {%- if x.get('buy_zone') is not none and x.get('n_holdings') %}
        <span class="row-pop-stat">
          <span class="row-pop-lbl"><span class="l-en">Breadth</span><span class="l-zh">广度</span></span>
          <strong>{{ x.buy_zone }}/{{ x.n_holdings }}</strong>
          <small><span class="l-en">in buy zone</span><span class="l-zh">处于买入区</span></small>
        </span>
        {%- endif %}
      </div>
      {%- endif %}

      <div class="row-pop-takeaway {{ _stag_tone }}">
        <span aria-hidden="true">→</span>
        <span>
          <b><span class="l-en">What matters</span><span class="l-zh">要点</span></b>
          <span>
            {%- if x.get('two_reads_chip') or x.get('ew_two_reads') or x.get('conflict_reason_en') -%}<span class="l-en">Signals disagree. Keep size small until they align.</span><span class="l-zh">信号不一致，等待同步前保持小仓位。</span>
            {%- elif _lbl in _up_labels -%}<span class="l-en">Trend confirmed — use pullbacks instead of chasing.</span><span class="l-zh">趋势已确认 — 等回调，不追高。</span>
            {%- elif _lbl in _warn_labels -%}<span class="l-en">Early turn — keep size measured while the weekly trend catches up.</span><span class="l-zh">早期转向 — 周线趋势确认前控制仓位。</span>
            {%- elif _lbl in _reduce_labels -%}<span class="l-en">Momentum is fading — protect gains and avoid fresh adds.</span><span class="l-zh">动能转弱 — 保护利润，避免加仓。</span>
            {%- else -%}<span class="l-en">No clean edge yet — wait for the signals to align.</span><span class="l-zh">暂无清晰优势 — 等待信号同步。</span>{%- endif -%}
          </span>
        </span>
      </div>
      <div class="row-pop-decision-ft">
        <span><span class="l-en">Click row for the full sector view</span><span class="l-zh">点击查看完整板块详情</span></span>
        <b>{{ x.ticker }} ↗</b>
      </div>
    </div>
    {%- endmacro -%}
    {#- Compact decision card for a THEME (narrative basket) row. Opaque diagnostics
        (flip distance, duplicate percentiles, full engine prose) stay on the detail page. -#}
    {%- macro ab_theme_pop(x) -%}
    {%- set _reco = x.get('reco', '') -%}
    {%- set _rtone = 'dn' if _reco in ('trim','avoid') else ('up' if _reco in ('accumulate','enter') else 'warn') -%}
    {%- set _score = x.get('score') if x.get('score') is not none and x.get('score') is defined else 0 -%}
    <div class="rp-src row-pop-decision" hidden>
      <div class="row-pop-decision-hd">
        <span class="row-pop-mark row-pop-mark--theme" aria-hidden="true">◆</span>
        <span class="row-pop-heading">
          <span class="row-pop-eyebrow"><span class="l-en">Theme basket</span><span class="l-zh">主题篮子</span></span>
          <span class="row-pop-name"><span class="l-en">{{ x.name|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
        </span>
        <span class="row-pop-tag {{ _rtone }}"><span class="l-en">{{ x.get('label') or _reco }}</span><span class="l-zh">{{ x.get('label_zh') or x.get('label') or _reco }}</span></span>
      </div>

      <div class="row-pop-theme-hero">
        <span class="row-pop-score-ring {{ 'up' if _score >= 60 else ('warn' if _score >= 40 else 'dn') }}" style="--score:{{ '%.0f'|format(_score) }}">
          <strong>{% if x.get('score') is not none and x.get('score') is defined %}{{ '%.0f'|format(x.score) }}{% else %}—{% endif %}</strong>
          <small><span class="l-en">score</span><span class="l-zh">评分</span></small>
        </span>
        <span class="row-pop-summary-copy">
          <span class="row-pop-kicker"><span class="l-en">Leadership read</span><span class="l-zh">领先度判断</span></span>
          <strong>
            {%- if _reco in ('accumulate','enter') -%}<span class="l-en">Broad and leading</span><span class="l-zh">广泛领先</span>
            {%- elif _reco == 'trim' -%}<span class="l-en">Late and extended</span><span class="l-zh">后期且延伸</span>
            {%- elif _reco == 'avoid' -%}<span class="l-en">Breadth weakening</span><span class="l-zh">广度转弱</span>
            {%- else -%}<span class="l-en">Trend intact</span><span class="l-zh">趋势完好</span>{%- endif -%}
          </strong>
          <span class="row-pop-trust">
            {%- if x.get('book_wt') is not none and x.get('book_wt') is defined %}<span class="up">★ <span class="l-en">Model {{ '%.0f'|format(x.book_wt*100) }}%</span><span class="l-zh">模型 {{ '%.0f'|format(x.book_wt*100) }}%</span></span>{% endif -%}
            {%- if x.validated %}<span class="up">✓ <span class="l-en">Risk gate</span><span class="l-zh">风险门槛</span></span>{% endif -%}
          </span>
        </span>
      </div>

      {%- if (x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined) or (x.get('breadth_pct50') is not none and x.get('breadth_pct50') is defined) or (x.get('rollover_band') is not none and x.get('rollover_band') is defined) %}
      <div class="row-pop-stats">
        {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined %}
        <span class="row-pop-stat">
          <span class="row-pop-lbl"><span class="l-en">20d lead</span><span class="l-zh">20日领先</span></span>
          <strong class="{{ 'up' if x.perf_20d_rel >= 0 else 'dn' }}">{{ '%+.1f'|format(x.perf_20d_rel * 100) }}%</strong>
          <small><span class="l-en">vs market</span><span class="l-zh">相对市场</span></small>
        </span>
        {%- endif %}
        {%- if x.get('breadth_pct50') is not none and x.get('breadth_pct50') is defined %}
        <span class="row-pop-stat">
          <span class="row-pop-lbl"><span class="l-en">Breadth</span><span class="l-zh">广度</span></span>
          <strong>{{ '%.0f'|format(x.breadth_pct50 * 100) }}%</strong>
          <small><span class="l-en">above 50d</span><span class="l-zh">高于50日线</span></small>
        </span>
        {%- endif %}
        {%- if x.get('rollover_band') is not none and x.get('rollover_band') is defined %}
        <span class="row-pop-stat">
          <span class="row-pop-lbl"><span class="l-en">Rollover</span><span class="l-zh">回落风险</span></span>
          <strong class="{{ 'up' if x.rollover_band == 'low' else 'warn' }}"><span class="l-en">{{ x.rollover_band|title }}</span><span class="l-zh">{{ x.get('rollover_band_zh', x.rollover_band) }}</span></strong>
          <small><span class="l-en">risk</span><span class="l-zh">风险</span></small>
        </span>
        {%- endif %}
      </div>
      {%- endif %}

      {%- if x.get('top_members') %}
      <div class="row-pop-leaders">
        <span><span class="l-en">Leaders</span><span class="l-zh">龙头</span></span>
        <strong>{{ x.top_members[:3] | join(' · ') }}</strong>
      </div>
      {%- endif %}

      <div class="row-pop-takeaway {{ _rtone }}">
        <span aria-hidden="true">→</span>
        <span>
          <b><span class="l-en">What matters</span><span class="l-zh">要点</span></b>
          <span>
            {%- if x.get('conflict_reason_en') -%}<span class="l-en">Signals disagree. Wait for breadth and price to align.</span><span class="l-zh">信号不一致，等待广度与价格同步。</span>
            {%- elif _reco in ('accumulate','enter') -%}<span class="l-en">Leadership is broad. Add on pullbacks, not into strength.</span><span class="l-zh">领先面广。回调时加仓，不要追强势。</span>
            {%- elif _reco == 'trim' -%}<span class="l-en">Momentum is extended. Protect gains into strength.</span><span class="l-zh">动能已过度延伸。逢强保护利润。</span>
            {%- elif _reco == 'avoid' -%}<span class="l-en">Breadth is fading. Stand aside until it turns again.</span><span class="l-zh">广度转弱。在重新转强之前先观望。</span>
            {%- else -%}<span class="l-en">Trend is intact. Wait for a cleaner entry.</span><span class="l-zh">趋势完好。等待更干净的入场点。</span>{%- endif -%}
          </span>
        </span>
      </div>
      <div class="row-pop-decision-ft">
        <span><span class="l-en">Click row for holdings and full history</span><span class="l-zh">点击查看持仓与完整历史</span></span>
        <b><span class="l-en">Open ↗</span><span class="l-zh">打开 ↗</span></b>
      </div>
    </div>
    {%- endmacro -%}
    {#- V2 sector row macro — anv2-row anatomy (name row / chips row / stat line) -#}
    {%- macro ab_sector_row(x) -%}
    <a class="actitem" data-rpop href="{{ x.href }}">
      <span class="act-row-top">
        <span class="ai-bdg">🏛</span>
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ tr(x.name)|e }}</span></span>
      </span>
      {%- if x.get('chip_en') or x.get('gate_override') or x.get('ew_two_reads') or x.get('conflict_chip_en') %}
      <span class="act-row-chips">
        {{- ab_chip(x.get('chip_en',''), x.get('chip_zh',''), x.get('chip_tone','muted')) -}}
        {{- ab_gate(x) -}}
        {{- ab_ew_two_reads(x) -}}
        {#- W2b/W4 demotion receipt lifted from the EW overlay (MLC-R7) -#}
        {{- ab_chip(x.get('conflict_chip_en',''), x.get('conflict_chip_zh', x.get('conflict_chip_en','')), 'warn') -}}
      </span>
      {%- endif %}
      {%- if x.get('stat_en') %}<span class="act-row-stat"><span class="l-en">{{ x.stat_en }}</span><span class="l-zh">{{ x.get('stat_zh', x.stat_en) }}</span></span>{%- endif %}
      {{ ab_sector_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- V2 theme (narrative basket) row macro — composite score rides the name row;
        provenance glyphs (★ book / ✓ gate / ≈ lens / ⟳ run-reason) sit inline after
        the name instead of an orphan chips line; china-style 20d-vs-market stat. -#}
    {%- macro ab_theme_row(x) -%}
    <a class="actitem ai-theme" data-rpop href="{{ x.href }}">
      <span class="act-row-top">
        <span class="ai-bdg">🧩</span>
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
        {%- if x.get('book_wt') %}<span class="ai-book" data-tip-en="In the narrative-rotation model book at {{ '%.0f'|format(x.book_wt*100) }}% — clears the backtested absolute-trend gate" data-tip-zh="已在叙事轮动模型组合中，权重 {{ '%.0f'|format(x.book_wt*100) }}%，通过经回测的绝对趋势门槛">&#9733;{{ '%.0f'|format(x.book_wt*100) }}%</span>{%- endif %}
        {%- if x.validated %}<span class="ai-val" data-tip-en="Backtested risk side — absolute-trend / fading-deteriorating drawdown gate" data-tip-zh="经回测的风险侧 — 绝对趋势／衰退-恶化回撤门槛">&#10003;</span>{%- else %}<span class="ai-lens" data-tip-en="Leadership LENS — descriptive; cross-sectional momentum rank-IC &asymp;0" data-tip-zh="领先度透镜 — 描述性；横截面动量 rank-IC&asymp;0">&asymp;</span>{%- endif %}
        {%- if x.get('run_reason_en') %}<span class="ai-lens" data-tip-en="{{ x.run_reason_en }}" data-tip-zh="{{ x.get('run_reason_zh', x.run_reason_en) }}">&#8635;</span>{%- endif %}
        {%- if x.get('score') is not none and x.get('score') is defined %}{%- set _sc = x.score -%}
        <span class="act-row-score{% if _sc >= 60 %} act-score-hi{% elif _sc >= 40 %} act-score-mid{% else %} act-score-lo{% endif %}">{{ '%.0f'|format(_sc) }}</span>
        {%- endif %}
      </span>
      {#- FIX 1: conflict chip (warn tone) when theme was demoted from buy lanes -#}
      {%- if x.get('conflict_chip_en') %}
      <span class="act-row-chips">
        {{- ab_chip(x.conflict_chip_en, x.get('conflict_chip_zh', x.conflict_chip_en), 'warn') -}}
      </span>
      {%- endif %}
      {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined %}
      <span class="act-row-stat"><span class="{{ 'up' if x.perf_20d_rel >= 0 else 'dn' }}">{{ '%+.1f'|format(x.perf_20d_rel * 100) }}%</span> <span class="l-en">20d vs market</span><span class="l-zh">20日对比市场</span></span>
      {%- endif %}
      {{ ab_theme_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- Lane count helpers -#}
    {%- set _bn_cnt = action_board.buy_now | length -%}
    {%- set _bs_cnt = action_board.buy_soon | length -%}
    {%- set _run_cnt = action_board.get('on_the_run', []) | length -%}
    {%- set _tp_cnt = action_board.take_profits | length -%}
    {%- set _hold_cnt = (action_board.hold | length) + (action_board.avoid | length) -%}
    {#- FIX 3: more-count helpers from basket_items; default 0 when absent -#}
    {%- set _ab_more = action_board.get('more') or {} -%}
    {%- set _more_bn = _ab_more.get('buy_now') or 0 -%}
    {%- set _more_bs = _ab_more.get('buy_soon') or 0 -%}
    {%- set _more_run = _ab_more.get('on_the_run') or 0 -%}
    {%- set _more_tp = _ab_more.get('take_profits') or 0 -%}
    {%- set _more_hold = (_ab_more.get('hold') or 0) + (_ab_more.get('avoid') or 0) -%}
    <div class="actiongrid">
      {#- ---- LANE 1: BUY NOW ---- -#}
      <div class="actcol act-buy">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🟢</span>
            <span class="acth-name"><span class="l-en">Buy now</span><span class="l-zh">立即买入</span></span>
            <span class="acth-count">{{ _bn_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Entry confirmed today</span><span class="l-zh">今日已确认入场</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-buy-fold">
          {% for x in action_board.buy_now %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
          {%- if _more_bn > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_bn }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_bn }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _bn_cnt > 3 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bn_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 2: ALMOST READY (buy_soon) ---- -#}
      <div class="actcol act-soon">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🔵</span>
            <span class="acth-name"><span class="l-en">Almost ready</span><span class="l-zh">接近就绪</span></span>
            <span class="acth-count">{{ _bs_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Setting up — wait for the trigger, not a buy yet</span><span class="l-zh">构筑中 — 等待触发，尚不可买</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-soon-fold">
          {% for x in action_board.buy_soon %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('No imminent setups.', '暂无临近的构筑。') }}</p>{% endfor %}
          {%- if _more_bs > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_bs }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_bs }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _bs_cnt > 3 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bs_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 3: IN FAVOUR — DON'T CHASE (on_the_run) ---- -#}
      <div class="actcol act-run">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🏃</span>
            <span class="acth-name"><span class="l-en">In favour — don't chase</span><span class="l-zh">看好 — 勿追高</span></span>
            <span class="acth-count">{{ _run_cnt }}</span>
