            {% endif %}
          </div>{# end .nb-dossier #}
          {% endif %}{# end if _dos #}
          {# W4 stock-personality slim chips — expander only (guardrail 16; no at-rest surface).
             Fail-open: n.get('personality') returns None when data absent. #}
          {# Display-name maps — ≤3 words EN per spec; no translated text in data- attributes #}
          {% set _SP_CHART_EN = {
