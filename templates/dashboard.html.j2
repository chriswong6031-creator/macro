              <span class="ms-date" id="ms-date" style="display:none">{{ MS.asof }}</span>
            </div>
          </div>
          <div class="mx2-prog-wrap">
            <div class="mx2-prog-track">
              <div class="mx2-prog-fill" style="width:{{ MS.score }}%"></div>
              <span class="tick" id="ms-tick" style="left:{{ MS.score }}%"></span>
            </div>
            <div class="mx2-prog-labels">
              {# VIS-10: consistent word-then-number order across all three axis labels #}
              <span class="l-en">Risk-off 0</span><span class="l-zh">避险 0</span>
              <span class="l-en">Mixed 50</span><span class="l-zh">混合 50</span>
              <span class="l-en">Risk-on 100</span><span class="l-zh">偏好 100</span>
            </div>
          </div>
          {# Bar caption (grid view only) — the tick marks TODAY'S score (ms-tick is
             positioned at MS.score); the v-flip line right below carries the flip
             condition. Never label the tick as a trigger — that would be false. #}
          <div class="mx4-bzone-flip-caption mx4-grid-only">
            <span class="l-en">tick = today's score</span>
            <span class="l-zh">标记 = 今日得分</span>
          </div>
        </div>

        {# Dominant driver context card + fired-alerts pill #}
        <div class="mx2-hero-ctx">
          <div>
            {% if MS.radar and MS.radar.state %}
            <strong class="l-en">{{ t(MS.radar.label_en, MS.radar.label_zh) }}:</strong>
            <span class="l-en"> {{ MS.radar.do_en }}</span>
            <strong class="l-zh">{{ t(MS.radar.label_en, MS.radar.label_zh) }}:</strong>
            <span class="l-zh"> {{ MS.radar.do_zh }}</span>
            {% else %}
            {# _ts_en/_ts_zh set in the hero-sub above — plain words, never the raw enum #}
            <strong class="l-en">Regime:</strong> <span class="l-en">{{ td(latest.quad_name) }} · {{ _ts_en }}</span>
            <strong class="l-zh">周期：</strong><span class="l-zh">{{ td(latest.quad_name) }} · {{ _ts_zh }}</span>
            {% endif %}
          </div>
          {# Leadership-context chip — display-only; hidden when sector_bias is absent.
             Data path: MS.radar.cycle.sector_bias (favor/avoid lists, each has .en + .zh).
             Rendered as a muted context line, NOT an alert color — this is context, not a call. #}
          {% if MS.radar and MS.radar.cycle and MS.radar.cycle.sector_bias %}
          {% set _sb = MS.radar.cycle.sector_bias %}
          {% set _sb_favor_en = _sb.favor | map(attribute='en') | join(' / ') if _sb.favor else '' %}
          {% set _sb_avoid_en = _sb.avoid | map(attribute='en') | join(' / ') if _sb.avoid else '' %}
          {% set _sb_favor_zh = _sb.favor | map(attribute='zh') | join('／') if _sb.favor else '' %}
          {% set _sb_avoid_zh = _sb.avoid | map(attribute='zh') | join('／') if _sb.avoid else '' %}
          <div class="mx2-leadership-ctx">
            <span class="l-en">Under the surface: <strong>{{ _sb_favor_en }}</strong> have held while <strong>{{ _sb_avoid_en }}</strong> faded — a rotation read, not a high-beta cue.</span>
            <span class="l-zh">表面之下：<strong>{{ _sb_favor_zh }}</strong>相对坚挺，<strong>{{ _sb_avoid_zh }}</strong>走弱 — 这是轮动观察，并非追高贝塔的信号。</span>
          </div>
          {% endif %}
          {# Fired-alerts pill — preserved structure for risk_state_live.js #}
          <div class="mx2-alerts-row">
            <div class="ms-alerts-wrap">
              <label class="ms-alerts" for="ms-alerts-toggle" tabindex="0" aria-haspopup="dialog" aria-controls="ms-alerts-pop">
                {% if _nalerts %}<span class="dot"></span>{% endif %}{{ t('Fired alerts','已触发警报') }}
                <span class="ct{{ ' is-zero' if not _nalerts }}">{{ _nalerts }}</span>
              </label>
              <div class="ms-alerts-pop" id="ms-alerts-pop" role="dialog" aria-label="Fired alerts · 已触发警报">
                <div class="ms-pop-head">
                  <div>
                    <div class="ms-pop-title">⚠ {{ t('Fired alerts','已触发警报') }}</div>
                    <div class="ms-pop-sub">{{ t('Alerts are rare by design — they fire only on a change: a level escalating, a crossing, a sign flip. Read every one.','警报刻意稀少 — 仅在发生变化时触发：级别升级、出现交叉、符号翻转。每条都要读。') }}</div>
                  </div>
                </div>
                <div class="ms-pop-body">
                  {# STRESS SELLOFF FILTER — the announcement, in plain words. The
                     readout itself moved to macro_signals.html on 2026-07-30, so this
                     links out cross-page ("View →", no data-ms-jump: that attribute is
                     the in-page scroll handler at the bottom of this file and would
                     swallow the navigation). Copy is the calibrated verdict, translated
                     off the glance tier's banned vocabulary — no "Gate-1", no
                     "dislocation", no "Fed put", no trigger count. Claims unchanged. #}
                  {% if latest.dislocation and latest.dislocation.dislocation_active %}
                  {% set _dl_a = latest.dislocation %}
                  {% set _dl_a_unknown = ((_dl_a.put_state is defined and _dl_a.put_state == 'unknown')
                                          or (_dl_a.put_state_reliable is defined and not _dl_a.put_state_reliable)
                                          or (_dl_a.fed_put is defined and _dl_a.fed_put is none)) %}
                  {# Dissent survives the move off-page in plain words (see the twin
                     comment on the "What To Do Now" row). #}
                  {% set _dl_a_dissent = ((_dl_a.geo_reversibility and _dl_a.geo_reversibility.agreement != 'corroborates')
                                          or (_dl_a.catalyst_narrative and _dl_a.catalyst_narrative.agreement != 'corroborates')) %}
                  <a class="ms-sig sev-act" href="macro_signals.html#dislocation">
                    <div class="ms-sig-head"><span class="ms-sig-ico">🚦</span><span class="ms-sig-title">{{ t('Selling has turned stressed','抛售已转为压力状态') }}</span><span class="ms-sig-jump">{{ t('View →','查看 →') }}</span></div>
                    <div class="ms-sig-detail">{% if _dl_a_unknown %}{{ t('We cannot read whether the Fed would step in today, so no call is made. Watch — don’t chase.','今日无法判读美联储是否会出手，因此不作判定。观察 — 不要追。') }}{% elif _dl_a.verdict == 'buyable_washout' %}{{ t('The Fed’s backstop still reads intact, so damage like this has usually stayed shallower. Wait for the market to steady — don’t try to catch it.','美联储托底仍在位，此类下跌历史上通常跌幅更浅。等待市场企稳 — 不要接飞刀。') }}{% elif _dl_a.verdict == 'stand_aside' %}{{ t('The Fed’s backstop is not there. This is the setup that kept falling through 2008 — stand aside.','美联储托底缺失。这正是 2008 年一路下跌的情形 — 观望。') }}{% else %}{{ t('Nothing to do until it steadies. Watch — don’t chase.','企稳前无需行动。观察 — 不要追。') }}{% endif %}{% if _dl_a_dissent %} {{ t('Not everything agrees — the reasons are on the signal board.','并非所有指标一致 — 详见信号看板。') }}{% endif %}</div>
                  </a>
                  {% endif %}
                  {# C-01 + v5: `anchor` is either an id on THIS page (plain id → in-page
                     jump; dlg-* → the owning mx5 dialog, opened via JS) or an id on
                     another page (cross-page link). Mirrors engine/alerts.ANCHOR_PAGE /
                     alert_href — a jump on macro must never target a dead anchor. #}
                  {% set _a_xpage = {'holdings':'us_stocks.html','accumulation':'us_stocks.html','flows':'us_stocks.html','board':'macro_context.html'} %}
                  {% if alerts %}{% for a in alerts %}
                  {% set _a_href = (_a_xpage[a.anchor] + '#' + a.anchor) if (a.anchor in _a_xpage and mode != 'stocks') else ('#' + a.anchor if a.anchor else '') %}
                  {% set _a_dlg = a.anchor if (a.anchor and a.anchor.startswith('dlg-')) else '' %}
                  <a class="ms-sig sev-{{ a.severity }}"{% if _a_href %}{% if _a_dlg %} data-ms-dlg="{{ _a_dlg }}"{% elif _a_href.startswith('#') %} data-ms-jump{% endif %} href="{{ _a_href }}"{% endif %}>
                    <div class="ms-sig-head"><span class="ms-sig-ico">{{ a.icon }}</span><span class="ms-sig-title"><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></span>{% if _a_href %}<span class="ms-sig-jump">{% if _a_href.startswith('#') and not _a_dlg %}{{ t('View ↓','查看 ↓') }}{% else %}{{ t('View →','查看 →') }}{% endif %}</span>{% endif %}</div>
                    <div class="ms-sig-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
                    {% if a.what_en %}<div class="ms-sig-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh }}</span></div>{% endif %}
                    {% if a.edge_en %}<div class="ms-sig-edge"><b>{{ t('Conviction:','可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
                  </a>
                  {% endfor %}{% elif not (latest.dislocation and latest.dislocation.dislocation_active) %}
                  <div class="ms-pop-empty"><span class="big">✓</span>{{ t('No alerts fired today. Alerts are rare by design — they fire only on a change.','今日无警报触发。警报刻意稀少 — 仅在发生变化时触发。') }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            {% if macro_catalysts and macro_catalysts|length > 0 %}
            {% set _nextev = macro_catalysts[0] %}
            {# COPY-04/VIS-08: use CSS ellipsis (never bake a hard-sliced string) so ZH/EN match cleanly.
               _nextev.label_zh if present, else fall back to EN label — CSS will clip both identically. #}
            {% set _nev_zh = _nextev.label_zh if (_nextev.label_zh is defined and _nextev.label_zh) else _nextev.label %}
            <span class="v2chip {{ 'c-warn' if _nextev.impact == 'high' else 'c-info' }}" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <span class="l-en" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;white-space:nowrap">{{ _nextev.label }} {{ _nextev.date[5:10] }}</span>
              <span class="l-zh" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;white-space:nowrap">{{ _nev_zh }} {{ _nextev.date[5:10] }}</span>
            </span>
            {% endif %}
          </div>
        </div>
      </div>{# /mx2-hero-row #}
      {{ regime_flip_strip(latest) }}
      </section>{# /ms-verdict — wraps thesis + score + tick for check_ms_board_coherence.py #}
    </div>{# /mx2-hero / ms-front #}

    {# ── MX5 COMMAND SCORECARD — grid view only; overlaid via CSS on #regime-radar ── #}
    {# mx2-hero is hidden in grid view (CSS body.page-macro.mx4-grid #regime-radar .mx2-hero{display:none}).
       This block provides the v5 visual scorecard visible in grid view only. #}
    {% if market_state %}
    {# ── Pre-compute gauge geometry (Jinja, no JS math) ── #}
    {# Arc: center=(70,75) radius=56; half-circle from (14,75) to (126,75).
       ARC_LEN = PI*56 = 175.93; filled = score/100 * ARC_LEN; gap = ARC_LEN - filled.
       Needle: -90deg (leftmost at score=0) + score/100 * 180 = final rotation from vertical. #}
    {% set _mx5_arc_len = 175.93 %}
    {% set _mx5_score = MS.score | int %}
    {% set _mx5_filled = (_mx5_score / 100 * _mx5_arc_len) | round(1) %}
    {% set _mx5_gap = (_mx5_arc_len - _mx5_filled) | round(1) %}
    {% set _mx5_needle_deg = (_mx5_score / 100 * 180 - 90) | round(1) %}
    {# ── SCORE PROVENANCE: is the dial showing a measurement, or a constant? ────────
       Audit 2026-07-29: on every radar-capped session the number on this dial is the
       amplified CEILING CONSTANT, not a reading of the tape — across 21 logged sessions
       the six-leg blend never printed below 61 while the displayed score never rose
       above 56. `raw_score` was always in the payload but nothing on the page said
       WHICH of the two the needle was pointing at, so a constant read as a measurement.
       The engine now publishes score_source / capped / score_ceiling / score_gap; older
       payloads carry raw_score + radar.ceiling, which is enough to show the same thing,
       so this lights up either way. Nothing here changes a cap, a band or a verdict. #}
    {% set _mx5_raw = MS.raw_score if (MS.raw_score is defined and MS.raw_score is not none and MS.raw_score is number) else none %}
    {% set _mx5_ceil = MS.score_ceiling if (MS.score_ceiling is defined and MS.score_ceiling is not none)
                       else ((MS.radar.ceiling if (MS.radar and MS.radar.ceiling is defined and MS.radar.ceiling is not none) else none)) %}
    {% set _mx5_src = MS.score_source if (MS.score_source is defined and MS.score_source) else none %}
    {# Disclose a binding cap on demand beside the verdict. The mechanics belong
       behind the existing help affordance, not in the dashboard's glance layer. #}
    {% set _mx5_ghost = _mx5_raw is not none and _mx5_raw != _mx5_score %}
    {# what is actually holding the dial down. score_source names it outright; on an
       older payload the radar ceiling is identifiable because it equals the shown score. #}
    {% set _mx5_capw = {'radar_ceiling': ['the Risk Radar’s cap', '风险雷达的上限'],
                        'hard_force': ['an override that forces the Risk-off band', '强制进入「避险」区间的覆盖规则'],
                        'verdict_cap': ['an override that caps the Mixed band', '封顶于「混合」区间的覆盖规则']}.get(_mx5_src)
                       or ((['the Risk Radar’s cap', '风险雷达的上限']
                            if (_mx5_ceil is not none and _mx5_ceil == _mx5_score)
                            else ['an override on the market-state call', '市场状态判定上的覆盖规则']) if _mx5_ghost else none) %}
    {# Score color variable class #}
    {% set _mx5_sc_cls = 'mx5-score-green' if MS.color == 'green' else ('mx5-score-yellow' if MS.color == 'yellow' else 'mx5-score-red') %}
    {# state colour as a TOKEN so it flips in zh (红涨绿跌); var() only resolves in
       style="", NOT in bare SVG presentation attributes — every consumer below must
       paint via style (or be covered by a CSS rule), never via stroke=/fill= attrs. #}
    {% set _mx5_sc_col = 'var(--up)' if MS.color == 'green' else ('var(--warn)' if MS.color == 'yellow' else 'var(--down)') %}
    {% set _mx5_sc_glow = 'color-mix(in srgb,var(--up) 70%,transparent)' if MS.color == 'green' else ('color-mix(in srgb,var(--warn) 70%,transparent)' if MS.color == 'yellow' else 'color-mix(in srgb,var(--down) 70%,transparent)') %}
    {# Regime pill: quad_name + transition_state.
       Design-doctrine glance ruling (2026-07-16): "Goldilocks · Shifting" read as
       all-clear at a glance; the not-clear states carry their honest stance inline. #}
    {% set _mx5_ts = latest.transition_state if (latest.transition_state is defined and latest.transition_state) else '' %}
    {% set _mx5_ts_en = {'TRANSITIONING':'Shifting — not all-clear','STABLE':'Stable','WEAKENING':'Weakening — not all-clear','NEW_REGIME':'New Regime'}.get(_mx5_ts, _mx5_ts | title) %}
    {% set _mx5_ts_zh = {'TRANSITIONING':'转换中 — 非全面利好','STABLE':'稳定','WEAKENING':'走弱 — 非全面利好','NEW_REGIME':'新周期'}.get(_mx5_ts, tr(_mx5_ts)) %}
    {# Risk button: warn style whenever the radar is NOT quiet (engine states include
       'watch' — the current bubble/blow-off state — which IS "there is risk" per the
       operator ruling) or the top scare scores >=50 #}
    {% set _mx5_rdr = market_state.radar if market_state.radar is defined else {} %}
    {% set _mx5_rdr_state = _mx5_rdr.state if _mx5_rdr else 'unknown' %}
    {# Dominant-risk score: engine field is top_score (not .top) #}
    {% set _mx5_radar_top = (_mx5_rdr.get('top_score') or _mx5_rdr.get('top') or 0) | int if _mx5_rdr else 0 %}
    {# 'calm' is the engine's quiet state (_STATE_ORDER: calm/watch/caution/elevated/risk-off) —
       it was missing from this exclusion list, so the button could never leave risk mode.
       Unknown/new states deliberately stay on the risk side (conservative). #}
    {% set _mx5_risk_elevated = (_mx5_rdr_state not in ('calm','quiet','dormant','none','unknown','')) or (_mx5_radar_top >= 50) %}
    {# This flag means "the radar is not calm" — it fires at 'watch' and at a bare
       top_score >= 50. It is NOT the engine's 'elevated' band, which starts at 78
       (_DEFAULT_BANDS in engine/risk_radar.py: watch 55 / caution 68 / elevated 78 /
       risk-off 88). The chip below hard-coded the word "Elevated", so a score of 61 —
       'watch' to the engine, two bands below elevated — shipped as "Elevated Risk · 61" next to a 69 risk-ON
       tape read, which is what made the pair look self-contradicting. The two scores
       ARE opposite-polarity and may legitimately diverge (tape composite: higher =
       more supportive; radar: higher = more drawdown risk); only the band NAME was
       wrong. Label from the engine's own state so the word always matches the number,
       and reuse "Risk building" — the sibling radar card's existing wording. #}
    {% set _MX5_RDR_LBL = {
         'watch':    ('Risk watch',    '风险观察'),
         'caution':  ('Risk building', '风险积聚'),
         'elevated': ('Elevated risk', '风险偏高'),
         'risk-off': ('Risk-off',      '避险')
       } %}
    {% set _mx5_risk_lbl = _MX5_RDR_LBL.get(_mx5_rdr_state, ('Risk building', '风险积聚')) %}
    {# Factor rows for factor popover #}
    {# MS (hero scope), NOT MS2 — MS2 is set later in the ledger section and is
       undefined here, which rendered "0 signals aligned" + an empty factor popover #}
    {% set _mx5_comps = MS.components if (MS and MS.components is defined and MS.components) else [] %}
    {% set _mx5_n_good = (_mx5_comps | selectattr('tone','equalto','good') | list | length) %}
    {# every leg that is NOT supportive — warn, bad, or an unrecognised tone. Counting
       the complement (never just 'warn') means a new tone can never disappear from the
       chip and turn dissent into an implied all-clear. #}
    {% set _mx5_n_warn = (_mx5_comps | length) - _mx5_n_good %}
    {# Weakest leg #}
    {% set _mx5_weakest = _mx5_comps | sort(attribute='score') | first if _mx5_comps else none %}
    {# 60-session path from ms_history VM key #}
    {% set _mx5_hist = ms_history if (ms_history is defined and ms_history and ms_history | length >= 2) else none %}
    {% set _mx5_hist_n = _mx5_hist | length if _mx5_hist else 0 %}

    <div class="mx5-sc-left">

      {# ── Gauge cluster ── #}
      <div class="mx5-flipctx-anchor">
      {# Regime pill on its own full-width row — beside the (taller) gauge it wrapped to
         three cramped lines; above the row it fits one line at glance width #}
      <div class="mx5-regime-pill{{ ' rp-yellow' if MS.color == 'yellow' else (' rp-red' if MS.color == 'red' else '') }}" tabindex="0">
        <div class="mx5-dot"></div>
        <span class="l-en">{{ td(latest.quad_name) if latest.quad_name is defined else 'Regime' }}{% if _mx5_ts_en %} &nbsp;&middot;&nbsp; {{ _mx5_ts_en }}{% endif %}</span>
        <span class="l-zh">{{ td(latest.quad_name) if latest.quad_name is defined else '周期' }}{% if _mx5_ts_zh %} &nbsp;&middot;&nbsp; {{ _mx5_ts_zh }}{% endif %}</span>
        <span class="mx5-pill-info">ⓘ</span>
      </div>
      <div class="mx5-sc-gauge-row {{ _mx5_sc_cls }}">
        {# Compact semicircle gauge; data-* attrs for risk_state_live.js patchMacro #}
        <svg class="mx5-gauge-svg" viewBox="0 -4 140 101" fill="none"
             aria-label="{{ MS.label_en }} — score {{ _mx5_score }}{% if _mx5_ghost %}; capped from six-signal blend {{ _mx5_raw }}{% endif %}"
             data-gauge-arc-len="{{ _mx5_arc_len }}"
             data-gauge-radius="56"
             data-gauge-cx="70" data-gauge-cy="75">
          <defs>
            <filter id="mx5NeedleGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="2.5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="mx5ArcGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          {# Track #}
          <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round" fill="none"/>
          {# Filled arc — dasharray baked by Jinja; JS patches via data-gauge-arc-len #}
          <path id="mx5-gauge-arc-fill"
                d="M 14 75 A 56 56 0 0 1 126 75" stroke="#f59e0b" stroke-width="10" stroke-linecap="round" fill="none"
                stroke-dasharray="{{ _mx5_filled }} {{ _mx5_gap }}" filter="url(#mx5ArcGlow)"/>
          {# Tick marks at 0/25/50/75/100 #}
          <g stroke="rgba(255,255,255,.22)" stroke-width="1.2">
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-90 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(0 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(90 70 75)"/>
          </g>
          {# Scale labels — repositioned for clearance: 0/100 directly under arc ends, 50 above arc peak #}
          <text x="14"  y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">0</text>
          <text x="70"  y="10" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">50</text>
          <text x="126" y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">100</text>
          {# Needle — rotation baked by Jinja; JS patches via data attr #}
          <g id="mx5-gauge-needle" transform="rotate({{ _mx5_needle_deg }} 70 75)" filter="url(#mx5NeedleGlow)">
            <line x1="70" y1="75" x2="70" y2="24" stroke="rgba(255,255,255,.30)" stroke-width="5" stroke-linecap="round"/>
            <polygon points="69,75 71,75 70.5,24 69.5,24" fill="white" opacity=".94"/>
            <circle cx="70" cy="75" r="7"  fill="rgba(255,255,255,.10)"/>
            <circle cx="70" cy="75" r="4.5" style="stroke:{{ _mx5_sc_col }}" stroke-width="1.5" fill="rgba(8,12,18,.8)"/>
            <circle cx="70" cy="75" r="2"  style="fill:{{ _mx5_sc_col }}"/>
            <circle cx="70" cy="25.5" r="2.5" style="fill:{{ _mx5_sc_col }};filter:drop-shadow(0 0 4px {{ _mx5_sc_col }})"/>
          </g>
          {# Score numeral inside arc — hidden in ledger view, visible in grid (parent hidden by CSS) #}
          <text id="mx5-score-numeral"
                x="70" y="62" font-size="24" font-weight="800"
                text-anchor="middle" font-family="Inter,-apple-system,sans-serif"
                style="fill:{{ _mx5_sc_col }};filter:drop-shadow(0 0 10px {{ _mx5_sc_glow }})">{{ _mx5_score }}</text>
          <text x="70" y="73" fill="rgba(255,255,255,.32)" font-size="11"
                text-anchor="middle" font-family="Inter,-apple-system,sans-serif">/ 100</text>
        </svg>

        {# Right of gauge: big score + verdict word (pill moved above the row) #}
        <div>
          <div class="mx5-score-line">
            <span class="mx5-big-score">{{ _mx5_score }}</span>
            <span class="mx5-verdict-word"><span class="l-en">{{ MS.label_en }}</span><span class="l-zh">{{ MS.label_zh or MS.label_en }}</span></span>
          </div>
          <div class="mx5-sub-line">
            <span class="l-en">{{ {'green':'GREEN','yellow':'YELLOW','red':'RED'}.get(MS.color,'—') }} &mdash; {{ {'green':'Trend-following supported','yellow':'Trade with caution','red':'Defend capital first'}.get(MS.color,'') }}</span>
            <span class="l-zh">{{ {'green':'偏多 — 顺势而为受支撑','yellow':'谨慎操作','red':'优先保住本金'}.get(MS.color,'') }}</span>
            {% if _mx5_ghost and _mx5_capw %}
            {{ help('The dial is capped at ' ~ _mx5_score ~ '; the six-signal blend is ' ~ _mx5_raw ~ '. The cap can only pull the dial down, never up.',
                    '刻度盘上限为 ' ~ _mx5_score ~ '；六项信号合成为 ' ~ _mx5_raw ~ '。上限只能压低刻度盘，不会抬高。') }}
            {% endif %}
          </div>
        </div>
      </div>{# /mx5-sc-gauge-row #}

      {# Flip-context hover panel — grid view; overlays content below without pushing layout.
         The .mx5-flipctx-anchor relative wrapper is load-bearing: without it the abspos pop
         resolves its static position to the flex column's top and covers the score it
         annotates (flexbox abspos-child rule). #}
      {# Desktop: revealed on gauge-row hover/focus via CSS sibling selector.
         Mobile (≤700px): static block toggled by JS tap on gauge row.
         The ledger-view call at ~line 5076 is the sole other call site and stays untouched. #}
      <div class="mx5-flipctx-pop" id="mx5FlipCtxPop" role="group" aria-label="What could change the regime call">
        {# Row 1: eyebrow + "context, not a forecast" chip #}
        <div class="mxqm-eyebrow-row">
          <span class="eyebrow"><span class="l-en">REGIME CONTEXT</span><span class="l-zh">周期背景</span></span>
          <span class="mxqm-eyebrow-chip">{{ t('Context — not a forecast','情景参考 — 非预测') }}</span>
        </div>
        {# ── Task 5: quad-map illustration (grid-view only) ── #}
        {# Resolve quad_vector data once; guard all downstream on _qvi available #}
        {% set _qvi = latest.get('quad_vector') if latest.get('quad_vector') is mapping else {} %}
        {% set _qvi_deg = _qvi.get('degraded', true) %}
        {% set _qvi_tm = (_qvi.get('transition_momentum') or {}) if not _qvi_deg else {} %}
        {% set _qvi_p = _qvi.get('p') or {} %}
        {# _fs_quad map: same as regime_flip_strip — Q1=Goldilocks(strong growth/low infl),
           Q2=Reflation(strong growth/high infl), Q3=Stagflation(weak/high),
           Q4=Growth-scare(weak/low). Grid: growth→right, inflation→up. #}
        {% set _qm_quad = {'Q1':['Goldilocks','理想增长'],'Q2':['Reflation','再通胀'],'Q3':['Stagflation','滞胀'],'Q4':['Growth-scare','增长恐慌']} %}
        {# Current quad hard label and gaining quad #}
        {% set _qm_hard = latest.get('quad') %}
        {% set _qm_gain = _qvi_tm.get('gaining') %}
        {# Glance line — bilingual: "drifting toward X" or stable #}
        {% if _qm_hard %}
        {% set _qm_hard_names = _qm_quad.get(_qm_hard, [_qm_hard, _qm_hard]) %}
        {% set _qm_hard_en = _qm_hard_names[0] %}
        {% set _qm_hard_zh = _qm_hard_names[1] %}
        <div class="mxqm-glance">
          {% if _qvi_deg or not _qm_gain %}
          {# Degraded or no momentum data — stable read #}
          <span class="l-en"><b>{{ _qm_hard_en }}</b> now, and the read is stable.</span>
          <span class="l-zh">当前为<b>{{ _qm_hard_zh }}</b>，读数稳定。</span>
          {% else %}
          {% set _qm_gain_names = _qm_quad.get(_qm_gain, [_qm_gain, _qm_gain]) %}
          {# "today's odds" is load-bearing wording: the historical base rate below
             answers a DIFFERENT question and points somewhere else, and without the
             two being named apart they read as one self-contradicting claim. #}
          {% if _qm_gain == _qm_hard %}
          <span class="l-en"><b>{{ _qm_hard_en }}</b> now, and today’s odds are firming behind it.</span>
          <span class="l-zh">当前为<b>{{ _qm_hard_zh }}</b>，今日概率正在向其巩固。</span>
          {% else %}
          <span class="l-en"><b>{{ _qm_hard_en }}</b> now, with today’s odds drifting toward <b>{{ _qm_gain_names[0] }}</b>.</span>
          <span class="l-zh">当前为<b>{{ _qm_hard_zh }}</b>，今日概率正向<b>{{ _qm_gain_names[1] }}</b>漂移。</span>
          {% endif %}
          {% endif %}
        </div>
        {# 2×2 quad map SVG — 150×150, growth=X(right=strong), inflation=Y(up=high) #}
        {# Quadrant positions (SVG coords, origin top-left):
           Q2 Reflation   = top-right   (x:75–145, y:5–75)
           Q3 Stagflation = top-left    (x:5–75,   y:5–75)
           Q1 Goldilocks  = bottom-right(x:75–145, y:75–145)
           Q4 Growth-scare= bottom-left (x:5–75,   y:75–145)
           Axes: vertical divider x=75, horizontal divider y=75
           Axis labels: growth→ (bottom), inflation↑ (left rotated)
           growth_score range ≈ -1..+1; inflation_score same
           Map: score 0 → center axis (75), +1 → right/top edge, -1 → left/bottom edge
        #}
        {% set _gs = latest.get('growth_score') %}
        {% set _is = latest.get('inflation_score') %}
        {# dot position — clamp to [10,140] range inside the 150px box #}
        {% if _gs is not none and _gs is number %}
        {% set _dot_x = ([10, [140, (75 + (_gs | float) * 65) | round | int] | min] | max) %}
        {% else %}
        {% set _dot_x = 75 %}
        {% endif %}
        {% if _is is not none and _is is number %}
        {# inflation high = top = small y; so y = 75 - score*65 #}
        {% set _dot_y = ([10, [140, (75 - (_is | float) * 65) | round | int] | min] | max) %}
        {% else %}
        {% set _dot_y = 75 %}
        {% endif %}
        {# Arrow target: center of gaining quadrant #}
        {% if _qm_gain and not _qvi_deg %}
        {% set _qm_centers = {'Q1':[112,112],'Q2':[112,38],'Q3':[38,38],'Q4':[38,112]} %}
        {% set _qm_tc = _qm_centers.get(_qm_gain, [75,75]) %}
        {% set _arr_tx = _qm_tc[0] %}
        {% set _arr_ty = _qm_tc[1] %}
        {# Shorten arrow by 10px from target to keep arrowhead clear of quad center #}
        {% set _arr_dx = _arr_tx - _dot_x %}
        {% set _arr_dy = _arr_ty - _dot_y %}
        {% set _arr_len = ((_arr_dx * _arr_dx + _arr_dy * _arr_dy) ** 0.5) %}
        {% if _arr_len > 0 %}
        {% set _arr_scale = [0, (_arr_len - 10) / _arr_len] | max %}
        {% set _arr_ex = (_dot_x + _arr_dx * _arr_scale) | round | int %}
        {% set _arr_ey = (_dot_y + _arr_dy * _arr_scale) | round | int %}
        {% else %}
        {% set _arr_ex = _dot_x %}
        {% set _arr_ey = _dot_y %}
        {% endif %}
        {% set _show_arrow = (_arr_len > 8) %}
        {% else %}
        {% set _show_arrow = false %}
        {% endif %}
        {# Per-quad odds (percent) — printed INSIDE each tile; absent when degraded #}
        {% set _has_odds = (not _qvi_deg and _qvi_p) %}
        {% set _p_q1 = ((_qvi_p.get('Q1', 0) * 100) | round | int) if _has_odds else none %}
        {% set _p_q2 = ((_qvi_p.get('Q2', 0) * 100) | round | int) if _has_odds else none %}
        {% set _p_q3 = ((_qvi_p.get('Q3', 0) * 100) | round | int) if _has_odds else none %}
        {% set _p_q4 = ((_qvi_p.get('Q4', 0) * 100) | round | int) if _has_odds else none %}
        <div class="mxqm-wrap">
          <div class="mxqm-svg-box">
            {# Full-width hero quad map. viewBox keeps the 150-unit grid (5–145) so the
               dot/arrow math is unchanged; box padded for in-tile labels + axis marks.
               Odds live INSIDE each rounded tile (the separate odds list is retired). #}
            <svg viewBox="-6 -4 162 172" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Quad map — current regime position and odds" preserveAspectRatio="xMidYMid meet">
              <defs>
                <marker id="mxqmArrowHead" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
                  <polygon class="mxqm-arrowhead" points="0 0, 6 3, 0 6"/>
                </marker>
              </defs>
              {# Rounded quadrant tiles — inset 2.5px from the axis centre so each reads
                 as its own card; active quad brighter. #}
              {# Q3 Stagflation top-left #}
              <rect class="mxqm-q3-fill{% if _qm_hard == 'Q3' %} active{% endif %}" x="5" y="5" width="65" height="65" rx="8"/>
              {# Q2 Reflation top-right #}
              <rect class="mxqm-q2-fill{% if _qm_hard == 'Q2' %} active{% endif %}" x="80" y="5" width="65" height="65" rx="8"/>
              {# Q4 Growth-scare bottom-left #}
              <rect class="mxqm-q4-fill{% if _qm_hard == 'Q4' %} active{% endif %}" x="5" y="80" width="65" height="65" rx="8"/>
              {# Q1 Goldilocks bottom-right #}
              <rect class="mxqm-q1-fill{% if _qm_hard == 'Q1' %} active{% endif %}" x="80" y="80" width="65" height="65" rx="8"/>
              {# Quad labels (top of each tile) + odds numeral (centre) — bilingual via
                 l-en/l-zh (the toggle works on SVG <text>; NO t() inside <text>). #}
              {# Q3 Stagflation #}
              <text class="mxqm-quad-label l-en" x="37.5" y="24" text-anchor="middle">STAGFLATION</text>
              <text class="mxqm-quad-label l-zh" x="37.5" y="24" text-anchor="middle">滞胀</text>
              {% if _p_q3 is not none %}<text class="mxqm-odds{% if _qm_hard == 'Q3' %} active{% endif %}" x="37.5" y="52" text-anchor="middle">{{ _p_q3 }}%</text>{% endif %}
              {# Q2 Reflation #}
              <text class="mxqm-quad-label l-en" x="112.5" y="24" text-anchor="middle">REFLATION</text>
              <text class="mxqm-quad-label l-zh" x="112.5" y="24" text-anchor="middle">再通胀</text>
              {% if _p_q2 is not none %}<text class="mxqm-odds{% if _qm_hard == 'Q2' %} active{% endif %}" x="112.5" y="52" text-anchor="middle">{{ _p_q2 }}%</text>{% endif %}
              {# Q4 Growth-scare #}
              <text class="mxqm-quad-label l-en" x="37.5" y="99" text-anchor="middle">GROWTH-SCARE</text>
              <text class="mxqm-quad-label l-zh" x="37.5" y="99" text-anchor="middle">增长恐慌</text>
              {% if _p_q4 is not none %}<text class="mxqm-odds{% if _qm_hard == 'Q4' %} active{% endif %}" x="37.5" y="127" text-anchor="middle">{{ _p_q4 }}%</text>{% endif %}
              {# Q1 Goldilocks #}
              <text class="mxqm-quad-label l-en" x="112.5" y="99" text-anchor="middle">GOLDILOCKS</text>
              <text class="mxqm-quad-label l-zh" x="112.5" y="99" text-anchor="middle">理想增长</text>
              {% if _p_q1 is not none %}<text class="mxqm-odds{% if _qm_hard == 'Q1' %} active{% endif %}" x="112.5" y="127" text-anchor="middle">{{ _p_q1 }}%</text>{% endif %}
              {# Axis labels — bilingual; kept subtle at the edges #}
              <text class="mxqm-axis-label l-en" x="75" y="160" text-anchor="middle">growth →</text>
              <text class="mxqm-axis-label l-zh" x="75" y="160" text-anchor="middle">增长 →</text>
              <text class="mxqm-axis-label l-en" x="-2" y="75" dominant-baseline="middle" text-anchor="middle" transform="rotate(-90 -2 75)">infl ↑</text>
              <text class="mxqm-axis-label l-zh" x="-2" y="75" dominant-baseline="middle" text-anchor="middle" transform="rotate(-90 -2 75)">通胀 ↑</text>
              {# Drift arrow toward gaining quad (animated dash-draw) #}
              {% if _show_arrow %}
              <line class="mxqm-arrow" x1="{{ _dot_x }}" y1="{{ _dot_y }}" x2="{{ _arr_ex }}" y2="{{ _arr_ey }}"/>
              {% endif %}
              {# Current position — soft pulse ring behind a bright dot #}
              <circle class="mxqm-pulse" cx="{{ _dot_x }}" cy="{{ _dot_y }}" r="5"/>
              <circle class="mxqm-dot" cx="{{ _dot_x }}" cy="{{ _dot_y }}" r="4.5"/>
            </svg>
          </div>
        </div>
        {# ── TWO DIFFERENT "next quad" READINGS, named apart ────────────────────────
           quad_vector.transition_momentum (the glance line + the arrow above) is where
           TODAY's model odds are moving. playbook.next_quad / next_list is a HISTORICAL
           BASE RATE — which quad followed this one in the past — and it routinely points
           the other way. Unlabelled, side by side, they read as one contradictory claim,
           so each names the question it answers. Guarded: no playbook, no row. #}
        {% set _qm_nx = (pb.next_list if (pb is defined and pb and pb.next_list) else []) %}
        {% if _qm_nx %}
        <div class="mxqm-hist">
          <span class="l-en">After past {{ _qm_hard_en }}s: {% for _n in _qm_nx[:3] %}{{ _qm_quad.get(_n.code, [_n.name, _n.name])[0] }} <b>{{ _n.prob_pct }}</b>{% if not loop.last %}, {% endif %}{% endfor %}.</span>
          <span class="l-zh">历史上{{ _qm_hard_zh }}之后：{% for _n in _qm_nx[:3] %}{{ _qm_quad.get(_n.code, [_n.name, _n.name])[1] }} <b>{{ _n.prob_pct }}</b>{% if not loop.last %}、{% endif %}{% endfor %}。</span>
        </div>
        {% endif %}
        {% endif %}{# /_qm_hard #}
        {# ── Goldilocks trim (Fable ruling 2026-07-20): a hover popup must never scroll.
           The old "WHAT COULD CHANGE THE REGIME CALL" section (regime_flip_strip) + its
           Drift row are DELETED here (the lead line + animated quad-map arrow already
           carry drift twice). Weakest-support + grip COMPRESS into ONE quiet line, built
           from the same flip_condition / confidence fields, null-safe. The mechanics
           receipt (grip fraction, drift sessions) lives in one plain ? tip on this line.
           regime_flip_strip stays defined — still called by the ledger hero (~L6485). #}
        {%- set _gk_fc = latest.get('flip_condition') or {} %}
        {%- set _gk_qv = latest.get('quad_vector') or {} %}
        {%- set _gk_tm = (_gk_qv.get('transition_momentum') or {}) if not _gk_qv.get('degraded') else {} %}
        {%- set _gk_conf = latest.get('confidence') %}
        {#- weakest-support leg → plain name (compact mirror of regime_flip_strip's _fs_short) -#}
        {%- set _gk_short = {
          'copper_gold':['copper vs gold','铜对黄金'],'xly_xlp':['the shopper-confidence read','消费信心读数'],
          'us2y_direction':['the 2-year yield','2年期收益率'],'iwm_spy':['small caps','小盘股'],
          'cyclical_defensive':['cyclical vs defensive sectors','周期性板块'],'breadth_direction':['market breadth','市场广度'],
          'payrolls_trend':['payrolls','非农就业'],'indpro_trend':['industrial production','工业生产'],
          'breakeven_10y_direction':['10-yr inflation expectations','10年期通胀预期'],
          'breakeven_5y5y_direction':['long-run inflation expectations','长期通胀预期'],
          'energy_rs':['the energy sector','能源板块'],'oil_trend':['oil','原油'],
          'inflation_beta_basket':['the inflation-winners basket','通胀受益篮子'],
          'tips_nominal_momentum':['the TIPS spread','TIPS 利差'] } %}
        {#- the weakest-support clause is SUPPRESSED when the label's own axes no longer
            support it: there is no supporting component to name, and the glance rows
            popup above already says what the axes read (see raw_quad_of()).
            The engine returns component=None in that state; an older payload does not,
            so the same check runs here. -#}
        {%- set _gk_raw = raw_quad_of(latest) | trim %}
        {%- set _gk_unsup = (_gk_fc.get('label_unsupported') is sameas true)
                            or (latest.get('quad') and _gk_raw and _gk_raw != latest.get('quad')) %}
        {%- set _gk_comp = none if _gk_unsup else _gk_fc.get('component') %}
        {%- set _gk_cname = _gk_short.get(_gk_comp, [(_gk_comp | replace('_',' ')), (_gk_comp | replace('_',' '))]) if _gk_comp else none %}
        {#- grip word from confidence (matches regime_flip_strip mapping) -#}
        {%- set _gk_has_conf = (_gk_conf is not none and _gk_conf is number) %}
        {%- set _gk_grip_en = ('held loosely' if _gk_conf < 0.33 else ('held reasonably firm' if _gk_conf < 0.66 else 'held firmly')) if _gk_has_conf else none %}
        {%- set _gk_grip_zh = ('把握较松' if _gk_conf < 0.33 else ('把握尚可' if _gk_conf < 0.66 else '把握较稳')) if _gk_has_conf else none %}
        {#- build the ? receipt tip (plain, short) from grip fraction + drift session count -#}
        {%- set _gk_rc_bits_en = [] %}
        {%- set _gk_rc_bits_zh = [] %}
        {%- if _gk_has_conf %}{%- set _ = _gk_rc_bits_en.append('conviction ' ~ (_gk_conf | round(2)) ~ ' / 1') %}{%- set _ = _gk_rc_bits_zh.append('把握 ' ~ (_gk_conf | round(2)) ~ ' / 1') %}{%- endif %}
        {%- if _gk_fc.get('margin') is not none %}{%- set _ = _gk_rc_bits_en.append('cushion ' ~ (_gk_fc.margin | round(2))) %}{%- set _ = _gk_rc_bits_zh.append('缓冲 ' ~ (_gk_fc.margin | round(2))) %}{%- endif %}
        {%- if _gk_tm.get('window_sessions') %}{%- set _ = _gk_rc_bits_en.append('drift measured over ' ~ _gk_tm.window_sessions ~ ' sessions') %}{%- set _ = _gk_rc_bits_zh.append('漂移基于近 ' ~ _gk_tm.window_sessions ~ ' 个交易日') %}{%- endif %}
        {% if _gk_grip_en or _gk_cname %}
        <div class="mxqm-hold">
          <span class="mxqm-hold-txt">
            <span class="l-en">{% if _gk_grip_en %}{{ _gk_grip_en|capitalize }}{% endif %}{% if _gk_grip_en and _gk_cname %}. {% endif %}{% if _gk_cname %}Weakest leg: <b>{{ _gk_cname[0] }}</b>{% endif %}.</span>
            <span class="l-zh">{% if _gk_grip_zh %}{{ _gk_grip_zh }}{% endif %}{% if _gk_grip_zh and _gk_cname %}。{% endif %}{% if _gk_cname %}最弱一环：<b>{{ _gk_cname[1] }}</b>{% endif %}。</span>
          </span>
          {% if _gk_rc_bits_en %}{{ help(_gk_rc_bits_en|join(' · '), _gk_rc_bits_zh|join(' · ')) }}{% endif %}
        </div>
        {% endif %}
        {# Footer — one line, kept (Fable ruling). #}
        <div class="mxqm-foot"><span class="l-en">Describes the label, not the risk score.</span><span class="l-zh">描述的是周期标签，而非风险评分。</span></div>
      </div>
      </div>{# /mx5-flipctx-anchor #}

      {# Thesis line (from engine headline_en/zh) #}
      <div class="mx5-thesis">
        <span class="l-en">{{ MS.headline_en if MS.headline_en else (MS.label_en ~ ' — see evidence panel.') }}</span>
        <span class="l-zh">{{ MS.headline_zh if MS.headline_zh else (MS.label_zh or MS.label_en) }}</span>
      </div>

      {# Flip condition #}
      {% if MS.flip_en %}
      {# The span below IS the arrow. MS.flip_en arrives with its own leading
         "→ " from the builder, which rendered as "→ → Mixed if ...". Strip a
         leading arrow from the copy rather than dropping the span, so the row
         still reads correctly if the builder stops prefixing one. #}
      {% set _flip_en = (MS.flip_en | trim) %}
      {% set _flip_en = _flip_en[1:] | trim if _flip_en.startswith('→') else _flip_en %}
      {% set _flip_zh = (MS.flip_zh | trim) if MS.flip_zh else '' %}
      {% set _flip_zh = _flip_zh[1:] | trim if _flip_zh.startswith('→') else _flip_zh %}
      <div class="mx5-flip">
        <span class="mx5-flip-arrow">&#8594;</span>
        <span class="l-en">{{ _flip_en }}</span>
        {% if _flip_zh %}<span class="l-zh">{{ _flip_zh }}</span>{% endif %}
      </div>
      {% endif %}

      {# Popover trigger buttons #}
      <div class="mx5-btn-row">
        {# Button 1: factor signals aligned #}
        <button class="mx5-sc-btn" id="mx5BtnFactors"
                onclick="mx5TogglePop('mx5PopFactors','mx5BtnFactors')"
                aria-expanded="false" aria-controls="mx5PopFactors"
                type="button">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          {# "4 signals aligned" printed the supporters and hid the dissenters — with 6
             legs and 2 warning, the same button read as a 4-of-4 all-clear. Both counts
             now, and the denominator, so the reader can see what the 4 is out of. #}
          <span class="l-en">{{ _mx5_n_good }} of {{ _mx5_comps | length }} supportive{% if _mx5_n_warn > 0 %} &middot; {{ _mx5_n_warn }} warning{% endif %}</span>
          <span class="l-zh">{{ _mx5_comps | length }} 项中 {{ _mx5_n_good }} 项支持{% if _mx5_n_warn > 0 %} &middot; {{ _mx5_n_warn }} 项警示{% endif %}</span>
          <svg width="9" height="9" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 1l4 4 4-4"/></svg>
        </button>

        {# Button 2: risk — warn style when elevated, neutral otherwise.
           Opens the full risk dialog in ONE click (was a two-step
           button→"Dominant Risk Ladder" popover→"Full risk detail"→dialog). A
           risk warning shouldn't be gated behind an intermediate summary — this
           matches the China board's direct Pullback-Risk entry (china.html.j2).
           Deliberately more direct than the sibling Factors button, which keeps
           its popover (factor breakdown is not time-critical). #}
        {% if _mx5_risk_elevated %}
        <button class="mx5-sc-btn mx5-sc-btn-warn" id="mx5BtnRisk"
                onclick="mx5OpenDlg('dlg-risk')"
                aria-haspopup="dialog"
                type="button">
          <svg width="12" height="11" viewBox="0 0 24 21" fill="none">
            <path d="M12 2L1.5 20h21L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <line x1="12" y1="9" x2="12" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="17" r="1" fill="currentColor"/>
          </svg>
          <span class="l-en">{{ _mx5_risk_lbl[0] }}{% if _mx5_radar_top > 0 %} &middot; {{ _mx5_radar_top }}{% endif %}</span>
          <span class="l-zh">{{ _mx5_risk_lbl[1] }}{% if _mx5_radar_top > 0 %} &middot; {{ _mx5_radar_top }}{% endif %}</span>
        </button>
        {% else %}
        {# Fallback: risk not elevated, no ignition data — neutral Risk Detail #}
        <button class="mx5-sc-btn" id="mx5BtnRisk"
                onclick="mx5OpenDlg('dlg-risk')"
                aria-haspopup="dialog"
                type="button">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span class="l-en">Risk Detail</span>
          <span class="l-zh">风险详情</span>
        </button>
        {% endif %}
        {# no down-caret: this button opens a modal dialog, not a popover-below
           (the sibling Factors button keeps its caret — it does open a popover) #}

        {# POPOVER: Factor Breakdown #}
        <div class="mx5-popover" id="mx5PopFactors" role="dialog"
             aria-label="Factor Breakdown">
          {# Mobile close bar — sticky at top of bottom-sheet; hidden on desktop via CSS #}
          <div class="mx5-pop-close-bar">
            <div style="width:32px"></div>
            <div class="mx5-pop-close-handle"></div>
            <button class="mx5-pop-close-btn" type="button"
                    onclick="mx5CloseAllPopovers()" aria-label="Close">&#xd7;</button>
          </div>
          <div class="mx5-popover-title"><span class="l-en">Factor Breakdown &mdash; {{ _mx5_comps | length }} Signals</span><span class="l-zh">因子分析 &mdash; {{ _mx5_comps | length }} 项</span></div>
          <div class="mx5-factors-inner">
            {% for c in _mx5_comps %}
            {% set _fweak = (_mx5_weakest and c.label_en == _mx5_weakest.label_en) %}
            <div class="mx5-factor-row">
              <div class="mx5-factor-header">
                <span class="mx5-factor-name{% if _fweak %}" style="color:var(--mx5-warn-ink){% endif %}">
                  <span class="l-en">{{ c.label_en }}</span><span class="l-zh">{{ c.label_zh or c.label_en }}</span>
                </span>
                <span class="mx5-factor-score{% if _fweak %} weak{% endif %}">{{ c.score }}</span>
              </div>
              <div class="mx5-factor-bar-track">
                <div class="mx5-factor-bar-fill{% if _fweak %} weak{% endif %}" style="width:{{ [c.score, 100] | min }}%"></div>
              </div>
              {% if _fweak %}
              <div class="mx5-factor-weak-tag"><span class="l-en">WEAKEST LEG &mdash; MONITOR</span><span class="l-zh">最弱分项 &mdash; 持续关注</span></div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          <div class="mx5-pop-footer">
            <button class="mx5-pop-footer-link" type="button"
                    onclick="mx5CloseAllPopovers();mx5OpenDlg('dlg-evidence')">
              <span class="l-en">Full breakdown &#8595;</span><span class="l-zh">完整分析 &#8595;</span>
            </button>
          </div>
        </div>{# /mx5PopFactors #}

      </div>{# /mx5-btn-row #}

    </div>{# /mx5-sc-left #}

    {# 60-session path panel (right, hidden ≤700px per spec §0 via CSS) #}
    {# month names are needed by the header stamp below as well as by the axis ticks,
       so they are set before the chart's own {% if %} rather than inside it #}
    {% set _mx5_mos_en = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
    <div class="mx5-sc-right">
      <div class="mx5-path-header">
        <span class="mx5-path-title">
          <span class="l-en">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}{{ _mx5_hist_n }}-session path{% else %}60-session path{% endif %}</span>
          <span class="l-zh">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}近 {{ _mx5_hist_n }} 交易日走势{% else %}60 交易日走势{% endif %}</span>
        </span>
        {# The last point is the NIGHTLY ledger's last graded session — normally
           yesterday, never "today's score". Stamped with its own date so the end of the
           line cannot be read as a live reading. Phrased as "last graded" on purpose:
           risk_state_live.js may append a PROVISIONAL intraday point beyond it, and
           "last graded <date>" stays true when it does. #}
        {% set _ph_last_d = _mx5_hist[-1].asof if (_mx5_hist and _mx5_hist[-1].asof is defined and _mx5_hist[-1].asof and _mx5_hist[-1].asof | length >= 10) else none %}
        <span class="mx5-path-meta">{% if _ph_last_d %}<span class="l-en">Score vs time &middot; last graded {{ _mx5_mos_en[_ph_last_d[5:7]|int] }} {{ _ph_last_d[8:10]|int }}</span><span class="l-zh">综合评分 · 时序 &middot; 最后评级 {{ _ph_last_d[5:7]|int }}月{{ _ph_last_d[8:10]|int }}日</span>{% else %}<span class="l-en">Score vs time</span><span class="l-zh">综合评分 · 时序</span>{% endif %}</span>
      </div>
      {% if _mx5_hist %}
      {# ── Legit chart geometry (Order 1) ──────────────────────────────────
         viewBox 0 0 1000 224.  Plot band: x∈[PX0, PX0+PXW]  y∈[PY0(score100), PYB(score0)].
         Y map:  y = PY0 + (100-score)/100 * (PYB-PY0)
         X map:  x = PX0 + i/(n-1) * PXW           (single point → centred)
         Verdict bands: risk-off <42, mixed 42–60, risk-on ≥60.
         x-axis label strip lives BELOW PYB (y≈216). #}
      {% set _ph_n = _mx5_hist | length %}
      {% set PX0 = 44 %}{% set PXW = 944 %}{% set PY0 = 10 %}{% set PYB = 194 %}
      {# score → verdict word (matches engine band thresholds) #}
      {% set _ph_yfor = PYB - PY0 %}
      {# y for each score-band boundary #}
      {% set _y100 = PY0 %}
      {% set _y75  = (PY0 + 25.0/100 * _ph_yfor) | round(2) %}
      {% set _y60  = (PY0 + 40.0/100 * _ph_yfor) | round(2) %}
      {% set _y50  = (PY0 + 50.0/100 * _ph_yfor) | round(2) %}
      {% set _y42  = (PY0 + 58.0/100 * _ph_yfor) | round(2) %}
      {% set _y25  = (PY0 + 75.0/100 * _ph_yfor) | round(2) %}
      {% set _y0   = PYB %}
      {# build point list: viewBox x,y baked so the hover JS stays in perfect sync #}
      {% set _ph_pts_line = [] %}
      {% set _ph_json = [] %}
      {# PER-POINT BAND + its position along the line, for the segment colouring below.
         The path used to be drawn in ONE colour — today's band — so five genuine
         Risk-off sessions in this window rendered amber, and the chart said the radar
         had never left Mixed. Each point's own verdict is already computed here for the
         tooltip (_rv); it now also drives the stroke. #}
      {% set _ph_bands = [] %}
      {% set _ph_offs = [] %}
      {% for row in _mx5_hist %}
        {% set _ph_x = (PX0 + (loop.index0 / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
        {% set _row_s = row.score if (row.score is defined and row.score is not none) else 50 %}
        {% set _ph_y = (PY0 + (100 - _row_s) / 100 * _ph_yfor) | round(2) %}
        {% set _rv = 'Risk-on' if _row_s >= 60 else ('Mixed' if _row_s >= 42 else 'Risk-off') %}
        {% set _rvz = '偏多' if _row_s >= 60 else ('中性' if _row_s >= 42 else '偏空') %}
        {% if _ph_bands.append('b-on' if _row_s >= 60 else ('b-mid' if _row_s >= 42 else 'b-off')) %}{% endif %}
        {% if _ph_offs.append(((_ph_x - PX0) / PXW) | round(5)) %}{% endif %}
        {% if _ph_pts_line.append(_ph_x ~ ',' ~ _ph_y) %}{% endif %}
        {% if _ph_json.append({'d': row.asof, 'md': (_mx5_mos_en[row.asof[5:7]|int] ~ ' ' ~ (row.asof[8:10]|int)) if (row.asof and row.asof|length >= 10) else '', 'mz': ((row.asof[5:7]|int)|string ~ '月' ~ (row.asof[8:10]|int)|string) if (row.asof and row.asof|length >= 10) else '', 's': row.score, 'v': _rv, 'vz': _rvz, 'x': _ph_x, 'y': _ph_y}) %}{% endif %}
      {% endfor %}
      {# ── SEGMENT COLOUR as a hard-stop gradient along the line ──────────────────
         One <polyline> is kept deliberately (risk_state_live.js patches it by tag to
         extend the path with the live session, so splitting it into 19 elements would
         leave the intraday tail undrawn). Colour instead comes from a baked gradient in
         objectBoundingBox space — the bbox spans exactly [PX0, PX0+PXW], so a stop at
         (x−PX0)/PXW lands on its own point. Each SEGMENT takes the band of the point it
         ARRIVES at, and a colour change emits two stops at the same offset, so the
         transition is a hard edge exactly where the path enters the new band.
         Stop colours come from CSS classes, not baked hex, so they follow the theme and
         flip under zh 红涨绿跌 with --up/--down like every other directional mark. #}
      {% set _ph_stops = [] %}
      {% for k in range(_ph_n - 1) %}
        {% set _sc = _ph_bands[k + 1] %}
        {% if k == 0 %}{% if _ph_stops.append([0, _sc]) %}{% endif %}
        {% elif _sc != _ph_bands[k] %}
          {% if _ph_stops.append([_ph_offs[k], _ph_bands[k]]) %}{% endif %}
          {% if _ph_stops.append([_ph_offs[k], _sc]) %}{% endif %}
        {% endif %}
      {% endfor %}
      {% if _ph_n > 1 and _ph_stops.append([1, _ph_bands[_ph_n - 1]]) %}{% endif %}
      {# x-axis date ticks: pick up to 6 evenly-spaced indices (always first + last) #}
      {% set _ph_nticks = [_ph_n, 5] | min %}
      {% set _ph_tick_idx = [] %}
      {% if _ph_n <= 6 %}
        {% for i in range(_ph_n) %}{% if _ph_tick_idx.append(i) %}{% endif %}{% endfor %}
      {% else %}
        {% for k in range(_ph_nticks + 1) %}{% if _ph_tick_idx.append((k / _ph_nticks * (_ph_n - 1)) | round | int) %}{% endif %}{% endfor %}
      {% endif %}
      <div class="mx5-path-plot">
      <svg class="mx5-path-svg" viewBox="0 0 1000 224" preserveAspectRatio="none"
           data-points='{{ _ph_json | tojson }}'
           data-px0="{{ PX0 }}" data-pxw="{{ PXW }}" data-py0="{{ PY0 }}" data-pyb="{{ PYB }}"
           data-vbw="1000" data-vbh="224"
           role="img" aria-label="{{ _mx5_hist_n }}-session macro score path, {{ _mx5_hist[0].score }} to {{ _mx5_hist[-1].score }}">
        <defs>
          {# band gradient (see the stop build above). The area-fill gradient it replaces
             washed the WHOLE 20-session area in today's colour — a single-band claim over
             a window that changed band five times — and with the line now carrying the
             bands honestly the wash was also fighting the tinted zones behind it. Removed
             rather than recoloured: one accessory fewer. #}
          <linearGradient id="mx5PathBandGrad" x1="0" y1="0" x2="1" y2="0">
            {%- for _st in _ph_stops %}
            <stop offset="{{ _st[0] }}" class="{{ _st[1] }}"/>
            {%- endfor %}
          </linearGradient>
        </defs>
        {# ── Verdict-band tinted zones (subtle, 4%) ──
           green risk-on: score 60–100 → y _y100.._y60 ; amber mixed: 42–60 → _y60.._y42 ;
           red risk-off: 0–42 → _y42.._y0 . #}
        <rect class="mx5-ph-zone-on" x="0" y="{{ _y100 }}" width="1000" height="{{ (_y60 - _y100) | round(2) }}" fill="rgba(34,217,122,.045)"/>
        <rect x="0" y="{{ _y60 }}"  width="1000" height="{{ (_y42 - _y60) | round(2) }}" fill="rgba(245,158,11,.045)"/>
        <rect class="mx5-ph-zone-off" x="0" y="{{ _y42 }}"  width="1000" height="{{ (_y0 - _y42) | round(2) }}" fill="rgba(239,68,68,.08)"/>
        {# zone boundary hairlines at 42 / 60 #}
        <line class="mx5-ph-hair-on" x1="0" y1="{{ _y60 }}" x2="1000" y2="{{ _y60 }}" stroke="rgba(34,217,122,.22)" stroke-width="1" stroke-dasharray="2,5"/>
        <line class="mx5-ph-hair-off" x1="0" y1="{{ _y42 }}" x2="1000" y2="{{ _y42 }}" stroke="rgba(239,68,68,.20)" stroke-width="1" stroke-dasharray="2,5"/>
        {# NB: zone labels, y-axis numbers, x-axis dates and the today dot are NOT
           drawn in-SVG — this SVG uses preserveAspectRatio="none" (the plot band
           must stretch to fill the card), which would warp any glyph/circle. They
           are rendered as a screen-space HTML overlay (.mx5-path-labels) below,
           positioned by % of the plot box so they track these gridlines exactly. #}
        {# ── Y gridlines at 0/25/50/75/100 + labels ── #}
        <g stroke="rgba(255,255,255,.06)" stroke-width="1">
          <line x1="{{ PX0 }}" y1="{{ _y100 }}" x2="988" y2="{{ _y100 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y75 }}"  x2="988" y2="{{ _y75 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y50 }}"  x2="988" y2="{{ _y50 }}" stroke-dasharray="4,5"/>
          <line x1="{{ PX0 }}" y1="{{ _y25 }}"  x2="988" y2="{{ _y25 }}"/>
        </g>
        {# y-axis number labels → HTML overlay (see .mx5-path-labels below) #}
        {# ── The line, coloured by each point's OWN band (mx5PathBandGrad) ──
             The gradient is referenced through the `stroke` ATTRIBUTE, never a CSS
             rule: an externalised stylesheet resolves url(#id) against the CSS file in
             some engines, and this SVG lives in the document. #}
        <polyline class="mx5-ph-line" points="{{ _ph_pts_line | join(' ') }}" fill="none" stroke="url(#mx5PathBandGrad)" stroke-width="2.2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round"/>
        {# ── X-axis baseline hairline ── #}
        <line x1="{{ PX0 }}" y1="{{ PYB }}" x2="988" y2="{{ PYB }}" stroke="rgba(255,255,255,.16)" stroke-width="1"/>
        {# ── X-axis tick marks (date labels live in the HTML overlay below) ── #}
        <g font-size="11" font-family="Inter,-apple-system,sans-serif">
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          <line x1="{{ _tx }}" y1="{{ PYB }}" x2="{{ _tx }}" y2="{{ (PYB + 4) | round(1) }}" stroke="rgba(255,255,255,.20)" stroke-width="1"/>
        {% endfor %}
        </g>
        {# today marker → HTML overlay (a round dot; an in-SVG circle would render
           as an ellipse under preserveAspectRatio="none") #}
        {% set _ph_last_x = (PX0 + PXW) | round(2) %}
        {% set _ph_last_y = (PY0 + (100 - _mx5_hist[-1].score) / 100 * _ph_yfor) | round(2) %}
      </svg>
      {# ── Axis labels + today marker: screen-space HTML overlay ───────────────
         The SVG fills this .mx5-path-plot box exactly, so a label at viewBox
         (vx,vy) sits at left:vx/1000·100% / top:vy/224·100% and tracks the SVG
         gridlines/points — but as normal HTML it is never stretched by the SVG's
         non-uniform scale. Percentages are baked from the same y-band constants. #}
      <div class="mx5-path-labels" aria-hidden="true">
        {# y-axis scale (centred on each gridline) #}
        <span class="mx5-pl-y" style="top:{{ (_y100 / 224 * 100) | round(2) }}%">100</span>
        <span class="mx5-pl-y" style="top:{{ (_y75  / 224 * 100) | round(2) }}%">75</span>
        <span class="mx5-pl-y" style="top:{{ (_y50  / 224 * 100) | round(2) }}%">50</span>
        <span class="mx5-pl-y" style="top:{{ (_y25  / 224 * 100) | round(2) }}%">25</span>
        <span class="mx5-pl-y" style="top:{{ (_y0   / 224 * 100) | round(2) }}%">0</span>
        {# plain-word verdict-zone labels (right-aligned) #}
        <span class="mx5-pl-zone on"  style="top:{{ ((_y100 + 13) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-on</span><span class="l-zh">偏多</span></span>
        <span class="mx5-pl-zone mid" style="top:{{ ((_y60 + 13) / 224 * 100) | round(2) }}%"><span class="l-en">Mixed</span><span class="l-zh">中性</span></span>
        <span class="mx5-pl-zone off" style="top:{{ ((_y0 - 7) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-off</span><span class="l-zh">偏空</span></span>
        {# x-axis date ticks (bilingual; anchored start / middle / end) #}
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          {% set _txf = 'translate(0,-50%)' if loop.first else ('translate(-100%,-50%)' if loop.last else 'translate(-50%,-50%)') %}
          {% set _tdate = _mx5_hist[_ti].asof %}
          {% if _tdate and _tdate|length >= 10 %}
          <span class="mx5-pl-x" style="left:{{ (_tx / 1000 * 100) | round(3) }}%;transform:{{ _txf }}"><span class="l-en">{{ _mx5_mos_en[_tdate[5:7]|int] }} {{ _tdate[8:10]|int }}</span><span class="l-zh">{{ _tdate[5:7]|int }}月{{ _tdate[8:10]|int }}</span></span>
          {% endif %}
        {% endfor %}
        {# today marker (round dot; JS hover dot overlays on top) #}
        <span class="mx5-pl-today" style="left:{{ (_ph_last_x / 1000 * 100) | round(3) }}%;top:{{ (_ph_last_y / 224 * 100) | round(3) }}%;color:{{ _mx5_sc_col }}"></span>
      </div>{# /mx5-path-labels #}
      {# ── JS hover enhancement layer (screen-space; chart is complete without it) ── #}
      <div class="mx5-path-cross" aria-hidden="true"></div>
      <div class="mx5-path-dot" aria-hidden="true"></div>
      <div class="mx5-path-tip" role="status" aria-live="off">
        <span class="mx5-path-tip-date"></span>
        <span class="mx5-path-tip-row"><b class="mx5-path-tip-score"></b><span class="mx5-path-tip-verdict"></span></span>
      </div>
      </div>{# /mx5-path-plot #}
      {% else %}
      {# Placeholder when ms_history absent or <2 points #}
      <div style="flex:1;display:flex;align-items:center;justify-content:center;">
        <span style="font-size:12px;color:var(--ink-3)"><span class="l-en">Path chart — accruing from nightly log.</span><span class="l-zh">走势图 — 每晚积累中。</span></span>
      </div>
      {% endif %}
    </div>{# /mx5-sc-right #}

    {% endif %}{# /market_state — mx5 scorecard #}

    {# alerts toggle script — touch path. The checkbox is `hidden`, so native
       label-for activation does NOT fire on tap (MOB-02): toggle it in JS. #}
    <script>
    (function(){
      var cb=document.getElementById('ms-alerts-toggle');
      if(!cb) return;
      document.addEventListener('click',function(e){
        var dj=e.target.closest('[data-ms-dlg]');
        if(dj){ e.preventDefault(); cb.checked=false;
                if(window.mx5OpenDlg) window.mx5OpenDlg(dj.getAttribute('data-ms-dlg')); return; }
        if(e.target.closest('[data-ms-jump]')){ cb.checked=false; return; }
        var pill=e.target.closest('.ms-alerts');
        if(pill){ e.preventDefault(); cb.checked=!cb.checked; return; }
        var wrap=e.target.closest('.ms-alerts-wrap');
        if(cb.checked && !wrap) cb.checked=false;
      });
      document.addEventListener('keydown',function(e){
        if(e.key==='Escape'&&cb.checked){ cb.checked=false; return; }
        if((e.key==='Enter'||e.key===' ')&&e.target.closest&&e.target.closest('.ms-alerts')){
          e.preventDefault(); cb.checked=!cb.checked;
        }
      });
    })();
    </script>

    {# ── Path-chart hover enhancement (Order 1c) — pure progressive layer.
       Reads data-points (viewBox x/y baked in) + the SVG's live bounding rect,
       maps viewBox→screen so the crosshair/dot/tooltip are pixel-crisp regardless
       of the SVG's non-uniform stretch. Chart is fully legible without this. #}
    <script>
    (function(){
      var svg = document.querySelector('.mx5-sc-right .mx5-path-svg[data-points]');
      if(!svg) return;
      var plot = svg.closest('.mx5-path-plot'); if(!plot) return;
      var cross = plot.querySelector('.mx5-path-cross');
      var dot   = plot.querySelector('.mx5-path-dot');
      var tip   = plot.querySelector('.mx5-path-tip');
      if(!cross || !dot || !tip) return;
      var tDate = tip.querySelector('.mx5-path-tip-date');
      var tScore= tip.querySelector('.mx5-path-tip-score');
      var tVerd = tip.querySelector('.mx5-path-tip-verdict');
      var pts;
      try { pts = JSON.parse(svg.getAttribute('data-points') || '[]'); } catch(e){ return; }
      if(!pts.length) return;
      /* the live layer (risk_state_live.js patchPath) appends/updates a provisional
         point and rewrites data-points — re-read so the tooltip includes it */
      document.addEventListener('mx5pathlive', function(){
        try { pts = JSON.parse(svg.getAttribute('data-points') || '[]'); } catch(e){}
      });
      var VBW = +(svg.getAttribute('data-vbw')||1000);
      var VBH = +(svg.getAttribute('data-vbh')||224);
      var COL = { 'Risk-on':'#22d97a', 'Mixed':'#f59e0b', 'Risk-off':'#ef4444' };
      function isZh(){
        var el=document.documentElement;
        return (el.getAttribute('data-lang')||'').slice(0,2)==='zh';
      }
      /* nearest point index for a screen-x, using each point's baked viewBox x */
      function nearest(clientX){
        var r = svg.getBoundingClientRect();
        var vx = (clientX - r.left) / r.width * VBW;   // back to viewBox space
        var best=0, bd=Infinity;
        for(var i=0;i<pts.length;i++){
          var d=Math.abs(pts[i].x - vx);
          if(d<bd){ bd=d; best=i; }
        }
        return best;
      }
      function show(i){
        var p = pts[i]; if(!p) return;
        var r = svg.getBoundingClientRect();
        var pr = plot.getBoundingClientRect();
        var sx = (p.x / VBW) * r.width  + (r.left - pr.left);
        var sy = (p.y / VBH) * r.height + (r.top  - pr.top);
        cross.style.left = sx + 'px';   cross.style.opacity = '1';
        dot.style.left = sx + 'px';     dot.style.top = sy + 'px';
        dot.style.background = COL[p.v] || '#22d97a';
        dot.style.opacity = '1';
        tDate.textContent = isZh() ? (p.mz || p.d) : (p.md || p.d);
        tScore.textContent = p.s;
        tVerd.textContent = isZh() ? (p.vz||p.v) : p.v;
        tVerd.style.color = COL[p.v] || '#22d97a';
        /* clamp tooltip x within the plot so it never overflows the card edge */
        var half = tip.offsetWidth/2 || 60;
        var clx = Math.max(half+2, Math.min(pr.width-half-2, sx));
        tip.style.left = clx + 'px';
        tip.style.top  = sy + 'px';
        tip.classList.add('show');
      }
      function hide(){
        cross.style.opacity='0'; dot.style.opacity='0'; tip.classList.remove('show');
      }
      var raf=0, lastX=0;
      function onMove(clientX){
        lastX=clientX;
        if(raf) return;
        raf=requestAnimationFrame(function(){ raf=0; show(nearest(lastX)); });
      }
      svg.addEventListener('mousemove', function(e){ onMove(e.clientX); });
      svg.addEventListener('mouseleave', hide);
      /* touch: tap/drag shows nearest point; touchend leaves it briefly then hides */
      svg.addEventListener('touchstart', function(e){
        if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX));
      }, {passive:true});
      svg.addEventListener('touchmove', function(e){
        if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX));
      }, {passive:true});
      svg.addEventListener('touchend', function(){ setTimeout(hide, 1400); }, {passive:true});
      /* keep tooltip language in sync if the user flips EN/ZH while it is open */
      document.addEventListener('langchange', function(){
        if(tip.classList.contains('show')) show(nearest(lastX));
      });
    })();
    </script>
    {% endif %}{# /if market_state — v2 hero #}
  {% if mode != 'stocks' %}
  {# ── MX5 Popover system — mx5TogglePop / mx5CloseAllPopovers ── #}
  {# NOTE: fn named mx5TogglePop per spec §3.3 — NEVER a native HTMLElement method name.
     Exposed on window so onclick= inline handlers can reach it. #}
  <script>
  (function(){
    var _mx5Active = null;
    var _mx5ActiveBtn = null;

    function _mx5Open(popId, btnId) {
      var pop = document.getElementById(popId);
      var btn = document.getElementById(btnId);
      var bd  = document.getElementById('mx5PopBackdrop');
      var rr  = document.getElementById('regime-radar');
      if (!pop || !btn) return;
      pop.classList.add('open');
      btn.setAttribute('aria-expanded','true');
      if (bd) bd.classList.add('open');
      /* Lift containing card above fixed backdrop (stacking context fix — spec §3.3 lesson 2) */
      if (rr) rr.classList.add('mx5-pop-open');
      _mx5Active = pop;
      _mx5ActiveBtn = btn;
    }

    window.mx5CloseAllPopovers = function() {
      document.querySelectorAll('.mx5-popover.open').forEach(function(p){ p.classList.remove('open'); });
      document.querySelectorAll('.mx5-sc-btn[aria-expanded="true"]').forEach(function(b){
        b.setAttribute('aria-expanded','false');
      });
      var bd  = document.getElementById('mx5PopBackdrop');
      var rr  = document.getElementById('regime-radar');
      if (bd) bd.classList.remove('open');
      if (rr) rr.classList.remove('mx5-pop-open');
      _mx5Active = null; _mx5ActiveBtn = null;
    };

    window.mx5TogglePop = function(popId, btnId) {
      var pop = document.getElementById(popId);
      var isOpen = pop && pop.classList.contains('open');
      window.mx5CloseAllPopovers();
      if (!isOpen) _mx5Open(popId, btnId);
    };

    /* Escape handler: close popovers FIRST, then let mx2 Escape handler close islands.
       Spec §3.3: "Escape handler must respect existing modal guards and close popovers
       BEFORE islands." Uses stopImmediatePropagation only when a popover is actually open,
       so the island Escape handler still fires on subsequent Escape when no popover. */
    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return;
      if (_mx5Active) {
        e.stopImmediatePropagation(); /* prevent mx2 island close on same keypress */
        window.mx5CloseAllPopovers();
      }
    });
  })();
  </script>
  {# Mobile tap-toggle for flip-context panel (≤700px: no hover; tap pill to reveal) #}
  <script>
  (function(){
    var pill = document.querySelector('body.page-macro.mx4-grid .mx5-regime-pill');
    var pop = document.getElementById('mx5FlipCtxPop');
    if (!pill || !pop) return;
    /* only wire tap on touch-capable narrow viewports */
    function isMobile(){ return window.innerWidth <= 700; }
    pill.addEventListener('click', function(){
      if (!isMobile()) return;
      pop.classList.toggle('open');
    });
  })();
  </script>
  {# Desktop clipping fix for the Goldilocks pop: the CSS-hover path reveals the pop
     (z-index) but never lifts #regime-radar out from under the section below. Toggle
     the existing .mx5-pop-open lift on #regime-radar when the anchor is hovered/
     focused, with a short grace so the pointer can travel into the pop and scroll. #}
  <script>
  (function(){
    var anchor = document.querySelector('body.page-macro.mx4-grid .mx5-flipctx-anchor');
    var pill   = document.querySelector('body.page-macro.mx4-grid .mx5-regime-pill');
    var pop    = document.getElementById('mx5FlipCtxPop');
    var rr     = document.getElementById('regime-radar');
    if (!anchor || !pop || !rr) return;
    function isMobile(){ return window.innerWidth <= 700; }
    var t = null;
    function lift(){ if (isMobile()) return; clearTimeout(t); rr.classList.add('mx5-pop-open'); }
    function unliftSoon(){ clearTimeout(t); t = setTimeout(function(){ rr.classList.remove('mx5-pop-open'); }, 220); }
    /* Enter the anchor (pill or pop) → lift; leave → grace-drop. Pointer travel
       between pill and pop stays inside the anchor, so the lift never flickers. */
    anchor.addEventListener('mouseenter', lift);
    anchor.addEventListener('mouseleave', unliftSoon);
    /* keyboard: pill focus lifts, blur drops (unless focus moved into the pop) */
    if (pill){
      pill.addEventListener('focus', lift);
      pill.addEventListener('blur', unliftSoon);
    }
    pop.addEventListener('focusin', lift);
    pop.addEventListener('focusout', unliftSoon);
  })();
  </script>
  {% endif %}
  </div>{# /#regime-radar panel #}

  {# ── V2 ROW-LEDGER SECTIONS (macro mode only) ── #}
  {% if mode != 'stocks' %}
  {% set MS2 = market_state %}
  {% set _mos2 = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
  <div class="panel span12 mx5-rack-panel">

  {# MX4-RACK — grid-view card rack; 8 .sx sections below; footer outside #}
  <div class="mx4-rack">

  {# 1. EVIDENCE row + tray #}
  {% set _weakest = MS2.components | sort(attribute='score') | first if (MS2 and MS2.components) else none %}
  <div class="sx" id="sx-evidence" style="--isle-color:var(--isle-evidence)">
    {# Three-priority glance. Details stay in the Evidence dialog opened by the card.
       Priority order: stance, nearest event/weakest leg, active policy/risk radar. #}
    <div class="sxg-face mx5-card-face" role="button" tabindex="0" aria-haspopup="dialog" onclick="mx5OpenDlg('dlg-evidence')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();mx5OpenDlg('dlg-evidence');}">
      <div class="mx5-card-title"><span class="l-en">What To Do Now</span><span class="l-zh">现在怎么做</span></div>
      <div class="mx5-action-list">
        {# 1. Current stance — deliberately short; the live poller patches this row. #}
        {% if market_state %}
        {% set _wtd_icon_col = 'mx5-ai-green' if market_state.color == 'green' else ('mx5-ai-yellow' if market_state.color == 'yellow' else 'mx5-ai-gray') %}
        {% set _wtd_stroke = '#22d97a' if market_state.color == 'green' else ('#f59e0b' if market_state.color == 'yellow' else 'rgba(255,255,255,.38)') %}
        <div class="mx5-action-item mx5-action-primary" data-wtd-primary>
          <div class="mx5-action-icon {{ _wtd_icon_col }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="{{ _wtd_stroke }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {% if market_state.color == 'green' %}
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
              <polyline points="16 7 22 7 22 13"/>
              {% elif market_state.color == 'yellow' %}
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
              {% else %}
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
              {% endif %}
            </svg>
          </div>
          <div class="mx5-action-text">
            <div class="mx5-action-label">
              <span class="l-en">{{ {'green':'Follow the trend. Add on strength.','yellow':'Trade small. Stay selective.','red':'Reduce risk. Protect capital.'}.get(MS.color,'Stay selective.') }}</span>
              <span class="l-zh">{{ {'green':'顺势而为，强势中加仓。','yellow':'缩小仓位，精选标的。','red':'降低风险，保护本金。'}.get(MS.color,'精选标的。') }}</span>
            </div>
            <div class="mx5-action-sub">
              <span class="l-en">{{ MS.label_en }} &middot; {{ MS.score }}/100</span>
              <span class="l-zh">{{ MS.label_zh or MS.label_en }} &middot; {{ MS.score }}/100</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# 2. ACTIVE stress selloff — the operator-ordered home for a fired gate
           (2026-07-29). This row plus the alerts-pane entry are how it announces
           itself; the readout they link to moved to macro_signals.html on 2026-07-30
           (operator: the standalone container was "all machine language"). Amber, not
           the verdict colour: whatever the verdict, the stance here is caution, and
           amber makes no directional claim that would have to flip under zh 红涨绿跌.

           GLANCE TIER, so the copy is plain-word: the verb chip carries a stance from
           the doctrine's own vocabulary (Law 1) and the line says what the reader does,
           never what the engine is called. "Buyable washout" / "falling-knife risk"
           were the verdict SLUGS printed raw — banned by Law 2, and "buyable" read as a
           buy signal on a filter whose own help text says it is not one. Claims are
           unchanged; the receipts are one click away. #}
        {# `latest is defined` is load-bearing, not defensive noise:
           tests/test_macro_what_to_do_glance.py renders THIS fragment in isolation
           (marker-delimited) against a hand-built context that supplies market_state /
           macro_catalysts but no `latest`, and a bare `latest.dislocation` raises
           UndefinedError there — the row is fine on the page and the whole glance goes
           blank in the test. Guard the lookup, keep the row where the operator put it. #}
        {% set _wtd_dislo = (latest is defined and latest and latest.dislocation
                             and latest.dislocation.dislocation_active) %}
        {% if _wtd_dislo %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon mx5-ai-yellow">
            <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
            </svg>
          </div>
          {# Tri-state, not a boolean: an unreadable Fed-put switch must not borrow the
             permissive line. Mirrors the guard in macro_signals.html.j2 §5. #}
          {% set _wtd_dl = latest.dislocation %}
          {% set _wtd_unknown = ((_wtd_dl.put_state is defined and _wtd_dl.put_state == 'unknown')
                                 or (_wtd_dl.put_state_reliable is defined and not _wtd_dl.put_state_reliable)
                                 or (_wtd_dl.fed_put is defined and _wtd_dl.fed_put is none)) %}
          {# The old standalone readout kept every DISAGREEING reading in the open, on
             the audit order that a fired gate must never bury its own dissent. Moving
             the readout off this page would have buried it by default, so the fact that
             a cross-check disagrees survives here in plain words; the reading itself is
             one click away. Both cross-checks are engine CONTEXT that never changes the
             verdict, so this qualifies the line — it does not restate it. #}
          {% set _wtd_dissent = ((_wtd_dl.geo_reversibility and _wtd_dl.geo_reversibility.agreement != 'corroborates')
                                 or (_wtd_dl.catalyst_narrative and _wtd_dl.catalyst_narrative.agreement != 'corroborates')) %}
          <div class="mx5-action-text">
            <div class="mx5-action-label">
              {# The stance leads the sentence, exactly like the sibling rows ("Follow the
                 trend. Add on strength."). It used to sit in a `.mx5-action-verb` span
                 that NO stylesheet ever matched and that carried no trailing space, so
                 the row shipped reading "StressBuyable washout:" — the span is retired
                 rather than restyled, so this row uses the same idiom as its siblings. #}
              {%- if _wtd_unknown %}<span class="l-en">Don’t chase. Selling is stressed and we can’t read whether the Fed would step in.</span><span class="l-zh">不要追。抛售处于压力状态，且无法判读美联储是否会出手。</span>
              {%- elif _wtd_dl.verdict == 'buyable_washout' %}<span class="l-en">Don’t chase. Selling is stressed, but the Fed’s backstop holds — wait for it to steady.</span><span class="l-zh">不要追。抛售处于压力状态，但美联储托底仍在 — 等待企稳。</span>
              {%- elif _wtd_dl.verdict == 'stand_aside' %}<span class="l-en">Stand aside. Selling is stressed with no Fed backstop — the 2008 setup.</span><span class="l-zh">观望。抛售处于压力状态且美联储托底缺失 — 2008 年式情形。</span>
              {%- else %}<span class="l-en">Don’t chase. Selling is stressed — nothing to do until it steadies.</span><span class="l-zh">不要追。抛售处于压力状态 — 企稳前无需行动。</span>{% endif %}
              {%- if _wtd_dissent %} <span class="mx5-wtd-dissent"><span class="l-en">Not everything agrees.</span><span class="l-zh">并非所有指标一致。</span></span>{% endif %}
              <a class="mx5-wtd-jump" href="macro_signals.html#dislocation" onclick="event.stopPropagation()" onkeydown="if(event.key==='Enter'||event.key===' ')event.stopPropagation();">{{ t('Why →','原因 →') }}</a>
            </div>
          </div>
        </div>
        {% endif %}

        {# 3. Nearest high-impact event; otherwise show the weakest leg. #}
        {% if macro_catalysts %}
        {% set _wtd_ev = macro_catalysts | selectattr('impact','equalto','high') | list | first if (macro_catalysts | selectattr('impact','equalto','high') | list) else macro_catalysts[0] %}
        {% set _wtd_ev_zh = _wtd_ev.get('label_zh') or _wtd_ev.label %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon mx5-ai-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" stroke-linecap="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div class="mx5-action-text">
            <div class="mx5-action-label">
              <span class="l-en">{{ _wtd_ev.label }}: expect noise; ignore the first move.</span>
