{% macro trendword(nh) -%}
{% if nh and nh.trend %}{% set _ar = {'rising':'▲','accelerating':'▲','falling':'▼','cooling':'▼','flat':'▶'} %}{% set _zh = {'rising':'上行','falling':'下行','accelerating':'加速','cooling':'降温','flat':'走平'} %}<span class="tw tw-{{ nh.dir }}">{{ _ar[nh.trend] }} <span class="l-en">{{ nh.trend }}</span><span class="l-zh">{{ _zh[nh.trend] }}</span></span>{% endif %}
{%- endmacro %}
{# the mini history chart + stats shown inside a nowcast hover popover #}
{% macro nchart(nh) -%}
{% if nh and nh.svg %}{{ nh.svg|safe }}
<span class="npstat"><span>{{ nh.years }}y</span><span><span class="l-en">range</span><span class="l-zh">区间</span> {{ nh.lo }}–{{ nh.hi }}%</span><span><span class="l-en">now</span><span class="l-zh">现值</span> <b>{{ nh.last }}%</b></span></span>
<span class="muted" style="font-size:10px;display:block;margin-top:2px">{% if nh.kind=='inflation' %}<span class="l-en">Dashed line = 2% Fed target · trend vs ~3 months ago.</span><span class="l-zh">虚线＝美联储 2% 目标 · 趋势对比约三个月前。</span>{% else %}<span class="l-en">Dashed line = 0% (stall) · trend = recent direction.</span><span class="l-zh">虚线＝0%（停滞）· 趋势＝近期方向。</span>{% endif %}</span>{% endif %}
{%- endmacro %}
{# Zeberg-style mini cycle chart: grey recession shading + zero baseline + blue trend +
   red momentum. mom/trend/rec are equal-length arrays (None allowed). #}
{% macro bcspark(mom, trend, rec, w=320, h=52) -%}
{%- set vals = (mom|reject('none')|list) + (trend|reject('none')|list) -%}
{%- set n = mom|length -%}
{%- if vals|length > 1 and n > 1 -%}
{%- set amax = [vals|map('abs')|max, 0.5]|max -%}
{%- set mid = h/2 -%}
<svg viewBox="0 0 {{ w }} {{ h }}" preserveAspectRatio="none" style="width:100%;height:{{ h }}px;display:block" role="img">
{%- if rec -%}{%- for i in range(rec|length) -%}{%- if rec[i] -%}<rect x="{{ (i/(n-1)*w)|round(2) }}" y="0" width="{{ (w/(n-1)+0.6)|round(2) }}" height="{{ h }}" fill="var(--muted)" opacity="0.16"/>{%- endif -%}{%- endfor -%}{%- endif -%}
<line x1="0" y1="{{ mid }}" x2="{{ w }}" y2="{{ mid }}" stroke="var(--line)" stroke-width="1"/>
<polyline fill="none" stroke="#4c8bf5" stroke-width="1.4" opacity="0.85" points="{% for i in range(trend|length) %}{% if trend[i] is not none %}{{ (i/(n-1)*w)|round(2) }},{{ (mid - trend[i]/amax*(mid-4))|round(2) }} {% endif %}{% endfor %}"/>
<polyline fill="none" stroke="#e0443e" stroke-width="1.6" points="{% for i in range(mom|length) %}{% if mom[i] is not none %}{{ (i/(n-1)*w)|round(2) }},{{ (mid - mom[i]/amax*(mid-4))|round(2) }} {% endif %}{% endfor %}"/>
</svg>
{%- else -%}<div class="muted sm">—</div>{%- endif -%}
{%- endmacro %}
{# ── Wave D sentiment zone dial: 0-100 semicircle, Fear/Neutral/Greed bands +
   pointer at `pct`. Pure SVG, NO t() inside (svg-span-breakout guard). Colours
   are literal because arc <path>s can't take CSS vars from the CSS side reliably
   across clone — but the band strokes use classes so theme.css owns the hue. -#}
{% macro sg_zone_dial(pct, col) -%}
{%- set p = ([0,[100, (pct if pct is not none else 50)]|min]|max) | float -%}
{#- semicircle: cx=66 cy=64 r=52. Pointer is a fixed vertical needle rotated by
   `deg` (no trig filter needed): p=0→-90deg (points left/fear), p=50→0deg (up),
   p=100→+90deg (right/greed). SVG rotate() is clockwise, so deg = p*1.8 - 90. -#}
{%- set deg = (p * 1.8 - 90)|round(2) -%}
<div class="sg-dial" style="--sg-c:{{ col }}">
<svg viewBox="0 0 132 74" preserveAspectRatio="xMidYMid meet" role="img" aria-hidden="true">
<path class="sg-dial-track" d="M14 64 A52 52 0 0 1 118 64" fill="none" stroke-width="9" stroke-linecap="round"/>
<path class="sg-dial-band-fear"  d="M14 64 A52 52 0 0 1 40.7 20.5" fill="none" stroke-width="9" stroke-linecap="round"/>
<path class="sg-dial-band-neu"   d="M46.9 16.6 A52 52 0 0 1 85.1 16.6" fill="none" stroke-width="9"/>
<path class="sg-dial-band-greed" d="M91.3 20.5 A52 52 0 0 1 118 64" fill="none" stroke-width="9" stroke-linecap="round"/>
<line class="sg-dial-ptr" x1="66" y1="64" x2="66" y2="22" transform="rotate({{ deg }} 66 64)"/>
<circle class="sg-dial-hub" cx="66" cy="64" r="4.5"/>
</svg>
<div class="sg-dial-val">{{ p|int }}</div>
<div class="sg-dial-cap">{% if p > 60 %}Greed{% elif p < 40 %}Fear{% else %}Neutral{% endif %}</div>
</div>
{%- endmacro %}
{# ── Wave D leg sparkline: renders ONLY when a real per-leg history series
   (leg.pct_hist = list of 0-100 percentile points) is present. Absent today —
   the graph slot collapses (no fake/placeholder chart, house law). Null-safe. -#}
{% macro sg_leg_spark(hist, col, w=320, h=36) -%}
{%- set pts = (hist|reject('none')|list) if hist else [] -%}
{%- if pts|length > 2 -%}
{%- set n = pts|length -%}
<div class="sg-spark">
<svg viewBox="0 0 {{ w }} {{ h }}" preserveAspectRatio="none" role="img" aria-hidden="true">
<line x1="0" y1="{{ (h/2)|round(1) }}" x2="{{ w }}" y2="{{ (h/2)|round(1) }}" stroke="var(--line)" stroke-width="1"/>
<polyline fill="none" stroke="{{ col }}" stroke-width="1.8" stroke-linejoin="round" points="{% for i in range(n) %}{{ (i/(n-1)*w)|round(2) }},{{ (h-3 - (pts[i]/100)*(h-6))|round(2) }} {% endfor %}"/>
</svg>
</div>
{%- endif -%}
{%- endmacro %}
{# ── Wave D weather glyph: four stroke icons keyed by a 0-3 severity tier
   (0 calm ☼ · 1 breeze · 2 gust · 3 storm ⚡). Pure SVG, aria-hidden. -#}
{% macro sg_weather_glyph(tier) -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if tier <= 0 -%}
<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/>
{%- elif tier == 1 -%}
<path d="M4 9h9a2.5 2.5 0 1 0-2.4-3.2"/><path d="M4 13h13a2.5 2.5 0 1 1-2.4 3.2"/><path d="M4 17h7"/>
{%- elif tier == 2 -%}
<path d="M6 8h10a3 3 0 1 0-2.9-3.8"/><path d="M4 12h14a3 3 0 1 1-2.9 3.8"/><path d="M6 16h9a2.4 2.4 0 1 1-2.3 3"/>
{%- else -%}
<path d="M7 15a4 4 0 0 1 .5-8 5.5 5.5 0 0 1 10.6 1.4A3.4 3.4 0 0 1 17.5 15"/><path d="M12 12l-2 4h3l-2 4"/>
{%- endif -%}
</svg>
{%- endmacro %}
