      <div style="border:1px solid var(--line); border-radius:10px; padding:12px 13px; background:var(--panel2)">
        <div class="muted" style="font-size:11px; letter-spacing:.02em">{{ t('McClellan Oscillator', '麦克莱伦振荡指标') }}
          {{ help("Ratio-adjusted McClellan Oscillator: the 19-day minus 39-day EMA of net advances (normalised so a changing universe size doesn't distort it). Above zero & rising = breadth momentum building; below zero & falling = internals rolling over. The Summation Index is its running total — its slope and sign carry the meaning, not the absolute (cumulative) level.", "比率调整后的麦克莱伦振荡指标：净上涨家数的19日与39日指数均线之差（已归一化，避免样本规模变化造成失真）。高于零且上行 = 广度动量在累积；低于零且下行 = 内部结构在回落。累积指标是其累计和 — 关键在斜率与正负号，而非绝对（累计）水平。") }}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin:4px 0 2px">
          <b class="{{ adv_breadth.mcc.tone }}" style="font-size:22px">{{ adv_breadth.mcc.osc }}</b>
          <span class="pill {{ adv_breadth.mcc.tone }}" style="background:var(--panel)">{{ adv_breadth.mcc.band }}</span>
        </div>
        {{ adv_breadth.mcc.svg }}
        <div class="muted" style="font-size:11px; margin-top:3px">{{ t('Summation Index', '累积指标') }}
          <b class="{{ 'pos' if adv_breadth.mcc.summ_rising else 'neg' }}">{{ t('rising', '上行') if adv_breadth.mcc.summ_rising else t('falling', '下行') }}</b>
          <span class="muted">(20d {{ adv_breadth.mcc.summ_chg20 }})</span>
        </div>
      </div>
      {% endif %}

      <!-- Breadth Thrust -->
      {% if adv_breadth.thrust %}
      <div style="border:1px solid var(--line); border-radius:10px; padding:12px 13px; background:var(--panel2)">
        <div class="muted" style="font-size:11px; letter-spacing:.02em">{{ t('Breadth Thrust (Zweig)', '广度脉冲（兹威格）') }}
          {{ help("The 10-day EMA of the advancers' share, advances / (advances + declines). Zweig's classic launch signal fires when it surges from below 0.40 (washed out) through 0.615 (thrust) inside 10 days — a rare, powerful 'everything's going up at once' kick-off. HONESTY: on our survivorship-biased S&P-500 proxy the strict crossing fires far more often than the canonical ~once-a-decade NYSE signal (rebuilt-from-survivors rebounds look broader than they were live), so read this as a momentum gauge, not the rare historic trigger.", "上涨家数占比（上涨 /(上涨+下跌)）的10日指数均线。兹威格的经典启动信号：在10日内自0.40以下（超卖）急升突破0.615（脉冲）时触发 —— 罕见而强劲的「同涨」启动。诚实说明：在带有幸存者偏差的标普500代理上，严格的穿越远比经典的纽交所「十年一遇」信号更频繁（以幸存者重建的反弹看起来比当时更广），故此处作为动量计读取，而非罕见的历史触发。") }}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin:4px 0 2px">
          <b class="{{ adv_breadth.thrust.tone }}" style="font-size:22px">{{ adv_breadth.thrust.value }}</b>
          <span class="pill {{ adv_breadth.thrust.tone }}" style="background:var(--panel)">{{ adv_breadth.thrust.zone }}</span>
        </div>
        <span style="position:relative; display:block; height:10px; background:var(--panel); border-radius:5px; margin:10px 0 6px" title="0.40 washed → 0.615 thrust">
          <i style="position:absolute; left:{{ adv_breadth.thrust.washed_pos }}%; top:-3px; width:2px; height:16px; background:var(--muted); opacity:.7"></i>
          <i style="position:absolute; left:{{ adv_breadth.thrust.thrust_pos }}%; top:-3px; width:2px; height:16px; background:var(--up)"></i>
          <i style="position:absolute; left:calc({{ adv_breadth.thrust.pos }}% - 5px); top:0; width:10px; height:10px; border-radius:50%; background:{{ tc[adv_breadth.thrust.tone] }}; box-shadow:0 0 0 2px var(--panel2)"></i>
        </span>
        <div class="muted" style="font-size:11px; margin-top:3px">
          {% if adv_breadth.thrust.recent %}<b class="pos">{{ t('strict thrust fired in the last month', '近一月内触发严格脉冲') }}</b>{% else %}{{ t('last strict thrust', '上次严格脉冲') }} <b>{{ adv_breadth.thrust.last or '—' }}</b>{% endif %}
          <span class="muted">· {{ adv_breadth.thrust.hist_count }} {{ t('since 2005', '次（2005年以来）') }}</span>
        </div>
      </div>
      {% endif %}

      <!-- High-Low Index -->
      {% if adv_breadth.hl %}
      <div style="border:1px solid var(--line); border-radius:10px; padding:12px 13px; background:var(--panel2)">
        <div class="muted" style="font-size:11px; letter-spacing:.02em">{{ t('High-Low Index', '新高—新低指数') }}
          {{ help("The 10-day average of the record-high percent: 52-week new highs as a share of (new highs + new lows). Above 50 = new highs are outpacing new lows (an expanding, healthy new-high ledger); below 50 = the new-low side is winning (deterioration). Today's raw net new highs (highs minus lows) and their 10-day average are shown below.", "记录新高占比的10日均值：52周新高占（新高+新低）的比例。高于50 = 新高多于新低（新高账本在扩张、健康）；低于50 = 新低占上风（恶化）。下方显示今日净新高（新高减新低）及其10日均值。") }}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin:4px 0 2px">
          <b class="{{ adv_breadth.hl.tone }}" style="font-size:22px">{{ adv_breadth.hl.hli }}</b>
          <span class="pill {{ adv_breadth.hl.tone }}" style="background:var(--panel)">{{ adv_breadth.hl.band }}</span>
        </div>
        {{ adv_breadth.hl.svg }}
        <div class="muted" style="font-size:11px; margin-top:3px">{{ t('net new highs', '净新高') }}
          <b class="{{ 'pos' if adv_breadth.hl.net_nh[0] != '-' else 'neg' }}">{{ adv_breadth.hl.net_nh }}</b>
          {{ t('today', '今日') }} · <b>{{ adv_breadth.hl.net_nh_10 }}</b> {{ t('avg 10d', '10日均') }}
        </div>
      </div>
      {% endif %}

      <!-- A/D vs price divergence -->
      {% if adv_breadth.div %}
      <div style="border:1px solid var(--line); border-radius:10px; padding:12px 13px; background:var(--panel2)">
        <div class="muted" style="font-size:11px; letter-spacing:.02em">{{ t('A/D line vs price', '腾落线对价格') }}
          {{ help("Does the cumulative advance/decline line confirm the index's recent extremes? If price prints a fresh 3-month high the A/D line will NOT confirm, the advance is narrowing underneath (bearish divergence); a fresh price low the A/D line refuses to confirm is a bullish divergence. Otherwise the internals are confirming the move, or nothing is at an extreme (in range). The sparkline traces the A/D line; the correlation is price-vs-A/D over the last 60 sessions.", "累积腾落线是否确认指数近期的极值？若价格创3个月新高而腾落线未确认，则上涨在底层收窄（看跌背离）；若价格创新低而腾落线拒绝确认，则为看涨背离。否则即为内部结构确认走势，或均未触及极值（区间内）。曲线描绘腾落线；相关系数为近60个交易日价格与腾落线的相关性。") }}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin:4px 0 2px; min-height:30px">
          <b class="{{ adv_breadth.div.tone }}" style="font-size:16px">{{ adv_breadth.div.label }}</b>
        </div>
        {{ adv_breadth.div.svg }}
        <div class="muted" style="font-size:11px; margin-top:3px">{{ adv_breadth.div.verdict }}.
          {% if adv_breadth.div.corr is not none %}<span class="muted">({{ adv_breadth.div.window }}d corr {{ adv_breadth.div.corr }})</span>{% endif %}
        </div>
      </div>
      {% endif %}

      <!-- Participation in historical context -->
      {% if adv_breadth.par %}
      <div style="border:1px solid var(--line); border-radius:10px; padding:12px 13px; background:var(--panel2)">
        <div class="muted" style="font-size:11px; letter-spacing:.02em">{{ t('Participation in context', '参与度的历史背景') }}
          {{ help("Today's % of S&P 500 stocks above their 50-day line, set against its own deep history: the percentile tells you where this reading ranks vs every day since the universe matured, and the 20-day change is the momentum of participation (is it broadening or thinning?). The advance/decline line direction over 20 days rounds it out.", "今日标普500中高于50日均线的股票占比，对照其自身的深度历史：分位数显示该读数相对样本成熟以来每一天的排名，20日变化为参与度的动量（在扩散还是变薄？）。再辅以腾落线20日方向。") }}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin:4px 0 2px">
          <b class="{{ adv_breadth.par.tone }}" style="font-size:22px">{{ adv_breadth.par.pa50 }}%</b>
          {% if adv_breadth.par.pctile is not none %}<span class="pill" style="background:var(--panel)">{{ adv_breadth.par.pctile }}{{ t('th pct', '分位') }} · {{ t('since', '自') }} {{ adv_breadth.par.hist_from }}</span>{% endif %}
        </div>
        {{ adv_breadth.par.svg }}
        <div class="muted" style="font-size:11px; margin-top:3px">
          {% if adv_breadth.par.pa200 %}&gt;200d <b>{{ adv_breadth.par.pa200 }}%</b> · {% endif %}{{ t('20d', '20日') }} <b class="{{ adv_breadth.par.chg_tone }}">{{ adv_breadth.par.chg20 }}</b>
          {% if adv_breadth.par.ad_dir %} · {{ t('A/D', '腾落') }} <b class="{{ 'pos' if adv_breadth.par.ad_dir == 'up' else 'neg' }}">{{ t('up', '上行') if adv_breadth.par.ad_dir == 'up' else t('down', '下行') }}</b>{% endif %}
        </div>
      </div>
      {% endif %}

      <!-- Cross-tier participation gap -->
      {% if adv_breadth.gap %}
      <div style="border:1px solid var(--line); border-radius:10px; padding:12px 13px; background:var(--panel2)">
        <div class="muted" style="font-size:11px; letter-spacing:.02em">{{ t('Large / mid / small gap', '大／中／小盘差') }}
          {{ help("The % > 50-day line for each S&P size tier (500 / 400 / 600), and the small-minus-large gap. Small caps participating MORE than large = a healthy, broad-based tape; small lagging = a narrow, mega-cap-led advance that's more fragile.", "标普各规模层级（500／400／600）高于50日均线的占比，以及「小盘减大盘」之差。小盘参与度高于大盘 = 健康、广泛的盘面；小盘落后 = 狭窄、由超大盘主导、更脆弱的上涨。") }}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin:4px 0 2px">
          <b class="{{ adv_breadth.gap.tone }}" style="font-size:22px">{{ adv_breadth.gap.gap }}</b>
          <span class="pill {{ adv_breadth.gap.tone }}" style="background:var(--panel)">{{ adv_breadth.gap.label }}</span>
        </div>
        <div style="display:flex; gap:10px; margin:8px 0 4px; font-size:12px">
          <span>{{ t('L', '大') }} <b>{{ adv_breadth.gap.large }}%</b></span>
          {% if adv_breadth.gap.mid %}<span class="muted">{{ t('M', '中') }} <b>{{ adv_breadth.gap.mid }}%</b></span>{% endif %}
          <span>{{ t('S', '小') }} <b>{{ adv_breadth.gap.small }}%</b></span>
        </div>
        <div class="muted" style="font-size:11px; margin-top:3px">{{ adv_breadth.gap.verdict }}.</div>
      </div>
      {% endif %}

    </div>
    <p class="muted" style="margin:10px 2px 0; font-size:11px">{{ t('As of', '截至') }} {{ adv_breadth.asof }} · {{ t('computed on the deep S&P 500 breadth series', '基于标普500深度广度序列计算') }} ({{ adv_breadth.deep_from }}–) · {{ t('display-only market internals, never scored', '仅作展示的市场内部结构，不计入评分') }}</p>
    </details>
  </div>
  {% endif %}

  <!-- ============ SECTOR BUY/SELL SETUPS — confluence engine ============ -->
  {% if sector_setups %}
  <div class="panel span12" id="sectors">
    <h2>{{ t('Sector buy/sell setups — 3-day MACD + StochRSI confluence', '板块买卖配置 — 3 日 MACD + StochRSI 共振') }} <span class="help">?<span class="tip">
      <span class="l-en">
      The primary sector timing engine: a confluence of MACD + StochRSI crossovers on the
      <b>3-day chart</b> (the daily is the early trigger), gated by the 200-day trend and sorted
      most-actionable first. Validated 1998-2026 (research/SECTOR_CONFLUENCE.md) — the base-rate
      column is the MEASURED forward-63-day excess vs SPY for each state:
      <table>
        <tr><th>state</th><th>read it as</th><th>fwd 63d vs SPY*</th></tr>
        <tr><td style="color:var(--up)"><b>BUY</b></td><td>fresh up-turn on daily + 3-day, above trend</td><td>+0.9% (56% up)</td></tr>
        <tr><td style="color:var(--info)"><b>SETUP</b></td><td>approaching an up-cross — get ready</td><td>+0.3..0.7%</td></tr>
        <tr><td style="color:var(--orange)"><b>EXTENDED</b></td><td>overbought, late — hold/trim, don't chase</td><td>~flat</td></tr>
        <tr><td style="color:var(--down)"><b>TOPPING</b></td><td>overbought + rolling over — distribution</td><td>−0.1%</td></tr>
        <tr><td style="color:var(--down)"><b>SELL</b></td><td>overbought + confirmed 3-day down-cross</td><td>−1.2% (40% up)</td></tr>
        <tr><td><b>BELOW TREND</b></td><td>under the 200-day — knife; wait for a reclaim</td><td>−0.1%</td></tr>
        <tr><td style="color:var(--info)"><b>OVERSOLD BOUNCE</b></td><td>range-bound defensive (XLU/XLP/XLV/XLRE), oversold dip below trend, Fed-put on — tactical bounce, lags SPY</td><td>+4.0% abs / +0.3% vs SPY</td></tr>
      </table>
      *measured per state across the 11 sector ETFs. The OVERSOLD BOUNCE row's headline is its ABSOLUTE
      return (the dip bounces); its vs-SPY is shown beside it because a low-beta defensive tends to lag a
      rising index — a tactical mean-reversion trade, never a confirmed buy. Honest ceiling: hit-rates ~50-56% — the edge
      is in magnitude and in AVOIDANCE (it stops you chasing the "confirmed leadership" that
      institutions distribute into), not a high win-rate. A risk/timing map, not a return forecast.
      </span>
      <span class="l-zh">
      板块择时主引擎：3 日图上 MACD + StochRSI 交叉的共振（日线作为早期触发），以 200 日趋势把关，
      按可操作性排序。已用 1998–2026 验证（research/SECTOR_CONFLUENCE.md）——基础概率列为各状态
      实测的未来 63 日对 SPY 超额：
      <table>
        <tr><th>状态</th><th>解读</th><th>未来63日对SPY*</th></tr>
        <tr><td style="color:var(--up)"><b>买入</b></td><td>日线+3日线同时转上，且在趋势之上</td><td>+0.9%（56%上涨）</td></tr>
        <tr><td style="color:var(--info)"><b>预备</b></td><td>接近上穿——准备</td><td>+0.3..0.7%</td></tr>
        <tr><td style="color:var(--orange)"><b>过热</b></td><td>超买、已晚——持有/减仓，勿追</td><td>≈持平</td></tr>
        <tr><td style="color:var(--down)"><b>见顶</b></td><td>超买+回落——派发</td><td>−0.1%</td></tr>
        <tr><td style="color:var(--down)"><b>卖出</b></td><td>超买+3日线确认下穿</td><td>−1.2%（40%上涨）</td></tr>
        <tr><td><b>趋势下方</b></td><td>200日线下方——接飞刀；等待收复</td><td>−0.1%</td></tr>
        <tr><td style="color:var(--info)"><b>超卖反弹</b></td><td>区间震荡的防御板块（XLU/XLP/XLV/XLRE），趋势下方超卖回调、美联储托底在位——战术反弹，跑输SPY</td><td>+4.0% 绝对 / +0.3% 对SPY</td></tr>
      </table>
      *按状态、跨 11 个板块 ETF 实测。「超卖反弹」一行的主数字是其绝对回报（回调会反弹）；旁边的对SPY数字
      说明低贝塔防御板块在上涨指数中通常跑输——属战术性均值回归交易，绝非确认买入。诚实上限：胜率约 50–56%——优势在于幅度与「回避」（避免追逐机构
      派发的「已确认领先」），而非高胜率。这是风险/择时地图，不是收益预测。
      </span>
    </span></span></h2>
    <p class="muted" style="font-size:12.5px;margin:6px 0 4px">
      {% if sector_setups.n_buy or sector_setups.n_avoid %}<b>{{ sector_setups.n_buy }}</b> {{ t('on the buy side', '在买入侧') }} · <b>{{ sector_setups.n_avoid }}</b> {{ t('extended / topping / below trend', '过热／见顶／趋势下方') }}{% if sector_setups.n_tactical %} · <b>{{ sector_setups.n_tactical }}</b> {{ t('tactical oversold bounce', '战术超卖反弹') }}{% endif %}. {% endif %}{{ t('Cross-sectionally the buy side has beaten the avoid side by ~0.8%/quarter (1998-2026). Use it to time rotation and to NOT chase extended leaders — never as a return forecast.', '横截面上买入侧每季度约跑赢回避侧 0.8%（1998–2026）。用于把握轮动、避免追逐过热领先股——切勿当作收益预测。') }}
    </p>
    <table>
      <tr>
        <th class="l">{{ t('sector', '板块') }}</th>
        <th class="l">{{ t('verdict', '判断') }} {{ help("BUY/SETUP = an entry above the 200-day; EXTENDED/TOPPING/SELL = late or distributing; BELOW TREND = a knife. Dots = conviction (how many of daily / 3-day MACD / 3-day StochRSI agree).", "买入/预备＝200日线上方的入场；过热/见顶/卖出＝偏晚或派发中；趋势下方＝接飞刀。圆点＝信心（日线／3日 MACD／3日 StochRSI 中有几个一致）。") }}</th>
        <th class="l">{{ t('3-day signal', '3 日信号') }} {{ help("What actually fired on the 3-day chart (the daily is the early trigger): a MACD/StochRSI crossover, a curl approaching a cross (with an ETA in trading days), or a roll-over.", "3 日图上实际触发了什么（日线为早期触发）：MACD/StochRSI 交叉、接近交叉的拐头（含预计交易日数）、或回落。") }}</th>
        <th>{{ t('trend', '趋势') }} {{ help("Price vs its 200-day (long-term) and 50-day (medium-term) average — the gate that separates a buyable pullback from a falling knife.", "价格相对 200 日（长期）与 50 日（中期）均线——把可买回调与接飞刀分开的闸门。") }}</th>
        <th>{{ t('RSI / Stoch (3D)', 'RSI / Stoch（3 日）') }} {{ help("The 3-day RSI(14) and StochRSI. Above 70 / 80 = extended (late). StochRSI crossing up over 20 from oversold is the bottoming tell; dropping out of 80 is the topping tell.", "3 日 RSI(14) 与 StochRSI。高于 70／80＝过热（偏晚）。StochRSI 从超卖上穿 20 是见底信号；跌出 80 是见顶信号。") }}</th>
        <th>{{ t('3mo vs mkt', '3 月对比市场') }} {{ help("Relative strength vs the S&P 500 over the past ~60 trading days.", "过去约 60 个交易日相对标普 500 的强弱。") }}</th>
        <th>{{ t('seasonality', '季节性') }} {{ help("This sector's average return in the current calendar month. Hover for the full 12-month picture. Weak evidence — context only, never a signal on its own.", "该板块在当前日历月的平均回报。悬停查看完整 12 个月全貌。弱证据——仅作背景参考，绝不单独作为信号。") }}</th>
        <th>{{ t('base rate', '基础概率') }} {{ help("The MEASURED forward 63-day excess vs SPY for this state across the 11 sector ETFs 1998-2026 — the signal's honest track record, not a promise.", "该状态实测的未来 63 日对 SPY 超额，跨 11 个板块 ETF、1998–2026——信号的真实历史记录，并非承诺。") }}</th>
      </tr>
      {% for r in sector_setups.sectors %}
      <tr>
        <td class="l"><a href="{{ r.href or ('sectors/' ~ r.ticker ~ '.html') }}"><b>{{ r.ticker }}</b></a> <span class="muted">{{ td(r.name) }}</span>
        </td>
        <td class="l" data-sort="{{ r.priority }}">
          <span style="display:inline-flex;align-items:center;gap:6px">
            <span class="pill" style="border:1px solid {{ r.color }};color:{{ r.color }};background:transparent;font-weight:700">{{ r.verdict }}</span>
            <span style="color:{{ r.color }};letter-spacing:1px;font-size:10px">{{ r.conv_dots }}</span>
          </span>
          <div class="muted" style="font-size:11px;margin-top:3px;max-width:300px">{{ r.action_txt }}</div>
        </td>
        <td class="l" style="font-size:12px">{{ r.signal_txt }}</td>
        <td class="{{ 'pos' if r.tech_ok else '' }}" style="font-size:12px">{{ r.tech_str }}</td>
        <td style="font-size:12px">{{ r.osc_str }}</td>
        <td class="{% if r.rs_60d and r.rs_60d > 0 %}pos{% elif r.rs_60d and r.rs_60d < 0 %}neg{% endif %}" data-sort="{{ r.rs_60d or 0 }}">{{ r.rs_str }}</td>
        <td>
          <span class="help" style="width:auto;height:auto;border:none;margin:0">
            <span style="cursor:help">{{ r.season_str }}</span>
            <span class="tip tip-seas">{{ r.season_tip }}</span>
          </span>
        </td>
        <td class="{% if r.rate_pos %}pos{% elif r.rate_pos is none %}muted{% else %}neg{% endif %}" style="font-size:11.5px">{{ r.rate_str }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted" style="font-size:12px">{{ t('Click any sector for its full drill-down: cycle position, multi-timeframe momentum, the confluence signal, and each top-10 holding analyzed individually.', '点击任意板块查看完整下钻：周期位置、多时间尺度动量、共振信号，以及逐一分析的每个前十大持仓。') }}</p>
  </div>
  {% endif %}{# /sector_setups #}
  {% endif %}{# /mode != macro — size/style + sector heat #}


  {% if mode != 'macro' %}
  <!-- ======================= ACCUMULATION WATCH ======================= -->
  <div class="panel span12" id="accumulation">
    <h2>{{ t('Accumulation watch — sector ETFs', '增持监测 — 板块 ETF') }}
      {{ help("Each sector SPDR's top-10 weights, with each holding's weight change split into the part explained by the stock's own price move and a residual ('active' = weight that grew MORE than price alone). A large positive residual = real buying flowed into the name beyond market drift. HONEST CAVEAT: these SPDRs are PASSIVE index funds, so the residual is index reconstitution / float-weight flow (forced index-fund buying), NOT a discretionary manager's conviction — that reading comes with the active funds in the planned top-200 page. The technical column shows the stock's own cycle state; ✅ marks accumulation that also has a forming buy setup. Thresholds are uncalibrated until more snapshot history accumulates.", "每只板块 SPDR 的前十大权重；每只持仓的权重变动被拆分为“由个股自身价格变动解释的部分”与“残差”（“主动”=权重增长超过价格涨幅的部分）。较大的正残差=除市场漂移外确有真实买盘流入该股。诚实提示：这些 SPDR 是被动指数基金，故残差代表指数再平衡／流通权重调整带来的资金流（被动强制买入），并非主动经理的信念——后者要等到计划中的前 200 ETF 页面里的主动基金。技术面列显示个股自身的周期状态；✅ 表示增持同时出现了正在形成的买入形态。在积累更多快照历史前，阈值尚未校准。") }}
    </h2>
    {% if accumulation %}
      <table>
        <tr>
          <th class="l">{{ t('sector', '板块') }}</th>
          <th class="l">{{ t('stock', '个股') }}</th>
          <th>{{ t('raw Δwt', '原始权重Δ') }}</th>
          <th>{{ t('active Δwt', '主动权重Δ') }}</th>
          <th>{{ t('est. flow', '估算资金流') }}</th>
          <th class="l">{{ t('technical', '技术面') }}</th>
        </tr>
        {% for a in accumulation %}
        <tr>
          <td class="l muted">{{ a.fund }} · {{ td(a.sector) }}</td>
          <td class="l"><a href="stock.html#{{ a.ticker }}"><b>{{ a.ticker }}</b></a> <span class="muted">{{ a.name }}</span></td>
          <td class="{{ 'pos' if a.raw_change >= 0 else 'neg' }}">{{ "%+.2f" | format(a.raw_change) }}pp</td>
          <td class="{{ 'pos' if a.active_change >= 0 else 'neg' }}"><b>{{ "%+.2f" | format(a.active_change) }}pp</b></td>
          <td class="muted">{{ a.flow_str }}</td>
          <td class="l">
            {% if a.ladder %}<span class="pill st-{{ a.ladder.state | replace(' ', '_') }}">{{ td(a.ladder.label) }}</span>{% if a.confirmed %} ✅{% endif %}{% else %}<span class="muted">—</span>{% endif %}{% if a.vol and a.vol.surging %} <span title="volume {{ a.vol.ratio }}× its recent average">📊</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
      <p class="muted" style="font-size:12px;margin-top:8px">{{ t('“Active Δwt” strips out price: it is the percentage points of weight a name gained beyond what its own price move explains. On passive index ETFs this captures index reconstitution / float-weight flow, not a manager’s discretion. The estimated $ flow applies the active Δwt to the fund’s AUM and is approximate.', '“主动权重Δ”已剔除价格因素：它是个股权重增长中超出其自身价格涨幅所能解释的百分点。在被动指数 ETF 上，这反映的是指数再平衡／流通权重调整带来的资金流，而非经理人的主动决策。估算的美元资金流是将“主动权重Δ”乘以基金 AUM 得出的近似值。') }}</p>
    {% else %}
      <p class="muted">{{ t('Building — needs at least two daily holdings snapshots per fund (collection began 2026-06-11). Decomposed accumulation signals appear once a second snapshot lands.', '构建中 — 每只基金至少需要两个每日持仓快照（采集自 2026-06-11 开始）。第二个快照落地后将显示拆解后的增持信号。') }}</p>
    {% endif %}
  </div>

  <!-- ======================= HOLDINGS / FLOWS ======================= -->
  <div class="panel span12" id="holdings">
    <h2>{{ t("Real fund moves — strongest conviction", '基金真实动作 — 信念最强') }}
      {{ help("The top conviction-ranked ACCUMULATION decisions across curated thematic/industry funds (SPDR sector, Global X) and actively managed funds (ARK), with mechanical flow AND price moves stripped out. Conviction = percentage POINTS of fund weight the manager actually committed — so a real add to a meaningful position outranks a tiny position doubling. The full board (incl. trims & every fund) is the 🐳 Real fund moves page.", "在精选的主题／行业基金（SPDR 板块、Global X）与主动管理基金（ARK）中，按信念排序的最强增持决策，已剔除机械性资金流与价格变动。信念 = 经理人实际投入的基金权重百分点——因此对有意义仓位的真实增持会胜过微小仓位的翻倍。完整看板（含减持与全部基金）见 🐳 基金真实动作 页面。") }}
      <a href="etfs.html" class="muted" style="font-size:12px;font-weight:400;float:right">{{ t('see all →', '查看全部 →') }}</a>
    </h2>
    {% if holdings_changes %}
      <table>
        <tr><th class="l">{{ t('fund', '基金') }}</th><th class="l">{{ t('stock', '个股') }}</th><th class="l">{{ t('sector', '板块') }}</th><th class="r">{{ t('weight', '权重') }}</th><th class="r">{{ t('conviction Δwt', '信念权重Δ') }}</th><th class="l">{{ t('technical', '技术面') }}</th></tr>
        {% for h in holdings_changes %}
        <tr><td class="l"><b>{{ h.fund }}</b></td>
            <td class="l"><a href="stock.html#{{ h.ticker }}"><b>{{ h.ticker }}</b></a> <span class="muted">{{ h.name }}</span></td>
            <td class="l muted">{{ td(h.sector) if h.sector else "—" }}</td>
            <td class="r muted">{% if h.get('weight_pct') is not none %}{{ "%.2f" | format(h.weight_pct) }}%{% else %}—{% endif %}</td>
            <td class="r {{ ('pos' if h.conviction_pp >= 0 else 'neg') if h.get('conviction_pp') is not none else 'muted' }}"><b>{% if h.get('conviction_pp') is not none %}{{ "%+.2f" | format(h.conviction_pp) }}pp{% else %}—{% endif %}</b></td>
            <td class="l">{% if h.ladder %}<span class="pill st-{{ h.ladder.state | replace(' ', '_') }}">{{ td(h.ladder.label) }}</span>{% if h.confirmed %} ✅{% endif %}{% else %}<span class="muted">—</span>{% endif %}</td></tr>
        {% endfor %}
      </table>
    {% else %}
      <p class="muted">{{ t('No significant manager moves in the current window (needs a few trading days of snapshots).', '当前窗口内无显著的经理人动作（需要数个交易日的快照）。') }}</p>
    {% endif %}

    <p class="muted" style="font-size:12px;margin-top:10px">{{ t('Looking for where sector-ETF money is rotating (1D / 3D / 1W / 2W / 1M creation-redemption flow)? It now lives on', '想看板块 ETF 资金的轮动去向（1D / 3D / 1W / 2W / 1M 申购赎回资金流）？已移至') }} <a href="sector_central.html#sc-flows">{{ t('Sector Central', '行业中枢') }} →</a></p>
  </div>

  {% endif %}{# /mode != macro — accumulation + holdings/flows #}

  {% if mode != 'stocks' %}
  <!-- ======================= HEALTH ======================= -->
  <details class="panel span12 fold" id="health">
    <summary>{{ t('Data health', '数据健康度') }}
      {{ help("Every data source this dashboard depends on. OK = fresh. STALE = no new data lately (signal confidence reduced automatically). FAILED = today's fetch broke (yesterday's data still used). BLOCKED = a known, documented limitation — not a malfunction. DEAD = failed 3+ runs and paused until it recovers.", "本仪表盘所依赖的每个数据源。OK = 新鲜。STALE = 近期无新数据（信号置信度已自动下调）。FAILED = 今日抓取失败（仍沿用昨日数据）。BLOCKED = 已知且有记录的限制 — 并非故障。DEAD = 连续 3 次以上失败，已暂停直至恢复。") }}
      {% set _bad = health|rejectattr('status','equalto','ok')|rejectattr('status','equalto','blocked')|list %}
      <span class="fold-stat">{% if _bad %}{{ _bad|length }} {{ t('need attention', '需关注') }}{% else %}{{ t('all sources OK', '全部正常') }}{% endif %} · {{ health|length }} {{ t('sources', '数据源') }}</span>
      <span class="fold-caret">▾</span>
    </summary>
    <table>
      <tr><th class="l">{{ t('source', '数据源') }}</th><th class="l">{{ t('status', '状态') }}</th><th>{{ t('rows', '行数') }}</th><th>{{ t('last data', '最新数据') }}</th><th class="l">{{ t('note', '备注') }}</th></tr>
      {% for s in health %}
      <tr>
        <td class="l">{{ s.name }}</td>
        <td class="l"><span class="pill pill-{{ s.status }}">{{ s.status }}</span></td>
        <td>{{ s.rows }}</td><td>{{ s.last_date or "—" }}</td>
        <td class="l muted">{{ s.error or "" }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted"><span class="l-en">A failed source never crashes the dashboard — affected signals just lose confidence until it heals.
       Generated {{ generated_utc }} UTC · <a href="aibrief.html">AI daily brief</a> ·
       <a href="history.html">history & charts</a></span><span class="l-zh">数据源失败绝不会让仪表盘崩溃 — 受影响的信号只是降低置信度，直到其恢复。
       生成于 {{ generated_utc }} UTC · <a href="aibrief.html">AI每日简报</a> ·
       <a href="history.html">历史与图表</a></span></p>
  </details>
  {% endif %}{# /mode != stocks — data health #}

</div>
<script>
  // keep tooltips on-screen: open downward near the top, and anchor to the
  // nearest side when close to the left/right viewport edges
  document.addEventListener('mouseover', function (e) {
    var h = e.target.closest('.help, .hovchart, .msr-scare');
    if (!h) return;
    var r = h.getBoundingClientRect();
    var tip = h.querySelector('.tip');
    // Tooltips inside a horizontally-scrolling table wrapper (.tbl-scroll, applied
    // by theme.js to wide tables) are clipped by its overflow:auto — most visibly
    // the tall seasonality popups on the top sector rows. Lift those to fixed
    // positioning so they escape the wrapper; pick above/below by available room.
    if (tip && h.closest('.tbl-scroll')) {
      tip.style.position = 'fixed';
      tip.style.transform = 'none';
      var tw = tip.offsetWidth || 320, th = tip.offsetHeight || 200, m = 8;
      var left = Math.min(Math.max(m, r.left + r.width / 2 - tw / 2),
                          window.innerWidth - tw - m);
      tip.style.left = left + 'px';
      tip.style.right = 'auto';
      if (r.top - th - m > 0) { tip.style.top = (r.top - th - m) + 'px'; }
      else { tip.style.top = (r.bottom + m) + 'px'; }
      tip.style.bottom = 'auto';
      return;
    }
    h.classList.toggle('below', r.top < 330);
    var half = ((tip && tip.offsetWidth) || 290) / 2 + 16;
    h.classList.remove('edge-right', 'edge-left');
    if (r.left + r.width / 2 + half > window.innerWidth) h.classList.add('edge-right');
    else if (r.left + r.width / 2 - half < 0) h.classList.add('edge-left');
  });
</script>
<script>
  // Deep-link highlight: when an alert links to a scorecard (#liquidity, #credit,
  // …), smooth-scroll to that panel and pulse a glow so it's obvious which card
  // the alert came from — whether arriving from the landing hub (page load with
  // a #hash) or clicking an alert on this page.
  (function () {
    function flash(id) {
      var el = document.getElementById(id);
      if (!el) return;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      el.classList.remove('flash');
      void el.offsetWidth;            // restart the animation on a re-click
      el.classList.add('flash');
      setTimeout(function () { el.classList.remove('flash'); }, 2600);
    }
    function fromHash() {
      var id = (location.hash || '').replace('#', '');
      if (id && document.getElementById(id)) setTimeout(function () { flash(id); }, 60);
    }
    window.addEventListener('load', fromHash);
    window.addEventListener('hashchange', fromHash);
    document.addEventListener('click', function (e) {
      var a = e.target.closest('a.alert[href^="#"]');
      if (!a) return;
      var id = a.getAttribute('href').slice(1);
      // re-clicking when the hash is already set won't fire hashchange — flash now
      if (location.hash === '#' + id) { e.preventDefault(); flash(id); }
    });
  })();
</script>
<script>
/* Chinese-mode chart recolour + relabel map (baked chart colours are constants).
   Colour pairs are symmetric so the same map flips both ways; charts always
   render on dark slate so only these green/red + quad green/red hexes swap. */
window.__CHART_SWAP__ = {
  colors: {"#5fbf7f":"#e07070","#e07070":"#5fbf7f","#2e9e4f":"#d04545","#d04545":"#2e9e4f"},
  labels: {"growth":"增长","inflation":"通胀","net liquidity":"净流动性","4w RoC":"4周变化",
           "HY OAS %":"高收益债利差 %","% S&P500 > 50DMA":"标普500 高于50日均线 %"}
};
</script>
