  <div class="mx5-dlg" id="dlg-fed" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Fed Path — Forward Board</span><span class="l-zh">联储路径 — 前瞻看板</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
      {# ── Reuse _rc aliases already computed for the card ── #}
      {% set _dlgrc = rates_command if (rates_command is defined and rates_command) else none %}
      {% if _dlgrc %}
      {% set _dlgrc_ep   = _dlgrc.expectations_pressure %}
      {% set _dlgrc_brd  = _dlgrc.board %}
      {% set _dlgrc_rpr  = _dlgrc_brd.rate_path_row %}
      {% set _dlgrc_inf  = _dlgrc_brd.inflation_row %}
      {% set _dlgrc_risk = _dlgrc_brd.risk_row %}
      {% set _dlgrc_pol  = _dlgrc_brd.policy_row %}
      {% set _dlgrc_mc   = _dlgrc.market_check %}
      {% set _dlgrc_pl_map_en = {'QUIET':'No active policy pressure.','ELEVATED':'Elevated — watch for repricing.','ARMED':'Active — repricing underway.'} %}
      {% set _dlgrc_pl_map_zh = {'QUIET':'当前无积极政策压力。','ELEVATED':'警戒 — 留意重定价风险。','ARMED':'已触发 — 重定价进行中。'} %}

      {# ── a. Hero ── #}
      <div style="margin-bottom:16px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:13px;font-weight:700;padding:3px 8px;border-radius:4px;background:rgba(255,255,255,.07)">
            <span class="l-en">{{ _dlgrc_ep.state_label.en }}</span>
            <span class="l-zh">{{ _dlgrc_ep.state_label.zh }}</span>
          </span>
          <span style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))">{{ _dlgrc.asof }}</span>
        </div>
        <div style="font-size:13px;color:var(--ink-2,rgba(255,255,255,.7));line-height:1.6">
          <span class="l-en">{{ _dlgrc.stance.en }}</span>
          <span class="l-zh">{{ _dlgrc.stance.zh }}</span>
        </div>
      </div>
      <div class="mx5-dlg-sep"></div>

      {# ── b. Pressure beam — hawkish weight vs easing weight, the beam tilts ── #}
      {# Plain 1-2 word chip label per leg (mechanic + threshold receipt stays on hover). #}
      {% set _fbm_leg_lbl = {
        'H1_path_repricing':      {'en':'Rate futures','zh':'利率期货'},
        'H2_breakeven_momentum':  {'en':'Breakevens','zh':'盈亏平衡'},
        'H3_oil_impulse':         {'en':'Oil','zh':'原油'},
        'H4_inflation_trajectory':{'en':'Inflation path','zh':'通胀路径'},
        'H5_curve_regime':        {'en':'Yield curve','zh':'收益率曲线'},
        'H6_anchoring_strain':    {'en':'Expectations','zh':'通胀预期'},
        'E1_equity_deleveraging': {'en':'Equity risk-off','zh':'股市避险'},
        'E2_growth_cooling':      {'en':'Growth cooling','zh':'增长放缓'},
        'E3_dollar_tightening':   {'en':'Strong dollar','zh':'美元走强'},
        'E4_credit_stress':       {'en':'Credit stress','zh':'信用压力'},
        'E5_policy_easing_chain': {'en':'Easing chain','zh':'宽松传导'}
      } %}
      {% set _fbm_hawk = _dlgrc_ep.hawk_score %}
      {% set _fbm_ease = _dlgrc_ep.ease_score %}
      {# Beam tilt: net weight (hawk − ease) mapped to a bounded angle. Hawk-heavy tilts
         DOWN-LEFT (positive rotate); easing tilts up-left / down-right (negative). Clamp ±9°. #}
      {% set _fbm_net = _fbm_hawk - _fbm_ease %}
      {% set _fbm_tilt_raw = (_fbm_net * 3) %}
      {% set _fbm_tilt = ([[_fbm_tilt_raw, 9] | min, -9] | max) %}
      {% set _fbm_lean_word_en = 'balanced' if _fbm_net == 0 else ('leaning hawkish' if _fbm_net > 0 else 'leaning easier') %}
      {% set _fbm_lean_word_zh = '大体制衡' if _fbm_net == 0 else ('偏鹰' if _fbm_net > 0 else '偏宽松') %}
      {% set _fbm_lean_cls = 'even' if _fbm_net == 0 else ('hawk' if _fbm_net > 0 else 'ease') %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Pressure Balance</span><span class="l-zh">压力平衡</span></div>
      <div class="fbm-beam-wrap">
        <div class="fbm-beam-heads">
          <span class="fbm-beam-head hawk"><span class="fbm-wt">{{ _fbm_hawk }}</span><span class="l-en">Hawkish</span><span class="l-zh">鹰派</span></span>
          <span class="fbm-beam-head ease"><span class="l-en">Easing</span><span class="l-zh">宽松</span><span class="fbm-wt">{{ _fbm_ease }}</span></span>
        </div>
        <div class="fbm-beam-stage" style="--tilt:{{ _fbm_tilt }}deg">
          <div class="fbm-beam-bar"></div>
          <div class="fbm-fulcrum"></div>
          <div class="fbm-beam-pans">
            <div class="fbm-beam-pan hawk">
              <div class="fbm-beam-chips">
                {% for leg in _dlgrc_ep.legs %}{% if leg.key[:1] == 'H' %}
                {% set _ll = _fbm_leg_lbl.get(leg.key, {'en':leg.key,'zh':leg.key}) %}
                <span class="fbm-leg hawk {{ 'on' if leg.active else '' }}"
                      data-tip-en="{{ leg.detail_en }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}"
                      data-tip-zh="{{ leg.detail_zh }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}">
                  <span class="fbm-dot"></span><span class="l-en">{{ _ll.en }}</span><span class="l-zh">{{ _ll.zh }}</span>
                </span>
                {% endif %}{% endfor %}
              </div>
            </div>
            <div class="fbm-beam-pan ease">
              <div class="fbm-beam-chips">
                {% for leg in _dlgrc_ep.legs %}{% if leg.key[:1] == 'E' %}
                {% set _ll = _fbm_leg_lbl.get(leg.key, {'en':leg.key,'zh':leg.key}) %}
                <span class="fbm-leg ease {{ 'on' if leg.active else '' }}"
                      data-tip-en="{{ leg.detail_en }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}"
                      data-tip-zh="{{ leg.detail_zh }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}">
                  <span class="fbm-dot"></span><span class="l-en">{{ _ll.en }}</span><span class="l-zh">{{ _ll.zh }}</span>
                </span>
                {% endif %}{% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="fbm-beam-verdict">
          <span class="l-en">Forces {{ _fbm_hawk }} vs {{ _fbm_ease }} — <span class="fbm-lean {{ _fbm_lean_cls }}">{{ _fbm_lean_word_en }}</span>. Filled chips are live now; hover any for its trigger.</span>
          <span class="l-zh">力量对比 {{ _fbm_hawk }} 对 {{ _fbm_ease }} — <span class="fbm-lean {{ _fbm_lean_cls }}">{{ _fbm_lean_word_zh }}</span>。实心因素为当前生效；悬停查看触发条件。</span>
        </div>
      </div>
      <div class="mx5-dlg-sep"></div>

      {# ── c. Rate Path — flagship chart (ports dlg-policy's plx idiom, full-width 640×230) ── #}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Rate Path — Market vs the Fed</span><span class="l-zh">利率路径 — 市场对比美联储</span></div>
      {% set _dlg_rpr = _dlgrc_rpr %}
      {% if _dlg_rpr %}
      {% set _fbc_impl = [_dlg_rpr.policy_rate, _dlg_rpr.implied_path.m1, _dlg_rpr.implied_path.m3, _dlg_rpr.implied_path.m6, _dlg_rpr.implied_path.m12] %}
      {% set _fbc_ok = (_fbc_impl[0] is not none and _fbc_impl[1] is not none and _fbc_impl[2] is not none and _fbc_impl[3] is not none and _fbc_impl[4] is not none) %}
      {% if _fbc_ok %}
      {# ── scale over implied ∪ Fed-dot medians, pad 0.15pp each side (same as plx) ── #}
      {% set _fbc_dots = (_dlg_rpr.dots if (_dlg_rpr.dots is defined and _dlg_rpr.dots) else []) %}
      {% set _fbc_allvals = _fbc_impl[:] %}
      {% for d in _fbc_dots %}{% if d.median is not none and _fbc_allvals.append(d.median) %}{% endif %}{% endfor %}
      {% set _fbc_ymin = (_fbc_allvals | min) - 0.15 %}
      {% set _fbc_ymax = (_fbc_allvals | max) + 0.15 %}
      {% set _fbc_yrange = (_fbc_ymax - _fbc_ymin) if (_fbc_ymax - _fbc_ymin) > 0.01 else 0.5 %}
      {# geometry: viewBox 0 0 640 230; x 54..586, y 30..176 (labels below) #}
      {% set _fbc_xl = 54 %}{% set _fbc_xr = 586 %}{% set _fbc_yt = 30 %}{% set _fbc_yb = 176 %}
      {% set _fbc_w = 532 %}{% set _fbc_h = 146 %}
      {% set _fbc_xs = [_fbc_xl, _fbc_xl + ((_fbc_w*0.25)|round(1)|float), _fbc_xl + ((_fbc_w*0.5)|round(1)|float), _fbc_xl + ((_fbc_w*0.75)|round(1)|float), _fbc_xr] %}
      {% macro fry(v) %}{{ (_fbc_yb - _fbc_h * (v - _fbc_ymin) / _fbc_yrange) | round(1) }}{% endmacro %}
      {% set _fbc_pts = [] %}
      {% for i in range(5) %}{% if _fbc_pts.append(_fbc_xs[i]|string ~ ',' ~ fry(_fbc_impl[i])) %}{% endif %}{% endfor %}
      {% set _fbc_area = 'M' ~ _fbc_pts[0] ~ ' L' ~ _fbc_pts[1] ~ ' L' ~ _fbc_pts[2] ~ ' L' ~ _fbc_pts[3] ~ ' L' ~ _fbc_pts[4] ~ ' L' ~ _fbc_xr|string ~ ',' ~ _fbc_yb|string ~ ' L' ~ _fbc_xl|string ~ ',' ~ _fbc_yb|string ~ ' Z' %}
      {# current-year Fed dot → sits in the 12m slot (end-year); outer years become chips #}
      {% set _fbc_cur_year = (latest.date[:4]|int) if (latest is defined and latest.date is defined and latest.date) else none %}
      {% set _fbc_dots_inner = [] %}{% set _fbc_dots_outer = [] %}
      {% for d in _fbc_dots %}{% if d.year is defined and _fbc_cur_year is not none and d.year == _fbc_cur_year %}{% if _fbc_dots_inner.append(d) %}{% endif %}{% else %}{% if _fbc_dots_outer.append(d) %}{% endif %}{% endif %}{% endfor %}
      <div class="fbm-chart-wrap">
        <svg class="fbm-chart-svg" viewBox="0 0 640 230" role="img" aria-label="Market-implied fed funds path versus the Fed projection">
          <defs>
            <linearGradient id="fbmChartGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--isle-policy)" stop-opacity=".2"/>
              <stop offset="100%" stop-color="var(--isle-policy)" stop-opacity="0"/>
            </linearGradient>
          </defs>
          {# area fill under implied path #}
          <path class="fbm-chart-area" d="{{ _fbc_area }}" fill="url(#fbmChartGrad)"/>
          {# dashed hairline at today's rate #}
          <line x1="{{ _fbc_xl }}" y1="{{ fry(_fbc_impl[0]) }}" x2="{{ _fbc_xr }}" y2="{{ fry(_fbc_impl[0]) }}" stroke="rgba(255,255,255,.15)" stroke-width="1" stroke-dasharray="4,4"/>
          {# implied path line (draw-in via dashoffset; --dash ≈ path length upper bound) #}
          <polyline class="fbm-chart-line" style="--dash:900" points="{{ _fbc_pts | join(' ') }}" fill="none" stroke="var(--isle-policy)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
          {# nodes + % value labels (bilingual is numeric-only here → no lang split needed) #}
          {% for i in range(5) %}
          {% set _px = _fbc_xs[i] %}{% set _py = fry(_fbc_impl[i]) | float %}
          <circle class="fbm-chart-node" cx="{{ _px }}" cy="{{ _py }}" r="4.5" fill="var(--isle-policy)" stroke="rgba(13,17,24,.85)" stroke-width="1.5"/>
          <text class="fbm-chart-node" x="{{ _px }}" y="{{ _py - 10 }}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--isle-policy)" font-family="Inter,-apple-system,sans-serif" font-variant-numeric="tabular-nums">{{ '%.2f'|format(_fbc_impl[i]) }}%</text>
          {% endfor %}
          {# Fed median diamond in the end-year slot #}
          {% for d in _fbc_dots_inner %}
          {% set _dpx = _fbc_xs[4] %}{% set _dpy = fry(d.median) | float %}
          <polygon class="fbm-chart-diamond" points="{{ _dpx }},{{ _dpy - 7 }} {{ _dpx + 7 }},{{ _dpy }} {{ _dpx }},{{ _dpy + 7 }} {{ _dpx - 7 }},{{ _dpy }}" fill="var(--warn,#f59e0b)" fill-opacity=".9" stroke="rgba(13,17,24,.7)" stroke-width="1"/>
          {% endfor %}
          {# x-axis labels — SEPARATE l-en / l-zh SVG text elements (svg-span-breakout law), NO M-codes #}
          {% set _fbc_xlabels_en = ['Now','1m','3m','6m','12m'] %}
          {% set _fbc_xlabels_zh = ['现在','1月','3月','6月','12月'] %}
          {% for i in range(5) %}
          <text class="l-en" x="{{ _fbc_xs[i] }}" y="204" text-anchor="middle" font-size="11" fill="rgba(255,255,255,.4)" font-family="Inter,-apple-system,sans-serif">{{ _fbc_xlabels_en[i] }}</text>
          <text class="l-zh" x="{{ _fbc_xs[i] }}" y="204" text-anchor="middle" font-size="11" fill="rgba(255,255,255,.4)" font-family="Inter,-apple-system,sans-serif">{{ _fbc_xlabels_zh[i] }}</text>
          {% endfor %}
        </svg>
        {# Fed-diamond key + outer-year dot chips #}
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:2px">
          {% if _fbc_dots_inner %}
          <span class="fbm-diamond-key">
            <svg width="11" height="11" viewBox="0 0 11 11"><polygon points="5.5,0 11,5.5 5.5,11 0,5.5" fill="var(--warn,#f59e0b)"/></svg>
            <span class="l-en">Fed median dot</span><span class="l-zh">美联储中位点</span>
          </span>
          {% endif %}
          {% for d in _fbc_dots_outer %}
          <span class="plx-dot-chip">
            <span class="l-en">'{{ (d.year|string)[2:] }} {{ '%.2f'|format(d.median) }}% (Fed)</span>
            <span class="l-zh">'{{ (d.year|string)[2:] }} {{ '%.2f'|format(d.median) }}%（美联储）</span>
          </span>
          {% endfor %}
        </div>
        {# ONE plain takeaway sentence #}
        <div class="fbm-chart-take">
          <span class="l-en">{{ _dlg_rpr.read_en if (_dlg_rpr.read_en is defined and _dlg_rpr.read_en) else (_dlg_rpr.headline_en if _dlg_rpr.headline_en is defined else 'Market-implied fed-funds path.') }}</span>
          <span class="l-zh">{{ _dlg_rpr.read_zh if (_dlg_rpr.read_zh is defined and _dlg_rpr.read_zh) else (_dlg_rpr.headline_zh if _dlg_rpr.headline_zh is defined else '市场隐含联邦基金利率路径。') }}</span>
        </div>
        {# delta callout chip — market vs Fed at the horizon #}
        {% if _dlg_rpr.gap is defined and _dlg_rpr.gap and _dlg_rpr.gap.gap_bp is not none and _dlg_rpr.gap.market is not none and _dlg_rpr.gap.fed_dot is not none %}
        {% set _fbc_gap = _dlg_rpr.gap %}
        <div style="margin-top:8px">
          <span class="fbm-gap-chip"
            data-tip-en="At {{ _fbc_gap.horizon_label }}: market prices {{ _fbc_gap.market }}%, the Fed projects {{ _fbc_gap.fed_dot }}%. Gap {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp — small means market and Fed agree on where rates land."
            data-tip-zh="{{ _fbc_gap.horizon_label }}：市场定价 {{ _fbc_gap.market }}%，美联储预测 {{ _fbc_gap.fed_dot }}%。差距 {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp — 差距小表示市场与美联储对终点利率看法一致。">
            <span class="l-en">{{ _fbc_gap.lean_en }} — {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp at {{ _fbc_gap.horizon_label }}</span>
            <span class="l-zh">{{ _fbc_gap.lean_zh }} — {{ _fbc_gap.horizon_label }} 相差 {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp</span>
          </span>
        </div>
        {% endif %}
      </div>
      {% endif %}{# /_fbc_ok #}
      {% endif %}{# /_dlg_rpr #}
      <div class="mx5-dlg-sep"></div>

      {# ── d. Inflation Read → glance row: state word + one plain line + ? receipt ── #}
      {# Guard: only render when core inflation values are present (fail-open path leaves them None). #}
      {% if _dlgrc_inf and _dlgrc_inf.core_pce_yoy is not none %}
      {% set _inf_vst = _dlgrc_inf.vs_target_pp %}
      {# Anchoring drives the state word + colour; the numbers are demoted to the ? tip. #}
      {% set _inf_anchor = _dlgrc_inf.anchoring %}
      {% set _inf_state_en = {'anchored':'Above target','drifting':'Drifting up','unanchored':'Unanchored'}.get(_inf_anchor, 'Above target') %}
      {% set _inf_state_zh = {'anchored':'高于目标','drifting':'向上漂移','unanchored':'脱锚'}.get(_inf_anchor, '高于目标') %}
      {% set _inf_col = 'var(--down,#ef4444)' if _inf_anchor == 'unanchored' else ('var(--warn,#f59e0b)' if (_inf_vst is not none and _inf_vst > 0.5) else 'var(--up,#22d97a)') %}
      {# Plain "how far above target" phrase #}
      {% set _inf_above_en = ((('%.1f'|format(_inf_vst)) ~ ' points above the Fed’s 2% target') if (_inf_vst is not none) else 'above the Fed’s 2% target') %}
      {% set _inf_above_zh = ((('高于美联储2%目标 ' ~ ('%.1f'|format(_inf_vst)) ~ ' 个百分点')) if (_inf_vst is not none) else '高于美联储2%目标') %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Inflation Read</span><span class="l-zh">通胀读数</span></div>
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _inf_col }}"><span class="fbm-row-dot" style="background:{{ _inf_col }}"></span><span class="l-en">{{ _inf_state_en }}</span><span class="l-zh">{{ _inf_state_zh }}</span></span>
        <span class="fbm-row-line"><span class="l-en">Core prices are still {{ _inf_above_en }}; longer-run expectations look {{ {'anchored':'steady','drifting':'a touch loose','unanchored':'unmoored'}.get(_inf_anchor,'steady') }}.</span><span class="l-zh">核心物价仍{{ _inf_above_zh }}；长期预期看起来{{ {'anchored':'稳定','drifting':'略松动','unanchored':'不稳'}.get(_inf_anchor,'稳定') }}。</span></span>
        <span class="fbm-tip"
          data-tip-en="Core PCE {{ _dlgrc_inf.core_pce_yoy }}% y/y · Core CPI {{ _dlgrc_inf.core_cpi_yoy }}% · 3-month annualized PCE {{ _dlgrc_inf.core_pce_3m_ann }}% · 10y breakeven {{ _dlgrc_inf.breakeven_10y }}% (expectations: {{ _inf_anchor }})."
          data-tip-zh="核心PCE {{ _dlgrc_inf.core_pce_yoy }}% 同比 · 核心CPI {{ _dlgrc_inf.core_cpi_yoy }}% · 3月年化PCE {{ _dlgrc_inf.core_pce_3m_ann }}% · 10年盈亏平衡 {{ _dlgrc_inf.breakeven_10y }}%（预期：{{ {'anchored':'稳定','drifting':'漂移','unanchored':'脱锚'}.get(_inf_anchor,_inf_anchor) }}）。">?</span>
      </div>
      {% if _dlgrc_inf.nearest_cpi is defined and _dlgrc_inf.nearest_cpi %}
      {% set _ncpi = _dlgrc_inf.nearest_cpi %}
      {% set _ncpi_sig = _ncpi.surprise_skew_sigma %}
      {% set _ncpi_col = 'var(--down,#ef4444)' if _ncpi.surprise_skew_tag == 'hotter' else ('var(--up,#22d97a)' if _ncpi.surprise_skew_tag == 'cooler' else 'var(--warn,#f59e0b)') %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _ncpi_col }}"><span class="fbm-row-dot" style="background:{{ _ncpi_col }}"></span><span class="l-en">Next CPI · {{ _ncpi.days_to }}d</span><span class="l-zh">下次CPI · {{ _ncpi.days_to }}天</span></span>
        <span class="fbm-row-line"><span class="l-en">Recent data leans {{ {'hotter':'hotter than forecast','cooler':'cooler than forecast','neutral':'in line'}.get(_ncpi.surprise_skew_tag,'in line') }} — a print either way can reset the read.</span><span class="l-zh">近期数据{{ {'hotter':'偏热于预期','cooler':'偏冷于预期','neutral':'大致符合'}.get(_ncpi.surprise_skew_tag,'大致符合') }} — 任一方向的数据都可能重置解读。</span></span>
        <span class="fbm-tip"
          data-tip-en="Release {{ _ncpi.release_date }} ({{ _ncpi.days_to }} days out). Surprise skew: {{ _ncpi.surprise_skew_tag }}{% if _ncpi_sig is not none %}, {{ '%.2f'|format(_ncpi_sig) }}σ{% endif %}."
          data-tip-zh="发布 {{ _ncpi.release_date }}（{{ _ncpi.days_to }} 天后）。惊喜偏向：{{ {'hotter':'偏热','cooler':'偏冷','neutral':'中性'}.get(_ncpi.surprise_skew_tag,_ncpi.surprise_skew_tag) }}{% if _ncpi_sig is not none %}，{{ '%.2f'|format(_ncpi_sig) }}σ{% endif %}。">?</span>
      </div>
      {% endif %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── e. Risk Indicators → glance rows; percentiles, model names, FRED IDs demoted to ? tips ── #}
      {# Guard: real_speed_pctile / term_premium_chg_bp are None on the fail-open (no yield_curve) path. #}
      {% if _dlgrc_risk and (_dlgrc_risk.real_speed_pctile is not none or _dlgrc_risk.curve_regime_label_en) %}
      {% set _rsp = _dlgrc_risk.real_speed_pctile %}
      {% set _tpc = _dlgrc_risk.term_premium_chg_bp %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Risk Indicators</span><span class="l-zh">风险指标</span></div>
      {% if _rsp is not none %}
      {# fast/moderate/slow band from percentile → plain word #}
      {% set _rsp_pct = (_rsp * 100) | round | int %}
      {% set _rsp_fast = _rsp_pct >= 67 %}
      {% set _rsp_col = 'var(--down,#ef4444)' if _rsp_fast else ('var(--warn,#f59e0b)' if _rsp_pct >= 34 else 'var(--up,#22d97a)') %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _rsp_col }}"><span class="fbm-row-dot" style="background:{{ _rsp_col }}"></span><span class="l-en">{{ 'Moving fast' if _rsp_fast else ('Moderate' if _rsp_pct >= 34 else 'Calm') }}</span><span class="l-zh">{{ '快速变动' if _rsp_fast else ('中等' if _rsp_pct >= 34 else '平稳') }}</span></span>
        <span class="fbm-row-line"><span class="l-en">Real rates are moving {{ 'faster than most of the past decade' if _rsp_fast else ('at a middling pace' if _rsp_pct >= 34 else 'slowly') }} — a heads-up on volatility, not a direction call.</span><span class="l-zh">实际利率变动{{ '快于过去十年多数时段' if _rsp_fast else ('速度中等' if _rsp_pct >= 34 else '缓慢') }} — 提示波动，非方向判断。</span></span>
        <span class="fbm-tip"
          data-tip-en="Real-rate speed sits in the {{ _rsp_pct }}th percentile of the past decade. {{ _dlgrc_risk.real_speed_note_en }}"
          data-tip-zh="实际利率波速处于过去十年第 {{ _rsp_pct }} 百分位。{{ _dlgrc_risk.real_speed_note_zh }}">?</span>
      </div>
      {% endif %}
      {% if _dlgrc_risk.curve_regime_label_en %}
      {% set _crv_col = 'var(--down,#ef4444)' if (_dlgrc_risk.term_premium_dir == 'rising') else 'var(--warn,#f59e0b)' %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _crv_col }}"><span class="fbm-row-dot" style="background:{{ _crv_col }}"></span><span class="l-en">{{ _dlgrc_risk.curve_regime_label_en }}</span><span class="l-zh">{{ _dlgrc_risk.curve_regime_label_zh }}</span></span>
        <span class="fbm-row-line"><span class="l-en">Long-end yields are {{ 'rising faster than the front' if _dlgrc_risk.term_premium_dir == 'rising' else ('falling' if _dlgrc_risk.term_premium_dir == 'falling' else 'holding') }} — driven by fiscal and risk-premium, not a growth call.</span><span class="l-zh">长端收益率{{ '上升快于短端' if _dlgrc_risk.term_premium_dir == 'rising' else ('下降' if _dlgrc_risk.term_premium_dir == 'falling' else '持稳') }} — 由财政与风险溢价驱动，非增长判断。</span></span>
        <span class="fbm-tip"
          data-tip-en="Curve shape: {{ _dlgrc_risk.curve_regime_label_en }}. Term premium {{ _dlgrc_risk.term_premium_dir }}{% if _tpc is not none %} ({{ '%+.0f'|format(_tpc) }}bp){% endif %}. {{ _dlgrc_risk.term_premium_note_en }}."
          data-tip-zh="曲线形态：{{ _dlgrc_risk.curve_regime_label_zh }}。期限溢价{{ {'rising':'上升','falling':'下降','flat':'平稳'}.get(_dlgrc_risk.term_premium_dir,_dlgrc_risk.term_premium_dir) }}{% if _tpc is not none %}（{{ '%+.0f'|format(_tpc) }}bp）{% endif %}。{{ _dlgrc_risk.term_premium_note_zh }}。">?</span>
      </div>
      {% endif %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── f. Policy Conditions → chip row (state · chair · comment cadence) ── #}
      {% if _dlgrc_pol %}
      {% set _dlg_pl_st = _dlgrc_pol.state %}
      {% set _pl_st_word_en = {'QUIET':'Quiet','ELEVATED':'Watch','ARMED':'Active'}.get(_dlg_pl_st, 'Watch') %}
      {% set _pl_st_word_zh = {'QUIET':'平静','ELEVATED':'警戒','ARMED':'已触发'}.get(_dlg_pl_st, '警戒') %}
      {% set _pl_st_cls = 'armed' if _dlg_pl_st in ('ARMED','ELEVATED') else '' %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Policy Conditions</span><span class="l-zh">政策条件</span></div>
      <div class="fbm-chips">
        <span class="fbm-chip {{ _pl_st_cls }}"
          data-tip-en="{{ _dlgrc_pl_map_en.get(_dlg_pl_st, 'Watch for changes.') }}"
          data-tip-zh="{{ _dlgrc_pl_map_zh.get(_dlg_pl_st, '留意变化。') }}">
          <span class="fbm-chip-k"><span class="l-en">Stance</span><span class="l-zh">立场</span></span>
          <span class="l-en">{{ _pl_st_word_en }}</span><span class="l-zh">{{ _pl_st_word_zh }}</span>
        </span>
        {% if _dlgrc_pol.chair is defined %}
        <span class="fbm-chip">
          <span class="fbm-chip-k"><span class="l-en">Chair</span><span class="l-zh">主席</span></span>
          <span>{{ _dlgrc_pol.chair }}</span>
        </span>
        {% endif %}
        {% if _dlgrc_pol.jawboning is defined and _dlgrc_pol.jawboning %}
        <span class="fbm-chip"
          data-tip-en="Fed officials made {{ _dlgrc_pol.jawboning.n_7d }} public comments in the last 7 days, {{ _dlgrc_pol.jawboning.n_30d }} in the last 30 — more talk often precedes a shift in guidance."
          data-tip-zh="美联储官员近7天公开发言 {{ _dlgrc_pol.jawboning.n_7d }} 次，近30天 {{ _dlgrc_pol.jawboning.n_30d }} 次 — 发声增多往往先于指引调整。">
          <span class="fbm-chip-k"><span class="l-en">Comments</span><span class="l-zh">发声</span></span>
          <span><span class="l-en">{{ _dlgrc_pol.jawboning.n_7d }} this week</span><span class="l-zh">本周 {{ _dlgrc_pol.jawboning.n_7d }} 次</span></span>
        </span>
        {% endif %}
        {% if _dlgrc_pol.intel_staleness_days is defined %}
        <span class="fbm-chip"
          data-tip-en="Policy intel is {{ _dlgrc_pol.intel_staleness_days }} days old (as of {{ _dlgrc_pol.intel_as_of if _dlgrc_pol.intel_as_of is defined else 'unknown' }})."
          data-tip-zh="政策情报为 {{ _dlgrc_pol.intel_staleness_days }} 天前（截至 {{ _dlgrc_pol.intel_as_of if _dlgrc_pol.intel_as_of is defined else '未知' }}）。">
          <span class="fbm-chip-k"><span class="l-en">Intel</span><span class="l-zh">情报</span></span>
          <span><span class="l-en">{{ _dlgrc_pol.intel_staleness_days }}d old</span><span class="l-zh">{{ _dlgrc_pol.intel_staleness_days }}天前</span></span>
        </span>
        {% endif %}
      </div>
      {# Iran/oil: unsigned qualitative display (PS-R4) — kept as one chip, full note on hover #}
      {% if _dlgrc_pol.iran_context is defined and _dlgrc_pol.iran_context %}
      {% set _iran = _dlgrc_pol.iran_context %}
      <div class="fbm-chips">
        <span class="fbm-chip warn"
          data-tip-en="{{ _iran.as_of_note_en if _iran.as_of_note_en is defined else '' }} — Conditions only, no direction or probability assigned."
          data-tip-zh="{{ _iran.as_of_note_zh if _iran.as_of_note_zh is defined else '' }} — 条件性观察，不赋予方向或概率。">
          <span class="fbm-chip-k"><span class="l-en">Geopolitics</span><span class="l-zh">地缘</span></span>
          <span><span class="l-en">{{ _iran.title_en }}</span><span class="l-zh">{{ _iran.title_zh }}</span></span>
        </span>
      </div>
      {% endif %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── g. What Changes This → direction-tinted glance rows; raw trigger receipt on hover ── #}
      {% if _dlgrc.conditions %}
      {# Plain direction word carries the meaning on Tier 1; the machine detail (sigma / raw
         slugs) lives in the ? tip so the glance line stays doctrine-clean. #}
      {% set _cond_word_en = {'hawkish':'Pushes rates up','easing':'Pulls rates down','geopolitical':'Wild card'} %}
      {% set _cond_word_zh = {'hawkish':'推高利率','easing':'拉低利率','geopolitical':'不确定因素'} %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">What Changes This</span><span class="l-zh">什么会改变现状</span></div>
      {% for cond in _dlgrc.conditions %}
      {% set _cond_col = 'var(--down,#ef4444)' if cond.direction == 'hawkish' else ('var(--up,#22d97a)' if cond.direction == 'easing' else 'var(--warn,#f59e0b)') %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _cond_col }}"><span class="fbm-row-dot" style="background:{{ _cond_col }}"></span><span class="l-en">{{ _cond_word_en.get(cond.direction,'Watch') }}</span><span class="l-zh">{{ _cond_word_zh.get(cond.direction,'留意') }}</span></span>
        <span class="fbm-row-line">
          {% if cond.watch_en is defined and cond.watch_en %}
          <span class="l-en">{{ cond.watch_en }}</span><span class="l-zh">{{ cond.watch_zh if (cond.watch_zh is defined and cond.watch_zh) else cond.watch_en }}</span>
          {% else %}
          <span class="l-en">{{ cond.en }}</span><span class="l-zh">{{ cond.zh }}</span>
          {% endif %}
        </span>
        <span class="fbm-tip"
          data-tip-en="{{ cond.en }}"
          data-tip-zh="{{ cond.zh }}">?</span>
      </div>
      {% endfor %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── h. Market-implied benchmark strip → unified fbm_bench_strip component ── #}
      {% set _dlg_fed_out_zh = {'No change':'按兵不动','Rate cut':'降息','Rate hike':'加息','25bps cut':'降息25bp','50bps cut':'降息50bp','25bps hike':'加息25bp','25 bps increase':'加息25bp','25 bps decrease':'降息25bp','50+ bps increase':'加息50bp以上','50+ bps decrease':'降息50bp以上'} %}
      {% if _dlgrc_mc and _dlgrc_mc.prediction_markets is defined and _dlgrc_mc.prediction_markets.events %}
      {% set _dlg_pm = _dlgrc_mc.prediction_markets %}
      {% set _fbm_bench_rows = [] %}
      {% for e in _dlg_pm.events %}
      {% if _fbm_bench_rows.append({'outcome_en': e.top_outcome, 'outcome_zh': _dlg_fed_out_zh.get(e.top_outcome, e.top_outcome), 'label_en': e.label_en, 'label_zh': e.label_zh, 'prob': e.top_prob, 'chg_pp': (e.chg_pp if e.chg_pp is defined else none)}) %}{% endif %}
      {% endfor %}
      {{ fbm_bench_strip(_fbm_bench_rows, (_dlg_pm.source if _dlg_pm.source is defined else 'Polymarket'), (_dlg_pm.as_of if _dlg_pm.as_of is defined else _dlgrc.asof)) }}
      {% if _dlgrc_mc.benchmark_note_en is defined %}
      <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));margin-top:6px;font-style:italic">
        <span class="l-en">{{ _dlgrc_mc.benchmark_note_en }}</span>
        <span class="l-zh">{{ _dlgrc_mc.benchmark_note_zh if _dlgrc_mc.benchmark_note_zh is defined else '' }}</span>
      </div>
      {% endif %}
      {% elif prediction_markets and prediction_markets.events %}
      {# Fallback: legacy prediction_markets module if rates_command.market_check.prediction_markets absent #}
      {% set _fbm_bench_rows = [] %}
      {% for e in prediction_markets.events[:4] %}
      {% set _top = (e.outcomes | sort(attribute='prob', reverse=true)) | first %}
      {% if _fbm_bench_rows.append({'outcome_en': _top.outcome, 'outcome_zh': _dlg_fed_out_zh.get(_top.outcome, _top.outcome), 'label_en': (e.label_en if e.label_en is defined else e.name), 'label_zh': (e.label_zh if e.label_zh is defined else (e.label_en if e.label_en is defined else e.name)), 'prob': _top.prob, 'chg_pp': (_top.chg_pp if _top.chg_pp is defined else none)}) %}{% endif %}
      {% endfor %}
      {{ fbm_bench_strip(_fbm_bench_rows, (prediction_markets.source if prediction_markets.source is defined else 'Polymarket'), none) }}
      {% endif %}

      {# ── i. Divergence flags ── #}
      {% if _dlgrc.divergence %}
      {% set _active_divs = _dlgrc.divergence | selectattr('active') | list %}
      {% if _active_divs %}
      <div class="mx5-dlg-sep"></div>
      <div class="mx5-dlg-eyebrow"><span class="l-en">Divergence Flags</span><span class="l-zh">背离信号</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px">
        {% for d in _active_divs %}
        <span style="font-size:11px;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);border-radius:4px;padding:3px 7px;color:var(--down,#ef4444)">
          <span class="l-en">{{ d.detail_en }}</span>
          <span class="l-zh">{{ d.detail_zh }}</span>
        </span>
        {% endfor %}
      </div>
      {% endif %}
      {% endif %}

      {# ── j. Single footer receipt — plain line on Tier 1, raw caveats on hover ── #}
      {% if _dlgrc.caveats %}
      {# Join the raw provenance/staleness caveats into ONE hover payload (Law 4: one footnote;
         Law 2: raw slugs like shock_state.json / policy/intel.json stay off Tier 1). #}
      {% set _fbm_cav_tip = _dlgrc.caveats | join(' · ') %}
      <div class="mx5-dlg-sep"></div>
      <div style="font-size:10.5px;color:var(--ink-3,rgba(255,255,255,.4));line-height:1.6;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
        <span class="l-en">As of {{ _dlgrc.asof }} — a read on conditions, not a forecast. Some inputs are display-only or a few days stale.</span>
        <span class="l-zh">截至 {{ _dlgrc.asof }} — 对条件的解读，非预测。部分输入仅供展示或略有滞后。</span>
        <span class="fbm-tip" data-tip-en="Data notes: {{ _fbm_cav_tip }}" data-tip-zh="数据说明：{{ _fbm_cav_tip }}" style="width:14px;height:14px;font-size:9px">?</span>
      </div>
      {% endif %}

      {% else %}
      {# rates_command absent — fall back to legacy Polymarket view #}
      {% if prediction_markets and prediction_markets.events %}
      {% for _fed_ev in prediction_markets.events %}
      {% set _fed_top = _fed_ev.outcomes | sort(attribute='prob',reverse=true) | first %}
      {# _fed_out_zh outcome→ZH map defined in dlg-events above #}
      <div style="margin-bottom:24px">
        <div class="mx5-dlg-eyebrow"><span class="l-en">{{ _fed_ev.label_en }}</span><span class="l-zh">{{ _fed_ev.label_zh }}</span></div>
        <div class="mx5-dlg-sep"></div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="font-size:28px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--mx5-accent,#22d97a);line-height:1">{{ _fed_top.prob | int }}<span style="font-size:14px;font-weight:500;color:var(--ink-2,rgba(255,255,255,.6))">%</span></div>
          <div>
            <div style="font-size:14px;font-weight:700"><span class="l-en">{{ _fed_top.outcome }}</span><span class="l-zh">{{ _fed_out_zh.get(_fed_top.outcome, _fed_top.outcome) if _fed_out_zh is defined else _fed_top.outcome }}</span></div>
            <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">market's top-probability outcome &middot; {{ _fed_ev.title }}</span><span class="l-zh">市场最高概率结果 &middot; {{ _fed_ev.title }}</span></div>
          </div>
        </div>
        {% set _fed_sorted_outs = _fed_ev.outcomes | sort(attribute='prob',reverse=true) %}
        {% for oc in _fed_sorted_outs %}
        {% set _ocp = oc.prob | float %}
        {% set _is_top2 = (oc.outcome == _fed_top.outcome) %}
        <div style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;margin-bottom:3px">
            <span style="font-size:12px;font-weight:{{ '700' if _is_top2 else '400' }};color:{{ 'var(--mx5-accent,#22d97a)' if _is_top2 else 'var(--ink-2,rgba(255,255,255,.6))' }}">
              <span class="l-en">{{ oc.outcome }}</span><span class="l-zh">{{ _fed_out_zh.get(oc.outcome, oc.outcome) if _fed_out_zh is defined else oc.outcome }}</span>
            </span>
            <span style="font-size:12px;font-variant-numeric:tabular-nums;font-weight:600;color:{{ 'var(--mx5-accent)' if _is_top2 else 'var(--ink-2,rgba(255,255,255,.6))' }}">{{ _ocp | int }}%</span>
          </div>
          <div style="height:5px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden">
            <div style="height:100%;width:{{ _ocp }}%;background:{{ 'var(--mx5-accent,#22d97a)' if _is_top2 else 'rgba(255,255,255,.22)' }};border-radius:3px;transition:width .4s"></div>
          </div>
        </div>
        {% endfor %}
        {% if prediction_markets.source is defined %}
        <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));text-align:right;margin-top:4px"><span class="l-en">Source: {{ prediction_markets.source }}</span><span class="l-zh">来源: {{ prediction_markets.source }}</span></div>
        {% endif %}
      </div>
      {% endfor %}
      {% else %}
      <div style="text-align:center;padding:40px 0;color:var(--ink-3,rgba(255,255,255,.36));font-size:13px">
        <span class="l-en">Fed path data is accruing — check back after the next nightly update.</span>
        <span class="l-zh">联储路径数据积累中 — 请在下次每晚更新后查看。</span>
      </div>
      {% endif %}
      {% endif %}
      </div>
    </div>
  </div>

  {# dlg-sentiment: Market Sentiment legs breakdown + dial #}
  <div class="mx5-dlg" id="dlg-sentiment" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Market Sentiment — Breakdown</span><span class="l-zh">市场情绪 — 详细分解</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {% set _dlg_fg = fear_greed if (fear_greed is defined and fear_greed) else {} %}
        {% set _dlg_fg_dial = (_dlg_fg.get('dial') or 50) | float %}
        {% set _dlg_fg_label_en = _dlg_fg.get('label_en') or 'Neutral' %}
        {% set _dlg_fg_label_zh = _dlg_fg.get('label_zh') or '中性' %}
        {% set _dlg_fg_col = '#22d97a' if _dlg_fg_dial > 60 else ('#ef4444' if _dlg_fg_dial < 40 else '#f59e0b') %}
        {# Hero: composite numeral + slim 0-100 zone track (Fear→Greed) #}
        <div class="{{ 'fg-greed' if _dlg_fg_dial > 60 else ('fg-fear' if _dlg_fg_dial < 40 else 'fg-neutral') }} sg-hero">
          <div class="sg-hero-num" style="color:var(--fg-col, {{ _dlg_fg_col }})">{{ _dlg_fg_dial | int }}</div>
          <div>
            <div class="sg-hero-band" style="color:var(--fg-col, {{ _dlg_fg_col }})"><span class="l-en">{{ _dlg_fg_label_en }}</span><span class="l-zh">{{ _dlg_fg_label_zh }}</span></div>
            <div class="sg-hero-sub"><span class="l-en">Composite of 11 market gauges — a mood read, not a signal.</span><span class="l-zh">11 项市场指标合成 — 情绪参考，非交易信号。</span></div>
          </div>
        </div>
        <div class="sg-track-wrap">
          <div class="sg-track">
            <span class="sg-track-tick" style="left:40%"></span>
            <span class="sg-track-tick" style="left:60%"></span>
          </div>
          <div class="sg-track-marker" style="--sg-pos:{{ _dlg_fg_dial | int }}%"></div>
          <div class="sg-track-axis"><span>0 · {{ t('Fear','恐慌') }}</span><span>{{ t('Neutral','中性') }}</span><span>{{ t('Greed','贪婪') }} · 100</span></div>
        </div>
        <div class="mx5-dlg-sep"></div>
        {# Composite legs — each row opens a hover popover (zone dial + plain
           explainer + receipt) via the shared [data-rpop]/.rp-src engine.
           Plain-word explainer pairs are TEMPLATE copy (Tier 2), keyed by leg.key. #}
        {% set _dlg_fg_legs = _dlg_fg.get('legs_included') or [] %}
        {% if _dlg_fg_legs %}
        {% set _sg_what = {
          'spx_momentum':   ['Is the S&P trading above its 6-month average?','标普是否高于其半年均价？'],
          'nh_nl_ratio':    ['Are more stocks hitting new highs than new lows?','创新高的股票是否多于创新低的？'],
          'mcclellan':      ['Are more stocks rising than falling, day to day?','每日上涨的股票是否多于下跌的？'],
          'hy_oas':         ['Will investors lend cheaply to risky companies?','投资者是否愿意低息借给高风险企业？'],
          'safe_haven':     ['Are people buying stocks over safe Treasuries?','资金更偏好股票还是避险国债？'],
          'vix_level':      ['How much price swing does the options market expect?','期权市场预期的波动幅度有多大？'],
          'vix_trend':      ['Is expected volatility rising or falling lately?','近期预期波动率在上升还是下降？'],
          'vix_term':       ['Do traders fear the near term more than later?','交易者更担心近期还是远期？'],
          'skew':           ['How much are traders paying to insure against a crash?','为防范暴跌，交易者付出多少保险成本？'],
          'naaim':          ['How heavily are active managers invested right now?','主动型基金经理目前仓位有多重？'],
          'insider':        ['Are company insiders net buyers of their own stock?','公司内部人是否净买入自家股票？'] } %}
        {% set _sg_now = {
          'spx_momentum':   ['Above trend — buyers still in control','高于趋势 — 买方仍占主导'],
          'nh_nl_ratio':    ['Highs and lows roughly balanced','新高与新低大致持平'],
          'mcclellan':      ['Slightly more falling than rising','下跌略多于上涨'],
          'hy_oas':         ['Very willing — no stress in credit','非常愿意 — 信用市场无压力'],
          'safe_haven':     ['Leaning to stocks, mildly','小幅偏向股票'],
          'vix_level':      ['Calm — swings priced as normal','平静 — 波动定价正常'],
          'vix_trend':      ['Ticking up — a little more nervous','小幅上行 — 略显紧张'],
          'vix_term':       ['Near term calmer than later — steady','近期比远期更平静 — 稳定'],
          'skew':           ['Paying up for crash protection — cautious','为暴跌保险多付成本 — 偏谨慎'],
          'naaim':          ['Heavily invested — leaning greedy','仓位偏重 — 略偏贪婪'],
          'insider':        ['Net sellers this quarter — cautious','本季净卖出 — 偏谨慎'] } %}
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:4px"><span class="l-en">What the composite measures</span><span class="l-zh">综合指数的构成</span></div>
        <div style="font-size:10.5px;color:var(--ink-3,rgba(255,255,255,.34));margin-bottom:10px"><span class="l-en">Hover any gauge for a plain read and its dial.</span><span class="l-zh">悬停任意指标查看白话解读与刻度盘。</span></div>
        {% for leg in _dlg_fg_legs %}
        {% set _lgp = (leg.pct or 50) | float %}
        {% set _lgcol = '#22d97a' if _lgp > 60 else ('#ef4444' if _lgp < 40 else '#f59e0b') %}
        {% set _lgk = leg.get('key') %}
        {% set _lg_what = _sg_what.get(_lgk) %}
        {% set _lg_now = _sg_now.get(_lgk) %}
        <div class="mx5-dlg-factor-row {{ 'fg-greed' if _lgp > 60 else ('fg-fear' if _lgp < 40 else 'fg-neutral') }}" style="--sg-c:{{ _lgcol }}" data-rpop tabindex="0" role="button" aria-label="{{ leg.name_en }} — sentiment gauge detail">
          <div>
            <div class="mx5-dlg-factor-name"><span class="l-en">{{ leg.name_en }}</span><span class="l-zh">{{ leg.name_zh or leg.name_en }}</span><span class="sg-hint" aria-hidden="true">i</span></div>
            <div class="mx5-dlg-factor-read" style="color:var(--fg-col, {{ _lgcol }})">
              {% if _lg_now %}<span class="l-en">{{ _lg_now[0] }}</span><span class="l-zh">{{ _lg_now[1] }}</span>
              {% else %}<span class="l-en">{{ 'Greed zone' if _lgp > 60 else ('Fear zone' if _lgp < 40 else 'Neutral') }}</span><span class="l-zh">{{ '贪婪区间' if _lgp > 60 else ('恐慌区间' if _lgp < 40 else '中性') }}</span>{% endif %}
            </div>
          </div>
          <div class="mx5-dlg-factor-bar"><div class="mx5-dlg-factor-fill" style="width:{{ _lgp }}%;background:var(--fg-col, {{ _lgcol }})"></div></div>
          <div class="mx5-dlg-factor-score" style="color:var(--fg-col, {{ _lgcol }})">{{ _lgp | int }}</div>
          {# — popover payload, cloned by theme.js row-pop engine on hover/focus — #}
          <span class="rp-src" hidden>
            <div class="row-pop-hd">
              <span class="row-pop-name"><span class="l-en">{{ leg.name_en }}</span><span class="l-zh">{{ leg.name_zh or leg.name_en }}</span></span>
              <span class="row-pop-tag {{ 'up' if _lgp > 60 else ('dn' if _lgp < 40 else 'warn') }}"><span class="l-en">{{ 'Greed' if _lgp > 60 else ('Fear' if _lgp < 40 else 'Neutral') }}</span><span class="l-zh">{{ '贪婪' if _lgp > 60 else ('恐慌' if _lgp < 40 else '中性') }}</span></span>
            </div>
            <div class="row-pop-div"></div>
            <div class="sg-pop-dialwrap">{{ sg_zone_dial(_lgp, _lgcol) }}</div>
            <div class="sg-pop-expl">
              {% if _lg_what %}
              <div class="sg-pe"><span class="sg-pe-lbl">{{ t('What it is','这是什么') }}</span><span class="sg-pe-txt"><span class="l-en">{{ _lg_what[0] }}</span><span class="l-zh">{{ _lg_what[1] }}</span></span></div>
              {% endif %}
              {% if _lg_now %}
              <div class="sg-pe"><span class="sg-pe-lbl">{{ t('Now','当前') }}</span><span class="sg-pe-txt"><span class="l-en">{{ _lg_now[0] }}</span><span class="l-zh">{{ _lg_now[1] }}</span></span></div>
              {% endif %}
            </div>
            {# graph slot — renders only if the engine ships per-leg history (absent today) #}
            {% set _lg_hist = leg.get('pct_hist') %}
            {% if _lg_hist and (_lg_hist|reject('none')|list|length) > 2 %}
            <div class="sg-pop-spark">
              <div class="sg-pop-spark-lbl">{{ t('Recent range','近期区间') }}</div>
              {{ sg_leg_spark(_lg_hist, _lgcol) }}
            </div>
            {% endif %}
            <div class="row-pop-ft">
              <span class="l-en">Reading: {{ leg.value if leg.get('value') is not none else '—' }} · {{ _lgp|int }}/100 in its own history</span>
              <span class="l-zh">读数：{{ leg.value if leg.get('value') is not none else '—' }} · 历史百分位 {{ _lgp|int }}/100</span>
            </div>
          </span>{# end .rp-src #}
        </div>
        {% endfor %}
        {% endif %}
        {# Young / excluded legs #}
        {% set _dlg_fg_young = _dlg_fg.get('legs_excluded_young') or [] %}
        {% if _dlg_fg_young %}
        <div class="mx5-dlg-sep"></div>
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.6">
          <span class="l-en">{{ _dlg_fg_young | length }} leg(s) are still collecting history and will join the composite once they have enough data: {% for y in _dlg_fg_young %}{{ y.name_en }}{{ ', ' if not loop.last }}{% endfor %}.</span>
          <span class="l-zh">{{ _dlg_fg_young | length }} 个分项仍在积累历史数据，待数据充足后将加入综合指数：{% for y in _dlg_fg_young %}{{ y.name_zh or y.name_en }}{{ '、' if not loop.last }}{% endfor %}。</span>
        </div>
        {% endif %}

        {# VSB W3: Volatility weather strip #}
        {% if vol_weather is defined and vol_weather %}
        {% set _vw_chips_all = vol_weather.get('chips') or [] %}
        {% set _vw_order = ['vix_level','vix_velocity','term_slope','vvix_vix','vix1d','cor1m','cor3m','dspx'] %}
        {% set _vw_map = {} %}
        {% for c in _vw_chips_all %}{% if _vw_map.update({c.get('key', ''): c}) %}{% endif %}{% endfor %}
        <div class="mx5-dlg-sep"></div>
        <div id="vsb-vol-weather-section" style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:10px">
          <span class="l-en">Volatility weather</span><span class="l-zh">波动率天气</span>
        </div>
        {% for key in _vw_order %}
        {% set _chip = _vw_map.get(key) %}
        {% if _chip %}
        {% set _chip_fresh = _chip.get('freshness') %}
        {% set _chip_pctile = _chip.get('pctile') %}
        {# weather tier from percentile: calm ≤35, breeze ≤60, gust ≤82, storm >82 #}
        {% set _wx_tier = (0 if _chip_pctile is none else (3 if _chip_pctile > 82 else (2 if _chip_pctile > 60 else (1 if _chip_pctile > 35 else 0)))) %}
        {% set _wx_col = ('var(--muted)' if _chip_fresh in ('young','missing') else ('var(--down,#ef4444)' if _wx_tier >= 3 else ('var(--warn,#f59e0b)' if _wx_tier == 2 else ('var(--info,#4d8ef5)' if _wx_tier == 1 else 'var(--up,#22c55e)')))) %}
        <div class="mx5-dlg-factor-row vsb-vw-row" data-vsb-chip="{{ key }}" style="--sg-wx-c:{{ _wx_col }}">
          <div class="sg-wx" aria-hidden="true">{{ sg_weather_glyph(_wx_tier) }}</div>
          <div>
            <div class="mx5-dlg-factor-name"><span class="l-en">{{ _chip.get('name_en') or key }}</span><span class="l-zh">{{ _chip.get('name_zh') or _chip.get('name_en') or key }}</span></div>
            {% if _chip_fresh in ('young', 'missing') %}
            <div class="mx5-dlg-factor-read"><span class="l-en">Still collecting — check back soon</span><span class="l-zh">仍在积累数据，稍后再看</span></div>
            {% else %}
            <div class="mx5-dlg-factor-read">
              <span class="l-en">{{ _chip.get('plain_en') or _chip.get('state') or '' }}{% if _chip_pctile is not none %} &middot; {% if _chip_pctile >= 50 %}higher than {{ _chip_pctile }}% of days{% else %}lower than {{ 100 - _chip_pctile }}% of days{% endif %}{% endif %}</span>
              <span class="l-zh">{{ _chip.get('plain_zh') or _chip.get('state') or '' }}{% if _chip_pctile is not none %} &middot; {% if _chip_pctile >= 50 %}高于历史 {{ _chip_pctile }}% 的交易日{% else %}低于历史 {{ 100 - _chip_pctile }}% 的交易日{% endif %}{% endif %}</span>
            </div>
            {% endif %}
          </div>
          <div class="sg-pos-wrap">
            {% if _chip_pctile is not none and _chip_fresh not in ('young','missing') %}
            <div class="sg-pos"><span class="sg-pos-mark" style="--sg-pp:{{ _chip_pctile }}%"></span></div>
            <div class="sg-pos-axis"><span>{{ t('Low','低') }}</span><span>{{ t('High','高') }}</span></div>
            {% endif %}
          </div>
          <div style="font-size:13px;font-weight:700;text-align:right;font-variant-numeric:tabular-nums;color:var(--ink-2,rgba(255,255,255,.7))">
            {% if _chip_fresh in ('young', 'missing') %}
            <span style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))">—</span>
            {% else %}
            {{ _chip.get('value') if _chip.get('value') is not none else '—' }}
            {% endif %}
          </div>
        </div>
        {% endif %}
        {% endfor %}
        {% endif %}

        {# VSB W4: AI names vs the rest #}
        {% if breadth_split is defined and breadth_split %}
        {% set _bs = breadth_split %}
        {% set _bs_lat = _bs.get('latest') or {} %}
        {% set _bs_cs = _bs.get('cohort_sizes') or {} %}
        <div class="mx5-dlg-sep"></div>
        <div id="vsb-breadth-split-section" style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:10px">
          <span class="l-en">AI names vs the rest</span><span class="l-zh">AI 相关个股 vs 其他</span>
        </div>
        {# Stance line #}
        {% if _bs.get('stance_en') %}
        <div style="font-size:13px;font-weight:600;margin-bottom:10px;color:var(--ink-1,rgba(255,255,255,.85))">
          <span class="l-en">{{ _bs.stance_en }}</span><span class="l-zh">{{ _bs.get('stance_zh') or _bs.stance_en }}</span>
        </div>
        {% endif %}
        {# Two-cohort split visual — proportional animated bars + delta chip.
           data-vsb-bs attrs + the two label strings are pinned by tests. #}
        {% set _bs_ai50 = _bs_lat.get('ai_pct50') %}
        {% set _bs_nonai50 = _bs_lat.get('nonai_pct50') %}
        {% set _bs_delta = (_bs_ai50 - _bs_nonai50) if (_bs_ai50 is not none and _bs_nonai50 is not none) else none %}
        <div class="sg-split">
          {% if _bs_ai50 is not none %}
          <div class="sg-split-row" data-vsb-bs="ai">
            <span class="sg-split-lbl"><span class="l-en">AI-linked names above their 50-day trend</span><span class="l-zh">AI 相关个股站上 50 日均线</span></span>
            <span class="sg-split-track"><span class="sg-split-fill ai" style="width:{{ _bs_ai50 | round(0) | int }}%"></span></span>
            <span class="sg-split-val">{{ _bs_ai50 | round(0) | int }}%</span>
          </div>
          {% endif %}
          {% if _bs_nonai50 is not none %}
          <div class="sg-split-row" data-vsb-bs="nonai">
            <span class="sg-split-lbl"><span class="l-en">Everyone else</span><span class="l-zh">其他个股</span></span>
            <span class="sg-split-track"><span class="sg-split-fill non" style="width:{{ _bs_nonai50 | round(0) | int }}%"></span></span>
            <span class="sg-split-val">{{ _bs_nonai50 | round(0) | int }}%</span>
          </div>
          {% endif %}
        </div>
        {% if _bs_delta is not none %}
        <div class="sg-split-delta">
          <span class="l-en">{{ _bs_delta | abs | round(0) | int }} pts {{ 'wider for AI' if _bs_delta >= 0 else 'wider for the rest' }}</span>
          <span class="l-zh">{{ _bs_delta | abs | round(0) | int }} 个百分点差距，{{ 'AI 领先' if _bs_delta >= 0 else '其他领先' }}</span>
        </div>
        {% endif %}
        {# Cohort size note #}
        {% set _bs_ai_n = _bs_cs.get('ai_total') %}
        {% set _bs_univ = _bs_cs.get('universe') %}
        {% if _bs_ai_n is not none and _bs_univ is not none %}
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:8px;line-height:1.5">
          <span class="l-en">{{ _bs_ai_n }} AI-linked names out of {{ _bs_univ }} tracked</span>
          <span class="l-zh">{{ _bs_univ }} 只跟踪个股中有 {{ _bs_ai_n }} 只 AI 相关</span>
        </div>
        {% endif %}
        {# Young note #}
        {% if _bs.get('young') %}
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:4px">
          <span class="l-en">Still building history — readings will stabilise over time.</span>
          <span class="l-zh">历史数据仍在积累，读数将随时间趋于稳定。</span>
        </div>
        {% endif %}
        {# Static circularity-watch note #}
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:8px;line-height:1.5;border-top:1px solid rgba(255,255,255,.06);padding-top:8px">
          <span class="l-en">Watch: the AI buildout recycles capital among related names. If stocks start moving together again, the calm can break quickly — watch, don't chase.</span>
          <span class="l-zh">注意：AI 基础设施建设在相关个股间循环资金。若股票重新同步波动，表面平静可能迅速打破，保持观察而非追高。</span>
        </div>
        {% endif %}

        {# ── ONE dialog footer: merged disclaimer + single as-of (Wave B section-j) ── #}
        {% set _sg_asof = _dlg_fg.get('as_of') or (vol_weather.as_of if (vol_weather is defined and vol_weather) else none) or (breadth_split.as_of if (breadth_split is defined and breadth_split) else none) %}
        {% if _dlg_fg.get('disclaimer_en') or _sg_asof %}
        <div class="mx5-dlg-sep"></div>
        <div class="sg-foot">
          {% if _dlg_fg.get('disclaimer_en') %}
          <span><span class="l-en">{{ _dlg_fg.disclaimer_en }}</span><span class="l-zh">{{ _dlg_fg.get('disclaimer_zh') or _dlg_fg.disclaimer_en }}</span></span>
          {% endif %}
          {% if _sg_asof %}
          <span class="sg-foot-asof" style="margin-left:auto"><span class="l-en">As of {{ _sg_asof }}</span><span class="l-zh">数据日期 {{ _sg_asof }}</span></span>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# dlg-sector: Full sector heat detail #}
  {# One rung of the rotation ladder: badge + name/rank + 5-day rank-move trace + delta. #}
  {% macro _sct_rung(s) %}
  {%- set _d = (s.get('rank_delta_5d')|int) if (s.get('rank_delta_5d') is not none) else 0 -%}
  {%- set _dc = 'var(--up,#22d97a)' if _d > 0 else ('var(--down,#ef4444)' if _d < 0 else 'var(--ink-3,rgba(255,255,255,.42))') -%}
  {%- set _dcl = [[_d, 28]|min, -28]|max -%}
  {%- set _h = (_dcl / 28.0 * 9.0) -%}
  {%- set _stance = s.get('label') or s.get('reco') -%}
  <div class="sct-rung" style="--sct-c:{{ _dc }}">
    <span class="sct-badge">
      {%- if _d > 0 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V6M6 12l6-6 6 6"/></svg>
      {%- elif _d < 0 -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v13M6 12l6 6 6-6"/></svg>
      {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12"/></svg>{%- endif -%}
    </span>
    <div class="sct-body">
      <div class="sct-name"><span class="l-en">{{ s.get('name','') }}</span><span class="l-zh">{{ s.get('name_zh') or s.get('name','') }}</span></div>
      <div class="sct-sub">
        {% if s.get('rank') is not none %}<span class="sct-rk">#{{ s.get('rank') }}</span>{% endif %}
        {% if _stance %}<span class="sct-stance"><span class="l-en">{{ _stance }}</span><span class="l-zh">{{ _stance }}</span></span>{% endif %}
      </div>
    </div>
    <svg class="sct-trace" viewBox="0 0 132 30" fill="none" aria-hidden="true">
      <line class="sct-base" x1="8" y1="15" x2="124" y2="15"/>
      <path class="sct-ln" d="M8 {{ '%.1f'|format(15 + _h) }} L124 {{ '%.1f'|format(15 - _h) }}"/>
      <circle class="sct-dot-old" cx="8" cy="{{ '%.1f'|format(15 + _h) }}" r="2.4"/>
      <circle class="sct-dot-now" cx="124" cy="{{ '%.1f'|format(15 - _h) }}" r="3.4"/>
    </svg>
    <div class="sct-delta">
      <span class="sct-delta-v">{{ '+' if _d > 0 }}{{ _d }}</span>
      <span class="sct-delta-k"><span class="l-en">vs 5d</span><span class="l-zh">对比5日</span></span>
    </div>
  </div>
  {% endmacro %}

  <div class="mx5-dlg" id="dlg-sector" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Sector Temperature — Full Detail</span><span class="l-zh">板块温度 — 完整详情</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {% if sector_heat %}
        {% set _dlg_sh_hot = sector_heat.get('heating') or [] %}
        {% set _dlg_sh_cold = sector_heat.get('cooling') or [] %}
        <div style="margin:-2px 0 16px;font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));line-height:1.5">
          <span class="l-en">Where money is rotating over the last week. Each trace is a sector&rsquo;s 5-day move up or down the rankings.</span>
          <span class="l-zh">过去一周资金的轮动方向。每条轨迹为该板块 5 日内的排名升降。</span>
        </div>
        {# Leading lane — rotating in #}
        {% if _dlg_sh_hot %}
        <div class="sct-lane lead">
          <div class="sct-lane-head">
            <span class="sct-lane-dot"></span>
            <span class="l-en">Rotating in &mdash; leading</span><span class="l-zh">资金流入 — 领跑</span>
            <span class="sct-lane-n">{{ _dlg_sh_hot|length }}<span class="l-en"> sectors</span><span class="l-zh"> 个板块</span></span>
          </div>
          {% for s in _dlg_sh_hot %}{{ _sct_rung(s) }}{% endfor %}
        </div>
        {% endif %}
        {# Lagging lane — losing momentum #}
        {% if _dlg_sh_cold %}
        <div class="sct-lane lag">
          <div class="sct-lane-head">
            <span class="sct-lane-dot"></span>
            <span class="l-en">Losing momentum &mdash; lagging</span><span class="l-zh">动能减弱 — 落后</span>
            <span class="sct-lane-n">{{ _dlg_sh_cold|length }}<span class="l-en"> sectors</span><span class="l-zh"> 个板块</span></span>
          </div>
          {% for s in _dlg_sh_cold %}{{ _sct_rung(s) }}{% endfor %}
        </div>
        {% endif %}
        {# What to watch #}
        <div class="mx5-dlg-sep"></div>
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.6">
          <span class="l-en">Rankings update nightly and reflect relative strength, not an absolute call. A rising trace means a sector is climbing the pack; a falling one, slipping. Watch — don&rsquo;t chase a single week&rsquo;s move.</span>
          <span class="l-zh">排名每晚更新，反映相对强弱而非绝对判断。轨迹向上表示板块排名上升，向下则为下滑。观望为主，勿追单周变动。</span>
        </div>
        {% if sector_heat.get('as_of') %}
        <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));text-align:right;margin-top:6px"><span class="l-en">As of {{ sector_heat.as_of }}</span><span class="l-zh">数据日期 {{ sector_heat.as_of }}</span></div>
        {% endif %}
        {% else %}
        <div style="text-align:center;padding:40px 0;color:var(--ink-3,rgba(255,255,255,.36));font-size:13px">
          <span class="l-en">Sector data is accruing from the nightly pulse engine.</span>
          <span class="l-zh">板块数据从每晚脉冲引擎积累中。</span>
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% endif %}{# /mode != stocks — dialogs #}

  {% endif %}{# /mode != stocks #}

  {# v5.1: view-hint footer removed — grid is the permanent view #}

  </div>{# /panel span12 #}

  {# ── mx5OpenDlg dialog system (v5.1) — macro mode only ── #}
  <script>
  (function(){
    /* Aurora @property polyfill */
    if(CSS && CSS.registerProperty){
      try{ CSS.registerProperty({name:'--isle-aurora-angle',syntax:'<angle>',inherits:false,initialValue:'0deg'}); }catch(e){}
    }

    /* ── mx5OpenDlg / mx5CloseDlg ─────────────────────────────────
       Centered glass dialog (≥701px) / bottom sheet (≤700px).
       focus-trap: Tab cycles within dialog; focus restores on close.
       body scroll lock while open; aria-modal; reduced-motion aware.
    ─────────────────────────────────────────────────────────────── */
    var _dlgActive = null;
    var _dlgTrigger = null;
    var _dlgScrollY = 0;   /* page scroll captured at first dialog open (M03 scroll lock) */

    /* Release the document scroll lock and restore the saved scroll position.
       Idempotent — safe to call even if no dialog locked the page. */
    function _dlgReleaseScroll(){
      if(!document.documentElement.classList.contains('mx5-dlg-lock')) return;
      document.documentElement.classList.remove('mx5-dlg-lock');
      document.body.style.top = '';
      window.scrollTo(0, _dlgScrollY);
    }

    function _focusFirst(dlg){
      var focusable = dlg.querySelectorAll('button,a[href],[tabindex]:not([tabindex="-1"])');
      if(focusable.length) focusable[0].focus();
    }

    function _trapTab(dlg, e){
      if(e.key !== 'Tab') return;
      var focusable = Array.prototype.slice.call(
        dlg.querySelectorAll('button:not([disabled]),a[href],[tabindex]:not([tabindex="-1"])'));
      if(!focusable.length) return;
      var first = focusable[0], last = focusable[focusable.length-1];
      if(e.shiftKey){ if(document.activeElement===first){ e.preventDefault(); last.focus(); } }
      else { if(document.activeElement===last){ e.preventDefault(); first.focus(); } }
    }

    function _prefReduced(){
      return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches);
    }
    /* Immediate teardown (no animation) — used when switching dialogs or as fallback. */
    function _dlgTeardown(dlg, restoreFocus){
      dlg.classList.remove('open','mx5-dlg-in','mx5-dlg-closing');
      dlg.removeAttribute('aria-modal');
      if(dlg._trapHandler){ dlg.removeEventListener('keydown', dlg._trapHandler); delete dlg._trapHandler; }
      var bd = dlg.querySelector('.mx5-dlg-backdrop');
      if(bd && bd._clickH){ bd.removeEventListener('click', bd._clickH); delete bd._clickH; }
      if(dlg._closeTimer){ clearTimeout(dlg._closeTimer); delete dlg._closeTimer; }
      if(dlg._endH){ var pnl0=dlg.querySelector('.mx5-dlg-panel'); if(pnl0) pnl0.removeEventListener('transitionend', dlg._endH); delete dlg._endH; }
      if(restoreFocus && _dlgTrigger && typeof _dlgTrigger.focus === 'function') _dlgTrigger.focus();
    }

    window.mx5OpenDlg = function(id){
      /* macro.html is publicly readable, but the detailed card dialogs are the
         registration benefit. The shared preview controller resolves signed-in
         tiers; until it does, fail toward the non-destructive sign-in sheet. */
      if(document.body && document.body.classList.contains('page-macro') &&
         (!window.MMXAccessPreview || window.MMXAccessPreview.isAnon())){
        if(window.MMXAccessPreview) window.MMXAccessPreview.openSignin();
        else if(window.MMOnboard && window.MMOnboard.open) window.MMOnboard.open('signin', {});
        else location.href='/?signin=1&ret=/macro.html';
        return;
      }
      /* Close any open scorecard popovers first */
      if(window.mx5CloseAllPopovers) window.mx5CloseAllPopovers();
      /* Switching dialogs: tear the previous one down instantly (no lingering animation). */
      if(_dlgActive){ _dlgTeardown(_dlgActive, false); _dlgActive = null; }
      var dlg = document.getElementById(id);
      if(!dlg) return;
      /* Heatmap adoption: on first open of dlg-markets, move #heatmap-scorecard into the
         dialog placeholder so it renders at 920px dialog scale (idempotent). */
      if(id === 'dlg-markets'){
        var hmSrc = document.getElementById('heatmap-scorecard');
        var hmDst = document.getElementById('dlg-heatmap-scorecard');
        if(hmSrc && hmDst && hmDst !== hmSrc.parentNode){
          hmDst.appendChild(hmSrc);
          var stage = document.querySelector('.mx5-hm-stage');
          if(stage && stage.parentNode) stage.parentNode.removeChild(stage);
          window.dispatchEvent(new Event('resize'));
        }
      }
      _dlgTrigger = document.activeElement;
      _dlgActive = dlg;
      dlg.classList.remove('mx5-dlg-closing');
      /* 1) make it displayed (start state painted) */
      dlg.classList.add('open');
      dlg.setAttribute('aria-modal','true');
      /* This heatmap exists only inside the hidden Markets dialog. Fetch its
         134 KB renderer after the dialog is visible instead of taxing every
         cold dashboard visit. */
      if(id === 'dlg-markets' && window.mmLoadHeatmap){
        window.mmLoadHeatmap().catch(function(){ /* full-page link remains */ });
      }
      /* Scroll lock (M03): lock the real scroller (<html>) and freeze <body> at the
         current scrollY so wheel/trackpad/arrow scrolling can't leak to the page
         behind the modal. Capture only on first open (switching dialogs is a no-op). */
      if(!document.documentElement.classList.contains('mx5-dlg-lock')){
        _dlgScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
        document.body.style.top = (-_dlgScrollY) + 'px';
        document.documentElement.classList.add('mx5-dlg-lock');
      }
      document.body.classList.add('mx5-dlg-open');
      /* 2) next frame(s): add .mx5-dlg-in so opacity/transform transitions actually run.
         Double rAF guarantees the start state is committed before the class flips. */
      if(_prefReduced()){
        dlg.classList.add('mx5-dlg-in');
      } else {
        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          if(_dlgActive === dlg) dlg.classList.add('mx5-dlg-in');
        }); });
      }
      _focusFirst(dlg);
      dlg._trapHandler = function(e){ _trapTab(dlg, e); };
      dlg.addEventListener('keydown', dlg._trapHandler);
      /* backdrop click */
      var bd = dlg.querySelector('.mx5-dlg-backdrop');
      if(bd){ bd._clickH = function(){ window.mx5CloseDlg(); }; bd.addEventListener('click', bd._clickH); }
    };

    window.mx5CloseDlg = function(){
      if(!_dlgActive) return;
      var dlg = _dlgActive;
      _dlgActive = null;               /* free the slot immediately so re-entrancy is safe */
      document.body.classList.remove('mx5-dlg-open');
      _dlgReleaseScroll();
      dlg.removeAttribute('aria-modal');
      if(dlg._trapHandler){ dlg.removeEventListener('keydown', dlg._trapHandler); delete dlg._trapHandler; }
      var bd = dlg.querySelector('.mx5-dlg-backdrop');
      if(bd && bd._clickH){ bd.removeEventListener('click', bd._clickH); delete bd._clickH; }
      var trig = _dlgTrigger; _dlgTrigger = null;
      var refocus = function(){ if(trig && typeof trig.focus === 'function') trig.focus(); };
      if(_prefReduced()){
        _dlgTeardown(dlg, false); refocus(); return;
      }
      /* 3) reverse the entrance: remove .mx5-dlg-in, add .mx5-dlg-closing (faster),
         wait for the panel's transitionend, THEN remove .open (hide). Timeout fallback
         so a missed transitionend never leaves the dialog stuck visible. */
      dlg.classList.add('mx5-dlg-closing');
      dlg.classList.remove('mx5-dlg-in');
      var pnl = dlg.querySelector('.mx5-dlg-panel');
      var done = function(){
        if(dlg._closeTimer){ clearTimeout(dlg._closeTimer); delete dlg._closeTimer; }
        if(dlg._endH && pnl){ pnl.removeEventListener('transitionend', dlg._endH); delete dlg._endH; }
        dlg.classList.remove('open','mx5-dlg-closing');
        refocus();
      };
      dlg._endH = function(e){ if(e.target === pnl && (e.propertyName === 'transform' || e.propertyName === 'opacity')) done(); };
      if(pnl) pnl.addEventListener('transitionend', dlg._endH);
      dlg._closeTimer = setTimeout(done, 340);
    };

    /* Escape handler: dialog > scorecard popover > release radar modal guards */
    document.addEventListener('keydown', function(e){
      if(e.key !== 'Escape') return;
      /* INT-01: guard release-radar modal/overlay open states. The RR detail modal
         opens on top of dlg-events (from the inline panel); its own Escape handler
         closes it first, so we must not also close the dialog underneath. */
      var overlay = document.getElementById('rr-modal-overlay');
      if(overlay && overlay.classList.contains('open')) return;
      var trOverlay = document.querySelector('.rr-tr-overlay');
      if(trOverlay && trOverlay.classList.contains('is-open')) return;
      if(_dlgActive){ e.stopImmediatePropagation(); window.mx5CloseDlg(); return; }
    }, true /* capture — runs before the popover handler which uses bubble */);

    /* ── Alert deep-link resolution ─────────────────────────────
       Landing-hub / alerts-board / notification links arrive as
       macro.html#<anchor> (engine/alerts.alert_href). A dlg-* hash
       opens the owning dialog. Legacy pre-v5 anchors still baked in
       older rendered feeds (the hub regenerates nightly) resolve to
       their v5 homes: same-page → open/scroll, other-page → replace. */
    var _legacyAnchor = {
      'risk-state':'dlg-risk', 'liquidity':'dlg-risk', 'credit':'dlg-risk',
      'dials':'regime-radar', 'sectors':'dlg-sector',
      'positioning':'macro_context.html#board',
      'holdings':'us_stocks.html#holdings',
      'accumulation':'us_stocks.html#accumulation'
    };
    function _resolveAlertHash(){
      var h = (location.hash || '').slice(1);
      if(!h) return;
      var legacy = false;
      if(_legacyAnchor[h]){
        var tgt = _legacyAnchor[h];
        if(tgt.indexOf('.html') !== -1){ location.replace(tgt); return; }
        h = tgt; legacy = true;
      }
      var el = document.getElementById(h);
      if(!el) return;
      if(el.classList.contains('mx5-dlg')){ window.mx5OpenDlg(h); }
      else if(legacy){ el.scrollIntoView(); }
    }
    _resolveAlertHash();
    window.addEventListener('hashchange', _resolveAlertHash);

  })();
  </script>
  {% endif %}{# /if mode != 'stocks' #}



  {# ===================== POLICY-LEVER ARMED/QUIET CARD (Policy-Shock W2-F) =====================
     Display-only conditions context — not a signal, not a forecast.
     PS-R1: card copy never reads or attributes intent; the canonical framing line
     ("not intent, not timing") is the REQUIRED disclaimer and is exempt (PS-A3).
     PS-R3: reads policy_lever.json (site artifact); never feeds scoring.
     PS-R4: no probabilities anywhere in this block.
     Jinja missing-key gotcha guard: every nested access uses the 'defined' test or
     dict.get() notation ('d.key is defined') before accessing — NEVER 'if d.key is not none'
     on a potentially MISSING key (crashes with UndefinedError).
     Stage-B: macro mode uses the policy tray (sx-policy-v2) above; this standalone
     card is kept for stocks mode only.
  #}
  {# Fallback policy-lever-card: renders in NON-macro mode, OR in macro mode only when market_state is absent
     (v2 sx-policy tray handles it when market_state is present). CI test (test_policy_lever.py) uses
     market_state=None fixture so this fallback must be reachable in macro mode. #}
  {% if (mode != 'macro' or not market_state) and policy_lever is defined and policy_lever %}
  {% set PL = policy_lever %}
  {% set _pl_state = PL.get('state') or 'QUIET' %}
  {% set _pl_state_color = 'var(--down)' if _pl_state == 'ARMED' else ('var(--orange)' if _pl_state == 'ELEVATED' else 'var(--muted)') %}
  {# MX POLICY BAND — 3-col layout: col1=Policy Lever state+rows, col2=lever details (repricing-style), col3=flip confirmation summary.
     id="policy-lever-card" is preserved here for deep-link + CI test (tests/test_policy_lever.py checks string presence). #}
  <div class="panel span12" id="policy-lever-card">
    <div class="mx-eyebrow">{{ t('Policy-Lever Conditions & Repricing','政策杠杆条件与重新定价') }}
      {{ help("Conditions that make violent overnight reversals more likely — not a forecast, not a signal. ARMED = semis drawdown deep (≤−15%) AND an oil technical curl; ELEVATED = one of the two; QUIET = neither. Display-only context (Policy-Shock W2-F). Drawdown and arming are descriptive; no probabilities.", "使剧烈隔夜反转更可能发生的条件 — 不是预测，不是信号。触发=半导体回撤深（≤−15%）且石油技术卷曲；警戒=两者之一；平静=均无。仅供展示（政策冲击 W2-F）。回撤和触发均为描述性指标，不含概率。") }}
    </div>
    <div class="mx-policy-band">

      {# COL 1 — Policy-Lever state chip + key rows #}
      <div class="mx-pcol">
        <div class="mx-pcol-label">{{ t('Policy Lever','政策杠杆') }}</div>
        <div class="mx-pcol-state">
          <span class="mx-chip {{ 'mx-c-down' if _pl_state == 'ARMED' else ('mx-c-warn' if _pl_state == 'ELEVATED' else 'mx-c-muted') }}" style="font-size:13px;padding:4px 12px">
            <span class="l-en">{{ _pl_state }}</span><span class="l-zh">{{ {'ARMED':'已触发','ELEVATED':'警戒','QUIET':'平静'}.get(_pl_state, _pl_state) }}</span>
          </span>
        </div>
        {# Favored complex drawdown as first labeled row #}
        {% if PL.get('favored_complex') is defined %}
        {% set _FC = PL.get('favored_complex') or {} %}
        {% if _FC.get('drawdown_pct') is not none %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Favored complex','偏好板块') }}</span>
          <span class="mx-delta-chip {{ 'mx-delta-dn' if _FC.drawdown_pct <= -15 else 'mx-delta-mu' }}">
            {{ _FC.get('basket', [])|join('/') }} {{ '%+.1f'|format(_FC.drawdown_pct) }}%
          </span>
        </div>
        {% endif %}
        {% if _FC.get('basket_caveat') %}
        <div class="mx-pcol-sub" style="color:var(--warn)"><span class="l-en">{{ _FC.basket_caveat }}</span><span class="l-zh">{{ _FC.get('basket_caveat_zh') or _FC.basket_caveat }}</span></div>
        {% endif %}
        {% endif %}
        {# Jawboning row #}
        {% if PL.get('jawboning') is defined %}
        {% set _JW = PL.get('jawboning') or {} %}
        {% if _JW.get('n_7d') is not none %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Jawboning 7d/30d','政策发声 7日/30日') }}</span>
          <span class="mx-delta-chip mx-delta-mu">{{ _JW.n_7d }} / {{ _JW.n_30d }}</span>
        </div>
        {% endif %}
        {% if _JW.get('last_alert_summary') %}
        <div class="mx-pcol-sub"><span class="l-en">{{ _JW.get('last_alert_summary') or '' }}</span><span class="l-zh">{{ _JW.get('last_alert_summary_zh') or _JW.get('last_alert_summary') or '' }}</span></div>
        {% endif %}
        {% endif %}
        {# Calendar note #}
        {% if PL.get('calendar') is defined %}
        {% set _CAL = PL.get('calendar') or {} %}
        {% if _CAL.get('context_note') %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key" style="font-size:10.5px"><span class="l-en">{{ _CAL.get('context_note') or '' }}</span><span class="l-zh">{{ _CAL.get('context_note_zh') or _CAL.get('context_note') or '' }}</span></span>
        </div>
        {% endif %}
        {% endif %}
        {% if PL.get('framing') %}
        <div class="mx-pcol-sub"><span class="l-en">{{ PL.framing }}</span><span class="l-zh">{{ PL.get('framing_zh') or '' }}</span></div>
        {% endif %}
        <div class="mx-pcol-sub">{{ t('Display-only · W2-F · as of','仅供展示 · W2-F · 截至') }} {{ PL.get('as_of') or '' }}</div>
      </div>

      {# COL 2 — Levers: arming state as labeled rows with delta chips #}
      <div class="mx-pcol">
        <div class="mx-pcol-label">{{ t('Lever Arming Status','杠杆触发状态') }}</div>
        {% if PL.get('levers') %}
        {% for lv in PL.levers %}
        {% set _arm = lv.get('arming') %}
        {% set _is_armed = _arm.get('armed') if _arm is not none else false %}
        <div class="mx-prog-row">
          <div class="mx-prog-label-row">
            <span class="muted"><span class="l-en">{{ lv.get('name') or '' }}</span><span class="l-zh">{{ lv.get('name_zh') or lv.get('name') or '' }}</span>{% if lv.get('asset') %} <span style="font-size:9.5px">({{ lv.asset }})</span>{% endif %}</span>
            {% if _arm is not none %}
            <span class="mx-delta-chip {{ 'mx-delta-dn' if _is_armed else 'mx-delta-mu' }}">
              <span class="l-en">{{ 'ARMED' if _is_armed else 'quiet' }}</span>
              <span class="l-zh">{{ '已触发' if _is_armed else '平静' }}</span>
            </span>
            {% else %}
            <span class="mx-delta-chip mx-delta-mu"><span class="l-en">n/a</span><span class="l-zh">不适用</span></span>
            {% endif %}
          </div>
          {% if _arm is not none %}
          <div class="mx-prog-track"><div class="mx-prog-fill" style="width:{{ '100' if _is_armed else '15' }}%;background:{{ 'var(--down)' if _is_armed else 'var(--muted)' }}"></div></div>
          {% if _arm.get('days_in_base') is not none or _arm.get('flatness') is not none %}
          <div style="font-size:10px;color:var(--muted);margin-top:2px">{% if _arm.get('days_in_base') is not none %}{{ _arm.days_in_base }}d base{% endif %}{% if _arm.get('flatness') is not none %} · flat={{ '%.2f'|format(_arm.flatness) }}{% endif %}</div>
          {% endif %}
          {% if _arm.get('basing') or _arm.get('stoch_curl') or _arm.get('macd_curl') %}
          <div style="font-size:10px;color:var(--up);margin-top:2px">
            {% if _arm.get('basing') %}basing {% endif %}{% if _arm.get('stoch_curl') %}stoch↑ {% endif %}{% if _arm.get('macd_curl') %}macd↑{% endif %}
          </div>
          {% endif %}
          {% endif %}
          {% if lv.get('watch') %}
          <div style="font-size:10px;color:var(--muted);margin-top:1px"><span class="l-en">{{ lv.get('watch') or '' }}</span><span class="l-zh">{{ lv.get('watch_zh') or lv.get('watch') or '' }}</span></div>
          {% endif %}
        </div>
        {% endfor %}
        {% else %}
        <div class="mx-pcol-sub">{{ t('No lever data','无杠杆数据') }}</div>
        {% endif %}
      </div>

      {# COL 3 — Flip Confirmation summary (full #flip-confirmation section remains in ms-front above).
         Doctrine Law 2: z-score / n= / internal workstream tags demoted to the ? help tip;
         the visible rows carry plain words only. #}
      <div class="mx-pcol">
        <div class="mx-pcol-label">{{ t('Flip Confirmation','翻转确认') }} {{ help('Tracks sharp defensive/offensive rotation flips and whether they stick. Flip strength is a z-score — how unusual the move was vs its own recent history (±2 ≈ rare). The fade rate counts how many past flips reversed within days. Display context only — not a trade signal.','跟踪防御／进攻方向的急剧翻转及其是否持续。翻转强度为 z 分数 — 相对自身近期历史的罕见程度（±2 ≈ 罕见）。消退率统计历史翻转中数日内回撤的比例。仅供展示参考 — 非交易信号。') }}</div>
        {% if flip_confirmation and flip_confirmation.last_event %}
        {% set _FC3 = flip_confirmation %}
        {% set _FEV3 = _FC3.last_event %}
        {% set _fv3_en = _FEV3.verdict if _FEV3.verdict else 'Pending' %}
        {% set _fv3_zh = {'CONFIRMED':'已确认','FADED':'已消退','MIXED':'混合','Pending':'待定'}.get(_fv3_en, _fv3_en) %}
        {% set _fvc3 = 'mx-delta-up' if _FEV3.verdict == 'CONFIRMED' else ('mx-delta-dn' if _FEV3.verdict == 'FADED' else 'mx-delta-mu') %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Last flip','最近翻转') }}</span>
          <span class="mx-delta-chip mx-delta-mu num">{{ _FEV3.event_date }}</span>
        </div>
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Direction','方向') }}</span>
          <span class="mx-delta-chip mx-delta-mu">{{ t('defensive','防御') if _FEV3.direction == 'defensive' else t('offense','进攻') }}</span>
        </div>
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Flip strength','翻转强度') }}</span>
          <span class="mx-delta-chip mx-delta-wn">{{ _FEV3.z }}</span>
        </div>
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Verdict','结论') }}</span>
          <span class="mx-delta-chip {{ _fvc3 }}">{{ t(_fv3_en, _fv3_zh) }}</span>
        </div>
        {% if _FC3.base_rates %}
        {% set _BR3 = _FC3.base_rates %}
        <div class="mx-pcol-row">
          <span class="mx-pcol-key">{{ t('Fade rate','消退率') }}</span>
          <span class="mx-delta-chip mx-delta-dn">{{ _BR3.faded }}/{{ _BR3.n_events }} {{ t('faded','消退') }}</span>
        </div>
        {% endif %}
        <div class="mx-pcol-sub">{{ t('as of','截至') }} {{ _FC3.asof }} · {{ t('Context only — not a signal','仅供参考 — 非信号') }}</div>
        {% else %}
        <div class="mx-pcol-sub">{{ t('No flip data yet','暂无翻转数据') }}</div>
        {% endif %}
      </div>

