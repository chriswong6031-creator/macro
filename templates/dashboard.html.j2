        <div class="mx5-alert-item info">
          <div class="mx5-alert-dot info"></div>
          <div class="mx5-alert-content">
            <div class="mx5-alert-title">
              <span class="l-en">{{ h.title[:55] }}{% if h.title|length > 55 %}…{% endif %}</span>
              <span class="l-zh">{{ (h.get('title_zh') or h.title)[:38] }}{% if (h.get('title_zh') or h.title)|length > 38 %}…{% endif %}</span>
            </div>
            {% if h.source_name %}<div class="mx5-alert-detail">{{ h.source_name }}</div>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="mx5-alert-footer">
        <span>
          <span class="l-en">{{ macro_news.headlines|length }} items</span>
          <span class="l-zh">{{ macro_news.headlines|length }} 条</span>
        </span>
        <button type="button" class="mx5-alert-footer-link" onclick="event.stopPropagation();mx5OpenDlg('dlg-news')">
          <span class="l-en">View all &#8594;</span>
          <span class="l-zh">查看全部 &#8594;</span>
        </button>
      </div>
      {% else %}
      <div style="flex:1;display:flex;align-items:center">
        <span style="font-size:12px;color:var(--ink-3,rgba(255,255,255,.36))">
          <span class="l-en">Market intelligence feed</span>
          <span class="l-zh">市场情报</span>
        </span>
      </div>
      {% endif %}
    </div>
  </div>{# /sx-news-v2 #}
  {% endif %}{# /mode != stocks #}

  {# ── 8. DEEP CONTEXT row (Stage B — link-out chips + health footer) ── #}
