                  </a>
                  {% endif %}
                  {% if alerts %}{% for a in alerts %}
                  {# C-01: these panels render on us_stocks only — an in-page jump on
                     macro would be a dead anchor, so route cross-page instead. #}
                  {% set _a_href = ('us_stocks.html#' + a.anchor) if (a.anchor in ('holdings','accumulation','flows') and mode != 'stocks') else ('#' + a.anchor if a.anchor else '') %}
                  <a class="ms-sig sev-{{ a.severity }}"{% if _a_href %}{% if _a_href.startswith('#') %} data-ms-jump{% endif %} href="{{ _a_href }}"{% endif %}>
                    <div class="ms-sig-head"><span class="ms-sig-ico">{{ a.icon }}</span><span class="ms-sig-title"><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></span>{% if _a_href %}<span class="ms-sig-jump">{% if _a_href.startswith('#') %}{{ t('View ↓','查看 ↓') }}{% else %}{{ t('View →','查看 →') }}{% endif %}</span>{% endif %}</div>
                    <div class="ms-sig-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
                    {% if a.what_en %}<div class="ms-sig-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh }}</span></div>{% endif %}
                    {% if a.edge_en %}<div class="ms-sig-edge"><b>{{ t('Conviction:','可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
                  </a>
                  {% endfor %}{% elif not (latest.dislocation and latest.dislocation.dislocation_active) %}
                  <div class="ms-pop-empty"><span class="big">✓</span>{{ t('No alerts fired today. Alerts are rare by design — they fire only on a change.','今日无警报触发。警报刻意稀少 — 仅在发生变化时触发。') }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            {% if macro_catalysts and macro_catalysts|length > 0 %}
            {% set _nextev = macro_catalysts[0] %}
            {# COPY-04/VIS-08: use CSS ellipsis (never bake a hard-sliced string) so ZH/EN match cleanly.
               _nextev.label_zh if present, else fall back to EN label — CSS will clip both identically. #}
            {% set _nev_zh = _nextev.label_zh if (_nextev.label_zh is defined and _nextev.label_zh) else _nextev.label %}
            <span class="v2chip {{ 'c-warn' if _nextev.impact == 'high' else 'c-info' }}" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <span class="l-en" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;white-space:nowrap">{{ _nextev.label }} {{ _nextev.date[5:10] }}</span>
              <span class="l-zh" style="max-width:200px;display:inline-block;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;white-space:nowrap">{{ _nev_zh }} {{ _nextev.date[5:10] }}</span>
            </span>
            {% endif %}
          </div>
        </div>
      </div>{# /mx2-hero-row #}
      </section>{# /ms-verdict — wraps thesis + score + tick for check_ms_board_coherence.py #}
    </div>{# /mx2-hero / ms-front #}

    {# ── MX5 COMMAND SCORECARD — grid view only; overlaid via CSS on #regime-radar ── #}
    {# mx2-hero is hidden in grid view (CSS body.page-macro.mx4-grid #regime-radar .mx2-hero{display:none}).
       This block provides the v5 visual scorecard visible in grid view only. #}
    {% if market_state %}
    {# ── Pre-compute gauge geometry (Jinja, no JS math) ── #}
    {# Arc: center=(70,75) radius=56; half-circle from (14,75) to (126,75).
       ARC_LEN = PI*56 = 175.93; filled = score/100 * ARC_LEN; gap = ARC_LEN - filled.
       Needle: -90deg (leftmost at score=0) + score/100 * 180 = final rotation from vertical. #}
    {% set _mx5_arc_len = 175.93 %}
    {% set _mx5_score = MS.score | int %}
    {% set _mx5_filled = (_mx5_score / 100 * _mx5_arc_len) | round(1) %}
    {% set _mx5_gap = (_mx5_arc_len - _mx5_filled) | round(1) %}
    {% set _mx5_needle_deg = (_mx5_score / 100 * 180 - 90) | round(1) %}
    {# Score color variable class #}
    {% set _mx5_sc_cls = 'mx5-score-green' if MS.color == 'green' else ('mx5-score-yellow' if MS.color == 'yellow' else 'mx5-score-red') %}
    {% set _mx5_sc_col = '#22d97a' if MS.color == 'green' else ('#f59e0b' if MS.color == 'yellow' else '#ef4444') %}
    {% set _mx5_sc_glow = 'rgba(34,217,122,.7)' if MS.color == 'green' else ('rgba(245,158,11,.7)' if MS.color == 'yellow' else 'rgba(239,68,68,.7)') %}
    {# Regime pill: quad_name + transition_state #}
    {% set _mx5_ts = latest.transition_state if (latest.transition_state is defined and latest.transition_state) else '' %}
    {% set _mx5_ts_en = {'TRANSITIONING':'Shifting','STABLE':'Stable','WEAKENING':'Weakening','NEW_REGIME':'New Regime'}.get(_mx5_ts, _mx5_ts | title) %}
    {% set _mx5_ts_zh = {'TRANSITIONING':'转换中','STABLE':'稳定','WEAKENING':'走弱','NEW_REGIME':'新周期'}.get(_mx5_ts, _mx5_ts) %}
    {# Risk button: warn style whenever the radar is NOT quiet (engine states include
       'watch' — the current bubble/blow-off state — which IS "there is risk" per the
       operator ruling) or the top scare scores >=50 #}
    {% set _mx5_rdr = market_state.radar if market_state.radar is defined else {} %}
    {% set _mx5_rdr_state = _mx5_rdr.state if _mx5_rdr else 'unknown' %}
    {# Dominant-risk score: engine field is top_score (not .top) #}
    {% set _mx5_radar_top = (_mx5_rdr.get('top_score') or _mx5_rdr.get('top') or 0) | int if _mx5_rdr else 0 %}
    {% set _mx5_risk_elevated = (_mx5_rdr_state not in ('quiet','dormant','none','unknown','')) or (_mx5_radar_top >= 50) %}
    {# Factor rows for factor popover #}
    {# MS (hero scope), NOT MS2 — MS2 is set later in the ledger section and is
       undefined here, which rendered "0 signals aligned" + an empty factor popover #}
    {% set _mx5_comps = MS.components if (MS and MS.components is defined and MS.components) else [] %}
    {% set _mx5_n_good = (_mx5_comps | selectattr('tone','equalto','good') | list | length) %}
    {# Weakest leg #}
    {% set _mx5_weakest = _mx5_comps | sort(attribute='score') | first if _mx5_comps else none %}
    {# 60-session path from ms_history VM key #}
    {% set _mx5_hist = ms_history if (ms_history is defined and ms_history and ms_history | length >= 2) else none %}
    {% set _mx5_hist_n = _mx5_hist | length if _mx5_hist else 0 %}

    <div class="mx5-sc-left">

      {# ── Gauge cluster ── #}
      <div class="mx5-sc-gauge-row {{ _mx5_sc_cls }}">
        {# Compact semicircle gauge; data-* attrs for risk_state_live.js patchMacro #}
        <svg class="mx5-gauge-svg" viewBox="0 0 140 88" fill="none"
             aria-label="{{ MS.label_en }} — score {{ _mx5_score }}"
             data-gauge-arc-len="{{ _mx5_arc_len }}"
             data-gauge-radius="56"
             data-gauge-cx="70" data-gauge-cy="75">
          <defs>
            <filter id="mx5NeedleGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="2.5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="mx5ArcGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          {# Track #}
          <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round" fill="none"/>
          {# Filled arc — dasharray baked by Jinja; JS patches via data-gauge-arc-len #}
          <path id="mx5-gauge-arc-fill"
                d="M 14 75 A 56 56 0 0 1 126 75" stroke="#f59e0b" stroke-width="10" stroke-linecap="round" fill="none"
                stroke-dasharray="{{ _mx5_filled }} {{ _mx5_gap }}" filter="url(#mx5ArcGlow)"/>
          {# Tick marks at 0/25/50/75/100 #}
          <g stroke="rgba(255,255,255,.22)" stroke-width="1.2">
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-90 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(0 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(90 70 75)"/>
          </g>
          {# Scale labels — ≥11px per spec #}
          <text x="8"   y="84" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="-apple-system,sans-serif">0</text>
          <text x="70"  y="14" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="-apple-system,sans-serif">50</text>
          <text x="132" y="84" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="-apple-system,sans-serif">100</text>
          {# Needle — rotation baked by Jinja; JS patches via data attr #}
          <g id="mx5-gauge-needle" transform="rotate({{ _mx5_needle_deg }} 70 75)" filter="url(#mx5NeedleGlow)">
            <line x1="70" y1="75" x2="70" y2="24" stroke="rgba(255,255,255,.30)" stroke-width="5" stroke-linecap="round"/>
            <polygon points="69,75 71,75 70.5,24 69.5,24" fill="white" opacity=".94"/>
            <circle cx="70" cy="75" r="7"  fill="rgba(255,255,255,.10)"/>
            <circle cx="70" cy="75" r="4.5" stroke="{{ _mx5_sc_col }}" stroke-width="1.5" fill="rgba(8,12,18,.8)"/>
            <circle cx="70" cy="75" r="2"  fill="{{ _mx5_sc_col }}"/>
            <circle cx="70" cy="25.5" r="2.5" fill="{{ _mx5_sc_col }}" style="filter:drop-shadow(0 0 4px {{ _mx5_sc_col }})"/>
          </g>
          {# Score numeral inside arc — hidden in ledger view, visible in grid (parent hidden by CSS) #}
          <text id="mx5-score-numeral"
                x="70" y="62" fill="{{ _mx5_sc_col }}" font-size="24" font-weight="800"
                text-anchor="middle" font-family="-apple-system,Inter,sans-serif"
                style="filter:drop-shadow(0 0 10px {{ _mx5_sc_glow }})">{{ _mx5_score }}</text>
          <text x="70" y="73" fill="rgba(255,255,255,.32)" font-size="11"
                text-anchor="middle" font-family="-apple-system,Inter,sans-serif">/ 100</text>
        </svg>

        {# Right of gauge: regime pill + big score + verdict word #}
        <div>
          <div class="mx5-regime-pill">
            <div class="mx5-dot"></div>
            <span class="l-en">{{ td(latest.quad_name) if latest.quad_name is defined else 'Regime' }}{% if _mx5_ts_en %} &nbsp;&middot;&nbsp; {{ _mx5_ts_en }}{% endif %}</span>
            <span class="l-zh">{{ td(latest.quad_name) if latest.quad_name is defined else '周期' }}{% if _mx5_ts_zh %} &nbsp;&middot;&nbsp; {{ _mx5_ts_zh }}{% endif %}</span>
          </div>
          <div class="mx5-score-line">
            <span class="mx5-big-score">{{ _mx5_score }}</span>
            <span class="mx5-verdict-word"><span class="l-en">{{ MS.label_en }}</span><span class="l-zh">{{ MS.label_zh or MS.label_en }}</span></span>
          </div>
          <div class="mx5-sub-line">
            <span class="l-en">{{ {'green':'GREEN','yellow':'YELLOW','red':'RED'}.get(MS.color,'—') }} &mdash; {{ {'green':'Trend-following supported','yellow':'Trade with caution','red':'Defend capital first'}.get(MS.color,'') }}</span>
            <span class="l-zh">{{ {'green':'偏多 — 顺势而为受支撑','yellow':'谨慎操作','red':'优先保住本金'}.get(MS.color,'') }}</span>
          </div>
        </div>
      </div>{# /mx5-sc-gauge-row #}

      {# Thesis line (from engine headline_en/zh) #}
      <div class="mx5-thesis">
        <span class="l-en">{{ MS.headline_en if MS.headline_en else (MS.label_en ~ ' — see evidence panel.') }}</span>
        <span class="l-zh">{{ MS.headline_zh if MS.headline_zh else (MS.label_zh or MS.label_en) }}</span>
      </div>

      {# Flip condition #}
      {% if MS.flip_en %}
      <div class="mx5-flip">
        <span class="mx5-flip-arrow">&#8594;</span>
        <span class="l-en">{{ MS.flip_en }}</span>
        {% if MS.flip_zh %}<span class="l-zh">{{ MS.flip_zh }}</span>{% endif %}
      </div>
      {% endif %}

      {# Popover trigger buttons #}
      <div class="mx5-btn-row">
        {# Button 1: factor signals aligned #}
        <button class="mx5-sc-btn" id="mx5BtnFactors"
                onclick="mx5TogglePop('mx5PopFactors','mx5BtnFactors')"
                aria-expanded="false" aria-controls="mx5PopFactors"
                type="button">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
          <span class="l-en">{{ _mx5_n_good }} signal{{ 's' if _mx5_n_good != 1 else '' }} aligned</span>
          <span class="l-zh">{{ _mx5_n_good }} 项信号一致</span>
          <svg width="9" height="9" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 1l4 4 4-4"/></svg>
        </button>

        {# Button 2: risk — warn style when elevated, neutral otherwise #}
        <button class="mx5-sc-btn{% if _mx5_risk_elevated %} mx5-sc-btn-warn{% endif %}" id="mx5BtnRisk"
                onclick="mx5TogglePop('mx5PopRisk','mx5BtnRisk')"
                aria-expanded="false" aria-controls="mx5PopRisk"
                type="button">
          {% if _mx5_risk_elevated %}
          <svg width="12" height="11" viewBox="0 0 24 21" fill="none">
            <path d="M12 2L1.5 20h21L12 2z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <line x1="12" y1="9" x2="12" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="17" r="1" fill="currentColor"/>
          </svg>
          <span class="l-en">Elevated Risk{% if _mx5_radar_top > 0 %} &middot; {{ _mx5_radar_top }}{% endif %}</span>
          <span class="l-zh">风险偏高{% if _mx5_radar_top > 0 %} &middot; {{ _mx5_radar_top }}{% endif %}</span>
          {% else %}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span class="l-en">Risk Detail</span>
          <span class="l-zh">风险详情</span>
          {% endif %}
          <svg width="9" height="9" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 1l4 4 4-4"/></svg>
        </button>

        {# POPOVER: Factor Breakdown #}
        <div class="mx5-popover" id="mx5PopFactors" role="dialog"
             aria-label="Factor Breakdown">
          {# Mobile close bar — sticky at top of bottom-sheet; hidden on desktop via CSS #}
          <div class="mx5-pop-close-bar">
            <div style="width:32px"></div>
            <div class="mx5-pop-close-handle"></div>
            <button class="mx5-pop-close-btn" type="button"
                    onclick="mx5CloseAllPopovers()" aria-label="Close">&#xd7;</button>
          </div>
          <div class="mx5-popover-title"><span class="l-en">Factor Breakdown &mdash; {{ _mx5_comps | length }} Signals</span><span class="l-zh">因子分析 &mdash; {{ _mx5_comps | length }} 项</span></div>
          <div class="mx5-factors-inner">
            {% for c in _mx5_comps %}
            {% set _fweak = (_mx5_weakest and c.label_en == _mx5_weakest.label_en) %}
            <div class="mx5-factor-row">
              <div class="mx5-factor-header">
                <span class="mx5-factor-name{% if _fweak %}" style="color:var(--mx5-warn-ink){% endif %}">
                  <span class="l-en">{{ c.label_en }}</span><span class="l-zh">{{ c.label_zh or c.label_en }}</span>
                </span>
                <span class="mx5-factor-score{% if _fweak %} weak{% endif %}">{{ c.score }}</span>
              </div>
              <div class="mx5-factor-bar-track">
                <div class="mx5-factor-bar-fill{% if _fweak %} weak{% endif %}" style="width:{{ [c.score, 100] | min }}%"></div>
              </div>
              {% if _fweak %}
              <div class="mx5-factor-weak-tag"><span class="l-en">WEAKEST LEG &mdash; MONITOR</span><span class="l-zh">最弱分项 &mdash; 持续关注</span></div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          <div class="mx5-pop-footer">
            <button class="mx5-pop-footer-link" type="button"
                    onclick="mx5CloseAllPopovers();mx5OpenDlg('dlg-evidence')">
              <span class="l-en">Full breakdown &#8595;</span><span class="l-zh">完整分析 &#8595;</span>
            </button>
          </div>
        </div>{# /mx5PopFactors #}

        {# POPOVER: Dominant Risk Ladder #}
        <div class="mx5-popover mx5-pop-right" id="mx5PopRisk" role="dialog"
             aria-label="Dominant Risk Ladder">
          {# Mobile close bar — sticky at top of bottom-sheet; hidden on desktop via CSS #}
          <div class="mx5-pop-close-bar">
            <div style="width:32px"></div>
            <div class="mx5-pop-close-handle"></div>
            <button class="mx5-pop-close-btn" type="button"
                    onclick="mx5CloseAllPopovers()" aria-label="Close">&#xd7;</button>
          </div>
          <div class="mx5-popover-title"><span class="l-en">Dominant Risk Ladder</span><span class="l-zh">主导风险阶梯</span></div>
          {% if latest.risk_radar is defined and latest.risk_radar and latest.risk_radar.scares %}
          {% set _mx5_top_sc = latest.risk_radar.scares[0] %}
          <div class="mx5-scare-dominant-row">
            <span class="mx5-scare-dominant-num">{{ _mx5_top_sc.score | round | int }}</span>
            <span class="mx5-scare-dominant-title"><span class="l-en">{{ _mx5_top_sc.label_en if _mx5_top_sc.label_en is defined else _mx5_top_sc.name }}</span><span class="l-zh">{{ _mx5_top_sc.label_zh if _mx5_top_sc.label_zh is defined else (_mx5_top_sc.name_zh if _mx5_top_sc.name_zh is defined else _mx5_top_sc.name) }}</span></span>
          </div>
          {% if _mx5_rdr and _mx5_rdr.do_en is defined %}
          <div class="mx5-scare-driver"><span class="l-en">{{ _mx5_rdr.do_en }}</span><span class="l-zh">{{ _mx5_rdr.do_zh if _mx5_rdr.do_zh is defined else _mx5_rdr.do_en }}</span></div>
          {% endif %}
          <div class="mx5-scare-list">
            {% for sc in latest.risk_radar.scares[:4] %}
            {% set _sc_s = sc.score if (sc.score is defined and sc.score is not none) else 0 %}
            {% set _sclevel = 'hi' if _sc_s >= 60 else ('mid' if _sc_s >= 40 else 'lo') %}
            {% set _scistop = loop.index == 1 %}
            <div class="mx5-scare-item">
              <div class="mx5-scare-item-header">
                <span class="mx5-scare-item-name"><span class="l-en">{{ sc.label_en if sc.label_en is defined else sc.name }}</span><span class="l-zh">{{ sc.label_zh if sc.label_zh is defined else (sc.name_zh if sc.name_zh is defined else sc.name) }}</span></span>
                <span class="mx5-scare-item-val {% if _scistop %}top{% else %}lower{% endif %}">{{ sc.score }}</span>
              </div>
              <div class="mx5-scare-meter"><div class="mx5-scare-fill {{ _sclevel }}" style="width:{{ [_sc_s, 100] | min }}%"></div></div>
              {% if _scistop and _sc_s >= 50 %}<div class="mx5-scare-item-label"><span class="l-en">ELEVATED</span><span class="l-zh">偏高</span></div>{% endif %}
            </div>
            {% endfor %}
          </div>
          {% else %}
          <div style="font-size:12px;color:var(--ink-2)"><span class="l-en">No active risk readings.</span><span class="l-zh">暂无活跃风险读数。</span></div>
          {% endif %}
          <div class="mx5-pop-footer">
            <button class="mx5-pop-footer-link" type="button"
                    onclick="mx5CloseAllPopovers();mx5OpenDlg('dlg-risk')">
              <span class="l-en">Full risk detail &#8595;</span><span class="l-zh">完整风险分析 &#8595;</span>
            </button>
          </div>
        </div>{# /mx5PopRisk #}

      </div>{# /mx5-btn-row #}
    </div>{# /mx5-sc-left #}

    {# 60-session path panel (right, hidden ≤700px per spec §0 via CSS) #}
    <div class="mx5-sc-right">
      <div class="mx5-path-header">
        <span class="mx5-path-title">
          <span class="l-en">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}{{ _mx5_hist_n }}-session path{% else %}60-session path{% endif %}</span>
          <span class="l-zh">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}近 {{ _mx5_hist_n }} 交易日走势{% else %}60 交易日走势{% endif %}</span>
        </span>
        <span class="mx5-path-meta"><span class="l-en">Score vs time</span><span class="l-zh">综合评分 · 时序</span></span>
      </div>
      {% if _mx5_hist %}
      {# ── Legit chart geometry (Order 1) ──────────────────────────────────
         viewBox 0 0 1000 224.  Plot band: x∈[PX0, PX0+PXW]  y∈[PY0(score100), PYB(score0)].
         Y map:  y = PY0 + (100-score)/100 * (PYB-PY0)
         X map:  x = PX0 + i/(n-1) * PXW           (single point → centred)
         Verdict bands: risk-off <42, mixed 42–60, risk-on ≥60.
         x-axis label strip lives BELOW PYB (y≈216). #}
      {% set _ph_n = _mx5_hist | length %}
      {% set PX0 = 44 %}{% set PXW = 944 %}{% set PY0 = 10 %}{% set PYB = 194 %}
      {% set _mx5_mos_en = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
      {# score → verdict word (matches engine band thresholds) #}
      {% set _ph_yfor = PYB - PY0 %}
      {# y for each score-band boundary #}
      {% set _y100 = PY0 %}
      {% set _y75  = (PY0 + 25.0/100 * _ph_yfor) | round(2) %}
      {% set _y60  = (PY0 + 40.0/100 * _ph_yfor) | round(2) %}
      {% set _y50  = (PY0 + 50.0/100 * _ph_yfor) | round(2) %}
      {% set _y42  = (PY0 + 58.0/100 * _ph_yfor) | round(2) %}
      {% set _y25  = (PY0 + 75.0/100 * _ph_yfor) | round(2) %}
      {% set _y0   = PYB %}
      {# build point list: viewBox x,y baked so the hover JS stays in perfect sync #}
      {% set _ph_pts_line = [] %}
      {% set _ph_json = [] %}
      {% for row in _mx5_hist %}
        {% set _ph_x = (PX0 + (loop.index0 / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
        {% set _row_s = row.score if (row.score is defined and row.score is not none) else 50 %}
        {% set _ph_y = (PY0 + (100 - _row_s) / 100 * _ph_yfor) | round(2) %}
        {% set _rv = 'Risk-on' if _row_s >= 60 else ('Mixed' if _row_s >= 42 else 'Risk-off') %}
        {% set _rvz = '偏多' if _row_s >= 60 else ('中性' if _row_s >= 42 else '偏空') %}
        {% if _ph_pts_line.append(_ph_x ~ ',' ~ _ph_y) %}{% endif %}
        {% if _ph_json.append({'d': row.asof, 'md': (_mx5_mos_en[row.asof[5:7]|int] ~ ' ' ~ (row.asof[8:10]|int)) if (row.asof and row.asof|length >= 10) else '', 'mz': ((row.asof[5:7]|int)|string ~ '月' ~ (row.asof[8:10]|int)|string) if (row.asof and row.asof|length >= 10) else '', 's': row.score, 'v': _rv, 'vz': _rvz, 'x': _ph_x, 'y': _ph_y}) %}{% endif %}
      {% endfor %}
      {# x-axis date ticks: pick up to 6 evenly-spaced indices (always first + last) #}
      {% set _ph_nticks = [_ph_n, 5] | min %}
      {% set _ph_tick_idx = [] %}
      {% if _ph_n <= 6 %}
        {% for i in range(_ph_n) %}{% if _ph_tick_idx.append(i) %}{% endif %}{% endfor %}
      {% else %}
        {% for k in range(_ph_nticks + 1) %}{% if _ph_tick_idx.append((k / _ph_nticks * (_ph_n - 1)) | round | int) %}{% endif %}{% endfor %}
      {% endif %}
      <div class="mx5-path-plot">
      <svg class="mx5-path-svg" viewBox="0 0 1000 224" preserveAspectRatio="none"
           data-points='{{ _ph_json | tojson }}'
           data-px0="{{ PX0 }}" data-pxw="{{ PXW }}" data-py0="{{ PY0 }}" data-pyb="{{ PYB }}"
           data-vbw="1000" data-vbh="224"
           role="img" aria-label="{{ _mx5_hist_n }}-session macro score path, {{ _mx5_hist[0].score }} to {{ _mx5_hist[-1].score }}">
        <defs>
          <linearGradient id="mx5PathAreaGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="{{ _mx5_sc_col }}" stop-opacity=".40"/>
            <stop offset="62%"  stop-color="{{ _mx5_sc_col }}" stop-opacity=".07"/>
            <stop offset="100%" stop-color="{{ _mx5_sc_col }}" stop-opacity="0"/>
          </linearGradient>
        </defs>
        {# ── Verdict-band tinted zones (subtle, 4%) ──
           green risk-on: score 60–100 → y _y100.._y60 ; amber mixed: 42–60 → _y60.._y42 ;
           red risk-off: 0–42 → _y42.._y0 . #}
        <rect x="0" y="{{ _y100 }}" width="1000" height="{{ (_y60 - _y100) | round(2) }}" fill="rgba(34,217,122,.045)"/>
        <rect x="0" y="{{ _y60 }}"  width="1000" height="{{ (_y42 - _y60) | round(2) }}" fill="rgba(245,158,11,.045)"/>
        <rect x="0" y="{{ _y42 }}"  width="1000" height="{{ (_y0 - _y42) | round(2) }}" fill="rgba(239,68,68,.045)"/>
        {# zone boundary hairlines at 42 / 60 #}
        <line x1="0" y1="{{ _y60 }}" x2="1000" y2="{{ _y60 }}" stroke="rgba(34,217,122,.22)" stroke-width="1" stroke-dasharray="2,5"/>
        <line x1="0" y1="{{ _y42 }}" x2="1000" y2="{{ _y42 }}" stroke="rgba(239,68,68,.20)" stroke-width="1" stroke-dasharray="2,5"/>
        {# NB: zone labels, y-axis numbers, x-axis dates and the today dot are NOT
           drawn in-SVG — this SVG uses preserveAspectRatio="none" (the plot band
           must stretch to fill the card), which would warp any glyph/circle. They
           are rendered as a screen-space HTML overlay (.mx5-path-labels) below,
           positioned by % of the plot box so they track these gridlines exactly. #}
        {# ── Y gridlines at 0/25/50/75/100 + labels ── #}
        <g stroke="rgba(255,255,255,.06)" stroke-width="1">
          <line x1="{{ PX0 }}" y1="{{ _y100 }}" x2="988" y2="{{ _y100 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y75 }}"  x2="988" y2="{{ _y75 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y50 }}"  x2="988" y2="{{ _y50 }}" stroke-dasharray="4,5"/>
          <line x1="{{ PX0 }}" y1="{{ _y25 }}"  x2="988" y2="{{ _y25 }}"/>
        </g>
        {# y-axis number labels → HTML overlay (see .mx5-path-labels below) #}
        {# ── Area fill + line ── #}
        <path d="M{{ _ph_pts_line | join(' L') }} L{{ (PX0 + PXW) | round(2) }},{{ PYB }} L{{ PX0 }},{{ PYB }} Z" fill="url(#mx5PathAreaGrad)" stroke="none"/>
        <polyline points="{{ _ph_pts_line | join(' ') }}" fill="none" stroke="{{ _mx5_sc_col }}" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" opacity=".92"/>
        {# ── X-axis baseline hairline ── #}
        <line x1="{{ PX0 }}" y1="{{ PYB }}" x2="988" y2="{{ PYB }}" stroke="rgba(255,255,255,.16)" stroke-width="1"/>
        {# ── X-axis tick marks (date labels live in the HTML overlay below) ── #}
        <g font-size="11" font-family="-apple-system,sans-serif">
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          <line x1="{{ _tx }}" y1="{{ PYB }}" x2="{{ _tx }}" y2="{{ (PYB + 4) | round(1) }}" stroke="rgba(255,255,255,.20)" stroke-width="1"/>
        {% endfor %}
        </g>
        {# today marker → HTML overlay (a round dot; an in-SVG circle would render
           as an ellipse under preserveAspectRatio="none") #}
        {% set _ph_last_x = (PX0 + PXW) | round(2) %}
        {% set _ph_last_y = (PY0 + (100 - _mx5_hist[-1].score) / 100 * _ph_yfor) | round(2) %}
      </svg>
      {# ── Axis labels + today marker: screen-space HTML overlay ───────────────
         The SVG fills this .mx5-path-plot box exactly, so a label at viewBox
         (vx,vy) sits at left:vx/1000·100% / top:vy/224·100% and tracks the SVG
         gridlines/points — but as normal HTML it is never stretched by the SVG's
         non-uniform scale. Percentages are baked from the same y-band constants. #}
      <div class="mx5-path-labels" aria-hidden="true">
        {# y-axis scale (centred on each gridline) #}
        <span class="mx5-pl-y" style="top:{{ (_y100 / 224 * 100) | round(2) }}%">100</span>
        <span class="mx5-pl-y" style="top:{{ (_y75  / 224 * 100) | round(2) }}%">75</span>
        <span class="mx5-pl-y" style="top:{{ (_y50  / 224 * 100) | round(2) }}%">50</span>
        <span class="mx5-pl-y" style="top:{{ (_y25  / 224 * 100) | round(2) }}%">25</span>
        <span class="mx5-pl-y" style="top:{{ (_y0   / 224 * 100) | round(2) }}%">0</span>
        {# plain-word verdict-zone labels (right-aligned) #}
        <span class="mx5-pl-zone on"  style="top:{{ ((_y100 + 13) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-on</span><span class="l-zh">偏多</span></span>
        <span class="mx5-pl-zone mid" style="top:{{ (((_y60 + _y42) / 2) / 224 * 100) | round(2) }}%"><span class="l-en">Mixed</span><span class="l-zh">中性</span></span>
        <span class="mx5-pl-zone off" style="top:{{ ((_y0 - 7) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-off</span><span class="l-zh">偏空</span></span>
        {# x-axis date ticks (bilingual; anchored start / middle / end) #}
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          {% set _txf = 'translate(0,-50%)' if loop.first else ('translate(-100%,-50%)' if loop.last else 'translate(-50%,-50%)') %}
          {% set _tdate = _mx5_hist[_ti].asof %}
          {% if _tdate and _tdate|length >= 10 %}
          <span class="mx5-pl-x" style="left:{{ (_tx / 1000 * 100) | round(3) }}%;transform:{{ _txf }}"><span class="l-en">{{ _mx5_mos_en[_tdate[5:7]|int] }} {{ _tdate[8:10]|int }}</span><span class="l-zh">{{ _tdate[5:7]|int }}月{{ _tdate[8:10]|int }}</span></span>
          {% endif %}
        {% endfor %}
        {# today marker (round dot; JS hover dot overlays on top) #}
        <span class="mx5-pl-today" style="left:{{ (_ph_last_x / 1000 * 100) | round(3) }}%;top:{{ (_ph_last_y / 224 * 100) | round(3) }}%;color:{{ _mx5_sc_col }}"></span>
      </div>{# /mx5-path-labels #}
      {# ── JS hover enhancement layer (screen-space; chart is complete without it) ── #}
      <div class="mx5-path-cross" aria-hidden="true"></div>
      <div class="mx5-path-dot" aria-hidden="true"></div>
      <div class="mx5-path-tip" role="status" aria-live="off">
        <span class="mx5-path-tip-date"></span>
        <span class="mx5-path-tip-row"><b class="mx5-path-tip-score"></b><span class="mx5-path-tip-verdict"></span></span>
      </div>
      </div>{# /mx5-path-plot #}
      {% else %}
      {# Placeholder when ms_history absent or <2 points #}
      <div style="flex:1;display:flex;align-items:center;justify-content:center;">
        <span style="font-size:12px;color:var(--ink-3)"><span class="l-en">Path chart — accruing from nightly log.</span><span class="l-zh">走势图 — 每晚积累中。</span></span>
      </div>
      {% endif %}
    </div>{# /mx5-sc-right #}

    {% endif %}{# /market_state — mx5 scorecard #}

    {# alerts toggle script — touch path. The checkbox is `hidden`, so native
       label-for activation does NOT fire on tap (MOB-02): toggle it in JS. #}
    <script>
    (function(){
      var cb=document.getElementById('ms-alerts-toggle');
      if(!cb) return;
      document.addEventListener('click',function(e){
        if(e.target.closest('[data-ms-jump]')){ cb.checked=false; return; }
        var pill=e.target.closest('.ms-alerts');
        if(pill){ e.preventDefault(); cb.checked=!cb.checked; return; }
        var wrap=e.target.closest('.ms-alerts-wrap');
        if(cb.checked && !wrap) cb.checked=false;
      });
      document.addEventListener('keydown',function(e){
        if(e.key==='Escape'&&cb.checked){ cb.checked=false; return; }
        if((e.key==='Enter'||e.key===' ')&&e.target.closest&&e.target.closest('.ms-alerts')){
          e.preventDefault(); cb.checked=!cb.checked;
        }
      });
    })();
    </script>

    {# ── Path-chart hover enhancement (Order 1c) — pure progressive layer.
       Reads data-points (viewBox x/y baked in) + the SVG's live bounding rect,
       maps viewBox→screen so the crosshair/dot/tooltip are pixel-crisp regardless
       of the SVG's non-uniform stretch. Chart is fully legible without this. #}
    <script>
    (function(){
      var svg = document.querySelector('.mx5-sc-right .mx5-path-svg[data-points]');
      if(!svg) return;
      var plot = svg.closest('.mx5-path-plot'); if(!plot) return;
      var cross = plot.querySelector('.mx5-path-cross');
      var dot   = plot.querySelector('.mx5-path-dot');
      var tip   = plot.querySelector('.mx5-path-tip');
      if(!cross || !dot || !tip) return;
      var tDate = tip.querySelector('.mx5-path-tip-date');
      var tScore= tip.querySelector('.mx5-path-tip-score');
      var tVerd = tip.querySelector('.mx5-path-tip-verdict');
      var pts;
      try { pts = JSON.parse(svg.getAttribute('data-points') || '[]'); } catch(e){ return; }
      if(!pts.length) return;
      var VBW = +(svg.getAttribute('data-vbw')||1000);
      var VBH = +(svg.getAttribute('data-vbh')||224);
      var COL = { 'Risk-on':'#22d97a', 'Mixed':'#f59e0b', 'Risk-off':'#ef4444' };
      function isZh(){
        var el=document.documentElement;
        return (el.getAttribute('data-lang')||'').slice(0,2)==='zh';
      }
      /* nearest point index for a screen-x, using each point's baked viewBox x */
      function nearest(clientX){
        var r = svg.getBoundingClientRect();
        var vx = (clientX - r.left) / r.width * VBW;   // back to viewBox space
        var best=0, bd=Infinity;
        for(var i=0;i<pts.length;i++){
          var d=Math.abs(pts[i].x - vx);
          if(d<bd){ bd=d; best=i; }
        }
        return best;
      }
      function show(i){
        var p = pts[i]; if(!p) return;
        var r = svg.getBoundingClientRect();
        var pr = plot.getBoundingClientRect();
        var sx = (p.x / VBW) * r.width  + (r.left - pr.left);
        var sy = (p.y / VBH) * r.height + (r.top  - pr.top);
        cross.style.left = sx + 'px';   cross.style.opacity = '1';
        dot.style.left = sx + 'px';     dot.style.top = sy + 'px';
        dot.style.background = COL[p.v] || '#22d97a';
        dot.style.opacity = '1';
        tDate.textContent = isZh() ? (p.mz || p.d) : (p.md || p.d);
        tScore.textContent = p.s;
        tVerd.textContent = isZh() ? (p.vz||p.v) : p.v;
        tVerd.style.color = COL[p.v] || '#22d97a';
        /* clamp tooltip x within the plot so it never overflows the card edge */
        var half = tip.offsetWidth/2 || 60;
        var clx = Math.max(half+2, Math.min(pr.width-half-2, sx));
        tip.style.left = clx + 'px';
        tip.style.top  = sy + 'px';
        tip.classList.add('show');
      }
      function hide(){
        cross.style.opacity='0'; dot.style.opacity='0'; tip.classList.remove('show');
      }
      var raf=0, lastX=0;
      function onMove(clientX){
        lastX=clientX;
        if(raf) return;
        raf=requestAnimationFrame(function(){ raf=0; show(nearest(lastX)); });
      }
      svg.addEventListener('mousemove', function(e){ onMove(e.clientX); });
      svg.addEventListener('mouseleave', hide);
      /* touch: tap/drag shows nearest point; touchend leaves it briefly then hides */
      svg.addEventListener('touchstart', function(e){
        if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX));
      }, {passive:true});
      svg.addEventListener('touchmove', function(e){
        if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX));
      }, {passive:true});
      svg.addEventListener('touchend', function(){ setTimeout(hide, 1400); }, {passive:true});
      /* keep tooltip language in sync if the user flips EN/ZH while it is open */
      document.addEventListener('langchange', function(){
        if(tip.classList.contains('show')) show(nearest(lastX));
      });
    })();
    </script>
    {% endif %}{# /if market_state — v2 hero #}
  {% if mode != 'stocks' %}
  {# ── MX5 Popover system — mx5TogglePop / mx5CloseAllPopovers ── #}
  {# NOTE: fn named mx5TogglePop per spec §3.3 — NEVER a native HTMLElement method name.
     Exposed on window so onclick= inline handlers can reach it. #}
  <script>
  (function(){
    var _mx5Active = null;
    var _mx5ActiveBtn = null;

    function _mx5Open(popId, btnId) {
      var pop = document.getElementById(popId);
      var btn = document.getElementById(btnId);
      var bd  = document.getElementById('mx5PopBackdrop');
      var rr  = document.getElementById('regime-radar');
      if (!pop || !btn) return;
      pop.classList.add('open');
      btn.setAttribute('aria-expanded','true');
      if (bd) bd.classList.add('open');
      /* Lift containing card above fixed backdrop (stacking context fix — spec §3.3 lesson 2) */
      if (rr) rr.classList.add('mx5-pop-open');
      _mx5Active = pop;
      _mx5ActiveBtn = btn;
    }

    window.mx5CloseAllPopovers = function() {
      document.querySelectorAll('.mx5-popover.open').forEach(function(p){ p.classList.remove('open'); });
      document.querySelectorAll('.mx5-sc-btn[aria-expanded="true"]').forEach(function(b){
        b.setAttribute('aria-expanded','false');
      });
      var bd  = document.getElementById('mx5PopBackdrop');
      var rr  = document.getElementById('regime-radar');
      if (bd) bd.classList.remove('open');
      if (rr) rr.classList.remove('mx5-pop-open');
      _mx5Active = null; _mx5ActiveBtn = null;
    };

    window.mx5TogglePop = function(popId, btnId) {
      var pop = document.getElementById(popId);
      var isOpen = pop && pop.classList.contains('open');
      window.mx5CloseAllPopovers();
      if (!isOpen) _mx5Open(popId, btnId);
    };

    /* Escape handler: close popovers FIRST, then let mx2 Escape handler close islands.
       Spec §3.3: "Escape handler must respect existing modal guards and close popovers
       BEFORE islands." Uses stopImmediatePropagation only when a popover is actually open,
       so the island Escape handler still fires on subsequent Escape when no popover. */
    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return;
      if (_mx5Active) {
        e.stopImmediatePropagation(); /* prevent mx2 island close on same keypress */
        window.mx5CloseAllPopovers();
      }
    });
  })();
  </script>
  {% endif %}
