    .sbx-wl.low i{background:var(--down)}
    .sbx-wl .tick{position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--muted);opacity:.6}
    .sbx-more{margin-top:12px;text-align:right;font-size:11.5px}
    .sbx-more button{background:none;border:none;color:var(--link);font:inherit;cursor:pointer;padding:0}
    .sbx-dlg{display:none;position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,.45);padding:4vh 16px}
