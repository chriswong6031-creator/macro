  <!-- ===================== EVENT-RISK WINDOW — non-directional catalyst flag (display-only) ===================== -->
  {% if event_risk and event_risk.show %}
  {% set ER = event_risk %}
  {% set erc = 'var(--down)' if ER.fragility.fragile else ('var(--orange)' if ER.vol_tier=='high' else 'var(--warn)') %}
  <div class="panel span12" id="event-risk" style="border-left:3px solid {{ erc }}">
    <h2>📅 {{ t(ER.headline_en, ER.headline_zh) }}
      {{ help("A non-directional ATTENTION flag, not a signal and NOT a dampener. It pairs a known high-impact catalyst date with the dashboard's already-measured fragility. It never predicts direction — pre-FOMC drift died after 2016 and the average announcement premium is positive, so these days resolve up about as often as down. It never cuts exposure and is never scored. The honest use: expect two-sided volatility, size and set stops for the noise.", "这是非方向性的注意力提示，不是信号、也不是抑制器。它把已知的高影响催化剂日期与仪表盘已测得的脆弱性配对。它从不预测方向——2016年后FOMC前漂移已消失，且平均公告溢价为正，因此这些日子上涨与下跌的概率相当。它从不削减仓位、也从不计入评分。正确用法：预期两面性波动，按噪声调整仓位与止损。") }}
    </h2>
    <div class="grid">
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ erc }};border-radius:8px;padding:12px 14px">
        <div class="muted sm" style="margin-bottom:6px">{{ t('Display / context only — this is NOT a sell signal and NOT a direction call.', '仅供显示／参考 — 这不是卖出信号，也不是方向判断。') }}</div>
        <div>{{ t(ER.sub_en, ER.sub_zh) }}</div>
        {% if ER.fragility.fragile %}
        <div style="margin-top:9px;border-top:1px solid var(--line);padding-top:8px">
          <b style="color:{{ erc }}">→ {{ t('Walking in fragile', '当前仓位脆弱') }}:</b>
          <ul style="margin:5px 0 0;padding-left:18px">
            {% for r in ER.fragility.reasons %}<li class="sm">{{ t(r.en, r.zh) }}</li>{% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if ER.track and ER.track.n %}
        <div class="sm muted" style="margin-top:9px;border-top:1px solid var(--line);padding-top:7px">
          <b>{{ t('Our track record', '我们的战绩') }}:</b>
          {{ t('across', '过去') }} {{ ER.track.n }} {{ t('flagged event-days the S&P realized ±', '次标记事件当日，标普实际波动 ±') }}{{ ER.track.avg_abs }}% ({{ t('up', '上涨') }} {{ (ER.track.up_rate*100)|round|int }}%) — {{ t('the base rate this banner is calibrated against (two-sided).', '本横幅据以校准的基准（两面性）。') }}
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ===================== TURNING-POINT FRAGILITY — conviction guardrail (display-only) ===================== -->
  {% if latest.turning_point and latest.turning_point.present %}
  {% set TP = latest.turning_point %}
  {% set tpc = 'var(--down)' if TP.state=='fragile-structural' else ('var(--muted)' if TP.state=='cooling' else 'var(--orange)') %}
  {% set _stx = {'RORO extreme':'RORO 极值','capitulation':'恐慌投降','regime transitioning':'周期转换中','rate path priced':'利率路径已定价'} %}
  <div class="panel span12" id="turning-point" style="border-left:3px solid {{ tpc }}">
    <h2>⚠️ {{ t(TP.headline_en, TP.headline_zh) }}
      {{ help("A conviction guardrail, NOT a signal. It fires only when the tape is one-factor (six markets on one macro bet), a macro-shock driver dominates, and positioning is stretched — the configuration that whipsaws on a fast catalyst. It lowers stated conviction; it never tells you to fade. It is read across existing leaves and is never scored, because it cannot distinguish a forced, reversible move from an early, real regime change.", "这是确信度护栏，并非信号。仅当行情呈单因子（六个市场押注同一宏观主题）、某一宏观冲击驱动占主导、且仓位被拉伸时才触发——这正是快速催化剂下容易剧烈反复的格局。它只降低确信度，绝不提示做空。它跨既有读数综合得出，从不计入评分，因为它无法区分被迫的可逆移动与早期的真实周期变化。") }}
    </h2>
    <div class="grid">
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ tpc }};border-radius:8px;padding:12px 14px">
        <div class="muted sm" style="margin-bottom:6px">{{ t('Display-only — these reads are coincident, not predictive. The dashboard is NOT telling you a direction here.', '仅供显示 — 此处读数为巧合同步，并非预测。仪表盘在此并不告诉你方向。') }}</div>
        <div>{{ t(TP.message_en, TP.message_zh) }}</div>
        <div style="margin-top:8px;font-weight:700;color:{{ tpc }}">→ {{ t(TP.size_note_en, TP.size_note_zh) }}</div>
        {% if TP.defer_to == 'dislocation' %}
        <div class="sm" style="margin-top:7px;color:var(--down)">↘ {{ t('See the', '参见') }} <a href="#dislocation" style="color:var(--down);text-decoration:underline">{{ t('Dislocation gate', '错位一道闸') }}</a> {{ t('— this is its falling-knife regime, not a fade.', '— 此为接飞刀情形，而非做空机会。') }}</div>
        {% endif %}
        <div class="sm muted" style="margin-top:9px;border-top:1px solid var(--line);padding-top:7px">
          <b>{{ t('Why it fired', '触发原因') }}:</b>
          {% if TP.drivers.one_factor %}{{ t('one-factor tape', '单因子行情') }}{% if TP.drivers.absorption_pctile is not none %} ({{ t('absorption', '吸收率') }} {{ (TP.drivers.absorption_pctile*100)|round|int }}{{ t('th pct', ' 百分位') }}){% endif %} · {% endif %}
          {% if TP.drivers.primary_label %}{{ t('driver', '驱动') }}: {{ t(TP.drivers.primary_label, TP.drivers.primary_label_zh or TP.drivers.primary_label) }} · {% endif %}
          {% if TP.drivers.stretched %}{{ t('stretched', '拉伸') }}: {% for s in TP.drivers.stretched %}{{ t(s, _stx.get(s, s)) }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- ===================== FED REACTION FUNCTION — explicit policy stance (display-only) ===================== -->
  {% if latest.fed_stance and latest.fed_stance.stance and latest.fed_stance.stance != 'unknown' %}
  {% set FS = latest.fed_stance %}
  {% set fsc = 'var(--down)' if FS.color=='down' else ('var(--up)' if FS.color=='up' else 'var(--muted)') %}
  <div class="panel span12" id="fed-stance" style="border-left:3px solid {{ fsc }}">
    <h2>🏛️ {{ t('Fed reaction function', '美联储反应函数') }}:
      <span style="color:{{ fsc }}">{{ t(FS.label_en, FS.label_zh) }}</span>
      {{ help("An EXPLICIT read of monetary-policy stance (hawkish/neutral/dovish) off the market-implied path (fed_path) + the FOMC statement's guidance direction — so policy stance is stated, not left implicit in the curve. Display-only / never scored: a market price is reactive, not a forecast.", "对货币政策立场（鹰派/中性/鸽派）的显式读数，基于市场隐含路径（fed_path）+ FOMC 声明的指引方向——使政策立场被明确陈述，而非隐含于曲线中。仅供展示、从不计入评分：市场价格是被动反应而非预测。") }}
    </h2>
    <div class="grid">
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ fsc }};border-radius:8px;padding:12px 14px">
        {% if FS.drivers_en %}<div><b>{{ t('Drivers', '驱动') }}:</b> <span class="l-en">{{ FS.drivers_en | join(' · ') }}</span><span class="l-zh">{{ FS.drivers_zh | join(' · ') }}</span></div>{% endif %}
        <div class="sm muted" style="margin-top:7px">{{ t(FS.note_en, FS.note_zh) }}
          → <a href="policy_watch.html" style="color:var(--link)">{{ t('Fed & Policy Watch: intent, theaters & capital rotation', '美联储与政策观察：意图、战区与资本轮动') }} →</a></div>
      </div>
    </div>
  </div>
