  {# dlg-fed: Fed Probability detail — outcome distribution + upcoming meetings #}
  <div class="mx5-dlg" id="dlg-fed" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Fed Probability — Full Outlook</span><span class="l-zh">美联储概率 — 完整展望</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {% if prediction_markets and prediction_markets.events %}
        {% for _fed_ev in prediction_markets.events %}
        {% set _fed_top = _fed_ev.outcomes | sort(attribute='prob',reverse=true) | first %}
        {# _fed_out_zh outcome→ZH map is defined once above (Fed · Market Pricing strip) #}
        <div style="margin-bottom:24px">
          <div class="mx5-dlg-eyebrow"><span class="l-en">{{ _fed_ev.label_en }}</span><span class="l-zh">{{ _fed_ev.label_zh }}</span></div>
          <div class="mx5-dlg-sep"></div>
          {# Lead: top outcome #}
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
            <div style="font-size:28px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--mx5-accent,#22d97a);line-height:1">{{ _fed_top.prob | int }}<span style="font-size:14px;font-weight:500;color:var(--ink-2,rgba(255,255,255,.6))">%</span></div>
            <div>
              <div style="font-size:14px;font-weight:700"><span class="l-en">{{ _fed_top.outcome }}</span><span class="l-zh">{{ _fed_out_zh.get(_fed_top.outcome, _fed_top.outcome) }}</span></div>
              <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">market's top-probability outcome &middot; {{ _fed_ev.title }}</span><span class="l-zh">市场最高概率结果 &middot; {{ _fed_ev.title }}</span></div>
            </div>
          </div>
          {# All outcomes as horizontal bar rows #}
          {% set _fed_sorted_outs = _fed_ev.outcomes | sort(attribute='prob',reverse=true) %}
          {% for oc in _fed_sorted_outs %}
          {% set _ocp = oc.prob | float %}
          {% set _is_top2 = (oc.outcome == _fed_top.outcome) %}
          <div style="margin-bottom:8px">
            <div style="display:flex;justify-content:space-between;margin-bottom:3px">
              <span style="font-size:12px;font-weight:{{ '700' if _is_top2 else '400' }};color:{{ 'var(--mx5-accent,#22d97a)' if _is_top2 else 'var(--ink-2,rgba(255,255,255,.6))' }}">
                <span class="l-en">{{ oc.outcome }}</span><span class="l-zh">{{ _fed_out_zh.get(oc.outcome, oc.outcome) }}</span>
              </span>
              <span style="font-size:12px;font-variant-numeric:tabular-nums;font-weight:600;color:{{ 'var(--mx5-accent)' if _is_top2 else 'var(--ink-2,rgba(255,255,255,.6))' }}">{{ _ocp | int }}%{% if oc.chg_pp is defined and oc.chg_pp is not none and oc.chg_pp != 0 %}<span style="font-size:10px;margin-left:4px;color:{{ 'var(--up,#22d97a)' if oc.chg_pp > 0 else 'var(--down,#ef4444)' }}">{{ '%+.1f' | format(oc.chg_pp) }}pp</span>{% endif %}</span>
            </div>
            <div style="height:5px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden">
              <div style="height:100%;width:{{ _ocp }}%;background:{{ 'var(--mx5-accent,#22d97a)' if _is_top2 else 'rgba(255,255,255,.22)' }};border-radius:3px;transition:width .4s"></div>
            </div>
          </div>
          {% endfor %}
          {# Attribution #}
          {% if prediction_markets.source is defined %}
          <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));text-align:right;margin-top:4px"><span class="l-en">Source: {{ prediction_markets.source }}</span><span class="l-zh">来源: {{ prediction_markets.source }}</span></div>
          {% endif %}
          {% if _fed_ev.end_date is defined %}
          <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));text-align:right"><span class="l-en">Resolves {{ _fed_ev.end_date }}</span><span class="l-zh">结算日 {{ _fed_ev.end_date }}</span></div>
          {% endif %}
        </div>
        {% endfor %}
        {% else %}
        <div style="text-align:center;padding:40px 0;color:var(--ink-3,rgba(255,255,255,.36));font-size:13px">
          <span class="l-en">Fed pricing data is accruing — check back after the next nightly update.</span>
          <span class="l-zh">美联储定价数据积累中 — 请在下次每晚更新后查看。</span>
        </div>
        {% endif %}
        {# Policy lever note #}
        {% if policy_lever is defined and policy_lever %}
        {% set _dlg_PL = policy_lever %}
        <div class="mx5-dlg-sep"></div>
        <div style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));line-height:1.6">
          <strong><span class="l-en">Policy Lever</span><span class="l-zh">政策杠杆</span></strong> &mdash;
          <span class="l-en">{{ {'QUIET':'No active policy pressure at this time.','ELEVATED':'Elevated — watch for repricing.','ARMED':'Active — policy repricing underway.'}.get(_dlg_PL.get('state','QUIET'), 'Quiet.') }}</span>
          <span class="l-zh">{{ {'QUIET':'当前无积极政策压力。','ELEVATED':'警戒 — 留意重定价风险。','ARMED':'已触发 — 政策重定价进行中。'}.get(_dlg_PL.get('state','QUIET'), '平静。') }}</span>
        </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# dlg-sentiment: Market Sentiment legs breakdown + dial #}
  <div class="mx5-dlg" id="dlg-sentiment" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Market Sentiment — Breakdown</span><span class="l-zh">市场情绪 — 详细分解</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {% set _dlg_fg = fear_greed if (fear_greed is defined and fear_greed) else {} %}
        {% set _dlg_fg_dial = (_dlg_fg.get('dial') or 50) | float %}
        {% set _dlg_fg_label_en = _dlg_fg.get('label_en') or 'Neutral' %}
        {% set _dlg_fg_label_zh = _dlg_fg.get('label_zh') or '中性' %}
        {% set _dlg_fg_col = '#22d97a' if _dlg_fg_dial > 60 else ('#ef4444' if _dlg_fg_dial < 40 else '#f59e0b') %}
        {# Header: composite score #}
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px">
          <div style="font-size:40px;font-weight:800;color:{{ _dlg_fg_col }};line-height:1;font-variant-numeric:tabular-nums">{{ _dlg_fg_dial | int }}</div>
          <div>
            <div style="font-size:18px;font-weight:700;color:{{ _dlg_fg_col }}"><span class="l-en">{{ _dlg_fg_label_en }}</span><span class="l-zh">{{ _dlg_fg_label_zh }}</span></div>
            <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">Composite sentiment · 0 = Extreme Fear · 100 = Extreme Greed</span><span class="l-zh">综合情绪 · 0=极度恐慌 · 100=极度贪婪</span></div>
          </div>
        </div>
        <div class="mx5-dlg-sep"></div>
        {# Legs included #}
        {% set _dlg_fg_legs = _dlg_fg.get('legs_included') or [] %}
        {% if _dlg_fg_legs %}
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:10px"><span class="l-en">What the composite measures</span><span class="l-zh">综合指数的构成</span></div>
        {% for leg in _dlg_fg_legs %}
        {% set _lgp = (leg.pct or 50) | float %}
        {% set _lgcol = '#22d97a' if _lgp > 60 else ('#ef4444' if _lgp < 40 else '#f59e0b') %}
        <div class="mx5-dlg-factor-row">
          <div>
            <div class="mx5-dlg-factor-name"><span class="l-en">{{ leg.name_en }}</span><span class="l-zh">{{ leg.name_zh or leg.name_en }}</span></div>
