  <!-- ============ MARKET RISK RADAR v2 (engine/risk_radar.py) — primary top-of-page risk read ============ -->
  {% set RR = latest.risk_radar %}
  {% if RR and RR.state %}
  {% set rrcol = 'var(--act)' if RR.state=='risk-off' else ('var(--orange)' if RR.state=='elevated' else ('var(--warn)' if RR.state=='caution' else ('var(--muted)' if RR.state=='watch' else 'var(--up)'))) %}
  {% set rrglow = 'rgba(224,85,85,.55)' if RR.state=='risk-off' else ('rgba(224,139,69,.5)' if RR.state=='elevated' else 'rgba(224,160,48,.4)') %}
  {% set rricon = '🛑' if RR.state=='risk-off' else ('🚨' if RR.state=='elevated' else ('⚠️' if RR.state=='caution' else ('👀' if RR.state=='watch' else '✅'))) %}
  <div class="panel span12{% if RR.alert %} rr-float rr-loud{% endif %}" id="risk-radar" style="--rr:{{ rrcol }};--rs-glow:{{ rrglow }}">
    <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px">
      <div class="rr-head">{{ rricon }} {{ t('Market Risk Radar', '市场风险雷达') }} — {{ t(RR.dominant_label_en or 'calm', RR.dominant_label_zh or '平静') }}
        {{ help('An evidence-gated, regime-typed, genuinely-LEADING drawdown-risk radar (engine/risk_radar.py). Five scare-types (credit / rates / bubble / growth = validated leading; vol = display only — needs deep options-flow data) are each built ONLY from signals that pass a strict day-level-lift backtest (research/RISK_ENGINE_V2_FINDINGS.md). LOUD + EARLY but tiered: the quiet watch/caution tiers are early and high-recall; the LOUD banner is gated to fire only when the broad tape is breaking (SPY<200dma + weak breadth) -> ~2.3x base-rate precision, ~17% of days. The drawdown odds ESCALATE with intensity + conjunction. Every call is graded forward and an Opus loop retunes the calibration from its mistakes (within bounds, behind a do-no-harm backtest). De-risk response is SIZING, not selection; the validated regime quad is untouched.', '基于证据闸、按风险类型分型、真正“领先”的回撤风险雷达（engine/risk_radar.py）。五类风险（信用/利率/泡沫/增长=经验证领先；波动=仅展示，需期权流数据），每类仅由通过严格日级提升回测的信号构成。响亮但分层：静默的watch/caution层早且高召回；响亮横幅仅在大盘破位（SPY<200日均线+宽度走弱）时触发——约2.3倍基准精度、约17%的交易日。回撤概率随强度与共振上升。每次判断都会前向评判，Opus循环据其错误在边界内（经“无害”回测）再校准。应对是调整仓位而非选股；不改变经验证的区制四象限。') }}
      </div>
      <div class="rr-head">{{ RR.state|upper }}{% if RR.top_score is not none %} · {{ RR.top_score|round|int }}/100{% endif %}</div>
    </div>
    <p class="muted sm" style="margin:4px 0 9px">{{ t(RR.headline_en, RR.headline_zh) }}</p>
    {% if RR.drawdown_prob and RR.drawdown_prob.h21 is not none %}
    {% set dp = RR.drawdown_prob %}
    <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 11px;margin-bottom:9px">
      <span class="sm" style="font-weight:700">{{ t('Drawdown odds (≥5% pullback, escalating)', '回撤概率（≥5%，递增）') }}:</span>
      <span class="rr-prob"> 5d <b>{{ (dp.h5*100)|round|int }}%</b> · 10d <b>{{ (dp.h10*100)|round|int }}%</b> · 21d <b style="color:{{ rrcol }}">{{ (dp.h21*100)|round|int }}%</b></span>
      <span class="muted sm"> ({{ dp.lift_h21 }}× {{ t('base', '基准') }} {{ (dp.base_h21*100)|round|int }}%)</span>
    </div>
    {% endif %}
    {% if RR.scares %}
    <div style="display:flex;flex-wrap:wrap;gap:7px;margin-bottom:8px">
    {% for s in RR.scares %}
      {% set sb = 'var(--act)' if s.band=='risk-off' else ('var(--orange)' if s.band=='elevated' else ('var(--warn)' if s.band=='caution' else ('var(--muted)' if s.band=='watch' else 'var(--line)'))) %}
      <div class="rr-scare" style="border-left:3px solid {{ sb }}">
        <div class="sm" style="font-weight:700">{{ t(s.label_en, s.label_zh) }} <span style="color:{{ sb }}">{{ s.score|round|int }}</span> <span class="muted" style="font-size:10px">[{{ s.tier }}]</span></div>
        {% for l in s.firing_legs[:3] %}<span class="rr-chip">{{ l.leg }} {{ (l.pctile*100)|round|int }}%{% if l.confirmed %} ✓{% endif %}{% if l.lift_2020 %} · {{ l.lift_2020 }}×{% endif %}</span>{% endfor %}
      </div>
    {% endfor %}
    </div>
    {% endif %}
    {% if RR.context_gate %}
    <div class="sm" style="margin-bottom:5px"><b>{{ t('Loud-alert gate', '大警报闸') }}:</b>
      {% if RR.context_gate.met %}<span style="color:{{ rrcol }}">{{ t('OPEN — broad tape breaking (SPY<200dma + weak breadth)', '开 — 大盘破位（SPY<200日均线+宽度弱）') }}</span>
      {% else %}<span class="muted">{{ t('shut — broad tape intact; quiet tier only (narrow/fast events need options-flow data)', '关 — 大盘未破；仅静默层（窄幅/快速事件需期权流数据）') }}</span>{% endif %}
    </div>
    {% endif %}
    <div class="sm" style="margin-bottom:6px"><b>{{ t('Do', '应对') }}:</b> {{ t(RR.reader_contract, RR.reader_contract) }}{% if RR.gross_factor and RR.gross_factor < 1 %} · {{ t('suggested gross', '建议总仓位') }} ×{{ '%.2f'|format(RR.gross_factor) }}{% endif %}</div>
    {% if RR.forward_log and RR.forward_log.n_graded %}
    {% set fl = RR.forward_log %}
    <div class="muted" style="font-size:11px;border-top:1px solid var(--line);padding-top:6px">🧾 {{ t('Self-audit', '自检') }}: {{ fl.n_graded }} {{ t('graded calls', '已评判') }}{% if fl.alert_precision is not none %} · {{ t('alert precision', '警报精度') }} {{ (fl.alert_precision*100)|round|int }}%{% endif %}{% if fl.recall_dd5_h21 is not none %} · {{ t('recall', '召回') }} {{ (fl.recall_dd5_h21*100)|round|int }}%{% endif %}{% if fl.n_false_pos %} · {{ fl.n_false_pos }} {{ t('false alarms', '误报') }}{% endif %} — {{ t('Opus retunes from these', 'Opus据此再校准') }}</div>
    {% endif %}
    {% if RR.flow_status and not RR.flow_status.mature %}
    <div class="muted" style="font-size:11px;margin-top:4px">⏳ {{ t('Vol-event detection accruing', '波动事件探测累积中') }}: {{ t('put/call', '认沽/认购') }} {{ RR.flow_status.putcall_rows }}/{{ RR.flow_status.min_history }} · GEX {{ RR.flow_status.gex_rows }}/{{ RR.flow_status.min_history }} {{ t('days — deep options-flow history is not freely available, so these legs accrue forward and self-validate via the Opus loop', '天 — 深度期权流历史无法免费获取，故这些因子前向累积并经Opus循环自我验证') }}</div>
    {% endif %}
    <div class="muted" style="font-size:10.5px;margin-top:5px">{{ t(RR.disclaimer, RR.disclaimer) }}</div>
  </div>
  {% endif %}

  <!-- ============ EARLY RISK-STATE BANNER (engine/risk_state.py) — fallback when Risk Radar v2 absent ============ -->
  {% set RS = latest.risk_state %}
  {% if not latest.risk_radar and RS and RS.score is not none and RS.state in ['caution','elevated','risk-off'] %}
  {% set rscol = 'var(--act)' if RS.state=='risk-off' else ('var(--orange)' if RS.state=='elevated' else 'var(--warn)') %}
  {% set rsglow = 'rgba(224,85,85,.55)' if RS.state=='risk-off' else ('rgba(224,139,69,.5)' if RS.state=='elevated' else 'rgba(224,160,48,.4)') %}
  {% set rsicon = '🛑' if RS.state=='risk-off' else ('🚨' if RS.state=='elevated' else '⚠️') %}
  <div class="panel span12{% if RS.alert %} rs-float rs-loud{% endif %}" id="risk-state" style="--rs:{{ rscol }};--rs-glow:{{ rsglow }}">
    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div class="rs-head">{{ rsicon }} {{ t('Market risk state', '市场风险状态') }}: {{ t(RS.label_en, RS.label_zh) }}
        {{ help('A fused EARLY-warning risk state from the equity-internal detectors the credit-weighted macro gauge misses: complacency / hidden-fragility, breadth divergence, dealer-gamma posture, vol-term structure, HY + HYG-TLT credit, plus turning-point and cross-asset confirms. Leading positioning/vol/breadth legs are weighted far above the slow credit/recession legs, so this LEADS the macro-risk gauge into a positioning/vol/breadth blow-off (e.g. the 2026-06-23 semi unwind, when macro-risk still read low). A conjunction-based CONTEXT, not validated alpha: the de-risk response is SIZING — de-gross, favour good entries over chasing extended leaders — never stock selection, and it does not alter the validated regime quad. See research/RISK_LAYER_DESIGN.md.', '融合的“早期”风险状态，取自信用加权宏观指标看不到的股票内部探测器：自满度／隐性脆弱、宽度背离、做市商Gamma、波动期限结构、HY 与 HYG-TLT 信用，外加拐点与跨资产确认。领先的仓位／波动／宽度因子权重远高于缓慢的信用／衰退因子，因此在仓位／波动／宽度型见顶中领先于宏观风险指标（如 2026-06-23 半导体崩跌时宏观风险仍读数偏低）。这是基于“组合共振”的背景，而非经验证的超额收益：应对是调整仓位——降低敞口、择优入场而非追逐已延展的龙头——绝非选股，且不改变经验证的区制四象限。详见 research/RISK_LAYER_DESIGN.md。') }}
      </div>
      <div class="rs-head rs-score">{{ RS.score|round|int }}<span class="muted" style="font-size:13px;font-weight:600">/100</span></div>
    </div>
    <p class="muted sm" style="margin:4px 0 10px">{{ t(RS.headline_en, RS.headline_zh) }}</p>
    {% if RS.drivers %}
    <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 12px">
      <div class="sm" style="font-weight:700;margin-bottom:5px">{{ t('What is firing', '正在触发的因子') }}</div>
      {% for d in RS.drivers[:5] %}
      <div class="rs-driver sm">
        <span class="rs-bar" style="width:{{ (d.intensity*60)|round|int + 8 }}px"></span>
        <span>{{ t(d.detail_en, d.detail_zh) }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <div class="sm" style="margin-top:9px"><b>{{ t('Do', '应对') }}:</b> {{ t(RS.reader_contract, RS.reader_contract) }}</div>
    <div class="muted" style="font-size:11px;margin-top:6px">{{ t(RS.disclaimer, RS.disclaimer) }}</div>
  </div>
  {% endif %}

  {# mtf-monitor (Multi-timeframe technical monitor) retired — folded into the Market State command-center #}

  <!-- ============ MACRO NOWCAST · CONDITIONS · RISK APPETITE ============ -->
  {% if latest.dislocation %}
  {% set DL = latest.dislocation %}
  {% set DI = DL.inputs %}
  {% set vcolor = 'var(--up)' if DL.verdict=='buyable_washout' else ('var(--down)' if DL.verdict=='stand_aside' else 'var(--muted)') %}
  {% if DL.dislocation_active %}{# only renders when a real dislocation is firing; CSS floats it to the very top #}
  <div class="panel span12 dislo-lit" id="dislocation" style="--lit:{{ vcolor }}">
    <h2>🚦 {{ t('Dislocation Gate-1 · buyable washout vs falling knife', '错位一道闸 · 可买入错杀 对 接飞刀') }}
      {{ help("A risk FILTER that sits in FRONT of the capitulation gauge: when a stress dislocation hits (VIX panic, a >10% drawdown, a variance-premium extreme or VIX backwardation), it asks ONE question — is the Fed put present? PUT-ABSENT = a recession is underway (real-time Sahm >= 0.50) OR inflation locks the Fed (sustained 10y breakeven >= 2.5%). The whole edge is in REFUSING the falling knife (2000/2008/2022), not in catching the bounce — measured on SPY 1997-2026, see research/DISLOCATION_VALIDATION.md.", "位于恐慌触底指标之前的风险过滤器：当压力错位出现（VIX 恐慌、>10% 回撤、方差溢价极端或 VIX 倒挂）时，它只问一个问题 — 美联储托底是否在位？托底缺失＝衰退进行中（实时 Sahm ≥ 0.50）或通胀锁住美联储（持续十年期盈亏平衡 ≥ 2.5%）。全部优势在于拒绝接飞刀（2000／2008／2022），而非抄到反弹 — 基于标普 1997-2026 实测。") }}
    </h2>
    <p class="muted sm" style="margin:-4px 0 10px">{{ t('A risk filter, not a buy signal. The edge is in refusing the knife, not catching the bounce — judged on drawdown, not return.', '这是风险过滤器而非买入信号。优势在于拒绝接飞刀，而非抄到反弹 — 以回撤而非回报衡量。') }}</p>
    <div class="grid">

      <!-- verdict hero -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ vcolor }};border-radius:8px;padding:12px 14px">
        <div style="font-size:20px;font-weight:700;color:{{ vcolor }}">
          {% if DL.verdict=='buyable_washout' %}{{ t('Buyable washout', '可买入的错杀') }}
          {% elif DL.verdict=='stand_aside' %}{{ t('Stand aside — falling knife', '观望 — 接飞刀风险') }}
          {% else %}{{ t('No acute dislocation', '无急性错位') }}{% endif %}
        </div>
        <div class="muted sm" style="margin-top:6px">
          {% if DL.verdict=='buyable_washout' %}{{ t('A stress dislocation with the Fed put intact (no recession, inflation not blocking easing). Historically these mean-revert with shallower median drawdown — confirm into stabilization, do not anticipate.', '压力错位且美联储托底在位（无衰退、通胀不阻碍宽松）。历史上此类回归均值且中位回撤更浅 — 在企稳中确认，勿提前抢跑。') }}
          {% elif DL.verdict=='stand_aside' %}{{ t('A stress dislocation with the Fed put ABSENT. This is the 2000/2008/2022 regime where the same capitulation signals kept falling.', '压力错位且美联储托底缺失。这是 2000／2008／2022 情形，同样的恐慌信号仍持续下跌。') }}
          {% else %}{{ t('Markets are not in a stress washout — the filter is dormant and lights up only on a real dislocation.', '市场未处于压力抛售 — 过滤器休眠，仅在真正错位时点亮。') }}{% endif %}
        </div>
      </div>

      <!-- Fed-put master switch -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        {% set pcolor = 'var(--up)' if DL.fed_put else 'var(--down)' %}
        <div style="font-weight:700;margin-bottom:6px">{{ t('Fed-put master switch', '美联储托底主开关') }}
          {{ help("The one out-of-sample-stable discriminator (holds in BOTH 1997-2011 and 2012-2025). PUT-ABSENT = recession underway (Sahm >= 0.50) OR inflation locks the Fed (sustained 10y breakeven >= 2.5%). Primary trend is shown as context but adds little on top of the switch.", "唯一在样本外稳定的判别器（1997-2011 与 2012-2025 两半区均成立）。托底缺失＝衰退进行中（Sahm ≥ 0.50）或通胀锁住美联储（持续十年期盈亏平衡 ≥ 2.5%）。主趋势作为背景显示，但在开关之上增益有限。") }}
        </div>
        <div style="font-size:18px;font-weight:700;color:{{ pcolor }}">
          {% if DL.fed_put %}{{ t('Put present', '托底在位') }}{% else %}{{ t('Put ABSENT', '托底缺失') }}{% endif %}</div>
        <div class="muted sm" style="margin-top:5px">Sahm <b>{{ '%.2f'|format(DI.sahm) if DI.sahm is not none else '—' }}</b>
          · {{ t('10y breakeven', '十年盈亏平衡') }} <b>{{ '%.2f'|format(DI.breakeven_10y_1m) if DI.breakeven_10y_1m is not none else '—' }}%</b>
          · {{ t('trend', '趋势') }} <b>{{ t('up', '上行') if DI.primary_trend=='up' else t('down', '下行') }}</b></div>
        {% if not DL.fed_put %}
        <div class="sm" style="margin-top:5px;color:var(--down)">
          {% if DI.sahm is not none and DI.sahm >= 0.5 %}⚑ {{ t('recession underway (Sahm)', '衰退进行中（Sahm）') }}{% endif %}
          {% if DI.breakeven_10y_1m is not none and DI.breakeven_10y_1m >= 2.5 %}{% if DI.sahm is not none and DI.sahm >= 0.5 %} · {% endif %}⚑ {{ t('inflation locks the Fed', '通胀锁住美联储') }}{% endif %}
        </div>
        {% endif %}
      </div>

      {% if DL.dislocation_active %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">{{ t('Stress triggers firing', '触发的压力信号') }}</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px">
          {% if DI.vix is not none and DI.vix > 30 %}<span class="badge" style="font-size:11px">{{ t('VIX panic', 'VIX 恐慌') }} {{ DI.vix }}</span>{% endif %}
          {% if DI.spy_drawdown_pct is not none and DI.spy_drawdown_pct <= -10 %}<span class="badge" style="font-size:11px">{{ t('drawdown', '回撤') }} {{ DI.spy_drawdown_pct }}%</span>{% endif %}
          {% if DI.vrp_pctile is not none and DI.vrp_pctile > 0.9 %}<span class="badge" style="font-size:11px">{{ t('VRP extreme', 'VRP 极端') }}</span>{% endif %}
          {% if DI.vix_term is not none and DI.vix_term >= 1 %}<span class="badge" style="font-size:11px">{{ t('VIX backwardation', 'VIX 倒挂') }} {{ '%.2f'|format(DI.vix_term) }}</span>{% endif %}
          {% if DI.capitulation_active %}<span class="badge" style="font-size:11px;color:var(--up)">{{ t('capitulation', '恐慌触底') }} {{ DI.capitulation_signals|length }}{% if DI.capitulation_strong %} ⚑{% endif %}</span>{% endif %}
        </div>
        {% if DL.capitulation_caveat %}
        <div class="sm" style="margin-top:7px;color:var(--down)">⚠ {{ t('The capitulation gauge is firing, but the Fed put is absent — its measured bounce does NOT apply here (the falling-knife regime).', '恐慌触底指标在触发，但美联储托底缺失 — 其实测反弹在此不适用（接飞刀情形）。') }}</div>
        {% endif %}
      </div>
      {% endif %}

      {% if DL.catalyst_narrative %}
      {% set CN = DL.catalyst_narrative %}
      {% set cncolor = 'var(--up)' if CN.agreement=='corroborates' else 'var(--warn)' %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ cncolor }};border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">🧠 {{ t('Catalyst cross-check', '催化交叉验证') }}
          {{ help("An AI read of the actual catalyst TEXT (engine/catalyst_tone.py, DeepSeek) cross-checked against the Fed-put switch: does the document read as a reversible washout or a structural break? CONTEXT ONLY — it never changes the verdict; the validated gate governs. Shown only on an active dislocation when the read is confidence-passed and quote-verified.", "对实际催化文本的 AI 解读（engine/catalyst_tone.py，DeepSeek）与美联储托底开关的交叉验证：文档解读为可逆抛售还是结构性断裂？仅供背景 —— 绝不改变判定，以经验证的一道闸为准。仅在活跃错位且解读通过置信度与引文核验时显示。") }}
        </div>
        <div style="margin-bottom:5px;display:flex;flex-wrap:wrap;gap:6px">
          <span class="badge" style="font-size:11px;color:{{ cncolor }}">{% if CN.agreement=='corroborates' %}{{ t('corroborates', '印证') }}{% else %}{{ t('diverges', '背离') }}{% endif %}</span>
          <span class="badge" style="font-size:11px">{{ t('catalyst reads', '催化解读') }}: <span class="l-en">{{ CN.shock_reversible }}</span><span class="l-zh">{{ CN.shock_reversible_zh or CN.shock_reversible }}</span></span>
        </div>
        <div class="muted sm"><span class="l-en">{{ CN.note }}</span><span class="l-zh">{{ CN.note_zh or CN.note }}</span></div>
      </div>
      {% endif %}

      {% if DL.geo_reversibility %}
      {% set GR = DL.geo_reversibility %}
      {% set grcolor = 'var(--up)' if GR.agreement=='corroborates' else 'var(--warn)' %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ grcolor }};border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">🌍 {{ t('Geopolitical reversibility', '地缘可逆性') }}
          {{ help("A DETERMINISTIC reversibility cross-check from the GPR threat/act split (Caldara-Iacoviello, AER 2022): the THREAT component of geopolitical risk historically reverts (~3 months) while realized ACTS persist. The free, always-available complement to the AI catalyst cross-check above — shown only on an active dislocation when geopolitical risk is elevated (≥80th pct) and the threat/act mix has a clear lean. CONTEXT ONLY — it never changes the verdict; the validated Fed-put gate governs.", "基于 GPR 威胁／行动分量的确定性可逆性交叉验证（Caldara-Iacoviello，AER 2022）：地缘风险的「威胁」分量历史上往往回落（约3个月），而已发生的「行动」更持久。这是上方 AI 催化交叉验证的免费、始终可用的补充 —— 仅在活跃错位、地缘风险偏高（≥80百分位）且威胁／行动结构有明确倾向时显示。仅供背景 —— 绝不改变判定，以经验证的美联储托底闸为准。") }}
        </div>
        <div style="margin-bottom:5px;display:flex;flex-wrap:wrap;gap:6px">
          <span class="badge" style="font-size:11px;color:{{ grcolor }}">{% if GR.agreement=='corroborates' %}{{ t('corroborates', '印证') }}{% else %}{{ t('diverges', '背离') }}{% endif %}</span>
          <span class="badge" style="font-size:11px">{{ t('GPR reads', '地缘解读') }}: <span class="l-en">{{ GR.reversibility }}</span><span class="l-zh">{{ GR.reversibility_zh or GR.reversibility }}</span> ({{ t('led by', '主导') }} {{ t('threats', '威胁') if GR.lean=='threat' else t('acts', '行动') }}{% if GR.gpr_pct is not none %}, {{ GR.gpr_pct }}{{ t('th pct', '百分位') }}{% endif %})</span>
        </div>
        <div class="muted sm"><span class="l-en">{{ GR.note }}</span><span class="l-zh">{{ GR.note_zh or GR.note }}</span></div>
      </div>
      {% endif %}

      {% if DL.gate2 and DL.gate2.state not in ('dormant', 'unknown') %}
      {% set g2 = DL.gate2 %}
      {% set g2color = 'var(--up)' if g2.state=='confirmed' else ('var(--warn)' if g2.state=='awaiting_confirm' else 'var(--muted)') %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ g2color }};border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">{{ t('Gate-2 entry timer', '二道闸 · 入场时机') }}
          {{ help("The entry TIMER — it arms ONLY once Gate-1 says buyable, and it is a coincident CONFIRM, never anticipation: it waits for the VIX term structure to un-invert (backwardation back to contango), which historically lags the VIX peak by ~13 sessions. MEASURED on matched buyable washouts (2006+): waiting for the un-inversion lifted hit-rate 61->67%, median 3-month return +2.2->+4.6% and shallowed median drawdown -4.5->-2.9% — but the 1-in-10 tail was marginally worse. A confirm, not a bottom-caller.", "入场时机器 — 仅在一道闸判定可买入后才启动，且是同步确认而非提前预判：它等待 VIX 期限结构回正（由倒挂转为正向），历史上滞后 VIX 峰值约 13 个交易日。基于匹配的可买入错杀样本（2006+）实测：等待回正将胜率由 61% 提升至 67%，三月中位回报 +2.2% 升至 +4.6%，中位回撤由 −4.5% 收窄至 −2.9% — 但 1/10 尾部略差。这是确认，而非抄底。") }}
        </div>
        <b style="color:{{ g2color }}">
          {% if g2.state=='confirmed' %}{{ t('Re-entry confirmed', '入场已确认') }}
          {% elif g2.state=='awaiting_confirm' %}{{ t('Awaiting confirm', '等待确认') }}
          {% else %}{{ t('No timer signal', '无时机信号') }}{% endif %}</b>
        <span class="muted sm"> —
          {% if g2.state=='confirmed' %}{{ t('term structure un-inverted', '期限结构已回正') }}{% if g2.hook_days_ago is not none %} ({{ g2.hook_days_ago }} {{ t('sessions ago', '个交易日前') }}){% endif %}{{ t('; the mean-reversion confirm — wait for it, do not anticipate.', '；均值回归确认 — 等待它，勿提前抢跑。') }}
          {% elif g2.state=='awaiting_confirm' %}{{ t('term structure still backwardated; wait for the un-inversion (historically ~13 sessions after the VIX peak), do not anticipate.', '期限结构仍倒挂；等待回正（历史上约在 VIX 峰值后 13 个交易日），勿提前抢跑。') }}
          {% else %}{{ t('no backwardation to un-invert — the term-structure timer does not apply; rely on Gate-1.', '无倒挂可回正 — 期限结构时机器不适用；以一道闸为准。') }}{% endif %}</span>
      </div>
      {% endif %}

      <!-- measured record (honest) -->
      <div class="span12 muted sm" style="border-top:1px solid var(--line);padding-top:8px;margin-top:2px">
        <b>{{ t('Measured (SPY 1997-2026):', '实测（标普 1997-2026）：') }}</b> {{ t('put-present washouts had ~4pp shallower median 3-month drawdown than put-absent (95% CI [+0.3, +6.3]) — the one effect whose CI excludes zero. The larger hit-rate and 1-year-tail gaps point the same way, but their CIs span zero at ~10 effective crises, so they are carried by sign-consistency (leave-one-year-out 26/28, both split-halves), not significance. A drawdown filter, never alpha.', '托底在位的错杀其中位三月回撤比托底缺失浅约 4 个百分点（95% 置信区间 [+0.3, +6.3]）— 唯一置信区间不含零的效应。更大的胜率与一年尾部差异方向一致，但在约 10 个有效危机样本下置信区间跨零，故由符号一致性支撑（留一年法 26/28、两个样本半区），而非统计显著性。这是回撤过滤器，绝非超额收益。') }}
      </div>

    </div>
  </div>
  {% endif %}{# /dislocation panel — only when active #}
  {% endif %}{# /latest.dislocation — DL/DI/vcolor stay set for the Fear↔Euphoria read #}

  {% if latest.business_cycle and latest.business_cycle.available %}
  {% set BC = latest.business_cycle %}
  {% set SIG = BC.recession_signal %}
  {% set M = BC.measured %}
  {% set phase_c = {'expansion':'var(--up)','slowdown':'#d98a00','contraction':'var(--down)','recovery':'#4c8bf5','unknown':'var(--muted)'} %}
  {% set phase_z = {'expansion':'扩张','slowdown':'放缓','contraction':'收缩','recovery':'复苏','unknown':'未知'} %}
  <div class="panel span12" id="business-cycle">
    <h2>🔄 {{ t('Business cycle — Leading · Coincident · Lagging', '商业周期 — 领先 · 同步 · 滞后') }}
      {{ help("A Conference-Board-style decomposition that keeps three tiers SEPARATE so the lead-lag SEQUENCE is readable: Leading indicators (jobless claims, building permits, capital-goods orders, manufacturing hours, the S&P 500, HY credit spread, the yield curve, consumer expectations) roll over FIRST; months later Coincident indicators (payrolls, real income, industrial production, manufacturing & trade sales) confirm the actual peak; Lagging indicators confirm last. Each tier is inverse-volatility-standardized monthly changes (the CB method), shown as 6-month momentum (red) vs a smoothed trend (blue), NBER recessions shaded. The recession signal is the CB '3 D's' — depth+duration (leading momentum below a calibrated threshold) AND diffusion (broad weakening). Unlike the 0–100 recession-risk score beside it, this does NOT blend the tiers — the separation IS the anticipation. Reverse-engineered free from FRED; measured, see reports/business-cycle-validation.md.", "会议委员会式的三层分解，把层级分开以读出领先-滞后顺序：领先指标（初请失业金、营建许可、资本品订单、制造业工时、标普500、高收益利差、收益率曲线、消费者预期）最先转向；数月后同步指标（非农、实际收入、工业产出、制造与贸易销售）确认真正峰值；滞后指标最后确认。每层为逆波动率标准化的月度变化（CB 方法），以6个月动量（红）对比平滑趋势（蓝）呈现，并标注 NBER 衰退阴影。衰退信号采用 CB“三D”——深度+持续（领先动量低于校准阈值）且扩散广泛走弱。与旁边的0–100衰退风险评分不同，此面板不混合层级——分离本身即前瞻性。基于免费 FRED 数据逆向构建并实测，详见 reports/business-cycle-validation.md。") }}
    </h2>
    <p class="muted sm" style="margin:-4px 0 10px">{{ t('Where the recession-risk score blends everything into one number, this keeps Leading / Coincident / Lagging apart so you can watch the turn propagate. Measured against NBER dates — never eyeballed.', '衰退风险评分把一切揉成一个数字；此面板把领先／同步／滞后分开，让你看清转折如何传导。以 NBER 日期实测，绝非肉眼判断。') }}</p>
    <div class="grid">

      <!-- recession signal status -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        {% set on = SIG.state == 'on' %}
        {% set scolor = 'var(--down)' if on else 'var(--up)' %}
        <div style="font-weight:700;margin-bottom:6px">{{ t('Recession signal', '衰退信号') }} <span class="muted sm">{{ t('CB 3 D’s', 'CB 三D') }}</span></div>
        <div style="font-size:22px;font-weight:700;color:{{ scolor }}">{{ t('ON', '触发') if on else t('OFF', '未触发') }}
          <span class="badge" style="font-size:11px;vertical-align:middle">{{ SIG.months_active }} {{ t('mo active', '月触发') if on else t('mo clear', '月平静') }}</span></div>
        <div class="muted sm" style="margin-top:5px">{{ t('Fires when leading 6-month momentum is below', '当领先6个月动量低于') }} {{ SIG.conditions.roc_threshold }} {{ t('and diffusion at or below', '且扩散度不高于') }} {{ SIG.conditions.diffusion_max|round|int }}.
          {{ t('Now:', '当前：') }} {{ t('depth', '深度') }} {{ '✓' if SIG.conditions.depth else '✗' }} · {{ t('breadth', '广度') }} {{ '✓' if SIG.conditions.breadth else '✗' }}</div>
        <div style="margin-top:7px;padding-top:7px;border-top:1px solid var(--line)">
          {{ t('Cycle phase', '周期阶段') }}: <b style="color:{{ phase_c.get(BC.phase.label,'var(--muted)') }}">{{ t(BC.phase.label, phase_z.get(BC.phase.label, BC.phase.label)) }}</b></div>
      </div>

      <!-- measured track record -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Measured vs NBER', '对照 NBER 实测') }}
          {{ help("The signal backtested against actual NBER recession dates: lead time, false-positive count, hit rate. Effective sample is tiny (~3 point-in-time recessions), so treat the lead as illustrative, not statistically robust. The false alarms are the famous growth scares (1995 soft landing, 2002 double-dip fear, 2022 inflation scare) the real Conference Board LEI also flagged.", "信号针对 NBER 实际衰退日期回测：领先时长、误报次数、命中率。有效样本极小（约3次可点对点回溯的衰退），故领先时长仅供示意，并非统计稳健。误报恰是著名的增长恐慌（1995 软着陆、2002 二次探底担忧、2022 通胀恐慌），真实的 CB 领先指标同样曾误报。") }}</div>
        {% if M %}
        <div class="kv">{{ t('Recessions caught (1985+)', '已捕捉衰退（1985+）') }} <b style="color:var(--up)">{{ M.endo_caught }}/{{ M.endo_recessions }}</b></div>
        <div class="kv">{{ t('Median lead', '中位领先') }} <b>~{{ M.median_lead_months }} {{ t('months', '个月') }}</b> <span class="muted sm">({{ t('mean', '均值') }} {{ M.mean_lead_months }})</span></div>
        <div class="kv">{{ t('False alarms in 40y', '40年误报') }} <b>{{ M.false_positives }}</b> <span class="muted sm">{{ t('— 1995 · 2002 · 2022 growth scares', '— 1995 · 2002 · 2022 增长恐慌') }}</span></div>
        <div class="kv">{{ t('Point-in-time era (1997+)', '可点对点回溯（1997+）') }} <b style="color:var(--up)">{{ M.pit_era_caught }}/{{ M.pit_era_recessions }}</b></div>
        {% else %}<div class="muted sm">{{ t('Not yet calibrated — run scripts/validate_business_cycle.py', '尚未校准 — 运行 scripts/validate_business_cycle.py') }}</div>{% endif %}
      </div>

      <!-- three tiers with mini Zeberg-style charts -->
      {% for tk, ten, tzh, tnote, tnote_z in [
          ('leading','Leading','领先','turns first','最先转向'),
          ('coincident','Coincident','同步','marks the peak','标记峰值'),
          ('lagging','Lagging','滞后','confirms last','最后确认')] %}
      {% set T = BC.tiers.get(tk) %}
      {% if T and T.mom6 is not none %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px;display:flex;align-items:center;gap:16px;flex-wrap:wrap">
        {% set dcolor = 'var(--up)' if T.direction=='rising' else 'var(--down)' %}
        <div style="min-width:190px">
          <div style="font-weight:700">{{ t(ten, tzh) }} <span class="muted sm">{{ t(tnote, tnote_z) }}</span></div>
          <div style="font-size:20px;font-weight:700;color:{{ dcolor }}">{{ '%+.2f'|format(T.mom6) }}
            <span class="muted" style="font-size:12px">{{ t('6mo mom.', '6月动量') }}</span></div>
          <div class="muted sm">{{ t('diffusion', '扩散度') }} {{ T.diffusion|round|int }} · {{ T.n_legs }} {{ t('legs', '指标') }} · {{ T.asof }}</div>
        </div>
        <div style="flex:1;min-width:240px">{{ bcspark(T.spark_mom6, T.spark_trend, BC.spark_recession) }}</div>
      </div>
      {% endif %}
      {% endfor %}

    </div>
    <p class="muted sm" style="margin-top:8px">⚠️ {{ t(BC.caveat, BC.caveat_zh) }} <span class="muted sm">{{ t('Red = 6-month momentum · blue = trend · grey = NBER recessions.', '红=6个月动量 · 蓝=趋势 · 灰=NBER 衰退。') }}</span></p>
  </div>
  {% endif %}

  {% if latest.conditions %}
  {% set C = latest.conditions %}
  {% set FC = C.financial_conditions %}
  {% set RC = C.recession %}
  {% set GN = C.growth_nowcast %}
  {% set IN = C.inflation_nowcast %}
  {% set RA = C.risk_appetite %}
  {% set DR = C.drawdown_risk %}
  {% set CAP = C.capitulation %}
  {% set ST = C.style_tilt %}
  {% set LN = C.labor_nowcast %}
  {% set SC = (latest.playbook or {}).scenario %}
  {% set NH = nowcast_hist or {} %}
  <div class="panel span12" id="conditions">
    <h2>🛰️ {{ t('Macro nowcast · conditions · risk appetite', '宏观即时预测 · 金融条件 · 风险偏好') }}
      {{ help("A complementary lens that runs ALONGSIDE the price-based quad and never alters it: the Fed-research feeds and option-implied risk that a markets-only model misses. Financial conditions (Chicago Fed NFCI — 105 inputs in one z-score), a 0–100 recession-risk score (Sahm rule + smoothed probability + Excess Bond Premium + a term-premium-ADJUSTED curve that strips the 2022–24 false inversion), real-time growth (Weekly Economic Index, GDPNow) and inflation (Atlanta sticky vs flexible CPI) nowcasts, and a cross-asset risk-appetite read (equity vol-risk-premium, VIX term structure, CBOE SKEW, the stock-bond correlation regime, a RORO composite). Free Fed/CBOE data — see research/QUANT_FACTOR_EXPANSION.md.", "一个与价格象限并行、绝不改变象限的补充视角：纯市场模型遗漏的美联储研究数据与期权隐含风险。金融条件（芝加哥联储 NFCI — 105 项输入合成一个 z 分数）、0–100 衰退风险评分（Sahm 法则 + 平滑概率 + 超额债券溢价 + 期限溢价调整后的收益率曲线，剔除 2022–24 的假性倒挂）、实时增长（周度经济指数、GDPNow）与通胀（亚特兰大黏性对弹性 CPI）即时预测，以及跨资产风险偏好（股票波动率风险溢价、VIX 期限结构、CBOE SKEW、股债相关性状态、RORO 综合）。免费美联储／CBOE 数据。") }}
    </h2>
    <div class="grid">

      <!-- Financial conditions -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Financial conditions', '金融条件') }} <span class="muted sm">NFCI</span>
          {{ help("How easy or hard it is to borrow and trade across the whole US financial system — the Chicago Fed's NFCI distils 105 money-market, debt, equity and shadow-banking indicators into one number. 0 = average; NEGATIVE = looser/easier than normal (a tailwind for risk assets); POSITIVE = tighter (a headwind). The percentile shows where today ranks against the last 5 years.", "在整个美国金融体系中借贷与交易的难易程度 — 芝加哥联储 NFCI 将 105 项指标合成一个数。0＝平均；负＝比平常更宽松（风险资产顺风）；正＝更紧（逆风）。百分位表示今日在近五年中的排名。") }}</div>
        {% if FC.nfci is not none %}
        {% set fcolor = 'var(--up)' if FC.state=='loose' else ('var(--down)' if FC.state=='tight' else 'var(--muted)') %}
        <div style="font-size:22px;font-weight:700;color:{{ fcolor }}">{{ '%+.2f'|format(FC.nfci) }}
          <span class="badge" style="font-size:11px;vertical-align:middle">{{ t(FC.state, {'loose':'宽松','tight':'收紧','neutral':'中性'}.get(FC.state, FC.state)) }}{% if FC.trend %} · {{ t(FC.trend, {'tightening':'收紧中','loosening':'宽松中'}.get(FC.trend, FC.trend)) }}{% endif %}</span></div>
        <div class="muted sm" style="margin-top:4px">{{ t('Easier than', '比') }} {{ ((1-FC.nfci_pctile)*100)|round|int if FC.nfci_pctile is not none else '—' }}% {{ t('of the past 5 years', '的近五年更宽松') }}</div>
        {% if FC.subindices %}
        <details class="jarg"><summary>{{ t("what's driving it", '驱动因素') }}</summary>
          <div class="jbody">
            {% set _sub = {'nfci_risk': ('Risk', '风险', 'Volatility & funding stress — how nervous markets are.', '波动与融资压力 — 市场有多紧张。'),
                           'nfci_credit': ('Credit', '信用', 'How cheaply & freely firms and households can borrow.', '企业与家庭借贷的便宜与顺畅程度。'),
                           'nfci_leverage': ('Leverage', '杠杆', 'How much debt & margin is built up in the system.', '系统中累积的债务与保证金规模。')} %}
            {% for k,v in FC.subindices.items() %}{% set m = _sub.get(k) %}{% if m %}
            <div class="jrow"><span class="jk">{{ t(m[0], m[1]) }}</span><span class="jv">{{ t(m[2], m[3]) }}</span><span class="jn" style="color:{{ 'var(--down)' if v>0.05 else ('var(--up)' if v<-0.05 else 'var(--muted)') }}">{{ '%+.2f'|format(v) }}</span></div>
            {% endif %}{% endfor %}
            <div class="muted" style="font-size:10px;margin-top:5px">{{ t('+ = tightening contribution · − = loosening', '正＝收紧贡献 · 负＝宽松贡献') }}</div>
          </div>
        </details>{% endif %}
        {% else %}<div class="muted">—</div>{% endif %}
      </div>

      <!-- Systemic stress (OFR FSI decomposition) -->
      {% set SS = C.systemic_stress %}
      {% if SS and SS.ofr_fsi is not none %}
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Systemic stress', '系统性压力') }} <span class="muted sm">OFR FSI</span>
          {{ help("The OFR Financial Stress Index — a daily gauge built from 33 global market variables. 0 = average stress since 2000; NEGATIVE = calmer than normal, POSITIVE = stressed. Unlike NFCI it splits the reading into five CHANNELS (credit, equity valuation, safe assets, funding, volatility) and three regions (US, other-advanced, EM), so you can see WHERE stress is coming from — the funding leg captures offshore-dollar / cross-currency-basis strain. It is a COINCIDENT gauge: it confirms and explains stress, it does not forecast it. Free OFR data — see research/DATA_SIGNAL_EXPANSION_2026.md.", "OFR 金融压力指数 — 由 33 个全球市场变量构成的每日指标。0＝2000 年以来的平均压力；负＝比平常更平静，正＝有压力。与 NFCI 不同，它把读数拆为五个渠道（信用、股票估值、避险资产、融资、波动）与三个地区（美国、其他发达、新兴市场），可看出压力来自何处 — 融资项捕捉离岸美元/交叉货币基差紧张。这是同步指标：确认并解释压力，而非预测。免费 OFR 数据。") }}</div>
        {% set scolor = 'var(--down)' if SS.state in ('elevated','acute') else ('var(--up)' if SS.state=='calm' else 'var(--muted)') %}
        <div style="font-size:22px;font-weight:700;color:{{ scolor }}">{{ '%+.2f'|format(SS.ofr_fsi) }}
          <span class="badge" style="font-size:11px;vertical-align:middle">{{ t(SS.state, {'calm':'平静','normal':'一般','elevated':'偏高','acute':'急性'}.get(SS.state, SS.state)) }}{% if SS.trend %} · {{ t(SS.trend, {'rising':'上升中','easing':'缓和中'}.get(SS.trend, SS.trend)) }}{% endif %}</span></div>
        <div class="muted sm" style="margin-top:4px">{{ t('More stressed than', '压力高于') }} {{ (SS.ofr_fsi_pctile*100)|round|int if SS.ofr_fsi_pctile is not none else '—' }}% {{ t('of the past 5 years', '的近五年') }}{% if SS.leading_driver %} · {{ t('led by', '主导渠道') }} {{ SS.leading_driver }}{% endif %}</div>
        {% if SS.functional %}
        <details class="jarg"><summary>{{ t('stress by channel', '分渠道压力') }}</summary>
          <div class="jbody">
            {% set _fl = {'credit': ('Credit', '信用', 'Corporate / credit-market stress.', '企业／信用市场压力。'),
                          'equity_valuation': ('Equity valuation', '股票估值', 'Equity drawdown & valuation stress.', '股票回撤与估值压力。'),
                          'safe_assets': ('Safe assets', '避险资产', 'Flight-to-safety demand for Treasuries.', '对国债的避险需求。'),
                          'funding': ('Funding', '融资', 'Money-market & offshore-dollar (x-ccy basis) funding stress.', '货币市场与离岸美元（交叉货币基差）融资压力。'),
                          'volatility': ('Volatility', '波动', 'Cross-asset implied / realized volatility.', '跨资产隐含／已实现波动。')} %}
            {% for k,v in SS.functional.items() %}{% set m = _fl.get(k) %}{% if m %}
            <div class="jrow"><span class="jk">{{ t(m[0], m[1]) }}</span><span class="jv">{{ t(m[2], m[3]) }}</span><span class="jn" style="color:{{ 'var(--down)' if v>0.05 else ('var(--up)' if v<-0.05 else 'var(--muted)') }}">{{ '%+.2f'|format(v) }}</span></div>
            {% endif %}{% endfor %}
            {% if SS.regional %}<div class="muted" style="font-size:10px;margin-top:5px">{{ t('By region', '分地区') }}: {% for k,v in SS.regional.items() %}{{ {'united_states':'US','other_advanced':t('Adv','发达'),'emerging_markets':'EM'}.get(k,k) }} {{ '%+.2f'|format(v) }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
            {% if SS.a2p2_spread_bps is not none or SS.cp_bill_spread_bps is not none %}
            <div class="jrow" style="margin-top:5px"><span class="jk">{{ t('CP spreads', '商票利差') }}</span><span class="jv">{{ t('Commercial-paper credit-quality (A2/P2−AA) & funding (CP−bill) stress.', '商业票据信用质量（A2/P2−AA）与融资（票据−国库券）压力。') }}</span><span class="jn">{% if SS.a2p2_spread_bps is not none %}A2/P2 {{ SS.a2p2_spread_bps|round|int }}bp{% endif %}{% if SS.cp_bill_spread_bps is not none %} · {{ t('CP-bill', '票据') }} {{ SS.cp_bill_spread_bps|round|int }}bp{% endif %}</span></div>{% endif %}
            <div class="muted" style="font-size:10px;margin-top:5px">{{ t('+ = stress contribution · − = calm. A coincident gauge that names the channel — not a timing trigger.', '正＝压力贡献 · 负＝平静。同步指标，用于指明渠道 — 非择时触发器。') }}</div>
          </div>
        </details>{% endif %}
      </div>
      {% endif %}

      <!-- Recession risk -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Recession risk', '衰退风险') }}
          {{ help("A 0–100 score for how close the US economy is to recession, blending four respected signals (the breakdown is under 'what's behind it'). LOW today means the expansion looks intact; it climbs months before a downturn, not on the day. A risk gauge, not a market-timing trigger.", "美国经济离衰退有多近的 0–100 评分，融合四个公认信号（拆解见'背后构成'）。今日低位意味着扩张看起来完好；它在衰退前数月就上升，而非当天。这是风险指标，而非择时触发器。") }}</div>
        {% if RC.score is not none %}
        {% set rcolor = 'var(--down)' if RC.label=='high' else ('var(--warn)' if RC.label=='elevated' else 'var(--up)') %}
        <div style="font-size:22px;font-weight:700;color:{{ rcolor }}">{{ RC.score|round|int }}<span class="muted" style="font-size:13px">/100</span>
          <span class="badge" style="font-size:11px;vertical-align:middle">{{ t(RC.label, {'low':'低','elevated':'偏高','high':'高'}.get(RC.label, RC.label)) }}</span></div>
        <div style="height:7px;border-radius:4px;background:var(--line);margin:7px 0;overflow:hidden"><div style="height:100%;width:{{ RC.score|round|int }}%;background:{{ rcolor }}"></div></div>
        <details class="jarg"><summary>{{ t("what's behind it", '背后构成') }}</summary>
          <div class="jbody">
            <div class="jrow"><span class="jk">Sahm</span><span class="jv">{{ t('The Sahm rule — unemployment rising off its lows (≥0.50). Shown for context; the scored labor leg is jobless claims (it leads Sahm and tested stronger vs NBER).', '萨姆规则 — 失业率从低位回升（≥0.50）。此处为参考；评分采用的劳动力指标为申领失业金（领先萨姆规则，对 NBER 历史检验更强）。') }}</span><span class="jn">{{ '%.2f'|format(RC.sahm) if RC.sahm is not none else '—' }}</span></div>
            <div class="jrow"><span class="jk">{{ t('NY Fed prob','纽约联储概率') }}</span><span class="jv">{{ t('Model odds of recession within 12 months (from the yield curve).', '未来 12 个月衰退的模型概率（源自收益率曲线）。') }}</span><span class="jn">{{ '%.0f'|format(RC.ny_fed_prob) if RC.ny_fed_prob is not none else '—' }}%</span></div>
            <div class="jrow"><span class="jk">EBP</span><span class="jv">{{ t('Excess Bond Premium — fear priced into corporate credit beyond default risk. Above 0 = stress.', '超额债券溢价 — 企业信用中超出违约风险的恐惧定价。大于 0＝压力。') }}</span><span class="jn">{{ '%+.2f'|format(RC.ebp) if RC.ebp is not none else '—' }}</span></div>
            {% if RC.curve_note %}<div class="jrow"><span class="jk">{{ t('Curve','曲线') }}</span><span class="jv">{{ t('10y minus 3m slope — inverted (negative) has preceded most recessions; we adjust it for term premium to strip the 2022–24 false alarm.', '十年期减三个月斜率 — 倒挂（负）曾领先多数衰退；我们对其做期限溢价调整以剔除 2022–24 的假警报。') }}</span><span class="jn">{{ '%+.2f'|format(RC.curve_raw) if RC.curve_raw is not none else '—' }}→{{ '%+.2f'|format(RC.curve_tp_adjusted) if RC.curve_tp_adjusted is not none else '—' }}</span></div>{% endif %}
            {% if RC.components and RC.components.claims is not none %}<div class="jrow"><span class="jk">{{ t('Jobless claims','申领失业金') }}</span><span class="jv">{{ t('4-week-average initial claims surging vs a year ago — a leading labor signal that turns before the unemployment rate (validated vs NBER).', '首次申领失业金4周均值同比飙升 — 领先于失业率的劳动力信号（已对 NBER 验证）。') }}</span><span class="jn">{{ '%.0f'|format(RC.components.claims) }}/100</span></div>{% endif %}
          </div>
        </details>
        {% if DR and DR.score is not none %}
        {% set dcolor = 'var(--down)' if DR.band in ('high','extreme') else ('var(--warn)' if DR.band=='elevated' else 'var(--muted)') %}
        <div class="kv" style="margin-top:7px;padding-top:7px;border-top:1px solid var(--line)">{{ t('Macro-stress (drawdown risk)', '宏观压力（回撤风险）') }}
          {{ help("A LEAN 4-factor macro-stress composite (recession-risk + NFCI + Excess Bond Premium + HY credit spreads; the weak curve/VIX legs were dropped after measurement). It is a DRAWDOWN-RISK gauge, not a return forecast: at the HIGH band the S&P had a ~36% chance of a >10% drawdown over the next 3 months vs ~8% base rate — the cleanest drawdown discriminator we measured (beats quad==Q4 and net-liquidity). Returns still rebound, so this says 'size down / widen stops', not 'sell everything'.", "精简版四因子宏观压力综合（衰退风险＋NFCI＋超额债券溢价＋高收益信用利差；曲线/VIX 经测量后剔除）。这是回撤风险指标而非回报预测：在高位区，标普未来三个月出现 >10% 回撤的概率约 36%（基准约 8%）。") }}
          <b style="float:right;color:{{ dcolor }}">{{ DR.score|round|int }}/100 · {{ t(DR.band, {'low':'低','elevated':'偏高','high':'高','extreme':'极高'}.get(DR.band, DR.band)) }}</b></div>
        <div class="muted sm">{{ t('Chance of a >10% S&P fall in 3 months:', '标普三月内下跌超 10% 的概率：') }} <b style="color:{{ dcolor }}">~{{ DR.dd10_prob_pct }}%</b> <span class="muted">{{ t('(vs ~8% normally)', '（平常约 8%）') }}</span></div>
        {% endif %}
        {% else %}<div class="muted">—</div>{% endif %}
      </div>

      <!-- Growth & inflation nowcast -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Growth & inflation nowcast', '增长与通胀即时预测') }}
          <span class="muted" style="font-weight:400;font-size:11px">· {{ t('hover a metric for its history', '悬停指标查看历史') }}</span></div>

        <div class="kv">
          <span class="hovchart">{{ t('Weekly Economic Index', '周度经济指数') }}<span class="tip">
            <span class="nph"><span class="l-en">Weekly Economic Index</span><span class="l-zh">周度经济指数</span></span>
            <span class="l-en"> — a real-time read on US growth from 10 weekly series (retail, hours, claims, fuel, steel…), scaled to GDP-growth terms. Updates every Thursday, so it sees turns months before quarterly GDP.</span><span class="l-zh"> — 由 10 个周度序列（零售、工时、申领、燃料、钢铁…）合成的实时美国增长读数，换算到 GDP 增速口径。每周四更新，比季度 GDP 提前数月见到拐点。</span>
            {{ nchart(NH.wei) }}</span></span>
          <b>{{ '%.1f'|format(GN.wei) if GN.wei is not none else '—' }}%</b> {{ trendword(NH.wei) }}</div>

        <div class="kv">
          <span class="hovchart">{{ t('GDPNow (Atlanta Fed)', 'GDPNow') }}<span class="tip">
            <span class="nph"><span class="l-en">GDPNow — Atlanta Fed</span><span class="l-zh">GDPNow — 亚特兰大联储</span></span>
            <span class="l-en"> — the Atlanta Fed's running estimate of the CURRENT quarter's GDP growth, rebuilt after every data release. Not a forecast — a nowcast of the quarter in progress.</span><span class="l-zh"> — 亚特兰大联储对当前季度 GDP 增速的滚动估计，每次数据发布后重算。不是预测，而是对进行中季度的即时测算。</span>
            {{ nchart(NH.gdpnow) }}</span></span>
          <b>{{ '%.1f'|format(GN.gdpnow) if GN.gdpnow is not none else '—' }}%</b> {{ trendword(NH.gdpnow) }}</div>

        {% if IN.sticky_ann is not none %}<div class="kv" style="margin-top:4px">
          <span class="hovchart">{{ t('Sticky CPI (persistent)', '黏性 CPI（持续性）') }}<span class="tip">
            <span class="nph"><span class="l-en">Sticky-price CPI</span><span class="l-zh">黏性价格 CPI</span></span>
            <span class="l-en"> — inflation in prices that change SLOWLY (rent, services, insurance). Because they reset infrequently, they capture the persistent, hard-to-shift core of inflation — what the Fed watches.</span><span class="l-zh"> — 调价缓慢的商品价格（房租、服务、保险）。因为很少重设，它们刻画了顽固、难以撼动的通胀核心 — 美联储紧盯的部分。</span>
            {{ nchart(NH.sticky) }}</span></span>
          <b>{{ '%.1f'|format(IN.sticky_ann) }}%</b> {{ trendword(NH.sticky) }}</div>{% endif %}

        {% if IN.flexible_ann is not none %}<div class="kv">
          <span class="hovchart">{{ t('Flexible CPI (transitory)', '弹性 CPI（暂时性）') }}<span class="tip">
            <span class="nph"><span class="l-en">Flexible-price CPI</span><span class="l-zh">弹性价格 CPI</span></span>
            <span class="l-en"> — inflation in prices that move FAST (gas, food, cars). It's noisy and mean-reverting — big swings here are usually transitory, so a flexible-led spike fades faster than a sticky-led one.</span><span class="l-zh"> — 变动迅速的商品价格（汽油、食品、汽车）。噪声大、均值回归 — 这里的大幅波动通常是暂时的，弹性主导的飙升比黏性主导的消退更快。</span>
            {{ nchart(NH.flexible) }}</span></span>
          <b>{{ '%.1f'|format(IN.flexible_ann) }}%</b> {{ trendword(NH.flexible) }}</div>{% endif %}

        {% if IN.read %}<div class="muted sm" style="margin-top:6px;padding-top:6px;border-top:1px solid var(--line)">{{ t('Read:', '判读：') }} <b>{{ t(IN.read, {'persistent (sticky-led)':'持续性（黏性主导）','transitory (flexible-led)':'暂时性（弹性主导）'}.get(IN.read, IN.read)) }}</b>
          {{ help("Which side of inflation is running hotter right now. 'Transitory (flexible-led)' = the gap is driven by the FAST, noisy prices (gas/food/cars), which tend to mean-revert — so this kind of inflation usually fades on its own. 'Persistent (sticky-led)' = the SLOW prices (rent/services) are leading, which is stubborn and what forces the Fed's hand. It compares the two nowcasts above; it is a read on the MIX, not a forecast of the level.", "现在通胀的哪一侧更热。'暂时性（弹性主导）'＝差距由快速、噪声大的价格（汽油/食品/汽车）驱动，往往均值回归，所以这类通胀通常自行消退。'持续性（黏性主导）'＝缓慢价格（房租/服务）领先，顽固且最终迫使美联储行动。它比较上面两个即时预测，判读的是结构而非水平的预测。") }}</div>{% endif %}
      </div>

      <!-- Labor & real-activity nowcast (leading; front-runs payrolls) -->
      {% if LN %}
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Labor & real activity', '劳动力与实体活动') }}
          {{ help("High-frequency, LEADING reads on the real economy that front-run the monthly (and heavily revised) jobs report. Weekly jobless claims (rising = more layoffs), Indeed job postings (labor DEMAND), and the daily withheld income & employment taxes deposited at the Treasury (a near-real-time read on total wages — very hard to game). They turn months before payrolls confirm. Free FRED / Treasury / SF Fed data — see research/REAL_ACTIVITY_NOWCAST.md.", "对实体经济的高频领先读数，抢在月度（且大幅修正）的就业报告之前。每周首次申领失业金（上升＝裁员增多）、Indeed 招聘职位（劳动力需求）、以及财政部每日预扣所得与就业税存款（对总工资的近实时读数，极难操纵）。它们比非农数据提前数月转向。免费 FRED／财政部／旧金山联储数据。") }}
          <span class="muted" style="font-weight:400;font-size:11px">· {{ t('leads payrolls', '领先非农') }}</span></div>

