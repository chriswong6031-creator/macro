<script>
/* Keep .help tooltips on-screen: flip below the icon when it's near the top of
   the viewport, and clamp horizontally near the left/right edges. Hover-only,
   no layout cost until you point at a "?". */
(function(){
  function place(h){
    var r = h.getBoundingClientRect(), vw = window.innerWidth;
    h.classList.toggle('below', r.top < 240);
    h.classList.remove('edge-left','edge-right');
    if (r.left > vw - 170) h.classList.add('edge-right');
    else if (r.left < 170) h.classList.add('edge-left');
  }
  document.addEventListener('pointerover', function(e){
    var h = e.target.closest && e.target.closest('.help');
    if (h) place(h);
  }, true);
})();
</script>
<script>
/* Per-card detail as an ANCHORED DROPDOWN POPOVER (.nb-more-btn opens a fixed floating
   .nb-more panel; JS positions it from the button rect and flips up / clamps to the edge —
   mirrors the .nb-cau placePop idiom). Only one open at a time; closes on ×, outside click,
   or Esc; repositions on scroll/resize. Delegated on document so it works regardless of
   showmore reveal order. */
(function(){
  var openCard = null;
  var LBL_OPEN  = '<span class="l-en">▴ less</span><span class="l-zh">▴ 收起</span>';
  var LBL_SHUT  = '<span class="l-en">▾ details</span><span class="l-zh">▾ 详情</span>';
  function closePop(){
    if (!openCard) return;
    openCard.classList.remove('nb-open');
    var b = openCard.querySelector('.nb-more-btn');
    if (b){ b.setAttribute('aria-expanded','false'); b.innerHTML = LBL_SHUT; }
    openCard = null;
  }
  function place(card){
    var pop = card.querySelector('.nb-more'), btn = card.querySelector('.nb-more-btn');
    if (!pop || !btn) return;
    var r = btn.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight, m = 10;
    var pw = pop.offsetWidth, ph = pop.offsetHeight;
    // horizontal: align the popover's left edge under the button, clamp to viewport
    var left = Math.min(Math.max(m, r.left), Math.max(m, vw - pw - m));
    // vertical: drop below the button; if it would overflow, flip above; else pin near bottom
    var top = r.bottom + 6;
    if (top + ph > vh - m){ var above = r.top - 6 - ph; top = (above >= m) ? above : Math.max(m, vh - ph - m); }
    pop.style.left = left + 'px'; pop.style.top = top + 'px';
  }
  document.addEventListener('click', function(e){
    if (e.target.closest && e.target.closest('.nb-more-x')){ e.preventDefault(); e.stopPropagation(); closePop(); return; }
    var btn = e.target.closest && e.target.closest('.nb-more-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var card = btn.closest('.nbcard'); if (!card) return;
      var wasOpen = (card === openCard);
      closePop();
      if (!wasOpen){
        card.classList.add('nb-open');
        btn.setAttribute('aria-expanded','true'); btn.innerHTML = LBL_OPEN;
        openCard = card;
        place(card);   // .nb-more is display:block now → measurable
      }
      return;
    }
    if (openCard && !(e.target.closest && e.target.closest('.nb-more'))) closePop();
  }, true);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePop(); });
  window.addEventListener('scroll', function(){ if (openCard) place(openCard); }, true);
  window.addEventListener('resize', function(){ if (openCard) place(openCard); });
})();

/* Card-body delegated click handler: clicking the .nbcard div (outside the head anchor,
   the caution btn, the more-btn, or the expander) triggers the head anchor's .click(),
   re-entering the Terminal interceptor naturally (theme.js L142-149 intercepts a[href]).
   This preserves "click a card for the full breakdown" UX post div-restructure.
   nb-spot data-href chips get their own handler (see theme.js addition). */
(function(){
  document.addEventListener('click', function(e){
    var card = e.target.closest && e.target.closest('.nbcard');
    if (!card) return;
    /* skip if click is on an interactive sub-element that handles itself */
    if (e.target.closest('.nb-cau-btn') || e.target.closest('.nb-cau-pop') ||
        e.target.closest('.nb-more-btn') || e.target.closest('.nb-more') ||
        e.target.closest('.nb-spot[data-href]') || e.target.closest('.nb-head-link')) return;
    var headLink = card.querySelector('.nb-head-link');
    if (headLink) { headLink.click(); }
  });
})();
</script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge).
   (Chip explanatory copy uses the theme.js data-tip mechanism instead — one
   repo-standard tooltip; the W2 bespoke chip popover was retired at merge.) */
(function(){
  function placePopCau(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  function closeAllPops(){
    document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
  }
  /* Tap: toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      closeAllPops();
      if (!wasOpen){ placePopCau(wrap); wrap.classList.add('nb-cau-open'); }
      return;
    }
    /* outside tap: close all */
    if (!e.target.closest('.nb-cau-pop')){
      closeAllPops();
    }
  }, true);
  /* Position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var cau = e.target.closest && e.target.closest('.nb-cau');
    if (cau){ placePopCau(cau); return; }
  }, true);
})();
</script>
{% if mode == 'stocks' %}
<script>
/* TS-U3 dash-tape-band + dash-tw-strip + dash-mtf-section JS (mode=stocks only).
   FT-R1/TS-R5: display-tier only; never mutates slow state; no buy verbs.
   FT-R8: graceful absent-file. TS-R1: honest-delay modes. */
(function(){
'use strict';
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function L(en,zh){return'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>';}
function fmtPct(v){if(v==null)return'—';return(v>=0?'+':'')+v.toFixed(2)+'%';}
function clsPct(v){return v==null?'muted':v>=0?'up':'dn';}

function fetchJson(url, cb){
  fetch(url,{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(cb)
    .catch(function(){});
}

/* ────────────────────────────────────────────────────────────────────────
   TAPE BAND (TS-U3 dash-tape-band — dashboard reach; dtp-* idiom)
   ──────────────────────────────────────────────────────────────────────── */
/* basket display-name map: populated by basketdata/baskets.json fetch */
var _dtpNames = {};
function _dtpSlug(id){
  /* prettify raw slug: us_sector_staples → "Us Sector Staples" */
  return id.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});
}
function _dtpNameEn(id){
  return (_dtpNames[id]&&_dtpNames[id].en)||_dtpSlug(id);
}
function _dtpNameZh(id){
  return (_dtpNames[id]&&_dtpNames[id].zh)||_dtpSlug(id);
}

function isChipSuppressed(pulse){ return !pulse || (pulse.mode||'live') !== 'live'; }

/* Derive a single display-state token from pulse fields.
   Returns {cls, en, zh, delay, asofStr}                        */
function _dtpState(pulse){
  var mode    = pulse.mode||'live';
  var session = pulse.session||'closed';
  var ts      = pulse.as_of_quotes||pulse.as_of_utc;
  var asofStr = '';
  if(ts){
    try{
      if(ts.length<=10){ asofStr=ts; }
      else if(mode==='last_rth'&&pulse.settled_close){
        asofStr=new Date(ts).toLocaleString([],{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
      } else {
        asofStr=new Date(ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
      }
    }catch(e){asofStr=ts;}
  }
  /* >12h staleness guard (weekend/holiday frozen file) */
  var builtMs=Date.parse(pulse.as_of_utc||'');
  var stale=isFinite(builtMs)&&(Date.now()-builtMs)>12*3600e3;
  if(stale){
    if(mode==='live'||mode==='delayed'){ mode='last_rth'; pulse.mode='last_rth'; }
    session='closed';
    /* a >12h-old file describes a finished session — never label it POST-MARKET */
    return {cls:'closed', en:'LAST SESSION · SETTLED', zh:'上一交易时段 · 已收盘', asofStr:asofStr, live:false};
  }
  if(mode==='live'){
    if(session==='pre')
      return {cls:'pre', en:'PREMARKET · 15-MIN DELAYED', zh:'盘前 · 15分钟延迟', asofStr:asofStr, live:true};
    return {cls:'live', en:'LIVE · 15-MIN DELAYED', zh:'实盘 · 15分钟延迟', asofStr:asofStr, live:true};
  }
  if(mode==='last_rth'){
    if(pulse.settled_close)
      return {cls:'post', en:'POST-MARKET · SETTLED CLOSE', zh:'盘后 · 当日收盘', asofStr:asofStr, live:false};
    return {cls:'post', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
  }
  if(mode==='eod')
    return {cls:'closed', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
  if(mode==='delayed'){
    var h=pulse.delay_min_median!=null?Math.round(pulse.delay_min_median/60):0;
    return {cls:'warn', en:'DELAYED · ~'+h+'h', zh:'延迟 · 约'+h+'小时', asofStr:asofStr, live:false};
  }
  return {cls:'closed', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
}

function renderTapeBand(pulse){
  var band = document.getElementById('dash-tape-band');
  if(!band) return;
  if(!pulse){band.classList.remove('visible');return;}
  band.classList.add('visible');

  var st = _dtpState(pulse);
  var mode = pulse.mode||'live';

  /* token */
  var tokEl = document.getElementById('dtp-token');
  var tokLbl = document.getElementById('dtp-token-lbl');
  if(tokEl){ tokEl.className='dtp-token '+st.cls; }
  if(tokLbl){ tokLbl.innerHTML=L(esc(st.en),esc(st.zh)); }

  /* as-of */
  var asofEl = document.getElementById('dtp-asof');
  if(asofEl){
    asofEl.innerHTML=st.asofStr?L('as of '+esc(st.asofStr),'截至 '+esc(st.asofStr)):'';
  }

  /* live-mode class for opacity rule */
  if(st.live){ band.classList.add('live-mode'); } else { band.classList.remove('live-mode'); }

  var all=(pulse.baskets||[]).filter(function(b){return b.live_ew_chg_pct!=null&&b.tape_rank!=null;});
  var session=pulse.session||'closed';
  var bodyEl=document.getElementById('dtp-body');
  var fullEl=document.getElementById('dtp-full');
  var moreBtn=document.getElementById('dtp-more');
  var fnEl=document.getElementById('dtp-fn');
  if(!bodyEl) return;

  if(!all.length){
    var loading=(session==='pre'||session==='rth');
    bodyEl.innerHTML='<div class="dtp-empty">'
      +(loading?L('quotes loading…','报价加载中…')
               :L('No tape data for the last session.','上一交易时段暂无行情数据。'))
      +'</div>';
    if(fullEl){fullEl.hidden=true;}
    if(moreBtn){moreBtn.hidden=true;moreBtn.setAttribute('aria-expanded','false');}
    if(fnEl){fnEl.innerHTML='';}
    return;
  }

  all.sort(function(a,b){return b.tape_rank-a.tape_rank;});
  /* laggards only from rows NOT already shown as leaders (sparse days: n<=5 → no laggard group) */
  var top5=all.slice(0,5);
  var bot3=all.length>5?all.slice(Math.max(5,all.length-3)).reverse():[];

  /* proportional bar scale across the shown movers */
  var shown=top5.concat(bot3);
  var maxAbs=0;
  shown.forEach(function(b){var a=Math.abs(b.live_ew_chg_pct);if(a>maxAbs)maxAbs=a;});
  if(!maxAbs)maxAbs=1;

  var flowShown=false, flowAsOf=pulse.day_flow_as_of||null;

  function flowBits(b){
    var f=b.day_flow;
    /* flow is notable when |cmf|>0.05 OR vol_surge>=1.5 (DT-W1a: descriptive only) */
    var hasFlow=f&&((f.cmf!=null&&Math.abs(f.cmf)>0.05)||(f.dollar_vol_surge!=null&&f.dollar_vol_surge>=1.5));
    if(!hasFlow) return null;
    flowShown=true;
    var aoStr=f.as_of||flowAsOf||'';
    var volStr=f.dollar_vol_surge!=null?('×'+Number(f.dollar_vol_surge).toFixed(1)):'';
    var dirEn=f.cmf>0.05?'inflow':(f.cmf<-0.05?'outflow':'balanced');
    var dirZh=f.cmf>0.05?'流入':(f.cmf<-0.05?'流出':'均衡');
    var longEn=f.cmf>0.05?'net inflow':(f.cmf<-0.05?'net outflow':'balanced flow');
    var longZh=f.cmf>0.05?'净流入':(f.cmf<-0.05?'净流出':'资金流均衡');
    return {
      en:(volStr?volStr+' vol · ':'')+dirEn,
      zh:(volStr?volStr+' 量 · ':'')+dirZh,
      tipEn:(volStr?volStr+' vol · ':'')+longEn+(aoStr?' (nightly, as of '+aoStr+')':''),
      tipZh:(volStr?volStr+' 量 · ':'')+longZh+(aoStr?'（每晚，截至 '+aoStr+'）':'')
    };
  }

  function rowHtml(b, ordinal){
    var chg=b.live_ew_chg_pct, isUp=chg>=0;
    var barW=Math.max(4,Math.min(56,Math.round(Math.abs(chg)/maxAbs*56)));
    var nameEn=_dtpNameEn(b.id), nameZh=_dtpNameZh(b.id);
    var mid='';
    var fb=flowBits(b);
    if(fb){
      mid+='<span class="dtp-mflow" data-tip-en="'+esc(fb.tipEn)+'" data-tip-zh="'+esc(fb.tipZh)+'">'
        +'<span class="l-en">'+esc(fb.en)+'</span><span class="l-zh">'+esc(fb.zh)+'</span></span>';
    }
    /* 2d suffix: only when sign flips and |cum_2d| >= 1.0 */
    if(b.cum_2d_pct!=null&&Math.abs(b.cum_2d_pct)>=1.0){
      var flipSign=(chg>=0&&b.cum_2d_pct<0)||(chg<0&&b.cum_2d_pct>=0);
      if(flipSign){
        var d2pct=(b.cum_2d_pct>=0?'+':'')+b.cum_2d_pct.toFixed(1)+'%';
        var d2TipEn=fmtPct(chg)+' today after a '+d2pct+' two-day run — the session move flips the 2-day direction. Descriptive only.';
        var d2TipZh=fmtPct(chg)+' 今日，近两日累计 '+d2pct+' — 当日走势翻转两日方向。仅供参考。';
        mid+='<span class="dtp-2d" data-tip-en="'+esc(d2TipEn)+'" data-tip-zh="'+esc(d2TipZh)+'">2d '+d2pct+'</span>';
      }
    }
    return '<a class="dtp-mrow" href="basket/'+esc(b.id)+'.html">'
      +'<span class="dtp-rank">'+ordinal+'</span>'
      +'<span class="dtp-mname"><span class="l-en">'+esc(nameEn)+'</span><span class="l-zh">'+esc(nameZh)+'</span></span>'
      +mid
      +'<span class="dtp-mpct '+(isUp?'up':'dn')+'">'+fmtPct(chg)+'</span>'
      +'<span class="dtp-mtrack'+(isUp?'':' dn')+'"><span class="dtp-mbar '+(isUp?'up':'dn')+'" style="width:'+barW+'px"></span></span>'
      +'</a>';
  }

  /* column labels adapt to the honest state (TS-R1) */
  var lblUp, lblDn;
  if(st.live){
    lblUp=L('LIVE LEADERS','实时领涨'); lblDn=L('LIVE LAGGARDS','实时领跌');
  } else if(mode==='last_rth'&&pulse.settled_close){
    lblUp=L('SESSION LEADERS — AT THE CLOSE','本交易日领涨 — 收盘');
    lblDn=L('SESSION LAGGARDS — AT THE CLOSE','本交易日领跌 — 收盘');
  } else {
    lblUp=L('LAST SESSION LEADERS','上一交易日领涨');
    lblDn=L('LAST SESSION LAGGARDS','上一交易日领跌');
  }

  var colUp='<div class="dtp-col"><div class="dtp-col-lbl up">'+lblUp+'</div>';
  top5.forEach(function(b,i){colUp+=rowHtml(b,i+1);});
  colUp+='</div>';

  var colDn='<div class="dtp-col"><div class="dtp-col-lbl dn">'+lblDn+'</div>';
  bot3.forEach(function(b,i){colDn+=rowHtml(b,i+1);});
  /* AI-Capex complex row (live mode only — chip suppression law unchanged, FT-R12) */
  if(!isChipSuppressed(pulse)){
    var cx=null;
    (pulse.complexes||[]).forEach(function(c){if(c.complex_id==='ai_capex')cx=c;});
    if(cx&&cx.live_ew_chg_pct!=null){
      var isG=cx.live_ew_chg_pct>=0;
      var cxTipEn='AI-Capex Complex composite basket.'+(cx.only_green_complex?' Only complex in positive territory this session.':'')+' Context only.';
      var cxTipZh='AI资本开支复合板块。'+(cx.only_green_complex?'本交易时段唯一上涨复合板块。':'')+'仅供参考。';
      colDn+='<div class="dtp-col-lbl cx" style="margin-top:7px">'+L('COMPLEX','复合')+'</div>'
        +'<a class="dtp-mrow" href="basket/ai_capex.html" data-tip-en="'+esc(cxTipEn)+'" data-tip-zh="'+esc(cxTipZh)+'">'
        +'<span class="dtp-rank">·</span>'
        +'<span class="dtp-mname"><span class="l-en">AI-Capex Complex</span><span class="l-zh">AI资本开支复合板块</span></span>'
        +'<span class="dtp-mpct '+(isG?'up':'dn')+'">'+fmtPct(cx.live_ew_chg_pct)+'</span>'
        +'<span class="dtp-mtrack'+(isG?'':' dn')+'"><span class="dtp-mbar '+(isG?'up':'dn')+'" style="width:'+Math.max(4,Math.round(Math.abs(cx.live_ew_chg_pct)/maxAbs*56))+'px"></span></span>'
        +'</a>';
    }
  }
  colDn+='</div>';

  bodyEl.innerHTML=colUp+colDn;

  /* footnote FIRST (flowShown must reflect only the visible columns; the full
     tape below also runs flowBits but its rows sit behind the expander) */
  if(fnEl){
    /* FT-R3 fade note — plain words on Tier 1, 58% receipt demoted to the ? tip
       (doctrine Law 2/3; same form as baskets #2232/#2236) */
    var fadeEn='Not a buy signal: sharp one-day flips usually don\'t hold — in 26 past cases about 6 in 10 faded within a day.';
    var fadeZh='非买入信号：剧烈的单日反转多难持续 — 历史26次中约六成在一天内消退。';
    var tipEn='Technical receipt: T+1 violent-flip base rate 58% fade (n=26) · flip-confirmation lens · descriptive only, not a directional signal · display tier.';
    var tipZh='技术说明：T+1剧烈反转基础概率58%消退（n=26）· 翻转确认透镜 · 仅描述、非方向信号 · 展示层。';
    var flowSeg='';
    if(flowShown){
      var aoEn=flowAsOf?' (as of '+esc(flowAsOf)+')':'';
      var aoZh=flowAsOf?'（截至 '+esc(flowAsOf)+'）':'';
      flowSeg=' · '+L('flow = nightly dollar-volume read'+aoEn+', descriptive only','资金流 = 每晚美元成交量读数'+aoZh+'，仅供描述');
    }
    fnEl.innerHTML=L(fadeEn,fadeZh)
      +' <span class="ftr-t1-help" data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'">?</span>'
      +flowSeg;
  }

  /* full tape — every ranked basket behind the expander (UI truncation only, TS-R5) */
  if(fullEl&&moreBtn){
    var fh='';
    all.forEach(function(b,i){fh+=rowHtml(b,i+1);});
    fullEl.innerHTML=fh;
    var n=all.length;
    var moreLbl=function(open){
      return open?L('Show less ▴','收起 ▴')
                 :L('Show full tape ('+n+') ▾','显示完整行情（'+n+'）▾');
    };
    moreBtn.hidden=false;
    moreBtn.innerHTML=moreLbl(!fullEl.hidden);
    moreBtn.setAttribute('aria-expanded',fullEl.hidden?'false':'true');
    moreBtn.onclick=function(){
      fullEl.hidden=!fullEl.hidden;
      moreBtn.setAttribute('aria-expanded',fullEl.hidden?'false':'true');
      moreBtn.innerHTML=moreLbl(!fullEl.hidden);
    };
  }
}

/* ────────────────────────────────────────────────────────────────────────
   TURN WATCH STRIP + AUTO-EXPAND SALIENCE (TS-R5 / TS-R7)
   Shows baskets with WATCH/IGNITION state OR ≥2 UPTURN_CONFIRMED members
   while slow reco is hold/avoid. Removes is-collapsed from hold fold for
   matched rows (TS-R5); adds ⚡ chip to those rows.
   ──────────────────────────────────────────────────────────────────────── */
function renderTurnWatch(turnWatch, mtfUpturn){
  var stripEl=document.getElementById('dash-tw-strip');
  var rowsEl=document.getElementById('dash-tw-rows');
  var asofEl=document.getElementById('dash-tw-asof');
  if(!stripEl||!rowsEl) return;

  // Build mtfUpturn member-confirmed index: basket_id → confirmed count
  var mtfBasketConfirmed={};
  if(mtfUpturn&&mtfUpturn.tickers){
    Object.keys(mtfUpturn.tickers).forEach(function(sym){
      var t=mtfUpturn.tickers[sym];
      if(t.state==='UPTURN_CONFIRMED'){
        (t.basket_ids||[]).forEach(function(bid){
          mtfBasketConfirmed[bid]=(mtfBasketConfirmed[bid]||0)+1;
        });
      }
    });
  }

  // Build candidate list from turn_watch (basket-level)
  var candidates=[];
  var twBaskets=(turnWatch&&turnWatch.baskets)||[];
  var twAsOf=(turnWatch&&turnWatch.as_of)||'';
  var DISAGREE_RECOS={'hold':1,'avoid':1};  // TS-R5 disagreement gate (A1 fix)
  twBaskets.forEach(function(tw){
    var isActive=tw.state==='WATCH'||tw.state==='IGNITION';
    var memberCount=mtfBasketConfirmed[tw.basket_id]||0;
    // Show if: active state OR ≥2 members UPTURN_CONFIRMED
    if(!isActive&&memberCount<2) return;
    // TS-R5 disagreement gate: for WATCH/IGNITION baskets, only surface when slow_reco
    // is hold/avoid (turn disagrees with slow read) or when reco is absent (honest null).
    // A basket already on a buy reco + IGNITION is agreement, not disagreement — omit.
    var reco=(tw.slow_reco||'').toLowerCase();
    if(isActive&&reco&&!DISAGREE_RECOS[reco]) return;
    candidates.push({
      id: tw.basket_id,
      name: _dtpNameEn(tw.basket_id),
      tw_state: isActive?tw.state:null,
      member_confirmed: memberCount,
      reco: tw.slow_reco||'',
      reco_as_of: tw.reco_as_of||'',
      sort_key: (tw.state==='IGNITION'?0:tw.state==='WATCH'?1:2)*100 - memberCount
    });
  });
  // Also add baskets with ≥2 UPTURN_CONFIRMED members even if NOT in turn_watch baskets
  Object.keys(mtfBasketConfirmed).forEach(function(bid){
    var count=mtfBasketConfirmed[bid];
    if(count>=2&&!candidates.find(function(c){return c.id===bid;})){
      candidates.push({
        id:bid, name:_dtpNameEn(bid), tw_state:null, member_confirmed:count,
        reco:'', reco_as_of:'', sort_key:200-count
      });
    }
  });

  candidates.sort(function(a,b){return a.sort_key-b.sort_key;});
  candidates=candidates.slice(0,6);

  if(!candidates.length){stripEl.classList.remove('visible');return;}
  stripEl.classList.add('visible');
  if(asofEl&&twAsOf){asofEl.innerHTML=L('updated nightly · '+esc(twAsOf),'每晚更新 · '+esc(twAsOf));}

  // Render rows — user-first copy (docs/DESIGN_DOCTRINE.md): plain badges, plain
  // rating text; the constant fade stat lives in the footer ONCE; the internal
  // receipt (state names, reco as-of, base rate) moves to a data-tip on the row.
  var html='';
  candidates.forEach(function(c){
    var badgeCls='member', badgeTxt='';
    if(c.tw_state==='IGNITION'){ badgeCls='ignition'; badgeTxt=L('&#9889; STRONG SIGN','&#9889; 较强迹象'); }
    else if(c.tw_state==='WATCH'){ badgeCls='watch'; badgeTxt=L('&#9889; EARLY SIGN','&#9889; 初步迹象'); }
    else { badgeTxt=L(c.member_confirmed+' stocks turning up',c.member_confirmed+'只成分股转强'); }
    var slowPart='';
    var reco=(c.reco||'').toLowerCase();
    if(reco){
      var recoEn=reco==='hold'?'still rated Hold':reco==='avoid'?'still rated Avoid':'still rated '+esc(c.reco);
      var recoZh=reco==='hold'?'主评级仍为「持有」':reco==='avoid'?'主评级仍为「回避」':'主评级仍为 '+esc(c.reco);
      slowPart='<span class="dash-tw-slow">· '+L(recoEn,recoZh)+'</span>';
    }
    var tipEn='Receipt: fast state '+(c.tw_state||'none')+' · '+c.member_confirmed+' member(s) multi-timeframe confirmed'+(c.reco?' · slow reco '+c.reco.toUpperCase()+(c.reco_as_of?' as-of '+c.reco_as_of:''):'')+' · T+1 fade base rate 58% (n=26; basket-level turn = null edge in backtest, Oracle P8)';
    var tipZh='技术说明：快速状态 '+(c.tw_state||'none')+' · '+c.member_confirmed+'只成分多时间框架确认'+(c.reco?' · 慢速评级 '+c.reco.toUpperCase()+(c.reco_as_of?'（截至'+c.reco_as_of+'）':''):'')+' · T+1消退基础概率58%（n=26；篮子级拐点回测为空值，Oracle P8）';
    html+='<div class="dash-tw-row" data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'">'
      +'<span class="dash-tw-badge '+badgeCls+'">'+badgeTxt+'</span>'
      +'<span class="dash-tw-name">'+esc(c.name)+'</span>'
      +slowPart
      +'</div>';
  });
  rowsEl.innerHTML=html;

  // TS-R5: auto-expand hold fold for matched theme IDs; add ⚡ chip
  var matchedIds=new Set(candidates.map(function(c){return c.id;}));
  var fold=document.getElementById('dash-hold-fold');
  if(fold&&matchedIds.size){
    var needExpand=false;
    fold.querySelectorAll('[data-theme-id]').forEach(function(wrapper){
      var tid=wrapper.getAttribute('data-theme-id');
      if(!tid||!matchedIds.has(tid)) return;
      // Add ⚡ salience chip if not already present
      if(!wrapper.querySelector('.dash-turn-chip')){
        var chip=document.createElement('span');
        chip.className='dash-turn-chip';
        chip.innerHTML='&#9889; '+L('EARLY TURN','早期拐点');
        wrapper.appendChild(chip);
      }
      // Check if this item is currently hidden (would be after n+7 sibling)
      // We'll just un-collapse the whole fold when any match is hidden
      needExpand=true;
    });
    if(needExpand&&fold.classList.contains('is-collapsed')){
      fold.classList.remove('is-collapsed');
      // Update button state
      var btn=fold.parentElement&&fold.parentElement.querySelector('.lst-more');
      if(btn){btn.setAttribute('aria-expanded','true');var sh=btn.querySelector('.lm-show'),hi=btn.querySelector('.lm-hide');if(sh)sh.style.display='none';if(hi)hi.style.display='inline';}
    }
  }
}

/* ────────────────────────────────────────────────────────────────────────
   PER-STOCK TURN SETUPS TABLE (TS-R3 / TS-R7 / TS-R3)
   ──────────────────────────────────────────────────────────────────────── */
var MAG7=['AAPL','AMZN','GOOGL','META','MSFT','NVDA','TSLA'];
function renderMtfTable(mtfUpturn){
  var bodyEl=document.getElementById('dash-mtf-body');
  if(!bodyEl) return;

  if(!mtfUpturn||!mtfUpturn.tickers){
    bodyEl.innerHTML='<p class="dash-mtf-absent">'
      +L('Turn setup data lands after tonight\'s nightly (~02:00 UTC). Mag7 + basket members will appear here.',
         '拐点形态数据将在今晚收盘后更新（约UTC 02:00）。Mag7及篮子成分将在此显示。')
      +'</p>';
    return;
  }

  var tickers=mtfUpturn.tickers;
  var asOf=mtfUpturn.as_of||'';

  // Build row list: CONFIRMED first, then WATCH, then Mag7 NONE
  var confirmed=[], watch=[], mag7None=[];
  var seen=new Set();
  (mtfUpturn.cohort&&mtfUpturn.cohort.confirmed||[]).forEach(function(sym){
    if(tickers[sym]){confirmed.push(sym);seen.add(sym);}
  });
  (mtfUpturn.cohort&&mtfUpturn.cohort.watch||[]).forEach(function(sym){
    if(tickers[sym]&&!seen.has(sym)){watch.push(sym);seen.add(sym);}
  });
  MAG7.forEach(function(sym){
    if(tickers[sym]&&!seen.has(sym)){mag7None.push(sym);seen.add(sym);}
  });

  var rows=confirmed.concat(watch).concat(mag7None).slice(0,40);

  if(!rows.length){
    bodyEl.innerHTML='<p class="dash-mtf-absent">'+L('No turn setup data yet.','暂无拐点形态数据。')+'</p>';
    return;
  }

  // Leg glyphs — 3 visual states (U7):
  //   FILLED (on)   = leg fired: recent cross counts toward K
  //   RING (trend)  = histogram positive but no recent cross — running trend, does not count toward K
  //   EMPTY (off)   = histogram negative
  function _trendTip(label, trendObj){
    // Returns {en, zh} pair — callers emit data-tip-en/data-tip-zh (never title=)
    if(!trendObj) return {en:label, zh:label};
    var bsc=trendObj.bars_since_cross;
    if(bsc!=null){
      return {en:label+': crossed '+bsc+' bar'+(bsc===1?'':'s')+' ago, histogram positive',
              zh:label+'：'+bsc+'根K线前金叉，柱状线为正'};
    }
    if(trendObj.pos){
      return {en:label+': histogram positive (no recent cross)',zh:label+'：柱状线为正（无近期金叉）'};
    }
    return {en:label, zh:label};
  }
  function _tipAttrs(tipObj){
    // Render data-tip-en/zh attributes from a {en,zh} pair
    return ' data-tip-en="'+esc(tipObj.en)+'" data-tip-zh="'+esc(tipObj.zh)+'"';
  }
  function legEl3(fired, trendObj, label){
    // fired: recent cross (counts toward K); trendObj: {pos, bars_since_cross}
    var pos=trendObj&&trendObj.pos;
    var cls=fired?'on':(pos?'trend':'off');
    var tip=(fired||pos)?_trendTip(label,trendObj):{en:label,zh:label};
    return '<span class="dash-mtf-leg '+cls+'"'+_tipAttrs(tip)+'>'+esc(label.slice(0,2))+'</span>';
  }
  function wMacdEl3(val, trendObj){
    // val: 'cross'|'approaching'|'none'; trendObj for W timeframe
    var pos=trendObj&&trendObj.pos;
    if(val==='cross'){
      var tip=_trendTip('W',trendObj);
      return '<span class="dash-mtf-leg on"'+_tipAttrs(tip)+'>W</span>';
    }
    if(val==='approaching'){
      var approachTip={en:'W: approaching (histogram negative but rising, does not count toward K)',zh:'W：接近（柱状线为负但上升，不计入K值）'};
      return '<span class="dash-mtf-leg partial" style="border-style:dashed"'+_tipAttrs(approachTip)+'>W</span>';
    }
    if(pos){
      var tip2=_trendTip('W',trendObj);
      return '<span class="dash-mtf-leg trend"'+_tipAttrs(tip2)+'>W</span>';
    }
    return '<span class="dash-mtf-leg off" data-tip-en="W" data-tip-zh="W">W</span>';
  }

  var html='<p class="muted" style="font-size:11px;margin:0 0 5px">'
    +L('as of '+esc(asOf)+' · Mag7 always shown · an early-warning checklist, not a buy list',
       '截至 '+esc(asOf)+' · Mag7始终显示 · 早期预警检查表，非买入清单')+'</p>';
  html+='<div class="tbl-scroll"><table class="dash-mtf-tbl"><thead><tr>'
    +'<th>'+L('ticker','代码')+'</th>'
    +'<th>'+L('state','状态')+'</th>'
    +'<th class="r">K</th>'
    +'<th>'+L('legs (D / 3D / W / 2W)','信号腿 (D / 3D / W / 2W)')
      +' <span class="help" style="vertical-align:middle">?<span class="tip">'
      +'<span class="l-en">Filled = leg fired (recent cross, counts toward K). Ring = histogram positive but no recent cross (running trend, does not count toward K). Empty = histogram negative. D=daily MACD bull cross; 3D=3-day MACD+StochRSI confluence; W=weekly MACD (dashed=approaching); 2W=biweekly MACD. Forward-graded meter; prior sector-level turn printed NULL (Oracle P8). Display context, not a signal.</span>'
      +'<span class="l-zh">实心=腿触发（近期金叉，计入K值）。空心圆=柱状线为正但无近期金叉（趋势延续，不计入K值）。空心=柱状线为负。D=日线MACD金叉；3D=3日MACD+StochRSI共振；W=周线MACD（虚线=接近）；2W=双周MACD。前瞻计量；板块级别拐点为NULL（Oracle P8）。展示参考，非信号。</span>'
      +'</span></span></th>'
    +'<th>'+L('monthly phase','月线阶段')+'</th>'
    +'<th>'+L('since','起始')+'</th>'
    +'<th>'+L('baskets','篮子')+'</th>'
    +'</tr></thead><tbody>';

  rows.forEach(function(sym){
    var t=tickers[sym];
    var legs=t.legs||{};
    var trend=t.trend||{};
    var stateCls=t.state==='UPTURN_CONFIRMED'?'confirmed':t.state==='UPTURN_WATCH'?'watch':'none';
    var stateLbl=t.state==='UPTURN_CONFIRMED'?L('TURNING UP','转强确认'):t.state==='UPTURN_WATCH'?L('EARLY SIGN','初步迹象'):L('—','—');
    var _bids=(t.basket_ids||[]).slice(0,3);
    var _bMore=(t.basket_ids&&t.basket_ids.length>3)?'…':'';
    var basketEn=_bids.map(_dtpNameEn).join(', ')+_bMore;
    var basketZh=_bids.map(_dtpNameZh).join('、')+_bMore;
    html+='<tr>'
      +'<td><b>'+esc(sym)+'</b></td>'
      +'<td><span class="dash-mtf-badge '+stateCls+'">'+stateLbl+'</span></td>'
      +'<td class="r"><span class="dash-mtf-k">'+(t.k||0)+'</span></td>'
      +'<td><div class="dash-mtf-legs">'
        +legEl3(!!legs.d_macd,trend.d||null,'D')
        +legEl3(!!legs.d3_confluence,trend.d3||null,'3D')
        +wMacdEl3(legs.w_macd||'none',trend.w||null)
        +legEl3(!!legs.w2_macd,trend.w2||null,'2W')
      +'</div></td>'
      +'<td class="dash-mtf-phase">'+esc(t.monthly_phase||'—')+'</td>'
      +'<td class="dash-mtf-since">'+esc(t.since||'—')+'</td>'
      +'<td class="dash-mtf-baskets">'+(_bids.length?L(esc(basketEn),esc(basketZh)):'—')+'</td>'
      +'</tr>';
  });
  html+='</tbody></table></div>';
  bodyEl.innerHTML=html;
}

/* ────────────────────────────────────────────────────────────────────────
   FETCH + ORCHESTRATE
   ──────────────────────────────────────────────────────────────────────── */
var pulse=null, turnWatch=null, mtfUpturn=null;
var pulseDone=false, twDone=false, mtfDone=false, namesDone=false;

function tryRender(){
  if(!pulseDone||!twDone||!mtfDone||!namesDone) return;
  renderTapeBand(pulse);
  renderTurnWatch(turnWatch, mtfUpturn);
  renderMtfTable(mtfUpturn);
}

fetchJson('live/basket_pulse.json',function(d){pulse=d;pulseDone=true;tryRender();});
fetchJson('basketdata/turn_watch.json',function(d){turnWatch=d;twDone=true;tryRender();});
fetchJson('stockdata/mtf_upturn.json',function(d){mtfUpturn=d;mtfDone=true;tryRender();});
/* Parallel fetch: display names for chips + turn-watch enrichment (FT-R8: graceful fail).
   Unlike the data fetches, a names failure must not stall the band behind the 4s
   backstop — fall through to prettified slugs immediately. */
fetch('basketdata/baskets.json',{cache:'no-cache'})
  .then(function(r){if(!r.ok)throw 0;return r.json();})
  .then(function(d){
    var list=(d&&d.baskets)||[];
    list.forEach(function(b){
      if(b.id){ _dtpNames[b.id]={en:b.name||_dtpSlug(b.id), zh:b.name_zh||b.name||_dtpSlug(b.id)}; }
    });
  })
  .catch(function(){})
  .then(function(){namesDone=true;tryRender();});

// Fail-open: if any fetch doesn't resolve, still render with what we have
setTimeout(function(){pulseDone=true;twDone=true;mtfDone=true;namesDone=true;tryRender();},4000);

// See-more folds — V2 action board + sector setups table. Page-scoped;
// theme.js .lst-wrap handler ignores .act-more buttons.
document.addEventListener('click',function(e){
  var btn=e.target&&e.target.closest?e.target.closest('.act-more'):null;
  if(!btn)return;
  var wrap=btn.closest('.actcol')||btn.closest('.panel');
  if(!wrap)return;
  // V2: each column has ONE fold element (actbody.act-fold, .ab-trim-fold, .lst-collapse)
  var fold=wrap.querySelector('.actbody.act-fold,.ab-trim-fold,.lst-collapse,.act-fold');
  if(!fold)return;
  var c=fold.classList.toggle('is-collapsed');
  btn.setAttribute('aria-expanded',c?'false':'true');
  var sh=btn.querySelector('.lm-show'),hi=btn.querySelector('.lm-hide');
  if(sh)sh.style.display=c?'':'none';
  if(hi)hi.style.display=c?'none':'inline';
});

// Stand-aside column (.lst-wrap): theme.js's shared .lst-more handler already
// toggles #dash-hold-fold (.lst-collapse) and flips aria-expanded; the label swap
// is CSS ([aria-expanded] rules in theme.css). A page-scoped duplicate here would
// double-toggle into a no-op — deliberately no handler.

// Action-board row popovers handled by theme.js shared row-pop engine ([data-rpop] / .rp-src).

})();
</script>
<script src="stocktable.js"></script>
<script>
/* W8-R6: USStockTable init — standout board table view (US market).
   Mirrors the CN implementation (china.html.j2 StockTable init block).
   Safe no-op if stocktable data element is absent. */
(function(){
  /* SECZH: keyed on GICS-style names as emitted by us_standouts producer
     (Information Technology / Financials / Consumer Discretionary / Health Care …)
     NOT Yahoo-style names (Technology / Financial Services / Consumer Cyclical / Healthcare).
     Keep in sync with engine/entry_signal.py sector taxonomy. */
  var SECZH = {
    "Information Technology":"信息技术","Financials":"金融","Consumer Discretionary":"可选消费",
    "Health Care":"医疗保健","Communication Services":"通信服务","Consumer Staples":"必需消费",
    "Industrials":"工业","Energy":"能源","Materials":"原材料","Real Estate":"房地产",
    "Utilities":"公用事业"
  };
  var LANE_LABELS_EN = {"bottoming":"Bottoming","continuation":"Continuation","trend":"Trend","recovery":"Recovery","watch":"Watch"};
  var LANE_LABELS_ZH = {"bottoming":"筑底","continuation":"延续","trend":"趋势","recovery":"复苏","watch":"观察"};
  /* ENTRY_STATUS maps: keyed on all values emitted by entry_signal.status producer.
     Vocabulary: buy_now, partial, buy_soon, await_confluence, hold, wait_pullback,
                 extended, watch, avoid, topping, blocked, exit.
     Any unmapped key falls through to the raw token (visible bug) — extend both maps
     when the producer vocabulary changes. */
  var ENTRY_STATUS_EN = {
    "buy_now":"Buy now","partial":"Partial buy",
    "buy_soon":"Buy soon","await_confluence":"Await confluence",
    "hold":"Hold","wait_pullback":"Wait — pullback",
    "wait":"Wait","extended":"Extended",
    "watch":"Watch","avoid":"Avoid","topping":"Topping","blocked":"Blocked","exit":"Exit"
  };
  var ENTRY_STATUS_ZH = {
    "buy_now":"立即买入","partial":"分批买入",
    "buy_soon":"即将买入","await_confluence":"等待共振",
    "hold":"持有","wait_pullback":"等待回调",
    "wait":"等待","extended":"过热",
    "watch":"观察","avoid":"回避","topping":"做顶","blocked":"封锁","exit":"退出"
  };
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum;

  var cols = [
    { key:'lane', labelEn:'Lane', labelZh:'通道', default:true, sortable:true,
      fmt:function(v){
        if(!v) return '<span class="st-muted">—</span>';
        var len = LANE_LABELS_EN[v] || v;
        var lzh = LANE_LABELS_ZH[v] || v;
        var cls = v==='bottoming'?'st-chip-entry':v==='watch'?'st-chip-ran':'st-chip-lane';
        return '<span class="st-chip '+cls+'">' + b(esc(len), esc(lzh)) + '</span>';
      },
      tip:{en:'Cycle lane (system order preserved — table view does not re-sort by default)',zh:'周期通道（保留系统顺序）'} },
    { key:'ticker', labelEn:'Ticker', labelZh:'代码', default:true, sortable:true,
      fmt:function(v,r){
        var entOpen = r.entry_status==='buy_now'||r.entry_status==='partial';
        return (entOpen?'<span class="st-pos" style="display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:4px;vertical-align:2px"></span>':'') + '<b>' + esc(v||'') + '</b>';
      },
      tip:{en:'Green dot = entry window open now',zh:'绿点＝现在入场窗口已开'} },
    { key:'name', labelEn:'Name', labelZh:'名称', default:true, sortable:true,
      fmt:function(v){ return '<b>' + esc(v||'') + '</b>'; }},
    { key:'sector', labelEn:'Sector', labelZh:'板块', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return b(esc(v), esc(SECZH[v]||v)); }},
    { key:'price', labelEn:'Price', labelZh:'价格', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':'$'+fn(v,2); }},
    { key:'conviction_score', labelEn:'Score', labelZh:'评分', default:true, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v); var cls = n>=70?'st-pos':n>=40?'':'st-neg';
        return '<span class="'+cls+'">'+n+'</span>'; },
      tip:{en:'Conviction buy-readiness score 0–100',zh:'信念买入就绪度 0–100'} },
    { key:'alpha', labelEn:'Alpha', labelZh:'Alpha', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="'+(v>0?'st-pos':v<0?'st-neg':'')+'">'+fp(v*100,2)+'</span>'; },
      tip:{en:'Sector-neutral residual momentum (display context — ranking leg)',zh:'行业中性残差动量（展示情境）'} },
    { key:'off_high', labelEn:'Off High', labelZh:'距高点', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v,1); },
      tip:{en:'% off 52-week high',zh:'距52周高点百分比'} },
    { key:'entry_status', labelEn:'Entry', labelZh:'入场', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        var en = ENTRY_STATUS_EN[v]||v; var zh = ENTRY_STATUS_ZH[v]||v;
        var cls = (v==='buy_now'||v==='partial'||v==='buy_soon')?'st-pos':(v==='extended'||v==='avoid'||v==='topping'||v==='blocked'||v==='exit')?'st-neg':'';
        return '<span class="'+cls+'">'+b(esc(en),esc(zh))+'</span>'; },
      tip:{en:'Entry signal status from the cycle engine',zh:'周期引擎入场信号状态'} },
    { key:'factor_z', labelEn:'Factor Z', labelZh:'因子Z', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="'+(v>0?'st-pos':v<0?'st-neg':'')+'">'+fn(v,1)+'</span>'; },
      tip:{en:'Cross-sectional factor composite z-score (value / quality / low-vol)',zh:'横截面因子综合z分（价值/质量/低波）'} },
    { key:'sue_z', labelEn:'SUE Z', labelZh:'盈利动量', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="'+(v>0?'st-pos':v<0?'st-neg':'')+'">'+fn(v,1)+'</span>'; },
      tip:{en:'Earnings momentum z vs S&P 1500 (post-earnings-announcement drift context; display only)',zh:'盈利动量z（相对标普1500，展示情境）'} },
    { key:'insider_buyers', labelEn:'Insider', labelZh:'内部人', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': '<span class="st-pos">'+esc(String(v))+' 👤</span>'; },
      tip:{en:'# distinct insiders net-bought in the last 6 months (Form-4 cluster — context only)',zh:'近6个月净买入的不同内部人数量（Form-4集群，情境）'} },
  ];

  /* ── view persistence ── */
  var LS_VIEW = 'mdx_stocktable_us';
  var currentView = localStorage.getItem(LS_VIEW) || 'grid';

  function applyView(v) {
    currentView = v;
    localStorage.setItem(LS_VIEW, v);
    var el = document.getElementById('us-standouts');
    var chipsEl = document.getElementById('st-count-chips');
    var gbtn = document.getElementById('us-st-btn-grid');
    var tbtn = document.getElementById('us-st-btn-table');
    if (!el) return;
    if (v === 'table') {
      el.classList.add('st-table-mode');
      if (chipsEl) chipsEl.style.display = '';
      if (gbtn) gbtn.setAttribute('aria-selected','false');
      if (tbtn) tbtn.setAttribute('aria-selected','true');
    } else {
      el.classList.remove('st-table-mode');
      if (chipsEl) chipsEl.style.display = 'none';
      if (gbtn) gbtn.setAttribute('aria-selected','true');
      if (tbtn) tbtn.setAttribute('aria-selected','false');
    }
  }

  /* ── init ── */
  var dataEl = document.getElementById('us-stocktable-data');
  if (!dataEl) return;  /* no data — safe no-op */

  window.USStockTable = { _setView: applyView };

  StockTable.init({
    dataId: 'us-stocktable-data',
    containerId: 'us-stocktable-wrap',
    market: 'us',
    linkPattern: 'stock.html#{ticker}',
    columns: cols,
  });

  /* restore persisted view */
  applyView(currentView);
})();
</script>
