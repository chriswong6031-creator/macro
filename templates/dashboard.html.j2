          <div class="nb-sub">
            {% if _th.slug %}<span class="nb-spot nb-spot-link {{ _spcls }}" data-href="basket/{{ _th.slug|e }}.html" role="link" tabindex="0" title="{{ _sptip }} Open the theme →"><span>{{ '🔥' if sp.dir == 'tailwind' else '🧊' }}</span><span class="sp-tag l-en">{{ _en }}</span><span class="sp-tag l-zh">{{ _zh }}</span><span>{{ '▲' if sp.dir == 'tailwind' else '▼' }}</span></span>
