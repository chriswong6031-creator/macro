/* ══════════════════════════════════════════════════════════════════
   S2 — v5 card face styles (ALL scoped body.page-macro.mx4-grid)
   Port from v5_final.html rev2; CSS token aliases → mx5 custom props
   ══════════════════════════════════════════════════════════════════ */

/* ── v5 grid ORDER: resequence cards without changing DOM ───────── */
/* DOM: sx-evidence(WTD), sx-events-v2, sx-markets-v2, sx-risk-v2(order:-1=row1)
   then sx-policy-v2, sx-aibrief-v2, sx-news-v2, sx-deep-context
   Static cards injected after sx-events-v2 in DOM so they fall in row 4 naturally.
   Visual row order: scorecard(-1), markets(1), wtd+events(2), static(3), alerts+policy+ai(4), deep(5) */
body.page-macro.mx4-grid #sx-markets-v2{order:1;}
body.page-macro.mx4-grid #sx-evidence{order:2;}
body.page-macro.mx4-grid #sx-events-v2{order:2;}
body.page-macro.mx4-grid #sx-v5-fed{order:3;}
body.page-macro.mx4-grid #sx-v5-sentiment{order:3;}
body.page-macro.mx4-grid #sx-v5-sector{order:3;}
body.page-macro.mx4-grid #sx-news-v2{order:4;}
body.page-macro.mx4-grid #sx-policy-v2{order:4;}
body.page-macro.mx4-grid #sx-aibrief-v2{order:4;}
body.page-macro.mx4-grid #sx-deep-context{order:5;}

/* ── v5 static card shell (matches .card in v5_final) ─────────── */
body.page-macro.mx4-grid .mx5-card{
  background:var(--mx5-glass-bg);
  border:1px solid var(--mx5-glass-border);
  border-radius:var(--mx5-radius-card);
  backdrop-filter:var(--mx5-blur);
  box-shadow:var(--mx5-glass-shadow);
  padding:24px 26px;
  position:relative;overflow:hidden;
  display:flex;flex-direction:column;
  height:100%;box-sizing:border-box;
}
body.page-macro.mx4-grid .mx5-card::before{
  content:"";position:absolute;inset:0;
  border-radius:var(--mx5-radius-card);
  background:linear-gradient(135deg,rgba(255,255,255,.04) 0%,transparent 55%);
  pointer-events:none;
}
/* Static-card click target (Fed / Sentiment / Sector) */
body.page-macro.mx4-grid .mx5-card[role="button"]{cursor:pointer;transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;}
body.page-macro.mx4-grid .mx5-card[role="button"]:hover{background:var(--mx5-hover-bg);border-color:var(--mx5-hover-border);box-shadow:var(--mx5-hover-shadow);transform:translateY(-1px);}
body.page-macro.mx4-grid .mx5-card[role="button"]:focus-visible{outline:none;box-shadow:var(--mx5-focus-ring),var(--mx5-hover-shadow);}
/* sxg-face in grid view = v5 card face; override default padding to match .mx5-card */
body.page-macro.mx4-grid .sxg-face.mx5-card-face{
  background:var(--mx5-glass-bg);
  border:1px solid var(--mx5-glass-border);
  border-radius:var(--mx5-radius-card)!important;
  backdrop-filter:var(--mx5-blur);
  box-shadow:var(--mx5-glass-shadow);
  padding:24px 26px!important;
  min-height:unset;
  height:100%;
  transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;
}
body.page-macro.mx4-grid .sxg-face.mx5-card-face::before{
  content:"";position:absolute;inset:0;
  border-radius:inherit;
  background:linear-gradient(135deg,rgba(255,255,255,.04) 0%,transparent 55%);
  pointer-events:none;
}
body.page-macro.mx4-grid .sx:hover .sxg-face.mx5-card-face,
body.page-macro.mx4-grid .sxg-face.mx5-card-face:hover{
  background:var(--mx5-hover-bg);
  border-color:var(--mx5-hover-border);
  box-shadow:var(--mx5-hover-shadow);
  transform:translateY(-1px);
}
body.page-macro.mx4-grid .sxg-face.mx5-card-face:focus-visible{
  outline:none;box-shadow:var(--mx5-focus-ring),var(--mx5-hover-shadow);
}
/* Card title row */
body.page-macro.mx4-grid .mx5-card-title{
  font-size:13px;font-weight:700;
  color:var(--ink-1,rgba(255,255,255,.92));
  letter-spacing:-.01em;margin-bottom:18px;
}
body.page-macro.mx4-grid .mx5-card-title-row{
  display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;
}
body.page-macro.mx4-grid .mx5-card-badge{
  font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;
  padding:3px 9px;border-radius:var(--mx5-radius-pill);
  background:rgba(255,255,255,.07);color:var(--ink-2,rgba(255,255,255,.6));
}
/* Static card sections (not .sx — no island): sit in the rack grid */
body.page-macro.mx4-grid .sx-v5-static{
  /* participates in the rack 12-col grid just like .sx */
}
body.page-macro:not(.mx4-grid) .sx-v5-static{
  display:none; /* hidden in ledger view — these are grid-only surfaces */
}
/* D1: command scorecard (left+right) must be hidden in ledger view, mirroring .sx-v5-static */
body.page-macro:not(.mx4-grid) .mx5-sc-left,
body.page-macro:not(.mx4-grid) .mx5-sc-right{display:none;}

/* ── MARKETS tiles (v5: four-col strip inside the sxg-face) ────── */
body.page-macro.mx4-grid #sx-markets-v2 .sxg-face.mx5-card-face{
  /* Markets face = full-width tile strip; override flex-direction for row layout */
  display:flex;flex-direction:column;
  padding:18px 20px 14px!important;
}
body.page-macro.mx4-grid .mx5-mkt-grid{
  display:grid;grid-template-columns:repeat(4,1fr);gap:16px;
}
@media(max-width:900px){
  body.page-macro.mx4-grid .mx5-mkt-grid{grid-template-columns:1fr 1fr;}
}
body.page-macro.mx4-grid .mx5-mkt-tile{
  /* v5.3.1: tiles are NESTED inside an already-glass card — glass-on-glass at .1 over .1
     compounded to ~19% white ("too bright"). Inner surfaces use a subtle 3% fill, no
     second blur, hairline border, no drop shadow. */
  background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.08);
  border-radius:12px;
  padding:16px 18px 12px;
  position:relative;overflow:hidden;cursor:pointer;
  transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;
}
[data-theme="light"] body.page-macro.mx4-grid .mx5-mkt-tile{
  background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.07);
}
/* v5.3.1: tiles sit calm — neutral border like every other card; direction color
   lives on the delta text and a dimmed sparkline only (operator: too bright) */
body.page-macro.mx4-grid .mx5-mkt-tile.up,
body.page-macro.mx4-grid .mx5-mkt-tile.dn{border-color:var(--glass-border,rgba(255,255,255,.12));}
/* Unified hover (Order 5) — overrides the directional .up/.dn border on hover
   so no accent tint survives; placed AFTER .up/.dn for cascade precedence. */
body.page-macro.mx4-grid .mx5-mkt-tile:hover,
body.page-macro.mx4-grid .mx5-mkt-tile.up:hover,
body.page-macro.mx4-grid .mx5-mkt-tile.dn:hover{
  background:var(--mx5-hover-bg);
  border-color:var(--mx5-hover-border);
  box-shadow:var(--mx5-hover-shadow);
  transform:translateY(-1px);
}
body.page-macro.mx4-grid .mx5-mkt-tile:focus-visible{outline:none;box-shadow:var(--mx5-focus-ring),var(--mx5-hover-shadow);}
body.page-macro.mx4-grid .mx5-mkt-ticker{
  font-size:11px;font-weight:700;letter-spacing:.07em;
  color:var(--ink-3,rgba(255,255,255,.36));text-transform:uppercase;margin-bottom:3px;
}
body.page-macro.mx4-grid .mx5-mkt-sub{
  font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));
  letter-spacing:.04em;text-transform:uppercase;margin-bottom:4px;
}
body.page-macro.mx4-grid .mx5-mkt-price{
  font-size:19px;font-weight:700;line-height:1;
  color:var(--ink-1,rgba(255,255,255,.92));margin-bottom:4px;
  font-variant-numeric:tabular-nums;
}
body.page-macro.mx4-grid .mx5-mkt-delta{font-size:13px;font-weight:600;}
body.page-macro.mx4-grid .mx5-mkt-delta.up{color:var(--up,#22d97a);}
body.page-macro.mx4-grid .mx5-mkt-delta.dn{color:var(--down,#ef4444);}
body.page-macro.mx4-grid .mx5-spark{margin-top:10px;}
body.page-macro.mx4-grid .mx5-spark svg{width:100%;height:32px;display:block;}

/* ── WHAT TO DO (action-list inside sx-evidence face) ────────── */
body.page-macro.mx4-grid .mx5-action-list{display:flex;flex-direction:column;}
body.page-macro.mx4-grid .mx5-action-item{
  display:flex;align-items:flex-start;gap:13px;
  padding:13px 0;border-bottom:1px solid rgba(255,255,255,.06);
}
body.page-macro.mx4-grid .mx5-action-item:last-child{border-bottom:none;}
[data-theme="light"] body.page-macro.mx4-grid .mx5-action-item{border-bottom-color:rgba(0,0,0,.06);}
body.page-macro.mx4-grid .mx5-action-icon{
