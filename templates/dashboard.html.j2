  {# Inline JS for v3 island tray toggle #}
  <script>
  (function(){
    var _mx2Ids = ['sx-evidence','sx-events-v2','sx-markets-v2','sx-risk-v2','sx-policy-v2','sx-aibrief-v2','sx-news-v2','sx-deep-context'];
    var _allOpen = false;

    /* Aurora @property polyfill */
    if(CSS && CSS.registerProperty){
      try{ CSS.registerProperty({name:'--isle-aurora-angle',syntax:'<angle>',inherits:false,initialValue:'0deg'}); }catch(e){}
    }

    function _countOpen(){
      return _mx2Ids.filter(function(id){ var e=document.getElementById(id); return e&&e.hasAttribute('data-open'); }).length;
    }

    function _updateBodyClass(){
      var n = _countOpen();
      document.body.classList.toggle('has-open-island', n > 0);
      document.body.classList.toggle('many-open', n >= 3);
    }

    window.mx2Toggle = function(id){
      var el = document.getElementById(id);
      if(!el) return;
      var isOpen = el.hasAttribute('data-open');
      if(isOpen){
        el.removeAttribute('data-open');
        var s = el.querySelector('.sx-sum'); if(s) s.setAttribute('aria-expanded','false');
      } else {
        el.setAttribute('data-open','');
        var s = el.querySelector('.sx-sum'); if(s) s.setAttribute('aria-expanded','true');
        document.dispatchEvent(new CustomEvent('mx2-tray-open',{detail:{id:id}}));
        setTimeout(function(){
          var island = el.querySelector('.sx-island');
          if(island){ var rect=island.getBoundingClientRect(); if(rect.top<60||rect.top>window.innerHeight*.7){ island.scrollIntoView({behavior:'smooth',block:'nearest'}); } }
        }, 80);
      }
      try{var st=JSON.parse(localStorage.getItem('mx2_state')||'{}');st[id]=!isOpen;localStorage.setItem('mx2_state',JSON.stringify(st));}catch(e){}
      _updateBodyClass();
      _updateExpandBtn();
    };

    window.mx2ToggleAll = function(){
      _allOpen = !_allOpen;
      if(_allOpen){
        _mx2Ids.forEach(function(id, idx){
          setTimeout(function(){
            var el=document.getElementById(id); if(!el) return;
            el.setAttribute('data-open','');
            var s=el.querySelector('.sx-sum');if(s)s.setAttribute('aria-expanded','true');
            _updateBodyClass();
          }, idx * 80);
        });
        setTimeout(function(){ _updateExpandBtn(); }, _mx2Ids.length * 80 + 50);
      } else {
        _mx2Ids.forEach(function(id){
          var el=document.getElementById(id); if(!el) return;
          el.removeAttribute('data-open');
          var s=el.querySelector('.sx-sum');if(s)s.setAttribute('aria-expanded','false');
        });
        _updateBodyClass(); _updateExpandBtn();
      }
      try{var st=JSON.parse(localStorage.getItem('mx2_state')||'{}');_mx2Ids.forEach(function(id){st[id]=_allOpen;});localStorage.setItem('mx2_state',JSON.stringify(st));}catch(e){}
    };

    function _updateExpandBtn(){
      var btn = document.getElementById('mx2ExpandAllBtn'); if(!btn) return;
      var openCnt = _countOpen();
      _allOpen = openCnt === _mx2Ids.length;
      btn.classList.toggle('all-open', _allOpen);
      var txt = btn.querySelector('.ea-txt');
      if(txt){
        var enEl=txt.querySelector('.l-en'),zhEl=txt.querySelector('.l-zh');
        if(enEl) enEl.textContent = _allOpen ? 'Collapse all' : 'Expand all';
        if(zhEl) zhEl.textContent = _allOpen ? '收起全部' : '展开全部';
      }
    }

    /* Keyboard Enter/Space on sx-sum */
    document.querySelectorAll('.sx-sum').forEach(function(el){
      el.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); el.click(); } });
    });

    /* Escape closes all */
    document.addEventListener('keydown',function(e){
      if(e.key==='Escape'){
        _mx2Ids.forEach(function(id){ var el=document.getElementById(id); if(el){ el.removeAttribute('data-open'); var s=el.querySelector('.sx-sum');if(s)s.setAttribute('aria-expanded','false'); } });
        _allOpen=false; _updateBodyClass(); _updateExpandBtn();
      }
    });

    /* Restore localStorage state */
    try{
      var saved = JSON.parse(localStorage.getItem('mx2_state')||'{}');
      _mx2Ids.forEach(function(id){
        if(saved[id]===true){ var el=document.getElementById(id); if(el){ el.setAttribute('data-open',''); var s=el.querySelector('.sx-sum');if(s)s.setAttribute('aria-expanded','true'); } }
      });
    }catch(e){}
    _updateBodyClass();
    _updateExpandBtn();
  })();
  </script>
  {% endif %}{# /if mode != 'stocks' #}



  {# ===================== POLICY-LEVER ARMED/QUIET CARD (Policy-Shock W2-F) =====================
     Display-only conditions context — not a signal, not a forecast.
     PS-R1: card copy never reads or attributes intent; the canonical framing line
     ("not intent, not timing") is the REQUIRED disclaimer and is exempt (PS-A3).
     PS-R3: reads policy_lever.json (site artifact); never feeds scoring.
     PS-R4: no probabilities anywhere in this block.
     Jinja missing-key gotcha guard: every nested access uses the 'defined' test or
     dict.get() notation ('d.key is defined') before accessing — NEVER 'if d.key is not none'
     on a potentially MISSING key (crashes with UndefinedError).
     Stage-B: macro mode uses the policy tray (sx-policy-v2) above; this standalone
     card is kept for stocks mode only.
  #}
  {# Fallback policy-lever-card: renders in NON-macro mode, OR in macro mode only when market_state is absent
     (v2 sx-policy tray handles it when market_state is present). CI test (test_policy_lever.py) uses
     market_state=None fixture so this fallback must be reachable in macro mode. #}
  {% if (mode != 'macro' or not market_state) and policy_lever is defined and policy_lever %}
  {% set PL = policy_lever %}
  {% set _pl_state = PL.get('state') or 'QUIET' %}
  {% set _pl_state_color = 'var(--down)' if _pl_state == 'ARMED' else ('var(--orange)' if _pl_state == 'ELEVATED' else 'var(--muted)') %}
  {# MX POLICY BAND — 3-col layout: col1=Policy Lever state+rows, col2=lever details (repricing-style), col3=flip confirmation summary.
     id="policy-lever-card" is preserved here for deep-link + CI test (tests/test_policy_lever.py checks string presence). #}
  <div class="panel span12" id="policy-lever-card">
    <div class="mx-eyebrow">{{ t('Policy-Lever Conditions &amp; Repricing','政策杠杆条件与重新定价') }}
