      <div class="mx5-deep-chips">
        <span class="mx5-deep-chips-lbl"><span class="l-en">More</span><span class="l-zh">更多</span></span>
        <a class="mx5-deep-chip" href="macro_context.html"><span class="l-en">Macro Weather</span><span class="l-zh">宏观气象</span></a>
        <a class="mx5-deep-chip" href="aibrief.html"><span class="l-en">AI Brief</span><span class="l-zh">AI日报</span></a>
        <a class="mx5-deep-chip" href="sector_central.html"><span class="l-en">Sector Central</span><span class="l-zh">行业中枢</span></a>
        <a class="mx5-deep-chip" href="committee.html"><span class="l-en">Neural Web</span><span class="l-zh">神经网络</span></a>
        <a class="mx5-deep-chip" href="macro_signals.html"><span class="l-en">Signal Lab</span><span class="l-zh">信号实验室</span></a>
        <a class="mx5-deep-chip" href="china_intel.html"><span class="l-en">China Intel</span><span class="l-zh">中国情报</span></a>
      </div>
    </div>
  </div>{# /sx-deep-context #}

  </div>{# /mx4-rack #}

  {# ── v5.1 S1: Dialog containers — temporary wiring; each card face opens one of these.
     Content = the old island interiors rendered inline (S2/S3 will redesign).
     Dialogs rendered outside the rack grid to avoid stacking-context issues. #}

  {# dlg-evidence: Evidence six-factor breakdown — S2 redesign #}
  <div class="mx5-dlg" id="dlg-evidence" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Signals — Evidence Breakdown</span><span class="l-zh">信号 — 依据分析</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Composite read — bind to MS (same object as hero) so glance and drill-down never disagree #}
        {% if MS %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Composite Score</span><span class="l-zh">综合评分</span></div>
        <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:20px">
          {% set _dlge_col = 'var(--up)' if MS.score >= 60 else ('var(--warn)' if MS.score >= 42 else 'var(--down)') %}
          <span style="font-size:40px;font-weight:900;font-variant-numeric:tabular-nums;color:{{ _dlge_col }};line-height:1">{{ MS.score }}</span>
          <div>
            <div style="font-size:14px;font-weight:700;color:{{ _dlge_col }}">
              <span class="l-en">{{ MS.label_en }}</span>
              <span class="l-zh">{{ MS.label_zh or MS.label_en }}</span>
            </div>
            <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:3px">
              <span class="l-en">Blended 0–100 · ≥60 risk-on · 42–59 mixed · &lt;42 risk-off</span>
              <span class="l-zh">合成 0-100 · ≥60 偏多 · 42-59 混合 · &lt;42 避险</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# — Six factor rows — #}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Six Factors</span><span class="l-zh">六大因子</span></div>
        {% if MS2 and MS2.components %}
        {% set _dlge_weakest = (MS2.components | sort(attribute='score') | first) if MS2.components else none %}
        {% for c in MS2.components %}
        {% set _ec = 'var(--up)' if c.tone == 'good' else ('var(--down)' if c.tone == 'bad' else 'var(--warn)') %}
        {% set _is_wk = (_dlge_weakest and c.label_en == _dlge_weakest.label_en) %}
        <div class="mx5-dlg-factor-row{{ ' weakest' if _is_wk }}">
          <div>
            <div class="mx5-dlg-factor-name">
              <span class="l-en">{{ c.label_en }}</span><span class="l-zh">{{ c.label_zh or c.label_en }}</span>
              {% if _is_wk %}<span class="v2chip c-warn" style="font-size:9px;padding:1px 5px;margin-left:6px;vertical-align:middle"><span class="l-en">WEAKEST</span><span class="l-zh">最弱</span></span>{% endif %}
            </div>
            {% if c.read_en is defined and c.read_en %}
            <div class="mx5-dlg-factor-read"><span class="l-en">{{ c.read_en }}</span><span class="l-zh">{{ c.read_zh or c.read_en }}</span></div>
            {% endif %}
          </div>
          <div>
            <div class="mx5-dlg-factor-bar"><div class="mx5-dlg-factor-fill" style="width:{{ [c.score,100]|min }}%;background:{{ _ec }}"></div></div>
            <div class="mx5-dlg-bar-ticks"><span>0</span><span>50</span><span>100</span></div>
          </div>
          <div class="mx5-dlg-factor-score" style="color:{{ _ec }}">{{ c.score }}</div>
        </div>
        {% endfor %}

        {# — Weakest leg callout — #}
        {% if _dlge_weakest %}
        <div class="mx5-dlg-weakest-callout">
          <div class="mx5-dlg-weakest-icon">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <div>
            <div class="mx5-dlg-weakest-label"><span class="l-en">Watch: {{ _dlge_weakest.label_en }}</span><span class="l-zh">关注：{{ _dlge_weakest.label_zh or _dlge_weakest.label_en }}</span></div>
            <div class="mx5-dlg-weakest-sub">
              <span class="l-en">Weakest leg at {{ _dlge_weakest.score }}/100 — the closest flip-trigger. Confirms what has already turned; does not forecast.</span>
              <span class="l-zh">最弱分项 {{ _dlge_weakest.score }}/100，最接近翻转触发点。确认已转向信号，不预测未来。</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# — Multi-timeframe tape — #}
        {% if MS2 and MS2.mtf and MS2.mtf.indices %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Multi-Timeframe Tape · Broad US Market</span><span class="l-zh">多周期趋势 · 美股大盘</span></div>
        <table class="mx5-dlg-mtf-tbl">
          <thead><tr>
            <th><span class="l-en">Index</span><span class="l-zh">指数</span></th>
            <th>1D</th><th>3D</th><th>7D</th><th>30D</th>
            <th style="text-align:right"><span class="l-en">Confluence</span><span class="l-zh">合流</span></th>
          </tr></thead>
          <tbody>
          {% for r in MS2.mtf.indices %}
          <tr>
            <td style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">{{ r.label_en }}</span><span class="l-zh">{{ r.label_zh or r.label_en }}</span></td>
            {% for tf in ['D','3D','W','M'] %}{% set cell = r.cells[tf] %}
            <td>{% if cell %}<span class="ms-cell2 {{ cell.tone }}"><span class="ar">{{ cell.arrow }}</span><span class="rsi">{{ cell.rsi|round|int if cell.rsi is not none else '·' }}</span></span>{% else %}<span class="ms-cell2 flat"><span class="ar">·</span></span>{% endif %}</td>
            {% endfor %}
            <td style="text-align:right"><span class="mx5-dlg-mtf-conf {{ r.tone }}"><span class="l-en">{{ r.confluence_en }}</span><span class="l-zh">{{ r.confluence_zh or r.confluence_en }}</span></span></td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
        {% endif %}

        {# — Footnote — #}
        <div class="mx5-dlg-sep"></div>
        <div style="display:flex;align-items:flex-start;gap:10px;font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.5">
          <span class="v2-display-badge" style="flex-shrink:0;margin-top:1px"><span class="l-en">DISPLAY-ONLY</span><span class="l-zh">仅展示</span></span>
          <span>
            <span class="l-en">Confirms what has already turned — does not forecast. Gauntlet applies at promotion only. {{ 'as of ' ~ MS2.asof if (MS2 and MS2.asof is defined and MS2.asof) else '' }}</span>
            <span class="l-zh">确认已转向信号，不预测未来。{{ MS2.asof ~ ' 数据' if (MS2 and MS2.asof is defined and MS2.asof) else '' }}</span>
          </span>
        </div>

        {% else %}
        <p style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));margin-top:16px"><span class="l-en">No signal data available.</span><span class="l-zh">暂无信号数据。</span></p>
        {% endif %}

      </div>
    </div>
  </div>

  {# ── Shared benchmark-strip component (dlg-fed + dlg-events) ──────────────────
     Glass rows: big odds numeral, movement arrow, honest "what traders price" eyebrow.
     `rows` = list of dicts {outcome_en, outcome_zh, label_en, label_zh, prob, chg_pp}. #}
  {% macro fbm_bench_strip(rows, src, asof) %}
  <div class="mx5-dlg-eyebrow"><span class="l-en">Market-implied benchmark &mdash; what traders price, not our read</span><span class="l-zh">市场隐含基准 &mdash; 交易者定价，非本系统观点</span></div>
  <div class="fbm-bench">
    {% for r in rows %}
    {% set _bp = (r.prob | float) if r.prob is not none else none %}
    <div class="fbm-bench-row">
      {% if _bp is not none %}<div class="fbm-bench-odds">{{ _bp | round | int }}<small>%</small></div>{% endif %}
      <div class="fbm-bench-body">
        <div class="fbm-bench-outcome"><span class="l-en">{{ r.outcome_en }}</span><span class="l-zh">{{ r.outcome_zh }}</span></div>
        <div class="fbm-bench-label"><span class="l-en">{{ r.label_en }}</span><span class="l-zh">{{ r.label_zh }}</span></div>
      </div>
      {% if r.chg_pp is not none and r.chg_pp != 0 %}
      <div class="fbm-bench-arrow {{ 'pos' if r.chg_pp > 0 else 'neg' }}"
           data-tip-en="Odds moved {{ '%+.1f'|format(r.chg_pp) }} points since the last update."
           data-tip-zh="自上次更新以来概率变动 {{ '%+.1f'|format(r.chg_pp) }} 个百分点。">
        {{ '▲' if r.chg_pp > 0 else '▼' }} {{ '%+.1f'|format(r.chg_pp) }}
      </div>
      {% endif %}
    </div>
    {% endfor %}
    <div class="fbm-bench-src"><span class="l-en">Source: {{ src }}{% if asof %} (as of {{ asof }}){% endif %}</span><span class="l-zh">来源：{{ src }}{% if asof %}（截至 {{ asof }}）{% endif %}</span></div>
  </div>
  {% endmacro %}

  {# ── Wave C (Risk cluster) glyphs — inline 24-grid stroke SVG, currentColor, no fill.
     rkc_scare_glyph: one per scare family (growth/credit/breadth/bubble/rates/vol/internals)
     mapped from the scare's engine key so a cold reader sees WHICH kind of risk before the
     word. rkc_sig_glyph: one per demoted signal tile. Family resolved from the raw scare
     key prefix so it survives engine relabels (label text may change; keys don't). ── #}
  {% macro rkc_scare_glyph(fam) -%}
  {%- set _g = {
    'growth':   '<path d="M3 6l6 6 4-4 8 8"/><path d="M21 16v-4h-4"/>',
    'credit':   '<path d="M10 7H7a4 4 0 000 8h3"/><path d="M14 7h3a4 4 0 014 4"/><path d="M8 11h5"/><path d="M18 15l3 4M21 15l-3 4"/>',
    'breadth':  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 010 18"/>',
    'bubble':   '<circle cx="10" cy="13" r="6"/><path d="M17 6l1.5 1.5M20 5l.5.5M16.5 9.5l1 1"/>',
    'rates':    '<path d="M6 6l12 12"/><circle cx="8" cy="8" r="2.2"/><circle cx="16" cy="16" r="2.2"/>',
    'vol':      '<path d="M3 12h3l3 7 4-16 3 9h5"/>',
    'internals':'<path d="M5 20V10M10 20V4M15 20v-7M20 20V8"/>',
  } -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ _g.get(fam, '<circle cx="12" cy="12" r="8"/><path d="M12 8v4M12 16h.01"/>') | safe }}</svg>
  {%- endmacro %}
  {# resolve a scare's family from its engine key / scare tag (prefix match on raw keys) #}
  {% macro rkc_scare_fam(sc) -%}
  {%- set _k = (sc.scare if sc.scare is defined and sc.scare else (sc.key if sc.key is defined and sc.key else '')) | string | lower -%}
  {%- set _lbl = (sc.label_en if sc.label_en is defined and sc.label_en else '') | string | lower -%}
  {%- if 'growth' in _k or 'growth' in _lbl or 'rotation' in _lbl -%}growth
  {%- elif 'credit' in _k or 'credit' in _lbl -%}credit
  {%- elif 'global' in _k or 'breadth' in _lbl and 'internal' not in _lbl -%}breadth
  {%- elif 'bubble' in _k or 'blow' in _lbl or 'bubble' in _lbl -%}bubble
  {%- elif 'rate' in _k or 'rate' in _lbl or 'inflation' in _lbl -%}rates
  {%- elif 'vol' in _k or 'volatil' in _lbl -%}vol
  {%- elif 'internal' in _k or 'internal' in _lbl -%}internals
  {%- else -%}growth{%- endif -%}
  {%- endmacro %}
  {% macro rkc_sig_glyph(kind) -%}
  {%- set _g = {
    'leading':  '<path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
    'do':       '<path d="M20 6L9 17l-5-5"/>',
    'window':   '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/><path d="M8 14l2.5 2.5L15 12"/>',
    'audit':    '<path d="M6 2h9l3 3v15l-2.5-1.5L13 20l-2.5-1.5L8 20l-2-1.5V2z"/><path d="M9 7h6M9 11h6M9 15h3"/>',
    'overseas': '<circle cx="12" cy="10" r="7"/><path d="M5 10h14M12 3a12 12 0 010 14"/><path d="M12 17v4"/>',
    'corr':     '<circle cx="6" cy="7" r="2.4"/><circle cx="18" cy="7" r="2.4"/><circle cx="12" cy="18" r="2.4"/><path d="M7.8 8.6l2.6 7.2M16.2 8.6l-2.6 7.2M8.4 7h7.2"/>',
  } -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ _g.get(kind, '<circle cx="12" cy="12" r="8"/>') | safe }}</svg>
  {%- endmacro %}

  {# dlg-events: Events catalysts + fed market pricing + release-radar link — S2 redesign #}
  <div class="mx5-dlg" id="dlg-events" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Events — Week Ahead &amp; Market Pricing</span><span class="l-zh">事件 — 本周日历与市场定价</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Week-ahead calendar cards — #}
        {% if macro_catalysts %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">This Week</span><span class="l-zh">本周</span></div>
        <div class="mx5-dlg-cal-grid">
          {% for c in macro_catalysts[:8] %}
          {% set _bdg = 'high' if c.impact == 'high' else ('med' if c.impact == 'med' else 'low') %}
          {% set _lbl_zh = c.get('label_zh') or c.label %}
          <div class="mx5-dlg-cal-card{{ ' hot' if c.impact == 'high' }}" data-cal-date="{{ c.date }}" data-cal-type="{{ c.type if c.type is defined else '' }}">
            <div class="mx5-dlg-cal-date">{{ _mos2[c.date[5:7]|int] }} {{ c.date[8:10]|int }}</div>
            <div class="mx5-dlg-cal-title">
              <span class="l-en">{{ c.label }}</span>
              <span class="l-zh">{{ _lbl_zh }}</span>
            </div>
            <div class="mx5-dlg-cal-meta">
              {% if c.time_et %}<span class="mx5-dlg-cal-time">{{ c.time_et }} ET</span>{% endif %}
              <span class="mx5-dlg-cal-badge {{ _bdg }}">
                <span class="l-en">{{ c.impact | upper }}</span>
                <span class="l-zh">{{ {'high':'高','med':'中','low':'低'}.get(c.impact, c.impact) }}</span>
              </span>
            </div>
            {# Typical move plain line — if engine provides typical_move or move_context #}
            {% if c.get('typical_move') or c.get('move_context') %}
            <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:7px;line-height:1.4">
              <span class="l-en">{{ c.get('typical_move') or c.get('move_context') }}</span>
              <span class="l-zh">{{ c.get('typical_move_zh') or c.get('move_context_zh') or c.get('typical_move') or c.get('move_context') }}</span>
            </div>
            {% endif %}
            {# RIC W3: OPEX window risk level chip (display context only; RIC-R3) #}
            {% if c.type == 'OPEX' and c.get('opex_risk_level') %}
            {% set _opex_lvl = c.get('opex_risk_level') %}
            {% set _opex_lvl_zh = c.get('opex_risk_level_zh') or _opex_lvl %}
            {% set _opex_col = {'quiet': 'var(--ink-2,rgba(255,255,255,.5))', 'elevated': '#e8a04a', 'heavy': '#e05c5c'}.get(_opex_lvl, 'var(--ink-2,rgba(255,255,255,.5))') %}
            <div style="margin-top:7px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
              <span style="font-size:10px;font-weight:600;color:{{ _opex_col }};letter-spacing:.04em;text-transform:uppercase">
                <span class="l-en">Dealer pressure: {{ _opex_lvl }}</span>
                <span class="l-zh">经销商压力：{{ _opex_lvl_zh }}</span>
              </span>
              {% if c.get('opex_risk_n_hot') is not none and c.get('opex_risk_n_applicable') %}
              <span style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36))">{{ c.get('opex_risk_n_hot') }}/{{ c.get('opex_risk_n_applicable') }}</span>
              {% endif %}
            </div>
            {% if c.get('opex_risk_glance_en') %}
            <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:4px;line-height:1.4" title="OPEX window risk — display context only. Never a buy/sell signal.">
              <span class="l-en">{{ c.get('opex_risk_glance_en') }}</span>
              <span class="l-zh">{{ c.get('opex_risk_glance_zh') or c.get('opex_risk_glance_en') }}</span>
            </div>
            {% endif %}
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {# — W4 EVW collision chip (display-only, RIC program) — #}
        {# Shown ONLY when a collision state is active: plain-word copy, no scoring, no internal state names. #}
        {# is_context_only=True throughout; engine/risk_radar.py untouched. #}
        {% if evw_snap is defined and evw_snap and evw_snap.get('available') and evw_snap.get('active_collisions') %}
        {% set _evw_cols = evw_snap.active_collisions %}
        {% if _evw_cols %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Calendar Context</span><span class="l-zh">日历背景</span></div>
        <div style="padding:8px 0 4px;display:flex;flex-direction:column;gap:6px">
          {% for _col in _evw_cols %}
          {% if _col == 'cpi_in_opex_week' %}
          <div style="font-size:12px;line-height:1.5;color:var(--ink-2,rgba(255,255,255,.72))">
            <span class="l-en">CPI lands inside expiration week — expect louder tape. Watch, don&rsquo;t chase.</span>
            <span class="l-zh">CPI 落于期权到期周内——预计市场噪音更大。观望为主，勿追涨。</span>
          </div>
          {% elif _col == 'fomc_in_opex_week' %}
          <div style="font-size:12px;line-height:1.5;color:var(--ink-2,rgba(255,255,255,.72))">
            <span class="l-en">Fed decision inside expiration week — pin risk elevated. Sizing caution warranted.</span>
            <span class="l-zh">美联储决议落于到期周内——锁定风险上升，适当缩减仓位。</span>
          </div>
          {% elif _col == 'cpi_fomc_same_week' %}
          <div style="font-size:12px;line-height:1.5;color:var(--ink-2,rgba(255,255,255,.72))">
            <span class="l-en">CPI and Fed decision in the same week — sequenced vol risk, not additive. One print can reset the other&rsquo;s read.</span>
            <span class="l-zh">CPI 与美联储决议同周发布——波动风险有序叠加，而非简单相加。一个数据可能重置另一个的解读。</span>
          </div>
          {% elif _col == 'triple_stack' %}
          <div style="font-size:12px;line-height:1.5;color:var(--ink-2,rgba(255,255,255,.72))">
            <span class="l-en">Triple stack — major data print, Fed, and options expiration converge this week. Tape likely louder than usual. Watch, don&rsquo;t chase.</span>
            <span class="l-zh">三重叠加——重磅数据、美联储决议与期权到期本周齐发。市场噪音可能明显放大。观望为主，勿追涨。</span>
          </div>
          {% endif %}
          {% endfor %}
          <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));margin-top:2px">
            <span class="l-en">Calendar context — display only. Not a signal; no return claim.</span>
            <span class="l-zh">日历背景 — 仅供展示。非信号，不作任何收益主张。</span>
          </div>
        </div>
        {% endif %}
        {% endif %}

        {# — Fed prediction market pricing — #}
        {# Outcome enum → ZH display map, shared by this strip and dlg-fed below #}
        {% set _fed_out_zh = {'No change':'按兵不动','Rate cut':'降息','Rate hike':'加息','25bps cut':'降息25bp','50bps cut':'降息50bp','25bps hike':'加息25bp','25 bps increase':'加息25bp','25 bps decrease':'降息25bp','50+ bps increase':'加息50bp以上','50+ bps decrease':'降息50bp以上','0.1%':'0.1%','0.2%':'0.2%','0.3%':'0.3%','0.4%':'0.4%'} %}
        {% if prediction_markets and prediction_markets.events %}
        {# Unified benchmark strip (same component as dlg-fed). Plain "X in 10" read kept below. #}
        {% set _ev_bench_rows = [] %}
        {% set _ev_head_top = none %}
        {% for e in prediction_markets.events[:4] %}
        {% set _top = (e.outcomes | sort(attribute='prob', reverse=true)) | first %}
        {% if loop.first %}{% set _ev_head_top = _top %}{% endif %}
        {% if _ev_bench_rows.append({'outcome_en': _top.outcome, 'outcome_zh': _fed_out_zh.get(_top.outcome, _top.outcome), 'label_en': (e.label_en if e.label_en is defined else e.name), 'label_zh': (e.label_zh if e.label_zh is defined else (e.label_en if e.label_en is defined else e.name)), 'prob': _top.prob, 'chg_pp': (_top.chg_pp if _top.chg_pp is defined else none)}) %}{% endif %}
        {% endfor %}
        {{ fbm_bench_strip(_ev_bench_rows, (prediction_markets.source if prediction_markets.source is defined else 'Polymarket'), none) }}
        {% if _ev_head_top is not none and _ev_head_top.prob is defined and _ev_head_top.prob is not none %}
        {% set _fed_prob = _ev_head_top.prob | float %}
        {% set _fed_odds_n = ((_fed_prob / 10) | round | int) %}
        {% set _fed_zh_digit = {1:'一',2:'两',3:'三',4:'四',5:'五',6:'六',7:'七',8:'八',9:'九'}.get(_fed_odds_n) %}
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.42));padding:6px 2px 2px;line-height:1.4">
          <span class="l-en">In plain terms: about {{ _fed_odds_n }} in 10 traders expect &ldquo;{{ _ev_head_top.outcome }}&rdquo; at the next meeting.</span>
          <span class="l-zh">通俗地说：约{% if _fed_zh_digit %}{{ _fed_zh_digit }}成{% else %}{{ _fed_prob | round | int }}%{% endif %}交易者预期下次会议「{{ _fed_out_zh.get(_ev_head_top.outcome, _ev_head_top.outcome) }}」。</span>
        </div>
        {% endif %}
        {% endif %}

        {# — Inline Release Radar panel: the calendar cards above are its selector — #}
        {% if macro_catalysts %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Release Radar</span><span class="l-zh">数据发布雷达</span></div>
        <div style="margin:-4px 0 14px;font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));line-height:1.5">
          <span class="l-en">What our model expects for the print you pick above. Tap a card for the full read.</span>
          <span class="l-zh">上方选中日期，模型对该日数据的预测如下。点击卡片查看完整解读。</span>
        </div>
        <div id="rr-inline">
          <div class="rr-inline-head">
            <span class="rr-inline-date" id="rr-inline-date"></span>
            <span class="rr-inline-sub" id="rr-inline-sub">
              <span class="l-en">our projection vs benchmarks</span>
              <span class="l-zh">本方预测 vs 基准</span>
            </span>
          </div>
          <div class="rr-inline-body" id="rr-inline-body">
            <div class="rr-placeholder">
              <span class="l-en">Loading release projections…</span>
              <span class="l-zh">加载发布预测中…</span>
            </div>
          </div>
          <div class="rr-inline-foot">
            <span class="l-en">display-only — not a signal · benchmarks, not investment advice · scored forward in public</span>
            <span class="l-zh">仅展示 — 非信号 · 基准对比，非投资建议 · 正向评分公开记录</span>
          </div>
        </div>
        {% endif %}

        {% if not macro_catalysts and not (prediction_markets and prediction_markets.events) %}
        <p style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));margin-top:16px"><span class="l-en">No events data available.</span><span class="l-zh">暂无事件数据。</span></p>
        {% endif %}

      </div>
    </div>
  </div>

  {# dlg-markets: Index health + sector heat + heatmap + cross-asset — S2 redesign #}
  <div class="mx5-dlg" id="dlg-markets" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Markets — Index Health &amp; Cross-Asset</span><span class="l-zh">市场 — 指数健康度与跨资产</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — Index deep cards — #}
        {% if index_health %}
        <div class="mx5-dlg-eyebrow"><span class="l-en">Index Health</span><span class="l-zh">指数健康度</span></div>
        {% set _dlgm_ix_nm = {'SPY': 'S&P 500', 'QQQ': 'Nasdaq 100', 'DJI': 'Dow Jones', '_DJI': 'Dow Jones', 'RUT': 'Russell 2000', '_RUT': 'Russell 2000'} %}
        <div class="mx5-dlg-idx-grid">
          {% for ix in index_health %}
          {% set _dlgm_sym = ix.ticker | replace('_','') %}
          {# live-feed key: DJI/RUT snapshot rows are keyed ^DJI/^RUT (see face tiles _ix_live); bare DJI/RUT never resolve so the card would never live-patch #}
          {% set _dlgm_live = {'DJI': '^DJI', 'RUT': '^RUT'}.get(_dlgm_sym, _dlgm_sym) %}
          {% set _dlgm_chg = ix.chg if (ix.chg is defined and ix.chg is not none) else none %}
          {% set _dlgm_dir = ('up' if _dlgm_chg > 0 else ('dn' if _dlgm_chg < 0 else '')) if _dlgm_chg is not none else '' %}
          {% set _dlgm_col = ('var(--up)' if _dlgm_chg > 0 else ('var(--down)' if _dlgm_chg < 0 else 'var(--text)')) if _dlgm_chg is not none else 'var(--text)' %}
          <div class="mx5-dlg-idx-card">
            <div class="mx5-dlg-idx-ticker">{{ _dlgm_sym }}</div>
            <div class="mx5-dlg-idx-name">{{ _dlgm_ix_nm.get(ix.ticker, ix.label if ix.label is defined else _dlgm_sym) }}</div>
            <div class="mx5-dlg-idx-px nb-px" data-sym="{{ _dlgm_live }}" data-mkt="us" data-bare>{{ '{:,.2f}'.format(ix.price) }}</div>
            <div class="mx5-dlg-idx-chg {{ _dlgm_dir }} nb-chg" data-sym="{{ _dlgm_live }}" data-mkt="us">{% if _dlgm_chg is not none %}{{ '%+.2f'|format(_dlgm_chg) }}%{% else %}—{% endif %}</div>
            <div class="mx5-dlg-idx-chips">
              {# Distance from high — plain words #}
              {% set _dlgm_dd = ix.dd if (ix.dd is defined and ix.dd is not none) else none %}
              {% if _dlgm_dd is not none %}<span class="mx5-dlg-idx-chip {{ 'ok' if _dlgm_dd >= -1 else ('wn' if _dlgm_dd >= -10 else 'mt') }}" title="Distance from 52-week high">{{ '%+.1f'|format(_dlgm_dd) }}% <span class="l-en">off high</span><span class="l-zh">距高</span></span>{% endif %}
              {# Trend vs 50d MA #}
              {% if ix.above50 is defined %}
              <span class="mx5-dlg-idx-chip {{ 'ok' if ix.above50 else 'mt' }}" title="vs 50-day moving average"><span class="l-en">{{ 'Above' if ix.above50 else 'Below' }} 50-day {{ '✓' if ix.above50 else '✕' }}</span><span class="l-zh">{{ '高于' if ix.above50 else '低于' }}50日线 {{ '✓' if ix.above50 else '✕' }}</span></span>
              {% endif %}
              {# Trend vs 200d MA #}
              {% if ix.above200 is defined %}
              <span class="mx5-dlg-idx-chip {{ 'ok' if ix.above200 else 'mt' }}" title="vs 200-day moving average"><span class="l-en">{{ 'Above' if ix.above200 else 'Below' }} 200-day {{ '✓' if ix.above200 else '✕' }}</span><span class="l-zh">{{ '高于' if ix.above200 else '低于' }}200日线 {{ '✓' if ix.above200 else '✕' }}</span></span>
              {% endif %}
              {# RSI — plain-word read, not raw number #}
              {% if ix.rsi is not none %}
              {% set _dlgm_rsi_word = 'Overbought' if ix.rsi >= 70 else ('Oversold' if ix.rsi <= 30 else 'Neutral') %}
              {% set _dlgm_rsi_zh = '超买' if ix.rsi >= 70 else ('超卖' if ix.rsi <= 30 else '中性') %}
              <span class="mx5-dlg-idx-chip {{ 'wn' if ix.rsi >= 70 or ix.rsi <= 30 else 'mt' }}" title="RSI(14) = {{ ix.rsi }}"><span class="l-en">{{ _dlgm_rsi_word }}</span><span class="l-zh">{{ _dlgm_rsi_zh }}</span></span>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {# — Sector hot / cold columns — #}
