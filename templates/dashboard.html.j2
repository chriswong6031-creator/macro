  {% if mode == 'stocks' and (macro_catalysts or (prediction_markets and prediction_markets.events)) %}
  <style id="cal-css">
  #week-ahead .cal-row{display:flex;gap:8px;overflow-x:auto;padding-bottom:2px}
  #week-ahead .cal-ev{flex:1 1 0;min-width:124px;border:1px solid var(--line);
    border-radius:8px;padding:8px 11px;background:var(--panel2)}
  #week-ahead .cal-ev.cal-high{border-left-color:var(--down)}
  #week-ahead .cal-ev.cal-med{border-left-color:var(--warn)}
  #week-ahead .cal-date{font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--text)}
  #week-ahead .cal-lbl{font-size:12.5px;font-weight:600;margin:3px 0 2px;line-height:1.25}
