<script>
/* Keep .help tooltips on-screen: flip below the icon when it's near the top of
   the viewport, and clamp horizontally near the left/right edges. Hover-only,
   no layout cost until you point at a "?". */
(function(){
  function place(h){
    var r = h.getBoundingClientRect(), vw = window.innerWidth;
    h.classList.toggle('below', r.top < 240);
    h.classList.remove('edge-left','edge-right');
    if (r.left > vw - 170) h.classList.add('edge-right');
    else if (r.left < 170) h.classList.add('edge-left');
  }
  document.addEventListener('pointerover', function(e){
    var h = e.target.closest && e.target.closest('.help');
    if (h) place(h);
  }, true);
})();
</script>
<script>
/* Per-card detail as an ANCHORED DROPDOWN POPOVER (.nb-more-btn opens a fixed floating
   .nb-more panel; JS positions it from the button rect and flips up / clamps to the edge —
   mirrors the .nb-cau placePop idiom). Only one open at a time; closes on ×, outside click,
   or Esc; repositions on scroll/resize. Delegated on document so it works regardless of
   showmore reveal order. */
(function(){
  var openCard = null;
  var LBL_OPEN  = '<span class="l-en">▴ less</span><span class="l-zh">▴ 收起</span>';
  var LBL_SHUT  = '<span class="l-en">▾ details</span><span class="l-zh">▾ 详情</span>';
  function closePop(){
    if (!openCard) return;
    openCard.classList.remove('nb-open');
    var b = openCard.querySelector('.nb-more-btn');
    if (b){ b.setAttribute('aria-expanded','false'); b.innerHTML = LBL_SHUT; }
    openCard = null;
  }
  function place(card){
    var pop = card.querySelector('.nb-more'), btn = card.querySelector('.nb-more-btn');
    if (!pop || !btn) return;
    var r = btn.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight, m = 10;
    var pw = pop.offsetWidth, ph = pop.offsetHeight;
    // horizontal: align the popover's left edge under the button, clamp to viewport
    var left = Math.min(Math.max(m, r.left), Math.max(m, vw - pw - m));
    // vertical: drop below the button; if it would overflow, flip above; else pin near bottom
    var top = r.bottom + 6;
    if (top + ph > vh - m){ var above = r.top - 6 - ph; top = (above >= m) ? above : Math.max(m, vh - ph - m); }
    pop.style.left = left + 'px'; pop.style.top = top + 'px';
  }
  document.addEventListener('click', function(e){
    if (e.target.closest && e.target.closest('.nb-more-x')){ e.preventDefault(); e.stopPropagation(); closePop(); return; }
    var btn = e.target.closest && e.target.closest('.nb-more-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var card = btn.closest('.nbcard'); if (!card) return;
      var wasOpen = (card === openCard);
      closePop();
      if (!wasOpen){
        card.classList.add('nb-open');
        btn.setAttribute('aria-expanded','true'); btn.innerHTML = LBL_OPEN;
        openCard = card;
        place(card);   // .nb-more is display:block now → measurable
      }
      return;
    }
    if (openCard && !(e.target.closest && e.target.closest('.nb-more'))) closePop();
  }, true);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePop(); });
  window.addEventListener('scroll', function(){ if (openCard) place(openCard); }, true);
  window.addEventListener('resize', function(){ if (openCard) place(openCard); });
})();

/* Card-body delegated click handler: clicking the .nbcard div (outside the head anchor,
   the caution btn, the more-btn, or the expander) triggers the head anchor's .click(),
   re-entering the Terminal interceptor naturally (theme.js L142-149 intercepts a[href]).
   This preserves "click a card for the full breakdown" UX post div-restructure.
   nb-spot data-href chips get their own handler (see theme.js addition). */
(function(){
  document.addEventListener('click', function(e){
    var card = e.target.closest && e.target.closest('.nbcard');
    if (!card) return;
    /* skip if click is on an interactive sub-element that handles itself */
    if (e.target.closest('.nb-cau-btn') || e.target.closest('.nb-cau-pop') ||
        e.target.closest('.nb-more-btn') || e.target.closest('.nb-more') ||
        e.target.closest('.nb-spot[data-href]') || e.target.closest('.nb-head-link')) return;
    var headLink = card.querySelector('.nb-head-link');
    if (headLink) { headLink.click(); }
  });
})();
</script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge).
   (Chip explanatory copy uses the theme.js data-tip mechanism instead — one
   repo-standard tooltip; the W2 bespoke chip popover was retired at merge.) */
(function(){
  function placePopCau(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  function closeAllPops(){
    document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
  }
  /* Tap: toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      closeAllPops();
      if (!wasOpen){ placePopCau(wrap); wrap.classList.add('nb-cau-open'); }
      return;
    }
    /* outside tap: close all */
    if (!e.target.closest('.nb-cau-pop')){
      closeAllPops();
    }
  }, true);
  /* Position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var cau = e.target.closest && e.target.closest('.nb-cau');
    if (cau){ placePopCau(cau); return; }
  }, true);
})();
</script>
{% if mode == 'stocks' %}
<script>
/* TS-U3 dash-tape-band + dash-tw-strip + dash-mtf-section JS (mode=stocks only).
   FT-R1/TS-R5: display-tier only; never mutates slow state; no buy verbs.
   FT-R8: graceful absent-file. TS-R1: honest-delay modes. */
(function(){
'use strict';
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function L(en,zh){return'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>';}
function fmtPct(v){if(v==null)return'—';return(v>=0?'+':'')+v.toFixed(2)+'%';}
function clsPct(v){return v==null?'muted':v>=0?'up':'dn';}

function fetchJson(url, cb){
  fetch(url,{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(cb)
    .catch(function(){});
}

/* ────────────────────────────────────────────────────────────────────────
   TAPE BAND (TS-R7 — dashboard reach; clones FTR W3 idiom)
   ──────────────────────────────────────────────────────────────────────── */
var SESSION_LABELS = {
  pre:  {cls:'pre',  en:'PREMARKET',   zh:'盘前'},
  rth:  {cls:'live', en:'LIVE · RTH',  zh:'实盘 · 正常时段'},
  post: {cls:'post', en:'POST-MARKET', zh:'盘后'},
  closed:{cls:'closed',en:'CLOSED',   zh:'休市'}
};
function isChipSuppressed(pulse){ return !pulse || (pulse.mode||'live') !== 'live'; }
function modePillHtml(pulse){
  var mode = pulse.mode||'live';
  if(mode==='live') return '';
  var delay = pulse.delay_min_median;
  var asof  = pulse.as_of_quotes || pulse.as_of_utc;
  var asofStr='';
  if(asof){try{asofStr=asof.length<=10?asof:new Date(asof).toLocaleString([],{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZoneName:'short'});}catch(e){asofStr=asof;}}
  var pills={delayed:{en:'DELAYED',zh:'延迟数据',cls:'pre'},last_rth:{en:'LAST SESSION',zh:'上一交易时段',cls:'post'},eod:{en:'EOD CLOSE',zh:'收盘价',cls:'closed'}};
  var p=pills[mode]||{en:mode.toUpperCase(),zh:mode,cls:'closed'};
  var delayNote='';
  if(mode==='delayed'&&delay!=null){var h=Math.round(delay/60);delayNote=' · '+L('~'+h+'h delay','约'+h+'小时延迟');}
  var asofNote=asofStr?(' · '+L('as of '+esc(asofStr),'截至 '+esc(asofStr))):'';
  return '<span class="ftr-session-pill '+p.cls+'" style="margin-left:6px;font-size:10px">'+L(esc(p.en),esc(p.zh))+delayNote+asofNote+'</span>';
}
function renderTapeBand(pulse){
  var band = document.getElementById('dash-tape-band');
  if(!band) return;
  if(!pulse){band.classList.remove('visible');return;}
  band.classList.add('visible');
  var session = pulse.session||'closed';
  var mode    = pulse.mode||'live';
  // Session pill
  var info = SESSION_LABELS[session]||SESSION_LABELS.closed;
  var pill = document.getElementById('dash-session-pill');
  var lbl  = document.getElementById('dash-session-label');
  if(pill){ pill.className='ftr-session-pill '+info.cls; }
  if(lbl){ lbl.innerHTML=L(esc(info.en),esc(info.zh)); }
  // Mode pill + as-of
  var asofEl = document.getElementById('dash-tape-asof');
  if(asofEl){
    var ts = pulse.as_of_quotes||pulse.as_of_utc, tsStr='';
    if(ts){try{tsStr=ts.length<=10?ts:new Date(ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',timeZoneName:'short'});}catch(e){tsStr=ts;}}
    asofEl.innerHTML=(tsStr?L('as of '+esc(tsStr),'截至 '+esc(tsStr)):'')+modePillHtml(pulse);
  }
  // Opacity
  var hasAny=(pulse.baskets||[]).some(function(b){return b.live_ew_chg_pct!=null;});
  band.style.opacity=(mode==='live')?'':(hasAny?'0.85':'0.65');
  // AI-capex badge
  var cxEl = document.getElementById('dash-cx-badge');
  if(cxEl){
    var cx=null;
    (pulse.complexes||[]).forEach(function(c){if(c.complex_id==='ai_capex')cx=c;});
    if(cx&&cx.live_ew_chg_pct!=null&&!isChipSuppressed(pulse)){
      var isG=cx.live_ew_chg_pct>=0;
      var col=isG?'rgba(35,192,138,.10)':'rgba(255,92,108,.07)';
      var bdr=isG?'rgba(35,192,138,.28)':'rgba(255,92,108,.25)';
      var vc=isG?'var(--up)':'var(--down)';
      cxEl.innerHTML='<div class="ftr-cx-badge" style="background:'+col+';border-color:'+bdr+'">'
        +'<div><div class="cx-name">'+L('AI-Capex Complex','AI资本开支复合板块')+'</div>'
        +(cx.only_green_complex?'<div class="cx-note" style="color:'+vc+'">'+L('only green complex','唯一上涨复合板块')+'</div>':'')+'</div>'
        +'<div class="cx-val" style="color:'+vc+'">'+fmtPct(cx.live_ew_chg_pct)+'</div></div>';
    } else { cxEl.innerHTML=''; }
  }
  // Movers — top 5 / bottom 3
  var topEl=document.getElementById('dash-top-movers'),botEl=document.getElementById('dash-bot-movers');
  if(!topEl||!botEl) return;
  var live=(pulse.baskets||[]).filter(function(b){return b.live_ew_chg_pct!=null&&b.tape_rank!=null;});
  if(!live.length){
    var noMsg='<span class="muted" style="font-size:11px">'+L('quotes loading…','报价加载中…')+'</span>';
    topEl.innerHTML=noMsg; botEl.innerHTML=noMsg; return;
  }
  live.sort(function(a,b){return b.tape_rank-a.tape_rank;});
  var top5=live.slice(0,5), bot3=live.slice(-3).reverse();
  function mRow(b){
    var chg=b.live_ew_chg_pct, isUp=chg>=0;
    var barW=Math.min(44,Math.abs(chg)*10);
    return '<div class="dash-mrow">'
      +'<span class="mr-rank">#'+b.tape_rank+'</span>'
      +'<span class="mr-name">'+esc(b.id)+'</span>'
      +'<span class="mr-chg '+(isUp?'up':'dn')+'">'+fmtPct(chg)+'</span>'
      +'<div class="mr-bar '+(isUp?'up':'dn')+'" style="width:'+barW.toFixed(0)+'px"></div>'
      +'</div>';
  }
  topEl.innerHTML=top5.map(mRow).join('');
  botEl.innerHTML=bot3.map(mRow).join('');
}

/* ────────────────────────────────────────────────────────────────────────
   TURN WATCH STRIP + AUTO-EXPAND SALIENCE (TS-R5 / TS-R7)
   Shows baskets with WATCH/IGNITION state OR ≥2 UPTURN_CONFIRMED members
   while slow reco is hold/avoid. Removes is-collapsed from hold fold for
   matched rows (TS-R5); adds ⚡ chip to those rows.
   ──────────────────────────────────────────────────────────────────────── */
function renderTurnWatch(turnWatch, mtfUpturn){
  var stripEl=document.getElementById('dash-tw-strip');
  var rowsEl=document.getElementById('dash-tw-rows');
  var asofEl=document.getElementById('dash-tw-asof');
  if(!stripEl||!rowsEl) return;

  // Build mtfUpturn member-confirmed index: basket_id → confirmed count
  var mtfBasketConfirmed={};
  if(mtfUpturn&&mtfUpturn.tickers){
    Object.keys(mtfUpturn.tickers).forEach(function(sym){
      var t=mtfUpturn.tickers[sym];
      if(t.state==='UPTURN_CONFIRMED'){
        (t.basket_ids||[]).forEach(function(bid){
          mtfBasketConfirmed[bid]=(mtfBasketConfirmed[bid]||0)+1;
        });
      }
    });
  }

  // Build candidate list from turn_watch (basket-level)
  var candidates=[];
  var twBaskets=(turnWatch&&turnWatch.baskets)||[];
  var twAsOf=(turnWatch&&turnWatch.as_of)||'';
  var DISAGREE_RECOS={'hold':1,'avoid':1};  // TS-R5 disagreement gate (A1 fix)
  twBaskets.forEach(function(tw){
    var isActive=tw.state==='WATCH'||tw.state==='IGNITION';
    var memberCount=mtfBasketConfirmed[tw.basket_id]||0;
    // Show if: active state OR ≥2 members UPTURN_CONFIRMED
    if(!isActive&&memberCount<2) return;
    // TS-R5 disagreement gate: for WATCH/IGNITION baskets, only surface when slow_reco
    // is hold/avoid (turn disagrees with slow read) or when reco is absent (honest null).
    // A basket already on a buy reco + IGNITION is agreement, not disagreement — omit.
    var reco=(tw.slow_reco||'').toLowerCase();
    if(isActive&&reco&&!DISAGREE_RECOS[reco]) return;
    candidates.push({
      id: tw.basket_id,
      name: tw.basket_id,  // basket name from id; ideally enriched from pulse
      tw_state: isActive?tw.state:null,
      member_confirmed: memberCount,
      reco: tw.slow_reco||'',
      reco_as_of: tw.reco_as_of||'',
      sort_key: (tw.state==='IGNITION'?0:tw.state==='WATCH'?1:2)*100 - memberCount
    });
  });
  // Also add baskets with ≥2 UPTURN_CONFIRMED members even if NOT in turn_watch baskets
  Object.keys(mtfBasketConfirmed).forEach(function(bid){
    var count=mtfBasketConfirmed[bid];
    if(count>=2&&!candidates.find(function(c){return c.id===bid;})){
      candidates.push({
        id:bid, name:bid, tw_state:null, member_confirmed:count,
        reco:'', reco_as_of:'', sort_key:200-count
      });
    }
  });

  candidates.sort(function(a,b){return a.sort_key-b.sort_key;});
  candidates=candidates.slice(0,6);

  if(!candidates.length){stripEl.classList.remove('visible');return;}
  stripEl.classList.add('visible');
  if(asofEl&&twAsOf){asofEl.textContent=L('nightly · '+esc(twAsOf),'每晚 · '+esc(twAsOf));}

  // Render rows
  var html='';
  candidates.forEach(function(c){
    var badgeCls='member', badgeTxt='';
    if(c.tw_state==='IGNITION'){ badgeCls='ignition'; badgeTxt=L('&#9889; IGNITION','&#9889; 点火'); }
    else if(c.tw_state==='WATCH'){ badgeCls='watch'; badgeTxt=L('&#9889; WATCH','&#9889; 观察'); }
    else { badgeTxt=L(c.member_confirmed+' members confirmed',c.member_confirmed+'个成分确认'); }
    var slowPart='';
    if(c.reco){
      var dateStr=c.reco_as_of?c.reco_as_of.slice(5):'';
      var recoEn='slow reco: '+esc(c.reco.toUpperCase())+(dateStr?' (as-of '+esc(dateStr)+')':'');
      var recoZh='慢速评级: '+esc(c.reco.toUpperCase())+(dateStr?' (截至'+esc(dateStr)+'）':'');
      slowPart='<span class="dash-tw-slow">'+L(recoEn,recoZh)+'</span>';
    }
    var fadeStr=L(' · T+1 58% fade',' · T+1 58%消退');
    html+='<div class="dash-tw-row">'
      +'<span class="dash-tw-badge '+badgeCls+'">'+badgeTxt+'</span>'
      +'<span class="dash-tw-name">'+esc(c.name)+'</span>'
      +slowPart
      +'<span class="dash-tw-slow">'+fadeStr+'</span>'
      +'</div>';
  });
  rowsEl.innerHTML=html;

  // TS-R5: auto-expand hold fold for matched theme IDs; add ⚡ chip
  var matchedIds=new Set(candidates.map(function(c){return c.id;}));
  var fold=document.getElementById('dash-hold-fold');
  if(fold&&matchedIds.size){
    var needExpand=false;
    fold.querySelectorAll('[data-theme-id]').forEach(function(wrapper){
      var tid=wrapper.getAttribute('data-theme-id');
      if(!tid||!matchedIds.has(tid)) return;
      // Add ⚡ salience chip if not already present
      if(!wrapper.querySelector('.dash-turn-chip')){
        var chip=document.createElement('span');
        chip.className='dash-turn-chip';
        chip.innerHTML='&#9889; '+L('TURN WATCH','拐点观察');
        wrapper.appendChild(chip);
      }
      // Check if this item is currently hidden (would be after n+7 sibling)
      // We'll just un-collapse the whole fold when any match is hidden
      needExpand=true;
    });
    if(needExpand&&fold.classList.contains('is-collapsed')){
      fold.classList.remove('is-collapsed');
      // Update button state
      var btn=fold.parentElement&&fold.parentElement.querySelector('.lst-more');
      if(btn){btn.setAttribute('aria-expanded','true');var sh=btn.querySelector('.lm-show'),hi=btn.querySelector('.lm-hide');if(sh)sh.style.display='none';if(hi)hi.style.display='inline';}
    }
  }
}

/* ────────────────────────────────────────────────────────────────────────
   PER-STOCK TURN SETUPS TABLE (TS-R3 / TS-R7 / TS-R3)
   ──────────────────────────────────────────────────────────────────────── */
var MAG7=['AAPL','AMZN','GOOGL','META','MSFT','NVDA','TSLA'];
function renderMtfTable(mtfUpturn){
  var bodyEl=document.getElementById('dash-mtf-body');
  if(!bodyEl) return;

  if(!mtfUpturn||!mtfUpturn.tickers){
    bodyEl.innerHTML='<p class="dash-mtf-absent">'
      +L('Turn setup data lands after tonight\'s nightly (~02:00 UTC). Mag7 + basket members will appear here.',
         '拐点形态数据将在今晚收盘后更新（约UTC 02:00）。Mag7及篮子成分将在此显示。')
      +'</p>';
    return;
  }

  var tickers=mtfUpturn.tickers;
  var asOf=mtfUpturn.as_of||'';

  // Build row list: CONFIRMED first, then WATCH, then Mag7 NONE
  var confirmed=[], watch=[], mag7None=[];
  var seen=new Set();
  (mtfUpturn.cohort&&mtfUpturn.cohort.confirmed||[]).forEach(function(sym){
    if(tickers[sym]){confirmed.push(sym);seen.add(sym);}
  });
  (mtfUpturn.cohort&&mtfUpturn.cohort.watch||[]).forEach(function(sym){
    if(tickers[sym]&&!seen.has(sym)){watch.push(sym);seen.add(sym);}
  });
  MAG7.forEach(function(sym){
    if(tickers[sym]&&!seen.has(sym)){mag7None.push(sym);seen.add(sym);}
  });

  var rows=confirmed.concat(watch).concat(mag7None).slice(0,40);

  if(!rows.length){
    bodyEl.innerHTML='<p class="dash-mtf-absent">'+L('No turn setup data yet.','暂无拐点形态数据。')+'</p>';
    return;
  }

  // Leg glyphs
  function legEl(fired, isPartial, label){
    var cls=fired?'on':(isPartial?'partial':'off');
    return '<span class="dash-mtf-leg '+cls+'" title="'+esc(label)+'">'+esc(label.slice(0,2))+'</span>';
  }
  function wMacdEl(val){
    if(val==='cross') return '<span class="dash-mtf-leg on">W</span>';
    if(val==='approaching') return '<span class="dash-mtf-leg partial" style="border-style:dashed">W</span>';
    return '<span class="dash-mtf-leg off">W</span>';
  }

  var html='<p class="muted" style="font-size:11px;margin:0 0 5px">'
    +L('as of '+esc(asOf)+' · Mag7 always shown · forward-graded meter (expected null) · display only',
       '截至 '+esc(asOf)+' · Mag7始终显示 · 前瞻计量（预期空值）· 仅展示')+'</p>';
  html+='<table class="dash-mtf-tbl"><thead><tr>'
    +'<th>'+L('ticker','代码')+'</th>'
    +'<th>'+L('state','状态')+'</th>'
    +'<th class="r">K</th>'
    +'<th>'+L('legs (D / 3D / W / 2W)','信号腿 (D / 3D / W / 2W)')
      +' <span class="help" style="vertical-align:middle">?<span class="tip">'
      +'<span class="l-en">D=daily MACD bull cross; 3D=3-day MACD+StochRSI confluence; W=weekly MACD (solid=confirmed, dashed=approaching); 2W=biweekly MACD. Forward-graded meter; prior sector-level turn printed NULL (Oracle P8). Display context, not a signal.</span>'
      +'<span class="l-zh">D=日线MACD金叉；3D=3日MACD+StochRSI共振；W=周线MACD（实线=确认，虚线=接近）；2W=双周MACD。前瞻计量；板块级别拐点为NULL（Oracle P8）。展示参考，非信号。</span>'
      +'</span></span></th>'
    +'<th>'+L('monthly phase','月线阶段')+'</th>'
    +'<th>'+L('since','起始')+'</th>'
    +'<th>'+L('baskets','篮子')+'</th>'
    +'</tr></thead><tbody>';

  rows.forEach(function(sym){
    var t=tickers[sym];
    var legs=t.legs||{};
    var stateCls=t.state==='UPTURN_CONFIRMED'?'confirmed':t.state==='UPTURN_WATCH'?'watch':'none';
    var stateLbl=t.state==='UPTURN_CONFIRMED'?L('CONFIRMED','已确认'):t.state==='UPTURN_WATCH'?L('WATCH','观察'):L('—','—');
    var basketStr=(t.basket_ids||[]).slice(0,3).join(', ')+(t.basket_ids&&t.basket_ids.length>3?'…':'');
    html+='<tr>'
      +'<td><b>'+esc(sym)+'</b></td>'
      +'<td><span class="dash-mtf-badge '+stateCls+'">'+stateLbl+'</span></td>'
      +'<td class="r"><span class="dash-mtf-k">'+(t.k||0)+'</span></td>'
      +'<td><div class="dash-mtf-legs">'
        +legEl(!!legs.d_macd,false,'D')
        +legEl(!!legs.d3_confluence,false,'3D')
        +wMacdEl(legs.w_macd||'none')
        +legEl(!!legs.w2_macd,false,'2W')
      +'</div></td>'
      +'<td class="dash-mtf-phase">'+esc(t.monthly_phase||'—')+'</td>'
      +'<td class="dash-mtf-since">'+esc(t.since||'—')+'</td>'
      +'<td class="dash-mtf-baskets">'+esc(basketStr||'—')+'</td>'
      +'</tr>';
  });
  html+='</tbody></table>';
  bodyEl.innerHTML=html;
}

/* ────────────────────────────────────────────────────────────────────────
   FETCH + ORCHESTRATE
   ──────────────────────────────────────────────────────────────────────── */
var pulse=null, turnWatch=null, mtfUpturn=null;
var pulseDone=false, twDone=false, mtfDone=false;

function tryRender(){
  if(!pulseDone||!twDone||!mtfDone) return;
  renderTapeBand(pulse);
  renderTurnWatch(turnWatch, mtfUpturn);
  renderMtfTable(mtfUpturn);
}

fetchJson('live/basket_pulse.json',function(d){pulse=d;pulseDone=true;tryRender();});
fetchJson('basketdata/turn_watch.json',function(d){turnWatch=d;twDone=true;tryRender();});
fetchJson('stockdata/mtf_upturn.json',function(d){mtfUpturn=d;mtfDone=true;tryRender();});

// Fail-open: if any fetch doesn't resolve, still render with what we have
setTimeout(function(){pulseDone=true;twDone=true;mtfDone=true;tryRender();},4000);

})();
</script>
