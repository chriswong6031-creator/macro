{% macro help(text) -%}
<span class="help">?<span class="tip">{{ text }}</span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Macro Regime Dashboard — {{ latest.date }}</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font: 14px/1.5 -apple-system,
         "Segoe UI", Roboto, Helvetica, sans-serif; margin: 0; padding: 18px; }
  /* breathing room on wide desktops — content centered, never edge-to-edge */
  @media (min-width: 1100px) { body { padding: 26px max(40px, calc((100vw - 1500px) / 2)); } }
  a { text-decoration: none; }
  h1 { font-size: 20px; margin: 0 0 2px; }
  h2 { font-size: 15px; margin: 0 0 10px; color: var(--muted);
       text-transform: uppercase; letter-spacing: .06em; }
  h3 { font-size: 13px; margin: 14px 0 6px; color: var(--text); }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(12, 1fr); }
  .panel { background: var(--panel); border: 1px solid var(--line);
           border-radius: 10px; padding: 14px 16px; }
  .span12 { grid-column: span 12; } .span8 { grid-column: span 8; }
  .span6 { grid-column: span 6; } .span4 { grid-column: span 4; }
  @media (max-width: 900px) { .span8, .span6, .span4 { grid-column: span 12; } }

  .badge { display: inline-block; padding: 3px 12px; border-radius: 14px;
           font-weight: 600; font-size: 13px; }
  /* quad badge keeps its solid vivid colour; text contrast set per badge */
  .quad-Q1, .quad-Q3, .quad-Q4 { color: #fff; }
  .quad-Q2 { color: #1a1a1a; }
  .quad-Q1 { background: var(--q1); } .quad-Q2 { background: var(--q2); }
  .quad-Q3 { background: var(--q3); } .quad-Q4 { background: var(--q4); }
  .kv { color: var(--muted); } .kv b { color: var(--text); font-weight: 600; }

  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: right; padding: 4px 8px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 500; }
  th:first-child, td:first-child { text-align: left; }
  td.l, th.l { text-align: left; }

  .pill { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 12px; }

  .alert { padding: 8px 12px; border-radius: 8px; margin: 6px 0;
           background: var(--panel2); border-left: 3px solid var(--muted); }
  .alert-act { border-left-color: var(--act); }
  .alert-warn { border-left-color: var(--warn); }
  .muted { color: var(--muted); }
  .chart { width: 100%; }
  .topline { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }

  .help { display: inline-flex; align-items: center; justify-content: center;
          width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--muted);
          color: var(--muted); font-size: 10px; font-weight: 600; cursor: help;
          position: relative; vertical-align: middle; margin-left: 5px; flex: none; }
  .help .tip { display: none; position: absolute; bottom: 140%; left: 50%;
               transform: translateX(-50%); width: 290px;
               background: var(--panel); border: 1px solid var(--line);
               padding: 9px 11px; border-radius: 8px;
               z-index: 60; font-size: 12px; line-height: 1.45; color: var(--text);
               text-align: left; font-weight: 400; text-transform: none;
               letter-spacing: normal; box-shadow: 0 6px 18px rgba(0,0,0,.5);
               pointer-events: none; white-space: normal; }
  .help:hover .tip { display: block; }
  th .help .tip, .help.below .tip { bottom: auto; top: 140%; }
  /* keep tooltips on-screen near the right/left viewport edges */
  .help.edge-right .tip { left: auto; right: 0; transform: none; }
  .help.edge-left .tip { left: 0; right: auto; transform: none; }
  .tip-map { width: 360px !important; }
  /* structured tooltip building blocks */
  .tip table { width: 100%; margin: 6px 0 2px; font-size: 11.5px; }
  .tip th, .tip td { padding: 3px 6px; border-bottom: 1px solid var(--line); }
  .tip .lad { display: block; padding: 3px 8px; border-radius: 5px; margin: 3px 0;
              font-size: 11.5px; }
  .tip .scale { display: flex; height: 12px; border-radius: 6px; overflow: hidden;
                margin: 6px 0 2px; font-size: 9.5px; font-weight: 700; }
  .tip .scale span { flex: 1; display: flex; align-items: center; justify-content: center;
                     color: #fff; }
  .tip .sl { display: flex; justify-content: space-between; font-size: 10px;
             color: var(--muted); margin-bottom: 4px; }
  .qgrid { display: grid; grid-template-columns: 58px 1fr 1fr; gap: 4px; margin: 8px 0; }
  .qax { color: var(--muted); font-size: 10.5px; align-self: center; text-align: center; }
  .qcell { border-radius: 6px; padding: 7px 6px; text-align: center; color: #fff;
           font-weight: 700; font-size: 11px; line-height: 1.25; }
  .qcell small { font-weight: 400; opacity: .85; }
  .qcell.qcur { outline: 2px solid #fff; }

  .dial { display: flex; gap: 4px; margin: 8px 0 12px; }
  .dial span { flex: 1; text-align: center; padding: 6px 2px; border-radius: 6px;
               background: var(--panel2); color: var(--muted); font-size: 11px;
               font-weight: 600; letter-spacing: .04em; }
  .dial .active-DEFENSIVE { background: var(--act); color: #fff; }
  .dial .active-CAREFUL { background: var(--orange); color: #fff; }
  .dial .active-NEUTRAL { background: var(--muted); color: #fff; }
  .dial .active-CONSTRUCTIVE { background: var(--up); color: #fff; }
  .dial .active-AGGRESSIVE { background: var(--ok); color: #fff; }
  @media (max-width: 520px) { .dial span { font-size: 8.5px; padding: 5px 1px; } }
  .reason { margin: 4px 0; padding-left: 24px; position: relative; }
  .reason b.sig { position: absolute; left: 0; width: 17px; text-align: center;
                  border-radius: 4px; font-size: 12px; }

  .card { background: var(--panel2); border: 1px solid var(--line); border-radius: 8px;
          padding: 10px 12px; margin: 6px 0; }
  .card b.tk { font-size: 14px; }
  .calltag { float: right; font-size: 11px; font-weight: 700; padding: 1px 8px;
             border-radius: 9px; }
  /* .tag-lead/avoid/watch and .chip-pos/neg colours come from theme.css */
  .chip { display: inline-block; padding: 2px 9px; margin: 2px 3px 2px 0;
          border-radius: 10px; font-size: 12px; border: 1px solid var(--line); }

  /* action board */
  .actiongrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 900px) { .actiongrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .actiongrid { grid-template-columns: 1fr; } }
  .actcol { background: var(--panel2); border: 1px solid var(--line);
            border-radius: 10px; padding: 10px 12px; border-top: 3px solid var(--line); }
  .act-buy { border-top-color: var(--up); } .act-soon { border-top-color: var(--g-cold); }
  .act-trim { border-top-color: var(--warn); } .act-hold { border-top-color: var(--muted); }
  .acth { font-size: 11.5px; font-weight: 700; letter-spacing: .03em; margin-bottom: 7px; }
  .actitem { display: flex; align-items: center; gap: 6px; padding: 5px 0;
             border-bottom: 1px solid var(--line); font-size: 13px; }
  .actitem:last-child { border-bottom: none; }
  .actitem b { color: var(--text); }
  .acttag { margin-left: auto; font-size: 10.5px; color: var(--muted); }
  .acteta { margin-left: auto; font-size: 11px; font-weight: 700; color: var(--g-cold);
            background: color-mix(in srgb, var(--g-cold) 16%, transparent);
            padding: 1px 7px; border-radius: 9px; }
  .notable { margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--line); }
  .sm { font-size: 12px; margin: 4px 0; }

  .gauge { position: relative; height: 10px; border-radius: 5px; margin: 6px 0 2px;
           background: linear-gradient(90deg, var(--down) 0%, var(--g-mid) 50%, var(--up) 100%); opacity:.9; }
  .gauge i { position: absolute; top: -4px; width: 4px; height: 18px; background: var(--text);
             border-radius: 2px; box-shadow: 0 0 0 1px var(--panel); }
  /* crowding gauge: both ENDS are danger zones */
  .pgauge { position: relative; height: 9px; border-radius: 5px; margin: 4px 0 2px;
            background: linear-gradient(90deg, var(--g-cold) 0%, var(--g-mid) 28%, var(--g-mid) 72%, var(--down) 100%);
            opacity: .9; min-width: 130px; }
  .pgauge i { position: absolute; top: -3px; width: 4px; height: 15px; background: var(--text);
              border-radius: 2px; box-shadow: 0 0 0 1px var(--panel); }
  .pends { display: flex; justify-content: space-between; font-size: 10px;
           color: var(--muted); }
  .plabel { display: inline-block; padding: 1px 9px; border-radius: 10px; font-size: 12px;
            font-weight: 600; background: var(--panel2); }
  .plabel-hot { color: var(--down); } .plabel-cold { color: var(--info); }
  .plabel-norm { color: var(--muted); }

  /* regime lifespan bar */
  .lifebar { position: relative; height: 16px; border-radius: 8px; overflow: hidden;
             background: var(--panel2); margin: 8px 0 4px; }
  .lifebar .zone { position: absolute; top: 0; bottom: 0; }
  .lifebar .marker { position: absolute; top: -2px; bottom: -2px; width: 4px;
                     background: var(--text); border-radius: 2px; z-index: 5;
                     box-shadow: 0 0 0 1px var(--panel); }
  .lifelabels { display: flex; justify-content: space-between; font-size: 11px;
                color: var(--muted); }

  /* next-regime probability bars */
  .prob { display: flex; align-items: center; gap: 10px; margin: 7px 0; }
  .prob .nm { width: 110px; font-weight: 600; font-size: 13px; flex: none; }
  .prob .bar { flex: 1; height: 14px; background: var(--panel2); border-radius: 7px;
               overflow: hidden; }
  .prob .bar i { display: block; height: 100%; border-radius: 7px; }
  .prob .pc { width: 44px; text-align: right; font-weight: 600; flex: none; }

  .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; font-size: 12px; }
  .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px;
              margin-right: 5px; vertical-align: -1px; }
  details.howto { margin-top: 10px; }
  details.howto summary { cursor: pointer; color: var(--link); font-size: 13px; }
  details.howto div { background: var(--panel2); border-radius: 8px; padding: 12px 14px;
                      margin-top: 8px; font-size: 13px; line-height: 1.6; }
  ul.compact { margin: 4px 0; padding-left: 18px; } ul.compact li { margin: 3px 0; }
</style>
</head>
<body>
<div class="grid">

  <!-- ======================= HEADER ======================= -->
  <div class="panel span12">
    <div class="topline">
      <h1>Macro Regime Dashboard</h1>
      <span class="badge quad-{{ latest.quad }}">{{ latest.quad_name }}</span>
      <span class="help">?<span class="tip tip-map">
        <b>The four market regimes</b> — combinations of growth and inflation direction.
        (Sometimes written Q1–Q4, but these are <b>quadrants, NOT calendar quarters</b>.)
        <span class="qgrid">
          <span class="qax"></span>
          <span class="qax">inflation falling ↓</span>
          <span class="qax">inflation rising ↑</span>
          <span class="qax">growth<br>rising ↑</span>
          <span class="qcell{{ ' qcur' if latest.quad == 'Q1' }}" style="background:var(--q1)">GOLDILOCKS<br><small>best for tech & quality</small></span>
          <span class="qcell{{ ' qcur' if latest.quad == 'Q2' }}" style="background:var(--q2);color:#1a1a1a">REFLATION<br><small>cyclicals, energy, banks</small></span>
          <span class="qax">growth<br>falling ↓</span>
          <span class="qcell{{ ' qcur' if latest.quad == 'Q4' }}" style="background:var(--q4)">GROWTH SCARE<br><small>defensives & bonds</small></span>
          <span class="qcell{{ ' qcur' if latest.quad == 'Q3' }}" style="background:var(--q3)">STAGFLATION<br><small>the dangerous one</small></span>
        </span>
        The label changes only after 7 straight days of evidence (or one extreme shock day),
        so it doesn't flip-flop. Today's regime is outlined in white.
      </span></span>
      <span class="badge state-{{ latest.transition_state }}">{{ latest.transition_state }}</span>
      <span class="help">?<span class="tip">
        <b>The transition radar</b> — is the current regime ending? It escalates as warning
        signals stack up:
        <span class="lad lad-tint" style="--c:var(--muted)">⚪ <b>STABLE</b> — no warnings. Trust the regime label.</span>
        <span class="lad lad-tint" style="--c:var(--warn)">🟠 <b>WEAKENING</b> — 2+ warnings. Stop adding regime-dependent bets.</span>
        <span class="lad lad-tint" style="--c:var(--orange)">🔶 <b>TRANSITIONING</b> — 3+ warnings. The regime is likely ending before the label flips — reduce risk now.</span>
        <span class="lad lad-tint" style="--c:var(--down)">🚨 <b>NEW REGIME</b> — the label changed within the last week.</span>
        The warnings: thinning participation, nervous credit, risk-ratios turning, inflation
        trades turning, signal disagreement, fragile options positioning.
      </span></span>
      <span class="kv">signal agreement <b>{{ (latest.confidence * 100) | round | int }}%</b></span>
      <span class="help">?<span class="tip">
        <b>Signal agreement</b> — how many of the ~14 underlying indicators point the
        same way. Today: <b>{{ (latest.confidence * 100) | round | int }}%</b>.
        <span class="scale">
          <span style="background:var(--down)">MIXED</span>
          <span style="background:var(--warn)">OK</span>
          <span style="background:var(--up)">SOLID</span>
        </span>
        <span class="sl"><span>0%</span><span>30%</span><span>45%</span><span>100%</span></span>
        <b>Mixed</b>: the indicators disagree — expect chop, size down, trust the radar
        more than the label. <b>OK</b>: usable with caution. <b>Solid</b>: the regime
        call is well-supported.
      </span></span>
      <span class="kv">Fed liquidity <b>{{ latest.liquidity_overlay }}</b></span>
      <span class="help">?<span class="tip">
        <b>Fed liquidity</b> — net money flowing into or out of the financial system
        (Fed balance sheet − reverse-repo parking − the government's checking account),
        measured as a 4-week trend.
        <table>
          <tr><th></th><th>meaning</th><th>history says</th></tr>
          <tr><td>🟢 <b>expanding</b></td><td>money tide rising</td><td>the most reliable tailwind we tested: stocks up ~73% of months</td></tr>
          <tr><td>⚪ <b>neutral</b></td><td>roughly flat</td><td>no signal</td></tr>
          <tr><td>🔴 <b>contracting</b></td><td>money draining</td><td>persistent headwind — be choosier</td></tr>
        </table>
      </span></span>
      <span class="kv">cycle <b>{{ latest.cycle_tag }}</b></span>
      <span class="help">?<span class="tip">
        <b>Business-cycle position</b> — the multi-year backdrop (from the yield curve,
        credit spreads and market breadth). Slower-moving than the regime.
        <table>
          <tr><td>🌱 <b>early</b></td><td>recovering after stress — historically the best risk/reward</td></tr>
          <tr><td>☀️ <b>mid</b></td><td>expansion cruising — normal conditions</td></tr>
          <tr><td>🌇 <b>late</b></td><td>curve inverted/flattening, breadth thinning — enjoy it, but keep one eye on the exit</td></tr>
        </table>
        Context only — it sizes your patience, not your trades.
      </span></span>
      <span style="flex:1"></span>
      <a class="navbtn" href="stock.html">🔎 Any stock</a>
      <a class="navbtn" href="brief.html">📰 Daily brief</a>
      <a class="navbtn" href="history.html">📈 History & charts</a>
      <button class="theme-btn">☀️ Light</button>
    </div>
    <details class="howto">
      <summary>New here? How to read this page in 60 seconds</summary>
      <div>
        <b>1.</b> The colored badge is the market regime — the "weather" (not a calendar quarter!). The second badge is the transition radar — whether that weather is about to change.<br>
        <b>2.</b> <b>Where we are</b> shows how far along this regime likely is. <b>What's likely next</b> gives the historical odds of each path and what to do about it. <b>How to trade it</b> turns today's conditions into a posture and concrete names.<br>
        <b>3.</b> Everything below that is supporting evidence. Hover any <span class="help">?</span> for a plain-English explanation. <span class="pos">Green = risk-friendly</span>, <span class="neg">red = risk-hostile</span>.<br>
        <b>4.</b> This is a context machine with measured odds, not a crystal ball.
      </div>
    </details>
  </div>

  {% if latest.alerts %}
  <div class="panel span12">
    <h2>Fired alerts (today)
      {{ help("Alerts fire only when something CHANGES — a warning level escalating, a crossing, a sign flip — never just because a level is high. They're rare by design; read every one.") }}
    </h2>
    {% for a in latest.alerts %}
      <div class="alert alert-{{ a.severity }}"><b>{{ a.rule }}</b> — {{ a.message }}</div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ======================= ACTION BOARD ======================= -->
  {% if action_board %}
  <div class="panel span12">
    <h2>⚡ What to act on now
      {{ help("Your at-a-glance starting point. Built from each sector's own price cycle (and standout individual stocks): what's a confirmed buy today, what's setting up to buy within a few days, what to take profits on, and what to leave alone. 'Days' are rough trajectory estimates, not promises. Click any name for the full breakdown.") }}
    </h2>
    <div class="actiongrid">
      <div class="actcol act-buy">
        <div class="acth">🟢 BUY ZONE — confirmed now</div>
        {% for x in action_board.buy_now %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ x.name }}</b> <span class="muted">{{ x.ticker }}</span><span class="acttag">{{ x.label }}</span></a>
        {% else %}<p class="muted sm">None today — nothing has fully confirmed a fresh cycle low.</p>{% endfor %}
      </div>
      <div class="actcol act-soon">
        <div class="acth">🔵 SETTING UP — buy soon</div>
        {% for x in action_board.buy_soon %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ x.name }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.days is not none %}<span class="acteta">~{{ x.days }}d</span>{% endif %}</a>
        {% else %}<p class="muted sm">No imminent setups.</p>{% endfor %}
      </div>
      <div class="actcol act-trim">
        <div class="acth">🟠 TAKE PROFITS / topping</div>
        {% for x in action_board.take_profits %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ x.name }}</b> <span class="muted">{{ x.ticker }}</span><span class="acttag">{{ x.label }}</span></a>
        {% else %}<p class="muted sm">Nothing topping.</p>{% endfor %}
      </div>
      <div class="actcol act-hold">
        <div class="acth">⚪ HOLD / avoid</div>
        {% for x in action_board.hold %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ x.name }}</b> <span class="muted">hold — don't chase</span></a>
        {% endfor %}
        {% for x in action_board.avoid %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ x.name }}</b> <span class="muted">{{ "wait" if x.tag == "WAIT" else "avoid" }}</span></a>
        {% endfor %}
      </div>
    </div>
    {% if action_board.notable %}
    <div class="notable">
      <span class="muted" style="font-size:12px">Standout individual stocks (from sector top-10s):</span>
      {% for n in action_board.notable %}
        <a class="chip {{ 'chip-pos' if n.urgency in ('now','imminent') else 'chip-neg' }}" href="stock.html#{{ n.ticker }}">{{ n.ticker }} · {{ n.label }}{% if n.urgency == 'imminent' and n.days %} (~{{ n.days }}d){% endif %}</a>
      {% endfor %}
    </div>
    {% endif %}
    <p class="muted" style="font-size:11.5px; margin-top:8px">⚠ Cycle-timing signals are about <i>where in the price cycle</i> a sector is — most useful combined with the regime read above. Our calibration shows these states don't beat buy-and-hold on average return; their value is structure and risk placement (entry + a defined exit), not certainty.</p>
  </div>
  {% endif %}

  <!-- ======================= NOW ======================= -->
  {% if pb %}
  <div class="panel span6">
    <h2>Where we are in this regime
      {{ help("Compares this regime's age against every " + latest.quad_name + " period since 2007 in this exact classifier. Regimes don't die of old age — but the older one gets relative to history, the more weight every warning flag deserves.") }}
    </h2>
    <p style="font-size:14.5px; margin: 2px 0 6px"><b>{{ pb.headline.split('. Posture')[0] }}.</b></p>
    {% if pb.progress %}
    <div class="lifebar">
      <div class="zone" style="left:0; width:{{ pb.progress.zone_early_pct }}%; background:color-mix(in srgb, var(--up) 35%, var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_early_pct }}%; width:{{ pb.progress.zone_mid_pct - pb.progress.zone_early_pct }}%; background:color-mix(in srgb, var(--warn) 35%, var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_mid_pct }}%; width:{{ 100 - pb.progress.zone_mid_pct }}%; background:color-mix(in srgb, var(--down) 35%, var(--panel))"></div>
      <div class="marker" style="left:{{ pb.progress.bar_pct }}%"></div>
    </div>
    <div class="lifelabels"><span>young</span><span>mid-life</span><span>old</span></div>
    <p style="margin:10px 0 4px"><b>{{ pb.progress.phase | upper }}</b> — {{ pb.progress.phase_note }}.</p>
    <p class="muted" style="margin:4px 0">
      {{ pb.progress.age_days }} trading days in, vs a median of {{ pb.progress.median_days }}
      across {{ pb.progress.n_history }} past {{ latest.quad_name }} periods.
      {{ pb.progress.pct_longer | round | int }}% of them lasted longer than this one has so far{% if pb.progress.median_remaining_days %} —
      and those that did typically ran another ~{{ pb.progress.median_remaining_days }} trading days
      (≈{{ (pb.progress.median_remaining_days / 5) | round(1) }} weeks){% endif %}.
      {{ help("Historical base rates from this classifier's own 2007-present history — odds and typical paths, not predictions. A young regime + STABLE radar = let winners run. An old regime + warnings = the odds of a shift compound.") }}
    </p>
    {% else %}
    <p class="muted">Not enough regime history for lifespan statistics yet.</p>
    {% endif %}
  </div>

  <!-- ======================= NEXT ======================= -->
  <div class="panel span6">
    <h2>What's likely next — and how to trade it
      {{ help("Simple historical frequencies: across every " + latest.quad_name + " period since 2007, which regime came next. These are base rates, not forecasts — but they tell you which playbook to keep warm. The watch names below are NOT buys yet; the evidence says anticipating rotations loses money — wait for the trend to confirm.") }}
    </h2>
    {% for n in pb.next_list %}
    <div class="prob">
      <span class="nm">{{ n.name }}</span>
      <span class="bar"><i style="width:{{ n.prob_pct }}%; background: var(--q{{ n.code[1] }})"></i></span>
      <span class="pc">{{ n.prob_pct }}%</span>
    </div>
    {% endfor %}
    {% if pb.watchlist %}
      <h3>Accumulation watchlist for that shift</h3>
      {% for x in pb.watchlist %}
        <div class="card"><span class="calltag tag-watch">WATCH — DON'T BUY YET</span>
          <b class="tk">{{ x.ticker }}</b> · {{ x.name }}<br>
          <span class="muted">{{ x.why }}</span></div>
      {% endfor %}
    {% endif %}
    <h3>The signals that would announce the shift</h3>
    <ul class="compact muted">
      {% for t in pb.triggers %}<li>{{ t }}</li>{% endfor %}
    </ul>
  </div>

  <!-- ======================= TRADE IT ======================= -->
  <div class="panel span12">
    <h2>How to trade the current regime
      {{ help("Built from conditions that held up in both halves of a 2007-2026 backtest. The dial is the headline: how much risk current conditions support. Sector calls below it are risk filters and confirmation tools — our research found no stable 'this sector will outperform' signal at monthly horizons, so anyone selling you that is curve-fitting.") }}
    </h2>
    <div class="dial">
      {% for p in ["DEFENSIVE","CAREFUL","NEUTRAL","CONSTRUCTIVE","AGGRESSIVE"] %}
        <span class="{{ 'active-' + p if pb.dial.posture == p }}">{{ p }}</span>
      {% endfor %}
    </div>
    {% for sign, r in pb.dial.reasons %}
      <div class="reason"><b class="sig sig-{{ {'+':'p','-':'m','i':'i'}[sign] }}">{{ {'+':'+','-':'−','i':'i'}[sign] }}</b> {{ r }}</div>
    {% endfor %}

    <div class="grid" style="margin-top:12px">
      <div class="span6">
        <h3>✅ Confirmed leadership — where participation is real
          {{ help("Sectors in an established uptrend vs the market with momentum still positive and not yet stretched. Descriptive — where the market's money already is. Use it to place exposure you already intend to take.") }}
        </h3>
        {% for x in pb.leaders %}
          <div class="card"><span class="calltag tag-lead">LEADER</span>
            <b class="tk">{{ x.ticker }}</b> · {{ x.name }}<br>
            <span class="muted">{{ x.why }}</span></div>
        {% else %}
          <p class="muted">No sector currently qualifies — leadership is either stretched or unconfirmed. That itself is information: stay close to the index.</p>
        {% endfor %}
        {% if pb.momentum_tilt.tickers %}
          <p class="muted" style="font-size:12px">Longer-horizon tilt: <b>
            {%- for t in pb.momentum_tilt.tickers %}{{ t.ticker }}{{ ", " if not loop.last }}{% endfor -%}
          </b> {{ help(pb.momentum_tilt.note) }}</p>
        {% endif %}
      </div>
      <div class="span6">
        <h3>🚫 Avoid right now — the evidence-backed don'ts
          {{ help("The strongest findings in our sector backtest were about what NOT to do: chasing stretched leaders lost 55% of the time; buying below-trend bounces lost in every variant tested. These warnings carry more statistical weight than any buy signal on this page.") }}
        </h3>
        {% for x in pb.avoid %}
          <div class="card"><span class="calltag tag-avoid">{{ x.call }}</span>
            <b class="tk">{{ x.ticker }}</b> · {{ x.name }}<br>
            <span class="muted">{{ x.why }}</span></div>
        {% else %}
          <p class="muted">Nothing currently triggers the avoid rules.</p>
        {% endfor %}
      </div>
    </div>
    <p class="muted" style="font-size:12px; margin-top:8px">⚖️ {{ pb.honesty }}</p>
  </div>
  {% endif %}

  <!-- ======================= SIGNALS ======================= -->
  <div class="panel span6">
    <h2>The two dials behind the regime
      {{ help("The regime label comes from two scores between -1 and +1, built from market prices (which lead) plus a small weight on economic data (which confirms). Growth above zero + inflation below zero = Goldilocks, and so on. The white marker is today.") }}
    </h2>
    <p style="margin:8px 0 0"><b>Growth: {{ "RISING" if latest.growth_score >= 0 else "FALLING" }}</b>
      <span class="muted">({{ "%+.2f" | format(latest.growth_score) }} of ±1 · agreement {{ (latest.growth_confidence * 100) | round | int }}%)</span>
      {{ help("Is the economy's growth impulse improving or deteriorating, as priced by markets: copper vs gold, consumer discretionary vs staples, small vs large caps, cyclical vs defensive sectors, the 2-year yield, breadth — confirmed slowly by payrolls and industrial production.") }}
    </p>
    <div class="gauge"><i style="left: {{ ((latest.growth_score + 1) / 2 * 100) | round(1) }}%"></i></div>
    <p style="margin:10px 0 0"><b>Inflation pressure: {{ "RISING" if latest.inflation_score >= 0 else "FALLING" }}</b>
      <span class="muted">({{ "%+.2f" | format(latest.inflation_score) }} of ±1 · agreement {{ (latest.inflation_confidence * 100) | round | int }}%)</span>
      {{ help("Is inflation pressure building or cooling, as priced by markets: bond-market inflation expectations, oil, energy-sector strength, and inflation-winner vs inflation-loser sector baskets.") }}
    </p>
    <div class="gauge"><i style="left: {{ ((latest.inflation_score + 1) / 2 * 100) | round(1) }}%"></i></div>

    <h3>What's voting for this regime
      {{ help("Each chip is one indicator inside the two dials. Green chips point WITH the regime call; red chips point AGAINST it. Lots of red = shaky ground (and lower 'signal agreement').") }}
    </h3>
    <div>
      {% for c in components_confirming %}<span class="chip chip-pos">{{ c }}</span>{% endfor %}
      {% for c in components_contradicting %}<span class="chip chip-neg">{{ c }}</span>{% endfor %}
      {% if not components_confirming and not components_contradicting %}<span class="muted">all quiet</span>{% endif %}
    </div>

    <h3>Weakest link
      {{ help("Of everything currently supporting the regime call, this indicator is closest to flipping sides — the single thing most likely to change the picture.") }}
    </h3>
    <p class="muted">{{ flip_plain }}</p>

    {% if latest.preference_check %}
    <h3>Does the market agree with the regime?
      {{ help("The regime implies certain sectors should lead. This checks whether they actually ARE. Agreement strengthens the call; disagreement is an early warning — when the tape stops cooperating with the story, the story is often about to change.") }}
    </h3>
    <p class="muted">{{ latest.preference_check.note }}
      {% if latest.preference_check.actual_ranks %}
        ({% for t, r in latest.preference_check.actual_ranks.items() %}{{ t }} is #{{ r }}{{ ", " if not loop.last }}{% endfor %} of {{ latest.sector_rs | length }})
      {% endif %}
    </p>
    {% endif %}
  </div>

  <!-- ======================= INTERNALS ======================= -->
  <div class="panel span6">
    <h2>Market internals — risk appetite gauges
      {{ help("Simple ratios between two assets; each answers a question about investor mood. Direction over the last 20 days matters more than the level. Green = moved in the risk-friendly direction.") }}
    </h2>
    <table>
      <tr><th class="l">gauge</th><th>past month</th><th class="l">what it's saying</th></tr>
      {% for r in internals %}
      <tr>
        <td class="l">{{ r.label }} {{ help(r.tip) }}</td>
        <td class="{{ 'pos' if r.good else 'neg' }}">{{ "%+.2f" | format(r.chg) }}%</td>
        <td class="l muted">{{ r.verdict }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <!-- ======================= SECTOR HEAT BOARD ======================= -->
  <div class="panel span12">
    <h2>Sector heat board — regime × tape × technicals × seasonality
      {{ help("One row per sector, everything that matters in one place. HEAT (0-100) measures how CONFIRMED a sector's strength is right now: regime fit + rotation stage + technicals, minus crowding. Important: heat describes the present, not the future — our 2007-2026 backtest shows the hottest band (70+) actually UNDERPERFORMED over the following months (everything-confirmed usually means late). So: high heat = hold/trim territory, never a fresh-entry signal; the buy workflow is the watchlist + trigger column.") }}
    </h2>
    <table>
      <tr>
        <th class="l">sector</th>
        <th class="l" style="min-width:130px">heat <span class="help">?<span class="tip">
          <b>Heat</b> = how CONFIRMED a sector's strength is (regime fit + trend stage +
          technicals − crowding). Hover each bar for its exact arithmetic.
          <table>
            <tr><th>band</th><th>read it as</th><th>measured 3-month record*</th></tr>
            <tr><td style="color:var(--orange)"><b>70+ OVERHEATED</b></td><td>late — hold/trim, don't start</td><td>beat market 47% (−0.6% avg)</td></tr>
            <tr><td style="color:var(--up)"><b>55-69 HOT</b></td><td>confirmed — hold, buy pullbacks</td><td>49% (−0.3%)</td></tr>
            <tr><td><b>40-54 NEUTRAL</b></td><td>mixed, no lean</td><td>49% (−0.1%)</td></tr>
            <tr><td style="color:var(--info)"><b>0-39 COLD</b></td><td>washed out — wait for trigger</td><td>50% (+0.2%)</td></tr>
          </table>
          *vs the index, every week 2007-2026. Note the inversion: hot sectors were
          usually LATE. That measured record is the trust level — and it argues
          against chasing.
        </span></span></th>
        <th>stage <span class="help">?<span class="tip">
          <b>The rotation cycle</b> — every sector travels this loop vs the market:
          <span class="lad lad-tint" style="--c:var(--info)">1. IMPROVING — momentum turns up, trend not yet confirmed. <b>Too early</b>: buying here lost money historically.</span>
          <span class="lad lad-tint" style="--c:var(--up)">2. LEADING — confirmed uptrend. The healthy zone.</span>
          <span class="lad lad-tint" style="--c:var(--warn)">3. WEAKENING — still above trend but losing steam. Tighten stops.</span>
          <span class="lad lad-tint" style="--c:var(--down)">4. LAGGING — downtrend. Avoid until it improves again.</span>
        </span></span></th>
        <th>3mo vs market {{ help("How much it beat or trailed the S&P 500 over the past 60 trading days — the medium-term relative trend the playbook keys off.") }}</th>
        <th>technicals <span class="help">?<span class="tip">
          <b>RSI(14)</b> — a 0-100 momentum thermometer:
          <span class="scale">
            <span style="background:var(--g-cold)">OVERSOLD</span>
            <span style="background:var(--muted)">SOFT</span>
            <span style="background:var(--up)">HEALTHY</span>
            <span style="background:var(--down)">HOT</span>
          </span>
          <span class="sl"><span>0</span><span>30</span><span>45</span><span>70</span><span>100</span></span>
          <b>✓/✗ 200d and 50d</b>: whether price is above its 200-day (long-term) and
          50-day (medium-term) average — the most basic "is it in an uptrend" filters.
          Green row = both ✓.
        </span></span></th>
        <th>{{ month_name }} tendency {{ help("This instrument's average return in this calendar month across its whole history, and how often the month was positive. Weak evidence by nature — context, never a signal on its own (and deliberately excluded from the heat score).") }}</th>
        <th>to trigger {{ help("For sectors below their long-term relative trend: how much more outperformance vs SPY is needed for the trend to cross (= the data-backed buy confirmation), and how far along it already is from its recent low. Small gap + high progress = watch closely.") }}</th>
        <th>cycle timing {{ help("From the sector's own price cycle (click the sector name for the full drill-down): where it sits in its ~36-42 trading-day cycle and how many of its top-10 holdings are in a buy setup (BOTTOMING or BUY ZONE). The per-state historical base rates live on the drill-down page.") }}</th>
      </tr>
      {% for r in sector_rows %}
      <tr>
        <td class="l"><a href="sectors/{{ r.ticker }}.html"><b>{{ r.ticker }}</b></a> <span class="muted">{{ r.name }}</span></td>
        <td class="l">
          <span class="help" style="width:auto;height:auto;border:none;margin:0;border-radius:6px">
            <span style="display:inline-flex;align-items:center;gap:7px;cursor:help">
              <span style="display:inline-block;width:64px;height:9px;background:var(--panel2);border-radius:5px;overflow:hidden"><i style="display:block;height:100%;width:{{ r.heat }}%;background:{{ r.heat_color }}"></i></span>
              <b>{{ r.heat }}</b>
              <span class="muted" style="font-size:11px">{{ r.heat_label }}</span>
            </span>
            <span class="tip">{{ r.heat_tip }}</span>
          </span>
        </td>
        <td><span class="pill stg-{{ r.stage }}">{{ r.stage }}</span></td>
        <td class="{{ 'pos' if r.mom_60d_pct > 0 else 'neg' }}">{{ "%+.1f" | format(r.mom_60d_pct) }}%</td>
        <td class="{{ 'pos' if r.tech_ok else '' }}" style="font-size:12px">{{ r.tech_str }}</td>
        <td>
          <span class="help" style="width:auto;height:auto;border:none;margin:0">
            <span style="cursor:help">{{ r.season_str }}</span>
            <span class="tip">{{ r.season_tip }}</span>
          </span>
        </td>
        <td>{{ r.trigger_str }}</td>
        <td>
          {% if r.timing_state %}
            <span class="pill st-{{ r.timing_state | replace(' ', '_') }}">{{ r.timing_label }}</span>
            <div class="muted" style="font-size:11px">{{ r.timing_note }}</div>
          {% else %}—{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted" style="font-size:12px">Click any sector for its full drill-down: cycle position, multi-timeframe momentum, and each top-10 holding analyzed individually.</p>
  </div>

  <div class="panel span6">
    <h2>Commodities & macro tape
      {{ help("The non-equity instruments the regime engine watches, with their technicals and seasonal tendency. No heat score here — regime alignment and rotation stages are equity-sector concepts.") }}
    </h2>
    <table>
      <tr><th class="l">instrument</th><th>trend</th><th>RSI</th><th>off 52w high</th><th>3mo</th><th>{{ "seasonal" }}</th></tr>
      {% for c in commodities %}
      <tr>
        <td class="l"><b>{{ c.name }}</b></td>
        <td>{{ "✓" if c.above200 else "✗" }}200d {{ "✓" if c.above50 else "✗" }}50d</td>
        <td>{{ c.rsi14 | round | int if c.rsi14 is not none else "—" }}</td>
        <td class="{{ 'neg' if c.off_52w_high_pct < -10 else '' }}">{{ "%+.1f" | format(c.off_52w_high_pct) }}%</td>
        <td class="{{ 'pos' if c.mom_60d_pct > 0 else 'neg' }}">{{ "%+.1f" | format(c.mom_60d_pct) }}%</td>
        <td>
          <span class="help" style="width:auto;height:auto;border:none;margin:0">
            <span style="cursor:help">{{ (c.season_this or "—").split(":")[1].split("avg")[0].strip() if c.season_this else "—" }}</span>
            <span class="tip">{{ c.season_this or "Not enough history." }}</span>
          </span>
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <div class="panel span6">
    <h2>Fed liquidity — the money tide
      {{ help("Top: net money in the system (Fed balance sheet minus reverse-repo minus the Treasury's account), in billions. Bottom: its 4-week change — the impulse. Green above the dotted line = expanding (historically the most reliable tailwind); red below = contracting.") }}
    </h2>
    <div class="chart">{{ chart_liquidity | safe }}</div>
  </div>

  <div class="panel span6">
    <h2>Credit stress & market breadth
      {{ help("Top: the extra yield junk-bond investors demand — the market's best early smoke detector; rising = stress building; below ~4% is calm. Bottom: % of S&P 500 stocks above their 50-day average — participation. Strong indexes with collapsing breadth are fragile.") }}
    </h2>
    <div class="chart">{{ chart_credit_breadth | safe }}</div>
  </div>

  <!-- ======================= POSITIONING ======================= -->
  <div class="panel span6">
    <h2>Who's positioned how — the crowd meter
      {{ help("What different investor groups are currently doing, shown as a position on each dial. The middle is normal; the ENDS are the danger zones — when a marker sits at either extreme, that trade is crowded and prone to violent reversal. Hover each name for the underlying numbers.") }}
    </h2>
    <table>
      <tr><th class="l">who / what</th><th class="l" style="min-width:150px">where they stand</th><th class="l">what it means</th></tr>
      {% for p in positioning %}
      <tr>
        <td class="l">{{ p.name }} {{ help(p.tip) }}</td>
        <td class="l">
          {% if p.pct is not none %}
            <div class="pgauge"><i style="left: {{ p.pct | round(1) }}%"></i></div>
            <div class="pends"><span>{{ p.left }}</span><span>{{ p.right }}</span></div>
          {% else %}
            <span class="plabel {{ 'plabel-hot' if 'amplif' in p.label or 'hedg' in p.label or 'complacent' in p.label else 'plabel-norm' }}">{{ p.label }}</span>
          {% endif %}
        </td>
        <td class="l muted">
          {% if p.pct is not none %}<b style="color:var(--text)">{{ p.label }}</b>{% if p.verdict %} — {{ p.verdict }}{% endif %}
          {% else %}{{ p.verdict }}{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <!-- ======================= HOLDINGS / FLOWS ======================= -->
  <div class="panel span12">
    <h2>Star fund managers' real moves
      {{ help("Daily holdings of the watchlist funds (ARK etc.) with mechanical flow effects stripped out — what's left is genuine manager conviction, visible the day after they trade.") }}
    </h2>
    {% if holdings_changes %}
      <table>
        <tr><th class="l">fund</th><th class="l">position</th><th>active chg</th><th>window</th></tr>
        {% for h in holdings_changes %}
        <tr><td class="l">{{ h.fund }}</td><td class="l">{{ h.position }}</td>
            <td class="{{ 'pos' if h.pct > 0 else 'neg' }}">{{ "%+.1f" | format(h.pct) }}%</td>
            <td class="muted">{{ h.window }}</td></tr>
        {% endfor %}
      </table>
    {% else %}
      <p class="muted">No significant manager moves in the current window (needs a few trading days of snapshots).</p>
    {% endif %}

    <h2 style="margin-top:16px">Where ETF money is flowing
      {{ help("Daily money in/out of each sector's main ETF, from share creations/redemptions (ΔShares × price). Positive = money entering. History builds from June 2026.") }}
    </h2>
    {% if flows_html %}
      {{ flows_html | safe }}
    {% else %}
      <p class="muted">Collecting — needs at least two daily snapshots per fund.</p>
    {% endif %}
  </div>

  <!-- ======================= HEALTH ======================= -->
  <div class="panel span12">
    <h2>Data health
      {{ help("Every data source this dashboard depends on. OK = fresh. STALE = no new data lately (signal confidence reduced automatically). FAILED = today's fetch broke (yesterday's data still used). BLOCKED = a known, documented limitation — not a malfunction. DEAD = failed 3+ runs and paused until it recovers.") }}
    </h2>
    <table>
      <tr><th class="l">source</th><th class="l">status</th><th>rows</th><th>last data</th><th class="l">note</th></tr>
      {% for s in health %}
      <tr>
        <td class="l">{{ s.name }}</td>
        <td class="l"><span class="pill pill-{{ s.status }}">{{ s.status }}</span></td>
        <td>{{ s.rows }}</td><td>{{ s.last_date or "—" }}</td>
        <td class="l muted">{{ s.error or "" }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted">A failed source never crashes the dashboard — affected signals just lose confidence until it heals.
       Generated {{ generated_utc }} UTC · <a href="brief.html">daily brief</a> ·
       <a href="history.html">history & charts</a> · <a href="validation_timeline.html">full 2007→ backtest</a></p>
  </div>

</div>
<script>
  // keep tooltips on-screen: open downward near the top, and anchor to the
  // nearest side when close to the left/right viewport edges
  document.addEventListener('mouseover', function (e) {
    var h = e.target.closest('.help');
    if (!h) return;
    var r = h.getBoundingClientRect();
    h.classList.toggle('below', r.top < 330);
    var tip = h.querySelector('.tip');
    var half = ((tip && tip.offsetWidth) || 290) / 2 + 16;
    h.classList.remove('edge-right', 'edge-left');
    if (r.left + r.width / 2 + half > window.innerWidth) h.classList.add('edge-right');
    else if (r.left + r.width / 2 - half < 0) h.classList.add('edge-left');
  });
</script>
<script src="theme.js"></script>
</body>
</html>
