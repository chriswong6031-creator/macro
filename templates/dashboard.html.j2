/* v-meter hide (replaced by mx2-prog-track) */
body.page-macro .mx2-score-block .v-meter{display:none}
body.page-macro .mx2-score-block .v-scale{display:none}
body.page-macro .mx2-score-block .v-label{display:none}

/* Hero context card */
