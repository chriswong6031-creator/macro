    .sbx-stamp .sbx-dot{width:6px;height:6px;border-radius:50%;background:var(--muted);display:inline-block}
    .sbx-stamp.live .sbx-dot{background:var(--warn)}
    .sbx-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch}
    @media(max-width:900px){.sbx-grid{grid-template-columns:1fr}}
    .sbx-bar-card{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:14px 16px 12px;display:flex;flex-direction:column;cursor:pointer;min-width:0}
