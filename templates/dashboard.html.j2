    {# fired-alerts popup now lives inline in the header (.ms-alerts-wrap above);
       the old right slide-out drawer was retired. This script only handles the
       touch tap-toggle path: close on a jump-link, on Esc, or on a click outside. #}
    <script>
    (function(){
      var cb=document.getElementById('ms-alerts-toggle');
      if(!cb) return;
      document.addEventListener('click',function(e){
        if(e.target.closest('[data-ms-jump]')){ cb.checked=false; return; }
        var wrap=e.target.closest('.ms-alerts-wrap');
        if(cb.checked && !wrap) cb.checked=false;   // tap outside closes the pinned popup
      });
      document.addEventListener('keydown',function(e){
        if(e.key==='Escape'&&cb.checked) cb.checked=false;
      });
    })();
    </script>
  </div>


  {# --- Base-effect forward-regime strip (v0): the forward ECONOMIC quad the KNOWN base is
        forcing over the next 3 quarters. DISPLAY-ONLY / MODELED — engine/base_effect.py.
        Hidden until a render writes latest.base_effect (guarded, degrade-never-raise). --- #}
  {% if latest.base_effect and latest.base_effect.growth and latest.base_effect.inflation %}
  {% set _be = latest.base_effect %}
  {% set _bg = _be.growth %}
  {% set _bi = _be.inflation %}
  {% set _QN = {'Q1':['GOLDILOCKS','理想增长'],'Q2':['REFLATION','再通胀'],'Q3':['STAGFLATION','滞胀'],'Q4':['GROWTH SCARE','增长恐慌']} %}
  {% macro _iq(g, i) %}{% if g >= 0 and i < 0 %}Q1{% elif g >= 0 and i >= 0 %}Q2{% elif g < 0 and i >= 0 %}Q3{% else %}Q4{% endif %}{% endmacro %}
  {% macro _accel(s) %}{% if s > 0 %}▲ {{ t('accelerating','加速') }}{% elif s < 0 %}▼ {{ t('decelerating','减速') }}{% else %}– {{ t('flat','走平') }}{% endif %}{% endmacro %}
  {% macro _axnote(a) %}{% set c = a.q1 %}{{ t('easy comps' if c > 0 else ('tough comps' if c < 0 else 'neutral comps'), '低基数' if c > 0 else ('高基数' if c < 0 else '中性基数')) }}{% if a.current_yoy is not none and a.yoy_path and a.yoy_path[-1] is not none %} · {{ t('YoY','同比') }} {{ '%.1f'|format(a.current_yoy) }}%→{{ '%.1f'|format(a.yoy_path[-1]) }}% {{ t('3q','3季') }}{% endif %}{% endmacro %}
  {% set _q1q = _iq(_bg.q1, _bi.q1)|trim %}
  <div class="panel span12 bfwd">
    <div class="bfwd-head">
      <h3>{{ t('Where the regime is headed','周期将去往何处') }} · {{ t('base-effect forward path','基数效应前瞻路径') }}</h3>
      <span class="mbadge modeled">{{ t('MODELED','模型推算') }}</span>
      {{ help("The Hedgeye kernel, built honestly. A year-over-year rate has a denominator — the 'base' — already known 12 months ahead. Holding month-to-month momentum at its normal pace, the KNOWN base bends the forward path of the rate: a HIGH base a year ago (tough comps) forces the rate DOWN (deceleration); a LOW base (easy comps) forces it UP (acceleration). This reads the ECONOMY's forward direction for growth (industrial production + payrolls) and inflation (core CPI + core PCE) — distinct from, and more forward-looking than, the current-tape quad above. MODELED: a projection under a normal-momentum assumption, not measured data. The base arithmetic is settled, but the accelerate/decelerate call is unvalidated and display-only while it accrues a forward-grading record versus the disclosed base-effect inversion statistic.",
               "以诚实方式构建的 Hedgeye 内核。同比增速有一个分母 —— “基数” —— 在 12 个月前就已知。将环比动能保持在正常速度时，已知的基数会弯折增速的前瞻路径：一年前的高基数（高对比基准）迫使增速下行（减速）；低基数（低对比基准）迫使其上行（加速）。这里读取的是经济的前瞻方向 —— 增长（工业产出＋非农就业）与通胀（核心 CPI＋核心 PCE）—— 有别于上方的当前盘面象限，且更具前瞻性。模型推算：基于正常动能假设的投影，而非实测数据。基数算术已确定，但加速／减速的判断尚未验证、仅作展示，同时针对已披露的基数效应反转统计积累前瞻评分记录。") }}
    </div>
    <p class="bfwd-sub">{{ t('The growth × inflation quad the KNOWN base is forcing over the next three quarters — a forward ECONOMIC read, not today’s tape. The current-tape quad is above; this is where the settled base path is pushing growth and inflation next.','已知基数在未来三个季度所迫使的增长×通胀象限 —— 前瞻的经济读数，而非今日盘面。上方为当前盘面象限；此处为已确定的基数路径接下来对增长与通胀的推动方向。') }}</p>
    <div class="bfwd-main">
      <div class="bfwd-now q-{{ _q1q }}" style="background:var(--q{{ _q1q[1] }})">
        <span class="k">{{ t('NEXT QUARTER','下一季度') }}</span>
        <span class="v">{{ t(_QN[_q1q][0], _QN[_q1q][1]) }}</span>
        <span class="s">{{ t('base-forced','基数迫使') }}</span>
      </div>
      <div class="bfwd-axes">
        <span class="bfwd-ax-l">{{ t('Growth','增长') }}</span>
        <span class="bfwd-ax-v">{{ '%.1f'|format(_bg.current_yoy) }}%<span class="bfa">{{ _accel(_bg.q1) }}</span></span>
        <span class="bfwd-ax-n">{{ _axnote(_bg) }}</span>
        <span class="bfwd-ax-l">{{ t('Inflation','通胀') }}</span>
        <span class="bfwd-ax-v">{{ '%.1f'|format(_bi.current_yoy) }}%<span class="bfa">{{ _accel(_bi.q1) }}</span></span>
        <span class="bfwd-ax-n">{{ _axnote(_bi) }}</span>
      </div>
    </div>
    <div class="bfwd-path">
      <span class="pl">{{ t('3-quarter path','三季度路径') }}</span>
      {% for _h in ['q1','q2','q3'] %}
        {% set _qq = _iq(_bg[_h], _bi[_h])|trim %}
        {% if not loop.first %}<span class="arw">→</span>{% endif %}
        <span class="bfq q-{{ _qq }}" style="background:var(--q{{ _qq[1] }})">+{{ loop.index }}Q <small>{{ t(_QN[_qq][0], _QN[_qq][1]) }}</small></span>
      {% endfor %}
    </div>
    <p class="bfwd-note">{{ t('MODELED — a projection under a normal-momentum assumption. The base (denominator) path is settled arithmetic (MEASURED); the accelerate/decelerate call is unvalidated and display-only, accruing a forward-grading log against the disclosed base-effect inversion statistic. Growth is point-in-time back to 1997; inflation uses latest-revision data until the core-CPI/PCE vintages backfill.',
         '模型推算 —— 基于正常动能假设的投影。基数（分母）路径为已确定的算术（实测）；加速／减速判断尚未验证、仅作展示，正针对已披露的基数效应反转统计积累前瞻评分记录。增长为 1997 年以来的时点数据；通胀在核心 CPI／PCE 修订版历史回填前使用最新修订数据。') }}</p>
  </div>
  {% endif %}

  <!-- Heads-up strip — compact live flags (next catalyst / Fed stance / fragility).
       Replaces the old full-width Event-Risk + Turning-Point + Fed-reaction panels.
       The Vol-shock panel is retired — the Risk Radar override already carries stress. -->
  {% set _hu_show = (event_risk and event_risk.show) or (latest.turning_point and latest.turning_point.present) or (latest.fed_stance and latest.fed_stance.stance and latest.fed_stance.stance != 'unknown') %}
  {% if _hu_show %}
  <div class="panel span12 heads-up">
    <span class="hu-label">{{ t('Heads-up','提醒') }}</span>
    {% if event_risk and event_risk.show %}
    {% set ER = event_risk %}
    {% set erc = 'var(--down)' if ER.fragility.fragile else ('var(--orange)' if ER.vol_tier=='high' else 'var(--warn)') %}
    <span class="hu-chip" id="event-risk" style="--hc:{{ erc }}">{{ t(ER.headline_en, ER.headline_zh) }}{{ help('A heads-up that a big scheduled event is near — not a buy/sell signal and not a direction call. These days swing both ways, so size positions and set stops for the noise.', '提醒重大日程事件临近 — 既非买卖信号也非方向判断。这类日子常两面波动，请据噪声调整仓位与止损。') }}</span>
    {% endif %}
    {% if latest.fed_stance and latest.fed_stance.stance and latest.fed_stance.stance != 'unknown' %}
    {% set FS = latest.fed_stance %}
    {% set fsc = 'var(--down)' if FS.color=='down' else ('var(--up)' if FS.color=='up' else 'var(--muted)') %}
    <a class="hu-chip" id="fed-stance" href="policy_watch.html" style="--hc:{{ fsc }}">{{ t('Fed','美联储') }}: <b style="color:{{ fsc }}">{{ t(FS.label_en, FS.label_zh) }}</b>{{ help('The Fed’s likely next move, read from rate-market pricing plus the latest FOMC guidance. Context only — a market price reacts, it doesn’t forecast. Tap to open Fed &amp; Policy Watch.', '美联储下一步的可能动向，依据利率市场定价与最新 FOMC 指引读出。仅供参考——市场价格是反应而非预测。点击打开美联储与政策观察。') }}</a>
    {% endif %}
    {% if latest.turning_point and latest.turning_point.present %}
    {% set TP = latest.turning_point %}
    {% set tpc = 'var(--down)' if TP.state=='fragile-structural' else ('var(--muted)' if TP.state=='cooling' else 'var(--orange)') %}
    <span class="hu-chip" id="turning-point" style="--hc:{{ tpc }}">{{ t(TP.headline_en, TP.headline_zh) }}{{ help('A conviction guardrail, not a signal. It flags when the whole market is leaning on one bet and positioning is stretched — the setup that whipsaws on a surprise. It lowers conviction; it never tells you to bet against the move.', '确信度护栏，并非信号。当整个市场押注单一主题且仓位被拉伸时触发——这是意外消息下易剧烈反复的格局。它降低确信度，绝不提示反向押注。') }}</span>
    {% endif %}
  </div>
  {% endif %}


