    {% set _abCh = _abSyn.get('dominant_channel','') %}
    {% set _abTheme = _abSyn.get('dominant_theme','') %}
    {% set _abHiCnt = _abSyn.get('high_impact_count') %}
    {# v5 face — AI BRIEF (ticker pills + structured bilingual lines + required not-a-signal note) #}
    {% set _abDomCh_clean = _aibf_ch.get(_abCh, _abCh | replace('_',' ')) if _abCh else '' %}
    {% set _abDomCh_clean_zh = _aibf_ch_zh.get(_abCh, _abCh) if _abCh else '' %}
    <div class="sxg-face mx5-card-face" role="button" tabindex="0" aria-haspopup="dialog" onclick="mx5OpenDlg('dlg-aibrief')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();mx5OpenDlg('dlg-aibrief');}">
      <div class="mx5-card-title"><span class="l-en">AI Brief</span><span class="l-zh">AI简报</span></div>
