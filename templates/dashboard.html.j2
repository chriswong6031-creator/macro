              {% if market_state.color == 'green' %}
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
              <polyline points="16 7 22 7 22 13"/>
              {% elif market_state.color == 'yellow' %}
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
              {% else %}
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
              {% endif %}
            </svg>
          </div>
          <div class="mx5-action-text">
            {# Row 1 is ALWAYS the ratified action vocab keyed to the verdict color
               (the radar driver note is row 4 — it must not usurp the action line) #}
            <div class="mx5-action-label">
              <span class="l-en">{{ MS.label_en }} &mdash; {{ {'green':'Trend-follow, add on strength.','yellow':'Trade with caution. Size small.','red':'Defend capital first. Reduce risk.'}.get(MS.color,'') }}</span>
              <span class="l-zh">{{ MS.label_zh or MS.label_en }} &mdash; {{ {'green':'顺势而为，强势中加仓。','yellow':'谨慎操作，仓位缩小。','red':'优先保住本金，降低风险。'}.get(MS.color,'') }}</span>
            </div>
            <div class="mx5-action-sub">
              {# When the Risk Radar ceiling bites (score < raw_score), say so — otherwise
                 "N of N signals aligned" beside a capped score reads as a contradiction.
                 No digits in the note: risk_state_live.js live-patches \d+(?=/100) only. #}
              {% set _ev_capped = MS.raw_score is defined and MS.raw_score is not none and MS.raw_score > MS.score %}
              <span class="l-en">Composite {{ MS.score }}/100{% if _ev_total %} &middot; {{ _ev_n_good }} of {{ _ev_total }} signals aligned{% endif %}{% if _ev_capped %} &middot; capped by the Risk Radar{% endif %}</span>
              <span class="l-zh">综合评分 {{ MS.score }}/100{% if _ev_total %} &middot; {{ _ev_n_good }}/{{ _ev_total }} 项信号一致{% endif %}{% if _ev_capped %} &middot; 风险雷达封顶{% endif %}</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# Row 2: weakest leg watch (from MS2.components — v4 derivation, keep verbatim) #}
        {% if _weakest %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon mx5-ai-yellow">
            <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <div class="mx5-action-text">
            <div class="mx5-action-label">
              <span class="l-en">Watch {{ _weakest.label_en }} &mdash; the weakest leg ({{ _weakest.score }}/100).</span>
              <span class="l-zh">关注{{ _weakest.label_zh or _weakest.label_en }} &mdash; 最弱分项（{{ _weakest.score }}/100）。</span>
            </div>
            <div class="mx5-action-sub">
              <span class="l-en">Flip trigger if this rolls further</span>
              <span class="l-zh">若继续下滑则触发翻转</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# Row 3: nearest high-impact event — calendar context (v4 derivation: macro_catalysts) #}
        {% if macro_catalysts %}
        {% set _wtd_ev = macro_catalysts | selectattr('impact','equalto','high') | list | first if (macro_catalysts | selectattr('impact','equalto','high') | list) else macro_catalysts[0] %}
        {% set _wtd_ev_zh = _wtd_ev.get('label_zh') or _wtd_ev.label %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon mx5-ai-blue">
            <svg viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" stroke-linecap="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div class="mx5-action-text">
            <div class="mx5-action-label">
              <span class="l-en">Expect noise around {{ _wtd_ev.label }} &mdash; don&rsquo;t read the first move as trend.</span>
              <span class="l-zh">{{ _wtd_ev_zh }}前后噪音加大 &mdash; 勿将初动解读为趋势。</span>
            </div>
            <div class="mx5-action-sub">
              <span class="l-en">{{ _wtd_ev.label }} {{ _wtd_ev.date[5:10] }} &middot; {{ _wtd_ev.impact | upper }} impact</span>
              <span class="l-zh">{{ _wtd_ev_zh }} {{ _wtd_ev.date[5:10] }} &middot; {{ {'high':'高','med':'中','low':'低'}.get(_wtd_ev.impact, _wtd_ev.impact) }}影响</span>
            </div>
          </div>
        </div>
        {% endif %}

        {# Row 4: risk radar (from MS.radar — v4 derivation: risk level) #}
        {% if market_state and MS.radar and MS.radar.state %}
        {% set _wtd_rdr_elevated = _mx5_risk_elevated %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon {{ 'mx5-ai-yellow' if _wtd_rdr_elevated else 'mx5-ai-gray' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="{{ '#f59e0b' if _wtd_rdr_elevated else 'rgba(255,255,255,.38)' }}" stroke-width="2" stroke-linecap="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div class="mx5-action-text">
            <div class="mx5-action-label">
              {% if _wtd_rdr_elevated and MS.radar.do_en %}
              {# engine guidance verbatim (no free-authored advice) #}
              <span class="l-en">{{ MS.radar.do_en }}</span>
              <span class="l-zh">{{ MS.radar.do_zh or MS.radar.do_en }}</span>
