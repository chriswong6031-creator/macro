    .sbx-dlg-x{position:sticky;top:0;float:right;background:var(--panel2);border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:14px;line-height:1;padding:5px 9px;cursor:pointer}
    </style>
    {% if breadth_panel %}{% set _c = breadth_panel.comp %}
