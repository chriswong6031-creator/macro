  <!-- ============ MACRO NOWCAST · CONDITIONS · RISK APPETITE ============ -->
  {% if latest.dislocation %}
  {% set DL = latest.dislocation %}
  {% set DI = DL.inputs %}
  {% set vcolor = 'var(--up)' if DL.verdict=='buyable_washout' else ('var(--down)' if DL.verdict=='stand_aside' else 'var(--muted)') %}
  <div class="panel span12" id="dislocation">
    <h2>🚦 {{ t('Dislocation Gate-1 · buyable washout vs falling knife', '错位一道闸 · 可买入错杀 对 接飞刀') }}
      {{ help("A risk FILTER that sits in FRONT of the capitulation gauge: when a stress dislocation hits (VIX panic, a >10% drawdown, a variance-premium extreme or VIX backwardation), it asks ONE question — is the Fed put present? PUT-ABSENT = a recession is underway (real-time Sahm >= 0.50) OR inflation locks the Fed (sustained 10y breakeven >= 2.5%). The whole edge is in REFUSING the falling knife (2000/2008/2022), not in catching the bounce — measured on SPY 1997-2026, see research/DISLOCATION_VALIDATION.md.", "位于恐慌触底指标之前的风险过滤器：当压力错位出现（VIX 恐慌、>10% 回撤、方差溢价极端或 VIX 倒挂）时，它只问一个问题 — 美联储托底是否在位？托底缺失＝衰退进行中（实时 Sahm ≥ 0.50）或通胀锁住美联储（持续十年期盈亏平衡 ≥ 2.5%）。全部优势在于拒绝接飞刀（2000／2008／2022），而非抄到反弹 — 基于标普 1997-2026 实测。") }}
    </h2>
    <p class="muted sm" style="margin:-4px 0 10px">{{ t('A risk filter, not a buy signal. The edge is in refusing the knife, not catching the bounce — judged on drawdown, not return.', '这是风险过滤器而非买入信号。优势在于拒绝接飞刀，而非抄到反弹 — 以回撤而非回报衡量。') }}</p>
    <div class="grid">

      <!-- verdict hero -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ vcolor }};border-radius:8px;padding:12px 14px">
        <div style="font-size:20px;font-weight:700;color:{{ vcolor }}">
          {% if DL.verdict=='buyable_washout' %}{{ t('Buyable washout', '可买入的错杀') }}
          {% elif DL.verdict=='stand_aside' %}{{ t('Stand aside — falling knife', '观望 — 接飞刀风险') }}
          {% else %}{{ t('No acute dislocation', '无急性错位') }}{% endif %}
        </div>
        <div class="muted sm" style="margin-top:6px">
          {% if DL.verdict=='buyable_washout' %}{{ t('A stress dislocation with the Fed put intact (no recession, inflation not blocking easing). Historically these mean-revert with shallower median drawdown — confirm into stabilization, do not anticipate.', '压力错位且美联储托底在位（无衰退、通胀不阻碍宽松）。历史上此类回归均值且中位回撤更浅 — 在企稳中确认，勿提前抢跑。') }}
          {% elif DL.verdict=='stand_aside' %}{{ t('A stress dislocation with the Fed put ABSENT. This is the 2000/2008/2022 regime where the same capitulation signals kept falling.', '压力错位且美联储托底缺失。这是 2000／2008／2022 情形，同样的恐慌信号仍持续下跌。') }}
          {% else %}{{ t('Markets are not in a stress washout — the filter is dormant and lights up only on a real dislocation.', '市场未处于压力抛售 — 过滤器休眠，仅在真正错位时点亮。') }}{% endif %}
        </div>
      </div>

      <!-- Fed-put master switch -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        {% set pcolor = 'var(--up)' if DL.fed_put else 'var(--down)' %}
        <div style="font-weight:700;margin-bottom:6px">{{ t('Fed-put master switch', '美联储托底主开关') }}
          {{ help("The one out-of-sample-stable discriminator (holds in BOTH 1997-2011 and 2012-2025). PUT-ABSENT = recession underway (Sahm >= 0.50) OR inflation locks the Fed (sustained 10y breakeven >= 2.5%). Primary trend is shown as context but adds little on top of the switch.", "唯一在样本外稳定的判别器（1997-2011 与 2012-2025 两半区均成立）。托底缺失＝衰退进行中（Sahm ≥ 0.50）或通胀锁住美联储（持续十年期盈亏平衡 ≥ 2.5%）。主趋势作为背景显示，但在开关之上增益有限。") }}
        </div>
        <div style="font-size:18px;font-weight:700;color:{{ pcolor }}">
          {% if DL.fed_put %}{{ t('Put present', '托底在位') }}{% else %}{{ t('Put ABSENT', '托底缺失') }}{% endif %}</div>
        <div class="muted sm" style="margin-top:5px">Sahm <b>{{ '%.2f'|format(DI.sahm) if DI.sahm is not none else '—' }}</b>
          · {{ t('10y breakeven', '十年盈亏平衡') }} <b>{{ '%.2f'|format(DI.breakeven_10y_1m) if DI.breakeven_10y_1m is not none else '—' }}%</b>
          · {{ t('trend', '趋势') }} <b>{{ t('up', '上行') if DI.primary_trend=='up' else t('down', '下行') }}</b></div>
        {% if not DL.fed_put %}
        <div class="sm" style="margin-top:5px;color:var(--down)">
          {% if DI.sahm is not none and DI.sahm >= 0.5 %}⚑ {{ t('recession underway (Sahm)', '衰退进行中（Sahm）') }}{% endif %}
          {% if DI.breakeven_10y_1m is not none and DI.breakeven_10y_1m >= 2.5 %}{% if DI.sahm is not none and DI.sahm >= 0.5 %} · {% endif %}⚑ {{ t('inflation locks the Fed', '通胀锁住美联储') }}{% endif %}
        </div>
        {% endif %}
      </div>

      {% if DL.dislocation_active %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">{{ t('Stress triggers firing', '触发的压力信号') }}</div>
        <div style="display:flex;flex-wrap:wrap;gap:6px">
          {% if DI.vix is not none and DI.vix > 30 %}<span class="badge" style="font-size:11px">{{ t('VIX panic', 'VIX 恐慌') }} {{ DI.vix }}</span>{% endif %}
          {% if DI.spy_drawdown_pct is not none and DI.spy_drawdown_pct <= -10 %}<span class="badge" style="font-size:11px">{{ t('drawdown', '回撤') }} {{ DI.spy_drawdown_pct }}%</span>{% endif %}
          {% if DI.vrp_pctile is not none and DI.vrp_pctile > 0.9 %}<span class="badge" style="font-size:11px">{{ t('VRP extreme', 'VRP 极端') }}</span>{% endif %}
          {% if DI.vix_term is not none and DI.vix_term >= 1 %}<span class="badge" style="font-size:11px">{{ t('VIX backwardation', 'VIX 倒挂') }} {{ '%.2f'|format(DI.vix_term) }}</span>{% endif %}
          {% if DI.capitulation_active %}<span class="badge" style="font-size:11px;color:var(--up)">{{ t('capitulation', '恐慌触底') }} {{ DI.capitulation_signals|length }}{% if DI.capitulation_strong %} ⚑{% endif %}</span>{% endif %}
        </div>
        {% if DL.capitulation_caveat %}
        <div class="sm" style="margin-top:7px;color:var(--down)">⚠ {{ t('The capitulation gauge is firing, but the Fed put is absent — its measured bounce does NOT apply here (the falling-knife regime).', '恐慌触底指标在触发，但美联储托底缺失 — 其实测反弹在此不适用（接飞刀情形）。') }}</div>
        {% endif %}
      </div>
      {% endif %}

      {% if DL.gate2 and DL.gate2.state not in ('dormant', 'unknown') %}
      {% set g2 = DL.gate2 %}
      {% set g2color = 'var(--up)' if g2.state=='confirmed' else ('#d98a00' if g2.state=='awaiting_confirm' else 'var(--muted)') %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-left:3px solid {{ g2color }};border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">{{ t('Gate-2 entry timer', '二道闸 · 入场时机') }}
          {{ help("The entry TIMER — it arms ONLY once Gate-1 says buyable, and it is a coincident CONFIRM, never anticipation: it waits for the VIX term structure to un-invert (backwardation back to contango), which historically lags the VIX peak by ~13 sessions. MEASURED on matched buyable washouts (2006+): waiting for the un-inversion lifted hit-rate 61->67%, median 3-month return +2.2->+4.6% and shallowed median drawdown -4.5->-2.9% — but the 1-in-10 tail was marginally worse. A confirm, not a bottom-caller.", "入场时机器 — 仅在一道闸判定可买入后才启动，且是同步确认而非提前预判：它等待 VIX 期限结构回正（由倒挂转为正向），历史上滞后 VIX 峰值约 13 个交易日。基于匹配的可买入错杀样本（2006+）实测：等待回正将胜率由 61% 提升至 67%，三月中位回报 +2.2% 升至 +4.6%，中位回撤由 −4.5% 收窄至 −2.9% — 但 1/10 尾部略差。这是确认，而非抄底。") }}
        </div>
        <b style="color:{{ g2color }}">
          {% if g2.state=='confirmed' %}{{ t('Re-entry confirmed', '入场已确认') }}
          {% elif g2.state=='awaiting_confirm' %}{{ t('Awaiting confirm', '等待确认') }}
          {% else %}{{ t('No timer signal', '无时机信号') }}{% endif %}</b>
        <span class="muted sm"> —
          {% if g2.state=='confirmed' %}{{ t('term structure un-inverted', '期限结构已回正') }}{% if g2.hook_days_ago is not none %} ({{ g2.hook_days_ago }} {{ t('sessions ago', '个交易日前') }}){% endif %}{{ t('; the mean-reversion confirm — wait for it, do not anticipate.', '；均值回归确认 — 等待它，勿提前抢跑。') }}
          {% elif g2.state=='awaiting_confirm' %}{{ t('term structure still backwardated; wait for the un-inversion (historically ~13 sessions after the VIX peak), do not anticipate.', '期限结构仍倒挂；等待回正（历史上约在 VIX 峰值后 13 个交易日），勿提前抢跑。') }}
          {% else %}{{ t('no backwardation to un-invert — the term-structure timer does not apply; rely on Gate-1.', '无倒挂可回正 — 期限结构时机器不适用；以一道闸为准。') }}{% endif %}</span>
      </div>
      {% endif %}

      <!-- measured record (honest) -->
      <div class="span12 muted sm" style="border-top:1px solid var(--line);padding-top:8px;margin-top:2px">
        <b>{{ t('Measured (SPY 1997-2026):', '实测（标普 1997-2026）：') }}</b> {{ t('put-present washouts had ~4pp shallower median 3-month drawdown than put-absent (95% CI [+0.3, +6.3]) — the one effect whose CI excludes zero. The larger hit-rate and 1-year-tail gaps point the same way, but their CIs span zero at ~10 effective crises, so they are carried by sign-consistency (leave-one-year-out 26/28, both split-halves), not significance. A drawdown filter, never alpha.', '托底在位的错杀其中位三月回撤比托底缺失浅约 4 个百分点（95% 置信区间 [+0.3, +6.3]）— 唯一置信区间不含零的效应。更大的胜率与一年尾部差异方向一致，但在约 10 个有效危机样本下置信区间跨零，故由符号一致性支撑（留一年法 26/28、两个样本半区），而非统计显著性。这是回撤过滤器，绝非超额收益。') }}
      </div>

    </div>
  </div>
  {% endif %}

  {# AI Master Brief — cross-asset LLM synthesis (engine/master_brain.py). Client-
     fetched from master_brief.json so it never depends on build order; hidden until
     a usable brief loads. Research context only — never a signal. #}
  <div class="panel span12" id="master-brief" style="display:none">
    <style>
      #master-brief .mb-sum{font-size:15px;font-weight:600;margin:0 0 10px}
      #master-brief .mb-sec{margin:10px 0}
      #master-brief .mb-h{font-weight:600;color:var(--link);margin:0 0 4px}
      #master-brief .mb-list{margin:4px 0 0 18px;padding:0}
      #master-brief .mb-list li{margin:3px 0}
      #master-brief .mb-foot{margin-top:12px;color:var(--muted);font-size:12px}
    </style>
    <h2>🧠 {{ t('AI Master Brief · cross-asset synthesis', 'AI 主脑简报 · 跨资产综合') }}
      {{ help('An AI-generated synthesis across all six dashboards (macro, China, HK, commodities, FX, Bitcoin). RESEARCH CONTEXT only — it reads the deterministic signals and narrates the cross-asset picture, flags where they conflict, and tests the liquidity-rotation thesis; it never feeds a score, signal or allocation. Can be wrong or overconfident — verify against the underlying dashboards.', 'AI 跨六大看板（宏观、中国、香港、商品、外汇、比特币）的综合分析。仅供研究参考——它解读确定性信号、叙述跨资产全局、标注信号冲突并检验流动性轮动假设，绝不参与任何评分、信号或仓位。可能出错或过度自信，请对照各看板核实。') }}
    </h2>
    <div id="master-brief-body" class="muted sm"></div>
  </div>
  <script src="masterbrief.js"></script>

  {% if latest.conditions %}
  {% set C = latest.conditions %}
  {% set FC = C.financial_conditions %}
  {% set RC = C.recession %}
  {% set GN = C.growth_nowcast %}
  {% set IN = C.inflation_nowcast %}
  {% set RA = C.risk_appetite %}
  {% set DR = C.drawdown_risk %}
  {% set CAP = C.capitulation %}
  {% set ST = C.style_tilt %}
  {% set LN = C.labor_nowcast %}
  {% set SC = (latest.playbook or {}).scenario %}
  {% set NH = nowcast_hist or {} %}
  <div class="panel span12" id="conditions">
    <h2>🛰️ {{ t('Macro nowcast · conditions · risk appetite', '宏观即时预测 · 金融条件 · 风险偏好') }}
      {{ help("A complementary lens that runs ALONGSIDE the price-based quad and never alters it: the Fed-research feeds and option-implied risk that a markets-only model misses. Financial conditions (Chicago Fed NFCI — 105 inputs in one z-score), a 0–100 recession-risk score (Sahm rule + smoothed probability + Excess Bond Premium + a term-premium-ADJUSTED curve that strips the 2022–24 false inversion), real-time growth (Weekly Economic Index, GDPNow) and inflation (Atlanta sticky vs flexible CPI) nowcasts, and a cross-asset risk-appetite read (equity vol-risk-premium, VIX term structure, CBOE SKEW, the stock-bond correlation regime, a RORO composite). Free Fed/CBOE data — see research/QUANT_FACTOR_EXPANSION.md.", "一个与价格象限并行、绝不改变象限的补充视角：纯市场模型遗漏的美联储研究数据与期权隐含风险。金融条件（芝加哥联储 NFCI — 105 项输入合成一个 z 分数）、0–100 衰退风险评分（Sahm 法则 + 平滑概率 + 超额债券溢价 + 期限溢价调整后的收益率曲线，剔除 2022–24 的假性倒挂）、实时增长（周度经济指数、GDPNow）与通胀（亚特兰大黏性对弹性 CPI）即时预测，以及跨资产风险偏好（股票波动率风险溢价、VIX 期限结构、CBOE SKEW、股债相关性状态、RORO 综合）。免费美联储／CBOE 数据。") }}
    </h2>
    <p class="muted sm" style="margin:-4px 0 10px">{{ t('Complementary to the quad above — it does not change the regime label; agreement strengthens conviction, divergence is a heads-up.', '与上方象限互补 — 不改变周期标签；一致则增强信心，背离则为提醒。') }}</p>
    <p class="sm" style="margin:-4px 0 12px">📈 {{ t('These macro-risk signals drive the', '这些宏观风险信号驱动') }} <a href="spvector.html" style="font-weight:700">{{ t('S&P / Macro Vector allocation', '标普／宏观向量配置') }} →</a> {{ t('— when to hold the broad US index vs T-bills.', '——何时持有美国大盘指数、何时转入短债。') }}</p>
    <div class="grid">

      <!-- Financial conditions -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Financial conditions', '金融条件') }} <span class="muted sm">NFCI</span>
          {{ help("How easy or hard it is to borrow and trade across the whole US financial system — the Chicago Fed's NFCI distils 105 money-market, debt, equity and shadow-banking indicators into one number. 0 = average; NEGATIVE = looser/easier than normal (a tailwind for risk assets); POSITIVE = tighter (a headwind). The percentile shows where today ranks against the last 5 years.", "在整个美国金融体系中借贷与交易的难易程度 — 芝加哥联储 NFCI 将 105 项指标合成一个数。0＝平均；负＝比平常更宽松（风险资产顺风）；正＝更紧（逆风）。百分位表示今日在近五年中的排名。") }}</div>
        {% if FC.nfci is not none %}
        {% set fcolor = 'var(--up)' if FC.state=='loose' else ('var(--down)' if FC.state=='tight' else 'var(--muted)') %}
        <div style="font-size:22px;font-weight:700;color:{{ fcolor }}">{{ '%+.2f'|format(FC.nfci) }}
          <span class="badge" style="font-size:11px;vertical-align:middle">{{ t(FC.state, {'loose':'宽松','tight':'收紧','neutral':'中性'}.get(FC.state, FC.state)) }}{% if FC.trend %} · {{ t(FC.trend, {'tightening':'收紧中','loosening':'宽松中'}.get(FC.trend, FC.trend)) }}{% endif %}</span></div>
        <div class="muted sm" style="margin-top:4px">{{ t('Easier than', '比') }} {{ ((1-FC.nfci_pctile)*100)|round|int if FC.nfci_pctile is not none else '—' }}% {{ t('of the past 5 years', '的近五年更宽松') }}</div>
        {% if FC.subindices %}
        <details class="jarg"><summary>{{ t("what's driving it", '驱动因素') }}</summary>
          <div class="jbody">
            {% set _sub = {'nfci_risk': ('Risk', '风险', 'Volatility & funding stress — how nervous markets are.', '波动与融资压力 — 市场有多紧张。'),
                           'nfci_credit': ('Credit', '信用', 'How cheaply & freely firms and households can borrow.', '企业与家庭借贷的便宜与顺畅程度。'),
                           'nfci_leverage': ('Leverage', '杠杆', 'How much debt & margin is built up in the system.', '系统中累积的债务与保证金规模。')} %}
            {% for k,v in FC.subindices.items() %}{% set m = _sub.get(k) %}{% if m %}
            <div class="jrow"><span class="jk">{{ t(m[0], m[1]) }}</span><span class="jv">{{ t(m[2], m[3]) }}</span><span class="jn" style="color:{{ 'var(--down)' if v>0.05 else ('var(--up)' if v<-0.05 else 'var(--muted)') }}">{{ '%+.2f'|format(v) }}</span></div>
            {% endif %}{% endfor %}
            <div class="muted" style="font-size:10px;margin-top:5px">{{ t('+ = tightening contribution · − = loosening', '正＝收紧贡献 · 负＝宽松贡献') }}</div>
          </div>
        </details>{% endif %}
        {% else %}<div class="muted">—</div>{% endif %}
      </div>

      <!-- Recession risk -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Recession risk', '衰退风险') }}
          {{ help("A 0–100 score for how close the US economy is to recession, blending four respected signals (the breakdown is under 'what's behind it'). LOW today means the expansion looks intact; it climbs months before a downturn, not on the day. A risk gauge, not a market-timing trigger.", "美国经济离衰退有多近的 0–100 评分，融合四个公认信号（拆解见'背后构成'）。今日低位意味着扩张看起来完好；它在衰退前数月就上升，而非当天。这是风险指标，而非择时触发器。") }}</div>
        {% if RC.score is not none %}
        {% set rcolor = 'var(--down)' if RC.label=='high' else ('#d98a00' if RC.label=='elevated' else 'var(--up)') %}
        <div style="font-size:22px;font-weight:700;color:{{ rcolor }}">{{ RC.score|round|int }}<span class="muted" style="font-size:13px">/100</span>
          <span class="badge" style="font-size:11px;vertical-align:middle">{{ t(RC.label, {'low':'低','elevated':'偏高','high':'高'}.get(RC.label, RC.label)) }}</span></div>
        <div style="height:7px;border-radius:4px;background:var(--line);margin:7px 0;overflow:hidden"><div style="height:100%;width:{{ RC.score|round|int }}%;background:{{ rcolor }}"></div></div>
        <details class="jarg"><summary>{{ t("what's behind it", '背后构成') }}</summary>
          <div class="jbody">
            <div class="jrow"><span class="jk">Sahm</span><span class="jv">{{ t('Unemployment rising off its lows — fires a recession call at 0.50.', '失业率从低位回升 — 达到 0.50 触发衰退判定。') }}</span><span class="jn">{{ '%.2f'|format(RC.sahm) if RC.sahm is not none else '—' }}</span></div>
            <div class="jrow"><span class="jk">{{ t('NY Fed prob','纽约联储概率') }}</span><span class="jv">{{ t('Model odds of recession within 12 months (from the yield curve).', '未来 12 个月衰退的模型概率（源自收益率曲线）。') }}</span><span class="jn">{{ '%.0f'|format(RC.ny_fed_prob) if RC.ny_fed_prob is not none else '—' }}%</span></div>
            <div class="jrow"><span class="jk">EBP</span><span class="jv">{{ t('Excess Bond Premium — fear priced into corporate credit beyond default risk. Above 0 = stress.', '超额债券溢价 — 企业信用中超出违约风险的恐惧定价。大于 0＝压力。') }}</span><span class="jn">{{ '%+.2f'|format(RC.ebp) if RC.ebp is not none else '—' }}</span></div>
            {% if RC.curve_note %}<div class="jrow"><span class="jk">{{ t('Curve','曲线') }}</span><span class="jv">{{ t('10y minus 3m slope — inverted (negative) has preceded most recessions; we adjust it for term premium to strip the 2022–24 false alarm.', '十年期减三个月斜率 — 倒挂（负）曾领先多数衰退；我们对其做期限溢价调整以剔除 2022–24 的假警报。') }}</span><span class="jn">{{ '%+.2f'|format(RC.curve_raw) if RC.curve_raw is not none else '—' }}→{{ '%+.2f'|format(RC.curve_tp_adjusted) if RC.curve_tp_adjusted is not none else '—' }}</span></div>{% endif %}
            {% if RC.components and RC.components.claims is not none %}<div class="jrow"><span class="jk">{{ t('Jobless claims','申领失业金') }}</span><span class="jv">{{ t('4-week-average initial claims surging vs a year ago — a leading labor signal that turns before the unemployment rate (validated vs NBER).', '首次申领失业金4周均值同比飙升 — 领先于失业率的劳动力信号（已对 NBER 验证）。') }}</span><span class="jn">{{ '%.0f'|format(RC.components.claims) }}/100</span></div>{% endif %}
          </div>
        </details>
        {% if DR and DR.score is not none %}
        {% set dcolor = 'var(--down)' if DR.band in ('high','extreme') else ('#d98a00' if DR.band=='elevated' else 'var(--muted)') %}
        <div class="kv" style="margin-top:7px;padding-top:7px;border-top:1px solid var(--line)">{{ t('Macro-stress (drawdown risk)', '宏观压力（回撤风险）') }}
          {{ help("A LEAN 4-factor macro-stress composite (recession-risk + NFCI + Excess Bond Premium + HY credit spreads; the weak curve/VIX legs were dropped after measurement). It is a DRAWDOWN-RISK gauge, not a return forecast: at the HIGH band the S&P had a ~36% chance of a >10% drawdown over the next 3 months vs ~8% base rate — the cleanest drawdown discriminator we measured (beats quad==Q4 and net-liquidity). Returns still rebound, so this says 'size down / widen stops', not 'sell everything'.", "精简版四因子宏观压力综合（衰退风险＋NFCI＋超额债券溢价＋高收益信用利差；曲线/VIX 经测量后剔除）。这是回撤风险指标而非回报预测：在高位区，标普未来三个月出现 >10% 回撤的概率约 36%（基准约 8%）。") }}
          <b style="float:right;color:{{ dcolor }}">{{ DR.score|round|int }}/100 · {{ t(DR.band, {'low':'低','elevated':'偏高','high':'高','extreme':'极高'}.get(DR.band, DR.band)) }}</b></div>
        <div class="muted sm">{{ t('Chance of a >10% S&P fall in 3 months:', '标普三月内下跌超 10% 的概率：') }} <b style="color:{{ dcolor }}">~{{ DR.dd10_prob_pct }}%</b> <span class="muted">{{ t('(vs ~8% normally)', '（平常约 8%）') }}</span></div>
        {% endif %}
        {% else %}<div class="muted">—</div>{% endif %}
      </div>

      <!-- Growth & inflation nowcast -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Growth & inflation nowcast', '增长与通胀即时预测') }}
          <span class="muted" style="font-weight:400;font-size:11px">· {{ t('hover a metric for its history', '悬停指标查看历史') }}</span></div>

        <div class="kv">
          <span class="hovchart">{{ t('Weekly Economic Index', '周度经济指数') }}<span class="tip">
            <span class="nph"><span class="l-en">Weekly Economic Index</span><span class="l-zh">周度经济指数</span></span>
            <span class="l-en"> — a real-time read on US growth from 10 weekly series (retail, hours, claims, fuel, steel…), scaled to GDP-growth terms. Updates every Thursday, so it sees turns months before quarterly GDP.</span><span class="l-zh"> — 由 10 个周度序列（零售、工时、申领、燃料、钢铁…）合成的实时美国增长读数，换算到 GDP 增速口径。每周四更新，比季度 GDP 提前数月见到拐点。</span>
            {{ nchart(NH.wei) }}</span></span>
          <b>{{ '%.1f'|format(GN.wei) if GN.wei is not none else '—' }}%</b> {{ trendword(NH.wei) }}</div>

        <div class="kv">
          <span class="hovchart">{{ t('GDPNow (Atlanta Fed)', 'GDPNow') }}<span class="tip">
            <span class="nph"><span class="l-en">GDPNow — Atlanta Fed</span><span class="l-zh">GDPNow — 亚特兰大联储</span></span>
            <span class="l-en"> — the Atlanta Fed's running estimate of the CURRENT quarter's GDP growth, rebuilt after every data release. Not a forecast — a nowcast of the quarter in progress.</span><span class="l-zh"> — 亚特兰大联储对当前季度 GDP 增速的滚动估计，每次数据发布后重算。不是预测，而是对进行中季度的即时测算。</span>
            {{ nchart(NH.gdpnow) }}</span></span>
          <b>{{ '%.1f'|format(GN.gdpnow) if GN.gdpnow is not none else '—' }}%</b> {{ trendword(NH.gdpnow) }}</div>

        {% if IN.sticky_ann is not none %}<div class="kv" style="margin-top:4px">
          <span class="hovchart">{{ t('Sticky CPI (persistent)', '黏性 CPI（持续性）') }}<span class="tip">
            <span class="nph"><span class="l-en">Sticky-price CPI</span><span class="l-zh">黏性价格 CPI</span></span>
            <span class="l-en"> — inflation in prices that change SLOWLY (rent, services, insurance). Because they reset infrequently, they capture the persistent, hard-to-shift core of inflation — what the Fed watches.</span><span class="l-zh"> — 调价缓慢的商品价格（房租、服务、保险）。因为很少重设，它们刻画了顽固、难以撼动的通胀核心 — 美联储紧盯的部分。</span>
            {{ nchart(NH.sticky) }}</span></span>
          <b>{{ '%.1f'|format(IN.sticky_ann) }}%</b> {{ trendword(NH.sticky) }}</div>{% endif %}

        {% if IN.flexible_ann is not none %}<div class="kv">
          <span class="hovchart">{{ t('Flexible CPI (transitory)', '弹性 CPI（暂时性）') }}<span class="tip">
            <span class="nph"><span class="l-en">Flexible-price CPI</span><span class="l-zh">弹性价格 CPI</span></span>
            <span class="l-en"> — inflation in prices that move FAST (gas, food, cars). It's noisy and mean-reverting — big swings here are usually transitory, so a flexible-led spike fades faster than a sticky-led one.</span><span class="l-zh"> — 变动迅速的商品价格（汽油、食品、汽车）。噪声大、均值回归 — 这里的大幅波动通常是暂时的，弹性主导的飙升比黏性主导的消退更快。</span>
            {{ nchart(NH.flexible) }}</span></span>
          <b>{{ '%.1f'|format(IN.flexible_ann) }}%</b> {{ trendword(NH.flexible) }}</div>{% endif %}

        {% if IN.read %}<div class="muted sm" style="margin-top:6px;padding-top:6px;border-top:1px solid var(--line)">{{ t('Read:', '判读：') }} <b>{{ t(IN.read, {'persistent (sticky-led)':'持续性（黏性主导）','transitory (flexible-led)':'暂时性（弹性主导）'}.get(IN.read, IN.read)) }}</b>
          {{ help("Which side of inflation is running hotter right now. 'Transitory (flexible-led)' = the gap is driven by the FAST, noisy prices (gas/food/cars), which tend to mean-revert — so this kind of inflation usually fades on its own. 'Persistent (sticky-led)' = the SLOW prices (rent/services) are leading, which is stubborn and what forces the Fed's hand. It compares the two nowcasts above; it is a read on the MIX, not a forecast of the level.", "现在通胀的哪一侧更热。'暂时性（弹性主导）'＝差距由快速、噪声大的价格（汽油/食品/汽车）驱动，往往均值回归，所以这类通胀通常自行消退。'持续性（黏性主导）'＝缓慢价格（房租/服务）领先，顽固且最终迫使美联储行动。它比较上面两个即时预测，判读的是结构而非水平的预测。") }}</div>{% endif %}
      </div>

      <!-- Labor & real-activity nowcast (leading; front-runs payrolls) -->
      {% if LN %}
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Labor & real activity', '劳动力与实体活动') }}
          {{ help("High-frequency, LEADING reads on the real economy that front-run the monthly (and heavily revised) jobs report. Weekly jobless claims (rising = more layoffs), Indeed job postings (labor DEMAND), and the daily withheld income & employment taxes deposited at the Treasury (a near-real-time read on total wages — very hard to game). They turn months before payrolls confirm. Free FRED / Treasury / SF Fed data — see research/REAL_ACTIVITY_NOWCAST.md.", "对实体经济的高频领先读数，抢在月度（且大幅修正）的就业报告之前。每周首次申领失业金（上升＝裁员增多）、Indeed 招聘职位（劳动力需求）、以及财政部每日预扣所得与就业税存款（对总工资的近实时读数，极难操纵）。它们比非农数据提前数月转向。免费 FRED／财政部／旧金山联储数据。") }}
          <span class="muted" style="font-weight:400;font-size:11px">· {{ t('leads payrolls', '领先非农') }}</span></div>

        {% if LN.initial_claims_4wk is not none %}
        {% set _ccol = 'var(--down)' if LN.claims_trend=='rising' else 'var(--up)' %}
        <div class="kv">{{ t('Initial claims (4wk avg)', '首次申领（4周均）') }}
          <b>{{ (LN.initial_claims_4wk/1000)|round|int }}k</b>
          {% if LN.claims_yoy_pct is not none %}<span class="sm" style="color:{{ _ccol }}">{{ '%+.0f'|format(LN.claims_yoy_pct) }}% y/y {{ '▲' if LN.claims_trend=='rising' else '▼' }}</span>{% endif %}</div>{% endif %}

        {% if LN.continued_claims is not none %}<div class="kv">{{ t('Continued claims', '续领失业金') }} <b>{{ '%.2f'|format(LN.continued_claims/1000000) }}M</b></div>{% endif %}

        {% if LN.indeed_postings is not none %}
        {% set _icol = 'var(--up)' if LN.indeed_trend=='rising' else 'var(--down)' %}
        <div class="kv">{{ t('Indeed job postings', 'Indeed 招聘职位') }}
          <b>{{ '%.0f'|format(LN.indeed_postings) }}</b>
          {% if LN.indeed_chg_3m_pct is not none %}<span class="sm" style="color:{{ _icol }}">{{ '%+.1f'|format(LN.indeed_chg_3m_pct) }}%/3mo {{ '▲' if LN.indeed_trend=='rising' else '▼' }}</span>{% endif %}</div>{% endif %}

        {% if LN.withheld_tax_yoy_pct is not none %}
        {% set _wcol = 'var(--up)' if LN.income_trend=='rising' else 'var(--down)' %}
        <div class="kv">{{ t('Withheld income taxes', '预扣所得税') }}
          {{ help("Income & employment taxes deposited daily at the Treasury straight from paychecks. The trailing-3-month total vs a year ago is a near-real-time read on total WAGE income — hard to manipulate, and it leads the payroll report.", "每日从工资中直接缴入财政部的所得与就业税。近三个月合计同比是对总工资收入的近实时读数 — 难以操纵，且领先非农报告。") }}
          <b style="color:{{ _wcol }}">{{ '%+.1f'|format(LN.withheld_tax_yoy_pct) }}%</b> <span class="muted sm">y/y</span></div>{% endif %}

        {% if LN.read %}
        {% set _rcol = 'var(--up)' if LN.read=='labor firm' else ('var(--down)' if LN.read=='labor cooling' else 'var(--muted)') %}
        <div class="muted sm" style="margin-top:6px;padding-top:6px;border-top:1px solid var(--line)">{{ t('Read:', '判读：') }}
          <b style="color:{{ _rcol }}">{{ t(LN.read, {'labor firm':'劳动力稳健','labor cooling':'劳动力降温','labor mixed':'劳动力分化'}.get(LN.read, LN.read)) }}</b></div>{% endif %}
      </div>
      {% endif %}

      <!-- Risk appetite -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        <div style="font-weight:700;margin-bottom:6px">{{ t('Risk appetite (cross-asset)', '风险偏好（跨资产）') }}</div>
        {% if RA.roro is not none %}
        {% set rocolor = 'var(--up)' if RA.roro_state=='risk-on' else ('var(--down)' if RA.roro_state=='risk-off' else 'var(--muted)') %}
        <div class="kv">RORO <b style="color:{{ rocolor }}">{{ '%+.2f'|format(RA.roro) }}</b> <span class="badge" style="font-size:11px">{{ t(RA.roro_state, {'risk-on':'风险偏好','risk-off':'避险','neutral':'中性'}.get(RA.roro_state, RA.roro_state)) }}</span></div>
        {% endif %}
        {% if RA.vrp is not none %}<div class="kv">{{ t('Equity vol-risk-premium', '股票波动率风险溢价') }} <b>{{ '%+.1f'|format(RA.vrp) }}</b> <span class="muted sm">{{ ((RA.vrp_pctile or 0)*100)|round|int }}%ile</span></div>{% endif %}
        {% if RA.vix_term is not none %}<div class="kv">{{ t('VIX term structure', 'VIX 期限结构') }} <b>{{ '%.2f'|format(RA.vix_term) }}</b> <span class="muted sm">{{ t('backwardation' if RA.vix_term>=1 else 'contango', '倒挂' if RA.vix_term>=1 else '正向') }}</span></div>{% endif %}
        {% if RA.skew is not none %}<div class="kv">{{ t('CBOE SKEW (tail)', 'CBOE SKEW（尾部）') }} <b>{{ RA.skew|round|int }}</b> <span class="muted sm">{{ ((RA.skew_pctile or 0)*100)|round|int }}%ile</span></div>{% endif %}
        {% if RA.stock_bond_corr is not none %}
        {% set sbcolor = 'var(--down)' if 'breakdown' in (RA.stock_bond_regime or '') else 'var(--muted)' %}
        <div class="kv">{{ t('Stock-bond corr', '股债相关性') }} <b style="color:{{ sbcolor }}">{{ '%+.2f'|format(RA.stock_bond_corr) }}</b> <span class="muted sm">{{ t('bonds not hedging' if 'breakdown' in (RA.stock_bond_regime or '') else ('bonds hedge' if 'diversifying' in (RA.stock_bond_regime or '') else 'mixed'), '债券未对冲' if 'breakdown' in (RA.stock_bond_regime or '') else ('债券对冲' if 'diversifying' in (RA.stock_bond_regime or '') else '混合')) }}</span></div>{% endif %}
        {% if RA.vol_target_scalar is not none %}<div class="kv">{{ t('Vol-target exposure', '波动率目标敞口') }} <b>{{ '%.2f'|format(RA.vol_target_scalar) }}×</b></div>{% endif %}
        {% if RA.get('news_sentiment') is not none %}
        {% set _nscol = 'var(--up)' if RA.news_sentiment_state=='optimistic' else 'var(--down)' %}
        <div class="kv">{{ t('News sentiment', '新闻情绪') }}
          {{ help("The San Francisco Fed's Daily News Sentiment Index — economic tone extracted from major US newspapers (history from 1980). A continuous, reproducible read of the macro mood (positive = optimistic), and a quant complement to the AI news digests.", "旧金山联储每日新闻情绪指数 — 从美国主流报纸提取的经济基调（自 1980 年）。对宏观情绪的连续、可复现读数（正值＝乐观），是 AI 新闻摘要的量化补充。") }}
          <b style="color:{{ _nscol }}">{{ '%+.2f'|format(RA.news_sentiment) }}</b> <span class="muted sm">{{ t(RA.news_sentiment_state, {'optimistic':'乐观','pessimistic':'悲观'}.get(RA.news_sentiment_state, RA.news_sentiment_state)) }}</span></div>{% endif %}
        {% if CAP and CAP.active %}
        {% set _firing = CAP.signals_firing or [] %}
        {% set _cot_on = (CAP.score or 0) - (_firing|length) %}
        {% set _vrp_on = 'VRP extreme' in _firing %}
        {% set _vix_on = 'VIX panic' in _firing %}
        <div class="kv" style="margin-top:6px;padding-top:6px;border-top:1px solid var(--line)">{{ t('Capitulation', '恐慌触底') }}
          <span class="help">?<span class="tip">
            <span class="l-en"><b>Capitulation gauge</b> — a CONTRARIAN bounce setup. It counts how many of three "everyone has panicked" signals are firing right now:</span>
            <span class="l-zh"><b>恐慌触底指标</b> — 逆向反弹布局。统计三个"人人恐慌"信号当前有几个触发：</span>
            <table class="sigtab">
              <tr><td><b>Vol-risk-premium extreme</b><br><span class="muted" style="font-size:10px"><span class="l-en">fear over-priced vs actual moves</span><span class="l-zh">恐惧相对实际波动被高估</span></span></td><td class="{{ 'sig-on' if _vrp_on else 'sig-off' }}">{{ '✓ firing' if _vrp_on else '– quiet' }}</td></tr>
              <tr><td><b>VIX &gt; 30</b><br><span class="muted" style="font-size:10px"><span class="l-en">outright panic in options</span><span class="l-zh">期权市场全面恐慌</span></span></td><td class="{{ 'sig-on' if _vix_on else 'sig-off' }}">{{ '✓ firing' if _vix_on else '– quiet' }}</td></tr>
              <tr><td><b>COT washout</b><br><span class="muted" style="font-size:10px"><span class="l-en">speculators dumped their longs</span><span class="l-zh">投机者抛空多头</span></span></td><td class="{{ 'sig-on' if _cot_on >= 1 else 'sig-off' }}">{{ '✓ firing' if _cot_on >= 1 else '– quiet' }}</td></tr>
            </table>
            <span class="l-en">MEASURED: when ≥2 stack, the S&P returned <b>+9.3%</b> over the next 3 months (<b>86%</b> positive) with shallower drawdowns — vs +2.8% base. It marks fear, not a forecast, and is silent in calm markets.</span>
            <span class="l-zh">实测：当 ≥2 个叠加时，标普未来三月 <b>+9.3%</b>（<b>86%</b> 为正），回撤更浅 — 基准 +2.8%。它标记恐惧而非预测，平静市场中静默。</span>
          </span></span>
          <b style="float:right;color:var(--up)">{{ CAP.score }}/3 {% if CAP.strong %}⚑{% endif %}</b></div>
        <div class="muted sm">{{ t('Historically a bounce setup:', '历史上的反弹布局：') }} <b style="color:var(--up)">+{{ CAP.measured_bounce_pct }}%/3mo</b>, {{ CAP.measured_hit_pct }}% {{ t('positive (vs +2.8% base)', '为正（基准 +2.8%）') }}</div>
        {% endif %}
      </div>

      <!-- factor leadership (cross-sectional equity factors) -->
      {% if factor_leadership %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
        <div style="font-weight:700;margin-bottom:4px">{{ t('Equity factor leadership', '股票因子领先') }}
          <span class="help">?<span class="tip">
            <span class="l-en"><b>Which "style" of stock is winning</b> over the last 63 days. Each badge below is one factor's top-fifth-minus-bottom-fifth return across the S&P 1500 (from SEC fundamentals):</span>
            <span class="l-zh"><b>哪种"风格"的股票在领先</b>（近 63 日）。下方每个标签是该因子在标普 1500 中顶部五分位减底部五分位的回报（源自 SEC 基本面）：</span>
            <table class="sigtab">
              <tr><td><b>Value</b></td><td class="l"><span class="l-en">cheap vs fundamentals</span><span class="l-zh">相对基本面便宜</span></td></tr>
              <tr><td><b>Quality</b></td><td class="l"><span class="l-en">strong balance sheets</span><span class="l-zh">资产负债表稳健</span></td></tr>
              <tr><td><b>Profitability</b></td><td class="l"><span class="l-en">high margins / ROE</span><span class="l-zh">高利润率／ROE</span></td></tr>
              <tr><td><b>Low-vol</b></td><td class="l"><span class="l-en">steady, defensive names</span><span class="l-zh">稳健的防御股</span></td></tr>
            </table>
            <span class="lad" style="background:color-mix(in srgb,var(--up) 16%,var(--panel))"><span class="l-en"><b>Quality/profitability leading</b> → risk-on, growth-led tape</span><span class="l-zh"><b>质量／盈利领先</b> → 风险偏好、成长主导</span></span>
            <span class="lad" style="background:color-mix(in srgb,var(--orange) 16%,var(--panel))"><span class="l-en"><b>Value/low-vol leading</b> → defensive, late-cycle</span><span class="l-zh"><b>价值／低波动领先</b> → 防御、周期晚段</span></span>
          </span></span>
          <a href="factors.html" class="muted sm" style="float:right">{{ t('Factors page →', '因子页 →') }}</a></div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px">
          {% for L in factor_leadership %}
          <span class="badge" style="font-size:11px;border:1px solid var(--line);background:var(--panel);color:{{ 'var(--up)' if L.spread_pct>=0 else 'var(--down)' }}">{{ td(L.label) }} {{ '%+.1f'|format(L.spread_pct) }}%</span>
          {% endfor %}
        </div>
        {% if ST and ST.tilt %}
        {% set _yup = ST.yield_chg_1m_bp is not none and ST.yield_chg_1m_bp > 0 %}
        <div class="muted sm" style="margin-top:7px;padding-top:6px;border-top:1px solid var(--line)">{{ t('Value vs Growth style tilt:', '价值对成长风格倾向：') }}
          <b style="color:{{ 'var(--up)' if ST.tilt=='value' else ('var(--down)' if ST.tilt=='growth' else 'var(--muted)') }}">{{ t(ST.tilt, {'value':'价值','growth':'成长','neutral':'中性'}.get(ST.tilt, ST.tilt)) }}</b>
          ({{ t('10y', '十年期') }} {{ '%+.0f'|format(ST.yield_chg_1m_bp) if ST.yield_chg_1m_bp is not none else '—' }}bp/mo)
          <span class="help">?<span class="tip">
            <span class="l-en">The 10-year Treasury yield quietly steers which style leads. The relationship is one of the most reliable we measured:</span>
            <span class="l-zh">十年期国债收益率悄然主导哪种风格领先。这是我们测得最可靠的关系之一：</span>
            <table class="sigtab">
              <tr><td><b>10y rising ▲</b></td><td class="l" style="color:var(--up)"><span class="l-en">→ VALUE leads</span><span class="l-zh">→ 价值领先</span></td></tr>
              <tr><td><b>10y falling ▼</b></td><td class="l" style="color:var(--down)"><span class="l-en">→ GROWTH leads</span><span class="l-zh">→ 成长领先</span></td></tr>
            </table>
            <span class="muted" style="font-size:10.5px;display:block">{{ t('Now:', '现在：') }} {{ t('10y', '十年期') }} {{ '%+.0f'|format(ST.yield_chg_1m_bp) if ST.yield_chg_1m_bp is not none else '—' }}bp/mo {% if _yup %}▲{% elif ST.yield_chg_1m_bp is not none and ST.yield_chg_1m_bp < 0 %}▼{% endif %}</span>
            <span class="l-en" style="display:block;margin-top:4px">MEASURED: value beat growth +0.8%/63d when the 10y rose &gt;10bp/month (t=+3.0), in all four 2000–2026 sub-periods. A tilt, not a trade signal.</span>
            <span class="l-zh" style="display:block;margin-top:4px">实测：当十年期月内上行 &gt;10bp 时，价值股 63 天内跑赢成长股 +0.8%（t=+3.0），且在 2000–2026 四个子周期中均成立。这是倾向，而非交易信号。</span>
          </span></span></div>
        {% endif %}
      </div>
      {% endif %}

      <!-- scenario odds (quad x financial-conditions direction) -->
      {% if SC and SC.current %}
      <div class="span12" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
        {% set _hit = SC.current.hit_pct|round|int %}
        <div style="font-weight:700;margin-bottom:4px">{{ t('What happens next — scenario odds', '接下来会怎样 — 情景概率') }}
          <span class="help">?<span class="tip">
            <span class="l-en">History rhymes. We look back at every month that matched <b>today's setup</b> — the regime's risk group AND whether financial conditions were loosening or tightening — and count how often the S&P rose the next month.</span>
            <span class="l-zh">历史会重演。我们回看所有与<b>今日格局</b>相符的月份 — 周期的风险组别，以及金融条件当时在宽松还是收紧 — 统计标普次月上涨的频率。</span>
            <span class="l-en" style="display:block;margin-top:5px">Adding the conditions-direction split moved the hit rate 13–20pp and held in both halves of 2007–2026. These are <b>base rates from history, not a forecast</b>.</span>
            <span class="l-zh" style="display:block;margin-top:5px">加入条件方向后，胜率变动 13–20 个百分点，并在 2007–2026 两个样本半区均成立。这些是<b>历史基础概率，而非预测</b>。</span>
          </span></span></div>
        <div class="muted sm" style="margin-bottom:6px">{{ t("Today's setup:", '今日格局：') }} <b>{{ td(SC.group) }}</b> · {{ t('conditions', '条件') }} <b>{{ t(SC.direction, {'loosening':'宽松中','tightening':'收紧中'}.get(SC.direction, SC.direction)) }}</b></div>
        <div class="oddsbar" title="{{ _hit }}% / {{ 100-_hit }}%">
          <div class="ob-hit" style="width:{{ _hit }}%">{% if _hit >= 18 %}{{ _hit }}% ↑{% endif %}</div>
          <div class="ob-miss" style="width:{{ 100-_hit }}%">{% if (100-_hit) >= 18 %}{{ 100-_hit }}% ↓{% endif %}</div>
        </div>
        <div class="muted sm">{{ t('S&P higher one month later', '标普一个月后走高') }} <b style="color:var(--up)">{{ _hit }}%</b> {{ t('of the time', '的概率') }}
          <span class="muted">({{ '%+.2f'|format(SC.current.avg_pct) }}% {{ t('avg', '平均') }}, n={{ SC.current.n }})</span>
          {% if SC.contrast %}
          <div class="ocmp"><span>{{ t('vs', '对比') }}</span><span class="oc-alt">{{ SC.contrast.hit_pct|round|int }}%</span><span>{{ t('when conditions are', '当条件为') }} {{ t(SC.contrast_direction, {'loosening':'宽松','tightening':'收紧'}.get(SC.contrast_direction, SC.contrast_direction)) }}</span></div>{% endif %}</div>
      </div>
      {% endif %}

    </div>
  </div>
  {% endif %}

  <!-- ======================= MACRO NEWS, SENTIMENT & CATALYSTS ======================= -->
  <style>
  #macro-news .mn-cols{display:grid;grid-template-columns:1.7fr 1fr;gap:20px;margin-top:10px}
  #macro-news .section-title{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 8px;font-weight:700}
  #macro-news .mn-sent{display:flex;gap:8px;align-items:baseline;font-size:14px;margin:2px 0 4px}
  #macro-news .mn-brief{background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13px;line-height:1.5;margin:8px 0 4px}
  #macro-news .mn-item{display:block;padding:6px 0;border-bottom:1px solid var(--panel2);color:var(--text);text-decoration:none;font-size:13px;line-height:1.4}
  #macro-news .mn-item:hover{color:var(--up)}
  #macro-news .mn-theme,#macro-news .cat-type{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;padding:1px 6px;border-radius:5px;background:var(--line);color:var(--muted)}
  #macro-news .mn-theme{margin-right:7px;vertical-align:1px}
  #macro-news .mn-t-monetary{background:#22324f;color:#9cc4ff}#macro-news .mn-t-inflation{background:#4f2c22;color:#ffb499}
  #macro-news .mn-t-labor{background:#1f4733;color:#a0ffc4}#macro-news .mn-t-growth{background:#2c3f1f;color:#cfe89a}
  #macro-news .mn-t-credit{background:#3a2f5f;color:#c4b0ff}#macro-news .mn-t-fiscal{background:#4f3a1f;color:#ffd79a}
  #macro-news .cat-row{display:flex;gap:9px;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--panel2);font-size:13px}
  #macro-news .cat-date{color:var(--muted);font-variant-numeric:tabular-nums;min-width:118px}
  #macro-news .ct-FOMC{background:#3a2f5f;color:#c4b0ff}#macro-news .ct-NFP{background:#1f4733;color:#a0ffc4}
  #macro-news .mn-disc{color:var(--muted);font-size:11px;margin-top:12px;border-top:1px solid var(--line);padding-top:8px;line-height:1.5}
  @media(max-width:760px){ #macro-news .mn-cols{grid-template-columns:1fr} }
  </style>
  <div class="panel span12" id="macro-news">
    <h2>📰 {{ t('Macro news, sentiment &amp; catalysts', '宏观新闻、情绪与日程') }}
      {{ help("Filtered macro news (reputable sources, macro themes only — each headline tagged by theme), the SF-Fed Daily News Sentiment Index (a quantitative series, NOT per-headline AI), and the upcoming scheduled catalysts (FOMC, jobs report). All CONTEXT — none of it feeds any score, signal or allocation, and the mechanical model never sees it.", "已筛选的宏观新闻（仅可靠来源、仅宏观主题，每条按主题标注）、旧金山联储每日新闻情绪指数（量化序列，而非逐条新闻 AI），以及即将到来的排定催化（FOMC、就业报告）。全部为背景 —— 不进入任何评分、信号或配置，机械模型也从不读取。") }}
    </h2>
    {% set RA = (latest.conditions or {}).get('risk_appetite') or {} %}
    {% if RA.get('news_sentiment_state') %}
    {% set nz = RA.get('news_sentiment_z') %}
    <div class="mn-sent">
      <span class="muted">{{ t('News sentiment (SF-Fed index):', '新闻情绪（旧金山联储指数）：') }}</span>
      <span class="{{ 'pos' if RA.get('news_sentiment_state') == 'optimistic' else 'neg' }}"><b>{{ t('optimistic', '乐观') if RA.get('news_sentiment_state') == 'optimistic' else t('pessimistic', '悲观') }}</b>{% if nz is not none %} · z {{ '%+.1f'|format(nz) }}{% endif %}</span>
    </div>
    {% endif %}
    {% if macro_brief and macro_brief.text %}
    <div class="mn-brief">🤖 <b>{{ t('AI brief (context)', 'AI 摘要（背景）') }}:</b> {{ macro_brief.text }}</div>
    {% endif %}
    {% set TL = {'monetary':['Fed','美联储'],'inflation':['Inflation','通胀'],'labor':['Labor','就业'],'growth':['Growth','增长'],'credit':['Rates','利率'],'fiscal':['Fiscal','财政']} %}
    <div class="mn-cols">
      <div class="mn-news">
        <div class="section-title">{{ t('Filtered macro headlines', '已筛选的宏观头条') }}{% if macro_news and macro_news.n_raw %} <span class="muted">({{ macro_news.n_kept }}/{{ macro_news.n_raw }})</span>{% endif %}</div>
        {% if macro_news and macro_news.headlines %}
          {% for h in macro_news.headlines %}
          <a class="mn-item" href="{{ h.url }}" target="_blank" rel="noopener"><span class="mn-theme mn-t-{{ h.theme }}">{{ t(TL.get(h.theme, [h.theme,h.theme])[0], TL.get(h.theme, [h.theme,h.theme])[1]) }}</span>{{ h.title }} <span class="muted">— {{ h.domain }}</span></a>
          {% endfor %}
        {% else %}
          <p class="muted sm">{{ t('No macro headlines right now — the news fetch is off (default) or the tape is quiet.', '暂无宏观头条 —— 新闻抓取已关闭（默认）或行情平静。') }}</p>
        {% endif %}
      </div>
      <div class="mn-cats">
        <div class="section-title">{{ t('Upcoming catalysts', '即将到来的催化') }}</div>
        {% if macro_catalysts %}
          {% for c in macro_catalysts %}
          <div class="cat-row"><span class="cat-date">{{ c.date }}{% if c.time_et %} · {{ c.time_et }} ET{% endif %}</span><span class="cat-type ct-{{ c.type }}">{{ c.type }}</span><span class="cat-label">{{ c.label }}</span></div>
          {% endfor %}
        {% else %}
          <p class="muted sm">{{ t('No scheduled catalysts in the window.', '窗口内无排定催化。') }}</p>
        {% endif %}
      </div>
    </div>
    <p class="mn-disc">{{ t(macro_news_disclaimer, macro_news_disclaimer_zh) }}</p>
  </div>

  <!-- ======================= ACTION BOARD ======================= -->
  {% if action_board %}
  <div class="panel span12">
    <h2>⚡ {{ t('What to act on now', '当前可操作') }}
      {{ help("Your at-a-glance starting point. Built from each sector's own price cycle (and standout individual stocks): what's a confirmed buy today, what's setting up to buy within a few days, what to take profits on, and what to leave alone. 'Days' are rough trajectory estimates, not promises. Click any name for the full breakdown.", "你的一眼总览起点。基于每个板块自身的价格周期（及表现突出的个股）：今日已确认的买入、几天内即将构筑的买入、需止盈的、以及该放手不管的。'天数'是粗略的轨迹估计，并非承诺。点击任意名称查看完整拆解。") }}
    </h2>
    <div class="actiongrid">
      <div class="actcol act-buy">
        <div class="acth">🟢 {{ t('BUY ZONE — confirmed now', '买入区 — 已确认') }}</div>
        {% for x in action_board.buy_now %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.age_short %}<span class="actage">⏱ {{ t(x.age_short, x.age_short_zh) }}</span>{% endif %}{% if x.eq_badge %}<span class="eqmini eq-{{ x.eq_dir }}" title="{{ x.eq_tip }}">{{ x.eq_badge }}</span>{% endif %}<span class="acttag">{{ td(x.label) }}</span></a>
        {% else %}<p class="muted sm">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-soon">
        <div class="acth">🔵 {{ t('SETTING UP — buy soon', '构筑中 — 即将买入') }}</div>
        {% for x in action_board.buy_soon %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.get('days') is not none %}<span class="acteta">~{{ x.days }}d</span>{% endif %}</a>
        {% else %}<p class="muted sm">{{ t('No imminent setups.', '暂无临近的构筑。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-trim">
        <div class="acth">🟠 {{ t('TAKE PROFITS / topping', '止盈／做顶') }}</div>
        {% for x in action_board.take_profits %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.age_short %}<span class="actage">⏱ {{ t(x.age_short, x.age_short_zh) }}</span>{% endif %}{% if x.eq_badge %}<span class="eqmini eq-{{ x.eq_dir }}" title="{{ x.eq_tip }}">{{ x.eq_badge }}</span>{% endif %}<span class="acttag">{{ td(x.label) }}</span></a>
        {% else %}<p class="muted sm">{{ t('Nothing topping.', '无标的做顶。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-hold">
        <div class="acth">⚪ {{ t('HOLD / avoid', '持有／回避') }}</div>
        {% for x in action_board.hold %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ t("hold — don't chase", '持有 — 勿追高') }}</span></a>
        {% endfor %}
        {% for x in action_board.avoid %}
          <a class="actitem" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b> <span class="muted">{{ t("wait", '等待') if x.tag == "WAIT" else t("avoid", '回避') }}</span></a>
        {% endfor %}
      </div>
    </div>
    {% if action_board.notable %}
    <div class="notable">
      <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
        <span style="font-weight:700;font-size:13px">{{ t('Standout individual stocks', '表现突出的个股') }}</span>
        <span class="muted" style="font-size:11.5px">{{ t('from each sector’s top-10 holdings · ranked by signal conviction', '来自各板块前十大持仓 · 按信号置信度排序') }}
          {{ help("Every sector ETF's top-10 holdings are run through the SAME price-cycle engine as the sectors. A name earns a card only when its cycle signal is decisive — a confirmed buy (BUY ZONE), an imminent turn (BOTTOMING), or a sell (TOPPING). They're RANKED by the engine's own entry-quality score (|conviction|), strongest first, and 'minimal'-grade setups are filtered out — so the cards you see are the best-timed, freshest setups, not just the biggest names. Click any card for the full breakdown.", "每个板块 ETF 的前十大持仓都用与板块相同的价格周期引擎分析。只有当个股的周期信号具决定性时才会获得卡片 — 已确认买入（买入区）、即将转向（筑底）或卖出（做顶）。它们按引擎自身的入场质量评分（|置信度|）排序，最强在前，并过滤掉'极弱'级别 — 所以你看到的是择时最佳、最新鲜的布局，而非仅仅是最大的名字。点击任意卡片查看完整拆解。") }}</span>
      </div>
      <div class="nbgrid">
      {% for n in action_board.notable %}
        {% set _d = n.dir or 'caution' %}
        <a class="nbcard nb-{{ _d }}" href="stock.html#{{ n.ticker }}">
          <div class="nb-top">
            <span class="nb-tk">{{ n.ticker }}</span>
            <span class="nb-nm">{{ n.name }}</span>
            {% if n.get('price') is not none %}<span class="nb-px">${{ '%.2f'|format(n.price) }}</span>{% endif %}
          </div>
          <div class="nb-sub"><span>{{ td(n.sector) }}</span>{% if n.get('off_high') is not none %}<span>{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}</div>
          {{ n.spark_svg }}
          <div class="nb-bot">
            <span class="nb-state">{{ td(n.label) }}</span>
            {% if n.urgency == 'imminent' and n.days %}<span class="nb-eta">~{{ n.days }}d</span>{% endif %}
            {% if n.eq_badge %}<span class="nb-score s-{{ n.eq_dir or 'flat' }}">{{ n.eq_badge }}</span>{% endif %}
          </div>
          <div class="nb-meta">
            {% if n.eq_grade %}<span class="nb-grade" style="color:{{ 'var(--up)' if n.eq_dir=='up' else ('var(--down)' if n.eq_dir=='down' else 'var(--muted)') }}">{{ t(n.eq_grade, n.eq_grade_zh) if n.eq_grade_zh else n.eq_grade }}</span> ·{% endif %}
            <span title="signal triggered {{ n.signal_date }} · 信号触发 {{ n.signal_date }}">⏱ {{ t(n.age_short, n.age_short_zh) if n.age_short else (n.signal_date or '') }}</span>
          </div>
        </a>
      {% endfor %}
      </div>
    </div>
    {% endif %}
    <p class="muted" style="font-size:11.5px; margin-top:8px">⚠ {{ t("Cycle-timing signals are about <i>where in the price cycle</i> a sector is — most useful combined with the regime read above. Our calibration shows these states don't beat buy-and-hold on average return; their value is structure and risk placement (entry + a defined exit), not certainty.", "周期择时信号关乎一个板块<i>处于价格周期的哪个位置</i> — 与上方的周期判读结合使用最有价值。我们的校准显示这些状态在平均回报上并不能跑赢买入持有；它们的价值在于结构与风险摆位（入场 + 明确的出场），而非确定性。") }}</p>
  </div>
  {% endif %}

  <!-- ======================= NOW ======================= -->
  {% if pb %}
  <div class="panel span6">
    <h2>{{ t('Where we are in this regime', '我们身处此周期何处') }}
      {{ help("Compares this regime's age against every " + latest.quad_name + " period since 2007 in this exact classifier. Regimes don't die of old age — but the older one gets relative to history, the more weight every warning flag deserves.", "将此周期的年龄与自 2007 年以来本分类器中每一段 " + latest.quad_name + " 周期对比。周期不会因年老而自然消亡 — 但相对历史越老，每一面预警旗都越值得加重看待。") }}
    </h2>
    <p style="font-size:14.5px; margin: 2px 0 6px"><b>{{ t(pb.quad_meaning.en, pb.quad_meaning.zh) }}.</b></p>
    {% if pb.progress %}
    <div class="lifebar">
      <div class="zone" style="left:0; width:{{ pb.progress.zone_early_pct }}%; background:color-mix(in srgb, var(--up) 35%, var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_early_pct }}%; width:{{ pb.progress.zone_mid_pct - pb.progress.zone_early_pct }}%; background:color-mix(in srgb, var(--warn) 35%, var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_mid_pct }}%; width:{{ 100 - pb.progress.zone_mid_pct }}%; background:color-mix(in srgb, var(--down) 35%, var(--panel))"></div>
      <div class="marker" style="left:{{ pb.progress.bar_pct }}%"></div>
    </div>
    <div class="lifelabels"><span>{{ t('young', '年轻') }}</span><span>{{ t('mid-life', '中年') }}</span><span>{{ t('old', '年老') }}</span></div>
    <p style="margin:10px 0 4px"><b>{{ t(pb.progress.phase | upper, tr(pb.progress.phase)) }}</b> — {{ t(pb.progress.phase_note, pb.progress.phase_note_zh) }}.</p>

    {% if stance %}
    {% set _sv = {
      'run':   ('🟢', 'Let winners run', '让赢家继续奔跑', 'Trend intact — the odds of a regime shift are low.', '趋势完好 — 周期转变的概率较低。'),
      'hold':  ('🟡', 'Stay with the trend — trail your stops', '跟随趋势 — 收紧移动止损', 'Warnings are building: stop ADDING regime-dependent bets, but no break yet.', '预警正在累积：停止加注依赖周期的押注，但尚未破位。'),
      'shift': ('🟠', 'Start looking for a regime change', '开始留意周期转变', 'Shift odds are compounding — reduce risk before the label flips.', '转变概率层层叠加 — 在标签翻转前降低风险。'),
      'reset': ('🔄', 'Regime just turned — reset', '周期刚刚转变 — 重置', 'The label changed within the last week: switch to the new playbook.', '标签在过去一周内已改变：切换到新剧本。')
    } %}
    {% set _s = _sv[stance.key] %}
    <div class="stance stance-{{ stance.key }}">
      <div class="stance-hd">
        <span class="stance-ico">{{ _s[0] }}</span>
        <div>
          <div class="stance-v">{{ t(_s[1], _s[2]) }}</div>
          <div class="stance-sub">{{ t(_s[3], _s[4]) }}</div>
        </div>
      </div>
      <div class="stance-track"><i style="left:{{ stance.pos_pct }}%"></i></div>
      <div class="stance-ends"><span>{{ t('let winners run', '让赢家奔跑') }}</span><span>{{ t('look for a change', '留意转变') }}</span></div>
      <div class="stance-meta">{{ t(stance.age_word, {'young':'年轻','mid-life':'中年','old':'年老'}.get(stance.age_word, stance.age_word)) }} {{ td(latest.quad_name) }} · {{ t('radar', '雷达') }} {{ td(stance.radar) }}{% if stance.n_warn %} · {{ stance.n_warn }} {{ t('warning' if stance.n_warn == 1 else 'warnings', '预警') }}{% endif %}
        {{ help("This verdict combines two things on this page: how far through its historical lifespan this regime is (the bar above), and the transition radar (top of page). STABLE → let winners run; WEAKENING → stop adding & trail stops; TRANSITIONING → look for a change; NEW REGIME → reset. An OLD regime makes every warning matter more. Base rates from 2007-present, not a prediction.", "此判断综合本页两件事：此周期已走过其历史寿命的多少（上方进度条），以及转换雷达（页面顶部）。稳定 → 让赢家奔跑；走弱 → 停止加注并收紧止损；转换中 → 留意转变；新周期 → 重置。年老的周期会让每个预警都更重要。基于 2007 年至今的基础概率，而非预测。") }}</div>
    </div>
    {% endif %}

    <p class="muted" style="margin:4px 0">
      <span class="l-en">
      {{ pb.progress.age_days }} trading days in, vs a median of {{ pb.progress.median_days }}
      across {{ pb.progress.n_history }} past {{ latest.quad_name }} periods.
      {{ pb.progress.pct_longer | round | int }}% of them lasted longer than this one has so far{% if pb.progress.median_remaining_days %} —
      and those that did typically ran another ~{{ pb.progress.median_remaining_days }} trading days
      (≈{{ (pb.progress.median_remaining_days / 5) | round(1) }} weeks){% endif %}.
      </span>
      <span class="l-zh">
      已运行 {{ pb.progress.age_days }} 个交易日，对比 {{ pb.progress.n_history }} 段过往 {{ td(latest.quad_name) }} 周期的中位数 {{ pb.progress.median_days }} 个交易日。
      其中 {{ pb.progress.pct_longer | round | int }}% 比当前这一段持续得更久{% if pb.progress.median_remaining_days %} —
      而那些更久的通常还会再运行约 {{ pb.progress.median_remaining_days }} 个交易日
      （≈{{ (pb.progress.median_remaining_days / 5) | round(1) }} 周）{% endif %}。
      </span>
      {{ help("Historical base rates from this classifier's own 2007-present history — odds and typical paths, not predictions. A young regime + STABLE radar = let winners run. An old regime + warnings = the odds of a shift compound.", "来自本分类器自身 2007 年至今历史的基础概率 — 是概率与典型路径，而非预测。年轻周期 + 稳定雷达 = 让赢家继续奔跑。年老周期 + 预警 = 转变的概率层层叠加。") }}
    </p>
    {% else %}
    <p class="muted">{{ t('Not enough regime history for lifespan statistics yet.', '周期历史尚不足以做寿命统计。') }}</p>
    {% endif %}
  </div>

  <!-- ======================= NEXT ======================= -->
  <div class="panel span6">
    <h2>{{ t("What's likely next — and how to trade it", '接下来可能发生什么 — 以及如何交易') }}
      {{ help("Simple historical frequencies: across every " + latest.quad_name + " period since 2007, which regime came next. These are base rates, not forecasts — but they tell you which playbook to keep warm. The watch names below are NOT buys yet; the evidence says anticipating rotations loses money — wait for the trend to confirm.", "简单的历史频率：自 2007 年以来每一段 " + latest.quad_name + " 周期之后，接下来出现的是哪个周期。这些是基础概率，而非预测 — 但能告诉你该把哪套剧本备着。下方的观察标的目前还不是买入；证据表明提前押注轮动会亏钱 — 等趋势确认。") }}
    </h2>
    {% for n in pb.next_list %}
    <div class="prob">
      <span class="nm">{{ td(n.name) }}</span>
      <span class="bar"><i style="width:{{ n.prob_pct }}%; background: var(--q{{ n.code[1] }})"></i></span>
      <span class="pc">{{ n.prob_pct }}%</span>
    </div>
    {% endfor %}
    {% if pb.watchlist %}
      <h3>{{ t('Accumulation watchlist for that shift', '为该转变准备的吸筹观察名单') }}</h3>
      {% for x in pb.watchlist %}
        <div class="card"><span class="calltag tag-watch">{{ td("WATCH — DON'T BUY YET") }}</span>
          <b class="tk">{{ x.ticker }}</b> · {{ td(x.name) }}<br>
          <span class="muted">{{ t(x.why, x.why_zh) }}</span></div>
      {% endfor %}
    {% endif %}
    <h3>{{ t('The signals that would announce the shift', '将预告该转变的信号') }}</h3>
    <ul class="compact muted">
      {% for trg_en, trg_zh in pb.triggers %}<li>{{ t(trg_en, trg_zh) }}</li>{% endfor %}
    </ul>
  </div>

  <!-- ======================= TRADE IT ======================= -->
  <div class="panel span12">
    <h2>{{ t('How to trade the current regime', '如何交易当前周期') }}
      {{ help("Built from conditions that held up in both halves of a 2007-2026 backtest. The dial is the headline: how much risk current conditions support. Sector calls below it are risk filters and confirmation tools — our research found no stable 'this sector will outperform' signal at monthly horizons, so anyone selling you that is curve-fitting.", "基于在 2007–2026 回测前后两半都站得住脚的条件构建。刻度盘是核心：当前条件支持多大的风险。其下的板块判断是风险过滤器与确认工具 — 我们的研究在月度时间尺度上未发现稳定的'某板块将跑赢'信号，所以任何向你兜售此类信号的人都是在过拟合。") }}
    </h2>
    <div class="dial">
      {% for p in ["DEFENSIVE","CAREFUL","NEUTRAL","CONSTRUCTIVE","AGGRESSIVE"] %}
        <span class="{{ 'active-' + p if pb.dial.posture == p }}">{{ td(p) }}</span>
      {% endfor %}
    </div>
    {% for sign, r_en, r_zh in pb.dial.reasons %}
      <div class="reason"><b class="sig sig-{{ {'+':'p','-':'m','i':'i'}[sign] }}">{{ {'+':'+','-':'−','i':'i'}[sign] }}</b> {{ t(r_en, r_zh) }}</div>
    {% endfor %}

    <div class="grid" style="margin-top:12px">
      <div class="span6">
        <h3>✅ {{ t('Confirmed leadership — where participation is real', '已确认的领先 — 参与度真实之处') }}
          {{ help("Sectors in an established uptrend vs the market with momentum still positive and not yet stretched. Descriptive — where the market's money already is. Use it to place exposure you already intend to take.", "相对市场处于既定上涨趋势、动量仍为正且尚未过度拉伸的板块。这是描述性的 — 市场资金已经在哪里。用它来摆放你本就打算建立的敞口。") }}
        </h3>
        {% for x in pb.leaders %}
          <div class="card"><span class="calltag tag-lead">{{ t('LEADER', '领先') }}</span>
            <b class="tk">{{ x.ticker }}</b> · {{ td(x.name) }}<br>
            <span class="muted">{{ t(x.why, x.why_zh) }}</span></div>
        {% else %}
          <p class="muted">{{ t('No sector currently qualifies — leadership is either stretched or unconfirmed. That itself is information: stay close to the index.', '当前无板块合格 — 领先地位要么已过度拉伸，要么尚未确认。这本身就是信息：紧贴指数。') }}</p>
        {% endfor %}
        {% if pb.momentum_tilt.tickers %}
          <p class="muted" style="font-size:12px">{{ t('Longer-horizon tilt:', '较长时间尺度倾斜：') }} <b>
            {%- for t in pb.momentum_tilt.tickers %}{{ t.ticker }}{{ ", " if not loop.last }}{% endfor -%}
          </b> {{ help(pb.momentum_tilt.note, pb.momentum_tilt.note_zh) }}</p>
        {% endif %}
      </div>
      <div class="span6">
        <h3>🚫 {{ t("Avoid right now — the evidence-backed don'ts", '现在回避 — 有证据支撑的禁忌') }}
          {{ help("The strongest findings in our sector backtest were about what NOT to do: chasing stretched leaders lost 55% of the time; buying below-trend bounces lost in every variant tested. These warnings carry more statistical weight than any buy signal on this page.", "我们板块回测中最强的发现都是关于不该做什么：追逐过度拉伸的领先股有 55% 的时间亏钱；买入趋势下方的反弹在测试的每个变体中都亏钱。这些警告比本页任何买入信号都带有更大的统计权重。") }}
        </h3>
        {% for x in pb.avoid %}
          <div class="card"><span class="calltag tag-avoid">{{ td(x.call) }}</span>
            <b class="tk">{{ x.ticker }}</b> · {{ td(x.name) }}<br>
            <span class="muted">{{ t(x.why, x.why_zh) }}</span></div>
        {% else %}
          <p class="muted">{{ t('Nothing currently triggers the avoid rules.', '当前没有任何标的触发回避规则。') }}</p>
        {% endfor %}
      </div>
    </div>
    <p class="muted" style="font-size:12px; margin-top:8px">⚖️ {{ t(pb.honesty, pb.honesty_zh) }}</p>
  </div>
  {% endif %}

  <!-- ======================= SIGNALS ======================= -->
  <div class="panel span6" id="dials">
    <h2>{{ t('The two dials behind the regime', '周期背后的两个刻度盘') }}
      {{ help("The regime label comes from two scores between -1 and +1, built from market prices (which lead) plus a small weight on economic data (which confirms). Growth above zero + inflation below zero = Goldilocks, and so on. The white marker is today.", "周期标签来自两个介于 -1 与 +1 之间的分数，由市场价格（领先）加上经济数据（确认）的小幅权重构建。增长高于零 + 通胀低于零 = 理想增长，以此类推。白色标记代表今日。") }}
    </h2>
    <p style="margin:8px 0 0"><b>{{ t('Growth:', '增长：') }} {{ t("RISING", '上行') if latest.growth_score >= 0 else t("FALLING", '下行') }}</b>
      <span class="muted">({{ "%+.2f" | format(latest.growth_score) }} {{ t('of ±1 · agreement', '／±1 · 一致度') }} {{ (latest.growth_confidence * 100) | round | int }}%)</span>
      {{ help("Is the economy's growth impulse improving or deteriorating, as priced by markets: copper vs gold, consumer discretionary vs staples, small vs large caps, cyclical vs defensive sectors, the 2-year yield, breadth — confirmed slowly by payrolls and industrial production.", "经济的增长动能正在改善还是恶化，以市场定价衡量：铜对黄金、可选消费对必需消费、小盘对大盘、周期板块对防御板块、2 年期收益率、市场广度 — 由非农就业与工业产出缓慢确认。") }}
    </p>
    <div class="gauge"><i style="left: {{ ((latest.growth_score + 1) / 2 * 100) | round(1) }}%"></i></div>
    <p style="margin:10px 0 0"><b>{{ t('Inflation pressure:', '通胀压力：') }} {{ t("RISING", '上行') if latest.inflation_score >= 0 else t("FALLING", '下行') }}</b>
      <span class="muted">({{ "%+.2f" | format(latest.inflation_score) }} {{ t('of ±1 · agreement', '／±1 · 一致度') }} {{ (latest.inflation_confidence * 100) | round | int }}%)</span>
      {{ help("Is inflation pressure building or cooling, as priced by markets: bond-market inflation expectations, oil, energy-sector strength, and inflation-winner vs inflation-loser sector baskets.", "通胀压力正在累积还是降温，以市场定价衡量：债市通胀预期、原油、能源板块强度，以及通胀受益板块对通胀受损板块的组合。") }}
    </p>
    <div class="gauge"><i style="left: {{ ((latest.inflation_score + 1) / 2 * 100) | round(1) }}%"></i></div>

    <h3>{{ t("What's voting for this regime", '哪些指标在为此周期投票') }}
      {{ help("Each chip is one indicator inside the two dials. Green chips point WITH the regime call; red chips point AGAINST it. Lots of red = shaky ground (and lower 'signal agreement').", "每个标签代表两个刻度盘中的一个指标。绿色标签与周期判断同向；红色标签与之反向。红色越多 = 根基越不稳（且'信号一致度'越低）。") }}
    </h3>
    <div>
      {% for c in components_confirming %}<span class="chip chip-pos">{{ c }}</span>{% endfor %}
      {% for c in components_contradicting %}<span class="chip chip-neg">{{ c }}</span>{% endfor %}
      {% if not components_confirming and not components_contradicting %}<span class="muted">{{ t('all quiet', '一切平静') }}</span>{% endif %}
    </div>

    <h3>{{ t('Weakest link', '最薄弱环节') }}
      {{ help("Of everything currently supporting the regime call, this indicator is closest to flipping sides — the single thing most likely to change the picture.", "在当前支撑周期判断的所有指标中，这一个最接近倒戈 — 是最有可能改变全局的单一因素。") }}
    </h3>
    <p class="muted">{{ flip_plain }}</p>

    {% if latest.preference_check %}
    <h3>{{ t('Does the market agree with the regime?', '市场是否认同此周期？') }}
      {{ help("The regime implies certain sectors should lead. This checks whether they actually ARE. Agreement strengthens the call; disagreement is an early warning — when the tape stops cooperating with the story, the story is often about to change.", "此周期暗示某些板块应当领先。这里检验它们是否真的在领先。一致会强化判断；分歧则是早期预警 — 当盘面不再配合剧情时，剧情往往即将改变。") }}
    </h3>
    <p class="muted">{{ latest.preference_check.note }}
      {% if latest.preference_check.actual_ranks %}
        <span class="l-en">({% for t, r in latest.preference_check.actual_ranks.items() %}{{ t }} is #{{ r }}{{ ", " if not loop.last }}{% endfor %} of {{ latest.sector_rs | length }})</span><span class="l-zh">（{% for t, r in latest.preference_check.actual_ranks.items() %}{{ t }} 排名第 {{ r }}{{ "，" if not loop.last }}{% endfor %}，共 {{ latest.sector_rs | length }} 个）</span>
      {% endif %}
    </p>
    {% endif %}
  </div>

  <!-- ======================= INTERNALS ======================= -->
  <div class="panel span6">
    <h2>{{ t('Market internals — risk appetite gauges', '市场内部结构 — 风险偏好计') }}
      {{ help("Simple ratios between two assets; each answers a question about investor mood. Direction over the last 20 days matters more than the level. Green = moved in the risk-friendly direction.", "两类资产之间的简单比率；每一个都回答一个关于投资者情绪的问题。过去 20 天的方向比绝对水平更重要。绿色 = 朝风险友好的方向移动。") }}
    </h2>
    <table>
      <tr><th class="l">{{ t('gauge', '指标') }}</th><th>{{ t('past month', '过去一月') }}</th><th class="l">{{ t("what it's saying", '它在说什么') }}</th></tr>
      {% for r in internals %}
      <tr>
        <td class="l">{{ r.label }} {{ help(r.tip) }}</td>
        <td class="{{ 'pos' if r.good else 'neg' }}">{{ "%+.2f" | format(r.chg) }}%</td>
        <td class="l muted">{{ r.verdict }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <!-- ===================== US EQUITY SIZE & STYLE ===================== -->
  <div class="panel span6" id="size-style">
    <h2>{{ t('US equity — size &amp; style', '美股 — 规模与风格') }}
      {{ help("Is the advance broad or narrow? Small caps (Russell 2000) and mid caps measured against the large-cap S&P 500: rising = participation broadening (risk-on); falling = a narrow, mega-cap-led tape. Growth vs value is the style rotation — growth tends to lead in disinflation and slowdowns, value in reflation. Direction over the last 20 trading days; size ratios are coloured by risk-on direction, growth/value is left neutral (no inherently good side).", "上涨是广泛还是狭窄？小盘（罗素2000）与中盘对大盘标普500衡量：上行 = 参与度扩散（风险偏好）；下行 = 狭窄、由超大盘主导的盘面。成长对价值是风格轮动 — 成长在去通胀与放缓中领先，价值在再通胀中领先。看过去20个交易日的方向；规模比率按风险偏好方向着色，成长／价值保持中性（无天然的好坏方向）。") }}
    </h2>
    <table>
      <tr><th class="l">{{ t('lens', '维度') }}</th><th>{{ t('past month', '过去一月') }}</th><th class="l">{{ t("what it's saying", '它在说什么') }}</th></tr>
      {% for r in size_style %}
      <tr>
        <td class="l">{{ r.label }} {{ help(r.tip) }}</td>
        <td class="{{ r.tone }}">{{ "%+.2f" | format(r.chg) }}%</td>
        <td class="l muted">{{ r.verdict }}</td>
      </tr>
      {% endfor %}
    </table>
    {% if breadth_div %}
    <p class="muted" style="margin:10px 2px 0; font-size:13px; line-height:1.45">
      {{ t('Small-cap participation', '小盘参与度') }}:
      <b>{{ "%.0f" | format(breadth_div.sc) }}%</b>
      {{ t('of S&P 600 small caps are above their 50-day line, vs', '的标普600小盘股高于其50日均线，对比') }}
      <b>{{ "%.0f" | format(breadth_div.lc) }}%</b>
      {{ t('for the S&P 500', '的标普500') }} — {{ breadth_div.verdict }}.
    </p>
    {% endif %}
  </div>

  <!-- ======================= SECTOR HEAT BOARD ======================= -->
  <div class="panel span12" id="sectors">
    <h2>{{ t('Sector heat board — regime × tape × technicals × seasonality', '板块热度榜 — 周期 × 盘面 × 技术 × 季节性') }}
      {{ help("One row per sector, everything that matters in one place. HEAT (0-100) measures how CONFIRMED a sector's strength is right now: regime fit + rotation stage + technicals, minus crowding. Important: heat describes the present, not the future — our 2007-2026 backtest shows the hottest band (70+) actually UNDERPERFORMED over the following months (everything-confirmed usually means late). So: high heat = hold/trim territory, never a fresh-entry signal; the buy workflow is the watchlist + trigger column.", "每个板块一行，把重要的一切放在一处。热度（0–100）衡量一个板块的强势此刻有多被确认：周期契合度 + 轮动阶段 + 技术面，减去拥挤度。重要：热度描述的是现在，而非未来 — 我们 2007–2026 的回测显示最热的区间（70+）在随后几个月反而跑输（万事俱备通常意味着已晚）。因此：高热度 = 持有／减仓区，绝非新建仓信号；买入流程靠观察名单 + 触发列。") }}
    </h2>
    <table>
      <tr>
        <th class="l">{{ t('sector', '板块') }}</th>
        <th class="l" style="min-width:130px">{{ t('heat', '热度') }} <span class="help">?<span class="tip">
          <span class="l-en">
          <b>Heat</b> = how CONFIRMED a sector's strength is (regime fit + trend stage +
          technicals − crowding − a macro-risk adjustment when macro risk is elevated and
          the sector is macro-sensitive). Hover each bar for its exact arithmetic.
          <table>
            <tr><th>band</th><th>read it as</th><th>measured 3-month record*</th></tr>
            <tr><td style="color:var(--orange)"><b>70+ OVERHEATED</b></td><td>late — hold/trim, don't start</td><td>beat market 47% (−0.6% avg)</td></tr>
            <tr><td style="color:var(--up)"><b>55-69 HOT</b></td><td>confirmed — hold, buy pullbacks</td><td>49% (−0.3%)</td></tr>
            <tr><td><b>40-54 NEUTRAL</b></td><td>mixed, no lean</td><td>49% (−0.1%)</td></tr>
            <tr><td style="color:var(--info)"><b>0-39 COLD</b></td><td>washed out — wait for trigger</td><td>50% (+0.2%)</td></tr>
          </table>
          *vs the index, every week 2007-2026. Note the inversion: hot sectors were
          usually LATE. That measured record is the trust level — and it argues
          against chasing.
          </span>
          <span class="l-zh">
          <b>热度</b> = 一个板块的强势有多被确认（周期契合度 + 趋势阶段 +
          技术面 − 拥挤度 − 宏观风险升高且板块对宏观敏感时的宏观风险调整）。
          将鼠标悬停在每个条上可查看其精确算式。
          <table>
            <tr><th>区间</th><th>解读为</th><th>实测 3 个月记录*</th></tr>
            <tr><td style="color:var(--orange)"><b>70+ 过热</b></td><td>已晚 — 持有／减仓，勿入场</td><td>跑赢市场 47%（平均 −0.6%）</td></tr>
            <tr><td style="color:var(--up)"><b>55-69 偏热</b></td><td>已确认 — 持有，回调时买入</td><td>49%（−0.3%）</td></tr>
            <tr><td><b>40-54 中性</b></td><td>混合，无倾向</td><td>49%（−0.1%）</td></tr>
            <tr><td style="color:var(--info)"><b>0-39 偏冷</b></td><td>已洗盘 — 等待触发</td><td>50%（+0.2%）</td></tr>
          </table>
          *对比指数，2007–2026 每一周。注意这种反转：偏热的板块通常都已晚。
          这份实测记录就是可信度 — 它反对追高。
          </span>
        </span></span></th>
        <th>{{ t('stage', '阶段') }} <span class="help">?<span class="tip">
          <span class="l-en">
          <b>The rotation cycle</b> — every sector travels this loop vs the market:
          <span class="lad lad-tint" style="--c:var(--info)">1. IMPROVING — momentum turns up, trend not yet confirmed. <b>Too early</b>: buying here lost money historically.</span>
          <span class="lad lad-tint" style="--c:var(--up)">2. LEADING — confirmed uptrend. The healthy zone.</span>
          <span class="lad lad-tint" style="--c:var(--warn)">3. WEAKENING — still above trend but losing steam. Tighten stops.</span>
          <span class="lad lad-tint" style="--c:var(--down)">4. LAGGING — downtrend. Avoid until it improves again.</span>
          </span>
          <span class="l-zh">
          <b>轮动周期</b> — 每个板块相对市场都会走完这个循环：
          <span class="lad lad-tint" style="--c:var(--info)">1. 改善 — 动量转上，趋势尚未确认。<b>过早</b>：历史上在这里买入会亏钱。</span>
          <span class="lad lad-tint" style="--c:var(--up)">2. 领先 — 已确认上涨趋势。健康区。</span>
          <span class="lad lad-tint" style="--c:var(--warn)">3. 走弱 — 仍在趋势上方但动能减弱。收紧止损。</span>
          <span class="lad lad-tint" style="--c:var(--down)">4. 落后 — 下跌趋势。回避，直到再度改善。</span>
          </span>
        </span></span></th>
        <th>{{ t('3mo vs market', '3 月对比市场') }} {{ help("How much it beat or trailed the S&P 500 over the past 60 trading days — the medium-term relative trend the playbook keys off.", "过去 60 个交易日内它跑赢或落后标普 500 多少 — 剧本所依据的中期相对趋势。") }}</th>
        <th>{{ t('technicals', '技术面') }} <span class="help">?<span class="tip">
          <span class="l-en">
          <b>RSI(14)</b> — a 0-100 momentum thermometer:
          <span class="scale">
            <span style="background:var(--g-cold)">OVERSOLD</span>
            <span style="background:var(--muted)">SOFT</span>
            <span style="background:var(--up)">HEALTHY</span>
            <span style="background:var(--down)">HOT</span>
          </span>
          <span class="sl"><span>0</span><span>30</span><span>45</span><span>70</span><span>100</span></span>
          <b>✓/✗ 200d and 50d</b>: whether price is above its 200-day (long-term) and
          50-day (medium-term) average — the most basic "is it in an uptrend" filters.
          Green row = both ✓.
          </span>
          <span class="l-zh">
          <b>RSI(14)</b> — 一个 0–100 的动量温度计：
          <span class="scale">
            <span style="background:var(--g-cold)">超卖</span>
            <span style="background:var(--muted)">疲软</span>
            <span style="background:var(--up)">健康</span>
            <span style="background:var(--down)">过热</span>
          </span>
          <span class="sl"><span>0</span><span>30</span><span>45</span><span>70</span><span>100</span></span>
          <b>✓/✗ 200日 与 50日</b>：价格是否高于其 200 日（长期）与
          50 日（中期）均线 — 最基本的"是否处于上涨趋势"过滤器。
          绿色行 = 两者皆 ✓。
          </span>
        </span></span></th>
        <th>{{ t('seasonality', '季节性') }} {{ help("This sector's average return in the current calendar month (and how often that month closed up). Hover any value for the full 12-month picture — a chart plus a table, with this month highlighted. Weak evidence by nature: background context only, never a signal on its own, and deliberately left out of the heat score.", "该板块在当前日历月的平均回报（以及该月收涨的频率）。将鼠标悬停在任意数值上可查看完整的 12 个月全貌 — 图表加表格，并高亮当前月份。本质上是弱证据：仅作背景参考，绝不单独作为信号，并已刻意排除在热度分数之外。") }}</th>
        <th>{{ t('to trigger', '距触发') }} {{ help("For sectors below their long-term relative trend: how much more outperformance vs SPY is needed for the trend to cross (= the data-backed buy confirmation), and how far along it already is from its recent low. Small gap + high progress = watch closely.", "对于低于其长期相对趋势的板块：还需相对 SPY 多跑赢多少趋势才会交叉（= 有数据支撑的买入确认），以及从近期低点起已走了多远。差距小 + 进度高 = 密切观察。") }}</th>
        <th>{{ t('cycle timing', '周期择时') }} {{ help("From the sector's own price cycle (click the sector name for the full drill-down): where it sits in its ~36-42 trading-day cycle and how many of its top-10 holdings are in a buy setup (BOTTOMING or BUY ZONE). The per-state historical base rates live on the drill-down page.", "来自板块自身的价格周期（点击板块名称查看完整下钻）：它处于约 36–42 个交易日周期的哪个位置，以及其前十大持仓中有多少处于买入构筑（筑底中或买入区）。各状态的历史基础概率见下钻页面。") }}</th>
      </tr>
      {% for r in sector_rows %}
      <tr>
        <td class="l"><a href="sectors/{{ r.ticker }}.html"><b>{{ r.ticker }}</b></a> <span class="muted">{{ td(r.name) }}</span></td>
        <td class="l" data-sort="{{ r.heat }}">
          <span class="help" style="width:auto;height:auto;border:none;margin:0;border-radius:6px">
            <span style="display:inline-flex;align-items:center;gap:7px;cursor:help">
              <span style="display:inline-block;width:64px;height:9px;background:var(--panel2);border-radius:5px;overflow:hidden"><i style="display:block;height:100%;width:{{ r.heat }}%;background:{{ r.heat_color }}"></i></span>
              <b>{{ r.heat }}</b>
              <span class="muted" style="font-size:11px">{{ td(r.heat_label) }}</span>
            </span>
            <span class="tip">{{ r.heat_tip }}</span>
          </span>
        </td>
        <td><span class="pill stg-{{ r.stage }}">{{ td(r.stage) }}</span></td>
        <td class="{{ 'pos' if r.mom_60d_pct > 0 else 'neg' }}" data-sort="{{ r.mom_60d_pct }}">{{ "%+.1f" | format(r.mom_60d_pct) }}%</td>
        <td class="{{ 'pos' if r.tech_ok else '' }}" style="font-size:12px">{{ r.tech_str }}</td>
        <td>
          <span class="help" style="width:auto;height:auto;border:none;margin:0">
            <span style="cursor:help">{{ r.season_str }}</span>
            <span class="tip tip-seas">{{ r.season_tip }}</span>
          </span>
        </td>
        <td>{{ r.trigger_str }}</td>
        <td>
          {% if r.timing_state %}
            <span class="pill st-{{ r.timing_state | replace(' ', '_') }}">{{ td(r.timing_label) }}</span>
            <div class="muted" style="font-size:11px">{{ r.timing_note }}</div>
          {% else %}—{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted" style="font-size:12px">{{ t('Click any sector for its full drill-down: cycle position, multi-timeframe momentum, and each top-10 holding analyzed individually.', '点击任意板块查看完整下钻：周期位置、多时间尺度动量，以及逐一分析的每个前十大持仓。') }}</p>
  </div>

  <div class="panel span6">
    <h2>{{ t('Commodities & macro tape', '大宗商品与宏观盘面') }}
      {{ help("The non-equity instruments the regime engine watches, with their technicals and seasonal tendency. No heat score here — regime alignment and rotation stages are equity-sector concepts.", "周期引擎所关注的非股票类标的，及其技术面与季节性倾向。这里没有热度分数 — 周期契合度与轮动阶段是股票板块的概念。") }}
    </h2>
    <table>
      <tr><th class="l">{{ t('instrument', '标的') }}</th><th>{{ t('trend', '趋势') }}</th><th>RSI</th><th>{{ t('off 52w high', '距52周高') }}</th><th>{{ t('3mo', '3月') }}</th><th>{{ t('seasonal', '季节性') }}</th></tr>
      {% for c in commodities %}
      <tr>
        <td class="l"><b>{{ td(c.name) }}</b></td>
        <td>{{ "✓" if c.above200 else "✗" }}200d {{ "✓" if c.above50 else "✗" }}50d</td>
        <td>{{ c.rsi14 | round | int if c.rsi14 is not none else "—" }}</td>
        <td class="{{ 'neg' if c.off_52w_high_pct < -10 else '' }}">{{ "%+.1f" | format(c.off_52w_high_pct) }}%</td>
        <td class="{{ 'pos' if c.mom_60d_pct > 0 else 'neg' }}">{{ "%+.1f" | format(c.mom_60d_pct) }}%</td>
        <td>
          <span class="help" style="width:auto;height:auto;border:none;margin:0">
            <span style="cursor:help">{{ (c.season_this or "—").split(":")[1].split("avg")[0].strip() if c.season_this else "—" }}</span>
            <span class="tip">{{ t(c.season_this, c.season_this_zh) if c.season_this else t("Not enough history.", "历史数据不足。") }}</span>
          </span>
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <div class="panel span6" id="liquidity">
    <h2>{{ t('Fed liquidity — the money tide', '美联储流动性 — 资金潮') }}
      {{ help("Top: net money in the system (Fed balance sheet minus reverse-repo minus the Treasury's account), in billions. Bottom: its 4-week change — the impulse. Green above the dotted line = expanding (historically the most reliable tailwind); red below = contracting.", "上方：系统内的净资金（美联储资产负债表减逆回购减财政部账户），单位十亿。下方：其 4 周变化 — 即动能。虚线之上为绿色 = 扩张（历史上最可靠的顺风）；下方为红色 = 收缩。") }}
    </h2>
    <div class="chart">{{ chart_liquidity | safe }}</div>
  </div>

  <div class="panel span6" id="credit">
    <h2>{{ t('Credit stress & market breadth', '信用压力与市场广度') }}
      {{ help("Top: the extra yield junk-bond investors demand — the market's best early smoke detector; rising = stress building; below ~4% is calm. Bottom: % of S&P 500 stocks above their 50-day average — participation. Strong indexes with collapsing breadth are fragile.", "上方：垃圾债投资者要求的额外收益率 — 市场最好的早期烟雾探测器；上行 = 压力累积；低于约 4% 为平静。下方：标普 500 中高于其 50 日均线的股票占比 — 即参与度。指数走强而广度崩塌则脆弱。") }}
    </h2>
    <div class="chart">{{ chart_credit_breadth | safe }}</div>
  </div>

  <!-- ======================= POSITIONING ======================= -->
  <div class="panel span6" id="positioning">
    <h2>{{ t("Who's positioned how — the crowd meter", '谁如何持仓 — 拥挤度计') }}
      {{ help("What different investor groups are currently doing, shown as a position on each dial. The middle is normal; the ENDS are the danger zones — when a marker sits at either extreme, that trade is crowded and prone to violent reversal. Hover each name for the underlying numbers.", "不同投资者群体当前在做什么，以每个刻度盘上的位置呈现。中间为正常；两端是危险区 — 当标记落在任一极端时，该交易已拥挤且易发生剧烈反转。将鼠标悬停在每个名称上可查看底层数字。") }}
    </h2>
    <table>
      <tr><th class="l">{{ t('who / what', '谁／什么') }}</th><th class="l" style="min-width:150px">{{ t('where they stand', '当前位置') }}</th><th class="l">{{ t('what it means', '含义') }}</th></tr>
      {% for p in positioning %}
      <tr>
        <td class="l">{{ p.name }} {{ help(p.tip) }}</td>
        <td class="l">
          {% if p.pct is not none %}
            <div class="pgauge"><i style="left: {{ p.pct | round(1) }}%"></i></div>
            <div class="pends"><span>{{ p.left }}</span><span>{{ p.right }}</span></div>
          {% else %}
            <span class="plabel {{ 'plabel-hot' if 'amplif' in p.label or 'hedg' in p.label or 'complacent' in p.label else 'plabel-norm' }}">{{ p.label }}</span>
          {% endif %}
        </td>
        <td class="l muted">
          {% if p.pct is not none %}<b style="color:var(--text)">{{ p.label }}</b>{% if p.verdict %} — {{ p.verdict }}{% endif %}
          {% else %}{{ p.verdict }}{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>

  <!-- ======================= ACCUMULATION WATCH ======================= -->
  <div class="panel span12" id="accumulation">
    <h2>{{ t('🐳 Accumulation watch — sector ETFs', '🐳 增持监测 — 板块 ETF') }}
      {{ help("Each sector SPDR's top-10 weights, with each holding's weight change split into the part explained by the stock's own price move and a residual ('active' = weight that grew MORE than price alone). A large positive residual = real buying flowed into the name beyond market drift. HONEST CAVEAT: these SPDRs are PASSIVE index funds, so the residual is index reconstitution / float-weight flow (forced index-fund buying), NOT a discretionary manager's conviction — that reading comes with the active funds in the planned top-200 page. The technical column shows the stock's own cycle state; ✅ marks accumulation that also has a forming buy setup. Thresholds are uncalibrated until more snapshot history accumulates.", "每只板块 SPDR 的前十大权重；每只持仓的权重变动被拆分为“由个股自身价格变动解释的部分”与“残差”（“主动”=权重增长超过价格涨幅的部分）。较大的正残差=除市场漂移外确有真实买盘流入该股。诚实提示：这些 SPDR 是被动指数基金，故残差代表指数再平衡／流通权重调整带来的资金流（被动强制买入），并非主动经理的信念——后者要等到计划中的前 200 ETF 页面里的主动基金。技术面列显示个股自身的周期状态；✅ 表示增持同时出现了正在形成的买入形态。在积累更多快照历史前，阈值尚未校准。") }}
    </h2>
    {% if accumulation %}
      <table>
        <tr>
          <th class="l">{{ t('sector', '板块') }}</th>
          <th class="l">{{ t('stock', '个股') }}</th>
          <th>{{ t('raw Δwt', '原始权重Δ') }}</th>
          <th>{{ t('active Δwt', '主动权重Δ') }}</th>
          <th>{{ t('est. flow', '估算资金流') }}</th>
          <th class="l">{{ t('technical', '技术面') }}</th>
        </tr>
        {% for a in accumulation %}
        <tr>
          <td class="l muted">{{ a.fund }} · {{ td(a.sector) }}</td>
          <td class="l"><a href="stock.html#{{ a.ticker }}"><b>{{ a.ticker }}</b></a> <span class="muted">{{ a.name }}</span></td>
          <td class="{{ 'pos' if a.raw_change >= 0 else 'neg' }}">{{ "%+.2f" | format(a.raw_change) }}pp</td>
          <td class="{{ 'pos' if a.active_change >= 0 else 'neg' }}"><b>{{ "%+.2f" | format(a.active_change) }}pp</b></td>
          <td class="muted">{{ a.flow_str }}</td>
          <td class="l">
            {% if a.ladder %}<span class="pill st-{{ a.ladder.state | replace(' ', '_') }}">{{ td(a.ladder.label) }}</span>{% if a.confirmed %} ✅{% endif %}{% else %}<span class="muted">—</span>{% endif %}{% if a.vol and a.vol.surging %} <span title="volume {{ a.vol.ratio }}× its recent average">📊</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </table>
      <p class="muted" style="font-size:12px;margin-top:8px">{{ t('“Active Δwt” strips out price: it is the percentage points of weight a name gained beyond what its own price move explains. On passive index ETFs this captures index reconstitution / float-weight flow, not a manager’s discretion. The estimated $ flow applies the active Δwt to the fund’s AUM and is approximate.', '“主动权重Δ”已剔除价格因素：它是个股权重增长中超出其自身价格涨幅所能解释的百分点。在被动指数 ETF 上，这反映的是指数再平衡／流通权重调整带来的资金流，而非经理人的主动决策。估算的美元资金流是将“主动权重Δ”乘以基金 AUM 得出的近似值。') }}</p>
    {% else %}
      <p class="muted">{{ t('Building — needs at least two daily holdings snapshots per fund (collection began 2026-06-11). Decomposed accumulation signals appear once a second snapshot lands.', '构建中 — 每只基金至少需要两个每日持仓快照（采集自 2026-06-11 开始）。第二个快照落地后将显示拆解后的增持信号。') }}</p>
    {% endif %}
  </div>

  <!-- ======================= HOLDINGS / FLOWS ======================= -->
  <div class="panel span12" id="holdings">
    <h2>{{ t("Real fund moves — strongest conviction", '基金真实动作 — 信念最强') }}
      {{ help("The top conviction-ranked ACCUMULATION decisions across curated thematic/industry funds (SPDR sector, Global X) and actively managed funds (ARK), with mechanical flow AND price moves stripped out. Conviction = percentage POINTS of fund weight the manager actually committed — so a real add to a meaningful position outranks a tiny position doubling. The full board (incl. trims & every fund) is the 🐳 Real fund moves page.", "在精选的主题／行业基金（SPDR 板块、Global X）与主动管理基金（ARK）中，按信念排序的最强增持决策，已剔除机械性资金流与价格变动。信念 = 经理人实际投入的基金权重百分点——因此对有意义仓位的真实增持会胜过微小仓位的翻倍。完整看板（含减持与全部基金）见 🐳 基金真实动作 页面。") }}
      <a href="etfs.html" class="muted" style="font-size:12px;font-weight:400;float:right">{{ t('see all →', '查看全部 →') }}</a>
    </h2>
    {% if holdings_changes %}
      <table>
        <tr><th class="l">{{ t('fund', '基金') }}</th><th class="l">{{ t('stock', '个股') }}</th><th class="l">{{ t('sector', '板块') }}</th><th class="r">{{ t('weight', '权重') }}</th><th class="r">{{ t('conviction Δwt', '信念权重Δ') }}</th><th class="l">{{ t('technical', '技术面') }}</th></tr>
        {% for h in holdings_changes %}
        <tr><td class="l"><b>{{ h.fund }}</b></td>
            <td class="l"><a href="stock.html#{{ h.ticker }}"><b>{{ h.ticker }}</b></a> <span class="muted">{{ h.name }}</span></td>
            <td class="l muted">{{ td(h.sector) if h.sector else "—" }}</td>
            <td class="r muted">{% if h.get('weight_pct') is not none %}{{ "%.2f" | format(h.weight_pct) }}%{% else %}—{% endif %}</td>
            <td class="r {{ ('pos' if h.conviction_pp >= 0 else 'neg') if h.get('conviction_pp') is not none else 'muted' }}"><b>{% if h.get('conviction_pp') is not none %}{{ "%+.2f" | format(h.conviction_pp) }}pp{% else %}—{% endif %}</b></td>
            <td class="l">{% if h.ladder %}<span class="pill st-{{ h.ladder.state | replace(' ', '_') }}">{{ td(h.ladder.label) }}</span>{% if h.confirmed %} ✅{% endif %}{% else %}<span class="muted">—</span>{% endif %}</td></tr>
        {% endfor %}
      </table>
    {% else %}
      <p class="muted">{{ t('No significant manager moves in the current window (needs a few trading days of snapshots).', '当前窗口内无显著的经理人动作（需要数个交易日的快照）。') }}</p>
    {% endif %}

    <h2 style="margin-top:16px">{{ t('Where ETF money is flowing', 'ETF 资金流向何处') }}
      {{ help("Daily money in/out of each sector's main ETF, from share creations/redemptions (ΔShares × price). Positive = money entering. History builds from June 2026.", "每个板块主力 ETF 的每日资金进出，来自份额的申购／赎回（份额变动 × 价格）。正值 = 资金进入。历史自 2026 年 6 月起累积。") }}
    </h2>
    {% if flows_html %}
      {{ flows_html | safe }}
    {% else %}
      <p class="muted">{{ t('Collecting — needs at least two daily snapshots per fund.', '采集中 — 每只基金至少需要两个每日快照。') }}</p>
    {% endif %}
  </div>

  <!-- ======================= HEALTH ======================= -->
  <div class="panel span12" id="health">
    <h2>{{ t('Data health', '数据健康度') }}
      {{ help("Every data source this dashboard depends on. OK = fresh. STALE = no new data lately (signal confidence reduced automatically). FAILED = today's fetch broke (yesterday's data still used). BLOCKED = a known, documented limitation — not a malfunction. DEAD = failed 3+ runs and paused until it recovers.", "本仪表盘所依赖的每个数据源。OK = 新鲜。STALE = 近期无新数据（信号置信度已自动下调）。FAILED = 今日抓取失败（仍沿用昨日数据）。BLOCKED = 已知且有记录的限制 — 并非故障。DEAD = 连续 3 次以上失败，已暂停直至恢复。") }}
    </h2>
    <table>
      <tr><th class="l">{{ t('source', '数据源') }}</th><th class="l">{{ t('status', '状态') }}</th><th>{{ t('rows', '行数') }}</th><th>{{ t('last data', '最新数据') }}</th><th class="l">{{ t('note', '备注') }}</th></tr>
      {% for s in health %}
      <tr>
        <td class="l">{{ s.name }}</td>
        <td class="l"><span class="pill pill-{{ s.status }}">{{ s.status }}</span></td>
        <td>{{ s.rows }}</td><td>{{ s.last_date or "—" }}</td>
        <td class="l muted">{{ s.error or "" }}</td>
      </tr>
      {% endfor %}
    </table>
