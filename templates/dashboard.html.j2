  body.page-macro .ms-drawer-empty{text-align:center;color:var(--ink-3);padding:46px 22px;font-size:13px;line-height:1.55}
  body.page-macro .ms-drawer-empty .big{font-size:38px;display:block;margin-bottom:10px;color:var(--up);opacity:.7}
  </style>
