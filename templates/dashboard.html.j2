  <style id="rr-css">
  /* ---- Release Radar MRI-R39: minimalist card + 5-tab modal ---- */
  /* 4px-base spacing scale; tabular-nums for all figures */
  #release-radar{padding:16px 20px 18px}
  #release-radar h2{margin:0 0 4px;font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px}
  #release-radar .rr-subline{font-size:11.5px;color:var(--muted);margin-bottom:14px}
  /* MRI-R39a: track-record top-right button */
  /* rr-tr-btn — gbtn glass recipe (macro sweep 2026-07); 44px touch target kept */
  .rr-tr-btn{margin-left:auto;flex-shrink:0;font-size:11px;font-weight:600;
    color:var(--muted);background:var(--gbtn-bg);border:1px solid var(--gbtn-brd);
    -webkit-backdrop-filter:blur(12px) saturate(140%);backdrop-filter:blur(12px) saturate(140%);
    box-shadow:inset 0 1px 0 var(--gbtn-sheen);
    border-radius:8px;padding:3px 9px;cursor:pointer;text-decoration:none;display:inline-flex;
    align-items:center;min-height:44px;min-width:44px;line-height:1.2;
    transition:border-color .2s ease,color .2s ease,background .2s ease,transform .16s ease,box-shadow .25s ease}
  .rr-tr-btn:hover{border-color:var(--gbtn-brd-hover);color:var(--text);background:var(--gbtn-bg-hover);transform:translateY(-1px);
    box-shadow:inset 0 1px 0 var(--gbtn-sheen),0 8px 20px -10px rgba(3,7,18,.55)}
  .rr-tr-btn:active{transform:translateY(0) scale(.985);box-shadow:inset 0 1px 0 var(--gbtn-sheen)}
  @media (prefers-reduced-motion: reduce){ .rr-tr-btn,.rr-tr-btn:hover,.rr-tr-btn:active{transform:none} }
  /* MRI-R39a: track-record panel-level overlay */
  .rr-tr-overlay{position:fixed;inset:0;z-index:1100;display:none;align-items:flex-end;
    background:color-mix(in srgb,var(--bg,#000) 55%,transparent)}
  .rr-tr-overlay.is-open{display:flex}
  .rr-tr-sheet{background:var(--panel);border-radius:16px 16px 0 0;width:100%;max-height:90vh;
