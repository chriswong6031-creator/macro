body.page-macro.mx4-grid .mx5-action-icon svg{width:16px;height:16px;}
body.page-macro.mx4-grid .mx5-ai-green{background:rgba(34,217,122,.10);}
body.page-macro.mx4-grid .mx5-ai-yellow{background:rgba(245,158,11,.10);}
body.page-macro.mx4-grid .mx5-ai-blue{background:rgba(129,140,248,.10);}
body.page-macro.mx4-grid .mx5-ai-gray{background:rgba(255,255,255,.06);}
[data-theme="light"] body.page-macro.mx4-grid .mx5-action-icon{border-color:rgba(0,0,0,.06);}
body.page-macro.mx4-grid .mx5-action-text{flex:1;}
body.page-macro.mx4-grid .mx5-action-label{
