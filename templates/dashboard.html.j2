  <a class="panel span12 aibrief-card" href="aibrief.html">
    <span class="abc-ic">🧠</span>
    <span class="abc-mid">
      <span class="abc-tit">{{ t('AI Daily Brief · cross-asset synthesis', 'AI 每日简报 · 跨资产综合') }}</span>
      <span class="abc-sub muted sm">{{ t('AI reads every dashboard in one place — the regime, where signals conflict, the rotation thesis and what to watch next. Research context only, never a signal.', 'AI 在一处解读每个看板 — 周期、信号冲突、轮动假设与后续关注。仅供研究参考，绝非交易信号。') }}</span>
