        <td style="font-size:12px">{{ r.osc_str }}</td>
        <td class="{% if r.rs_60d and r.rs_60d > 0 %}pos{% elif r.rs_60d and r.rs_60d < 0 %}neg{% endif %}" data-sort="{{ r.rs_60d or 0 }}">{{ r.rs_str }}</td>
        <td>
          <span class="help" style="width:auto;height:auto;border:none;margin:0">
            <span style="cursor:help">{{ r.season_str }}</span>
