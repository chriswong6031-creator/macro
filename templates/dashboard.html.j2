            </div>
          </div>
        </div>
        {% endif %}

        {# Row 5: policy — from flip_confirmation + policy_lever (v4 derivation) #}
        {% set _wtd_pl_quiet = (not (PL and PL.get('state') in ('ARMED','ELEVATED'))) %}
        <div class="mx5-action-item">
          <div class="mx5-action-icon mx5-ai-gray">
            <svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.38)" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="10"/>
