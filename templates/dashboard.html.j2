          <span class="muted sm" style="flex:0 0 96px;text-align:right">{{ '%+.2f'|format(leg.value) }} · {{ td(leg.lean) }}</span>
        </div>
        {% endfor %}
      </div>

      <!-- positioning + dislocation + capitulation -->
      <div class="span6" style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:12px 14px">
        {% if FE.positioning %}
