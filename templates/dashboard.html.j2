      <div class="dtp-body" id="dtp-body"></div>
      <div class="dtp-full" id="dtp-full" hidden></div>
      <button class="dtp-more" id="dtp-more" type="button" aria-expanded="false" hidden></button>
      <div class="dtp-fn" id="dtp-fn"></div>
    </div>
    {# TS-U3: Turn Watch strip → "Early turn signs" (user-first copy per docs/DESIGN_DOCTRINE.md;
       mode=stocks only; client-side).
       Shown ONLY when data exists: baskets with WATCH/IGNITION or ≥2 UPTURN_CONFIRMED members
       while slow reco is hold/avoid. Does NOT reorder lanes or change recos. #}
    <div id="dash-tw-strip" class="dash-tw-strip">
      <div class="dash-tw-hdr">
        <span class="dash-tw-title">{{ t('&#9889; Early turn signs','&#9889; 早期拐点迹象') }}</span>
        <span class="dash-tw-asof" id="dash-tw-asof"></span>
      </div>
      <div class="dash-tw-sub">{{ t("Bounce attempts in groups we still rate Hold / Avoid. Watch — don't chase.","仍评级为「持有／回避」的板块出现反弹尝试。观察为主 — 勿追高。") }}</div>
      <div class="dash-tw-rows" id="dash-tw-rows"></div>
      <div class="dash-tw-disc">
        <span class="l-en">Not a buy signal: in 26 past cases, about 6 in 10 of these early signs faded within a day. If the turn is real, the lanes below upgrade on their own.</span><span class="l-zh">非买入信号：历史26次中约六成的早期迹象在一天内消退。若拐点为真，下方泳道会自行升级。</span> <span class="help">?<span class="tip"><span class="l-en">Technical receipt: basket-level multi-timeframe turn meter; backtested edge at basket level = null (Oracle P8; T+1 fade base rate 58%, n=26). Slow reco labels unchanged; display tier only. Sources: turn_watch (basket K-of-N) + mtf_upturn (per-stock confluence).</span><span class="l-zh">技术说明：篮子级多时间框架拐点计量；篮子级回测优势为空值（Oracle P8；T+1消退基础概率58%，n=26）。慢速评级标签未变；仅展示层。数据源：turn_watch（篮子K-of-N）+ mtf_upturn（个股共振）。</span></span></span>
      </div>
    </div>
    {% endif %}
    {# Unified board: 🧩 narrative baskets (the AI-buildout-vs-rest resolution) lead each
       lane, 🏛 GICS sectors follow. Basket buys carry a leadership-LENS marker (≈, descriptive)
       and basket reduces a backtested marker (✓, the absolute-trend drawdown gate); ★ = in the
       narrative-rotation model book. #}
    {% macro themeitem(x) -%}
    <a class="actitem ai-theme" href="{{ x.href }}"><span class="ai-bdg" data-tip-en="Narrative basket — the narrative resolution (e.g. Memory & Storage), not the blurry GICS sector" data-tip-zh="叙事篮子 — 比 GICS 板块更精细的叙事分辨">🧩</span><b title="{{ x.name|e }}"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ x.name_zh or x.name }}</span></b>{% if x.book_wt %}<span class="ai-book" data-tip-en="In the narrative-rotation model book at {{ '%.0f'|format(x.book_wt*100) }}% — clears the backtested absolute-trend gate" data-tip-zh="已在叙事轮动模型组合中，权重 {{ '%.0f'|format(x.book_wt*100) }}%，通过经回测的绝对趋势门槛">★{{ '%.0f'|format(x.book_wt*100) }}%</span>{% endif %}{% if x.validated %}<span class="ai-val" data-tip-en="Backtested risk side — rides the absolute-trend / fading-deteriorating drawdown gate, the one multi-decade-measured edge" data-tip-zh="经回测的风险侧 — 绝对趋势／衰退-恶化回撤门槛">✓</span>{% else %}<span class="ai-lens" data-tip-en="Leadership LENS — descriptive (cross-sectional momentum rank-IC ≈ 0 on the clean backtest); a focus aid, not a return forecast" data-tip-zh="领先度透镜 — 描述性（横截面动量 rank-IC≈0），聚焦工具而非收益预测">≈</span>{% endif %}</a>
    {%- endmacro %}
    {# themeitem_run: on_the_run basket row with optional reason tooltip #}
    {% macro themeitem_run(x) -%}
    <a class="actitem ai-theme" href="{{ x.href }}"><span class="ai-bdg" data-tip-en="Narrative basket — in favour but no clean-entry setup" data-tip-zh="叙事篮子 — 顺势但无干净入场机会">🧩</span><b title="{{ x.name|e }}"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ x.name_zh or x.name }}</span></b>{% if x.get('run_reason_en') %}<span class="ai-lens" data-tip-en="{{ x.run_reason_en }}" data-tip-zh="{{ x.get('run_reason_zh') or x.run_reason_en }}">⟳</span>{% endif %}</a>
    {%- endmacro %}
    {# TS-R6 A2: two-reads chip for action-board sector rows (same ETF, two house reads disagree). #}
    {% macro ab_two_reads(x) -%}{% if x.get('two_reads_chip') %}{% set _abtr = x.two_reads_chip %}<span class="two-reads-chip" data-tip-en="Two house reads on {{ x.ticker }}: cycle timing = {{ _abtr.cycle_label_en }} (slow, cap-weighted); setup engine = {{ _abtr.setup_label_en }} (3-day tactical). Different instruments / different horizons — both shown, neither overrides." data-tip-zh="{{ x.ticker }} 两个本系统读数：周期 = {{ _abtr.cycle_label_en }}（慢速市值加权）；形态 = {{ _abtr.setup_label_en }}（3日战术）。不同工具／维度，同时显示。"><span class="tr-sep">⇔</span><span class="l-en">two reads: cycle <b>{{ _abtr.cycle_label_en }}</b> vs setup <b>{{ _abtr.setup_label_en }}</b></span><span class="l-zh">两个读数：周期 <b>{{ _abtr.cycle_label_en }}</b> vs 形态 <b>{{ _abtr.setup_label_en }}</b></span></span>{% endif %}{%- endmacro %}
    {# ew_chip is inlined below each sector row for Jinja2 lexer compatibility. #}
    {#- V2 ACTION BOARD — new lane design (adjudicated 2026-07-10)
        Each lane: header (emoji + EN/ZH name + count + subtitle) + row list.
        Sector rows: glyph + name + optional chip + optional gate-✓ + stat line.
        Theme rows: name + star/check/lens glyphs (% moves to popover).
        Popover data stored in hidden .rp-src span, cloned by theme.js row-pop engine on hover.
        Folds: take_profits cap 5, stand-aside (hold+avoid) cap 6.
        TS-R5 dash-hold-fold id PRESERVED on the stand-aside column.
    -#}
    {#- ---- Jinja macros for V2 rows ---- -#}
    {%- macro ab_chip(chip_en, chip_zh, chip_tone) -%}
    {%- if chip_en %}<span class="ab-chip ab-chip--{{ chip_tone }}"><span class="l-en">{{ chip_en }}</span><span class="l-zh">{{ chip_zh }}</span></span>{% endif -%}
    {%- endmacro -%}
    {%- macro ab_gate(x) -%}
    {%- if x.get('gate_override') %}<span class="ab-chip--gate" data-tip-en="Backtested drawdown-control gate fired — overrides the raw cycle read. Equal-weight basket: {{ x.get('ew', {}).get('label', '') }}" data-tip-zh="经回测的回撤控制门槛触发 — 覆盖原始周期判读。等权篮子：{{ x.get('ew', {}).get('label_zh', '') or x.get('ew', {}).get('label', '') }}">&#10003;</span>{% endif -%}
    {%- endmacro -%}
    {#- Popover source for a SECTOR row (hidden inline, cloned by JS) -#}
    {#- Conditions popover for a SECTOR row — shared .rp-src payload for theme.js row-pop engine.
        DO NOT REBUILD LAW #1513: FRESH BUY is the worst state on the board (not a buy edge);
        the state tag is rendered with a neutral/warn tone — never green/up. -#}
    {%- macro ab_sector_pop(x) -%}
    <span class="rp-src" hidden>
      <div class="row-pop-hd">
        <span class="row-pop-name"><span class="l-en">{{ x.name|e }}</span><span class="l-zh">{{ tr(x.name)|e }}</span></span>
        <span class="row-pop-kind">{{ x.ticker }}</span>
        {#- State tag tone: FRESH BUY/BOTTOM WATCH/NEARING A LOW = warn (not-yet-confirmed or worst state per #1513);
            TOP WATCH/ROLLING OVER/DECLINE/COUNTERTREND BOUNCE = dn; up ONLY for the explicit confirmed-uptrend
            labels — an unknown future label must fall to the neutral tag, never to green -#}
        {%- set _reduce_labels = ['TOP WATCH','ROLLING OVER','DECLINE','COUNTERTREND BOUNCE'] -%}
        {%- set _warn_labels = ['FRESH BUY','BOTTOM WATCH','NEARING A LOW'] -%}
        {%- set _up_labels = ['RALLY ON','TURN SIGNALED','UPTREND','BUY ZONE'] -%}
        {%- set _lbl = x.get('label', '') -%}
        {%- set _stag_tone = 'dn' if _lbl in _reduce_labels else ('warn' if _lbl in _warn_labels else ('up' if _lbl in _up_labels else '')) -%}
        <span class="row-pop-tag {{ _stag_tone }}">{{ td(x.label) }}</span>
      </div>
      <div class="row-pop-div"></div>
      <div class="row-pop-grid">
        {%- if x.get('age_short') %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Signal age</span><span class="l-zh">信号龄</span></span>
          <span class="row-pop-val"><span class="l-en">{{ x.age_short }}</span><span class="l-zh">{{ x.get('age_short_zh', x.age_short) }}</span></span></div>
        {%- endif %}
        {%- if x.get('eq_badge') %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Entry quality</span><span class="l-zh">入场质量</span></span>
          <span class="row-pop-val"><span class="{{ 'up' if x.eq_dir == 'up' else ('dn' if x.eq_dir == 'down' else '') }}">{{ x.eq_badge }}</span><span class="mut"> · <span class="l-en">{{ x.eq_tip }}</span><span class="l-zh">{{ x.get('eq_tip_zh', x.eq_tip) }}</span></span></span></div>
        {%- endif %}
        {%- if x.get('rs_60d') is not none and x.get('rs_60d') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">60d RS vs SPY</span><span class="l-zh">60日RS对SPY</span></span>
          <span class="row-pop-val"><span class="{{ 'up' if x.rs_60d >= 0 else 'dn' }}">{{ '%+.1f'|format(x.rs_60d) }}%</span></span></div>
        {%- endif %}
        {%- if x.get('dc_day') is not none and x.get('dc_day') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Cycle position</span><span class="l-zh">周期位置</span></span>
          <span class="row-pop-val"><span class="l-en">day {{ x.dc_day }} of cycle</span><span class="l-zh">周期第 {{ x.dc_day }} 日</span></span></div>
        {%- endif %}
        {%- if x.get('buy_zone') is not none and x.get('n_holdings') %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Holdings in buy zone</span><span class="l-zh">买入区持仓</span></span>
          <span class="row-pop-val">{{ x.buy_zone }} / {{ x.n_holdings }}</span></div>
        {%- endif %}
        {%- if x.get('rsi_3d') is not none and x.get('rsi_3d') is defined and x.get('stoch_3d') is not none and x.get('stoch_3d') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">3D oscillators</span><span class="l-zh">3日摆动</span></span>
          <span class="row-pop-val">RSI {{ '%.0f'|format(x.rsi_3d) }} · Stoch {{ '%.0f'|format(x.stoch_3d) }}</span></div>
        {%- endif %}
        {%- if x.get('rate_str') is not none and x.get('rate_str') is defined %}
        <div class="row-pop-cell wide"><span class="row-pop-lbl"><span class="l-en">Fwd 63d base rate</span><span class="l-zh">63日基础胜率</span></span>
          <span class="row-pop-val {{ 'up' if x.get('rate_pos') else ('dn' if x.get('rate_pos') is not none and not x.get('rate_pos') else '') }}">{{ x.rate_str }}</span></div>
        {%- endif %}
        {%- if x.get('season_str') is not none and x.get('season_str') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Seasonality</span><span class="l-zh">季节性</span></span>
          <span class="row-pop-val">{{ x.season_str }}</span></div>
        {%- endif %}
      </div>
      {%- if x.get('text') or x.get('text_zh') or x.get('two_reads_chip') %}
      <ul class="row-pop-why">
        {%- if x.get('text') or x.get('text_zh') %}
        <li><span class="l-en">{{ x.get('text', '')|e }}</span><span class="l-zh">{{ x.get('text_zh', '')|e }}</span></li>
        {%- endif %}
        {%- if x.get('two_reads_chip') %}
        {%- set _tr2 = x.two_reads_chip %}
        <li><span class="l-en">Two reads: cycle <b>{{ _tr2.cycle_label_en }}</b> vs setup <b>{{ _tr2.setup_label_en }}</b></span><span class="l-zh">两个读数：周期 <b>{{ _tr2.get('cycle_label_zh', _tr2.cycle_label_en) }}</b> vs 形态 <b>{{ _tr2.get('setup_label_zh', _tr2.setup_label_en) }}</b></span></li>
        {%- endif %}
      </ul>
      {%- endif %}
      <div class="row-pop-ft">
        <span>{{ x.ticker }}</span>
      </div>
    </span>
    {%- endmacro -%}
    {#- Conditions popover for a THEME (narrative basket) row — shared .rp-src payload. -#}
    {%- macro ab_theme_pop(x) -%}
    <span class="rp-src" hidden>
      <div class="row-pop-hd">
        <span class="row-pop-name"><span class="l-en">{{ x.name|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
        <span class="row-pop-kind"><span class="l-en">BASKET</span><span class="l-zh">篮子</span></span>
        {%- set _rtone = 'dn' if x.get('reco') in ('trim','avoid') else ('up' if x.get('reco') in ('accumulate','enter') else 'warn') -%}
        <span class="row-pop-tag {{ _rtone }}"><span class="l-en">{{ x.get('label', x.get('reco', '')) }}</span><span class="l-zh">{{ x.get('label_zh', x.get('label', '')) }}</span></span>
      </div>
      <div class="row-pop-div"></div>
      <div class="row-pop-grid">
        {%- if x.get('score') is not none and x.get('score') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Composite score</span><span class="l-zh">综合评分</span></span>
          <span class="row-pop-val">{{ '%.0f'|format(x.score) }}</span></div>
        {%- endif %}
        {%- if x.get('book_wt') is not none and x.get('book_wt') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Model book</span><span class="l-zh">模型组合</span></span>
          <span class="row-pop-val up">{{ '%.0f'|format(x.book_wt*100) }}%</span></div>
        {%- endif %}
        {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">20d vs market</span><span class="l-zh">20日对比市场</span></span>
          <span class="row-pop-val"><span class="{{ 'up' if x.perf_20d_rel >= 0 else 'dn' }}">{{ '%+.1f'|format(x.perf_20d_rel * 100) }}%</span></span></div>
        {%- endif %}
        {%- if x.get('breadth_pct50') is not none and x.get('breadth_pct50') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Breadth &gt;50d</span><span class="l-zh">广度&gt;50日</span></span>
          <span class="row-pop-val">{{ '%.0f'|format(x.breadth_pct50 * 100) }}%</span></div>
        {%- endif %}
        {%- if x.get('rs_pctile') is not none and x.get('rs_pctile') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">RS percentile</span><span class="l-zh">RS分位</span></span>
          <span class="row-pop-val">{{ '%.0f'|format(x.rs_pctile * 100) }}</span></div>
        {%- endif %}
        {%- if x.get('flip_distance') is not none and x.get('flip_distance') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Flip distance</span><span class="l-zh">翻转距离</span></span>
          <span class="row-pop-val">{{ '%.1f'|format(x.flip_distance) }}%</span></div>
        {%- endif %}
        {%- if x.get('rollover_band') is not none and x.get('rollover_band') is defined %}
        <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Rollover risk</span><span class="l-zh">回落风险</span></span>
          <span class="row-pop-val {{ 'warn' if x.rollover_band != 'low' else '' }}"><span class="l-en">{{ x.rollover_band }}</span><span class="l-zh">{{ x.get('rollover_band_zh', x.rollover_band) }}</span></span></div>
        {%- endif %}
        {%- if x.get('top_members') %}
        <div class="row-pop-cell wide"><span class="row-pop-lbl"><span class="l-en">Leaders</span><span class="l-zh">龙头</span></span>
          <span class="row-pop-val">{{ x.top_members | join(' · ') }}</span></div>
        {%- endif %}
        {%- if x.validated %}
        <div class="row-pop-cell wide"><span class="row-pop-lbl"><span class="l-en">Gate</span><span class="l-zh">门槛</span></span>
          <span class="row-pop-val up"><span class="l-en">&#10003; Backtested absolute-trend gate</span><span class="l-zh">&#10003; 经回测绝对趋势门槛</span></span></div>
        {%- endif %}
      </div>
      {%- if x.get('reco_why_en') or x.get('run_reason_en') %}
      <ul class="row-pop-why">
        {%- if x.get('reco_why_en') %}
        <li><span class="l-en">{{ x.reco_why_en|e }}</span><span class="l-zh">{{ x.get('reco_why_zh', x.reco_why_en)|e }}</span></li>
        {%- endif %}
        {%- if x.get('run_reason_en') %}
        <li><span class="l-en">{{ x.run_reason_en|e }}</span><span class="l-zh">{{ x.get('run_reason_zh', x.run_reason_en)|e }}</span></li>
        {%- endif %}
      </ul>
      {%- endif %}
    </span>
    {%- endmacro -%}
    {#- V2 sector row macro -#}
    {%- macro ab_sector_row(x) -%}
    <a class="actitem" data-rpop href="{{ x.href }}">
      <span class="ai-bdg">🏛</span>
      <span class="act-row-main">
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ tr(x.name)|e }}</span></span>
        {%- if x.get('stat_en') %}<span class="act-row-stat"><span class="l-en">{{ x.stat_en }}</span><span class="l-zh">{{ x.get('stat_zh', x.stat_en) }}</span></span>{%- endif %}
      </span>
      <span class="act-row-chips">
        {{- ab_chip(x.get('chip_en',''), x.get('chip_zh',''), x.get('chip_tone','muted')) -}}
        {{- ab_gate(x) -}}
      </span>
      {{ ab_sector_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- V2 theme (narrative basket) row macro -#}
    {%- macro ab_theme_row(x) -%}
    <a class="actitem ai-theme" data-rpop href="{{ x.href }}">
      <span class="ai-bdg">🧩</span>
      <span class="act-row-main">
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
      </span>
      <span class="act-row-chips">
        {%- if x.get('book_wt') %}<span class="ai-book" data-tip-en="In the narrative-rotation model book at {{ '%.0f'|format(x.book_wt*100) }}% — clears the backtested absolute-trend gate" data-tip-zh="已在叙事轮动模型组合中，权重 {{ '%.0f'|format(x.book_wt*100) }}%，通过经回测的绝对趋势门槛">&#9733;{{ '%.0f'|format(x.book_wt*100) }}%</span>{%- endif %}
        {%- if x.validated %}<span class="ai-val" data-tip-en="Backtested risk side — absolute-trend / fading-deteriorating drawdown gate" data-tip-zh="经回测的风险侧 — 绝对趋势／衰退-恶化回撤门槛">&#10003;</span>{%- else %}<span class="ai-lens" data-tip-en="Leadership LENS — descriptive; cross-sectional momentum rank-IC &asymp;0" data-tip-zh="领先度透镜 — 描述性；横截面动量 rank-IC&asymp;0">&asymp;</span>{%- endif %}
        {%- if x.get('run_reason_en') %}<span class="ai-lens" data-tip-en="{{ x.run_reason_en }}" data-tip-zh="{{ x.get('run_reason_zh', x.run_reason_en) }}">&#8635;</span>{%- endif %}
      </span>
      {{ ab_theme_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- Lane count helpers -#}
    {%- set _bn_cnt = action_board.buy_now | length -%}
    {%- set _bs_cnt = action_board.buy_soon | length -%}
    {%- set _run_cnt = action_board.get('on_the_run', []) | length -%}
    {%- set _tp_cnt = action_board.take_profits | length -%}
    {%- set _hold_cnt = (action_board.hold | length) + (action_board.avoid | length) -%}
    <div class="actiongrid">
      {#- ---- LANE 1: BUY NOW ---- -#}
      <div class="actcol act-buy">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🟢</span>
            <span class="acth-name"><span class="l-en">Buy now</span><span class="l-zh">立即买入</span></span>
            <span class="acth-count">{{ _bn_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Entry confirmed today</span><span class="l-zh">今日已确认入场</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-buy-fold">
          {% for x in action_board.buy_now %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
        </div>
        {% if _bn_cnt > 6 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bn_cnt - 6 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 2: ALMOST READY (buy_soon) ---- -#}
