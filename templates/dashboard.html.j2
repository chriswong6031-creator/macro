  --island-shadow-ambient:0 36px 90px -18px rgba(0,0,0,.40);
}
[data-theme="light"] body.page-macro,[data-theme="light"].page-macro{
  --island-shadow-tight:0 2px 8px rgba(20,30,50,.12);
