          {% endif %}
          {# name-specific notes (expander per spec §4) — needs c #}
          {% if c and c.notes %}{% for nt in c.notes if nt.kind != 'rank' %}<div class="nb-note nb-note-{{ nt.kind }}"><span class="l-en">ℹ {{ nt.en }}</span><span class="l-zh">ℹ {{ nt.zh }}</span></div>{% endfor %}{% endif %}
          {# B2+B3: Buy Decision Packet dossier (server-rendered, fail-soft on absence). #}
          {# Absent on older artifacts or non-US boards — renders nothing if dossier missing. #}
          {% set _dos = n.get('dossier') %}
          {% if _dos %}
          <div class="nb-dossier">
