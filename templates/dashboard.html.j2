        <div style="font-weight:700;margin-bottom:4px">{{ t('Positioning vs price', '持仓与价格') }}
          <span class="badge" style="font-size:11px;background:var(--panel);float:right">
            {% if P.chip=='confirms' %}{{ t('positioning confirms', '持仓与价格一致') }}
            {% elif P.chip=='diverges' %}{{ t('positioning diverges', '持仓与价格背离') }}
            {% else %}{{ t('positioning mixed', '持仓信号混杂') }}{% endif %}</span>
          {{ help("A DESCRIPTIVE read of whether smart-money positioning agrees with the price trend — never a buy/sell. Bullish if COT speculators are washed out OR insider Form-4 breadth is net-buying; bearish if COT is crowded long OR insiders are net-selling. 'Confirms' = positioning leans the same way price is trending; 'diverges' = the opposite; 'mixed' when the two positioning sources disagree.", "对聪明钱持仓是否与价格趋势一致的描述性读数 — 绝非买卖建议。当 COT 投机者被清洗 或 内部人 Form-4 净买入时偏多；当 COT 拥挤做多 或 内部人净卖出时偏空。'一致'＝持仓方向与价格趋势相同；'背离'＝相反；当两个持仓来源不一致时为'混杂'。") }}</div>
        <div class="muted sm">{{ t('COT spec', 'COT 投机') }}: {% if P.cot_washed_out %}{{ t('washed out', '已清洗') }}{% elif P.cot_crowded_long %}{{ t('crowded long', '拥挤做多') }}{% else %}{{ t('neutral', '中性') }}{% endif %}
          · {{ t('insider breadth', '内部人广度') }} {{ '%+.0f'|format(P.insider_breadth * 100) }}%
          · {{ t('price', '价格') }} {{ t('up', '上行') if P.price_up else t('down', '下行') }}</div>
        {% endif %}

        {% if DL %}
        <div class="kv" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--line)">{{ t('Dislocation read', '错位读数') }}
          <b style="float:right">{{ td(DL.verdict) }}</b></div>
        <div class="muted sm">{{ t('Fed put', '美联储托底') }}: <b>{{ td(DL.put_state) if DL.put_state else (t('Put present','托底在位') if DL.fed_put else t('Put ABSENT','托底缺失')) }}</b>
          {% if DL.inputs and DL.inputs.spy_drawdown_pct is not none %} · {{ t('S&P drawdown', '标普回撤') }} {{ DL.inputs.spy_drawdown_pct }}%{% endif %}</div>
        {% if DL.capitulation_caveat %}<div class="sm" style="margin-top:4px;color:var(--muted)">⚠ {{ DL.capitulation_caveat }}</div>{% endif %}
        {% endif %}

        {% if FCAP and FCAP.score is not none %}
        <div class="kv" style="margin-top:8px">{{ t('Capitulation', '投降') }}
          <b style="float:right">{{ FCAP.score }}/3 {{ t('signals', '信号') }}</b></div>
        {% if FCAP.signals_firing %}<div class="muted sm">{{ FCAP.signals_firing | join(' · ') }}</div>{% endif %}
        {% if FCAP.measured_bounce_pct is not none %}<div class="muted sm">{{ t('measured bounce', '实测反弹') }} {{ '%+.1f'|format(FCAP.measured_bounce_pct) }}% ({{ FCAP.measured_hit_pct }}% {{ t('hit', '命中') }})</div>{% endif %}
        {% endif %}

        {# Complacency / hidden-fragility — the euphoria-side MIRROR of the
           capitulation block above. Display-only conjunction (calm AND weak),
           neutral styling, never scored. #}
        {% if FCOMP and FCOMP.state %}
        {% set _cl = [] %}
        {% if FCOMP.vix_low %}{% set _ = _cl.append(t('VIX low', 'VIX 偏低')) %}{% endif %}
        {% if FCOMP.contango %}{% set _ = _cl.append(t('steep contango', '陡峭正向')) %}{% endif %}
        {% set _fl = [] %}
        {% if FCOMP.breadth_div %}{% set _ = _fl.append(t('breadth not confirming', '广度未确认')) %}{% endif %}
        {% if FCOMP.credit_widen %}{% set _ = _fl.append(t('HY credit widening', '高收益走阔')) %}{% endif %}
        <div class="kv" style="margin-top:8px;padding-top:8px;border-top:1px solid var(--line)">{{ t('Complacency', '自满') }}
          {{ help("The euphoria-side MIRROR of the capitulation gauge. Capitulation marks extreme fear (a measured bounce); this marks the opposite tail — a CALM surface (VIX in the bottom quartile of its 2-year range, a steep-contango term structure) sitting over WEAKENING internals (the index near its 1-year high while fewer stocks hold their 200-day average, and high-yield credit quietly widening). 'Hidden fragility' fires ONLY on the conjunction — calm AND weak together. It is NOT a timing signal and is never scored: a low VIX is persistent and roughly neutral for forward returns, and the fragility only bites when a catalyst arrives. Context for position-sizing humility, not a sell.", "投降指标的欣喜一侧镜像。投降标记极端恐惧（实测反弹）；本指标标记相反一端 — 平静的表象（VIX 处于两年区间最低四分位、陡峭的正向期限结构）叠加走弱的内部结构（指数接近一年高点，但守住 200 日均线的个股越来越少，且高收益信用悄然走阔）。'隐性脆弱'仅在两者同时出现时触发 — 又平静又虚弱。它不是择时信号，也从不参与评分：低 VIX 具有持续性、对未来收益大致中性，脆弱只有催化剂到来时才发作。它用于仓位上的谦逊，而非卖出建议。") }}
          <b style="float:right">{% if FCOMP.state=='hidden_fragility' %}⚠ {{ t('hidden fragility', '隐性脆弱') }}{% elif FCOMP.state=='watch' %}{{ t('watch', '留意') }}{% elif FCOMP.state=='calm' %}{{ t('calm', '平静') }}{% else %}{{ t('neutral', '中性') }}{% endif %}</b></div>
        {% if FCOMP.warning %}
        <div class="muted sm">{{ _cl|join(' · ') }} <span style="opacity:.55">{{ t('over', '叠加') }}</span> {{ _fl|join(' · ') }}</div>
        {% elif FCOMP.state=='calm' %}
        <div class="muted sm">{{ _cl|join(' · ') if _cl else t('calm surface', '表象平静') }} · {{ t('internals confirming', '内部确认') }}</div>
        {% endif %}
        <div class="muted sm" style="margin-top:1px">
          {%- if FCOMP.vix_pctile is not none %}VIX {{ (FCOMP.vix_pctile*100)|round|int }}%ile{% endif %}
          {%- if FCOMP.vix_term is not none %} · vix/3m {{ '%.2f'|format(FCOMP.vix_term) }}{% endif %}
          {%- if FCOMP.breadth_above200_pctile is not none %} · %&gt;200dma {{ (FCOMP.breadth_above200_pctile*100)|round|int }}%ile{% endif %}
          {%- if FCOMP.hy_oas_chg_21d_bp is not none %} · HY {{ '%+.0f'|format(FCOMP.hy_oas_chg_21d_bp) }}bp/mo{% endif %}
        </div>
        <div class="muted sm" style="margin-top:2px">{{ t('Display-only mirror of capitulation — never scored.', '投降指标的纯展示镜像 — 从不评分。') }}</div>
        {% endif %}

        {% if latest.cross_asset and latest.cross_asset.get('absorption_ratio') is not none %}
        <div class="kv" style="margin-top:8px">{{ t('Cross-asset absorption', '跨资产吸收') }}
          <b style="float:right">{{ '%.2f'|format(latest.cross_asset.absorption_ratio) }}{% if latest.cross_asset.get('verdict') %} · {{ td(latest.cross_asset.verdict) }}{% endif %}</b></div>
        {% endif %}
      </div>

    </div>
    {% else %}
    <p class="muted">{{ t('Building…', '构建中…') }}</p>
    {% endif %}
  </div>
  {% endif %}{# /fear-euphoria — macro only #}

  <!-- ======================= ACTION BOARD ======================= -->
  {% if mode != 'macro' %}
  {% if action_board %}
  <div class="panel span12">
    <h2>⚡ {{ t('What to act on now', '当前可操作') }}
      {{ help("Your at-a-glance starting point — now spanning BOTH 🧩 narrative baskets (Memory & Storage, Non-AI Software, …) and 🏛 GICS sectors, because 'Technology' blends generational winners (memory/semis) with names being obliterated (non-AI software). Baskets give the narrative resolution sectors can't. HONESTY: a basket on the BUY side is a leadership LENS (≈), descriptive — cross-sectional momentum rank-IC is ~0 on the clean multi-decade backtest, so it focuses attention, it is not a return forecast. A basket on the REDUCE side carries a VALIDATED mark (✓): it rides the absolute-trend / fading-deteriorating drawdown gate, the one backtested edge (it roughly halved drawdown over 27y). ★ = currently in the narrative-rotation model book. Sectors keep their price-cycle read. Click any name for the full breakdown.", "你的一眼总览起点 — 现同时覆盖🧩叙事篮子（内存与存储、非AI软件…）与🏛GICS板块，因为“科技”把世代赢家（内存/半导体）与被血洗的标的（非AI软件）混为一谈。篮子提供板块无法给出的叙事分辨。诚实说明：买入侧的篮子是领先度透镜（≈），描述性 — 横截面动量 rank-IC≈0（多年期干净回测），用于聚焦而非预测收益。减仓侧的篮子带已验证标记（✓）：依托绝对趋势／衰退-恶化回撤门槛，这是唯一经回测的优势（27年里大致将回撤减半）。★＝当前在叙事轮动模型组合中。板块保留其价格周期判读。点击任意名称查看完整拆解。") }}
    </h2>
    {# Unified board: 🧩 narrative baskets (the AI-buildout-vs-rest resolution) lead each
       lane, 🏛 GICS sectors follow. Basket buys carry a leadership-LENS marker (≈, descriptive)
       and basket reduces a VALIDATED marker (✓, the absolute-trend drawdown gate); ★ = in the
       narrative-rotation model book. #}
    {% macro themeitem(x) -%}
    <a class="actitem ai-theme" href="{{ x.href }}"><span class="ai-bdg" title="Narrative basket — the narrative resolution (e.g. Memory & Storage), not the blurry GICS sector · 叙事篮子 — 比 GICS 板块更精细的叙事分辨">🧩</span><b><span class="l-en">{{ x.name }}</span><span class="l-zh">{{ x.name_zh or x.name }}</span></b>{% if x.book_wt %}<span class="ai-book" title="In the narrative-rotation model book at {{ '%.0f'|format(x.book_wt*100) }}% — clears the validated absolute-trend gate · 已在叙事轮动模型组合中，权重 {{ '%.0f'|format(x.book_wt*100) }}%，通过已验证的绝对趋势门槛">★{{ '%.0f'|format(x.book_wt*100) }}%</span>{% endif %}{% if x.validated %}<span class="ai-val" title="Validated risk side — rides the absolute-trend / fading-deteriorating drawdown gate, the one multi-decade-backtested edge · 已验证的风险侧 — 绝对趋势／衰退-恶化回撤门槛">✓</span>{% else %}<span class="ai-lens" title="Leadership LENS — descriptive (cross-sectional momentum rank-IC ≈ 0 on the clean backtest); a focus aid, not a return forecast · 领先度透镜 — 描述性（横截面动量 rank-IC≈0），聚焦工具而非收益预测">≈</span>{% endif %}</a>
    {%- endmacro %}
    <div class="actiongrid">
      <div class="actcol act-buy">
        <div class="acth">🟢 {{ t('BUY ZONE — confirmed now', '买入区 — 已确认') }}</div>
        {% for x in action_board.buy_now %}
          {% if x.kind == 'theme' %}{{ themeitem(x) }}{% else %}<a class="actitem" href="{{ x.href }}"><span class="ai-bdg" title="GICS sector">🏛</span><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.age_short %}<span class="actage">⏱ {{ t(x.age_short, x.age_short_zh) }}</span>{% endif %}{% if x.eq_badge %}<span class="eqmini eq-{{ x.eq_dir }}" title="{{ x.eq_tip }}">{{ x.eq_badge }}</span>{% endif %}<span class="acttag">{{ td(x.label) }}</span></a>{% endif %}
        {% else %}<p class="muted sm">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-soon">
        <div class="acth">🔵 {{ t('SETTING UP — buy soon', '构筑中 — 即将买入') }}</div>
        {% for x in action_board.buy_soon %}
          {% if x.kind == 'theme' %}{{ themeitem(x) }}{% else %}<a class="actitem" href="{{ x.href }}"><span class="ai-bdg" title="GICS sector">🏛</span><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.get('days') is not none %}<span class="acteta">~{{ x.days }}d</span>{% endif %}</a>{% endif %}
        {% else %}<p class="muted sm">{{ t('No imminent setups.', '暂无临近的构筑。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-trim">
        <div class="acth">🟠 {{ t('TAKE PROFITS / topping', '止盈／做顶') }}</div>
        {% for x in action_board.take_profits %}
          {% if x.kind == 'theme' %}{{ themeitem(x) }}{% else %}<a class="actitem" href="{{ x.href }}"><span class="ai-bdg" title="GICS sector">🏛</span><b>{{ td(x.name) }}</b> <span class="muted">{{ x.ticker }}</span>{% if x.age_short %}<span class="actage">⏱ {{ t(x.age_short, x.age_short_zh) }}</span>{% endif %}{% if x.eq_badge %}<span class="eqmini eq-{{ x.eq_dir }}" title="{{ x.eq_tip }}">{{ x.eq_badge }}</span>{% endif %}<span class="acttag">{{ td(x.label) }}</span></a>{% endif %}
        {% else %}<p class="muted sm">{{ t('Nothing topping.', '无标的做顶。') }}</p>{% endfor %}
      </div>
      <div class="actcol act-hold">
        <div class="acth">⚪ {{ t('HOLD / avoid', '持有／回避') }}</div>
        {% for x in action_board.hold %}
          {% if x.kind == 'theme' %}{{ themeitem(x) }}{% else %}<a class="actitem" href="{{ x.href }}"><span class="ai-bdg" title="GICS sector">🏛</span><b>{{ td(x.name) }}</b> <span class="muted">{{ t("hold — don't chase", '持有 — 勿追高') }}</span></a>{% endif %}
        {% endfor %}
        {% for x in action_board.avoid %}
          {% if x.kind == 'theme' %}{{ themeitem(x) }}{% else %}<a class="actitem" href="{{ x.href }}"><span class="ai-bdg" title="GICS sector">🏛</span><b>{{ td(x.name) }}</b> <span class="muted">{{ t("wait", '等待') if x.tag == "WAIT" else t("avoid", '回避') }}</span></a>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% set _su = us_standouts if (us_standouts and us_standouts.buy) else None %}
    {% if _su or action_board.notable %}
    <div class="notable">
      <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
        <span style="font-weight:700;font-size:13px">{{ t('Standout individual stocks', '表现突出的个股') }}</span>
        {% if _su %}<span class="muted" style="font-size:11.5px">{{ _su.buy|length }} {{ t('shown ·', '已显示 ·') }} {{ _su.eligible }} {{ t('fully aligned across weekly · 3-day · daily (bottoming, not a falling knife) · TWO gauges per card: an OWN-IT conviction score (leadership · quality · valuation) and a separate ENTRY gauge — buy now, or wait for the pullback to $X. A high score is NOT a buy-now; the green dot means the entry is open today.', '在周线·3日·日线上完全共振（筑底，而非接飞刀）· 每张卡片两个量表：持有信念分（领先·质量·估值）+ 独立的入场量表 — 立即买入，或等待回撤至某价位。高分并不等于立即买入；绿点代表今日入场窗口已开。') }}
          {{ help("Each name carries TWO independent gauges so a great company is never confused with a great entry. (1) OWN-IT CONVICTION (the 0-100 score): leadership (validated sector-neutral residual momentum α across the S&P 1500) + quality + a forward-aware valuation read — a cheap-on-forward leader like NVDA is NOT penalized for a rich trailing multiple. It surfaces leaders that aren't in any sector ETF's top-10. It is a within-market percentile DISPLAY skin (not a probability) and reads 'high-confluence (context)' until a deep Phase-0 proves forward edge; the α leg is just one light, regime-scaled input, not the rank key. (2) ENTRY TIMING (the coloured strip): the price-cycle read across daily/3-day/weekly — buy now (green dot), wait for the pullback to the shown buy-zone price, or extended/topping (don't chase). Two VERIFIERS — an Options (dealer-gamma) check and a single-stock volatility-squeeze read — sharpen the ENTRY only (display + a small bounded tilt); they can lower conviction but never manufacture a buy, and never touch the selection rank. The price-cycle state is a HARD modifier: a name late in its cycle, in a downtrend or topping, can NEVER read 'buy now' — it reads 'strong name, wrong tape', which is why this card and the stock's own page never disagree. The board is sorted by conviction; the entry gauge tells you which are actionable today. Click any card for the full breakdown.", "每个标的带有两个相互独立的量表，使“好公司”绝不等同于“好入场点”。(1) 持有信念（0-100 分）：领先度（在标普1500内已验证的行业中性残差动量 α）+ 质量 + 前瞻估值读数——像 NVDA 这种前瞻便宜的领涨股不会因偏高的历史倍数而被扣分。它能发掘不在任何行业ETF前十大持仓中的领涨股。它是市场内百分位的展示皮肤（非概率），在深度 Phase-0 证明前瞻优势前显示为“高共振（参考）”；α 维度只是一个轻量、随行情缩放的输入，并非排序关键。(2) 入场择时（彩色条）：跨日线/3日/周线的价格周期读数——立即买入（绿点）、等待回撤至所示买入区价位，或过度拉伸/做顶（勿追高）。两个验证器——期权（做市商 Gamma）检查与个股波动压缩读数——只优化“入场”（展示＋小幅有界倾斜）；它们可降低确信度，但绝不制造买入信号，也不触及选股排序。价格周期状态是硬性修正项：处于周期晚期、下行或做顶的个股永远不会显示“立即买入”，而显示“强势但趋势不利”，因此本卡片与个股自身页面绝不冲突。榜单按信念排序；入场量表告诉你今天哪些可操作。点击任意卡片查看完整拆解。") }}</span>{% endif %}
        {% if not _su %}<span class="muted" style="font-size:11.5px">{{ t('from each sector’s top-10 holdings · grouped by cycle entry, ranked by sector-neutral momentum (α)', '来自各板块前十大持仓 · 按周期入场分组，以行业中性动量（α）排序') }}
          {{ help("Every sector ETF's top-10 holdings are run through the SAME price-cycle engine as the sectors. A name earns a card only when its cycle signal is decisive — a confirmed buy (BUY ZONE), an imminent turn (BOTTOMING), or a sell (TOPPING). The cycle state GROUPS the cards (it places risk — a defined entry + exit); WITHIN each group they're ordered by the validated sector-neutral residual momentum (α — market + sector beta stripped). We Phase-0 tested blending the cycle timing INTO the rank (reports/setup-score-phase0.md, survivorship-clean S&P 500, 12y) and it did NOT improve forward returns — it diluted α — so the order rides α and the cycle/pullback is shown as risk-placement CONTEXT, not a return signal. A soft per-sector cap keeps one hot sector from crowding the board. The α / #rank / pullback line and the 👤 insider chip are context inputs, NOT standalone buy signals. Click any card for the full breakdown.", "每个板块 ETF 的前十大持仓都用与板块相同的价格周期引擎分析。只有当个股的周期信号具决定性时才会获得卡片 — 已确认买入（买入区）、即将转向（筑底）或卖出（做顶）。周期状态对卡片进行分组（它摆放风险 — 明确的入场与出场）；在每组内部，按已验证的行业中性残差动量（α — 已剥离大盘与行业 beta）排序。我们做了 Phase-0 检验，把周期择时混入排序（reports/setup-score-phase0.md，无幸存者偏差的标普500，12年），结果并未改善前瞻收益 — 反而稀释了 α — 因此排序以 α 为准，周期/回调作为风险摆位的情境展示，而非收益信号。软性的单一板块上限可避免强势板块挤占整版。卡片上的 α / #排名 / 回调一行以及 👤 内部人买入标记均为情境输入，并非独立买入信号。点击任意卡片查看完整拆解。") }}</span>{% endif %}
      </div>
      {% if _su and _su.buy %}{% set _tt = (_su.buy[0].conviction or {}).trust_tier %}
      <div class="nb-legend">
        <span class="lg-k">{{ t('Reading the cards', '如何看卡片') }}</span>
        <span><b>{{ t('Score', '评分') }}</b> = {{ t('within-board percentile RANK (today’s board), not an absolute 0–100 — the verdict is the absolute read.', '板内百分位排名（今日榜单），并非绝对 0–100 — 结论才是绝对读数。') }}</span>
        {% if _tt %}<span class="lg-sep">·</span><span><b>{{ t('Edge basis', '优势来源') }}</b>: <span class="l-en">{{ _tt.en }}</span><span class="l-zh">{{ _tt.zh }}</span></span>{% endif %}
      </div>
      {% endif %}
      {% if market_gamma %}
      <div class="gamma-note gn-{{ market_gamma.regime }}">
        {% if market_gamma.regime == 'short' %}<span class="gn-ic">🌀</span>
          <b>{{ t('Short-gamma market', '空头 Gamma 市场') }}</b> — {{ t('S&P 500 trades', '标普500 现') }} {{ '%.1f'|format(market_gamma.spot_vs_flip_pct | abs) }}% {{ t('below its dealer gamma-flip', '低于做市商 Gamma 翻转位') }} ({{ market_gamma.flip }}): {{ t('dealer hedging AMPLIFIES moves — momentum extends but reversals snap back hard. Wider stops; don’t chase entries.', '做市商对冲会放大波动 — 动量延伸但反转剧烈。放宽止损，不要追高入场。') }}
        {% else %}<span class="gn-ic">⚖</span>
          <b>{{ t('Long-gamma market', '多头 Gamma 市场') }}</b> — {{ t('S&P 500 trades', '标普500 现') }} {{ '%.1f'|format(market_gamma.spot_vs_flip_pct) }}% {{ t('above its dealer gamma-flip', '高于做市商 Gamma 翻转位') }} ({{ market_gamma.flip }}): {{ t('dealer hedging DAMPENS moves — ranges hold and breakouts tend to fade. Fade extremes; breakouts need confirmation.', '做市商对冲会抑制波动 — 区间维持，突破易回落。逢极端反向，突破需确认。') }}
        {% endif %}
        {{ help("The whole-market dealer-gamma regime, from the VALIDATED index dealer-gamma read (S&P 500, engine.gex_engine — the same that drives the dealer-gamma board). ABOVE the gamma 'flip' strike dealers are net long gamma and hedge AGAINST price (pinning, vol suppressed); BELOW it they are short gamma and hedge WITH price (amplifying). This is market-wide vol CONTEXT for the setups below — how moves behave right now — NOT a per-stock signal. An estimate from delayed CBOE chains, not ground truth.", "全市场做市商 Gamma 状态，来自已验证的指数做市商 Gamma 读数（标普500，engine.gex_engine — 与做市商 Gamma 看板同源）。在 Gamma“翻转”行权价之上，做市商净多头 Gamma，逆价格对冲（钉住、压制波动）；之下则为空头 Gamma，顺价格对冲（放大波动）。这是对下方布局的全市场波动情境 — 当下波动的表现方式 — 并非个股信号。基于延迟的 CBOE 链估算，并非真实值。") }}
        <span class="gn-cav">{{ t('market-wide context, not a per-stock signal · est., as of', '全市场情境，非个股信号 · 估算，截至') }} {{ market_gamma.asof }}</span>
      </div>
      {% endif %}
      {% if _su and _su.dispersion_regime %}{% set _dr = _su.dispersion_regime %}
      <div class="nb-disp disp-{{ _dr.state }}" title="Cross-sectional dispersion regime — the dial for WHEN stock-selection pays. When names fan out (high dispersion / low pairwise correlation) selection earns the most and the book takes more gross (×{{ _dr.gross_mult }}); a macro-driven tape (low dispersion / high correlation) mutes it (de-gross to cash). Dispersion percentile {{ _dr.dispersion_pctile }} · avg pairwise corr {{ _dr.avg_corr }}. Sizes SELECTION conviction; never market direction. · 横截面离散度状态 — 选股何时有效的拨盘。">
        <span class="disp-ic">{{ '🎯' if _dr.state == 'lean_in' else ('🌫️' if _dr.state == 'lean_out' else '⚖️') }}</span>
        <b><span class="l-en">{{ _dr.label }}</span><span class="l-zh">{{ _dr.label_zh }}</span></b>
        <span class="disp-meta">{{ t('gross', '总仓') }} ×{{ _dr.gross_mult }}{% if _dr.avg_corr is not none %} · {{ t('avg corr', '平均相关') }} {{ _dr.avg_corr }}{% endif %}</span>
      </div>
      {% endif %}
      <div class="nbgrid" data-showmore="12">
      {% if _su %}
      {# Two-gauge board: one CONVICTION-ranked watch-list (buy + leaders-to-watch
         merged, top conviction first), each card carrying its own ENTRY-timing gauge
         so a high-conviction-but-extended leader (HWM) stays visible as "wait for the
         pullback", never silently dropped and never mislabeled "Buy Now". #}
      {% set _board = (_su.buy + (_su.watch or []))|sort(attribute='conviction.score', reverse=True) %}
      {# Two-gauge board, now BOTTOMING-ALIGNED: the strip shows only names whose
         weekly/3-day/daily cycles are aligned to the upside (engine.cycles.mtf_alignment),
         already ranked aligned-first then near-aligned backfill. Strong-but-unaligned
         leaders (weekly still falling / wrong tape) are deliberately NOT merged in — they
         would be the falling knives this screen exists to keep off the board. Each card
         still carries its own ENTRY-timing gauge. #}
      {% set _board = _su.buy %}
      {% for n in _board %}
        {% set c = n.conviction %}
        {% set es = n.entry_signal %}
        <a class="nbcard nb-{{ n.dir or 'caution' }}" href="stock.html#{{ n.ticker }}">
          <div class="nb-top">
            <span class="nb-tk">{{ n.ticker }}</span>
            <span class="nb-nm">{{ n.name }}</span>
            {% with sig = n.signal %}{% include "_sig_badge.html.j2" %}{% endwith %}
            {% if n.get('price') is not none %}<span class="nb-px" data-sym="{{ n.ticker }}" data-mkt="us">${{ '%.2f'|format(n.price) }}</span>{% endif %}
          </div>
          {# Context line LEADS with the specific narrative basket (de-blurs "Technology"
             into e.g. "Memory & Storage ▲"); the GICS sector is demoted to a muted tag.
             The basket chip carries its link in data-href (a nested <a> would shatter the
             card anchor); theme.js navigates it. #}
          {% set sp = c.spotlight if c else none %}
          {% if sp and sp.dir and sp.dir != 'neutral' %}
            {% set _th = sp.theme or {} %}{% set _sc = sp.sector or {} %}
            {% set _en = (_th.name or _sc.name or _sc.etf)|e %}{% set _zh = (_th.name_zh or _th.name or _sc.name or _sc.etf)|e %}
            {% set _spcls = 'spot-up' if sp.dir == 'tailwind' else 'spot-dn' %}
            {% set _sptip = ('Theme/sector spotlight tilt (×' ~ ('%.2f'|format(sp.mult)) ~ ') — a small narrative nudge to rank; never overrides extension or risk vetoes.' ~ ((' Theme: ' ~ _th.name ~ ((' (' ~ _th.reco_en ~ ')') if _th.reco_en else '') ~ '.') if _th.name else '') ~ ((' Sector: ' ~ (_sc.name or _sc.etf) ~ ' — ' ~ _sc.stage ~ (', extended/do not chase' if _sc.extended else '') ~ '.') if _sc.etf else ''))|e %}
          <div class="nb-sub">
            {% if _th.slug %}<span class="nb-spot nb-spot-link {{ _spcls }}" data-href="basket/{{ _th.slug|e }}.html" role="link" tabindex="0" title="{{ _sptip }} Open the theme →"><span>{{ '🔥' if sp.dir == 'tailwind' else '🧊' }}</span><span class="sp-tag l-en">{{ _en }}</span><span class="sp-tag l-zh">{{ _zh }}</span><span>{{ '▲' if sp.dir == 'tailwind' else '▼' }}</span></span>
            {% else %}<span class="nb-spot {{ _spcls }}" title="{{ _sptip }}"><span>{{ '🔥' if sp.dir == 'tailwind' else '🧊' }}</span><span class="sp-tag l-en">{{ _en }}</span><span class="sp-tag l-zh">{{ _zh }}</span><span>{{ '▲' if sp.dir == 'tailwind' else '▼' }}</span></span>{% endif %}
            {# only show the GICS tag when the chip is a THEME (different from the sector); when
               the chip already IS the sector (no theme), don't repeat it #}
            {% if _th.name %}<span class="nb-gics">{{ td(n.sector) }}</span>{% endif %}{% if n.get('off_high') is not none %}<span class="nb-offh">{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}
          </div>
          {% else %}
          <div class="nb-sub"><span>{{ td(n.sector) }}</span>{% if n.get('off_high') is not none %}<span class="nb-offh">{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}</div>
          {% endif %}
          {{ n.spark_svg }}
          {% if c %}
          <div class="nb-conv">
            {% if c.score is not none %}<span class="nb-cscore band-{{ c.band }}" title="OWN-IT conviction (gauge 1) — how much you'd want to own this name: leadership + quality + valuation. Within-market percentile, NOT a buy-now signal — see the Entry gauge for timing. · 持有信念（量表1）— 值不值得拥有：领先度+质量+估值。市场内百分位，并非立即买入信号 — 择时见入场量表。">{{ c.score }}</span>{% endif %}
            <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
            {% if c.valuation_band %}<span class="nb-val val-{{ c.valuation_band }}" title="{{ c.valuation_note }} · {{ c.valuation_note_zh }}">{{ t(c.valuation_band, {'cheap':'便宜','fair':'合理','stretched':'偏贵','extreme':'昂贵'}[c.valuation_band] if c.valuation_band in ['cheap','fair','stretched','extreme'] else c.valuation_band) }}</span>{% endif %}
          </div>
          {% set al = c.alignment %}
          {% if al and al.line %}
          {# multi-timeframe ENTRY gate (engine.cycles.mtf_alignment): a low-risk SWING entry
             must be a FRESH turn from a low — weekly bear-recovering/basing + 3-day cross
             from oversold (<25) + daily just-crossed. 🟢 Prime/Armed = confirmed entry; 🟡
             Approaching = early backfill (not yet a buy). The reason states WHY it qualifies. #}
          <div class="nb-align{{ ' nba-near' if n.align_tier == 'near' else '' }}" title="{{ al.line }} · {{ al.line_zh }}">
            <span class="nba-mark">{{ '🟡' if n.align_tier == 'near' else '🟢' }}</span>
            <span class="nba-line"><span class="l-en">{{ al.reason or al.line }}</span><span class="l-zh">{{ al.reason_zh or al.line_zh }}</span></span>
            {% if al.entry_tier %}<span class="nba-tag">{{ t(al.entry_tier, al.entry_tier_zh) }}</span>{% endif %}
          </div>
          {% endif %}
          {% if es %}
          {# ENTRY-timing gauge (gauge 2): buy now / wait for the pullback / extended,
             with the actual buy-zone price + cycle position. This is the WHEN/AT-WHAT-PRICE
             that the conviction score must never be mistaken for. #}
          <div class="nb-entry nbe-{{ es.status }}" title="ENTRY timing (gauge 2) — when & at what price to buy. {{ es.action }}">
            <div class="nbe-head">
              <span class="nbe-dot a{{ es.act_level }}"></span>
              <span class="nbe-status"><span class="l-en">{{ es.headline }}</span><span class="l-zh">{{ es.headline_zh }}</span></span>
            </div>
            {% if es.buy_zone and es.buy_zone.high is not none %}
            <div class="nbe-zone">
              <span class="nbe-lbl">{{ t('Buy zone', '买入区') }}</span>
              <span class="nbe-px">${{ '%.2f'|format(es.buy_zone.low) }}{% if es.buy_zone.high != es.buy_zone.low %}–${{ '%.2f'|format(es.buy_zone.high) }}{% endif %}</span>
              {% if es.buy_zone.pct_from_spot is not none %}<span class="nbe-pct">{{ '%+.1f'|format(es.buy_zone.pct_from_spot) }}%</span>{% endif %}
            </div>
            {% endif %}
            {% if es.cycle_pos and es.cycle_pos.dc_day is not none %}
            <div class="nbe-cyc">
              <span>{{ t('cycle day', '周期第') }} {{ es.cycle_pos.dc_day }}{{ t('', '天') }}/{{ es.cycle_pos.dc_band[0] }}–{{ es.cycle_pos.dc_band[1] }}</span>
              <span class="nbe-bar"><span class="nbe-bf" style="width:{{ [es.cycle_pos.pct_through or 0, 100]|min }}%"></span></span>
              {% if es.timing and es.timing.opens_in_days_lo is not none and es.status not in ['buy_now','partial'] %}<span>· {{ t('window', '窗口') }} ~{{ es.timing.opens_in_days_lo }}{% if es.timing.opens_in_days_hi and es.timing.opens_in_days_hi != es.timing.opens_in_days_lo %}–{{ es.timing.opens_in_days_hi }}{% endif %}d</span>{% endif %}
            </div>
            {% endif %}
          </div>
          {% endif %}
          <div class="nb-axes">
            {% for ax, lbl, lbl_zh in [('selection','SEL','选股'),('entry','ENT','入场'),('tailwind','TWD','顺风'),('quality','QUAL','质量')] %}
            {% set a = c.axes[ax] %}
            <div class="nb-ax{{ ' ax-na' if a.pct is none else '' }}" title="{{ lbl }}{% if a.pct is not none %} {{ a.pct }}/100{% else %} — no data{% endif %}">
              <div class="axl">{{ t(lbl, lbl_zh) }}</div>
              <div class="axt"><div class="axf" style="width:{{ a.pct if a.pct is not none else 0 }}%"></div></div>
            </div>
            {% endfor %}
          </div>
          {% set _basis = (c.axes.selection.basis or [])[:2] %}
          {% if _basis %}<div class="nb-basis">{% for b in _basis %}<span class="nbb nbb-{{ b.tier }}">{{ b.label }} {{ '%+.1f'|format(b.z) }}</span>{% endfor %}</div>{% endif %}
          {# --- the two new VERIFIERS: dealer-gamma "Options check" + single-stock vol black hole --- #}
          {% set _gc = c.gex_confirm %}{% set _vs = c.vol_squeeze %}
          {% set _sqshow = _vs and _vs.state in ['COILED','FIRED_UP','FIRED_DOWN','EXPANSION'] %}
          {% if _gc or _sqshow %}
          <div class="nb-vf">
            {% if _gc %}{% set _gr = (_gc.reasons[0] if _gc.reasons else None) %}
            <span class="nb-vchip vf-{{ _gc.verdict }}" title="Options check (dealer gamma){% if _gr %} — {{ _gr.en }}{% endif %}{% if _gc.levels.call_wall %} · call wall {{ _gc.levels.call_wall }}{% endif %}{% if _gc.levels.flip %} · flip {{ _gc.levels.flip }}{% endif %} · {{ _gc.caveat }} | 期权确认（做市商 Gamma）{% if _gr %} — {{ _gr.zh }}{% endif %} · {{ _gc.caveat_zh }}">{{ '✓' if _gc.verdict=='confirm' else ('⚠' if _gc.verdict=='caution' else '·') }} {{ t('Options', '期权') }} {% if _gc.verdict=='confirm' %}{{ t('confirm','确认') }}{% elif _gc.verdict=='caution' %}{{ t('caution','警示') }}{% else %}{{ t('neutral','中性') }}{% endif %}</span>{% endif %}
            {% if _sqshow %}
            <span class="nb-vchip {{ {'COILED':'vf-coil','FIRED_UP':'vf-up','FIRED_DOWN':'vf-down','EXPANSION':'vf-exp'}[_vs.state] }}" title="Volatility black hole{% if _vs.days_compressed %} · {{ _vs.days_compressed }}d compressed{% endif %}{% if _vs.bbwp is not none %} · BBWP {{ _vs.bbwp }}{% endif %} — {{ _vs.caveat }} | 波动黑洞 — {{ _vs.caveat_zh }}">{% if _vs.state=='COILED' %}🌀 {{ t('Move loading','蓄势待发') }}{% elif _vs.state=='FIRED_UP' %}🚀 {{ t('Firing↑','向上突破') }}{% if _vs.volume_confirmed %} ✓{% endif %}{% elif _vs.state=='FIRED_DOWN' %}🔻 {{ t('Firing↓','向下突破') }}{% else %}💥 {{ t('Already moving','已在异动') }}{% endif %}</span>{% endif %}
          </div>
          {% endif %}
          <div class="nb-bot">
            {% if n.alpha is not none %}<span class="nb-az {{ 'az-up' if n.alpha > 0 else ('az-dn' if n.alpha < 0 else '') }}" title="Sector-neutral residual momentum (z) — a light, regime-scaled CONTEXT leg, NOT the rank key (the board ranks by the multi-factor Conviction composite). The decorrelated factor composite (Σ) is on the stock's own page. · 行业中性残差动量（z）— 轻量情境维度，并非排序关键；去相关因子综合（Σ）见个股页面。">α {{ '%+.2f'|format(n.alpha) }}</span>{% endif %}
            {% if n.sector_rank %}<span class="nb-rk">#{{ n.sector_rank }}/{{ n.sector_n }}</span>{% endif %}
            {% set _rs = n.risk_sizing %}{% if _rs and _rs.size_mult is not none %}<span class="nb-size {{ 'sz-up' if _rs.size_mult >= 1.1 else ('sz-dn' if _rs.size_mult <= 0.9 else '') }}" title="Vol-managed size — bet MORE on calm names, LESS on volatile ones. ×{{ _rs.size_mult }} of the conviction-base size (forecast vol {{ _rs.vol_ann_pct }}% · inverse-vol ×{{ _rs.inv_vol_mult }} · regime ×{{ _rs.regime_gross }}). The validated +0.1-0.15 Sharpe lever — HOW MUCH to own, separate from WHAT (conviction) and WHEN (entry). · 波动率管理仓位 — 平静标的加注、波动标的减注。">⚖ {{ '%.2f'|format(_rs.size_mult) }}×</span>{% endif %}
            {% if n.demand %}{% set dyoy = (' ' + '%+.0f'|format(n.demand.yoy) + '%') if n.demand.yoy is not none else '' %}
              {% if n.demand.div == 'ahead_of_consensus' %}<span class="nb-dmnd dmnd-up" title="Demand Desk: an independent, management-INDEPENDENT forward-demand signal (customer capex / contracted bookings · {{ n.demand.chain }}{{ dyoy }} YoY) is running AHEAD of this name's analyst consensus — i.e. not yet fully in the price. See the Demand Desk page. Display-only context, scored forward vs SPY; NOT a buy signal · 需求台：一个不依赖管理层口径的独立前瞻需求信号正领先于该股分析师共识——尚未充分计入价格。详见需求台页面。仅供展示并对SPY前向评分；非买入信号。">🧭 {{ t('demand ahead', '需求领先') }}</span>
              {% elif n.demand.div == 'consensus_at_risk' %}<span class="nb-dmnd dmnd-rk" title="Demand Desk: the independent forward-demand signal ({{ n.demand.chain }}{{ dyoy }} YoY) is SOFTENING while estimates still rise — the priced consensus may be ahead of the demand. Caution; display-only, not a sell signal · 需求台：独立前瞻需求信号在走弱而预期仍在上修——已被定价的共识可能领先于需求。需谨慎；仅供展示，非卖出信号。">🧭 {{ t('demand at risk', '需求承压') }}</span>{% endif %}{% endif %}
          </div>
          {% if c.cautions %}<div class="nb-cau">{% for cau in c.cautions %}<span class="l-en">⚠ {{ cau }}</span><span class="l-zh">⚠ {{ c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau }}</span>{% endfor %}</div>{% endif %}
          {# only NAME-SPECIFIC notes here (e.g. favourable risk-cone); the generic
             percentile-rank caveat + edge-basis are hoisted to the one .nb-legend above. #}
          {% if c.notes %}{% for nt in c.notes if nt.kind != 'rank' %}<div class="nb-note nb-note-{{ nt.kind }}"><span class="l-en">ℹ {{ nt.en }}</span><span class="l-zh">ℹ {{ nt.zh }}</span></div>{% endfor %}{% endif %}
          {% endif %}
        </a>
      {% endfor %}
      {% else %}
      {% for n in action_board.notable %}
        {% set _d = n.dir or 'caution' %}
        <a class="nbcard nb-{{ _d }}" href="stock.html#{{ n.ticker }}">
          <div class="nb-top">
            <span class="nb-tk">{{ n.ticker }}</span>
            <span class="nb-nm">{{ n.name }}</span>
            {% if n.get('price') is not none %}<span class="nb-px" data-sym="{{ n.ticker }}" data-mkt="us">${{ '%.2f'|format(n.price) }}</span>{% endif %}
          </div>
          <div class="nb-sub"><span>{{ td(n.sector) }}</span>{% if n.get('off_high') is not none %}<span>{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}</div>
          {{ n.spark_svg }}
          <div class="nb-bot">
            <span class="nb-state">{{ td(n.label) }}</span>
            {% if n.urgency == 'imminent' and n.days %}<span class="nb-eta">~{{ n.days }}d</span>{% endif %}
            {% if n.eq_badge %}<span class="nb-score s-{{ n.eq_dir or 'flat' }}">{{ n.eq_badge }}</span>{% endif %}
          </div>
          <div class="nb-meta">
            {% if n.eq_grade %}<span class="nb-grade" style="color:{{ 'var(--up)' if n.eq_dir=='up' else ('var(--down)' if n.eq_dir=='down' else 'var(--muted)') }}">{{ t(n.eq_grade, n.eq_grade_zh) if n.eq_grade_zh else n.eq_grade }}</span> ·{% endif %}
            <span title="signal triggered {{ n.signal_date }} · 信号触发 {{ n.signal_date }}">⏱ {{ t(n.age_short, n.age_short_zh) if n.age_short else (n.signal_date or '') }}</span>
          </div>
          {% if n.alpha_z is not none or n.insider_buyers or n.sue_z or n.demand %}
          <div class="nb-alpha">
            {% if n.alpha_z is not none %}<span class="nb-az {{ 'az-up' if n.alpha_z > 0 else ('az-dn' if n.alpha_z < 0 else '') }}" title="Sector-neutral residual momentum (z) — stock-specific strength with market + sector beta stripped. A ranking/context leg, not a standalone signal. · 行业中性残差动量（z）— 剥离大盘与行业 beta 后的个股特定强度。属排序/情境维度，并非独立信号。">α {{ '%+.2f'|format(n.alpha_z) }}</span>{% endif %}
            {% if n.alpha_sector_rank %}<span class="nb-rk" title="Rank within its GICS sector by sector-neutral momentum · 按行业中性动量在其 GICS 行业内的排名">#{{ n.alpha_sector_rank }}/{{ n.alpha_sector_n }}</span>{% endif %}
            {% if n.alpha_entry == 'pullback' %}<span class="nb-ent ent-good" title="A leader on a recent pullback — a more constructive entry · 强势股近期回调 — 更具建设性的入场点">{{ t('pullback', '回调') }}</span>
            {% elif n.alpha_entry == 'extended' %}<span class="nb-ent ent-warn" title="A leader that just spiked — short-term reversal risk · 强势股刚刚拉升 — 短线反转风险">{{ t('extended', '过热') }}</span>{% endif %}
            {% if n.insider_buyers %}<span class="nb-ins" title="{{ n.insider_buyers }} distinct insiders net-bought{% if n.insider_net_mn %} ${{ '%.1f'|format(n.insider_net_mn) }}M{% endif %}{% if n.insider_bps %} (+{{ n.insider_bps }} bps of cap){% endif %} in the last 6 months — a Form-4 CLUSTER confirmer (orthogonal long-only conviction, not a standalone signal) · {{ n.insider_buyers }} 名内部人近 6 个月净买入 — Form-4 集群确认指标">👤 {{ n.insider_buyers }}</span>{% endif %}
