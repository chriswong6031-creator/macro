  {% if alerts %}
  <div class="panel span12">
    <h2>{{ t('Fired alerts (today)', '已触发警报（今日）') }}
      {{ help("Alerts fire only when something CHANGES — a warning level escalating, a crossing, a sign flip — never just because a level is high. They're rare by design; read every one. Click any alert to jump to the scorecard it came from.", "警报只在某物发生变化时触发 — 预警级别升级、出现交叉、符号翻转 — 绝不仅因某个水平偏高而触发。它们刻意设计得稀少；每一条都要读。点击任意警报可跳转到其来源的计分卡。") }}
    </h2>
    {% for a in alerts %}
      <a class="alert alert-{{ a.severity }}" {% if a.anchor %}href="#{{ a.anchor }}"{% endif %}>
        <div class="alert-head">
          <span class="alert-ico">{{ a.icon }}</span>
          <b><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></b>
          {% if a.anchor %}<span class="alert-jump">{{ t('View scorecard ↓', '查看计分卡 ↓') }}</span>{% endif %}
        </div>
        <div class="alert-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
        <div class="alert-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh }}</span></div>
        {% if a.edge_en %}<div class="alert-edge"><b>{{ t('Conviction:', '可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
      </a>
    {% endfor %}
  </div>
