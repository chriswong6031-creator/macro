}
body.page-macro .rsx-froth-bars{display:flex;flex-direction:column;gap:8px;}
body.page-macro .rsx-froth-bar-row{display:flex;align-items:center;gap:10px;}
body.page-macro .rsx-froth-bar-lbl{font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));width:110px;flex-shrink:0;}
body.page-macro .rsx-froth-bar-track{flex:1;height:6px;border-radius:3px;background:rgba(255,255,255,.08);overflow:hidden;}
