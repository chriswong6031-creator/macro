<script>
/* Keep .help tooltips on-screen: flip below the icon when it's near the top of
   the viewport, and clamp horizontally near the left/right edges. Hover-only,
   no layout cost until you point at a "?". */
(function(){
  function place(h){
    var r = h.getBoundingClientRect(), vw = window.innerWidth;
    h.classList.toggle('below', r.top < 240);
    h.classList.remove('edge-left','edge-right');
    if (r.left > vw - 170) h.classList.add('edge-right');
    else if (r.left < 170) h.classList.add('edge-left');
  }
  document.addEventListener('pointerover', function(e){
    var h = e.target.closest && e.target.closest('.help');
    if (h) place(h);
  }, true);

  /* MOB-03: tap-to-toggle on touch devices; close on outside tap.
     Clicks INSIDE the open tip body (scrolling, selecting text) must not
     toggle it closed — only the ? icon itself toggles. */
  var _tipOpen = null;
  document.addEventListener('click', function(e){
    if(e.target.closest && e.target.closest('.help .tip')) return;
    var h = e.target.closest && e.target.closest('.help');
    if(h){
      e.stopPropagation();
      if(_tipOpen && _tipOpen !== h){ _tipOpen.classList.remove('tip-open'); _tipOpen=null; }
      var wasOpen = h.classList.contains('tip-open');
      h.classList.toggle('tip-open', !wasOpen);
      _tipOpen = wasOpen ? null : h;
      if(!wasOpen) place(h);
      return;
    }
    /* outside tap closes open tip */
    if(_tipOpen){ _tipOpen.classList.remove('tip-open'); _tipOpen=null; }
  });
})();
</script>
<script>
/* Per-card detail as an ANCHORED DROPDOWN POPOVER (.nb-more-btn opens a fixed floating
   .nb-more panel; JS positions it from the button rect and flips up / clamps to the edge —
   mirrors the .nb-cau placePop idiom). Only one open at a time; closes on ×, outside click,
   or Esc; repositions on scroll/resize. Delegated on document so it works regardless of
   showmore reveal order. */
(function(){
  var openCard = null;
  var LBL_OPEN  = '<span class="l-en">▴ less</span><span class="l-zh">▴ 收起</span>';
  var LBL_SHUT  = '<span class="l-en">▾ details</span><span class="l-zh">▾ 详情</span>';
  function closePop(){
    if (!openCard) return;
    openCard.classList.remove('nb-open');
    var b = openCard.querySelector('.nb-more-btn');
    if (b){ b.setAttribute('aria-expanded','false'); b.innerHTML = LBL_SHUT; }
    openCard = null;
  }
  function place(card){
    var pop = card.querySelector('.nb-more'), btn = card.querySelector('.nb-more-btn');
    if (!pop || !btn) return;
    var r = btn.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight, m = 10;
    var pw = pop.offsetWidth, ph = pop.offsetHeight;
    // horizontal: align the popover's left edge under the button, clamp to viewport
    var left = Math.min(Math.max(m, r.left), Math.max(m, vw - pw - m));
    // vertical: drop below the button; if it would overflow, flip above; else pin near bottom
    var top = r.bottom + 6;
    if (top + ph > vh - m){ var above = r.top - 6 - ph; top = (above >= m) ? above : Math.max(m, vh - ph - m); }
    pop.style.left = left + 'px'; pop.style.top = top + 'px';
  }
  document.addEventListener('click', function(e){
    if (e.target.closest && e.target.closest('.nb-more-x')){ e.preventDefault(); e.stopPropagation(); closePop(); return; }
    var btn = e.target.closest && e.target.closest('.nb-more-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var card = btn.closest('.nbcard'); if (!card) return;
      var wasOpen = (card === openCard);
      closePop();
      if (!wasOpen){
        card.classList.add('nb-open');
        btn.setAttribute('aria-expanded','true'); btn.innerHTML = LBL_OPEN;
        openCard = card;
        place(card);   // .nb-more is display:block now → measurable
      }
      return;
    }
    if (openCard && !(e.target.closest && e.target.closest('.nb-more'))) closePop();
  }, true);
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closePop(); });
  window.addEventListener('scroll', function(){ if (openCard) place(openCard); }, true);
  window.addEventListener('resize', function(){ if (openCard) place(openCard); });
})();

/* Card-body delegated click handler: clicking the .nbcard div (outside the head anchor,
   the caution btn, the more-btn, or the expander) triggers the head anchor's .click(),
   re-entering the Terminal interceptor naturally (theme.js L142-149 intercepts a[href]).
   This preserves "click a card for the full breakdown" UX post div-restructure.
   nb-spot data-href chips get their own handler (see theme.js addition). */
(function(){
  document.addEventListener('click', function(e){
    var card = e.target.closest && e.target.closest('.nbcard');
    if (!card) return;
    /* skip if click is on an interactive sub-element that handles itself */
    if (e.target.closest('.nb-cau-btn') || e.target.closest('.nb-cau-pop') ||
        e.target.closest('.nb-more-btn') || e.target.closest('.nb-more') ||
        e.target.closest('.nb-spot[data-href]') || e.target.closest('.nb-head-link')) return;
    var headLink = card.querySelector('.nb-head-link');
    if (headLink) { headLink.click(); }
  });
})();
</script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge).
   (Chip explanatory copy uses the theme.js data-tip mechanism instead — one
   repo-standard tooltip; the W2 bespoke chip popover was retired at merge.) */
(function(){
  function placePopCau(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  function closeAllPops(){
    document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
  }
  /* Tap: toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      closeAllPops();
      if (!wasOpen){ placePopCau(wrap); wrap.classList.add('nb-cau-open'); }
      return;
    }
    /* outside tap: close all */
    if (!e.target.closest('.nb-cau-pop')){
      closeAllPops();
    }
  }, true);
  /* Position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var cau = e.target.closest && e.target.closest('.nb-cau');
    if (cau){ placePopCau(cau); return; }
  }, true);
})();
</script>
{% if mode == 'stocks' %}
<script>
/* TS-U3 dash-tape-band + dash-mtf-section JS (mode=stocks only).
   FT-R1/TS-R5: display-tier only; never mutates slow state; no buy verbs.
   FT-R8: graceful absent-file. TS-R1: honest-delay modes. */
(function(){
'use strict';
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function L(en,zh){return'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>';}
function fmtPct(v){if(v==null)return'—';return(v>=0?'+':'')+v.toFixed(2)+'%';}
function clsPct(v){return v==null?'muted':v>=0?'up':'dn';}

function fetchJson(url, cb){
  fetch(url,{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(cb)
    .catch(function(){});
}

/* ────────────────────────────────────────────────────────────────────────
   TAPE BAND (TS-U3 dash-tape-band — dashboard reach; dtp-* idiom)
   ──────────────────────────────────────────────────────────────────────── */
/* basket display-name map: populated by basketdata/baskets.json fetch */
var _dtpNames = {};
function _dtpSlug(id){
  /* prettify raw slug: us_sector_staples → "Us Sector Staples" */
  return id.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});
}
function _dtpNameEn(id){
  return (_dtpNames[id]&&_dtpNames[id].en)||_dtpSlug(id);
}
function _dtpNameZh(id){
  return (_dtpNames[id]&&_dtpNames[id].zh)||_dtpSlug(id);
}

function isChipSuppressed(pulse){ return !pulse || (pulse.mode||'live') !== 'live'; }

/* Derive a single display-state token from pulse fields.
   Returns {cls, en, zh, delay, asofStr}                        */
function _dtpState(pulse){
  var mode    = pulse.mode||'live';
  var session = pulse.session||'closed';
  var ts      = pulse.as_of_quotes||pulse.as_of_utc;
  var asofStr = '';
  if(ts){
    try{
      if(ts.length<=10){ asofStr=ts; }
      else if(mode==='last_rth'&&pulse.settled_close){
        asofStr=new Date(ts).toLocaleString([],{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
      } else {
        asofStr=new Date(ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
      }
    }catch(e){asofStr=ts;}
  }
  /* >12h staleness guard (weekend/holiday frozen file) */
  var builtMs=Date.parse(pulse.as_of_utc||'');
  var stale=isFinite(builtMs)&&(Date.now()-builtMs)>12*3600e3;
  if(stale){
    if(mode==='live'||mode==='delayed'){ mode='last_rth'; pulse.mode='last_rth'; }
    session='closed';
    /* a >12h-old file describes a finished session — never label it POST-MARKET */
    return {cls:'closed', en:'LAST SESSION · SETTLED', zh:'上一交易时段 · 已收盘', asofStr:asofStr, live:false};
  }
  if(mode==='live'){
    if(session==='pre')
      return {cls:'pre', en:'PREMARKET · 15-MIN DELAYED', zh:'盘前 · 15分钟延迟', asofStr:asofStr, live:true};
    return {cls:'live', en:'LIVE · 15-MIN DELAYED', zh:'实盘 · 15分钟延迟', asofStr:asofStr, live:true};
  }
  if(mode==='last_rth'){
    if(pulse.settled_close)
      return {cls:'post', en:'POST-MARKET · SETTLED CLOSE', zh:'盘后 · 当日收盘', asofStr:asofStr, live:false};
    return {cls:'post', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
  }
  if(mode==='eod')
    return {cls:'closed', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
  if(mode==='delayed'){
    var h=pulse.delay_min_median!=null?Math.round(pulse.delay_min_median/60):0;
    return {cls:'warn', en:'DELAYED · ~'+h+'h', zh:'延迟 · 约'+h+'小时', asofStr:asofStr, live:false};
  }
  return {cls:'closed', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
}

function renderTapeBand(pulse){
  var band = document.getElementById('dash-tape-band');
  if(!band) return;
  if(!pulse){band.classList.remove('visible');return;}
  band.classList.add('visible');

  var st = _dtpState(pulse);
  var mode = pulse.mode||'live';

  /* token */
  var tokEl = document.getElementById('dtp-token');
  var tokLbl = document.getElementById('dtp-token-lbl');
  if(tokEl){ tokEl.className='dtp-token '+st.cls; }
  if(tokLbl){ tokLbl.innerHTML=L(esc(st.en),esc(st.zh)); }

  /* as-of */
  var asofEl = document.getElementById('dtp-asof');
  if(asofEl){
    asofEl.innerHTML=st.asofStr?L('as of '+esc(st.asofStr),'截至 '+esc(st.asofStr)):'';
  }

  /* live-mode class for opacity rule */
  if(st.live){ band.classList.add('live-mode'); } else { band.classList.remove('live-mode'); }

  var all=(pulse.baskets||[]).filter(function(b){return b.live_ew_chg_pct!=null&&b.tape_rank!=null;});
  var session=pulse.session||'closed';
  var bodyEl=document.getElementById('dtp-body');
  var moreBtn=document.getElementById('dtp-more');
  var fnEl=document.getElementById('dtp-fn');
  if(!bodyEl) return;

  if(!all.length){
    var loading=(session==='pre'||session==='rth');
    bodyEl.innerHTML='<div class="dtp-empty">'
      +(loading?L('quotes loading…','报价加载中…')
               :L('No tape data for the last session.','上一交易时段暂无行情数据。'))
      +'</div>';
    if(moreBtn){moreBtn.hidden=true;moreBtn.setAttribute('aria-expanded','false');}
    if(fnEl){fnEl.innerHTML='';}
    return;
  }

  all.sort(function(a,b){return b.tape_rank-a.tape_rank;});
  /* laggards only from rows NOT already shown as leaders (sparse days: n<=5 → no laggard group) */
  var top5=all.slice(0,5);
  var bot3=all.length>5?all.slice(Math.max(5,all.length-3)).reverse():[];

  /* proportional bar scale across the shown movers */
  var shown=top5.concat(bot3);
  var maxAbs=0;
  shown.forEach(function(b){var a=Math.abs(b.live_ew_chg_pct);if(a>maxAbs)maxAbs=a;});
  if(!maxAbs)maxAbs=1;

  var flowShown=false, flowAsOf=pulse.day_flow_as_of||null;

  function flowBits(b){
    var f=b.day_flow;
    /* flow is notable when |cmf|>0.05 OR vol_surge>=1.5 (DT-W1a: descriptive only) */
    var hasFlow=f&&((f.cmf!=null&&Math.abs(f.cmf)>0.05)||(f.dollar_vol_surge!=null&&f.dollar_vol_surge>=1.5));
    if(!hasFlow) return null;
    flowShown=true;
    var aoStr=f.as_of||flowAsOf||'';
    var volStr=f.dollar_vol_surge!=null?('×'+Number(f.dollar_vol_surge).toFixed(1)):'';
    var dirEn=f.cmf>0.05?'inflow':(f.cmf<-0.05?'outflow':'balanced');
    var dirZh=f.cmf>0.05?'流入':(f.cmf<-0.05?'流出':'均衡');
    var longEn=f.cmf>0.05?'net inflow':(f.cmf<-0.05?'net outflow':'balanced flow');
    var longZh=f.cmf>0.05?'净流入':(f.cmf<-0.05?'净流出':'资金流均衡');
    return {
      en:(volStr?volStr+' vol · ':'')+dirEn,
      zh:(volStr?volStr+' 量 · ':'')+dirZh,
      tipEn:(volStr?volStr+' vol · ':'')+longEn+(aoStr?' (nightly, as of '+aoStr+')':''),
      tipZh:(volStr?volStr+' 量 · ':'')+longZh+(aoStr?'（每晚，截至 '+aoStr+'）':'')
    };
  }

  function rowHtml(b, ordinal){
    var chg=b.live_ew_chg_pct, isUp=chg>=0;
    var barW=Math.max(4,Math.min(56,Math.round(Math.abs(chg)/maxAbs*56)));
    var nameEn=_dtpNameEn(b.id), nameZh=_dtpNameZh(b.id);
    var mid='';
    var fb=flowBits(b);
    if(fb){
      mid+='<span class="dtp-mflow" data-tip-en="'+esc(fb.tipEn)+'" data-tip-zh="'+esc(fb.tipZh)+'">'
        +'<span class="l-en">'+esc(fb.en)+'</span><span class="l-zh">'+esc(fb.zh)+'</span></span>';
    }
    /* 2d suffix: only when sign flips and |cum_2d| >= 1.0 */
    if(b.cum_2d_pct!=null&&Math.abs(b.cum_2d_pct)>=1.0){
      var flipSign=(chg>=0&&b.cum_2d_pct<0)||(chg<0&&b.cum_2d_pct>=0);
      if(flipSign){
        var d2pct=(b.cum_2d_pct>=0?'+':'')+b.cum_2d_pct.toFixed(1)+'%';
        var d2TipEn=fmtPct(chg)+' today after a '+d2pct+' two-day run — the session move flips the 2-day direction. Descriptive only.';
        var d2TipZh=fmtPct(chg)+' 今日，近两日累计 '+d2pct+' — 当日走势翻转两日方向。仅供参考。';
        mid+='<span class="dtp-2d" data-tip-en="'+esc(d2TipEn)+'" data-tip-zh="'+esc(d2TipZh)+'">2d '+d2pct+'</span>';
      }
    }
    return '<a class="dtp-mrow" href="basket/'+esc(b.id)+'.html">'
      +'<span class="dtp-rank">'+ordinal+'</span>'
      +'<span class="dtp-mname"><span class="l-en">'+esc(nameEn)+'</span><span class="l-zh">'+esc(nameZh)+'</span></span>'
      +mid
      +'<span class="dtp-mpct '+(isUp?'up':'dn')+'">'+fmtPct(chg)+'</span>'
      +'<span class="dtp-mtrack'+(isUp?'':' dn')+'"><span class="dtp-mbar '+(isUp?'up':'dn')+'" style="width:'+barW+'px"></span></span>'
      +'</a>';
  }

  /* column labels adapt to the honest state (TS-R1) */
  var lblUp, lblDn;
  if(st.live){
    lblUp=L('LIVE LEADERS','实时领涨'); lblDn=L('LIVE LAGGARDS','实时领跌');
  } else if(mode==='last_rth'&&pulse.settled_close){
    lblUp=L('SESSION LEADERS — AT THE CLOSE','本交易日领涨 — 收盘');
    lblDn=L('SESSION LAGGARDS — AT THE CLOSE','本交易日领跌 — 收盘');
  } else {
    lblUp=L('LAST SESSION LEADERS','上一交易日领涨');
    lblDn=L('LAST SESSION LAGGARDS','上一交易日领跌');
  }

  var upRows='', dnRows='';
  top5.forEach(function(b,i){upRows+=rowHtml(b,i+1);});
  bot3.forEach(function(b,i){dnRows+=rowHtml(b,i+1);});
  /* footnote flow provenance must reflect only the always-visible rows; the
     fold rows below also run flowBits, so snapshot before building them */
  var flowShownVisible=flowShown;

  /* full tape behind the expander (UI truncation only, TS-R5) — each column
     CONTINUES its own ranking past the preview cut: leaders extend 6..half,
     laggards extend worst-first, the two meet at mid-tape. No row repeats. */
  var half=Math.max(top5.length,Math.ceil(all.length/2));
  var upCont=all.slice(top5.length,half);
  var dnCont=all.slice(half,all.length-bot3.length).reverse();
  var upMore='', dnMore='';
  upCont.forEach(function(b,i){upMore+=rowHtml(b,top5.length+i+1);});
  dnCont.forEach(function(b,i){dnMore+=rowHtml(b,bot3.length+i+1);});

  var colUp='<div class="dtp-col"><div class="dtp-col-lbl up">'+lblUp+'</div>'+upRows;
  if(upMore){colUp+='<div class="dtp-colmore" hidden>'+upMore+'</div>';}
  colUp+='</div>';

  var colDn='<div class="dtp-col"><div class="dtp-col-lbl dn">'+lblDn+'</div>'+dnRows;
  if(dnMore){colDn+='<div class="dtp-colmore" hidden>'+dnMore+'</div>';}
  /* AI-Capex complex row (live mode only — chip suppression law unchanged, FT-R12) */
  if(!isChipSuppressed(pulse)){
    var cx=null;
    (pulse.complexes||[]).forEach(function(c){if(c.complex_id==='ai_capex')cx=c;});
    if(cx&&cx.live_ew_chg_pct!=null){
      var isG=cx.live_ew_chg_pct>=0;
      var cxTipEn='AI-Capex Complex composite basket.'+(cx.only_green_complex?' Only complex in positive territory this session.':'')+' Context only.';
      var cxTipZh='AI资本开支复合板块。'+(cx.only_green_complex?'本交易时段唯一上涨复合板块。':'')+'仅供参考。';
      /* Static readout, not a link: `ai_capex` is a COMPLEX id (an aggregate over
         engine.demand_capex.AI_CAPEX_THEMES), not a basket id, so no
         basket/<id>.html is ever built for it and the href this row shipped with
         was a live 404. .dtp-mrow styling is class-driven and the tooltip binds on
         [data-tip-en] whatever the element, so both survive the <a> -> <div>. The
         inline colour pins .dtp-mname past `.dtp-mrow:hover .dtp-mname` in
         theme.css, so a non-clickable row never lights up like a link. */
      colDn+='<div class="dtp-col-lbl cx" style="margin-top:7px">'+L('COMPLEX','复合')+'</div>'
        +'<div class="dtp-mrow" style="cursor:default" data-tip-en="'+esc(cxTipEn)+'" data-tip-zh="'+esc(cxTipZh)+'">'
        +'<span class="dtp-rank">·</span>'
        +'<span class="dtp-mname" style="color:var(--text)"><span class="l-en">AI-Capex Complex</span><span class="l-zh">AI资本开支复合板块</span></span>'
        +'<span class="dtp-mpct '+(isG?'up':'dn')+'">'+fmtPct(cx.live_ew_chg_pct)+'</span>'
        +'<span class="dtp-mtrack'+(isG?'':' dn')+'"><span class="dtp-mbar '+(isG?'up':'dn')+'" style="width:'+Math.max(4,Math.round(Math.abs(cx.live_ew_chg_pct)/maxAbs*56))+'px"></span></span>'
        +'</div>';
    }
  }
  colDn+='</div>';

  bodyEl.innerHTML=colUp+colDn;

  if(fnEl){
    /* FT-R3 fade note — plain words on Tier 1, 58% receipt demoted to the ? tip
       (doctrine Law 2/3; same form as baskets #2232/#2236) */
    var fadeEn='Not a buy signal: sharp one-day flips usually don\'t hold — in 26 past cases about 6 in 10 faded within a day.';
    var fadeZh='非买入信号：剧烈的单日反转多难持续 — 历史26次中约六成在一天内消退。';
    var tipEn='Technical receipt: T+1 violent-flip base rate 58% fade (n=26) · flip-confirmation lens · descriptive only, not a directional signal · display tier.';
    var tipZh='技术说明：T+1剧烈反转基础概率58%消退（n=26）· 翻转确认透镜 · 仅描述、非方向信号 · 展示层。';
    var flowSeg='';
    if(flowShownVisible){
      var aoEn=flowAsOf?' (as of '+esc(flowAsOf)+')':'';
      var aoZh=flowAsOf?'（截至 '+esc(flowAsOf)+'）':'';
      flowSeg=' · '+L('flow = nightly dollar-volume read'+aoEn+', descriptive only','资金流 = 每晚美元成交量读数'+aoZh+'，仅供描述');
    }
    fnEl.innerHTML=L(fadeEn,fadeZh)
      +' <span class="ftr-t1-help" data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'">?</span>'
      +flowSeg;
  }

  if(moreBtn){
    if(!upCont.length&&!dnCont.length){
      moreBtn.hidden=true;
      moreBtn.setAttribute('aria-expanded','false');
    } else {
      var n=all.length;
      var moreLbl=function(open){
        return open?L('Show less ▴','收起 ▴')
                   :L('Show full tape ('+n+') ▾','显示完整行情（'+n+'）▾');
      };
      var setOpen=function(open){
        bodyEl.querySelectorAll('.dtp-colmore').forEach(function(el){el.hidden=!open;});
        moreBtn.setAttribute('aria-expanded',open?'true':'false');
        moreBtn.innerHTML=moreLbl(open);
      };
      moreBtn.hidden=false;
      /* live re-renders rebuild the columns — carry the open state across */
      setOpen(moreBtn.getAttribute('aria-expanded')==='true');
      moreBtn.onclick=function(){setOpen(moreBtn.getAttribute('aria-expanded')!=='true');};
    }
  }
}

/* ────────────────────────────────────────────────────────────────────────
   PER-STOCK TURN SETUPS TABLE (TS-R3 / TS-R7 / TS-R3)
   ──────────────────────────────────────────────────────────────────────── */
function _mtfPhasePlain(raw){
  /* monthly_phase slugs → plain words (raw slug stays in the hover receipt).
     Unknown tokens fall through prettified, never raw with underscores. */
  if(!raw) return '—';
  var MAP={macd_pos:{en:'above water',zh:'零轴上方'},macd_neg:{en:'below water',zh:'零轴下方'},
           rising:{en:'rising',zh:'上升'},falling:{en:'falling',zh:'回落'}};
  var parts=String(raw).split('/');
  var en=[],zh=[];
  parts.forEach(function(pt){
    var m=MAP[pt];
    en.push(m?m.en:pt.replace(/_/g,' '));
    zh.push(m?m.zh:pt.replace(/_/g,' '));
  });
  return '<span data-tip-en="Monthly momentum: '+esc(raw)+' — anti-trap context only, not a gate" data-tip-zh="月线动能：'+esc(raw)+' — 仅作防陷阱参考，非门控">'
    +L(esc(en.join(' · ')),esc(zh.join(' · ')))+'</span>';
}

function renderMtfTable(mtfUpturn){
  var bodyEl=document.getElementById('dash-mtf-body');
  if(!bodyEl) return;

  if(!mtfUpturn||!mtfUpturn.tickers){
    bodyEl.innerHTML='<p class="dash-mtf-absent">'
      +L('Turn setup data lands after tonight\'s nightly (~02:00 UTC). Stocks with early bottoming signs will appear here.',
         '拐点形态数据将在今晚收盘后更新（约UTC 02:00）。出现早期筑底迹象的个股将在此显示。')
      +'</p>';
    return;
  }

  var tickers=mtfUpturn.tickers;
  var asOf=mtfUpturn.as_of||'';

  // Build row list: CONFIRMED first, then WATCH. A name earns a row only when it
  // has a live early-turn signal — no fixed roster is force-shown (Mag7 pin removed).
  var confirmed=[], watch=[];
  var seen=new Set();
  (mtfUpturn.cohort&&mtfUpturn.cohort.confirmed||[]).forEach(function(sym){
    if(tickers[sym]){confirmed.push(sym);seen.add(sym);}
  });
  (mtfUpturn.cohort&&mtfUpturn.cohort.watch||[]).forEach(function(sym){
    if(tickers[sym]&&!seen.has(sym)){watch.push(sym);seen.add(sym);}
  });

  var rows=confirmed.concat(watch).slice(0,40);

  if(!rows.length){
    bodyEl.innerHTML='<p class="dash-mtf-absent">'+L('No turn setup data yet.','暂无拐点形态数据。')+'</p>';
    return;
  }

  // Leg glyphs — 3 visual states (U7):
  //   FILLED (on)   = leg fired: recent cross counts toward K
  //   RING (trend)  = histogram positive but no recent cross — running trend, does not count toward K
  //   EMPTY (off)   = histogram negative
  function _trendTip(label, trendObj){
    // Returns {en, zh} pair — callers emit data-tip-en/data-tip-zh (never title=)
    if(!trendObj) return {en:label, zh:label};
    var bsc=trendObj.bars_since_cross;
    if(bsc!=null){
      return {en:label+': crossed '+bsc+' bar'+(bsc===1?'':'s')+' ago, histogram positive',
              zh:label+'：'+bsc+'根K线前金叉，柱状线为正'};
    }
    if(trendObj.pos){
      return {en:label+': histogram positive (no recent cross)',zh:label+'：柱状线为正（无近期金叉）'};
    }
    return {en:label, zh:label};
  }
  function _tipAttrs(tipObj){
    // Render data-tip-en/zh attributes from a {en,zh} pair
    return ' data-tip-en="'+esc(tipObj.en)+'" data-tip-zh="'+esc(tipObj.zh)+'"';
  }
  function legEl3(fired, trendObj, label){
    // fired: recent cross (counts toward K); trendObj: {pos, bars_since_cross}
    var pos=trendObj&&trendObj.pos;
    var cls=fired?'on':(pos?'trend':'off');
    var tip=(fired||pos)?_trendTip(label,trendObj):{en:label,zh:label};
    return '<span class="dash-mtf-leg '+cls+'"'+_tipAttrs(tip)+'>'+esc(label.slice(0,2))+'</span>';
  }
  function wMacdEl3(val, trendObj){
    // val: 'cross'|'approaching'|'none'; trendObj for W timeframe
    var pos=trendObj&&trendObj.pos;
    if(val==='cross'){
      var tip=_trendTip('W',trendObj);
      return '<span class="dash-mtf-leg on"'+_tipAttrs(tip)+'>W</span>';
    }
    if(val==='approaching'){
      var approachTip={en:'W: approaching (histogram negative but rising, does not count toward K)',zh:'W：接近（柱状线为负但上升，不计入K值）'};
      return '<span class="dash-mtf-leg partial" style="border-style:dashed"'+_tipAttrs(approachTip)+'>W</span>';
    }
    if(pos){
      var tip2=_trendTip('W',trendObj);
      return '<span class="dash-mtf-leg trend"'+_tipAttrs(tip2)+'>W</span>';
    }
    return '<span class="dash-mtf-leg off" data-tip-en="W" data-tip-zh="W">W</span>';
  }

  var html='<p class="muted" style="font-size:11px;margin:0 0 5px">'
    +L('as of '+esc(asOf)+' · an early-warning checklist, not a buy list',
       '截至 '+esc(asOf)+' · 早期预警检查表，非买入清单')+'</p>';
  html+='<div class="tbl-scroll"><table class="dash-mtf-tbl"><thead><tr>'
    +'<th>'+L('ticker','代码')+'</th>'
    +'<th>'+L('state','状态')+'</th>'
    +'<th class="r">'+L('boxes','格数')+'</th>'
    +'<th>'+L('checklist (D / 3D / W / 2W)','检查表 (D / 3D / W / 2W)')
      +' <span class="help" style="vertical-align:middle">?<span class="tip">'
      +'<span class="l-en">Filled = fired recently (counts toward the box count). Ring = trend still running, no fresh cross (does not count). Empty = negative. D=daily MACD bull cross; 3D=3-day MACD+StochRSI confluence; W=weekly MACD (dashed=approaching); 2W=biweekly MACD. Forward-graded meter; the group-level version of this turn tested as no edge (26 past cases). Display context, not a signal.</span>'
      +'<span class="l-zh">实心=近期触发（计入格数）。空心圆=趋势延续但无新交叉（不计入）。空=为负。D=日线MACD金叉；3D=3日MACD+StochRSI共振；W=周线MACD（虚线=接近）；2W=双周MACD。前瞻计量；篮子级别的此类拐点经回测无优势（历史26次）。展示参考，非信号。</span>'
      +'</span></span></th>'
    +'<th>'+L('monthly phase','月线阶段')+'</th>'
    +'<th>'+L('since','起始')+'</th>'
    +'<th>'+L('baskets','篮子')+'</th>'
    +'</tr></thead><tbody>';

  rows.forEach(function(sym){
    var t=tickers[sym];
    var legs=t.legs||{};
    var trend=t.trend||{};
    var stateCls=t.state==='UPTURN_CONFIRMED'?'confirmed':t.state==='UPTURN_WATCH'?'watch':'none';
    var stateLbl=t.state==='UPTURN_CONFIRMED'?L('TURNING UP','转强确认'):t.state==='UPTURN_WATCH'?L('EARLY SIGN','初步迹象'):L('—','—');
    var _bids=(t.basket_ids||[]).slice(0,3);
    var _bMore=(t.basket_ids&&t.basket_ids.length>3)?'…':'';
    var basketEn=_bids.map(_dtpNameEn).join(', ')+_bMore;
    var basketZh=_bids.map(_dtpNameZh).join('、')+_bMore;
    html+='<tr>'
      +'<td><b>'+esc(sym)+'</b></td>'
      +'<td><span class="dash-mtf-badge '+stateCls+'">'+stateLbl+'</span></td>'
      +'<td class="r"><span class="dash-mtf-k">'+(t.k||0)+'</span></td>'
      +'<td><div class="dash-mtf-legs">'
        +legEl3(!!legs.d_macd,trend.d||null,'D')
        +legEl3(!!legs.d3_confluence,trend.d3||null,'3D')
        +wMacdEl3(legs.w_macd||'none',trend.w||null)
        +legEl3(!!legs.w2_macd,trend.w2||null,'2W')
      +'</div></td>'
      +'<td class="dash-mtf-phase">'+_mtfPhasePlain(t.monthly_phase)+'</td>'
      +'<td class="dash-mtf-since">'+esc(t.since||'—')+'</td>'
      +'<td class="dash-mtf-baskets">'+(_bids.length?L(esc(basketEn),esc(basketZh)):'—')+'</td>'
      +'</tr>';
  });
  html+='</tbody></table></div>';
  /* fold: first 12 rows at rest, the remainder behind a "Show all" toggle
     (self-wired — theme.js .lst-more handlers only bind inside .lst-wrap) */
  var FOLD=12;
  if(rows.length>FOLD){
    html='<div class="dash-mtf-collapse is-collapsed">'+html+'</div>'
      +'<button class="lst-more dash-mtf-more" type="button" aria-expanded="false">'
      +'<span class="lm-show">'+L('Show all '+rows.length+' stocks &#9662;','显示全部 '+rows.length+' 只 &#9662;')+'</span>'
      +'<span class="lm-hide">'+L('Show less &#9652;','收起 &#9652;')+'</span></button>';
  }
  bodyEl.innerHTML=html;
  var _mtfBtn=bodyEl.querySelector('.dash-mtf-more');
  if(_mtfBtn){
    _mtfBtn.addEventListener('click',function(){
      var wrap=bodyEl.querySelector('.dash-mtf-collapse');
      if(!wrap) return;
      var nowCollapsed=wrap.classList.toggle('is-collapsed');
      _mtfBtn.setAttribute('aria-expanded', nowCollapsed?'false':'true');
    });
  }
}

/* ────────────────────────────────────────────────────────────────────────
   FETCH + ORCHESTRATE
   ──────────────────────────────────────────────────────────────────────── */
var pulse=null, mtfUpturn=null;
var pulseDone=false, mtfDone=false, namesDone=false;

function tryRender(){
  if(!pulseDone||!mtfDone||!namesDone) return;
  renderTapeBand(pulse);
  renderMtfTable(mtfUpturn);
}

fetchJson('live/basket_pulse.json',function(d){pulse=d;pulseDone=true;tryRender();});
fetchJson('stockdata/mtf_upturn.json',function(d){mtfUpturn=d;mtfDone=true;tryRender();});
/* Parallel fetch: display names for tape and turn-setup rows (FT-R8: graceful fail).
   Unlike the data fetches, a names failure must not stall the band behind the 4s
   backstop — fall through to prettified slugs immediately. */
fetch('basketdata/baskets.json',{cache:'no-cache'})
  .then(function(r){if(!r.ok)throw 0;return r.json();})
  .then(function(d){
    var list=(d&&d.baskets)||[];
    list.forEach(function(b){
      if(b.id){ _dtpNames[b.id]={en:b.name||_dtpSlug(b.id), zh:b.name_zh||b.name||_dtpSlug(b.id)}; }
    });
  })
  .catch(function(){})
  .then(function(){namesDone=true;tryRender();});

// Fail-open: if any fetch doesn't resolve, still render with what we have
setTimeout(function(){pulseDone=true;mtfDone=true;namesDone=true;tryRender();},4000);

// See-more folds — V2 action board + sector setups table. Page-scoped;
// theme.js .lst-wrap handler ignores .act-more buttons.
document.addEventListener('click',function(e){
  var btn=e.target&&e.target.closest?e.target.closest('.act-more'):null;
  if(!btn)return;
  var wrap=btn.closest('.actcol')||btn.closest('.panel');
  if(!wrap)return;
  // V2: each column has ONE fold element (actbody.act-fold, .ab-trim-fold, .lst-collapse)
  var fold=wrap.querySelector('.actbody.act-fold,.ab-trim-fold,.lst-collapse,.act-fold');
  if(!fold)return;
  var c=fold.classList.toggle('is-collapsed');
  btn.setAttribute('aria-expanded',c?'false':'true');
  var sh=btn.querySelector('.lm-show'),hi=btn.querySelector('.lm-hide');
  if(sh)sh.style.display=c?'':'none';
  if(hi)hi.style.display=c?'none':'inline';
});

// Stand-aside column (.lst-wrap): theme.js's shared .lst-more handler already
// toggles #dash-hold-fold (.lst-collapse) and flips aria-expanded; the label swap
// is CSS ([aria-expanded] rules in theme.css). A page-scoped duplicate here would
// double-toggle into a no-op — deliberately no handler.

// Action-board row popovers handled by theme.js shared row-pop engine ([data-rpop] / .rp-src).

/* ══════════════════════════════════════════════════════════════════════════════
   PROPHET LIVE P1 — the "Forming today" strip + the ◐ card chips.
   Contract: research/PROPHET_LIVE_P1_DESIGN_SPEC.md §6. Payload:
   prophet_live.states/v1 (engine/prophet_live/live_states.py).

   PRESENTATION-TIER FENCE (spec §6.5, DNR §1). This block writes to EXACTLY two
   places: #prophet-live (its own panel) and .pvcard > .pv-chart > .pv-ov.pv-ovl >
   .pv-live (the reserved chip slot). It never touches card ordering, card
   membership, the pv-* hue class, .pv-chip (verb), .pv-edn (Edge), .pv-stp/.pv-stl
   (stage), .pv-zn (zone), .pv-trg (the nightly ⚡), the table view, or any lane or
   count on the board. The nightly build is the only confirmer.

   VOCABULARY IS LOAD-BEARING (G0.6 + operator 2026-07-27). Nothing here says fired,
   confirmed, triggered-as-past-fact, refuted or falsifier, and nothing claims proven
   statistical standing (the CI claims guard owns that last word). Every
   state settles at tonight's close and every surface below says so, in both
   languages. There is no "live" pulse and no status dot: on a 15-minute-delayed
   plane a green dot is both unreachable and a claim of certainty. The settle rail
   is the sanctioned proof of life — it advances on a local clock, with no fetch.
   ══════════════════════════════════════════════════════════════════════════════ */
var PLV_URL   = 'live/prophet_live.json';
var PLV_EVERY = 120000;   /* ms between fetches — producer writes every ~5 min, so
                             120s bounds staleness at ~2 min for ~2.5 GETs/artifact */
var PLV_FLOOR = 30000;    /* floor on a visibility-triggered refetch */
var PLV_TICK  = 60000;    /* rail clock — no network */
var PLV_CAP   = 3;        /* row slots; the height contract reserves exactly this many */
var PLV_OPEN  = 570;      /* 09:30 ET in minutes — the rail's left edge */
var PLV_CLOSE = 960;      /* 16:00 ET — the rail's right edge, and what settles a read */
var PLV_WAKE  = 560;      /* 09:20 ET — before this "Forming today" has nothing to say */
var PLV_SHUT  = 980;      /* 16:20 ET — past this the strip is CLOSED, never age-dark */
/* 18:30 ET — the nightly build's own cron (.github/workflows/daily.yml `30 22 * * *`,
   single-cron by design so it is 18:30 EDT / 17:30 EST). CLOSED asserts a PENDING
   verdict ("tonight's close settles which ones count"); once the nightly has published,
   the board immediately below has already answered that question, so from here the strip
   has nothing left to say and hides. Running closed to midnight left a ~5.5h window in
   which the strip contradicted the board underneath it. */
var PLV_SETTLE = 1110;
var PLV_FIRST = 575;      /* 09:35 ET — window start 09:25 + the producer's 10-min cron
                             grace. Before this, today's first pass is merely LATE, not a
                             fault, and the strip must not raise an alarm. */
var PLV_MAXAGE = 900000;  /* 15 min = 3 missed passes */
/* CLOSED must not launder a fault that was already disclosed: a producer dead since
   11:00 read honestly dark at 16:17 and then flipped to a confident "closed" with 11:00
   rows at 16:21. The frozen rows only describe the close if the last pass actually
   landed near it, so closed requires a pass within 3 missed passes of 16:00 ET. */
var PLV_CLOSE_PASS = 945; /* 15:45 ET */

var _plvPanel = document.getElementById('prophet-live');
/* ticker → company name, SSR-baked (see the #plv-names island): the payload carries
   no names and a strip row must not be a bare slug on a page that has the name. */
var _plvNames = (function(){
  try{ return JSON.parse((document.getElementById('plv-names')||{}).textContent||'{}')||{}; }
  catch(e){ return {}; }
})();
var _plvData = null, _plvFetchedAt = 0, _plvFetching = false;
var _plvLastMode = null, _plvExpanded = false, _plvClearMin = null;
var _plvEvalN = null, _plvUnprobed = null;
var _plvEtFmt = null;

/* ── ET wall clock ───────────────────────────────────────────────────────────
   Every window in this component is an EASTERN clock window. A UTC-pinned one is
   an hour wrong for half the year (the same trap the P0 cron comments describe),
   and the reader's own timezone is irrelevant to when the US tape settles. */
function _plvEt(d){
  try{
    if(!_plvEtFmt){
      _plvEtFmt = new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',
        hour12:false, weekday:'short', year:'numeric', month:'2-digit', day:'2-digit',
        hour:'2-digit', minute:'2-digit'});
    }
    var parts=_plvEtFmt.formatToParts(d), p={}, i;
    for(i=0;i<parts.length;i++) p[parts[i].type]=parts[i].value;
    var h=parseInt(p.hour,10); if(h===24) h=0;   /* en-US hour12:false prints 24 at midnight */
    return {ymd:p.year+'-'+p.month+'-'+p.day, min:h*60+parseInt(p.minute,10), wd:p.weekday};
  }catch(e){ return null; }
}
/* EN reads a 12-hour clock, ZH a 24-hour one — both are written into the DOM at once
   (l-en/l-zh) so switching language never needs a re-render or a fresh fetch. */
function _plvHm12(m){
  var h=Math.floor(m/60), mm=m%60, ap=h>=12?'pm':'am', h12=h%12;
  if(h12===0) h12=12;
  return h12+':'+(mm<10?'0':'')+mm+' '+ap;
}
function _plvHm24(m){
  var h=Math.floor(m/60), mm=m%60;
  return (h<10?'0':'')+h+':'+(mm<10?'0':'')+mm;
}
/* An ISO stamp as ET minutes-of-day, or null. Never throws, never guesses. */
function _plvTsMin(iso){
  if(!iso) return null;
  var ms=Date.parse(iso);
  if(!isFinite(ms)) return null;
  var et=_plvEt(new Date(ms));
  return et?et.min:null;
}
/* "as of 3:41 pm ET" / "截至 美东 15:41" — ONE as-of for the whole panel (Law 4). */
function _plvAsOf(m){
  return L('as of '+_plvHm12(m)+' ET', '截至 美东 '+_plvHm24(m));
}
function _plvNum(v){
  try{ return Number(v).toLocaleString('en-US'); }catch(e){ return String(v); }
}
/* Write every variant into the box and show one. See the WORST-CASE RESERVATION note in
   the CSS: this is what makes the panel's height independent of which mode is showing,
   at every width and in both languages, without a single measured constant. `order`
   fixes the paint order so the DOM is stable pass to pass. */
function _plvStack(el, order, variants, active){
  var html='', i, k;
  for(i=0;i<order.length;i++){
    k=order[i];
    if(!variants[k]) continue;
    html+='<span class="plv-v'+(k===active?' is-on':'')+'"'
       +(k===active?'':' aria-hidden="true"')+'>'+variants[k]+'</span>';
  }
  if(el.innerHTML!==html) el.innerHTML=html;
}
function _plvPx(v){
  if(v===null||v===undefined||!isFinite(Number(v))) return '—';
  return '$'+Number(v).toFixed(2);
}

/* ── Copy tables (spec §4) ───────────────────────────────────────────────────
   Keyed to MODE, never to the row set: a subtitle that rewrites itself every five
   minutes is its own kind of noise, and holding it stable is also a no-thrash rule. */
/* The delay disclosure stays in CLOSED too (spec owner's ruling, 2026-07-30): the frozen
   rows are still printing intraday prices, so the plane they came from must still be
   named. "settles tonight" moves to the stance line, which already says it. */
var PLV_TOKEN = {
  rth:     ['Intraday · {d}-min delayed', '盘中 · {d}分钟延迟'],
  preopen: ['Pre-open · {d}-min delayed', '盘前 · {d}分钟延迟'],
  dark:    ['Read paused', '判读暂停'],
  closed:  ['Closed · {d}-min delayed', '已收盘 · {d}分钟延迟']
};
var PLV_SUB = {
  live:   ["Crossing now — nothing is settled until tonight's close. Get ready; don't chase.",
           '正在上穿 — 今晚收盘才算数。做好准备，勿追高。'],
  quiet:  ["Nothing crossing right now. Tonight's board below is the plan.",
           '当前没有新的上穿。下方的看板即为今日计划。'],
  dark:   ['The intraday read is paused. The board below is unaffected.',
           '盘中判读暂停。下方看板不受影响。'],
  closed: ["These crossed today — tonight's close settles which ones count.",
           '这些今日已上穿 — 今晚收盘决定哪些成立。']
};
/* Dark causes in PLAIN WORDS. "arming pack", "stale_pack", "out_of_band" and every
   other machine reason stays out of Tier 1 — the reason IS disclosed, in the
   reader's own language. A per-name dark reason never renders as a guessed state. */
var PLV_DARK = {
  no_pack:    ["Today's watch list hasn't loaded, so nothing is being checked.",
               '今日的追踪清单尚未载入，暂无判读。'],
  stale_pack: ['The watch list is out of date, so the intraday read is paused.',
               '追踪清单已过期，盘中判读暂停。'],
  quotes:     ["Prices aren't updating right now, so the intraday read is paused.",
               '价格暂未更新，盘中判读暂停。'],
  /* A cause we DO NOT know. The strip may relay a cause only when the producer attests
     one (status:"dark" + reason); a date mismatch on its own is not evidence of a stale
     watch list. It happens every trading morning between 09:20 and the first pass, ALL
     DAY on every market holiday (no pass runs, so yesterday's file is the newest one),
     and whenever the lane is down — three different causes, and the browser has no NYSE
     calendar to tell them apart. Claiming "the watch list is out of date" in all three
     was a confident wrong cause, so this form names the observable fact instead. */
  none_today: ["There's no intraday read for today.", '今日暂无盘中判读。']
};
/* via selects the word, and "faded" is shown ONLY for via:"drop". An overrun ran
   PAST the range the gate still admits — the opposite trade from falling through
   it, so calling that "faded" would lie about direction and pollute the very axis
   the P0 forward ledger measures. The word "faded" survives in the Tier-2 tip. */
var PLV_CHIP = {
  forming: ['Forming', '正在形成', 'plv-chip--forming'],
  close:   ['Holding into close', '收盘前仍成立', 'plv-chip--close'],
  drop:    ['Fell back', '回落', 'plv-chip--drop'],
  over:    ['Ran past', '越过', 'plv-chip--over']
};
/* CLOSED freezes the rows, so their labels must freeze in the SETTLED tense too: a row
   still reading "Forming" / "正在形成" at 17:00 claims a live state on a tape that has
   stopped. "Crossed" is the sanctioned past tense (the closed stance line already uses
   it); it is a statement about today's tape and still says nothing about the verdict,
   which only the nightly build settles. drop/over are already past tense. */
var PLV_CHIP_PAST = {
  forming: ['Crossed', '已上穿', 'plv-chip--forming'],
  close:   ['Held into close', '收盘时仍成立', 'plv-chip--close'],
  drop:    ['Fell back', '回落', 'plv-chip--drop'],
  over:    ['Ran past', '越过', 'plv-chip--over']
};
var PLV_TIP = {
  forming: ["The same admission test tonight's build will run already passes at today's price, and has held for two checks in a row. Nothing is confirmed: tonight's close decides, and a board seat is settled only by the nightly build. Price is intraday, {d}-minute delayed.",
            '今晚生成时要跑的同一套准入判定，在今日价格下已经通过，并且连续两次检查都成立。但这不是确认：今晚收盘才决定，看板席位只由夜间生成敲定。价格为盘中数据，延迟 {d} 分钟。'],
  close:   ["Still passing with under half an hour of tape left, so today's close is unlikely to move it — but tonight's build is what settles it, and the seat comes with it. Price is intraday, {d}-minute delayed.",
            '距收盘不足半小时仍然通过，今日收盘价大概率不会推翻它 — 但真正结算的是今晚的生成，席位也随之而定。价格为盘中数据，延迟 {d} 分钟。'],
  drop:    ['It crossed earlier today and has since traded back below the cross level, so it faded. Nothing to do; if it crosses again it reappears here after two checks.',
            '今日早前曾上穿，随后回落至上穿价位之下，判读已消退。无需操作；若再次上穿，连续两次检查后会重新出现。'],
  over:    ["It crossed and then ran above the range where the setup is still admitted — it ran past the entry rather than falling through it. Watch — don't chase.",
            '上穿后继续冲高，已越过该形态仍被接受的价格区间 — 属于越过入场区，而非跌破。观察为主 — 勿追高。']
};
/* Card chips (spec §5.4). "Below range" and NOT "at risk": at_risk is an internal
   state name, and every verdict-flavoured phrasing of it invites the reader to hear
   a sell call on an un-graded provisional read, which the watch-don't-chase law
   forbids. "Below range" is an unimpeachable statement about the tape. */
var PLV_CARD = {
  drop:  ['Below range', '低于区间', 'pv-live--drop'],
  over:  ['Ran past', '越过区间', 'pv-live--over'],
  close: ['Holding into close', '收盘前仍成立', 'pv-live--close']
};
var PLV_CARD_TIP = {
  drop:  ["Trading below the price range where tonight's close would still admit this setup. Nothing on the board has changed yet — the verdict re-settles at tonight's close and this card updates with it. Watch — don't chase. This is not a sell call. Intraday price, {d}-minute delayed.",
          '当前价格低于「今晚收盘仍会接受该形态」的价格区间。看板尚未发生任何变化 — 判定将在今晚收盘重新结算，本卡片届时随之更新。观察为主 — 勿追高。这不是卖出建议。盘中价格，延迟 {d} 分钟。'],
  over:  ["Trading above the range where this setup is still admitted — it ran past the entry rather than falling through it. Tonight's close re-settles the verdict. Don't chase; nothing here says sell. Intraday price, {d}-minute delayed.",
          '当前价格高于该形态仍被接受的区间 — 属于越过入场区，而非跌破。今晚收盘会重新结算判定。勿追高；此处并未建议卖出。盘中价格，延迟 {d} 分钟。'],
  close: ["Still passing tonight's admission test with under half an hour of tape left, so today's close is unlikely to change it — but tonight's build is what settles it. Intraday price, {d}-minute delayed.",
          '距收盘不足半小时仍通过今晚的准入判定，今日收盘价大概率不会改变它 — 但真正结算的是今晚的生成。盘中价格，延迟 {d} 分钟。']
};
/* delay_min is the house delayMin convention: the VENDOR FLOOR, not a measured
   latency. A null delay prints "delayed" with no number — never a guessed 15. */
function _plvDelay(meta){
  var d = meta && meta.delay_min;
  return (d===null||d===undefined||!isFinite(Number(d))) ? null : Number(d);
}
function _plvFill(s, d){
  /* A null delay drops the NUMBER, never the disclosure: "15-min delayed" becomes
     "delayed" and the sentence still reads. Guessing 15 would be inventing a vendor
     floor the payload declined to state. */
  if(d===null){
    return s.replace('{d}-minute ','').replace('{d}-min ','')
            .replace('延迟 {d} 分钟','延迟').replace('{d}分钟延迟','延迟');
  }
  return s.split('{d}').join(String(d));
}

/* ── Row selection (spec §6.3) ────────────────────────────────────────────────
   This is the EDITORIAL FENCE, not a display of `states`. The strip speaks only for
   names that crossed TODAY and are not on last night's board (entered:"cross").
   Board names get a card chip and never a strip row — a strip that also listed the
   ~44 holding board names would be a state dump, and the board below already says
   it. dormant / near / per-name dark names are counted in the footer's coverage
   sentence, never listed: a dark name has nothing to say. */
function _plvPick(states){
  var out=[], tk, st, kind;
  for(tk in states){
    if(!Object.prototype.hasOwnProperty.call(states,tk)) continue;
    st = states[tk] || {};
    if(st.entered !== 'cross') continue;
    if(st.confirming_into_close) kind='close';
    else if(st.state==='forming') kind='forming';
    else if(st.state==='faded') kind = (st.via==='overrun') ? 'over' : 'drop';
    else continue;
    out.push({tk:tk, kind:kind, st:st,
              rank:(kind==='close'?0:(kind==='forming'?1:2)),
              since:_plvTsMin(st.since_ts)});
  }
  /* Deterministic and stable, recomputed identically on every pass: group, then the
     longest-held first (it is the most settled), then ticker — so the order can
     never depend on object key iteration order. */
  out.sort(function(a,b){
    if(a.rank!==b.rank) return a.rank-b.rank;
    var as=(a.since===null?1e9:a.since), bs=(b.since===null?1e9:b.since);
    if(as!==bs) return as-bs;
    return a.tk<b.tk?-1:(a.tk>b.tk?1:0);
  });
  return out;
}
/* A faded row is NEVER the silent cut: a reader who saw a name forming twenty
   minutes ago must not find it deleted without a word. "One of these stopped
   holding" outranks the third concurrent cross. */
function _plvCapRows(rows, cap){
  if(rows.length<=cap) return rows.slice();
  var faded=[], active=[], i;
  for(i=0;i<rows.length;i++)(rows[i].rank===2?faded:active).push(rows[i]);
  if(!faded.length) return rows.slice(0,cap);
  /* "The most recent" means the LATEST since_ts, and it has to be picked by that field.
     Taking the last element of the group instead read whichever name sorted last, which
     with no since_ts present is simply the alphabetically last ticker (measured: MSFT out
     of AAPL/CSCO/LFUS/MRP/MSFT) — a silent ordering claim the code did not honour. When
     no faded row carries a since_ts there is no "most recent" to be had, and the ticker
     tiebreak is the honest arbitrary fallback rather than a claim. */
  var keepFaded=faded[faded.length-1], best=null;
  for(i=0;i<faded.length;i++){
    if(faded[i].since===null) continue;
    if(best===null||faded[i].since>best.since) best=faded[i];
  }
  if(best) keepFaded=best;
  /* With faded rows but NO active ones, active.slice(0, cap-1) is empty and a single row
     rendered inside a three-row body under a "+4 more" button. Nothing is competing for
     the slots, so fill them. */
  if(!active.length) return faded.slice(Math.max(0,faded.length-cap));
  return active.slice(0,Math.max(0,cap-1)).concat([keepFaded]);
}

/* The level this row crossed. `cross_level_px` for a cross row, `fade_px` for a board
   row — the presence of the key IS which quantity it is, so they are read by name and
   never merged. There is deliberately no `cross_px` here: the forward ledger's `cross_px`
   is a DIFFERENT quantity (a fill price), and reading it into this column would print one
   number under another number's label. Absent ⇒ em-dash, never derived. */
function _plvLevel(st){
  if(st.cross_level_px!==undefined&&st.cross_level_px!==null) return st.cross_level_px;
  if(st.fade_px!==undefined&&st.fade_px!==null) return st.fade_px;
  return null;
}

function _plvRowHtml(r, delay, past){
  var c=(past?PLV_CHIP_PAST:PLV_CHIP)[r.kind], tip=PLV_TIP[r.kind], st=r.st;
  var tipEn=_plvFill(tip[0],delay), tipZh=_plvFill(tip[1],delay);
  if(r.since!==null){
    /* SINCE is demoted below 680px (spec §3); it survives here so a narrow reader
       still learns how long the read has held. */
    tipEn+=' Since '+_plvHm24(r.since)+' ET.';
    tipZh+=' 起始 美东 '+_plvHm24(r.since)+'。';
  }
  /* Cross level and SINCE both degrade to an em-dash rather than to a derived
     number: passes × 5 min is not a lawful duration (GitHub cron lands minutes
     late) and a level this payload does not carry must not be invented. */
  var lvl=_plvLevel(st);
  return '<span class="plv-chip '+c[2]+'" data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'">◐ '+L(esc(c[0]),esc(c[1]))+'</span>'
    +'<span class="plv-tk">'+esc(r.tk)+'</span>'
    +'<span class="plv-nm">'+esc(r.name||'')+'</span>'
    +'<span class="plv-now">'+_plvPx(st.price)+'</span>'
    +'<span class="plv-lvl">'+_plvPx(lvl)+'</span>'
    +'<span class="plv-since">'+(r.since===null?'—':_plvHm24(r.since))+'</span>';
}

/* KEYED RECONCILIATION, never `innerHTML =` on #plv-body (spec §6.4 rule 2).
   Wholesale replacement flashes every row and kills an open hover tip mid-read, so
   rows are patched in place by data-plv-tk and only the delta moves. */
function _plvPaintRows(body, rows, delay, past){
  var els=[], i, r, el, sig;
  for(i=0;i<rows.length;i++){
    r=rows[i];
    el=body.querySelector('.plv-row[data-plv-tk="'+r.tk+'"]');
    sig=r.kind+'|'+r.st.price+'|'+r.since+'|'+_plvLevel(r.st)+'|'+(r.name||'')+'|'+(past?'p':'l');
    if(!el){
      el=document.createElement('a');
      el.setAttribute('data-plv-tk', r.tk);
      el.href='stock.html#'+encodeURIComponent(r.tk);
      el.innerHTML=_plvRowHtml(r, delay, past);
      el.className='plv-row is-new'+(r.rank===2?' is-past':'');
    }else{
      if(el.getAttribute('data-plv-sig')!==sig) el.innerHTML=_plvRowHtml(r, delay, past);
      el.className='plv-row'+(r.rank===2?' is-past':'');
    }
    el.setAttribute('data-plv-sig', sig);
    els.push(el);
  }
  /* place in order, moving only what is actually out of place */
  for(i=0;i<els.length;i++){
    if(body.children[i]!==els[i]) body.insertBefore(els[i], body.children[i]||null);
  }
  while(body.children.length>els.length) body.removeChild(body.lastElementChild);
}
/* The empty body FILLS the same reserved 75.5px (.plv-none is flex:1) — it never has
   a height of its own, so quiet / dark / closed measure identical to a 3-row live
   strip and nothing below the panel ever moves. */
function _plvPaintNone(body, en, zh, lastMin, isDark){
  var cls='plv-none'+(isDark?' plv-none--dark':'');
  var html=L(esc(en),esc(zh));
  if(lastMin!==null&&lastMin!==undefined){
    html+='<span class="plv-last">'+L('Last clear read '+_plvHm12(lastMin)+' ET.',
                                      '最近一次有效判读 美东 '+_plvHm24(lastMin)+'。')+'</span>';
  }
  var el=body.firstElementChild;
  if(!el||body.children.length!==1||el.className!==cls){
    while(body.firstChild) body.removeChild(body.firstChild);
    el=document.createElement('div'); el.className=cls; body.appendChild(el);
  }
  if(el.innerHTML!==html) el.innerHTML=html;
}

/* ── Card chips (spec §5) ────────────────────────────────────────────────────
   The ONLY node this touches on a card is its reserved .pv-live span. Absent state
   ⇒ hidden + empty ⇒ zero width and zero layout change, so a board with no live
   state renders byte-equivalent to today's. */
function _plvPaintCards(states, delay){
  var slots=document.querySelectorAll('.pvcard[data-ticker] .pv-ov.pv-ovl > .pv-live'), i, el, card, st, kind, c, tip;
  for(i=0;i<slots.length;i++){
    el=slots[i]; card=el.closest?el.closest('.pvcard'):null;
    st=(card&&states)?(states[card.getAttribute('data-ticker')]||null):null;
    kind=null;
    if(st&&st.entered==='board'){
      if(st.confirming_into_close) kind='close';
      else if(st.state==='at_risk') kind=(st.via==='overrun')?'over':'drop';
    }
    if(!kind){
      if(!el.hidden){ el.hidden=true; el.className='pv-live'; el.innerHTML=''; el.removeAttribute('data-tip-en'); el.removeAttribute('data-tip-zh'); }
      continue;
    }
    c=PLV_CARD[kind]; tip=PLV_CARD_TIP[kind];
    el.className='pv-live '+c[2];
    el.setAttribute('data-tip-en', _plvFill(tip[0],delay));
    el.setAttribute('data-tip-zh', _plvFill(tip[1],delay));
    var html='◐ '+L(esc(c[0]),esc(c[1]));
    if(el.innerHTML!==html) el.innerHTML=html;
    el.hidden=false;
  }
}

/* ── The settle rail ────────────────────────────────────────────────────────
   Filled 09:30 → 16:00 with a now-tick on a local 60-second clock and NO fetch. It
   encodes the only variable that converts "forming" into "confirmed": remaining
   tape. The single inline style this whole component writes is this width/left. */
function _plvRail(){
  if(!_plvPanel||!_plvPanel.classList.contains('visible')) return;
  var et=_plvEt(new Date()); if(!et) return;
  var pct=Math.max(0,Math.min(100,(et.min-PLV_OPEN)/(PLV_CLOSE-PLV_OPEN)*100));
  var f=document.getElementById('plv-rail-fill'), n=document.getElementById('plv-rail-now');
  if(f) f.style.width=pct.toFixed(1)+'%';
  if(n) n.style.left=pct.toFixed(1)+'%';
}

/* ── Mode resolution (spec §6.2, first match wins) ──────────────────────────── */
function _plvMode(d, et){
  /* 1. Weekends, the overnight hours, and everything after the nightly build has
        settled the day: "Forming today" has nothing to say, so the strip is not
        rendered at all. The upper bound is the nightly handoff, NOT midnight — past it
        the board below carries the answer and a pending-verdict strip would contradict
        it. (The spec's own §6.2 rule 1 upper bound of 16:20 made rule 3 unreachable;
        this is the bound that keeps rule 3 alive without inventing a false-tense
        window.) */
  if(et.wd==='Sat'||et.wd==='Sun') return null;
  if(et.min<PLV_WAKE||et.min>=PLV_SETTLE) return null;
  if(!d||!d.meta) return null;
  /* 2. A frozen file must NEVER present as today — but the strip must not GUESS why.
        Before today's first pass is even due it is not a fault at all, so say nothing;
        after that, name the observable fact and not a cause we cannot see (m1). */
  if(d.meta.session_et&&d.meta.session_et!==et.ymd){
    if(et.min<PLV_FIRST) return null;
    return {mode:'dark', why:'none_today'};
  }
  /* 3. Post-close. Deliberately AHEAD of the age gates: without this rule the
        15-minute staleness gate fires every single evening and the strip lies
        "prices aren't updating" after every close — a nightly lie, not an edge case.
        But it must not launder a fault either, so the last pass has to have landed
        near the close for the frozen rows to be describing it (m2). */
  if(et.min>PLV_SHUT){
    var cms=_plvTsMin(d.meta.pass_ts);
    if(d.status!=='dark'&&cms!==null&&cms>=PLV_CLOSE_PASS) return {mode:'closed', why:null};
    return {mode:'dark', why:(d.reason==='no_pack'?'no_pack':(d.reason==='stale_pack'?'stale_pack':'quotes'))};
  }
  /* 4. The producer itself declined to speak — this is the one cause it ATTESTS. */
  if(d.status==='dark') return {mode:'dark', why:(d.reason==='no_pack'?'no_pack':(d.reason==='stale_pack'?'stale_pack':'quotes'))};
  /* 5. Three missed passes — the file is no longer describing the current tape. Not
        before the day's first pass is due, though: late is not broken (m1). */
  var pms=Date.parse(d.meta.pass_ts||'');
  if(isFinite(pms)&&(Date.now()-pms)>PLV_MAXAGE&&et.min>=PLV_FIRST) return {mode:'dark', why:'quotes'};
  /* 6. Speaking a confident "quiet tape" while more than half the armed names are
        unreadable is degraded-ships-confident. */
  var dc=d.meta.dark_counts||{}, sum=0, k;
  for(k in dc){ if(Object.prototype.hasOwnProperty.call(dc,k)) sum+=Number(dc[k])||0; }
  var ev=Number(d.meta.evaluated_n);
  if(isFinite(ev)&&ev>0&&(sum/ev)>=0.5) return {mode:'dark', why:'quotes'};
  return {mode:'live', why:null};   /* refined to 'quiet' once rows are known */
}

function _plvHide(){
  if(!_plvPanel) return;
  _plvPanel.classList.remove('visible');
  _plvPanel.hidden=true;
  _plvLastMode=null;
  /* THE CARD CHIPS GO WITH IT. Hiding the panel alone left a "Below range" chip painted
     on a card with no as-of stamp, no delay pill and no strip left to explain it — a tab
     open past the nightly handoff, or across a weekend, showed a stale intraday read
     presenting as current. Surface 2 has no freshness disclosure of its own; the strip
     IS its disclosure, so the two must appear and disappear together. */
  _plvPaintCards(null, null);
}

function _plvRender(){
  if(!_plvPanel) return;
  var et=_plvEt(new Date());
  if(!et){ _plvHide(); return; }
  var res=_plvMode(_plvData, et);
  if(!res){ _plvHide(); return; }
  var d=_plvData, meta=d.meta||{}, delay=_plvDelay(meta);
  /* closed/dark keep the SAME SESSION's last per-name states: a dark artifact carries
     them under prev_states precisely so one bad pass cannot erase the day. */
  var states=(d.status==='dark')?(d.prev_states||{}):(d.states||{});
  var rows=(res.mode==='dark')?[]:_plvPick(states);
  var mode=res.mode;
  if(mode==='live'&&!rows.length) mode='quiet';

  /* Company names come from the SSR island below the strip (us_standouts buy ∪ watch
     ∪ leaders ∪ laggards — the near-decision population the pack arms from), so the
     strip adds no second fetch. Names ship EN-only in both languages, the existing
     card norm. Absent name ⇒ the ticker alone, which is the identity anyway. */
  var i;
  for(i=0;i<rows.length;i++) rows[i].name=_plvNames[rows[i].tk]||'';

  var visRows=_plvCapRows(rows, _plvExpanded?rows.length:PLV_CAP);
  var hidden=rows.length-visRows.length;

  /* token + as-of: the freshness form, on every live number, always together. Every
     token variant is stacked so the PILL'S WIDTH is the same in every mode — a short
     "READ PAUSED" used to fit beside the title where the long one wrapped, which moved
     the as-of onto its own line and changed the header's height with the mode. */
  var tokEl=document.getElementById('plv-token'), asEl=document.getElementById('plv-asof');
  var tkKey=(mode==='dark')?'dark':(mode==='closed')?'closed'
            :(meta.session_phase==='preopen')?'preopen':'rth';
  var tkVars={}, tkK;
  for(tkK in PLV_TOKEN){
    if(!Object.prototype.hasOwnProperty.call(PLV_TOKEN,tkK)) continue;
    tkVars[tkK]=L(esc(_plvFill(PLV_TOKEN[tkK][0],delay)), esc(_plvFill(PLV_TOKEN[tkK][1],delay)));
  }
  tokEl.className='plv-token'+(mode==='dark'?' is-dark':(mode==='closed'?' is-closed':''));
  _plvStack(tokEl, ['rth','preopen','dark','closed'], tkVars, tkKey);

  /* The stamp is the ARTIFACT's own clock — meta.quote_asof, falling back to the pass
     time. Never the browser clock: a local Date.now() would print a fresh-looking time
     over a stale artifact, which is the exact lie the freshness gate exists to prevent. */
  var stampMin=_plvTsMin(meta.quote_asof)||_plvTsMin(meta.pass_ts);
  /* No stamp when the newest artifact is from ANOTHER DAY. The as-of is a bare
     time-of-day, so a previous session's pass would print "as of 4:15 pm ET" at 11:20 in
     the morning — a stamp that reads as today's. There is no current read to stamp here,
     and the body line already says exactly that.
     BUT THE BOX STILL HAS TO HOLD ITS LINE. This is the fourth mode-varying box and the
     one the first reservation pass missed: at <=340px the header puts the as-of on line 2
     beside the token, so emptying it collapsed that line and shoved the board 17.00px —
     the honesty fix above paying for itself in exactly the layout thrash the reserver
     exists to prevent. A reader on a 320-340px phone would watch the board jump the
     instant the day's first pass landed. Same mechanism as the other three: reserve the
     line, show nothing in it.
     The reserver is a formatter-built stamp at 12:00 — the widest wall clock this box can
     render (two-digit hour, and the pass window is 09:20-18:30 ET so nothing exceeds it),
     exact because .plv-asof is tabular-nums. Built by _plvAsOf itself so it cannot drift
     from the real thing's markup.
     'on' is ALWAYS the active key: with no stamp it is the empty string, which _plvStack
     drops, so the reserver holds the box with nothing visible and nothing announced. The
     reserver must never be the active variant — a visible 12:00 would be a fabricated
     stamp, which is the very thing the honesty fix removed. */
  var stampOn=(stampMin!==null&&res.why!=='none_today');
  _plvStack(asEl, ['on','rsv'],
            {on:(stampOn?_plvAsOf(stampMin):''), rsv:_plvAsOf(720)}, 'on');

  /* the stance line changes ONLY on a mode change (spec §6.4 rule 5), and all four
     stance lines stay stacked so the box reserves the tallest one at this width */
  if(mode!==_plvLastMode){
    var subVars={}, subK;
    for(subK in PLV_SUB){
      if(!Object.prototype.hasOwnProperty.call(PLV_SUB,subK)) continue;
      subVars[subK]=L(esc(PLV_SUB[subK][0]),esc(PLV_SUB[subK][1]));
    }
    _plvStack(document.getElementById('plv-sub'), ['live','quiet','dark','closed'],
              subVars, PLV_SUB[mode]?mode:'quiet');
    _plvLastMode=mode;
  }

  var body=document.getElementById('plv-body');
  if(mode==='dark'){
    var dk=PLV_DARK[res.why]||PLV_DARK.quotes;
    _plvPaintNone(body, dk[0], dk[1], _plvClearMin, true);
  }else if(!visRows.length){
    var lastMin=(stampMin===null)?null:stampMin;
    if(mode==='closed'){
      _plvPaintNone(body, 'Nothing crossed today — last checked '+(lastMin===null?'—':_plvHm12(lastMin))+' ET.',
                          '今日没有出现上穿 — 最近一次检查 美东 '+(lastMin===null?'—':_plvHm24(lastMin))+'。', null, false);
    }else{
      _plvPaintNone(body, 'Nothing crossing yet — last checked '+(lastMin===null?'—':_plvHm12(lastMin))+' ET.',
                          '尚无新的上穿 — 最近一次检查 美东 '+(lastMin===null?'—':_plvHm24(lastMin))+'。', null, false);
    }
  }else{
    _plvPaintRows(body, visRows, delay, mode==='closed');
  }
  if(mode!=='dark'&&stampMin!==null) _plvClearMin=stampMin;

  /* +N more: collapsed height stays constant and clicking drops the cap — a
     USER-initiated reflow, which is the only kind this component allows. */
  var more=document.getElementById('plv-more');
  if(hidden>0||_plvExpanded){
    more.hidden=false;
    more.setAttribute('aria-expanded', _plvExpanded?'true':'false');
    more.innerHTML=_plvExpanded?L('Show fewer','收起'):L('+'+hidden+' more','还有 '+hidden+' 只');
  }else{ more.hidden=true; more.innerHTML=''; more.setAttribute('aria-expanded','false'); }

  /* ONE footer sentence, once: this line owns the coverage bound.
     WHAT evaluated_n IS. `meta.evaluated_n` is len(states) — the names this pass could
     actually SPEAK ABOUT, i.e. the PROBED count. It is not the pack's armed_n and it is
     not the scored census, and `live_states.py` / `armed_pack.py` both warn in so many
     words against reading it as either. The gap to the universe is also not one cause:
     `max_probe` (180) means names are dropped for BUDGET as well as for distance from a
     decision, and those land in `meta.unprobed`/`unprobed_n`. So this line says only what
     is true — how many were checked — and the Tier-2 receipt splits the gap.
     evaluated_n is sticky across a dark pass so the figure does not blink; without one
     ever seen the sentence drops the figure rather than guessing it. */
  var ev=Number(meta.evaluated_n);
  if(isFinite(ev)&&ev>0) _plvEvalN=ev;
  var unpr=Number(meta.unprobed_n);
  if(isFinite(unpr)&&unpr>=0) _plvUnprobed=unpr;
  /* How many of the checked names came back unreadable THIS pass. A hard 50% cliff alone
     shipped a fully confident header at 49% dark; disclosing the count means the reader
     always knows how much of the check actually landed. */
  var dcs=0, dck, dcm=meta.dark_counts||{};
  for(dck in dcm){ if(Object.prototype.hasOwnProperty.call(dcm,dck)) dcs+=Number(dcm[dck])||0; }
  var fnEl=document.getElementById('plv-fn');
  /* The sticky count is a claim about a pass that ran. On a day where none did, carrying
     the previous session's figure would say "62 names were checked intraday" when the
     answer is none — so that day gets the numberless form. */
  var cnt=(_plvEvalN&&res.why!=='none_today')?('<b class="plv-fig">'+_plvNum(_plvEvalN)+'</b>'):null;
  var fnEn=cnt
    ? 'Only the '+cnt+' names checked intraday can appear here — every read settles at tonight’s close.'
    : 'Only the names checked intraday can appear here — every read settles at tonight’s close.';
  var fnZh=cnt
    ? '盘中只检查了 '+cnt+' 只，只有它们会出现在这里 — 此处所有判读均以今晚收盘为准。'
    : '盘中只检查了部分标的，只有它们会出现在这里 — 此处所有判读均以今晚收盘为准。';
  if(dcs>0&&mode!=='dark'){
    fnEn+=' <b class="plv-fig">'+_plvNum(dcs)+'</b> of them could not be read this pass.';
    fnZh+='其中 <b class="plv-fig">'+_plvNum(dcs)+'</b> 只本次未能读取。';
  }
  /* The reserver is never shown and never read (visibility:hidden takes it out of the
     accessibility tree) — it exists only so the footer's box is the height of its LONGEST
     form at this width. Without it the dark mode's shorter sentence wrapped to one line
     fewer and shoved the board by 15.75px. The four-digit placeholders are a LINE BOX,
     not a claim: no real count exceeds the 1,578-name scored universe. */
  var rsvEn='Only the <b class="plv-fig">0,000</b> names checked intraday can appear here — every read settles at tonight’s close. <b class="plv-fig">0,000</b> of them could not be read this pass.';
  var rsvZh='盘中只检查了 <b class="plv-fig">0,000</b> 只，只有它们会出现在这里 — 此处所有判读均以今晚收盘为准。其中 <b class="plv-fig">0,000</b> 只本次未能读取。';
  _plvStack(fnEl, ['on','rsv'], {on:L(fnEn,fnZh), rsv:L(rsvEn,rsvZh)}, 'on');

  /* Tier-2 receipt: the debounce mechanic, the delay mechanic, the coverage receipt
     and the seat-honesty clause (a forming name qualifies on its own signal; the
     SEAT settles only at the nightly build, so no copy may promise one). */
  var help=document.getElementById('plv-help');
  if(help){
    /* The coverage RECEIPT, and the one place the gap may be broken down. It must not
       say "armed" (evaluated_n is the probed count, not the pack's armed_n) and it must
       not blame the whole gap on distance from a decision (max_probe drops names for
       budget too — that is what unprobed_n counts). So: checked, not-checked, and the two
       reasons named as two reasons. */
    var uni=_plvPanel.getAttribute('data-universe');
    var cov = _plvEvalN
      ? [_plvNum(_plvEvalN)+' names were checked intraday'
         +(uni?(' out of '+_plvNum(uni)+' scored'):'')+'.'
         +(_plvUnprobed
           ? (' The other '+_plvNum(_plvUnprobed)+' were not checked today — most sit too far'
              + ' from a decision to matter, and the rest were beyond what one 5-minute pass'
              + ' can cover.')
           : ' The rest of the scored list was not checked today.'),
         '盘中检查了 '+_plvNum(_plvEvalN)+' 只'+(uni?('（全部评分股票 '+_plvNum(uni)+' 只）'):'')+'。'
         +(_plvUnprobed
           ? ('其余 '+_plvNum(_plvUnprobed)+' 只今日未检查 — 多数距离临界太远，其余受单次 5 分钟'
              + '扫描的时间预算所限。')
           : '评分名单中的其余标的今日未检查。')]
      : ['Only a subset of the scored list is checked intraday each pass; the rest is not checked at all.',
         '每次扫描只检查评分名单中的一部分，其余完全未检查。'];
    var hEn='Forming means the same admission test tonight’s build will run already passes at today’s price — re-checked every 5 minutes on a '+(delay===null?'delayed':delay+'-minute-delayed')+' quote. A level must hold two checks in a row (about 10 minutes) before it appears here. Tonight’s build is the only thing that confirms a signal or hands out a board seat. '+cov[0];
    var hZh='「正在形成」的含义是：今晚生成时要跑的同一套准入判定，在今日价格下已经通过 — 每 5 分钟用'+(delay===null?'延迟':'延迟 '+delay+' 分钟的')+'报价重跑一次。某个价位必须连续两次检查都成立（约 10 分钟）才会出现在这里。只有今晚的生成才能确认信号、才能给出看板席位。'+cov[1];
    var hen=help.querySelector('.l-en'), hzh=help.querySelector('.l-zh');
    if(hen&&hen.textContent!==hEn) hen.textContent=hEn;
    if(hzh&&hzh.textContent!==hZh) hzh.textContent=hZh;
    /* the icon may already be upgraded — theme.js reads the ATTRIBUTES after that */
    if(help.hasAttribute('data-tip-en')){
      help.setAttribute('data-tip-en',hEn); help.setAttribute('data-tip-zh',hZh);
    }else if(window.upgradeHelpIcons){ window.upgradeHelpIcons(_plvPanel); }
  }

  _plvPanel.classList.toggle('is-dark', mode==='dark');
  _plvPanel.classList.toggle('is-closed', mode==='closed');
  _plvPanel.classList.toggle('is-empty', !visRows.length);
  _plvPanel.hidden=false;
  _plvPanel.classList.add('visible');
  _plvPaintCards(mode==='dark'?null:states, delay);
  _plvRail();
}

function _plvFetch(){
  if(_plvFetching) return;
  _plvFetching=true;
  fetch(PLV_URL,{cache:'no-cache'})
    .then(function(r){ if(!r.ok) throw 0; return r.json(); })
    .then(function(j){
      if(j&&typeof j==='object'&&j.schema&&String(j.schema).indexOf('prophet_live.states/')===0){
        _plvData=j; _plvFetchedAt=Date.now();
      }
      _plvFetching=false;
      _plvRender();
    })
    .catch(function(){
      /* Graceful-absent (FT-R8): no file on first load ⇒ the panel simply never
         appears. A LATER failure keeps the last good render until the age gate in
         _plvMode trips it to dark — an old read must never present as current. */
      _plvFetching=false;
      if(_plvData) _plvRender();
    });
}

if(_plvPanel){
  /* First fetch is UNCONDITIONAL. Never gate the initial paint on document.hidden:
     the preview pane renders with visibility:hidden, so a visibility-gated first
     fetch produces a permanently empty strip in every verification screenshot. */
  _plvFetch();
  setInterval(function(){ if(!document.hidden) _plvFetch(); }, PLV_EVERY);
  setInterval(_plvRail, PLV_TICK);
  document.addEventListener('visibilitychange', function(){
    if(!document.hidden&&(Date.now()-_plvFetchedAt)>PLV_FLOOR) _plvFetch();
  });
  document.getElementById('plv-more').addEventListener('click', function(e){
    e.preventDefault();
    _plvExpanded=!_plvExpanded;
    _plvRender();
  });
  /* language flip: every string is already in the DOM as an l-en/l-zh pair, so the
     CSS switch is the whole re-render. Only the ET clock format needs a repaint. */
  window.addEventListener('languagechange', function(){ if(_plvData) _plvRender(); });
}

})();
</script>
<script src="stocktable.js"></script>
<script>
/* W8-R6: USStockTable init — standout board table view (US market).
   Mirrors the CN implementation (china.html.j2 StockTable init block).
   Safe no-op if stocktable data element is absent. */
(function(){
function initStockTableView(){
  if (!window.StockTable) return;
  /* SECZH: keyed on GICS-style names as emitted by us_standouts producer
     (Information Technology / Financials / Consumer Discretionary / Health Care …)
     NOT Yahoo-style names (Technology / Financial Services / Consumer Cyclical / Healthcare).
     Keep in sync with engine/entry_signal.py sector taxonomy. */
  var SECZH = {
    "Information Technology":"信息技术","Financials":"金融","Consumer Discretionary":"可选消费",
    "Health Care":"医疗保健","Communication Services":"通信服务","Consumer Staples":"必需消费",
    "Industrials":"工业","Energy":"能源","Materials":"原材料","Real Estate":"房地产",
    "Utilities":"公用事业"
  };
  var LANE_LABELS_EN = {"bottoming":"Bottoming","continuation":"Continuation","trend":"Trend","recovery":"Recovery","watch":"Watch"};
  var LANE_LABELS_ZH = {"bottoming":"筑底","continuation":"延续","trend":"趋势","recovery":"复苏","watch":"观察"};
  var SECTOR_LABELS = {}; Object.keys(SECZH).forEach(function(k){ SECTOR_LABELS[k] = [k, SECZH[k]]; });
  var LANE_LABELS = {}; Object.keys(LANE_LABELS_EN).forEach(function(k){ LANE_LABELS[k] = [LANE_LABELS_EN[k], LANE_LABELS_ZH[k] || LANE_LABELS_EN[k]]; });
  /* ENTRY_STATUS maps: keyed on all values emitted by entry_signal.status producer.
     Vocabulary: buy_now, partial, buy_soon, await_confluence, hold, wait_pullback,
                 extended, bounce_wait, watch, avoid, topping, blocked, exit.
     Any unmapped key falls through to the raw token (visible bug) — extend both maps
     when the producer vocabulary changes. */
  var ENTRY_STATUS_EN = {
    "buy_now":"Buy now","partial":"Partial buy",
    "buy_soon":"Buy soon","await_confluence":"Await confluence",
    "hold":"Hold","wait_pullback":"Wait — pullback",
    "wait":"Wait","extended":"Extended","bounce_wait":"Bounce — wait",
    "watch":"Watch","avoid":"Avoid","topping":"Topping","blocked":"Blocked","exit":"Exit"
  };
  var ENTRY_STATUS_ZH = {
    "buy_now":"立即买入","partial":"分批买入",
    "buy_soon":"即将买入","await_confluence":"等待共振",
    "hold":"持有","wait_pullback":"等待回调",
    "wait":"等待","extended":"过热","bounce_wait":"反弹观望",
    "watch":"观察","avoid":"回避","topping":"做顶","blocked":"封锁","exit":"退出"
  };
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum;

  var cols = [
    { key:'lane', labelEn:'Lane', labelZh:'通道', default:true, sortable:true,
      fmt:function(v){
        if(!v) return '<span class="st-muted">—</span>';
        var len = LANE_LABELS_EN[v] || v;
        var lzh = LANE_LABELS_ZH[v] || v;
        var cls = v==='bottoming'?'st-chip-entry':v==='watch'?'st-chip-ran':'st-chip-lane';
        return '<span class="st-chip '+cls+'">' + b(esc(len), esc(lzh)) + '</span>';
      },
      tip:{en:'Cycle lane (system order preserved — table view does not re-sort by default)',zh:'周期通道（保留系统顺序）'} },
    { key:'ticker', labelEn:'Ticker', labelZh:'代码', default:true, sortable:true,
      fmt:function(v,r){
        var entOpen = r.entry_status==='buy_now'||r.entry_status==='partial';
        return (entOpen?'<span class="st-pos" style="display:inline-block;width:7px;height:7px;border-radius:50%;background:currentColor;margin-right:4px;vertical-align:2px"></span>':'') + '<b>' + esc(v||'') + '</b>';
      },
      tip:{en:'Green dot = entry window open now',zh:'绿点＝现在入场窗口已开'} },
    { key:'name', labelEn:'Name', labelZh:'名称', default:true, sortable:true,
      fmt:function(v){ return '<b>' + esc(v||'') + '</b>'; }},
    { key:'sector', labelEn:'Sector', labelZh:'板块', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return b(esc(v), esc(SECZH[v]||v)); }},
    { key:'price', labelEn:'Price', labelZh:'价格', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':'$'+fn(v,2); }},
    { key:'conviction_score', labelEn:'Score', labelZh:'评分', default:true, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v); var cls = n>=70?'st-pos':n>=40?'':'st-neg';
        return '<span class="'+cls+'">'+n+'</span>'; },
      tip:{en:'Conviction buy-readiness score 0–100',zh:'信念买入就绪度 0–100'} },
    { key:'alpha', labelEn:'Alpha', labelZh:'Alpha', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="'+(v>0?'st-pos':v<0?'st-neg':'')+'">'+fp(v*100,2)+'</span>'; },
      tip:{en:'Sector-neutral residual momentum (display context — ranking leg)',zh:'行业中性残差动量（展示情境）'} },
    { key:'off_high', labelEn:'Off High', labelZh:'距高点', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v,1); },
      tip:{en:'% off 52-week high',zh:'距52周高点百分比'} },
    { key:'entry_status', labelEn:'Entry', labelZh:'入场', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        var en = ENTRY_STATUS_EN[v]||v; var zh = ENTRY_STATUS_ZH[v]||v;
        var cls = (v==='buy_now'||v==='partial'||v==='buy_soon')?'st-pos':(v==='extended'||v==='avoid'||v==='topping'||v==='blocked'||v==='exit')?'st-neg':'';
        return '<span class="'+cls+'">'+b(esc(en),esc(zh))+'</span>'; },
      tip:{en:'Entry signal status from the cycle engine',zh:'周期引擎入场信号状态'} },
    { key:'factor_z', labelEn:'Factor Z', labelZh:'因子Z', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="'+(v>0?'st-pos':v<0?'st-neg':'')+'">'+fn(v,1)+'</span>'; },
      tip:{en:'Cross-sectional factor composite z-score (value / quality / low-vol)',zh:'横截面因子综合z分（价值/质量/低波）'} },
    { key:'sue_z', labelEn:'SUE Z', labelZh:'盈利动量', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="'+(v>0?'st-pos':v<0?'st-neg':'')+'">'+fn(v,1)+'</span>'; },
      tip:{en:'Earnings momentum z vs S&P 1500 (post-earnings-announcement drift context; display only)',zh:'盈利动量z（相对标普1500，展示情境）'} },
    { key:'insider_buyers', labelEn:'Insider', labelZh:'内部人', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': '<span class="st-pos">'+esc(String(v))+' 👤</span>'; },
      tip:{en:'# distinct insiders net-bought in the last 6 months (Form-4 cluster — context only)',zh:'近6个月净买入的不同内部人数量（Form-4集群，情境）'} },
  ];

  /* ── view persistence ── */
  var LS_VIEW = 'mdx_stocktable_us';
  var currentView = localStorage.getItem(LS_VIEW) || 'grid';

  function applyView(v) {
    currentView = v;
    localStorage.setItem(LS_VIEW, v);
    var el = document.getElementById('us-standouts');
    var chipsEl = document.getElementById('st-count-chips');
    var gbtn = document.getElementById('us-st-btn-grid');
    var tbtn = document.getElementById('us-st-btn-table');
    if (!el) return;
    if (v === 'table') {
      el.classList.add('st-table-mode');
      if (chipsEl) chipsEl.style.display = '';
      if (gbtn) gbtn.setAttribute('aria-selected','false');
      if (tbtn) tbtn.setAttribute('aria-selected','true');
    } else {
      el.classList.remove('st-table-mode');
      if (chipsEl) chipsEl.style.display = 'none';
      if (gbtn) gbtn.setAttribute('aria-selected','true');
      if (tbtn) tbtn.setAttribute('aria-selected','false');
    }
  }

  /* ── init ── */
  var dataEl = document.getElementById('us-stocktable-data');
  if (!dataEl) return;  /* no data — safe no-op */

  window.USStockTable = { _setView: applyView };

  StockTable.init({
    dataId: 'us-stocktable-data',
    containerId: 'us-stocktable-wrap',
    market: 'us',
    linkPattern: 'stock.html#{ticker}',
    columns: cols,
    optionLabels: { lane: LANE_LABELS, sector: SECTOR_LABELS },
    searchPlaceholder: ['Search name…','搜索名称…'],
  });

  /* restore persisted view */
  applyView(currentView);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initStockTableView, { once: true });
} else {
  initStockTableView();
}
})();
</script>
