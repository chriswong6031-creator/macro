      {# Required not-a-signal-source note (spec §2.9) #}
      <div class="mx5-ai-note">
        <span class="l-en">A read-through of existing signals &mdash; not a signal source.</span>
        <span class="l-zh">仅为现有信号的汇总解读 &mdash; 非独立信号源。</span>
      </div>
    </div>
  </div>{# /sx-aibrief-v2 #}
  {% endif %}{# /mode != stocks #}

  {# ── 7. NEWS row + tray (Stage B) ── #}
  {% if mode != 'stocks' %}
  {% set TL_nb = {'monetary':['Fed','美联储'],'inflation':['Inflation','通胀'],'labor':['Labor','就业'],'growth':['Growth','增长'],'credit':['Rates','利率'],'fiscal':['Fiscal','财政'],'earnings':['Earnings','业绩'],'guidance':['Guidance','指引'],'analyst':['Analysts','分析师'],'deals':['Deals','并购/IPO'],'capital_return':['Buybacks','回购/分红'],'stocks':['Stocks','个股'],'macro':['Macro','宏观']} %}
