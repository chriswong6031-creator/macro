  {# dlg-risk: Risk scare ladder + drawdown boxes + sentiment — S2 redesign #}
  {% if market_state %}
  <div class="mx5-dlg" id="dlg-risk" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Risk — Scare Ladder &amp; Sentiment</span><span class="l-zh">风险 — 压力梯度与情绪</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# — 1. Dominant driver banner — #}
        {% set _dlgr_rdr = market_state.radar if market_state.radar is defined else {} %}
        {% set _dlgr_state = _dlgr_rdr.state if _dlgr_rdr else 'unknown' %}
        {% set _dlgr_col = 'var(--down)' if _dlgr_state in ('risk-off','high') else ('var(--warn)' if _dlgr_state in ('elevated','caution') else 'var(--up)') %}
        {# _dlgr_has = a real radar reading exists. When it doesn't (degraded/no-radar),
           the content blocks below all gate off, so the header must still carry a
           plain-word stance — a bare "Unknown" enum here would fail Law 1/Law 2.
           (This replaces the "No active risk readings" fallback the old scorecard
           popover carried, now that the button opens this dialog directly.) #}
        {% set _dlgr_has = _dlgr_rdr and _dlgr_rdr.state and _dlgr_state not in ('unknown','none') %}
        <div class="mx5-dlg-driver-hd">
          <div class="mx5-dlg-driver-icon" style="background:color-mix(in srgb,{{ _dlgr_col }} 13%,transparent)">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="{{ _dlgr_col }}" stroke-width="2" stroke-linecap="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div>
            <div class="mx5-dlg-driver-label" style="color:{{ _dlgr_col }}">
              {% if _dlgr_has %}
              <span class="l-en">{{ (_dlgr_rdr.label_en if _dlgr_rdr.label_en is defined else _dlgr_state) | title }}</span>
              <span class="l-zh">{{ _dlgr_rdr.label_zh if (_dlgr_rdr.label_zh is defined and _dlgr_rdr.label_zh) else (_dlgr_rdr.label_en if _dlgr_rdr.label_en is defined else _dlgr_state) }}</span>
              {% else %}
              <span class="l-en">No active risk readings</span><span class="l-zh">暂无活跃风险读数</span>
              {% endif %}
            </div>
            {% if _dlgr_rdr.do_en is defined and _dlgr_rdr.do_en %}
            <div class="mx5-dlg-driver-sub">
              <span class="l-en">{{ _dlgr_rdr.do_en }}</span>
              <span class="l-zh">{{ _dlgr_rdr.do_zh if (_dlgr_rdr.do_zh is defined and _dlgr_rdr.do_zh) else _dlgr_rdr.do_en }}</span>
            </div>
            {% elif not _dlgr_has %}
            <div class="mx5-dlg-driver-sub">
              <span class="l-en">Nothing to chase right now — watch.</span><span class="l-zh">当前无需追高 — 观望。</span>
            </div>
            {% endif %}
            {% if _dlgr_rdr.top_score is defined and _dlgr_rdr.top_score is not none %}
            <div class="mx5-dlg-driver-sub" style="margin-top:3px">
              <span class="l-en">Intensity {{ _dlgr_rdr.top_score }}/100</span>
              <span class="l-zh">强度 {{ _dlgr_rdr.top_score }}/100</span>
            </div>
            {% endif %}
          </div>
        </div>

        {# — 2. Risk Radar card (show_threats=false — scare chips suppressed here; Risk Ladder below is the single canonical list) — #}
        {% if MS.radar and MS.radar.state %}{{ rrc.risk_radar_card(MS.radar, latest.risk_radar.scares if latest.risk_radar else none, show_threats=false) }}{% endif %}

        {# — 2b. Signal tiles (Wave C) — the partial's six stacked prose rows (.rrx-side)
           are hidden in dlg-risk scope (CSS) and REBUILT here as a 2-column icon-tile grid:
           glyph + 2-word label + one plain line + optional chip; the full sentence + receipts
           move to hover (data-tip-en/zh). Plain words replace the "72th/66th" percentile leak
           (doctrine Law 3). All fields null-safe off MS.radar; the whole grid gates off when
           the radar is absent. #}
        {% set _rk_rd = MS.radar if (MS.radar is defined and MS.radar) else none %}
        {% if _rk_rd and _rk_rd.state %}
        {%- set _rk_scares = latest.risk_radar.scares if (latest.risk_radar and latest.risk_radar.scares) else none -%}
        {#- Leading tile: the dominant scare's two firing legs, plain-word magnitude from percentile.
           NB: set-inside-for is loop-local in Jinja — use a namespace (codebase trap). -#}
        {%- set _rk_ns = namespace(lead=none) -%}
        {%- if _rk_scares -%}{%- for s in _rk_scares -%}{%- if s.label_en == _rk_rd.label_en and s.firing_legs -%}{%- set _rk_ns.lead = s -%}{%- endif -%}{%- endfor -%}{%- endif -%}
        {%- set _rk_lead = _rk_ns.lead -%}
        {#- cycle / contagion / cross-asset / track blocks off the radar -#}
        {%- set _rk_cy = _rk_rd.cycle if (_rk_rd.cycle is defined and _rk_rd.cycle and _rk_rd.cycle.show) else none -%}
        {%- set _rk_cg = _rk_rd.contagion if (_rk_rd.contagion is defined and _rk_rd.contagion) else none -%}
        {%- set _rk_cx = _rk_rd.cross_asset if (_rk_rd.cross_asset is defined and _rk_rd.cross_asset) else none -%}
        {%- set _rk_cx_v = (_rk_cx.verdict if (_rk_cx and _rk_cx.verdict is defined) else none) -%}
        {%- set _rk_tr = _rk_rd.track if (_rk_rd.track is defined and _rk_rd.track) else none -%}
        {%- set _rk_fl = _rk_rd.forward_log if (_rk_rd.forward_log is defined and _rk_rd.forward_log) else none -%}
        {#- plain-word magnitude for a percentile (kills "72th"): ≥85 sharply, ≥65 clearly, ≥50 moderately, else mildly.
           Returns PLAIN TEXT (lang param) so it can sit inside an l-en/l-zh span without nesting t(). -#}
        {% macro _rk_mag(p, lang) -%}
        {%- set _pp = (p*100)|round|int if p is not none else 0 -%}
        {%- if _pp >= 85 -%}{{ '显著' if lang=='zh' else 'sharply' }}{%- elif _pp >= 65 -%}{{ '明显' if lang=='zh' else 'clearly' }}{%- elif _pp >= 50 -%}{{ '温和' if lang=='zh' else 'moderately' }}{%- else -%}{{ '轻微' if lang=='zh' else 'mildly' }}{%- endif -%}
        {%- endmacro %}
        <div class="rkc-sig-grid">

          {# Tile 1 — Leading signal (which scare is driving; plain magnitude word) #}
          {% if _rk_lead and _rk_lead.firing_legs %}
          {%- set _l0 = _rk_lead.firing_legs[0] -%}
          {#- tip is a plain-text attribute: build percentile figures ONLY (no rr_leg HTML —
             embedding l-en/l-zh spans in an attribute breaks it). The leg NAME shows on the
             tile face; the tip carries the receipt (the numbers). -#}
          {%- set _l0p = (_l0.pctile*100)|round|int -%}
          {%- set _l1p = ((_rk_lead.firing_legs[1].pctile*100)|round|int) if (_rk_lead.firing_legs|length > 1) else none -%}
          {#- correct English ordinal suffix (fixes the engine's "72th" leak inside this tip) -#}
          {%- set _l0ord = 'th' if (11 <= (_l0p % 100) <= 13) else {1:'st',2:'nd',3:'rd'}.get(_l0p % 10, 'th') -%}
          {%- set _l1ord = ('th' if (11 <= (_l1p % 100) <= 13) else {1:'st',2:'nd',3:'rd'}.get(_l1p % 10, 'th')) if _l1p is not none else '' -%}
          {%- set _rk_lead_tip_en = 'Leading leg sits at the ' ~ _l0p ~ _l0ord ~ ' percentile' ~ ((', a second at the ' ~ _l1p ~ _l1ord) if _l1p is not none else '') ~ ' — measured against a 5-year window. Higher = more stretched.' -%}
          {%- set _rk_lead_tip_zh = '领先因素处于 ' ~ _l0p ~ ' 分位' ~ ((('，另一因素处于 ' ~ _l1p ~ ' 分位')) if _l1p is not none else '') ~ '——基于近5年区间衡量。越高越极端。' -%}
          <div class="rkc-sig" style="--rkc-c:var(--isle-risk,#e05c5c)" data-tip-en="{{ _rk_lead_tip_en }}" data-tip-zh="{{ _rk_lead_tip_zh }}">
            <span class="rkc-sig-ico">{{ rkc_sig_glyph('leading') }}</span>
            <div class="rkc-sig-body">
              <div class="rkc-sig-lbl">{{ t('Leading','领先信号') }}</div>
              {# rr_leg emits its OWN l-en/l-zh spans — never re-wrap it. Magnitude word follows. #}
              <div class="rkc-sig-state">{{ rrc.rr_leg(_l0.leg) }} <span class="l-en">— {{ _rk_mag(_l0.pctile,'en') }}</span><span class="l-zh">— {{ _rk_mag(_l0.pctile,'zh') }}</span></div>
            </div>
            <span class="rkc-sig-tip">?</span>
          </div>
          {% endif %}

          {# Tile 2 — What to do (the radar's action line, verbatim engine copy) #}
          {% if _rk_rd.do_en is defined and _rk_rd.do_en %}
          <div class="rkc-sig" style="--rkc-c:var(--isle-brief,#22c55e)">
            <span class="rkc-sig-ico">{{ rkc_sig_glyph('do') }}</span>
            <div class="rkc-sig-body">
              <div class="rkc-sig-lbl">{{ t('What to do','应对') }}</div>
              <div class="rkc-sig-state">
                <span class="l-en">{{ _rk_rd.do_en }}</span>
                <span class="l-zh">{{ _rk_rd.do_zh if (_rk_rd.do_zh is defined and _rk_rd.do_zh) else _rk_rd.do_en }}</span>
              </div>
            </div>
          </div>
          {% endif %}

          {# Tile 3 — Calendar window (election cycle), favor/trim on hover.
             Lens content law (memory hover-popup-doctrine): plain-word body; machine
             facts (n / p≈ / tickers) demoted to the data-tip-rc receipt line Lens
             renders in mono under a dashed perforation. #}
          {% if _rk_cy %}
          {%- set _rk_cy_tip_en -%}Midterm years tend to sag from April to October — pullbacks have come about 1.25× as often as usual, even while the market still looks healthy. Treat it as a lean-carefully season, not a sell signal: nothing fires from the calendar alone. In past midterm second halves, defensives (health care, staples, utilities) held up best while energy and discretionary lagged.{%- endset -%}
          {%- set _rk_cy_tip_zh -%}中期选举年的 4–10 月往往偏弱——即使大盘仍然健康，回撤出现的频率也约为平常的 1.25 倍。把它当作「谨慎一些」的季节，而非卖出信号：日历本身绝不单独触发操作。历次中期年下半年，防御板块（医疗、必需消费、公用事业）相对抗跌，能源与可选消费偏弱。{%- endset -%}
          {%- set _rk_cy_rc_en -%}8 midterm cases · weak edge (p≈.09) · worst crashes non-midterm{% if _rk_cy.sector_bias %} · favor {% for f in _rk_cy.sector_bias.favor %}{% if not loop.first %}·{% endif %}{{ f.ticker }}{% endfor %} / trim {% for a in _rk_cy.sector_bias.avoid %}{% if not loop.first %}·{% endif %}{{ a.ticker }}{% endfor %}{% endif %}{%- endset -%}
          {%- set _rk_cy_rc_zh -%}8 个中期年样本 · 优势较弱（p≈.09）· 史上最深回撤在非中期年{% if _rk_cy.sector_bias %} · 偏好 {% for f in _rk_cy.sector_bias.favor %}{% if not loop.first %}·{% endif %}{{ f.ticker }}{% endfor %} / 减持 {% for a in _rk_cy.sector_bias.avoid %}{% if not loop.first %}·{% endif %}{{ a.ticker }}{% endfor %}{% endif %}{%- endset -%}
          <div class="rkc-sig" style="--rkc-c:var(--isle-events,#e0a030)" data-lens-kind="record" data-tip-en="{{ _rk_cy_tip_en|trim }}" data-tip-zh="{{ _rk_cy_tip_zh|trim }}" data-tip-rc-en="{{ _rk_cy_rc_en|trim }}" data-tip-rc-zh="{{ _rk_cy_rc_zh|trim }}">
            <span class="rkc-sig-ico">{{ rkc_sig_glyph('window') }}</span>
            <div class="rkc-sig-body">
              <div class="rkc-sig-lbl">{{ t('Calendar','日历') }}</div>
              <div class="rkc-sig-state">
                <span class="l-en">{{ _rk_cy.label_en if _rk_cy.label_en is defined else 'Seasonal window' }}{% if _rk_cy.in_drawdown_window %} · weaker stretch{% endif %}</span>
                <span class="l-zh">{{ _rk_cy.label_zh if (_rk_cy.label_zh is defined and _rk_cy.label_zh) else '季节窗口' }}{% if _rk_cy.in_drawdown_window %} · 偏弱时段{% endif %}</span>
                {% if _rk_cy.sector_bias %}<span class="rkc-sig-chip">{{ t('rotate','轮动') }}</span>{% endif %}
              </div>
            </div>
            <span class="rkc-sig-tip">?</span>
          </div>
          {% endif %}

          {# Tile 4 — Overseas pressure (contagion), full exporter receipt on hover #}
          {% if _rk_cg %}
          {%- set _rk_cg_lv = _rk_cg.level if _rk_cg.level is defined else none -%}
          {%- set _rk_cg_en = 'High' if _rk_cg_lv == 'high' else ('Building' if _rk_cg_lv == 'moderate' else 'Low') -%}
          {%- set _rk_cg_zh = '高' if _rk_cg_lv == 'high' else ('升温' if _rk_cg_lv == 'moderate' else '低') -%}
          {%- set _rk_cg_col = 'var(--down,#ef4444)' if _rk_cg_lv == 'high' else ('var(--warn,#f59e0b)' if _rk_cg_lv == 'moderate' else 'var(--up,#22c55e)') -%}
          {%- set _rk_cg_tip_en %}{% if _rk_cg.line_en is defined and _rk_cg.line_en %}{{ _rk_cg.line_en }}{% endif %}{% if _rk_cg.top_exporters is defined and _rk_cg.top_exporters %} · Main sources: {% for e in _rk_cg.top_exporters[:3] %}{% if not loop.first %}, {% endif %}{{ e.name_en if e.name_en is defined else e.market }}{% if e.dd21 is defined and e.dd21 is not none %} ({{ (e.dd21*100)|round|int }}% off high){% endif %}{% endfor %}{% endif %}{% endset -%}
          {%- set _rk_cg_tip_zh %}{% if _rk_cg.line_zh is defined and _rk_cg.line_zh %}{{ _rk_cg.line_zh }}{% elif _rk_cg.line_en is defined and _rk_cg.line_en %}{{ _rk_cg.line_en }}{% endif %}{% if _rk_cg.top_exporters is defined and _rk_cg.top_exporters %} · 主要来源：{% for e in _rk_cg.top_exporters[:3] %}{% if not loop.first %}、{% endif %}{{ e.name_zh if (e.name_zh is defined and e.name_zh) else (e.name_en if e.name_en is defined else e.market) }}{% if e.dd21 is defined and e.dd21 is not none %}（距高{{ (e.dd21*100)|round|int }}%）{% endif %}{% endfor %}{% endif %}{% endset -%}
          <div class="rkc-sig" style="--rkc-c:{{ _rk_cg_col }}" data-tip-en="{{ _rk_cg_tip_en|trim }}" data-tip-zh="{{ _rk_cg_tip_zh|trim }}">
            <span class="rkc-sig-ico">{{ rkc_sig_glyph('overseas') }}</span>
            <div class="rkc-sig-body">
              <div class="rkc-sig-lbl">{{ t('Overseas','境外') }}</div>
              <div class="rkc-sig-state">
                <span class="l-en">Pressure from abroad</span><span class="l-zh">海外传导压力</span>
                <span class="rkc-sig-chip">{{ t(_rk_cg_en, _rk_cg_zh) }}</span>
              </div>
            </div>
            <span class="rkc-sig-tip">?</span>
          </div>
          {% endif %}

          {# Tile 5 — Correlation (markets moving as one), absorption receipt on hover #}
          {% if _rk_cx and _rk_cx_v in ['concentrated','converging'] %}
          {%- set _rk_cx_en = 'Moving as one' if _rk_cx_v == 'concentrated' else 'Syncing up' -%}
          {%- set _rk_cx_zh = '同涨同跌' if _rk_cx_v == 'concentrated' else '联动升温' -%}
          {%- set _rk_cx_tip_en %}When markets move together, one shock hits everything at once — diversification helps less.{% if _rk_cx.absorption_pctile is defined and _rk_cx.absorption_pctile is not none %} Co-movement at the {{ (_rk_cx.absorption_pctile*100)|round|int }}th percentile (5y).{% endif %}{% if _rk_cx.dominant_cluster is defined and _rk_cx.dominant_cluster %} Cluster: {{ _rk_cx.dominant_cluster|join(', ') }}.{% endif %}{% endset -%}
          {%- set _rk_cx_tip_zh %}市场同步波动时，单一冲击会同时打击各类资产——分散配置作用下降。{% if _rk_cx.absorption_pctile is defined and _rk_cx.absorption_pctile is not none %} 联动度处于 {{ (_rk_cx.absorption_pctile*100)|round|int }} 分位（5年）。{% endif %}{% if _rk_cx.dominant_cluster is defined and _rk_cx.dominant_cluster %} 集群：{{ _rk_cx.dominant_cluster|join('、') }}。{% endif %}{% endset -%}
          <div class="rkc-sig" style="--rkc-c:var(--isle-markets,#4d8ef5)" data-tip-en="{{ _rk_cx_tip_en|trim }}" data-tip-zh="{{ _rk_cx_tip_zh|trim }}">
            <span class="rkc-sig-ico">{{ rkc_sig_glyph('corr') }}</span>
            <div class="rkc-sig-body">
              <div class="rkc-sig-lbl">{{ t('Correlation','相关性') }}</div>
              <div class="rkc-sig-state">
                <span class="l-en">{{ _rk_cx_en }}</span><span class="l-zh">{{ _rk_cx_zh }}</span>
              </div>
            </div>
            <span class="rkc-sig-tip">?</span>
          </div>
          {% endif %}

          {# Tile 6 — Track record / self-audit (accrual honesty), plain-word state #}
          {%- set _rk_hit = none -%}
          {%- if _rk_tr and _rk_tr.get is defined -%}
            {%- set _rk_w = _rk_tr.get('windows', {}).get('y1', {}) -%}
            {%- set _rk_al = _rk_w.get('alerts', {}) if _rk_w.get is defined else {} -%}
            {%- set _rk_hit = _rk_al.get('hit_rate') if _rk_al.get is defined else none -%}
            {%- set _rk_tp = _rk_al.get('tp', 0) if _rk_al.get is defined else 0 -%}
            {%- set _rk_n = _rk_al.get('n', 0) if _rk_al.get is defined else 0 -%}
          {%- endif -%}
          <div class="rkc-sig" style="--rkc-c:var(--isle-news,#7a8494)"
            {% if _rk_hit is not none %}data-tip-en="Over the past year, on {{ _rk_tp }} of {{ _rk_n }} elevated-alert days a ≥5% drop followed within a month. Daily readings — consecutive days overlap." data-tip-zh="过去一年，{{ _rk_n }} 个警报日中有 {{ _rk_tp }} 天在一个月内出现 ≥5% 下跌。按日读数，连续日期相互重叠。"{% endif %}>
            <span class="rkc-sig-ico">{{ rkc_sig_glyph('audit') }}</span>
            <div class="rkc-sig-body">
              <div class="rkc-sig-lbl">{{ t('Track record','历史记录') }}</div>
              <div class="rkc-sig-state">
                {% if _rk_hit is not none %}
                <span class="l-en">{{ _rk_tp }} of {{ _rk_n }} alerts led to a drop</span>
                <span class="l-zh">{{ _rk_n }} 次警报中 {{ _rk_tp }} 次先于下跌</span>
                {% else %}
                <span class="l-en">Grading calls as they mature</span>
                <span class="l-zh">评分随信号成熟展开</span>
                {% endif %}
              </div>
            </div>
            {% if _rk_hit is not none %}<span class="rkc-sig-tip">?</span>{% endif %}
          </div>

        </div>
        {% endif %}

        {# — 3. Context chip row (Fed stance + turning point, moved after radar card) — #}
        {% set _dlgr_fed_st = (latest.fed_stance.stance if (latest.fed_stance is defined and latest.fed_stance and latest.fed_stance.stance is defined and latest.fed_stance.stance != 'unknown') else none) %}
        {% set _dlgr_tp = (latest.turning_point if (latest.turning_point is defined and latest.turning_point and latest.turning_point.present is defined and latest.turning_point.present) else none) %}
        {% if _dlgr_fed_st or _dlgr_tp %}
        <div class="mx5-dlg-chips-row" style="margin-top:12px">
          <span style="font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));align-self:center"><span class="l-en">Context</span><span class="l-zh">背景</span></span>
          {% if _dlgr_fed_st %}
          {% set _dlgr_fsc = 'var(--down)' if _dlgr_fed_st in ('hawkish','very-hawkish') else ('var(--up)' if _dlgr_fed_st in ('dovish','very-dovish') else 'var(--warn)') %}
          {% set _dlgr_fsl = {'hawkish':'Hawkish','very-hawkish':'Very Hawkish','dovish':'Dovish','very-dovish':'Very Dovish','neutral':'Neutral'} %}
          {% set _dlgr_fszh = {'hawkish':'鹰派','very-hawkish':'强鹰派','dovish':'鸽派','very-dovish':'强鸽派','neutral':'中性'} %}
          <span class="mx5-dlg-chip" style="border-color:{{ _dlgr_fsc }};color:{{ _dlgr_fsc }}">
            <span class="l-en">Fed: {{ _dlgr_fsl.get(_dlgr_fed_st, _dlgr_fed_st) }}</span>
            <span class="l-zh">美联储：{{ _dlgr_fszh.get(_dlgr_fed_st, _dlgr_fed_st) }}</span>
          </span>
          {% endif %}
          {% if _dlgr_tp %}
          <span class="mx5-dlg-chip" style="border-color:var(--warn);color:var(--warn)">
            <span class="l-en">Turning point watch</span>
            <span class="l-zh">拐点观察中</span>
          </span>
          {% endif %}
        </div>
        {% endif %}

        {# — 4. US Leaders section — #}
        {% if leadership_crack is defined and leadership_crack and leadership_crack.state is defined and leadership_crack.state != 'INTACT' %}
        {% set _lc = leadership_crack %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow">{{ t('US Leaders','美股龙头') }}</div>
        <div class="rsx-leaders">
          {# Header row: engine state line (verbatim) + count chip (N names 30%+ off) #}
          {% set _lc_n30h = ((_lc.share30 * _lc.n_total) | round | int) if (_lc.share30 is defined and _lc.share30 is not none and _lc.n_total is defined) else none %}
          <div class="rkc-ldr-head">
            <div class="rkc-ldr-state">
              {% if _lc.state == 'BROKEN' %}
              <span class="l-en">Leaders broken — typical AI-hardware name {% if _lc.med_dd is defined and _lc.med_dd is not none %}{{ (_lc.med_dd * 100)|abs|round|int }}{% else %}—{% endif %}% off its high while the index holds.</span>
              <span class="l-zh">龙头受损——AI硬件个股中位数较高点回撤{% if _lc.med_dd is defined and _lc.med_dd is not none %}{{ (_lc.med_dd * 100)|abs|round|int }}{% else %}—{% endif %}%，而指数仍稳。</span>
              {% else %}
              <span class="l-en">Leaders cracking — early stress in AI-hardware names{% if _lc.med_dd is defined and _lc.med_dd is not none %}, median {{ (_lc.med_dd * 100)|abs|round|int }}% off high{% endif %}.</span>
              <span class="l-zh">龙头出现裂痕——AI硬件个股初显压力{% if _lc.med_dd is defined and _lc.med_dd is not none %}，中位数距高点下跌{{ (_lc.med_dd * 100)|abs|round|int }}%{% endif %}。</span>
              {% endif %}
            </div>
            {% if _lc_n30h is not none %}
            <span class="rkc-ldr-count">{{ _lc_n30h }}<small><span class="l-en">30%+ off</span><span class="l-zh">跌超30%</span></small></span>
            {% endif %}
          </div>
          {% if _lc.worst_members is defined and _lc.worst_members %}
          {# ── Worst-member drawdown chart: mono tickers, animated gradient bars, index tick ── #}
          {% set _lc_idx_dd = _lc.index_dd if (_lc.index_dd is defined and _lc.index_dd is not none) else none %}
          {% set _lc_idx_pct = ((_lc_idx_dd * -100) | round | int) if _lc_idx_dd is not none else none %}
          <div class="rkc-ldr-bars">
            {% for wm in _lc.worst_members[:6] %}
            {% set _wm_dd_pct = ((wm.dd * -100) | round | int) if (wm.dd is defined and wm.dd is not none) else none %}
            <div class="rkc-ldr-row">
              <div class="rkc-ldr-tkr">{{ wm.ticker }}</div>
              <div class="rkc-ldr-track">
                {% if _wm_dd_pct is not none %}
                <div class="rkc-ldr-fill" style="width:{{ [_wm_dd_pct, 100] | min }}%"></div>
                {% endif %}
                {# Index reference tick at |index_dd|% of bar width — first row only, labelled #}
                {% if loop.first and _lc_idx_pct is not none %}
                <div class="rkc-ldr-idx" style="left:{{ [_lc_idx_pct, 99] | min }}%">
                  <span class="rkc-ldr-idx-lbl"><span class="l-en">index</span><span class="l-zh">指数</span></span>
                </div>
                {% endif %}
              </div>
              {% if _wm_dd_pct is not none %}
              <div class="rkc-ldr-pct">−{{ _wm_dd_pct }}%</div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {# ── Plain breadth line (counts, not raw fractions) — engine copy verbatim ── #}
          {% if _lc.share10 is defined and _lc.share10 is not none and _lc.share30 is defined and _lc.share30 is not none and _lc.n_total is defined %}
          {% set _lc_n10 = (_lc.share10 * _lc.n_total) | round | int %}
          {% set _lc_n30 = (_lc.share30 * _lc.n_total) | round | int %}
          <div class="rkc-ldr-sub">
            <span class="l-en"><b>{{ _lc_n10 }}</b> of {{ _lc.n_total }} names 10%+ off their highs; <b>{{ _lc_n30 }}</b> are 30%+ off.</span>
            <span class="l-zh">{{ _lc.n_total }}个成分中<b>{{ _lc_n10 }}</b>个较高点跌超10%；其中<b>{{ _lc_n30 }}</b>个跌超30%。</span>
          </div>
          {% endif %}
          {# Receipt fields in data-tip-en/zh #}
          {% set _lc_tip_en %}State since {{ _lc.state_since if (_lc.state_since is defined and _lc.state_since) else '—' }}. Velocity z={{ ((_lc.z_vel)|round(1)) if (_lc.z_vel is defined and _lc.z_vel is not none) else '—' }}. Carnage share EMA {{ ((_lc.carnage_share_ema * 100)|round|int ~ '%') if (_lc.carnage_share_ema is defined and _lc.carnage_share_ema is not none) else '—' }}. Accrual-only display — see pick-lab for forward grading.{% endset %}
          {% set _lc_tip_zh %}自{{ _lc.state_since if (_lc.state_since is defined and _lc.state_since) else '—' }}起。速度 z={{ ((_lc.z_vel)|round(1)) if (_lc.z_vel is defined and _lc.z_vel is not none) else '—' }}。灾情份额 EMA {{ ((_lc.carnage_share_ema * 100)|round|int ~ '%') if (_lc.carnage_share_ema is defined and _lc.carnage_share_ema is not none) else '—' }}。仅积累展示，前瞻评分见选股实验室。{% endset %}
          <div class="rkc-ldr-sub" style="margin-top:5px" data-tip-en="{{ _lc_tip_en | trim }}" data-tip-zh="{{ _lc_tip_zh | trim }}">
            <span class="l-en">Watch — don't chase.</span>
            <span class="l-zh">观望，勿追高。</span>
          </div>
        </div>
        {% endif %}

        {# — 5. Overseas section — #}
        {% set _dlgr_iov_n = (intl_cascade.n_alert if (intl_cascade is defined and intl_cascade and intl_cascade.n_alert is not none) else 0) %}
        {% set _dlgr_iov_det = (det_cascade.state if (det_cascade is defined and det_cascade and det_cascade.state is defined) else 'STEADY') %}
        {% set _dlgr_iov_spill = (intl_spillover.state if (intl_spillover is defined and intl_spillover and intl_spillover.state is defined) else 'quiet') %}
        {% if (_dlgr_iov_n > 0) or (_dlgr_iov_det != 'STEADY') or (_dlgr_iov_spill in ('watching','transmitting')) %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow">
          {{ t('Overseas','海外') }}
          {{ help('Context only — does not move the US score. Tiles link to the full International page. Ring = each market\'s pullback-risk score (0-100), coloured by band.','仅供背景参考——不影响美国评分。点击卡片可进入完整国际页面。环形为各市场回撤风险评分（0-100），按等级着色。') }}
          {# as-of merged into the single dialog footer (one stamp per dialog) #}
        </div>
        {# ── plain-word maps reused from intl.html turn cards ── #}
        {% set _OV_RD_STATE_EN = {'calm': 'Calm', 'watch': 'Watch', 'caution': 'Caution', 'elevated': 'Elevated', 'risk-off': 'Risk-off'} %}
        {% set _OV_RD_STATE_ZH = {'calm': '平静', 'watch': '留意', 'caution': '谨慎', 'elevated': '偏高', 'risk-off': '避险'} %}
        {# Market grid from intl_cascade.rows — alert first #}
        {% if intl_cascade is defined and intl_cascade %}
          {# alert-first, then the calm markets — rows arrive in fixed dict order, only
             the alerts list is score-sorted, so re-compose here #}
          {% set _iov_rows = ((intl_cascade.alerts if (intl_cascade.alerts is defined and intl_cascade.alerts) else []) + (intl_cascade.rows | selectattr('alert','equalto',false) | list)) if (intl_cascade.rows is defined and intl_cascade.rows) else (intl_cascade.alerts if (intl_cascade.alerts is defined and intl_cascade.alerts) else []) %}
          {% if _iov_rows %}
          {# Wave C: severity-ring tiles (SIGNATURE). Conic-gradient arc = each market's
             risk score 0-100, band-coloured; value in the ring centre. data-rpop + the
             .rp-src payload are UNCHANGED (theme.js clones .rp-src on hover). #}
          <div class="rkc-ov-grid">
            {% for row in _iov_rows %}
            {% set _is_alert = (row.alert if row.alert is defined else false) or (row.state is defined and row.state in ('risk-off','elevated')) %}
            {% set _ov_prof = row.get('profile') if row.get is defined else none %}
            {# severity band → ring colour (calm/watch/caution/elevated/risk-off) from score #}
            {% set _ov_sc = (row.score|round|int) if (row.score is defined and row.score is not none) else none %}
            {% set _ov_rd_st = row.get('rd_state') if row.get is defined else none %}
            {% set _ov_band_col = ('var(--down,#ef4444)' if (_ov_sc is not none and _ov_sc >= 85) else ('var(--warn,#f59e0b)' if (_ov_sc is not none and _ov_sc >= 60) else ('var(--info,#4d8ef5)' if (_ov_sc is not none and _ov_sc >= 40) else 'var(--up,#22c55e)'))) if _ov_sc is not none else 'var(--muted,#8a93a3)' %}
            <a href="intl.html" class="rkc-ov{{ ' is-alert' if _is_alert }}" style="--rkc-v:{{ _ov_sc if _ov_sc is not none else 0 }};--rkc-c:{{ _ov_band_col }}" data-rpop>
              {% if _ov_sc is not none %}
              <span class="rkc-ov-ring"><span class="rkc-ov-val">{{ _ov_sc }}</span></span>
              {% else %}
              <span class="rkc-ov-ring"><span class="rkc-ov-val">—</span></span>
              {% endif %}
              <span class="rkc-ov-name">
                <span class="l-en">{{ row.name_en if row.name_en is defined else (row.name if row.name is defined else row.ticker) }}</span>
                <span class="l-zh">{{ row.name_zh if (row.name_zh is defined and row.name_zh) else (row.name_en if row.name_en is defined else (row.name if row.name is defined else row.ticker)) }}</span>
              </span>
              {# — .rp-src payload cloned by theme.js row-pop engine on hover — #}
              <span class="rp-src" hidden>
                {# header: country name + risk-radar score #}
                <div class="row-pop-hd">
                  <span class="row-pop-name">
                    <span class="l-en">{{ row.name_en if row.name_en is defined else (row.name if row.name is defined else '') }}</span>
                    <span class="l-zh">{{ row.name_zh if (row.name_zh is defined and row.name_zh) else (row.name_en if row.name_en is defined else '') }}</span>
                  </span>
                  {% if row.score is defined and row.score is not none %}
                  <span class="row-pop-kind">{{ t('Risk score','风险评分') }} {{ row.score|round|int }}/100</span>
                  {% endif %}
                </div>
                <div class="row-pop-div"></div>
                {% if _ov_prof %}
                {# turn state word + stance line from market_states() profile #}
                <ul class="row-pop-why">
                  <li>
                    <span class="l-en"><b>{{ _ov_prof.state_en or '—' }}</b>{% if _ov_prof.stance_en %} — {{ _ov_prof.stance_en }}{% endif %}</span>
                    <span class="l-zh"><b>{{ _ov_prof.state_zh or '—' }}</b>{% if _ov_prof.stance_zh %} — {{ _ov_prof.stance_zh }}{% endif %}</span>
                  </li>
                </ul>
                {# 20d momentum + off-high metrics #}
                <div class="row-pop-grid">
                  {% if _ov_prof.mom20_pct is not none %}
                  <div class="row-pop-cell">
                    <span class="row-pop-lbl"><span class="l-en">20d</span><span class="l-zh">20日</span></span>
                    <span class="row-pop-val" style="color:{{ 'var(--up)' if _ov_prof.mom20_pct >= 0 else 'var(--down)' }}">{{ '%+.1f'|format(_ov_prof.mom20_pct) }}%</span>
                  </div>
                  {% endif %}
                  {% if _ov_prof.dd_pct is not none %}
                  <div class="row-pop-cell">
                    <span class="row-pop-lbl"><span class="l-en">off-high</span><span class="l-zh">距高</span></span>
                    <span class="row-pop-val"{% if _ov_prof.dd_pct < -2 %} style="color:var(--down)"{% endif %}>{{ '%.1f'|format(_ov_prof.dd_pct) }}%</span>
                  </div>
                  {% endif %}
                </div>
                {# Pullback risk from risk-radar rd_state + dd_h21 #}
                {% set _ov_rd = row.get('rd_state') if row.get is defined else none %}
                {% if _ov_rd and _ov_rd != 'calm' %}
                <div class="row-pop-div"></div>
                <ul class="row-pop-why">
                  <li>
                    <span class="l-en">Pullback risk: <b style="color:{{ 'var(--act,#ef4444)' if _ov_rd in ('elevated','risk-off') else 'var(--warn,#f59e0b)' }}">{{ _OV_RD_STATE_EN.get(_ov_rd, _ov_rd) }}</b>
                    {% if row.get is defined and row.get('dominant_en') %} — {{ row.dominant_en }}{% endif %}</span>
                    <span class="l-zh">回撤风险：<b style="color:{{ 'var(--act,#ef4444)' if _ov_rd in ('elevated','risk-off') else 'var(--warn,#f59e0b)' }}">{{ _OV_RD_STATE_ZH.get(_ov_rd, _ov_rd) }}</b>
                    {% if row.get is defined and row.get('dominant_zh') %} — {{ row.dominant_zh }}{% endif %}</span>
                  </li>
                  {% if row.get is defined and row.get('dd_h21') is not none %}
                  <li>
                    <span class="l-en">≥5% dip within a month: ~{{ (row.dd_h21 * 100)|round|int }}%</span>
                    <span class="l-zh">一个月内≥5%回撤：约{{ (row.dd_h21 * 100)|round|int }}%</span>
                  </li>
                  {% endif %}
                </ul>
                {% endif %}
                {% else %}
                {# No profile: show score + rd_state only #}
                <div class="row-pop-grid">
                  {% set _ov_rd2 = row.get('rd_state') if row.get is defined else none %}
                  {% if _ov_rd2 %}
                  <div class="row-pop-cell wide">
                    <span class="row-pop-lbl">
                      <span class="l-en">Pullback risk: {{ _OV_RD_STATE_EN.get(_ov_rd2, _ov_rd2) }}</span>
                      <span class="l-zh">回撤风险：{{ _OV_RD_STATE_ZH.get(_ov_rd2, _ov_rd2) }}</span>
                    </span>
                  </div>
                  {% endif %}
                </div>
                {% endif %}
                <div class="row-pop-ft">
                  <span class="l-en">Context only — see intl.html for full detail.</span>
                  <span class="l-zh">仅供背景参考——完整详情见国际页面。</span>
                </div>
              </span>{# end .rp-src #}
            </a>
            {% endfor %}
          </div>
          {% endif %}
        {% endif %}
        {# Spread-speed row (only when deteriorating) #}
        {% if det_cascade is defined and det_cascade and _dlgr_iov_det != 'STEADY' %}
        <div class="mx5-pop-intl-spread">
          {% if _dlgr_iov_det == 'DETERIORATING_FAST' %}
          <span class="l-en"><b>Spreading fast</b> — alert count accelerating across tracked markets.</span>
          <span class="l-zh"><b>快速蔓延</b>——追踪市场中警报数量加速上升。</span>
          {% else %}
          <span class="l-en"><b>Spreading</b> — more markets moving into risk-off.</span>
          <span class="l-zh"><b>正在扩散</b>——更多市场进入避险状态。</span>
          {% endif %}
          {% if det_cascade.immature is defined and det_cascade.immature %}
          {# accrual honesty lives in the eyebrow help() tip — no per-row repeat #}
          {% endif %}
        </div>
        {% endif %}
        {# US Transmission board — Task 7c: add data-tip-en/zh per leg #}
        {% if intl_spillover is defined and intl_spillover and intl_spillover.legs is defined and intl_spillover.legs %}
        {% set _iov_hot = intl_spillover.hot_count if (intl_spillover.hot_count is defined and intl_spillover.hot_count is not none) else (intl_spillover.legs | selectattr('hot','equalto',true) | list | length) %}
        <div class="mx5-pop-intl-spill">
          {# Transmission verdict as a state chip (Wave C): dot + word, band-coloured. #}
          {% set _tx_vcls = 'v-alert' if _dlgr_iov_spill == 'transmitting' else ('v-warn' if _dlgr_iov_spill == 'watching' else 'v-ok') %}
          <div class="rkc-tx-head">
            <span class="rkc-tx-ttl"><span class="l-en">US transmission</span><span class="l-zh">美国传导</span></span>
            <span class="rkc-tx-verdict {{ _tx_vcls }}">
              <span class="l-en">{{ {'transmitting':'Transmitting','watching':'Watching','contained':'Contained','quiet':'Quiet'}.get(_dlgr_iov_spill, _dlgr_iov_spill) }}</span>
              <span class="l-zh">{{ {'transmitting':'传导中','watching':'观察中','contained':'已遏制','quiet':'平静'}.get(_dlgr_iov_spill, _dlgr_iov_spill) }}</span>
            </span>
          </div>
          <div class="mx5-pop-intl-legs">
            {% for leg in intl_spillover.legs %}
            {% set _lhot = leg.hot if leg.hot is defined else false %}
            {% set _ltip_en = (leg.tip_en if (leg.tip_en is defined and leg.tip_en) else '') %}
            {% set _ltip_zh = (leg.tip_zh if (leg.tip_zh is defined and leg.tip_zh) else _ltip_en) %}
            <span class="mx5-pop-intl-leg{{ ' leg-hot' if _lhot }}"{% if _ltip_en %} data-tip-en="{{ _ltip_en }}" data-tip-zh="{{ _ltip_zh }}"{% endif %}>
              <span class="mx5-leg-dot{{ ' leg-dot-hot' if _lhot }}"></span>
              <span class="l-en">{{ leg.label_en if leg.label_en is defined else leg.key }}</span>
              <span class="l-zh">{{ leg.label_zh if (leg.label_zh is defined and leg.label_zh) else (leg.label_en if leg.label_en is defined else leg.key) }}</span>
            </span>
            {% endfor %}
          </div>
          <div class="mx5-pop-intl-legcount">
            <span class="l-en">{{ _iov_hot }} of {{ intl_spillover.legs|length }} channels hot</span>
            <span class="l-zh">{{ intl_spillover.legs|length }}条渠道中{{ _iov_hot }}条活跃</span>
          </div>
        </div>
        {% endif %}
        {# Task 8: footer removed — honesty now lives in the eyebrow help() tip above #}
        {% else %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow">{{ t('Overseas','海外') }}</div>
        <div class="mx5-pop-intl-fallback">
          <span class="l-en">Overseas: quiet — no tracked market in risk-off.</span>
          <span class="l-zh">海外：平静——追踪市场均无避险警报。</span>
        </div>
        {% endif %}

        {# — 6. Risk Ladder (single canonical scare list; show_threats=false removed the in-card chip dupe) — #}
        {% if latest.risk_radar and latest.risk_radar.scares %}
        <div class="mx5-dlg-sep"></div>
        <div class="mx5-dlg-eyebrow"><span class="l-en">Risk Ladder — What to Watch</span><span class="l-zh">风险梯度 — 需关注的因素</span></div>
        <div class="scare-ladder" style="margin-bottom:0">
          {% for sc in latest.risk_radar.scares %}
          {% set _sc_s2 = sc.score if (sc.score is defined and sc.score is not none) else 0 %}
          {% set _scc = ('sc-band-high' if _sc_s2 >= 70 else ('sc-band-watch' if _sc_s2 >= 50 else ('sc-band-elev' if _sc_s2 >= 35 else 'sc-band-calm'))) %}
          {% set _scband = (sc.band if sc.band is defined and sc.band else ('WATCH' if _sc_s2 >= 50 else ('ELEVATED' if _sc_s2 >= 35 else 'CALM'))) %}
          {# lookup by |upper — engine bands are lowercase ('calm','caution','risk-off'), the old
             uppercase-keyed map silently fell through to raw EN in the ZH view #}
          {% set _scband_zh = {'WATCH':'警惕','ELEVATED':'走高','CALM':'平静','HIGH':'高危','CAUTION':'谨慎','RISK-OFF':'避险'}.get(_scband|upper, _scband) %}
          {# Wave C: per-row band colour drives the leading glyph + the gradient severity bar #}
          {% set _sc_col = 'var(--down,#ef4444)' if _sc_s2 >= 70 else ('var(--warn,#f59e0b)' if _sc_s2 >= 35 else 'var(--muted,#8a93a3)') %}
          <div class="scare-row" style="--rkc-c:{{ _sc_col }}">
            <span class="rkc-sc-ico">{{ rkc_scare_glyph(rkc_scare_fam(sc)|trim) }}</span>
            <span class="sc-name">
              <span class="l-en">{{ sc.label_en if sc.label_en is defined else (sc.name_en if sc.name_en is defined else sc.name) }}</span>
              <span class="l-zh">{{ sc.label_zh if sc.label_zh is defined else (sc.name_zh if sc.name_zh is defined else sc.name) }}</span>
              {% if sc.scare is defined and sc.scare == 'global' and global_leg_lag_days is defined and global_leg_lag_days and global_leg_lag_days > 0 %}
              <span style="font-size:10px;font-weight:400;color:var(--ink-3,rgba(255,255,255,.36));margin-left:5px"><span class="l-en">· data {{ global_leg_lag_days }} day{{ 's' if global_leg_lag_days != 1 else '' }} behind</span><span class="l-zh">· 数据滞后{{ global_leg_lag_days }}天</span></span>
              {% endif %}
              {% if sc.desc_en is defined and sc.desc_en %}
              <div style="font-size:10px;font-weight:400;color:var(--ink-3,rgba(255,255,255,.36));margin-top:3px;line-height:1.4">
                <span class="l-en">{{ sc.desc_en }}</span>
                <span class="l-zh">{{ sc.desc_zh if (sc.desc_zh is defined and sc.desc_zh) else sc.desc_en }}</span>
              </div>
              {% endif %}
            </span>
            <div class="sc-bar-track"><div class="sc-bar-fill" style="width:{{ [_sc_s2,100]|min }}%;background:{{ 'var(--down)' if _sc_s2 >= 70 else ('var(--warn)' if _sc_s2 >= 35 else 'var(--muted)') }}"></div></div>
            <span class="sc-score" style="color:{{ 'var(--down)' if _sc_s2 >= 70 else ('var(--warn)' if _sc_s2 >= 35 else 'var(--muted)') }}">{{ sc.score }}</span>
            <span class="sc-band {{ _scc }}">
              <span class="l-en">{{ _scband }}</span>
              <span class="l-zh">{{ _scband_zh }}</span>
            </span>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {# — 7. Mood check — two lenses (rebuilt; replaces dead mx2-sent-* block) — #}
        {# MX2-SENTIMENT-START #}{# slice markers are a TEST CONTRACT — test_froth_fragility /
           test_fear_euphoria / test_fear_greed render exactly this region; keep them wrapping
           the mood section + the merged footer #}
        <div class="mx5-dlg-sep"></div>
        {% set ff = froth_fragility if froth_fragility is defined else none %}
        {% set fe = fear_euphoria if fear_euphoria is defined else none %}
        {% set fg = fear_greed if fear_greed is defined else none %}
        {% if ff is not none or fe is not none or fg is not none %}
        {% set _fe_sc = (fe.fe_score if (fe is not none and fe.fe_score is defined and fe.fe_score is not none) else none) %}
        {% set _fg_val = (fg.dial if (fg is not none and fg.dial is defined and fg.dial is not none) else none) %}
        {% set _ff_score = ((ff.score if (ff.score is defined and ff.score is not none) else (ff.headline if (ff.headline is defined and ff.headline is not none) else none)) if ff is not none else none) %}
        {% set _fe_band = (fe.band if (fe is not none and fe.band is defined and fe.band) else '') %}
        {% set _fg_label = (fg.label_en if (fg is not none and fg.label_en is defined) else '') %}
        {% set _bandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜','Extreme Fear':'极度恐惧','Extreme Greed':'极度贪婪'} %}
        <div class="rsx-mood" id="sentiment-regime">
          <div class="mx5-dlg-eyebrow">{{ t('Mood check — two lenses','情绪核对——两把尺') }}
            {{ help('Two sentiment lenses on one 0-100 scale: risk appetite (5-yr percentile of the risk-on/risk-off composite) and the broader sentiment mix. Internal name: Fear ↔ Euphoria: regime synthesis. Display-only.','同一0-100刻度上的两把情绪尺：风险偏好（风险偏好/避险合成的5年百分位）与广义情绪合成。内部名称：恐惧 ↔ 欣喜：周期综合。仅供展示。') }}
          </div>

          {# Wave C: enlarged two-lens track — labelled needle markers (lens name + value),
             risk appetite above / sentiment mix below; needles settle on dialog open. #}
          {% if _fe_sc is not none or _fg_val is not none %}
          <div class="rkc-mood-track-wrap">
            <div class="rkc-mood-track">
              {% if _fe_sc is not none %}
              {# Marker A: Risk appetite (flag above) #}
              <span class="rkc-mood-needle n-a" style="--rkc-pos:calc({{ _fe_sc }}% - 2px)"></span>
              <span class="rkc-mood-flag f-above" style="--rkc-pos:{{ _fe_sc }}%">
                <span class="rkc-mood-flag-name"><span class="l-en">Risk appetite</span><span class="l-zh">风险偏好</span></span>
                <span class="rkc-mood-flag-val">{{ _fe_sc }}</span>
              </span>
              {% endif %}
              {% if _fg_val is not none %}
              {# Marker B: Sentiment mix (flag below) #}
              <span class="rkc-mood-needle n-b" style="--rkc-pos:calc({{ _fg_val }}% - 2px)"></span>
              <span class="rkc-mood-flag f-below" style="--rkc-pos:{{ _fg_val }}%">
                <span class="rkc-mood-flag-val">{{ _fg_val }}</span>
                <span class="rkc-mood-flag-name"><span class="l-en">Sentiment mix</span><span class="l-zh">情绪合成</span></span>
              </span>
              {% endif %}
            </div>
          </div>
          {# all 5 instrument bands, both langs — a band-word contract (tests assert it),
             and the markers land between them so the finer scale earns its place #}
          <div class="rkc-mood-axis rsx-axis-labels">
            <span>{{ t('Panic','恐慌') }}</span>
            <span>{{ t('Fear','恐惧') }}</span>
            <span>{{ t('Neutral','中性') }}</span>
            <span>{{ t('Greed','贪婪') }}</span>
            <span>{{ t('Euphoria','欣喜') }}</span>
          </div>
          {# Marker A band chip row #}
          {% if _fe_sc is not none %}
          <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap"
               data-tip-en="5-year percentile of the risk-on/risk-off composite. Display-only — not a signal."
               data-tip-zh="风险偏好/避险合成的5年百分位。仅供展示，非信号。">
            <span class="l-en">Risk appetite</span><span class="l-zh">风险偏好</span>
            <span class="chip {{ 'c-down' if _fe_band in ('Panic','Fear') else ('c-up' if _fe_band in ('Greed','Euphoria') else 'c-muted') }}">{{ t(_fe_band, _bandzh.get(_fe_band, _fe_band)) if _fe_band else t('—','—') }}</span>
          </div>
          {% endif %}
          {# Marker B band chip row — id="fear-greed" is a test-contract anchor #}
          {% if _fg_val is not none %}
          <div id="fear-greed" style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:4px;display:flex;gap:8px;align-items:center;flex-wrap:wrap"
               data-tip-en="Fear / Greed sentiment context — equal-weight composite of {{ fg.n_legs_qualifying if (fg.n_legs_qualifying is defined) else '' }} qualifying indicators.{% if fg.young_tiles is defined and fg.young_tiles %} Context tiles still collecting (too young to count): {{ fg.young_tiles | map(attribute='name_en') | join(', ') }}.{% endif %} Display-only — not a signal."
               data-tip-zh="恐惧/贪婪情绪参考——{{ fg.n_legs_qualifying if (fg.n_legs_qualifying is defined) else '' }}项合格指标的等权合成。{% if fg.young_tiles is defined and fg.young_tiles %}以下指标数据尚短、暂不计入：{{ fg.young_tiles | map(attribute='name_zh') | join('、') }}。{% endif %}仅供展示，非信号。">
            <span class="l-en">Sentiment mix</span><span class="l-zh">情绪合成</span>
            <span class="chip {{ 'c-down' if _fg_val < 30 else ('c-up' if _fg_val >= 65 else 'c-muted') }}">{{ t(_fg_label, _bandzh.get(_fg_label, _fg_label)) if _fg_label else t('—','—') }}</span>
          </div>
          {% endif %}
          {# Disagreement line (only when both present and |A-B| >= 25) #}
          {% if _fe_sc is not none and _fg_val is not none and (_fe_sc - _fg_val)|abs >= 25 %}
          <div class="rsx-disagree">
            {% if _fe_sc > _fg_val %}
            <span class="l-en">The lenses disagree — risk appetite reads <b>{{ _fe_band }}</b> while the broader mix reads <b>{{ _fg_label }}</b>: heat is concentrated, not broad.</span>
            <span class="l-zh">两把尺不一致——风险偏好为<b>{{ _bandzh.get(_fe_band, _fe_band) }}</b>，而广义情绪为<b>{{ _bandzh.get(_fg_label, _fg_label) }}</b>：热度集中，并非全面亢奋。</span>
            {% else %}
            <span class="l-en">The lenses disagree — the broader mix reads <b>{{ _fg_label }}</b> while risk appetite reads <b>{{ _fe_band }}</b>: read both before leaning on either.</span>
            <span class="l-zh">两把尺不一致——广义情绪为<b>{{ _bandzh.get(_fg_label, _fg_label) }}</b>，而风险偏好为<b>{{ _bandzh.get(_fe_band, _fe_band) }}</b>：两者互证后再作判断。</span>
            {% endif %}
          </div>
          {% endif %}
          {% endif %}

          {# Froth & Fragility sub-block — top-risk gauge #}
          {% if ff is not none and _ff_score is not none %}
          {% set _ffc = 'var(--up)' if ff.band == 'calm' else ('var(--warn)' if (ff.band is defined and ff.band in ('watch','elevated')) else 'var(--down)') %}
          {% set ax = ((ff.face_a.score | round | int) if (ff.face_a is defined and ff.face_a.score is defined and ff.face_a.score is not none) else none) if ff is not none else none %}
          {% set bx = ((ff.face_b.score | round | int) if (ff.face_b is defined and ff.face_b.score is defined and ff.face_b.score is not none) else none) if ff is not none else none %}
          <div class="rsx-froth" id="froth-fragility">
            <div class="rsx-froth-hd">
              <span style="color:{{ _ffc }}">{{ t('Top-risk gauge','顶部风险表') }}</span>
              {{ help('Internal gauge: Froth & Fragility — face A Euphoria × face B Fragility / distribution. Only meaningful when both run high together.','内部量表：狂热与脆弱——A面亢奋 × B面脆弱／派发。两者同高才具意义。') }}
              <span style="font-size:20px;font-weight:900;font-variant-numeric:tabular-nums;color:{{ _ffc }}">{{ _ff_score|round|int }}</span>
              <span class="chip {{ 'c-down' if (ff.band is defined and ff.band in ('high','extreme')) else ('c-warn' if (ff.band is defined and ff.band in ('watch','elevated')) else 'c-muted') }}">
                <span class="l-en">{{ ff.band|capitalize if ff.band is defined and ff.band else '—' }}</span>
                <span class="l-zh">{{ ff.band_zh if (ff.band_zh is defined and ff.band_zh) else (ff.band|capitalize if ff.band is defined and ff.band else '—') }}</span>
              </span>
              {% if ff.provisional is defined and ff.provisional %}<span style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36))">{{ t('provisional','暂定') }}</span>{% endif %}
            </div>
            {% if ff.quadrant_en is defined and ff.quadrant_en %}
            <div class="rsx-froth-quad">
              <span class="l-en">{{ ff.quadrant_en }}</span>
              <span class="l-zh">{{ ff.quadrant_zh if (ff.quadrant_zh is defined and ff.quadrant_zh) else ff.quadrant_en }}</span>
            </div>
            {% endif %}
            {% if ax is not none and bx is not none %}
            <div class="rsx-froth-bars">
              <div class="rsx-froth-bar-row">
                <span class="rsx-froth-bar-lbl">{{ t('Euphoria','亢奋度') }}</span>
                <div class="rsx-froth-bar-track"><div class="rsx-froth-bar-fill" style="width:{{ [ax,100]|min }}%;background:var(--warn)"></div></div>
                <span class="rsx-froth-bar-val" style="color:var(--warn)">{{ ax }}</span>
              </div>
              <div class="rsx-froth-bar-row">
                <span class="rsx-froth-bar-lbl">{{ t('Hidden selling','暗中派发') }}</span>
                <div class="rsx-froth-bar-track"><div class="rsx-froth-bar-fill" style="width:{{ [bx,100]|min }}%;background:var(--down)"></div></div>
                <span class="rsx-froth-bar-val" style="color:var(--down)">{{ bx }}</span>
              </div>
            </div>
            {% endif %}
          </div>
          {% endif %}
        </div>
        {% endif %}

        {# — 8. One merged dialog footer (single as-of for the whole dialog + one caveat line) — #}
        {% set _rk_asof = (latest.date if (latest is defined and latest.date is defined and latest.date) else (intl_cascade.asof if (intl_cascade is defined and intl_cascade and intl_cascade.asof is defined and intl_cascade.asof) else none)) %}
        <div class="mx5-dlg-sep"></div>
        <div class="rsx-dlg-footer">
          {% if _rk_asof %}<span class="l-en">As of {{ _rk_asof }}. </span><span class="l-zh">数据截至 {{ _rk_asof }}。</span>{% endif %}
          <span class="l-en">Model estimates and mood gauges are display-only context — not forecasts; the response is sizing, not selection; forward records accruing.</span>
          <span class="l-zh">以上模型估计与情绪读数仅为参考——非预测；应对是仓位控制而非选股；前瞻记录积累中。</span>
        </div>
        {# MX2-SENTIMENT-END #}

        {# — 9. Upturn cross-ref row — #}
        {% if latest.ignition_radar is defined and latest.ignition_radar %}
        {% set _ign2 = latest.ignition_radar %}
        {% set _ign2_st = _ign2.state if (_ign2.state is defined and _ign2.state) else 'off' %}
        {% set _ign2_k = _ign2.k_count if (_ign2.k_count is defined and _ign2.k_count is not none) else 0 %}
        <div class="rsx-xref-row">
          <div class="rsx-xref-text">
            {% if _ign2_st == 'ignited' %}
            <span class="l-en">Upturn signs: <b>strong sign</b> ({{ _ign2_k }}/8) — see the Upturn panel</span>
            <span class="l-zh">转强迹象：<b>较强迹象</b>（{{ _ign2_k }}/8）——查看转强面板</span>
            {% elif _ign2_st == 'warming' %}
            <span class="l-en">Upturn signs: <b>early sign</b> ({{ _ign2_k }}/8) — see the Upturn panel</span>
            <span class="l-zh">转强迹象：<b>初步迹象</b>（{{ _ign2_k }}/8）——查看转强面板</span>
            {% else %}
            <span class="l-en">Upturn signs: none yet ({{ _ign2_k }}/8) — see the Upturn panel</span>
            <span class="l-zh">转强迹象：暂无（{{ _ign2_k }}/8）——查看转强面板</span>
            {% endif %}
          </div>
          <button type="button" class="rsx-xref-btn" onclick="mx5OpenDlg('dlg-ignition')">
            <span class="l-en">Open &rarr;</span><span class="l-zh">打开 &rarr;</span>
          </button>
        </div>
        {% endif %}

      </div>
    </div>
  </div>
  {% endif %}{# /market_state — dlg-risk #}

  {# dlg-ignition: Ignition Radar — Upturn Signs
     Gate: macro mode only + ignition_radar present (null = no dialog = no dead HTML).
     Opened from: adaptive hero button (Stage 1) + dlg-risk cross-ref row (Stage 2). #}
  {% if mode != 'stocks' and latest is defined and latest.ignition_radar is defined and latest.ignition_radar %}
  {%- set _ign = latest.ignition_radar -%}
  {%- set _ign_state = _ign.state if _ign.state is defined and _ign.state else 'off' -%}
  {%- set _ign_k = _ign.k_count if _ign.k_count is defined and _ign.k_count is not none else 0 -%}
  {%- set _ign_regime = _ign.regime if _ign.regime is defined and _ign.regime else {} -%}
  {%- set _ign_fragile = _ign_regime.fragile if _ign_regime.fragile is defined and _ign_regime.fragile else false -%}
  {%- set _ign_narrow = _ign.narrow if _ign.narrow is defined and _ign.narrow else {} -%}
  {%- set _ign_items = _ign_narrow['items'] if _ign_narrow['items'] is defined else [] -%}
  {%- set _ign_xref = _ign.radar_xref if _ign.radar_xref is defined and _ign.radar_xref else {} -%}
  {%- set _ign_fl = _ign.forward_log if _ign.forward_log is defined and _ign.forward_log else {} -%}
  <div class="mx5-dlg" id="dlg-ignition" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title">
          <span class="l-en">Ignition Radar &mdash; Upturn Signs</span>
          <span class="l-zh">点火雷达——转强迹象</span>
        </span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">

        {# ── §3-1: State hero ── #}
        <div class="igd-state-hero">
          {# K-meter: 8 dots #}
          <div class="igd-kmeter">
            <div class="igd-dots">
              {%- if _ign.chips is defined and _ign.chips %}
              {%- for c in _ign.chips %}
              <span class="igd-dot{{ ' lit' if c.lit is defined and c.lit }}{{ ' fresh' if c.fresh is defined and c.fresh }}"></span>
              {%- endfor %}
              {%- else %}
              {%- for _ in range(8) %}<span class="igd-dot"></span>{%- endfor %}
              {%- endif %}
            </div>
            <span class="igd-knum">K {{ _ign_k }}/8</span>
          </div>
          <div class="igd-state-text">
            {%- if _ign_state == 'ignited' %}
            <div class="igd-state-label">
              <span class="l-en">Strong sign &mdash; broad upturn evidence</span>
              <span class="l-zh">较强迹象——大盘转强证据较多</span>
            </div>
            {%- elif _ign_state == 'warming' %}
            <div class="igd-state-label">
              <span class="l-en">Early sign &mdash; first sparks, not confirmed</span>
              <span class="l-zh">初步迹象——初现火花，未经确认</span>
            </div>
            {%- else %}
            <div class="igd-state-label igd-off">
              <span class="l-en">Quiet &mdash; no upturn signs</span>
              <span class="l-zh">平静——暂无转强迹象</span>
            </div>
            {%- endif %}
            {%- if _ign.as_of is defined and _ign.as_of %}
            <div class="igd-asof">
              <span class="l-en">as of {{ _ign.as_of }}</span>
              <span class="l-zh">截至 {{ _ign.as_of }}</span>
            </div>
            {%- endif %}
            {%- if _ign_fragile %}
            <div class="igd-fragile-line">
              <span class="l-en">Fragile &mdash; narrow theme strength without broad participation. Watch &mdash; don&rsquo;t chase.</span>
              <span class="l-zh">脆弱——主题走强但参与度不足。观望，勿追高。</span>
            </div>
            {%- endif %}
          </div>
        </div>

        <div class="mx5-dlg-sep"></div>

        {# ── §3-2: Broad checks — 8 chips, 2-col grid ── #}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Broad market checks</span>
          <span class="l-zh">大盘检查</span>
        </div>
        <div class="igd-chips-sub">
          <span class="l-en">{{ _ign_k }} of 8 lit &mdash; a broad turn usually lights several at once.</span>
          <span class="l-zh">8项中{{ _ign_k }}项点亮——真正的大盘转强通常同时点亮多项。</span>
        </div>
        {%- if _ign.chips is defined and _ign.chips %}
        <div class="igd-chips-grid">
          {%- for c in _ign.chips %}
          <div class="igd-chip{{ ' lit' if c.lit is defined and c.lit }}{{ ' fresh' if c.fresh is defined and c.fresh }}"
            {%- if c.detail_en is defined and c.detail_en %} data-tip-en="{{ c.detail_en }}"{% endif %}
            {%- if c.detail_zh is defined and c.detail_zh %} data-tip-zh="{{ c.detail_zh }}"{% endif %}>
            <span class="igd-chip-dot"></span>
            <span class="igd-chip-body">
              <span class="igd-chip-lbl">
                <span class="l-en">{{ c.label_en if c.label_en is defined and c.label_en else c.key }}</span>
                <span class="l-zh">{{ c.label_zh if c.label_zh is defined and c.label_zh else c.key }}</span>
              </span>
              {%- if c.lit is defined and c.lit and c.since is defined and c.since %}
              <div class="igd-chip-since">{{ c.since }}</div>
              {%- endif %}
            </span>
          </div>
          {%- endfor %}
        </div>
        {%- endif %}

        <div class="mx5-dlg-sep"></div>

        {# ── §3-3: Theme board (narrow.items, skip idle, cap 8) ── #}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Theme strength</span>
          <span class="l-zh">主题强度</span>
        </div>
        {%- set _ign_active_items = _ign_items | selectattr('state', 'ne', 'idle') | list %}
        {%- if _ign_active_items %}
        {%- for it in _ign_active_items[:8] %}
        {%- set _it_sc = it.ignition_score if it.ignition_score is defined and it.ignition_score is not none else 0 %}
        {%- set _it_state = it.state if it.state is defined and it.state else 'idle' %}
        {%- set _it_name = it.name if it.name is defined and it.name else (it.id if it.id is defined else '') %}
        <div class="igd-theme-row">
          <span class="igd-theme-name"
            data-tip-en="{{ _it_name }}{% if it.rs_new_high is defined and it.rs_new_high %} · RS at 6-month high{% endif %}{% if it.above_200d_rising is defined and it.above_200d_rising %} · above rising 200d MA{% endif %}"
            data-tip-zh="{{ it.name_zh if it.name_zh is defined and it.name_zh else _it_name }}{% if it.rs_new_high is defined and it.rs_new_high %} · 相对强度创6个月新高{% endif %}{% if it.above_200d_rising is defined and it.above_200d_rising %} · 高于上升200日均线{% endif %}">
            <span class="l-en">{{ _it_name }}</span><span class="l-zh">{{ it.name_zh if (it.name_zh is defined and it.name_zh) else _it_name }}</span>
            {%- if it.rs_new_high is defined and it.rs_new_high %} <span class="igd-theme-flags">▲</span>{%- endif %}
            {%- if it.above_200d_rising is defined and it.above_200d_rising %} <span class="igd-theme-flags">↗</span>{%- endif %}
          </span>
          <span class="igd-theme-bar-wrap">
            <span class="igd-theme-bar {{ _it_state }}" style="width:{{ [(_it_sc * 100)|round|int, 100]|min }}%"></span>
          </span>
          <span class="igd-theme-pct">{{ (_it_sc * 100)|round|int }}%</span>
          <span class="igd-theme-state {{ _it_state }}">
            {%- if _it_state == 'igniting' %}
            <span class="l-en">turning up now</span><span class="l-zh">正在转强</span>
            {%- elif _it_state == 'running' %}
            <span class="l-en">still running</span><span class="l-zh">延续走强</span>
            {%- elif _it_state == 'fading' %}
            <span class="l-en">losing steam</span><span class="l-zh">动能减弱</span>
            {%- else %}
            <span class="l-en">{{ _it_state }}</span><span class="l-zh">{{ _it_state }}</span>
            {%- endif %}
          </span>
        </div>
        {%- endfor %}
        {%- else %}
        <div class="igd-theme-null">
          <span class="l-en">No themes turning up right now.</span>
          <span class="l-zh">当前没有主题在转强。</span>
        </div>
        {%- endif %}

        <div class="mx5-dlg-sep"></div>

        {# ── §3-4: Stance line ── #}
        {%- if _ign_regime.do_en is defined and _ign_regime.do_en %}
        <div class="igd-stance">
          <span class="l-en">{{ _ign_regime.do_en }}</span>
          <span class="l-zh">{{ _ign_regime.do_zh if _ign_regime.do_zh is defined and _ign_regime.do_zh else _ign_regime.do_en }}</span>
        </div>
        {%- endif %}

        {# ── §3-5: Where to act pointer ── #}
        <div class="igd-action-ptr">
          <span class="l-en">If these signs persist, the US board&rsquo;s Buy lanes upgrade on their own. &mdash; <a href="us_stocks.html">Open the US board &rarr;</a></span>
          <span class="l-zh">若迹象持续，美股行动板的买入通道会自行升级。&mdash; <a href="us_stocks.html">打开美股行动板 &rarr;</a></span>
        </div>

        <div class="mx5-dlg-sep"></div>

        {# ── §3-6: Risk cross-ref chip (gate radar_xref.state) ── #}
        {%- if _ign_xref.state is defined and _ign_xref.state %}
        {%- set _xref_state = _ign_xref.state %}
        <button type="button"
          class="igd-risk-xref {{ _xref_state }}"
          onclick="mx5OpenDlg('dlg-risk')"
          aria-haspopup="dialog">
          <span class="l-en">Risk Radar: {{ _xref_state | title }}</span>
          <span class="l-zh">风险雷达：{{ {'caution':'警惕','watch':'关注','elevated':'升高','risk-off':'避险','calm':'平静'}.get(_xref_state, _xref_state) }}</span>
        </button>
        <div class="igd-action-ptr" style="margin-top:4px">
          <span class="l-en">Risk first when both speak.</span>
          <span class="l-zh">两者同时作响时，以风险为先。</span>
        </div>
        {%- endif %}

        <div class="mx5-dlg-sep"></div>

        {# ── §3-7: Footer — forward log accrual ── #}
        <div class="igd-footer">
          {%- set _fl_n = _ign_fl.n_graded if _ign_fl.n_graded is defined and _ign_fl.n_graded is not none else 0 %}
          {%- if _fl_n and _fl_n > 0 %}
          <span class="l-en">Forward record accruing ({{ _fl_n }} graded) &mdash; display context until the record matures.</span>
          <span class="l-zh">前瞻记录积累中（已评分{{ _fl_n }}）——记录成熟前仅供参考。</span>
          {%- else %}
          <span class="l-en">Forward record accruing (0 graded so far) &mdash; display context until the record matures.</span>
          <span class="l-zh">前瞻记录积累中（暂无评分）——记录成熟前仅供参考。</span>
          {%- endif %}
        </div>

      </div>{# /mx5-dlg-body #}
    </div>{# /mx5-dlg-panel #}
  </div>{# /dlg-ignition #}
  {% endif %}{# /dlg-ignition gate #}

  {# dlg-policy: Policy Monitor — full redesign (spec §4b) #}
  {% if policy_lever is defined and policy_lever %}
  {# Precompute shared vars for dialog #}
  {% set _DPL = policy_lever %}
  {% set _dpl_s = _DPL.get('state') or 'QUIET' %}
  {% set _dplc = 'c-down' if _dpl_s == 'ARMED' else ('c-warn' if _dpl_s == 'ELEVATED' else 'c-muted') %}
  {% set _dpl_sent_en = {'ARMED':'Active repricing in progress','ELEVATED':'Elevated — watch for market repricing','QUIET':'No active policy pressure'}.get(_dpl_s,'') %}
  {% set _dpl_sent_zh = {'ARMED':'重定价进行中','ELEVATED':'警戒 — 留意市场重定价','QUIET':'当前无积极政策压力'}.get(_dpl_s,'') %}
  {# Fed stance for dialog #}
  {% set _dpl_fed = (latest.fed_stance.stance if (latest is defined and latest.fed_stance is defined and latest.fed_stance and latest.fed_stance.stance is defined and latest.fed_stance.stance != 'unknown') else none) %}
  {% set _dpl_fsl = {'hawkish':'Hawkish','very-hawkish':'Very Hawkish','dovish':'Dovish','very-dovish':'Very Dovish','neutral':'Neutral'} %}
  {% set _dpl_fsl_zh = {'hawkish':'鹰派','very-hawkish':'超鹰派','dovish':'鸽派','very-dovish':'超鸽派','neutral':'中性'} %}
  {% set _dpl_guid_en = {'tightening':'leaning tighter','easing':'leaning easier','on_hold':'on hold','mixed':'mixed signals'} %}
  {% set _dpl_guid_zh = {'tightening':'倾向收紧','easing':'倾向宽松','on_hold':'按兵不动','mixed':'信号混杂'} %}
  {% set _dpl_guid_v = (latest.fed_stance.guidance if (latest is defined and latest.fed_stance is defined and latest.fed_stance.guidance is defined) else none) %}
  {# Rate path for dialog chart (all fields guarded) #}
  {% set _dfp = (latest.fed_path if (latest is defined and latest.fed_path is defined and latest.fed_path) else none) %}
  {% set _dfp_impl = (_dfp.implied if (_dfp and _dfp.implied is defined and _dfp.implied) else none) %}
  {# is not none, NOT is defined — see the face-sparkline guard: None horizons crash |min #}
  {% set _dfp_ok = (_dfp_impl and _dfp_impl.get('now') is not none and _dfp_impl.get('m1') is not none and _dfp_impl.get('m3') is not none and _dfp_impl.get('m6') is not none and _dfp_impl.get('m12') is not none) %}
  {# Flip confirmation for dialog #}
  {% set _DFC = (flip_confirmation if (flip_confirmation is defined and flip_confirmation and flip_confirmation.last_event is defined) else none) %}
  <div class="mx5-dlg" id="dlg-policy" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Policy Monitor</span><span class="l-zh">政策监测</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        <div id="dlg-policy-lever-card">

        {# ── §4b-1: State hero ───────────────────────────────────── #}
        <div class="plx-state-hero">
          <span class="chip {{ _dplc }}" style="font-size:15px;padding:6px 16px;font-weight:700">
            <span class="l-en">{{ _dpl_s }}</span>
            <span class="l-zh">{{ {'ARMED':'已触发','ELEVATED':'警戒','QUIET':'平静'}.get(_dpl_s, _dpl_s) }}</span>
          </span>
          <div>
            <div class="plx-state-sent">
              <span class="l-en">{{ _dpl_sent_en }}</span>
              <span class="l-zh">{{ _dpl_sent_zh }}</span>
            </div>
            {% if _DPL.get('as_of') %}
            <div class="plx-asof">
              <span class="l-en">As of {{ _DPL.as_of }}</span>
              <span class="l-zh">截至 {{ _DPL.as_of }}</span>
            </div>
            {% endif %}
          </div>
        </div>
        {% if _DPL.get('framing') %}
        <div class="plx-framing">
          <span class="l-en">{{ _DPL.framing }}</span>
          <span class="l-zh">{{ _DPL.get('framing_zh') or _DPL.framing }}</span>
        </div>
        {% endif %}

        {# ── §4b-2: Rate path chart ──────────────────────────────── #}
        {% if _dfp_ok %}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Rate Path</span><span class="l-zh">利率路径</span>
        </div>
        <div class="plx-chart-wrap">
        {# Build 5-point polyline: x positions evenly spaced 0..540 in 640-wide chart (padding 50 left/right)
           y: rate % auto-scaled over implied ∪ dots (pad 0.15pp each side); chart height inner = 120px (y 30..150) #}
        {% set _ch_impl = [_dfp_impl.now, _dfp_impl.m1, _dfp_impl.m3, _dfp_impl.m6, _dfp_impl.m12] %}
        {# Collect dot medians for dots in chart range (year 2026 → m6 horizon slot) #}
        {% set _ch_dots = (_dfp.dots if (_dfp.dots is defined and _dfp.dots) else []) %}
        {# All y-values for scaling #}
        {% set _ch_allvals = _ch_impl[:] %}
        {% for d in _ch_dots %}{% if _ch_allvals.append(d.median) %}{% endif %}{% endfor %}
        {% set _ch_min_raw = _ch_allvals | min %}
        {% set _ch_max_raw = _ch_allvals | max %}
        {% set _ch_pad = 0.15 %}
        {% set _ch_ymin = _ch_min_raw - _ch_pad %}
        {% set _ch_ymax = _ch_max_raw + _ch_pad %}
        {% set _ch_yrange = (_ch_ymax - _ch_ymin) if (_ch_ymax - _ch_ymin) > 0.01 else 0.5 %}
        {# Chart geometry: viewBox 0 0 640 180; x 50..590, y 20..150 (inner h=130) #}
        {% set _ch_xl = 50 %}
        {% set _ch_xr = 590 %}
        {% set _ch_yt = 20 %}
        {% set _ch_yb = 150 %}
        {% set _ch_w = 540 %}
        {% set _ch_h = 130 %}
        {# 5 x positions evenly spaced #}
        {# parens are load-bearing: `w*0.25|round(1)` parses as `w*(0.25|round(1))` = w*0.2 #}
        {% set _ch_xs = [_ch_xl, _ch_xl + ((_ch_w*0.25)|round(1)|float), _ch_xl + ((_ch_w*0.5)|round(1)|float), _ch_xl + ((_ch_w*0.75)|round(1)|float), _ch_xr] %}
        {# Macro to convert rate value → SVG y coordinate #}
        {# Helper: rate to y #}
        {% macro ry(v) %}{{ (_ch_yb - _ch_h * (v - _ch_ymin) / _ch_yrange) | round(1) }}{% endmacro %}
        {# Build polyline points for implied path #}
        {% set _ch_pts = [] %}
        {% for i in range(5) %}
          {% if _ch_pts.append(_ch_xs[i]|string ~ ',' ~ ry(_ch_impl[i])) %}{% endif %}
        {% endfor %}
        {# Area fill path #}
        {% set _ch_area = 'M' ~ _ch_pts[0] ~ ' L' ~ _ch_pts[1] ~ ' L' ~ _ch_pts[2] ~ ' L' ~ _ch_pts[3] ~ ' L' ~ _ch_pts[4] ~ ' L' ~ _ch_xr|string ~ ',' ~ _ch_yb|string ~ ' L' ~ _ch_xl|string ~ ',' ~ _ch_yb|string ~ ' Z' %}
        {# Target mid dashed line y-coord #}
        {% set _ch_target_mid = (_dfp.target_mid if (_dfp.target_mid is defined and _dfp.target_mid is not none) else _dfp_impl.now) %}
        {% set _ch_ydash = ry(_ch_target_mid) %}
        {# Classify dots: current-year dot → in-chart m6 slot (_ch_xs[3]), outer years = annotation
           chips only. Year derived from the data date so this survives the calendar rollover. #}
        {% set _ch_cur_year = (latest.date[:4]|int) if (latest is defined and latest.date is defined and latest.date) else none %}
        {% set _ch_dots_inner = [] %}
        {% set _ch_dots_outer = [] %}
        {% for d in _ch_dots %}
          {% if d.year is defined and _ch_cur_year is not none and d.year == _ch_cur_year %}
            {% if _ch_dots_inner.append(d) %}{% endif %}
          {% else %}
            {% if _ch_dots_outer.append(d) %}{% endif %}
          {% endif %}
        {% endfor %}
        {# Gap chip values #}
        {% set _ch_gap = (_dfp.gap if (_dfp.gap is defined and _dfp.gap) else none) %}
        <svg class="plx-chart-svg" viewBox="0 0 640 180" role="img">
          <defs>
            <linearGradient id="plxChartGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--isle-policy)" stop-opacity=".18"/>
              <stop offset="100%" stop-color="var(--isle-policy)" stop-opacity="0"/>
            </linearGradient>
          </defs>
          {# Area fill under implied path #}
          <path class="fbm-chart-area" d="{{ _ch_area }}" fill="url(#plxChartGrad)"/>
          {# Dashed hairline at current target mid #}
          <line x1="{{ _ch_xl }}" y1="{{ _ch_ydash }}" x2="{{ _ch_xr }}" y2="{{ _ch_ydash }}" stroke="rgba(255,255,255,.18)" stroke-width="1" stroke-dasharray="4,4"/>
          {# Implied path polyline — .fbm-chart-line drives the draw-in reveal on open #}
          <polyline class="fbm-chart-line" style="--dash:760" points="{{ _ch_pts | join(' ') }}" fill="none" stroke="var(--isle-policy)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
          {# Dots and value labels at each implied point #}
          {% for i in range(5) %}
          {% set _px = _ch_xs[i] %}
          {% set _py = ry(_ch_impl[i]) | float %}
          <circle class="fbm-chart-node" cx="{{ _px }}" cy="{{ _py }}" r="4" fill="var(--isle-policy)" stroke="rgba(13,17,24,.8)" stroke-width="1.5"/>
          <text class="fbm-chart-node" x="{{ _px }}" y="{{ _py - 8 }}" text-anchor="middle" font-size="10" fill="var(--isle-policy)" font-family="inherit" font-variant-numeric="tabular-nums">{{ '%.2f'|format(_ch_impl[i]) }}%</text>
          {% endfor %}
          {# Inner FOMC dot-plot diamonds (2026 → m6 slot) #}
          {% for d in _ch_dots_inner %}
          {% set _dpx = _ch_xs[3] %}
          {% set _dpy = ry(d.median) | float %}
          {# Diamond shape via polygon offset ±6,0 and 0,±6 #}
          <polygon class="fbm-chart-diamond" points="{{ _dpx }},{{ _dpy - 6 }} {{ _dpx + 6 }},{{ _dpy }} {{ _dpx }},{{ _dpy + 6 }} {{ _dpx - 6 }},{{ _dpy }}" fill="var(--warn,#f59e0b)" fill-opacity=".85"/>
          {% endfor %}
          {# X-axis labels (EN and ZH via SVG text — bilingual handled via l-en/l-zh CSS;
             SVG text does NOT support span so we emit two separate SVG text elements
             per the svg-span-breakout law — EN visible by default, ZH shown on lang switch) #}
          {% set _ch_xlabels_en = ['Now','1m','3m','6m','12m'] %}
          {% set _ch_xlabels_zh = ['现在','1月','3月','6月','12月'] %}
          {% for i in range(5) %}
          <text class="l-en" x="{{ _ch_xs[i] }}" y="170" text-anchor="middle" font-size="10" fill="rgba(255,255,255,.36)" font-family="inherit">{{ _ch_xlabels_en[i] }}</text>
          <text class="l-zh" x="{{ _ch_xs[i] }}" y="170" text-anchor="middle" font-size="10" fill="rgba(255,255,255,.36)" font-family="inherit">{{ _ch_xlabels_zh[i] }}</text>
          {% endfor %}
        </svg>
        {# Outer dot-plot year annotations (e.g. '27 3.60%) as chips below chart #}
        {% if _ch_dots_outer %}
        <div class="plx-dot-chips">
          {% for d in _ch_dots_outer %}
          <span class="plx-dot-chip">
            <span class="l-en">'{{ (d.year|string)[2:] }} {{ '%.2f'|format(d.median) }}% (Fed dot)</span>
            <span class="l-zh">'{{ (d.year|string)[2:] }} {{ '%.2f'|format(d.median) }}%（美联储点图）</span>
          </span>
          {% endfor %}
        </div>
        {% endif %}
        {# Caption row #}
        <div class="plx-chart-caption">
          {% if _dfp.read_en is defined and _dfp.read_en %}
          <span class="l-en">{{ _dfp.read_en }}</span>
          {% elif _dfp.headline_en is defined and _dfp.headline_en %}
          <span class="l-en">{{ _dfp.headline_en }}</span>
          {% else %}
          <span class="l-en">Market-implied rate path (ZQ fed-funds futures).</span>
          {% endif %}
          {# ZH mirrors the EN preference order: read_zh → headline_zh → built line #}
          {% if _dfp.read_zh is defined and _dfp.read_zh %}
          <span class="l-zh">{{ _dfp.read_zh }}</span>
          {% elif _dfp.headline_zh is defined and _dfp.headline_zh %}
          <span class="l-zh">{{ _dfp.headline_zh }}</span>
          {% else %}
          {% set _dfp_cuts = (_dfp.implied_cuts_12m if (_dfp.implied_cuts_12m is defined and _dfp.implied_cuts_12m is not none) else 0) %}
          {% set _dfp_n_zh = (_dfp_cuts | abs) | round(0) | int %}
          {% set _dfp_dir_zh = '加息' if _dfp_cuts < 0 else ('降息' if _dfp_cuts > 0 else '不变') %}
          <span class="l-zh">市场隐含利率路径：未来12个月定价约{{ _dfp_n_zh }}次{{ _dfp_dir_zh }}。</span>
          {% endif %}
          {# Gap chip (Fed vs market divergence) #}
          {% if _ch_gap and _ch_gap.lean_en is defined and _ch_gap.gap_bp is defined %}
          <span class="plx-chart-gap-chip"
            data-tip-en="Fed dot at {{ _ch_gap.horizon_label }}: {{ _ch_gap.fed_dot }}%. Market: {{ _ch_gap.market }}%. Gap {{ _ch_gap.gap_bp }}bp."
            data-tip-zh="美联储点图{{ _ch_gap.horizon_label }}: {{ _ch_gap.fed_dot }}%，市场定价: {{ _ch_gap.market }}%，差距{{ _ch_gap.gap_bp }}bp。">
            <span class="l-en">{{ _ch_gap.lean_en }} ({{ _ch_gap.gap_bp }}bp at {{ _ch_gap.horizon_label }})</span>
            <span class="l-zh">{{ _ch_gap.get('lean_zh') or _ch_gap.lean_en }}（{{ _ch_gap.gap_bp }}bp @ {{ _ch_gap.horizon_label }}）</span>
          </span>
          {% endif %}
        </div>
        </div>{# /plx-chart-wrap #}
        {% endif %}{# /_dfp_ok #}

        <div class="mx5-dlg-sep"></div>

        {# ── §4b-3: Fed stance card ──────────────────────────────── #}
        {% if _dpl_fed %}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Fed Stance</span><span class="l-zh">美联储立场</span>
        </div>
        <div class="plx-stance-card">
          <div class="plx-stance-label">
            <span class="l-en">{{ _dpl_fsl.get(_dpl_fed, _dpl_fed) }}{% if _dpl_guid_v %} — {{ _dpl_guid_en.get(_dpl_guid_v, _dpl_guid_v) }}{% endif %}</span>
            <span class="l-zh">{{ _dpl_fsl_zh.get(_dpl_fed, _dpl_fed) }}{% if _dpl_guid_v %} — {{ _dpl_guid_zh.get(_dpl_guid_v, _dpl_guid_v) }}{% endif %}</span>
          </div>
          {% if latest is defined and latest.fed_stance is defined and latest.fed_stance.market_vs_fed_en is defined and latest.fed_stance.market_vs_fed_en %}
          <div class="plx-stance-mve">
            <span class="l-en">{{ latest.fed_stance.market_vs_fed_en }}</span>
            <span class="l-zh">{{ latest.fed_stance.get('market_vs_fed_zh') or latest.fed_stance.market_vs_fed_en }}</span>
          </div>
          {% endif %}
          {% if latest is defined and latest.fed_stance is defined and latest.fed_stance.drivers_en is defined and latest.fed_stance.drivers_en %}
          {% set _plx_drv_zh = (latest.fed_stance.drivers_zh if (latest.fed_stance.drivers_zh is defined and latest.fed_stance.drivers_zh) else []) %}
          <div class="plx-drivers-chips">
            {% for drv in latest.fed_stance.drivers_en[:3] %}
            <span class="plx-driver-chip"><span class="l-en">{{ drv }}</span><span class="l-zh">{{ _plx_drv_zh[loop.index0] if loop.index0 < _plx_drv_zh|length else drv }}</span></span>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="mx5-dlg-sep"></div>
        {% endif %}

        {# ── §4b-4: Jawboning activity ───────────────────────────── #}
        {% if _DPL.get('jawboning') %}
        {% set _DJW = _DPL.jawboning %}
        {% if _DJW.get('n_7d') is not none %}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Jawboning Activity</span><span class="l-zh">政策发声活跃度</span>
        </div>
        <div class="plx-jaw-counts">
          <div class="plx-jaw-count-box">
            <div class="plx-jaw-count-num">{{ _DJW.n_7d }}</div>
            <div class="plx-jaw-count-lbl">
              <span class="l-en">speeches 7d</span><span class="l-zh">7日发声</span>
            </div>
          </div>
          <div class="plx-jaw-count-box">
            <div class="plx-jaw-count-num">{{ _DJW.get('n_30d') or '—' }}</div>
            <div class="plx-jaw-count-lbl">
              <span class="l-en">speeches 30d</span><span class="l-zh">30日发声</span>
            </div>
          </div>
        </div>
        {# 7d vs 30d proportion bar (guard div/zero) #}
        {% set _jaw_n7 = _DJW.n_7d | int %}
        {% set _jaw_n30 = (_DJW.get('n_30d') or 1) | int %}
        {% set _jaw_pct = ([(_jaw_n7 / _jaw_n30 * 100) | round(0) | int, 100] | min) if _jaw_n30 > 0 else 0 %}
        <div class="plx-jaw-bar-track"><div class="plx-jaw-bar-fill" style="width:{{ _jaw_pct }}%"></div></div>
        {% if _DJW.get('last_alert_ts') %}
        <div class="plx-jaw-ts">
          <span class="l-en">Last event: {{ _DJW.last_alert_ts[:10] }}</span>
          <span class="l-zh">最近事件：{{ _DJW.last_alert_ts[:10] }}</span>
        </div>
        {% endif %}
        {% if _DJW.get('last_alert_summary') %}
        <div class="plx-jaw-summary">
          <span class="l-en">{{ _DJW.last_alert_summary }}</span>
          <span class="l-zh">{{ _DJW.get('last_alert_summary_zh') or _DJW.last_alert_summary }}</span>
        </div>
        {% endif %}
        <div class="mx5-dlg-sep"></div>
        {% endif %}
        {% endif %}

        {# ── §4b-5: Lever board ──────────────────────────────────── #}
        {% if _DPL.get('levers') %}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Lever Board</span><span class="l-zh">杠杆面板</span>
        </div>
        <div style="margin-bottom:12px">
          {% for lv in _DPL.levers %}
          {% set _lv_armed = (lv.arming.armed if (lv.arming is defined and lv.arming and lv.arming.armed is defined) else false) %}
          {% set _lv_stk = (lv.arming.stoch_k if (lv.arming is defined and lv.arming and lv.arming.stoch_k is defined and lv.arming.stoch_k is not none) else none) %}
          <div class="plx-lever-row">
            <div>
              <div class="plx-lever-name">
                <span class="l-en">{{ lv.name if lv.name is defined else '' }}</span>
                <span class="l-zh">{{ (lv.name_zh if lv.name_zh is defined and lv.name_zh else (lv.name if lv.name is defined else '')) }}</span>
              </div>
              {% if _lv_stk is not none %}
              {# bar carries the LEVEL only; the state colour lives on the armed dot —
                 a quiet lever with a high oscillator must not read as an alarm #}
              <div class="plx-lever-stoch"
                   data-tip-en="Setup gauge (stochastic %K): {{ _lv_stk|round(0)|int }}/100 — how coiled this lever's asset is; state is set by the Armed/Quiet flag, not this bar"
                   data-tip-zh="蓄势程度（随机指标%K）：{{ _lv_stk|round(0)|int }}/100 — 状态以“已触发/平静”标记为准，非此条形">
                <div class="plx-lever-stoch-fill" style="width:{{ [_lv_stk|round(0)|int, 100]|min }}%;background:{{ 'var(--down)' if _lv_armed else 'color-mix(in srgb,var(--isle-policy) 55%,transparent)' }}"></div>
              </div>
              {% endif %}
              {% if lv.watch is defined and lv.watch %}
              <div class="plx-lever-watch">
                <span class="l-en">{{ lv.watch }}</span>
                <span class="l-zh">{{ (lv.watch_zh if lv.watch_zh is defined and lv.watch_zh else lv.watch) }}</span>
              </div>
              {% endif %}
              {% if lv.copy_as_of is defined and lv.copy_as_of %}
              <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.36));margin-top:3px">
                <span class="l-en">caption as of {{ lv.copy_as_of }}{% if lv.copy_stale is defined and lv.copy_stale %} — <em>review due</em>{% endif %}</span>
                <span class="l-zh">文案更新于 {{ lv.copy_as_of }}{% if lv.copy_stale is defined and lv.copy_stale %} — <em>待复核</em>{% endif %}</span>
              </div>
              {% endif %}
            </div>
            <div class="plx-lever-status">
              <svg width="7" height="7" viewBox="0 0 7 7"><circle cx="3.5" cy="3.5" r="3.5" fill="{{ 'var(--down)' if _lv_armed else 'rgba(255,255,255,.22)' }}"/></svg>
              <span>
                <span class="l-en">{{ 'Armed' if _lv_armed else 'Quiet' }}</span>
                <span class="l-zh">{{ '已触发' if _lv_armed else '平静' }}</span>
              </span>
            </div>
          </div>
          {% endfor %}
        </div>
        {# Favored complex chip row #}
        {% if _DPL.get('favored_complex') and _DPL.favored_complex.get('basket') %}
        {% set _fc = _DPL.favored_complex %}
        <div class="plx-favored"
          data-tip-en="{{ _fc.get('note','') }}"
          data-tip-zh="{{ _fc.get('note_zh') or _fc.get('note','') }}">
          {% for b in _fc.basket %}
          <span class="plx-basket-chip">{{ b }}</span>
          {% endfor %}
          {% if _fc.drawdown_pct is defined and _fc.drawdown_pct is not none %}
          <span style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6));align-self:center">
            <span class="l-en">drawdown {{ '%.1f'|format(_fc.drawdown_pct) }}% from 120d peak</span>
            <span class="l-zh">较120日高点回撤{{ '%.1f'|format(_fc.drawdown_pct) }}%</span>
          </span>
          {% endif %}
        </div>
        {% endif %}
        <div class="mx5-dlg-sep"></div>
        {% endif %}

        {# ── §4b-6: Political runway ─────────────────────────────── #}
        {% if _DPL.get('calendar') and _DPL.calendar.get('days_to_midterm') is not none %}
        {% set _dcal = _DPL.calendar %}
        <div class="plx-cal-row">
          <span class="plx-cal-countdown">{{ _dcal.days_to_midterm }}</span>
          <div>
            <div style="font-size:12px;font-weight:600">
              <span class="l-en">days to the midterm election</span>
              <span class="l-zh">距中期选举</span>
            </div>
            {% if _dcal.get('context_note') %}
            <div class="plx-cal-note">
              <span class="l-en">{{ _dcal.context_note }}</span>
              <span class="l-zh">{{ _dcal.get('context_note_zh') or _dcal.context_note }}</span>
            </div>
            {% endif %}
          </div>
        </div>
        <div class="mx5-dlg-sep"></div>
        {% endif %}

        {# ── §4b-7: Repricing channels ───────────────────────────── #}
        <div class="mx5-dlg-eyebrow">
          <span class="l-en">Active Repricing Channels</span><span class="l-zh">活跃重定价渠道</span>
        </div>
        {% set _dplrepr = _DPL.get('repricing_components') %}
        {% if _dplrepr %}
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:14px">
          {% for r in _dplrepr %}
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:rgba(245,158,11,.05);border:1px solid rgba(245,158,11,.14);border-radius:8px">
            <span style="font-size:12px"><span class="l-en">{{ r.label_en if r.label_en is defined else r.name }}</span><span class="l-zh">{{ r.label_zh if r.label_zh is defined else (r.name_zh if r.name_zh is defined else r.name) }}</span></span>
            <span class="chip c-warn" style="font-size:11px;padding:2px 8px"><span class="l-en">Active</span><span class="l-zh">活跃</span></span>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="plx-null">
          <span class="l-en">No repricing channels active today.</span>
          <span class="l-zh">今日无活跃重定价渠道。</span>
        </div>
        {% endif %}

        {# ── §4b-8: Last confirmed flip + disclaimer ─────────────── #}
        {% if _DFC %}
        <div class="mx5-dlg-sep"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:rgba(255,255,255,.04);border-radius:8px;margin-bottom:8px">
          <span style="font-size:12px;color:var(--ink-2,rgba(255,255,255,.6))">
            <span class="l-en">Last confirmed flip</span><span class="l-zh">最近确认翻转</span>
          </span>
          <span style="font-size:12px;font-weight:600;font-variant-numeric:tabular-nums">{{ _DFC.last_event.event_date }}</span>
        </div>
        {% if _DFC.last_event.get('description') or _DFC.last_event.get('description_zh') %}
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.6;margin-bottom:8px;padding-left:4px">
          <span class="l-en">{{ _DFC.last_event.get('description','') }}</span>
          <span class="l-zh">{{ _DFC.last_event.get('description_zh') or _DFC.last_event.get('description','') }}</span>
        </div>
        {% endif %}
        {% endif %}
        <div class="mx5-dlg-sep"></div>
        <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));line-height:1.6">
          <span class="l-en">Context only — not a forecast.</span>
          <span class="l-zh">仅供参考 — 非预测。</span>
        </div>

        </div>{# /dlg-policy-lever-card #}
      </div>
    </div>
  </div>
  {% endif %}{# /policy_lever — dlg-policy #}

  {# dlg-aibrief: AI Brief synthesis (v5.2 rebuild 1.5) #}
  {% if mode != 'stocks' %}
  <div class="mx5-dlg" id="dlg-aibrief" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">AI Brief — Synthesis</span><span class="l-zh">AI简报 — 综合</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {# ABX v2 — the ONE shared body renderer (_aibrief_body.html.j2). show_catalysts
           because macro is the only lens with forward_watch. The footer link-out is
           injected into the macro's footer slot. Fail-open: master_brief absent →
           the existing news-teaser fallback below. #}
        {% if master_brief is defined and master_brief and (master_brief.get('summary') or master_brief.get('tldr') or master_brief.get('regime_read')) %}
        {% call aib.aibrief_body(master_brief, 'macro', show_catalysts=True) %}
        <div class="isle-aibrief-footer"><span></span><a href="aibrief.html" class="isle-aibrief-link"><span class="l-en">Full brief page (China &amp; Bitcoin lenses) →</span><span class="l-zh">完整简报页（中国与比特币视角）→</span></a></div>
        {% endcall %}
        {% else %}
        {# Fallback teaser when master_brief is absent — keeps the mandatory badge visible #}
        <div class="aib2"><div class="aib2-hdr">
          <div class="aib2-icon" aria-hidden="true">AI</div>
          <div class="aib2-hdr-meta">
            <div class="aib2-hdr-title"><span class="l-en">AI Daily Brief · cross-asset synthesis</span><span class="l-zh">AI 每日简报 · 跨资产综合</span></div>
          </div>
          <span class="aib2-badge"><span class="l-en">A read-through of existing signals — not a signal source</span><span class="l-zh">仅为现有信号的汇总解读 — 非独立信号源</span></span>
        </div></div>
        {# Fallback teaser when master_brief is absent #}
        {% if macro_news is defined and macro_news and macro_news.synthesis and macro_news.synthesis.get('read') %}
        {% set _dlg_syn = macro_news.synthesis %}
        {% set _dlg_ch_zh = {'monetary':'美联储与利率','inflation':'通胀','labor':'就业','growth':'增长','credit':'信贷','fiscal':'财政','fiscal_trade':'财政与贸易','earnings':'业绩','guidance':'指引','analyst':'分析师','deals':'并购','capital_return':'回购','stocks':'个股','macro':'宏观','rates':'利率','stock_wire':'个股快讯'} %}
        {% set _dlg_ch_en = {'capital_return':'buybacks','fiscal_trade':'fiscal & trade','stock_wire':'stock wire','monetary':'Fed & rates'} %}
        {# prefer the engine's bilingual CHANNEL_LABEL payload dict (doctrine Law 2 — no raw
           slugs on glance surfaces); inline dicts remain the fallback for older payloads. #}
        {% set _dc = _dlg_syn.get('dominant_channel') %}
        {% set _dcl = (macro_news.channel_label or {}).get(_dc) if _dc else none %}
        <div class="isle-aibrief-body">
          <span class="l-en">{{ _dlg_syn.get('high_impact_count', 0) }} high-impact item{{ 's' if _dlg_syn.get('high_impact_count', 0) != 1 }} today{% if _dc %} · dominant: <strong>{{ _dcl[0] if _dcl else _dlg_ch_en.get(_dc, _dc|replace('_',' ')) }}</strong>{% endif %}</span>
          <span class="l-zh">今日 {{ _dlg_syn.get('high_impact_count', 0) }} 条高影响信息{% if _dc %} · 主导：<strong>{{ _dcl[1] if _dcl else _dlg_ch_zh.get(_dc, _dc|replace('_',' ')) }}</strong>{% endif %}</span>
        </div>
        {% else %}
        <div class="isle-aibrief-body">{{ t('AI reads every dashboard in one place — the regime, where signals conflict, the rotation thesis and what to watch next. Research context only, never a signal.', 'AI 在一处解读每个看板 — 周期、信号冲突、轮动假设与后续关注。仅供研究参考，绝非交易信号。') }}</div>
        {% endif %}
        <div class="isle-aibrief-footer"><span></span><a href="aibrief.html" class="isle-aibrief-link">{{ t('Full AI brief →','完整 AI 简报 →') }}</a></div>
        {% endif %}
      </div>
    </div>
  </div>

  {# dlg-news: Alerts + market intelligence #}
  <div class="mx5-dlg" id="dlg-news" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">News — Market Intelligence</span><span class="l-zh">新闻 — 市场情报</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {# All fired alerts — grouped by conviction tier: act+watch (Priority) then context #}
        {% if alerts %}
        {% set _dlg_alv5_all = alerts %}
        {# Same partition as the face: event_risk (engine-tiered context = no edge claim) is
           time-critical calendar fact and sits with Priority; its chip says "Event", honest #}
        {% set _dlg_alv5_prio = (_dlg_alv5_all | selectattr('tier','in',('act','watch')) | list) + (_dlg_alv5_all | selectattr('tier','equalto','context') | selectattr('rule','equalto','event_risk') | list) + (_dlg_alv5_all | rejectattr('tier','defined') | list) %}
        {% set _dlg_alv5_ctx  = _dlg_alv5_all | selectattr('tier','equalto','context') | rejectattr('rule','equalto','event_risk') | list %}
        <div class="isle-head"><div class="isle-head-dot"></div><span class="isle-head-label"><span class="l-en">Priority</span><span class="l-zh">优先</span></span><div class="isle-head-line"></div></div>
        {% if _dlg_alv5_prio %}
        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px">
          {% for a in _dlg_alv5_prio %}
          {% set _asev2 = 'warn' if a.severity in ('warn','high','critical') else 'info' %}
          {% set _atier = a.tier if (a.tier is defined and a.tier) else 'watch' %}
          <div style="display:flex;gap:10px;padding:12px;background:{{ 'rgba(245,158,11,.06)' if _asev2=='warn' else 'rgba(255,255,255,.03)' }};border-radius:10px;border:1px solid {{ 'rgba(245,158,11,.18)' if _asev2=='warn' else 'rgba(255,255,255,.06)' }}">
            <div style="width:8px;height:8px;border-radius:50%;background:{{ 'var(--mx5-warn)' if _asev2=='warn' else 'var(--ink-3,rgba(255,255,255,.36))' }};flex-shrink:0;margin-top:5px"></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:4px">
                <div style="font-size:13px;font-weight:600;color:{{ 'var(--mx5-warn)' if _asev2=='warn' else 'var(--ink-1,rgba(255,255,255,.92))' }}">
                  {% if a.icon %}<span style="font-size:12px;margin-right:3px">{{ a.icon }}</span>{% endif %}
                  <span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh or a.plain_en }}</span>
                </div>
                {# Tier chip #}
                {% if a.rule is defined and a.rule == 'event_risk' %}
                <span style="font-size:10px;font-weight:700;padding:1px 6px;border-radius:4px;background:rgba(245,158,11,.12);color:var(--mx5-warn-ink,#9c6212);border:1px solid rgba(245,158,11,.22);white-space:nowrap"><span class="l-en">Event</span><span class="l-zh">事件</span></span>
                {% elif _atier == 'act' %}
                <span style="font-size:10px;font-weight:700;padding:1px 6px;border-radius:4px;background:rgba(239,68,68,.15);color:#ef4444;border:1px solid rgba(239,68,68,.25);white-space:nowrap"><span class="l-en">Act</span><span class="l-zh">行动</span></span>
                {% elif _atier == 'watch' %}
                <span style="font-size:10px;font-weight:700;padding:1px 6px;border-radius:4px;background:rgba(245,158,11,.12);color:var(--mx5-warn-ink,#9c6212);border:1px solid rgba(245,158,11,.22);white-space:nowrap"><span class="l-en">Watch</span><span class="l-zh">关注</span></span>
                {% endif %}
              </div>
              <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.5"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div style="font-size:12px;color:var(--ink-3,rgba(255,255,255,.4));margin-bottom:16px;padding:10px 0">
          <span class="l-en">No priority alerts firing right now.</span><span class="l-zh">当前无优先警报触发。</span>
        </div>
        {% endif %}
        {# Context tier — dimmer, distinct section #}
        {% if _dlg_alv5_ctx %}
        <div class="isle-head"><div class="isle-head-dot"></div><span class="isle-head-label"><span class="l-en">Context</span><span class="l-zh">背景</span></span><div class="isle-head-line"></div></div>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;opacity:.8">
          {% for a in _dlg_alv5_ctx %}
          <div style="display:flex;gap:10px;padding:10px 12px;background:rgba(255,255,255,.02);border-radius:8px;border:1px solid rgba(255,255,255,.05)">
            <div style="width:6px;height:6px;border-radius:50%;background:var(--ink-3,rgba(255,255,255,.30));flex-shrink:0;margin-top:5px"></div>
            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-bottom:3px">
                <div style="font-size:12.5px;font-weight:600;color:var(--ink-2,rgba(255,255,255,.7))">
                  {% if a.icon %}<span style="font-size:11px;margin-right:3px">{{ a.icon }}</span>{% endif %}
                  <span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh or a.plain_en }}</span>
                </div>
                <span style="font-size:10px;font-weight:600;padding:1px 5px;border-radius:4px;background:rgba(255,255,255,.06);color:var(--ink-3,rgba(255,255,255,.36));border:1px solid rgba(255,255,255,.09);white-space:nowrap"><span class="l-en">Context</span><span class="l-zh">背景</span></span>
              </div>
              <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.30));line-height:1.5"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% endif %}
        {# Headlines #}
        {% if macro_news and macro_news.headlines %}
        <div class="isle-head"><div class="isle-head-dot"></div><span class="isle-head-label"><span class="l-en">Market Intelligence</span><span class="l-zh">市场情报</span></span><div class="isle-head-line"></div></div>
        {% set _dlg_TL_nb = {'monetary':['Fed','美联储'],'inflation':['Inflation','通胀'],'labor':['Labor','就业'],'growth':['Growth','增长'],'credit':['Rates','利率'],'fiscal':['Fiscal','财政'],'earnings':['Earnings','业绩'],'guidance':['Guidance','指引'],'analyst':['Analysts','分析师'],'deals':['Deals','并购/IPO'],'capital_return':['Buybacks','回购/分红'],'stocks':['Stocks','个股'],'macro':['Macro','宏观']} %}
        <div class="nb-acc" style="margin-top:12px">
          {% for h in macro_news.headlines[:10] %}
          {% set _dlg_tl = _dlg_TL_nb.get(h.theme, [h.theme, h.theme]) %}
          <details class="nb-item"{% if loop.first %} open{% endif %}>
            <summary class="nb-sum">
              <span class="nb-theme">{{ t(_dlg_tl[0], _dlg_tl[1]) }}</span>
              <span class="nb-htitle"><span class="l-en">{{ h.title }}</span><span class="l-zh">{{ h.title_zh or h.title }}</span></span>
            </summary>
            <div class="nb-body">
              <a class="nb-read" href="{{ h.url }}" target="_blank" rel="noopener">{{ t('Read source','阅读原文') }} →</a>
            </div>
          </details>
          {% endfor %}
        </div>
        {% endif %}
        <div style="margin-top:16px;text-align:center">
          <a href="news.html" style="color:var(--link);font-weight:700;font-size:13px">{{ t('Open the full news feed →','打开完整新闻流 →') }}</a>
        </div>
      </div>
    </div>
  </div>

  {# dlg-deep-context: Deep context link-out chips #}
  <div class="mx5-dlg" id="dlg-deep-context" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel mx5-dlg-panel-narrow">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Deep Context — Linked Surfaces</span><span class="l-zh">深度背景 — 关联页面</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        <div class="isle-linkouts">
          <a class="isle-lout" href="macro_context.html"><span class="l-en">Macro Context</span><span class="l-zh">宏观背景</span></a>
          <a class="isle-lout" href="aibrief.html"><span class="l-en">AI Daily Brief</span><span class="l-zh">AI日报</span></a>
          <a class="isle-lout" href="sector_central.html"><span class="l-en">Sector Central</span><span class="l-zh">行业中枢</span></a>
          <a class="isle-lout" href="news.html"><span class="l-en">News Feed</span><span class="l-zh">新闻流</span></a>
          <a class="isle-lout" href="committee.html"><span class="l-en">Neural Web</span><span class="l-zh">神经网络</span></a>
          <a class="isle-lout" href="macro_signals.html"><span class="l-en">Signal Lab</span><span class="l-zh">信号实验室</span></a>
          <a class="isle-lout" href="china_intel.html"><span class="l-en">China Intel</span><span class="l-zh">中国情报</span></a>
          <a class="isle-lout" href="subsector_rotation.html"><span class="l-en">Oracle Rotation</span><span class="l-zh">轮动分析</span></a>
        </div>
      </div>
    </div>
  </div>
  {# dlg-fed: Fed Probability detail — outcome distribution + upcoming meetings #}
  <div class="mx5-dlg" id="dlg-fed" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Fed Path — Forward Board</span><span class="l-zh">联储路径 — 前瞻看板</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
      {# ── Reuse _rc aliases already computed for the card ── #}
      {% set _dlgrc = rates_command if (rates_command is defined and rates_command) else none %}
      {% if _dlgrc %}
      {% set _dlgrc_ep   = _dlgrc.expectations_pressure %}
      {% set _dlgrc_brd  = _dlgrc.board %}
      {% set _dlgrc_rpr  = _dlgrc_brd.rate_path_row %}
      {% set _dlgrc_inf  = _dlgrc_brd.inflation_row %}
      {% set _dlgrc_risk = _dlgrc_brd.risk_row %}
      {% set _dlgrc_pol  = _dlgrc_brd.policy_row %}
      {% set _dlgrc_mc   = _dlgrc.market_check %}
      {% set _dlgrc_pl_map_en = {'QUIET':'No active policy pressure.','ELEVATED':'Elevated — watch for repricing.','ARMED':'Active — repricing underway.'} %}
      {% set _dlgrc_pl_map_zh = {'QUIET':'当前无积极政策压力。','ELEVATED':'警戒 — 留意重定价风险。','ARMED':'已触发 — 重定价进行中。'} %}

      {# ── a. Hero ── #}
      <div style="margin-bottom:16px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:13px;font-weight:700;padding:3px 8px;border-radius:4px;background:rgba(255,255,255,.07)">
            <span class="l-en">{{ _dlgrc_ep.state_label.en }}</span>
            <span class="l-zh">{{ _dlgrc_ep.state_label.zh }}</span>
          </span>
          <span style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))">{{ _dlgrc.asof }}</span>
        </div>
        <div style="font-size:13px;color:var(--ink-2,rgba(255,255,255,.7));line-height:1.6">
          <span class="l-en">{{ _dlgrc.stance.en }}</span>
          <span class="l-zh">{{ _dlgrc.stance.zh }}</span>
        </div>
      </div>
      <div class="mx5-dlg-sep"></div>

      {# ── b. Pressure beam — hawkish weight vs easing weight, the beam tilts ── #}
      {# Plain 1-2 word chip label per leg (mechanic + threshold receipt stays on hover). #}
      {% set _fbm_leg_lbl = {
        'H1_path_repricing':      {'en':'Rate futures','zh':'利率期货'},
        'H2_breakeven_momentum':  {'en':'Breakevens','zh':'盈亏平衡'},
        'H3_oil_impulse':         {'en':'Oil','zh':'原油'},
        'H4_inflation_trajectory':{'en':'Inflation path','zh':'通胀路径'},
        'H5_curve_regime':        {'en':'Yield curve','zh':'收益率曲线'},
        'H6_anchoring_strain':    {'en':'Expectations','zh':'通胀预期'},
        'E1_equity_deleveraging': {'en':'Equity risk-off','zh':'股市避险'},
        'E2_growth_cooling':      {'en':'Growth cooling','zh':'增长放缓'},
        'E3_dollar_tightening':   {'en':'Strong dollar','zh':'美元走强'},
        'E4_credit_stress':       {'en':'Credit stress','zh':'信用压力'},
        'E5_policy_easing_chain': {'en':'Easing chain','zh':'宽松传导'}
      } %}
      {% set _fbm_hawk = _dlgrc_ep.hawk_score %}
      {% set _fbm_ease = _dlgrc_ep.ease_score %}
      {# Beam tilt: net weight (hawk − ease) mapped to a bounded angle. Hawk-heavy tilts
         DOWN-LEFT (positive rotate); easing tilts up-left / down-right (negative). Clamp ±9°. #}
      {% set _fbm_net = _fbm_hawk - _fbm_ease %}
      {% set _fbm_tilt_raw = (_fbm_net * 3) %}
      {% set _fbm_tilt = ([[_fbm_tilt_raw, 9] | min, -9] | max) %}
      {% set _fbm_lean_word_en = 'balanced' if _fbm_net == 0 else ('leaning hawkish' if _fbm_net > 0 else 'leaning easier') %}
      {% set _fbm_lean_word_zh = '大体制衡' if _fbm_net == 0 else ('偏鹰' if _fbm_net > 0 else '偏宽松') %}
      {% set _fbm_lean_cls = 'even' if _fbm_net == 0 else ('hawk' if _fbm_net > 0 else 'ease') %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Pressure Balance</span><span class="l-zh">压力平衡</span></div>
      <div class="fbm-beam-wrap">
        <div class="fbm-beam-heads">
          <span class="fbm-beam-head hawk"><span class="fbm-wt">{{ _fbm_hawk }}</span><span class="l-en">Hawkish</span><span class="l-zh">鹰派</span></span>
          <span class="fbm-beam-head ease"><span class="l-en">Easing</span><span class="l-zh">宽松</span><span class="fbm-wt">{{ _fbm_ease }}</span></span>
        </div>
        <div class="fbm-beam-stage" style="--tilt:{{ _fbm_tilt }}deg">
          <div class="fbm-beam-bar"></div>
          <div class="fbm-fulcrum"></div>
          <div class="fbm-beam-pans">
            <div class="fbm-beam-pan hawk">
              <div class="fbm-beam-chips">
                {% for leg in _dlgrc_ep.legs %}{% if leg.key[:1] == 'H' %}
                {% set _ll = _fbm_leg_lbl.get(leg.key, {'en':leg.key,'zh':leg.key}) %}
                <span class="fbm-leg hawk {{ 'on' if leg.active else '' }}"
                      data-tip-en="{{ leg.detail_en }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}"
                      data-tip-zh="{{ leg.detail_zh }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}">
                  <span class="fbm-dot"></span><span class="l-en">{{ _ll.en }}</span><span class="l-zh">{{ _ll.zh }}</span>
                </span>
                {% endif %}{% endfor %}
              </div>
            </div>
            <div class="fbm-beam-pan ease">
              <div class="fbm-beam-chips">
                {% for leg in _dlgrc_ep.legs %}{% if leg.key[:1] == 'E' %}
                {% set _ll = _fbm_leg_lbl.get(leg.key, {'en':leg.key,'zh':leg.key}) %}
                <span class="fbm-leg ease {{ 'on' if leg.active else '' }}"
                      data-tip-en="{{ leg.detail_en }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}"
                      data-tip-zh="{{ leg.detail_zh }}{% if leg.null_reason %} — {{ leg.null_reason }}{% endif %}">
                  <span class="fbm-dot"></span><span class="l-en">{{ _ll.en }}</span><span class="l-zh">{{ _ll.zh }}</span>
                </span>
                {% endif %}{% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="fbm-beam-verdict">
          <span class="l-en">Forces {{ _fbm_hawk }} vs {{ _fbm_ease }} — <span class="fbm-lean {{ _fbm_lean_cls }}">{{ _fbm_lean_word_en }}</span>. Filled chips are live now; hover any for its trigger.</span>
          <span class="l-zh">力量对比 {{ _fbm_hawk }} 对 {{ _fbm_ease }} — <span class="fbm-lean {{ _fbm_lean_cls }}">{{ _fbm_lean_word_zh }}</span>。实心因素为当前生效；悬停查看触发条件。</span>
        </div>
      </div>
      <div class="mx5-dlg-sep"></div>

      {# ── c. Rate Path — flagship chart (ports dlg-policy's plx idiom, full-width 640×230) ── #}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Rate Path — Market vs the Fed</span><span class="l-zh">利率路径 — 市场对比美联储</span></div>
      {% set _dlg_rpr = _dlgrc_rpr %}
      {% if _dlg_rpr %}
      {% set _fbc_impl = [_dlg_rpr.policy_rate, _dlg_rpr.implied_path.m1, _dlg_rpr.implied_path.m3, _dlg_rpr.implied_path.m6, _dlg_rpr.implied_path.m12] %}
      {% set _fbc_ok = (_fbc_impl[0] is not none and _fbc_impl[1] is not none and _fbc_impl[2] is not none and _fbc_impl[3] is not none and _fbc_impl[4] is not none) %}
      {% if _fbc_ok %}
      {# ── scale over implied ∪ Fed-dot medians, pad 0.15pp each side (same as plx) ── #}
      {% set _fbc_dots = (_dlg_rpr.dots if (_dlg_rpr.dots is defined and _dlg_rpr.dots) else []) %}
      {% set _fbc_allvals = _fbc_impl[:] %}
      {% for d in _fbc_dots %}{% if d.median is not none and _fbc_allvals.append(d.median) %}{% endif %}{% endfor %}
      {% set _fbc_ymin = (_fbc_allvals | min) - 0.15 %}
      {% set _fbc_ymax = (_fbc_allvals | max) + 0.15 %}
      {% set _fbc_yrange = (_fbc_ymax - _fbc_ymin) if (_fbc_ymax - _fbc_ymin) > 0.01 else 0.5 %}
      {# geometry: viewBox 0 0 640 230; x 54..586, y 30..176 (labels below) #}
      {% set _fbc_xl = 54 %}{% set _fbc_xr = 586 %}{% set _fbc_yt = 30 %}{% set _fbc_yb = 176 %}
      {% set _fbc_w = 532 %}{% set _fbc_h = 146 %}
      {% set _fbc_xs = [_fbc_xl, _fbc_xl + ((_fbc_w*0.25)|round(1)|float), _fbc_xl + ((_fbc_w*0.5)|round(1)|float), _fbc_xl + ((_fbc_w*0.75)|round(1)|float), _fbc_xr] %}
      {% macro fry(v) %}{{ (_fbc_yb - _fbc_h * (v - _fbc_ymin) / _fbc_yrange) | round(1) }}{% endmacro %}
      {% set _fbc_pts = [] %}
      {% for i in range(5) %}{% if _fbc_pts.append(_fbc_xs[i]|string ~ ',' ~ fry(_fbc_impl[i])) %}{% endif %}{% endfor %}
      {% set _fbc_area = 'M' ~ _fbc_pts[0] ~ ' L' ~ _fbc_pts[1] ~ ' L' ~ _fbc_pts[2] ~ ' L' ~ _fbc_pts[3] ~ ' L' ~ _fbc_pts[4] ~ ' L' ~ _fbc_xr|string ~ ',' ~ _fbc_yb|string ~ ' L' ~ _fbc_xl|string ~ ',' ~ _fbc_yb|string ~ ' Z' %}
      {# current-year Fed dot → sits in the 12m slot (end-year); outer years become chips #}
      {% set _fbc_cur_year = (latest.date[:4]|int) if (latest is defined and latest.date is defined and latest.date) else none %}
      {% set _fbc_dots_inner = [] %}{% set _fbc_dots_outer = [] %}
      {% for d in _fbc_dots %}{% if d.year is defined and _fbc_cur_year is not none and d.year == _fbc_cur_year %}{% if _fbc_dots_inner.append(d) %}{% endif %}{% else %}{% if _fbc_dots_outer.append(d) %}{% endif %}{% endif %}{% endfor %}
      <div class="fbm-chart-wrap">
        <svg class="fbm-chart-svg" viewBox="0 0 640 230" role="img" aria-label="Market-implied fed funds path versus the Fed projection">
          <defs>
            <linearGradient id="fbmChartGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--isle-policy)" stop-opacity=".2"/>
              <stop offset="100%" stop-color="var(--isle-policy)" stop-opacity="0"/>
            </linearGradient>
          </defs>
          {# area fill under implied path #}
          <path class="fbm-chart-area" d="{{ _fbc_area }}" fill="url(#fbmChartGrad)"/>
          {# dashed hairline at today's rate #}
          <line x1="{{ _fbc_xl }}" y1="{{ fry(_fbc_impl[0]) }}" x2="{{ _fbc_xr }}" y2="{{ fry(_fbc_impl[0]) }}" stroke="rgba(255,255,255,.15)" stroke-width="1" stroke-dasharray="4,4"/>
          {# implied path line (draw-in via dashoffset; --dash ≈ path length upper bound) #}
          <polyline class="fbm-chart-line" style="--dash:900" points="{{ _fbc_pts | join(' ') }}" fill="none" stroke="var(--isle-policy)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
          {# nodes + % value labels (bilingual is numeric-only here → no lang split needed) #}
          {% for i in range(5) %}
          {% set _px = _fbc_xs[i] %}{% set _py = fry(_fbc_impl[i]) | float %}
          <circle class="fbm-chart-node" cx="{{ _px }}" cy="{{ _py }}" r="4.5" fill="var(--isle-policy)" stroke="rgba(13,17,24,.85)" stroke-width="1.5"/>
          <text class="fbm-chart-node" x="{{ _px }}" y="{{ _py - 10 }}" text-anchor="middle" font-size="11" font-weight="700" fill="var(--isle-policy)" font-family="Inter,-apple-system,sans-serif" font-variant-numeric="tabular-nums">{{ '%.2f'|format(_fbc_impl[i]) }}%</text>
          {% endfor %}
          {# Fed median diamond in the end-year slot #}
          {% for d in _fbc_dots_inner %}
          {% set _dpx = _fbc_xs[4] %}{% set _dpy = fry(d.median) | float %}
          <polygon class="fbm-chart-diamond" points="{{ _dpx }},{{ _dpy - 7 }} {{ _dpx + 7 }},{{ _dpy }} {{ _dpx }},{{ _dpy + 7 }} {{ _dpx - 7 }},{{ _dpy }}" fill="var(--warn,#f59e0b)" fill-opacity=".9" stroke="rgba(13,17,24,.7)" stroke-width="1"/>
          {% endfor %}
          {# x-axis labels — SEPARATE l-en / l-zh SVG text elements (svg-span-breakout law), NO M-codes #}
          {% set _fbc_xlabels_en = ['Now','1m','3m','6m','12m'] %}
          {% set _fbc_xlabels_zh = ['现在','1月','3月','6月','12月'] %}
          {% for i in range(5) %}
          <text class="l-en" x="{{ _fbc_xs[i] }}" y="204" text-anchor="middle" font-size="11" fill="rgba(255,255,255,.4)" font-family="Inter,-apple-system,sans-serif">{{ _fbc_xlabels_en[i] }}</text>
          <text class="l-zh" x="{{ _fbc_xs[i] }}" y="204" text-anchor="middle" font-size="11" fill="rgba(255,255,255,.4)" font-family="Inter,-apple-system,sans-serif">{{ _fbc_xlabels_zh[i] }}</text>
          {% endfor %}
        </svg>
        {# Fed-diamond key + outer-year dot chips #}
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:2px">
          {% if _fbc_dots_inner %}
          <span class="fbm-diamond-key">
            <svg width="11" height="11" viewBox="0 0 11 11"><polygon points="5.5,0 11,5.5 5.5,11 0,5.5" fill="var(--warn,#f59e0b)"/></svg>
            <span class="l-en">Fed median dot</span><span class="l-zh">美联储中位点</span>
          </span>
          {% endif %}
          {% for d in _fbc_dots_outer %}
          <span class="plx-dot-chip">
            <span class="l-en">'{{ (d.year|string)[2:] }} {{ '%.2f'|format(d.median) }}% (Fed)</span>
            <span class="l-zh">'{{ (d.year|string)[2:] }} {{ '%.2f'|format(d.median) }}%（美联储）</span>
          </span>
          {% endfor %}
        </div>
        {# ONE plain takeaway sentence #}
        <div class="fbm-chart-take">
          <span class="l-en">{{ _dlg_rpr.read_en if (_dlg_rpr.read_en is defined and _dlg_rpr.read_en) else (_dlg_rpr.headline_en if _dlg_rpr.headline_en is defined else 'Market-implied fed-funds path.') }}</span>
          <span class="l-zh">{{ _dlg_rpr.read_zh if (_dlg_rpr.read_zh is defined and _dlg_rpr.read_zh) else (_dlg_rpr.headline_zh if _dlg_rpr.headline_zh is defined else '市场隐含联邦基金利率路径。') }}</span>
        </div>
        {# delta callout chip — market vs Fed at the horizon #}
        {% if _dlg_rpr.gap is defined and _dlg_rpr.gap and _dlg_rpr.gap.gap_bp is not none and _dlg_rpr.gap.market is not none and _dlg_rpr.gap.fed_dot is not none %}
        {% set _fbc_gap = _dlg_rpr.gap %}
        <div style="margin-top:8px">
          <span class="fbm-gap-chip"
            data-tip-en="At {{ _fbc_gap.horizon_label }}: market prices {{ _fbc_gap.market }}%, the Fed projects {{ _fbc_gap.fed_dot }}%. Gap {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp — small means market and Fed agree on where rates land."
            data-tip-zh="{{ _fbc_gap.horizon_label }}：市场定价 {{ _fbc_gap.market }}%，美联储预测 {{ _fbc_gap.fed_dot }}%。差距 {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp — 差距小表示市场与美联储对终点利率看法一致。">
            <span class="l-en">{{ _fbc_gap.lean_en }} — {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp at {{ _fbc_gap.horizon_label }}</span>
            <span class="l-zh">{{ _fbc_gap.lean_zh }} — {{ _fbc_gap.horizon_label }} 相差 {{ '%+d'|format(_fbc_gap.gap_bp|int) }}bp</span>
          </span>
        </div>
        {% endif %}
      </div>
      {% endif %}{# /_fbc_ok #}
      {% endif %}{# /_dlg_rpr #}
      <div class="mx5-dlg-sep"></div>

      {# ── d. Inflation Read → glance row: state word + one plain line + ? receipt ── #}
      {# Guard: only render when core inflation values are present (fail-open path leaves them None). #}
      {% if _dlgrc_inf and _dlgrc_inf.core_pce_yoy is not none %}
      {% set _inf_vst = _dlgrc_inf.vs_target_pp %}
      {# Anchoring drives the state word + colour; the numbers are demoted to the ? tip. #}
      {% set _inf_anchor = _dlgrc_inf.anchoring %}
      {% set _inf_state_en = {'anchored':'Above target','drifting':'Drifting up','unanchored':'Unanchored'}.get(_inf_anchor, 'Above target') %}
      {% set _inf_state_zh = {'anchored':'高于目标','drifting':'向上漂移','unanchored':'脱锚'}.get(_inf_anchor, '高于目标') %}
      {% set _inf_col = 'var(--down,#ef4444)' if _inf_anchor == 'unanchored' else ('var(--warn,#f59e0b)' if (_inf_vst is not none and _inf_vst > 0.5) else 'var(--up,#22d97a)') %}
      {# Plain "how far above target" phrase #}
      {% set _inf_above_en = ((('%.1f'|format(_inf_vst)) ~ ' points above the Fed’s 2% target') if (_inf_vst is not none) else 'above the Fed’s 2% target') %}
      {% set _inf_above_zh = ((('高于美联储2%目标 ' ~ ('%.1f'|format(_inf_vst)) ~ ' 个百分点')) if (_inf_vst is not none) else '高于美联储2%目标') %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Inflation Read</span><span class="l-zh">通胀读数</span></div>
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _inf_col }}"><span class="fbm-row-dot" style="background:{{ _inf_col }}"></span><span class="l-en">{{ _inf_state_en }}</span><span class="l-zh">{{ _inf_state_zh }}</span></span>
        <span class="fbm-row-line"><span class="l-en">Core prices are still {{ _inf_above_en }}; longer-run expectations look {{ {'anchored':'steady','drifting':'a touch loose','unanchored':'unmoored'}.get(_inf_anchor,'steady') }}.</span><span class="l-zh">核心物价仍{{ _inf_above_zh }}；长期预期看起来{{ {'anchored':'稳定','drifting':'略松动','unanchored':'不稳'}.get(_inf_anchor,'稳定') }}。</span></span>
        <span class="fbm-tip"
          data-tip-en="Core PCE {{ _dlgrc_inf.core_pce_yoy }}% y/y · Core CPI {{ _dlgrc_inf.core_cpi_yoy }}% · 3-month annualized PCE {{ _dlgrc_inf.core_pce_3m_ann }}% · 10y breakeven {{ _dlgrc_inf.breakeven_10y }}% (expectations: {{ _inf_anchor }})."
          data-tip-zh="核心PCE {{ _dlgrc_inf.core_pce_yoy }}% 同比 · 核心CPI {{ _dlgrc_inf.core_cpi_yoy }}% · 3月年化PCE {{ _dlgrc_inf.core_pce_3m_ann }}% · 10年盈亏平衡 {{ _dlgrc_inf.breakeven_10y }}%（预期：{{ {'anchored':'稳定','drifting':'漂移','unanchored':'脱锚'}.get(_inf_anchor,_inf_anchor) }}）。">?</span>
      </div>
      {% if _dlgrc_inf.nearest_cpi is defined and _dlgrc_inf.nearest_cpi %}
      {% set _ncpi = _dlgrc_inf.nearest_cpi %}
      {% set _ncpi_sig = _ncpi.surprise_skew_sigma %}
      {% set _ncpi_col = 'var(--down,#ef4444)' if _ncpi.surprise_skew_tag == 'hotter' else ('var(--up,#22d97a)' if _ncpi.surprise_skew_tag == 'cooler' else 'var(--warn,#f59e0b)') %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _ncpi_col }}"><span class="fbm-row-dot" style="background:{{ _ncpi_col }}"></span><span class="l-en">Next CPI · {{ _ncpi.days_to }}d</span><span class="l-zh">下次CPI · {{ _ncpi.days_to }}天</span></span>
        <span class="fbm-row-line"><span class="l-en">Recent data leans {{ {'hotter':'hotter than forecast','cooler':'cooler than forecast','neutral':'in line'}.get(_ncpi.surprise_skew_tag,'in line') }} — a print either way can reset the read.</span><span class="l-zh">近期数据{{ {'hotter':'偏热于预期','cooler':'偏冷于预期','neutral':'大致符合'}.get(_ncpi.surprise_skew_tag,'大致符合') }} — 任一方向的数据都可能重置解读。</span></span>
        <span class="fbm-tip"
          data-tip-en="Release {{ _ncpi.release_date }} ({{ _ncpi.days_to }} days out). Surprise skew: {{ _ncpi.surprise_skew_tag }}{% if _ncpi_sig is not none %}, {{ '%.2f'|format(_ncpi_sig) }}σ{% endif %}."
          data-tip-zh="发布 {{ _ncpi.release_date }}（{{ _ncpi.days_to }} 天后）。惊喜偏向：{{ {'hotter':'偏热','cooler':'偏冷','neutral':'中性'}.get(_ncpi.surprise_skew_tag,_ncpi.surprise_skew_tag) }}{% if _ncpi_sig is not none %}，{{ '%.2f'|format(_ncpi_sig) }}σ{% endif %}。">?</span>
      </div>
      {% endif %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── e. Risk Indicators → glance rows; percentiles, model names, FRED IDs demoted to ? tips ── #}
      {# Guard: real_speed_pctile / term_premium_chg_bp are None on the fail-open (no yield_curve) path. #}
      {% if _dlgrc_risk and (_dlgrc_risk.real_speed_pctile is not none or _dlgrc_risk.curve_regime_label_en) %}
      {% set _rsp = _dlgrc_risk.real_speed_pctile %}
      {% set _tpc = _dlgrc_risk.term_premium_chg_bp %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Risk Indicators</span><span class="l-zh">风险指标</span></div>
      {% if _rsp is not none %}
      {# fast/moderate/slow band from percentile → plain word #}
      {% set _rsp_pct = (_rsp * 100) | round | int %}
      {% set _rsp_fast = _rsp_pct >= 67 %}
      {% set _rsp_col = 'var(--down,#ef4444)' if _rsp_fast else ('var(--warn,#f59e0b)' if _rsp_pct >= 34 else 'var(--up,#22d97a)') %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _rsp_col }}"><span class="fbm-row-dot" style="background:{{ _rsp_col }}"></span><span class="l-en">{{ 'Moving fast' if _rsp_fast else ('Moderate' if _rsp_pct >= 34 else 'Calm') }}</span><span class="l-zh">{{ '快速变动' if _rsp_fast else ('中等' if _rsp_pct >= 34 else '平稳') }}</span></span>
        <span class="fbm-row-line"><span class="l-en">Real rates are moving {{ 'faster than most of the past decade' if _rsp_fast else ('at a middling pace' if _rsp_pct >= 34 else 'slowly') }} — a heads-up on volatility, not a direction call.</span><span class="l-zh">实际利率变动{{ '快于过去十年多数时段' if _rsp_fast else ('速度中等' if _rsp_pct >= 34 else '缓慢') }} — 提示波动，非方向判断。</span></span>
        <span class="fbm-tip"
          data-tip-en="Real-rate speed sits in the {{ _rsp_pct }}th percentile of the past decade. {{ _dlgrc_risk.real_speed_note_en }}"
          data-tip-zh="实际利率波速处于过去十年第 {{ _rsp_pct }} 百分位。{{ _dlgrc_risk.real_speed_note_zh }}">?</span>
      </div>
      {% endif %}
      {% if _dlgrc_risk.curve_regime_label_en %}
      {% set _crv_col = 'var(--down,#ef4444)' if (_dlgrc_risk.term_premium_dir == 'rising') else 'var(--warn,#f59e0b)' %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _crv_col }}"><span class="fbm-row-dot" style="background:{{ _crv_col }}"></span><span class="l-en">{{ _dlgrc_risk.curve_regime_label_en }}</span><span class="l-zh">{{ _dlgrc_risk.curve_regime_label_zh }}</span></span>
        <span class="fbm-row-line"><span class="l-en">Long-end yields are {{ 'rising faster than the front' if _dlgrc_risk.term_premium_dir == 'rising' else ('falling' if _dlgrc_risk.term_premium_dir == 'falling' else 'holding') }} — driven by fiscal and risk-premium, not a growth call.</span><span class="l-zh">长端收益率{{ '上升快于短端' if _dlgrc_risk.term_premium_dir == 'rising' else ('下降' if _dlgrc_risk.term_premium_dir == 'falling' else '持稳') }} — 由财政与风险溢价驱动，非增长判断。</span></span>
        <span class="fbm-tip"
          data-tip-en="Curve shape: {{ _dlgrc_risk.curve_regime_label_en }}. Term premium {{ _dlgrc_risk.term_premium_dir }}{% if _tpc is not none %} ({{ '%+.0f'|format(_tpc) }}bp){% endif %}. {{ _dlgrc_risk.term_premium_note_en }}."
          data-tip-zh="曲线形态：{{ _dlgrc_risk.curve_regime_label_zh }}。期限溢价{{ {'rising':'上升','falling':'下降','flat':'平稳'}.get(_dlgrc_risk.term_premium_dir,_dlgrc_risk.term_premium_dir) }}{% if _tpc is not none %}（{{ '%+.0f'|format(_tpc) }}bp）{% endif %}。{{ _dlgrc_risk.term_premium_note_zh }}。">?</span>
      </div>
      {% endif %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── f. Policy Conditions → chip row (state · chair · comment cadence) ── #}
      {% if _dlgrc_pol %}
      {% set _dlg_pl_st = _dlgrc_pol.state %}
      {% set _pl_st_word_en = {'QUIET':'Quiet','ELEVATED':'Watch','ARMED':'Active'}.get(_dlg_pl_st, 'Watch') %}
      {% set _pl_st_word_zh = {'QUIET':'平静','ELEVATED':'警戒','ARMED':'已触发'}.get(_dlg_pl_st, '警戒') %}
      {% set _pl_st_cls = 'armed' if _dlg_pl_st in ('ARMED','ELEVATED') else '' %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">Policy Conditions</span><span class="l-zh">政策条件</span></div>
      <div class="fbm-chips">
        <span class="fbm-chip {{ _pl_st_cls }}"
          data-tip-en="{{ _dlgrc_pl_map_en.get(_dlg_pl_st, 'Watch for changes.') }}"
          data-tip-zh="{{ _dlgrc_pl_map_zh.get(_dlg_pl_st, '留意变化。') }}">
          <span class="fbm-chip-k"><span class="l-en">Stance</span><span class="l-zh">立场</span></span>
          <span class="l-en">{{ _pl_st_word_en }}</span><span class="l-zh">{{ _pl_st_word_zh }}</span>
        </span>
        {% if _dlgrc_pol.chair is defined %}
        <span class="fbm-chip">
          <span class="fbm-chip-k"><span class="l-en">Chair</span><span class="l-zh">主席</span></span>
          <span>{{ _dlgrc_pol.chair }}</span>
        </span>
        {% endif %}
        {% if _dlgrc_pol.jawboning is defined and _dlgrc_pol.jawboning %}
        <span class="fbm-chip"
          data-tip-en="Fed officials made {{ _dlgrc_pol.jawboning.n_7d }} public comments in the last 7 days, {{ _dlgrc_pol.jawboning.n_30d }} in the last 30 — more talk often precedes a shift in guidance."
          data-tip-zh="美联储官员近7天公开发言 {{ _dlgrc_pol.jawboning.n_7d }} 次，近30天 {{ _dlgrc_pol.jawboning.n_30d }} 次 — 发声增多往往先于指引调整。">
          <span class="fbm-chip-k"><span class="l-en">Comments</span><span class="l-zh">发声</span></span>
          <span><span class="l-en">{{ _dlgrc_pol.jawboning.n_7d }} this week</span><span class="l-zh">本周 {{ _dlgrc_pol.jawboning.n_7d }} 次</span></span>
        </span>
        {% endif %}
        {% if _dlgrc_pol.intel_staleness_days is defined %}
        <span class="fbm-chip"
          data-tip-en="Policy intel is {{ _dlgrc_pol.intel_staleness_days }} days old (as of {{ _dlgrc_pol.intel_as_of if _dlgrc_pol.intel_as_of is defined else 'unknown' }})."
          data-tip-zh="政策情报为 {{ _dlgrc_pol.intel_staleness_days }} 天前（截至 {{ _dlgrc_pol.intel_as_of if _dlgrc_pol.intel_as_of is defined else '未知' }}）。">
          <span class="fbm-chip-k"><span class="l-en">Intel</span><span class="l-zh">情报</span></span>
          <span><span class="l-en">{{ _dlgrc_pol.intel_staleness_days }}d old</span><span class="l-zh">{{ _dlgrc_pol.intel_staleness_days }}天前</span></span>
        </span>
        {% endif %}
      </div>
      {# Iran/oil: unsigned qualitative display (PS-R4) — kept as one chip, full note on hover #}
      {% if _dlgrc_pol.iran_context is defined and _dlgrc_pol.iran_context %}
      {% set _iran = _dlgrc_pol.iran_context %}
      <div class="fbm-chips">
        <span class="fbm-chip warn"
          data-tip-en="{{ _iran.as_of_note_en if _iran.as_of_note_en is defined else '' }} — Conditions only, no direction or probability assigned."
          data-tip-zh="{{ _iran.as_of_note_zh if _iran.as_of_note_zh is defined else '' }} — 条件性观察，不赋予方向或概率。">
          <span class="fbm-chip-k"><span class="l-en">Geopolitics</span><span class="l-zh">地缘</span></span>
          <span><span class="l-en">{{ _iran.title_en }}</span><span class="l-zh">{{ _iran.title_zh }}</span></span>
        </span>
      </div>
      {% endif %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── g. What Changes This → direction-tinted glance rows; raw trigger receipt on hover ── #}
      {% if _dlgrc.conditions %}
      {# Plain direction word carries the meaning on Tier 1; the machine detail (sigma / raw
         slugs) lives in the ? tip so the glance line stays doctrine-clean. #}
      {% set _cond_word_en = {'hawkish':'Pushes rates up','easing':'Pulls rates down','geopolitical':'Wild card'} %}
      {% set _cond_word_zh = {'hawkish':'推高利率','easing':'拉低利率','geopolitical':'不确定因素'} %}
      <div class="mx5-dlg-eyebrow"><span class="l-en">What Changes This</span><span class="l-zh">什么会改变现状</span></div>
      {% for cond in _dlgrc.conditions %}
      {% set _cond_col = 'var(--down,#ef4444)' if cond.direction == 'hawkish' else ('var(--up,#22d97a)' if cond.direction == 'easing' else 'var(--warn,#f59e0b)') %}
      <div class="fbm-row">
        <span class="fbm-row-state" style="color:{{ _cond_col }}"><span class="fbm-row-dot" style="background:{{ _cond_col }}"></span><span class="l-en">{{ _cond_word_en.get(cond.direction,'Watch') }}</span><span class="l-zh">{{ _cond_word_zh.get(cond.direction,'留意') }}</span></span>
        <span class="fbm-row-line">
          {% if cond.watch_en is defined and cond.watch_en %}
          <span class="l-en">{{ cond.watch_en }}</span><span class="l-zh">{{ cond.watch_zh if (cond.watch_zh is defined and cond.watch_zh) else cond.watch_en }}</span>
          {% else %}
          <span class="l-en">{{ cond.en }}</span><span class="l-zh">{{ cond.zh }}</span>
          {% endif %}
        </span>
        <span class="fbm-tip"
          data-tip-en="{{ cond.en }}"
          data-tip-zh="{{ cond.zh }}">?</span>
      </div>
      {% endfor %}
      <div class="mx5-dlg-sep"></div>
      {% endif %}

      {# ── h. Market-implied benchmark strip → unified fbm_bench_strip component ── #}
      {% set _dlg_fed_out_zh = {'No change':'按兵不动','Rate cut':'降息','Rate hike':'加息','25bps cut':'降息25bp','50bps cut':'降息50bp','25bps hike':'加息25bp','25 bps increase':'加息25bp','25 bps decrease':'降息25bp','50+ bps increase':'加息50bp以上','50+ bps decrease':'降息50bp以上'} %}
      {% if _dlgrc_mc and _dlgrc_mc.prediction_markets is defined and _dlgrc_mc.prediction_markets.events %}
      {% set _dlg_pm = _dlgrc_mc.prediction_markets %}
      {% set _fbm_bench_rows = [] %}
      {% for e in _dlg_pm.events %}
      {% if _fbm_bench_rows.append({'outcome_en': e.top_outcome, 'outcome_zh': _dlg_fed_out_zh.get(e.top_outcome, e.top_outcome), 'label_en': e.label_en, 'label_zh': e.label_zh, 'prob': e.top_prob, 'chg_pp': (e.chg_pp if e.chg_pp is defined else none)}) %}{% endif %}
      {% endfor %}
      {{ fbm_bench_strip(_fbm_bench_rows, (_dlg_pm.source if _dlg_pm.source is defined else 'Polymarket'), (_dlg_pm.as_of if _dlg_pm.as_of is defined else _dlgrc.asof)) }}
      {% if _dlgrc_mc.benchmark_note_en is defined %}
      <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));margin-top:6px;font-style:italic">
        <span class="l-en">{{ _dlgrc_mc.benchmark_note_en }}</span>
        <span class="l-zh">{{ _dlgrc_mc.benchmark_note_zh if _dlgrc_mc.benchmark_note_zh is defined else '' }}</span>
      </div>
      {% endif %}
      {% elif prediction_markets and prediction_markets.events %}
      {# Fallback: legacy prediction_markets module if rates_command.market_check.prediction_markets absent #}
      {% set _fbm_bench_rows = [] %}
      {% for e in prediction_markets.events[:4] %}
      {% set _top = (e.outcomes | sort(attribute='prob', reverse=true)) | first %}
      {% if _fbm_bench_rows.append({'outcome_en': _top.outcome, 'outcome_zh': _dlg_fed_out_zh.get(_top.outcome, _top.outcome), 'label_en': (e.label_en if e.label_en is defined else e.name), 'label_zh': (e.label_zh if e.label_zh is defined else (e.label_en if e.label_en is defined else e.name)), 'prob': _top.prob, 'chg_pp': (_top.chg_pp if _top.chg_pp is defined else none)}) %}{% endif %}
      {% endfor %}
      {{ fbm_bench_strip(_fbm_bench_rows, (prediction_markets.source if prediction_markets.source is defined else 'Polymarket'), none) }}
      {% endif %}

      {# ── i. Divergence flags ── #}
      {% if _dlgrc.divergence %}
      {% set _active_divs = _dlgrc.divergence | selectattr('active') | list %}
      {% if _active_divs %}
      <div class="mx5-dlg-sep"></div>
      <div class="mx5-dlg-eyebrow"><span class="l-en">Divergence Flags</span><span class="l-zh">背离信号</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px">
        {% for d in _active_divs %}
        <span style="font-size:11px;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);border-radius:4px;padding:3px 7px;color:var(--down,#ef4444)">
          <span class="l-en">{{ d.detail_en }}</span>
          <span class="l-zh">{{ d.detail_zh }}</span>
        </span>
        {% endfor %}
      </div>
      {% endif %}
      {% endif %}

      {# ── j. Single footer receipt — plain line on Tier 1, raw caveats on hover ── #}
      {% if _dlgrc.caveats %}
      {# Join the raw provenance/staleness caveats into ONE hover payload (Law 4: one footnote;
         Law 2: raw slugs like shock_state.json / policy/intel.json stay off Tier 1). #}
      {% set _fbm_cav_tip = _dlgrc.caveats | join(' · ') %}
      <div class="mx5-dlg-sep"></div>
      <div style="font-size:10.5px;color:var(--ink-3,rgba(255,255,255,.4));line-height:1.6;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
        <span class="l-en">As of {{ _dlgrc.asof }} — a read on conditions, not a forecast. Some inputs are display-only or a few days stale.</span>
        <span class="l-zh">截至 {{ _dlgrc.asof }} — 对条件的解读，非预测。部分输入仅供展示或略有滞后。</span>
        <span class="fbm-tip" data-tip-en="Data notes: {{ _fbm_cav_tip }}" data-tip-zh="数据说明：{{ _fbm_cav_tip }}" style="width:14px;height:14px;font-size:9px">?</span>
      </div>
      {% endif %}

      {% else %}
      {# rates_command absent — fall back to legacy Polymarket view #}
      {% if prediction_markets and prediction_markets.events %}
      {% for _fed_ev in prediction_markets.events %}
      {% set _fed_top = _fed_ev.outcomes | sort(attribute='prob',reverse=true) | first %}
      {# _fed_out_zh outcome→ZH map defined in dlg-events above #}
      <div style="margin-bottom:24px">
        <div class="mx5-dlg-eyebrow"><span class="l-en">{{ _fed_ev.label_en }}</span><span class="l-zh">{{ _fed_ev.label_zh }}</span></div>
        <div class="mx5-dlg-sep"></div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
          <div style="font-size:28px;font-weight:800;font-variant-numeric:tabular-nums;color:var(--mx5-accent,#22d97a);line-height:1">{{ _fed_top.prob | int }}<span style="font-size:14px;font-weight:500;color:var(--ink-2,rgba(255,255,255,.6))">%</span></div>
          <div>
            <div style="font-size:14px;font-weight:700"><span class="l-en">{{ _fed_top.outcome }}</span><span class="l-zh">{{ _fed_out_zh.get(_fed_top.outcome, _fed_top.outcome) if _fed_out_zh is defined else _fed_top.outcome }}</span></div>
            <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36))"><span class="l-en">market's top-probability outcome &middot; {{ _fed_ev.title }}</span><span class="l-zh">市场最高概率结果 &middot; {{ _fed_ev.title }}</span></div>
          </div>
        </div>
        {% set _fed_sorted_outs = _fed_ev.outcomes | sort(attribute='prob',reverse=true) %}
        {% for oc in _fed_sorted_outs %}
        {% set _ocp = oc.prob | float %}
        {% set _is_top2 = (oc.outcome == _fed_top.outcome) %}
        <div style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;margin-bottom:3px">
            <span style="font-size:12px;font-weight:{{ '700' if _is_top2 else '400' }};color:{{ 'var(--mx5-accent,#22d97a)' if _is_top2 else 'var(--ink-2,rgba(255,255,255,.6))' }}">
              <span class="l-en">{{ oc.outcome }}</span><span class="l-zh">{{ _fed_out_zh.get(oc.outcome, oc.outcome) if _fed_out_zh is defined else oc.outcome }}</span>
            </span>
            <span style="font-size:12px;font-variant-numeric:tabular-nums;font-weight:600;color:{{ 'var(--mx5-accent)' if _is_top2 else 'var(--ink-2,rgba(255,255,255,.6))' }}">{{ _ocp | int }}%</span>
          </div>
          <div style="height:5px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden">
            <div style="height:100%;width:{{ _ocp }}%;background:{{ 'var(--mx5-accent,#22d97a)' if _is_top2 else 'rgba(255,255,255,.22)' }};border-radius:3px;transition:width .4s"></div>
          </div>
        </div>
        {% endfor %}
        {% if prediction_markets.source is defined %}
        <div style="font-size:10px;color:var(--ink-3,rgba(255,255,255,.3));text-align:right;margin-top:4px"><span class="l-en">Source: {{ prediction_markets.source }}</span><span class="l-zh">来源: {{ prediction_markets.source }}</span></div>
        {% endif %}
      </div>
      {% endfor %}
      {% else %}
      <div style="text-align:center;padding:40px 0;color:var(--ink-3,rgba(255,255,255,.36));font-size:13px">
        <span class="l-en">Fed path data is accruing — check back after the next nightly update.</span>
        <span class="l-zh">联储路径数据积累中 — 请在下次每晚更新后查看。</span>
      </div>
      {% endif %}
      {% endif %}
      </div>
    </div>
  </div>

  {# dlg-sentiment: Market Sentiment legs breakdown + dial #}
  <div class="mx5-dlg" id="dlg-sentiment" role="dialog" aria-modal="true" tabindex="-1">
    <div class="mx5-dlg-backdrop" onclick="mx5CloseDlg()"></div>
    <div class="mx5-dlg-panel">
      <div class="mx5-dlg-header">
        <span class="mx5-dlg-title"><span class="l-en">Market Sentiment — Breakdown</span><span class="l-zh">市场情绪 — 详细分解</span></span>
        <button class="mx5-dlg-close" type="button" onclick="mx5CloseDlg()" aria-label="Close">&#xd7;</button>
      </div>
      <div class="mx5-dlg-body">
        {% set _dlg_fg = fear_greed if (fear_greed is defined and fear_greed) else {} %}
        {% set _dlg_fg_dial = (_dlg_fg.get('dial') or 50) | float %}
        {% set _dlg_fg_label_en = _dlg_fg.get('label_en') or 'Neutral' %}
        {% set _dlg_fg_label_zh = _dlg_fg.get('label_zh') or '中性' %}
        {% set _dlg_fg_col = '#22d97a' if _dlg_fg_dial > 60 else ('#ef4444' if _dlg_fg_dial < 40 else '#f59e0b') %}
        {# Hero: composite numeral + slim 0-100 zone track (Fear→Greed) #}
        <div class="{{ 'fg-greed' if _dlg_fg_dial > 60 else ('fg-fear' if _dlg_fg_dial < 40 else 'fg-neutral') }} sg-hero">
          <div class="sg-hero-num" style="color:var(--fg-col, {{ _dlg_fg_col }})">{{ _dlg_fg_dial | int }}</div>
          <div>
            <div class="sg-hero-band" style="color:var(--fg-col, {{ _dlg_fg_col }})"><span class="l-en">{{ _dlg_fg_label_en }}</span><span class="l-zh">{{ _dlg_fg_label_zh }}</span></div>
            <div class="sg-hero-sub"><span class="l-en">Composite of 11 market gauges — a mood read, not a signal.</span><span class="l-zh">11 项市场指标合成 — 情绪参考，非交易信号。</span></div>
          </div>
        </div>
        <div class="sg-track-wrap">
          <div class="sg-track">
            <span class="sg-track-tick" style="left:40%"></span>
            <span class="sg-track-tick" style="left:60%"></span>
          </div>
          <div class="sg-track-marker" style="--sg-pos:{{ _dlg_fg_dial | int }}%"></div>
          <div class="sg-track-axis"><span>0 · {{ t('Fear','恐慌') }}</span><span>{{ t('Neutral','中性') }}</span><span>{{ t('Greed','贪婪') }} · 100</span></div>
        </div>
        <div class="mx5-dlg-sep"></div>
        {# Composite legs — each row opens a hover popover (zone dial + plain
           explainer + receipt) via the shared [data-rpop]/.rp-src engine.
           Plain-word explainer pairs are TEMPLATE copy (Tier 2), keyed by leg.key. #}
        {% set _dlg_fg_legs = _dlg_fg.get('legs_included') or [] %}
        {% if _dlg_fg_legs %}
        {% set _sg_what = {
          'spx_momentum':   ['Is the S&P trading above its 6-month average?','标普是否高于其半年均价？'],
          'nh_nl_ratio':    ['Are more stocks hitting new highs than new lows?','创新高的股票是否多于创新低的？'],
          'mcclellan':      ['Are more stocks rising than falling, day to day?','每日上涨的股票是否多于下跌的？'],
          'hy_oas':         ['Will investors lend cheaply to risky companies?','投资者是否愿意低息借给高风险企业？'],
          'safe_haven':     ['Are people buying stocks over safe Treasuries?','资金更偏好股票还是避险国债？'],
          'vix_level':      ['How much price swing does the options market expect?','期权市场预期的波动幅度有多大？'],
          'vix_trend':      ['Is expected volatility rising or falling lately?','近期预期波动率在上升还是下降？'],
          'vix_term':       ['Do traders fear the near term more than later?','交易者更担心近期还是远期？'],
          'skew':           ['How much are traders paying to insure against a crash?','为防范暴跌，交易者付出多少保险成本？'],
          'naaim':          ['How heavily are active managers invested right now?','主动型基金经理目前仓位有多重？'],
          'insider':        ['Are company insiders net buyers of their own stock?','公司内部人是否净买入自家股票？'] } %}
        {% set _sg_now = {
          'spx_momentum':   ['Above trend — buyers still in control','高于趋势 — 买方仍占主导'],
          'nh_nl_ratio':    ['Highs and lows roughly balanced','新高与新低大致持平'],
          'mcclellan':      ['Slightly more falling than rising','下跌略多于上涨'],
          'hy_oas':         ['Very willing — no stress in credit','非常愿意 — 信用市场无压力'],
          'safe_haven':     ['Leaning to stocks, mildly','小幅偏向股票'],
          'vix_level':      ['Calm — swings priced as normal','平静 — 波动定价正常'],
          'vix_trend':      ['Ticking up — a little more nervous','小幅上行 — 略显紧张'],
          'vix_term':       ['Near term calmer than later — steady','近期比远期更平静 — 稳定'],
          'skew':           ['Paying up for crash protection — cautious','为暴跌保险多付成本 — 偏谨慎'],
          'naaim':          ['Heavily invested — leaning greedy','仓位偏重 — 略偏贪婪'],
          'insider':        ['Net sellers this quarter — cautious','本季净卖出 — 偏谨慎'] } %}
        <div style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:4px"><span class="l-en">What the composite measures</span><span class="l-zh">综合指数的构成</span></div>
        <div style="font-size:10.5px;color:var(--ink-3,rgba(255,255,255,.34));margin-bottom:10px"><span class="l-en">Hover any gauge for a plain read and its dial.</span><span class="l-zh">悬停任意指标查看白话解读与刻度盘。</span></div>
        {% for leg in _dlg_fg_legs %}
        {% set _lgp = (leg.pct or 50) | float %}
        {% set _lgcol = '#22d97a' if _lgp > 60 else ('#ef4444' if _lgp < 40 else '#f59e0b') %}
        {% set _lgk = leg.get('key') %}
        {% set _lg_what = _sg_what.get(_lgk) %}
        {% set _lg_now = _sg_now.get(_lgk) %}
        <div class="mx5-dlg-factor-row {{ 'fg-greed' if _lgp > 60 else ('fg-fear' if _lgp < 40 else 'fg-neutral') }}" style="--sg-c:{{ _lgcol }}" data-rpop tabindex="0" role="button" aria-label="{{ leg.name_en }} — sentiment gauge detail">
          <div>
            <div class="mx5-dlg-factor-name"><span class="l-en">{{ leg.name_en }}</span><span class="l-zh">{{ leg.name_zh or leg.name_en }}</span><span class="sg-hint" aria-hidden="true">i</span></div>
            <div class="mx5-dlg-factor-read" style="color:var(--fg-col, {{ _lgcol }})">
              {% if _lg_now %}<span class="l-en">{{ _lg_now[0] }}</span><span class="l-zh">{{ _lg_now[1] }}</span>
              {% else %}<span class="l-en">{{ 'Greed zone' if _lgp > 60 else ('Fear zone' if _lgp < 40 else 'Neutral') }}</span><span class="l-zh">{{ '贪婪区间' if _lgp > 60 else ('恐慌区间' if _lgp < 40 else '中性') }}</span>{% endif %}
            </div>
          </div>
          <div class="mx5-dlg-factor-bar"><div class="mx5-dlg-factor-fill" style="width:{{ _lgp }}%;background:var(--fg-col, {{ _lgcol }})"></div></div>
          <div class="mx5-dlg-factor-score" style="color:var(--fg-col, {{ _lgcol }})">{{ _lgp | int }}</div>
          {# — popover payload, cloned by theme.js row-pop engine on hover/focus — #}
          <span class="rp-src" hidden>
            <div class="row-pop-hd">
              <span class="row-pop-name"><span class="l-en">{{ leg.name_en }}</span><span class="l-zh">{{ leg.name_zh or leg.name_en }}</span></span>
              <span class="row-pop-tag {{ 'up' if _lgp > 60 else ('dn' if _lgp < 40 else 'warn') }}"><span class="l-en">{{ 'Greed' if _lgp > 60 else ('Fear' if _lgp < 40 else 'Neutral') }}</span><span class="l-zh">{{ '贪婪' if _lgp > 60 else ('恐慌' if _lgp < 40 else '中性') }}</span></span>
            </div>
            <div class="row-pop-div"></div>
            <div class="sg-pop-dialwrap">{{ sg_zone_dial(_lgp, _lgcol) }}</div>
            <div class="sg-pop-expl">
              {% if _lg_what %}
              <div class="sg-pe"><span class="sg-pe-lbl">{{ t('What it is','这是什么') }}</span><span class="sg-pe-txt"><span class="l-en">{{ _lg_what[0] }}</span><span class="l-zh">{{ _lg_what[1] }}</span></span></div>
              {% endif %}
              {% if _lg_now %}
              <div class="sg-pe"><span class="sg-pe-lbl">{{ t('Now','当前') }}</span><span class="sg-pe-txt"><span class="l-en">{{ _lg_now[0] }}</span><span class="l-zh">{{ _lg_now[1] }}</span></span></div>
              {% endif %}
            </div>
            {# graph slot — renders only if the engine ships per-leg history (absent today) #}
            {% set _lg_hist = leg.get('pct_hist') %}
            {% if _lg_hist and (_lg_hist|reject('none')|list|length) > 2 %}
            <div class="sg-pop-spark">
              <div class="sg-pop-spark-lbl">{{ t('Recent range','近期区间') }}</div>
              {{ sg_leg_spark(_lg_hist, _lgcol) }}
            </div>
            {% endif %}
            <div class="row-pop-ft">
              <span class="l-en">Reading: {{ leg.value if leg.get('value') is not none else '—' }} · {{ _lgp|int }}/100 in its own history</span>
              <span class="l-zh">读数：{{ leg.value if leg.get('value') is not none else '—' }} · 历史百分位 {{ _lgp|int }}/100</span>
            </div>
          </span>{# end .rp-src #}
        </div>
        {% endfor %}
        {% endif %}
        {# Young / excluded legs #}
        {% set _dlg_fg_young = _dlg_fg.get('legs_excluded_young') or [] %}
        {% if _dlg_fg_young %}
        <div class="mx5-dlg-sep"></div>
        <div style="font-size:11px;color:var(--ink-3,rgba(255,255,255,.36));line-height:1.6">
          <span class="l-en">{{ _dlg_fg_young | length }} leg(s) are still collecting history and will join the composite once they have enough data: {% for y in _dlg_fg_young %}{{ y.name_en }}{{ ', ' if not loop.last }}{% endfor %}.</span>
          <span class="l-zh">{{ _dlg_fg_young | length }} 个分项仍在积累历史数据，待数据充足后将加入综合指数：{% for y in _dlg_fg_young %}{{ y.name_zh or y.name_en }}{{ '、' if not loop.last }}{% endfor %}。</span>
        </div>
        {% endif %}

        {# VSB W3: Volatility weather strip #}
        {% if vol_weather is defined and vol_weather %}
        {% set _vw_chips_all = vol_weather.get('chips') or [] %}
        {% set _vw_order = ['vix_level','vix_velocity','term_slope','vvix_vix','vix1d','cor1m','cor3m','dspx'] %}
        {% set _vw_map = {} %}
        {% for c in _vw_chips_all %}{% if _vw_map.update({c.get('key', ''): c}) %}{% endif %}{% endfor %}
        <div class="mx5-dlg-sep"></div>
        <div id="vsb-vol-weather-section" style="font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:10px">
          <span class="l-en">Volatility weather</span><span class="l-zh">波动率天气</span>
        </div>
        {% for key in _vw_order %}
        {% set _chip = _vw_map.get(key) %}
        {% if _chip %}
        {% set _chip_fresh = _chip.get('freshness') %}
        {% set _chip_pctile = _chip.get('pctile') %}
        {# weather tier from percentile: calm ≤35, breeze ≤60, gust ≤82, storm >82 #}
        {% set _wx_tier = (0 if _chip_pctile is none else (3 if _chip_pctile > 82 else (2 if _chip_pctile > 60 else (1 if _chip_pctile > 35 else 0)))) %}
        {% set _wx_col = ('var(--muted)' if _chip_fresh in ('young','missing') else ('var(--down,#ef4444)' if _wx_tier >= 3 else ('var(--warn,#f59e0b)' if _wx_tier == 2 else ('var(--info,#4d8ef5)' if _wx_tier == 1 else 'var(--up,#22c55e)')))) %}
        <div class="mx5-dlg-factor-row vsb-vw-row" data-vsb-chip="{{ key }}" style="--sg-wx-c:{{ _wx_col }}">
          <div class="sg-wx" aria-hidden="true">{{ sg_weather_glyph(_wx_tier) }}</div>
          <div>
            <div class="mx5-dlg-factor-name"><span class="l-en">{{ _chip.get('name_en') or key }}</span><span class="l-zh">{{ _chip.get('name_zh') or _chip.get('name_en') or key }}</span></div>
            {% if _chip_fresh in ('young', 'missing') %}
            <div class="mx5-dlg-factor-read"><span class="l-en">Still collecting — check back soon</span><span class="l-zh">仍在积累数据，稍后再看</span></div>
            {% else %}
            <div class="mx5-dlg-factor-read">
