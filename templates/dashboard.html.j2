            <ul style="margin:4px 0 0;padding-left:16px">{% for trg_en, trg_zh in pb.triggers %}<li>{{ t(trg_en, trg_zh) }}</li>{% endfor %}</ul>{% endif %}
          </span></span>{% endif %}
          <a href="us_stocks.html" style="font-weight:600;color:var(--link)">{{ t('→ Regime-approved sectors & stocks','→ 周期认可的板块与个股') }}</a>
        </div>
      </div>
      {% endif %}
