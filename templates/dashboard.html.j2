/* ══════════════════════════════════════════════════════════
   S2 — MARKETS face full content
   ══════════════════════════════════════════════════════════ */
/* Override S1 tiles: add price row */
body.page-macro .sxg-mkt-price{
  font-size:12px;font-weight:700;color:var(--ink-1);
  font-variant-numeric:tabular-nums;
}
