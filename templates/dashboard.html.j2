            <span class="l-zh"> {{ MS.radar.do_zh }}</span>
            {% else %}
            <strong class="l-en">Regime:</strong> <span class="l-en">{{ td(latest.quad_name) }} · {{ td(latest.transition_state) }}</span>
            <strong class="l-zh">周期：</strong><span class="l-zh">{{ td(latest.quad_name) }} · {{ td(latest.transition_state) }}</span>
            {% endif %}
          </div>
          {# Fired-alerts pill — preserved structure for risk_state_live.js #}
          <div class="mx2-alerts-row">
            <div class="ms-alerts-wrap">
              <label class="ms-alerts" for="ms-alerts-toggle" tabindex="0" aria-haspopup="dialog" aria-controls="ms-alerts-pop">
                {% if _nalerts %}<span class="dot"></span>{% endif %}{{ t('Fired alerts','已触发警报') }}
                <span class="ct{{ ' is-zero' if not _nalerts }}">{{ _nalerts }}</span>
              </label>
              <div class="ms-alerts-pop" id="ms-alerts-pop" role="dialog" aria-label="Fired alerts · 已触发警报">
                <div class="ms-pop-head">
                  <div>
                    <div class="ms-pop-title">⚠ {{ t('Fired alerts','已触发警报') }}</div>
                    <div class="ms-pop-sub">{{ t('Alerts are rare by design — they fire only on a change: a level escalating, a crossing, a sign flip. Read every one.','警报刻意稀少 — 仅在发生变化时触发：级别升级、出现交叉、符号翻转。每条都要读。') }}</div>
                  </div>
                </div>
                <div class="ms-pop-body">
                  {% if latest.dislocation and latest.dislocation.dislocation_active %}
                  <a class="ms-sig sev-act" data-ms-jump href="#dislocation">
                    <div class="ms-sig-head"><span class="ms-sig-ico">🚦</span><span class="ms-sig-title">{{ t('Dislocation Gate-1 is ACTIVE','错位一道闸已激活') }}</span><span class="ms-sig-jump">{{ t('View ↓','查看 ↓') }}</span></div>
                    <div class="ms-sig-detail">{% if latest.dislocation.verdict == 'buyable_washout' %}{{ t('A stress washout with the Fed put intact — a buyable washout. Confirm into stabilization, do not anticipate.','压力抛售且美联储托底在位 — 可买入错杀。在企稳中确认，勿提前抢跑。') }}{% elif latest.dislocation.verdict == 'stand_aside' %}{{ t('A stress washout with the Fed put ABSENT — stand aside (the 2000/2008/2022 falling-knife regime).','压力抛售且美联储托底缺失 — 观望（2000／2008／2022 接飞刀情形）。') }}{% else %}{{ t('An acute stress dislocation is firing — see the gate below.','急性压力错位正在触发 — 见下方一道闸。') }}{% endif %}</div>
                  </a>
                  {% endif %}
                  {% if alerts %}{% for a in alerts %}
                  <a class="ms-sig sev-{{ a.severity }}"{% if a.anchor %} data-ms-jump href="#{{ a.anchor }}"{% endif %}>
                    <div class="ms-sig-head"><span class="ms-sig-ico">{{ a.icon }}</span><span class="ms-sig-title"><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></span>{% if a.anchor %}<span class="ms-sig-jump">{{ t('View ↓','查看 ↓') }}</span>{% endif %}</div>
                    <div class="ms-sig-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
                    {% if a.what_en %}<div class="ms-sig-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh }}</span></div>{% endif %}
                    {% if a.edge_en %}<div class="ms-sig-edge"><b>{{ t('Conviction:','可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
                  </a>
                  {% endfor %}{% elif not (latest.dislocation and latest.dislocation.dislocation_active) %}
                  <div class="ms-pop-empty"><span class="big">✓</span>{{ t('No alerts fired today. Alerts are rare by design — they fire only on a change.','今日无警报触发。警报刻意稀少 — 仅在发生变化时触发。') }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            {% if macro_catalysts and macro_catalysts|length > 0 %}
            {% set _nextev = macro_catalysts[0] %}
            <span class="v2chip {{ 'c-warn' if _nextev.impact == 'high' else 'c-info' }}">
              <span class="l-en">{{ _nextev.label[:30] }}{% if _nextev.label|length > 30 %}…{% endif %} {{ _nextev.date[5:10] }}</span>
              <span class="l-zh">{{ _nextev.label[:20] }}{% if _nextev.label|length > 20 %}…{% endif %} {{ _nextev.date[5:10] }}</span>
            </span>
            {% endif %}
          </div>
        </div>
      </div>{# /mx2-hero-row #}
      </section>{# /ms-verdict — wraps thesis + score + tick for check_ms_board_coherence.py #}
    </div>{# /mx2-hero / ms-front #}
    {# alerts toggle script — touch path #}
    <script>
    (function(){
      var cb=document.getElementById('ms-alerts-toggle');
      if(!cb) return;
      document.addEventListener('click',function(e){
        if(e.target.closest('[data-ms-jump]')){ cb.checked=false; return; }
        var wrap=e.target.closest('.ms-alerts-wrap');
        if(cb.checked && !wrap) cb.checked=false;
      });
      document.addEventListener('keydown',function(e){
        if(e.key==='Escape'&&cb.checked) cb.checked=false;
      });
    })();
    </script>
    {% endif %}{# /if market_state — v2 hero #}
  </div>{# /#regime-radar panel #}

  {# ── V2 ROW-LEDGER SECTIONS (macro mode only) ── #}
  {% if mode != 'stocks' %}
  {% set MS2 = market_state %}
  {% set _mos2 = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
  <div class="panel span12" style="padding:0 20px">

  {# v2 topbar: brand + expand-all pill #}
  <div class="mx2-topbar">
    <span class="mx2-topbar-brand"><span class="l-en">Macro Ledger</span><span class="l-zh">宏观总览</span></span>
    <div class="mx2-topbar-right">
      {% if MS2 %}<span class="mx2-topbar-date"><span class="l-en">as of {{ MS2.asof }}</span><span class="l-zh">{{ MS2.asof }}</span></span>{% endif %}
      <button id="mx2ExpandAllBtn" class="mx2-expand-btn" onclick="mx2ToggleAll()" type="button">
        <span class="ea-ic">&#8964;</span>
        <span class="ea-txt"><span class="l-en">Expand all</span><span class="l-zh">全部展开</span></span>
      </button>
    </div>
  </div>

  {# 1. EVIDENCE row + tray #}
  {% set _weakest = MS2.components | sort(attribute='score') | first if (MS2 and MS2.components) else none %}
  <div class="sx" id="sx-evidence" style="--isle-color:var(--isle-evidence)">
    <div class="sx-sum" role="button" tabindex="0" aria-expanded="false" onclick="mx2Toggle('sx-evidence')">
      <span class="sx-label"><span class="l-en">Evidence</span><span class="l-zh">依据</span></span>
      <div class="sx-glance">
        <span style="font-size:12px;color:var(--muted)">
          <span class="l-en">Six-factor breakdown
            {%- if _weakest %} &nbsp;·&nbsp; flip trigger: {{ _weakest.label_en }} ({{ _weakest.score }}/100){% endif %}
          </span>
          <span class="l-zh">六因子分析
            {%- if _weakest %} &nbsp;·&nbsp; 翻转触发：{{ _weakest.label_zh or _weakest.label_en }} ({{ _weakest.score }}/100){% endif %}
          </span>
        </span>
        <span class="v2-display-badge"><span class="l-en">DISPLAY-ONLY</span><span class="l-zh">仅展示</span></span>
      </div>
      <div class="sx-chev">&#8964;</div>
    </div>
    <div class="sx-tray"><div class="sx-tray-inner-wrap"><div class="sx-island">
      {# Island header beacon #}
      <div class="isle-head">
        <div class="isle-head-dot"></div>
        <span class="isle-head-label"><span class="l-en">Evidence — Six-Factor Breakdown</span><span class="l-zh">依据 — 六因子分析</span></span>
        <div class="isle-head-line"></div>
        <span class="v2-display-badge" style="margin-left:8px"><span class="l-en">DISPLAY-ONLY</span><span class="l-zh">仅展示</span></span>
      </div>

      {# Factor rows #}
      <div class="isle-ev-factors">
        {% set _ev_stags = ['isle-s1','isle-s2','isle-s3','isle-s4','isle-s5','isle-s6'] %}
        {% for c in (MS2.components if MS2 and MS2.components else []) %}
        {% set _ec = 'var(--up)' if c.tone == 'good' else ('var(--down)' if c.tone == 'bad' else 'var(--warn)') %}
        {% set _is_weakest = (_weakest and c.label_en == _weakest.label_en) %}
        {% set _stag = _ev_stags[loop.index0] if loop.index0 < _ev_stags|length else 'isle-s6' %}
        <div class="isle-ev-row isle-stagger {{ _stag }}{{ ' ev-weakest' if _is_weakest }}" style="--factor-color:{{ _ec }}">
          <span class="isle-ev-dir" style="color:{{ _ec }}">{{ c.arrow }}</span>
          <div class="isle-ev-name-wrap">
            <span class="isle-ev-name" style="{{ 'color:var(--warn)' if _is_weakest }}">
              {{ t(c.label_en, c.label_zh) }}
              {% if _is_weakest %}<span class="v2chip c-warn" style="font-size:9px;padding:1px 5px;margin-left:4px"><span class="l-en">WEAKEST LEG</span><span class="l-zh">最弱分项</span></span>{% endif %}
            </span>
            <span class="isle-ev-subtext">{{ t(c.read_en, c.read_zh) if (c.read_en is defined and c.read_en) else '' }}</span>
          </div>
          <div class="isle-ev-bar-area">
            <div class="isle-ev-bar-label-row"><span>0</span><span>50</span><span>100</span></div>
            <div class="isle-ev-bar-track"><div class="isle-ev-bar-fill" style="width:{{ c.score }}%;background:{{ _ec }}"></div></div>
          </div>
          <span class="isle-ev-score" style="color:{{ _ec }}">{{ c.score }}</span>
        </div>
        {% endfor %}
      </div>

      {# Weakest leg spotlight callout #}
      {% if _weakest %}
      <div class="isle-ev-weakest-callout isle-stagger isle-s7">
        <span class="l-en"><strong>{{ t('Weakest leg spotlight','最弱分项') }}:</strong> {{ _weakest.label_en }} at {{ _weakest.score }}/100 is the closest flip-trigger. {{ t('Confirms what has already turned; does not forecast.','确认已转向信号，不预测未来。') }}</span>
        <span class="l-zh"><strong>最弱分项:</strong> {{ _weakest.label_zh or _weakest.label_en }} 现 {{ _weakest.score }}/100，最接近翻转触发点。确认已转向信号，不预测未来。</span>
      </div>
      {% endif %}

      {# Multi-timeframe tape #}
      {% if MS2 and MS2.mtf and MS2.mtf.indices %}
      <div class="isle-stagger isle-s7" style="margin-top:18px">
        <div class="isle-ev-tape-head">{{ t('Multi-Timeframe Tape','多周期趋势') }}</div>
        <table class="isle-ev-tape-table">
          <thead><tr>
            <th class="l">{{ t('Index','指数') }}</th>
            <th>1D</th><th>3D</th><th>7D</th><th>30D</th>
            <th style="text-align:right">{{ t('Confluence','合流') }}</th>
          </tr></thead>
          <tbody>
          {% for r in MS2.mtf.indices %}
            <tr>
              <td class="l t-inst" style="color:var(--muted)">{{ t(r.label_en, r.label_zh) }}</td>
              {% for tf in ['D','3D','W','M'] %}{% set cell = r.cells[tf] %}
              <td style="text-align:center">{% if cell %}<span class="ms-cell2 {{ cell.tone }}"><span class="ar">{{ cell.arrow }}</span><span class="rsi">{{ cell.rsi|round|int if cell.rsi is not none else '·' }}</span></span>{% else %}<span class="ms-cell2 flat"><span class="ar">·</span></span>{% endif %}</td>
              {% endfor %}
              <td style="text-align:right"><span class="ms-conf {{ r.tone }}">{{ t(r.confluence_en, r.confluence_zh) }}</span></td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {# Footnote #}
      <div class="isle-ev-footnote isle-stagger isle-s8">
        <span>
          <span class="l-en">Blended 0–100. ≥60 = risk-on · 42–59 = mixed · &lt;42 = risk-off.{% if _weakest %} Flip trigger: {{ _weakest.label_en }} (now {{ _weakest.score }}/100).{% endif %} Confirms what has already turned; does not forecast. Gauntlet applies at promotion only.</span>
          <span class="l-zh">合成 0-100 分。≥60 偏好 · 42-59 混合 · &lt;42 避险。{% if _weakest %}翻转触发：{{ _weakest.label_zh or _weakest.label_en }}（现 {{ _weakest.score }}/100）。{% endif %}确认已转向信号，不预测未来。</span>
        </span>
        <span class="v2-display-badge" style="flex-shrink:0"><span class="l-en">DISPLAY-ONLY</span><span class="l-zh">仅展示</span></span>
      </div>

      <div class="isle-stamp">
        <span class="l-en">as of {{ MS2.asof if MS2 and MS2.asof is defined else '' }}</span>
        <span class="l-zh">{{ MS2.asof if MS2 and MS2.asof is defined else '' }}</span>
      </div>
    </div></div></div>
  </div>{# /sx-evidence #}

  {# 2. EVENTS row + tray (contains Release Radar + week-ahead band) #}
  <div class="sx" id="sx-events-v2" style="--isle-color:var(--isle-events)">
    <div class="sx-sum" role="button" tabindex="0" aria-expanded="false" onclick="mx2Toggle('sx-events-v2')">
      <span class="sx-label"><span class="l-en">Events</span><span class="l-zh">事件</span></span>
      <div class="sx-glance mx2-events-glance">
        {% if macro_catalysts %}
        {% for c in macro_catalysts[:2] %}
        <span class="v2chip {{ 'c-warn' if c.impact == 'high' else 'c-info' }}">{{ c.label[:22] }}{% if c.label|length > 22 %}…{% endif %} {{ _mos2[c.date[5:7]|int] }} {{ c.date[8:10]|int }}</span>
        {% endfor %}
        {% endif %}
        {% if prediction_markets and prediction_markets.events %}
        {% set _pm_top = (prediction_markets.events|first).outcomes | sort(attribute='prob',reverse=true) | first %}
        <span style="font-size:12px;color:var(--muted)" class="l-en">{{ t('Fed','Fed') }} {{ _pm_top.outcome }} {{ _pm_top.prob }}%</span>
        <span style="font-size:12px;color:var(--muted)" class="l-zh">美联储 {{ _pm_top.outcome }} {{ _pm_top.prob }}%</span>
        {% endif %}
      </div>
      <div class="sx-chev">&#8964;</div>
    </div>
    <div class="sx-tray"><div class="sx-tray-inner-wrap"><div class="sx-island">
      {# Island header beacon #}
      <div class="isle-head">
        <div class="isle-head-dot"></div>
        <span class="isle-head-label"><span class="l-en">Events — Catalysts &amp; Release Radar</span><span class="l-zh">事件 — 催化剂与数据发布雷达</span></span>
        <div class="isle-head-line"></div>
      </div>

      {# THIS WEEK catalyst day-cards #}
      {% if macro_catalysts or (prediction_markets and prediction_markets.events) or (event_risk and event_risk.show) %}
      <div id="week-ahead" class="isle-stagger isle-s1" style="margin-bottom:16px">
        <div class="isle-section-eyebrow">{{ t('This Week','本周') }}</div>
        <div class="isle-event-grid">
          {% for c in macro_catalysts[:8] %}
          <div class="isle-ev-cal-card{{ ' hot' if c.impact == 'high' else '' }} isle-stagger isle-s{{ loop.index if loop.index <= 4 else '4' }}">
            <div class="isle-ev-cal-date">{{ _mos2[c.date[5:7]|int] }} {{ c.date[8:10]|int }}</div>
            <div class="isle-ev-cal-title">{{ c.label }}</div>
            <div class="isle-ev-cal-meta">
              {% if c.time_et %}<span style="color:var(--muted);font-size:10px">{{ c.time_et }} ET</span>{% endif %}
              {% if c.impact == 'high' %}<span class="v2chip c-warn" style="font-size:9px;padding:1px 5px">{{ t('HIGH','高') }}</span>{% elif c.impact == 'med' %}<span class="v2chip c-info" style="font-size:9px;padding:1px 5px">{{ t('MED','中') }}</span>{% endif %}
            </div>
          </div>
          {% endfor %}
        </div>

        {# Fed strip from prediction markets #}
        {% if prediction_markets and prediction_markets.events %}
        <div class="isle-fed-strip isle-stagger isle-s4">
          <span class="isle-fed-label">{{ t('Fed · Market Pricing','美联储 · 市场定价') }}</span>
          {% for e in prediction_markets.events[:3] %}
          {% set _top = (e.outcomes|sort(attribute='prob',reverse=true))|first %}
          <div class="isle-fed-item">
            <span class="isle-fed-desc">{{ t(e.label_en, e.label_zh) }}</span>
            <b class="isle-fed-val num">{{ _top.outcome }} {{ _top.prob }}%</b>
            {% if _top.chg_pp is not none and _top.chg_pp != 0 %}<span class="{{ 'pos' if _top.chg_pp > 0 else 'neg' }}" style="font-size:11px">{{ '%+.1f'|format(_top.chg_pp) }}pp</span>{% endif %}
          </div>
          {% endfor %}
          <span class="isle-fed-src">Polymarket</span>
        </div>
        {% endif %}
      </div>
      {% endif %}
  {% if mode != 'stocks' %}
  <style id="rr-css">
  /* ---- Release Radar MRI-R39: minimalist card + 5-tab modal ---- */
  /* 4px-base spacing scale; tabular-nums for all figures */
  #release-radar{padding:16px 20px 18px}
  #release-radar h2{margin:0 0 4px;font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px}
  #release-radar .rr-subline{font-size:11.5px;color:var(--muted);margin-bottom:14px}
  /* MRI-R39a: track-record top-right button */
  .rr-tr-btn{margin-left:auto;flex-shrink:0;font-size:11px;font-weight:500;
    color:var(--muted);background:none;border:1px solid color-mix(in srgb,var(--line) 70%,transparent);
    border-radius:5px;padding:3px 9px;cursor:pointer;text-decoration:none;display:inline-flex;
    align-items:center;min-height:44px;min-width:44px;line-height:1.2;transition:border-color .15s,color .15s}
  .rr-tr-btn:hover{border-color:var(--accent,var(--muted));color:var(--text)}
  /* MRI-R39a: track-record panel-level overlay */
  .rr-tr-overlay{position:fixed;inset:0;z-index:1100;display:none;align-items:flex-end;
    background:color-mix(in srgb,var(--bg,#000) 55%,transparent)}
  .rr-tr-overlay.is-open{display:flex}
  .rr-tr-sheet{background:var(--panel);border-radius:16px 16px 0 0;width:100%;max-height:90vh;
    overflow-y:auto;padding:20px 20px 24px}
  .rr-tr-hdr{display:flex;align-items:center;gap:10px;margin-bottom:12px}
  .rr-tr-title{font-size:14px;font-weight:700;flex:1}
  .rr-tr-close{min-width:44px;min-height:44px;background:none;border:none;
    cursor:pointer;font-size:20px;color:var(--muted);display:flex;align-items:center;justify-content:center}
  .rr-tr-close:hover{color:var(--text)}
  .rr-tr-do-note{font-size:10px;color:var(--muted);margin-top:14px;padding-top:8px;
    border-top:1px solid var(--line);line-height:1.5}
  @media(min-width:600px){
    .rr-tr-sheet{max-width:660px;margin:0 auto;border-radius:12px;margin-top:auto}
    .rr-tr-overlay{align-items:center}
  }
  #release-radar .rr-grid{display:flex;flex-wrap:wrap;gap:12px}
  /* Compact card — R24-minimal */
  .rr-card{flex:1 1 220px;min-width:200px;max-width:340px;background:var(--panel2);
    border:1px solid var(--line);border-radius:10px;padding:12px 14px;
    position:relative;cursor:pointer;transition:border-color .15s,box-shadow .15s}
  .rr-card:hover{border-color:var(--accent,var(--up));
    box-shadow:0 2px 8px color-mix(in srgb,var(--text) 8%,transparent)}
  .rr-card-head{display:flex;align-items:baseline;gap:6px;margin-bottom:6px;flex-wrap:wrap}
  .rr-card-name{font-size:13.5px;font-weight:700}
  .rr-card-period{font-size:10.5px;color:var(--muted)}
  .rr-countdown{font-size:10.5px;font-variant-numeric:tabular-nums;padding:1px 6px;
    border-radius:4px;background:var(--panel);border:1px solid var(--line);margin-left:auto}
  .rr-proj-row{margin:6px 0 4px}
  .rr-proj-label{font-size:10px;font-weight:700;text-transform:uppercase;
    letter-spacing:.08em;color:var(--muted);margin-bottom:2px}
  .rr-point{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums}
  .rr-chips-row{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0 4px}
  /* Expectation chip */
  .rr-exp{display:inline-flex;align-items:center;padding:2px 8px;
    border-radius:12px;font-size:10.5px;font-weight:600}
  .rr-exp-above{background:color-mix(in srgb,var(--down) 15%,transparent);
    color:var(--down);border:1px solid color-mix(in srgb,var(--down) 30%,transparent)}
  .rr-exp-below{background:color-mix(in srgb,var(--up) 15%,transparent);
    color:var(--up);border:1px solid color-mix(in srgb,var(--up) 30%,transparent)}
  .rr-exp-aligned{background:color-mix(in srgb,var(--muted) 20%,transparent);
    color:var(--muted);border:1px solid color-mix(in srgb,var(--muted) 30%,transparent)}
  /* Trend skew chip */
  .rr-skew{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;
    border-radius:12px;font-size:10.5px;font-weight:600}
  .rr-skew-hot{background:color-mix(in srgb,var(--down) 18%,transparent);
    color:var(--down);border:1px solid color-mix(in srgb,var(--down) 35%,transparent)}
  .rr-skew-cool{background:color-mix(in srgb,var(--up) 18%,transparent);
    color:var(--up);border:1px solid color-mix(in srgb,var(--up) 35%,transparent)}
  .rr-skew-inline{background:color-mix(in srgb,var(--warn) 18%,transparent);
    color:var(--warn);border:1px solid color-mix(in srgb,var(--warn) 35%,transparent)}
  /* Coverage chip */
  .rr-cov{display:inline-flex;align-items:center;padding:2px 7px;
    border-radius:4px;font-size:9.5px;font-weight:600}
  .rr-cov-fresh{background:color-mix(in srgb,var(--up) 15%,transparent);
    color:var(--up);border:1px solid color-mix(in srgb,var(--up) 30%,transparent)}
  .rr-cov-partial{background:color-mix(in srgb,var(--warn) 15%,transparent);
    color:var(--warn);border:1px solid color-mix(in srgb,var(--warn) 30%,transparent)}
  .rr-cov-stale{background:color-mix(in srgb,var(--down) 15%,transparent);
    color:var(--down);border:1px solid color-mix(in srgb,var(--down) 30%,transparent)}
  .rr-cov-prior{background:color-mix(in srgb,var(--muted) 15%,transparent);
    color:var(--muted);border:1px solid color-mix(in srgb,var(--muted) 30%,transparent)}
  /* MRI-R39a compact two-number row */
  .rr-nums-row{display:flex;gap:16px;margin:5px 0 4px;align-items:flex-end}
  .rr-num-col{display:flex;flex-direction:column;min-width:52px}
  .rr-num-lbl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;
    color:var(--muted);margin-bottom:1px;white-space:nowrap}
  .rr-num-src{font-size:8.5px;color:var(--muted);margin-left:3px;font-weight:400;text-transform:none;letter-spacing:0}
  .rr-num-val{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.1}
  .rr-num-dash{font-size:18px;font-weight:400;color:var(--muted);font-variant-numeric:tabular-nums}
  /* chevron corner */
  .rr-chevron{position:absolute;bottom:7px;right:10px;font-size:11px;color:var(--muted)}
  /* benchmark-only tag */
  .rr-bmo-tag{display:inline-flex;align-items:center;padding:1px 6px;border-radius:4px;
    font-size:9.5px;color:var(--muted);background:var(--panel);border:1px solid var(--line);margin-top:2px}
  /* no-data compact card */
  .rr-nodata-compact{font-size:11px;color:var(--muted);font-style:italic;padding:6px 0 2px}
  /* see-more toggle */
  .rr-see-more-wrap{text-align:center;margin-top:10px}
  .rr-see-more-btn{display:inline-flex;align-items:center;gap:5px;padding:8px 18px;
    border-radius:8px;border:1px solid var(--line);background:var(--panel2);
    color:var(--muted);font-size:12px;cursor:pointer;min-height:44px;
    font-family:inherit;transition:border-color .15s,color .15s}
  .rr-see-more-btn:hover{border-color:var(--accent,var(--up));color:var(--text)}
  /* ---- Modal overlay ---- */
  .rr-modal-overlay{display:none;position:fixed;inset:0;
    background:var(--modal-backdrop,color-mix(in srgb,var(--bg,#000) 72%,transparent));
    z-index:9900;align-items:flex-start;justify-content:center;overflow-y:auto;padding:24px 12px}
  .rr-modal-overlay.open{display:flex}
  .rr-modal{background:var(--panel2);border:1px solid var(--line);border-radius:12px;
    width:100%;max-width:620px;padding:0;position:relative;
    box-shadow:0 8px 32px color-mix(in srgb,var(--text) 16%,transparent)}
  .rr-modal-hdr{padding:16px 44px 12px 20px}
  .rr-modal-close{position:absolute;top:12px;right:14px;background:none;border:none;
    font-size:20px;cursor:pointer;color:var(--muted);line-height:1;padding:4px 8px;
    border-radius:4px;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center}
  .rr-modal-close:hover{color:var(--text);background:var(--panel)}
  .rr-modal-title{font-size:16px;font-weight:700;margin:0 0 2px}
  .rr-modal-sub{font-size:11.5px;color:var(--muted)}
  /* health indicator on sub-line */
  .rr-health-dot{display:inline-block;width:6px;height:6px;border-radius:50%;
    background:var(--warn);margin-right:4px;vertical-align:middle}
  /* ---- Tab strip (sticky) ---- */
  .rr-tab-strip{display:flex;gap:0;border-bottom:1px solid var(--line);
    position:sticky;top:0;background:var(--panel2);z-index:2;overflow-x:auto;
    -webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none}
  .rr-tab-strip::-webkit-scrollbar{display:none}
  .rr-tab{padding:8px 14px;font-size:11px;font-weight:700;text-transform:uppercase;
    letter-spacing:.07em;cursor:pointer;border:none;background:none;color:var(--muted);
    border-bottom:2px solid transparent;margin-bottom:-1px;white-space:nowrap;
    transition:color .1s,border-color .1s;min-height:40px}
  .rr-tab:hover{color:var(--text)}
  .rr-tab.active{color:var(--text);border-bottom-color:var(--accent,var(--up))}
  /* ---- Tab panes ---- */
  .rr-tab-body{padding:16px 20px 20px}
  .rr-pane{display:none}
  .rr-pane.active{display:block}
  /* Section group: one bottom-border per group, not per section */
  .rr-grp{margin:0 0 12px;padding-bottom:12px;border-bottom:1px solid color-mix(in srgb,var(--line) 50%,transparent)}
  .rr-grp:last-child{margin-bottom:0;padding-bottom:0;border-bottom:none}
  .rr-grp-label{font-size:10px;font-weight:700;text-transform:uppercase;
    letter-spacing:.09em;color:var(--muted);margin-bottom:6px}
  /* shared metric row */
  .rr-meta-row{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:11px;color:var(--muted);margin:4px 0}
  /* interval cone bar */
  .rr-interval-bar{position:relative;height:8px;border-radius:4px;
    background:var(--panel);border:1px solid var(--line);margin:4px 0 2px;overflow:visible}
  .rr-interval-fill{position:absolute;top:0;bottom:0;border-radius:3px;
    background:color-mix(in srgb,var(--up) 35%,transparent)}
  .rr-interval-tick{position:absolute;top:-3px;bottom:-3px;width:2px;
    background:var(--text);border-radius:1px}
  .rr-interval-labels{display:flex;justify-content:space-between;
    font-size:9.5px;color:var(--muted);font-variant-numeric:tabular-nums}
  /* benchmark table */
  .rr-bench-row{display:flex;justify-content:space-between;
    font-size:11.5px;font-variant-numeric:tabular-nums;padding:2px 0}
  .rr-bench-name{color:var(--muted)}
  .rr-bench-val{font-weight:600}
  /* policy items */
  .rr-policy{font-size:11px;display:flex;flex-wrap:wrap;gap:4px 10px}
  .rr-policy-item{color:var(--muted)}
  .rr-policy-item b{color:var(--text);font-weight:600}
  /* scoreboard */
  .rr-scoreboard-title{font-size:10.5px;font-weight:700;text-transform:uppercase;
    letter-spacing:.08em;color:var(--muted);margin-bottom:5px}
  .rr-track-table{width:100%;border-collapse:collapse;font-size:11px}
  .rr-track-table th{font-size:9.5px;font-weight:700;text-transform:uppercase;
    letter-spacing:.07em;color:var(--muted);text-align:left;padding:2px 5px 4px;
    border-bottom:1px solid var(--line)}
  .rr-track-table td{padding:2px 5px;font-variant-numeric:tabular-nums;
    border-bottom:1px solid color-mix(in srgb,var(--line) 40%,transparent)}
  .rr-empty{font-size:11.5px;color:var(--muted);font-style:italic;padding:4px 0}
  /* general */
  .rr-placeholder{color:var(--muted);font-size:12px;font-style:italic;padding:8px 0}
  .rr-asof{font-size:10px;color:var(--muted);margin-top:10px}
  .rr-footer{font-size:10px;color:var(--muted);margin-top:12px;
    padding-top:8px;border-top:1px solid var(--line);line-height:1.5}
  /* component attribution bars */
  .rr-comp-rows{display:flex;flex-direction:column;gap:3px}
  .rr-comp-row{display:flex;align-items:center;gap:5px;font-size:10.5px}
  .rr-comp-name{width:130px;flex-shrink:0;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rr-comp-bar-wrap{flex:1;position:relative;height:8px;border-radius:3px;
    background:var(--panel);border:1px solid var(--line);overflow:hidden}
  .rr-comp-bar-fill-pos{position:absolute;top:0;bottom:0;left:50%;
    background:color-mix(in srgb,var(--down) 55%,transparent);border-radius:0 2px 2px 0}
  .rr-comp-bar-fill-neg{position:absolute;top:0;bottom:0;right:50%;
    background:color-mix(in srgb,var(--up) 55%,transparent);border-radius:2px 0 0 2px}
  .rr-comp-val{width:48px;flex-shrink:0;text-align:right;font-variant-numeric:tabular-nums;
    font-size:10px;color:var(--text)}
  .rr-comp-muted{color:var(--muted);font-style:italic}
  /* confidence composition bar */
  .rr-conf-bar-wrap{display:flex;height:7px;border-radius:4px;overflow:hidden;
    border:1px solid var(--line)}
  .rr-conf-seg-known{background:color-mix(in srgb,var(--up) 70%,transparent)}
  .rr-conf-seg-proxy{background:color-mix(in srgb,var(--warn) 65%,transparent)}
  .rr-conf-seg-residual{background:color-mix(in srgb,var(--muted) 40%,transparent)}
  .rr-conf-legend{display:flex;gap:10px;margin-top:3px;font-size:9.5px;color:var(--muted)}
  .rr-conf-leg-dot{display:inline-block;width:7px;height:7px;border-radius:2px;margin-right:2px;vertical-align:middle}
  /* market-implied row */
  .rr-mkt-row{display:flex;align-items:center;gap:8px;
    font-size:11px;padding:3px 0;border-top:1px dashed var(--line);margin-top:4px}
  .rr-mkt-label{color:var(--muted)}
  .rr-mkt-val{font-weight:600;font-variant-numeric:tabular-nums}
  .rr-mkt-source{font-size:9.5px;padding:1px 5px;border-radius:3px;
    background:var(--panel);border:1px solid var(--line);color:var(--muted)}
  /* surprise distribution gauge */
  .rr-sdist-wrap{display:flex;align-items:center;gap:6px;margin:4px 0}
  .rr-sdist-bar-wrap{flex:1;display:flex;height:7px;border-radius:4px;overflow:hidden;
    border:1px solid var(--line)}
  .rr-sdist-hot{background:color-mix(in srgb,var(--down) 60%,transparent)}
  .rr-sdist-inline{background:color-mix(in srgb,var(--warn) 50%,transparent)}
  .rr-sdist-cold{background:color-mix(in srgb,var(--up) 60%,transparent)}
  .rr-sdist-legend{display:flex;gap:7px;font-size:9.5px;color:var(--muted)}
  /* reaction sensitivity */
  .rr-sens-footer{font-size:10px;color:var(--muted);line-height:1.6}
  .rr-sens-note{font-size:9px;color:var(--muted);font-style:italic;margin-top:1px}
  /* revision risk (NFP) */
  .rr-rev-risk{font-size:10.5px;color:var(--muted);margin:3px 0}
  /* quirk flag chips */
  .rr-quirk-row{display:flex;flex-wrap:wrap;gap:4px;margin:5px 0 2px}
  .rr-quirk-chip{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;
    border-radius:4px;font-size:9.5px;line-height:1.4;
    background:color-mix(in srgb,var(--warn) 18%,transparent);
    border:1px solid color-mix(in srgb,var(--warn) 40%,transparent);
    color:var(--text)}
  .rr-quirk-icon{font-size:10px}
  /* print-integrity chip */
  .rr-integrity-chip{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;
    border-radius:4px;font-size:10px;font-weight:600}
  .rr-integrity-normal{background:color-mix(in srgb,var(--up) 12%,transparent);
    border:1px solid color-mix(in srgb,var(--up) 25%,transparent);color:var(--up)}
  .rr-integrity-degraded{background:color-mix(in srgb,var(--warn) 18%,transparent);
    border:1px solid color-mix(in srgb,var(--warn) 40%,transparent);color:var(--warn)}
  .rr-integrity-disrupted{background:color-mix(in srgb,var(--down) 18%,transparent);
    border:1px solid color-mix(in srgb,var(--down) 40%,transparent);color:var(--down)}
  /* capture health strip */
  .rr-health-strip{font-size:10px;color:var(--muted);padding:5px 0;line-height:1.6}
  .rr-health-warn{color:var(--down)}
  /* CPI bridge waterfall */
  .rr-bridge-row{display:flex;align-items:center;gap:5px;font-size:10.5px;padding:1px 0}
  .rr-bridge-name{width:130px;flex-shrink:0;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .rr-bridge-bar-wrap{flex:1;position:relative;height:8px;border-radius:3px;
    background:var(--panel);border:1px solid var(--line);overflow:hidden}
  .rr-bridge-fill-pos{position:absolute;top:0;bottom:0;left:50%;
    background:color-mix(in srgb,var(--down) 55%,transparent);border-radius:0 2px 2px 0}
  .rr-bridge-fill-neg{position:absolute;top:0;bottom:0;right:50%;
    background:color-mix(in srgb,var(--up) 55%,transparent);border-radius:2px 0 0 2px}
  .rr-bridge-val{width:52px;flex-shrink:0;text-align:right;font-variant-numeric:tabular-nums;
    font-size:10px;color:var(--text)}
  .rr-bridge-prior{font-size:9px;color:var(--muted);font-style:italic}
  /* v3_factor shadow row */
  .rr-shadow-row{background:var(--panel);border:1px solid var(--line);border-radius:6px;
    padding:8px 10px;margin:6px 0;font-size:11px}
  .rr-shadow-label{font-size:10px;font-weight:700;text-transform:uppercase;
    letter-spacing:.08em;color:var(--muted);margin-bottom:4px}
  .rr-shadow-warn{font-size:9.5px;color:var(--down);font-style:italic;
    border-left:2px solid var(--down);padding-left:6px;margin-top:4px;line-height:1.4}
  /* surprise anatomy mini-table */
  .rr-anatomy-table{width:100%;border-collapse:collapse;font-size:10.5px;margin-top:4px}
  .rr-anatomy-table th{font-size:9.5px;font-weight:700;text-transform:uppercase;
    letter-spacing:.06em;color:var(--muted);text-align:left;padding:2px 5px 3px;
    border-bottom:1px solid var(--line)}
  .rr-anatomy-table td{padding:2px 5px;border-bottom:1px solid color-mix(in srgb,var(--line) 35%,transparent)}
  /* modal footnote */
  .rr-modal-do-note{font-size:9.5px;color:var(--muted);font-style:italic;
    margin:12px 20px 16px;padding-top:8px;border-top:1px solid var(--line);line-height:1.5}
  /* mobile: full-screen sheet ≤480px */
  @media(max-width:480px){
    .rr-modal-overlay{padding:0}
    .rr-modal{max-width:100%;width:100%;border-radius:16px 16px 0 0;margin-top:auto;
      max-height:90vh;overflow-y:auto}
    .rr-modal-close{min-width:48px;min-height:48px}
    .rr-tab{padding:10px 12px;min-height:44px}
  }
  /* Compress tab padding on narrow viewports so all 5 tabs fit without clipping */
  @media(max-width:479px){
    .rr-tab{padding:8px 8px;font-size:10px;letter-spacing:.04em}
  }
  </style>
