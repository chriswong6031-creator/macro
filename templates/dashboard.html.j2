        <span class="donor-ic">{{ '☯' if _don.state == 'cracking' else '✓' }}</span>
        <b>{% if _don.state == 'cracking' %}<span class="l-en">Sector leader: {{ _don.donor_sector }} — wobbling (historically a BETTER entry window — not a sell signal)</span><span class="l-zh">领涨板块：{{ _don.donor_sector }} — 出现趋弱（过去此阶段入场胜率更高——并非卖出信号）</span>{% else %}<span class="l-en">Sector leader: {{ _don.donor_sector }} — still going strong</span><span class="l-zh">领涨板块：{{ _don.donor_sector }} — 依然强势</span>{% endif %}</b>
      </div>
      {% endif %}
