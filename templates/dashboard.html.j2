    .sbx-cnt .w{font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
    .sbx-cnt.adv b{color:var(--up)}.sbx-cnt.dec b{color:var(--down)}
    .sbx-bar{display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--line)}
    .sbx-bar i{display:block;height:100%}
    .sbx-bar .a{background:var(--up)}.sbx-bar .u{background:var(--line)}.sbx-bar .d{background:var(--down)}
    .sbx-stance{margin:10px 1px 0;font-size:12.5px;line-height:1.5}
    .sbx-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
    @media(max-width:900px){.sbx-tiles{grid-template-columns:repeat(2,1fr)}}
    .sbx-tile{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 14px 10px;cursor:pointer;min-width:0}
    .sbx-tile:hover,.sbx-bar-card:hover{border-color:color-mix(in srgb,var(--link) 40%,var(--line))}
    .sbx-tl{font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .sbx-tv{font-size:20px;font-weight:800;font-variant-numeric:tabular-nums;line-height:1;margin-bottom:7px}
    .sbx-tv.pos{color:var(--up)}.sbx-tv.neg{color:var(--down)}
    .sbx-tw{font-size:11px;color:var(--muted);line-height:1.35}
    .sbx-wl{position:relative;height:4px;border-radius:2px;background:var(--line);margin:0 0 7px}
