             stance in plain words and point at the risk read beside it. #}
          {% set _ts = latest.transition_state if (latest.transition_state is defined and latest.transition_state) else '' %}
          {% set _ts_en = {'TRANSITIONING':'shifting — backdrop fading, not all-clear; see the risk read →','STABLE':'stable','WEAKENING':'weakening — early cracks, not all-clear; see the risk read →','NEW_REGIME':'new regime'}.get(_ts, _ts|lower) %}
          {% set _ts_zh = {'TRANSITIONING':'转换中 — 背景趋弱，并非全面利好；参见风险解读 →','STABLE':'稳定','WEAKENING':'走弱 — 初现裂痕，并非全面利好；参见风险解读 →','NEW_REGIME':'新周期'}.get(_ts, tr(_ts)) %}
          <span class="l-en">{{ td(latest.quad_name) }} &nbsp;·&nbsp; {{ _ts_en }}</span>
