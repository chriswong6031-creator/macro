        </span>
        <span class="l-zh">
          <span style="color:var(--ink-3,rgba(255,255,255,.36));font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;">{{ _abHiCnt }} 条高影响信息</span><br>
          {% if _abDomCh_clean_zh %}主导频道：<span style="color:var(--mx5-accent-ink);font-weight:600">{{ _abDomCh_clean_zh }}</span><br>{% endif %}
          {{ _abHiCnt }} 条高影响信号
        </span>
        {% else %}
        <span class="l-en">Cross-asset synthesis</span>
        <span class="l-zh">跨资产综合</span>
