.mx5-dlg-cal-date{font-size:11px;font-weight:700;color:var(--ink-3,rgba(255,255,255,.36));margin-bottom:5px;}
[data-theme="light"] .mx5-dlg-cal-date{color:rgba(0,0,0,.42);}
.mx5-dlg-cal-title{font-size:13px;font-weight:700;margin-bottom:6px;line-height:1.3;}
.mx5-dlg-cal-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
