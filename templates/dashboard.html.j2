    {# fired-alerts popup now lives inline in the header (.ms-alerts-wrap above);
       the old right slide-out drawer was retired. This script only handles the
       touch tap-toggle path: close on a jump-link, on Esc, or on a click outside. #}
    <script>
    (function(){
      var cb=document.getElementById('ms-alerts-toggle');
      if(!cb) return;
      document.addEventListener('click',function(e){
        if(e.target.closest('[data-ms-jump]')){ cb.checked=false; return; }
        var wrap=e.target.closest('.ms-alerts-wrap');
        if(cb.checked && !wrap) cb.checked=false;   // tap outside closes the pinned popup
      });
      document.addEventListener('keydown',function(e){
        if(e.key==='Escape'&&cb.checked) cb.checked=false;
      });
    })();
    </script>
