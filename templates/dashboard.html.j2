      {% if L.epu and L.epu.pct is not none %}<span class="muted">EPU {{ L.epu.pct }}{{ t('th pct', '百分位') }}</span>{% endif %}
      {% if L.gpr_threat and L.gpr_threat.pct is not none %}<span class="muted">GPR-{{ t('threat', '威胁') }} {{ L.gpr_threat.pct }}{{ t('th pct', '百分位') }}{% if L.gpr_threat.lean and L.gpr_threat.lean != 'balanced' %} <span title="{{ 'threat-led tends to revert (~3mo); act-led tends to persist · 以威胁为主往往回落（约3个月）；以行动为主则更持久' }}">({{ t('led by', '主导') }} {{ t('threats', '威胁') if L.gpr_threat.lean == 'threat' else t('acts', '行动') }})</span>{% endif %}</span>{% endif %}
