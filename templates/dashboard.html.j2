          {% else %}
            <span class="pl-arm-chip arm-false"><span class="l-en">n/a</span><span class="l-zh">不适用</span></span>
          {% endif %}
        </td>
        <td>
          <span class="l-en">{{ lv.get('watch') or '' }}</span>
          <span class="l-zh">{{ lv.get('watch_zh') or lv.get('watch') or '' }}</span>
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

