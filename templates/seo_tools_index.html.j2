{#=============================================================================
  seo_tools_index.html.j2 — Tools hub ("Free calculators")
  Context (CONTRACT §5): page, rel, site, items (calculator cards from
  calculators.yml: {slug/url_path, title, blurb, cluster}), + a featured
  spreadsheet card (trading journal). page.section == 'tools'.

  Design = macro terminal language. Section headers wear the regime rail; cards
  are hairline/machined panels; each card carries its OWN bespoke glyph (by
  slug, via _estate_glyphs) — no more one-shared-chart-line.
=============================================================================#}
{% extends "seo_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}
{% block body_class %}est-tools{% endblock %}

{% block estate_css %}
  .th-hero{max-width:1120px; margin:22px auto 0; padding:0 24px;}
  .th-tools{max-width:1120px; margin:30px auto 0; padding:0 24px;}

  /* ── regime-rail section header (the estate signature) ─────────────────────── */
  .th-sech{display:flex; align-items:center; gap:11px; margin:0 0 16px;
    padding:0 0 var(--sp-3); border-bottom:1px solid var(--hair-strong);}
  .th-sech::before{content:""; flex:none; align-self:center; width:3px; height:18px; border-radius:2px;
    background:linear-gradient(180deg, var(--rail), color-mix(in srgb,var(--rail) 35%,transparent));}
  .th-sech .sh-n{font-family:var(--num); font-variant-numeric:tabular-nums; font-size:var(--fs-label);
    font-weight:700; letter-spacing:.06em; color:var(--ink-3);}
  .th-sech .sh-t{font-family:var(--font-ui); font-size:calc(var(--fs-h2) + 1px); font-weight:700;
    letter-spacing:-.01em; color:var(--ink-1);}
  html[data-lang="zh"] .th-sech .sh-t{letter-spacing:0;}
  .th-sech .sh-count{margin-left:auto; font-family:var(--num); font-variant-numeric:tabular-nums;
    font-size:var(--fs-label); font-weight:700; letter-spacing:.06em; color:var(--ink-3);
    text-transform:uppercase;}

  /* ── calculator cards — machined hairline panels, one glyph each ──────────── */
  .th-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(288px,1fr)); gap:16px;}
  .th-card{display:flex; flex-direction:column; border:1px solid var(--hair-strong); border-radius:var(--r-lg);
    padding:18px 20px 18px; background:var(--panel); box-shadow:var(--ms); text-decoration:none;
    position:relative; overflow:hidden; transition:transform .2s cubic-bezier(.2,.7,.3,1),border-color .2s,box-shadow .2s;}
  .th-card::before{content:""; position:absolute; left:0; top:0; bottom:0; width:3px;
    background:linear-gradient(180deg, var(--rail), color-mix(in srgb,var(--rail) 22%,transparent));
    opacity:0; transition:opacity .2s;}
  .th-card:hover{transform:translateY(-3px); border-color:color-mix(in srgb,var(--link) 46%,var(--hair-strong));
    box-shadow:0 18px 38px -20px color-mix(in srgb,var(--link) 42%,transparent); text-decoration:none;}
  .th-card:hover::before{opacity:1;}
  .th-card .tc-top{display:flex; align-items:flex-start; justify-content:space-between; gap:12px;}
  .th-card .tc-glyph{flex:none; width:56px; height:36px; margin:-1px -2px 0 0;}
  .th-card .tc-title{font-family:var(--font-ui); font-size:calc(var(--fs-md) + 3px); font-weight:700;
    color:var(--ink-1); line-height:1.24; letter-spacing:-.01em; margin:0;}
  html[data-lang="zh"] .th-card .tc-title{letter-spacing:0;}
  .th-card .tc-blurb{font-family:var(--font-ui); font-size:var(--fs-body); line-height:1.5;
    color:var(--ink-2); margin:8px 0 0;}
  .th-card .tc-go{font-family:var(--num); font-variant-numeric:tabular-nums; font-size:var(--fs-sm);
    letter-spacing:.02em; color:var(--link); margin:16px 0 0 0; display:inline-flex; align-items:center; gap:6px;
    padding-top:12px; border-top:1px solid var(--hair);}
  .th-card .tc-go .arw{transition:transform .2s;}
  .th-card:hover .tc-go .arw{transform:translateX(3px);}

  /* ── featured spreadsheet — a wider machined panel with accent edge ───────── */
  .th-feat{display:grid; grid-template-columns:1fr auto; align-items:center; gap:22px;
    border:1px solid color-mix(in srgb,var(--link) 26%,var(--hair-strong)); border-radius:var(--r-lg);
    border-left:3px solid var(--rail); padding:22px 24px; box-shadow:var(--ms); background:
      radial-gradient(130% 150% at 100% 0%, color-mix(in srgb,var(--link) 9%,transparent), transparent 58%),
      var(--panel);
    text-decoration:none; transition:transform .2s,border-color .2s,box-shadow .2s;}
  .th-feat:hover{transform:translateY(-2px); border-color:var(--link);
    box-shadow:0 18px 40px -22px color-mix(in srgb,var(--link) 45%,transparent); text-decoration:none;}
  .th-feat .ft-k{font-family:var(--num); font-size:var(--fs-label); letter-spacing:.07em;
    text-transform:uppercase; color:var(--link);}
  .th-feat .ft-t{font-family:var(--font-ui); font-size:calc(var(--fs-num-lg) + 1px); font-weight:800;
    color:var(--ink-1); margin:5px 0 0; line-height:1.18; letter-spacing:-.015em;}
  html[data-lang="zh"] .th-feat .ft-t{letter-spacing:0;}
  .th-feat .ft-d{font-family:var(--font-ui); font-size:var(--fs-md); color:var(--ink-2); margin:9px 0 0; max-width:62ch;}
  .th-feat .ft-btn{flex:none; font-family:var(--font-ui);}
  @media (max-width:640px){ .th-feat{grid-template-columns:1fr;} .th-feat .ft-btn{justify-self:start;} }
{% endblock %}

{% block main %}
<div class="th-hero">
  <div class="est-head" style="max-width:none; margin:0; padding:0;">
    <span class="est-kicker">{{ t('Free calculators', '免费计算器') }}</span>
    <h1 class="est-title">{{ t('Trading &amp; risk calculators', '交易与风险计算器') }}</h1>
    <p class="est-dek">{{ t('Calculators that answer one question each, show the math, and never ask you to sign up — position sizing, options, dividends, risk of ruin and more, worked out in front of you.',
       '每款计算器只回答一个问题，把算式摆在你面前，且无需注册——仓位管理、期权、股息、破产风险等等，当场为你算清。') }}</p>
  </div>
</div>

<section class="th-tools" aria-label="Calculators">
  <div class="th-sech">
    <span class="sh-n">01</span>
    <span class="sh-t">{{ t('Calculators', '计算器') }}</span>
    <span class="sh-count">{{ items|length }} {{ t('tools', '款') }}</span>
  </div>
  <div class="th-grid">
    {% for it in items %}
    <a class="th-card" href="{{ rel }}{{ it.url_path.lstrip('/') }}">
      <div class="tc-top">
        <h2 class="tc-title">{{ it.title }}</h2>
        <span class="tc-glyph">{{ glyphs.glyph(it.slug, 'card') }}</span>
      </div>
      <p class="tc-blurb">{{ it.blurb }}</p>
      <span class="tc-go">{{ t('Open calculator', '打开计算器') }} <span class="arw">→</span></span>
    </a>
    {% endfor %}
  </div>
</section>

<section class="th-tools" aria-label="Spreadsheets" style="margin-top:34px;">
  <div class="th-sech">
    <span class="sh-n">02</span>
    <span class="sh-t">{{ t('Spreadsheets', '电子表格') }}</span>
  </div>
  <a class="th-feat" href="{{ rel }}tools/spreadsheets/trading-journal.html">
    <div>
      <span class="ft-k">{{ t('Free download · Excel', '免费下载 · Excel') }}</span>
      <div class="ft-t">{{ t('The Mastermind trading journal', '操盘大脑交易日志') }}</div>
      <p class="ft-d">{{ t('A pre-built spreadsheet that logs every trade and computes your win rate, average R, expectancy and drawdown for you. The habit behind every consistent desk.',
         '一份预制表格，记录每笔交易，自动为你计算胜率、平均 R、期望值与回撤——每个稳定交易台背后的习惯。') }}</p>
    </div>
    <span class="gbtn gbtn-lg ft-btn">{{ t('See the journal', '查看日志') }}</span>
  </a>
</section>
{% endblock %}
