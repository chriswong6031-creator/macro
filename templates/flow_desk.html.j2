{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Group Flow Heatmap &amp; Market Tide · 资金潮汐与板块流量图</title>
{% set seo_title = "China Flow Heatmap & Market Tide — Mastermind" %}{% set seo_desc = "Group-level money flow across China's market — the tide, the leaders and the laggards, updated after each Asia close." %}{% set seo_path = "flow_desk.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(40px,calc((100vw - 1360px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; font-weight:600; letter-spacing:.2px; }
  h3 { font-size:13px; margin:0 0 8px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:14px; }
  .muted { color:var(--muted); } .sm { font-size:12px; } .xs { font-size:11px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .topline { display:flex; flex-wrap:wrap; align-items:baseline; gap:10px 14px; }
  .note { margin:8px 0 0; line-height:1.5; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:290px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  .tabnum { font-variant-numeric:tabular-nums; }
  .lag-tag { display:inline-block; font-size:10px; background:var(--panel2); border:1px solid var(--line); border-radius:5px; padding:1px 6px; color:var(--muted); vertical-align:middle; margin-left:6px; }
  .topline .asof { margin-left:auto; color:var(--muted); font-size:12px; }
  .topline .asof b { font-weight:600; color:var(--text); }
  .topline .asof.is-stale b { color:var(--down); font-weight:700; }
  .soft-tag { display:inline-block; font-size:10px; font-style:italic; color:var(--orange,#f97316); margin-left:4px; }

  /* ── Market Tide ───────────────────────────────────────────────── */
  .tide-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-bottom:14px; }
  .tide-stat { background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:11px 14px; }
  .tide-stat .label { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; margin-bottom:4px; }
  .tide-stat .val { font-size:22px; font-weight:700; font-variant-numeric:tabular-nums; }
  .tide-stat .sub { font-size:11px; color:var(--muted); margin-top:2px; }

  /* Sparkline canvas area */
  .spark-wrap { height:64px; position:relative; margin-top:10px; }
  #fd-spark { width:100%; height:64px; }

  /* ── Cohorts Strip (FL-B) ─────────────────────────────────────── */
  .cohorts-strip { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:0; }
  .cohort-tile { flex:1 1 150px; min-width:140px; max-width:240px; background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:11px 14px; }
  .cohort-tile .c-name { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.3px; color:var(--muted); margin-bottom:4px; }
  .cohort-tile .c-gross { font-size:20px; font-weight:700; font-variant-numeric:tabular-nums; margin-bottom:3px; }
  .cohort-tile .c-chips { display:flex; flex-wrap:wrap; gap:4px; margin-bottom:5px; }
  .cohort-tile .c-detail { font-size:11px; color:var(--muted); line-height:1.4; }
  .cohort-tile .c-coverage { font-size:10px; color:var(--muted); margin-top:4px; }
  /* tone chips for cohorts */
  .ch-call { color:var(--up); border-color:var(--up); }
  .ch-put  { color:var(--down); border-color:var(--down); }
  .ch-bal  { color:var(--muted); border-color:var(--muted); }
  .cohorts-footer { font-size:11px; color:var(--muted); margin-top:7px; font-style:italic; }

  /* ── Sector Heatmap ────────────────────────────────────────────── */
  .hm-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; }
  .hm-cell { background:var(--panel2); border:1px solid var(--line); border-radius:10px; padding:11px 13px; position:relative; }
  .hm-cell .sec-name { font-size:12.5px; font-weight:600; margin-bottom:5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .hm-cell .sec-prem { font-size:19px; font-weight:700; font-variant-numeric:tabular-nums; }
  .hm-cell .sec-meta { display:flex; flex-wrap:wrap; gap:4px 10px; margin-top:5px; font-size:11px; color:var(--muted); }
  .z-badge { display:inline-block; font-size:11px; font-weight:700; padding:2px 7px; border-radius:6px; border:1px solid; }
  .z-hi { color:var(--up); border-color:var(--up); }
  .z-lo { color:var(--down); border-color:var(--down); }
  .z-neu { color:var(--muted); border-color:var(--muted); }
  .z-raw { color:var(--muted); border-color:transparent; font-style:italic; font-weight:400; }
  .tone-chip { display:inline-block; font-size:10px; padding:1px 6px; border-radius:5px; border:1px solid; }
  .tone-pos { color:var(--up); border-color:var(--up); }
  .tone-neg { color:var(--down); border-color:var(--down); }
  .tone-neu { color:var(--muted); border-color:var(--muted); }
  .breadth-bar { width:100%; height:4px; background:var(--line); border-radius:2px; margin-top:5px; }
  .breadth-fill { height:4px; border-radius:2px; background:var(--info,#3b82f6); }
  .breadth-pos { background:var(--up); }
  .breadth-neg { background:var(--down); }

  /* ── Top Movers ────────────────────────────────────────────────── */
  .movers-list { display:flex; flex-direction:column; gap:6px; }
  .mover-row { display:flex; align-items:center; gap:10px; padding:7px 11px; background:var(--panel2); border:1px solid var(--line); border-radius:9px; }
  .mover-row .tk { font-weight:700; font-size:13.5px; min-width:60px; }
  .mover-row .net { font-variant-numeric:tabular-nums; font-size:14px; font-weight:600; min-width:80px; text-align:right; }
  .mover-row .details { font-size:11px; color:var(--muted); flex:1; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
  .mover-row .tone-chip { flex:none; }

  /* ── ETF Tile ─────────────────────────────────────────────────── */
  .etf-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:8px; margin-top:10px; }
  .etf-cell { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:9px 12px; }
  .etf-cell .etf-tk { font-weight:700; font-size:13px; margin-bottom:4px; }
  .etf-cell .etf-flow { font-size:15px; font-weight:600; font-variant-numeric:tabular-nums; }
  .etf-cell .etf-5d { font-size:11px; color:var(--muted); }

  /* ── Flow Score panel (FS-4 Lane C) ───────────────────────────── */
  .fs-badge { display:inline-block; font-size:11px; font-weight:700; padding:2px 8px; border-radius:6px; border:1px solid var(--muted); color:var(--muted); vertical-align:middle; }
  .fs-badge-building { border-color:var(--orange,#f97316); color:var(--orange,#f97316); }
  .fs-n { font-size:22px; font-weight:700; font-variant-numeric:tabular-nums; }
  .fs-sub { font-size:12px; color:var(--muted); margin-top:2px; }
  .fs-receipt { margin-top:10px; }
  .fs-receipt-row { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); padding:3px 0; border-top:1px solid var(--line); }
  .fs-receipt-row .rk { flex:1; }
  .fs-receipt-row .rv { font-variant-numeric:tabular-nums; text-align:right; }

  /* ── Two-col layout on wide ────────────────────────────────────── */
  @media (min-width:900px) {
    .fd-main { display:grid; grid-template-columns:2fr 1fr; gap:14px; align-items:start; }
    .fd-right { display:flex; flex-direction:column; gap:14px; }
  }
  @media (max-width:899px) {
    .fd-right { margin-top:0; }
  }
</style>
</head>
<body class="page-flow-desk">

<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

{% set fd = flow_desk %}
{% set tide = fd.market_tide if fd else {} %}
{% set cohorts = fd.cohorts if fd else [] %}
{% set heatmap = fd.sector_heatmap if fd else [] %}
{% set top = fd.top_movers if fd else [] %}
{% set etf = fd.etf_tile if fd else None %}
{% set fs = fd.flow_score if fd else None %}

<div class="panel">
  <div class="topline">
    <h1>🌊 {{ t('Group Flow Heatmap &amp; Market Tide', '资金潮汐与板块流量图') }}</h1>
    <span class="lag-tag">{{ t('EOD · direction approx', 'EOD · 方向近似') }}</span>
    <span class="asof tabnum" id="fd-asof" data-asof="{{ fd.asof or '' }}">{{ t('data as of', '数据截至') }} <b>{{ fd.asof or '—' }}</b> · {{ t('updated', '更新') }} {{ fd.built or '—' }}</span>
  </div>
  <p class="muted sm note">{{ t(
    "EOD options-flow rollup across 353 names — gross premium magnitude is reliable; net premium direction is SOFT (minute tick-rule signing, not NBBO). Z-scores vs own history (min 20 obs — raw shown below threshold). Tape-flow breadth where ThetaData signed columns are present (auto-upgrades as accrual grows). ETF creation/redemption is a proxy (delta(SO)×NAV), labeled accordingly. No score or rank path; display-tier only.",
    "353只标的的收盘期权资金汇总 — 名义权利金绝对值可信；净权利金方向为软性近似（逐分钟打单规则签名，非NBBO）。Z分数对比自身历史（最低20个观测值 — 低于阈值时显示原始值）。有ThetaData签名列时显示资金广度（随积累自动升级）。ETF申购/赎回为代理指标（delta(SO)×NAV），已标注。不进入评分或排名路径；仅展示层。") }}</p>
</div>

<div class="fd-main">
<div>

<!-- Section 1: Market Tide -->
<div class="panel">
  <h2>{{ t('Market Tide', '市场资金潮汐') }}
    <span class="lag-tag">{{ tide.coverage_note if tide.coverage_note else '' }}</span>
    {{ help(
      'Whole-market gross premium = total $ committed to options across the universe. Net tone is SOFT — net direction from minute tick-rule signing is approximate (bar 0.70 agreement). 0DTE share weighted by gross premium.',
      '全市场名义权利金 = 所有名义期权美元总额。净向近似 — 逐分钟打单签名方向为软性估计（一致率门槛0.70）。0DTE权重按名义权利金加权。'
    ) }}
  </h2>
  <div class="tide-grid">
    <div class="tide-stat">
      <div class="label">{{ t('Gross Premium', '名义权利金') }}</div>
      <div class="val tabnum" id="fd-gross">{% if tide.gross_premium_mn %}${{ "%.0f"|format(tide.gross_premium_mn) }}M{% else %}<span class="muted">—</span>{% endif %}</div>
      <div class="sub">{{ t('total $ committed', '期权总投入金额') }}</div>
    </div>
    <div class="tide-stat">
      <div class="label">{{ t('Net Tone', '净向倾向') }} <span class="soft-tag">{{ t('~soft', '~软') }}</span></div>
      <div class="val tabnum {% if tide.tone == 'pos~' %}pos{% elif tide.tone == 'neg~' %}neg{% else %}muted{% endif %}" id="fd-net">
        {% if tide.net_premium_mn is not none %}
          {% if tide.net_premium_mn > 0 %}+{% endif %}${{ "%.0f"|format(tide.net_premium_mn) }}M
        {% else %}<span class="muted">—</span>{% endif %}
      </div>
      <div class="sub">{{ t('net call vs put premium (approx)', '看涨-看跌净额（近似）') }}</div>
    </div>
    <div class="tide-stat">
      <div class="label">{{ t('0DTE Share', '0DTE占比') }}</div>
      <div class="val tabnum" id="fd-zerodte">
        {% if tide.zerodte_share is not none %}{{ "%.0f"|format(tide.zerodte_share * 100) }}%{% else %}<span class="muted">—</span>{% endif %}
      </div>
      <div class="sub">{{ t('by gross premium weight', '按名义权利金加权') }}</div>
    </div>
    <div class="tide-stat">
      <div class="label">{{ t('Coverage', '覆盖数量') }}</div>
      <div class="val tabnum">{{ tide.n_names if tide.n_names else '—' }}</div>
      <div class="sub">{{ t('names · asof', '标的 · 截至') }} {{ tide.asof if tide.asof else '—' }}</div>
    </div>
  </div>
  {% if tide.spark %}
  <div class="spark-wrap">
    <canvas id="fd-spark" role="img" aria-label="{{ t('Market tide sparkline','市场资金潮汐迷你图') }}"></canvas>
  </div>
  {% endif %}
</div>

<!-- Section 1b: Cohorts Strip (FL-B) — Mag7 / Memory / AI chips / Software -->
{% if cohorts %}
<div class="panel">
  <h2>{{ t('Cohorts', '主题群组') }}
    {{ help(
      'Options flow by thematic cohort — crosses GICS lines. Gross premium is a solid magnitude read. P/C ratio is volume-weighted across covered members. Net tone is SOFT (minute tick-rule direction approx). Percentile vs own cohort history where ≥20 sessions (raw below threshold).',
      '按主题群组分类的期权资金流 — 跨越GICS行业边界。名义权利金为可靠量级指标。P/C为成交量加权。净向为软性近似（逐分钟打单签名）。有≥20个交易日历史时显示百分位（否则显示原始值）。'
    ) }}
  </h2>
  <div class="cohorts-strip">
    {% for c in cohorts %}
    {# P/C tone: call-tilted / put-tilted / balanced (solid magnitude read) #}
    {% set pc_cls = 'ch-call' if c.pc_tone == 'call-tilted' else ('ch-put' if c.pc_tone == 'put-tilted' else 'ch-bal') %}
    {% set net_cls = 'tone-pos' if c.net_tone == 'pos~' else ('tone-neg' if c.net_tone == 'neg~' else 'tone-neu') %}
    <div class="cohort-tile"
         data-tip-en="{{ c.name_en }} — net premium ~{{ '+' if c.net_premium_mn and c.net_premium_mn > 0 else '' }}{{ '%.0f'|format(c.net_premium_mn) if c.net_premium_mn is not none else '—' }}M (direction approx); 0DTE {{ '%.0f'|format(c.zerodte_share * 100) if c.zerodte_share is not none else '—' }}%; {{ c.coverage_label }}; asof {{ c.asof if c.asof else '—' }}"
         data-tip-zh="{{ c.name_zh }} — 净权利金~{{ '+' if c.net_premium_mn and c.net_premium_mn > 0 else '' }}{{ '%.0f'|format(c.net_premium_mn) if c.net_premium_mn is not none else '—' }}M（方向近似）；0DTE {{ '%.0f'|format(c.zerodte_share * 100) if c.zerodte_share is not none else '—' }}%；{{ c.coverage_label }}；截至{{ c.asof if c.asof else '—' }}">
      <div class="c-name">
        <span class="l-en">{{ c.name_en }}</span><span class="l-zh">{{ c.name_zh }}</span>
      </div>
      <div class="c-gross">
        {% if c.gross_premium_mn is not none %}${{ "%.0f"|format(c.gross_premium_mn) }}M{% else %}<span class="muted">—</span>{% endif %}
      </div>
      <div class="c-chips">
        {# P/C chip — solid read #}
        <span class="tone-chip {{ pc_cls }}">
          {% if c.pc_tone == 'call-tilted' %}{{ t('call-tilted', '偏多') }}
          {% elif c.pc_tone == 'put-tilted' %}{{ t('put-tilted', '偏空') }}
          {% else %}{{ t('balanced', '均衡') }}{% endif %}
        </span>
        {# Net tone chip — soft/approx #}
        <span class="tone-chip {{ net_cls }}">
          {% if c.net_tone == 'pos~' %}{{ t('net+~', '净+~') }}
          {% elif c.net_tone == 'neg~' %}{{ t('net-~', '净-~') }}
          {% else %}{{ t('net≈0~', '净≈0~') }}{% endif %}
          <span class="soft-tag">~</span>
        </span>
        {# Percentile badge or raw fallback #}
        {% if c.raw_fallback %}
          <span class="z-badge z-raw">{{ t('raw', '原始') }}</span>
        {% elif c.gross_pct is not none %}
          <span class="z-badge {% if c.gross_pct > 75 %}z-hi{% elif c.gross_pct < 25 %}z-lo{% else %}z-neu{% endif %}">{{ "%.0f"|format(c.gross_pct) }}{{ t('th pct', 'th') }}</span>
        {% endif %}
      </div>
      {# coverage is in hover receipt (data-tip-en/zh); no glance-tier EN-only div #}
    </div>
    {% endfor %}
  </div>
  <div class="cohorts-footer">
    {{ t(
      'Options tape by group — size and call/put mix are solid reads; buy-vs-sell direction is approximate.',
      '按群组的期权流量 — 规模与看涨/看跌比例为可靠指标；买卖方向为近似值。'
    ) }}
  </div>
</div>
{% endif %}

<!-- Section 2: Sector Heatmap -->
<div class="panel">
  <h2>{{ t('Sector Flow Heatmap', '板块资金流热力图') }}
    {{ help(
      'Gross premium rolled up to GICS sector from membership.json. Z-score vs own sector history (trailing sessions, 20-obs minimum; below minimum: raw $). Tone chips are SOFT — net direction is approximate. Tape-flow breadth = fraction of names with positive net_signed_premium where ThetaData tape data is present.',
      '将名义权利金按membership.json归并至GICS行业。Z分数对比行业自身历史（最低20个观测值；不足则显示原始值）。色块标签为软性近似。资金广度=有ThetaData数据时净签名权利金为正的标的占比。'
    ) }}
  </h2>
  {% if heatmap %}
  <div class="hm-grid">
    {% for cell in heatmap %}
    {% set z = cell.premium_z %}
    {% set raw = cell.z_raw_fallback %}
    <div class="hm-cell">
      <div class="sec-name">{{ cell.sector }}</div>
      <div class="sec-prem {% if cell.net_premium_mn and cell.net_premium_mn > 50 %}pos{% elif cell.net_premium_mn and cell.net_premium_mn < -50 %}neg{% endif %}">
        {% if cell.gross_premium_mn is not none %}${{ "%.0f"|format(cell.gross_premium_mn) }}M{% else %}—{% endif %}
      </div>
      <div class="sec-meta">
        {% if raw %}
          <span class="z-badge z-raw">{{ t('raw (<20 obs)', '原始值(<20条)') }}</span>
        {% elif z is not none %}
          <span class="z-badge {% if z > 1 %}z-hi{% elif z < -1 %}z-lo{% else %}z-neu{% endif %}">z {{ "%.1f"|format(z) }}</span>
        {% endif %}
        <span class="tone-chip {% if cell.tone == 'pos~' %}tone-pos{% elif cell.tone == 'neg~' %}tone-neg{% else %}tone-neu{% endif %}">
          {% if cell.tone == 'pos~' %}{{ t('call~', '偏多~') }}{% elif cell.tone == 'neg~' %}{{ t('put~', '偏空~') }}{% else %}{{ t('neutral', '中性') }}{% endif %}
          <span class="soft-tag">{{ t('~soft', '~软') }}</span>
        </span>
        {% if cell.n_names %}<span>{{ cell.n_names }}{{ t(' names', '只标的') }}</span>{% endif %}
        {% if cell.zerodte_share is not none %}<span>0DTE {{ "%.0f"|format(cell.zerodte_share * 100) }}%</span>{% endif %}
      </div>
      {% if cell.tape_breadth is not none %}
      <div class="breadth-bar">
        <div class="breadth-fill {% if cell.tape_breadth > 0.6 %}breadth-pos{% elif cell.tape_breadth < 0.4 %}breadth-neg{% endif %}"
             style="width:{{ "%.0f"|format(cell.tape_breadth * 100) }}%"></div>
      </div>
      <div class="xs muted" style="margin-top:3px">{{ t('tape breadth','资金广度') }} {{ "%.0f"|format(cell.tape_breadth * 100) }}% ({{ cell.tape_n }}{{ t(' names','只') }})</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="muted sm">{{ t('No sector data available.', '暂无板块数据。') }}</p>
  {% endif %}
</div>

</div>{# /fd-main left col #}
<div class="fd-right">

<!-- Section 3: Top Net Impact Board -->
<div class="panel">
  <h2>{{ t('Top Net Impact', '净额最大标的') }}
    <span class="soft-tag">{{ t('~soft direction', '~方向软性') }}</span>
    {{ help(
      'Largest absolute net premium movers today. Direction is SOFT — net call/put balance from minute tick-rule signing is approximate. Ranked by |net premium|, not by direction.',
      '今日净额绝对值最大的标的。方向为软性近似 — 逐分钟打单签名的看涨/看跌净额为近似值。按|净额|排名，非方向。'
    ) }}
  </h2>
  {% if top %}
  <div class="movers-list">
    {% for m in top %}
    <div class="mover-row">
      <div class="tk">{{ m.ticker }}</div>
      <div class="net {% if m.net_premium_mn > 0 %}pos{% elif m.net_premium_mn < 0 %}neg{% endif %}">
        {% if m.net_premium_mn > 0 %}+{% endif %}${{ "%.0f"|format(m.net_premium_mn) }}M
      </div>
      <div class="tone-chip {% if m.tone == 'pos' or m.tone == 'pos~' %}tone-pos{% elif m.tone == 'neg' or m.tone == 'neg~' %}tone-neg{% else %}tone-neu{% endif %}">
        {% if m.tone in ('pos','pos~') %}{{ t('call~','多~') }}{% elif m.tone in ('neg','neg~') %}{{ t('put~','空~') }}{% else %}{{ t('neu','中性') }}{% endif %}
      </div>
      <div class="details muted">
        {% if m.zerodte_share is not none %}0DTE {{ "%.0f"|format(m.zerodte_share * 100) }}%{% endif %}
        {# recurrence badge: shown when recurrence_count is present and > 0 #}
        {% if m.recurrence_count is defined and m.recurrence_count is not none and m.recurrence_count > 0 %}<span class="lag-tag" title="Appeared in top-20 net-impact board {{ m.recurrence_count | int }} times in trailing 10 sessions">×{{ m.recurrence_count | int }}/10d</span>{% endif %}
        {# 0DTE chip: shown when 0DTE share is dominant (zerodte_dominated flag preferred) #}
        {% if m.zerodte_dominated is defined and m.zerodte_dominated %}<span class="lag-tag" style="color:var(--orange,#f97316);border-color:var(--orange,#f97316);" title="0DTE-dominated flow — direction less reliable">0DTE</span>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {# per-source footnote: signing_source legend #}
  <p class="muted xs" style="margin-top:8px;">
    {{ t('Signing source: minute_tick = minute tick-rule (~-soft direction, magnitude reliable). tape = Lee-Ready NBBO tick-rule (higher direction fidelity). Recurrence = Board A membership count (10-session trailing window).', '签署来源：minute_tick=逐分钟打单规则（~方向软性，量级可信）。tape=Lee-Ready NBBO打单规则（方向可信度更高）。出现频率=A板成员计数（10场次滚动窗口）。') }}
  </p>
  {% else %}
  <p class="muted sm">{{ t('No mover data.', '暂无数据。') }}</p>
  {% endif %}
</div>

<!-- Section 4: ETF Flows Tile -->
<div class="panel">
  <h2>{{ t('Sector ETF Flows', '板块ETF资金流') }}
    <span class="lag-tag">{{ t('proxy', '代理指标') }}</span>
    {{ help(
      'Sector SPDR creation/redemption proxy: delta(shares outstanding) × NAV. Source: SSGA fundfinder. Labeled as proxy — not direct market flow measurement. 1D = latest session; 5D/21D = rolling sum.',
      '板块SPDR申购/赎回代理指标：delta(流通份额) × 净资产值。来源：SSGA fundfinder。标注为代理指标 — 非直接市场资金流测量。1D=最新交易日；5D/21D=滚动合计。'
    ) }}
  </h2>
  {% if etf %}
  <p class="xs muted" style="margin-bottom:8px">{{ t('Creation/redemption proxy · SSGA fundfinder · EOD · not direct flow', '申购/赎回代理 · SSGA fundfinder · EOD · 非直接资金流') }}
    {% if etf.asof %} · {{ t('asof','截至') }} {{ etf.asof }}{% endif %}
    {% if etf.depth %} · {{ etf.depth }}{{ t(' sessions history',' 个交易日历史') }}{% endif %}</p>
  <div class="etf-grid">
    {% for fund in (etf.funds if etf.funds else []) %}
    <div class="etf-cell">
      <div class="etf-tk">{{ fund.ticker }}</div>
      <div class="etf-flow {% if fund.flow_1d and fund.flow_1d > 0 %}pos{% elif fund.flow_1d and fund.flow_1d < 0 %}neg{% endif %}">
        {% if fund.flow_1d is not none %}
          {% if fund.flow_1d > 0 %}+{% endif %}${{ "%.0f"|format(fund.flow_1d) }}M
        {% else %}—{% endif %}
      </div>
      <div class="etf-5d muted">
        5D: {% if fund.flow_5d is not none %}{% if fund.flow_5d > 0 %}+{% endif %}${{ "%.0f"|format(fund.flow_5d) }}M{% else %}—{% endif %}
        &nbsp; 21D: {% if fund.flow_21d is not none %}{% if fund.flow_21d > 0 %}+{% endif %}${{ "%.0f"|format(fund.flow_21d) }}M{% else %}—{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="muted sm">{{ t('ETF flow proxy data not yet available.', 'ETF资金流代理数据暂不可用。') }}</p>
  {% endif %}
</div>


<!-- Section 5: Flow Score — FS-4 Lane C (display-only glance panel) -->
{% if fs %}
<div class="panel">
  <h2>{{ t('Options Flow Score', '期权流量评分') }}
    {{ help(
      'Pattern history for options-flow events logged since ' ~ (fs.since if fs.since else '—') ~ '. Events are recorded; a scoring model is being built from this history. This is a heads-up — not a buy or sell signal, and not a measure of direction.',
      '期权流量事件记录始于' ~ (fs.since if fs.since else '—') ~ '。事件已积累；评分模型正在基于该历史构建。此为提示信息——非买入或卖出信号，亦非方向性判断。'
    ) }}
  </h2>
  {% set _fs_n = fs.n_events_total %}
  {% set _fs_since = fs.since %}
  <div style="margin-bottom:10px">
    <span class="fs-badge fs-badge-building">
      <span class="l-en">Building history</span><span class="l-zh">历史积累中</span>
    </span>
  </div>
  <div class="fs-n tabnum">{{ "{:,}".format(_fs_n) if _fs_n else '—' }}</div>
  <div class="fs-sub">
    <span class="l-en">events logged since {{ _fs_since if _fs_since else '—' }}</span>
    <span class="l-zh">事件已记录，始于{{ _fs_since if _fs_since else '—' }}</span>
  </div>
  <p class="muted sm note" style="margin-top:8px">
    <span class="l-en">Not yet a signal — nothing to act on yet. Once enough history is logged, similar past events will be compared to show how often a move of a given size followed. Ignore for now.</span>
    <span class="l-zh">尚未形成信号——暂无需操作。历史积累充分后，将对比历史相似事件，展示特定幅度涨跌的出现频率。目前可忽略。</span>
  </p>
  {% if fs.bucket_receipt %}
  <div class="fs-receipt">
    <div class="xs muted" style="margin-bottom:4px;font-weight:600">
      <span class="l-en">Events by option time-to-expiry</span><span class="l-zh">按到期剩余天数分类</span>
    </div>
    {% for row in fs.bucket_receipt %}
    <div class="fs-receipt-row">
      <span class="rk"><span class="l-en">{{ row.bucket_en }}</span><span class="l-zh">{{ row.bucket_zh }}</span></span>
      <span class="rv">{{ "{:,}".format(row.n) }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {# Future scored branch — rendered only when Lane B has scored events.
     Use 'fs.n_scored_total' via dot access (returns Undefined if key absent,
     which is falsy — safe per Jinja2 Undefined semantics). #}
  {% if fs.n_scored_total %}
  <div style="margin-top:10px">
    <span class="lag-tag">
      <span class="l-en">{{ fs.n_scored_total | int }} recent events reviewed</span>
      <span class="l-zh">{{ fs.n_scored_total | int }}个近期事件已分析</span>
    </span>
    <p class="muted xs" style="margin-top:5px">
      <span class="l-en">Patterns shown are based on similar past events — not a directional prediction.</span>
      <span class="l-zh">所示规律基于历史相似事件——非方向性预测。</span>
    </p>
  </div>
  {% endif %}
</div>
{% endif %}

</div>{# /fd-right #}
</div>{# /fd-main #}

<p class="muted xs" style="margin-top:6px;text-align:center">
  {{ t('Built', '生成于') }} {{ fd.built if fd else '—' }} ·
  {{ t('EOD options flow · gross premium magnitude reliable · net direction ~soft (minute tick-rule) · ETF flows are creation/redemption proxy · no score or rank path',
       'EOD期权资金 · 名义权利金绝对值可信 · 净方向~软性（逐分钟打单） · ETF资金流为申购/赎回代理 · 不进入评分或排名') }}
</p>

<script>
(function(){
  // staleness flag: EOD data older than ~5 days (covers weekend + holiday) turns the header date red
  var el = document.getElementById('fd-asof');
  var d = el ? el.getAttribute('data-asof') : '';
  if (el && d && (Date.now() - new Date(d + 'T21:00:00Z').getTime()) / 864e5 > 5) el.classList.add('is-stale');
})();
(function(){
  // ── Data injected from Python ────────────────────────────────────
  var SPARK = {{ fd.market_tide.spark | tojson if fd and fd.market_tide and fd.market_tide.spark else '[]' }};

  // ── Sparkline canvas ─────────────────────────────────────────────
  var canvas = document.getElementById('fd-spark');
  if (!canvas || !SPARK.length) return;
  var ctx = canvas.getContext('2d');
  var dpr = window.devicePixelRatio || 1;
  function resize() {
    var w = canvas.offsetWidth, h = canvas.offsetHeight;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.scale(dpr, dpr);
  }
  resize();
  var vals = SPARK.map(function(d){ return d.gross_premium_mn || 0; });
  var net  = SPARK.map(function(d){ return d.net_premium_mn || 0; });
  var W = canvas.offsetWidth, H = canvas.offsetHeight;
  var mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals);
  var rng = mx - mn || 1;
  var style = getComputedStyle(document.documentElement);
  var col = style.getPropertyValue('--info') || '#3b82f6';
  var colPos = style.getPropertyValue('--up') || '#22c55e';
  var colNeg = style.getPropertyValue('--down') || '#ef4444';
  var colMut = style.getPropertyValue('--muted') || '#8b93a1';

  function xOf(i){ return (i/(vals.length-1)) * W; }
  function yOf(v){ return H - ((v-mn)/rng) * (H-8) - 4; }

  // Gross premium area
  ctx.beginPath();
  ctx.moveTo(xOf(0), H);
  vals.forEach(function(v,i){ ctx.lineTo(xOf(i), yOf(v)); });
  ctx.lineTo(W, H); ctx.closePath();
  ctx.fillStyle = col + '22'; ctx.fill();
  ctx.beginPath();
  vals.forEach(function(v,i){ i===0 ? ctx.moveTo(xOf(i),yOf(v)) : ctx.lineTo(xOf(i),yOf(v)); });
  ctx.strokeStyle = col; ctx.lineWidth = 1.5; ctx.stroke();

  // Net line (above / below zero → color)
  var netMn = Math.min.apply(null, net), netMx = Math.max.apply(null, net);
  var netRng = Math.max(Math.abs(netMn), Math.abs(netMx)) * 2 || 1;
  function nyOf(v){ return H/2 - (v/netRng)*((H-8)/2); }
  // Zero line
  ctx.beginPath(); ctx.moveTo(0,H/2); ctx.lineTo(W,H/2);
  ctx.strokeStyle = colMut + '44'; ctx.lineWidth = 0.7; ctx.setLineDash([3,3]); ctx.stroke();
  ctx.setLineDash([]);
  // Net dots
  net.forEach(function(v,i){
    ctx.beginPath(); ctx.arc(xOf(i), nyOf(v), 2.5, 0, Math.PI*2);
    ctx.fillStyle = v > 0 ? colPos : (v < 0 ? colNeg : colMut);
    ctx.fill();
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
