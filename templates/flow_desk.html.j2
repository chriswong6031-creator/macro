{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>US Options Flow — Market Tide &amp; Sector Heat · 美股期权资金潮汐</title>
{% set seo_title = "US Options Flow — Market Tide & Sector Heat · Mastermind" %}{% set seo_desc = "Where options money went across the US market today — how heavy the tape ran, which way it leaned, and the sectors and names drawing the biggest bets. End-of-day." %}{% set seo_path = "flow_desk.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  /* ══════════════════════════════════════════════════════════════════════════
     Flow Desk — "The Options Tape". Adopts the macro dashboard design system
     (aurora-glass, mono numerals, rail-headed panels) with its own signature:
     a cyan TIDE gauge. Cyan is the flow/water identity — distinct from macro's
     green while staying in the same aurora-glass family. Direction here is SOFT,
     so the gauge reads MAGNITUDE (solid) and the lean stays a humble chip.
     ══════════════════════════════════════════════════════════════════════════ */
  body.page-flow-desk {
    --num: var(--font-mono, ui-monospace, "SF Mono", SFMono-Regular, "Cascadia Mono",
           "JetBrains Mono", "Roboto Mono", Menlo, Consolas, monospace);
    --ink-1: var(--text);
    --ink-2: color-mix(in srgb, var(--text) 66%, transparent);
    --ink-3: var(--muted);
    --hair: color-mix(in srgb, var(--line) 74%, transparent);
    --tile: color-mix(in srgb, var(--panel2) 84%, var(--panel));
    --r-lg: 16px; --r-md: 11px; --r-sm: 8px;
    --ms: inset 0 1px 0 0 color-mix(in srgb, var(--text) 8%, transparent),
          0 1px 1px rgba(0,0,0,.24), 0 16px 34px -20px rgba(0,0,0,.55);
    /* signature tide accent */
    --flow: #34c2d3; --flow-ink: #5fd3e0; --flow-glow: rgba(52,194,211,.34);
    --flow-dim: rgba(52,194,211,.12);
  }
  html[data-theme="light"] body.page-flow-desk {
    --flow: #0e8aa0; --flow-ink: #0b7286; --flow-glow: rgba(14,138,160,.24);
    --flow-dim: rgba(14,138,160,.10);
    --ms: inset 0 1px 0 0 rgba(255,255,255,.7),
          0 1px 2px rgba(20,30,50,.06), 0 16px 30px -22px rgba(20,30,50,.22);
  }
  * { box-sizing:border-box; }
  body.page-flow-desk {
    background:var(--bg); color:var(--ink-1);
    font:14px/1.55 var(--font-ui,-apple-system,"Segoe UI",Roboto,sans-serif);
    margin:0; padding:18px;
  }
  @media (min-width:1160px){ body.page-flow-desk{ padding:24px max(40px,calc((100vw - 1400px)/2)); } }
  .page-flow-desk a { text-decoration:none; color:inherit; }

  /* ── aurora backdrop — cyan-dominant, tinted by the day's lean ────────────── */
  .fd-aurora { position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
  .fd-aurora > i { position:absolute; border-radius:50%; filter:blur(94px); display:block; }
  .fd-aurora .a1 { width:840px; height:640px; top:-220px; left:-140px;
    background:radial-gradient(ellipse, var(--flow-dim) 0%, transparent 70%); }
  .fd-aurora .a2 { width:720px; height:600px; bottom:-160px; right:-120px;
    background:radial-gradient(ellipse, rgba(99,102,241,.09) 0%, transparent 70%); }
  .fd-aurora .a3 { width:600px; height:520px; top:38%; left:52%; transform:translate(-50%,-50%);
    background:radial-gradient(ellipse, var(--lean-tint,rgba(52,194,211,.07)) 0%, transparent 72%); }
  .page-flow-desk > *:not(.fd-aurora) { position:relative; z-index:1; }
  /* The lift above puts the nav at the same z-index:1 as the hero — so the hero,
     being later in the DOM, painted over the nav's open dropdown menu. Raise the
     nav one level so its flyouts always clear the page content. */
  body.page-flow-desk > .site-nav { z-index:2; }

  /* ── shared type + helpers ────────────────────────────────────────────────── */
  .page-flow-desk h1 { font-size:20px; margin:0; font-weight:800; letter-spacing:-.01em; }
  .page-flow-desk h2 { font-size:16px; margin:0; font-weight:700; letter-spacing:-.01em; line-height:1.3; }
  .num { font-family:var(--num); font-variant-numeric:tabular-nums; }
  .muted { color:var(--ink-3); } .sm { font-size:12px; } .xs { font-size:11px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .eyebrow { font-size:10.5px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; color:var(--ink-3); }

  /* panels — rail-headed like macro */
  .panel { background:var(--panel); border:1px solid var(--hair); border-radius:var(--r-lg);
    padding:18px 20px; box-shadow:var(--ms); }
  .panel > .p-head { display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    margin:0 0 14px; padding:0 0 12px; border-bottom:1px solid var(--hair); }
  .panel > .p-head::before { content:""; flex:none; width:3px; height:17px; border-radius:2px;
    background:linear-gradient(180deg,var(--rail,var(--flow)),color-mix(in srgb,var(--rail,var(--flow)) 30%,transparent)); }
  .p-head .p-sub { margin-left:auto; font-size:11px; color:var(--ink-3); }

  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px;
    border-radius:50%; border:1px solid var(--ink-3); color:var(--ink-3); font-size:10px; font-weight:600;
    cursor:help; position:relative; vertical-align:middle; margin-left:2px; flex:none; }
  .help .tip { display:none; position:absolute; bottom:150%; left:50%; transform:translateX(-50%);
    width:300px; background:var(--panel); border:1px solid var(--line); padding:10px 12px; border-radius:9px;
    z-index:60; font-size:12px; line-height:1.5; color:var(--ink-1); font-weight:400; box-shadow:var(--popover-shadow);
    text-align:left; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  .help:hover::before { content:''; position:absolute; bottom:100%; left:-24px; right:-24px; height:10px; }
  .help:hover .tip { display:block; }

  .lag-tag { display:inline-flex; align-items:center; font-size:10px; background:var(--tile);
    border:1px solid var(--hair); border-radius:6px; padding:2px 7px; color:var(--ink-3);
    letter-spacing:.02em; }
  .asof { color:var(--ink-3); font-size:12px; }
  .asof b { font-weight:700; color:var(--ink-1); }
  .asof.is-stale b { color:var(--down); }

  /* soft-direction honesty marker */
  .softmk { font-size:10px; font-style:italic; color:var(--flow-ink); letter-spacing:.02em; }

  /* ══ HERO SCORECARD ═══════════════════════════════════════════════════════ */
  .fd-hero { position:relative; overflow:hidden;
    background:var(--glass-bg,var(--panel)); border:1px solid var(--glass-brd,var(--hair));
    border-radius:20px; backdrop-filter:var(--glass-blur); box-shadow:var(--glass-shadow,var(--ms));
    display:grid; grid-template-columns:minmax(210px,300px) 1fr; gap:8px; margin-bottom:16px; }
  .fd-hero::before { content:""; position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(135deg, color-mix(in srgb,var(--flow) 8%,transparent) 0%, transparent 46%); }
  @media (max-width:760px){ .fd-hero { grid-template-columns:1fr; } }

  /* left — the tide gauge */
  .fd-gauge-col { padding:26px 20px 22px 26px; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:2px; border-right:1px solid var(--glass-brd,var(--hair)); position:relative; }
  @media (max-width:760px){ .fd-gauge-col { border-right:none; border-bottom:1px solid var(--glass-brd,var(--hair)); } }
  .fd-gauge-wrap { position:relative; width:216px; height:130px; }
  .fd-gauge-svg { width:216px; height:130px; display:block; overflow:visible; }
  .fd-gauge-ring { position:absolute; inset:-6px -6px auto -6px; height:150px; border-radius:150px 150px 0 0;
    pointer-events:none; box-shadow:0 0 34px 2px var(--flow-glow); opacity:0; animation:fdGlow 4s ease-in-out infinite; }
  /* sweep is pure CSS: the element's own (SSR) stroke-dashoffset is the CORRECT
     resting fill, and the keyframe only supplies the intro from empty. If motion
     is off/throttled the base value still shows the right fill — never wrong. */
  .fd-gauge-arc-fill { animation:fdSweep 1.15s cubic-bezier(.22,.9,.26,1.02) both; }
  .fd-gauge-num { position:absolute; left:0; right:0; top:52px; text-align:center; }
  .fd-gauge-num .g-n { font-family:var(--num); font-size:52px; font-weight:800; line-height:.9;
    color:var(--flow-ink); letter-spacing:-.03em; text-shadow:0 0 32px var(--flow-glow); }
  .fd-gauge-num .g-of { font-family:var(--num); font-size:12px; color:var(--ink-3); margin-top:1px; }
  .fd-gauge-band { font-size:12.5px; font-weight:700; color:var(--flow-ink); text-transform:uppercase;
    letter-spacing:.08em; margin-top:4px; }
  .fd-gauge-lbl { font-size:10px; font-weight:700; letter-spacing:.11em; text-transform:uppercase;
    color:var(--ink-3); }

  /* right — the read */
  .fd-read-col { padding:22px 26px 20px 24px; display:flex; flex-direction:column; gap:13px; min-width:0; }
  .fd-read-top { display:flex; align-items:center; gap:9px; flex-wrap:wrap; }
  .fd-stance { display:inline-flex; align-items:center; gap:8px; font-size:23px; font-weight:800;
    letter-spacing:-.015em; color:var(--ink-1); }
  .fd-stance .dot { width:9px; height:9px; border-radius:50%; background:var(--stance-c,var(--flow));
    box-shadow:0 0 9px var(--stance-c,var(--flow)); flex:none; }
  .fd-thesis { font-size:14.5px; line-height:1.5; color:var(--ink-2); max-width:60ch; }
  .fd-thesis b { color:var(--ink-1); font-weight:700; }

  /* vitals */
  .fd-vitals { display:grid; grid-template-columns:repeat(4,minmax(96px,1fr)); gap:12px 16px; margin-top:2px; }
  @media (max-width:520px){ .fd-vitals { grid-template-columns:repeat(2,1fr); } }
  .vital .v-l { font-family:var(--num); font-size:9.5px; font-weight:700; letter-spacing:.09em;
    text-transform:uppercase; color:var(--ink-3); display:flex; align-items:center; gap:4px; }
  .vital .v-n { font-family:var(--num); font-size:21px; font-weight:800; color:var(--ink-1);
    line-height:1.1; margin-top:2px; letter-spacing:-.01em; }
  .vital .v-m { font-size:11px; color:var(--ink-3); line-height:1.35; margin-top:1px; }
  .vital .v-n .u { font-size:12px; font-weight:600; color:var(--ink-3); margin-left:1px; }
  .dod-chip { display:inline-flex; align-items:center; gap:3px; font-family:var(--num); font-size:10px;
    font-weight:700; padding:1px 6px; border-radius:6px; border:1px solid var(--hair); background:var(--tile);
    color:var(--ink-2); vertical-align:middle; }
  .dod-chip.up { color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,var(--hair)); }
  .dod-chip.dn { color:var(--down); border-color:color-mix(in srgb,var(--down) 40%,var(--hair)); }

  /* hero tide sparkline strip */
  .fd-tide-strip { grid-column:1 / -1; border-top:1px solid var(--glass-brd,var(--hair));
    padding:9px 22px 11px; display:flex; align-items:center; gap:12px; }
  .fd-tide-strip .tl { font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
    color:var(--ink-3); white-space:nowrap; }
  .fd-tide-cv { flex:1; height:38px; position:relative; }
  #fd-spark { width:100%; height:38px; display:block; }

  /* callout chips (notable divergences) */
  .fd-callouts { display:flex; flex-wrap:wrap; gap:8px; }
  .callout { display:inline-flex; align-items:center; gap:6px; font-size:11.5px; padding:4px 10px;
    border-radius:8px; border:1px solid color-mix(in srgb,var(--warn) 40%,var(--hair));
    background:color-mix(in srgb,var(--warn) 10%,var(--tile)); color:var(--ink-1); }
  .callout .ci { color:var(--warn); }

  /* ══ HOW THE DAY UNFOLDED — live intraday tide curve (client-fetched) ═══════
     Hidden until the R2 live_flow store returns real minutes; see the fetch block
     at the foot of this file. Direction colours come from --up/--down so the
     Chinese 红涨绿跌 swap applies automatically (theme.css html[data-lang="zh"]). */
  .fdu[hidden] { display:none; }
  .fdu { margin-bottom:16px; }
  .fdu-row { display:grid; grid-template-columns:minmax(150px,210px) 1fr; gap:16px; align-items:center; }
  @media (max-width:640px){ .fdu-row { grid-template-columns:1fr; gap:10px; } }
  .fdu-read { display:flex; flex-direction:column; gap:5px; min-width:0; }
  .fdu-lean { align-self:flex-start; }
  .fdu-net { font-family:var(--num); font-size:21px; font-weight:800; letter-spacing:-.01em;
    color:var(--ink-1); line-height:1.05; }
  .fdu-net.up { color:var(--up); }
  .fdu-net.dn { color:var(--down); }
  .fdu-shape { font-size:11.5px; color:var(--ink-3); line-height:1.35; }
  .fdu-cv { position:relative; height:64px; min-width:0; }
  #fdu-spark { width:100%; height:64px; display:block; }
  .fdu-foot { margin-top:11px; padding-top:10px; border-top:1px solid var(--hair);
    font-size:11px; color:var(--ink-3); line-height:1.45; }

  /* ══ LAYOUT ═══════════════════════════════════════════════════════════════ */
  .fd-grid { display:grid; gap:16px; }
  @media (min-width:940px){ .fd-grid { grid-template-columns:1.55fr 1fr; align-items:start; } }
  .fd-col { display:flex; flex-direction:column; gap:16px; min-width:0; }

  /* ══ SECTOR HEAT — horizontal flow bars (leaders sort to the top) ═══════════ */
  .heat-list { display:flex; flex-direction:column; gap:3px; }
  .heat-row { display:grid; grid-template-columns:118px 1fr auto; align-items:center; gap:12px;
    padding:7px 6px; border-radius:9px; }
  .heat-row:hover { background:var(--tile); }
  .heat-row .h-name { font-size:12.5px; font-weight:600; color:var(--ink-1);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:flex; align-items:center; gap:5px; }
  .heat-row .h-star { color:var(--warn); font-size:11px; }
  .heat-bar { height:19px; border-radius:5px; background:var(--tile); position:relative; overflow:hidden; }
  .heat-bar .fill { position:absolute; inset:0 auto 0 0; width:var(--w,0%); border-radius:5px;
    background:linear-gradient(90deg, color-mix(in srgb,var(--hc,var(--flow)) 42%,transparent),
      color-mix(in srgb,var(--hc,var(--flow)) 88%,transparent));
    transform-origin:left center; animation:fdBar .9s cubic-bezier(.22,.9,.26,1.02) both; }
  .heat-bar .cap { position:absolute; top:0; bottom:0; left:9px; display:flex; align-items:center;
    font-family:var(--num); font-size:11px; font-weight:700; color:var(--ink-1); text-shadow:0 1px 2px rgba(0,0,0,.35); }
  html[data-theme="light"] .heat-bar .cap { text-shadow:0 1px 1px rgba(255,255,255,.6); }
  .heat-row .h-right { display:flex; align-items:center; gap:8px; justify-content:flex-end; }
  .lean-chip { font-size:10px; font-weight:700; padding:1px 7px; border-radius:6px; border:1px solid;
    white-space:nowrap; }
  .lean-buy { color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,transparent);
    background:color-mix(in srgb,var(--up) 11%,transparent); }
  .lean-sell { color:var(--down); border-color:color-mix(in srgb,var(--down) 45%,transparent);
    background:color-mix(in srgb,var(--down) 11%,transparent); }
  .lean-bal { color:var(--ink-3); border-color:var(--hair); background:var(--tile); }
  .heat-row .h-0dte { font-family:var(--num); font-size:10.5px; color:var(--ink-3); min-width:30px; text-align:right; }

  /* ══ COHORTS ══════════════════════════════════════════════════════════════ */
  .coh-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
  @media (max-width:640px){ .coh-strip { grid-template-columns:repeat(2,1fr); } }
  .coh-tile { background:var(--tile); border:1px solid var(--hair); border-radius:11px; padding:12px 13px; }
  .coh-tile .c-nm { font-size:12px; font-weight:700; color:var(--ink-1); margin-bottom:5px; }
  .coh-tile .c-gr { font-family:var(--num); font-size:18px; font-weight:800; color:var(--ink-1); letter-spacing:-.01em; }
  .coh-tile .c-gr .u { font-size:11px; font-weight:600; color:var(--ink-3); }
  .coh-tile .c-chips { display:flex; flex-wrap:wrap; gap:4px; margin-top:7px; }
  .coh-tile .c-cov { font-size:10px; color:var(--ink-3); margin-top:6px; }
  .pc-chip { font-size:10px; font-weight:700; padding:1px 6px; border-radius:5px; border:1px solid; }
  .pc-call { color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,transparent); }
  .pc-put { color:var(--down); border-color:color-mix(in srgb,var(--down) 45%,transparent); }
  .pc-bal { color:var(--ink-3); border-color:var(--hair); }

  /* ══ BIGGEST BETS (movers) ════════════════════════════════════════════════ */
  .mv-list { display:flex; flex-direction:column; gap:5px; }
  .mv-row { display:grid; grid-template-columns:52px 1fr auto; align-items:center; gap:9px;
    padding:8px 10px; background:var(--tile); border:1px solid var(--hair); border-radius:9px; }
  .mv-row .mv-tk { font-family:var(--num); font-weight:800; font-size:13px; color:var(--ink-1); }
  .mv-row .mv-mid { display:flex; align-items:center; gap:7px; min-width:0; }
  .mv-row .mv-net { font-family:var(--num); font-size:14px; font-weight:800; }
  .mv-tone { font-size:9.5px; font-weight:700; padding:1px 6px; border-radius:5px; border:1px solid; white-space:nowrap; }
  .mv-meta { display:flex; align-items:center; gap:5px; justify-content:flex-end; }
  .mini-tag { font-family:var(--num); font-size:9.5px; padding:1px 5px; border-radius:5px; border:1px solid var(--hair);
    color:var(--ink-3); background:var(--panel); white-space:nowrap; }
  .mini-tag.zd { color:var(--orange); border-color:color-mix(in srgb,var(--orange) 45%,transparent); }

  /* ══ ETF FLOWS ════════════════════════════════════════════════════════════ */
  .etf-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(112px,1fr)); gap:8px; }
  .etf-cell { background:var(--tile); border:1px solid var(--hair); border-radius:9px; padding:9px 11px; }
  .etf-cell .e-tk { font-family:var(--num); font-weight:800; font-size:12px; color:var(--ink-1); margin-bottom:3px; }
  .etf-cell .e-1d { font-family:var(--num); font-size:14px; font-weight:800; }
  .etf-cell .e-hist { font-family:var(--num); font-size:9.5px; color:var(--ink-3); margin-top:2px; }

  /* ══ footer receipt (demoted flow-score) ══════════════════════════════════ */
  .fd-foot { margin-top:16px; display:flex; flex-direction:column; gap:8px; }
  .fd-receipt { display:flex; align-items:center; gap:9px; flex-wrap:wrap; font-size:11.5px; color:var(--ink-3);
    padding:10px 14px; border:1px dashed var(--hair); border-radius:11px; background:color-mix(in srgb,var(--panel) 55%,transparent); }
  .fd-receipt .rk { font-weight:700; color:var(--ink-2); }
  .fd-disc { font-size:11px; color:var(--ink-3); text-align:center; line-height:1.5; }

  /* reveal stagger */
  .rise { opacity:0; animation:fdRise .5s cubic-bezier(.22,.9,.26,1.02) forwards; }

  @keyframes fdRise { to { opacity:1; transform:none; } }
  .rise { transform:translateY(9px); }
  @keyframes fdGlow { 0%,100%{ opacity:.28; } 50%{ opacity:.6; } }
  @keyframes fdBar { from { transform:scaleX(0); } to { transform:scaleX(1); } }
  @keyframes fdSweep { from { stroke-dashoffset:175.93; } }

  @media (prefers-reduced-motion: reduce) {
    body.page-flow-desk *, body.page-flow-desk *::before, body.page-flow-desk *::after {
      animation:none !important; transition:none !important; }
    .rise { opacity:1; transform:none; }
    .fd-gauge-ring { opacity:.4; }
  }
</style>
</head>
<body class="page-flow-desk">
<div class="fd-aurora" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i></div>

{% include "_site_nav.html.j2" %}

{# OEU M-CMD — this desk's close read is now the Daily Brief of the Options workspace. #}
{% set oew_mode = 'brief' %}{% include "_options_workspace_banner.html.j2" %}

{% set fd = flow_desk %}
{% set read = fd.read if fd else None %}
{% set tide = fd.market_tide if fd else {} %}
{% set cohorts = fd.cohorts if fd else [] %}
{% set cohorts_any_covered = cohorts | map(attribute='n_members_covered') | select | list | length > 0 %}
{% set heatmap = fd.sector_heatmap if fd else [] %}
{% set top = fd.top_movers if fd else [] %}
{% set etf = fd.etf_tile if fd else None %}
{% set fs = fd.flow_score if fd else None %}

{# ── gross $ formatter: >=1000M → $X.XB else $XM ─────────────────────────────── #}
{% macro dollars(mn) -%}
{%- if mn is none -%}—{%- elif mn|abs >= 1000 -%}${{ "%.1f"|format(mn/1000) }}B{%- else -%}${{ "%.0f"|format(mn) }}M{%- endif -%}
{%- endmacro %}

{# ── stance + intensity + lean copy maps (plain words, both languages) ───────── #}
{% set _stance_en = {'watch':"Watch — don't chase", 'stand_aside':'Stand aside'} %}
{% set _stance_zh = {'watch':'观望 — 别追高', 'stand_aside':'按兵不动'} %}
{% set _stance_col = {'watch':'var(--flow)', 'stand_aside':'var(--ink-3)'} %}
{% set _band_en = {'heavy':'Heavy','busy':'Busy','average':'Average','light':'Light','quiet':'Quiet','building':'Building'} %}
{% set _band_zh = {'heavy':'汹涌','busy':'活跃','average':'中等','light':'清淡','quiet':'冷清','building':'积累中'} %}

<div class="fd-topline" style="display:flex;align-items:baseline;gap:10px 14px;flex-wrap:wrap;margin-bottom:14px">
  <h1>🌊 {{ t('US Options Flow', '美股期权资金流') }}</h1>
  <span class="lag-tag">{{ t('End of day', '收盘数据') }}</span>
  {{ help(
    'A once-a-day rollup of the whole US options tape (~370 names), built after the close. SIZE — how much money changed hands — is a solid read. DIRECTION (who was buying vs selling) is approximate, marked with ~, and this page never issues a buy or sell. Sector and theme groups roll up from membership; ETF flows are a creation/redemption proxy.',
    '每日收盘后对全美期权盘面（约370只标的）的一次汇总。规模（成交金额）为可靠读数；方向（买方或卖方）为近似值，以~标注；本页从不发出买卖信号。板块与主题群组按成分归并；ETF资金流为申购/赎回代理指标。'
  ) }}
  <span class="asof num" id="fd-asof" data-asof="{{ fd.asof or '' }}" style="margin-left:auto">
    {{ t('as of', '截至') }} <b>{{ fd.asof or '—' }}</b> · {{ t('updated', '更新') }} {{ fd.built or '—' }}</span>
</div>

{# ══════════════════════════════════════════════════════════════════════════════
   HERO SCORECARD — the day's read in one glance
   ══════════════════════════════════════════════════════════════════════════════ #}
{% if read %}
{% set score = read.intensity_score %}
{% set ARC = 175.93 %}
{% set fill = (score / 100.0 * ARC) if score is not none else (ARC * 0.5) %}
{% set lean = read.lean_key %}
{% set lean_tint = 'rgba(69,184,115,.07)' if lean=='buyers' else ('rgba(224,100,100,.07)' if lean=='sellers' else 'rgba(52,194,211,.07)') %}
<section class="fd-hero" style="--lean-tint:{{ lean_tint }}">

  <!-- Tide gauge -->
  <div class="fd-gauge-col">
    <div class="fd-gauge-lbl">{{ t('Tape intensity', '盘面强度') }}</div>
    <div class="fd-gauge-wrap">
      <div class="fd-gauge-ring"></div>
      <svg class="fd-gauge-svg" viewBox="0 -6 140 104" fill="none" role="img"
           aria-label="Options tape intensity gauge">
        <defs>
          <linearGradient id="fdArcG" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--flow)" stop-opacity=".55"/>
            <stop offset="1" stop-color="var(--flow-ink)"/>
          </linearGradient>
        </defs>
        <!-- track -->
        <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="color-mix(in srgb,var(--ink-3) 22%,transparent)"
              stroke-width="9" stroke-linecap="round"/>
        <!-- fill -->
        <path id="fd-gauge-arc" class="fd-gauge-arc-fill" d="M 14 75 A 56 56 0 0 1 126 75"
              stroke="url(#fdArcG)" stroke-width="9" stroke-linecap="round"
              stroke-dasharray="{{ ARC }}" stroke-dashoffset="{{ (ARC - fill)|round(2) }}"
              data-fill="{{ fill|round(2) }}" data-arc="{{ ARC }}"/>
        <!-- ticks at 0 / 50 / 100 -->
        <g stroke="color-mix(in srgb,var(--ink-3) 30%,transparent)" stroke-width="1.1">
          <line x1="70" y1="20" x2="70" y2="26" transform="rotate(-90 70 75)"/>
          <line x1="70" y1="20" x2="70" y2="26" transform="rotate(0 70 75)"/>
          <line x1="70" y1="20" x2="70" y2="26" transform="rotate(90 70 75)"/>
        </g>
        <text x="12" y="90" fill="var(--ink-3)" font-size="9" text-anchor="middle" opacity=".7">0</text>
        <text x="128" y="90" fill="var(--ink-3)" font-size="9" text-anchor="middle" opacity=".7">100</text>
      </svg>
      <div class="fd-gauge-num">
        {% if score is not none %}
        <div class="g-n num" id="fd-score" data-to="{{ score }}">{{ score }}</div>
        {% else %}
        <div class="g-n num" style="font-size:26px" id="fd-score">—</div>
        {% endif %}
        <div class="g-of num">/ 100</div>
      </div>
    </div>
    <div class="fd-gauge-band">
      <span class="l-en">{{ _band_en.get(read.intensity_key,'') }}</span><span class="l-zh">{{ _band_zh.get(read.intensity_key,'') }}</span>
    </div>
  </div>

  <!-- The read -->
  <div class="fd-read-col">
    <div class="eyebrow">{{ t("Today's options tape", '今日期权盘面') }} · {{ t('after the close','收盘后') }}</div>
    {% set stance = read.stance_key %}
    <div class="fd-read-top">
      <span class="fd-stance" style="--stance-c:{{ _stance_col.get(stance,'var(--flow)') }}">
        <span class="dot"></span>
        <span class="l-en">{{ _stance_en.get(stance,'Watch') }}</span><span class="l-zh">{{ _stance_zh.get(stance,'观望') }}</span>
      </span>
    </div>

    {# thesis — assembled from honest fragments #}
    {% set _ig = {'heavy':'Options tape is running hot','busy':'Options tape is busy','average':'Roughly an average day for options','light':'The options tape is light','quiet':'The options tape is quiet','building':'Still building history'} %}
    {% set _iz = {'heavy':'期权盘面火热','busy':'期权盘面活跃','average':'期权资金大致中等','light':'期权资金清淡','quiet':'期权资金冷清','building':'历史仍在积累'} %}
    {% set _dg = {'heavier':', heavier than the day before','lighter':', easing off yesterday','steady':''} %}
    {% set _dz = {'heavier':'，较前一日增强','lighter':'，较昨日回落','steady':''} %}
    {% set _lg = {'buyers':' — buyers had a slight edge','sellers':' — sellers leaned in','balanced':' — buyers and sellers evenly matched'} %}
    {% set _lz = {'buyers':' — 略偏买方','sellers':' — 略偏卖方','balanced':' — 买卖大致均衡'} %}
    <p class="fd-thesis">
      <span class="l-en">{{ _ig.get(read.intensity_key,'') }}{{ _dg.get(read.dod_key,'') }}{{ _lg.get(read.lean_key,'') }}<span class="softmk"> ~approx</span>. A heads-up — <b>not a buy signal</b>.</span>
      <span class="l-zh">{{ _iz.get(read.intensity_key,'') }}{{ _dz.get(read.dod_key,'') }}{{ _lz.get(read.lean_key,'') }}<span class="softmk"> ~近似</span>。仅为提示，<b>非买入信号</b>。</span>
    </p>

    <!-- vitals -->
    <div class="fd-vitals">
      <div class="vital">
        <div class="v-l">{{ t('Options traded','期权成交额') }}</div>
        <div class="v-n">{{ dollars(read.gross_premium_mn) }}
          {% if read.dod_pct is not none %}<span class="dod-chip {{ 'up' if read.dod_pct>0 else 'dn' if read.dod_pct<0 else '' }}">{{ '+' if read.dod_pct>0 else '' }}{{ read.dod_pct|int }}%</span>{% endif %}</div>
        <div class="v-m">{{ t('premium, all names','全部标的权利金') }}</div>
      </div>
      <div class="vital">
        <div class="v-l">{{ t('Tape lean','盘面倾向') }} <span class="softmk">~</span></div>
        <div class="v-n {{ 'pos' if lean=='buyers' else 'neg' if lean=='sellers' else '' }}">
          {% if read.lean_breadth_pct is not none %}{{ read.lean_breadth_pct }}%{% else %}—{% endif %}</div>
        <div class="v-m">
          {% if lean=='buyers' %}{{ t('names bought~','标的偏买~') }}{% elif lean=='sellers' %}{{ t('names sold~','标的偏卖~') }}{% else %}{{ t('evenly split~','买卖均衡~') }}{% endif %}</div>
      </div>
      <div class="vital">
        <div class="v-l">{{ t('Same-day bets','当日到期') }}</div>
        <div class="v-n">{% if read.zerodte_share is not none %}{{ (read.zerodte_share*100)|int }}%{% else %}—{% endif %}</div>
        <div class="v-m">{{ t('0DTE share','0DTE占比') }}</div>
      </div>
      <div class="vital">
        <div class="v-l">{{ t('Names covered','覆盖标的') }}</div>
        <div class="v-n">{{ read.n_names if read.n_names else '—' }}</div>
        <div class="v-m">{{ t('in the tape','纳入盘面') }}</div>
      </div>
    </div>

    {# notable divergences — only when present #}
    {% if read.callouts %}
    <div class="fd-callouts">
      {% for c in read.callouts %}
        {% if c.key == 'hedged_cohort' %}
        <span class="callout"><span class="ci">⚑</span>
          <span class="l-en"><b>{{ c.name_en }}</b> leaning to puts while the tape buys — hedged</span>
          <span class="l-zh"><b>{{ c.name_zh }}</b>在大盘偏买时偏向看跌 — 对冲</span></span>
        {% elif c.key == 'crowded_sector' %}
        <span class="callout"><span class="ci">⚑</span>
          <span class="l-en"><b>{{ c.sector }}</b> flow well above its own norm</span>
          <span class="l-zh"><b>{{ c.sector }}</b>资金远高于自身常态</span></span>
        {% elif c.key == 'quiet_sector' %}
        <span class="callout"><span class="ci">·</span>
          <span class="l-en"><b>{{ c.sector }}</b> unusually quiet vs its norm</span>
          <span class="l-zh"><b>{{ c.sector }}</b>较自身常态异常清淡</span></span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <!-- 30-session tide sparkline -->
  {% if tide.spark %}
  <div class="fd-tide-strip">
    <span class="tl">{{ t('30-session tide','近30日潮汐') }}</span>
    <div class="fd-tide-cv"><canvas id="fd-spark" role="img" aria-label="Options premium over the last 30 sessions"></canvas></div>
  </div>
  {% endif %}
</section>
{% endif %}

{# ══════════════════════════════════════════════════════════════════════════════
   HOW THE DAY UNFOLDED — the completed session's cumulative ~net-premium curve.
   This page is baked after the close, so the intraday SHAPE exists only in the live
   tape store. Fetched client-side from R2 via window.DATA_BASE (intraday_flow
   precedent); the panel ships hidden and reveals itself only when real minutes come
   back. No data → it stays hidden and the page reads exactly as it did before.
   ══════════════════════════════════════════════════════════════════════════════ #}
<section class="panel fdu" id="fd-unfold" hidden style="--rail:var(--flow)">
  <div class="p-head">
    <h2>{{ t('How the day unfolded','当日资金流演变') }}</h2>
    {{ help(
      'The finished session minute by minute: running net call premium minus net put premium, both signed from the tape (~approximate). Above the line means calls were bought and puts sold on balance; below the line, the reverse. Read the shape, not the level — where the lean built, faded, or turned. Source is the live tape store, refreshed about every 2 minutes while the market is open.',
      '已收盘交易时段的逐分钟走势：累计净看涨权利金减净看跌权利金，方向由盘面推断（~近似）。在零轴上方表示整体买入看涨、卖出看跌；下方则相反。请看形态而非绝对水平 — 关注倾向在何时加强、回落或转向。数据来自实时盘面存储，开市期间约每2分钟更新一次。'
    ) }}
    <span class="p-sub num" id="fdu-asof"></span>
  </div>
  <div class="fdu-row">
    <div class="fdu-read">
      <span class="lean-chip fdu-lean" id="fdu-lean"></span>
      <div class="fdu-net" id="fdu-net"></div>
      <div class="fdu-shape" id="fdu-shape"></div>
    </div>
    <div class="fdu-cv">
      <canvas id="fdu-spark" role="img"
              aria-label="Cumulative net options premium through the completed session"></canvas>
    </div>
  </div>
  <div class="fdu-foot">
    <span class="l-en">Shape only. Direction is approximate<span class="softmk"> ~</span> and this is
      <b>never a buy or sell signal</b>. Watch — don't chase.</span>
    <span class="l-zh">仅供观察形态。方向为近似值<span class="softmk"> ~</span>，
      <b>从不构成买卖信号</b>。观望 — 别追高。</span>
  </div>
</section>

{# ══════════════════════════════════════════════════════════════════════════════
   BODY — two columns
   ══════════════════════════════════════════════════════════════════════════════ #}
<div class="fd-grid">
<div class="fd-col">

  <!-- Sector heat -->
  <div class="panel rise" style="--rail:var(--flow)">
    <div class="p-head">
      <h2>{{ t('Where the money went','资金流向哪里') }}</h2>
      {{ help(
        'Every US sector, sorted by how much options premium it drew today — the widest bar leads. Bar colour is the buy/sell lean from tape breadth where available (green = more buying, red = more selling); it is approximate. A ⚑ marks a sector whose flow is more than one standard deviation from its own recent norm. Bar width is share of the day\'s biggest sector.',
        '按今日期权权利金规模排序的各美股板块 — 条形越宽越靠前。颜色为买卖倾向（绿=偏买，红=偏卖），为近似值。⚑标记资金偏离自身常态逾一个标准差的板块。条形宽度为占当日最大板块的比例。'
      ) }}
      <span class="p-sub num">{{ t('by premium','按权利金') }}</span>
    </div>
    {% if heatmap %}
    {% set maxg = (heatmap[0].gross_premium_mn or 1) if heatmap else 1 %}
    <div class="heat-list">
      {% for cell in heatmap %}
      {% set g = cell.gross_premium_mn or 0 %}
      {% set w = (g / maxg * 100) if maxg else 0 %}
      {% set tb = cell.tape_breadth %}
      {% set hc = 'var(--up)' if (tb is not none and tb>0.58) else ('var(--down)' if (tb is not none and tb<0.42) else 'var(--flow)') %}
      {% set notable = cell.premium_z is not none and (cell.premium_z|abs) >= 1.0 %}
      <div class="heat-row" data-tip-en="{{ cell.sector }} — {{ dollars(cell.gross_premium_mn) }} premium across {{ cell.n_names }} names; {% if cell.tape_breadth is not none %}{{ (cell.tape_breadth*100)|int }}% of tape-covered names net buying{% else %}tape breadth n/a{% endif %}; net ~{{ '+' if cell.net_premium_mn and cell.net_premium_mn>0 else '' }}{{ '%.0f'|format(cell.net_premium_mn) if cell.net_premium_mn is not none else '—' }}M (approx){% if cell.premium_z is not none %}; {{ '%.1f'|format(cell.premium_z) }}σ vs own history{% endif %}"
           data-tip-zh="{{ cell.sector }} — {{ dollars(cell.gross_premium_mn) }}权利金，{{ cell.n_names }}只标的；{% if cell.tape_breadth is not none %}{{ (cell.tape_breadth*100)|int }}%的可测标的净买入{% else %}广度不可用{% endif %}；净~{{ '+' if cell.net_premium_mn and cell.net_premium_mn>0 else '' }}{{ '%.0f'|format(cell.net_premium_mn) if cell.net_premium_mn is not none else '—' }}M（近似）{% if cell.premium_z is not none %}；较自身历史{{ '%.1f'|format(cell.premium_z) }}σ{% endif %}">
        <div class="h-name">{% if notable %}<span class="h-star">⚑</span>{% endif %}{{ cell.sector }}</div>
        <div class="heat-bar">
          <div class="fill" style="--w:{{ w|round(1) }}%;--hc:{{ hc }};animation-delay:{{ loop.index0 * 45 }}ms"></div>
          <div class="cap num">{{ dollars(cell.gross_premium_mn) }}</div>
        </div>
        <div class="h-right">
          <span class="lean-chip {{ 'lean-buy' if (tb is not none and tb>0.58) else 'lean-sell' if (tb is not none and tb<0.42) else 'lean-bal' }}">
            {% if tb is not none and tb>0.58 %}{{ t('buying~','偏买~') }}{% elif tb is not none and tb<0.42 %}{{ t('selling~','偏卖~') }}{% else %}{{ t('mixed','中性') }}{% endif %}
          </span>
          <span class="h-0dte num">{% if cell.zerodte_share %}{{ (cell.zerodte_share*100)|int }}%<span class="muted xs"> 0d</span>{% endif %}</span>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted sm">{{ t('No sector data yet — check back after the next close.','暂无板块数据 — 下次收盘后再看。') }}</p>
    {% endif %}
  </div>

  <!-- Theme groups (cohorts) -->
  {% if cohorts %}
  <div class="panel rise" style="--rail:var(--flow);animation-delay:.08s">
    <div class="p-head">
      <h2>{{ t('Theme groups','主题群组') }}</h2>
      {{ help(
        'Four themes that cross sector lines — Mag 7, Memory, AI chips, AI software. Premium size and the call/put tilt (from volume) are solid reads; the net-buy/sell chip is approximate (~). Watch for a group leaning the opposite way to the rest — that divergence is the signal these groups exist to surface.',
        '四个跨越行业边界的主题 — 七巨头、存储、AI芯片、AI软件。权利金规模与看涨/看跌倾向（按成交量）为可靠读数；净买卖标签为近似（~）。留意与大盘反向的群组 — 这种背离正是设立这些群组的意义所在。'
      ) }}
    </div>
    {# Whole-panel null: when no group has a single covered member the four tiles carry
       nothing but dashes, so say so once in plain words instead of four times. #}
    {% if not cohorts_any_covered %}
    <p class="muted sm">{{ t('No theme-group data yet — check back after the next close.','暂无主题群组数据 — 下次收盘后再看。') }}</p>
    {% else %}
    <div class="coh-strip">
      {% for c in cohorts %}
      <div class="coh-tile" data-tip-en="{{ c.name_en }} — {{ c.n_members_covered }}/{{ c.n_members }} members covered; P/C {{ '%.2f'|format(c.pc_ratio) if c.pc_ratio is not none else '—' }}; net ~{{ '+' if c.net_premium_mn and c.net_premium_mn>0 else '' }}{{ '%.0f'|format(c.net_premium_mn) if c.net_premium_mn is not none else '—' }}M (approx); 0DTE {{ (c.zerodte_share*100)|int if c.zerodte_share is not none else '—' }}%"
           data-tip-zh="{{ c.name_zh }} — 覆盖{{ c.n_members_covered }}/{{ c.n_members }}只；看跌看涨比 {{ '%.2f'|format(c.pc_ratio) if c.pc_ratio is not none else '—' }}；净~{{ '+' if c.net_premium_mn and c.net_premium_mn>0 else '' }}{{ '%.0f'|format(c.net_premium_mn) if c.net_premium_mn is not none else '—' }}M（近似）；0DTE {{ (c.zerodte_share*100)|int if c.zerodte_share is not none else '—' }}%">
        <div class="c-nm"><span class="l-en">{{ c.name_en }}</span><span class="l-zh">{{ c.name_zh }}</span></div>
        <div class="c-gr num">{{ dollars(c.gross_premium_mn) }}</div>
        <div class="c-chips">
          {# A tilt chip is a read of the P/C ratio — with no ratio there is no tilt, so
             the chip is withheld rather than defaulting to "balanced". #}
          {% if c.pc_ratio is not none %}
          <span class="pc-chip {{ 'pc-call' if c.pc_tone=='call-tilted' else 'pc-put' if c.pc_tone=='put-tilted' else 'pc-bal' }}">
            {% if c.pc_tone=='call-tilted' %}{{ t('calls','偏看涨') }}{% elif c.pc_tone=='put-tilted' %}{{ t('puts','偏看跌') }}{% else %}{{ t('balanced','均衡') }}{% endif %}
          </span>
          {% endif %}
          {% if c.net_premium_mn is not none %}
          <span class="pc-chip {{ 'pc-call' if c.net_tone=='pos~' else 'pc-put' if c.net_tone=='neg~' else 'pc-bal' }}">
            {% if c.net_tone=='pos~' %}{{ t('net buy~','净买~') }}{% elif c.net_tone=='neg~' %}{{ t('net sell~','净卖~') }}{% else %}{{ t('flat~','持平~') }}{% endif %}
          </span>
          {% endif %}
        </div>
        <div class="c-cov">{% if c.n_members_covered %}{{ c.n_members_covered }}/{{ c.n_members }} {{ t('covered','覆盖') }}{% else %}{{ t('no data today','今日无数据') }}{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}

</div>{# /left col #}

<div class="fd-col">

  <!-- Biggest bets -->
  <div class="panel rise" style="--rail:var(--warn);animation-delay:.04s">
    <div class="p-head">
      <h2>{{ t('Biggest bets today','今日最大押注') }} <span class="softmk">~{{ t('direction approx','方向近似') }}</span></h2>
      {{ help(
        'The names with the largest net options money today, biggest first. The call~/put~ chip is the approximate direction (from tick-rule signing); size is reliable. ×N/10d = how many of the last 10 sessions this name was among the biggest movers. 0DTE = same-day-expiry-dominated, so its direction is even less reliable.',
        '今日净期权资金最大的标的，从大到小。看涨~/看跌~标签为近似方向（打单规则签名）；规模可靠。×N/10d=近10个交易日中该标的入选最大异动的次数。0DTE=以当日到期为主，方向更不可靠。'
      ) }}
    </div>
    {% if top %}
    <div class="mv-list">
      {% for m in top %}
      {% set mdir = 'pos' if m.net_premium_mn>0 else ('neg' if m.net_premium_mn<0 else 'neu') %}
      <div class="mv-row" {% if m.verdict %}data-tip-en="{{ m.verdict }}" data-tip-zh="{{ m.verdict }}"{% endif %}>
        <div class="mv-tk">{{ m.ticker }}</div>
        <div class="mv-mid">
          <span class="mv-net {{ 'pos' if mdir=='pos' else 'neg' if mdir=='neg' else '' }}">{{ '+' if mdir=='pos' else '−' if mdir=='neg' else '' }}{{ dollars(m.net_premium_mn|abs) }}</span>
          <span class="mv-tone {{ 'lean-buy' if mdir=='pos' else 'lean-sell' if mdir=='neg' else 'lean-bal' }}">
            {% if mdir=='pos' %}{{ t('calls~','看涨~') }}{% elif mdir=='neg' %}{{ t('puts~','看跌~') }}{% else %}{{ t('flat~','持平~') }}{% endif %}
          </span>
        </div>
        <div class="mv-meta">
          {% if m.zerodte_dominated %}<span class="mini-tag zd">0DTE</span>
          {% elif m.zerodte_share is not none and m.zerodte_share>0 %}<span class="mini-tag">{{ (m.zerodte_share*100)|int }}% 0d</span>{% endif %}
          {% if m.recurrence_count is not none and m.recurrence_count>0 %}<span class="mini-tag">×{{ m.recurrence_count|int }}/10d</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted sm">{{ t('No standout names today.','今日无突出标的。') }}</p>
    {% endif %}
  </div>

  <!-- Sector ETF flows -->
  <div class="panel rise" style="--rail:var(--info);animation-delay:.12s">
    <div class="p-head">
      <h2>{{ t('Sector ETF flows','板块ETF资金流') }} <span class="lag-tag">{{ t('proxy','代理') }}</span></h2>
      {{ help(
        'Money moving in and out of the 11 sector SPDR ETFs, estimated from the daily change in shares outstanding × NAV. This is a proxy, not a direct flow measurement. Green = money in, red = money out. 5D / 21D are the rolling sums.',
        '11只板块SPDR ETF的资金进出，按流通份额日变化×净值估算。此为代理指标，非直接资金流。绿=流入，红=流出。5D/21D为滚动合计。'
      ) }}
    </div>
    {% if etf and etf.funds %}
    <p class="xs muted" style="margin:-4px 0 10px">{{ t('Creation / redemption proxy · SSGA','申购/赎回代理 · SSGA') }}{% if etf.depth %} · {{ etf.depth }}{{ t('-session history','个交易日') }}{% endif %}</p>
    <div class="etf-grid">
      {% for fund in (etf.funds|sort(attribute='flow_1d', reverse=true)) %}
      <div class="etf-cell">
        <div class="e-tk">{{ fund.ticker }}</div>
        <div class="e-1d num {{ 'pos' if fund.flow_1d and fund.flow_1d>0 else 'neg' if fund.flow_1d and fund.flow_1d<0 else '' }}">
          {% if fund.flow_1d is not none %}{{ '+' if fund.flow_1d>0 else '−' if fund.flow_1d<0 else '' }}{{ dollars(fund.flow_1d|abs) }}{% else %}—{% endif %}</div>
        <div class="e-hist">5D {% if fund.flow_5d is not none %}{{ '+' if fund.flow_5d>0 else '−' if fund.flow_5d<0 else '' }}{{ dollars(fund.flow_5d|abs) }}{% else %}—{% endif %} · 21D {% if fund.flow_21d is not none %}{{ '+' if fund.flow_21d>0 else '−' if fund.flow_21d<0 else '' }}{{ dollars(fund.flow_21d|abs) }}{% else %}—{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="muted sm">{{ t('ETF flow proxy not yet available.','ETF资金流代理暂不可用。') }}</p>
    {% endif %}
  </div>

</div>{# /right col #}
</div>{# /fd-grid #}

{# ── footer: merged disclosure + demoted pattern-engine receipt ─────────────── #}
<div class="fd-foot">
  {% if fs and fs.n_events_total %}
  <div class="fd-receipt">
    <span class="rk">{{ t('Pattern engine','规律引擎') }}</span>
    <span>{{ t('logging flow events to learn what typically follows','正在记录资金事件以学习其后续走势') }} — <span class="num">{{ "{:,}".format(fs.n_events_total) }}</span> {{ t('events since','起始于') }} {{ fs.since or '—' }}. {{ t('Building history — not a signal yet.','历史积累中 — 暂非信号。') }}</span>
    {% if fs.bucket_receipt %}{{ help(
      'Events grouped by option time-to-expiry: ' ~ (fs.bucket_receipt | map(attribute='bucket_en') | join(', ')) ~ '. Once enough history accrues, similar past events will show how often a move of a given size followed. Display-only; never feeds a rank or a buy.',
      '按期权到期剩余天数分组。历史积累充分后，将展示相似历史事件后特定幅度涨跌的出现频率。仅供展示；不进入排名或买卖。'
    ) }}{% endif %}
  </div>
  {% endif %}
  <p class="fd-disc">
    {{ t('Built','生成于') }} {{ fd.built if fd else '—' }} ·
    {{ t('End-of-day US options flow. Size is a solid read; direction (~) is approximate. ETF flows are a creation/redemption proxy. Display only — no buy or sell signal, no ranking.',
         '美股期权收盘资金。规模可靠；方向（~）为近似。ETF资金流为申购/赎回代理。仅供展示 — 无买卖信号，不排名。') }}
  </p>
</div>

<script>
(function(){
  // staleness: EOD older than ~5 days (weekend + holiday) → header date turns red
  var el = document.getElementById('fd-asof');
  var d = el ? el.getAttribute('data-asof') : '';
  if (el && d && (Date.now() - new Date(d + 'T21:00:00Z').getTime()) / 864e5 > 5) el.classList.add('is-stale');
})();

(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── score count-up (gauge sweep itself is pure CSS — see .fd-gauge-arc-fill) ─
  // The SSR text is already the true value; the count-up is a decorative intro
  // with a HARD fallback so a throttled/backgrounded tab can never freeze it on
  // a partial number (a wrong number is a defect, doctrine Law 3).
  var snum = document.getElementById('fd-score');
  if (snum && snum.getAttribute('data-to') && !reduce) {
    var to = parseInt(snum.getAttribute('data-to'), 10), t0 = null, dur = 1050, settled = false;
    function settle(){ if (settled) return; settled = true; snum.textContent = to; }
    function step(ts){ if (settled) return; if(!t0) t0 = ts; var p = Math.min(1,(ts-t0)/dur);
      snum.textContent = Math.round(to * (1 - Math.pow(1-p,3)));   // easeOutCubic
      if (p < 1) requestAnimationFrame(step); else settle(); }
    snum.textContent = '0';
    requestAnimationFrame(step);
    setTimeout(settle, dur + 500);                 // guarantee the true value
  }

  // ── 30-session tide sparkline ──────────────────────────────────────────────
  var SPARK = {{ fd.market_tide.spark | tojson if fd and fd.market_tide and fd.market_tide.spark else '[]' }};
  var canvas = document.getElementById('fd-spark');
  if (!canvas || !SPARK.length) return;
  var ctx = canvas.getContext('2d');
  var dpr = window.devicePixelRatio || 1;
  function draw(){
    var W = canvas.offsetWidth, H = canvas.offsetHeight;
    if (!W) return;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,W,H);
    var vals = SPARK.map(function(d){ return d.premium_mn || 0; });
    var mn = Math.min.apply(null,vals), mx = Math.max.apply(null,vals), rng = mx-mn || 1;
    var cs = getComputedStyle(document.body);
    var flow = (cs.getPropertyValue('--flow')||'#34c2d3').trim();
    var flowInk = (cs.getPropertyValue('--flow-ink')||'#5fd3e0').trim();
    function X(i){ return (i/(vals.length-1))*W; }
    function Y(v){ return H - ((v-mn)/rng)*(H-6) - 3; }
    // waterline fill
    var grad = ctx.createLinearGradient(0,0,0,H);
    grad.addColorStop(0, flow+'44'); grad.addColorStop(1, flow+'05');
    ctx.beginPath(); ctx.moveTo(X(0),H);
    vals.forEach(function(v,i){ ctx.lineTo(X(i),Y(v)); });
    ctx.lineTo(W,H); ctx.closePath(); ctx.fillStyle = grad; ctx.fill();
    // line
    ctx.beginPath();
    vals.forEach(function(v,i){ i===0 ? ctx.moveTo(X(i),Y(v)) : ctx.lineTo(X(i),Y(v)); });
    ctx.strokeStyle = flowInk; ctx.lineWidth = 1.6; ctx.lineJoin='round'; ctx.stroke();
    // last dot
    ctx.beginPath(); ctx.arc(X(vals.length-1),Y(vals[vals.length-1]),2.6,0,Math.PI*2);
    ctx.fillStyle = flowInk; ctx.fill();
  }
  draw();
  var rt; window.addEventListener('resize', function(){ clearTimeout(rt); rt = setTimeout(draw,120); });
})();

/* ── How the day unfolded — the completed session's ~net-premium tide curve ─────
   Its own IIFE on purpose: the block above returns early when the 30-session spark
   is empty, and this panel must not depend on that.

   Data: live_flow/tide_current.json from the R2 tape store, reached through
   window.DATA_BASE (injected site-wide by scripts/inject_data_base.py). Fetch
   discipline copied verbatim from templates/intraday_flow.html.j2: r2Url() yields
   null when DATA_BASE is unset, {cache:'no-cache'}, an .ok check, and .catch(→null).
   Every failure path lands in the same place — the panel stays hidden and the page
   is byte-for-byte what it was before. Nothing here can throw into the page.

   minutes[] carries CUMULATIVE ncp/npp (engine/live_flow.build_tide_current), so the
   directional lean at each minute is ncp − npp: net call premium bought minus net put
   premium bought. Direction is tape-inferred and SOFT — every readout carries ~.

   Colour: --up/--down are re-read from computed style on every draw and the canvas
   redraws on 'langchange', because those vars swap to 红涨绿跌 in Chinese
   (theme.css html[data-lang="zh"]). A cached colour would be wrong after a swap. */
(function () {
  var panel = document.getElementById('fd-unfold');
  if (!panel) return;

  function lz(en, zh) {
    return '<span class="l-en">' + en + '</span><span class="l-zh">' + (zh || en) + '</span>';
  }
  function r2Url(path) {
    var base = (window.DATA_BASE || '').replace(/\/+$/, '');
    return base ? base + '/' + path : null;
  }
  function money(v) {
    var a = Math.abs(v), sign = v < 0 ? '−' : '+';
    if (a >= 1e9) return sign + '$' + (a / 1e9).toFixed(1) + 'B';
    if (a >= 1e6) return sign + '$' + Math.round(a / 1e6) + 'M';
    if (a >= 1e3) return sign + '$' + Math.round(a / 1e3) + 'K';
    return sign + '$' + Math.round(a);
  }

  var SERIES = [];           // [{t:'HH:MM', net:<cumulative ncp-npp>}]

  function draw() {
    var cv = document.getElementById('fdu-spark');
    if (!cv || SERIES.length < 2) return;
    var W = cv.offsetWidth, H = cv.offsetHeight;
    if (!W) return;
    var dpr = window.devicePixelRatio || 1;
    var ctx = cv.getContext('2d');
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);

    var cs = getComputedStyle(document.body);
    var up = (cs.getPropertyValue('--up') || '#45b873').trim();
    var dn = (cs.getPropertyValue('--down') || '#e06464').trim();
    var hair = (cs.getPropertyValue('--ink-3') || '#8a8a8a').trim();

    var vals = SERIES.map(function (d) { return d.net; });
    // Zero-anchored: the baseline is 0, never the series minimum — the sign is the read.
    var mx = Math.max.apply(null, vals), mn = Math.min.apply(null, vals);
    var top = Math.max(mx, 0), bot = Math.min(mn, 0), rng = (top - bot) || 1;
    var pad = 4;
    function X(i) { return (i / (vals.length - 1)) * W; }
    function Y(v) { return H - pad - ((v - bot) / rng) * (H - pad * 2); }
    var zeroY = Y(0);

    // Waterline fill, tinted per side of zero (doctrine's zero-anchored dual-tint).
    function band(above) {
      ctx.save();
      ctx.beginPath();
      if (above) ctx.rect(0, 0, W, zeroY); else ctx.rect(0, zeroY, W, H - zeroY);
      ctx.clip();
      ctx.beginPath();
      ctx.moveTo(X(0), zeroY);
      vals.forEach(function (v, i) { ctx.lineTo(X(i), Y(v)); });
      ctx.lineTo(X(vals.length - 1), zeroY);
      ctx.closePath();
      ctx.fillStyle = (above ? up : dn) + '33';
      ctx.fill();
      ctx.restore();
    }
    band(true); band(false);

    // Zero line.
    ctx.beginPath(); ctx.moveTo(0, zeroY); ctx.lineTo(W, zeroY);
    ctx.strokeStyle = hair; ctx.globalAlpha = .45; ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]); ctx.stroke();
    ctx.setLineDash([]); ctx.globalAlpha = 1;

    // The curve, coloured by where it closed.
    var last = vals[vals.length - 1];
    ctx.beginPath();
    vals.forEach(function (v, i) { i === 0 ? ctx.moveTo(X(i), Y(v)) : ctx.lineTo(X(i), Y(v)); });
    ctx.strokeStyle = last >= 0 ? up : dn;
    ctx.lineWidth = 1.7; ctx.lineJoin = 'round'; ctx.stroke();

    // Close marker.
    ctx.beginPath(); ctx.arc(X(vals.length - 1), Y(last), 2.8, 0, Math.PI * 2);
    ctx.fillStyle = last >= 0 ? up : dn; ctx.fill();
  }

  function render(tide) {
    var mins = (tide && tide.minutes) || [];
    if (mins.length < 2) return;                     // nothing honest to draw

    var grossSum = 0;
    SERIES = mins.map(function (m) {
      grossSum += Math.abs(m.gross || 0);
      return { t: m.t || '', net: (m.ncp || 0) - (m.npp || 0) };
    });

    var vals = SERIES.map(function (d) { return d.net; });
    var last = vals[vals.length - 1];
    // Peak = the day's largest absolute lean, whichever side it was on.
    var peak = 0;
    vals.forEach(function (v) { if (Math.abs(v) > Math.abs(peak)) peak = v; });
    var peakAbs = Math.abs(peak);

    // "Two-way" is an honest state, not a rounding artefact: a close inside 2% of the
    // day's gross premium is noise, not a lean.
    var flat = grossSum > 0 && Math.abs(last) < grossSum * 0.02;

    var leanEl = document.getElementById('fdu-lean');
    var netEl = document.getElementById('fdu-net');
    var shapeEl = document.getElementById('fdu-shape');
    var asofEl = document.getElementById('fdu-asof');

    if (leanEl) {
      leanEl.className = 'lean-chip fdu-lean ' +
        (flat ? 'lean-bal' : (last > 0 ? 'lean-buy' : 'lean-sell'));
      leanEl.innerHTML = '<span class="softmk">~</span>' + (
        flat ? lz('Two-way', '多空均衡')
             : (last > 0 ? lz('Calls led', '看涨主导') : lz('Puts led', '看跌主导')));
    }
    if (netEl) {
      netEl.className = 'fdu-net' + (flat ? '' : (last > 0 ? ' up' : ' dn'));
      netEl.textContent = money(last);
    }
    if (shapeEl) {
      var shape;
      if (peakAbs > 0 && !flat && (last > 0) !== (peak > 0)) {
        shape = lz('turned the other way during the day', '盘中方向反转');
      } else if (peakAbs > 0 && Math.abs(last) >= peakAbs * 0.95) {
        shape = lz('the lean built right into the close', '倾向持续加强至收盘');
      } else if (peakAbs > 0 && Math.abs(last) < peakAbs * 0.6) {
        shape = lz('it faded well off the day\'s peak', '较当日峰值明显回落');
      } else {
        shape = lz('it held one side most of the day', '全天基本维持单边');
      }
      shapeEl.innerHTML = shape;
    }
    if (asofEl) {
      var d = (tide.session_date || '').toString();
      var lastT = SERIES[SERIES.length - 1].t;
      asofEl.innerHTML = lz('live tape', '实时盘面') + ' · ' +
        (d ? d + ' · ' : '') + lz('to ', '至 ') + lastT;
    }

    panel.hidden = false;
    panel.classList.add('rise');
    draw();
  }

  var url = r2Url('live_flow/tide_current.json');
  if (!url) return;                                  // no store configured — stay hidden
  fetch(url, { cache: 'no-cache' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .catch(function () { return null; })
    .then(function (tide) {
      if (!tide) return;                             // unreachable / empty — stay hidden
      try { render(tide); } catch (e) { /* never break the page for a side panel */ }
    });

  var rt2;
  window.addEventListener('resize', function () { clearTimeout(rt2); rt2 = setTimeout(draw, 120); });
  // --up/--down swap in Chinese — repaint or the curve keeps the wrong direction colour.
  document.addEventListener('langchange', function () { setTimeout(draw, 0); });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
