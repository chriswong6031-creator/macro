button:focus-visible,input:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--gov-cyan);outline-offset:2px}.co-row,.tab,.change{transition:background .16s ease,color .16s ease,transform .16s ease}.change:active,.co-row:active{transform:scale(.995)}
html body .wrap .panel{padding:0;border-radius:18px}html body .wrap .hero-main{padding:24px 26px 21px}html body .wrap .detail-hero{padding:21px 22px 18px}html body .wrap .badge{padding:2px 6px}
@media(max-width:1120px){.hero-grid,.workspace{grid-template-columns:1fr}.rail{position:relative;top:auto}.company-list{max-height:290px}.metric-grid{grid-template-columns:repeat(3,1fr)}.hero-main:before{opacity:.45}}
@media(max-width:760px){body{padding-top:10px}.wrap{padding:0 13px}.suitebar{margin-top:10px}.suite-status .source-copy{display:none}.headline{display:block;margin:29px 2px 19px}.stamp{margin-top:18px;border-left:0;border-top:1px solid var(--gov-edge);padding:11px 0 0}.hero-grid{gap:10px}.hero-main{padding:21px 18px 17px}.hero-total{font-size:44px}.kpis{grid-template-columns:repeat(2,1fr);row-gap:14px}.kpi:nth-child(3){border-left:0;padding-left:0}.change-feed{max-height:258px}.workspace{gap:10px}.rail-top{padding:12px}.company-list{display:flex;max-height:none;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 6px}.co-row{min-width:235px;border-top:0;border-right:1px solid var(--gov-edge);scroll-snap-align:start}.detail-hero{padding:18px 15px 15px}.two,.exposure{grid-template-columns:1fr}.metric-grid{grid-template-columns:repeat(2,1fr)}.metric:last-child{grid-column:1/-1}.detail-top{display:block}.confidence{text-align:left;margin-top:11px}.decision-brief{grid-template-columns:1fr;gap:5px}.method-body{grid-template-columns:1fr}.table-wrap{padding-left:7px;padding-right:7px}.authority{align-items:flex-start}.identity .meta{max-width:72vw}.suite-name span{display:none}html body .wrap .hero-main{padding:21px 18px 17px}html body .wrap .detail-hero{padding:18px 15px 15px}}
@media(max-width:420px){.suite-status .tier{display:none}.hero-total{font-size:39px}.kpi .v{font-size:18px}.metric-grid{grid-template-columns:1fr}.metric:last-child{grid-column:auto}.identity{align-items:flex-start}.logo{width:41px;height:41px}.identity h2{font-size:18px}.tabs{overflow-x:auto}.tab{white-space:nowrap}.dek{font-size:12.5px}}
@media(prefers-reduced-motion:no-preference){.panel{animation:panel-in .42s cubic-bezier(.2,.7,.25,1) both}.hero-grid .panel:nth-child(2){animation-delay:.06s}.workspace{animation:panel-in .46s .1s cubic-bezier(.2,.7,.25,1) both}.change-dot.positive{animation:breathe 2.8s ease-in-out infinite}@keyframes panel-in{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}@keyframes breathe{50%{box-shadow:0 0 0 5px color-mix(in srgb,var(--up) 9%,transparent)}}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
