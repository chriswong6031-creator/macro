<body>
<a class="skip-link" href="#intelligence-workspace">{{ t('Skip to intelligence workspace','跳至情报工作台') }}</a>
<div class="ambient"></div>
<div class="wrap">
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener"><span class="product-icon product-icon-mastermind" aria-hidden="true"></span>{{ t('Mastermind','操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener"><span class="product-icon product-icon-terminal" aria-hidden="true"></span>{{ t('Terminal','终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language"><span class="pill"></span><span class="opt en-opt" data-l="en">EN</span><span class="opt zh-opt" data-l="zh">中文</span></div>
  </div>
</nav>

<div class="suitebar" aria-label="Vertical Intelligence Workbench">
  <div class="suite-id"><span class="suite-mark" aria-hidden="true"></span><div class="suite-name"><b>Mastermind X</b><span>{{ t('Vertical Intelligence Workbench','垂直情报工作台') }}</span></div></div>
  <div class="suite-desk"><i aria-hidden="true"></i>{{ t('Desk 01 · Procurement','工作台 01 · 政府采购') }}</div>
  <div class="suite-status"><span><i id="sourceDot" aria-hidden="true"></i><span class="source-copy" id="sourceStatus">{{ t('Checking evidence coverage','正在检查证据覆盖') }}</span></span><span class="tier">{{ t('Context tier','情境层') }}</span></div>
</div>

<header class="headline">
  <div><div class="eyebrow">{{ t('Public money → contract capacity → reported revenue','公共资金 → 合同余量 → 财报收入') }}</div><h1>{{ t('Government Revenue','政府收入') }} <span class="headline-accent">{{ t('Foresight','前瞻') }}</span></h1><p class="dek">{{ t('The procurement tape rebuilt for investors: obligations, award velocity, observed capacity, modifications, concentration and expiry risk—before the accounting statements catch up.','为投资者重建的采购脉搏：合同义务、授标速度、观测余量、合同变更、集中度与到期风险——领先财务报表。') }}</p></div>
  <div class="stamp"><b>{{ t('Evidence cut','证据截点') }} <span>{{ as_of or '—' }}</span></b>{{ t('System observed','系统观测于') }} <time id="knownAt" data-iso="{{ known_at or '' }}">{{ known_at or '—' }}</time></div>
</header>

<div class="authority"><span class="pulse"></span><div><strong>{{ t('Context rail, not a trading oracle.','情境层，而非交易神谕。') }}</strong> {{ t('Every dollar is traceable to an official record. Procurement facts can enrich Neural Web and Prophet theses, but cannot rank candidates, change conviction, size positions or gate trades until a forward study passes.','每一美元均可追溯至官方记录。采购事实可丰富智脑与 Prophet 论据，但在前瞻验证通过前不得排序、改变信心、调整仓位或触发交易。') }}</div></div>

<section class="hero-grid">
  <div class="panel hero-main"><div class="hero-line"><div class="hero-k">{{ t('Mapped-company obligation exposure','已映射公司合同义务暴露') }}</div><span class="evidence-pill" id="evidenceState">{{ t('validating receipts','正在核验凭证') }}</span></div><div class="hero-total" id="heroTotal" aria-live="polite">—</div><div class="hero-note" id="heroNote">{{ t('Loading official USAspending receipts…','正在载入 USAspending 官方记录…') }}</div><div class="hero-signal" id="heroSignal">{{ t('Building the capital-transmission read…','正在构建资本传导研判…') }}</div><div class="kpis"><div class="kpi"><div class="v" id="kCompanies">—</div><div class="l">{{ t('mapped public companies','已映射上市公司') }}</div></div><div class="kpi"><div class="v up" id="kAccel">—</div><div class="l">{{ t('award flow accelerating','授标流正在加速') }}</div></div><div class="kpi"><div class="v" id="kBacklog">—</div><div class="l">{{ t('unique observed funded capacity','唯一合同观测余量') }}</div></div><div class="kpi"><div class="v amber" id="kRecomp">—</div><div class="l">{{ t('expiry / recompete watches','到期 / 再竞争观察') }}</div></div></div></div>
  <div class="panel"><div class="change-head"><h2>{{ t('What changed in the tape','采购脉搏发生了什么') }}</h2><span class="live-chip">{{ t('decision feed','决策动态') }}</span></div><div class="change-feed" id="changeFeed" aria-live="polite"></div></div>
</section>

<section class="workspace" id="intelligence-workspace">
  <aside class="panel rail"><div class="rail-top"><div class="rail-label"><span>{{ t('Company transmission map','公司资金传导图') }}</span><kbd aria-hidden="true">/</kbd></div><label class="search"><span class="search-glyph" aria-hidden="true"></span><input id="search" type="search" placeholder="Ticker or company" aria-label="Search companies" autocomplete="off"></label><div class="rail-meta"><span id="railCount" aria-live="polite">—</span><span>{{ t('sorted by observed velocity','按观测速度排序') }}</span></div></div><div class="company-list" id="companyList" aria-label="Mapped public companies"></div></aside>
  <main class="detail" id="detail">
    <section class="panel detail-hero"><div class="detail-top"><div class="identity"><div class="logo" id="dLogo">—</div><div><h2 id="dName">—</h2><div class="meta" id="dMeta">—</div></div></div><div class="confidence" id="dConfidence"></div></div><div class="decision-brief"><div class="brief-label">{{ t('Investor read','投资者研判') }}</div><p id="dBrief">{{ t('Select a company to trace public dollars into award momentum, observed capacity and timing.','选择公司，追踪公共资金如何传导至授标动能、观测合同余量与兑现时点。') }}</p></div><div class="metric-grid" id="metricGrid"></div></section>
    <div class="two"><section class="panel"><div class="section-head"><div><h2>{{ t('Award velocity','授标速度') }}</h2><p id="velocityCaption">{{ t('Complete months only; compared with matching prior-year months.','仅使用完整月份；与上年同期月份比较。') }}</p></div><span class="micro-chip">{{ t('flow','流量') }}</span></div><div class="chart" id="velocityChart"></div></section><section class="panel"><div class="section-head"><div><h2>{{ t('Catalyst & contradiction ledger','催化剂与矛盾账本') }}</h2><p>{{ t('Deterministic facts; no LLM score.','确定性事实；无大模型评分。') }}</p></div><span class="micro-chip">{{ t('change','变化') }}</span></div><div class="facts" id="factList"></div></section></div>
    <div class="exposure"><section class="panel"><div class="section-head"><div><h2>{{ t('Agency exposure','机构暴露') }}</h2><p>{{ t('Observed award obligations in the detail sample.','详细样本中观测到的授标义务额。') }}</p></div><span class="micro-chip">{{ t('customer','客户') }}</span></div><div class="bars" id="agencyBars"></div></section><section class="panel"><div class="section-head"><div><h2>{{ t('Program exposure','项目暴露') }}</h2><p>{{ t('DoD acquisition program fields when reported.','在披露时使用国防部采办项目字段。') }}</p></div><span class="micro-chip">{{ t('mission','任务') }}</span></div><div class="bars" id="programBars"></div></section></div>
    <section class="panel table-panel"><div class="tabs" role="tablist" aria-label="Government revenue evidence"><button class="tab on" id="tab-awards" role="tab" aria-selected="true" aria-controls="evidenceTable" tabindex="0" data-tab="awards">{{ t('Awards','合同') }}</button><button class="tab" id="tab-actions" role="tab" aria-selected="false" aria-controls="evidenceTable" tabindex="-1" data-tab="actions">{{ t('Modifications','变更') }}</button><button class="tab" id="tab-recompetes" role="tab" aria-selected="false" aria-controls="evidenceTable" tabindex="-1" data-tab="recompetes">{{ t('Expiry watch','到期观察') }}</button></div><div class="table-wrap" id="evidenceTable" role="tabpanel" aria-live="polite" aria-labelledby="tab-awards"></div></section>
    <details class="panel method"><summary>{{ t('Method, provenance & honest limits','方法、出处与真实限制') }}</summary><div class="method-body"><div><h3>{{ t('Award velocity','授标速度') }}</h3><p>{{ t('Trailing complete-period obligations are compared with the same fiscal-season months one year earlier. The newest incomplete reporting months are excluded rather than treated as a collapse.','完整报告期的滚动义务额与一年前相同财政季节月份比较。最新不完整月份会被排除，而不会被误判为崩塌。') }}</p></div><div><h3>{{ t('Observed-capacity arithmetic','观测余量计算') }}</h3><p><code>funded capacity = max(exercised value − obligations, 0)</code><br><code>potential capacity = max(all-options value − obligations, 0)</code><br>{{ t('These are lower-bound residuals from a bounded official award-detail sample—not company-reported or GAAP backlog. Coverage is shown per company.','这些是有限官方合同明细样本中的已观测余量下界，并非公司披露或 GAAP 积压；每家公司均显示覆盖度。') }}</p></div><div><h3>{{ t('Latency & identity','延迟与身份') }}</h3><p>{{ t('USAspending is official and keyless, but DoD records may arrive with substantial delay. Parent mapping starts from curated recipient-name queries and is shown with explicit match confidence until UEI/CAGE lineage is fully audited. Shared joint ventures may appear in more than one parent exposure series, so the headline obligation total is exposure—not unique federal spend.','USAspending 官方且无需密钥，但国防部记录可能显著延迟。母公司映射从人工整理的收款方名称查询开始，在 UEI/CAGE 关系完全审计前会明确显示匹配置信度。共享合资企业可能出现在多个母公司暴露序列中，因此头部义务额是暴露总和，并非唯一联邦支出。') }}</p></div></div></details>
    <div class="source-line">{{ t('Primary source','主要来源') }}: <a href="https://www.usaspending.gov/" target="_blank" rel="noopener">USAspending.gov</a> · {{ t('Display/context only','仅展示/情境') }}</div>
  </main>
</section>
</div>
<script id="gov-data" type="application/json">{{ payload_json|replace('</', '<\/')|safe }}</script>
<script>
(function(){
  'use strict';
  var DATA={};
  try{DATA=JSON.parse((document.getElementById('gov-data')||{}).textContent||'{}')}catch(err){DATA={companies:[],load_error:true}}
  var ALL=Array.isArray(DATA.companies)?DATA.companies.filter(function(c){return c&&typeof c==='object'}).slice():[];
  var selected=null,activeTab='awards';
  function $(id){return document.getElementById(id)}
  function zh(){return document.documentElement.getAttribute('data-lang')==='zh'}
  function tr(en,cn){return zh()?cn:en}
  function list(x){return Array.isArray(x)?x:[]}
  function esc(x){return String(x==null?'':x).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function mappingLabel(x){x=String(x||'');if(x==='curated_fuzzy_name')return tr('curated name map','人工校验名称映射');if(x==='curated_exact_name')return tr('curated exact-name map','人工校验精确名称映射');return x.replace(/[_-]+/g,' ')}
  function confidenceLabel(x){x=String(x||'').toLowerCase();var labels={high:tr('high','高'),medium:tr('medium','中等'),low:tr('low','低'),unavailable:tr('unavailable','不可用')};return labels[x]||x}
  function n(x){if(x==null||x===''||typeof x==='boolean')return null;x=Number(x);return Number.isFinite(x)?x:null}
  function money(x){x=n(x);if(x==null)return '—';var a=Math.abs(x),s=x<0?'−':'';if(a>=1e12)return s+'$'+(a/1e12).toFixed(1)+'T';if(a>=1e9)return s+'$'+(a/1e9).toFixed(1)+'B';if(a>=1e6)return s+'$'+(a/1e6).toFixed(1)+'M';if(a>=1e3)return s+'$'+(a/1e3).toFixed(1)+'K';return s+'$'+Math.round(a).toLocaleString()}
  function pct(x,d){x=n(x);return x==null?'—':(x>0?'+':'')+x.toFixed(d==null?1:d)+'%'}
  function num(x){x=n(x);return x==null?'—':Math.round(x).toLocaleString()}
  function metric(c,k){return n(((c||{}).metrics||{})[k])}
  function capacity(c){var v=metric(c,'funded_capacity_observed');return v==null?metric(c,'funded_backlog'):v}
  function tone(v){return v==null?'na':v>0?'up':v<0?'down':'na'}
  function factTone(d){d=String(d||'').toLowerCase();return /pos|bull|up|acceler|gain|increase|large_contract_action/.test(d)?'positive':/neg|bear|down|risk|deoblig|deceler|decline/.test(d)?'negative':'watch'}
  function factNorm(f){if(typeof f==='string')return {headline:f,detail:'',direction:'watch',value:''};f=f&&typeof f==='object'?f:{};var value=f.value!=null?f.value:(f.amount!=null?f.amount:''),direction=[f.direction,f.polarity,f.kind,f.headline].filter(Boolean).join(' ')||'watch';return {headline:f.headline||f.title||f.label||f.fact||tr('Observed change','观测变化'),detail:f.detail||f.explanation||f.why||f.note||'',direction:direction,value:value}}
  function factValue(v){if(v==null||v==='')return '';if(typeof v!=='object')return typeof v==='number'?money(v):String(v);var amount=n(v.amount!=null?v.amount:v.value),unit=String(v.unit||'').toLowerCase();if(amount==null)return '';if(/percent/.test(unit))return pct(amount);if(/usd|dollar/.test(unit))return money(amount);if(/day/.test(unit))return num(amount)+' '+tr('days','天');return num(amount)+(unit?' '+unit:'')}
  function factMagnitude(v){if(v&&typeof v==='object')return Math.abs(n(v.amount!=null?v.amount:v.value)||0);return Math.abs(n(v)||0)}
  function facts(c){return list((c||{}).catalyst_facts||(c||{}).catalysts).map(factNorm)}
  function awards(c){return list((c||{}).awards||(c||{}).top_awards)}
  function actions(c){return list((c||{}).recent_actions||(c||{}).actions)}
  function recomp(c){return list((c||{}).recompete_candidates||(c||{}).expiry_watch)}
  function label(o,keys,fb){for(var i=0;i<keys.length;i++){if(o&&o[keys[i]]!=null&&o[keys[i]]!==''){var v=o[keys[i]];return typeof v==='object'?JSON.stringify(v):v}}return fb==null?'—':fb}
  function confidence(c){var x=(c||{}).confidence||{},v=typeof x==='object'?(x.level||x.label||x.overall):x;return v||label((c||{}).entity_match||{},['confidence_label','confidence'],tr('coverage-aware','覆盖度感知'))}

  function hero(){
    var total=0,acc=0,decel=0,back=0,rec=0,backKnown=0,detailCount=0,velKnown=0;
    ALL.forEach(function(c){var t=metric(c,'ttm_obligations'),v=metric(c,'award_velocity_yoy_pct'),b=capacity(c);if(t!=null)total+=t;if(v!=null){velKnown++;if(v>20)acc++;if(v<-20)decel++}if(b!=null){back+=b;backKnown++}rec+=recomp(c).length;if(awards(c).length||actions(c).length)detailCount++});
    var market=DATA.market&&typeof DATA.market==='object'?DATA.market:{},marketTotal=n(market.ttm_obligations),marketAcc=n(market.accelerating_companies),marketDecel=n(market.decelerating_companies),marketBack=n(market.funded_capacity_observed!=null?market.funded_capacity_observed:market.funded_backlog_observed),marketRec=n(market.recompete_watch_count),marketDetail=Math.max(n(market.companies_with_award_detail)||0,n(market.companies_with_action_detail)||0);if(marketTotal!=null)total=marketTotal;if(marketAcc!=null)acc=marketAcc;if(marketDecel!=null)decel=marketDecel;if(marketBack!=null){back=marketBack;backKnown=1}if(marketRec!=null)rec=marketRec;if(marketDetail)detailCount=marketDetail;
    $('heroTotal').textContent=ALL.length?money(total):'—';$('kCompanies').textContent=num(ALL.length);$('kAccel').textContent=velKnown?num(acc):'—';$('kBacklog').textContent=backKnown?money(back):tr('awaiting detail','等待明细');$('kRecomp').textContent=detailCount?num(rec):'—';
    var cov=DATA.coverage&&typeof DATA.coverage==='object'?DATA.coverage:{},fresh=DATA.freshness&&typeof DATA.freshness==='object'?DATA.freshness:{},latest=cov.latest_complete_month||cov.complete_through||market.latest_complete_month||'',state=String(fresh.status||DATA.status||'').toLowerCase(),sourceIso=fresh.known_at||cov.monthly_collection_known_at||DATA.known_at||'',sourceTime=sourceIso?new Date(sourceIso).getTime():NaN,ageHours=Number.isFinite(sourceTime)?Math.max(0,(Date.now()-sourceTime)/36e5):null,stale=/stale/.test(state),unknownFreshness=!sourceIso||!Number.isFinite(sourceTime),degraded=/stale|degrad|partial|fallback|error|unavailable/.test(state)||cov.monthly_visible_at_as_of===false||unknownFreshness;detailCount=n(cov.detailed_companies||cov.award_detail_companies)!=null?Number(cov.detailed_companies||cov.award_detail_companies):detailCount;
    $('sourceDot').className=DATA.load_error?'error':(!ALL.length||degraded?'warn':'');$('sourceStatus').textContent=DATA.load_error?tr('Evidence payload unreadable','证据数据无法读取'):!ALL.length?tr('Awaiting first official ingest','等待首次官方采集'):stale?tr('Official evidence · ','官方证据 · ')+Math.floor(ageHours/24)+tr('d old',' 天前'):unknownFreshness?tr('Official evidence · freshness unverified','官方证据 · 新鲜度未核验'):degraded?tr('Official evidence · degraded coverage','官方证据 · 覆盖降级'):tr('Official evidence connected','官方证据已连接');$('evidenceState').textContent=!ALL.length?tr('coverage pending','覆盖待建立'):degraded?tr('qualified receipts','有条件凭证'):tr('official receipts','官方凭证');
    $('heroNote').textContent=(latest?tr('Complete through ','完整数据截至 ')+latest:tr('Latest complete reporting periods','最新完整报告期'))+' · '+detailCount+tr(' companies with award/action detail',' 家公司含授标/变更明细');
    var signal='';if(!velKnown)signal=tr('Velocity coverage is warming up; no acceleration claim is made.','速度覆盖正在建立；暂不作加速判断。');else if(acc>decel)signal='<strong>'+acc+' / '+velKnown+'</strong> '+tr('mapped companies show >20% season-matched award acceleration.','家已映射公司显示超过 20% 的同季授标加速。');else if(decel>acc)signal='<strong>'+decel+' / '+velKnown+'</strong> '+tr('mapped companies show >20% season-matched deceleration—inspect modifications before inferring demand.','家已映射公司显示超过 20% 的同季减速——推断需求前请先检查合同变更。');else signal='<strong>'+velKnown+'</strong> '+tr('companies have comparable award history; the cross-section is balanced.','家公司具备可比授标历史；横截面大致均衡。');$('heroSignal').innerHTML=signal;
    var changes=[];ALL.forEach(function(c){facts(c).forEach(function(f){changes.push({c:c,f:f})})});changes.sort(function(a,b){var av=factMagnitude(a.f.value),bv=factMagnitude(b.f.value);return bv-av||Math.abs(metric(b.c,'award_velocity_yoy_pct')||0)-Math.abs(metric(a.c,'award_velocity_yoy_pct')||0)});
    var box=$('changeFeed');if(!changes.length){box.innerHTML='<div class="empty-state"><span>'+esc(tr('No qualifying modification or catalyst fact yet. Award velocity remains available above.','尚无符合规则的合同变更或催化事实。上方授标速度仍可使用。'))+'</span></div>';return}
