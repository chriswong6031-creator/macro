      if(impacts.length)out.push({kind:allReviewed?tr('Reviewed issuer links','已核验发行人关联'):tr('Derived issuer links','推导公司关联'),title:impacts.map(function(x){return x.ticker}).filter(Boolean).join(' · '),body:allReviewed?tr('Recipient and ownership paths were reviewed against governed evidence. This is still not reported revenue or an investment ranking.','收款方与所有权路径已根据受治理证据核验。它仍不等于报告收入或投资排名。'):tr('Rule-based recipient or capability links. Not bidder odds, revenue estimates or investment rankings.','基于规则的收款方或能力关联。非投标概率、收入估算或投资排名。'),code:impacts.map(function(x){return text(x.ticker)+': '+text(x.relation_semantic)+' · '+text(x.match_method)+' · '+text(x.confidence)}).join('\n')});
      out.push({kind:tr('Authority & limits','权限与限制'),title:tr('Display priority is not investment rank','展示优先级并非投资排名'),body:arr(ev.limitations).concat(arr(WORKSPACE.limitations)).join(' · '),code:'formula_version: '+text((w.display_priority||{}).formula_version)+'\nis_investment_rank: false\ncan_rank: '+text((w.authority||{}).can_rank)+'\ncan_size: '+text((w.authority||{}).can_size)+'\nconflicts: '+compact(ev.conflicts)});
      return out
    }
    if(src)out.push({kind:tr('Official source','官方来源'),title:r.title,body:r.kind==='recompete'?tr('The source supports the period-of-performance end date, not a guaranteed recompete.','该来源支持履约期结束日期，不代表确定的再竞争。'):tr('Open the source record to verify the current government-published fields.','打开源记录以核实当前政府发布字段。'),code:src,url:src});
    if(o.notice_id)out.push({kind:tr('Record identity','记录身份'),title:o.solicitation_number||o.notice_id,body:tr('Point-in-time opportunity revision retained by MastermindX.','MastermindX 保留的时点机会修订。'),code:'notice_id: '+o.notice_id+'\nrevision_id: '+text(o.revision_id)+'\nknown_at: '+text(o.known_at)});
    if(e.event_id)out.push({kind:tr('Revision event','修订事件'),title:changedCopy(e.changed_fields),body:tr('Field names are a deterministic diff between visible official versions.','字段名称是可见官方版本之间的确定性差异。'),code:'event_id: '+e.event_id+'\nchanged: '+arr(e.changed_fields).join(', ')});
    if(o.company_candidates&&o.company_candidates.length)out.push({kind:tr('Derived issuer link','推导公司关联'),title:candidateCopy(o),body:tr('Rule-based overlap using notice text, capabilities and award history. Not bidder odds, an award forecast or a revenue estimate.','基于公告文本、能力和授标历史的规则重合。非投标概率、授标预测或收入估算。'),code:arr(o.company_candidates).map(function(c){return c.ticker+': '+arr(c.match_reasons).map(function(x){return x.kind}).join(', ')}).join('\n')});
    var c=r.company||{};arr(c.source_receipts||c.provenance).slice(0,2).forEach(function(p){out.push({kind:tr('Dataset provenance','数据集出处'),title:p.publisher||p.dataset,body:arr(p.limitations).join(' · '),code:'known_at: '+text(p.known_at)+'\neffective_through: '+text(p.effective_through),url:safeUrl(p.source_url)})});
    return out
  }
  function openDrawer(r){var rows=receiptRows(r),html=rows.map(function(x){return'<article class="receipt"><div class="receipt-kind">'+esc(x.kind)+'</div><h3>'+esc(x.title)+'</h3><p>'+esc(x.body)+'</p><div class="receipt-code">'+esc(x.code)+'</div>'+(x.url?'<a class="source-link" href="'+esc(x.url)+'" target="_blank" rel="noopener"><b>'+esc(tr('Open receipt','打开凭证'))+'</b><span>↗</span></a>':'')+'</article>'}).join('')||'<div class="empty-state"><div><strong>'+esc(tr('No public receipt in compact artifact','精简数据中无公开凭证'))+'</strong><p>'+esc(tr('The row remains bounded by its dataset provenance and authority limits.','该行仍受数据集出处和权限限制约束。'))+'</p></div></div>';openEvidenceDrawer({title:tr('Evidence receipts','证据凭证'),html:html,focus:document.activeElement})}
  function closeDrawer(){if(!state.drawer)return;$('drawerBackdrop').hidden=true;$('evidenceDrawer').hidden=true;$('drawerTitle').textContent=tr('Evidence receipts','证据凭证');state.drawer=false;if(lastFocus&&lastFocus.focus)lastFocus.focus()}
  function trapDrawerFocus(e){if(!state.drawer||e.key!=='Tab')return;var nodes=Array.prototype.slice.call($('evidenceDrawer').querySelectorAll('a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),[tabindex]:not([tabindex="-1"])'));if(!nodes.length)return;var first=nodes[0],last=nodes[nodes.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}
  function openMobileInspector(){if(window.innerWidth>980)return;$('inspectorPane').classList.add('mobile-sheet');$('inspectorOpen').setAttribute('aria-expanded','true');$('drawerBackdrop').hidden=false}
  function closeSheets(){if($('filterPane').classList.contains('mobile-sheet')){$('filterPane').classList.remove('mobile-sheet');$('filterOpen').setAttribute('aria-expanded','false')}if($('inspectorPane').classList.contains('mobile-sheet')){$('inspectorPane').classList.remove('mobile-sheet');$('inspectorOpen').setAttribute('aria-expanded','false')}if(!state.drawer)$('drawerBackdrop').hidden=true}
  function rowKeys(e){if(!/^(ArrowDown|ArrowUp|Home|End|Enter)$/.test(e.key))return;var els=Array.prototype.slice.call($('queueList').querySelectorAll('.queue-row'));if(!els.length)return;var i=els.indexOf(document.activeElement),next=i;if(e.key==='Home')next=0;else if(e.key==='End')next=els.length-1;else if(e.key==='ArrowDown')next=Math.min(els.length-1,Math.max(0,i+1));else if(e.key==='ArrowUp')next=Math.max(0,i<0?0:i-1);else if(e.key==='Enter'){if(i>=0)selectRow(els[i].dataset.row,true);if(window.innerWidth<=980)openMobileInspector();return}e.preventDefault();els[next].focus();selectRow(els[next].dataset.row,true)}
  function bind(){document.querySelectorAll('.mode-tab').forEach(function(tab){tab.addEventListener('click',function(){state.mode=tab.dataset.mode;activateMode(true)});tab.addEventListener('keydown',function(e){if(!/^(ArrowRight|ArrowLeft|Home|End)$/.test(e.key))return;var tabs=Array.prototype.slice.call(document.querySelectorAll('.mode-tab')),i=tabs.indexOf(tab),next=e.key==='Home'?0:e.key==='End'?tabs.length-1:(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;e.preventDefault();state.mode=tabs[next].dataset.mode;activateMode(true);tabs[next].focus()})});$('companyMode').addEventListener('click',function(){state.mode='companies';activateMode(true)});$('deskSearch').addEventListener('input',function(){state.q=this.value.trim();applyFilters()});$('deskSearch').addEventListener('keydown',function(e){if(e.key==='Escape'){this.value='';state.q='';applyFilters();this.blur()}});$('truthFilters').addEventListener('click',function(e){var b=e.target.closest('[data-filter]');if(!b)return;state.truth=b.dataset.filter;this.querySelectorAll('.filter-choice').forEach(function(x){x.classList.toggle('on',x===b)});applyFilters()});$('agencyFilter').addEventListener('change',function(){state.agency=this.value;applyFilters()});$('tickerFilter').addEventListener('change',function(){state.ticker=this.value;applyFilters();syncUrl()});$('queueList').addEventListener('keydown',rowKeys);$('drawerClose').addEventListener('click',closeDrawer);$('evidenceDrawer').addEventListener('keydown',trapDrawerFocus);$('drawerBackdrop').addEventListener('click',function(){closeDrawer();closeSheets()});$('filterOpen').addEventListener('click',function(){$('filterPane').classList.add('mobile-sheet');this.setAttribute('aria-expanded','true');$('drawerBackdrop').hidden=false;$('deskSearch').focus()});$('inspectorOpen').addEventListener('click',openMobileInspector);document.addEventListener('keydown',function(e){var tag=(e.target&&e.target.tagName||'').toLowerCase();if(e.key==='/'&&!/input|textarea|select/.test(tag)&&!(e.target&&e.target.isContentEditable)){e.preventDefault();$('deskSearch').focus()}if(e.key==='Escape'){closeDrawer();closeSheets()}});document.addEventListener('langchange',function(){boot(false)})}
  function bindBriefcase(){if(briefcaseController){briefcaseController.bind();return}['savedViewSelect','saveView','deleteView','toggleLocalAlert','localInbox','exportViewJson','exportViewCsv'].forEach(function(id){$(id).disabled=true})}
  function bindHydration(){var retry=$('workspaceRetry');if(retry)retry.addEventListener('click',function(){hydrateWorkspace(true)})}
  function restoreUrl(){try{var p=new URLSearchParams(location.search),m=p.get('mode'),id=p.get('item'),ticker=p.get('ticker');if(['changes','awards','opportunities','recompetes','budget','companies'].indexOf(m)>-1)state.mode=m;if(id)state.selected=id;if(ticker&&COMPANIES.some(function(c){return c.ticker===ticker})){state.ticker=ticker;$('tickerFilter').value=ticker}}catch(e){}}
  function boot(first){buildRows();populateFilters();restoreUrl();headline();syncCounts();activateMode(false);briefcaseWorkspaceReady=HAS_WORKSPACE&&!workspaceNeedsHydration(WORKSPACE)&&!WORKSPACE.next_cursor;if(briefcaseController)briefcaseController.render();if(first){bind();bindHydration();bindBriefcase();budgetUI.load()}else budgetUI.refresh();if(briefcaseWorkspaceReady&&briefcaseController)briefcaseController.reconcile(false)}
  function workspaceBanner(state,reason){var banner=$('workspaceDegraded'),copy=$('workspaceDegradedCopy'),retry=$('workspaceRetry');if(!banner||!copy||!retry)return;if(!state){banner.hidden=true;retry.hidden=true;retry.disabled=false;delete banner.dataset.state;return}var visible=WORKSPACE_EVENTS.length,summary=tr('Showing the first ','仅显示前 ')+visible+tr(' governed records while the complete workspace is unavailable.',' 条受治理记录；完整工作区暂不可用。');if(reason==='loading')summary=tr('Loading the complete governed workspace…','正在加载完整受治理工作区…');if(reason==='bundle_mismatch')summary=tr('Showing the first ','仅显示前 ')+visible+tr(' governed records because the full workspace belongs to a different evidence cut.',' 条受治理记录，因为完整工作区属于不同的证据截点。');if(reason==='invalid')summary=tr('Showing the first ','仅显示前 ')+visible+tr(' governed records because the full workspace did not pass integrity checks.',' 条受治理记录，因为完整工作区未通过完整性检查。');banner.hidden=false;banner.dataset.state=state;copy.textContent=summary;retry.hidden=reason==='loading';retry.disabled=reason==='loading'}
  function hydrationFailure(code){var error=new Error(code);error.code=code;return error}
  function hydrateWorkspace(force){
    var needs=workspaceNeedsHydration(WORKSPACE)||!!WORKSPACE.next_cursor;
    if(!needs&&!force)return Promise.resolve(false);
    if(!HAS_WORKSPACE||typeof fetch!=='function'){workspaceBanner('degraded','unavailable');return Promise.resolve(false)}
    if(force)workspaceBanner('loading','loading');
    return fetch('government-revenue-data/workspace.json',{credentials:'same-origin'}).then(function(response){if(!response.ok)throw hydrationFailure('unavailable');return response.json()}).then(function(full){if(!obj(full)||!/^government_procurement_workspace\.v[12]$/.test(text(full.schema_version))||!Array.isArray(full.events))throw hydrationFailure('invalid');if(!workspaceBundleMatches(WORKSPACE,full))throw hydrationFailure('bundle_mismatch');var fullEvents=arr(full.events).filter(obj),fullExpected=workspaceExpectedCount(full);if(fullEvents.length<WORKSPACE_EVENTS.length||fullEvents.length<fullExpected)throw hydrationFailure('invalid');var requested='';try{requested=new URLSearchParams(location.search).get('item')||state.selected}catch(e){requested=state.selected}WORKSPACE=full;WORKSPACE_EVENTS=fullEvents;HAS_WORKSPACE=true;workspaceBanner(null);buildRows();populateFilters();$('agencyFilter').value=state.agency;$('tickerFilter').value=state.ticker;state.selected=requested;headline();syncCounts();applyFilters();briefcaseWorkspaceReady=true;if(briefcaseController)briefcaseController.reconcile(true);try{document.dispatchEvent(new CustomEvent('governmentworkspacehydrated',{detail:{events:WORKSPACE_EVENTS.length,bundle_id:WORKSPACE.bundle_id}}))}catch(e){}return true}).catch(function(error){briefcaseWorkspaceReady=false;workspaceBanner('degraded',error&&error.code||'unavailable');return false})
  }
  window.__governmentRevenueRuntime={effectiveFreshnessState:effectiveFreshnessState,workspaceBundleMatches:workspaceBundleMatches,workspaceNeedsHydration:workspaceNeedsHydration,workspaceRows:function(){return rowsByMode.changes.map(function(r){return{kind:r.kind,truth:r.truth,linked:r.linked,defense:r.defense,title:r.title}})}};
  window.__hydrateGovernmentWorkspace=hydrateWorkspace;
  boot(true);
  hydrateWorkspace(false);
})();
