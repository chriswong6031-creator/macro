{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Divergence Radar — real activity vs price', '背离雷达 — 真实活动 vs 价格') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:13px/1.5 Inter,-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:0; }
  .wrap { max-width:1200px; margin:0 auto; padding:12px 16px 40px; }
  header h1 { font-size:20px; margin:0 0 2px; }
  header .sub { color:var(--muted); font-size:12.5px; margin:0 0 12px; max-width:800px; line-height:1.5; }
</style>
</head>
<body class="page-radar">
<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <header>
    <h1>🛰️ {{ t('Divergence Radar', '背离雷达') }}</h1>
    <p class="sub">{{ t(
      'Where independent REAL ACTIVITY — federal contracts, Quiver gov-contracts / congress / lobbying / patents, and modeled news flow — runs AHEAD of or BEHIND price. The radar stays silent when activity and price agree; it speaks only on the divergence. Plus a Claude reading of each theme\'s durability, graded against the tape over time. Display-only context, never a trade trigger.',
      '独立的真实活动 —— 联邦合同、Quiver 政府合同／国会／游说／专利，以及建模新闻流 —— 领先或落后于价格之处。活动与价格一致时雷达保持沉默，只在背离时发声。另含 Claude 对各主题持续力的解读，并随时间对照行情评分。仅供参考，非交易触发。') }}</p>
  </header>

  <section id="divergence-radar" class="panel pad"></section>
</div>

<script src="radar_panel.js"></script>
<script>renderRadarFull({ base: "basketdata/" });</script>
<script src="theme.js"></script>
</body>
</html>
