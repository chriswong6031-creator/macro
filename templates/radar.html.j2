{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Divergence Radar — real activity vs price</title>
{% set seo_title = "Divergence Radar — Mastermind" %}{% set seo_desc = "Real activity vs price — where fundamentals and the tape disagree across US markets. Updated nightly." %}{% set seo_path = "radar.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:13px/1.5 var(--font-ui,Inter,-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif); margin:0; padding:18px 0 0; }
  /* premium page wash — soft, static (no repaint churn), theme-var driven so it flips with dark/light/zh */
  body.page-radar::before { content:''; position:fixed; inset:0; z-index:-1; pointer-events:none;
    background:
      radial-gradient(78% 48% at 12% -6%, color-mix(in srgb, var(--warn) 9%, transparent), transparent 60%),
      radial-gradient(66% 44% at 102% -2%, color-mix(in srgb, var(--info) 8%, transparent), transparent 56%); }
  /* loading skeleton — replaced the moment radar_panel.js mounts */
  .rx-skel { max-width:1180px; margin:0 auto; padding:26px 16px; }
  .rx-skel-bar { height:14px; border-radius:8px; margin:11px 0;
    background:linear-gradient(90deg, var(--panel2) 0%, color-mix(in srgb,var(--muted) 16%,var(--panel2)) 50%, var(--panel2) 100%);
    background-size:200% 100%; animation:rxShimmer 1.3s ease-in-out infinite; }
  @keyframes rxShimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
  @media (prefers-reduced-motion: reduce) { .rx-skel-bar { animation:none } }
</style>
</head>
<body class="page-radar">
{% include "_site_nav.html.j2" %}

<div id="divergence-radar">
  <div class="rx-skel" aria-hidden="true">
    <div class="rx-skel-bar" style="width:38%;height:11px"></div>
    <div class="rx-skel-bar" style="width:72%;height:32px"></div>
    <div class="rx-skel-bar" style="width:52%"></div>
    <div class="rx-skel-bar" style="width:90%;height:118px;margin-top:20px"></div>
    <div class="rx-skel-bar" style="width:100%;height:220px;margin-top:16px"></div>
  </div>
  <noscript>
    <div style="max-width:1180px;margin:0 auto;padding:26px 16px;color:var(--muted)">
      <h1 style="color:var(--text);font-size:24px">🛰️ {{ t('Divergence Radar', '背离雷达') }}</h1>
      <p style="max-width:760px;line-height:1.6">{{ t(
        'Where independent real activity — federal contracts, congress, lobbying, patents and modeled news flow — runs ahead of or behind price. This page needs JavaScript to show the live read. Context only, never a trade signal.',
        '独立的真实活动 —— 联邦合同、国会、游说、专利与建模新闻流 —— 领先或落后于价格之处。本页需要 JavaScript 才能显示实时解读。仅供参考，绝非交易信号。') }}</p>
    </div>
  </noscript>
</div>

<script src="radar_panel.js"></script>
<script>
window.addEventListener("DOMContentLoaded", function () {
  window.renderRadarFull({ base: "basketdata/" });
});
</script>
<script src="theme.js"></script>
</body>
</html>
