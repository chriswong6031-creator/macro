<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Transmission — {{ as_of }}</title>
{% set seo_title = 'Transmission — Rates, Inflation & the Dollar | Mastermind' %}{% set seo_desc = 'The three forces that move every asset — interest rates, inflation and the dollar — read in plain words: what each is doing, who benefits, who gets hurt, and what changed.' %}{% set seo_path = 'transmission.html' %}
{% include "_seo_head.html.j2" %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}}; --green:{{C.green}}; --teal:{{C.teal}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
  /* channel identity hues — every element belonging to a channel wears its hue */
  --ch-rates:#4559DC; --ch-infl:#B45309; --ch-usd:#0F766E;
}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280;--red:#e06464;
  --ch-rates:#8b96f8;--ch-infl:#fbbf24;--ch-usd:#2dd4bf}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px;border-radius:6px}

/* ---------- hero ---------- */
.tx-hero{padding:26px 0 4px;animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.tx-brand{font-weight:800;font-size:26px;color:var(--ink);letter-spacing:-.02em}
.tx-brand .gn{background:linear-gradient(92deg,var(--ch-rates),var(--ch-infl) 55%,var(--ch-usd));-webkit-background-clip:text;background-clip:text;color:transparent}
.tx-sub{color:var(--muted);font-size:14px;margin:4px 0 0}
.tx-verdict{font-size:clamp(21px,3.2vw,30px);font-weight:800;color:var(--ink);letter-spacing:-.022em;line-height:1.28;margin:18px 0 6px;max-width:900px}
.tx-asof{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:var(--muted);margin-top:4px}
.tx-asof .txdot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:txBreathe 2.8s ease-in-out infinite}

/* ---------- what changed ---------- */
.tx-changes{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:18px 0 4px}
.tx-changes .tc-eyebrow{font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin-right:2px}
.tc-chip{display:inline-flex;align-items:center;gap:7px;padding:6px 13px;border-radius:999px;border:1px solid var(--grid);background:var(--card);font-size:12.5px;font-weight:600;color:var(--ink)}
.tc-chip .txdot{width:6px;height:6px;border-radius:50%;background:var(--amber);animation:txBreathe 2.2s ease-in-out infinite;flex:none}
.tc-chip.calm .txdot{background:var(--green)}
.tc-chip.calm{color:var(--muted);font-weight:500}

/* ---------- channel rail ---------- */
.tx-rail{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
@media(max-width:940px){.tx-rail{grid-template-columns:1fr}}
.tx-ch{position:relative;background:var(--card);border:1px solid var(--grid);border-radius:18px;padding:22px 22px 18px;overflow:hidden;
  transition:transform .18s ease,box-shadow .2s ease,border-color .2s ease;animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.tx-ch:nth-child(2){animation-delay:.06s}.tx-ch:nth-child(3){animation-delay:.12s}
.tx-ch:hover{transform:translateY(-2px);box-shadow:0 10px 28px -14px rgba(9,17,40,.28)}
.tx-ch::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:var(--chc)}
.tx-ch.ch-rates{--chc:var(--ch-rates)}.tx-ch.ch-infl{--chc:var(--ch-infl)}.tx-ch.ch-usd{--chc:var(--ch-usd)}
.tx-ch .ch-eyebrow{display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--chc)}
.tx-ch .ch-state{font-size:29px;font-weight:800;letter-spacing:-.028em;color:var(--ink);line-height:1.12;margin:10px 0 2px}
.tx-ch .ch-dir{font-size:12.5px;color:var(--muted);font-weight:600}
.txflow{display:block;width:100%;height:44px;margin:10px 0 6px}
.txflow-base{fill:none;stroke:var(--grid);stroke-width:2}
.txflow-pulse{fill:none;stroke:var(--chc,var(--blue));stroke-width:2.4;stroke-linecap:round;stroke-dasharray:16 84;stroke-dashoffset:100;animation:txFlow 3.6s linear infinite;filter:drop-shadow(0 0 3px color-mix(in srgb,var(--chc,var(--blue)) 55%,transparent))}
.txflow-pulse.ch-rates{--chc:var(--ch-rates)}.txflow-pulse.ch-infl{--chc:var(--ch-infl)}.txflow-pulse.ch-usd{--chc:var(--ch-usd)}
.ch-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:8px 0 2px}
@media(max-width:420px){.ch-facts{grid-template-columns:1fr 1fr}}
.chf .chf-l{font-size:11px;color:var(--muted);line-height:1.3}
.chf .chf-v{font-size:17px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;margin:1px 0}
.chf .chf-m{font-size:11px;color:var(--faint);line-height:1.35}
.ch-extra{font-size:12.5px;color:var(--muted);margin-top:9px;line-height:1.5}
.ch-extra b{color:var(--ink)}
.ch-dots{display:inline-flex;gap:4px;margin-right:7px;vertical-align:middle}
.ch-dots i{width:8px;height:8px;border-radius:50%;background:var(--grid);display:inline-block}
.ch-dots i.on{background:var(--red)}
.ch-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid var(--grid)}
.ch-stance{display:inline-block;padding:5px 13px;border-radius:999px;font-size:12.5px;font-weight:700;
  background:color-mix(in srgb,var(--chc) 11%,var(--card));color:var(--chc);border:1px solid color-mix(in srgb,var(--chc) 30%,var(--grid))}
.ch-more{font-size:12px;color:var(--muted);white-space:nowrap}
.ch-more:hover{color:var(--blue)}
.ch-minichips{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.mchip{display:inline-block;padding:2px 9px;border-radius:7px;font-size:11.5px;font-weight:600}
.mchip.down{background:rgba(211,11,11,.09);color:var(--red)}
.mchip.up{background:rgba(26,127,67,.11);color:var(--green)}
/* the ? help tip — CSS-only bilingual popover (Tier-2 home for mechanics) */
.txq{position:relative;display:inline-flex;align-items:center;justify-content:center;width:17px;height:17px;border-radius:50%;
  border:1px solid var(--grid);color:var(--muted);font-size:11px;font-weight:700;cursor:help;flex:none}
.txq .txq-tip{display:none;position:absolute;top:22px;right:-8px;z-index:30;width:250px;padding:10px 12px;border-radius:11px;
  background:var(--card);border:1px solid var(--grid);box-shadow:0 12px 30px -12px rgba(9,17,40,.35);
  font-size:12px;font-weight:500;color:var(--text);line-height:1.5;text-transform:none;letter-spacing:0}
.txq:hover .txq-tip,.txq:focus .txq-tip{display:block}

/* ---------- section chrome + shared chip system (used by revamp + study shelf) ---------- */
.sec-head{display:flex;align-items:baseline;gap:10px;font-size:12px;font-weight:800;color:var(--ink);text-transform:uppercase;letter-spacing:.07em;margin:34px 0 4px}
.sec-sub{font-size:13px;color:var(--muted);margin:0 0 14px}
.card{background:var(--card);border:1px solid var(--grid);border-radius:18px;padding:22px}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.pm-foot{font-size:12px;color:var(--faint);margin-top:10px}
.achip{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:8px;font-size:11.5px;font-weight:600;background:color-mix(in srgb,var(--grid) 55%,var(--card));color:var(--text);cursor:default}
.lvg{margin-left:2px;font-weight:800;font-size:11px;cursor:help}
.vg-measured{color:var(--green)}.vg-directional{color:var(--amber)}.vg-context{color:var(--faint)}.vg-inverted{color:var(--indigo)}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1fr 1fr}
@media(max-width:900px){.cols-2{grid-template-columns:1fr}}

/* ---------- study shelf ---------- */
.shelf{margin-top:34px}
.shelf details{background:var(--card);border:1px solid var(--grid);border-radius:16px;margin-bottom:12px;overflow:hidden}
.shelf summary{list-style:none;cursor:pointer;padding:16px 22px;display:flex;align-items:center;gap:12px;font-size:14px;font-weight:700;color:var(--ink);transition:background .18s}
.shelf summary::-webkit-details-marker{display:none}
.shelf summary:hover{background:color-mix(in srgb,var(--blue) 5%,var(--card))}
.shelf summary .sh-ic{flex:none;width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;background:color-mix(in srgb,var(--blue) 10%,var(--card))}
.shelf summary .sh-hint{margin-left:auto;font-size:11.5px;font-weight:600;color:var(--faint)}
.shelf summary .sh-caret{flex:none;font-size:11px;color:var(--faint);transition:transform .25s}
.shelf details[open] summary .sh-caret{transform:rotate(90deg)}
.shelf .sh-body{padding:6px 22px 22px;border-top:1px solid var(--grid)}
.sub{font-size:13px;color:var(--muted)}.faint{color:var(--faint)}
.note{font-size:13px;color:var(--muted);line-height:1.6}.note b{color:var(--ink)}
.meta-foot{font-size:12px;color:var(--faint);margin-top:8px}
.tx-disclosure{font-size:12.5px;color:var(--muted);margin:26px 0 0;padding-top:14px;border-top:1px solid var(--grid)}

/* ---------- legacy tier-3 components (yield curve / expectations / receipts) ---------- */
.state-val{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1;margin:4px 0 6px;color:var(--ink)}
.state-val small{font-size:15px;color:var(--muted);font-weight:700}
.band-chip{display:inline-block;padding:4px 12px;border-radius:999px;font-size:12.5px;font-weight:700;color:#fff;letter-spacing:.01em;margin:2px 0}
.kpis{display:flex;gap:14px 20px;flex-wrap:wrap;margin-top:14px}
.kpi{font-size:12px;color:var(--muted)}.kpi b{display:block;font-size:16px;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.flag{display:inline-block;padding:5px 11px;border-radius:8px;font-size:12.5px;font-weight:600;margin-top:10px;line-height:1.4}
.flag.warn{background:rgba(245,173,66,.16);color:#9a6a10}
.flag.info{background:rgba(40,95,255,.10);color:var(--blue)}
.flag.ok{background:rgba(26,127,67,.12);color:var(--green)}
.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-3{grid-template-columns:1fr}}
.decomp{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-top:6px}
.decomp .dc{padding:11px 13px;border-radius:11px;background:color-mix(in srgb,var(--grid) 45%,var(--card))}
.decomp .dc .dcl{font-size:11.5px;color:var(--muted);margin-bottom:3px}
.decomp .dc .dcv{font-size:19px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums}
.decomp .dc .dcn{font-size:11px;color:var(--faint);margin-top:2px}
.pcabar{display:flex;height:14px;border-radius:7px;overflow:hidden;margin:10px 0 4px;border:1px solid var(--grid)}
.pcabar span{display:flex;align-items:center;justify-content:center;font-size:9.5px;font-weight:700;color:#fff;min-width:0;overflow:hidden;white-space:nowrap}
.pcabar .pc-l{background:var(--indigo)}.pcabar .pc-s{background:var(--blue)}.pcabar .pc-c{background:var(--teal)}.pcabar .pc-r{background:var(--faint)}
.pcalegend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:2px}
.pcalegend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:baseline}
.regchip{display:inline-block;padding:6px 15px;border-radius:999px;font-size:16px;font-weight:800;color:#fff;letter-spacing:.01em}
.favrow{display:flex;flex-wrap:wrap;gap:5px;margin-top:3px;align-items:center}
.favrow .fl{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-right:2px}
.favrow .fl.fav{color:var(--green)}.favrow .fl.pres{color:var(--red)}
.tkpill{display:inline-block;padding:2px 8px;border-radius:7px;font-size:11.5px;font-weight:700;font-variant-numeric:tabular-nums}
.tkpill.fav{background:rgba(26,127,67,.12);color:var(--green)}
.tkpill.pres{background:rgba(211,11,11,.10);color:var(--red)}
.recgauges{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin:8px 0 4px}
.recg{padding:9px 11px;border-radius:11px;background:color-mix(in srgb,var(--grid) 45%,var(--card))}
.recg .rgl{font-size:11px;color:var(--muted);line-height:1.3}
.recg .rgv{font-size:18px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;margin-top:1px}
.recg.flag-on{background:rgba(211,11,11,.12)}
.recg.flag-on .rgv{color:var(--red)}
.sectilt{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:7px;margin-top:8px}
.stile{padding:7px 9px;border-radius:10px;font-size:12px;border:1px solid var(--grid);background:var(--card)}
.stile .se{font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums}
.stile .sb{float:right;font-size:9px;font-weight:700;padding:1px 5px;border-radius:5px;background:color-mix(in srgb,var(--grid) 55%,var(--card));color:var(--muted)}
.stile .sb.meas{background:rgba(26,127,67,.14);color:var(--green)}
.stile .sm{font-size:10.5px;color:var(--faint);margin-top:3px;line-height:1.35}
.stile.tail{background:rgba(26,127,67,.07);border-color:rgba(26,127,67,.28)}
.stile.head{background:rgba(211,11,11,.06);border-color:rgba(211,11,11,.28)}
table.slopes{width:100%;border-collapse:collapse;font-size:12.5px}
table.slopes th,table.slopes td{text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)}
table.slopes th:first-child,table.slopes td:first-child{text-align:left}
table.slopes tr:last-child td{border-bottom:none}
table.slopes th{color:var(--muted);font-weight:700;text-transform:uppercase;font-size:10px;letter-spacing:.03em}
table.slopes td{font-variant-numeric:tabular-nums;color:var(--text)}
table.slopes td.nm{color:var(--ink);font-weight:600}
table.slopes td.inv{color:var(--red);font-weight:700}
.facrow{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0}
.facpill{display:inline-flex;flex-direction:column;padding:7px 13px;border-radius:11px;background:color-mix(in srgb,var(--grid) 45%,var(--card));min-width:120px}
.facpill .fk{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.facpill .fv{font-size:15px;font-weight:800;color:var(--ink)}
table.gate{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:8px}
table.gate th,table.gate td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--grid)}
table.gate th{color:var(--muted);font-weight:700;text-transform:uppercase;font-size:10.5px;letter-spacing:.03em}
table.gate td.num{text-align:right;font-variant-numeric:tabular-nums}
.bdkpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(92px,1fr));gap:12px;margin:10px 0 4px}
.bd-tag{font-size:12px;font-weight:700;padding:4px 10px;border-radius:999px;background:var(--grid);color:var(--ink)}
.bd-tag.bd-fall{background:rgba(211,11,11,.10);color:var(--red)}
.bd-tag.bd-rise{background:rgba(26,127,67,.12);color:var(--green)}
.bd b.dn{color:var(--red)} .bd b.up{color:var(--green)}
.bd-badge{margin-top:12px;padding:12px 14px;border-radius:12px;border-left:4px solid var(--faint);background:color-mix(in srgb,var(--grid) 40%,var(--card))}
.bd-badge-h{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
.bd-liquidity{border-left-color:var(--red)} .bd-growth{border-left-color:var(--amber)}
.bd-real_rate{border-left-color:var(--amber)} .bd-oil{border-left-color:var(--teal)}
.bd-reflation{border-left-color:var(--blue)} .bd-quiet{border-left-color:var(--faint)}
.site-footer{max-width:1180px;margin:30px auto 0;padding:18px 20px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;color:var(--muted);font-size:12.5px}

/* ============ REVAMP — soft palette + shared panel chrome (matches the channel rail) ============ */
:root{--drag:#c65b6e;--lift:#2f9270}
html[data-theme="dark"]{--drag:#e58a97;--lift:#54c39a}
.sec-head .sh-dot{width:8px;height:8px;border-radius:3px;background:var(--sh-c,var(--faint));display:inline-block;align-self:center}
.rv-card{background:var(--card);border:1px solid var(--grid);border-radius:18px;padding:22px;position:relative;overflow:hidden;
  animation:txUp .55s cubic-bezier(.2,.7,.3,1) both}
.rv-card::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;background:var(--accent,var(--blue))}
.rv-take{display:flex;align-items:center;gap:12px 14px;flex-wrap:wrap;margin:0 0 15px}
.rv-take .ln{font-size:13.5px;color:var(--text);font-weight:500;line-height:1.45;flex:1;min-width:240px}
.rv-take .ln b{color:var(--ink);font-weight:800}
.rv-stance{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:999px;font-size:12.5px;font-weight:700;white-space:nowrap;
  background:color-mix(in srgb,var(--accent,var(--blue)) 11%,var(--card));color:var(--accent,var(--blue));border:1px solid color-mix(in srgb,var(--accent,var(--blue)) 28%,var(--grid))}
.rv-stance .txdot{width:6px;height:6px;border-radius:50%;background:currentColor;animation:txBreathe 2.4s ease-in-out infinite;flex:none}

/* ---------- pressure board ---------- */
.pb-axis{display:flex;justify-content:space-between;font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;margin:2px 0 8px;color:var(--faint)}
.pb-axis .l{color:var(--drag)}.pb-axis .r{color:var(--lift)}
.pb-row{display:grid;grid-template-columns:minmax(138px,1fr) 1.75fr 84px;align-items:center;gap:14px;padding:8px 0}
.pb-row+.pb-row{border-top:1px solid color-mix(in srgb,var(--grid) 60%,transparent)}
@media(max-width:560px){.pb-row{grid-template-columns:1fr 74px}.pb-track{display:none}}
.pb-name{font-size:13px;font-weight:700;color:var(--ink);line-height:1.18}
.pb-name .sub{display:block;font-size:10.5px;font-weight:500;color:var(--faint);margin-top:1px}
.pb-track{position:relative;height:9px;background:color-mix(in srgb,var(--grid) 50%,var(--card));border-radius:999px}
.pb-track .mid{position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--faint);opacity:.4}
.pb-fill{position:absolute;top:0;bottom:0;border-radius:999px;animation:txGrow .8s cubic-bezier(.2,.7,.3,1) both}
.pb-fill.d{right:50%;background:linear-gradient(270deg,color-mix(in srgb,var(--drag) 58%,transparent),color-mix(in srgb,var(--drag) 20%,transparent));transform-origin:right}
.pb-fill.u{left:50%;background:linear-gradient(90deg,color-mix(in srgb,var(--lift) 58%,transparent),color-mix(in srgb,var(--lift) 20%,transparent));transform-origin:left}
.pb-str{justify-self:end;display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;cursor:help;white-space:nowrap}
.pb-str.d{color:var(--drag)}.pb-str.u{color:var(--lift)}
.pb-str .ar{font-size:9px}

/* ---------- cascade (how a shock travels) ---------- */
.cx-wrap{display:grid;gap:14px}
.cx-card{--accent:var(--ch-rates);overflow:visible}
.cx-card::before{border-radius:18px 18px 0 0}
.cx-card.c-infl{--accent:var(--ch-infl)}
.cx-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.cx-eyebrow{font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}
.cx-title{font-size:17px;font-weight:800;letter-spacing:-.02em;color:var(--ink);line-height:1.15}
.cx-live{margin-left:auto;display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--accent);
  padding:3px 11px;border-radius:999px;background:color-mix(in srgb,var(--accent) 10%,var(--card))}
.cx-live i{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:txBreathe 2s ease-in-out infinite}
.cx-trigger{font-size:12px;color:var(--muted);margin:7px 0 2px}
.cx-trigger b{color:var(--text);font-weight:600}
.cx-flow{margin-top:15px}
.cx-step{display:grid;grid-template-columns:30px 1fr;gap:14px;position:relative;padding-bottom:15px}
.cx-step:last-child{padding-bottom:0}
.cx-step:not(:last-child)::before{content:'';position:absolute;left:14px;top:30px;bottom:-3px;width:2px;border-radius:2px;
  background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 60%,transparent) 0%,color-mix(in srgb,var(--accent) 13%,var(--grid)) 26%,color-mix(in srgb,var(--accent) 13%,var(--grid)) 100%);
  background-size:100% 230%;animation:cxFlow 2.5s linear infinite}
.cx-num{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;z-index:1;
  color:var(--accent);background:color-mix(in srgb,var(--accent) 13%,var(--card));border:1px solid color-mix(in srgb,var(--accent) 32%,var(--grid))}
.cx-phrase{font-size:14px;font-weight:700;color:var(--ink);line-height:1.35;display:flex;align-items:flex-start;gap:6px;padding-top:5px}
.cx-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.cx-chips .achip{background:color-mix(in srgb,var(--grid) 45%,var(--card));font-weight:600}
.cx-chips .achip.ac-head{color:var(--drag);background:color-mix(in srgb,var(--drag) 11%,var(--card))}
.cx-chips .achip.ac-tail{color:var(--lift);background:color-mix(in srgb,var(--lift) 12%,var(--card))}
.cx-chips .achip.ac-neut{color:var(--muted);opacity:.75}
.cx-quiet{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:4px 20px;margin-top:14px}
.cx-quiet .q{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 0;font-size:13px}
.cx-quiet .q+.q{border-top:1px solid color-mix(in srgb,var(--grid) 60%,transparent)}
.cx-quiet .q .nm{font-weight:600;color:var(--text)}
.cx-quiet .q .nm .em{margin-right:9px;opacity:.8}
.cx-quiet .q .tag{font-size:10.5px;font-weight:700;color:var(--faint);text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}

/* ---------- scenarios (if this holds for three months) ---------- */
.sx-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:820px){.sx-grid{grid-template-columns:1fr}}
.sx-card{--accent:var(--ch-rates)}
.sx-card.c-infl{--accent:var(--ch-infl)}
.sx-head{display:flex;align-items:flex-start;gap:11px}
.sx-mark{width:36px;height:36px;border-radius:10px;flex:none;display:flex;align-items:center;justify-content:center;font-size:17px;
  background:color-mix(in srgb,var(--accent) 12%,var(--card))}
.sx-title{font-size:15px;font-weight:800;color:var(--ink);letter-spacing:-.01em;line-height:1.2}
.sx-spec{font-size:11.5px;color:var(--muted);margin-top:2px}
.sx-cols{display:grid;grid-template-columns:1fr 1fr;gap:12px 18px;margin-top:15px}
@media(max-width:420px){.sx-cols{grid-template-columns:1fr}}
.sx-col .cl{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
.sx-col.h .cl{color:var(--drag)}.sx-col.t .cl{color:var(--lift)}
.sx-item{display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:8px;padding:4px 0 5px}
.sx-item .nm{font-size:12px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sx-item .v{font-variant-numeric:tabular-nums;font-weight:700;font-size:11.5px}
.sx-item .v.d{color:var(--drag)}.sx-item .v.u{color:var(--lift)}
.sx-bar{grid-column:1/-1;height:4px;border-radius:2px;background:color-mix(in srgb,var(--grid) 55%,var(--card));overflow:hidden;margin-top:2px}
.sx-bar i{display:block;height:100%;border-radius:2px;animation:txGrow .7s ease both;transform-origin:left}
.sx-bar i.d{background:color-mix(in srgb,var(--drag) 52%,transparent)}
.sx-bar i.u{background:color-mix(in srgb,var(--lift) 52%,transparent)}
.sx-more{font-size:11px;color:var(--faint);margin-top:6px}
.sx-none{font-size:12px;color:var(--faint);padding:4px 0}

/* ---------- motion ---------- */
@keyframes cxFlow{from{background-position:0 -55%}to{background-position:0 165%}}
@keyframes txFlow{to{stroke-dashoffset:0}}
@keyframes txBreathe{0%,100%{opacity:.45;transform:scale(.85)}50%{opacity:1;transform:scale(1.1)}}
@keyframes txUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes txGrow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@media (prefers-reduced-motion: reduce){
  .txflow-pulse,.txdot,.tc-chip .txdot,.chain-state.on i{animation:none}
  .tx-hero,.tx-ch,.pm-fill{animation:none}
  .rv-card,.pb-fill,.sx-bar i,.cx-live i,.rv-stance .txdot{animation:none}
  .cx-step:not(:last-child)::before{background:color-mix(in srgb,var(--accent) 20%,var(--grid));animation:none}
  *{transition:none!important}
}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav" style="max-width:1180px;margin:18px auto 16px;padding:0 20px">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  {% set S = tx.state %}

  {# ---- plain-language maps (Tier-1 rewrites; machine receipts stay on hover) ---- #}
  {% set CH_META = {
    'real_rate':       {'ti':{'en':'Higher real rates','zh':'实际利率走高'},          'ch':'rates','trig':{'en':'the real 10-year yield rising fast','zh':'实际10年期收益率快速上行'}},
    'sticky_inflation':{'ti':{'en':'Sticky inflation','zh':'通胀粘性'},               'ch':'infl', 'trig':{'en':'core inflation stuck above the 2% goal','zh':'核心通胀高于2%目标'}},
    'policy_easing':   {'ti':{'en':'Rate cuts & a steeper curve','zh':'降息与曲线变陡'}, 'ch':'rates','trig':{'en':'the market starting to price rate cuts','zh':'市场开始计入降息'}},
    'expectations':    {'ti':{'en':'Inflation expectations drifting','zh':'通胀预期漂移'},   'ch':'infl', 'trig':{'en':'expectations pulling above model & survey','zh':'预期高于模型与调查'}}
  } %}
  {% set CH_STEP = {
    'real_rate':        {1:{'en':'Long-lived assets fall first','zh':'长久期资产首先承压'},
                         2:{'en':'A firmer dollar squeezes commodities & emerging markets','zh':'美元走强挤压大宗与新兴市场'},
                         3:{'en':'Cyclicals lag; financials are relatively spared','zh':'周期股落后，金融相对抗跌'}},
    'sticky_inflation': {1:{'en':'Markets price rates higher for longer','zh':'市场定价利率更高更久'},
                         2:{'en':'Small caps & rate-sensitive borrowers get squeezed','zh':'小盘与利率敏感借款方承压'},
                         3:{'en':'Defensives hold up better','zh':'防御板块相对抗跌'}},
    'policy_easing':    {1:{'en':'Short-term rates fall; long bonds rally','zh':'短端下行，久期资产上涨'},
                         2:{'en':'Banks & rate-sensitive property improve','zh':'银行与利率敏感地产改善'},
                         3:{'en':'Small caps & cyclicals lead a risk-on turn','zh':'小盘与周期股领涨风险偏好'}},
    'expectations':     {1:{'en':'Un-anchoring risk; the dollar firms','zh':'脱锚风险，美元走强'},
                         2:{'en':'Real yields rise; growth stocks fall, defensives favoured','zh':'实际收益率上行，成长承压、防御受青睐'},
                         3:{'en':'Gold, the classic inflation hedge, is unreliable here','zh':'黄金这一经典通胀对冲在此并不可靠'}}
  } %}
  {% set SC_META = {
    'real_up50':{'ti':{'en':'If real rates rise further','zh':'若实际利率进一步走高'}, 'em':'📈','ch':'rates','spec':{'en':'real 10-year yield up ~0.5%','zh':'实际10年利率上行约0.5%'}},
    'real_dn50':{'ti':{'en':'If rates ease off','zh':'若利率回落'},               'em':'📉','ch':'rates','spec':{'en':'real 10-year yield down ~0.5%','zh':'实际10年利率下行约0.5%'}},
    'be_up30':  {'ti':{'en':'If an inflation scare hits','zh':'若通胀预期升温'},    'em':'🔥','ch':'infl', 'spec':{'en':'inflation expectations up ~0.3%','zh':'通胀预期上行约0.3%'}},
    'steepen':  {'ti':{'en':'If cuts steepen the curve','zh':'若降息使曲线变陡'},    'em':'📐','ch':'rates','spec':{'en':'yield curve steepens ~0.5%','zh':'收益率曲线变陡约0.5%'}}
  } %}

  <!-- ===================== HERO ===================== -->
  <header class="tx-hero">
    <div class="tx-brand">🔀 <span class="gn">{{ t('Transmission', '传导') }}</span></div>
    <p class="tx-sub">{{ t('How rates, inflation and the dollar push on every asset we track.', '利率、通胀与美元如何推动我们跟踪的每一类资产。') }}</p>
    {% if hero and hero.line %}<div class="tx-verdict">{{ b(hero.line) }}</div>{% endif %}
    <div class="tx-asof"><span class="txdot"></span>{{ t('As of', '截至') }} {{ as_of }} · {{ t('context, not trade calls', '仅为背景，非交易信号') }}</div>
  </header>

  <!-- ===================== WHAT CHANGED ===================== -->
  {% if changes and changes.vs_asof %}
  <div class="tx-changes">
    <span class="tc-eyebrow">{{ t('What changed', '最新变化') }}</span>
    {% if changes['items'] %}
      {% for it in changes['items'] %}
      <span class="tc-chip"><span class="txdot"></span>{{ t(it.en, it.zh) }}</span>
      {% endfor %}
    {% else %}
      <span class="tc-chip calm"><span class="txdot"></span>{{ t('No regime changes since ' ~ changes.vs_asof ~ '.', '自 ' ~ changes.vs_asof ~ ' 以来无状态变化。') }}</span>
    {% endif %}
  </div>
  {% endif %}

  <!-- ===================== CHANNEL RAIL ===================== -->
  <div class="tx-rail">

    <!-- Rates -->
    <section class="tx-ch ch-rates">
      <div class="ch-eyebrow">{{ t('Rates', '利率') }}
        <span class="txq" tabindex="0">?<span class="txq-tip">{{ t('The real 10-year yield is the interest rate after inflation — the true cost of money. High and rising real yields pull money out of risk assets; falling ones push it back in.', '实际10年利率 = 名义利率减去通胀，即资金的真实成本。实际利率上行会从风险资产抽走资金，下行则相反。') }}</span></span>
      </div>
      {% if hero %}<div class="ch-state">{{ b(hero.rates.state) }}</div>{% endif %}
      <div class="ch-dir">{{ '%.2f'|format(S.rates.real_10y) if S.rates.real_10y is not none else '—' }}% {{ t('real 10-year yield', '实际10年利率') }}{% if S.rates.real_10y_pctile is not none %} · {{ t('higher than ' ~ ((S.rates.real_10y_pctile*100)|round|int) ~ '% of the past decade', '高于过去十年' ~ ((S.rates.real_10y_pctile*100)|round|int) ~ '%的时间') }}{% endif %}</div>
      {{ flowline({'rising':'up','falling':'down','stable':'flat'}.get(S.rates.direction,'flat'), 'rates') }}
      <div class="ch-facts">
        <div class="chf"><div class="chf-l">{{ t('10-year rate', '10年利率') }}</div><div class="chf-v">{{ '%.2f'|format(S.rates.nominal_10y) if S.rates.nominal_10y is not none else '—' }}%</div><div class="chf-m">{{ t('what the market charges', '市场定价') }}</div></div>
        <div class="chf"><div class="chf-l">{{ t('Yield curve', '收益率曲线') }}</div><div class="chf-v">{{ '%+.2f'|format(S.rates.curve_2s10s) if S.rates.curve_2s10s is not none else '—' }}</div><div class="chf-m">{{ t('inverted — short above long', '倒挂——短端高于长端') if S.rates.curve_2s10s is not none and S.rates.curve_2s10s < 0 else t('upward-sloping — normal', '向上倾斜——正常') }}</div></div>
        <div class="chf"><div class="chf-l">{{ t('Fed stance', '美联储立场') }}</div><div class="chf-v">{{ t({'restrictive':'Tight','accommodative':'Easy','neutral':'Neutral'}.get(S.rates.regime, S.rates.regime|capitalize), {'restrictive':'偏紧','accommodative':'宽松','neutral':'中性'}.get(S.rates.regime, S.rates.regime)) }}</div><div class="chf-m">{{ t({'rising':'and pressing harder','falling':'and easing off','stable':'and holding'}.get(S.rates.direction,''), {'rising':'且仍在收紧','falling':'且正在放松','stable':'且保持不变'}.get(S.rates.direction,'')) }}</div></div>
      </div>
      {% if yc and yc.recession %}
      <div class="ch-extra"><span class="ch-dots">{% for i in range(4) %}<i class="{{ 'on' if i < yc.recession.n_flags }}"></i>{% endfor %}</span>{{ t((yc.recession.n_flags|string) ~ ' of 4 recession warning signs lit', '4项衰退预警中亮起' ~ yc.recession.n_flags ~ '项') }}</div>
      {% endif %}
      <div class="ch-foot">
        {% if hero %}<span class="ch-stance">{{ b(hero.rates.stance) }}</span>{% endif %}
        <a class="ch-more" href="#shelf-yc">{{ t('Full curve detail ↓', '曲线详情 ↓') }}</a>
      </div>
    </section>

    <!-- Inflation -->
    <section class="tx-ch ch-infl">
      <div class="ch-eyebrow">{{ t('Inflation', '通胀') }}
        <span class="txq" tabindex="0">?<span class="txq-tip">{{ t('Core PCE is the Fed\'s preferred inflation gauge; its 2% target drives rate policy. "Anchored" expectations mean markets still trust that target — the single most important thing to watch.', '核心PCE是美联储最看重的通胀指标，2%目标决定利率政策。“预期锚定”表示市场仍相信该目标——这是最关键的观察点。') }}</span></span>
      </div>
      {% if hero %}<div class="ch-state">{{ b(hero.inflation.state) }}</div>{% endif %}
      <div class="ch-dir">{{ '%.1f'|format(S.inflation.core_pce_yoy) if S.inflation.core_pce_yoy is not none else '—' }}% {{ t('core inflation', '核心通胀') }}{% if S.inflation.core_pce_yoy is not none %} · {% set gap = S.inflation.core_pce_yoy - 2.0 %}{{ t(('%.1f'|format(gap|abs)) ~ 'pp ' ~ ('above' if gap > 0.05 else 'below' if gap < -0.05 else 'at') ~ " the Fed's 2% goal", ('高于' if gap > 0.05 else '低于' if gap < -0.05 else '正处') ~ '美联储2%目标' ~ ('%.1f'|format(gap|abs)) ~ '个百分点') }}{% endif %}</div>
      {{ flowline({'re-accelerating':'up','cooling':'down','steady':'flat'}.get(S.inflation.direction,'flat'), 'infl') }}
      <div class="ch-facts">
        <div class="chf"><div class="chf-l">{{ t('Core CPI', '核心CPI') }}</div><div class="chf-v">{{ '%.1f'|format(S.inflation.core_cpi_yoy) if S.inflation.core_cpi_yoy is not none else '—' }}%</div><div class="chf-m">{{ t('the headline cousin', '常见口径') }}</div></div>
        <div class="chf"><div class="chf-l">{{ t('Direction', '方向') }}</div><div class="chf-v">{{ t({'re-accelerating':'Heating','cooling':'Cooling','steady':'Steady'}.get(S.inflation.direction, S.inflation.direction|capitalize), {'re-accelerating':'升温','cooling':'降温','steady':'平稳'}.get(S.inflation.direction, S.inflation.direction)) }}</div><div class="chf-m">{{ t('trend over recent months', '近几个月趋势') }}</div></div>
        <div class="chf"><div class="chf-l">{{ t('Expectations', '通胀预期') }}</div><div class="chf-v">{{ t({'anchored':'Anchored','drifting up':'Drifting up','drifting down':'Drifting down'}.get(S.expectations.anchoring, S.expectations.anchoring|capitalize), {'anchored':'锚定','drifting up':'上行脱锚','drifting down':'下移'}.get(S.expectations.anchoring, S.expectations.anchoring)) }}</div><div class="chf-m">{{ t('what markets price long-run', '市场的长期定价') }}</div></div>
      </div>
      {% if tx.inflation_decomposition and tx.inflation_decomposition.shelter_yoy is not none %}
      <div class="ch-extra">{{ t('The sticky part: housing costs still running', '最具粘性的部分：住房成本仍达') }} <b>{{ '%.1f'|format(tx.inflation_decomposition.shelter_yoy) }}%</b>{{ t(' — rents adjust slowly.', '——租金调整缓慢。') }}</div>
      {% endif %}
      <div class="ch-foot">
        {% if hero %}<span class="ch-stance">{{ b(hero.inflation.stance) }}</span>{% endif %}
        <a class="ch-more" href="#shelf-infl">{{ t('Full detail ↓', '详情 ↓') }}</a>
      </div>
    </section>

    <!-- Dollar -->
    <section class="tx-ch ch-usd">
      <div class="ch-eyebrow">{{ t('Dollar', '美元') }}
        <span class="txq" tabindex="0">{{ '?' }}<span class="txq-tip">{{ t('Most world trade and debt is priced in dollars, so a strong dollar squeezes commodities, emerging markets and US exporters; a weak one relieves them. Read from the broad trade-weighted dollar index.', '全球多数贸易与债务以美元计价：美元走强会挤压大宗商品、新兴市场与美国出口商，走弱则相反。数据取自广义贸易加权美元指数。') }}</span></span>
      </div>
      {% if dx %}
      {% if dx.state %}<div class="ch-state">{{ b(dx.state) }}</div>{% endif %}
      <div class="ch-dir">{% if dx.roc_pct is not none %}{{ '%+.1f'|format(dx.roc_pct) }}% {{ t('over the past month', '近一个月') }}{% else %}{{ t('broad trade-weighted dollar', '广义贸易加权美元') }}{% endif %}</div>
      {{ flowline({'strengthening':'up','weakening':'down','flat':'flat'}.get(dx.usd_dir,'flat'), 'usd') }}
      <div class="ch-facts">
        <div class="chf"><div class="chf-l">{{ t('Trend', '趋势') }}</div><div class="chf-v">{{ t({'strengthening':'Rising','weakening':'Falling','flat':'Flat'}.get(dx.usd_dir,'—'), {'strengthening':'走强','weakening':'走软','flat':'横盘'}.get(dx.usd_dir,'—')) }}</div><div class="chf-m">{{ t('vs major trade partners', '相对主要贸易伙伴') }}</div></div>
        {# dollar_desk 'dir' vocabulary is DOLLAR-framed: supportive = net liquidity
           draining (USD up) · soft = adding (USD-soft) — see forex_dollar.liquidity() #}
        <div class="chf"><div class="chf-l">{{ t('Fed liquidity', '美元流动性') }}</div><div class="chf-v">{{ t({'supportive':'Draining','soft':'Adding','neutral':'Flat'}.get(dx.liquidity_dir, dx.liquidity_dir|capitalize if dx.liquidity_dir else '—'), {'supportive':'抽紧','soft':'投放','neutral':'持平'}.get(dx.liquidity_dir, dx.liquidity_dir if dx.liquidity_dir else '—')) }}</div><div class="chf-m">{{ t('fuel for risk assets', '风险资产的燃料') }}</div></div>
        <div class="chf"><div class="chf-l">{{ t('FX stress', '汇市压力') }}</div><div class="chf-v">{{ b(dx.scenario.label) if dx.scenario and dx.scenario.label else t('None', '无') }}</div><div class="chf-m">{{ t('stress scenario active now', '当前触发的压力情景') if dx.scenario else t('no stress scenario active', '无压力情景触发') }}</div></div>
      </div>
      {% if dx.headwind_for or dx.tailwind_for %}
      <div class="ch-minichips">
        {% for a in (dx.headwind_for or [])[:3] %}<span class="mchip down">▾ {{ b(a) }}</span>{% endfor %}
        {% for a in (dx.tailwind_for or [])[:3] %}<span class="mchip up">▴ {{ b(a) }}</span>{% endfor %}
      </div>
      {% endif %}
      <div class="ch-foot">
        {% if hero %}<span class="ch-stance">{{ b(hero.dollar.stance) }}</span>{% endif %}
        <a class="ch-more" href="forex.html">{{ t('Full dollar desk →', '美元台 →') }}</a>
      </div>
      {% else %}
      <div class="ch-state">{{ t('No read', '暂无读数') }}</div>
      <p class="sub" style="margin-top:8px">{{ t('The dollar read is unavailable this build. It returns on the next nightly update.', '本次构建暂无美元读数，下一次夜间更新恢复。') }}</p>
      <div class="ch-foot"><span></span><a class="ch-more" href="forex.html">{{ t('Full dollar desk →', '美元台 →') }}</a></div>
      {% endif %}
    </section>
  </div>

  <!-- ===================== PRESSURE MAP ===================== -->
  {% set prows = ((tx.headwinds or []) + (tx.tailwinds or []))|sort(attribute='net') %}
  {% if prows %}
  {# true counts from the uncapped read (the headwinds/tailwinds lists are capped at 6) #}
  {% set _tv = (tx.transmission.values()|list) if tx.transmission else [] %}
  {% set n_head = (_tv|selectattr('verdict','equalto','headwind')|list|length) or ((tx.headwinds or [])|length) %}
  {% set n_tail = (_tv|selectattr('verdict','equalto','tailwind')|list|length) or ((tx.tailwinds or [])|length) %}
  {% set n_uni = (_tv|length) or ((tx.headwinds or [])|length + (tx.tailwinds or [])|length) %}
  <div class="sec-head"><span class="sh-dot" style="--sh-c:var(--blue)"></span>{{ t('Who benefits · who gets hurt', '谁受益 · 谁承压') }}</div>
  <p class="sec-sub">{{ t('The combined push of today\'s rates and inflation on each asset we track.', '当前利率与通胀对我们跟踪的每类资产的综合作用。') }}</p>
  <div class="rv-card" style="--accent:var(--blue)">
    <div class="rv-take">
      <div class="ln">
        {% if n_head and n_tail %}
        <span class="l-en">Rates and inflation are the dominant force today — <b>{{ n_head }} of {{ n_uni }} assets</b> pushed down, only <b>{{ n_tail }} getting a lift</b>.</span>
        <span class="l-zh">当前利率与通胀是主导力量——<b>{{ n_uni }} 类资产中 {{ n_head }} 类承压</b>，仅 <b>{{ n_tail }} 类受益</b>。</span>
        {% elif n_tail %}
        <span class="l-en">Everything we track is <b>catching a lift</b> from today's rate and inflation mix.</span>
        <span class="l-zh">当前利率与通胀组合下，我们跟踪的资产<b>普遍受益</b>。</span>
        {% else %}
        <span class="l-en">Everything we track is <b>under pressure</b> from today's rate and inflation mix.</span>
        <span class="l-zh">当前利率与通胀组合下，我们跟踪的资产<b>普遍承压</b>。</span>
        {% endif %}
      </div>
      <span class="rv-stance"><span class="txdot"></span>{% if n_head >= n_tail %}{{ t('Broad pressure — watch, don\'t chase', '普遍承压——观望，勿追') }}{% else %}{{ t('Turning supportive — don\'t chase', '转向支撑——勿追高') }}{% endif %}</span>
    </div>
    <div class="pb-axis"><span class="l">◂ {{ t('pushed down','承压') }}</span><span class="r">{{ t('pushed up','推升') }} ▸</span></div>
    {% set allabs = prows|map(attribute='net')|map('abs')|list %}{% set pscale = (allabs|max) or 1 %}
    {% for h in prows %}
    {% set w = ((h.net|abs) / pscale * 48)|round(1) %}
    {% set frac = (h.net|abs) / pscale %}
    {% set up = h.net >= 0 %}
    {% set zl = h.label.zh.replace('(','（').replace(')','）') %}
    <div class="pb-row">
      <span class="pb-name">
        <span class="l-en">{{ h.label.en.split(' (')[0] }}{% if ' (' in h.label.en %}<span class="sub">{{ h.label.en.split(' (',1)[1][:-1] }}</span>{% endif %}</span>
        <span class="l-zh">{{ zl.split('（')[0] }}{% if '（' in zl %}<span class="sub">{{ zl.split('（',1)[1].replace('）','') }}</span>{% endif %}</span>
      </span>
      <span class="pb-track"><span class="mid"></span><span class="pb-fill {{ 'u' if up else 'd' }}" style="width:{{ w }}%;animation-delay:{{ loop.index0 * 55 }}ms"></span></span>
      <span class="pb-str {{ 'u' if up else 'd' }}"{% if h.top_drivers %} title="net force {{ '%+.2f'|format(h.net) }} · drivers: {% for p in h.top_drivers %}{{ p.label }} ({{ p.verdict|lower }}){% if not loop.last %} · {% endif %}{% endfor %}"{% endif %}><span class="ar">{{ '▲' if up else '▼' }}</span><span class="l-en">{{ 'Strong' if frac>=0.7 else 'Moderate' if frac>=0.4 else 'Mild' }}</span><span class="l-zh">{{ '强' if frac>=0.7 else '中等' if frac>=0.4 else '轻微' }}</span></span>
    </div>
    {% endfor %}
    <p class="pm-foot">{{ t('Showing the strongest movers on each side. Bar length = how hard the measured forces are pushing; hover a label for the exact score and its drivers.', '仅显示各方向最强的资产。柱长＝实测力量推动的强度；悬停标签查看精确评分与驱动因素。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== CHAINS ===================== -->
  <div class="sec-head"><span class="sh-dot" style="--sh-c:var(--ch-rates)"></span>{{ t('How a shock travels', '冲击如何传导') }}</div>
  <p class="sec-sub">{{ t('The direct hit first, then the knock-on effects in order. Hover a step for the full mechanism.', '先是直接冲击，再按顺序层层传导。悬停某一步查看完整机制。') }}</p>
  <div class="cx-wrap">
  {% for ch in tx.chains if ch.active %}
  {% set meta = CH_META.get(ch.id, {'ti':ch.title,'ch':'rates','trig':none}) %}
  <div class="rv-card cx-card c-{{ meta.ch }}">
    <div class="cx-head">
      <span class="cx-eyebrow">{{ t('Rates channel','利率通道') if meta.ch=='rates' else t('Inflation channel','通胀通道') if meta.ch=='infl' else t('Dollar channel','美元通道') }}</span>
      <span class="cx-title">{{ b(meta.ti) }}</span>
      <span class="cx-live"><i></i>{{ t('Active now','当前活跃') }}</span>
    </div>
    {% if meta.trig %}<div class="cx-trigger">{{ t('Triggered by','触发因素：') }} <b>{{ b(meta.trig) }}</b></div>{% endif %}
    <div class="cx-flow">
    {% for o in ch.orders %}
    {% set phrase = CH_STEP.get(ch.id, {}).get(o.order) %}
    <div class="cx-step">
      <span class="cx-num">{{ o.order }}</span>
      <div>
        <div class="cx-phrase">{% if phrase %}<span>{{ b(phrase) }}</span><span class="txq" tabindex="0">?<span class="txq-tip">{{ b(o.text) }}</span></span>{% else %}<span><span class="l-en">{{ o.text.en }}</span><span class="l-zh">{{ o.text.zh }}</span></span>{% endif %}</div>
        <div class="cx-chips">{% for c in o.assets %}<span class="achip {{ 'ac-tail' if c.effect=='tailwind' else 'ac-head' if c.effect=='headwind' else 'ac-neut' }}"{% if c.ic is not none %} title="measured effect {{ '%+.2f'|format(c.ic) }} ({{ c.verdict|lower }})"{% endif %}>{{ c.label.split(' (')[0] }}{{ vg(c.verdict) }}</span>{% endfor %}</div>
      </div>
    </div>
    {% endfor %}
    </div>
  </div>
  {% endfor %}
  </div>
  {% set quiet = tx.chains|rejectattr('active')|list %}
  {% if quiet %}
  <div class="cx-quiet">
    {% for ch in quiet %}
    {% set meta = CH_META.get(ch.id, {'ti':ch.title,'ch':'rates'}) %}
    <div class="q"><span class="nm"><span class="em">{{ '💧' if ch.id=='policy_easing' else '🧭' if ch.id=='expectations' else '•' }}</span>{{ b(meta.ti) }}</span><span class="tag">{{ t('quiet now', '暂时静默') }}</span></div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ===================== SCENARIOS ===================== -->
  <div class="sec-head"><span class="sh-dot" style="--sh-c:var(--ch-infl)"></span>{{ t('If this holds for three months', '若持续三个月') }}</div>
  <p class="sec-sub">{{ t('What each shock has historically meant for prices — illustrations from past episodes, not forecasts.', '各类冲击在历史上对价格的含义——取自过往情形的示意，并非预测。') }}</p>
  <div class="sx-grid">
  {% for sc in tx.scenarios %}
  {% set meta = SC_META.get(sc.key, {'ti':sc.label,'em':'•','ch':'rates','spec':none}) %}
  {% set allm = (sc.headwinds + sc.tailwinds)|map(attribute='implied_move_pct')|map('abs')|list %}{% set smax = (allm|max) or 1 %}
    <div class="rv-card sx-card c-{{ meta.ch }}">
      <div class="sx-head">
        <span class="sx-mark">{{ meta.em }}</span>
        <div><div class="sx-title">{{ b(meta.ti) }}</div>{% if meta.spec %}<div class="sx-spec">{{ b(meta.spec) }}</div>{% endif %}</div>
      </div>
      <div class="sx-cols">
        <div class="sx-col h"><div class="cl">{{ t('Pressured','承压') }}</div>
          {% for m in sc.headwinds[:4] %}
          <div class="sx-item"><span class="nm">{{ (m.label.en if m.label is mapping else m.label).split(' (')[0] }}</span><span class="v d">{{ '%.1f'|format(m.implied_move_pct) }}%</span><span class="sx-bar"><i class="d" style="width:{{ ((m.implied_move_pct|abs)/smax*100)|round(1) }}%"></i></span></div>
          {% else %}<div class="sx-none">{{ t('none','无') }}</div>{% endfor %}
          {% if sc.headwinds|length > 4 %}<div class="sx-more">+{{ sc.headwinds|length - 4 }} {{ t('more','项') }}</div>{% endif %}
        </div>
        <div class="sx-col t"><div class="cl">{{ t('Favoured','受益') }}</div>
          {% for m in sc.tailwinds[:4] %}
          <div class="sx-item"><span class="nm">{{ (m.label.en if m.label is mapping else m.label).split(' (')[0] }}</span><span class="v u">+{{ '%.1f'|format(m.implied_move_pct) }}%</span><span class="sx-bar"><i class="u" style="width:{{ ((m.implied_move_pct|abs)/smax*100)|round(1) }}%"></i></span></div>
          {% else %}<div class="sx-none">{{ t('none','无') }}</div>{% endfor %}
          {% if sc.tailwinds|length > 4 %}<div class="sx-more">+{{ sc.tailwinds|length - 4 }} {{ t('more','项') }}</div>{% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
  </div>

  <!-- ===================== STUDY SHELF (tier 3) ===================== -->
  <div class="sec-head" id="shelf">{{ t('The study shelf', '深度研究区') }}</div>
  <p class="sec-sub">{{ t('Everything above, with the machinery showing — for readers who want the receipts.', '以上全部内容的完整技术细节——供想查看依据的读者。') }}</p>
  <div class="shelf">

    {% if yc %}
    <details id="shelf-yc">
      <summary><span class="sh-ic">📈</span>{{ t('Yield curve — the full read', '收益率曲线——完整解读') }}<span class="sh-hint">{{ t('shape · regime · recession · signals', '形态 · 状态 · 衰退 · 信号') }}</span><span class="sh-caret">▶</span></summary>
      <div class="sh-body">
      <p class="sub" style="margin:12px 0 14px">{{ b(yc.signals.core_macro) }}</p>
      <div class="grid cols-3">
        <div class="card">
          <h2>{{ t('Curve shape', '曲线形态') }}</h2>
          {% set SH = yc.shape %}
          <div class="decomp" style="grid-template-columns:1fr 1fr 1fr">
            <div class="dc"><div class="dcl">{{ t('Level (avg yield)','水平（平均收益率）') }}</div><div class="dcv">{{ '%.2f'|format(SH.level.value) if SH.level.value is not none else '—' }}<small style="font-size:11px;color:var(--muted)">%</small></div><div class="dcn">{{ t('pctile','分位') }} {{ pct(SH.level.pctile) }} · {{ '%+d'|format(SH.level.chg_63d|int) if SH.level.chg_63d is not none else '—' }}bp/63d</div></div>
            <div class="dc"><div class="dcl">{{ t('Slope (2s10s)','斜率（2-10年）') }}</div><div class="dcv">{{ '%+.2f'|format(SH.slope_2s10s.value) if SH.slope_2s10s.value is not none else '—' }}</div><div class="dcn">{{ t('pctile','分位') }} {{ pct(SH.slope_2s10s.pctile) }} · {{ '%+d'|format(SH.slope_2s10s.chg_63d|int) if SH.slope_2s10s.chg_63d is not none else '—' }}bp/63d</div></div>
            <div class="dc"><div class="dcl">{{ t('Curvature (2s5s10s fly)','曲率（2-5-10年蝶式）') }}</div><div class="dcv">{{ '%+.2f'|format(SH.fly_2s5s10s.value) if SH.fly_2s5s10s.value is not none else '—' }}</div><div class="dcn">{{ t('pctile','分位') }} {{ pct(SH.fly_2s5s10s.pctile) }} · {{ t('+ humped / − bowed','+隆起／−凹陷') }}</div></div>
          </div>
          {% if SH.pca and SH.pca.factors %}
          <div style="margin-top:12px">
            <div class="sub" style="font-size:11.5px">{{ t('Principal components of daily curve changes (Litterman-Scheinkman)','日度曲线变动的主成分（Litterman-Scheinkman）') }}</div>
            <div class="pcabar">
              {% for fct in SH.pca.factors %}<span class="{{ 'pc-l' if fct.key=='level' else 'pc-s' if fct.key=='slope' else 'pc-c' }}" style="width:{{ (fct.var_explained*100)|round(1) }}%">{{ (fct.var_explained*100)|round|int }}%</span>{% endfor %}
              {% set resid = 1 - SH.pca.first3_var %}{% if resid and resid > 0.005 %}<span class="pc-r" style="width:{{ (resid*100)|round(1) }}%"></span>{% endif %}
            </div>
            <div class="pcalegend"><span><i style="background:var(--indigo)"></i>{{ t('Level','水平') }}</span><span><i style="background:var(--blue)"></i>{{ t('Slope','斜率') }}</span><span><i style="background:var(--teal)"></i>{{ t('Curvature','曲率') }}</span></div>
            <p class="sub" style="font-size:11px;margin-top:6px">{{ t('The three classic factors span','三个经典因子合计解释') }} <b>{{ (SH.pca.first3_var*100)|round(1) }}%</b> {{ t('of curve variance — the textbook result, measured on our data.','的曲线方差——教科书结论，在我方数据上实测。') }}</p>
          </div>
          {% endif %}
        </div>
        <div class="card">
          <h2>{{ t('Curve regime', '曲线状态') }}</h2>
          {% set RG = yc.regime %}
          {% if RG.key %}
          {% set rc = {'bull_steepener': C.green, 'bear_steepener': C.amber, 'bull_flattener': C.indigo, 'bear_flattener': C.red} %}
          <div class="curve-regime">
            <span class="regchip" style="background:{{ rc.get(RG.key, C.muted) }}">{{ b(RG.label) }}</span>
            <div class="sub" style="line-height:1.45;margin-top:8px">{{ b(RG.desc) }}</div>
            <div class="sub" style="font-size:11.5px"><b style="color:var(--ink)">{{ t('Fed-cycle phase','美联储周期阶段') }}:</b> {{ b(RG.fed_phase) }}{% if RG.slope_chg_bp is not none %} · {{ t('slope','斜率') }} {{ '%+d'|format(RG.slope_chg_bp|int) }}bp/{{ RG.window_d }}d{% endif %}{% if RG.term_premium_dir %} · {{ t('term premium','期限溢价') }} {{ t(RG.term_premium_dir, {'rising':'上行','falling':'下行','stable':'平稳'}.get(RG.term_premium_dir, RG.term_premium_dir)) }}{% endif %}</div>
            {% if RG.favored %}<div class="favrow"><span class="fl fav">{{ t('Favoured','受益') }}</span>{% for tk in RG.favored %}<span class="tkpill fav">{{ tk }}</span>{% endfor %}</div>{% endif %}
            {% if RG.pressured %}<div class="favrow"><span class="fl pres">{{ t('Pressured','承压') }}</span>{% for tk in RG.pressured %}<span class="tkpill pres">{{ tk }}</span>{% endfor %}</div>{% endif %}
            <p class="note" style="font-size:12px;margin-top:4px">{{ b(RG.note) }}</p>
          </div>
          {% else %}<p class="sub">{{ t('Curve move indeterminate right now.','当前曲线移动不明确。') }}</p>{% endif %}
        </div>
        <div class="card">
          <h2>{{ t('Recession dashboard', '衰退面板') }}</h2>
          {% set RC = yc.recession %}
          {% set rkc = {'low': C.green, 'watch': C.amber, 'elevated': C.amber, 'high': C.red} %}
          <span class="band-chip" style="background:{{ rkc.get(RC.risk, C.muted) }}">{{ t(RC.risk, {'low':'低','watch':'观察','elevated':'升高','high':'高'}.get(RC.risk, RC.risk)) }} · {{ RC.n_flags }}/4 {{ t('flags','项亮起') }}</span>
          <div class="recgauges">
            <div class="recg {{ 'flag-on' if 'ntfs' in RC.flags else '' }}"><div class="rgl">{{ t('Near-term fwd spread','近端远期利差') }}</div><div class="rgv">{{ '%+.2f'|format(RC.ntfs) if RC.ntfs is not none else '—' }}</div></div>
            <div class="recg {{ 'flag-on' if 'probit' in RC.flags else '' }}"><div class="rgl">{{ t('NY Fed 10y-3m probit','纽约联储10年-3月概率') }}</div><div class="rgv">{{ RC.nyfed_prob|int if RC.nyfed_prob is not none else '—' }}%</div></div>
            <div class="recg {{ 'flag-on' if 'uninversion' in RC.flags else '' }}"><div class="rgl">{{ t('Un-inversion alarm','重新变陡警报') }}</div><div class="rgv">{{ t('YES','是') if RC.uninversion else t('no','否') }}</div></div>
            <div class="recg {{ 'flag-on' if 'tp_adj' in RC.flags else '' }}"><div class="rgl">{{ t('TP-adjusted 2s10s','期限溢价调整2-10年') }}</div><div class="rgv">{{ '%+.2f'|format(RC.tp_adj_curve) if RC.tp_adj_curve is not none else '—' }}</div></div>
          </div>
          {% if RC.policy_stance %}{% set PS = RC.policy_stance %}<div class="flag {{ 'warn' if PS.stance=='restrictive' else 'ok' if PS.stance=='accommodative' else 'info' }}" style="display:block;margin:2px 0 6px">{{ t('Policy stance','政策立场') }}: <b>{{ '%.2f'|format(PS.fed_funds) }}%</b> {{ t('funds vs','基金 vs') }} ~{{ '%.1f'|format(PS.neutral_anchor) }}% = {{ t(PS.stance, {'restrictive':'偏紧','accommodative':'宽松','neutral':'中性'}.get(PS.stance, PS.stance)) }} ({{ '%+.2f'|format(PS.gap_pp) }}pp)</div>{% endif %}
          <p class="note" style="font-size:11.5px;margin-top:4px">{{ b(RC.lead_time_note) }}{% if RC.policy_stance %} {{ b(RC.policy_stance.note) }}{% endif %}</p>
        </div>
      </div>
      <div class="grid cols-2" style="margin-top:14px">
        <div class="card">
          <h2>{{ t('Slopes & momentum', '斜率与动能') }}</h2>
          <table class="slopes">
            <tr><th>{{ t('Spread','利差') }}</th><th>{{ t('Level','水平') }}</th><th>{{ t('%ile','分位') }}</th><th>{{ t('63d Δ','63日变动') }}</th></tr>
            {% for k, s in yc.slopes.items() %}
            <tr><td class="nm">{{ b(s.label) }}</td><td class="{{ 'inv' if s.inverted else '' }}">{{ '%+.2f'|format(s.value) if s.value is not none else '—' }}</td><td>{{ pct(s.pctile) }}</td><td>{{ '%+d'|format(s.chg_63d_bp|int) if s.chg_63d_bp is not none else '—' }}bp</td></tr>
            {% endfor %}
          </table>
          {% set M = yc.momentum %}
          <p class="sub" style="font-size:11.5px;margin-top:8px">{{ t('Curve speed (63d)','曲线速度（63日）') }}: {{ t('real 10y','实际10年') }} {{ '%+d'|format(M.real10y_speed_bp|int) if M.real10y_speed_bp is not none else '—' }}bp · {{ t('front 2y','前端2年') }} {{ '%+d'|format(M.front2y_speed_bp|int) if M.front2y_speed_bp is not none else '—' }}bp · {{ t('|real-speed| pctile','|实际速度|分位') }} {{ pct(M.real_speed_pctile) }}. {{ t('Rate-of-change beats level — the SPEED of a real-yield move breaks equities more than its level.','变动速度胜过水平——实际收益率移动的速度比其水平更能冲击股票。') }}</p>
          {% if M.trend_spread is not none %}<p class="sub" style="font-size:11.5px;margin-top:4px">{{ t('Term-spread trend (2y smooth)','期限利差趋势（2年平滑）') }}: <b style="color:var(--ink)">{{ '%+.2f'|format(M.trend_spread) }}</b>{% if M.trend_spread_dir %} · {{ t(M.trend_spread_dir, {'rising':'上行','falling':'下行','flat':'平稳'}.get(M.trend_spread_dir, M.trend_spread_dir)) }}{% endif %}. {{ t('The literature flags the smoothed, business-cycle-frequency component of the 3m10y spread as the curve read with genuine equity-premium content (Faria-Verona 2020) — but OUR calibration finds it regime-dependent (the IC sign flips post-2015), so we carry it as context, never a timing signal.','文献认为3月-10年利差经平滑的商业周期频率成分是收益率曲线中具有真正股权溢价含义的读数（Faria-Verona 2020）——但我方校准发现其依赖状态（IC符号在2015年后翻转），故仅作背景，绝非择时信号。') }}</p>{% endif %}
        </div>
        <div class="card">
          <h2>{{ t('Forward rates & carry', '远期利率与持有收益') }}</h2>
          {% set FW = yc.forwards %}
          <div class="kpis">
            <div class="kpi">{{ t('1y1y fwd','1年1年远期') }}<b>{{ '%.2f'|format(FW.f_1y1y) if FW.f_1y1y is not none else '—' }}%</b></div>
            <div class="kpi">{{ t('2y1y fwd','2年1年远期') }}<b>{{ '%.2f'|format(FW.f_2y1y) if FW.f_2y1y is not none else '—' }}%</b></div>
            <div class="kpi">{{ t('5y5y fwd','5年5年远期') }}<b>{{ '%.2f'|format(FW.f_5y5y) if FW.f_5y5y is not none else '—' }}%</b></div>
            <div class="kpi">{{ t('10y carry','10年持有') }}<b>{{ '%.2f'|format(FW.carry_10y_pct) if FW.carry_10y_pct is not none else '—' }}%</b></div>
            <div class="kpi">{{ t('10y roll-down','10年滚动') }}<b>{{ '%+.2f'|format(FW.rolldown_10y_pct) if FW.rolldown_10y_pct is not none else '—' }}%</b></div>
            <div class="kpi">{{ t('carry + roll','持有＋滚动') }}<b>{{ '%.2f'|format(FW.carry_roll_10y_pct) if FW.carry_roll_10y_pct is not none else '—' }}%</b></div>
          </div>
          <p class="note" style="font-size:12px;margin-top:10px">{{ b(FW.note) }}</p>
        </div>
      </div>
      <div class="card" style="margin-top:14px">
        <h2>{{ t('Curve signals — sector, style & market tendency', '曲线信号 — 板块、风格与市场倾向') }}</h2>
        {% set SG = yc.signals %}
        <div class="sub" style="font-size:11.5px">{{ t('Per-sector curve tilt under the current regime. ✓meas = a calibrated forward-IC edge in the transmission matrix; ·thy = textbook channel only.','当前状态下各板块的曲线倾向。✓实测＝传导矩阵中存在校准的前瞻IC优势；·理论＝仅教科书传导。') }}</div>
        <div class="sectilt">
          {% for s in SG.sector %}
          <div class="stile {{ 'tail' if s.tilt=='tailwind' else 'head' if s.tilt=='headwind' else '' }}">
            <span class="se">{{ s.etf }}</span><span class="sb {{ 'meas' if s.basis=='measured' else '' }}" title="{{ 'measured forward IC ('+(s.verdict|lower)+')' if s.basis=='measured' else 'textbook channel, no measured edge' }}">{{ '✓'+(s.ic_driver or '')+' '+('%+.2f'|format(s.ic) if s.ic is not none else '') if s.basis=='measured' else '·thy' }}</span>
            <div class="sm">{{ t(s.tilt, {'tailwind':'顺风','headwind':'逆风','neutral':'中性'}.get(s.tilt,s.tilt)) }} · {{ t(s.duration, {'long':'长久期','short':'短久期','neutral':'久期中性'}.get(s.duration,s.duration)) }}<br>{{ b(s.mech) }}</div>
          </div>
          {% endfor %}
        </div>
        <div style="margin-top:16px">
          <div class="sub" style="font-size:11.5px;font-weight:700;color:var(--ink)">{{ t('Equity style / factor','股票风格／因子') }}</div>
          {% set FC = SG.stock_factor %}
          <div class="facrow">
            <div class="facpill"><span class="fk">{{ t('Value vs growth','价值vs成长') }}</span><span class="fv">{{ t(FC.value_vs_growth|capitalize, {'value':'价值','growth':'成长','neutral':'中性'}.get(FC.value_vs_growth, FC.value_vs_growth)) }}</span></div>
            <div class="facpill"><span class="fk">{{ t('Size','规模') }}</span><span class="fv">{{ t({'small':'Small caps','large':'Large caps','neutral':'Neutral'}.get(FC.size, FC.size), {'small':'小盘','large':'大盘','neutral':'中性'}.get(FC.size, FC.size)) }}</span></div>
            <div class="facpill"><span class="fk">{{ t('Duration factor','久期因子') }}</span><span class="fv">{{ t(FC.duration_factor, {'headwind':'逆风','tailwind':'顺风','neutral':'中性'}.get(FC.duration_factor, FC.duration_factor)) }}</span></div>
          </div>
          <p class="note" style="font-size:12px">{{ b(FC.note) }}</p>
        </div>
        <div style="margin-top:12px">
          <div class="sub" style="font-size:11.5px;font-weight:700;color:var(--ink)">{{ t('Market tendency (curve-speed → drawdown risk)','市场倾向（曲线速度→回撤风险）') }}</div>
          {% set MT = SG.market_tendency %}
          {% set mtc = {'calm': C.green, 'watch': C.amber, 'elevated': C.red} %}
          <span class="band-chip" style="background:{{ mtc.get(MT.drawdown_risk, C.muted) }};margin:6px 0">{{ t(MT.drawdown_risk, {'calm':'平静','watch':'观察','elevated':'升高'}.get(MT.drawdown_risk, MT.drawdown_risk)) }}</span>
          <p class="note" style="font-size:12px">{{ b(MT.label) }}</p>
        </div>
        <div class="flag info" style="display:block;margin-top:10px">{{ b(yc.scored_status) }}</div>
      </div>
      </div>
    </details>
    {% endif %}

    <details id="shelf-infl">
      <summary><span class="sh-ic">🌡️</span>{{ t('Inflation & expectations — the deep read', '通胀与预期——深入解读') }}<span class="sh-hint">{{ t('decomposition · breakeven velocity', '分解 · 盈亏平衡速度') }}</span><span class="sh-caret">▶</span></summary>
      <div class="sh-body">
      {% set D = tx.inflation_decomposition %}
      <div class="card" style="margin-top:12px">
        <h2>{{ t('Inflation decomposition', '通胀分解') }}</h2>
        <div class="decomp">
          <div class="dc"><div class="dcl">{{ t('Headline − core CPI','整体−核心CPI') }}</div><div class="dcv">{{ '%+.2f'|format(D.headline_minus_core) if D.headline_minus_core is not none else '—' }}</div><div class="dcn">{{ t('food / energy push','食品/能源推动') }}</div></div>
          <div class="dc"><div class="dcl">{{ t('Core services YoY','核心服务同比') }}</div><div class="dcv">{{ '%.2f'|format(D.core_services_yoy) if D.core_services_yoy is not none else '—' }}</div><div class="dcn">{{ t('the sticky leg','粘性部分') }}</div></div>
          <div class="dc"><div class="dcl">{{ t('Shelter YoY','住房同比') }}</div><div class="dcv">{{ '%.2f'|format(D.shelter_yoy) if D.shelter_yoy is not none else '—' }}</div><div class="dcn">{{ t('lagging rent','滞后的租金') }}</div></div>
          <div class="dc"><div class="dcl">{{ t('Core PCE − core CPI','核心PCE−核心CPI') }}</div><div class="dcv">{{ '%+.2f'|format(D.pce_minus_cpi) if D.pce_minus_cpi is not none else '—' }}</div><div class="dcn">{{ t('basket / weight gap','篮子/权重差') }}</div></div>
          <div class="dc"><div class="dcl">{{ t('Actual − market-priced','实际−市场定价') }}</div><div class="dcv">{{ D.actual_vs_market_bp|round|int if D.actual_vs_market_bp is not none else '—' }}bp</div><div class="dcn">{{ t('core CPI vs 10y breakeven','核心CPI vs 10年盈亏平衡') }}</div></div>
        </div>
        <div class="kpis" style="margin-top:14px">
          <div class="kpi">{{ t('10y breakeven','10年盈亏平衡') }}<b>{{ '%.2f'|format(S.expectations.breakeven_10y) if S.expectations.breakeven_10y is not none else '—' }}%</b></div>
          <div class="kpi">{{ t('5y5y breakeven','5年5年盈亏平衡') }}<b>{{ '%.2f'|format(S.expectations.breakeven_5y5y) if S.expectations.breakeven_5y5y is not none else '—' }}%</b></div>
          <div class="kpi">{{ t('Model 5y','模型5年') }}<b>{{ '%.2f'|format(S.expectations.model_5y) if S.expectations.model_5y is not none else '—' }}%</b></div>
          <div class="kpi">{{ t('Survey 1y','调查1年') }}<b>{{ '%.1f'|format(S.expectations.survey_1y) if S.expectations.survey_1y is not none else '—' }}%</b></div>
          <div class="kpi">{{ t('Mkt−model','市场−模型') }}<b>{{ S.expectations.market_minus_model_bp|round|int if S.expectations.market_minus_model_bp is not none else '—' }}bp</b></div>
          <div class="kpi">{{ t('Core PPI','核心PPI') }}<b>{{ '%.1f'|format(S.inflation.ppi_core_yoy) if S.inflation.ppi_core_yoy is not none else '—' }}%</b></div>
          <div class="kpi">{{ t('ECI wages','ECI薪酬') }}<b>{{ '%.1f'|format(S.inflation.eci_comp_yoy) if S.inflation.eci_comp_yoy is not none else '—' }}%</b></div>
        </div>
      </div>
      {% if tx.breakeven_decomp %}
      {% set BD = tx.breakeven_decomp %}
      {% set cz = BD.cause_badge.cause %}
      <div class="card bd" style="margin-top:12px">
        <h2>{{ t('Breakeven velocity & cause — visibility only', '盈亏平衡速度与成因 — 仅供观察') }}</h2>
        <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:baseline;margin:2px 0 4px">
          <div class="state-val" style="margin:0">{{ '%.2f'|format(BD.level) if BD.level is not none else '—' }}<small>% {{ t('10y breakeven','10年盈亏平衡') }}</small></div>
          <span class="bd-tag bd-{{ 'fall' if BD.direction=='falling' else 'rise' if BD.direction=='rising' else 'flat' }}">
            {{ t('falling','下行') if BD.direction=='falling' else t('rising','上行') if BD.direction=='rising' else t('flat','平稳') }} ·
            {{ t('downtrend','下降趋势') if BD.trend=='downtrend' else t('uptrend','上升趋势') if BD.trend=='uptrend' else t('choppy','震荡') }}{% if BD.is_fast %} · <b>{{ t('FAST','快速') }}</b>{% endif %}
          </span>
        </div>
        <div class="bdkpis">
          <div class="kpi">{{ t('5d','5日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_5d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_5d_bp|int) if BD.velocity_bp.chg_5d_bp is not none else '—' }}bp</b></div>
          <div class="kpi">{{ t('10d','10日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_10d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_10d_bp|int) if BD.velocity_bp.chg_10d_bp is not none else '—' }}bp</b></div>
          <div class="kpi">{{ t('20d','20日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_20d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_20d_bp|int) if BD.velocity_bp.chg_20d_bp is not none else '—' }}bp</b></div>
          <div class="kpi">{{ t('63d','63日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_63d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_63d_bp|int) if BD.velocity_bp.chg_63d_bp is not none else '—' }}bp</b></div>
          <div class="kpi">{{ t('Accel 10d','10日加速') }}<b class="{{ 'dn' if (BD.accel_10d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.accel_10d_bp|int) if BD.accel_10d_bp is not none else '—' }}bp</b></div>
          <div class="kpi">{{ t('Speed pctile','速度分位') }}<b>{{ (BD.fall_speed_pctile*100)|round|int if BD.fall_speed_pctile is not none else '—' }}</b></div>
          <div class="kpi">{{ t('5y5y 20d','5y5y 20日') }}<b class="{{ 'dn' if (BD.cross_check_5y5y_chg_20d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.cross_check_5y5y_chg_20d_bp|int) if BD.cross_check_5y5y_chg_20d_bp is not none else '—' }}bp</b></div>
        </div>
        <div class="bd-badge bd-{{ cz }}">
          <div class="bd-badge-h">{{ t('Cause','成因') }}: {{ cz|replace('_',' ')|upper }}</div>
          <div>{{ b(BD.cause_badge) }}</div>
        </div>
        {% if BD.tips_liquidity_flag %}<p class="sub" style="color:var(--red);margin-top:8px">⚠ {{ b(BD.tips_liquidity_flag) }}</p>{% endif %}
        <div class="sub faint" style="margin-top:8px">{{ t('Co-state','联动状态') }}:
          {{ t('oil','油') }} {{ '%+.0f'|format(BD.costate.oil_chg_20d_pct) if BD.costate.oil_chg_20d_pct is not none else '—' }}% ·
          {{ t('real 10y','实际10年') }} {{ '%+d'|format(BD.costate.real10y_chg_20d_bp|int) if BD.costate.real10y_chg_20d_bp is not none else '—' }}bp ·
          {{ t('nom 10y','名义10年') }} {{ '%+d'|format(BD.costate.nom10y_chg_20d_bp|int) if BD.costate.nom10y_chg_20d_bp is not none else '—' }}bp ·
          {{ t('HY-OAS z','高收益OAS z') }} {{ BD.costate.hy_oas_z if BD.costate.hy_oas_z is not none else '—' }} ·
          VIX {{ (BD.costate.vix_pctile*100)|round|int if BD.costate.vix_pctile is not none else '—' }}pct</div>
        <p class="sub" style="margin-top:8px">{{ b(BD.caveat) }}</p>
      </div>
      {% endif %}
      </div>
    </details>

    <details id="shelf-gate">
      <summary><span class="sh-ic">🧾</span>{{ t('How we measure — receipts & caveats', '测量方法——依据与告诫') }}<span class="sh-hint">{{ t('every tested signal, including the failures', '每个被检验的信号，包括失败的') }}</span><span class="sh-caret">▶</span></summary>
      <div class="sh-body">
      <p class="note" style="margin-top:12px">{{ t('We tested every rate and inflation driver on this page for real predictive edge. None passed the bar to be scored — so everything here is shown as context to explain moves, never as a signal to trade on. The table below is the full honest record.', '我们对页面上每个利率与通胀驱动都做了预测优势检验，无一通过计分门槛——因此本页内容仅为解释行情的背景，绝非交易信号。下表为完整的诚实记录。') }}</p>
      <div class="flag info" style="display:block;margin-bottom:10px"><span class="l-en">{{ tx.scored_status.en }}</span><span class="l-zh">{{ tx.scored_status.zh }}</span></div>
      {% if gate %}
      <table class="gate">
        <tr><th>{{ t('Candidate leg','候选腿') }}</th><th>{{ t('Verdict','判定') }}</th><th class="num">{{ t('IC dd (f/pre/post)','IC回撤(全/前/后)') }}</th><th class="num">{{ t('hi-tercile edge','高三分位超额') }}</th><th>{{ t('scored?','计分?') }}</th></tr>
        {% for k, s in gate.items() %}
        <tr><td>{{ s.label }}</td><td>{{ s.verdict }}</td><td class="num">{{ s.ic_dd_full }}/{{ s.ic_dd_pre }}/{{ s.ic_dd_post }}</td><td class="num">{{ s.conditional.high_edge_pp if s.conditional else '—' }}pp</td><td>{{ '✅' if s.scored_eligible else '—' }}</td></tr>
        {% endfor %}
      </table>
      {% endif %}
      <div class="note" style="margin-top:12px">
        {% for c in tx.caveats %}<p>• <span class="l-en">{{ c.en }}</span><span class="l-zh">{{ c.zh }}</span></p>{% endfor %}
        <p><b>{{ t('Data.','数据。') }}</b> {{ t('Free / keyless FRED: full Treasury curve, real yields (TIPS), 5y/10y/5y5y breakevens, term premium; headline & core CPI, headline & core PCE (the Fed’s 2% target gauge), PPI, ECI wage growth, shelter & core-services CPI; Cleveland model + UMich survey inflation expectations. All point-in-time vintaged for honest backtests. Dollar read: broad trade-weighted dollar + the Dollar Desk on the Forex page.', '免费/无密钥的FRED：完整国债曲线、实际利率(TIPS)、5/10年与5年5年盈亏平衡、期限溢价；整体与核心CPI、整体与核心PCE（美联储2%目标）、PPI、ECI工资增长、住房与核心服务CPI；克利夫兰模型与密歇根调查通胀预期。均按时点存档以便诚实回测。美元读数：广义贸易加权美元及外汇页的美元台。') }}</p>
        <p class="meta-foot">{{ t('Calibration','校准') }}: scripts/calibrate_rate_inflation.py · {{ t('report','报告') }} reports/rate-inflation-transmission-calibration.md · {{ t('History','历史') }} {{ span }} · {{ t('built','构建于') }} {{ built }}</p>
      </div>
      </div>
    </details>
  </div>

  <p class="tx-disclosure">{{ t('Everything on this page is a measured relationship shown to explain market moves — none of it is a prediction or a trade signal. When a relationship failed our tests, we say so in the receipts above.', '本页所有内容均为用于解释行情的实测关联——皆非预测或交易信号。未通过检验的关联，已在上方依据中如实注明。') }}</p>
</div>

<script src="theme.js"></script>
<footer class="site-footer">
  <span>© 2026 Mastermind Inc</span>
</footer>
</body>
</html>
