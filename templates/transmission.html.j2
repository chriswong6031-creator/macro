{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro b(d) -%}
<span class="l-en">{{ d.en }}</span><span class="l-zh">{{ d.zh }}</span>
{%- endmacro %}
{% macro pct(v) -%}{{ (v*100)|round|int if v is not none else '—' }}{%- endmacro %}
{% macro vg(verdict) -%}
{%- if verdict == 'CONFIRMED' -%}<span class="lvg vg-measured" title="split-half forward-IC confirmed">✓</span>
{%- elif verdict == 'DIRECTIONAL' -%}<span class="lvg vg-directional" title="full-sample only">~</span>
{%- elif verdict == 'INVERTED' -%}<span class="lvg vg-inverted" title="measured the opposite way">⤫</span>
{%- else -%}<span class="lvg vg-context" title="weak / context only">·</span>{%- endif -%}
{%- endmacro %}
{# The signature flow-line: a current travelling through a wire. Shape encodes
   direction (up / down / flat); hue encodes the channel; reduced-motion → static. #}
{% macro flowline(dirkey, ch) -%}
{% set paths = {'up':'M0,36 C60,36 95,31 135,24 S225,10 300,7','down':'M0,7 C60,7 95,12 135,20 S225,33 300,36','flat':'M0,22 C50,22 75,17 105,22 S155,27 185,22 235,17 265,22 300,22'} %}
<svg class="txflow" viewBox="0 0 300 44" preserveAspectRatio="none" aria-hidden="true">
  <path class="txflow-base" d="{{ paths[dirkey] }}" pathLength="100"/>
  <path class="txflow-pulse ch-{{ ch }}" d="{{ paths[dirkey] }}" pathLength="100"/>
</svg>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
