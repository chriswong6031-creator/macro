<title>Rate & Inflation Transmission — {{ as_of }}</title>
{% set seo_title = 'Rate & Inflation Transmission | Mastermind' %}{% set seo_desc = 'How interest rates and inflation drive every asset class — headwinds, tailwinds, and regime-aware transmission reads.' %}{% set seo_path = 'transmission.html' %}
{% include "_seo_head.html.j2" %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}}; --green:{{C.green}}; --teal:{{C.teal}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1fr 1fr}.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-2,.cols-3{grid-template-columns:1fr}}
.sec-head{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em;margin:30px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.brand{font-weight:800;font-size:21px;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.brand .gn{color:var(--blue)}
.lead{color:var(--muted);font-size:14px;margin:0 0 20px}
.sub{font-size:13px;color:var(--muted)}.faint{color:var(--faint)}
.state-val{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1;margin:4px 0 6px}
.state-val small{font-size:15px;color:var(--muted);font-weight:700}
.band-chip{display:inline-block;padding:4px 12px;border-radius:999px;font-size:12.5px;font-weight:700;color:#fff;letter-spacing:.01em;margin:2px 0}
.kpis{display:flex;gap:14px 20px;flex-wrap:wrap;margin-top:14px}
.kpi{font-size:12px;color:var(--muted)}.kpi b{display:block;font-size:16px;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#eef1f6;color:var(--ink);margin:2px 4px 2px 0}
html[data-theme="dark"] .pill{background:#222732}
.flag{display:inline-block;padding:5px 11px;border-radius:8px;font-size:12.5px;font-weight:600;margin-top:10px;line-height:1.4}
.flag.warn{background:rgba(245,173,66,.16);color:#9a6a10}
.flag.alarm{background:rgba(211,11,11,.13);color:var(--red)}
.flag.info{background:rgba(40,95,255,.10);color:var(--blue)}
.flag.ok{background:rgba(26,127,67,.12);color:var(--green)}
.note{font-size:13px;color:var(--muted);line-height:1.6}.note b{color:var(--ink)}
.meta-foot{font-size:12px;color:var(--faint);margin-top:8px}
.lvg{margin-left:4px;font-weight:800;font-size:11px;cursor:help}
.vg-measured{color:var(--green)}.vg-directional{color:var(--amber)}.vg-context{color:var(--faint)}.vg-inverted{color:var(--indigo)}
/* per-asset headwind/tailwind bars */
.tbar{display:grid;grid-template-columns:150px 1fr 58px;align-items:center;gap:10px;font-size:12.5px;padding:5px 0}
.tbar .tname{color:var(--text);font-weight:600}
.tbar .ttrack{position:relative;height:9px;background:#eef1f6;border-radius:5px}
html[data-theme="dark"] .tbar .ttrack{background:#222732}
.tbar .tmid{position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--faint);opacity:.5}
.tbar .tfill{position:absolute;top:0;bottom:0;border-radius:5px}
.tbar .tfill.head{right:50%;background:var(--red)}
.tbar .tfill.tail{left:50%;background:var(--green)}
.tbar .tval{text-align:right;font-variant-numeric:tabular-nums;color:var(--muted);font-weight:600}
.tdrv{font-size:11px;color:var(--faint);margin:1px 0 0 150px}
/* chain cascade */
.chain{margin-bottom:16px}
.chain.dim{opacity:.55}
.chain-head{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;color:var(--ink);margin-bottom:4px}
.chain-state{font-size:11px;font-weight:700;padding:2px 9px;border-radius:999px}
.chain-state.on{background:rgba(40,95,255,.12);color:var(--blue)}
.chain-state.off{background:#eef1f6;color:var(--faint)}
html[data-theme="dark"] .chain-state.off{background:#222732}
.order{display:grid;grid-template-columns:30px 1fr;gap:12px;padding:10px 0;border-bottom:1px solid var(--grid)}
.order:last-child{border-bottom:none}
.order .onum{width:26px;height:26px;border-radius:50%;background:var(--blue);color:#fff;font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center}
.order .otext{font-size:13.5px;color:var(--text);line-height:1.5}
.order .ocells{margin-top:7px;display:flex;flex-wrap:wrap;gap:6px}
.achip{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:8px;font-size:11.5px;font-weight:600;background:#eef1f6;color:var(--text)}
html[data-theme="dark"] .achip{background:#222732}
.achip.ac-head{background:rgba(211,11,11,.10);color:var(--red)}
.achip.ac-tail{background:rgba(26,127,67,.12);color:var(--green)}
.achip b{font-variant-numeric:tabular-nums}
/* scenario */
.scen{border:1px solid var(--grid);border-radius:13px;padding:15px;margin-bottom:14px}
.scen h3{margin:0 0 10px;font-size:14px;font-weight:700;color:var(--ink)}
.scen-row{display:flex;flex-wrap:wrap;gap:14px}
.scen-col{flex:1;min-width:180px}
.scen-col .scl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
.scen-col.head .scl{color:var(--red)}.scen-col.tail .scl{color:var(--green)}
.smv{display:flex;justify-content:space-between;font-size:12.5px;padding:2px 0}
.smv b{font-variant-numeric:tabular-nums}
.smv .neg{color:var(--red)}.smv .pos{color:var(--green)}
/* decomposition */
.decomp{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-top:6px}
.decomp .dc{padding:11px 13px;border-radius:11px;background:#eef1f6}
html[data-theme="dark"] .decomp .dc{background:#222732}
.decomp .dc .dcl{font-size:11.5px;color:var(--muted);margin-bottom:3px}
.decomp .dc .dcv{font-size:19px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums}
.decomp .dc .dcn{font-size:11px;color:var(--faint);margin-top:2px}
.site-footer{max-width:1180px;margin:30px auto 0;padding:18px 20px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;color:var(--muted);font-size:12.5px}
table.gate{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:8px}
table.gate th,table.gate td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--grid)}
table.gate th{color:var(--muted);font-weight:700;text-transform:uppercase;font-size:10.5px;letter-spacing:.03em}
table.gate td.num{text-align:right;font-variant-numeric:tabular-nums}
/* === yield-curve scorecards === */
.pcabar{display:flex;height:14px;border-radius:7px;overflow:hidden;margin:10px 0 4px;border:1px solid var(--grid)}
.pcabar span{display:flex;align-items:center;justify-content:center;font-size:9.5px;font-weight:700;color:#fff;min-width:0;overflow:hidden;white-space:nowrap}
.pcabar .pc-l{background:var(--indigo)}.pcabar .pc-s{background:var(--blue)}.pcabar .pc-c{background:var(--teal)}.pcabar .pc-r{background:var(--faint)}
.pcalegend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:2px}
.pcalegend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:baseline}
.regchip{display:inline-block;padding:6px 15px;border-radius:999px;font-size:16px;font-weight:800;color:#fff;letter-spacing:.01em}
.favrow{display:flex;flex-wrap:wrap;gap:5px;margin-top:3px;align-items:center}
.favrow .fl{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-right:2px}
.favrow .fl.fav{color:var(--green)}.favrow .fl.pres{color:var(--red)}
.tkpill{display:inline-block;padding:2px 8px;border-radius:7px;font-size:11.5px;font-weight:700;font-variant-numeric:tabular-nums}
.tkpill.fav{background:rgba(26,127,67,.12);color:var(--green)}
.tkpill.pres{background:rgba(211,11,11,.10);color:var(--red)}
.recgauges{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin:8px 0 4px}
.recg{padding:9px 11px;border-radius:11px;background:#eef1f6}
html[data-theme="dark"] .recg{background:#222732}
.recg .rgl{font-size:11px;color:var(--muted);line-height:1.3}
.recg .rgv{font-size:18px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;margin-top:1px}
.recg.flag-on{background:rgba(211,11,11,.12)}
.recg.flag-on .rgv{color:var(--red)}
.sectilt{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:7px;margin-top:8px}
.stile{padding:7px 9px;border-radius:10px;font-size:12px;border:1px solid var(--grid);background:var(--card)}
.stile .se{font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums}
.stile .sb{float:right;font-size:9px;font-weight:700;padding:1px 5px;border-radius:5px;background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .stile .sb{background:#222732}
.stile .sb.meas{background:rgba(26,127,67,.14);color:var(--green)}
.stile .sm{font-size:10.5px;color:var(--faint);margin-top:3px;line-height:1.35}
.stile.tail{background:rgba(26,127,67,.07);border-color:rgba(26,127,67,.28)}
.stile.head{background:rgba(211,11,11,.06);border-color:rgba(211,11,11,.28)}
table.slopes{width:100%;border-collapse:collapse;font-size:12.5px}
table.slopes th,table.slopes td{text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)}
table.slopes th:first-child,table.slopes td:first-child{text-align:left}
table.slopes tr:last-child td{border-bottom:none}
table.slopes th{color:var(--muted);font-weight:700;text-transform:uppercase;font-size:10px;letter-spacing:.03em}
table.slopes td{font-variant-numeric:tabular-nums;color:var(--text)}
table.slopes td.nm{color:var(--ink);font-weight:600}
table.slopes td.inv{color:var(--red);font-weight:700}
.facrow{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0}
.facpill{display:inline-flex;flex-direction:column;padding:7px 13px;border-radius:11px;background:#eef1f6;min-width:120px}
html[data-theme="dark"] .facpill{background:#222732}
.facpill .fk{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.facpill .fv{font-size:15px;font-weight:800;color:var(--ink)}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav" style="max-width:1180px;margin:18px auto 16px;padding:0 20px">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <div class="brand">🔀 {{ t('Rate & Inflation', '利率与通胀') }} <span class="gn">{{ t('Transmission', '传导') }}</span></div>
  <p class="lead">{{ t('How the interest-rate, rate-expectations and inflation (CPI · core PCE) state propagates — first, second and third order — into every asset class we track: the full yield-curve read (shape, regime, recession & cross-asset signals), the headwind / tailwind each asset faces now, the causal chains behind it, and what a rate or inflation shock would imply. Coefficients are MEASURED (split-half forward IC); display-only, never a trade call — repricing is reactive.', '利率、利率预期与通胀（CPI · 核心PCE）的当前状态如何一阶、二阶、三阶地传导至我们跟踪的每一类资产：完整的收益率曲线解读（形态、状态、衰退与跨资产信号）、各资产当前面临的逆风/顺风、其背后的因果链，以及一次利率或通胀冲击意味着什么。系数均为实测（前后半段前瞻IC）；仅供展示，绝非交易建议——重定价是被动的。') }}
  <span class="faint">· {{ t('As of', '截至') }} {{ as_of }}</span></p>

  {% set S = tx.state %}
  <!-- ===================== CURRENT STATE ===================== -->
  <div class="grid cols-3" style="margin-bottom:6px">
    <div class="card">
      <h2>{{ t('Interest rates', '利率') }}</h2>
      <div class="state-val">{{ '%.2f'|format(S.rates.real_10y) if S.rates.real_10y is not none else '—' }}<small>% {{ t('real 10y', '实际10年') }}</small></div>
      {% set rr = S.rates.regime %}
      <span class="band-chip" style="background:{{ C.red if rr=='restrictive' else C.green if rr=='accommodative' else C.muted }}">{{ t(rr, {'restrictive':'偏紧','accommodative':'宽松','neutral':'中性'}[rr]) }} · {{ t(S.rates.direction, {'rising':'上行','falling':'下行','stable':'平稳'}[S.rates.direction]) }}</span>
      <div class="kpis">
        <div class="kpi">{{ t('Nominal 10y','名义10年') }}<b>{{ '%.2f'|format(S.rates.nominal_10y) if S.rates.nominal_10y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('2s10s curve','2-10年曲线') }}<b>{{ '%.2f'|format(S.rates.curve_2s10s) if S.rates.curve_2s10s is not none else '—' }}</b></div>
        <div class="kpi">{{ t('Real 10y %ile','实际10年分位') }}<b>{{ (S.rates.real_10y_pctile*100)|round|int if S.rates.real_10y_pctile is not none else '—' }}</b></div>
        <div class="kpi">{{ t('Policy gap (2y−ff)','政策缺口') }}<b>{{ '%.2f'|format(S.rates.policy_gap) if S.rates.policy_gap is not none else '—' }}</b></div>
      </div>
    </div>
    <div class="card">
      <h2>{{ t('Inflation', '通胀') }}</h2>
      <div class="state-val">{{ '%.1f'|format(S.inflation.core_pce_yoy) if S.inflation.core_pce_yoy is not none else '—' }}<small>% {{ t('core PCE YoY', '核心PCE同比') }}</small></div>
      {% set ir = S.inflation.regime %}
      <span class="band-chip" style="background:{{ C.red if ir=='above target' else C.green if ir=='below target' else C.muted }}">{{ t(ir, {'above target':'高于目标','at target':'达标','below target':'低于目标'}[ir]) }} · {{ t(S.inflation.direction, {'re-accelerating':'再加速','cooling':'降温','steady':'平稳'}[S.inflation.direction]) }}</span>
      <div class="kpis">
        <div class="kpi">{{ t('Core CPI','核心CPI') }}<b>{{ '%.1f'|format(S.inflation.core_cpi_yoy) if S.inflation.core_cpi_yoy is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('Headline CPI','整体CPI') }}<b>{{ '%.1f'|format(S.inflation.headline_cpi_yoy) if S.inflation.headline_cpi_yoy is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('Core PPI','核心PPI') }}<b>{{ '%.1f'|format(S.inflation.ppi_core_yoy) if S.inflation.ppi_core_yoy is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('ECI wages','ECI薪酬') }}<b>{{ '%.1f'|format(S.inflation.eci_comp_yoy) if S.inflation.eci_comp_yoy is not none else '—' }}%</b></div>
      </div>
    </div>
    <div class="card">
      <h2>{{ t('Expectations', '通胀预期') }}</h2>
      <div class="state-val">{{ '%.2f'|format(S.expectations.breakeven_5y5y) if S.expectations.breakeven_5y5y is not none else '—' }}<small>% {{ t('5y5y breakeven', '5年5年盈亏平衡') }}</small></div>
      {% set an = S.expectations.anchoring %}
      <span class="band-chip" style="background:{{ C.red if an=='drifting up' else C.amber if an=='drifting down' else C.green }}">{{ t(an, {'drifting up':'上行脱锚','drifting down':'下行','anchored':'锚定'}[an]) }}</span>
      <div class="kpis">
        <div class="kpi">{{ t('10y breakeven','10年盈亏平衡') }}<b>{{ '%.2f'|format(S.expectations.breakeven_10y) if S.expectations.breakeven_10y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('Model 5y','模型5年') }}<b>{{ '%.2f'|format(S.expectations.model_5y) if S.expectations.model_5y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('Survey 1y','调查1年') }}<b>{{ '%.1f'|format(S.expectations.survey_1y) if S.expectations.survey_1y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('Mkt−model','市场−模型') }}<b>{{ S.expectations.market_minus_model_bp|round|int if S.expectations.market_minus_model_bp is not none else '—' }}bp</b></div>
      </div>
    </div>
  </div>

  {% set D = tx.inflation_decomposition %}
  <div class="card" style="margin-top:12px">
    <h2>{{ t('Inflation decomposition', '通胀分解') }}</h2>
    <div class="decomp">
      <div class="dc"><div class="dcl">{{ t('Headline − core CPI','整体−核心CPI') }}</div><div class="dcv">{{ '%+.2f'|format(D.headline_minus_core) if D.headline_minus_core is not none else '—' }}</div><div class="dcn">{{ t('food / energy push','食品/能源推动') }}</div></div>
      <div class="dc"><div class="dcl">{{ t('Core services YoY','核心服务同比') }}</div><div class="dcv">{{ '%.2f'|format(D.core_services_yoy) if D.core_services_yoy is not none else '—' }}</div><div class="dcn">{{ t('the sticky leg','粘性部分') }}</div></div>
      <div class="dc"><div class="dcl">{{ t('Shelter YoY','住房同比') }}</div><div class="dcv">{{ '%.2f'|format(D.shelter_yoy) if D.shelter_yoy is not none else '—' }}</div><div class="dcn">{{ t('lagging rent','滞后的租金') }}</div></div>
      <div class="dc"><div class="dcl">{{ t('Core PCE − core CPI','核心PCE−核心CPI') }}</div><div class="dcv">{{ '%+.2f'|format(D.pce_minus_cpi) if D.pce_minus_cpi is not none else '—' }}</div><div class="dcn">{{ t('basket / weight gap','篮子/权重差') }}</div></div>
      <div class="dc"><div class="dcl">{{ t('Actual − market-priced','实际−市场定价') }}</div><div class="dcv">{{ D.actual_vs_market_bp|round|int if D.actual_vs_market_bp is not none else '—' }}bp</div><div class="dcn">{{ t('core CPI vs 10y breakeven','核心CPI vs 10年盈亏平衡') }}</div></div>
    </div>
  </div>

  {% if tx.breakeven_decomp %}
  {% set BD = tx.breakeven_decomp %}
  {% set cz = BD.cause_badge.cause %}
  <style>
  .bdkpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(92px,1fr));gap:12px;margin:10px 0 4px}
  .bd-tag{font-size:12px;font-weight:700;padding:4px 10px;border-radius:999px;background:var(--grid);color:var(--ink)}
  .bd-tag.bd-fall{background:rgba(211,11,11,.10);color:var(--red)}
  .bd-tag.bd-rise{background:rgba(26,127,67,.12);color:var(--green)}
  .bd b.dn{color:var(--red)} .bd b.up{color:var(--green)}
  .bd-badge{margin-top:12px;padding:12px 14px;border-radius:12px;border-left:4px solid var(--faint);background:#f3f5f9}
  html[data-theme="dark"] .bd-badge{background:#1c212b}
  .bd-badge-h{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
  .bd-liquidity{border-left-color:var(--red)} .bd-growth{border-left-color:var(--amber)}
  .bd-real_rate{border-left-color:var(--amber)} .bd-oil{border-left-color:var(--teal)}
  .bd-reflation{border-left-color:var(--blue)} .bd-quiet{border-left-color:var(--faint)}
  </style>
  <div class="card bd" style="margin-top:12px">
    <h2>{{ t('Breakeven velocity & cause — visibility only', '盈亏平衡速度与成因 — 仅供观察') }}</h2>
    <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:baseline;margin:2px 0 4px">
      <div class="state-val" style="margin:0">{{ '%.2f'|format(BD.level) if BD.level is not none else '—' }}<small>% {{ t('10y breakeven','10年盈亏平衡') }}</small></div>
      <span class="bd-tag bd-{{ 'fall' if BD.direction=='falling' else 'rise' if BD.direction=='rising' else 'flat' }}">
        {{ t('falling','下行') if BD.direction=='falling' else t('rising','上行') if BD.direction=='rising' else t('flat','平稳') }} ·
        {{ t('downtrend','下降趋势') if BD.trend=='downtrend' else t('uptrend','上升趋势') if BD.trend=='uptrend' else t('choppy','震荡') }}{% if BD.is_fast %} · <b>{{ t('FAST','快速') }}</b>{% endif %}
      </span>
    </div>
    <div class="bdkpis">
      <div class="kpi">{{ t('5d','5日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_5d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_5d_bp|int) if BD.velocity_bp.chg_5d_bp is not none else '—' }}bp</b></div>
      <div class="kpi">{{ t('10d','10日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_10d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_10d_bp|int) if BD.velocity_bp.chg_10d_bp is not none else '—' }}bp</b></div>
      <div class="kpi">{{ t('20d','20日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_20d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_20d_bp|int) if BD.velocity_bp.chg_20d_bp is not none else '—' }}bp</b></div>
      <div class="kpi">{{ t('63d','63日') }}<b class="{{ 'dn' if (BD.velocity_bp.chg_63d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.velocity_bp.chg_63d_bp|int) if BD.velocity_bp.chg_63d_bp is not none else '—' }}bp</b></div>
      <div class="kpi">{{ t('Accel 10d','10日加速') }}<b class="{{ 'dn' if (BD.accel_10d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.accel_10d_bp|int) if BD.accel_10d_bp is not none else '—' }}bp</b></div>
      <div class="kpi">{{ t('Speed pctile','速度分位') }}<b>{{ (BD.fall_speed_pctile*100)|round|int if BD.fall_speed_pctile is not none else '—' }}</b></div>
      <div class="kpi">{{ t('5y5y 20d','5y5y 20日') }}<b class="{{ 'dn' if (BD.cross_check_5y5y_chg_20d_bp or 0) < 0 else 'up' }}">{{ '%+d'|format(BD.cross_check_5y5y_chg_20d_bp|int) if BD.cross_check_5y5y_chg_20d_bp is not none else '—' }}bp</b></div>
    </div>
    <div class="bd-badge bd-{{ cz }}">
      <div class="bd-badge-h">{{ t('Cause','成因') }}: {{ cz|replace('_',' ')|upper }}</div>
      <div>{{ b(BD.cause_badge) }}</div>
    </div>
    {% if BD.tips_liquidity_flag %}<p class="sub" style="color:var(--red);margin-top:8px">⚠ {{ b(BD.tips_liquidity_flag) }}</p>{% endif %}
    <div class="sub faint" style="margin-top:8px">{{ t('Co-state','联动状态') }}:
      {{ t('oil','油') }} {{ '%+.0f'|format(BD.costate.oil_chg_20d_pct) if BD.costate.oil_chg_20d_pct is not none else '—' }}% ·
      {{ t('real 10y','实际10年') }} {{ '%+d'|format(BD.costate.real10y_chg_20d_bp|int) if BD.costate.real10y_chg_20d_bp is not none else '—' }}bp ·
      {{ t('nom 10y','名义10年') }} {{ '%+d'|format(BD.costate.nom10y_chg_20d_bp|int) if BD.costate.nom10y_chg_20d_bp is not none else '—' }}bp ·
      {{ t('HY-OAS z','高收益OAS z') }} {{ BD.costate.hy_oas_z if BD.costate.hy_oas_z is not none else '—' }} ·
      VIX {{ (BD.costate.vix_pctile*100)|round|int if BD.costate.vix_pctile is not none else '—' }}pct</div>
    <p class="sub" style="margin-top:8px">{{ b(BD.caveat) }}</p>
  </div>
  {% endif %}

  {% if yc %}
  <!-- ===================== YIELD CURVE ===================== -->
  <div class="sec-head">{{ t('Yield curve — shape, regime, recession & cross-asset signals', '收益率曲线 — 形态、状态、衰退与跨资产信号') }}</div>
  <p class="sub" style="margin:-4px 0 14px">{{ b(yc.signals.core_macro) }}</p>
  <div class="grid cols-3">
    <!-- ---- Curve shape & decomposition ---- -->
    <div class="card">
      <h2>{{ t('Curve shape', '曲线形态') }}</h2>
      {% set SH = yc.shape %}
      <div class="decomp" style="grid-template-columns:1fr 1fr 1fr">
        <div class="dc"><div class="dcl">{{ t('Level (avg yield)','水平（平均收益率）') }}</div><div class="dcv">{{ '%.2f'|format(SH.level.value) if SH.level.value is not none else '—' }}<small style="font-size:11px;color:var(--muted)">%</small></div><div class="dcn">{{ t('pctile','分位') }} {{ pct(SH.level.pctile) }} · {{ '%+d'|format(SH.level.chg_63d|int) if SH.level.chg_63d is not none else '—' }}bp/63d</div></div>
        <div class="dc"><div class="dcl">{{ t('Slope (2s10s)','斜率（2-10年）') }}</div><div class="dcv">{{ '%+.2f'|format(SH.slope_2s10s.value) if SH.slope_2s10s.value is not none else '—' }}</div><div class="dcn">{{ t('pctile','分位') }} {{ pct(SH.slope_2s10s.pctile) }} · {{ '%+d'|format(SH.slope_2s10s.chg_63d|int) if SH.slope_2s10s.chg_63d is not none else '—' }}bp/63d</div></div>
        <div class="dc"><div class="dcl">{{ t('Curvature (2s5s10s fly)','曲率（2-5-10年蝶式）') }}</div><div class="dcv">{{ '%+.2f'|format(SH.fly_2s5s10s.value) if SH.fly_2s5s10s.value is not none else '—' }}</div><div class="dcn">{{ t('pctile','分位') }} {{ pct(SH.fly_2s5s10s.pctile) }} · {{ t('+ humped / − bowed','+隆起／−凹陷') }}</div></div>
      </div>
      {% if SH.pca and SH.pca.factors %}
      <div style="margin-top:12px">
        <div class="sub" style="font-size:11.5px">{{ t('Principal components of daily curve changes (Litterman-Scheinkman)','日度曲线变动的主成分（Litterman-Scheinkman）') }}</div>
        <div class="pcabar">
          {% for fct in SH.pca.factors %}<span class="{{ 'pc-l' if fct.key=='level' else 'pc-s' if fct.key=='slope' else 'pc-c' }}" style="width:{{ (fct.var_explained*100)|round(1) }}%">{{ (fct.var_explained*100)|round|int }}%</span>{% endfor %}
          {% set resid = 1 - SH.pca.first3_var %}{% if resid and resid > 0.005 %}<span class="pc-r" style="width:{{ (resid*100)|round(1) }}%"></span>{% endif %}
        </div>
        <div class="pcalegend"><span><i style="background:var(--indigo)"></i>{{ t('Level','水平') }}</span><span><i style="background:var(--blue)"></i>{{ t('Slope','斜率') }}</span><span><i style="background:var(--teal)"></i>{{ t('Curvature','曲率') }}</span></div>
        <p class="sub" style="font-size:11px;margin-top:6px">{{ t('The three classic factors span','三个经典因子合计解释') }} <b>{{ (SH.pca.first3_var*100)|round(1) }}%</b> {{ t('of curve variance — the textbook result, measured on our data.','的曲线方差——教科书结论，在我方数据上实测。') }}</p>
      </div>
      {% endif %}
    </div>
    <!-- ---- Curve regime ---- -->
    <div class="card">
      <h2>{{ t('Curve regime', '曲线状态') }}</h2>
      {% set RG = yc.regime %}
      {% if RG.key %}
      {% set rc = {'bull_steepener': C.green, 'bear_steepener': C.amber, 'bull_flattener': C.indigo, 'bear_flattener': C.red} %}
      <div class="curve-regime">
        <span class="regchip" style="background:{{ rc.get(RG.key, C.muted) }}">{{ b(RG.label) }}</span>
        <div class="sub" style="line-height:1.45">{{ b(RG.desc) }}</div>
        <div class="sub" style="font-size:11.5px"><b style="color:var(--ink)">{{ t('Fed-cycle phase','美联储周期阶段') }}:</b> {{ b(RG.fed_phase) }}{% if RG.slope_chg_bp is not none %} · {{ t('slope','斜率') }} {{ '%+d'|format(RG.slope_chg_bp|int) }}bp/{{ RG.window_d }}d{% endif %}{% if RG.term_premium_dir %} · {{ t('term premium','期限溢价') }} {{ t(RG.term_premium_dir, {'rising':'上行','falling':'下行','stable':'平稳'}.get(RG.term_premium_dir, RG.term_premium_dir)) }}{% endif %}</div>
        {% if RG.favored %}<div class="favrow"><span class="fl fav">{{ t('Favoured','受益') }}</span>{% for tk in RG.favored %}<span class="tkpill fav">{{ tk }}</span>{% endfor %}</div>{% endif %}
        {% if RG.pressured %}<div class="favrow"><span class="fl pres">{{ t('Pressured','承压') }}</span>{% for tk in RG.pressured %}<span class="tkpill pres">{{ tk }}</span>{% endfor %}</div>{% endif %}
        <p class="note" style="font-size:12px;margin-top:4px">{{ b(RG.note) }}</p>
      </div>
      {% else %}<p class="sub">{{ t('Curve move indeterminate right now.','当前曲线移动不明确。') }}</p>{% endif %}
    </div>
    <!-- ---- Recession dashboard ---- -->
    <div class="card">
      <h2>{{ t('Recession dashboard', '衰退面板') }}</h2>
      {% set RC = yc.recession %}
      {% set rkc = {'low': C.green, 'watch': C.amber, 'elevated': C.amber, 'high': C.red} %}
      <span class="band-chip" style="background:{{ rkc.get(RC.risk, C.muted) }}">{{ t(RC.risk, {'low':'低','watch':'观察','elevated':'升高','high':'高'}.get(RC.risk, RC.risk)) }} · {{ RC.n_flags }}/4 {{ t('flags','项亮起') }}</span>
      <div class="recgauges">
        <div class="recg {{ 'flag-on' if 'ntfs' in RC.flags else '' }}"><div class="rgl">{{ t('Near-term fwd spread','近端远期利差') }}</div><div class="rgv">{{ '%+.2f'|format(RC.ntfs) if RC.ntfs is not none else '—' }}</div></div>
        <div class="recg {{ 'flag-on' if 'probit' in RC.flags else '' }}"><div class="rgl">{{ t('NY Fed 10y-3m probit','纽约联储10年-3月概率') }}</div><div class="rgv">{{ RC.nyfed_prob|int if RC.nyfed_prob is not none else '—' }}%</div></div>
        <div class="recg {{ 'flag-on' if 'uninversion' in RC.flags else '' }}"><div class="rgl">{{ t('Un-inversion alarm','重新变陡警报') }}</div><div class="rgv">{{ t('YES','是') if RC.uninversion else t('no','否') }}</div></div>
        <div class="recg {{ 'flag-on' if 'tp_adj' in RC.flags else '' }}"><div class="rgl">{{ t('TP-adjusted 2s10s','期限溢价调整2-10年') }}</div><div class="rgv">{{ '%+.2f'|format(RC.tp_adj_curve) if RC.tp_adj_curve is not none else '—' }}</div></div>
      </div>
      {% if RC.policy_stance %}{% set PS = RC.policy_stance %}<div class="flag {{ 'warn' if PS.stance=='restrictive' else 'ok' if PS.stance=='accommodative' else 'info' }}" style="display:block;margin:2px 0 6px">{{ t('Policy stance','政策立场') }}: <b>{{ '%.2f'|format(PS.fed_funds) }}%</b> {{ t('funds vs','基金 vs') }} ~{{ '%.1f'|format(PS.neutral_anchor) }}% = {{ t(PS.stance, {'restrictive':'偏紧','accommodative':'宽松','neutral':'中性'}.get(PS.stance, PS.stance)) }} ({{ '%+.2f'|format(PS.gap_pp) }}pp)</div>{% endif %}
      <p class="note" style="font-size:11.5px;margin-top:4px">{{ b(RC.lead_time_note) }}{% if RC.policy_stance %} {{ b(RC.policy_stance.note) }}{% endif %}</p>
    </div>
  </div>

  <!-- ---- slopes table + forwards ---- -->
  <div class="grid cols-2" style="margin-top:14px">
    <div class="card">
      <h2>{{ t('Slopes & momentum', '斜率与动能') }}</h2>
      <table class="slopes">
        <tr><th>{{ t('Spread','利差') }}</th><th>{{ t('Level','水平') }}</th><th>{{ t('%ile','分位') }}</th><th>{{ t('63d Δ','63日变动') }}</th></tr>
        {% for k, s in yc.slopes.items() %}
        <tr><td class="nm">{{ b(s.label) }}</td><td class="{{ 'inv' if s.inverted else '' }}">{{ '%+.2f'|format(s.value) if s.value is not none else '—' }}</td><td>{{ pct(s.pctile) }}</td><td>{{ '%+d'|format(s.chg_63d_bp|int) if s.chg_63d_bp is not none else '—' }}bp</td></tr>
        {% endfor %}
      </table>
      {% set M = yc.momentum %}
      <p class="sub" style="font-size:11.5px;margin-top:8px">{{ t('Curve speed (63d)','曲线速度（63日）') }}: {{ t('real 10y','实际10年') }} {{ '%+d'|format(M.real10y_speed_bp|int) if M.real10y_speed_bp is not none else '—' }}bp · {{ t('front 2y','前端2年') }} {{ '%+d'|format(M.front2y_speed_bp|int) if M.front2y_speed_bp is not none else '—' }}bp · {{ t('|real-speed| pctile','|实际速度|分位') }} {{ pct(M.real_speed_pctile) }}. {{ t('Rate-of-change beats level — the SPEED of a real-yield move breaks equities more than its level.','变动速度胜过水平——实际收益率移动的速度比其水平更能冲击股票。') }}</p>
      {% if M.trend_spread is not none %}<p class="sub" style="font-size:11.5px;margin-top:4px">{{ t('Term-spread trend (2y smooth)','期限利差趋势（2年平滑）') }}: <b style="color:var(--ink)">{{ '%+.2f'|format(M.trend_spread) }}</b>{% if M.trend_spread_dir %} · {{ t(M.trend_spread_dir, {'rising':'上行','falling':'下行','flat':'平稳'}.get(M.trend_spread_dir, M.trend_spread_dir)) }}{% endif %}. {{ t('The literature flags the smoothed, business-cycle-frequency component of the 3m10y spread as the curve read with genuine equity-premium content (Faria-Verona 2020) — but OUR calibration finds it regime-dependent (the IC sign flips post-2015), so we carry it as context, never a timing signal.','文献认为3月-10年利差经平滑的商业周期频率成分是收益率曲线中具有真正股权溢价含义的读数（Faria-Verona 2020）——但我方校准发现其依赖状态（IC符号在2015年后翻转），故仅作背景，绝非择时信号。') }}</p>{% endif %}
    </div>
    <div class="card">
      <h2>{{ t('Forward rates & carry', '远期利率与持有收益') }}</h2>
      {% set FW = yc.forwards %}
      <div class="kpis">
        <div class="kpi">{{ t('1y1y fwd','1年1年远期') }}<b>{{ '%.2f'|format(FW.f_1y1y) if FW.f_1y1y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('2y1y fwd','2年1年远期') }}<b>{{ '%.2f'|format(FW.f_2y1y) if FW.f_2y1y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('5y5y fwd','5年5年远期') }}<b>{{ '%.2f'|format(FW.f_5y5y) if FW.f_5y5y is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('10y carry','10年持有') }}<b>{{ '%.2f'|format(FW.carry_10y_pct) if FW.carry_10y_pct is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('10y roll-down','10年滚动') }}<b>{{ '%+.2f'|format(FW.rolldown_10y_pct) if FW.rolldown_10y_pct is not none else '—' }}%</b></div>
        <div class="kpi">{{ t('carry + roll','持有＋滚动') }}<b>{{ '%.2f'|format(FW.carry_roll_10y_pct) if FW.carry_roll_10y_pct is not none else '—' }}%</b></div>
      </div>
      <p class="note" style="font-size:12px;margin-top:10px">{{ b(FW.note) }}</p>
    </div>
  </div>

  <!-- ---- signal families: sector tilt + factor + market tendency ---- -->
  <div class="card" style="margin-top:14px">
    <h2>{{ t('Curve signals — sector, style & market tendency', '曲线信号 — 板块、风格与市场倾向') }}</h2>
    {% set SG = yc.signals %}
    <div class="sub" style="font-size:11.5px">{{ t('Per-sector curve tilt under the current regime. ✓meas = a calibrated forward-IC edge in the transmission matrix; ·thy = textbook channel only.','当前状态下各板块的曲线倾向。✓实测＝传导矩阵中存在校准的前瞻IC优势；·理论＝仅教科书传导。') }}</div>
    <div class="sectilt">
      {% for s in SG.sector %}
      <div class="stile {{ 'tail' if s.tilt=='tailwind' else 'head' if s.tilt=='headwind' else '' }}">
        <span class="se">{{ s.etf }}</span><span class="sb {{ 'meas' if s.basis=='measured' else '' }}" title="{{ 'measured forward IC ('+(s.verdict|lower)+')' if s.basis=='measured' else 'textbook channel, no measured edge' }}">{{ '✓'+(s.ic_driver or '')+' '+('%+.2f'|format(s.ic) if s.ic is not none else '') if s.basis=='measured' else '·thy' }}</span>
        <div class="sm">{{ t(s.tilt, {'tailwind':'顺风','headwind':'逆风','neutral':'中性'}.get(s.tilt,s.tilt)) }} · {{ t(s.duration, {'long':'长久期','short':'短久期','neutral':'久期中性'}.get(s.duration,s.duration)) }}<br>{{ b(s.mech) }}</div>
      </div>
      {% endfor %}
    </div>
    <div style="margin-top:16px">
      <div class="sub" style="font-size:11.5px;font-weight:700;color:var(--ink)">{{ t('Equity style / factor','股票风格／因子') }}</div>
      {% set FC = SG.stock_factor %}
      <div class="facrow">
        <div class="facpill"><span class="fk">{{ t('Value vs growth','价值vs成长') }}</span><span class="fv">{{ t(FC.value_vs_growth|capitalize, {'value':'价值','growth':'成长','neutral':'中性'}.get(FC.value_vs_growth, FC.value_vs_growth)) }}</span></div>
        <div class="facpill"><span class="fk">{{ t('Size','规模') }}</span><span class="fv">{{ t({'small':'Small caps','large':'Large caps','neutral':'Neutral'}.get(FC.size, FC.size), {'small':'小盘','large':'大盘','neutral':'中性'}.get(FC.size, FC.size)) }}</span></div>
        <div class="facpill"><span class="fk">{{ t('Duration factor','久期因子') }}</span><span class="fv">{{ t(FC.duration_factor, {'headwind':'逆风','tailwind':'顺风','neutral':'中性'}.get(FC.duration_factor, FC.duration_factor)) }}</span></div>
      </div>
      <p class="note" style="font-size:12px">{{ b(FC.note) }}</p>
    </div>
    <div style="margin-top:12px">
      <div class="sub" style="font-size:11.5px;font-weight:700;color:var(--ink)">{{ t('Market tendency (curve-speed → drawdown risk)','市场倾向（曲线速度→回撤风险）') }}</div>
      {% set MT = SG.market_tendency %}
      {% set mtc = {'calm': C.green, 'watch': C.amber, 'elevated': C.red} %}
      <span class="band-chip" style="background:{{ mtc.get(MT.drawdown_risk, C.muted) }};margin:6px 0">{{ t(MT.drawdown_risk, {'calm':'平静','watch':'观察','elevated':'升高'}.get(MT.drawdown_risk, MT.drawdown_risk)) }}</span>
      <p class="note" style="font-size:12px">{{ b(MT.label) }}</p>
    </div>
    <div class="flag info" style="display:block;margin-top:10px">{{ b(yc.scored_status) }}</div>
  </div>
  {% endif %}

  <!-- ===================== CROSS-ASSET HEADWIND / TAILWIND ===================== -->
  <div class="sec-head">{{ t('Cross-asset transmission — what each asset faces now', '跨资产传导 — 各资产当前所面对的') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2 style="color:var(--red)">{{ t('Headwinds', '逆风') }}</h2>
      {% if tx.headwinds %}{% for h in tx.headwinds %}
      <div class="tbar"><span class="tname"><span class="l-en">{{ h.label.en }}</span><span class="l-zh">{{ h.label.zh }}</span></span>
        <span class="ttrack"><span class="tmid"></span><span class="tfill head" style="width:{{ [(h.net|abs)*90, 50]|min }}%"></span></span>
        <span class="tval" style="color:var(--red)">{{ '%.2f'|format(h.net) }}</span></div>
      <div class="tdrv">{% for p in h.top_drivers %}{{ p.label }}{{ vg(p.verdict) }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
      {% endfor %}{% else %}<p class="sub">{{ t('No clear rate/inflation headwind right now.', '当前无明显的利率/通胀逆风。') }}</p>{% endif %}
    </div>
    <div class="card">
      <h2 style="color:var(--green)">{{ t('Tailwinds', '顺风') }}</h2>
      {% if tx.tailwinds %}{% for h in tx.tailwinds %}
      <div class="tbar"><span class="tname"><span class="l-en">{{ h.label.en }}</span><span class="l-zh">{{ h.label.zh }}</span></span>
        <span class="ttrack"><span class="tmid"></span><span class="tfill tail" style="width:{{ [(h.net|abs)*90, 50]|min }}%"></span></span>
        <span class="tval" style="color:var(--green)">{{ '%+.2f'|format(h.net) }}</span></div>
      <div class="tdrv">{% for p in h.top_drivers %}{{ p.label }}{{ vg(p.verdict) }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
      {% endfor %}{% else %}<p class="sub">{{ t('No clear rate/inflation tailwind right now.', '当前无明显的利率/通胀顺风。') }}</p>{% endif %}
    </div>
  </div>
  <p class="sub" style="margin-top:8px">{{ t('Net = the sum of each active driver’s current extension × its measured forward IC for that asset (the change / gap drivers only; raw levels are excluded as co-trend). ✓ confirmed split-half · ~ directional · ⤫ inverted (effect measured opposite the chain direction) · · context.', '净值＝各活跃驱动的当前偏离度 × 其对该资产的实测前瞻IC之和（仅取变动/缺口类驱动；原始水平因共趋势而剔除）。✓ 前后半段确认 · ~ 有方向 · ⤫ 反向（实测效应与链条方向相反）· · 仅背景。') }}</p>

  <!-- ===================== TRANSMISSION CHAINS ===================== -->
  <div class="sec-head">{{ t('Transmission chains — first → second → third order', '传导链 — 一阶 → 二阶 → 三阶') }}</div>
  {% for ch in tx.chains %}
  <div class="card chain {{ '' if ch.active else 'dim' }}" style="margin-bottom:14px">
    <div class="chain-head">
      <span><span class="l-en">{{ ch.title.en }}</span><span class="l-zh">{{ ch.title.zh }}</span></span>
      <span class="chain-state {{ 'on' if ch.active else 'off' }}">{{ t('ACTIVE','活跃') if ch.active else t('dormant','静默') }}{% if ch.trigger_z is not none %} · {{ ch.trigger_label }} {{ '%+.1f'|format(ch.trigger_z) }}σ{% endif %}</span>
    </div>
    {% for o in ch.orders %}
    <div class="order">
      <span class="onum">{{ o.order }}</span>
      <div>
        <div class="otext"><span class="l-en">{{ o.text.en }}</span><span class="l-zh">{{ o.text.zh }}</span></div>
        <div class="ocells">{% for c in o.assets %}{{ effchip(c) }}{% endfor %}</div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <!-- ===================== SCENARIOS ===================== -->
  <div class="sec-head">{{ t('Conditional scenarios — if this shock holds a quarter', '情景推演 — 若该冲击持续一个季度') }}</div>
  <div class="grid cols-2">
  {% for sc in tx.scenarios %}
    <div class="scen">
      <h3><span class="l-en">{{ sc.label.en }}</span><span class="l-zh">{{ sc.label.zh }}</span></h3>
      <div class="scen-row">
        <div class="scen-col head"><div class="scl">{{ t('Pressured','承压') }}</div>
          {% for m in sc.headwinds %}<div class="smv"><span><span class="l-en">{{ m.label.en }}</span><span class="l-zh">{{ m.label.zh }}</span></span><b class="neg">{{ '%.1f'|format(m.implied_move_pct) }}%</b></div>{% else %}<div class="sub">—</div>{% endfor %}
        </div>
        <div class="scen-col tail"><div class="scl">{{ t('Favoured','受益') }}</div>
          {% for m in sc.tailwinds %}<div class="smv"><span><span class="l-en">{{ m.label.en }}</span><span class="l-zh">{{ m.label.zh }}</span></span><b class="pos">+{{ '%.1f'|format(m.implied_move_pct) }}%</b></div>{% else %}<div class="sub">—</div>{% endfor %}
        </div>
      </div>
    </div>
  {% endfor %}
  </div>
  <p class="sub" style="margin-top:6px">{{ t('Implied move = the asset’s MEASURED contemporaneous 63-day beta to that driver × the shock. Illustrative & regime-dependent — not a forecast, and the shock must actually persist.', '隐含涨跌＝该资产对此驱动实测的同期63日beta × 冲击幅度。仅为示意且依赖状态——并非预测，且冲击须真实持续。') }}</p>

  <!-- ===================== HONESTY / SCORED-LEG GATE ===================== -->
  <div class="card" style="margin-top:22px">
    <h2>{{ t('How this is graded · and what it is not', '如何评级 · 以及它不是什么') }}</h2>
    <div class="flag info" style="display:block;margin-bottom:10px"><span class="l-en">{{ tx.scored_status.en }}</span><span class="l-zh">{{ tx.scored_status.zh }}</span></div>
    {% if gate %}
    <table class="gate">
      <tr><th>{{ t('Candidate leg','候选腿') }}</th><th>{{ t('Verdict','判定') }}</th><th class="num">{{ t('IC dd (f/pre/post)','IC回撤(全/前/后)') }}</th><th class="num">{{ t('hi-tercile edge','高三分位超额') }}</th><th>{{ t('scored?','计分?') }}</th></tr>
      {% for k, s in gate.items() %}
      <tr><td>{{ s.label }}</td><td>{{ s.verdict }}</td><td class="num">{{ s.ic_dd_full }}/{{ s.ic_dd_pre }}/{{ s.ic_dd_post }}</td><td class="num">{{ s.conditional.high_edge_pp if s.conditional else '—' }}pp</td><td>{{ '✅' if s.scored_eligible else '—' }}</td></tr>
      {% endfor %}
    </table>
    {% endif %}
    <div class="note" style="margin-top:12px">
      {% for c in tx.caveats %}<p>• <span class="l-en">{{ c.en }}</span><span class="l-zh">{{ c.zh }}</span></p>{% endfor %}
      <p><b>{{ t('Data.','数据。') }}</b> {{ t('Free / keyless FRED: full Treasury curve, real yields (TIPS), 5y/10y/5y5y breakevens, term premium; headline & core CPI, headline & core PCE (the Fed’s 2% target gauge), PPI, ECI wage growth, shelter & core-services CPI; Cleveland model + UMich survey inflation expectations. All point-in-time vintaged for honest backtests.', '免费/无密钥的FRED：完整国债曲线、实际利率(TIPS)、5/10年与5年5年盈亏平衡、期限溢价；整体与核心CPI、整体与核心PCE（美联储2%目标）、PPI、ECI工资增长、住房与核心服务CPI；克利夫兰模型与密歇根调查通胀预期。均按时点存档以便诚实回测。') }}</p>
      <p class="meta-foot">{{ t('Calibration','校准') }}: scripts/calibrate_rate_inflation.py · {{ t('report','报告') }} reports/rate-inflation-transmission-calibration.md · {{ t('History','历史') }} {{ span }} · {{ t('built','构建于') }} {{ built }}</p>
    </div>
  </div>
</div>

<script src="theme.js"></script>
<footer class="site-footer">
  <span>© 2026 Mastermind Inc</span>
</footer>
</body>
</html>
