      <div style="margin:6px 0">${b.parent?`<span class="chip">${L(esc(b.parent),esc(b.parent_zh||b.parent))}</span>`:''}${b.category?`<span class="chip">${L(esc(b.category),esc(b.category_zh||b.category))}</span>`:''}${tags}</div>
