{# ============================================================================
   SHARED Risk Radar card (.rrx) — the one redesigned alert used on BOTH the US
   Macro / US-Stocks pages (engine/risk_radar.py) AND the China / HK / Canada
   home-page Market-State boards (engine/risk_radar_intl.py). Import it:

       {% import "_risk_radar_card.html.j2" as rrc %}
       {{ rrc.risk_radar_card(rd, scares) }}

   It is self-contained (defines its own t()/help() so imported macros resolve),
   token-only with an inline --rc state accent so it renders identically in the
   page-macro, page-stocks, and china/hk/canada scopes. The matching CSS lives in
   _risk_radar_card.css.j2 (included by dashboard.html.j2 + _market_state.css.j2).
   ============================================================================ #}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{# plain-English name for a raw radar firing-leg code (US engine/risk_radar.py keys +
   the international engine/risk_radar_intl.py keys) so the evidence reads like English,
   not engine internals. #}
{% macro rr_leg(leg) -%}
{%- set m = {
  'credit_oas_roc':   ('HY credit spreads widening','高收益利差走阔'),
  'credit_hyg_tlt':   ('HY bonds lagging Treasuries','高收益债跑输国债'),
  'rates_move':       ('Bond-market volatility (MOVE)','债市波动率（MOVE）'),
  'rates_realrate':   ('Real yields jumping','实际利率跳升'),
  'bubble_ext':       ('S&P stretched vs 200-day','标普超买（>200日线）'),
  'bubble_leadership':('Narrow leadership (semis)','领涨过窄（半导体）'),
  'growth_defensives':('Defensives outperforming','防御股跑赢'),
  'growth_cyc_def':   ('Cyclicals fading vs defensives','周期股弱于防御'),
  'vol_term':         ('VIX term-structure stress','VIX 期限结构紧张'),
  'vol_putcall':      ('Put/call skew','认沽/认购偏斜'),
  'vol_gex':          ('Dealer gamma (GEX)','做市商 Gamma'),
  'global_breadth':   ('Global breadth < 200-day (C3)','全球广度跌破200日（C3）'),
  'us_rate_2y':       ('US 2-year yield jump','美债2年利率跳升'),
  'us_rate_10y':      ('US 10-year yield jump','美债10年利率跳升'),
  'us_real_rate':     ('US real yield jump','美债实际利率跳升'),
  'us_cn_diff':       ('US–China yield gap widening','中美利差走阔'),
  'usd_cnh':          ('Yuan depreciation (USD/CNH)','人民币贬值'),
  'usd_strength':     ('US dollar strength','美元走强'),
  'cn_breadth':       ('A-share breadth < 200-day','A股广度跌破200日'),
  'ca_breadth':       ('TSX breadth < 200-day','多指广度跌破200日'),
} -%}{%- set p = m.get(leg, (leg, leg)) -%}{{ t(p[0], p[1]) }}
{%- endmacro %}
{# The card itself. Built only from a radar (rd = market_state.radar) + its scares.
   Replaces the old cramped "Pullback odds · 5d.. 10d.. 21d.." text run with an
   escalating odds ramp drawn against the normal base rate, a state-coloured header,
   compact threat meters + plain-English evidence, and the action line. #}
{% macro risk_radar_card(rd, scares) -%}
{%- set rc = 'var(--act)' if rd.state=='risk-off' else ('var(--orange)' if rd.state=='elevated' else ('var(--warn)' if rd.state=='caution' else ('var(--info)' if rd.state=='watch' else 'var(--ok)'))) -%}
{#- icon ladder (RRX2 WA-1): 👀 retired; watch shows 🌤️ when recovery panel is receding else 📡.
   Truthiness-only on rd.recovery.receding — never `is not none` (crashes on missing keys, Jinja codebase law). -#}
{%- set _rec_receding = rd.recovery and rd.recovery.present and rd.recovery.receding -%}
{%- set ic = '🛑' if rd.state=='risk-off' else ('🚨' if rd.state=='elevated' else ('⚠️' if rd.state=='caution' else ('🌤️' if (rd.state=='watch' and _rec_receding) else ('📡' if rd.state=='watch' else '✅')))) -%}
{%- set base = rd.dd_base if (rd.dd_base and rd.dd_base.h21 is not none) else {'h5':0.036,'h10':0.086,'h21':0.178} -%}
{%- set hmax = (rd.dd21 / 0.82) if (rd.dd21 is not none and rd.dd21 > 0) else 0.25 -%}
<div class="rrx rrx-{{ rd.state }}{{ ' rrx-loud' if rd.is_loud }}" style="--rc:{{ rc }}">
  {# .rrx-main / .rrx-side are display:contents by default (no layout change on the China/HK/
     Canada/stocks cards); only the macro front-page promotes them to a 2-column banner. #}
  <div class="rrx-main">
  <div class="rrx-hd">
    <span class="rrx-ic">{{ ic }}</span>
    <div class="rrx-id">
      <div class="rrx-ttl">{{ t('Risk Radar','风险雷达') }}
        <span class="rrx-badge">{{ t(rd.state|upper, rd.state_zh) }}{% if rd.top_score is not none %} · {{ rd.top_score }}/100{% endif %}</span>
        {{ help('Pullback-risk gauge. Use high readings to trim risk, not to pick stocks.', '回撤风险仪表。高读数用于降风险，不用于选股。') }}
      </div>
      {% if rd.label_en %}<div class="rrx-dom">{{ t(rd.label_en, rd.label_zh) }}</div>{% endif %}
      {% if rd.amp and rd.amp > 0 %}<div class="rrx-amp">▲ {{ t('Amplified','放大') }} — <span class="l-en">{{ rd.amp_flags_en|join(' · ') }}</span><span class="l-zh">{{ rd.amp_flags_zh|join(' · ') }}</span></div>{% endif %}
    </div>
    {% if rd.gross is not none and rd.gross < 1 %}<div class="rrx-gross"><span class="gv">×{{ '%.2f'|format(rd.gross) }}</span><span class="gn">{{ t('gross','建议仓位') }}</span></div>{% endif %}
  </div>

  {% if rd.dd21 is not none %}
  <div class="rrx-odds">
    <div class="rrx-odds-l">
      <div class="rrx-cap">{{ t('Pullback odds','回撤概率') }} <span class="rrx-cap-sub">{{ t('≥5% drop · escalating','≥5% · 递增') }}</span></div>
      <div class="rrx-big">{{ (rd.dd21*100)|round|int }}<span class="pct">%</span><span class="rrx-hz">{{ t('within 21 days','21 日内') }}</span></div>
      <div class="rrx-vsn">{% if rd.dd_lift is not none %}<b>{{ rd.dd_lift }}×</b> {% endif %}{{ t('vs normal','对比常态') }} {{ (base.h21*100)|round|int }}%</div>
    </div>
    <div class="rrx-ramp">
      {% for h in [ ('5d','5日',rd.dd5,base.h5), ('10d','10日',rd.dd10,base.h10), ('21d','21日',rd.dd21,base.h21) ] %}
      {%- set odd = h[2] if h[2] is not none else 0 -%}
      {%- set bs = h[3] if h[3] is not none else 0 -%}
      <div class="rrx-col{{ ' is-hd' if loop.last }}">
        <span class="rrx-v">{{ (odd*100)|round|int }}%</span>
        <div class="rrx-tk">
          <div class="rrx-norm" style="height:{{ [(bs/hmax*100)|round|int, 2]|max }}%"></div>
          <div class="rrx-fill" style="height:{{ [(odd/hmax*100)|round|int, 6]|max }}%"></div>
        </div>
        <span class="rrx-hl">{{ t(h[0], h[1]) }}</span>
      </div>
      {% endfor %}
      <span class="rrx-leg"><span class="rrx-leg-n"></span>{{ t('normal','常态') }}</span>
    </div>
  </div>
  {% endif %}
  </div>{# /.rrx-main #}

  <div class="rrx-side">
  {# DE-ESCALATION panel (engine/risk_radar_recovery.py) — "risk has peaked / the risk-off may be
     ending". DISPLAY-ONLY: it never relaxes the radar's one-directional score ceiling. Shows the
     pullback-odds turn (peak → now) as a sparkline + the supportive-liquidity catalysts firing now
     (Fed net-liq/TGA, Fed cuts, PBoC easing, the global Fed+ECB+BoJ tide). Persists through the
     cool-down so the "it may be over soon" read stays visible after the loud alert fades. #}
  {% if rd.recovery and rd.recovery.present %}{% set rv = rd.recovery %}
  {%- set rvc = 'var(--ok)' if rv.receding else 'var(--info)' -%}
  <div class="rrx-rec{{ ' is-turn' if rv.turn_confirmed }}" style="--rvc:{{ rvc }}">
    <div class="rrx-rec-hd">
      <span class="rrx-rec-ar">{{ '↘' if rv.receding else '◔' }}</span>
      <span class="rrx-rec-ttl">{{ t(rv.headline_en, rv.headline_zh) }}</span>
      {% if rv.turn_confirmed %}<span class="rrx-rec-tag">{{ t('TURN','转向') }}</span>{% endif %}{% if rv.turn_confirmed_full %}<span class="rrx-rec-tag">{{ t('INTERNALS ✓','内部确认 ✓') }}</span>{% endif %}
      {{ help(rv.caveat_en, rv.caveat_zh) }}
    </div>
    <div class="rrx-rec-mid">
      {% if rv.spark_pts %}
      <svg class="rrx-rec-spark" viewBox="0 0 {{ rv.spark_w }} {{ rv.spark_h }}" preserveAspectRatio="none" aria-hidden="true">
        <polyline points="{{ rv.spark_pts }}" fill="none" stroke="var(--rvc)" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/>
        {% if rv.spark_peak %}<circle class="pk" cx="{{ rv.spark_peak.x }}" cy="{{ rv.spark_peak.y }}" r="1.6"/>{% endif %}
        {% if rv.spark_last %}<circle class="lx" cx="{{ rv.spark_last.x }}" cy="{{ rv.spark_last.y }}" r="2.1"/>{% endif %}
      </svg>
      {% endif %}
      <span class="rrx-rec-sub">{{ t(rv.sub_en, rv.sub_zh) }}</span>
    </div>
    {% if rv.catalysts %}
    <div class="rrx-rec-cats">
      {#- RRX2 WA-2: row names WHO (Central banks); chips name WHAT — kills "Liquidity: Fed liquidity expanding" redundancy -#}
      <span class="rrx-rec-k">{{ t('Central banks','央行') }}</span>
      {% for c in rv.catalysts %}<span class="rrx-rec-chip{{ ' fresh' if c.fresh }}">{{ c.icon }} {{ t(c.label_en, c.label_zh) }}{{ help(c.detail_en, c.detail_zh) }}</span>{% endfor %}
    </div>
    {% else %}
    <div class="rrx-rec-cats none">{{ t('No liquidity catalyst yet — risk easing on its own; watch for a policy / liquidity turn to confirm.','尚无流动性催化 — 风险自行回落；留意政策／流动性转向以确认。') }}</div>
    {% endif %}
    {#- Market-INTERNAL confirmation channel (engine/risk_radar_market_catalysts.py, W1) — the
       second leg of the two-channel turn read (RRX masterplan §4A). US radar only (the intl
       payloads carry market=None by scoping). ACCRUING: forward-graded on the rebound ruler
       (risk_radar_recovery_audit) before it is ever trusted; the fired chips are context, not
       an all-clear. Old artifacts lack rv.market entirely -> this block renders NOTHING (the
       whitespace-control below keeps the no-market output byte-identical to the prior card).
       RRX2 WA: channel field added to chips — filter to channel=='internals' (C1–C7) so new
       mood/tape chips never appear in this row. Old artifacts without channel fall through
       selectattr gracefully (undefined channel = not equal to 'internals' = excluded from filter,
       so old artifacts render no internals chips here; new artifacts filter correctly). -#}
    {%- if rv.market and rv.market.chips %}
    {%- set internals_chips = rv.market.chips | selectattr('channel', 'defined') | selectattr('channel', 'equalto', 'internals') | list %}
    {#- Legacy fallback: old artifacts have no 'channel' key; treat ALL chips as internals in that case -#}
    {%- set legacy_chips = rv.market.chips | rejectattr('channel', 'defined') | list %}
    {%- set fired_internals = (internals_chips if internals_chips else legacy_chips) | selectattr('fired') | list %}
    <div class="rrx-rec-cats">
      <span class="rrx-rec-k">{{ t('Internals','市场内部') }}{{ help('Market-internal confirmation chips (breadth thrusts, follow-through, capitulation-resolution, credit rollover). Accruing — every read is forward-graded before the channel is trusted; not an all-clear.','市场内部确认信号（广度推进、放量确认、恐慌解除、信用利差回落）。积累中 — 每次读取均做前瞻评分后方可信任；并非解除警报。') }}</span>
      {% if fired_internals %}{% for c in fired_internals %}<span class="rrx-rec-chip{{ ' fresh' if c.fresh }}">{{ t(c.label_en, c.label_zh) }}</span>{% endfor %}
      {% else %}<span class="rrx-rec-chip">{{ t('no internal confirmation yet','尚无内部确认') }}</span>{% endif %}
      {% if rv.market.veto and rv.market.veto.active %}<span class="rrx-rec-chip">⚠ {{ t('vol still unstable — turn not trusted','波动仍未稳定 — 转向暂不可信') }}</span>{% endif %}
    </div>
    {#- RRX2 WA-3: drivers line ("what faded / still warm") — from rv.drivers injected by trajectory.
       Absent on old artifacts (no drivers key) → render nothing. -#}
    {%- if rv.drivers %}
    {%- set faded = rv.drivers.faded if rv.drivers.faded else [] %}
    {%- set warm = rv.drivers.warm if rv.drivers.warm else [] %}
    {%- if faded or warm %}
    <div class="rrx-rec-drv">
      {%- if faded %}<span class="l-en">What faded: {% for d in faded %}{% if not loop.first %} · {% endif %}{{ d.label_en }} {{ d.peak|round|int }}→{{ d.now|round|int }}{% endfor %}</span><span class="l-zh">已消退：{% for d in faded %}{% if not loop.first %} · {% endif %}{{ d.label_zh }} {{ d.peak|round|int }}→{{ d.now|round|int }}{% endfor %}</span>{% endif %}
      {%- if warm %}<span class="l-en">{{ ' — still warm: ' if faded else 'Still warm: ' }}{% for d in warm %}{% if not loop.first %} · {% endif %}{{ d.label_en }} {{ d.now|round|int }}{% endfor %}</span><span class="l-zh">{{ ' — 仍处高温：' if faded else '仍处高温：' }}{% for d in warm %}{% if not loop.first %} · {% endif %}{{ d.label_zh }} {{ d.now|round|int }}{% endfor %}</span>{% endif %}
    </div>
    {%- endif %}
    {%- endif %}
    {#- RRX2 WA-4: Mood channel (C9–C11: NAAIM, FRBSF DNSI, COT ES). US radar only (rv.market).
       Intl payloads: rv.market is None → this block is never reached.
       Old artifacts without channel field: internals_chips and legacy_chips logic above handles
       them; mood_chips below will be empty (no chip has channel='mood') → row suppressed. -#}
    {%- set mood_chips = rv.market.chips | selectattr('channel', 'defined') | selectattr('channel', 'equalto', 'mood') | list %}
    {%- if mood_chips %}
    {%- set fired_mood = mood_chips | selectattr('fired') | list %}
    <div class="rrx-rec-cats">
      <span class="rrx-rec-k">{{ t('Mood','情绪') }}{{ help('Accruing — forward-graded on the rebound ruler before the channel is trusted; not an all-clear.','积累中 — 在信任该渠道前均做前瞻评分；并非解除警报。') }}</span>
      {% if fired_mood %}{% for c in fired_mood %}<span class="rrx-rec-chip{{ ' fresh' if c.fresh }}">{{ t(c.label_en, c.label_zh) }}</span>{% endfor %}
      {% else %}<span class="rrx-rec-chip muted">{{ t('no signal yet','尚无信号') }}</span>{% endif %}
    </div>
    {%- endif %}
    {#- RRX2 WA-4: Tape channel (C12: fast reclaim / V-recovery) + morphology label. -#}
    {%- set tape_chips = rv.market.chips | selectattr('channel', 'defined') | selectattr('channel', 'equalto', 'tape') | list %}
    {%- if tape_chips %}
    {%- set fired_tape = tape_chips | selectattr('fired') | list %}
    <div class="rrx-rec-cats">
      <span class="rrx-rec-k">{{ t('Tape','盘面') }}{{ help('Accruing — forward-graded on the rebound ruler before the channel is trusted; not an all-clear.','积累中 — 在信任该渠道前均做前瞻评分；并非解除警报。') }}</span>
      {% if fired_tape %}{% for c in fired_tape %}<span class="rrx-rec-chip{{ ' fresh' if c.fresh }}">{{ t(c.label_en, c.label_zh) }}</span>{% endfor %}
      {% else %}<span class="rrx-rec-chip muted">{{ t('no signal yet','尚无信号') }}</span>{% endif %}
    </div>
    {#- Morphology label: one line explaining the recovery shape, from rv.market.morphology.
       Absent on old artifacts (no morphology key) → render nothing. -#}
    {%- if rv.market.morphology %}
    {%- set mph = rv.market.morphology %}
    <div class="rrx-rec-drv">{{ t(mph.detail_en, mph.detail_zh) }}</div>
    {%- endif %}
    {%- endif %}
    {%- endif %}
    {% if rv.do_en %}<div class="rrx-rec-do"><span class="rrx-rec-do-k">{{ t('Do','应对') }}</span>{{ t(rv.do_en, rv.do_zh) }}</div>{% endif %}
  </div>
  {% endif %}
  {% if scares %}
  <div class="rrx-threats">
    {% for s in scares %}{% if s.score is not none %}
    {%- set sb = 'var(--act)' if s.band=='risk-off' else ('var(--orange)' if s.band=='elevated' else ('var(--warn)' if s.band=='caution' else ('var(--info)' if s.band=='watch' else 'var(--muted)'))) -%}
    {%- set dom = (s.label_en == rd.label_en) -%}
    {%- set dim = (s.tier == 'B') -%}
    <span class="rrx-th{{ ' dom' if dom }}{{ ' dim' if dim }}" style="--sb:{{ sb }}">
      <span class="rrx-th-n">{{ t(s.label_en, s.label_zh) }}</span>
      <span class="rrx-meter">{% for i in range(10) %}<i class="{{ 'on' if i < (s.score/10)|round(0,'floor')|int }}"></i>{% endfor %}</span>
      <b class="rrx-th-s">{{ s.score|round|int }}</b>{% if dim %}<span class="rrx-tag">{{ t('display','仅展示') }}</span>{% endif %}
    </span>
    {% endif %}{% endfor %}
  </div>
  {% for s in scares %}{% if s.label_en == rd.label_en and s.firing_legs %}
  <div class="rrx-ev"><span class="rrx-ev-k">{{ t('Leading','领先信号') }}</span>{% for l in s.firing_legs[:2] %}{% if not loop.first %} · {% endif %}{{ rr_leg(l.leg) }} <span class="rrx-ev-p">{{ (l.pctile*100)|round|int }}th{% if l.confirmed %} ✓{% endif %}</span>{% endfor %}</div>
  {% endif %}{% endfor %}
  {% endif %}

  {% if rd.is_loud and rd.do_en %}
  <div class="rrx-do"><span class="rrx-do-k">{{ t('Do','应对') }}</span>{{ t(rd.do_en, rd.do_zh) }}</div>
  {% endif %}

  {# Election-cycle context (US radar only; engine/election_cycle.py) — a calendar MODULATOR,
     never an alert originator. Surfaces the midterm window + the HONEST measured odds (the
     full stat/slice/caveat live in the tooltip so the chip can't overclaim). #}
  {% if rd.cycle and rd.cycle.show %}{% set cy = rd.cycle %}
  <div class="rrx-cyc">
    <span class="rrx-cyc-k">{{ t(cy.label_en, cy.label_zh) }}{% if cy.in_drawdown_window %} · {{ t('Apr–Oct window','4–10月窗口') }}{% endif %}</span>{{ help(cy.stat_en ~ ' ' ~ cy.slice_en ~ ' ' ~ cy.caveat_en, cy.stat_zh ~ ' ' ~ cy.slice_zh ~ ' ' ~ cy.caveat_zh) }}
    {% if cy.modulation and cy.modulation.risk_on_slice %}<span class="rrx-cyc-tag">▲ {{ t('early-warning sensitivity raised','已提高预警灵敏度') }}</span>{% elif cy.modulation and cy.modulation.gross_applied %}<span class="rrx-cyc-tag">{{ t('sizing trimmed','已小幅降仓') }}</span>{% endif %}
    {% if cy.trough_window_en %}<div class="rrx-cyc-sub">{{ t(cy.trough_window_en, cy.trough_window_zh) }}</div>{% endif %}
    {% if cy.sector_bias %}{% set sb = cy.sector_bias %}
    <div class="rrx-cyc-sec">{{ t('Favor','偏好') }} {% for f in sb.favor %}{% if not loop.first %} · {% endif %}{{ f.ticker }}{% endfor %} · {{ t('trim','减持') }} {% for a in sb.avoid %}{% if not loop.first %} · {% endif %}{{ a.ticker }}{% endfor %}</div>
    {% endif %}
  </div>
  {% endif %}

  {# self-audit line — only on the international radars (rd.forward_log set by
     engine/risk_radar_intl_audit). Every call is logged + graded vs the realized index path;
     the radar earns the right to move the verdict only once its own record clears the bar. #}
  {% if rd.forward_log %}{% set fl = rd.forward_log %}
  <div class="rrx-audit"><span class="rrx-audit-k">🧾 {{ t('Self-audit','自审') }}</span>{% if fl.n_graded and fl.n_graded > 0 %}{{ fl.n_graded }} {{ t('graded','已评分') }}{% if fl.force_lift is not none %} · <b>{{ fl.force_lift }}×</b> {{ t('vs base rate','对比基准') }}{% endif %} · {% if fl.can_force %}{{ t('moving the verdict','参与定调') }} ✓{% else %}{{ t('display-only','仅展示') }}{% endif %}{% else %}{{ t('accruing — grades begin once calls mature (~21 trading days)','积累中 — 约21个交易日后开始评分') }}{% endif %}</div>
  {% endif %}
  </div>{# /.rrx-side #}
</div>
{%- endmacro %}
