{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- One title, not three. <title>, og:, twitter: and the canonical all read the same
    pair, which now lives in engine/market_heatmap.PAGE_META so the three markets can
    never drift apart (W2 spec §A8). #}
{% set seo_title = mk.seo_title %}{% set seo_desc = mk.seo_desc %}{% set seo_path = mk.key ~ "_heatmap.html" %}
<title>{{ seo_title }}</title>
{% include "_seo_head.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 'Inter',-apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:24px 0 28px; }
  a { text-decoration:none; }
  .wrap { padding:16px; }
  @media (min-width:1100px){ .wrap{ padding:18px max(28px,calc((100vw - 1680px)/2)); } }
  .hm-head { display:flex; flex-wrap:wrap; align-items:flex-end; gap:8px 22px; margin:10px 2px 16px; }
  .hm-head h1 { font-size:23px; margin:0; font-weight:800; letter-spacing:-.015em; }
  .hm-head .sub { color:var(--muted); font-size:12.5px; margin-top:5px; max-width:74ch; line-height:1.5; }
  .hm-foot { color:var(--muted); font-size:11px; margin:14px 2px 0; line-height:1.6; }
  /* Live-feed badge: populated by live.js when LIVE_FEED_LABEL is set.
     Hidden (no layout footprint) when the span is empty (no live feed). */
  .hm-live-badge { display:inline-flex; align-items:center; gap:5px;
    font-size:11px; color:var(--muted); font-weight:600;
    background:color-mix(in srgb,#d97706 14%,transparent);
    border:1px solid color-mix(in srgb,#d97706 35%,transparent);
    color:var(--ink-warn, var(--warn)); border-radius:7px; padding:3px 9px; margin-top:6px;
    white-space:nowrap; align-self:flex-end; }
  .hm-live-badge:empty { display:none; }
  /* Hidden live-chg spans that live.js writes to (observer then recolors the tile) */
  .hm-live-chg { display:none !important; }

  /* ── the server-rendered summary layer (W2 spec §A2.3) ────────────────────
     Deliberately class-compatible with heatmap.js's own dashboard chrome: the
     renderer injects the .hx-* stylesheet at boot, so the SSR blocks and the
     live blocks are the same pixels rather than a second, drifting copy. Only
     the two rules below are SSR-specific. heatmap.js removes #hm-ssr the moment
     the live map draws — and LEAVES it standing when the fetch fails, so a
     visitor who never gets the tile map still keeps the breadth read. */
  #hm-ssr { margin-bottom:2px; }
  #hm-ssr .hx-boards { margin-top:14px; }

  /* ── gate elements ────────────────────────────────────────────────────────
     Transliterated from templates/special_situations.html.j2 (the shipped
     reference) into THIS page's token vocabulary. That page defines --card /
     --grid / --ink / --faint / --blue locally; this one has no local token
     block at all and inherits theme.css, where the same roles are --panel /
     --line / --text / --muted / --link. Pasting the reference verbatim would
     resolve every colour to nothing — a note that renders transparent and
     still "works", which is exactly the failure a review misses.

     #8b5cf6 (the lock violet) stays a hard-coded hex, identical to the
     reference mockup. The CTA gradient is brand blue → violet and never signal
     amber (terminal-paywall lesson). The gate elements carry NO directional
     colour: under html[data-lang="zh"] theme.css swaps --up/--down, and a wall
     tinted by state would invert its meaning with the language. */
  .gate-note { display:flex; align-items:flex-start; gap:8px; margin:20px 0 4px;
    padding:11px 14px; border-radius:12px; font-size:12.5px; line-height:1.5; color:var(--muted);
    background:color-mix(in srgb,#8b5cf6 7%,transparent);
    border:1px solid color-mix(in srgb,#8b5cf6 22%,transparent); }
  .gate-note svg { width:14px; height:14px; flex:none; margin-top:2px; color:#8b5cf6; }
  .gate-note a { color:var(--ink-link, var(--link)); border-bottom:1px solid color-mix(in srgb,var(--link) 40%,transparent); }
  .cta-row { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:16px;
    padding:14px 16px; border-radius:14px; background:var(--panel); border:1px solid var(--line); }
  .cta-txt { flex:1; min-width:220px; font-size:12.5px; color:var(--muted); line-height:1.5; }
  .cta-txt b { color:var(--text); font-weight:700; }
  .tw-btn { display:inline-flex; align-items:center; justify-content:center; padding:10px 22px;
    border-radius:12px; font-size:13px; font-weight:700; color:#fff;
    background:linear-gradient(135deg,var(--link),#8b5cf6);
    box-shadow:0 8px 22px -10px color-mix(in srgb,#8b5cf6 70%,transparent); }
  .tw-note { font-size:11px; color:var(--muted); }
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="wrap">
  <div class="hm-head">
    <div>
      <h1>{{ mk.icon }} {{ t(mk.h1_en, mk.h1_zh) }}</h1>
      <div class="sub">{{ t('Winners and losers at a glance — every name a tile, shaded by the move you pick.', '涨跌一目了然 —— 每只个股一个方块，按所选周期着色。') }}<span class="hx-help" tabindex="0" aria-label="How to read this">?<span class="hx-tip">{{ t(mk.sub_en, mk.sub_zh) }}</span></span></div>
    </div>
    {# live.js populates [data-live-label] with the honest feed caption
       (e.g. "≈15-min delayed (Polygon Standard / Yahoo)") when a live feed
       is configured. Hidden via :empty CSS when no feed is wired. #}
    <span class="hm-live-badge" data-live-label></span>
  </div>

{%- if summary %}
  {#- ── SSR summary layer — the crawlable floor ────────────────────────────────
      Same numbers, same copy, same classes as the live dashboard chrome, computed
      in Python by engine.market_heatmap.page_summary() from the same tile JSON the
      treemap draws. Nothing graded reaches here: breadth, medians, sector
      aggregates and biggest movers are arithmetic over public closes. The treemap
      itself stays client-rendered — 1,500 SSR tiles would add ~180 KB of markup a
      crawler cannot read as prose anyway, and the four blocks below carry the
      entity-bearing nouns (sector names, ticker codes, company names) at 3% of
      the cost. #}
  <div id="hm-ssr">
    <div class="hx-pulse {{ summary.stance.tone }}">
      <div class="hx-pulse-top">
        <span class="hx-stance"><span class="ic"></span>{{ t(summary.stance.en, summary.stance.zh) }}</span>
        <span class="hx-pulse-lab">{{ t('Market pulse', '市场脉搏') }}</span>
        <span class="hx-pulse-when">{{ summary.asof }}</span>
      </div>
      {#- The page's plain-word stance for an anonymous reader (Doctrine Law 1),
          derived from board breadth alone — zero graded inputs. EN owns a full
          sentence because "money flowing to weakness in X" is backwards; ZH hangs
          走强/走弱 off the sector names under one 资金流向： prefix. #}
      {%- macro secs_en(rows) %}{% for s in rows %}<b>{{ s.en }}</b>{% if not loop.last %}, {% endif %}{% endfor %}{% endmacro -%}
      {%- macro secs_zh(rows) %}{% for s in rows %}<b>{{ s.zh }}</b>{% if not loop.last %}、{% endif %}{% endfor %}{% endmacro -%}
      <div class="hx-pulse-read">
        <span class="l-en"><b>{{ summary.pct_up }}%</b> of names advancing · median <b>{{ summary.median }}</b>.{% if summary.up_sectors %} Strength in {{ secs_en(summary.up_sectors) }}{% if summary.down_sectors %} — weakness in {{ secs_en(summary.down_sectors) }}{% endif %}.{% elif summary.down_sectors %} Weakness in {{ secs_en(summary.down_sectors) }}.{% endif %}</span>
        <span class="l-zh"><b>{{ summary.pct_up }}%</b> 个股上涨 · 中位数 <b>{{ summary.median }}</b>。{% if summary.up_sectors or summary.down_sectors %}资金流向：{% if summary.up_sectors %}{{ secs_zh(summary.up_sectors) }} 走强{% endif %}{% if summary.up_sectors and summary.down_sectors %}，{% endif %}{% if summary.down_sectors %}{{ secs_zh(summary.down_sectors) }} 走弱{% endif %}。{% endif %}</span>
      </div>
    </div>

    <div class="hx-stats">
      <div class="hx-stat hx-stat-br">
        <div class="k">{{ t('Breadth · advancing vs declining', '市场广度 · 涨跌家数') }}</div>
        <div class="v">{{ summary.pct_up }}% <span class="u">{{ t('advancing', '上涨') }}</span></div>
        <div class="hx-bbar"><i class="adv" style="width:{{ summary.breadth.adv_w }}%"></i><i class="flt" style="width:{{ summary.breadth.flat_w }}%"></i><i class="dec" style="width:{{ summary.breadth.dec_w }}%"></i></div>
        <div class="hx-bleg"><span class="hx-up">▲ {{ summary.breadth.adv }}</span><span class="hx-dn">{{ summary.breadth.dec }} ▼</span></div>
        {%- if summary.breadth.scope %}
        <div class="hx-bscope">{{ t(summary.breadth.scope.en, summary.breadth.scope.zh) }}</div>
        {%- endif %}
      </div>
      <div class="hx-stat">
        <div class="k">{{ t('Median move', '涨跌中位数') }}</div>
        <div class="v {{ summary.median_tone }}">{{ summary.median }}</div>
        {%- if summary.median_word %}
        <div class="m">{{ t(summary.median_word.en, summary.median_word.zh) }}</div>
        {%- endif %}
      </div>
      {%- if summary.top %}
      <div class="hx-stat">
        <div class="k">{{ t('Strongest sector', '最强板块') }}</div>
        <div class="v {{ summary.top.tone }}">{{ summary.top.pc }}</div>
        <div class="m">{{ t(summary.top.en, summary.top.zh) }}</div>
      </div>
      {%- endif %}
      {%- if summary.bot %}
      <div class="hx-stat">
        <div class="k">{{ t('Weakest sector', '最弱板块') }}</div>
        <div class="v {{ summary.bot.tone }}">{{ summary.bot.pc }}</div>
        <div class="m">{{ t(summary.bot.en, summary.bot.zh) }}</div>
      </div>
      {%- endif %}
    </div>

    <div class="hx-boards">
      <div class="hx-board"><h3><span class="tag up">▲</span>{{ t('Biggest gainers', '涨幅榜') }}</h3>
        {%- for r in summary.gainers %}
        <div class="hx-row"><span class="tk">{{ r.code }}</span><span class="nm">{{ t(r.name_en, r.name_zh) }}</span><span class="pc hx-up">{{ r.pc }}</span><span class="bar"><i style="width:{{ r.w }}%;background:var(--up)"></i></span></div>
        {%- endfor %}
      </div>
      <div class="hx-board"><h3><span class="tag dn">▼</span>{{ t('Biggest losers', '跌幅榜') }}</h3>
        {%- for r in summary.losers %}
        <div class="hx-row"><span class="tk">{{ r.code }}</span><span class="nm">{{ t(r.name_en, r.name_zh) }}</span><span class="pc hx-dn">{{ r.pc }}</span><span class="bar"><i style="width:{{ r.w }}%;background:var(--down)"></i></span></div>
        {%- endfor %}
      </div>
      <div class="hx-board hx-board-sec"><h3>{{ t('Sector leaders &amp; laggards', '板块强弱') }}</h3>
        {%- for s in summary.sectors %}
        <div class="hx-sec"><span class="nm">{{ t(s.en, s.zh) }}</span><span class="track"><i style="width:{{ s.w }}%;background:var({{ '--up' if s.up else '--down' }})"></i></span><span class="pc {{ 'hx-up' if s.up else 'hx-dn' }}">{{ s.pc }}</span></div>
        {%- endfor %}
      </div>
    </div>
  </div>
{%- endif %}

  {#- data-hm-gated tells heatmap.js which of the hover card's TWO empty states to
      render when the per-name read is absent. They are different sentences and the
      difference is honesty: "no nightly read for this name yet" is true on an
      entitled build with a genuinely missing file, and a lie on a walled one where
      the read exists and is paid. The gate state is never inferred from the fetch
      result — a network error would then read as a paywall. #}
  <div id="heatmap-full"{% if gated %} data-hm-gated="1"{% endif %} data-hm-maps='[{"key":"{{ mk.key }}","icon":"{{ mk.icon }}","label_en":"{{ mk.label_en }}","label_zh":"{{ mk.label_zh }}","url":"{{ mk.json }}"}]'></div>

{%- if gated %}
  {#- The ONE gate note on this page. A heatmap of market performance is almost
      entirely market context — returns, breadth, sector strength, market-cap
      sizing — so the map opens in full and the single walled thing is our graded
      read on a single name. Five walls over free content would be nagging; a
      .tier-wall over a treemap that is free would be a lie. #}
  <div class="gate-note" id="hm-gate-note">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <span>{{ t('The whole map is open — every tile, every timeframe, every sector. What members add is our read on each name: where it sits and what we&#39;d do about it.',
              '整张热力图完全开放 —— 每个方块、每个周期、每个板块。会员另可看到我们对每只个股的解读：所处位置与应对方式。') }}</span>
  </div>

  <div class="cta-row" id="hm-cta">
    <span class="cta-txt">
      {#- Grouped, not raw: this is the one four-digit number in the page's only
          sentence of sell copy, and the whole page sets tabular grouped counts
          everywhere else. Templated from the live tile count — never hardcode a
          total, membership changes nightly and a stale honest total is a
          dishonest one. #}
      {%- set n_txt = "{:,}".format(n_tiles) %}
      <span class="l-en"><b>The map is free, and stays free.</b> Members get our nightly read on all {{ n_txt }} names here{% if siblings %} — plus the same maps for {{ siblings.en }}{% endif %}.</span>
      <span class="l-zh"><b>热力图免费，且将持续免费。</b>会员可获取我们对全部 {{ n_txt }} 只个股的每晚解读{% if siblings %} —— 以及{{ siblings.zh }}的同款热力图{% endif %}。</span>
    </span>
    <a class="tw-btn" href="plans.html">{{ t('See plans', '查看方案') }}</a>
    <span class="tw-note">{{ t('7-day Pro trial · cancel anytime', 'Pro 7 天试用 · 随时取消') }}</span>
  </div>
{%- endif %}

  <div class="hm-foot">
    {{ t('Green = up, red = down (inverted in 中文). Our market read is research context — never a buy signal.', '绿涨红跌（中文按亚洲习惯反转）。市场研判仅供研究参考，绝非买入信号。') }}<span class="hx-help" tabindex="0" aria-label="Details">?<span class="hx-tip">{{ t(mk.foot_en, mk.foot_zh) }}</span></span>
  </div>
</div>

<footer class="site-footer">
  <span class="made">© 2026 Mastermind Inc</span>
</footer>

<script src="theme.js"></script>
<script src="heatmap.js"></script>
</body>
</html>
