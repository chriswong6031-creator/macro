  {% if chart_credit_breadth %}<div class="chart">{{ chart_credit_breadth | safe }}</div>{% endif %}
</div>

{# =====================================================================
   §4  MOOD & POSITIONING
   ===================================================================== #}
{% if fear_greed %}
{% set FG = fear_greed %}
{% set _fgbandzh = {'Extreme Fear':'极度恐惧','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Extreme Greed':'极度贪婪'} %}
<div class="panel span6 rail-mood anim-d4" id="mood">
  <h2>{{ t('Mood — Fear / Greed', '情绪 — 恐惧/贪婪') }}
    {{ help('Wide multi-indicator composite combining market momentum, volatility, breadth, safe-haven flows, junk demand and several sentiment surveys. 0=Extreme Fear, 100=Extreme Greed.', '宽幅多指标合成，结合市场动量、波动率、广度、避险流、垃圾需求与多项情绪调查。0=极度恐惧，100=极度贪婪。') }}
  </h2>

  {# Fear/Greed dial inline #}
  <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:10px">
    <div>
      <div style="font-size:32px;font-weight:800;font-family:var(--num)">{{ FG.dial }}</div>
      <div class="muted sm">/ 100</div>
    </div>
    <div>
      <span class="badge" style="font-size:13px;padding:3px 10px">{{ t(FG.label_en, _fgbandzh.get(FG.label_en, FG.label_en)) }}</span>
      <div class="muted sm" style="margin-top:4px">{{ FG.n_legs_qualifying }} {{ t('legs driving it','项指标合成') }}</div>
    </div>
    <div style="flex:1;min-width:100px">
      <div class="pgauge"><i style="left:{{ FG.dial }}%"></i></div>
      <div class="pends"><span>{{ t('Fear','恐惧') }}</span><span>{{ t('Greed','贪婪') }}</span></div>
    </div>
  </div>

  {# Top 3 drivers by |z| as bars #}
  {% if FG.legs_included %}
  <div style="font-size:12px;color:var(--muted);margin-bottom:4px">{{ t("What's driving it most","主要驱动因素") }}</div>
  {% set _sorted_legs = FG.legs_included|sort(attribute='z',reverse=true) %}
  {% for leg in _sorted_legs[:3] %}
  <div class="leg">
    <span style="flex:0 0 130px;font-size:12.5px">{{ t(leg.name_en, leg.name_zh) }}</span>
    <div class="leg-bar"><i style="width:{{ ([leg.z|abs / 3 * 100, 100]|min) if leg.z is not none else 0 }}%;background:{{ 'var(--down)' if (leg.z is not none and leg.z < 0) else 'var(--up)' }}"></i></div>
    <span class="muted sm" style="flex:0 0 60px;text-align:right">{{ ('%+.1f'|format(leg.z)) if leg.z is not none else '—' }}</span>
  </div>
  {% endfor %}
  {% endif %}

  {# Full breakdown in details.deep #}
  <details class="deep">
    <summary>{{ t('Full breakdown ▸', '完整拆解 ▸') }}</summary>
    <div class="deep-body">
      {% if FG.legs_included %}
      <table style="margin-bottom:10px">
        <thead><tr>
          <th class="l">{{ t('Leg','指标') }}</th>
          <th>{{ t('Value','数值') }}</th>
          <th>{{ t('State','状态') }}</th>
          <th>{{ t('Obs','观测数') }}</th>
        </tr></thead>
        <tbody>
        {% for leg in FG.legs_included %}
        <tr>
          <td class="l"><b>{{ t(leg.name_en, leg.name_zh) }}</b></td>
          <td>{{ '%.2f'|format(leg.value) if leg.value is not none else '—' }} <span class="muted sm">{{ leg.unit }}</span></td>
          <td class="{{ 'pos' if (leg.z is not none and leg.z > 0.5) else ('neg' if (leg.z is not none and leg.z < -0.5) else '') }} sm">{{ ('%+.2f'|format(leg.z)) if leg.z is not none else '—' }}</td>
          <td class="sm muted">{{ leg.obs_count }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
      {% if FG.legs_excluded_young %}
      <div class="muted sm" style="margin-bottom:6px">{{ t('Excluded (below history gate):','已排除（未达历史门槛）:') }}</div>
      {% for leg in FG.legs_excluded_young %}
      <span class="chip">{{ t(leg.name_en, leg.name_zh) }}</span>
      {% endfor %}
      {% endif %}
      {% if FG.young_tiles %}
      <div class="muted sm" style="margin:8px 0 4px">{{ t('Context tiles (short history):','背景小块（历史较短）:') }}</div>
      {% for yt in FG.young_tiles %}
      <span class="chip">{{ t(yt.name_en, yt.name_zh) }}: {{ yt.value if yt.value is not none else '—' }}</span>
      {% endfor %}
      {% endif %}
    </div>
  </details>

  {# Fear ↔ Euphoria secondary row #}
  {% if fear_euphoria %}{% set FE = fear_euphoria %}
  {% set _febandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'} %}
  <div class="sub" style="margin-top:12px">
    <div class="muted sm" style="margin-bottom:4px">{{ t('Fear ↔ Euphoria (RORO read)','恐惧↔欣喜（RORO侧读）') }}
      {{ help('Two composites exist deliberately. Fear/Greed is the wide aggregate. Fear↔Euphoria is the RORO-side read (risk-on/risk-off positioning). They often agree; when they diverge, the divergence itself is the signal.', '两个合成指标并存有意为之。恐惧/贪婪是宽幅综合。恐惧↔欣喜是RORO侧读（风险开/关持仓）。通常一致；背离时背离本身即是信号。') }}
    </div>
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
      <span style="font-size:18px;font-weight:700;font-family:var(--num)">{{ FE.fe_score }}</span>
      <span class="badge">{{ t(FE.band, _febandzh.get(FE.band, FE.band)) }}</span>
      {% if FE.positioning %}{% set P = FE.positioning %}
      <span class="chip {{ 'chip-pos' if P.chip == 'confirms' else ('chip-neg' if P.chip == 'diverges' else '') }}">
        {% if P.chip == 'confirms' %}{{ t('confirms','一致') }}{% elif P.chip == 'diverges' %}{{ t('diverges','背离') }}{% else %}{{ t('mixed','混杂') }}{% endif %}
      </span>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% if FG.disclaimer_en %}<p class="muted sm" style="margin:10px 0 0">{{ t(FG.disclaimer_en, FG.disclaimer_zh) }}</p>{% endif %}
</div>
{% endif %}{# /fear_greed #}

{# Positioning / crowd meter #}
{% if positioning %}
<div class="panel span6 rail-mood anim-d4" id="positioning">
  <h2>{{ t("Who's positioned how", '谁如何持仓') }}</h2>
  <table>
    <thead><tr><th class="l">{{ t('Who / what','谁 / 什么') }}</th><th class="l">{{ t('Where they stand','当前位置') }}</th></tr></thead>
    <tbody>
    {% for p in positioning %}
    <tr>
      <td class="l">{{ p.name }}</td>
      <td class="l">
        {% if p.pct is not none %}
        <div class="pgauge" style="width:100px;display:inline-block;vertical-align:middle"><i style="left:{{ p.pct|round(1) }}%"></i></div>
        {% endif %}
        <span class="sm">{{ p.label }}</span>
        {% if p.verdict %} <span class="muted sm">— {{ p.verdict }}</span>{% endif %}
        {{ help(p.name ~ ': ' ~ p.label, p.name ~ ': ' ~ p.label) if p.source else '' }}
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# VIX monitor #}
{% if vix %}
<div class="panel span6 rail-mood anim-d4" id="vix-monitor">
  <h2>{{ t('VIX — volatility level', 'VIX — 波动率水平') }}</h2>
  <div class="sub" style="margin-bottom:8px">
    <span style="font-size:24px;font-weight:700;font-family:var(--num)">{{ '%.2f'|format(vix.last) }}</span>
    <span class="{{ 'pos' if vix.chg < 0 else ('neg' if vix.chg > 0 else 'muted') }}" style="margin-left:6px">{{ '%+.2f'|format(vix.chg) }} ({{ '%+.1f'|format(vix.pct) }}%)</span>
    <span class="badge" style="margin-left:8px">{{ td(vix.regime) }}</span>
    {% if vix.ratio is not none %}
    <div class="muted sm" style="margin-top:4px">{{ t('Term structure:','期限结构:') }} <b>{{ '%.2f'|format(vix.ratio) }}</b> — {{ td(vix.rword) if vix.rword else '' }}</div>
    {% endif %}
  </div>
  {# SVG legend chips (bilingual, outside SVG) #}
  <div style="font-size:11px;color:var(--muted);margin-bottom:4px">
    <span class="chip">{{ t('Calm <16','平静<16') }}</span>
    <span class="chip">{{ t('Normal 16–20','正常16–20') }}</span>
    <span class="chip chip-warn">{{ t('Stressed 20–28','受压20–28') }}</span>
    <span class="chip chip-neg">{{ t('Crisis >28','危机>28') }}</span>
  </div>
  {% if chart_vix %}<div class="chart">{{ chart_vix | safe }}</div>{% endif %}
</div>
{% endif %}

{# =====================================================================
   §4b  COMMODITIES TAPE
   ===================================================================== #}
{% if commodities %}
<div class="panel span6 rail-commod anim-d5" id="commodities">
  <h2>{{ t('Commodities & macro tape', '大宗商品与宏观盘面') }}</h2>
  <table>
    <thead><tr>
      <th class="l">{{ t('Instrument','标的') }}</th>
      <th>{{ t('Trend','趋势') }}</th>
      <th>{{ t('3-mo','3月') }}</th>
      <th>{{ t('Off 52w high','距52周高') }}</th>
    </tr></thead>
    <tbody>
    {% for c in commodities %}
    <tr>
      <td class="l"><b>{{ td(c.name) }}</b></td>
      <td class="sm">
        {% if c.above200 %}{{ t('above trend','趋势上方') }}{% else %}{{ t('below trend','趋势下方') }}{% endif %}
        {{ help('RSI(14): ' ~ (c.rsi14|round|int|string if c.rsi14 is not none else '—') ~ ' · 50d: ' ~ ('above' if c.above50 else 'below'), 'RSI(14): ' ~ (c.rsi14|round|int|string if c.rsi14 is not none else '—') ~ ' · 50日: ' ~ ('上方' if c.above50 else '下方')) }}
      </td>
      <td class="{{ 'pos' if c.mom_60d_pct > 0 else 'neg' }}">{{ '%+.1f'|format(c.mom_60d_pct) }}%</td>
      <td class="{{ 'neg' if c.off_52w_high_pct < -10 else '' }}">{{ '%+.1f'|format(c.off_52w_high_pct) }}%</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# =====================================================================
   §6  CURRENCIES & THE DOLLAR
   ===================================================================== #}
{% if fx_context %}
{% set FX = fx_context %}
{% set _dd = FX.get('dollar_desk') %}
{% set _smile_map = {
  'US growth premium': ['Dollar strong — the US is out-earning the world.', '美元走强 — 美国增长领先全球。'],
  'Risk-off haven bid': ['Dollar strong — investors hiding in it.', '美元走强 — 避险资金涌入。'],
  'Global reflation': ['Dollar soft — growth is broadening beyond the US.', '美元走软 — 增长扩散至美国以外。'],
  'US-specific stress': ['Dollar weak while stress rises — a US-specific worry.', '压力上升而美元走弱 — 美国自身问题。'],
  'Neutral': ['Dollar drifting — no clear regime.', '美元方向不明。']
} %}
{% set _smile_regime = FX.get('smile_regime') %}

<div class="panel span12 rail-fx anim-d5" id="currencies">
  <h2>{{ t('Currencies & the dollar', '货币与美元') }}</h2>

  {# Triple-red banner #}
  {% if _dd and _dd.get('triple_red') %}
  <div class="triple-red-banner">
    <span class="l-en">⚠ Dollar, stocks and bonds are falling together — the dollar is not acting as a safe haven right now.</span>
    <span class="l-zh">⚠ 美元、股票与债券同跌 — 美元当前未起到避险作用。</span>
  </div>
  {% endif %}

  {# Cross-asset FX caution flags (from cross_asset.caution_flags, owner=='fx') #}
  {% if cross_asset and cross_asset.caution_flags %}
  {% set _fx_flags = cross_asset.caution_flags | selectattr('owner', 'equalto', 'fx') | list %}
  {% if _fx_flags %}
  <div style="margin-bottom:10px">
    {% for f in _fx_flags %}
    <div class="chip {{ 'chip-neg' if f.severity == 'high' else 'chip-warn' }}" style="font-size:12px;padding:4px 10px;display:inline-block;margin:2px 4px 2px 0">
      <span class="l-en">{{ f.en }}</span><span class="l-zh">{{ f.zh }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endif %}

  <div class="grid">

    {# Dollar regime card #}
    {% if _dd %}
    <div class="sub span6">
      <h3>{{ t('Dollar regime', '美元周期') }}
        {{ help(
          'Desk legs — real yield z: ' ~ (('%+.2f'|format(_dd.real_rate_z)) if _dd.get('real_rate_z') is not none else '—')
          ~ ' · Fed path: ' ~ ((('%+d'|format(_dd.fed_path_bps|int)) ~ 'bp to 12m') if _dd.get('fed_path_bps') is not none else '—')
          ~ ' · REER gap: ' ~ ((('%+.1f'|format(_dd.usd_reer_gap_pct)) ~ '%') if _dd.get('usd_reer_gap_pct') is not none else '—')
          ~ ' · COT pctile: ' ~ ((_dd.usd_pos_pctile|round|int|string) if _dd.get('usd_pos_pctile') is not none else '—')
          ~ ' · trend legs up: ' ~ ((_dd.trend_n_up|string ~ '/4') if _dd.get('trend_n_up') is not none else '—')
          ~ ' · liquidity: ' ~ (_dd.get('liquidity_dir') or '—')
          ~ ' · smile confirmation: ' ~ (_dd.get('smile_confidence') or '—'),
          '操盘台分项 — 实际利率z: ' ~ (('%+.2f'|format(_dd.real_rate_z)) if _dd.get('real_rate_z') is not none else '—')
          ~ ' · 美联储路径: ' ~ ((('%+d'|format(_dd.fed_path_bps|int)) ~ 'bp/12月') if _dd.get('fed_path_bps') is not none else '—')
          ~ ' · REER缺口: ' ~ ((('%+.1f'|format(_dd.usd_reer_gap_pct)) ~ '%') if _dd.get('usd_reer_gap_pct') is not none else '—')
          ~ ' · COT百分位: ' ~ ((_dd.usd_pos_pctile|round|int|string) if _dd.get('usd_pos_pctile') is not none else '—')
          ~ ' · 趋势上行: ' ~ ((_dd.trend_n_up|string ~ '/4') if _dd.get('trend_n_up') is not none else '—')
          ~ ' · 流动性: ' ~ (_dd.get('liquidity_dir') or '—')
          ~ ' · 微笑确认: ' ~ (_dd.get('smile_confidence') or '—')
        ) }}
      </h3>
      {% if _smile_regime %}
      {% set _smile_words = _smile_map.get(_smile_regime, [_smile_regime, _smile_regime]) %}
      <div style="font-size:14px;font-weight:600;margin-bottom:8px">
        <span class="l-en">{{ _smile_words[0] }}</span>
        <span class="l-zh">{{ _smile_words[1] }}</span>
      </div>
      {% endif %}

      {# Lean row #}
      {% if _dd.get('lean') %}
      <div class="muted sm" style="margin-bottom:6px">
        {{ t('Desk read: ', '操盘台读数：') }}
        <b>{{ td(_dd.lean) }}</b>
        {% if _dd.get('lean_n') is not none %}· {{ t('based on ', '基于') }}{{ _dd.lean_n }}{{ t(' desk reads', '项读数') }}{% endif %}
      </div>
      {% endif %}

      {# Days held chip #}
      {% set _sc = FX.get('state_changes') %}
      {% if _sc and _sc.get('smile_regime') and _sc.smile_regime.get('days_in_state') is not none %}
      <span class="chip">{{ t('held ','已持续') }}{{ _sc.smile_regime.days_in_state }}{{ t(' days','天') }}</span>
      {% endif %}
    </div>
    {% endif %}

    {# Strength meter #}
    {% set _str = FX.get('strength') %}
    {% if _str %}
    {% set _horizon = _str.get('default', '1m') %}
    {% set _pairs = _str.get('horizons', {}).get(_horizon, []) %}
    {% if _pairs %}
    <div class="sub span6">
      <h3>{{ t('Strength vs dollar', '兑美元强弱') }} <span class="muted sm">{{ {'1w':'1-week','1m':'1-month','3m':'3-month'}.get(_horizon, _horizon) }}</span></h3>
      {% for p in _pairs[:8] %}
      {% set _sv = p.get('strength', 0) or 0 %}
      {% set _bar_pct = ([_sv|abs * 50, 50]|min) %}
      <div class="str-bar-row">
        <span class="str-ccy {{ 'str-em' if p.get('em') else '' }}">{{ p.ccy }}</span>
        <div class="str-bar-track">
          {% if _sv >= 0 %}
          <div class="str-bar-fill pos-fill" style="width:{{ _bar_pct }}%"></div>
          {% else %}
          <div class="str-bar-fill neg-fill" style="width:{{ _bar_pct }}%"></div>
          {% endif %}
          <div class="str-bar-center"></div>
        </div>
        <span class="str-val {{ 'pos' if _sv > 0 else ('neg' if _sv < 0 else 'muted') }}">{% if p.ccy == 'USD' %}—{% elif p.get('vs_usd_pct') is not none %}{{ '%+.1f'|format(p.vs_usd_pct) }}%{% else %}—{% endif %}</span>
      </div>
      {% endfor %}
      <div class="muted sm" style="margin-top:6px">{{ t('% move vs the dollar. Trailing move, not a forecast.','兑美元%变动。仅为近端走势，非预测。') }}</div>
    </div>
    {% endif %}
    {% endif %}

    {# Stress radar chips #}
    {% set _rr = FX.get('regime_radar') %}
    {% if _rr %}
    {% set _scenarios = _rr.get('scenarios', []) %}
    {% set _active_scens = [] %}
    {% for s in _scenarios if s is mapping and ((s.get('intensity') or 0) >= 5 or s.get('active')) %}{% set _ = _active_scens.append(s) %}{% endfor %}
    <div class="sub span12">
      <h3>{{ t('Stress patterns', '压力形态') }}</h3>
      {% if _active_scens %}
      {% set _dominant_key = _rr.get('dominant') %}
      {% for sc in _active_scens %}
      {% set _is_dom = _dominant_key and sc.get('key') == _dominant_key %}
      <span class="stress-chip {{ 'active-chip' if sc.get('active') else '' }} {{ 'dominant-chip' if _is_dom else '' }}">
        {% if sc.get('active') %}<span class="pulse-dot"></span>{% endif %}
        <span class="l-en">{{ sc.get('name_en', '') }}</span>
        <span class="l-zh">{{ sc.get('name_zh', '') }}</span>
        <span class="muted sm">{{ (sc.get('intensity') or 0)|round|int }}/100</span>
        {% if _is_dom %}<span class="muted sm">— {{ t('dominant','主导') }}</span>{% endif %}
        {% set _prob = sc.get('prob') %}
        {# receipt numbers only when the empirical read is complete (status ok);
           insufficient/unprecedented histories say so instead of crashing on None #}
        {% if _prob and _prob.get('status') == 'ok' and _prob.get('p_cond') is not none and _prob.get('wilson_lo') is not none and _prob.get('wilson_hi') is not none %}
        {% set _prob_en = ' · At this stress level, ' ~ ((_prob.p_cond * 100)|round|int) ~ '% of past cases saw the adverse move (base rate ' ~ (((_prob.base_rate or 0) * 100)|round|int) ~ '%, 95% CI ' ~ ((_prob.wilson_lo * 100)|round|int) ~ '–' ~ ((_prob.wilson_hi * 100)|round|int) ~ '%, n=' ~ (_prob.get('n_raw') or '—')|string ~ ')' %}
        {% set _prob_zh = ' · 同等压力的历史案例中' ~ ((_prob.p_cond * 100)|round|int) ~ '%出现不利走势（基率' ~ (((_prob.base_rate or 0) * 100)|round|int) ~ '%，95%区间' ~ ((_prob.wilson_lo * 100)|round|int) ~ '–' ~ ((_prob.wilson_hi * 100)|round|int) ~ '%，n=' ~ (_prob.get('n_raw') or '—')|string ~ '）' %}
        {% elif _prob %}
        {% set _prob_en = ' · Not enough history at this stress level for a reliable read' %}
        {% set _prob_zh = ' · 此压力水平历史样本不足，无可靠读数' %}
        {% else %}
        {% set _prob_en = '' %}{% set _prob_zh = '' %}
        {% endif %}
        {{ help(
          'Stress intensity ' ~ ((sc.get('intensity') or 0)|round|int) ~ '/100' ~ _prob_en ~ ('. Managed/intervened regime truncates history — illustrative only.' if sc.get('illustrative') else ''),
          '压力强度 ' ~ ((sc.get('intensity') or 0)|round|int) ~ '/100' ~ _prob_zh ~ ('。受管理/干预体制截断历史 — 仅供示意。' if sc.get('illustrative') else '')
        ) }}
      </span>
      {% endfor %}
      {% else %}
      <div class="muted sm">
        <span class="l-en">No known stress pattern is configured today.</span>
        <span class="l-zh">当前无已知压力形态。</span>
      </div>
      {% endif %}
    </div>
    {% endif %}

    {# CNH row (USDCNH pair) #}
    {% set _pairs_data = FX.get('pairs', {}) %}
    {% if _pairs_data and _pairs_data.get('USDCNH') %}
    {% set _cnh = _pairs_data.USDCNH %}
    {% set _cnh_state = _cnh.get('cnh_basis_state') or 'neutral' %}
    {% set _cnh_map = {
      'neutral': ['Offshore yuan: no unusual pressure', '离岸人民币：无异常压力'],
      'outflow_stress': ['Offshore yuan under outflow pressure', '离岸人民币承受外流压力'],
      'inflow': ['Offshore yuan: inflow bid', '离岸人民币：资金流入']
    } %}
    {# unknown states fall back to the neutral wording — raw enums never render #}
    {% set _cnh_words = _cnh_map.get(_cnh_state, _cnh_map['neutral']) %}
    <div class="sub span6">
      <h3>{{ t('Offshore yuan (CNH)', '离岸人民币 (CNH)') }}</h3>
      <div style="font-size:13.5px;font-weight:600">
        <span class="l-en">{{ _cnh_words[0] }}</span>
        <span class="l-zh">{{ _cnh_words[1] }}</span>
      </div>
      {% if _cnh.get('cnh_basis_bps') is not none %}
      {{ help('CNH basis: ' ~ ('%.0f'|format(_cnh.cnh_basis_bps)) ~ 'bp', 'CNH基差: ' ~ ('%.0f'|format(_cnh.cnh_basis_bps)) ~ 'bp') }}
      {% endif %}
    </div>
    {% endif %}

    {# Transmission chips #}
    {% set _tx = FX.get('transmission') %}
    {% if _tx and (_tx.get('headwind_for') or _tx.get('tailwind_for')) %}
    <div class="sub span6">
      <h3>{{ t('Dollar transmission', '美元传导') }}</h3>
      {% if _tx.get('headwind_for') %}
      <div class="muted sm" style="margin-bottom:4px">{{ t('A stronger dollar is pressing on:','美元走强正压制：') }}</div>
      {% for h in _tx.headwind_for %}
      <span class="chip chip-neg">{{ t(h, h) }}</span>
      {% endfor %}
      {% endif %}
      {% if _tx.get('tailwind_for') %}
      <div class="muted sm" style="margin:6px 0 4px">{{ t('Helping:','助力：') }}</div>
      {% for h in _tx.tailwind_for %}
      <span class="chip chip-pos">{{ t(h, h) }}</span>
      {% endfor %}
      {% endif %}
      {% if _tx.get('corr') %}
      {% set _corr_bits = [] %}
      {% for k, v in _tx.corr.items() %}{% set _ = _corr_bits.append(k ~ ' ' ~ ('%+.2f'|format(v))) %}{% endfor %}
      {{ help('Correlation to the broad dollar: ' ~ _corr_bits|join(' · '), '与广义美元的相关性: ' ~ _corr_bits|join(' · ')) }}
      {% endif %}
    </div>
    {% endif %}

    {# What changed strip #}
    {% set _events = FX.get('recent_events', []) %}
    {% if _events %}
    <div class="sub span12">
      <h3>{{ t('What changed', '近期变化') }}</h3>
      {% for ev in _events %}
      {% set _sev = ev.get('severity', 'low') %}
      <div class="what-changed-row">
        <span class="sev-dot {{ 'sev-high' if _sev == 'high' else ('sev-med' if _sev == 'medium' else 'sev-low') }}"></span>
        <span class="muted sm" style="flex:0 0 84px;white-space:nowrap">{{ ev.get('date','') }}</span>
        <span>
          <span class="l-en">{{ ev.get('headline', '') }}</span>
          <span class="l-zh">{{ ev.get('headline_zh', ev.get('headline', '')) }}</span>
        </span>
      </div>
      {% endfor %}
    </div>
    {% endif %}

  </div>{# /grid inside fx section #}

  <div style="margin-top:12px;font-size:12.5px">
    <a href="forex.html">{{ t('Full currency board → forex.html','完整货币面板 → forex.html') }}</a>
  </div>
</div>
{% endif %}{# /fx_context #}

</div>{# /outer grid #}

<p class="muted" style="font-size:12px;margin:16px 0 4px">
  <a href="macro.html">← {{ t('Back to Macro Dashboard','返回宏观仪表盘') }}</a>
  &nbsp;·&nbsp;
  <a href="macro_context.html">{{ t('Macro Weather (labels & history) →','宏观气象台（标签与历史）→') }}</a>
</p>

</div>{# /msx-wrap #}

{# Animate needles to final positions after DOM ready #}
<script>
(function(){
  // Sweep each needle from rest (−90°) to its server-rendered final angle.
  // Server HTML already carries the final rotation, so no-JS renders correctly;
  // here we rewind without transition, force a reflow, then let CSS animate.
  var reduced = false;
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch(e){}
  function setNeedle(id, rot){
    var el = document.getElementById(id);
    if(!el) return;
    if(reduced){ el.style.transform = 'rotate(' + rot + 'deg)'; return; }
    var t = el.style.transition;
    el.style.transition = 'none';
    el.style.transform = 'rotate(-90deg)';
    void el.getBoundingClientRect();          // commit the rewind
    el.style.transition = t || 'transform .8s cubic-bezier(.22,.9,.3,1)';
    el.style.transform = 'rotate(' + rot + 'deg)';
  }
  function init(){
    {% if latest and latest.growth_score is not none %}
    setNeedle('gneedle-growth', {{ (((latest.growth_score + 1) / 2 * 100) * 1.8 - 90)|round(1) }});
    {% endif %}
    {% if latest and latest.inflation_score is not none %}
    setNeedle('gneedle-inflation', {{ (((latest.inflation_score + 1) / 2 * 100) * 1.8 - 90)|round(1) }});
    {% endif %}
    {% if fear_greed and fear_greed.dial is not none %}
    setNeedle('gneedle-fg', {{ (fear_greed.dial * 1.8 - 90)|round(1) }});
    {% endif %}
    {% if vix and vix.pctile is not none %}
    setNeedle('gneedle-vix', {{ (vix.pctile * 1.8 - 90)|round(1) }});
    {% endif %}
  }
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
<script src="theme.js"></script>
</body>
</html>
