{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro kv(label_en, label_zh, value) -%}
<div class="kv">{{ t(label_en, label_zh) }} <b>{{ value }}</b></div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Macro Signals — the full signal board</title>
{% set seo_title = "Macro Signals Board — Mastermind" %}{% set seo_desc = "The full macro signal board — every indicator, its current reading and its plain-word meaning. Updated nightly." %}{% set seo_path = "macro_signals.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  :root {
    --num: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
  }
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(36px,calc((100vw - 1340px)/2)); } }
  a { text-decoration:none; color:var(--link); }
  h1 { font-size:21px; margin:0 0 2px; }
  .lead { color:var(--muted); font-size:13px; margin:0 0 16px; max-width:72ch; }
  .back { display:inline-block; margin-bottom:10px; font-size:13px; font-weight:600; }
  .sib-link { display:inline-block; margin:0 0 14px 18px; font-size:13px; }

  /* ── Aurora backdrop ─────────────────────────────────────────────────── */
  .msx-aurora { position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
  .msx-aurora::before {
    content:''; position:absolute; top:-6%; left:8%;
    width:42vw; height:42vw; border-radius:50%;
    background:radial-gradient(ellipse, color-mix(in srgb,var(--info) 8%,transparent) 0%, transparent 70%);
    filter:blur(90px);
  }
  .msx-aurora .au-b2 {
    position:absolute; top:4%; right:8%;
    width:38vw; height:38vw; border-radius:50%;
    background:radial-gradient(ellipse, rgba(139,92,246,.08) 0%, transparent 70%);
    filter:blur(90px);
  }
  .msx-aurora .au-b3 {
    position:absolute; bottom:-10%; left:50%;
    transform:translateX(-50%);
    width:48vw; height:36vw; border-radius:50%;
    background:radial-gradient(ellipse, color-mix(in srgb,var(--up) 8%,transparent) 0%, transparent 70%);
    filter:blur(90px);
  }
  /* Yellow tint: green blob → amber */
  .msx-aurora.au-yellow .au-b3 { background:radial-gradient(ellipse, rgba(245,158,11,.08) 0%, transparent 70%); }
  /* Red tint: green blob → red */
  .msx-aurora.au-red .au-b3 { background:radial-gradient(ellipse, color-mix(in srgb,var(--down) 8%,transparent) 0%, transparent 70%); }
  [data-theme="light"] .msx-aurora::before { opacity:.45; }
  [data-theme="light"] .msx-aurora .au-b2 { opacity:.45; }
  [data-theme="light"] .msx-aurora .au-b3 { opacity:.45; }
  .msx-wrap { position:relative; z-index:1; }

  /* ── Grid layout ─────────────────────────────────────────────────────── */
  .grid { display:grid; gap:14px; grid-template-columns:repeat(12,1fr); }
  .span12 { grid-column:span 12; }
  .span6  { grid-column:span 6; }
  .span4  { grid-column:span 4; }
  .span3  { grid-column:span 3; }
  @media (max-width:900px){ .span6,.span4,.span3 { grid-column:span 12; } }

  /* ── Glass panels ────────────────────────────────────────────────────── */
  .panel {
    background: color-mix(in srgb, var(--panel) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    position: relative;
  }
  /* h2 rail: 3px vertical gradient bar via ::before */
  .panel h2 {
    font-size:15px; margin:0 0 12px;
    padding-left:11px; position:relative;
  }
  .panel h2::before {
    content:''; position:absolute; left:0; top:2px; bottom:2px;
    width:3px; border-radius:2px;
    background: linear-gradient(180deg, var(--rail,var(--info)), transparent);
  }

  /* Section rail colors */
  .rail-cycle    { --rail: #5b9bf0; }
  .rail-money    { --rail: #20c0a0; }
  .rail-mood     { --rail: #e0a030; }
  .rail-fx       { --rail: #a070e8; }
  .rail-commod   { --rail: #8b93a1; }

  /* ── Sub-cards ───────────────────────────────────────────────────────── */
  .sub { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:11px 13px; margin-bottom:10px; }
  .sub:last-child { margin-bottom:0; }
  .sub h3 { font-size:13px; margin:0 0 6px; }

  /* ── .sig tiles (conditions grid) ───────────────────────────────────── */
  .sig-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:10px; margin-top:10px; }
  .sig-tile {
    background: var(--panel2); border:1px solid var(--line); border-radius:8px;
    padding:10px 12px; border-left:3px solid var(--sc, var(--muted));
    position:relative;
  }
  .sig-tile .sig-label { font-size:10px; font-family:var(--num); text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-bottom:2px; }
  .sig-tile .sig-value { font-size:17px; font-weight:800; font-family:var(--num); color:var(--sc, var(--text)); }
  .sig-tile .sig-meaning { font-size:12px; color:var(--muted); margin-top:3px; }
  .sig-tile.good  { --sc: var(--up); }
  .sig-tile.warn  { --sc: var(--warn); }
  .sig-tile.bad   { --sc: var(--down); }
  .sig-tile.flat  { --sc: var(--muted); }

  /* ── Needle gauge (SVG semicircle) ──────────────────────────────────── */
  .gauge-wrap { display:flex; flex-direction:column; align-items:center; gap:4px; }
  .gauge-label { font-size:10px; font-family:var(--num); text-transform:uppercase; letter-spacing:.06em; color:var(--muted); text-align:center; }
  .gauge-value { font-size:13px; font-weight:700; text-align:center; font-family:var(--num); text-transform:capitalize; }

  /* ── Hero strip ──────────────────────────────────────────────────────── */
  .hero-inner { display:flex; align-items:flex-start; gap:24px; flex-wrap:wrap; }
  .hero-stance { flex:1 1 200px; min-width:180px; }
  .hero-stance h1 { font-size:19px; }
  .hero-stance-line { font-size:15px; font-weight:600; margin:6px 0 0; color:var(--text); }
  .hero-gauges { display:flex; gap:18px; flex-wrap:wrap; align-items:flex-start; }
  .hero-ms { flex:0 0 auto; display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
  .ms-pill { display:inline-block; font-size:12px; font-weight:700; padding:4px 12px; border-radius:20px; border:2px solid transparent; }
  .ms-green { background:color-mix(in srgb,var(--up) 18%,var(--panel)); color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .ms-yellow { background:color-mix(in srgb,var(--warn) 18%,var(--panel)); color:var(--warn); border-color:color-mix(in srgb,var(--warn) 40%,transparent); }
  .ms-red { background:color-mix(in srgb,var(--down) 18%,var(--panel)); color:var(--down); border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .ms-grey { background:var(--panel2); color:var(--muted); border-color:var(--line); }

  /* ── Misc ────────────────────────────────────────────────────────────── */
  .kv { display:flex; justify-content:space-between; gap:12px; padding:2px 0; font-size:13px; }
  .kv b { font-family:var(--num); font-weight:700; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th,td { text-align:right; padding:5px 7px; border-bottom:1px solid var(--line); }
  th.l,td.l { text-align:left; }
  thead th { color:var(--muted); font-weight:600; font-size:11.5px; text-transform:uppercase; letter-spacing:.04em; }
  .muted { color:var(--muted); }
  .sm { font-size:12px; }
  .pos { color:var(--up); }
  .neg { color:var(--down); }
  .warn { color:var(--warn); }
  .badge { display:inline-block; font-size:11px; padding:1px 7px; border-radius:6px; background:var(--panel2); border:1px solid var(--line); }
  .chip { display:inline-block; font-size:11px; padding:2px 8px; margin:2px 3px 2px 0; border-radius:6px; border:1px solid var(--line); }
  .chip-pos { color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,var(--line)); }
  .chip-neg { color:var(--down); border-color:color-mix(in srgb,var(--down) 40%,var(--line)); }
  .chip-warn { color:var(--warn); border-color:color-mix(in srgb,var(--warn) 40%,var(--line)); }
  .chart { margin-top:8px; }
  .pgauge { position:relative; height:8px; border-radius:5px; background:linear-gradient(90deg,var(--down),var(--warn),var(--up)); margin:6px 0 2px; }
  .pgauge i { position:absolute; top:-2px; width:3px; height:12px; background:var(--text); border-radius:2px; transform:translateX(-50%); }
  .pends { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); }
  .leg { display:flex; align-items:center; gap:8px; margin:4px 0; font-size:12.5px; }
  .leg-bar { flex:1; height:7px; border-radius:4px; background:var(--line); overflow:hidden; }
  .leg-bar i { display:block; height:100%; background:var(--info); }
  .help { position:relative; display:inline-grid; place-items:center; width:15px; height:15px; border:1px solid var(--line); border-radius:50%; font-size:10px; color:var(--muted); cursor:help; vertical-align:middle; }
  .help .tip { visibility:hidden; opacity:0; position:absolute; z-index:20; bottom:130%; left:50%; transform:translateX(-50%); width:300px; background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 11px; font-size:11.5px; line-height:1.5; color:var(--text); box-shadow:0 8px 24px -10px rgba(0,0,0,.5); text-align:left; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  .help:hover::before { content:''; position:absolute; bottom:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { visibility:visible; opacity:1; }
  @media (max-width:700px){ .help .tip { left:auto; right:0; transform:none; max-width:calc(100vw - 28px); } }

  /* ── Details/deep collapsible ────────────────────────────────────────── */
  details.deep { margin-top:10px; }
  details.deep summary {
    cursor:pointer; font-size:12px; color:var(--muted); padding:6px 0;
    list-style:none; user-select:none;
  }
  details.deep summary::-webkit-details-marker { display:none; }
  details.deep summary::after { content:' ▸'; }
  details.deep[open] summary::after { content:' ▾'; }
  details.deep .deep-body { padding-top:8px; }

  /* ── Tier momentum arrows ────────────────────────────────────────────── */
  .tier-row { display:flex; align-items:center; gap:10px; padding:5px 0; border-bottom:1px solid var(--line); }
  .tier-row:last-child { border-bottom:none; }
  .tier-arrow { font-size:16px; line-height:1; }
  .tier-bar-wrap { flex:1; height:5px; border-radius:3px; background:var(--line); overflow:hidden; }
  .tier-bar-fill { height:100%; border-radius:3px; background:var(--info); }

  /* ── FX specific ─────────────────────────────────────────────────────── */
  .str-bar-row { display:flex; align-items:center; gap:8px; padding:3px 0; font-size:12.5px; }
  .str-bar-track { flex:1; height:7px; border-radius:4px; background:var(--line); overflow:hidden; position:relative; }
  .str-bar-fill { position:absolute; top:0; height:100%; border-radius:4px; background:var(--info); }
  .str-bar-fill.neg-fill { background:var(--down); right:50%; }
  .str-bar-fill.pos-fill { background:var(--up); left:50%; }
  .str-bar-center { position:absolute; left:50%; top:-1px; width:1px; height:9px; background:var(--line); }
  .str-ccy { flex:0 0 38px; font-family:var(--num); font-size:12px; font-weight:700; }
  .str-val { flex:0 0 46px; text-align:right; font-family:var(--num); font-size:12px; color:var(--muted); }
  .str-em { color:color-mix(in srgb,var(--warn) 80%,var(--text)); }
  .stress-chip {
    display:inline-flex; align-items:center; gap:5px;
    font-size:11.5px; padding:3px 9px; margin:3px 4px 3px 0;
    border-radius:8px; border:1px solid var(--line);
    background:var(--panel2);
  }
  .stress-chip.active-chip { border-color:color-mix(in srgb,var(--down) 50%,var(--line)); color:var(--down); }
  .stress-chip.dominant-chip { font-weight:700; }
  .pulse-dot {
    width:7px; height:7px; border-radius:50%; background:var(--down);
    animation: stress-pulse 2.2s ease-in-out infinite;
  }
  @keyframes stress-pulse { 0%,100%{opacity:1} 50%{opacity:.25} }
  .triple-red-banner {
    background:color-mix(in srgb,var(--down) 12%,var(--panel2));
    border:1px solid color-mix(in srgb,var(--down) 40%,var(--line));
    border-radius:8px; padding:10px 14px;
    color:var(--down); font-weight:600; font-size:13px; margin:10px 0;
  }
  .what-changed-row { display:flex; align-items:center; gap:8px; padding:4px 0; font-size:12.5px; border-bottom:1px solid var(--line); }
  .what-changed-row:last-child { border-bottom:none; }
  .sev-dot { width:7px; height:7px; border-radius:50%; flex:none; }
  .sev-high { background:var(--down); }
  .sev-med  { background:var(--warn); }
  .sev-low  { background:var(--info); }

  /* ── Entrance animation ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .panel { animation: fade-up .32s ease both; }
    .anim-d1 { animation-delay:.04s; }
    .anim-d2 { animation-delay:.08s; }
    .anim-d3 { animation-delay:.12s; }
    .anim-d4 { animation-delay:.16s; }
    .anim-d5 { animation-delay:.20s; }
    .anim-d6 { animation-delay:.24s; }
    @keyframes fade-up {
      from { opacity:0; transform:translateY(8px); }
      to   { opacity:1; transform:translateY(0); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel { animation:none !important; }
    .pulse-dot { animation:none !important; }
  }

  /* ── §5 stress selloff filter (engine/dislocation.py) ──────────────────
     Demoted here from macro.html on 2026-07-30 (see the §5 block comment).
     Verdict colour arrives on --lit, the Fed-put colour on --dlp, and both are
     spent on a static left rail plus a soft corner wash — nothing animates, so
     there is no pseudo-element motion to kill under reduced-motion. */
  .dislo-panel { border-left:3px solid var(--lit);
    background-image:linear-gradient(107deg,
      color-mix(in srgb, var(--lit) 9%, transparent) 0%,
      color-mix(in srgb, var(--lit) 2%, transparent) 34%, transparent 62%); }
  .dislo-panel .dlx-sub { margin:2px 0 0; font-size:12.5px; line-height:1.5;
    color:var(--muted); max-width:82ch; }
  .dislo-panel .dlx-dormant { margin:10px 0 0; font-size:13px; line-height:1.5;
    color:var(--muted); max-width:88ch; }
  .dislo-panel .dlx-dormant b { color:var(--text); }
  .dislo-panel .dlx-stance { margin:11px 0 0; font-size:13px; line-height:1.45;
    max-width:96ch; color:var(--text); }
  .dislo-panel .dlx-stance b { color:var(--lit); font-weight:700; }
  .dislo-panel .dlx-hon { color:var(--muted); }
  .dislo-panel .dlx-warn { margin:7px 0 0; font-size:12px; line-height:1.45;
    color:var(--down); max-width:96ch; }
  /* readout rows: label / value pairs, no nested card chrome. Everything that
     DISAGREES with the verdict stays here, in the open — the margin each stress
     trigger clears, the Fed-put sub-readings, the entry timer, and the
     geopolitical/catalyst cross-checks. Only long-form prose + the measured
     record fold (audit order 2026-07-29: never fold the dissent). */
  .dislo-panel .dlx-rows { margin:10px 0 0; padding-top:7px;
    border-top:var(--rule,1px) solid var(--line); }
  .dislo-panel .dlx-row { display:flex; align-items:baseline; gap:9px;
    padding:4px 0; font-size:12px; line-height:1.4; }
  .dislo-panel .dlx-row + .dlx-row { border-top:1px solid
    color-mix(in srgb, var(--line) 55%, transparent); }
  .dislo-panel .dlx-lbl { flex:none; width:140px; color:var(--muted); font-weight:600; }
  .dislo-panel .dlx-val { flex:1; min-width:0; }
  .dislo-panel .dlx-val b { font-variant-numeric:tabular-nums; }
  .dislo-panel .dlx-chips { display:inline-flex; flex-wrap:wrap; gap:5px;
    vertical-align:middle; }
  .dislo-panel .dlx-cap { color:var(--muted); font-size:11px; }
  /* margin line — every trigger's live reading against its own limit, firing or
     not. Mono numerals so the four readings line up as a scale, not as prose. */
  .dislo-panel .dlx-margins { display:block; margin-top:3px; font-size:11px;
    color:var(--muted); font-variant-numeric:tabular-nums; }
  .dislo-panel .dlx-mg { white-space:nowrap; }
  .dislo-panel .dlx-mg.on { color:var(--lit); font-weight:650; }
  .dislo-panel .dlx-dis { color:var(--warn); font-weight:650; }
  /* series VINTAGE, parenthetical to its reading — Sahm is a monthly reference
     month carried forward, not a same-day print. Regular numerals: a date is a
     figure, the words around it are not, so only the reading itself keeps the
     tabular alignment above. */
  .dislo-panel .dlx-vint { color:var(--ink-3,var(--muted)); white-space:nowrap; }
  .dislo-panel .dlx-more { margin-top:11px; font-size:12px; }
  .dislo-panel .dlx-more > summary { cursor:pointer; color:var(--link);
    font-weight:600; font-size:12px; }
  .dislo-panel .dlx-mbody { margin-top:8px; padding-top:8px;
    border-top:1px solid color-mix(in srgb, var(--line) 55%, transparent); }
  .dislo-panel .dlx-para { margin:0 0 7px; font-size:11.5px; line-height:1.55;
    max-width:96ch; }
  /* policy divergence — amber CONTEXT, never the red of a verdict: the engine
     attaches it explicitly as context that does not change the call, so it must
     not read redder than the gate does. */
  .dislo-panel .dlx-pdiv, .dislo-panel .dlx-pdiv b { color:var(--warn); }
  .dislo-panel .dlx-mrow { display:flex; align-items:baseline; gap:9px;
    font-size:11.5px; line-height:1.55; }
  .dislo-panel .dlx-mk { flex:none; width:140px; font-weight:600; color:var(--muted); }
  .dislo-panel .dlx-mv { flex:1; min-width:0; }
  @media (max-width:700px) {
    .dislo-panel .dlx-row, .dislo-panel .dlx-mrow { flex-direction:column; gap:2px; }
    .dislo-panel .dlx-lbl, .dislo-panel .dlx-mk { width:auto; }
    .dislo-panel .dlx-cap { display:block; margin-top:3px; }
  }
</style>
</head>
<body class="page-macro">

{# ── Aurora backdrop ─────────────────────────────────────────────────────── #}
{% set _aur_color = (market_state.color if market_state and market_state.color else '') %}
<div class="msx-aurora{{ ' au-yellow' if _aur_color == 'yellow' else (' au-red' if _aur_color == 'red' else '') }}" aria-hidden="true">
  <div class="au-b2"></div>
  <div class="au-b3"></div>
</div>

<div class="msx-wrap">
{% include "_site_nav.html.j2" %}

<a class="back" href="macro.html">← {{ t('Back to Macro Dashboard', '返回宏观仪表盘') }}</a>
<a class="sib-link" href="macro_context.html">{{ t('Macro Weather (labels & history) →', '宏观气象台（标签与历史）→') }}</a>

<h1>{{ t('Macro Signals', '宏观信号') }}</h1>
<p class="lead">
  <span class="l-en">Every gauge behind the macro dashboard — the cycle, real-time conditions,
  liquidity, sentiment, positioning and the dollar — each with what it means
  right now. These readings feed the system's context layer; none of them alone
  drives a buy or sell call. Machine-readable copy: <a href="macrodata/macro_signals.json">macro_signals.json</a>.</span>
  <span class="l-zh">宏观仪表盘背后的全部量表 — 周期、实时状况、流动性、情绪、持仓与美元 —
  每一项都附有当下含义。这些读数进入系统的背景层；任何单项都不会直接触发买卖
  决定。机器可读版本见 <a href="macrodata/macro_signals.json">macro_signals.json</a>。</span>
</p>

<div class="grid">

{# =====================================================================
   §1  HERO STRIP
   ===================================================================== #}
{% set _mscolor = (market_state.color if market_state and market_state.color else '') %}
{% set _stances = msig_stances if msig_stances is defined and msig_stances else {} %}
<div class="panel span12 rail-cycle anim-d1" id="hero">
  <div class="hero-inner">

    {# Stance block #}
    <div class="hero-stance">
      <h1>{{ t('Right now', '当下') }}</h1>
      <div class="hero-stance-line">
        {# single source: build_site._MSIG_HERO_STANCES via msig_stances.hero #}
        {% set _hero_st = _stances.get('hero') if _stances else none %}
        {% if _hero_st and _hero_st.get('en') %}
          {{ t(_hero_st.en, _hero_st.get('zh') or _hero_st.en) }}
        {% else %}
          {{ t('A mixed picture — read the boards below.', '情况混杂 — 请看下方各板。') }}
        {% endif %}
      </div>
      {% if latest and latest.date %}
      <div class="muted sm" style="margin-top:8px">{{ t('As of','数据截至') }} {{ latest.date }}</div>
      {% endif %}
    </div>

    {# 4 needle gauges #}
    <div class="hero-gauges">
      {# Gauge 1: Growth score (-1..+1 → 0..100) #}
      {% set _gs = latest.growth_score if latest and latest.growth_score is not none else none %}
      {% set _gs_pct = ((_gs + 1) / 2 * 100) if _gs is not none else 50 %}
      {% set _gs_rot = (_gs_pct * 1.8 - 90) if _gs is not none else -90 %}
      {% set _gs_state = 'good' if (_gs is not none and _gs >= 0) else 'bad' %}
      <div class="gauge-wrap">
        <div class="gauge-label">{{ t('Growth', '增长') }}</div>
        <svg viewBox="0 -4 140 101" width="110" height="80" aria-hidden="true" id="gauge-growth">
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="var(--line)" stroke-width="8" fill="none" stroke-linecap="round"/>
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="url(#grd-g)" stroke-width="8" fill="none" stroke-linecap="round" opacity=".35"/>
          <defs>
            <linearGradient id="grd-g" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--down)"/>
              <stop offset="50%" stop-color="var(--warn)"/>
              <stop offset="100%" stop-color="var(--up)"/>
            </linearGradient>
          </defs>
          <g id="gneedle-growth" style="transform:rotate({{ _gs_rot }}deg);transform-origin:60px 68px;{% if _gs is not none %}transition:transform .8s cubic-bezier(.22,.9,.3,1);{% endif %}">
            <line x1="60" y1="68" x2="60" y2="26"
              stroke="{{ 'var(--up)' if _gs_state == 'good' else 'var(--down)' }}"
              stroke-width="2.5" stroke-linecap="round"
              style="filter:drop-shadow(0 0 4px {{ 'var(--up)' if _gs_state == 'good' else 'var(--down)' }})"/>
            <circle cx="60" cy="68" r="4" fill="{{ 'var(--up)' if _gs_state == 'good' else 'var(--down)' }}"/>
          </g>
        </svg>
        <div class="gauge-value {{ _gs_state }}">
          {% if _gs is not none %}
            {{ t('RISING', '上行') if _gs >= 0 else t('FALLING', '下行') }}
          {% else %}—{% endif %}
          {{ help('Growth dial. Score −1..+1 maps to 0..100 on the arc. Built from market prices (leading) plus economic data confirmation.', '增长刻度盘。分数−1..+1映射为弧上0..100。由市场价格（领先）加经济数据确认构建。') }}
        </div>
      </div>

      {# Gauge 2: Inflation score #}
      {% set _is = latest.inflation_score if latest and latest.inflation_score is not none else none %}
      {% set _is_pct = ((_is + 1) / 2 * 100) if _is is not none else 50 %}
      {% set _is_rot = (_is_pct * 1.8 - 90) if _is is not none else -90 %}
      {% set _is_state = 'warn' if (_is is not none and _is >= 0) else 'good' %}
      <div class="gauge-wrap">
        <div class="gauge-label">{{ t('Inflation', '通胀') }}</div>
        <svg viewBox="0 -4 140 101" width="110" height="80" aria-hidden="true" id="gauge-inflation">
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="var(--line)" stroke-width="8" fill="none" stroke-linecap="round"/>
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="url(#grd-i)" stroke-width="8" fill="none" stroke-linecap="round" opacity=".35"/>
          <defs>
            <linearGradient id="grd-i" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--up)"/>
              <stop offset="50%" stop-color="var(--warn)"/>
              <stop offset="100%" stop-color="var(--down)"/>
            </linearGradient>
          </defs>
          <g id="gneedle-inflation" style="transform:rotate({{ _is_rot }}deg);transform-origin:60px 68px;{% if _is is not none %}transition:transform .8s cubic-bezier(.22,.9,.3,1);{% endif %}">
            <line x1="60" y1="68" x2="60" y2="26"
              stroke="{{ 'var(--warn)' if _is_state == 'warn' else 'var(--up)' }}"
              stroke-width="2.5" stroke-linecap="round"
              style="filter:drop-shadow(0 0 4px {{ 'var(--warn)' if _is_state == 'warn' else 'var(--up)' }})"/>
            <circle cx="60" cy="68" r="4" fill="{{ 'var(--warn)' if _is_state == 'warn' else 'var(--up)' }}"/>
          </g>
        </svg>
        <div class="gauge-value {{ _is_state }}">
          {% if _is is not none %}
            {{ t('RISING', '上行') if _is >= 0 else t('FALLING', '下行') }}
          {% else %}—{% endif %}
          {{ help('Inflation dial. Score −1..+1 maps to 0..100. High inflation (right) is an economic headwind for equities.', '通胀刻度盘。分数−1..+1映射至0..100。高通胀（右侧）对股票为逆风。') }}
        </div>
      </div>

      {# Gauge 3: Fear/Greed (0..100) #}
      {% set _fg = fear_greed %}
      {% set _fg_dial = _fg.dial if _fg and _fg.dial is not none else none %}
      {% set _fg_rot = (_fg_dial * 1.8 - 90) if _fg_dial is not none else -90 %}
      {% set _fgbandzh = {'Extreme Fear':'极度恐惧','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Extreme Greed':'极度贪婪'} %}
      {% set _fg_state = 'bad' if (_fg_dial is not none and _fg_dial >= 75) else ('good' if (_fg_dial is not none and _fg_dial <= 25) else 'flat') %}
      <div class="gauge-wrap">
        <div class="gauge-label">{{ t('Fear / Greed', '恐惧/贪婪') }}</div>
        <svg viewBox="0 -4 140 101" width="110" height="80" aria-hidden="true" id="gauge-fg">
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="var(--line)" stroke-width="8" fill="none" stroke-linecap="round"/>
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="url(#grd-fg)" stroke-width="8" fill="none" stroke-linecap="round" opacity=".35"/>
          <defs>
            <linearGradient id="grd-fg" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--up)"/>
              <stop offset="50%" stop-color="var(--warn)"/>
              <stop offset="100%" stop-color="var(--down)"/>
            </linearGradient>
          </defs>
          <g id="gneedle-fg" style="transform:rotate({{ _fg_rot }}deg);transform-origin:60px 68px;{% if _fg_dial is not none %}transition:transform .8s cubic-bezier(.22,.9,.3,1);{% endif %}">
            <line x1="60" y1="68" x2="60" y2="26"
              stroke="var(--warn)"
              stroke-width="2.5" stroke-linecap="round"
              style="filter:drop-shadow(0 0 4px var(--warn))"/>
            <circle cx="60" cy="68" r="4" fill="var(--warn)"/>
          </g>
        </svg>
        <div class="gauge-value {{ _fg_state }}">
          {% if _fg and _fg.label_en %}
            {{ t(_fg.label_en, _fgbandzh.get(_fg.label_en, _fg.label_en)) }}
          {% else %}—{% endif %}
          {{ help('Fear/Greed composite dial (0=Extreme Fear, 100=Extreme Greed). Wide multi-indicator composite. Technical receipts in the Mood section below.', '恐惧/贪婪合成指针（0=极度恐惧，100=极度贪婪）。宽幅多指标合成。技术细节见下方情绪板块。') }}
        </div>
      </div>

      {# Gauge 4: VIX percentile (0..100) #}
      {% set _vix = vix %}
      {% set _vp = _vix.pctile if _vix and _vix.pctile is not none else none %}
      {% set _vp_rot = (_vp * 1.8 - 90) if _vp is not none else -90 %}
      {% set _vix_state = 'bad' if (_vp is not none and _vp >= 75) else ('warn' if (_vp is not none and _vp >= 50) else 'good') %}
      <div class="gauge-wrap">
        <div class="gauge-label">{{ t('VIX level', 'VIX 水平') }}</div>
        <svg viewBox="0 -4 140 101" width="110" height="80" aria-hidden="true" id="gauge-vix">
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="var(--line)" stroke-width="8" fill="none" stroke-linecap="round"/>
          <path d="M10,68 A50,50 0 0,1 130,68" stroke="url(#grd-vix)" stroke-width="8" fill="none" stroke-linecap="round" opacity=".35"/>
          <defs>
            <linearGradient id="grd-vix" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--up)"/>
              <stop offset="50%" stop-color="var(--warn)"/>
              <stop offset="100%" stop-color="var(--down)"/>
            </linearGradient>
          </defs>
          <g id="gneedle-vix" style="transform:rotate({{ _vp_rot }}deg);transform-origin:60px 68px;{% if _vp is not none %}transition:transform .8s cubic-bezier(.22,.9,.3,1);{% endif %}">
            <line x1="60" y1="68" x2="60" y2="26"
              stroke="{{ 'var(--down)' if _vix_state == 'bad' else ('var(--warn)' if _vix_state == 'warn' else 'var(--up)') }}"
              stroke-width="2.5" stroke-linecap="round"
              style="filter:drop-shadow(0 0 4px {{ 'var(--down)' if _vix_state == 'bad' else ('var(--warn)' if _vix_state == 'warn' else 'var(--up)') }})"/>
            <circle cx="60" cy="68" r="4" fill="{{ 'var(--down)' if _vix_state == 'bad' else ('var(--warn)' if _vix_state == 'warn' else 'var(--up)') }}"/>
          </g>
        </svg>
        <div class="gauge-value {{ _vix_state }}">
          {% if _vix and _vix.regime %}{{ td(_vix.regime) }}{% else %}—{% endif %}
          {{ help('VIX percentile (0=lowest ever, 100=highest ever). Regime bands: calm <16, normal 16-20, stressed 20-28, crisis >28. Technical detail in VIX section below.', 'VIX百分位（0=历史最低，100=历史最高）。区间：平静<16，正常16-20，受压20-28，危机>28。技术细节见下方VIX板块。') }}
        </div>
      </div>
    </div>{# /hero-gauges #}

    {# Market state pill #}
    <div class="hero-ms">
      {% if market_state %}
      {% set _mc = market_state.color if market_state.color else '' %}
      <a href="macro.html" class="ms-pill {{ 'ms-green' if _mc == 'green' else ('ms-yellow' if _mc == 'yellow' else ('ms-red' if _mc == 'red' else 'ms-grey')) }}">
        {{ t('Market state:', '市场状态：') }}
        {{ t('Green', '绿灯') if _mc == 'green' else (t('Yellow', '黄灯') if _mc == 'yellow' else (t('Red', '红灯') if _mc == 'red' else t('—', '—'))) }}
      </a>
      {% endif %}
    </div>

  </div>{# /hero-inner #}
</div>

{# =====================================================================
   §2  GROWTH & THE CYCLE
   ===================================================================== #}
{% if latest and latest.business_cycle and latest.business_cycle.available %}
{% set BC = latest.business_cycle %}{% set SIG = BC.recession_signal %}{% set M = BC.measured %}
<div class="panel span12 rail-cycle anim-d2" id="business-cycle">
  <h2>{{ t('Growth & the cycle', '增长与周期') }}</h2>
  <div class="grid">

    {# Sub-card A: Business cycle phase #}
    <div class="sub span6">
      {# phase dict carries label/label_zh only (no key) — match on lowercased label #}
      {% set _ph_key = (BC.phase.key if BC.phase and BC.phase.get('key') else (BC.phase.label|lower if BC.phase and BC.phase.label else '')) %}
      <div style="font-size:22px;font-weight:800;margin-bottom:6px;text-transform:capitalize">{% if BC.phase and BC.phase.label %}{{ t(BC.phase.label, BC.phase.get('label_zh') or BC.phase.label) }}{% endif %}</div>
      <div style="font-size:14px;color:var(--text);margin-bottom:10px">
        {% if _ph_key == 'expansion' %}
          {{ t('The economy is growing — the cycle backdrop is a tailwind.', '经济扩张 — 周期背景为顺风。') }}
        {% elif _ph_key == 'slowdown' %}
          {{ t('Growth is cooling — late-cycle; gains get choppier.', '增长降温 — 周期后段，行情更颠簸。') }}
        {% elif _ph_key == 'contraction' %}
          {{ t('The economy is shrinking — defensive backdrop.', '经济收缩 — 防御背景。') }}
        {% elif _ph_key == 'recovery' %}
          {{ t('Growth is turning back up — early-cycle tailwind.', '增长回升 — 周期初段顺风。') }}
        {% endif %}
      </div>

      {# Recession signal chip #}
      {% set _rec_on = SIG and SIG.state == 'on' %}
      <div class="chip {{ 'chip-neg' if _rec_on else 'chip-pos' }}" style="font-size:12.5px">
        {% if _rec_on %}
          {{ t('Recession signal ON', '衰退信号已触发') }}
          {% if SIG.months_active %} — {{ SIG.months_active }}{{ t(' months', '个月') }}{% endif %}
        {% else %}
          {{ t('No recession signal', '无衰退信号') }}
        {% endif %}
      </div>
      {{ help(
        'Recession signal: Conference Board 3 Ds — depth, duration, diffusion. Conditions: depth=' ~ (('✓' if SIG.conditions.depth else '✗') if SIG and SIG.conditions else '—') ~ ' breadth=' ~ (('✓' if SIG.conditions.breadth else '✗') if SIG and SIG.conditions else '—') ~ ('. Shadow phase: ' ~ (td(BC.shadow.phase.label) if BC.shadow and BC.shadow.phase and BC.shadow.phase.label else '—') ~ ' (alternate publication lag)') ~ ('. Out-of-sample (LORO 1985+): ' ~ (M.oos_caught|string ~ '/' ~ M.oos_endogenous|string ~ ' caught, median lead ~' ~ M.oos_median_lead_months|string ~ 'mo, ' ~ M.consensus_false_positives|string ~ ' false alarms') if M and M.oos_caught is not none else ''),
        '衰退信号：会议委员会三D — 深度、持续、扩散。条件：深度=' ~ (('✓' if SIG.conditions.depth else '✗') if SIG and SIG.conditions else '—') ~ ' 广度=' ~ (('✓' if SIG.conditions.breadth else '✗') if SIG and SIG.conditions else '—') ~ ('. 影子相位：' ~ (td(BC.shadow.phase.label) if BC.shadow and BC.shadow.phase and BC.shadow.phase.label else '—')) ~ ('. 样本外（留一衰退1985+）：' ~ (M.oos_caught|string ~ '/' ~ M.oos_endogenous|string ~ ' 已捕捉，中位领先~' ~ M.oos_median_lead_months|string ~ '月，' ~ M.consensus_false_positives|string ~ '次误报') if M and M.oos_caught is not none else '')
      ) }}
    </div>

    {# Sub-card B: Tier momentum #}
    <div class="sub span6">
      <h3>{{ t('Tier momentum', '层级动量') }} <span class="muted sm">{{ t('6-month', '6个月') }}</span></h3>
      {% for tk, ten, tzh in [('leading','Leading','领先'),('coincident','Coincident','同步'),('lagging','Lagging','滞后')] %}
      {% set T = BC.tiers.get(tk) if BC.tiers else none %}
      {% if T is not none %}
      {% set _up = T.mom6 is not none and T.mom6 >= 0 %}
      {% set _bar = ([T.mom6|abs, 1]|min * 100) if T.mom6 is not none else 0 %}
      <div class="tier-row">
        <span class="tier-arrow {{ 'pos' if _up else 'neg' }}">{{ '▲' if _up else '▼' }}</span>
        <span style="flex:0 0 80px;font-size:13px">{{ t(ten, tzh) }}</span>
        <span style="flex:0 0 90px;font-size:12px;color:var(--muted)">{{ t('turning up','转强') if _up else t('turning down','转弱') }}</span>
        <div class="tier-bar-wrap">
          <div class="tier-bar-fill {{ 'pos' if _up else '' }}" style="width:{{ _bar|round(1) }}%;background:{{ 'var(--up)' if _up else 'var(--down)' }}"></div>
        </div>
        {{ help(
          ten ~ ' tier: mom6=' ~ (('%+.2f'|format(T.mom6)) if T.mom6 is not none else '—') ~ (', diffusion=' ~ T.diffusion|round|int|string if T.diffusion is not none else '') ~ (', n=' ~ T.n_legs|string if T.n_legs is not none else ''),
          tzh ~ ' 层：mom6=' ~ (('%+.2f'|format(T.mom6)) if T.mom6 is not none else '—') ~ (', 扩散=' ~ T.diffusion|round|int|string if T.diffusion is not none else '') ~ (', n=' ~ T.n_legs|string if T.n_legs is not none else '')
        ) }}
      </div>
      {% endif %}
      {% endfor %}
    </div>

  </div>{# /grid #}

  {# Conditions grid #}
  {% if latest.conditions %}
  {% set C = latest.conditions %}
  <h3 style="font-size:13px;margin:14px 0 2px">{{ t('Real-time conditions', '实时状况') }}</h3>
  <div class="sig-grid">

    {# Recession risk #}
    {% if C.recession %}{% set RC = C.recession %}
    {% set _rc_state = 'bad' if (RC.score is not none and RC.score >= 60) else ('warn' if (RC.score is not none and RC.score >= 35) else 'good') %}
    <div class="sig-tile {{ _rc_state }}">
      <div class="sig-label">{{ t('Recession risk','衰退风险') }}</div>
      <div class="sig-value">{{ RC.score|round|int if RC.score is not none else '—' }}<small style="font-size:11px">/100</small></div>
      <div class="sig-meaning">{{ t('odds the economy tips over the next year','未来一年经济衰退的可能性') }}</div>
      {{ help(
        'Sahm: ' ~ (('%.2f'|format(RC.sahm)) if RC.sahm is not none else '—') ~ ' · NY Fed prob: ' ~ (('%.0f%%'|format(RC.ny_fed_prob*100)) if RC.ny_fed_prob is not none else '—') ~ ' · Excess bond premium: ' ~ (('%+.2f'|format(RC.ebp)) if RC.ebp is not none else '—'),
        '萨姆规则: ' ~ (('%.2f'|format(RC.sahm)) if RC.sahm is not none else '—') ~ ' · 纽约联储曲线概率: ' ~ (('%.0f%%'|format(RC.ny_fed_prob*100)) if RC.ny_fed_prob is not none else '—') ~ ' · 超额债券溢价: ' ~ (('%+.2f'|format(RC.ebp)) if RC.ebp is not none else '—')
      ) }}
    </div>
    {% endif %}

    {# Drawdown risk #}
    {% if C.drawdown_risk %}{% set DR = C.drawdown_risk %}
    {% set _dr_state = 'bad' if (DR.score is not none and DR.score >= 60) else ('warn' if (DR.score is not none and DR.score >= 35) else 'good') %}
    <div class="sig-tile {{ _dr_state }}">
      <div class="sig-label">{{ t('Drawdown risk','回撤风险') }}</div>
      <div class="sig-value">{{ DR.score|round|int if DR.score is not none else '—' }}<small style="font-size:11px">/100</small></div>
      <div class="sig-meaning">{{ t('odds of a ≥10% index drop in ~3 months vs normal','约3个月内指数回撤≥10%的相对概率') }}</div>
      {{ help(
        'P(dd≥10%/63d): ' ~ ((DR.dd10_prob_pct|string ~ '%') if DR.dd10_prob_pct is not none else '—') ~ ' · Base rate: ' ~ ((DR.base_rate_pct|string ~ '%') if DR.base_rate_pct is not none else '—'),
        '概率(≥10%/63日): ' ~ ((DR.dd10_prob_pct|string ~ '%') if DR.dd10_prob_pct is not none else '—') ~ ' · 基准概率: ' ~ ((DR.base_rate_pct|string ~ '%') if DR.base_rate_pct is not none else '—')
      ) }}
    </div>
    {% endif %}

    {# Financial conditions #}
    {% if C.financial_conditions %}{% set FC = C.financial_conditions %}
    {% set _fc_state = 'bad' if FC.state and 'tight' in FC.state else ('warn' if FC.state and 'neutral' in FC.state else 'good') %}
    <div class="sig-tile {{ _fc_state }}">
      <div class="sig-label">{{ t('Financial conditions','金融条件') }}</div>
      {% set _fc_zh = {'loose':'宽松','neutral':'中性','tight':'收紧'} %}
      <div class="sig-value">{% if FC.state %}{{ t(FC.state, _fc_zh.get(FC.state, FC.state)) }}{% else %}—{% endif %}</div>
      <div class="sig-meaning">{{ t('how easy money is to get','资金松紧程度') }}</div>
      {{ help(
        'NFCI: ' ~ (('%+.2f'|format(FC.nfci)) if FC.nfci is not none else '—') ~ ' · Percentile: ' ~ ((FC.nfci_pctile*100)|round|int|string ~ '%' if FC.nfci_pctile is not none else '—') ~ ' · Trend: ' ~ ((td(FC.trend)) if FC.trend else '—'),
        'NFCI: ' ~ (('%+.2f'|format(FC.nfci)) if FC.nfci is not none else '—') ~ ' · 百分位: ' ~ ((FC.nfci_pctile*100)|round|int|string ~ '%' if FC.nfci_pctile is not none else '—') ~ ' · 趋势: ' ~ ((td(FC.trend)) if FC.trend else '—')
      ) }}
    </div>
    {% endif %}

    {# Systemic stress #}
    {% if C.systemic_stress %}{% set SS = C.systemic_stress %}
    {% set _ss_state = 'bad' if SS.state and 'stress' in SS.state else ('warn' if SS.state and 'elevated' in SS.state else 'good') %}
    <div class="sig-tile {{ _ss_state }}">
      <div class="sig-label">{{ t('System stress','系统压力') }}</div>
      <div class="sig-value">{{ td(SS.state) if SS.state else '—' }}</div>
      <div class="sig-meaning">{{ t('stress inside the financial system (OFR)','金融体系内部压力(OFR)') }}</div>
      {{ help(
        'OFR FSI: ' ~ (('%+.2f'|format(SS.ofr_fsi)) if SS.ofr_fsi is not none else '—') ~ ' · Top channel: ' ~ ((td(SS.leading_driver)) if SS.leading_driver else '—') ~ ' · CP funding: ' ~ ((td(SS.cp_stress)) if SS.cp_stress else '—'),
        'OFR FSI: ' ~ (('%+.2f'|format(SS.ofr_fsi)) if SS.ofr_fsi is not none else '—') ~ ' · 主要渠道: ' ~ ((td(SS.leading_driver)) if SS.leading_driver else '—') ~ ' · 商业票据融资: ' ~ ((td(SS.cp_stress)) if SS.cp_stress else '—')
      ) }}
    </div>
    {% endif %}

    {# Growth right now #}
    {% if C.growth_nowcast %}{% set GN = C.growth_nowcast %}
    {% set _gn_state = 'good' if (GN.gdpnow is not none and GN.gdpnow >= 2) else ('warn' if (GN.gdpnow is not none and GN.gdpnow >= 0) else 'bad') %}
    <div class="sig-tile {{ _gn_state }}">
      <div class="sig-label">{{ t('Growth right now','当前增长') }}</div>
      <div class="sig-value">{{ ('%+.1f%%'|format(GN.gdpnow)) if GN.gdpnow is not none else '—' }}</div>
      <div class="sig-meaning">{{ t("live estimate of this quarter's growth","本季度增长的实时估计") }}</div>
      {{ help(
        'GDPNow: ' ~ (('%+.1f%%'|format(GN.gdpnow)) if GN.gdpnow is not none else '—') ~ ' · WEI: ' ~ (('%+.2f'|format(GN.wei)) if GN.wei is not none else '—'),
        'GDPNow: ' ~ (('%+.1f%%'|format(GN.gdpnow)) if GN.gdpnow is not none else '—') ~ ' · 周度经济指数: ' ~ (('%+.2f'|format(GN.wei)) if GN.wei is not none else '—')
      ) }}
    </div>
    {% endif %}

    {# Inflation right now #}
