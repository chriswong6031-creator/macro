    {% endif %}
  </div>
  {% elif chart_liquidity %}
  <div style="font-size:14px;font-weight:600;margin-bottom:8px">
    {{ t('The money tide — watch the 4-week direction.', '关注资金潮4周方向。') }}
  </div>
  {% endif %}
  {% if chart_liquidity %}<div class="chart">{{ chart_liquidity | safe }}</div>{% endif %}
</div>

<div class="panel span6 rail-money anim-d3" id="credit">
  <h2>{{ t('Credit & market participation', '信用与市场参与度') }}
    {{ help('High-yield spread: the market\'s early smoke detector for credit stress. Participation = % of S&P 500 stocks above their 50-day average. Strong index + collapsing breadth = a fragile rally.', '高收益利差：信用压力的市场早期烟雾探测器。参与度=标普500高于50日均线的股票占比。指数强而广度崩塌=脆弱涨势。') }}
  </h2>
  {% set _cr_stances = (_stances.get('credit') if _stances else none) %}
  {% if _cr_stances %}
  <div style="font-size:14px;font-weight:600;margin-bottom:8px">{{ t(_cr_stances.en, _cr_stances.zh) if _cr_stances.en is defined else _cr_stances }}</div>
  {% elif chart_credit_breadth %}
  <div style="font-size:14px;font-weight:600;margin-bottom:8px">
    {{ t('Credit & participation — read together.', '信用与参与度 — 综合参考。') }}
  </div>
