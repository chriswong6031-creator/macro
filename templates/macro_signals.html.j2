{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro kv(label_en, label_zh, value) -%}
<div class="kv">{{ t(label_en, label_zh) }} <b>{{ value }}</b></div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Macro Signals — raw data', '宏观信号 — 原始数据') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
{% include '_plotly_head.html.j2' %}
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(36px,calc((100vw - 1340px)/2)); } }
  a { text-decoration:none; color:var(--link); }
  h1 { font-size:21px; margin:0 0 2px; }
  .lead { color:var(--muted); font-size:13px; margin:0 0 16px; max-width:70ch; }
  .grid { display:grid; gap:14px; grid-template-columns:repeat(12,1fr); }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; }
  .panel h2 { font-size:15px; margin:0 0 10px; }
  .span12 { grid-column:span 12; } .span6 { grid-column:span 6; } .span4 { grid-column:span 4; }
  @media (max-width:900px){ .span6,.span4 { grid-column:span 12; } }
  .sub { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:11px 13px; }
  .sub h3 { font-size:13px; margin:0 0 6px; }
  .kv { display:flex; justify-content:space-between; gap:12px; padding:2px 0; font-size:13px; }
  .kv b { font-family:var(--num); font-weight:700; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th,td { text-align:right; padding:5px 7px; border-bottom:1px solid var(--line); }
  th.l,td.l { text-align:left; }
  thead th { color:var(--muted); font-weight:600; font-size:11.5px; text-transform:uppercase; letter-spacing:.04em; }
  .muted { color:var(--muted); } .sm { font-size:12px; } .pos { color:var(--up); } .neg { color:var(--down); }
  .badge { display:inline-block; font-size:11px; padding:1px 7px; border-radius:6px; background:var(--panel2); border:1px solid var(--line); }
  .chip { display:inline-block; font-size:11px; padding:2px 8px; margin:2px 3px 2px 0; border-radius:6px; border:1px solid var(--line); }
  .chip-pos { color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,var(--line)); }
  .chip-neg { color:var(--down); border-color:color-mix(in srgb,var(--down) 40%,var(--line)); }
  .chart { margin-top:8px; }
  .pgauge { position:relative; height:8px; border-radius:5px; background:linear-gradient(90deg,var(--down),var(--warn),var(--up)); margin:6px 0 2px; }
  .pgauge i { position:absolute; top:-2px; width:3px; height:12px; background:var(--text); border-radius:2px; transform:translateX(-50%); }
  .pends { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); }
  .leg { display:flex; align-items:center; gap:8px; margin:4px 0; font-size:12.5px; }
  .leg-bar { flex:1; height:7px; border-radius:4px; background:var(--line); overflow:hidden; }
  .leg-bar i { display:block; height:100%; background:var(--muted); }
  .help { position:relative; display:inline-grid; place-items:center; width:15px; height:15px; border:1px solid var(--line); border-radius:50%; font-size:10px; color:var(--muted); cursor:help; vertical-align:middle; }
  .help .tip { visibility:hidden; opacity:0; position:absolute; z-index:20; bottom:130%; left:50%; transform:translateX(-50%); width:280px; background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 11px; font-size:11.5px; line-height:1.5; color:var(--text); box-shadow:0 8px 24px -10px rgba(0,0,0,.5); text-align:left; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; bottom:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { visibility:visible; opacity:1; }
  /* phone: a 280px tooltip centred on a help icon near the right edge spilled off
     the screen (it widened the page even while hidden). Anchor it to the icon's
     right and clamp its width so it always stays on-screen. */
  @media (max-width:700px){ .help .tip { left:auto; right:0; transform:none; max-width:calc(100vw - 28px); } }
  .back { display:inline-block; margin-bottom:14px; font-size:13px; font-weight:600; }
</style>
</head>
<body class="page-macro">
<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<a class="back" href="macro.html">← {{ t('Back to Macro Dashboard', '返回宏观仪表盘') }}</a>
<h1>🧮 {{ t('Macro Signals — raw data', '宏观信号 — 原始数据') }}</h1>
<p class="lead">{{ t('The full reading behind the dashboard — every gauge offloaded from the front page so it stays uncluttered, kept here in compressed form. All display-only / context; nothing here scores, sizes or feeds the regime engine. A machine-readable copy is at', '仪表盘背后的完整读数 — 从首页移出的每个量表都在此以压缩形式保留，使首页保持简洁。全部仅供展示／参考；此处无一进行评分、定仓或进入周期引擎。机器可读副本见') }} <a href="macrodata/macro_signals.json">macro_signals.json</a>{{ t('. Updated', '。更新于') }} {{ latest.date }}.</p>

<div class="grid">

  {# ===================== BUSINESS CYCLE ===================== #}
  {% if latest.business_cycle and latest.business_cycle.available %}
  {% set BC = latest.business_cycle %}{% set SIG = BC.recession_signal %}{% set M = BC.measured %}
  <div class="panel span12" id="business-cycle">
    <h2>🔄 {{ t('Business cycle — Leading · Coincident · Lagging', '商业周期 — 领先 · 同步 · 滞后') }}
      {{ help('Conference-Board-style three-tier decomposition kept SEPARATE so the lead-lag sequence is readable. Leading indicators turn first; coincident confirm the peak; lagging confirm last. The recession signal is the CB 3 Ds — depth+duration and diffusion. Measured against NBER dates.', '会议委员会式三层分解，保持分离以读出领先-滞后顺序。领先指标最先转向；同步确认峰值；滞后最后确认。衰退信号采用 CB 三D — 深度+持续与扩散。以 NBER 日期实测。') }}
    </h2>
    <div class="grid">
      <div class="sub span6">
        {% set on = SIG.state == 'on' %}
        <h3>{{ t('Recession signal', '衰退信号') }} · <span class="{{ 'neg' if on else 'pos' }}">{{ t('ON','触发') if on else t('OFF','未触发') }}</span> <span class="muted sm">{{ SIG.months_active }} {{ t('mo','月') }}</span></h3>
        <div class="muted sm">{{ t('Cycle phase', '周期阶段') }}: <b>{{ td(BC.phase.label) }}</b>
          {% if SIG.conditions %} · {{ t('depth','深度') }} {{ '✓' if SIG.conditions.depth else '✗' }} · {{ t('breadth','广度') }} {{ '✓' if SIG.conditions.breadth else '✗' }}{% endif %}</div>
        {% if BC.shadow and BC.shadow.phase and BC.shadow.phase.label != BC.phase.label %}
        <div class="muted sm" style="margin-top:4px;opacity:.7">{{ t('Shadow phase','影子相位') }}: {{ td(BC.shadow.phase.label) }} — {{ t('at an alternate publication lag','按替代发布滞后') }}</div>
        {% endif %}
        {% if M and M.oos_caught is not none %}<div class="muted sm" style="margin-top:6px">{{ t('Out-of-sample (LORO, 1985+)','样本外（留一衰退，1985+）') }} <b>{{ M.oos_caught }}/{{ M.oos_endogenous }}</b> {{ t('caught','已捕捉') }} · {{ t('median lead','中位领先') }} ~{{ M.oos_median_lead_months }}{{ t('mo','月') }} · {{ M.consensus_false_positives }} {{ t('false alarms','误报') }}{% if M.oos_catch_rate_jeffreys95 %} · {{ t('95% CI','95%置信区间') }} {{ M.oos_catch_rate_jeffreys95[0] }}–{{ M.oos_catch_rate_jeffreys95[1] }}{% endif %}</div>{% endif %}
      </div>
      <div class="sub span6">
        <h3>{{ t('Tier momentum', '层级动量') }} <span class="muted sm">{{ t('6-month','6个月') }}</span></h3>
        {% for tk, ten, tzh in [('leading','Leading','领先'),('coincident','Coincident','同步'),('lagging','Lagging','滞后')] %}
        {% set T = BC.tiers.get(tk) %}{% if T and T.mom6 is not none %}
        {{ kv(ten, tzh, ('%+.2f'|format(T.mom6)) ~ '  ·  ' ~ ('diff ' ~ (T.diffusion|round|int) if T.diffusion is not none else '') ~ '  ·  ' ~ (T.n_legs|string) ~ ' legs') }}
        {% endif %}{% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  {# ===================== REAL-TIME CONDITIONS & NOWCAST ===================== #}
  {% if latest.conditions %}
  {% set C = latest.conditions %}
  <div class="panel span12" id="conditions">
    <h2>🛰️ {{ t('The economy & risk, in real time', '经济与风险 · 实时') }}
      {{ help('Live reads from official Fed and options data — financial-system stress, recession odds, real-time growth & inflation, and risk appetite. Context only; never changes the regime call.', '来自官方美联储与期权数据的实时读数 — 金融体系压力、衰退概率、实时增长与通胀、风险偏好。仅供参考；绝不改变周期判断。') }}
    </h2>
    <div class="grid">
      {% if C.recession %}{% set RC = C.recession %}
      <div class="sub span4"><h3>{{ t('Recession risk','衰退风险') }} · <b>{{ RC.score|round|int if RC.score is not none else '—' }}/100</b> {% if RC.label %}<span class="muted sm">{{ td(RC.label) }}</span>{% endif %}</h3>
        {% if RC.sahm is not none %}{{ kv('Sahm','萨姆规则', '%.2f'|format(RC.sahm)) }}{% endif %}
        {% if RC.ny_fed_prob is not none %}{{ kv('NY Fed curve prob','纽约联储曲线概率', '%.0f%%'|format(RC.ny_fed_prob*100)) }}{% endif %}
        {% if RC.ebp is not none %}{{ kv('Excess bond premium','超额债券溢价', '%+.2f'|format(RC.ebp)) }}{% endif %}
      </div>{% endif %}
      {% if C.drawdown_risk %}{% set DR = C.drawdown_risk %}
      <div class="sub span4"><h3>{{ t('Drawdown risk','回撤风险') }} · <b>{{ DR.score|round|int if DR.score is not none else '—' }}/100</b> {% if DR.band %}<span class="muted sm">{{ td(DR.band) }}</span>{% endif %}</h3>
        {% if DR.dd10_prob_pct is not none %}{{ kv('P(≥10% / 63d)','概率(≥10%/63日)', DR.dd10_prob_pct ~ '%') }}{% endif %}
        {% if DR.base_rate_pct is not none %}{{ kv('Base rate','基准概率', DR.base_rate_pct ~ '%') }}{% endif %}
      </div>{% endif %}
      {% if C.financial_conditions %}{% set FC = C.financial_conditions %}
      <div class="sub span4"><h3>{{ t('Financial conditions','金融条件') }} {% if FC.state %}<span class="muted sm">{{ td(FC.state) }}</span>{% endif %}</h3>
        {% if FC.nfci is not none %}{{ kv('NFCI','NFCI', '%+.2f'|format(FC.nfci)) }}{% endif %}
        {% if FC.nfci_pctile is not none %}{{ kv('NFCI %ile','NFCI 百分位', (FC.nfci_pctile*100)|round|int ~ '%') }}{% endif %}
        {% if FC.trend %}{{ kv('Trend','趋势', td(FC.trend)) }}{% endif %}
      </div>{% endif %}
      {% if C.systemic_stress %}{% set SS = C.systemic_stress %}
      <div class="sub span4"><h3>{{ t('Systemic stress (OFR)','系统性压力 (OFR)') }} {% if SS.state %}<span class="muted sm">{{ td(SS.state) }}</span>{% endif %}</h3>
        {% if SS.ofr_fsi is not none %}{{ kv('OFR FSI','OFR 压力指数', '%+.2f'|format(SS.ofr_fsi)) }}{% endif %}
        {% if SS.leading_driver %}{{ kv('Top channel','主要渠道', td(SS.leading_driver)) }}{% endif %}
        {% if SS.cp_stress %}{{ kv('CP funding','商业票据融资', td(SS.cp_stress)) }}{% endif %}
      </div>{% endif %}
      {% if C.growth_nowcast or C.inflation_nowcast %}
      <div class="sub span4"><h3>{{ t('Growth & inflation nowcast','增长与通胀即时预测') }}</h3>
        {% if C.growth_nowcast %}{% set GN = C.growth_nowcast %}{% if GN.wei is not none %}{{ kv('Weekly Econ Index','周度经济指数', '%+.2f'|format(GN.wei)) }}{% endif %}{% if GN.gdpnow is not none %}{{ kv('GDPNow','GDPNow', '%+.1f%%'|format(GN.gdpnow)) }}{% endif %}{% endif %}
        {% if C.inflation_nowcast %}{% set IN = C.inflation_nowcast %}{% if IN.sticky_ann is not none %}{{ kv('Sticky CPI (ann.)','粘性CPI(年化)', '%.1f%%'|format(IN.sticky_ann)) }}{% endif %}{% if IN.flexible_ann is not none %}{{ kv('Flexible CPI (ann.)','弹性CPI(年化)', '%.1f%%'|format(IN.flexible_ann)) }}{% endif %}{% endif %}
      </div>{% endif %}
      {% if C.labor_nowcast %}{% set LN = C.labor_nowcast %}
      <div class="sub span4"><h3>{{ t('Labor & real activity','就业与实体活动') }} {% if LN.read %}<span class="muted sm">{{ td(LN.read) }}</span>{% endif %}</h3>
        {% if LN.claims_yoy_pct is not none %}{{ kv('Initial claims YoY','初请同比', '%+.1f%%'|format(LN.claims_yoy_pct)) }}{% endif %}
        {% if LN.indeed_chg_3m_pct is not none %}{{ kv('Indeed postings 3m','Indeed招聘3月', '%+.1f%%'|format(LN.indeed_chg_3m_pct)) }}{% endif %}
        {% if LN.withheld_tax_yoy_pct is not none %}{{ kv('Withheld taxes YoY','预扣税同比', '%+.1f%%'|format(LN.withheld_tax_yoy_pct)) }}{% endif %}
      </div>{% endif %}
      {% if C.risk_appetite %}{% set RA = C.risk_appetite %}
      <div class="sub span4"><h3>{{ t('Risk appetite','风险偏好') }}</h3>
        {% if RA.roro is not none %}{{ kv('RORO composite','RORO 综合', '%+.2f'|format(RA.roro) ~ (' · ' ~ RA.roro_state if RA.roro_state else '')) }}{% endif %}
        {% if RA.vrp is not none %}{{ kv('Variance risk premium','方差风险溢价', '%+.1f'|format(RA.vrp)) }}{% endif %}
        {% if RA.vix_term is not none %}{{ kv('VIX term','VIX 期限', '%.2f'|format(RA.vix_term)) }}{% endif %}
        {% if RA.stock_bond_corr is not none %}{{ kv('Stock-bond corr','股债相关', '%+.2f'|format(RA.stock_bond_corr)) }}{% endif %}
      </div>{% endif %}
      {% if C.capitulation and C.capitulation.score is not none %}{% set CAP = C.capitulation %}
      <div class="sub span4"><h3>{{ t('Capitulation','投降') }} · <b>{{ CAP.score }}/3</b></h3>
        {% if CAP.signals_firing %}<div class="muted sm">{{ CAP.signals_firing|join(' · ') }}</div>{% endif %}
        {% if CAP.measured_bounce_pct is not none %}{{ kv('Measured bounce','实测反弹', '%+.1f%%'|format(CAP.measured_bounce_pct)) }}{% endif %}
      </div>{% endif %}
    </div>
  </div>
  {% endif %}

  {# ===================== FEAR / GREED COMPOSITE — full leg breakdown (P1.2) ===================== #}
  {% if fear_greed %}
  {% set FG = fear_greed %}
  {% set _fgbandzh = {'Extreme Fear':'极度恐惧','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Extreme Greed':'极度贪婪'} %}
  <div class="panel span12" id="fear-greed-detail">
    <h2>📊 {{ t('Fear / Greed composite — full breakdown', '恐惧/贪婪合成 — 完整拆解') }}</h2>
    <div class="sub" style="margin-bottom:10px">
      <div><b>{{ t('Composite dial','合成指针') }}</b> <span style="font-size:24px;font-weight:700">{{ FG.dial }}</span><span class="muted sm">/100</span>
        <span class="badge">{{ t(FG.label_en, _fgbandzh.get(FG.label_en, FG.label_en)) }}</span>
        <span class="muted sm" style="float:right">{{ FG.n_legs_qualifying }} {{ t('legs qualifying','分量入合成') }}</span></div>
      <div class="pgauge" style="width:min(480px,100%)"><i style="left:{{ FG.dial }}%"></i></div>
      <div class="pends" style="width:min(480px,100%)">
        <span>← {{ t('Extreme Fear','极度恐惧') }}</span><span>{{ t('Extreme Greed','极度贪婪') }} →</span>
      </div>
    </div>

    {# Qualifying legs table #}
    {% if FG.legs_included %}
    <h3 style="font-size:13px;margin:14px 0 6px">{{ t('Qualifying legs (entered composite)','入合成分量') }}
      <span class="muted sm">{{ t('z-score is greed-positive; orientation shown per leg','z 分数以贪婪为正；每项方向各标注') }}</span></h3>
    <table>
      <thead><tr>
        <th class="l">{{ t('Leg','分量') }}</th>
        <th>{{ t('Value','数值') }}</th>
        <th>{{ t('z-score','z 分数') }}</th>
        <th>{{ t('Greed %ile','贪婪百分位') }}</th>
        <th class="l">{{ t('Orientation','方向') }}</th>
        <th>{{ t('Obs','观测数') }}</th>
        <th>{{ t('Fresh','新鲜度') }}</th>
      </tr></thead>
      <tbody>
      {% for leg in FG.legs_included %}
      {% set _zc = 'pos' if (leg.z is not none and leg.z > 0.5) else ('neg' if (leg.z is not none and leg.z < -0.5) else '') %}
      <tr>
        <td class="l"><b>{{ t(leg.name_en, leg.name_zh) }}</b></td>
        <td>{{ '%.2f'|format(leg.value) if leg.value is not none else '—' }} <span class="muted sm">{{ leg.unit }}</span></td>
        <td class="{{ _zc }}">{{ ('%+.2f'|format(leg.z)) if leg.z is not none else '—' }}</td>
        <td>{% if leg.pct is not none %}<div class="pgauge" style="width:80px;display:inline-block;vertical-align:middle"><i style="left:{{ leg.pct }}%"></i></div> {{ leg.pct }}{% else %}—{% endif %}</td>
        <td class="l sm muted">{{ t(leg.orientation, leg.orientation|replace('higher=greed','高=贪婪')|replace('lower=greed','低=贪婪')) }}</td>
        <td class="sm muted">{{ leg.obs_count }}</td>
        <td class="{{ 'pos' if leg.freshness == 'fresh' else 'warn' if leg.freshness == 'stale' else 'muted' }} sm">{{ t(leg.freshness, leg.freshness|replace('fresh','新鲜')|replace('stale','陈旧')|replace('missing','缺失')) }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {# Excluded legs (young or missing) #}
    {% if FG.legs_excluded_young %}
    <h3 style="font-size:13px;margin:14px 0 6px">{{ t('Excluded legs (below min-history gate)','被排除分量（未达最低历史门槛）') }}</h3>
    <table>
      <thead><tr>
        <th class="l">{{ t('Leg','分量') }}</th>
        <th>{{ t('Obs','观测数') }}</th>
        <th>{{ t('Gate threshold','门槛') }}</th>
        <th>{{ t('Status','状态') }}</th>
      </tr></thead>
      <tbody>
      {% for leg in FG.legs_excluded_young %}
      <tr>
        <td class="l">{{ t(leg.name_en, leg.name_zh) }}</td>
        <td class="sm muted">{{ leg.obs_count if leg.obs_count is not none else '—' }}</td>
        <td class="sm muted">{{ t('≥252 daily','≥252 日') if leg.key not in ['naaim'] else t('≥104 weekly','≥104 周') }}</td>
        <td class="sm warn">{{ t('excluded — young','已排除 — 过短') }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {# Young context tiles #}
    {% if FG.young_tiles %}
    <h3 style="font-size:13px;margin:14px 0 6px">{{ t('Context tiles (series too young to z-score)','背景小块（序列过短，无法计算 z 分数）') }}</h3>
    <div style="display:flex;flex-wrap:wrap;gap:10px 18px">
      {% for yt in FG.young_tiles %}
      <div style="background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:8px 12px;min-width:180px">
        <div class="sm muted">{{ t(yt.name_en, yt.name_zh) }}</div>
        <div style="font-size:18px;font-weight:700">{{ yt.value if yt.value is not none else '—' }}</div>
        <div class="muted sm">{{ yt.obs_count }} {{ t('obs · raw context only','条 · 仅原始参考') }}</div>
        {% if yt.as_of %}<div class="muted sm">{{ yt.as_of }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <p class="muted sm" style="margin:14px 0 0">{{ t(FG.disclaimer_en, FG.disclaimer_zh) }}</p>
  </div>
  {% endif %}

  {# ===================== FEAR <-> EUPHORIA (full) ===================== #}
  {% if fear_euphoria %}
  {% set FE = fear_euphoria %}
  {% set _bandzh = {'Panic':'恐慌','Fear':'恐惧','Neutral':'中性','Greed':'贪婪','Euphoria':'欣喜'} %}
  <div class="panel span6" id="fear-euphoria">
    <h2>🌡️ {{ t('Fear ↔ Euphoria — full breakdown', '恐惧 ↔ 欣喜 — 完整拆解') }}</h2>
    <div class="sub">
      <div><b>{{ t('Fear ↔ Euphoria','恐惧 ↔ 欣喜') }}</b> <span style="font-size:20px">{{ FE.fe_score }}</span><span class="muted sm">/100</span>
        <span class="badge">{{ t(FE.band, _bandzh.get(FE.band, FE.band)) }}</span>
        {% if FE.roro is not none %}<span class="muted sm" style="float:right">RORO {{ '%+.2f'|format(FE.roro) }}</span>{% endif %}</div>
      <div class="pgauge"><i style="left:{{ FE.fe_score }}%"></i></div>
      <div class="pends"><span>← {{ t('Fear','恐惧') }}</span><span>{{ t('Euphoria','欣喜') }} →</span></div>
    </div>
    <h3 style="font-size:13px;margin:12px 0 4px">{{ t('What is driving it','驱动因素') }} <span class="muted sm">{{ t('7 RORO legs','7 项 RORO 分量') }}</span></h3>
    {% for leg in FE.legs %}
    <div class="leg"><span style="flex:0 0 130px">{{ t(leg.name_en, leg.name_zh) }}</span>
      <div class="leg-bar"><i style="width:{{ leg.pct }}%"></i></div>
      <span class="muted sm" style="flex:0 0 92px;text-align:right">{{ '%+.2f'|format(leg.value) }} · {{ td(leg.lean) }}</span></div>
    {% endfor %}
    {% if FE.positioning %}{% set P = FE.positioning %}
    <div class="sub" style="margin-top:10px"><b>{{ t('Positioning vs price','持仓与价格') }}</b>
      <span class="badge" style="float:right">{% if P.chip=='confirms' %}{{ t('confirms','一致') }}{% elif P.chip=='diverges' %}{{ t('diverges','背离') }}{% else %}{{ t('mixed','混杂') }}{% endif %}</span>
      <div class="muted sm">{{ t('COT spec','COT 投机') }}: {% if P.cot_washed_out %}{{ t('washed out','已清洗') }}{% elif P.cot_crowded_long %}{{ t('crowded long','拥挤做多') }}{% else %}{{ t('neutral','中性') }}{% endif %} · {{ t('insider breadth','内部人广度') }} {{ '%+.0f'|format(P.insider_breadth*100) }}%</div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {# ===================== REGIME INTERNALS — two dials ===================== #}
  <div class="panel span6" id="dials">
    <h2>{{ t('Regime internals — the two dials', '周期内部 — 两个刻度盘') }}
      {{ help('The regime label comes from two scores between −1 and +1, built from market prices (lead) plus a small weight on economic data (confirm). The chips show which indicators agree (green) vs disagree (red) with the call.', '周期标签来自两个介于 −1 与 +1 之间的分数，由市场价格（领先）加上经济数据（确认）的小幅权重构建。标签显示哪些指标与判断同向（绿）或反向（红）。') }}
    </h2>
    {% if latest.growth_score is not none %}
    <div class="kv">{{ t('Growth','增长') }} <b>{{ t('RISING','上行') if latest.growth_score >= 0 else t('FALLING','下行') }} ({{ '%+.2f'|format(latest.growth_score) }}, {{ t('agree','一致') }} {{ (latest.growth_confidence*100)|round|int }}%)</b></div>
    <div class="pgauge"><i style="left:{{ ((latest.growth_score+1)/2*100)|round(1) }}%"></i></div>
    {% endif %}
    {% if latest.inflation_score is not none %}
    <div class="kv" style="margin-top:8px">{{ t('Inflation','通胀') }} <b>{{ t('RISING','上行') if latest.inflation_score >= 0 else t('FALLING','下行') }} ({{ '%+.2f'|format(latest.inflation_score) }}, {{ t('agree','一致') }} {{ (latest.inflation_confidence*100)|round|int }}%)</b></div>
    <div class="pgauge"><i style="left:{{ ((latest.inflation_score+1)/2*100)|round(1) }}%"></i></div>
    {% endif %}
    <h3 style="font-size:13px;margin:12px 0 4px">{{ t("What's voting",'哪些指标在投票') }}</h3>
    <div>{% for c in components_confirming %}<span class="chip chip-pos">{{ c }}</span>{% endfor %}{% for c in components_contradicting %}<span class="chip chip-neg">{{ c }}</span>{% endfor %}{% if not components_confirming and not components_contradicting %}<span class="muted">{{ t('all quiet','一切平静') }}</span>{% endif %}</div>
    {% if flip_plain %}<h3 style="font-size:13px;margin:12px 0 4px">{{ t('Weakest link','最薄弱环节') }}</h3><p class="muted sm" style="margin:0">{{ flip_plain }}</p>{% endif %}
    {% if latest.preference_check %}<h3 style="font-size:13px;margin:12px 0 4px">{{ t('Does the market agree?','市场是否认同？') }}</h3><p class="muted sm" style="margin:0">{{ latest.preference_check.note }}</p>{% endif %}
  </div>

  {# ===================== COMMODITIES TAPE ===================== #}
  {% if commodities %}
  <div class="panel span6" id="commodities">
    <h2>{{ t('Commodities & macro tape', '大宗商品与宏观盘面') }}</h2>
    <table>
      <thead><tr><th class="l">{{ t('instrument','标的') }}</th><th>{{ t('trend','趋势') }}</th><th>RSI</th><th>{{ t('off 52w','距52周高') }}</th><th>{{ t('3mo','3月') }}</th></tr></thead>
      <tbody>
      {% for c in commodities %}
      <tr><td class="l"><b>{{ td(c.name) }}</b></td>
        <td class="sm">{{ '✓' if c.above200 else '✗' }}200 {{ '✓' if c.above50 else '✗' }}50</td>
        <td>{{ c.rsi14|round|int if c.rsi14 is not none else '—' }}</td>
        <td class="{{ 'neg' if c.off_52w_high_pct < -10 else '' }}">{{ '%+.1f'|format(c.off_52w_high_pct) }}%</td>
        <td class="{{ 'pos' if c.mom_60d_pct > 0 else 'neg' }}">{{ '%+.1f'|format(c.mom_60d_pct) }}%</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {# ===================== POSITIONING / CROWD METER ===================== #}
  {% if positioning %}
  <div class="panel span6" id="positioning">
    <h2>{{ t("Who's positioned how — the crowd meter", '谁如何持仓 — 拥挤度计') }}</h2>
    <table>
      <thead><tr><th class="l">{{ t('who / what','谁／什么') }}</th><th class="l">{{ t('where they stand','当前位置') }}</th></tr></thead>
      <tbody>
      {% for p in positioning %}
      <tr><td class="l">{{ p.name }}</td>
        <td class="l">{% if p.pct is not none %}<div class="pgauge" style="width:120px;display:inline-block;vertical-align:middle"><i style="left:{{ p.pct|round(1) }}%"></i></div> <span class="sm">{{ p.label }}</span>{% else %}<span class="sm">{{ p.label }}</span>{% endif %}{% if p.verdict %} <span class="muted sm">— {{ p.verdict }}</span>{% endif %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {# ===================== FED LIQUIDITY ===================== #}
  {% if chart_liquidity %}
  <div class="panel span6" id="liquidity">
    <h2>{{ t('Fed liquidity — the money tide', '美联储流动性 — 资金潮') }}
      {{ help('Net money in the system (Fed balance sheet − reverse-repo − Treasury account), in billions, plus its 4-week change. Expanding (green) is historically the most reliable tailwind; contracting (red) is a headwind.', '系统内净资金（美联储资产负债表 − 逆回购 − 财政部账户），单位十亿，及其 4 周变化。扩张（绿）历史上最可靠的顺风；收缩（红）为逆风。') }}
    </h2>
    <div class="chart">{{ chart_liquidity | safe }}</div>
  </div>
  {% endif %}

  {# ===================== CREDIT & BREADTH ===================== #}
  {% if chart_credit_breadth %}
  <div class="panel span6" id="credit">
    <h2>{{ t('Credit stress & market breadth', '信用压力与市场广度') }}
      {{ help('High-yield spread (the market\'s early smoke detector) over % of the S&P above its 50-day average (participation). Strong index + collapsing breadth = fragile.', '高收益利差（市场早期烟雾探测器）叠加标普中高于50日均线的股票占比（参与度）。指数强而广度崩塌 = 脆弱。') }}
    </h2>
    <div class="chart">{{ chart_credit_breadth | safe }}</div>
  </div>
  {% endif %}

  {# ===================== VIX MONITOR ===================== #}
  {% if vix %}
  <div class="panel span6" id="vix-monitor">
    <h2>{{ t('VIX monitor', 'VIX 监测') }}</h2>
    <div class="sub" style="margin-bottom:8px">
      <span style="font-size:20px;font-weight:700">{{ '%.2f'|format(vix.last) }}</span>
      <span class="{{ 'pos' if vix.chg > 0 else 'neg' if vix.chg < 0 else 'muted' }}">{{ '%+.2f'|format(vix.chg) }} ({{ '%+.1f'|format(vix.pct) }}%)</span>
      <span class="badge">{{ vix.regime }}</span>
      <div class="muted sm" style="margin-top:4px">{% if vix.ratio is not none %}{{ t('Term structure','期限结构') }} <b>{{ '%.2f'|format(vix.ratio) }}</b> {{ vix.rword }} · {% endif %}{{ t('percentile','百分位') }} {{ '%.0f'|format(vix.pctile) }}</div>
    </div>
    <div class="chart">{{ chart_vix | safe }}</div>
  </div>
  {% endif %}

</div>
<script src="theme.js"></script>
</body>
</html>
