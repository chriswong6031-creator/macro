        'RORO: ' ~ (('%+.2f'|format(RA.roro)) if RA.roro is not none else '—') ~ ' · 方差风险溢价: ' ~ (('%+.1f'|format(RA.vrp)) if RA.vrp is not none else '—') ~ ' · VIX期限: ' ~ (('%.2f'|format(RA.vix_term)) if RA.vix_term is not none else '—') ~ ' · 股债相关: ' ~ (('%+.2f'|format(RA.stock_bond_corr)) if RA.stock_bond_corr is not none else '—')
      ) }}
