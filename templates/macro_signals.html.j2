  <div style="font-size:14px;font-weight:600;margin-bottom:8px">{{ t(_liq_stances.en, _liq_stances.zh) if _liq_stances.en is defined else _liq_stances }}
    {% if _liq_meta and _liq_meta.get('chg_4w_bn') is not none %}
