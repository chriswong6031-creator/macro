        '初请同比: ' ~ (('%+.1f%%'|format(LN.claims_yoy_pct)) if LN.claims_yoy_pct is not none else '—') ~ ' · Indeed招聘3月: ' ~ (('%+.1f%%'|format(LN.indeed_chg_3m_pct)) if LN.indeed_chg_3m_pct is not none else '—') ~ ' · 预扣税同比: ' ~ (('%+.1f%%'|format(LN.withheld_tax_yoy_pct)) if LN.withheld_tax_yoy_pct is not none else '—')
      ) }}
