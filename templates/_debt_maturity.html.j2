{% if debt_maturity and debt_maturity.status != 'not_applicable' %}
<section class="mod rv" id="debt-maturity" data-panel="debt_maturity.v1">
  <div class="mod-hd">
    <h2>{{ t('Debt coming due', '到期债务') }}</h2>
    <span class="hint">{% if debt_maturity.period %}{{ debt_maturity.period.label }} {{ debt_maturity.period.form }}{% else %}{{ t('SEC filings', 'SEC 文件') }}{% endif %}</span>
  </div>

  {% if debt_maturity.status == 'reported' or debt_maturity.status == 'no_maturity_facts' %}
    {% if debt_maturity.status == 'reported' %}
      {% if debt_maturity.near_share_pct is not none %}
      <p class="dmw-lede">{{ t('About ' ~ debt_maturity.near_share_pct ~ '% of the principal it has reported — ' ~ debt_maturity.buckets[0].display ~ ' — comes due in the next 12 months.',
                              '在已披露的到期本金中，约 ' ~ debt_maturity.near_share_pct ~ '%（' ~ debt_maturity.buckets[0].display ~ '）将在未来12个月内到期。') }}</p>
      {% else %}
      <p class="dmw-lede">{{ t('The next 12 months are not reported in this filing. The years below are what it did report.',
                              '本次文件未披露未来12个月的到期金额；下方为其确实披露的年度。') }}</p>
      {% endif %}
    {% else %}
    <p class="dmw-lede">{{ t('Its filings are available, but they do not break debt down by the year it comes due — every bucket below is unreported.',
                            '已获取该公司的 SEC 文件，但文件中未按到期年度拆分债务 —— 以下各区间均未披露。') }}</p>
    {% endif %}
    <div class="dmw{% if debt_maturity.status != 'reported' %} dmw-no-rail{% endif %}">
      <div class="dmw-rows">
        {% for b in debt_maturity.buckets %}
        <div class="dmr{% if not b.reported %} na{% endif %}" style="--i:{{ loop.index0 }};">
          <span class="dmr-lb">{{ t(b.label_en, b.label_zh) }}</span>
          <span class="dmr-tr">{% if b.reported %}<i class="dmr-bar" style="--w:{{ b.share_pct }}%;"></i>{% endif %}</span>
          <span class="dmr-val">{% if b.reported %}{{ b.display }}{% else %}{{ t('not reported', '未披露') }}{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      {% if debt_maturity.status == 'reported' %}
      <aside class="dmw-rail">
        <div class="dmw-tl">{{ t('Reported principal due', '已披露到期本金') }}</div>
        <div class="dmw-total">{{ debt_maturity.total_display }}</div>
        <p class="dmw-note">{{ t('What the company itself reported it must repay. Not the market value of its bonds, and not the face value any fund holds.',
                                 '这是公司自身披露的应偿还本金，既非其债券的市场价值，也不是任何基金持有的面值。') }}</p>
        <p class="dmw-src">{{ t('Source: SEC filings', '来源：SEC 文件') }} · {{ debt_maturity.period.form }} {{ debt_maturity.period.end }}{% if debt_maturity.period.stale %} · {{ t('most recent annual filing', '最近一期年度文件') }}{% endif %}</p>
      </aside>
      {% endif %}
    </div>
    {% if debt_maturity.status == 'no_maturity_facts' %}
    <p class="dmw-nullwhy">{{ t('Not every company reports a year-by-year schedule. Nothing is being estimated in its place.', '并非所有公司都会披露逐年到期安排；此处不作任何估算替代。') }}</p>
    {% endif %}
    {% if debt_maturity.status == 'reported' %}
    <details class="dmw-detail">
      <summary>{{ t('How this is read', '数据来源说明') }}</summary>
      <p>{{ t('Figures are XBRL facts from one filing — no two years are mixed. Filing', '数据取自同一份文件中的 XBRL 事实，不跨文件拼接。文件') }}
         <code>{{ debt_maturity.period.accn }}</code>, {{ t('period ending', '报告期截至') }} {{ debt_maturity.period.end }}, {{ t('unit', '单位') }} {{ debt_maturity.unit }}.
         {{ debt_maturity.buckets_reported }}/{{ debt_maturity.buckets_total }} {{ t('buckets reported.', '个区间有披露。') }}</p>
      <ul>{% for b in debt_maturity.buckets %}<li><code>{{ b.tag }}</code>{% if not b.reported %} — {{ b.drop_reason }}{% endif %}</li>{% endfor %}</ul>
    </details>
    {% endif %}

  {% elif debt_maturity.status == 'no_filings' %}
    <p class="dmw-null">{{ t('No SEC filings available for this listing.', '该证券暂无可用的 SEC 文件。') }}</p>
    <p class="dmw-nullwhy">{{ t('This panel only reads filings an issuer makes with the SEC. None were found for this one, so there is nothing to show yet.',
                               '本面板仅读取发行人向 SEC 提交的文件。此处暂未找到相关文件，因此暂无可展示的内容。') }}</p>

  {% elif debt_maturity.status == 'not_loaded' %}
    <p class="dmw-null">{{ t('Debt schedule not loaded yet.', '到期债务尚未加载。') }}</p>
    <p class="dmw-nullwhy">{{ t('This panel is still catching up to the SEC filings for this listing. Check back soon — nothing is being estimated in its place.',
                               '本面板仍在同步该证券的 SEC 文件，请稍后再查看；此处不作任何估算替代。') }}</p>

  {% elif debt_maturity.status == 'identity_mismatch' %}
    <p class="dmw-null">{{ t('We could not confirm which company filed for this listing, so the debt schedule is not shown.',
                            '我们无法确认是哪家公司为该证券提交了文件，因此未显示到期债务信息。') }}</p>
    <p class="dmw-nullwhy">{{ t('This panel only shows figures once the identity of the filer is verified. Nothing is being guessed in its place.',
                               '本面板仅在核实发行人身份后才会显示相关数据；此处不作任何猜测替代。') }}</p>
  {% endif %}

  <div class="mod-ft">{{ t('Research context only — reported figures from SEC filings, not a rating, a signal or investment advice.',
                           '仅供研究参考 — 数据摘自 SEC 文件披露口径，不构成评级、信号或投资建议。') }}</div>
</section>
{% endif %}
