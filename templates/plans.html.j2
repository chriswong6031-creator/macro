    <span class="ficon" id="flag-icon"></span>
    <span id="flag-text"></span>
    <button class="fx" id="flag-x" aria-label="Dismiss">✕</button>
  </div>

  {# ── SECTION HEAD (landing #pricing parity: kicker · title · pill toggle) ── #}
