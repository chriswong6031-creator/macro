        <ul class="tf">
          <li><b>{{ t('US macro dashboard', '美国宏观仪表盘') }}</b> — {{ t('the full read; drill-downs unlock after signup', '完整研判；注册后解锁下钻详情') }}</li>
          <li><b>{{ t('3 signals per daily list', '每个每日列表 3 条信号') }}</b> — {{ t('visitors preview 1 before signup', '访客注册前可预览 1 条') }}</li>
          <li>{{ t('One research report', '一份研究报告') }}</li>
          <li>{{ t('Special situations', '特殊事件') }} — <b>{{ t('the 3 newest filings', '最新 3 份申报') }}</b></li>
          <li>{{ t('Committee &amp; brief — a teaser', '委员会与简报 — 预览') }}</li>
          <li>{{ t('Mastermind chat', '操盘大脑对话') }} — <b>{{ t('5 quick questions a week', '每周 5 个快速提问') }}</b></li>
          <li>{{ t('Terminal charting', 'Terminal 图表') }} — <b>{{ terminal_indicators.core_count }} {{ t('core indicators', '个核心指标') }}</b> + {{ t('Candle Painter', 'K 线着色器') }}</li>
        </ul>
        <button class="btn" data-act="free" type="button"><span class="btxt">{{ t('Sign in — it’s free', '登录 — 完全免费') }}</span></button>
        <p class="cta-note" id="free-note"><span class="l-en">Your current plan.</span><span class="l-zh">你当前的方案。</span></p>
      </section>

      {# ---- ESSENTIAL (catalog key + entitlement tier: essential) ---- #}
