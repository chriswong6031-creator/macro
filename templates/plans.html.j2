    <div class="p-head">
      <span class="kicker">{{ t('Pricing', '定价') }}</span>
      <h2 class="sec-title">{{ t('Free to explore.', '免费探索。') }}<br>{{ t('Built for deeper decisions.', '为更深的决策而生。') }}</h2>
      <div class="toggle" role="group" aria-label="Billing interval" id="btoggle">
        <button type="button" data-interval="annual" aria-pressed="true">{{ t('Annual', '按年') }}
          <span class="save l-en">FOUNDING PRO AVAILABLE</span><span class="save l-zh">FOUNDING PRO 开放中</span>
        </button>
        <button type="button" data-interval="monthly" aria-pressed="false">{{ t('Monthly', '按月') }}</button>
      </div>
      <p class="toggle-note" id="toggle-note">
        <span class="l-en">Founding Pro gives you every Pro feature for the Essential annual price.</span><span class="l-zh">Founding Pro 让你以 Essential 年付价格解锁 Pro 全部功能。</span>
      </p>
    </div>

    {# ── TIER CARDS ───────────────────────────────────────────────────── #}
