<div class="wrap">

  {#- return-flag banner: filled + shown by JS when ?checkout=success|cancel -#}
  <div class="flag-banner" id="flag-banner" role="status">
    <span class="ficon" id="flag-icon"></span>
    <span id="flag-text"></span>
    <button class="fx" id="flag-x" aria-label="Dismiss">✕</button>
  </div>

  {# ── HERO ─────────────────────────────────────────────────────────── #}
  <header class="hero">
    <span class="eyebrow">{{ t('Membership', '会员方案') }}</span>
    <h1>{{ t('One market brain.', '一个市场大脑，') }} <span class="accent">{{ t('Every desk on it.', '所有桌面尽在其中。') }}</span></h1>
    <p class="sub">{{ t('Every dashboard, the full research desk, and the Mastermind chat — in one place. Start free, or take a 7-day trial of the paid tiers.',
                        '所有仪表盘、完整研究桌面，以及操盘大脑对话——尽在一处。免费开始，或试用付费方案 7 天。') }}</p>

    {# ── billing toggle (signature) ── #}
    <div class="toggle-wrap">
      <div class="btoggle annual" id="btoggle" role="group" aria-label="Billing interval">
        <span class="knob" aria-hidden="true"></span>
        <button type="button" data-interval="monthly" aria-pressed="false">{{ t('Monthly', '按月') }}</button>
        <button type="button" data-interval="annual" class="on" aria-pressed="true">
          {{ t('Annual', '按年') }}
