<div id="ptoast" role="alert"></div>

<script src="theme.js"></script>
<script>
/* plans.js (inline) — billing toggle + Stripe checkout wiring.

   The annual/monthly toggle re-derives EVERY price client-side from the raw cents
   baked into each card's data- attributes, so build-time Jinja and run-time JS never
   drift (single source of truth = config/plans.yml → both sides).

   Checkout mirrors templates/mm_brain.js EXACTLY for origin + auth:
   * API base   — mm_brain.js:22  `var API = (CFG.api || '').replace(/\/$/, '')`
                  (window.MM_BRAIN_CFG.api; '' = same origin, which is what the site uses).
   * bearer tok — mm_brain.js:344-351 withAuth(): window.MDXAuth.client().auth.getSession()
                  → r.data.session.access_token → Authorization: 'Bearer ' + t.
   * signed-out — mm_brain.js:473  window.MDXAuth.open('signin') behind MDXAuth.enabled(). */
(function () {
  'use strict';
  var zh = function () { return document.documentElement.getAttribute('data-lang') === 'zh'; };
  var L = function (en, cn) { return zh() ? cn : en; };
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  /* API base — identical resolution to mm_brain.js (same-origin default). */
  var API = ((window.MM_BRAIN_CFG && window.MM_BRAIN_CFG.api) || '').replace(/\/$/, '');

  /* Supabase bearer, mirroring mm_brain.js withAuth(). */
  function withAuth(h) {
    h = h || {};
    if (!(window.MDXAuth && window.MDXAuth.client)) return Promise.resolve(h);
    return window.MDXAuth.client().then(function (sb) { return sb.auth.getSession(); })
      .then(function (r) { var t = r && r.data && r.data.session && r.data.session.access_token; if (t) h['Authorization'] = 'Bearer ' + t; return h; })
      .catch(function () { return h; });
  }
  function authEnabled() { return !!(window.MDXAuth && window.MDXAuth.enabled && window.MDXAuth.enabled()); }
  function isSignedIn() {
    try { return !!(window.MDXAuth && window.MDXAuth.user && window.MDXAuth.user()); } catch (e) { return false; }
  }

  /* ── toast (interface voice — states what happened + what to do) ── */
  var toastEl = $('#ptoast'), toastT = null;
  function toast(msg) {
    if (!toastEl) return;
    toastEl.textContent = msg; toastEl.classList.add('show');
    clearTimeout(toastT); toastT = setTimeout(function () { toastEl.classList.remove('show'); }, 5200);
  }

  /* ── billing toggle: re-derive every price from the cents on each card ── */
  var toggle = $('#btoggle'), note = $('#toggle-note');
  var interval = 'annual'; /* masterplan §2.1 — annual is the default view */

  function fmtCents(c) { return Math.round(c / 100); } /* whole-dollar per-month, matches Python round() */

  function paintPrices() {
    var annual = interval === 'annual';
    $$('.card[data-tier]').forEach(function (card) {
      var mPm = card.getAttribute('data-m-pm'), aPm = card.getAttribute('data-a-pm');
      var aTot = card.getAttribute('data-a-total'), save = card.getAttribute('data-save');
      var priceEl = $('[data-price]', card), billedEl = $('[data-billed]', card), badgeEl = $('[data-badge]', card);
      if (priceEl) {
        priceEl.style.opacity = '0';
        setTimeout(function () { priceEl.textContent = annual ? aPm : mPm; priceEl.style.opacity = '1'; }, 90);
      }
      if (billedEl) {
        billedEl.innerHTML = annual
          ? '<span class="l-en">Billed $' + aTot + ' a year.</span><span class="l-zh">每年结算 $' + aTot + '。</span>'
          : '<span class="l-en">Billed monthly.</span><span class="l-zh">按月结算。</span>';
      }
      if (badgeEl) {
        badgeEl.classList.toggle('hidden', !annual);
        badgeEl.innerHTML = '<span class="l-en">save ' + save + '%</span><span class="l-zh">省 ' + save + '%</span>';
      }
    });
    /* matrix header prices track the toggle too */
    $$('[data-mtx-price]').forEach(function (el) {
      var tier = el.getAttribute('data-mtx-price');
      var card = $('.card[data-tier="' + tier + '"]');
      if (!card) return;
      var pm = annual ? card.getAttribute('data-a-pm') : card.getAttribute('data-m-pm');
      el.textContent = '$' + pm + '/mo';
    });
    if (note) {
      note.innerHTML = annual
        ? '<span class="l-en">Billed yearly — two months on us versus paying monthly.</span><span class="l-zh">按年结算——相比按月付费，等于免两个月。</span>'
        : '<span class="l-en">Billed month to month. Switch to annual to pay less.</span><span class="l-zh">按月结算。切换到按年更省。</span>';
    }
  }
  function setInterval_(iv) {
    interval = iv;
    toggle.classList.toggle('annual', iv === 'annual');
    $$('button', toggle).forEach(function (b) {
      var on = b.getAttribute('data-interval') === iv;
      b.classList.toggle('on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    paintPrices();
  }
  if (toggle) {
    $$('button', toggle).forEach(function (b) {
      b.addEventListener('click', function () { setInterval_(b.getAttribute('data-interval')); });
    });
    setInterval_('annual'); /* establish annual-default state on load */
  }

  /* ── checkout ── */
  function goCheckout(tier, btn) {
    var busy = btn && btn.getAttribute('aria-busy') === 'true';
    if (busy) return;
    /* signed-out → open the account/auth modal instead of hitting the API */
    if (!isSignedIn()) {
      if (window.MDXAuth && authEnabled()) { window.MDXAuth.open('signin'); }
      else { toast(L('Sign in to start your trial.', '登录以开始试用。')); }
      return;
    }
    var txt = btn ? $('.btxt', btn) : null, prev = txt ? txt.textContent : '';
    if (btn) { btn.setAttribute('aria-busy', 'true'); if (txt) txt.innerHTML = '<span class="spin"></span>'; }
    withAuth({ 'Content-Type': 'application/json' }).then(function (h) {
      return fetch(API + '/api/billing/checkout', {
        method: 'POST', headers: h, credentials: 'include',
        body: JSON.stringify({ tier: tier, interval: interval })
      });
    }).then(function (r) {
      if (r.status === 401) {
        if (window.MDXAuth && authEnabled()) window.MDXAuth.open('signin');
        throw new Error('auth');
      }
      return r.ok ? r.json() : r.json().catch(function () { return {}; }).then(function (j) { throw new Error(j.detail || j.error || 'http'); });
    }).then(function (d) {
      if (d && d.url) { window.location = d.url; }
      else { throw new Error('nourl'); }
    }).catch(function (e) {
      if (btn) { btn.setAttribute('aria-busy', 'false'); if (txt) txt.textContent = prev; }
      if (e && e.message === 'auth') return; /* modal already opened */
      toast(L('Couldn’t start checkout — please try again.', '无法开始结账——请重试。'));
    });
  }

  document.addEventListener('click', function (e) {
    var sub = e.target.closest ? e.target.closest('[data-act="subscribe"]') : null;
    if (sub) { e.preventDefault(); goCheckout(sub.getAttribute('data-tier'), sub); return; }
    var free = e.target.closest ? e.target.closest('[data-act="free"]') : null;
    if (free) {
      e.preventDefault();
      if (isSignedIn()) { toast(L('You’re already signed in — Free is your current plan.', '你已登录——免费是你当前的方案。')); }
      else if (window.MDXAuth && authEnabled()) { window.MDXAuth.open('signin'); }
      else { toast(L('Sign-in is unavailable right now.', '登录暂时不可用。')); }
    }
  });

  /* reflect signed-in state on the Free card note once auth resolves */
  function reflectPlan() {
    var note = $('#free-note');
    if (note && isSignedIn()) {
      note.innerHTML = '<span class="l-en">You’re signed in on the Free plan.</span><span class="l-zh">你已在免费方案登录。</span>';
    }
  }
  if (window.MDXAuth && window.MDXAuth.onChange) { window.MDXAuth.onChange(reflectPlan); }
  reflectPlan();

  /* ── return-flag banner: ?checkout=success | cancel ── */
  (function () {
    var m = /[?&]checkout=(success|cancel)\b/.exec(location.search);
    if (!m) return;
    var banner = $('#flag-banner'), icon = $('#flag-icon'), text = $('#flag-text'), x = $('#flag-x');
    if (!banner) return;
    if (m[1] === 'success') {
      banner.classList.add('show', 'ok');
      icon.textContent = '🎉';
      /* Hosted Checkout now returns to start.html?checkout=success (app/billing.py),
         so this branch is only reached by a stale bookmark or by a Checkout Session
         that was created BEFORE that change shipped and still carries the old
         success_url baked in (sessions live ~24h). Those users must not be stranded on
         the pricing page: give them the link the old copy only ever talked about. */
      text.textContent = L('You’re in. Your trial is live.', '搞定。试用已开通。');
      var go = document.createElement('a');
      go.href = 'start.html';
      go.className = 'fgo';
      go.textContent = L('Open the dashboard →', '前往仪表盘 →');
      text.parentNode.insertBefore(go, x || null);
    } else {
      banner.classList.add('show', 'cancel');
      icon.textContent = '↩︎';
      text.textContent = L('No charge — checkout was cancelled. Pick a plan whenever you’re ready.',
                           '未扣费——结账已取消。准备好后随时选择方案。');
    }
    if (x) x.addEventListener('click', function () { banner.classList.remove('show'); });
    /* clean the query param so a refresh doesn't re-show the banner */
    try { history.replaceState({}, '', location.pathname + location.hash); } catch (e) {}
  })();

  /* ── billing-portal deep link: ?billing=portal ─────────────────────────
     Every billing email's CTA points here (mockups/support_email/PIN.md §7). Email
     cannot run JS, so the link has to land on a page that finishes the job: signed in,
     we call the authed GET /api/billing/portal and forward to the Stripe portal;
     signed out, we ask for sign-in first and resume the moment auth resolves.
     Fail-soft everywhere — any error leaves the reader on a working pricing page with
     a plain-word line telling them what to do instead.
     The banner is left UNCLASSED for the neutral states: .flag-banner.ok is tinted with
     var(--up), which theme.css flips to red under html[data-lang="zh"] (PIN §1.1) — a
     neutral progress line must not turn red for a Chinese reader. */
  (function () {
    if (!/[?&]billing=portal\b/.test(location.search)) return;
    var banner = $('#flag-banner'), icon = $('#flag-icon'), text = $('#flag-text'), x = $('#flag-x');
    if (!banner) return;
    var launched = false;

    function say(glyph, msg, warn) {
      banner.classList.remove('ok', 'cancel');
      banner.classList.add('show');
      if (warn) banner.classList.add('cancel');
      if (icon) icon.textContent = glyph;
      if (text) text.textContent = msg;
    }
    function clean() {
      try { history.replaceState({}, '', location.pathname + location.hash); } catch (e) {}
    }
    if (x) x.addEventListener('click', function () { banner.classList.remove('show'); });

    function launch() {
      if (launched) return;
      launched = true;
      say('↗', L('Opening your billing portal…', '正在打开账单中心…'), false);
      withAuth({}).then(function (h) {
        if (!h['Authorization']) throw new Error('auth');
        return fetch(API + '/api/billing/portal', { headers: h, credentials: 'include' });
      }).then(function (r) {
        if (r.status === 401) throw new Error('auth');
        if (r.status === 404) throw new Error('nobilling');
        if (!r.ok) throw new Error('http');
        return r.json();
      }).then(function (d) {
        if (!d || !d.url) throw new Error('nourl');
        clean();
        window.location = d.url;
      }).catch(function (e) {
        launched = false;
        clean();
        var m = e && e.message;
        if (m === 'nobilling') {
          say('•', L('No subscription on this account yet — pick a plan below to start one.',
                     '此账户还没有订阅——请在下方选择一个方案。'), false);
        } else if (m === 'auth') {
          say('•', L('Sign in to open your billing portal.', '登录后即可打开账单中心。'), false);
          if (window.MDXAuth && authEnabled()) window.MDXAuth.open('signin');
        } else {
          say('•', L('Couldn’t open the billing portal. Try again in a moment, or write to support@mastermind-x.com.',
                     '暂时无法打开账单中心。请稍后重试，或发邮件至 support@mastermind-x.com。'), true);
        }
      });
    }

    if (isSignedIn()) {
      launch();
    } else {
      say('•', L('Sign in to open your billing portal.', '登录后即可打开账单中心。'), false);
      if (window.MDXAuth && authEnabled()) window.MDXAuth.open('signin');
      /* resume once the session resolves — a cold load often signs in a beat after paint */
      if (window.MDXAuth && window.MDXAuth.onChange) {
        window.MDXAuth.onChange(function () { if (isSignedIn()) launch(); });
      }
    }
  })();
})();
</script>
</body>
</html>
