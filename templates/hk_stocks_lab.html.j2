    {# ── Stale-cross diagnostic (spec §3, HKPL-R10) ── #}
    <div class="stale-cross-box">
      <h3>{{ t('1D Blastoff vs Stale-Cross Diagnostic', '1日起飞 vs 迟滞交叉诊断') }}</h3>
      <p class="stale-cross-note">
        {{ t('The operator hypothesis: names that crossed 1D momentum and immediately ran (the blastoff cohort) should out-perform names that crossed 2D/3D but "based" for ≥5 sessions without running (|return since cross| < 3%). This side-by-side shows forward 21d HSI-excess for both cohorts from the same scoreboard data. Accruing — first read 2026-08-20.', '操作员假设：1日动量交叉后立即上涨（起飞群组）应优于2D/3D交叉后"盘整"≥5节未上涨（|交叉后回报|<3%）的个股。此对比显示两个群组的前向21日恒生超额（来自相同记分板数据）。累积中 — 首次读取2026-08-20。') }}
      </p>
      {% if stale_cross %}
      <div class="diag-grid">
        <div class="diag-col">
          <h4>⚡ {{ t('1D Blastoff cohort', '1日起飞群组') }} (hklab_1d_blastoff)</h4>
          {% set _bl = stale_cross.get('blastoff') if stale_cross else none %}
          {% if _bl %}
          <p style="font-size:12.5px;color:var(--muted);margin:0">
            {{ t('N fires', 'N触发') }}: <b>{{ _bl.get('n_fires', '—') }}</b> ·
            {{ t('Median 21d HSI exc', '中位21日恒生超额') }}: <b class="{{ 'pos' if _bl.get('med_excess21') and _bl.get('med_excess21') > 0 else ('neg' if _bl.get('med_excess21') and _bl.get('med_excess21') < 0 else '') }}">{{ '%+.1f%%'|format(_bl.get('med_excess21', 0) * 100) if _bl.get('med_excess21') is not none else '—' }}</b>
          </p>
          {% else %}
          <p class="stale-cross-empty">{{ t('No data yet — accruing.', '暂无数据 — 累积中。') }}</p>
          {% endif %}
        </div>
        <div class="diag-col">
          <h4>⏱ {{ t('Stale-cross cohort', '迟滞交叉群组') }} (2D/3D ≥5 sess, |ret|&lt;3%)</h4>
          {% set _sc = stale_cross.get('stale_cross') if stale_cross else none %}
          {% if _sc %}
          <p style="font-size:12.5px;color:var(--muted);margin:0">
            {{ t('N fires', 'N触发') }}: <b>{{ _sc.get('n_fires', '—') }}</b> ·
            {{ t('Median 21d HSI exc', '中位21日恒生超额') }}: <b class="{{ 'pos' if _sc.get('med_excess21') and _sc.get('med_excess21') > 0 else ('neg' if _sc.get('med_excess21') and _sc.get('med_excess21') < 0 else '') }}">{{ '%+.1f%%'|format(_sc.get('med_excess21', 0) * 100) if _sc.get('med_excess21') is not none else '—' }}</b>
          </p>
          {% else %}
          <p class="stale-cross-empty">{{ t('No data yet — accruing.', '暂无数据 — 累积中。') }}</p>
          {% endif %}
        </div>
      </div>
      {% else %}
      <p class="stale-cross-empty">{{ t('Diagnostic data not yet available — will populate after the first nightly run.', '诊断数据尚不可用 — 首次夜间运行后填充。') }}</p>
      {% endif %}
    </div>
    {% endif %}
  </section>

