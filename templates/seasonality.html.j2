{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% set ML = ['J','F','M','A','M','J','J','A','S','O','N','D'] %}
{% macro monthbars(stats) -%}
{% set vmax = (stats.values()|map(attribute='mean')|map('abs')|max) or 1 %}
<svg viewBox="0 0 360 100" class="seasbars" preserveAspectRatio="xMidYMid meet">
  <line x1="6" y1="44" x2="354" y2="44" stroke="var(--line)" stroke-width="1"/>
  {% for m in range(1,13) %}
  {% set cx = 6 + (348/12)*(m-0.5) %}
  <rect class="mcol" data-m="{{ m }}" x="{{ (cx-348/24)|round(1) }}" y="2" width="{{ (348/12)|round(1) }}" height="96" fill="var(--text)" opacity="0"></rect>
  {% set s = stats.get(m) %}
  {% if s %}
  {% set h = [(s.mean|abs)/vmax*34, 1.5]|max %}
  {% set up = s.mean >= 0 %}
  <rect x="{{ (cx-7)|round(1) }}" y="{{ (44-h)|round(1) if up else 44 }}" width="14" height="{{ h|round(1) }}" rx="1.5" fill="{{ 'var(--up)' if up else 'var(--down)' }}"><title>{{ ML[m-1] }} · mean {{ '%+.2f'|format(s.mean) }}% · median {{ '%+.2f'|format(s.median) }}% · up {{ s.hit }}% of years (n={{ s.n }})</title></rect>
  {% endif %}
  <text x="{{ cx|round(1) }}" y="94" text-anchor="middle" font-size="8" fill="var(--muted)">{{ ML[m-1] }}</text>
  {% endfor %}
</svg>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Factor seasonality — Ken French monthly factors', '因子季节性 — Ken French 月度因子') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1320px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:13px; margin:0 0 4px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); } .sm { font-size:12px; }
  .navbtn, .lang-btn, .theme-btn, .seg button { font-size:12.5px; padding:5px 11px; border-radius:8px; border:1px solid var(--line); background:var(--panel2); color:var(--text); cursor:pointer; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:300px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:none; }
  .help:hover .tip { display:block; }
  .seg { display:inline-flex; gap:0; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  .seg button { border:0; border-radius:0; background:var(--panel); }
  .seg button.on { background:var(--panel2); color:var(--text); font-weight:600; }
  .cardgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(330px,1fr)); gap:14px; }
  .fcard { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:11px 12px; }
  .fcard h3 { font-size:13px; margin:0 0 6px; display:flex; align-items:center; gap:6px; }
  .fcard .badge { font-size:10.5px; padding:1px 7px; border-radius:8px; background:var(--panel); border:1px solid var(--line); color:var(--muted); }
  .ctx { font-size:10.5px; padding:1px 7px; border-radius:8px; background:transparent; border:1px dashed var(--line); color:var(--muted); }
  .seasbars { width:100%; height:auto; display:block; }
  .seasgrid[data-win="full"] .win-t30 { display:none; }
  .seasgrid[data-win="t30"] .win-full { display:none; }
  .secthead { display:flex; align-items:baseline; gap:10px; margin:4px 0 8px; }
</style>
</head>
<body>
  <div class="panel">
    <div class="topline">
      <h1>🗓 {{ t('Factor seasonality', '因子季节性') }}</h1>
      <span class="muted sm">{{ t('which calendar months each factor STYLE has tended to pay — Ken French, ' ~ seas.factors[0].start ~ '+', '各因子风格在哪些月份历史上更易获得回报 — Ken French，' ~ seas.factors[0].start ~ ' 起') }}</span>
      <span style="flex:1"></span>
      <a class="navbtn" href="macro.html">{{ t('← Dashboard', '← 仪表盘') }}</a>
      <a class="navbtn" href="factors.html">🧮 {{ t('Factor Lab', '因子实验室') }}</a>
      <a class="navbtn" href="baskets.html">🧺 {{ t('Baskets', '主题篮子') }}</a>
      <a class="navbtn" href="methodology.html">📖 {{ t('Methodology', '方法论') }}</a>
      <button class="lang-btn">中文</button>
      <button class="theme-btn">☀️ {{ t('Light', '浅色') }}</button>
    </div>
    <p class="muted sm" style="margin:10px 0 0">{{ t(seas.disclosure_en, seas.disclosure_zh) }}</p>
  </div>

  <div class="panel">
    <div class="secthead">
      <h2 style="margin:0">{{ t('Average return by calendar month', '按日历月份的平均回报') }}
        {{ help('Each bar is that calendar month\'s average factor return across all years (green = positive, red = negative; bar height ∝ magnitude). Hover for mean, median and hit-rate (% of years that month was positive). The current month is shaded. Median + hit-rate sit alongside the mean because a single crisis month can swing a 30-year average.', '每根柱为该月历年平均因子回报（绿=正、红=负；高度∝幅度）。悬停查看均值、中位数与命中率（该月为正的年份比例）。当前月份已高亮。中位数与命中率与均值并列，因为单个危机月可大幅扭曲 30 年均值。') }}
      </h2>
      <span style="flex:1"></span>
      <span class="seg" id="winseg">
        <button data-win="full" class="on">{{ t('Full history', '全历史') }}</button>
        <button data-win="t30">{{ t('Trailing 30y', '近 30 年') }}</button>
      </span>
    </div>
    <div class="cardgrid seasgrid" data-win="full" id="grid">
      {% for f in seas.factors %}
      <div class="fcard">
        <h3>{{ t(f.label_en, f.label_zh) }}
          <span class="badge">{{ t('since', '自') }} {{ f.start }}</span>
          {% if f.context_only %}<span class="ctx">{{ t('reference', '参考') }}</span>{% endif %}
        </h3>
        <div class="win win-full">{{ monthbars(f.full) }}</div>
        <div class="win win-t30">{% if f.trailing_30y %}{{ monthbars(f.trailing_30y) }}{% else %}<p class="muted sm">{{ t('not enough recent history', '近期历史不足') }}</p>{% endif %}</div>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="panel">
    <p class="muted" style="font-size:12px;margin:0">{{ t(
      'Source: ' ~ seas.source ~ ', as of ' ~ seas.as_of ~ '. Factors mapping to one of our live legs (Value→HML, Profitability→RMW, Investment→CMA) are shown first; Momentum, Size and Market are reference styles we do not rank cross-sectionally. Seasonality is descriptive context only and is deliberately kept out of every calibrated score — see LIMITATIONS.md.',
      '来源：' ~ seas.source ~ '，截至 ' ~ seas.as_of ~ '。映射到我们在用因子的（价值→HML、盈利→RMW、投资→CMA）排在前面；动量、规模与市场为我们未做横截面排名的参考风格。季节性仅为描述性背景，刻意不纳入任何校准评分 — 参见 LIMITATIONS.md。') }}
      {{ t('Generated', '生成于') }} {{ built }}</p>
  </div>

  <script>
    (function(){
      var seg=document.getElementById('winseg'), grid=document.getElementById('grid');
      if(seg&&grid) seg.addEventListener('click', function(e){
        var b=e.target.closest('button[data-win]'); if(!b) return;
        grid.setAttribute('data-win', b.dataset.win);
        seg.querySelectorAll('button').forEach(function(x){x.classList.toggle('on', x===b);});
      });
      var cm=new Date().getMonth()+1;
      document.querySelectorAll('.mcol[data-m="'+cm+'"]').forEach(function(e){e.setAttribute('opacity','0.09');});
    })();
  </script>
  <script src="theme.js"></script>
</body>
</html>
