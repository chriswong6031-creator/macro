    <div style="padding:8px 16px;border-radius:9px;background:color-mix(in srgb,{{ impulse_color }} 14%,var(--panel));border:1px solid color-mix(in srgb,{{ impulse_color }} 30%,var(--line))">
      <div style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:2px">{{ t('Policy Impulse', '政策冲量') }}</div>
