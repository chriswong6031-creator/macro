    <table class="mt">
      <tr>
        <th>{{ t('Ticker', '代码') }}</th>
        <th>{{ t('Board', '板块') }}</th>
        <th>{{ t('Event', '事件') }}</th>
        <th class="r">{{ t('Lianban', '连板') }}</th>
        <th class="r">{{ t('vs limit %', '距涨停%') }}</th>
      </tr>
