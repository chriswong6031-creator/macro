{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='', cls='') -%}
<span class="help{% if cls %} {{ cls }}{% endif %}">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('A-Share Market Mechanics', 'A股市场结构') }} — Mastermind</title>
{% set seo_title = 'A-Share Market Mechanics — Participation · Limit · Phase · Policy | Mastermind' %}
{% set seo_desc = 'China A-share market structure cockpit: turnover & margin participation trends, limit-up/down breadth, lianban mechanics, cycle phase memory, policy transmission tape, CGB curve & USDCNH. Context only — never a signal.' %}
{% set seo_path = 'china_mechanics.html' %}
{% include "_seo_head.html.j2" %}
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font: 14px/1.5 -apple-system,
         "Segoe UI", Roboto, Helvetica, sans-serif; margin: 0; padding: 18px; }
  @media (min-width: 1100px) { body { padding: 26px max(40px, calc((100vw - 1500px) / 2)); } }
  html[data-lang="zh"] body { font-family: "PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",-apple-system,sans-serif; }
  a { text-decoration: none; color: var(--link); }
  h1 { font-size: 22px; margin: 0 0 4px; }
  h2 { font-size: 14px; margin: 0 0 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  h3 { font-size: 13px; margin: 0 0 8px; color: var(--muted); text-transform: uppercase; letter-spacing: .055em; }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(12, 1fr); }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 15px 17px; }
  .span12 { grid-column: span 12; } .span8 { grid-column: span 8; }
  .span6 { grid-column: span 6; } .span4 { grid-column: span 4; }
  .span3 { grid-column: span 3; }
  @media (max-width: 900px) { .span8, .span6, .span4, .span3 { grid-column: span 12; } }

  /* ---- help tooltip ---- */
  .help { display: inline-flex; align-items: center; justify-content: center;
          width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--muted);
          color: var(--muted); font-size: 10px; font-weight: 600; cursor: help;
          position: relative; vertical-align: middle; margin-left: 5px; flex: none; }
  .help .tip { display: none; position: absolute; bottom: 150%; left: 50%;
               transform: translateX(-50%); width: 300px;
               background: var(--panel); border: 1px solid var(--line);
               padding: 10px 12px; border-radius: 9px; z-index: 60; font-size: 12px;
               line-height: 1.5; color: var(--text); text-align: left; font-weight: 400;
               text-transform: none; letter-spacing: normal;
               box-shadow: 0 8px 28px rgba(0,0,0,.28); pointer-events: none; white-space: normal; }
  .help:hover .tip { display: block; }
  .help.below .tip { bottom: auto; top: 150%; }

  /* ---- chip row ---- */
  .chip { display: inline-block; padding: 3px 10px; border-radius: 12px; font-weight: 600; font-size: 12px;
          background: color-mix(in srgb, var(--c, var(--muted)) 16%, var(--panel));
          color: color-mix(in srgb, var(--c, var(--muted)) 82%, var(--text)); }
  .c-up { --c: var(--up); } .c-down { --c: var(--down); } .c-warn { --c: var(--warn); }
  .c-info { --c: var(--info); } .c-muted { --c: var(--muted); }
  .chip-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 4px; align-items: center; }

  /* ---- section divider ---- */
  .msec { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }
  .msec.flush { margin-top: 0; padding-top: 0; border-top: none; }

  /* ---- hero stat row ---- */
  .stat-row { display: flex; flex-wrap: wrap; gap: 16px 24px; margin: 10px 0 4px; }
  .stat { display: flex; flex-direction: column; gap: 1px; min-width: 80px; }
  .stat .v { font-size: 18px; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
  .stat .k { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .stat .v.pos { color: var(--up); } .stat .v.neg { color: var(--down); }
  .stat .v.warn { color: var(--warn); }

  /* ---- mini inline chart (canvas) ---- */
  .mini-chart { display: block; width: 100%; height: 70px; border-radius: 6px; margin: 8px 0 4px; }
  .mini-chart-sm { height: 52px; }
  .chart-label { font-size: 10.5px; color: var(--muted); margin-bottom: 2px; }

  /* ---- table ---- */
  table.mt { border-collapse: collapse; width: 100%; font-size: 12px; margin: 8px 0; }
  table.mt th, table.mt td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--line); }
  table.mt th { color: var(--muted); font-weight: 600; }
  table.mt tr:last-child td { border-bottom: none; }
  table.mt .r { text-align: right; }
  .pos { color: var(--up); } .neg { color: var(--down); }

  /* ---- phase strip ---- */
  .phase-strip { display: flex; gap: 2px; flex-wrap: wrap; margin: 8px 0 6px; align-items: flex-end; }
  .ps-cell { height: 22px; min-width: 7px; border-radius: 3px; flex: 1; cursor: default;
             position: relative; opacity: .82; }
  .ps-cell:hover { opacity: 1; }
  .ps-cell .ps-tip { display: none; position: absolute; bottom: 130%; left: 50%;
                     transform: translateX(-50%); white-space: nowrap; font-size: 10px;
                     background: var(--panel); border: 1px solid var(--line);
                     padding: 3px 7px; border-radius: 6px; z-index: 50;
                     pointer-events: none; color: var(--text); }
  .ps-cell:hover .ps-tip { display: block; }

  /* ── phase colour mapping (inline style on each cell) ── */

  /* ---- policy event list ---- */
  .ev-list { list-style: none; padding: 0; margin: 8px 0; display: flex; flex-direction: column; gap: 6px; }
  .ev-item { border-left: 3px solid var(--line); padding: 6px 10px; border-radius: 0 8px 8px 0;
             background: var(--panel2); font-size: 12px; line-height: 1.4; }
  .ev-item.pboc { border-left-color: var(--info); }
  .ev-item.politburo, .ev-item.cewc { border-left-color: var(--warn); }
  .ev-item.csrc, .ev-item.ndrc, .ev-item.mof { border-left-color: var(--up); }
  .ev-meta { font-size: 10.5px; color: var(--muted); margin-top: 2px; }

  /* ---- CGB curve visual ---- */
  .cgb-row { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 8px 0; font-size: 12.5px; }
  .cgb-pt { display: flex; flex-direction: column; gap: 2px; }
  .cgb-pt .ten { font-size: 16px; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
  .cgb-pt .lbl { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }

  /* ---- authority disclaimer ---- */
  .authority-note { font-size: 11px; color: var(--muted); padding: 6px 10px; border-radius: 7px;
                    background: color-mix(in srgb, var(--muted) 8%, var(--panel));
                    border: 1px solid var(--line); margin: 6px 0; line-height: 1.5; }

  /* ---- staleness chip ---- */
  .stale-ok { color: var(--up); }
  .stale-warn { color: var(--warn); }
  .stale-bad { color: var(--down); }

  /* ---- expander (show more / less) ---- */
  .expander { display: none; }
  .expander-toggle { cursor: pointer; color: var(--link); font-size: 12px; font-weight: 600;
                     background: none; border: none; padding: 4px 0; }
  details summary { cursor: pointer; color: var(--link); font-size: 12px; font-weight: 600; list-style: none; }
  details summary::-webkit-details-marker { display: none; }
  details[open] summary span.sh { display: none; }
  details:not([open]) summary span.hd { display: none; }

  /* breadcrumb */
  .breadcrumb { font-size: 12px; color: var(--muted); margin-bottom: 14px; }
  .breadcrumb a { color: var(--link); }

  body.page-china-mechanics { padding-top: 26px; }
</style>
</head>
<body class="page-china-mechanics">

<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search A-shares"
      placeholder="Search any stock — US, China, HK, Canada &amp; more…" data-ph-zh="搜索任意股票 — 美股、A 股、港股、加股等…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="grid">

{# ── HEADER ── #}
<div class="panel span12" id="mech-header">
  <div class="breadcrumb"><a href="china.html">{{ t('China Macro', '中国宏观') }}</a> › {{ t('A-Share Market Mechanics', 'A股市场结构') }}</div>
  <h1>🔬 {{ t('A-Share Market Mechanics', 'A股市场结构') }}</h1>
  <p style="color:var(--muted);font-size:13px;margin:4px 0 0;line-height:1.55">
    {{ t('Participation regime · limit-up/down breadth · cycle phase memory · policy tape · cross-market. Context only — no signal, no origination (CN-SYS-R1).', '参与度制度 · 涨/跌停板广度 · 周期阶段记忆 · 政策磁带 · 跨市场。仅供背景参考 — 无信号，不产生状态（CN-SYS-R1）。') }}
    {{ t('As of', '截至') }} {{ as_of or '—' }}.
    {{ help('Context-only cockpit. All panels are descriptive; none score, rank, size or originate state (CN-SYS-R1, R13, R14). Data gaps are disclosed where they exist (CN-SYS-R4).', '仅供参考的驾驶舱。所有面板均为描述性；不评分、排名、定仓或产生状态（CN-SYS-R1、R13、R14）。数据缺口在存在处予以披露（CN-SYS-R4）。') }}
  </p>
  <div class="authority-note">
    {{ t('DISPLAY ONLY — authority: context_only. Cannot rank, size, gate or originate signals. LLM surfaces are never fed into this page (CN-SYS-R14).', '仅供展示 — 权限：context_only。不能排名、定仓、设门控或产生信号。LLM输出从不进入本页（CN-SYS-R14）。') }}
  </div>
</div>

{# ══════════════════════════════════════════════════════════════════════════════
   PANEL (a): PARTICIPATION
══════════════════════════════════════════════════════════════════════════════ #}
<div class="panel span12" id="mech-participation">
  <h2>{{ t('Participation', '参与度') }}
    {{ help('Turnover z-score (20d / 60d) measures whether trading volume is above or below its recent history. Margin balance (融资余额) tracks leveraged positioning. Southbound flow (南向资金) is the HK→A-share flow. These are context/confluence factors: SLF-051 ruled out margin impulse as a standalone signal; here they are legal at context tier (CN-SYS-R2).', '成交额Z分数（20日/60日）衡量成交量是否高于或低于近期历史。融资余额跟踪杠杆持仓。南向资金为港股→A股资金流向。这些为背景/合流因素：SLF-051 排除了融资冲量作为独立信号；在此它们在背景层合法（CN-SYS-R2）。') }}
  </h2>
  {% set lp = participation %}
  {% set lpl = lp.get('latest') or {} %}

  {# status chips #}
  <div class="chip-row">
    {% set regime = lpl.get('regime') or '—' %}
    {% set who = lpl.get('who_controls') or '—' %}
    {% set risk = lpl.get('risk') or '—' %}
    <span class="chip {{ 'c-up' if regime in ('retail_ignition','margin_acceleration','broad_mania') else ('c-down' if regime in ('forced_deleveraging','distribution') else ('c-warn' if regime == 'unclear' else 'c-muted')) }}">{{ t(regime.replace('_',' ').title(), tr(regime.replace('_',' ').title())) }}</span>
    <span class="chip c-info">{{ t('who controls: ' + who, '控盘方：' + tr(who.replace('_',' '))) }}</span>
    <span class="chip {{ 'c-down' if risk in ('frothy','fire_sale') else ('c-warn' if risk == 'normal' else 'c-up') }}">{{ t('risk: ' + risk, '风险：' + tr(risk)) }}</span>
    {% if lpl.get('as_of') or lp.get('as_of') %}<span style="font-size:11px;color:var(--muted)">{{ t('as of', '截至') }} {{ lpl.get('as_of') or lp.get('as_of') }}</span>{% endif %}
  </div>

  {# stat row #}
  <div class="stat-row">
    {% set tz20 = lpl.get('turnover_z20') %}
    <div class="stat">
      <span class="v {{ 'pos' if tz20 is not none and tz20 > 0.5 else ('neg' if tz20 is not none and tz20 < -0.5 else '') }}">{{ ('%.2f'|format(tz20)) if tz20 is not none else '—' }}</span>
      <span class="k">{{ t('Turnover z20', '成交额z20') }}</span>
    </div>
    {% set tz60 = lpl.get('turnover_z60') %}
    <div class="stat">
      <span class="v {{ 'pos' if tz60 is not none and tz60 > 0.5 else ('neg' if tz60 is not none and tz60 < -0.5 else '') }}">{{ ('%.2f'|format(tz60)) if tz60 is not none else '—' }}</span>
      <span class="k">{{ t('Turnover z60', '成交额z60') }}</span>
    </div>
    {% set mb = lpl.get('margin_balance') %}
    <div class="stat">
      <span class="v">{{ ('%.0f'|format(mb / 100)) if mb is not none else '—' }}</span>
      <span class="k">{{ t('Margin (亿¥)', '融资余额（亿¥）') }}</span>
    </div>
    {% set mc = lpl.get('margin_chg_5d') %}
    <div class="stat">
      <span class="v {{ 'pos' if mc is not none and mc > 0 else ('neg' if mc is not none and mc < 0 else '') }}">{{ ('%+.2f%%'|format(mc)) if mc is not none else '—' }}</span>
      <span class="k">{{ t('Margin 5d chg', '融资5日变化') }}</span>
    </div>
    {% set sz = lpl.get('southbound_z') %}
    <div class="stat">
      <span class="v {{ 'pos' if sz is not none and sz > 0.5 else ('neg' if sz is not none and sz < -0.5 else '') }}">{{ ('%.2f'|format(sz)) if sz is not none else '—' }}</span>
      <span class="k">{{ t('Southbound z', '南向资金z') }}</span>
    </div>
    {% set qvix = lpl.get('qvix') %}
    <div class="stat">
      <span class="v {{ 'warn' if qvix is not none and qvix > 25 else '' }}">{{ ('%.1f'|format(qvix)) if qvix is not none else '—' }}</span>
      <span class="k">{{ t('QVIX', 'QVIX 恐慌') }}</span>
    </div>
  </div>

  {# charts — rendered via inline JS reading embedded JSON #}
  {% if lp.get('turnover_z20') %}
  <div class="chart-label">{{ t('Turnover z-score (20d) — last 120 sessions', '成交额Z分数（20日）— 近120个交易日') }}</div>
  <canvas class="mini-chart" id="chart-tz20" data-series="{{ lp.turnover_z20 | tojson }}" data-zero="1" data-color-pos="{{ 'var(--up)' }}" data-color-neg="{{ 'var(--down)' }}"></canvas>
  {% endif %}

  {% if lp.get('southbound_z') %}
  <div class="chart-label">{{ t('Southbound flow z-score — last 120 sessions', '南向资金Z分数 — 近120个交易日') }}</div>
  <canvas class="mini-chart mini-chart-sm" id="chart-sbz" data-series="{{ lp.southbound_z | tojson }}" data-zero="1" data-color-pos="{{ 'var(--info)' }}" data-color-neg="{{ 'var(--muted)' }}"></canvas>
  {% endif %}

  {% if lp.get('margin_balance') %}
  <div class="chart-label">{{ t('Margin balance (融资余额) — last 120 sessions', '融资余额 — 近120个交易日') }}</div>
  <canvas class="mini-chart mini-chart-sm" id="chart-mb" data-series="{{ lp.margin_balance | tojson }}" data-color-pos="{{ 'var(--warn)' }}"></canvas>
  {% endif %}

  {# contradictions #}
  {% set contradictions = lpl.get('contradictions') or [] %}
  {% if contradictions %}
  <div class="msec">
    <h3>{{ t('Contradictions', '矛盾点') }}</h3>
    {% for c in contradictions %}
    <div style="font-size:12px;line-height:1.5;padding:6px 10px;border-radius:8px;border:1px solid var(--line);background:var(--panel2);margin-bottom:5px">
      <b>{{ c.a }}</b> {{ t('vs', '对比') }} <b>{{ c.b }}</b>
      {% if c.detail %}<div style="color:var(--muted);margin-top:2px">{{ c.detail }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# data gaps #}
  {% set pg_gaps = lpl.get('data_gaps') or [] %}
  {% if pg_gaps %}
  <details style="margin-top:10px">
    <summary><span class="sh">{{ t('Show data gaps', '显示数据缺口') }}</span><span class="hd">{{ t('Hide data gaps', '收起数据缺口') }}</span></summary>
    <ul style="font-size:11px;color:var(--muted);margin:6px 0 0;padding-left:16px;line-height:1.6">
      {% for g in pg_gaps %}<li>{{ g }}</li>{% endfor %}
    </ul>
  </details>
  {% endif %}
</div>

{# ══════════════════════════════════════════════════════════════════════════════
   PANEL (b): LIMIT MECHANICS
══════════════════════════════════════════════════════════════════════════════ #}
<div class="panel span12" id="mech-limits">
  <h2>{{ t('Limit Mechanics', '涨跌停板机制') }}
    {{ help('CN-SYS-R3: Limit-up/down data is market-structure context only. BUY-direction use is forbidden (standing kill). Lianban (连板) = consecutive limit-up sessions. Failed-seal ratio = names that touched limit-up but closed below it. Board width rules: Main 10%; STAR/ChiNext 20% (from 2019/2020); BSE 30%; ST names 5% on Main boards.', 'CN-SYS-R3：涨/跌停板数据仅作市场结构背景，禁止用于买入方向（已裁定禁止）。连板 = 连续涨停。未封板比率 = 触及涨停但收盘低于涨停价的个股。板块宽度规则：主板10%；科创板/创业板20%（自2019/2020年起）；北交所30%；ST股主板5%。') }}
  </h2>
  {% set lm = limits %}
  {% set la = lm.get('latest_agg') or {} %}

  {# stat row #}
  <div class="stat-row">
    <div class="stat">
      <span class="v pos">{{ la.get('limit_up_count', '—') }}</span>
      <span class="k">{{ t('Limit-ups (涨停)', '涨停数') }}</span>
    </div>
    <div class="stat">
      <span class="v neg">{{ la.get('limit_down_count', '—') }}</span>
      <span class="k">{{ t('Limit-downs (跌停)', '跌停数') }}</span>
    </div>
    <div class="stat">
      <span class="v">{{ la.get('sealed_up_close', '—') }}</span>
      <span class="k">{{ t('Sealed at close', '收盘封板') }}</span>
    </div>
    <div class="stat">
      <span class="v warn">{{ la.get('failed_up_seal_count', '—') }}</span>
      <span class="k">{{ t('Failed seals', '开板数') }}</span>
    </div>
    <div class="stat">
      <span class="v">{{ la.get('lianban_2plus', '—') }}</span>
      <span class="k">{{ t('Lianban ≥2 (连板)', '连板≥2') }}</span>
    </div>
    <div class="stat">
      <span class="v">{{ la.get('lianban_max', '—') }}</span>
      <span class="k">{{ t('Max lianban (连板最高)', '最高连板数') }}</span>
    </div>
  </div>

  {# breadth chart #}
  {% if lm.get('lup_series') %}
  <div class="chart-label">{{ t('Limit-up breadth (% universe, 120 sessions)', '涨停板广度（占比，120个交易日）') }}</div>
  <canvas class="mini-chart" id="chart-lup" data-series="{{ lm.lup_series | tojson }}" data-color-pos="{{ 'var(--up)' }}"></canvas>
  {% endif %}
  {% if lm.get('ldn_series') %}
  <div class="chart-label">{{ t('Limit-down breadth (% universe, 120 sessions)', '跌停板广度（占比，120个交易日）') }}</div>
  <canvas class="mini-chart mini-chart-sm" id="chart-ldn" data-series="{{ lm.ldn_series | tojson }}" data-color-pos="{{ 'var(--down)' }}"></canvas>
  {% endif %}
  {% if lm.get('fsr_series') %}
  <div class="chart-label">{{ t('Failed-seal ratio (open ÷ limit-up, 120 sessions)', '未封板比率（开板数÷涨停数，120个交易日）') }}</div>
  <canvas class="mini-chart mini-chart-sm" id="chart-fsr" data-series="{{ lm.fsr_series | tojson }}" data-color-pos="{{ 'var(--warn)' }}"></canvas>
  {% endif %}
  {% if lm.get('lianban_series') %}
  <div class="chart-label">{{ t('Consecutive limit-up names (≥2 lianban, 120 sessions)', '连板个数（≥2连板，120个交易日）') }}</div>
  <canvas class="mini-chart mini-chart-sm" id="chart-lianban" data-series="{{ lm.lianban_series | tojson }}" data-color-pos="{{ 'var(--info)' }}"></canvas>
  {% endif %}

  {# today's notable events table #}
  {% if lm.get('latest_events') %}
  <div class="msec">
    <h3>{{ t('Notable limit events — latest session', '今日涨跌停事件') }}
