        <td><a href="china_lookup.html#{{ ev.ticker }}">{{ ev.ticker }}</a></td>
        <td>{{ ev.board }}</td>
        <td><span style="font-size:10.5px;padding:1px 6px;border-radius:6px;
          background:color-mix(in srgb,{{ 'var(--up)' if 'up' in ev.event else 'var(--down)' }} 14%,var(--panel));
          color:{{ 'var(--up)' if 'up' in ev.event else 'var(--down)' }}">{{ ev.event }}</span></td>
        <td class="r">{{ ev.lianban_count if ev.lianban_count else '—' }}</td>
        <td class="r {{ 'neg' if ev.close_off_limit_pct is not none and ev.close_off_limit_pct < -0.005 else '' }}">
          {{ ('%.2f%%'|format(ev.close_off_limit_pct * 100)) if ev.close_off_limit_pct is not none else '—' }}</td>
      </tr>
      {% endfor %}
    </table>
    {% if lm.latest_events | length > 15 %}<p style="font-size:11px;color:var(--muted)">… {{ lm.latest_events | length - 15 }} {{ t('more', '条更多') }}</p>{% endif %}
  </div>
  {% endif %}

  <p class="authority-note" style="margin-top:10px">{{ t('CN-SYS-R3: this panel is market-structure context only. Limit-up as a BUY trigger is a standing kill.', 'CN-SYS-R3：本面板仅作市场结构背景。以涨停作为买入触发器已被永久禁止。') }}</p>
</div>

{# ══════════════════════════════════════════════════════════════════════════════
   PANEL (c): PHASE MEMORY
══════════════════════════════════════════════════════════════════════════════ #}
<div class="panel span12" id="mech-phase">
  <h2>{{ t('Cycle Phase Memory', '周期阶段记忆') }}
    {{ help('Current phase classification with confidence, falsifiers, and a 90-session strip of historical phase assignments. ERA table covers known historical market cycles 2005→. Falsifier ledger: pre-committed conditions that, if they fire within their horizon, would contradict the current phase call. Accruing since phase-tape build start; not a calibration study (CN-SYS-R5).', '当前阶段分类（含置信度）、证伪条件，以及90个交易日的历史阶段分配图条。ERA表格涵盖2005年至今已知历史市场周期。证伪台账：预先提交的条件，若在期限内触发，将与当前阶段判断相矛盾。自阶段磁带开始积累以来持续累积；非校准研究（CN-SYS-R5）。') }}
  </h2>
  {% set ph = phase %}
  {% set cp = ph.get('current') or {} %}

  {# current phase card #}
  {% set phase_name = cp.get('phase') or '—' %}
  {% set conf = cp.get('confidence') %}
  <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-start;margin:8px 0 12px">
    <div style="padding:10px 18px;border-radius:10px;background:color-mix(in srgb,var(--info) 14%,var(--panel));border:1px solid color-mix(in srgb,var(--info) 30%,var(--line))">
      <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px">{{ t('Current Phase', '当前阶段') }}</div>
      <div style="font-size:20px;font-weight:800;color:var(--text)">{{ phase_name }}</div>
      {% if conf is not none %}<div style="font-size:12px;color:var(--muted);margin-top:2px">{{ t('confidence', '置信度') }} {{ ('%.0f'|format(conf * 100)) }}%</div>{% endif %}
      {% if cp.get('asof') %}<div style="font-size:10.5px;color:var(--muted)">{{ t('as of', '截至') }} {{ cp.asof }}</div>{% endif %}
    </div>
    {% if cp.get('evidence') %}
    <div style="flex:1;min-width:200px">
      <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px">{{ t('Evidence', '证据') }}</div>
      {% for e in cp.evidence %}<div style="font-size:12px;margin-bottom:3px;color:var(--text)">· {{ e }}</div>{% endfor %}
    </div>
    {% endif %}
  </div>

  {# falsifiers #}
  {% set falsifiers = cp.get('falsifiers') or [] %}
  {% if falsifiers %}
  <div class="msec">
    <h3>{{ t('Armed falsifiers', '已激活证伪条件') }}
      {{ help('Falsifiers are pre-committed machine-checkable conditions. If one fires within its horizon, the current phase call was wrong. The ledger grades them nightly (CN-SYS-R5). They are not a signal — they are the evidence standard.', '证伪条件是预先提交的机器可检查条件。若在期限内触发，则当前阶段判断有误。台账每夜进行评分（CN-SYS-R5）。它们不是信号，而是证据标准。') }}
    </h3>
    {% set n_falsifiers = falsifiers | length %}
    <div style="font-size:12px;color:var(--muted);margin-bottom:8px">{{ n_falsifiers }} {{ t('falsifiers armed — auto-graded nightly', '个证伪条件已激活 — 每夜自动评分') }}</div>
    {% for f in falsifiers %}
    <div style="display:flex;gap:8px;align-items:baseline;padding:5px 9px;border-radius:7px;background:var(--panel2);border:1px solid var(--line);margin-bottom:4px;font-size:12px">
      <span style="font-family:monospace;color:var(--info);flex-shrink:0">{{ f.id }}</span>
      <code style="flex:1;font-size:11px;color:var(--text);background:none">{{ f.expr }}</code>
      <span style="color:var(--muted);white-space:nowrap">{{ f.horizon_d }}{{ t('d', '天') }}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# 90-session phase strip #}
  {% set strip = ph.get('phase_strip') or [] %}
  {% if strip %}
  <div class="msec">
    <h3>{{ t('90-session phase strip', '90个交易日阶段图条') }}</h3>
    <div class="phase-strip" id="phase-strip-cells" data-strip="{{ strip | tojson }}"></div>
    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;font-size:10.5px">
      {% for ph_name, ph_color in [
        ('POLICY_PUT','#5b9bf0'),('LIQUIDITY_IGNITION','#45b873'),('BROADENING','#3da564'),
        ('THEME_LEADERSHIP','#e08b45'),('EUPHORIA','#e06464'),('DISTRIBUTION','#e07070'),
        ('DELEVERAGING','#c04040'),('CAPITULATION','#8b93a1'),('GRINDING_BEAR','#a07070'),
        ('REPAIR','#7aa7e0')
      ] %}
      <span style="display:flex;align-items:center;gap:3px;color:var(--muted)">
        <span style="width:10px;height:10px;border-radius:2px;background:{{ ph_color }};display:inline-block"></span>
        {{ ph_name.replace('_',' ') }}
      </span>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {# falsifier ledger stats #}
  {% set ls = ph.get('ledger_summary') or {} %}
  {% if ls %}
  <div class="msec">
    <h3>{{ t('Falsifier ledger', '证伪台账') }}</h3>
    <div class="stat-row">
      <div class="stat">
        <span class="v pos">{{ ls.get('held', 0) }}</span>
        <span class="k">{{ t('Held (phase correct)', '持守（阶段正确）') }}</span>
      </div>
      <div class="stat">
        <span class="v neg">{{ ls.get('fired', 0) }}</span>
        <span class="k">{{ t('Fired (phase contradicted)', '触发（阶段被证伪）') }}</span>
      </div>
      <div class="stat">
        <span class="v">{{ ls.get('total_graded', 0) }}</span>
        <span class="k">{{ t('Total graded', '总评分') }}</span>
      </div>
    </div>
    <p style="font-size:11px;color:var(--muted);margin:6px 0 0">{{ t('Accruing since tape launch. Not a calibrated study — come-back clock 2026-10-08 (90d minimum). CN-SYS-R5.', '自磁带启动后持续积累。非校准研究 — 复查时钟 2026-10-08（最少90天）。CN-SYS-R5。') }}</p>
  </div>
  {% endif %}

  {# ERA analog table #}
  {% set eras = ph.get('era_table') or [] %}
  {% if eras %}
  <div class="msec">
    <h3>{{ t('Historical ERA table', '历史ERA对照表') }}
      {{ help('Known A-share market cycle eras since 2005. Each ERA is annotated with the phases it passed through and a brief historical note. Descriptive only — analog matching is a display-only read from the analogs engine (site/china_intel/analogs.json). No forward projection.', '2005年以来已知的A股市场周期时代。每个ERA标注了其经历的阶段和简短历史注释。仅为描述性 — 历史类比为来自类比引擎的展示性读取（site/china_intel/analogs.json）。无前瞻预测。') }}
    </h3>
    <details>
      <summary><span class="sh">{{ t('Show ERA table (', '展开ERA表（') }}{{ eras | length }}{{ t(' eras)', '个时代）') }}</span><span class="hd">{{ t('Collapse', '收起') }}</span></summary>
      <table class="mt" style="margin-top:8px">
        <tr>
          <th>{{ t('ERA', '时代') }}</th>
          <th>{{ t('Period', '时期') }}</th>
          <th>{{ t('Phases', '阶段') }}</th>
          <th>{{ t('Note', '注释') }}</th>
        </tr>
        {% for era in eras %}
        <tr>
          <td style="font-size:11px;white-space:nowrap">{{ era.era.replace('_',' ') }}</td>
          <td style="font-size:11px;white-space:nowrap">{{ era.start[:7] }} → {{ era.end[:7] }}</td>
          <td style="font-size:10.5px">{{ era.phases | join(' → ') }}</td>
          <td style="font-size:11px;color:var(--muted)">{{ era.note }}</td>
        </tr>
        {% endfor %}
      </table>
    </details>
    <p style="margin-top:8px;font-size:12px">
      <a href="china_intel.html">{{ t('→ Full analog readout in Intelligence Hub', '→ 情报中心完整类比读取') }}</a>
    </p>
  </div>
  {% endif %}
</div>

