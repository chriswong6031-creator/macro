<!-- JSON data blocks — unique per-page, feeds mechJSON() in JS below -->
<!-- turnover/margin/southbound/qvix/limits/events/policy are placed inline within each section above -->
<!-- these blocks are for data not yet covered by per-section embeds -->
<script type="application/json" id="mechData-currentPhase">{{ {'key': phase_name, 'color': phase_color, 'conf': conf_val} | tojson }}</script>
<script type="application/json" id="mechData-cgbCurve">{{ cross_market.get('cgb_curve') | tojson }}</script>

<script>
// ═══════════════════════════════════════════════════
// mechJSON helper — reads embedded JSON blocks safely
// ═══════════════════════════════════════════════════
function mechJSON(id){
  var el = document.getElementById(id);
  if(!el) return null;
  try{ return JSON.parse(el.textContent); }
  catch(e){ return null; }
}

// theme-aware color read — so canvas/SVG (which can't use CSS vars) recolor
// correctly in light theme instead of hardcoding dark literals.
function cssv(name, fallback){
  try{ var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim(); return v || fallback; }
  catch(e){ return fallback; }
}
// current UI language, for canvas text that can't use the l-en/l-zh spans.
function curLang(){ return (document.documentElement.getAttribute('data-lang') === 'zh') ? 'zh' : 'en'; }

// ═══════════════════════════════════════════════════
// DATA (from JSON script blocks — no inline data)
// ═══════════════════════════════════════════════════
var TURNOVER_Z20 = mechJSON('mechData-turnoverZ20') || [];

var MARGIN_BAL = mechJSON('mechData-marginBalance') || [];

var SOUTHBOUND_Z = mechJSON('mechData-southboundZ') || [];

var QVIX = mechJSON('mechData-qvix') || [];

var LUP_RAW = mechJSON('mechData-lupSeries') || [];

var LDN_RAW = mechJSON('mechData-ldnSeries') || [];

var EVENTS = mechJSON('mechData-latestEvents') || [];

var PHASE_STRIP = mechJSON('mechData-phaseStrip') || [];
var ERA_TABLE = mechJSON('mechData-eraTable') || [];
var POLICY_EVENTS = mechJSON('mechData-policyEvents') || [];

// bilingual phase-name lookup (key -> {en, zh}) from the catalog
var PHASE_META = {};
(mechJSON('mechData-phaseCatalog') || []).forEach(function(p){ PHASE_META[p.key] = {en:p.name_en, zh:p.name_zh}; });
function phaseName(key){ var m = PHASE_META[key]; if(!m) return (key||'').replace(/_/g,' '); return curLang()==='zh' ? m.zh : m.en; }

// ═══════════════════════════════════════════════════
// PHASE COLORS
// ═══════════════════════════════════════════════════
const PHASE_COLORS = {
  REPAIR:'#7aa7e0',
  POLICY_PUT:'#5b9bf0',
  LIQUIDITY_IGNITION:'#45b873',
  BROADENING:'#3da564',
  THEME_LEADERSHIP:'#e08b45',
  EUPHORIA:'#e06464',
  DISTRIBUTION:'#e07070',
  DELEVERAGING:'#c04040',
  CAPITULATION:'#8b93a1',
  GRINDING_BEAR:'#a07070',
};

// ═══════════════════════════════════════════════════
// CYCLE WHEEL SVG
// ═══════════════════════════════════════════════════
function drawCycleWheel(){
  const svg = document.getElementById('cycleWheelSvg');
  const phases = [
    {id:'REPAIR',label:'REPAIR',zh:'修复'},
    {id:'POLICY_PUT',label:'POLICY PUT',zh:'政策底'},
    {id:'LIQUIDITY_IGNITION',label:'LIQUIDITY IGNITION',zh:'流动性点火'},
    {id:'BROADENING',label:'BROADENING',zh:'全面扩散'},
    {id:'THEME_LEADERSHIP',label:'THEME LEADERSHIP',zh:'主题引领'},
    {id:'EUPHORIA',label:'EUPHORIA',zh:'狂热'},
    {id:'DISTRIBUTION',label:'DISTRIBUTION',zh:'派发'},
    {id:'DELEVERAGING',label:'DELEVERAGING',zh:'去杠杆'},
    {id:'CAPITULATION',label:'CAPITULATION',zh:'恐慌抛售'},
    {id:'GRINDING_BEAR',label:'GRINDING BEAR',zh:'慢熊'},
  ];
  const cx=130, cy=130, r_outer=116, r_inner=72, n=phases.length;
  const gap = 0.025; // radians gap between segments
  var _cp = mechJSON('mechData-currentPhase') || {};
  const current = _cp.key || 'REPAIR';
  const currentColor = _cp.color || PHASE_COLORS[current] || '#7aa7e0';
  const currentConf = _cp.conf || 0;

  let html = `
    <defs>
      <filter id="glow"><feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
      <radialGradient id="centerGrad" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="${currentColor}" stop-opacity="0.12"/>
        <stop offset="100%" stop-color="${currentColor}" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <circle cx="${cx}" cy="${cy}" r="${r_inner-2}" fill="url(#centerGrad)" />
    <circle cx="${cx}" cy="${cy}" r="${r_inner-2}" fill="none" stroke="rgba(91,155,240,0.15)" stroke-width="1"/>
  `;

  for(let i=0;i<n;i++){
    const ph = phases[i];
    const startAngle = (i/n) * 2*Math.PI - Math.PI/2 + gap/2;
    const endAngle = ((i+1)/n) * 2*Math.PI - Math.PI/2 - gap/2;
    const isCurrent = ph.id === current;
    const color = PHASE_COLORS[ph.id];

    // segment path
    const x1o = cx + r_outer * Math.cos(startAngle);
    const y1o = cy + r_outer * Math.sin(startAngle);
    const x2o = cx + r_outer * Math.cos(endAngle);
    const y2o = cy + r_outer * Math.sin(endAngle);
    const x1i = cx + r_inner * Math.cos(endAngle);
    const y1i = cy + r_inner * Math.sin(endAngle);
    const x2i = cx + r_inner * Math.cos(startAngle);
    const y2i = cy + r_inner * Math.sin(startAngle);

    const d = `M ${x1o} ${y1o} A ${r_outer} ${r_outer} 0 0 1 ${x2o} ${y2o} L ${x1i} ${y1i} A ${r_inner} ${r_inner} 0 0 0 ${x2i} ${y2i} Z`;

    const opacity = isCurrent ? 1 : 0.22;
    const strokeW = isCurrent ? 2.5 : 0.5;
    const strokeC = isCurrent ? color : cssv('--line', '#2a2f3a');
    const filter = isCurrent ? 'url(#glow)' : '';

    html += `<path d="${d}" fill="${color}" fill-opacity="${opacity}" stroke="${strokeC}" stroke-width="${strokeW}" ${filter ? `filter="${filter}"` : ''}/>`;

    // Outer tick labels for all segments
    const midAngle = (startAngle + endAngle) / 2;
    const r_tick = r_outer + 14;
    const tx = cx + r_tick * Math.cos(midAngle);
    const ty = cy + r_tick * Math.sin(midAngle);
    // Short 2-char number indicator (phase number 1-10)
    const tickOpacity = isCurrent ? 1 : 0.35;
    html += `<circle cx="${cx + (r_outer+5)*Math.cos(midAngle)}" cy="${cy + (r_outer+5)*Math.sin(midAngle)}" r="${isCurrent?4:2}" fill="${color}" fill-opacity="${tickOpacity}"/>`;
  }

  // current phase extra outer accent arc
  const cp_idx = phases.findIndex(p => p.id === current);
  if(cp_idx >= 0){
    const startA = (cp_idx/n)*2*Math.PI - Math.PI/2 + gap/2;
    const endA = ((cp_idx+1)/n)*2*Math.PI - Math.PI/2 - gap/2;
    const ox1 = cx + (r_outer+10)*Math.cos(startA), oy1 = cy + (r_outer+10)*Math.sin(startA);
    const ox2 = cx + (r_outer+10)*Math.cos(endA), oy2 = cy + (r_outer+10)*Math.sin(endA);
    const oa = `M ${ox1} ${oy1} A ${r_outer+10} ${r_outer+10} 0 0 1 ${ox2} ${oy2}`;
    html += `<path d="${oa}" fill="none" stroke="${currentColor}" stroke-width="3" stroke-linecap="round" filter="url(#glow)" opacity="0.8"/>`;
  }

  // Clockwise arrow hint
  html += `<path d="M ${cx+r_inner-5} ${cy-5} A ${r_inner-5} ${r_inner-5} 0 0 1 ${cx+5} ${cy-r_inner+5}" fill="none" stroke="rgba(139,147,161,0.25)" stroke-width="1" stroke-dasharray="3,3" marker-end="url(#arr)"/>`;

  // center text — phase name + confidence
  const curPhase = phases.find(p => p.id === current) || {label: current, zh: current};
  const labelParts = curPhase.label.split(' ');
  if(labelParts.length > 1){
    html += `<text x="${cx}" y="${cy-14}" text-anchor="middle" fill="${currentColor}" font-size="13" font-weight="800" font-family="-apple-system,sans-serif" letter-spacing="0.5">${labelParts[0]}</text>`;
    html += `<text x="${cx}" y="${cy+4}" text-anchor="middle" fill="${currentColor}" font-size="13" font-weight="800" font-family="-apple-system,sans-serif" letter-spacing="0.5">${labelParts.slice(1).join(' ')}</text>`;
  } else {
    html += `<text x="${cx}" y="${cy-4}" text-anchor="middle" fill="${currentColor}" font-size="12" font-weight="800" font-family="-apple-system,sans-serif" letter-spacing="0.5">${curPhase.label}</text>`;
  }
  html += `<text x="${cx}" y="${cy+20}" text-anchor="middle" fill="#8b93a1" font-size="9" font-family="-apple-system,sans-serif">${curPhase.zh}</text>`;
  html += `<text x="${cx}" y="${cy+33}" text-anchor="middle" fill="${currentColor}99" font-size="8.5" font-family="-apple-system,sans-serif">conf. ${Math.round(currentConf*100)}%</text>`;

  svg.innerHTML = html;
}

// ═══════════════════════════════════════════════════
// SPARKLINES (Canvas)
// ═══════════════════════════════════════════════════
function drawSparkline(canvasId, data, colorUp, colorDown, baseColor){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const w = canvas.offsetWidth || canvas.parentElement.offsetWidth || 200;
  const h = 48;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);

  // series arrive as [{d,v}, …]; reduce to the numeric value (keep null gaps)
  data = data.map(p => (p && typeof p === 'object') ? p.v : p);
  const valid = data.filter(v => v !== null && v !== undefined && !isNaN(v));
  if(!valid.length) return;
  const mn = Math.min(...valid);
  const mx = Math.max(...valid);
  const rng = mx - mn || 1;
  const pad = 3;

  const pts = [];
  let xi = 0;
  for(let i=0;i<data.length;i++){
    if(data[i] === null || data[i] === undefined){xi++;continue;}
    const x = pad + (i/(data.length-1)) * (w-pad*2);
    const y = pad + (1 - (data[i]-mn)/rng) * (h-pad*2);
    pts.push({x,y,v:data[i]});
  }
  if(pts.length < 2) return;

  // fill gradient
  const lastV = pts[pts.length-1].v;
  const refColor = lastV >= 0 ? colorUp : colorDown;
  const grad = ctx.createLinearGradient(0,0,0,h);
  grad.addColorStop(0, refColor + '40');
  grad.addColorStop(1, refColor + '00');

  ctx.beginPath();
  ctx.moveTo(pts[0].x, h);
  ctx.lineTo(pts[0].x, pts[0].y);
  for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y);
  ctx.lineTo(pts[pts.length-1].x, h);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();

  // line
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y);
  ctx.strokeStyle = refColor;
  ctx.lineWidth = 1.5;
  ctx.lineJoin = 'round';
  ctx.lineCap = 'round';
  ctx.stroke();

  // zero line if applicable
  if(mn < 0 && mx > 0){
    const zy = pad + (1 - (0-mn)/rng)*(h-pad*2);
    ctx.beginPath();
    ctx.moveTo(0, zy);
    ctx.lineTo(w, zy);
    ctx.strokeStyle = cssv('--line', '#2a2f3a');
    ctx.lineWidth = 0.5;
    ctx.stroke();
  }

  // dot at end
  const last = pts[pts.length-1];
  ctx.beginPath();
  ctx.arc(last.x, last.y, 2.5, 0, Math.PI*2);
  ctx.fillStyle = refColor;
  ctx.fill();
}

function drawLimitsChart(canvasId, lupData, ldnData){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const w = canvas.offsetWidth || canvas.parentElement.offsetWidth || 300;
  const h = 80;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);

  // series arrive as [{d,v}, …]; reduce to numeric values (keep null gaps)
  lupData = lupData.map(p => (p && typeof p === 'object') ? p.v : p);
  ldnData = ldnData.map(p => (p && typeof p === 'object') ? p.v : p);
  const n = lupData.length;
  const pad = 4;
  const allV = [...lupData,...ldnData].filter(v=>v!==null && v!==undefined && !isNaN(v));
  const mn = 0, mx = Math.max(...allV, 0.1);
  const rng = mx - mn;

  const plotPts = (data, color) => {
    const pts = data.map((v,i) => ({
      x: pad + (i/(n-1))*(w-pad*2),
      y: v===null ? null : pad + (1 - (v-mn)/rng)*(h-pad*2)
    }));
    ctx.beginPath();
    let started = false;
    for(const p of pts){
      if(p.y===null){started=false;continue;}
      if(!started){ctx.moveTo(p.x,p.y);started=true;}
      else ctx.lineTo(p.x,p.y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    ctx.stroke();
  };

  plotPts(lupData, 'rgba(69,184,115,0.9)');
  plotPts(ldnData, 'rgba(224,100,100,0.9)');

  // legend (language-aware — canvas text can't use l-en/l-zh spans)
  var zh = curLang()==='zh';
  ctx.fillStyle = 'rgba(69,184,115,0.9)';
  ctx.fillRect(4,4,12,3);
  ctx.fillStyle = cssv('--muted','#8b93a1');
  ctx.font = '8px -apple-system,sans-serif';
  ctx.fillText(zh ? '涨停 %' : 'Limit-Up %', 20, 9);
  ctx.fillStyle = 'rgba(224,100,100,0.9)';
  ctx.fillRect(4,14,12,3);
  ctx.fillStyle = cssv('--muted','#8b93a1');
  ctx.fillText(zh ? '跌停 %' : 'Limit-Down %', 20, 19);
}

// ═══════════════════════════════════════════════════
// PHASE STRIP Canvas
// ═══════════════════════════════════════════════════
function drawPhaseStrip(){
  const canvas = document.getElementById('phaseStripCanvas');
  if(!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  const w = canvas.offsetWidth || canvas.parentElement.offsetWidth || 600;
  const h = 28;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  canvas.style.width = w + 'px';
  canvas.style.height = h + 'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);

  const n = PHASE_STRIP.length;
  for(let i=0;i<n;i++){
    const ph = PHASE_STRIP[i];
    const x = (i/n)*w;
    const bw = (1/n)*w + 0.5;
    const color = PHASE_COLORS[ph.phase] || '#8b93a1';
    const conf = (ph.confidence !== undefined) ? ph.confidence : (ph.conf !== undefined ? ph.conf : 1);
    const alpha = 0.3 + conf * 0.7;
    ctx.fillStyle = color;
    ctx.globalAlpha = alpha;
    ctx.fillRect(x, 0, bw, h);
  }
  ctx.globalAlpha = 1;

  // today marker
  ctx.fillStyle = cssv('--text', '#d7dce3');
  ctx.fillRect(w-3, 0, 3, h);
}

// ═══════════════════════════════════════════════════
// CGB YIELD CURVE SVG
// ═══════════════════════════════════════════════════
function drawCGBCurve(){
  const svg = document.getElementById('cgbCurve');
  if(!svg) return;
  const vw=500, vh=180, padL=44, padR=20, padT=20, padB=40;
  const pw = vw-padL-padR, ph = vh-padT-padB;

  // Load from JSON block — fallback to zeros if unavailable
  var cgb = mechJSON('mechData-cgbCurve') || {};
  const pts = [
    {label:'3M', x:0,   y: cgb.m3  || null},
    {label:'1Y', x:0.12,y: cgb.y1  || null},
    {label:'5Y', x:0.44,y: cgb.y5  || null},
    {label:'10Y',x:0.75,y: cgb.y10 || null},
    {label:'30Y',x:1.0, y: cgb.y30 || null},
  ].filter(p => p.y !== null);
  if(!pts.length){ svg.innerHTML = ''; return; }

  const ys = pts.map(p=>p.y);
  const mn=Math.min(...ys)-0.05, mx=Math.max(...ys)+0.05;
  const rng=mx-mn;

  const toSvg = (px,py) => ({
    x: padL + px*pw,
    y: padT + ph - (py-mn)/rng*ph
  });

  const svgPts = pts.map(p => toSvg(p.x, p.y));

  // smooth curve using cubic bezier
  let path = `M ${svgPts[0].x} ${svgPts[0].y}`;
  for(let i=1;i<svgPts.length;i++){
    const prev = svgPts[i-1], curr = svgPts[i];
    const cx1 = prev.x + (curr.x-prev.x)*0.5;
    const cy1 = prev.y;
    const cx2 = curr.x - (curr.x-prev.x)*0.5;
    const cy2 = curr.y;
    path += ` C ${cx1} ${cy1} ${cx2} ${cy2} ${curr.x} ${curr.y}`;
  }

  let html = `<defs>
    <linearGradient id="cgbGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#5b9bf0" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#5b9bf0" stop-opacity="0.02"/>
    </linearGradient>
  </defs>`;

  // grid lines
  for(let y=mn;y<=mx+0.01;y+=0.2){
    const sy = padT + ph - (y-mn)/rng*ph;
    html += `<line x1="${padL}" y1="${sy}" x2="${padL+pw}" y2="${sy}" stroke="${cssv('--line','#2a2f3a')}" stroke-width="0.5"/>`;
    html += `<text x="${padL-4}" y="${sy+3}" text-anchor="end" fill="#8b93a1" font-size="8" font-family="-apple-system,sans-serif">${y.toFixed(2)}%</text>`;
  }

  // fill area
  const fillPath = path + ` L ${svgPts[svgPts.length-1].x} ${padT+ph} L ${padL} ${padT+ph} Z`;
  html += `<path d="${fillPath}" fill="url(#cgbGrad)"/>`;

  // curve line
  html += `<path d="${path}" fill="none" stroke="#5b9bf0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;

  // data points + x-axis labels + y-callouts
  for(let i=0;i<svgPts.length;i++){
    const p = svgPts[i];
    html += `<circle cx="${p.x}" cy="${p.y}" r="4.5" fill="#5b9bf0" stroke="${cssv('--panel','#181b21')}" stroke-width="2"/>`;
    // x label below
    html += `<text x="${p.x}" y="${padT+ph+16}" text-anchor="middle" fill="#8b93a1" font-size="9.5" font-family="-apple-system,sans-serif">${pts[i].label}</text>`;
    // value callout above dot
    html += `<text x="${p.x}" y="${p.y-10}" text-anchor="middle" fill="#5b9bf0" font-size="9" font-weight="600" font-family="-apple-system,sans-serif">${pts[i].y.toFixed(4)}%</text>`;
  }

  svg.innerHTML = html;
}

// ═══════════════════════════════════════════════════
// HEAT GAUGE
// ═══════════════════════════════════════════════════
function drawHeatGauge(){
  const svg = document.getElementById('heatGaugeSvg');
  if(!svg) return;
  const cx=55, cy=55, r=45, stroke=10;
  const pct=0.45; // mixed/unclear ~45%
  const angle = pct*2*Math.PI;
  const x1=cx+r*Math.cos(-Math.PI/2), y1=cy+r*Math.sin(-Math.PI/2);
  const x2=cx+r*Math.cos(-Math.PI/2+angle), y2=cy+r*Math.sin(-Math.PI/2+angle);
  const la=angle>Math.PI?1:0;

  svg.innerHTML = `
    <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${cssv('--line','#2a2f3a')}" stroke-width="${stroke}"/>
    <path d="M ${x1} ${y1} A ${r} ${r} 0 ${la} 1 ${x2} ${y2}" fill="none" stroke="rgba(224,160,48,0.7)" stroke-width="${stroke}" stroke-linecap="round"/>
  `;
}

// ═══════════════════════════════════════════════════
// EVENTS TABLE
// ═══════════════════════════════════════════════════
function buildEventsTable(){
  const tbody = document.getElementById('eventsTableBody');
  if(!tbody) return;
  // bilingual event labels — emit both l-en/l-zh spans so the CSS toggle handles language
  function biEvent(cls, en, zh){ return `<span class="${cls}"><span class="l-en">${en}</span><span class="l-zh">${zh}</span></span>`; }
  const eventLabels = {
    sealed_up:      biEvent('event-sealed-up',  '↑ Sealed Up',   '↑ 封涨停'),
    sealed_down:    biEvent('event-sealed-down','↓ Sealed Down', '↓ 封跌停'),
    failed_up_seal: biEvent('event-failed',     '✕ Failed Seal', '✕ 涨停炸板'),
    failed_down_seal:biEvent('event-failed',    '✕ Failed Down', '✕ 跌停开板'),
    lianban_new:    biEvent('event-sealed-up',  '★ Lianban',     '★ 连板'),
  };
  const boardLabels = {main:['Main','主板'], star:['STAR','科创板'], chinext:['ChiNext','创业板'], bse:['BSE','北交所'], st:['ST','ST股']};
  const L = curLang()==='zh' ? 1 : 0;
  let html='';
  for(const e of EVENTS){
    const evLabel = eventLabels[e.event] || `<span class="l-en">${e.event}</span><span class="l-zh">${e.event}</span>`;
    const bl = boardLabels[(e.board||'').toLowerCase()];
    const boardStr = bl ? `<span class="l-en">${bl[0]}</span><span class="l-zh">${bl[1]}</span>` : (e.board||'');
    const off = e.off !== undefined ? e.off : (e.close_off_limit_pct || 0);
    const offStr = off===0 ? '0.00%' : (off*100).toFixed(3)+'%';
    html += `<tr>
      <td style="font-family:monospace;font-size:11px;color:var(--link)">${e.ticker}</td>
      <td>${boardStr}</td>
      <td>${evLabel}</td>
      <td style="text-align:right;color:${off<0?'var(--down)':'var(--muted)'}">${offStr}</td>
    </tr>`;
  }
  tbody.innerHTML = html;
}

// ═══════════════════════════════════════════════════
// ERA TABLE
// ═══════════════════════════════════════════════════
function buildEraTable(){
  const tbody = document.getElementById('eraTableBody');
  if(!tbody) return;
  let html='';
  for(const e of ERA_TABLE){
    const pills = e.phases.map(p => {
      const c = PHASE_COLORS[p] || '#8b93a1';
      const nm = PHASE_META[p];
      const label = nm ? `<span class="l-en">${nm.en}</span><span class="l-zh">${nm.zh}</span>` : p.replace('_',' ');
      return `<span class="phase-pill" style="background:${c}22;color:${c};border:1px solid ${c}44">${label}</span>`;
    }).join('');
    const eraLabel = (e.label || e.era || '').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
    html += `<tr>
      <td>${eraLabel}</td>
      <td style="white-space:nowrap">${e.start} – ${e.end}</td>
      <td>${pills}</td>
      <td>${e.note}</td>
    </tr>`;
  }
  tbody.innerHTML = html;
}

// ═══════════════════════════════════════════════════
// POLICY EVENTS
// ═══════════════════════════════════════════════════
function buildPolicyEvents(){
  const el = document.getElementById('policyEventsList');
  if(!el) return;
  const srcClass = {pboc:'src-pboc',politburo:'src-politburo',cewc:'src-cewc'};
  const kindLabels = {
    omo_mlf:['OMO / MLF','公开市场操作'], rhetoric:['Rhetoric','政策表态'],
    rate_cut:['Rate cut','降息'], rrr_cut:['RRR cut','降准'], rate_hold:['Rate hold','利率不变'],
    regulation:['Regulation','监管'], fiscal:['Fiscal','财政'], meeting:['Meeting','会议'],
  };
  let html='';
  for(const e of POLICY_EVENTS){
    const sc = srcClass[e.source] || 'src-pboc';
    const kl = kindLabels[e.kind];
    const kindStr = kl ? `<span class="l-en">${kl[0]}</span><span class="l-zh">${kl[1]}</span>` : (e.kind||'').replace(/_/g,' ');
    const sectors = e.sectors.map(s=>`<span class="sector-tag">${s.replace('_',' ')}</span>`).join('');
    html += `<div class="policy-event-item">
      <div class="event-ts">${e.ts}</div>
      <div class="event-body">
        <span class="event-source-chip ${sc}">${e.source.toUpperCase()}</span>
        <span style="font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em">${kindStr}</span>
        <div class="event-title" style="margin-top:3px">${e.title}</div>
        ${sectors ? `<div class="event-sectors">${sectors}</div>` : ''}
      </div>
    </div>`;
  }
  el.innerHTML = html;
}

// ═══════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════
function renderAll(){
  drawCycleWheel();
  drawHeatGauge();
  buildEventsTable();
  buildEraTable();
  buildPolicyEvents();
  drawCGBCurve();

  // Sparklines (need offsetWidth so run after layout)
  requestAnimationFrame(() => {
    // resize all canvases to parent
    ['sp_turnover','sp_margin','sp_south','sp_qvix','sp_limits','phaseStripCanvas'].forEach(id => {
      const c = document.getElementById(id);
      if(c && c.parentElement){
        c.width = c.parentElement.clientWidth;
      }
    });

    const UP=cssv('--up','#45b873'), DN=cssv('--down','#e06464'), INFO=cssv('--info','#5b9bf0'), WARN=cssv('--warn','#e0a030');
    drawSparkline('sp_turnover', TURNOVER_Z20, UP, DN, INFO);
    drawSparkline('sp_margin', MARGIN_BAL, UP, UP, INFO);
    drawSparkline('sp_south', SOUTHBOUND_Z, UP, DN, INFO);
    drawSparkline('sp_qvix', QVIX, DN, UP, WARN);
    drawLimitsChart('sp_limits', LUP_RAW, LDN_RAW);
    drawPhaseStrip();
  });
}

function init(){
  renderAll();
  // re-render canvas/SVG on theme or language toggle (they read colors + lang at
  // draw time and can't use CSS var / l-en·l-zh spans directly)
  if(window.MutationObserver){
    var pend = null;
    new MutationObserver(function(){ if(pend) return; pend = setTimeout(function(){ pend=null; renderAll(); }, 60); })
      .observe(document.documentElement, {attributes:true, attributeFilter:['data-theme','data-lang']});
  }
  // redraw width-sensitive charts on resize
  var rz = null;
  window.addEventListener('resize', function(){ clearTimeout(rz); rz = setTimeout(renderAll, 180); });
}

document.addEventListener('DOMContentLoaded', init);
</script>
<script src="theme.js"></script>
</body>
</html>
