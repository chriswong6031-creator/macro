    </div>
    {% for ch in pp.get('transmission_channel') or [] %}
    <span class="chip c-info" style="align-self:center">{{ ch.replace('_',' ') }}</span>
    {% endfor %}
    {% if pp.get('asof') %}<span style="font-size:11px;color:var(--muted);align-self:center">{{ t('as of', '截至') }} {{ pp.asof }}</span>{% endif %}
