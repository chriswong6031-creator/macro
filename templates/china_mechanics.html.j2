{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='', cls='') -%}
<span class="help{% if cls %} {{ cls }}{% endif %}">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>A-Share Market Mechanics — Mastermind</title>
{% set seo_title = 'A-Share Market Mechanics — Participation · Limit · Phase · Policy | Mastermind' %}
{% set seo_desc = 'China A-share market structure cockpit: turnover & margin participation trends, limit-up/down breadth, lianban mechanics, cycle phase memory, policy transmission tape, CGB curve & USDCNH. Context only — never a signal.' %}
{% set seo_path = 'china_mechanics.html' %}
{% include "_seo_head.html.j2" %}
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
:root {
  --bg: #0f1115; --panel: #181b21; --panel2: #1e222a; --text: #d7dce3;
  --muted: #8b93a1; --line: #2a2f3a;
  --up: #45b873; --down: #e06464; --orange: #e08b45;
  --info: #5b9bf0; --link: #7aa7e0; --warn: #e0a030;
  --ok: #3da564;
  --glass-bg: rgba(24,27,33,0.82);
  --glass-brd: rgba(215,220,227,0.11);
  --glass-blur: saturate(180%) blur(22px);
  --glass-shadow: 0 24px 64px -22px rgba(3,7,18,.74), 0 10px 26px -12px rgba(3,7,18,.55), inset 0 1px 0 rgba(255,255,255,0.07);

  /* Phase colors */
  --c-repair: #7aa7e0;
  --c-policy-put: #5b9bf0;
  --c-liquidity: #45b873;
  --c-broadening: #3da564;
  --c-theme-lead: #e08b45;
  --c-euphoria: #e06464;
  --c-distribution: #e07070;
  --c-deleveraging: #c04040;
  --c-capitulation: #8b93a1;
  --c-grinding: #a07070;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

html{scroll-behavior:smooth}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.01ms!important;transition-duration:.01ms!important}}

body{
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,"Segoe UI",Roboto,sans-serif;
  font-size:14px;
  line-height:1.5;
  min-height:100vh;
  padding-top:20px;  /* top breathing room for the shared .site-nav (check_nav_gap) */
}

/* ── Radial brand ambience ── */
body::before{
  content:'';
  position:fixed;
  top:-30%;left:50%;
  transform:translateX(-50%);
  width:900px;height:600px;
  background:radial-gradient(ellipse at 50% 30%,rgba(91,155,240,0.06) 0%,transparent 70%);
  pointer-events:none;
  z-index:0;
}

.page-wrap{
  position:relative;
  z-index:1;
  max-width:1440px;
  margin:0 auto;
  padding:0 24px 80px;
}

/* ── MICRO LABEL ── */
.micro{
  font-size:10.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
}

/* ── GLASS CARD ── */
.glass{
  background:var(--glass-bg);
  border:1px solid var(--glass-brd);
  backdrop-filter:var(--glass-blur);
  -webkit-backdrop-filter:var(--glass-blur);
  border-radius:14px;
  box-shadow:var(--glass-shadow);
}

/* ── SECTION HEADER ── */
.section-hdr{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:16px;
}
.section-hdr h2{
  font-size:13px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.12em;
  color:var(--muted);
}
.section-dot{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--info);
  flex-shrink:0;
}

/* ── CONTEXT BADGE ── */
.context-badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:4px 10px;
  border-radius:20px;
  background:rgba(224,160,48,0.12);
  border:1px solid rgba(224,160,48,0.25);
  font-size:10.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--warn);
}

/* ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ */
.hero{
  padding:40px 0 32px;
  display:grid;
  grid-template-columns:1fr 380px;
  gap:32px;
  align-items:start;
}

.hero-left{}

.hero-breadcrumb{
  font-size:11px;
  color:var(--muted);
  margin-bottom:12px;
  display:flex;
  align-items:center;
  gap:6px;
}
.hero-breadcrumb a{color:var(--link);text-decoration:none}
.hero-breadcrumb span{color:var(--line)}

.hero-title{
  font-size:28px;
  font-weight:700;
  letter-spacing:-.02em;
  color:var(--text);
  margin-bottom:4px;
  line-height:1.2;
}
.hero-subtitle{
  font-size:13px;
  color:var(--muted);
  margin-bottom:20px;
}
.hero-subtitle em{color:var(--text);font-style:normal}

.hero-reading{
  max-width:560px;
  font-size:14px;
  line-height:1.7;
  color:var(--muted);
  margin-bottom:20px;
}
.hero-reading strong{color:var(--text)}

.hero-meta{
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

/* quick stat tiles */
.stat-row{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:24px;
}
.stat-tile{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:10px;
  padding:12px 16px;
  min-width:120px;
}
.stat-tile .label{
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  margin-bottom:4px;
}
.stat-tile .value{
  font-size:20px;
  font-weight:700;
  letter-spacing:-.02em;
}
.stat-tile .sub{
  font-size:10.5px;
  color:var(--muted);
  margin-top:2px;
}
.up-color{color:var(--up)}
.down-color{color:var(--down)}
.info-color{color:var(--info)}
.warn-color{color:var(--warn)}
.muted-color{color:var(--muted)}

/* ── Cycle Wheel Hero ── */
.wheel-wrap{
  background:var(--glass-bg);
  border:1px solid var(--glass-brd);
  backdrop-filter:var(--glass-blur);
  -webkit-backdrop-filter:var(--glass-blur);
  border-radius:16px;
  box-shadow:var(--glass-shadow);
  padding:28px 24px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:16px;
  position:relative;
  overflow:hidden;
}
.wheel-wrap::before{
  content:'';
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-52%);
  width:340px;height:340px;
  background:radial-gradient(ellipse,rgba(91,155,240,0.07) 0%,transparent 65%);
  pointer-events:none;
}
.wheel-title{
  font-size:10.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.12em;
  color:var(--muted);
  text-align:center;
}
#cycleWheelSvg{
  width:260px;height:260px;
  flex-shrink:0;
}
.wheel-phase-label{
  text-align:center;
}
.wheel-phase-name{
  font-size:16px;
  font-weight:700;
  color:var(--c-policy-put);
  letter-spacing:.02em;
  margin-bottom:2px;
}
.wheel-phase-zh{
  font-size:11px;
  color:var(--muted);
  margin-bottom:6px;
}
.wheel-phase-desc{
  font-size:12px;
  color:var(--muted);
  line-height:1.5;
  max-width:260px;
  text-align:center;
}
.wheel-confidence{
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:4px;
}
.conf-bar-wrap{
  width:100px;
  height:4px;
  background:var(--line);
  border-radius:2px;
  overflow:hidden;
}
.conf-bar-fill{
  height:100%;
  background:var(--c-policy-put);
  border-radius:2px;
  width:75%;
}
.conf-label{
  font-size:10.5px;
  color:var(--muted);
}

/* ══════════════════════════════════════════
   SECTIONS
══════════════════════════════════════════ */
.section{
  margin-top:32px;
}

/* ── Panel grid helpers ── */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}

.panel{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:14px;
  padding:20px;
}
.panel-sm{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
}

/* ── GAUGE ── */
.gauge-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
}
.gauge-label{
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  text-align:center;
}
.gauge-value{
  font-size:18px;
  font-weight:700;
  text-align:center;
}
.gauge-sub{font-size:10.5px;color:var(--muted);text-align:center}

/* ── SPARKLINE ── */
.sparkline-wrap{
  position:relative;
  height:48px;
  margin-top:8px;
}
.sparkline-wrap canvas,
.sparkline-wrap svg{
  width:100%;
  height:48px;
  display:block;
}

/* ── STALE CHIP ── */
.stale-chip{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:2px 7px;
  border-radius:10px;
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.08em;
  background:rgba(224,160,48,0.12);
  border:1px solid rgba(224,160,48,0.22);
  color:var(--warn);
}

.null-chip{
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:2px 7px;
  border-radius:10px;
  font-size:10px;
  font-weight:600;
  letter-spacing:.06em;
  background:rgba(139,147,161,0.10);
  border:1px solid rgba(139,147,161,0.18);
  color:var(--muted);
}

/* ══════════════════════════════════════════
   PARTICIPATION PANEL
══════════════════════════════════════════ */
.participation-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1fr 1fr;
  gap:12px;
  margin-bottom:20px;
}
.part-card{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:12px;
  padding:14px 16px;
}
.part-card .label{
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  margin-bottom:6px;
}
.part-card .main-val{
  font-size:22px;
  font-weight:700;
  letter-spacing:-.02em;
  line-height:1;
  margin-bottom:2px;
}
.part-card .secondary{
  font-size:11px;
  color:var(--muted);
}
.part-card .sub-val{
  font-size:11px;
  margin-top:4px;
}

.heat-gauge-row{
  display:grid;
  grid-template-columns:200px 1fr;
  gap:20px;
  align-items:center;
  padding:16px;
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:12px;
  margin-bottom:16px;
}
.heat-arc-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
}
.heat-label-row{
  font-size:11px;
  color:var(--muted);
  line-height:1.6;
}
.heat-label-row strong{color:var(--text)}

/* conic ring gauge */
.ring-gauge{
  position:relative;
  width:100px;height:100px;
  flex-shrink:0;
}
.ring-gauge svg{width:100%;height:100%}
.ring-gauge .center-val{
  position:absolute;
  top:50%;left:50%;
  transform:translate(-50%,-50%);
  text-align:center;
  line-height:1.1;
}
.ring-gauge .center-val .v{
  font-size:18px;
  font-weight:700;
  color:var(--text);
}
.ring-gauge .center-val .u{
  font-size:10px;
  color:var(--muted);
}

/* ══════════════════════════════════════════
   LIMIT MECHANICS
══════════════════════════════════════════ */
.limits-top{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:10px;
  margin-bottom:20px;
}
.limit-chip{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:10px;
  padding:12px 12px;
  text-align:center;
}
.limit-chip .label{
  font-size:9.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
  margin-bottom:6px;
}
.limit-chip .val{
  font-size:26px;
  font-weight:700;
  line-height:1;
}
.limit-chip .zh{
  font-size:10px;
  color:var(--muted);
  margin-top:2px;
}

.breadth-thermo{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
  margin-bottom:16px;
}
.thermo-title{
  font-size:10.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  margin-bottom:10px;
}
.thermo-bar-row{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:11px;
}
.thermo-bar{
  flex:1;
  height:20px;
  border-radius:4px;
  overflow:hidden;
  background:var(--line);
  display:flex;
}
.thermo-seg-up{background:var(--up);height:100%}
.thermo-seg-down{background:var(--down);height:100%}
.thermo-seg-other{background:var(--line);flex:1;height:100%}

/* events table */
.limits-charts{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}
/* grid children must be allowed to shrink below content width so inner
   tables/canvases don't force horizontal page overflow on narrow viewports */
.limits-charts > *{min-width:0}
.events-table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.events-table{
  width:100%;
  border-collapse:collapse;
  font-size:12px;
}
.events-table th{
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
  padding:6px 10px;
  text-align:left;
  border-bottom:1px solid var(--line);
}
.events-table td{
  padding:7px 10px;
  border-bottom:1px solid rgba(42,47,58,.5);
  color:var(--text);
}
.events-table tr:last-child td{border-bottom:none}
.event-sealed-up{color:var(--up);font-weight:600}
.event-sealed-down{color:var(--down);font-weight:600}
.event-failed{color:var(--warn);font-weight:600}

/* ══════════════════════════════════════════
   CYCLE PHASE PANEL
══════════════════════════════════════════ */
.phase-strip-wrap{
  margin-bottom:20px;
  overflow:hidden;
}
.phase-strip-label-row{
  display:flex;
  justify-content:space-between;
  font-size:10px;
  color:var(--muted);
  margin-bottom:4px;
}
#phaseStripCanvas{
  width:100%;
  height:28px;
  border-radius:6px;
  display:block;
}
.phase-legend{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:10px;
}
.phase-legend-item{
  display:flex;
  align-items:center;
  gap:5px;
  font-size:10.5px;
  color:var(--muted);
}
.phase-dot{
  width:8px;height:8px;
  border-radius:50%;
  flex-shrink:0;
}

.falsifier-list{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:16px;
}
.falsifier-item{
  display:flex;
  align-items:flex-start;
  gap:10px;
  padding:10px 14px;
  background:var(--panel2);
  border:1px solid var(--line);
  border-left:3px solid var(--warn);
  border-radius:0 10px 10px 0;
  font-size:12px;
}
.falsifier-id{
  font-size:10px;
  font-weight:700;
  font-family:monospace;
  color:var(--warn);
  white-space:nowrap;
  margin-top:1px;
}
.falsifier-desc{color:var(--text)}
.falsifier-horizon{
  margin-left:auto;
  font-size:10px;
  color:var(--muted);
  white-space:nowrap;
}

.ledger-row{
  display:flex;
  gap:20px;
  flex-wrap:wrap;
  margin-top:12px;
}
.ledger-item{
  text-align:center;
}
.ledger-item .lv{
  font-size:20px;
  font-weight:700;
  letter-spacing:-.02em;
}
.ledger-item .ll{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
}

/* collapsible era table */
details summary{
  cursor:pointer;
  font-size:11px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  padding:10px 0;
  list-style:none;
  display:flex;
  align-items:center;
  gap:6px;
}
details summary::-webkit-details-marker{display:none}
details summary::before{
  content:'▶';
  font-size:9px;
  transition:transform .2s;
  display:inline-block;
}
details[open] summary::before{transform:rotate(90deg)}
.era-table{
  width:100%;
  border-collapse:collapse;
  font-size:11.5px;
  margin-top:4px;
}
.era-table th{
  font-size:9.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
  padding:5px 10px;
  text-align:left;
  border-bottom:1px solid var(--line);
}
.era-table td{
  padding:6px 10px;
  border-bottom:1px solid rgba(42,47,58,.4);
  color:var(--muted);
  vertical-align:top;
}
.era-table td:first-child{color:var(--text);font-weight:500}
.phase-pill{
  display:inline-block;
  padding:1px 6px;
  border-radius:3px;
  font-size:9.5px;
  font-weight:600;
  margin:1px 2px 1px 0;
}

/* ══════════════════════════════════════════
   POLICY TAPE
══════════════════════════════════════════ */
.policy-top{
  display:flex;
  align-items:flex-start;
  gap:20px;
  margin-bottom:20px;
  flex-wrap:wrap;
}
.impulse-badge{
  padding:10px 20px;
  border-radius:12px;
  background:rgba(91,155,240,0.12);
  border:1px solid rgba(91,155,240,0.25);
  text-align:center;
  flex-shrink:0;
}
.impulse-badge .label{
  font-size:9.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  margin-bottom:4px;
}
.impulse-badge .val{
  font-size:13px;
  font-weight:700;
  color:var(--info);
  white-space:nowrap;
}

.staleness-chips{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  align-items:center;
}

.policy-events-list{
  display:flex;
  flex-direction:column;
  gap:0;
}
.policy-event-item{
  display:flex;
  gap:14px;
  padding:10px 0;
  border-bottom:1px solid rgba(42,47,58,.5);
  font-size:12px;
}
.policy-event-item:last-child{border-bottom:none}
.event-ts{
  flex-shrink:0;
  width:80px;
  color:var(--muted);
  font-size:10.5px;
  padding-top:1px;
}
.event-body{}
.event-source-chip{
  display:inline-flex;
  align-items:center;
  padding:1px 6px;
  border-radius:4px;
  font-size:9.5px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.06em;
  margin-right:6px;
}
.src-pboc{background:rgba(91,155,240,0.15);color:var(--info)}
.src-politburo{background:rgba(224,160,48,0.12);color:var(--warn)}
.src-cewc{background:rgba(224,139,69,0.12);color:var(--orange)}
.event-title{color:var(--text);line-height:1.5}
.event-sectors{
  margin-top:3px;
  display:flex;
  gap:4px;
  flex-wrap:wrap;
}
.sector-tag{
  padding:1px 6px;
  border-radius:3px;
  font-size:9.5px;
  font-weight:600;
  background:var(--panel2);
  border:1px solid var(--line);
  color:var(--muted);
}

/* ══════════════════════════════════════════
   CROSS MARKET
══════════════════════════════════════════ */
.cross-grid{
  display:grid;
  grid-template-columns:1fr 240px;
  gap:20px;
  align-items:start;
}
.cgb-wrap{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
}
.cgb-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:12px;
}
.cgb-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}
#cgbCurve{display:block;width:100%;height:180px}

.usdcnh-card{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:12px;
  padding:16px;
}
.usdcnh-label{
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:var(--muted);
  margin-bottom:6px;
}
.usdcnh-rate{
  font-size:32px;
  font-weight:700;
  letter-spacing:-.03em;
  line-height:1;
  margin-bottom:4px;
}
.usdcnh-chg{
  font-size:13px;
  font-weight:600;
}

/* ══════════════════════════════════════════
   GLOSSARY
══════════════════════════════════════════ */
.glossary-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
.gloss-item{
  background:var(--panel2);
  border:1px solid var(--line);
  border-radius:10px;
  padding:12px 14px;
}
.gloss-term{
  font-size:12px;
  font-weight:700;
  color:var(--text);
  margin-bottom:4px;
  display:flex;
  align-items:center;
  gap:6px;
}
.gloss-zh{
  font-size:11px;
  color:var(--muted);
  font-weight:400;
}
.gloss-def{
  font-size:11.5px;
  color:var(--muted);
  line-height:1.5;
}

/* ── DIVIDER ── */
.divider{
  height:1px;
  background:var(--line);
  margin:32px 0;
}

/* ── FOCUS STATES ── */
a:focus-visible,button:focus-visible,summary:focus-visible{
  outline:2px solid var(--info);
  outline-offset:2px;
  border-radius:4px;
}

/* ── help tooltip (inline "?" badge with hover popover) ── */
.help{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;
  border-radius:50%;border:1px solid var(--muted);color:var(--muted);font-size:10px;font-weight:600;
  cursor:help;position:relative;vertical-align:middle;margin-left:5px;flex:none;text-transform:none;letter-spacing:normal}
.help .tip{display:none;position:absolute;bottom:150%;left:50%;transform:translateX(-50%);width:300px;
  background:var(--panel);border:1px solid var(--line);padding:10px 12px;border-radius:9px;z-index:60;
  font-size:12px;line-height:1.5;color:var(--text);text-align:left;font-weight:400;text-transform:none;
  letter-spacing:normal;box-shadow:0 8px 28px rgba(0,0,0,.28);pointer-events:auto;cursor:auto;white-space:normal;
  max-height:min(60vh,420px);overflow-y:auto;overscroll-behavior:contain;}
/* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
.help:hover::before{content:'';position:absolute;bottom:100%;left:-30px;right:-30px;height:10px;}
.help:hover .tip,.help:focus-within .tip{display:block}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .hero{grid-template-columns:1fr;grid-template-rows:auto auto}
  .wheel-wrap{max-width:380px;margin:0 auto}
  .participation-grid{grid-template-columns:1fr 1fr}
  .limits-top{grid-template-columns:repeat(3,1fr)}
  .limits-charts{grid-template-columns:1fr}
  .glossary-grid{grid-template-columns:1fr 1fr}
  .cross-grid{grid-template-columns:1fr}
  .grid-2,.grid-3,.grid-4{grid-template-columns:1fr}
}
@media(max-width:480px){
  .page-wrap{padding:0 12px 60px}
  .hero{padding:24px 0 20px}
  .hero-title{font-size:22px}
  .stat-row{gap:8px}
  .stat-tile{min-width:100px;padding:10px 12px}
  .participation-grid{grid-template-columns:1fr}
  .limits-top{grid-template-columns:repeat(2,1fr)}
  .glossary-grid{grid-template-columns:1fr}
  #cycleWheelSvg{width:220px;height:220px}
}
</style>
</head>
<body class="page-china-mechanics">

<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search A-shares"
      placeholder="Search any stock — US, China, HK, Canada &amp; more…" data-ph-zh="搜索任意股票 — 美股、A 股、港股、加股等…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="page-wrap">

<!-- ══ HERO ══════════════════════════════════════════ -->
{% set lpl = participation.get('latest') or {} %}
{% set la = limits.get('latest_agg') or {} %}
{% set cp = phase.get('current') or {} %}
{% set pp = policy %}
{% set cm = cross_market %}
{% set cgb = cm.get('cgb_curve') or {} %}
{% set cnh = cm.get('usdcnh') or {} %}
{% set mb_val = lpl.get('margin_balance') %}
{% set sb_val = lpl.get('southbound_z') %}
{% set qvix_val = lpl.get('qvix') %}
{% set tz20_val = lpl.get('turnover_z20') %}
{% set tz60_val = lpl.get('turnover_z60') %}
{% set phase_name = cp.get('phase') or '—' %}
{% set conf_val = cp.get('confidence') %}
{% set phase_color = '#5b9bf0' %}
{% for pc in phase_catalog %}{% if pc.key == phase_name %}{% set phase_color = pc.color %}{% endif %}{% endfor %}

<section class="hero">
  <div class="hero-left">
    <div class="hero-breadcrumb">
      <a href="china.html">{{ t('China', '中国') }}</a>
      <span>›</span>
      <span>{{ t('A-Share Market Mechanics', 'A股市场结构') }}</span>
    </div>

    <h1 class="hero-title">{{ t('A-Share Market Mechanics', 'A股市场结构') }}</h1>
    <div class="hero-subtitle">{{ t('China A-Share Market Structure', '中国A股市场机制') }} · <em>{{ t('as of', '截至') }} {{ as_of or '—' }}</em></div>

    <p class="hero-reading">
      <span class="l-en">{{ state_reading.en }}</span>
      <span class="l-zh">{{ state_reading.zh }}</span>
    </p>

    <div class="hero-meta">
      <div class="context-badge">
        <span style="font-size:12px">⚑</span>
        {{ t('Context only · not a signal or recommendation', '仅供参考 · 非信号或建议') }}
      </div>
      <span class="stale-chip">{{ t('Built', '生成') }} {{ built }}</span>
    </div>

    <div class="stat-row">
      <div class="stat-tile">
        <div class="label">{{ t('QVIX', 'QVIX 波动率') }}</div>
        <div class="value{{ ' warn-color' if qvix_val is not none and qvix_val > 25 else '' }}">{{ ('%.1f'|format(qvix_val)) if qvix_val is not none else '—' }}</div>
        <div class="sub">{{ t('fear gauge', '恐慌指标') }}</div>
      </div>
      <div class="stat-tile">
        <div class="label">{{ t('Southbound', '南向资金') }}</div>
        <div class="value {{ 'up-color' if sb_val is not none and sb_val > 0.5 else ('down-color' if sb_val is not none and sb_val < -0.5 else '') }}">{{ ('%+.2f'|format(sb_val)) if sb_val is not none else '—' }}</div>
        <div class="sub">{{ t('z-score HK→A', '港资南向z分数') }}</div>
      </div>
      <div class="stat-tile">
        <div class="label">{{ t('Margin', '融资余额') }}</div>
        <div class="value info-color">{{ ('%.2f'|format(mb_val / 10000)) if mb_val is not none else '—' }} {{ t('万亿', '万亿') }}</div>
        <div class="sub">
          {% set mc = lpl.get('margin_chg_5d') %}
          {{ t('5d chg', '5日变化') }} {{ ('%+.2f%%'|format(mc)) if mc is not none else '—' }}
        </div>
      </div>
      <div class="stat-tile">
        <div class="label">{{ t('Limit-Up', '涨停') }}</div>
        <div class="value up-color">{{ la.get('limit_up_count', '—') }}</div>
        <div class="sub">{{ t('of', '共') }} {{ '{:,}'.format(la.get('universe_n')) if la.get('universe_n') is not none else '—' }} {{ t('universe', '股') }}</div>
      </div>
      <div class="stat-tile">
        <div class="label">{{ t('Limit-Down', '跌停') }}</div>
        <div class="value down-color">{{ la.get('limit_down_count', '—') }}</div>
        <div class="sub">{{ t('Failed seals', '炸板') }}: {{ la.get('failed_up_seal_count', '—') }}</div>
      </div>
    </div>
  </div>

  <!-- CYCLE WHEEL -->
  <div class="wheel-wrap">
    <div class="wheel-title">{{ t('Market Cycle Position', '市场周期位置') }}</div>
    <svg id="cycleWheelSvg" viewBox="0 0 260 260" xmlns="http://www.w3.org/2000/svg">
      <!-- drawn by JS below -->
    </svg>
    <div class="wheel-phase-label">
      {% for pc in phase_catalog %}{% if pc.key == phase_name %}
      <div class="wheel-phase-name" style="color:{{ pc.color }}">
        <span class="l-en">{{ pc.name_en|upper }}</span><span class="l-zh">{{ pc.name_zh }}</span>
      </div>
      <div class="wheel-phase-desc">
        <span class="l-en">{{ pc.meaning_en }}</span>
        <span class="l-zh">{{ pc.meaning_zh }}</span>
      </div>
      {% endif %}{% endfor %}
    </div>
    <div class="wheel-confidence">
      <span class="conf-label micro">{{ t('Confidence', '置信度') }}</span>
      <div class="conf-bar-wrap"><div class="conf-bar-fill" id="confBarFill"></div></div>
      <span class="conf-label" style="font-size:12px;font-weight:700" id="confPct">{{ ('%.0f'|format(conf_val * 100)) if conf_val is not none else '—' }}%</span>
    </div>
    {% set nm = phase.get('next_meta') or {} %}
    {% if nm %}
    <div style="font-size:10px;color:var(--muted);text-align:center;line-height:1.5">
      <span class="l-en">Typical next in cycle: <em>{{ nm.get('name_en','') }}</em> — {{ nm.get('meaning_en','') }}</span>
      <span class="l-zh">周期下一阶段：<em>{{ nm.get('name_zh','') }}</em> — {{ nm.get('meaning_zh','') }}</span>
    </div>
    {% endif %}
    <div style="font-size:9.5px;color:var(--muted);text-align:center;margin-top:4px;padding:4px 8px;border-radius:6px;background:rgba(224,160,48,0.07);border:1px solid rgba(224,160,48,0.15)">
      {{ t('Typical cycle ordering — not a forecast or signal', '典型周期顺序 — 非预测或信号') }}
    </div>
  </div>
</section>

<!-- ══ PARTICIPATION ══════════════════════════════════ -->
<script type="application/json" id="mechData-turnoverZ20">{{ participation.turnover_z20 | tojson }}</script>
<script type="application/json" id="mechData-marginBalance">{{ participation.margin_balance | tojson }}</script>
<script type="application/json" id="mechData-southboundZ">{{ participation.southbound_z | tojson }}</script>
<script type="application/json" id="mechData-qvix">{{ participation.qvix | tojson }}</script>
<section class="section">
  <div class="section-hdr">
    <span class="section-dot" style="background:var(--info)"></span>
    <h2>{{ t('Participation — Who\'s Trading &amp; How Hot', '参与度 — 谁在交易、热度几何') }}</h2>
    {% if lpl.get('as_of') or participation.get('as_of') %}<span class="stale-chip" style="margin-left:auto">{{ t('as of', '截至') }} {{ lpl.get('as_of') or participation.get('as_of') }}</span>{% endif %}
  </div>

  <div style="padding:10px 14px;background:rgba(91,155,240,0.04);border-left:3px solid rgba(91,155,240,0.3);border-radius:0 6px 6px 0;font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px">
    <span class="l-en">Participation tells you whether real money is in the room and who's driving. Turnover z-scores compare today's volume to its recent history; margin balance (融资余额) is borrowed money used to buy stocks; southbound flow is Hong Kong money buying A-shares; QVIX is the market's fear gauge.</span>
    <span class="l-zh">参与度告诉你是否有真实资金入场、由谁主导。成交额Z分数将当日成交量与近期历史对比；融资余额是借钱买股的杠杆资金；南向资金是港资买入A股；QVIX是市场恐慌指标。</span>
  </div>

  <div class="heat-gauge-row">
    <div class="heat-arc-wrap">
      <div class="gauge-label" style="margin-bottom:10px">{{ t('Market Heat', '市场热度') }}</div>
      <div class="ring-gauge" style="width:110px;height:110px">
        <svg viewBox="0 0 110 110" xmlns="http://www.w3.org/2000/svg" id="heatGaugeSvg"></svg>
        <div class="center-val">
          {% set regime0 = (lpl.get('regime') or 'unclear').replace('_',' ').title() %}
          <div class="v" style="color:var(--muted);font-size:13px;line-height:1.15">
            <span class="l-en">{{ regime0 }}</span>
            <span class="l-zh">{{ tr(regime0) }}</span>
          </div>
          <div class="u">{{ t('regime', '制度') }}</div>
        </div>
      </div>
    </div>
    <div class="heat-label-row">
      {% set regime = lpl.get('regime') or 'unclear' %}
      {% set who = lpl.get('who_controls') or '—' %}
      {% set risk = lpl.get('risk') or '—' %}
      <p>
        <span class="l-en"><strong>Participation regime: {{ regime.replace('_',' ').title() }}.</strong> Who controls: {{ who.replace('_',' ') }}. Risk: {{ risk.replace('_',' ') }}.</span>
        <span class="l-zh"><strong>参与制度：{{ tr(regime.replace('_',' ').title()) }}。</strong>控盘方：{{ tr(who) }}。风险：{{ tr(risk) }}。</span>
      </p>
      {% set contradictions = lpl.get('contradictions') or [] %}
      {% if contradictions %}
      <p style="margin-top:8px;font-size:11.5px">
        {% for c in contradictions %}
        <span class="null-chip">{{ c.a }} vs {{ c.b }}{% if c.detail %} — {{ c.detail }}{% endif %}</span>
        {% endfor %}
      </p>
      {% endif %}
    </div>
  </div>

  <div class="participation-grid">
    <!-- Turnover Z20 -->
    <div class="part-card">
      <div class="label">{{ t('Turnover z20', '换手率20日') }}</div>
      <div class="main-val {{ 'up-color' if tz20_val is not none and tz20_val > 0.5 else ('down-color' if tz20_val is not none and tz20_val < -0.5 else '') }}">{{ ('%.2f'|format(tz20_val)) if tz20_val is not none else '—' }}</div>
      <div class="secondary">{{ t('z60', 'z60') }} = {{ ('%.2f'|format(tz60_val)) if tz60_val is not none else '—' }}</div>
      <div class="sparkline-wrap"><canvas id="sp_turnover" height="48"></canvas></div>
    </div>
    <!-- Margin Balance -->
    <div class="part-card">
      <div class="label">{{ t('Margin Balance', '融资余额') }}</div>
      <div class="main-val info-color">{{ ('%.2f'|format(mb_val / 10000)) if mb_val is not none else '—' }} {{ t('万亿', '万亿') }}</div>
      <div class="secondary">
        {% set mc = lpl.get('margin_chg_5d') %}
        {{ t('5d chg', '5日变化') }}: <span class="{{ 'up-color' if mc is not none and mc > 0 else ('down-color' if mc is not none and mc < 0 else '') }}">{{ ('%+.2f%%'|format(mc)) if mc is not none else '—' }}</span>
      </div>
      <div class="sparkline-wrap"><canvas id="sp_margin" height="48"></canvas></div>
      <div class="sub-val">
        {% set mtr = lpl.get('margin_to_mcap') %}
        <span style="color:var(--muted)">{{ t('mcap ratio', '市值占比') }}: </span>{{ ('%.2f%%'|format(mtr)) if mtr is not none else '—' }}
      </div>
    </div>
    <!-- Southbound -->
    <div class="part-card">
      <div class="label">{{ t('Southbound z', '南向资金z') }}</div>
      <div class="main-val {{ 'up-color' if sb_val is not none and sb_val > 0.5 else ('down-color' if sb_val is not none and sb_val < -0.5 else '') }}">{{ ('%+.2f'|format(sb_val)) if sb_val is not none else '—' }}</div>
      <div class="secondary">{{ t('HK→A flow z-score', '港资南向z分数') }}</div>
      <div class="sparkline-wrap"><canvas id="sp_south" height="48"></canvas></div>
      <div class="sub-val" style="color:var(--muted);font-size:10.5px">{{ t('Northbound retired 2024-08-16 (SLF-050)', '北向通道2024-08-16关闭（SLF-050）') }}</div>
    </div>
    <!-- QVIX -->
    <div class="part-card">
      <div class="label">{{ t('QVIX', 'QVIX 波动率指数') }}</div>
      <div class="main-val{{ ' warn-color' if qvix_val is not none and qvix_val > 25 else '' }}">{{ ('%.1f'|format(qvix_val)) if qvix_val is not none else '—' }}</div>
      <div class="secondary">{{ t('high = stress', '数值越高 = 压力越大') }}</div>
      <div class="sparkline-wrap"><canvas id="sp_qvix" height="48"></canvas></div>
      <div class="sub-val" style="color:var(--muted);font-size:10.5px">{{ t('Normal range 15–25', '正常区间 15–25') }}</div>
    </div>
  </div>

  <!-- Contradiction note -->
  {% set contradictions = lpl.get('contradictions') or [] %}
  {% if contradictions %}
  <div style="padding:12px 16px;background:rgba(224,160,48,0.07);border:1px solid rgba(224,160,48,0.18);border-radius:10px;font-size:12px;color:var(--muted);margin-top:4px">
    <span style="color:var(--warn);font-weight:700">{{ t('Contradiction flagged:', '矛盾点：') }} </span>
    {% for c in contradictions %}{{ c.a }} vs {{ c.b }}{% if c.detail %} — {{ c.detail }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}
  </div>
  {% endif %}
</section>

<!-- ══ LIMIT MECHANICS ══════════════════════════════ -->
<script type="application/json" id="mechData-lupSeries">{{ limits.lup_series | tojson }}</script>
<script type="application/json" id="mechData-ldnSeries">{{ limits.ldn_series | tojson }}</script>
<script type="application/json" id="mechData-latestEvents">{{ limits.latest_events | tojson }}</script>
<section class="section">
  <div class="section-hdr">
    <span class="section-dot" style="background:var(--up)"></span>
    <h2>{{ t('Limit Mechanics — Daily Price Limits', '涨跌停板机制') }} {{ help('CN-SYS-R3: Limit-up/down data is market-structure context only. BUY-direction use is forbidden (standing kill). Lianban (连板) = consecutive limit-up sessions.', 'CN-SYS-R3：涨/跌停板数据仅作市场结构背景，禁止用于买入方向（已裁定禁止）。') }}</h2>
    {% if limits.get('latest_date') %}<span class="stale-chip" style="margin-left:auto">{{ limits.latest_date }}</span>{% endif %}
  </div>

  <div style="padding:10px 14px;background:rgba(91,155,240,0.04);border-left:3px solid rgba(91,155,240,0.3);border-radius:0 6px 6px 0;font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px">
    <span class="l-en">China caps how far a stock can move in a day. 涨停 (limit-up) is the daily ceiling, 跌停 (limit-down) the floor. 连板 (lianban) counts consecutive limit-up days — the mark of speculative streaks. A 'failed seal' touched limit-up but couldn't hold it. When limit-ups outnumber limit-downs, net limit activity leaned to the upside that day.</span>
    <span class="l-zh">中国对个股单日涨跌幅设有上限。涨停为当日上限，跌停为下限。连板统计连续涨停的天数——投机热潮的标志。开板指触及涨停却未能封住。当涨停多于跌停时，当日净涨停偏多。</span>
  </div>

  <div class="limits-top">
    <div class="limit-chip">
      <div class="label">{{ t('Limit-Up', '涨停') }}</div>
      <div class="val up-color">{{ la.get('limit_up_count', '—') }}</div>
      <div class="zh">{{ t('of', '共') }} {{ '{:,}'.format(la.get('universe_n')) if la.get('universe_n') is not none else '—' }} {{ t('stocks', '只股票') }}</div>
    </div>
    <div class="limit-chip">
      <div class="label">{{ t('Limit-Down', '跌停') }}</div>
      <div class="val down-color">{{ la.get('limit_down_count', '—') }}</div>
      <div class="zh">{{ t('hit the daily floor', '触及跌停') }}</div>
    </div>
    <div class="limit-chip">
      <div class="label">{{ t('Sealed Up', '封单') }}</div>
      <div class="val up-color">{{ la.get('sealed_up_close', '—') }}</div>
      <div class="zh">{{ t('closed on limit', '收盘封涨停') }}</div>
    </div>
    <div class="limit-chip">
      <div class="label">{{ t('Failed Seals', '炸板') }}</div>
      <div class="val warn-color">{{ la.get('failed_up_seal_count', '—') }}</div>
      <div class="zh">{{ t('touched then fell', '触及后回落') }}</div>
    </div>
    <div class="limit-chip">
      <div class="label">{{ t('Lianban 2+', '连板≥2') }}</div>
      <div class="val muted-color">{{ la.get('lianban_2plus', '—') }}</div>
      <div class="zh">{{ t('consecutive up days', '连续涨停天数') }}</div>
    </div>
    <div class="limit-chip">
      <div class="label">{{ t('Max Streak', '最高连板') }}</div>
      <div class="val info-color">{{ la.get('lianban_max', '—') }}</div>
      <div class="zh">{{ t('max lianban count', '最高连板数') }}</div>
    </div>
  </div>

  <!-- Breadth thermometer -->
  <div class="breadth-thermo">
    <div class="thermo-title">{{ t('Breadth Thermometer — % of universe', '涨跌比（占全市场比例）') }}</div>
    {% set lup_pct = la.get('limit_up_breadth_pct') %}
    {% set ldn_pct = la.get('limit_down_breadth_pct') %}
    {# breadth_pct is ALREADY a percentage of the universe (count/n*100), so it is
       displayed as-is. Values are inherently small (limits are rare vs the ~1585
       universe); the bar is drawn at true scale — a near-empty bar honestly means
       "few names hit limits today". #}
    <div class="thermo-bar-row">
      <span style="color:var(--up);font-weight:600;min-width:45px">{{ ('%.2f%%'|format(lup_pct)) if lup_pct is not none else '—' }}</span>
      <div class="thermo-bar">
        <div class="thermo-seg-up" style="width:{{ ('%.2f'|format([lup_pct, 100]|min)) if lup_pct is not none else '0' }}%"></div>
        <div class="thermo-seg-down" style="width:{{ ('%.2f'|format([ldn_pct, 100]|min)) if ldn_pct is not none else '0' }}%"></div>
        <div class="thermo-seg-other"></div>
      </div>
      <span style="color:var(--down);font-weight:600;min-width:45px">{{ ('%.2f%%'|format(ldn_pct)) if ldn_pct is not none else '—' }}</span>
    </div>
    <div style="font-size:10.5px;color:var(--muted);margin-top:8px">
      {{ t('Green = limit-up breadth · Red = limit-down breadth, as a share of the ~1,585-name universe (limits are rare, so the bar sits low).', '绿色=涨停广度 · 红色=跌停广度，占约1,585只全市场股票的比例（涨跌停罕见，故占比很低）。') }}
    </div>
  </div>

  <div class="limits-charts">
    <!-- Limit Up/Down sparkline -->
    <div class="panel-sm">
      <div class="micro" style="margin-bottom:8px">{{ t('Limit-Up / Down History (90-day)', '涨跌停历史（近90日）') }}</div>
      <canvas id="sp_limits" height="80" style="width:100%;display:block"></canvas>
    </div>
    <!-- Events table -->
    <div class="panel-sm">
      <div class="micro" style="margin-bottom:8px">{{ t('Notable Events — Latest Session', '今日涨跌停事件') }}</div>
      <div class="events-table-scroll">
      <table class="events-table">
        <thead>
          <tr>
            <th>{{ t('Ticker', '代码') }}</th>
            <th>{{ t('Board', '板块') }}</th>
            <th>{{ t('Event', '事件') }}</th>
            <th>{{ t('Close off %', '距限价%') }}</th>
          </tr>
        </thead>
        <tbody id="eventsTableBody"></tbody>
      </table>
      </div>
    </div>
  </div>

  <p class="authority-note" style="margin-top:14px;font-size:11px;color:var(--muted);padding:6px 10px;border-radius:7px;background:color-mix(in srgb,var(--muted) 8%,var(--panel));border:1px solid var(--line)">
    {{ t('CN-SYS-R3: this panel is market-structure context only. Limit-up as a BUY trigger is a standing kill.', 'CN-SYS-R3：本面板仅作市场结构背景。以涨停作为买入触发器已被永久禁止。') }}
  </p>
</section>

<!-- ══ CYCLE PHASE ══════════════════════════════════ -->
<script type="application/json" id="mechData-phaseStrip">{{ phase.phase_strip | tojson }}</script>
<script type="application/json" id="mechData-eraTable">{{ phase.era_table | tojson }}</script>
<script type="application/json" id="mechData-phaseCatalog">{{ phase_catalog | tojson }}</script>
<section class="section">
  <div class="section-hdr">
    <span class="section-dot" id="phaseSectionDot"></span>
    <h2>{{ t('Cycle Phase Memory', '周期阶段记忆') }} {{ help('Current phase classification with confidence, falsifiers, and a 90-session strip. Falsifiers are pre-committed conditions that would prove the current phase call wrong. CN-SYS-R5.', '含置信度的当前阶段分类、证伪条件和90交易日图条。证伪条件是预先提交、一旦触发即证明判断有误的条件。CN-SYS-R5。') }}</h2>
  </div>

  <div style="padding:10px 14px;background:rgba(91,155,240,0.04);border-left:3px solid rgba(91,155,240,0.3);border-radius:0 6px 6px 0;font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px">
    <span class="l-en">Markets move through repeating phases — quiet repair, a policy floor, ignition, mania, and eventual unwind. This names where we are now and lists the pre-committed conditions that would prove the call wrong.</span>
    <span class="l-zh">市场沿着重复的阶段演进——平静修复、政策托底、点火、亢奋，直至去杠杆。本面板标明当前所处阶段，并列出预先设定、一旦触发即证明判断有误的条件。</span>
  </div>

  <div class="panel" style="margin-bottom:16px">
    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start">
      <div>
        <div class="micro" style="margin-bottom:6px">{{ t('Current Phase', '当前阶段') }}</div>
        {% for pc in phase_catalog %}{% if pc.key == phase_name %}
        <div style="font-size:24px;font-weight:700;color:{{ pc.color }}">
          <span class="l-en">{{ pc.name_en|upper }}</span><span class="l-zh">{{ pc.name_zh }}</span>
        </div>
        {% endif %}{% endfor %}
        {% if cp.get('asof') %}<div style="font-size:11px;color:var(--muted)">{{ t('as of', '截至') }} {{ cp.asof }}</div>{% endif %}
        {% if phase.get('days_in_phase') is not none %}
        <div style="font-size:11px;color:var(--muted)">{{ t('Days in phase', '已持续天数') }}: {{ phase.days_in_phase }}</div>
        {% endif %}
      </div>
      <div style="flex:1;min-width:200px">
        <div class="micro" style="margin-bottom:6px">{{ t('Phase Description', '阶段描述') }}</div>
        {% for pc in phase_catalog %}{% if pc.key == phase_name %}
        <p style="font-size:13px;color:var(--muted);line-height:1.6">
          <span class="l-en">{{ pc.meaning_en }}</span>
          <span class="l-zh">{{ pc.meaning_zh }}</span>
        </p>
        {% endif %}{% endfor %}
        {% if cp.get('evidence') %}
        <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">
          {% for e in cp.evidence %}
          <span style="display:inline-block;padding:1px 7px;border-radius:4px;font-size:10px;background:var(--panel2);border:1px solid var(--line);color:var(--muted)">{{ e }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div>
        <div class="micro" style="margin-bottom:6px">{{ t('Confidence', '置信度') }}</div>
        <div style="font-size:24px;font-weight:700" id="phaseConfPct">{{ ('%.0f'|format(conf_val * 100)) if conf_val is not none else '—' }}%</div>
      </div>
    </div>
  </div>

  <!-- Phase strip -->
  <div class="panel-sm" style="margin-bottom:16px">
    <div class="micro" style="margin-bottom:8px">{{ t('90-Session Phase Strip', '近90个交易日阶段图条') }}</div>
    <canvas id="phaseStripCanvas" height="28" style="width:100%;display:block;border-radius:6px"></canvas>
    <div class="phase-strip-label-row" style="margin-top:6px">
      <span>{{ t('~90 sessions ago', '约90个交易日前') }}</span>
      <span>{{ t('Today', '今日') }}</span>
    </div>
    <div class="phase-legend" style="margin-top:8px">
      {% for pc in phase_catalog %}
      <div class="phase-legend-item">
        <div class="phase-dot" style="background:{{ pc.color }}"></div>
        <span class="l-en">{{ pc.name_en }}{% if pc.key == phase_name %} (current){% endif %}</span>
        <span class="l-zh">{{ pc.name_zh }}{% if pc.key == phase_name %}（当前）{% endif %}</span>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- Falsifiers -->
  {% set falsifiers = cp.get('falsifiers') or [] %}
  {% if falsifiers %}
  <div class="micro" style="margin-bottom:10px">{{ t('Armed Falsifiers — What Would Prove This Wrong?', '已激活证伪条件 — 什么情况会证明判断有误？') }}</div>
  <div class="falsifier-list">
    {% for f in falsifiers %}
    <div class="falsifier-item">
      <div class="falsifier-id">{{ f.id }}</div>
      <div class="falsifier-desc">
        <code style="font-size:11px;color:var(--info)">{{ f.expr }}</code>
      </div>
      <div class="falsifier-horizon">{{ f.horizon_d }}{{ t('d', '天') }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- Ledger -->
  {% set ls = phase.get('ledger_summary') or {} %}
  {% if ls %}
  <div class="panel-sm" style="margin-top:12px">
    <div class="micro" style="margin-bottom:10px">{{ t('Falsifier Ledger Summary', '证伪台账摘要') }}</div>
    <div class="ledger-row">
      <div class="ledger-item"><div class="lv info-color">{{ ls.get('total_graded', 0) }}</div><div class="ll">{{ t('Total Graded', '总评分') }}</div></div>
      <div class="ledger-item"><div class="lv up-color">{{ ls.get('held', 0) }}</div><div class="ll">{{ t('Held', '持守') }}</div></div>
      <div class="ledger-item"><div class="lv down-color">{{ ls.get('fired', 0) }}</div><div class="ll">{{ t('Fired', '触发') }}</div></div>
    </div>
    <p style="font-size:10.5px;color:var(--muted);margin-top:10px;line-height:1.5">
      {{ t('"Held" = condition not triggered — phase call consistent with evidence. "Fired" = condition met — phase was subsequently updated. CN-SYS-R5.', '"持守"=条件未触发——阶段判断与证据一致。"触发"=条件满足——阶段随后更新。CN-SYS-R5。') }}
    </p>
  </div>
  {% endif %}

  <!-- Era Table (collapsible) -->
  {% set eras = phase.get('era_table') or [] %}
  {% if eras %}
  <details style="margin-top:16px">
    <summary>{{ t('Historical ERA Table (A-Share Market Phases since 2005)', '历史ERA对照表（2005年以来A股市场阶段）') }}</summary>
    <div style="overflow-x:auto">
    <table class="era-table">
      <thead>
        <tr>
          <th>{{ t('Era', '时代') }}</th>
          <th>{{ t('Period', '时期') }}</th>
          <th>{{ t('Phases Observed', '经历阶段') }}</th>
          <th>{{ t('Notes', '注释') }}</th>
        </tr>
      </thead>
      <tbody id="eraTableBody"></tbody>
    </table>
    </div>
  </details>
  {% endif %}
</section>

<!-- ══ POLICY TAPE ══════════════════════════════════ -->
<script type="application/json" id="mechData-policyEvents">{{ policy.recent_events | tojson }}</script>
<section class="section">
  <div class="section-hdr">
    <span class="section-dot" style="background:var(--orange)"></span>
    <h2>{{ t('Policy Tape', '政策磁带') }}</h2>
  </div>

  <div style="padding:10px 14px;background:rgba(91,155,240,0.04);border-left:3px solid rgba(91,155,240,0.3);border-radius:0 6px 6px 0;font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px">
    <span class="l-en">In China, policy often drives the market. This reads the current policy impulse — from broad easing to targeted support to tightening — and lists recent moves by the PBoC, State Council, CSRC and others, with how fresh each source is.</span>
    <span class="l-zh">在中国，政策常常主导市场。本磁带解读当前政策冲量——从全面宽松、定向支持到收紧——并列出央行、国务院、证监会等近期动作及各来源的数据时效。</span>
  </div>

  {% set impulse = pp.get('policy_impulse') or '—' %}
  {% set impulse_color = {
    'easing': 'var(--up)', 'targeted_support': 'var(--info)',
    'market_rescue': 'var(--warn)', 'neutral': 'var(--muted)',
    'tightening': 'var(--down)'
  }.get(impulse, 'var(--muted)') %}

  <div class="policy-top">
    <div class="impulse-badge" style="background:rgba(91,155,240,0.12);border-color:rgba(91,155,240,0.25)">
      <div class="label">{{ t('Current Impulse', '当前政策冲量') }}</div>
      <div class="val" style="color:{{ impulse_color }}">
        <span class="l-en">{{ impulse.replace('_',' ').title() }}</span>
        <span class="l-zh">{{ td(impulse) if td is defined else impulse.replace('_',' ') }}</span>
      </div>
    </div>
    <div>
      <div class="micro" style="margin-bottom:8px">{{ t('Transmission Channels', '传导渠道') }}</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        {% for ch in pp.get('transmission_channel') or [] %}
        <span style="padding:4px 10px;border-radius:6px;background:rgba(91,155,240,0.12);border:1px solid rgba(91,155,240,0.22);font-size:11px;color:var(--info)">{{ ch.replace('_',' ').title() }}</span>
        {% endfor %}
      </div>
      <div class="micro" style="margin-top:12px;margin-bottom:8px">{{ t('Data Freshness', '数据时效') }}</div>
      <div class="staleness-chips">
        {% set staleness = pp.get('staleness') or {} %}
        {% for src, days in staleness.items() %}
        <span class="stale-chip" style="{% if days <= 3 %}background:rgba(69,184,115,0.10);border-color:rgba(69,184,115,0.2);color:var(--up){% elif days > 30 %}background:rgba(224,100,100,0.10);border-color:rgba(224,100,100,0.22);color:var(--down){% endif %}">{{ src }}: {{ days }}{{ t('d', '天') }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="panel-sm">
    <div class="micro" style="margin-bottom:12px">{{ t('Recent Events', '近期事件') }}</div>
    <div class="policy-events-list" id="policyEventsList"></div>
  </div>
</section>

<!-- ══ CROSS MARKET ══════════════════════════════════ -->
<section class="section">
  <div class="section-hdr">
    <span class="section-dot" style="background:var(--link)"></span>
    <h2>{{ t('Cross-Market Context', '跨市场背景') }} {{ help('CGB (China Government Bond) curve from the yield store. USDCNH is the offshore renminbi rate. All staleness-stamped (CN-SYS-R4).', 'CGB（中国国债）收益率曲线。USDCNH为离岸人民币汇率。所有数据均有时效标记（CN-SYS-R4）。') }}</h2>
    {% if cgb.get('staleness_days') is not none %}
    <span class="stale-chip" style="margin-left:auto">{{ t('CGB', '国债') }} {{ cgb.staleness_days }}{{ t('d stale', '天前') }}</span>
    {% endif %}
  </div>

  <div style="padding:10px 14px;background:rgba(91,155,240,0.04);border-left:3px solid rgba(91,155,240,0.3);border-radius:0 6px 6px 0;font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:16px">
    <span class="l-en">Bonds and the currency frame the backdrop for stocks. A steep government-bond curve (long yields above short) usually points to easing and reflation ahead; a rising offshore yuan (USDCNH) means capital is leaving.</span>
    <span class="l-zh">债券与汇率构成股市的背景。国债收益率曲线陡峭（长端高于短端）通常预示宽松与再通胀；离岸人民币（USDCNH）走高意味着资本外流。</span>
  </div>

  <div class="cross-grid">
    <div class="cgb-wrap">
      <div class="cgb-header">
        <span class="cgb-title">{{ t('China Govt Bond Yield Curve', '中国国债收益率曲线') }}</span>
        {% if cp.get('asof') or as_of %}<span style="font-size:10.5px;color:var(--muted)">{{ t('as of', '截至') }} {{ as_of }}</span>{% endif %}
      </div>
      <svg id="cgbCurve" viewBox="0 0 500 180" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:180px;display:block"></svg>
      <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:4px;padding:0 4px">
        <span>3M<br><strong style="color:var(--info)">{{ ('%.4f%%'|format(cgb.get('m3', 0))) if cgb.get('m3') is not none else '—' }}</strong></span>
        <span style="text-align:center">1Y<br><strong style="color:var(--info)">{{ ('%.4f%%'|format(cgb.get('y1', 0))) if cgb.get('y1') is not none else '—' }}</strong></span>
        <span style="text-align:center">5Y<br><strong style="color:var(--info)">{{ ('%.4f%%'|format(cgb.get('y5', 0))) if cgb.get('y5') is not none else '—' }}</strong></span>
        <span style="text-align:center">10Y<br><strong style="color:var(--info)">{{ ('%.4f%%'|format(cgb.get('y10', 0))) if cgb.get('y10') is not none else '—' }}</strong></span>
        <span style="text-align:right">30Y<br><strong style="color:var(--info)">{{ ('%.4f%%'|format(cgb.get('y30', 0))) if cgb.get('y30') is not none else '—' }}</strong></span>
      </div>
      {% if cgb.get('slope_10y_3m') is not none %}
      <div style="font-size:10.5px;color:var(--muted);margin-top:8px">
        {{ t('Slope 10Y−3M', '斜率10年-3月') }}: <strong style="color:var(--text)">{{ ('%+.2f%%'|format(cgb.slope_10y_3m)) }}</strong>
        {{ t('· Normal upward slope — no inversion signal.', '· 正常向上斜率——无倒挂信号。') }}
      </div>
      {% endif %}
    </div>

    <div>
      {% set cnh_quote = cnh.get('quote') %}
      {% set cnh_chg = cnh.get('chg_pct') %}
      <div class="usdcnh-card" style="margin-bottom:12px">
        <div class="usdcnh-label">{{ t('USD/CNH — Offshore Yuan', 'USD/CNH 美元/离岸人民币') }}</div>
        <div class="usdcnh-rate" style="color:var(--text)">{{ ('%.4f'|format(cnh_quote)) if cnh_quote is not none else '—' }}</div>
        {% if cnh_chg is not none %}
        <div class="usdcnh-chg {{ 'up-color' if cnh_chg < 0 else 'down-color' }}">{{ ('%+.2f%%'|format(cnh_chg)) }}
          <span class="l-en">{{ '· CNH strengthening' if cnh_chg < 0 else '· CNH weakening' }}</span>
          <span class="l-zh">{{ '· 人民币升值' if cnh_chg < 0 else '· 人民币贬值' }}</span>
        </div>
        {% endif %}
        {% if cnh.get('as_of') %}<div style="font-size:10.5px;color:var(--muted);margin-top:6px">{{ t('as of', '截至') }} {{ cnh.as_of }}</div>{% endif %}
      </div>
      {% set yc = cm.get('yield_curve') or {} %}
      {% if yc %}
      <div class="panel-sm" style="font-size:11.5px;color:var(--muted);line-height:1.6">
        <div class="micro" style="margin-bottom:6px">{{ t('Context Note', '背景注释') }}</div>
        {% set cn10 = yc.get('cn_10y') %}
        {% set cn_slope = yc.get('cn_slope_10_2') %}
        <span class="l-en">CN 10Y {{ ('%.2f%%'|format(cn10)) if cn10 is not none else '—' }} · 10y−2y slope {{ ('%+.3f'|format(cn_slope)) if cn_slope is not none else '—' }}</span>
        <span class="l-zh">中国10年期 {{ ('%.2f%%'|format(cn10)) if cn10 is not none else '—' }} · 10年-2年利差 {{ ('%+.3f'|format(cn_slope)) if cn_slope is not none else '—' }}</span>
      </div>
      {% endif %}
      {% set cm_gaps = cm.get('data_gaps') or [] %}
      {% if cm_gaps %}
      <details style="margin-top:8px">
        <summary style="font-size:11px;color:var(--muted)">{{ t('Data gaps', '数据缺口') }}</summary>
        <ul style="font-size:11px;color:var(--muted);margin:4px 0 0;padding-left:14px">
          {% for g in cm_gaps %}<li>{{ g }}</li>{% endfor %}
        </ul>
      </details>
      {% endif %}
    </div>
  </div>
</section>

<!-- ══ GLOSSARY ══════════════════════════════════════ -->
<section class="section">
  <div class="section-hdr">
    <span class="section-dot" style="background:var(--muted)"></span>
    <h2>{{ t('Glossary', '术语表') }}</h2>
  </div>

  <div class="glossary-grid">
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">涨停 Limit-Up</span><span class="l-zh">涨停 Limit-Up</span> <span class="gloss-zh">zhǎng tíng</span></div>
      <div class="gloss-def">
        <span class="l-en">A stock hits its maximum daily gain — +10% on the main board, +20% on STAR Market, +30% on ChiNext. The stock cannot trade above this price for the day. A hallmark of A-share market microstructure.</span>
        <span class="l-zh">股票触及每日最大涨幅——主板+10%，科创板+20%，创业板+30%。当日不得以高于此价格交易。这是A股市场微观结构的标志性机制。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">跌停 Limit-Down</span><span class="l-zh">跌停 Limit-Down</span> <span class="gloss-zh">diē tíng</span></div>
      <div class="gloss-def">
        <span class="l-en">The mirror: maximum daily loss floor. Unlike most markets, A-shares enforce hard daily bands. High limit-down counts signal broad selling pressure or panic.</span>
        <span class="l-zh">对应的跌幅下限。与大多数市场不同，A股执行严格的每日涨跌幅限制。高跌停数量反映大范围抛压或恐慌情绪。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">连板 Lianban</span><span class="l-zh">连板 Lianban</span> <span class="gloss-zh">lián bǎn</span></div>
      <div class="gloss-def">
        <span class="l-en">Consecutive limit-up days. A "3-board" stock (三板) hits limit-up three days in a row. Retail speculators prize high-lianban names as momentum vehicles.</span>
        <span class="l-zh">连续涨停板。"三板"股票连续三日涨停。散户投机者视高连板个股为动量载体。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">炸板 Failed Seal</span><span class="l-zh">炸板 Failed Seal</span> <span class="gloss-zh">zhà bǎn</span></div>
      <div class="gloss-def">
        <span class="l-en">A stock touches the limit-up price intraday but falls back below it by close — the "seal" broke. High failed seals relative to hits = weak speculative conviction.</span>
        <span class="l-zh">股票盘中触及涨停价，但收盘前回落——"封板"失败。相对于涨停数的高炸板比例 = 投机意愿薄弱。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">QVIX 波动率</span><span class="l-zh">QVIX 波动率</span></div>
      <div class="gloss-def">
        <span class="l-en">China's implied volatility index, analogous to VIX. Unlike US VIX where high = fear: in A-shares, high QVIX can co-exist with upside moves.</span>
        <span class="l-zh">中国隐含波动率指数，类似美国VIX。与美国VIX不同（高=恐惧），A股中高QVIX可与上涨并存。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">南向资金 Southbound</span><span class="l-zh">南向资金 Southbound</span></div>
      <div class="gloss-def">
        <span class="l-en">Hong Kong → A-share capital flows via Stock Connect. Southbound = HK/offshore investors buying mainland China stocks.</span>
        <span class="l-zh">通过沪深港通从香港流入A股的资金。南向 = 港澳离岸投资者买入内地股票。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">融资余额 Margin Balance</span><span class="l-zh">融资余额 Margin Balance</span></div>
      <div class="gloss-def">
        <span class="l-en">Total outstanding margin loan balance across the A-share market (in 亿¥). Rising margin = leverage build-up; falling margin = deleveraging.</span>
        <span class="l-zh">A股市场融资余额总量（亿元）。余额上升=杠杆积累；余额下降=去杠杆。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">CGB 国债 China Govt Bond</span><span class="l-zh">CGB 国债</span></div>
      <div class="gloss-def">
        <span class="l-en">Yield curve for PBoC-influenced government bonds. A steep upward slope (short rates low, long rates higher) typically indicates normal easing conditions.</span>
        <span class="l-zh">人民银行影响下的国债收益率曲线。陡峭向上的斜率（短端低、长端高）通常表明正常的宽松环境。</span>
      </div>
    </div>
    <div class="gloss-item">
      <div class="gloss-term"><span class="l-en">USD/CNH 离岸人民币</span><span class="l-zh">USD/CNH 离岸人民币</span></div>
      <div class="gloss-def">
        <span class="l-en">Offshore yuan exchange rate (not the onshore CNY). Strengthening CNH (falling USDCNH) suggests improving offshore sentiment toward China.</span>
        <span class="l-zh">离岸人民币汇率（非在岸CNY）。CNH升值（USDCNH下跌）意味着离岸对华情绪改善。</span>
      </div>
    </div>
  </div>

  <!-- Cycle Phase Meanings — grafted from mech_v2 -->
  {% if phase_catalog %}
  <details style="margin-top:24px;border:1px solid rgba(139,147,161,0.18);border-radius:8px;overflow:hidden">
