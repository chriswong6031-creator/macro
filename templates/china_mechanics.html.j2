<script>
// ── Inline canvas chart renderer ──────────────────────────────────────────────
// Reads data-series="[{d,v},...]" from each canvas, draws a minimal area chart.
// Respects theme CSS variables. Zero-line if data-zero="1".
(function(){
  var CSS = getComputedStyle(document.documentElement);
  function v(name){return CSS.getPropertyValue(name).trim();}

  function drawMiniChart(canvas){
    var raw;
    try { raw = JSON.parse(canvas.getAttribute('data-series')||'[]'); } catch(e){return;}
    if(!raw||!raw.length)return;
    var vals = raw.map(function(p){return p.v;});
    var dates = raw.map(function(p){return p.d;});
    var hasZero = canvas.getAttribute('data-zero') === '1';
    var colorPos = canvas.getAttribute('data-color-pos') || v('--info');
    var colorNeg = canvas.getAttribute('data-color-neg') || '';

    var W = canvas.offsetWidth || 400;
    var H = canvas.offsetHeight || 70;
    canvas.width = W * (window.devicePixelRatio||1);
    canvas.height = H * (window.devicePixelRatio||1);
    var ctx = canvas.getContext('2d');
    ctx.scale(window.devicePixelRatio||1, window.devicePixelRatio||1);

    var nonNull = vals.filter(function(x){return x!==null&&x!==undefined&&!isNaN(x);});
    if(!nonNull.length) return;
    var mn = Math.min.apply(null,nonNull), mx = Math.max.apply(null,nonNull);
    if(mn===mx){mn-=0.1;mx+=0.1;}
    if(hasZero){mn=Math.min(mn,-0.01);mx=Math.max(mx,0.01);}

    var pad = {t:4,b:4,l:2,r:2};
    var aw = W - pad.l - pad.r, ah = H - pad.t - pad.b;
    var n = vals.length;
    function px(i){return pad.l + (i/(n-1||1)) * aw;}
    function py(val){return pad.t + ah - ((val-mn)/(mx-mn)) * ah;}

    // zero line
    if(hasZero){
      var zy = py(0);
      ctx.strokeStyle = v('--line');
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(pad.l, zy);
      ctx.lineTo(pad.l + aw, zy);
      ctx.stroke();
    }

    // segment drawing: positive above zero = colorPos, below = colorNeg or muted
    var i = 0;
    while(i < n){
      if(vals[i]===null||vals[i]===undefined||isNaN(vals[i])){i++;continue;}
      // collect contiguous segment
      var seg = [];
      while(i < n && vals[i]!==null && vals[i]!==undefined && !isNaN(vals[i])){
        seg.push({x:px(i),y:py(vals[i]),v:vals[i]});
        i++;
      }
      if(seg.length < 1) continue;

      var positive = !hasZero || seg[0].v >= 0;
      var fillColor = positive ? colorPos : (colorNeg || v('--muted'));

      // gradient fill
      var grad = ctx.createLinearGradient(0,0,0,H);
      grad.addColorStop(0, fillColor.replace(')',',0.28)').replace('var(','rgba(').replace(')',')'));
      grad.addColorStop(1, fillColor.replace(')',',0.02)').replace('var(','rgba(').replace(')',')'));

      ctx.beginPath();
      ctx.moveTo(seg[0].x, hasZero ? py(0) : H - pad.b);
      for(var j=0;j<seg.length;j++) ctx.lineTo(seg[j].x, seg[j].y);
      ctx.lineTo(seg[seg.length-1].x, hasZero ? py(0) : H - pad.b);
      ctx.closePath();
      ctx.fillStyle = grad;
      ctx.fill();

      // line
      ctx.beginPath();
      ctx.moveTo(seg[0].x, seg[0].y);
      for(var j=1;j<seg.length;j++) ctx.lineTo(seg[j].x, seg[j].y);
      ctx.strokeStyle = fillColor.replace(/var\(([^)]+)\)/, function(_,name){return v(name);});
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    // tooltip on hover
    canvas._mechData = {raw:raw, vals:vals, dates:dates, mn:mn, mx:mx, pad:pad, aw:aw, ah:ah, n:n};
  }

  function drawAllCharts(){
    document.querySelectorAll('canvas.mini-chart').forEach(function(c){ drawMiniChart(c); });
  }

  // ── Phase strip renderer ──────────────────────────────────────────────────
  var PHASE_COLORS = {
    'POLICY_PUT':'#5b9bf0','LIQUIDITY_IGNITION':'#45b873','BROADENING':'#3da564',
    'THEME_LEADERSHIP':'#e08b45','EUPHORIA':'#e06464','DISTRIBUTION':'#e07070',
    'DELEVERAGING':'#c04040','CAPITULATION':'#8b93a1','GRINDING_BEAR':'#a07070',
    'REPAIR':'#7aa7e0'
  };
  function renderPhaseStrip(){
    var el = document.getElementById('phase-strip-cells');
    if(!el) return;
    var strip;
    try { strip = JSON.parse(el.getAttribute('data-strip')||'[]'); } catch(e){return;}
    el.innerHTML = '';
    strip.forEach(function(cell){
      var div = document.createElement('div');
      div.className = 'ps-cell';
      var col = PHASE_COLORS[cell.phase] || '#8b93a1';
      div.style.background = col;
      var tip = document.createElement('div');
      tip.className = 'ps-tip';
      tip.textContent = cell.d + ' ' + cell.phase + (cell.confidence ? ' (' + Math.round(cell.confidence*100) + '%)' : '');
      div.appendChild(tip);
      el.appendChild(div);
    });
  }

  // theme observer: redraw when theme changes (colors change)
  if(window.MutationObserver){
    new MutationObserver(drawAllCharts).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',function(){drawAllCharts();renderPhaseStrip();});
  } else {
    drawAllCharts(); renderPhaseStrip();
  }
})();
</script>
