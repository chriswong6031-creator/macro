{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Neural Web — The intelligence behind every signal</title>
{% set seo_title = "Neural Web — Mastermind" %}{% set seo_desc = "See how Mastermind connects market evidence, challenges conflicting signals and turns the strongest conclusions into clear decisions." %}{% set seo_path = "neural_web.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',th||'dark');var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="product-nav-icons.css">
<style>
  *{box-sizing:border-box}
  body.nw-public{margin:0;color:var(--text);background:var(--bg);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  body.nw-public>.site-nav{max-width:1480px;margin:14px auto 0;padding:0 18px}
  .nw-shell{max-width:1280px;margin:0 auto;padding:18px 24px 84px}
  .nw-hero{position:relative;min-height:590px;display:grid;grid-template-columns:minmax(0,.88fr) minmax(480px,1.12fr);align-items:center;gap:56px;overflow:hidden;padding:62px 58px;border:1px solid color-mix(in srgb,var(--link) 24%,var(--line));border-radius:30px;background:
    radial-gradient(750px 520px at 77% 42%,color-mix(in srgb,#6c63ff 16%,transparent),transparent 68%),
    radial-gradient(620px 430px at 14% 24%,color-mix(in srgb,#3b82f6 12%,transparent),transparent 65%),
    linear-gradient(145deg,color-mix(in srgb,var(--panel) 96%,transparent),color-mix(in srgb,var(--panel2) 96%,transparent));box-shadow:0 36px 90px -54px rgba(24,41,94,.7)}
  .nw-hero:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.4;background-image:linear-gradient(color-mix(in srgb,var(--text) 4%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--text) 4%,transparent) 1px,transparent 1px);background-size:28px 28px;mask-image:linear-gradient(90deg,transparent,#000 42%,#000)}
  .nw-copy{position:relative;z-index:2}
  .nw-kicker{display:inline-flex;align-items:center;gap:9px;margin-bottom:24px;padding:7px 11px;border:1px solid color-mix(in srgb,var(--link) 26%,var(--line));border-radius:999px;color:var(--link);background:color-mix(in srgb,var(--link) 8%,var(--panel));font-size:11px;font-weight:760;letter-spacing:.08em;text-transform:uppercase}
  .nw-kicker i{width:7px;height:7px;border-radius:50%;background:#57d6a4;box-shadow:0 0 0 5px rgba(87,214,164,.12),0 0 16px rgba(87,214,164,.5)}
  .nw-hero h1{max-width:650px;margin:0;color:var(--text);font-size:clamp(42px,5.2vw,73px);font-weight:790;letter-spacing:-.055em;line-height:.98}
  .nw-hero h1 em{font-style:normal;color:transparent;background:linear-gradient(110deg,#5696ff,#716fff 50%,#a571ff);background-clip:text;-webkit-background-clip:text}
  .nw-lede{max-width:580px;margin:26px 0 0;color:var(--muted);font-size:17px;line-height:1.62}
  .nw-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:30px}
  .nw-btn{display:inline-flex;align-items:center;gap:9px;padding:11px 15px;border:1px solid var(--line);border-radius:11px;color:var(--text);background:var(--panel2);font-size:13px;font-weight:680;text-decoration:none;transition:transform .18s,border-color .18s,background .18s}
  .nw-btn.primary{border-color:transparent;color:#fff;background:linear-gradient(130deg,#3478f6,#635bff);box-shadow:0 12px 30px -13px rgba(70,91,245,.75)}
  .nw-btn:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--link) 45%,var(--line))}
  .nw-canvas{position:relative;z-index:1;min-height:460px;display:grid;place-items:center}
  .nw-canvas svg{width:100%;height:auto;overflow:visible;filter:drop-shadow(0 24px 44px rgba(29,45,94,.2))}
  .nw-link{fill:none;stroke:url(#nwEdge);stroke-width:1.25;stroke-linecap:round;stroke-dasharray:4 7;animation:nwFlow 9s linear infinite}
  .nw-link.dim{opacity:.38;animation-duration:13s}
  .nw-pulse{fill:#fff;stroke:#6e72ff;stroke-width:2;filter:url(#nwGlow);animation:nwPulse 3.4s ease-in-out infinite;transform-origin:center}
  .nw-node{fill:color-mix(in srgb,var(--panel) 96%,transparent);stroke:color-mix(in srgb,var(--link) 34%,var(--line));stroke-width:1.3}
  .nw-node-main{fill:url(#nwCore);stroke:rgba(255,255,255,.48);stroke-width:1.5;filter:url(#nwCoreGlow)}
  .nw-node-label{fill:var(--text);font:650 11px Inter,system-ui}
  .nw-node-sub{fill:var(--muted);font:500 8.6px Inter,system-ui}
  .nw-core-label{fill:#fff;font:760 13px Inter,system-ui;letter-spacing:.025em}
  .nw-core-sub{fill:rgba(255,255,255,.74);font:520 8.5px Inter,system-ui}
  .nw-section{padding:92px 0 0}
  .nw-section-head{max-width:720px;margin-bottom:34px}
  .nw-eyebrow{color:var(--link);font-size:11px;font-weight:780;letter-spacing:.09em;text-transform:uppercase}
  .nw-section h2{margin:10px 0 0;color:var(--text);font-size:clamp(30px,3.5vw,48px);letter-spacing:-.045em;line-height:1.06}
  .nw-section-head p{margin:16px 0 0;color:var(--muted);font-size:15px;line-height:1.65}
  .nw-process{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .nw-step{position:relative;min-height:255px;padding:26px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,var(--panel),color-mix(in srgb,var(--panel2) 82%,var(--panel)));overflow:hidden}
  .nw-step:before{content:attr(data-step);position:absolute;right:17px;top:10px;color:color-mix(in srgb,var(--link) 18%,transparent);font-size:72px;font-weight:820;letter-spacing:-.08em}
  .nw-step-icon{width:48px;height:48px;display:grid;place-items:center;margin-bottom:34px;border:1px solid color-mix(in srgb,var(--link) 30%,var(--line));border-radius:14px;color:var(--link);background:color-mix(in srgb,var(--link) 9%,var(--panel2))}
  .nw-step-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .nw-step h3{margin:0 0 9px;font-size:18px;letter-spacing:-.015em}
  .nw-step p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}
  .nw-trust{display:grid;grid-template-columns:1.15fr .85fr;gap:17px}
  .nw-trust-card{padding:29px;border:1px solid var(--line);border-radius:21px;background:var(--panel)}
  .nw-trust-card.large{min-height:310px;background:
    radial-gradient(480px 260px at 85% 0,color-mix(in srgb,#6d68ff 15%,transparent),transparent 68%),var(--panel)}
  .nw-trust-card h3{max-width:580px;margin:0;font-size:25px;letter-spacing:-.03em}
  .nw-trust-card p{max-width:630px;margin:13px 0 0;color:var(--muted);line-height:1.65}
  .nw-verdicts{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:34px}
  .nw-verdict{padding:14px;border:1px solid var(--line);border-radius:13px;background:color-mix(in srgb,var(--panel2) 78%,transparent)}
  .nw-verdict b{display:block;font-size:12px}
  .nw-verdict span{display:block;margin-top:5px;color:var(--muted);font-size:10px}
  .nw-checks{display:grid;gap:12px;margin-top:24px}
  .nw-check{display:grid;grid-template-columns:28px 1fr;gap:11px;align-items:start}
  .nw-check i{width:26px;height:26px;display:grid;place-items:center;border-radius:50%;color:#58d6a4;background:rgba(88,214,164,.11);font-style:normal;font-size:12px;font-weight:800}
  .nw-check b{display:block;font-size:13px}
  .nw-check span{display:block;margin-top:2px;color:var(--muted);font-size:11px;line-height:1.45}
  .nw-final{margin-top:92px;padding:48px;border:1px solid color-mix(in srgb,var(--link) 30%,var(--line));border-radius:25px;text-align:center;background:radial-gradient(600px 260px at 50% 0,color-mix(in srgb,var(--link) 15%,transparent),transparent 70%),var(--panel)}
  .nw-final h2{margin:0 auto;max-width:760px;font-size:clamp(31px,4vw,50px)}
  .nw-final p{max-width:650px;margin:16px auto 25px;color:var(--muted);line-height:1.6}
  @keyframes nwFlow{to{stroke-dashoffset:-88}}
  @keyframes nwPulse{0%,100%{opacity:.75;transform:scale(.85)}50%{opacity:1;transform:scale(1.14)}}
  @media(max-width:980px){.nw-hero{grid-template-columns:1fr;padding:46px 34px}.nw-canvas{min-height:390px}.nw-process,.nw-trust{grid-template-columns:1fr}.nw-hero:before{mask-image:linear-gradient(transparent,#000)}}
  @media(max-width:620px){body.nw-public>.site-nav{padding:0 12px}.nw-shell{padding:12px 12px 60px}.nw-hero{min-height:0;padding:34px 21px;border-radius:22px}.nw-hero h1{font-size:42px}.nw-lede{font-size:15px}.nw-canvas{min-height:300px}.nw-section{padding-top:66px}.nw-step{min-height:220px}.nw-trust-card,.nw-final{padding:24px}.nw-verdicts{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.nw-link,.nw-pulse{animation:none}}
</style>
</head>
<body class="nw-public">
{% include "_site_nav.html.j2" %}
<main class="nw-shell">
  <section class="nw-hero">
    <div class="nw-copy">
      <div class="nw-kicker"><i></i>{{ t('Neural Web · Live system', '智脑网络 · 实时系统') }}</div>
      <h1>{{ t('Signals do not arrive <em>unchallenged.</em>', '信号不会在<em>未经质疑</em>的情况下到达。') }}</h1>
      <p class="nw-lede">{{ t('The Neural Web connects market evidence, tests conflicting explanations and only promotes conclusions that survive the debate.', '智脑网络连接市场证据，检验相互冲突的解释，并只采用经得起审议的结论。') }}</p>
      <div class="nw-actions">
        <a class="nw-btn primary" href="intelligence_hub.html">{{ t('Explore Intelligence Hub', '探索情报中心') }} <span aria-hidden="true">→</span></a>
        <a class="nw-btn" href="reports.html">{{ t('Read our research', '阅读研究报告') }}</a>
      </div>
    </div>
    <div class="nw-canvas" aria-label="Animated map of evidence moving through the Neural Web">
      <svg viewBox="0 0 650 500" role="img">
        <defs>
          <linearGradient id="nwEdge" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#42a6ff"/><stop offset=".5" stop-color="#7469ff"/><stop offset="1" stop-color="#a66cff"/></linearGradient>
          <linearGradient id="nwCore" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#347ff5"/><stop offset=".55" stop-color="#625cff"/><stop offset="1" stop-color="#9a65ff"/></linearGradient>
          <filter id="nwGlow"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          <filter id="nwCoreGlow"><feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#4f5eff" flood-opacity=".35"/></filter>
        </defs>
        <path class="nw-link" d="M132 96C232 100 238 194 324 247"/><path class="nw-link dim" d="M132 250C225 250 239 248 324 247"/>
        <path class="nw-link" d="M135 404C220 392 251 292 324 247"/><path class="nw-link dim" d="M518 91C426 105 415 188 324 247"/>
        <path class="nw-link" d="M518 248C427 248 411 248 324 247"/><path class="nw-link dim" d="M516 406C430 389 401 293 324 247"/>
        <path class="nw-link dim" d="M132 96C248 22 404 24 518 91"/><path class="nw-link dim" d="M135 404C245 470 399 472 516 406"/>
        <g transform="translate(42 55)"><rect class="nw-node" width="132" height="80" rx="18"/><text class="nw-node-label" x="18" y="33">Market structure</text><text class="nw-node-sub" x="18" y="53">Breadth · flow · volatility</text></g>
        <g transform="translate(38 210)"><rect class="nw-node" width="142" height="80" rx="18"/><text class="nw-node-label" x="18" y="33">Macro regime</text><text class="nw-node-sub" x="18" y="53">Growth · inflation · policy</text></g>
        <g transform="translate(45 365)"><rect class="nw-node" width="136" height="80" rx="18"/><text class="nw-node-label" x="18" y="33">Positioning</text><text class="nw-node-sub" x="18" y="53">Funds · options · leadership</text></g>
        <g transform="translate(474 52)"><rect class="nw-node" width="140" height="80" rx="18"/><text class="nw-node-label" x="18" y="33">Real activity</text><text class="nw-node-sub" x="18" y="53">Demand · supply · catalysts</text></g>
        <g transform="translate(468 208)"><rect class="nw-node" width="148" height="80" rx="18"/><text class="nw-node-label" x="18" y="33">Counter-evidence</text><text class="nw-node-sub" x="18" y="53">Contradictions · uncertainty</text></g>
        <g transform="translate(470 365)"><rect class="nw-node" width="142" height="80" rx="18"/><text class="nw-node-label" x="18" y="33">Market memory</text><text class="nw-node-sub" x="18" y="53">History · regimes · outcomes</text></g>
        <g transform="translate(258 181)"><rect class="nw-node-main" width="148" height="132" rx="34"/><text class="nw-core-label" x="74" y="58" text-anchor="middle">NEURAL WEB</text><text class="nw-core-sub" x="74" y="79" text-anchor="middle">challenge · weigh · decide</text><circle class="nw-pulse" cx="74" cy="101" r="5"/></g>
      </svg>
    </div>
  </section>

  <section class="nw-section">
    <header class="nw-section-head">
      <div class="nw-eyebrow">{{ t('How it works', '工作方式') }}</div>
      <h2>{{ t('Evidence becomes a decision through three gates.', '证据通过三道关卡成为决策。') }}</h2>
      <p>{{ t('The public view explains the trust model without exposing the proprietary scoring methods that power it.', '公开页面解释可信机制，同时不披露其背后的专有评分方法。') }}</p>
    </header>
    <div class="nw-process">
      <article class="nw-step" data-step="01">
        <div class="nw-step-icon"><svg viewBox="0 0 24 24"><circle cx="6" cy="7" r="2.5"/><circle cx="18" cy="7" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="m8.3 8.3 2.6 7M15.7 8.3l-2.6 7M8.5 7h7"/></svg></div>
        <h3>{{ t('Connect the evidence', '连接证据') }}</h3>
        <p>{{ t('Market structure, macro, positioning and real activity are read together instead of as isolated indicators.', '市场结构、宏观、仓位与真实活动被综合分析，而非作为孤立指标。') }}</p>
      </article>
      <article class="nw-step" data-step="02">
        <div class="nw-step-icon"><svg viewBox="0 0 24 24"><path d="M5 5h14v14H5zM5 12h14M12 5v14"/><path d="m7.5 9 2-2m5 10 2-2"/></svg></div>
        <h3>{{ t('Challenge the conclusion', '质疑结论') }}</h3>
        <p>{{ t('Competing explanations and contradicting evidence must be considered before a signal can advance.', '信号在推进前必须考虑相互竞争的解释与矛盾证据。') }}</p>
      </article>
      <article class="nw-step" data-step="03">
        <div class="nw-step-icon"><svg viewBox="0 0 24 24"><path d="M5 13.5 9.2 17 19 6.5"/><circle cx="12" cy="12" r="9"/></svg></div>
        <h3>{{ t('Promote with context', '结合背景输出') }}</h3>
        <p>{{ t('Only the clearest conclusions reach the dashboard, accompanied by uncertainty, timing and what could disprove them.', '只有最清晰的结论才会进入仪表盘，并附有不确定性、时机及改判条件。') }}</p>
      </article>
    </div>
  </section>

  <section class="nw-section">
    <header class="nw-section-head">
      <div class="nw-eyebrow">{{ t('Built for trust', '为信任而构建') }}</div>
      <h2>{{ t('A signal should explain why it deserves attention.', '信号应该解释为何值得关注。') }}</h2>
    </header>
    <div class="nw-trust">
      <article class="nw-trust-card large">
        <h3>{{ t('Agreement is useful. Honest disagreement is more useful.', '一致意见有用，诚实的分歧更有用。') }}</h3>
        <p>{{ t('The Neural Web preserves opposing evidence instead of hiding it. That makes conviction easier to calibrate and prevents one loud input from dominating the answer.', '智脑网络保留反对证据，而不是将其隐藏。这有助于校准信心，并防止单一强势输入主导答案。') }}</p>
        <div class="nw-verdicts">
          <div class="nw-verdict"><b>{{ t('Supporting', '支持') }}</b><span>{{ t('Evidence moving together', '相互印证的证据') }}</span></div>
          <div class="nw-verdict"><b>{{ t('Challenging', '质疑') }}</b><span>{{ t('Evidence pushing back', '反向证据') }}</span></div>
          <div class="nw-verdict"><b>{{ t('Unresolved', '未决') }}</b><span>{{ t('What still needs proof', '仍需验证的部分') }}</span></div>
        </div>
      </article>
      <article class="nw-trust-card">
        <h3>{{ t('Every promoted read carries context.', '每项输出都带有背景。') }}</h3>
        <div class="nw-checks">
          <div class="nw-check"><i>✓</i><div><b>{{ t('Freshness', '时效性') }}</b><span>{{ t('Whether the evidence is current', '证据是否为最新') }}</span></div></div>
          <div class="nw-check"><i>✓</i><div><b>{{ t('Confidence', '信心水平') }}</b><span>{{ t('How much agreement exists', '当前一致程度') }}</span></div></div>
          <div class="nw-check"><i>✓</i><div><b>{{ t('Change conditions', '改判条件') }}</b><span>{{ t('What would change the conclusion', '何种情况会改变结论') }}</span></div></div>
          <div class="nw-check"><i>✓</i><div><b>{{ t('Time horizon', '时间范围') }}</b><span>{{ t('When the signal is meant to matter', '信号应在何时发挥作用') }}</span></div></div>
        </div>
      </article>
    </div>
  </section>

  <section class="nw-final">
    <h2>{{ t('See the conclusions, not the machinery.', '查看结论，而非复杂机器。') }}</h2>
    <p>{{ t('The Intelligence Hub turns this continuous debate into a clear, ranked view of what matters now.', '情报中心将持续的分析与审议转化为当前最重要事项的清晰排序。') }}</p>
    <a class="nw-btn primary" href="intelligence_hub.html">{{ t('Open Intelligence Hub', '打开情报中心') }} <span aria-hidden="true">→</span></a>
  </section>
</main>
<script src="theme.js"></script>
<script src="account.js"></script>
</body>
</html>
