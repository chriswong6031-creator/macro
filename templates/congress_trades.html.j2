  <p class="mut2" style="font-size:10.5px;margin-top:9px;border-top:1px solid var(--line);padding-top:7px">{{ t('T0 = 3-day-frame StochRSI under 30 with a same-day daily StochRSI up-cross (RSI14/Stoch14/3/3). Beta — an early, unproven flag; not a buy signal.', 'T0 = 3日框架StochRSI低于30且当日日线StochRSI上穿（RSI14/Stoch14/3/3）。测试版 — 早期且未经验证的提示，并非买入信号。') }}</p>
</div>

{# ---------------- the raw disclosure feed ---------------- #}
<div class="cg-card">
  <h2>🗳️ {{ t('Recent disclosures', '最新披露') }}
      <span class="h-note">— {{ t('newest filings first; ExcessReturn = cumulative excess vs SPY since trade date (horizon-inconsistent — older trades have more time to compound)','最新申报在前；超额收益 = 自交易日起累计超越标普（时间不一致——老交易有更多时间复利）') }}</span></h2>
  {% if feed %}
  <table class="ad"><thead><tr>
    <th>{{ t('Disclosed','披露日') }}</th>
    <th>{{ t('Member','议员') }}</th>
    <th>{{ t('Chamber','议院') }}</th>
    <th>{{ t('Side','方向') }}</th>
    <th>{{ t('Ticker','标的') }}</th>
    <th class="num">{{ t('Amount','金额') }}</th>
    <th class="num">{{ t('vs SPY','相对标普') }}</th>
    <th>{{ t('Traded','交易日') }}</th>
    <th class="num">{{ t('Tx age','交易年龄') }}</th>
    <th class="num">{{ t('Filing lag','申报滞后') }}</th>
  </tr></thead><tbody>
  {% for r in feed %}
    <tr>
      <td class="num mut2">{{ r.report_date or '—' }}</td>
      <td>{{ r.representative or '—' }}{% if r.party in ('D','R') %} <span class="cg-mem {{ r.party }}">{{ r.party }}</span>{% endif %}</td>
      <td class="mut2">{{ r.chamber }}</td>
      <td><span class="side-chip {{ r.side }}">{{ r.side|upper }}</span></td>
      <td><span class="tk"><a href="stock.html#{{ r.ticker }}">{{ r.ticker }}</a></span>{% if r.name %} <span class="mut2" style="font-size:10.5px">{{ r.name[:22] }}</span>{% endif %}</td>
      <td class="num">{{ amt(r) }}</td>
      <td class="num {{ 'r-pos' if (r.excess_return or 0) > 0 else ('r-neg' if (r.excess_return or 0) < 0 else '') }}">{% if r.excess_return is not none %}{{ '%+.1f'|format(r.excess_return) }}%{% else %}—{% endif %}</td>
      <td class="num mut2">{{ r.transaction_date or '—' }}</td>
      <td class="num mut2">{% if r.tx_age_days is not none %}{{ r.tx_age_days }}d{% else %}—{% endif %}</td>
      <td class="num {% if r.late_filing %}r-neg{% else %}mut2{% endif %}">
        {% if r.filing_lag_days is not none %}{{ r.filing_lag_days }}d{% if r.late_filing %} ⚠️{% endif %}{% else %}—{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody></table>
  {% else %}<p class="mut2">{{ t('No disclosures yet.', '暂无披露。') }}</p>{% endif %}
</div>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  'use strict';
  var table   = document.getElementById('cgWatchTable');
  var bar     = document.getElementById('cgFilterBar');
  var countEl = document.getElementById('cgFilterCount');
  var resetEl = document.getElementById('cgFilterReset');
  var recency = document.getElementById('cgRecency');
  if (!table || !bar) return;

  var rows = Array.from(table.querySelectorAll('tbody tr'));
  var total = rows.length;

  // chip state: multi-select for indicator chips, single for recency
  var activeChips = new Set();
  var activeDays  = 0; // 0 = Any

  // --- count helpers ---
  function rowMatches(tr, chips, days) {
    if (days > 0) {
      // unknown transaction age passes only the "Any" window
      var age = tr.getAttribute('data-txage');
      if (age === '' || age === null || parseInt(age, 10) > days) return false;
    }
    if (chips.size === 0) return true;
    // OR logic: pass if any active chip matches
    for (var chip of chips) {
      if (chip === 'prime'  && tr.getAttribute('data-prime')  === '1') return true;
      if (chip === 'setup'  && tr.getAttribute('data-setup')  === '1') return true;
      if (chip === 'w2w'    && tr.getAttribute('data-w2w')    === '1') return true;
      if (chip === 'w1m'    && tr.getAttribute('data-w1m')    === '1') return true;
      if (chip === 'dual'   && tr.getAttribute('data-dual')   === '1') return true;
      if (chip === 'fresh'  && tr.getAttribute('data-fresh')  === '1') return true;
      if (chip === 'wmacd') {
        var wm = tr.getAttribute('data-wmacd');
        if (wm === 'crossed' || wm === 'approaching') return true;
      }
      if (chip === 'wstoch') {
        var ws = tr.getAttribute('data-wstoch');
        if (ws === 'crossed' || ws === 'approaching') return true;
      }
    }
    return false;
  }

  function countFor(chip) {
    var n = 0;
    rows.forEach(function(tr) {
      var testSet = new Set(activeChips);
      testSet.add(chip);
      if (rowMatches(tr, testSet, activeDays)) n++;
    });
    return n;
  }

  function updateCounts() {
    bar.querySelectorAll('[data-fcount]').forEach(function(el) {
      var key = el.getAttribute('data-fcount');
      el.textContent = '(' + countFor(key) + ')';
    });
  }

  function applyFilters() {
    var visible = 0;
    rows.forEach(function(tr) {
      var show = rowMatches(tr, activeChips, activeDays);
      tr.classList.toggle('cg-hide', !show);
      if (show) visible++;
    });
    var hasFilter = activeChips.size > 0 || activeDays > 0;
    if (countEl) {
      countEl.textContent = hasFilter
        ? ('showing ' + visible + ' of ' + total)
        : '';
    }
    if (resetEl) {
      resetEl.style.display = hasFilter ? 'inline' : 'none';
    }
    updateCounts();
  }

  // indicator chip toggles
  bar.querySelectorAll('[data-filter]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.getAttribute('data-filter');
      if (activeChips.has(key)) {
        activeChips.delete(key);
        btn.setAttribute('aria-pressed', 'false');
      } else {
        activeChips.add(key);
        btn.setAttribute('aria-pressed', 'true');
      }
      applyFilters();
    });
    // native <button> handles Enter/Space itself — an extra keydown handler would double-toggle
  });

  // recency buttons
  if (recency) {
    recency.querySelectorAll('button').forEach(function(btn) {
      btn.addEventListener('click', function() {
        activeDays = parseInt(btn.getAttribute('data-days'), 10) || 0;
        recency.querySelectorAll('button').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        applyFilters();
      });
    });
  }

  // reset
  if (resetEl) {
    resetEl.addEventListener('click', function() {
      activeChips.clear();
      activeDays = 0;
      bar.querySelectorAll('[data-filter]').forEach(function(b) { b.setAttribute('aria-pressed','false'); });
      if (recency) {
        recency.querySelectorAll('button').forEach(function(b) { b.classList.remove('active'); });
        var firstBtn = recency.querySelector('button');
        if (firstBtn) firstBtn.classList.add('active');
      }
      applyFilters();
    });
    resetEl.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); resetEl.click(); }
    });
  }

  // initial counts
  updateCounts();
})();
</script>
{% endblock body_scripts %}
