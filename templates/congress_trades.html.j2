{% extends "report_base.html.j2" %}
{% import "_desk_grader_panel.html.j2" as dg %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% macro money(v) -%}
{% if v is none or v != v %}—{% else %}${{ '{:,.0f}'.format(v|float) }}{% endif %}
{%- endmacro %}
{% macro bar(v) -%}
{% if v is none %}<span class="mut2">—</span>{% else %}<span class="cg-score"><span class="cg-bar {{ 'hi' if v>=66 else ('mid' if v>=40 else 'lo') }}"><i style="width:{{ v }}%"></i></span><span class="cg-num">{{ v|round|int }}</span></span>{% endif %}
{%- endmacro %}
{% macro num(v) -%}
{% if v is none %}<span class="mut2" title="no engine coverage">—</span>{% else %}<span class="cg-num">{{ v|round|int }}</span>{% endif %}
{%- endmacro %}
{% macro amt(r) -%}
{% if r.amount_low is not none and r.amount_high is not none and r.amount_low != r.amount_high %}{{ money(r.amount_low) }}–{{ money(r.amount_high) }}{% else %}{{ money(r.amount_mid) }}{% endif %}
{%- endmacro %}

{% block title %}Congressional Trades — Macro Dashboard{% endblock %}

{% block base_css %}
  .cg-hero { margin:26px auto 10px; max-width:1060px; }
  .cg-hero h1 { font-size:26px; margin:6px 0 4px; }
  .cg-sub { color:var(--muted); font-size:13px; max-width:820px; }
  .cg-meta { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0 4px; }
  .cg-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; max-width:1060px; margin:16px auto 4px; }
  @media (max-width:680px){ .cg-stats { grid-template-columns:repeat(2,1fr); } }
  .cg-stat { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:12px 14px; }
  .cg-stat .k { font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }
  .cg-stat .v { font-size:24px; font-weight:650; font-variant-numeric:tabular-nums; margin-top:6px; }
  .cg-card { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin:16px auto; max-width:1060px; }
  .cg-card h2 { font-size:15px; margin:0 0 4px; display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
  .cg-card .h-note { font-size:12px; color:var(--muted); font-weight:400; }
  table.ad { width:100%; border-collapse:collapse; font-size:12.5px; }
  table.ad th { text-align:left; color:var(--muted); font-weight:600; border-bottom:1px solid var(--line); padding:6px 8px; white-space:nowrap; }
  table.ad td { padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  table.ad tr:last-child td { border-bottom:none; }
  .tk { font-weight:700; font-variant-numeric:tabular-nums; }
  .tk a { color:inherit; text-decoration:none; }
  .tk a:hover { text-decoration:underline; }
  .num, td.num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .mut2 { color:var(--muted); }
  .cg-score { display:inline-flex; align-items:center; gap:7px; min-width:96px; }
  .cg-bar { position:relative; flex:1; min-width:54px; height:7px; border-radius:4px; background:var(--panel2); overflow:hidden; }
  .cg-bar i { position:absolute; left:0; top:0; bottom:0; border-radius:4px; background:var(--link); }
  .cg-bar.hi i { background:#1f9a55; } .cg-bar.mid i { background:#5b8def; } .cg-bar.lo i { background:var(--muted); }
  html[data-theme="dark"] .cg-bar.hi i { background:#3fc07e; }
  .cg-num { font-variant-numeric:tabular-nums; font-weight:700; }
  .cg-flag { display:inline-block; padding:1px 7px; border-radius:5px; font-size:10px; font-weight:700; letter-spacing:.02em; white-space:nowrap; }
  .cg-flag.act  { background:#1f9a5522; color:#1f9a55; } html[data-theme="dark"] .cg-flag.act { color:#3fc07e; }
  .cg-flag.wait { background:#e0973a22; color:#c77a1f; } html[data-theme="dark"] .cg-flag.wait { color:#e0973a; }
  .cg-flag.imp  { background:#5b8def22; color:#5b8def; }
  .cg-flag.bip  { background:var(--panel2); color:var(--text); border:1px solid var(--line); }
  .cg-flag.etf  { background:#a56eff22; color:#8b5cf6; border:1px solid #8b5cf644; }
  .cg-flag.stale{ background:var(--panel2); color:var(--muted); border:1px solid var(--line); font-size:9.5px; }
  .cg-flag.late { background:#e0393922; color:#c82828; font-size:9.5px; }
  .cg-flag.gate-t1 { background:#f59e0b22; color:#d97706; font-weight:800; font-size:10px; }
  .cg-flag.gate-t2 { background:#3b82f622; color:#2563eb; font-weight:800; font-size:10px; }
  .cg-flag.gate-t3 { background:#10b98122; color:#059669; font-weight:700; font-size:10px; }
  html[data-theme="dark"] .cg-flag.gate-t1 { color:#fbbf24; }
  html[data-theme="dark"] .cg-flag.gate-t2 { color:#60a5fa; }
  html[data-theme="dark"] .cg-flag.gate-t3 { color:#34d399; }
  .cg-flag.t0 { background:#0ea5e922; color:#0284c7; font-weight:800; } html[data-theme="dark"] .cg-flag.t0 { color:#38bdf8; }
  .cg-mem { display:inline-block; font-size:10.5px; color:var(--muted); padding:0 5px; border:1px solid var(--line); border-radius:5px; margin:1px 2px 1px 0; white-space:nowrap; }
  .cg-mem.D { border-color:#5b8def88; } .cg-mem.R { border-color:#d23f3f88; }
  .side-chip { display:inline-block; padding:1px 7px; border-radius:5px; font-size:10.5px; font-weight:700; }
  .side-chip.buy  { background:#1f9a5522; color:#1f9a55; } html[data-theme="dark"] .side-chip.buy { color:#3fc07e; }
  .side-chip.sell { background:#d23f3f22; color:#d23f3f; } html[data-theme="dark"] .side-chip.sell { color:#ef6a6a; }
  .feedlink { font-size:11.5px; }
  .mb-tier-proven { color:#1f9a55; font-weight:700; } html[data-theme="dark"] .mb-tier-proven { color:#3fc07e; }
  .mb-tier-watch  { color:#5b8def; font-weight:600; }
  .mb-tier-limited{ color:var(--muted); }
  .member-chip { display:inline-block; font-size:9.5px; padding:1px 5px; border-radius:4px; border:1px solid var(--line); background:var(--panel2); color:var(--muted); white-space:nowrap; margin-left:3px; }
  .member-chip.proven { border-color:#1f9a5544; color:#1f9a55; background:#1f9a5511; }
  .member-chip.watch  { border-color:#5b8def44; color:#5b8def; }
  html[data-theme="dark"] .member-chip.proven { color:#3fc07e; }
{% endblock %}

{% block content %}
<section class="cg-hero">
  <p class="eyebrow">🏛️ {{ t('Politician-Disclosed Trades Desk', '政界披露交易台') }}</p>
  <h1>{{ t('Congressional Trades', '国会交易') }}</h1>
  <p class="cg-sub">{{ t(
     'Every member of the U.S. House and Senate must disclose their stock trades (the STOCK Act). We pull those filings from Quiver Quantitative and turn them into a copy-signal watchlist: a ticker joins the moment a member discloses a trade in it and stays ~6 months from its latest transaction before falling off. Names disclosed by more — and bipartisan — members rank as more important. Each name is then scored on the politician cluster, the engine technical read, and a sector/theme buyable-zone gate. The cluster generates the idea; the engine confirms it — a heavily-bought name that is extended or rolling over is high-interest but not "act now." Display / research only.',
     '美国国会参众两院议员必须披露其股票交易（STOCK 法案）。我们从 Quiver Quantitative 获取这些申报，转化为可跟单的观察清单：一旦有议员披露某标的交易，它即进入清单，并从最近一次交易日起保留约 6 个月后移出。被更多议员（尤其两党共同）披露的名字更重要。随后按政界集群、引擎技术面与板块/主题可买区间评分。集群产生想法，引擎负责确认——被大量买入但已过度拉升或走弱的名字关注度高，但并非"现在就买"。仅供展示/研究。') }}</p>
  <div class="cg-meta">
    <span class="chip tag-event">Quiver Quantitative</span>
    <span class="chip">{{ t('As of', '截至') }} {{ summary.as_of }}</span>
    <span class="chip">{{ t('Window', '窗口') }} {{ window_days }}d</span>
    <span class="chip">{{ '{:,}'.format(summary.n_total) }} {{ t('disclosures tracked', '累计披露') }}</span>
    <a class="chip feedlink" href="altdata/feed.json">🧠 {{ t('Brain feed (JSON)', '大脑数据流 (JSON)') }}</a>
  </div>
</section>

<div class="cg-stats">
  <div class="cg-stat"><div class="k">{{ t('Watchlist', '观察标的') }}</div><div class="v">{{ summary.n_tickers }}</div></div>
  <div class="cg-stat"><div class="k">{{ t('Important', '重点') }}</div><div class="v">{{ summary.n_important }}</div></div>
  <div class="cg-stat"><div class="k">{{ t('Bipartisan', '两党') }}</div><div class="v">{{ summary.n_bipartisan }}</div></div>
  <div class="cg-stat"><div class="k">{{ t('Act-now', '现在可买') }}</div><div class="v">{{ summary.n_act_now }}</div></div>
</div>

{# ---------------- the scored watchlist ---------------- #}
<div class="cg-card">
  <h2>🎯 {{ t('Watchlist — ranked copy candidates', '观察清单 — 跟单候选排名') }}
      <span class="h-note">— {{ t('composite = ', '综合分 = ') }}{{ (weights.cluster*100)|round|int }}% {{ t('cluster','集群') }} · {{ (weights.technical*100)|round|int }}% {{ t('technical','技术面') }} · {{ (weights.zone*100)|round|int }}% {{ t('zone','区间') }}</span></h2>
  {% if items %}
  <table class="ad"><thead><tr>
    <th>#</th>
    <th>{{ t('Ticker','标的') }}</th>
    <th class="num">{{ t('Composite','综合分') }}</th>
    <th class="num">{{ t('Cluster','集群') }}</th>
    <th class="num">{{ t('Tech','技术') }}</th>
    <th class="num">{{ t('Zone','区间') }}</th>
    <th class="num">{{ t('Net','净') }}</th>
    <th>{{ t('Members + Skill','议员+技能') }}</th>
    <th>{{ t('Provenance','来源信息') }}</th>
    <th>{{ t('Engine read','引擎研判') }}</th>
  </tr></thead><tbody>
  {% for it in items %}
    <tr>
      <td class="mut2">{{ loop.index }}</td>
      <td>
        <span class="tk"><a href="stock.html#{{ it.ticker }}">{{ it.ticker }}</a></span>
        {% if it.gate_tier %}<span class="cg-flag gate-{{ it.gate_tier|lower }}" data-tip-en="⚡ Prime entry — signal gate {{ it.gate_tier }}" data-tip-zh="⚡ 优质入场 — 信号门 {{ it.gate_tier }}">⚡ {{ it.gate_tier }}</span>{% endif %}
        {% if it.t0 %}<span class="cg-flag t0" title="T0 beta — washed out on the 3-day frame (slow StochRSI {{ it.t0_d3k }}) and the daily StochRSI just crossed up. Early, unproven; not a buy signal.">T0</span>{% endif %}
        {% if it.name %}<div class="mut2" style="font-size:10.5px">{{ it.name[:26] }}</div>{% endif %}
      </td>
      <td>{{ bar(it.composite) }}</td>
      <td class="num">{{ num(it.cluster_score) }}</td>
      <td class="num">{{ num(it.technical_score) }}</td>
      <td class="num">{{ num(it.zone_score) }}</td>
      <td class="num"><span class="r-pos">{{ it.n_buys }}B</span>{% if it.n_sells %} / <span class="r-neg">{{ it.n_sells }}S</span>{% endif %}</td>
      <td>
        <b class="cg-num">{{ it.n_distinct_members }}</b>
        {% for m in it.member_detail[:3] %}
          {%- set tip_en = m.chamber ~ ' · ' ~ m.n ~ ' disclosure(s)' -%}
          {%- if m.member_tier and m.member_n_eff is not none and m.member_n_eff >= 3 -%}
            {%- set hit_pct = (m.member_shrunk_hit * 100)|round|int -%}
            {%- set tip_en = tip_en ~ ' · hit ' ~ hit_pct ~ '% (n=' ~ m.member_n_eff ~ ', shrunk) · ' ~ m.member_tier -%}
          {%- endif -%}
          <span class="cg-mem {{ m.party }}" data-tip-en="{{ tip_en }}">{{ m.representative }}{% if m.last_side=='buy' %} ▲{% elif m.last_side=='sell' %} ▼{% endif %}</span>
          {%- if m.member_tier in ('proven', 'watch') and m.member_n_eff is not none and m.member_n_eff >= 3 %}
            {%- set hit_pct2 = (m.member_shrunk_hit * 100)|round|int %}
            <span class="member-chip {{ m.member_tier }}">{{ hit_pct2 }}% · n={{ m.member_n_eff }} · {{ m.member_tier }}</span>
          {% endif %}
        {% endfor %}
        {% if it.member_detail|length > 3 %}<span class="mut2" style="font-size:10.5px">+{{ it.member_detail|length - 3 }}</span>{% endif %}
      </td>
      <td>
        {% if it.act_now %}<span class="cg-flag act">{{ t('act now','现在') }}</span>
        {% elif it.blocked or it.downtrend %}<span class="cg-flag wait">{{ t('wait','等待') }}</span>
        {% elif it.extended %}<span class="cg-flag wait">{{ t('wait','等待') }}</span>{% endif %}
        {% if it.important %}<span class="cg-flag imp">{{ t('important','重点') }}</span>{% endif %}
        {% if it.bipartisan %}<span class="cg-flag bip">{{ t('bipartisan','两党') }}</span>{% endif %}
        {% if it.is_etf %}<span class="cg-flag etf" data-tip-en="ETF — individual conviction is fund-level, not stock-picking" data-tip-zh="ETF — 个人信念是基金层面，非选股">ETF</span>{% endif %}
        {% if it.single_member %}<span class="cg-flag stale" data-tip-en="Single member only — lower cluster signal" data-tip-zh="仅1位议员 — 集群信号较弱">1 member</span>{% endif %}
        {% if it.all_stale %}<span class="cg-flag stale" data-tip-en="All transactions &gt;90d ago — stale position" data-tip-zh="所有交易超90天前 — 陈旧仓位">stale</span>{% endif %}
        {% if it.any_late_filing %}<span class="cg-flag late" data-tip-en="At least one filing exceeded the 45-day STOCK Act deadline" data-tip-zh="至少一笔申报超过 STOCK 法案 45 天截止日">late ⚠️</span>{% endif %}
      </td>
      <td class="mut2" style="font-size:11.5px">
        {{ it.timing or '—' }}{% if not it.covered %} <span style="font-size:10px">({{ t('no engine coverage','无引擎覆盖') }})</span>{% endif %}
        {% if it.latest_tx_age is not none %}<div style="font-size:10px;color:var(--muted)">{{ t('Tx age:','交易年龄:') }} {{ it.latest_tx_age }}d
          {%- if it.median_lag_days is not none %} · {{ t('lag:','滞后:') }} {{ it.median_lag_days }}d{% endif %}
        </div>{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody></table>
  <p class="mut2" style="font-size:11px;margin-top:9px">{{ t(
    'Cluster = distinct members · recency-weighted net-buy · disclosed size · freshness (decay on transaction date, bipartisan bonus). Technical &amp; Zone are read from each name\'s own conviction + sector/theme signals; a hard engine veto (cycle-blocked / parabolic) floors the technical score and removes "act now". ⚡ = prime-entry signal gate (T1/T2/T3). ETF/1-member/stale/late ⚠️ chips are provenance — reduced weight, not removal. Showing the top ' ~ n_shown ~ ' of ' ~ summary.n_tickers ~ ' in-window names.',
    '集群 = 不同议员数 · 时间加权（交易日）净买入 · 披露规模 · 新鲜度（两党加成）。技术面与区间取自各标的信念与板块/主题信号；引擎硬否决压低技术分并取消"现在可买"。⚡ = 优质入场信号（T1/T2/T3）。ETF/1议员/陈旧/晚报 ⚠️ 为来源提示——权重降低，不删除。显示窗口内前 ' ~ n_shown ~ ' 个（共 ' ~ summary.n_tickers ~ ' 个）。') }}</p>
  {% else %}<p class="mut2">{{ t('No congressional disclosures in the current window.', '当前窗口无国会披露。') }}</p>{% endif %}
</div>

{# ---------------- member track record leaderboard ---------------- #}
{% if member_leaderboard %}
<div class="cg-card">
  <h2>🏅 {{ t('Member Track Record — reliability leaderboard', '议员历史记录 — 可靠性排行榜') }}
      <span class="h-note">— {{ t('empirical-Bayes shrunk hit rate (ER>0 vs SPY); n = trades with ≥30-day horizon','经验贝叶斯收缩胜率（ER>0 vs 标普）；n = 持有≥30天的交易') }}</span></h2>
  <table class="ad"><thead><tr>
    <th>{{ t('Member','议员') }}</th>
    <th>{{ t('Chamber','议院') }}</th>
    <th class="num">{{ t('Tier','层级') }}</th>
    <th class="num">{{ t('Hit% (shrunk)','胜率(收缩)') }}</th>
    <th class="num">{{ t('n eff','有效n') }}</th>
    <th class="num">{{ t('n total','总n') }}</th>
    <th class="num">{{ t('Median ER','中位超额') }}</th>
    <th class="num">{{ t('Last tx (days ago)','最近交易') }}</th>
  </tr></thead><tbody>
  {% for m in member_leaderboard %}
    <tr>
      <td>{{ m.representative }}{% if m.party in ('D','R') %} <span class="cg-mem {{ m.party }}">{{ m.party }}</span>{% endif %}</td>
      <td class="mut2">{{ m.chamber }}</td>
      <td><span class="mb-tier-{{ m.tier }}">{{ m.tier }}</span></td>
      <td class="num">
        {% if m.raw_hit_rate is not none and m.raw_hit_rate == m.raw_hit_rate %}
          <b>{{ (m.shrunk_hit_rate * 100)|round|int }}%</b>
          <span class="mut2" style="font-size:10px">(raw {{ (m.raw_hit_rate * 100)|round|int }}%)</span>
        {% else %}
          <b>{{ (m.shrunk_hit_rate * 100)|round|int }}%</b>
        {% endif %}
      </td>
      <td class="num">{{ m.n_eff_valid }}</td>
      <td class="num">{{ m.n_trades }}</td>
      <td class="num {{ 'r-pos' if (m.er_median or 0) > 0 else ('r-neg' if (m.er_median or 0) < 0 else '') }}">
        {% if m.er_median is not none %}{{ '%+.1f'|format(m.er_median) }}pp{% else %}—{% endif %}
      </td>
      <td class="num mut2">{% if m.days_since_last is not none %}{{ m.days_since_last }}d{% else %}—{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody></table>
  <p class="mut2" style="font-size:11px;margin-top:9px">{{ t(
    'Hit rate = P(excess return vs SPY &gt; 0) per member. Shrunk toward pooled baseline (39.3%) via empirical-Bayes (κ=8). Tier "proven" requires n≥8 effective trades with shrunk rate above pooled; "watch" = 3–7; "limited" = &lt;3. ExcessReturn is horizon-inconsistent (open-ended from trade date to Quiver snapshot) — treat as directional signal, not calibrated alpha. 12-month data window limits statistical power for all but the most active members.',
    '胜率 = 每位议员超越标普概率。通过经验贝叶斯（κ=8）向基准收缩（39.3%）。"proven" 层级需≥8笔有效交易且收缩胜率超基准；"watch" = 3–7笔；"limited" = 不足3笔。超额收益为开放式（从交易日至 Quiver 快照），作为方向性信号处理，而非校准后的 alpha。12个月数据窗口对多数议员统计效力有限。') }}</p>
</div>
{% endif %}

{# ── UNIFIED FORWARD DESK GRADER (5/10/20/30/60/90d, level+velocity, leave-tracking) ── #}
{{ dg.styles() }}
{{ dg.panel(desk_grader) }}

{# ---------------- T0 beta turn flags ---------------- #}
<div class="cg-card">
  <h2>{{ t('Early Turn Flags', '早期拐点提示') }} <span class="cg-flag t0">BETA</span>
    {% if t0_meta.present and t0_meta.as_of %}<span class="h-note" style="margin-left:auto">{{ t('As of','截至') }} {{ t0_meta.as_of }}</span>{% endif %}
  </h2>
  <p class="mut2" style="font-size:12.5px;margin:0 0 8px">{{ t("Watchlist names washed out and just ticking up. Watch — don't chase.", '观察名单中超跌后刚现回升迹象的股票。观察为主，勿追高。') }}</p>
  {% if t0_meta.present %}
    {% if t0_rows %}
    <table class="ad"><thead><tr>
      <th>{{ t('Ticker','标的') }}</th>
      <th>{{ t('Read','解读') }}</th>
      <th class="num">{{ t('Close','收盘') }}</th>
      <th class="num">{{ t('Liquidity','流动性') }}</th>
    </tr></thead><tbody>
    {% for m in t0_rows %}
    <tr>
      <td><span class="tk"><a href="stock.html#{{ m.ticker }}">{{ m.ticker }}</a></span>
        {% if m.sector %}<div class="mut2" style="font-size:10.5px">{{ m.sector }}</div>{% endif %}
      </td>
      <td class="mut2" style="font-size:12px">{{ t('washed out · first daily up-tick', '深度超跌 · 首日回升') }}</td>
      <td class="num">{% if m.close is not none %}${{ '%.2f'|format(m.close) }}{% else %}<span class="mut2">—</span>{% endif %}</td>
      <td class="num">{% if m.dollar_adv_20d is not none %}{%- set adv = m.dollar_adv_20d -%}{%- if adv >= 1e9 -%}${{ "%.1f"|format(adv / 1e9) }}B{%- elif adv >= 1e6 -%}${{ "%.0f"|format(adv / 1e6) }}M{%- elif adv >= 1e3 -%}${{ "%.0f"|format(adv / 1e3) }}K{%- else -%}${{ "%.0f"|format(adv) }}{%- endif -%}{% else %}<span class="mut2">—</span>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody></table>
    {% else %}
    <p class="mut2" style="font-size:12.5px">{{ t('No watchlist names are flagging right now — most days none do.', '当前观察名单中无触发股票 — 大多数日子都是如此。') }}</p>
    {% endif %}
  {% else %}
  <p class="mut2" style="font-size:12.5px">{{ t('No data yet — this beta screen populates after the next nightly build.', '暂无数据 — 此测试版筛选将在下次夜间构建后填充。') }}</p>
  {% endif %}
  <p class="mut2" style="font-size:10.5px;margin-top:9px;border-top:1px solid var(--line);padding-top:7px">{{ t('T0 = 3-day-frame StochRSI under 30 with a same-day daily StochRSI up-cross (RSI14/Stoch14/3/3). Beta — an early, unproven flag; not a buy signal.', 'T0 = 3日框架StochRSI低于30且当日日线StochRSI上穿（RSI14/Stoch14/3/3）。测试版 — 早期且未经验证的提示，并非买入信号。') }}</p>
</div>

{# ---------------- the raw disclosure feed ---------------- #}
<div class="cg-card">
  <h2>🗳️ {{ t('Recent disclosures', '最新披露') }}
      <span class="h-note">— {{ t('newest filings first; ExcessReturn = cumulative excess vs SPY since trade date (horizon-inconsistent — older trades have more time to compound)','最新申报在前；超额收益 = 自交易日起累计超越标普（时间不一致——老交易有更多时间复利）') }}</span></h2>
  {% if feed %}
  <table class="ad"><thead><tr>
    <th>{{ t('Disclosed','披露日') }}</th>
    <th>{{ t('Member','议员') }}</th>
    <th>{{ t('Chamber','议院') }}</th>
    <th>{{ t('Side','方向') }}</th>
    <th>{{ t('Ticker','标的') }}</th>
    <th class="num">{{ t('Amount','金额') }}</th>
    <th class="num">{{ t('vs SPY','相对标普') }}</th>
    <th>{{ t('Traded','交易日') }}</th>
    <th class="num">{{ t('Tx age','交易年龄') }}</th>
    <th class="num">{{ t('Filing lag','申报滞后') }}</th>
  </tr></thead><tbody>
  {% for r in feed %}
    <tr>
      <td class="num mut2">{{ r.report_date or '—' }}</td>
      <td>{{ r.representative or '—' }}{% if r.party in ('D','R') %} <span class="cg-mem {{ r.party }}">{{ r.party }}</span>{% endif %}</td>
      <td class="mut2">{{ r.chamber }}</td>
      <td><span class="side-chip {{ r.side }}">{{ r.side|upper }}</span></td>
      <td><span class="tk"><a href="stock.html#{{ r.ticker }}">{{ r.ticker }}</a></span>{% if r.name %} <span class="mut2" style="font-size:10.5px">{{ r.name[:22] }}</span>{% endif %}</td>
      <td class="num">{{ amt(r) }}</td>
      <td class="num {{ 'r-pos' if (r.excess_return or 0) > 0 else ('r-neg' if (r.excess_return or 0) < 0 else '') }}">{% if r.excess_return is not none %}{{ '%+.1f'|format(r.excess_return) }}%{% else %}—{% endif %}</td>
      <td class="num mut2">{{ r.transaction_date or '—' }}</td>
      <td class="num mut2">{% if r.tx_age_days is not none %}{{ r.tx_age_days }}d{% else %}—{% endif %}</td>
      <td class="num {% if r.late_filing %}r-neg{% else %}mut2{% endif %}">
        {% if r.filing_lag_days is not none %}{{ r.filing_lag_days }}d{% if r.late_filing %} ⚠️{% endif %}{% else %}—{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody></table>
  {% else %}<p class="mut2">{{ t('No disclosures yet.', '暂无披露。') }}</p>{% endif %}
</div>
{% endblock %}
