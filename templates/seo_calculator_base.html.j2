{#=============================================================================
  seo_calculator_base.html.j2 — calculator page layout.

  Structure: calculator card ABOVE the fold (CONTRACT §6 DOM), explainer article
  body below, related rail + one CTA. Extends seo_base for chrome.

  BLOCKS a calculator page fills:
    calc_intro   — (optional) one-line direct answer above the card
    calc_form    — the .calc-in inputs + .calc-out outputs + .calc-actions
                   (must follow the §6 DOM: .ci/.ci-l, .ci-seg[role=radiogroup],
                    .calc-out[aria-live=polite] > .co-main/.co-plain/.co-rows)
    calc_script  — the inline <script> (DOMContentLoaded-wrapped, pure compute()
                   + WORKED_EXAMPLES self-check per CONTRACT §6)
    article_body — the explainer prose (uses .est-prose vocabulary)

  CONTEXT the page sets before extending (per CONTRACT §5): page{slug,family,
  title,description,canonical,url_path,breadcrumbs,section='tools'}, rel, site,
  toc, related, cta.

  This template defines the FULL calculator visual system. The five sibling
  calculators clone position_size.html.j2 and inherit all of it — style is
  decided here, once.
=============================================================================#}
{% extends "seo_base.html.j2" %}
{% import "_estate_glyphs.html.j2" as glyphs %}
{% block body_class %}est-calc{% endblock %}

{% block estate_css %}
  .cx-head{max-width:1120px; margin:20px auto 0; padding:0 24px;}
  .cx-shell{max-width:1120px; margin:22px auto 0; padding:0 24px;
    display:grid; grid-template-columns:minmax(0,1fr) 210px; gap:44px; align-items:start;}
  .cx-main{min-width:0;}
  .cx-toc{position:sticky; top:76px; font-family:var(--font-ui); font-size:var(--fs-sm);
    border-left:1px solid var(--hair-strong); padding-left:15px;}
  .cx-toc .toc-h{font-family:var(--num); font-size:var(--fs-micro); letter-spacing:.13em;
    text-transform:uppercase; color:var(--ink-3); margin:0 0 9px;}
  .cx-toc a{display:block; color:var(--ink-2); padding:5px 0 5px 14px; margin-left:-15px; line-height:1.35;
    border-left:2px solid transparent; transition:color .15s,border-color .15s;}
  .cx-toc a:hover{color:var(--ink-1);} .cx-toc a.active{color:var(--ink-1); border-left-color:var(--link); font-weight:700;}

  /* ── the calculator card — the desk instrument, above the fold ──────────────
     A machined terminal panel (hairline frame, inset top edge, house shadow)
     crowned by the calculator's OWN glyph so it reads as one family with the
     hub card that led here. */
  .calc-card{position:relative; border:1px solid var(--hair-strong); border-radius:var(--r-lg);
    background:var(--panel); box-shadow:var(--ms); padding:18px 22px 22px; overflow:hidden;}
  .calc-card::before{content:""; position:absolute; left:0; top:0; bottom:0; width:3px;
    background:linear-gradient(180deg, var(--rail), color-mix(in srgb,var(--rail) 20%,transparent));}
  /* the crown row: a mono eyebrow + the per-calculator glyph */
  .calc-card .cc-crown{display:flex; align-items:center; justify-content:space-between; gap:12px;
    margin:0 0 14px; padding:0 0 12px; border-bottom:1px solid var(--hair);}
  .calc-card .cc-eyebrow{font-family:var(--num); font-size:var(--fs-label); font-weight:700;
    letter-spacing:var(--trk); text-transform:uppercase; color:var(--ink-3);}
  .calc-card .cc-glyph{flex:none; width:72px; height:40px;}
  .calc-card .cc-lede{font-family:var(--font-ui); font-size:var(--fs-md); color:var(--ink-2); margin:0 0 16px; line-height:1.5;}

  .calc-in{display:grid; grid-template-columns:repeat(2,1fr); gap:14px 18px;}
  @media (max-width:560px){ .calc-in{grid-template-columns:1fr;} }
  .ci{display:flex; flex-direction:column; gap:6px; min-width:0;}
  .ci.ci-wide{grid-column:1 / -1;}
  .ci-l{font-family:var(--font-ui); font-size:var(--fs-sm); font-weight:600; color:var(--ink-2); letter-spacing:.005em;}
  .ci-l .hint{font-weight:400; color:var(--ink-3);}
  .ci input, .ci select{font-family:var(--num); font-size:16px; font-variant-numeric:tabular-nums;
    background:var(--tile); border:1px solid var(--hair-strong); border-radius:var(--r-md); color:var(--ink-1);
    padding:11px 13px; width:100%; outline:none; transition:border-color .16s,box-shadow .16s;}
  .ci input:focus, .ci select:focus{border-color:var(--link);
    box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 20%,transparent);}
  .ci input::placeholder{color:var(--ink-3); opacity:.7;}

  /* segmented toggle (§6) — long/short, forward/inverse, etc. */
  .ci-seg{display:inline-flex; background:var(--tile); border:1px solid var(--hair-strong); border-radius:var(--r-md);
    padding:3px; gap:3px; align-self:start;}
  .ci-seg button{font-family:var(--font-ui); font-size:var(--fs-sm); font-weight:600; color:var(--ink-3);
    background:transparent; border:none; border-radius:7px; padding:8px 16px; cursor:pointer;
    transition:color .16s,background .16s;}
  .ci-seg button:hover{color:var(--ink-1);}
  .ci-seg button.on{color:var(--ink-1); background:color-mix(in srgb,var(--link) 18%,var(--panel2));}
  .ci-seg button:focus-visible{outline:2px solid var(--link); outline-offset:2px;}

  /* ── the readout — the terminal signature: a big mono-tabular number ──────── */
  .calc-out{margin:20px 0 0; padding:18px 20px; border-radius:var(--r-md); border:1px solid var(--hair-strong);
    border-left:3px solid var(--rail); background:var(--panel2);}
  .co-main{display:flex; align-items:baseline; gap:9px; flex-wrap:wrap;}
  .co-main #out-main, .co-main [data-out-main]{font-family:var(--num); font-variant-numeric:tabular-nums;
    font-feature-settings:"tnum" 1; font-size:clamp(var(--fs-num-xl),7vw,52px); font-weight:800; line-height:1;
    letter-spacing:-.02em; color:var(--ink-1);}
  .co-main .co-unit{font-family:var(--font-ui); font-size:var(--fs-md); font-weight:600; color:var(--ink-3);}
  /* Law 3: the big number ALWAYS carries a plain-word interpretation sentence */
  .co-plain{font-family:var(--font-ui); font-size:var(--fs-md); line-height:1.5; color:var(--ink-1); margin:10px 0 0; max-width:60ch;}
  .co-plain.warn{color:var(--warn);}
  .co-rows{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px 20px;
    margin:16px 0 0; padding-top:14px; border-top:1px solid var(--hair);}
  .co-rows > div{display:flex; flex-direction:column; gap:2px;}
  .co-rows dt{font-family:var(--num); font-size:var(--fs-label); color:var(--ink-3); letter-spacing:.04em; text-transform:uppercase;}
  .co-rows dd{font-family:var(--num); font-variant-numeric:tabular-nums; font-size:var(--fs-num-lg); font-weight:800;
    color:var(--ink-1); margin:0; line-height:1.1;}
  .co-rows dd.pos{color:var(--up);} .co-rows dd.neg{color:var(--down);}

  .calc-actions{margin:16px 0 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap;}
  .calc-actions .copied{font-family:var(--font-ui); font-size:var(--fs-sm); color:var(--ok); opacity:0;
    transition:opacity .2s;}
  .calc-actions .copied.show{opacity:1;}
  .calc-actions .gbtn{font-family:var(--font-ui);}

  .cx-explainer{margin:40px 0 0;}
  @media (max-width:900px){
    .cx-shell{grid-template-columns:1fr; gap:12px;}
    .cx-toc{position:static; top:auto; border-left:none; padding:12px 14px; margin:22px 0 2px; order:2;
      display:flex; flex-wrap:wrap; gap:6px; border:1px solid var(--hair-strong); border-radius:var(--r-md); background:var(--panel2);}
    .cx-toc .toc-h{flex-basis:100%; margin:0 0 2px;}
    .cx-toc a{border:1px solid var(--hair-strong); border-radius:999px; padding:6px 11px; margin:0; color:var(--ink-2);}
    .cx-toc a.active{border-color:var(--link); color:var(--ink-1);}
    .cx-main{order:1;}
  }
  @media (max-width:560px){ .calc-card{padding:16px 16px 18px;} }
{% endblock %}

{% block main %}
<header class="cx-head est-head" style="max-width:1120px;">
  <span class="est-kicker">{{ t('Calculator', '计算器') }}</span>
  <h1 class="est-title">{{ page.title }}</h1>
  {% if page.description %}<p class="est-dek">{{ page.description }}</p>{% endif %}
</header>

<div class="cx-shell">
  <div class="cx-main">
    {% block calc_intro %}{% endblock %}

    <section class="calc-card" id="calc" aria-label="Calculator">
      <div class="cc-crown">
        <span class="cc-eyebrow">{{ t('Live calculator', '实时计算') }}</span>
        <span class="cc-glyph">{% block calc_glyph %}{{ glyphs.glyph('position-size', 'crown') }}{% endblock %}</span>
      </div>
      {% block calc_form %}{% endblock %}
    </section>

    <div class="cx-explainer est-prose">
      {% block article_body %}{% endblock %}
    </div>

    {% block related_rail %}
    {% if related and (related.calculators or related.lessons or related.articles or related.live) %}
    <aside class="est-related" aria-label="Related">
      <p class="rel-h">{{ t('Keep going', '继续') }}</p>
      <div class="rel-grid">
        {% for r in related.calculators %}<a class="est-relcard" href="{{ rel }}{{ r.href.lstrip('/') }}"><span class="rc-kind">{{ t('Calculator', '计算器') }}</span><span class="rc-title">{{ r.title }}</span></a>{% endfor %}
        {% for r in related.lessons %}<a class="est-relcard" href="{{ rel }}{{ r.href.lstrip('/') }}"><span class="rc-kind">{{ t('Lesson', '课程') }}</span><span class="rc-title">{{ r.title }}</span></a>{% endfor %}
        {% for r in related.articles %}<a class="est-relcard" href="{{ rel }}{{ r.href.lstrip('/') }}"><span class="rc-kind">{{ t('Essay', '随笔') }}</span><span class="rc-title">{{ r.title }}</span></a>{% endfor %}
        {% for r in related.live %}<a class="est-relcard" href="{{ rel }}{{ r.href.lstrip('/') }}"><span class="rc-kind">{{ t('On the dashboard', '仪表盘') }}</span><span class="rc-title">{{ r.title }}</span></a>{% endfor %}
      </div>
    </aside>
    {% endif %}
    {% endblock %}

    {% block cta %}
    {% if cta %}
    <aside class="est-cta-block">
      <div class="cta-copy">
        <span class="cta-k">{{ t('Next step', '下一步') }}</span>
        <p class="cta-t">{{ t(cta.label, cta.get('label_zh', '')) }}</p>
      </div>
      <a class="gbtn gbtn-lg gbtn-cta" href="{{ rel }}{{ cta.href.lstrip('/') }}">{{ t(cta.label, cta.get('label_zh', '')) }}</a>
    </aside>
    {% endif %}
    {% endblock %}
  </div>

  {% if toc %}
  <nav class="cx-toc" id="toc" aria-label="On this page">
    <p class="toc-h">{{ t('On this page', '本页目录') }}</p>
    {% for h in toc %}<a href="#{{ h.id }}">{{ h.label }}</a>{% endfor %}
  </nav>
  {% endif %}
</div>
{% endblock %}

{% block body_scripts %}
{% block calc_script %}{% endblock %}
{% if toc %}
<script>
  (function(){ var ls=[].slice.call(document.querySelectorAll('.cx-toc a')),
      hs=ls.map(function(a){return document.querySelector(a.getAttribute('href'));});
    if(!ls.length)return;
    function spy(){ var y=window.scrollY+96, act=0; hs.forEach(function(h,i){ if(h&&h.offsetTop<=y) act=i; });
      ls.forEach(function(a,i){ a.classList.toggle('active',i===act); }); }
    window.addEventListener('scroll',spy,{passive:true}); spy(); })();
</script>
{% endif %}
{% endblock %}
