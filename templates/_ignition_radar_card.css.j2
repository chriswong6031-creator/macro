  /* ============================================================================
     IGNITION RADAR CARD (.igx) — risk-ON mirror of the Risk Radar (.rrx).
     Green accent (--ok) when ignited, muted when off.
     Class prefix: .igx  (no collision with .rrx).
     Included by dashboard.html.j2 (both macro and us_stocks modes).
     ============================================================================ */
  .igx { --ic-col: var(--ok);
         display: grid; gap: 12px; margin: 12px 0 2px; padding: 15px 18px;
         border-radius: 12px; background: var(--panel); border: 1px solid var(--line);
         border-left: 4px solid var(--ic-col); font-size: 12.5px; line-height: 1.4;
         box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 16px 32px -24px rgba(0,0,0,.4); }
  .igx.igx-ignited { --ic-col: var(--ok);
         background: color-mix(in srgb, var(--ok) 4%, var(--panel)); }
  .igx.igx-warming  { --ic-col: var(--warn); }
  .igx.igx-off      { --ic-col: var(--muted); }
  /* header */
  .igx .igx-hd { display: flex; align-items: flex-start; gap: 10px; }
  .igx .igx-ic { font-size: 18px; line-height: 1.1; flex: none; }
  .igx .igx-id { min-width: 0; flex: 1; }
  .igx .igx-ttl { display: flex; align-items: center; flex-wrap: wrap; gap: 7px;
         font-weight: 700; font-size: 13px; color: var(--text); }
  .igx .igx-badge { font-weight: 800; letter-spacing: .03em; color: var(--ic-col);
         font-size: 11.5px; font-variant-numeric: tabular-nums; padding: 1px 7px;
         border-radius: 5px;
         background: color-mix(in srgb, var(--ic-col) 16%, transparent);
         border: 1px solid color-mix(in srgb, var(--ic-col) 38%, transparent); }
  .igx .igx-glance { font-size: 12px; color: var(--text); margin-top: 3px;
         font-weight: 600; }
  .igx .igx-fragile { color: var(--warn); font-size: 11px; margin-top: 2px; }
  /* chip rows (8 broad chips) */
  .igx .igx-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .igx .igx-chip { display: inline-flex; align-items: center; gap: 4px;
         padding: 2px 8px; border-radius: 6px; font-size: 11px;
         background: var(--panel); border: 1px solid var(--line); color: var(--muted); }
  .igx .igx-chip.lit { color: var(--ic-col); font-weight: 700;
         border-color: color-mix(in srgb, var(--ic-col) 45%, var(--line));
         background: color-mix(in srgb, var(--ic-col) 10%, var(--panel)); }
  .igx .igx-chip.fresh { box-shadow: 0 0 0 1px color-mix(in srgb, var(--ic-col) 40%, transparent); }
  .igx .igx-chip-dot { width: 6px; height: 6px; border-radius: 50%;
         background: currentColor; flex: none; }
  .igx .igx-k { font-size: 11px; color: var(--muted); font-weight: 700;
         text-transform: uppercase; letter-spacing: .07em; }
  /* narrow theme strip */
  .igx .igx-narrow { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 2px; }
  .igx .igx-narrow-k { font-size: 9.5px; font-weight: 700; text-transform: uppercase;
         letter-spacing: .07em; color: var(--muted); align-self: center; margin-right: 2px; }
  .igx .igx-theme { display: inline-flex; align-items: center; gap: 4px;
         padding: 2px 8px; border-radius: 6px; font-size: 10.5px;
         background: var(--panel); border: 1px solid var(--line); color: var(--text); }
  .igx .igx-theme.igniting { color: var(--ok); font-weight: 700;
         border-color: color-mix(in srgb, var(--ok) 45%, var(--line));
         background: color-mix(in srgb, var(--ok) 10%, var(--panel)); }
  .igx .igx-theme.running { color: var(--info); font-weight: 600;
         border-color: color-mix(in srgb, var(--info) 35%, var(--line)); }
  .igx .igx-theme.fading { color: var(--muted); }
  .igx .igx-theme-score { font-size: 9.5px; font-variant-numeric: tabular-nums;
         color: var(--muted); margin-left: 1px; }
  .igx .igx-theme-flags { font-size: 9px; color: var(--muted); margin-left: 2px; }
  /* cross-ref chip */
  .igx .igx-xref { font-size: 10.5px; color: var(--muted); }
  .igx .igx-xref-k { font-weight: 700; color: var(--text); margin-right: 5px; }
  /* do-line */
  .igx .igx-do { font-size: 12px; color: var(--text); padding-top: 9px;
         border-top: 1px solid color-mix(in srgb, var(--ic-col) 20%, var(--line)); }
  .igx .igx-do-k { font-weight: 800; color: var(--ic-col); text-transform: uppercase;
         letter-spacing: .06em; font-size: 10.5px; margin-right: 8px; }
  /* self-audit */
  .igx .igx-audit { font-size: 10.5px; color: var(--muted); }
  .igx .igx-audit-k { font-weight: 700; color: var(--text); margin-right: 6px; }
  /* responsive */
  @media (max-width: 560px) {
    .igx { padding: 14px 15px; gap: 10px; }
    .igx .igx-narrow, .igx .igx-xref { display: none; }
  }

  /* ==========================================================================
     IGNITION RADAR STRIP (.igs) — compact span12 variant (us_stocks page).
     Rides the page's .panel card chrome; adds only a state-tinted left accent.
     ========================================================================== */
  .igs { --ic-col: var(--muted); border-left: 4px solid var(--ic-col); }
  .igs.igs-ignited { --ic-col: var(--ok); }
  .igs.igs-warming { --ic-col: var(--warn); }
  /* header row */
  .igs .igs-top { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .igs .igs-ic { font-size: 16px; line-height: 1; flex: none; }
  .igs .igs-ttl { font-weight: 800; font-size: 13px; letter-spacing: .01em; white-space: nowrap; }
  .igs .igs-state { font-weight: 800; font-size: 11px; letter-spacing: .05em;
         text-transform: uppercase; color: var(--ic-col); padding: 1px 8px; border-radius: 99px;
         background: color-mix(in srgb, var(--ic-col) 14%, transparent);
         border: 1px solid color-mix(in srgb, var(--ic-col) 36%, transparent); white-space: nowrap; }
  .igs .igs-glance { font-size: 12.5px; font-weight: 600; color: var(--text);
         flex: 1 1 240px; min-width: 0; }
  .igs .igs-frag { color: var(--warn); }
  /* evidence row */
  .igs .igs-ev { display: flex; align-items: center; gap: 8px 12px; flex-wrap: wrap; margin-top: 9px; }
  .igs .igs-k { font-size: 10px; color: var(--muted); font-weight: 700;
         text-transform: uppercase; letter-spacing: .07em; white-space: nowrap; }
  .igs .igs-dots { display: inline-flex; align-items: center; gap: 5px; }
  .igs .igs-dot { width: 10px; height: 10px; border-radius: 50%; cursor: help;
         background: var(--panel2); border: 1px solid var(--line); }
  .igs .igs-dot.lit { background: var(--ok);
         border-color: color-mix(in srgb, var(--ok) 70%, var(--line)); }
  .igs .igs-dot.fresh { box-shadow: 0 0 0 2px color-mix(in srgb, var(--ok) 30%, transparent); }
  .igs .igs-kcount { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums;
         white-space: nowrap; }
  .igs .igs-div { width: 1px; height: 16px; background: var(--line); flex: none; }
  .igs .igs-theme { display: inline-flex; align-items: center; gap: 4px; cursor: help;
         padding: 2px 9px; border-radius: 6px; font-size: 11px; white-space: nowrap;
         background: var(--panel2); border: 1px solid var(--line); color: var(--text); }
  .igs .igs-theme b { font-variant-numeric: tabular-nums; font-weight: 700; }
  .igs .igs-theme.igniting { color: var(--ok);
         border-color: color-mix(in srgb, var(--ok) 45%, var(--line));
         background: color-mix(in srgb, var(--ok) 10%, var(--panel)); }
  .igs .igs-theme.running { color: var(--info);
         border-color: color-mix(in srgb, var(--info) 35%, var(--line)); }
  .igs .igs-theme.fading { color: var(--muted); }
  .igs .igs-xref { font-size: 10.5px; color: var(--muted); cursor: help; white-space: nowrap;
         padding: 2px 8px; border-radius: 99px; border: 1px dashed var(--line); margin-left: auto; }
  /* one merged footer */
  .igs .igs-ft { margin-top: 9px; padding-top: 8px; font-size: 11px; color: var(--muted);
         border-top: 1px solid color-mix(in srgb, var(--ic-col) 18%, var(--line)); }
  @media (max-width: 560px) {
    .igs .igs-glance { flex-basis: 100%; }
    .igs .igs-xref { margin-left: 0; }
  }
