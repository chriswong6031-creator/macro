<script src="sector_central_china_data.js"></script>
<script>
(function(){
  "use strict";
  var D = window.SECTOR_CENTRAL; if (!D) return;
  var M = D.market || {}, GR = D.grader || {};
  function lang(){ return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en"; }
  function L(en, zh){ return '<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>'; }
  function esc(s){ return (s==null?'':String(s)).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  // translate an engine-emitted English value into 中文 when in zh mode (else show it as-is).
  function zhv(en, m){ var e=(en==null?'':String(en)); return (lang()==='zh' && m[e]) ? m[e] : esc(e); }
  var QUAD_ZH={'Goldilocks':'温和增长','Reflation':'再通胀','Stagflation':'滞胀','Deflation':'通缩','Inflation':'通胀'};
  // liquidity is emitted lowercase ('neutral'); keep Title-case keys too as harmless extras
  var LIQ_ZH={'neutral':'中性','easing':'宽松','tightening':'收紧','expanding':'扩张','contracting':'收缩','tight':'偏紧','loose':'宽松','supportive':'支持性','restrictive':'偏紧',
              'Neutral':'中性','Easing':'宽松','Tightening':'收紧','Expanding':'扩张','Contracting':'收缩'};
  var PHASE_ZH={'Topping':'见顶','Trending':'上行','Rolling over':'回落','Prime entry':'入场良机','Bottoming':'筑底','Peak':'见顶','Expansion':'上行','Downturn':'回落','Recovery':'入场良机','Trough':'筑底'};
  var CONF_ZH={'high':'高','moderate':'中等','low/mixed':'低/混合','low':'低','mixed':'混合'};
  // desk cycle.state is emitted as {BOTTOM WATCH, DECLINE, RALLY ON, ROLLING OVER}
  var STATEDESK_ZH={'BOTTOM WATCH':'筑底观察','DECLINE':'下行','RALLY ON':'上行','ROLLING OVER':'回落',
                    'Washed out':'超跌','Beaten down':'超跌','Euphoric':'过热','Overheated':'过热','Recovering':'复苏'};
  // reasoning layers are emitted Title-case multi-word
  var LAYER_ZH={'Cycle state':'周期状态','Forward odds':'前瞻概率','Regime gate':'体制门控','Momentum':'动量','Fragility':'脆弱度','Crowding':'拥挤度','Flow':'资金流','Heat':'热度','Trend':'趋势'};
  var asof=document.getElementById('scc-asof'); if(asof) asof.textContent=D.as_of||'';
  document.getElementById('n-sec').textContent=(D.sectors||[]).length;
  document.getElementById('n-bsk').textContent=(D.baskets||[]).length;

  /* ---- regime banner ---- */
  function regimeBanner(){
    var risk=M.risk_on, tone=(risk==null)?'mix':(risk>0.15?'on':risk<-0.15?'off':'mix');
    var toneCls={on:'rg-on',off:'rg-off',mix:'rg-mix'}[tone];
    // this page follows the desk's "Western colours always" choice (good=green, bad=red in
    // BOTH languages). theme.js flips the --up/--down tokens in zh, so pick the token that
    // stays green / red regardless of language to keep the bar in step with the flipped text.
    var GREEN = lang()==='zh' ? 'var(--down)' : 'var(--up)';
    var RED   = lang()==='zh' ? 'var(--up)'   : 'var(--down)';
    var dr=M.derisk_blended, drPct=dr!=null?Math.round(dr*100):null;
    var flow=M.flow||{}, tv=flow.turnover||{}, sb=flow.southbound||{}, mg=flow.margin||{};
    // plain-language headline so a non-expert gets the "is this good or bad?" read instantly
    var headTxt = tone==='on' ? L('China equities are risk-on right now — a broadly supportive backdrop.','当前A股偏好风险——整体环境较为有利。')
      : tone==='off' ? L('China equities are leaning defensive right now — a cautious backdrop.','当前A股偏防御——环境趋于谨慎。')
      : L('China equities are mixed right now — no strong risk signal either way.','当前A股信号中性——风险方向不明确。');
    var headIc = tone==='off' ? '⚠' : tone==='on' ? '✓' : '•';
    var head='<div class="rg-headline-row rg-hl-'+tone+'"><span class="rg-hl-ic">'+headIc+'</span><span>'+headTxt+'</span></div>';
    var cells=[];
    cells.push('<div class="rg-cell lead"><div class="rg-k">'+L('Market backdrop','市场环境')+' · '+L('validated','已验证')+'</div>'+
      '<div class="rg-v '+toneCls+'">'+(lang()==='zh' && M.state_zh ? esc(M.state_zh) : esc(M.state_en||'—'))+'</div>'+
      '<div class="rg-bar"><i style="width:'+(drPct!=null?drPct:50)+'%;background:'+(tone==='off'?RED:tone==='on'?GREEN:'var(--muted)')+'"></i></div>'+
      '<div class="rg-d">'+L('de-risk','降险')+' '+(dr!=null?dr:'—')+' · '+L('gate ×','门控 ×')+(M.gate_factor!=null?M.gate_factor:'—')+'</div></div>');
    cells.push('<div class="rg-cell"><div class="rg-k">'+L('Quad','象限')+'</div>'+
      '<div class="rg-v">'+zhv(M.quad_name||M.quad||'—', QUAD_ZH)+'</div>'+
      '<div class="rg-d">'+L('growth','增长')+' '+(M.growth_score!=null?M.growth_score:'—')+' · '+L('infl','通胀')+' '+(M.inflation_score!=null?M.inflation_score:'—')+'</div></div>');
    cells.push('<div class="rg-cell"><div class="rg-k">'+L('PBoC liquidity','央行流动性')+'</div>'+
      '<div class="rg-v" style="font-size:16px">'+zhv(M.liquidity||'—', LIQ_ZH)+'</div>'+
      '<div class="rg-d">'+L('turnover','成交')+' '+(tv.turnover_t!=null?tv.turnover_t+'T ('+esc(tv.band||'')+')':'—')+'</div></div>');
    cells.push('<div class="rg-cell"><div class="rg-k">'+L('Flow & froth','资金与拥挤')+' · '+L('display','展示')+'</div>'+
      '<div class="rg-v" style="font-size:15px">'+(sb.net!=null?(sb.net>0?'+':'')+sb.net+' '+L('SB','南向'):'—')+'</div>'+
      '<div class="rg-d">'+L('margin','融资')+' '+(mg.pctile!=null?mg.pctile+'%ile':'—')+' · '+L('valn froth','估值拥挤')+' '+(flow.froth_anchor!=null?Math.round(flow.froth_anchor)+'%ile':'—')+'</div></div>');
    document.getElementById('regime').innerHTML=head+cells.join('');
  }

  /* ---- conviction card ---- */
  function card(s){
    var c=s.conviction||{}, cy=s.cycle||{}, dir=c.dir||'flat';
    var nm = lang()==='zh' && s.name_zh ? s.name_zh : s.name;
    var sub = (s.kind==='basket' ? (s.etf_proxy?esc(s.etf_proxy)+' · ':'') : (esc(s.shenwan_code||'')+' · ')) + esc(lang()==='zh'?(s.group_zh||s.group):s.group);
    var chips=[];
    if(cy.phase) chips.push('<span class="chip2">'+zhv(cy.phaseLabel||cy.phase, PHASE_ZH)+'</span>');
    if(cy.pos!=null) chips.push('<span class="chip2">'+L('pos','位置')+' <b>'+Math.round(cy.pos)+'</b></span>');
    if(cy.rs_rank) chips.push('<span class="chip2">RS <b>#'+cy.rs_rank+'</b></span>');
    if(c.confluence) chips.push('<span class="chip2">'+L('confluence','共振')+' <b>'+c.confluence.agree+'/'+c.confluence.of+'</b></span>');
    if(c.early) chips.push('<span class="chip2 early">'+L('early','偏早')+'</span>');
    // forward odds (validated pathway)
    var f=s.forward, fwdHtml='';
    if(f && f.cond_rate!=null){
      fwdHtml='<div class="fwd">'+L('Forward odds','前瞻概率')+': <b>'+Math.round(f.cond_rate*100)+'%</b> '+
        L('forward-','未来')+f.h+L('m positive','个月上涨')+' '+L('vs','基准')+' '+Math.round(f.base_rate*100)+'% '+
        '<span class="muted">(CI '+Math.round((f.ci_lo||0)*100)+'–'+Math.round((f.ci_hi||0)*100)+'%, n='+f.n+')</span></div>';
    }
    // reasoning trace
    var trace=(s.reasoning||[]).map(function(r){
      return '<div class="tr-row"><span class="tr-dot tr-'+esc(r.tier)+'"></span>'+
        '<span class="tr-layer">'+zhv(r.layer, LAYER_ZH)+'</span>'+
        '<span class="tr-txt">'+L(esc(r.en),esc(r.zh||r.en))+'</span></div>';
    }).join('');
    // name → its own page: baskets open the dedicated theme page; sectors focus the embedded cycle map.
    var cycHref = 'sector_cycles_china.html#'+esc(s.id);
    var nameHtml = s.kind==='basket'
      ? '<a href="basket_china/'+esc(String(s.id).replace(/^b-/,''))+'.html">'+esc(nm)+'</a>'
      : '<a href="'+cycHref+'" data-focus="'+esc(s.id)+'">'+esc(nm)+'</a>';
    return '<article class="card" style="--c:'+esc(s.accent||'var(--muted)')+'">'+
      '<div class="card-top"><div><div class="card-nm">'+nameHtml+'</div><div class="card-sub">'+sub+'</div></div>'+
        '<div class="conv"><span class="conv-badge tier-'+dir+'">'+L(esc(c.label_en),esc(c.label_zh||c.label_en))+'</span>'+
        '<div class="conv-score">'+c.score+'</div><div class="conv-sub">'+L('conviction','信念')+'</div></div></div>'+
      '<div class="chips">'+chips.join('')+'</div>'+ fwdHtml +
      '<details class="trace-d"><summary>'+L('Why — the full reasoning','为何 — 完整推理')+'</summary><div class="trace">'+trace+'</div></details>'+
      '<div class="conflu">'+L('confluence','共振度')+': <b class="'+esc((c.confluence||{}).label||'')+'">'+zhv((c.confluence||{}).label||'—', CONF_ZH)+'</b> · '+
        '<a href="'+cycHref+'" data-focus="'+esc(s.id)+'" style="color:var(--link)">'+L('open cycle →','打开周期 →')+'</a></div>'+
    '</article>';
  }
  var fam='sectors';
  function renderBoard(){
    var list = fam==='baskets' ? (D.baskets||[]) : (D.sectors||[]);
    document.getElementById('board').innerHTML = list.map(card).join('');
  }
  /* keep the conviction-board universe toggle linked to the cycle-map family toggle above */
  function setBoardFam(f){
    fam=f;
    document.querySelectorAll('.scc-tab').forEach(function(x){ var on=x.getAttribute('data-fam')===f; x.classList.toggle('on', on); x.setAttribute('aria-selected', on?'true':'false'); });
    renderBoard();
  }
  function linkTabs(){
    document.querySelectorAll('.scc-tab').forEach(function(t){
      t.addEventListener('click', function(){
        var f=t.getAttribute('data-fam'); setBoardFam(f);
        var ct=document.querySelector('#sc-tabs .sc-tab[data-fam="'+f+'"]');   // drive the cycle map too
        if(ct && !ct.classList.contains('on')) ct.click();
      });
    });
    document.querySelectorAll('#sc-tabs .sc-tab').forEach(function(t){          // and mirror the cycle map back
      t.addEventListener('click', function(){ setBoardFam(t.getAttribute('data-fam')); });
    });
  }

  /* ---- embedded live sector desk (chinasectordata/desk.json) ---- */
  var DESK=null, _spid=0;
  function pcCell(v){ if(v==null) return '<span class="na">·</span>'; return '<span class="'+(v>=0?'up':'dn')+'">'+(v>=0?'+':'')+v.toFixed(2)+'%</span>'; }
  function deskSpark(arr){
    if(!arr||arr.length<2) return '';
    var w=120,h=30,pad=3,n=arr.length,mn=Math.min.apply(null,arr),mx=Math.max.apply(null,arr),rng=(mx-mn)||1,up=arr[n-1]>=arr[0];
    var X=function(i){return (i/(n-1))*(w-2*pad)+pad;}, Y=function(v){return h-pad-((v-mn)/rng)*(h-2*pad);};
    var pts=arr.map(function(v,i){return X(i).toFixed(1)+','+Y(v).toFixed(1);}).join(' ');
    var col=up?'#1FA971':'#e5484d'; if(lang()==='zh') col=up?'#e5484d':'#1FA971';
    var gid='dspk'+(_spid++);
    return '<svg width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" style="display:block">'+
      '<defs><linearGradient id="'+gid+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="'+col+'" stop-opacity="0.25"/><stop offset="1" stop-color="'+col+'" stop-opacity="0"/></linearGradient></defs>'+
      '<polygon points="'+pad+','+(h-pad)+' '+pts+' '+(w-pad)+','+(h-pad)+'" fill="url(#'+gid+')"/>'+
      '<polyline fill="none" stroke="'+col+'" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" points="'+pts+'"/></svg>';
  }
  function deskChip(x, extra){ return '<span class="ch">'+esc(lang()==='zh'?(x.name_zh||x.name):x.name)+' '+extra+'</span>'; }
  function renderDesk(){
    if(!DESK) return;
    var sec=DESK.sectors||[], sm=DESK.summary||{};
    function chipset(k, arr, val){ return '<div class="chipset"><div class="k">'+k+'</div>'+(arr||[]).map(function(x){return deskChip(x,val(x));}).join('')+'</div>'; }
    document.getElementById('sc-desk-chips').innerHTML=
      chipset('🏆 '+L('RS leaders (60d)','相对强度领先'), sm.leaders, function(x){return pcCell(x.rs_60d);})+
      chipset('🐌 '+L('RS laggards','相对强度落后'), sm.laggards, function(x){return pcCell(x.rs_60d);})+
      chipset('📉 '+L('Beaten down','超跌'), sm.washed_out, function(x){return '<b>'+Math.round(x.score)+'</b>';})+
      chipset('📈 '+L('Overheated','过热'), sm.euphoric, function(x){return '<b>'+Math.round(x.score)+'</b>';});
    var head='<thead><tr>'+
      '<th data-c="0" data-t="s">'+L('Sector','行业')+'</th><th data-c="1" data-t="n">'+L('ETF','ETF')+'</th>'+
      '<th data-c="2" data-t="n">1D</th><th data-c="3" data-t="n">5D</th><th data-c="4" data-t="n">20D</th><th data-c="5" data-t="n">YTD</th>'+
      '<th data-c="6" data-t="n">'+L('RS 60d','相对强度')+'</th><th data-c="7" data-t="n">'+L('Cycle pos.','周期位置')+'</th>'+
      '<th data-c="8" data-t="s">'+L('State','状态')+'</th><th data-c="9" data-t="n">PE</th><th data-c="10" data-t="s">'+L('3y trend','3年走势')+'</th></tr></thead>';
    var rows=sec.map(function(s){
      var nm=lang()==='zh'&&s.name_zh?s.name_zh:s.name, p=s.position||{};
      var posCell = p.score!=null
        ? '<span class="scc-mbar"><i style="left:'+p.score+'%"></i></span> <span class="muted" style="font-size:10.5px">'+esc(lang()==='zh'?(p.label_zh||p.label):p.label)+'</span>'
        : '<span class="na">·</span>';
      var rs=(s.rs&&s.rs.mom_60d!=null)?pcCell(s.rs.mom_60d):'<span class="na">·</span>';
      var st=(s.cycle&&s.cycle.state)?'<span class="scc-cyc">'+zhv(s.cycle.state, STATEDESK_ZH)+'</span>':'<span class="na">·</span>';
      var pe=(s.valuation&&s.valuation.pe!=null)?s.valuation.pe:'·';
      var etf=(s.etf_last!=null)?s.etf_last.toFixed(3):'·';
      return '<tr><td><span class="nm"><a href="sector_cycles_china.html#'+esc(s.sw_code)+'" data-focus="'+esc(s.sw_code)+'">'+esc(nm)+'</a><small>'+esc(s.sw_code)+'</small></span></td>'+
        '<td>'+etf+'</td><td>'+pcCell(s.chg_1d)+'</td><td>'+pcCell(s.chg_5d)+'</td><td>'+pcCell(s.chg_20d)+'</td><td>'+pcCell(s.chg_ytd)+'</td>'+
        '<td>'+rs+'</td><td style="text-align:left">'+posCell+'</td><td style="text-align:left">'+st+'</td><td>'+pe+'</td><td>'+deskSpark(s.spark)+'</td></tr>';
    }).join('');
    var tbl=document.getElementById('sc-desk-tbl'); tbl.innerHTML=head+'<tbody>'+rows+'</tbody>';
    tbl.querySelectorAll('th').forEach(function(th){
      th.addEventListener('click',function(){
        var ci=+th.getAttribute('data-c'), isNum=th.getAttribute('data-t')==='n', tb=tbl.tBodies[0];
        var rws=Array.prototype.slice.call(tb.rows), asc=th._asc=!th._asc;
        rws.sort(function(a,b){
          var x=a.cells[ci].textContent.trim(), y=b.cells[ci].textContent.trim();
          if(isNum){ var nx=parseFloat(x.replace(/[^0-9.\-]/g,'')), ny=parseFloat(y.replace(/[^0-9.\-]/g,''));
            if(isNaN(nx))return 1; if(isNaN(ny))return -1; return asc?nx-ny:ny-nx; }
          return asc?x.localeCompare(y):y.localeCompare(x);
        });
        rws.forEach(function(r){tb.appendChild(r);});
      });
    });
    document.getElementById('sc-desk-key').innerHTML=
      L('Cycle position','周期位置')+': <span class="pk pk-lo"></span> '+L('beaten down (near lows)','超跌（接近低位）')+
      ' → <span class="pk pk-hi"></span> '+L('overheated (near highs)','过热（接近高位）')+' · '+L('green = doing well, red = doing poorly','绿=表现强，红=表现弱');
    document.getElementById('sc-desk').hidden=false;
    var dt=document.getElementById('sc-desk-table');
    if(dt){ dt.hidden=false; dt.open = window.innerWidth>880; }   // open on desktop, collapsed on phones
  }
  function loadDesk(){
    if(!window.fetch) return;
    fetch('chinasectordata/desk.json').then(function(r){return r.ok?r.json():null;}).then(function(j){ if(j){ DESK=j; renderDesk(); } }).catch(function(){});
  }

  /* ---- grader scorecard ---- */
  function renderGrader(){
    var el=document.getElementById('grader');
    if(!GR || !GR.available){ el.hidden=false; el.innerHTML='<h2>'+L('Self-grader','自评分器')+'</h2><div class="muted sm">'+
      L('Accruing — dated calls are logged and will be graded against realized forward returns as time passes ('+(GR.n_calls||0)+' calls logged).',
        '累积中 — 带日期的判断已记录，将随时间推移对照已实现的前瞻收益进行评分（已记录 '+(GR.n_calls||0)+' 个判断）。')+'</div>'; return; }
    var bh=GR.by_horizon||{}, cells=[];
    ['21d','63d','126d'].forEach(function(k){
      var h=bh[k]; if(!h) return;
      if(h.dir_hit_rate==null){ cells.push('<div class="gr-cell"><div class="rg-k">'+k+'</div><div class="muted sm">'+L('accruing','累积中')+' (n='+(h.n||0)+')</div></div>'); return; }
      cells.push('<div class="gr-cell"><div class="rg-k">'+k+' · n='+h.n+'</div>'+
        '<div class="rg-v" style="font-size:16px">'+Math.round(h.dir_hit_rate*100)+'% '+L('hit','命中')+'</div>'+
        '<div class="rg-d">'+L('rank-IC','秩相关')+' '+(h.rank_ic!=null?h.rank_ic:'—')+' · '+L('excess','超额')+' '+(h.mean_excess_vs_bench!=null?(h.mean_excess_vs_bench*100).toFixed(1)+'%':'—')+'</div></div>');
    });
    el.hidden=false;
    el.innerHTML='<h2>'+L('Self-grader — measured accuracy','自评分器 — 已衡量准确度')+'</h2>'+
      '<div class="muted sm">'+L('Realized directional hit-rate, cross-sectional rank-IC and excess-vs-benchmark of the conviction calls, by horizon. Sparse until it accrues; never fed back into the live score.',
        '按时间跨度衡量信念判断的已实现方向命中率、横截面秩相关与超越基准的超额收益。数据累积前较稀疏；绝不回灌入实时评分。')+'</div>'+
      '<div class="gr-grid">'+(cells.join('')||'<div class="muted sm">'+L('accruing','累积中')+'</div>')+'</div>';
  }

  function focusDelegate(e){
    var a=e.target.closest('a[data-focus]'); if(!a) return;
    var id=a.getAttribute('data-focus');
    if(window.SectorCyclesFocus && window.SectorCyclesFocus(id)) e.preventDefault();
  }
  function boot(){
    regimeBanner(); renderBoard(); renderGrader(); loadDesk(); linkTabs();
    // card name / "open cycle →" / desk name → focus the embedded cycle map in place when possible
    var board=document.getElementById('board'); if(board) board.addEventListener('click', focusDelegate);
    var desk=document.getElementById('sc-desk'); if(desk) desk.addEventListener('click', focusDelegate);
    // the "Full sector table" rail link should OPEN the (mobile-collapsed) table it jumps to
    var railTbl=document.getElementById('sc-rail-table');
    if(railTbl) railTbl.addEventListener('click', function(){ var dt=document.getElementById('sc-desk-table'); if(dt) dt.open=true; });
    document.addEventListener('langchange', function(){ regimeBanner(); renderBoard(); renderGrader(); renderDesk(); });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{# the embedded cycle-map overlay — same engine + data as sector_cycles_china.html. It reads
   window.SECTOR_CYCLES (distinct from the board's window.SECTOR_CENTRAL) and renders into the
   cyc-stage above; missing sc-cards is handled gracefully (the board replaces the scorecards). #}
