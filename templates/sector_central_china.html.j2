<script>
/* Payload externalized (consolidation gate 5): fetched from chinabasketdata/baskets.json —
   the single envelope carrying baskets + chart + story + theme_intel (W1 pins inline≡fetched). */
/* BASKETS/CHART/THEME are cross-script globals: baskets_desk.js reads all three from the
   shared global scope (the old page declared them as top-level consts). Keep them var +
   assigned, never re-declared inside the wrapper, or the desk silently renders nothing. */
var BASKETS = null, CHART = null, THEME = null;
function __csiInitPage(payload){
  BASKETS = payload; CHART = payload.chart || {};

THEME = BASKETS.theme_intel || null;
window.BASKET_BASE = '{{ basket_base }}';

const TBL_COLS = ['1d','5d','20d','60d','MTD','YTD'];
const RANGES = [['3M',63],['6M',126],['YTD','ytd'],['1Y',252],['All',0]];
const HZ_TABS = ['1d','5d','20d','60d','YTD'];
const PALETTE = ['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635','#38bdf8','#e879f9','#34d399','#fbbf24','#60a5fa','#c084fc','#22d3ee','#f87171','#bef264','#818cf8','#fcd34d','#5eead4','#fda4af'];
const colorOf = {}; (BASKETS.baskets||[]).forEach((b,i)=>colorOf[b.id]=PALETTE[i%PALETTE.length]);
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const BENCH_COLOR = () => cssv('--muted') || '#94a3b8';

// ---- score helpers ---------------------------------------------------------
const scoreBand = s => s==null ? 'neutral' : (s>=65?'strong':s>=45?'neutral':'weak');
const scoreBadgeHtml = s => s==null ? '' :
  `<span class="score-badge ${scoreBand(s)}">${s}</span>`;
// Plain-word turn-state display (no raw enum slugs per doctrine §6).
const TURN_PLAIN = {
  WASHED_OUT: {en:'washed out', zh:'超跌', cls:'washed_out'},
  BASING:     {en:'basing',     zh:'筑底', cls:'basing'},
  TURNING:    {en:'turning',    zh:'转折', cls:'turning'},
  CONFIRMED:  {en:'confirmed',  zh:'确认', cls:'confirmed'},
};
const turnChipHtml = ts => {
  const tp = TURN_PLAIN[ts]; if(!tp) return '';
  const lbl = LANG()==='zh' ? tp.zh : tp.en;
  return `<span class="turn-chip ${tp.cls}">${esc(lbl)}</span>`;
};
// Signal tier chip (display-only, bilingual via LANG()).
const SIG_LABELS = {T1:{en:'T1 signal',zh:'T1信号'}, T2:{en:'T2 signal',zh:'T2信号'}, T3:{en:'T3 forming',zh:'T3预备'}};
const sigChipHtml = (tier, fresh) => {
  if(!tier || !SIG_LABELS[tier]) return '';
  const lbl = LANG()==='zh' ? SIG_LABELS[tier].zh : SIG_LABELS[tier].en;
  const fr = fresh ? `<span class="sig-fresh" data-tip="${LANG()==='zh'?'信号在近10根K线内触发':'signal fired within the last 10 bars'}">●</span>` : '';
  return `<span class="sig-chip">&#9889;${esc(lbl)}${fr}</span>`;
};

// ---- bilingual helpers (the page re-renders on langchange) -----------------
const LANG = () => document.documentElement.getAttribute('data-lang')||'en';
const bn  = b => (LANG()==='zh' && b && b.name_zh) ? b.name_zh : (b?b.name:'');
const bth = b => (LANG()==='zh' && b && b.thesis_zh) ? b.thesis_zh : (b?b.thesis:'');
const BENCH = () => LANG()==='zh' ? (BASKETS.benchmark_label_zh||'沪深300') : (BASKETS.benchmark_label||'CSI 300');
const CAT_ZH = {}; (BASKETS.categories||[]).forEach((c,i)=>CAT_ZH[c]=(BASKETS.categories_zh||[])[i]||c);
const catLabel = c => (LANG()==='zh' && CAT_ZH[c]) ? CAT_ZH[c] : c;
const VS = () => (LANG()==='zh'?'相对 ':'vs ')+BENCH();
const TABLE_LIMIT = 12;
let query = '';
let tableExpanded = false;
let chartScope = localStorage.getItem('cnfw-chart-scope') || 'cats';
let chartCat = localStorage.getItem('cnfw-chart-cat') || 'all';

const fmtPct = x => x==null ? '—' : (x>=0?'+':'')+(x*100).toFixed(1)+'%';
const fmtZ   = x => x==null ? '—' : (x>=0?'+':'')+x.toFixed(1)+'σ';
const cls    = x => x==null ? 'muted' : (x>=0?'pos':'neg');
const esc    = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const norm   = s => (s==null?'':String(s)).toLowerCase().replace(/[\s_\-·/()（）]+/g,'');
// detailKey: THS baskets use ths_ prefix → slug is underscore-stripped (ths_semis→ths-semis).
// Curated baskets (cn_*) keep underscores as-is (cn_pharma_cxo → cn_pharma_cxo).
// Explicit safe mapping: never silently mangle a curated basket id.
const detailKey = b => {
  const raw = b.detail_key || b.id || '';
  if(raw.startsWith('ths_')) return raw.replace(/_/g,'-');
  return raw;
};
// curated basket detail pages are written to basket_china/ (build_theme_detail);
// THS concept pages live under subsector_china/ — the old single-path href 404'd curated links
const detailHref = b => String(b?.id||'').startsWith('ths_')
  ? `subsector_china/${detailKey(b)}.html` : `basket_china/${detailKey(b)}.html`;
const nameLink = b => `<a class="blink" href="${esc(detailHref(b))}" data-nav="detail">${esc(bn(b))}</a>`;
const basketText = b => [b?.id,b?.name,b?.name_zh,b?.category,b?.category_zh,b?.thesis,b?.thesis_zh,(b?.members||[]).map(m=>[m.symbol,m.name].join(' ')).join(' ')].join(' ');
function filteredBaskets(){
  const q=norm(query);
  const rows=(BASKETS.baskets||[]);
  return q ? rows.filter(b=>norm(basketText(b)).includes(q)) : rows.slice();
}
function updateCount(){
  const el=document.getElementById('basket-count'); if(!el) return;
  const n=tblFilteredBaskets().length, total=(BASKETS.baskets||[]).length;
  el.textContent = LANG()==='zh' ? `${n} / ${total} 个主题` : `${n} of ${total} themes`;
}
// bilingual span pair (local name — the non-lite page also loads baskets_desk.js, which owns `L`)
const _bl    = (en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`;
// L alias for leg-toggle buttons — guarded so the non-lite page (which loads baskets_desk.js)
// does not throw "Identifier 'L' has already been declared" (classic scripts share one lexical scope).
window.L = window.L || ((en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`);
// isZh() defined by baskets_desk.js on non-lite; guard for lite path
if(typeof isZh==='undefined') window.isZh=function(){ return document.documentElement.getAttribute('data-lang')==='zh'; };
const lastIdx = a => { for(let i=a.length-1;i>=0;i--) if(a[i]!=null) return i; return -1; };
const hzLabel = c => c==='ytd'?'YTD':c;

function startIdxFor(col,dates,li){
  const u = col.toUpperCase();
  if(u==='MTD'||u==='YTD'){ const p = dates[li].slice(0, u==='MTD'?7:4); let i=li; while(i>0 && dates[i-1].startsWith(p)) i--; return i>0?i-1:null; }
  const i = li-parseInt(col,10); return i>=0?i:null;
}
function winRet(levels,col){ if(!levels) return null; const li=lastIdx(levels); if(li<0) return null;
  const si=startIdxFor(col,CHART.dates,li); if(si==null||levels[si]==null) return null; return levels[li]/levels[si]-1; }
function winZ(levels,col){ const n=parseInt(col,10); if(!n||!levels) return null; const li=lastIdx(levels); if(li<252+n) return null;
  const hr=[]; for(let i=li-252;i<=li;i++) hr.push((levels[i]!=null&&levels[i-n]!=null)?levels[i]/levels[i-n]-1:null);
  const cur=hr[hr.length-1]; const base=hr.slice(0,-1).filter(v=>v!=null); if(cur==null||base.length<200) return null;
  const m=base.reduce((a,b)=>a+b,0)/base.length; const sd=Math.sqrt(base.reduce((a,b)=>a+(b-m)**2,0)/(base.length-1)); return sd>0?(cur-m)/sd:null; }
const ratio = a => a.map((v,i)=>(v!=null&&CHART.bench[i]!=null)?v/CHART.bench[i]:null);

function sparkSvg(values,{w=92,h=26,color=''}={}){
  const vs=(values||[]).filter(v=>v!=null); if(vs.length<2) return '';
  const min=Math.min(...vs),max=Math.max(...vs),span=(max-min)||1;
  const pts=vs.map((v,i)=>[i/(vs.length-1)*w, h-3-(v-min)/span*(h-7)]);
  const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
  const col = color || (vs[vs.length-1]>=vs[0]?cssv('--up'):cssv('--down'));
  const e=pts[pts.length-1];
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><path d="${d}" fill="none" stroke="${col}" stroke-width="1.4"/><circle cx="${e[0].toFixed(1)}" cy="${e[1].toFixed(1)}" r="1.6" fill="${col}"/></svg>`;
}
const sparkTail = (levels,n=60) => (levels||[]).filter(x=>x!=null).slice(-n);

function renderTabs(el, opts, active, cb){
  el.innerHTML = opts.map(([v,lab])=>`<button data-v="${v}" class="${v==active?'on':''}">${lab}</button>`).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{ el.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); cb(b.dataset.v); });
}

// ---- 01 table — category filter -------------------------------------------
let btblMode = localStorage.getItem('cnfw-btbl-mode')||'rel';
// Bumped key: cnfw-btbl-sort-v2 (adds score column — old prefs had no score col).
let btblSort = JSON.parse(localStorage.getItem('cnfw-btbl-sort-v2')||'{"col":"20d","dir":-1}');
let tblCatFilter = 'all'; // 'all' or a category string
function renderTblCatFilter(){
  const host=document.getElementById('tbl-cat-filter'); if(!host) return;
  const zh=LANG()==='zh';
  const cats=['all',...(BASKETS.categories||[])];
  host.innerHTML=cats.map(c=>{
    const lbl=c==='all'?(zh?'全部':'All'):esc(catLabel(c));
    return `<button type="button" data-c="${esc(c)}" class="${c===tblCatFilter?'on':''}">${lbl}</button>`;
  }).join('');
  host.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    tblCatFilter=b.dataset.c; tableExpanded=false; renderTblCatFilter(); renderBTable(); updateCount();
  });
}
function tblFilteredBaskets(){
  const rows=filteredBaskets();
  return tblCatFilter==='all' ? rows : rows.filter(b=>b.category===tblCatFilter);
}
function renderBTable(){
  const allowed = new Set(tblFilteredBaskets().map(b=>b.id));
  let rows = Object.entries(CHART.baskets).filter(([id])=>allowed.has(id)).map(([id,lv])=>{
    const b=(BASKETS.baskets||[]).find(x=>x.id===id); const rl=ratio(lv);
    const src = btblMode==='raw'?lv:rl;
    const vals={}; TBL_COLS.forEach(c=>{ vals[c]= btblMode==='sigma' ? (/^\d/.test(c)?winZ(rl,c):null) : winRet(src,c); });
    return {id,b,name:bn(b),color:colorOf[id]||'#888',spark:sparkTail(src),vals,score:b?b.score:null};
  });
  const sc=btblSort.col, dir=btblSort.dir;
  rows.sort((a,b)=>{
    if(sc==='name') return a.name.localeCompare(b.name)*dir;
    if(sc==='score'){ if(a.score==null) return 1; if(b.score==null) return -1; return (a.score-b.score)*dir; }
    const x=a.vals[sc], y=b.vals[sc]; if(x==null) return 1; if(y==null) return -1; return (x-y)*dir;
  });
  const totalRows = rows.length;
  const shownRows = tableExpanded ? rows : rows.slice(0,TABLE_LIMIT);
  const fmt = btblMode==='sigma' ? fmtZ : fmtPct;
  const th = c => `<th class="num ${c===sc?'sel':''}" data-c="${c}">${c}${c===sc?(dir<0?' ▾':' ▴'):''}</th>`;
  const scoreHdrLbl = LANG()==='zh'?'得分':'Score';
  const nameHdr = LANG()==='zh'?'篮子':'Basket';
  let html = `<thead><tr><th data-c="name">${nameHdr}${sc==='name'?(dir<0?' ▾':' ▴'):''}</th>
    <th class="num ${sc==='score'?'sel':''}" data-c="score">${scoreHdrLbl}${sc==='score'?(dir<0?' ▾':' ▴'):''}</th>
    <th class="num">60d</th>${TBL_COLS.map(th).join('')}</tr></thead><tbody>`;
  html += shownRows.map(r=>`<tr><td class="bname" data-id="${r.id}"><span class="dot" style="background:${r.color}"></span>${nameLink(r.b)}</td>
    <td class="num">${r.score!=null?`<span class="score-badge ${scoreBand(r.score)}">${r.score}</span>`:'<span class="muted">—</span>'}</td>
    <td class="num">${sparkSvg(r.spark,{color:r.color})}</td>
    ${TBL_COLS.map(c=>`<td class="num ${cls(r.vals[c])}">${r.vals[c]==null?'<span class="muted">—</span>':fmt(r.vals[c])}</td>`).join('')}</tr>`).join('');
  if(btblMode==='raw'){ const bv={}; TBL_COLS.forEach(c=>bv[c]=winRet(CHART.bench,c));
    html += `<tr><td class="bname" style="font-weight:500"><span class="dot" style="background:${BENCH_COLOR()}"></span>${esc(BENCH())}</td><td></td><td></td>${TBL_COLS.map(c=>`<td class="num ${cls(bv[c])}">${fmtPct(bv[c])}</td>`).join('')}</tr>`; }
  html += '</tbody>';
  const tbl=document.getElementById('btable'); tbl.innerHTML=html;
  tbl.querySelectorAll('th[data-c]').forEach(h=>h.onclick=()=>{ const c=h.dataset.c;
    if(c===btblSort.col) btblSort.dir*=-1; else btblSort={col:c,dir:c==='name'?1:-1};
    localStorage.setItem('cnfw-btbl-sort-v2',JSON.stringify(btblSort)); renderBTable(); });
  const more=document.getElementById('table-more');
  if(more){
    const hiddenN=Math.max(0,totalRows-TABLE_LIMIT);
    more.style.display=hiddenN?'inline-block':'none';
    more.textContent=tableExpanded
      ? (LANG()==='zh'?'收起':'Show less')
      : (LANG()==='zh'?`查看更多 ${hiddenN} 个`:`See more ${hiddenN}`);
    more.onclick=()=>{ tableExpanded=!tableExpanded; renderBTable(); };
  }
  updateCount();
}

// ---- 02 chart -------------------------------------------------------------
let chart=null, chartMode='rel', chartRange=parseInt(localStorage.getItem('cnfw-brange')||'252',10)||252, hidden={};
/* Set when renderChart() is asked to draw while #chart is still inside a display:none
   view; si:view clears it the moment Explore is really on screen. See renderChart(). */
let _chartDeferred=false;
// Crosshair floating tooltip
let _xhTooltip=null;
function _xhTip(){
  if(!_xhTooltip){
    _xhTooltip=document.createElement('div');
    _xhTooltip.id='cn-ch-tip';
    _xhTooltip.style.cssText='position:absolute;pointer-events:none;display:none;background:var(--panel2,#1e222a);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:11.5px;white-space:nowrap;z-index:30;box-shadow:0 4px 16px rgba(0,0,0,.3)';
    const chartEl=document.getElementById('chart');
    if(chartEl){ chartEl.style.position='relative'; chartEl.appendChild(_xhTooltip); }
  }
  return _xhTooltip;
}
function avgLevels(levelSets){
  const out=[];
  for(let i=0;i<CHART.dates.length;i++){
    const vals=levelSets.map(a=>a?.[i]).filter(v=>v!=null);
    out.push(vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null);
  }
  return out;
}
function chartSets(){
  const baskets=filteredBaskets();
  const sourceLevels = id => chartMode==='rel' ? ratio(CHART.baskets[id]||[]) : (CHART.baskets[id]||[]);
  if(chartScope==='cats'){
    const cats=(BASKETS.categories||[]).map((c,i)=>({cat:c,color:PALETTE[i%PALETTE.length]}))
      .filter(x=>chartCat==='all'||x.cat===chartCat)
      .map(x=>{
        const ids=baskets.filter(b=>b.category===x.cat && CHART.baskets[b.id]).map(b=>b.id);
        return ids.length ? {key:'cat:'+x.cat,label:catLabel(x.cat),color:x.color,levels:avgLevels(ids.map(sourceLevels)),n:ids.length} : null;
      }).filter(Boolean);
    return chartMode==='abs' ? [...cats,{key:'bench',label:BENCH(),color:BENCH_COLOR(),levels:CHART.bench}] : cats;
  }
  let subBaskets=baskets.filter(b=>chartCat==='all'||b.category===chartCat);
  if(chartCat==='all'){
    subBaskets=subBaskets.slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0)).slice(0,12);
  }
  const sets=subBaskets
    .filter(b=>CHART.baskets[b.id])
    .map(b=>({key:b.id,label:bn(b),color:colorOf[b.id]||'#888',levels:sourceLevels(b.id)}));
  return chartMode==='abs' ? [...sets,{key:'bench',label:BENCH(),color:BENCH_COLOR(),levels:CHART.bench}] : sets;
}
function rangeStart(dates){ if(chartRange==='ytd'){ const y=dates[dates.length-1].slice(0,4); const i=dates.findIndex(d=>d.startsWith(y)); return i<=0?0:i-1; }
  return chartRange?Math.max(0,dates.length-chartRange):0; }
function chartOpts(){ return { autoSize:true,
  layout:{ background:{type:'solid',color:'transparent'}, textColor:cssv('--muted')||'#9aa4b2', fontSize:11 },
  grid:{ vertLines:{visible:false}, horzLines:{color:cssv('--line')||'#222'} },
  rightPriceScale:{ borderColor:cssv('--line')||'#222' }, timeScale:{ borderColor:cssv('--line')||'#222' },
  crosshair:{ mode:0, vertLine:{labelBackgroundColor:cssv('--panel2')||'#333'}, horzLine:{labelBackgroundColor:cssv('--panel2')||'#333'} } }; }
function renderChart(){
  const el=document.getElementById('chart'); if(typeof LightweightCharts==='undefined'){ el.innerHTML='<p class="muted">The charting library failed to load — the rest of the page is unaffected.</p>'; return; }
  /* Under the workspace shell #chart starts inside a display:none view, where it measures
     0 wide — and the basket payload lands (calling us) long before anyone opens Explore.
     lightweight-charts binds autoSize at CREATION: a chart born zero-wide never recovers.
     Measured 2026-08-04: after the view was shown, neither a window resize event nor a
     container width nudge moved its canvases off 0px. So do not create it yet — mark the
     draw deferred and let the si:view handler below run us again with a real box. */
  if(!chart && !el.clientWidth){ _chartDeferred=true; return; }
  if(!chart){ chart=LightweightCharts.createChart(el,chartOpts()); }
  (chart.__series||[]).forEach(s=>chart.removeSeries(s)); chart.__series=[];
  const start=rangeStart(CHART.dates);
  const sets=chartSets().filter(s=>!hidden[s.key]); const nVis=sets.length;
  const seriesMeta=[];
  sets.forEach(set=>{
    let base=null; const data=[];
    for(let i=start;i<CHART.dates.length;i++){ const v=set.levels[i]; if(v==null) continue; if(base===null) base=v; data.push({time:CHART.dates[i], value:100*(v/base-1)}); }
    if(data.length<2) return;
    const s=chart.addLineSeries({ color:set.color, lineWidth:2, priceLineVisible:false, lastValueVisible:nVis<=4, title:nVis<=4?set.label:'',
      priceFormat:{type:'custom',minMove:0.01,formatter:v=>(v>=0?'+':'')+v.toFixed(1)+'%'} });
    s.setData(data); chart.__series.push(s); seriesMeta.push({key:set.key,color:set.color,label:set.label,s,data});
  });
  // Crosshair move — show nearest basket name + value (bilingual via isZh)
  if(chart.__xhSub){ try{ chart.__xhSub.unsubscribe(); }catch(e){} }
  const tip=_xhTip();
  chart.__xhSub=chart.subscribeCrosshairMove(function(param){
    if(!param||!param.point||!param.seriesData||!param.seriesData.size){tip.style.display='none';return;}
    let best=null, bestDist=Infinity;
    seriesMeta.forEach(m=>{
      const d=param.seriesData.get(m.s);
      if(d==null) return;
      const pxY=m.s.priceToCoordinate?m.s.priceToCoordinate(d.value):null;
      const dist=pxY!=null?Math.abs(pxY-(param.point.y||0)):Math.abs(d.value-(param.point.y||0));
      if(dist<bestDist){bestDist=dist;best={...m,val:d.value};}
    });
    if(!best){tip.style.display='none';return;}
    const v=best.val;
    const nm=isZh()?(BASKETS.baskets||[]).find(b=>b.id===best.key)?.name_zh||best.label:best.label;
    tip.innerHTML=`<span style="color:${best.color}">●</span> ${esc(nm)} <b style="color:${v>=0?'var(--up)':'var(--down)'}">${(v>=0?'+':'')+v.toFixed(1)}%</b>`;
    const x=param.point.x, y=param.point.y;
    tip.style.left=(x+12)+'px'; tip.style.top=(y-18)+'px'; tip.style.display='block';
  });
  // Guard: attach mouseleave once per element
  if(!el._mlGuard){ el._mlGuard=true; el.addEventListener('mouseleave',()=>{tip.style.display='none';},{passive:true}); }
  chart.timeScale().fitContent(); renderChartLegend();
}
function renderChartLegend(){
  const el=document.getElementById('chart-legend'); const st=rangeStart(CHART.dates);
  const chips=chartSets().map(s=>{ const li=lastIdx(s.levels); let base=null; for(let i=st;i<=li;i++){ if(s.levels[i]!=null){ base=s.levels[i]; break; } }
    const v=(base!=null&&s.levels[li]!=null)?100*(s.levels[li]/base-1):null;
    return `<span class="lchip ${hidden[s.key]?'off':''}" data-k="${s.key}"><span class="dot" style="background:${s.color}"></span>${esc(s.label)} <span class="lv">${v==null?'':(v>=0?'+':'')+v.toFixed(1)+'%'}</span></span>`;
  }).join('');
  // All / None toggle buttons (leg-toggle idiom from baskets.html.j2)
  const allBtn=`<button class="leg-toggle" onclick="Object.keys(hidden).forEach(k=>delete hidden[k]);renderChart()">${L('All','全选')}</button>`;
  const noneBtn=`<button class="leg-toggle" onclick="chartSets().forEach(s=>hidden[s.key]=true);renderChart()">${L('None','全不选')}</button>`;
  el.innerHTML=allBtn+noneBtn+chips;
  el.querySelectorAll('.lchip').forEach(c=>c.onclick=()=>{ hidden[c.dataset.k]=!hidden[c.dataset.k]; renderChart(); });
}
function initChartDefaults(){
  if(chartScope!=='subs') return;
  const ranked=filteredBaskets().filter(b=>chartCat==='all'||b.category===chartCat)
    .slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0));
  ranked.slice(8).forEach(b=>hidden[b.id]=true);
}
function renderChartCats(){
  const host=document.getElementById('chart-cats'); if(!host) return;
  const cats=['all',...(BASKETS.categories||[])];
  host.innerHTML=cats.map(c=>{
    const allLab = chartScope==='subs'
      ? (LANG()==='zh'?'全部热门':'Top movers')
      : (LANG()==='zh'?'全部类别':'All categories');
    return `<button type="button" data-c="${esc(c)}" class="${c===chartCat?'on':''}">${c==='all'?allLab:esc(catLabel(c))}</button>`;
  }).join('');
  host.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    chartCat=b.dataset.c; localStorage.setItem('cnfw-chart-cat',chartCat); hidden={}; initChartDefaults(); renderChartCats(); renderChart();
  });
  const note=document.getElementById('chart-note');
  if(note){
    note.textContent = chartScope==='cats'
      ? (LANG()==='zh'?'类别线 = 该类别内所有匹配主题的等权平均走势。':'Category lines are equal-weight averages of every matching theme inside that category.')
      : (LANG()==='zh'?'子行业模式默认显示全市场热门主题；选择类别后可钻入该类别内的具体主题。':'Subsector mode starts with top movers across the market; choose a category to drill into that group.');
  }
}

// ---- 03 cards + details ---------------------------------------------------
let bhz = localStorage.getItem('cnfw-hz')||'20d';
// Bumped key: cnfw-card-sort-v2 (adds Score sort — old stored prefs may have been 'rel').
let cardSort = localStorage.getItem('cnfw-card-sort-v2')||'score';
function kpi(k,p){ const v=p?p.rel:null; return `<div class="kpi"><div class="v ${cls(v)}">${fmtPct(v)}</div><div class="k">${k} ${esc(VS())}</div></div>`; }
function sortedCards(cards){
  if(cardSort==='score'){
    // lite/THS payloads carry no scores — fall back to momentum so the default
    // ordering is never accidental input order (review 07-18)
    if(!cards.some(b=>b.score!=null))
      return cards.slice().sort((a,c)=>((c.perf?.[bhz]?.rel)??-9)-((a.perf?.[bhz]?.rel)??-9));
    return cards.slice().sort((a,c)=>{
      if(a.score==null&&c.score==null) return 0;
      if(a.score==null) return 1; if(c.score==null) return -1;
      return c.score - a.score;
    });
  }
  if(cardSort==='name') return cards.slice().sort((a,c)=>bn(a).localeCompare(bn(c)));
  // momentum: sort by selected hz rel return
  return cards.slice().sort((a,c)=>((c.perf?.[bhz]?.rel)??-9)-((a.perf?.[bhz]?.rel)??-9));
}
function renderCardSortTabs(){
  const host=document.getElementById('card-sort-tabs'); if(!host) return;
  const zh=LANG()==='zh';
  const opts=[['score',zh?'得分':'Score'],['momentum',zh?'动量':'Momentum'],['name',zh?'名称':'Name']];
  host.innerHTML=opts.map(([v,l])=>`<button data-v="${v}" class="${v===cardSort?'on':''}">${l}</button>`).join('');
  host.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    cardSort=b.dataset.v; localStorage.setItem('cnfw-card-sort-v2',cardSort);
    host.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
    renderCards();
  });
}
function renderCards(){
  const el=document.getElementById('cards');
  el.innerHTML=(BASKETS.categories||[]).map(cat=>{
    const since = LANG()==='zh'?'自':'since';
    const memberW = LANG()==='zh'?'只 · ':' members · ';
    const baskets=filteredBaskets().filter(b=>b.category===cat);
    const cards=sortedCards(baskets)
      .map(b=>{ const spk=sparkTail(ratio(CHART.baskets[b.id]));
        const ref=b.reference?` · ${LANG()==='zh'?'对标':'tracks'} ${esc(b.reference.label)} (r ${b.reference.corr.toFixed(2)})`:'';
        // tiny cross-market confirmer badge on AI-supply baskets (context only, not a signal)
        const sx=b.ai_semis_confirmer;
        const sxBadge=(sx&&sx.on!=null)?`<span class="semis-badge ${sx.on?'on':''}" data-tip="cross-market confirmer — global semis momentum context, not a buy signal">${_bl('AI-semis '+(sx.state||''),'全球AI半导体 '+(sx.on?'开启':'关闭'))}</span>`:'';
        const scoreBadge = scoreBadgeHtml(b.score);
        const turnChip = turnChipHtml(b.turn_state);
        return `<div class="card" style="--c:${colorOf[b.id]}" data-id="${b.id}">
          <div class="nm"><span class="dot" style="background:${colorOf[b.id]}"></span>${nameLink(b)}${sxBadge}${scoreBadge}${turnChip}</div>
          <div class="meta">${b.n_members}${memberW}${since} ${esc(b.created)}${ref}</div>
          <div class="th">${esc(bth(b))}</div>
          <div class="perf">${kpi(hzLabel(bhz),b.perf?.[bhz])}${kpi('YTD',b.perf?.ytd)}<span class="spark">${sparkSvg(spk,{w:96,h:30,color:colorOf[b.id]})}</span></div>
        </div>`; }).join('');
    return cards?`<h3 class="cat">${esc(catLabel(cat))}</h3><div class="cards">${cards}</div>`:'';
  }).join('');
  el.querySelectorAll('.card').forEach(c=>c.onclick=()=>openBasket(c.dataset.id));
  el.querySelectorAll('a[data-nav="detail"]').forEach(a=>a.onclick=e=>e.stopPropagation());
}
const SIG_TIER_ORDER = {T1:0, T2:1, T3:2};
function memRows(b){
  // Sort: signal tier present first (T1>T2>T3), then by ret_20d desc.
  const members = (b.members||[]).slice().sort((a,c)=>{
    const ao = a.sig_tier!=null ? (SIG_TIER_ORDER[a.sig_tier]??3) : 99;
    const co = c.sig_tier!=null ? (SIG_TIER_ORDER[c.sig_tier]??3) : 99;
    if(ao!==co) return ao-co;
    return ((c.ret_20d??-9) - (a.ret_20d??-9));
  });
  return members.map(m=>`<tr>
    <td><a href="china_lookup.html#${encodeURIComponent(m.symbol)}"><b>${esc(m.symbol)}</b></a> <span class="muted sm">${esc(m.name)}</span>${sigChipHtml(m.sig_tier, m.sig_fresh)}</td>
    <td class="why">${esc(m.rationale)}</td><td class="num muted sm">${esc(m.added)}</td>
    <td class="num ${cls(m.ret_5d)}">${fmtPct(m.ret_5d)}</td>
    <td class="num ${cls(m.ret_20d)}">${fmtPct(m.ret_20d)}</td><td class="num ${cls(m.ret_ytd)}">${fmtPct(m.ret_ytd)}</td></tr>`).join('');
}
function detailSection(b){
  const p=b.perf||{}; const kr=(k,h)=>`<div><div class="k">${k} ${esc(VS())}</div><div class="v ${cls(p[h]?.rel)}">${fmtPct(p[h]?.rel)}</div></div>`;
  const zh=LANG()==='zh';
  const ref=b.reference?`<p class="refline">${zh?'交叉验证对标':'Cross-checked vs'} <b>${esc(b.reference.label)}</b>${b.reference.name?' — '+esc(b.reference.name):''}: ${zh?'日相关性':'daily correlation'} <b>${b.reference.corr.toFixed(2)}</b>, ${zh?'市场调整后':'market-adjusted'} <b>${b.reference.rel_corr.toFixed(2)}</b> ${zh?'，共':'over'} ${b.reference.n} ${zh?'个交易日':'sessions'}. <span class="muted">(${zh?'市场调整剥离共同的市场Beta — 篮子−基准 vs ETF−基准。':'market-adjusted strips shared market beta — basket−bench vs ETF−bench.'})</span></p>`:'';
  const warns=[]; if((b.missing||[]).length) warns.push(`<span class="warn">${zh?'已剔除（不在缓存）':'excluded (not in free cache)'}: ${b.missing.map(esc).join(', ')}</span>`);
  (b.partial||[]).forEach(pp=>warns.push(`<span class="warn">${esc(pp.symbol)} ${zh?'纳入于':'enters'} ${esc(pp.from)}</span>`));
  const clog=(b.changelog||[]).map(c=>`<li><b>${esc(c.date)}</b> — ${esc(c.action)}: ${esc(c.note)}</li>`).join('');
  const memHdr = zh?['代码','理由','纳入','5d','20d','YTD']:['Symbol','Rationale','Added','5d','20d','YTD'];
  // cross-basket overlap chips
  const ovls = (b.top_overlaps||[]);
  const overlapHtml = ovls.length ? `<div class="overlap-row"><span class="muted sm">${zh?'与以下篮子重叠：':'Overlaps with:'}</span>${
    ovls.map(o=>`<span class="overlap-chip" data-id="${esc(o.id)}">${esc(zh&&o.name_zh?o.name_zh:o.name)} <span class="muted">(${o.n_shared})</span></span>`).join('')
  }</div>` : '';
  // score + reco chip row
  const scoreRow = (b.score!=null||b.reco!=null) ? `<div style="margin:4px 0 6px;display:flex;gap:8px;align-items:center;flex-wrap:wrap">
    ${b.score!=null?scoreBadgeHtml(b.score):''}
    ${(b.reco!=null||b.reco_zh!=null)?`<span class="chip">${esc(zh?(b.reco_zh||b.reco||''):(b.reco||''))}</span>`:''}
    ${turnChipHtml(b.turn_state)}
  </div>` : '';
  return `<div class="detail" id="b-${b.id}"><h4><span class="dot" style="background:${colorOf[b.id]}"></span>${nameLink(b)} <span class="chip">${esc(catLabel(b.category))}</span></h4>
    ${scoreRow}<p class="th">${esc(bth(b))}</p>
    <div class="kpirow">${kr('20d','20d')}${kr('60d','60d')}${kr('MTD','mtd')}${kr('YTD','ytd')}${kr(zh?'全程':'Full','full')}</div>
    ${ref}${overlapHtml}<div>${warns.join(' ')}</div>
    <details open><summary>${zh?'成分':'Members'} (${b.n_members}) &amp; ${zh?'变更记录':'changelog'}</summary>
      <div class="ts"><table><thead><tr><th>${memHdr[0]}</th><th>${memHdr[1]}</th><th class="num">${memHdr[2]}</th><th class="num">${memHdr[3]}</th><th class="num">${memHdr[4]}</th><th class="num">${memHdr[5]}</th></tr></thead><tbody>${memRows(b)}</tbody></table></div>
      <ul class="clog">${clog}</ul>
    </details></div>`;
}
function renderDetails(){
  const el=document.getElementById('details');
  el.innerHTML=(BASKETS.categories||[]).map(cat=>sortedCards(filteredBaskets().filter(b=>b.category===cat))
    .map(detailSection).join('')).join('');
  // wire overlap chip clicks after render
  el.querySelectorAll('.overlap-chip[data-id]').forEach(c=>c.onclick=e=>{ e.stopPropagation(); openBasket(c.dataset.id); });
}
function openBasket(id){ const d=document.getElementById('b-'+id); if(!d) return; const det=d.querySelector('details'); if(det) det.open=true; d.scrollIntoView({behavior:'instant',block:'start'}); }

// ---- Entry Radar (non-lite: curated baskets in the turn lifecycle ONLY; clean-entry is a chip) ----
const RADAR_TURN_ORDER = {CONFIRMED:0, TURNING:1, BASING:2, WASHED_OUT:3};
function renderEntryRadar(){
  const host=document.getElementById('entry-radar'); if(!host) return;
  const zh=LANG()==='zh';
  // Collect baskets that qualify: turn_state in lifecycle OR clean_entry_q >= 0.6.
  const candidates=(BASKETS.baskets||[]).filter(b=>
    RADAR_TURN_ORDER[b.turn_state]!=null
  );
  // Rank: CONFIRMED > TURNING > BASING > WASHED_OUT, tiebreak score desc.
  candidates.sort((a,c)=>{
    const ao = RADAR_TURN_ORDER[a.turn_state]??99;
    const co = RADAR_TURN_ORDER[c.turn_state]??99;
    if(ao!==co) return ao-co;
    return ((c.score??-1)-(a.score??-1));
  });
  // Count members with sig_tier in each basket.
  const sigCount = b => (b.members||[]).filter(m=>m.sig_tier!=null).length;
  const title=zh?'入场雷达':'Entry Radar';
  const subEn='Baskets in the washout-to-confirmed lifecycle. Ranked by lifecycle stage then score. Entry aids, not proof.';
  const subZh='处于超跌到确认生命周期中的篮子。按生命周期阶段再按得分排序。仅为入场辅助，非证明。';
  if(!candidates.length){
    host.innerHTML=`<div class="entry-radar"><div class="er-head">&#9654; ${esc(title)}</div>
      <div class="er-empty">${zh?'目前无满足条件的篮子 — 大多数时候确实如此。':'None right now — most days none.'}</div>
      <div class="er-note">${zh?'生命周期来自超跌状态机；入场辅助，非证明。':'Lifecycle from the washout state machine; entry aids, not proof.'}</div></div>`;
    return;
  }
  const items=candidates.map(b=>{
    const sc=sigCount(b);
    const scNote=sc>0?` · <span class="muted">${sc} ${zh?'只成分有信号':`member${sc>1?'s':''} gated`}</span>`:'';
    const recoWord=zh?(b.reco_zh||b.reco||''):(b.reco||'');
    const ceChip=(b.clean_entry_q!=null&&b.clean_entry_q>=0.7)?`<span class="chip" data-tip="${zh?'清洁入场读数（0-1）— 回调结构质量':'clean-entry reading (0-1) — pullback structure quality'}">${zh?'清洁入场':'clean entry'} ${b.clean_entry_q.toFixed(1)}</span>`:'';
    return `<div class="er-item">
      <a class="blink" href="${esc(detailHref(b))}" data-nav="detail">${esc(bn(b))}</a>
      ${turnChipHtml(b.turn_state)}${scoreBadgeHtml(b.score)}${ceChip}${scNote}
      ${recoWord?`<span class="er-reco">${esc(recoWord)}</span>`:''}
    </div>`;
  }).join('');
  host.innerHTML=`<div class="entry-radar"><div class="er-head">&#9654; ${esc(title)}<span class="chip">${candidates.length}</span></div>
    <div class="er-sub">${zh?subZh:subEn}</div>
    <div class="er-items">${items}</div>
    <div class="er-note">${zh?'生命周期来自超跌状态机；入场辅助，非证明（显示层，无验证前瞻优势）。':'Lifecycle from the washout state machine; entry aids, not proof (display-tier, no validated forward edge).'}</div>
  </div>`;
}

function renderStory(){
  const s=BASKETS.story; if(!s) return; const zh=LANG()==='zh';
  const dot=id=>`<span class="dot" style="background:${colorOf[id]||'#888'}"></span>`;
  const lead=(BASKETS.baskets||[]).find(b=>b.name===s.leader), lag=(BASKETS.baskets||[]).find(b=>b.name===s.laggard);
  const leadNm=esc(zh?(s.leader_zh||s.leader):s.leader), lagNm=esc(zh?(s.laggard_zh||s.laggard):s.laggard);
  document.getElementById('story').innerHTML = zh
    ? `${lead?dot(lead.id):''}<b>${leadNm}</b> 近 20 日领涨主题（<span class="${cls(s.leader_rel)}">${fmtPct(s.leader_rel)}</span> ${esc(VS())}） · ${lag?dot(lag.id):''}<b>${lagNm}</b> 落后（<span class="${cls(s.laggard_rel)}">${fmtPct(s.laggard_rel)}</span>） · 共 <b>${s.n_baskets}</b> 个篮子，跨 <b>${s.n_cats}</b> 个类别。`
    : `${lead?dot(lead.id):''}<b>${leadNm}</b> leads the themes over 20 days (<span class="${cls(s.leader_rel)}">${fmtPct(s.leader_rel)}</span> ${esc(VS())}) · ${lag?dot(lag.id):''}<b>${lagNm}</b> lags (<span class="${cls(s.laggard_rel)}">${fmtPct(s.laggard_rel)}</span>) · <b>${s.n_baskets}</b> baskets across <b>${s.n_cats}</b> categories.`;
}

function renderModeTabs(){
  renderTabs(document.getElementById('btbl-mode'), [['raw', LANG()==='zh'?'原始':'Raw'],['rel',VS()],['sigma','σ']], btblMode, v=>{ btblMode=v; localStorage.setItem('cnfw-btbl-mode',v); renderBTable(); });
  renderTabs(document.getElementById('chart-modes'), [['rel',VS()],['abs', LANG()==='zh'?'绝对':'Absolute']], chartMode, v=>{ chartMode=v; renderChart(); });
  renderTabs(document.getElementById('chart-scope'), [['cats', LANG()==='zh'?'类别':'Categories'],['subs', LANG()==='zh'?'子行业':'Subsectors']], chartScope, v=>{
    chartScope=v; localStorage.setItem('cnfw-chart-scope',v); hidden={}; initChartDefaults(); renderChartCats(); renderChart();
  });
}

// ---- page-level cross-market AI-semis confirmer chip (lite/THS page; #semis-chip host only
// exists there). Honest copy: momentum CONTEXT from global semis, never a buy signal. ----
function renderSemisChip(){
  const host=document.getElementById('semis-chip'); if(!host) return;
  const c=BASKETS.ai_semis_confirmer;
  if(!c||!c.state||c.state==='unavailable'){ host.innerHTML=''; return; }
  const col=c.on===true?'var(--up)':'var(--muted)';
  host.innerHTML=`<div class="semis-chip" style="border-left:3px solid ${col}">
    <b style="color:${col}">${c.on?'⚡':'·'} ${_bl(esc(c.label_en||('AI-semis confirmer: '+c.state)),esc(c.label_zh||c.label_en||''))}</b>
    ${c.as_of?`<span class="muted" style="font-size:11px">${_bl('as of','截至')} ${esc(c.as_of)}</span>`:''}
    <span class="sx-tag">${_bl('cross-market confirmer — global semis momentum context, not a buy signal','跨市场确认信号 — 全球半导体动量背景，非买入信号')}</span>
  </div>`;
}

function renderAll(){ renderStory(); renderModeTabs(); renderTblCatFilter(); renderBTable(); renderChartCats(); renderChart(); renderCardSortTabs(); renderCards(); renderDetails(); renderEntryRadar(); updateCount(); }

function boot(){
  document.getElementById('asof').textContent=BASKETS.as_of||'—';
  const search=document.getElementById('basket-search');
  if(search){
    const syncPh=()=>{ const zh=LANG()==='zh'; search.placeholder=zh?(search.dataset.phZh||search.placeholder):'Search THS concept, category, member or ticker...'; };
    search.value=query;
    search.oninput=()=>{ query=search.value||''; tableExpanded=false; hidden={}; initChartDefaults(); renderBTable(); renderChartCats(); renderChart(); renderCards(); renderDetails(); updateCount(); };
    syncPh();
    document.addEventListener('langchange',syncPh);
  }
  renderTblCatFilter();
  renderModeTabs();
  const rel=document.getElementById('chart-ranges');
  rel.innerHTML=RANGES.map(([lab,v])=>`<button data-v="${v}" class="${v===chartRange?'on':''}">${lab}</button>`).join('')+`<input class="rangeN" type="number" min="5" max="600" placeholder="N days">`;
  rel.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chartRange=(b.dataset.v==='ytd')?'ytd':parseInt(b.dataset.v,10); localStorage.setItem('cnfw-brange',String(chartRange)); rel.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); renderChart(); });
  rel.querySelector('.rangeN').onchange=function(){ const n=Math.min(600,Math.max(5,parseInt(this.value,10)||252)); chartRange=n; localStorage.setItem('cnfw-brange',String(n)); rel.querySelectorAll('button').forEach(x=>x.classList.remove('on')); renderChart(); };
  renderTabs(document.getElementById('hz-tabs'), HZ_TABS.map(h=>[h,hzLabel(h)]), bhz, v=>{ bhz=v; localStorage.setItem('cnfw-hz',v); renderCards(); renderDetails(); });
  renderCardSortTabs();
  initChartDefaults();
  renderStory(); renderBTable(); renderChartCats(); renderChart(); renderCardSortTabs(); renderCards(); renderDetails(); renderEntryRadar(); renderSemisChip(); updateCount();{% if not lite %} deskBoot();
  // W8b parity: cap "What to act on now" columns at 4 rows (matches PR #1992/#2010)
  document.querySelectorAll('#actnow .anlist.lst-collapse').forEach(function(el){ el.classList.add('lst-cap4'); });{% endif %}
  if(location.hash.startsWith('#b-')) setTimeout(()=>openBasket(location.hash.slice(3)),200);
  {% if not lite %}if(location.hash.startsWith('#theme-')) setTimeout(()=>openTheme(location.hash.slice(7)),250);{% endif %}
  document.addEventListener('langchange',()=>{ if(chart){chart.applyOptions(chartOpts());} renderTblCatFilter(); renderAll(); });
  document.addEventListener('themechange',()=>{ if(chart){chart.applyOptions(chartOpts());} renderChart(); });
  /* The overlay chart could not be built while Explore was hidden (see renderChart);
     build it the first time the view is actually on screen. */
  document.addEventListener('si:view',function(e){
    if(e&&e.detail==='explore'&&_chartDeferred){ _chartDeferred=false; renderChart(); }
  });
  /* The basket payload arrives by fetch, well after si_workspace_china.js has run and
     composed its per-view reads off an empty window.BASKETS. Announce the landing so
     the router re-composes them instead of leaving "no data yet" baked into the rail
     footer and the What's Moving / Explore lines. */
  try{ document.dispatchEvent(new CustomEvent('csi:payload')); }catch(e){}
}
/* Cross-script exports — baskets_desk.js reads these seven helpers (plus BASKETS/CHART/THEME,
   which are top-level vars and hence window-attached already) from the shared global scope.
   On the old page they were top-level consts; inside this wrapper they are function-scoped,
   so without the exports the desk's renderers die silently in deskBoot's try/catch
   (measured: .tcard count 0, 'sparkTail is not defined'). Full set = computed intersection
   of the donor script's top-level declarations × identifiers baskets_desk.js reads. */
window.cls = cls; window.cssv = cssv; window.esc = esc; window.fmtPct = fmtPct;
window.ratio = ratio; window.sparkSvg = sparkSvg; window.sparkTail = sparkTail;
if(document.readyState!=='loading') boot(); else document.addEventListener('DOMContentLoaded',boot);
}
(function(){
  function fail(){ var el=document.getElementById('table-section');
    if(el) el.insertAdjacentHTML('beforebegin','<p class="muted sm" style="margin:12px 2px">'+
      '<span class="l-en">Basket data is unavailable right now — the rest of the page still works.</span>'+
      '<span class="l-zh">篮子数据暂不可用 — 页面其余部分不受影响。</span></p>'); }
  fetch('chinabasketdata/baskets.json',{cache:'no-cache'})
    .then(function(r){ if(!r.ok) throw new Error('http '+r.status); return r.json(); })
    .then(__csiInitPage).catch(function(e){ try{ fail(); }catch(_){} });
})();
