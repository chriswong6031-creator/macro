<title>China Sector Intelligence — Mastermind</title>
{% set seo_title = "China Sector Intelligence — Mastermind" %}{% set seo_desc = "China's sectors and themes on one page — the gated board, cycle map, whole-market rotation and basket explorer, updated after each Asia close." %}{% set seo_path = "sector_central_china.html" %}
