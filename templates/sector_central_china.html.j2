{# data-sync, not defer: optimize_assets marks every <script src> `defer` unless it
   opts out, and a deferred payload executes AFTER the inline bootstrap below — which
   reads window.SECTOR_CENTRAL on its first line and returns when it is missing. That
   one attribute is the difference between a full conviction board and an empty page
   (the regime banner, board, grader and full sector table were all dark until it was
   added). Pinned by tests/test_sector_central_data_is_sync.py. #}
<script data-sync src="sector_central_china_data.js"></script>
<script>
(function(){
  "use strict";
  var D = window.SECTOR_CENTRAL; if (!D) return;
  /* FIX 1a — strip "(Equal-Weight)" / "（等权）" suffixes from all string values at boot */
  var _ewRe = /\s*[（(]\s*(?:equal[-\s]?weight(?:ed)?|等权(?:重)?)\s*[）)]/gi;
  function deepStrip(obj) {
    if (obj === null || typeof obj !== 'object') return;
    var keys = Object.keys(obj);
    for (var _k = 0; _k < keys.length; _k++) {
      var _key = keys[_k], _val = obj[_key];
      if (typeof _val === 'string') { obj[_key] = _val.replace(_ewRe, ''); }
      else if (_val && typeof _val === 'object') { deepStrip(_val); }
    }
  }
  deepStrip(D);
  var M = D.market || {};
  function lang(){ return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en"; }
  function L(en, zh){ return '<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>'; }
  function esc(s){ return (s==null?'':String(s)).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  // translate an engine-emitted English value into 中文 when in zh mode (else show it as-is).
  function zhv(en, m){ var e=(en==null?'':String(en)); return (lang()==='zh' && m[e]) ? m[e] : esc(e); }
  var QUAD_ZH={'Goldilocks':'温和增长','Reflation':'再通胀','Stagflation':'滞胀','Deflation':'通缩','Inflation':'通胀'};
  // liquidity is emitted lowercase ('neutral'); keep Title-case keys too as harmless extras
  var LIQ_ZH={'neutral':'中性','easing':'宽松','tightening':'收紧','expanding':'扩张','contracting':'收缩','tight':'偏紧','loose':'宽松','supportive':'支持性','restrictive':'偏紧',
              'Neutral':'中性','Easing':'宽松','Tightening':'收紧','Expanding':'扩张','Contracting':'收缩'};
  var PHASE_ZH={'Topping':'见顶','Trending':'上行','Rolling over':'回落','Prime entry':'入场良机','Bottoming':'筑底','Peak':'见顶','Expansion':'上行','Downturn':'回落','Recovery':'入场良机','Trough':'筑底'};
  var CONF_ZH={'high':'高','moderate':'中等','low/mixed':'低/混合','low':'低','mixed':'混合'};
  // desk cycle.state is emitted as {BOTTOM WATCH, DECLINE, RALLY ON, ROLLING OVER}
  var STATEDESK_ZH={'BOTTOM WATCH':'筑底观察','DECLINE':'下行','RALLY ON':'上行','ROLLING OVER':'回落',
                    'Washed out':'超跌','Beaten down':'超跌','Euphoric':'过热','Overheated':'过热','Recovering':'复苏'};
  // reasoning layers are emitted Title-case multi-word
  var LAYER_ZH={'Cycle state':'周期状态','Forward odds':'前瞻概率','Regime gate':'体制门控','Momentum':'动量','Fragility':'脆弱度','Crowding':'拥挤度','Flow':'资金流','Heat':'热度','Trend':'趋势'};

  /* ---- regime banner ---- */
  function regimeBanner(){
    var risk=M.risk_on, tone=(risk==null)?'mix':(risk>0.15?'on':risk<-0.15?'off':'mix');
    // plain-language headline so a non-expert gets the "is this good or bad?" read instantly
    var headTxt = tone==='on' ? L('China equities are risk-on right now.','当前A股偏好风险。')
      : tone==='off' ? L('China equities are leaning defensive right now.','当前A股偏防御。')
      : L('China equities are mixed right now.','当前A股信号中性。');
    var headIc = tone==='off' ? '⚠' : tone==='on' ? '✓' : '•';
    var head='<div class="rg-headline-row rg-hl-'+tone+'"><span class="rg-hl-ic">'+headIc+'</span><span>'+headTxt+'</span></div>';

    // W0.4: regime-cap notice — render whenever the gate pins any tier structurally unreachable.
    // gate_caps_tier is set by engine.china_sector_central._regime_anchor() when gate < 0.29
    // (the floor below which Accumulate is mathematically unreachable regardless of sector setup).
    var capHtml = '';
    if (M.gate_caps_tier && tone !== 'off') {
      capHtml = '<div class="rg-cap-notice"><span class="rg-cap-ic">⚠</span><span>' +
        L('Regime cap is active; sector calls are capped below <b>' + esc(M.gate_caps_tier) + '</b>.',
          '体制上限已启用；行业研判被压低至<b>' + esc(M.gate_caps_tier) + '</b>以下。') +
        '</span></div>';
    }

    // W0.4: staleness warning — render when a regime-leg input file is overdue.
    // any_stale and leg_stale are set by _regime_anchor() when a source parquet is too old.
    var staleHtml = '';
    if (M.any_stale) {
      var ls = M.leg_stale || {};
      var staleList = Object.keys(ls).filter(function(k){ return ls[k] != null && (
        (k==='credit' && ls[k]>60) || (k!=='credit' && ls[k]>7)); });
      var staleDesc = staleList.map(function(k){ return esc(k)+'('+ls[k]+'d)'; }).join(', ');
      staleHtml = '<div class="rg-stale-notice"><span class="rg-stale-ic">⛔</span><span>' +
        L('Stale regime input detected: ' + staleDesc + '. A frozen upstream collector may be silently pinning the gate. Check the collector logs.',
          '检测到陈旧体制输入：' + esc(staleDesc) + '。上游收集器可能已停止更新，导致门控被固定。请检查收集器日志。') +
        '</span></div>';
    }

    document.getElementById('regime').innerHTML = head + capHtml + staleHtml;
  }

  /* ---- embedded live sector desk (chinasectordata/desk.json) ---- */
  var DESK=null, _spid=0;
  function pcCell(v){ if(v==null) return '<span class="na">·</span>'; return '<span class="'+(v>=0?'up':'dn')+'">'+(v>=0?'+':'')+v.toFixed(2)+'%</span>'; }
  function deskSpark(arr){
    if(!arr||arr.length<2) return '';
    var w=120,h=30,pad=3,n=arr.length,mn=Math.min.apply(null,arr),mx=Math.max.apply(null,arr),rng=(mx-mn)||1,up=arr[n-1]>=arr[0];
    var X=function(i){return (i/(n-1))*(w-2*pad)+pad;}, Y=function(v){return h-pad-((v-mn)/rng)*(h-2*pad);};
    var pts=arr.map(function(v,i){return X(i).toFixed(1)+','+Y(v).toFixed(1);}).join(' ');
    var col=up?'#1FA971':'#e5484d'; if(lang()==='zh') col=up?'#e5484d':'#1FA971';
    var gid='dspk'+(_spid++);
    return '<svg width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" style="display:block">'+
      '<defs><linearGradient id="'+gid+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="'+col+'" stop-opacity="0.25"/><stop offset="1" stop-color="'+col+'" stop-opacity="0"/></linearGradient></defs>'+
      '<polygon points="'+pad+','+(h-pad)+' '+pts+' '+(w-pad)+','+(h-pad)+'" fill="url(#'+gid+')"/>'+
      '<polyline fill="none" stroke="'+col+'" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" points="'+pts+'"/></svg>';
  }
  function renderDesk(){
    if(!DESK) return;
    var sec=DESK.sectors||[];
    var head='<thead><tr>'+
      '<th data-c="0" data-t="s">'+L('Sector','行业')+'</th><th data-c="1" data-t="n">'+L('ETF','ETF')+'</th>'+
      '<th data-c="2" data-t="n">1D</th><th data-c="3" data-t="n">5D</th><th data-c="4" data-t="n">20D</th><th data-c="5" data-t="n">YTD</th>'+
      '<th data-c="6" data-t="n">'+L('RS 60d','相对强度')+'</th><th data-c="7" data-t="n">'+L('Cycle pos.','周期位置')+'</th>'+
      '<th data-c="8" data-t="s">'+L('State','状态')+'</th><th data-c="9" data-t="n">PE</th><th data-c="10" data-t="s">'+L('3y trend','3年走势')+'</th></tr></thead>';
    var rows=sec.map(function(s){
      var nm=lang()==='zh'&&s.name_zh?s.name_zh:s.name, p=s.position||{};
      var posCell = p.score!=null
        ? '<span class="scc-mbar"><i style="left:'+p.score+'%"></i></span> <span class="muted" style="font-size:10.5px">'+esc(lang()==='zh'?(p.label_zh||p.label):p.label)+'</span>'
        : '<span class="na">·</span>';
      var rs=(s.rs&&s.rs.mom_60d!=null)?pcCell(s.rs.mom_60d):'<span class="na">·</span>';
      var st=(s.cycle&&s.cycle.state)?'<span class="scc-cyc">'+zhv(s.cycle.state, STATEDESK_ZH)+'</span>':'<span class="na">·</span>';
      var pe=(s.valuation&&s.valuation.pe!=null)?s.valuation.pe:'·';
      var etf=(s.etf_last!=null)?s.etf_last.toFixed(3):'·';
      return '<tr><td><span class="nm"><a href="sector_cycles_china.html#'+esc(s.sw_code)+'" data-focus="'+esc(s.sw_code)+'">'+esc(nm)+'</a><small>'+esc(s.sw_code)+'</small></span></td>'+
        '<td>'+etf+'</td><td>'+pcCell(s.chg_1d)+'</td><td>'+pcCell(s.chg_5d)+'</td><td>'+pcCell(s.chg_20d)+'</td><td>'+pcCell(s.chg_ytd)+'</td>'+
        '<td>'+rs+'</td><td style="text-align:left">'+posCell+'</td><td style="text-align:left">'+st+'</td><td>'+pe+'</td><td>'+deskSpark(s.spark)+'</td></tr>';
    }).join('');
    var tbl=document.getElementById('sc-desk-tbl'); tbl.innerHTML=head+'<tbody>'+rows+'</tbody>';
    tbl.querySelectorAll('th').forEach(function(th){
      th.addEventListener('click',function(){
        var ci=+th.getAttribute('data-c'), isNum=th.getAttribute('data-t')==='n', tb=tbl.tBodies[0];
        var rws=Array.prototype.slice.call(tb.rows), asc=th._asc=!th._asc;
        rws.sort(function(a,b){
          var x=a.cells[ci].textContent.trim(), y=b.cells[ci].textContent.trim();
          if(isNum){ var nx=parseFloat(x.replace(/[^0-9.\-]/g,'')), ny=parseFloat(y.replace(/[^0-9.\-]/g,''));
            if(isNaN(nx))return 1; if(isNaN(ny))return -1; return asc?nx-ny:ny-nx; }
          return asc?x.localeCompare(y):y.localeCompare(x);
        });
        rws.forEach(function(r){tb.appendChild(r);});
      });
    });
    document.getElementById('sc-desk-key').innerHTML=
      L('Cycle position','周期位置')+': <span class="pk pk-lo"></span> '+L('beaten down (near lows)','超跌（接近低位）')+
      ' → <span class="pk pk-hi"></span> '+L('overheated (near highs)','过热（接近高位）')+' · '+L('green = doing well, red = doing poorly','绿=表现强，红=表现弱');
    var dt=document.getElementById('sc-desk-table');
    if(dt){ dt.hidden=false; dt.open = window.innerWidth>880; }   // open on desktop, collapsed on phones
  }
  function loadDesk(){
    if(!window.fetch) return;
    fetch('chinasectordata/desk.json').then(function(r){return r.ok?r.json():null;}).then(function(j){ if(j){ DESK=j; renderDesk(); } }).catch(function(){});
  }

  function focusDelegate(e){
    var a=e.target.closest('a[data-focus]'); if(!a) return;
    var id=a.getAttribute('data-focus');
    if(window.SectorCyclesFocus && window.SectorCyclesFocus(id)) e.preventDefault();
  }
  function boot(){
    regimeBanner(); loadDesk();
    // table name / "open cycle →" → focus the embedded cycle map in place when possible
    var deskTable=document.getElementById('sc-desk-table'); if(deskTable) deskTable.addEventListener('click', focusDelegate);
    document.addEventListener('langchange', function(){ regimeBanner(); renderDesk(); });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{# The cycle-map trio (data + mm_charts + sector_cycles) used to be injected right here on
