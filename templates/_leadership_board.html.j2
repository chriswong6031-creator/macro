{# ============================================================================
   THE BIG SEVEN — megacap price ledger (MLC-W1, rebuilt 2026-07-19)
   七巨头 — 大型科技股价格榜

   The redesign that replaced the lifecycle/generals/regime skeleton (10 sessions
   of trimming copy on a scaffold that kept contradicting the tape). This board
   shows the RAW MOVES only — each name's week and month price change, colored by
   sign, sorted strongest-week-first — and one cohort verdict that is a literal
   COUNT of the up rows, so nothing on the glance tier can disagree with itself.

   Consumes (all display-only; MLC-R2) — data/mag7_regime/latest.json via
   _leadership_board_view(): per-member r5/r10/r20/rs20/above50/above200/contrib10
   (+ earnings chip), plus the view's display arithmetic: up_count / n_total /
   stance_en|zh / sessions_stale / as_of_label_en|zh. NO scoring, NO lifecycle,
   NO "leader" labels — those stores drifted out of sync with price and are gone.

   Import and call:
       {% from "_leadership_board.html.j2" import leadership_board %}
       {% if leadership_board %}{{ leadership_board(leadership_board) }}{% endif %}

   Renders NOTHING when the payload is absent (fail-open; MLC-R2).
   All field access via .get() / truthiness guards — never `is not none` (Jinja gotcha).

   Design doctrine (DESIGN_DOCTRINE.md):
     Tier 1 glance: numbers carry their own meaning (green up / red down); title ≤4
       words; one stance; ONE as-of stamp; ONE footnote.
     Tier 2 hover:  per-row receipt (50d/200d, vs-market, 10d contribution, earnings)
       + panel ? help (the count→stance rule + "not a buy signal").
     No internal enums, no "leader" badges, no untranslated stats on Tier 1.
   ============================================================================ #}

{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}

{% macro tip(en, zh='') %}
 data-tip-en="{{ en | e }}" data-tip-zh="{{ (zh if zh else en) | e }}"
{%- endmacro %}

{# company display names (never raw tickers on Tier 1) #}
{% macro cname_en(sym) -%}
{%- if sym == 'AAPL' %}Apple{% elif sym == 'MSFT' %}Microsoft{% elif sym == 'NVDA' %}Nvidia
{%- elif sym == 'AMZN' %}Amazon{% elif sym == 'GOOGL' or sym == 'GOOG' %}Alphabet
{%- elif sym == 'META' %}Meta{% elif sym == 'TSLA' %}Tesla{% else %}{{ sym }}{% endif %}
{%- endmacro %}
{% macro cname_zh(sym) -%}
{%- if sym == 'AAPL' %}苹果{% elif sym == 'MSFT' %}微软{% elif sym == 'NVDA' %}英伟达
{%- elif sym == 'AMZN' %}亚马逊{% elif sym == 'GOOGL' or sym == 'GOOG' %}谷歌
{%- elif sym == 'META' %}Meta{% elif sym == 'TSLA' %}特斯拉{% else %}{{ sym }}{% endif %}
{%- endmacro %}

{# signed percent from a raw fraction (0.058 → "+5.8%"); null → "—" #}
{% macro pct(frac) -%}
{%- if frac is none %}—{%- else %}{%- set v = frac * 100 %}{{ '+' if v > 0 else '' }}{{ '%.1f'|format(v) }}%{%- endif %}
{%- endmacro %}

{# ══════════════════════════════════════════════════════════════════════════ #}
{% macro leadership_board(d) -%}
{%- if d and d.members %}
<style>
/* ── The Big Seven price ledger ─────────────────────────────────────────── */
.big7 { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px;
  padding: 14px 16px 12px; margin-bottom: 12px; }
.big7-top { display: flex; align-items: baseline; gap: 8px 12px; flex-wrap: wrap; }
.big7-title { font-size: 13px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
  color: var(--ink-1); margin: 0; }
.big7-verdict { font-size: 12.5px; font-weight: 700; color: var(--ink-1); }
.big7-verdict b { font-variant-numeric: tabular-nums; }
.big7-help { display: inline-flex; align-items: center; justify-content: center;
  width: 15px; height: 15px; border-radius: 50%; font-size: 10px; font-weight: 700;
  background: var(--panel3); color: var(--ink-3); cursor: help; flex-shrink: 0; }
.big7-sub { display: flex; align-items: baseline; gap: 8px 12px; flex-wrap: wrap;
  margin: 3px 0 10px; }
.big7-stance { font-size: 12px; font-weight: 700; }
.big7-stance.st-fav  { color: var(--up); }
.big7-stance.st-watch{ color: var(--warn); }
.big7-stance.st-aside{ color: var(--down); }
.big7-asof { font-size: 10.5px; color: var(--ink-3); margin-left: auto; white-space: nowrap; }
.big7-asof .big7-delayed { color: #d97706; font-weight: 700; }
/* rows */
.big7-rows { display: flex; flex-direction: column; gap: 2px; }
.big7-row { display: grid; grid-template-columns: 1fr auto auto; align-items: baseline;
  gap: 10px; padding: 5px 8px 5px 10px; border-radius: 6px; position: relative; }
.big7-row::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px;
  width: 3px; border-radius: 3px; }
.big7-row.up::before { background: var(--up); }
.big7-row.dn::before { background: var(--down); }
.big7-row:nth-child(odd) { background: color-mix(in srgb, var(--panel3) 45%, transparent); }
.big7-name { font-size: 12.5px; font-weight: 600; color: var(--ink-1); }
.big7-name .big7-tkr { font-size: 9px; font-weight: 700; letter-spacing: .05em;
  text-transform: uppercase; color: var(--ink-3); margin-left: 5px; }
.big7-move { font-variant-numeric: tabular-nums; font-family: var(--num, inherit); white-space: nowrap; }
.big7-wk { font-size: 12.5px; font-weight: 700; min-width: 116px; text-align: right; }
.big7-mo { font-size: 11px; font-weight: 600; min-width: 96px; text-align: right; }
.big7-move .u { color: var(--up); }
.big7-move .n { color: var(--down); }
.big7-move .z { color: var(--ink-3); }
.big7-move .lbl { font-size: 9px; font-weight: 600; letter-spacing: .03em;
  text-transform: uppercase; color: var(--ink-3); margin-left: 4px; }
.big7-arrow { font-size: 10px; margin-right: 3px; }
.big7-earn { display: inline-block; font-size: 9px; font-weight: 700; vertical-align: middle;
  background: color-mix(in srgb, var(--warn) 18%, transparent); color: var(--warn);
  border-radius: 3px; padding: 0 4px; margin-left: 6px; }
.big7-foot { font-size: 10px; color: var(--ink-3); margin-top: 9px; }
@media (max-width: 520px) {
  .big7-wk { min-width: 92px; } .big7-mo { min-width: 78px; }
  .big7-mo .lbl, .big7-wk .lbl { display: none; }
}
</style>

{%- set up = d.up_count if d.up_count is defined else 0 %}
{%- set nt = d.n_total if d.n_total else (d.members | length) %}
{%- set st_en = d.stance_en if d.stance_en else 'Watch — don\'t chase' %}
{%- set st_zh = d.stance_zh if d.stance_zh else '观望 — 勿追' %}
{%- set st_cls = 'st-fav' if up >= 5 else 'st-aside' if up <= 2 else 'st-watch' %}
{%- set stale = d.sessions_stale if d.sessions_stale is defined and d.sessions_stale else 0 %}

{# panel ? help — the definition + the disclosed count→stance rule + not-a-buy note #}
{%- set help_en = 'The seven biggest US tech names, each on its own. "Up this week" simply counts how many rose over the last five trading days — nothing scored, nothing predicted. Stance follows the count: 5+ up = In favour · 3–4 = Watch, don\'t chase · 2 or fewer = Stand aside. These are price moves, a heads-up — the Buy lanes below still decide entries. Hover any name for its 50-day / 200-day trend, move vs the market, and next earnings.' -%}
{%- set help_zh = '美股七大科技股，逐一展示。「本周上涨」仅统计近五个交易日上涨的只数——不评分、不预测。立场随只数而定：≥5 上涨 = 有利 · 3–4 = 观望，勿追 · ≤2 = 观望为主。此为价格涨跌，仅供参考——入场时机仍由下方买入通道决定。悬停名称查看其50日/200日趋势、相对大盘表现及下次财报。' -%}

<div class="span12 big7">

  {# ── ROW 1: title · arithmetic verdict · ? ──────────────────────────────── #}
  <div class="big7-top">
    <h2 class="big7-title">{{ t('The Big Seven', '七巨头') }}</h2>
    <span class="big7-verdict">
      <span class="l-en"><b>{{ up }} of {{ nt }}</b> up this week</span>
      <span class="l-zh">本周 <b>{{ up }}/{{ nt }}</b> 上涨</span>
    </span>
    <span class="big7-help"{{ tip(help_en, help_zh) }}>?</span>
  </div>

  {# ── ROW 2: stance (from the count) · one honest close-date stamp ────────── #}
  <div class="big7-sub">
    <span class="big7-stance {{ st_cls }}">
      <span class="l-en">{{ st_en }}</span>
      <span class="l-zh">{{ st_zh }}</span>
    </span>
    {%- if d.as_of_label_en %}
    <span class="big7-asof">
      <span class="l-en">Prices to {{ d.as_of_label_en }}{% if stale %} · <span class="big7-delayed">{{ stale }} session{{ 's' if stale != 1 else '' }} behind</span>{% endif %}</span>
      <span class="l-zh">收盘价截至 {{ d.as_of_label_zh }}{% if stale %} · <span class="big7-delayed">滞后{{ stale }}个交易日</span>{% endif %}</span>
    </span>
    {%- endif %}
  </div>

  {# ── ROW 3: seven price rows, sorted strongest-week-first by the view ────── #}
  <div class="big7-rows">
    {%- for m in d.members %}
    {%- set sym = m.sym if m.sym else '' %}
    {%- set r5  = m.r5  if m.r5  is defined and m.r5  != none else none %}
    {%- set r20 = m.r20 if m.r20 is defined and m.r20 != none else none %}
    {%- set rs20 = m.rs20 if m.rs20 is defined and m.rs20 != none else none %}
    {%- set a50 = m.above50  if m.above50  is defined else none %}
    {%- set a200 = m.above200 if m.above200 is defined else none %}
    {%- set contrib = m.contrib10 if m.contrib10 is defined and m.contrib10 != none else none %}
    {%- set earn = m.earnings if m.earnings else none %}
    {%- set wk_up = (r5 is not none and r5 > 0) %}
    {%- set wk_cls = 'u' if (r5 is not none and r5 > 0) else 'n' if (r5 is not none and r5 < 0) else 'z' %}
    {%- set mo_cls = 'u' if (r20 is not none and r20 > 0) else 'n' if (r20 is not none and r20 < 0) else 'z' %}
    {%- set arrow  = '▲' if wk_up else '▼' if (r5 is not none and r5 < 0) else '·' %}
    {# per-row hover receipt (Tier 2): structure + vs-market + 10d contribution (plain number, no "leader" badge) + earnings #}
    {%- set tip_en %}{{ cname_en(sym) }} · week {{ pct(r5) }} · month {{ pct(r20) }} · {{ 'above' if a50 else 'below' if a50 is not none and a50 == false else '—' }} 50-day line · {{ 'above' if a200 else 'below' if a200 is not none and a200 == false else '—' }} 200-day line · vs market (1m) {{ pct(rs20) }}{% if contrib is not none %} · 10-day share of the group move {{ (contrib * 100) | round | int }}%{% endif %}{% if earn and earn.get('days_until') is not none and earn.get('days_until') <= 14 %} · reports in {{ earn.days_until }}d{% endif %}{%- endset %}
    {%- set tip_zh %}{{ cname_zh(sym) }} · 周 {{ pct(r5) }} · 月 {{ pct(r20) }} · 50日均线{{ '上方' if a50 else '下方' if a50 is not none and a50 == false else '—' }} · 200日均线{{ '上方' if a200 else '下方' if a200 is not none and a200 == false else '—' }} · 相对大盘(月) {{ pct(rs20) }}{% if contrib is not none %} · 近10日组合贡献 {{ (contrib * 100) | round | int }}%{% endif %}{% if earn and earn.get('days_until') is not none and earn.get('days_until') <= 14 %} · {{ earn.days_until }}日后财报{% endif %}{%- endset %}
    <div class="big7-row {{ 'up' if wk_up else 'dn' }}"{{ tip(tip_en, tip_zh) }}>
      <span class="big7-name">
        <span class="l-en">{{ cname_en(sym) }}</span><span class="l-zh">{{ cname_zh(sym) }}</span><span class="big7-tkr">{{ sym }}</span>
        {%- if earn and earn.get('days_until') is not none and earn.get('days_until') <= 14 %}
        <span class="big7-earn">{{ t('reports ' ~ earn.days_until ~ 'd', earn.days_until ~ '日财报') }}</span>
        {%- endif %}
      </span>
      <span class="big7-move big7-wk"><span class="big7-arrow {{ wk_cls }}">{{ arrow }}</span><span class="{{ wk_cls }}">{{ pct(r5) }}</span><span class="lbl">{{ t('wk', '周') }}</span></span>
      <span class="big7-move big7-mo"><span class="{{ mo_cls }}">{{ pct(r20) }}</span><span class="lbl">{{ t('mo', '月') }}</span></span>
    </div>
    {%- endfor %}
  </div>

  {# ── ONE footnote ───────────────────────────────────────────────────────── #}
  <div class="big7-foot">
    {{ t('Plain price moves over the last week and month — hover a name for detail. Not a buy signal; the lanes below decide entries.',
          '「周」「月」为区间价格涨跌，悬停名称查看详情。非买入信号；入场由下方通道决定。') }}
  </div>

</div>
{%- endif %}
{%- endmacro %}
