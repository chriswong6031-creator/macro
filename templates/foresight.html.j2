    <div class="fx-ai">
      <div class="fx-ai-h">🧠 {{ t('AI analyst read', 'AI 分析师解读') }}{% if monitor and (monitor.n_broken or monitor.n_weakening) %} <span class="fx-ai-mon">{% if monitor.n_broken %}{{ monitor.n_broken }} {{ t('thesis broken', '论点失效') }}{% endif %}{% if monitor.n_weakening %}{% if monitor.n_broken %} · {% endif %}{{ monitor.n_weakening }} {{ t('weakening', '走弱') }}{% endif %}</span>{% endif %}</div>
