{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro chip(label_en, label_zh='', cls='') -%}
<span class="chip {{ cls }}"><span class="l-en">{{ label_en }}</span><span class="l-zh">{{ label_zh if label_zh else label_en }}</span></span>
{%- endmacro %}
{% macro tip(en, zh='') -%}
<span class="tip-wrap" data-tip-en="{{ en }}" data-tip-zh="{{ zh if zh else en }}">[?]<span class="tip-pop"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dark Pool Desk - off-exchange and short volume</title>
{% set seo_title = "Dark Pool Desk — Mastermind" %}{% set seo_desc = "Off-exchange and short-volume tracking — where dark pool activity concentrates and what it says about real positioning. Updated nightly." %}{% set seo_path = "darkpool.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:0; overflow-x:hidden; }
  .site-nav { width:min(1500px,calc(100% - 36px)); margin-top:18px; }
  .dp-shell { width:min(1400px,calc(100% - 36px)); margin:0 auto 22px; }
  .whb { max-width:100%; overflow:hidden; }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; font-weight:700; margin:0; }
  h2 { font-size:13px; margin:0 0 4px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; font-weight:600; }
  .muted { color:var(--muted); }
  .sm { font-size:12px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; min-width:0; overflow-wrap:break-word; }
  .toprow { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:14px; }
  .chip { display:inline-flex; align-items:center; font-size:11.5px; padding:2px 9px; border-radius:20px; border:1px solid var(--line); background:var(--panel2); color:var(--muted); white-space:normal; max-width:100%; }
  .chip.warn { background:rgba(255,190,0,.10); border-color:rgba(255,190,0,.35); color:#b8860b; }
  .chip.lag { background:rgba(120,130,180,.10); border-color:rgba(120,130,180,.30); color:var(--muted); }
  .chip.ok { background:rgba(35,134,54,.10); border-color:rgba(35,134,54,.30); color:var(--up); }
  .chip.up { background:rgba(35,134,54,.12); border-color:rgba(35,134,54,.35); color:var(--up); }
  .chip.dn { background:rgba(220,50,50,.10); border-color:rgba(220,50,50,.30); color:var(--down); }
  .chip.new-venue { background:rgba(100,120,200,.12); border-color:rgba(100,120,200,.30); color:var(--muted); }
  .chip.preset { cursor:pointer; user-select:none; }
  .chip.preset:hover { background:var(--panel2); border-color:var(--text); color:var(--text); }
  .chip.preset.active { background:var(--accent,#2563eb); border-color:transparent; color:#fff; }
  .honest-box { background:rgba(255,190,0,.07); border:1px solid rgba(255,190,0,.25); border-radius:8px; padding:10px 14px; margin-bottom:14px; font-size:12.5px; line-height:1.6; color:var(--muted); overflow-wrap:break-word; }
  .honest-box strong { color:var(--text); }
  /* Table */
  .tbl-wrap { overflow-x:auto; margin-top:8px; max-width:100%; -webkit-overflow-scrolling:touch; }
  table.dp-tbl { border-collapse:collapse; width:100%; font-size:12.5px; }
  table.dp-tbl th { color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.04em; padding:6px 8px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; cursor:pointer; user-select:none; }
  table.dp-tbl th:first-child { text-align:left; }
  table.dp-tbl th.sort-asc::after { content:' ▲'; font-size:9px; }
  table.dp-tbl th.sort-desc::after { content:' ▼'; font-size:9px; }
  table.dp-tbl td { padding:5px 8px; border-bottom:1px solid var(--line); text-align:right; font-variant-numeric:tabular-nums; }
  table.dp-tbl td:first-child { text-align:left; font-weight:600; }
  table.dp-tbl tr:hover td { background:var(--panel2); }
  .num-pos { color:var(--up); }
  .num-neg { color:var(--down); }
  .num-neu { color:var(--muted); }
  /* Norm chip inside td */
  .norm-chip { display:inline-block; font-size:10.5px; padding:1px 7px; border-radius:12px; white-space:nowrap; }
  .norm-hi2  { background:rgba(220,50,50,.14); color:var(--down); }
  .norm-hi1  { background:rgba(220,50,50,.07); color:var(--down); }
  .norm-mid  { background:var(--panel2); color:var(--muted); }
  .norm-lo1  { background:rgba(35,134,54,.07); color:var(--up); }
  .norm-lo2  { background:rgba(35,134,54,.14); color:var(--up); }
  /* Sparkline */
  .spark-cell { min-width:90px; }
  svg.spark { display:block; overflow:visible; }
  /* ATS venue table */
  .venue-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:10px; margin-top:10px; }
  .venue-card { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; min-width:0; overflow-wrap:break-word; }
  .venue-card .vname { font-size:12.5px; font-weight:600; margin-bottom:2px; }
  .venue-card .vmpid { font-size:11px; color:var(--muted); margin-bottom:4px; }
  .venue-card .vstat { display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; font-size:11.5px; margin-bottom:4px; }
  .venue-card .vstat .lbl { color:var(--muted); }
  .venue-card .vchips { display:flex; flex-wrap:wrap; gap:5px; margin-top:4px; }
  /* Filters row */
  .filters-row { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:10px; }
  .dp-input { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:5px 10px; font-size:13px; color:var(--text); outline:none; }
  .dp-input::placeholder { color:var(--muted); }
  .dp-select { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:5px 8px; font-size:12px; color:var(--text); outline:none; }
  #dp-search { max-width:200px; }
  #dp-min-share { max-width:90px; }
  .clear-btn { font-size:12px; color:var(--muted); cursor:pointer; padding:4px 8px; border:1px solid var(--line); border-radius:8px; background:none; }
  .clear-btn:hover { border-color:var(--text); color:var(--text); }
  .export-btn { font-size:12px; color:var(--muted); cursor:pointer; padding:4px 8px; border:1px solid var(--line); border-radius:8px; background:none; margin-left:auto; }
  .export-btn:hover { border-color:var(--text); color:var(--text); }
  .row-count { font-size:11.5px; color:var(--muted); }
  .presets-row { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
  /* tip popover */
  .tip-wrap { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:9px; font-weight:700; cursor:help; position:relative; vertical-align:middle; margin-left:3px; }
  .tip-pop { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:min(260px,calc(100vw - 32px)); background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 12px; z-index:80; font-size:12px; line-height:1.5; color:var(--text); box-shadow:0 4px 16px rgba(0,0,0,.18); pointer-events:none; white-space:normal; overflow-wrap:break-word; }
  .tip-wrap:hover .tip-pop { display:block; }
  /* sc-hide responsive */
  @media (max-width:900px) { .sc-hide { display:none; } }
  @media (max-width:640px) {
    .site-nav,.dp-shell { width:min(1500px,calc(100% - 24px)); }
    .site-nav { margin-top:12px; }
    .panel { padding:12px; border-radius:8px; }
    .toprow { align-items:flex-start; }
    .sc-hide-sm { display:none; }
    table.dp-tbl { font-size:12px; }
    table.dp-tbl td,table.dp-tbl th { padding:5px 6px; }
    #dp-search { max-width:none; }
  }
  @media (max-width:480px) { .sc-hide-xs { display:none; } }
</style>
</head>
<body>
{% set nav_search_placeholder_en = 'Search any stock - US, China, HK, Canada and more...' %}
{% set nav_search_placeholder_zh = '搜索任意股票 - 美股、A股、港股、加股等...' %}
{% include "_site_nav.html.j2" ignore missing %}

<main class="dp-shell">
<div class="toprow">
  <h1>{{ t('Dark Pool Desk', '场外暗池台') }}</h1>
  {{ chip('EOD · display-only', 'EOD · 仅供展示') }}
{% if below_floor %}
  {{ chip('⚠ thin history (' ~ panel_dates ~ ' dates)', '⚠ 历史数据不足（' ~ panel_dates ~ ' 天）', 'warn') }}
{% else %}
  {{ chip(panel_dates|string ~ ' dates available', panel_dates|string ~ ' 个交易日数据', 'ok') }}
{% endif %}
  <span class="muted sm">{{ t('as of', '数据截至') }} {{ panel_latest }} · {{ t('built', '构建于') }} {{ built }}</span>
</div>

<div class="honest-box">
  <strong>{{ t('Data provenance', '数据来源说明') }}</strong> ·
  {{ t('T1e: FINRA CNMSshvol — off-exchange (FINRA-facility) volume and short-sale volume reported by FINRA member firms. This is NOT live trading data and NOT direct dark-pool print data. "Short ratio" = short-sale volume ÷ FINRA-facility total volume. "Off-exchange share" = FINRA-facility volume ÷ yahoo consolidated day volume (exact-date match; labeled per row). T2e: FINRA OTC Transparency weekly per-ATS venue data — 2–4 week publication lag; not a real-time feed.',
     'T1e：FINRA CNMSshvol — FINRA成员机构上报的场外（FINRA设施）成交量与卖空成交量。本数据非实时交易数据，亦非直接的暗池成交记录。"融券比率"=卖空成交量÷FINRA设施总成交量。"场外占比"=FINRA设施成交量÷雅虎综合日成交量（精确日期匹配；各行标注分母来源）。T2e：FINRA场外透明度每周各ATS场所数据——公布滞后2–4周，非实时数据。') }}
</div>

{# JSON data payload — consumed by client-side table renderer #}
<script id="dp-data" type="application/json">{{ table_json | safe }}</script>

{# ═══════════════════════════════════════════════ Per-name table ═════════════ #}
<div class="panel">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
    <h2>{{ t('Off-Exchange Volume — Per Name', '场外成交量 — 各个股') }}</h2>
    <span class="muted sm">{{ display_universe_size }} {{ t('names', '个股') }} · {{ n_with_oe }} {{ t('with OE share', '有场外占比') }} · {{ n_with_ats }} {{ t('with ATS match', '有ATS匹配') }}</span>
  </div>

  {# Preset chips #}
  <div class="presets-row">
    <span class="chip preset" data-preset="heavy-oe"
      data-en="Off-exchange heavy" data-zh="场外占比高">
      <span class="l-en">Off-exchange heavy</span><span class="l-zh">场外占比高</span>
    </span>
    <span class="chip preset" data-preset="rising-oe"
      data-en="Rising off-ex" data-zh="场外占比上升">
      <span class="l-en">Rising off-ex</span><span class="l-zh">场外占比上升</span>
    </span>
    <span class="chip preset" data-preset="short-spike"
      data-en="Short-volume spike" data-zh="融券成交激增">
      <span class="l-en">Short-volume spike</span><span class="l-zh">融券成交激增</span>
    </span>
    <span class="chip preset" data-preset="fading-oe"
      data-en="Fading off-ex" data-zh="场外占比下降">
      <span class="l-en">Fading off-ex</span><span class="l-zh">场外占比下降</span>
    </span>
  </div>

  {# Filters row #}
  <div class="filters-row">
    <input id="dp-search" class="dp-input" type="text"
      placeholder="Filter ticker…"
      data-ph-en="Filter ticker…" data-ph-zh="筛选代码…"
      autocomplete="off">
    <input id="dp-min-share" class="dp-input" type="number" min="0" max="100" step="1"
      placeholder="Min OE %"
      data-ph-en="Min OE %" data-ph-zh="最低场外占比%"
      autocomplete="off">
    <select id="dp-trend" class="dp-select">
      <option value="all" data-en="All trends" data-zh="全部趋势">All trends</option>
      <option value="rising" data-en="Rising (≥+1pp)" data-zh="上升（≥+1pp）">Rising (≥+1pp)</option>
      <option value="falling" data-en="Falling (≤−1pp)" data-zh="下降（≤−1pp）">Falling (≤−1pp)</option>
    </select>
    <select id="dp-norm" class="dp-select">
      <option value="all" data-en="All vs norm" data-zh="全部vs基准">All vs norm</option>
      <option value="above" data-en="Above norm (z≥1)" data-zh="高于基准（z≥1）">Above norm (z≥1)</option>
      <option value="below" data-en="Below norm (z≤−1)" data-zh="低于基准（z≤−1）">Below norm (z≤−1)</option>
    </select>
    <button class="clear-btn" id="dp-clear">{{ t('Clear', '清除') }}</button>
    <button class="export-btn" id="dp-export">{{ t('Export CSV', '导出CSV') }}</button>
  </div>
  <div id="dp-row-count" class="row-count" style="margin-bottom:6px;"></div>

  <div class="tbl-wrap">
    <table class="dp-tbl" id="dp-table">
      <thead>
        <tr>
          <th data-col="ticker" data-type="str">{{ t('Ticker','代码') }}</th>
          <th data-col="asof" data-type="str" class="sc-hide-sm">{{ t('Date','日期') }}</th>
          <th data-col="oe_share" data-type="num">{{ t('Off-Ex Share','场外占比') }}
            {{ tip('FINRA-facility total volume ÷ yahoo consolidated day volume (exact date match). Measures what fraction of this name\'s daily volume was routed through FINRA off-exchange facilities.','FINRA设施总成交量÷雅虎综合日成交量（精确日期匹配）。衡量该股当日成交量中路由至FINRA场外设施的比例。') }}
          </th>
          <th data-col="spark" data-type="none" class="spark-cell sc-hide">{{ t('20d trend','20日走势') }}</th>
          <th data-col="oe_trend_pp" data-type="num">{{ t('OE trend pp','场外趋势pp') }}
            {{ tip('5-day mean OE share minus 40-day mean OE share, in percentage points. Positive = off-exchange share has been rising recently vs its own longer-term level.','近5日平均场外占比减去40日平均场外占比，单位百分点。正值=场外占比近期相对自身较长期水平上升。') }}
          </th>
          <th data-col="oe_z" data-type="num">{{ t('vs norm','对比基准') }}
            {{ tip('Today\'s off-exchange share z-scored against own history (≥20 obs). "Well above norm" ≥2σ; "above" ≥1σ; "normal" −1..1σ; "below" ≤−1σ; "well below" ≤−2σ. Exact z shown in this tip when available.','当日场外占比相对自身历史（≥20个观测值）的Z值。"远高基准"≥2σ；"高于基准"≥1σ；"正常"−1..1σ；"低于基准"≤−1σ；"远低基准"≤−2σ。') }}
          </th>
          <th data-col="short_ratio" data-type="num">{{ t('Short Ratio','融券比率') }}
            {{ tip('Short-sale volume ÷ FINRA-facility total volume for this session. NOT the NYSE/Nasdaq consolidated tape ratio.','卖空成交量÷当日FINRA设施总成交量，非NYSE/纳斯达克综合报价带比率。') }}
          </th>
          <th data-col="trend_pp" data-type="num" class="sc-hide-sm">{{ t('SR trend pp','融券趋势pp') }}
            {{ tip('Recent 5d volume-weighted short ratio minus 40d baseline, in pp.','近5日量加权融券比率减去40日基准，单位百分点。') }}
          </th>
          <th data-col="ats_top_venue" data-type="str" class="sc-hide">{{ t('ATS top venue','ATS主场所') }}
            {{ tip('Top ATS venue by share count for latest published week (2–4 wk lag). Source: FINRA OTC Transparency.','最新公布周（滞后2–4周）按成交量排名第一的ATS场所。来源：FINRA场外透明度。') }}
          </th>
          <th data-col="finra_total_vol" data-type="num" class="sc-hide-xs">{{ t('FINRA vol','FINRA量') }}</th>
          <th data-col="n_days" data-type="num" class="sc-hide">{{ t('Days','天数') }}</th>
        </tr>
      </thead>
      <tbody id="dp-tbody"></tbody>
    </table>
  </div>
  <p class="muted sm" style="margin-top:6px;">
    {{ t('Off-exchange share denominator: Yahoo Finance consolidated day volume (exact date match, T+0).', '场外占比分母：雅虎财经综合日成交量（精确日期匹配，T+0）。') }}
  </p>
</div>

{# ═══════════════════════════════════════════ ATS Venue table ════════════════ #}
<div class="panel">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
    <h2>{{ t('Weekly ATS Venue Breakdown', '每周ATS场所分项') }}</h2>
    {% if ats_lag_note %}
    {{ chip('⏱ ' ~ ats_lag_note, '⏱ ' ~ ats_lag_note, 'lag') }}
    {% endif %}
    {% if ats_table and ats_table.week_start %}
    <span class="muted sm">{{ t('week of', '报告周：') }} {{ ats_table.week_start }}</span>
    {% endif %}
  </div>
  {% if ats_table and ats_table.venues %}
  <p class="muted sm" style="margin-bottom:10px;">
    {{ t('Source: FINRA OTC Transparency API (keyless). Aggregate weekly shares and trades per registered ATS for', '来源：FINRA场外透明度API（无需密钥）。每个注册ATS场所的每周累计成交量与交易笔数，涵盖') }}
    {{ ats_table.n_symbols_total }} {{ t('symbols. NOT "live" — 2–4 week publication lag from reporting week end.', '个标的。非实时数据——距报告周结束有2–4周公布滞后。') }}
  </p>
  <div class="venue-grid">
    {% for v in ats_table.venues %}
    <div class="venue-card">
      <div class="vname">{{ v.venue_name if v.venue_name else v.mpid }}</div>
      <div class="vmpid">{{ t('MPID:', 'MPID：') }} {{ v.mpid }}</div>
      <div class="vstat">
        <span><span class="lbl">{{ t('Shares', '成交量') }}</span> {{ "{:,.0f}".format(v.total_shares) }}</span>
        <span><span class="lbl">{{ t('Trades', '笔数') }}</span> {{ "{:,}".format(v.total_trades) }}</span>
        <span><span class="lbl">{{ t('Symbols', '标的') }}</span> {{ v.n_symbols }}</span>
      </div>
      <div class="vchips">
        {% if v.share_of_total_pct is not none %}
        <span class="chip" style="font-size:11px;">{{ "%.1f"|format(v.share_of_total_pct) }}% {{ t('of total','总占比') }}</span>
        {% endif %}
        {% if v.wow_is_new %}
        <span class="chip new-venue" style="font-size:11px;">{{ t('new','新增') }}</span>
        {% elif v.wow_pp is not none %}
          {% if v.wow_pp > 0 %}
          <span class="chip up" style="font-size:11px;">▲ +{{ "%.2f"|format(v.wow_pp) }}pp {{ t('vs prior wk','对比前周') }}</span>
          {% elif v.wow_pp < 0 %}
          <span class="chip dn" style="font-size:11px;">▼ {{ "%.2f"|format(v.wow_pp) }}pp {{ t('vs prior wk','对比前周') }}</span>
          {% else %}
          <span class="chip" style="font-size:11px;">0.00pp {{ t('vs prior wk','对比前周') }}</span>
          {% endif %}
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="muted">
    {{ t('No ATS venue data available yet. Run the collector to fetch the latest published week:', '暂无ATS场所数据。请运行采集器获取最新公布周数据：') }}
    <code>python -m collectors.finra_ats_transparency</code>
  </p>
  {% endif %}
</div>

{# ═══════════════════════════════════════════ Methodology box ════════════════ #}
<div class="panel">
  <h2>{{ t('Methodology & Limitations', '方法论与局限性') }}</h2>
  <div style="font-size:13px; line-height:1.7; color:var(--muted); max-width:820px;">
    <p>
      <strong class="l-en">T1e — Off-exchange (FINRA-facility) volume:</strong>
      <strong class="l-zh">T1e — 场外（FINRA设施）成交量：</strong>
      <span class="l-en">FINRA publishes daily consolidated short-volume (CNMSshvol) files reporting each member firm's short-sale and total volume routed through FINRA-regulated facilities (e.g. FINRA's Alternative Display Facility, broker internalization). These are NOT equivalent to NYSE/Nasdaq consolidated tape volumes.</span>
      <span class="l-zh">FINRA每日发布综合融券成交量（CNMSshvol）文件，记录各成员机构通过FINRA监管设施（如FINRA另类显示设施、券商内部化）路由的卖空及总成交量。此数据与NYSE/纳斯达克综合报价带成交量并不等同。</span>
    </p>
    <p>
      <strong class="l-en">Short ratio and short-ratio trend:</strong>
      <strong class="l-zh">融券比率与融券趋势：</strong>
      <span class="l-en">Short ratio = short-sale volume ÷ FINRA-facility total volume for the session. Trend (pp) = recent 5-day volume-weighted ratio minus 40-day baseline, in percentage points. Used here as a positioning context confirmer, not a scored alpha factor.</span>
      <span class="l-zh">融券比率=当日卖空成交量÷FINRA设施总成交量。趋势（pp）=近5日量加权比率减去40日基准，单位百分点。本台仅作为仓位情境印证，非评分型阿尔法因子。</span>
    </p>
    <p>
      <strong class="l-en">Off-exchange share, trend, and vs-norm columns:</strong>
      <strong class="l-zh">场外占比、趋势与对比基准列：</strong>
      <span class="l-en">OE share = FINRA-facility total volume ÷ yahoo consolidated day volume (exact calendar-date inner join; rows where yahoo volume is missing are shown as "—"). OE trend (pp) = mean of last 5 days minus mean of last 40 days; positive means the fraction has been running higher lately. "Vs norm" is the today's OE share z-scored against the ticker's own full available history (requires ≥20 matched trading days): "well above norm" ≥2σ; "above norm" ≥1σ; "normal" −1..1σ; "below norm" ≤−1σ; "well below norm" ≤−2σ. The sparkline shows the last 20 days of OE share.</span>
      <span class="l-zh">场外占比=FINRA设施总成交量÷雅虎综合日成交量（精确日历日期内连接；雅虎成交量缺失的行显示"—"）。场外趋势（pp）=近5日均值减去近40日均值；正值表示近期该比例偏高。"对比基准"为当日场外占比相对该股自身全部可用历史的Z值（需≥20个匹配交易日）："远高基准"≥2σ；"高于基准"≥1σ；"正常"−1..1σ；"低于基准"≤−1σ；"远低基准"≤−2σ。迷你图显示最近20日的场外占比。</span>
    </p>
    <p>
      <strong class="l-en">Off-exchange share denominator:</strong>
      <strong class="l-zh">场外占比分母：</strong>
      <span class="l-en">Consolidated day volume sourced from Yahoo Finance EOD data. This is the best available free denominator for the display universe; Yahoo volumes can lag intraday rounding vs official tape totals.</span>
      <span class="l-zh">综合日成交量来源于雅虎财经EOD数据。这是展示范围内最优质的免费分母数据；雅虎成交量与官方报价带汇总数据可能存在日内舍入差异。</span>
    </p>
    <p>
      <strong class="l-en">T2e — FINRA OTC Transparency (weekly ATS) and ATS columns:</strong>
      <strong class="l-zh">T2e — FINRA场外透明度（每周ATS）与ATS列：</strong>
      <span class="l-en">FINRA's OTC Transparency programme mandates weekly reporting from all registered ATS; data is published 2–4 weeks after the reporting week via the FINRA API (keyless). The "ATS top venue" column shows the venue with the most shares for that ticker in the latest published week. "ATS share %" = ATS shares ÷ yahoo volume for that Mon–Fri window × 100; null when yahoo doesn't cover that week. Venue cards show each ATS's share of that week's total ATS volume, plus week-over-week change in percentage points.</span>
      <span class="l-zh">FINRA场外透明度计划要求所有注册ATS每周上报，经由FINRA API（无需密钥）在报告周后2–4周公布。"ATS主场所"列显示该股最新公布周成交量最大的ATS场所。"ATS占比%"=ATS成交量÷该周（周一至周五）雅虎成交量×100；雅虎数据不覆盖该周时显示空值。场所卡片显示各ATS占该周ATS总成交量的比例及周环比变化（百分点）。</span>
    </p>
    <p class="sm">
      <span class="l-en">Display universe: ~{{ display_universe_size }} names (options universe gex_symbols). Full ~8-year backfill restricted to this universe to satisfy the 30 MB git-tracked-file ceiling. As of {{ panel_latest }}: {{ n_with_oe }} names have OE share data, {{ n_with_ats }} have an ATS match for the latest published week.</span>
      <span class="l-zh">展示范围：约{{ display_universe_size }}个标的（期权范围gex_symbols）。完整~8年回填数据受限于此范围，以满足30MB git追踪文件上限。截至{{ panel_latest }}：{{ n_with_oe }}个标的有场外占比数据，{{ n_with_ats }}个标的有最新公布周ATS匹配数据。</span>
    </p>
  </div>
</div>

<script>
(function() {
  'use strict';

  // ── Placeholder i18n (data-ph-en / data-ph-zh + langchange) ──────────────
  function updatePlaceholders() {
    var lang = document.documentElement.getAttribute('data-lang') || 'en';
    document.querySelectorAll('[data-ph-en]').forEach(function(el) {
      el.placeholder = lang === 'zh'
        ? (el.getAttribute('data-ph-zh') || el.getAttribute('data-ph-en'))
        : el.getAttribute('data-ph-en');
    });
    // Select option labels
    document.querySelectorAll('.dp-select option[data-en]').forEach(function(opt) {
      opt.textContent = lang === 'zh'
        ? (opt.getAttribute('data-zh') || opt.getAttribute('data-en'))
        : opt.getAttribute('data-en');
    });
  }
  document.addEventListener('langchange', updatePlaceholders);
  updatePlaceholders();

  // ── Data ─────────────────────────────────────────────────────────────────
  var rawEl = document.getElementById('dp-data');
  var allRows = [];
  try { allRows = JSON.parse(rawEl ? rawEl.textContent : '[]'); } catch(e) {}

  // ── State ─────────────────────────────────────────────────────────────────
  var sortCol = 'oe_share';
  var sortDir = -1; // -1 = desc
  var activePreset = null;
  var hiddenRatioZ  = null; // set by short-spike preset

  // ── Norm chip helper ──────────────────────────────────────────────────────
  function normChip(z) {
    var lang = document.documentElement.getAttribute('data-lang') || 'en';
    if (z === null || z === undefined) return '<span class="norm-chip norm-mid muted">—</span>';
    var label, cls;
    if (z >= 2)       { label = lang === 'zh' ? '远高基准' : 'well above norm'; cls = 'norm-hi2'; }
    else if (z >= 1)  { label = lang === 'zh' ? '高于基准' : 'above norm';      cls = 'norm-hi1'; }
    else if (z <= -2) { label = lang === 'zh' ? '远低基准' : 'well below';      cls = 'norm-lo2'; }
    else if (z <= -1) { label = lang === 'zh' ? '低于基准' : 'below norm';      cls = 'norm-lo1'; }
    else              { label = lang === 'zh' ? '正常'     : 'normal';           cls = 'norm-mid'; }
    return '<span class="norm-chip ' + cls + '" title="z=' + z.toFixed(2) + '">' + label + '</span>';
  }

  // ── Sparkline helper ──────────────────────────────────────────────────────
  function sparkSVG(arr) {
    if (!arr || arr.length < 2) return '';
    var mn = Math.min.apply(null, arr), mx = Math.max.apply(null, arr);
    var range = mx - mn || 0.001;
    var W = 90, H = 22, pad = 2;
    var pts = arr.map(function(v, i) {
      var x = pad + (i / (arr.length - 1)) * (W - 2 * pad);
      var y = H - pad - ((v - mn) / range) * (H - 2 * pad);
      return x.toFixed(1) + ',' + y.toFixed(1);
    });
    var last = pts[pts.length - 1].split(',');
    return '<svg class="spark" width="' + W + '" height="' + H + '" viewBox="0 0 ' + W + ' ' + H + '">' +
      '<polyline points="' + pts.join(' ') + '" fill="none" stroke="currentColor" stroke-opacity=".45" stroke-width="1.3"/>' +
      '<circle cx="' + last[0] + '" cy="' + last[1] + '" r="2.2" fill="currentColor" fill-opacity=".7"/>' +
      '</svg>';
  }

  // ── Trend color class ─────────────────────────────────────────────────────
  function trendCls(v) {
    if (v === null || v === undefined) return 'num-neu';
    return v > 0 ? 'num-pos' : (v < 0 ? 'num-neg' : 'num-neu');
  }
  function srTrendCls(v) {
    // Rising short ratio = mildly negative sentiment signal → color red
    if (v === null || v === undefined) return 'num-neu';
    return v > 0 ? 'num-neg' : (v < 0 ? 'num-pos' : 'num-neu');
  }

  // ── Format helpers ─────────────────────────────────────────────────────────
  function fmtPct(v, dec) { return v === null || v === undefined ? '—' : (v * 100).toFixed(dec === undefined ? 1 : dec) + '%'; }
  function fmtPP(v)  { return v === null || v === undefined ? '—' : (v > 0 ? '+' : '') + v.toFixed(2); }
  function fmtM(v)   { return v === null || v === undefined ? '—' : (v / 1e6).toFixed(1) + 'M'; }
  // venue names are external FINRA strings — escape anything that goes through innerHTML
  function esc(s) { return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

  // ── Row renderer ──────────────────────────────────────────────────────────
  function renderRow(r) {
    var tc = trendCls(r.oe_trend_pp);
    var sc = srTrendCls(r.trend_pp);
    return '<tr>' +
      '<td>' + esc(r.ticker) + '</td>' +
      '<td class="muted sc-hide-sm">' + esc(r.asof || '') + '</td>' +
      '<td>' + (r.oe_share !== null && r.oe_share !== undefined ? fmtPct(r.oe_share) : '<span class="muted">—</span>') + '</td>' +
      '<td class="spark-cell sc-hide">' + sparkSVG(r.spark20) + '</td>' +
      '<td class="' + tc + '">' + (r.oe_trend_pp !== null && r.oe_trend_pp !== undefined ? fmtPP(r.oe_trend_pp) : '<span class="muted">—</span>') + '</td>' +
      '<td>' + normChip(r.oe_z) + '</td>' +
      '<td>' + fmtPct(r.short_ratio) + '</td>' +
      '<td class="' + sc + ' sc-hide-sm">' + fmtPP(r.trend_pp) + '</td>' +
      '<td class="sc-hide">' + (r.ats_top_venue ? '<span class="chip lag" style="font-size:10.5px;padding:1px 6px;">' + esc(r.ats_top_venue.substring(0, 22)) + '</span>' : '<span class="muted">—</span>') + '</td>' +
      '<td class="sc-hide-xs muted">' + fmtM(r.finra_total_vol) + '</td>' +
      '<td class="sc-hide muted">' + (r.n_days || '—') + '</td>' +
      '</tr>';
  }

  // ── Sorting ──────────────────────────────────────────────────────────────
  function getValue(r, col) {
    var map = {
      ticker: r.ticker,
      asof: r.asof,
      oe_share: r.oe_share,
      spark: r.oe_share,
      oe_trend_pp: r.oe_trend_pp,
      oe_z: r.oe_z,
      short_ratio: r.short_ratio,
      trend_pp: r.trend_pp,
      ats_top_venue: r.ats_top_venue,
      finra_total_vol: r.finra_total_vol,
      n_days: r.n_days,
    };
    return map[col] !== undefined ? map[col] : null;
  }

  function sortRows(rows) {
    return rows.slice().sort(function(a, b) {
      var av = getValue(a, sortCol), bv = getValue(b, sortCol);
      // nulls always last regardless of direction
      if (av === null || av === undefined) return 1;
      if (bv === null || bv === undefined) return -1;
      if (typeof av === 'string') return sortDir * av.localeCompare(bv);
      return sortDir * (av - bv);
    });
  }

  // ── Filters ───────────────────────────────────────────────────────────────
  function getFiltered() {
    var q      = (document.getElementById('dp-search').value || '').trim().toUpperCase();
    var minPct = parseFloat(document.getElementById('dp-min-share').value) || 0;
    var trend  = document.getElementById('dp-trend').value;
    var norm   = document.getElementById('dp-norm').value;

    return allRows.filter(function(r) {
      if (q && (r.ticker || '').toUpperCase().indexOf(q) === -1) return false;
      if (minPct > 0 && (r.oe_share === null || r.oe_share === undefined || r.oe_share * 100 < minPct)) return false;
      if (trend === 'rising'  && (r.oe_trend_pp === null || r.oe_trend_pp === undefined || r.oe_trend_pp < 1))  return false;
      if (trend === 'falling' && (r.oe_trend_pp === null || r.oe_trend_pp === undefined || r.oe_trend_pp > -1)) return false;
      if (norm  === 'above'   && (r.oe_z === null || r.oe_z === undefined || r.oe_z < 1))  return false;
      if (norm  === 'below'   && (r.oe_z === null || r.oe_z === undefined || r.oe_z > -1)) return false;
      // hidden ratio_z bound (short-spike preset)
      if (hiddenRatioZ !== null && (r.ratio_z === null || r.ratio_z === undefined || r.ratio_z < hiddenRatioZ)) return false;
      return true;
    });
  }

  // ── Render table ──────────────────────────────────────────────────────────
  function renderTable() {
    var filtered = getFiltered();
    var sorted   = sortRows(filtered);
    var tbody = document.getElementById('dp-tbody');
    if (tbody) tbody.innerHTML = sorted.map(renderRow).join('');
    var rc = document.getElementById('dp-row-count');
    if (rc) {
      var lang = document.documentElement.getAttribute('data-lang') || 'en';
      rc.textContent = lang === 'zh'
        ? '显示 ' + sorted.length + ' / ' + allRows.length + ' 个股'
        : 'Showing ' + sorted.length + ' of ' + allRows.length + ' names';
    }
  }

  // ── Sortable headers ──────────────────────────────────────────────────────
  document.querySelectorAll('table.dp-tbl th[data-col]').forEach(function(th) {
    if (th.getAttribute('data-type') === 'none') return;
    th.addEventListener('click', function() {
      var col = th.getAttribute('data-col');
      if (sortCol === col) {
        sortDir = -sortDir;
      } else {
        sortCol = col;
        sortDir = -1;
      }
      document.querySelectorAll('table.dp-tbl th').forEach(function(h) {
        h.classList.remove('sort-asc', 'sort-desc');
      });
      th.classList.add(sortDir === -1 ? 'sort-desc' : 'sort-asc');
      renderTable();
    });
  });

  // ── Filter inputs ─────────────────────────────────────────────────────────
  ['dp-search','dp-min-share','dp-trend','dp-norm'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('input', function() {
      activePreset = null;
      hiddenRatioZ = null;
      document.querySelectorAll('.chip.preset').forEach(function(c) { c.classList.remove('active'); });
      renderTable();
    });
  });

  // ── Clear ──────────────────────────────────────────────────────────────────
  document.getElementById('dp-clear').addEventListener('click', function() {
    document.getElementById('dp-search').value = '';
    document.getElementById('dp-min-share').value = '';
    document.getElementById('dp-trend').value = 'all';
    document.getElementById('dp-norm').value = 'all';
    hiddenRatioZ = null;
    activePreset = null;
    document.querySelectorAll('.chip.preset').forEach(function(c) { c.classList.remove('active'); });
    renderTable();
  });

  // ── Presets ────────────────────────────────────────────────────────────────
  document.querySelectorAll('.chip.preset').forEach(function(chip) {
    chip.addEventListener('click', function() {
      var p = chip.getAttribute('data-preset');
      if (activePreset === p) {
        // Second click clears
        document.getElementById('dp-clear').click();
        return;
      }
      // Clear first
      document.getElementById('dp-search').value = '';
      document.getElementById('dp-min-share').value = '';
      document.getElementById('dp-trend').value = 'all';
      document.getElementById('dp-norm').value = 'all';
      hiddenRatioZ = null;

      if (p === 'heavy-oe')   { document.getElementById('dp-min-share').value = '45'; }
      if (p === 'rising-oe')  { document.getElementById('dp-trend').value = 'rising'; document.getElementById('dp-min-share').value = '2'; }
      if (p === 'short-spike'){ hiddenRatioZ = 2; }
      if (p === 'fading-oe')  { document.getElementById('dp-trend').value = 'falling'; }

      activePreset = p;
      document.querySelectorAll('.chip.preset').forEach(function(c) { c.classList.remove('active'); });
      chip.classList.add('active');
      renderTable();
    });
  });

  // ── CSV export ─────────────────────────────────────────────────────────────
  document.getElementById('dp-export').addEventListener('click', function() {
    var filtered = sortRows(getFiltered());
    var cols = ['ticker','asof','oe_share','oe_share_5d','oe_share_40d','oe_trend_pp','oe_z',
                'short_ratio','trend_pp','ratio_z','ats_top_venue','ats_shares','ats_share_pct',
                'finra_total_vol','n_days'];
    var header = cols.join(',') + '\n';
    var body = filtered.map(function(r) {
      return cols.map(function(c) {
        var v = r[c];
        if (v === null || v === undefined) return '';
        if (typeof v === 'string' && /[",\n]/.test(v)) return '"' + v.replace(/"/g, '""') + '"';
        return v;
      }).join(',');
    }).join('\n');
    var blob = new Blob([header + body], {type:'text/csv'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = 'darkpool_desk.csv';
    document.body.appendChild(a); a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  // ── Re-render on langchange (norm chip labels change) ─────────────────────
  document.addEventListener('langchange', renderTable);

  // ── Initial render ────────────────────────────────────────────────────────
  // Set default sort indicator
  var defaultTh = document.querySelector('th[data-col="oe_share"]');
  if (defaultTh) defaultTh.classList.add('sort-desc');
  renderTable();

})();
</script>
</main>
<script src="theme.js"></script>
</body>
</html>
