{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro chip(label_en, label_zh='', cls='') -%}
<span class="chip {{ cls }}"><span class="l-en">{{ label_en }}</span><span class="l-zh">{{ label_zh if label_zh else label_en }}</span></span>
{%- endmacro %}
{% macro tip(en, zh='') -%}
<span class="tip-wrap" data-tip-en="{{ en }}" data-tip-zh="{{ zh if zh else en }}">[?]</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Dark Pool Desk — off-exchange & short volume', '场外暗池台 — 场外成交与融券量') }}</title>
<meta name="description" content="{{ t('FINRA off-exchange volume, short ratio trends, and ATS venue transparency data. EOD, display-only.', 'FINRA场外成交量、融券比率趋势及ATS场所透明数据。收盘后，仅供展示。') }}">
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1400px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; font-weight:700; margin:0; }
  h2 { font-size:13px; margin:0 0 4px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; font-weight:600; }
  .muted { color:var(--muted); }
  .sm { font-size:12px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; }
  .toprow { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:14px; }
  .chip { display:inline-flex; align-items:center; font-size:11.5px; padding:2px 9px; border-radius:20px; border:1px solid var(--line); background:var(--panel2); color:var(--muted); white-space:nowrap; }
  .chip.warn { background:rgba(255,190,0,.10); border-color:rgba(255,190,0,.35); color:#b8860b; }
  .chip.lag { background:rgba(120,130,180,.10); border-color:rgba(120,130,180,.30); color:var(--muted); }
  .chip.ok { background:rgba(35,134,54,.10); border-color:rgba(35,134,54,.30); color:var(--up); }
  .honest-box { background:rgba(255,190,0,.07); border:1px solid rgba(255,190,0,.25); border-radius:8px; padding:10px 14px; margin-bottom:14px; font-size:12.5px; line-height:1.6; color:var(--muted); }
  .honest-box strong { color:var(--text); }
  /* Table */
  .tbl-wrap { overflow-x:auto; margin-top:8px; }
  table.dp-tbl { border-collapse:collapse; width:100%; font-size:12.5px; }
  table.dp-tbl th { color:var(--muted); font-weight:600; font-size:11px; text-transform:uppercase; letter-spacing:.04em; padding:6px 8px; border-bottom:1px solid var(--line); text-align:right; white-space:nowrap; }
  table.dp-tbl th:first-child { text-align:left; }
  table.dp-tbl td { padding:5px 8px; border-bottom:1px solid var(--line); text-align:right; font-variant-numeric:tabular-nums; }
  table.dp-tbl td:first-child { text-align:left; font-weight:600; }
  table.dp-tbl tr:hover td { background:var(--panel2); }
  .bar-cell { position:relative; }
  .bar-bg { position:absolute; top:4px; right:0; height:calc(100% - 8px); opacity:.18; border-radius:3px 0 0 3px; }
  .bar-pos { background:var(--up); }
  .bar-neg { background:var(--down); }
  .num-pos { color:var(--up); }
  .num-neg { color:var(--down); }
  .num-neu { color:var(--muted); }
  /* ATS venue table */
  .venue-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:10px; margin-top:10px; }
  .venue-card { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:10px 12px; }
  .venue-card .vname { font-size:12.5px; font-weight:600; margin-bottom:2px; }
  .venue-card .vmpid { font-size:11px; color:var(--muted); margin-bottom:6px; }
  .venue-card .vstat { display:flex; justify-content:space-between; font-size:11.5px; }
  .venue-card .vstat .lbl { color:var(--muted); }
  /* search filter */
  #dp-search { background:var(--panel2); border:1px solid var(--line); border-radius:8px; padding:5px 10px; font-size:13px; color:var(--text); width:100%; max-width:260px; outline:none; }
  #dp-search::placeholder { color:var(--muted); }
  /* tip popover */
  .tip-wrap { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:9px; font-weight:700; cursor:help; position:relative; vertical-align:middle; margin-left:3px; }
  .tip-pop { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:260px; background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 12px; z-index:80; font-size:12px; line-height:1.5; color:var(--text); box-shadow:0 4px 16px rgba(0,0,0,.18); pointer-events:none; }
  .tip-wrap:hover .tip-pop { display:block; }
  @media (max-width:640px){ table.dp-tbl th,.dp-hide { display:none; } table.dp-tbl th:nth-child(-n+3), table.dp-tbl td:nth-child(-n+3) { display:table-cell; } }
</style>
</head>
<body>
<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" class="search-box" placeholder="{{ t('Search…','搜索…') }}" autocomplete="off" spellcheck="false">
    <div class="search-results"></div>
  </div>
  {% include "_site_nav.html.j2" ignore missing %}
</nav>

<div class="toprow">
  <h1>🌑 {{ t('Dark Pool Desk', '场外暗池台') }}</h1>
  {{ chip('EOD · display-only', 'EOD · 仅供展示') }}
  {% if below_floor %}
  {{ chip('⚠ thin history (' ~ panel_dates ~ ' dates)', '⚠ 历史数据不足（' ~ panel_dates ~ ' 天）', 'warn') }}
  {% else %}
  {{ chip(panel_dates|string ~ ' dates available', panel_dates|string ~ ' 个交易日数据', 'ok') }}
  {% endif %}
  <span class="muted sm">{{ t('as of', '数据截至') }} {{ panel_latest }} · {{ t('built', '构建于') }} {{ built }}</span>
</div>

<div class="honest-box">
  <strong>{{ t('Data provenance', '数据来源说明') }}</strong> ·
  {{ t('T1e: FINRA CNMSshvol — off-exchange (FINRA-facility) volume and short-sale volume reported by FINRA member firms. This is NOT live trading data and NOT direct dark-pool print data. "Short ratio" = short-sale volume ÷ FINRA-facility total volume. "Off-exchange share" = FINRA-facility volume ÷ yahoo consolidated day volume (denominator labeled per row). T2e: FINRA OTC Transparency weekly per-ATS venue data — 2–4 week publication lag; not a real-time feed.',
     'T1e：FINRA CNMSshvol — FINRA成员机构上报的场外（FINRA设施）成交量与卖空成交量。本数据非实时交易数据，亦非直接的暗池成交记录。"融券比率"=卖空成交量÷FINRA设施总成交量。"场外占比"=FINRA设施成交量÷雅虎综合日成交量（各行标注分母来源）。T2e：FINRA场外透明度每周各ATS场所数据——公布滞后2–4周，非实时数据。') }}
</div>

{# ═══════════════════════════════════════════════ Per-name table ═════════════ #}
<div class="panel">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
    <h2>{{ t('Off-Exchange Volume — Per Name', '场外成交量 — 各个股') }}</h2>
    <input id="dp-search" type="text" placeholder="{{ t('Filter ticker…','筛选代码…') }}" autocomplete="off">
    <span class="muted sm">{{ t('display universe:', '展示范围：') }} {{ display_universe_size }} {{ t('names', '个股') }}</span>
  </div>
  <div class="tbl-wrap">
    <table class="dp-tbl" id="dp-table">
      <thead>
        <tr>
          <th>{{ t('Ticker','代码') }}</th>
          <th>{{ t('Date','日期') }}</th>
          <th>{{ t('Short Ratio','融券比率') }}
            <span class="tip-wrap" data-tip-en="Short-sale volume ÷ FINRA-facility total volume for this session. FINRA-facility vol is off-exchange (reported to FINRA consolidated market surveillance). NOT the NYSE/Nasdaq consolidated tape ratio." data-tip-zh="卖空成交量÷当日FINRA设施总成交量。FINRA设施成交量为场外成交（上报FINRA综合市场监督系统），非NYSE/纳斯达克综合报价带比率。">[?]<span class="tip-pop"><span class="l-en">Short-sale volume ÷ FINRA-facility total volume for this session.</span><span class="l-zh">卖空成交量÷当日FINRA设施总成交量。</span></span></span>
          </th>
          <th class="dp-hide">{{ t('Recent 5d','近5日') }}</th>
          <th class="dp-hide">{{ t('Baseline 40d','基准40日') }}</th>
          <th>{{ t('Trend (pp)','趋势(pp)') }}
            <span class="tip-wrap" data-tip-en="Recent 5-day volume-weighted short ratio minus 40-day baseline, in percentage points. Positive = building off-exchange short flow vs baseline." data-tip-zh="近5日量加权融券比率减去40日基准，单位百分点。正值=相对基准场外空头流量增强。">[?]<span class="tip-pop"><span class="l-en">Recent 5d − 40d baseline (pp). Positive = building short flow.</span><span class="l-zh">近5日 − 40日基准（pp）。正值=空头流量增强。</span></span></span>
          </th>
          <th>{{ t('Ratio Z','比率Z值') }}
            <span class="tip-wrap" data-tip-en="Short ratio z-score vs own history. Magnitude shows how unusual today's reading is relative to this name's typical range." data-tip-zh="融券比率相对自身历史的Z值。数值大小反映当日读数偏离该股历史典型区间的程度。">[?]<span class="tip-pop"><span class="l-en">Z-score vs own history. |z|>2 = unusual.</span><span class="l-zh">相对自身历史Z值。|z|>2为异常。</span></span></span>
          </th>
          <th>{{ t('Off-Ex Share','场外占比') }}
            <span class="tip-wrap" data-tip-en="FINRA-facility total volume ÷ consolidated day volume (yahoo). Measures what fraction of this name's daily volume was reported to FINRA's off-exchange facilities. Denominator source labeled per row." data-tip-zh="FINRA设施总成交量÷综合日成交量（雅虎）。衡量该股当日成交量中上报FINRA场外设施的比例，各行注明分母来源。">[?]<span class="tip-pop"><span class="l-en">FINRA-facility vol ÷ consolidated vol (yahoo). Off-exchange share of total trading.</span><span class="l-zh">FINRA设施成交量÷综合成交量（雅虎）。场外成交占总成交比例。</span></span></span>
          </th>
          <th class="dp-hide">{{ t('Days','天数') }}</th>
        </tr>
      </thead>
      <tbody id="dp-tbody">
      {% for r in table_rows %}
        {% set trend_cls = 'num-neg' if r.trend_pp > 0 else ('num-pos' if r.trend_pp < 0 else 'num-neu') %}
        {% set z_cls = 'num-neg' if r.ratio_z > 1.5 else ('num-pos' if r.ratio_z < -1.5 else 'num-neu') %}
        <tr data-tk="{{ r.ticker }}">
          <td>{{ r.ticker }}</td>
          <td class="muted">{{ r.asof }}</td>
          <td>{{ "%.1f%%"|format(r.short_ratio * 100) }}</td>
          <td class="dp-hide">{{ "%.1f%%"|format(r.short_ratio_recent * 100) }}</td>
          <td class="dp-hide">{{ "%.1f%%"|format(r.short_ratio_baseline * 100) }}</td>
          <td class="{{ trend_cls }}">{{ "%+.2f"|format(r.trend_pp) }}</td>
          <td class="{{ z_cls }}">{{ "%+.2f"|format(r.ratio_z) }}</td>
          <td>
            {% if r.oe_share is not none %}
              {{ "%.1f%%"|format(r.oe_share * 100) }}
              <span class="muted sm" title="{{ r.oe_note }}">†</span>
            {% else %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td class="dp-hide muted">{{ r.n_days }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% if n_tickers_total > table_rows|length %}
  <p class="muted sm" style="margin-top:8px;">
    {{ t('Showing top', '显示前') }} {{ table_rows|length }} {{ t('of', '共') }} {{ n_tickers_total }} {{ t('names by off-exchange share / short ratio.', '个股，按场外占比或融券比率排序。') }}
  </p>
  {% endif %}
  <p class="muted sm" style="margin-top:6px;">
    † {{ t('Off-exchange share denominator: Yahoo consolidated day volume (T+0).', '场外占比分母：雅虎综合日成交量（T+0）。') }}
  </p>
</div>

{# ═══════════════════════════════════════════ ATS Venue table ════════════════ #}
<div class="panel">
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
    <h2>{{ t('Weekly ATS Venue Breakdown', '每周ATS场所分项') }}</h2>
    {% if ats_lag_note %}
    {{ chip('⏱ ' ~ ats_lag_note, '⏱ ' ~ ats_lag_note, 'lag') }}
    {% endif %}
    {% if ats_table and ats_table.week_start %}
    <span class="muted sm">{{ t('week of', '报告周：') }} {{ ats_table.week_start }}</span>
    {% endif %}
  </div>
  {% if ats_table and ats_table.venues %}
  <p class="muted sm" style="margin-bottom:10px;">
    {{ t('Source: FINRA OTC Transparency API (keyless). Aggregate weekly shares and trades per registered ATS for', '来源：FINRA场外透明度API（无需密钥）。每个注册ATS场所的每周累计成交量与交易笔数，涵盖') }}
    {{ ats_table.n_symbols_total }} {{ t('symbols. NOT "live" — 2–4 week publication lag from reporting week end.', '个标的。非实时数据——距报告周结束有2–4周公布滞后。') }}
  </p>
  <div class="venue-grid">
    {% for v in ats_table.venues[:15] %}
    <div class="venue-card">
      <div class="vname">{{ v.venue_name if v.venue_name else v.mpid }}</div>
      <div class="vmpid">{{ t('MPID:', 'MPID：') }} {{ v.mpid }}</div>
      <div class="vstat">
        <span><span class="lbl">{{ t('Shares', '成交量') }}</span> {{ "{:,.0f}".format(v.total_shares) }}</span>
        <span><span class="lbl">{{ t('Trades', '笔数') }}</span> {{ "{:,}".format(v.total_trades) }}</span>
        <span><span class="lbl">{{ t('Symbols', '标的') }}</span> {{ v.n_symbols }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="muted">
    {{ t('No ATS venue data available yet. Run the collector to fetch the latest published week:', '暂无ATS场所数据。请运行采集器获取最新公布周数据：') }}
    <code>python -m collectors.finra_ats_transparency</code>
  </p>
  {% endif %}
</div>

{# ═══════════════════════════════════════════ Methodology box ════════════════ #}
<div class="panel">
  <h2>{{ t('Methodology & Limitations', '方法论与局限性') }}</h2>
  <div style="font-size:13px; line-height:1.7; color:var(--muted); max-width:820px;">
    <p>
      <strong class="l-en">T1e — Off-exchange (FINRA-facility) volume:</strong>
      <strong class="l-zh">T1e — 场外（FINRA设施）成交量：</strong>
      <span class="l-en">FINRA publishes daily consolidated short-volume (CNMSshvol) files reporting each member firm's short-sale and total volume routed through FINRA-regulated facilities (e.g. FINRA's Alternative Display Facility, broker internalization). These are NOT equivalent to NYSE/Nasdaq consolidated tape volumes.</span>
      <span class="l-zh">FINRA每日发布综合融券成交量（CNMSshvol）文件，记录各成员机构通过FINRA监管设施（如FINRA另类显示设施、券商内部化）路由的卖空及总成交量。此数据与NYSE/纳斯达克综合报价带成交量并不等同。</span>
    </p>
    <p>
      <strong class="l-en">Short ratio:</strong>
      <strong class="l-zh">融券比率：</strong>
      <span class="l-en">Short-sale volume ÷ FINRA-facility total volume for the session. A higher ratio means more of the off-exchange routed volume was flagged short. This is a noisy, daily signal; standalone predictive edge is modest and contested in academic literature. Used here as a positioning context confirmer, not a scored alpha factor.</span>
      <span class="l-zh">当日卖空成交量÷FINRA设施总成交量。比率越高说明场外路由成交量中被标记为卖空的比例越大。该信号噪声较大，独立预测能力有限，学术界亦存争议。本台仅作为仓位情境印证，非评分型阿尔法因子。</span>
    </p>
    <p>
      <strong class="l-en">Off-exchange share denominator:</strong>
      <strong class="l-zh">场外占比分母：</strong>
      <span class="l-en">Consolidated day volume sourced from Yahoo Finance EOD data (Yahoo consolidated day volume). This is the best available free denominator for the display universe; note that Yahoo volumes can lag intraday rounding differences vs official tape totals.</span>
      <span class="l-zh">综合日成交量来源于雅虎财经EOD数据（雅虎综合日成交量）。这是展示范围内最优质的免费分母数据；需注意雅虎成交量与官方报价带汇总数据可能存在日内舍入差异。</span>
    </p>
    <p>
      <strong class="l-en">T2e — FINRA OTC Transparency (weekly ATS):</strong>
      <strong class="l-zh">T2e — FINRA场外透明度（每周ATS）：</strong>
      <span class="l-en">FINRA's OTC Transparency programme mandates weekly reporting from all registered ATS. Data is published with a 2–4 week lag via the FINRA API (api.finra.org/data/group/OTCMarket/name/weeklysummary, keyless). The venue table shows aggregate shares and trade counts per ATS for the latest published reporting week.</span>
      <span class="l-zh">FINRA场外透明度计划要求所有注册ATS每周上报数据，经由FINRA API（api.finra.org，无需密钥）公布，滞后2–4周。场所表展示最新公布报告周各ATS的汇总成交量与交易笔数。</span>
    </p>
    <p class="sm">
      <span class="l-en">Display universe: ~{{ display_universe_size }} names (options universe gex_symbols). Full ~8-year backfill restricted to this universe to satisfy the 30 MB git-tracked-file ceiling (projected full-universe file ~67 MB). Denominator source: Yahoo Finance consolidated volume, labeled per row.</span>
      <span class="l-zh">展示范围：约{{ display_universe_size }}个标的（期权范围gex_symbols）。完整~8年回填数据受限于此范围，以满足30MB git追踪文件上限（全范围预计约67MB）。分母来源：雅虎财经综合成交量，各行标注。</span>
    </p>
  </div>
</div>

<script>
// Ticker filter
var inp = document.getElementById('dp-search');
if (inp) {
  inp.addEventListener('input', function() {
    var q = inp.value.trim().toUpperCase();
    var rows = document.querySelectorAll('#dp-tbody tr');
    rows.forEach(function(r) {
      r.style.display = !q || (r.dataset.tk || '').indexOf(q) !== -1 ? '' : 'none';
    });
  });
}
// Tip popovers lang switch
document.addEventListener('DOMContentLoaded', function() {
  var lang = document.documentElement.getAttribute('data-lang') || '';
  document.querySelectorAll('.tip-wrap').forEach(function(el) {
    var pop = el.querySelector('.tip-pop');
    if (!pop) return;
    var en = el.dataset.tipEn, zh = el.dataset.tipZh;
    if (lang === 'zh' && zh) pop.textContent = zh;
    else if (en) pop.textContent = en;
  });
});
</script>
<script src="theme.js"></script>
</body>
</html>
