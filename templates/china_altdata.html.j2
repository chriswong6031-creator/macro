{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% macro bl(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro sc(v) -%}
{% if v is none %}<span class="mut">·</span>{% else %}<span class="{{ 'r-pos' if v>0 else ('r-neg' if v<0 else 'mut') }}">{{ '%+.2f'|format(v) }}</span>{% endif %}
{%- endmacro %}

{% block title %}{{ t('Alternative Data', '另类数据') }} — {{ t('Macro Dashboard', '宏观仪表盘') }}{% endblock %}

{% block base_css %}
  .ad-hero { max-width:1060px; margin:18px auto 0; }
  .ad-hero .eyebrow { font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--link); font-weight:600; margin:0 0 8px; }
  .ad-hero h1 { font-size:29px; margin:0 0 8px; letter-spacing:-.01em; }
  html[data-lang="zh"] .ad-hero h1 { letter-spacing:0; }
  .ad-hero .lens { font-size:12px; color:var(--muted); }
  .ad-wrap { max-width:1060px; margin:0 auto; }
  h2.sec { font-size:19px; margin:28px 0 8px; border-top:1px solid var(--line); padding-top:18px; display:flex; align-items:baseline; gap:9px; }
  .callout { border-radius:12px; padding:13px 16px; margin:14px 0; border:1px solid var(--line); background:var(--panel2); font-size:13.5px; line-height:1.6; }
  .callout.warn { border-left:4px solid var(--warn); }
  table.data { border-collapse:collapse; width:100%; font-size:12.5px; margin:10px 0; }
  table.data th { text-align:left; padding:7px 9px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:2px solid var(--line); position:sticky; top:0; }
  table.data td { padding:7px 9px; border-bottom:1px solid var(--line); vertical-align:middle; }
  table.data td.num { text-align:right; font-variant-numeric:tabular-nums; }
  .conv { font-weight:700; font-variant-numeric:tabular-nums; }
  .flag { font-size:10px; font-weight:700; padding:2px 7px; border-radius:6px; color:#e0973a; background:color-mix(in srgb,#e0973a 13%,transparent); }
  .cvband { font-size:10px; font-weight:700; padding:2px 7px; border-radius:6px; white-space:nowrap; }
  .cvband.cv-pos { color:#1f9a55; background:color-mix(in srgb,#1f9a55 12%,transparent); }
  .cvband.cv-neg { color:#d23f3f; background:color-mix(in srgb,#d23f3f 12%,transparent); }
  html[data-lang="zh"] .cvband.cv-pos { color:#d23f3f; background:color-mix(in srgb,#d23f3f 12%,transparent); }
  html[data-lang="zh"] .cvband.cv-neg { color:#1f9a55; background:color-mix(in srgb,#1f9a55 12%,transparent); }
  .chips { display:flex; flex-wrap:wrap; gap:7px; margin:10px 0; }
  .nchip { font-size:12px; padding:4px 10px; border-radius:999px; background:var(--panel2); border:1px solid var(--line); }
  /* signal-lab tiers */
  .lab { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:12px; margin:12px 0; }
  .tier { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:13px 15px; }
  .tier h3 { margin:0 0 8px; font-size:13px; text-transform:uppercase; letter-spacing:.05em; display:flex; gap:8px; align-items:center; }
  .tier .badge { font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px; }
  .t-scored .badge{color:#1f9a55;background:color-mix(in srgb,#1f9a55 14%,transparent)}
  .t-confirmer .badge{color:#5b8def;background:color-mix(in srgb,#5b8def 14%,transparent)}
  .t-display .badge{color:var(--muted);background:var(--panel2)}
  .t-pending .badge{color:#e0973a;background:color-mix(in srgb,#e0973a 14%,transparent)}
  .t-killed .badge{color:#d23f3f;background:color-mix(in srgb,#d23f3f 13%,transparent)}
  .lab .row { padding:7px 0; border-bottom:1px solid var(--line); }
  .lab .row:last-child { border-bottom:0; }
  .lab .nm { font-weight:600; font-size:13px; }
  .lab .wired { font-size:10px; color:var(--link); font-family:ui-monospace,Menlo,monospace; }
  .lab .nt { font-size:11.5px; color:var(--muted); line-height:1.5; margin-top:2px; }
  .disc { font-size:11.5px; color:var(--muted); margin-top:12px; line-height:1.55; }
{% endblock %}

{% block content %}
<section class="ad-hero">
  <p class="eyebrow">🛰️ {{ t('Alternative Data', '另类数据') }}</p>
  <h1>{{ t('China Alternative-Data Desk', '中国另类数据台') }}</h1>
  <p class="lens">{{ t('Smart-money convergence (consensus × valuation × financing) + an honest signal scorecard · context only · as of', '主力共振（一致预期 × 估值 × 融资）＋诚实信号记分卡 · 仅供参考 · 截至') }} {{ ad.asof if ad else (lab.generated_utc[:10] if lab else '—') }}</p>
</section>

<div class="ad-wrap">

  <div class="callout warn">{{ t('No validated edge is claimed. Convergence is a display JOIN of three independent free feeds — where they agree, not a backtest. A-share cross-sectional value Sharpe is negative and sell-side ratings are near-universally "buy"; treat this as a watchlist seed + a Phase-0 candidate, never a sizer.', '不声称任何已验证的优势。共振只是三个独立免费数据源的展示性合并——展示其一致之处，而非回测。A股横截面价值夏普为负、卖方评级近乎全为『买入』；请将其视为自选股种子与Phase-0候选，绝非仓位依据。') }}</div>

  {% if ad and ad.triple %}
  <h2 class="sec">🎯 {{ t('Multi-feed convergence', '多源共振') }} <span style="font-size:12px;color:var(--muted)">{{ t('≥3 of 7 independent feeds agree', '7源中≥3源一致') }} · {{ ad.n_triple }}</span></h2>
  <p style="font-size:12px;color:var(--muted);margin:2px 0 6px">{{ t('Cross-sectional mid-rank percentile per feed (signed, −1 distribute … +1 accumulate): consensus · valuation · financing · 主力资金 flow · 千股千评 attention · 龙虎榜 hot-money · 大宗交易 block. No validated edge claimed.', '每个数据源的横截面中位排名分位（带符号，−1派发…+1吸筹）：一致预期·估值·融资·主力资金·千股千评·龙虎榜·大宗交易。不声称已验证优势。') }}</p>
  <table class="data">
    <thead><tr>
      <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Name', '名称') }}</th>
      <th class="num">{{ t('Convergence', '共振') }}</th><th>{{ t('Conviction', '置信') }}</th><th class="num">{{ t('%ile', '分位') }}</th>
      <th class="num">{{ t('Consensus', '一致') }}</th><th class="num">{{ t('Value', '估值') }}</th><th class="num">{{ t('Financing', '融资') }}</th>
      <th class="num">{{ t('Flow', '主力') }}</th><th class="num">{{ t('Comment', '千评') }}</th><th class="num">{{ t('LHB', '龙虎') }}</th><th class="num">{{ t('Block', '大宗') }}</th>
      <th>{{ t('Flags', '标记') }}</th>
    </tr></thead>
    <tbody>
    {% for r in ad.triple %}
      <tr>
        <td>{{ r.ticker }}</td><td>{{ r.name }}</td>
        <td class="num conv {{ 'r-pos' if r.convergence>0 else ('r-neg' if r.convergence<0 else '') }}">{{ '%+.2f'|format(r.convergence) }}</td>
        <td><span class="cvband {{ 'cv-pos' if r.convergence>0 else 'cv-neg' }}">{{ bl(r.conviction_band_en or 'None', r.conviction_band_zh or '无') }}</span></td>
        <td class="num">{{ r.rank_pctile }}</td>
        <td class="num">{{ sc(r.analyst) }}</td><td class="num">{{ sc(r.value) }}</td><td class="num">{{ sc(r.margin) }}</td>
        <td class="num">{{ sc(r.flow) }}</td><td class="num">{{ sc(r.comment) }}</td><td class="num">{{ sc(r.lhb) }}</td><td class="num">{{ sc(r.block) }}</td>
        <td>{% for fl in r.flags %}<span class="flag">{{ bl((crowd_labels.get(fl) or [fl,fl])[0], (crowd_labels.get(fl) or [fl,fl])[1]) }}</span> {% endfor %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <p style="font-size:11px;color:var(--muted)">{{ t('Flags = multi-leg crowding (contrarian fragility, latest snapshot, NOT scored): margin froth · pledge tail · limit-up froth · attention spike · rich valuation.', '标记＝多腿拥挤（逆向脆弱性，最新快照，不评分）：融资过热·质押风险·涨停过热·关注度飙升·估值偏高。') }}</p>
  {% endif %}

  {% if broker_gold %}
  <h2 class="sec">🏅 {{ t('Broker gold-stock picks', '券商金股') }} <span style="font-size:12px;color:var(--muted)">{{ broker_gold[0].month }} · {{ t('Tushare premium', 'Tushare 付费') }}</span></h2>
  <p style="font-size:12px;color:var(--muted)">{{ t('Names most-picked by sell-side desks this month, as a pick-count conviction tally — a discrete monthly list, not the ~97%-buy ratings. Display-only, never scored.', '当月被卖方研究所推荐最多的个股，按推荐家数计——离散月度名单，区别于近97%『买入』评级。仅展示，不评分。') }}</p>
  <table class="data">
    <thead><tr>
      <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Name', '名称') }}</th>
      <th class="num">{{ t('# brokers', '券商家数') }}</th><th>{{ t('Picked by', '推荐机构') }}</th>
    </tr></thead>
    <tbody>
    {% for r in broker_gold %}
      <tr>
        <td>{{ r.ticker }}</td><td>{{ r.name }}</td>
        <td class="num conv r-pos">{{ r.n_brokers }}</td>
        <td style="font-size:11.5px;color:var(--muted)">{{ r.brokers[:6]|join(' · ') }}{% if r.brokers|length > 6 %} …{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if guidance and (guidance.up or guidance.down) %}
  <h2 class="sec">📣 {{ t('Earnings-guidance surprises', '业绩预告') }} <span style="font-size:12px;color:var(--muted)">{{ t('Tushare premium · validated as the guidance family', 'Tushare 付费 · 已作为 guidance 家族验证') }}</span></h2>
  <p style="font-size:12px;color:var(--muted)">{{ t('Company 业绩预告 direction × guided net-profit change. The forward-IC harness finds a real ~3-month post-announcement drift (right sign), accruing toward proven — display + measured, never scored here.', '公司业绩预告方向×预告净利润变动。前瞻IC检验发现真实的约3个月公告后漂移（符号正确），正向已验证累积——展示与测量，此处不评分。') }}</p>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px">
  {% for col, items, cls in [('▲ '+t('Positive', '正面'), guidance.up, 'r-pos'), ('▼ '+t('Negative', '负面'), guidance.down, 'r-neg')] %}
    {% if items %}
    <div>
      <table class="data">
        <thead><tr><th colspan="2" class="{{ cls }}">{{ col|safe }}</th><th class="num">{{ t('Guided Δ%', '预告变动%') }}</th><th class="num">{{ t('Score', '评分') }}</th></tr></thead>
        <tbody>
        {% for r in items %}
          <tr>
            <td>{{ r.ticker }}</td>
            <td>{% set gl = guidance_labels.get(r.type) or [r.type, r.type] %}{{ bl(gl[0], gl[1]) }}</td>
            <td class="num">{% if r.p_change_min is not none and r.p_change_max is not none %}{{ '%+.0f'|format(r.p_change_min) }}…{{ '%+.0f'|format(r.p_change_max) }}{% else %}·{% endif %}</td>
            <td class="num conv {{ cls }}">{{ '%+.2f'|format(r.guidance_score) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  {% endfor %}
  </div>
  {% endif %}

  {% if ad and ad.crowding_flags %}
  <h2 class="sec">⚠️ {{ t('Leverage-crowding flags', '杠杆拥挤标记') }}</h2>
  <p style="font-size:12px;color:var(--muted)">{{ t('Names whose 20-day financing balance jumped most — leverage building (cuts both ways).', '20日融资余额跳升最多的名单——杠杆在累积（双刃剑）。') }}</p>
  <div class="chips">{% for tk in ad.crowding_flags %}<span class="nchip">{{ tk }}</span>{% endfor %}</div>
  {% endif %}

  <!-- ===== signal lab scorecard ===== -->
  {% if lab %}
  <h2 class="sec">🔬 {{ t('China Signal Lab', '中国信号实验室') }}</h2>
  <p style="font-size:12px;color:var(--muted)">{{ t('Every China signal with an honest tier — scored (in the allocator) · confirmer · display · Phase-0 pending · killed.', '每个中国信号及其诚实分级——已评分（进入配置）· 确认器 · 展示 · Phase-0待验 · 已淘汰。') }}</p>
  <div class="lab">
    {% for tier, items in lab.tiers.items() %}
    {% if items %}
    <div class="tier t-{{ tier }}">
      <h3><span class="badge">{{ t(tier|capitalize, ({'scored':'已评分','confirmer':'确认器','display':'展示','pending':'待验','killed':'已淘汰'}).get(tier, tier)) }}</span> <span style="color:var(--muted)">{{ items|length }}</span></h3>
      {% for r in items %}
      <div class="row">
        <div class="nm">{{ bl(r.name_en, r.name_zh) }} {% if r.wired and r.wired != '—' %}<span class="wired">{{ r.wired }}</span>{% endif %}</div>
        <div class="nt">{{ bl(r.note_en, r.note_zh) }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  <p class="disc">{{ t('Context only — not a signal, score or trade. Convergence reuses already-collected free feeds (china_analyst / china_valuation / china_margin_detail) and is a display join; it never feeds any allocation. The scored legs are those already validated inside china_masterminds.', '仅作背景，非信号、评分或交易。共振复用已采集的免费数据（卖方一致预期／自身估值／个股融资）且为展示性合并，绝不进入任何配置。已评分项为china_masterminds中已验证的部分。') }}</p>
</div>
{% endblock %}
