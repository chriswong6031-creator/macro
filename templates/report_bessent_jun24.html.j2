  <tr><th>{{ t('Dimension', '维度') }}</th><th>{{ t('Narrative (said)', '叙事（所说）') }}</th><th>{{ t('Revealed (the mechanism)', '显示（机制）') }}</th><th>{{ t('True interest', '真实利益') }}</th></tr>
