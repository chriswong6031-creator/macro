{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro num(v, nd=2, plus=False) -%}
{%- if v is none -%}<span class="muted">—</span>{%- elif plus -%}{{ ('%+.'~nd~'f')|format(v) }}{%- else -%}{{ ('%.'~nd~'f')|format(v) }}{%- endif -%}
{%- endmacro %}
{% macro pct(v) -%}
{%- if v is none -%}<span class="muted">—</span>{%- else -%}{{ '%.0f%%'|format(v*100) }}{%- endif -%}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Signal Lab — does each signal actually work?', '信号实验室 — 每个信号真的有效吗？') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1380px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:21px; margin:0; }
  h2 { font-size:13px; margin:0 0 4px; color:var(--muted); text-transform:uppercase;
       letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); } .sm { font-size:12px; }
  .lead { font-size:14.5px; max-width:70ch; }
  table { border-collapse:collapse; width:100%; font-size:12.5px; }
  th,td { text-align:left; padding:5px 8px; border-bottom:1px solid var(--line);
          vertical-align:top; }
  th { color:var(--muted); font-weight:500; white-space:nowrap; }
  td.r, th.r { text-align:right; font-variant-numeric:tabular-nums; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .sig { font-weight:600; } .mkt { font-size:11px; color:var(--muted); }
  .src { font-size:10.5px; color:var(--muted); }
  .extra { font-size:11px; color:var(--muted); margin-top:2px; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px;
          height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted);
          font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:0; transform:none;
               width:320px; background:var(--panel); border:1px solid var(--line); padding:9px 11px;
               border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text);
               font-weight:400; box-shadow:var(--popover-shadow); pointer-events:none; }
  .help:hover .tip { display:block; }
  .chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:4px; }
  .chip { font-size:12px; padding:4px 10px; border-radius:18px; border:1px solid var(--line);
          background:var(--panel2); display:inline-flex; align-items:center; gap:6px; }
  .chip b { font-size:14px; }
  .pill { font-size:10.5px; font-weight:700; padding:1px 8px; border-radius:8px; white-space:nowrap;
          border:1px solid var(--line); }
  .v-scored    { color:var(--up);   border-color:color-mix(in srgb,var(--up) 50%,var(--line)); }
  .v-confirmer { color:var(--link); border-color:color-mix(in srgb,var(--link) 50%,var(--line)); }
  .v-display   { color:var(--muted); }
  .v-killed    { color:var(--down); border-color:color-mix(in srgb,var(--down) 50%,var(--line)); }
  .v-pending   { color:#b8860b; border-color:#b8860b66; }
  .dot { width:9px; height:9px; border-radius:50%; display:inline-block; }
  .d-scored{background:var(--up);} .d-confirmer{background:var(--link);}
  .d-display{background:var(--muted);} .d-killed{background:var(--down);} .d-pending{background:#b8860b;}
  .tierhead { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; margin:2px 0 8px; }
  .tierhead h2 { margin:0; } .tierhead .bl { font-size:12px; color:var(--muted); max-width:64ch; }
  .yes { color:var(--up); font-weight:700; } .no { color:var(--muted); }
  .grave { border-left:3px solid var(--down); }
  .win   { border-left:3px solid var(--up); }
  details.method summary { cursor:pointer; font-weight:600; }
  details.method dl { margin:8px 0 0; } details.method dt { font-weight:600; margin-top:7px; }
  details.method dd { margin:1px 0 0; color:var(--muted); font-size:12.5px; }
  .scroll { overflow-x:auto; }
  .ctl { display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
  .ctl input[type=search], .ctl select { font:13px inherit; padding:6px 10px; border-radius:8px;
    border:1px solid var(--line); background:var(--panel2); color:var(--text); }
  .ctl input[type=search] { flex:1 1 240px; min-width:170px; }
  .tier-tog-wrap { display:flex; flex-wrap:wrap; gap:10px; }
  .tier-tog-wrap label { display:inline-flex; align-items:center; gap:5px; font-size:12px;
    color:var(--muted); cursor:pointer; white-space:nowrap; }
  table.sl-table thead th { cursor:pointer; user-select:none; }
  table.sl-table thead th:hover { color:var(--text); }
  table.sl-table thead th.sorted::after { content:" ↓"; font-size:9px; }
  table.sl-table thead th.sorted.asc::after { content:" ↑"; }
  .ovl-note { font-size:11.5px; color:var(--muted); margin:-2px 0 9px; max-width:80ch;
    border-left:2px solid color-mix(in srgb,var(--link) 45%,var(--line)); padding-left:9px; }
  .frontier-note { font-size:12px; color:var(--muted); max-width:86ch; margin:0 0 10px; }
  .frontier-table td { padding-top:8px; padding-bottom:8px; }
  .frontier-table .sig { font-size:12.5px; }
  .frontier-table .road { max-width:30ch; color:var(--muted); }
  .frontier-table .gate { max-width:28ch; }
  .frontier-table .src { margin-top:3px; }
  .frontier-pri { font-size:10px; padding:1px 6px; border-radius:7px; border:1px solid var(--line);
    color:var(--muted); margin-left:5px; }
  .fable-chip { font-size:10px; padding:1px 7px; border-radius:7px; font-weight:600;
    letter-spacing:0.02em; display:inline-block; }
  .fable-chip.kill { background:color-mix(in srgb,#e55 25%,transparent); color:#c33; border:1px solid #c33; }
  .fable-chip.build { background:color-mix(in srgb,#4a4 25%,transparent); color:#2a8; border:1px solid #2a8; }
  .fable-chip.probe { background:color-mix(in srgb,#68a 25%,transparent); color:#468; border:1px solid #468; }
  .fable-chip.pilot { background:color-mix(in srgb,#88a 25%,transparent); color:#558; border:1px solid #558; }
  .fable-chip.route { background:color-mix(in srgb,#fa0 25%,transparent); color:#960; border:1px solid #a70; }
  .fable-chip.accrue { background:color-mix(in srgb,#aaf 25%,transparent); color:#44c; border:1px solid #44c; }
  .fable-chip.queued { background:color-mix(in srgb,#aaa 25%,transparent); color:#666; border:1px solid #999; }
  .fable-chip.pending { background:color-mix(in srgb,#999 15%,transparent); color:var(--muted); border:1px solid var(--line); }
  .fable-chip.tested-null { background:color-mix(in srgb,#f80 15%,transparent); color:#a50; border:1px solid #c70; }
  .fable-chip.tested-pass { background:color-mix(in srgb,#2d8 25%,transparent); color:#196; border:1px solid #1a7; }
  .fable-chip.tested-partial { background:color-mix(in srgb,#fb0 20%,transparent); color:#860; border:1px solid #a80; }
  .fable-chip.tested-accrue { background:color-mix(in srgb,#aaf 20%,transparent); color:#33a; border:1px solid #55c; }
</style>
</head>
<body>

<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="panel">
  <div class="topline">
    <h1>🔬 {{ t('Signal Lab', '信号实验室') }}</h1>
    <span class="muted sm">{{ t('Every signal, and whether it actually survives validation',
                                '每个信号，以及它是否真正通过验证') }}</span>
  </div>
  <p class="lead" style="margin:10px 0 0">{{ t(
     "What separates a dashboard from a model is honest validation. Every signal here goes "
     "through the same battery before it earns a place: rank-IC, a Newey-West (HAC) t-stat that "
     "respects overlapping windows, a Benjamini-Hochberg FDR q that controls for trying many "
     "ideas, and a Deflated Sharpe that haircuts for the same data-snooping. The point of this "
     "page is the graveyard: the signals we measured and refused to ship.",
     "把仪表盘和模型区分开的，是诚实的验证。这里每个信号在获得位置前都经过同一套检验："
     "秩相关 IC、尊重重叠窗口的 Newey-West (HAC) t 值、控制多重尝试的 Benjamini-Hochberg FDR q，"
     "以及为同样的数据窥探打折的去偏夏普 (DSR)。本页的重点是“信号墓地”：那些我们测量后拒绝上线的信号。") }}</p>
  <div class="chips">
    <span class="chip"><span class="dot d-scored"></span><b>{{ summary.scored }}</b> {{ t('scored','已计分') }}</span>
    <span class="chip"><span class="dot d-confirmer"></span><b>{{ summary.confirmer }}</b> {{ t('confirmer','确认项') }}</span>
    <span class="chip"><span class="dot d-display"></span><b>{{ summary.display }}</b> {{ t('display-only','仅展示') }}</span>
    <span class="chip"><span class="dot d-killed"></span><b>{{ summary.killed }}</b> {{ t('killed (NO-GO)','已否决') }}</span>
    <span class="chip"><span class="dot d-pending"></span><b>{{ summary.pending }}</b> {{ t('pending','待接入') }}</span>
    {% if summary.factor_total %}
    <span class="chip {{ 'grave' if summary.factor_survivors == 0 }}">🧮 <b>{{ summary.factor_survivors }}</b>/{{ summary.factor_total }}
      {{ t('cross-sectional factors survive FDR','横截面因子通过 FDR') }}</span>
    {% endif %}
  </div>
</div>

{% if frontier_rows %}
<div class="panel">
  <div class="tierhead">
    <span class="dot d-pending" style="align-self:center"></span>
    <h2>{{ t('Research frontier — hypotheses, not verdicts','研究前沿 — 假设，不是结论') }}</h2>
    <span class="bl">{{ t(
      'Candidates worth testing next. None of these affect a score until a pre-registered Phase-0 run earns a normal Signal Lab row.',
      '下一批值得测试的候选。除非预注册 Phase-0 运行让它获得正常 Signal Lab 条目，否则不会影响任何分数。') }}</span>
  </div>
  <p class="frontier-note">{{ t(
    'The search is data-first: borrow pressure, FTDs, option-informed flow, EDGAR attention, auction absorption, positioning exhaustion, and time-of-day market microstructure.',
    '这轮搜索以数据为先：借券压力、交割失败、期权知情流、EDGAR 关注、拍卖吸收、仓位耗尽与日内/隔夜微结构。') }}</p>
  {%- if frontier_phase0_summary %}
  <p class="frontier-note">{{ t(
    'Expanded docket (60 candidates) adjudicated 2026-07-06: 9 authorized for testing (' ~ frontier_phase0_summary.build_count ~ ' build / ' ~ frontier_phase0_summary.probe_count ~ ' probe / ' ~ frontier_phase0_summary.pilot_count ~ ' pilot), 11 killed. See ',
    '扩展清单（60个候选）于2026-07-06完成裁决：9个授权测试（' ~ frontier_phase0_summary.build_count ~ ' 构建 / ' ~ frontier_phase0_summary.probe_count ~ ' 探针 / ' ~ frontier_phase0_summary.pilot_count ~ ' 试点），11个已否决。详见 ') }}<a href="/research/SIGNAL_LAB_FRONTIER_FABLE_ADJUDICATION_2026-07-06.md" style="font-size:inherit">research/SIGNAL_LAB_FRONTIER_FABLE_ADJUDICATION_2026-07-06.md</a>.</p>
  {%- endif %}
  {%- if waves_adjudication and waves_adjudication.waves %}
  <div class="frontier-note" style="border-left:3px solid var(--line);padding-left:10px;margin-top:10px">
    <strong>{{ t('Waves 2–4 adjudicated 2026-07-06','第2–4波 2026-07-06裁决') }}:</strong>
    {%- for w in waves_adjudication.waves %}
    <span style="display:inline-block;margin:2px 8px 2px 0">
      <a href="/{{ w.doc }}" style="color:inherit;text-decoration:underline dotted">{{ t('W'~w.wave, 'W'~w.wave) }}</a>
      {{ t(w.screened~' screened / '~w.advanced~' advanced → '~w.result_label,
           w.screened~'筛选 / '~w.advanced~'候选 → '~w.result_label_zh) }};
    </span>
    {%- endfor %}
    {%- if waves_adjudication.moratorium %}
    <span style="color:var(--muted)">{{ t('generation moratorium in force until wave-1 + spike verdicts booked and queue &lt; 3','生成暂停令生效——第一波+尖峰候选裁决登记且排队数降至3以下前不启动新波次') }}.</span>
    {%- endif %}
  </div>
  {%- endif %}
  <div class="scroll"><table class="frontier-table">
    <thead><tr>
      <th>{{ t('Candidate','候选') }}</th>
      <th>{{ t('Thesis','论点') }}</th>
      <th>{{ t('Build path','接入路径') }}</th>
      <th>{{ t('First gate','第一道门') }}</th>
      <th>{{ t('Fable ruling','Fable 裁决') }}</th>
    </tr></thead>
    <tbody>
    {%- for r in frontier_rows %}
      <tr>
        <td>
          <div class="sig">{{ t(r.name, r.name_zh) }}<span class="frontier-pri">{{ r.priority }}</span></div>
          <div class="mkt">{{ r.market }} · {{ t(r.readiness, r.readiness_zh) }}</div>
          <div class="src">{{ r.source }}</div>
        </td>
        <td class="road">{{ t(r.thesis, r.thesis_zh) }}</td>
        <td class="road">{{ t(r.build, r.build_zh) }}</td>
        <td class="gate">{{ t(r.gate, r.gate_zh) }}</td>
        <td>
          {%- set verdict = r.get('fable_verdict', 'PENDING') if r is mapping else 'PENDING' %}
          {%- set chip_map = {
            'KILLED': ('kill', '已否决', 'KILLED'),
            'ROUTED': ('route', '转入现有程序', 'ROUTED'),
            'ACCRUE': ('accrue', '前瞻累积', 'ACCRUE'),
            'QUEUED': ('queued', '排队', 'QUEUED'),
            'BUILD': ('build', '已授权测试', 'BUILD'),
            'PROBE': ('probe', '数据探针', 'PROBE'),
            'PILOT': ('pilot', '试点', 'PILOT'),
            'PENDING': ('pending', '待审', 'PENDING'),
            'TESTED-NULL': ('tested-null', '已测试—空', 'TESTED-NULL'),
            'TESTED-NULL(G3)': ('tested-null', '已测试—空(G3)', 'TESTED-NULL'),
            'TESTED-PASS': ('tested-pass', '已测试—通过', 'TESTED-PASS'),
            'TESTED-PARTIAL': ('tested-partial', '已测试—部分', 'TESTED-PARTIAL'),
            'TESTED-ACCRUE': ('tested-accrue', '已测试—累积', 'TESTED-ACCRUE'),
            'ACCRUE-CONFIRMED': ('accrue', '累积已确认', 'ACCRUE-CONFIRMED'),
          } %}
          {%- set cdata = chip_map.get(verdict, ('pending', '待审', verdict)) %}
          <span class="fable-chip {{ cdata[0] }}">{{ t(cdata[2], cdata[1]) }}</span>
        </td>
      </tr>
    {%- endfor %}
    </tbody>
  </table></div>
</div>
{% endif %}

<div class="panel ctl">
  <input id="slq" type="search" autocomplete="off"
    placeholder="Filter signals — name, market, rationale…" data-ph-zh="筛选信号 — 名称、市场、说明…">
  <select id="slmkt" aria-label="market"><option value="">All markets · 全部市场</option></select>
  <div class="tier-tog-wrap">
    {% for tk in ['scored','confirmer','display','killed'] %}
    <label><input type="checkbox" class="sltier" data-tier="{{ tk }}" checked>
      <span class="dot d-{{ tk }}"></span>{{ t(tk, {'scored':'已计分','confirmer':'确认项','display':'仅展示','killed':'已否决'}[tk]) }}</label>
    {% endfor %}
  </div>
  <span id="slcount" class="muted sm" style="margin-left:auto"></span>
</div>

{% if factor_rows %}
{% set surv = factor_survivors or [] %}
{% set snames = [] %}
{% for s in surv %}{% set _ = snames.append(s.name ~ ' (' ~ ('+' if (s.ic or 0) > 0 else '−') ~ ')') %}{% endfor %}
<div class="panel {{ 'grave' if not surv }}">
  <div class="tierhead">
    <h2>🧮 {{ t('US equity factor cross-section — leak-free, point-in-time','美股因子横截面 — 无泄漏、时点') }}</h2>
    <span class="bl">{{ t(
      'The honest centerpiece. Quarterly cross-sectional rank-IC of each factor z-score vs the '
      ~ (factor_meta.horizon_d or 63) ~ 'd forward return, fully point-in-time (EDGAR + prices '
      'truncated to as-of), over ' ~ (factor_meta.span or '—') ~ ' (' ~ (factor_meta.rebalances or 0) ~ ' quarters). '
      ~ ('After the PIT fix, NONE survive Benjamini-Hochberg FDR at 10% — exactly the cost of refusing to look ahead.'
         if not surv else
         ('Only ' ~ (snames|join(', ')) ~ ' survive BH-FDR at 10% — and mind the IC sign: a survivor with a NEGATIVE IC is anti-predictive, not tradeable.'))
      ~ (' This is the DEEP-history re-test: the price panel is survivorship-biased (delisted names absent → an optimistic bound), so a lone, marginal survivor is shown — not promoted to a scored leg. SUE, the shallow-2023-2025 survivor, collapses to IC≈0 here — the data-level reason it was demoted.' if factor_meta.survivorship_biased else ''),
      '诚实的核心。每个因子 z 分对 ' ~ (factor_meta.horizon_d or 63) ~ '日前瞻收益的季度横截面秩相关 IC，完全时点（EDGAR 与价格截断至当时），区间 ' ~ (factor_meta.span or '—') ~ '（' ~ (factor_meta.rebalances or 0) ~ ' 个季度）。'
      ~ ('时点修正后，无一通过 10% 的 Benjamini-Hochberg FDR — 这正是拒绝前视的代价。'
         if not surv else
         ('仅 ' ~ (snames|join(', ')) ~ ' 通过 10% 的 BH-FDR — 注意 IC 符号：负 IC 的“通过者”是反预测，不可交易。'))
      ~ ('这是深度历史复检：价格面板含幸存者偏差（已退市名缺失 → 乐观上界），故仅展示个别勉强通过者，并不据此计分。浅窗口（2023-2025）的幸存者 SUE 在此崩塌至 IC≈0 — 这正是其被降级的数据层面原因。' if factor_meta.survivorship_biased else '')) }}</span>
  </div>
  <div class="scroll"><table>
    <thead><tr>
      <th>{{ t('Factor','因子') }}</th>
      <th class="r">{{ t('mean IC','平均 IC') }}{{ help('Cross-sectional rank correlation of the factor z-score with the forward return, averaged over rebalances. Judge vs ~0.','因子 z 分与前瞻收益的横截面秩相关，按调仓平均。对比 ~0 判断。') }}</th>
      <th class="r">{{ t('IC-IR','IC 信息比') }}</th>
      <th class="r">{{ t('HAC t','HAC t') }}{{ help('Newey-West t-stat of the IC series — corrects for the autocorrelation that overlapping forward windows create. |t|>~2 is the usual bar.','IC 序列的 Newey-West t 值，校正重叠前瞻窗口造成的自相关。通常门槛 |t|>~2。') }}</th>
      <th class="r">{{ t('FDR q','FDR q') }}{{ help('Benjamini-Hochberg q across the whole factor panel — the false-discovery rate if you call this factor real. <0.10 = survives.','整组因子的 Benjamini-Hochberg q — 若判定该因子为真的错误发现率。<0.10 = 通过。') }}</th>
      <th class="r">{{ t('hit','命中') }}</th>
      <th class="r">n</th>
      <th class="r">{{ t('survives?','通过？') }}</th>
    </tr></thead>
    <tbody>
    {% for r in factor_rows %}
      <tr>
        <td class="sig">{{ t(r.name, r.name_zh) }}</td>
        <td class="r {{ 'pos' if (r.ic or 0) > 0 else 'neg' }}">{{ num(r.ic, 4, plus=True) }}</td>
        <td class="r">{{ num(r.ic_ir, 3, plus=True) }}</td>
        <td class="r">{{ num(r.t_hac, 2, plus=True) }}</td>
        <td class="r">{{ num(r.q_fdr, 3) }}</td>
        <td class="r">{{ pct(r.hit) }}</td>
        <td class="r">{{ r.n if r.n is not none else '—' }}</td>
        <td class="r">{% if r.survives %}<span class="yes">✓</span>{% else %}<span class="no">✗</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% if factor_meta.collinearity %}
  <p class="extra" style="margin-top:8px">{{ t(
    'Collinearity: mean |corr| ' ~ factor_meta.collinearity.mean_abs_corr_raw ~ ' raw → '
    ~ factor_meta.collinearity.mean_abs_corr_orth ~ ' after Löwdin orthogonalisation. '
    ~ ('Span ' ~ factor_meta.span ~ ' · ' ~ factor_meta.rebalances ~ ' rebalances · ~'
       ~ factor_meta.median_universe ~ ' names.'),
    '共线性：平均 |corr| ' ~ factor_meta.collinearity.mean_abs_corr_raw ~ ' 原始 → '
    ~ factor_meta.collinearity.mean_abs_corr_orth ~ ' 经 Löwdin 正交化后。'
    ~ ('区间 ' ~ factor_meta.span ~ ' · ' ~ factor_meta.rebalances ~ ' 次调仓 · ~'
       ~ factor_meta.median_universe ~ ' 只。')) }}</p>
  {% endif %}
</div>
{% endif %}

{% for tier in tiers %}
<div class="panel tier-panel {{ 'win' if tier.key=='scored' else ('grave' if tier.key=='killed') }}">
  <div class="tierhead">
    <span class="dot d-{{ tier.key }}" style="align-self:center"></span>
    <h2>{{ t(tier.label, tier.label_zh) }} · {{ tier.count }}</h2>
    <span class="bl">{{ t(tier.blurb, tier.blurb_zh) }}</span>
  </div>
  {% if tier.key == 'confirmer' %}
  <p class="ovl-note">{{ t(
    'Read these as a RISK-OVERLAY LAYER, not standalone buys: each has a measured forward edge '
    '(mostly drawdown-reduction or regime context) but is dominated by a simpler rule (often a plain '
    '200-day moving average) or is too sample-thin to size alone. Use them to confirm or temper the '
    'scored signals — not to trade on their own.',
    '把这些当作风险叠加层，而非独立买入信号：每个都有可测的前瞻边际（多为回撤削减或体制背景），'
    '但被更简单的规则（常是朴素的200日均线）压制，或样本过薄不宜单独定仓。用来确认或缓和已计分信号，而非单独交易。') }}</p>
  {% endif %}
  <div class="scroll"><table class="sl-table">
    <thead><tr>
      <th>{{ t('Signal','信号') }}</th>
      <th class="r">IC</th>
      <th class="r">HAC t</th>
      <th class="r">FDR q</th>
      <th class="r">DSR{{ help('Deflated Sharpe (López de Prado): probability the true Sharpe > 0 after haircutting for the number of trials, skew and kurtosis. >0.90 is our bar.','去偏夏普（López de Prado）：在按试验次数、偏度与峰度打折后，真实夏普 >0 的概率。门槛 >0.90。') }}</th>
      <th class="r">{{ t('Sharpe','夏普') }}</th>
      <th class="r">{{ t('hit','命中') }}</th>
      <th class="r">n</th>
      <th>{{ t('Verdict','结论') }}</th>
      <th>{{ t('Why','原因') }}</th>
    </tr></thead>
    <tbody>
    {% for r in tier.rows %}
      <tr class="sl-row" data-tier="{{ tier.key }}" data-mkt="{{ r.market }}"
          data-text="{{ (r.name ~ ' ' ~ r.name_zh ~ ' ' ~ r.market ~ ' ' ~ r.why)|replace('"','')|lower }}">
        <td>
          <div class="sig">{{ t(r.name, r.name_zh) }}
            {% if r.fdr_survivor %}<span class="yes" title="survives FDR">✓FDR</span>{% endif %}</div>
          <div class="mkt">{{ r.market }}{% if r.horizon %} · {{ r.horizon }}{% endif %}{% if r.wired %} · {{ r.wired }}{% endif %}</div>
          {% if r.extra %}<div class="extra">{% for lbl, val in r.extra %}{{ lbl }} {{ val }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
        </td>
        <td class="r {{ 'pos' if (r.ic or 0) > 0 else ('neg' if r.ic is not none and r.ic < 0) }}">{{ num(r.ic, 4, plus=True) }}</td>
        <td class="r">{{ num(r.t_hac, 2, plus=True) }}</td>
        <td class="r {{ 'yes' if (r.q_fdr is not none and r.q_fdr < 0.10) }}">{{ num(r.q_fdr, 3) }}</td>
        <td class="r {{ 'yes' if (r.dsr is not none and r.dsr >= 0.90) else ('neg' if r.dsr is not none) }}">{{ num(r.dsr, 3) }}</td>
        <td class="r {{ 'pos' if (r.sharpe or 0) > 0 else ('neg' if r.sharpe is not none and r.sharpe < 0) }}">{{ num(r.sharpe, 2, plus=True) }}</td>
        <td class="r">{{ pct(r.hit) }}</td>
        <td class="r">{{ r.n if r.n is not none else '—' }}</td>
        <td><span class="pill v-{{ tier.key }}">{{ t(tier.verdict_word, tier.verdict_word_zh) }}</span></td>
        <td style="max-width:34ch">
          <span class="muted sm">{{ t(r.why[:120] ~ ('…' if r.why|length > 120 else ''),
                                      r.why_zh[:80] ~ ('…' if r.why_zh|length > 80 else '')) }}</span>
          {{ help(r.why ~ '  [' ~ r.source ~ ']', r.why_zh ~ '  [' ~ r.source ~ ']') }}
          <div class="src">{{ r.source }}</div>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
</div>
{% endfor %}

<div class="panel">
  <details class="method">
    <summary>{{ t('How to read this page — the metrics, in plain language','如何阅读本页 — 指标的通俗解释') }}</summary>
    <dl>
      <dt>{{ t('Information Coefficient (IC)','信息系数 (IC)') }}</dt>
      <dd>{{ t('The cross-sectional rank correlation between a signal and the forward return. ~0 means no edge; an IC of 0.03 is a real, if modest, equity-factor edge.','信号与前瞻收益的横截面秩相关。~0 表示无边际；IC 0.03 已是真实但温和的股票因子边际。') }}</dd>
      <dt>{{ t('Newey-West (HAC) t-stat','Newey-West (HAC) t 值') }}</dt>
      <dd>{{ t('Is the average IC distinguishable from zero, AFTER correcting for the autocorrelation that overlapping forward windows create? Naive t-stats overstate significance here.','在校正重叠前瞻窗口造成的自相关后，平均 IC 是否显著不为零？朴素 t 值在此会高估显著性。') }}</dd>
      <dt>{{ t('Benjamini-Hochberg FDR q','Benjamini-Hochberg FDR q') }}</dt>
      <dd>{{ t('If you test many ideas, some will look good by luck. The FDR q controls the false-discovery rate across the whole panel. q<0.10 = survives. Most of our factors do NOT — and we show it.','若测试很多想法，总有些靠运气好看。FDR q 控制整组的错误发现率。q<0.10 = 通过。我们多数因子并未通过 — 我们如实展示。') }}</dd>
      <dt>{{ t('Deflated Sharpe (DSR)','去偏夏普 (DSR)') }}</dt>
      <dd>{{ t('A Sharpe ratio haircut for the number of strategies tried, plus return skew/kurtosis (López de Prado). It is the probability the true Sharpe is positive. Our bar is 0.90 — a backtest Sharpe that looks great but has DSR<0.90 is treated as luck.','按尝试的策略数量及收益偏度/峰度对夏普打折（López de Prado）。它是真实夏普为正的概率。门槛 0.90 — 回测夏普好看但 DSR<0.90 的，按运气处理。') }}</dd>
      <dt>{{ t('Point-in-time (leak-free)','时点（无泄漏）') }}</dt>
      <dd>{{ t('Fundamentals are stamped at period-end + reporting lag; index membership is reconstructed as it was on each date; indicators are shifted so a backtest only ever sees what was knowable then. This is why the spreads are honestly weaker than a naive backtest.','基本面以“期末+披露滞后”打戳；指数成分按当日实际重建；指标移位，使回测只看到当时可知的信息。这正是价差诚实地弱于朴素回测的原因。') }}</dd>
    </dl>
  </details>
</div>

<div class="panel">
  <p class="muted sm" style="margin:0">{{ t(
     'Validation toolkit: engine/validation.py (deflated Sharpe, purged k-fold + embargo, block '
     'bootstrap, Newey-West HAC, Benjamini-Hochberg FDR, Brier/Platt calibration, cost-aware '
     'backtest). Verdicts are quoted from the named reports in reports/. The factor cross-section '
     'reads live from data/edgar/ic_scorecard.json.',
     '验证工具：engine/validation.py（去偏夏普、净化 k 折+隔离、分块自助、Newey-West HAC、'
     'Benjamini-Hochberg FDR、Brier/Platt 校准、含成本回测）。结论引自 reports/ 中具名报告；'
     '因子横截面实时读取 data/edgar/ic_scorecard.json。') }}</p>
  <p class="src" style="margin:8px 0 0">
    {{ t('data span','数据区间') }} {{ factor_meta.span or '—' }} ·
    {{ t('dashboard updated','仪表盘更新') }} {{ generated_utc }} UTC ·
    {{ t('rendered','生成') }} {{ generated_utc }} UTC</p>
</div>

<script src="theme.js"></script>
<script>
(function(){
  var rows = Array.prototype.slice.call(document.querySelectorAll('tr.sl-row'));
  if(!rows.length) return;
  var q = document.getElementById('slq'), mkt = document.getElementById('slmkt'),
      tierBoxes = Array.prototype.slice.call(document.querySelectorAll('.sltier')),
      countEl = document.getElementById('slcount'),
      panels = Array.prototype.slice.call(document.querySelectorAll('.tier-panel'));
  var seen = {};
  rows.forEach(function(r){ if(r.dataset.mkt) seen[r.dataset.mkt]=1; });
  Object.keys(seen).sort().forEach(function(m){
    var o=document.createElement('option'); o.value=m; o.textContent=m; mkt.appendChild(o);
  });
  function apply(){
    var term=(q.value||'').trim().toLowerCase(), m=mkt.value, on={};
    tierBoxes.forEach(function(b){ if(b.checked) on[b.dataset.tier]=1; });
    var vis=0;
    rows.forEach(function(r){
      var show = on[r.dataset.tier] && (!m || r.dataset.mkt===m) &&
                 (!term || (r.dataset.text||'').indexOf(term)>=0);
      r.style.display = show ? '' : 'none'; if(show) vis++;
    });
    panels.forEach(function(p){
      var any = Array.prototype.some.call(p.querySelectorAll('tr.sl-row'),
                  function(r){ return r.style.display!=='none'; });
      p.style.display = any ? '' : 'none';
    });
    if(countEl) countEl.textContent = vis + ' / ' + rows.length + ' shown';
  }
  q.addEventListener('input', apply);
  mkt.addEventListener('change', apply);
  tierBoxes.forEach(function(b){ b.addEventListener('change', apply); });
  function cellVal(tr, i){
    var td = tr.children[i]; if(!td) return '';
    var txt = td.textContent.trim().replace(/[%,]/g,'');
    if(txt==='' || txt==='—') return -Infinity;
    var n = parseFloat(txt);
    return isNaN(n) ? txt.toLowerCase() : n;
  }
  document.querySelectorAll('table.sl-table').forEach(function(tbl){
    var ths = tbl.querySelectorAll('thead th'), body = tbl.querySelector('tbody');
    ths.forEach(function(th, i){
      th.addEventListener('click', function(){
        var asc = !(th.dataset.dir==='asc'); th.dataset.dir = asc?'asc':'desc';
        ths.forEach(function(o){ o.classList.remove('sorted','asc'); });
        th.classList.add('sorted'); if(asc) th.classList.add('asc');
        var trs = Array.prototype.slice.call(body.querySelectorAll('tr'));
        trs.sort(function(a,b){
          var av=cellVal(a,i), bv=cellVal(b,i);
          if(av<bv) return asc?-1:1; if(av>bv) return asc?1:-1; return 0;
        });
        trs.forEach(function(tr){ body.appendChild(tr); });
      });
    });
  });
  apply();
})();
</script>
</body>
</html>
