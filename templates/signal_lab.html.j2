    <span class="bl">{{ t(tier.blurb, tier.blurb_zh) }}</span>
  </div>
  {% if tier.key == 'confirmer' %}
  <p class="ovl-note">{{ t(
    'Read these as a RISK-OVERLAY LAYER, not standalone buys: each has a measured forward edge '
    '(mostly drawdown-reduction or regime context) but is dominated by a simpler rule (often a plain '
    '200-day moving average) or is too sample-thin to size alone. Use them to confirm or temper the '
    'scored signals — not to trade on their own.',
    '把这些当作风险叠加层，而非独立买入信号：每个都有可测的前瞻边际（多为回撤削减或体制背景），'
    '但被更简单的规则（常是朴素的200日均线）压制，或样本过薄不宜单独定仓。用来确认或缓和已计分信号，而非单独交易。') }}</p>
  {% endif %}
  <div class="scroll"><table class="sl-table">
    <thead><tr>
      <th></th>
      <th>{{ t('Signal','信号') }}</th>
      <th class="r">IC</th>
      <th class="r">HAC t</th>
      <th class="r">FDR q</th>
      <th class="r">DSR{{ help('Deflated Sharpe (López de Prado): probability the true Sharpe > 0 after haircutting for the number of trials, skew and kurtosis. >0.90 is our bar.','去偏夏普（López de Prado）：在按试验次数、偏度与峰度打折后，真实夏普 >0 的概率。门槛 >0.90。') }}</th>
      <th class="r">{{ t('Sharpe','夏普') }}</th>
      <th class="r">{{ t('hit','命中') }}</th>
      <th class="r">n</th>
      <th>{{ t('Verdict','结论') }}</th>
      <th>{{ t('Why','原因') }}</th>
    </tr></thead>
    <tbody>
    {% for r in tier.rows %}
    {%- set row_id = 'sig-' ~ (r.slug or r.name|lower|replace(' ','-')) %}
      <tr class="sl-row" id="{{ row_id }}" data-tier="{{ tier.key }}" data-mkt="{{ r.market }}"
          data-text="{{ (r.name ~ ' ' ~ r.name_zh ~ ' ' ~ r.market ~ ' ' ~ r.why)|replace('"','')|lower }}">
        <td style="width:24px;text-align:center">
          <button class="row-expand-btn" data-target="{{ row_id }}-detail">⊕</button>
        </td>
        <td>
          <div class="sig">{{ t(r.name, r.name_zh) }}
            {% if r.fdr_survivor %}<span class="yes">✓FDR</span>{% endif %}
            <a class="anchor-link" href="#{{ row_id }}" title="anchor">¶</a>
          </div>
          <div class="mkt">{{ r.market }}{% if r.horizon %} · {{ r.horizon }}{% endif %}{% if r.wired %} · {{ r.wired }}{% endif %}</div>
          {# A6: structured extra chips #}
          {% if r.extra %}
          <div class="extra-chips">
            {% for lbl, val in r.extra %}
            <span class="extra-chip"><span class="el">{{ lbl }}</span><span>{{ val }}</span></span>
            {% endfor %}
          </div>
          {% endif %}
          {# A10: source refs audit — existence data available in r.source_refs for diagnostics;
               src-missing UI chip suppressed: source field uses citation shorthands (e.g.
               "insider-phase0/1.md", "spvector-phase1/2/3-audit/pit.md") that are not
               repo-relative file paths, producing false-alarm red chips on well-sourced
               signals. The audit remains in engine for structured tracking. #}
        </td>
        <td class="r {{ 'pos' if (r.ic or 0) > 0 else ('neg' if r.ic is not none and r.ic < 0) }}">{{ num(r.ic, 4, plus=True) }}</td>
        <td class="r">{{ num(r.t_hac, 2, plus=True) }}</td>
        <td class="r {{ 'yes' if (r.q_fdr is not none and r.q_fdr < 0.10) }}">{{ num(r.q_fdr, 3) }}</td>
        <td class="r {{ 'yes' if (r.dsr is not none and r.dsr >= 0.90) else ('neg' if r.dsr is not none) }}">
          {{ num(r.dsr, 3) }}
          {# A1: DSR provenance badge #}
          {%- if r.get('dsr_provenance') %}
          {%- set prov = r.dsr_provenance %}
          {%- if prov.basis == 'ledger' %}
          <span class="dsr-prov ledger">n={{ prov.n_trials }} ledger-live</span>
          {%- elif prov.basis == 'expired' %}
          <span class="dsr-prov expired">EXPIRED quote</span>
          {%- else %}
          <span class="dsr-prov frozen">frozen quote · exp {{ prov.get('expiry','?') }}</span>
          {%- endif %}
          {%- endif %}
        </td>
        <td class="r {{ 'pos' if (r.sharpe or 0) > 0 else ('neg' if r.sharpe is not none and r.sharpe < 0) }}">{{ num(r.sharpe, 2, plus=True) }}</td>
        <td class="r">{{ pct(r.hit) }}</td>
        <td class="r">{{ r.n if r.n is not none else '—' }}</td>
        <td><span class="pill v-{{ tier.key }}">{{ t(tier.verdict_word, tier.verdict_word_zh) }}</span></td>
        <td style="max-width:34ch">
          <span class="muted sm l-en">{{ r.why[:120] ~ ('…' if r.why|length > 120 else '') }}</span>
          <span class="muted sm l-zh">{{ r.why_zh[:80] ~ ('…' if r.why_zh|length > 80 else '') }}</span>
          <div class="src">{{ r.source }}</div>
        </td>
      </tr>
      {# A5: expandable detail row #}
      <tr class="row-detail" id="{{ row_id }}-detail">
        <td colspan="11">
          <div class="why-full l-en">{{ r.why }}</div>
          <div class="why-full l-zh">{{ r.why_zh }}</div>
          {# Structured extras in expanded view #}
          {% if r.extra %}
          <div class="extra-chips" style="margin-top:8px">
            {% for lbl, val in r.extra %}
            <span class="extra-chip"><span class="el">{{ lbl }}</span><span>{{ val }}</span></span>
            {% endfor %}
          </div>
          {% endif %}
          <div class="meta-row">
            {{ t('Source:','来源:') }} {{ r.source }}
            · <a href="#{{ row_id }}" class="anchor-link" style="opacity:1">¶ {{ t('anchor','锚点') }}</a>
            {% if r.wired %} · {{ t('Wired:','接线:') }} {{ r.wired }}{% endif %}
          </div>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
</div>
{% endfor %}

<div class="panel">
  <details class="method">
    <summary>{{ t('How to read this page — the metrics, in plain language','如何阅读本页 — 指标的通俗解释') }}</summary>
    <dl>
      <dt>{{ t('Information Coefficient (IC)','信息系数 (IC)') }}</dt>
      <dd>{{ t('The cross-sectional rank correlation between a signal and the forward return. ~0 means no edge; an IC of 0.03 is a real, if modest, equity-factor edge.','信号与前瞻收益的横截面秩相关。~0 表示无边际；IC 0.03 已是真实但温和的股票因子边际。') }}</dd>
      <dt>{{ t('Newey-West (HAC) t-stat','Newey-West (HAC) t 值') }}</dt>
      <dd>{{ t('Is the average IC distinguishable from zero, AFTER correcting for the autocorrelation that overlapping forward windows create? Naive t-stats overstate significance here.','在校正重叠前瞻窗口造成的自相关后，平均 IC 是否显著不为零？朴素 t 值在此会高估显著性。') }}</dd>
      <dt>{{ t('Benjamini-Hochberg FDR q','Benjamini-Hochberg FDR q') }}</dt>
      <dd>{{ t('If you test many ideas, some will look good by luck. The FDR q controls the false-discovery rate across the whole panel. q<0.10 = survives. Most of our factors do NOT — and we show it.','若测试很多想法，总有些靠运气好看。FDR q 控制整组的错误发现率。q<0.10 = 通过。我们多数因子并未通过 — 我们如实展示。') }}</dd>
      <dt>{{ t('Deflated Sharpe (DSR)','去偏夏普 (DSR)') }}</dt>
      <dd>{{ t('A Sharpe ratio haircut for the number of strategies tried, plus return skew/kurtosis (López de Prado). It is the probability the true Sharpe is positive. Our bar is 0.90 — a backtest Sharpe that looks great but has DSR<0.90 is treated as luck.','按尝试的策略数量及收益偏度/峰度对夏普打折（López de Prado）。它是真实夏普为正的概率。门槛 0.90 — 回测夏普好看但 DSR<0.90 的，按运气处理。') }}</dd>
      <dt>{{ t('Point-in-time (leak-free)','时点（无泄漏）') }}</dt>
      <dd>{{ t('Fundamentals are stamped at period-end + reporting lag; index membership is reconstructed as it was on each date; indicators are shifted so a backtest only ever sees what was knowable then. This is why the spreads are honestly weaker than a naive backtest.','基本面以"期末+披露滞后"打戳；指数成分按当日实际重建；指标移位，使回测只看到当时可知的信息。这正是价差诚实地弱于朴素回测的原因。') }}</dd>
      <dt>{{ t('DSR Provenance badge','DSR 溯源标记') }}</dt>
      <dd>{{ t(
        'The green [n=... ledger-live] badge means the DSR n_trials count is sourced live from the persistent Trial Ledger maintained by calibrate_* scripts. Grey [frozen quote - exp ...] means the n_trials was hardcoded pending re-derivation -- treat the DSR as an approximation. Red [EXPIRED quote] means the expiry date has passed without re-derivation.',
        '绿色 [n=... ledger-live] 标记表示 DSR 的试验次数从持久试验账本（由 calibrate_* 脚本维护）实时读取。灰色 [frozen quote - exp ...] 表示试验次数为硬编码值，待重新推导--DSR 应视为近似值。红色 [EXPIRED quote] 表示到期日已过但尚未重新推导。') }}</dd>
    </dl>
  </details>
</div>

<div class="panel">
  <p class="muted sm" style="margin:0">{{ t(
     'Validation toolkit: engine/validation.py (deflated Sharpe, purged k-fold + embargo, block '
     'bootstrap, Newey-West HAC, Benjamini-Hochberg FDR, Brier/Platt calibration, cost-aware '
     'backtest). Verdicts are quoted from the named reports in reports/. The factor cross-section '
     'reads live from data/edgar/ic_scorecard.json.',
     '验证工具：engine/validation.py（去偏夏普、净化 k 折+隔离、分块自助、Newey-West HAC、'
     'Benjamini-Hochberg FDR、Brier/Platt 校准、含成本回测）。结论引自 reports/ 中具名报告；'
     '因子横截面实时读取 data/edgar/ic_scorecard.json。') }}</p>
  <p class="src" style="margin:8px 0 0">
    {{ t('data span','数据区间') }} {{ factor_meta.span or '—' }} ·
    {{ t('dashboard updated','仪表盘更新') }} {{ generated_utc }} UTC ·
    {{ t('rendered','生成') }} {{ generated_utc }} UTC</p>
</div>

<script src="theme.js"></script>
<script>
(function(){
  /* ---- A11: localStorage filter persistence ---- */
  var LS_KEY = 'sl_filters';
  function saveFilters(){
    try{
      var on=[];
      document.querySelectorAll('.sltier').forEach(function(b){ if(b.checked) on.push(b.dataset.tier); });
      localStorage.setItem(LS_KEY, JSON.stringify({
        q: (document.getElementById('slq')||{}).value||'',
        mkt: (document.getElementById('slmkt')||{}).value||'',
        tiers: on
      }));
    }catch(e){}
  }
  function loadFilters(){
    try{
      var s = localStorage.getItem(LS_KEY);
      if(!s) return false;
      var f = JSON.parse(s);
      if(f.q && document.getElementById('slq')) document.getElementById('slq').value=f.q;
      if(f.mkt && document.getElementById('slmkt')) document.getElementById('slmkt').value=f.mkt;
      if(Array.isArray(f.tiers)){
        document.querySelectorAll('.sltier').forEach(function(b){
          b.checked = f.tiers.indexOf(b.dataset.tier)>=0;
        });
      }
      return true;
    }catch(e){ return false; }
  }

  /* ---- Main registry filter ---- */
  var rows = Array.prototype.slice.call(document.querySelectorAll('tr.sl-row'));
  if(!rows.length) return;
  var q = document.getElementById('slq'), mkt = document.getElementById('slmkt'),
      tierBoxes = Array.prototype.slice.call(document.querySelectorAll('.sltier')),
      countEl = document.getElementById('slcount'), resetEl = document.getElementById('slreset'),
      panels = Array.prototype.slice.call(document.querySelectorAll('.tier-panel'));
  var seen = {};
  rows.forEach(function(r){ if(r.dataset.mkt) seen[r.dataset.mkt]=1; });
  Object.keys(seen).sort().forEach(function(m){
    var o=document.createElement('option'); o.value=m; o.textContent=m; mkt.appendChild(o);
  });
  function isDefault(){
    if((q&&q.value)||''!=='') return false;
    if((mkt&&mkt.value)||''!=='') return false;
    return !tierBoxes.some(function(b){ return !b.checked; });
  }
  function apply(){
    var term=(q&&q.value||'').trim().toLowerCase(), m=mkt?mkt.value:'', on={};
    tierBoxes.forEach(function(b){ if(b.checked) on[b.dataset.tier]=1; });
    var vis=0;
    rows.forEach(function(r){
      var show = on[r.dataset.tier] && (!m || r.dataset.mkt===m) &&
                 (!term || (r.dataset.text||'').indexOf(term)>=0);
      r.style.display = show ? '' : 'none';
      /* A5: hide detail row of hidden main rows */
      var det = document.getElementById(r.id+'-detail');
      if(det && !show){ det.classList.remove('open'); det.style.display='none'; }
      if(show) vis++;
    });
    panels.forEach(function(p){
      var any = Array.prototype.some.call(p.querySelectorAll('tr.sl-row'),
                  function(r){ return r.style.display!=='none'; });
      p.style.display = any ? '' : 'none';
    });
    if(countEl) countEl.textContent = vis + ' / ' + rows.length + ' shown · ' + '{{ t("total","合计") }}';
    if(resetEl) resetEl.style.display = isDefault() ? 'none' : '';
    saveFilters();
  }
  /* A11: restore on load */
  loadFilters();
  if(q) q.addEventListener('input', apply);
  if(mkt) mkt.addEventListener('change', apply);
  tierBoxes.forEach(function(b){ b.addEventListener('change', apply); });
  if(resetEl) resetEl.addEventListener('click', function(){
    if(q) q.value='';
    if(mkt) mkt.value='';
    tierBoxes.forEach(function(b){ b.checked=true; });
    try{ localStorage.removeItem(LS_KEY); }catch(e){}
    apply();
  });

  /* ---- A5: row expand/collapse ---- */
  document.querySelectorAll('.row-expand-btn').forEach(function(btn){
    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var targetId = btn.dataset.target;
      var det = document.getElementById(targetId);
      if(!det) return;
      var open = det.classList.toggle('open');
      btn.textContent = open ? '⊖' : '⊕';
      det.style.display = open ? 'table-row' : 'none';
    });
  });

  /* ---- A8: anchor navigation + hash expand ---- */
  document.querySelectorAll('.anchor-link[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      var hash = a.getAttribute('href');
      history.pushState(null,'',hash);
      /* Don't auto-expand on ¶ click — user controls expand */
    });
  });
  function handleHash(){
    var hash = location.hash;
    if(!hash) return;
    var id = hash.slice(1);
    var row = document.getElementById(id);
    if(!row) return;
    /* Expand the detail row */
    var det = document.getElementById(id+'-detail');
    var btn = row.querySelector('.row-expand-btn');
    if(det && !det.classList.contains('open')){
      det.classList.add('open'); det.style.display='table-row';
      if(btn) btn.textContent='⊖';
    }
    setTimeout(function(){ row.scrollIntoView({behavior:'smooth',block:'center'}); }, 80);
  }
  handleHash();
  window.addEventListener('hashchange', handleHash);

  /* ---- Column sort (sl-table) ---- */
  function cellVal(tr, i){
    var td = tr.children[i]; if(!td) return '';
    var txt = td.textContent.trim().replace(/[%,]/g,'');
    if(txt==='' || txt==='—') return -Infinity;
    var n = parseFloat(txt);
    return isNaN(n) ? txt.toLowerCase() : n;
  }
  document.querySelectorAll('table.sl-table').forEach(function(tbl){
    var ths = tbl.querySelectorAll('thead th'), body = tbl.querySelector('tbody');
    ths.forEach(function(th, i){
      th.addEventListener('click', function(){
        var asc = !(th.dataset.dir==='asc'); th.dataset.dir = asc?'asc':'desc';
        ths.forEach(function(o){ o.classList.remove('sorted','asc'); });
        th.classList.add('sorted'); if(asc) th.classList.add('asc');
        /* Sort only main rows; keep detail rows paired with their main row */
        var mainRows = Array.prototype.slice.call(body.querySelectorAll('tr.sl-row'));
        mainRows.sort(function(a,b){
          var av=cellVal(a,i), bv=cellVal(b,i);
          if(av<bv) return asc?-1:1; if(av>bv) return asc?1:-1; return 0;
        });
        mainRows.forEach(function(tr){
          body.appendChild(tr);
          var det = document.getElementById(tr.id+'-detail');
          if(det) body.appendChild(det);
        });
      });
    });
  });

  /* ---- A4: frontier table filter ---- */
  var frows = Array.prototype.slice.call(document.querySelectorAll('tr.fr-row'));
  var fq = document.getElementById('fq'), fmkt = document.getElementById('fmkt'),
      fcount = document.getElementById('fcount');
  if(frows.length && fmkt){
    var fseen={};
    frows.forEach(function(r){ if(r.dataset.mkt) fseen[r.dataset.mkt]=1; });
    Object.keys(fseen).sort().forEach(function(m){
      var o=document.createElement('option'); o.value=m; o.textContent=m; fmkt.appendChild(o);
    });
    function fapply(){
      var term=(fq&&fq.value||'').trim().toLowerCase(), m=fmkt?fmkt.value:'', vis=0;
      frows.forEach(function(r){
        var show=(!m||r.dataset.mkt===m)&&(!term||(r.dataset.text||'').indexOf(term)>=0);
        r.style.display=show?'':'none'; if(show) vis++;
      });
      if(fcount) fcount.textContent=vis+' / '+frows.length;
    }
    if(fq) fq.addEventListener('input',fapply);
    if(fmkt) fmkt.addEventListener('change',fapply);
    fapply();
  }

  apply();

  // D2: Signal Foundry row expander
  function sfToggle(id){
    var row=document.getElementById(id);
    if(!row) return;
    var open=row.classList.toggle('open');
    var btn=row.previousElementSibling&&row.previousElementSibling.querySelector('.sf-row-btn');
    if(btn) btn.textContent=open?'▾':'▸';
  }
  // Make sfToggle globally accessible (called inline onclick)
  window.sfToggle=sfToggle;
})();
</script>
</body>
</html>
