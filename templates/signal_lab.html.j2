      <td class="mkt">{{ r.market }}</td>
      <td><span class="mkt">{{ r.status }}</span></td>
      <td>
        {%- if v %}<span class="{{ vpill }}">{{ t(vlabel_en, vlabel_zh) }}</span>{%- else %}<span class="muted">—</span>{%- endif %}
