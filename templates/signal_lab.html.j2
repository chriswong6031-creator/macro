      {%- set vlabel_en = 'null' %}
      {%- set vlabel_zh = '空结果' %}
    {%- elif v == 'era_specific' %}
      {%- set vpill = 'sf-v sf-v-era' %}
      {%- set vlabel_en = 'era_specific' %}
      {%- set vlabel_zh = '时代特定' %}
