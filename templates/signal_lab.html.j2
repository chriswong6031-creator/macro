{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro num(v, nd=2, plus=False) -%}
{%- if v is none -%}<span class="muted">—</span>{%- elif plus -%}{{ ('%+.'~nd~'f')|format(v) }}{%- else -%}{{ ('%.'~nd~'f')|format(v) }}{%- endif -%}
{%- endmacro %}
{% macro pct(v) -%}
{%- if v is none -%}<span class="muted">—</span>{%- else -%}{{ '%.0f%%'|format(v*100) }}{%- endif -%}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
