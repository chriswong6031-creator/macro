{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(navigator.language||'').slice(0,2);if(l==='zh')document.documentElement.setAttribute('data-lang','zh');}catch(e){}</script>
<title>BioCatalyst Intelligence — Trial Intelligence Workspace — MastermindX</title>
{% set seo_title = "BioCatalyst Intelligence — Trial Intelligence Workspace — MastermindX" %}
{% set seo_desc = "A focused trial-intelligence workspace for registry-recorded milestones and exact registry field updates alongside the current ClinicalTrials.gov record." %}
{% set seo_path = "biocatalyst.html" %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="biocatalyst.css">
</head>
<body class="bci-page">
{% set nav_search_placeholder_en = "Search any stock — US, China, HK, Canada & more…" %}
{% set nav_search_placeholder_zh = "搜索任意股票 — 美股、A 股、港股、加股等…" %}
{% include "_site_nav.html.j2" %}

<main class="bci-workspace" id="bci-workspace" data-state="loading">
  <header class="bci-hero">
    <div class="bci-hero-copy">
      <p class="bci-eyebrow"><span class="bci-pulse" aria-hidden="true"></span>{{ t('BioCatalyst Intelligence', 'BioCatalyst Intelligence') }}</p>
      <h1>{{ t('Trial Intelligence Workspace', '试验智能工作台') }}</h1>
      <p class="bci-deck">{{ t('Screen the register, compare the trials you choose, and read exactly what changed — with the source record one click away.', '筛选登记库、对照你选定的试验、查看究竟改了什么——来源记录一键可达。') }}</p>
    </div>
    <div class="bci-run-status" aria-live="polite">
      <span class="bci-status-dot" aria-hidden="true"></span>
      <div>
        <span class="bci-status-label" id="bci-status-label">{{ t('Connecting to the registry', '正在连接登记库') }}</span>
        <span class="bci-status-detail" id="bci-status-detail">{{ t('No records are in this page shell', '此页面外壳不含记录') }}</span>
      </div>
      <button class="bci-refresh" id="bci-refresh" type="button" aria-label="Refresh trial intelligence" data-label-en="Refresh trial intelligence" data-label-zh="刷新试验智能">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16.7 8.6A6.9 6.9 0 1 0 17 12"/><path d="M16.7 3.8v4.8h-4.8"/></svg>
        <span class="l-en">Refresh</span><span class="l-zh">刷新</span>
      </button>
    </div>
  </header>

  <section class="bci-information" aria-label="Clinical trial workspace">
    <aside class="bci-filter-pane" aria-labelledby="bci-filter-title">
      <div class="bci-pane-head">
        <p class="bci-kicker">{{ t('Browse the register', '浏览登记库') }}</p>
        <h2 id="bci-filter-title">{{ t('Monitor controls', '监测控制') }}</h2>
      </div>
      <div class="bci-mode-control" id="bci-mode-control" role="tablist" aria-label="Trial intelligence view" data-label-en="Trial intelligence view" data-label-zh="试验智能视图">
        <button id="bci-mode-milestones" class="bci-mode is-active" type="button" role="tab" aria-selected="true" aria-controls="bci-queue-pane" tabindex="0" data-mode="milestones" data-label-en="Catalyst Radar — Trial Milestones" data-label-zh="催化雷达 — 试验里程碑">
          <span class="l-en">Catalyst Radar — Trial Milestones</span><span class="l-zh">催化雷达 — 试验里程碑</span>
        </button>
        <button id="bci-mode-screen" class="bci-mode" type="button" role="tab" aria-selected="false" aria-controls="bci-queue-pane" tabindex="-1" data-mode="screen" data-label-en="Trial Screen" data-label-zh="试验筛选">
          <span class="l-en">Trial Screen</span><span class="l-zh">试验筛选</span>
        </button>
        <button id="bci-mode-peers" class="bci-mode" type="button" role="tab" aria-selected="false" aria-controls="bci-queue-pane" tabindex="-1" data-mode="peers" data-label-en="Peer Matrix" data-label-zh="方案对照">
          <span class="l-en">Peer Matrix</span><span class="l-zh">方案对照</span>
        </button>
        <button id="bci-mode-changes" class="bci-mode" type="button" role="tab" aria-selected="false" aria-controls="bci-queue-pane" tabindex="-1" data-mode="changes" data-label-en="Change Tape" data-label-zh="变更记录">
          <span class="l-en">Change Tape</span><span class="l-zh">变更记录</span>
        </button>
        <button id="bci-mode-prospective" class="bci-mode bci-mode-prospective" type="button" role="tab" aria-selected="false" aria-controls="bci-queue-pane" tabindex="-1" data-mode="prospective" data-label-en="First-seen Tape" data-label-zh="首次观测记录">
          <span class="l-en">First-seen Tape</span><span class="l-zh">首次观测记录</span>
        </button>
      </div>
      <div class="bci-facets" id="bci-facets" hidden aria-live="polite"></div>
      <fieldset class="bci-window-control" id="bci-window-control">
        <legend class="bci-control-label" id="bci-window-label">{{ t('Record window', '记录窗口') }}</legend>
        <div class="bci-window-options" role="radiogroup" aria-label="Registry date window" data-label-en="Registry date window" data-label-zh="登记日期窗口">
          <button type="button" class="bci-window" role="radio" aria-checked="false" data-window="30" data-label-en="30 days" data-label-zh="30天">30</button>
          <button type="button" class="bci-window is-active" role="radio" aria-checked="true" data-window="90" data-label-en="90 days" data-label-zh="90天">90</button>
          <button type="button" class="bci-window" role="radio" aria-checked="false" data-window="180" data-label-en="180 days" data-label-zh="180天">180</button>
          <button type="button" class="bci-window" role="radio" aria-checked="false" data-window="all" data-label-en="All recorded" data-label-zh="全部记录">{{ t('All', '全部') }}</button>
        </div>
      </fieldset>
      <label class="bci-control" id="bci-field-control" for="bci-field-filter">
        <span class="bci-control-label">{{ t('Registry date', '登记日期') }}</span>
        <select id="bci-field-filter">
          <option value="all" data-label-en="All milestones" data-label-zh="全部里程碑" selected>All milestones</option>
          <option value="primary_completion" data-label-en="Primary completion" data-label-zh="主要完成">Primary completion</option>
          <option value="completion" data-label-en="Study completion" data-label-zh="研究完成">Study completion</option>
        </select>
      </label>
      <label class="bci-control" id="bci-change-kind-control" for="bci-change-kind-filter" hidden>
        <span class="bci-control-label" id="bci-change-kind-label">{{ t('Updated field', '更新字段') }}</span>
        <select id="bci-change-kind-filter" aria-label="Updated field" data-label-en="Updated field" data-label-zh="更新字段"></select>
      </label>
      <label class="bci-control" id="bci-review-control" for="bci-review-filter" hidden>
        <span class="bci-control-label">{{ t('Review state', '核对状态') }}</span>
        <select id="bci-review-filter" aria-label="Review state" data-label-en="Review state" data-label-zh="核对状态">
          <option value="all" data-label-en="Any" data-label-zh="不限" selected>Any</option>
          <option value="not_required" data-label-en="Checked" data-label-zh="已核对">Checked</option>
          <option value="needs_review" data-label-en="Needs review" data-label-zh="待核对">Needs review</option>
        </select>
      </label>
      <label class="bci-search" for="bci-search">
        <span class="bci-control-label">{{ t('Find a trial', '查找试验') }}</span>
        <span class="bci-search-field">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.25"/><path d="m12.5 12.5 4 4"/></svg>
          <input id="bci-search" type="search" autocomplete="off" spellcheck="false" placeholder="NCT ID, sponsor or study title" data-placeholder-en="NCT ID, sponsor or study title" data-placeholder-zh="NCT编号、申办方或研究名称">
        </span>
      </label>
      <label class="bci-control" for="bci-phase-filter">
        <span class="bci-control-label">{{ t('Phase', '阶段') }}</span>
        <select id="bci-phase-filter">
          <option value="" data-label-en="All phases" data-label-zh="全部阶段">All phases</option>
          <option value="PHASE1">Phase 1</option>
          <option value="PHASE2">Phase 2</option>
          <option value="PHASE3">Phase 3</option>
          <option value="PHASE4">Phase 4</option>
        </select>
      </label>
      <label class="bci-control" for="bci-status-filter">
        <span class="bci-control-label">{{ t('Recruitment', '招募状态') }}</span>
        <select id="bci-status-filter">
          <option value="" data-label-en="All statuses" data-label-zh="全部状态">All statuses</option>
          <option value="RECRUITING" data-label-en="Recruiting" data-label-zh="招募中">Recruiting</option>
          <option value="NOT_YET_RECRUITING" data-label-en="Not yet recruiting" data-label-zh="尚未招募">Not yet recruiting</option>
          <option value="ACTIVE_NOT_RECRUITING" data-label-en="Active, not recruiting" data-label-zh="进行中，未招募">Active, not recruiting</option>
          <option value="COMPLETED" data-label-en="Completed" data-label-zh="已完成">Completed</option>
          <option value="TERMINATED" data-label-en="Terminated" data-label-zh="已终止">Terminated</option>
        </select>
      </label>
      <label class="bci-search bci-condition-control" for="bci-condition-filter">
        <span class="bci-control-label">{{ t('Condition', '适应症') }}</span>
        <span class="bci-search-field">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5.5h12M4 10h8M4 14.5h5"/></svg>
          <input id="bci-condition-filter" type="search" autocomplete="off" spellcheck="false" placeholder="Condition contains…" data-placeholder-en="Condition contains…" data-placeholder-zh="适应症包含…">
        </span>
      </label>
      <div class="bci-screen-controls" id="bci-screen-controls" hidden>
        <label class="bci-search" for="bci-sponsor-filter">
          <span class="bci-control-label">{{ t('Sponsor', '申办方') }}</span>
          <span class="bci-search-field">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16V6l6-2.5V16M10 16h6V9l-6-2.5"/></svg>
            <input id="bci-sponsor-filter" type="search" autocomplete="off" spellcheck="false" placeholder="Sponsor name contains…" data-placeholder-en="Sponsor name contains…" data-placeholder-zh="申办方名称包含…">
          </span>
        </label>
        <label class="bci-search" for="bci-intervention-filter">
          <span class="bci-control-label">{{ t('Intervention', '干预措施') }}</span>
          <span class="bci-search-field">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6.5 3.5h7M10 3.5V9l4 6.5H6L10 9"/></svg>
            <input id="bci-intervention-filter" type="search" autocomplete="off" spellcheck="false" placeholder="Intervention contains…" data-placeholder-en="Intervention contains…" data-placeholder-zh="干预措施包含…">
          </span>
        </label>
        <label class="bci-control" for="bci-study-type-filter">
          <span class="bci-control-label">{{ t('Study type', '研究类型') }}</span>
          <select id="bci-study-type-filter">
            <option value="" data-label-en="All study types" data-label-zh="全部研究类型">All study types</option>
            <option value="INTERVENTIONAL" data-label-en="Interventional" data-label-zh="干预性">Interventional</option>
            <option value="OBSERVATIONAL" data-label-en="Observational" data-label-zh="观察性">Observational</option>
            <option value="EXPANDED_ACCESS" data-label-en="Expanded access" data-label-zh="扩大可及">Expanded access</option>
          </select>
        </label>
        <label class="bci-control" for="bci-pc-from">
          <span class="bci-control-label">{{ t('Primary completion from', '主要完成起始') }}</span>
          <input id="bci-pc-from" type="date" autocomplete="off">
        </label>
        <label class="bci-control" for="bci-pc-to">
          <span class="bci-control-label">{{ t('Primary completion to', '主要完成截止') }}</span>
          <input id="bci-pc-to" type="date" autocomplete="off">
        </label>
      </div>
      <div class="bci-cohort" id="bci-cohort" hidden>
        <label class="bci-control-label" for="bci-cohort-input">{{ t('Your NCT cohort', '你的 NCT 清单') }}</label>
        <textarea id="bci-cohort-input" spellcheck="false" autocomplete="off" rows="6" placeholder="One NCT ID per line" data-placeholder-en="One NCT ID per line" data-placeholder-zh="每行一个 NCT 编号" aria-describedby="bci-cohort-hint"></textarea>
        <div class="bci-cohort-actions">
          <button class="bci-cohort-run" id="bci-cohort-run" type="button" data-label-en="Compare these trials" data-label-zh="对照这些试验">
            <span class="l-en">Compare these trials</span><span class="l-zh">对照这些试验</span>
          </button>
        </div>
        <p class="bci-cohort-hint" id="bci-cohort-hint">{{ t('Paste 2 to 100 NCT IDs. This workspace compares exactly the trials you list — it never finds peers for you.', '粘贴 2 至 100 个 NCT 编号。此工作台只对照你列出的试验，不会替你寻找同类试验。') }}</p>
      </div>
      <div class="bci-filter-actions">
        <button class="bci-clear" id="bci-clear" type="button">{{ t('Clear filters', '清除筛选') }}</button>
        <button class="bci-brain-launch" id="bci-brain-launch" type="button" aria-label="Ask Mastermind" data-label-en="Ask Mastermind" data-label-zh="询问操盘大脑">
          <span aria-hidden="true">✦</span><span class="l-en">Ask Mastermind</span><span class="l-zh">询问操盘大脑</span>
        </button>
      </div>
      <div class="bci-source-note">
        <span class="bci-source-mark" aria-hidden="true">⌁</span>
        <p id="bci-source-note-copy">{{ t('Dates and field updates are recorded by ClinicalTrials.gov from study-sponsor and investigator submissions. A registry listing is not government validation. Review the source record—no trade call.', '日期和字段更新来自 ClinicalTrials.gov 所记录的研究申办方与研究者提交内容。登记收录不代表政府验证。请查看来源记录，不作交易判断。') }}</p>
      </div>
    </aside>

    <section class="bci-queue-pane" id="bci-queue-pane" role="tabpanel" aria-labelledby="bci-mode-milestones">
      <header class="bci-queue-head">
        <div>
          <p class="bci-kicker" id="bci-queue-kicker">{{ t('Registry-recorded dates', '登记记录日期') }}</p>
          <h2 id="bci-queue-title">{{ t('Catalyst Radar — Trial Milestones', '催化雷达 — 试验里程碑') }}</h2>
          <p class="bci-queue-subtitle" id="bci-queue-subtitle">{{ t('Connecting to the verified registry page…', '正在连接已核验的登记页…') }}</p>
        </div>
        <div class="bci-asof" id="bci-asof" aria-live="polite"></div>
      </header>
      <div class="bci-decision" id="bci-decision">
        <span class="bci-stamp-mark is-quiet" id="bci-decision-stance">{{ t('Wait for the record', '等记录更新') }}</span>
        <p class="bci-decision-why" id="bci-decision-why">{{ t('Reading the register now.', '正在读取登记库。') }}</p>
      </div>
      <section class="bci-braid" id="bci-braid" aria-labelledby="bci-braid-title" hidden>
        <div class="bci-braid-head">
          <h3 id="bci-braid-title">{{ t('When it was true · when we knew', '发生时间 · 得知时间') }}</h3>
          <span class="bci-braid-unit" id="bci-braid-unit"></span>
        </div>
        <div class="bci-braid-plot" id="bci-braid-plot">
          <span class="bci-braid-rail-name is-effective">{{ t('Happened', '发生') }}</span>
          <span class="bci-braid-rail is-effective" aria-hidden="true"></span>
          <span class="bci-braid-rail is-known" aria-hidden="true"></span>
          <span class="bci-braid-rail-name is-known">{{ t('Recorded', '记录') }}</span>
        </div>
        <div class="bci-braid-scale" id="bci-braid-scale"></div>
        <p class="bci-braid-readout" id="bci-braid-readout" aria-live="polite" data-rest-en="Pick a mark to read both of its times." data-rest-zh="选择一个标记，查看它的两个时间。"></p>
        <p class="bci-braid-foot" id="bci-braid-foot"></p>
        <ul class="bci-braid-list" id="bci-braid-list"></ul>
      </section>
      <div class="bci-chips" id="bci-query-chips" aria-label="Active query" data-label-en="Active query" data-label-zh="当前查询" hidden></div>
      <div class="bci-state-notice" id="bci-state-notice" role="status" aria-live="polite" hidden></div>
      <p class="bci-sr-only" id="bci-page-status" aria-live="polite"></p>
      <div class="bci-queue" id="bci-queue" role="listbox" aria-label="Trial milestones" aria-busy="true">
        <div class="bci-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="bci-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="bci-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
      <p class="bci-panel-foot" id="bci-panel-foot" hidden></p>
      <div class="bci-queue-footer" id="bci-queue-footer" hidden>
        <button class="bci-load-more" id="bci-load-more" type="button" aria-controls="bci-queue" data-label-en="Load more trial milestones" data-label-zh="加载更多试验里程碑">
          <span class="l-en">Load more</span><span class="l-zh">加载更多</span>
        </button>
      </div>
    </section>

    <aside class="bci-inspector-pane" id="bci-inspector-pane" aria-labelledby="bci-inspector-title" aria-describedby="bci-inspector-body" tabindex="-1">
      <header class="bci-inspector-head">
        <div>
          <p class="bci-kicker">{{ t('Current trial record', '当前试验记录') }}</p>
          <h2 id="bci-inspector-title">{{ t('Trial dossier', '试验档案') }}</h2>
        </div>
        <button class="bci-inspector-close" id="bci-inspector-close" type="button" aria-label="Close trial detail" data-label-en="Close trial detail" data-label-zh="关闭试验详情">
          <span aria-hidden="true">×</span>
        </button>
      </header>
      <div class="bci-inspector-body" id="bci-inspector-body">
        <div class="bci-inspector-empty">
          <span class="bci-empty-orbit" aria-hidden="true"></span>
          <p>{{ t('Choose a trial milestone to read the current trial record and its source evidence.', '选择一项试验里程碑，查看当前试验记录及其来源证据。') }}</p>
        </div>
      </div>
    </aside>
  </section>

  <section class="bci-history" id="bci-history" data-state="loading" aria-labelledby="bci-history-title" aria-busy="true">
    <header class="bci-history-head">
      <div>
        <p class="bci-kicker">{{ t('Licensed finite snapshot', '许可有限快照') }}</p>
        <h2 id="bci-history-title">{{ t('Historical Event History', '历史事件记录') }}</h2>
        <p class="bci-history-subtitle">{{ t('Recorded regulatory and device milestones from the last admitted BioPharmCatalyst snapshot. Context only — never a ranking, score, recommendation, or live feed.', '来自最后一次准入许可快照的监管与器械里程碑记录。仅供背景参考——不是排名、评分、建议或实时数据源。') }}</p>
      </div>
      <div class="bci-history-meta" id="bci-history-meta" aria-live="polite"></div>
    </header>

    <form class="bci-history-filters" id="bci-history-form">
      <label class="bci-history-search">
        <span>{{ t('Search company, ticker, asset or indication', '搜索公司、代码、资产或适应症') }}</span>
        <input id="bci-history-search" type="search" autocomplete="off" placeholder="Search history" data-placeholder-en="Search history" data-placeholder-zh="搜索历史记录">
      </label>
      <label>
        <span>{{ t('Family', '类别') }}</span>
        <select id="bci-history-family">
          <option value="all" data-label-en="All families" data-label-zh="全部类别">All families</option>
          <option value="regulatory" data-label-en="Regulatory" data-label-zh="监管">Regulatory</option>
          <option value="device" data-label-en="Device" data-label-zh="器械">Device</option>
        </select>
      </label>
      <label>
        <span>{{ t('From', '开始日期') }}</span>
        <input id="bci-history-from" type="date">
      </label>
      <label>
        <span>{{ t('To', '结束日期') }}</span>
        <input id="bci-history-to" type="date">
      </label>
      <label>
        <span>{{ t('Stage', '阶段') }}</span>
        <input id="bci-history-stage" type="search" autocomplete="off" placeholder="Any stage" data-placeholder-en="Any stage" data-placeholder-zh="全部阶段">
      </label>
      <label>
        <span>{{ t('Asset', '资产') }}</span>
        <input id="bci-history-asset" type="search" autocomplete="off" placeholder="Any asset" data-placeholder-en="Any asset" data-placeholder-zh="全部资产">
      </label>
      <div class="bci-history-actions">
        <button class="bci-history-submit" type="submit">{{ t('Apply filters', '应用筛选') }}</button>
        <button class="bci-history-clear" id="bci-history-clear" type="button">{{ t('Clear', '清除') }}</button>
      </div>
    </form>

    <p class="bci-history-status" id="bci-history-status" role="status" aria-live="polite">{{ t('Loading historical events…', '正在加载历史事件…') }}</p>
    <div class="bci-history-rows" id="bci-history-rows" aria-live="polite"></div>
    <div class="bci-history-footer">
      <p>{{ t('Source evidence is retained as a bounded, licensed historical snapshot. Missing identity, unavailable publication time and deterministic repair are shown explicitly.', '来源证据以有边界的许可历史快照保留。身份缺失、发布时间不可用及确定性修复均明确展示。') }}</p>
      <button class="bci-load-more" id="bci-history-load-more" type="button" hidden>{{ t('Load more history', '加载更多历史记录') }}</button>
    </div>
  </section>
</main>

<div class="bci-scrim" id="bci-scrim" hidden></div>
<script src="theme.js" defer></script>
<script src="biocatalyst.js" defer></script>
</body>
