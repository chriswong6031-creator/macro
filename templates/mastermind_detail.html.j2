{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>{{ s.name_en }} — Mastermind Strategy</title>
{% include '_plotly_head.html.j2' %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r2:{{C.r2}}; --r3:{{C.r3}}; --ink:{{C.ink}};
  --text:{{C.text}}; --muted:{{C.muted}}; --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}}; --green:#1FA971;
  --accent:{{ accent }}; --grad:{{ grad }};
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0 14px;border-bottom:1px solid var(--grid);margin-bottom:24px;position:sticky;top:0;background:var(--bg);z-index:20}
.nav-links{display:flex;align-items:center;gap:2px;flex-wrap:wrap}
a.nav-link{padding:7px 11px;border-radius:9px;font-size:13.5px;font-weight:500;color:var(--muted);text-decoration:none;white-space:nowrap;transition:color .18s,background .18s}
a.nav-link:hover,a.nav-link.active{color:var(--ink);background:#eef1f6}
.nav-dd{position:relative;display:inline-flex}
.nav-dd>a.nav-link .caret{display:inline-block;margin-left:3px;font-size:9px;opacity:.6;transition:transform .2s}
.nav-dd:hover>a.nav-link .caret,.nav-dd:focus-within>a.nav-link .caret{transform:rotate(180deg)}
.nav-dd::after{content:"";position:absolute;left:0;right:0;top:100%;height:9px}
.nav-dd-menu{position:absolute;top:calc(100% + 7px);left:0;min-width:218px;background:var(--card);border:1px solid var(--grid);border-radius:13px;box-shadow:0 12px 34px rgba(16,24,40,.14);padding:6px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:70}
.nav-dd:hover>.nav-dd-menu,.nav-dd:focus-within>.nav-dd-menu{opacity:1;visibility:visible;transform:translateY(0)}
.nav-dd-menu a{display:block;padding:9px 12px;border-radius:9px;font-size:13.5px;font-weight:600;color:var(--text);text-decoration:none;white-space:nowrap;transition:background .15s,color .15s}
.nav-dd-menu a .d{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:2px}
.nav-dd-menu a:hover,.nav-dd-menu a.active{background:#eef1f6;color:var(--ink)}
.nav-ctrls{display:flex;align-items:center;gap:10px;flex:none}
.nav-ctrls .ai-brief-link{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;flex:none;padding:5px 12px;border-radius:999px;background:var(--card);border:1px solid var(--grid);color:var(--text);font-size:12.5px;font-weight:600;line-height:1;text-decoration:none;transition:border-color .15s,color .15s}
.nav-ctrls .ai-brief-link:hover{border-color:var(--blue);color:var(--blue)}
.lang-toggle{display:inline-flex;position:relative;background:#eef1f6;border:1px solid var(--grid);border-radius:999px;padding:3px;cursor:pointer;flex:none}
.lang-toggle .pill{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);border-radius:999px;background:var(--blue);transition:transform .34s cubic-bezier(.34,1.4,.5,1)}
html[data-lang="zh"] .lang-toggle .pill{transform:translateX(100%)}
.lang-toggle .opt{position:relative;z-index:1;min-width:28px;text-align:center;padding:3px 9px;font-size:11.5px;font-weight:600;color:var(--muted);transition:color .25s;user-select:none}
html:not([data-lang="zh"]) .lang-toggle .en-opt{color:#fff}
html[data-lang="zh"] .lang-toggle .zh-opt{color:#fff}
.theme-switch{width:56px;height:27px;border-radius:999px;background:#eef1f6;border:1px solid var(--grid);position:relative;cursor:pointer;padding:0;flex:none}
.theme-switch .ic{position:absolute;top:50%;transform:translateY(-50%);font-size:10.5px;opacity:.5;line-height:1}
.theme-switch .ic.sun{right:8px}.theme-switch .ic.moon{left:8px}
.theme-switch .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 5px rgba(0,0,0,.3);transform:translateX(29px);transition:transform .34s cubic-bezier(.34,1.45,.5,1),background .3s}
.theme-switch .knob::before{content:"☀️"}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280}
html[data-theme="dark"] a.nav-link:hover,html[data-theme="dark"] a.nav-link.active{background:#222732}
html[data-theme="dark"] .nav-dd-menu a:hover,html[data-theme="dark"] .nav-dd-menu a.active{background:#222732}
html[data-theme="dark"] .lang-toggle{background:#222732}
html[data-theme="dark"] .theme-switch{background:#222732}
html[data-theme="dark"] .theme-switch .knob{transform:translateX(0);background:#e8c15a}
html[data-theme="dark"] .theme-switch .knob::before{content:"🌙"}
html[data-theme="dark"] .gtable td.cur{background:#1b2740}
html[data-theme="dark"] .score .s>div{background:var(--grid)}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}
.cols-3{grid-template-columns:repeat(3,1fr)}
.cols-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.cols-2,.cols-3,.cols-4{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h3{margin:0 0 14px;font-size:18px;font-weight:700;color:var(--ink)}
.sub{color:var(--muted);font-size:13px} .faint{color:var(--faint)}
.section-title{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:30px 4px 12px}
.tag{display:inline-block;background:#FFF4E0;color:#8a5a00;border-radius:8px;padding:3px 10px;font-size:12.5px;font-weight:700}
.tag.exp{background:#fde7ef;color:#a01457}
html[data-theme="dark"] .tag{background:#3a2f17;color:#e0b25a}
html[data-theme="dark"] .tag.exp{background:#3a1d2b;color:#f08bb4}
.score .s{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:4px}
.score .s>div{background:var(--bg);border-radius:10px;padding:12px;text-align:center}
.score .k{font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:600}
.score .v{font-size:21px;font-weight:800;color:var(--ink)}
.score .v small{font-size:12px;font-weight:600;color:var(--muted)}
.win{color:var(--green)} .lose{color:var(--red)}
.note{border-left:3px solid var(--amber);padding:6px 0 6px 14px;margin:8px 0;color:var(--text);font-size:13.5px}
.note.r{border-color:var(--red)} .note.b{border-color:var(--blue)}
.foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--faint);line-height:1.7}
.oostbl{width:100%;border-collapse:collapse;font-size:13.5px;margin-top:6px}
.oostbl td,.oostbl th{padding:8px 10px;border-bottom:1px solid var(--grid);text-align:right}
.oostbl td.l,.oostbl th.l{text-align:left}
.badge{display:inline-block;padding:3px 10px;border-radius:8px;font-size:12px;font-weight:700}
.badge.ok{background:#dff5ea;color:#1FA971}.badge.no{background:#fde7ef;color:#a01457}
html[data-theme="dark"] .badge.ok{background:#16321f;color:#48d39a}html[data-theme="dark"] .badge.no{background:#3a1d2b;color:#f08bb4}
.allocrow{display:flex;align-items:center;gap:10px;margin:6px 0;font-size:13px}
.allocrow .nm{width:150px;color:var(--text)}.allocrow .br{flex:1;height:16px;border-radius:5px;background:var(--bg);overflow:hidden}
html[data-theme="dark"] .allocrow .br{background:var(--grid)}
.allocrow .fill{display:block;height:100%;min-width:2px;background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 55%,transparent),var(--accent))}
.allocrow .pc{width:54px;text-align:right;font-weight:700;color:var(--ink)}

/* ===== Mastermind flagship detail — enveloped hero + mechanism explainer ===== */
body{background:radial-gradient(900px 480px at 12% -5%,color-mix(in srgb,var(--accent) 8%,transparent),transparent 60%),radial-gradient(900px 480px at 88% -5%,color-mix(in srgb,var(--accent) 7%,transparent),transparent 60%),var(--bg)}
.mm-back{display:inline-block;margin:2px 0 10px;color:var(--muted);text-decoration:none;font-size:13px;font-weight:600;transition:color .15s}
.mm-back:hover{color:var(--accent)}
.mm-stage{position:relative;overflow:hidden;margin:2px 0 8px;padding:28px 26px 24px;border-radius:24px;
  background:linear-gradient(var(--card),var(--card)) padding-box,linear-gradient(120deg,var(--grad)) border-box;
  border:1.6px solid transparent;box-shadow:0 18px 60px color-mix(in srgb,var(--accent) 15%,transparent)}
html[data-theme="dark"] .mm-stage{box-shadow:0 22px 72px color-mix(in srgb,var(--accent) 26%,transparent)}
.mm-stage-glow{position:absolute;inset:0;pointer-events:none;opacity:.7;
  background:radial-gradient(320px 210px at 90% -12%,color-mix(in srgb,var(--accent) 24%,transparent),transparent 70%)}
.mm-flag{position:relative;display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#fff;
  background:linear-gradient(120deg,var(--grad));background-size:200% 100%;padding:5px 13px;border-radius:999px;animation:mm-flow 6s linear infinite}
@keyframes mm-flow{to{background-position:200% 0}}
.mm-h1{position:relative;font-size:36px;font-weight:800;letter-spacing:-.02em;margin:13px 0 6px;
  background:linear-gradient(90deg,var(--grad),var(--accent));background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:mm-shimmer 9s linear infinite}
@keyframes mm-shimmer{to{background-position:300% 0}}
.mm-lead{position:relative;color:var(--muted);font-size:14.5px;max-width:850px;line-height:1.55;margin-bottom:18px}
.mm-hero-mets{position:relative;display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:12px;margin-bottom:16px}
@media(max-width:720px){.mm-hero-mets{grid-template-columns:1fr 1fr}}
.hm{background:var(--bg);border:1px solid var(--grid);border-radius:14px;padding:13px 15px}
html[data-theme="dark"] .hm{background:rgba(255,255,255,.03);border-color:var(--grid)}
.hm-k{display:block;font-size:10.5px;color:var(--muted);text-transform:uppercase;font-weight:700;letter-spacing:.04em}
.hm-v{display:block;font-size:26px;font-weight:800;color:var(--ink);line-height:1.05;margin-top:4px;letter-spacing:-.02em}
.hm.big .hm-v{font-size:34px}
.hm.big{border-color:color-mix(in srgb,var(--accent) 40%,var(--grid))}
.hm-d{display:block;font-size:11px;color:var(--faint);margin-top:3px}
.mm-meter{position:relative;height:8px;border-radius:999px;background:linear-gradient(90deg,#1FA971,#e0a106,#a855f7);margin:8px 0 6px}
.mm-meter::after{content:"";position:absolute;top:50%;left:calc(var(--pos)*100%);transform:translate(-50%,-50%);width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid var(--accent);box-shadow:0 1px 6px rgba(0,0,0,.4)}
.mm-meter-l{position:relative;display:flex;justify-content:space-between;font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.05em;margin-bottom:15px}
.mm-tags{position:relative;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.mm-asof{font-size:12px;color:var(--faint);margin-left:auto}
.mm-sub{font-size:16px;font-weight:800;color:var(--ink);margin:24px 4px 13px;letter-spacing:-.01em}
.mm-sub .faint{font-weight:500;font-size:13px}
.mm-engine{border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent) 6%,transparent);border-radius:0 12px 12px 0;padding:14px 18px;margin:2px 0 4px;font-size:13.5px;color:var(--text);line-height:1.6;max-width:920px}
.mm-engine b{color:var(--accent)}
.fct{position:relative;overflow:hidden;background:var(--card);border:1px solid var(--grid);border-top:3px solid var(--accent);border-radius:15px;padding:16px 16px 14px;display:flex;flex-direction:column}
.fct-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:5px}
.fct-ico{font-size:22px}
.fct-w{font-size:23px;font-weight:800;color:var(--accent);letter-spacing:-.02em}
.fct-nm{font-size:15.5px;font-weight:800;color:var(--ink)}
.fct-bar{height:5px;border-radius:999px;background:var(--bg);margin:9px 0;overflow:hidden}
html[data-theme="dark"] .fct-bar{background:var(--grid)}
.fct-bar span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 50%,transparent),var(--accent))}
.fct-tag{align-self:flex-start;font-size:11px;font-weight:700;color:var(--accent);background:color-mix(in srgb,var(--accent) 13%,transparent);border-radius:7px;padding:2px 9px;margin-bottom:9px}
.fct-desc{font-size:12.5px;color:var(--muted);line-height:1.5;margin-bottom:10px;flex:1}
.fct-src{font-size:11px;color:var(--faint);border-top:1px solid var(--grid);padding-top:8px}
.uni-grid{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
.uni{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:15px 16px}
.uni-h{font-size:13.5px;font-weight:800;color:var(--ink);margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid var(--grid)}
.uni-row{display:flex;flex-direction:column;margin:9px 0 0}
.uni-row b{font-size:13.5px;color:var(--accent);font-weight:800}
.uni-row span{font-size:11.5px;color:var(--muted);margin-top:1px}
.pipe{display:flex;align-items:stretch;gap:6px;flex-wrap:wrap}
.pipe-step{flex:1;min-width:152px;display:flex;flex-direction:column;gap:6px;background:var(--card);border:1px solid var(--grid);border-radius:13px;padding:14px 15px;position:relative}
.pipe-n{position:absolute;top:11px;right:13px;font-size:11px;font-weight:800;color:color-mix(in srgb,var(--accent) 75%,var(--faint))}
.pipe-ic{font-size:20px}
.pipe-t{font-size:12.5px;color:var(--text);line-height:1.4;font-weight:600}
.pipe-arrow{display:flex;align-items:center;color:var(--faint);font-weight:800;font-size:16px}
@media(max-width:760px){.pipe-arrow{display:none}.pipe-step{min-width:100%}}
.prof-cmp{margin-top:14px}
.pc{background:var(--bg);border:1px solid var(--grid);border-radius:14px;padding:16px;opacity:.6;transition:opacity .2s}
html[data-theme="dark"] .pc{background:rgba(255,255,255,.03)}
.pc.cur{opacity:1;border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),0 12px 30px color-mix(in srgb,var(--accent) 18%,transparent)}
.pc-h{font-size:14.5px;font-weight:800;color:var(--ink);margin-bottom:11px;display:flex;align-items:center;gap:7px}
.pc-you{font-size:9.5px;font-weight:800;letter-spacing:.06em;color:#fff;background:var(--accent);border-radius:6px;padding:2px 7px}
.pc-row{display:flex;justify-content:space-between;align-items:center;font-size:12.5px;color:var(--muted);padding:7px 0;border-top:1px solid var(--grid)}
.pc-row b{color:var(--ink);font-weight:800}

/* ===== Live regime layer panel (optional — rendered when regime_legs is passed) ===== */
.rg-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:12px}
.rg-state{font-size:13.5px;font-weight:800;padding:6px 14px;border-radius:999px;white-space:nowrap}
.rg-off{background:#fde7ef;color:#a01457}.rg-mixed{background:#FFF4E0;color:#8a5a00}.rg-on{background:#dff5ea;color:#1FA971}
html[data-theme="dark"] .rg-off{background:#3a1d2b;color:#f08bb4}
html[data-theme="dark"] .rg-mixed{background:#3a2f17;color:#e0b25a}
html[data-theme="dark"] .rg-on{background:#16321f;color:#48d39a}
.rg-gauge-wrap{flex:1;min-width:220px}
.rg-meter{position:relative;height:8px;border-radius:999px;background:linear-gradient(90deg,#1FA971,#e0a106,#e5484d)}
.rg-meter::after{content:"";position:absolute;top:50%;left:calc(var(--v)*100%);transform:translate(-50%,-50%);width:15px;height:15px;border-radius:50%;background:#fff;border:3px solid var(--ink);box-shadow:0 1px 5px rgba(0,0,0,.4)}
.rg-meter-l{display:flex;justify-content:space-between;font-size:10.5px;color:var(--faint);text-transform:uppercase;letter-spacing:.04em;margin-top:6px}
.rg-meter-l .rg-val{color:var(--ink);font-weight:800;letter-spacing:0;text-transform:none}
.rg-asof{font-size:12px;color:var(--faint);white-space:nowrap}
.rg-lead{font-size:13.5px;color:var(--text);line-height:1.6;margin:2px 0 16px;max-width:920px}
.rg-legs{margin-top:2px}
.rg-leg{background:var(--bg);border:1px solid var(--grid);border-radius:13px;padding:14px 15px}
html[data-theme="dark"] .rg-leg{background:rgba(255,255,255,.03)}
.rg-leg-top{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.rg-leg-nm{font-size:14px;font-weight:800;color:var(--ink)}
.rg-leg-w{font-size:11px;font-weight:700;color:var(--muted);background:var(--card);border:1px solid var(--grid);border-radius:7px;padding:2px 7px;white-space:nowrap}
html[data-theme="dark"] .rg-leg-w{background:var(--grid)}
.rg-leg-v{font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-.02em;margin:8px 0 0}
.rg-leg-v small{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:0}
.rg-leg-bar{position:relative;height:6px;border-radius:999px;background:linear-gradient(90deg,#1FA971,#e0a106,#e5484d);margin:6px 0 10px}
.rg-leg-bar::after{content:"";position:absolute;top:50%;left:calc(var(--v)*100%);transform:translate(-50%,-50%);width:12px;height:12px;border-radius:50%;background:#fff;border:2.5px solid var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.35)}
.rg-leg-desc{font-size:12px;color:var(--muted);line-height:1.5;margin-bottom:9px}
.rg-leg-src{font-size:10.5px;color:var(--faint);border-top:1px solid var(--grid);padding-top:7px}
</style>{% include "_vector_polish.html.j2" %}
</head>
<body>
<div class="wrap">
  <div class="topbar">
      {% include "_navlinks.html.j2" %}
    <div class="nav-ctrls">
      <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
      <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
      <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
      <div class="lang-toggle" role="group" aria-label="Language">
        <span class="pill"></span>
        <span class="opt en-opt" data-l="en">EN</span>
        <span class="opt zh-opt" data-l="zh">中文</span>
      </div>
    </div>
  </div>

  <a class="mm-back" href="{{ back_href }}">← {{ t(back_label_en, back_label_zh) }}</a>

  <!-- ===== Flagship hero stage ===== -->
  <div class="mm-stage" style="--pos:{{ riskpos }}">
    <span class="mm-stage-glow"></span>
    <span class="mm-flag">★ {{ t('Flagship strategy','旗舰策略') }} · {{ t(profile_en, profile_zh) }}</span>
    <div class="mm-h1">{{ s.icon }} {{ t(s.name_en, s.name_zh) }}</div>
    <div class="mm-lead">{{ t(s.thesis_en, s.thesis_zh) }}</div>
    <div class="mm-hero-mets">
      <div class="hm big"><span class="hm-k">CAGR</span><span class="hm-v">{{ sc.cagr }}%</span><span class="hm-d">{{ t('vs','对比') }} {{ t(bench_label_en, bench_label_zh) }} {{ sc.hodl_cagr }}%</span></div>
      <div class="hm"><span class="hm-k">Sharpe</span><span class="hm-v">{{ sc.sharpe }}</span><span class="hm-d">{{ t('B&H','买持') }} {{ sc.hodl_sharpe }}{% if sharpe_mult %} · {{ sharpe_mult }}×{% endif %}</span></div>
      <div class="hm"><span class="hm-k">{{ t('Max drawdown','最大回撤') }}</span><span class="hm-v">{{ sc.maxdd }}%</span><span class="hm-d">{{ t('B&H','买持') }} {{ sc.hodl_maxdd }}%</span></div>
      <div class="hm"><span class="hm-k">{{ t('Leverage now','当前杠杆') }}</span><span class="hm-v">{{ gross_now }}x</span><span class="hm-d">{{ t('avg','平均') }} {{ sc.avg_leverage }}x · {{ sc.years }}y</span></div>
    </div>
    <div class="mm-meter"></div>
    <div class="mm-meter-l"><span>{{ t('Capital preservation','资本保全') }}</span><span>{{ t('Maximum growth','增长最大化') }}</span></div>
    <div class="mm-tags">
      <span class="tag exp">⚗ {{ t('Experimental — under validation','实验性 — 验证中') }}</span>
      <span class="tag">{{ t('Active · vol-targeted · leverage-capable','主动 · 波动率目标 · 可加杠杆') }}</span>
      <span class="mm-asof">{{ t('As of','截至') }} {{ as_of }}</span>
    </div>
  </div>

  <!-- ===== How it works ===== -->
  <div class="section-title">{{ t('How this strategy works','本策略如何运作') }}</div>
  <div class="mm-engine">{{ t(engine_a_en, engine_a_zh) }} <b>{{ t(engine_b_en, engine_b_zh) }}</b>{{ t(engine_c_en, engine_c_zh) }}</div>

  <div class="mm-sub">① {{ t('The four conviction factors','四个信念因子') }} <span class="faint">· {{ t('what makes an asset attractive, and how much each one counts','决定资产吸引力的因素，以及各自的权重') }}</span></div>
  <div class="grid cols-4">
    {% for f in factors_detail %}
    <div class="fct">
      <div class="fct-top"><span class="fct-ico">{{ f.icon }}</span><span class="fct-w">{{ f.wpct }}%</span></div>
      <div class="fct-nm">{{ t(f.name_en, f.name_zh) }}</div>
      <div class="fct-bar"><span style="width:{{ f.wrel }}%"></span></div>
      <div class="fct-tag">{{ t(f.tag_en, f.tag_zh) }}</div>
      <div class="fct-desc">{{ t(f.desc_en, f.desc_zh) }}</div>
      <div class="fct-src">{{ t('Inputs','输入') }}: {{ t(f.src_en, f.src_zh) }}</div>
    </div>
    {% endfor %}
  </div>

  <div class="mm-sub">② {{ t('The investable universe','可投资域') }} <span class="faint">· {{ t(universe_sub_en, universe_sub_zh) }}</span></div>
  <div class="grid uni-grid">
    {% for c in universe %}
    <div class="uni">
      <div class="uni-h">{{ c.icon }} {{ t(c.cls_en, c.cls_zh) }}</div>
      {% for r in c.rows %}
      <div class="uni-row"><b>{{ r.ticker }}</b><span>{{ t(r.role_en, r.role_zh) }}</span></div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>

  <div class="mm-sub">③ {{ t('From conviction to position','从信念到仓位') }} <span class="faint">· {{ t('the sizing pipeline, re-run every week','每周重跑一次的定仓流程') }}</span></div>
  <div class="pipe">
    {% for p in pipeline %}
    <div class="pipe-step"><span class="pipe-n">{{ loop.index }}</span><span class="pipe-ic">{{ p.icon }}</span><span class="pipe-t">{{ t(p.en, p.zh) }}</span></div>
    {% if not loop.last %}<span class="pipe-arrow">→</span>{% endif %}
    {% endfor %}
  </div>

  <!-- ===== This profile's risk dials ===== -->
  <div class="section-title">{{ t('This profile’s risk dials','本档的风险旋钮') }}</div>
  <div class="card">
    <p class="sub" style="font-size:13.5px;line-height:1.6;margin:0 0 4px">{{ t(blurb_en, blurb_zh) }}</p>
    <div class="grid cols-3 prof-cmp">
      {% for p in profiles_cmp %}
      <div class="pc {{ 'cur' if p.is_current }}" style="--accent:{{ p.accent }}">
        <div class="pc-h">{{ p.icon }} {{ t(p.label_en, p.label_zh) }}{% if p.is_current %}<span class="pc-you">{{ t('THIS','本档') }}</span>{% endif %}</div>
        <div class="pc-row"><span>{{ t('Target volatility','目标波动率') }}</span><b>{{ p.target_vol }}%</b></div>
        <div class="pc-row"><span>{{ t('Max leverage','最大杠杆') }}</span><b>{{ p.max_lev }}x</b></div>
        <div class="pc-row"><span>{{ t('Per-name cap','单一上限') }}</span><b>{{ p.w_cap }}%</b></div>
        <div class="pc-row"><span>{{ t('Benchmark','基准') }}</span><b>{{ t(p.bench_en, p.bench_zh) }}</b></div>
      </div>
      {% endfor %}
    </div>
  </div>

  {% if regime_legs %}
  <!-- ===== Live regime layer (China flagship) — why the book is positioned this way ===== -->
  <div class="section-title">{{ t('Live regime layer · why the book is positioned this way','实时体制层 · 当前持仓为何如此') }}</div>
  <div class="card">
    <div class="rg-head">
      <span class="rg-state rg-{{ regime_tone }}">{{ t(regime_state_en, regime_state_zh) }}</span>
      <div class="rg-gauge-wrap">
        <div class="rg-meter" style="--v:{{ regime_v }}"></div>
        <div class="rg-meter-l"><span>{{ t('Risk-on','风险偏好') }}</span><span class="rg-val">{{ t('Blended de-risk','综合降险') }} {{ regime_pct }}/100</span><span>{{ t('Risk-off','风险偏离') }}</span></div>
      </div>
      <span class="rg-asof">{{ t('As of','截至') }} {{ regime_asof }}</span>
    </div>
    <p class="rg-lead">{{ t(regime_lead_en, regime_lead_zh) }}</p>
    <div class="grid cols-3 rg-legs">
      {% for lg in regime_legs %}
      <div class="rg-leg">
        <div class="rg-leg-top"><span class="rg-leg-nm">{{ t(lg.name_en, lg.name_zh) }}</span><span class="rg-leg-w">{{ (lg.weight*100)|round|int }}% {{ t('of layer','层内权重') }}</span></div>
        <div class="rg-leg-v">{{ (lg.value*100)|round|int }}<small>/100 {{ t('de-risk','降险') }}</small></div>
        <div class="rg-leg-bar" style="--v:{{ lg.value }}"></div>
        <div class="rg-leg-desc">{{ t(lg.desc_en, lg.desc_zh) }}</div>
        <div class="rg-leg-src">{{ t('Source','来源') }}: {{ t(lg.src_en, lg.src_zh) }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="note b" style="margin-top:14px">{{ t('These are the live de-risk legs, lagged exactly as the book trades them (credit ~1 month, vol & margin 1 day); weights renormalise over whichever legs have data. Display-only — the same gauges already drive the weekly allocation below.','以上为实时降险分腿，按组合实际交易的滞后处理（信用约1个月，波动率与融资1天）；权重在有数据的分腿间重新归一化。仅展示——同一组指标已驱动下方的每周配置。') }}</div>
  </div>
  {% endif %}

  <!-- ===== Live book + scorecard ===== -->
  <div class="grid cols-2" style="margin-top:18px">
    <div class="card">
      <h3>{{ t(exposure_title_en, exposure_title_zh) }}</h3>
      {% if alloc %}
        {% for a in alloc %}
        <div class="allocrow"><span class="nm">{{ t(a.label_en, a.label_zh) }}</span><span class="br"><span class="fill" style="width:{{ (a.weight/alloc_max*100)|round }}%"></span></span><span class="pc">{{ a.weight }}%</span></div>
        {% endfor %}
        <div class="sub faint" style="margin-top:10px;font-size:12px">{{ t('Gross exposure now','当前总敞口') }}: <b style="color:var(--ink)">{{ gross_now }}x</b> · {{ t('weekly rebalance, vol-targeted','每周再平衡，波动率目标') }}</div>
      {% else %}
        <div class="sub">{{ t('De-risked — mostly in T-bills.','已降险——主要持有短债。') }}</div>
      {% endif %}
    </div>
    <div class="card">
      <h3>{{ t('Backtest scorecard','回测记分卡') }} <span class="faint" style="font-weight:500">· {{ sc.years }}y {{ t('vs','对比') }} {{ t(bench_label_en, bench_label_zh) }}</span></h3>
      <div class="score"><div class="s">
        <div><div class="k">CAGR</div><div class="v {{ 'win' if sc.cagr >= sc.hodl_cagr else 'lose' }}">{{ sc.cagr }}%</div><div class="sub">{{ t('B&H','买持') }} {{ sc.hodl_cagr }}%</div></div>
        <div><div class="k">Sharpe</div><div class="v {{ 'win' if sc.sharpe >= sc.hodl_sharpe else 'lose' }}">{{ sc.sharpe }}</div><div class="sub">{{ t('B&H','买持') }} {{ sc.hodl_sharpe }}</div></div>
        <div><div class="k">{{ t('Max DD','最大回撤') }}</div><div class="v {{ 'win' if sc.maxdd >= sc.hodl_maxdd else 'lose' }}">{{ sc.maxdd }}%</div><div class="sub">{{ t('B&H','买持') }} {{ sc.hodl_maxdd }}%</div></div>
        <div><div class="k">{{ t('Avg leverage','平均杠杆') }}</div><div class="v">{{ sc.avg_leverage }}x</div><div class="sub">{{ sc.turnover_annual }}x {{ t('turnover/yr','换手/年') }}</div></div>
      </div></div>
      <div class="note b" style="margin-top:12px">{{ t('Net of 3 bps cost + a 1% financing spread on the levered part. The de-risked sleeve earns the T-bill yield.','扣除 3 个基点成本 + 杠杆部分 1% 融资利差。降险部分赚取短债收益。') }}</div>
    </div>
  </div>

  <div class="grid cols-2" style="margin-top:18px">
    <div class="card"><h3>{{ t('Growth of $1 (log) — vs buy & hold','1美元增长（对数）— 对比买入持有') }}</h3>{{ charts.growth|safe }}</div>
    <div class="card"><h3>{{ t('Underwater (drawdown) — vs buy & hold','水下回撤 — 对比买入持有') }}</h3>{{ charts.dd|safe }}</div>
  </div>
  <div class="card" style="margin-top:18px"><h3>{{ t('Exposure / leverage over time','敞口 / 杠杆走势') }}</h3>{{ charts.lev|safe }}
    <div class="sub faint" style="margin-top:6px;font-size:12px">{{ t('The vol-targeted gross exposure. It runs hot in strong, calm trends and light in turmoil — that is how an active book can out-CAGR buy-&-hold without simply taking more risk all the time.','波动率目标下的总敞口。在强劲而平静的趋势中加大、在动荡中减小——这正是主动组合能在不始终承担更高风险的情况下跑赢买入持有年化的方式。') }}</div>
  </div>

  <!-- OOS honesty panel -->
  <div class="section-title">{{ t('Out-of-sample honesty · does the edge hold in both halves?','样本外诚实检验 · 优势在两个半段是否成立？') }}</div>
  <div class="card">
    <table class="oostbl">
      <tr><th class="l">{{ t('Window','区间') }}</th><th>{{ t('Strategy CAGR','策略年化') }}</th><th>{{ t('Buy & hold','买入持有') }}</th><th>{{ t('Strategy Sharpe','策略夏普') }}</th><th>{{ t('B&H Sharpe','买持夏普') }}</th><th>{{ t('Beats?','跑赢？') }}</th></tr>
      <tr><td class="l"><b>{{ t('Full sample','全样本') }}</b></td><td>{{ sc.cagr }}%</td><td>{{ sc.hodl_cagr }}%</td><td>{{ sc.sharpe }}</td><td>{{ sc.hodl_sharpe }}</td><td>{% if sc.cagr>=sc.hodl_cagr %}<span class="badge ok">{{ t('CAGR','年化') }}</span>{% endif %}</td></tr>
      {% if oos.first %}<tr><td class="l">{{ t('First half','前半段') }}</td><td>{{ oos.first.cagr }}%</td><td>{{ oos.first.hodl_cagr }}%</td><td>{{ oos.first.sharpe }}</td><td>{{ oos.first.hodl_sharpe }}</td><td>{% if oos.first.beats_cagr %}<span class="badge ok">✓</span>{% else %}<span class="badge no">✗</span>{% endif %}</td></tr>{% endif %}
      {% if oos.second %}<tr><td class="l">{{ t('Second half','后半段') }}</td><td>{{ oos.second.cagr }}%</td><td>{{ oos.second.hodl_cagr }}%</td><td>{{ oos.second.sharpe }}</td><td>{{ oos.second.hodl_sharpe }}</td><td>{% if oos.second.beats_cagr %}<span class="badge ok">✓</span>{% else %}<span class="badge no">✗</span>{% endif %}</td></tr>{% endif %}
    </table>
    <div class="note {{ 'b' if oos.robust else 'r' }}" style="margin-top:10px">{{ t(verdict_en, verdict_zh) }}</div>
  </div>

  {% if caveat_en %}<div class="note r">{{ t(caveat_en, caveat_zh) }}</div>{% endif %}
  <div class="foot">{{ t('Built', '生成于') }} {{ built }}<br><span class="made">© 2026 Mastermind Inc</span></div>
</div>
<script src="theme.js"></script>
</body></html>
