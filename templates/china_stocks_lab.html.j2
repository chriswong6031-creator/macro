  <!--          process_fault_mix).  NOT the US schema (strata /         -->
  <!--          coverage_monitor / buy_lane_rows).                       -->
  <!-- ================================================================ -->
  <section data-tab-panel="accountability" style="display:none">
    <div class="acct-header">
      <div class="acct-title">
        <span class="l-en">Board Record</span>
        <span class="l-zh">选板记录</span>
      </div>
      <p class="acct-sub">
        <span class="l-en">How well has the CN Buy Board identified winners before they moved? Record is measuring — first read expected ~Oct 15 2026 when cluster-unit floors are met (SA-R10).</span>
        <span class="l-zh">中国买入板过去是否提前识别到赢家？记录正在累积中——首次读取预计2026年10月15日（集群单元下限达到，SA-R10）。</span>
      </p>
      <span class="acct-clock">
        <span class="l-en">ACCRUING — first read ~Oct 15 2026</span>
        <span class="l-zh">累积中 — 首次读取约2026年10月15日</span>
      </span>
    </div>

    {% set acct = accountability %}

    <!-- ── Stratified cells (cn_audit_scoreboard.v1 schema) ── -->
    <div class="acct-card">
      <div class="acct-card-title">
        <span class="l-en">Stratified Cells</span>
        <span class="l-zh">分层单元格</span>
      </div>
      {% if acct.get('present') and acct.get('has_cells') %}
      <div class="tbl-scroll">
        <table class="acct-tbl">
          <thead><tr>
            <th><span class="l-en">Stratum</span><span class="l-zh">层</span></th>
            <th data-tip-en="Raw row count" data-tip-zh="原始行数">
              <span class="l-en">Raw n</span><span class="l-zh">原始n</span>
            </th>
            <th data-tip-en="Cluster-unit effective sample (entry-date-collapsed, 21d windows)" data-tip-zh="集群单元有效样本（入场日折叠，21日窗口）">
              <span class="l-en">Eff. n</span><span class="l-zh">有效n</span>
            </th>
            <th><span class="l-en">State</span><span class="l-zh">状态</span></th>
          </tr></thead>
          <tbody>
            {% for cell in (acct.get('cells') or []) %}
            <tr {% if cell.get('is_us_proxy') %}style="color:var(--muted);font-style:italic"{% endif %}>
              <td style="text-align:left">
                {{ cell.get('stratum') or '—' }}
                {% if cell.get('is_us_proxy') %}
                <span class="chip chip-muted" style="font-size:10px;vertical-align:middle" title="Pre-store rows using US regime proxy. Never pooled with own-market cells.">us_proxy</span>
                {% endif %}
              </td>
              <td>{{ cell.get('raw_n') if cell.get('raw_n') is not none else '—' }}</td>
              <td>{{ cell.get('effective_n') if cell.get('effective_n') is not none else '—' }}</td>
              <td>
                {% if cell.get('state') == 'ACCRUING' %}
                <span class="badge-accruing">
                  <span class="l-en">ACCRUING</span><span class="l-zh">累积中</span>
                </span>
                {% else %}
                {{ cell.get('state') or '—' }}
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if acct.get('us_proxy_note') %}
      <p style="font-size:11px;color:var(--muted);margin-top:8px;padding:0 4px">
        {{ acct.get('us_proxy_note') }}
      </p>
      {% endif %}
      {% else %}
      <div class="acct-empty-state">
        <div style="font-size:32px;margin-bottom:8px">📊</div>
        <p>
          <span class="l-en">No matured rows yet. Rows accrue as 21d windows close — first read ~Oct 15 2026.</span>
          <span class="l-zh">暂无成熟行。行随21日窗口关闭而累积——首次读取约2026年10月15日。</span>
        </p>
        {% if acct.get('present') and acct.get('us_proxy_note') %}
        <p style="font-size:11px;color:var(--muted);margin-top:8px">
          {{ acct.get('us_proxy_note') }}
        </p>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <!-- ── Two-axis failure-mode mix (cn_audit_scoreboard.v1) ── -->
    <div class="acct-row-grid">
      <div class="acct-card">
        <div class="acct-card-title">
          <span class="l-en">Outcome Causes</span>
          <span class="l-zh">结果原因</span>
        </div>
        {% if acct.get('present') and acct.get('has_outcome_cause_mix') %}
        <div class="tbl-scroll">
          <table class="acct-tbl">
            <thead><tr>
              <th><span class="l-en">Cause</span><span class="l-zh">原因</span></th>
              <th><span class="l-en">Count</span><span class="l-zh">数量</span></th>
            </tr></thead>
            <tbody>
              {% for cause, val in (acct.get('outcome_cause_mix') or {}).items() %}
              <tr>
                <td style="text-align:left">{{ cause }}</td>
                <td>{{ val if val is not none else '—' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="acct-empty-state" style="padding:20px 12px">
          <span class="l-en">Measuring — outcome-cause breakdown available once attribution rows mature.</span>
          <span class="l-zh">测量中——结果原因分解在归因行成熟后可用。</span>
        </div>
        {% endif %}
      </div>
      <div class="acct-card">
        <div class="acct-card-title">
          <span class="l-en">Process Faults</span>
          <span class="l-zh">流程缺陷</span>
        </div>
        {% if acct.get('present') and acct.get('has_process_fault_mix') %}
        <div class="tbl-scroll">
          <table class="acct-tbl">
            <thead><tr>
              <th><span class="l-en">Fault</span><span class="l-zh">缺陷</span></th>
              <th><span class="l-en">Count</span><span class="l-zh">数量</span></th>
            </tr></thead>
            <tbody>
              {% for fault, val in (acct.get('process_fault_mix') or {}).items() %}
              <tr>
                <td style="text-align:left">{{ fault }}</td>
                <td>{{ val if val is not none else '—' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="acct-empty-state" style="padding:20px 12px">
          <span class="l-en">Measuring — process-fault breakdown available once attribution rows mature.</span>
          <span class="l-zh">测量中——流程缺陷分解在归因行成熟后可用。</span>
        </div>
        {% endif %}
      </div>
    </div>

    <p style="margin-top:16px;font-size:11.5px;color:var(--muted)">
      <span class="l-en">Authority: display_only. All numbers from committed CN audit artifacts (SA-W2). Cluster-unit CIs per SA-R10. No verdict language before floor.</span>
      <span class="l-zh">授权：仅展示。所有数字来自已提交CN审计工件（SA-W2）。集群单元置信区间按SA-R10。下限前无结论语言。</span>
      {% if acct.get('taxonomy_version') %} · taxonomy {{ acct.taxonomy_version }}{% endif %}
      {% if acct.get('as_of') %}· <span class="l-en">As of</span><span class="l-zh">截至</span> {{ acct.as_of }}{% endif %}
    </p>
  </section>

  <!-- ================================================================ -->
  <!-- TAB 4: METHOD                                                      -->
  <!-- ================================================================ -->
  <section data-tab-panel="method" style="display:none">
    <div class="method-body">
      <h3>{{ t('What this CN lab measures', '本CN实验室测量什么') }}</h3>
      <p>{{ t('20 frozen CN candidate pick engines run in parallel on forward ledgers in the asia-close lane. Each book fires picks nightly; those picks are graded when the horizon elapses. Nothing here drives live selection. The purpose is evidence accrual: let the data tell us which A-share constructions are worth a formal gauntlet.', '20个冻结CN候选选股引擎在亚盘通道的前向账本上并行运行。每本书每晚触发选择；当地平线经过时，这些选择被评级。这里没有任何内容驱动实时选股。目的是证据累积：让数据告诉我们哪些A股构造值得正式考验。') }}</p>

      <h3>{{ t('Ruler (CNPL-R3)', '标尺（CNPL-R3）') }}</h3>
      <div class="law">
        <b>{{ t('Primary ruler: 21-session CSI 300 (510300.SS) excess — win rate + median excess. 5/10/63-session descriptive ladder also recorded. MFE/MAE over 25 sessions.', '主标尺：21节沪深300（510300.SS）超额 — 胜率+中位超额。同时记录5/10/63节描述性阶梯。25节MFE/MAE。') }}</b>
        {{ t('Inverse book (Chase Avoid): scored as avoid-accuracy — expected negative 21-session excess.', '反向书（追涨规避）：评分为规避准确性 — 预期21节负超额。') }}
      </div>

      <h3>{{ t('Execution law (CNPL-R4)', '执行法则（CNPL-R4）') }}</h3>
      <div class="law">
        <b>{{ t('T+1 settlement. Fill = next-session (H+L)/2 from the raw price store (fill_basis="hl2"), falling back to close (fill_basis="close") when raw OHLC is absent.', 'T+1交割。入场 = 下一节（最高+最低）/2，来自原始价格库（fill_basis="hl2"），原始OHLC缺失时回退至收盘价（fill_basis="close"）。') }}</b>
        {{ t('A fire that is sealed_up at fire close is logged but excluded from grading (counted in skipped_unfillable). ST/*ST names are excluded from all universes.', '触发时封于涨停价的入场已记录但不参与评级（计入skipped_unfillable）。ST/*ST个股从所有宇宙中排除。') }}
      </div>

      <h3>{{ t('CN kill laws (CN-SYS-R3, CNPL-R7)', 'CN禁止法则（CN-SYS-R3，CNPL-R7）') }}</h3>
      <div class="kill-law">
        <b>{{ t('NO momentum ranks. NO subsector-state gates on reversal. NO limit-up/lianban BUY conditioning. NO northbound.', '无动量排名。无反转的子行业状态门控。无涨停/连板买入条件。无北向。') }}</b>
        {{ t('Limit data may only be used in the AVOID/veto direction. The sole limit-data book is Chase Avoid (inverse, expected negative).', '涨停数据只能用于规避/否决方向。唯一的涨停数据书是追涨规避（反向，预期为负）。') }}
      </div>

      <h3>{{ t('Store-honest books (CNPL-R9)', '数据诚实书（CNPL-R9）') }}</h3>
      <p>{{ t('Block Discount (book 9) and LHB Institutional Seats (book 10) need runner-local stores. When the store is absent (worktree / CI runs), these books emit zero picks with a visible DATA GAP flag. They only accrue on the runner. Never fabricated.', '大宗折价（书9）和龙虎榜机构席位（书10）需要本地数据库。当数据库缺失时（工作树/CI运行），这些书返回零选择并显示数据缺失标志。仅在运行器上累积，绝不伪造。') }}</p>

      <h3>{{ t('Controls (CNPL-R5)', '控制变量（CNPL-R5）') }}</h3>
      <p>{{ t('Every book is measured against two yardsticks: (1) the CN Random Control book (12 deterministic-random liquid names, seed = sha256(engine_id+asof)), visible in the scoreboard; and (2) the universe buy-anytime base rate. Every headline number is lift over both, not raw win rate.', '每本书均与两个基准进行比较：（1）CN随机控制书（12个确定性随机流动名称，种子=sha256(engine_id+asof)），在记分板中可见；以及（2）全市场随时买入基准率。每个标题数字是相对于两者的提升，而非原始胜率。') }}</p>

      <h3>{{ t('ACCRUING floor (CNPL-R4)', '累积下限（CNPL-R4）') }}</h3>
      <div class="law">
        <b>{{ t('No verdict language before n≥25 fires spanning ≥3 calendar months and ≥6 distinct fire dates.', '在n≥25次触发跨越≥3个日历月和≥6个不同触发日期之前，无结论语言。') }}</b>
        {{ t('Until then, the status badge reads ACCRUING. Even past the floor, this page shows descriptive summaries only.', '在此之前，状态徽章显示ACCRUING。即使超过下限，此页面也仅显示描述性摘要。') }}
      </div>

      <h3>{{ t('No Long-Hold grid (CNPL-R10)', '无长持网格（CNPL-R10）') }}</h3>
      <p>{{ t('CN long-hold grids are deliberately deferred: CN fundamentals coverage is thin, and no CN long-hold program exists to receive the evidence. Revisit only with its own pre-registration.', 'CN长持网格被故意推迟：CN基本面覆盖率薄弱，且目前没有CN长持项目来接收证据。仅凭其自身的预注册方可重新审视。') }}</p>

      <h3>{{ t('Candidate families', '候选族') }}</h3>
      <ul>
        <li><b>A — {{ t('Reversion (accruing edge):', '反转（累积边缘）：') }}</b> {{ t('4 books on the flat within-sector 3m reversal construction. No confirmation/quality/reclaim gates (FALSIFIED). Conditioners are CN-native bonuses (washout/COILED/low-vol), not turn-confirmation.', '4本书基于平坦的行业内3月反转构造。无确认/质量/收复门控（已证伪）。条件是CN原生奖励（洗盘/盘绕/低波），而非转向确认。') }}</li>
        <li><b>B — {{ t('1D Velocity CN:', '1日速度A股：') }}</b> {{ t('4 books (1D RSI-MACD + StochRSI cross-up entry timing on the fast A-share tape; phase and participation conditioning).', '4本书（在快速A股行情上的1日RSI-MACD + StochRSI交叉上穿入场时机；阶段和参与度条件）。') }}</li>
        <li><b>C — {{ t('Structure / Flow:', '结构/资金流：') }}</b> {{ t('4 books (block discount ≤−15%, LHB inst seats ≥2, policy put, theme laggard catch-up).', '4本书（大宗折价≤−15%，龙虎榜机构席位≥2，政策托底，主题落后者补涨）。') }}</li>
        <li><b>D — {{ t('Washout / Panic:', '洗盘/恐慌：') }}</b> {{ t('4 books (capitulation beta, QVIX panic, STAR/ChiNext 20cm timing, Chase Avoid INVERSE).', '4本书（出逃Beta，QVIX恐慌，科创/创业20cm择时，追涨规避反向）。') }}</li>
        <li><b>E — {{ t('Defensive + Ablations + Control:', '防御+消融+控制：') }}</b> {{ t('4 books (low-vol defensive, dividend/中特估, flagship-nogate ablation, random control yardstick).', '4本书（防御低波，分红/中特估，旗舰无门消融，随机控制基准）。') }}</li>
      </ul>

      <h3>{{ t('Clocks', '时钟') }}</h3>
      <ul>
        <li>{{ t('2026-08-20 — first operator read: flagship-2 vs flagship-1 gap, 1D family signs, dead books pruned to v2.', '2026-08-20 — 第一次操作员读取：旗舰2与旗舰1的差距，1日族信号，死书修剪至v2。') }}</li>
        <li>{{ t('2026-10-09 — floor-eligible verdict window (n≥25/≥3mo/≥6 dates) for high-frequency books.', '2026-10-09 — 高频书的达标评判窗口（n≥25/≥3月/≥6日期）。') }}</li>
      </ul>

      {% if method_note %}
      <h3>{{ t('Notes from last run', '上次运行说明') }}</h3>
      <p>{{ method_note }}</p>
      {% endif %}

      <p style="margin-top:20px;font-size:11.5px;color:var(--muted)">
        {{ t('Authority: display_only. All rows carry authority: "display_only" per CNPL-R1.', '授权：仅展示。所有行按照CNPL-R1携带授权："display_only"。') }}
        · {{ t('Built', '生成时间') }} {{ built }}
      </p>
    </div>
  </section>

</div><!-- .pl-wrap -->

<!-- ── inline tab-switch JS ── -->
<script>
(function () {
  'use strict';
  /* main tab switcher */
  var tabs = document.querySelectorAll('.pl-tabs .tabbtn');
  var panels = document.querySelectorAll('[data-tab-panel]');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-tab');
      tabs.forEach(function (b) { b.classList.remove('on'); });
      panels.forEach(function (p) { p.style.display = 'none'; });
      btn.classList.add('on');
      var panel = document.querySelector('[data-tab-panel="' + id + '"]');
      if (panel) panel.style.display = 'block';
    });
  });
  /* All Books chip selector */
  var chips = document.querySelectorAll('#ab-chips .book-chip');
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var id = chip.getAttribute('data-ab');
      chips.forEach(function (c) { c.classList.remove('on'); });
      document.querySelectorAll('.ab-panel').forEach(function (p) { p.style.display = 'none'; });
      chip.classList.add('on');
      var panel = document.getElementById('ab-' + id);
      if (panel) panel.style.display = 'block';
    });
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
