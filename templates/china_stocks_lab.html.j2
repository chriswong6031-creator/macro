{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{#
  CN Pick Lab — A-share candidate pick engine evaluation (display_only, ACCRUING).
  Spec: research/CHINA_PICK_LAB_MASTERPLAN_BY_FABLE.md §7.
  Data: site/labdata/china_pick_lab.json (built nightly in asia-close lane).
  Authority: display_only (CNPL-R1). No Long-Hold tab (CNPL-R10).
  Ruler: 21-session CSI 300 excess (CNPL-R3). T+1 fill (CNPL-R4).
  The word "validated" never appears (CI-guarded).
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>CN Pick Lab — Mastermind</title>
<link rel="stylesheet" href="theme.css">
<style>
  *{box-sizing:border-box}
  body{margin:0;padding-top:24px;background:var(--bg);color:var(--text);font-family:var(--font-ui);font-size:14px;line-height:1.5}
  a{text-decoration:none;color:inherit}
  .pl-wrap{max-width:1360px;margin:0 auto;padding:0 20px 70px}

  /* ── page header ── */
  .pl-hd{padding:18px 0 10px}
  .pl-eyebrow{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 4px}
  .pl-title{font-size:clamp(22px,3vw,32px);font-weight:800;letter-spacing:-.02em;margin:0 0 6px}
  .pl-sub{color:var(--muted);font-size:13px;max-width:88ch}
  .pl-asof{color:var(--muted);font-size:12px;margin-top:4px}
  .pl-back{font-size:12.5px;color:var(--link);margin-top:6px;display:inline-block}

  /* ── tabs ── */
  .pl-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0 16px}
  .tabbtn{padding:9px 18px;font:inherit;font-size:13.5px;font-weight:700;border:1.5px solid var(--line);
    background:var(--panel);color:var(--muted);border-radius:10px;cursor:pointer;transition:.15s}
  .tabbtn.on{background:var(--panel2,var(--panel));color:var(--text);border-color:var(--muted)}

  /* ── scoreboard tab ── */
  .sb-note{font-size:12px;color:var(--muted);margin:0 0 12px;padding:10px 13px;
    border:1px solid var(--line);border-left:3px solid var(--link);border-radius:10px;background:var(--panel)}
  .sb-note b{color:var(--text)}
  .sb-skip{font-size:12px;color:var(--muted);margin:0 0 10px;padding:8px 12px;
    border:1px solid var(--line);border-left:3px solid var(--warn);border-radius:9px;background:var(--panel)}
  .tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table.sb-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums;white-space:nowrap}
  table.sb-tbl th{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line);
    color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  table.sb-tbl td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)}
  table.sb-tbl th:first-child,table.sb-tbl td:first-child{text-align:left}
  table.sb-tbl th.l,table.sb-tbl td.l{text-align:left}
  table.sb-tbl tr.row-random{background:color-mix(in srgb,var(--muted) 7%,transparent);border-top:2px solid var(--line)}
  table.sb-tbl tr.row-random td{color:var(--muted);font-style:italic}
  table.sb-tbl tr.row-inverse td.name-cell{color:var(--warn)}
  table.sb-tbl tr.row-data-gap td.name-cell{opacity:.7}
  .pos{color:var(--up)} .neg{color:var(--down)} .neu{color:var(--muted)}
  .family-badge{display:inline-block;font-size:10px;font-weight:700;padding:1px 5px;border-radius:5px;
    border:1px solid var(--line);color:var(--muted);margin-right:4px}
  .badge-accruing{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;
    border:1px solid color-mix(in srgb,var(--warn) 50%,var(--line));
    color:var(--warn);background:color-mix(in srgb,var(--warn) 10%,transparent)}
  .badge-active{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;
    border:1px solid color-mix(in srgb,var(--up) 50%,var(--line));
    color:var(--up);background:color-mix(in srgb,var(--up) 10%,transparent)}
  .badge-data-gap{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;
    border:1px solid color-mix(in srgb,var(--muted) 40%,var(--line));
    color:var(--muted);background:color-mix(in srgb,var(--muted) 8%,transparent)}
  .sb-yardstick-label{font-size:10px;color:var(--muted);margin-left:4px}
  .avoid-label{font-size:10px;font-weight:700;color:var(--warn);margin-left:4px}

  /* ── empty state ── */
  .pl-empty{text-align:center;padding:60px 20px 80px;color:var(--muted)}
  .pl-empty-icon{font-size:48px;margin-bottom:14px}
  .pl-empty h2{font-size:20px;font-weight:700;color:var(--text);margin:0 0 8px}
  .pl-empty p{max-width:52ch;margin:0 auto;font-size:14px;line-height:1.6}

  /* ── pick cards ── */
  .pick-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:13px;margin-top:10px}
  .pick-card{border:1px solid var(--line);border-radius:12px;padding:13px 15px;background:var(--panel);
    border-left:3px solid var(--info,#4c8bf5)}
  .pick-card.avoid-card{border-left-color:var(--down)}
  .pick-card:hover{border-color:var(--muted);background:var(--panel2,var(--panel))}
  .pick-top{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
  .pick-rank{font-size:11px;color:var(--muted);font-weight:600;min-width:22px}
  .pick-tk{font-size:16px;font-weight:800;letter-spacing:-.01em}
  .pick-close{font-size:13px;font-variant-numeric:tabular-nums;color:var(--muted)}
  .pick-sector{font-size:11.5px;color:var(--muted);margin-top:2px}
  .pick-why{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0 0}
  .why-chip{font-size:11px;padding:2px 7px;border-radius:6px;border:1px solid var(--line);color:var(--muted);background:transparent}
  .why-chip.accent{color:var(--text);border-color:var(--muted)}
  .why-chip.limit{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,var(--line))}
  .pick-feats{display:flex;flex-wrap:wrap;gap:8px;margin-top:7px;font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums}
  .pick-feats span b{color:var(--text)}

  /* ── book section header ── */
  .book-section{margin-top:28px;padding-top:20px;border-top:1px solid var(--line)}
  .book-section:first-child{border-top:none;padding-top:0;margin-top:0}
  .book-hd{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:6px}
  .book-name{font-size:16px;font-weight:750}
  .book-sb{font-size:12px;color:var(--muted)}
  .no-picks{font-size:13px;color:var(--muted);padding:14px 0;font-style:italic}
  .data-gap-banner{font-size:12px;color:var(--muted);padding:9px 13px;margin-top:8px;
    border:1px solid var(--line);border-left:3px solid var(--muted);border-radius:9px;background:var(--panel)}

  /* ── avoid book warning ── */
  .avoid-banner{font-size:12.5px;padding:10px 13px;margin-bottom:10px;
    border:1.5px solid color-mix(in srgb,var(--down) 50%,var(--line));
    border-radius:10px;background:color-mix(in srgb,var(--down) 8%,var(--panel));color:var(--down)}
  .avoid-banner b{color:var(--down)}

  /* ── recent fires table ── */
  .fires-hd{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:14px 0 6px}
  table.fires-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums}
  table.fires-tbl th{text-align:left;padding:5px 8px;border-bottom:1px solid var(--line);color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  table.fires-tbl td{padding:5px 8px;border-bottom:1px solid var(--line)}
  table.fires-tbl tr:last-child td{border-bottom:none}

  /* ── all-books chip selector ── */
  .book-chips{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px}
  .book-chip{font-size:12.5px;padding:6px 13px;border:1.5px solid var(--line);border-radius:9px;
    background:transparent;color:var(--muted);cursor:pointer;font-weight:600;transition:.13s}
  .book-chip.on{background:var(--panel2,var(--panel));color:var(--text);border-color:var(--muted)}
  .book-chip .fam{font-size:10px;font-weight:700;color:var(--muted);margin-left:4px}
  .book-chip.chip-avoid{border-color:color-mix(in srgb,var(--down) 40%,var(--line));color:var(--down)}

  /* ── method tab ── */
  .method-body{max-width:78ch;line-height:1.7}
  .method-body h3{font-size:14.5px;font-weight:720;margin:20px 0 6px;color:var(--text)}
  .method-body p{color:var(--muted);font-size:13.5px;margin:0 0 10px}
  .method-body ul{color:var(--muted);font-size:13px;padding-left:18px;margin:0 0 10px}
  .method-body ul li{margin:4px 0}
  .method-body .law{border-left:3px solid var(--link);padding:10px 14px;
    background:color-mix(in srgb,var(--link) 7%,var(--panel));border-radius:0 9px 9px 0;
    margin:12px 0;font-size:13px;color:var(--muted)}
  .method-body .law b{color:var(--text)}
  .method-body .kill-law{border-left:3px solid var(--down);padding:10px 14px;
    background:color-mix(in srgb,var(--down) 6%,var(--panel));border-radius:0 9px 9px 0;
    margin:12px 0;font-size:13px;color:var(--muted)}
  .method-body .kill-law b{color:var(--down)}

  /* ── accountability tab (SA-W5) ── */
  .acct-header{padding:0 0 16px;border-bottom:1px solid var(--line);margin-bottom:20px}
  .acct-title{font-size:18px;font-weight:700;margin:0 0 4px}
  .acct-sub{font-size:13px;color:var(--muted);max-width:72ch;margin:0 0 8px}
  .acct-clock{display:inline-block;font-size:12px;font-weight:700;padding:3px 10px;border-radius:7px;
    border:1px solid color-mix(in srgb,var(--warn) 50%,var(--line));
    color:var(--warn);background:color-mix(in srgb,var(--warn) 10%,transparent)}
  .acct-card{border:1px solid var(--line);border-radius:12px;padding:16px 18px;
    background:var(--panel);margin:0 0 16px;position:relative;overflow:hidden}
  .acct-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;
    background:linear-gradient(90deg,var(--link),color-mix(in srgb,var(--link) 40%,transparent))}
  .acct-card-title{font-size:13px;font-weight:700;margin:0 0 10px;color:var(--text)}
  .acct-empty-state{text-align:center;padding:32px 16px;color:var(--muted);font-size:13px}
  .acct-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums}
  .acct-tbl th{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line);
    color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  .acct-tbl td{text-align:right;padding:6px 8px;border-bottom:1px solid var(--line)}
  .acct-tbl th:first-child,.acct-tbl td:first-child{text-align:left}
  .acct-muted{color:var(--muted)}
  .acct-gap-note{font-size:11.5px;color:var(--muted);font-style:italic;padding:6px 0}
  .acct-cov-row{display:flex;gap:12px;flex-wrap:wrap;margin:8px 0}
  .acct-cov-chip{font-size:12px;padding:3px 9px;border-radius:7px;border:1px solid var(--line);
    color:var(--muted);background:var(--panel)}
  .acct-cov-chip b{color:var(--text)}
  .acct-row-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:0 0 16px}
  @media(max-width:600px){.acct-row-grid{grid-template-columns:1fr}}

  /* ── responsive ── */
  @media(max-width:700px){
    .pl-wrap{padding:0 12px 60px}
    table.sb-tbl{font-size:11.5px}
  }
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}
<div class="pl-wrap">

  <!-- ── Page header ── -->
  <div class="pl-hd">
    <p class="pl-eyebrow">{{ t('CN Pick Lab · Display-only · ACCRUING', 'CN选股实验室 · 仅展示 · 累积中') }}</p>
    <h1 class="pl-title">🧪 {{ t('A-Share Candidate Pick Engines', 'A股候选选股引擎') }}</h1>
    <p class="pl-sub">{{ t('20 shadow books running on forward ledgers — measured against a random-control yardstick and the CSI 300. Ruler: 21-session CSI 300 excess (T+1 fill, hl2 proxy). All data is display-only; nothing here drives live selection or gating.', '20个影子书在前向账本上运行 — 与随机控制基准和沪深300对比衡量。标尺：21节沪深300超额（T+1入场，最高最低均价代理）。所有数据仅供展示；这里没有任何内容驱动实时选股或门控。') }}</p>
    {% if as_of %}<p class="pl-asof">{{ t('As of', '截至') }} {{ as_of }} · {{ t('Built', '生成时间') }} {{ built }}</p>{% endif %}
    <a class="pl-back" href="china_stocks.html">← {{ t('Back to A-Share Dashboard', '返回A股看板') }}</a>
  </div>

  <!-- ── Tab buttons ── -->
  <div class="pl-tabs" role="tablist">
    <button class="tabbtn on" data-tab="scoreboard" role="tab">{{ t('Scoreboard', '记分板') }}</button>
    <button class="tabbtn" data-tab="velocity" role="tab">{{ t('1D Velocity CN', '1日速度A股') }}</button>
    <button class="tabbtn" data-tab="allbooks" role="tab">{{ t('All Books', '全部书本') }}</button>
    <button class="tabbtn" data-tab="accountability" role="tab">{{ t('Record', '记录') }}</button>
    <button class="tabbtn" data-tab="method" role="tab">{{ t('Method', '方法') }}</button>
  </div>

  <!-- ================================================================ -->
  <!-- TAB 1: SCOREBOARD                                                 -->
  <!-- ================================================================ -->
  <section data-tab-panel="scoreboard" style="display:block">
    {% if empty %}
    <div class="pl-empty">
      <div class="pl-empty-icon">🧪</div>
      <h2>{{ t('First accrual tonight', '今晚首次累积') }}</h2>
      <p>{{ t('The CN lab runs in the asia-close lane nightly. The scoreboard will appear here after the first snapshot is taken and the first picks are fired.', 'CN实验室在亚盘收市通道每晚运行。首次快照拍摄并触发第一批选择后，记分板将出现在这里。') }}</p>
    </div>
    {% else %}
    {% if total_skipped_unfillable is not none %}
    <div class="sb-skip">
      ⚠ {{ t('Sealed-up (unfillable) fires excluded from grading this session', '本期已封涨停（不可成交）触发已从评级中排除') }}:
      <b>{{ total_skipped_unfillable }}</b>
      {{ t('(T+1 fill requires an open — sealed limit-up at fire close → logged but not graded per CNPL-R4)', '（T+1入场需要开盘 — 触发时封于涨停价 → 已记录但不评级，见CNPL-R4）') }}
    </div>
    {% endif %}
    <div class="sb-note">
      <b>{{ t('How to read this table:', '如何阅读此表：') }}</b>
      {{ t('All 20 CN entry books measured against the Random Control yardstick (pinned at bottom) and CSI 300. ACCRUING = fewer than 25 fires across 3 months — do not act on these numbers yet. Store-dependent books (Block Discount, LHB Inst) show DATA GAP when the runner-local store is absent. The Chase Avoid book is an INVERSE book — expected negative excess. Do not treat Chase Avoid picks as buy signals.', '所有20本CN入场书均与随机控制基准（固定在底部）和沪深300对比。ACCRUING = 3个月内少于25次触发 — 暂不据此行动。依存数据的书（大宗折价、龙虎榜）在本地数据库缺失时显示数据缺失。追涨规避书是反向书 — 预期负超额。切勿将追涨规避选择视为买入信号。') }}
    </div>
    <div class="tbl-scroll">
      <table class="sb-tbl" aria-label="CN Scoreboard">
        <thead>
          <tr>
            <th class="l">{{ t('Book', '书本') }}</th>
            <th>{{ t('Fam', '族') }}</th>
            <th>{{ t('Status', '状态') }}</th>
            <th>{{ t('N fires', 'N触发') }}</th>
            <th>{{ t('Skip ↑↑', '跳过↑↑') }}</th>
            <th>{{ t('N open', 'N开放') }}</th>
            <th>{{ t('Dates', '日期') }}</th>
            <th>{{ t('Mo span', '月跨') }}</th>
            <th>{{ t('WR21 abs', 'WR21绝对') }}</th>
            <th>{{ t('WR21 CSI exc', 'WR21沪深超额') }}</th>
            <th>{{ t('Med exc21', '中位超额21') }}</th>
            <th>{{ t('MFE med', 'MFE中位') }}</th>
            <th>{{ t('MAE med', 'MAE中位') }}</th>
            <th>{{ t('Asym', '非对称') }}</th>
            <th>{{ t('NAV exc cum', 'NAV累积超额') }}</th>
            <th>{{ t('Max DD', '最大回撤') }}</th>
            <th>{{ t('vs Rand', '对比随机') }}</th>
            <th>{{ t('vs Univ', '对比全市场') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for row in scoreboard %}
          <tr class="{{ 'row-random' if row.is_random else ('row-inverse' if row.is_inverse else ('row-data-gap' if row.has_data_gap else '')) }}">
            <td class="name-cell l" style="white-space:normal;min-width:180px">
              <span class="family-badge">{{ row.family }}</span>
              <span class="l-en">{{ row.name_en }}</span>
              <span class="l-zh">{{ row.name_zh }}</span>
              {% if row.is_random %}<span class="sb-yardstick-label">{{ t('(yardstick)', '(基准)') }}</span>{% endif %}
              {% if row.is_inverse %}<span class="avoid-label">{{ t('NOT BUY — AVOID', '非买入 — 规避') }}</span>{% endif %}
              {% if row.has_data_gap %}<span class="badge-data-gap">{{ t('DATA GAP', '数据缺失') }}</span>{% endif %}
            </td>
            <td>{{ row.family }}</td>
            <td>
              {% if row.has_data_gap %}
              <span class="badge-data-gap">
                <span class="l-en">DATA GAP</span>
                <span class="l-zh">数据缺失</span>
              </span>
              {% else %}
              <span class="{{ row.status_badge.css }}">
                <span class="l-en">{{ row.status_badge.label_en }}</span>
                <span class="l-zh">{{ row.status_badge.label_zh }}</span>
              </span>
              {% endif %}
            </td>
            <td>{{ row.n_fires_fmt }}</td>
            <td class="neu">{{ row.skipped_unfillable_fmt }}</td>
            <td>{{ row.n_open_fmt }}</td>
            <td>{{ row.n_dates_fmt }}</td>
            <td>{{ row.months_span_fmt }}</td>
            <td class="{{ 'pos' if row.wr21_abs is not none and row.wr21_abs >= 0.5 else '' }}">{{ row.wr21_abs_fmt }}</td>
            <td class="{{ 'pos' if row.wr21_excess is not none and row.wr21_excess > 0 else ('neg' if row.wr21_excess is not none and row.wr21_excess < 0 else '') }}">{{ row.wr21_excess_fmt }}</td>
            <td class="{{ 'pos' if row.med_excess21 is not none and row.med_excess21 > 0 else ('neg' if row.med_excess21 is not none and row.med_excess21 < 0 else '') }}">{{ row.med_excess21_fmt }}</td>
            <td>{{ row.mfe_med_fmt }}</td>
            <td>{{ row.mae_med_fmt }}</td>
            <td>{{ row.asym_fmt }}</td>
            <td class="{{ 'pos' if row.nav_excess_cum is not none and row.nav_excess_cum > 0 else ('neg' if row.nav_excess_cum is not none and row.nav_excess_cum < 0 else '') }}">{{ row.nav_excess_cum_fmt }}</td>
            <td class="neg">{{ row.max_dd_fmt }}</td>
            <td class="{{ 'pos' if row.vs_random_lift is not none and row.vs_random_lift > 0 else ('neg' if row.vs_random_lift is not none and row.vs_random_lift < 0 else '') }}">{{ row.vs_random_lift_fmt }}</td>
            <td class="{{ 'pos' if row.vs_universe_lift is not none and row.vs_universe_lift > 0 else ('neg' if row.vs_universe_lift is not none and row.vs_universe_lift < 0 else '') }}">{{ row.vs_universe_lift_fmt }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </section>

  <!-- ================================================================ -->
  <!-- TAB 2: 1D VELOCITY CN                                             -->
  <!-- ================================================================ -->
  <section data-tab-panel="velocity" style="display:none">
    {% if empty %}
    <div class="pl-empty">
      <div class="pl-empty-icon">⚡</div>
      <h2>{{ t('First accrual tonight', '今晚首次累积') }}</h2>
      <p>{{ t('1D velocity picks will appear here after the first nightly build completes.', '首次夜间构建完成后，1日动能选择将出现在这里。') }}</p>
    </div>
    {% else %}
    <p style="font-size:13px;color:var(--muted);margin:0 0 16px;max-width:88ch">
      {{ t('Family B (books 5–8) — 1D oscillator-based entry timing on the A-share tape. The hypothesis: fast-moving A-shares incorporate information in a single session faster than the 2D/3D gates can confirm. First operator read: 2026-08-20. Ruler: 21-session CSI 300 excess.', 'B族（书5–8）— 基于1日振荡器的A股入场时机。假设：快速移动的A股在单个交易日内比2D/3D门确认更快地吸收信息。第一次操作员读取：2026-08-20。标尺：21节沪深300超额。') }}
    </p>

    {% for book in velocity_books %}
    <div class="book-section">
      <div class="book-hd">
        <span class="book-name">
          <span class="family-badge">B</span>
          <span class="l-en">{{ book.name_en }}</span>
          <span class="l-zh">{{ book.name_zh }}</span>
        </span>
        {% if book.data_gap %}
        <span class="badge-data-gap">{{ t('DATA GAP', '数据缺失') }}</span>
        {% elif book.sb %}
        <span class="book-sb">
          {{ t('N', 'N') }}={{ book.sb.n_fires_fmt }}
          · {{ t('WR21 CSI exc', 'WR21沪深超额') }} {{ book.sb.wr21_excess_fmt }}
          · <span class="{{ book.sb.status_badge.css }}">
              <span class="l-en">{{ book.sb.status_badge.label_en }}</span>
              <span class="l-zh">{{ book.sb.status_badge.label_zh }}</span>
            </span>
        </span>
        {% endif %}
      </div>
      {% if book.data_gap %}
      <div class="data-gap-banner">
        <span class="l-en">Runner-local store absent — no picks today (CNPL-R9: honest no-op when store missing)</span>
        <span class="l-zh">本地数据库缺失 — 今日无选择（CNPL-R9：数据库缺失时诚实空操作）</span>
      </div>
      {% elif book.picks_today %}
      <div class="pick-grid">
        {% for p in book.picks_today %}
        <div class="pick-card">
          <div class="pick-top">
            <span class="pick-rank">#{{ p.rank }}</span>
            <span class="pick-tk">{{ p.ticker }}</span>
            <span class="pick-close">{{ p.close_fmt }}</span>
          </div>
          {% if p.sector %}<div class="pick-sector">{{ p.sector }}</div>{% endif %}
          {% if p.why %}
          <div class="pick-why">
            {% for chip in p.why %}<span class="why-chip accent">{{ chip }}</span>{% endfor %}
            {% if p.limit_chip_en %}
            <span class="why-chip limit">{{ p.limit_chip_en }}</span>
            {% endif %}
          </div>
          {% endif %}
          {% if p.features %}
          <div class="pick-feats">
            {% for k, v in p.features.items() %}<span><b>{{ k }}</b> {{ v }}</span>{% endfor %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% else %}
      <p class="no-picks">{{ t('No picks today for this book.', '今日此书无选择。') }}</p>
      {% endif %}

      {% if book.recent_fires %}
      <p class="fires-hd">{{ t('Recent graded fires', '近期已评级触发') }}</p>
      <table class="fires-tbl">
        <thead><tr>
          <th>{{ t('Ticker', '代码') }}</th>
          <th>{{ t('Fire date', '触发日期') }}</th>
          <th>{{ t('Fill basis', '入场基准') }}</th>
          <th>{{ t('21d CSI exc', '21日沪深超额') }}</th>
          <th>{{ t('Status', '状态') }}</th>
        </tr></thead>
        <tbody>
          {% for f in book.recent_fires %}
          <tr>
            <td>{{ f.ticker }}</td>
            <td>{{ f.fire_date }}</td>
            <td class="neu">{{ f.fill_basis_label }}</td>
            <td class="{{ 'pos' if f.ret21_excess is not none and f.ret21_excess > 0 else ('neg' if f.ret21_excess is not none and f.ret21_excess < 0 else '') }}">{{ f.ret21_excess_fmt }}</td>
            <td>{{ f.matured_label }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
    {% endfor %}
    {% endif %}
  </section>

