{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cross-Asset Vector — trend · ratios · correlation regime</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  body{background:var(--bg);color:var(--text);font:14px/1.5 Inter,-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif;margin:0;padding:18px}
  @media(min-width:1100px){body{padding:26px max(20px,calc((100vw - 1180px)/2))}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:14px}
  h2{font-size:15px;font-weight:700;margin:0 0 10px}
  .ca-wrap{max-width:1180px;margin:0 auto;padding:0 4px}
  .ca-hero{font-size:26px;font-weight:800;margin:2px 0 4px}
  .ca-sub{color:var(--muted);font-size:13px;margin:0 0 6px}
  .ca-note{color:var(--muted);font-size:12px;line-height:1.5;border-top:1px solid var(--line);margin-top:10px;padding-top:8px}
  .ca-verdict{display:inline-block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:2px 8px;border-radius:6px;background:var(--amber-bg,rgba(217,160,60,.16));color:var(--amber,#c98a2e)}
  table.ca{border-collapse:collapse;width:100%;font-size:13px}
  table.ca th,table.ca td{text-align:left;padding:5px 9px;border-bottom:1px solid var(--line);vertical-align:middle}
  table.ca th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.04em;font-weight:700}
  table.ca td.r,table.ca th.r{text-align:right;font-variant-numeric:tabular-nums}
  .trend-up{color:var(--up,#16a34a);font-weight:700}.trend-down{color:var(--down,#dc2626);font-weight:700}.trend-mixed{color:var(--muted)}
  .sbar{display:inline-block;width:64px;height:7px;border-radius:4px;background:var(--line);position:relative;vertical-align:middle;margin-right:6px}
  .sbar i{position:absolute;top:0;height:7px;border-radius:4px}
  .chip{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;padding:1px 6px;border-radius:5px;background:var(--line);color:var(--muted)}
  .st-elevated{background:rgba(220,38,38,.16);color:#dc2626}.st-depressed{background:rgba(22,163,74,.16);color:#16a34a}
  .cmat td,.cmat th{padding:3px 7px;font-size:12px;text-align:center;border:1px solid var(--line)}
  .pos{color:var(--up,#16a34a)}.neg{color:var(--down,#dc2626)}.muted{color:var(--muted)}.sm{font-size:12px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:820px){.grid2{grid-template-columns:1fr}}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap ca-wrap">

  <!-- ===================== REGIME HERO ===================== -->
  {% set bcol = 'var(--up,#16a34a)' if (breadth or 0) >= 0.34 else 'var(--down,#dc2626)' if (breadth or 0) <= -0.34 else 'var(--muted)' %}
  <div class="card">
    <div class="ca-sub">🧭 {{ t('Cross-Asset Vector', '跨资产向量') }} · {{ t('as of', '截至') }} {{ as_of }}</div>
    <div class="ca-hero" style="color:{{ bcol }}">{{ td(regime) }}</div>
    <div class="ca-sub">{{ t('Trend breadth', '趋势广度') }}
      <b style="color:{{ bcol }}">{{ '%+.2f'|format(breadth) }}</b>
      <span class="muted">({{ trend.n_up }} {{ t('up', '上行') }} / {{ trend.n_down }} {{ t('down', '下行') }} {{ t('of', '/共') }} {{ trend.n }})</span>
    </div>
    <p class="ca-note">
      <span class="ca-verdict">{{ t('contested', '存疑') }}</span>
      {{ t('Cross-asset TREND = time-series momentum (sign of the trailing 3/6/12-month return). The timing carries REAL skill — it beats a permutation null (p≈0.01) — but after an 8bps cost it only matches an equal-weight buy&hold and does NOT clear the Deflated-Sharpe multiple-testing bar (DSR≈0.80). So it is shown here as a REGIME / CONTEXT read of what is trending across asset classes — NOT a strategy or a buy list. AQR’s widely-quoted gross ~1.8 Sharpe is contested and gross-of-cost; our honest after-cost number is in scripts/cross_asset_phase0.py → reports/cross-asset-phase0.md.',
         '跨资产趋势 = 时间序列动量（过去 3/6/12 个月收益的符号）。其择时确有真实技能——能击败置换检验零假设（p≈0.01）——但在扣除 8bps 成本后仅与等权买入持有持平，且无法通过 Deflated-Sharpe 的多重检验门槛（DSR≈0.80）。因此这里仅作为「各资产类别在趋势什么」的体制/背景判读——并非策略或买入清单。AQR 常被引用的约 1.8 夏普为毛收益且存在争议；我们扣费后的诚实数值见 scripts/cross_asset_phase0.py → reports/cross-asset-phase0.md。') }}
    </p>
  </div>

  <!-- ===================== GLOBAL CB LIQUIDITY ===================== -->
  {% if liquidity %}
  {% set i13 = liquidity.impulse_pct.get('13w') %}
  {% set icol = 'var(--up,#16a34a)' if (i13 or 0) > 0 else 'var(--down,#dc2626)' if (i13 or 0) < 0 else 'var(--muted)' %}
  <div class="card">
    <h2>{{ t('Global central-bank liquidity', '全球央行流动性') }}</h2>
    <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap">
      <div class="ca-hero" style="font-size:22px;margin:0">${{ liquidity.total_usd_tn }}T</div>
      <div>
        <span class="chip" style="background:rgba(125,141,163,.16);color:{{ icol }}">{{ t(liquidity.state, {'expanding':'扩张','contracting':'收缩','flat':'持平'}.get(liquidity.state, liquidity.state)) }} · {{ t(liquidity.accel, {'accelerating':'加速','decelerating':'减速','steady':'平稳'}.get(liquidity.accel, liquidity.accel)) }}</span>
        <div class="muted sm" style="margin-top:4px">
          {% for w, v in liquidity.impulse_pct.items() %}{{ w }} <b style="color:{{ 'var(--up,#16a34a)' if (v or 0)>=0 else 'var(--down,#dc2626)' }}">{{ ('%+.1f%%'|format(v)) if v is not none else '—' }}</b>{% if not loop.last %} · {% endif %}{% endfor %}
        </div>
      </div>
      {% if liq_spark %}<svg width="184" height="40" style="margin-left:auto"><polyline points="{{ liq_spark }}" fill="none" stroke="{{ icol }}" stroke-width="1.6"/></svg>{% endif %}
    </div>
    <table class="ca" style="margin-top:8px">
      <tr><th>{{ t('central bank', '央行') }}</th><th class="r">{{ t('assets ($T)', '资产($万亿)') }}</th><th class="r">{{ t('share', '占比') }}</th><th style="width:38%"></th></tr>
      {% for b in liquidity.banks %}
      {% set _asof_age = '' %}
      {% if b.raw_asof %}
        {% set _asof_label %}<span class="muted sm" style="font-weight:400;margin-left:4px">{{ b.raw_asof }}</span>{% endset %}
      {% else %}
        {% set _asof_label = '' %}
      {% endif %}
      <tr><td><b>{{ t(b.label_en, b.label_zh) }}</b>{{ _asof_label|safe }}</td>
        <td class="r">{{ b.usd_tn }}</td><td class="r muted">{{ b.share }}%</td>
        <td><span class="sbar" style="width:100%"><i style="left:0;width:{{ b.share|round|int }}%;background:var(--muted)"></i></span></td></tr>
      {% endfor %}
    </table>
    <p class="ca-note">{{ t(liquidity.note, '全球央行资产负债表流动性（美联储+欧洲央行+日本央行），以美元汇总。其变化率（脉冲）以可变滞后（数周至数月）领先风险资产；上升=流动性顺风。仅作背景，非信号：英格兰银行（FRED 仅年度）与中国央行（无无密钥序列）未纳入。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== FUNDING / REPO STRESS ===================== -->
  {% if funding %}
  {% set fcol = 'var(--down,#dc2626)' if funding.state == 'stressed' else 'var(--amber,#c98a2e)' if funding.state == 'watch' else 'var(--up,#16a34a)' %}
  <div class="card">
    <h2>{{ t('Funding & repo plumbing', '资金与回购管道') }}</h2>
    <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap">
      <div class="ca-hero" style="font-size:20px;margin:0;color:{{ fcol }}">{{ t(funding.state, {'calm':'平静','watch':'关注','stressed':'紧张'}.get(funding.state, funding.state)) }}</div>
      <div class="muted sm">{{ t('stress score', '压力分') }} <b style="color:{{ fcol }}">{{ funding.score }}</b>/100 · {{ t('SOFR−EFFR', 'SOFR−联邦基金') }} <b>{{ '%+.0f'|format(funding.spread_bp) }}bp</b>{% if funding.dispersion_bp is not none %} · {{ t('dispersion', '离散度') }} <b>{{ funding.dispersion_bp }}bp</b>{% endif %}</div>
      {% if fund_spark %}<svg width="184" height="40" style="margin-left:auto"><polyline points="{{ fund_spark }}" fill="none" stroke="{{ fcol }}" stroke-width="1.6"/></svg>{% endif %}
    </div>
    <table class="ca" style="margin-top:8px">
      <tr><th>{{ t('gauge', '指标') }}</th><th class="r">{{ t('value', '数值') }}</th><th class="r">{{ t('%ile (2y)', '分位(2年)') }}</th><th style="width:34%"></th></tr>
      {% for r in funding.rows %}
      <tr title="{{ r.note }}"><td><b>{{ t(r.label_en, r.label_zh) }}</b><div class="muted sm">{{ r.note }}</div></td>
        <td class="r">{{ r.value }}{{ r.unit }}</td><td class="r muted">{{ (r.pctile|round|int) if r.pctile is not none else '—' }}</td>
        <td><span class="sbar" style="width:100%"><i style="left:0;width:{{ (r.pctile|round|int) if r.pctile is not none else 0 }}%;background:{{ fcol }}"></i></span></td></tr>
      {% endfor %}
    </table>
    {% if funding.levels %}<div class="muted sm" style="margin-top:6px">{% for l in funding.levels %}{{ l.label }} <b>{{ l.value }}%</b>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    <p class="ca-note">{{ t(funding.note, '来自 OFR 纽约联储参考利率（无密钥）的资金/回购管道。SOFR 高于 EFFR 且 SOFR 分布走阔预示准备金稀缺/回购紧张（2019年9月的信号）。各项按其约2年区间打分。仅作背景，非信号——从不进入任何评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== TREND BOARD ===================== -->
  <div class="card">
    <h2>{{ t('Trend board — time-series momentum by asset', '趋势看板 — 各资产时间序列动量') }}</h2>
    <table class="ca">
      <tr><th>{{ t('asset', '资产') }}</th><th>{{ t('class', '类别') }}</th><th>{{ t('trend', '趋势') }}</th>
        <th>{{ t('strength', '强度') }}</th><th class="r">{{ t('3m', '3月') }}</th><th class="r">{{ t('6m', '6月') }}</th><th class="r">{{ t('12m', '12月') }}</th></tr>
      {% for r in trend.rows %}
      {% set tc = 'trend-up' if r.trend=='up' else 'trend-down' if r.trend=='down' else 'trend-mixed' %}
      {% set sc = 'var(--up,#16a34a)' if r.score>0 else 'var(--down,#dc2626)' if r.score<0 else 'var(--muted)' %}
      <tr>
        <td><b>{{ t(r.name_en, r.name_zh) }}</b></td>
        <td class="muted sm">{{ t(r.class_en, r.class_zh) }}</td>
        <td class="{{ tc }}">{{ '▲' if r.trend=='up' else '▼' if r.trend=='down' else '◦' }} {{ t(r.trend, {'up':'上行','down':'下行','mixed':'分化'}.get(r.trend, r.trend)) }}</td>
        <td><span class="sbar"><i style="{{ 'left:50%' if r.score>=0 else 'right:50%' }};width:{{ (r.score|abs*50)|round(0)|int }}%;background:{{ sc }}"></i></span><span class="muted sm">{{ '%+.2f'|format(r.score) }}</span></td>
        {% for rv in [r.ret_3m, r.ret_6m, r.ret_12m] %}
        <td class="r {{ 'pos' if (rv or 0)>=0 else 'neg' }}">{{ ('%+.0f%%'|format(rv)) if rv is not none else '—' }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </table>
    <p class="ca-note">{{ t('Trend = average sign of the trailing 3/6/12-month return (most-recent week skipped). ▲ up = the trend is positive across most horizons. Returns are price-only; the bond leg is a duration-return proxy (−7·Δyield) and the dollar leg trends the DXY level. Context, not a buy list.',
       '趋势 = 过去 3/6/12 个月收益符号的平均（跳过最近一周）。▲上行表示多数周期趋势为正。收益仅为价格收益；债券为久期收益代理（−7·Δ收益率），美元为 DXY 水平趋势。仅作背景，非买入清单。') }}</p>
  </div>

  {% if dollar_factor and dollar_factor.rows %}
  <!-- ===================== DOLLAR FACTOR ===================== -->
  <div class="card">
    <h2>{{ t('Dollar factor — what a stronger USD pushes on', '美元因子 — 强势美元冲击的资产') }}</h2>
    <div class="ca-sub">{{ t('Live 63-day correlation of each market to the broad dollar', '各市场对广义美元的63日实测相关性') }}{% if dollar_factor.usd_dir %} · {{ t('USD now', '当前美元') }} <b>{{ t(dollar_factor.usd_dir, {'strengthening':'走强','weakening':'走软','flat':'横盘'}.get(dollar_factor.usd_dir, dollar_factor.usd_dir)) }}</b>{% endif %}</div>
    <table class="ca">
      <tr><th>{{ t('market', '市场') }}</th><th class="r">{{ t('corr to USD', '对美元相关') }}</th><th>{{ t('if USD ↑', '若美元↑') }}</th><th>{{ t('stability', '稳定性') }}</th></tr>
      {% for r in dollar_factor.rows %}
      <tr>
        <td><b>{{ t(r.label, r.label_zh) }}</b></td>
        <td class="r {{ 'neg' if r.corr<0 else 'pos' }}">{{ '%+.2f'|format(r.corr) }}</td>
        <td class="{{ 'neg' if r.corr<0 else 'pos' }}">{{ t('headwind', '逆风') if r.corr<0 else t('tailwind', '顺风') }}</td>
        <td class="muted sm">{{ t('stable', '稳定') if r.stable else t('flipping', '翻转') }}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="ca-note">{{ t('Contemporaneous co-movement, not a forecast — a stronger dollar tightens global conditions, but the dollar move is often the same risk/tightening impulse. The full panel (stability dots, calm/stress splits, gold\'s real-rate leg) is on the Forex page.', '同步共动，非预测 — 美元走强收紧全球条件，但美元波动往往就是同一风险/紧缩脉冲。完整面板（稳定性、平静/压力分解、黄金实际利率项）见外汇页。') }} <a href="forex.html">{{ t('Forex →', '外汇 →') }}</a></p>
  </div>
  {% endif %}

  <div class="grid2">
    <!-- ===================== INTERMARKET RATIOS ===================== -->
    <div class="card">
      <h2>{{ t('Intermarket ratios', '跨市场比价') }}</h2>
      <table class="ca">
        <tr><th>{{ t('ratio', '比价') }}</th><th class="r">{{ t('value', '数值') }}</th><th class="r">{{ t('%ile (2y)', '分位(2年)') }}</th><th class="r">{{ t('3m', '3月') }}</th></tr>
        {% for r in ratios %}
        <tr title="{{ r.note }}">
          <td><b>{{ t(r.label_en, r.label_zh) }}</b>
            {% if r.state != 'mid' %}<span class="chip st-{{ r.state }}">{{ t(r.state, {'elevated':'偏高','depressed':'偏低'}.get(r.state, r.state)) }}</span>{% endif %}
            <div class="muted sm">{{ r.note }}</div></td>
          <td class="r">{{ r.value }}</td>
          <td class="r muted">{{ (r.pctile|round|int) if r.pctile is not none else '—' }}</td>
          <td class="r {{ 'pos' if (r.chg_3m or 0)>=0 else 'neg' }}">{{ ('%+.0f%%'|format(r.chg_3m)) if r.chg_3m is not none else '—' }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>

    <!-- ===================== CARRY CONTEXT ===================== -->
    <div class="card">
      <h2>{{ t('Carry — current state', '套息 — 当前状态') }}</h2>
      <table class="ca">
        <tr><th>{{ t('source', '来源') }}</th><th class="r">{{ t('carry', '套息') }}</th><th>{{ t('state', '状态') }}</th></tr>
        {% for r in carry.rows %}
        <tr><td>{{ t(r.label_en, r.label_zh) }}</td>
          <td class="r {{ 'pos' if r.value>=0 else 'neg' }}">{{ r.value }}{{ r.unit }}</td>
          <td class="muted sm">{{ r.state }}</td></tr>
        {% endfor %}
      </table>
      <p class="ca-note">{{ t(carry.note, '仅为当前状态的套息背景。利率期限利差历史悠久；商品展期收益由近月合约重建、历史不足两年，故未作因子回测。仅作背景。') }}</p>
    </div>
  </div>

  <!-- ===================== CORRELATION REGIME ===================== -->
  {% if correlation and correlation.verdict and correlation.verdict != 'unknown' %}
  {% set vc = {'concentrated':'var(--down,#dc2626)','converging':'var(--amber,#c98a2e)','diversified':'var(--up,#16a34a)'} %}
  <div class="card">
    <h2>{{ t('Correlation regime — are the markets one bet?', '相关性体制 — 各市场是否同一笔交易') }}</h2>
    <div class="ca-hero" style="font-size:18px;color:{{ vc.get(correlation.verdict,'var(--muted)') }}">{{ t(correlation.verdict, {'concentrated':'高度集中','converging':'趋于收敛','diversified':'分散'}.get(correlation.verdict, correlation.verdict)) }}</div>
    <div class="ca-sub">{{ t('Absorption ratio', '吸收比率') }} <b>{{ correlation.absorption_ratio }}</b>
      <span class="muted">({{ t('PC1 variance share; floor', 'PC1 方差占比；下限') }} {{ correlation.absorption_floor }})</span>
      {% if correlation.dominant_cluster %} · {{ t('dominant cluster', '主导集群') }}: <b>{{ correlation.dominant_cluster|join(', ') }}</b>{% endif %}
    </div>
    {% if correlation.corr_matrix %}
    <div style="overflow-x:auto;margin-top:8px">
      <table class="cmat"><tr><th></th>{% for a in correlation.markets %}<th>{{ a }}</th>{% endfor %}</tr>
        {% for a in correlation.markets %}<tr><th>{{ a }}</th>
          {% for b in correlation.markets %}{% set v = correlation.corr_matrix[a][b] %}
          <td style="background:rgba({{ '220,38,38' if v>0 else '22,163,74' }},{{ (v|abs*0.5)|round(2) }})">{{ '%.2f'|format(v) }}</td>{% endfor %}
        </tr>{% endfor %}
      </table>
    </div>
    {% endif %}
    <p class="ca-note">{{ t(correlation.headline, '') }}</p>
  </div>
  {% endif %}

  <!-- ===================== LEAD / LAG TRANSMISSION ===================== -->
  {% if leadlag and leadlag.verdict and leadlag.verdict != 'unknown' %}
  {% set lv = {'lead':'var(--up,#16a34a)','weak_lead':'var(--amber,#c98a2e)','contemporaneous':'var(--muted)'} %}
  <div class="card">
    <h2>{{ t('Lead / lag transmission — what moves first?', '领先/滞后传导 — 谁先动？') }}</h2>
    <div class="ca-hero" style="font-size:18px;color:{{ lv.get(leadlag.verdict,'var(--muted)') }}">{{ t(
      {'lead':'Lead detected','weak_lead':'Tentative lead','contemporaneous':'No stable lead'}.get(leadlag.verdict, leadlag.verdict),
      {'lead':'检测到领先','weak_lead':'暂定领先','contemporaneous':'无稳定领先'}.get(leadlag.verdict, leadlag.verdict)) }}</div>
    <div class="ca-sub">{{ t('Window', '窗口') }} {{ leadlag.window_d }}d ·
      {{ leadlag.n_significant }}/{{ leadlag.n_tested }} {{ t('pairs survive HAC + FDR', '对通过 HAC + FDR') }}
      {% if leadlag.lead_asset and leadlag.lead_asset.n_followers >= 2 %} · {{ t('lead asset', '领先资产') }}: <b>{{ leadlag.lead_asset.name }}</b>{% endif %}</div>
    <p class="ca-note" style="border-top:none;margin:2px 0 0;padding-top:0">{{ t(leadlag.headline, '') }}</p>
    {% if leadlag.links %}
    <div style="overflow-x:auto;margin-top:8px">
      <table class="ca">
        <tr><th>{{ t('leader → follower', '领先 → 滞后') }}</th><th class="r">{{ t('lag', '滞后') }}</th>
            <th class="r">r</th><th class="r">{{ t('HAC t', 'HAC t') }}</th><th class="r">{{ t('FDR q', 'FDR q') }}</th></tr>
        {% for l in leadlag.links %}
        <tr><td><b>{{ l.leader }}</b> → {{ l.follower }}</td>
            <td class="r">{{ l.lag }}d</td>
            <td class="r {{ 'pos' if l.r >= 0 else 'neg' }}">{{ '%+.2f'|format(l.r) }}</td>
            <td class="r">{{ '%+.1f'|format(l.t) }}</td>
            <td class="r">{{ l.q }}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% endif %}
    <p class="ca-note">{{ t(leadlag.evidence, '') }}
      {{ t('Validation: scripts/cross_asset_leadlag_phase0.py — only timezone lag-1 links are split-half stable.',
           '验证：scripts/cross_asset_leadlag_phase0.py — 仅时区滞后1日链路两半稳定。') }}</p>
  </div>
  {% endif %}

  <div class="card">
    <p class="muted sm" style="margin:0">{{ t(note, '') }} {{ t('Generated', '生成于') }} {{ built }}.
      {{ t('Source: engine/cross_asset_trend.py + the cross-asset correlation leaf, over keyless price stores. Validation: scripts/cross_asset_phase0.py.',
         '来源：engine/cross_asset_trend.py 及跨资产相关性叶子模块，覆盖无密钥价格库。验证：scripts/cross_asset_phase0.py。') }}</p>
  </div>

</div>
<script src="theme.js"></script>
</body>
</html>
