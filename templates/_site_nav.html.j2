{# Shared full navigation chrome for standalone pages.

   The search box is ONE unified universe: theme.js merges every market's nightly
   library (US + China + HK + Canada + Intl) and routes each pick to the analyzer
   that owns it, so pages no longer scope it to a single market.

   Optional page variables:
   - nav_prefix: "../" for pages rendered one directory below site root.
   - nav_search_placeholder_en/nav_search_placeholder_zh: optional placeholder copy.
#}
{% set NP = nav_prefix if (nav_prefix is defined and nav_prefix) else '' %}
<nav class="site-nav">
{% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="{{ nav_search_placeholder_en | default('Search any stock — US, China, HK, Canada & more…') }}"
      data-ph-zh="{{ nav_search_placeholder_zh | default('搜索任意股票 — 美股、A 股、港股、加股等…') }}">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>
