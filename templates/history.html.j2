{% macro help(text) -%}
<span class="help">?<span class="tip">{{ text }}</span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Regime History — {{ latest.date }}</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
  * { box-sizing: border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  a { color:#7aa7e0; text-decoration:none; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:15px; margin:0 0 10px; color:var(--muted);
       text-transform:uppercase; letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:14px; }
  .navbtn { background:var(--panel2); border:1px solid var(--line); color:#7aa7e0;
            padding:5px 14px; border-radius:8px; font-size:13px; }
  .muted { color:var(--muted); }
  .legend { display:flex; flex-wrap:wrap; gap:12px; margin-top:8px; font-size:12px; }
  .legend i { display:inline-block; width:12px; height:12px; border-radius:3px;
              margin-right:5px; vertical-align:-1px; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px;
          height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted);
          font-size:10px; font-weight:600; cursor:help; position:relative;
          vertical-align:middle; margin-left:5px; flex:none; }
  .help .tip { display:none; position:absolute; bottom:140%; left:50%;
               transform:translateX(-50%); width:290px; background:#262b35;
               border:1px solid #3a4150; padding:9px 11px; border-radius:8px; z-index:60;
               font-size:12px; line-height:1.45; color:var(--text); text-align:left;
               font-weight:400; text-transform:none; letter-spacing:normal;
               box-shadow:0 6px 18px rgba(0,0,0,.5); pointer-events:none; }
  .help:hover .tip { display:block; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:right; padding:4px 8px; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:500; }
  th:first-child,td:first-child { text-align:left; }
</style>
</head>
<body>
  <div class="panel">
    <div class="topline">
      <h1>Regime history & charts</h1>
      <span class="muted">data through {{ latest.date }}</span>
      <span style="flex:1"></span>
      <a class="navbtn" href="index.html">← Back to dashboard</a>
      <a class="navbtn" href="validation_timeline.html">Full 2007→ backtest</a>
      <button class="theme-btn">☀️ Light</button>
    </div>
  </div>

  <div class="panel">
    <h2>Three years of regimes over the S&P 500
      {{ help("The S&P 500 with the regime active at each time shaded behind it — how the classifier actually behaved in real conditions. For the full 2007-onward record including the validation stats, use the backtest link above.") }}
    </h2>
    {{ chart_regime | safe }}
    <div class="legend">
      <span><i style="background:var(--q1)"></i><b>Goldilocks</b> — growth ↑ inflation ↓ (best for tech/quality)</span>
      <span><i style="background:var(--q2)"></i><b>Reflation</b> — growth ↑ inflation ↑ (cyclicals/energy/banks)</span>
      <span><i style="background:var(--q3)"></i><b>Stagflation</b> — growth ↓ inflation ↑ (historically the dangerous one)</span>
      <span><i style="background:var(--q4)"></i><b>Growth scare</b> — growth ↓ inflation ↓ (defensives/bonds)</span>
    </div>
  </div>

  <div class="panel">
    <h2>The two dials over time
      {{ help("History of the growth (green) and inflation (red) scores. Zero-line crossings are where regimes change; persistent readings near ±0.5 are strong regimes; hovering near zero = mixed, choppy environment.") }}
    </h2>
    {{ chart_axes | safe }}
  </div>

  <div class="panel">
    <h2>Regime lifespans — the base rates behind "what's next"
      {{ help("Every regime period since 2007 in this classifier: how many there were, how long they typically lasted, and where they went when they ended. These are the base rates the front page's odds come from.") }}
    </h2>
    <table>
      <tr><th>regime</th><th>periods</th><th>median length (days)</th><th>most common next</th></tr>
      {% for row in lifespan_rows %}
      <tr><td>{{ row.name }}</td><td>{{ row.n }}</td><td>{{ row.median }}</td><td>{{ row.next }}</td></tr>
      {% endfor %}
    </table>
  </div>

  <p class="muted">Generated {{ generated_utc }} UTC</p>
<script src="theme.js"></script>
</body>
</html>
