{# ============================================================================
   IGNITION RADAR CARD (.igx) — risk-ON mirror of the Risk Radar.
   点火雷达 — 风险偏好正向证据仪表。

   Import and call:
       {% import "_ignition_radar_card.html.j2" as igc %}
       {% if ignition_radar %}{{ igc.ignition_radar_card(ignition_radar) }}{% endif %}

   The card renders NOTHING when the payload is absent (first nightly hasn't run).
   Every access is guarded by truthiness — NEVER `is not none`.

   Icon ladder: 🚀 ignited / 🔥 warming / ⚪ off
   Fragile regime shows ⚠️ beside the theme name.
   ============================================================================ #}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}

{% macro ignition_radar_card(ig) -%}
{%- if ig %}
{%- set state = ig.state if ig.state else 'off' -%}
{%- set ic = '🚀' if state == 'ignited' else ('🔥' if state == 'warming' else '⚪') -%}
{%- set regime = ig.regime if ig.regime else {} -%}
{%- set fragile = regime.fragile if regime.fragile else false -%}
<div class="igx igx-{{ state }}">
  <div class="igx-hd">
    <span class="igx-ic">{{ ic }}</span>
    <div class="igx-id">
      <div class="igx-ttl">
        {{ t('Ignition Radar','点火雷达') }}
        {# BIL-04: translate state badge to ZH #}
        {%- set _igx_state_zh = {'off':'未触发','warming':'预热中','ignited':'已点火'}.get(state, state|upper) -%}
        <span class="igx-badge">{{ t(state|upper, _igx_state_zh) }} · K={{ ig.k_count|default(0) }}/8</span>
        {{ help('Risk-ON evidence gauge — the Risk Radar\'s mirror. Confluence of breadth-thrust events and participation. Display-only, forward-graded; not a buy signal.', '正向风险偏好证据仪表 — 风险雷达的镜像。广度推进事件与参与度的共振读数。仅展示，前瞻评分中；非买入信号。') }}
      </div>
      {%- set nt = ig.narrow_top if ig.narrow_top else {} -%}
      {%- if nt and nt.score and nt.score >= 0.55 and nt.streak_sessions and nt.streak_sessions >= 3 and state in ('off', 'warming') %}
      <div class="igx-persist">
        <span class="l-en">{{ nt.name }} running · day {{ nt.streak_sessions }}</span>
        <span class="l-zh">{{ nt.name_zh }} 持续运行 · 第{{ nt.streak_sessions }}日</span>
      </div>
      {%- endif %}
      {%- if regime.label_en %}
      <div class="igx-glance">{{ t(regime.label_en, regime.label_zh) }}</div>
      {%- endif %}
      {%- if fragile %}
      <div class="igx-fragile">⚠️ {{ t('Fragile until participation broadens','需参与度扩散方可确认') }}</div>
      {%- endif %}
    </div>
  </div>

  {# broad chip rows #}
  {%- if ig.chips %}
  <div class="igx-chips">
    <span class="igx-k">{{ t('Broad K','宽幅K') }}:</span>
    {%- for c in ig.chips %}
    <span class="igx-chip{{ ' lit' if c.lit }}{{ ' fresh' if c.fresh }}">
      <span class="igx-chip-dot"></span>
      {{ t(c.label_en, c.label_zh) }}
    </span>
    {%- endfor %}
  </div>
  {%- endif %}

  {# narrow theme strip — top 3 items.
     Note: ig.narrow is a dict with an "items" key. Access via ['items'] to avoid
     confusing Jinja's .items dict-method with the payload field. #}
  {%- set narrow = ig.narrow if ig.narrow else {} %}
  {%- set narrow_items = narrow['items'] if narrow['items'] is defined else [] %}
  {%- if narrow_items %}
  <div class="igx-narrow">
    <span class="igx-narrow-k">{{ t('Theme','主题') }}</span>
    {%- for it in narrow_items[:3] %}
    {%- set sc = it.ignition_score|default(0) %}
    <span class="igx-theme {{ it.state if it.state else 'idle' }}">
      {%- if it.state == 'igniting' and (ig.regime and ig.regime.fragile) %}⚠️ {% endif %}
      {{ it.name if it.name else it.id }}
      <span class="igx-theme-score">{{ (sc * 100)|round|int }}%</span>
      <span class="igx-theme-flags">
        {%- if it.rs_new_high %}🔺{%- endif %}
        {%- if it.above_200d_rising %}↗{%- endif %}
      </span>
    </span>
    {%- endfor %}
  </div>
  {%- endif %}

  {# cross-ref chip #}
  {%- set xref = ig.radar_xref if ig.radar_xref else {} %}
  {%- if xref.state or xref.phase %}
  <div class="igx-xref">
    <span class="igx-xref-k">{{ t('Risk Radar','风险雷达') }}:</span>
    {{ xref.state if xref.state else '—' }}
    {%- if xref.phase %} · {{ xref.phase }}{%- endif %}
  </div>
  {%- endif %}

  {# do-line #}
  {%- if regime.do_en %}
  <div class="igx-do">
    <span class="igx-do-k">{{ t('Note','注意') }}</span>{{ t(regime.do_en, regime.do_zh) }}
  </div>
  {%- endif %}

  {# self-audit accruing line #}
  <div class="igx-audit">
    <span class="igx-audit-k">🧾 {{ t('Self-audit','自审') }}</span>
    {%- set fl = ig.forward_log if ig.forward_log else {} %}
    {%- if fl.n_graded and fl.n_graded > 0 %}
    {{ fl.n_graded }} {{ t('graded','已评分') }}
    {%- if fl.broad_tp_rate is defined and fl.broad_tp_rate != none %} · {{ t('broad TP','宽幅真阳率') }} {{ (fl.broad_tp_rate * 100)|round|int }}%{%- endif %}
    · {{ t('display-only','仅展示') }}
    {%- else %}
    {{ t('accruing — display-only until ≥30 grades + operator ruling','积累中 — 至少30次评分及运营员决定前仅展示') }}
    {%- endif %}
  </div>
</div>
{%- endif %}
{%- endmacro %}

{# ============================================================================
   IGNITION RADAR STRIP (.igs) — compact span12 variant for the us_stocks page.
   One horizontal card: state + plain glance line, 8-signal dot bar (labels and
   mechanics demoted to hover tips), top-theme chips, one merged footer.
   The macro-mode tray keeps ignition_radar_card() above.
   Renders NOTHING when the payload is absent; truthiness guards only.
   ============================================================================ #}
{% macro ignition_radar_strip(ig) -%}
{%- if ig %}
{%- set state = ig.state if ig.state else 'off' -%}
{%- set ic = '🚀' if state == 'ignited' else ('🔥' if state == 'warming' else '⚪') -%}
{%- set regime = ig.regime if ig.regime else {} -%}
{%- set fragile = regime.fragile if regime.fragile else false -%}
<div class="panel span12 igs igs-{{ state }}">
  <div class="igs-top">
    <span class="igs-ic">{{ ic }}</span>
    <span class="igs-ttl">{{ t('Ignition Radar','点火雷达') }}</span>
    <span class="igs-state">
      {%- if state == 'ignited' %}{{ t('Ignited','点火') }}
      {%- elif state == 'warming' %}{{ t('Warming up','升温中') }}
      {%- else %}{{ t('Quiet','静默') }}{% endif -%}
    </span>
    {#- narrow-persistence honesty (M7C-R7): a theme running for days must not be
        buried by a quiet broad state — same gate as the card variant above. -#}
    {%- set nt = ig.narrow_top if ig.narrow_top else {} -%}
    {%- if nt and nt.score and nt.score >= 0.55 and nt.streak_sessions and nt.streak_sessions >= 3 and state in ('off', 'warming') %}
    <span class="igs-glance"><span class="l-en">{{ nt.name }} running · day {{ nt.streak_sessions }}</span><span class="l-zh">{{ nt.name_zh if nt.name_zh else nt.name }} 持续运行 · 第{{ nt.streak_sessions }}日</span></span>
    {%- endif %}
    {{ help('Risk-ON evidence gauge — the Risk Radar\'s mirror. Counts eight broad-market signals (breadth thrusts + participation confirms — hover each dot for what it watches) and theme-level turn evidence across the narrative baskets and sector ETFs. Self-graded nightly against what actually happened next; stays display-only until 30+ graded calls and an operator ruling. Evidence, not a buy signal.', '正向风险偏好证据仪表 — 风险雷达的镜像。统计八个大盘信号（广度推进 + 参与度确认 — 悬停各圆点查看含义）及叙事篮子与行业ETF的主题级转折证据。每晚以后续实际走势自评；累计30次评分并经运营员裁定前仅供展示。仅为证据，非买入信号。') }}
    {%- if regime.label_en %}
    <span class="igs-glance">{% if fragile %}<span class="igs-frag">⚠</span> {% endif %}{{ t(regime.label_en, regime.label_zh) }}</span>
    {%- endif %}
  </div>
  <div class="igs-ev">
    {%- if ig.chips %}
    <span class="igs-k">{{ t('Broad market','大盘') }}</span>
    {#- 4 thrust events + 4 participation confirms (compute_broad concatenation
        order) — a small gap separates the two families; each dot's family rides
        its hover tip. -#}
    <span class="igs-dots">
      {%- for c in ig.chips %}
      {%- if loop.index0 == 4 %}<span class="igs-dotsep"></span>{% endif %}
      {%- set fam_en = 'Thrust event' if loop.index0 < 4 else 'Participation confirm' %}
      {%- set fam_zh = '推进事件' if loop.index0 < 4 else '参与度确认' %}
      <span class="igs-dot{{ ' lit' if c.lit }}{{ ' fresh' if c.fresh }}"
        data-tip-en="{{ fam_en }} · {{ c.label_en }}{% if c.detail_en %} — {{ c.detail_en }}{% endif %}"
        data-tip-zh="{{ fam_zh }} · {{ c.label_zh }}{% if c.detail_zh %} — {{ c.detail_zh }}{% endif %}"></span>
      {%- endfor %}
    </span>
    <span class="igs-kcount">{{ ig.k_count|default(0) }} {{ t('of 8 lit','/ 8 亮起') }}</span>
    {%- endif %}
    {%- set narrow = ig.narrow if ig.narrow else {} %}
    {%- set narrow_items = narrow['items'] if narrow['items'] is defined else [] %}
    {%- if narrow_items %}
    <span class="igs-div"></span>
    <span class="igs-k">{{ t('Hottest themes','最热主题') }}</span>
    {%- for it in narrow_items[:3] %}
    {%- set sc = it.ignition_score|default(0) %}
    <span class="igs-theme {{ it.state if it.state else 'idle' }}"
      data-tip-en="Turn evidence {{ (sc * 100)|round|int }}% — how much of this theme's checklist (member thrust, relative strength turning up, multi-timeframe confirm) is lit right now{% if it.rs_new_high %} · relative strength at a 6-month high{% endif %}{% if it.above_200d_rising %} · above a rising 200-day average{% endif %}"
      data-tip-zh="转折证据 {{ (sc * 100)|round|int }}% — 该主题清单（成分推进、相对强度转折、多周期确认）当前的亮起比例{% if it.rs_new_high %} · 相对强度创6个月新高{% endif %}{% if it.above_200d_rising %} · 高于上升中的200日均线{% endif %}">
      {{- it.name if it.name else it.id }} <b>{{ (sc * 100)|round|int }}%</b>
      {%- if it.rs_new_high %} 🔺{% endif %}{% if it.above_200d_rising %} ↗{% endif -%}
    </span>
    {%- endfor %}
    {%- endif %}
    {%- set xref = ig.radar_xref if ig.radar_xref else {} %}
    {%- if xref.state %}
    <span class="igs-xref" data-tip-en="The risk-OFF gauge this one mirrors — its current read, from the Macro dashboard." data-tip-zh="本仪表所镜像的风险预警雷达当前读数（见宏观看板）。">{{ t('Risk Radar','风险雷达') }}: {{ xref.state }}{% if xref.phase %} · {{ xref.phase }}{% endif %}</span>
    {%- endif %}
  </div>
  {%- if regime.do_en %}
  {#- Stance token (Law 1): deterministic display mapping from engine state —
      never escalates beyond the engine's own do-line. -#}
  {%- set _any_igniting = narrow_items and (narrow_items | selectattr('state', 'equalto', 'igniting') | list | length > 0) %}
  <div class="igs-ft">
    <span class="igs-stance">
      {%- if state == 'ignited' %}{{ t('Get ready','做好准备') }}
      {%- elif state == 'warming' or fragile or _any_igniting %}{{ t("Watch — don't chase",'观望 — 勿追高') }}
      {%- else %}{{ t('Nothing to act on yet','暂无可操作信号') }}{% endif -%}
    </span>
    <span class="igs-ft-body">
    {{ t(regime.do_en, regime.do_zh) }}
    {%- set fl = ig.forward_log if ig.forward_log else {} %}
    {%- if fl.n_graded and fl.n_graded > 0 %}
    · {{ fl.n_graded }} {{ t('calls self-graded so far','次判读已自评') }}{% if fl.broad_tp_rate is defined and fl.broad_tp_rate != none %} — {{ (fl.broad_tp_rate * 100)|round|int }}% {{ t('of broad calls confirmed','的大盘判读获确认') }}{% endif %}
    {%- else %}
    · {{ t('still building its self-graded track record','自评记录积累中') }}
    {%- endif %}
    </span>
    {%- if ig.as_of %}<span class="igs-asof">{{ t('as of','截至') }} {{ ig.as_of }}</span>{% endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}
{%- endmacro %}
