            <th class="l-en">Stratum</th><th class="l-zh">层</th>
            <th data-tip-en="Raw row count" data-tip-zh="原始行数">
              <span class="l-en">Raw n</span><span class="l-zh">原始n</span>
            </th>
            <th data-tip-en="Cluster-unit effective sample (entry-date-collapsed, 21d windows)" data-tip-zh="集群单元有效样本（入场日折叠，21日窗口）">
              <span class="l-en">Eff. n</span><span class="l-zh">有效n</span>
            </th>
            <th><span class="l-en">State</span><span class="l-zh">状态</span></th>
          </tr></thead>
          <tbody>
            {% for key, cell in (acct.get('strata') or {}).items() %}
            <tr>
              <td colspan="2" style="text-align:left">{{ key }}</td>
              <td>{{ cell.get('raw_n') if cell.get('raw_n') is not none else '—' }}</td>
              <td>{{ cell.get('effective_n') if cell.get('effective_n') is not none else '—' }}</td>
              <td>
                {% if cell.get('state') == 'ACCRUING' %}
                <span class="badge-accruing">
                  <span class="l-en">ACCRUING</span><span class="l-zh">累积中</span>
                </span>
                {% else %}
                {{ cell.get('state') or '—' }}
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="acct-empty-state">
        <div class="acct-empty-icon">📊</div>
        <p>
          <span class="l-en">No matured rows yet. Rows accrue as 21d windows close — first read ~Sep 15 2026.</span>
          <span class="l-zh">暂无成熟行。行随21日窗口关闭而累积——首次读取约2026年9月15日。</span>
        </p>
        {% if acct.get('present') %}
        <p class="acct-muted" style="font-size:12px;margin-top:6px">
          <span class="l-en">Buy-lane rows in ledger: {{ acct.get('buy_lane_rows', 0) }} (all horizons, including immature)</span>
          <span class="l-zh">买入通道账本行：{{ acct.get('buy_lane_rows', 0) }}（所有地平线，含未成熟）</span>
        </p>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <!-- ── Two-axis failure-mode mix ── -->
    <div class="acct-row-grid">
      <div class="acct-card">
        <div class="acct-card-title">
          <span class="l-en">Outcome Causes</span>
          <span class="l-zh">结果原因</span>
        </div>
        <div class="acct-empty-state" style="padding:20px 12px">
          <span class="l-en">Measuring — outcome-cause breakdown available once attribution rows mature.</span>
          <span class="l-zh">测量中——结果原因分解在归因行成熟后可用。</span>
        </div>
      </div>
      <div class="acct-card">
        <div class="acct-card-title">
          <span class="l-en">Process Faults</span>
          <span class="l-zh">流程缺陷</span>
        </div>
        <div class="acct-empty-state" style="padding:20px 12px">
          <span class="l-en">Measuring — process-fault breakdown available once attribution rows mature.</span>
          <span class="l-zh">测量中——流程缺陷分解在归因行成熟后可用。</span>
        </div>
      </div>
    </div>

    <!-- ── Loss ledgers ── -->
    <div class="acct-row-grid">
      <div class="acct-card">
        <div class="acct-card-title">
          <span class="l-en">pp Lost on Surfaced Losers</span>
          <span class="l-zh">已浮现亏损者损失pp</span>
        </div>
        <div class="acct-empty-state" style="padding:20px 12px">
          <span class="l-en">Sensor maturing — available once winner/loser attribution accumulates.</span>
          <span class="l-zh">传感器累积中——赢家/亏损者归因积累后可用。</span>
        </div>
      </div>
      <div class="acct-card">
        <div class="acct-card-title">
          <span class="l-en">pp Forgone on Unsurfaced Winners</span>
          <span class="l-zh">未浮现赢家错失pp</span>
        </div>
        <div class="acct-empty-state" style="padding:20px 12px">
          <span class="l-en">Sensor maturing — available once missed-mover census accumulates.</span>
          <span class="l-zh">传感器累积中——遗漏动向普查积累后可用。</span>
        </div>
      </div>
    </div>

    <!-- ── Coverage monitor ── -->
    <div class="acct-card">
      <div class="acct-card-title">
        <span class="l-en">Coverage Monitor</span>
        <span class="l-zh">覆盖率监控</span>
      </div>
      {% set cov = acct.get('coverage_monitor') or {} %}
      <div class="acct-cov-row">
        <div class="acct-cov-chip">
          <b>{{ cov.get('trailing_4wk_buy_count') if cov.get('trailing_4wk_buy_count') is not none else '—' }}</b>
          <span class="l-en"> unique tickers surfaced (trailing 4wk)</span>
          <span class="l-zh"> 个独特代码（近4周）</span>
        </div>
        <div class="acct-cov-chip">
          <span class="l-en">Frozen baseline: </span>
          <span class="l-zh">冻结基准：</span>
          <b>{{ cov.get('frozen_baseline') if cov.get('frozen_baseline') is not none else '—' }}</b>
        </div>
      </div>
      {% if cov.get('weekly_history') %}
      <div class="tbl-scroll" style="margin-top:8px">
        <table class="acct-tbl">
          <thead><tr>
            <th style="text-align:left"><span class="l-en">Week</span><span class="l-zh">周</span></th>
            <th><span class="l-en">Tickers</span><span class="l-zh">代码数</span></th>
          </tr></thead>
          <tbody>
            {% for wk in cov.get('weekly_history') %}
            <tr>
              <td style="text-align:left;font-size:11.5px">{{ wk.get('week', '—') }}</td>
              <td>{{ wk.get('unique_tickers', '—') }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </div>

    <!-- ── Upstream concordance ── -->
    <div class="acct-card">
      <div class="acct-card-title">
        <span class="l-en">Upstream Concordance</span>
        <span class="l-zh">上游一致性</span>
      </div>
      {% set gs = acct.get('gate_suppressed') or {} %}
      {% if gs.get('state') == 'data_gap' %}
      <p class="acct-gap-note">
        <span class="l-en">Gate suppressed: {{ gs.get('reason', '') }}</span>
        <span class="l-zh">门控被抑制：{{ gs.get('reason', '') }}</span>
      </p>
      {% endif %}
      {% set uc_strata = (acct.get('strata') or {}).get('upstream_concordance') %}
      {% if uc_strata %}
      <div class="tbl-scroll">
        <table class="acct-tbl">
          <thead><tr>
            <th style="text-align:left"><span class="l-en">Organ</span><span class="l-zh">器官</span></th>
            <th><span class="l-en">Discordance rate</span><span class="l-zh">不一致率</span></th>
            <th>n</th>
          </tr></thead>
          <tbody>
            {% for organ, v in (uc_strata.items() if uc_strata is mapping else {}.items()) %}
            <tr>
              <td style="text-align:left">{{ organ }}</td>
              <td>{{ '%.1f%%'|format(v.get('discordance_rate', 0) * 100) if v.get('discordance_rate') is not none else '—' }}</td>
              <td>{{ v.get('n') if v.get('n') is not none else '—' }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <div class="acct-empty-state" style="padding:16px 12px">
        <span class="l-en">Concordance data accruing — available once attribution rows mature.</span>
        <span class="l-zh">一致性数据累积中——归因行成熟后可用。</span>
      </div>
      {% endif %}
    </div>

    <!-- ── Post-mortem digest slot ── -->
    <div class="acct-card" id="acct-postmortem" style="display:none">
      <div class="acct-card-title">
        <span class="l-en">Latest Post-mortem Digest</span>
        <span class="l-zh">最新事后分析摘要</span>
      </div>
      <div id="acct-postmortem-body"></div>
    </div>

    <p style="margin-top:16px;font-size:11.5px;color:var(--muted)">
      <span class="l-en">Authority: display_only. All numbers from committed audit artifacts (SA-W1). Cluster-unit CIs per SA-R10. No verdict language before floor (raw n ≥25, eff. n ≥3, ≥3 calendar months).</span>
      <span class="l-zh">授权：仅展示。所有数字来自已提交审计工件（SA-W1）。集群单元置信区间按SA-R10。下限（原始n≥25、有效n≥3、≥3个日历月）前无结论语言。</span>
      {% if acct.get('as_of') %}· <span class="l-en">As of</span><span class="l-zh">截至</span> {{ acct.as_of }}{% endif %}
    </p>
  </section>

  <!-- ================================================================ -->
  <!-- TAB 5: METHOD                                                      -->
  <!-- ================================================================ -->
  <section data-tab-panel="method" style="display:none">
    <div class="method-body">
      <h3>{{ t('What this lab measures', '本实验室测量什么') }}</h3>
      <p>{{ t('23 frozen candidate pick engines run in parallel on forward ledgers. Each book fires picks nightly; those picks are graded when the horizon elapses. Nothing here drives live selection. The purpose is evidence accrual: let the data tell us which constructions are worth a formal gauntlet.', '23个冻结候选选股引擎在前向账本上并行运行。每本书每晚触发选择；当地平线经过时，这些选择被评级。这里没有任何内容驱动实时选股。目的是证据累积：让数据告诉我们哪些构造值得正式考验。') }}</p>

      <h3>{{ t('Rulers (per family, pre-declared — PL-R3)', '标尺（每族，预先声明 — PL-R3）') }}</h3>
      <ul>
        <li>{{ t('Families A, B, D, E, F: primary ruler = 21-trading-day SPY-excess (win rate + median excess). 5/10/63d recorded as descriptive ladder.', 'A、B、D、E、F族：主标尺 = 21交易日SPY超额（胜率+中位超额）。5/10/63日记录为描述性阶梯。') }}</li>
        <li>{{ t('Family C (Washout/Reversion): primary ruler = 21-session absolute reversion-capture + MFE/MAE asymmetry. 63d excess is the wrong ruler here.', 'C族（洗盘/均值回归）：主标尺 = 21节绝对均值回归捕获 + MFE/MAE非对称。63日超额在此为错误标尺。') }}</li>
        <li>{{ t('Book 19 (Topping Avoid, INVERSE): scored as avoid-accuracy — expected negative 21d excess.', '书19（顶部规避，反向）：评分为规避准确性 — 预期负21日超额。') }}</li>
        <li>{{ t('Long-hold grids: 126d and 252d sector-relative + SPY-excess, descriptive only.', '长持网格：126日和252日板块相对+SPY超额，仅描述性。') }}</li>
      </ul>

      <h3>{{ t('Controls (PL-R5)', '控制变量（PL-R5）') }}</h3>
      <p>{{ t('Every book is measured against two yardsticks: (1) the Random Control book (12 uniform-random liquid names, deterministic seed per day), visible in the scoreboard; and (2) the universe buy-anytime base rate. Every headline number is lift over both, not raw win rate.', '每本书均与两个基准进行比较：（1）随机控制书（12个均匀随机流动名称，每日确定性种子），在记分板中可见；以及（2）全市场随时买入基准率。每个标题数字是相对于两者的提升，而非原始胜率。') }}</p>

      <h3>{{ t('ACCRUING floor (PL-R4)', '累积下限（PL-R4）') }}</h3>
      <div class="law">
        <b>{{ t('No verdict language before n≥25 fires spanning ≥3 calendar months and ≥6 distinct fire dates.', '在n≥25次触发跨越≥3个日历月和≥6个不同触发日期之前，无结论语言。') }}</b>
        {{ t('Until then, the status badge reads ACCRUING. Even past the floor, this page shows descriptive summaries only.', '在此之前，状态徽章显示ACCRUING。即使超过下限，此页面也仅显示描述性摘要。') }}
      </div>

      <h3>{{ t('What promotion would take (PL-R1)', '晋升所需条件（PL-R1）') }}</h3>
      <p>{{ t('Promotion of any book beyond display-tier requires the existing gauntlet: n≥25 fires across ≥3 months, a time-preserving placebo (no ticker-cluster CIs without time control), and pre-registered outcome gates. The lab contributes forward evidence only. Operator daily review (PL-R8) is a sanctioned selection heuristic for gauntlet slots — never promotion evidence by itself.', '任何书超越展示层级的晋升都需要现有的考验：跨越≥3个月的n≥25次触发，时间保留安慰剂（没有无时间控制的代码集群置信区间），以及预先注册的结果门控。实验室仅提供前向证据。操作员每日审查（PL-R8）是考验槽位的制裁选择启发式 — 本身从不是晋升证据。') }}</p>

      <h3>{{ t('Frozen configs (PL-R2)', '冻结配置（PL-R2）') }}</h3>
      <p>{{ t('Every book registers a frozen config + config_hash at ship time. Any parameter change ships as engine_id-v2 with a fresh ledger. Ledgers are never edited or re-scored in place.', '每本书在发布时注册一个冻结配置+config_hash。任何参数更改以engine_id-v2发布，带有新账本。账本永不就地编辑或重新评分。') }}</p>

      <h3>{{ t('Candidate families', '候选族') }}</h3>
      <ul>
        <li><b>A — 1D Velocity:</b> {{ t('4 books pricing the flagship gate\'s speed cost on fast movers. Clock: 2026-08-20.', '4本书定价旗舰门控在快速移动者上的速度成本。时钟：2026-08-20。') }}</li>
        <li><b>B — Momentum:</b> {{ t('4 books (breakout-vol, residual-momentum, OTR pullback, high-base squeeze).', '4本书（突破量能、残差动能、OTR回调、高位基建盘整）。') }}</li>
        <li><b>C — Washout/Reversion:</b> {{ t('3 books; absolute reversion ruler, not SPY-excess.', '3本书；绝对均值回归标尺，而非SPY超额。') }}</li>
        <li><b>D — EDGE/Quality:</b> {{ t('3 books (EDGE pure, EDGE×1D, quality pullback).', '3本书（纯EDGE、EDGE×1日、优质回调）。') }}</li>
        <li><b>E — Context/Personality:</b> {{ t('2 books (beta-squeeze, revision-accel).', '2本书（Beta压缩、预测加速上修）。') }}</li>
        <li><b>F — Ablations + Control:</b> {{ t('4 books including flagship-nogate, flagship-T3/T4, topping-avoid (INVERSE), and the random control yardstick.', '4本书，包括旗舰无门控、旗舰T3/T4、顶部规避（反向）和随机控制基准。') }}</li>
        <li><b>LH — Long-Hold:</b> {{ t('3 grids (compounder, EDGE durability, washout survivor). Firewalled from entry surfaces.', '3个网格（复利、EDGE耐久、洗盘幸存）。与入场界面隔离。') }}</li>
      </ul>

      {% if method_note %}
      <h3>{{ t('Notes from last run', '上次运行说明') }}</h3>
      <p>{{ method_note }}</p>
      {% endif %}

      <p style="margin-top:20px;font-size:11.5px;color:var(--muted)">
        {{ t('Authority: display_only. All rows carry authority: "display_only" per PL-R10.', '授权：仅展示。所有行按照PL-R10携带授权："display_only"。') }}
        · {{ t('Built', '生成时间') }} {{ built }}
      </p>
    </div>
  </section>

</div><!-- .pl-wrap -->

<!-- ── inline tab-switch JS ── -->
<script>
(function () {
  'use strict';
  /* main tab switcher */
  var tabs = document.querySelectorAll('.pl-tabs .tabbtn');
  var panels = document.querySelectorAll('[data-tab-panel]');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-tab');
      tabs.forEach(function (b) { b.classList.remove('on'); });
      panels.forEach(function (p) { p.style.display = 'none'; });
      btn.classList.add('on');
      var panel = document.querySelector('[data-tab-panel="' + id + '"]');
      if (panel) panel.style.display = 'block';
    });
  });
  /* All Books chip selector */
  var chips = document.querySelectorAll('#ab-chips .book-chip');
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var id = chip.getAttribute('data-ab');
      chips.forEach(function (c) { c.classList.remove('on'); });
      document.querySelectorAll('.ab-panel').forEach(function (p) { p.style.display = 'none'; });
      chip.classList.add('on');
      var panel = document.getElementById('ab-' + id);
      if (panel) panel.style.display = 'block';
    });
  });
  /* Scoreboard book-drill: click engine name → jump to All Books or Long-Hold panel */
  document.querySelectorAll('.book-drill').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-ab');
      /* Try All Books tab first */
      var abPanel = document.getElementById('ab-' + id);
      if (abPanel) {
        /* Switch to allbooks tab */
        tabs.forEach(function (b) { b.classList.remove('on'); });
        panels.forEach(function (p) { p.style.display = 'none'; });
        var abTab = document.querySelector('.pl-tabs .tabbtn[data-tab="allbooks"]');
        if (abTab) abTab.classList.add('on');
        var abSection = document.querySelector('[data-tab-panel="allbooks"]');
        if (abSection) abSection.style.display = 'block';
        /* Activate the chip for this engine */
        chips.forEach(function (c) { c.classList.remove('on'); });
        document.querySelectorAll('.ab-panel').forEach(function (p) { p.style.display = 'none'; });
        var targetChip = document.querySelector('#ab-chips .book-chip[data-ab="' + id + '"]');
        if (targetChip) targetChip.classList.add('on');
        abPanel.style.display = 'block';
        /* Open the all-fires details */
        var det = abPanel.querySelector('.all-fires-details');
        if (det) det.open = true;
        abPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        /* Fall back to Long-Hold tab */
        tabs.forEach(function (b) { b.classList.remove('on'); });
        panels.forEach(function (p) { p.style.display = 'none'; });
        var lhTab = document.querySelector('.pl-tabs .tabbtn[data-tab="longhold"]');
        if (lhTab) lhTab.classList.add('on');
        var lhSection = document.querySelector('[data-tab-panel="longhold"]');
        if (lhSection) lhSection.style.display = 'block';
        var lhCard = document.getElementById('lh-' + id);
        if (lhCard) {
          var det2 = lhCard.querySelector('.all-fires-details');
          if (det2) det2.open = true;
          lhCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
