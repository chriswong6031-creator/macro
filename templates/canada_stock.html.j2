{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('TSX analyzer', 'TSX 个股分析') }} — cycle &amp; momentum</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1100px)/2)); } }
  html[data-lang="zh"] body { font-family: "PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",-apple-system,sans-serif; }
  .points { margin:6px 0; padding-left:18px; } .points li { margin:2px 0; }
  .cyclebox { margin:8px 0; padding:9px 12px; border-radius:9px; background:var(--panel2);
              font-size:13px; line-height:1.6; }
  .regline { margin:-2px -4px 6px; padding:6px 9px; border-radius:7px; border-left:3px solid var(--muted); }
  .regline.rl-bear { border-left-color:var(--down); background:color-mix(in srgb, var(--down) 12%, var(--panel2)); }
  .regline.rl-bull { border-left-color:var(--up); background:color-mix(in srgb, var(--up) 12%, var(--panel2)); }
  .regline.rl-neutral { border-left-color:var(--muted); background:color-mix(in srgb, var(--muted) 10%, var(--panel2)); }
  .entrybar { display:flex; gap:10px; align-items:flex-start; margin:10px 0 8px;
              padding:9px 12px; border-radius:9px; background:var(--panel2);
              border-top:2px solid var(--muted); font-size:14px; }
  .entrytag { font-weight:800; font-size:12px; letter-spacing:.04em; white-space:nowrap;
              padding:3px 9px; border-radius:7px; background:var(--panel); color:var(--text); border:1px solid var(--line); }
  .urg-now .entrytag { background:var(--up); color:#fff; } .urg-now { border-top-color:var(--up); }
  .urg-imminent .entrytag { background:var(--g-cold); color:#fff; } .urg-imminent { border-top-color:var(--g-cold); }
  .urg-soon { border-top-color:var(--g-cold); } .urg-later { border-top-color:var(--muted); }
  .urg-hold { border-top-color:var(--muted); }
  .urg-caution .entrytag { background:var(--warn); color:#1a1a1a; } .urg-caution { border-top-color:var(--warn); }
  .urg-exit .entrytag { background:var(--down); color:#fff; } .urg-exit { border-top-color:var(--down); }
  .urg-avoid { border-top-color:var(--down); }
  .agewhen { margin:6px 0; padding:7px 11px; border-radius:8px; background:var(--panel2);
             border-left:3px solid var(--link); font-size:13px; color:var(--text); }
  .eqbadge { display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
             border-radius:11px; font-size:12.5px; font-weight:700; cursor:help;
             border:1px solid var(--line); white-space:nowrap; }
  .eqbadge .eqg { font-weight:500; opacity:.8; }
  .eqbadge.eq-up { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .eqbadge.eq-down { background:color-mix(in srgb,var(--down) 16%,transparent); color:var(--down); border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .eqbadge.eq-flat { background:var(--panel2); color:var(--muted); }
  .alpha-entry { display:inline-block; font-size:11px; font-weight:700; padding:2px 8px;
                 border-radius:9px; text-transform:capitalize; border:1px solid var(--line); white-space:nowrap; }
  .ae-pullback { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .ae-extended { background:color-mix(in srgb,var(--warn) 22%,transparent); color:var(--text); border-color:color-mix(in srgb,var(--warn) 55%,transparent); }
  .ae-intact { background:color-mix(in srgb,var(--link) 14%,transparent); color:var(--link); }
  .ae-laggard { background:color-mix(in srgb,var(--down) 14%,transparent); color:var(--down); border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .ae-neutral { background:var(--panel2); color:var(--muted); }
  .fnd-arch { display:inline-block; font-size:11.5px; font-weight:700; padding:2px 9px;
              border-radius:8px; background:color-mix(in srgb,var(--link) 14%,var(--panel2));
              color:var(--link); border:1px solid color-mix(in srgb,var(--link) 30%,var(--line)); }
  .fnd-desc { font-size:13px; color:var(--text); margin:9px 0 4px; line-height:1.55; }
  /* ---- unified Conviction Profile hero (mirrors stock.html) ---- */
  .conv { margin:8px 0 4px; padding:11px 13px; border-radius:11px; background:var(--panel2);
          border:1px solid var(--line); }
  .cv-head { display:flex; align-items:center; gap:11px; }
  .cv-score { font-size:22px; font-weight:800; font-variant-numeric:tabular-nums; min-width:48px;
              text-align:center; padding:3px 9px; border-radius:10px; border:1px solid var(--line); }
  .cv-score.band-high { color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,var(--line));
                        background:color-mix(in srgb,var(--up) 12%,var(--panel)); }
  .cv-score.band-constructive { color:var(--g-cold); border-color:color-mix(in srgb,var(--g-cold) 40%,var(--line)); }
  .cv-score.band-neutral { color:var(--muted); }
  .cv-score.band-low { color:var(--down); border-color:color-mix(in srgb,var(--down) 38%,var(--line)); }
  .cv-verdict { font-size:15px; font-weight:800; line-height:1.25; }
  .cv-tier { font-size:11px; color:var(--muted); margin-top:1px; }
  .cv-axes { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:9px; }
  .cax { font-size:10.5px; }
  .cax .caxl { color:var(--muted); display:block; }
  .cax .caxbar { display:block; height:5px; border-radius:3px; background:var(--line); margin:2px 0; overflow:hidden; }
  .cax .caxf { display:block; height:100%; background:var(--g-cold); border-radius:3px; }
  .cax.cax-na .caxf { background:transparent; }
  .cax .caxv { font-weight:700; font-variant-numeric:tabular-nums; }
  .cv-cau { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
  .cv-cau .ccau { font-size:11px; font-weight:700; padding:1px 7px; border-radius:7px;
                  color:var(--warn); background:color-mix(in srgb,var(--warn) 13%,var(--panel)); }
  .cv-note { font-size:11px; color:var(--muted); margin-top:8px; line-height:1.5; }
  .fnd-grid { display:flex; flex-wrap:wrap; gap:8px; margin:10px 0 4px; }
  .fnd-chip { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:5px 10px; font-size:12px; min-width:78px; }
  .fnd-chip .k { color:var(--muted); font-size:10.5px; text-transform:uppercase; letter-spacing:.03em; }
  .fnd-chip .v { font-weight:800; font-size:15px; font-variant-numeric:tabular-nums; }
  .fnd-chip .vs { font-size:10px; color:var(--muted); margin-left:4px; }
  a { text-decoration:none; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .navbtn { display:inline-block; padding:5px 11px; border-radius:9px; background:var(--panel2); border:1px solid var(--line); color:var(--text); font-size:13px; font-weight:600; }
  .muted { color:var(--muted); }
  .state { display:inline-block; padding:2px 11px; border-radius:12px; font-weight:700; font-size:12.5px; }
  .searchwrap { position:relative; flex:1; min-width:260px; max-width:460px; }
  .searchwrap::before { content:''; position:absolute; left:15px; top:50%; width:16px; height:16px;
       transform:translateY(-50%); pointer-events:none; background-color:var(--muted);
       -webkit-mask:var(--mag-svg) center/contain no-repeat; mask:var(--mag-svg) center/contain no-repeat;
       transition:background-color .2s ease; z-index:1; }
  .searchwrap:focus-within::before { background-color:var(--link); }
  #q { width:100%; box-sizing:border-box; padding:11px 16px 11px 44px; border-radius:12px;
       border:1px solid var(--line); background:var(--panel2); color:var(--text);
       font:inherit; font-size:15px; outline:none; box-shadow:inset 0 1px 2px rgba(0,0,0,.05);
       transition:border-color .2s ease, background .2s ease, box-shadow .25s ease; }
  #q::placeholder { color:var(--muted); }
  .searchwrap:hover #q { border-color:color-mix(in srgb,var(--link) 38%,var(--line)); }
  #q:focus { border-color:color-mix(in srgb,var(--link) 75%,var(--line)); background:var(--panel);
       box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 20%,transparent), 0 8px 22px color-mix(in srgb,var(--link) 14%,transparent); }
  #sugg { position:absolute; top:calc(100% + 8px); left:0; right:0; background:var(--panel);
          border:1px solid var(--line); border-radius:13px; z-index:50; max-height:330px;
          overflow:auto; display:none; box-shadow:var(--popover-shadow); padding:5px; }
  #sugg div { padding:8px 11px; cursor:pointer; display:flex; gap:10px; align-items:center; border-radius:9px; }
  #sugg div:hover, #sugg div.sel { background:color-mix(in srgb,var(--link) 13%,var(--panel2)); padding-left:14px; }
  #sugg b { min-width:78px; flex:none; }
  #sugg small { color:var(--muted); flex:1 1 auto; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  #sugg div span { flex:0 1 auto; min-width:0; max-width:40%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-align:right; }
  .mtf { display:flex; gap:14px; flex-wrap:wrap; font-size:12.5px; color:var(--muted); margin-top:8px; }
  .mtf b { color:var(--text); }
  .fnd-chip .vs { font-size:10px; color:var(--muted); margin-left:4px; }
  .rchip { display:inline-block; font-weight:800; padding:2px 10px; border-radius:8px; font-size:12.5px; }
  .rchip.buy { background:color-mix(in srgb,var(--up) 18%,transparent); color:var(--up); border:1px solid color-mix(in srgb,var(--up) 40%,transparent); }
  .rchip.hold { background:var(--panel2); color:var(--muted); border:1px solid var(--line); }
  .rchip.sell { background:color-mix(in srgb,var(--down) 18%,transparent); color:var(--down); border:1px solid color-mix(in srgb,var(--down) 40%,transparent); }
  .fnd-tbl { width:100%; border-collapse:collapse; margin:8px 0 2px; font-size:12px; font-variant-numeric:tabular-nums; }
  .fnd-tbl th, .fnd-tbl td { padding:4px 7px; border-bottom:1px solid var(--line); text-align:right; }
  .fnd-tbl th:first-child, .fnd-tbl td:first-child { text-align:left; color:var(--muted); }
  .fnd-tbl thead th { color:var(--muted); font-weight:700; font-size:11px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .early { margin:6px 0; padding:8px 12px; border-radius:8px;
           background:color-mix(in srgb, var(--g-cold) 14%, var(--panel2));
           border-left:3px solid var(--g-cold); font-size:13px; color:var(--text); }
  #result { display:none; }
  /* ---- hover tooltips (the ? help icons) — section prose condensed into hover boxes ---- */
  .help { display:inline-flex; align-items:center; justify-content:center;
          width:15px; height:15px; border-radius:50%; border:1px solid var(--muted);
          color:var(--muted); font-size:10px; font-weight:600; cursor:help;
          position:relative; vertical-align:middle; margin-left:5px; flex:none;
          text-transform:none; letter-spacing:normal; }
  .help .tip { display:none; position:absolute; bottom:150%; left:50%;
               transform:translateX(-50%); width:300px;
               background:var(--panel); border:1px solid var(--line);
               padding:10px 12px; border-radius:9px; z-index:60; font-size:12px;
               line-height:1.5; color:var(--text); text-align:left; font-weight:400;
               text-transform:none; letter-spacing:normal; box-shadow:var(--popover-shadow);
               pointer-events:auto; cursor:auto; white-space:normal;
               max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; bottom:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  th .help .tip, .help.below .tip { bottom:auto; top:150%; }
  th .help:hover::before, .help.below:hover::before { bottom:auto; top:100%; }
  .help.edge-right .tip { left:auto; right:0; transform:none; }
  .help.edge-left .tip { left:0; right:auto; transform:none; }
  .tip b { color:var(--text); }
  /* ===================== HYBRID PAGE POLISH (Refined base + Fintech finish) =====================
     Mirrors the US analyzer: soft cards, sentence-case headings, tabular numerics. */
  #result .panel { border-radius:16px; padding:18px 20px; box-shadow:0 1px 0 rgba(255,255,255,.025);
                   margin-bottom:16px; font-variant-numeric:tabular-nums; }
  h2 { font-size:15px; text-transform:none; letter-spacing:0; font-weight:650; color:var(--text);
       margin:0 0 13px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; line-height:1.3; }
  #r_summary { display:none; }
  #r_cal tr.cal-cur td { background:color-mix(in srgb, var(--warn) 13%, transparent); }
  #r_cal tr.cal-cur td:first-child { box-shadow:inset 3px 0 var(--warn); font-weight:700; }
  .cal-here { color:var(--warn); font-size:11px; font-weight:700; margin-left:8px; white-space:nowrap; }
{% include "_stock_decision.css.j2" %}
</style>
</head>
<body>
  {% set nav_search_placeholder_en = 'Search any stock — US, China, HK, Canada & more…' %}
  {% set nav_search_placeholder_zh = '搜索任意股票 — 美股、A 股、港股、加股等…' %}
  {% include "_site_nav.html.j2" %}
  <div class="panel">
    <div class="topline">
      <h1>🔎 {{ t('TSX analyzer', 'TSX 个股分析') }}</h1>
      <div class="searchwrap">
        <input id="q" placeholder="Search any TSX stock / sector ETF / index… (e.g. RY, Shopify, Energy)" autocomplete="off">
        <div id="sugg"></div>
      </div>
    </div>
  </div>

  <div id="result">
    <div class="panel">
      <div class="topline">
        <h1 id="r_name"></h1>
        <span id="r_live_px" class="nb-px" data-mkt="ca" style="display:none;font-weight:800;font-size:17px;margin-left:2px"></span>
        <span id="r_state" class="state"></span>
        <span id="r_eq" class="eqbadge" style="display:none"></span>
        <span style="flex:1"></span>
        <span id="r_asof" class="muted"></span>
      </div>
      <p id="r_summary" class="muted" style="margin:2px 0 6px; font-size:13.5px"></p>
      <!-- ===== Decision-first layout (shared stockview.js renders rec.view) ===== -->
      <div id="sv-decision"></div>
      <div id="sv-fingerprint"></div>
      <div id="sv-honesty"></div>
      <!-- ===== Cycle & timing detail (deep layer, collapsed) ===== -->
      <details class="sv-deep"><summary>{{ t('Cycle &amp; timing detail', '周期与时机详情') }}</summary>
        <div id="r_entry" class="entrybar"><span class="entrytag" id="r_tag"></span><span id="r_entrytext"></span></div>
        <p id="r_age" class="agewhen" style="display:none"></p>
        <ul id="r_points" class="points"></ul>
        <div id="r_cyclebox" class="cyclebox"></div>
        <p id="r_flags" class="neg" style="margin:4px 0"></p>
        <p class="muted" id="r_why" style="margin:6px 0"></p>
      </details>
    </div>
    <!-- ===== Price chart — pinned to the top, right below the decision card ===== -->
    <div class="panel">
      <h2>{{ t('Chart', '图表') }}</h2>
      <div id="tvbox"></div>
    </div>
    <!-- ===== Momentum across timeframes — paired right under the chart ===== -->
    <div class="panel">
      <h2>{{ t('Momentum across timeframes', '跨周期动量') }}</h2>
      <div id="r_mtf"></div>
    </div>
    <!-- ===== Evidence lanes + country slot (Layer 2, shared stockview.js) ===== -->
    <div id="sv-evidence"></div>
    <div id="sv-country"></div>
    <details class="sv-group"><summary>{{ t('📊 Fundamentals, analyst &amp; positioning', '📊 基本面、分析师与持仓') }}</summary>
    <!-- legacy conviction panel — populated only as a FALLBACK if stockview.js fails -->
    <div class="panel" id="r_conviction_panel" style="display:none">
      <h2>{{ t('Conviction profile', '确信度画像') }} <span class="note" style="text-transform:none">· {{ t('unified verdict — cycle caps it', '统一结论 — 周期封顶') }}</span></h2>
      <div id="r_conviction" class="conv"></div>
    </div>
    <div class="panel" id="r_alpha_panel" style="display:none">
      <h2>{{ t('Relative strength', '相对强度') }} <span class="note" style="text-transform:none">· {{ t('sector-neutral residual', '板块中性残差') }}</span></h2>
      <div id="r_alpha" class="mtf"></div>
      <p class="muted" style="font-size:12px; margin-top:8px">{{ t(
        'This name\'s return with its MARKET and SECTOR beta removed — sector-neutral residual relative strength (12-1 month); <b>alpha z</b> ranks it vs the whole TSX large-cap cross-section. This is the positive-IC SELECTION leg (Canada is momentum-persistent like the US). The entry tag is the timing context: <b>pullback</b> = a leader on a recent dip (the constructive entry); <b>extended</b> = just spiked (chase risk). Context, not a personalized buy signal.',
        '本股票剔除其市场与板块贝塔后的收益 — 板块中性残差相对强度（12-1 个月）；<b>alpha z</b> 为相对全 TSX 大盘横截面的排名。这是正 IC 的<b>选股腿</b>（加拿大与美国一样动量具持续性）。入场标记为时机背景：<b>pullback</b>＝近期回调的领先股（建设性入场）；<b>extended</b>＝刚急涨（追高风险）。仅作背景，非个性化买入信号。') }}</p>
    </div>
    <div class="panel" id="r_fund_panel" style="display:none">
      <h2>{{ t('Fundamentals', '基本面') }} <span class="note" style="text-transform:none">· {{ t('context, not a signal', '背景，而非信号') }}</span>{{ help(
        'Descriptive valuation, profitability and dividends (from yfinance) — a backdrop to read ALONGSIDE the cycle / relative-strength signals, NOT a buy ranking. "Cheap vs sector" is not validated as a cross-sectional edge here. Fundamentals refresh on a slower cadence than price.',
        '描述性的估值、盈利与分红（来自 yfinance）—— 作为与周期／相对强度信号并读的背景，而非买入排序。"相对板块便宜"在此并未被验证为有效的横截面优势。基本面的更新频率慢于价格。') }}</h2>
      <div id="r_fund"></div>
    </div>
    <div class="panel" id="r_analyst_panel" style="display:none">
      <h2>👔 {{ t('Analyst &amp; estimates', '分析师与预期') }} <span class="note" style="text-transform:none">· {{ t('sell-side consensus', '卖方一致预期') }}</span>{{ help(
        'yfinance sell-side aggregate: the consensus rating, mean price target with its high/low range, the implied upside vs the current price, and coverage breadth. Sell-side opinion shown as coverage context, NOT an endorsement — a target is a forecast, not a validated edge.',
        'yfinance 卖方汇总：一致评级、目标价中位及其高/低区间、相对现价的隐含上行空间，以及覆盖广度。卖方观点仅作覆盖背景，并非推荐——目标价是预测，并非有效优势。') }}</h2>
      <div id="r_analyst"></div>
    </div>
    <div class="panel" id="r_earn_panel" style="display:none">
      <h2>📅 {{ t('Earnings', '财报') }}</h2>
      <div id="r_earn"></div>
    </div>
    <div class="panel" id="r_pos_panel" style="display:none">
      <h2>{{ t('Positioning', '持仓与做空') }} <span class="note" style="text-transform:none">· {{ t('short interest &amp; ownership', '空头与持股结构') }}</span>{{ help(
        'Short interest (shares short + days-to-cover) and insider / institutional ownership, from yfinance. Heavy or rising short interest is a caution; high institutional ownership is crowding context. This is the ownership SNAPSHOT — actual insider buy/sell filings are in the Insider activity panel below. Descriptive, not a signal.',
        '空头（做空股数＋回补天数）与内部人／机构持股，来自 yfinance。高或上升的空头是警示；高机构持股是拥挤背景。这是持股快照——实际的内部人买卖申报见下方"内部人交易"面板。描述性，非信号。') }}</h2>
      <div id="r_pos"></div>
    </div>
    <div class="panel" id="r_insider_panel" style="display:none">
      <h2>👤 {{ t('Insider activity', '内部人交易') }} <span class="note" style="text-transform:none">· {{ t('SEDI open-market filings (yfinance)', 'SEDI 公开市场申报（yfinance）') }}</span>{{ help(
        'Personal insider open-market buys / sells from SEDI (Canada\'s insider-filing system), via yfinance — issuer buybacks and option exercises are excluded. CONTEXT, not a validated signal: SEDI filings lag the trade by up to ~5 days and TSX insider breadth is thin, so read net buying / selling as a conviction tell, not a timing trigger. Coverage is best-effort per name.',
        '来自 SEDI（加拿大内部人申报系统）的个人内部人公开市场买入／卖出，经 yfinance 获取——已剔除公司回购与期权行权。背景，而非已验证信号：SEDI 申报相对交易最多滞后约5天，且 TSX 内部人样本稀疏，故净买入／卖出应作为信念参考，而非择时触发。覆盖为尽力而为，逐名而定。') }}</h2>
      <div id="r_insider"></div>
    </div>
    <div class="panel" id="r_cbeta_panel" style="display:none">
      <h2>{{ t('Commodity exposure', '商品敞口') }} <span class="note" style="text-transform:none">· {{ t('oil / gold / loonie beta', '原油／黄金／加元贝塔') }}</span>{{ help(
        'This name\'s sensitivity to oil (WTI), gold and the loonie (CAD), with the broad market removed (orthogonal betas) — the dimension that actually separates TSX names, since the Composite is ~70% Energy / Materials / Financials. An energy producer loads on oil, a miner on gold, a bank reads near-zero (market-driven). The "primary driver" is the largest commodity/FX leg; <b>fit R²</b> is how much of the daily move these factors plus the market explain. Descriptive exposure for sizing and pairing, NOT a forecast or a buy signal.',
        '本股票对原油（WTI）、黄金与加元（CAD）的敏感度，已剔除大盘（正交贝塔）—— 这是真正区分 TSX 个股的维度，因为综合指数约70%为能源／材料／金融。能源生产商对原油敏感，矿企对黄金敏感，银行接近零（由大盘驱动）。"主要驱动"为最大的商品／汇率腿；<b>拟合R²</b>表示这些因子加大盘能解释日内波动的比例。仅作仓位与配对的描述性敞口，并非预测或买入信号。') }}</h2>
      <div id="r_cbeta" class="mtf"></div>
    </div>
    </details>
    <!-- Trust-the-state: standalone panel at the page bottom (per revamp) -->
    <div class="panel" id="r_cal_panel" style="display:none">
      <h2>{{ t('How much to trust the state — measured on TSX history', '这个状态有多可信 — 基于TSX历史实测') }}{{ help(
        'TSX names drift up over a month from every state; the spread between states is small. Use the state for <b>structure</b> (cycle position, confirmation checklist, invalidation level) and size positions instead of seeking certainty. <b>Typical dip</b> = median worst drop over the next month; <b>bad-case dip</b> = the worst 1-in-10 month (10th percentile).',
        '从任何状态出发，TSX 个股在一个月内都倾向于上涨；各状态之间的差距很小。请把状态用于<b>结构判断</b>（周期位置、确认清单、失效价位）并据此控制仓位，而非追求确定性。<b>典型回撤</b> = 未来一个月最大跌幅中位数；<b>最坏回撤</b> = 十分之一的最差月份（第10百分位）。') }}</h2>
      <table id="r_cal"></table>
    </div>
    <p class="muted sv-method" style="font-size:11.5px;margin:14px 2px 0">{{ t(
      'How to read this page: the verdict band is the one call; the timing line, fingerprint axes and evidence lanes are the supporting reads behind it; the collapsed sections hold the full detail. Everything here is display-only research context, never personalized investment advice — sizing is a risk-budget guide, not a recommendation.',
      '如何阅读本页：结论条是唯一的判断；时机行、画像轴与依据栏是其背后的支撑读数；折叠区块收纳完整明细。本页所有内容仅为研究性背景展示，并非个性化投资建议——仓位为风险预算参考，而非推荐。') }}</p>
  </div>

<script src="lightweight-charts-v5.js"></script>
<script src="chart.js"></script>
<script src="stockview.js"></script>
<script>
(function () {
  var idx = [], cal = null, sel = -1, items = [];
  var q = document.getElementById('q'), sugg = document.getElementById('sugg');
  function lang() { return document.documentElement.getAttribute('data-lang') || 'en'; }
  var T = {
    en: { asof: 'data through', notlib: 'NOT IN LIBRARY',
          notlibmsg: 'Not in the nightly library (curated TSX large-caps + sector ETFs + indices). Add it in config.yml → canada.constituents.',
          season: 'Seasonality', failed: '⚠ Failed cycle — price is below the low that started this cycle; the larger trend is usually rolling over.',
          next: 'Next:', ph: 'Search any TSX stock / sector ETF / index… (e.g. RY, Shopify, Energy)',
          th_state: 'state', th_n: 'samples', th_up: 'up next month', th_avg: 'avg next month',
          th_dipm: 'typical dip', th_dipb: 'bad-case dip',
          f_fwdpe: 'Fwd P/E', f_peg: 'PEG', f_payout: 'Payout', f_5yy: '5y avg yield',
          an_cov: 'analysts', an_target: 'mean target', an_upside: 'upside', an_range: 'target range',
          pos_short: 'Short interest', pos_dtc: 'days to cover', pos_float: '% of float',
          pos_ins: 'insiders', pos_inst: 'institutions', pos_sh: 'shares short',
          e_next: 'Next report', e_in: 'in', e_dd: 'd', e_today: 'today',
          e_soon: '⚠ Reports soon — results risk near-term', e_beats: 'beats', e_of: 'of',
          e_qtr: 'date', e_eps: 'EPS', e_est: 'est', e_surp: 'surprise',
          ins_buying: 'Net buying', ins_selling: 'Net selling', ins_mixed: 'Mixed',
          ins_buys: 'buys', ins_sells: 'sells', ins_buyers: 'buyers', ins_sellers: 'sellers',
          ins_net: 'net value', ins_last: 'last', ins_when: 'date', ins_who: 'insider',
          ins_act: 'action', ins_shares: 'shares', ins_buy: 'buy', ins_sell: 'sell',
          cb_oil: 'Oil β', cb_gold: 'Gold β', cb_cad: 'CAD β', cb_primary: 'primary driver',
          cb_fit: 'fit R²', cb_none: 'market-driven · no commodity tilt' },
    zh: { asof: '数据截至', notlib: '不在库中',
          notlibmsg: '不在每晚更新的标的库中（精选 TSX 大盘股 ＋ 板块 ETF ＋ 指数）。可在 config.yml → canada.constituents 添加。',
          season: '季节性', failed: '⚠ 失败周期 — 价格已跌破启动本周期的低点；此时更大的趋势通常正在转向下行。',
          next: '下一步：', ph: '搜索任意 TSX 个股 / 板块ETF / 指数…（例如 RY、Shopify、Energy）',
          th_state: '状态', th_n: '样本数', th_up: '下月上涨', th_avg: '下月均值',
          th_dipm: '典型回撤', th_dipb: '最坏回撤',
          f_fwdpe: '前瞻PE', f_peg: 'PEG', f_payout: '派息率', f_5yy: '5年均股息率',
          an_cov: '分析师', an_target: '目标价中位', an_upside: '上行空间', an_range: '目标区间',
          pos_short: '空头', pos_dtc: '回补天数', pos_float: '占流通',
          pos_ins: '内部持股', pos_inst: '机构持股', pos_sh: '做空股数',
          e_next: '下次财报', e_in: '还有', e_dd: '天', e_today: '今天',
          e_soon: '⚠ 临近财报 —— 短期业绩风险', e_beats: '超预期', e_of: '共',
          e_qtr: '日期', e_eps: '每股收益', e_est: '预期', e_surp: '超预期幅度',
          ins_buying: '净买入', ins_selling: '净卖出', ins_mixed: '买卖参半',
          ins_buys: '买入', ins_sells: '卖出', ins_buyers: '买入人', ins_sellers: '卖出人',
          ins_net: '净额', ins_last: '近', ins_when: '日期', ins_who: '内部人',
          ins_act: '方向', ins_shares: '股数', ins_buy: '买', ins_sell: '卖',
          cb_oil: '原油β', cb_gold: '黄金β', cb_cad: '加元β', cb_primary: '主要驱动',
          cb_fit: '拟合R²', cb_none: '市场驱动 · 无商品偏向' } };
  function L(k) { return (T[lang()] || T.en)[k]; }
  function lz(en, zh) { return lang() === 'zh' && zh ? zh : (en || ''); }
  var DISP = {{ state_display_json | safe }};
  function dlabel(s) { var d = DISP[s]; if (!d) return s; return lang() === 'zh' ? (d.label_zh || d.label) : d.label; }
  function disp(s) {
    var d = DISP[s]; if (!d) return s;
    return lang() === 'zh' ? (d.label_zh || d.label) + ' · ' + (d.action_zh || d.action)
                           : d.label + ' · ' + d.action;
  }
  q.placeholder = L('ph');

  // one unified universe — load THIS market first so a deep-linked #TICKER resolves
  // immediately, then fold in every other market so the box can find ANY stock and
  // route cross-market picks to the analyzer that owns them (US→stock.html, …).
  var STOCK_MKTS = [
    ['stockdata/', 'stock.html', '🇺🇸', 'US'],
    ['chinastockdata/', 'china_lookup.html', '🇨🇳', 'China'],
    ['hkstockdata/', 'hk_lookup.html', '🇭🇰', 'HK'],
    ['canadastockdata/', 'canada_stock.html', '🇨🇦', 'Canada'],
    ['intlstockdata/', 'intl_stock.html', '🌐', 'Intl']
  ];
  var STOCK_HOME = 'canada_stock.html';
  function tagMkt(d, m) {
    (d || []).forEach(function (x) { x._tgt = m[1]; x._fl = x.fl || m[2]; x._mk = x.mk || m[3]; });
    return d || [];
  }
  (function () {
    var home = STOCK_MKTS.filter(function (m) { return m[1] === STOCK_HOME; })[0];
    fetch(home[0] + 'index.json').then(function (r) { return r.json(); }).then(function (d) {
      idx = tagMkt(d, home); fromHash();
      STOCK_MKTS.forEach(function (m) {
        if (m[1] === STOCK_HOME) return;
        fetch(m[0] + 'index.json').then(function (r) { return r.json(); })
          .then(function (e) { idx = idx.concat(tagMkt(e, m)); }).catch(function () {});
      });
    });
  })();
  fetch('canadastockdata/calibration.json').then(r => r.ok ? r.json() : null)
    .then(d => { cal = d; }).catch(() => {});

  function fromHash() {
    var t = decodeURIComponent((location.hash || '').slice(1));
    if (t) load(t);
  }
  window.addEventListener('hashchange', fromHash);

  q.addEventListener('input', function () {
    var v = q.value.trim().toLowerCase();
    sel = -1;
    if (!v) { sugg.style.display = 'none'; return; }
    items = idx.filter(function (x) {
      return x.t.toLowerCase().indexOf(v) === 0 ||
             x.n.toLowerCase().indexOf(v) >= 0 || x.s.toLowerCase().indexOf(v) >= 0;
    }).sort(function (a, b) {
      var ae = a.t.toLowerCase() === v ? -1 : 0, be = b.t.toLowerCase() === v ? -1 : 0;
      if (ae !== be) return ae - be;
      var ap = a.t.toLowerCase().indexOf(v) === 0 ? 0 : 1,
          bp = b.t.toLowerCase().indexOf(v) === 0 ? 0 : 1;
      return ap - bp || a.t.localeCompare(b.t);
    }).slice(0, 12);
    sugg.innerHTML = items.map(function (x, i) {
      return '<div data-i="' + i + '">' +
             (x._fl ? '<span style="flex:none;width:18px;text-align:center">' + x._fl + '</span>' : '') +
             '<b>' + x.t + '</b><small>' + x.n +
             (x.s ? ' · ' + x.s : '') + '</small><span class="muted" style="font-size:11px">' +
             disp(x.st) + '</span></div>';
    }).join('');
    sugg.style.display = items.length ? 'block' : 'none';
  });
  q.addEventListener('keydown', function (e) {
    if (sugg.style.display === 'none') return;
    var divs = sugg.querySelectorAll('div');
    if (e.key === 'ArrowDown') { sel = Math.min(sel + 1, divs.length - 1); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { sel = Math.max(sel - 1, 0); e.preventDefault(); }
    else if (e.key === 'Enter') { pick(sel >= 0 ? sel : 0); e.preventDefault(); return; }
    else if (e.key === 'Escape') { sugg.style.display = 'none'; return; }
    divs.forEach(function (d, i) { d.classList.toggle('sel', i === sel); });
  });
  sugg.addEventListener('mousedown', function (e) {
    var d = e.target.closest('div[data-i]');
    if (d) pick(+d.dataset.i);
  });
  function pick(i) {
    if (!items[i]) return;
    sugg.style.display = 'none';
    q.value = items[i].t;
    // foreign market → bounce to the analyzer that owns it; same market → load in place
    if (items[i]._tgt && items[i]._tgt !== 'canada_stock.html') {
      location.href = items[i]._tgt + '#' + encodeURIComponent(items[i].t); return;
    }
    location.hash = encodeURIComponent(items[i].t);
  }

  function load(t) {
    var safe = t.replace('=', '_').replace('^', '_');
    fetch('canadastockdata/' + safe + '.json').then(function (r) {
      if (!r.ok) throw new Error('not in library');
      return r.json();
    }).then(render).catch(function () {
      document.getElementById('result').style.display = 'block';
      document.getElementById('r_name').textContent = t;
      document.getElementById('r_state').textContent = L('notlib');
      document.getElementById('r_state').className = 'state';
      document.getElementById('r_entry').style.display = 'none';
      document.getElementById('r_points').innerHTML = '';
      document.getElementById('r_conviction_panel').style.display = 'none';
      document.getElementById('r_cyclebox').innerHTML = L('notlibmsg');
    });
  }

  // unified Conviction Profile hero — renders the SAME block as the standout card on
  // canada_stocks.html, so the dashboard and this page can never structurally disagree.
  // The cycle ladder above is the calibrated short-term timing read; conviction blends
  // it with the relative-strength / theme read and is shown as context (the cycle caps
  // the verdict). CA selection is weak positive-IC context — the trust tier says so.
  var CAX_LABELS = { selection: ['Selection', '选股'], entry: ['Entry', '入场'],
                     tailwind: ['Tailwind', '顺风'], quality: ['Quality', '质量'] };
  function renderConviction(d) {
    var panel = document.getElementById('r_conviction_panel');
    var box = document.getElementById('r_conviction'), c = d.conviction;
    if (!box || !panel) return;
    if (!c) { panel.style.display = 'none'; return; }
    var tt = c.trust_tier || {};
    var ax = ['selection', 'entry', 'tailwind', 'quality'].map(function (k) {
      var a = (c.axes && c.axes[k]) || {}, lab = CAX_LABELS[k], pct = a.pct;
      return '<div class="cax' + (pct == null ? ' cax-na' : '') + '"><span class="caxl">' +
        lz(lab[0], lab[1]) + '</span><span class="caxbar"><span class="caxf" style="width:' +
        (pct == null ? 0 : pct) + '%"></span></span><span class="caxv">' +
        (pct == null ? '—' : pct) + '</span></div>';
    }).join('');
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g,
      function (ch) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]; }); };
    var cau = (c.cautions || []).map(function (x, i) {
      return '<span class="ccau">⚠ ' + esc(lz(x, (c.cautions_zh || [])[i] || x)) + '</span>'; }).join('');
    box.innerHTML =
      '<div class="cv-head">' +
        (c.score != null ? '<span class="cv-score band-' + c.band + '">' + c.score + '</span>' : '') +
        '<div class="cv-vtext"><div class="cv-verdict">' + lz(c.verdict, c.verdict_zh) + '</div>' +
        '<div class="cv-tier">' + lz(tt.en, tt.zh) + '</div></div></div>' +
      '<div class="cv-axes">' + ax + '</div>' +
      (cau ? '<div class="cv-cau">' + cau + '</div>' : '') +
      '<div class="cv-note">' + lz(
        'Conviction blends a calibrated short-term timing read (the cycle above) with the relative-strength / theme read — context, not a probability. On Canada the selection leg is weak positive-IC context and the axis weights are an unvalidated prior; there is no validated quality leg, so that axis is shown absent (never neutral). The cycle state caps the verdict: a downtrend never reads “Buy”.',
        '确信度融合了已校准的短期择时读数（上方周期）与相对强度／主题读数——作为情境，而非概率。在加拿大，选股腿为弱正 IC 背景，维度权重为未经验证的先验；并无经验证的质量腿，故该维度显示为缺失（绝非中性）。周期状态会封顶结论：下行趋势永不显示“买入”。') + '</div>';
    panel.style.display = 'block';
  }

  // Live header price chip (CAD, no '$' prefix). Set the canonical symbol + a
  // baked last price, reveal it, and ask live.js to refresh it now.
  function liveHeaderPx(d) {
    var lp = document.getElementById('r_live_px');
    if (!lp) return;
    var px = d && d.tech && d.tech.price;
    if (px == null) { lp.style.display = 'none'; lp.removeAttribute('data-sym'); return; }
    lp.setAttribute('data-sym', d.ticker);
    lp.textContent = Number(px).toFixed(2);                // baked; live.js overwrites
    lp.style.display = '';
    if (window.LiveQuotes && window.LiveQuotes.refresh) window.LiveQuotes.refresh();
  }

  function render(d) {
    document.getElementById('result').style.display = 'block';
    document.getElementById('r_name').textContent = d.name + ' (' + d.ticker + ')';
    liveHeaderPx(d);
    var st = document.getElementById('r_state');
    st.textContent = dlabel(d.ladder.state) || d.ladder.label;
    st.className = 'state st-' + d.ladder.state.replace(/ /g, '_');
    document.getElementById('r_summary').textContent = lz(d.ladder.summary_line, d.ladder.summary_line_zh);
    document.getElementById('r_asof').textContent = L('asof') + ' ' + d.asof;

    // Unified decision-first layout from the canonical view-model (engine/stock_view).
    // Replaces the separate conviction / relative-strength / commodity panels with ONE
    // decision band + fingerprint + honesty row + evidence lanes + country slot.
    var svOk = !!(window.SV && d.view && window.SV.mount(d));

    var e = d.ladder.entry || {};
    var eb = document.getElementById('r_entry');
    eb.style.display = 'flex';
    eb.className = 'entrybar urg-' + (e.urgency || 'hold');
    document.getElementById('r_tag').textContent = lz(e.tag, e.tag_zh);
    document.getElementById('r_entrytext').textContent = lz(e.text, e.text_zh);

    var ageEl = document.getElementById('r_age');
    if (d.ladder.age_line) { ageEl.textContent = lz(d.ladder.age_line, d.ladder.age_line_zh); ageEl.style.display = 'block'; }
    else { ageEl.style.display = 'none'; }

    var eqEl = document.getElementById('r_eq');
    if (d.ladder.eq_badge) {
      var grade = lang() === 'zh' ? (d.ladder.eq_grade_zh || d.ladder.eq_grade) : d.ladder.eq_grade;
      eqEl.innerHTML = (lang() === 'zh' ? '入场 ' : 'Entry ') + d.ladder.eq_badge + ' <span class="eqg">' + grade + '</span>';
      eqEl.className = 'eqbadge eq-' + (d.ladder.eq_dir || 'flat');
      eqEl.title = lz(d.ladder.eq_tip, d.ladder.eq_tip_zh);
      eqEl.style.display = 'inline-flex';
    } else { eqEl.style.display = 'none'; }

    var pts = (lang() === 'zh' && d.ladder.points_zh && d.ladder.points_zh.length)
      ? d.ladder.points_zh : (d.ladder.points || []);
    document.getElementById('r_points').innerHTML = pts.map(function (p) { return '<li>' + p + '</li>'; }).join('');

    var cp = d.ladder.cycle_plain || {};
    var reg = d.ladder.regime || 'neutral';
    var regEmoji = reg === 'bear' ? '🔻' : reg === 'bull' ? '🟢' : '⚪';
    var cyc = '';
    if (d.ladder.regime_line)
      cyc += '<div class="regline rl-' + reg + '"><b>' + regEmoji + ' ' + lz(d.ladder.regime_line, d.ladder.regime_line_zh) + '</b></div>';
    cyc += '<div><b>📅 ' + lz(cp.daily_line, cp.daily_line_zh) + '</b> — ' + lz(cp.daily_phase, cp.daily_phase_zh) + '</div>';
    if (cp.weekly_line) cyc += '<div><b>🗓 ' + lz(cp.weekly_line, cp.weekly_line_zh) + '</b> — ' + lz(cp.weekly_phase, cp.weekly_phase_zh) + '</div>';
    if (cp.translation) cyc += '<div class="muted">' + lz(cp.translation, cp.translation_zh) + '</div>';
    if (d.season_this) cyc += '<div class="muted">' + L('season') + ' — ' + lz(d.season_this, d.season_this_zh) +
      (d.season_next ? '; ' + lz(d.season_next, d.season_next_zh) : '') + '.</div>';
    document.getElementById('r_cyclebox').innerHTML = cyc;

    document.getElementById('r_flags').textContent = d.cycle.failed_cycle ? L('failed') : '';
    document.getElementById('r_why').textContent = lz(d.ladder.why, d.ladder.why_zh) + ' ' + L('next') + ' ' + lz(d.ladder.next, d.ladder.next_zh);
    if (!svOk) renderConviction(d);
    window.renderMTF(document.getElementById('r_mtf'), d.mtf);

    // Alpha vs sector — now folded into evidence.rel_strength; render the legacy panel
    // only as a fallback when the shared view-model didn't mount.
    var ap = document.getElementById('r_alpha_panel'), a = d.alpha;
    if (svOk) { ap.style.display = 'none'; }
    else if (a && a.alpha != null) {
      var AE = {pullback:['pullback','回调买点'], extended:['extended','急涨偏热'],
                intact:['intact','趋势完好'], laggard:['laggard','落后'], neutral:['neutral','中性']};
      var sgn = function (x, n) { return (x >= 0 ? '+' : '') + (x == null ? '—' : x.toFixed(n)); };
      var stat = function (lab, val, cls) { return '<span>' + lab + ' <b' + (cls ? ' class="' + cls + '"' : '') + '>' + val + '</b></span>'; };
      var html =
        stat(lz('alpha z','阿尔法 z'), sgn(a.alpha, 2), a.alpha >= 0 ? 'pos' : 'neg') +
        stat(lz('sector rank','板块排名'), a.sector_rank + '/' + a.sector_n, '') +
        (a.resid_ann != null ? stat(lz('idio ann','年化残差'), sgn(a.resid_ann, 0) + '%', (a.resid_ann >= 0 ? 'pos' : 'neg')) : '') +
        (a.rev_1m != null ? stat(lz('1-mo','近一月'), sgn(a.rev_1m, 1) + '%', (a.rev_1m >= 0 ? 'pos' : 'neg')) : '');
      if (a.entry && AE[a.entry])
        html += '<span class="alpha-entry ae-' + a.entry + '">' + lz(AE[a.entry][0], AE[a.entry][1]) + '</span>';
      document.getElementById('r_alpha').innerHTML = html;
      ap.style.display = 'block';
    } else { ap.style.display = 'none'; }

    // Fundamentals — descriptive context (yfinance). Additive; absent on ETFs/indices/uncovered.
    var fpEl = document.getElementById('r_fund_panel'), f = d.fundamentals;
    if (f && f.valuation) {
      var v = f.valuation;
      var fnum = function (x, n) { return x == null ? '—' : (+x).toFixed(n == null ? 1 : n); };
      function chip(lab, val, med, suffix) {
        if (val == null) return '';
        var vs = med != null ? '<span class="vs">' + lz('sector','板块') + ' ' + fnum(med, 1) + (suffix || '') + '</span>' : '';
        return '<div class="fnd-chip"><div class="k">' + lab + '</div><div class="v">' + fnum(val, 1) + (suffix || '') + '</div>' + vs + '</div>';
      }
      var fhtml = '<div><span class="fnd-arch">' + lz(f.archetype_label, f.archetype_label_zh) + '</span></div>';
      var desc = f.description && f.description.summary;
      if (desc) fhtml += '<p class="fnd-desc">' + desc.slice(0, 320) + (desc.length > 320 ? '…' : '') + '</p>';
      fhtml += '<div class="fnd-grid">'
        + chip('PE', v.pe, v.pe_sector_med) + chip('PB', v.pb, v.pb_sector_med)
        + chip('PS', v.ps, null) + chip('ROE', v.roe, v.roe_sector_med, '%')
        + chip(lz('Net margin','净利率'), v.net_margin, null, '%')
        + chip(lz('Div yield','股息率'), v.div_yield, v.div_yield_sector_med, '%')
        + chip(lz('Rev growth','营收增长'), v.rev_growth, null, '%') + '</div>';
      // forward valuation (income lens for dividend-heavy TSX) — second chip row
      var fwd = chip(L('f_fwdpe'), v.forward_pe, null) + chip(L('f_peg'), v.peg, null)
        + chip(L('f_payout'), v.payout, null, '%') + chip(L('f_5yy'), v.five_yr_yield, null, '%');
      if (fwd) fhtml += '<div class="fnd-grid">' + fwd + '</div>';
      document.getElementById('r_fund').innerHTML = fhtml;
      fpEl.style.display = 'block';
    } else { fpEl.style.display = 'none'; }

    var fnum2 = function (x, n) { return x == null ? '—' : (+x).toFixed(n == null ? 1 : n); };

    // Analyst & estimates — yfinance sell-side consensus (additive)
    var anEl = document.getElementById('r_analyst_panel'), an = (d.fundamentals || {}).consensus;
    if (an && (an.n_analysts || an.target_mean != null)) {
      var rk = (an.rating || '').toLowerCase();
      var rcls = rk.indexOf('buy') >= 0 ? 'buy' : (rk.indexOf('sell') >= 0 || rk.indexOf('underperform') >= 0) ? 'sell' : 'hold';
      var ah = '';
      if (an.rating) ah += '<span class="rchip ' + rcls + '">' + lz(an.rating, an.rating_zh) + '</span>';
      if (an.n_analysts) ah += ' <span class="muted" style="font-size:12px">' + an.n_analysts + ' ' + L('an_cov') + '</span>';
      ah += '<div class="fnd-grid" style="margin-top:10px">';
      if (an.target_mean != null) ah += '<div class="fnd-chip"><div class="k">' + L('an_target') + '</div><div class="v">' + fnum2(an.target_mean, 2) + '</div></div>';
      if (an.upside_pct != null) ah += '<div class="fnd-chip"><div class="k">' + L('an_upside') + '</div><div class="v ' + (an.upside_pct >= 0 ? 'pos' : 'neg') + '">' + (an.upside_pct >= 0 ? '+' : '') + an.upside_pct + '%</div></div>';
      if (an.target_low != null && an.target_high != null) ah += '<div class="fnd-chip"><div class="k">' + L('an_range') + '</div><div class="v" style="font-size:12.5px">' + fnum2(an.target_low, 0) + '–' + fnum2(an.target_high, 0) + '</div></div>';
      ah += '</div>';
      document.getElementById('r_analyst').innerHTML = ah;
      anEl.style.display = 'block';
    } else { anEl.style.display = 'none'; }

    // Earnings — next date (client-side countdown) + last-4 surprise history (additive)
    var enEl = document.getElementById('r_earn_panel'), ev = d.earnings;
    if (ev && (ev.next_date || (ev.surprises && ev.surprises.length))) {
      var eh = '';
      if (ev.next_date) {
        var pp = ev.next_date.split('-'), edt = new Date(+pp[0], +pp[1] - 1, +pp[2]);
        var enow = new Date(); enow.setHours(0, 0, 0, 0);
        var edd = Math.round((edt - enow) / 86400000);
        var when = edd <= 0 ? L('e_today') : L('e_in') + ' ' + edd + ' ' + L('e_dd');
        eh += '<div style="font-size:15px"><b>' + L('e_next') + ':</b> ' + ev.next_date + ' <span class="muted">(' + when + ')</span></div>';
        if (edd >= 0 && edd <= 7) eh += '<div class="early" style="margin-top:8px">' + L('e_soon') + '</div>';
      }
      var sur = ev.surprises || [];
      if (sur.length) {
        var beats = sur.filter(function (s) { return s.surprise_pct != null && s.surprise_pct > 0; }).length;
        eh += '<div class="muted" style="margin-top:10px; font-size:12px">' + L('e_beats') + ' ' + beats + ' ' + L('e_of') + ' ' + sur.length + '</div>';
        var ehead = '<tr><th>' + L('e_qtr') + '</th><th>' + L('e_eps') + '</th><th>' + L('e_est') + '</th><th>' + L('e_surp') + '</th></tr>';
        var ebody = sur.map(function (s) {
          var sc = s.surprise_pct == null ? '' : (s.surprise_pct >= 0 ? 'pos' : 'neg');
          return '<tr><td>' + s.date + '</td><td>' + fnum2(s.eps, 2) + '</td><td>' + (s.est == null ? '—' : fnum2(s.est, 2)) + '</td><td class="' + sc + '">' + (s.surprise_pct == null ? '—' : (s.surprise_pct >= 0 ? '+' : '') + s.surprise_pct + '%') + '</td></tr>';
        }).join('');
        eh += '<table class="fnd-tbl"><thead>' + ehead + '</thead><tbody>' + ebody + '</tbody></table>';
      }
      document.getElementById('r_earn').innerHTML = eh;
      enEl.style.display = 'block';
    } else { enEl.style.display = 'none'; }

    // Positioning — short interest + ownership (additive)
    var posEl = document.getElementById('r_pos_panel'), pos = (d.fundamentals || {}).positioning;
    if (pos && (pos.days_to_cover != null || pos.held_institutions != null || pos.shares_short != null)) {
      var ph = '<div class="fnd-grid">';
      if (pos.short_pct_float != null) ph += '<div class="fnd-chip"><div class="k">' + L('pos_short') + '</div><div class="v">' + pos.short_pct_float + '%<span class="vs">' + L('pos_float') + '</span></div></div>';
      else if (pos.shares_short != null) ph += '<div class="fnd-chip"><div class="k">' + L('pos_sh') + '</div><div class="v" style="font-size:13px">' + (pos.shares_short / 1e6).toFixed(1) + 'M</div></div>';
      if (pos.days_to_cover != null) ph += '<div class="fnd-chip"><div class="k">' + L('pos_dtc') + '</div><div class="v">' + fnum2(pos.days_to_cover, 1) + '</div></div>';
      if (pos.held_insiders != null) ph += '<div class="fnd-chip"><div class="k">' + L('pos_ins') + '</div><div class="v">' + pos.held_insiders + '%</div></div>';
      if (pos.held_institutions != null) ph += '<div class="fnd-chip"><div class="k">' + L('pos_inst') + '</div><div class="v">' + pos.held_institutions + '%</div></div>';
      ph += '</div>';
      document.getElementById('r_pos').innerHTML = ph;
      posEl.style.display = 'block';
    } else { posEl.style.display = 'none'; }

    // Insider activity — SEDI open-market personal trades via yfinance (additive)
    var insEl = document.getElementById('r_insider_panel'), ins = d.insider;
    if (ins && (ins.n_buys || ins.n_sells)) {
      var insMoney = function (x) {
        var a = Math.abs(x);
        return a >= 1e6 ? '$' + (x / 1e6).toFixed(1) + 'M' : a >= 1e3 ? '$' + (x / 1e3).toFixed(0) + 'k' : '$' + x.toFixed(0);
      };
      var insSh = function (x) {
        if (x == null) return '—';
        var a = Math.abs(x);
        return a >= 1e6 ? (x / 1e6).toFixed(2) + 'M' : a >= 1e3 ? (x / 1e3).toFixed(0) + 'k' : String(Math.round(x));
      };
      var insEsc = function (s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (ch) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]; });
      };
      var leanLab = ins.lean === 'buying' ? L('ins_buying') : ins.lean === 'selling' ? L('ins_selling') : L('ins_mixed');
      var leanChip = ins.lean === 'buying' ? 'buy' : ins.lean === 'selling' ? 'sell' : 'hold';
      var ih = '<div style="font-size:15px"><span class="rchip ' + leanChip + '">' + leanLab + '</span> <span class="muted" style="font-size:12px">· ' + L('ins_last') + ' ' + ins.window_days + ' ' + L('e_dd') + '</span></div>';
      ih += '<div class="fnd-grid" style="margin-top:10px">';
      ih += '<div class="fnd-chip"><div class="k">' + L('ins_buys') + '</div><div class="v pos">' + ins.n_buys + (ins.distinct_buyers ? '<span class="vs">' + ins.distinct_buyers + ' ' + L('ins_buyers') + '</span>' : '') + '</div></div>';
      ih += '<div class="fnd-chip"><div class="k">' + L('ins_sells') + '</div><div class="v neg">' + ins.n_sells + (ins.distinct_sellers ? '<span class="vs">' + ins.distinct_sellers + ' ' + L('ins_sellers') + '</span>' : '') + '</div></div>';
      if (ins.net_value != null) ih += '<div class="fnd-chip"><div class="k">' + L('ins_net') + '</div><div class="v ' + (ins.net_value >= 0 ? 'pos' : 'neg') + '">' + (ins.net_value >= 0 ? '+' : '') + insMoney(ins.net_value) + '</div></div>';
      ih += '</div>';
      var ir = ins.recent || [];
      if (ir.length) {
        var ihead = '<tr><th>' + L('ins_when') + '</th><th>' + L('ins_who') + '</th><th>' + L('ins_act') + '</th><th>' + L('ins_shares') + '</th></tr>';
        var ibody = ir.map(function (x) {
          var acls = x.action === 'buy' ? 'pos' : 'neg';
          var alab = x.action === 'buy' ? L('ins_buy') : L('ins_sell');
          var who = insEsc(x.insider || '—');
          if (x.role) who += ' <span class="muted" style="font-size:11px">' + insEsc(x.role) + '</span>';
          return '<tr><td>' + x.date + '</td><td>' + who + '</td><td class="' + acls + '">' + alab + '</td><td>' + insSh(x.shares) + '</td></tr>';
        }).join('');
        ih += '<table class="fnd-tbl"><thead>' + ihead + '</thead><tbody>' + ibody + '</tbody></table>';
      }
      document.getElementById('r_insider').innerHTML = ih;
      insEl.style.display = 'block';
    } else { insEl.style.display = 'none'; }

    // Calibration "trust the state" (additive; needs calibration.json)
    var calEl = document.getElementById('r_cal_panel');
    if (cal) {
      var cs = '<tr><th>' + L('th_state') + '</th><th>' + L('th_n') + '</th><th>' + L('th_up') + '</th><th>' + L('th_avg') + '</th><th>' + L('th_dipm') + '</th><th>' + L('th_dipb') + '</th></tr>';
      var _curCal = (d.ladder && d.ladder.state) || null;
      Object.keys(cal).forEach(function (s) {
        if (!DISP[s]) return;
        var cv = cal[s];
        var dipMed = cv.dd_med_pct != null ? cv.dd_med_pct + '%' : '—';
        var dipBad = cv.dd_p10_pct != null ? cv.dd_p10_pct + '%' : '—';
        var _cur = (s === _curCal); cs += '<tr class="' + (_cur ? 'cal-cur' : '') + '"><td><span class="state st-' + s.replace(/ /g, '_') + '">' + disp(s) + '</span>' + (_cur ? ' <span class="cal-here">▸ ' + (lang() === 'zh' ? '当前状态' : 'you are here') + '</span>' : '') + '</td><td>' + cv.n + '</td><td>' + cv.hit_pct + '%</td><td class="' + (cv.avg_fwd_pct > 0 ? 'pos' : 'neg') + '">' + cv.avg_fwd_pct + '%</td><td class="neg">' + dipMed + '</td><td class="neg">' + dipBad + '</td></tr>';
      });
      document.getElementById('r_cal').innerHTML = cs;
      calEl.style.display = 'block';
    } else { calEl.style.display = 'none'; }

    // Commodity exposure — now a country_slot card (commodity_beta) in the shared view;
    // render the legacy panel only as a fallback when the view-model didn't mount.
    var cbEl = document.getElementById('r_cbeta_panel'), fb = d.factor_beta;
    if (svOk) { cbEl.style.display = 'none'; }
    else if (fb && (fb.oil != null || fb.gold != null || fb.cad != null)) {
      var bstat = function (lab, x) {
        if (x == null) return '';
        return '<span>' + lab + ' <b class="' + (x >= 0 ? 'pos' : 'neg') + '">' + (x >= 0 ? '+' : '') + x.toFixed(2) + '</b></span>';
      };
      var cbh = bstat(L('cb_oil'), fb.oil) + bstat(L('cb_gold'), fb.gold) + bstat(L('cb_cad'), fb.cad);
      if (fb.primary_label) cbh += '<span class="alpha-entry ae-intact">' + lz(fb.primary_label, fb.primary_label_zh) + ' ' + lz('driven', '驱动') + '</span>';
      else cbh += '<span class="alpha-entry ae-neutral">' + L('cb_none') + '</span>';
      if (fb.r2 != null) cbh += '<span>' + L('cb_fit') + ' <b>' + fb.r2 + '</b></span>';
      document.getElementById('r_cbeta').innerHTML = cbh;
      cbEl.style.display = 'block';
    } else { cbEl.style.display = 'none'; }

    // Bespoke self-hosted chart (chart.js) from our own TSX closes (canadaohlc/<T>.json):
    // area + client-side RSI/Stoch/MACD/Stoch-RSI/EMA, 1D/3D/1W. Garnish — fails quietly.
    if (window.StockChart) {
      try { window.StockChart.mount(document.getElementById('tvbox'), d.ticker, {name: d.name, ohlcDir: 'canadaohlc'}); }
      catch (e) { /* chart is garnish */ }
    }
    hideEmptyGroups();
  }
  function hideEmptyGroups() {
    document.querySelectorAll('.sv-group').forEach(function (g) {
      var panels = g.querySelectorAll('.panel');
      var anyVisible = false;
      panels.forEach(function (p) { if (p.style.display !== 'none') anyVisible = true; });
      g.style.display = (panels.length && !anyVisible) ? 'none' : '';
    });
  }
  document.addEventListener('themechange', function () {
    var h = (location.hash || '').slice(1); if (h) load(decodeURIComponent(h));
  });
  document.addEventListener('langchange', function () {
    q.placeholder = L('ph'); var h = (location.hash || '').slice(1); if (h) load(decodeURIComponent(h));
  });
})();
</script>
<script src="mtf.js"></script>
<script src="theme.js"></script>
<script>
  // keep tooltips on-screen: flip below near the top, anchor to the nearest side near edges
  document.addEventListener('mouseover', function (e) {
    var h = e.target.closest('.help'); if (!h) return;
    var r = h.getBoundingClientRect();
    h.classList.toggle('below', r.top < 340);
    var tip = h.querySelector('.tip');
    var half = ((tip && tip.offsetWidth) || 300) / 2 + 16;
    h.classList.remove('edge-right', 'edge-left');
    if (r.left + r.width / 2 + half > window.innerWidth) h.classList.add('edge-right');
    else if (r.left + r.width / 2 - half < 0) h.classList.add('edge-left');
  });
</script>
<p class="muted" style="font-size:12px">{{ t('Generated', '生成于') }} {{ generated_utc }} UTC · {{ t('charts by TradingView · curated TSX universe, not exhaustive', '图表由 TradingView 提供 · 精选 TSX 范围，非全市场') }}</p>
