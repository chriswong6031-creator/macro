<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  /* ══════════════════════════════════════════════════════════════════════
     FACTORS — aurora-glass skin, ported from the macro.html mx5 system so the
     two pages read as one product. One type scale, one card idiom, one hover.

     TYPE SCALE (the only sizes allowed on this page):
       10 micro (eyebrows, units)   11 meta (secondary)   12 body
       13 title                     15 lead               20 / 44 numerals
     WEIGHTS: 400 body · 600 label · 700 title · 800 numeral
     ══════════════════════════════════════════════════════════════════════ */
  * { box-sizing:border-box; }
  /* horizontal page padding is a token so the sticky rail can cancel it and
     run full-bleed (see .railwrap) */
  :root{ --fx-padx:18px; }
  @media (min-width:1100px){ :root{ --fx-padx:max(40px,calc((100vw - 1360px)/2)); } }
  body { background:var(--bg); color:var(--text);
         font:400 13px/1.55 var(--font-ui); margin:0; padding:18px var(--fx-padx);
         -webkit-font-smoothing:antialiased; }
  @media (min-width:1100px){ body{ padding:26px var(--fx-padx); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; letter-spacing:-.02em; }
  h2 { font-size:11px; margin:0 0 12px; color:var(--muted); text-transform:uppercase;
       letter-spacing:.10em; font-weight:700; }

  /* ── glass tokens (mirrors dashboard.html.j2 §mx5-css) ─────────────── */
  :root{
    --fx-glass:      rgba(16,22,30,.55);
    --fx-brd:        rgba(255,255,255,.12);
    --fx-shadow:     0 8px 32px rgba(0,0,0,.42), 0 1.5px 0 rgba(255,255,255,.06) inset;
    --fx-hover-bg:   rgba(22,29,38,.62);
    --fx-hover-brd:  rgba(255,255,255,.16);
    --fx-hover-shadow:0 6px 24px rgba(0,0,0,.25);
    --fx-blur:       blur(20px);
    --fx-r:          16px;
  }
  html[data-theme="light"]{
    --fx-glass:      rgba(255,255,255,.82);
    --fx-brd:        rgba(0,0,0,.06);
    --fx-shadow:     0 4px 24px rgba(0,0,0,.07), 0 1px 0 rgba(255,255,255,.95) inset;
    --fx-hover-bg:   rgba(255,255,255,.94);
    --fx-hover-brd:  rgba(0,0,0,.14);
    --fx-hover-shadow:0 6px 24px rgba(0,0,0,.10);
  }
  /* Ambient aurora — two soft blooms, verdict hue + a neutral indigo companion.
     Fixed so it does not scroll; purely atmospheric, never carries information. */
  .fx-aurora{ position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
  .fx-aurora::before{ content:""; position:absolute; width:900px; height:700px;
    top:-220px; left:-160px; border-radius:50%; filter:blur(90px);
    background:radial-gradient(ellipse,color-mix(in srgb,var(--vh) 13%,transparent) 0%,transparent 70%); }
  .fx-aurora::after{ content:""; position:absolute; width:760px; height:620px;
    bottom:-140px; right:-120px; border-radius:50%; filter:blur(90px);
    background:radial-gradient(ellipse,rgba(99,102,241,.09) 0%,transparent 70%); }
  html[data-theme="light"] .fx-aurora::before{ background:radial-gradient(ellipse,color-mix(in srgb,var(--vh) 7%,transparent) 0%,transparent 70%); }
  html[data-theme="light"] .fx-aurora::after { background:radial-gradient(ellipse,rgba(99,102,241,.05) 0%,transparent 70%); }
  body > nav, body > .panel, body > .twocol, body > script,
  body > section, body > .railwrap { position:relative; z-index:1; }

  .panel { background:var(--fx-glass); border:1px solid var(--fx-brd);
           border-radius:var(--fx-r); padding:18px 20px; margin-bottom:16px;
           backdrop-filter:var(--fx-blur); box-shadow:var(--fx-shadow);
           position:relative; z-index:1; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); }
  .sm { font-size:11px; }
  table { border-collapse:collapse; width:100%; font-size:12px; }
  th,td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--fx-brd); }
  th { color:var(--muted); font-weight:600; font-size:10px; text-transform:uppercase;
       letter-spacing:.07em; }
  tbody tr:last-child td, table tr:last-child td { border-bottom:0; }
  td.r, th.r { text-align:right; }
  td.r, .num { font-variant-numeric:tabular-nums; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px;
          height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted);
          font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%);
               width:300px; background:var(--panel); border:1px solid var(--line); padding:9px 11px;
               border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text);
               font-weight:400; box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto;
               max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  .lead { display:flex; flex-direction:column; gap:6px; }
  /* name column sizes to its content: at 2-across the fixed 150px wrapped the
     longer labels ("Composite (de-correlated)") onto a second line */
  .leadrow { display:grid; grid-template-columns:minmax(150px,max-content) minmax(90px,1fr) 64px;
             align-items:center; gap:10px; }
  .leadbar { height:14px; border-radius:7px; background:var(--panel2); position:relative; overflow:hidden; }
  .leadbar > i { position:absolute; top:0; bottom:0; }
  .cardgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(258px,1fr)); gap:12px; }
  .fcard { background:color-mix(in srgb,var(--panel2) 55%,transparent);
           border:1px solid var(--fx-brd); border-radius:12px; padding:13px 14px;
           transition:transform .2s ease-out, border-color .2s ease-out, box-shadow .2s ease-out; }
  .fcard:hover { transform:translateY(-1px); border-color:var(--fx-hover-brd);
                 box-shadow:var(--fx-hover-shadow); }
  .fcard h3 { font-size:12px; font-weight:700; margin:0 0 9px; display:flex; align-items:center; }
  .fcard .badge { margin-left:auto; font-size:10px; font-weight:600; padding:2px 8px;
                  border-radius:999px; background:color-mix(in srgb,var(--muted) 12%,transparent);
                  border:1px solid var(--fx-brd); color:var(--muted); }
  .twocol { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; }
  @media (max-width:760px){ .twocol{ grid-template-columns:minmax(0,1fr); } }
  .zpos { color:var(--up); font-weight:700; } .zneg { color:var(--down); font-weight:700; }
  .chip { display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600;
          padding:3px 10px; margin:0 4px 4px 0; border-radius:999px;
          background:color-mix(in srgb,var(--panel2) 60%,transparent);
          border:1px solid var(--fx-brd); color:var(--muted); }
  /* validation chip — status colours (--ok/--act/--muted) do NOT flip in zh mode, unlike --up/--down */
  .val-chip { display:inline-block; font-size:9.5px; font-weight:700; letter-spacing:.03em;
              padding:1px 6px; margin-left:7px; border-radius:6px; vertical-align:middle; white-space:nowrap; }
  .val-chip.validated   { color:var(--ok);    border:1px solid color-mix(in srgb,var(--ok) 55%,transparent);
                          background:color-mix(in srgb,var(--ok) 12%,transparent); }
  .val-chip.negative-ic { color:var(--act);   border:1px solid color-mix(in srgb,var(--act) 55%,transparent);
                          background:color-mix(in srgb,var(--act) 14%,transparent); }
  .val-chip.fdr-fail    { color:var(--muted); border:1px solid var(--line); background:var(--panel2); }
  .ic-alert { margin:0 0 10px; padding:8px 11px; border-radius:7px; font-size:12px; line-height:1.5;
              border:1px solid color-mix(in srgb,var(--act) 45%,transparent);
              background:color-mix(in srgb,var(--act) 9%,var(--panel)); }
  .ic-alert b { color:var(--act); font-weight:700; }
  sub { font-size:.72em; }
  .bbar { display:inline-block; width:150px; max-width:42vw; height:11px; border-radius:6px;
          background:var(--panel2); position:relative; overflow:hidden; vertical-align:middle; }
  .bbar > i { position:absolute; left:0; top:0; bottom:0; border-radius:6px; }
  .spk { width:96px; height:26px; display:block; }
  .hm { border-collapse:collapse; font-size:11px; }
  .hm td, .hm th { border:1px solid var(--bg); padding:0; text-align:center; }
  .hm th { color:var(--muted); font-weight:500; padding:2px 4px; white-space:nowrap; }
  .hmc { width:30px; height:26px; text-align:center; color:var(--text); font-size:10px; }
  .quilt { border-collapse:collapse; font-size:10.5px; width:100%; }
  .quilt th { color:var(--muted); font-weight:500; padding:2px 4px; white-space:nowrap; font-size:10px; }
  .quilt td { padding:3px 5px; text-align:right; border:1px solid var(--bg); white-space:nowrap; }
  .quilt2 { border-collapse:separate; border-spacing:2px; font-size:10px; }
  .quilt2 th { color:var(--muted); font-weight:500; padding:1px 3px; text-align:center; font-size:9.5px; }
  .quilt2 td.qc { width:54px; height:30px; border-radius:4px; text-align:center; color:#0b1220; vertical-align:middle; }
  .quilt2 td.qc .qf { display:block; font-weight:600; font-size:9px; line-height:1.05; }
  .quilt2 td.qc .qv { display:block; font-size:9px; opacity:.85; font-variant-numeric:tabular-nums; }
  .quilt2 td.qc.hl { outline:2px solid var(--text); outline-offset:-2px; }
  .r20bars { display:grid; grid-template-columns:auto 1fr auto; gap:2px 8px; align-items:center; margin-top:4px; max-width:560px; }
  .r20lab { font-size:11.5px; color:var(--muted); white-space:nowrap; }
  .r20track { height:12px; border-radius:6px; background:var(--panel2); position:relative; }
  .r20track > i { position:absolute; top:0; bottom:0; }
  .r20track > i.mid { left:50%; width:1px; background:var(--muted); opacity:.5; }
  .r20val { font-size:11.5px; font-variant-numeric:tabular-nums; text-align:right; }
  .flip { display:inline-block; font-size:11px; padding:1px 7px; margin:0 4px 4px 0; border-radius:8px;
          background:var(--panel2); border:1px solid var(--line); }
  .seg { display:inline-flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  .seg button { border:0; border-radius:0; background:var(--panel); color:var(--text); cursor:pointer;
                font-size:12px; padding:4px 10px; }
  .seg button.on { background:var(--panel2); font-weight:600; }
  .scroll { overflow-x:auto; }
  table[data-leg="lo"] .v-ls, table[data-leg="ls"] .v-lo { display:none; }
  .chartbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between; margin:8px 0 2px; }
  .tabs { display:inline-flex; border:1px solid var(--line); border-radius:9px; overflow:hidden; }
  .tabs button { border:0; background:var(--panel); color:var(--muted); font-size:12px; padding:5px 11px; cursor:pointer; border-right:1px solid var(--line); }
  .tabs button:last-child { border-right:0; }
  .tabs button.on { background:var(--panel2); color:var(--text); font-weight:650; }
  .tabs .rangeN { width:72px; background:var(--panel); color:var(--text); border:0; border-left:1px solid var(--line); padding:5px 8px; font-size:12px; }
  #fchart { height:400px; width:100%; }
  .legend { display:flex; flex-wrap:wrap; gap:6px 14px; margin-top:10px; }
  .lchip { display:inline-flex; align-items:center; gap:6px; font-size:12px; cursor:pointer; }
  .lchip.off { opacity:.34; }
  .lchip .ldot { width:9px; height:9px; border-radius:50%; display:inline-block; }
  .lchip .lv { color:var(--muted); font-variant-numeric:tabular-nums; }
  #sector-monitor td.hzc { font-variant-numeric:tabular-nums; text-align:center; }
  #sector-monitor .zc { font-size:12.5px; font-weight:600; } #sector-monitor .rr { font-size:10px; opacity:.7; display:block; }
  /* NW status chips */
  .nw-chip { display:inline-block; font-size:10.5px; font-weight:600; padding:2px 8px; margin:0 4px 4px 0;
             border-radius:7px; border:1px solid var(--line); background:var(--panel2); color:var(--muted);
             white-space:nowrap; letter-spacing:.02em; }
  .nw-chip.live      { color:var(--ok);   border-color:color-mix(in srgb,var(--ok) 55%,transparent);
                       background:color-mix(in srgb,var(--ok) 10%,transparent); }
  .nw-chip.dormant   { color:var(--muted); }
  .nw-chip.shadow    { color:var(--act);  border-color:color-mix(in srgb,var(--act) 45%,transparent);
                       background:color-mix(in srgb,var(--act) 8%,transparent); }
  .nw-chip.accruing  { color:var(--act);  border-color:color-mix(in srgb,var(--act) 45%,transparent);
                       background:color-mix(in srgb,var(--act) 8%,transparent); }
  .nw-chip.bh-withheld { color:var(--down); border-color:color-mix(in srgb,var(--down) 50%,transparent);
                          background:color-mix(in srgb,var(--down) 8%,transparent); }
  .nw-chip.null      { color:var(--muted); }
  .nw-chip.gate-passed { color:var(--ok);  border-color:color-mix(in srgb,var(--ok) 55%,transparent);
                          background:color-mix(in srgb,var(--ok) 10%,transparent); }
  .nw-chip.pre-fdr   { color:var(--muted); font-style:italic; }
  .nw-status-grid { display:grid; grid-template-columns:minmax(130px,auto) 1fr; gap:4px 12px;
                    font-size:12px; align-items:start; margin-top:10px; }
  .nw-status-grid .nw-lab { color:var(--muted); padding-top:2px; }
  .nw-influence { display:flex; flex-wrap:wrap; gap:4px 0; margin-top:4px; }
  .nw-influence .nw-chip { margin-bottom:0; }

  /* ══════════════════════════════════════════════════════════════════════
     THE VERDICT HERO — this page's signature.
     Most factor dashboards open with a leaderboard. This one opens with its own
     scorecard: how many of these rankings actually beat chance on a leak-free
     point-in-time test. The ruler on the right plots every factor's measured
     edge against a HARD ZERO LINE, so the honest answer ("almost none of them
     move off zero") is the first thing the eye resolves — before any ranking.
     ══════════════════════════════════════════════════════════════════════ */
  .vhero { display:grid; grid-template-columns:minmax(0,320px) minmax(0,1fr);
           gap:0; padding:0; overflow:hidden; }
  @media (max-width:860px){ .vhero{ grid-template-columns:minmax(0,1fr); } }
  .vh-left { padding:24px 26px 22px; border-right:1px solid var(--fx-brd); }
  @media (max-width:860px){ .vh-left{ border-right:0; border-bottom:1px solid var(--fx-brd); } }
  .vh-eyebrow { font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
                color:var(--muted); margin-bottom:14px; display:flex; align-items:center; gap:8px; }
  .vh-eyebrow .dot { width:6px; height:6px; border-radius:50%; background:var(--vh); flex:none; }
  .vh-count { display:flex; align-items:baseline; gap:9px; }
  .vh-num { font-size:44px; font-weight:800; line-height:1; letter-spacing:-.035em;
            color:var(--vh); font-variant-numeric:tabular-nums; }
  .vh-of { font-size:12px; font-weight:600; color:var(--muted); line-height:1.35; }
  .vh-claim { font-size:15px; font-weight:700; letter-spacing:-.01em; margin:12px 0 0;
              line-height:1.35; color:var(--text); }
  .vh-stance { font-size:12px; color:var(--muted); line-height:1.55; margin:8px 0 0; }
  .vh-who { display:flex; flex-wrap:wrap; gap:6px; margin-top:13px; }
  .vh-who .chip { margin:0; border-color:color-mix(in srgb,var(--vh) 40%,transparent);
                  color:var(--vh); background:color-mix(in srgb,var(--vh) 11%,transparent); }

  /* ── the ruler ──────────────────────────────────────────────────────── */
  .vh-right { padding:22px 26px 20px; min-width:0; }
  .vh-rhead { display:flex; align-items:baseline; justify-content:space-between;
              gap:12px; margin-bottom:14px; }
  .vh-rtitle { font-size:10px; font-weight:700; letter-spacing:.10em; text-transform:uppercase;
               color:var(--muted); }
  .vh-rnote { font-size:10px; color:var(--muted); }
  .ruler { display:grid; grid-template-columns:minmax(84px,auto) minmax(0,1fr) 52px 60px;
           align-items:center; gap:3px 10px; }
  .rl-name { font-size:11px; color:var(--text); white-space:nowrap; overflow:hidden;
             text-overflow:ellipsis; }
  .rl-track { position:relative; height:15px; }
  /* the zero line is the point of the whole graphic — draw it hard, not as a hint */
  /* The zero axis. Each track draws its own segment and bleeds 3px past the 3px
     row gap, so the segments meet and read as ONE continuous axis — the first grid
     column is auto-width, so a single absolutely-positioned line cannot track it. */
  .rl-track::before { content:""; position:absolute; left:50%; top:-3px; bottom:-3px; width:1px;
                      background:color-mix(in srgb,var(--text) 34%,transparent); }
  .ruler { position:relative; }
  .rl-bar { position:absolute; top:3px; bottom:3px; border-radius:2px; }
  .rl-bar.p { left:50%; background:color-mix(in srgb,var(--up) 62%,transparent); }
  .rl-bar.n { right:50%; background:color-mix(in srgb,var(--down) 62%,transparent); }
  .rl-row.pass .rl-bar.p { background:var(--up); }
  .rl-val { font-size:11px; text-align:right; font-variant-numeric:tabular-nums; color:var(--muted); }
  .rl-tag { font-size:9px; font-weight:700; letter-spacing:.05em; text-align:right;
            text-transform:uppercase; color:var(--muted); }
  .rl-row.pass .rl-tag { color:var(--up); }
  .rl-row.pass .rl-name { font-weight:700; }
  .rl-axis { grid-column:2; display:flex; justify-content:space-between; font-size:9px;
             color:var(--muted); margin-top:4px; }
  .rl-zero { grid-column:2; text-align:center; font-size:9px; color:var(--muted);
             letter-spacing:.08em; margin-top:2px; }
  @media (max-width:640px){
    .ruler{ grid-template-columns:minmax(70px,auto) minmax(0,1fr) 46px; }
    .rl-tag{ display:none; }
  }

  /* ══════════════════════════════════════════════════════════════════════
     STYLE TAPE — the three style spreads the Neural Web already tracks
     (growth vs value, mega-tech vs market, small vs large), promoted out of the
     `etf_pulse_summary` debug string into the page's second read.
     ══════════════════════════════════════════════════════════════════════ */
  .tape { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:12px; }
  .tp { background:color-mix(in srgb,var(--panel2) 55%,transparent);
        border:1px solid var(--fx-brd); border-radius:12px; padding:13px 15px 12px;
        transition:transform .2s ease-out, border-color .2s ease-out, box-shadow .2s ease-out; }
  .tp:hover { transform:translateY(-1px); border-color:var(--fx-hover-brd); box-shadow:var(--fx-hover-shadow); }
  .tp-poles { display:flex; justify-content:space-between; font-size:10px; font-weight:600;
              letter-spacing:.06em; text-transform:uppercase; color:var(--muted); }
  .tp-rail { position:relative; height:6px; border-radius:3px; margin:9px 0 8px;
             background:color-mix(in srgb,var(--muted) 16%,transparent); }
  .tp-rail::before { content:""; position:absolute; left:50%; top:-3px; bottom:-3px; width:1px;
                     background:color-mix(in srgb,var(--text) 34%,transparent); }
  .tp-fill { position:absolute; top:0; bottom:0; border-radius:3px; }
  /* Direction, not merit: neither pole of a style spread is the good one, so the
     rail uses the neutral info hue in both directions rather than green/red. */
  .tp-fill.p { left:50%; background:var(--info); }
  .tp-fill.n { right:50%; background:color-mix(in srgb,var(--info) 62%,var(--muted)); }
  .tp-read { display:flex; align-items:baseline; gap:8px; }
  .tp-num { font-size:20px; font-weight:800; line-height:1; letter-spacing:-.02em;
            font-variant-numeric:tabular-nums; color:var(--text); }
  .tp-lean { font-size:11px; font-weight:600; color:var(--muted); }
  .tp-plain { font-size:11px; color:var(--muted); line-height:1.5; margin-top:7px; }

  /* ── NW accrual meters (replaces the five identical BH-WITHHELD chips) ── */
  .acc { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; margin-top:4px; }
  .acc-item { min-width:0; }
  .acc-top { display:flex; align-items:baseline; justify-content:space-between; gap:8px; }
  .acc-lab { font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .acc-val { font-size:11px; font-weight:700; font-variant-numeric:tabular-nums; }
  .acc-rail { height:5px; border-radius:3px; margin-top:7px; overflow:hidden;
              background:color-mix(in srgb,var(--muted) 16%,transparent); }
  .acc-fill { height:100%; border-radius:3px; background:var(--info); }
  .acc-fill.done { background:var(--up); }
  .acc-sub { font-size:10px; color:var(--muted); margin-top:5px; line-height:1.45; }

  /* ── page header ────────────────────────────────────────────────────── */
  .fx-head { position:relative; z-index:1; margin:2px 0 16px; }
  .fx-head h1 { font-size:22px; font-weight:800; letter-spacing:-.025em; margin:0; }
  .fx-head p { font-size:12px; color:var(--muted); margin:6px 0 0; max-width:74ch; line-height:1.55; }
  /* ══════════════════════════════════════════════════════════════════════
     SECTIONED IA — this page had grown to 20 same-weight panels in a single
     scroll, grouped by CHART TYPE rather than by factor, so reading one factor
     meant visiting eight panels. Sections + a scroll-spy rail give it a spine;
     the factor drawer (below) inverts it to factor-first.
     ══════════════════════════════════════════════════════════════════════ */
  .railwrap{ position:sticky; top:0; z-index:40; background:var(--bg);
             border-bottom:1px solid var(--line);
             /* negative inline margin cancels the body padding so the bar runs
                edge-to-edge; a rail with a transparent top edge reads as a
                detached floating box once content scrolls under it */
             margin:0 calc(-1 * var(--fx-padx)) 20px; padding:0 var(--fx-padx); }
  .fx-rail{ display:flex; gap:2px; overflow-x:auto; scrollbar-width:none; }
  .fx-rail::-webkit-scrollbar{ display:none; }
  .fx-rail a{ padding:11px 14px; font-size:11.5px; font-weight:600; color:var(--muted);
              white-space:nowrap; border-bottom:2px solid transparent; transition:color .15s; }
  .fx-rail a:hover{ color:var(--text); }
  .fx-rail a.on{ color:var(--text); border-bottom-color:var(--warn); }

  .fx-sec{ scroll-margin-top:56px; margin-bottom:26px; }
  .sec-h{ display:flex; align-items:baseline; gap:12px; margin:0 0 4px; }
  .sec-n{ font-size:10px; font-weight:800; letter-spacing:.14em; color:var(--muted); opacity:.55; }
  /* overrides the global uppercase 11px h2 — section titles are page furniture */
  .sec-h h2{ font-size:17px; font-weight:700; letter-spacing:-.02em; margin:0;
             color:var(--text); text-transform:none; }
  .sec-sub{ font-size:12px; color:var(--muted); margin:0 0 14px; max-width:78ch; }

  .fx-grid2{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr);
             gap:16px; align-items:start; }
  .fx-grid2 > .panel{ margin-bottom:0; }
  @media (max-width:860px){ .fx-grid2{ grid-template-columns:minmax(0,1fr); } }

  /* explorer — five stacked panels behind one tab strip */
  .fx-tabs{ display:flex; gap:3px; flex-wrap:wrap; margin-bottom:14px; width:fit-content;
            max-width:100%; background:color-mix(in srgb,var(--panel2) 55%,transparent);
            padding:3px; border-radius:10px; border:1px solid var(--fx-brd); }
  .fx-tabs button{ background:transparent; border:0; color:var(--muted); font:inherit;
                   font-size:11.5px; font-weight:600; padding:6px 13px; border-radius:7px;
                   cursor:pointer; white-space:nowrap; }
  .fx-tabs button.on{ background:var(--panel); color:var(--text);
                      box-shadow:0 1px 4px rgba(0,0,0,.25); }
  .fx-pane{ display:none; } .fx-pane.on{ display:block; }

  /* ── FACTOR DRAWER ────────────────────────────────────────────────────
     One factor's whole story in one place: definition, measured edge, the
     portfolio it actually produced, crowding, and its leaders. Opens from any
     factor name on the page. Deep-linkable as #f/<key>.                   */
  .fx-scrim{ position:fixed; inset:0; background:rgba(0,0,0,.5); opacity:0;
             pointer-events:none; transition:opacity .22s; z-index:90; }
  .fx-scrim.on{ opacity:1; pointer-events:auto; }
  .fx-drawer{ position:fixed; top:0; right:0; bottom:0; width:min(430px,100vw); z-index:100;
              background:var(--panel); border-left:1px solid var(--fx-brd);
              box-shadow:-20px 0 60px rgba(0,0,0,.5); transform:translateX(100%);
              transition:transform .26s cubic-bezier(.22,.61,.36,1);
              overflow-y:auto; padding:20px 22px 40px; }
  .fx-drawer.on{ transform:none; }
  .dw-x{ position:absolute; top:14px; right:16px; background:transparent; border:0;
         color:var(--muted); font-size:19px; cursor:pointer; line-height:1; padding:4px; }
  .dw-eyebrow{ font-size:9.5px; font-weight:800; letter-spacing:.14em; text-transform:uppercase;
               color:var(--muted); opacity:.7; }
  .dw-title{ display:flex; align-items:center; gap:9px; margin:5px 0 3px; flex-wrap:wrap; }
  .dw-title h3{ font-size:21px; margin:0; letter-spacing:-.025em; font-weight:700; }
  .dw-blurb{ font-size:12px; color:var(--muted); margin:8px 0 18px; line-height:1.6; }
  .dw-sec{ border-top:1px solid var(--fx-brd); padding-top:13px; margin-top:15px; }
  .dw-sec h4{ font-size:9.5px; font-weight:800; letter-spacing:.13em; text-transform:uppercase;
              color:var(--muted); margin:0 0 9px; }
  .dw-kv{ display:grid; grid-template-columns:1fr auto; gap:6px 12px; font-size:12px; }
  .dw-kv .k{ color:var(--muted); }
  .dw-kv .v{ font-variant-numeric:tabular-nums; font-weight:700; text-align:right; }
  .dw-read{ font-size:12px; line-height:1.6; margin:0; padding:10px 12px; border-radius:9px;
            background:color-mix(in srgb,var(--panel2) 70%,transparent);
            border:1px solid var(--fx-brd); }
  .dw-names{ display:flex; flex-wrap:wrap; gap:5px; }
  /* any factor name that can open the drawer */
  .fx-open{ cursor:pointer; border-bottom:1px dotted transparent; }
  .fx-open:hover{ border-bottom-color:var(--muted); }
  @media (prefers-reduced-motion:reduce){ .fx-drawer,.fx-scrim{ transition:none; } }

  /* ticker search across the leader cards */
  .fx-find{ display:flex; gap:10px; align-items:center; margin-bottom:13px; flex-wrap:wrap; }
  .fx-find .box{ position:relative; flex:1; min-width:210px; max-width:330px; }
  .fx-find input{ width:100%; background:color-mix(in srgb,var(--panel2) 65%,transparent);
                  border:1px solid var(--fx-brd); border-radius:9px; padding:8px 12px 8px 30px;
                  color:var(--text); font:inherit; font-size:12px; outline:none; }
  .fx-find input:focus{ border-color:var(--fx-hover-brd); }
  .fx-find .mag{ position:absolute; left:10px; top:50%; transform:translateY(-50%);
                 font-size:11px; color:var(--muted); pointer-events:none; }
  .fx-find .note{ font-size:11px; color:var(--muted); }
  .fcard.dim{ opacity:.28; }
  .fcard tr.hit td{ background:color-mix(in srgb,var(--warn) 16%,transparent); }
</style>
<script src="lightweight-charts.js"></script>
</head>
<body>

{% include "_site_nav.html.j2" %}

  <div class="fx-aurora" aria-hidden="true"></div>

  {# Page header — one line of identity, then straight into the verdict. The old
     standalone title card said the same thing three times over (title, tagline,
     and a paragraph) before the reader reached any data. #}
  <header class="fx-head">
    <h1>{{ t('Factors & seasonality', '因子与季节性') }}{{ help(
      "The cross-sectional factors quant equity desks actually trade — computed from SEC EDGAR fundamentals joined to prices, not proxied by an ETF. Each factor is a winsorized cross-sectional z-score (higher = more attractive on that factor); the composite is their equal-weight blend. These are RANKS and context, not a backtested alpha: factors decay and crowd, free fundamentals are sparse for some tags, book/price is weak for intangible-heavy firms, and every value is lagged to the filing period (no look-ahead).",
      "量化股票交易台真正使用的横截面因子 — 由 SEC EDGAR 基本面与价格计算，而非用 ETF 代理。每个因子为去极值后的横截面 z 分数（越高 = 在该因子上越有吸引力）；综合为等权混合。这些是排名与背景，而非回测出的超额收益：因子会衰减与拥挤，免费基本面在部分科目上稀疏，市净率对无形资产密集的公司较弱，且所有数值滞后至申报期（无前视）。"
    ) }}</h1>
    <p>{{ t('Which style of stock is working — cheap, high quality, dividend-paying, recent winners — and whether that has ever meant anything.',
            '哪种风格的股票正在起作用——低估值、高质量、高分红、近期赢家——以及这是否真的有意义。') }}</p>
  </header>


  <section class="fx-sec" id="sec-verdict">
    <div class="sec-h"><span class="sec-n">01</span><h2>{{ t('The verdict', '结论') }}</h2></div>
    <p class="sec-sub">{{ t('Does any of this predict? Everything below is derived from the same scorecard, so the page cannot disagree with itself.', '这些排名能预测吗？以下全部源自同一记分卡，因此本页不会自相矛盾。') }}</p>
  {# ── THE VERDICT HERO ────────────────────────────────────────────────────
     Signature element. `n_pass` counts the factor legs that clear BH-FDR with a
     POSITIVE measured edge — the same bar the composite passport uses to decide
     what may order the board. Everything is derived from the IC scorecard, so
     the hero can never disagree with the table further down the page.
     Fail-open: no scorecard → fall back to the plain title block. ────────── #}
  {% set _icrows = (ic.rows if (ic and ic.rows) else []) %}
  {% set _pass = _icrows | selectattr('survives_fdr') | selectattr('mean_ic') | selectattr('mean_ic','gt',0) | list %}
  {% set _npass = _pass | length %}
  {% set _ntot  = _icrows | rejectattr('factor','eq','composite_orth') | list | length %}
  {% set _vhue  = 'var(--up)' if _npass >= 3 else ('var(--warn)' if _npass >= 1 else 'var(--down)') %}

  {% if _icrows %}
  <div class="panel vhero" style="--vh:{{ _vhue }}">
    <div class="vh-left">
      <div class="vh-eyebrow"><span class="dot"></span>{{ t('Does any of this predict?', '这些排名能预测吗？') }}</div>
      <div class="vh-count">
        <span class="vh-num">{{ _npass }}</span>
        <span class="vh-of"><span class="l-en">of {{ _ntot }} rankings<br>beat chance</span><span class="l-zh">项排名（共 {{ _ntot }} 项）<br>优于随机</span></span>
      </div>
      <p class="vh-claim">
        {% if _npass == 0 %}
          {{ t('Nothing here has earned a buy list.', '没有一项排名足以作为买入清单。') }}
        {% elif _npass == 1 %}
          {{ t('One ranking clears the bar — barely.', '仅一项排名勉强通过检验。') }}
        {% else %}
          {{ t(_npass ~ ' rankings clear the bar.', ('通过检验的排名：' ~ _npass ~ ' 项')) }}
        {% endif %}
      </p>
      <p class="vh-stance">
        {% if _npass == 0 %}
          {{ t('Read every ranking below as a description — what is cheap, what is high quality — not as a signal. Stand aside on the composite.',
               '请将下方所有排名视为描述——哪些便宜、哪些优质——而非信号。综合因子应当回避。') }}
        {% else %}
          {{ t('Use it as a tilt, not a trade. Every other ranking below is a description of the market, not a forecast of it.',
               '可作为组合倾斜，而非交易信号。下方其余排名只是对市场的描述，不是预测。') }}
        {% endif %}
      </p>
      {% if _pass %}
      <div class="vh-who">
        {% for r in _pass %}<span class="chip">{{ t(r.label_en, fac.factor_labels.get(r.factor, r.label_en)) }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="vh-right">
      <div class="vh-rhead">
        <span class="vh-rtitle">{{ t('Measured edge vs zero', '实测优势相对零') }}</span>
        <span class="vh-rnote">
          {% if ic.span %}{{ ic.span }} · {% endif %}{{ ic.rebalances }}{{ t(' quarters', ' 个季度') }}
          {{ help(
            "Each bar is the factor's mean Information Coefficient — the rank correlation between the factor score and the NEXT " ~ ic.horizon_d ~ "-day return, rebuilt at every quarter-end from only what was knowable then. The centre line is ZERO: no edge. A bar you can barely see is a factor that does not predict. PASSES = clears Benjamini-Hochberg FDR across every factor screened AND has a positive mean IC. The panel below carries the full statistics.",
            "每根柱为该因子的平均信息系数（IC）——因子分数与未来 " ~ ic.horizon_d ~ " 日回报的秩相关，在每个季末仅用当时可知的信息重建。中线为零：无优势。几乎看不见的柱意味着该因子没有预测力。PASSES = 通过 BH-FDR 多重检验且平均 IC 为正。完整统计见下方面板。") }}
        </span>
      </div>
      {% set _icmax = ([0.03] + (_icrows | map(attribute='mean_ic') | select('defined') | select('number') | map('abs') | list)) | max %}
      <div class="ruler">
        {% for r in _icrows if r.factor not in ['composite_orth'] %}
        {% set _p = (r.survives_fdr and r.mean_ic is not none and r.mean_ic > 0) %}
        <div class="rl-row {{ 'pass' if _p else '' }}" style="display:contents">
          <span class="rl-name fx-open" data-fx="{{ r.factor }}">{{ t(r.label_en, fac.factor_labels.get(r.factor, r.label_en)) }}</span>
          <span class="rl-track">
            {% if r.mean_ic is not none and r.mean_ic != 0 %}
            {% set _w = (r.mean_ic|abs / _icmax * 50)|round(2) %}
            <i class="rl-bar {{ 'p' if r.mean_ic > 0 else 'n' }}" style="width:{{ _w }}%{{ ';background:var(--up)' if _p else '' }}"></i>
            {% endif %}
          </span>
          <span class="rl-val">{{ '%+.3f'|format(r.mean_ic) if r.mean_ic is not none else '—' }}</span>
          <span class="rl-tag">{% if _p %}{{ t('passes','通过') }}{% elif r.mean_ic is not none and r.mean_ic < 0 %}{{ t('inverts','反向') }}{% else %}{{ t('no edge','无优势') }}{% endif %}</span>
        </div>
        {% endfor %}
        <div class="rl-zero">{{ t('↑ zero = no edge', '↑ 零 = 无优势') }}</div>
      </div>
    </div>
  </div>
  {% endif %}
  </section>

  {# Section rail — deliberately opaque and full-bleed (--fx-padx negative
     margin): a rail with a transparent top edge reads as 'floating'. #}
  <div class="railwrap"><nav class="fx-rail" id="fx-rail">
    <a href="#sec-verdict">{{ t('Verdict','结论') }}</a>
    <a href="#sec-leadership">{{ t('Leadership','领先风格') }}</a>
    <a href="#sec-evidence">{{ t('Evidence','证据') }}</a>
    <a href="#sec-explorer">{{ t('Explorer','探索') }}</a>
    <a href="#sec-names">{{ t('Names','个股') }}</a>
    <a href="#sec-season">{{ t('Seasonality','季节性') }}</a>
    <a href="#sec-system">{{ t('System','系统') }}</a>
  </nav></div>

  <section class="fx-sec" id="sec-leadership">
    <div class="sec-h"><span class="sec-n">02</span><h2>{{ t('Leadership now', '当前领先') }}</h2></div>
    <p class="sec-sub">{{ t('Where the money has actually gone. Descriptive — leadership rotates, and none of this has been tested for predictive power.', '资金实际流向。仅为描述——领先风格会轮换，且均未经过预测力检验。') }}</p>
  <div class="fx-grid2">
  {# ── STYLE TAPE ─────────────────────────────────────────────────────────
     The three style spreads the Neural Web already computes every night and,
     until now, only wrote to `factor_weather.etf_pulse_summary` as a debug
     string ("IWF/IWD_20d=-0.0195; ..."). Promoted here to a first-class read:
     each is a 20-day relative move between two poles, plotted against zero.
     Fail-open: the panel hides when the NW state artifact is absent. ────── #}
  {% set _fw = ((nw_state or {}).get('factor_weather') or {}) %}
  {% set _rails = [
      ('ratio_iwf_iwd_20d', 'Value', '价值', 'Growth', '成长',
       'Growth stocks vs value stocks, last 20 days (Russell 1000 Growth against Russell 1000 Value).',
       '成长股相对价值股，近20日（罗素1000成长 对 罗素1000价值）。'),
      ('ratio_qqq_spy_20d', 'Broad market', '大盘', 'Big tech', '科技巨头',
       'The Nasdaq-100 against the S&P 500, last 20 days — whether the megacap tech complex is carrying the tape.',
       '纳斯达克100 相对 标普500，近20日——科技巨头是否在主导行情。'),
      ('ratio_iwm_spy_20d', 'Large caps', '大盘股', 'Small caps', '小盘股',
       'Small caps against the S&P 500, last 20 days — a widening tape when small caps lead, a narrowing one when they lag.',
       '小盘股相对标普500，近20日——小盘领先意味涨势扩散，落后意味集中于头部。'),
  ] %}
  {% set _has_rail = _rails | selectattr(0, 'in', _fw) | list | length > 0 %}
  {% if _has_rail %}
  <div class="panel">
    <div class="topline" style="margin-bottom:12px">
      <h2 style="margin:0">{{ t('Style tape — what is actually leading', '风格行情 — 当前谁在领先') }}</h2>
      <span class="muted sm">{{ t('20-day relative move', '20日相对涨跌') }}</span>
    </div>
    <div class="tape">
      {% for key, lo_en, lo_zh, hi_en, hi_zh, plain_en, plain_zh in _rails %}
      {% set _v = _fw.get(key) %}
      {% if _v is not none %}
      {% set _pct = (_v * 100) %}
      {% set _w = ([_pct|abs / 8.0, 1.0]|min * 50)|round(2) %}
      <div class="tp">
        <div class="tp-poles"><span>← {{ t(lo_en, lo_zh) }}</span><span>{{ t(hi_en, hi_zh) }} →</span></div>
        <div class="tp-rail">
          <i class="tp-fill {{ 'p' if _pct >= 0 else 'n' }}" style="width:{{ _w }}%"></i>
        </div>
        <div class="tp-read">
          <span class="tp-num">{{ '%+.1f'|format(_pct) }}%</span>
