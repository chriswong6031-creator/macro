        </table>
      </div>
      <div>
        <h3 class="sm neg" style="margin:0 0 6px">{{ t('Biggest net SELLING', '最大净卖出') }}</h3>
        <table>
          <tr><th>{{ t('stock','个股') }}</th><th>{{ t('sector','板块') }}</th><th class="r">{{ t('net $','净额') }}</th><th class="r">B/S</th></tr>
          {% for x in fac.insider.top_selling %}
