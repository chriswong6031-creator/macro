{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro spark1(vals) -%}
{% if vals and vals|length > 1 %}
{% set lo = vals|min %}{% set hi = vals|max %}{% set rng = (hi - lo) or 1 %}
<svg viewBox="0 0 96 26" class="spk" preserveAspectRatio="none"><polyline fill="none" stroke="{{ 'var(--up)' if vals[-1] >= 0 else 'var(--down)' }}" stroke-width="1.4" points="{% for v in vals %}{{ (loop.index0/(vals|length-1)*96)|round(1) }},{{ (24-(v-lo)/rng*22)|round(1) }} {% endfor %}"/></svg>
{% endif %}
{%- endmacro %}
{% macro hcell(c) -%}
<td class="hmc" style="background:{{ ('rgba(56,139,253,' ~ (c*0.85)|round(2) ~ ')') if c >= 0 else ('rgba(248,81,73,' ~ (-c*0.85)|round(2) ~ ')') }}">{{ '%.2f'|format(c) }}</td>
{%- endmacro %}
{% set FHELP = {
  'value': ['Cheap on fundamentals — a blend of earnings yield, book/price, sales/price and cash-flow yield (the cross-section Fama-French/Dimensional trade). Volatile and regime-dependent; book/price is weak for intangible-heavy firms.', '基本面便宜 — 盈利收益率、市净率倒数、市销率倒数与现金流收益率的综合。'],
  'profitability': ['Gross profitability = gross profit / total assets (Novy-Marx). About as powerful as book/price historically, and it tilts the OPPOSITE way (toward growthier, higher-quality names).', '毛利润率 = 毛利润／总资产（Novy-Marx）。'],
  'quality': ['A quality composite: high ROE, LOW accruals (cash-backed earnings — Sloan), and low leverage. AQR Quality-Minus-Junk style; tends to hold up in drawdowns.', '质量综合：高 ROE、低应计、低杠杆（AQR QMJ 风格）。'],
  'investment': ['Conservative investment = LOW asset growth (Fama-French CMA). Firms that grow the balance sheet aggressively tend to underperform.', '保守投资 = 低资产增长（Fama-French CMA）。'],
  'payout': ['Net shareholder yield = (dividends + buybacks) / market cap. Total payout predicts returns where dividends alone do not. Sparse on free data.', '净股东收益率 =（股息＋回购）／市值。'],
  'low_vol': ['The low-volatility anomaly: low trailing total volatility has historically delivered market-like returns with less risk (USMV/SPLV capture this).', '低波动异象：低历史波动率。'],
  'low_beta': ['Betting-Against-Beta (Frazzini-Pedersen): low-beta stocks have had high risk-adjusted returns because leverage-constrained investors bid up high-beta names.', 'Betting-Against-Beta：低贝塔。'],
  'accruals': ['Low accruals = earnings backed by cash flow, not estimates (Sloan). High-accrual earnings tend to reverse.', '低应计：盈利由现金流支撑。'],
  'short_interest': ['Low short interest. High days-to-cover (short interest / avg daily volume, FINRA bi-monthly) negatively predicts the cross-section (Hong-Li-Rajan-Sherman) — leaders here are the LEAST shorted; the laggards are the crowded shorts.', '低做空。高回补天数（FINRA 双月）在横截面上负向预测。'],
  'sue': ['Earnings momentum (SUE = standardized unexpected earnings). Latest quarterly EPS vs the same quarter a year ago, standardized by its own history — the post-earnings-announcement-drift effect: beats keep drifting up. Built point-in-time from free SEC EDGAR quarterly EPS frames; in our leak-free IC scorecard it is the STRONGEST positive factor and the one that survives the FDR control (validated on the 2023-2025 price window, like the rest of the zoo). ⚠️ A deep 2011-2026 re-validation (survivorship-optimistic) collapsed this edge to ~zero (IC 0.0005, HAC t 0.06, L/S Sharpe 0.09) — it held only on that shallow window (PEAD post-publication decay), so treat SUE as descriptive, not a validated scored factor.', '盈利动量（SUE = 标准化超预期盈利）。最新季度 EPS 对比去年同季、以自身历史标准化 — 盈利公布后漂移效应。基于 SEC EDGAR 季度 EPS 逐期点时构建；在防泄漏 IC 评分中（浅窗口）为最强正向因子且通过 FDR。⚠️ 深度 2011-2026 复验显示该边际接近零（IC 0.0005，t 0.06），仅在浅窗口成立 — 视为展示性因子，非已验证计分因子。'],
} %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Equity factor rankings — value, quality, low-vol & more</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1320px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; color:var(--muted); text-transform:uppercase;
       letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); }
  .sm { font-size:12px; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:left; padding:4px 7px; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:500; }
  td.r, th.r { text-align:right; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px;
          height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted);
          font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%);
               width:300px; background:var(--panel); border:1px solid var(--line); padding:9px 11px;
               border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text);
               font-weight:400; box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto;
               max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  .lead { display:flex; flex-direction:column; gap:6px; }
  .leadrow { display:grid; grid-template-columns:150px 1fr 64px; align-items:center; gap:10px; }
  .leadbar { height:14px; border-radius:7px; background:var(--panel2); position:relative; overflow:hidden; }
  .leadbar > i { position:absolute; top:0; bottom:0; }
  .cardgrid { display:grid; grid-template-columns:repeat(auto-fill,minmax(255px,1fr)); gap:14px; }
  .fcard { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:11px 12px; }
  .fcard h3 { font-size:13px; margin:0 0 7px; display:flex; align-items:center; }
  .fcard .badge { margin-left:auto; font-size:10.5px; padding:1px 7px; border-radius:8px;
                  background:var(--panel); border:1px solid var(--line); color:var(--muted); }
  .twocol { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:18px; }
  @media (max-width:760px){ .twocol{ grid-template-columns:minmax(0,1fr); } }
  .zpos { color:var(--up); font-weight:600; } .zneg { color:var(--down); font-weight:600; }
  .chip { display:inline-block; font-size:11px; padding:1px 7px; margin:0 4px 4px 0; border-radius:8px;
          background:var(--panel2); border:1px solid var(--line); color:var(--muted); }
  /* validation chip — status colours (--ok/--act/--muted) do NOT flip in zh mode, unlike --up/--down */
  .val-chip { display:inline-block; font-size:9.5px; font-weight:700; letter-spacing:.03em;
              padding:1px 6px; margin-left:7px; border-radius:6px; vertical-align:middle; white-space:nowrap; }
  .val-chip.validated   { color:var(--ok);    border:1px solid color-mix(in srgb,var(--ok) 55%,transparent);
                          background:color-mix(in srgb,var(--ok) 12%,transparent); }
  .val-chip.negative-ic { color:var(--act);   border:1px solid color-mix(in srgb,var(--act) 55%,transparent);
                          background:color-mix(in srgb,var(--act) 14%,transparent); }
  .val-chip.fdr-fail    { color:var(--muted); border:1px solid var(--line); background:var(--panel2); }
  .ic-alert { margin:0 0 10px; padding:8px 11px; border-radius:7px; font-size:12px; line-height:1.5;
              border:1px solid color-mix(in srgb,var(--act) 45%,transparent);
              background:color-mix(in srgb,var(--act) 9%,var(--panel)); }
  .ic-alert b { color:var(--act); font-weight:700; }
  sub { font-size:.72em; }
  .bbar { display:inline-block; width:150px; max-width:42vw; height:11px; border-radius:6px;
          background:var(--panel2); position:relative; overflow:hidden; vertical-align:middle; }
  .bbar > i { position:absolute; left:0; top:0; bottom:0; border-radius:6px; }
  .spk { width:96px; height:26px; display:block; }
  .hm { border-collapse:collapse; font-size:11px; }
  .hm td, .hm th { border:1px solid var(--bg); padding:0; text-align:center; }
  .hm th { color:var(--muted); font-weight:500; padding:2px 4px; white-space:nowrap; }
  .hmc { width:30px; height:26px; text-align:center; color:var(--text); font-size:10px; }
  .quilt { border-collapse:collapse; font-size:10.5px; width:100%; }
  .quilt th { color:var(--muted); font-weight:500; padding:2px 4px; white-space:nowrap; font-size:10px; }
  .quilt td { padding:3px 5px; text-align:right; border:1px solid var(--bg); white-space:nowrap; }
  .quilt2 { border-collapse:separate; border-spacing:2px; font-size:10px; }
  .quilt2 th { color:var(--muted); font-weight:500; padding:1px 3px; text-align:center; font-size:9.5px; }
  .quilt2 td.qc { width:54px; height:30px; border-radius:4px; text-align:center; color:#0b1220; vertical-align:middle; }
  .quilt2 td.qc .qf { display:block; font-weight:600; font-size:9px; line-height:1.05; }
  .quilt2 td.qc .qv { display:block; font-size:9px; opacity:.85; font-variant-numeric:tabular-nums; }
  .quilt2 td.qc.hl { outline:2px solid var(--text); outline-offset:-2px; }
  .r20bars { display:grid; grid-template-columns:auto 1fr auto; gap:2px 8px; align-items:center; margin-top:4px; max-width:560px; }
  .r20lab { font-size:11.5px; color:var(--muted); white-space:nowrap; }
  .r20track { height:12px; border-radius:6px; background:var(--panel2); position:relative; }
  .r20track > i { position:absolute; top:0; bottom:0; }
  .r20track > i.mid { left:50%; width:1px; background:var(--muted); opacity:.5; }
  .r20val { font-size:11.5px; font-variant-numeric:tabular-nums; text-align:right; }
  .flip { display:inline-block; font-size:11px; padding:1px 7px; margin:0 4px 4px 0; border-radius:8px;
          background:var(--panel2); border:1px solid var(--line); }
  .seg { display:inline-flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  .seg button { border:0; border-radius:0; background:var(--panel); color:var(--text); cursor:pointer;
                font-size:12px; padding:4px 10px; }
  .seg button.on { background:var(--panel2); font-weight:600; }
  .scroll { overflow-x:auto; }
  table[data-leg="lo"] .v-ls, table[data-leg="ls"] .v-lo { display:none; }
  .chartbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between; margin:8px 0 2px; }
  .tabs { display:inline-flex; border:1px solid var(--line); border-radius:9px; overflow:hidden; }
  .tabs button { border:0; background:var(--panel); color:var(--muted); font-size:12px; padding:5px 11px; cursor:pointer; border-right:1px solid var(--line); }
  .tabs button:last-child { border-right:0; }
  .tabs button.on { background:var(--panel2); color:var(--text); font-weight:650; }
  .tabs .rangeN { width:72px; background:var(--panel); color:var(--text); border:0; border-left:1px solid var(--line); padding:5px 8px; font-size:12px; }
  #fchart { height:400px; width:100%; }
  .legend { display:flex; flex-wrap:wrap; gap:6px 14px; margin-top:10px; }
  .lchip { display:inline-flex; align-items:center; gap:6px; font-size:12px; cursor:pointer; }
  .lchip.off { opacity:.34; }
  .lchip .ldot { width:9px; height:9px; border-radius:50%; display:inline-block; }
  .lchip .lv { color:var(--muted); font-variant-numeric:tabular-nums; }
  #sector-monitor td.hzc { font-variant-numeric:tabular-nums; text-align:center; }
  #sector-monitor .zc { font-size:12.5px; font-weight:600; } #sector-monitor .rr { font-size:10px; opacity:.7; display:block; }
  /* NW status chips */
  .nw-chip { display:inline-block; font-size:10.5px; font-weight:600; padding:2px 8px; margin:0 4px 4px 0;
             border-radius:7px; border:1px solid var(--line); background:var(--panel2); color:var(--muted);
             white-space:nowrap; letter-spacing:.02em; }
  .nw-chip.live      { color:var(--ok);   border-color:color-mix(in srgb,var(--ok) 55%,transparent);
                       background:color-mix(in srgb,var(--ok) 10%,transparent); }
  .nw-chip.dormant   { color:var(--muted); }
  .nw-chip.shadow    { color:var(--act);  border-color:color-mix(in srgb,var(--act) 45%,transparent);
                       background:color-mix(in srgb,var(--act) 8%,transparent); }
  .nw-chip.accruing  { color:var(--act);  border-color:color-mix(in srgb,var(--act) 45%,transparent);
                       background:color-mix(in srgb,var(--act) 8%,transparent); }
  .nw-chip.bh-withheld { color:var(--down); border-color:color-mix(in srgb,var(--down) 50%,transparent);
                          background:color-mix(in srgb,var(--down) 8%,transparent); }
  .nw-chip.null      { color:var(--muted); }
  .nw-chip.gate-passed { color:var(--ok);  border-color:color-mix(in srgb,var(--ok) 55%,transparent);
                          background:color-mix(in srgb,var(--ok) 10%,transparent); }
  .nw-chip.pre-fdr   { color:var(--muted); font-style:italic; }
  .nw-status-grid { display:grid; grid-template-columns:minmax(130px,auto) 1fr; gap:4px 12px;
                    font-size:12.5px; align-items:start; margin-top:10px; }
  .nw-status-grid .nw-lab { color:var(--muted); padding-top:2px; }
  .nw-influence { display:flex; flex-wrap:wrap; gap:4px 0; margin-top:4px; }
  .nw-influence .nw-chip { margin-bottom:0; }
</style>
<script src="lightweight-charts.js"></script>
</head>
<body>

<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

  <div class="panel">
    <div class="topline">
      <h1>🧮 {{ t('Factors & seasonality', '因子与季节性') }}{{ help(
        "The cross-sectional factors quant equity desks actually trade — computed from SEC EDGAR fundamentals joined to prices, not proxied by an ETF. Each factor is a winsorized cross-sectional z-score (higher = more attractive on that factor); the composite is their equal-weight blend. These are RANKS and context, not a backtested alpha: factors decay and crowd, free fundamentals are sparse for some tags, book/price is weak for intangible-heavy firms, and every value is lagged to the filing period (no look-ahead).",
        "量化股票交易台真正使用的横截面因子 — 由 SEC EDGAR 基本面与价格计算，而非用 ETF 代理。每个因子为去极值后的横截面 z 分数（越高 = 在该因子上越有吸引力）；综合为等权混合。这些是排名与背景，而非回测出的超额收益：因子会衰减与拥挤，免费基本面在部分科目上稀疏，市净率对无形资产密集的公司较弱，且所有数值滞后至申报期（无前视）。"
      ) }}</h1>
      <span class="muted sm">{{ t('Which styles of stock are working — and what this month usually brings', '哪些风格正在起作用——以及本月的历史规律') }}</span>
    </div>
    <p class="muted sm" style="margin:10px 0 0">{{ t(
      'Styles — cheap, high-quality, dividend-paying, recent winners — take turns leading. Ranks and history here are descriptions, not buy lists.',
      '低估值、高质量、高分红、近期赢家等风格轮流领跑。此处的排名与历史是描述，不是买入清单。') }}</p>
  </div>

  <!-- Factor weather hero — fail-open: seas absent or seas.now absent → panel hides -->
  {% if seas is not none and seas %}
  <div class="panel">
    <div class="topline" style="margin-bottom:8px">
      <h2 style="margin:0">{{ t('Factor weather', '因子风向') }}</h2>
      {% if seas.as_of %}<span class="muted sm">{{ seas.as_of }}</span>{% endif %}
    </div>
    {% if seas.now is not none and seas.now %}
    {% set _now = seas.now %}
    <p style="margin:0 0 8px;font-size:14px">
      <span class="l-en">{{ _now.headline_en or '' }}</span><span class="l-zh">{{ _now.headline_zh or '' }}</span>
    </p>
    {% if _now.stance_en %}
    <div style="margin-bottom:8px">
      {% if _now.chip_en %}
        {# Non-neutral: chip has color based on verdicts present #}
        {% set _any_hw = _now.factors | selectattr('verdict','eq','headwind') | list | length > 0 %}
        {% set _any_tw = _now.factors | selectattr('verdict','eq','tailwind') | list | length > 0 %}
        {% if _any_hw %}
          <span style="display:inline-block;padding:2px 10px;border-radius:8px;border:1px solid var(--act);color:var(--act);background:color-mix(in srgb,var(--act) 10%,var(--panel));font-size:12px;font-weight:600">
            <span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span>
          </span>
        {% elif _any_tw %}
          <span style="display:inline-block;padding:2px 10px;border-radius:8px;border:1px solid var(--ok);color:var(--ok);background:color-mix(in srgb,var(--ok) 10%,var(--panel));font-size:12px;font-weight:600">
            <span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span>
          </span>
        {% else %}
          <span class="chip"><span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span></span>
        {% endif %}
      {% else %}
        <span class="chip"><span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span></span>
      {% endif %}
    </div>
    {% endif %}
    {% if momo is not none and momo.get('top_decile') %}
    {% set _td = momo.top_decile %}
    <p class="sm" style="margin:0 0 4px">
      <span class="l-en">The hottest 10% of stocks right now: {{ _td.top_sector_share_pct }}% sit in {{ _td.top_sector }}.</span>
      <span class="l-zh">当前最热的10%个股中，{{ _td.top_sector_share_pct }}% 集中在{{ _td.top_sector }}。</span>
    </p>
    {% if momo.get('pulse') and momo.pulse.get('mtum_spy_20d_pct') is not none %}
    {% set _p20 = momo.pulse.mtum_spy_20d_pct %}
    <p class="sm muted" style="margin:0 0 4px">
      <span class="l-en">Hot stocks vs the market, last 20 days: {{ '%+.1f'|format(_p20) }}%.</span>
      <span class="l-zh">热门股相对大盘（近20日）：{{ '%+.1f'|format(_p20) }}%。</span>
    </p>
    {% endif %}
    {% endif %}
    {{ help(
      "Current-month per-factor seasonal stats — "
      ~ (_now.factors | map(attribute='plain_en') | join(', '))
      ~ ". Stats from Ken French total-US-market academic portfolios (1926+). "
      "Definition mismatch: French HML/RMW/CMA are value-weighted long/short over the whole US market, NOT our S&P-1500 winsorized z-scores — this is the style's long-run seasonal CLIMATE, not a forecast of our daily factor leadership. Kept out of every score.",
      "当月各因子季节性统计——来自 Ken French 全美市场学术组合（1926年+）。定义差异：French 的多空因子与我们的 S&P 1500 z 分数不同——此为长期季节性气候，非每日因子领先预测，且绝不进入任何评分。"
    ) }}
    {% endif %}
    <p class="muted sm" style="margin:8px 0 0">{{ t(
      'Long-run tendencies and descriptions — not forecasts, and kept out of every score.',
      '长期倾向与描述——不是预测，也不进入任何评分。') }}</p>
  </div>
  {% endif %}

  <!-- Factor calendar — fail-open: seas absent → panel hides -->
  {% if seas is not none and seas and seas.factors %}
  {% set _cal_months_en = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
  {% set _cal_months_zh = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'] %}
  {% set _cur_month = (seas.now.month if seas.now is not none and seas.now else none) %}
  <div class="panel">
    <div class="topline" style="margin-bottom:8px;flex-wrap:wrap;gap:8px">
      <h2 style="margin:0">{{ t('Factor calendar — what each month usually brings', '因子月历——每个月的历史规律') }}</h2>
      <span class="seg" id="cal-seg">
        <button data-win="t10" class="on">{{ t('Past 10 years', '近10年') }}</button>
        <button data-win="t30">{{ t('Past 30 years', '近30年') }}</button>
        <button data-win="full">{{ t('Full history', '完整历史') }}</button>
      </span>
    </div>
    <div class="scroll">
    <table class="hm" style="width:auto;min-width:600px">
      <tr>
        <th style="text-align:left;min-width:140px">{{ t('Style','风格') }}</th>
        {% for mi in range(1,13) %}
        <th style="{{ 'outline:2px solid var(--text);outline-offset:-1px;' if _cur_month == mi else '' }}">
          <span class="l-en">{{ _cal_months_en[mi-1] }}</span><span class="l-zh">{{ _cal_months_zh[mi-1] }}</span>
        </th>
        {% endfor %}
      </tr>
      {% for f in seas.factors if f.key != 'market' %}
      <tr>
        <td style="text-align:left;white-space:nowrap;font-size:11.5px">
          <span class="l-en">{{ f.plain_en }}</span><span class="l-zh">{{ f.plain_zh }}</span>
        </td>
        {% for mi in range(1,13) %}
        {% set _t10 = f.trailing_10y.get(mi|string) or f.trailing_10y.get(mi) %}
        {% set _t30 = f.trailing_30y.get(mi|string) or f.trailing_30y.get(mi) %}
        {% set _full = f.full.get(mi|string) or f.full.get(mi) %}
        {# Intensity: cap |mean| at 2 for opacity scaling #}
        {% set _t10m = _t10.mean if _t10 else none %}
        {% set _t30m = _t30.mean if _t30 else none %}
        {% set _fullm = _full.mean if _full else none %}
        {# Render cell: full window as default display value; JS swaps based on window toggle #}
        {# We render the cell once (full window default) and use JS to swap the displayed value #}
        {% if _fullm is not none %}
        {% set _dm = _fullm %}{% set _dh = _full.hit if _full else none %}{% set _dn = _full.n if _full else none %}
        {% elif _t30m is not none %}
        {% set _dm = _t30m %}{% set _dh = _t30.hit if _t30 else none %}{% set _dn = _t30.n if _t30 else none %}
        {% elif _t10m is not none %}
        {% set _dm = _t10m %}{% set _dh = _t10.hit if _t10 else none %}{% set _dn = _t10.n if _t10 else none %}
        {% else %}
        {% set _dm = none %}{% set _dh = none %}{% set _dn = none %}
        {% endif %}
        {% set _intensity = [_dm|abs / 2.0, 1.0]|min if _dm is not none else 0 %}
        {% if _dm is not none %}
        <td class="hmc cal-cell"
            style="background:{{ ('rgba(56,139,253,' ~ (_intensity*0.85)|round(2) ~ ')') if _dm >= 0 else ('rgba(248,81,73,' ~ (_intensity*0.85)|round(2) ~ ')') }};{{ 'outline:2px solid var(--text);outline-offset:-2px;' if _cur_month == mi else '' }}"
            data-t10m="{{ '%.2f'|format(_t10m) if _t10m is not none else '' }}"
            data-t30m="{{ '%.2f'|format(_t30m) if _t30m is not none else '' }}"
            data-fullm="{{ '%.2f'|format(_fullm) if _fullm is not none else '' }}"
            data-t10h="{{ _t10.hit if _t10 else '' }}"
            data-t30h="{{ _t30.hit if _t30 else '' }}"
            data-fullh="{{ _full.hit if _full else '' }}"
            data-t10n="{{ _t10.n if _t10 else '' }}"
            data-t30n="{{ _t30.n if _t30 else '' }}"
            data-fulln="{{ _full.n if _full else '' }}"
            title="mean {{ '%.2f'|format(_dm) }}% · up {{ _dh }}% of years · {{ _dn }} obs"
            >{{ '%.1f'|format(_dm) }}</td>
        {% else %}
        <td class="hmc cal-cell"
            data-t10m="" data-t30m="" data-fullm=""
            style="{{ 'outline:2px solid var(--text);outline-offset:-2px;' if _cur_month == mi else '' }}"
            title="—"
            >—</td>
        {% endif %}
        {% endfor %}
      </tr>
      {% endfor %}
    </table>
    </div>
    <p class="muted sm" style="margin:8px 0 4px">
      {{ t(
        'Academic long/short style portfolios (Ken French, 1926+) — a climate read, not our live rankings, and never scored.',
        '学术多空风格组合（Ken French，1926年起）——气候参考，非实时排名，绝不计分。') }}
      <a href="seasonality.html" style="color:var(--muted)">{{ t('Full 100-year deep dive →', '完整百年数据 →') }}</a>
    </p>
  </div>
  <script>
  (function(){
    var seg = document.getElementById('cal-seg');
    if (!seg) return;
    var cells = document.querySelectorAll('.cal-cell[data-t10m]');
    function applyWin(win) {
      cells.forEach(function(td) {
        var m = td.getAttribute('data-' + win + 'm');
        var h = td.getAttribute('data-' + win + 'h');
        var n = td.getAttribute('data-' + win + 'n');
        var v = parseFloat(m);
        if (isNaN(v)) {
          td.textContent = '—';
          td.style.background = '';
          td.title = '—';
        } else {
          td.textContent = v.toFixed(1);
          var intensity = Math.min(Math.abs(v) / 2.0, 1.0) * 0.85;
          td.style.background = v >= 0
            ? 'rgba(56,139,253,' + intensity.toFixed(2) + ')'
            : 'rgba(248,81,73,' + intensity.toFixed(2) + ')';
          td.title = 'mean ' + v.toFixed(2) + '% · up ' + (h || '?') + '% of years · ' + (n || '?') + ' obs';
        }
      });
    }
    // Default: t10
    applyWin('t10');
    seg.addEventListener('click', function(e) {
      var b = e.target.closest('button[data-win]');
      if (!b) return;
      seg.querySelectorAll('button').forEach(function(x) { x.classList.toggle('on', x === b); });
      applyWin(b.dataset.win);
    });
  })();
  </script>
  {% endif %}

  <!-- NW panel variables (set early so they're available when we render at bottom) -->
  {% set _nws = nw_state %}
  {% set _nw_avail = (_nws is defined and _nws is not none) %}
  {% set _nw_panel = _nw_avail and (_nws.get('panel') is not none) %}
  {% set _nw_n_dates = (_nws.get('panel') or {}).get('n_dates') if _nw_avail else none %}
  {% set _nw_latest = (_nws.get('panel') or {}).get('latest_date') if _nw_avail else none %}
  {% set _nw_floor = (_nws.get('panel') or {}).get('history_floor_met', false) if _nw_avail else false %}
  {% set _nw_fw = (_nws.get('factor_weather') or {}) if _nw_avail else {} %}
  {% set _nw_contr = ((_nws.get('contradictions') or {}).get('pair_g') or {}) if _nw_avail else {} %}
  {% set _nw_att = (_nws.get('attention') or {}).get('factor_attention', {}) if _nw_avail else {} %}
  {% set _nw_hyp = (_nws.get('hypotheses') or {}) if _nw_avail else {} %}
  {% set _nw_as_of = _nws.get('as_of') if _nw_avail else none %}

  <!-- Factor leadership -->
  {% if fac.leadership %}
  <div class="panel">
    <h2>{{ t('What is working now', '当前哪种因子在起作用') }}
      {{ help("For each factor, the trailing-63-day return of its top quintile MINUS its bottom quintile. Positive = that factor has been rewarded recently (descriptive, not a forecast). Compare against the regime above: e.g. value & low-vol leading often accompanies risk-off / late-cycle.", "每个因子最近 63 个交易日内：顶部五分位减底部五分位的回报。正值=该因子近期获得回报（描述性，非预测）。") }}
    </h2>
    <p class="muted sm" style="margin:0 0 10px">{{ t(
      'What the market has rewarded over the past 3 months. Descriptive — leadership rotates.',
      '过去3个月市场奖励的风格。仅为描述——领先风格会轮换。') }}</p>
    <div class="lead">
      {% set maxsp = (fac.leadership | map(attribute='spread_pct') | map('abs') | max) or 1 %}
      {% for L in fac.leadership %}
      <div class="leadrow">
        <span>{{ td(L.label) }}</span>
        <span class="leadbar">
          {% if L.spread_pct >= 0 %}<i style="left:50%;width:{{ (L.spread_pct/maxsp*50)|round(1) }}%;background:var(--up)"></i>
          {% else %}<i style="right:50%;width:{{ (-L.spread_pct/maxsp*50)|round(1) }}%;background:var(--down)"></i>{% endif %}
          <i style="left:50%;width:1px;background:var(--muted);opacity:.5"></i>
        </span>
        <span class="{{ 'zpos' if L.spread_pct>=0 else 'zneg' }}" style="text-align:right">{{ '%+.1f'|format(L.spread_pct) }}%</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- Where the heat is — momentum concentration (momo.top_decile; fail-open) -->
  {% if momo is not none and momo.get('top_decile') %}
  {% set _mtd = momo.top_decile %}
  {% set _mmax = (_mtd.sectors | map(attribute='share_pct') | max) if _mtd.sectors else 1 %}
  <div class="panel">
    <h2>{{ t('Where the heat is', '热度集中在哪') }}</h2>
    <div class="lead" style="margin-bottom:8px">
      {% for sec in _mtd.sectors %}
      <div class="leadrow">
        <span class="sm">{{ sec.sector }}</span>
        <span class="leadbar">
          <i style="left:0;width:{{ (sec.share_pct / _mmax * 100)|round(1) }}%;background:var(--up)"></i>
        </span>
        <span class="sm" style="text-align:right">{{ sec.share_pct }}%</span>
      </div>
      {% endfor %}
    </div>
    {% if _mtd.sample %}
    <div style="margin-bottom:8px">
      {% for tk in _mtd.sample %}
      <span class="chip">{{ tk }}</span>
      {% endfor %}
    </div>
    {% endif %}
    <p class="sm" style="margin:0 0 6px">{{ t(
      'When the hottest stocks crowd into one sector, a stumble there hits them all together.',
      '当最热个股集中于单一板块时，该板块受挫会同时波及所有热门股。') }}</p>
    <p class="muted sm" style="margin:0">
      <span class="l-en">{{ momo.disclosure_en }}</span>
      <span class="l-zh">{{ momo.disclosure_zh }}</span>
    </p>
  </div>
  {% endif %}

  <!-- Does the rank actually predict? — leak-free point-in-time IC scorecard -->
  {% if ic and ic.rows %}
  <div class="panel">
    <h2>{{ t('Do these rankings actually predict? — the honest test', '这些排名真的能预测吗？— 诚实检验') }}
      {{ help("The honest test most factor dashboards never show. At each quarter-end we rebuild every factor AS IT WAS KNOWABLE THEN — no look-ahead into a not-yet-filed 10-K (fundamentals are point-in-time) — then rank-correlate the factor score with the NEXT " ~ ic.horizon_d ~ "-day return: the Information Coefficient (IC). mean IC = average predictive edge; 0 = none. IC-IR (annualized) = IC ÷ its own volatility; t_HAC = Newey-West t-stat (overlapping forward windows autocorrelate the IC series); q_FDR = Benjamini-Hochberg false-discovery rate across every factor screened. One caveat the deep panel can't escape: prices cover only the currently-listed (delisted names are absent), so the deep read is survivorship-biased — an OPTIMISTIC bound. Judge each number against ZERO.",
                "大多数因子面板从不展示的诚实检验。在每个季末，我们按当时可知的信息重建每个因子（无前视、基本面为时点数据），再将因子分数与未来 " ~ ic.horizon_d ~ " 日回报做秩相关，得到信息系数 IC。平均 IC = 平均预测优势；0 = 无优势。IC-IR（年化）= IC ÷ 自身波动；t_HAC = Newey-West t 值（重叠窗口使 IC 序列自相关）；q_FDR = 跨全部因子的多重检验错误发现率。深度面板的一个无法回避的代价：价格仅覆盖现存名（已退市名缺失），故深度读数含幸存者偏差 — 为乐观上界。每个数字都应与零比较。") }}
    </h2>
    {% if not ic.any_survive %}
    <div class="ic-alert">
      {{ t(
        'Straight talk: none of these rankings has proven it predicts future returns on our honest test. Read them as descriptions — what is cheap, what is high quality — not as buy lists.',
        '直说：在我们的诚实检验中，这些排名均未证明能预测未来回报。请将其视为描述——哪些便宜、哪些优质——而非买入清单。') }}
    </div>
    {% else %}
    {% set _survivors = ic.rows | selectattr('survives_fdr') | selectattr('mean_ic') | selectattr('mean_ic', 'gt', 0) | map(attribute='label_en') | list %}
    <div class="ic-alert" style="border-color:var(--line);background:var(--panel2)">
      {{ t(
        'Straight talk: of everything on this page, only ' ~ (_survivors | join(', ') if _survivors else 'one ranking') ~ ' clears our honest prediction test — and only barely, on data tilted in its favour. Treat the rest as descriptions — what is cheap, what is high quality — not as buy lists.',
        '直说：本页所有排名中，仅「' ~ (_survivors | join('、') if _survivors else '个别因子') ~ '」勉强通过我们的诚实预测检验——且数据本身对其有利。其余请视为描述——哪些便宜、哪些优质——而非买入清单。') }}
    </div>
    {% endif %}
    <p class="muted sm" style="margin:0 0 10px">
      {{ t('Deep 2011-2026 test · survivor-tilted data, so treat results as an optimistic upper bound.',
           '2011-2026 深度检验 · 数据含幸存者偏差，结果应视为乐观上界。') }}
      {{ help(
        (('Span ' ~ ic.span ~ ' · ' ~ ic.rebalances ~ ' quarterly rebalances · ~' ~ ic.median_universe ~ ' names — a DEEP 2011-2026 re-test on a backfilled close panel, not the ~3y rolling cache. The catch: that panel is SURVIVORSHIP-BIASED (delisted names absent — free prices only cover the currently-listed), so it is an OPTIMISTIC bound; a lone, marginal survivor is shown, not a green light. SUE — the strongest factor on the shallow 2023-2025 window — collapses to IC≈0 here. FINRA short-interest is dropped (no point-in-time history) and fundamentals refresh only ~annually, so fundamental factors still have few independent draws.') if ic.survivorship_biased else ('Span ' ~ ic.span ~ ' · ' ~ ic.rebalances ~ ' quarterly rebalances · ~' ~ ic.median_universe ~ ' names. ~3 years of price history caps the sample at n≈' ~ ic.rebalances ~ ', so t-stats and FDR are low-power. Read it as honest context, not a green light — and note fundamentals refresh only ~annually, so the fundamental factors have even fewer independent draws.')),
        (('区间 ' ~ ic.span ~ ' · ' ~ ic.rebalances ~ ' 次季度再平衡 · 约 ' ~ ic.median_universe ~ ' 只 — 2011-2026 深度复检。含幸存者偏差：已退市名缺失，为乐观上界；仅展示个别勉强通过者，而非买入信号。') if ic.survivorship_biased else ('区间 ' ~ ic.span ~ ' · ' ~ ic.rebalances ~ ' 次季度再平衡 · 约 ' ~ ic.median_universe ~ ' 只。约 3 年价格历史使样本仅 n≈' ~ ic.rebalances ~ '，t 统计与 FDR 检验力较低。'))
      ) }}
    </p>
    {% set _comp = ic.factors.get('composite') if ic.factors else none %}
    {% if _comp and _comp.get('mean_ic') is not none and _comp.mean_ic < 0 %}
    <div class="ic-alert">
      <b>⚠ {{ t('The equal-weight composite has NEGATIVE predictive IC.', '等权综合因子的预测 IC 为负。') }}</b>
      {{ t('Its blended mean IC is ' ~ ('%+.4f'|format(_comp.mean_ic)) ~ ' over ' ~ ic.rebalances ~ ' quarters — the naive all-factor blend INVERTS the cross-section on this panel, so it is worse than useless as a stock screen. Do NOT trade the composite. Judge each factor on its own row below: only a factor tagged VALIDATED (survives BH-FDR AND positive mean IC) has earned it, and even that is a marginal survivor on a survivorship-biased panel.',
           '其混合平均 IC 为 ' ~ ('%+.4f'|format(_comp.mean_ic)) ~ '（' ~ ic.rebalances ~ ' 个季度）— 朴素的全因子等权混合在此面板上反转了横截面，作为选股信号还不如不用。切勿交易该综合因子。请按下方每个因子各自的行判断：仅标记为 VALIDATED（通过 BH-FDR 且平均 IC 为正）的因子才成立，且即便如此也只是幸存者偏差面板上的勉强通过者。') }}
    </div>
    {% endif %}
    <table>
      <tr>
        <th>{{ t('factor','因子') }}</th>
        <th class="r">{{ t('mean IC','平均 IC') }}{{ help('average predictive edge; 0 = none', '平均预测优势；0 = 无优势') }}</th>
        <th class="r">{{ t('IC-IR (ann)','IC-IR（年化）') }}{{ help('IC ÷ its own volatility, annualized — how consistent the edge is', 'IC ÷ 自身波动（年化）——优势的一致性') }}</th>
        <th class="r">t<sub>HAC</sub>{{ help('Newey-West t-stat: accounts for overlapping return windows', 'Newey-West t 值：修正重叠窗口的自相关') }}</th>
        <th class="r">{{ t('hit','命中率') }}{{ help('fraction of quarters the IC was positive', 'IC 为正的季度占比') }}</th>
        <th class="r">q<sub>FDR</sub>{{ help('Benjamini-Hochberg false-discovery rate across all factors screened', 'BH 错误发现率（跨全部因子）') }}</th>
        <th class="r">n{{ help('number of quarterly rebalances', '季度再平衡次数') }}</th>
      </tr>
      {% for r in ic.rows %}
      {% set _vs = 'validated' if (r.survives_fdr and r.mean_ic is not none and r.mean_ic > 0) else ('negative-ic' if (r.mean_ic is not none and r.mean_ic < 0) else 'fdr-fail') %}
      <tr>
        <td>{{ t(r.label_en, fac.factor_labels.get(r.factor, r.label_en)) }}<span class="val-chip {{ _vs }}">{% if _vs == 'validated' %}{{ t('VALIDATED','已验证') }}{% elif _vs == 'negative-ic' %}{{ t('NEG-IC','反向') }}{% else %}{{ t('FDR-FAIL','未过检') }}{% endif %}</span></td>
        <td class="r {{ 'pos' if r.mean_ic and r.mean_ic > 0 else ('neg' if r.mean_ic and r.mean_ic < 0 else 'muted') }}">{{ '%+.4f'|format(r.mean_ic) if r.mean_ic is not none else '—' }}</td>
        <td class="r {{ 'pos' if r.ic_ir_ann and r.ic_ir_ann > 0 else ('neg' if r.ic_ir_ann and r.ic_ir_ann < 0 else 'muted') }}">{{ '%+.2f'|format(r.ic_ir_ann) if r.ic_ir_ann is not none else '—' }}</td>
        <td class="r muted">{{ '%+.2f'|format(r.t_hac) if r.t_hac is not none else '—' }}</td>
        <td class="r muted">{{ '%.0f%%'|format(r.hit * 100) if r.hit is not none else '—' }}</td>
        <td class="r muted">{{ '%.2f'|format(r.q_fdr) if r.q_fdr is not none else '—' }}</td>
        <td class="r muted">{{ r.n }}</td>
      </tr>
      {% endfor %}
    </table>
    {% if ic.collinearity and ic.collinearity.top_pairs %}
    <p class="muted sm" style="margin:10px 0 0">
      {{ t('Crowding / overlap','拥挤／重叠') }}{{ help("Factors that move together are redundant (a 'crowded' tilt). Mean absolute pairwise factor correlation, raw vs after Löwdin de-correlation; the composite (de-correlated) row above strips this overlap. VIF > 5 would flag a factor that is a linear combination of the others.", "彼此同向移动的因子是冗余的（拥挤的押注）。下为平均 |因子相关性|（原始 vs Löwdin 去相关后）；上方“综合（去相关）”行已剔除该重叠。VIF>5 表示某因子是其它因子的线性组合。") }}:
      {{ t('mean |corr| ' ~ ic.collinearity.mean_abs_corr_raw ~ ' raw → ' ~ ic.collinearity.mean_abs_corr_orth ~ ' de-correlated.',
           '平均 |相关性| ' ~ ic.collinearity.mean_abs_corr_raw ~ ' 原始 → ' ~ ic.collinearity.mean_abs_corr_orth ~ ' 去相关后。') }}
      {% for p in ic.collinearity.top_pairs %}<span class="chip">{{ p.a }} ↔ {{ p.b }} · {{ p.corr }}</span>{% endfor %}
    </p>
    {% endif %}
  </div>
  {% endif %}

  <!-- Market breadth (index-member participation, not factor breadth) -->
  {% if breadth and breadth.groups %}
  <div class="panel">
    <h2>{{ t('Market breadth', '市场广度') }}
      {{ help("Share of index members trading above their own 50-day AND 200-day moving averages, across the S&P 500 / 400 / 600 caps. This is MARKET-MEMBER participation (is the rally broad or narrow?), NOT factor-portfolio breadth. Above ~60% = broad; a small/large divergence flags where participation is rotating. Small & mid breadth history starts 2023-07 (the divergence is on that common window).", "指数成分中股价同时高于自身 50 日与 200 日均线的比例，覆盖标普 500／400／600。这是市场成分的参与度（涨势是广泛还是狭窄），并非因子组合广度。约 60% 以上=广泛；大小盘背离提示参与度在轮动。中小盘广度数据自 2023-07 起。") }}
    </h2>
    <table>
      <tr><th>{{ t('index', '指数') }}</th><th class="r">{{ t('% > 50d MA', '% 高于50日线') }}</th><th class="r">{{ t('% > 200d MA', '% 高于200日线') }}</th><th class="r">{{ t('members', '成分数') }}</th></tr>
      {% for g in breadth.groups %}
      <tr>
        <td>{{ t(g.label_en, g.label_zh) }}</td>
        <td class="r"><span class="bbar"><i style="width:{{ g.p50 }}%;background:{{ 'var(--up)' if g.p50>=50 else 'var(--down)' }}"></i></span> <b class="{{ 'pos' if g.p50>=50 else 'neg' }}">{{ g.p50 }}%</b></td>
        <td class="r"><span class="bbar"><i style="width:{{ g.p200 }}%;background:{{ 'var(--up)' if g.p200>=50 else 'var(--down)' }}"></i></span> <b class="{{ 'pos' if g.p200>=50 else 'neg' }}">{{ g.p200 }}%</b></td>
        <td class="r muted sm">{{ g.n }}</td>
      </tr>
      {% endfor %}
    </table>
    {% if breadth.div_small_large is not none %}
    <p class="muted sm" style="margin:8px 0 0">{{ t(
      'Small-cap vs large-cap breadth: ' ~ ('%+.1f'|format(breadth.div_small_large)) ~ 'pp (small minus large, % above 50d). Positive = small-caps participating MORE than mega-caps — a broadening tape; negative = leadership narrowing to the top.',
      '小盘相对大盘广度：' ~ ('%+.1f'|format(breadth.div_small_large)) ~ ' 个百分点（小盘减大盘，% 高于50日线）。正值=小盘参与度高于大盘（涨势扩散）；负值=领先向头部集中。') }}</p>
    {% endif %}
