  <!-- Interactive factor performance chart + GICS sector monitor (lightweight-charts) -->
  {% if series and series.chart_data %}
  <div class="panel" id="fchart-section">
    <h2>{{ t('Factor performance — interactive', '因子表现 — 交互图') }}
      {{ help("Rebased to 0% at the start of the selected window. Four relational views: factors LONG-ONLY (carry with the market), factors vs S&P 500, the Q5−Q1 PREMIUM (market-neutral), and cap-weighted GICS SECTORS vs S&P. Click legend entries to toggle series; pick a range. Powered by TradingView Lightweight Charts.", "在所选窗口起点重设为 0%。四种关系视图：因子纯多头、因子相对标普、Q5−Q1 溢价（市场中性）、以及市值加权 GICS 行业相对标普。点击图例切换；可选区间。") }}
    </h2>
    <div class="chartbar" style="margin-bottom:4px">
      <span class="tabs" id="fc-universe" role="group" aria-label="Universe"></span>
      <span class="muted" style="font-size:11.5px;flex:1;min-width:240px">{{ t(
        'Broad = S&P 1500 (large+mid+small); Narrow = S&P 500 large-cap. This switch re-ranks only the chart, table & sector monitor below — the IC scorecard, crowding, quilt and breadth panels stay on the broad universe.',
        '广义=标普 1500（大+中+小）；狭义=标普 500 大盘。此切换仅重排下方图表、表格与行业监测 — IC 记分卡、拥挤度、拼布与广度面板保持广义口径。') }}
        <span id="uni-note" style="display:none;color:var(--warn)"> · {{ t('S&P 500 price history starts 2025-03 (~1y) — curves are shorter and σ/z need ~1y+, so some cells show —.', '标普 500 价格历史自 2025-03（约 1 年）— 曲线更短，σ/z 需约 1 年以上，部分单元格显示 —。') }}</span>
      </span>
    </div>
    <div class="chartbar"><span class="tabs" id="fc-modes" role="group"></span><span class="tabs" id="fc-ranges" role="group"></span></div>
    <div id="fchart"></div>
    <div class="legend" id="fc-legend"></div>
  </div>

  <div class="panel" id="fperf-section">
    <h2>{{ t('Performance table', '表现一览') }}
      {{ help("Every factor across horizons, watchlist-style. SCOPE toggles factor long-only portfolios vs the Q5−Q1 premium; VALUE toggles raw return, return vs the S&P, and σ (the move z-scored vs that series' own trailing year — fixed horizons only). Click a column to sort.", "各因子横跨时间跨度的自选股式表格。SCOPE 切换纯多头与 Q5−Q1 溢价；VALUE 切换原始回报、相对标普、σ（相对自身过去一年的 z，仅限定窗）。点击列排序。") }}
    </h2>
    <div class="chartbar"><span class="tabs" id="fp-scope" role="group"></span><span class="tabs" id="fp-mode" role="group"></span></div>
    <div class="ts"><table id="fperf-table"></table></div>
  </div>

  <div class="panel" id="sector-section">
    <h2>{{ t('Sector monitor — cap-weighted GICS vs S&P', '行业监测 — 市值加权 GICS 相对标普') }}
      {{ help("Each cap-weighted GICS sector's return RELATIVE to the S&P over each horizon, colored by how unusual that move is vs the sector's own trailing-year distribution (z). Deep color + |z|≥2 = an outsized rotation. The small number is the relative return; the big number is the z.", "每个市值加权 GICS 行业相对标普的回报（各时间跨度），按该走势相对其自身过去一年分布的异常程度（z）着色。颜色越深、|z|≥2 = 异常轮动。小字为相对回报，大字为 z。") }}
    </h2>
    <div class="ts"><table id="sector-monitor"></table></div>
  </div>
  {% endif %}
  </div>
  <div class="fx-pane" data-pane="moves">
  {% if series and series.factors %}
  <!-- Recent factor moves (horizon z) + rotation -->
  <div class="panel">
    <div class="topline" style="margin-bottom:8px">
      <h2 style="margin:0">{{ t('Recent moves — z vs trailing year', '近期变动 — 相对过去一年的 z') }}
        {{ help("Each horizon's compounded return z-scored against that series' own trailing-252 distribution of overlapping returns (|z|≥2 = a notable move, marked ●). Green/red follows the sign of the move. Toggle the long-only portfolio vs the Q5−Q1 premium.", "各时间跨度的复利回报，相对该序列自身过去 252 日重叠回报分布做 z 标准化（|z|≥2 为显著，标 ●）。绿/红表示方向。可切换纯多头与多空溢价。") }}
      </h2>
      <span style="flex:1"></span>
      <span class="seg" id="legseg">
        <button data-leg="ls" class="on">Q5−Q1</button>
        <button data-leg="lo">{{ t('Long-only','纯多头') }}</button>
      </span>
    </div>
    <table id="hztab" data-leg="ls">
      <tr><th>{{ t('factor','因子') }}</th><th class="r">1d</th><th class="r">5d</th><th class="r">20d</th>
        <th>{{ t('20d leader','20日领先') }}</th></tr>
      {% for f in series.factors %}
      {% set hz = series.horizons[f] %}
      <tr>
        <td>{{ t(series.labels[f], series.labels[f]) }}</td>
        {% for k in ['d1','d5','d20'] %}
        <td class="r">
          {% for leg in ['lo','ls'] %}{% set c = hz[('long_only' if leg=='lo' else 'long_short')][k] %}<span class="v-{{ leg }} {{ 'zpos' if c.z and c.z>0 else ('zneg' if c.z and c.z<0 else 'muted') }}" title="z {{ c.z }} · pct {{ c.pct }}">{{ ('%+.1f'|format(c.ret_pct)) if c.ret_pct is not none else '—' }}{% if c.flag %} ●{% endif %}</span>{% endfor %}
        </td>
        {% endfor %}
        <td class="muted sm">{% if series.rotation.leader == f %}★ {{ t('current','当前') }}{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    {% if series.rotation and series.rotation.leader_label %}
    <div style="margin-top:10px">
      <p class="sm" style="margin:0 0 7px">{{ t('20-day leader:','20日领先因子：') }}
        <b>{{ series.rotation.leader_label }}</b> <span class="{{ 'pos' if series.rotation.leader_ret20_pct>=0 else 'neg' }}">({{ '%+.1f'|format(series.rotation.leader_ret20_pct) }}%)</span><span class="muted">{% if series.rotation.leader_held_days %} · {{ t('held','已领先') }} {{ series.rotation.leader_held_days }}{{ t('d','天') }}{% endif %}{% if series.rotation.previous_leader_label %} · {{ t('prev','前任') }} {{ series.rotation.previous_leader_label }}{% endif %}</span>
        {% for j in series.rotation.quartile_jumps %} <span class="flip" style="border-color:{{ 'var(--up)' if j.dir=='up' else 'var(--down)' }};color:{{ 'var(--up)' if j.dir=='up' else 'var(--down)' }}">{{ '↑' if j.dir=='up' else '↓' }} {{ j.label }} {{ t('quartile jump','分位跃迁') }} #{{ j.from }}→#{{ j.to }}</span>{% endfor %}
        {% if series.rotation.recent_flips %} · <span class="muted">{{ t('flips:','轮动：') }}</span> {% for fl in series.rotation.recent_flips %}<span class="flip">{{ fl.date }} → {{ fl.label }}</span>{% endfor %}{% endif %}
      </p>
      {% if series.rotation.r20 %}
      {% set rmax = (series.rotation.r20 | map(attribute='ret') | map('abs') | max) or 1 %}
      <div class="r20bars">
        {% for b in series.rotation.r20 %}
        <span class="r20lab">{{ series.labels.get(b.factor, b.label) }}</span>
        <span class="r20track">{% if b.ret >= 0 %}<i style="left:50%;width:{{ (b.ret/rmax*50)|round(1) }}%;background:var(--up)"></i>{% else %}<i style="right:50%;width:{{ (-b.ret/rmax*50)|round(1) }}%;background:var(--down)"></i>{% endif %}<i class="mid"></i></span>
        <span class="r20val {{ 'pos' if b.ret>=0 else 'neg' }}">{{ '%+.1f'|format(b.ret) }}%</span>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endif %}
  </div>
  <div class="fx-pane" data-pane="quilt">
  {% if series and series.factors %}
    {% if series.quilt and series.quilt.months %}
    {% set qpal = ['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635'] %}
    <div class="panel">
      <h2>{{ t('Quilt — Q5−Q1 monthly ranks', '拼布 — 多空月度排名') }}
        {{ help("The periodic-table-of-returns: each column ranks the factor Q5−Q1 premiums best→worst that month (and a YTD column), cells colored by factor IDENTITY so you can trace one factor's path — hover a cell to highlight it across every column. ~13 months on the free cache; descriptive, not a regime-robust signal.", "收益周期表：每列按当月多空溢价从优到劣排名（含 YTD 列），单元格按因子着色以便追踪某一因子 — 悬停某格可高亮其在各列的位置。免费缓存约13个月；描述性，非稳健信号。") }}
      </h2>
      <div class="scroll"><table class="quilt2">
        <tr>{% for m in series.quilt.months %}<th>{{ 'YTD' if m == 'YTD' else m[5:] }}</th>{% endfor %}</tr>
        {% set maxrows = series.quilt.ranked.values() | map('length') | max %}
        {% for i in range(maxrows) %}
        <tr>
          {% for m in series.quilt.months %}{% set col = series.quilt.ranked[m] %}{% if i < (col|length) %}{% set f = col[i] %}{% set v = series.quilt.returns[f].get(m) %}<td class="qc" data-f="{{ f }}" style="background:{{ qpal[series.factors.index(f) % (qpal|length)] }}" title="{{ series.labels[f] }} · {{ 'YTD' if m=='YTD' else m }}: {{ '%+.1f'|format(v) }}%"><span class="qf">{{ series.labels[f][:9] }}</span><span class="qv">{{ '%+.0f'|format(v) }}%</span></td>{% else %}<td></td>{% endif %}{% endfor %}
        </tr>
        {% endfor %}
      </table></div>
    </div>
    {% endif %}
  {% endif %}
  </div>
  <script>
    (function(){ var q=document.querySelector('.quilt2'); if(!q) return;
      q.addEventListener('mouseover',function(e){var c=e.target.closest('.qc[data-f]'); if(!c) return; var f=c.dataset.f; q.querySelectorAll('.qc[data-f="'+f+'"]').forEach(function(x){x.classList.add('hl');});});
      q.addEventListener('mouseout',function(){ q.querySelectorAll('.qc.hl').forEach(function(x){x.classList.remove('hl');});});
    })();
  </script>
  <script>
    (function(){
      var seg=document.getElementById('legseg'), tab=document.getElementById('hztab');
      if(seg&&tab) seg.addEventListener('click', function(e){
        var b=e.target.closest('button[data-leg]'); if(!b) return;
        tab.setAttribute('data-leg', b.dataset.leg);
        seg.querySelectorAll('button').forEach(function(x){x.classList.toggle('on', x===b);});
      });
    })();
  </script>
  </section>

  <section class="fx-sec" id="sec-names">
    <div class="sec-h"><span class="sec-n">05</span><h2>{{ t('Names', '个股') }}</h2></div>
    <p class="sec-sub">{{ t('Which stocks actually sit at the top of each ranking.', '哪些个股真正位于各项排名的前列。') }}</p>
  <!-- Per-factor leaderboards (Factor leaders section) -->
  <div class="panel">
    <h2>{{ t('Factor leaders', '各因子领先股') }}</h2>
    {# Cross-ranking ticker lookup: the leaderboards answer "who leads Value?",
       this answers the inverse — "what does NVDA lead?" — without a round trip. #}
    <div class="fx-find">
      <span class="box"><span class="mag">🔎</span>
        <input id="fx-tq" autocomplete="off" aria-label="Find a ticker across every factor"
               placeholder="{{ t('Find a ticker across every ranking…','在所有排名中查找个股…') }}"></span>
      <span class="note" id="fx-tnote"></span>
    </div>
    <div class="cardgrid">
      {% for f in fac.factors + ['sue','low_beta','accruals','short_interest'] %}
      {% if fac.leaders.get(f) %}
      <div class="fcard">
        <h3><span class="fx-open" data-fx="{{ f }}">{{ td(fac.factor_labels.get(f, f)) }}</span>
          {% set h = FHELP.get(f) %}{% if h %}{{ help(h[0], h[1]) }}{% endif %}
          <span class="badge">{{ t('top', '前') }} {{ fac.leaders[f]|length }}</span></h3>
        <table>
          {% for x in fac.leaders[f][:10] %}
          <tr><td><a href="stock.html#{{ x.ticker }}"><b>{{ x.ticker }}</b></a></td>
            <td class="muted sm">{{ x.name[:18] }}</td>
            <td class="r zpos">{{ '%+.2f'|format(x.z) }}</td></tr>
          {% endfor %}
        </table>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  <!-- Composite leaders / laggards -->
  <div class="panel">
    <h2>{{ t('Multi-factor composite', '多因子综合') }}
      {{ help("The RANKING here uses only the factor legs that carry a POSITIVE measured information coefficient on the deep-history (leak-free) scorecard, IC-weighted with a sign constraint — negative-IC / FDR-failing legs (e.g. low-vol, investment) are EXCLUDED from the order because they rank names in an anti-predictive direction (the blind equal-weight composite's own scorecard grades it ic_ir -0.049). The per-leg leaderboards below still show every leg, badged with its IC/FDR verdict. Validate-before-weight: the order a trader sizes off cannot be moved by a leg the scorecard rejects.", "此处排序仅采用在深度历史（无泄漏）评分卡上信息系数为正的因子腿，按 IC 加权并施加符号约束——负 IC／未通过 FDR 的腿（如低波动、投资）被排除，因为它们会使排序反向。下方各腿榜单仍展示全部腿并标注其 IC/FDR 结论。") }}
      {% if fac.rank_legs %}<span class="muted sm">· {{ t('ranked by','排序依据') }}: {% for l in fac.rank_legs %}{{ fac.factor_labels.get(l, l) }}{% if not loop.last %} · {% endif %}{% endfor %}{% if fac.composite_passport and fac.composite_passport.excluded_legs %} · {{ t('excluded (negative IC)','已排除（负IC）') }}: {% for l in fac.composite_passport.excluded_legs %}{{ fac.factor_labels.get(l, l) }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</span>{% endif %}
    </h2>
    <div class="twocol">
      <div>
        <h3 class="sm pos" style="margin:0 0 6px">{{ t('Top composite', '综合最高') }}</h3>
        <table>
          <tr><th>{{ t('stock','个股') }}</th><th>{{ t('sector','板块') }}</th><th class="r">z</th><th class="r">{{ t('mkt cap','市值') }}</th></tr>
          {% for x in fac.composite_top %}
          <tr><td><a href="stock.html#{{ x.ticker }}"><b>{{ x.ticker }}</b></a> <span class="muted sm">{{ x.name[:22] }}</span></td>
            <td class="muted sm">{{ td(x.sector) }}</td><td class="r zpos">{{ '%+.2f'|format(x.z) }}</td>
            <td class="r muted sm">{{ ('$%.0fB'|format(x.mktcap_bn)) if x.mktcap_bn else '—' }}</td></tr>
          {% endfor %}
        </table>
      </div>
      <div>
        <h3 class="sm neg" style="margin:0 0 6px">{{ t('Bottom composite', '综合最低') }}</h3>
        <table>
          <tr><th>{{ t('stock','个股') }}</th><th>{{ t('sector','板块') }}</th><th class="r">z</th><th class="r">{{ t('mkt cap','市值') }}</th></tr>
          {% for x in fac.composite_bottom %}
          <tr><td><a href="stock.html#{{ x.ticker }}"><b>{{ x.ticker }}</b></a> <span class="muted sm">{{ x.name[:22] }}</span></td>
            <td class="muted sm">{{ td(x.sector) }}</td><td class="r zneg">{{ '%+.2f'|format(x.z) }}</td>
            <td class="r muted sm">{{ ('$%.0fB'|format(x.mktcap_bn)) if x.mktcap_bn else '—' }}</td></tr>
          {% endfor %}
        </table>
      </div>
    </div>
  </div>
  <!-- Insider conviction (SEC Form-4) -->
  {% if fac.insider %}
  <div class="panel">
    <h2>{{ t('Insider conviction', '内部人信念') }} <span class="muted sm">{{ t('SEC Form-4 ·', 'SEC Form-4 ·') }} {{ fac.insider.quarter }}</span>
      {{ help("Net OPEN-MARKET insider buying minus selling per company from SEC Form-4 filings (purchases code P, sales code S; grants and option exercises excluded). The SEC ships these as a quarterly bulk dataset, so this is the most recent COMPLETED quarter — a slow conviction read, not real-time. Clustered open-market BUYING is the more informative side (insiders buy for one reason; they sell for many).", "来自 SEC Form-4 的每家公司净公开市场内部人买入减卖出（买入代码 P、卖出 S；排除授予与期权行权）。SEC 按季度发布，故为最近一个完整季度 — 慢速信念信号，非实时。") }}
    </h2>
    <div class="twocol">
      <div>
        <h3 class="sm pos" style="margin:0 0 6px">{{ t('Biggest net BUYING', '最大净买入') }}</h3>
        <table>
          <tr><th>{{ t('stock','个股') }}</th><th>{{ t('sector','板块') }}</th><th class="r">{{ t('net $','净额') }}</th><th class="r">B/S</th></tr>
          {% for x in fac.insider.top_buying %}
          <tr><td><a href="stock.html#{{ x.ticker }}"><b>{{ x.ticker }}</b></a> <span class="muted sm">{{ x.name[:20] }}</span></td>
            <td class="muted sm">{{ td(x.sector) }}</td><td class="r zpos">+${{ '%.1f'|format(x.net_usd_mn) }}M</td>
            <td class="r muted sm">{{ x.buys }}/{{ x.sells }}</td></tr>
          {% endfor %}
        </table>
      </div>
      <div>
        <h3 class="sm neg" style="margin:0 0 6px">{{ t('Biggest net SELLING', '最大净卖出') }}</h3>
        <table>
          <tr><th>{{ t('stock','个股') }}</th><th>{{ t('sector','板块') }}</th><th class="r">{{ t('net $','净额') }}</th><th class="r">B/S</th></tr>
          {% for x in fac.insider.top_selling %}
          <tr><td><a href="stock.html#{{ x.ticker }}"><b>{{ x.ticker }}</b></a> <span class="muted sm">{{ x.name[:20] }}</span></td>
            <td class="muted sm">{{ td(x.sector) }}</td><td class="r zneg">−${{ '%.1f'|format(-x.net_usd_mn) }}M</td>
            <td class="r muted sm">{{ x.buys }}/{{ x.sells }}</td></tr>
          {% endfor %}
        </table>
      </div>
    </div>
  </div>
  {% endif %}
  </section>

  <section class="fx-sec" id="sec-season">
    <div class="sec-h"><span class="sec-n">06</span><h2>{{ t('Seasonality', '季节性') }}</h2></div>
    <p class="sec-sub">{{ t('Long-run calendar tendencies from academic total-market portfolios. Kept out of every score.', '来自学术全市场组合的长期日历规律。不进入任何评分。') }}</p>
  <!-- Factor weather hero — fail-open: seas absent or seas.now absent → panel hides -->
  {% if seas is not none and seas %}
  <div class="panel">
    {% set _now = seas.now if (seas.now is not none and seas.now) else none %}
    <div class="topline" style="margin-bottom:8px">
      <h2 style="margin:0">{{ t('Factor weather', '因子风向') }}
        {%- if _now %}{{ help(
          "Current-month per-factor seasonal stats — "
          ~ (_now.factors | map(attribute='plain_en') | join(', '))
          ~ ". Stats from Ken French total-US-market academic portfolios (1926+). "
          "Definition mismatch: French HML/RMW/CMA are value-weighted long/short over the whole US market, NOT our S&P-1500 winsorized z-scores — this is the style's long-run seasonal CLIMATE, not a forecast of our daily factor leadership. Kept out of every score.",
          "当月各因子季节性统计——来自 Ken French 全美市场学术组合（1926年+）。定义差异：French 的多空因子与我们的 S&P 1500 z 分数不同——此为长期季节性气候，非每日因子领先预测，且绝不进入任何评分。"
        ) }}{% endif -%}
      </h2>
      {% if seas.as_of %}<span class="muted sm">{{ seas.as_of }}</span>{% endif %}
    </div>
    {% if _now %}
    <p style="margin:0 0 8px;font-size:14px">
      <span class="l-en">{{ _now.headline_en or '' }}</span><span class="l-zh">{{ _now.headline_zh or '' }}</span>
    </p>
    {% if _now.stance_en %}
    <div style="margin-bottom:8px">
      {% if _now.chip_en %}
        {# Non-neutral: chip has color based on verdicts present #}
        {% set _any_hw = _now.factors | selectattr('verdict','eq','headwind') | list | length > 0 %}
        {% set _any_tw = _now.factors | selectattr('verdict','eq','tailwind') | list | length > 0 %}
        {% if _any_hw %}
          <span style="display:inline-block;padding:2px 10px;border-radius:8px;border:1px solid var(--act);color:var(--act);background:color-mix(in srgb,var(--act) 10%,var(--panel));font-size:12px;font-weight:600">
            <span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span>
          </span>
        {% elif _any_tw %}
          <span style="display:inline-block;padding:2px 10px;border-radius:8px;border:1px solid var(--ok);color:var(--ok);background:color-mix(in srgb,var(--ok) 10%,var(--panel));font-size:12px;font-weight:600">
            <span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span>
          </span>
        {% else %}
          <span class="chip"><span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span></span>
        {% endif %}
      {% else %}
        <span class="chip"><span class="l-en">{{ _now.stance_en }}</span><span class="l-zh">{{ _now.stance_zh or _now.stance_en }}</span></span>
      {% endif %}
    </div>
    {% endif %}
    {% if momo is not none and momo.get('top_decile') %}
    {% set _td = momo.top_decile %}
    <p class="sm" style="margin:0 0 4px">
      <span class="l-en">The hottest 10% of stocks right now: {{ _td.top_sector_share_pct }}% sit in {{ _td.top_sector }}.</span>
      <span class="l-zh">当前最热的10%个股中，{{ _td.top_sector_share_pct }}% 集中在{{ _td.top_sector }}。</span>
    </p>
    {% if momo.get('pulse') and momo.pulse.get('mtum_spy_20d_pct') is not none %}
    {% set _p20 = momo.pulse.mtum_spy_20d_pct %}
    <p class="sm muted" style="margin:0 0 4px">
      <span class="l-en">Hot stocks vs the market, last 20 days: {{ '%+.1f'|format(_p20) }}%.</span>
      <span class="l-zh">热门股相对大盘（近20日）：{{ '%+.1f'|format(_p20) }}%。</span>
    </p>
    {% endif %}
    {% endif %}
    {% endif %}
    <p class="muted sm" style="margin:10px 0 0">{{ t(
