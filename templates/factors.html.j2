  {% set _nw_hyp = (_nws.get('hypotheses') or {}) if _nw_avail else {} %}
  {% set _nw_as_of = _nws.get('as_of') if _nw_avail else none %}
  {# ── HOW THIS FEEDS THE NEURAL WEB ───────────────────────────────────────
