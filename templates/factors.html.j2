        <span class="chip">{{ t('offline', '离线') }}</span>
      {% elif _nw_floor %}
        <span class="chip" style="color:var(--up);border-color:color-mix(in srgb,var(--up) 45%,transparent);background:color-mix(in srgb,var(--up) 10%,transparent)">{{ t('live', '已启用') }}</span>
      {% else %}
        <span class="chip" style="color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,transparent);background:color-mix(in srgb,var(--warn) 9%,transparent)">{{ t('still learning', '累积中') }}</span>
      {% endif %}
      {% if _nw_as_of %}<span class="muted sm" style="margin-left:auto">{{ _nw_as_of }}</span>{% endif %}
    </div>

    {% if not _nw_avail %}
    <p class="muted sm" style="margin:0">{{ t(
      'The factor lane has not written its nightly state yet, so it is contributing nothing to the rest of the system right now. It will reappear after the next nightly build.',
      '因子通道尚未写入夜间状态，目前未向系统其余部分提供任何输入。将在下次夜间构建后恢复。') }}</p>
    {% else %}

