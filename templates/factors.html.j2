    <p class="muted sm" style="margin:14px 0 0;padding-top:12px;border-top:1px solid var(--fx-brd)">{{ t(
      'What it is allowed to do, today: explain, and quietly flag names worth a look. What it is never allowed to do: rank, score, or downgrade a signal on its own. Five registered ideas about how factors could inform the system are still being tested and none is in use.',
      '它目前被允许做的：解释行情、低调标记值得关注的个股。它永远不被允许做的：自行排名、评分或下调信号。五项关于因子如何为系统提供信息的注册假设仍在检验中，均未投入使用。') }}</p>
    {% endif %}
  </div>
  <div class="panel">
    <p class="muted" style="font-size:12px;margin:0">{{ t(
      "Source: SEC EDGAR XBRL 'frames' API (free, keyless) for FY" ~ (fac.fy or '') ~ " fundamentals, joined to the S&P 1500 price universe; " ~ fac.n ~ " names with a full composite as of " ~ fac.as_of ~ ". Fundamentals refresh weekly; ranks recompute daily with prices. Factors are decayed/crowded and free fundamentals are imperfect — treat as a research lens, not a buy list. See research/QUANT_FACTOR_EXPANSION.md and LIMITATIONS.md.",
      "来源：SEC EDGAR XBRL 'frames' API（免费、无需密钥）的 FY" ~ (fac.fy or '') ~ " 基本面，与标普 1500 价格域连接；截至 " ~ fac.as_of ~ " 有 " ~ fac.n ~ " 只具备完整综合分。基本面每周刷新，排名随价格每日重算。因子已衰减／拥挤且免费基本面并不完美 — 视作研究视角，而非买入清单。") }}
      {{ t('Generated', '生成于') }} {{ generated_utc }} UTC</p>
  </div>
  </section>
  {% if series and series.chart_data %}
  <script>
  const CHART_DATA = {{ series.chart_data | tojson }};
  const CHART_DATA_NARROW = {% if series.chart_data_narrow %}{{ series.chart_data_narrow | tojson }}{% else %}null{% endif %};
  (function(){
    if(!CHART_DATA || !CHART_DATA.dates) return;
    const cssv=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
    const PALETTE=['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635','#38bdf8','#e879f9'];
    let uni='broad', D=CHART_DATA, dates=D.dates, bench=D.bench, labels=D.labels||{};
    let FAC=Object.keys(D.long||{}), SEC=Object.keys(D.sector||{}), colorOf={};
    function recolor(){ colorOf={}; FAC.forEach((f,i)=>colorOf[f]=PALETTE[i%PALETTE.length]); SEC.forEach((s,i)=>colorOf['sec:'+s]=PALETTE[i%PALETTE.length]); }
    recolor();
    function setUni(u){ if(u==='narrow'&&!CHART_DATA_NARROW) return; uni=u; D=(u==='narrow')?CHART_DATA_NARROW:CHART_DATA; dates=D.dates; bench=D.bench; labels=D.labels||{}; FAC=Object.keys(D.long||{}); SEC=Object.keys(D.sector||{}); recolor(); hidden={}; var nt=document.getElementById('uni-note'); if(nt) nt.style.display=(u==='narrow')?'inline':'none'; drawChart(); renderPerfTable(); drawSector(); }
    const lastIdx=a=>{for(let i=a.length-1;i>=0;i--) if(a[i]!=null) return i; return -1;};
    function startIdxFor(col,li){ const u=col.toUpperCase(); if(u==='YTD'){const p=dates[li].slice(0,4); let i=li; while(i>0&&dates[i-1].startsWith(p))i--; return i>0?i-1:null;} const i=li-parseInt(col,10); return i>=0?i:null; }
    function winRet(lv,col){ if(!lv) return null; const li=lastIdx(lv); if(li<0) return null; const si=startIdxFor(col,li); if(si==null||lv[si]==null) return null; return lv[li]/lv[si]-1; }
    function winZ(lv,col){ const n=parseInt(col,10); if(!n||!lv) return null; const li=lastIdx(lv); if(li<252+n) return null; const hr=[]; for(let i=li-252;i<=li;i++) hr.push((lv[i]!=null&&lv[i-n]!=null)?lv[i]/lv[i-n]-1:null); const cur=hr[hr.length-1]; const base=hr.slice(0,-1).filter(v=>v!=null); if(cur==null||base.length<200) return null; const m=base.reduce((a,b)=>a+b,0)/base.length; const sd=Math.sqrt(base.reduce((a,b)=>a+(b-m)**2,0)/(base.length-1)); return sd>0?(cur-m)/sd:null; }
    const ratio=a=>a.map((v,i)=>(v!=null&&bench[i]!=null)?v/bench[i]:null);
    const fmtPct=x=>x==null?'—':(x>=0?'+':'')+(x*100).toFixed(1)+'%';
    const MODES=[['long','Long-only'],['rel','vs S&P 500'],['spread','Q5−Q1 premium'],['sector','Sectors vs S&P']];
    const RANGES=[['3M',63],['6M',126],['YTD','ytd'],['1Y',252],['All',0]];
    let mode='rel', range=252, chart=null, hidden={};
    function sets(){
      if(mode==='spread') return FAC.map(f=>({key:f,label:labels[f]||f,color:colorOf[f],levels:D.spread[f]}));
      if(mode==='sector') return SEC.map(s=>({key:'sec:'+s,label:s,color:colorOf['sec:'+s],levels:ratio(D.sector[s])}));
      const base=FAC.map(f=>({key:f,label:labels[f]||f,color:colorOf[f],levels:D.long[f]}));
      if(mode==='rel') return base.map(s=>({...s,levels:ratio(s.levels)}));
      return [...base,{key:'bench',label:'S&P 500',color:cssv('--muted')||'#94a3b8',levels:bench}];
    }
    function rangeStart(){ if(range==='ytd'){const y=dates[dates.length-1].slice(0,4); const i=dates.findIndex(d=>d.startsWith(y)); return i<=0?0:i-1;} return range?Math.max(0,dates.length-range):0; }
    function copts(){ return {autoSize:true, layout:{background:{type:'solid',color:'transparent'},textColor:cssv('--muted')||'#9aa4b2',fontSize:11}, grid:{vertLines:{visible:false},horzLines:{color:cssv('--line')||'#222'}}, rightPriceScale:{borderColor:cssv('--line')||'#222'}, timeScale:{borderColor:cssv('--line')||'#222'}, crosshair:{mode:0}}; }
    function drawChart(){
      const el=document.getElementById('fchart'); if(typeof LightweightCharts==='undefined'){el.innerHTML='<p class="muted">The charting library failed to load — the rest of the page is unaffected.</p>';return;}
      if(!chart) chart=LightweightCharts.createChart(el,copts());
      (chart.__s||[]).forEach(s=>chart.removeSeries(s)); chart.__s=[];
      const st=rangeStart(); const ss=sets().filter(s=>!hidden[s.key]); const nv=ss.length;
      ss.forEach(set=>{ let base=null; const data=[]; for(let i=st;i<dates.length;i++){const v=set.levels[i]; if(v==null) continue; if(base===null) base=v; data.push({time:dates[i],value:100*(v/base-1)});} if(data.length<2) return;
        const s=chart.addLineSeries({color:set.color,lineWidth:2,priceLineVisible:false,lastValueVisible:nv<=4,title:nv<=4?set.label:'',priceFormat:{type:'custom',minMove:0.01,formatter:v=>(v>=0?'+':'')+v.toFixed(1)+'%'}}); s.setData(data); chart.__s.push(s); });
      chart.timeScale().fitContent(); drawLegend();
    }
    function drawLegend(){ const el=document.getElementById('fc-legend'); const st=rangeStart();
      el.innerHTML=sets().map(s=>{const li=lastIdx(s.levels); let base=null; for(let i=st;i<=li;i++){if(s.levels[i]!=null){base=s.levels[i];break;}} const v=(base!=null&&s.levels[li]!=null)?100*(s.levels[li]/base-1):null;
        return `<span class="lchip ${hidden[s.key]?'off':''}" data-k="${s.key}"><span class="ldot" style="background:${s.color}"></span>${s.label} <span class="lv">${v==null?'':(v>=0?'+':'')+v.toFixed(1)+'%'}</span></span>`;}).join('');
      el.querySelectorAll('.lchip').forEach(c=>c.onclick=()=>{hidden[c.dataset.k]=!hidden[c.dataset.k]; drawChart();}); }
    function tabs(elId,opts,active,cb){ const el=document.getElementById(elId); el.innerHTML=opts.map(([v,l])=>`<button data-v="${v}" class="${v==active?'on':''}">${l}</button>`).join(''); el.querySelectorAll('button').forEach(b=>b.onclick=()=>{el.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); cb(b.dataset.v);}); }
    // ---- unified factor performance table (scope × mode × horizons, sortable) ----
    const FCOLS=['1d','5d','20d','60d','MTD','YTD'];
    const FMODES=[['raw','Raw'],['rel','vs S&P'],['sigma','σ']];
    const FSCOPE=[['long','Factors (long-only)'],['spread','Q5−Q1 spread']];
    let fscope=localStorage.getItem('fw-fp-scope')||'long', fmode=localStorage.getItem('fw-fp-mode')||'rel';
    let fsort=JSON.parse(localStorage.getItem('fw-fp-sort')||'{"col":"20d","dir":-1}');
    const fmtZ=x=>x==null?'—':(x>=0?'+':'')+x.toFixed(1)+'σ';
    const cls2=x=>x==null?'muted':(x>=0?'pos':'neg');
    function renderPerfTable(){
      const data = fscope==='long'?D.long:D.spread;
      const rows=Object.keys(data).map(f=>{ const lv=data[f]; const rl=ratio(lv);
        const retSrc=(fscope==='long'&&fmode==='rel')?rl:lv; const zSrc=fscope==='long'?rl:lv;
        const vals={}; FCOLS.forEach(c=>{ vals[c]= fmode==='sigma' ? (/^\d/.test(c)?winZ(zSrc,c):null) : winRet(retSrc,c); });
        return {f,label:labels[f]||f,color:colorOf[f],vals}; });
      const sc=fsort.col,dir=fsort.dir;
      rows.sort((a,b)=>{ if(sc==='name') return a.label.localeCompare(b.label)*dir; const x=a.vals[sc],y=b.vals[sc]; if(x==null)return 1; if(y==null)return -1; return (x-y)*dir; });
      const fmt=fmode==='sigma'?fmtZ:fmtPct;
      const dotS=c=>`display:inline-block;width:9px;height:9px;border-radius:50%;background:${c};margin-right:7px`;
      const th=c=>`<th class="hzc ${c===sc?'sel':''}" data-c="${c}" style="cursor:pointer">${c}${c===sc?(dir<0?' ▾':' ▴'):''}</th>`;
      let html=`<thead><tr><th data-c="name" style="text-align:left;cursor:pointer">Factor${sc==='name'?(dir<0?' ▾':' ▴'):''}</th>${FCOLS.map(th).join('')}</tr></thead><tbody>`;
      html+=rows.map(r=>`<tr><td style="text-align:left"><span style="${dotS(r.color)}"></span>${r.label}</td>${FCOLS.map(c=>`<td class="hzc ${cls2(r.vals[c])}">${r.vals[c]==null?'<span class="muted">—</span>':fmt(r.vals[c])}</td>`).join('')}</tr>`).join('');
      if(fscope==='long'&&fmode==='raw'){ const bv={}; FCOLS.forEach(c=>bv[c]=winRet(bench,c)); html+=`<tr><td style="text-align:left"><span style="${dotS(cssv('--muted')||'#94a3b8')}"></span>S&amp;P 500</td>${FCOLS.map(c=>`<td class="hzc ${cls2(bv[c])}">${fmtPct(bv[c])}</td>`).join('')}</tr>`; }
      const tbl=document.getElementById('fperf-table'); tbl.innerHTML=html+'</tbody>';
      tbl.querySelectorAll('th[data-c]').forEach(h=>h.onclick=()=>{const c=h.dataset.c; if(c===fsort.col)fsort.dir*=-1; else fsort={col:c,dir:c==='name'?1:-1}; localStorage.setItem('fw-fp-sort',JSON.stringify(fsort)); renderPerfTable();});
    }
    const HZ=['1d','5d','20d','60d','YTD'];
    function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
    function zbg(z){ if(z==null) return ''; const a=Math.min(Math.abs(z)/2.5,0.85).toFixed(2); if(isZh()) return z>=0?`background:rgba(248,81,73,${a})`:`background:rgba(56,139,253,${a})`; return z>=0?`background:rgba(56,139,253,${a})`:`background:rgba(248,81,73,${a})`; }
    function drawSector(){
      const rows=SEC.map(s=>{const rl=ratio(D.sector[s]); return {s,rel:Object.fromEntries(HZ.map(h=>[h,winRet(rl,h)])), z:Object.fromEntries(HZ.map(h=>[h,/^\d/.test(h)?winZ(rl,h):null]))};});
      rows.sort((a,b)=>(b.rel['20d']==null?-9:b.rel['20d'])-(a.rel['20d']==null?-9:a.rel['20d']));
      let html=`<thead><tr><th style="text-align:left">Sector (vs S&P)</th>${HZ.map(h=>`<th class="hzc">${h}</th>`).join('')}</tr></thead><tbody>`;
      html+=rows.map(r=>`<tr><td>${r.s}</td>${HZ.map(h=>`<td class="hzc" style="${zbg(r.z[h])}"><span class="zc">${r.z[h]==null?'':(r.z[h]>=0?'+':'')+r.z[h].toFixed(1)+'σ'}</span><span class="rr ${r.rel[h]>=0?'pos':'neg'}">${fmtPct(r.rel[h])}</span></td>`).join('')}</tr>`).join('');
      document.getElementById('sector-monitor').innerHTML=html+'</tbody>';
    }
    function bootFc(){
      const usw=document.getElementById('fc-universe');
      if(CHART_DATA_NARROW) tabs('fc-universe',[['broad','S&P 1500 · broad'],['narrow','S&P 500 · large cap']],'broad',setUni);
      else if(usw) usw.style.display='none';
      tabs('fp-scope',FSCOPE,fscope,v=>{fscope=v; localStorage.setItem('fw-fp-scope',v); renderPerfTable();});
      tabs('fp-mode',FMODES,fmode,v=>{fmode=v; localStorage.setItem('fw-fp-mode',v); renderPerfTable();});
      renderPerfTable();
      tabs('fc-modes',MODES,mode,v=>{mode=v; drawChart();});
      const rel=document.getElementById('fc-ranges'); rel.innerHTML=RANGES.map(([l,v])=>`<button data-v="${v}" class="${v===range?'on':''}">${l}</button>`).join('')+`<input class="rangeN" type="number" min="5" max="600" placeholder="N">`;
      rel.querySelectorAll('button').forEach(b=>b.onclick=()=>{range=(b.dataset.v==='ytd')?'ytd':parseInt(b.dataset.v,10); rel.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); drawChart();});
      rel.querySelector('.rangeN').onchange=function(){range=Math.min(600,Math.max(5,parseInt(this.value,10)||252)); rel.querySelectorAll('button').forEach(x=>x.classList.remove('on')); drawChart();};
      drawChart(); drawSector();
      document.addEventListener('langchange',()=>{if(chart)chart.applyOptions(copts()); drawChart(); drawSector();});
      document.addEventListener('themechange',()=>{if(chart)chart.applyOptions(copts()); drawChart();});
    }
    if(document.readyState!=='loading') bootFc(); else document.addEventListener('DOMContentLoaded',bootFc);
  })();
  </script>
  {% endif %}
  {# ── FACTOR DRAWER ──────────────────────────────────────────────────────
     One factor's whole story in one place. It is assembled from the SAME
     artifacts the panels above render (ic.rows, series.stats, fac.leaders), so
     it can never disagree with them. Display-only: it reads nothing new, emits
     nothing, and feeds no score. Every field is fail-open — a missing artifact
     just drops that row from the drawer. #}
  <div class="fx-scrim" id="fx-scrim"></div>
  <aside class="fx-drawer" id="fx-drawer" role="dialog" aria-modal="true"
         aria-label="{{ t('Factor detail','因子详情') }}">
    <button class="dw-x" id="fx-dwx" aria-label="{{ t('Close','关闭') }}">&#10005;</button>
    <div id="fx-dwbody"></div>
  </aside>
  <script>
  const FX_F = {};
  function _fx(k){ return (FX_F[k] = FX_F[k] || {}); }
  {% if ic and ic.rows %}{% for r in ic.rows %}
  Object.assign(_fx({{ r.factor|tojson }}), {
    label: {{ (fac.factor_labels.get(r.factor, r.label_en))|tojson }},
    val: {{ ('fdr-pass' if (r.survives_fdr and r.mean_ic is not none and r.mean_ic > 0)
             else ('negative-ic' if (r.mean_ic is not none and r.mean_ic < 0) else 'fdr-fail'))|tojson }},
    ic: {{ r.mean_ic|tojson }}, ir: {{ r.ic_ir_ann|tojson }}, t: {{ r.t_hac|tojson }},
    hit: {{ r.hit|tojson }}, q: {{ r.q_fdr|tojson }}, n: {{ r.n|tojson }},
    blurb: {{ (FHELP.get(r.factor)[0] if FHELP.get(r.factor) else none)|tojson }},
    blurbZh: {{ (FHELP.get(r.factor)[1] if FHELP.get(r.factor) else none)|tojson }} });
  {% endfor %}{% endif %}
  {% if series and series.factors %}{% for f in series.factors %}
  Object.assign(_fx({{ f|tojson }}), {
    loCum: {{ series.series[f].long_only.cum_pct|tojson }},
    lsCum: {{ series.series[f].long_short.cum_pct|tojson }},
    loS: {{ series.stats[f].sharpe_lo|tojson }}, lsS: {{ series.stats[f].sharpe_ls|tojson }},
    ci: {{ series.stats[f].sharpe_ls_ci|tojson }}, p: {{ series.stats[f].sharpe_gt0_prob|tojson }} });
  if(!_fx({{ f|tojson }}).label) _fx({{ f|tojson }}).label = {{ series.labels[f]|tojson }};
  {% endfor %}{% endif %}
  {% for L in (fac.leadership or []) %}{% if L.factor is defined and L.factor %}
  _fx({{ L.factor|tojson }}).spread = {{ L.spread_pct|tojson }};
  {% endif %}{% endfor %}
  {% for f in (fac.factors + ['sue','low_beta','accruals','short_interest']) %}{% if fac.leaders.get(f) %}
  Object.assign(_fx({{ f|tojson }}), {
    names: {{ (fac.leaders[f][:10] | map(attribute='ticker') | list)|tojson }} });
  if(!_fx({{ f|tojson }}).label) _fx({{ f|tojson }}).label = {{ fac.factor_labels.get(f, f)|tojson }};
  {% endif %}{% endfor %}

  (function(){
    const $=s=>document.querySelector(s), esc=s=>String(s==null?'':s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    /* bilingual pair — labels TOGGLE via l-en / l-zh, never both on screen */
    const L=(en,zh)=>'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh||en)+'</span>';
    const VL={'fdr-pass':['FDR-PASS','通过FDR'],'fdr-fail':['FDR-FAIL','未过检'],
              'negative-ic':['NEG-IC','反向']};
    const num=(v,d,s)=>v==null?'—':((v>=0&&s?'+':'')+v.toFixed(d));
    const pct=v=>v==null?'—':((v>=0?'+':'')+v.toFixed(0)+'%');

    const dw=$('#fx-drawer'), sc=$('#fx-scrim'), body=$('#fx-dwbody'), x=$('#fx-dwx');
    let last=null;

    function row(k,kz,v){ return v==null||v==='—'?'':
      '<span class="k">'+L(k,kz)+'</span><span class="v">'+v+'</span>'; }

    function open(key){
      const f=FX_F[key]; if(!f||!f.label) return;
      last=document.activeElement;
      const vcs=f.val==='fdr-pass'
        ?' style="color:var(--ok);border:1px solid color-mix(in srgb,var(--ok) 55%,transparent);background:color-mix(in srgb,var(--ok) 12%,transparent)"':'';
      const vc=f.val?'<span class="val-chip '+f.val+'"'+vcs+'>'+L(VL[f.val][0],VL[f.val][1])+'</span>':'';
      const edge=row('mean IC','平均 IC',num(f.ic,4,1))+row('IC-IR (ann)','IC-IR（年化）',num(f.ir,2,1))
        +row('t-HAC','t 值',num(f.t,2,1))
        +row('hit rate','命中率',f.hit==null?null:(f.hit*100).toFixed(0)+'%')
        +row('q-FDR','q 值',num(f.q,2,0))+row('quarters','季度数',f.n==null?null:String(f.n));
      const ci=f.ci&&f.ci.length>2?' <span class="muted sm">['+f.ci[0]+', '+f.ci[2]+']</span>':'';
      const port=row('long-only cumulative','纯多头累计',pct(f.loCum))
        +row('long-only Sharpe','纯多头夏普',num(f.loS,2,0))
        +row('Q5−Q1 cumulative','多空累计',pct(f.lsCum))
        +row('Q5−Q1 Sharpe','多空夏普',f.lsS==null?null:num(f.lsS,2,0)+ci)
        +row('P(Sharpe > 0)','P(夏普>0)',f.p==null?null:String(f.p));
      const rec=row('63-day Q5−Q1 spread','63日多空价差',
        f.spread==null?null:'<span class="'+(f.spread>=0?'pos':'neg')+'">'
        +(f.spread>=0?'+':'')+f.spread.toFixed(1)+'%</span>');
      /* the read: multiple-testing state is the honest headline, not the return */
      const read = f.val==='fdr-pass'
        ? L('Clears BH-FDR with a positive measured edge — the only bar on this page that means anything. Still a marginal survivor on a survivorship-biased panel: a tilt, not a trade.',
            '通过 BH-FDR 且实测优势为正 — 本页唯一有意义的门槛。但在含幸存者偏差的面板上仍属勉强通过：可作倾斜，而非交易。')
        : f.val==='negative-ic'
        ? L('Measured edge points the WRONG way on this panel. Whatever its portfolio did, this ranking sorted the cross-section anti-predictively. Read it as description only.',
            '在此面板上实测优势方向为负。无论其组合表现如何，该排名对横截面的排序是反预测的。仅作描述阅读。')
        : L('Does not survive multiple-testing control. Suggestive at best — treat it as a description of what is cheap or high quality, not as a signal.',
            '未通过多重检验控制。至多具有提示性 — 应视为对“什么便宜／什么优质”的描述，而非信号。');

      body.innerHTML =
        '<div class="dw-eyebrow">'+L('Factor','因子')+'</div>'
        +'<div class="dw-title"><h3>'+esc(f.label)+'</h3>'+vc+'</div>'
        +(f.blurb?'<p class="dw-blurb">'+L(esc(f.blurb),esc(f.blurbZh))+'</p>':'')
        +(edge?'<div class="dw-sec"><h4>'+L('Measured edge','实测优势')+'</h4><div class="dw-kv">'+edge+'</div></div>':'')
        +(port?'<div class="dw-sec"><h4>'+L('As a portfolio','作为组合')+'</h4><div class="dw-kv">'+port+'</div></div>':'')
        +(rec?'<div class="dw-sec"><h4>'+L('Recent','近期')+'</h4><div class="dw-kv">'+rec+'</div></div>':'')
        +(f.names&&f.names.length?'<div class="dw-sec"><h4>'+L('Top of this ranking','该排名前列')
          +'</h4><div class="dw-names">'+f.names.map(t=>'<a class="chip" href="stock.html#'+esc(t)+'">'
          +esc(t)+'</a>').join('')+'</div></div>':'')
        +'<div class="dw-sec"><h4>'+L('Read','解读')+'</h4><p class="dw-read">'+read+'</p></div>';
      dw.classList.add('on'); sc.classList.add('on');
      if(location.hash!=='#f/'+key) history.replaceState(null,'','#f/'+key);
      x.focus();
    }
    function close(){ dw.classList.remove('on'); sc.classList.remove('on');
      if(location.hash.indexOf('#f/')===0) history.replaceState(null,'',location.pathname);
      if(last&&last.focus) last.focus(); }

    document.addEventListener('click',e=>{
      const el=e.target.closest('[data-fx]'); if(el&&FX_F[el.dataset.fx]){ e.preventDefault(); open(el.dataset.fx); } });
    sc.addEventListener('click',close); x.addEventListener('click',close);
    document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&dw.classList.contains('on')) close(); });
    /* deep link: factors.html#f/value opens Value straight from a shared URL */
    function fromHash(){ const m=(location.hash||'').match(/^#f\/([\w]+)$/); if(m&&FX_F[m[1]]) open(m[1]); }
    addEventListener('hashchange',fromHash); fromHash();

    /* ── explorer tabs — build from the panes actually present ──────────── */
    const TAB=[['chart','Chart','图表'],['moves','Recent moves','近期变动'],['quilt','Quilt','拼布']];
    const strip=$('#fx-tabs'), panes=[...document.querySelectorAll('.fx-pane')];
    if(strip&&panes.length){
      const live=TAB.filter(t=>panes.some(p=>p.dataset.pane===t[0]&&p.children.length));
      if(live.length>1){
        strip.innerHTML=live.map((t,i)=>'<button role="tab" data-p="'+t[0]+'" class="'
          +(i?'':'on')+'">'+L(t[1],t[2])+'</button>').join('');
        panes.forEach(p=>p.classList.toggle('on',p.dataset.pane===live[0][0]));
        strip.addEventListener('click',e=>{ const b=e.target.closest('button[data-p]'); if(!b)return;
          strip.querySelectorAll('button').forEach(z=>z.classList.toggle('on',z===b));
          panes.forEach(p=>p.classList.toggle('on',p.dataset.pane===b.dataset.p));
          window.dispatchEvent(new Event('resize')); });
      } else { strip.style.display='none'; panes.forEach(p=>p.classList.add('on')); }
    }

    /* ── ticker lookup across every leaderboard ─────────────────────────── */
    const q=$('#fx-tq'), note=$('#fx-tnote');
    if(q&&note){
      const cards=[...document.querySelectorAll('.fcard')];
      cards.forEach(c=>c.querySelectorAll('tr').forEach(r=>{
        const b=r.querySelector('b'); if(b) r.dataset.tk=b.textContent.trim().toUpperCase(); }));
      const base=()=>{ note.innerHTML=L('Type a ticker to see every ranking it leads.',
        '输入代码，查看它在哪些排名中领先。'); };
      base();
      q.addEventListener('input',()=>{
        const v=q.value.trim().toUpperCase(); let n=0;
        cards.forEach(c=>{ let has=false;
          c.querySelectorAll('tr[data-tk]').forEach(r=>{ const m=!!v&&r.dataset.tk===v;
            r.classList.toggle('hit',m); if(m) has=true; });
          c.classList.toggle('dim',!!v&&!has); if(has) n++; });
        if(!v) return base();
        note.innerHTML = n
          ? L(v+' leads '+n+' ranking'+(n>1?'s':'')+'.', v+' 在 '+n+' 项排名中领先。')
          : L(v+' does not lead any ranking.', v+' 未在任何排名中领先。');
      });
    }

    /* ── section rail scroll-spy ────────────────────────────────────────── */
    const links=[...document.querySelectorAll('#fx-rail a')];
    const secs=links.map(a=>document.querySelector(a.getAttribute('href'))).filter(Boolean);
    if(secs.length&&'IntersectionObserver' in window){
      const io=new IntersectionObserver(es=>{ es.forEach(en=>{ if(!en.isIntersecting) return;
        const i=secs.indexOf(en.target);
        links.forEach((a,j)=>a.classList.toggle('on',j===i)); }); },
        {rootMargin:'-18% 0px -72% 0px'});
      secs.forEach(s=>io.observe(s));
    }
  })();
  </script>
  <script src="theme.js"></script>
</body>
</html>
