{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro fbar(v) -%}
<div class="fbar"><span class="mid"></span><span class="fill {{ 'pos' if v>=0 else 'neg' }}" style="width:{{ (v*50)|abs|round(1) }}%;{{ 'left:50%' if v>=0 else 'right:50%' }}"></span></div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Forex Vector — {{ as_of }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r1:{{C.r1}}; --r2:{{C.r2}}; --r3:{{C.r3}};
  --r4:{{C.r4}}; --r5:{{C.r5}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --redfill:{{C.redfill}}; --amber:{{C.amber}};
  --green:{{C.green}}; --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280;--r1:#1b2740;--r2:#243352}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-2,.cols-3{grid-template-columns:1fr}}
.sec-head{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em;margin:24px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
.board-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(328px,1fr));gap:18px}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.brand{font-weight:800;font-size:21px;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.brand .gn{color:var(--blue)}
.lead{color:var(--muted);font-size:14px;margin:0 0 20px}
.hero-state{font-size:30px;font-weight:800;letter-spacing:-.02em;margin:6px 0 6px}
.hero-meta{font-size:14px;color:var(--text)}.hero-meta b{color:var(--ink)}
.sub{font-size:13px;color:var(--muted)}.faint{color:var(--faint)}
.pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#eef1f6;color:var(--ink);margin:2px 4px 2px 0}
html[data-theme="dark"] .pill{background:#222732}
.pill.fav{background:rgba(40,95,255,.10);color:var(--blue)}
.kpis{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px}
.kpi{font-size:13px;color:var(--muted)}.kpi b{display:block;font-size:18px;color:var(--ink);font-weight:700}
.flag{display:inline-block;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:600;margin-top:10px}
.flag.warn{background:rgba(245,173,66,.14);color:#9a6a10}
.flag.info{background:rgba(40,95,255,.10);color:var(--blue)}
.cnh-basis{margin:10px 0;padding:8px 11px;border-radius:8px;font-size:12.5px;line-height:1.5;background:#eef1f6}
html[data-theme="dark"] .cnh-basis{background:#222732}
.cnh-basis b{color:var(--ink)}
.cnh-basis.s-outflow_stress{background:rgba(211,11,11,.12)}
.cnh-basis.s-inflow{background:rgba(26,127,67,.12)}
/* per-pair card */
.pair-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap}
.pair-name{font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-.01em}
.pair-arch{font-size:11.5px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.quote{font-size:24px;font-weight:800;color:var(--ink)}
.chg.up{color:var(--green)}.chg.dn{color:var(--red)}
.verdict-box{margin:14px 0;padding:14px;border-radius:12px;background:#f6f8fc;border:1px solid var(--grid)}
html[data-theme="dark"] .verdict-box{background:#11151c}
.rc-head{font-size:15px;font-weight:700;color:var(--ink);margin-bottom:6px}
.chip{display:inline-block;padding:4px 12px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.01em}
.chip.sbuy,.chip.buy{background:rgba(26,127,67,.13);color:var(--green)}
.chip.hold{background:#eef1f6;color:var(--muted)}
.chip.sell,.chip.ssell{background:rgba(211,11,11,.12);color:var(--red)}
.score-n{font-size:13px;color:var(--muted);margin-left:8px}
.framing{font-size:12px;color:var(--faint);margin-top:8px;font-style:italic}
/* factor breakdown */
.fgrp{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:12px 0 6px}
.frow{display:grid;grid-template-columns:124px 1fr 58px;align-items:center;gap:10px;margin:5px 0;font-size:12.5px}
.flabel{color:var(--text)}.fwt{color:var(--faint);text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.vg{font-weight:700;margin-left:4px;font-size:12px}
.vg.confirmed{color:var(--green)}.vg.inverted{color:var(--indigo)}.vg.directional{color:#9a6a10}.vg.context,.vg.unmeasured{color:var(--faint)}
.calbadge{display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600;margin-left:6px}
.calbadge.on{background:rgba(26,127,67,.12);color:var(--green)}
.calbadge.soft{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .calbadge.soft{background:#222732}
.fbar{position:relative;height:14px;background:#eef1f6;border-radius:7px;overflow:hidden}
html[data-theme="dark"] .fbar{background:#222732}
.fbar .mid{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.5}
.fbar .fill{position:absolute;top:0;bottom:0}
.fbar .fill.pos{background:var(--green);border-radius:0 7px 7px 0}
.fbar .fill.neg{background:var(--red);border-radius:7px 0 0 7px}
.carry-row{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px;padding-top:12px;border-top:1px solid var(--grid)}
.mtf{margin-top:12px;padding-top:12px;border-top:1px solid var(--grid)}
.mtf-row{display:grid;grid-template-columns:1.3fr 1fr 1fr .8fr .8fr;gap:6px;font-size:12px;padding:3px 0;align-items:center;font-variant-numeric:tabular-nums}
.mtf-head{color:var(--muted);font-weight:600;font-size:10.5px;text-transform:uppercase;letter-spacing:.03em}
.mtf-grade{color:var(--blue);font-weight:700}
.macd-up,.tr-up,.macd-pos{color:var(--green)}.macd-down,.tr-down,.macd-neg{color:var(--red)}
.timeline{margin-top:6px}
.tl-day{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 0 4px}
.tl-ev{display:flex;align-items:baseline;gap:10px;padding:6px 0;border-bottom:1px solid var(--grid);font-size:13px}
.tl-type{flex:none;min-width:62px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
.tl-asset{flex:none;min-width:66px;color:var(--muted);font-size:12px}
.tl-head{color:var(--text)}
.sev-high .tl-type{color:var(--red)}.sev-medium .tl-type{color:#9a6a10}.sev-info .tl-type{color:var(--muted)}
table.tbl{width:100%;border-collapse:collapse;font-size:13px;margin-top:6px}
table.tbl th,table.tbl td{padding:7px 8px;border-bottom:1px solid var(--grid);text-align:right}
table.tbl th:first-child,table.tbl td:first-child{text-align:left}
table.tbl th{color:var(--muted);font-weight:600;font-size:11.5px;text-transform:uppercase;letter-spacing:.03em}
.site-footer{max-width:1180px;margin:30px auto 0;padding:18px 20px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;color:var(--muted);font-size:12.5px}
.meta-foot{font-size:12px;color:var(--faint);margin-top:8px}
.note{font-size:13px;color:var(--muted);line-height:1.6}
.note b{color:var(--ink)}
/* ===================== Dollar Desk ===================== */
.section-h{display:flex;align-items:baseline;gap:8px;margin:30px 0 4px;flex-wrap:wrap}
.section-h .sn{color:var(--blue);font-weight:800;font-size:13px}
.section-h h2{margin:0;font-size:15px;font-weight:800;color:var(--ink);text-transform:none;letter-spacing:-.01em}
.section-h .sh-sub{font-size:12px;color:var(--muted);margin-left:2px}
.desk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;margin-top:14px}
.desk-tile{background:#f6f8fc;border:1px solid var(--grid);border-radius:12px;padding:12px 13px}
html[data-theme="dark"] .desk-tile{background:#11151c}
.dt-lab{font-size:10.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.dt-val{font-size:16px;font-weight:800;color:var(--ink);margin:4px 0 2px;line-height:1.25}
.dt-sub{font-size:11.5px;color:var(--muted);line-height:1.45}
.lead-tag{display:inline-block;margin-top:7px;padding:2px 7px;border-radius:6px;font-size:9.5px;font-weight:700;letter-spacing:.02em;text-transform:uppercase}
.lead-tag.coincident{background:rgba(245,173,66,.14);color:#9a6a10}
.lead-tag.context{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .lead-tag.context{background:#222732}
.dt-chip{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:700}
.dt-chip.up,.dt-chip.supportive,.dt-chip.rich{background:rgba(26,127,67,.13);color:var(--green)}
.dt-chip.down,.dt-chip.soft,.dt-chip.cheap{background:rgba(211,11,11,.12);color:var(--red)}
.dt-chip.mixed,.dt-chip.neutral,.dt-chip.fair,.dt-chip.steady{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .dt-chip.mixed,html[data-theme="dark"] .dt-chip.neutral,html[data-theme="dark"] .dt-chip.fair,html[data-theme="dark"] .dt-chip.steady{background:#222732}
.hstack{display:flex;gap:3px;margin-top:7px}
.hbar{flex:1;height:20px;border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#fff;line-height:1}
.hbar small{font-size:8px;opacity:.85;font-weight:600}
.hbar.up{background:var(--green)}.hbar.down{background:var(--red)}
.desk-lean{display:inline-block;margin-top:2px;padding:5px 14px;border-radius:999px;font-size:14px;font-weight:800}
.desk-lean.supportive{background:rgba(26,127,67,.13);color:var(--green)}
.desk-lean.soft{background:rgba(211,11,11,.12);color:var(--red)}
.desk-lean.mixed{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .desk-lean.mixed{background:#222732}
.tr-flag{display:inline-block;margin-top:8px;padding:4px 10px;border-radius:8px;font-size:11.5px;font-weight:700;background:rgba(211,11,11,.12);color:var(--red)}
/* transmission */
.stab{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle}
.stab.stable{background:var(--green)}.stab.flipping{background:var(--amber)}.stab.decoupled{background:var(--faint)}
.eff.headwind{color:var(--red);font-weight:700}.eff.tailwind{color:var(--green);font-weight:700}.eff.neutral{color:var(--muted)}
.tnote{font-size:11.5px;color:var(--muted);margin-top:3px}
/* currency strength meter */
.seg-toggle{display:inline-flex;gap:4px}
.seg-btn{padding:3px 11px;border-radius:999px;font-size:11.5px;font-weight:600;color:var(--muted);background:#eef1f6;border:1px solid var(--grid);cursor:pointer}
.seg-btn.on{background:var(--blue);color:#fff;border-color:var(--blue)}
html[data-theme="dark"] .seg-btn{background:#222732}
.smeter[hidden]{display:none}
.srow{display:grid;grid-template-columns:72px 1fr 60px;align-items:center;gap:12px;margin:6px 0}
.sccy{font-weight:800;color:var(--ink);font-size:13.5px}
.sccy .em{font-size:9px;color:var(--amber);font-weight:700;margin-left:4px;vertical-align:middle}
.sbar{position:relative;height:16px;background:#eef1f6;border-radius:8px;overflow:hidden}
html[data-theme="dark"] .sbar{background:#222732}
.sbar .smid{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.6}
.sbar .sfill{position:absolute;top:0;bottom:0}
.sbar .sfill.pos{background:var(--green);border-radius:0 8px 8px 0}
.sbar .sfill.neg{background:var(--red);border-radius:8px 0 0 8px}
.spct{text-align:right;font-size:12px;font-variant-numeric:tabular-nums;color:var(--muted)}
/* scorecards */
.sc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(305px,1fr));gap:16px;margin-top:6px}
.sc-card{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:18px}
.sc-name{font-size:16px;font-weight:800;color:var(--ink)}
.sc-thesis{font-size:12px;color:var(--muted);margin:4px 0 10px;line-height:1.5}
.sc-met{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:8px 0}
.sc-met .m{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.sc-met .m b{display:block;font-size:16px;color:var(--ink);font-weight:800;margin-top:2px}
.sc-split{font-size:12px;margin-top:8px}
.sc-split .sr{display:grid;grid-template-columns:54px 1fr 1fr 1fr;gap:6px;padding:3px 0;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums}
.sc-split .sr.h{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.03em;border:none}
.sc-pos{color:var(--green);font-weight:700}.sc-neg{color:var(--red);font-weight:700}
.sc-tilt{font-size:11.5px;color:var(--muted);margin-top:8px}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav" style="max-width:1180px;margin:0 auto 16px;padding:0 20px">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <div class="brand">💱 Forex <span class="gn">Vector</span></div>
  <p class="lead">{{ t('A dollar-first currency board. The broad-dollar regime sits on top; each pair is scored on its move AFTER stripping the shared dollar beta, so the board is not one repeated dollar bet. Verdicts are RISK-CONTEXT, not trade calls.', '以美元为先的货币面板。广义美元格局置于顶部；每个货币对在剥离共同的美元贝塔后再评分，因此整个面板并非重复押注美元。结论为风险背景，而非交易建议。') }}
  <span class="faint">· {{ t('As of', '截至') }} {{ as_of }}</span></p>

  {# state-word -> (en, zh) maps for the desk chips #}
  {% set LEAN = {'supportive': ('USD-supportive','偏多美元'), 'soft': ('USD-soft','偏空美元'), 'neutral': ('Neutral','中性')} %}
  {% set POSST = {'crowded_long': ('Crowded long','拥挤做多'), 'crowded_short': ('Crowded short','拥挤做空'), 'neutral': ('Neutral','中性')} %}
  {% set VALL = {'rich': ('Rich','偏贵'), 'cheap': ('Cheap','偏便宜'), 'fair': ('Fair','合理')} %}
  {% set CONF = {'high': ('High','高'), 'medium': ('Medium','中'), 'low': ('Low','低'), 'none': ('None','无')} %}

  <!-- ===================== §01 · DOLLAR DESK ===================== -->
  <div class="section-h"><span class="sn">§01</span><h2>{{ t('Dollar Desk — the master variable', '美元桌 · 主控变量') }}</h2>
    <span class="sh-sub">{{ t('the dollar routes ~89% of FX turnover and conditions commodities, equities, bonds & crypto', '美元承载约89%的外汇交易量，并影响大宗商品、股票、债券与加密货币') }}</span></div>
  <div class="grid cols-2" style="margin-bottom:14px">
    <div class="card">
      <h2>{{ t('Broad-dollar master · the dollar smile', '广义美元主控 · 美元微笑') }}</h2>
      <div class="hero-state" style="color:{{ dollar.color }}">{{ t(dollar.regime, dollar.regime_zh) }}</div>
      <div class="hero-meta">
        {{ t('US dollar', '美元') }} <b>{{ t(dollar.dollar_dir, dollar.dollar_dir_zh) }}</b>
        <span class="faint">({{ dollar.roc }}% / 63d)</span> ·
        {{ t('risk', '风险') }} <b>{{ t(dollar.risk_word, dollar.risk_word_zh) }}</b>
        <span class="faint">({{ dollar.risk_off }})</span>
      </div>
      {% if desk and desk.lean %}
      {% set lc = 'supportive' if 'supportive' in desk.lean else ('soft' if 'soft' in desk.lean else 'mixed') %}
      <div style="margin-top:10px"><span class="desk-lean {{ lc }}">{{ t(desk.lean, desk.lean_zh) }}</span>
        <span class="sub faint" style="margin-left:6px">{{ t('balance of context flags — a summary, not a score', '背景信号的平衡 — 仅为汇总，非评分') }}</span></div>
      {% endif %}
      <div style="margin-top:12px">
        {% if dollar.favored %}<span class="sub">{{ t('Favored:', '受青睐：') }}</span>
        {% for f in dollar.favored %}<span class="pill fav">{{ f }}</span>{% endfor %}
        {% else %}<span class="sub faint">{{ t('No clear tailwind.', '无明显顺风。') }}</span>{% endif %}
      </div>
      <div class="kpis">
        <div class="kpi">{{ t('Broad USD', '广义美元') }}<b>{{ dollar.broad }}</b></div>
        <div class="kpi">DXY<b>{{ dollar.dxy }}</b></div>
        <div class="kpi">{{ t('Advanced leg', '发达经济体') }}<b>{{ dollar.afe }}</b></div>
        <div class="kpi">{{ t('EM leg', '新兴经济体') }}<b>{{ dollar.eme }}</b></div>
      </div>
      {% if dollar.dollar_day %}<span class="flag warn">⚑ {{ t('Dollar day — broad-$ move dominates; per-pair confidence is haircut.', '美元日 — 广义美元波动主导；各货币对信心已折减。') }}</span>{% endif %}
      {% if desk and desk.smile and desk.smile.triple_red %}<span class="tr-flag">⚑ {{ t('Triple-red — USD, equities & Treasuries falling together: the dollar is NOT acting as a haven.', '三红 — 美元、股票与国债同步下跌：美元未发挥避险作用。') }}</span>{% endif %}
      <div class="sub" style="margin-top:12px">{{ t('The smile: the dollar tends to strengthen at BOTH ends — a US-led growth premium and a global risk-off haven bid — and weaken in the calm, synchronized-growth middle. This regime conditions every pair below.', '美元微笑：美元在两端都倾向走强 — 美国增长溢价与全球避险买盘 — 而在平静的同步增长中段走软。该格局影响下方每个货币对。') }}</div>
    </div>
    <div class="card">
      <h2>{{ t('Broad dollar & risk-off composite', '广义美元与避险综合') }}</h2>
      {{ dollar.chart | safe }}
      {% if real_rate_chart %}<div style="margin-top:8px">{{ real_rate_chart | safe }}</div>
      <div class="sub faint">{{ t('US 10y real yield is the dollar\'s structural anchor (rising real yields tend to support the USD — coincident, not a forecast).', '美国10年期实际收益率是美元的结构性锚（实际收益率上行通常支撑美元 — 同步关系，非预测）。') }}</div>{% endif %}
    </div>
  </div>

  {% if desk %}
  <div class="card" style="margin-bottom:18px">
    <h2>{{ t('Dollar signal stack', '美元信号栈') }} <span class="faint">· {{ t('all display-only context — never scored', '皆为展示性背景 — 从不评分') }}</span></h2>
    <div class="desk-grid">
      {% if desk.real_rate %}{% set r = desk.real_rate %}
      <div class="desk-tile">
