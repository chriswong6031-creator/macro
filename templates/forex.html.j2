{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro fbar(v) -%}
<div class="fbar"><span class="mid"></span><span class="fill {{ 'pos' if v>=0 else 'neg' }}" style="width:{{ (v*50)|abs|round(1) }}%;{{ 'left:50%' if v>=0 else 'right:50%' }}"></span></div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Forex Vector — {{ as_of }}</title>
{% set seo_title = 'Forex Vector — US Dollar Regime and FX Transmission | Mastermind' %}{% set seo_desc = 'An FX hub tracking the US dollar regime, major currency crosses and how currency moves transmit into equities and macro.' %}{% set seo_path = 'forex.html' %}
{% include "_seo_head.html.j2" %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r1:{{C.r1}}; --r2:{{C.r2}}; --r3:{{C.r3}};
  --r4:{{C.r4}}; --r5:{{C.r5}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --redfill:{{C.redfill}}; --amber:{{C.amber}};
  --green:{{C.green}}; --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280;--r1:#1b2740;--r2:#243352}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-2,.cols-3{grid-template-columns:1fr}}
.board-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(328px,1fr));gap:18px}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px;transition:transform 150ms,box-shadow 150ms}
.card:hover{transform:translateY(-2px);box-shadow:0 6px 24px rgba(0,0,0,.07)}
html[data-theme="dark"] .card:hover{box-shadow:0 6px 24px rgba(0,0,0,.28)}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.brand{font-weight:800;font-size:21px;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.brand .gn{color:var(--blue)}
.lead{color:var(--muted);font-size:14px;margin:0 0 20px}
.sub{font-size:13px;color:var(--muted)}.faint{color:var(--faint)}
.pill{display:inline-block;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#eef1f6;color:var(--ink);margin:2px 4px 2px 0}
html[data-theme="dark"] .pill{background:#222732}
.kpis{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px}
.kpi{font-size:13px;color:var(--muted)}.kpi b{display:block;font-size:18px;color:var(--ink);font-weight:700}
.flag{display:inline-block;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:600;margin-top:10px}
.flag.warn{background:rgba(245,173,66,.14);color:#9a6a10}
.flag.info{background:rgba(40,95,255,.10);color:var(--blue)}
/* ---- section heads ---- */
.section-h{display:flex;align-items:baseline;gap:8px;margin:28px 0 10px;flex-wrap:wrap}
.section-h h2{margin:0;font-size:15px;font-weight:800;color:var(--ink);text-transform:none;letter-spacing:-.01em}
.section-h .eyebrow{color:var(--blue);font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.06em}
.section-h .sh-sub{font-size:12px;color:var(--muted);margin-left:2px}
.sec-head{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em;margin:24px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
/* ---- HERO glass card ---- */
.hero-glass{background:rgba(255,255,255,.72);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--grid);border-radius:20px;padding:28px;box-shadow:0 8px 32px rgba(0,0,0,.06)}
html[data-theme="dark"] .hero-glass{background:rgba(24,27,33,.82);box-shadow:0 8px 32px rgba(0,0,0,.28)}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}}
.hero-eyebrow{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:8px}
.hero-state{font-size:34px;font-weight:800;letter-spacing:-.025em;line-height:1.1;margin:0 0 8px}
.hero-state.tone-usd_up{color:#285FFF;text-shadow:0 0 32px rgba(40,95,255,.22),0 0 8px rgba(40,95,255,.13)}
.hero-state.tone-usd_dn{color:#D30B0B;text-shadow:0 0 32px rgba(211,11,11,.22),0 0 8px rgba(211,11,11,.13)}
.hero-state.tone-mixed{color:#C8A53B;text-shadow:0 0 32px rgba(200,165,59,.22),0 0 8px rgba(200,165,59,.13)}
html[data-theme="dark"] .hero-state.tone-usd_up{text-shadow:0 0 32px rgba(40,95,255,.38),0 0 8px rgba(40,95,255,.22)}
html[data-theme="dark"] .hero-state.tone-usd_dn{text-shadow:0 0 32px rgba(211,11,11,.38),0 0 8px rgba(211,11,11,.22)}
html[data-theme="dark"] .hero-state.tone-mixed{text-shadow:0 0 32px rgba(200,165,59,.38),0 0 8px rgba(200,165,59,.22)}
.stance-chip{display:inline-block;padding:4px 14px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.01em;margin:0 6px 0 0}
.stance-chip.calm{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .stance-chip.calm{background:#222732}
.stance-chip.watch{background:rgba(245,173,66,.16);color:#9a6a10}
.stance-chip.alert{background:rgba(211,11,11,.13);color:var(--red);animation:pulse-alert 2.4s ease-in-out infinite}
@keyframes pulse-alert{0%,100%{opacity:.75}50%{opacity:1}}
@media(prefers-reduced-motion:reduce){.stance-chip.alert{animation:none}.smile-dot{animation:none!important}.smile-path{animation:none!important}}
.hero-sentence{font-size:15px;color:var(--muted);margin:8px 0 0;line-height:1.5}
.hero-kpi-row{display:flex;gap:20px;flex-wrap:wrap;margin-top:14px}
.hkpi{font-size:12.5px;color:var(--muted)}.hkpi b{display:block;font-size:17px;color:var(--ink);font-weight:700}
.hero-badge{display:inline-block;padding:4px 10px;border-radius:8px;font-size:12px;font-weight:600;margin-top:8px;margin-right:6px}
.hero-badge.flash{background:rgba(245,173,66,.14);color:#9a6a10}
.hero-badge.triple{background:rgba(211,11,11,.12);color:var(--red)}
/* ---- dollar smile arc ---- */
.smile-wrap{position:relative}
.smile-svg{width:100%;overflow:visible}
.smile-path{stroke-dasharray:500;stroke-dashoffset:500;animation:draw-smile 1s ease-out forwards}
@keyframes draw-smile{to{stroke-dashoffset:0}}
.smile-dot{animation:breathe 3.2s ease-in-out infinite}
@keyframes breathe{0%,100%{opacity:.55;r:5}50%{opacity:1;r:6.5}}
.smile-labels{position:absolute;top:0;left:0;right:0;bottom:0;pointer-events:none}
.smile-lbl{position:absolute;font-size:11.5px;font-weight:700;color:var(--text);line-height:1.2;white-space:nowrap}
.smile-zone-line{font-size:13px;color:var(--muted);margin-top:8px;text-align:center}
/* ---- sparkline SVG ---- */
.spark-wrap{position:relative}
.spark-svg{width:100%;display:block;overflow:visible}
.spark-legend{display:flex;gap:12px;margin-top:4px;font-size:11px;color:var(--muted)}
.spark-legend span{display:flex;align-items:center;gap:4px}
.spark-legend i{display:inline-block;width:16px;height:2px;border-radius:1px;vertical-align:middle}
/* ---- why tiles rack ---- */
.why-rack{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}
@media(max-width:700px){.why-rack{grid-template-columns:repeat(2,1fr)}}
.why-tile{background:var(--card);border:1px solid var(--grid);border-radius:12px;padding:12px 13px;cursor:default}
.why-tile:hover .tip-pop{opacity:1;pointer-events:auto;transform:translateY(0)}
.wt-lab{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.wt-state{font-size:15px;font-weight:800;color:var(--ink);margin:4px 0 2px}
.wt-state.up{color:var(--green)}.wt-state.down{color:var(--red)}.wt-state.flat{color:var(--muted)}
.wt-q{display:inline-block;width:16px;height:16px;border-radius:50%;background:var(--r1);color:var(--blue);font-size:10px;font-weight:800;text-align:center;line-height:16px;vertical-align:middle;margin-left:4px;cursor:help}
/* ---- tooltip system (B1.6) ---- */
[data-tip-en],[data-tip-zh]{position:relative}
.tip-pop{position:absolute;z-index:99;left:50%;bottom:calc(100% + 6px);transform:translateX(-50%) translateY(4px);background:var(--ink);color:#fff;font-size:11.5px;line-height:1.5;border-radius:8px;padding:7px 11px;min-width:180px;max-width:280px;white-space:normal;pointer-events:none;opacity:0;transition:opacity .15s,transform .15s;box-shadow:0 4px 16px rgba(0,0,0,.22)}
[data-tip-en]:hover .tip-pop,[data-tip-en]:focus .tip-pop,
[data-tip-zh]:hover .tip-pop,[data-tip-zh]:focus .tip-pop{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
/* ---- §2 transmission ---- */
.trans-table{width:100%;border-collapse:collapse}
.trans-table td,.trans-table th{padding:8px 6px;border-bottom:1px solid var(--grid);font-size:13px;vertical-align:middle}
.trans-table th{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);border-bottom:2px solid var(--grid)}
.eff-chip{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:700}
.eff-chip.headwind{background:rgba(211,11,11,.12);color:var(--red)}
.eff-chip.tailwind{background:rgba(26,127,67,.12);color:var(--green)}
.eff-chip.neutral{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .eff-chip.neutral{background:#222732}
.str-bar{height:8px;border-radius:4px;background:var(--grid);overflow:hidden;width:80px;display:inline-block;vertical-align:middle}
.str-bar .fill{height:100%;border-radius:4px;background:var(--indigo)}
.unstable-tag{font-size:10.5px;color:var(--amber);font-weight:700;margin-left:5px}
/* strength meter */
.seg-toggle{display:inline-flex;gap:4px}
.seg-btn{padding:3px 11px;border-radius:999px;font-size:11.5px;font-weight:600;color:var(--muted);background:#eef1f6;border:1px solid var(--grid);cursor:pointer}
.seg-btn.on{background:var(--blue);color:#fff;border-color:var(--blue)}
html[data-theme="dark"] .seg-btn{background:#222732}
.smeter[hidden]{display:none}
.srow{display:grid;grid-template-columns:72px 1fr 60px;align-items:center;gap:12px;margin:6px 0}
.sccy{font-weight:800;color:var(--ink);font-size:13.5px}
.sbar{position:relative;height:16px;background:#eef1f6;border-radius:8px;overflow:hidden}
html[data-theme="dark"] .sbar{background:#222732}
.sbar .smid{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.6}
.sbar .sfill{position:absolute;top:0;bottom:0}
.sbar .sfill.pos{background:var(--green);border-radius:0 8px 8px 0}
.sbar .sfill.neg{background:var(--red);border-radius:8px 0 0 8px}
.spct{text-align:right;font-size:12px;font-variant-numeric:tabular-nums;color:var(--muted)}
/* ---- §3 stress watch ---- */
.stress-dot-strip{display:flex;gap:16px;flex-wrap:wrap;margin:12px 0}
.stress-dot-item{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--text);position:relative;cursor:default}
.sdot{width:10px;height:10px;border-radius:50%;flex:none}
.sdot.quiet{background:var(--faint)}
.sdot.building{background:var(--amber);animation:pulse-dot 1.8s ease-in-out infinite}
.sdot.active{background:var(--red);animation:pulse-dot 1.2s ease-in-out infinite}
@keyframes pulse-dot{0%,100%{opacity:.5}50%{opacity:1}}
@media(prefers-reduced-motion:reduce){.sdot.building,.sdot.active{animation:none}}
.stress-card-active{border-color:var(--red)!important}
.stress-stance{display:inline-block;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:700;background:rgba(211,11,11,.12);color:var(--red);margin-bottom:8px}
.cnh-chip{display:inline-block;padding:4px 11px;border-radius:8px;font-size:12.5px;font-weight:600;margin-top:8px}
.cnh-chip.outflow{background:rgba(211,11,11,.12);color:var(--red)}
.cnh-chip.inflow{background:rgba(26,127,67,.12);color:var(--green)}
/* ---- §4 pairs ---- */
.pair-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap}
.pair-name{font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-.01em}
.pair-nick{font-size:12px;color:var(--muted);margin:2px 0 6px;line-height:1.4;font-style:italic}
.quote{font-size:22px;font-weight:800;color:var(--ink)}
.chg.up{color:var(--green)}.chg.dn{color:var(--red)}
.action-chip{display:inline-block;padding:4px 12px;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.01em;cursor:default}
.action-chip.higher{background:rgba(26,127,67,.13);color:var(--green)}
.action-chip.lower{background:rgba(211,11,11,.12);color:var(--red)}
.action-chip.flat{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .action-chip.flat{background:#222732}
.less-tested{display:inline-block;padding:2px 7px;border-radius:6px;font-size:10.5px;font-weight:700;background:rgba(245,173,66,.14);color:#9a6a10;margin-left:6px}
.pair-headline{font-size:14px;font-weight:600;color:var(--ink);margin:8px 0 6px;line-height:1.4}
.chip-row{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}
.mini-chip{display:inline-block;padding:3px 9px;border-radius:999px;font-size:11.5px;font-weight:600}
.mini-chip.carry{background:rgba(26,127,67,.10);color:var(--green)}
.mini-chip.value-cheap{background:rgba(40,95,255,.10);color:var(--blue)}
.mini-chip.value-rich{background:rgba(211,11,11,.10);color:var(--red)}
.mini-chip.value-fair{background:#eef1f6;color:var(--muted)}
html[data-theme="dark"] .mini-chip.value-fair{background:#222732}
.mini-chip.mtf{background:rgba(69,89,220,.10);color:var(--indigo)}
.factor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px}
.factor-cell{font-size:11.5px;padding:5px 7px;border-radius:8px;background:#f6f8fc;border:1px solid var(--grid)}
html[data-theme="dark"] .factor-cell{background:#11151c}
.factor-cell .fc-label{color:var(--muted);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.03em;margin-bottom:2px}
.factor-cell .fc-dir{font-size:15px;font-weight:800}
.fc-dir.for{color:var(--green)}.fc-dir.against{color:var(--red)}.fc-dir.flat{color:var(--muted)}
.peg-note{display:inline-block;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:700;background:rgba(245,173,66,.14);color:#9a6a10;margin-top:6px}
.cnh-basis{margin:8px 0;padding:7px 10px;border-radius:8px;font-size:12.5px;background:#eef1f6}
html[data-theme="dark"] .cnh-basis{background:#222732}
.cnh-basis.s-outflow_stress{background:rgba(211,11,11,.10)}
.cnh-basis.s-inflow{background:rgba(26,127,67,.10)}
/* ---- §5 scoreboard & recent ---- */
.sc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(305px,1fr));gap:16px;margin-top:6px}
.sc-card{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:18px}
.sc-name{font-size:16px;font-weight:800;color:var(--ink)}
.sc-verdict{font-size:13px;color:var(--text);margin:4px 0 8px;line-height:1.5}
.sc-tilt{font-size:12px;color:var(--muted);margin-top:6px}
/* legacy scorecard support */
.sc-met{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:8px 0}
.sc-met .m{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.sc-met .m b{display:block;font-size:16px;color:var(--ink);font-weight:800;margin-top:2px}
.sc-split{font-size:12px;margin-top:8px}
.sc-split .sr{display:grid;grid-template-columns:54px 1fr 1fr 1fr;gap:6px;padding:3px 0;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums}
.sc-split .sr.h{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.03em;border:none}
.sc-pos{color:var(--green);font-weight:700}.sc-neg{color:var(--red);font-weight:700}
/* timeline */
.timeline{margin-top:6px}
.tl-day{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 0 4px}
.tl-ev{display:flex;align-items:baseline;gap:10px;padding:6px 0;border-bottom:1px solid var(--grid);font-size:13px}
.tl-type{flex:none;min-width:62px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
.tl-asset{flex:none;min-width:66px;color:var(--muted);font-size:12px}
.tl-head{color:var(--text)}
.tl-ev.is-hidden,.tl-day.is-hidden{display:none}
.tl-more{margin-top:10px;border:1px solid var(--grid);background:var(--card);color:var(--text);border-radius:8px;padding:8px 12px;font-size:12px;font-weight:800;cursor:pointer}
.tl-more .lbl-close{display:none}
.tl-more.open .lbl-open{display:none}
.tl-more.open .lbl-close{display:inline}
.sev-high .tl-type{color:var(--red)}.sev-medium .tl-type{color:#9a6a10}.sev-info .tl-type{color:var(--muted)}
/* tables */
table.tbl{width:100%;border-collapse:collapse;font-size:13px;margin-top:6px}
table.tbl th,table.tbl td{padding:7px 8px;border-bottom:1px solid var(--grid);text-align:right}
table.tbl th:first-child,table.tbl td:first-child{text-align:left}
table.tbl th{color:var(--muted);font-weight:600;font-size:11.5px;text-transform:uppercase;letter-spacing:.03em}
/* footer */
.site-footer{max-width:1180px;margin:30px auto 0;padding:18px 20px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;color:var(--muted);font-size:12.5px}
.honesty-note{font-size:12.5px;color:var(--muted);line-height:1.6;margin-top:8px}
.meta-foot{font-size:11.5px;color:var(--faint);margin-top:8px}
/* sparkline color by chg sign (EN: up=green, dn=red; ZH flipped below) */
.sp-up{color:var(--green)}.sp-dn{color:var(--red)}
/* zh 红涨绿跌 */
html[data-lang="zh"] .chg.up{color:var(--red)}
html[data-lang="zh"] .chg.dn{color:var(--green)}
html[data-lang="zh"] .action-chip.higher{background:rgba(211,11,11,.13);color:var(--red)}
html[data-lang="zh"] .action-chip.lower{background:rgba(26,127,67,.12);color:var(--green)}
html[data-lang="zh"] .eff-chip.headwind{background:rgba(26,127,67,.12);color:var(--green)}
html[data-lang="zh"] .eff-chip.tailwind{background:rgba(211,11,11,.12);color:var(--red)}
html[data-lang="zh"] .sbar .sfill.pos{background:var(--red)}
html[data-lang="zh"] .sbar .sfill.neg{background:var(--green)}
html[data-lang="zh"] .sc-pos{color:var(--red)}
html[data-lang="zh"] .sc-neg{color:var(--green)}
html[data-lang="zh"] .wt-state.up{color:var(--red)}
html[data-lang="zh"] .wt-state.down{color:var(--green)}
html[data-lang="zh"] .fc-dir.for{color:var(--red)}
html[data-lang="zh"] .fc-dir.against{color:var(--green)}
html[data-lang="zh"] .cnh-basis.s-outflow_stress{background:rgba(26,127,67,.10)}
html[data-lang="zh"] .cnh-basis.s-inflow{background:rgba(211,11,11,.10)}
html[data-lang="zh"] .sp-up{color:var(--red)}
html[data-lang="zh"] .sp-dn{color:var(--green)}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav" style="max-width:1180px;margin:18px auto 16px;padding:0 20px">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock — US, China, HK, Canada &amp; more…"
      data-ph-zh="搜索任意股票 — 美股、A 股、港股、加股等…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <div class="brand">💱 Forex <span class="gn">Vector</span></div>
  <p class="lead">
    <span class="l-en">How the dollar is moving and what it's pushing on — context, not trade calls.</span>
    <span class="l-zh">美元走势及其连锁影响 — 仅作背景，非交易建议。</span>
  </p>

  {# =====================================================================
     HERO — "The dollar today"
     ===================================================================== #}
  {% set _stonce = stance if stance else {} %}
  {% set _tone = _stonce.get('tone', 'calm') if _stonce else 'calm' %}
  {# infer hero tone from dollar direction for glow color #}
  {% set _hero_tone = 'usd_up' if (dollar.dollar_dir or '') in ('strengthening','up') else ('usd_dn' if (dollar.dollar_dir or '') in ('weakening','down') else 'mixed') %}

  <div class="hero-glass">
    <div class="hero-grid">
      {# Left: state + stance + KPIs #}
      <div>
        <div class="hero-eyebrow">{{ t('FOREX · ' ~ as_of, 'FOREX · ' ~ as_of) }}</div>
        <div class="hero-state tone-{{ _hero_tone }}">
          <span class="l-en">{{ _stonce.get('headline_en', dollar.regime) }}</span>
          <span class="l-zh">{{ _stonce.get('headline_zh', dollar.regime_zh) }}</span>
        </div>
        <div style="margin:8px 0 0">
          <span class="stance-chip {{ _tone }}">
            <span class="l-en">{{ _stonce.get('word_en', 'Watch — don\'t chase') }}</span>
            <span class="l-zh">{{ _stonce.get('word_zh', '观望，别追') }}</span>
          </span>
        </div>
        <p class="hero-sentence">
          <span class="l-en">{{ _stonce.get('sentence_en', 'The dollar is quiet today.') }}</span>
          <span class="l-zh">{{ _stonce.get('sentence_zh', '美元今日平静。') }}</span>
        </p>
        <div class="hero-kpi-row">
          <div class="hkpi">{{ t('Broad USD', '广义美元') }}<b>{{ dollar.broad or '—' }}</b></div>
          <div class="hkpi">DXY<b class="nb-px" data-sym="DX-Y.NYB" data-mkt="fx">{{ dollar.dxy or '—' }}</b></div>
          <div class="hkpi">{{ t('63d move', '63日走势') }}<b>{{ (dollar.roc or 0)|round(1) }}%</b></div>
          <div class="hkpi">{{ t('Risk mood', '风险情绪') }}<b>{{ t(dollar.risk_word, dollar.risk_word_zh) }}</b></div>
        </div>
        {% if dollar.dollar_day %}<span class="hero-badge flash">⚡ {{ t('Unusually big dollar move today', '美元今日异常大幅波动') }}</span>{% endif %}
        {% if desk and desk.triple_red %}<span class="hero-badge triple">⚑ {{ t('Dollar not acting as a safe haven today', '美元今日未发挥避险作用') }}</span>{% endif %}
      </div>

      {# Right: Dollar Smile arc + sparkline #}
      <div>
        {# Smile x mapping (B1.4): regime → x position in [0,1] #}
        {% set _smile_x_map = {
          'US growth premium': 0.13,
          'US-specific stress': 0.34,
          'Global reflation': 0.50,
          'Neutral': 0.50,
          'Risk-off haven bid': 0.87
        } %}
        {% set _sx = _smile_x_map.get(dollar.regime, 0.50) %}
        {# U-shaped smile: P0=(0,20) CP=(220,190) P2=(440,20) in 440×210 viewBox
           x(t)=440t, so t=_sx; y(t)=20+340*t*(1-t) #}
        {% set _sw = 440 %}{% set _sh = 210 %}
        {% set _t = _sx %}
        {% set _dot_x = _t * _sw %}
        {% set _dot_y = 20 + 340 * _t * (1 - _t) %}
        <div class="smile-wrap" style="min-height:{{ _sh }}px;padding:18px 14px 24px">
          <svg class="smile-svg" viewBox="0 0 {{ _sw }} {{ _sh }}" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {# U-shaped smile curve — quadratic bezier, endpoints top, vertex bottom #}
            <path class="smile-path" d="M 0 20 Q 220 190 440 20"
              fill="none" stroke="{{ C.indigo }}" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>
            {# Zone endpoint dots: left (US boom, top-left), center (calm, bottom), right (world stress, top-right) #}
            <circle cx="0" cy="20" r="5" fill="{{ C.blue }}" opacity="0.6"/>
            <circle cx="220" cy="105" r="5" fill="{{ C.green }}" opacity="0.6"/>
            <circle cx="440" cy="20" r="5" fill="{{ C.red }}" opacity="0.6"/>
            {# State dot with breathing animation — sits ON the curve #}
            <circle class="smile-dot" cx="{{ _dot_x|round(1) }}" cy="{{ _dot_y|round(1) }}"
              r="7" fill="{{ C.indigo }}"
              filter="drop-shadow(0 0 6px {{ C.indigo }}88)"/>
          </svg>
          {# Zone labels as absolute-positioned HTML overlays (NOT svg text — LETHAL) #}
          <div class="smile-labels">
            <div class="smile-lbl" style="left:14px;top:2px">
              <span class="l-en">US booming</span><span class="l-zh">美国强势</span></div>
            <div class="smile-lbl" style="left:50%;bottom:4px;transform:translateX(-50%);text-align:center">
              <span class="l-en">Calm growth</span><span class="l-zh">平静增长</span></div>
            <div class="smile-lbl" style="right:14px;top:2px;text-align:right">
              <span class="l-en">World stressed</span><span class="l-zh">全球避险</span></div>
          </div>
        </div>
        <div class="smile-zone-line">
          {{ t('Why the dollar is here: ', '美元处于此位置的原因：') }}
          <b><span class="l-en">{{ dollar.zone_en or dollar.regime }}</span><span class="l-zh">{{ dollar.zone_zh or dollar.regime_zh }}</span></b>
        </div>

        {# Dollar sparkline (126d, rebased 100) + risk-off series #}
        {# F2: real polyline from hero_spark float arrays #}
        {% set _hs = dollar.hero_spark if dollar and dollar.hero_spark else {} %}
        {% if _hs and _hs.dollar_pts %}
        <div class="spark-wrap" style="margin-top:12px">
          <svg class="spark-svg" viewBox="0 0 {{ _hs.w or 440 }} {{ _hs.h or 60 }}" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {# riskoff as faint 1.5px line behind the dollar line #}
            {% if _hs.riskoff_pts %}
            <polyline points="{{ _hs.riskoff_pts }}" fill="none" stroke="{{ C.muted }}" stroke-width="1.5" opacity="0.45" stroke-linejoin="round" stroke-linecap="round"/>
            {% endif %}
            {# dollar line: 2px indigo #}
            <polyline points="{{ _hs.dollar_pts }}" fill="none" stroke="{{ C.indigo }}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
          </svg>
          <div class="spark-legend">
            <span><i style="background:{{ C.indigo }}"></i> {{ t('Broad USD', '广义美元') }}</span>
            <span><i style="background:{{ C.muted }};opacity:.5"></i> {{ t('Risk-off', '避险') }}</span>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    {# Why tiles rack (4 tiles) #}
    {% if desk %}
    <div class="why-rack">
      {# Tile 1: Real rates — plain words (P4: "Restrictive..." → "High real rates") #}
      {% set _rr = desk.real_rate or {} %}
      {% if _rr.get('regime') %}
        {% set _rr_raw = _rr.regime %}
        {% if 'Restrictive' in _rr_raw or 'Rising' in _rr_raw %}
          {% set _rr_en = 'High real rates' %}{% set _rr_zh = '实际利率偏高' %}
        {% elif 'Easy' in _rr_raw or 'Falling' in _rr_raw %}
          {% set _rr_en = 'Low real rates' %}{% set _rr_zh = '实际利率偏低' %}
        {% else %}
          {% set _rr_en = 'Real rates stable' %}{% set _rr_zh = '实际利率平稳' %}
        {% endif %}
      {% else %}
        {% set _rr_en = '—' %}{% set _rr_zh = '—' %}
      {% endif %}
      <div class="why-tile" tabindex="0" data-tip-en="." data-tip-zh=".">
        <div class="wt-lab">{{ t('Real rates', '实际利率') }}</div>
        <div class="wt-state {{ 'up' if _rr.get('lean') == 'supportive' else ('down' if _rr.get('lean') == 'soft' else 'flat') }}">
          <span class="l-en">{{ _rr_en }}</span><span class="l-zh">{{ _rr_zh }}</span>
        </div>
        <div class="tip-pop">
          <div class="l-en">{{ _rr.get('regime', '—') }} — 10y real yield: {{ _rr.get('real_yield', '—') }}%{% if desk.fed_path %} · Fed path {{ desk.fed_path.get('path_bps', 0)|round|int }}bp priced to 12m{% endif %}{% if desk.positioning %} · Futures-market positioning {{ desk.positioning.get('state', '—').replace('_',' ') }}{% endif %}</div>
          <div class="l-zh">{{ _rr.get('regime_zh', _rr.get('regime', '—')) }} — 10年实际收益率：{{ _rr.get('real_yield', '—') }}%{% if desk.fed_path %} · 美联储路径12个月定价{{ desk.fed_path.get('path_bps', 0)|round|int }}bp{% endif %}{% if desk.positioning %} · 期货市场持仓{{ desk.positioning.get('state', '').replace('crowded_long','拥挤做多').replace('crowded_short','拥挤做空').replace('neutral','中性') }}{% endif %}</div>
        </div>
      </div>
      {# Tile 2: Trend — plain words from n_up/4 map (P4) #}
      {% set _trd = desk.trend or {} %}
      {% set _nup = _trd.get('n_up') %}
      {% set _ntot = _trd.get('n_tot', 4) %}
      {% if _nup is not none %}
        {% if _nup == 4 %}{% set _trd_en = 'Rising on all horizons' %}{% set _trd_zh = '全线上行' %}
        {% elif _nup == 3 %}{% set _trd_en = 'Mostly rising' %}{% set _trd_zh = '大多上行' %}
        {% elif _nup == 2 %}{% set _trd_en = 'Mixed' %}{% set _trd_zh = '涨跌互现' %}
        {% elif _nup == 1 %}{% set _trd_en = 'Mostly falling' %}{% set _trd_zh = '大多下行' %}
        {% else %}{% set _trd_en = 'Falling on all horizons' %}{% set _trd_zh = '全线下行' %}
        {% endif %}
      {% else %}{% set _trd_en = '—' %}{% set _trd_zh = '—' %}{% endif %}
      <div class="why-tile" tabindex="0" data-tip-en="." data-tip-zh=".">
        <div class="wt-lab">{{ t('Trend', '趋势') }}</div>
        <div class="wt-state {{ 'up' if (_nup or 0) >= 3 else ('down' if (_nup is not none and _nup <= 1) else 'flat') }}">
          <span class="l-en">{{ _trd_en }}</span><span class="l-zh">{{ _trd_zh }}</span>
        </div>
        <div class="tip-pop">
          <div class="l-en">{{ _nup or '—' }}/{{ _ntot }} trend horizons up. Broad-dollar trailing momentum at multiple lookbacks.</div>
          <div class="l-zh">{{ _nup or '—' }}/{{ _ntot }}个趋势周期上行。广义美元多周期追踪动量。</div>
        </div>
      </div>
      {# Tile 3: Value (REER) #}
      {% set _va = desk.valuation or {} %}
      <div class="why-tile" tabindex="0" data-tip-en="." data-tip-zh=".">
        <div class="wt-lab">{{ t('Value', '估值') }}</div>
        <div class="wt-state {{ 'down' if _va.get('label') == 'rich' else ('up' if _va.get('label') == 'cheap' else 'flat') }}">
          {% if _va.get('label') == 'rich' %}{{ t('Rich vs history', '偏贵') }}
          {% elif _va.get('label') == 'cheap' %}{{ t('Cheap vs history', '偏低') }}
          {% elif _va.get('label') == 'fair' %}{{ t('Fair', '合理') }}
          {% else %}{{ t('—', '—') }}{% endif %}
        </div>
        <div class="tip-pop">
          <div class="l-en">REER gap {% if _va.get('gap_pct') is not none %}{{ '%+.1f'|format(_va.gap_pct) }}% vs 5y mean{% else %}unavailable{% endif %}. Rich = dollar stretched above fair value, historically mean-reverts slowly.</div>
          <div class="l-zh">REER偏离{% if _va.get('gap_pct') is not none %}{{ '%+.1f'|format(_va.gap_pct) }}%（相对5年均值）{% else %}暂无数据{% endif %}。偏贵=美元高于公允价值，历史上缓慢回归。</div>
        </div>
      </div>
      {# Tile 4: Liquidity — "Draining"→"Tightening" amber/neutral (P4) #}
      {% set _lq = desk.liquidity or {} %}
      <div class="why-tile" tabindex="0" data-tip-en="." data-tip-zh=".">
        <div class="wt-lab">{{ t('Liquidity', '流动性') }}</div>
        <div class="wt-state {{ 'up' if _lq.get('dir') == 'supportive' else 'flat' }}">
          {% if _lq.get('dir') == 'supportive' %}{{ t('Adding', '净投放') }}
          {% elif _lq.get('dir') in ('soft', 'draining') %}{{ t('Tightening', '净收紧') }}
          {% elif _lq.get('dir') %}{{ t('Neutral', '中性') }}
          {% else %}{{ t('—', '—') }}{% endif %}
        </div>
        <div class="tip-pop">
          <div class="l-en">Net Fed liquidity falling — tends to support the dollar.{% if _lq.get('net_chg_bn') is not none %} Net change: {{ '%+g'|format(_lq.net_chg_bn) }}B / {{ _lq.get('window_d', '?') }}d.{% endif %}</div>
          <div class="l-zh">美联储净流动性下降 — 往往支撑美元。{% if _lq.get('net_chg_bn') is not none %}净变化：{{ '%+g'|format(_lq.net_chg_bn) }}B / {{ _lq.get('window_d', '?') }}天。{% endif %}</div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>

  {# =====================================================================
     §2 — What the dollar is pushing on
     ===================================================================== #}
  {% if transmission and transmission.rows %}
  <div class="section-h">
    <h2>{{ t('Dollar ripple effects', '美元连锁影响') }}</h2>
  </div>
  <p class="sub" style="margin:0 0 12px">{{ t('Moves together day to day — context, not a forecast.', '日内联动 — 背景参考，非预测。') }}</p>
  <div class="card">
    <table class="trans-table">
      <thead>
        <tr>
          <th style="text-align:left">{{ t('Asset', '资产') }}</th>
          <th>{{ t('If USD rises', '若美元上涨') }}</th>
          <th>{{ t('Strength', '联动强度') }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      {% for r in transmission.rows %}
        <tr>
          <td style="font-weight:700;color:var(--ink)">
            {# Plain asset names (B1.5) #}
            {% set _anames = {'SPY': ('US stocks','美股'), 'EEM': ('EM stocks','新兴市场股票'),
              'GC=F': ('Gold','黄金'), 'CL=F': ('Oil','原油'), 'HG=F': ('Copper','铜'),
              'UST10': ('US bonds (10y)','美债(10年)'), 'BTC': ('Bitcoin','比特币')} %}
            {% set _an = _anames.get(r.key, (r.label, r.get('label_zh', r.label))) %}
            <span class="l-en">{{ _an[0] }}</span><span class="l-zh">{{ _an[1] }}</span>
            {% if r.unstable %}<span class="unstable-tag">{{ t('less reliable lately', '近期不稳定') }}</span>{% endif %}
          </td>
          <td>
            {% set _eff = r.effect or 'neutral' %}
            <span class="eff-chip {{ _eff }}" tabindex="0"
              data-tip-en="." data-tip-zh=".">
              {% if _eff == 'headwind' %}{{ t('Leaning on it', '压制中') }}
              {% elif _eff == 'tailwind' %}{{ t('Giving it a lift', '提振中') }}
              {% else %}{{ t('Not linked now', '暂无联动') }}{% endif %}
              <div class="tip-pop">
                {# D7: plain EN tip — map stability enums to plain words #}
                {% set _stab_en = {'stable':'steady','flipping':'flipping','decoupled':'decoupled'} %}
                <div class="l-en">Moves together over {{ transmission.fast_d }} days: {{ '%+.2f'|format(r.corr_fast) if r.corr_fast is not none else '—' }} ({{ transmission.slow_d }} days: {{ '%+.2f'|format(r.corr_slow) if r.corr_slow is not none else '—' }}) · link: {{ _stab_en.get(r.stability, r.stability or '—') }}</div>
                <div class="l-zh">{{ transmission.fast_d }}日相关：{{ '%+.2f'|format(r.corr_fast) if r.corr_fast is not none else '—' }} · {{ transmission.slow_d }}日：{{ '%+.2f'|format(r.corr_slow) if r.corr_slow is not none else '—' }} · 稳定性：{{ {'stable':'稳定','flipping':'翻转','decoupled':'脱钩'}.get(r.stability, r.stability or '—') }}</div>
              </div>
            </span>
          </td>
          <td>
            <div class="str-bar" aria-hidden="true">
              <div class="fill" style="width:{{ ((r.corr_fast or 0)|abs * 100)|round(0)|int }}%"></div>
            </div>
          </td>
          <td></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  {# Currencies now — strength meter (collapsed sub-strip) #}
  {% if strength and strength.horizons %}
  <details style="margin-top:12px">
    <summary style="cursor:pointer;font-size:13px;font-weight:700;color:var(--muted);list-style:none;display:flex;align-items:center;gap:8px">
      <span>▸</span> {{ t('Currencies now — relative strength', '当前货币强弱') }}
      <div class="seg-toggle" id="strength-toggle" style="margin-left:auto" onclick="event.stopPropagation()">
        {% for hk in strength.order %}<button class="seg-btn {{ 'on' if hk==strength.default else '' }}" data-h="{{ hk }}">{{ hk }}</button>{% endfor %}
      </div>
    </summary>
    <div class="card" style="margin-top:8px">
      {% for hk, rows in strength.horizons.items() %}
      <div class="smeter" data-h="{{ hk }}" {% if hk != strength.default %}hidden{% endif %}>
        {% for r in rows %}
        <div class="srow">
          <div class="sccy">{{ r.ccy }}</div>
          <div class="sbar"><span class="smid"></span><span class="sfill {{ 'pos' if r.strength>=0 else 'neg' }}" style="width:{{ (r.strength*50)|abs|round(1) }}%;{{ 'left:50%' if r.strength>=0 else 'right:50%' }}"></span></div>
          <div class="spct">{{ '%+.1f'|format(r.vs_usd_pct) }}%</div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
      <div class="sub faint" style="margin-top:6px">{{ t('Trailing strength vs average currency. Green does not mean buy.', '相对平均货币的近端强弱。绿色不代表买入。') }}</div>
    </div>
  </details>
  {% endif %}
  {% endif %}

  {# =====================================================================
     §3 — Stress watch
     ===================================================================== #}
  {% if regime and regime.scenarios %}
  <div class="section-h">
    <h2>{{ t('Stress watch', '风险预警') }}</h2>
  </div>
  {% set _active_scns = regime.scenarios | selectattr('active') | list %}
  {% set _building_scns = regime.scenarios | selectattr('intensity_today', 'ge', 40) | list %}

  {% if not _active_scns %}
  {# Quiet state — dot strip #}
  <div class="card">
    <p class="sub" style="margin:0 0 12px">{{ t('Nothing flashing — six stress patterns quiet.', '暂无预警 — 六种压力情景均平静。') }}</p>
    <div class="stress-dot-strip">
      {% for s in regime.scenarios %}
      {% set _ds = 'active' if s.active else ('building' if s.intensity_today >= 40 else 'quiet') %}
      {# Plain scenario names (B1.5) #}
      {% set _sn_map = {
        'carry_unwind': ('Carry-trade unwind','套息平仓'),
        'dollar_wrecking_ball': ('Dollar squeeze','美元挤压'),
        'em_crisis_capital_flight': ('EM outflows','新兴市场资金外流'),
        'haven_flight_risk_off': ('Flight to safety','避险出逃'),
        'reflation_risk_on': ('Risk-on rally','风险偏好回升'),
        'intervention_risk': ('Intervention watch','干预关注')
      } %}
      {% set _sn = _sn_map.get(s.key, (s.name_en, s.name_zh)) %}
      <div class="stress-dot-item" tabindex="0" data-tip-en="." data-tip-zh=".">
        <span class="sdot {{ _ds }}"></span>
        <span><span class="l-en">{{ _sn[0] }}</span><span class="l-zh">{{ _sn[1] }}</span></span>
        <div class="tip-pop">
          {% set _p = s.prob or {} %}
          {% if _p.status == 'ok' %}
          {# D10: when rounded rate is 0, render "fewer than 1 in 10"/「不到一成」 #}
          {% set _rate_n = (_p.p_cond * 10)|round|int if _p.p_cond is not none else none %}
          {% set _rate_en = 'fewer than 1 in 10' if (_rate_n is not none and _rate_n == 0) else ('≈' ~ _rate_n ~ ' in 10' if _rate_n is not none else '?') %}
          {% set _rate_zh = '不到一成' if (_rate_n is not none and _rate_n == 0) else ('约' ~ _rate_n ~ '/10' if _rate_n is not none else '?') %}
          <div class="l-en">{{ _sn[0] }}: intensity {{ s.intensity_today|round|int }}%. In {{ _p.n_raw or 0 }} similar past days, {{ _rate_en }} saw the adverse move within {{ _p.N or '?' }}d (history is thin — wide uncertainty).{% if s.illustrative %} Pattern illustrative — managed market.{% endif %}</div>
          <div class="l-zh">{{ _sn[1] }}：强度{{ s.intensity_today|round|int }}%。在{{ _p.n_raw or 0 }}个类似历史日中，{{ _rate_zh }}在{{ _p.N or '?' }}天内出现不利走势（历史样本薄，不确定性宽）。{% if s.illustrative %} 情景示意 — 受管理市场。{% endif %}</div>
          {% else %}
          <div class="l-en">{{ _sn[0] }}: intensity {{ s.intensity_today|round|int }}%. Insufficient past cases to estimate frequency.</div>
          <div class="l-zh">{{ _sn[1] }}：强度{{ s.intensity_today|round|int }}%。历史案例不足，无法估计频率。</div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {# CNH basis chip when non-neutral #}
    {% set _cnh_df = pairs | selectattr('key', 'eq', 'USDCNH') | first | default(none) %}
    {% if _cnh_df and _cnh_df.cnh_state and _cnh_df.cnh_state != 'neutral' %}
    <div class="cnh-chip {{ 'outflow' if _cnh_df.cnh_state == 'outflow_stress' else 'inflow' }}">
      {% if _cnh_df.cnh_state == 'outflow_stress' %}
        {{ t('Money pressure out of China: ' ~ (_cnh_df.cnh_basis|string) ~ ' bps offshore gap',
             '资金流出中国压力：离岸价差 ' ~ (_cnh_df.cnh_basis|string) ~ ' 个基点') }}
      {% else %}
        {{ t('Money flowing into China: ' ~ (_cnh_df.cnh_basis|string) ~ ' bps offshore gap',
             '资金流入中国：离岸价差 ' ~ (_cnh_df.cnh_basis|string) ~ ' 个基点') }}
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% else %}
  {# Active state — expanded cards #}
  <div class="board-grid">
  {% for s in regime.scenarios %}
  {% set _ds = 'active' if s.active else ('building' if s.intensity_today >= 40 else 'quiet') %}
  {% set _sn_map = {
    'carry_unwind': ('Carry-trade unwind','套息平仓'),
    'dollar_wrecking_ball': ('Dollar squeeze','美元挤压'),
    'em_crisis_capital_flight': ('EM outflows','新兴市场资金外流'),
    'haven_flight_risk_off': ('Flight to safety','避险出逃'),
    'reflation_risk_on': ('Risk-on rally','风险偏好回升'),
    'intervention_risk': ('Intervention watch','干预关注')
  } %}
  {% set _sn = _sn_map.get(s.key, (s.name_en, s.name_zh)) %}
  <div class="card {{ 'stress-card-active' if s.active else '' }}">
    <div class="pair-head">
      <div>
        <span class="sdot {{ _ds }}" style="display:inline-block;margin-right:6px;vertical-align:middle"></span>
        <span style="font-size:16px;font-weight:800;color:var(--ink)"><span class="l-en">{{ _sn[0] }}</span><span class="l-zh">{{ _sn[1] }}</span></span>
      </div>
      <div style="text-align:right;font-size:22px;font-weight:800;color:{{ C.red if s.intensity_today >= 65 else (C.amber if s.intensity_today >= 40 else C.muted) }}">
        {{ s.intensity_today|round|int }}<span style="font-size:11px;color:var(--muted)">/100</span>
      </div>
    </div>
    {% if s.active %}
    <div style="margin:8px 0"><span class="stress-stance">{{ t('Get ready', '做好准备') }}</span></div>
    {% endif %}
    {% set _p = s.prob or {} %}
    {% if _p.status == 'ok' %}
    {# D10: when rounded rate is 0, render "fewer than 1 in 10"/「不到一成」 #}
    {% set _rate_n2 = (_p.p_cond * 10)|round|int if _p.p_cond is not none else none %}
    {% set _rate_en2 = 'fewer than 1 in 10' if (_rate_n2 is not none and _rate_n2 == 0) else ('≈' ~ _rate_n2 ~ ' in 10' if _rate_n2 is not none else '?') %}
    {% set _rate_zh2 = '不到一成' if (_rate_n2 is not none and _rate_n2 == 0) else ('约' ~ _rate_n2 ~ '/10' if _rate_n2 is not none else '?') %}
    <p class="sub" style="margin:8px 0">
      <span class="l-en">In {{ _p.n_raw or 0 }} similar past days, {{ _rate_en2 }} saw the adverse move within {{ _p.N or '?' }}d (history is thin — wide uncertainty).</span>
      <span class="l-zh">在{{ _p.n_raw or 0 }}个类似历史日中，{{ _rate_zh2 }}在{{ _p.N or '?' }}天内出现不利走势（历史样本薄，不确定性宽）。</span>
    </p>
    {% endif %}
    {% if s.illustrative %}
    <p class="sub faint" style="margin:4px 0">{{ t('Pattern illustrative — managed market.', '情景示意 — 受管理市场。') }}</p>
    {% endif %}
  </div>
  {% endfor %}
  </div>
  {% endif %}
  {% endif %}

  {# =====================================================================
     §4 — The pairs
     ===================================================================== #}
  <div class="section-h">
    <h2>{{ t('The pairs', '货币对') }}</h2>
    {# D6: subtitle #}
    <span class="sh-sub"><span class="l-en">Leans are context, not trade calls.</span><span class="l-zh">倾向仅作背景，非交易建议。</span></span>
  </div>
  {# Pair nicknames (B1.5) #}
  {% set _nick_map = {
    'EURUSD': ("The world's most traded pair", '全球交易量最大货币对'),
    'USDJPY': ('The funding currency — moves fast in panics', '融资货币 — 恐慌时波动剧烈'),
    'GBPUSD': ('UK rates and fiscal mood', '英国利率与财政情绪'),
    'USDCHF': ('The quiet haven', '低调避险'),
    'AUDUSD': ('The China-growth barometer', '中国增长晴雨表'),
    'USDCAD': ('The oil currency', '石油货币'),
    'USDCNH': ('Beijing-managed — watched for stress', '北京管理 — 关注压力信号'),
    'USDMXN': ('High-carry EM bellwether', '高息新兴市场风向标'),
    'USDBRL': ('Commodity-linked carry', '商品挂钩套息')
  } %}
  {# Group labels #}
  {% set _group_labels = {
    'major': ('The majors', '主要货币对'),
    'commodity-dollar': ('Commodity currencies', '商品货币'),
    'haven-funder': ('Safe havens', '避险货币'),
    'em': ('Emerging markets', '新兴市场')
  } %}
  {% for sec in sections %}
  {% set _gk = 'em' if sec.label == 'Emerging markets' else ('commodity-dollar' if 'Commodity' in sec.label else ('haven-funder' if 'Haven' in sec.label else 'major')) %}
  {% set _gl = _group_labels.get(_gk, (sec.label, sec.zh)) %}
  <div class="sec-head">
    <span class="l-en">{{ _gl[0] }}</span><span class="l-zh">{{ _gl[1] }}</span>
    <span class="faint"> · {{ sec.pairs|length }}</span>
  </div>
  <div class="board-grid">
  {% for p in sec.pairs %}{% set c = p.conviction %}
    <div class="card">
      <div class="pair-head">
        <div>
          <div class="pair-name">{{ t(p.label, p.zh) }}</div>
          {# Nickname line (replaces arch line) #}
          {% set _nick = _nick_map.get(p.key, (p.arch, p.arch_zh)) %}
          <div class="pair-nick"><em><span class="l-en">{{ _nick[0] }}</span><span class="l-zh">{{ _nick[1] }}</span></em></div>
        </div>
        <div style="text-align:right">
          <div class="quote nb-px" data-sym="{{ p.key }}=X" data-mkt="fx">{{ p.quote }}</div>
          <div class="chg {{ 'up' if (p.chg or 0)>=0 else 'dn' }}">{{ '%+.1f'|format(p.chg) }}% <span class="faint">/ 1mo</span></div>
        </div>
      </div>

      {# Plain action chip + less-tested tag #}
      {% if c %}
      {% set _action_css = 'higher' if c.action in ('STRONG LONG','LONG') else ('lower' if c.action in ('SHORT','STRONG SHORT') else 'flat') %}
      {% set _action_en = 'Leaning higher' if c.action in ('STRONG LONG','LONG') else ('Leaning lower' if c.action in ('SHORT','STRONG SHORT') else 'No clear lean') %}
      {% set _action_zh = '倾向走高' if c.action in ('STRONG LONG','LONG') else ('倾向走低' if c.action in ('SHORT','STRONG SHORT') else '无明显倾向') %}
      <div style="margin:8px 0">
        <span class="action-chip {{ _action_css }}" tabindex="0" data-tip-en="." data-tip-zh=".">
          <span class="l-en">{{ _action_en }}</span><span class="l-zh">{{ _action_zh }}</span>
          <div class="tip-pop">
            <div class="l-en">Model lean {{ c.score|round|int }} of ±100, confidence {{ (c.confidence*100)|round|int }}% — measured on past data, shown for context.</div>
            <div class="l-zh">模型倾向{{ c.score|round|int }}（±100范围），信心{{ (c.confidence*100)|round|int }}% — 基于历史数据测算，仅作背景。</div>
          </div>
        </span>
        {% if not (c.reliable | default(false)) %}<span class="less-tested"><span class="l-en">less tested</span><span class="l-zh">检验不足</span></span>{% endif %}
      </div>

      {% endif %}

      {# SVG sparkline (126d) — F2: real polyline from spark_pts; color by 1mo chg sign #}
      {% if p.spark_pts %}
      {% set _sp_cls = 'sp-up' if (p.chg or 0) >= 0 else 'sp-dn' %}
      <svg viewBox="0 0 300 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;display:block;margin:6px 0" class="{{ _sp_cls }}">
        <polyline points="{{ p.spark_pts }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
      {% endif %}

      {# Compact chips row: carry, value, MTF grade #}
      {% if c %}
      <div class="chip-row">
        {# carry chip (if available and not context) #}
        {% if not p.carry_context and p.carry_diff is not none %}
          {# D1: drop the manual '+' sign — '%+.1f' already carries the sign; double-plus was a bug #}
          <span class="mini-chip carry" tabindex="0" data-tip-en="." data-tip-zh=".">
            {{ t('Paid to hold: ' ~ '%+.1f'|format(p.carry_diff) ~ '%/yr',
                 '持有有息：' ~ '%+.1f'|format(p.carry_diff) ~ '%/年') }}
            <div class="tip-pop">
              <div class="l-en">Interest-rate edge (carry): {{ '%+.2f'|format(p.carry_diff) }}% annualised. Carry/vol: {{ p.carry_to_vol or '—' }}.</div>
              <div class="l-zh">利差优势（套息）：{{ '%+.2f'|format(p.carry_diff) }}%年化。套息/波动：{{ p.carry_to_vol or '—' }}。</div>
            </div>
          </span>
        {% endif %}
        {# value chip from REER gap #}
        {% if p.reer_gap is not none %}
          {% set _val_class = 'value-cheap' if p.reer_gap < -5 else ('value-rich' if p.reer_gap > 5 else 'value-fair') %}
          {% set _val_en = 'Cheap vs history' if p.reer_gap < -5 else ('Rich' if p.reer_gap > 5 else 'Fair') %}
          {% set _val_zh = '相对历史偏低' if p.reer_gap < -5 else ('偏高' if p.reer_gap > 5 else '合理') %}
          <span class="mini-chip {{ _val_class }}" tabindex="0" data-tip-en="." data-tip-zh=".">
            <span class="l-en">{{ _val_en }}</span><span class="l-zh">{{ _val_zh }}</span>
            <div class="tip-pop">
              <div class="l-en">Cheap or rich vs 5y REER history: {{ '%+.1f'|format(p.reer_gap) }}% gap.</div>
              <div class="l-zh">相对5年REER历史的估值偏离：{{ '%+.1f'|format(p.reer_gap) }}%。</div>
            </div>
          </span>
        {% endif %}
        {# MTF grade #}
        {% if p.verdict and p.verdict.grade %}
          {# D3: map raw grade enums to sentence-case plain words for the chip label #}
          {% set _grade_plain = {
            'CAUTION': 'Caution', 'AVOID': 'Avoid',
            'BUY-THE-DIP': 'Buy the dip', 'TREND-FOLLOW': 'Follow the trend'
          } %}
          {% set _grade_display = _grade_plain.get(p.verdict.grade, p.verdict.grade) %}
          <span class="mini-chip mtf" tabindex="0" data-tip-en="." data-tip-zh=".">
            <span class="l-en">{{ _grade_display }}</span><span class="l-zh">{{ p.verdict.grade_zh or p.verdict.grade }}</span>
            <div class="tip-pop">
              <div class="l-en">Multi-timeframe grade: {{ p.verdict.grade }}{% if p.verdict.headline %} — {{ p.verdict.headline }}{% endif %}. Technical timing overlay only; not a return-checked signal.</div>
              <div class="l-zh">多周期评级：{{ p.verdict.grade_zh or p.verdict.grade }}{% if p.verdict.headline_zh %} — {{ p.verdict.headline_zh }}{% endif %}。仅为技术择时叠加，非经收益验证。</div>
            </div>
          </span>
        {% endif %}
      </div>
      {% endif %}

      {# CNH basis line on the CNH card #}
      {% if p.cnh_basis is not none %}
      <div class="cnh-basis s-{{ p.cnh_state or 'neutral' }}">
        <b>{{ t('Offshore–onshore CNH basis', '离岸–在岸人民币基差') }}:</b> {{ '%+.0f'|format(p.cnh_basis) }} bps —
        {% if p.cnh_state == 'outflow_stress' %}{{ t('offshore yuan notably weaker than the onshore fix.', '离岸人民币明显弱于在岸中间价。') }}
        {% elif p.cnh_state == 'inflow' %}{{ t('offshore yuan stronger than onshore — inflow signal.', '离岸人民币强于在岸 — 资金流入信号。') }}
        {% else %}{{ t('broadly aligned with the onshore fix.', '与在岸中间价大体一致。') }}{% endif %}
      </div>
      {% endif %}

      {# Factor reads as a 3-col mini-grid (B1.4) #}
      {% if c and c.factors %}
      <div class="factor-grid">
      {# Plain factor labels (B1.5) #}
      {% set _flbl = {
        'trend': ('Its own trend','自身趋势'),
        'structure': ('Chart structure','形态结构'),
        'carry': ('Interest-rate edge','利差优势'),
        'rates': ('Long-rate gap','长端利差'),
        'value': ('Cheap or rich','估值高低'),
        'riskoff': ('Risk mood','风险情绪'),
        'positioning': ('Trader crowding','持仓拥挤度'),
        'risk': ('Choppiness','波动风险'),
        'shock': ('Sudden shocks','突发冲击')
      } %}
      {% for r in c.factors %}
      {% set _fl = _flbl.get(r.key, (r.label, r.get('label_zh', r.label))) %}
      {% set _dir = 'for' if r.value > 0.1 else ('against' if r.value < -0.1 else 'flat') %}
      {% set _glyph = '●' if _dir == 'for' else ('○' if _dir == 'against' else '−') %}
      <div class="factor-cell" tabindex="0" data-tip-en="." data-tip-zh=".">
        <div class="fc-label"><span class="l-en">{{ _fl[0] }}</span><span class="l-zh">{{ _fl[1] }}</span></div>
        <div class="fc-dir {{ _dir }}">{{ _glyph }}</div>
        <div class="tip-pop">
          {# D4: show signed CONTRIBUTION (r.contribution), not raw coefficient weight #}
          <div class="l-en">{{ _fl[0] }}: {{ 'for' if _dir == 'for' else ('against' if _dir == 'against' else 'flat/neutral') }}. Pull on the score: {{ '%+.2f'|format(r.contribution) if r.contribution is defined else '—' }}.</div>
          <div class="l-zh">{{ _fl[1] }}：{{ '利多' if _dir == 'for' else ('利空' if _dir == 'against' else '中性') }}。对评分的拉动：{{ '%+.2f'|format(r.contribution) if r.contribution is defined else '—' }}。</div>
        </div>
      </div>
      {% endfor %}
      </div>
      {% endif %}

      {# Peg flag #}
      {% if c and c.peg %}<span class="peg-note">⚑ <span class="l-en">{{ c.peg.note[0] }}</span><span class="l-zh">{{ c.peg.note[1] }}</span></span>{% endif %}
    </div>
  {% endfor %}
  </div>
  {% endfor %}

  {# =====================================================================
     §5 — Do these styles work? / Scorecards + Recent shifts
     ===================================================================== #}
  <div class="section-h">
    <h2>{{ t('Do these styles work?', '这些策略有效吗') }}</h2>
  </div>
  {% if scorecards %}
  {% macro scrow(seg, m) %}<div class="sr"><span>{{ seg }}</span>
    <span class="{{ 'sc-pos' if (m.cagr or 0)>=0 else 'sc-neg' }}">{{ '%+.1f'|format(m.cagr) if m.cagr is not none else '—' }}%</span>
    <span>{{ '%.2f'|format(m.sharpe) if m.sharpe is not none else '—' }}</span>
    <span class="sc-neg">{{ '%.0f'|format(m.maxdd) if m.maxdd is not none else '—' }}%</span></div>{% endmacro %}
  <div class="sc-grid">
    {% for c in scorecards %}
    <div class="sc-card">
      {# P5: at rest — name, one-line verdict, tilt, ? only. Metrics table inside tip-pop. #}
      {% if c.key == 'carry' %}
        <div class="sc-name">{{ t('G10 carry basket', 'G10套息篮子') }}</div>
        {% set _sharpe = c.metrics.full.sharpe %}
        {% if _sharpe is not none and _sharpe >= 0.5 %}
        <div class="sc-verdict">{{ t('Pays slowly; crashes hard in panics.', '平时缓慢获利；恐慌时大幅回撤。') }}</div>
        {% else %}
        <div class="sc-verdict">{{ t('Thin reward for real crash risk.', '回报有限，崩盘风险真实。') }}</div>
        {% endif %}
      {% elif c.key == 'haven' %}
        <div class="sc-name">{{ t('Risk-off haven basket', '避险货币篮子') }}</div>
        <div class="sc-verdict">{{ t('Costs a little most years; pays in a storm.', '平时小亏；风暴时获利。') }}</div>
      {% elif c.key == 'dollar_trend' %}
        <div class="sc-name">{{ t('Dollar trend overlay', '美元趋势叠加') }}</div>
        <div class="sc-verdict">{{ t('A drawdown filter, not a money-maker.', '是回撤过滤器，不是盈利来源。') }}</div>
      {% endif %}
      {# Current tilt in plain words #}
      {% if c.key == 'carry' and c.longs %}
      <div class="sc-tilt">{{ t('Now: long', '当前：做多') }} <b>{{ c.longs|join(' ') }}</b> · {{ t('short', '做空') }} <b>{{ c.shorts|join(' ') }}</b></div>
      {% elif c.key == 'haven' %}
      <div class="sc-tilt">{{ t('Permanent: long havens, short risk currencies.', '长期：持有避险货币，做空风险货币。') }}</div>
      {% elif c.key == 'dollar_trend' %}
      <div class="sc-tilt"><b>{% if c.in_market %}{{ t('Currently long (trend up)', '当前做多（趋势向上）') }}{% else %}{{ t('Currently flat (trend down)', '当前空仓（趋势向下）') }}{% endif %}</b></div>
      {% endif %}
      {# ? tip — all metrics live here (P5) #}
      {% set _fm = c.metrics.full %}
      <span class="wt-q" tabindex="0" data-tip-en="." data-tip-zh=".">?
        <div class="tip-pop" style="min-width:230px">
          <div class="l-en">
            Yearly gain: {{ '%+.1f'|format(_fm.cagr) if _fm.cagr is not none else '—' }}%
            · Gain per unit of swing: {{ '%.2f'|format(_fm.sharpe) if _fm.sharpe is not none else '—' }}
            · Worst fall: {{ '%.0f'|format(_fm.maxdd) if _fm.maxdd is not none else '—' }}%
            {% if c.metrics.pre %}| Pre-2008: {{ '%+.1f'|format(c.metrics.pre.cagr) if c.metrics.pre.cagr is not none else '—' }}% / {{ '%.2f'|format(c.metrics.pre.sharpe) if c.metrics.pre.sharpe is not none else '—' }}{% endif %}
            {% if c.metrics.post %}| Post-2008: {{ '%+.1f'|format(c.metrics.post.cagr) if c.metrics.post.cagr is not none else '—' }}% / {{ '%.2f'|format(c.metrics.post.sharpe) if c.metrics.post.sharpe is not none else '—' }}{% endif %}
            — past data only.
          </div>
          <div class="l-zh">
            年化收益：{{ '%+.1f'|format(_fm.cagr) if _fm.cagr is not none else '—' }}%
            · 单位波动收益：{{ '%.2f'|format(_fm.sharpe) if _fm.sharpe is not none else '—' }}
            · 最大回撤：{{ '%.0f'|format(_fm.maxdd) if _fm.maxdd is not none else '—' }}%
            {% if c.metrics.pre %}| 2008前：{{ '%+.1f'|format(c.metrics.pre.cagr) if c.metrics.pre.cagr is not none else '—' }}% / {{ '%.2f'|format(c.metrics.pre.sharpe) if c.metrics.pre.sharpe is not none else '—' }}{% endif %}
            {% if c.metrics.post %}| 2008后：{{ '%+.1f'|format(c.metrics.post.cagr) if c.metrics.post.cagr is not none else '—' }}% / {{ '%.2f'|format(c.metrics.post.sharpe) if c.metrics.post.sharpe is not none else '—' }}{% endif %}
            — 仅基于历史数据。
          </div>
        </div>
      </span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# Recent shifts — alert timeline #}
  {% if timeline %}
  <div class="section-h">
    <span class="eyebrow">{{ t('RECENT SHIFTS', '近期变化') }}</span>
  </div>
  <div class="card">
    <div class="timeline">
    {% for day in timeline %}
      <div class="tl-day">{{ day.daylabel }}</div>
      {% for e in day.events %}
      <div class="tl-ev sev-{{ e.severity }}" data-tl-event="1">
        {# Plain type labels (D2: COT/positioning events → "Positioning"/「持仓」) #}
        {% set _tlbl = {'residual_shock':'Sudden move','risk_regime':'Choppiness',
          'trend_flip':'Trend','momentum':'Trend','structure':'Chart shape',
          'positioning':'Positioning','carry_flip':'Rate edge',
          'peg_approach':'Intervention','smile_regime':'Dollar regime',
          'cnh_basis':'Yuan','scenario':'Dollar regime',
          'transmission_shift':'Dollar link','dollar_flash':'Dollar flash'} %}
        {% set _tlbl_zh = {'residual_shock':'突然波动','risk_regime':'波动性',
          'trend_flip':'趋势','momentum':'趋势','structure':'形态',
          'positioning':'持仓','carry_flip':'利差',
          'peg_approach':'干预','smile_regime':'美元格局',
          'cnh_basis':'离岸人民币','scenario':'美元格局',
          'transmission_shift':'美元联动','dollar_flash':'美元闪动'} %}
        <span class="tl-type"><span class="l-en">{{ _tlbl.get(e.type, e.label or e.type) }}</span><span class="l-zh">{{ _tlbl_zh.get(e.type, e.type) }}</span></span>
        <span class="tl-asset">{{ e.asset_label }}</span>
        {# D2: map internal regime names + old stored alert strings to plain words #}
        {% set _hl_en = e.headline
          | replace('US growth premium', 'US booming')
          | replace('Risk-off haven bid', 'World stressed')
          | replace('Global reflation', 'Calm growth')
          | replace('US-specific stress', 'US wobble')
          | replace('Neutral', 'In between')
          | replace('COT crowded short', 'Speculators very short')
          | replace('COT crowded long', 'Speculators very long')
          | replace("exogenous bid detected", "buying that the dollar and rates don't explain")
          | replace("exogenous pressure detected", "selling that the dollar and rates don't explain")
          | replace('momentum → bull', 'trend turned up')
          | replace('momentum → bear', 'trend turned down')
          | replace('structure → broken', 'chart shape broke down')
          | replace('structure → constructive', 'chart shape turned constructive') %}
        {% set _hl_zh = e.headline_zh
          | replace('美国增长溢价', '美国强势')
          | replace('避险买盘', '全球避险')
          | replace('全球再通胀', '平静增长')
          | replace('美国自身风险', '美国走弱')
          | replace('外生买盘', '美元与利率无法解释的买盘')
          | replace('外生压力', '美元与利率无法解释的卖压')
          | replace('COT 空头拥挤', '投机者严重做空')
          | replace('COT 多头拥挤', '投机者严重做多') %}
        <span class="tl-head"><span class="l-en">{{ _hl_en }}</span><span class="l-zh">{{ _hl_zh }}</span></span>
      </div>
      {% endfor %}
    {% endfor %}
    </div>
    <button class="tl-more" type="button">
      <span class="lbl-open l-en">See more</span>
      <span class="lbl-open l-zh">查看更多</span>
      <span class="lbl-close l-en">Show less</span>
      <span class="lbl-close l-zh">收起</span>
    </button>
  </div>
  {% endif %}

  {# =====================================================================
     FOOTER — one merged honesty note (B1.6)
     ===================================================================== #}
  <div class="card" style="margin-top:28px">
    <div class="honesty-note">
      <span class="l-en">This page describes today's currency backdrop. It moves with markets and does not predict them; nothing here is a trade recommendation. Pair reads are measured on past data and shown for context.</span>
      <span class="l-zh">本页描述今日货币背景。随市场变化，不预测市场走势；本页内容不构成任何交易建议。货币对读数基于历史数据测算，仅作背景参考。</span>
    </div>
    <div class="meta-foot">{{ t('As of', '截至') }} {{ as_of }} · {{ t('built', '构建于') }} {{ built }} · {{ t('Data', '数据') }} {{ cal_span }}
    {% if not cot_ok %} · <span class="flag info">ℹ {{ t('Futures-market positioning data temporarily unavailable.', '期货市场持仓数据暂不可用。') }}</span>{% endif %}</div>
  </div>
</div>

<script>
/* Currency strength meter — horizon toggle */
(function(){
  var wrap = document.getElementById('strength-toggle');
  if(!wrap) return;
  wrap.addEventListener('click', function(e){
    var btn = e.target.closest('.seg-btn');
    if(!btn) return;
    var h = btn.getAttribute('data-h');
    wrap.querySelectorAll('.seg-btn').forEach(function(b){ b.classList.toggle('on', b===btn); });
    document.querySelectorAll('.smeter').forEach(function(m){ m.hidden = (m.getAttribute('data-h') !== h); });
  });
})();
</script>
<script>
/* Alert timeline expander — P6: uses .lbl-open/.lbl-close + .open class on button */
(function(){
  var card = document.querySelector('.timeline');
  if(!card) return;
  var events = Array.from(card.querySelectorAll('[data-tl-event]'));
  var btn = document.querySelector('.tl-more');
  var limit = 8;
  /* hide close labels initially via CSS: .tl-more .lbl-close{display:none}; .tl-more.open .lbl-open{display:none}; .tl-more.open .lbl-close{display:inline} */
  function sync(open){
    events.forEach(function(ev, i){ ev.classList.toggle('is-hidden', !open && i >= limit); });
    card.querySelectorAll('.tl-day').forEach(function(day){
      var next = day.nextElementSibling, any = false;
      while(next && !next.classList.contains('tl-day')){
        if(next.matches('[data-tl-event]') && !next.classList.contains('is-hidden')) any = true;
        next = next.nextElementSibling;
      }
      day.classList.toggle('is-hidden', !any);
    });
    if(btn) btn.classList.toggle('open', open);
  }
  if(btn && events.length > limit){
    btn.addEventListener('click', function(){ sync(!btn.classList.contains('open')); });
    sync(false);
  } else if(btn) { btn.hidden = true; }
})();
</script>
<script>
/* Bilingual tip system — reads data-tip-en/zh on hover/focus.
   Uses the .tip-pop child div pattern (already in markup).
   This script handles tab/focus and touch. */
(function(){
  var lang = document.documentElement.getAttribute('data-lang') || 'en';
  document.addEventListener('langchange', function(){ lang = document.documentElement.getAttribute('data-lang') || 'en'; });
  /* tip-pop visibility is handled purely by CSS :hover/:focus-within above;
     this script only ensures focus works for keyboard users */
  document.querySelectorAll('[data-tip-en],[data-tip-zh]').forEach(function(el){
    el.addEventListener('keydown', function(e){
      if(e.key === 'Escape'){
        var pop = el.querySelector('.tip-pop');
        if(pop){ pop.style.opacity='0'; pop.style.pointerEvents='none'; }
      }
    });
  });
})();
</script>
