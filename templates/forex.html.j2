    <span class="sh-sub">{{ t('each pair scored on its move AFTER stripping the shared dollar beta — the only calibrated, scored leg', '每个货币对在剥离共同美元贝塔后评分 — 唯一经校准、参与评分的部分') }}</span></div>
  {% for sec in sections %}
