        <div class="dt-lab">{{ t('Valuation (REER)', '估值（REER）') }}</div>
        <div class="dt-val">{{ '%+.1f'|format(v.gap_pct) }}% <span style="font-size:11px;font-weight:600;color:var(--muted)">{{ t('vs 5y mean', '相对5年均值') }}</span></div>
        <div class="dt-sub"><span class="dt-chip {{ v.label }}">{{ t(VALL[v.label][0], VALL[v.label][1]) }}</span>{% if v.stretched %} · <b>{{ t('stretched', '偏离') }}</b>{% endif %}
          {% if v.verdict %}<span class="vg {{ v.verdict|lower }}" title="Split-half forward-IC verdict for the dollar REER value factor (scripts.calibrate_forex). {{ v.verdict }}{% if v.ic_full is not none %} · IC {{ '%+.3f'|format(v.ic_full) }}{% endif %}{% if v.verdict == 'CONFIRMED' and not v.promotable %} — but fails the deflated-Sharpe gate, so display-only{% endif %}">{{ {'CONFIRMED':'✓','INVERTED':'⇄','DIRECTIONAL':'~','CONTEXT':'·','UNMEASURED':'–'}.get(v.verdict,'') }}</span>{% endif %}</div>
        <span class="lead-tag context">{{ t('context · multi-year', '背景 · 多年') }}{% if v.verdict == 'CONFIRMED' %} · {{ t('forward-IC confirmed', '远期IC已确认') }}{% endif %}</span>
      </div>{% endif %}

      {% if desk.trend %}{% set trd = desk.trend %}
      <div class="desk-tile">
        <div class="dt-lab">{{ t('Trend stack (broad USD)', '趋势栈（广义美元）') }}</div>
        <div class="dt-val">{{ trd.n_up }}/{{ trd.n_tot }} <span style="font-size:11px;font-weight:600;color:var(--muted)">{{ t('horizons up', '周期上行') }}</span></div>
        <div class="hstack">{% for h in trd.horizons %}<div class="hbar {{ 'up' if h.up else 'down' }}">{{ h.d }}d<small>{{ '%+.1f'|format(h.roc_pct) }}%</small></div>{% endfor %}</div>
        <span class="lead-tag context">{{ t('context · breadth', '背景 · 广度') }}</span>
      </div>{% endif %}

      {% if desk.liquidity %}{% set l = desk.liquidity %}
      <div class="desk-tile">
        <div class="dt-lab">{{ t('USD liquidity', '美元流动性') }}</div>
        <div class="dt-val">{{ '%+g'|format(l.net_chg_bn) }}B <span style="font-size:11px;font-weight:600;color:var(--muted)">/ {{ l.window_d }}d</span></div>
        <div class="dt-sub">{{ t('net Fed liquidity (WALCL−RRP)', '净美联储流动性（WALCL−RRP）') }} · <span class="dt-chip {{ l.dir }}">{{ t(LEAN[l.dir][0], LEAN[l.dir][1]) }}</span></div>
        <span class="lead-tag context">{{ t('context · slow', '背景 · 缓慢') }}</span>
      </div>{% endif %}

      {% if desk.smile %}{% set s = desk.smile %}
      <div class="desk-tile">
        <div class="dt-lab">{{ t('Smile confirmation', '微笑确认') }}</div>
        <div class="dt-val">{{ t(CONF[s.confidence][0], CONF[s.confidence][1]) }} <span style="font-size:11px;font-weight:600;color:var(--muted)">· {{ s.n_confirm }}/3 {{ t('legs', '项') }}</span></div>
        <div class="dt-sub">{% if s.confirms %}{{ t('confirmed by', '确认于') }} {{ s.confirms|join(', ') }}{% else %}{{ t('no corroborating legs', '无佐证项') }}{% endif %}</div>
        <span class="lead-tag coincident">{{ t('coincident', '同步') }}</span>
      </div>{% endif %}
    </div>
  </div>
  {% endif %}

  <!-- ===================== §1.5 · FX STRESS & REGIME RADAR ===================== -->
  {% if regime and regime.scenarios %}
  <div class="section-h"><span class="sn">§1.5</span><h2>{{ t('FX Stress & Regime Radar', 'FX压力与格局雷达') }}</h2>
    <span class="sh-sub">{{ t('the joint velocity + level configuration of currency moves → named macro scenarios with an empirical historical frequency', '货币速度+水平的联合配置 → 命名宏观情景及经验历史频率') }}</span></div>
  <div style="margin:2px 0 12px"><span class="lead-tag coincident">{{ t('coincident', '同步') }}</span>
    <span class="lead-tag context">{{ t('empirical base rate · display-only / never scored', '经验基率 · 仅供展示/从不评分') }}</span>
    {% if regime.dominant %}<span class="sub" style="margin-left:8px">{{ t('Dominant now:', '当前主导：') }}
      <b>{% for s in regime.scenarios if s.key == regime.dominant %}{{ t(s.name_en, s.name_zh) }}{% endfor %}</b></span>
    {% else %}<span class="sub faint" style="margin-left:8px">{{ t('No scenario active — currency moves are not configured like a known stress regime today.', '当前无激活情景 — 货币走势未呈现已知压力格局。') }}</span>{% endif %}
  </div>
  <div class="board-grid">
  {% for s in regime.scenarios %}
    {% set p = s.prob %}
    {% set ic = (C.red if s.intensity_today >= 65 else (C.amber if s.intensity_today >= 40 else C.muted)) %}
    <div class="card"{% if s.key == regime.dominant %} style="border-color:{{ C.red }}"{% endif %}>
      <div class="pair-head">
        <div>
          <div class="pair-name" style="font-size:16px">{{ t(s.name_en, s.name_zh) }}</div>
          <div class="pair-arch">{{ s.n_fired }}/{{ s.min_legs }}+ {{ t('legs firing', '腿触发') }}
            {% if s.active %}· <span style="color:var(--red);font-weight:800">{{ t('ACTIVE', '激活') }}</span>{% endif %}
            {% if s.key == regime.dominant %}· {{ t('dominant', '主导') }}{% endif %}</div>
        </div>
        <div style="text-align:right">
          <div class="hero-state" style="font-size:30px;color:{{ ic }}">{{ s.intensity_today|round|int }}<span style="font-size:12px;color:var(--muted)">/100</span></div>
          <div class="sub faint">{{ t('stress intensity', '压力强度') }}</div>
        </div>
      </div>

      {# probability block — past-tense empirical frequency, status-aware #}
      <div class="verdict-box" style="margin:12px 0">
        <div class="fgrp" style="margin-top:0">{{ t('Forward analogue from history', '历史远期类比') }}</div>
        {% if p.status == 'ok' %}
        {% set pc = (p.p_cond * 100)|round|int %}{% set br = (p.base_rate * 100)|round|int %}
        <div class="sub">{{ t(
          'On the %d days at least this stressed, %d%% saw the adverse move within %dd — vs a %d%% base rate.'|format(p.n_raw, pc, p.N, br),
          '在%d个至少同等压力的历史日中，%d%%在%d天内出现不利走势 — 而无条件基率为%d%%。'|format(p.n_raw, pc, p.N, br)) }}</div>
        <div class="sub faint" style="margin-top:5px">95% CI {{ (p.wilson_lo*100)|round|int }}–{{ (p.wilson_hi*100)|round|int }}%
          · n={{ p.n_raw }} (n<sub>eff</sub>≈{{ p.n_eff|round(1) }}) · {{ t('lift', '提升') }} {{ '%+.0f'|format(p.abs_lift*100) }}pp
          {% if p.ci_separated %}· <span style="color:var(--green)">{{ t('CIs separate', '区间分离') }}</span>{% else %}· {{ t('CIs overlap — lift not robust', '区间重叠 — 提升不稳健') }}{% endif %}</div>
        {% elif p.status == 'insufficient' %}
        <div class="sub faint">{{ t('Insufficient history at this stress level', '此压力水平历史样本不足') }} (n={{ p.n_raw }}, n<sub>eff</sub>≈{{ p.n_eff|round(1) }}).</div>
        {% elif p.status == 'unprecedented' %}
        <div class="sub faint">{{ t('Unprecedented in the available record', '可得历史中前所未见') }} (n={{ p.n_raw }}).</div>
        {% else %}
        <div class="sub faint">{{ t('Building — warm-up window not yet complete.', '积累中 — 预热窗口尚未完成。') }}</div>
        {% endif %}
        {% if p.base_rate is not none %}<div class="sub faint" style="margin-top:3px">{{ t('Defining outcome', '界定结果') }}: {{ t('adverse move over', '不利走势于') }} {{ p.N }}{{ t('d', '天') }}{% if p.i0_pctile is not none %} · {{ t('today’s stress is at the', '当前压力处于') }} {{ (p.i0_pctile*100)|round|int }}{{ t('th %ile of history', '历史百分位') }}{% endif %}.</div>{% endif %}
        {% if s.illustrative %}<div class="sub faint" style="margin-top:3px">⚑ {{ t('Managed-regime / intervention truncates the distribution — illustrative only.', '受管理体制/干预会截断分布 — 仅供示意。') }}</div>{% endif %}
      </div>

      {# leg readout — velocity + level + cross-currency + risk-driver #}
      <div class="fgrp">{{ t('What’s firing', '触发因素') }}</div>
      {% for leg in s.fired_legs %}
      <div class="frow">
        <span class="flabel">{{ t(leg.en, leg.zh) }}</span>
        {% if leg.value is not none %}{{ fbar(leg.value) }}{% else %}<div class="fbar"><span class="mid"></span></div>{% endif %}
        <span class="fwt">{% if leg.absent %}<span class="faint">n/a</span>{% elif leg.fired %}<span style="color:var(--red)">●</span>{% else %}<span class="faint">○</span>{% endif %}</span>
      </div>
      {% endfor %}
      <div class="framing" style="margin-top:8px">{{ t(s.disc_en, s.disc_zh) }}</div>
    </div>
  {% endfor %}
  </div>

  {# per-currency move kinematics — literal move + velocity + acceleration #}
  {% if kinematics and kinematics.rows %}
  <div class="card" style="margin-top:18px">
    <h2>{{ t('Currency move kinematics', '货币走势动力学') }} <span class="faint">· {{ t('literal move + velocity + acceleration', '实际走势 + 速度 + 加速度') }}</span></h2>
    <table class="tbl">
      <thead><tr>
        <th>{{ t('Currency', '货币') }}</th>
        <th>1d</th><th>5d</th><th>20d</th>
        <th>{{ t('Velocity', '速度') }}</th>
        <th>{{ t('Accel', '加速') }}</th>
        <th>{{ t('Vol %ile', '波动百分位') }}</th>
        <th>{{ t('Ex-$ 5d', '去美元5d') }}</th>
        <th>{{ t('State', '状态') }}</th>
      </tr></thead>
      <tbody>
      {% for r in kinematics.rows %}
        <tr>
          <td><b>{{ r.ccy }}</b> <span class="faint">{{ t(r.label_en, r.label_zh) if r.label_en != r.ccy else '' }}</span></td>
          <td class="{{ 'chg up' if (r.lit_1d_pct or 0) >= 0 else 'chg dn' }}">{{ '%+.1f'|format(r.lit_1d_pct) if r.lit_1d_pct is not none else '—' }}</td>
          <td class="{{ 'chg up' if (r.lit_5d_pct or 0) >= 0 else 'chg dn' }}">{{ '%+.1f'|format(r.lit_5d_pct) if r.lit_5d_pct is not none else '—' }}</td>
          <td class="{{ 'chg up' if (r.lit_20d_pct or 0) >= 0 else 'chg dn' }}">{{ '%+.1f'|format(r.lit_20d_pct) if r.lit_20d_pct is not none else '—' }}</td>
          <td>{{ '%+.1f'|format(r.vel_z) if r.vel_z is not none else '—' }}</td>
          <td>{{ '%+.1f'|format(r.accel_z) if r.accel_z is not none else '—' }}</td>
          <td>{{ (r.rvol_pctile*100)|round|int if r.rvol_pctile is not none else '—' }}</td>
          <td class="{{ 'chg up' if (r.resid_5d_pct or 0) >= 0 else 'chg dn' }}">{{ '%+.1f'|format(r.resid_5d_pct) if r.resid_5d_pct is not none else '—' }}</td>
          <td>{{ t(r.state_en, r.state_zh) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <div class="sub faint" style="margin-top:8px">{{ t('Literal % move (1/5/20d, vs USD), velocity = recent speed in σ-units, acceleration = change in velocity, realized-vol percentile, and the idiosyncratic (ex-dollar residual) 5d move. COINCIDENT and DESCRIPTIVE — a read of how fast each currency is moving, never a forecast or a buy list.', '实际百分比走势（1/5/20天，对美元）、速度=近端走势的σ单位、加速度=速度变化、实现波动率百分位，以及特异（剔除美元残差）的5天走势。同步且描述性 — 衡量每种货币移动速度，绝非预测或买入清单。') }}</div>
  </div>
  {% endif %}
  {% endif %}

  <!-- ===================== §02 · DOLLAR TRANSMISSION ===================== -->
  {% if transmission and transmission.rows %}
  <div class="section-h"><span class="sn">§02</span><h2>{{ t('Dollar transmission — what a stronger/weaker USD pushes on', '美元传导 · 美元强弱推动了什么') }}</h2>
    <span class="sh-sub">{{ t('contemporaneous co-movement, not a forecast', '同步共动，非预测') }}</span></div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Cross-asset co-movement with the broad dollar', '与广义美元的跨资产共动') }}</h2>
      <p class="sub" style="margin:2px 0 8px"><b>{{ t(transmission.read, transmission.read_zh) }}</b></p>
      <table class="tbl">
        <thead><tr>
          <th>{{ t('Asset', '资产') }}</th>
          <th>{{ transmission.fast_d }}d {{ t('corr', '相关') }}</th>
          <th>{{ transmission.slow_d }}d</th>
          <th>{{ t('If USD ↑', '若美元↑') }}</th>
          <th>{{ t('Stability', '稳定性') }}</th>
        </tr></thead>
        <tbody>
        {% for r in transmission.rows %}
          <tr>
            <td>{{ t(r.label, r.label_zh) }}{% if r.real_corr is defined %}<br><span class="tnote">{{ t('real-rate leg', '实际利率项') }} {{ '%+.2f'|format(r.real_corr) }} {{ t('vs Δreal-yield', '对Δ实际收益率') }}</span>{% endif %}{% if r.regime_split is defined %}<br><span class="tnote">{{ t('calm', '平静') }} {{ r.regime_split.get('calm','—') }} · {{ t('stress', '压力') }} {{ r.regime_split.get('stress','—') }}</span>{% endif %}</td>
            <td>{{ '%+.2f'|format(r.corr_fast) if r.corr_fast is not none else '—' }}</td>
            <td>{{ '%+.2f'|format(r.corr_slow) if r.corr_slow is not none else '—' }}</td>
            <td><span class="eff {{ r.effect }}">{% if r.effect=='headwind' %}{{ t('headwind', '逆风') }}{% elif r.effect=='tailwind' %}{{ t('tailwind', '顺风') }}{% else %}{{ t('decoupled', '脱钩') }}{% endif %}</span></td>
            <td><span class="stab {{ r.stability }}"></span>{% if r.stability=='stable' %}{{ t('stable', '稳定') }}{% elif r.stability=='flipping' %}{{ t('flipping', '翻转') }}{% else %}{{ t('decoupled', '脱钩') }}{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="card">
      <h2>{{ t('Correlation to the broad dollar', '与广义美元的相关性') }} <span class="faint">· {{ transmission.fast_d }}d</span></h2>
      {{ transmission.chart | safe }}
      <div class="sub faint" style="margin-top:8px">{{ t('CONTEMPORANEOUS co-movement, not causation or a forecast. Dollar↔asset betas are regime-dependent and unstable — sign flips happen (the dollar move is often the same risk/tightening impulse). "If USD ↑" reads off today\'s sign and can reverse. The EM channel has a slow (~1–1.5y) financial-conditions lead in the literature; everything in this grid is daily and coincident.', '同步共动，非因果或预测。美元与各资产的贝塔随格局变化且不稳定 — 符号会翻转（美元波动往往就是同一个风险/紧缩脉冲）。"若美元↑"读取的是当前符号，可能反转。文献中新兴市场渠道存在约1–1.5年的金融条件领先；本表均为日频同步关系。') }}</div>
    </div>
  </div>
  {% endif %}

  <!-- ===================== §03 · CURRENCY STRENGTH METER ===================== -->
