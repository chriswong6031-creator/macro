        <span class="score-n">{{ t('score', '评分') }} {{ '%+.0f'|format(c.score) }} · {{ t('confidence', '信心') }} {{ '%.0f'|format(c.confidence*100) }}%</span>
        {% if c.reliable %}<span class="calbadge on" title="≥2 factors held sign in both halves">{{ t('measured', '已校准') }}</span>
        {% elif c.calibrated %}<span class="calbadge soft" title="weights measured but <2 robust factors; confidence dampened">{{ t('measured signs · dampened', '已测符号 · 折减') }}</span>{% endif %}
        <div class="sub" style="margin-top:8px"><span class="l-en">{{ c.sub }}</span><span class="l-zh">{{ c.sub_zh }}</span></div>
        {% if c.peg %}<span class="flag warn">⚑ <span class="l-en">{{ c.peg.note[0] }}</span><span class="l-zh">{{ c.peg.note[1] }}</span></span>{% endif %}
        <div class="framing"><span class="l-en">{{ c.framing }}</span><span class="l-zh">{{ c.framing_zh }}</span></div>
      </div>

      {% for gname, rows in c.factors|groupby('group') %}
        <div class="fgrp">{{ t(gname, tr(gname)) }}</div>
        {% for r in rows %}
        <div class="frow">
          <span class="flabel">{{ t(r.label, r.label_zh) }}</span>
          {{ fbar(r.value) }}
          <span class="fwt">×{{ '%.2f'|format(r.weight) }}{% if r.verdict %}<span class="vg {{ r.verdict.split()[0]|lower }}" title="{{ r.verdict }}">{{ {'CONFIRMED':'✓','INVERTED':'⇄','DIRECTIONAL':'~','CONTEXT':'·','UNMEASURED':'–'}.get(r.verdict,'') }}</span>{% endif %}</span>
        </div>
        {% endfor %}
      {% endfor %}
      {% else %}
      <div class="sub faint" style="margin:14px 0">{{ t('Conviction unavailable (insufficient data).', '暂无信心评分（数据不足）。') }}</div>
      {% endif %}

      {% if p.cnh_basis is not none %}
      <div class="cnh-basis s-{{ p.cnh_state or 'neutral' }}">
        <b>{{ t('Offshore–onshore CNH basis', '离岸–在岸人民币基差') }}:</b> {{ '%+.0f'|format(p.cnh_basis) }} bps —
        {% if p.cnh_state == 'outflow_stress' %}{{ t('offshore yuan notably weaker than the onshore fix — depreciation / capital-outflow pressure.', '离岸人民币明显弱于在岸中间价 — 贬值/资金外流压力。') }}
        {% elif p.cnh_state == 'inflow' %}{{ t('offshore yuan stronger than onshore — inflow / risk-on.', '离岸人民币强于在岸 — 资金流入/偏好风险。') }}
        {% else %}{{ t('broadly aligned with the onshore fix.', '与在岸中间价大体一致。') }}{% endif %}
      </div>
      {% endif %}

      <div class="carry-row">
        <div class="kpi">{{ t('Carry (rate diff)', '套息（利差）') }}<b>{% if p.carry_context %}—{% else %}{{ '%+.2f'|format(p.carry_diff) }}%{% endif %}</b></div>
        <div class="kpi">{{ t('Carry / vol', '套息/波动') }}<b>{% if p.carry_context %}—{% else %}{{ p.carry_to_vol }}{% endif %}</b></div>
        <div class="kpi">{{ t('$ beta', '美元贝塔') }}<b>{{ p.dollar_beta }}</b></div>
        <div class="kpi">{{ t('Risk idx', '风险指数') }}<b>{{ p.risk_index }}</b></div>
      </div>
      {% if p.carry_context %}<div class="sub faint" style="margin-top:6px">{{ t('Carry is CONTEXT-only — no clean free front-end rate for this currency.', '套息仅作背景 — 该货币无可靠的免费短端利率。') }}</div>{% endif %}

      {% if p.mtf_rows %}
      <div class="mtf">
        <div class="fgrp">{{ t('Multi-timeframe (technical)', '多周期（技术面）') }}{% if p.verdict.grade %} · <span class="mtf-grade">{{ t(p.verdict.grade, p.verdict.grade_zh) }}</span>{% endif %}</div>
        <div class="mtf-row mtf-head"><span>{{ t('TF', '周期') }}</span><span>RSI</span><span>Stoch</span><span>MACD</span><span>{{ t('Trend', '趋势') }}</span></div>
        {% for m in p.mtf_rows %}
        <div class="mtf-row">
          <span>{{ t(m.label, m.label_zh) }}</span>
          <span>{{ m.rsi14 if m.rsi14 is not none else '—' }}</span>
          <span>{{ m.stoch if m.stoch is not none else '—' }}</span>
          <span class="macd-{{ m.macd }}">{{ {'up':'↑','down':'↓','pos':'+','neg':'−'}.get(m.macd,'·') }}</span>
          <span class="tr-{{ m.trend }}">{{ {'up':'▲','down':'▼','flat':'—'}.get(m.trend,'—') }}</span>
        </div>
        {% endfor %}
        {% if p.verdict.headline %}<div class="sub" style="margin-top:6px"><span class="l-en">{{ p.verdict.headline }}</span><span class="l-zh">{{ p.verdict.headline_zh }}</span></div>{% endif %}
        <div class="sub faint" style="margin-top:4px">{{ t('Pure technical confluence on the FX-calibrated cycle preset (measured ~35d daily / ~34wk intermediate cycle) — a tactical timing overlay, not a return-validated alpha.', '纯技术共振，采用外汇校准的周期预设（实测约35天日周期 / 约34周中期周期）— 战术择时叠加，非经收益验证的超额收益。') }}</div>
      </div>
      {% endif %}

      <div style="margin-top:14px">{{ p.chart | safe }}</div>
    </div>
  {% endfor %}
  </div>
  {% endfor %}

  <!-- ===================== §05 · CARRY & VALUATION TABLE ===================== -->
  <div class="section-h"><span class="sn">§05</span><h2>{{ t('Carry & valuation — cross-pair', '套息与估值 · 跨货币对') }}</h2></div>
  <div class="card">
    <h2>{{ t('Carry & valuation — cross-pair', '套息与估值 · 跨货币对') }}</h2>
    <table class="tbl">
      <thead><tr>
        <th>{{ t('Pair', '货币对') }}</th>
        <th>{{ t('Carry %', '套息 %') }}</th>
        <th>{{ t('Carry/vol', '套息/波动') }}</th>
        <th>{{ t('10y diff', '10年利差') }}</th>
        <th>{{ t('REER gap %', 'REER偏离 %') }}</th>
        <th>{{ t('$ beta', '美元贝塔') }}</th>
      </tr></thead>
      <tbody>
      {% for r in carry_table %}
        <tr>
          <td>{{ r.label }}</td>
          <td>{% if r.carry is none %}<span class="faint">—</span>{% else %}{{ '%+.2f'|format(r.carry) }}{% endif %}</td>
          <td>{% if r.ctv is none %}<span class="faint">—</span>{% else %}{{ '%+.2f'|format(r.ctv) }}{% endif %}</td>
          <td>{% if r.rate10 is none %}<span class="faint">—</span>{% else %}{{ '%+.2f'|format(r.rate10) }}{% endif %}</td>
          <td>{% if r.reer_gap is none %}<span class="faint">—</span>{% else %}{{ '%+.1f'|format(r.reer_gap) }}{% endif %}</td>
          <td>{{ r.beta }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <div class="sub faint" style="margin-top:8px">{{ t('Carry % = foreign minus US short rate (annualized). Carry/vol penalizes fragile high-vol carry. REER gap = real-effective rate vs its 5y mean (+ = rich → mean-reversion headwind). Carry has fat-tailed crash risk — see the honesty note below.', '套息 % = 外币减美国短端利率（年化）。套息/波动惩罚高波动的脆弱套息。REER偏离 = 实际有效汇率相对5年均值（+ = 偏贵 → 均值回归阻力）。套息具肥尾崩盘风险 — 见下方诚信说明。') }}</div>
  </div>

  <!-- ===================== §06 · INTERNATIONAL SCORECARDS ===================== -->
  {% if scorecards %}
  {% macro scrow(seg, m) %}<div class="sr"><span>{{ seg }}</span>
    <span class="{{ 'sc-pos' if (m.cagr or 0)>=0 else 'sc-neg' }}">{{ '%+.1f'|format(m.cagr) if m.cagr is not none else '—' }}%</span>
    <span>{{ '%.2f'|format(m.sharpe) if m.sharpe is not none else '—' }}</span>
    <span class="sc-neg">{{ '%.0f'|format(m.maxdd) if m.maxdd is not none else '—' }}%</span></div>{% endmacro %}
  <div class="section-h"><span class="sn">§06</span><h2>{{ t('International scorecards', '国际记分卡') }}</h2>
    <span class="sh-sub">{{ t('honest PIT backtests — risk premia with fat tails, not free alpha', '诚实的时点回测 — 带肥尾的风险溢价，非免费超额收益') }}</span></div>
  <div class="sc-grid">
    {% for c in scorecards %}
    <div class="sc-card">
      {% if c.key == 'carry' %}
        <div class="sc-name">{{ t('G10 carry basket', 'G10套息篮子') }}</div>
        <div class="sc-thesis">{{ t('Long the highest-carry G10 currencies vs USD, short the lowest (vol-scaled, monthly). Carry harvests a REAL risk premium but crashes in risk-off — the Sharpe flatters; the drawdown and negative skew are the truth.', '做多套息最高的G10货币、做空最低者（按波动缩放，月度调仓）。套息是真实的风险溢价，但在避险时崩盘 — 夏普比率具误导性，回撤与负偏度才是真相。') }}</div>
      {% elif c.key == 'haven' %}
        <div class="sc-name">{{ t('Risk-off haven basket', '避险货币篮子') }}</div>
        <div class="sc-thesis">{{ t('The MIRROR of carry: long the havens (JPY, CHF) vs short the risk currencies (AUD, CAD, EM). It bleeds the carry differential as an insurance premium most of the time — but pays in risk-off. The calm-vs-stress split below is the whole point.', '套息的镜像：做多避险货币（日元、瑞郎）、做空风险货币（澳元、加元、新兴市场）。多数时候作为保险金消耗套息利差 — 但在避险时获利。下方的平静vs压力分解才是关键。') }}</div>
      {% elif c.key == 'dollar_trend' %}
        <div class="sc-name">{{ t('Dollar trend overlay', '美元趋势叠加') }}</div>
        <div class="sc-thesis">{{ t('Long the dollar index when its 12-month trend is up, else flat. A crash-avoidance overlay vs buy & hold — NOT alpha (broad-dollar trend is weak and whippy).', '当美元指数12个月趋势向上时做多，否则空仓。相对买入持有的避险叠加 — 非超额收益（广义美元趋势弱且反复）。') }}</div>
      {% endif %}
      {% set fm = c.metrics.full %}
      <div class="sc-met">
        <div class="m">{{ t('CAGR', '年化') }}<b class="{{ 'warn-pos' if (fm.cagr or 0)>=0 else 'warn-neg' }}">{{ '%+.1f'|format(fm.cagr) if fm.cagr is not none else '—' }}%</b></div>
        <div class="m">{{ t('Sharpe', '夏普') }}<b>{{ '%.2f'|format(fm.sharpe) if fm.sharpe is not none else '—' }}</b></div>
        <div class="m">{{ t('Max DD', '最大回撤') }}<b class="warn-neg">{{ '%.0f'|format(fm.maxdd) if fm.maxdd is not none else '—' }}%</b></div>
      </div>
      <div class="sc-split">
        <div class="sr h"><span></span><span>{{ t('CAGR', '年化') }}</span><span>{{ t('Sharpe', '夏普') }}</span><span>{{ t('MaxDD', '回撤') }}</span></div>
        {{ scrow(t('Full', '全样本'), c.metrics.full) }}
        {% if c.metrics.pre %}{{ scrow(t('Pre-08', '08前'), c.metrics.pre) }}{% endif %}
        {% if c.metrics.post %}{{ scrow(t('Post-08', '08后'), c.metrics.post) }}{% endif %}
        {% if c.metrics.full.skew is not none %}<div class="sr"><span>{{ t('Skew', '偏度') }}</span><span class="{{ 'sc-neg' if c.metrics.full.skew<0 else '' }}" style="grid-column:span 2">{{ '%.2f'|format(c.metrics.full.skew) }}</span><span class="sc-neg">{{ '%.0f'|format(c.metrics.full.worst_month) }}%</span></div>{% endif %}
      </div>
      {% if c.key == 'carry' and c.longs %}
      <div class="sc-tilt">{{ t('Now', '当前') }}: {{ t('long', '做多') }} <b>{{ c.longs|join(' ') }}</b> · {{ t('short', '做空') }} <b>{{ c.shorts|join(' ') }}</b></div>
      {% elif c.key == 'haven' %}
      <div class="sc-tilt">{{ t('Static', '静态') }}: {{ t('long', '做多') }} <b>{{ c.longs|join(' ') }}</b> · {{ t('short', '做空') }} <b>{{ c.shorts|join(' ') }}</b>
        {% if c.regime %}<br>{{ t('annualized return', '年化收益') }}: {{ t('calm', '平静') }} <span class="{{ 'sc-neg' if (c.regime.calm_ann or 0)<0 else 'sc-pos' }}">{{ '%+.0f'|format(c.regime.calm_ann) if c.regime.calm_ann is not none else '—' }}%</span> · {{ t('risk-off', '避险') }} <span class="{{ 'sc-pos' if (c.regime.stress_ann or 0)>=0 else 'sc-neg' }}">{{ '%+.0f'|format(c.regime.stress_ann) if c.regime.stress_ann is not none else '—' }}%</span>{% endif %}</div>
      {% elif c.key == 'dollar_trend' %}
      <div class="sc-tilt">{{ t('Now', '当前') }}: <b>{% if c.in_market %}{{ t('long the dollar (trend up)', '做多美元（趋势向上）') }}{% else %}{{ t('flat (trend down)', '空仓（趋势向下）') }}{% endif %}</b>{% if c.hold %} · {{ t('buy & hold MaxDD', '买入持有最大回撤') }} {{ '%.0f'|format(c.hold.maxdd) }}%{% endif %}</div>
      {% endif %}
      <div class="sub faint" style="margin-top:8px;font-size:11px">{{ t('Net of', '净额扣除') }} {{ '2' }}bp {{ t('one-way cost · display-only / experimental · span', '单边成本 · 仅供展示/实验 · 区间') }} {{ c.span }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ===================== ALERT TIMELINE ===================== -->
  {% if timeline %}
  <div class="card" style="margin-top:20px">
    <h2>{{ t('Alert timeline', '警报时间线') }} <span class="faint">· {{ n_alerts }} {{ t('events · last', '事件 · 近') }} {{ timeline_days }}d</span></h2>
    <div class="timeline">
    {% for day in timeline %}
      <div class="tl-day">{{ day.daylabel }}</div>
      {% for e in day.events %}
      <div class="tl-ev sev-{{ e.severity }}">
        <span class="tl-type">{{ e.label }}</span>
        <span class="tl-asset">{{ e.asset_label }}</span>
        <span class="tl-head"><span class="l-en">{{ e.headline }}</span><span class="l-zh">{{ e.headline_zh }}</span></span>
      </div>
      {% endfor %}
    {% endfor %}
    </div>
    <div class="sub faint" style="margin-top:10px">{{ t('Deterministic daily state-change events (no intraday — FX has no hourly feed here). All context, not trade signals.', '确定性的每日状态变化事件（无日内 — 此处外汇无小时级数据）。皆为背景，非交易信号。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== METHODOLOGY / HONESTY ===================== -->
  <div class="card" style="margin-top:22px">
    <h2>{{ t('How to read this · and what it is not', '如何解读 · 以及它不是什么') }}</h2>
    <div class="note">
      <p>{{ t('Each pair is scored by a multi-factor conviction engine — the same machinery as the Commodity Vector — over its DOLLAR-ORTHOGONALIZED residual: trend & structure (idiosyncratic, ex-dollar), carry (foreign minus US short rate, vol-penalized), risk appetite (the global risk-off composite times the currency\'s archetype beta — havens rally, risk currencies fall in stress), the per-pair risk index, residual shocks, and COT positioning when available. The score maps to a LONG / SHORT / FLAT bias on the BASE currency vs USD.', '每个货币对由一个多因子信心引擎评分 — 与大宗商品向量同一套机制 — 基于其剥离美元后的残差：趋势与结构（特异、去美元）、套息（外币减美国短端利率，按波动折减）、风险偏好（全球避险综合乘以货币原型贝塔 — 避险货币上涨、风险货币在压力下下跌）、单货币对风险指数、残差冲击，以及（可用时）COT持仓。评分映射为基础货币对美元的做多/做空/观望倾向。') }}</p>
      <p><b>{{ t('Honesty bar.', '诚信底线。') }}</b> {{ t('FX violates uncovered interest parity (the carry "puzzle"), and carry has fat-tailed crash risk that clusters with equity crises (1998 / 2008 / 2015 / 2020 / 2024). So these are RISK-CONTEXT reads, not trade signals or measured alpha. Weights are MEASURED by split-half forward-return calibration (Spearman IC, split 2015, peg windows excised) — the glyph on each factor marks its verdict: ✓ CONFIRMED (held sign in both halves), ⇄ INVERTED (robustly predicts the opposite — e.g. the carry forward-premium puzzle), ~ DIRECTIONAL (full sample only), · CONTEXT (weak). Most FX factors land DIRECTIONAL or CONTEXT, so confidence stays dampened until a pair has ≥2 robust factors. Pegs & intervention zones (USD/JPY MoF, SNB, managed USD/CNH) cap or flatten the verdict.', '外汇违反无抛补利率平价（套息“谜题”），且套息具有与股市危机同步聚集的肥尾崩盘风险（1998/2008/2015/2020/2024）。因此这些是风险背景解读，而非交易信号或已测得的超额收益。权重由前后半段远期收益校准测得（Spearman IC，2015分割，剔除挂钩窗口）— 每个因子的字形标注其判定：✓ 已确认（两半段同号）、⇄ 反向（稳健预测相反方向，如套息远期溢价之谜）、~ 有方向（仅全样本）、· 背景（弱）。多数外汇因子落入有方向或背景，故在某货币对具备≥2个稳健因子前信心保持折减。挂钩与干预区间（美元/日元财务省、瑞士央行、受管理的美元/离岸人民币）会限制或抹平结论。') }}</p>
      <p><b>{{ t('The Dollar Desk (§01) is display-only.', '美元桌（§01）仅供展示。') }}</b> {{ t('The dollar is the master variable — it conditions commodities, equities, bonds and crypto — so we read it deeply: real-rate regime, the Fed policy path (US leg of the rate differential), COT positioning, REER valuation, a multi-horizon trend stack, USD liquidity, and a smile-confirmation tally. But NONE of it is scored. The dollar move is often the tightening itself (coincident), FX direction is famously unforecastable (Meese-Rogoff), and every dollar leg is labeled coincident or context. The "lean" is a balance of context flags — a summary, not a trade call. There is deliberately no aggregate "USD → BUY/SELL".', '美元是主控变量 — 它影响大宗商品、股票、债券与加密货币 — 因此我们深入解读：实际利率格局、美联储政策路径（利差的美国端）、COT持仓、REER估值、多周期趋势栈、美元流动性，以及微笑确认计数。但这些都不参与评分。美元波动往往就是紧缩本身（同步），外汇方向出了名地不可预测（Meese-Rogoff），每个美元项都标注为同步或背景。"倾向"是背景信号的平衡 — 仅为汇总，非交易建议。我们刻意不给出汇总的"美元→买/卖"。') }}</p>
      <p><b>{{ t('Transmission (§02) is contemporaneous.', '传导（§02）为同步关系。') }}</b> {{ t('Dollar↔asset correlations are computed live and are regime-dependent and unstable — sign flips happen, and the stability dot flags them. Gold is shown with its real-rate leg; the 10y-Treasury sign is unstable because the rate channel and haven channel oppose each other. This is a map of how today\'s dollar move is rippling, not a forecast — and it complements the cross-asset PCA on the Cross-Asset page (which asks "are the markets one bet?") rather than duplicating it. Scorecards (§06) are honest PIT backtests of risk premia with fat tails; the Max-DD and skew are the truth the Sharpe hides.', '美元与各资产的相关性为实时计算，随格局变化且不稳定 — 符号会翻转，稳定性圆点会标记之。黄金附带其实际利率项；10年期国债符号不稳定，因为利率渠道与避险渠道相互抵消。这是当前美元波动如何扩散的地图，而非预测 — 它与跨资产页面的PCA（"各市场是否同一笔交易？"）互补而非重复。记分卡（§06）是对带肥尾风险溢价的诚实时点回测；最大回撤与偏度才是夏普比率掩盖的真相。') }}</p>
      <p><b>{{ t('The Stress & Regime Radar (§1.5) is an empirical base rate, not a forecast.', '压力与格局雷达（§1.5）是经验基率，而非预测。') }}</b> {{ t('Each scenario builds a strictly-causal stress intensity from the joint configuration of currency moves — VELOCITY (recent speed in σ-units and its acceleration) and LITERAL level (drawdowns, percentiles, distance to peg/intervention zones, the CNH basis). The probability is a PAST-TENSE conditional frequency: of all the days in history at least this stressed, the share that saw the defining adverse move within N days — shown beside the unconditional base rate, the sample n, an overlap-deflated n_eff = n/N (forward windows overlap, so the effective sample is smaller and the interval wider), and a Wilson 95% interval on both. We did NOT search a threshold to maximize it — today’s reading is the only condition — so there is no multiple-testing bias to correct. It is computed once over the full causal record (no peg-window excision, because this is a realized frequency, not a fitted weight), and it is DISPLAY-ONLY: it never feeds a score, conviction or BUY/SELL. FX direction is famously unforecastable (Meese-Rogoff); a wide interval means thin history, not low risk; and the record cannot capture tail events outside the sample (1998 / 2008 / 2015 / 2020 / 2024). Managed (USD/CNH) and intervention (USD/JPY MoF, SNB) regimes truncate the distribution — those scenarios are flagged illustrative.', '每个情景由货币走势的联合配置构建严格因果的压力强度 — 速度（近端走势的σ单位及其加速度）与实际水平（回撤、百分位、距挂钩/干预区的距离、离岸人民币基差）。概率为过去时的条件频率：在历史上所有至少同等压力的日子里，于N天内出现界定性不利走势的占比 — 并列出无条件基率、样本量n、经重叠折减的有效样本n_eff = n/N（远期窗口重叠，故有效样本更小、区间更宽），以及两者的Wilson 95%区间。我们并未搜索阈值来最大化它 — 当前读数是唯一条件 — 故无需校正多重检验偏差。它在完整因果记录上一次性计算（不剔除挂钩窗口，因为这是已实现频率而非拟合权重），且仅供展示：从不参与评分、信心或买/卖。外汇方向出了名地不可预测（Meese-Rogoff）；区间宽意味着历史样本薄，而非风险低；且记录无法涵盖样本外的尾部事件（1998/2008/2015/2020/2024）。受管理（美元/离岸人民币）与干预（美元/日元财务省、瑞士央行）体制会截断分布 — 相关情景标注为仅供示意。') }}</p>
      <p><b>{{ t('Data.', '数据。') }}</b> {{ t('Free / keyless: Yahoo FX spot, FRED policy & short rates + broad-dollar legs + real yields (DFII10) + breakevens + Fed balance sheet & RRP + BIS REER, CFTC Commitments of Traders, Fed-funds (ZQ) futures for the policy path, and the ICE BofA MOVE bond-vol index.', '免费/无密钥：Yahoo外汇即期、FRED政策与短端利率+广义美元分项+实际收益率（DFII10）+盈亏平衡+美联储资产负债表与RRP+BIS实际有效汇率、CFTC交易商持仓、联邦基金（ZQ）期货政策路径、以及ICE BofA MOVE债券波动率指数。') }}
      {% if not cot_ok %}<span class="flag info">ℹ {{ t('COT positioning is temporarily unavailable (CFTC endpoint outage); it populates on the next successful collection.', 'COT持仓暂不可用（CFTC接口故障）；将在下次成功采集时填充。') }}</span>{% endif %}</p>
      <p class="meta-foot">{{ t('History', '历史') }} {{ cal_span }} · {{ t('built', '构建于') }} {{ built }}</p>
    </div>
  </div>
