        {%- for k, v in r.items() if k != 'asof' %}
        <span class="ssx-pill"><span style="color:var(--ink-3)">{{ _key_labels.get(k, k) }}</span><b>
          {%- if v is number and v > 1000 %}{{ '%.0f'|format(v / 1e8) }}
          {%- elif v is number %}{{ '%.2f'|format(v) }}%
          {%- else %}{{ v }}{%- endif %}</b></span>
        {%- endfor %}
        {%- endfor %}
      </div>
    </details>
  </div>
  {%- endif %}

  {# ═══════════════ TRACK RECORD — honest receipt ═══════════════ #}
  {%- if ss.track %}
  <div class="ssx-track">
    <span class="tic">📎</span>
    <span><span class="tk-lbl">{{ t('Track of record', '跟踪记录') }}</span>{{ tw(ss.track) }}</span>
  </div>
  {%- endif %}

  <div class="ssx-disc">
    <span class="l-en">{{ ss.disclaimer }}</span>
    <span class="l-zh">{{ ss.disclaimer_zh if ss.disclaimer_zh else ss.disclaimer }}</span>
  </div>
  {%- endif %}
</div>
{% endblock %}

{# ── reusable macros (defined after use is fine in Jinja) ── #}
{% macro sec_head(icon, label, blk) %}
{%- set g = (blk.glance if blk else none) %}
<div class="ssx-sec">
  <span class="sh-ic">{{ icon }}</span>
  <h2>{{ label }}</h2>
  {%- if g %}<span class="sh-stance lv-{{ g.level }}"><span class="lv">{{ tw(g) }}</span></span>{%- endif %}
  {%- if blk %}
    <span class="ssx-chip {{ blk.status if blk.status in ['ok','stale','missing'] else 'missing' }}">{{ blk.status or '—' }}</span>
    {%- if blk.asof %}<span class="ssx-asof">{{ blk.asof }}</span>{%- endif %}
  {%- endif %}
</div>
{% endmacro %}

{% macro empty(msg) %}
<div class="ssx-card" style="padding:0;background:none;border:none;box-shadow:none;margin-bottom:14px">
  <div class="ssx-empty"><span class="ec">○</span>{{ msg }}</div>
</div>
{% endmacro %}
