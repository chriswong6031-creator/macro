{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}

{% block title %}China Special Situations — Macro Dashboard{% endblock %}

{%- block head_extra %}
{% set seo_title = "China Special Situations — Mastermind" %}
{% set seo_desc = "Event-driven setups in China's market — washouts, reversals and catalysts, screened after each Asia close." %}
{% set seo_path = "china_special_situations.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  .ss-hero { max-width:1060px; margin:18px auto 0; }
  .ss-hero .eyebrow { font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--link); font-weight:600; margin:0 0 8px; }
  .ss-hero h1 { font-size:29px; margin:0 0 8px; letter-spacing:-.01em; }
  html[data-lang="zh"] .ss-hero h1 { letter-spacing:0; }
  .ss-hero .lens { font-size:12px; color:var(--muted); }
  .ss-wrap { max-width:1060px; margin:0 auto; }
  h2.sec { font-size:18px; margin:26px 0 8px; border-top:1px solid var(--line); padding-top:16px; display:flex; align-items:baseline; gap:9px; }
  /* status chips */
  .status-chip { display:inline-flex; align-items:center; font:700 9px/1 ui-monospace,Menlo,monospace;
    letter-spacing:.05em; text-transform:uppercase; padding:2px 7px; border-radius:6px;
    border:1px solid; white-space:nowrap; vertical-align:middle; margin-left:6px; }
  .sc-ok      { background:color-mix(in srgb,var(--ok) 12%,transparent); color:var(--ok); border-color:color-mix(in srgb,var(--ok) 30%,transparent); }
  .sc-stale   { background:color-mix(in srgb,#e0973a 14%,transparent); color:#e0973a; border-color:color-mix(in srgb,#e0973a 35%,transparent); }
  .sc-missing { background:color-mix(in srgb,var(--muted) 12%,transparent); color:var(--muted); border-color:color-mix(in srgb,var(--muted) 28%,transparent); }
  /* context badge */
  .ctx-badge { font-size:10px; font-weight:700; padding:3px 9px; border-radius:999px;
    background:color-mix(in srgb,var(--muted) 12%,transparent);
    border:1px solid color-mix(in srgb,var(--muted) 28%,transparent); color:var(--muted); }
  /* tables */
  table.ss { border-collapse:collapse; width:100%; font-size:12.5px; margin:8px 0; }
  table.ss th { text-align:left; padding:7px 9px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:2px solid var(--line); }
  table.ss td { padding:7px 9px; border-bottom:1px solid var(--line); vertical-align:top; }
  .large-flag { font-size:9px; font-weight:800; padding:2px 7px; border-radius:6px; text-transform:uppercase; letter-spacing:.03em;
    color:#e0973a; background:color-mix(in srgb,#e0973a 13%,transparent); border:1px solid color-mix(in srgb,#e0973a 30%,transparent); }
  /* cycle-context regime chips (W5) — muted/neutral only, no up/down coloring */
  .regime-chips { display:flex; flex-wrap:wrap; gap:4px; margin-top:3px; }
  .rg-chip { font-size:9px; font-weight:600; padding:1px 6px; border-radius:5px; background:color-mix(in srgb,var(--muted) 10%,transparent); color:var(--muted); border:1px solid color-mix(in srgb,var(--muted) 22%,transparent); letter-spacing:.03em; }
  /* callout / empty state */
  .callout { border-radius:12px; padding:13px 16px; margin:14px 0; border:1px solid var(--line); background:var(--panel2); font-size:13.5px; line-height:1.6; }
  .empty-state { font-size:12.5px; color:var(--muted); padding:10px 0; font-style:italic; }
  /* section cards */
  .ss-card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin:12px 0; }
  .ss-card .sc-hd { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
  .sc-num { font-size:24px; font-weight:800; font-variant-numeric:tabular-nums; }
  .sc-lbl { font-size:12px; color:var(--muted); }
  /* inquiry */
  .inq-row { display:flex; align-items:flex-start; gap:10px; padding:8px 0; border-bottom:1px solid var(--line); font-size:12.5px; }
  .inq-row:last-child { border-bottom:none; }
  .inq-title { flex:1; }
  .inq-meta { font-size:10.5px; color:var(--muted); white-space:nowrap; }
  .reply-tag { font-size:9px; font-weight:800; padding:2px 7px; border-radius:6px; text-transform:uppercase;
    color:#1f9a55; background:color-mix(in srgb,#1f9a55 12%,transparent); border:1px solid color-mix(in srgb,#1f9a55 28%,transparent); }
  /* preannounce by-type grid */
  .type-grid { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0; }
  .type-pill { display:inline-flex; align-items:center; gap:6px; font-size:12px; padding:5px 11px; border-radius:999px;
    background:var(--panel2); border:1px solid var(--line); }
  .type-pill b { font-variant-numeric:tabular-nums; }
  /* expander */
  details.ss-more > summary { cursor:pointer; font-size:11px; color:var(--link); margin-top:6px; list-style:none; }
  details.ss-more > summary::-webkit-details-marker { display:none; }
  /* disclaimer */
  .disc { font-size:11.5px; color:var(--muted); margin-top:12px; line-height:1.55; }
  /* back nav */
  .back-nav { font-size:12px; margin-bottom:14px; }
  /* goodwill */
  .gw-strip { display:flex; gap:16px; flex-wrap:wrap; font-size:12.5px; margin:6px 0; }
  .gw-strip .gw-yr { color:var(--muted); } .gw-strip .gw-val { font-weight:700; }
{% endblock %}

{% block content %}
{%- set ss = special %}
<section class="ss-hero">
  <p class="eyebrow">⚠️ {{ t('China Special Situations', '中国特殊情景') }}</p>
  <h1>{{ t('China Special Situations Desk', '中国特殊情景台') }}</h1>
  <p class="lens">{{ t('Unlock queue · inquiry letters · earnings pre-announcements · ST watch · buybacks · pledge stress · block-trade anomalies — context only', '解禁日历 · 问询函 · 业绩预告 · ST观察 · 回购 · 质押压力 · 大宗交易异常——仅供参考') }} · {{ t('as of', '截至') }} {{ ss.asof if ss else '—' }}</p>
</section>

<div class="ss-wrap">
  <div class="back-nav"><a href="china_intel.html">← {{ t('China Intelligence Hub', '中国情报中心') }}</a></div>

  {%- set _asof = ss.asof if ss else none %}
  {%- if not ss %}
  <div class="callout">{{ t('Special situations desk is warming up — populates after the first build.', '特殊情景台预热中——将在首次构建后填充。') }}</div>
  {%- else %}

  <div class="callout" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
    <span class="ctx-badge">{{ t('Context only', '仅供参考') }}</span>
    <span style="font-size:12.5px">{{ t('Rankings by disclosed magnitudes and exchange-reported labels. No directional scoring, no buy/sell language.', '按披露规模和交易所公布类型排序。无方向性评分，无买卖语言。') }}</span>
  </div>

  {# ─── A. UNLOCK OVERHANG ─── #}
  {%- set u = ss.unlocks %}
  <h2 class="sec">🔓 {{ t('Unlock Overhang', '解禁压力') }}
    {%- if u %}
      <span class="status-chip {{ 'sc-ok' if u.status=='ok' else ('sc-stale' if u.status=='stale' else 'sc-missing') }}">{{ u.status or '—' }}</span>
      {%- if u.asof %}<span style="font-size:11px;color:var(--muted)">{{ u.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not u or u.status == 'missing' %}
  <p class="empty-state">{{ t('No unlock data — populates after first collect.', '无解禁数据——将在首次采集后填充。') }}</p>
  {%- elif not u.events %}
  <p class="empty-state">{{ t('No forward unlock events in next 30 days.', '未来30天内无解禁事件。') }}</p>
  {%- else %}
  <div class="ss-card">
    <div class="sc-hd">
      <span class="sc-num">{{ u.n_events_30d }}</span>
      <span class="sc-lbl">{{ t('events in next 30d', '未来30天事件') }}</span>
      {%- if u.n_large %}<span class="large-flag">{{ u.n_large }} {{ t('≥5% float', '≥5%流通') }}</span>{%- endif %}
    </div>
    <table class="ss">
      <thead><tr>
        <th>{{ t('Ticker', '代码') }}</th>
        <th>{{ t('Name', '名称') }}</th>
        <th>{{ t('Unlock Date', '解禁日期') }}</th>
        <th>{{ t('Type', '类型') }}</th>
        <th>{{ t('Float % of Pre-Unlock', '占解禁前流通%') }}</th>
      </tr></thead>
      <tbody>
      {%- for ev in u.events %}
      <tr>
        <td>{{ ev.ticker }}</td>
        <td>{{ ev.name }}</td>
        <td>
          {{ ev.unlock_date or '—' }}
          {%- if ev.get('regime_chip') %}{%- set _rc = ev.regime_chip %}
          <div class="regime-chips"><span class="rg-chip">{{ _rc.quad }}</span><span class="rg-chip">{{ td(_rc.quad_name) }}</span><span class="rg-chip">{{ td(_rc.liquidity) }}</span><span class="rg-chip">{{ td(_rc.cycle) }}-{{ t('cycle','周期') }}</span></div>
          {%- endif %}
        </td>
        <td style="font-size:11.5px;color:var(--muted)">{{ ev.lock_type or '—' }}</td>
        <td>
          {%- if ev.float_pct is not none %}
            {{ '%.1f'|format(ev.float_pct) }}%
            {%- if ev.large_flag %} <span class="large-flag" data-tip-en="≥5% of pre-unlock float" data-tip-zh="占解禁前流通市值≥5%">!</span>{%- endif %}
          {%- else %}—{%- endif %}
        </td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
    {%- if u.weekly_strip %}
    <details class="ss-more"><summary>{{ t('Weekly aggregate strip ▸', '按周汇总 ▸') }}</summary>
      <div style="margin-top:8px;display:flex;gap:10px;flex-wrap:wrap;font-size:12px">
      {%- for w in u.weekly_strip %}
        <span style="background:var(--panel2);padding:3px 9px;border-radius:8px;border:1px solid var(--line)">
          <b>{{ w.week }}</b>
          {%- if w.total_mktcap is not none %} · {{ w.total_mktcap|round(0)|int }} {{ t('(¥10k)', '万元') }}{%- endif %}
        </span>
      {%- endfor %}
      </div>
    </details>
    {%- endif %}
  </div>
  {%- endif %}

  {# ─── B. INQUIRY LETTERS ─── #}
  {%- set inq = ss.inquiry %}
  <h2 class="sec">📬 {{ t('Exchange Inquiry Letters', '交易所问询函') }}
    {%- if inq %}
      <span class="status-chip {{ 'sc-ok' if inq.status=='ok' else ('sc-stale' if inq.status=='stale' else 'sc-missing') }}">{{ inq.status or '—' }}</span>
      {%- if inq.asof %}<span style="font-size:11px;color:var(--muted)">{{ inq.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not inq or inq.status == 'missing' %}
  <p class="empty-state">{{ t('No inquiry data — populates after first collect.', '无问询数据——将在首次采集后填充。') }}</p>
  {%- elif not inq.letters %}
  <p class="empty-state">{{ t('No exchange-issued letters in past 14 days.', '过去14天内无交易所问询函。') }}</p>
  {%- else %}
  <div class="ss-card">
    <div class="sc-hd">
      <span class="sc-num">{{ inq.n_letters }}</span>
      <span class="sc-lbl">{{ t('letters (last 14d)', '问询函（过去14天）') }}</span>
      {%- if inq.n_replies %}<span style="font-size:12px;color:var(--muted)">· {{ inq.n_replies }} {{ t('replies', '回复') }}</span>{%- endif %}
    </div>
    {%- for ltr in inq.letters %}
    <div class="inq-row">
      <div class="inq-title">
        <b>{{ ltr.secCode }}</b> {{ ltr.secName }}
        {%- if ltr.has_reply %} <span class="reply-tag">{{ t('replied', '已回复') }}</span>{%- endif %}
        <div style="font-size:11.5px;color:var(--muted);margin-top:3px">{{ ltr.title }}</div>
        {%- if ltr.pdf_url %}
          {%- if ltr.pdf_url.startswith('/') %}
            <a href="https://static.cninfo.com.cn{{ ltr.pdf_url }}" target="_blank" rel="noopener noreferrer" style="font-size:10.5px;color:var(--link)">{{ t('PDF ↗', 'PDF ↗') }}</a>
          {%- else %}
            <a href="https://static.cninfo.com.cn/{{ ltr.pdf_url }}" target="_blank" rel="noopener noreferrer" style="font-size:10.5px;color:var(--link)">{{ t('PDF ↗', 'PDF ↗') }}</a>
          {%- endif %}
        {%- endif %}
        {%- if ltr.get('regime_chip') %}{%- set _rc = ltr.regime_chip %}
        <div class="regime-chips"><span class="rg-chip">{{ _rc.quad }}</span><span class="rg-chip">{{ td(_rc.quad_name) }}</span><span class="rg-chip">{{ td(_rc.liquidity) }}</span><span class="rg-chip">{{ td(_rc.cycle) }}-{{ t('cycle','周期') }}</span></div>
        {%- endif %}
      </div>
      <div class="inq-meta">{{ ltr.date }}</div>
    </div>
    {%- endfor %}
    {%- if inq.n_letters > inq.letters|length %}
    <p style="font-size:11.5px;color:var(--muted);margin-top:6px">{{ t('Showing top 8 of', '显示前8条，共') }} {{ inq.n_letters }}</p>
    {%- endif %}
  </div>
  {%- endif %}

  {# ─── C. EARNINGS PRE-ANNOUNCEMENTS ─── #}
  {%- set pa = ss.preannounce %}
  <h2 class="sec">📋 {{ t('Earnings Pre-Announcements', '业绩预告') }}
    {%- if pa %}
      <span class="status-chip {{ 'sc-ok' if pa.status=='ok' else ('sc-stale' if pa.status=='stale' else 'sc-missing') }}">{{ pa.status or '—' }}</span>
      {%- if pa.asof %}<span style="font-size:11px;color:var(--muted)">{{ pa.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not pa or pa.status == 'missing' %}
  <p class="empty-state">{{ t('No pre-announcement data — populates after first collect.', '无业绩预告数据——将在首次采集后填充。') }}</p>
  {%- elif not pa.by_type and not pa.top_movers %}
  <p class="empty-state">{{ t('No pre-announcements in current season.', '当前季度无业绩预告。') }}</p>
  {%- else %}
  <div class="ss-card">
    {%- if pa.by_type %}
    <div style="margin-bottom:10px">
      <div style="font-size:11.5px;color:var(--muted);margin-bottom:6px">{{ t('By announced type (exchange labels verbatim)', '按公告类型（交易所原文标签）') }}</div>
      <div class="type-grid">
        {%- for typ, cnt in pa.by_type.items() %}
        <span class="type-pill"><span>{{ typ }}</span><b>{{ cnt }}</b></span>
        {%- endfor %}
      </div>
    </div>
    {%- endif %}
    {%- if pa.top_movers %}
    <details class="ss-more"><summary>{{ t('Biggest movers by magnitude ▸', '按幅度排序的最大变动 ▸') }}</summary>
      <table class="ss" style="margin-top:8px">
        <thead><tr>
          <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Name', '名称') }}</th>
          <th>{{ t('Type', '预告类型') }}</th><th>{{ t('Change %', '变动幅度') }}</th>
          <th>{{ t('Period', '报告期') }}</th>
        </tr></thead>
        <tbody>
        {%- for r in pa.top_movers %}
        <tr>
          <td>{{ r.ticker }}</td>
          <td>{{ r.name }}</td>
          <td style="font-size:11.5px">{{ r.type }}</td>
          <td>{{ '%.1f'|format(r.pct_change) if r.pct_change is not none else '—' }}%</td>
          <td style="font-size:11px;color:var(--muted)">{{ r.quarter }}</td>
        </tr>
        {%- endfor %}
        </tbody>
      </table>
    </details>
    {%- endif %}
  </div>
  {%- endif %}

  {# ─── D. BUYBACK TAPE ─── #}
  {%- set bb = ss.buyback %}
  <h2 class="sec">🔄 {{ t('Buyback Tape', '回购台账') }}
    {%- if bb %}
      <span class="status-chip {{ 'sc-ok' if bb.status=='ok' else ('sc-stale' if bb.status=='stale' else 'sc-missing') }}">{{ bb.status or '—' }}</span>
      {%- if bb.asof %}<span style="font-size:11px;color:var(--muted)">{{ bb.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not bb or bb.status == 'missing' %}
  <p class="empty-state">{{ t('No buyback data — populates after first collect.', '无回购数据——将在首次采集后填充。') }}</p>
  {%- elif not bb.top %}
  <p class="empty-state">{{ t('No active buyback programs.', '当前无活跃回购计划。') }}</p>
  {%- else %}
  <div class="ss-card">
    <div class="sc-hd">
      <span class="sc-num">{{ bb.n_active }}</span>
      <span class="sc-lbl">{{ t('active programs', '活跃计划') }}</span>
    </div>
    <table class="ss">
      <thead><tr>
        <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Name', '名称') }}</th>
        <th>{{ t('Plan (¥100M)', '计划规模（亿）') }}</th>
        <th>{{ t('Done (¥100M)', '已完成（亿）') }}</th>
        <th>{{ t('Status', '状态') }}</th>
      </tr></thead>
      <tbody>
      {%- for r in bb.top %}
      <tr>
        <td>{{ r.ticker }}</td>
        <td>{{ r.name }}</td>
        <td>{{ '%.2f'|format(r.plan_amt_yi) if r.plan_amt_yi is not none else '—' }}</td>
        <td>{{ '%.2f'|format(r.done_amt_yi) if r.done_amt_yi is not none else '—' }}</td>
        <td style="font-size:11.5px;color:var(--muted)">{{ r.progress or '—' }}</td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- endif %}

  {# ─── E. PLEDGE STRESS ─── #}
  {%- set pl = ss.pledge %}
  <h2 class="sec">⛓️ {{ t('Pledge Stress', '质押压力') }}
    {%- if pl %}
      <span class="status-chip {{ 'sc-ok' if pl.status=='ok' else ('sc-stale' if pl.status=='stale' else 'sc-missing') }}">{{ pl.status or '—' }}</span>
      {%- if pl.asof %}<span style="font-size:11px;color:var(--muted)">{{ pl.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not pl or pl.status == 'missing' %}
  <p class="empty-state">{{ t('No pledge data — populates after first collect.', '无质押数据——将在首次采集后填充。') }}</p>
  {%- elif not pl.top %}
  <p class="empty-state">{{ t('No pledge data available.', '无质押数据可用。') }}</p>
  {%- else %}
  <div class="ss-card">
    <div class="sc-hd">
      <span class="sc-num">{{ pl.n_high }}</span>
      <span class="sc-lbl">{{ t('names with ≥50% pledge ratio', '质押比例≥50%的名称') }}</span>
      {%- if pl.quarter %}<span style="font-size:11px;color:var(--muted)">{{ t('Quarter', '报告期') }}: {{ pl.quarter }}</span>{%- endif %}
    </div>
    <table class="ss">
      <thead><tr>
        <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Name', '名称') }}</th>
        <th>{{ t('Pledge %', '质押比例') }}</th>
        <th>{{ t('Mktcap (¥100M)', '质押市值（亿）') }}</th>
      </tr></thead>
      <tbody>
      {%- for r in pl.top %}
      <tr>
        <td>{{ r.ticker }}</td>
        <td>{{ r.name }}</td>
        <td>{{ '%.1f'|format(r.pledge_ratio) if r.pledge_ratio is not none else '—' }}%</td>
        <td>{{ '%.1f'|format(r.pledge_mktcap_yi) if r.pledge_mktcap_yi is not none else '—' }}</td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
  </div>
  {%- endif %}

  {# ─── F. ST WATCH ─── #}
  {%- set st = ss.st %}
  <h2 class="sec">🚨 {{ t('ST Watch', 'ST 观察') }}
    {%- if st %}
      <span class="status-chip {{ 'sc-ok' if st.status=='ok' else ('sc-stale' if st.status=='stale' else 'sc-missing') }}">{{ st.status or '—' }}</span>
      {%- if st.asof %}<span style="font-size:11px;color:var(--muted)">{{ st.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not st or st.status == 'missing' %}
  <p class="empty-state">{{ t('No ST data — populates after first collect.', '无ST数据——将在首次采集后填充。') }}</p>
  {%- else %}
  <div class="ss-card">
    <div class="sc-hd">
      <span class="sc-num">{{ st.count }}</span>
      <span class="sc-lbl">{{ t('names on ST/risk-warning board', 'ST/风险警示名称数量') }}</span>
    </div>
    {%- if st.history_note %}
    <p style="font-size:11.5px;color:var(--muted);font-style:italic">{{ st.history_note }}</p>
    {%- else %}
      {%- if st.additions %}
      <div style="margin-bottom:10px">
        <div style="font-size:12px;font-weight:700;color:#e0973a;margin-bottom:4px">{{ t('New additions', '新增') }} ({{ st.additions|length }})</div>
        {%- for a in st.additions %}<span style="font-size:12.5px;margin-right:10px"><b>{{ a.ticker }}</b> {{ a.name }}</span>{%- endfor %}
      </div>
      {%- endif %}
      {%- if st.removals %}
      <div style="margin-bottom:10px">
        <div style="font-size:12px;font-weight:700;color:var(--ok);margin-bottom:4px">{{ t('Removed', '移除') }} ({{ st.removals|length }})</div>
        {%- for r in st.removals %}<span style="font-size:12.5px;margin-right:10px"><b>{{ r.ticker }}</b> {{ r.name }}</span>{%- endfor %}
      </div>
      {%- endif %}
    {%- endif %}
    {%- if st.top_current %}
    <details class="ss-more"><summary>{{ t('Current ST board names ▸', '当前ST名称 ▸') }}</summary>
      <table class="ss" style="margin-top:8px">
        <thead><tr><th>{{ t('Ticker', '代码') }}</th><th>{{ t('Name', '名称') }}</th><th>{{ t('Chg%', '涨跌幅') }}</th></tr></thead>
        <tbody>
        {%- for r in st.top_current %}
        <tr>
          <td>{{ r.ticker }}</td><td>{{ r.name }}</td>
          <td>{{ '%.2f'|format(r.pct_chg) if r.pct_chg is not none else '—' }}%</td>
        </tr>
        {%- endfor %}
        </tbody>
      </table>
    </details>
    {%- endif %}
  </div>
  {%- endif %}

  {# ─── G. BLOCK-TRADE ANOMALIES ─── #}
  {%- set bt = ss.block_trades %}
  <h2 class="sec">📦 {{ t('Block-Trade Anomalies', '大宗交易异常') }}
    {%- if bt %}
      <span class="status-chip {{ 'sc-ok' if bt.status=='ok' else ('sc-stale' if bt.status=='stale' else 'sc-missing') }}">{{ bt.status or '—' }}</span>
      {%- if bt.asof %}<span style="font-size:11px;color:var(--muted)">{{ bt.asof }}</span>{%- endif %}
    {%- endif %}
  </h2>
  {%- if not bt or bt.status == 'missing' %}
  <p class="empty-state">{{ t('No block-trade data — populates after first collect.', '无大宗交易数据——将在首次采集后填充。') }}</p>
  {%- elif not bt.top_premium and not bt.top_discount %}
  <p class="empty-state">{{ t('No block-trade anomalies.', '无大宗交易异常。') }}</p>
  {%- else %}
  <div class="ss-card">
    {%- if bt.top_premium %}
    <div style="font-size:12px;font-weight:700;margin-bottom:6px">{{ t('Largest premium trades', '最大溢价成交') }}</div>
    <table class="ss">
      <thead><tr>
        <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Avg Prem%', '平均溢价') }}</th>
        <th>{{ t('Amount (¥100M)', '金额（亿）') }}</th><th>{{ t('Count', '笔数') }}</th>
        <th>{{ t('Last', '最近日期') }}</th>
      </tr></thead>
      <tbody>
      {%- for r in bt.top_premium %}
      <tr>
        <td>{{ r.ticker }}</td>
        <td class="r-pos">+{{ '%.1f'|format(r.avg_premium_pct) if r.avg_premium_pct is not none else '—' }}%</td>
        <td>{{ '%.2f'|format(r.block_amt_yi) if r.block_amt_yi is not none else '—' }}</td>
        <td>{{ r.n_blocks }}</td>
        <td style="font-size:11px;color:var(--muted)">{{ r.last_date }}</td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
    {%- endif %}
    {%- if bt.top_discount %}
    <div style="font-size:12px;font-weight:700;margin:10px 0 6px">{{ t('Largest discount trades', '最大折价成交') }}</div>
    <table class="ss">
      <thead><tr>
        <th>{{ t('Ticker', '代码') }}</th><th>{{ t('Avg Disc%', '平均折价') }}</th>
        <th>{{ t('Amount (¥100M)', '金额（亿）') }}</th><th>{{ t('Count', '笔数') }}</th>
        <th>{{ t('Last', '最近日期') }}</th>
      </tr></thead>
      <tbody>
      {%- for r in bt.top_discount %}
      <tr>
        <td>{{ r.ticker }}</td>
        <td class="r-neg">{{ '%.1f'|format(r.avg_premium_pct) if r.avg_premium_pct is not none else '—' }}%</td>
        <td>{{ '%.2f'|format(r.block_amt_yi) if r.block_amt_yi is not none else '—' }}</td>
        <td>{{ r.n_blocks }}</td>
        <td style="font-size:11px;color:var(--muted)">{{ r.last_date }}</td>
      </tr>
      {%- endfor %}
      </tbody>
    </table>
    {%- endif %}
  </div>
  {%- endif %}

  {# ─── H. GOODWILL CONTEXT ─── #}
  {%- set gw = ss.goodwill %}
  {%- if gw and gw.annual_rows %}
  <h2 class="sec">📊 {{ t('Goodwill Profile', '商誉概览') }}
    <span class="status-chip {{ 'sc-ok' if gw.status=='ok' else 'sc-stale' }}">{{ gw.status or '—' }}</span>
    <span style="font-size:11px;color:var(--muted)">{{ t('macro context · annual aggregate', '宏观背景 · 年度汇总') }}</span>
  </h2>
  <div class="ss-card">
    <p style="font-size:12px;color:var(--muted);margin-bottom:8px">{{ t('Whole-market annual goodwill aggregates — macro context for impairment risk across A-share universe.', '全市场年度商誉汇总——A股商誉减值风险的宏观背景。') }}</p>
    <details class="ss-more"><summary>{{ t('Show annual rows ▸', '显示年度数据 ▸') }}</summary>
      {%- set _key_labels = {
        '报告期': t('Period', '报告期'),
        '商誉': t('Goodwill (¥100M)', '商誉（亿）'),
        '商誉减值': t('Impairment (¥100M)', '商誉减值（亿）'),
        '净资产': t('Net assets (¥100M)', '净资产（亿）'),
      } %}
      <div class="gw-strip" style="margin-top:8px">
        {%- for r in gw.annual_rows %}
        {%- for k, v in r.items() if k != 'asof' %}
        <span>
          <span class="gw-yr">{{ _key_labels.get(k, k) }}</span>:
          <span class="gw-val">
            {%- if v is number and v > 1000 %}{{ '%.0f'|format(v / 1e8) }}{{ t(' (¥100M)', '（亿）') }}
            {%- elif v is number %}{{ '%.2f'|format(v) }}%
            {%- else %}{{ v }}{%- endif %}
          </span>
        </span>
        {%- endfor %}
        {%- endfor %}
      </div>
    </details>
  </div>
  {%- endif %}

  <div class="disc">
    <span class="l-en">{{ ss.disclaimer }}</span>
    <span class="l-zh">{{ ss.disclaimer_zh if ss.disclaimer_zh else ss.disclaimer }}</span>
  </div>
  {%- endif %}
</div>
{% endblock %}
