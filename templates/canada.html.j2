{% if mode == 'stocks' and setups and setups.buy %}
<script src="stocktable.js"></script>
<script>
/* W8-G: StockTable init — standout board table view (CA / TSX market).
   Wired only on the stocks mode page (setups.buy exists); safe no-op if element absent.
   market key 'ca' / localStorage key mdx_stocktable_ca / link pattern canada_stock.html#{ticker}. */
(function(){
  var SECZH = {"Energy":"能源","Materials":"材料","Financials":"金融","Information Technology":"科技","Communication Services":"通信服务","Consumer Staples":"必需消费","Consumer Discretionary":"可选消费","Health Care":"医疗保健","Industrials":"工业","Real Estate":"房地产","Utilities":"公用事业"};
  var GROUP_LABELS = {"entry_open":["ENTRY OPEN","入场开启"],"setting_up":["SETTING UP","蓄势中"]};
  var TIER_ZH = {"PRIME":"极佳","CONFIRMED":"确认","CONFIRMING":"确认中","APPROACHING":"临近","FIRST SPARK":"首信号"};
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum;

  function stageBadge(stage, group) {
    if (!stage) return '<span class="st-muted">—</span>';
    var cls = stage === 'ENTRY' ? 'st-chip-entry' : 'st-chip-rip';
    var glbl = GROUP_LABELS[group];
    var len = glbl ? glbl[0] : (stage === 'ENTRY' ? 'ENTRY' : 'SETTING UP');
    var lzh = glbl ? glbl[1] : (stage === 'ENTRY' ? '入场开启' : '蓄势中');
    return '<span class="st-chip ' + cls + '">' + b(len, lzh) + '</span>';
  }

  var cols = [
    { key:'_ca_stage_grp', labelEn:'Stage', labelZh:'阶段', default:true, sortable:false,
      fmt:function(v,r){ return stageBadge(r.stage||r._stage, r.group); },
      tip:{en:'Entry open (entry-window green) vs Setting up (awaiting trigger); system order is the board rank',zh:'入场开启（入场窗口绿灯）vs 蓄势中（等待触发）；系统顺序即榜单排名'} },
    { key:'ticker', labelEn:'Ticker', labelZh:'代码', default:true, sortable:true,
      fmt:function(v,r){
        var fresh = (r.days_since_signal != null && r.days_since_signal <= 2);
        return (fresh ? '<span class="st-new-dot"></span>' : '') + '<b>' + esc(v||'') + '</b>';
      }},
    { key:'name', labelEn:'Name', labelZh:'名称', default:true, sortable:true,
      fmt:function(v){ return esc(v||''); }},
    { key:'tier', labelEn:'Tier', labelZh:'级别', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return '<span class="st-chip st-chip-entry" style="font-size:9px;padding:1px 6px">' + b(esc(v), esc(TIER_ZH[v]||v)) + '</span>'; }},
    { key:'sector', labelEn:'Sector', labelZh:'板块', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return b(esc(v), esc(SECZH[v]||v)); }},
    { key:'price', labelEn:'Price', labelZh:'价格', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': '$'+fn(v,2); }},
    { key:'off_high', labelEn:'Off High', labelZh:'距高点', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v,1); },
      tip:{en:'% below 52-week high',zh:'距52周高点百分比'} },
    { key:'alpha', labelEn:'Mom Screen', labelZh:'动量筛选', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="' + (v>=0?'st-pos':'st-neg') + '">' + (v>=0?'+':'')+fn(v,2) + '</span>'; },
      tip:{en:'Momentum screen z (sector-neutral residual alpha; display-only, accruing)',zh:'动量筛选 z 值（板块中性残差 alpha；仅展示，累积中）'} },
    { key:'entry_status', labelEn:'Entry', labelZh:'入场', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        var cls = (v==='buy_now'||v==='partial')?'st-pos':(v==='extended'||v==='exit'||v==='avoid'?'st-neg':'');
        return '<span class="' + cls + '">' + esc(v.replace(/_/g,' ')) + '</span>'; },
      tip:{en:'Entry-timing gate: buy_now / partial / buy_soon / wait_pullback / extended …',zh:'入场时机门控：立即买入 / 部分 / 即将买入 / 等回调 / 偏离 …'} },
    { key:'days_since_signal', labelEn:'Days', labelZh:'信号天数', default:false, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v);
        return n<=2 ? '<span class="st-pos">' + n + '</span>' : String(n); },
      tip:{en:'Days since first board appearance (from ledger)',zh:'首次上榜天数（账本记录）'} },
    { key:'conviction', labelEn:'Score', labelZh:'评分', default:false, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v); var cls = n>=70?'st-pos':n>=40?'':'st-neg';
        return '<span class="' + cls + '">' + n + '</span>'; },
      tip:{en:'Conviction score 0-100 (suppressed under Branch-B; null is expected)',zh:'确信度评分0-100（Branch-B下已抑制；空值正常）'} },
  ];

  // use a synthetic key for the stage+group column so it does not collide with a real field
  cols[0].key = '_ca_stage_grp_display';

  /* view persistence */
  var LS_VIEW = 'mdx_stocktable_ca_view';
  var currentView = localStorage.getItem(LS_VIEW) || 'grid';

  function applyView(v) {
    currentView = v;
    localStorage.setItem(LS_VIEW, v);
    var standouts = document.getElementById('standouts');
    var chipsEl   = document.getElementById('st-count-chips');
    var gbtn = document.getElementById('st-btn-grid');
    var tbtn = document.getElementById('st-btn-table');
    if (!standouts) return;
    if (v === 'table') {
      standouts.classList.add('st-table-mode');
      if (chipsEl) chipsEl.style.display = '';
      if (gbtn) gbtn.setAttribute('aria-selected','false');
      if (tbtn) tbtn.setAttribute('aria-selected','true');
    } else {
      standouts.classList.remove('st-table-mode');
      if (chipsEl) chipsEl.style.display = 'none';
      if (gbtn) gbtn.setAttribute('aria-selected','true');
      if (tbtn) tbtn.setAttribute('aria-selected','false');
    }
  }

  StockTable._setView = applyView;

  /* init */
  StockTable.init({
    dataId:      'stocktable-data',
    containerId: 'stocktable-wrap',
    market:      'ca',
    linkPattern: 'canada_stock.html#{ticker}',
    columns:     cols,
  });

  /* restore persisted view */
  applyView(currentView);
})();
</script>
{% endif %}
<script>
  // keep tooltips on-screen: flip below near the top of the viewport, and anchor to the
  // nearest side when the help target is close to the left/right edge (powers the Market
  // State evidence hover popups + every ? tip on the page)
  document.addEventListener('mouseover', function (e) {
    var h = e.target.closest('.help'); if (!h) return;
    var r = h.getBoundingClientRect();
    h.classList.toggle('below', r.top < 340);
    var tip = h.querySelector('.tip');
    var half = ((tip && tip.offsetWidth) || 300) / 2 + 16;
    h.classList.remove('edge-right', 'edge-left');
    if (r.left + r.width / 2 + half > window.innerWidth) h.classList.add('edge-right');
    else if (r.left + r.width / 2 - half < 0) h.classList.add('edge-left');
  });
</script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge). */
(function(){
  function placePop(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  /* Tap the button → toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      /* close any other open popovers */
      document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      if (!wasOpen){ placePop(wrap); wrap.classList.add('nb-cau-open'); }
    } else {
      /* outside tap: close all */
      if (!e.target.closest('.nb-cau-pop')){
        document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      }
    }
  }, true);
  /* Also position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var wrap = e.target.closest && e.target.closest('.nb-cau');
    if (wrap) placePop(wrap);
  }, true);
})();
</script>
{%- if mode != 'stocks' %}
<script>
/* MX5 Canada — dialog / popover / heatmap helpers (macro mode only) */
(function(){
  var _hmMounted=false;
  function caxOpenDlg(id){
    var el=document.getElementById(id);
    if(!el)return;
    document.querySelectorAll('.cax-dlg.open').forEach(function(d){d.classList.remove('open','cax-in','cax-closing');});
    el.classList.add('open');
    document.body.style.overflow='hidden';
    history.replaceState(null,'',location.pathname+'#'+id);
    requestAnimationFrame(function(){requestAnimationFrame(function(){el.classList.add('cax-in');});});
    /* Lazy-mount the Canada heatmap the first time the Markets dialog opens */
    if(id==='cax-dlg-markets'&&!_hmMounted&&window.MMHeatmap&&MMHeatmap.mountScorecard){
      _hmMounted=true;
      try{MMHeatmap.mountScorecard('ca-hm-embed','marketdata/canada_heatmap.json');}
      catch(e){_hmMounted=false;}
    }
    setTimeout(function(){
      if(window.Plotly&&Plotly.Plots){
        el.querySelectorAll('.js-plotly-plot').forEach(function(g){try{
          var host=g.parentElement,w=host?host.clientWidth:0;
          if(Plotly.relayout&&w>10){Plotly.relayout(g,{width:w});}else{Plotly.Plots.resize(g);}
        }catch(e){}});
      }
    },380);
  }
  function caxCloseDlg(){
    document.querySelectorAll('.cax-dlg.open').forEach(function(el){
      var panel=el.querySelector('.cax-dlg-panel');
      el.classList.add('cax-closing');el.classList.remove('cax-in');
      var fired=false;
      var done=function(){if(fired)return;fired=true;if(panel)panel.removeEventListener('transitionend',onEnd);el.classList.remove('open','cax-closing');};
      var onEnd=function(e){if(e.target===panel)done();};
      if(panel)panel.addEventListener('transitionend',onEnd);
      setTimeout(done,360);
    });
    document.body.style.overflow='';
    history.replaceState(null,'',location.pathname);
  }
  function caxTogglePop(id,ev){
    if(ev){ev.stopPropagation();}
    var el=document.getElementById(id);
    if(!el)return;
    var was=el.classList.contains('open');
    caxClosePops();
    if(!was)el.classList.add('open');
  }
  function caxClosePops(){
    document.querySelectorAll('.cax-pop.open').forEach(function(p){p.classList.remove('open');});
  }
  /* hash-resolver */
  function caxResolveHash(){
    var h=(location.hash||'').slice(1);
    if(!h)return;
    var el=document.getElementById(h);
    if(el&&el.classList.contains('cax-dlg'))caxOpenDlg(h);
    else if(el)el.scrollIntoView({behavior:'smooth'});
  }
  /* Escape key: bail if heatmap fullscreen overlay is open */
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){if(document.querySelector('.hm-ov'))return;caxCloseDlg();}});
  document.addEventListener('click',function(){caxClosePops();});
  window.caxOpenDlg=caxOpenDlg;
  window.caxCloseDlg=caxCloseDlg;
  window.caxTogglePop=caxTogglePop;
  window.caxClosePops=caxClosePops;
  caxResolveHash();
  window.addEventListener('hashchange',caxResolveHash);
})();
</script>
