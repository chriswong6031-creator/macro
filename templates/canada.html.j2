<script>
/* Path-chart hover enhancement (ported from US mx5 path JS). Pure progressive layer:
   reads data-points (viewBox x/y baked in) + the SVG's live rect, maps viewBox→screen
   so the crosshair/dot/tooltip stay crisp under the SVG's non-uniform stretch. The verdict
   colours are read from the page's --up/--down/--warn CSS vars (NOT hard-coded hex) so they
   flip correctly in zh (红涨绿跌); chart is fully legible without this layer. */
(function(){
  var svg = document.querySelector('.cax-hero-right .mx5-path-svg[data-points]');
  if(!svg) return;
  var plot = svg.closest('.mx5-path-plot'); if(!plot) return;
  var cross = plot.querySelector('.mx5-path-cross');
  var dot   = plot.querySelector('.mx5-path-dot');
  var tip   = plot.querySelector('.mx5-path-tip');
  if(!cross || !dot || !tip) return;
  var tDate = tip.querySelector('.mx5-path-tip-date');
  var tScore= tip.querySelector('.mx5-path-tip-score');
  var tVerd = tip.querySelector('.mx5-path-tip-verdict');
  var pts;
  try { pts = JSON.parse(svg.getAttribute('data-points') || '[]'); } catch(e){ return; }
  if(!pts.length) return;
  var VBW = +(svg.getAttribute('data-vbw')||1000);
  var VBH = +(svg.getAttribute('data-vbh')||224);
  /* read live theme colours so zh (红涨绿跌) flips the dot/verdict tint automatically */
  function col(v){
    var cs = getComputedStyle(document.documentElement);
    var name = v==='Risk-on' ? '--up' : (v==='Risk-off' ? '--down' : '--warn');
    return (cs.getPropertyValue(name)||'').trim() || '#f59e0b';
  }
  function isZh(){
    var el=document.documentElement;
    return (el.getAttribute('data-lang')||'').slice(0,2)==='zh';
  }
  function nearest(clientX){
    var r = svg.getBoundingClientRect();
    var vx = (clientX - r.left) / r.width * VBW;
    var best=0, bd=Infinity;
    for(var i=0;i<pts.length;i++){ var d=Math.abs(pts[i].x - vx); if(d<bd){ bd=d; best=i; } }
    return best;
  }
  function show(i){
    var p = pts[i]; if(!p) return;
    var r = svg.getBoundingClientRect();
    var pr = plot.getBoundingClientRect();
    var sx = (p.x / VBW) * r.width  + (r.left - pr.left);
    var sy = (p.y / VBH) * r.height + (r.top  - pr.top);
    var c = col(p.v);
    cross.style.left = sx + 'px';   cross.style.opacity = '1';
    dot.style.left = sx + 'px';     dot.style.top = sy + 'px';
    dot.style.background = c;
    dot.style.opacity = '1';
    tDate.textContent = isZh() ? (p.mz || p.d) : (p.md || p.d);
    tScore.textContent = p.s;
    tVerd.textContent = isZh() ? (p.vz||p.v) : p.v;
    tVerd.style.color = c;
    var half = tip.offsetWidth/2 || 60;
    var clx = Math.max(half+2, Math.min(pr.width-half-2, sx));
    tip.style.left = clx + 'px';
    tip.style.top  = sy + 'px';
    tip.classList.add('show');
  }
  function hide(){ cross.style.opacity='0'; dot.style.opacity='0'; tip.classList.remove('show'); }
  var raf=0, lastX=0;
  function onMove(clientX){ lastX=clientX; if(raf) return; raf=requestAnimationFrame(function(){ raf=0; show(nearest(lastX)); }); }
  svg.addEventListener('mousemove', function(e){ onMove(e.clientX); });
  svg.addEventListener('mouseleave', hide);
  svg.addEventListener('touchstart', function(e){ if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX)); }, {passive:true});
  svg.addEventListener('touchmove', function(e){ if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX)); }, {passive:true});
  svg.addEventListener('touchend', function(){ setTimeout(hide, 1400); }, {passive:true});
  document.addEventListener('langchange', function(){ if(tip.classList.contains('show')) show(nearest(lastX)); });
})();
</script>
<script>
/* MX5 Canada — dialog / popover / heatmap helpers (macro mode only) */
(function(){
  var _hmMounted=false;
  function caxOpenDlg(id){
    var el=document.getElementById(id);
    if(!el)return;
    document.querySelectorAll('.cax-dlg.open').forEach(function(d){d.classList.remove('open','cax-in','cax-closing');});
    el.classList.add('open');
    document.body.style.overflow='hidden';
    history.replaceState(null,'',location.pathname+'#'+id);
    requestAnimationFrame(function(){requestAnimationFrame(function(){el.classList.add('cax-in');});});
    /* Lazy-mount the Canada heatmap the first time the Markets dialog opens */
    if(id==='cax-dlg-markets'&&!_hmMounted){
      var mountHm=function(){
        if(_hmMounted||!el.classList.contains('open')||!window.MMHeatmap||!MMHeatmap.mountScorecard)return;
        _hmMounted=true;
        try{MMHeatmap.mountScorecard('ca-hm-embed','marketdata/canada_heatmap.json');}
        catch(e){_hmMounted=false;}
      };
      if(window.MMHeatmap)mountHm();
      else if(window.mmLoadHeatmap)window.mmLoadHeatmap().then(mountHm).catch(function(){});
    }
    /* Replay the ilx / Signal-Ink charts in this dialog. They're already laid out
       (stretch to their column via illus.css); ilxReveal restarts the ink draw once
       the panel entrance has settled, so every open re-animates. */
    if(window.ilxReveal){setTimeout(function(){ilxReveal(el);},340);}
  }
  /* IN-PAGE ilx charts (commodities / rates spread / breadth / housing cards) are new on
     this page — every other dashboard puts its ilx charts inside dialogs, where the open
     handler above reveals them. In-page figures otherwise depend solely on illus.js's
     IntersectionObserver, so anything already above the fold at load, or any browser where
     the observer is slow to fire, would sit at its undrawn start state (stroke-dashoffset ==
     dasharray, i.e. an empty card). ilxReveal() is illus.js's documented reliability
     fallback: it skips figures the observer already handled (no mid-draw flicker) and skips
     display-hidden dialog charts, so this only backfills the in-page ones. */
  (function(){
    var go=function(){ if(window.ilxReveal){ ilxReveal(document); } };
    if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){setTimeout(go,60);});}
    else{setTimeout(go,60);}
  })();
  function caxCloseDlg(){
    document.querySelectorAll('.cax-dlg.open').forEach(function(el){
      var panel=el.querySelector('.cax-dlg-panel');
      el.classList.add('cax-closing');el.classList.remove('cax-in');
      var fired=false;
      var done=function(){if(fired)return;fired=true;if(panel)panel.removeEventListener('transitionend',onEnd);el.classList.remove('open','cax-closing');};
      var onEnd=function(e){if(e.target===panel)done();};
      if(panel)panel.addEventListener('transitionend',onEnd);
      setTimeout(done,360);
    });
    document.body.style.overflow='';
    history.replaceState(null,'',location.pathname);
  }
  function caxTogglePop(id,ev){
    if(ev){ev.stopPropagation();}
    var el=document.getElementById(id);
    if(!el)return;
    var was=el.classList.contains('open');
    caxClosePops();
    if(!was)el.classList.add('open');
  }
  function caxClosePops(){
    document.querySelectorAll('.cax-pop.open').forEach(function(p){p.classList.remove('open');});
  }
  /* hash-resolver */
  function caxResolveHash(){
    var h=(location.hash||'').slice(1);
    if(!h)return;
    var el=document.getElementById(h);
    if(el&&el.classList.contains('cax-dlg'))caxOpenDlg(h);
    else if(el)el.scrollIntoView({behavior:'smooth'});
  }
  /* Escape key: bail if heatmap fullscreen overlay is open */
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){if(document.querySelector('.hm-ov'))return;caxCloseDlg();}});
  document.addEventListener('click',function(){caxClosePops();});
  window.caxOpenDlg=caxOpenDlg;
  window.caxCloseDlg=caxCloseDlg;
  window.caxTogglePop=caxTogglePop;
  window.caxClosePops=caxClosePops;
  /* Resolve only after the dialog DOM and lazy heatmap loader are available. */
  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',caxResolveHash);
  }else{
    caxResolveHash();
  }
  window.addEventListener('hashchange',caxResolveHash);
})();
</script>
