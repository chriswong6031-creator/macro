  [data-theme="light"] body.page-canada .cax-links a,[data-theme="light"] body.page-canada .cax-dh{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-canada .cax-hero-left{border-right-color:rgba(0,0,0,.08)}
  [data-theme="light"] body.page-canada .cax-row,[data-theme="light"] body.page-canada .cax-kv,[data-theme="light"] body.page-canada .cax-foot,[data-theme="light"] body.page-canada .cax-stk,[data-theme="light"] body.page-canada .cax-ledd,[data-theme="light"] body.page-canada .cax-receipt,[data-theme="light"] body.page-canada table.cax-mt td,[data-theme="light"] body.page-canada table.cax-mt th{border-color:rgba(0,0,0,.08)}
  [data-theme="light"] body.page-canada .cax-pop-bar,[data-theme="light"] body.page-canada .cax-sep,[data-theme="light"] body.page-canada .cax-fbar,[data-theme="light"] body.page-canada .cax-heat i.n{background:rgba(0,0,0,.09)}
  [data-theme="light"] body.page-canada .cax-hbtn{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.12)}
  [data-theme="light"] body.page-canada .cax-hbtn:hover{background:rgba(0,0,0,.06)}
  [data-theme="light"] body.page-canada .cax-chip:not(.hot):not(.turn),[data-theme="light"] body.page-canada .cax-ihcard,[data-theme="light"] body.page-canada .cax-hm-wrap,[data-theme="light"] body.page-canada .cax-nchip{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.1)}
  [data-theme="light"] body.page-canada .cax-regime-pill{border-color:rgba(0,0,0,.12)}
  [data-theme="light"] body.page-canada .cax-chip.hot{color:#b4232a}
  [data-theme="light"] body.page-canada .cax-chip.turn{color:#1f7a44}
  [data-theme="light"] body.page-canada .cax-tkr-btn{color:#2456a8}
  /* ── Aurora backdrop (state-keyed ambient glow, fixed behind all content) ── */
  .cax-aurora{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
  .cax-aurora::before{content:'';position:absolute;width:900px;height:700px;top:-200px;left:-150px;filter:blur(90px);background:radial-gradient(ellipse,rgba(34,217,122,.12) 0%,transparent 70%)}
  .cax-aurora::after{content:'';position:absolute;width:700px;height:600px;bottom:-100px;right:-100px;filter:blur(90px);background:radial-gradient(ellipse,rgba(99,102,241,.10) 0%,transparent 70%)}
  .cax-aurora .cax-a3{position:absolute;width:600px;height:500px;top:40%;left:50%;transform:translate(-50%,-50%);filter:blur(90px);background:radial-gradient(ellipse,rgba(34,217,122,.07) 0%,transparent 70%)}
  .cax-aurora .cax-a4{position:absolute;width:800px;height:600px;bottom:-150px;left:20%;filter:blur(90px);background:radial-gradient(ellipse,rgba(99,102,241,.08) 0%,transparent 70%)}
  /* state tints */
  .cax-aurora.au-yellow::before{background:radial-gradient(ellipse,rgba(245,158,11,.10) 0%,transparent 70%)}
  .cax-aurora.au-yellow .cax-a3{background:radial-gradient(ellipse,rgba(245,158,11,.06) 0%,transparent 70%)}
  .cax-aurora.au-red::before{background:radial-gradient(ellipse,rgba(239,68,68,.10) 0%,transparent 70%)}
  .cax-aurora.au-red .cax-a3{background:radial-gradient(ellipse,rgba(239,68,68,.06) 0%,transparent 70%)}
  /* light mode — much fainter */
  [data-theme="light"] .cax-aurora::before{background:radial-gradient(ellipse,rgba(34,217,122,.05) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora::after{background:radial-gradient(ellipse,rgba(99,102,241,.04) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora .cax-a3{background:radial-gradient(ellipse,rgba(34,217,122,.03) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora .cax-a4{background:radial-gradient(ellipse,rgba(99,102,241,.04) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora.au-yellow::before{background:radial-gradient(ellipse,rgba(156,98,18,.05) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora.au-yellow .cax-a3{background:radial-gradient(ellipse,rgba(156,98,18,.035) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora.au-red::before{background:radial-gradient(ellipse,rgba(220,38,38,.05) 0%,transparent 70%)}
  [data-theme="light"] .cax-aurora.au-red .cax-a3{background:radial-gradient(ellipse,rgba(220,38,38,.035) 0%,transparent 70%)}
  /* ensure page content sits above the aurora z-layer */
  body.page-canada .cax-wrap{position:relative;z-index:1}
  body.page-canada .site-nav{position:relative;z-index:2}
  body.page-canada .panel{position:relative;z-index:1}
  @media(prefers-reduced-motion:reduce){.cax-aurora,.cax-aurora::before,.cax-aurora::after,.cax-aurora .cax-a3,.cax-aurora .cax-a4{animation:none;transition:none}}
{%- endif %}{# /mode != stocks — MX5 CSS #}

{% if mode == 'stocks' %}
  /* ── W8-G: Standout table view (CA port of W8-E) ──────────────────────── */
  .st-view-toggle { display:inline-flex; gap:3px; padding:3px; border-radius:8px;
    background:var(--panel2,color-mix(in srgb,var(--muted) 10%,var(--panel)));
