<script>
/* W8-G: StockTable init — standout board table view (CA / TSX market).
   Wired only on the stocks mode page (setups.buy exists); safe no-op if element absent.
   market key 'ca' / localStorage key mdx_stocktable_ca / link pattern canada_stock.html#{ticker}. */
(function(){
function initStockTableView(){
  if (!window.StockTable) return;
  var SECZH = {"Energy":"能源","Materials":"材料","Financials":"金融","Information Technology":"科技","Communication Services":"通信服务","Consumer Staples":"必需消费","Consumer Discretionary":"可选消费","Health Care":"医疗保健","Industrials":"工业","Real Estate":"房地产","Utilities":"公用事业"};
  var GROUP_LABELS = {"entry_open":["ENTRY OPEN","入场开启"],"setting_up":["SETTING UP","蓄势中"]};
  var TIER_ZH = {"PRIME":"极佳","CONFIRMED":"确认","CONFIRMING":"确认中","APPROACHING":"临近","FIRST SPARK":"首信号"};
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum;

  function stageBadge(stage, group) {
    if (!stage) return '<span class="st-muted">—</span>';
    var cls = stage === 'ENTRY' ? 'st-chip-entry' : 'st-chip-rip';
    var glbl = GROUP_LABELS[group];
    var len = glbl ? glbl[0] : (stage === 'ENTRY' ? 'ENTRY' : 'SETTING UP');
    var lzh = glbl ? glbl[1] : (stage === 'ENTRY' ? '入场开启' : '蓄势中');
    return '<span class="st-chip ' + cls + '">' + b(len, lzh) + '</span>';
  }

  var cols = [
    { key:'_ca_stage_grp', labelEn:'Stage', labelZh:'阶段', default:true, sortable:false,
      fmt:function(v,r){ return stageBadge(r.stage||r._stage, r.group); },
      tip:{en:'Entry open (entry-window green) vs Setting up (awaiting trigger); system order is the board rank',zh:'入场开启（入场窗口绿灯）vs 蓄势中（等待触发）；系统顺序即榜单排名'} },
    { key:'ticker', labelEn:'Ticker', labelZh:'代码', default:true, sortable:true,
      fmt:function(v,r){
        var fresh = (r.days_since_signal != null && r.days_since_signal <= 2);
        return (fresh ? '<span class="st-new-dot"></span>' : '') + '<b>' + esc(v||'') + '</b>';
      }},
    { key:'name', labelEn:'Name', labelZh:'名称', default:true, sortable:true,
      fmt:function(v){ return esc(v||''); }},
    { key:'tier', labelEn:'Tier', labelZh:'级别', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return '<span class="st-chip st-chip-entry" style="font-size:9px;padding:1px 6px">' + b(esc(v), esc(TIER_ZH[v]||v)) + '</span>'; }},
    { key:'sector', labelEn:'Sector', labelZh:'板块', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return b(esc(v), esc(SECZH[v]||v)); }},
    { key:'price', labelEn:'Price', labelZh:'价格', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': '$'+fn(v,2); }},
    { key:'off_high', labelEn:'Off High', labelZh:'距高点', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v,1); },
      tip:{en:'% below 52-week high',zh:'距52周高点百分比'} },
    { key:'alpha', labelEn:'Mom Screen', labelZh:'动量筛选', default:true, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="' + (v>=0?'st-pos':'st-neg') + '">' + (v>=0?'+':'')+fn(v,2) + '</span>'; },
      tip:{en:'Momentum screen z (sector-neutral residual alpha; display-only, accruing)',zh:'动量筛选 z 值（板块中性残差 alpha；仅展示，累积中）'} },
    { key:'entry_status', labelEn:'Entry', labelZh:'入场', default:true, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        var cls = (v==='buy_now'||v==='partial')?'st-pos':(v==='extended'||v==='exit'||v==='avoid'?'st-neg':'');
        return '<span class="' + cls + '">' + esc(v.replace(/_/g,' ')) + '</span>'; },
      tip:{en:'Entry-timing gate: buy_now / partial / buy_soon / wait_pullback / extended …',zh:'入场时机门控：立即买入 / 部分 / 即将买入 / 等回调 / 偏离 …'} },
    { key:'days_since_signal', labelEn:'Days', labelZh:'信号天数', default:false, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v);
        return n<=2 ? '<span class="st-pos">' + n + '</span>' : String(n); },
      tip:{en:'Days since first board appearance (from ledger)',zh:'首次上榜天数（账本记录）'} },
    { key:'conviction', labelEn:'Score', labelZh:'评分', default:false, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v); var cls = n>=70?'st-pos':n>=40?'':'st-neg';
        return '<span class="' + cls + '">' + n + '</span>'; },
      tip:{en:'Conviction score 0-100 (suppressed under Branch-B; null is expected)',zh:'确信度评分0-100（Branch-B下已抑制；空值正常）'} },
  ];

  // use a synthetic key for the stage+group column so it does not collide with a real field
  cols[0].key = '_ca_stage_grp_display';

  /* view persistence */
  var LS_VIEW = 'mdx_stocktable_ca_view';
  var currentView = localStorage.getItem(LS_VIEW) || 'grid';

  function applyView(v) {
    currentView = v;
    localStorage.setItem(LS_VIEW, v);
    var standouts = document.getElementById('standouts');
    var chipsEl   = document.getElementById('st-count-chips');
    var gbtn = document.getElementById('st-btn-grid');
    var tbtn = document.getElementById('st-btn-table');
    if (!standouts) return;
    if (v === 'table') {
      standouts.classList.add('st-table-mode');
      if (chipsEl) chipsEl.style.display = '';
      if (gbtn) gbtn.setAttribute('aria-selected','false');
      if (tbtn) tbtn.setAttribute('aria-selected','true');
    } else {
      standouts.classList.remove('st-table-mode');
      if (chipsEl) chipsEl.style.display = 'none';
      if (gbtn) gbtn.setAttribute('aria-selected','true');
      if (tbtn) tbtn.setAttribute('aria-selected','false');
    }
  }

  StockTable._setView = applyView;

  /* init */
  StockTable.init({
    dataId:      'stocktable-data',
    containerId: 'stocktable-wrap',
    market:      'ca',
    linkPattern: 'canada_stock.html#{ticker}',
    columns:     cols,
  });

  /* restore persisted view */
  applyView(currentView);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initStockTableView, { once: true });
} else {
  initStockTableView();
}
})();
</script>
