<!-- Pullback Risk dialog -->
<div class="cax-dlg" id="cax-dlg-risk">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('Pullback Risk Radar','回撤风险雷达') }}</span>
      <button class="cax-dlg-close" onclick="caxCloseDlg()">✕</button>
    </div>
    <div class="cax-dlg-body">
      {% if _rr_score is not none %}
      <div class="cax-eyebrow">{{ t('CA External Risk Monitor','加拿大外部风险监控') }}</div>
      <div style="font-size:28px;font-weight:750;color:var(--act)">{{ _rr_score }}<span style="font-size:14px;color:var(--muted)">/100</span></div>
      <div style="font-size:13px;color:var(--muted);margin-bottom:12px">{{ t(_rr.get('label_en') or _rr_do_en, _rr.get('label_zh') or _rr_do_zh) }}</div>
      {% for leg in (_rr.get('scares') or []) %}
      <div class="cax-frow">
        <span>{{ t(leg.get('label_en') or leg.get('scare',''), leg.get('label_zh') or leg.get('scare','')) }}</span>
        <div class="cax-fbar"><i style="width:{{ leg.score|round|int }}%;background:var(--act)"></i></div>
        <span class="cax-fscore cax-tt-dn">{{ leg.score|round|int }}</span>
      </div>
      {% endfor %}
      {% if _rr_p21 is not none %}
      <div style="margin-top:12px;font-size:12.5px">{{ t('~%d%% ≥5%% pullback probability within 21d'|format((_rr_p21*100)|round|int), '未来21日内≥5%%回撤概率约%d%%'|format((_rr_p21*100)|round|int)) }}</div>
      {% endif %}
      {% if _rr.get('caveat_en') %}<div class="cax-receipt">{{ t(_rr.caveat_en, _rr.get('caveat_zh') or _rr.caveat_en) }}</div>{% endif %}
      {% else %}
      <div style="font-size:12px;color:var(--muted)">{{ t('No radar data available.','暂无雷达数据。') }}</div>
      {% endif %}
    </div>
  </div>
</div>

<!-- What To Do / Playbook dialog -->
<div class="cax-dlg" id="cax-dlg-playbook">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('What To Do','该怎么做') }}</span>
      <button class="cax-dlg-close" onclick="caxCloseDlg()">✕</button>
    </div>
    <div class="cax-dlg-body">
      {% if actions %}
      {% set abmap = [('buy_now','arrow_up','ic-up','Buy now','立即买入'),('buy_soon','clock','ic-link','Buy soon','即将买入'),('on_the_run','trend_up','ic-violet','On the run — do not chase','顺势运行 — 勿追高'),('take_profits','profits','ic-warn','Take profits','止盈'),('hold','hold','ic-mut','Hold','持有'),('avoid','avoid','ic-dn','Avoid','回避')] %}
      {% for key, ic, iccls, en, zh in abmap %}
      {% set items = actions.get(key, []) %}
      {% if items %}
      <div class="cax-eyebrow"><span class="cax-pb-ic">{{ icon(ic, iccls) }}</span> {{ t(en, zh) }}</div>
      {% for it in items %}
      <div class="cax-ledd">
        <span><b>{{ td(it.name) }}</b> <span class="rk">{{ it.ticker }}</span>
          {% if it.tag %}<span style="font-size:10px;color:var(--warn);margin-left:5px">{{ it.tag }}</span>{% endif %}
        </span>
        <span style="display:flex;gap:6px;align-items:center">
          {% if it.days is not none %}<span class="rk" style="font-size:10px" data-tip-en="Days to trigger" data-tip-zh="触发天数">{{ it.days }}d</span>{% endif %}
          {% if it.dir %}<span class="lad {{ 'up' if it.dir == 'up' else ('down' if it.dir == 'down' else 'flat') }}" style="font-size:10px">{{ t({'up':'▲ Up','down':'▼ Down','caution':'◐ Caution'}.get(it.dir, it.dir), {'up':'▲ 上升','down':'▼ 下降','caution':'◐ 谨慎'}.get(it.dir, it.dir)) }}</span>{% endif %}
        </span>
      </div>
      {% endfor %}
      {% endif %}
      {% endfor %}
      {% else %}
      <div style="font-size:12px;color:var(--muted)">{{ t('Action data loading…','操作数据加载中…') }}</div>
      {% endif %}
    </div>
  </div>
</div>

<!-- Regime Watch dialog -->
<div class="cax-dlg" id="cax-dlg-regime">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('Regime Watch','周期观察') }}</span>
      <button class="cax-dlg-close" onclick="caxCloseDlg()">✕</button>
    </div>
    <div class="cax-dlg-body">
      <div class="cax-eyebrow">{{ t('Current quad','当前象限') }}</div>
      <div style="font-size:18px;font-weight:750;margin-bottom:8px">{{ td(latest.quad_name) }}</div>
      {% if quad_meaning %}<p style="font-size:12.5px;color:var(--muted);margin:0 0 12px">{{ t(quad_meaning[0], quad_meaning[1]) }}</p>{% endif %}
      {# Sector preference check: does tape agree with regime? (GAP 15) #}
      {% if pref and pref.get('preferred') %}
      <div class="cax-eyebrow">{{ t('Quad-preferred sectors','象限偏好板块') }}</div>
      <div class="cax-chips" style="margin-bottom:10px">
        {% for tk in (pref.preferred or []) %}<span class="cax-chip {{ 'turn' if not pref.disagreement_flag else '' }}">{{ tk }}</span>{% endfor %}
      </div>
      {% if pref.note %}<div style="font-size:11px;color:var(--muted);margin-bottom:8px">{{ pref.note }}</div>{% endif %}
      {% endif %}
      <div class="cax-eyebrow">{{ t('Lifespan base rates','寿命基准率') }}</div>
      {% if lifespan_rows %}
      <div class="cax-mt" style="overflow-x:auto">
      <table class="cax-mt">
        <tr><th>{{ t('Quad','象限') }}</th><th class="r">{{ t('Median (d)','中位数(天)') }}</th><th class="r">{{ t('n','样本数') }}</th><th>{{ t('Typical next','典型下一象限') }}</th></tr>
        {% for row in lifespan_rows %}
        <tr><td>{{ td(row.quad) }}</td><td class="r">{{ row.median_days }}</td><td class="r">{{ row.n }}</td><td style="font-size:11px">{{ t(row.next, row.next_zh) }}</td></tr>
        {% endfor %}
      </table>
      </div>
      {% endif %}
      {% if axes_chart %}
      <div class="cax-sep"></div>
      <div class="cax-eyebrow">{{ t('Growth & inflation axes over time','增长与通胀轴历史') }}</div>
      <div class="cax-ilx">{{ axes_chart | safe }}</div>
      <div style="font-size:10.5px;color:var(--muted);margin-top:4px">{{ t('Above the dashed line = expanding / heating; below = contracting / cooling.','虚线上方＝扩张／升温；下方＝收缩／降温。') }}</div>
      {% endif %}
      <div class="cax-receipt">{{ t('Display-only. Quad dates vary; confirm with the macro backdrop.','仅供展示。象限日期因情况而异，请结合宏观背景确认。') }}</div>
    </div>
  </div>
</div>

<!-- Breadth dialog -->
<div class="cax-dlg" id="cax-dlg-breadth">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
