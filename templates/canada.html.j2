  /* zh 红涨绿跌: color-mix over var(--up)/var(--down) so pills flip automatically in zh */
  body.page-canada .ms-green .cax-regime-pill{background:color-mix(in srgb,var(--up) 10%,transparent)}
  body.page-canada .ms-red .cax-regime-pill{background:color-mix(in srgb,var(--down) 10%,transparent)}
