<!-- Market Participation dialog — illustrated breadth read (field + contribution bars) -->
{% set _cs = ca_sentiment if (ca_sentiment is defined and ca_sentiment) else none %}
<div class="cax-dlg" id="cax-dlg-sentiment">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel{% if _cs %} mp-{{ _cs.zone }}{% endif %}">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('Market Participation','市场参与度') }}</span>
