<!-- Commodities & FX dialog -->
<div class="cax-dlg" id="cax-dlg-commod">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('Commodities & FX Overlay','大宗商品与汇率叠加') }}</span>
      <button class="cax-dlg-close" onclick="caxCloseDlg()">✕</button>
    </div>
    <div class="cax-dlg-body">
      <div class="cax-eyebrow">{{ t('Overlay state','叠加状态') }}: <span class="cax-stword {{ 'ok' if ov.state == 'Risk-on' else ('bad' if ov.state == 'Risk-off' else 'warn') }}">{{ td(ov.state or '—') }}</span></div>
      {% if ov.score is not none %}<div style="font-size:12px;color:var(--muted);margin-bottom:10px">{{ t('Composite','综合') }} {{ '%+.2f'|format(ov.score) }}</div>{% endif %}
      {% for f in (ov.factors or []) %}
      <div class="cax-frow">
        <span>{{ td(f.label) }}</span>
        <div class="cax-fbar"><i style="width:{{ ([f.z + 3, 0]|max / 6 * 100)|round|int }}%;background:{{ 'var(--up)' if f.risk == 'on' else ('var(--down)' if f.risk == 'off' else 'var(--muted)') }}"></i></div>
