        <span>{{ t(c.label_en, c.label_zh) }}</span>
        <div class="cax-fbar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'good' else ('var(--down)' if c.tone == 'bad' else 'var(--warn)') }}"></i></div>
        <span class="cax-fscore {{ 'cax-tt-up' if c.tone == 'good' else ('cax-tt-dn' if c.tone == 'bad' else 'cax-tt-fl') }}">{{ c.score }}</span>
