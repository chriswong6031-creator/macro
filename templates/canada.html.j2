<body class="page-canada">

{% include "_site_nav.html.j2" %}

{% if mode == 'stocks' %}
<div class="panel">
  <div class="row">
    <h1>{{ t('TSX Stock Dashboard', '标普/TSX 个股看板') }}</h1>
    <span style="flex:1"></span>
    <span class="muted small">{{ t('data through', '数据截至') }} {{ latest.date }} · {{ t('built', '生成') }} {{ built }}</span>
  </div>
  <p class="muted small" style="margin:6px 0 0">{{ t('A shortlist of TSX stocks that look ready to buy, with a suggested buy zone for each. Search any TSX stock in the box above, or click a card for the full breakdown.', '一份看起来可以买入的 TSX 个股短名单，并为每只标注建议买入区间。可在上方搜索框查询任意 TSX 个股，或点击卡片查看完整拆解。') }}
    <a href="canada.html" style="color:var(--link);font-weight:600">← {{ t('Canada macro dashboard', '加拿大宏观看板') }}</a></p>
</div>
{% endif %}

{% if mode == 'stocks' and actions and (actions.get('buy_now') or actions.get('buy_soon') or actions.get('on_the_run') or actions.get('take_profits') or actions.get('hold') or actions.get('avoid')) %}
<!-- ===== Act-Now v2 — four-lane board, matching china_stocks.html ===== -->
{% set _ca_buy = actions.get('buy_now', []) %}
{% set _ca_pull = actions.get('on_the_run', []) + actions.get('hold', []) %}
{% set _ca_bot = actions.get('buy_soon', []) %}
{% set _ca_red = actions.get('take_profits', []) + actions.get('avoid', []) %}
<style>
.anv2-board .anv2-name-link{color:inherit;text-decoration:none}
.anv2-board .anv2-name-link:hover .l-en,.anv2-board .anv2-name-link:hover .l-zh{text-decoration:underline}
.anv2-board .anv2-name-link:focus-visible{outline:2px solid var(--link);outline-offset:2px;border-radius:4px}
.anv2-board .anv2-go{font-size:10px;opacity:.55;margin-left:3px}
.anv2-board .anv2-empty{padding:10px 13px;color:var(--muted);font-size:11px}
</style>
{{ lens.lens_css() }}
<div class="panel anv2-board" id="act-now">
    {{ dc.dc_css() }}
  <div class="anv2-hd">
    <h2>⚡ {{ t('What to Act On Now', '现在行动') }}
      <span class="anv2-v2pill">v2</span>
      {{ lens.lens(
          kind='read', ill=lens.ILL_LANES,
          kick=('How to read this','如何看懂'),
          title=('Four lanes, left to right','四个分栏，从左到右'),
          rows=[
            {'tone':'up',   'k':('Buy now','立即买入'),        'v':('A clean TSX sector entry today.','今天有干净的TSX板块入场点。')},
            {'tone':'info', 'k':('In favour','看好'),          'v':('Still good — but it has run. <b>Wait for a dip.</b>','依然看好 — 但已经涨过。<b>等回调。</b>')},
            {'tone':'warn', 'k':('Bottoming','洗盘观察'),      'v':('Setting up near a cycle low. <b>Watch only — never a buy signal.</b>','接近周期低点并开始形成形态。<b>仅供观察 — 绝非买入信号。</b>')},
            {'tone':'dn',   'k':('Reduce / avoid','减仓·回避'),'v':('The trend is weakening — take profits or stay away.','趋势正在转弱 — 止盈或回避。')},
          ],
          body=('This is a structure and risk map for sectors — not an allocation rule.','这是板块的结构与风险图 — 不是配置规则。'),
          receipt=('sector positioning · timed by cycle stage · re-drawn nightly','板块定位 · 按周期阶段定时机 · 每晚重绘')) }}
    </h2>
    <div class="anv2-meta">
      <span class="muted" style="font-size:11px">{{ t('sectors as of', '板块截至') }} {{ latest.date }}</span>
    </div>
  </div>
  <div class="anv2-grid">
    {%- macro _ca_anrow(it, lane) -%}
    {%- set _ca_sc = (sectors_by_ticker.get(it.ticker) if sectors_by_ticker is defined else none) -%}
    <div class="anv2-row" data-rpop>
      {#- Hover decision card — the SAME component the US board uses
          (templates/_decision_card.html.j2). Canada shipped with NO hover at all;
          this is the sector variant: setup read, cycle metrics, one stance. -#}
      {%- set _ca_tone = 'up' if it.dir == 'up' else ('dn' if it.dir == 'dn' else 'warn') -%}
      {%- set _ca_stats = [] -%}
      {%- set _ca_trust = [] -%}
      {%- if _ca_sc is not none and _ca_sc.get('mom20') is not none -%}
        {%- set _ = _ca_stats.append({'label': ('20d move','20日动能'), 'val': '%+.1f%%'|format(_ca_sc.get('mom20')),
                                      'tone': 'up' if _ca_sc.get('mom20') >= 0 else 'dn', 'sub': ('vs the TSX','相对TSX')}) -%}
      {%- endif -%}
      {%- if _ca_sc is not none and _ca_sc.get('mom60') is not none -%}
        {%- set _ = _ca_stats.append({'label': ('60d move','60日动能'), 'val': '%+.1f%%'|format(_ca_sc.get('mom60')),
                                      'tone': 'up' if _ca_sc.get('mom60') >= 0 else 'dn', 'sub': ('vs the TSX','相对TSX')}) -%}
      {%- endif -%}
      {%- if _ca_sc is not none and _ca_sc.get('eq_badge') is not none -%}
        {%- set _ = _ca_stats.append({'label': ('Entry','入场'), 'val': _ca_sc.get('eq_badge'),
                                      'sub': ('timing quality','时机质量')}) -%}
      {%- elif _ca_sc is not none and _ca_sc.get('pctile') is not none -%}
        {%- set _ = _ca_stats.append({'label': ('Strength rank','强度排名'), 'val': '%.0f'|format(_ca_sc.get('pctile')) ~ 'p',
                                      'sub': ('vs its own year','对比自身一年')}) -%}
      {%- endif -%}
      {%- if _ca_sc is not none and _ca_sc.get('above200') is not none -%}
        {%- set _ = _ca_trust.append({'tone': 'up' if _ca_sc.get('above200') else '',
                                      'en': ('▲ Above the 200-day' if _ca_sc.get('above200') else 'Below the 200-day'),
                                      'zh': ('▲ 高于200日均线' if _ca_sc.get('above200') else '低于200日均线')}) -%}
      {%- endif -%}
      {%- set _ca_sub_en -%}
      {%- if it.days is not none %}Signal ~{{ it.days }}d{% endif -%}
      {%- if it.days is not none and _ca_sc is not none and _ca_sc.get('dc_day') is not none %} · {% endif -%}
      {%- if _ca_sc is not none and _ca_sc.get('dc_day') is not none %}cycle day {{ _ca_sc.get('dc_day') }}{% endif -%}
      {%- endset -%}
      {%- set _ca_sub_zh -%}
      {%- if it.days is not none %}信号约 {{ it.days }} 天{% endif -%}
      {%- if it.days is not none and _ca_sc is not none and _ca_sc.get('dc_day') is not none %} · {% endif -%}
      {%- if _ca_sc is not none and _ca_sc.get('dc_day') is not none %}周期第 {{ _ca_sc.get('dc_day') }} 日{% endif -%}
      {%- endset -%}
      {{ dc.dc_card({
        'kind': 'sector', 'mark': '🏛', 'tone': _ca_tone,
        'eyebrow': ('Sector pulse · ' ~ it.ticker, '板块脉搏 · ' ~ it.ticker),
        'name': (td(it.name),),
        'tag': (td(it.label),) if it.label else none,
        'kicker': ('Current setup','当前形态'),
        'read': ('Entry open today','今日入场窗口开启') if lane == 'buy'
                else (('Turning up from the low','自低位回升') if lane == 'bot'
                else (('Momentum fading','动能转弱') if lane == 'red'
                else ('In favour — but it has run','仍看好 — 但已上涨'))),
        'sub': (_ca_sub_en|trim, _ca_sub_zh|trim),
        'trust': _ca_trust, 'stats': _ca_stats,
        'takeaway': ('A clean entry is open today.','今日入场窗口干净。') if lane == 'buy'
                else (('Turning up from the low — watch it, do not chase it.','自低位回升 — 观察为主，不要追。') if lane == 'bot'
                else (('Momentum is fading — protect gains and avoid fresh adds.','动能转弱 — 保护利润，避免加仓。') if lane == 'red'
                else ('Still in favour, but it has run — wait for a dip.','仍然看好，但已上涨 — 等回调。'))),
        'foot': ('Click row for the full sector view','点击查看完整板块详情'),
        'foot_b': (it.ticker ~ ' ↗',),
      }) }}
      <div class="anv2-row-top">
        <a class="anv2-name anv2-name-link" href="sectors/{{ it.ticker }}.html">{{ td(it.name) }}<span class="anv2-go" aria-hidden="true">↗</span></a>
      </div>
      <div class="anv2-chips">
        {% if lane == 'buy' %}
        <span class="anv2-chip anv2-chip-reco-enter">{{ t('ENTRY NOW', '现在入场') }}</span>
        {% elif lane == 'pull' and it in actions.get('on_the_run', []) %}
        <span class="anv2-chip anv2-chip-tag">{{ t('WAIT FOR DIP', '等待回调') }}</span>
        {% elif lane == 'pull' %}
        <span class="anv2-chip anv2-chip-reco-hold">{{ t('HOLD', '持有') }}</span>
        {% elif lane == 'bot' %}
        <span class="anv2-chip anv2-chip-trough">{{ t('SETTING UP', '形态形成中') }}</span>
        {% elif it in actions.get('avoid', []) %}
        <span class="anv2-chip anv2-chip-reco-avoid">{{ t('AVOID', '回避') }}</span>
        {% else %}
        <span class="anv2-chip anv2-chip-reco-trim">{{ t('TAKE PROFITS', '止盈') }}</span>
        {% endif %}
      </div>
      <div class="anv2-stat">{{ td(it.label) }}{% if it.days is not none %} · ~{{ it.days }}{{ t('d', '天') }}{% endif %} · {{ it.ticker }}</div>
    </div>
    {%- endmacro -%}
    {%- macro _ca_anlane(lane, cls, title_en, title_zh, sub_en, sub_zh, items, lane_id) -%}
    <div class="anv2-lane anv2-lane--{{ cls }}" id="{{ lane_id }}">
      <div class="anv2-lane-hd">
        <div class="anv2-lane-title"><span class="l-en">{{ title_en }}</span><span class="l-zh">{{ title_zh }}</span><span class="anv2-lane-count">({{ items|length }})</span></div>
        <div class="anv2-lane-sub"><span class="l-en">{{ sub_en }}</span><span class="l-zh">{{ sub_zh }}</span></div>
      </div>
      <div class="anv2-lane-body lst-wrap">
        <div class="anv2-lst lst-collapse lst-cap4 is-collapsed">
          {% for it in items %}{{ _ca_anrow(it, lane) }}{% endfor %}
          {% if not items %}<div class="anv2-empty">{{ t('No sectors in this lane today.', '今天此栏暂无板块。') }}</div>{% endif %}
        </div>
        {% if items|length > 4 %}<button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more', '显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less', '收起') }} ▴</span></button>{% endif %}
      </div>
    </div>
    {%- endmacro -%}
    {{ _ca_anlane('buy', 'buy', 'Buy Now', '立即买入', 'Clean entry point today', '今日有干净入场点', _ca_buy, 'anv2-buy') }}
    {{ _ca_anlane('pull', 'pull', 'In Favour', '看好', 'Hold or wait for a dip — do not chase', '持有或等待回调 — 勿追高', _ca_pull, 'anv2-pull') }}
    {{ _ca_anlane('bot', 'bot', 'Bottoming Watch', '洗盘观察', 'Setting up near a cycle low — watch only', '接近周期低点 — 仅观察', _ca_bot, 'anv2-bot') }}
    {{ _ca_anlane('red', 'red', 'Reduce / Avoid', '减仓 / 回避', 'Trend weakening — take profits or stay away', '趋势转弱 — 止盈或回避', _ca_red, 'anv2-red') }}
  </div>
</div>
{% endif %}

{% if mode != 'stocks' %}{# ===== MX5 CANADA GLANCE — macro mode ===== #}
{# hero locals #}
{% set ms = market_state %}
{% set _ms_color = (ms.color if ms else 'yellow') %}
{% set _ms_score = (ms.score if ms else 50) %}
{% set _ms_verdict = (ms.verdict if ms else 'MIXED') %}
{% set _ms_label = (ms.label_en if ms else 'Mixed') %}
{% set _ms_label_zh = (ms.label_zh if ms else '混合') %}
{% set _ms_posture = (ms.posture_en if ms else 'Trade with caution') %}
{% set _ms_posture_zh = (ms.posture_zh if ms else '谨慎交易') %}
{% set _ms_thesis = (ms.headline_en if ms else '') %}
{% set _ms_thesis_zh = (ms.headline_zh if ms else '') %}
{% set _ms_flip = (ms.flip_en if ms else '') %}
{% set _ms_flip_zh = (ms.flip_zh if ms else '') %}
{% set _comps = (ms.components if ms else []) %}
{% set _rr = (ms.radar if ms else {}) %}
{% set _rr_score = (_rr.get('top_score') if (_rr and _rr.get('top_score') is not none) else none) %}
{% set _rr_p21 = _rr.get('dd21') if _rr else none %}
{% set _rr_lift = _rr.get('dd_lift') if _rr else none %}
{% set _rr_do_en = (_rr.get('do_en') or '') if _rr else '' %}
{% set _rr_do_zh = (_rr.get('do_zh') or '') if _rr else '' %}
{% set ov = overlay or {} %}
{% set cp = coupling or {} %}

{# aurora: state class baked from market_state color (yellow → au-yellow, red → au-red, green = default) #}
<div class="cax-aurora{{ ' au-yellow' if _ms_color == 'yellow' else (' au-red' if _ms_color == 'red' else '') }}" aria-hidden="true"><div class="cax-a3"></div><div class="cax-a4"></div></div>

<div class="cax-wrap">

<!-- =============== HERO =============== -->
<div class="cax-card cax-hero{{ ' cax-hero-solo' if not ms_history else '' }} ms-front ms ms-{{ _ms_color }}" id="ms-board" style="padding:0">
  <div class="cax-hero-left">
    {# quad zh from the site's canonical map (_regime_prob_panel idiom) — the vm
       carries no quad_name_zh; never render EN into the zh span. #}
    {% set _QZH = {'Goldilocks':'理想增长','Reflation':'再通胀','Stagflation':'滞胀','Growth-scare':'增长恐慌','Growth scare':'增长恐慌'} %}
    {% set _CZH = {'early':'早期','mid':'中期','late':'后期'} %}
    <div class="cax-pill-row">
      <span class="cax-regime-pill"><span class="dot"></span>
        {{ t(latest.quad_name, _QZH.get(latest.quad_name, latest.quad_name)) }}<span style="opacity:.55"> · {{ t(latest.cycle_tag or 'mid', _CZH.get(latest.cycle_tag or 'mid', latest.cycle_tag or 'mid')) }}</span></span>
      <span class="cax-asof">{{ t('data through', '数据截至') }} {{ latest.date }}</span>
    </div>
    <div class="cax-gauge-row">
      {# Regime odometer — US mx5-gauge geometry (viewBox 0 -4 140 101, arc r=56 around
         centre 70,75). Needle: score 0→-90° … 100→+90°. Colour is class-driven via .ms-*
         (paints --up/--down/--warn) so it flips correctly in zh. Arc length = π·56 ≈ 175.9;
         filled = score/100·175.9, gap fills the rest. #}
      {% set _needle_deg = ((_ms_score * 1.8) - 90) | round(1) %}
      {% set _arc_len = 175.9 %}
      {% set _filled = (_ms_score / 100 * _arc_len) | round(2) %}
      {% set _gap = (_arc_len - _filled + 40) | round(2) %}
      {% set _sc_col = 'var(--up)' if _ms_color == 'green' else ('var(--down)' if _ms_color == 'red' else 'var(--warn)') %}
      <svg class="cax-gauge-svg" viewBox="0 -4 140 101" fill="none" aria-hidden="true">
        <defs>
          <filter id="caxNeedleGlow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="2.5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="caxArcGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        {# Track #}
        <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round" fill="none"/>
        {# Filled arc — colour class-driven; length encodes the 0-100 score #}
        <path class="cax-gauge-fill" d="M 14 75 A 56 56 0 0 1 126 75" stroke="{{ _sc_col }}" stroke-width="10" stroke-linecap="round" fill="none"
              stroke-dasharray="{{ _filled }} {{ _gap }}" filter="url(#caxArcGlow)"/>
        {# Tick marks at 0/25/50/75/100 #}
        <g stroke="rgba(255,255,255,.22)" stroke-width="1.2">
          <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-90 70 75)"/>
          <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-45 70 75)"/>
          <line x1="70" y1="19" x2="70" y2="26" transform="rotate(0 70 75)"/>
          <line x1="70" y1="19" x2="70" y2="26" transform="rotate(45 70 75)"/>
          <line x1="70" y1="19" x2="70" y2="26" transform="rotate(90 70 75)"/>
        </g>
        {# Scale labels #}
        <text x="14"  y="95" fill="rgba(255,255,255,.30)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">0</text>
        <text x="70"  y="10" fill="rgba(255,255,255,.30)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">50</text>
        <text x="126" y="95" fill="rgba(255,255,255,.30)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">100</text>
        {# Needle #}
        <g class="cax-gauge-needle" transform="rotate({{ _needle_deg }} 70 75)" filter="url(#caxNeedleGlow)">
          <line x1="70" y1="75" x2="70" y2="24" stroke="rgba(255,255,255,.30)" stroke-width="5" stroke-linecap="round"/>
          <polygon points="69,75 71,75 70.5,24 69.5,24" fill="white" opacity=".94"/>
          <circle cx="70" cy="75" r="7" fill="rgba(255,255,255,.10)"/>
          <circle class="cax-needle-hub" cx="70" cy="75" r="4.5"/>
          <circle class="cax-needle-core" cx="70" cy="75" r="2"/>
          <circle class="cax-needle-tip" cx="70" cy="25.5" r="2.5"/>
        </g>
        {# NO score numeral inside the arc. This markup was copied from macro.html believing
           it was the US idiom, but macro.html suppresses both of those <text> nodes in CSS
           (assets/css: `#mx5-score-numeral + text{display:none}` and its sibling rule) — so
           on Canada they actually painted, putting a 24px score right where the needle
           sweeps and duplicating the .cax-big-score value two inches to the right. The big
           score below already carries the number; the arc carries the position. #}
      </svg>
      <div>
        <div class="cax-score-line"><span id="ms-score" class="cax-big-score">{{ _ms_score }}</span><span id="ms-word" class="cax-verdict">{{ t(_ms_label, _ms_label_zh) }} <span class="arr">▶</span></span></div>
        <div class="cax-sub-line">
          {# zh names the TIER (偏多/中性/避险), never the colour word — the paint flips 红涨绿跌
             in zh (risk-off→green), so a literal 红/绿 would contradict it. Matches macro.html. #}
          <span class="cax-sub-g"><span class="l-en">GREEN — TREND-FOLLOWING SUPPORTED</span><span class="l-zh">偏多 — 支持趋势跟随</span></span>
          <span class="cax-sub-y"><span class="l-en">YELLOW — TRADE WITH CAUTION</span><span class="l-zh">中性 — 谨慎交易</span></span>
          <span class="cax-sub-r"><span class="l-en">RED — DEFEND CAPITAL</span><span class="l-zh">避险 — 优先保住本金</span></span>
        </div>
      </div>
    </div>
    <p class="cax-thesis">{{ t(_ms_thesis or 'TSX market state.', _ms_thesis_zh or 'TSX 市场状态。') }}</p>
    {% if _ms_flip %}<div class="cax-flip">{{ t(_ms_flip, _ms_flip_zh or _ms_flip) }}</div>{% endif %}
    <div class="cax-hero-btns">
      {% set _n_bull = (_comps | selectattr('tone', 'equalto', 'pos') | list | length) %}
      {% set _n_total = (_comps | length) %}
      <button class="cax-hbtn gbtn gbtn-pill gbtn-sm" onclick="caxTogglePop('cax-pop-signals',event)">{{ icon('signals') }}
        <span class="l-en">{{ _n_bull }} of {{ _n_total }} signals aligned</span><span class="l-zh">{{ _n_total }} 项中 {{ _n_bull }} 项一致</span>
        <span class="n">▾</span></button>
      {# gbtn styling (matches the signals button) + #3176's flipping --down score: the
         pullback family is a DIRECTION read and flips 红涨绿跌 in zh (operator ruling 2026-07-21). #}
      <button class="cax-hbtn gbtn gbtn-pill gbtn-sm" onclick="caxTogglePop('cax-pop-risk',event)">{{ icon('alert', 'ic-warn') }}
        <span class="l-en">Pullback risk</span><span class="l-zh">回撤风险</span>{% if _rr_score is not none %} · <span class="n" style="color:var(--down)">{{ _rr_score }}</span>{% endif %} ▾</button>

      <!-- popover: factor breakdown -->
      <div class="cax-pop" id="cax-pop-signals">
        <div class="cax-pop-h">{{ t('Factor breakdown', '因子分解') }} — {{ _n_total }} {{ t('signals', '信号') }}</div>
        {% for c in _comps %}
        <div class="cax-pop-row">
          <div class="pr-t">
            <span {% if c.tone == 'bad' %}style="color:var(--down)"{% elif c.tone == 'good' %}style="color:var(--up)"{% endif %}>{{ t(c.label_en, c.label_zh) }}</span>
            <b {% if c.tone == 'bad' %}style="color:var(--down)"{% elif c.tone == 'good' %}style="color:var(--up)"{% endif %}>{{ c.score }}</b>
          </div>
          <div class="cax-pop-bar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'good' else ('var(--down)' if c.tone == 'bad' else 'var(--warn)') }}"></i></div>
        </div>
        {% endfor %}
        <span class="cax-pop-link" onclick="caxClosePops();caxOpenDlg('cax-dlg-read')">{{ t('Full breakdown ↓', '完整分解 ↓') }}</span>
      </div>

      <!-- popover: pullback risk radar -->
      <div class="cax-pop" id="cax-pop-risk" style="left:auto">
        <div class="cax-pop-h">{{ t('Pullback risk radar', '回撤风险雷达') }}</div>
        {% if _rr_score is not none %}
        <div class="cax-pop-big"><span class="n">{{ _rr_score }}</span><span class="t">{{ t(_rr.get('label_en') or '', _rr.get('label_zh') or '') }}</span></div>
        <div class="cax-pop-sub">{{ t(_rr_do_en or _ms_posture, _rr_do_zh or _ms_posture_zh) }}</div>
        {% for leg in (_rr.get('scares') or [])[:3] %}
        <div class="cax-pop-row">
          <div class="pr-t"><span>{{ t(leg.get('label_en') or leg.get('scare',''), leg.get('label_zh') or leg.get('scare','')) }}</span><b>{{ leg.score|round|int }}</b></div>
          <div class="cax-pop-bar"><i style="width:{{ leg.score|round|int }}%;background:var(--act)"></i></div>
        </div>
        {% endfor %}
        {% else %}
        <div class="cax-pop-sub">{{ t('No radar data.', '暂无雷达数据。') }}</div>
        {% endif %}
        <span class="cax-pop-link" onclick="caxClosePops();caxOpenDlg('cax-dlg-risk')">{{ t('Full risk detail ↓', '完整风险详情 ↓') }}</span>
      </div>
    </div>
  </div>
  {# ── 60-session path panel (US mx5-sc-right; hidden ≤700px per CSS). Verdict bands:
     risk-off <42, mixed 42–60, risk-on ≥60. Legit chart geometry: preserveAspectRatio=none
     SVG fills the plot box; glyphs/dot are a screen-space HTML overlay so they never warp. #}
  <div class="cax-hero-right mx5-sc-right">
    {% set _mx5_hist = ms_history if (ms_history is defined and ms_history and ms_history | length >= 2) else none %}
    {% set _mx5_hist_n = _mx5_hist | length if _mx5_hist else 0 %}
    <div class="mx5-path-header">
      <span class="mx5-path-title">
        <span class="l-en">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}{{ _mx5_hist_n }}-session path{% else %}60-session path{% endif %}</span>
        <span class="l-zh">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}近 {{ _mx5_hist_n }} 交易日走势{% else %}60 交易日走势{% endif %}</span>
      </span>
      <span class="mx5-path-meta"><span class="l-en">Score vs time</span><span class="l-zh">综合评分 · 时序</span></span>
    </div>
    {% if _mx5_hist %}
    {% set _sc_col = 'var(--up)' if _ms_color == 'green' else ('var(--down)' if _ms_color == 'red' else 'var(--warn)') %}
    {% set _ph_n = _mx5_hist | length %}
    {% set PX0 = 44 %}{% set PXW = 944 %}{% set PY0 = 10 %}{% set PYB = 194 %}
    {% set _mx5_mos_en = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
    {% set _ph_yfor = PYB - PY0 %}
    {% set _y100 = PY0 %}
    {% set _y75  = (PY0 + 25.0/100 * _ph_yfor) | round(2) %}
    {% set _y60  = (PY0 + 40.0/100 * _ph_yfor) | round(2) %}
    {% set _y50  = (PY0 + 50.0/100 * _ph_yfor) | round(2) %}
    {% set _y42  = (PY0 + 58.0/100 * _ph_yfor) | round(2) %}
    {% set _y25  = (PY0 + 75.0/100 * _ph_yfor) | round(2) %}
    {% set _y0   = PYB %}
    {% set _ph_pts_line = [] %}
    {% set _ph_json = [] %}
    {% for row in _mx5_hist %}
      {% set _ph_x = (PX0 + (loop.index0 / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
      {% set _row_s = row.score if (row.score is defined and row.score is not none) else 50 %}
      {% set _ph_y = (PY0 + (100 - _row_s) / 100 * _ph_yfor) | round(2) %}
      {% set _rv = 'Risk-on' if _row_s >= 60 else ('Mixed' if _row_s >= 42 else 'Risk-off') %}
      {% set _rvz = '偏多' if _row_s >= 60 else ('中性' if _row_s >= 42 else '偏空') %}
      {% if _ph_pts_line.append(_ph_x ~ ',' ~ _ph_y) %}{% endif %}
      {% if _ph_json.append({'d': row.date, 'md': (_mx5_mos_en[row.date[5:7]|int] ~ ' ' ~ (row.date[8:10]|int)) if (row.date and row.date|length >= 10) else '', 'mz': ((row.date[5:7]|int)|string ~ '月' ~ (row.date[8:10]|int)|string) if (row.date and row.date|length >= 10) else '', 's': row.score, 'v': _rv, 'vz': _rvz, 'x': _ph_x, 'y': _ph_y}) %}{% endif %}
    {% endfor %}
    {% set _ph_nticks = [_ph_n, 5] | min %}
    {% set _ph_tick_idx = [] %}
    {% if _ph_n <= 6 %}
      {% for i in range(_ph_n) %}{% if _ph_tick_idx.append(i) %}{% endif %}{% endfor %}
    {% else %}
      {% for k in range(_ph_nticks + 1) %}{% if _ph_tick_idx.append((k / _ph_nticks * (_ph_n - 1)) | round | int) %}{% endif %}{% endfor %}
    {% endif %}
    <div class="mx5-path-plot">
    <svg class="mx5-path-svg" viewBox="0 0 1000 224" preserveAspectRatio="none"
         data-points='{{ _ph_json | tojson }}'
         data-px0="{{ PX0 }}" data-pxw="{{ PXW }}" data-py0="{{ PY0 }}" data-pyb="{{ PYB }}"
         data-vbw="1000" data-vbh="224"
         role="img" aria-label="{{ _mx5_hist_n }}-session macro score path, {{ _mx5_hist[0].score }} to {{ _mx5_hist[-1].score }}">
      <defs>
        <linearGradient id="caxPathAreaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="{{ _sc_col }}" stop-opacity=".40"/>
          <stop offset="62%"  stop-color="{{ _sc_col }}" stop-opacity=".07"/>
          <stop offset="100%" stop-color="{{ _sc_col }}" stop-opacity="0"/>
        </linearGradient>
      </defs>
      {# Verdict-band tinted zones (paint via --up/--down/--warn washes; zh mirror below flips on/off) #}
      <rect class="cax-pz-on"  x="0" y="{{ _y100 }}" width="1000" height="{{ (_y60 - _y100) | round(2) }}"/>
      <rect class="cax-pz-mid" x="0" y="{{ _y60 }}"  width="1000" height="{{ (_y42 - _y60) | round(2) }}"/>
      <rect class="cax-pz-off" x="0" y="{{ _y42 }}"  width="1000" height="{{ (_y0 - _y42) | round(2) }}"/>
      <line class="cax-pz-hl-on"  x1="0" y1="{{ _y60 }}" x2="1000" y2="{{ _y60 }}" stroke-width="1" stroke-dasharray="2,5"/>
      <line class="cax-pz-hl-off" x1="0" y1="{{ _y42 }}" x2="1000" y2="{{ _y42 }}" stroke-width="1" stroke-dasharray="2,5"/>
      <g stroke="rgba(255,255,255,.06)" stroke-width="1">
        <line x1="{{ PX0 }}" y1="{{ _y100 }}" x2="988" y2="{{ _y100 }}"/>
        <line x1="{{ PX0 }}" y1="{{ _y75 }}"  x2="988" y2="{{ _y75 }}"/>
        <line x1="{{ PX0 }}" y1="{{ _y50 }}"  x2="988" y2="{{ _y50 }}" stroke-dasharray="4,5"/>
        <line x1="{{ PX0 }}" y1="{{ _y25 }}"  x2="988" y2="{{ _y25 }}"/>
      </g>
      <path d="M{{ _ph_pts_line | join(' L') }} L{{ (PX0 + PXW) | round(2) }},{{ PYB }} L{{ PX0 }},{{ PYB }} Z" fill="url(#caxPathAreaGrad)" stroke="none"/>
      <polyline points="{{ _ph_pts_line | join(' ') }}" fill="none" stroke="{{ _sc_col }}" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" opacity=".92"/>
      <line x1="{{ PX0 }}" y1="{{ PYB }}" x2="988" y2="{{ PYB }}" stroke="rgba(255,255,255,.16)" stroke-width="1"/>
      <g font-size="11" font-family="Inter,-apple-system,sans-serif">
      {% for _ti in _ph_tick_idx %}
        {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
        <line x1="{{ _tx }}" y1="{{ PYB }}" x2="{{ _tx }}" y2="{{ (PYB + 4) | round(1) }}" stroke="rgba(255,255,255,.20)" stroke-width="1"/>
      {% endfor %}
      </g>
      {% set _ph_last_x = (PX0 + PXW) | round(2) %}
      {% set _ph_last_y = (PY0 + (100 - _mx5_hist[-1].score) / 100 * _ph_yfor) | round(2) %}
    </svg>
    {# Axis labels + today marker: screen-space HTML overlay (never stretched by the SVG's non-uniform scale) #}
    <div class="mx5-path-labels" aria-hidden="true">
      <span class="mx5-pl-y" style="top:{{ (_y100 / 224 * 100) | round(2) }}%">100</span>
      <span class="mx5-pl-y" style="top:{{ (_y75  / 224 * 100) | round(2) }}%">75</span>
      <span class="mx5-pl-y" style="top:{{ (_y50  / 224 * 100) | round(2) }}%">50</span>
      <span class="mx5-pl-y" style="top:{{ (_y25  / 224 * 100) | round(2) }}%">25</span>
      <span class="mx5-pl-y" style="top:{{ (_y0   / 224 * 100) | round(2) }}%">0</span>
      <span class="mx5-pl-zone on"  style="top:{{ ((_y100 + 13) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-on</span><span class="l-zh">偏多</span></span>
      <span class="mx5-pl-zone mid" style="top:{{ (((_y60 + _y42) / 2) / 224 * 100) | round(2) }}%"><span class="l-en">Mixed</span><span class="l-zh">中性</span></span>
      <span class="mx5-pl-zone off" style="top:{{ ((_y0 - 7) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-off</span><span class="l-zh">偏空</span></span>
      {% for _ti in _ph_tick_idx %}
        {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
        {% set _txf = 'translate(0,-50%)' if loop.first else ('translate(-100%,-50%)' if loop.last else 'translate(-50%,-50%)') %}
        {% set _tdate = _mx5_hist[_ti].date %}
        {% if _tdate and _tdate|length >= 10 %}
        <span class="mx5-pl-x" style="left:{{ (_tx / 1000 * 100) | round(3) }}%;transform:{{ _txf }}"><span class="l-en">{{ _mx5_mos_en[_tdate[5:7]|int] }} {{ _tdate[8:10]|int }}</span><span class="l-zh">{{ _tdate[5:7]|int }}月{{ _tdate[8:10]|int }}</span></span>
        {% endif %}
      {% endfor %}
      <span class="mx5-pl-today" style="left:{{ (_ph_last_x / 1000 * 100) | round(3) }}%;top:{{ (_ph_last_y / 224 * 100) | round(3) }}%;color:{{ _sc_col }}"></span>
    </div>
    {# JS hover enhancement layer (screen-space; chart is complete without it) #}
    <div class="mx5-path-cross" aria-hidden="true"></div>
    <div class="mx5-path-dot" aria-hidden="true"></div>
    <div class="mx5-path-tip" role="status" aria-live="off">
      <span class="mx5-path-tip-date"></span>
      <span class="mx5-path-tip-row"><b class="mx5-path-tip-score"></b><span class="mx5-path-tip-verdict"></span></span>
    </div>
    </div>{# /mx5-path-plot #}
    {% else %}
    {# Honest placeholder when ms_history absent or <2 points #}
    <div style="flex:1;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--muted);text-align:center">{{ t('Building the trend view — ' ~ (ms_history|length if ms_history else 0) ~ ' of 60 sessions logged. Fills in nightly.','趋势图积累中 — 已记录 ' ~ (ms_history|length if ms_history else 0) ~ '/60 个交易日，每晚更新。') }}</div>
    {% endif %}
  </div>
</div>
{# /hero #}

<!-- =============== MARKETS FACE + SENTIMENT ODOMETER =============== -->
<div class="cax-secbar"><b>{{ t('CANADA DASHBOARD','加拿大看板') }}</b><span>{{ latest.date }}</span></div>
{# Overlay-factor lookup. Jinja gotcha: {% set %} inside {% for %} is LOOP-LOCAL and never
   escapes — a plain `{% set _f = f %}` leaves the outer var none (tiles all '—' until namespace()). #}
{% set _tf = namespace(spy=none, cad=none, oil=none, gold=none) %}
{% for f in (ov.factors or []) %}
  {% set _lab = (f.label or '') %}
  {% if _tf.spy is none and ('SPY' in _lab or 'SP500' in _lab or 'S&P' in _lab) %}{% set _tf.spy = f %}{% endif %}
  {% if _tf.cad is none and ('CAD' in _lab) %}{% set _tf.cad = f %}{% endif %}
  {% if _tf.oil is none and ('oil' in _lab|lower or 'crude' in _lab|lower or 'energy' in _lab|lower) %}{% set _tf.oil = f %}{% endif %}
  {% if _tf.gold is none and ('gold' in _lab|lower and 'copper' not in _lab|lower) %}{% set _tf.gold = f %}{% endif %}
{% endfor %}
{% set _spy_f = _tf.spy %}
{% set _usdcad_f = _tf.cad %}
{% set _oil_f = _tf.oil %}
{% set _gold_f = _tf.gold %}
{% set _pr = pair or {} %}
{% set _usdcad_pair = _pr.get('usdcad') %}
{# commodity spot last-close (baked initial paint from the yahoo store; live.js
   patches each tile fresh via its data-sym). Canada = mineral/energy market. #}
{% set _cmd = commodities or {} %}
{% set _wti = _cmd.get('wti') %}
{% set _gld = _cmd.get('gold') %}
{% set _cop = _cmd.get('copper') %}
{# plain-word energy/metal stance tips (Tier-2 hover receipts) #}
{% set _oil_tip_en = ({'on':'Energy backdrop: supportive','off':'Energy backdrop: headwind','neutral':'Energy backdrop: neutral'}.get(_oil_f.risk, 'Energy backdrop') ~ (' · %+.2fσ vs 1y'|format(_oil_f.z) if _oil_f and _oil_f.z is not none else '')) if _oil_f else 'WTI crude — TSX energy driver' %}
{% set _oil_tip_zh = ({'on':'能源背景：利多','off':'能源背景：利空','neutral':'能源背景：中性'}.get(_oil_f.risk, '能源背景') ~ (' · 较1年 %+.2fσ'|format(_oil_f.z) if _oil_f and _oil_f.z is not none else '')) if _oil_f else 'WTI 原油 — TSX 能源驱动' %}
{% set _gold_tip_en = ({'on':'Gold backdrop: supportive','off':'Gold backdrop: headwind','neutral':'Gold backdrop: neutral'}.get(_gold_f.risk, 'Gold backdrop') ~ (' · %+.2fσ vs 1y'|format(_gold_f.z) if _gold_f and _gold_f.z is not none else '')) if _gold_f else 'Gold — TSX materials driver' %}
{% set _gold_tip_zh = ({'on':'黄金背景：利多','off':'黄金背景：利空','neutral':'黄金背景：中性'}.get(_gold_f.risk, '黄金背景') ~ (' · 较1年 %+.2fσ'|format(_gold_f.z) if _gold_f and _gold_f.z is not none else '')) if _gold_f else '黄金 — TSX 材料驱动' %}
<div class="cax-mktrow">
  {# ── Combined markets container: ONE sxg-face mx5-card-face → markets dialog (US idiom C) ── #}
  <div class="sxg-face mx5-card-face" role="button" tabindex="0" aria-haspopup="dialog" aria-label="Markets" onclick="caxOpenDlg('cax-dlg-markets')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();caxOpenDlg('cax-dlg-markets');}">
    <div class="mx5-mkt-grid">
      {# TSX Composite — real index level; data-sym for live price patch #}
      <div class="mx5-mkt-tile {{ 'up' if (benchmark and benchmark.chg >= 0) else ('dn' if benchmark else '') }}" data-sym="^GSPTSE" data-mkt="ca">
        {# Visible label is the short desk code, never the Yahoo slug (`^GSPTSE` is a raw
           machine slug — banned on the glance tier). data-sym keeps the real symbol for
           live.js price patching, so only the text changed. Mirrors macro.html's
           "ES / S&P fut" tiles. #}
        <div class="mx5-mkt-ticker">TSX</div>
        <div class="mx5-mkt-sub"><span class="l-en">S&amp;P/TSX Composite</span><span class="l-zh">标普/TSX 综合</span></div>
        {% if benchmark %}
        <div class="mx5-mkt-price nb-px" data-sym="^GSPTSE" data-mkt="ca" data-bare>{{ '{:,.0f}'.format(benchmark.price) }}</div>
        <div class="mx5-mkt-delta {{ 'up' if benchmark.chg >= 0 else 'dn' }} nb-chg" data-sym="^GSPTSE" data-mkt="ca">{{ '%+.2f'|format(benchmark.chg) }}%</div>
        {% else %}
        <div class="mx5-mkt-price" style="color:var(--muted)">—</div>
        {% endif %}
      </div>
      {# TSX Venture — small-cap / junior-miner breadth (Canada mining tape); live-only via ^SPCDNX #}
      <div class="mx5-mkt-tile" data-sym="^SPCDNX" data-mkt="ca">
        <div class="mx5-mkt-ticker">TSXV</div>
        <div class="mx5-mkt-sub"><span class="l-en">TSX Venture · juniors</span><span class="l-zh">TSX 创业板 · 小型矿企</span></div>
        <div class="mx5-mkt-price nb-px" data-sym="^SPCDNX" data-mkt="ca" data-bare>—</div>
        <div class="mx5-mkt-delta nb-chg" data-sym="^SPCDNX" data-mkt="ca" style="color:var(--muted)">—</div>
      </div>
      {# WTI crude — the TSX energy driver; spot price baked, live-patched #}
      <div class="mx5-mkt-tile {{ 'up' if (_wti and (_wti.chg or 0) >= 0) else ('dn' if _wti else '') }}" data-sym="CL=F" data-mkt="fut" data-tip-en="{{ _oil_tip_en }}" data-tip-zh="{{ _oil_tip_zh }}">
        <div class="mx5-mkt-ticker">WTI</div>
        <div class="mx5-mkt-sub"><span class="l-en">Crude oil</span><span class="l-zh">原油</span></div>
        {% if _wti %}
        <div class="mx5-mkt-price {{ 'up' if (_wti.chg or 0) >= 0 else 'dn' }}"><span class="mkt-cur">$</span><span class="nb-px" data-sym="CL=F" data-mkt="fut" data-bare>{{ _wti.price_fmt }}</span></div>
        <div class="mx5-mkt-delta {{ 'up' if (_wti.chg or 0) >= 0 else 'dn' }} nb-chg" data-sym="CL=F" data-mkt="fut">{{ '%+.2f'|format(_wti.chg) }}%</div>
        {% else %}
        <div class="mx5-mkt-price"><span class="mkt-cur">$</span><span class="nb-px" data-sym="CL=F" data-mkt="fut" data-bare>—</span></div>
        <div class="mx5-mkt-delta nb-chg" data-sym="CL=F" data-mkt="fut" style="color:var(--muted)">—</div>
        {% endif %}
      </div>
      {# Gold — bullion; TSX materials / gold-miner driver #}
      <div class="mx5-mkt-tile {{ 'up' if (_gld and (_gld.chg or 0) >= 0) else ('dn' if _gld else '') }}" data-sym="GC=F" data-mkt="fut" data-tip-en="{{ _gold_tip_en }}" data-tip-zh="{{ _gold_tip_zh }}">
        <div class="mx5-mkt-ticker">GOLD</div>
        <div class="mx5-mkt-sub"><span class="l-en">Bullion</span><span class="l-zh">黄金</span></div>
        {% if _gld %}
        <div class="mx5-mkt-price {{ 'up' if (_gld.chg or 0) >= 0 else 'dn' }}"><span class="mkt-cur">$</span><span class="nb-px" data-sym="GC=F" data-mkt="fut" data-bare>{{ _gld.price_fmt }}</span></div>
        <div class="mx5-mkt-delta {{ 'up' if (_gld.chg or 0) >= 0 else 'dn' }} nb-chg" data-sym="GC=F" data-mkt="fut">{{ '%+.2f'|format(_gld.chg) }}%</div>
        {% else %}
        <div class="mx5-mkt-price"><span class="mkt-cur">$</span><span class="nb-px" data-sym="GC=F" data-mkt="fut" data-bare>—</span></div>
        <div class="mx5-mkt-delta nb-chg" data-sym="GC=F" data-mkt="fut" style="color:var(--muted)">—</div>
        {% endif %}
      </div>
      {# Copper — global cyclical pulse; TSX base-metals driver #}
      <div class="mx5-mkt-tile {{ 'up' if (_cop and (_cop.chg or 0) >= 0) else ('dn' if _cop else '') }}" data-sym="HG=F" data-mkt="fut" data-tip-en="Copper — global cyclical / base-metals pulse" data-tip-zh="铜 — 全球周期／基本金属脉搏">
        <div class="mx5-mkt-ticker">COPPER</div>
        <div class="mx5-mkt-sub"><span class="l-en">Base metal</span><span class="l-zh">基本金属</span></div>
        {% if _cop %}
        <div class="mx5-mkt-price {{ 'up' if (_cop.chg or 0) >= 0 else 'dn' }}"><span class="mkt-cur">$</span><span class="nb-px" data-sym="HG=F" data-mkt="fut" data-bare>{{ _cop.price_fmt }}</span></div>
        <div class="mx5-mkt-delta {{ 'up' if (_cop.chg or 0) >= 0 else 'dn' }} nb-chg" data-sym="HG=F" data-mkt="fut">{{ '%+.2f'|format(_cop.chg) }}%</div>
        {% else %}
        <div class="mx5-mkt-price"><span class="mkt-cur">$</span><span class="nb-px" data-sym="HG=F" data-mkt="fut" data-bare>—</span></div>
        <div class="mx5-mkt-delta nb-chg" data-sym="HG=F" data-mkt="fut" style="color:var(--muted)">—</div>
        {% endif %}
      </div>
      {# USD/CAD — real FX level when available, else overlay stance #}
      <div class="mx5-mkt-tile">
        <div class="mx5-mkt-ticker">USD/CAD</div>
        <div class="mx5-mkt-sub"><span class="l-en">Loonie</span><span class="l-zh">加元</span></div>
        {% if _usdcad_pair and _usdcad_pair.level %}
        <div class="mx5-mkt-price nb-px" data-sym="CAD=X" data-mkt="fx" data-bare>{{ '%.4f'|format(_usdcad_pair.level) }}</div>
        <div class="mx5-mkt-delta {{ 'dn' if (_usdcad_pair.chg_20d_pct or 0) > 0 else 'up' }}">CAD {{ t('firm','走强') if (_usdcad_pair.chg_20d_pct or 0) < 0 else t('soft','走弱') }} <span style="color:var(--muted);font-weight:400">{{ '%+.1f'|format(_usdcad_pair.chg_20d_pct) }}%</span></div>
        {% elif _usdcad_f is not none %}
        <div class="mx5-mkt-price {{ 'up' if _usdcad_f.risk == 'on' else ('dn' if _usdcad_f.risk == 'off' else '') }}" style="font-size:16px">{{ t('CAD ' + ('firm' if _usdcad_f.risk == 'on' else ('soft' if _usdcad_f.risk == 'off' else 'flat')), '加元' + ('走强' if _usdcad_f.risk == 'on' else ('走弱' if _usdcad_f.risk == 'off' else '平稳'))) }}</div>
        <div class="mx5-mkt-delta" style="color:var(--muted)" data-tip-en="{{ '%+.2f'|format(_usdcad_f.z) }}σ" data-tip-zh="{{ '%+.2f'|format(_usdcad_f.z) }}σ">{{ t('FX context','汇率背景') }}</div>
        {% else %}
        <div class="mx5-mkt-price" style="color:var(--muted)">—</div>
        <div class="mx5-mkt-delta" style="color:var(--muted)">{{ t('FX context','汇率背景') }}</div>
        {% endif %}
      </div>
      {# S&P 500 — US backdrop via overlay (plain-word stance, not a raw price) #}
      <div class="mx5-mkt-tile">
        <div class="mx5-mkt-ticker">SPY</div>
        <div class="mx5-mkt-sub"><span class="l-en">S&amp;P 500</span><span class="l-zh">标普500</span></div>
        {% if _spy_f is not none %}
        <div class="mx5-mkt-price {{ 'up' if _spy_f.risk == 'on' else ('dn' if _spy_f.risk == 'off' else '') }}" style="font-size:16px">{{ t({'on':'Risk-on','off':'Risk-off','neutral':'Neutral'}.get(_spy_f.risk or '', '—'), {'on':'偏多','off':'偏空','neutral':'中性'}.get(_spy_f.risk or '', '—')) }}</div>
        <div class="mx5-mkt-delta" style="color:var(--muted)" data-tip-en="{{ '%+.2f'|format(_spy_f.z) }}σ vs 1y range" data-tip-zh="较1年区间 {{ '%+.2f'|format(_spy_f.z) }}σ">{{ t('US backdrop','美股背景') }}</div>
        {% else %}
        <div class="mx5-mkt-price" style="color:var(--muted)">—</div>
        <div class="mx5-mkt-delta" style="color:var(--muted)">{{ t('US backdrop','美股背景') }}</div>
        {% endif %}
      </div>
    </div>
  </div>

  {# ── Market Sentiment odometer (US mx5-sentiment; computed participation composite) ── #}
  {% set _cs = ca_sentiment if (ca_sentiment is defined and ca_sentiment) else none %}
  {% set _cs_zone = (_cs.zone if _cs else '') %}
  {# zh 红涨绿跌: broad participation = constructive → red (fg-greed); thin → green (fg-fear); mixed → amber #}
  <div class="sx-v5-static {{ 'fg-greed' if _cs_zone == 'broad' else ('fg-fear' if _cs_zone == 'thin' else 'fg-neutral') }}" id="cax-sentiment">
    {% if _cs %}
    {% set _cs_dial = _cs.score %}
    {% set _cs_rot = (_cs_dial / 100 * 180 - 90) | round(1) %}
    <div class="mx5-card" role="button" tabindex="0" aria-haspopup="dialog" onclick="caxOpenDlg('cax-dlg-sentiment')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();caxOpenDlg('cax-dlg-sentiment');}">
      <div class="mx5-card-title"><span class="l-en">Market Participation</span><span class="l-zh">市场参与度</span></div>
      <div class="mx5-sentiment-dial-wrap">
        <svg viewBox="0 0 380 212" style="width:100%;max-width:340px;height:180px;display:inline-block;overflow:visible">
          <defs>
            <linearGradient id="caxSentGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--down)"/><stop offset="35%" stop-color="var(--warn)"/><stop offset="65%" stop-color="var(--up)"/><stop offset="100%" stop-color="var(--up)"/>
            </linearGradient>
            <filter id="caxDialGlow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="18" stroke-linecap="round"/>
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="url(#caxSentGrad)" stroke-width="18" stroke-linecap="round" opacity=".55"/>
          <g filter="url(#caxDialGlow)">
            <line class="fg-mark-s" x1="190" y1="185" x2="190" y2="30" stroke-width="4" stroke-linecap="round" transform="rotate({{ _cs_rot }}, 190, 185)"/>
            <circle class="fg-mark-s" cx="190" cy="185" r="9" fill="rgba(8,12,18,.8)" stroke-width="2.5"/>
            <circle class="fg-mark-f" cx="190" cy="185" r="4"/>
          </g>
          <text class="l-en fg-lab-panic" x="26" y="208" font-size="12.5" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">THIN</text>
          <text class="l-zh fg-lab-panic" x="26" y="208" font-size="12.5" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">稀薄</text>
          <text class="l-en fg-lab-euph" x="354" y="208" font-size="12.5" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">BROAD</text>
          <text class="l-zh fg-lab-euph" x="354" y="208" font-size="12.5" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">广泛</text>
        </svg>
      </div>
      <div class="mx5-sentiment-zone-text"><span class="l-en">{{ _cs.label_en }}</span><span class="l-zh">{{ _cs.label_zh }}</span></div>
      <div class="mx5-sentiment-label">
        <span class="l-en">{{ _cs.pct_above_50 | round | int }}% of TSX names above their 50-day line</span>
        <span class="l-zh">{{ _cs.pct_above_50 | round | int }}% 的 TSX 成分股站上 50 日均线</span>
      </div>
      <div class="plf-open"><span class="l-en">How it's measured</span><span class="l-zh">如何测算</span> &rarr;</div>
    </div>
    {% else %}
    {# Honest doctrine null-state — greyed dial, "watch — not enough data yet" #}
    <div class="mx5-card fg-null" role="button" tabindex="0" aria-haspopup="dialog" onclick="caxOpenDlg('cax-dlg-sentiment')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();caxOpenDlg('cax-dlg-sentiment');}">
      <div class="mx5-card-title"><span class="l-en">Market Participation</span><span class="l-zh">市场参与度</span></div>
      <div class="mx5-sentiment-dial-wrap">
        <svg viewBox="0 0 380 212" style="width:100%;max-width:340px;height:180px;display:inline-block;overflow:visible">
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="18" stroke-linecap="round"/>
          <g opacity=".4">
            <line x1="190" y1="185" x2="190" y2="30" stroke="var(--muted)" stroke-width="4" stroke-linecap="round" transform="rotate(0, 190, 185)"/>
            <circle cx="190" cy="185" r="9" fill="rgba(8,12,18,.8)" stroke="var(--muted)" stroke-width="2.5"/>
          </g>
          <text x="26" y="208" font-size="12.5" fill="var(--muted)" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">{{ t('THIN','稀薄') }}</text>
          <text x="354" y="208" font-size="12.5" fill="var(--muted)" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">{{ t('BROAD','广泛') }}</text>
        </svg>
      </div>
      <div class="mx5-sentiment-zone-text" style="color:var(--muted)"><span class="l-en">Watch — not enough data yet</span><span class="l-zh">观望 — 数据尚不足</span></div>
      <div class="mx5-sentiment-label"><span class="l-en">Breadth read unavailable — fills in nightly</span><span class="l-zh">市场宽度数据暂缺 — 每晚更新</span></div>
      <div class="plf-open"><span class="l-en">How it's measured</span><span class="l-zh">如何测算</span> &rarr;</div>
    </div>
    {% endif %}
  </div>
</div>

{# ── Plain-word names for the regime contributor slugs ───────────────────────────
   engine/canada_run.py:confirming_contradicting() returns raw column stems like
   "growth_unemployment_trend" — machine slugs, banned on the glance tier. The full
   universe is the 9 keys in engine/canada_axes.py:_component_scores(). _CA_SIG_FALLBACK
   prettifies anything added upstream later so a new contributor degrades to readable
   words instead of a raw slug (and never blocks the render on a lookup miss). #}
{% set _CA_SIG = {
  'growth_gdp_trend':            ('Economic output',        '经济产出'),
  'growth_unemployment_trend':   ('Jobless rate',           '失业率'),
  'growth_cyclical_defensive':   ('Cyclicals vs defensives','周期股 vs 防御股'),
  'growth_global_growth':        ('Global demand',          '全球需求'),
  'growth_breadth_direction':    ('How many stocks are rising','上涨股票占比'),
  'growth_tsx_spx':              ('TSX vs the US market',   'TSX vs 美股'),
  'inflation_cpi_direction':     ('Inflation rate',         '通胀率'),
  'inflation_breakeven_direction':('The bond market\'s inflation bet','债市通胀预期'),
  'inflation_inflation_beta_basket':('Inflation-sensitive stocks','通胀敏感股'),
} %}

<!-- =============== ROW 1: What To Do + Regime Watch =============== -->
<div class="cax-rack2">
  {# What To Do #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-playbook')">
    <div class="cax-ctitle">{{ t('What To Do','该怎么做') }}</div>
    {% if actions %}
    {% set _buy_now = (actions.buy_now or []) %}
    {% set _buy_soon = (actions.buy_soon or []) %}
    {% set _avoid = (actions.avoid or []) %}
    {% if _buy_now %}
    <div class="cax-row"><span class="ic">{{ icon('arrow_up', 'ic-up') }}</span><div class="tx"><b>{{ t('Buy now','立即买入') }}</b><span class="sub">{{ _buy_now | map(attribute='name') | list | join(' · ') | truncate(60, true, '…') }}</span></div></div>
    {% endif %}
    {% if _buy_soon %}
    <div class="cax-row"><span class="ic">{{ icon('clock', 'ic-link') }}</span><div class="tx"><b>{{ t('Buy soon','即将买入') }}</b><span class="sub">{{ _buy_soon | map(attribute='name') | list | join(' · ') | truncate(60, true, '…') }}</span></div></div>
    {% endif %}
    {% if actions.get('on_the_run') %}
    <div class="cax-row"><span class="ic">{{ icon('trend_up', 'ic-violet') }}</span><div class="tx"><b>{{ t('On the run','顺势运行') }}</b><span class="sub">{{ t('do not chase','勿追高') }}</span></div></div>
    {% endif %}
    {% if _avoid %}
    <div class="cax-row"><span class="ic">{{ icon('avoid', 'ic-dn') }}</span><div class="tx"><b>{{ t('Avoid','回避') }}</b><span class="sub">{{ _avoid | map(attribute='name') | list | join(' · ') | truncate(60, true, '…') }}</span></div></div>
    {% endif %}
    {% else %}
    <div class="cax-row"><span class="ic">{{ icon('loading', 'ic-mut ic-spin') }}</span><div class="tx"><b>{{ t('Regime data loading…','周期数据加载中…') }}</b></div></div>
    {% endif %}
  </div>
  {# Regime Watch #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-regime')">
    <div class="cax-ctitle">{{ t('Regime Watch','周期观察') }}</div>
    <div class="cax-kv"><span class="k">{{ t('Quad','象限') }}</span><span class="v">{{ td(latest.quad_name) }}</span></div>
    <div class="cax-kv"><span class="k">{{ t('Growth','增长') }}</span><span class="v {{ 'cax-tt-up' if latest.growth_score >= 0 else 'cax-tt-dn' }}">{{ '%+.2f'|format(latest.growth_score) }}</span></div>
    <div class="cax-kv"><span class="k">{{ t('Inflation','通胀') }}</span><span class="v {{ 'cax-tt-up' if latest.inflation_score >= 0 else 'cax-tt-dn' }}">{{ '%+.2f'|format(latest.inflation_score) }}</span></div>
    <div class="cax-kv"><span class="k">{{ t('Confidence','一致度') }}</span><span class="v">{{ '%.0f'|format(latest.confidence * 100) }}%</span></div>
    {# pending_quad is a float NaN when nothing is pending (NaN is truthy!) —
       the x == x self-equality test is the NaN-safe guard; also require days > 0 #}
    {% if latest.pending_quad and latest.pending_quad == latest.pending_quad and latest.pending_quad is string and (latest.pending_days or 0) > 0 %}<div class="cax-kv"><span class="k">{{ t('Pending','待确认') }}</span><span class="v" style="color:var(--warn)">{{ td(latest.pending_quad) }} <span style="color:var(--muted)">{{ latest.pending_days }}d</span></span></div>{% endif %}
    {# WHAT AGREES / WHAT ARGUES AGAINST — latest.confirming/contradicting were computed
       every night and never displayed. This is the "why" behind the regime call, and the
       honest place to show disagreement rather than only the confident headline. #}
    {% set _cfm = latest.confirming or [] %}
    {% set _ctr = latest.contradicting or [] %}
    {% if _cfm or _ctr %}
    <div class="cax-lbl" style="margin-top:11px">{{ t('Why this call','判断依据') }}</div>
    {% for _s in _cfm[:4] %}
    {% set _nm = _CA_SIG.get(_s) %}
    <div class="cax-sigrow"><span class="cax-sigdot ok">✓</span><span>{{ t(_nm[0], _nm[1]) if _nm else (_s.split('_', 1)[1] if '_' in _s else _s) | replace('_',' ') | capitalize }}</span></div>
    {% endfor %}
    {% for _s in _ctr[:3] %}
    {% set _nm = _CA_SIG.get(_s) %}
    <div class="cax-sigrow"><span class="cax-sigdot bad">✕</span><span>{{ t(_nm[0], _nm[1]) if _nm else (_s.split('_', 1)[1] if '_' in _s else _s) | replace('_',' ') | capitalize }}</span></div>
    {% endfor %}
    <div class="cax-foot">
      {% if _cfm and not _ctr %}<span class="cax-stword ok">{{ t('Every reading we track points the same way — the call is clean.','所有跟踪指标方向一致 — 判断明确。') }}</span>
      {% elif _ctr and not _cfm %}<span class="cax-stword bad">{{ t('The readings point the other way — treat this call as weak.','指标方向相反 — 该判断偏弱。') }}</span>
      {% elif _ctr %}<span class="cax-stword warn">{{ t('%d of %d readings disagree — size positions smaller than usual.'|format(_ctr|length, (_cfm|length + _ctr|length)), '%d/%d 项指标不一致 — 仓位应低于平常。'|format(_ctr|length, (_cfm|length + _ctr|length))) }}</span>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>

<!-- =============== ROW 2: Pullback Risk ↔ Top Stocks + Participation + Sector Temperature =============== -->
<div class="cax-rack3">
  {# Pullback Risk or Top Stocks #}
  {% set _risk_state = (_rr.get('state') if _rr else 'calm') %}
  {% set _show_risk = _risk_state in ('caution', 'elevated', 'risk-off') %}
  {% if _show_risk %}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-risk')" style="border-color:color-mix(in srgb,var(--down) 35%,transparent)">
    <div class="cax-ctitle">{{ t('Pullback Risk','回撤风险') }} <span class="cax-alert-pill" style="background:color-mix(in srgb,var(--down) 16%,transparent);color:var(--down)">{{ t('HIGH','高') }}</span></div>
    {% if _rr_score is not none %}
    <div class="cax-bignum" style="color:var(--down)">{{ _rr_score }}<span style="font-size:14px;color:var(--muted)"> /100</span></div>
    <div class="cax-bigsub" style="color:var(--down)">{{ t(_rr.get('label_en') or '', _rr.get('label_zh') or '') }}</div>
    {% endif %}
    {% if _rr_p21 is not none %}<div class="cax-kv"><span class="k">{{ t('≥5% dip odds','≥5%回撤概率') }}</span><span class="v">{{ (_rr_p21*100)|round|int }}%</span></div>{% endif %}
    <div class="cax-foot">{{ t(_rr_do_en or 'High pullback risk — size down, watch alerts.', _rr_do_zh or '回撤风险高 — 缩仓，关注警报。') }}</div>
  </div>
  {% else %}
  <div class="cax-card">
    <div class="cax-ctitle">{{ t('Top Stock Setups','精选买点') }} <span style="margin-left:auto;font-size:10px;color:var(--muted)">{{ t('FROM SCREENER','来自筛选器') }}</span></div>
    {% for s in (top_setups or []) %}
    <div class="cax-stk">
      <span class="tkr"><a class="cax-tkr-btn" href="https://app.mastermind-x.com/terminal?symbol={{ s.ticker }}" target="_blank" rel="noopener">{{ s.ticker }}</a></span>
      <div class="meta"><b>{{ s.name or s.ticker }}</b> · {{ s.industry or s.sector or '' }}</div>
      <span class="cax-stage">{{ s.get('state') or 'ENTRY' }}</span>
    </div>
    {% else %}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">{{ t('No active setups right now.','暂无有效买点。') }}</div>
    {% endfor %}
    <a class="cax-screener-btn" href="canada_stocks.html">{{ t('Stock Screener →','选股看板 →') }}</a>
  </div>
  {% endif %}

  {# Participation (breadth) #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-breadth')">
    <div class="cax-ctitle">{{ t('Participation','参与度') }}</div>
    {% if breadth %}
    <div class="cax-kv"><span class="k">{{ t('Above 50d','50日上方') }}</span><span class="v {{ 'cax-tt-up' if breadth.pct_above_50 >= 50 else 'cax-tt-dn' }}">{{ breadth.pct_above_50 }}%</span></div>
    <div class="cax-kv"><span class="k">{{ t('Above 200d','200日上方') }}</span><span class="v {{ 'cax-tt-up' if breadth.pct_above_200 >= 50 else 'cax-tt-dn' }}">{{ breadth.pct_above_200 }}%</span></div>
    <div class="cax-kv"><span class="k">{{ t('Adv / Dec','涨/跌') }}</span><span class="v"><span style="color:var(--up)">{{ breadth.adv }}</span> / <span style="color:var(--down)">{{ breadth.dec }}</span></span></div>
    <div class="cax-kv"><span class="k">{{ t('Net new highs','净新高') }}</span><span class="v {{ 'cax-tt-up' if breadth.net_nh > 0 else ('cax-tt-dn' if breadth.net_nh < 0 else '') }}">{{ '%+d'|format(breadth.net_nh) }}</span></div>
    {% if breadth_chart %}
    {# waterline at 50%: above = more than half the market participating #}
    <div class="cax-lbl" style="margin-top:10px">{{ t('Above the 50-day line, 2 years','站上50日线占比 · 近2年') }}</div>
    <div class="cax-ilx">{{ breadth_chart | safe }}</div>
    {% endif %}
    <div class="cax-foot"><span class="cax-stword {{ 'ok' if breadth.state == 'broad' else ('warn' if breadth.state == 'mixed' else 'bad') }}">{% if breadth.state=='broad' %}{{ t('Broad — confirms the move.','广泛 — 确认走势。') }}{% elif breadth.state=='thin' %}{{ t('Thin — rallies are fragile.','稀薄 — 反弹脆弱。') }}{% else %}{{ t('Mixed — no clear edge.','参差 — 无明显方向。') }}{% endif %}</span></div>
    {% else %}
    <div style="font-size:12px;color:var(--muted)">{{ t('Breadth data pending…','广度数据待更新…') }}</div>
    {% endif %}
  </div>

  {# Sector Temperature #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-sector')">
    <div class="cax-ctitle">{{ t('Sector Temperature','板块温度') }}</div>
    {% set _buy_chips = ((actions.buy_now if actions and actions.buy_now else []) + (actions.buy_soon if actions and actions.buy_soon else []))[:3] %}
    {% set _avoid_chips = (actions.avoid if actions and actions.avoid else [])[:2] %}
    {% if _buy_chips %}
    <div class="cax-lbl">{{ t('Turning up','回升中') }}</div>
    <div class="cax-chips">
      {% for x in _buy_chips %}<span class="cax-chip turn">{{ td(x.name) }}</span>{% endfor %}
    </div>
    {% endif %}
    {% if _avoid_chips %}
    <div class="cax-lbl">{{ t('Avoid','回避') }}</div>
    <div class="cax-chips">
      {% for x in _avoid_chips %}<span class="cax-chip hot">{{ td(x.name) }}</span>{% endfor %}
    </div>
    {% endif %}
    <div class="cax-lbl">{{ t('Sector heat · green = leading · red = lagging','板块热度 · 绿=领涨 · 红=滞涨') }}</div>
    <div class="cax-heat">
      {# Tone is 20-day momentum, not the `dir` stance flag. Keying off `dir` made the strip
         dishonest under its own "Sector heat" label (dir is a turn/decline call, not heat)
         AND inverted the intensity: dir=='up' mapped to .h3 (opacity .3, the palest cell)
         while dir=='caution' mapped to .h2 (.55), so the strongest sectors looked weakest.
         Same thresholds as hk.html.j2 so the two strips read identically. #}
      {% for s in (sectors[:12] if sectors else []) %}
      {% set _m = s.mom20 %}
      {% set _tone = 'n' if _m is none else ('c' if _m < -1 else ('c2' if _m < 0 else ('h3' if _m < 1 else ('h2' if _m < 3 else 'h')))) %}
      <i class="{{ _tone }}"
         data-tip-en="{{ s.name }}{{ ': %+.1f%% over 20 days'|format(_m) if _m is not none else ': no 20-day reading' }}"
         data-tip-zh="{{ tr(s.name) }}{{ '：20日 %+.1f%%'|format(_m) if _m is not none else '：暂无20日数据' }}"></i>
      {% endfor %}
    </div>
    <div class="cax-heat-legend"><span class="heat-up">{{ t('▲ Heating','▲ 升温') }}</span><span class="heat-dn">{{ t('Cooling ▼','降温 ▼') }}</span></div>
    {# Stance: count by direction for a "so what" answer (Law 1) #}
    {% if sectors %}
    {% set _ns_up = (sectors | selectattr('dir', 'equalto', 'up') | list | length) %}
    {% set _ns_caution = (sectors | selectattr('dir', 'equalto', 'caution') | list | length) %}
    {% set _ns_dn = (sectors | selectattr('dir', 'equalto', 'down') | list | length) %}
    <div class="cax-foot"><span class="cax-stword {{ 'ok' if _ns_up > _ns_dn else ('bad' if _ns_dn > _ns_up else 'warn') }}">{% if _ns_up > _ns_dn %}{{ t('More rising than falling — lean long.','上升多于下降 — 偏多布局。') }}{% elif _ns_dn > _ns_up %}{{ t('More falling than rising — stay cautious.','下降多于上升 — 保持谨慎。') }}{% else %}{{ t('Balanced — watch, don\'t chase.','平衡 — 观察，勿追。') }}{% endif %}</span></div>
    {% endif %}
  </div>
</div>

<!-- =============== ROW 3: Commodities & FX + Rates & BoC + Housing =============== -->
<div class="cax-rack3">
  {# Commodities & FX #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-commod')">
    <div class="cax-ctitle">{{ t('Commodities & FX','大宗商品与汇率') }}</div>
    <div class="cax-kv"><span class="k">{{ t('Overlay state','叠加状态') }}</span><span class="v cax-stword {{ 'ok' if ov.state == 'Risk-on' else ('bad' if ov.state == 'Risk-off' else 'warn') }}">{{ td(ov.state or '—') }}</span></div>
    {% if ov.terms_of_trade %}<div class="cax-kv"><span class="k">{{ t('Terms of trade','贸易条件') }}</span><span class="v cax-stword {{ 'ok' if ov.terms_of_trade == 'improving' else ('bad' if ov.terms_of_trade == 'deteriorating' else 'warn') }}">{{ td(ov.terms_of_trade) }}</span></div>{% endif %}
    {# Glance tier gets the READ, not the z-score. A bare "+1.42σ" is decoration unless the
       reader knows what a sigma is and which direction helps Canada; the σ value keeps its
       precision on the hover receipt (and in the Tier-3 dialog, which still prints it). #}
    {% for f in (ov.factors or [])[:4] %}
    {% set _fz = f.z %}
    {% set _fstr = ('well above' if (_fz is not none and _fz >= 1) else ('above' if (_fz is not none and _fz >= 0.25) else ('well below' if (_fz is not none and _fz <= -1) else ('below' if (_fz is not none and _fz <= -0.25) else 'about')))) %}
    {% set _fstr_zh = ('明显高于' if (_fz is not none and _fz >= 1) else ('高于' if (_fz is not none and _fz >= 0.25) else ('明显低于' if (_fz is not none and _fz <= -1) else ('低于' if (_fz is not none and _fz <= -0.25) else '接近')))) %}
    {# NEVER td()/t() inside an attribute: those emit <span class="l-en">…</span><span
       class="l-zh">…</span>, whose inner quotes terminate the attribute and dump the rest
       of the tag on screen as text. Attributes take raw strings — f.label for EN,
       tr(f.label) for the ZH twin. (Same rule the title= CI guard enforces.) #}
    <div class="cax-kv"
         data-tip-en="{{ f.label }}: {{ '%+.2f'|format(_fz) if _fz is not none else 'n/a' }} standard deviations from its 1-year average{{ ' — supports Canadian assets' if f.risk == 'on' else (' — a headwind for Canadian assets' if f.risk == 'off' else '') }}"
         data-tip-zh="{{ tr(f.label) }}：较1年均值 {{ '%+.2f'|format(_fz) if _fz is not none else '无' }} 个标准差{{ '（利多加拿大资产）' if f.risk == 'on' else ('（利空加拿大资产）' if f.risk == 'off' else '') }}">
      <span class="k">{{ td(f.label) }}</span>
      <span class="v cax-stword {{ 'ok' if f.risk == 'on' else ('bad' if f.risk == 'off' else 'warn') }}">{{ t(_fstr ~ ' normal', '' ~ _fstr_zh ~ '常态') }}</span>
    </div>
    {% endfor %}
    {% if cmd_charts and cmd_charts.wti %}
    <div class="cax-lbl" style="margin-top:10px">{{ t('WTI crude, 2 years','WTI 原油 · 近2年') }}</div>
    <div class="cax-ilx">{{ cmd_charts.wti | safe }}</div>
    {% endif %}
  </div>

  {# Rates & BoC #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-rates')">
    <div class="cax-ctitle">{{ t('Rates & BoC','利率与央行') }}</div>
    {% if cp.boc_rate is not none %}
    <div class="cax-kv"><span class="k">{{ t('BoC rate','加央行利率') }}</span><span class="v"><b>{{ '%.2f'|format(cp.boc_rate) }}%</b></span></div>
    {% endif %}
    {# "GoC 2s10s" / "GoC−UST 10y" are desk shorthand with no units — unreadable cold.
       Glance tier names the thing in plain words and says which way it leans; the exact
       spread keeps its decimals on the hover receipt. #}
    {% if cp.goc_curve_2s10s is not none %}
    <div class="cax-kv"
         data-tip-en="Canada 10-year yield minus the 2-year: {{ '%+.2f'|format(cp.goc_curve_2s10s) }} percentage points. Positive is the normal shape; negative (inverted) has often led slowdowns."
         data-tip-zh="加拿大10年期减2年期国债收益率：{{ '%+.2f'|format(cp.goc_curve_2s10s) }} 个百分点。正值为常态；负值（倒挂）常领先经济放缓。">
      <span class="k">{{ t('Long vs short bonds','长债 vs 短债') }}</span>
      <span class="v cax-stword {{ 'ok' if cp.goc_curve_2s10s > 0 else 'warn' }}">{{ t('normal shape','形态正常') if cp.goc_curve_2s10s > 0 else t('inverted — caution','倒挂 — 谨慎') }}</span>
    </div>
    {% endif %}
    {% if cp.goc_minus_ust_10y is not none %}
    <div class="cax-kv"
         data-tip-en="Canada's 10-year government yield minus the US 10-year: {{ '%+.2f'|format(cp.goc_minus_ust_10y) }} percentage points. Canada paying less than the US tends to weaken the Canadian dollar."
         data-tip-zh="加拿大10年期国债收益率减美国10年期：{{ '%+.2f'|format(cp.goc_minus_ust_10y) }} 个百分点。加拿大利率低于美国通常令加元偏弱。">
      <span class="k">{{ t('Canada vs US 10-year','加债 vs 美债 10年') }}</span>
      <span class="v cax-stword {{ 'warn' if cp.goc_minus_ust_10y < 0 else 'ok' }}">{{ t('Canada pays less','加拿大更低') if cp.goc_minus_ust_10y < 0 else t('Canada pays more','加拿大更高') }}</span>
    </div>
    {% endif %}
    <div class="cax-kv"><span class="k">{{ t('BoC stance','央行立场') }}</span><span class="v">{{ td(latest.liquidity_overlay) }}</span></div>
    {% if spread_chart %}
    <div class="cax-lbl" style="margin-top:10px">{{ t('Canada vs US 10-year, 5 years','加债 vs 美债 10年 · 近5年') }}</div>
    <div class="cax-ilx">{{ spread_chart | safe }}</div>
    {% endif %}
    {# Stance: derive from BoC stance (Law 1 — every card answers "so what") #}
    {% set _liq = (latest.liquidity_overlay or '') | lower %}
    <div class="cax-foot">{% if 'easing' in _liq or 'accommodative' in _liq %}<span class="cax-stword ok">{{ t('BoC easing — tailwind for TSX. Watch duration.','央行宽松 — TSX 顺风。关注久期。') }}</span>{% elif 'tighten' in _liq or 'restrictive' in _liq or 'hawkish' in _liq %}<span class="cax-stword bad">{{ t('BoC tight — rate headwind. Favour shorter duration.','央行收紧 — 利率逆风。偏好短久期。') }}</span>{% elif 'neutral' in _liq or 'hold' in _liq or 'pause' in _liq %}<span class="cax-stword warn">{{ t('BoC on hold — watch data for the next move.','央行暂停 — 观察数据等待下一步。') }}</span>{% else %}<span class="cax-stword warn">{{ t('Watch — no clear BoC signal.','观察 — 央行信号不明。') }}</span>{% endif %}</div>
  </div>

  {# Housing #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-housing')">
    <div class="cax-ctitle">{{ t('Housing','房地产') }}</div>
    {% if housing %}
    <div class="cax-kv"><span class="k">{{ t('Real price index','实际房价指数') }}</span><span class="v"><b>{{ housing.level }}</b></span></div>
    {% if housing.yoy is not none %}<div class="cax-kv"><span class="k">{{ t('~1y change','约1年变化') }}</span><span class="v cax-stword {{ 'ok' if housing.yoy >= 0 else 'bad' }}">{{ '%+.1f'|format(housing.yoy) }}%</span></div>{% endif %}
    <div class="cax-kv"><span class="k">{{ t('Off peak','距峰值') }}</span><span class="v cax-stword {{ 'bad' if housing.off_peak < -10 else 'warn' }}">{{ '%.1f'|format(housing.off_peak) }}%</span></div>
    {% if house_chart %}<div class="cax-ilx">{{ house_chart | safe }}</div>{% endif %}
    {# Stance from off_peak — Law 1 every card answers "so what" #}
    <div class="cax-foot">{% if housing.off_peak < -20 %}<span class="cax-stword bad">{{ t('Prices well below peak — mortgage stress risk. Protect.','房价远低于峰值 — 按揭风险。保守为主。') }}</span>{% elif housing.off_peak < -10 %}<span class="cax-stword warn">{{ t('Prices off peak — watch household debt drag.','房价低于峰值 — 关注家庭债务压力。') }}</span>{% else %}<span class="cax-stword warn">{{ t('Near peak — fragility remains high.','接近峰值 — 脆弱性依然较高。') }}</span>{% endif %}</div>
    {% else %}
    <div style="font-size:12px;color:var(--muted)">{{ t('Housing data not available.','房产数据暂不可用。') }}</div>
    {% endif %}
  </div>
</div>

<!-- =============== ROW 4: Standouts inside each sector =============== -->
{# The `alpha` cross-section (218 TSX names, sector-neutral residual momentum) was computed
   nightly, written to site/factordata/canada_alpha.json, and never rendered on this page —
   the single largest block of dark data Canada had. Only names are shown: the raw alpha
   score is a unitless residual and means nothing at a glance (Law 3), so it lives on the
   hover receipt. alpha.note calls this "a modest, regime-decayed edge — context, not a buy
   list", and the footer says exactly that in plain words. #}
{% if alpha and alpha.by_sector %}
{% set _sec_rows = [] %}
{% for _sname, _sv in (alpha.by_sector | dictsort) %}
  {% if (_sv.leaders or _sv.laggards) and (_sv.n or 0) >= 4 %}
    {% set _ = _sec_rows.append((_sname, _sv)) %}
  {% endif %}
{% endfor %}
{% if _sec_rows %}
<div class="cax-rack1">
  <div class="cax-card">
    <div class="cax-ctitle">{{ t('Standouts inside each sector','各板块内的领先与落后') }}</div>
    <div class="cax-sub" style="margin:-2px 0 12px">{{ t('Names beating — and trailing — their own sector, with the market\'s move stripped out. Use it to pick within a sector you already like.','剔除大盘影响后，各板块内表现领先与落后的个股。用于在已看好的板块内选股。') }}</div>
    <div class="cax-sogrid">
      {% for _sname, _sv in _sec_rows[:8] %}
      <div class="cax-socell">
        <div class="cax-solbl">{{ td(_sname) }} <span class="cax-son">{{ _sv.n }}{{ t(' names',' 只') }}</span></div>
        {% for _r in (_sv.leaders or [])[:2] %}
        <div class="cax-sorow"
             data-tip-en="{{ _r.name or _r.ticker }} — leads {{ _sname }}{{ ', rank %d of %d'|format(_r.sector_rank, _r.sector_n) if _r.sector_rank else '' }}. Sector-neutral residual momentum{{ ' %+.2f'|format(_r.alpha) if _r.alpha is not none else '' }} over a 12-month window, skipping the last month."
             data-tip-zh="{{ _r.name or _r.ticker }} — {{ tr(_sname) }}板块领先{{ '，第 %d/%d 名'|format(_r.sector_rank, _r.sector_n) if _r.sector_rank else '' }}。剔除板块与大盘后的残差动量{{ ' %+.2f'|format(_r.alpha) if _r.alpha is not none else '' }}（12个月，跳过最近1个月）。">
          <span class="cax-soarrow up">▲</span>
          {# individual names live on the per-stock page's hash route; sectors/*.html is
             the sector-ETF namespace only (52 ETF pages) and would 404 for a stock. #}
          <a class="cax-sotkr" href="canada_stock.html#{{ _r.ticker }}">{{ _r.ticker | replace('.TO','') }}</a>
          <span class="cax-soname">{{ _r.name or '' }}</span>
        </div>
        {% endfor %}
        {% for _r in (_sv.laggards or [])[:1] %}
        <div class="cax-sorow"
             data-tip-en="{{ _r.name or _r.ticker }} — trails {{ _sname }}{{ ', rank %d of %d'|format(_r.sector_rank, _r.sector_n) if _r.sector_rank else '' }}. Sector-neutral residual momentum{{ ' %+.2f'|format(_r.alpha) if _r.alpha is not none else '' }} over a 12-month window, skipping the last month."
             data-tip-zh="{{ _r.name or _r.ticker }} — {{ tr(_sname) }}板块落后{{ '，第 %d/%d 名'|format(_r.sector_rank, _r.sector_n) if _r.sector_rank else '' }}。剔除板块与大盘后的残差动量{{ ' %+.2f'|format(_r.alpha) if _r.alpha is not none else '' }}（12个月，跳过最近1个月）。">
          <span class="cax-soarrow dn">▼</span>
          {# individual names live on the per-stock page's hash route; sectors/*.html is
             the sector-ETF namespace only (52 ETF pages) and would 404 for a stock. #}
          <a class="cax-sotkr" href="canada_stock.html#{{ _r.ticker }}">{{ _r.ticker | replace('.TO','') }}</a>
          <span class="cax-soname">{{ _r.name or '' }}</span>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    <div class="cax-foot">
      <span class="cax-stword warn">{{ t('Context for where to look — not a buy list.','仅供参考方向 — 非买入清单。') }}</span>
      {{ t('These compare a name only against its own sector, so a leader in a falling sector can still fall.','这些排名仅在板块内部比较：弱势板块中的领先股仍可能下跌。') }}
    </div>
    <div class="cax-receipt">{{ t('Sector-neutral residual momentum over 12 months, skipping the most recent month; %d names as of %s. Display-only.'|format(alpha.n or 0, alpha.as_of or '—'), '剔除板块与大盘后的12个月残差动量（跳过最近1个月）；截至 %s，共 %d 只。仅供展示。'|format(alpha.as_of or '—', alpha.n or 0)) }}</div>
  </div>
</div>
{% endif %}
{% endif %}

<!-- =============== DIALOGS =============== -->

<!-- Factor breakdown dialog -->
<div class="cax-dlg" id="cax-dlg-read">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('Factor Breakdown','因子分解') }}</span>
      <button class="cax-dlg-close" onclick="caxCloseDlg()">✕</button>
    </div>
