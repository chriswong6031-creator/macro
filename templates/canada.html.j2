    </div>
    <div class="cax-dlg-body">
      {% if breadth %}
      <div class="cax-eyebrow">{{ t('Breadth snapshot','广度快照') }}</div>
      <div class="cax-kv"><span class="k">{{ t('Above 50-day MA','50日均线上方') }}</span><span class="v">{{ breadth.pct_above_50 }}%</span></div>
      <div class="cax-kv"><span class="k">{{ t('Above 200-day MA','200日均线上方') }}</span><span class="v">{{ breadth.pct_above_200 }}%</span></div>
