{# hero locals #}
{% set ms = market_state %}
{% set _ms_color = (ms.color if ms else 'yellow') %}
{% set _ms_score = (ms.score if ms else 50) %}
{% set _ms_verdict = (ms.verdict if ms else 'MIXED') %}
{% set _ms_label = (ms.label_en if ms else 'Mixed') %}
{% set _ms_label_zh = (ms.label_zh if ms else '混合') %}
{% set _ms_posture = (ms.posture_en if ms else 'Trade with caution') %}
{% set _ms_posture_zh = (ms.posture_zh if ms else '谨慎交易') %}
{% set _ms_thesis = (ms.headline_en if ms else '') %}
{% set _ms_thesis_zh = (ms.headline_zh if ms else '') %}
{% set _ms_flip = (ms.flip_en if ms else '') %}
{% set _ms_flip_zh = (ms.flip_zh if ms else '') %}
{% set _comps = (ms.components if ms else []) %}
{% set _rr = (ms.radar if ms else {}) %}
{% set _rr_score = (_rr.get('top_score') if (_rr and _rr.get('top_score') is not none) else none) %}
{% set _rr_p21 = _rr.get('dd21') if _rr else none %}
{% set _rr_lift = _rr.get('dd_lift') if _rr else none %}
{% set _rr_do_en = (_rr.get('do_en') or '') if _rr else '' %}
{% set _rr_do_zh = (_rr.get('do_zh') or '') if _rr else '' %}
{% set ov = overlay or {} %}
{% set cp = coupling or {} %}

<div class="cax-wrap">

<!-- =============== HERO =============== -->
<div class="cax-card cax-hero{{ ' cax-hero-solo' if not (ms_history and ms_history|length >= 2) else '' }} ms-front ms ms-{{ _ms_color }}" id="ms-board" style="padding:0">
  <div class="cax-hero-left">
    {# quad zh from the site's canonical map (_regime_prob_panel idiom) — the vm
       carries no quad_name_zh; never render EN into the zh span. #}
    {% set _QZH = {'Goldilocks':'理想增长','Reflation':'再通胀','Stagflation':'滞胀','Growth-scare':'增长恐慌','Growth scare':'增长恐慌'} %}
    {% set _CZH = {'early':'早期','mid':'中期','late':'后期'} %}
    <span class="cax-regime-pill"><span class="dot"></span>
      {{ t(latest.quad_name, _QZH.get(latest.quad_name, latest.quad_name)) }}<span style="opacity:.55"> · {{ t(latest.cycle_tag or 'mid', _CZH.get(latest.cycle_tag or 'mid', latest.cycle_tag or 'mid')) }}</span></span>
    <div class="cax-gauge-row">
      {% set _ang = (_ms_score / 100) %}
      <svg class="cax-gauge-svg" viewBox="0 0 120 78" aria-hidden="true">
        <path d="M12 68 A50 50 0 0 1 108 68" fill="none" stroke="rgba(255,255,255,.09)" stroke-width="9" stroke-linecap="round"/>
        <path class="cax-gauge-fill" d="M12 68 A50 50 0 0 1 108 68" fill="none" stroke="{{ 'var(--up)' if _ms_color == 'green' else ('var(--down)' if _ms_color == 'red' else 'var(--warn)') }}" stroke-width="9" stroke-linecap="round" stroke-dasharray="{{ _ms_score * 1.57 }} 200"/>
      </svg>
      <div>
        <div class="cax-score-line"><span id="ms-score" class="cax-big-score">{{ _ms_score }}</span><span id="ms-word" class="cax-verdict">{{ t(_ms_label, _ms_label_zh) }} <span class="arr">▶</span></span></div>
        <div class="cax-sub-line">
          <span class="cax-sub-g"><span class="l-en">GREEN — TREND-FOLLOWING SUPPORTED</span><span class="l-zh">绿 — 支持趋势跟随</span></span>
          <span class="cax-sub-y"><span class="l-en">YELLOW — TRADE WITH CAUTION</span><span class="l-zh">黄 — 谨慎交易</span></span>
          <span class="cax-sub-r"><span class="l-en">RED — DEFEND CAPITAL</span><span class="l-zh">红 — 优先保住本金</span></span>
        </div>
      </div>
    </div>
    <p class="cax-thesis">{{ t(_ms_thesis or 'TSX market state.', _ms_thesis_zh or 'TSX 市场状态。') }}</p>
    {% if _ms_flip %}<div class="cax-flip">{{ t(_ms_flip, _ms_flip_zh or _ms_flip) }}</div>{% endif %}
    <div class="cax-hero-btns">
      {% set _n_bull = (_comps | selectattr('tone', 'equalto', 'pos') | list | length) %}
      {% set _n_total = (_comps | length) %}
      <button class="cax-hbtn" onclick="caxTogglePop('cax-pop-signals',event)">⌁
        <span class="l-en">{{ _n_bull }} of {{ _n_total }} signals aligned</span><span class="l-zh">{{ _n_total }} 项中 {{ _n_bull }} 项一致</span>
        <span class="n">▾</span></button>
      <button class="cax-hbtn" onclick="caxTogglePop('cax-pop-risk',event)" style="border-color:rgba(224,100,100,.5)">⚠
        <span class="l-en">Pullback risk</span><span class="l-zh">回撤风险</span>{% if _rr_score is not none %} · <span class="n" style="color:var(--act)">{{ _rr_score }}</span>{% endif %} ▾</button>

      <!-- popover: factor breakdown -->
      <div class="cax-pop" id="cax-pop-signals">
        <div class="cax-pop-h">{{ t('Factor breakdown', '因子分解') }} — {{ _n_total }} {{ t('signals', '信号') }}</div>
        {% for c in _comps %}
        <div class="cax-pop-row">
          <div class="pr-t">
            <span {% if c.tone == 'bad' %}style="color:var(--down)"{% elif c.tone == 'good' %}style="color:var(--up)"{% endif %}>{{ t(c.label_en, c.label_zh) }}</span>
            <b {% if c.tone == 'bad' %}style="color:var(--down)"{% elif c.tone == 'good' %}style="color:var(--up)"{% endif %}>{{ c.score }}</b>
          </div>
          <div class="cax-pop-bar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'good' else ('var(--down)' if c.tone == 'bad' else 'var(--warn)') }}"></i></div>
        </div>
        {% endfor %}
        <span class="cax-pop-link" onclick="caxClosePops();caxOpenDlg('cax-dlg-read')">{{ t('Full breakdown ↓', '完整分解 ↓') }}</span>
      </div>

      <!-- popover: pullback risk radar -->
      <div class="cax-pop" id="cax-pop-risk" style="left:auto">
        <div class="cax-pop-h">{{ t('Pullback risk radar', '回撤风险雷达') }}</div>
        {% if _rr_score is not none %}
        <div class="cax-pop-big"><span class="n">{{ _rr_score }}</span><span class="t">{{ t(_rr.get('label_en') or '', _rr.get('label_zh') or '') }}</span></div>
        <div class="cax-pop-sub">{{ t(_rr_do_en or _ms_posture, _rr_do_zh or _ms_posture_zh) }}</div>
        {% for leg in (_rr.get('scares') or [])[:3] %}
        <div class="cax-pop-row">
          <div class="pr-t"><span>{{ t(leg.get('label_en') or leg.get('scare',''), leg.get('label_zh') or leg.get('scare','')) }}</span><b>{{ leg.score|round|int }}</b></div>
          <div class="cax-pop-bar"><i style="width:{{ leg.score|round|int }}%;background:var(--act)"></i></div>
        </div>
        {% endfor %}
        {% else %}
        <div class="cax-pop-sub">{{ t('No radar data.', '暂无雷达数据。') }}</div>
        {% endif %}
        <span class="cax-pop-link" onclick="caxClosePops();caxOpenDlg('cax-dlg-risk')">{{ t('Full risk detail ↓', '完整风险详情 ↓') }}</span>
      </div>
    </div>
  </div>
  <div class="cax-hero-right">
    <div class="cax-path-h"><span>{{ t('11-session path', '11交易日走势') }}</span></div>
    {% if ms_history and ms_history | length >= 2 %}
    {% set _pts = ms_history %}
    {% set _n = _pts | length %}
    <svg class="cax-path-svg" viewBox="0 0 560 232" aria-hidden="true">
      <rect x="20" y="22" width="520" height="56" fill="rgba(69,184,115,.06)"/>
      <rect x="20" y="134" width="520" height="56" fill="rgba(224,100,100,.06)"/>
      <line x1="20" y1="106" x2="540" y2="106" stroke="rgba(224,160,48,.35)" stroke-dasharray="4 4" stroke-width="1"/>
      <text x="540" y="34" font-size="9" fill="var(--up)" text-anchor="end">{{ t('Risk-on','风险偏好') }}</text>
      <text x="540" y="103" font-size="9" fill="var(--warn)" text-anchor="end">{{ t('Mixed','混合') }}</text>
      <text x="540" y="186" font-size="9" fill="var(--down)" text-anchor="end">{{ t('Risk-off','避险') }}</text>
      <text x="14" y="26" font-size="9" fill="var(--muted)" text-anchor="end">100</text>
      <text x="14" y="109" font-size="9" fill="var(--muted)" text-anchor="end">50</text>
      <text x="14" y="192" font-size="9" fill="var(--muted)" text-anchor="end">0</text>
      {% set _step = 520 / ([_n - 1, 1] | max) %}
      {% set _poly_pts = [] %}
      {% for p in _pts %}{% set _x = 20 + loop.index0 * _step %}{% set _y = 190 - (p.score / 100) * 168 %}{% set _ = _poly_pts.append((_x|round(1)|string) + ' ' + (_y|round(1)|string)) %}{% endfor %}
      <path d="M{{ _poly_pts | join(' L') }}"
            fill="none" stroke="{{ 'var(--up)' if _ms_color == 'green' else ('var(--down)' if _ms_color == 'red' else 'var(--warn)') }}" stroke-width="2.2" stroke-linejoin="round"/>
      <text x="30" y="222" font-size="9" fill="var(--muted)">{{ _pts[0].date if _pts[0] else '' }}</text>
      <text x="536" y="222" font-size="9" fill="var(--muted)" text-anchor="end">{{ _pts[-1].date if _pts[-1] else '' }}</text>
    </svg>
    {% else %}
    <div style="height:232px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--muted)">{{ t('Building score history…','评分历史积累中…') }}</div>
    {% endif %}
  </div>
</div>
{# /hero #}

<!-- =============== 4 MARKET TILES =============== -->
<div class="cax-secbar"><b>{{ t('CANADA DASHBOARD','加拿大看板') }}</b><span>{{ latest.date }}</span></div>
<div class="cax-tiles">
  {# TSX Composite #}
  {% if benchmark %}
  <div class="cax-card cax-tile" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-markets')">
    <div class="sym">^GSPTSE</div><div class="nm">{{ t('TSX COMPOSITE','TSX 综合') }}</div>
    <div class="px">{{ '{:,.0f}'.format(benchmark.price) }}</div>
    <div class="chg {{ 'up' if benchmark.chg >= 0 else 'dn' }}">{{ '%+.2f'|format(benchmark.chg) }}%</div>
  </div>
  {% else %}
  <div class="cax-card cax-tile" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-markets')">
    <div class="sym">^GSPTSE</div><div class="nm">{{ t('TSX COMPOSITE','TSX 综合') }}</div>
    <div class="px" style="color:var(--muted)">—</div>
  </div>
  {% endif %}
  {# Overlay-factor tiles. Jinja gotcha: {% set %} inside {% for %} is LOOP-LOCAL
     and never escapes — a plain `{% set _f = f %}` in the loop leaves the outer
     var none (all tiles rendered '—' until this used namespace()). #}
  {% set _tf = namespace(spy=none, cad=none, oil=none) %}
  {% for f in (ov.factors or []) %}
    {% set _lab = (f.label or '') %}
    {% if _tf.spy is none and ('SPY' in _lab or 'SP500' in _lab or 'S&P' in _lab) %}{% set _tf.spy = f %}{% endif %}
    {% if _tf.cad is none and ('CAD' in _lab) %}{% set _tf.cad = f %}{% endif %}
    {% if _tf.oil is none and ('oil' in _lab|lower or 'crude' in _lab|lower or 'energy' in _lab|lower) %}{% set _tf.oil = f %}{% endif %}
  {% endfor %}
  {# S&P 500 (US context via overlay) #}
  {% set _spy_f = _tf.spy %}
  <div class="cax-card cax-tile" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-commod')">
    <div class="sym">SPY</div><div class="nm">{{ t('S&P 500','标普500') }}</div>
    {% if _spy_f is not none %}
    <div class="px" style="font-size:14px">{{ '%+.2f'|format(_spy_f.z) }}σ</div>
    <div class="chg {{ 'up' if _spy_f.risk == 'on' else ('dn' if _spy_f.risk == 'off' else '') }}">{{ t({'on':'Risk-on','off':'Risk-off','neutral':'Neutral'}.get(_spy_f.risk or '', '—'), {'on':'偏多','off':'偏空','neutral':'中性'}.get(_spy_f.risk or '', '—')) }}</div>
    {% else %}
    <div class="px" style="color:var(--muted)">—</div>
    <div class="chg" style="color:var(--muted)">{{ t('US context','美股背景') }}</div>
    {% endif %}
  </div>
  {# USDCAD #}
  {% set _usdcad_f = _tf.cad %}
  <div class="cax-card cax-tile" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-commod')">
    <div class="sym">USDCAD</div><div class="nm">{{ t('LOONIE','加元') }}</div>
    {% if _usdcad_f is not none %}
    <div class="px" style="font-size:14px">{{ '%+.2f'|format(_usdcad_f.z) }}σ</div>
    <div class="chg {{ 'dn' if _usdcad_f.risk == 'on' else ('up' if _usdcad_f.risk == 'off' else '') }}">{{ t('CAD ' + ('firm' if _usdcad_f.risk == 'on' else ('soft' if _usdcad_f.risk == 'off' else 'flat')), '加元' + ('走强' if _usdcad_f.risk == 'on' else ('走弱' if _usdcad_f.risk == 'off' else '平稳'))) }}</div>
    {% else %}
    <div class="px" style="color:var(--muted)">—</div>
    <div class="chg" style="color:var(--muted)">{{ t('FX context','汇率背景') }}</div>
    {% endif %}
  </div>
  {# Crude / Energy #}
  {% set _oil_f = _tf.oil %}
  <div class="cax-card cax-tile" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-commod')">
    <div class="sym">XEG / OIL</div><div class="nm">{{ t('CRUDE / ENERGY','原油/能源') }}</div>
    {% if _oil_f is not none %}
    <div class="px" style="font-size:14px">{{ '%+.2f'|format(_oil_f.z) }}σ</div>
    <div class="chg {{ 'up' if _oil_f.risk == 'on' else ('dn' if _oil_f.risk == 'off' else '') }}">{{ t({'on':'Supportive','off':'Headwind','neutral':'Neutral'}.get(_oil_f.risk or '', '—'), {'on':'利多','off':'利空','neutral':'中性'}.get(_oil_f.risk or '', '—')) }}</div>
    {% else %}
    <div class="px" style="color:var(--muted)">—</div>
    <div class="chg" style="color:var(--muted)">{{ t('Commodity context','商品背景') }}</div>
    {% endif %}
  </div>
</div>

<!-- =============== ROW 1: What To Do + Regime Watch =============== -->
<div class="cax-rack2">
  {# What To Do #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-playbook')">
    <div class="cax-ctitle">{{ t('What To Do','该怎么做') }}</div>
    {% if actions %}
    {% set _buy_now = (actions.buy_now or []) %}
    {% set _buy_soon = (actions.buy_soon or []) %}
    {% set _avoid = (actions.avoid or []) %}
    {% if _buy_now %}
    <div class="cax-row"><span class="ic">✅</span><div class="tx"><b>{{ t('Buy now','立即买入') }}</b><span class="sub">{{ _buy_now | map(attribute='name') | list | join(' · ') | truncate(60, true, '…') }}</span></div></div>
    {% endif %}
    {% if _buy_soon %}
    <div class="cax-row"><span class="ic">⏳</span><div class="tx"><b>{{ t('Buy soon','即将买入') }}</b><span class="sub">{{ _buy_soon | map(attribute='name') | list | join(' · ') | truncate(60, true, '…') }}</span></div></div>
    {% endif %}
    {% if actions.get('on_the_run') %}
    <div class="cax-row"><span class="ic">🏃</span><div class="tx"><b>{{ t('On the run','顺势运行') }}</b><span class="sub">{{ t('do not chase','勿追高') }}</span></div></div>
    {% endif %}
    {% if _avoid %}
    <div class="cax-row"><span class="ic">🚫</span><div class="tx"><b>{{ t('Avoid','回避') }}</b><span class="sub">{{ _avoid | map(attribute='name') | list | join(' · ') | truncate(60, true, '…') }}</span></div></div>
    {% endif %}
    {% else %}
    <div class="cax-row"><span class="ic">◐</span><div class="tx"><b>{{ t('Regime data loading…','周期数据加载中…') }}</b></div></div>
    {% endif %}
  </div>
  {# Regime Watch #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-regime')">
    <div class="cax-ctitle">{{ t('Regime Watch','周期观察') }}</div>
    <div class="cax-kv"><span class="k">{{ t('Quad','象限') }}</span><span class="v">{{ td(latest.quad_name) }}</span></div>
    <div class="cax-kv"><span class="k">{{ t('Growth','增长') }}</span><span class="v {{ 'cax-tt-up' if latest.growth_score >= 0 else 'cax-tt-dn' }}">{{ '%+.2f'|format(latest.growth_score) }}</span></div>
    <div class="cax-kv"><span class="k">{{ t('Inflation','通胀') }}</span><span class="v {{ 'cax-tt-up' if latest.inflation_score >= 0 else 'cax-tt-dn' }}">{{ '%+.2f'|format(latest.inflation_score) }}</span></div>
    <div class="cax-kv"><span class="k">{{ t('Confidence','一致度') }}</span><span class="v">{{ '%.0f'|format(latest.confidence * 100) }}%</span></div>
    {# pending_quad is a float NaN when nothing is pending (NaN is truthy!) —
       the x == x self-equality test is the NaN-safe guard; also require days > 0 #}
    {% if latest.pending_quad and latest.pending_quad == latest.pending_quad and latest.pending_quad is string and (latest.pending_days or 0) > 0 %}<div class="cax-kv"><span class="k">{{ t('Pending','待确认') }}</span><span class="v" style="color:var(--warn)">{{ td(latest.pending_quad) }} <span style="color:var(--muted)">{{ latest.pending_days }}d</span></span></div>{% endif %}
  </div>
</div>

<!-- =============== ROW 2: Pullback Risk ↔ Top Stocks + Participation + Sector Temperature =============== -->
<div class="cax-rack3">
  {# Pullback Risk or Top Stocks #}
  {% set _risk_state = (_rr.get('state') if _rr else 'calm') %}
  {% set _show_risk = _risk_state in ('caution', 'elevated', 'risk-off') %}
  {% if _show_risk %}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-risk')" style="border-color:rgba(224,100,100,.35)">
    <div class="cax-ctitle">{{ t('Pullback Risk','回撤风险') }} <span class="cax-alert-pill" style="background:rgba(224,100,100,.16);color:var(--act)">{{ t('HIGH','高') }}</span></div>
    {% if _rr_score is not none %}
    <div class="cax-bignum" style="color:var(--act)">{{ _rr_score }}<span style="font-size:14px;color:var(--muted)"> /100</span></div>
    <div class="cax-bigsub" style="color:var(--act)">{{ t(_rr.get('label_en') or '', _rr.get('label_zh') or '') }}</div>
    {% endif %}
    {% if _rr_p21 is not none %}<div class="cax-kv"><span class="k">{{ t('≥5% dip odds','≥5%回撤概率') }}</span><span class="v">{{ (_rr_p21*100)|round|int }}%</span></div>{% endif %}
    <div class="cax-foot">{{ t(_rr_do_en or 'High pullback risk — size down, watch alerts.', _rr_do_zh or '回撤风险高 — 缩仓，关注警报。') }}</div>
  </div>
  {% else %}
  <div class="cax-card">
    <div class="cax-ctitle">{{ t('Top Stock Setups','精选买点') }} <span style="margin-left:auto;font-size:10px;color:var(--muted)">{{ t('FROM SCREENER','来自筛选器') }}</span></div>
    {% for s in (top_setups or []) %}
    <div class="cax-stk">
      <span class="tkr"><a class="cax-tkr-btn" href="https://app.mastermind-x.com/terminal?symbol={{ s.ticker }}" target="_blank" rel="noopener">{{ s.ticker }}</a></span>
      <div class="meta"><b>{{ s.name or s.ticker }}</b> · {{ s.industry or s.sector or '' }}</div>
      <span class="cax-stage">{{ s.get('state') or 'ENTRY' }}</span>
    </div>
    {% else %}
    <div style="font-size:12px;color:var(--muted);padding:8px 0">{{ t('No active setups right now.','暂无有效买点。') }}</div>
    {% endfor %}
    <a class="cax-screener-btn" href="canada_stocks.html">{{ t('Stock Screener →','选股看板 →') }}</a>
  </div>
  {% endif %}

  {# Participation (breadth) #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-breadth')">
    <div class="cax-ctitle">{{ t('Participation','参与度') }}</div>
    {% if breadth %}
    <div class="cax-kv"><span class="k">{{ t('Above 50d','50日上方') }}</span><span class="v {{ 'cax-tt-up' if breadth.pct_above_50 >= 50 else 'cax-tt-dn' }}">{{ breadth.pct_above_50 }}%</span></div>
    <div class="cax-kv"><span class="k">{{ t('Above 200d','200日上方') }}</span><span class="v {{ 'cax-tt-up' if breadth.pct_above_200 >= 50 else 'cax-tt-dn' }}">{{ breadth.pct_above_200 }}%</span></div>
    <div class="cax-kv"><span class="k">{{ t('Adv / Dec','涨/跌') }}</span><span class="v"><span style="color:var(--up)">{{ breadth.adv }}</span> / <span style="color:var(--down)">{{ breadth.dec }}</span></span></div>
    <div class="cax-kv"><span class="k">{{ t('Net new highs','净新高') }}</span><span class="v {{ 'cax-tt-up' if breadth.net_nh > 0 else ('cax-tt-dn' if breadth.net_nh < 0 else '') }}">{{ '%+d'|format(breadth.net_nh) }}</span></div>
    <div class="cax-foot"><span class="cax-stword {{ 'ok' if breadth.state == 'broad' else ('warn' if breadth.state == 'mixed' else 'bad') }}">{% if breadth.state=='broad' %}{{ t('Broad — confirms the move.','广泛 — 确认走势。') }}{% elif breadth.state=='thin' %}{{ t('Thin — rallies are fragile.','稀薄 — 反弹脆弱。') }}{% else %}{{ t('Mixed — no clear edge.','参差 — 无明显方向。') }}{% endif %}</span></div>
    {% else %}
    <div style="font-size:12px;color:var(--muted)">{{ t('Breadth data pending…','广度数据待更新…') }}</div>
    {% endif %}
  </div>

  {# Sector Temperature #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-sector')">
    <div class="cax-ctitle">{{ t('Sector Temperature','板块温度') }}</div>
    {% set _buy_chips = ((actions.buy_now if actions and actions.buy_now else []) + (actions.buy_soon if actions and actions.buy_soon else []))[:3] %}
    {% set _avoid_chips = (actions.avoid if actions and actions.avoid else [])[:2] %}
    {% if _buy_chips %}
    <div class="cax-lbl">{{ t('Turning up','回升中') }}</div>
    <div class="cax-chips">
      {% for x in _buy_chips %}<span class="cax-chip turn">{{ td(x.name) }}</span>{% endfor %}
    </div>
    {% endif %}
    {% if _avoid_chips %}
    <div class="cax-lbl">{{ t('Avoid','回避') }}</div>
    <div class="cax-chips">
      {% for x in _avoid_chips %}<span class="cax-chip hot">{{ td(x.name) }}</span>{% endfor %}
    </div>
    {% endif %}
    <div class="cax-lbl">{{ t('Sector heat','板块热度') }}</div>
    <div class="cax-heat">
      {% for s in (sectors[:12] if sectors else []) %}
      {% set _tone = 'c' if s.dir == 'down' else ('h2' if s.dir == 'caution' else ('h3' if s.dir == 'up' else 'n')) %}
      <i class="{{ _tone }}" title="{{ s.ticker }}"></i>
      {% endfor %}
    </div>
  </div>
</div>

<!-- =============== ROW 3: Commodities & FX + Rates & BoC + Housing =============== -->
<div class="cax-rack3">
  {# Commodities & FX #}
  <div class="cax-card" role="button" tabindex="0" onclick="caxOpenDlg('cax-dlg-commod')">
