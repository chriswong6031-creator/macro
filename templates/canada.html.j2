          {% if _pv.chg_20d_pct is not none %}<span class="cax-sub {{ 'cax-tt-up' if _pv.chg_20d_pct >= 0 else 'cax-tt-dn' }}">{{ '%+.1f'|format(_pv.chg_20d_pct) }}% 20d</span>{% endif %}
        </span>
      </div>
      {% endif %}
      {% endfor %}
      {% endif %}
      <div class="cax-receipt">{{ t('Cross-asset overlay: oil/gold/copper/CAD + US risk (SPY/VIX/DXY). Context only.','跨资产叠加：油/金/铜/加元 + 美股风险（SPY/VIX/DXY）。仅作背景。') }}</div>
    </div>
