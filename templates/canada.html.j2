      <div class="hero-eyebrow"><span class="num">{{ latest.date }}</span> · {{ t('CANADA TSX REGIME', '加拿大 TSX 周期') }}
        · <span class="num {{ 'pos' if latest.growth_score>=0 else 'neg' }}">{{ t('G','增') }} {{ '%+.2f'|format(latest.growth_score) }}</span>
        <span class="num {{ 'pos' if latest.inflation_score>=0 else 'neg' }}">{{ t('I','胀') }} {{ '%+.2f'|format(latest.inflation_score) }}</span>
        {{ help("Growth and inflation create the four regimes. Because the TSX is commodity-heavy, read this with the CAD/commodity overlay.", "增长与通胀组成四种周期。TSX 大宗商品权重高，所以要和加元/商品叠加一起看。") }}
      </div>
      <div class="hero-regime">
        <span class="hr-dot" style="background:var(--q{{ Q[1] }});box-shadow:0 0 14px var(--q{{ Q[1] }})"></span>
        <h1 class="hr-name">{{ td(latest.quad_name) }}</h1>
      </div>
      <p class="hero-says">{{ t(_ol[Q][0], _ol[Q][1]) }}</p>
      <p class="hero-says" style="margin-top:6px"><a class="navbtn" href="canada_history.html" style="font-size:12px">{{ t('Regime history →', '周期历史 →') }}</a></p>
    </div>
    <!-- RIGHT — vitals strip: Canada's native drivers -->
    <div class="hero-vitals">
      <div class="vital">
        <div class="v-top"><span class="v-label">{{ t('BoC STANCE', '央行立场') }}</span>
          {{ help('Recent BoC rate direction. Cuts ease conditions; hikes tighten.', '近期加央行利率方向。降息偏宽松；加息偏紧。') }}</div>
        <span class="v-chip liq-{{ latest.liquidity_overlay }}">{{ td(latest.liquidity_overlay) }}</span>
        <span class="v-mean">{{ t('policy-rate direction', '政策利率方向') }}</span>
      </div>
      <div class="vital">
        <div class="v-top"><span class="v-label">{{ t('COMMODITIES', '大宗商品') }}</span>
          {{ help('Commodity strength plus a firm CAD usually helps Canada. This is current context, not a forecast.', '商品走强且加元坚挺通常利好加拿大。这是当前背景，非预测。') }}</div>
        <span class="v-chip {{ 'tone-up' if ov.state=='Risk-on' else ('tone-down' if ov.state=='Risk-off' else '') }}">{{ td(ov.state or 'unknown') }}</span>
        <span class="v-mean">{% if ov.terms_of_trade %}{{ t('terms of trade', '贸易条件') }} {{ td(ov.terms_of_trade) }}{% else %}{{ t('oil · gold · CAD', '原油 · 黄金 · 加元') }}{% endif %}</span>
      </div>
      <div class="vital">
        <div class="v-top"><span class="v-label">{{ t('AGREEMENT', '一致度') }}</span>
          {{ help('How many inputs agree. Low agreement means choppy signals.', '有多少输入方向一致。一致度低代表信号较乱。') }}</div>
        <span class="v-num num-lg">{{ '%.0f'|format(latest.confidence*100) }}<small>%</small></span>
        <span class="v-meter" style="--p:{{ (latest.confidence*100)|round|int }}%;--mc:{{ 'var(--up)' if latest.confidence>=0.45 else ('var(--warn)' if latest.confidence>=0.30 else 'var(--down)') }}"></span>
      </div>
      <div class="vital">
        <div class="v-top"><span class="v-label">{{ t('CYCLE', '商业周期') }}</span></div>
        <span class="v-chip">{{ td(latest.cycle_tag) }}</span>
        <span class="v-mean">
          {%- if latest.confirming %}✓{{ latest.confirming|length }} {% endif %}{% if latest.contradicting %}✗{{ latest.contradicting|length }} {% endif %}{{ t('multi-year backdrop', '多年期背景') }}</span>
      </div>
    </div>
  </div>
  </div>{# /.ms-front — close the side-by-side board #}
</div>

<!-- ===== Commodity / CAD / BoC overlay hero (the primary driver) ===== -->
{% set ov = overlay or {} %}
<div class="panel">
  <h2>{{ t('Commodity / CAD / BoC-vs-Fed overlay', '大宗商品／加元／央行-美联储 叠加') }}
    {{ help('Fast read for the TSX: commodities, CAD, US risk appetite and volatility. Context only.', 'TSX 快速读数：商品、加元、美股风险偏好与波动率。仅作背景。') }}
  </h2>
  <div class="row" style="gap:18px">
    <span class="riskbig risk-{{ (ov.state or 'unknown')|lower|replace('-','') }}">{{ td(ov.state or 'unknown') }}</span>
    {% if ov.score is not none %}<span class="muted">{{ t('composite', '综合') }} {{ '%+.2f'|format(ov.score) }}</span>{% endif %}
    {% if ov.terms_of_trade %}<span class="chip {{ 'on' if ov.terms_of_trade=='improving' else ('off' if ov.terms_of_trade=='deteriorating' else 'neutral') }}">{{ t('Terms of trade', '贸易条件') }}: <b>{{ td(ov.terms_of_trade) }}</b></span>{% endif %}
  </div>
  <div class="factors">
    {% for f in ov.factors or [] %}
    <div class="fct {{ f.risk }}">
      <span class="fl">{{ td(f.label) }}</span>
      <span class="fv">{{ '%+.2f'|format(f.z) }}σ <span class="muted small">{{ f.risk }}</span></span>
    </div>
    {% endfor %}
  </div>
  {% set cp = coupling or {} %}
  {% if cp.boc_rate is not none %}
  <p class="small" style="margin:11px 0 0">{{ t('BoC vs Fed', '央行 vs 美联储') }}:
    {{ t('policy rate', '政策利率') }} <b>{{ '%.2f'|format(cp.boc_rate) }}%</b> ·
    {{ t('GoC 2s10s', '加债 2s10s') }} <b>{{ '%+.2f'|format(cp.goc_curve_2s10s) if cp.goc_curve_2s10s is not none else '—' }}</b>
    {% if cp.goc_minus_ust_10y is not none %} · {{ t('GoC−UST 10y', '加债−美债 10y') }} <b>{{ '%+.2f'|format(cp.goc_minus_ust_10y) }}</b>{% else %}<span class="muted"> · {{ t('US-coupling spreads pending FRED', '美债利差待 FRED') }}</span>{% endif %}
  </p>
  {% endif %}
</div>

<!-- ===== Rate path / GoC curve ===== -->
{% if curve_chart %}
<div class="panel">
  <h2>{{ t('Bank of Canada rate path & GoC curve', '央行利率路径与加债收益率曲线') }}
    {{ help('Shows BoC policy and the 2y/10y Canada yield curve.', '显示加央行政策利率与加拿大2年/10年曲线。') }}
  </h2>
  {{ curve_chart | safe }}
</div>
{% endif %}

<!-- ===== The two dials over time ===== -->
{% if axes_chart %}
<div class="panel">
  <h2>{{ t('Growth & inflation over time', '增长与通胀随时间变化') }}</h2>
  {{ axes_chart | safe }}
</div>
{% endif %}

<!-- ===== Sector rotation ===== -->
<div class="panel">
  <h2>{{ t('Sector rotation — TSX sector ETFs', '板块轮动 — TSX 板块 ETF') }}
    {{ help('Canadian sectors ranked by strength vs the TSX, with trend and cycle state.', '加拿大板块按相对 TSX 强弱排序，并显示趋势与周期状态。') }}
  </h2>
  <div class="cards">
    {% for c in sectors %}
    <div class="card">
      <div class="row" style="gap:8px">
        <span class="rk">#{{ c.rank if c.rank else '—' }}</span>
        <a href="sectors/{{ c.ticker }}.html"><b>{{ td(c.name) }}</b></a>
        <span class="muted small">{{ c.ticker }}</span>
        <span style="flex:1"></span>
        <span class="lad {{ 'up' if c.dir=='up' else ('down' if c.dir=='down' else 'flat') }}">{{ td(c.label) if c.label else td(c.state) }}</span>
      </div>
      <div class="row small muted" style="gap:10px; margin:6px 0">
        <span>{{ t('1m RS', '1月相对') }} {{ '%+.1f'|format(c.mom20) if c.mom20 is not none else '—' }}</span>
        <span>{{ t('3m RS', '3月相对') }} {{ '%+.1f'|format(c.mom60) if c.mom60 is not none else '—' }}</span>
        {% if c.pctile is not none %}<span>{{ t('pctile', '分位') }} {{ '%.0f'|format(c.pctile) }}</span>{% endif %}
        {% if c.above200 %}<span class="pos">↑200d</span>{% else %}<span class="neg">↓200d</span>{% endif %}
      </div>
      <div data-mtf='{{ c.mtf_json }}'></div>
    </div>
    {% endfor %}
  </div>
</div>

<!-- ===== Action board ===== -->
<div class="panel">
  <h2>{{ t('What to act on — sector entry timing', '可执行 — 板块入场时机') }}</h2>
  <div class="ab">
    {% set abmap = [('buy_now','✅ '+('立即买入' if False else 'Buy now'),'立即买入'), ('buy_soon','⏳ Buy soon','即将买入'), ("on_the_run", "🏃 ON THE RUN — don't chase", '顺势运行 — 勿追高'), ('take_profits','💰 Take profits','止盈'), ('hold','✋ Hold','持有'), ('avoid','🚫 Avoid','回避')] %}
    {% for key, en, zh in abmap %}
    {% set items = actions.get(key, []) %}
    <div class="abcol ab-{{ key }}">
      <h3>{{ t(en, zh) }} <span class="muted">({{ items|length }})</span></h3>
      {% for it in items %}<div class="it">{{ td(it.name) }} <span class="muted small">{{ it.ticker }}</span></div>{% endfor %}
      {% if not items %}<div class="it muted">—</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}{# /macro-only sections #}

<!-- ===== Standout stocks (BRANCH B ripe-list contract) — the TSX Stock Dashboard headline ===== -->
{% if mode == 'stocks' and setups and setups.buy %}
{# ── W8-G: JSON data block — feeds StockTable.init(); serialized in system (board) order.
   NO re-sorting here: _branch_b_order already delivered the correct system order; this
   block copies fields verbatim, preserving the delivered sequence (CN no-ordering-mutation
   pattern). stage is mapped from the CA group field (entry_open → ENTRY, setting_up → RIPENING)
   so the stocktable.js row-accent / filter logic works identically across markets. ── #}
{% set _ca_st_rows = [] %}
{% for _r in setups.buy %}
  {% set _sig = _r.get('signal') or {} %}
  {% set _conv = _r.get('conviction') or {} %}
  {% set _es = _r.get('entry_signal') or {} %}
  {% set _ca_row = {
    'ticker':            _r.ticker,
    'name':              _r.name or _r.ticker,
    'sector':            _r.sector or '',
    'stage':             'ENTRY' if _r.get('group') == 'entry_open' else 'RIPENING',
    '_stage':            'ENTRY' if _r.get('group') == 'entry_open' else 'RIPENING',
    'tier':              _sig.get('tier_cascade') or '',
    'price':             _r.get('price'),
    'off_high':          _r.get('off_high'),
    'conviction':        _conv.get('score') if _conv else none,
    'days_since_signal': _r.get('days_since_signal'),
    'alpha':             _r.get('alpha'),
    'entry_status':      _es.get('status') or '',
    'group':             _r.get('group') or '',
  } %}
  {% set _ = _ca_st_rows.append(_ca_row) %}
{% endfor %}
<script type="application/json" id="stocktable-data">
{
  "rows": {{ _ca_st_rows | tojson }},
  "as_of": {{ (setups.as_of or '') | tojson }}
}
</script>
{# ---- stocks-mode health banner (deliverable 5): breadth cache (HKCA-13), board-ledger
      failures, tailwind suppression — only degraded rows appear. ---- #}
{% if stocks_health %}
<div class="panel" style="border-color:color-mix(in srgb,var(--warn) 40%,var(--line))">
  <div class="row" style="gap:8px">
    <b style="color:var(--warn)">⚠ {{ t('Data health', '数据健康') }}</b>
    <span class="muted small">{{ t('some board inputs are degraded — the affected axes are suppressed, not silently filled', '部分榜单输入已降级 — 受影响的轴已抑制，而非静默填充') }}</span>
  </div>
  <div class="row small" style="gap:6px; margin-top:6px">
    {% for h in stocks_health %}
    <span class="chip off">{{ t(h.en, h.zh) }} <b>· {{ h.status }}</b>{% if h.last and h.last != '—' %} <span class="muted">({{ h.last }})</span>{% endif %}</span>
    {% endfor %}
  </div>
</div>
{% endif %}
<div class="panel" id="standouts">
  <h2>{{ t('⚡ Standout TSX names — ripe-list screen', '⚡ 突出的 TSX 个股 — 成熟清单筛选') }}
    {% if setups.eligible is defined %}<span class="muted small" style="font-weight:400; text-transform:none; letter-spacing:0">{{ setups.buy|length }} {{ t('shown ·', '已显示 ·') }} {{ setups.eligible }} {{ t('bottoming and turning up (not still falling)', '筑底并开始转向（而非仍在下跌）') }}</span>{% endif %}
    {{ help('Ranks bottoming TSX names: buyable now first, then names still setting up. # is order, not probability.', '排列正在筑底的 TSX 个股：可买的在前，仍在蓄势的在后。# 是顺序，不是概率。') }}
    {# W8-G: grid/table view toggle #}
    <span class="st-view-toggle" id="st-view-toggle" role="group" data-tip-en="Switch between grid and table view" data-tip-zh="切换卡片视图与表格视图">
      <button id="st-btn-grid" aria-selected="true" onclick="StockTable._setView('grid')">&#x229E; <span class="l-en">Grid</span><span class="l-zh">卡片</span></button>
      <button id="st-btn-table" aria-selected="false" onclick="StockTable._setView('table')">&#x2630; <span class="l-en">Table</span><span class="l-zh">表格</span></button>
    </span>
  </h2>
  {# ===== ONE desk-header "what this desk is / isn't" block (§7.2 / §7.3) — consolidates
     the caveat museum (the old per-page repetitions are DELETED; the tier badge lives on
     each card). Bilingual. ===== #}
  <div class="desk-hdr">
    <p class="dh-is"><span class="l-en">A short list of TSX names that look closest to ready.</span><span class="l-zh">一份最接近就绪的 TSX 个股短名单。</span></p>
    <p class="dh-isnt"><span class="l-en">Not a guaranteed buy list. The # is just the screen order.</span><span class="l-zh">不是保证买入清单。# 只是筛选顺序。</span>{{ help('The momentum screen is still being tested, so scores are hidden and only order is shown.', '动量筛选仍在检验中，所以隐藏分数，只显示顺序。') }}</p>
    {# CA2: CONFLUENCE stat — make a zero-cross tape VISIBLE. Counts board names with a
       FRESH MACD-2D × StochRSI-3D confluence buy TODAY (r.signal.tier). "0 of N" reads
       honestly when nothing crossed, rather than a silent all-None board. #}
    {% if setups.confluence %}
    <p class="dh-conf" data-tip-en="Counts names with a fresh multi-timeframe buy cross today. Zero is normal." data-tip-zh="统计今日出现新鲜多周期买入金叉的个股。为零很正常。">
      <span class="l-en">Confluence: <b class="{{ 'pos' if setups.confluence.crosses > 0 else 'neg' }}">{{ setups.confluence.crosses }}</b> buyable cross{{ '' if setups.confluence.crosses == 1 else 'es' }} today of {{ setups.confluence.board }} board names{% if setups.confluence.crosses == 0 %} — no fresh entry trigger on this tape{% endif %}.</span>
      <span class="l-zh">汇合：{{ setups.confluence.board }} 只榜单个股中今日有 <b class="{{ 'pos' if setups.confluence.crosses > 0 else 'neg' }}">{{ setups.confluence.crosses }}</b> 只出现可买金叉{% if setups.confluence.crosses == 0 %} — 本行情无新鲜入场触发{% endif %}。</span>
    </p>
    {% endif %}
  </div>
  {# CA2: SECTOR-CONCENTRATION banner (honesty, NOT forced diversification) — fires when
     >60% of the board shares one sector. States the fact + the sector counts; no re-rank. #}
  {% if setups.sector_concentration %}
  {% set sc = setups.sector_concentration %}
  <p class="chip off sec-conc" style="margin:2px 0 10px; display:block; line-height:1.6">
    <span class="l-en">🧭 <b>{{ sc.n }}/{{ sc.total }}</b> picks are <b>{{ sc.sector }}</b> — the basing cohort is concentrated in this complex on this tape.
      {% for s, n in sc.counts.items() %}<span class="muted">{{ s }} {{ n }}{{ '' if loop.last else ' ·' }}</span> {% endfor %}</span>
    <span class="l-zh">🧭 <b>{{ sc.n }}/{{ sc.total }}</b> 只精选属于 <b>{{ sc.sector }}</b> — 本行情筑底队列集中于该板块。
      {% for s, n in sc.counts.items() %}<span class="muted">{{ s }} {{ n }}{{ '' if loop.last else ' ·' }}</span> {% endfor %}</span>
  </p>
  {% endif %}
  {# ===== TRACK-RECORD panel (§7.4) — the desk's accountability centerpiece. Ships in
     'accruing' state with the honest first-stable-read date printed on the panel; flips to
     a scored hit-rate / rank-IC read once ≥5 IC-dates mature (≈ late-Aug 21d). ===== #}
  {% set trk = setups.board_track %}
  {% if trk %}
  <div class="trk">
    <p class="trk-h">📊 {{ t('Public scoreboard — this board, graded forward', '公开记分牌 — 本榜单前瞻评分') }}
      {% if trk.status == 'scored' %}<span class="trk-badge scored">{{ t('SCORED', '已评分') }}</span>{% else %}<span class="trk-badge">{{ t('ACCRUING', '累积中') }}</span>{% endif %}
    </p>
    {% if trk.status == 'scored' %}
    {% set h21 = (trk.by_horizon or {})['21d'] if (trk.by_horizon and '21d' in trk.by_horizon) else none %}
    <div class="trk-body"><span class="l-en">Each nightly board is logged and graded against forward excess return vs the TSX index. Lower rank-IC (more negative) means the board order predicted outperformance.</span><span class="l-zh">每晚榜单均被记录，并按相对 TSX 指数的前瞻超额收益评分。rank-IC 越低（越负）表示榜单顺序越能预测跑赢。</span></div>
    <div class="trk-grid">
      <div class="trk-cell"><div class="tv">{{ trk.n_graded if trk.n_graded is not none else '—' }}</div><div class="tk">{{ t('graded calls', '已评分') }}</div></div>
      {% if h21 and h21.rank_ic is not none %}<div class="trk-cell"><div class="tv">{{ '%+.2f'|format(h21.rank_ic) }}</div><div class="tk">{{ t('21d rank-IC', '21日 rank-IC') }}</div></div>{% endif %}
      {% if h21 and h21.hit_rate_21d is not none %}<div class="trk-cell"><div class="tv">{{ '%.0f'|format(h21.hit_rate_21d * 100) }}%</div><div class="tk">{{ t('21d buy hit-rate', '21日买入命中率') }}</div></div>{% endif %}
      {% if trk.n_suspended is not none %}<div class="trk-cell"><div class="tv">{{ trk.n_suspended }}</div><div class="tk">{{ t('suspended (excl.)', '已停牌（剔除）') }}</div></div>{% endif %}
    </div>
    {% else %}
    <div class="trk-body"><span class="l-en">Every nightly board is logged to a forward ledger and will be graded against realized excess return — <b>no cherry-picking, no hindsight</b>. The scoreboard is building in public.</span><span class="l-zh">每晚榜单都会写入前瞻账本，并按实际超额收益评分——<b>不挑样本、不事后诸葛</b>。记分牌正在公开累积。</span></div>
    <p class="trk-note"><span class="l-en">First stable read ≈ <b>{{ trk.first_read_est or '2026-08-24' }}</b> (needs ≥5 matured 21-day cross-sections). 63-day read ≈ Q4. Until then this panel is honestly empty.</span><span class="l-zh">首次稳定读数 ≈ <b>{{ trk.first_read_est or '2026-08-24' }}</b>（需 ≥5 个成熟的 21 日横截面）。63 日读数 ≈ 四季度。在此之前本面板如实留空。</span></p>
    {% endif %}
  </div>
  {% endif %}
  {# hard freshness gate banner (deliverable 4): tailwind axis suppressed when the
     canada_search panel is >3 trading days staler than the board's own price date. #}
  {% if setups.tailwind_suppressed %}
  <p class="chip off" style="margin:2px 0 8px">{{ t('Basket-tailwind axis suppressed', '篮子顺风轴已抑制') }}{% if setups.tailwind_stale_days is not none %} — {{ t('panel', '面板') }} {{ setups.tailwind_stale_days }} {{ t('trading days stale', '个交易日陈旧') }}{% else %} — {{ t('panel missing', '面板缺失') }}{% endif %}</p>
  {% endif %}
  {# W8-G: count chips row (live-updated by JS when in table mode) #}
  <div id="st-count-chips" style="display:none"></div>
  {# W8-G: table view mount point #}
  <div id="stocktable-wrap"></div>
  {# W8-G: grid section (hidden in table mode by CSS .nb-grid-section) #}
  <div class="nb-grid-section">
  <div class="cards" data-showmore-rows="3">
    {% for s in setups.buy %}
    {# ---- BRANCH-B group divider: entry-open before setting-up ---- #}
    {% if loop.first or s.group != setups.buy[loop.index0 - 1].group %}
    <div style="grid-column:1/-1; margin:4px 0 -2px">
      <span class="rk" style="text-transform:uppercase; letter-spacing:.05em">
        {% if s.group == 'entry_open' %}🟢 {{ t('Entry open now', '入场已开启') }}{% else %}🟡 {{ t('Setting up — awaiting trigger', '蓄势中 — 待触发') }}{% endif %}
      </span>
    </div>
    {% endif %}
    {% set c = s.conviction %}
    {# entry-window state drives the card accent (§7.4): open-now warm / pullback cool /
       wait muted — read from the entry-timing gauge's status. #}
    {% set _est = (s.entry_signal.status if s.entry_signal else none) %}
    {% set _ent = 'ent-open' if _est in ['buy_now','partial'] else ('ent-pullback' if _est in ['wait_pullback','buy_soon'] else ('ent-wait' if _est else '')) %}
    <div class="card {{ _ent }}">
      <div class="row" style="gap:8px">
        {# BRANCH B: composite 0-100 chip is SUPPRESSED; a small rank pill takes its place.
           The pill is a within-group order (#1, #2…), NOT a score/probability. #}
        <span class="rankpill" data-tip-en="Rank within this group, not a score." data-tip-zh="组内顺序，不是分数。">#{{ s.board_pos }}</span>
        <a href="canada_stock.html#{{ s.ticker }}"><b>{{ s.name or s.ticker }}</b></a>
        <span class="muted small">{{ s.ticker }}</span>
        <span style="flex:1"></span>
        {% if s.label %}<span class="lad {{ 'up' if s.dir=='up' else ('down' if s.dir=='down' else 'flat') }}">{{ td(s.label) }}</span>{% endif %}
      </div>
      {# mechanism-first card lead (§7.1): primary factor-beta driver + momentum SCREEN z
         (accruing) + insider cluster + entry window — built from fields already on the row. #}
      {% if s.lead_en %}<p class="nb-lead"><span class="l-en">{{ s.lead_en }}</span><span class="l-zh">{{ s.lead_zh or s.lead_en }}</span></p>{% endif %}
      <div class="row small muted" style="gap:10px; margin:5px 0">
        {% if s.alpha is not none %}<span data-tip-en="Momentum screen reading. Not a validated score." data-tip-zh="动量筛选读数。不是经验证评分。">{{ t('mom screen', '动量筛选') }} <b class="{{ 'pos' if s.alpha>=0 else 'neg' }}">{{ '%+.2f'|format(s.alpha) }}</b></span>{% endif %}
        {% if s.sector_rank %}<span>#{{ s.sector_rank }}/{{ s.sector_n }} {{ td(s.sector) }}</span>{% endif %}
        {% if s.off_high is not none %}<span>{{ '%.0f'|format(s.off_high) }}% {{ t('off high', '距高点') }}</span>{% endif %}
      </div>
      {# BRANCH-B tier badge line (replaces the composite score): honest one-liner, long
         form in the title tooltip. C1 oil context chip + extension log-and-grade chip. #}
      {# ── WHY-NOW evidence-tag chips (§7.4): each chip is colour-keyed to its evidence
         tier (accruing = dashed · oil-regime · insider · earnings-catalyst · extended),
         with a report-citing tooltip. Context/accruing legs, never rank inputs. ── #}
      <div class="nb-vf" style="margin-top:2px">
        {# CA2 tier badge — the confluence T1→T4 verdict per name. A FRESH MACD-2D × StochRSI-3D
           cross today reads T1..T4 (green); no fresh cross reads an honest "no confluence" chip
           so the reader sees the gate RAN and found nothing, not a missing badge. #}
        {% set _sig = s.signal %}
        {% if _sig and _sig.tier %}
        <span class="nb-vchip gate-tier gt-{{ _sig.tier|lower }}" data-tip-en="{{ _sig.tier }}: fresh multi-timeframe buy cross today." data-tip-zh="{{ _sig.tier }}：今日新鲜多周期买入金叉。">🎯 {{ _sig.tier }}{% if _sig.sub %} · {{ _sig.sub }}{% endif %}</span>
        {% elif _sig %}
        <span class="nb-vchip gate-none" data-tip-en="No fresh entry cross today. Wait; don't chase." data-tip-zh="今日无新鲜入场金叉。等待，勿追。">○ {{ t('no confluence cross', '无汇合金叉') }}</span>
        {% endif %}
        <span class="nb-vchip ev-accrue" data-tip-en="Useful screen, still unproven as an edge." data-tip-zh="有用筛选，但尚未证明为优势。">{{ t('momentum screen · unproven', '动量筛选 · 未验证') }}</span>
        {% if s.oil_tailwind %}<span class="nb-vchip ev-oil" data-tip-en="Oil is a live tailwind for this name." data-tip-zh="油价对该股形成当前顺风。">🛢 {{ t('oil tailwind', '油价顺风') }}</span>{% endif %}
        {% if s.insider and s.insider.lean == 'buying' and (s.insider.n_buys or 0) > 0 %}<span class="nb-vchip ev-insider" data-tip-en="Insiders have been net buyers. Context only." data-tip-zh="内部人近期净买入。仅作背景。">👤 {{ t('insider buying', '内部人买入') }} {{ s.insider.n_buys }}/{{ s.insider.n_sells }}</span>{% endif %}
        {% if s.earnings and s.earnings.days_to is defined and s.earnings.days_to is not none and s.earnings.days_to <= 21 %}<span class="nb-vchip ev-earn" data-tip-en="Earnings soon. Timing context only." data-tip-zh="财报将近。仅择时背景。">📅 {{ t('reports in', '财报还有') }} {{ s.earnings.days_to }}{{ t('d', '天') }}</span>{% endif %}
        {% if s.extended %}<span class="nb-vchip vf-exp" data-tip-en="Stretched vs trend. Chasing risk is higher." data-tip-zh="相对趋势偏高。追高风险更大。">📐 {{ t('extended', '偏离') }}{% if s.extended.ext_z is not none %} z{{ '%+.1f'|format(s.extended.ext_z) }}{% endif %}</span>{% endif %}
      </div>
      {% if s.spark_svg %}{{ s.spark_svg | safe }}{% endif %}
      {% if c %}
      {# composite 0-100 chip SUPPRESSED under Branch B — only the honest verdict text
         remains (desaturation applies to the SCORE chip only, never the narrative). #}
      <div class="nb-conv">
        <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
      </div>
      {% set al = c.alignment %}
      {% if al and al.line %}
      {# multi-timeframe ENTRY gate (engine.cycles.mtf_alignment): a low-risk SWING entry
         must be a FRESH turn from a low — weekly bear-recovering/basing + 3-day cross from
         oversold (<25) + daily just-crossed. 🟢 Prime/Armed = confirmed; 🟡 Approaching =
         early backfill (not yet a buy). The reason states WHY it qualifies. #}
      <div class="nb-align{{ ' nba-near' if s.align_tier == 'near' else '' }}" data-tip-en="{{ al.line }}" data-tip-zh="{{ al.line_zh }}">
        <span class="nba-mark">{{ '🟡' if s.align_tier == 'near' else '🟢' }}</span>
        <span class="nba-line"><span class="l-en">{{ al.reason or al.line }}</span><span class="l-zh">{{ al.reason_zh or al.line_zh }}</span></span>
        {% if al.entry_tier %}<span class="nba-tag">{{ t(al.entry_tier, al.entry_tier_zh) }}</span>{% endif %}
      </div>
      {% endif %}
      <div class="nb-axes">
        {% for ax, lbl, lbl_zh in [('selection','SEL','选股'),('entry','ENT','入场'),('tailwind','TWD','顺风'),('quality','QUAL','质量')] %}
        {# HARD freshness gate: when the tailwind panel is >3 trading days stale the
           tailwind axis is SUPPRESSED (shown as no-data), never filled from stale prices. #}
        {% set a = {'pct': none} if (ax == 'tailwind' and setups.tailwind_suppressed) else c.axes[ax] %}
        <div class="nb-ax{{ ' ax-na' if a.pct is none else '' }}" title="{{ lbl }}{% if ax == 'tailwind' and setups.tailwind_suppressed %} — suppressed (panel stale){% elif a.pct is not none %} {{ a.pct }}/100{% else %} — no data{% endif %}">
          <div class="axl">{{ t(lbl, lbl_zh) }}</div>
          <div class="axt"><div class="axf" style="width:{{ a.pct if a.pct is not none else 0 }}%"></div></div>
        </div>
        {% endfor %}
      </div>
      {# ENTRY-timing gauge (gauge 2): buy now / wait for the pullback / extended, with the
         actual buy-zone price + cycle position. WHEN/AT-WHAT-PRICE — never the conviction score. #}
      {% set es = s.entry_signal %}
      {% if es %}
      <div class="nb-entry nbe-{{ es.status }}" title="ENTRY timing (gauge 2) — when & at what price to buy. {{ es.action }}">
        <div class="nbe-head">
          <span class="nbe-dot a{{ es.act_level }}"></span>
          <span class="nbe-status"><span class="l-en">{{ es.headline }}</span><span class="l-zh">{{ es.headline_zh }}</span></span>
        </div>
        {% if es.buy_zone and es.buy_zone.high is not none %}
        <div class="nbe-zone">
          <span class="nbe-lbl">{{ t('Buy zone', '买入区') }}</span>
          <span class="nbe-px">${{ '%.2f'|format(es.buy_zone.low) }}{% if es.buy_zone.high != es.buy_zone.low %}–${{ '%.2f'|format(es.buy_zone.high) }}{% endif %}</span>
          {% if es.buy_zone.pct_from_spot is not none %}<span class="nbe-pct">{{ '%+.1f'|format(es.buy_zone.pct_from_spot) }}%</span>{% endif %}
        </div>
        {% endif %}
        {# CA2 port — PULLBACK ZONE (engine/pullback_zone): a don't-chase leader's concrete
           pullback price range, enriching the entry window. Log-and-grade, close-only, no
           rank effect. Presence-guarded (self-gates to None outside don't-chase territory). #}
        {% set _pz = s.pullback_zone %}
        {% if _pz and _pz.levels %}
        <div class="nbe-zone nbe-pull" data-tip-en="Possible pullback entry area." data-tip-zh="可能的回撤入场区。">
          <span class="nbe-lbl">{% if _pz.stance == 'chase' %}{{ t('Don\'t chase — reset', '勿追 — 回撤至') }}{% else %}{{ t('Pullback zone', '回撤区') }}{% endif %}</span>
          <span class="nbe-px">{% for lv in _pz.levels %}${{ '%.2f'|format(lv.price) }}{% if lv.pull_pct is not none %} <span class="muted">({{ '%+.1f'|format(lv.pull_pct) }}%)</span>{% endif %}{{ '' if loop.last else ' · ' }}{% endfor %}</span>
        </div>
        {% endif %}
      </div>
      {% endif %}
      {# CA2 port chips — HOLD basing-state note + DANNYTRADES vol-compression. Both
         log-and-grade context, never a rank/eligibility input (extension-demote idiom). #}
      {% if s.hold or s.dt_contra %}
      <div class="nb-vf">
        {% set _hd = s.hold %}
        {% if _hd and _hd.state %}
        <span class="nb-vchip {{ 'vf-coil' if _hd.state == 'intact' else ('vf-up' if _hd.state == 'launched' else 'vf-down') }}" data-tip-en="Tracks whether the base is intact, launched, or broken." data-tip-zh="跟踪筑底是否完好、启动或破位。">{% if _hd.state == 'intact' %}🪨 {{ t('basing', '筑底中') }} {{ _hd.days_basing }}d{% elif _hd.state == 'launched' %}🚀 {{ t('launched', '已启动') }}{% else %}💔 {{ t('base broken', '筑底破位') }}{% endif %}</span>
        {% endif %}
        {% set _dt = s.dt_contra %}
        {% if _dt and _dt.state and _dt.state != 'neutral' %}
        <span class="nb-vchip {{ 'vf-down' if _dt.state == 'fade' else 'vf-coil' }}" data-tip-en="Crowding or washout context." data-tip-zh="拥挤或洗盘背景。">{% if _dt.state == 'fade' %}🌡 {{ t('crowded — fade', '拥挤 — 谨防回吐') }}{% else %}💧 {{ t('washed — bounce', '超卖 — 反弹') }}{% endif %}</span>
        {% endif %}
      </div>
      {% endif %}
      {# vol-managed inverse-vol SIZE chip (engine/risk_sizing) — HOW MUCH to own (risk),
         separate from the conviction score (WHAT) and the entry gauge (WHEN). #}
      {% set _rs = s.risk_sizing %}
      {% if _rs and _rs.size_mult is not none %}
      <div class="nb-bot">
        <span class="nb-size {{ 'sz-up' if _rs.size_mult >= 1.1 else ('sz-dn' if _rs.size_mult <= 0.9 else '') }}" data-tip-en="Suggested size: less for volatile names, more for calmer names." data-tip-zh="建议仓位：波动大少配，波动小多配。">⚖ {{ '%.2f'|format(_rs.size_mult) }}×</span>
      </div>
      {% endif %}
      {# volatility black hole (vol_squeeze) chip #}
      {% set _vs = c.vol_squeeze %}
      {% if _vs and _vs.state in ['COILED','FIRED_UP','FIRED_DOWN','EXPANSION'] %}
      <div class="nb-vf">
        <span class="nb-vchip {{ {'COILED':'vf-coil','FIRED_UP':'vf-up','FIRED_DOWN':'vf-down','EXPANSION':'vf-exp'}[_vs.state] }}" data-tip-en="{{ 'Volatility is compressed; a move may be setting up.' if _vs.state=='COILED' else 'Volatility has already expanded; quiet entry may be gone.' }}" data-tip-zh="{{ '波动压缩，可能在酝酿行情。' if _vs.state=='COILED' else '波动已扩张，安静入场点可能已过。' }}">{% if _vs.state=='COILED' %}🌀 {{ t('Move loading','蓄势待发') }}{% elif _vs.state=='FIRED_UP' %}🚀 {{ t('Firing↑','向上突破') }}{% elif _vs.state=='FIRED_DOWN' %}🔻 {{ t('Firing↓','向下突破') }}{% else %}💥 {{ t('Already moving','已在异动') }}{% endif %}</span>
      </div>{% endif %}
      {% if c.cautions %}<div class="nb-cau"><button class="nb-cau-btn" type="button" aria-label="Caution notes ({{ c.cautions|length }})"><span class="l-en">⚠ Caution</span><span class="l-zh">⚠ 注意</span><span class="nb-cau-badge">{{ c.cautions|length }}</span></button><div class="nb-cau-pop" role="tooltip">{% for cau in c.cautions %}<span class="cau-row"><span class="l-en">{{ cau }}</span><span class="l-zh">{{ c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau }}</span></span>{% endfor %}</div></div>{% endif %}
      {% if c.notes %}{% for nt in c.notes %}<div class="nb-note nb-note-{{ nt.kind }}"><span class="l-en">ℹ {{ nt.en }}</span><span class="l-zh">ℹ {{ nt.zh }}</span></div>{% endfor %}{% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {# ===== WATCH strip (W6 parity R6/R7/R8) — strong momentum SCREEN, blocked entry
     (weekly not yet turned / falling knife). A real edge with NO base yet: watch, don't
     buy. Ported from hk.html.j2's watch-strip; links to canada_stock.html. ===== #}
  {% if setups.watch %}
  <div class="watch-strip">
    <p class="ws-h">👁 {{ t('On watch — strong screen, blocked entry (wait for a base)', '观察名单 — 筛选强但入场受阻（等待筑底）') }}</p>
    <div class="watch-grid">
      {% for w in setups.watch %}
      {% set wc = w.conviction %}
      <a href="canada_stock.html#{{ w.ticker }}" class="{{ 'wg-knife' if w.watch_reason == 'knife' else '' }}" title="{{ (wc.verdict if wc else '') }} · {{ w.block_reason or '' }}">
        <span class="wg-tk">{{ w.ticker }}{% if wc and wc.score is not none %} <span class="muted small" style="font-weight:600">· {{ wc.score }}</span>{% endif %} <span class="muted small">{{ t('mom', '动量') }} {{ '%+.2f'|format(w.alpha) }}</span></span>
        <span class="wg-v">{{ w.name }}{% if wc and wc.verdict %} — <span class="l-en">{{ wc.verdict }}</span><span class="l-zh">{{ wc.verdict_zh or wc.verdict }}</span>{% endif %}</span>
        {% if w.watch_reason == 'knife' %}
        <span class="wg-knife-chip" data-tip-en="Weekly trend is still falling. Wait for the turn." data-tip-zh="周线仍在下行。等待转向。">
          <span class="l-en">🔻 weekly still falling — wait for the turn</span><span class="l-zh">🔻 周线仍下行 — 等待转向</span>
        </span>
        {% else %}
        <span class="wg-blk-chip" data-tip-en="Strong screen, but entry is blocked until a base forms." data-tip-zh="筛选较强，但要等筑底后才可入场。">
          <span class="l-en">⏳ entry blocked — awaiting a base</span><span class="l-zh">⏳ 入场受阻 — 等待筑底</span>
        </span>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {# ===== LAGGARD / avoid strip (W6 parity) — weakest momentum screen: distribution /
     avoid. Fed by setups.laggards (and any falling-knife demotes surfaced above). ===== #}
  {% if setups.laggards %}
  <p class="note" style="margin:13px 0 5px; text-transform:none; color:var(--down); font-weight:700">⚠ {{ t('Weakest screen (laggards) — distribution / avoid:', '筛选最弱（落后股）— 派发／回避：') }}</p>
  <p style="margin:0; line-height:2">
    {% for r in setups.laggards %}<a href="canada_stock.html#{{ r.ticker }}" style="margin-right:14px; white-space:normal; overflow-wrap:anywhere"><b>{{ r.ticker }}</b> <span class="note">{{ r.name }}</span>{% if r.alpha is not none %} <span class="neg">{{ '%+.2f'|format(r.alpha) }}</span>{% endif %}</a>{% endfor %}
  </p>
  {% endif %}
  {# ===== AI-brief doorway (W6 §7.5) — presence-guarded. No CA AI brief exists yet
     (no canada_aibrief page in the build), so this is intentionally hidden until one
     ships. The guard means it lights up automatically the day a CA brief lands. ===== #}
  {% if ca_aibrief_href %}
  <a class="ai-brief-link" href="{{ ca_aibrief_href }}" style="margin-top:12px; display:inline-flex">🤖 {{ t('Read the Canada AI brief', '阅读加拿大 AI 简报') }}</a>
  {% endif %}
  </div>{# /.nb-grid-section #}
</div>
{% endif %}

<!-- ===== Breadth + benchmark ===== -->
<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
  {% if breadth %}
  <div class="panel">
    <h2>{{ t('Market breadth' if breadth.full else 'Large-cap breadth', '市场广度' if breadth.full else '大盘宽度') }}
      {{ help('Shows how many TSX names are participating. Thin breadth makes rallies fragile.' if breadth.full else 'Large-cap participation: 50/200-day trend, new highs/lows, and advance/decline.', '显示有多少 TSX 个股参与行情。广度变薄则反弹更脆弱。' if breadth.full else '大盘股参与度：50/200日趋势、新高/新低与涨跌线。') }}
    </h2>
    <p class="{{ breadth.tone }}" style="margin:2px 0 10px; font-size:13px; line-height:1.5">
      {{ t('Participation looks', '参与度看起来') }}
      <b>{% if breadth.state=='broad' %}{{ t('broad', '广泛') }}{% elif breadth.state=='thin' %}{{ t('thin', '稀薄') }}{% else %}{{ t('mixed', '参差') }}{% endif %}</b> —
      <b>{{ breadth.pct_above_50 }}%</b> {{ t('above their 50-day line', '在50日均线上方') }},
      <b>{{ breadth.pct_above_200 }}%</b> {{ t('above their 200-day', '在200日上方') }};
      {{ t('net new highs', '净新高') }} <b>{{ '%+d'|format(breadth.net_nh) }}</b>.
      <span class="muted">{% if breadth.state=='broad' %}{{ t('Broad participation confirms the move.', '广泛参与确认了走势。') }}{% elif breadth.state=='thin' %}{{ t('Few names hold trend — rallies are fragile.', '守住趋势的个股很少 — 反弹脆弱。') }}{% else %}{{ t('No clear breadth edge either way.', '广度上无明显方向优势。') }}{% endif %}</span>
    </p>
    <div class="row" style="gap:18px">
      <div class="dial"><span class="lbl">{{ t('above 50d', '50日上方') }}</span><b>{{ breadth.pct_above_50 }}%</b></div>
      <div class="dial"><span class="lbl">{{ t('above 200d', '200日上方') }}</span><b>{{ breadth.pct_above_200 }}%</b></div>
      <div class="dial"><span class="lbl">{{ t('adv / dec', '涨/跌') }}</span><b><span class="pos">{{ breadth.adv }}</span> / <span class="neg">{{ breadth.dec }}</span></b></div>
      <div class="dial"><span class="lbl">{{ t('NH / NL', '新高/新低') }}</span><b>{{ breadth.nh }} / {{ breadth.nl }}</b></div>
      <div class="dial"><span class="lbl">{{ t('A/D trend', '涨跌趋势') }}</span><b class="{{ 'pos' if breadth.ad_trend=='up' else 'neg' }}">{{ td(breadth.ad_trend) }}</b></div>
    </div>
    <p class="muted small" style="margin:8px 0 0">{{ t('20d change in % above 50d:', '50日上方占比 20日变化：') }} {{ '%+.1f'|format(breadth.pct50_chg20) }} · {{ breadth.n_members }} {{ t('names', '只成分') }} · {{ t('full S&P/TSX Composite', '完整标普/TSX 综合') if breadth.full else t('curated large-cap', '精选大盘') }}</p>
  </div>
  {% endif %}
  {% if benchmark %}
  <div class="panel">
    <h2>{{ t('S&P/TSX Composite', '标普/TSX 综合指数') }}</h2>
    <div class="row" style="gap:12px">
      <b style="font-size:18px">{{ '{:,.0f}'.format(benchmark.price) }}</b>
      <span class="{{ 'pos' if benchmark.chg>=0 else 'neg' }}">{{ '%+.2f'|format(benchmark.chg) }}%</span>
      <span class="lad {{ 'up' if benchmark.dc_day else 'flat' }}">{{ td(benchmark.label) if benchmark.label else td(benchmark.state) }}</span>
    </div>
    <div data-mtf='{{ benchmark.mtf_json }}' style="margin-top:8px"></div>
  </div>
  {% endif %}
</div>

