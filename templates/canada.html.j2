        <span class="qm{{ ' on' if Q == 'Q1' }}" style="--qc:var(--q1)"></span>
        <span class="qm{{ ' on' if Q == 'Q2' }}" style="--qc:var(--q2)"></span>
        <span class="qm{{ ' on' if Q == 'Q4' }}" style="--qc:var(--q4)"></span>
        <span class="qm{{ ' on' if Q == 'Q3' }}" style="--qc:var(--q3)"></span>
      </div>
    </div>
    <!-- CENTER — headline regime + plain-English standfirst -->
