      <div class="cax-kv"><span class="k">{{ t('Declining','下跌') }}</span><span class="v" style="color:var(--down)">{{ breadth.dec }}</span></div>
      <div class="cax-kv"><span class="k">{{ t('New highs','新高') }}</span><span class="v">{{ breadth.nh }}</span></div>
      <div class="cax-kv"><span class="k">{{ t('New lows','新低') }}</span><span class="v">{{ breadth.nl }}</span></div>
      {# ad_trend is a raw enum (up/down/flat) — render plain words, never the slug #}
      <div class="cax-kv"><span class="k">{{ t('A/D trend','涨跌趋势') }}</span><span class="v cax-stword {{ 'ok' if breadth.ad_trend == 'up' else ('bad' if breadth.ad_trend == 'down' else 'warn') }}">{{ t('Rising','上升') if breadth.ad_trend == 'up' else (t('Falling','下降') if breadth.ad_trend == 'down' else t('Flat','持平')) }}</span></div>
      <div class="cax-receipt">{{ breadth.n_members }} {{ t('names · full S&P/TSX Composite','只成分 · 完整标普/TSX 综合') if breadth.full else t('names · curated large-cap','只成分 · 精选大盘') }}</div>
      {% else %}
      <div style="font-size:12px;color:var(--muted)">{{ t('No breadth data.','暂无广度数据。') }}</div>
      {% endif %}
    </div>
  </div>
</div>

<!-- Sector Temperature dialog -->
<div class="cax-dlg" id="cax-dlg-sector">
  <div class="cax-dlg-backdrop" onclick="caxCloseDlg()"></div>
  <div class="cax-dlg-panel">
    <div class="cax-dlg-head">
      <span class="cax-dlg-title">{{ t('Sector Rotation','板块轮动') }}</span>
