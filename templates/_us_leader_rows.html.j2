{#- ── US market-leader rows (.topsetups.leaders-strip tbody) (docs/TIER_PREVIEW_PATTERN.md) ─────────────────────────
   Extracted VERBATIM from the `_ldrs[:15]` loop that used to live inline in
   dashboard.html.j2 (:16431-16443). ONE source for both consumers so the free
   shell and the paid payload can never drift apart:
     · the shell {% with %}-binds `rows` to the PREVIEW slice and
       {% include %}s this file at the loop's original location;
     · scripts/build_site.py._write_us_payload renders it directly via
       env.get_template("_us_leader_rows.html.j2").render(...) for the LOCKED remainder
       that ships in site/premiumdata/us_stocks.json.
   Carries NO tier logic — the split happens before this partial is called.

   Params:
     rows    — the us_standouts.leaders rows to render, already sliced.
     lth_any — bool: does ANY row in the FULL leaders slice carry a theme
               (dashboard.html.j2 `_lth.any`)? Board-level, so it is identical
               on both sides of the wall and the shell's <th> and the payload's
               <td> cannot disagree about the column count.
-#}
{#- Local copy of dashboard.html.j2's `t` display macro (:7). Extracted partials
   are self-contained by house convention (_us_board_cards.html.j2 header) — a
   macro from the includer's scope is NOT visible when build_site renders this
   file directly for the paid payload. -#}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% for r in rows %}
  {% set _les = r.get('entry_signal') %}
  {% set _lbz = _les.buy_zone if _les else none %}
  <tr class="ts-row" data-tkr="{{ r.ticker }}">
    <td class="c-stock"><a class="ts-tk-a" href="stock.html#{{ r.ticker }}"><span class="ts-tk">{{ r.ticker }}</span></a> <span class="ts-nm">{{ r.name }}</span></td>
    <td class="muted c-sector">{{ td(r.sector) }}</td>
    {% if lth_any %}<td class="c-theme">{% set _lt = r.get('theme') %}{% if _lt and _lt.get('name') %}<span class="pv-mk-i pv-mk-{{ 'warm' if r.get('theme_confirmed') else 'theme' }}"{% if r.get('theme_confirmed') %} data-tip-en="The theme itself only just turned up{% if _lt.get('bull_days') is not none %}{{ ' (today)' if _lt.bull_days == 0 else ' (' ~ _lt.bull_days ~ ' days in)' }}{% endif %} — the basket is early even though this name has been running. Context, not an entry." data-tip-zh="主题本身刚刚转强{% if _lt.get('bull_days') is not none %}{{ '（今日）' if _lt.bull_days == 0 else '（已进入第' ~ _lt.bull_days ~ '天）' }}{% endif %} — 尽管该股已在上涨，篮子仍处早期。仅供参考，非入场信号。"{% endif %}>{{ t(_lt.name, _lt.get('name_zh') or _lt.name) }}{% if r.get('theme_confirmed') %} ◦{% endif %}</span>{% else %}<span class="muted">—</span>{% endif %}</td>{% endif %}
    <td class="r c-edge {{ 'az-up' if r.alpha and r.alpha > 0 else 'az-dn' }}">{{ '%+.2f'|format(r.alpha) }}</td>
    <td class="r muted c-offhigh">{% if r.get('off_high') is not none %}{{ '%+.1f'|format(r.off_high) }}%{% else %}—{% endif %}</td>
    <td class="c-state">{% if r.label %}{{ td(r.label) }}{% else %}<span class="muted">—</span>{% endif %}</td>
    <td class="c-entry">{% if _lbz and _lbz.low is not none and _lbz.high is not none %}<span class="ent-good">{{ t('pullback zone', '回调买区') }} ${{ '%.2f'|format(_lbz.low) }}–${{ '%.2f'|format(_lbz.high) }}</span>{% else %}<span class="ent-warn">{{ t('wait for pullback', '等待回调') }}</span>{% endif %}{% if r.get('ext_z') is not none and r.ext_z > 2.0 %} <span class="ent-warn" data-tip-en="Price is unusually far above its trend — chasing here is risky." data-tip-zh="价格已明显高于趋势，追高风险较大。">{{ t('extended', '过热') }}</span>{% endif %}</td>
  </tr>
{% endfor %}
