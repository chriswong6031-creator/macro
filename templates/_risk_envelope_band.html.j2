{# ═══════════════════════════════════════════════════════════════════════════════
   GREY DEER MARKET READS — compact L1 rail + L2/L3 Risk Detail projection

   Consumes `risk_envelope` (site/riskdata/risk_envelope.json). Renders nothing
   when the artifact is absent.

   Presentation law (Sol 2026-08-30): the engine stays sophisticated; the front
   page compresses it. Glance = state. Click = explanation. Expand = receipts.

   Semantic freeze is UNCHANGED: separate market reads, no averaging, null !=
   NONE, coherence compares market reads only, policy is orthogonal, live-
   provisional overlay identity stays on these hooks:
     #risk-envelope-band  data-bundle-id  data-settled-session
     #gde-live-chip  #gde-pending-chip  #gde-live-receipt
   ═══════════════════════════════════════════════════════════════════════════ #}

{# ── one derivation of glance vocabulary. Both projections call these. ── #}
{% macro gde_hz_en(stage) -%}
{{ {'NONE': 'No breakage', 'FRAGILE': 'Fragile', 'TRANSMITTING': 'Spreading', 'BREAKDOWN': 'Breakdown'}.get(stage, 'Unclear') }}
{%- endmacro %}
{% macro gde_hz_zh(stage) -%}
{{ {'NONE': '未见断裂', 'FRAGILE': '脆弱', 'TRANSMITTING': '扩散', 'BREAKDOWN': '断裂'}.get(stage, '不明') }}
{%- endmacro %}
{% macro gde_trend_arr(verdict) -%}
{{ {'RISK_ON': '▲', 'RISK_OFF': '▼'}.get(verdict, '') }}
{%- endmacro %}

{# Semantic inks live as CSS classes gde-ms-* / gde-hz-* (design-system: no inline --custom literals). #}

{# ── L1 · compact Market Reads rail, integrated into the regime hero ── #}
{% macro gde_rail(re) %}
{%- if re and re.get('schema') == 'mastermind.risk_envelope/v1' -%}
{%- set _ms = re.get('measured_state') or {} -%}
{%- set _hz = re.get('hazard_summary') or {} -%}
{%- set _co = re.get('coherence') or {} -%}
{%- set _ps = re.get('policy_summary') or {} -%}
{%- set _policy_n = _ps.get('policy_count') -%}
{%- set _policy_known = _policy_n is integer and _policy_n >= 0 -%}
{%- set _prov = (re.get('provenance') or {}).get('sources') or [] -%}
{%- set _stage = _hz.get('stage') -%}
{%- set _split = _co.get('state') in ('MIXED', 'CONTRADICTORY') -%}
{%- set ns = namespace(lead=none, ms=none) -%}
{%- for s in _prov -%}
  {%- if s.role == 'hazard_evidence' and s.hazard_stage == _stage and ns.lead is none -%}{% set ns.lead = s %}{%- endif -%}
  {%- if s.role == 'measured_state' and ns.ms is none -%}{% set ns.ms = s %}{%- endif -%}
{%- endfor -%}
{%- set _ms_detail = (ns.ms.detail if ns.ms else {}) or {} -%}
{%- set _ms_en = _ms_detail.get('state_label_en') or {'RISK_ON': 'Risk-on', 'RISK_OFF': 'Risk-off', 'MIXED': 'Mixed'}.get(_ms.get('verdict'), 'Unavailable') -%}
{%- set _ms_zh = _ms_detail.get('state_label_zh') or {'RISK_ON': '风险偏好', 'RISK_OFF': '风险规避', 'MIXED': '分歧'}.get(_ms.get('verdict'), '不可用') -%}
{%- set _unread = _hz.get('unreadable_sources') or [] -%}
{%- set _unmapped = _hz.get('unmapped_required_sources') or [] -%}
{%- set _caveat_n = (_unread | length) + (_unmapped | length) -%}
{%- set _show_caveat = _stage is none and _caveat_n > 0 -%}
<button type="button"
        class="gde-rail{% if _split %} is-split{% endif %}"
        id="risk-envelope-band"
        data-bundle-id="{{ re.get('bundle_id') or '' }}"
        data-settled-session="{{ re.get('source_session') or '' }}"
        aria-haspopup="dialog"
        aria-controls="dlg-risk"
        onclick="mx5OpenDlg('dlg-risk')">
  <span class="gde-rail-kicker">
    <span class="l-en">Risk context</span><span class="l-zh">风险提示</span>
  </span>

  <span class="gde-rail-reads{% if _split %} is-split{% endif %} gde-ms-{{ _ms.get('verdict') or 'null' }} gde-hz-{{ _stage or 'null' }}" id="gde-rail-reads">
    <span class="gde-seg gde-seg-trend">
      <span class="gde-k"><span class="l-en">Trend</span><span class="l-zh">趋势</span></span>
      <span class="gde-v" style="color: var(--gde-ms)">
        {%- if _ms.get('usable') and _ms.get('verdict') -%}
          <span class="l-en">{{ _ms_en }}</span><span class="l-zh">{{ _ms_zh }}</span>
          {%- if gde_trend_arr(_ms.get('verdict')) -%}
          <span class="gde-arr" aria-hidden="true">{{ gde_trend_arr(_ms.get('verdict')) }}</span>
          {%- endif -%}
        {%- else -%}
          <span class="l-en">Unavailable</span><span class="l-zh">不可用</span>
        {%- endif -%}
      </span>
    </span>
    <span class="gde-seg gde-seg-break">
      <span class="gde-k"><span class="l-en">Breakage</span><span class="l-zh">断裂</span></span>
      <span class="gde-v" style="color: var(--gde-hz)">
        <span class="l-en">{{ gde_hz_en(_stage) }}</span><span class="l-zh">{{ gde_hz_zh(_stage) }}</span>
      </span>
      {%- if _show_caveat -%}
      <span class="gde-caveat">
        <span class="l-en">{{ _caveat_n }} source{{ 's' if _caveat_n != 1 else '' }} unavailable</span>
        <span class="l-zh">{{ _caveat_n }} 个来源不可用</span>
      </span>
      {%- endif -%}
      <span class="gde-pending" id="gde-pending-chip" hidden><span class="l-en"></span><span class="l-zh"></span></span>
    </span>
  </span>

  <span class="gde-rail-rule" aria-hidden="true"></span>

  <span class="gde-rail-meta">
    {% if _policy_known and _policy_n > 0 %}
    <span class="gde-seg gde-seg-policy">
      <span class="gde-k"><span class="l-en">Policy</span><span class="l-zh">政策</span></span>
      <span class="gde-v gde-v-quiet tnum">{{ _policy_n }} <span class="l-en">active</span><span class="l-zh">项生效</span></span>
    </span>
    {% endif %}
    <span class="gde-stamp gde-stamp-live" id="gde-live-chip" hidden>
      <i class="dtp-dot" aria-hidden="true"></i>
      <span class="l-en">Live · provisional</span><span class="l-zh">实时 · 临时</span>
      <span class="gde-live-time"></span>
    </span>
    <span class="gde-stamp gde-stamp-settled tnum"
          data-tip-en="Settled session — the close these reads were taken from. Source clocks live in Risk Detail."
          data-tip-zh="已结算交易日 — 本次判读所依据的收盘。各来源时钟见风险详情。">
      <span class="l-en">Settled</span><span class="l-zh">已结算</span> {{ re.get('source_session') or '—' }}
    </span>
    <svg class="gde-chevron" width="8" height="12" viewBox="0 0 8 12" aria-hidden="true" focusable="false">
      <path d="M1.5 1.5l5 4.5-5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
</button>
{%- endif -%}
{% endmacro %}

{# ── L2/L3 · Market Reads inside the existing #dlg-risk ── #}
{% macro gde_detail(re) %}
{%- if re and re.get('schema') == 'mastermind.risk_envelope/v1' -%}
{%- set _ms = re.get('measured_state') or {} -%}
{%- set _hz = re.get('hazard_summary') or {} -%}
{%- set _co = re.get('coherence') or {} -%}
{%- set _ps = re.get('policy_summary') or {} -%}
{%- set _policy_n = _ps.get('policy_count') -%}
{%- set _policy_known = _policy_n is integer and _policy_n >= 0 -%}
{%- set _prov = (re.get('provenance') or {}).get('sources') or [] -%}
{%- set _stage = _hz.get('stage') -%}
{%- set _split = _co.get('state') in ('MIXED', 'CONTRADICTORY') -%}
{%- set ns = namespace(lead=none, ms=none) -%}
{%- for s in _prov -%}
  {%- if s.role == 'hazard_evidence' and s.hazard_stage == _stage and ns.lead is none -%}{% set ns.lead = s %}{%- endif -%}
  {%- if s.role == 'measured_state' and ns.ms is none -%}{% set ns.ms = s %}{%- endif -%}
{%- endfor -%}
{%- set _ms_detail = (ns.ms.detail if ns.ms else {}) or {} -%}
{%- set _ms_en = _ms_detail.get('state_label_en') or {'RISK_ON': 'Risk-on', 'RISK_OFF': 'Risk-off', 'MIXED': 'Mixed'}.get(_ms.get('verdict'), 'Unavailable') -%}
{%- set _ms_zh = _ms_detail.get('state_label_zh') or {'RISK_ON': '风险偏好', 'RISK_OFF': '风险规避', 'MIXED': '分歧'}.get(_ms.get('verdict'), '不可用') -%}
{%- set _unread = _hz.get('unreadable_sources') or [] -%}
{%- set _unmapped = _hz.get('unmapped_required_sources') or [] -%}
{%- set _caveat_n = (_unread | length) + (_unmapped | length) -%}
{%- set _names_en = {} -%}
{%- set _names_zh = {} -%}
{%- for s in _prov -%}
  {%- if _names_en.update({s.source_id: (s.label_en or s.source_id)}) -%}{%- endif -%}
  {%- if _names_zh.update({s.source_id: (s.label_zh or s.label_en or s.source_id)}) -%}{%- endif -%}
{%- endfor -%}
<section class="gde-detail{% if _split %} is-split{% endif %}" id="gde-detail">
  <h3 class="gde-detail-h">
    <span class="l-en">Market reads</span><span class="l-zh">市场判读</span>
  </h3>

  <div class="gde-detail-reads">
    <div class="gde-dblock gde-ms-{{ _ms.get('verdict') or 'null' }}">
      <span class="gde-k"><span class="l-en">Trend</span><span class="l-zh">趋势</span></span>
      <p class="gde-d-a">
        {%- if _ms.get('usable') and _ms.get('verdict') -%}
          <span class="l-en">{{ _ms_en }}</span><span class="l-zh">{{ _ms_zh }}</span>
          {%- if gde_trend_arr(_ms.get('verdict')) -%}
          <span class="gde-arr" aria-hidden="true">{{ gde_trend_arr(_ms.get('verdict')) }}</span>
          {%- endif -%}
        {%- else -%}
          <span class="l-en">Unavailable</span><span class="l-zh">不可用</span>
        {%- endif -%}
      </p>
      <p class="gde-d-c">
        {%- if _ms.get('usable') and _ms.get('verdict') -%}
          <span class="l-en">Slow measured trend, carried unchanged{% if _ms.get('score') is not none %} — source score {{ _ms.get('score') }}{% endif %}.</span>
          <span class="l-zh">慢速趋势判读，原样保留{% if _ms.get('score') is not none %} — 来源评分 {{ _ms.get('score') }}{% endif %}。</span>
        {%- else -%}
          <span class="l-en">The trend source didn't settle for this session, so we're not quoting a stale one.</span>
          <span class="l-zh">趋势来源本交易日未结算，因此不引用过期读数。</span>
        {%- endif -%}
      </p>
      <span class="gde-d-asof tnum"><span class="l-en">As of</span><span class="l-zh">截至</span> {{ _ms.get('as_of') or '—' }}</span>
    </div>

    <div class="gde-dblock gde-hz-{{ _stage or 'null' }}">
      <span class="gde-k"><span class="l-en">Breakage</span><span class="l-zh">断裂</span></span>
      <p class="gde-d-a">
        <span class="l-en">{{ gde_hz_en(_stage) }}</span><span class="l-zh">{{ gde_hz_zh(_stage) }}</span>
      </p>
      <p class="gde-d-c">
        {%- if _stage is none -%}
          <span class="l-en">A source we need didn't settle today, so we're not calling this either way.{% if _caveat_n %} {{ _caveat_n }} source{{ 's' if _caveat_n != 1 else '' }} unavailable.{% endif %}</span>
          <span class="l-zh">今日缺少必需来源的结算数据，因此不作任何判定。{% if _caveat_n %}{{ _caveat_n }} 个来源不可用。{% endif %}</span>
        {%- elif _stage == 'NONE' -%}
          <span class="l-en">We looked at every source we need and none of them shows damage.</span>
          <span class="l-zh">已核对全部必需来源，均未见损伤。</span>
        {%- else -%}
          {%- set _onset = (ns.lead.detail.get('state_since') if ns.lead and ns.lead.detail else none) -%}
          <span class="l-en">{{ (ns.lead.label_en if ns.lead else 'A tracked group') }} shows damage{% if _ms.get('usable') and _ms.get('verdict') == 'RISK_ON' %} while the broad trend remains positive{% endif %}{% if _onset %} — its own read has said so since {{ _onset }}{% endif %}.</span>
          <span class="l-zh">{{ (ns.lead.label_zh if ns.lead else '受追踪的一组标的') }}显示损伤{% if _ms.get('usable') and _ms.get('verdict') == 'RISK_ON' %}，但整体趋势仍保持积极{% endif %}{% if _onset %}——该来源自 {{ _onset }} 起即如此判读{% endif %}。</span>
        {%- endif -%}
      </p>
      <span class="gde-d-asof tnum"><span class="l-en">As of</span><span class="l-zh">截至</span> {{ (ns.lead.as_of if ns.lead else none) or re.get('source_session') or '—' }}</span>
    </div>
  </div>

  <div class="gde-detail-policy">
    <span class="gde-k"><span class="l-en">Policy</span><span class="l-zh">政策</span></span>
    {%- if not _policy_known -%}
    <span class="gde-policy-state"><span class="l-en">Policy status unavailable</span><span class="l-zh">政策状态不可用</span></span>
    {%- elif _policy_n == 0 -%}
    <span class="gde-policy-state"><span class="l-en">No Grey Deer policy active</span><span class="l-zh">未启用任何 Grey Deer 政策</span></span>
    {%- endif -%}
    {% if _policy_known %}<span class="gde-policy-count tnum">{{ _policy_n }} <span class="l-en">active</span><span class="l-zh">项生效</span></span>{% endif %}
  </div>

  <details class="gde-disc">
    <summary>
      <span class="l-en">Evidence &amp; source health — {{ _prov | length }} sources{% if _co.get('contradiction_count') %}, {{ _co.get('contradiction_count') }} disagreement{{ 's' if _co.get('contradiction_count') != 1 else '' }}{% endif %}</span>
      <span class="l-zh">证据与来源健康 — {{ _prov | length }} 个来源{% if _co.get('contradiction_count') %}，{{ _co.get('contradiction_count') }} 处分歧{% endif %}</span>
    </summary>
    <div class="gde-disc-body">
      <div class="gde-tblwrap">
        <table class="gde-tbl">
          <thead><tr>
            <th><span class="l-en">Source</span><span class="l-zh">来源</span></th>
            <th><span class="l-en">Its own read</span><span class="l-zh">自身读数</span></th>
            <th><span class="l-en">As of</span><span class="l-zh">数据日期</span></th>
            <th><span class="l-en">Freshness</span><span class="l-zh">新鲜度</span></th>
          </tr></thead>
          <tbody>
          {% for s in _prov %}
            <tr>
              <td class="l">{% if s.label_en %}<span class="l-en">{{ s.label_en }}</span><span class="l-zh">{{ s.label_zh or s.label_en }}</span>{% else %}<span class="tnum">{{ s.source_id }}</span>{% endif %}</td>
              <td class="tnum">{{ s.state if s.state is not none else '—' }}{% if s.score is not none %} · {{ s.score }}{% endif %}</td>
              <td class="tnum">{{ s.as_of or '—' }}</td>
              <td>
                {% if s.coverage == 'FRESH' %}<span class="l-en">This session</span><span class="l-zh">本交易日</span>
                {% elif s.coverage == 'STALE' %}<span class="gde-warn"><span class="l-en">Older than this session</span><span class="l-zh">早于本交易日</span></span>
                {% else %}<span class="gde-warn"><span class="l-en">Did not publish</span><span class="l-zh">未发布</span></span>{% endif %}
                {%- if s.required %} <span class="gde-req"><span class="l-en">required</span><span class="l-zh">必需</span></span>{% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      {% if _co.get('contradictions') %}
      <p class="gde-disc-h"><span class="l-en">Where they disagree</span><span class="l-zh">分歧所在</span></p>
      <ul class="gde-conflicts">
        {% for c in _co.get('contradictions') %}
        <li>
          <span class="l-en">{{ _names_en.get(c.left, c.left) }} reads <b>{{ c.left_state }}</b> while {{ _names_en.get(c.right, c.right) }} reads <b>{{ c.right_state }}</b>.</span>
          <span class="l-zh">{{ _names_zh.get(c.left, c.left) }} 读为 <b>{{ c.left_state }}</b>，而 {{ _names_zh.get(c.right, c.right) }} 读为 <b>{{ c.right_state }}</b>。</span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}

      <p class="gde-receipt tnum">
        {{ re.get('definition_id') }} · bundle {{ re.get('bundle_id') }} ·
        coverage {{ re.get('data_state') }} ·
        coherence {{ _co.get('state') }} (scope {{ _co.get('scope') }}) ·
        stage {{ _stage if _stage is not none else 'null' }} ({{ _hz.get('stage_reason') }}) ·
        stage_since null ({{ _hz.get('stage_since_basis') }})
        {%- if _hz.get('capped_sources') %} · capped at source competence: {{ _hz.get('capped_sources') | join(', ') }}{% endif %} ·
        engine/risk_envelope.py
      </p>
      <div class="gde-receipt gde-receipt-live" id="gde-live-receipt" hidden></div>
    </div>
  </details>
</section>
{%- endif -%}
{% endmacro %}
