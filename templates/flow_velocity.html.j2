  <div class="h1">🌊 {{ t('Capital Flow Velocity','资金流速') }}</div>
  <div class="intro">{{ t('Where China’s big money is rotating — A-share sectors ranked by 主力 (large-order) flow velocity, drilled into the individual names driving each, with the question at every name: <b>does the institution agree?</b> Cross-border Stock-Connect flows sit below, as context.','中国大资金在向哪里轮动——A股板块按主力（大单）资金流速排序，下钻至驱动它们的个股，并在每只个股追问：<b>机构是否认同？</b> 跨境沪深港通资金作为背景置于下方。') }}</div>
  <div class="note">{{ t('Display-only positioning lens — flow is <b>never</b> scored into an allocation signal. <b>Velocity</b> = standardized net-flow rate (cumulative-flow drift ÷ its own vol); <b>acceleration</b> = its 2nd derivative. <b>Confluence</b> is a binary agree/diverge read where 主力 flow and Dragon-Tiger institutional seats land on the same name — context, not a manufactured score.','仅供定位参考——资金流向<b>从不</b>计入配置信号。<b>流速</b>＝标准化净流入率（累计流向漂移 ÷ 自身波动）；<b>加速度</b>＝其二阶导。<b>共振</b>＝当主力资金与龙虎榜机构席位落在同一只个股上的二元一致/背离判断——仅为背景，非人造分值。') }}</div>
  <div class="legend">
    <span class="lg"><span class="vbar vbar-sm"><span class="vbar-track"><span class="vbar-fill pos" style="width:36%"></span></span></span> <b>{{ t('inflow','流入') }}</b></span>
    <span class="lg"><span class="vbar vbar-sm"><span class="vbar-track"><span class="vbar-fill neg" style="width:36%"></span></span></span> <b>{{ t('outflow','流出') }}</b> <span style="color:var(--faint)">{{ t('· ±3σ fills the half-track','· ±3σ 填满半轨') }}</span></span>
    <span class="lg"><i class="cdot conf-buy"></i><i class="cdot conf-sell"></i> <b>{{ t('confluence','共振') }}</b> <span style="color:var(--faint)">{{ t('flow + institutions agree','资金与机构一致') }}</span></span>
    <span class="lg"><i class="cdot conf-diverge"></i> <b>{{ t('divergence','背离') }}</b> <span style="color:var(--faint)">{{ t('they disagree','二者相左') }}</span></span>
  </div>

  {# ============================ FLOW MAP (PRIMARY) ============================ #}
  {% if snap.ashare_sectors or snap.hk_names %}
  {% set sbt = snap.seats_by_ticker or {} %}
  <div class="sec-h"><h2>🧭 {{ t('Flow Map','资金流向图') }}</h2>
    <span class="sub">{{ t('sector → member names → institutional confluence · weekly · as of','板块 → 成分个股 → 机构共振 · 周度 · 截至') }} {{ snap.as_of }}</span>
    <span style="margin-left:auto" class="mkt-toggle" role="group" aria-label="Market">
      <button data-mkt="a" aria-pressed="true">{{ t('A-Share','沪深') }}</button>
      <button data-mkt="hk" aria-pressed="false">{{ t('HK Southbound','南向') }}</button>
    </span>
  </div>

  {# ---- A-SHARE: sector lanes → member drill-down ---- #}
  {% if snap.ashare_sectors and snap.ashare_sectors.rows %}
  {% set s = snap.ashare_sectors %}
  <div class="market-a">
    <span class="market-tag">{{ t('A-Share 沪深','A股 沪深') }}</span>
    <div class="panel">
    <div class="tbl-wrap">
      <table class="board" id="sectortbl">
        <thead><tr>
          <th data-c="0">{{ t('Sector','板块') }}</th>
          <th class="nos">{{ t('Category','类别') }}</th>
          <th data-c="2">{{ t('Members','成分') }}</th>
          <th data-c="3">{{ t('4wk net','4周净占比') }}</th>
          <th data-c="4">{{ t('Velocity','流速') }}</th>
          <th data-c="5">{{ t('Accel','加速度') }}</th>
          <th class="nos">{{ t('State','状态') }}</th>
          <th class="nos">{{ t('Flow trend','流向趋势') }}</th>
        </tr></thead>
        <tbody>
        {# universe-wide leaderboard — pinned, default-expanded pseudo-sector (the global
           "biggest movers across all names" view, alongside the attributable sector drill-downs) #}
        {% if snap.ashare_names %}
        {% set leaders = (snap.ashare_names.inflow[:10] + snap.ashare_names.outflow[:10])|sort(attribute='vel', reverse=true) %}
        <tr class="sector-row allnames open" data-sector="__all__" aria-expanded="true">
          <td class="snm"><span class="chev">▸</span> 🏆 {{ t('All A-share names','全市场A股') }}</td>
          <td><span class="cat">{{ t('universe','全域') }}</span></td>
          <td>{{ snap.ashare_names.n }}</td>
          <td></td><td></td><td></td>
          <td style="text-align:left"><span class="lead-tag">{{ t('top inflow &amp; outflow','领涨与领跌') }}</span></td>
          <td></td>
        </tr>
        {% for m in leaders %}{{ memberrow(m, sbt, '__all__', loop.index, show=True) }}{% endfor %}
        {% endif %}
        {% for r in s.rows %}
          {% set has_members = r.members and r.members|length %}
          <tr class="sector-row{{ ' nodrill' if not has_members }}" data-sector="{{ r.id }}" aria-expanded="false">
            <td class="snm"><span class="chev">{{ '▸' if has_members else '·' }}</span> {{ t(r.name, r.name_zh) }}</td>
            <td><span class="cat">{{ td(r.category) if r.category else '·' }}</span></td>
            <td>{{ r.n_members }}{% if r.inst_attention %}<span class="attn" title="members with institutional-seat activity">{{ r.inst_attention }} {{ t('inst','机构') }}</span>{% endif %}</td>
            <td>{{ rate(r.rate_4wk) }}</td>
            <td style="text-align:center">{{ vbar(r.vel, 'md', loop.index) }}</td>
            <td>{{ accel(r.accel) }}</td>
            <td style="text-align:left">{{ vstate(r.state, r.state_zh, r.vel) }}</td>
            <td>{{ spark(r.spark) }}</td>
          </tr>
          {% if has_members %}
          {# sector-mean anchor row so members read as deviations around it #}
          <tr class="mrow meanrow" data-sector="{{ r.id }}">
            <td class="mname">{{ t('sector mean','板块均值') }}</td>
            <td></td><td></td><td>{{ rate(r.rate_4wk) }}</td>
            <td style="text-align:center">{{ vbar(r.vel, 'sm') }}</td>
            <td></td><td></td><td></td>
          </tr>
          {% for m in r.members %}{{ memberrow(m, sbt, r.id, loop.index) }}{% endfor %}
          {% endif %}
        {% endfor %}
        </tbody>
      </table>
    </div>
    </div>
    <div class="legend" style="margin-top:10px">{{ t(s.note, s.note_zh) }}</div>
  </div>
  {% endif %}

  {# ---- HK: same board grammar, flat southbound per-name rows ---- #}
  {% if snap.hk_names %}
  {% set h = snap.hk_names %}
  <div class="market-hk">
    <span class="market-tag">{{ t('HK Southbound 南向','港股南向') }}</span>
    <div class="panel">
      <div class="panel-h">🇭🇰 {{ t('Mainland southbound per-name','内地南向个股') }}
        {% if not h.vel_ready %}<span class="dep">· {{ t('velocity unlocks at depth 8','流速于深度8解锁') }} ({{ h.depth }}/8) — {{ t('5d accumulation for now','当前为5日累积') }}</span>{% endif %}</div>
      <div class="tbl-wrap">
        <table class="board" id="hktbl">
          <thead><tr>
            <th data-c="0">{{ t('Name','名称') }}</th>
            <th class="nos">{{ t('Flow','流向') }}</th>
            <th data-c="2">{{ t('5d hold Δ','5日持仓Δ') }}</th>
            <th data-c="3">{{ t('Own %','持股%') }}</th>
            <th data-c="4">{{ t('Hold','持仓') }}</th>
          </tr></thead>
          <tbody>
          {% for r in (h.buying or []) %}
          <tr><td class="snm"><a href="hk_lookup.html#{{ r.ticker }}">{{ r.name or r.ticker }}<span class="tk">{{ r.ticker }}</span></a></td>
            <td style="text-align:left">{{ vstate('accumulating','加仓', r.chg5_pct) }}</td>
            <td>{{ rate(r.chg5_pct) }}</td>
            <td><span class="ownbar"><i style="width:{{ [ (r.own_pct or 0)/30*100, 100]|min |round }}%"></i></span> {{ '%.1f'|format(r.own_pct) if r.own_pct is not none else '·' }}</td>
            <td>HK${{ r.hold_b }}B</td></tr>
          {% endfor %}
          {% for r in (h.selling or []) %}
          <tr><td class="snm"><a href="hk_lookup.html#{{ r.ticker }}">{{ r.name or r.ticker }}<span class="tk">{{ r.ticker }}</span></a></td>
            <td style="text-align:left">{{ vstate('distributing','减仓', r.chg5_pct) }}</td>
            <td>{{ rate(r.chg5_pct) }}</td>
            <td><span class="ownbar"><i style="width:{{ [ (r.own_pct or 0)/30*100, 100]|min |round }}%"></i></span> {{ '%.1f'|format(r.own_pct) if r.own_pct is not none else '·' }}</td>
            <td>HK${{ r.hold_b }}B</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    <div class="legend" style="margin-top:10px">{{ t('Southbound holdings are mainland money via Connect — a flow confirmer, not a standalone signal. '+(h.note or ''),'南向持仓为内地经互联互通的资金——资金确认项，非独立信号。') }}</div>
  </div>
  {% endif %}
  {% endif %}

  {# ============== CROSS-BORDER CONTEXT — STOCK-CONNECT CHANNELS (secondary) ============== #}
  {% if snap.aggregate %}
  <div class="sec-h"><h2>🛰️ {{ t('Stock-Connect Channels','沪深港通通道') }}</h2>
    <span class="sub">{{ t('cross-border context · mainland ↔ HK aggregate flow · daily 1w / 1m / 3m velocity','跨境背景 · 内地 ↔ 香港整体资金 · 日度 1周 / 1月 / 3月流速') }}</span></div>
  <div class="vgrid">
    {% for c in snap.aggregate %}
    <div class="vcard {{ 'frozen' if not c.live }}">
      <div class="vcard-top">
        <h3>{{ t(c.label, c.label_zh) }}</h3>
        {% if c.live %}{{ vstate(c.state, c.state_zh, c.vel_primary) }}{% else %}<span class="vstate mid">{{ t('frozen','已停更') }}</span>{% endif %}
        <span class="asof">{{ t('as of','截至') }} {{ c.as_of }}</span>
      </div>
      {% if c.live %}
      <div class="vrow">
        {% for lab in ['1w','1m','3m'] %}
        <div class="vchip"><div class="k">{{ lab }}</div>{{ vbar(c.vel[lab], 'lg', loop.index) }}</div>
        {% endfor %}
      </div>
      <div class="vmeta">
        <span>{{ t('~1m net','近1月净额') }} <b class="chg {{ 'pos' if (c.flow_1m_b or 0)>=0 else 'neg' }}">{{ '%+.1f'|format(c.flow_1m_b) }} {{ t('¥B','十亿') }}</b></span>
        <span>{{ t('up-days (20)','上涨日(20)') }} <b>{{ c.pos_days_20 }}/20</b></span>
        <span class="sp">{{ spark(c.spark) }}</span>
      </div>
      {% else %}
      <div class="vmeta"><span>{{ t('20d-cum net, through the freeze','20日累计净额，至停更') }}</span><span class="sp">{{ spark(c.spark, frozen=True) }}</span></div>
      <div class="frozen-banner">⚠ {{ t(c.note, c.note_zh) }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="foot">
    <b>{{ t('Sources','数据来源') }}:</b>
    {{ t('Stock-Connect channels — Eastmoney RPT_MUTUAL_DEAL_HISTORY (southbound live; northbound aggregate net discontinued 2024-08-16). A-share name/sector flow — Tushare moneyflow_dc 主力 weekly grid. Institutional seats — Eastmoney 龙虎榜 机构专用. HK southbound — Eastmoney RPT_MUTUAL_STOCK_HOLDRANKS.','沪深港通——东方财富 RPT_MUTUAL_DEAL_HISTORY（南向实时；北向整体净额于2024-08-16停更）。A股个股/板块资金——Tushare moneyflow_dc 主力周度网格。机构席位——东方财富龙虎榜机构专用。南向——东方财富 RPT_MUTUAL_STOCK_HOLDRANKS。') }}<br>
    <b>{{ t('Method','方法') }}:</b>
    {{ t('Velocity = slope_z of cumulative net-flow (drift ÷ its own volatility); acceleration = the trailing slope of that velocity. A sector’s velocity is the equal-weight mean of its members’, so members fan out as deviations around the sector bar. Confluence is a render-time agree/diverge class joining 主力 velocity sign to the institutional-seat direction on the same ticker — nothing numeric is manufactured. Causal, point-in-time, descriptive context — not investment advice.','流速＝累计净流向的 slope_z（漂移 ÷ 自身波动）；加速度＝该流速的滚动斜率。板块流速＝成分股等权均值，故成分股以围绕板块条的偏离呈现。共振为渲染期一致/背离类别，将主力流速方向与同一代码的机构席位方向相连——不制造任何分值。因果、时点对齐、描述性背景，非投资建议。') }}
    · {{ t('Built','构建于') }} {{ built }}
  </div>
</div>
<script>
(function(){
  var H=document.documentElement;
  // ---- accordion: sectors collapsed by default (html.js), click to drill ----
  document.querySelectorAll('tr.sector-row').forEach(function(row){
    if(row.classList.contains('nodrill')) return;
    row.addEventListener('click',function(e){
      if(e.target.closest('a')) return;
      var open=row.classList.toggle('open');
      row.setAttribute('aria-expanded',open?'true':'false');
      var id=row.getAttribute('data-sector');
      document.querySelectorAll('tr.mrow[data-sector="'+(window.CSS&&CSS.escape?CSS.escape(id):id)+'"]').forEach(function(m){
        m.classList.toggle('show',open);
      });
    });
  });
  // ---- market toggle: one attribute swaps the whole board ----
  var btns=document.querySelectorAll('.mkt-toggle button');
  function setMkt(m){
    H.setAttribute('data-market',m);
    try{sessionStorage.setItem('mkt',m);}catch(e){}
    btns.forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-mkt')===m?'true':'false');});
  }
  btns.forEach(function(b){b.addEventListener('click',function(){setMkt(b.getAttribute('data-mkt'));});});
  setMkt(H.getAttribute('data-market')||'a');
  // ---- column sort (keeps open sectors' members attached to their parent) ----
  document.querySelectorAll('table.board').forEach(function(tbl){
    tbl.querySelectorAll('th[data-c]').forEach(function(th){
      th.addEventListener('click',function(){
        var ci=+th.getAttribute('data-c'), body=tbl.tBodies[0], asc=th._asc=!th._asc;
        var groups=[], cur=null;
        Array.from(body.rows).forEach(function(rw){
          if(rw.classList.contains('mrow')){ if(cur) cur.kids.push(rw); }
          else { cur={head:rw,kids:[]}; groups.push(cur); }
        });
        var pin=groups.filter(function(g){return g.head.getAttribute('data-sector')==='__all__';});
        var rest=groups.filter(function(g){return g.head.getAttribute('data-sector')!=='__all__';});
        rest.sort(function(a,b){
          var x=parseFloat((a.head.cells[ci].textContent||'').replace(/[^0-9.\-]/g,'')),
              y=parseFloat((b.head.cells[ci].textContent||'').replace(/[^0-9.\-]/g,''));
          if(isNaN(x)&&isNaN(y))return 0; if(isNaN(x))return 1; if(isNaN(y))return -1;
          return asc?x-y:y-x;
        });
        pin.concat(rest).forEach(function(g){ body.appendChild(g.head); g.kids.forEach(function(k){body.appendChild(k);}); });
      });
    });
  });
})();
</script>
<script src="theme.js"></script>
</body></html>
