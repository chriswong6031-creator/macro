      <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
      <a class="ai-brief-link" href="china.html">🇨🇳 {{ t('China','中国') }}</a>
