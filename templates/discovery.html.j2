{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro abar(a) -%}
{% set w = ((a if a else 0) / 3.0 * 50) %}
<span class="abar">{% if (a or 0) >= 0 %}<i style="left:50%;width:{{ [w,50]|min|round(1) }}%;background:var(--up)"></i>{% else %}<i style="right:50%;width:{{ [-w,50]|min|round(1) }}%;background:var(--down)"></i>{% endif %}<i class="mid"></i></span>
{%- endmacro %}
{% macro echip(tag) -%}
{% set m = entry_meta.get(tag) %}{% if m %}<span class="echip {{ m[2] }}">{{ t(m[0], m[1]) }}</span>{% endif %}
{%- endmacro %}
{% macro mom(v) -%}
<td class="r {{ 'pos' if (v or 0) >= 0 else 'neg' }}">{{ ('%+.0f%%'|format(v)) if v is not none else '—' }}</td>
{%- endmacro %}
{% macro grow(r, i) -%}
<tr>
  <td class="rk">{{ i }}</td>
  <td><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted sm">{{ r.name[:20] }}</span></td>
  <td class="muted sm">{{ td(r.sector) }}</td>
  <td><div class="scorecell">{{ abar(r.alpha) }}<span class="znum band-{{ r.band }}">{{ '%+.2f'|format(r.alpha) }}</span></div></td>
  <td>{{ echip(r.entry) }}</td>
  {{ mom(r.total_mom) }}
  <td class="r muted sm">{{ ('#%d/%d'|format(r.sector_rank, r.sector_n)) if r.sector_rank else '—' }}</td>
  <td class="r">{% if r.rs is not none %}<b>{{ r.rs|round|int }}</b>{% if r.rs3m is not none %} <span class="muted sm">{{ r.rs3m|round|int }}/{{ r.rs6m|round|int }}/{{ r.rs12m|round|int }}</span>{% endif %}{% else %}—{% endif %}</td>
  <td class="r muted sm">{{ ('$%.2f'|format(r.price)) if r.price is not none else '—' }}</td>
</tr>
{%- endmacro %}
{% macro srow(r) -%}
<tr>
  <td class="rk">{{ r.sector_rank }}</td>
  <td><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted sm">{{ r.name[:22] }}</span></td>
  <td><div class="scorecell">{{ abar(r.alpha) }}<span class="znum band-{{ r.band }}">{{ '%+.2f'|format(r.alpha) }}</span></div></td>
  <td>{{ echip(r.entry) }}</td>
  {{ mom(r.total_mom) }}
  <td class="r">{% if r.rs is not none %}<b>{{ r.rs|round|int }}</b>{% else %}—{% endif %}</td>
  <td class="r muted sm">{{ ('$%.2f'|format(r.price)) if r.price is not none else '—' }}</td>
</tr>
{%- endmacro %}
