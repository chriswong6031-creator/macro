{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro sbar(a) -%}
{% set w = ((a if a else 0) / 3.0 * 50) %}
<span class="abar">{% if (a or 0) >= 0 %}<i style="left:50%;width:{{ [w,50]|min|round(1) }}%;background:var(--up)"></i>{% else %}<i style="right:50%;width:{{ [-w,50]|min|round(1) }}%;background:var(--down)"></i>{% endif %}<i class="mid"></i></span>
{%- endmacro %}
{% macro entry(r) -%}
<span class="echip {{ r.entry_css }}">{{ t(r.entry_en, r.entry_zh) }}</span>
{%- endmacro %}
{# extension / exhaustion grade (own-history) — risk placement, never in the score.
   Null-safe: a row with no extension data renders a neutral dash. #}
{% macro stretch(r) -%}
{%- set g = r.grade if (r.grade is defined and r.grade) else 'na' -%}
{%- set ez = r.ext_z if (r.ext_z is defined and r.ext_z is not none) else none -%}
{%- set near = r.near_52wh if (r.near_52wh is defined and r.near_52wh is not none) else none -%}
{%- if g == 'parabolic' -%}
<span class="gchip ex-parabolic" title="Parabolic{% if ez is not none %}: {{ '%+.1f'|format(ez) }}σ above{% else %}: far above{% endif %} this name's OWN normal distance from its 200-day average — the validated blow-off tail. In the point-in-time test that cohort ran ~9% return on ~50% vol with a −94% max drawdown and badly negative skew (vs the full leader cohort's 19% / 25% / −49%). A size-down / pullback-risk caution, NOT a short. · 抛物：远高于该股相对其200日均线的自身常态 — 经验证的冲顶尾部，回撤风险极高；减仓提示，而非做空。">⚠ {{ t(r.grade_en, r.grade_zh) }}{% if ez is not none %} <span class="xs">{{ '%+.1f'|format(ez) }}σ</span>{% endif %}</span>
{%- elif g == 'na' -%}
<span class="gchip ex-na">—</span>
{%- else -%}
<span class="gchip {{ r.grade_css }}" title="Extension vs the name's OWN history{% if ez is not none %}: ext_z {{ '%+.1f'|format(ez) }}σ (distance above its 200-day average, z-scored over a year){% endif %}{% if near is not none %}, {{ (near*100)|round }}% of its 52-week high{% endif %}. In-trend = leader, not stretched; Stretched = ≥1σ extended (sizing caution). A risk-placement read, never a rank input. · 相对自身历史的拉伸程度，仅作风险定位，不计入排名。">{{ t(r.grade_en, r.grade_zh) }}{% if ez is not none %} <span class="xs">{{ '%+.1f'|format(ez) }}σ</span>{% endif %}</span>
{%- endif -%}
{%- endmacro %}
{% macro mom(v) -%}
<td class="r {{ 'pos' if (v or 0) >= 0 else 'neg' }}">{{ ('%+.0f%%'|format(v)) if v is not none else '—' }}</td>
{%- endmacro %}
{# conviction drivers: chips for the confirming legs that actually move the score, plus an insider-cluster chip #}
{% set LEG_LBL = {'value':['Value','价值'],'quality':['Quality','质量'],'profitability':['Profit','盈利'],'low_vol':['LowVol','低波'],'insider':['Insider','内部']} %}
{% macro conv(r) -%}
<span class="cchips">
{%- for leg in tilt_legs if r.legs[leg] is not none and (r.legs[leg] >= 0.6 or r.legs[leg] <= -0.6) -%}
<span class="cchip {{ 'up' if r.legs[leg] >= 0 else 'down' }}" title="{{ leg }} z {{ '%+.1f'|format(r.legs[leg]) }}">{{ t(LEG_LBL[leg][0], LEG_LBL[leg][1]) }} {{ '%+.1f'|format(r.legs[leg]) }}</span>
{%- endfor -%}
{%- if r.ins_buyers and r.ins_buyers >= 2 and (r.ins_bps or 0) > 0 -%}<span class="cchip ins">👤{{ r.ins_buyers }}</span>{%- endif -%}
{%- if r.val_label -%}<span class="vchip {{ r.val_css }}" title="Earnings yield at the {{ r.ey_pctile }}th percentile of this name's OWN ~3-year history — {{ 'cheaper than its own norm (re-rating headroom)' if r.val_label=='cheap' else 'near the richest multiple it has carried in 3 years (stretched-valuation caution — the kind price extension alone can miss)' }}. Coarse (annual earnings), display-only, never scored. · 市盈收益率处于该股近3年自身历史的第 {{ r.ey_pctile }} 百分位；仅作展示，不计入评分。">{{ t(r.val_en, r.val_zh) }}</span>{%- endif -%}
{%- if r.attn_z is not none and r.attn_z >= (attn_threshold|default(2.0)) -%}<span class="cchip attn" title="Abnormal en.wikipedia attention (offshore), z {{ '%+.1f'|format(r.attn_z) }} — Da-Engelberg-Gao: attention precedes short-horizon reversal; over-extension / fade caution, not a buy. · 维基百科异常关注度（境外），z {{ '%+.1f'|format(r.attn_z) }} — 关注度领先短期反转；过度/回吐风险提示，非买入信号。">👁 {{ t('Attn','关注') }} {{ '%+.1f'|format(r.attn_z) }}σ{%- if r.ticker.endswith('.SS') or r.ticker.endswith('.SZ') or r.ticker.endswith('.HK') %} {{ t('· intl only','· 仅境外') }}{%- endif -%}</span>{%- endif -%}
</span>
{%- endmacro %}
{% macro trow(r, i) -%}
<tr data-grade="{{ r.grade }}">
  <td class="rk">{{ i }}</td>
  <td><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted sm">{{ r.name[:18] }}</span><br><span class="muted xs">{{ td(r.sector) }}</span></td>
  <td><div class="scorecell">{{ sbar(r.top_score) }}<span class="znum band-{{ r.band }}">{{ '%+.2f'|format(r.top_score) }}</span></div></td>
  <td>{{ stretch(r) }}</td>
  <td>{{ entry(r) }}</td>
  <td class="convcell">{{ conv(r) }}</td>
  <td class="r muted sm" title="sector-neutral residual-momentum z (selection leg)">{{ '%+.2f'|format(r.alpha) }}{% if r.sector_rank %} <span class="xs">#{{ r.sector_rank }}/{{ r.sector_n }}</span>{% endif %}</td>
  <td class="r muted sm">{{ ('$%.2f'|format(r.price)) if r.price is not none else '—' }}</td>
</tr>
{%- endmacro %}
{% macro srow(r) -%}
<tr data-grade="{{ r.grade }}">
  <td><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted sm">{{ r.name[:18] }}</span></td>
  <td><div class="scorecell">{{ sbar(r.top_score) }}<span class="znum band-{{ r.band }}">{{ '%+.2f'|format(r.top_score) }}</span></div></td>
  <td>{{ stretch(r) }}</td>
  <td>{{ entry(r) }}</td>
  <td class="convcell">{{ conv(r) }}</td>
  <td class="r muted sm">{{ '%+.2f'|format(r.alpha) }}</td>
</tr>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Top Picks — holistic conviction + entry timing', '精选股 — 综合信念 + 入场时机') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1320px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; }
  h3 { font-size:13px; margin:0 0 6px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); } .sm { font-size:12px; } .xs { font-size:10.5px; color:var(--muted); }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:left; padding:5px 7px; border-bottom:1px solid var(--line); vertical-align:middle; }
  th { color:var(--muted); font-weight:500; } td.r, th.r { text-align:right; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:300px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:none; }
  .help:hover .tip { display:block; }
  .tabs { display:flex; gap:6px; flex-wrap:wrap; margin:0 0 14px; }
  .tabbtn { padding:7px 14px; font:inherit; font-size:13px; border:1px solid var(--line); background:var(--panel); color:var(--muted); border-radius:8px; cursor:pointer; }
  .tabbtn.on { background:var(--panel2); color:var(--text); border-color:var(--muted); }
  .seg { display:inline-flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; margin-bottom:10px; }
  .segbtn { padding:5px 16px; font:inherit; font-size:12px; background:var(--panel); color:var(--muted); border:none; cursor:pointer; }
  .segbtn.on { background:var(--panel2); color:var(--text); }
  .rk { color:var(--muted); font-size:12px; width:26px; }
  .scorecell { display:flex; align-items:center; gap:8px; min-width:150px; }
  .abar { position:relative; flex:1; height:12px; border-radius:6px; background:var(--panel2); overflow:hidden; min-width:74px; }
  .abar > i { position:absolute; top:0; bottom:0; } .abar > i.mid { left:50%; width:1px; background:var(--muted); opacity:.5; }
  .znum { font-variant-numeric:tabular-nums; width:42px; text-align:right; }
  .band-strong .znum, .band-leader .znum { color:var(--up); font-weight:600; }
  .band-lag .znum, .band-deeplag .znum { color:var(--down); font-weight:600; }
  /* entry badges (axis 2) */
  .echip { font-size:10.5px; padding:1px 8px; border-radius:7px; border:1px solid var(--line); white-space:nowrap; font-weight:600; }
  .tp-buyzone { color:var(--up); border-color:var(--up); background:color-mix(in srgb, var(--up) 12%, transparent); }
  .tp-extended { color:var(--down); border-color:var(--down); }
  .tp-steady, .tp-laggard, .tp-neutral { color:var(--muted); font-weight:400; }
  /* conviction driver chips */
  .convcell { max-width:260px; }
  .cchips { display:flex; flex-wrap:wrap; gap:4px; }
  .cchip { font-size:10px; padding:1px 6px; border-radius:6px; border:1px solid var(--line); white-space:nowrap; color:var(--muted); }
  .cchip.up { color:var(--up); border-color:color-mix(in srgb, var(--up) 45%, var(--line)); }
  .cchip.down { color:var(--down); border-color:color-mix(in srgb, var(--down) 45%, var(--line)); }
  .cchip.ins { color:var(--text); border-color:var(--muted); }
  .cchip.attn { color:var(--muted); border-style:dashed; border-color:var(--muted); }  /* display-only caution */
  /* buy-zone sweet-spot strip */
  .bz-strip { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:10px; }
  .bz-card { border:1px solid var(--up); border-radius:9px; padding:9px 11px; background:color-mix(in srgb, var(--up) 7%, var(--panel)); }
  .bz-card .tk { font-weight:700; font-size:14px; } .bz-card .tk a:hover { text-decoration:underline; }
  .bz-head { display:flex; justify-content:space-between; align-items:baseline; gap:6px; }
  .bz-score { font-variant-numeric:tabular-nums; font-weight:600; color:var(--up); }
  .secsel { font:inherit; font-size:13px; -webkit-appearance:none; appearance:none;
            padding:7px 30px 7px 11px; border:1px solid var(--line); border-radius:10px;
            background-color:var(--panel); background-image:var(--caret-svg); background-repeat:no-repeat;
            background-position:right 10px center; background-size:11px; color:var(--text);
            margin-bottom:12px; cursor:pointer; outline:none;
            transition:border-color .2s ease, box-shadow .2s ease; }
  .secsel:hover { border-color:color-mix(in srgb,var(--link) 32%,var(--line)); }
  .secsel:focus { border-color:color-mix(in srgb,var(--link) 70%,var(--line));
            box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 18%,transparent); }
  .note { margin:8px 0 0; line-height:1.5; }
  .twocol { display:grid; grid-template-columns:1fr 1fr; gap:18px; } @media (max-width:760px){ .twocol{ grid-template-columns:1fr; } }
  /* extension / exhaustion grade chips (axis: own-history extension — NEVER in the score) */
  .gchip { font-size:10.5px; padding:1px 7px; border-radius:7px; border:1px solid var(--line); white-space:nowrap; font-weight:600; }
  .gchip .xs { font-weight:400; opacity:.8; }
  .ex-intrend { color:var(--up); border-color:color-mix(in srgb, var(--up) 45%, var(--line)); }
  .ex-steady { color:var(--muted); font-weight:400; }
  .ex-stretched { color:var(--warn-fg); border-color:color-mix(in srgb, var(--warn-fg) 50%, var(--line)); background:color-mix(in srgb, var(--warn-fg) 8%, transparent); }
  .ex-parabolic { color:var(--down); border-color:var(--down); background:color-mix(in srgb, var(--down) 13%, transparent); }
  .ex-na { color:var(--muted); opacity:.45; font-weight:400; }
  /* valuation-vs-own-history chip (display-only tail flag) */
  .vchip { font-size:10px; padding:1px 6px; border-radius:6px; border:1px solid var(--line); white-space:nowrap; }
  .val-cheap { color:var(--up); border-color:color-mix(in srgb, var(--up) 45%, var(--line)); }
  .val-rich, .val-richest { color:var(--down); border-color:color-mix(in srgb, var(--down) 45%, var(--line)); }
  .val-richest { background:color-mix(in srgb, var(--down) 10%, transparent); font-weight:600; }
  /* cohort-stretch fragility banner (board-level, display-only sizing context) */
  .cohort { display:flex; align-items:center; gap:10px; flex-wrap:wrap; padding:10px 14px; border-radius:10px; margin-bottom:14px; border:1px solid var(--line); font-size:13px; }
  .cohort .dot { width:10px; height:10px; border-radius:50%; flex:none; }
  .cohort.normal { background:color-mix(in srgb, var(--up) 6%, var(--panel)); border-color:color-mix(in srgb, var(--up) 30%, var(--line)); } .cohort.normal .dot { background:var(--up); }
  .cohort.elevated { background:color-mix(in srgb, var(--warn-fg) 9%, var(--panel)); border-color:color-mix(in srgb, var(--warn-fg) 35%, var(--line)); } .cohort.elevated .dot { background:var(--warn-fg); }
  .cohort.stretched { background:color-mix(in srgb, var(--down) 9%, var(--panel)); border-color:color-mix(in srgb, var(--down) 38%, var(--line)); } .cohort.stretched .dot { background:var(--down); }
  .filt { display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--muted); cursor:pointer; margin-left:12px; }
  .filt input { accent-color:var(--link); cursor:pointer; }
  :root { --warn-fg:#b8770a; } :root[data-theme="dark"] { --warn-fg:#e0a93a; }
</style>
</head>
