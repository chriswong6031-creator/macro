{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro sbar(a) -%}
{% set w = ((a if a else 0) / 3.0 * 50) %}
<span class="abar">{% if (a or 0) >= 0 %}<i style="left:50%;width:{{ [w,50]|min|round(1) }}%;background:var(--up)"></i>{% else %}<i style="right:50%;width:{{ [-w,50]|min|round(1) }}%;background:var(--down)"></i>{% endif %}<i class="mid"></i></span>
{%- endmacro %}
{% macro entry(r) -%}
<span class="echip {{ r.entry_css }}">{{ t(r.entry_en, r.entry_zh) }}</span>
{%- endmacro %}
{% macro mom(v) -%}
<td class="r {{ 'pos' if (v or 0) >= 0 else 'neg' }}">{{ ('%+.0f%%'|format(v)) if v is not none else '—' }}</td>
{%- endmacro %}
{# conviction drivers: chips for the confirming legs that actually move the score, plus an insider-cluster chip #}
{% set LEG_LBL = {'value':['Value','价值'],'quality':['Quality','质量'],'profitability':['Profit','盈利'],'low_vol':['LowVol','低波'],'insider':['Insider','内部']} %}
{% macro conv(r) -%}
<span class="cchips">
{%- for leg in tilt_legs if r.legs[leg] is not none and (r.legs[leg] >= 0.6 or r.legs[leg] <= -0.6) -%}
<span class="cchip {{ 'up' if r.legs[leg] >= 0 else 'down' }}" title="{{ leg }} z {{ '%+.1f'|format(r.legs[leg]) }}">{{ t(LEG_LBL[leg][0], LEG_LBL[leg][1]) }} {{ '%+.1f'|format(r.legs[leg]) }}</span>
{%- endfor -%}
{%- if r.ins_buyers and r.ins_buyers >= 2 and (r.ins_bps or 0) > 0 -%}<span class="cchip ins">👤{{ r.ins_buyers }}</span>{%- endif -%}
{%- if r.attn_z is not none and r.attn_z >= (attn_threshold|default(2.0)) -%}<span class="cchip attn" title="Abnormal en.wikipedia attention (offshore), z {{ '%+.1f'|format(r.attn_z) }} — Da-Engelberg-Gao: attention precedes short-horizon reversal; over-extension / fade caution, not a buy. · 维基百科异常关注度（境外），z {{ '%+.1f'|format(r.attn_z) }} — 关注度领先短期反转；过度/回吐风险提示，非买入信号。">👁 {{ t('Attn','关注') }} {{ '%+.1f'|format(r.attn_z) }}σ{%- if r.ticker.endswith('.SS') or r.ticker.endswith('.SZ') or r.ticker.endswith('.HK') %} {{ t('· intl only','· 仅境外') }}{%- endif -%}</span>{%- endif -%}
</span>
{%- endmacro %}
{% macro trow(r, i) -%}
<tr>
  <td class="rk">{{ i }}</td>
  <td><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted sm">{{ r.name[:18] }}</span><br><span class="muted xs">{{ td(r.sector) }}</span></td>
  <td><div class="scorecell">{{ sbar(r.top_score) }}<span class="znum band-{{ r.band }}">{{ '%+.2f'|format(r.top_score) }}</span></div></td>
  <td>{{ entry(r) }}</td>
  <td class="convcell">{{ conv(r) }}</td>
  <td class="r muted sm" title="sector-neutral residual-momentum z (selection leg)">{{ '%+.2f'|format(r.alpha) }}{% if r.sector_rank %} <span class="xs">#{{ r.sector_rank }}/{{ r.sector_n }}</span>{% endif %}</td>
  {{ mom(r.total_mom) }}
  <td class="r muted sm">{{ ('$%.2f'|format(r.price)) if r.price is not none else '—' }}</td>
</tr>
{%- endmacro %}
{% macro srow(r) -%}
<tr>
  <td><a href="stock.html#{{ r.ticker }}"><b>{{ r.ticker }}</b></a> <span class="muted sm">{{ r.name[:18] }}</span></td>
  <td><div class="scorecell">{{ sbar(r.top_score) }}<span class="znum band-{{ r.band }}">{{ '%+.2f'|format(r.top_score) }}</span></div></td>
  <td>{{ entry(r) }}</td>
  <td class="convcell">{{ conv(r) }}</td>
  <td class="r muted sm">{{ '%+.2f'|format(r.alpha) }}</td>
</tr>
{%- endmacro %}
