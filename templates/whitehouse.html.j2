{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}

{% block title %}{{ t('White House Watch', '白宫快讯') }}{% endblock %}

{% block base_css %}
  .wh-hero { max-width:1060px; margin:16px auto 0; background:var(--panel); border:1px solid var(--line);
             border-radius:16px; padding:24px 28px; position:relative; overflow:hidden; box-shadow:var(--card-shadow); }
  .wh-hero::before { content:""; position:absolute; inset:0 0 auto 0; height:4px;
             background:linear-gradient(90deg,#1f4ea8,#b23b4e 55%,#d9a441); }
  .wh-kick { font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--link); margin:0 0 8px; font-weight:700; }
  .wh-hero h1 { font-size:27px; line-height:1.18; margin:0 0 8px; letter-spacing:-.01em; }
  .wh-hero p.sub { font-size:14.5px; color:var(--text); opacity:.82; margin:0; max-width:80ch; }
  .wh-empty { max-width:1060px; margin:22px auto; padding:30px; text-align:center; color:var(--muted);
              border:1px dashed var(--line); border-radius:14px; }

  .wh-list { max-width:1060px; margin:22px auto 0; display:flex; flex-direction:column; gap:18px; }
  .wh-card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:20px 22px;
             scroll-margin-top:84px; position:relative; box-shadow:var(--card-shadow); }
  .wh-card.live { border-color:#b23b4e66; }
  .wh-card .row1 { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-bottom:8px; }
  .wh-badge { font-size:10.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase;
              padding:4px 9px; border-radius:999px; border:1px solid var(--line); white-space:nowrap; }
  .wh-badge.live { color:#fff; background:#b23b4e; border-color:#b23b4e; }
  .wh-badge.tone-tailwind { color:#1f9a55; border-color:#1f9a5566; }
  .wh-badge.tone-headwind { color:#d23f3f; border-color:#d23f3f66; }
  .wh-badge.tone-mixed    { color:#d9a441; border-color:#d9a44166; }
  .wh-badge.tone-neutral  { color:var(--muted); }
  .wh-when { font-size:12px; color:var(--muted); }
  .wh-card h2 { font-size:20px; line-height:1.25; margin:2px 0 6px; }
  .wh-summary { font-size:14.5px; opacity:.92; margin:0 0 6px; }

  .wh-meter { display:flex; align-items:center; gap:9px; margin:10px 0 4px; font-size:11.5px; color:var(--muted); }
  .wh-meter .bar { flex:0 0 130px; height:7px; border-radius:999px; background:var(--panel2); overflow:hidden; border:1px solid var(--line); }
  .wh-meter .bar > i { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg,#1f4ea8,#b23b4e); }

  .wh-body { font-size:14px; line-height:1.7; margin:10px 0; }
  .wh-body p { margin:8px 0; opacity:.93; }

  .wh-sub-h { font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin:16px 0 7px; font-weight:700; }
  table.wh-tbl { border-collapse:collapse; width:100%; font-size:13px; margin:4px 0 2px; }
  table.wh-tbl th { text-align:left; padding:7px 10px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:2px solid var(--line); }
  table.wh-tbl td { padding:7px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  table.wh-tbl tr:hover td { background:var(--panel2); }
  .wh-dir { font-weight:700; font-size:11.5px; white-space:nowrap; }
  .wh-dir.benefit { color:#1f9a55; }
  .wh-dir.hurt { color:#d23f3f; }
  .wh-dir.neutral { color:var(--muted); }
  html[data-theme="dark"] .wh-dir.benefit { color:#3fc07e; }
  html[data-theme="dark"] .wh-dir.hurt { color:#ef6a6a; }
  .wh-sym { font-weight:700; font-variant-numeric:tabular-nums; }
  .wh-chg { font-variant-numeric:tabular-nums; font-size:12px; }
  .wh-chg.up { color:#1f9a55; } .wh-chg.dn { color:#d23f3f; }
  html[data-theme="dark"] .wh-chg.up { color:#3fc07e; } html[data-theme="dark"] .wh-chg.dn { color:#ef6a6a; }

  .wh-src { font-size:12.5px; margin:14px 0 2px; }
  .wh-src a { color:var(--link); word-break:break-word; }
  .wh-disc { font-size:11.5px; color:var(--muted); border-top:1px solid var(--line); margin-top:14px; padding-top:10px; }
  .wh-pagedisc { max-width:1060px; margin:18px auto 0; font-size:12px; color:var(--muted);
                 border:1px solid var(--line); border-radius:12px; padding:12px 16px; background:var(--panel2); }
{% endblock %}

{% block content %}
<header class="wh-hero">
  <p class="wh-kick">🏛️ {{ t('White House Watch', '白宫快讯') }}</p>
  <h1>{{ t('Policy alerts, market-read', '政策快讯 · 市场解读') }}</h1>
  <p class="sub">{{ t('Every White House announcement is monitored. When one is judged market-moving, Claude Opus writes the read below — implications, sector head/tailwinds, and the names most exposed. Banners surface the live ones across the site.',
        '持续监控白宫的每一条公告。当某条被判定为可能影响市场时，Claude Opus 在下方给出解读——影响、行业的顺逆风，以及最受影响的标的。横幅会在全站推送仍然有效的快讯。') }}</p>
</header>

{% if not alerts %}
  <div class="wh-empty">{{ t('No market-moving White House announcements on watch right now. This page updates automatically when one lands.',
       '当前没有需要关注的、可能影响市场的白宫公告。一旦出现，本页将自动更新。') }}</div>
{% else %}
  <div class="wh-list">
  {% for a in alerts %}
    <section class="wh-card{{ ' live' if a.live else '' }}" id="{{ a.id }}">
      <div class="row1">
        {% if a.live %}<span class="wh-badge live">● {{ t('LIVE', '生效中') }}</span>{% endif %}
        <span class="wh-badge tone-{{ a.tone }}">
          {% if a.tone == 'tailwind' %}{{ t('Tailwind', '顺风') }}
          {% elif a.tone == 'headwind' %}{{ t('Headwind', '逆风') }}
          {% elif a.tone == 'mixed' %}{{ t('Mixed', '涨跌互现') }}
          {% else %}{{ t('Neutral', '中性') }}{% endif %}
        </span>
        <span class="wh-when">🗓 {{ a.date_display }}{% if a.section %} · {{ a.section }}{% endif %}</span>
        {% if a.confidence %}<span class="wh-when">· {{ t('confidence', '置信度') }}: {{ a.confidence }}</span>{% endif %}
      </div>

      <h2>{% if a.banner_title_zh %}<span class="l-en">{{ a.banner_title }}</span><span class="l-zh">{{ a.banner_title_zh }}</span>{% else %}{{ a.banner_title }}{% endif %}</h2>

      {% if a.summary %}<p class="wh-summary">{% if a.summary_zh %}<span class="l-en">{{ a.summary }}</span><span class="l-zh">{{ a.summary_zh }}</span>{% else %}{{ a.summary }}{% endif %}</p>{% endif %}

      {% if a.importance is not none %}
      <div class="wh-meter">
        <span>{{ t('Market significance', '市场重要性') }}</span>
        <span class="bar"><i style="width:{{ a.importance }}%"></i></span>
        <span>{{ a.importance }}/100</span>
      </div>
      {% endif %}

      {% if a.paragraphs %}
      <div class="wh-body">{% for p in a.paragraphs %}<p>{{ p }}</p>{% endfor %}</div>
      {% endif %}

      {% if a.sectors %}
      <div class="wh-sub-h">{{ t('Sector impact', '行业影响') }}</div>
      <table class="wh-tbl">
        <thead><tr><th>{{ t('Sector', '行业') }}</th><th>{{ t('Impact', '影响') }}</th><th>{{ t('Why', '原因') }}</th></tr></thead>
        <tbody>
        {% for s in a.sectors %}
          <tr>
            <td>{{ s.name }}</td>
            <td>{% if s.impact == 'tailwind' %}<span class="wh-dir benefit">▲ {{ t('Tailwind', '顺风') }}</span>{% elif s.impact == 'headwind' %}<span class="wh-dir hurt">▼ {{ t('Headwind', '逆风') }}</span>{% else %}<span class="wh-dir neutral">◆ {{ t('Mixed', '涨跌互现') }}</span>{% endif %}</td>
            <td>{{ s.rationale }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if a.benefit %}
      <div class="wh-sub-h">{{ t('Names that benefit', '受益标的') }}</div>
      <table class="wh-tbl">
        <thead><tr><th>{{ t('Ticker', '代码') }}</th><th>{{ t('Recent', '近期') }}</th><th>{{ t('Thesis', '逻辑') }}</th></tr></thead>
        <tbody>
        {% for tk in a.benefit %}
          <tr>
            <td><span class="wh-sym">{{ tk.symbol }}</span> <span class="wh-dir benefit">▲</span></td>
            <td>{% if tk.chg_pct is not none %}<span class="wh-chg {{ 'up' if tk.chg_pct >= 0 else 'dn' }}">{{ '%+.2f'|format(tk.chg_pct) }}%</span>{% else %}<span class="mut">—</span>{% endif %}</td>
            <td>{{ tk.rationale }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if a.hurt %}
      <div class="wh-sub-h">{{ t('Names under pressure', '承压标的') }}</div>
      <table class="wh-tbl">
        <thead><tr><th>{{ t('Ticker', '代码') }}</th><th>{{ t('Recent', '近期') }}</th><th>{{ t('Thesis', '逻辑') }}</th></tr></thead>
        <tbody>
        {% for tk in a.hurt %}
          <tr>
            <td><span class="wh-sym">{{ tk.symbol }}</span> <span class="wh-dir hurt">▼</span></td>
            <td>{% if tk.chg_pct is not none %}<span class="wh-chg {{ 'up' if tk.chg_pct >= 0 else 'dn' }}">{{ '%+.2f'|format(tk.chg_pct) }}%</span>{% else %}<span class="mut">—</span>{% endif %}</td>
            <td>{{ tk.rationale }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <p class="wh-src">🔗 <a href="{{ a.source_url }}" target="_blank" rel="noopener noreferrer">{{ t('Read the primary White House source', '阅读白宫一手来源') }} →</a></p>
      <div class="wh-disc">{{ a.disclaimer or disclaimer }}</div>
    </section>
  {% endfor %}
  </div>
{% endif %}

<div class="wh-pagedisc">
  {{ t('Source: the White House public RSS feeds (primary). Significance, titles and analysis are generated by',
       '来源：白宫公开 RSS（一手）。重要性、标题与分析由') }}
  {{ provider or 'Claude' }}
  {{ t('— context only, not investment advice. The tickers named are illustrative of plausible exposure, not recommendations, and feed no score or allocation.',
       '生成——仅供参考，不构成投资建议。所列标的仅为可能受影响的示例，并非推荐，且不参与任何评分或配置。') }}
</div>
{% endblock %}
