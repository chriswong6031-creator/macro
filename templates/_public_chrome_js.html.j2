{# Header elevation, settings popover, and landing-compatible language control. #}
<script>
(function(){
  var nav=document.querySelector('.public-nav');
  if(nav){
    var raf=false;
    var update=function(){nav.classList.toggle('sc',window.scrollY>10);raf=false;};
    window.addEventListener('scroll',function(){
      if(!raf){raf=true;window.requestAnimationFrame(update);}
    },{passive:true});
    update();
  }

  var drawer=document.getElementById('public-primary-navigation');
  var drawerBtn=document.getElementById('public-nav-toggle');
  var triggers=Array.prototype.slice.call(document.querySelectorAll('.public-nav-trigger'));
  var mq=window.matchMedia('(max-width:900px)');
  var panelFor=function(trigger){return document.getElementById(trigger.getAttribute('aria-controls'));};
  var closePanels=function(focus){
    var focused=null;
    triggers.forEach(function(trigger){
      if(trigger.getAttribute('aria-expanded')==='true')focused=trigger;
      trigger.setAttribute('aria-expanded','false');
      var panel=panelFor(trigger);if(panel)panel.hidden=true;
    });
    if(focus&&focused)focused.focus();
  };
  var closeDrawer=function(focus){
    if(!drawer||!drawerBtn)return;
    drawer.classList.remove('open');
    drawerBtn.setAttribute('aria-expanded','false');
    drawerBtn.setAttribute('aria-label','Open navigation');
    if(focus)drawerBtn.focus();
  };
  triggers.forEach(function(trigger){
    trigger.addEventListener('click',function(e){
      e.stopPropagation();
      var wasOpen=trigger.getAttribute('aria-expanded')==='true';
      closePanels(false);
      if(!wasOpen){
        trigger.setAttribute('aria-expanded','true');
        var panel=panelFor(trigger);if(panel)panel.hidden=false;
      }
    });
    trigger.addEventListener('keydown',function(e){
      if(e.key!=='ArrowDown'&&e.key!=='ArrowUp')return;
      e.preventDefault();
      closePanels(false);
      trigger.setAttribute('aria-expanded','true');
      var panel=panelFor(trigger);
      if(!panel)return;
      panel.hidden=false;
      var links=panel.querySelectorAll('a[href]');
      var target=e.key==='ArrowUp'?links[links.length-1]:links[0];
      if(target)target.focus();
    });
    var group=trigger.closest('.public-nav-group');
    if(group)group.addEventListener('focusout',function(e){
      if(mq.matches||group.contains(e.relatedTarget))return;
      closePanels(false);
    });
  });
  if(drawer&&drawerBtn){
    drawerBtn.addEventListener('click',function(e){
      e.stopPropagation();
      var opening=drawerBtn.getAttribute('aria-expanded')!=='true';
      if(opening){
        drawer.classList.add('open');
        drawerBtn.setAttribute('aria-expanded','true');
        drawerBtn.setAttribute('aria-label','Close navigation');
      }else{
        closePanels(false);closeDrawer(false);
      }
    });
    drawer.querySelectorAll('a[href]').forEach(function(link){
      link.addEventListener('click',function(){closePanels(false);closeDrawer(false);});
    });
    var reset=function(){closePanels(false);closeDrawer(false);};
    if(mq.addEventListener)mq.addEventListener('change',reset);else mq.addListener(reset);
  }

  var btn=document.getElementById('gear-btn');
  var pop=document.getElementById('gear-pop');
  document.addEventListener('pointerdown',function(e){
    if(nav&&!nav.contains(e.target)){closePanels(false);closeDrawer(false);}
  });
  document.addEventListener('keydown',function(e){
    if(e.key!=='Escape')return;
    var open=triggers.some(function(trigger){return trigger.getAttribute('aria-expanded')==='true';});
    if(open){e.preventDefault();closePanels(true);return;}
    if(drawerBtn&&drawerBtn.getAttribute('aria-expanded')==='true'){e.preventDefault();closeDrawer(true);}
  });
  if(!btn||!pop)return;
  var segs=Array.prototype.slice.call(pop.querySelectorAll('.gp-seg-b'));
  var current=function(){return document.documentElement.getAttribute('data-lang')==='zh'?'zh':'en';};
  var close=function(){pop.classList.remove('open');btn.setAttribute('aria-expanded','false');};
  var sync=function(){var lang=current();segs.forEach(function(s){s.classList.toggle('on',s.getAttribute('data-set-lang')===lang);});};
  btn.addEventListener('click',function(e){
    e.stopPropagation();
    closePanels(false);
    var opening=!pop.classList.contains('open');
    pop.classList.toggle('open',opening);
    btn.setAttribute('aria-expanded',opening?'true':'false');
  });
  segs.forEach(function(s){
    s.addEventListener('click',function(e){
      e.stopPropagation();
      var lang=s.getAttribute('data-set-lang')==='zh'?'zh':'en';
      document.documentElement.setAttribute('data-lang',lang);
      document.documentElement.lang=lang==='zh'?'zh-CN':'en';
      try{localStorage.setItem('lang',lang);}catch(ignore){}
      try{document.dispatchEvent(new CustomEvent('langchange',{detail:{lang:lang}}));}catch(ignore){}
      sync();
    });
  });
  document.addEventListener('click',function(e){if(!pop.contains(e.target)&&e.target!==btn)close();});
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&pop.classList.contains('open')){close();btn.focus();}
  });
  sync();
})();
</script>
