{% import "_decision_card.html.j2" as dc %}
{% from "_icons.html.j2" import icon %}
{#- ====================== US ACT-NOW BOARD (v2, five lanes) ======================
   The mature sectors+themes action board, transplanted from us_stocks.html
   (#action-board, assembled by scripts/build_site.action_board()). SHARED include:
   rendered on us_stocks.html via dashboard.html.j2 AND on the US Sector Intelligence
   Overview (sector_central.html) via build_sector_central. Each host passes
   action_board=<dict>; build_site persists site/basketdata/action_board.json and
   build_sector_central reads it (reader pattern).

   Self-sufficient by design: it carries its own help/t/dispshort DISPLAY macros and
   the board CSS. tr()/td() come from the host Jinja env globals (i18n); the shared
   row-pop hover engine (theme.js) and the .rp-src/.row-pop/.lst-* framework come from
   theme.css (both hosts link it). The legacy .help/.tip hover framework does NOT —
   it lives inline in dashboard.html.j2, so this include carries a byte-identical
   copy at the end of its <style> (hosts without the page-level copy — sector_central —
   rendered the h2 help() tip permanently inline before it). Every per-row field (sector_setup, EW
   overlay, two-reads) is pre-merged onto each item by action_board(), so the board
   needs nothing from the view-model but action_board (shock_state is optional/guarded). -#}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{#- Tier-gate disclosure for a lane whose rows were withheld. Same plain line and
    the same .pg-more class the host page uses, so the hydration script's sweep
    clears these too. The lane HEADING already carries the true full count; this
    only says where the missing rows went. -#}
{% macro ab_more(n) -%}
<p class="pg-more" style="padding:4px 12px 8px;margin:0"><span class="l-en">{{ n }} more here — <a href="plans.html">sign in to see the full lane</a></span><span class="l-zh">此处还有 {{ n }} 个 — <a href="plans.html">登录后查看完整分组</a></span></p>
{%- endmacro %}
{% macro dispshort(name) -%}
{%- set _n = name | string -%}
{%- set _abbr = {
  'Consumer Staples':'Cons Staples','Consumer Discretionary':'Cons Disc',
  'Communication Services':'Comm Services','Reshoring & Industrial Capex':'Industrial Capex',
} -%}
{%- set _base = _n | replace(' (Equal-Weight)','') -%}
{%- set _ew = ' (EW)' if ' (Equal-Weight)' in _n else '' -%}
{%- if _base in _abbr -%}{{ _abbr[_base] }}{{ _ew }}{%- else -%}{{ _base }}{{ _ew }}{%- endif -%}
{%- endmacro %}
{% if action_board %}
{#- ── TIER GATE (docs/TIER_PREVIEW_PATTERN.md) ──────────────────────────────────
   This board's rows are what templates/tier_preview.js has always treated as paid
   (`#action-board .actbody`, anon 1 / free 3), but the capping was a DOM overlay:
   every row stayed in the shipped bytes. The split is the gate, so this file now
   renders in three shapes from ONE set of row macros:

     · ab_locked  — rows only. scripts/build_site.py._write_us_payload renders THIS
                    FILE with the WITHHELD rows to fill the paid payload. No CSS,
                    no panel chrome, no headings: none of that is withheld content.
     · pgate      — the free shell. Each lane bakes only `pgate.actnow.preview`
                    rows; the lane COUNTS stay the true full-board figures ("state
                    and totals are free, names are paid"), and the fold button is
                    suppressed while gated because with nothing behind it it is a
                    control over nothing.
     · neither    — every other host (sector_central.html) and every ungated
                    build: unchanged, byte-for-byte.

   The row macros below are shared by all three, so the free preview, the paid
   remainder and the ungated board can never drift apart. -#}
{%- set _ab_rows_only = (ab_locked is defined and ab_locked) -%}
{%- set _ab_gate = (pgate.actnow if (pgate is defined and pgate and pgate.get('actnow')) else none) -%}
{%- set _ab_pv = (_ab_gate.preview if _ab_gate else 0) -%}
{%- if not _ab_rows_only -%}
  {#- Decision-card component stylesheet (hover cards). dashboard.html.j2 emits this
     once at the page head for its other cards; on the SI Overview the board is the
     only dc.dc_card() consumer, so the include emits it. Duplicate emission is a
     harmless same-rules <style>. -#}
  {{ dc.dc_css() }}
  {#- Board CSS. These rules live inline in dashboard.html.j2 (NOT in the shared
     theme.css bundle) and ride HERE with the include ON PURPOSE: editing theme.css
     rehashes it and stales the ?v= cache-stamp on ~176 committed pages (render
     re-stamp chain / tests/test_unsubscribe_page.py). The .actcol/.actitem base rules
     already live in theme.css and are untouched; these are the board-specific
     overrides + lane/chip/row styling copied verbatim from dashboard.html.j2. -#}
  <style>
  /* action board */
  .actiongrid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; align-items: start; }
  @media (max-width: 1100px) { .actiongrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .actiongrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .actiongrid { grid-template-columns: minmax(0, 1fr); } }
  /* V2 action board — lane column card, restyled to the china anv2 lane idiom
     (operator request 2026-07-11): panel card, 14px radius, 3px accent bar inside
     the header, colored uppercase lane titles, chips-below-name rows.
     Class names unchanged — fold JS (.actcol/.actbody/.act-fold) and the View-all
     modal (.acth-name/.acth-sub) query them. */
  .actcol { background: var(--panel); border: 1px solid var(--line); min-width: 0;
            border-radius: 14px; padding: 0; overflow: hidden;
            display: flex; flex-direction: column; --act-accent: var(--muted); }
  /* --act-accent stays fill-grade for the lane bar; --act-accent-ink is the
     text-grade twin for .acth-name (violet measured 4.19:1 dark / 3.89 light). */
  .act-buy  { --act-accent: var(--up); --act-accent-ink: var(--ink-up, var(--up)); }
  .act-soon { --act-accent: var(--info); --act-accent-ink: var(--ink-info, var(--info)); }
  .act-run  { --act-accent: #8b5cf6; --act-accent-ink: color-mix(in srgb, #8b5cf6 80%, var(--text)); }   /* neutral violet — NOT green/buy */
  .act-trim { --act-accent: var(--warn); --act-accent-ink: var(--ink-warn, var(--warn)); }
  .act-hold { --act-accent: var(--muted); --act-accent-ink: var(--muted); }
  html[data-theme="light"] .act-run { --act-accent-ink: color-mix(in srgb, #8b5cf6 72%, var(--text)); }
  /* ── Monoline marks (doctrine §5.8 — emoji are not UI icons) ──────────────
     Lane heads, row marks, the legend and the hover-card mark all draw from
     templates/_icons.html.j2 (24×24, stroke=currentColor), so each mark
     inherits its context's ink: the lane icons ride
     --act-accent-ink, which is what carries forward the per-lane colour
     identity the coloured dots used to supply — and the glyph now says what
     the lane DOES, which a coloured dot never did.
     The bottoming-watch strip (_us_bottoming_watch.html.j2, the board's own
     watch surface) reuses .acth-icon / .ai-bdg for its two marks instead of
     shipping a third icon rule, so it is sized from here.
     NO bare `.ic-svg {}` rule here on purpose: sector_central.html.j2 scopes
     its own copy under #si-confluence, and a global rule shipped from a panel
     would fight its host. Explicit selectors only, one size per context.
     .row-pop-mark is deliberately NOT scoped to #action-board — theme.js
     clones the hover card onto document.body, so an id-scoped rule would
     style the hidden source and miss the card the reader actually sees. */
  .ai-bdg .ic-svg, .acth-icon .ic-svg, .row-pop-mark .ic-svg,
  .ab-shock-ic .ic-svg, #action-board .help .tip .ic-svg {
    fill: none; stroke: currentColor; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; }
  .ai-bdg .ic-svg { width: 13px; height: 13px; display: block; }
  .acth-icon .ic-svg { width: 14px; height: 14px; display: block; }
  .row-pop-mark .ic-svg { width: 17px; height: 17px; display: block; }
  /* inline runs — a mark inside a sentence keeps the text baseline, never block */
  .ab-shock-ic { color: var(--ink-warn, var(--warn)); }
  .ab-shock-ic .ic-svg { width: 14px; height: 14px; display: inline-block; vertical-align: -.17em; }
  #action-board .help .tip .ic-svg { width: 12px; height: 12px; display: inline-block; vertical-align: -.14em; }
  /* Lane header — accent top bar via ::before (anv2-lane-hd idiom) */
  .acth { padding: 10px 13px 8px; border-bottom: 1px solid var(--line); position: relative; }
  .acth::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
                  border-radius: 14px 14px 0 0; background: var(--act-accent); }
  .acth-title-row { display: flex; align-items: center; gap: 5px; }
  .acth-icon { display: flex; line-height: 1; flex: none; color: var(--act-accent-ink, var(--act-accent)); }
  .acth-name { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
               color: var(--act-accent-ink, var(--act-accent)); flex: 0 1 auto; min-width: 0;
               white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acth-count { flex: none; font-size: 11px; font-weight: 400; color: var(--muted); }
  .acth-count::before { content: "("; } .acth-count::after { content: ")"; }
  .acth-sub { font-size: 10.5px; color: var(--muted); line-height: 1.4; margin-top: 3px; }
  /* Lane body list */
  .actbody { padding: 6px 0; flex: 1; }
  /* V2 row — anv2-row anatomy: name row on top, chips row below, stat line last */
  .actitem { display: block; padding: 7px 13px;
             border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
             font-size: 13px; min-width: 0; overflow: hidden;
             text-decoration: none; color: inherit; cursor: pointer;
             transition: background 0.1s; position: relative; }
  .actitem:last-child { border-bottom: none; }
  /* `outline:none` here is (0,2,0) and theme.css's focus ring is a deliberate
     low-specificity :where() at (0,1,0) — so this line silently removed the ring
     from all 45 rows on us_stocks while the estate believed it was compliant
     (design system §14: a focus-visible ring on EVERY interactive element).
     Hover keeps its wash; the ring is restored for keyboard only. */
  .actitem:hover, .actitem:focus { background: color-mix(in srgb, var(--panel2) 55%, transparent); }
  .actitem:focus:not(:focus-visible) { outline: none; }
  .actitem:focus-visible { outline: 2px solid color-mix(in srgb, var(--link) 78%, transparent); outline-offset: -2px; }
  .actitem.hovered { background: color-mix(in srgb, var(--panel2) 80%, transparent); }
  .act-row-top { display: flex; align-items: center; gap: 6px; min-width: 0; }
  /* Row kind mark. --muted, not text-at-85%: it is a type label (fund vs basket),
     never a signal, so it must stay subordinate to the name in BOTH themes —
     near-black at .85 on white is a heavier mark than the same rule on dark. */
  .ai-bdg { display: flex; flex: none; color: var(--muted); cursor: default; }
  .act-row-name { flex: 1; min-width: 0; font-size: 12.5px; font-weight: 600; color: var(--text);
                  line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* theme composite score — anv2-score idiom (big number, right of the name) */
  .act-row-score { flex: none; font-size: 15px; font-weight: 800; font-variant-numeric: tabular-nums;
                   white-space: nowrap; }
  .act-score-hi  { color: var(--ink-up, var(--up)); }
  .act-score-mid { color: var(--ink-warn, var(--warn)); }
  .act-score-lo  { color: var(--ink-down, var(--down)); }
  /* V2 stat line — last line of the row; muted label, china-anv2-style colored value
     (var(--up)/var(--down) so the zh red/green flip rides along); hidden on mobile */
  .act-row-stat { display: block; font-size: 10.5px; color: var(--muted); line-height: 1.35; margin-top: 3px;
                  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .act-row-stat .up { color: var(--ink-up, var(--up)); font-weight: 600; }
  .act-row-stat .dn { color: var(--ink-down, var(--down)); font-weight: 600; }
  @media (max-width: 560px) { .act-row-stat { display: none; } }
  .act-row-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 3px; margin-top: 4px; }
  /* V2 action chip — anv2-chip idiom (uppercase 10px, 4px radius) */
  .ab-chip { font-size: 10px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase;
             padding: 2px 6px; border-radius: 4px; line-height: 15px; white-space: nowrap; flex: none; }
  .ab-chip--warn { background: color-mix(in srgb, var(--warn) 14%, transparent);
                   color: var(--ink-warn, var(--warn)); border: 1px solid color-mix(in srgb, var(--ink-warn, var(--warn)) 28%, transparent); }
  .ab-chip--pos  { background: color-mix(in srgb, var(--up) 14%, transparent);
                   color: var(--ink-up, var(--up)); border: 1px solid color-mix(in srgb, var(--ink-up, var(--up)) 28%, transparent); }
  .ab-chip--neg  { background: color-mix(in srgb, var(--down) 14%, transparent);
                   color: var(--ink-down, var(--down)); border: 1px solid color-mix(in srgb, var(--ink-down, var(--down)) 28%, transparent); }
  .ab-chip--info { background: color-mix(in srgb, var(--info) 14%, transparent);
                   color: var(--ink-info, var(--info)); border: 1px solid color-mix(in srgb, var(--ink-info, var(--info)) 28%, transparent); }
  .ab-chip--muted { background: color-mix(in srgb, var(--muted) 12%, transparent);
                    color: var(--muted); border: 1px solid color-mix(in srgb, var(--muted) 22%, transparent); }
  /* A chip whose wording is longer than a lane column. .ab-chip is nowrap + flex:none,
     so a long label runs past .actitem's overflow:hidden and is silently CLIPPED —
     measured at 180px inside a 177px row for the graduation-gap chip. Its words ship
     from the engine (bottoming_authority) and must not be shortened on the page, so
     the chip wraps to a second line instead of losing its tail.
     white-space alone is NOT enough: .ab-chip is `flex: none` (= 0 0 auto), so the
     chip keeps its max-content width and wraps nowhere. It has to be allowed to
     shrink as well — flex-shrink + min-width:0 are what actually let the text reflow. */
  .ab-chip--wrap { white-space: normal; line-height: 1.3; flex: 0 1 auto; min-width: 0; max-width: 100%; }
  /* gate-override ✓ pill */
  .ab-chip--gate { background: color-mix(in srgb, var(--up) 10%, transparent);
                   color: var(--ink-up, var(--up)); border: 1px solid color-mix(in srgb, var(--up) 22%, transparent);
                   font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
                   line-height: 15px; flex: none; cursor: help; }
  /* theme item star/check/lens glyphs */
  .ai-book { flex: none; margin-left: 4px; font-size: 10px; font-weight: 800; cursor: help;
             color: var(--ink-up, var(--up)); white-space: nowrap; }
  .ai-val { flex: none; margin-left: 4px; font-size: 10.5px; font-weight: 800; color: var(--ink-up, var(--up)); cursor: help; }
  .ai-lens { flex: none; margin-left: 4px; font-size: 11px; color: var(--muted); cursor: help; }
  /* theme item name */
  .actitem.ai-theme .act-row-name { font-weight: 700; }
  /* legacy chips kept for non-board uses */
  .ew-chip { display: none; }  /* hidden in V2 board; moved to popover */
  .acttag, .actage, .acteta, .eqmini { display: none; }  /* moved to popover in V2 */
  /* action-board rows opt in to the shared row-pop engine via [data-rpop] */
  /* .notable is its own .panel since 2026-07-11 — panel chrome carries the separation */
  /* keep legacy references alive for non-board code */
  .actitem b { color: var(--text); }
/* page-scoped fold — every V2 action lane shows only its top 3 rows initially */
.actbody.act-fold.is-collapsed > a.actitem:nth-child(n+4),
.actbody.act-fold.is-collapsed > div:nth-child(n+4) { display: none; }
/* Hide the Show-more button when the lane holds fewer rows than its cap.
   All five lanes now share the same top-three contract. */
.actcol:not(:has(.actbody.act-fold > a.actitem:nth-child(4))):not(:has(.actbody.act-fold > div:nth-child(4))):not(:has(.ab-trim-fold > a.actitem:nth-child(4))):not(:has(.ab-trim-fold > div:nth-child(4))) .lst-more.act-more { display: none; }
.ab-trim-fold.is-collapsed > a.actitem:nth-child(n+4),
.ab-trim-fold.is-collapsed > div:nth-child(n+4) { display: none; }
/* Stand-aside keeps its stable id and uses the shared cap-3 fold. */
.lst-collapse.lst-cap3.is-collapsed > a.actitem:nth-child(n+4),
.lst-collapse.lst-cap3.is-collapsed > div:nth-child(n+4) { display: none; }
  /* ── TS-R6: two-reads reconciliation chip ───────────────────────────────── */
  .two-reads-chip { display:inline-flex; align-items:flex-start; gap:4px; padding:2px 8px; border-radius:6px; font-size:10px; font-weight:600;
    /* was white-space:nowrap — the chip is flex:none inside .actitem{overflow:hidden},
       so in the TAKE PROFITS lane the pill ran past the card's rounded corner and the
       label was cut mid-word ('broad sector AC'). The file's own .ab-chip--wrap note
       warns that white-space alone is not enough; the shrink pair is what fixes it.
       DOCTRINE §3: full display names WRAP, never truncate. */
    white-space:normal; line-height:1.35; flex:0 1 auto; min-width:0; max-width:100%; background:color-mix(in srgb,var(--info) 9%,var(--panel2)); border:1px solid color-mix(in srgb,var(--info) 28%,var(--line)); color:var(--ink-info, var(--info,var(--link))); cursor:help; }
  .two-reads-chip .tr-sep { opacity:.45; margin:0 2px; }
  /* ── Legacy help() "?" hover framework — HOST-PORTABILITY COPY ─────────────
     us_stocks gets these rules from dashboard.html.j2's inline page <style>;
     they are NOT in theme.css (theme.css carries only the span.help glyph
     metrics + .help-upgraded popover overrides — see its help-icon comment).
     The SI Overview host has no page-level copy, so without this block the
     board h2's help() tip renders permanently inline next to the heading
     (Tier-2 sentence at the glance tier — doctrine violation, 2026-08-06).
     On us_stocks this is a harmless same-rules duplicate of the page block
     (same precedent as dc.dc_css() above). theme.js upgradeHelpIcons still
     swaps the CSS hover for the LENS popover where it runs; these rules are
     the no-JS floor. */
  /* help-tip-framework:BEGIN — legacy help() "?" hover framework. Byte-identical
     twin in templates/dashboard.html.j2 AND templates/_us_act_now_board.html.j2
     (the shared board include ships it to hosts that have no page-level copy —
     sector_central leaked the whole tip sentence inline without it, 2026-08-06).
     Deliberately NOT in theme.css: editing theme.css re-stamps ~176 pages, and
     its span.help glyph metrics must keep outranking these bare-.help rules.
     Keep both copies in step — pinned by
     tests/test_us_act_now.py::test_help_tip_framework_is_byte_identical_in_both_copies. */
  .help { display: inline-flex; align-items: center; justify-content: center;
          width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--muted);
          color: var(--muted); font-size: 10px; font-weight: 600; cursor: help;
          position: relative; vertical-align: middle; margin-left: 5px; flex: none; }
  .help .tip { display: none; position: absolute; bottom: 140%; left: 50%;
               transform: translateX(-50%); width: 330px;
               background: var(--panel); border: 1px solid var(--line);
               padding: 10px 13px; border-radius: 8px;
               z-index: 60; font-size: 12px; line-height: 1.5; color: var(--text);
               text-align: left; font-weight: 400; text-transform: none;
               letter-spacing: normal; box-shadow: var(--popover-shadow);
               pointer-events: auto; cursor: auto; white-space: normal;
               max-height: min(60vh, 420px); overflow-y: auto; overscroll-behavior: contain; }
  /* invisible hover pad across the gap between the ? icon and the tip box —
     without it the :hover chain breaks mid-travel and the tip vanishes before
     the cursor can reach (and scroll) it. Lives on .help, not .tip: the tip
     is a scroll container (overflow-y:auto), which clips its own pseudos. */
  .help:hover::before { content: ''; position: absolute; bottom: 100%; left: -30px; right: -30px; height: 10px; }
  .help:hover .tip, .help.tip-open .tip { display: block; }
  th .help .tip, .help.below .tip { bottom: auto; top: 140%; }
  th .help:hover::before, .help.below:hover::before { bottom: auto; top: 100%; }
  /* keep tooltips on-screen near the right/left viewport edges */
  .help.edge-right .tip { left: auto; right: 0; transform: none; }
  .help.edge-left .tip { left: 0; right: auto; transform: none; }
  .help .tip.tip-wide { width: min(430px, calc(100vw - 32px)); }
  @media (max-width: 640px) {
    .help .tip.tip-wide { width: calc(100vw - 28px); font-size: 11.5px; line-height: 1.45; }
  }
  /* help-tip-framework:END */
  </style>
  <div class="panel span12" id="action-board">
    {#- Legend. Captured with {% set %}…{% endset %} so the block is Markup and the
        icon() macro output survives autoescape — the legend must show the SAME
        marks the rows show, or it is a legend for a board that no longer exists.
        ✓ and ★ are text glyphs, not emoji; they stay as characters. -#}
    {%- set _legend_en %}Every sector and theme is grouped by where it sits in the cycle. The lane name tells you what to do; open a row for detail. Symbols: {{ icon('sector') }} sector fund · {{ icon('diamond') }} theme · ✓ risk check passed · ★ in the model portfolio.{% endset -%}
    {%- set _legend_zh %}所有板块与主题都按当前周期位置分组。分组名称就是操作建议；打开任意一行可查看详情。图例：{{ icon('sector') }} 板块基金 · {{ icon('diamond') }} 主题 · ✓ 风险检查通过 · ★ 模型组合内。{% endset -%}
    <h2>{{ t('What to act on now', '当前可操作') }}{% if action_board.get('total') is number %} <span class="muted" style="font-size:11.5px;font-weight:400">{{ action_board.total }} {{ t('grouped', '个已分组') }}</span>{% endif %}
      {{ help(_legend_en, _legend_zh) }}
      <a href="sector_central.html#actnow-section" style="font-size:11px;color:var(--muted);font-weight:400;text-decoration:none;margin-left:8px"><span class="l-en">Theme reasons → Sector Intelligence</span><span class="l-zh">主题详情 → 行业情报页</span></a>
    </h2>
    {# Policy-shock de-escalation fresh-entry caution chip (PS-R3: display de-escalation only —
       no reordering, no removal. Ranks computed on pre-shock data; this chip is the only change.) #}
    {% if shock_state is defined and shock_state and shock_state.get('active') %}
    <div style="margin:6px 0 10px;padding:8px 12px;border-radius:8px;border-left:4px solid var(--warn);background:color-mix(in srgb,var(--warn) 12%,var(--panel2));font-size:13px;font-weight:600">
      <span class="ab-shock-ic">{{ icon('alert') }}</span> <span class="l-en">Market shock active — new entries are less predictable. The order below has not been changed and uses pre-shock data. Active until {{ shock_state.get('expires', '') }}.</span><span class="l-zh">市场冲击仍在 — 新入场更难判断。下方顺序未作调整，使用的是冲击前数据。有效期至 {{ shock_state.get('expires', '') }}。</span>
    </div>
    {% endif %}
    {# Unified board: diamond-marked narrative baskets (the AI-buildout-vs-rest resolution)
       lead each lane, landmark-marked GICS sectors follow. Basket buys carry a
       leadership-LENS marker (≈, descriptive) and basket reduces a backtested marker
       (✓, the absolute-trend drawdown gate); ★ = in the narrative-rotation model book. #}
    {# (legacy themeitem / themeitem_run row macros removed 2026-07-11 — dead since the
       V2 board switched every lane to ab_theme_row / ab_sector_row.) #}
    {# TS-R6 A2: two-reads chip for action-board sector rows (same ETF, two house reads disagree). #}
{%- endif -%}
    {% macro ab_two_reads(x) -%}{% if x.get('two_reads_chip') %}{% set _abtr = x.two_reads_chip %}<span class="two-reads-chip" data-tip-en="The slower cycle view says {{ _abtr.cycle_label_en }}, while the near-term setup says {{ _abtr.setup_label_en }}. They cover different time frames, so neither cancels the other." data-tip-zh="较慢的周期判断为 {{ _abtr.cycle_label_en }}，近期形态判断为 {{ _abtr.setup_label_en }}。两者观察的时间不同，因此互不覆盖。"><span class="tr-sep">⇔</span><span class="l-en">longer view <b>{{ _abtr.cycle_label_en }}</b> · near term <b>{{ _abtr.setup_label_en }}</b></span><span class="l-zh">较长周期 <b>{{ _abtr.cycle_label_en }}</b> · 近期 <b>{{ _abtr.setup_label_en }}</b></span></span>{% endif %}{%- endmacro %}
    {# FIX 2: EW-vs-cycle disclosure chip for sector rows — fires when EW and cycle disagree (buy vs reduce) and gate_override did NOT fire. #}
    {% macro ab_ew_two_reads(x) -%}{% if x.get('ew_two_reads') %}{% set _ewtr = x.ew_two_reads %}<span class="two-reads-chip" data-tip-en="The headline index says {{ _ewtr.cycle_label_en }}, while the average stock inside it says {{ _ewtr.ew_label_en }}. The difference shows whether a few large names are masking the broader sector." data-tip-zh="龙头指数判断为 {{ _ewtr.cycle_label_zh }}，板块内平均股票判断为 {{ _ewtr.ew_label_zh }}。两者的差异可看出少数大公司是否掩盖了板块整体。"><span class="tr-sep">⇔</span><span class="l-en">headline <b>{{ _ewtr.cycle_label_en }}</b> · broad sector <b>{{ _ewtr.ew_label_en }}</b></span><span class="l-zh">龙头指数 <b>{{ _ewtr.cycle_label_zh }}</b> · 板块整体 <b>{{ _ewtr.ew_label_zh }}</b></span></span>{% endif %}{%- endmacro %}
    {# ew_chip is inlined below each sector row for Jinja2 lexer compatibility. #}
    {#- V2 ACTION BOARD — new lane design (adjudicated 2026-07-10)
        Each lane: header (monoline lane icon + EN/ZH name + count + subtitle) + row list.
        Sector rows: glyph + name + optional chip + optional gate-✓ + stat line.
        Theme rows: name + star/check/lens glyphs (% moves to popover).
        Popover data stored in hidden .rp-src span, cloned by theme.js row-pop engine on hover.
        Folds: every lane shows its top three rows, then offers Show more.
        TS-R5 dash-hold-fold id PRESERVED on the stand-aside column.
    -#}
    {#- ---- Jinja macros for V2 rows ---- -#}
    {%- macro ab_chip(chip_en, chip_zh, chip_tone) -%}
    {%- if chip_en %}<span class="ab-chip ab-chip--{{ chip_tone }}"><span class="l-en">{{ chip_en }}</span><span class="l-zh">{{ chip_zh }}</span></span>{% endif -%}
    {%- endmacro -%}
    {#- W-A Amendment 1 (#4614): the graduation-gap chip. A reduce-side row the cycle
        organ reads as recovering off a low, which has already LEFT the bottoming lane —
        so it sits on no lane, and this chip is the only place it is named. Stamped by
        build_sector_central.build_bottoming_context() from the engine's own copy, so the
        page cannot drift from the measured basis; unstamped rows (every row on
        us_stocks.html, which does the join nowhere) render nothing. Info-toned, NOT
        green: "recovering from cycle low" is a state, never a buy verb. Deliberately a
        SEPARATE chip from conflict_chip_* — the two describe different disagreements. -#}
    {%- macro ab_recov(x) -%}
    {%- if x.get('recovering_chip_en') %}<span class="ab-chip ab-chip--info ab-chip--wrap" data-tip-en="{{ x.get('recovering_tip_en','')|e }}" data-tip-zh="{{ x.get('recovering_tip_zh', x.get('recovering_tip_en',''))|e }}"><span class="l-en">{{ x.recovering_chip_en|e }}</span><span class="l-zh">{{ x.get('recovering_chip_zh', x.recovering_chip_en)|e }}</span></span>{% endif -%}
    {%- endmacro -%}
    {%- macro ab_gate(x) -%}
    {%- if x.get('gate_override') %}<span class="ab-chip--gate" data-tip-en="The average stock in this sector says {{ x.get('ew', {}).get('label', '') }}. That broader risk check takes precedence over the slower headline-index reading." data-tip-zh="板块内平均股票判断为 {{ x.get('ew', {}).get('label_zh', '') or x.get('ew', {}).get('label', '') }}。这一更广泛的风险检查优先于较慢的龙头指数判断。">&#10003;</span>{% endif -%}
    {%- endmacro -%}
    {#- Popover source for a SECTOR row (hidden inline, cloned by JS) -#}
    {#- Compact decision card for a SECTOR row. Keep this payload intentionally
        glanceable: one setup read, at most three decision metrics, one visual timing
        cue, and one short takeaway. Full model prose belongs on the linked detail page.
        DO NOT REBUILD LAW #1513: FRESH BUY is the worst state on the board (not a buy
        edge); its state tag is warn, never green/up. -#}
    {%- macro ab_sector_pop(x) -%}
    {%- set _reduce_labels = ['TOP WATCH','ROLLING OVER','DECLINE','COUNTERTREND BOUNCE'] -%}
    {%- set _warn_labels = ['FRESH BUY','BOTTOM WATCH','NEARING A LOW','BOTTOMING','BASING','ACCUMULATION'] -%}
    {%- set _up_labels = ['RALLY ON','TURN SIGNALED','UPTREND','BUY ZONE'] -%}
    {%- set _lbl = x.get('label', '') -%}
    {%- set _stag_tone = 'dn' if _lbl in _reduce_labels else ('warn' if _lbl in _warn_labels else ('up' if _lbl in _up_labels else '')) -%}
    {%- set _stats = [] -%}
    {%- if x.get('rs_60d') is not none and x.get('rs_60d') is defined -%}
      {%- set _ = _stats.append({'label': ('60d lead','60日领先'), 'val': '%+.1f%%'|format(x.rs_60d),
                                 'tone': 'up' if x.rs_60d >= 0 else 'dn', 'sub': ('vs SPY','相对SPY')}) -%}
    {%- endif -%}
    {%- if x.get('eq_badge') -%}
      {%- set _ = _stats.append({'label': ('Entry','入场'), 'val': x.eq_badge,
                                 'tone': 'up' if x.eq_dir == 'up' else ('dn' if x.eq_dir == 'down' else ''),
                                 'sub': ('timing quality','时机质量')}) -%}
    {%- endif -%}
    {%- if x.get('buy_zone') is not none and x.get('n_holdings') -%}
      {%- set _ = _stats.append({'label': ('Breadth','广度'), 'val': '%d/%d'|format(x.buy_zone, x.n_holdings),
                                 'sub': ('in buy zone','处于买入区')}) -%}
    {%- endif -%}
    {%- set _bars = [] -%}
    {%- if x.get('rsi_3d') is not none and x.get('rsi_3d') is defined and x.get('stoch_3d') is not none and x.get('stoch_3d') is defined -%}
      {%- set _ = _bars.append({'label': 'RSI', 'pct': x.rsi_3d, 'val': '%.0f'|format(x.rsi_3d)}) -%}
      {%- set _ = _bars.append({'label': 'STO', 'pct': x.stoch_3d, 'val': '%.0f'|format(x.stoch_3d)}) -%}
    {%- endif -%}
    {%- set _sub_en -%}
    {%- if x.get('age_short') %}Signal {{ x.age_short }}{% endif -%}
    {%- if x.get('age_short') and x.get('dc_day') is not none and x.get('dc_day') is defined %} · {% endif -%}
    {%- if x.get('dc_day') is not none and x.get('dc_day') is defined %}cycle day {{ x.dc_day }}{% endif -%}
    {%- endset -%}
    {%- set _sub_zh -%}
    {%- if x.get('age_short') %}信号 {{ x.get('age_short_zh', x.age_short) }}{% endif -%}
    {%- if x.get('age_short') and x.get('dc_day') is not none and x.get('dc_day') is defined %} · {% endif -%}
    {%- if x.get('dc_day') is not none and x.get('dc_day') is defined %}周期第 {{ x.dc_day }} 日{% endif -%}
    {%- endset -%}
    {{ dc.dc_card({
      'kind': 'sector', 'mark': icon('sector'), 'tone': _stag_tone,
      'eyebrow': ('Sector pulse · ' ~ x.ticker, '板块脉搏 · ' ~ x.ticker),
      'name': (x.name|e, tr(x.name)|e),
      'tag': (td(x.label),),
      'kicker': ('Current setup','当前形态'),
      'read': ('Trend confirmed','趋势已确认') if _lbl in _up_labels
              else (('Early turn','早期转向') if _lbl in _warn_labels
              else (('Momentum fading','动能转弱') if _lbl in _reduce_labels
              else ('Wait for clarity','等待明朗'))),
      'sub': (_sub_en|trim, _sub_zh|trim),
      'bars': _bars, 'stats': _stats,
      'takeaway': ('Signals disagree. Keep size small until they align.','信号不一致，等待同步前保持小仓位。')
              if (x.get('two_reads_chip') or x.get('ew_two_reads') or x.get('conflict_reason_en'))
              else (('Trend confirmed — use pullbacks instead of chasing.','趋势已确认 — 等回调，不追高。') if _lbl in _up_labels
              else (('Early turn — keep size measured while the weekly trend catches up.','早期转向 — 周线趋势确认前控制仓位。') if _lbl in _warn_labels
              else (('Momentum is fading — protect gains and avoid fresh adds.','动能转弱 — 保护利润，避免加仓。') if _lbl in _reduce_labels
              else ('No clear setup yet — wait for the signals to agree.','暂无清晰形态 — 等待信号一致。')))),
      'foot': ('Click row for the full sector view','点击查看完整板块详情'),
      'foot_b': (x.ticker ~ ' ↗', x.ticker ~ ' ↗'),
    }) }}
    {%- endmacro -%}
    {#- Compact decision card for a THEME (narrative basket) row. Opaque diagnostics
        (flip distance, duplicate percentiles, full engine prose) stay on the detail page. -#}
    {%- macro ab_theme_pop(x) -%}
    {%- set _reco = x.get('reco', '') -%}
    {%- set _rtone = 'dn' if _reco in ('trim','avoid') else ('up' if _reco in ('accumulate','enter') else 'warn') -%}
    {%- set _stats = [] -%}
    {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined -%}
      {%- set _ = _stats.append({'label': ('20d lead','20日领先'), 'val': '%+.1f%%'|format(x.perf_20d_rel * 100),
                                 'tone': 'up' if x.perf_20d_rel >= 0 else 'dn', 'sub': ('vs market','相对市场')}) -%}
    {%- endif -%}
    {%- if x.get('breadth_pct50') is not none and x.get('breadth_pct50') is defined -%}
      {%- set _ = _stats.append({'label': ('Breadth','广度'), 'val': '%.0f%%'|format(x.breadth_pct50 * 100),
                                 'sub': ('above 50d','高于50日线')}) -%}
    {%- endif -%}
    {%- if x.get('rollover_band') is not none and x.get('rollover_band') is defined -%}
      {%- set _ = _stats.append({'label': ('Rollover','回落风险'),
                                 'val': (x.rollover_band|title, x.get('rollover_band_zh', x.rollover_band)),
                                 'tone': 'up' if x.rollover_band == 'low' else 'warn', 'sub': ('risk','风险')}) -%}
    {%- endif -%}
    {%- set _trust = [] -%}
    {%- if x.get('book_wt') is not none and x.get('book_wt') is defined -%}
      {%- set _ = _trust.append({'tone': 'up', 'en': '★ Model ' ~ '%.0f'|format(x.book_wt*100) ~ '%',
                                 'zh': '★ 模型 ' ~ '%.0f'|format(x.book_wt*100) ~ '%'}) -%}
    {%- endif -%}
    {%- if x.validated -%}
      {%- set _ = _trust.append({'tone': 'up', 'en': '✓ Risk check', 'zh': '✓ 风险检查'}) -%}
    {%- endif -%}
    {{ dc.dc_card({
      'kind': 'theme', 'mark': icon('diamond'), 'tone': _rtone,
      'eyebrow': ('Theme basket','主题篮子'),
      'name': (x.name|e, (x.name_zh or x.name)|e),
      'tag': (x.get('label') or _reco, x.get('label_zh') or x.get('label') or _reco),
      'score': x.get('score') if (x.get('score') is not none and x.get('score') is defined) else none,
      'kicker': ('Leadership read','领先度判断'),
      'read': ('Broad and leading','广泛领先') if _reco in ('accumulate','enter')
              else (('Late and extended','后期且延伸') if _reco == 'trim'
              else (('Breadth weakening','广度转弱') if _reco == 'avoid'
              else ('Trend intact','趋势完好'))),
      'trust': _trust, 'stats': _stats,
      'leaders': {'label': ('Leaders','龙头'), 'val': x.top_members[:3] | join(' · ')} if x.get('top_members') else none,
      'takeaway': ('Signals disagree. Wait for breadth and price to align.','信号不一致，等待广度与价格同步。')
              if x.get('conflict_reason_en')
              else (('Leadership is broad. Add on pullbacks, not into strength.','领先面广。回调时加仓，不要追强势。') if _reco in ('accumulate','enter')
              else (('Momentum is extended. Protect gains into strength.','动能已过度延伸。逢强保护利润。') if _reco == 'trim'
              else (('Breadth is fading. Stand aside until it turns again.','广度转弱。在重新转强之前先观望。') if _reco == 'avoid'
              else ('Trend is intact. Wait for a cleaner entry.','趋势完好。等待更干净的入场点。')))),
      'foot': ('Click row for holdings and full history','点击查看持仓与完整历史'),
      'foot_b': ('Open ↗','打开 ↗'),
    }) }}
    {%- endmacro -%}
    {#- V2 sector row macro — anv2-row anatomy (name row / chips row / stat line) -#}
    {%- macro ab_sector_row(x) -%}
    <a class="actitem" data-rpop href="{{ x.href }}">
      <span class="act-row-top">
        <span class="ai-bdg">{{ icon('sector') }}</span>
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ tr(x.name)|e }}</span></span>
      </span>
      {%- if x.get('chip_en') or x.get('gate_override') or x.get('ew_two_reads') or x.get('conflict_chip_en') or x.get('recovering_chip_en') %}
      <span class="act-row-chips">
        {{- ab_chip(x.get('chip_en',''), x.get('chip_zh',''), x.get('chip_tone','muted')) -}}
        {{- ab_gate(x) -}}
        {{- ab_ew_two_reads(x) -}}
        {#- W2b/W4 demotion receipt lifted from the EW overlay (MLC-R7) -#}
        {{- ab_chip(x.get('conflict_chip_en',''), x.get('conflict_chip_zh', x.get('conflict_chip_en','')), 'warn') -}}
        {{- ab_recov(x) -}}
      </span>
      {%- endif %}
      {%- if x.get('stat_en') %}<span class="act-row-stat"><span class="l-en">{{ x.stat_en }}</span><span class="l-zh">{{ x.get('stat_zh', x.stat_en) }}</span></span>{%- endif %}
      {{ ab_sector_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- V2 theme (narrative basket) row macro — composite score rides the name row;
        provenance glyphs (★ book / ✓ gate / ≈ lens / ⟳ run-reason) sit inline after
        the name instead of an orphan chips line; china-style 20d-vs-market stat. -#}
    {%- macro ab_theme_row(x) -%}
    <a class="actitem ai-theme" data-rpop href="{{ x.href }}">
      <span class="act-row-top">
        <span class="ai-bdg">{{ icon('diamond') }}</span>
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
        {%- if x.get('book_wt') %}<span class="ai-book" data-tip-en="This theme has a {{ '%.0f'|format(x.book_wt*100) }}% weight in the model portfolio and has passed its trend-risk check." data-tip-zh="该主题在模型组合中的权重为 {{ '%.0f'|format(x.book_wt*100) }}%，并已通过趋势风险检查。">&#9733;{{ '%.0f'|format(x.book_wt*100) }}%</span>{%- endif %}
        {%- if x.validated %}<span class="ai-val" data-tip-en="Risk check passed — the trend is intact and has not begun a damaging fade." data-tip-zh="风险检查通过 — 趋势仍然完整，尚未出现明显恶化。">&#10003;</span>{%- else %}<span class="ai-lens" data-tip-en="Leadership only — this shows what is leading, but it has not improved the buy decision." data-tip-zh="仅显示领先方向 — 可看出谁在领涨，但尚未改善买入判断。">&asymp;</span>{%- endif %}
        {%- if x.get('run_reason_en') %}<span class="ai-lens" data-tip-en="{{ x.run_reason_en }}" data-tip-zh="{{ x.get('run_reason_zh', x.run_reason_en) }}">&#8635;</span>{%- endif %}
        {%- if x.get('score') is not none and x.get('score') is defined %}{%- set _sc = x.score -%}
        <span class="act-row-score{% if _sc >= 60 %} act-score-hi{% elif _sc >= 40 %} act-score-mid{% else %} act-score-lo{% endif %}">{{ '%.0f'|format(_sc) }}</span>
        {%- endif %}
      </span>
      {#- FIX 1: conflict chip (warn tone) when theme was demoted from buy lanes -#}
      {#- The ab_chip() call keeps its exact pinned spelling (tests/test_theme_scoring_conflicted.py
          asserts this literal): an absent conflict_chip_en is Jinja Undefined, which ab_chip
          already treats as falsy, so a recovering-only row renders just its own chip. -#}
      {%- if x.get('conflict_chip_en') or x.get('recovering_chip_en') %}
      <span class="act-row-chips">
        {{- ab_chip(x.conflict_chip_en, x.get('conflict_chip_zh', x.conflict_chip_en), 'warn') -}}
        {{- ab_recov(x) -}}
      </span>
      {%- endif %}
      {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined %}
      <span class="act-row-stat"><span class="{{ 'up' if x.perf_20d_rel >= 0 else 'dn' }}">{{ '%+.1f'|format(x.perf_20d_rel * 100) }}%</span> <span class="l-en">20d vs market</span><span class="l-zh">20日对比市场</span></span>
      {%- endif %}
      {{ ab_theme_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- ROWS-ONLY OUTPUT — the withheld remainder for site/premiumdata/us_stocks.json.
        One <div> per lane, keyed by the lane's fold id, so the hydration script can
        append each lane's rows to the .actbody they were sliced out of. `wrap` mirrors
        the Stand-aside lane's data-theme-id wrapper (TS-R5 client-side auto-expand),
        which is part of the row's contract and not decoration. -#}
    {%- if _ab_rows_only -%}
    {%- for _L in ab_locked %}<div class="ab-locked" data-ab-lane="{{ _L.lane }}">
      {%- for x in _L.rows %}
        {%- if _L.get('wrap') and x.kind == 'theme' %}<div data-theme-id="{{ x.slug or x.ticker }}">{{ ab_theme_row(x) }}</div>
        {%- elif x.kind == 'theme' %}{{ ab_theme_row(x) }}
        {%- else %}{{ ab_sector_row(x) }}{% endif %}
      {%- endfor %}</div>
    {%- endfor -%}
    {%- else -%}
    {#- Lane count helpers -#}
    {%- set _bn_cnt = action_board.buy_now | length -%}
    {%- set _bs_cnt = action_board.buy_soon | length -%}
    {%- set _run_cnt = action_board.get('on_the_run', []) | length -%}
    {%- set _tp_cnt = action_board.take_profits | length -%}
    {%- set _hold_cnt = (action_board.hold | length) + (action_board.avoid | length) -%}
    {#- GATED SHELL SLICES. The `_*_cnt` figures above are counted off the FULL
        board and stay that way — the lane headings, and the "+N more" links, are
        honest totals a Free reader keeps. Only the ROW LISTS below are cut down.
        Stand aside is one .actbody fed by two arrays, so the preview budget is
        spent on `hold` first and `avoid` takes whatever is left; that keeps the
        combined visible count equal to the same `preview` every other lane gets. -#}
    {%- set _bn_rows  = action_board.buy_now[:_ab_pv] if _ab_gate else action_board.buy_now -%}
    {%- set _bs_rows  = action_board.buy_soon[:_ab_pv] if _ab_gate else action_board.buy_soon -%}
    {%- set _run_rows = action_board.get('on_the_run', [])[:_ab_pv] if _ab_gate else action_board.get('on_the_run', []) -%}
    {%- set _tp_rows  = action_board.take_profits[:_ab_pv] if _ab_gate else action_board.take_profits -%}
    {%- set _hold_rows = action_board.hold[:_ab_pv] if _ab_gate else action_board.hold -%}
    {%- set _av_pv = _ab_pv - (_hold_rows | length) -%}
    {%- set _avoid_rows = (action_board.avoid[:_av_pv] if _av_pv > 0 else []) if _ab_gate else action_board.avoid -%}
    {#- FIX 3: more-count helpers from basket_items; default 0 when absent -#}
    {%- set _ab_more = action_board.get('more') or {} -%}
    {%- set _more_bn = _ab_more.get('buy_now') or 0 -%}
    {%- set _more_bs = _ab_more.get('buy_soon') or 0 -%}
    {%- set _more_run = _ab_more.get('on_the_run') or 0 -%}
    {%- set _more_tp = _ab_more.get('take_profits') or 0 -%}
    {%- set _more_hold = (_ab_more.get('hold') or 0) + (_ab_more.get('avoid') or 0) -%}
    <div class="actiongrid">
      {#- ---- LANE 1: BUY NOW ---- -#}
      <div class="actcol act-buy">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-icon">{{ icon('target') }}</span>
            <span class="acth-name"><span class="l-en">Buy now</span><span class="l-zh">立即买入</span></span>
            <span class="acth-count">{{ _bn_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Entry confirmed today</span><span class="l-zh">今日已确认入场</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-buy-fold">
          {% for x in _bn_rows %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
          {% if _ab_gate and (action_board.get('buy_now') or [])|length > (_bn_rows|length) %}{{ ab_more((action_board.get('buy_now') or [])|length - (_bn_rows|length)) }}{% endif %}
          {%- if _more_bn > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_bn }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_bn }} 个 — 完整列表见行业情报页 →</span></a></p>{%- endif %}
        </div>
        {% if _bn_cnt > 3 and not _ab_gate %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bn_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 2: ALMOST READY (buy_soon) ---- -#}
      <div class="actcol act-soon">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-icon">{{ icon('clock') }}</span>
            <span class="acth-name"><span class="l-en">Almost ready</span><span class="l-zh">接近就绪</span></span>
            <span class="acth-count">{{ _bs_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Setting up — wait for the trigger, not a buy yet</span><span class="l-zh">构筑中 — 等待触发，尚不可买</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-soon-fold">
          {% for x in _bs_rows %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('No imminent setups.', '暂无临近的构筑。') }}</p>{% endfor %}
          {% if _ab_gate and (action_board.get('buy_soon') or [])|length > (_bs_rows|length) %}{{ ab_more((action_board.get('buy_soon') or [])|length - (_bs_rows|length)) }}{% endif %}
          {%- if _more_bs > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_bs }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_bs }} 个 — 完整列表见行业情报页 →</span></a></p>{%- endif %}
        </div>
        {% if _bs_cnt > 3 and not _ab_gate %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bs_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 3: IN FAVOUR — DON'T CHASE (on_the_run) ---- -#}
      <div class="actcol act-run">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-icon">{{ icon('accel') }}</span>
            <span class="acth-name"><span class="l-en">In favour — don't chase</span><span class="l-zh">看好 — 勿追高</span></span>
            <span class="acth-count">{{ _run_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Uptrend intact but extended · wait for a pullback</span><span class="l-zh">趋势完好但已延伸 · 等待回调</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-run-fold">
          {% for x in _run_rows %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('Nothing extended right now.', '当前无过度延伸的标的。') }}</p>{% endfor %}
          {% if _ab_gate and (action_board.get('on_the_run') or [])|length > (_run_rows|length) %}{{ ab_more((action_board.get('on_the_run') or [])|length - (_run_rows|length)) }}{% endif %}
          {%- if _more_run > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_run }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_run }} 个 — 完整列表见行业情报页 →</span></a></p>{%- endif %}
        </div>
        {% if _run_cnt > 3 and not _ab_gate %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _run_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 4: TAKE PROFITS ---- -#}
      <div class="actcol act-trim">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-icon">{{ icon('profits') }}</span>
            <span class="acth-name"><span class="l-en">Take profits</span><span class="l-zh">止盈</span></span>
            <span class="acth-count">{{ _tp_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Late in the cycle / topping — protect gains</span><span class="l-zh">周期晚期／做顶 — 保护利润</span></div>
        </div>
        <div class="actbody ab-trim-fold is-collapsed" id="ab-trim-fold">
          {% for x in _tp_rows %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('Nothing topping.', '无标的做顶。') }}</p>{% endfor %}
          {% if _ab_gate and (action_board.get('take_profits') or [])|length > (_tp_rows|length) %}{{ ab_more((action_board.get('take_profits') or [])|length - (_tp_rows|length)) }}{% endif %}
          {%- if _more_tp > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_tp }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_tp }} 个 — 完整列表见行业情报页 →</span></a></p>{%- endif %}
        </div>
        {% if _tp_cnt > 3 and not _ab_gate %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _tp_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 5: STAND ASIDE (hold + avoid; top 3 visible) ---- -#}
      {#- TS-R5: id="dash-hold-fold" PRESERVED — JS auto-expand on turn-watch match -#}
      <div class="actcol act-hold lst-wrap">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-icon">{{ icon('hold') }}</span>
            <span class="acth-name"><span class="l-en">Stand aside</span><span class="l-zh">观望</span></span>
            <span class="acth-count">{{ _hold_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Hold what you own · no new buying</span><span class="l-zh">持有勿动 · 不新开仓</span></div>
        </div>
        <div class="actbody lst-collapse lst-cap3 is-collapsed" id="dash-hold-fold">
          {% for x in _hold_rows %}
            {#- TS-R5: data-theme-id wrapper enables client-side auto-expand -#}
            {% if x.kind == 'theme' %}<div data-theme-id="{{ x.slug or x.ticker }}">{{ ab_theme_row(x) }}</div>{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% endfor %}
          {% for x in _avoid_rows %}
            {% if x.kind == 'theme' %}<div data-theme-id="{{ x.slug or x.ticker }}">{{ ab_theme_row(x) }}</div>{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% endfor %}
          {% if _ab_gate and _hold_cnt > ((_hold_rows|length) + (_avoid_rows|length)) %}{{ ab_more(_hold_cnt - (_hold_rows|length) - (_avoid_rows|length)) }}{% endif %}
          {%- if _more_hold > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_hold }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_hold }} 个 — 完整列表见行业情报页 →</span></a></p>{%- endif %}
        </div>
        {% if _hold_cnt > 3 and not _ab_gate %}
        <button class="lst-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more', '显示更多') }} ({{ _hold_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less', '收起') }} ▴</span></button>
        {% endif %}
      </div>
      {#- ---- WATCH STRIP: BOTTOMING WATCH (W-A, #4599; restored after #4642) ----
          Not a sixth action lane — a full-width watch strip under the five. Renders
          only where a bottoming payload is passed (the SI Overview); self-hides on
          us_stocks.html, whose action_board carries no bottoming keys. -#}
      {% include "_us_bottoming_watch.html.j2" %}
    </div>
  </div>{# /panel — What to act on now (standouts split into their own panel 2026-07-11) #}
{%- endif -%}
{% endif %}
