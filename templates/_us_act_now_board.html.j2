{% import "_decision_card.html.j2" as dc %}
{#- ====================== US ACT-NOW BOARD (v2, five lanes) ======================
   The mature sectors+themes action board, transplanted from us_stocks.html
   (#action-board, assembled by scripts/build_site.action_board()). SHARED include:
   rendered on us_stocks.html via dashboard.html.j2 AND on the US Sector Intelligence
   Overview (sector_central.html) via build_sector_central. Each host passes
   action_board=<dict>; build_site persists site/basketdata/action_board.json and
   build_sector_central reads it (reader pattern).

   Self-sufficient by design: it carries its own help/t/dispshort DISPLAY macros and
   the board CSS. tr()/td() come from the host Jinja env globals (i18n); the shared
   row-pop hover engine (theme.js) and the .rp-src/.row-pop/.lst-*/.help/.tip framework
   come from theme.css (both hosts link it). Every per-row field (sector_setup, EW
   overlay, two-reads) is pre-merged onto each item by action_board(), so the board
   needs nothing from the view-model but action_board (shock_state is optional/guarded). -#}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro dispshort(name) -%}
{%- set _n = name | string -%}
{%- set _abbr = {
  'Consumer Staples':'Cons Staples','Consumer Discretionary':'Cons Disc',
  'Communication Services':'Comm Services','Reshoring & Industrial Capex':'Industrial Capex',
} -%}
{%- set _base = _n | replace(' (Equal-Weight)','') -%}
{%- set _ew = ' (EW)' if ' (Equal-Weight)' in _n else '' -%}
{%- if _base in _abbr -%}{{ _abbr[_base] }}{{ _ew }}{%- else -%}{{ _base }}{{ _ew }}{%- endif -%}
{%- endmacro %}
{% if action_board %}
  {#- Decision-card component stylesheet (hover cards). dashboard.html.j2 emits this
     once at the page head for its other cards; on the SI Overview the board is the
     only dc.dc_card() consumer, so the include emits it. Duplicate emission is a
     harmless same-rules <style>. -#}
  {{ dc.dc_css() }}
  {#- Board CSS. These rules live inline in dashboard.html.j2 (NOT in the shared
     theme.css bundle) and ride HERE with the include ON PURPOSE: editing theme.css
     rehashes it and stales the ?v= cache-stamp on ~176 committed pages (render
     re-stamp chain / tests/test_unsubscribe_page.py). The .actcol/.actitem base rules
     already live in theme.css and are untouched; these are the board-specific
     overrides + lane/chip/row styling copied verbatim from dashboard.html.j2. -#}
  <style>
  /* action board */
  .actiongrid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; align-items: start; }
  @media (max-width: 1100px) { .actiongrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .actiongrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .actiongrid { grid-template-columns: minmax(0, 1fr); } }
  /* V2 action board — lane column card, restyled to the china anv2 lane idiom
     (operator request 2026-07-11): panel card, 14px radius, 3px accent bar inside
     the header, colored uppercase lane titles, chips-below-name rows.
     Class names unchanged — fold JS (.actcol/.actbody/.act-fold) and the View-all
     modal (.acth-name/.acth-sub) query them. */
  .actcol { background: var(--panel); border: 1px solid var(--line); min-width: 0;
            border-radius: 14px; padding: 0; overflow: hidden;
            display: flex; flex-direction: column; --act-accent: var(--muted); }
  /* --act-accent stays fill-grade for the lane bar; --act-accent-ink is the
     text-grade twin for .acth-name (violet measured 4.19:1 dark / 3.89 light). */
  .act-buy  { --act-accent: var(--up); --act-accent-ink: var(--ink-up, var(--up)); }
  .act-soon { --act-accent: var(--info); --act-accent-ink: var(--ink-info, var(--info)); }
  .act-run  { --act-accent: #8b5cf6; --act-accent-ink: color-mix(in srgb, #8b5cf6 80%, var(--text)); }   /* neutral violet — NOT green/buy */
  .act-trim { --act-accent: var(--warn); --act-accent-ink: var(--ink-warn, var(--warn)); }
  .act-hold { --act-accent: var(--muted); --act-accent-ink: var(--muted); }
  html[data-theme="light"] .act-run { --act-accent-ink: color-mix(in srgb, #8b5cf6 72%, var(--text)); }
  /* Lane header — accent top bar via ::before (anv2-lane-hd idiom) */
  .acth { padding: 10px 13px 8px; border-bottom: 1px solid var(--line); position: relative; }
  .acth::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
                  border-radius: 14px 14px 0 0; background: var(--act-accent); }
  .acth-title-row { display: flex; align-items: center; gap: 5px; }
  .acth-emoji { font-size: 13px; line-height: 1; flex: none; }
  .acth-name { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
               color: var(--act-accent-ink, var(--act-accent)); flex: 0 1 auto; min-width: 0;
               white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .acth-count { flex: none; font-size: 11px; font-weight: 400; color: var(--muted); }
  .acth-count::before { content: "("; } .acth-count::after { content: ")"; }
  .acth-sub { font-size: 10.5px; color: var(--muted); line-height: 1.4; margin-top: 3px; }
  /* Lane body list */
  .actbody { padding: 6px 0; flex: 1; }
  /* V2 row — anv2-row anatomy: name row on top, chips row below, stat line last */
  .actitem { display: block; padding: 7px 13px;
             border-bottom: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
             font-size: 13px; min-width: 0; overflow: hidden;
             text-decoration: none; color: inherit; cursor: pointer;
             transition: background 0.1s; position: relative; }
  .actitem:last-child { border-bottom: none; }
  .actitem:hover, .actitem:focus { background: color-mix(in srgb, var(--panel2) 55%, transparent); outline: none; }
  .actitem.hovered { background: color-mix(in srgb, var(--panel2) 80%, transparent); }
  .act-row-top { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .ai-bdg { font-size: 11.5px; flex: none; opacity: .85; cursor: default; }
  .act-row-name { flex: 1; min-width: 0; font-size: 12.5px; font-weight: 600; color: var(--text);
                  line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* theme composite score — anv2-score idiom (big number, right of the name) */
  .act-row-score { flex: none; font-size: 15px; font-weight: 800; font-variant-numeric: tabular-nums;
                   white-space: nowrap; }
  .act-score-hi  { color: var(--ink-up, var(--up)); }
  .act-score-mid { color: var(--ink-warn, var(--warn)); }
  .act-score-lo  { color: var(--ink-down, var(--down)); }
  /* V2 stat line — last line of the row; muted label, china-anv2-style colored value
     (var(--up)/var(--down) so the zh red/green flip rides along); hidden on mobile */
  .act-row-stat { display: block; font-size: 10.5px; color: var(--muted); line-height: 1.35; margin-top: 3px;
                  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .act-row-stat .up { color: var(--ink-up, var(--up)); font-weight: 600; }
  .act-row-stat .dn { color: var(--ink-down, var(--down)); font-weight: 600; }
  @media (max-width: 560px) { .act-row-stat { display: none; } }
  .act-row-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 3px; margin-top: 4px; }
  /* V2 action chip — anv2-chip idiom (uppercase 10px, 4px radius) */
  .ab-chip { font-size: 10px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase;
             padding: 2px 6px; border-radius: 4px; line-height: 15px; white-space: nowrap; flex: none; }
  .ab-chip--warn { background: color-mix(in srgb, var(--warn) 14%, transparent);
                   color: var(--ink-warn, var(--warn)); border: 1px solid color-mix(in srgb, var(--ink-warn, var(--warn)) 28%, transparent); }
  .ab-chip--pos  { background: color-mix(in srgb, var(--up) 14%, transparent);
                   color: var(--ink-up, var(--up)); border: 1px solid color-mix(in srgb, var(--ink-up, var(--up)) 28%, transparent); }
  .ab-chip--neg  { background: color-mix(in srgb, var(--down) 14%, transparent);
                   color: var(--ink-down, var(--down)); border: 1px solid color-mix(in srgb, var(--ink-down, var(--down)) 28%, transparent); }
  .ab-chip--info { background: color-mix(in srgb, var(--info) 14%, transparent);
                   color: var(--ink-info, var(--info)); border: 1px solid color-mix(in srgb, var(--ink-info, var(--info)) 28%, transparent); }
  .ab-chip--muted { background: color-mix(in srgb, var(--muted) 12%, transparent);
                    color: var(--muted); border: 1px solid color-mix(in srgb, var(--muted) 22%, transparent); }
  /* gate-override ✓ pill */
  .ab-chip--gate { background: color-mix(in srgb, var(--up) 10%, transparent);
                   color: var(--up); border: 1px solid color-mix(in srgb, var(--up) 22%, transparent);
                   font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px;
                   line-height: 15px; flex: none; cursor: help; }
  /* theme item star/check/lens glyphs */
  .ai-book { flex: none; margin-left: 4px; font-size: 10px; font-weight: 800; cursor: help;
             color: var(--up); white-space: nowrap; }
  .ai-val { flex: none; margin-left: 4px; font-size: 10.5px; font-weight: 800; color: var(--up); cursor: help; }
  .ai-lens { flex: none; margin-left: 4px; font-size: 11px; color: var(--muted); cursor: help; }
  /* theme item name */
  .actitem.ai-theme .act-row-name { font-weight: 700; }
  /* legacy chips kept for non-board uses */
  .ew-chip { display: none; }  /* hidden in V2 board; moved to popover */
  .acttag, .actage, .acteta, .eqmini { display: none; }  /* moved to popover in V2 */
  /* action-board rows opt in to the shared row-pop engine via [data-rpop] */
  /* .notable is its own .panel since 2026-07-11 — panel chrome carries the separation */
  /* keep legacy references alive for non-board code */
  .actitem b { color: var(--text); }
/* page-scoped fold — every V2 action lane shows only its top 3 rows initially */
.actbody.act-fold.is-collapsed > a.actitem:nth-child(n+4),
.actbody.act-fold.is-collapsed > div:nth-child(n+4) { display: none; }
/* Hide the Show-more button when the lane holds fewer rows than its cap.
   All five lanes now share the same top-three contract. */
.actcol:not(:has(.actbody.act-fold > a.actitem:nth-child(4))):not(:has(.actbody.act-fold > div:nth-child(4))):not(:has(.ab-trim-fold > a.actitem:nth-child(4))):not(:has(.ab-trim-fold > div:nth-child(4))) .lst-more.act-more { display: none; }
.ab-trim-fold.is-collapsed > a.actitem:nth-child(n+4),
.ab-trim-fold.is-collapsed > div:nth-child(n+4) { display: none; }
/* Stand-aside keeps its stable id and uses the shared cap-3 fold. */
.lst-collapse.lst-cap3.is-collapsed > a.actitem:nth-child(n+4),
.lst-collapse.lst-cap3.is-collapsed > div:nth-child(n+4) { display: none; }
  /* ── TS-R6: two-reads reconciliation chip ───────────────────────────────── */
  .two-reads-chip { display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:6px; font-size:10px; font-weight:600; white-space:nowrap; background:color-mix(in srgb,var(--info) 9%,var(--panel2)); border:1px solid color-mix(in srgb,var(--info) 28%,var(--line)); color:var(--info,var(--link)); cursor:help; }
  .two-reads-chip .tr-sep { opacity:.45; margin:0 2px; }
  /* ══ BOTTOM WATCH shelf (W-A #4599, amended #4614) ═══════════════════════════
     NOT a sixth lane. The five .actcol cards are raised surfaces you act FROM;
     this is a well recessed INTO the panel beneath them, so the eye files it as
     context rather than as a lane it forgot to read. Its header runs horizontally
     (label · count · stance on one line) where a lane header stacks, and the 3px
     rail on its left edge is the ratified "watch — don't chase" shelf marker from
     the Prophet basing shelf (#4609, dashboard.html.j2 .nb-stage-hd .sg-basing).

     ACCENT — direction-neutral by construction. Every lane hue is spoken for
     (up-green / info-blue / run-violet / warn-amber / muted-grey) and the two
     directional families (--up/--down, and everything derived from them) are
     remapped under the zh 红涨绿跌 convention — a watch shelf that changes meaning
     with the language switch would be a defect. #2aa2ae is a literal for exactly
     the reason .act-run's #8b5cf6 is: it must survive that remap untouched.
     (Verified: --up/--down swap between data-lang en/zh; every token below does
     not.) It reads as depth below a waterline — an instrument, not a verdict.
     Text-grade twins follow the --act-accent-ink precedent above. Measured with
     getComputedStyle against the surfaces each ink is actually painted on, every
     layer's alpha composited (dark / light): shelf title 9.15 / 6.16, turn figure
     8.81 / 6.68, turn chip 7.09 / 5.43, reduce-lane chip 7.06 / 5.65, gate chip
     4.78 / 4.51, depth + footnote 5.69 / 4.88. --bw-accent itself is fill-grade
     only (the rail), never text. */
  #action-board { --bw-accent: #2aa2ae; --bw-ink: #5ec6d4;
                  --bw-well: color-mix(in srgb, var(--bg) 62%, var(--panel)); }
  html[data-theme="light"] #action-board { --bw-accent: #0e7a86; --bw-ink: #0a646e;
                  --bw-well: color-mix(in srgb, var(--panel2) 88%, var(--panel)); }
  .bw-shelf { margin-top: 14px; padding: 11px 14px 12px; border-radius: 12px;
              background: var(--bw-well); border: 1px solid var(--line);
              box-shadow: inset 0 1px 2px rgba(0,0,0,.24); }
  html[data-theme="light"] .bw-shelf { box-shadow: inset 0 1px 2px rgba(20,32,64,.05); }
  .bw-hd { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 9px;
           position: relative; padding-left: 10px; margin-bottom: 9px; }
  .bw-hd::before { content: ''; position: absolute; left: 0; top: 2px; bottom: 2px; width: 3px;
                   border-radius: 999px; background: var(--bw-accent); }
  .bw-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
              color: var(--bw-ink); }
  html[data-lang="zh"] .bw-title { letter-spacing: 0; }
  .bw-count { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .bw-count::before { content: "("; } .bw-count::after { content: ")"; }
  .bw-sub { font-size: 10.5px; color: var(--muted); line-height: 1.4; }
  /* auto-fill (not auto-fit): a two-name shelf stays a two-card shelf instead of
     stretching into two half-page slabs. A short night should look short. */
  .bw-rows { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
             gap: 8px; align-items: start; }
  .bw-card { display: block; padding: 8px 10px 9px; border-radius: 9px; min-width: 0;
             background: color-mix(in srgb, var(--panel) 72%, transparent);
             border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
             text-decoration: none; color: inherit;
             transition: background .12s ease, border-color .12s ease; }
  /* light: a white card on the deeper well needs its own edge + lift, or the two
     near-whites read as one flat surface (doctrine §5.8 panel-on-canvas rule). */
  html[data-theme="light"] .bw-card { border-color: var(--line); box-shadow: var(--card-shadow); }
  a.bw-card:hover { background: var(--panel);
                    border-color: color-mix(in srgb, var(--bw-accent) 42%, var(--line)); }
  a.bw-card:focus-visible { background: var(--panel); outline: 2px solid var(--link); outline-offset: 2px; }
  .bw-top { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .bw-mark { flex: none; font-size: 11.5px; opacity: .85; }
  .bw-name { flex: 1; min-width: 0; font-size: 12.5px; font-weight: 600; color: var(--text);
             line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bw-turn { flex: none; font-size: 10.5px; font-weight: 700; font-variant-numeric: tabular-nums;
             color: var(--bw-ink); cursor: help; }
  /* the sounding rail — the shelf's one non-verbal encoding. An HONEST shared
     scale: every row is drawn on the same 0→100 cycle-range track, so a shelf of
     markers all hugging the left IS the statement "these are at the floor", and a
     row further up its range visibly sits further right. Never a magnitude bar
     comparing rows against each other (the vetoed ftr-tape idiom). */
  .bw-gauge { display: flex; align-items: center; gap: 8px; margin-top: 6px; cursor: help; }
  .bw-rail { flex: none; position: relative; width: 62px; height: 5px; border-radius: 999px;
             background: color-mix(in srgb, var(--muted) 30%, transparent);
             box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--muted) 16%, transparent); }
  .bw-rail-fill { position: absolute; left: 0; top: 0; bottom: 0; min-width: 5px;
                  border-radius: 999px; background: var(--bw-accent);
                  box-shadow: 0 0 0 2px color-mix(in srgb, var(--bw-accent) 22%, transparent); }
  /* honest null slot: no reading tonight draws a hatched empty track, never a zero */
  .bw-rail--none { background: repeating-linear-gradient(90deg,
                     color-mix(in srgb, var(--muted) 34%, transparent) 0 2px, transparent 2px 5px); }
  .bw-depth { min-width: 0; font-size: 10.5px; color: var(--muted); line-height: 1.35;
              white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bw-depth b { color: var(--text); font-weight: 700; font-variant-numeric: tabular-nums; }
  /* These two strings are SENTENCES, not labels, so they take the board's
     .two-reads-chip register (10px / 600 / sentence case) rather than the shouting
     uppercase .ab-chip one. Setting a sentence in caps is what makes a watch-only
     line read as an alarm. */
  .bw-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 7px; }
  .bw-chip { font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 6px;
             line-height: 16px; cursor: help; }
  .bw-chip--turn { background: color-mix(in srgb, var(--bw-accent) 15%, transparent);
                   color: var(--bw-ink);
                   border: 1px solid color-mix(in srgb, var(--bw-accent) 32%, transparent); }
  /* the trend gate is a condition NOT met, not a danger — neutral grey keeps the
     amber reserved for Take profits, one aisle up. */
  .bw-chip--gate { background: color-mix(in srgb, var(--muted) 12%, transparent); color: var(--muted);
                   border: 1px solid color-mix(in srgb, var(--muted) 26%, transparent); }
  .bw-none { margin: 0; padding: 5px 2px 3px; font-size: 12px; color: var(--muted); }
  .bw-foot { margin: 9px 0 0; padding-top: 8px; font-size: 10.5px; line-height: 1.5;
             color: var(--muted);
             border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
  /* the shelf's chip on a reduce-side lane row — same family, so a reader connects
     the chip above to the shelf below without a legend. */
  .ab-chip--bw { background: color-mix(in srgb, var(--bw-accent) 14%, transparent);
                 color: var(--bw-ink); cursor: help;
                 border: 1px solid color-mix(in srgb, var(--bw-accent) 30%, transparent); }
  @media (max-width: 560px) { .bw-shelf { padding: 10px 11px 11px; } .bw-rows { gap: 7px; } }
  @media (prefers-reduced-motion: reduce) { .bw-card { transition: none; } }
  </style>
  <div class="panel span12" id="action-board">
    <h2>{{ t('What to act on now', '当前可操作') }}
      {{ help('Every sector and theme is sorted into five lanes by cycle position — the lane name is the action, and each lane explains itself below its title. Hover any row for full detail. Symbols: 🏛 sector fund · 🧩 theme group · ✓ tested sell-discipline gate (overrides the lane read when it fires) · ★ in the model book.', '所有板块与主题按周期位置分入五个泳道 — 泳道名称即操作建议，各泳道标题下有说明。悬停任意行查看完整详情。图例：🏛 板块基金 · 🧩 主题篮子 · ✓ 经回测的卖出纪律门槛（触发时覆盖泳道判读）· ★ 模型组合内。') }}
      <a href="sector_central.html#actnow-section" style="font-size:11px;color:var(--muted);font-weight:400;text-decoration:none;margin-left:8px"><span class="l-en">Theme reasons → Sector Intelligence</span><span class="l-zh">主题详情 → 行业智慧页</span></a>
    </h2>
    {# Policy-shock de-escalation fresh-entry caution chip (PS-R3: display de-escalation only —
       no reordering, no removal. Ranks computed on pre-shock data; this chip is the only change.) #}
    {% if shock_state is defined and shock_state and shock_state.get('active') %}
    <div style="margin:6px 0 10px;padding:8px 12px;border-radius:8px;border-left:4px solid var(--warn);background:color-mix(in srgb,var(--warn) 12%,var(--panel2));font-size:13px;font-weight:600">
      ⚠ <span class="l-en">SHOCK active — fresh entries carry extra uncertainty; sector ranks computed on pre-shock data. Context only — no ranks have been changed. Active until {{ shock_state.get('expires', '') }}.</span><span class="l-zh">冲击期间 — 新进场具有额外不确定性；板块排名基于冲击前数据计算。仅供参考，排名未作调整，有效期至 {{ shock_state.get('expires', '') }}。</span>
    </div>
    {% endif %}
    {# Unified board: 🧩 narrative baskets (the AI-buildout-vs-rest resolution) lead each
       lane, 🏛 GICS sectors follow. Basket buys carry a leadership-LENS marker (≈, descriptive)
       and basket reduces a backtested marker (✓, the absolute-trend drawdown gate); ★ = in the
       narrative-rotation model book. #}
    {# (legacy themeitem / themeitem_run row macros removed 2026-07-11 — dead since the
       V2 board switched every lane to ab_theme_row / ab_sector_row.) #}
    {# TS-R6 A2: two-reads chip for action-board sector rows (same ETF, two house reads disagree). #}
    {% macro ab_two_reads(x) -%}{% if x.get('two_reads_chip') %}{% set _abtr = x.two_reads_chip %}<span class="two-reads-chip" data-tip-en="Two house reads on {{ x.ticker }}: cycle timing = {{ _abtr.cycle_label_en }} (slow, cap-weighted); setup engine = {{ _abtr.setup_label_en }} (3-day tactical). Different instruments / different horizons — both shown, neither overrides." data-tip-zh="{{ x.ticker }} 两个本系统读数：周期 = {{ _abtr.cycle_label_en }}（慢速市值加权）；形态 = {{ _abtr.setup_label_en }}（3日战术）。不同工具／维度，同时显示。"><span class="tr-sep">⇔</span><span class="l-en">two reads: cycle <b>{{ _abtr.cycle_label_en }}</b> vs setup <b>{{ _abtr.setup_label_en }}</b></span><span class="l-zh">两个读数：周期 <b>{{ _abtr.cycle_label_en }}</b> vs 形态 <b>{{ _abtr.setup_label_en }}</b></span></span>{% endif %}{%- endmacro %}
    {# FIX 2: EW-vs-cycle disclosure chip for sector rows — fires when EW and cycle disagree (buy vs reduce) and gate_override did NOT fire. #}
    {% macro ab_ew_two_reads(x) -%}{% if x.get('ew_two_reads') %}{% set _ewtr = x.ew_two_reads %}<span class="two-reads-chip" data-tip-en="Two reads on {{ x.ticker }}: cycle timing = {{ _ewtr.cycle_label_en }}; equal-weight basket = {{ _ewtr.ew_label_en }}. Different constructions — both shown for context." data-tip-zh="{{ x.ticker }} 两个读数：周期 = {{ _ewtr.cycle_label_zh }}；等权篮子 = {{ _ewtr.ew_label_zh }}。不同构建方式，同时显示供参考。"><span class="tr-sep">⇔</span><span class="l-en">two reads: cycle <b>{{ _ewtr.cycle_label_en }}</b> vs equal-weight <b>{{ _ewtr.ew_label_en }}</b></span><span class="l-zh">两个读数：周期 <b>{{ _ewtr.cycle_label_zh }}</b> vs 等权 <b>{{ _ewtr.ew_label_zh }}</b></span></span>{% endif %}{%- endmacro %}
    {# ew_chip is inlined below each sector row for Jinja2 lexer compatibility. #}
    {#- V2 ACTION BOARD — new lane design (adjudicated 2026-07-10)
        Each lane: header (emoji + EN/ZH name + count + subtitle) + row list.
        Sector rows: glyph + name + optional chip + optional gate-✓ + stat line.
        Theme rows: name + star/check/lens glyphs (% moves to popover).
        Popover data stored in hidden .rp-src span, cloned by theme.js row-pop engine on hover.
        Folds: every lane shows its top three rows, then offers Show more.
        TS-R5 dash-hold-fold id PRESERVED on the stand-aside column.
    -#}
    {#- ---- Jinja macros for V2 rows ---- -#}
    {%- macro ab_chip(chip_en, chip_zh, chip_tone) -%}
    {%- if chip_en %}<span class="ab-chip ab-chip--{{ chip_tone }}"><span class="l-en">{{ chip_en }}</span><span class="l-zh">{{ chip_zh }}</span></span>{% endif -%}
    {%- endmacro -%}
    {%- macro ab_gate(x) -%}
    {%- if x.get('gate_override') %}<span class="ab-chip--gate" data-tip-en="Backtested drawdown-control gate fired — overrides the raw cycle read. Equal-weight basket: {{ x.get('ew', {}).get('label', '') }}" data-tip-zh="经回测的回撤控制门槛触发 — 覆盖原始周期判读。等权篮子：{{ x.get('ew', {}).get('label_zh', '') or x.get('ew', {}).get('label', '') }}">&#10003;</span>{% endif -%}
    {%- endmacro -%}
    {#- Bottom-watch chip for a REDUCE-SIDE row (take profits / stand aside).
        Two disjoint id sets, two different sentences, never both (the assembler
        guarantees the disjointness; this only has to pick one):
          dual_read_ids  — the row is ALSO on the shelf below (FT-R1)
          recovering_ids — the cycle read has it off its low but it has left the
                           shelf, so it is on no lane at all (#4614 graduation gap)
        One-extra-chip rule: a row that already carries the demotion chip keeps
        just that one — two amber-and-teal chips on a three-line row is noise, and
        the demotion is the more actionable of the two. The recovering wording is
        QUOTED from the engine authority block so the page cannot drift from the
        measured basis; absent keys (an artifact built before #4614) render nothing. -#}
    {%- macro ab_bw_chip(x, reduce_side, rid) -%}
    {%- if reduce_side and rid and not x.get('conflict_chip_en') -%}
    {%- set _bwauth = action_board.get('bottoming_authority') or {} -%}
    {%- if rid in (action_board.get('dual_read_ids') or []) -%}
    <span class="ab-chip ab-chip--bw" data-tip-en="The longer trend still says reduce, but the cycle read shows a low forming. This name is also on Bottom watch below — both reads are shown so you can see the disagreement." data-tip-zh="长期趋势仍建议减仓，但周期读数显示底部正在形成。该名称同时出现在下方筑底观察——两种判读并列显示，便于看清分歧。"><span class="l-en">may be bottoming</span><span class="l-zh">或正筑底</span></span>
    {%- elif rid in (action_board.get('recovering_ids') or []) and _bwauth.get('recovering_chip_en') -%}
    <span class="ab-chip ab-chip--bw" data-tip-en="{{ _bwauth.get('recovering_tip_en', '') }}" data-tip-zh="{{ _bwauth.get('recovering_tip_zh') or _bwauth.get('recovering_tip_en', '') }}"><span class="l-en">{{ _bwauth.get('recovering_chip_en') }}</span><span class="l-zh">{{ _bwauth.get('recovering_chip_zh') or _bwauth.get('recovering_chip_en') }}</span></span>
    {%- endif -%}
    {%- endif -%}
    {%- endmacro -%}
    {#- Popover source for a SECTOR row (hidden inline, cloned by JS) -#}
    {#- Compact decision card for a SECTOR row. Keep this payload intentionally
        glanceable: one setup read, at most three decision metrics, one visual timing
        cue, and one short takeaway. Full model prose belongs on the linked detail page.
        DO NOT REBUILD LAW #1513: FRESH BUY is the worst state on the board (not a buy
        edge); its state tag is warn, never green/up. -#}
    {%- macro ab_sector_pop(x) -%}
    {%- set _reduce_labels = ['TOP WATCH','ROLLING OVER','DECLINE','COUNTERTREND BOUNCE'] -%}
    {%- set _warn_labels = ['FRESH BUY','BOTTOM WATCH','NEARING A LOW','BOTTOMING','BASING','ACCUMULATION'] -%}
    {%- set _up_labels = ['RALLY ON','TURN SIGNALED','UPTREND','BUY ZONE'] -%}
    {%- set _lbl = x.get('label', '') -%}
    {%- set _stag_tone = 'dn' if _lbl in _reduce_labels else ('warn' if _lbl in _warn_labels else ('up' if _lbl in _up_labels else '')) -%}
    {%- set _stats = [] -%}
    {%- if x.get('rs_60d') is not none and x.get('rs_60d') is defined -%}
      {%- set _ = _stats.append({'label': ('60d lead','60日领先'), 'val': '%+.1f%%'|format(x.rs_60d),
                                 'tone': 'up' if x.rs_60d >= 0 else 'dn', 'sub': ('vs SPY','相对SPY')}) -%}
    {%- endif -%}
    {%- if x.get('eq_badge') -%}
      {%- set _ = _stats.append({'label': ('Entry','入场'), 'val': x.eq_badge,
                                 'tone': 'up' if x.eq_dir == 'up' else ('dn' if x.eq_dir == 'down' else ''),
                                 'sub': ('timing quality','时机质量')}) -%}
    {%- endif -%}
    {%- if x.get('buy_zone') is not none and x.get('n_holdings') -%}
      {%- set _ = _stats.append({'label': ('Breadth','广度'), 'val': '%d/%d'|format(x.buy_zone, x.n_holdings),
                                 'sub': ('in buy zone','处于买入区')}) -%}
    {%- endif -%}
    {%- set _bars = [] -%}
    {%- if x.get('rsi_3d') is not none and x.get('rsi_3d') is defined and x.get('stoch_3d') is not none and x.get('stoch_3d') is defined -%}
      {%- set _ = _bars.append({'label': 'RSI', 'pct': x.rsi_3d, 'val': '%.0f'|format(x.rsi_3d)}) -%}
      {%- set _ = _bars.append({'label': 'STO', 'pct': x.stoch_3d, 'val': '%.0f'|format(x.stoch_3d)}) -%}
    {%- endif -%}
    {%- set _sub_en -%}
    {%- if x.get('age_short') %}Signal {{ x.age_short }}{% endif -%}
    {%- if x.get('age_short') and x.get('dc_day') is not none and x.get('dc_day') is defined %} · {% endif -%}
    {%- if x.get('dc_day') is not none and x.get('dc_day') is defined %}cycle day {{ x.dc_day }}{% endif -%}
    {%- endset -%}
    {%- set _sub_zh -%}
    {%- if x.get('age_short') %}信号 {{ x.get('age_short_zh', x.age_short) }}{% endif -%}
    {%- if x.get('age_short') and x.get('dc_day') is not none and x.get('dc_day') is defined %} · {% endif -%}
    {%- if x.get('dc_day') is not none and x.get('dc_day') is defined %}周期第 {{ x.dc_day }} 日{% endif -%}
    {%- endset -%}
    {{ dc.dc_card({
      'kind': 'sector', 'mark': '🏛', 'tone': _stag_tone,
      'eyebrow': ('Sector pulse · ' ~ x.ticker, '板块脉搏 · ' ~ x.ticker),
      'name': (x.name|e, tr(x.name)|e),
      'tag': (td(x.label),),
      'kicker': ('Current setup','当前形态'),
      'read': ('Trend confirmed','趋势已确认') if _lbl in _up_labels
              else (('Early turn','早期转向') if _lbl in _warn_labels
              else (('Momentum fading','动能转弱') if _lbl in _reduce_labels
              else ('Wait for clarity','等待明朗'))),
      'sub': (_sub_en|trim, _sub_zh|trim),
      'bars': _bars, 'stats': _stats,
      'takeaway': ('Signals disagree. Keep size small until they align.','信号不一致，等待同步前保持小仓位。')
              if (x.get('two_reads_chip') or x.get('ew_two_reads') or x.get('conflict_reason_en'))
              else (('Trend confirmed — use pullbacks instead of chasing.','趋势已确认 — 等回调，不追高。') if _lbl in _up_labels
              else (('Early turn — keep size measured while the weekly trend catches up.','早期转向 — 周线趋势确认前控制仓位。') if _lbl in _warn_labels
              else (('Momentum is fading — protect gains and avoid fresh adds.','动能转弱 — 保护利润，避免加仓。') if _lbl in _reduce_labels
              else ('No clean edge yet — wait for the signals to align.','暂无清晰优势 — 等待信号同步。')))),
      'foot': ('Click row for the full sector view','点击查看完整板块详情'),
      'foot_b': (x.ticker ~ ' ↗', x.ticker ~ ' ↗'),
    }) }}
    {%- endmacro -%}
    {#- Compact decision card for a THEME (narrative basket) row. Opaque diagnostics
        (flip distance, duplicate percentiles, full engine prose) stay on the detail page. -#}
    {%- macro ab_theme_pop(x) -%}
    {%- set _reco = x.get('reco', '') -%}
    {%- set _rtone = 'dn' if _reco in ('trim','avoid') else ('up' if _reco in ('accumulate','enter') else 'warn') -%}
    {%- set _stats = [] -%}
    {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined -%}
      {%- set _ = _stats.append({'label': ('20d lead','20日领先'), 'val': '%+.1f%%'|format(x.perf_20d_rel * 100),
                                 'tone': 'up' if x.perf_20d_rel >= 0 else 'dn', 'sub': ('vs market','相对市场')}) -%}
    {%- endif -%}
    {%- if x.get('breadth_pct50') is not none and x.get('breadth_pct50') is defined -%}
      {%- set _ = _stats.append({'label': ('Breadth','广度'), 'val': '%.0f%%'|format(x.breadth_pct50 * 100),
                                 'sub': ('above 50d','高于50日线')}) -%}
    {%- endif -%}
    {%- if x.get('rollover_band') is not none and x.get('rollover_band') is defined -%}
      {%- set _ = _stats.append({'label': ('Rollover','回落风险'),
                                 'val': (x.rollover_band|title, x.get('rollover_band_zh', x.rollover_band)),
                                 'tone': 'up' if x.rollover_band == 'low' else 'warn', 'sub': ('risk','风险')}) -%}
    {%- endif -%}
    {%- set _trust = [] -%}
    {%- if x.get('book_wt') is not none and x.get('book_wt') is defined -%}
      {%- set _ = _trust.append({'tone': 'up', 'en': '★ Model ' ~ '%.0f'|format(x.book_wt*100) ~ '%',
                                 'zh': '★ 模型 ' ~ '%.0f'|format(x.book_wt*100) ~ '%'}) -%}
    {%- endif -%}
    {%- if x.validated -%}
      {%- set _ = _trust.append({'tone': 'up', 'en': '✓ Risk gate', 'zh': '✓ 风险门槛'}) -%}
    {%- endif -%}
    {{ dc.dc_card({
      'kind': 'theme', 'mark': '◆', 'tone': _rtone,
      'eyebrow': ('Theme basket','主题篮子'),
      'name': (x.name|e, (x.name_zh or x.name)|e),
      'tag': (x.get('label') or _reco, x.get('label_zh') or x.get('label') or _reco),
      'score': x.get('score') if (x.get('score') is not none and x.get('score') is defined) else none,
      'kicker': ('Leadership read','领先度判断'),
      'read': ('Broad and leading','广泛领先') if _reco in ('accumulate','enter')
              else (('Late and extended','后期且延伸') if _reco == 'trim'
              else (('Breadth weakening','广度转弱') if _reco == 'avoid'
              else ('Trend intact','趋势完好'))),
      'trust': _trust, 'stats': _stats,
      'leaders': {'label': ('Leaders','龙头'), 'val': x.top_members[:3] | join(' · ')} if x.get('top_members') else none,
      'takeaway': ('Signals disagree. Wait for breadth and price to align.','信号不一致，等待广度与价格同步。')
              if x.get('conflict_reason_en')
              else (('Leadership is broad. Add on pullbacks, not into strength.','领先面广。回调时加仓，不要追强势。') if _reco in ('accumulate','enter')
              else (('Momentum is extended. Protect gains into strength.','动能已过度延伸。逢强保护利润。') if _reco == 'trim'
              else (('Breadth is fading. Stand aside until it turns again.','广度转弱。在重新转强之前先观望。') if _reco == 'avoid'
              else ('Trend is intact. Wait for a cleaner entry.','趋势完好。等待更干净的入场点。')))),
      'foot': ('Click row for holdings and full history','点击查看持仓与完整历史'),
      'foot_b': ('Open ↗','打开 ↗'),
    }) }}
    {%- endmacro -%}
    {#- V2 sector row macro — anv2-row anatomy (name row / chips row / stat line) -#}
    {%- macro ab_sector_row(x, reduce_side=false) -%}
    {#- reduce_side: set at the take-profits / stand-aside call sites so the row can
        carry the bottom-watch chip. Default false — the buy-side lanes are untouched. -#}
    {%- set _bwchip = ab_bw_chip(x, reduce_side, (x.get('ticker') or '')|lower) -%}
    <a class="actitem" data-rpop href="{{ x.href }}">
      <span class="act-row-top">
        <span class="ai-bdg">🏛</span>
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ tr(x.name)|e }}</span></span>
      </span>
      {%- if x.get('chip_en') or x.get('gate_override') or x.get('ew_two_reads') or x.get('conflict_chip_en') or _bwchip|trim %}
      <span class="act-row-chips">
        {{- ab_chip(x.get('chip_en',''), x.get('chip_zh',''), x.get('chip_tone','muted')) -}}
        {{- ab_gate(x) -}}
        {{- ab_ew_two_reads(x) -}}
        {#- W2b/W4 demotion receipt lifted from the EW overlay (MLC-R7) -#}
        {{- ab_chip(x.get('conflict_chip_en',''), x.get('conflict_chip_zh', x.get('conflict_chip_en','')), 'warn') -}}
        {{- _bwchip -}}
      </span>
      {%- endif %}
      {%- if x.get('stat_en') %}<span class="act-row-stat"><span class="l-en">{{ x.stat_en }}</span><span class="l-zh">{{ x.get('stat_zh', x.stat_en) }}</span></span>{%- endif %}
      {{ ab_sector_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- V2 theme (narrative basket) row macro — composite score rides the name row;
        provenance glyphs (★ book / ✓ gate / ≈ lens / ⟳ run-reason) sit inline after
        the name instead of an orphan chips line; china-style 20d-vs-market stat. -#}
    {%- macro ab_theme_row(x, reduce_side=false) -%}
    {%- set _bwchip = ab_bw_chip(x, reduce_side, x.get('slug') or '') -%}
    <a class="actitem ai-theme" data-rpop href="{{ x.href }}">
      <span class="act-row-top">
        <span class="ai-bdg">🧩</span>
        <span class="act-row-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
        {%- if x.get('book_wt') %}<span class="ai-book" data-tip-en="In the narrative-rotation model book at {{ '%.0f'|format(x.book_wt*100) }}% — clears the backtested absolute-trend gate" data-tip-zh="已在叙事轮动模型组合中，权重 {{ '%.0f'|format(x.book_wt*100) }}%，通过经回测的绝对趋势门槛">&#9733;{{ '%.0f'|format(x.book_wt*100) }}%</span>{%- endif %}
        {%- if x.validated %}<span class="ai-val" data-tip-en="Backtested risk side — absolute-trend / fading-deteriorating drawdown gate" data-tip-zh="经回测的风险侧 — 绝对趋势／衰退-恶化回撤门槛">&#10003;</span>{%- else %}<span class="ai-lens" data-tip-en="Leadership LENS — descriptive; cross-sectional momentum rank-IC &asymp;0" data-tip-zh="领先度透镜 — 描述性；横截面动量 rank-IC&asymp;0">&asymp;</span>{%- endif %}
        {%- if x.get('run_reason_en') %}<span class="ai-lens" data-tip-en="{{ x.run_reason_en }}" data-tip-zh="{{ x.get('run_reason_zh', x.run_reason_en) }}">&#8635;</span>{%- endif %}
        {%- if x.get('score') is not none and x.get('score') is defined %}{%- set _sc = x.score -%}
        <span class="act-row-score{% if _sc >= 60 %} act-score-hi{% elif _sc >= 40 %} act-score-mid{% else %} act-score-lo{% endif %}">{{ '%.0f'|format(_sc) }}</span>
        {%- endif %}
      </span>
      {#- FIX 1: conflict chip (warn tone) when theme was demoted from buy lanes -#}
      {%- if x.get('conflict_chip_en') or _bwchip|trim %}
      <span class="act-row-chips">
        {{- ab_chip(x.conflict_chip_en, x.get('conflict_chip_zh', x.conflict_chip_en), 'warn') -}}
        {{- _bwchip -}}
      </span>
      {%- endif %}
      {%- if x.get('perf_20d_rel') is not none and x.get('perf_20d_rel') is defined %}
      <span class="act-row-stat"><span class="{{ 'up' if x.perf_20d_rel >= 0 else 'dn' }}">{{ '%+.1f'|format(x.perf_20d_rel * 100) }}%</span> <span class="l-en">20d vs market</span><span class="l-zh">20日对比市场</span></span>
      {%- endif %}
      {{ ab_theme_pop(x) }}
    </a>
    {%- endmacro -%}
    {#- Lane count helpers -#}
    {%- set _bn_cnt = action_board.buy_now | length -%}
    {%- set _bs_cnt = action_board.buy_soon | length -%}
    {%- set _run_cnt = action_board.get('on_the_run', []) | length -%}
    {%- set _tp_cnt = action_board.take_profits | length -%}
    {%- set _hold_cnt = (action_board.hold | length) + (action_board.avoid | length) -%}
    {#- FIX 3: more-count helpers from basket_items; default 0 when absent -#}
    {%- set _ab_more = action_board.get('more') or {} -%}
    {%- set _more_bn = _ab_more.get('buy_now') or 0 -%}
    {%- set _more_bs = _ab_more.get('buy_soon') or 0 -%}
    {%- set _more_run = _ab_more.get('on_the_run') or 0 -%}
    {%- set _more_tp = _ab_more.get('take_profits') or 0 -%}
    {%- set _more_hold = (_ab_more.get('hold') or 0) + (_ab_more.get('avoid') or 0) -%}
    <div class="actiongrid">
      {#- ---- LANE 1: BUY NOW ---- -#}
      <div class="actcol act-buy">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🟢</span>
            <span class="acth-name"><span class="l-en">Buy now</span><span class="l-zh">立即买入</span></span>
            <span class="acth-count">{{ _bn_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Entry confirmed today</span><span class="l-zh">今日已确认入场</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-buy-fold">
          {% for x in action_board.buy_now %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('None today — nothing has fully confirmed a fresh cycle low.', '今日无 — 尚无标的完全确认新的周期低点。') }}</p>{% endfor %}
          {%- if _more_bn > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_bn }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_bn }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _bn_cnt > 3 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bn_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 2: ALMOST READY (buy_soon) ---- -#}
      <div class="actcol act-soon">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🔵</span>
            <span class="acth-name"><span class="l-en">Almost ready</span><span class="l-zh">接近就绪</span></span>
            <span class="acth-count">{{ _bs_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Setting up — wait for the trigger, not a buy yet</span><span class="l-zh">构筑中 — 等待触发，尚不可买</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-soon-fold">
          {% for x in action_board.buy_soon %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('No imminent setups.', '暂无临近的构筑。') }}</p>{% endfor %}
          {%- if _more_bs > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_bs }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_bs }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _bs_cnt > 3 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _bs_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 3: IN FAVOUR — DON'T CHASE (on_the_run) ---- -#}
      <div class="actcol act-run">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🏃</span>
            <span class="acth-name"><span class="l-en">In favour — don't chase</span><span class="l-zh">看好 — 勿追高</span></span>
            <span class="acth-count">{{ _run_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Uptrend intact but extended · wait for a pullback</span><span class="l-zh">趋势完好但已延伸 · 等待回调</span></div>
        </div>
        <div class="actbody act-fold is-collapsed" id="ab-run-fold">
          {% for x in action_board.get('on_the_run', []) %}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x) }}{% else %}{{ ab_sector_row(x) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('Nothing extended right now.', '当前无过度延伸的标的。') }}</p>{% endfor %}
          {%- if _more_run > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_run }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_run }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _run_cnt > 3 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _run_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 4: TAKE PROFITS ---- -#}
      <div class="actcol act-trim">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">🟠</span>
            <span class="acth-name"><span class="l-en">Take profits</span><span class="l-zh">止盈</span></span>
            <span class="acth-count">{{ _tp_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Late in the cycle / topping — protect gains</span><span class="l-zh">周期晚期／做顶 — 保护利润</span></div>
        </div>
        <div class="actbody ab-trim-fold is-collapsed" id="ab-trim-fold">
          {% for x in action_board.take_profits %}
            {# reduce_side=true: this lane may carry the bottom-watch chip (FT-R1 / #4614) #}
            {% if x.kind == 'theme' %}{{ ab_theme_row(x, true) }}{% else %}{{ ab_sector_row(x, true) }}{% endif %}
          {% else %}<p class="muted sm" style="padding:8px 12px">{{ t('Nothing topping.', '无标的做顶。') }}</p>{% endfor %}
          {%- if _more_tp > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_tp }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_tp }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _tp_cnt > 3 %}<button class="lst-more act-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more','显示更多') }} ({{ _tp_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
      {#- ---- LANE 5: STAND ASIDE (hold + avoid; top 3 visible) ---- -#}
      {#- TS-R5: id="dash-hold-fold" PRESERVED — JS auto-expand on turn-watch match -#}
      <div class="actcol act-hold lst-wrap">
        <div class="acth">
          <div class="acth-title-row">
            <span class="acth-emoji">⚪</span>
            <span class="acth-name"><span class="l-en">Stand aside</span><span class="l-zh">观望</span></span>
            <span class="acth-count">{{ _hold_cnt }}</span>
          </div>
          <div class="acth-sub"><span class="l-en">Hold what you own · no new buying</span><span class="l-zh">持有勿动 · 不新开仓</span></div>
        </div>
        <div class="actbody lst-collapse lst-cap3 is-collapsed" id="dash-hold-fold">
          {% for x in action_board.hold %}
            {#- TS-R5: data-theme-id wrapper enables client-side auto-expand -#}
            {# reduce_side=true: this lane may carry the bottom-watch chip (FT-R1 / #4614) #}
            {% if x.kind == 'theme' %}<div data-theme-id="{{ x.slug or x.ticker }}">{{ ab_theme_row(x, true) }}</div>{% else %}{{ ab_sector_row(x, true) }}{% endif %}
          {% endfor %}
          {% for x in action_board.avoid %}
            {% if x.kind == 'theme' %}<div data-theme-id="{{ x.slug or x.ticker }}">{{ ab_theme_row(x, true) }}</div>{% else %}{{ ab_sector_row(x, true) }}{% endif %}
          {% endfor %}
          {%- if _more_hold > 0 %}<p class="muted sm" style="padding:4px 12px 8px"><a href="sector_central.html#actnow-section"><span class="l-en">+{{ _more_hold }} more — full list on Sector Intelligence →</span><span class="l-zh">还有 {{ _more_hold }} 个 — 完整列表见行业智慧页 →</span></a></p>{%- endif %}
        </div>
        {% if _hold_cnt > 3 %}
        <button class="lst-more" type="button" aria-expanded="false" style="margin:6px 10px 8px;width:calc(100% - 20px)"><span class="lm-show">{{ t('Show more', '显示更多') }} ({{ _hold_cnt - 3 }}) ▾</span><span class="lm-hide">{{ t('Show less', '收起') }} ▴</span></button>
        {% endif %}
      </div>
    </div>
    {#- ══ BOTTOM WATCH shelf (W-A #4599, amended #4614) ═════════════════════════
        Restores the fifth surface of the pre-#4642 board. Deliberately NOT a sixth
        grid column: these names have no action attached, so giving them a lane
        beside "Buy now" would read as a sixth thing to do. They sit BELOW every
        lane on their own shelf — the W-E basing-shelf semantics (#4609).

        Renders whenever the key is PRESENT, including as an empty list: "nothing
        is basing tonight" is a real read, and a shelf that vanishes on quiet
        nights teaches the reader it is optional. Key absent entirely (an
        action_board.json persisted before this wiring) → no shelf at all, and the
        five lanes above render exactly as they did.

        Every rendered string here is watch vocabulary; `signal` and `timing_state`
        are payload-only and never touched (engine/us_act_now.py's display fence). -#}
    {%- if action_board.get('bottoming_watch') is not none %}
    {%- set _bwrows = action_board.get('bottoming_watch') or [] -%}
    {%- set _bwauth = action_board.get('bottoming_authority') or {} -%}
    {%- set _bwrec = action_board.get('recovering_ids') or [] -%}
    {%- macro bw_card_body(x) -%}
      <span class="bw-top">
        <span class="bw-mark" aria-hidden="true">{{ '🏛' if x.get('kind') == 'SECTOR' else '🧩' }}</span>
        <span class="bw-name"><span class="l-en">{{ dispshort(x.name)|e }}</span><span class="l-zh">{{ (x.name_zh or x.name)|e }}</span></span>
        {%- if x.get('osc_slope') is not none %}
        <span class="bw-turn" data-tip-en="How fast the cycle read is turning up off the low — a bigger number is a sharper turn. A first hint only, never a call to act." data-tip-zh="周期读数自低位回升的速度——数字越大，转向越明显。仅为初步迹象，绝非行动建议。">&#8599;&#8202;{{ '%.1f'|format(x.osc_slope) }}</span>
        {%- endif %}
      </span>
      {%- if x.get('pos') is not none %}
      {%- set _bwp = [[x.pos|float, 0.0]|max, 100.0]|min -%}
      <span class="bw-gauge" data-tip-en="Where this name sits in the full high-to-low span the nightly cycle read measures: 0% is the floor of that span, 100% the top. The rail shows the same reading, drawn on the same scale for every row." data-tip-zh="该名称在今晚周期读数所测的完整高低区间中的位置：0% 为区间底部，100% 为顶部。左侧标尺为同一读数，所有行使用同一刻度。">
        <span class="bw-rail" aria-hidden="true"><span class="bw-rail-fill" style="width:{{ '%.1f'|format(_bwp) }}%"></span></span>
        <span class="bw-depth"><span class="l-en">bottom <b>{{ '<1' if _bwp < 0.5 else '%.0f'|format(_bwp) }}%</b> of its cycle range</span><span class="l-zh">周期区间底部 <b>{{ '<1' if _bwp < 0.5 else '%.0f'|format(_bwp) }}%</b></span></span>
      </span>
      {%- else %}
      <span class="bw-gauge" data-tip-en="The nightly cycle read placed this name on the shelf but shipped no position for it tonight. An unknown reading is printed as unknown rather than drawn as a zero." data-tip-zh="今晚周期读数将该名称列入本层，但未给出具体位置。未知读数按未知显示，不会当作 0 绘制。">
        <span class="bw-rail bw-rail--none" aria-hidden="true"></span>
        <span class="bw-depth"><span class="l-en">no position reading tonight</span><span class="l-zh">今晚无位置读数</span></span>
      </span>
      {%- endif %}
      {%- if x.get('cycle_signal') %}
      <span class="bw-chips">
        <span class="bw-chip bw-chip--turn" data-tip-en="The nightly cycle read registered a turn on this name. It is quoted here as that engine's own output, never as a call of ours — a forming low on its own has not been shown to predict what comes next." data-tip-zh="今晚周期读数在该名称上登记了一次转折。此处原样引用该引擎的输出，并非本站的判断——单独的底部形成迹象尚未被证明能预测后续走势。"><span class="l-en">cycle turn signal — watch only</span><span class="l-zh">周期转折信号——仅观察</span></span>
        {%- if x.get('gate_conflict') %}
        <span class="bw-chip bw-chip--gate" data-tip-en="The same name is still below its 200-day trend line, so the trend gate this board runs on has not opened. The two reads disagree and both are printed." data-tip-zh="该名称仍低于其200日趋势线，本板所依据的趋势闸门尚未开启。两种判读并不一致，此处两者并列打印。"><span class="l-en">below 200-day trend — gate shut</span><span class="l-zh">低于200日趋势——闸门关闭</span></span>
        {%- endif %}
      </span>
      {%- endif %}
    {%- endmacro -%}
    <div class="bw-shelf">
      <div class="bw-hd">
        <span class="bw-title"><span class="l-en">Bottom watch</span><span class="l-zh">筑底观察</span></span>
        <span class="bw-count">{{ _bwrows | length }}</span>
        <span class="bw-sub"><span class="l-en">Cycle lows forming — watch, don't chase</span><span class="l-zh">周期底部形成中——观察，勿追</span></span>
        {{ help('What this is: names the nightly cycle read has working on a low — deepest first, at most eight. What it is not: a call to act; nothing on this shelf has confirmed anything. A name can sit here and on a reduce lane at the same time — when it does, both reads are shown side by side rather than one being picked for you.', '这是什么：今晚周期读数中正在低位筑底的名称——最深的排在最前，最多八个。这不是什么：不是行动建议；本层没有任何标的已确认转向。同一名称可以同时出现在这里和减仓泳道——出现时，两种判读会并列显示，而不是替你二选一。') }}
      </div>
      {%- if _bwrows %}
      <div class="bw-rows">
        {%- for x in _bwrows %}
        {%- if x.get('href') %}<a class="bw-card" href="{{ x.href }}">{{ bw_card_body(x) }}</a>
        {%- else %}<div class="bw-card">{{ bw_card_body(x) }}</div>{% endif %}
        {%- endfor %}
      </div>
      {%- else %}
      <p class="bw-none">{{ t("no basing candidates tonight", '今晚无筑底候选') }}</p>
      {%- endif %}
      {#- ONE footnote per section (Law 4): the engine's honest null, quoted verbatim,
          with the graduation-gap sentence MERGED into the same line when at least
          one reduce-side row carries that chip — never stacked as a second note. -#}
      <p class="bw-foot">
        <span class="l-en">{{ _bwauth.get('null_disclosure_en', '') }}{% if _bwrec and _bwauth.get('recovering_disclosure_en') %} {{ _bwauth.get('recovering_disclosure_en') }}{% endif %}</span>
        <span class="l-zh">{{ _bwauth.get('null_disclosure_zh', '') }}{% if _bwrec and _bwauth.get('recovering_disclosure_zh') %} {{ _bwauth.get('recovering_disclosure_zh') }}{% endif %}</span>
      </p>
    </div>
    {%- endif %}
  </div>{# /panel — What to act on now (standouts split into their own panel 2026-07-11) #}
{% endif %}
