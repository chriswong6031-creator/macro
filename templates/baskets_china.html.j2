<script src="lightweight-charts.js"></script>
{% if not lite %}<script src="baskets_desk.js"></script>{% endif %}
<script>
const BASKETS = {{ baskets_json|safe }};
const CHART   = {{ chart_json|safe }};
const THEME   = BASKETS.theme_intel || null;
const THEME_ALERTS = {{ theme_alerts_json|default('[]')|safe }};
window.BASKET_BASE = '{{ basket_base }}';

const TBL_COLS = ['1d','5d','20d','60d','MTD','YTD'];
const RANGES = [['3M',63],['6M',126],['YTD','ytd'],['1Y',252],['All',0]];
const HZ_TABS = ['1d','5d','20d','60d','YTD'];
const PALETTE = ['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635','#38bdf8','#e879f9','#34d399','#fbbf24','#60a5fa','#c084fc','#22d3ee','#f87171','#bef264','#818cf8','#fcd34d','#5eead4','#fda4af'];
const colorOf = {}; (BASKETS.baskets||[]).forEach((b,i)=>colorOf[b.id]=PALETTE[i%PALETTE.length]);
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const BENCH_COLOR = () => cssv('--muted') || '#94a3b8';

// ---- score helpers ---------------------------------------------------------
const scoreBand = s => s==null ? 'neutral' : (s>=65?'strong':s>=45?'neutral':'weak');
const scoreBadgeHtml = s => s==null ? '' :
  `<span class="score-badge ${scoreBand(s)}">${s}</span>`;
// Plain-word turn-state display (no raw enum slugs per doctrine §6).
const TURN_PLAIN = {
  WASHED_OUT: {en:'washed out', zh:'超跌', cls:'washed_out'},
  BASING:     {en:'basing',     zh:'筑底', cls:'basing'},
  TURNING:    {en:'turning',    zh:'转折', cls:'turning'},
  CONFIRMED:  {en:'confirmed',  zh:'确认', cls:'confirmed'},
};
const turnChipHtml = ts => {
  const tp = TURN_PLAIN[ts]; if(!tp) return '';
  const lbl = LANG()==='zh' ? tp.zh : tp.en;
  return `<span class="turn-chip ${tp.cls}">${esc(lbl)}</span>`;
};
// Signal tier chip (display-only, bilingual via LANG()).
const SIG_LABELS = {T1:{en:'T1 signal',zh:'T1信号'}, T2:{en:'T2 signal',zh:'T2信号'}, T3:{en:'T3 forming',zh:'T3预备'}};
const sigChipHtml = (tier, fresh) => {
  if(!tier || !SIG_LABELS[tier]) return '';
  const lbl = LANG()==='zh' ? SIG_LABELS[tier].zh : SIG_LABELS[tier].en;
  const fr = fresh ? `<span class="sig-fresh" data-tip="${LANG()==='zh'?'信号在近10根K线内触发':'signal fired within the last 10 bars'}">●</span>` : '';
  return `<span class="sig-chip">&#9889;${esc(lbl)}${fr}</span>`;
};

// ---- bilingual helpers (the page re-renders on langchange) -----------------
const LANG = () => document.documentElement.getAttribute('data-lang')||'en';
const bn  = b => (LANG()==='zh' && b && b.name_zh) ? b.name_zh : (b?b.name:'');
const bth = b => (LANG()==='zh' && b && b.thesis_zh) ? b.thesis_zh : (b?b.thesis:'');
const BENCH = () => LANG()==='zh' ? (BASKETS.benchmark_label_zh||'沪深300') : (BASKETS.benchmark_label||'CSI 300');
const CAT_ZH = {}; (BASKETS.categories||[]).forEach((c,i)=>CAT_ZH[c]=(BASKETS.categories_zh||[])[i]||c);
const catLabel = c => (LANG()==='zh' && CAT_ZH[c]) ? CAT_ZH[c] : c;
const VS = () => (LANG()==='zh'?'相对 ':'vs ')+BENCH();
const TABLE_LIMIT = 12;
let query = '';
let tableExpanded = false;
let chartScope = localStorage.getItem('cnfw-chart-scope') || 'cats';
let chartCat = localStorage.getItem('cnfw-chart-cat') || 'all';

const fmtPct = x => x==null ? '—' : (x>=0?'+':'')+(x*100).toFixed(1)+'%';
const fmtZ   = x => x==null ? '—' : (x>=0?'+':'')+x.toFixed(1)+'σ';
const cls    = x => x==null ? 'muted' : (x>=0?'pos':'neg');
const esc    = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const norm   = s => (s==null?'':String(s)).toLowerCase().replace(/[\s_\-·/()（）]+/g,'');
// detailKey: THS baskets use ths_ prefix → slug is underscore-stripped (ths_semis→ths-semis).
// Curated baskets (cn_*) keep underscores as-is (cn_pharma_cxo → cn_pharma_cxo).
// Explicit safe mapping: never silently mangle a curated basket id.
const detailKey = b => {
  const raw = b.detail_key || b.id || '';
  if(raw.startsWith('ths_')) return raw.replace(/_/g,'-');
  return raw;
};
// curated basket detail pages are written to basket_china/ (build_theme_detail);
// THS concept pages live under subsector_china/ — the old single-path href 404'd curated links
const detailHref = b => String(b?.id||'').startsWith('ths_')
  ? `subsector_china/${detailKey(b)}.html` : `basket_china/${detailKey(b)}.html`;
const nameLink = b => `<a class="blink" href="${esc(detailHref(b))}" data-nav="detail">${esc(bn(b))}</a>`;
const basketText = b => [b?.id,b?.name,b?.name_zh,b?.category,b?.category_zh,b?.thesis,b?.thesis_zh,(b?.members||[]).map(m=>[m.symbol,m.name].join(' ')).join(' ')].join(' ');
function filteredBaskets(){
  const q=norm(query);
  const rows=(BASKETS.baskets||[]);
  return q ? rows.filter(b=>norm(basketText(b)).includes(q)) : rows.slice();
}
function updateCount(){
  const el=document.getElementById('basket-count'); if(!el) return;
  const n=tblFilteredBaskets().length, total=(BASKETS.baskets||[]).length;
  el.textContent = LANG()==='zh' ? `${n} / ${total} 个主题` : `${n} of ${total} themes`;
}
// bilingual span pair (local name — the non-lite page also loads baskets_desk.js, which owns `L`)
const _bl    = (en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`;
// L alias for leg-toggle buttons — guarded so the non-lite page (which loads baskets_desk.js)
// does not throw "Identifier 'L' has already been declared" (classic scripts share one lexical scope).
window.L = window.L || ((en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`);
// isZh() defined by baskets_desk.js on non-lite; guard for lite path
if(typeof isZh==='undefined') window.isZh=function(){ return document.documentElement.getAttribute('data-lang')==='zh'; };
const lastIdx = a => { for(let i=a.length-1;i>=0;i--) if(a[i]!=null) return i; return -1; };
const hzLabel = c => c==='ytd'?'YTD':c;

function startIdxFor(col,dates,li){
  const u = col.toUpperCase();
  if(u==='MTD'||u==='YTD'){ const p = dates[li].slice(0, u==='MTD'?7:4); let i=li; while(i>0 && dates[i-1].startsWith(p)) i--; return i>0?i-1:null; }
  const i = li-parseInt(col,10); return i>=0?i:null;
}
function winRet(levels,col){ if(!levels) return null; const li=lastIdx(levels); if(li<0) return null;
  const si=startIdxFor(col,CHART.dates,li); if(si==null||levels[si]==null) return null; return levels[li]/levels[si]-1; }
function winZ(levels,col){ const n=parseInt(col,10); if(!n||!levels) return null; const li=lastIdx(levels); if(li<252+n) return null;
  const hr=[]; for(let i=li-252;i<=li;i++) hr.push((levels[i]!=null&&levels[i-n]!=null)?levels[i]/levels[i-n]-1:null);
  const cur=hr[hr.length-1]; const base=hr.slice(0,-1).filter(v=>v!=null); if(cur==null||base.length<200) return null;
  const m=base.reduce((a,b)=>a+b,0)/base.length; const sd=Math.sqrt(base.reduce((a,b)=>a+(b-m)**2,0)/(base.length-1)); return sd>0?(cur-m)/sd:null; }
const ratio = a => a.map((v,i)=>(v!=null&&CHART.bench[i]!=null)?v/CHART.bench[i]:null);

function sparkSvg(values,{w=92,h=26,color=''}={}){
  const vs=(values||[]).filter(v=>v!=null); if(vs.length<2) return '';
  const min=Math.min(...vs),max=Math.max(...vs),span=(max-min)||1;
  const pts=vs.map((v,i)=>[i/(vs.length-1)*w, h-3-(v-min)/span*(h-7)]);
  const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
  const col = color || (vs[vs.length-1]>=vs[0]?cssv('--up'):cssv('--down'));
  const e=pts[pts.length-1];
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><path d="${d}" fill="none" stroke="${col}" stroke-width="1.4"/><circle cx="${e[0].toFixed(1)}" cy="${e[1].toFixed(1)}" r="1.6" fill="${col}"/></svg>`;
}
const sparkTail = (levels,n=60) => (levels||[]).filter(x=>x!=null).slice(-n);

function renderTabs(el, opts, active, cb){
  el.innerHTML = opts.map(([v,lab])=>`<button data-v="${v}" class="${v==active?'on':''}">${lab}</button>`).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{ el.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); cb(b.dataset.v); });
