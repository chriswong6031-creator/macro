  {# ── Theme Context Hero (theme_context.v1, server-rendered) — cn edition ── #}
  {# When theme_context is absent (off-lane / first run): plain header fallback. #}
  {% if not lite and theme_context is defined and theme_context is not none %}
  {% set _tc_lead = theme_context.leadership %}
  {% set _tc_tl   = _tc_lead.trailing_leader %}
  {% set _tc_st   = _tc_lead.state %}
  {# Aurora tint class by state #}
  {% set _tc_cls  = 'tc-rotating' if _tc_st == 'rotating' else ('tc-strain' if _tc_st == 'strain' else 'tc-steady') %}
  <div id="theme-context-hero" class="{{ _tc_cls }}">
    <div class="tc-aurora" aria-hidden="true"></div>
    <div class="tc-inner">

