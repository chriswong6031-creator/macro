// ---- 01 table — category filter -------------------------------------------
let btblMode = localStorage.getItem('cnfw-btbl-mode')||'rel';
// Bumped key: cnfw-btbl-sort-v2 (adds score column — old prefs had no score col).
let btblSort = JSON.parse(localStorage.getItem('cnfw-btbl-sort-v2')||'{"col":"20d","dir":-1}');
let tblCatFilter = 'all'; // 'all' or a category string
function renderTblCatFilter(){
  const host=document.getElementById('tbl-cat-filter'); if(!host) return;
  const zh=LANG()==='zh';
  const cats=['all',...(BASKETS.categories||[])];
  host.innerHTML=cats.map(c=>{
    const lbl=c==='all'?(zh?'全部':'All'):esc(catLabel(c));
    return `<button type="button" data-c="${esc(c)}" class="${c===tblCatFilter?'on':''}">${lbl}</button>`;
  }).join('');
  host.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    tblCatFilter=b.dataset.c; tableExpanded=false; renderTblCatFilter(); renderBTable(); updateCount();
  });
}
function tblFilteredBaskets(){
  const rows=filteredBaskets();
  return tblCatFilter==='all' ? rows : rows.filter(b=>b.category===tblCatFilter);
}
function renderBTable(){
  const allowed = new Set(tblFilteredBaskets().map(b=>b.id));
  let rows = Object.entries(CHART.baskets).filter(([id])=>allowed.has(id)).map(([id,lv])=>{
    const b=(BASKETS.baskets||[]).find(x=>x.id===id); const rl=ratio(lv);
    const src = btblMode==='raw'?lv:rl;
    const vals={}; TBL_COLS.forEach(c=>{ vals[c]= btblMode==='sigma' ? (/^\d/.test(c)?winZ(rl,c):null) : winRet(src,c); });
    return {id,b,name:bn(b),color:colorOf[id]||'#888',spark:sparkTail(src),vals,score:b?b.score:null};
  });
  const sc=btblSort.col, dir=btblSort.dir;
  rows.sort((a,b)=>{
    if(sc==='name') return a.name.localeCompare(b.name)*dir;
    if(sc==='score'){ if(a.score==null) return 1; if(b.score==null) return -1; return (a.score-b.score)*dir; }
    const x=a.vals[sc], y=b.vals[sc]; if(x==null) return 1; if(y==null) return -1; return (x-y)*dir;
  });
  const totalRows = rows.length;
  const shownRows = tableExpanded ? rows : rows.slice(0,TABLE_LIMIT);
  const fmt = btblMode==='sigma' ? fmtZ : fmtPct;
  const th = c => `<th class="num ${c===sc?'sel':''}" data-c="${c}">${c}${c===sc?(dir<0?' ▾':' ▴'):''}</th>`;
  const scoreHdrLbl = LANG()==='zh'?'得分':'Score';
  const nameHdr = LANG()==='zh'?'篮子':'Basket';
  let html = `<thead><tr><th data-c="name">${nameHdr}${sc==='name'?(dir<0?' ▾':' ▴'):''}</th>
    <th class="num ${sc==='score'?'sel':''}" data-c="score">${scoreHdrLbl}${sc==='score'?(dir<0?' ▾':' ▴'):''}</th>
    <th class="num">60d</th>${TBL_COLS.map(th).join('')}</tr></thead><tbody>`;
  html += shownRows.map(r=>`<tr><td class="bname" data-id="${r.id}"><span class="dot" style="background:${r.color}"></span>${nameLink(r.b)}</td>
    <td class="num">${r.score!=null?`<span class="score-badge ${scoreBand(r.score)}">${r.score}</span>`:'<span class="muted">—</span>'}</td>
    <td class="num">${sparkSvg(r.spark,{color:r.color})}</td>
    ${TBL_COLS.map(c=>`<td class="num ${cls(r.vals[c])}">${r.vals[c]==null?'<span class="muted">—</span>':fmt(r.vals[c])}</td>`).join('')}</tr>`).join('');
  if(btblMode==='raw'){ const bv={}; TBL_COLS.forEach(c=>bv[c]=winRet(CHART.bench,c));
    html += `<tr><td class="bname" style="font-weight:500"><span class="dot" style="background:${BENCH_COLOR()}"></span>${esc(BENCH())}</td><td></td><td></td>${TBL_COLS.map(c=>`<td class="num ${cls(bv[c])}">${fmtPct(bv[c])}</td>`).join('')}</tr>`; }
  html += '</tbody>';
  const tbl=document.getElementById('btable'); tbl.innerHTML=html;
  tbl.querySelectorAll('th[data-c]').forEach(h=>h.onclick=()=>{ const c=h.dataset.c;
    if(c===btblSort.col) btblSort.dir*=-1; else btblSort={col:c,dir:c==='name'?1:-1};
    localStorage.setItem('cnfw-btbl-sort-v2',JSON.stringify(btblSort)); renderBTable(); });
  const more=document.getElementById('table-more');
  if(more){
    const hiddenN=Math.max(0,totalRows-TABLE_LIMIT);
    more.style.display=hiddenN?'inline-block':'none';
    more.textContent=tableExpanded
      ? (LANG()==='zh'?'收起':'Show less')
      : (LANG()==='zh'?`查看更多 ${hiddenN} 个`:`See more ${hiddenN}`);
    more.onclick=()=>{ tableExpanded=!tableExpanded; renderBTable(); };
  }
  updateCount();
}

// ---- 02 chart -------------------------------------------------------------
let chart=null, chartMode='rel', chartRange=parseInt(localStorage.getItem('cnfw-brange')||'252',10)||252, hidden={};
// Crosshair floating tooltip
let _xhTooltip=null;
function _xhTip(){
  if(!_xhTooltip){
    _xhTooltip=document.createElement('div');
    _xhTooltip.id='cn-ch-tip';
    _xhTooltip.style.cssText='position:absolute;pointer-events:none;display:none;background:var(--panel2,#1e222a);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:11.5px;white-space:nowrap;z-index:30;box-shadow:0 4px 16px rgba(0,0,0,.3)';
    const chartEl=document.getElementById('chart');
    if(chartEl){ chartEl.style.position='relative'; chartEl.appendChild(_xhTooltip); }
  }
  return _xhTooltip;
}
function avgLevels(levelSets){
  const out=[];
  for(let i=0;i<CHART.dates.length;i++){
    const vals=levelSets.map(a=>a?.[i]).filter(v=>v!=null);
    out.push(vals.length ? vals.reduce((a,b)=>a+b,0)/vals.length : null);
  }
  return out;
}
function chartSets(){
  const baskets=filteredBaskets();
  const sourceLevels = id => chartMode==='rel' ? ratio(CHART.baskets[id]||[]) : (CHART.baskets[id]||[]);
  if(chartScope==='cats'){
    const cats=(BASKETS.categories||[]).map((c,i)=>({cat:c,color:PALETTE[i%PALETTE.length]}))
      .filter(x=>chartCat==='all'||x.cat===chartCat)
      .map(x=>{
        const ids=baskets.filter(b=>b.category===x.cat && CHART.baskets[b.id]).map(b=>b.id);
        return ids.length ? {key:'cat:'+x.cat,label:catLabel(x.cat),color:x.color,levels:avgLevels(ids.map(sourceLevels)),n:ids.length} : null;
      }).filter(Boolean);
    return chartMode==='abs' ? [...cats,{key:'bench',label:BENCH(),color:BENCH_COLOR(),levels:CHART.bench}] : cats;
  }
  let subBaskets=baskets.filter(b=>chartCat==='all'||b.category===chartCat);
  if(chartCat==='all'){
    subBaskets=subBaskets.slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0)).slice(0,12);
  }
  const sets=subBaskets
    .filter(b=>CHART.baskets[b.id])
    .map(b=>({key:b.id,label:bn(b),color:colorOf[b.id]||'#888',levels:sourceLevels(b.id)}));
  return chartMode==='abs' ? [...sets,{key:'bench',label:BENCH(),color:BENCH_COLOR(),levels:CHART.bench}] : sets;
}
function rangeStart(dates){ if(chartRange==='ytd'){ const y=dates[dates.length-1].slice(0,4); const i=dates.findIndex(d=>d.startsWith(y)); return i<=0?0:i-1; }
  return chartRange?Math.max(0,dates.length-chartRange):0; }
function chartOpts(){ return { autoSize:true,
  layout:{ background:{type:'solid',color:'transparent'}, textColor:cssv('--muted')||'#9aa4b2', fontSize:11 },
  grid:{ vertLines:{visible:false}, horzLines:{color:cssv('--line')||'#222'} },
  rightPriceScale:{ borderColor:cssv('--line')||'#222' }, timeScale:{ borderColor:cssv('--line')||'#222' },
  crosshair:{ mode:0, vertLine:{labelBackgroundColor:cssv('--panel2')||'#333'}, horzLine:{labelBackgroundColor:cssv('--panel2')||'#333'} } }; }
function renderChart(){
  const el=document.getElementById('chart'); if(typeof LightweightCharts==='undefined'){ el.innerHTML='<p class="muted">The charting library failed to load — the rest of the page is unaffected.</p>'; return; }
  if(!chart){ chart=LightweightCharts.createChart(el,chartOpts()); }
  (chart.__series||[]).forEach(s=>chart.removeSeries(s)); chart.__series=[];
  const start=rangeStart(CHART.dates);
  const sets=chartSets().filter(s=>!hidden[s.key]); const nVis=sets.length;
  const seriesMeta=[];
  sets.forEach(set=>{
    let base=null; const data=[];
    for(let i=start;i<CHART.dates.length;i++){ const v=set.levels[i]; if(v==null) continue; if(base===null) base=v; data.push({time:CHART.dates[i], value:100*(v/base-1)}); }
    if(data.length<2) return;
    const s=chart.addLineSeries({ color:set.color, lineWidth:2, priceLineVisible:false, lastValueVisible:nVis<=4, title:nVis<=4?set.label:'',
      priceFormat:{type:'custom',minMove:0.01,formatter:v=>(v>=0?'+':'')+v.toFixed(1)+'%'} });
    s.setData(data); chart.__series.push(s); seriesMeta.push({key:set.key,color:set.color,label:set.label,s,data});
  });
  // Crosshair move — show nearest basket name + value (bilingual via isZh)
  if(chart.__xhSub){ try{ chart.__xhSub.unsubscribe(); }catch(e){} }
  const tip=_xhTip();
  chart.__xhSub=chart.subscribeCrosshairMove(function(param){
    if(!param||!param.point||!param.seriesData||!param.seriesData.size){tip.style.display='none';return;}
    let best=null, bestDist=Infinity;
    seriesMeta.forEach(m=>{
      const d=param.seriesData.get(m.s);
      if(d==null) return;
      const pxY=m.s.priceToCoordinate?m.s.priceToCoordinate(d.value):null;
      const dist=pxY!=null?Math.abs(pxY-(param.point.y||0)):Math.abs(d.value-(param.point.y||0));
      if(dist<bestDist){bestDist=dist;best={...m,val:d.value};}
    });
    if(!best){tip.style.display='none';return;}
    const v=best.val;
    const nm=isZh()?(BASKETS.baskets||[]).find(b=>b.id===best.key)?.name_zh||best.label:best.label;
    tip.innerHTML=`<span style="color:${best.color}">●</span> ${esc(nm)} <b style="color:${v>=0?'var(--up)':'var(--down)'}">${(v>=0?'+':'')+v.toFixed(1)}%</b>`;
    const x=param.point.x, y=param.point.y;
    tip.style.left=(x+12)+'px'; tip.style.top=(y-18)+'px'; tip.style.display='block';
  });
  // Guard: attach mouseleave once per element
  if(!el._mlGuard){ el._mlGuard=true; el.addEventListener('mouseleave',()=>{tip.style.display='none';},{passive:true}); }
  chart.timeScale().fitContent(); renderChartLegend();
}
function renderChartLegend(){
  const el=document.getElementById('chart-legend'); const st=rangeStart(CHART.dates);
  const chips=chartSets().map(s=>{ const li=lastIdx(s.levels); let base=null; for(let i=st;i<=li;i++){ if(s.levels[i]!=null){ base=s.levels[i]; break; } }
    const v=(base!=null&&s.levels[li]!=null)?100*(s.levels[li]/base-1):null;
    return `<span class="lchip ${hidden[s.key]?'off':''}" data-k="${s.key}"><span class="dot" style="background:${s.color}"></span>${esc(s.label)} <span class="lv">${v==null?'':(v>=0?'+':'')+v.toFixed(1)+'%'}</span></span>`;
  }).join('');
  // All / None toggle buttons (leg-toggle idiom from baskets.html.j2)
  const allBtn=`<button class="leg-toggle" onclick="Object.keys(hidden).forEach(k=>delete hidden[k]);renderChart()">${L('All','全选')}</button>`;
  const noneBtn=`<button class="leg-toggle" onclick="chartSets().forEach(s=>hidden[s.key]=true);renderChart()">${L('None','全不选')}</button>`;
  el.innerHTML=allBtn+noneBtn+chips;
  el.querySelectorAll('.lchip').forEach(c=>c.onclick=()=>{ hidden[c.dataset.k]=!hidden[c.dataset.k]; renderChart(); });
}
function initChartDefaults(){
  if(chartScope!=='subs') return;
  const ranked=filteredBaskets().filter(b=>chartCat==='all'||b.category===chartCat)
    .slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0));
  ranked.slice(8).forEach(b=>hidden[b.id]=true);
}
function renderChartCats(){
  const host=document.getElementById('chart-cats'); if(!host) return;
  const cats=['all',...(BASKETS.categories||[])];
  host.innerHTML=cats.map(c=>{
    const allLab = chartScope==='subs'
      ? (LANG()==='zh'?'全部热门':'Top movers')
      : (LANG()==='zh'?'全部类别':'All categories');
    return `<button type="button" data-c="${esc(c)}" class="${c===chartCat?'on':''}">${c==='all'?allLab:esc(catLabel(c))}</button>`;
  }).join('');
  host.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    chartCat=b.dataset.c; localStorage.setItem('cnfw-chart-cat',chartCat); hidden={}; initChartDefaults(); renderChartCats(); renderChart();
  });
  const note=document.getElementById('chart-note');
  if(note){
    note.textContent = chartScope==='cats'
      ? (LANG()==='zh'?'类别线 = 该类别内所有匹配主题的等权平均走势。':'Category lines are equal-weight averages of every matching theme inside that category.')
      : (LANG()==='zh'?'子行业模式默认显示全市场热门主题；选择类别后可钻入该类别内的具体主题。':'Subsector mode starts with top movers across the market; choose a category to drill into that group.');
  }
}

// ---- 03 cards + details ---------------------------------------------------
let bhz = localStorage.getItem('cnfw-hz')||'20d';
// Bumped key: cnfw-card-sort-v2 (adds Score sort — old stored prefs may have been 'rel').
let cardSort = localStorage.getItem('cnfw-card-sort-v2')||'score';
function kpi(k,p){ const v=p?p.rel:null; return `<div class="kpi"><div class="v ${cls(v)}">${fmtPct(v)}</div><div class="k">${k} ${esc(VS())}</div></div>`; }
function sortedCards(cards){
  if(cardSort==='score'){
    // lite/THS payloads carry no scores — fall back to momentum so the default
    // ordering is never accidental input order (review 07-18)
    if(!cards.some(b=>b.score!=null))
      return cards.slice().sort((a,c)=>((c.perf?.[bhz]?.rel)??-9)-((a.perf?.[bhz]?.rel)??-9));
    return cards.slice().sort((a,c)=>{
      if(a.score==null&&c.score==null) return 0;
      if(a.score==null) return 1; if(c.score==null) return -1;
      return c.score - a.score;
    });
  }
  if(cardSort==='name') return cards.slice().sort((a,c)=>bn(a).localeCompare(bn(c)));
  // momentum: sort by selected hz rel return
  return cards.slice().sort((a,c)=>((c.perf?.[bhz]?.rel)??-9)-((a.perf?.[bhz]?.rel)??-9));
}
function renderCardSortTabs(){
  const host=document.getElementById('card-sort-tabs'); if(!host) return;
  const zh=LANG()==='zh';
  const opts=[['score',zh?'得分':'Score'],['momentum',zh?'动量':'Momentum'],['name',zh?'名称':'Name']];
  host.innerHTML=opts.map(([v,l])=>`<button data-v="${v}" class="${v===cardSort?'on':''}">${l}</button>`).join('');
  host.querySelectorAll('button').forEach(b=>b.onclick=()=>{
    cardSort=b.dataset.v; localStorage.setItem('cnfw-card-sort-v2',cardSort);
    host.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b));
    renderCards();
  });
}
function renderCards(){
  const el=document.getElementById('cards');
  el.innerHTML=(BASKETS.categories||[]).map(cat=>{
    const since = LANG()==='zh'?'自':'since';
    const memberW = LANG()==='zh'?'只 · ':' members · ';
    const baskets=filteredBaskets().filter(b=>b.category===cat);
    const cards=sortedCards(baskets)
      .map(b=>{ const spk=sparkTail(ratio(CHART.baskets[b.id]));
        const ref=b.reference?` · ${LANG()==='zh'?'对标':'tracks'} ${esc(b.reference.label)} (r ${b.reference.corr.toFixed(2)})`:'';
        // tiny cross-market confirmer badge on AI-supply baskets (context only, not a signal)
        const sx=b.ai_semis_confirmer;
        const sxBadge=(sx&&sx.on!=null)?`<span class="semis-badge ${sx.on?'on':''}" data-tip="cross-market confirmer — global semis momentum context, not a buy signal">${_bl('AI-semis '+(sx.state||''),'全球AI半导体 '+(sx.on?'开启':'关闭'))}</span>`:'';
        const scoreBadge = scoreBadgeHtml(b.score);
