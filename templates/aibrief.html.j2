<script>
/* Market toggle — flips which .ai-brief panel is visible. Visibility is purely
   class-based so it never conflicts with aibrief.js (which only fills bodies and
   clears inline display on load). Supports #macro/#china/#btc deep-links. */
(function () {
  var btns = document.querySelectorAll(".brief-tab-btn");
  var panels = document.querySelectorAll(".ai-brief.brief-tab");
  function show(lens) {
    for (var i = 0; i < panels.length; i++) {
      panels[i].classList.toggle("active", panels[i].getAttribute("data-lens") === lens);
    }
    for (var j = 0; j < btns.length; j++) {
      var on = btns[j].getAttribute("data-lens") === lens;
      btns[j].classList.toggle("active", on);
      btns[j].setAttribute("aria-selected", on ? "true" : "false");
    }
    try { history.replaceState(null, "", "#" + lens); } catch (e) {}
  }
  for (var k = 0; k < btns.length; k++) {
    btns[k].addEventListener("click", function () { show(this.getAttribute("data-lens")); });
  }
  var h = (location.hash || "").replace("#", "");
  if (h === "macro" || h === "china" || h === "btc") show(h);
})();
</script>
