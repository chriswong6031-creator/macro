{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro vbadge(v) -%}
{% if 'CONFIRMED' in v %}<span class="verdict v-conf">{{ td(v) }}</span>
{%- elif 'INVERTED' in v %}<span class="verdict v-inv">{{ td('INVERTED') }}</span>
{%- elif 'DIRECTIONAL' in v %}<span class="verdict v-dir">{{ td('DIRECTIONAL') }}</span>
{%- elif v %}<span class="verdict v-ctx">{{ td('CONTEXT') }}</span>{% endif %}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Commodities — {{ as_of }}</title>
{% set seo_title = 'Commodities Sector Intelligence — Mastermind' %}
{% set seo_desc = 'Live commodity sector read: sector stance, index breadth, bottoms & tops confluence board, trend-diversity heat grid, and per-commodity detail for all 17 members.' %}
{% set seo_path = 'commodities.html' %}
{% include "_seo_head.html.j2" %}
{# Plotly deliberately NOT loaded: this page renders zero Plotly charts (stance
   board + heat grid are pure HTML/SVG). Re-include '_plotly_head.html.j2' only
   if a real chart returns. #}
<style>
/* ── base vars — dark-default ──────────────────────────────── */
:root {
  --bg:#0a0e16; --panel:#111826; --panel2:#0e1420; --line:#1d2740; --line2:#27324e;
  --tx:#e3e9f2; --mut:#8a97ac; --faint:#5b6b83;
  --up:#37d07f; --dn:#ff6a6a; --amb:#f2b24d; --gold:#d6ab5c; --blue:#5d8bff; --pur:#9b8cff;
  --ink:#e3e9f2;
  --font-ui: Inter, -apple-system, 'Segoe UI', Roboto, sans-serif;
}
/* light-theme overrides — mirrors theme.css flip */
[data-theme='light']:root, [data-theme='light'] {
  --bg:#f7f8fa; --panel:#ffffff; --panel2:#f0f2f5; --line:#e1e7ef; --line2:#c8d0dc;
  --tx:#1a2133; --mut:#5c6b80; --faint:#8b96a8;
  --up:#1a7f43; --dn:#c0392b; --amb:#9a6800; --gold:#a07820; --blue:#285fff; --pur:#6c5ce7;
  --ink:#1a2133;
}
*, *::before, *::after { box-sizing: border-box; }
html:not([data-lang="zh"]) .l-zh { display: none; }
html[data-lang="zh"] .l-en { display: none; }
html[data-lang="zh"] body { font-family: "PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC","Microsoft JhengHei","Heiti SC",Inter,sans-serif; }
body {
  margin: 0; padding-top: 24px; background: var(--bg); color: var(--tx);
  font: 14px/1.45 var(--font-ui);
  -webkit-font-smoothing: antialiased; font-variant-numeric: tabular-nums;
}
a { color: var(--blue); text-decoration: none; }
.wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px 60px; }
/* ── typography helpers ─── */
.kick { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
        color: var(--faint); margin: 0 0 10px; }
.mut { color: var(--mut); } .faint { color: var(--faint); } .up { color: var(--up); }
.dn { color: var(--dn); } .amb { color: var(--amb); } .gold { color: var(--gold); }
/* ── panel / grid ─── */
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; }
.panel2 { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 13px 15px; }
.grid { display: grid; gap: 14px; }
.g2 { grid-template-columns: 1.35fr 1fr; }
.g2e { grid-template-columns: 1fr 1fr; }
@media(max-width:780px){ .g2, .g2e { grid-template-columns: 1fr; } }
/* ── header ─── */
.hd { display: flex; justify-content: space-between; align-items: flex-end;
      margin-bottom: 18px; border-bottom: 1px solid var(--line); padding-bottom: 14px; }
.hd h1 { font-size: 15px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
          color: var(--mut); margin: 0 0 2px; }
.asof { font-size: 12px; color: var(--faint); }
/* ── section header ─── */
.sechd { display: flex; align-items: center; gap: 9px; margin: 22px 0 2px; }
.sechd h2 { font-size: 15px; font-weight: 600; margin: 0; letter-spacing: .01em; }
.sechd .q { width: 16px; height: 16px; border-radius: 50%; border: 1px solid var(--line2);
             color: var(--faint); font-size: 10px; display: flex; align-items: center;
             justify-content: center; cursor: default; flex-shrink: 0; }
.sechd .sub { font-size: 12px; color: var(--faint); margin: 0; }
.tierlabel { font-size: 10.5px; color: var(--faint); border: 1px solid var(--line2);
             border-radius: 5px; padding: 1px 6px; margin-left: auto; }
/* ── SECTION 1 — stance hero ─── */
.hero { display: grid; grid-template-columns: 1.35fr 1fr; gap: 16px; margin-bottom: 14px; }
@media(max-width:780px){ .hero { grid-template-columns: 1fr; } }
.stance-word { font-size: 30px; font-weight: 600; letter-spacing: -.01em; margin: 2px 0 6px; }
.stance-word.t-watch    { color: var(--amb); }
.stance-word.t-protect  { color: var(--dn); }
.stance-word.t-getready { color: var(--up); }
.stance-word.t-act      { color: var(--up); }
.stance-word.t-standaside { color: var(--mut); }
.stance-sub { font-size: 14px; color: var(--tx); max-width: 44ch; line-height: 1.55; }
.stance-tag { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px;
              font-size: 12px; color: var(--faint); border: 1px solid var(--line2);
              border-radius: 20px; padding: 4px 11px; }
/* dot bars */
.dotwrap { margin-top: 4px; }
.dotrow { display: flex; align-items: center; gap: 12px; margin: 9px 0; }
.dotrow .lbl { width: 155px; font-size: 12.5px; color: var(--mut); flex-shrink: 0; }
.dots { display: flex; gap: 3px; flex: 1; }
.dot { flex: 1; height: 14px; border-radius: 3px; background: var(--line); }
.dot.on-up  { background: var(--up); }
.dot.on-amb { background: var(--amb); }
.dotrow .cnt { width: 60px; text-align: right; font-size: 13px; font-weight: 600; flex-shrink: 0; }
.diverge { margin-top: 10px; font-size: 12.5px; color: var(--amb); display: flex; gap: 7px; align-items: flex-start; }
/* ── SECTION 2 — index card ─── */
.idx-top { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; }
.idx-val { font-size: 26px; font-weight: 600; }
.idx-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
.chip { font-size: 11.5px; padding: 3px 9px; border-radius: 7px;
        border: 1px solid var(--line2); color: var(--mut); }
.chip b { color: var(--tx); font-weight: 600; }
/* spark */
.spark { height: 44px; margin-top: 12px; display: flex; align-items: flex-end; gap: 2px; overflow: hidden; }
.spark i { flex: 1; background: linear-gradient(180deg,#26406e,#1a2b4d); border-radius: 2px 2px 0 0;
           display: block; min-width: 3px; }
[data-theme='light'] .spark i { background: linear-gradient(180deg,#b8c6fa,#8fa5f6); }
/* cycle chips */
.cyc-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
.cyc-chip { font-size: 11.5px; padding: 3px 9px; border-radius: 7px;
            border: 1px solid var(--line2); color: var(--mut); }
.cyc-chip b { font-weight: 600; }
.cyc-chip.ph-trough  b { color: var(--dn); }
.cyc-chip.ph-recovery b { color: var(--up); }
.cyc-chip.ph-downturn b { color: var(--amb); }
.cyc-chip.ph-expansion b { color: var(--up); }
.cyc-chip.ph-peak b { color: var(--dn); }
/* ── SECTION 3 — board ─── */
.board { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
@media(max-width:640px){ .board { grid-template-columns: 1fr; } }
.bcol .bh { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600;
             margin-bottom: 12px; letter-spacing: .02em; }
.bcol .bh .ic { width: 22px; height: 22px; border-radius: 6px; display: flex; align-items: center;
                justify-content: center; font-size: 13px; flex-shrink: 0; }
.tcol .ic { background: rgba(255,106,106,.14); color: var(--dn); }
.bcolb .ic { background: rgba(55,208,127,.14); color: var(--up); }
.brow { display: flex; align-items: flex-start; gap: 10px; padding: 9px 0;
        border-top: 1px solid var(--line); }
.brow:first-of-type { border-top: 0; }
.brow .nm { width: 88px; font-weight: 600; font-size: 13px; flex-shrink: 0; line-height: 1.3; }
.brow .st { flex: 1; font-size: 12px; color: var(--mut); line-height: 1.45; }
.rcpt-list { margin-top: 3px; font-size: 11px; color: var(--faint); }
.meter { width: 80px; height: 7px; border-radius: 4px; background: var(--line); overflow: hidden; flex-shrink: 0; }
.meter i { display: block; height: 100%; border-radius: 4px; }
.meter.t i { background: var(--dn); }
.meter.b i { background: var(--up); }
.brow .sc { width: 28px; text-align: right; font-size: 12.5px; font-weight: 600; flex-shrink: 0; }
.badge { font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 5px;
         letter-spacing: .02em; display: inline-block; margin-top: 2px; }
.badge.top  { background: rgba(242,178,77,.14); color: var(--amb); }
.badge.euf  { background: rgba(255,106,106,.16); color: var(--dn); }
.badge.wash { background: rgba(93,139,255,.16); color: var(--blue); }
.badge.neut { background: var(--line); color: var(--faint); }
/* ── SECTION 4 — heat grid ─── */
.legend { display: flex; gap: 16px; font-size: 11.5px; color: var(--faint); margin: 2px 0 12px; flex-wrap: wrap; }
.legend span { display: flex; align-items: center; gap: 6px; }
.sw { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
.hgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 9px; }
.cell { background: var(--panel2); border: 1px solid var(--line); border-left: 3px solid var(--line2);
        border-radius: 8px; padding: 9px 11px; }
.cell.c-up   { border-left-color: var(--up); }
.cell.c-dn   { border-left-color: var(--dn); }
.cell.c-wash { border-left-color: var(--blue); }
.cell.c-flat { border-left-color: var(--line2); }
.cell .cn { display: flex; justify-content: space-between; align-items: baseline; gap: 4px; }
.cell .cnm { font-weight: 600; font-size: 13px; }
.cell .cpc { font-size: 12.5px; font-weight: 600; }
.cell .cmeta { display: flex; justify-content: space-between; margin-top: 5px;
               font-size: 11px; color: var(--faint); }
.cell .cst { margin-top: 4px; font-size: 11px; color: var(--mut); }
.grp { font-size: 11px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
       color: var(--faint); margin: 16px 0 8px; }
/* ── SECTION 5 — detail ─── */
.dtabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 14px 0 0; }
.dtab { font: inherit; font-size: 13px; font-weight: 600; background: var(--panel2);
        border: 1px solid var(--line2); border-radius: 8px; padding: 6px 13px;
        color: var(--mut); cursor: pointer; transition: border-color .1s, color .1s; }
.dtab:hover { border-color: var(--blue); color: var(--tx); }
.dtab.active { border-color: var(--blue); color: var(--blue); background: var(--panel); }
.dpanel { margin-top: 14px; }
.dpanel[hidden] { display: none; }
.det { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media(max-width:640px){ .det { grid-template-columns: 1fr; } }
/* MTF table */
.mtf { width: 100%; border-collapse: collapse; font-size: 12px; }
.mtf th { text-align: left; color: var(--faint); font-weight: 500; padding: 5px 6px;
          border-bottom: 1px solid var(--line); }
.mtf td { padding: 5px 6px; border-bottom: 1px solid var(--line); }
.mtf tr:last-child td { border-bottom: 0; }
.pill { font-size: 10.5px; padding: 1px 6px; border-radius: 5px; white-space: nowrap; }
.pill.u { background: rgba(55,208,127,.14); color: var(--up); }
.pill.d { background: rgba(255,106,106,.14); color: var(--dn); }
.pill.n { background: var(--line); color: var(--mut); }
/* cycle clock arc */
.clock-wrap { display: flex; align-items: center; gap: 14px; margin-top: 10px; }
.arc { width: 70px; height: 70px; border-radius: 50%; border: 6px solid var(--line);
       border-top-color: var(--dn); border-right-color: var(--dn); flex-shrink: 0; }
.arc.arc-up   { border-top-color: var(--up); border-right-color: var(--up); }
.arc.arc-amb  { border-top-color: var(--amb); border-right-color: var(--amb); }
/* receipt popovers (rpop-compatible) */
.rcpt-toggle { font-size: 11px; color: var(--blue); cursor: pointer; margin-top: 3px;
               display: inline-block; border: none; background: none; padding: 0; font: inherit; }
/* conviction badge (core4) */
.conv-badge { font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: 8px;
              color: #fff; display: inline-block; }
.conv-sbuy { background: #0f8a4f; } .conv-buy { background: #3aa66f; }
.conv-hold { background: #8a93a1; } .conv-sell { background: #e0744b; }
.conv-ssell { background: var(--dn); }
/* ── shared ─── */
.verdict { display: inline-block; padding: 3px 9px; border-radius: 7px; font-size: 11px;
           font-weight: 700; white-space: nowrap; }
.v-conf { background: rgba(55,208,127,.14); color: var(--up); }
.v-dir  { background: rgba(242,178,77,.14); color: var(--amb); }
.v-inv  { background: rgba(255,106,106,.14); color: var(--dn); }
.v-ctx  { background: var(--line); color: var(--faint); }
/* ── alert timeline ─── */
.tl-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.tlf { padding: 6px 14px; border-radius: 9px; background: var(--line); color: var(--mut);
       font-weight: 700; font-size: 13px; cursor: pointer; border: none; font: inherit; }
.tlf.active { background: var(--blue); color: #fff; }
.tl-day { margin-bottom: 18px; }
.tl-date { font-size: 12px; font-weight: 700; color: var(--faint); text-transform: uppercase;
           letter-spacing: .05em; margin: 0 0 10px; }
.tl-item { border-left: 2px solid var(--line); padding: 0 0 0 18px; margin-left: 6px; position: relative; }
.tl-item summary { display: flex; align-items: center; gap: 10px; padding: 9px 0;
                   cursor: pointer; list-style: none; flex-wrap: wrap; }
.tl-item summary::-webkit-details-marker { display: none; }
.tl-node { position: absolute; left: -7px; top: 15px; width: 12px; height: 12px;
           border-radius: 50%; background: var(--faint); border: 2px solid var(--panel); }
.tl-node.n-high   { background: var(--dn); }
.tl-node.n-medium { background: var(--blue); }
.tl-node.n-info   { background: var(--mut); }
.tl-chip { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 7px;
           background: var(--line); color: var(--mut); }
.tl-chip.f-shock  { background: rgba(255,106,106,.14); color: var(--dn); }
.tl-chip.f-risk   { background: rgba(242,178,77,.14); color: var(--amb); }
.tl-chip.f-driver { background: rgba(93,139,255,.14); color: var(--blue); }
.tl-chip.f-alloc  { background: rgba(155,140,255,.14); color: var(--pur); }
.tl-asset { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 7px;
            background: var(--line2); color: var(--tx); }
.tl-head { font-weight: 600; color: var(--tx); font-size: 14px; flex: 1; min-width: 200px; }
.tl-time { font-size: 12px; color: var(--faint); font-weight: 600; }
.tl-detail { padding: 2px 0 12px; font-size: 13px; color: var(--mut); line-height: 1.6; }
.tl-item[hidden] { display: none; }
.tl-news { margin-top: 8px; padding: 8px 12px; background: var(--panel2);
           border-radius: 9px; border: 1px dashed var(--line); }
.tl-news-h { font-size: 12px; font-weight: 700; color: var(--tx); margin-bottom: 4px; }
.tl-news-item { display: block; font-size: 12.5px; color: var(--mut); padding: 2px 0; }
.tl-more { display: flex; justify-content: center; margin-top: 12px; }
.tl-more button { border: 1px solid var(--line); background: var(--panel2); color: var(--tx);
                  border-radius: 9px; padding: 8px 14px; font: inherit; font-size: 13px;
                  font-weight: 700; cursor: pointer; }
.tl-more button:hover { border-color: var(--blue); color: var(--blue); }
.tl-more button .tl-hide { display: none; }
.tl-more button.is-expanded .tl-show { display: none; }
.tl-more button.is-expanded .tl-hide { display: inline; }
/* catalysts */
.cat-list { display: flex; flex-direction: column; gap: 2px; }
.cat-row { display: flex; align-items: center; gap: 10px; padding: 9px 4px;
           border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.cat-row:last-child { border: none; }
.cat-date { font-weight: 700; color: var(--tx); font-size: 13px; min-width: 128px; }
.cat-type { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 7px; }
.ct-FOMC    { background: rgba(242,178,77,.14); color: var(--amb); }
.ct-OPEC    { background: rgba(255,106,106,.14); color: var(--dn); }
.ct-EIA_WPSR{ background: rgba(93,139,255,.14); color: var(--blue); }
.cat-label { flex: 1; font-size: 13.5px; color: var(--tx); min-width: 160px; }
.disclaimer { margin-top: 12px; font-size: 12px; color: var(--faint); line-height: 1.6; font-style: italic; }
/* foot */
.foot { margin-top: 34px; padding-top: 18px; border-top: 1px solid var(--line);
        font-size: 12px; color: var(--faint); line-height: 1.7; }
/* nav / site utilities (preserve existing patterns) */
html:not([data-lang="zh"]) .l-zh { display: none; }
html[data-lang="zh"] .l-en { display: none; }
.section-title { font-size: 13px; font-weight: 700; color: var(--mut); text-transform: uppercase;
                 letter-spacing: .05em; margin: 30px 4px 12px; }
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="wrap">

<!-- ========================= PAGE HEADER ========================= -->
<div class="hd">
  <div>
    <h1>{{ t('Commodities', '大宗商品') }}</h1>
    <div class="asof">{{ t('Sector intelligence · as of', '板块智能 · 截至') }} {{ as_of }}</div>
  </div>
  <div class="faint" style="font-size:12px;text-align:right">
    17 {{ t('commodities · energy · metals · grains · softs', '品种 · 能源 · 金属 · 谷物 · 软商品') }}<br>
    <span class="mut">{{ t('Bilingual EN / 中文 · dark / light', '中英双语 · 深色/浅色') }}</span>
  </div>
</div>

{% if vm %}
{% set br = vm.breadth %}
{% set ix = vm.index %}
{% set st = vm.stance %}

<!-- ========================= SECTION 1 — SECTOR GLANCE ========================= -->
<div class="hero">
  <!-- stance hero -->
  <div class="panel">
    <p class="kick">{{ t('Where commodities stand today', '大宗商品今日处境') }}</p>
    <div class="stance-word t-{{ st.tone }}">{{ t(st.word_en, st.word_zh) }}</div>
    <div class="stance-sub">{{ t(st.sub_en, st.sub_zh) }}</div>
    <div class="stance-tag">
      <span class="faint">{{ t('Macro backdrop', '宏观背景') }}</span> ·
      {{ t('dollar', '美元') }} <b>{{ td(complex.dollar_dir) }}</b> ·
      {{ t('growth', '增长') }} <b>{{ td(complex.growth_dir) }}</b>
      <span class="faint" data-tip-en="{{ complex.regime }} quadrant (dollar/growth axis)" data-tip-zh="{{ complex.regime }} 象限（美元/增长轴）"> · {{ td(complex.regime) }} ⓘ</span>
    </div>
  </div>
  <!-- breadth panel -->
  <div class="panel">
    <p class="kick">{{ t('Breadth — how many agree', '广度——有多少品种共振') }}</p>
    <div class="dotwrap">
      <div class="dotrow">
        <span class="lbl">{{ t('12-month trend up', '12个月趋势向上') }}</span>
        <div class="dots" id="d-trend">
          {% set n_up = (br.n_up_trend or 0)|int %}
          {% set n_tot = (br.n_members or 17)|int %}
          {% for i in range(n_tot) %}<span class="dot{{ ' on-up' if i < n_up else '' }}"></span>{% endfor %}
        </div>
        <span class="cnt up">{{ n_up }} / {{ n_tot }}</span>
      </div>
      <div class="dotrow">
        <span class="lbl">{{ t('Short-term momentum', '短期动量向上') }}</span>
        <div class="dots">
          {% set n_mom = (br.n_bull_momentum or 0)|int %}
          {% for i in range(n_tot) %}<span class="dot{{ ' on-amb' if i < n_mom else '' }}"></span>{% endfor %}
        </div>
        <span class="cnt amb">{{ n_mom }} / {{ n_tot }}</span>
      </div>
      <div class="dotrow">
        <span class="lbl">{{ t('Low risk / calm', '低风险 / 平稳') }}</span>
        <div class="dots">
          {% set n_lr = (br.n_low_risk or 0)|int %}
          {% for i in range(n_tot) %}<span class="dot{{ ' on-amb' if i < n_lr else '' }}"></span>{% endfor %}
        </div>
        <span class="cnt amb">{{ n_lr }} / {{ n_tot }}</span>
      </div>
    </div>
    {% if (br.n_up_trend or 0) > (n_tot * 0.55) and (br.n_bull_momentum or 0) < (n_tot * 0.4) %}
    <div class="diverge">
      <span>⚠</span>
      {{ t('Trend broad, momentum narrowing — classic late-move divergence, not a fresh breakout.',
           '趋势广泛，动量收窄——经典后期走势背离，并非新突破。') }}
    </div>
    {% endif %}
  </div>
</div>

<!-- ========================= SECTION 2 — SECTOR INDEX ========================= -->
<div class="grid g2" style="margin-bottom:4px">
  <!-- index card -->
  <div class="panel">
    <p class="kick">{{ t('Commodity index — the whole complex', '大宗商品指数——整个板块') }}</p>
    <div class="idx-top">
      <div>
        <div class="idx-val">
          {% if ix.ew is not none %}{{ ix.ew|round(0)|int }}{% else %}—{% endif %}
          {% if ix.chg_1m_pct is not none %}
          <span class="{{ 'up' if ix.chg_1m_pct >= 0 else 'dn' }}" style="font-size:14px">
            {{ '%+.1f'|format(ix.chg_1m_pct) }}% <span class="faint">/ 1m</span>
          </span>
          {% endif %}
        </div>
        <div class="faint" style="font-size:12px;margin-top:2px">{{ t('Equal-weight, chain-linked · 17 members since 2000', '等权链式指数 · 17个品种，自2000年') }}</div>
      </div>
      <div style="text-align:right">
        <div class="mut" style="font-size:12px">{{ t('Do the signals agree?', '各周期是否共振？') }}</div>
        <div style="font-weight:600;color:var(--amb)">{{ t(ix.mtf_en, ix.mtf_zh) }}</div>
      </div>
    </div>
    <!-- simple bar sparkline (built in JS from serialized data) -->
    <div class="spark" id="idx-spark"></div>
    <div class="idx-chips">
      {% if ix.ts_trend %}
      <span class="chip">{{ t('12-mo trend', '12月趋势') }}
        <b class="{{ 'up' if ix.ts_trend == 'up' else ('dn' if ix.ts_trend == 'down' else 'mut') }}">
          {{ t('Up','向上') if ix.ts_trend=='up' else (t('Down','向下') if ix.ts_trend=='down' else t('Flat','平稳')) }}
        </b>
      </span>
      {% endif %}
      {% if ix.shock_state and ix.shock_state != 'normal' %}
      <span class="chip">{{ t('Shock', '冲击') }} <b>{{ t(ix.shock_en, ix.shock_zh) }}</b></span>
      {% endif %}
      {% if ix.velocity_20 is not none %}
      <span class="chip" data-tip-en="20-day velocity: {{ '%+.1f'|format(ix.velocity_20) }}%" data-tip-zh="20日动能：{{ '%+.1f'|format(ix.velocity_20) }}%">
        {{ t('Velocity 20d', '20日动能') }}
        <b class="{{ 'up' if ix.velocity_20 >= 0 else 'dn' }}">{{ t('quick','快') if (ix.velocity_20|abs) > 1 else t('flat','平') }}</b>
      </span>
      {% endif %}
      {% if br.trend_diversity is not none %}
      <span class="chip" data-tip-en="Trend diversity score: {{ br.trend_diversity }}" data-tip-zh="趋势分散度：{{ br.trend_diversity }}">
        {{ t('Trend diversity', '趋势分散度') }}
        <b>{{ t('wide', '宽') if (br.trend_diversity or 0) > 0.4 else t('narrow', '窄') }}</b>
      </span>
      {% endif %}
      {% for bname, bdata in ix.benchmarks.items() %}
        {% if bdata.last is not none %}
        <span class="chip">{{ bname }} <b>{{ bdata.last }}</b></span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <!-- structural cycle summary -->
  <div class="panel">
    <p class="kick">{{ t('Structural cycle — where each member sits', '结构性周期——各品种所处位置') }}</p>
    <div class="cyc-chips">
      {% for cs in vm.cycle_summary %}
      <span class="cyc-chip ph-{{ cs.phase|lower }}">
        <b>{{ t(cs.phase_en, cs.phase_zh) }}</b>
        <span class="faint"> · </span>
        <span class="l-en">{{ cs.names_en|join(' · ') }}</span>
        <span class="l-zh">{{ cs.names_zh|join(' · ') }}</span>
      </span>
      {% endfor %}
      {% if not vm.cycle_summary %}
      <span class="faint" style="font-size:12px">{{ t('Cycle data pending', '周期数据待更新') }}</span>
      {% endif %}
    </div>
    <div class="faint" style="font-size:12px;margin-top:12px;line-height:1.6">
      {{ t('The structural clock feeds each commodity\'s bottom/top read in the board below.',
           '结构性时钟为下方底部/顶部面板中的各品种判断提供依据。') }}
    </div>
  </div>
</div>

<!-- ========================= SECTION 3 — BOTTOMS & TOPS BOARD ========================= -->
<div class="sechd">
  <h2>{{ t('Bottoms & tops forming', '底部与顶部形成中') }}</h2>
  <span class="q" data-tip-en="Confluence read — oversold/overbought, shock, positioning, cycle. Watch-list only, not a trade trigger." data-tip-zh="共振判读——超卖/超买、冲击、持仓、周期。仅供观察，非交易触发。">?</span>
  <p class="sub">{{ t('how the signals line up — oversold/overbought, shock, positioning, cycle', '引擎信号汇总——超卖/超买、冲击、持仓、周期') }}</p>
  <span class="tierlabel">{{ t('watch-list, not a trade trigger', '观察清单，非交易触发') }}</span>
</div>
<div class="board">
  <!-- tops column -->
  <div class="panel tcol bcol">
    <div class="bh">
      <span class="ic">▲</span>
      {{ t('Euphoric / extended — take profits, don\'t chase', '亢奋/超涨——获利了结，勿追高') }}
    </div>
    {% set tops = vm.board.tops %}
    {% if tops %}
      {% for row in tops %}
      <div class="brow">
        <div class="nm">
          {{ t(row.label_en, row.label_zh) }}
          {% if 'Euphoric' in row.state or 'rolling' in row.state %}
          <span class="badge euf">{{ t('Euphoric','亢奋') if 'Euphoric' in row.state else t('Rolling','转折') }}</span>
          {% elif 'Blowing' in row.state %}
          <span class="badge euf">{{ t('Blow-off','喷发') }}</span>
          {% else %}
          <span class="badge top">{{ t('Extended','超涨') }}</span>
          {% endif %}
        </div>
        <div class="st">
          {{ t(row.action_en, row.action_zh) }}
          {% if row.receipt %}
          <div class="rcpt-list">{{ t('fired:','触发:') }}
            {% for rc in row.receipt[:4] %}
              <span class="l-en">{{ rc.label_en }}</span><span class="l-zh">{{ rc.label_zh }}</span>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="meter t" style="margin-top:2px"><i style="width:{{ [row.score or 0, 100]|min }}%"></i></div>
        <span class="sc dn">{{ row.score|int if row.score is not none else '—' }}</span>
      </div>
      {% endfor %}
    {% else %}
    <div class="faint" style="font-size:12.5px;padding:12px 0">
      {{ t('No euphoric or extended signals right now.', '目前无亢奋或超涨信号。') }}
    </div>
    {% endif %}
  </div>
  <!-- bottoms column -->
  <div class="panel bcolb bcol">
    <div class="bh">
      <span class="ic">▼</span>
      {{ t('Washing out / basing — watch for the turn', '洗盘/筑底——关注转势信号') }}
    </div>
    {% set bottoms = vm.board.bottoms %}
    {% if bottoms %}
      {% for row in bottoms %}
      <div class="brow">
        <div class="nm">
          {{ t(row.label_en, row.label_zh) }}
          {% if 'Washing out' in row.state %}
          <span class="badge wash">{{ t('Washing out','洗盘中') }}</span>
          {% elif 'Washout bottom' in row.state %}
          <span class="badge wash">{{ t('Turn forming','转势中') }}</span>
          {% else %}
          <span class="badge neut">{{ t('Basing','筑底') }}</span>
          {% endif %}
        </div>
        <div class="st">
          {{ t(row.action_en, row.action_zh) }}
          {% if row.receipt %}
          <div class="rcpt-list">{{ t('fired:','触发:') }}
            {% for rc in row.receipt[:4] %}
              <span class="l-en">{{ rc.label_en }}</span><span class="l-zh">{{ rc.label_zh }}</span>{% if not loop.last %} · {% endif %}
            {% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="meter b" style="margin-top:2px"><i style="width:{{ [row.score or 0, 100]|min }}%"></i></div>
        <span class="sc mut">{{ row.score|int if row.score is not none else '—' }}</span>
      </div>
      {% endfor %}
    {% else %}
    <div class="faint" style="font-size:12.5px;padding:12px 0">
      {{ t('No washout or basing signals right now.', '目前无洗盘或筑底信号。') }}
    </div>
    {% endif %}
  </div>
</div>

<!-- ========================= SECTION 4 — HEAT GRID ========================= -->
<div class="sechd">
  <h2>{{ t('Every commodity at a glance', '一眼看遍所有品种') }}</h2>
  <p class="sub">{{ t('1-month move · short-term momentum · structural cycle', '1月涨跌 · 短期动量 · 结构性周期') }}</p>
</div>
<div class="legend">
  <span><span class="sw" style="background:var(--up)"></span>{{ t('Trending up','趋势向上') }}</span>
  <span><span class="sw" style="background:var(--dn)"></span>{{ t('Euphoric / falling','亢奋/下跌') }}</span>
  <span><span class="sw" style="background:var(--blue)"></span>{{ t('Washing out','洗盘中') }}</span>
  <span><span class="sw" style="background:var(--line2)"></span>{{ t('Flat / mixed','横盘/混合') }}</span>
</div>
{% for grp in vm.grid %}
<div class="grp"><span class="l-en">{{ grp.group_en }}</span><span class="l-zh">{{ grp.group_zh }}</span></div>
<div class="hgrid">
  {% for m in grp.members %}
  <div class="cell {{ m.tone or 'c-flat' }}">
    <div class="cn">
      <span class="cnm"><span class="l-en">{{ m.label_en }}</span><span class="l-zh">{{ m.label_zh }}</span></span>
      {% if m.chg_1m_pct is not none %}
      <span class="cpc {{ 'up' if (m.chg_1m_pct or 0) >= 0 else 'dn' }}">{{ '%+.1f'|format(m.chg_1m_pct) }}%</span>
      {% else %}<span class="cpc mut">—</span>{% endif %}
    </div>
    <div class="cmeta">
      <span>{{ t('cycle','周期') }}</span>
      <span><span class="l-en">{{ m.cycle_phase_en or '—' }}</span><span class="l-zh">{{ m.cycle_phase_zh or '—' }}</span></span>
    </div>
    <div class="cst">
      <span class="l-en">{{ m.state_short_en or '—' }}</span><span class="l-zh">{{ m.state_short_zh or '—' }}</span>
    </div>
  </div>
  {% endfor %}
</div>
{% endfor %}

<!-- ========================= SECTION 5 — PER-COMMODITY DETAIL ========================= -->
<div class="sechd">
  <h2>{{ t('Per-commodity detail', '逐品种详情') }}</h2>
  <p class="sub">{{ t('select a commodity to see its full read', '选择品种查看完整分析') }}</p>
</div>
<div class="dtabs" id="detail-tabs">
  {% for d in vm.detail %}
  <button class="dtab{{ ' active' if loop.first else '' }}" data-det="{{ d.name }}">
    <span class="l-en">{{ d.label_en }}</span><span class="l-zh">{{ d.label_zh }}</span>
  </button>
  {% endfor %}
</div>
{% for d in vm.detail %}
<div class="dpanel" data-detpanel="{{ d.name }}" {{ 'hidden' if not loop.first else '' }}>
  {% if not d.available %}
  <div class="panel" style="color:var(--faint);font-size:13px;padding:20px">
    {{ t('Data not available for this commodity yet.', '此品种数据暂不可用。') }}
  </div>
  {% else %}
  <div class="det">
    <!-- left: confluence call + cycle clock -->
    <div class="panel">
      <p class="kick">{{ t('What to do now', '当前该怎么做') }}</p>
      <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
        <span style="font-size:22px;font-weight:600">{{ t(d.action_en, d.action_zh) }}</span>
        {% if d.top_score is not none and (d.top_score or 0) >= 30 %}
        <span class="badge euf">{{ t('Top risk','顶部风险') }} · {{ d.top_score|int }}</span>
        {% elif d.bot_score is not none and (d.bot_score or 0) >= 25 %}
        <span class="badge wash">{{ t('Bottom watch','底部关注') }} · {{ d.bot_score|int }}</span>
        {% endif %}
      </div>
      <!-- confluence receipt -->
      {% set show_fired = (d.top_fired if (d.top_score or 0) >= (d.bot_score or 0) else d.bottom_fired) %}
      {% if show_fired %}
      <div style="margin-top:8px;font-size:12px;color:var(--mut);line-height:1.6">
        {{ t('Conditions:', '触发条件:') }}
        {% for rc in show_fired[:6] %}
          <span class="l-en">{{ rc.label_en }}</span><span class="l-zh">{{ rc.label_zh }}</span>{% if not loop.last %} · {% endif %}
        {% endfor %}
      </div>
      {% else %}
      <div style="margin-top:8px;font-size:12px;color:var(--faint)">
        {{ t('Watch — not enough signal yet', '观望——信号不足') }}
      </div>
      {% endif %}
      <!-- cycle clock -->
      <div class="clock-wrap">
        {% if d.cycle_phase %}
        {% set arc_cls = 'arc-up' if d.cycle_phase in ['Recovery','Expansion'] else ('arc-amb' if d.cycle_phase == 'Downturn' else '') %}
        <div class="arc {{ arc_cls }}"></div>
        <div>
          <div class="faint" style="font-size:11px">{{ t('structural cycle','结构性周期') }}</div>
          <div style="font-weight:600">
            <span class="l-en">{{ d.cycle_phase_en }}</span><span class="l-zh">{{ d.cycle_phase_zh }}</span>
            {% if d.cycle_hazard %}<span class="badge top" style="margin-left:6px">{{ t('hazard','风险') }}</span>{% endif %}
          </div>
          {% if d.shock_state and d.shock_state != 'normal' %}
          <div class="faint" style="font-size:11px;margin-top:3px">
            <span class="l-en">{{ d.shock_en }}</span><span class="l-zh">{{ d.shock_zh }}</span>
          </div>
          {% endif %}
        </div>
        {% else %}
        <div style="color:var(--faint);font-size:12px">
          {{ t('No structural cycle data for this commodity.', '此品种无结构性周期数据。') }}
        </div>
        {% endif %}
      </div>
      <!-- core4 conviction badge -->
      {% if d.is_core4 and d.conviction and d.conviction.action %}
      {% set cv = d.conviction %}
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--line)">
        <div class="faint" style="font-size:11px;margin-bottom:5px">{{ t('Calibrated conviction', '校准后裁决') }}</div>
        <div style="display:flex;align-items:center;gap:10px">
          <span class="conv-badge conv-{{ cv.action_css }}">{{ t(cv.action, cv.action_zh) }}</span>
          <span style="font-weight:600;color:var(--tx)">{{ '%+d'|format(cv.score|round|int) }}<span class="faint" style="font-size:12px"> / 100</span></span>
          <span class="faint" style="font-size:11.5px">{{ (cv.confidence*100)|round|int }}% {{ t('confidence','置信度') }}</span>
        </div>
        {% if cv.sub %}<div style="margin-top:6px;font-size:12.5px;color:var(--mut);line-height:1.55">{{ t(cv.sub, cv.sub_zh) }}</div>{% endif %}
      </div>
      {% endif %}
    </div>
    <!-- right: MTF signals table -->
    <div class="panel">
      <p class="kick">{{ t('Do the signals agree?', '各周期是否共振？') }}</p>
      {% if d.mtf_rows %}
      {% set tfc = {'up':'var(--up)','down':'var(--dn)','flat':'var(--line2)'} %}
      {% set mc  = {'up':'u','pos':'u','down':'d','neg':'d'} %}
      {% set mlab = {'up':'cross ↑','pos':'+','down':'cross ↓','neg':'−'} %}
      <table class="mtf">
        <tr><th>{{ t('Timeframe','周期') }}</th><th>{{ t('Trend','趋势') }}</th><th>RSI</th><th>{{ t('Stoch','随机') }}</th><th>MACD</th></tr>
        {% for r in d.mtf_rows %}
        <tr>
          <td>{{ t(r.label, r.label_zh) }}</td>
          <td><span class="pill {{ 'u' if r.trend=='up' else ('d' if r.trend=='down' else 'n') }}">
            {{ t('up','↑') if r.trend=='up' else (t('down','↓') if r.trend=='down' else t('flat','→')) }}
          </span></td>
          <td style="color:{{ 'var(--dn)' if (r.rsi14 or 50)>=70 else ('var(--up)' if (r.rsi14 or 50)<=30 else 'var(--tx)') }}">{{ r.rsi14 if r.rsi14 is not none else '—' }}</td>
          <td style="color:{{ 'var(--dn)' if (r.stoch or 50)>=80 else ('var(--up)' if (r.stoch or 50)<=20 else 'var(--tx)') }}">{{ r.stoch if r.stoch is not none else '—' }}</td>
          <td><span class="pill {{ mc.get(r.macd,'n') }}">{{ mlab.get(r.macd,'—') }}</span></td>
        </tr>
        {% endfor %}
      </table>
      {% if d.verdict and d.verdict.headline %}
      <div style="margin-top:10px;font-size:12.5px;color:var(--mut)">
        {{ t(d.verdict.headline, d.verdict.headline_zh) }}
      </div>
      {% endif %}
      <div class="faint" style="font-size:11.5px;margin-top:8px">
        {{ t('Red = overbought; green = oversold. Use the call above for meaning.',
             '红色=超买；绿色=超卖。含义以上方裁决为准。') }}
      </div>
      {% else %}
      <div class="faint" style="font-size:13px;padding:12px 0">
        {{ t('Technical data not available for this commodity.', '此品种技术数据暂不可用。') }}
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>
{% endfor %}

{% else %}
{# fallback when vm is empty (engine error) #}
<div class="panel" style="color:var(--faint);font-size:13.5px;padding:22px;margin-top:18px">
  {{ t('Commodity sector data is rebuilding — check back shortly.',
       '大宗商品板块数据重建中，请稍后刷新。') }}
</div>
{% endif %}

<!-- ========================= UPCOMING CATALYSTS ========================= -->
<div class="section-title">{{ t('Upcoming catalysts · OPEC · FOMC · EIA', '即将到来的催化剂 · OPEC · 美联储 · EIA') }}</div>
<div class="panel">
  {% if catalysts %}
  <div class="cat-list">
    {% for c in catalysts %}
    <div class="cat-row">
      <span class="cat-date">{{ c.date }}{% if c.time_et %} · {{ c.time_et }} ET{% endif %}</span>
      <span class="cat-type ct-{{ c.type }}">{{ td(c.type.replace('_',' ')) }}</span>
      <span class="cat-label">{{ td(c.label) }}</span>
      <span class="faint" style="font-size:12px">{% for a in c.assets %}{{ td(a|capitalize) }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
    </div>
    {% endfor %}
  </div>
  {% else %}<div class="faint" style="font-size:13px">{{ t('No scheduled OPEC/FOMC/EIA catalysts in the window.', '窗口内无预定的 OPEC/美联储/EIA 催化剂。') }}</div>{% endif %}
  <div class="disclaimer">{{ news_disclaimer }}</div>
</div>

<!-- ========================= ALERT TIMELINE ========================= -->
<div class="section-title" id="timeline">{{ t('Alert timeline · last', '警报时间线 · 最近') }} {{ timeline_days }} {{ t('days', '天') }}
  <span class="faint" style="font-weight:600;text-transform:none;letter-spacing:0"> · {{ n_alerts }} {{ t('alerts', '条警报') }}</span>
</div>
<div class="panel">
  <div class="tl-filters">
    {% set filter_zh = {'All':'全部','Shock':'冲击','Risk':'风险','Driver':'驱动','Allocation':'配置','Other':'其他'} %}
    {% for f,lab in [('all','All'),('shock','Shock'),('risk','Risk'),('driver','Driver'),('alloc','Allocation'),('other','Other')] %}
    <button class="tlf {{ 'active' if f=='all' else '' }}" data-f="{{ f }}">{{ t(lab, filter_zh[lab]) }}</button>{% endfor %}
  </div>
  {% if timeline %}
  <div class="timeline">
    {% for day in timeline %}
    <div class="tl-day">
      <div class="tl-date">{{ day.daylabel }}</div>
      {% for e in day.events %}
      <details class="tl-item" data-f="{{ e.filter }}">
        <summary>
          <span class="tl-node n-{{ e.severity }}"></span>
          <span class="tl-chip f-{{ e.filter }}">{{ e.label }}</span>
          {% if e.asset_label %}<span class="tl-asset">{{ td(e.asset_label) }}</span>{% endif %}
          <span class="tl-head">{{ t(e.headline, e.headline_zh) }}</span>
          <span class="tl-time">{{ e.time }}</span>
        </summary>
        <div class="tl-detail">{{ t(e.detail, e.detail_zh) }}
          {% if e.news %}
          <div class="tl-news">
            <div class="tl-news-h">{{ t('Context — news, not a signal', '背景 — 新闻，非信号') }}{% if e.news.likely_cause and e.news.likely_cause.cause != 'unknown' %} · {{ t('likely:', '可能：') }} <b>{{ e.news.likely_cause.cause|replace('_',' ') }}</b>{% endif %}</div>
            {% for h in e.news.headlines[:4] %}<a class="tl-news-item" href="{{ h.url }}" target="_blank" rel="noopener">{{ h.title }} <span class="faint">— {{ h.domain }}</span></a>{% endfor %}
          </div>
          {% endif %}
        </div>
      </details>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="tl-more">
    <button type="button" id="tl-more-btn" aria-expanded="false">
      <span class="tl-show">{{ t('See more alerts', '查看更多警报') }}</span>
      <span class="tl-hide">{{ t('Show fewer alerts', '收起警报') }}</span>
    </button>
  </div>
  {% else %}
  <div class="faint" style="font-size:13px;padding:10px 0">{{ t('No alerts in the last', '最近') }} {{ timeline_days }} {{ t('days.', '天无警报。') }}</div>
  {% endif %}
  <div class="faint" style="margin-top:14px;font-size:12px">{{ t('Alerts refresh from history; intraday price shocks are best-effort. Built', '警报由历史重算；日内价格冲击为尽力更新。生成于') }} {{ built }}.</div>
</div>

<div class="foot">
  Commodities · {{ t('built','生成于') }} {{ built }} · {{ t('data as of','数据截至') }} {{ as_of }}<br>
