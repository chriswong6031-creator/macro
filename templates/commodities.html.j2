{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro vbadge(v) -%}
{% if 'CONFIRMED' in v %}<span class="verdict v-conf">{{ td(v) }}</span>
{%- elif 'INVERTED' in v %}<span class="verdict v-inv">{{ td('INVERTED') }}</span>
{%- elif 'DIRECTIONAL' in v %}<span class="verdict v-dir">{{ td('DIRECTIONAL') }}</span>
{%- elif v %}<span class="verdict v-ctx">{{ td('CONTEXT') }}</span>{% endif %}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Commodity Vector — {{ as_of }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r1:{{C.r1}}; --r2:{{C.r2}}; --r3:{{C.r3}};
  --r4:{{C.r4}}; --r5:{{C.r5}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --redfill:{{C.redfill}}; --amber:{{C.amber}};
  --green:{{C.green}}; --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB",
  "Microsoft YaHei","Noto Sans CJK SC","Microsoft JhengHei","Heiti SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.topbar{display:flex;align-items:center;justify-content:space-between;
  padding:18px 0 14px;border-bottom:1px solid var(--grid);margin-bottom:24px;
  position:sticky;top:0;background:var(--bg);z-index:20}
.brand{font-weight:800;font-size:20px;color:var(--ink);letter-spacing:-.02em}
.brand .gn{color:var(--amber)}
.nav a{margin-left:14px;font-weight:600;font-size:14px;color:var(--muted)}
.nav a:hover{color:var(--blue)} .nav a.active{color:var(--ink)}
/* unified menu — congruent with the macro dashboard nav (pill links + animated
   EN/中文 toggle). Light-only by design, so no dark/light switch here. */
.nav-links{display:flex;align-items:center;gap:2px;flex-wrap:wrap}
a.nav-link{padding:7px 11px;border-radius:9px;font-size:13.5px;font-weight:500;color:var(--muted);text-decoration:none;white-space:nowrap;transition:color .18s,background .18s}
a.nav-link:hover,a.nav-link.active{color:var(--ink);background:#eef1f6}
html[data-theme="dark"] a.nav-link:hover,html[data-theme="dark"] a.nav-link.active{background:#222732}
/* Bitcoin Vector dropdown — congruent with vector.html (Allocation lives under the
   Bitcoin Vector item). CSS-only (hover + focus-within); ::after bridges the gap. */
.nav-dd{position:relative;display:inline-flex}
.nav-dd>a.nav-link .caret{display:inline-block;margin-left:3px;font-size:9px;opacity:.6;transition:transform .2s}
.nav-dd:hover>a.nav-link .caret,.nav-dd:focus-within>a.nav-link .caret{transform:rotate(180deg)}
.nav-dd::after{content:"";position:absolute;left:0;right:0;top:100%;height:9px}
.nav-dd-menu{position:absolute;top:calc(100% + 7px);left:0;min-width:218px;background:var(--card);border:1px solid var(--grid);border-radius:13px;box-shadow:0 12px 34px rgba(16,24,40,.14);padding:6px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:70}
.nav-dd:hover>.nav-dd-menu,.nav-dd:focus-within>.nav-dd-menu{opacity:1;visibility:visible;transform:translateY(0)}
.nav-dd-menu a{display:block;padding:9px 12px;border-radius:9px;font-size:13.5px;font-weight:600;color:var(--text);text-decoration:none;white-space:nowrap;transition:background .15s,color .15s}
.nav-dd-menu a .d{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:2px}
.nav-dd-menu a:hover,.nav-dd-menu a.active{background:#eef1f6;color:var(--ink)}
html[data-theme="dark"] .nav-dd-menu a:hover,html[data-theme="dark"] .nav-dd-menu a.active{background:#222732}
.lang-toggle{display:inline-flex;position:relative;background:#eef1f6;border:1px solid var(--grid);border-radius:999px;padding:3px;cursor:pointer;flex:none}
.lang-toggle .pill{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);border-radius:999px;background:var(--blue);transition:transform .34s cubic-bezier(.34,1.4,.5,1)}
html[data-lang="zh"] .lang-toggle .pill{transform:translateX(100%)}
.lang-toggle .opt{position:relative;z-index:1;min-width:28px;text-align:center;padding:3px 9px;font-size:11.5px;font-weight:600;color:var(--muted);transition:color .25s;user-select:none}
html:not([data-lang="zh"]) .lang-toggle .en-opt{color:#fff}
html[data-lang="zh"] .lang-toggle .zh-opt{color:#fff}
.nav-ctrls{display:flex;align-items:center;gap:10px;flex:none}
/* dark mode — toggled by html[data-theme="dark"]; light is the default. Page is
   var-based, so overriding the palette re-themes it (accents kept). */
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280;--r1:#1b2740;--r2:#243352}
/* animated dark/light switch — light default = knob right + sun; dark = left + moon */
.theme-switch{width:56px;height:27px;border-radius:999px;background:#eef1f6;border:1px solid var(--grid);position:relative;cursor:pointer;padding:0;flex:none}
html[data-theme="dark"] .theme-switch{background:#222732}
.theme-switch .ic{position:absolute;top:50%;transform:translateY(-50%);font-size:10.5px;opacity:.5;line-height:1}
.theme-switch .ic.sun{right:8px}.theme-switch .ic.moon{left:8px} /* opposite the knob's rest side, else two suns / two moons show */
.theme-switch .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 5px rgba(0,0,0,.3);transform:translateX(29px);transition:transform .34s cubic-bezier(.34,1.45,.5,1),background .3s}
.theme-switch .knob::before{content:"☀️"}
html[data-theme="dark"] .theme-switch .knob{transform:translateX(0);background:#e8c15a}
html[data-theme="dark"] .theme-switch .knob::before{content:"🌙"}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.1fr .9fr} .cols-3{grid-template-columns:repeat(3,1fr)}
.cols-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.cols-2,.cols-3,.cols-4{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.04em}
.card h3{margin:0 0 12px;font-size:18px;font-weight:700;color:var(--ink)}
.sub{color:var(--muted);font-size:13px} .mut{color:var(--muted)} .faint{color:var(--faint)}
.section-title{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;
  letter-spacing:.05em;margin:30px 4px 12px}
.hero-state{font-size:50px;font-weight:800;color:var(--ink);line-height:1.05;letter-spacing:-.03em}
.hero-meta{margin-top:12px;font-size:15px}
.up{color:var(--green)} .down{color:var(--red)}
.pill{display:inline-block;padding:5px 12px;border-radius:9px;background:var(--bg);
  font-weight:700;font-size:13px;margin:3px 6px 3px 0}
.pill.fav{background:#E8EEFF;color:var(--blue)}
/* asset selector + quick cards */
.asset-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:6px 0 8px}
@media(max-width:760px){.asset-tabs{grid-template-columns:repeat(2,1fr)}}
.atab{background:var(--card);border:1.5px solid var(--grid);border-radius:14px;padding:14px 16px;
  cursor:pointer;text-align:left;transition:border-color .12s,box-shadow .12s}
.atab:hover{border-color:var(--r3)}
.atab.active{border-color:var(--blue);box-shadow:0 2px 10px rgba(40,95,255,.12)}
.atab .an{font-weight:800;color:var(--ink);font-size:16px}
.atab .ap{font-weight:700;color:var(--ink);font-size:15px;margin-top:3px}
.atab .am{font-size:12px;font-weight:700;margin-top:4px;color:var(--muted)}
.atab .tag{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:6px;
  background:var(--grid);color:var(--muted);margin-top:6px}
.atab .tag.calm{background:#E3F5E9;color:var(--green)} .atab .tag.elev{background:#FDEBEB;color:var(--red)}
.asset-panel[hidden]{display:none}
/* slider gauge */
.slider{margin:16px 0 6px}
.slider .track{position:relative;height:8px;border-radius:6px;
  background:linear-gradient(90deg,var(--r1),var(--r2),var(--r4),var(--r5))}
.slider .knob{position:absolute;top:50%;width:18px;height:18px;border-radius:50%;
  background:#fff;border:3px solid var(--blue);transform:translate(-50%,-50%);box-shadow:0 1px 4px rgba(0,0,0,.15)}
.slider .labels{display:flex;justify-content:space-between;margin-top:8px;font-size:12px;color:var(--muted);font-weight:600}
.slider .labels span.cur{color:var(--ink)}
.mini{margin-top:10px}
.mini .lab{display:flex;justify-content:space-between;font-size:13px;color:var(--muted)}
.mini .bar{height:6px;border-radius:4px;background:var(--grid);position:relative;margin:6px 0}
.mini .fill{position:absolute;height:100%;border-radius:4px;background:var(--blue)}
.mini .fill.red{background:var(--red)}
.allocbar{height:42px;border-radius:12px;overflow:hidden;display:flex;font-weight:700;color:#fff;margin-top:6px}
.allocbar .a{background:linear-gradient(90deg,var(--r4),var(--blue));display:flex;align-items:center;justify-content:center}
.allocbar .cash{background:linear-gradient(90deg,#cfd4dc,#9aa4b2);display:flex;align-items:center;justify-content:center}
.chip{display:inline-block;padding:5px 12px;border-radius:9px;font-weight:700;font-size:13px}
.chip-bull{background:var(--indigo);color:#fff} .chip-bear{background:var(--r2);color:#fff}
.chip-ghost{background:var(--grid);color:var(--muted)}
.chip-up{background:#E3F5E9;color:var(--green)} .chip-down{background:#FDEBEB;color:var(--red)}
.metric-row{display:flex;margin-top:16px;border-top:1px solid var(--grid);padding-top:14px}
.metric-row .m{flex:1;text-align:center}
.metric-row .m .k{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.metric-row .m .v{font-size:17px;font-weight:700;color:var(--ink);margin-top:2px}
.verdict{display:inline-block;padding:3px 9px;border-radius:7px;font-size:11px;font-weight:700;white-space:nowrap}
.v-conf{background:#E3F5E9;color:var(--green)} .v-dir{background:#FFF2D9;color:#9a6a00}
.v-inv{background:#FDEBEB;color:var(--red)} .v-ctx{background:var(--grid);color:var(--muted)}
.sigline{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--grid)}
.sigline:last-child{border:none} .sigline .l{font-weight:600;color:var(--ink)} .sigline .r{text-align:right}
.score{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.score .s{background:var(--bg);border-radius:10px;padding:12px;text-align:center}
html[data-theme="dark"] .score .s{background:var(--grid)} /* --bg is near-black in dark → lift tiles to the card-elevation grey so they read on the card */
.score .s .k{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase}
.score .s .v{font-size:20px;font-weight:800;color:var(--ink)}
.score .s .h{font-size:11px;color:var(--faint);margin-top:2px}
.catbl{width:100%;border-collapse:collapse}
.catbl td,.catbl th{padding:8px 4px;border-bottom:1px solid var(--grid);font-size:13.5px;text-align:left}
.catbl th{color:var(--muted);font-weight:700;font-size:12px;text-transform:uppercase}
.catbl td.a{font-weight:700;color:var(--ink)} .catbl td.r,.catbl th.r{text-align:right}
.catbl tr:last-child td{border-bottom:none}
.tip{border-bottom:1px dashed var(--faint);cursor:help}
/* ===== conviction verdict ===== */
.conv{border-width:2px}
.conv-head{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.conv-badge{font-size:22px;font-weight:800;letter-spacing:-.01em;padding:10px 18px;border-radius:13px;color:#fff;white-space:nowrap}
.conv-sbuy{background:#0f8a4f} .conv-buy{background:#3aa66f} .conv-hold{background:#8a93a1}
.conv-sell{background:#e0744b} .conv-ssell{background:var(--red)}
.conv-score{font-size:34px;font-weight:800;color:var(--ink);line-height:1}
.conv-score small{font-size:15px;color:var(--faint);font-weight:600}
.conv-meta{display:flex;flex-direction:column;gap:3px}
.conv-cmeta{font-size:12.5px;color:var(--muted);font-weight:600}
.conv-ctx{display:inline-block;font-size:11px;font-weight:700;padding:1px 8px;border-radius:6px;background:#FFF2D9;color:#9a6a00;margin-left:6px}
.conv-narr{margin-top:12px;font-size:14px;color:var(--text);line-height:1.55}
/* diverging conviction meter (-100..+100) */
.conv-meter{position:relative;height:12px;border-radius:7px;background:linear-gradient(90deg,color-mix(in srgb,var(--red) 22%,var(--card)),var(--grid) 48%,var(--grid) 52%,color-mix(in srgb,var(--green) 22%,var(--card)));margin:16px 0 6px}
.conv-meter .mk{position:absolute;top:-3px;width:4px;height:18px;border-radius:3px;background:var(--ink);transform:translateX(-50%)}
.conv-meter .zero{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.5}
.conv-scale{display:flex;justify-content:space-between;font-size:10.5px;color:var(--faint);font-weight:600}
/* inflection banner + macro pulse + freshness stamp (2026-06 upgrade) */
.conv-infl{margin:14px 0 2px;padding:11px 14px;border-radius:11px;border:1px solid;font-size:13px;line-height:1.5;font-weight:600}
.conv-infl.price_only{background:#FFF6E6;border-color:#F2C97D;color:#8a5a00}
.conv-infl.confirming{background:#EAF5EE;border-color:#9ED0B2;color:#196b3e}
.conv-fresh{display:inline-block;font-size:11px;font-weight:700;padding:1px 8px;border-radius:6px;background:#FDECEC;color:#a23;margin-left:6px}
.mpulse{margin-top:14px;padding:13px 15px;border:1px solid var(--grid);border-radius:12px;background:var(--bg)}
.mpulse-h{display:flex;justify-content:space-between;align-items:baseline;font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:9px;gap:10px;flex-wrap:wrap}
.mp-row{display:grid;grid-template-columns:92px 1fr 62px;gap:10px;align-items:center;font-size:12.5px;padding:3px 0}
.mp-lab{color:var(--text);font-weight:600}
.mp-bar{position:relative;height:8px;border-radius:5px;background:var(--grid);overflow:hidden}
.mp-bar .slow{position:absolute;top:-2px;height:12px;width:2px;background:var(--faint);transform:translateX(-50%)}
.mp-bar .fast{position:absolute;top:0;bottom:0}
.mp-bar .fast.sup{background:var(--green)} .mp-bar .fast.hw{background:var(--red)}
.mp-tag{font-size:10px;font-weight:700;padding:1px 6px;border-radius:5px;white-space:nowrap;text-align:center}
.mp-tag.turning{background:#EAF5EE;color:#196b3e} .mp-tag.fading{background:#FDECEC;color:#a23} .mp-tag.flat{background:var(--grid);color:var(--muted)}
/* cycle position */
.conv-cycle{margin-top:16px;padding:13px 15px;border:1px solid var(--grid);border-radius:12px;background:var(--bg)}
.cyc-row{display:flex;justify-content:space-between;align-items:baseline;font-size:13px;gap:10px;flex-wrap:wrap}
.cyc-leg{font-weight:800;color:var(--ink)} .cyc-leg.bull{color:var(--green)} .cyc-leg.bear{color:var(--red)}
.cyc-bar{position:relative;height:9px;border-radius:5px;background:var(--grid);margin:9px 0 5px;overflow:hidden}
.cyc-prog{position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:linear-gradient(90deg,var(--r3),var(--blue))}
.cyc-prog.od{background:linear-gradient(90deg,var(--amber),var(--red))}
/* factor breakdown */
.fgrp{margin-top:16px}
.fgrp-h{display:flex;justify-content:space-between;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:12px 0 6px;border-bottom:1px solid var(--grid);padding-bottom:5px}
.frow{display:grid;grid-template-columns:148px 1fr 84px;align-items:center;gap:10px;padding:4px 0;font-size:13px}
.frow .fl{color:var(--ink);font-weight:600}
.frow .fl .fr{display:block;font-size:11px;font-weight:500;color:var(--muted)}
.fbar{position:relative;height:14px;background:var(--bg);border-radius:4px}
.fbar .fmid{position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--grid)}
.fbar .ff{position:absolute;top:0;bottom:0;border-radius:3px}
.fbar .ff.pos{background:var(--green)} .fbar .ff.neg{background:var(--red)}
html[data-theme="dark"] .fbar{background:var(--grid)} /* --bg near-black in dark → lift the rail to card-elevation grey */
html[data-theme="dark"] .fbar .fmid{background:var(--card)} /* keep the centre tick visible against the lifted grey rail */
.frow .fw{font-size:11px;color:var(--faint);text-align:right;font-weight:600}
@media(max-width:600px){.frow{grid-template-columns:120px 1fr 60px}}
/* alert timeline */
.tl-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.tlf{padding:6px 14px;border-radius:9px;background:var(--grid);color:var(--muted);font-weight:700;font-size:13px;cursor:pointer;border:none}
.tlf.active{background:var(--blue);color:#fff}
.tl-day{margin-bottom:18px}
.tl-date{font-size:12px;font-weight:700;color:var(--faint);text-transform:uppercase;letter-spacing:.05em;margin:0 0 10px}
.tl-item{border-left:2px solid var(--grid);padding:0 0 0 18px;margin-left:6px;position:relative}
.tl-item summary{display:flex;align-items:center;gap:10px;padding:9px 0;cursor:pointer;list-style:none;flex-wrap:wrap}
.tl-item summary::-webkit-details-marker{display:none}
.tl-node{position:absolute;left:-7px;top:15px;width:12px;height:12px;border-radius:50%;background:var(--faint);border:2px solid var(--card)}
.tl-node.n-high{background:var(--red)} .tl-node.n-medium{background:var(--blue)} .tl-node.n-info{background:var(--r3)}
.tl-chip{font-size:11px;font-weight:700;padding:2px 9px;border-radius:7px;background:var(--grid);color:var(--muted)}
.tl-chip.f-shock{background:#FDEBEB;color:var(--red)} .tl-chip.f-risk{background:#FFF2D9;color:#9a6a00}
.tl-chip.f-driver{background:#E8EEFF;color:var(--blue)} .tl-chip.f-alloc{background:#ECE9FB;color:var(--indigo)}
.tl-asset{font-size:11px;font-weight:700;padding:2px 8px;border-radius:7px;background:var(--bg);color:var(--ink)}
html[data-theme="dark"] .tl-asset{background:var(--grid)} /* --bg is near-black in dark → use the lighter grid grey so the pill reads on the card */
.tl-head{font-weight:600;color:var(--ink);font-size:14px;flex:1;min-width:200px}
.tl-time{font-size:12px;color:var(--faint);font-weight:600}
.tl-detail{padding:2px 0 12px;font-size:13px;color:var(--muted);line-height:1.6}
.tl-item[hidden]{display:none}
.tl-news{margin-top:8px;padding:8px 12px;background:var(--bg);border-radius:9px;border:1px dashed var(--grid)}
.tl-news-h{font-size:12px;font-weight:700;color:var(--ink);margin-bottom:4px}
.tl-news-item{display:block;font-size:12.5px;color:var(--text);padding:2px 0}
/* upcoming catalysts */
.cat-list{display:flex;flex-direction:column;gap:2px}
.cat-row{display:flex;align-items:center;gap:10px;padding:9px 4px;border-bottom:1px solid var(--grid);flex-wrap:wrap}
.cat-row:last-child{border:none}
.cat-date{font-weight:700;color:var(--ink);font-size:13px;min-width:128px}
.cat-type{font-size:11px;font-weight:700;padding:2px 9px;border-radius:7px}
.ct-FOMC{background:#FFF2D9;color:#9a6a00} .ct-OPEC{background:#FDEBEB;color:var(--red)} .ct-EIA_WPSR{background:#E8EEFF;color:var(--blue)}
.cat-label{flex:1;font-size:13.5px;color:var(--text);min-width:160px}
.disclaimer{margin-top:12px;font-size:12px;color:var(--faint);line-height:1.6;font-style:italic}
.foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--faint);line-height:1.7}
