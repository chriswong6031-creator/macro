  <div class="faint" style="font-size:13px;padding:10px 0">{{ t('No alerts in the last', '最近') }} {{ timeline_days }} {{ t('days.', '天无警报。') }}</div>
  {% endif %}
  <div class="faint" style="margin-top:14px;font-size:12px">{{ t('Alerts refresh from history; intraday price shocks are best-effort. Built', '警报由历史重算；日内价格冲击为尽力更新。生成于') }} {{ built }}.</div>
</div>

<div class="foot">
  {{ t('Commodities','大宗商品') }} · {{ t('built','生成于') }} {{ built }} · {{ t('data as of','数据截至') }} {{ as_of }}<br>
  <span style="font-size:11px">© 2026 Mastermind Inc</span>
</div>
</div>{# /wrap #}

<script>
/* ── detail tab selector ── */
(function(){
  var tabs=document.querySelectorAll('.dtab'), panels=document.querySelectorAll('.dpanel');
  tabs.forEach(function(b){b.addEventListener('click',function(){
    tabs.forEach(function(x){x.classList.remove('active')}); b.classList.add('active');
    var k=b.dataset.det;
    panels.forEach(function(p){ p.hidden = p.dataset.detpanel!==k; });
  });});
})();

/* ── alert timeline filter + more ── */
(function(){
  var fil=document.querySelectorAll('.tlf'), items=[].slice.call(document.querySelectorAll('.tl-item'));
  var more=document.getElementById('tl-more-btn'), state={filter:'all', expanded:false}, limit=8;
  function applyTimeline(){
    var shown=0, matching=0;
    items.forEach(function(it){
      var match=state.filter==='all'||it.dataset.f===state.filter;
      if(!match){ it.hidden=true; return; }
      matching += 1; shown += 1;
      it.hidden=!state.expanded && shown>limit;
    });
    document.querySelectorAll('.tl-day').forEach(function(d){
      var any=[].slice.call(d.querySelectorAll('.tl-item')).some(function(i){return !i.hidden});
      d.style.display=any?'':'none';
    });
    if(more){
      more.parentElement.style.display=matching>limit?'flex':'none';
      more.setAttribute('aria-expanded', state.expanded?'true':'false');
      more.classList.toggle('is-expanded', state.expanded);
    }
  }
  fil.forEach(function(b){b.addEventListener('click',function(){
    fil.forEach(function(x){x.classList.remove('active')}); b.classList.add('active');
    state.filter=b.dataset.f; state.expanded=false; applyTimeline();
  });});
  if(more){ more.addEventListener('click',function(){ state.expanded=!state.expanded; applyTimeline(); }); }
  applyTimeline();
})();

/* ── SVG area sparkline for the index ── */
(function(){
  try {
    var svg = document.getElementById('idx-spark-svg');
    if (!svg) return;
    {% if idx_ew_spark %}
    var raw = {{ idx_ew_spark | tojson }};
    var vals = raw.filter(function(v){ return v != null; });
    if (vals.length < 4) return;
    var mn = Math.min.apply(null,vals), mx = Math.max.apply(null,vals);
    var rng = mx - mn || 1;
    var W = 600, H = 52;
    svg.setAttribute('viewBox','0 0 ' + W + ' ' + H);
    var n = raw.length;
    var pts = raw.map(function(v, i){
      var x = (i/(n-1)) * W;
      var y = v == null ? H : H - Math.max(2, Math.round((v-mn)/rng*(H-6)));
      return [x, y];
    });
    /* area path */
    var d = 'M' + pts[0][0] + ',' + pts[0][1];
    for (var i=1; i<pts.length; i++) {
      if (raw[i] == null) continue;
      d += ' L' + pts[i][0] + ',' + pts[i][1];
    }
    var areaD = d + ' L' + pts[pts.length-1][0] + ',' + H + ' L' + pts[0][0] + ',' + H + ' Z';
    var isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    var lineColor = isDark ? 'rgba(55,208,127,.85)' : 'rgba(26,127,67,.85)';
    var gradId = 'sg' + Math.random().toString(36).slice(2,7);
    svg.innerHTML =
      '<defs><linearGradient id="'+gradId+'" x1="0" y1="0" x2="0" y2="1">' +
        '<stop offset="0%" stop-color="' + lineColor + '" stop-opacity="0.25"/>' +
        '<stop offset="100%" stop-color="' + lineColor + '" stop-opacity="0.02"/>' +
      '</linearGradient><filter id="sfglow"><feGaussianBlur stdDeviation="1.5" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>' +
      '<path d="'+areaD+'" fill="url(#'+gradId+')" stroke="none"/>' +
      '<path id="spark-line" d="'+d+'" fill="none" stroke="'+lineColor+'" stroke-width="2" filter="url(#sfglow)" stroke-linecap="round" stroke-linejoin="round"/>';
    /* draw-in animation via stroke-dashoffset */
    var line = svg.getElementById('spark-line');
    if (line && line.getTotalLength) {
      try {
        var len = line.getTotalLength();
        line.style.strokeDasharray = len;
        line.style.strokeDashoffset = len;
        line.style.transition = 'stroke-dashoffset 1.1s ease-out';
        requestAnimationFrame(function(){ line.style.strokeDashoffset = '0'; });
      } catch(e){}
    }
    /* endpoint pulse dot */
    var last = pts[pts.length-1];
    var dot = document.createElementNS('http://www.w3.org/2000/svg','circle');
    dot.setAttribute('cx', last[0]); dot.setAttribute('cy', last[1]);
    dot.setAttribute('r','4'); dot.setAttribute('fill', lineColor);
    dot.style.cssText = 'animation: dot-pulse 2s ease-in-out infinite';
    svg.appendChild(dot);
    var sty = document.createElement('style');
    sty.textContent = '@keyframes dot-pulse{0%,100%{r:3;opacity:.8}50%{r:5;opacity:1}}@media(prefers-reduced-motion:reduce){circle[cx]{animation:none}}';
    document.head.appendChild(sty);
    {% endif %}
  } catch(e){}
})();

/* ── staggered dot fade-in on load ── */
(function(){
  var dots = [].slice.call(document.querySelectorAll('.dot'));
  dots.forEach(function(d,i){
    setTimeout(function(){ d.classList.add('vis'); }, 20 + i * 8);
  });
})();

/* ── animated meter bars ── */
(function(){
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('.meter i[data-w]').forEach(function(el){
      var w = parseFloat(el.getAttribute('data-w')) || 0;
      el.style.width = '0';
      requestAnimationFrame(function(){
        el.style.width = Math.min(w, 100) + '%';
      });
    });
  });
  /* fallback if DOMContentLoaded already fired */
  if (document.readyState !== 'loading'){
    document.querySelectorAll('.meter i[data-w]').forEach(function(el){
      requestAnimationFrame(function(){ el.style.width = Math.min(parseFloat(el.getAttribute('data-w'))||0,100)+'%'; });
    });
  }
})();

/* ── heat grid 1m% bar animation ── */
(function(){
  function animateBars(){
    document.querySelectorAll('.chg-bar[data-w]').forEach(function(el){
      var w = parseFloat(el.getAttribute('data-w')) || 0;
      el.style.width = Math.min(w, 100) + '%';
    });
  }
  if (document.readyState !== 'loading') { requestAnimationFrame(animateBars); }
  else { document.addEventListener('DOMContentLoaded', animateBars); }
})();

/* ── live pill observer: light up when live.js patches a price ── */
(function(){
  var syms = ['GC=F','SI=F','HG=F','CL=F'];
  syms.forEach(function(sym){
    var pill = document.querySelector('[data-live-pill="'+sym+'"]');
    var px   = document.querySelector('.nb-px[data-sym="'+sym+'"]');
    if (!pill || !px) return;
    var obs = new MutationObserver(function(){
      pill.classList.add('on');
    });
    obs.observe(px, {childList:true, characterData:true, subtree:true});
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
