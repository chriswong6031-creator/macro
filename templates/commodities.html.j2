          <div class="tl-news">
            <div class="tl-news-h">{{ t('Context — news, not a signal', '背景 — 新闻，非信号') }}
              {% if e.cause_en is defined %}
               · {{ t('likely:', '可能：') }} <b><span class="l-en">{{ e.cause_en }}</span><span class="l-zh">{{ e.cause_zh }}</span></b>
              {% endif %}
            </div>
            {% for h in e.news.headlines[:4] %}<a class="tl-news-item" href="{{ h.url }}" target="_blank" rel="noopener">{{ h.title }} <span class="faint">— {{ h.domain }}</span></a>{% endfor %}
          </div>
          {% endif %}
