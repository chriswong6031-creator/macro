<title>Commodities — {{ as_of }}</title>
{% set seo_title = 'Commodities Sector Intelligence — Mastermind' %}
{% set seo_desc = 'Live commodity sector read: sector stance, index breadth, bottoms & tops early-warning board, trend-diversity heat grid, and per-commodity detail for all 17 members.' %}
{% set seo_path = 'commodities.html' %}
{% include "_seo_head.html.j2" %}
