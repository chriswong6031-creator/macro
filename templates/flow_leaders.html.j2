{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{# ── Confluence ladder (the signature): one dot per confirmation. Filled = the
     sign is confirming, dim outline = not yet, dotted = data not in yet. All
     meaning lives on the Tier-2 hover (data-tip) — no K-of-N jargon on the glance. #}
{% macro ladder(row, legs) -%}
{%- set ns = namespace(segs=[], lit_en=[], lit_zh=[], miss_en=[], miss_zh=[], nlit=0, navail=0) -%}
{%- for f, en, zh in legs -%}
  {%- set v = row[f] if f in row else none -%}
  {%- if v is none -%}
    {%- set ns.segs = ns.segs + ['nul'] -%}
  {%- elif v -%}
    {%- set ns.segs = ns.segs + ['on'] -%}
    {%- set ns.lit_en = ns.lit_en + [en] -%}{%- set ns.lit_zh = ns.lit_zh + [zh] -%}
    {%- set ns.nlit = ns.nlit + 1 -%}{%- set ns.navail = ns.navail + 1 -%}
  {%- else -%}
    {%- set ns.segs = ns.segs + ['off'] -%}
    {%- set ns.miss_en = ns.miss_en + [en] -%}{%- set ns.miss_zh = ns.miss_zh + [zh] -%}
    {%- set ns.navail = ns.navail + 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- set tip_en = (ns.nlit|string) ~ ' of ' ~ (ns.navail|string) ~ ' signs confirming' ~ (('  ·  ' ~ ns.lit_en|join(' · ')) if ns.lit_en else '') ~ (('.  Not yet — ' ~ ns.miss_en|join(' · ')) if ns.miss_en else '') -%}
{%- set tip_zh = (ns.navail|string) ~ ' 项信号中 ' ~ (ns.nlit|string) ~ ' 项确认' ~ (('：' ~ ns.lit_zh|join('、')) if ns.lit_zh else '') ~ (('。尚缺：' ~ ns.miss_zh|join('、')) if ns.miss_zh else '') -%}
<span class="ladder" data-tip-en="{{ tip_en }}" data-tip-zh="{{ tip_zh }}" role="img" aria-label="{{ tip_en }}">
{%- for s in ns.segs -%}<i class="seg seg-{{ s }}" style="--i:{{ loop.index0 }}"></i>{%- endfor -%}
</span>
{%- endmacro %}
{% set fl = flow_leaders if flow_leaders else {} %}
{% set board_a = fl.board_a if fl.board_a is defined and fl.board_a is not none else [] %}
{% set board_b_raw = fl.board_b if fl.board_b is defined and fl.board_b is not none else [] %}
{# Board B robustness guard: only names that actually inflected belong on the
   "turned back up" board. The builder may hand the full universe; keep the turns.
   Mirrors the builder's admission rule exactly — B5 (the washout-flip verdict),
   NOT days_since_inflection, which stays populated for stale flips so the
   "how fresh" column can tell the truth about them. #}
{% set board_b = [] %}
{% for r in board_b_raw %}{% if r.B5_flow_inflect is defined and r.B5_flow_inflect %}{% set _ = board_b.append(r) %}{% endif %}{% endfor %}
{% set etf_strip = fl.etf_strip if fl.etf_strip is defined and fl.etf_strip is not none else [] %}
{% set cov = fl.coverage if fl.coverage is defined and fl.coverage is not none else {} %}
{% set cs = fl.cold_start_detail if fl.cold_start_detail is defined and fl.cold_start_detail is not none else {} %}
{% set board_a_total = fl.board_a_total if fl.board_a_total is defined and fl.board_a_total is not none else (board_a | length) %}
{# Leg specs — field → plain English → plain 中文 (the Tier-2 receipt copy). #}
{% set A_LEGS = [
  ('A1_flow_recur','Money keeps showing up','资金反复出现'),
  ('A2_flow_z_hot','Unusually heavy premium','权利金异常放大'),
  ('A3_oi_confirmed','New positions opened','建立新仓位'),
  ('A4_ts_breadth','Spread across expirations','多个到期日铺开'),
  ('A5_price_leader','Price is leading','价格领先'),
  ('A6_near_high','Near 52-week high','接近52周高点'),
  ('A7_vol_confirm','Volume confirms','成交量确认'),
  ('A8_not_trap','Not a failed breakout','非假突破')
] %}
{% set B_LEGS = [
  ('B1_washout_recent','Recently washed out','近期洗盘'),
  ('B2_oversold_osc','Oversold','超卖'),
  ('B3_turn_organ','Turn signal is on','拐点信号已亮'),
  ('B5_flow_inflect','Money flipped positive','资金转为流入'),
  ('B6_oi_confirmed','New positions opened','建立新仓位'),
  ('B7_vol_confirm','Volume confirms','成交量确认'),
  ('B8_not_trap','Not a failed breakout','非假突破')
] %}
{# Board-level tallies for the hero read (honest, computed from what's shown). #}
{% set st = namespace(fire=0, crowd=0, fresh=0) %}
{% for r in board_a %}{% if r.fire_a %}{% set st.fire = st.fire + 1 %}{% endif %}{% if r.recurrence_count is not none and r.recurrence_count >= 4 %}{% set st.crowd = st.crowd + 1 %}{% endif %}{% endfor %}
{% for r in board_b %}{% if r.fire_b %}{% set st.fire = st.fire + 1 %}{% endif %}{% if r.days_since_inflection is not none and r.days_since_inflection <= 3 %}{% set st.fresh = st.fresh + 1 %}{% endif %}{% endfor %}
{% set n_univ = cov.n_universe if cov.n_universe is defined and cov.n_universe is not none else 0 %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Flow Leaders · 资金领袖</title>
{% set seo_title = "Flow Leaders — Mastermind" %}{% set seo_desc = "US stocks where big options money is crowding in or turning back up after a washout — a plain-language watchlist, updated daily. Not buy or sell advice." %}{% set seo_path = "flow_leaders.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  /* ══════════════════════════════════════════════════════════════════════
     FLOW LEADERS — the money desk. Built on the macro dashboard design
     language (deep terminal canvas, mono numerals, section-header rail,
     machined panels, command-center hero) with one identity of its own: a
     teal "flow" accent that reads as liquid money and stacks toward green as
     confirmations mount. Direction colour (--up/--down) stays reserved for
     real flow direction and swaps under the zh red=up convention via theme.css.
     ══════════════════════════════════════════════════════════════════════ */
  *{box-sizing:border-box;}
  body.page-fl{
    --num:var(--font-mono,ui-monospace,"SF Mono",SFMono-Regular,"Cascadia Mono","JetBrains Mono","Roboto Mono",Menlo,Consolas,monospace);
    --bg:#0a0c11; --panel:#14171e; --panel2:#1b1f28;
    --hair:color-mix(in srgb,var(--line) 72%,transparent);
    --hair-strong:var(--line);
    --tile:color-mix(in srgb,var(--panel2) 86%,var(--panel));
    --ink-1:var(--text); --ink-2:color-mix(in srgb,var(--text) 66%,transparent); --ink-3:var(--muted);
    --flow:#33c9bf;            /* the money/flow accent — teal */
    --flow-2:#49c07a;          /* stacks toward green as confluence builds */
    --rail:var(--flow);
    --rule:1px; --pad:20px;
    --r-sm:8px; --r-md:10px; --r-lg:14px;
    --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:20px; --sp-6:24px;
    --fs-h1:29px; --fs-h2:17px; --fs-body:14px; --fs-sm:12.5px; --fs-label:11px; --fs-micro:10px;
    --ms:inset 0 1px 0 0 color-mix(in srgb,var(--text) 9%,transparent),0 1px 1px rgba(0,0,0,.28),0 14px 32px -18px rgba(0,0,0,.6);
    background:var(--bg); color:var(--ink-1);
    font:var(--fs-body)/1.55 Inter,-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif;
    margin:0; padding:18px;
  }
  html[data-theme="light"] body.page-fl{
    --bg:#f6f7fa; --panel:#ffffff; --panel2:#eef1f6;
    --ink-2:color-mix(in srgb,var(--text) 72%,transparent);
    --hair:color-mix(in srgb,var(--line) 92%,transparent);
    --flow:#0fa596; --flow-2:#1f9a55;
    --ms:inset 0 1px 0 0 rgba(255,255,255,.7),0 1px 2px rgba(20,30,50,.05),0 14px 30px -20px rgba(20,30,50,.16);
  }
  @media(min-width:1100px){body.page-fl{padding:24px max(28px,calc((100vw - 1300px)/2));}}
  body.page-fl a{text-decoration:none;color:inherit;}
  .wrap{max-width:1252px;margin:0 auto;}
  .num{font-family:var(--num);font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1;letter-spacing:-.01em;}
  .cap{font-family:var(--num);font-size:var(--fs-label);font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);}
  .muted{color:var(--ink-2);}

  /* ── panel + the section-header rail (what makes the islands one product) ── */
  .panel{background:var(--panel);border:var(--rule) solid var(--hair-strong);border-radius:var(--r-lg);
    padding:var(--pad) calc(var(--pad) + 2px);box-shadow:var(--ms);margin-bottom:var(--sp-4);
    animation:flRise .4s ease both;}
  .panel > h2{font-size:var(--fs-h2);font-weight:700;letter-spacing:-.01em;color:var(--ink-1);line-height:1.3;
    margin:0 0 4px;display:flex;align-items:center;gap:11px;flex-wrap:wrap;}
  .panel > h2::before{content:"";flex:none;align-self:center;width:3px;height:19px;border-radius:2px;
    background:linear-gradient(180deg,var(--rail),color-mix(in srgb,var(--rail) 30%,transparent));}
  html[data-lang="zh"] .panel > h2{letter-spacing:0;}
  .sect-sub{margin:2px 0 15px;font-size:var(--fs-sm);color:var(--ink-2);max-width:78ch;line-height:1.5;}
  .sect-sub b{color:var(--ink-1);font-weight:600;}
  .help{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;
    border:1px solid var(--ink-3);color:var(--ink-3);font-size:10px;font-weight:700;cursor:help;flex:none;}
  .help:hover{color:var(--flow);border-color:var(--flow);}
  .board-stance{margin-left:auto;font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;
    font-family:var(--num);color:var(--ink-2);padding:3px 9px;border-radius:6px;border:1px solid var(--hair);background:var(--tile);}

  /* ── HERO — the money read (command center) ── */
  .fl-hero{padding:20px 22px;}
  .fl-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:28px;}
  .fl-hero-main{min-width:0;}
  .fl-eyebrow{display:flex;align-items:center;gap:9px;flex-wrap:wrap;font-family:var(--num);font-size:10.5px;
    font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);}
  .fl-eyebrow .approx{cursor:help;color:var(--flow);border-bottom:1px dotted color-mix(in srgb,var(--flow) 60%,transparent);}
  .fl-read{display:flex;align-items:center;gap:13px;margin:9px 0 7px;}
  .fl-dot{width:13px;height:13px;border-radius:50%;flex:none;background:var(--flow);
    box-shadow:0 0 0 4px color-mix(in srgb,var(--flow) 20%,transparent);animation:flPulse 3.4s ease-in-out infinite;}
  .fl-dot.lit{background:var(--flow-2);box-shadow:0 0 0 4px color-mix(in srgb,var(--flow-2) 22%,transparent);}
  h1.fl-word{font-size:var(--fs-h1);font-weight:800;letter-spacing:-.02em;line-height:1.02;color:var(--ink-1);margin:0;}
  html[data-lang="zh"] h1.fl-word{letter-spacing:0;}
  .fl-says{margin:0;font-size:14px;color:var(--ink-2);max-width:60ch;line-height:1.55;}
  .fl-says b{color:var(--ink-1);font-weight:700;}
  .fl-says .num{color:var(--flow-2);font-weight:800;}
  .fl-vitals{display:grid;grid-template-columns:repeat(2,minmax(128px,1fr));gap:15px 22px;
    padding-left:26px;border-left:var(--rule) solid var(--hair);}
  .fl-vital{display:grid;gap:3px;align-content:start;}
  .fl-v-label{font-family:var(--num);font-size:9.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);}
  .fl-v-num{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:26px;font-weight:800;line-height:1;color:var(--ink-1);letter-spacing:-.02em;}
  .fl-v-num.hot{color:var(--flow-2);}
  .fl-v-num small{font-size:14px;color:var(--ink-3);font-weight:600;}
  .fl-v-mean{font-size:10.5px;color:var(--ink-2);line-height:1.32;}

  /* ── banners (only when relevant) ── */
  .banner{padding:11px 15px;border-radius:var(--r-md);margin-bottom:var(--sp-4);font-size:12.5px;
    border:1px solid;display:flex;gap:9px;align-items:baseline;line-height:1.5;}
  .banner-stale{background:color-mix(in srgb,var(--down) 9%,var(--panel));border-color:color-mix(in srgb,var(--down) 45%,var(--line));color:var(--down);}
  .banner-cold{background:color-mix(in srgb,var(--warn) 9%,var(--panel));border-color:color-mix(in srgb,var(--warn) 45%,var(--line));color:var(--warn);}

  /* ── the leaderboard row (the reorg: one calm scannable line per name) ── */
  .lead-list{display:flex;flex-direction:column;}
  .lead-head{display:grid;grid-template-columns:26px minmax(104px,1.25fr) 116px 96px minmax(150px,1.15fr);
    gap:14px;align-items:center;padding:0 8px 7px;border-bottom:var(--rule) solid var(--hair-strong);}
  .lead-head span{font-family:var(--num);font-size:var(--fs-micro);font-weight:700;letter-spacing:.08em;
    text-transform:uppercase;color:var(--ink-3);}
  .fl-row{display:grid;grid-template-columns:26px minmax(104px,1.25fr) 116px 96px minmax(150px,1.15fr);
    gap:14px;align-items:center;padding:11px 8px;border-bottom:var(--rule) solid var(--hair);
    border-left:2px solid transparent;transition:background .15s ease,border-color .15s ease;}
  .fl-row:last-child{border-bottom:none;}
  .fl-row:hover{background:color-mix(in srgb,var(--flow) 6%,transparent);border-left-color:color-mix(in srgb,var(--flow) 55%,transparent);}
  .fl-row.lit{background:color-mix(in srgb,var(--flow) 8%,transparent);border-left-color:var(--flow);}
  .fl-rank{font-family:var(--num);font-size:12px;font-weight:700;color:var(--ink-3);text-align:right;}
  .fl-tk{display:flex;flex-direction:column;gap:1px;min-width:0;}
  .fl-sym{font-family:var(--num);font-weight:800;font-size:15.5px;color:var(--flow);letter-spacing:.01em;line-height:1.1;}
  .fl-row:hover .fl-sym{text-decoration:underline;text-underline-offset:2px;}
  .fl-name{font-size:11px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .fl-state{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;border:1px solid;white-space:nowrap;
    width:max-content;letter-spacing:.005em;}
  .st-fire{color:var(--flow);border-color:color-mix(in srgb,var(--flow) 55%,var(--hair));background:color-mix(in srgb,var(--flow) 14%,var(--tile));}
  .st-crowd{color:var(--flow-2);border-color:color-mix(in srgb,var(--flow-2) 42%,var(--hair));background:color-mix(in srgb,var(--flow-2) 11%,var(--tile));}
  .st-watch{color:var(--ink-2);border-color:var(--hair);background:var(--tile);}
  /* the confluence ladder */
  .ladder{display:inline-flex;gap:3px;align-items:center;cursor:help;}
  .seg{width:7px;height:17px;border-radius:2px;background:var(--tile);border:1px solid var(--hair);
    transform-origin:bottom;animation:segIn .5s cubic-bezier(.2,.8,.2,1) both;animation-delay:calc(var(--i) * 45ms + .1s);}
  .seg-on{background:linear-gradient(180deg,var(--flow),var(--flow-2));border-color:transparent;
    box-shadow:0 0 7px color-mix(in srgb,var(--flow) 40%,transparent);}
  .seg-off{background:transparent;}
  .seg-nul{background:transparent;border-style:dotted;opacity:.5;}
  .fl-right{display:flex;flex-direction:column;gap:5px;min-width:0;}
  .fl-metric{font-size:12px;color:var(--ink-2);line-height:1.2;}
  .fl-metric b{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:15px;color:var(--ink-1);font-weight:800;}
  .fl-cautions{display:flex;flex-wrap:wrap;gap:4px;align-items:center;}
  .cau{font-size:9.5px;font-weight:700;letter-spacing:.02em;padding:2px 7px;border-radius:5px;
    border:1px solid var(--hair);color:var(--ink-3);background:var(--tile);white-space:nowrap;cursor:help;}
  .cau-warn{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 40%,var(--hair));background:color-mix(in srgb,var(--warn) 9%,var(--tile));}
  .cau-hint{color:var(--flow);border-color:color-mix(in srgb,var(--flow) 40%,var(--hair));background:color-mix(in srgb,var(--flow) 9%,var(--tile));}
  .sign-dot{font-size:9px;font-weight:700;font-family:var(--num);letter-spacing:.04em;color:var(--ink-3);cursor:help;
    padding:1px 5px;border-radius:4px;border:1px solid var(--hair);}
  .empty{font-size:13px;color:var(--ink-2);padding:20px 8px;text-align:center;}
  .more-btn{display:inline-block;margin-top:12px;font-size:11.5px;font-weight:700;font-family:var(--num);letter-spacing:.04em;
    color:var(--flow);background:var(--tile);border:1px solid var(--hair);border-radius:8px;padding:7px 14px;cursor:pointer;user-select:none;}
  .more-btn:hover{border-color:color-mix(in srgb,var(--flow) 50%,var(--hair));background:color-mix(in srgb,var(--flow) 10%,var(--tile));}
  /* sr-only checkbox — visually hidden but still keyboard-focusable (unlike [hidden]) */
  .more-cb{position:absolute;width:1px;height:1px;opacity:0;margin:0;pointer-events:none;}
  .more-cb:focus-visible ~ .more-btn{outline:2px solid var(--flow);outline-offset:2px;}
  .fl-row.extra{display:none;}
  .more-cb:checked ~ .lead-list .fl-row.extra{display:grid;}
  .more-btn .more-hide{display:none;}
  .more-cb:checked ~ .more-btn .more-show{display:none;}
  .more-cb:checked ~ .more-btn .more-hide{display:inline;}

  /* ── index & sector money strip ── */
  .etf-row{display:flex;flex-wrap:wrap;gap:9px;}
  .etf-card{background:var(--tile);border:1px solid var(--hair);border-radius:var(--r-md);padding:9px 13px;min-width:104px;}
  .etf-tk{font-family:var(--num);font-weight:800;font-size:13.5px;color:var(--ink-1);}
  .etf-net{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:13px;font-weight:700;margin-top:3px;}
  .etf-net.pos{color:var(--up);} .etf-net.neg{color:var(--down);}
  .etf-sub{font-size:10px;color:var(--ink-3);margin-top:2px;}

  /* ── how to read this (collapsed by default) ── */
  .read-more{border:1px solid var(--hair);border-radius:var(--r-md);margin-bottom:9px;overflow:hidden;background:var(--tile);}
  .read-more>summary{padding:11px 15px;cursor:pointer;font-weight:600;font-size:13px;color:var(--ink-1);list-style:none;
    display:flex;align-items:center;justify-content:space-between;}
  .read-more>summary::-webkit-details-marker{display:none;}
  .read-more>summary::after{content:"▸";color:var(--ink-3);font-size:11px;transition:transform .2s;}
  .read-more[open]>summary::after{transform:rotate(90deg);}
  .read-more>div{padding:2px 15px 14px;font-size:12.5px;line-height:1.65;color:var(--ink-2);}
  .read-more>div p{margin:8px 0;} .read-more>div b{color:var(--ink-1);font-weight:600;}
  .foot{font-size:11px;color:var(--ink-3);line-height:1.6;margin-top:6px;}

  /* ── motion ── */
  @keyframes flRise{from{opacity:0;transform:translateY(9px);}to{opacity:1;transform:none;}}
  @keyframes flPulse{0%,100%{box-shadow:0 0 0 4px color-mix(in srgb,var(--flow) 20%,transparent);}50%{box-shadow:0 0 0 7px color-mix(in srgb,var(--flow) 5%,transparent);}}
  @keyframes segIn{from{opacity:0;transform:scaleY(.35);}to{opacity:1;transform:scaleY(1);}}
  .panel:nth-of-type(2){animation-delay:.05s;} .panel:nth-of-type(3){animation-delay:.1s;}
  .panel:nth-of-type(4){animation-delay:.15s;}
  @media(prefers-reduced-motion:reduce){
    .panel,.seg,.fl-dot{animation:none !important;}
  }

  /* ── responsive: collapse the row to two tidy lines on phones ── */
  @media(max-width:760px){
    .fl-hero-grid{grid-template-columns:1fr;gap:16px;}
    .fl-vitals{padding-left:0;border-left:0;padding-top:15px;border-top:var(--rule) solid var(--hair);}
    .lead-head{display:none;}
    .fl-row{grid-template-columns:24px 1fr auto;grid-template-areas:"r t s" "r l m";gap:5px 12px;padding:12px 6px;}
    .fl-rank{grid-area:r;align-self:start;padding-top:2px;}
    .fl-tk{grid-area:t;} .fl-state{grid-area:s;justify-self:end;}
    .ladder{grid-area:l;padding-top:4px;} .fl-right{grid-area:m;align-items:flex-end;text-align:right;padding-top:4px;}
    .fl-cautions{justify-content:flex-end;}
  }
</style>
</head>
<body class="page-fl">
<nav class="site-nav">
  {% include '_navlinks.html.j2' %}
</nav>

{# OEU M-CMD — these boards are now Leaders mode of the Options workspace. #}
{% set oew_mode = 'leaders' %}{% include "_options_workspace_banner.html.j2" %}

<div class="wrap">

{# ── HERO — the money read ────────────────────────────────────────────── #}
<section class="panel fl-hero">
  <div class="fl-hero-grid">
    <div class="fl-hero-main">
      <div class="fl-eyebrow">
        <span>{{ t('Options money flow', '期权资金流') }}</span>
        <span>· {{ t('US', '美股') }} ·</span>
        <span class="num">{{ fl.session_date if (fl.session_date is defined and fl.session_date is not none) else (fl.as_of[:10] if fl.as_of is defined and fl.as_of is not none else '—') }}</span>
        <span class="approx" data-tip-en="Direction is approximate — we sign flow buy vs sell from the trade tape (or minute bars), which is ~88% accurate on tape names. The SIZE of the money is the reliable part; treat the up/down direction as a lean, not a fact." data-tip-zh="方向为近似值 — 买/卖方向依据成交分笔（或分钟K线）判定，分笔标的约88%准确。可靠的是资金的「规模」；涨跌方向仅供参考，非定论。">~ {{ t('direction approximate', '方向近似') }}</span>
      </div>
      <div class="fl-read">
        <span class="fl-dot {% if st.fire %}lit{% endif %}"></span>
        <h1 class="fl-word">
          {% if st.fire %}{{ t(st.fire ~ ' lining up', st.fire ~ ' 只信号齐备') }}{% else %}{{ t('Watch — don’t chase', '观望 — 勿追高') }}{% endif %}
        </h1>
      </div>
      <p class="fl-says">
        {% if st.fire %}
          {{ t('<b>' ~ st.fire ~ '</b> name(s) hit full confluence today. Everything here is a <b>watchlist</b>, not a buy list — the boards upgrade names on their own as signs stack up.', '今日有 <b>' ~ st.fire ~ '</b> 只标的信号齐备。此处均为<b>观察名单</b>，非买入清单 — 信号累积后榜单会自行升级。') }}
        {% else %}
          {{ t('Big options money is crowding into <span class="num">' ~ st.crowd ~ '</span> steady leaders, and <span class="num">' ~ (board_b|length) ~ '</span> beaten-down names have turned back up. Nothing hit full confluence today — a <b>watchlist</b>, not a buy list.', '大额期权资金正涌入 <span class="num">' ~ st.crowd ~ '</span> 只持续领头股，另有 <span class="num">' ~ (board_b|length) ~ '</span> 只超跌股转为流入。今日无标的信号齐备 — 这是<b>观察名单</b>，非买入清单。') }}
        {% endif %}
      </p>
    </div>
    <div class="fl-vitals">
      <div class="fl-vital">
        <div class="fl-v-label">{{ t('Steady leaders', '持续领头') }}</div>
        <div class="fl-v-num {% if st.crowd %}hot{% endif %}">{{ st.crowd }}</div>
        <div class="fl-v-mean">{{ t('money landed 4+ of the last 10 days', '近10日中4日以上有资金在榜') }}</div>
      </div>
      <div class="fl-vital">
        <div class="fl-v-label">{{ t('Fresh turns', '新近转向') }}</div>
        <div class="fl-v-num {% if st.fresh %}hot{% endif %}">{{ st.fresh }}</div>
        <div class="fl-v-mean">{{ t('flipped back up in the last 3 days', '近3日内由跌转升') }}</div>
      </div>
      <div class="fl-vital">
        <div class="fl-v-label">{{ t('Lining up', '信号齐备') }}</div>
        <div class="fl-v-num {% if st.fire %}hot{% endif %}">{{ st.fire }}</div>
        <div class="fl-v-mean">{{ t('every sign confirming — watch closely', '所有信号确认 — 密切关注') }}</div>
      </div>
      <div class="fl-vital">
        <div class="fl-v-label">{{ t('Tracked', '追踪范围') }}</div>
        <div class="fl-v-num num">{{ n_univ }}</div>
        <div class="fl-v-mean">{{ t('US names watched for options flow', '监测期权资金流的美股') }}</div>
      </div>
    </div>
  </div>
</section>

{# ── state banners (only when relevant) ───────────────────────────────── #}
{% if fl.stale is defined and fl.stale %}
<div class="banner banner-stale">⚠ {{ t('The flow feed is behind — these boards may not reflect today’s sessions. Fresh-count paused until it catches up.', '资金流数据滞后 — 榜单可能未反映今日行情。数据追平前暂停频率计数。') }}</div>
{% endif %}
{% if fl.cold_start is defined and fl.cold_start %}
<div class="banner banner-cold">⏳ {{ t('Still building history — ' ~ (cs.n_sessions if cs.n_sessions is defined else '?') ~ ' of ' ~ (cs.required_for_recurrence if cs.required_for_recurrence is defined else 5) ~ ' sessions in. Signs that need more history show as empty (not a “no”) until the window fills.', '历史仍在积累中 — 已 ' ~ (cs.n_sessions if cs.n_sessions is defined else '?') ~ '/' ~ (cs.required_for_recurrence if cs.required_for_recurrence is defined else 5) ~ ' 个场次。需要更多历史的信号在窗口填满前显示为空（并非「否」）。') }}</div>
{% endif %}

{# ── BOARD A — where money keeps landing ──────────────────────────────── #}
<section class="panel">
  <h2>{{ t('Where money keeps landing', '资金反复流入') }}
    <span class="help" data-tip-en="These are US names that keep showing up among the top-20 by options-premium size (adjusted for market cap, day-trade options stripped out) across the last 10 trading days. It measures where big options money concentrates, session after session — not a forecast that price will rise. Ranked by how many of the last 10 days each name led." data-tip-zh="这些美股在过去10个交易日中反复进入期权权利金规模前20名（已按市值调整、剔除当日到期期权）。它衡量大额期权资金持续集中的位置 — 并非价格上涨的预测。按近10日内领先天数排序。">?</span>
    <span class="board-stance">{{ t('Watch — don’t chase', '观望勿追') }}</span>
  </h2>
  <p class="sect-sub">{{ t('Stocks big options money crowded into — <b>day after day</b>. The ladder shows how many confirming signs line up; hover it for the read.', '大额期权资金<b>持续</b>涌入的股票。梯格显示确认信号的数量；悬停查看解读。') }}</p>

  {% if board_a %}
  <div class="lead-head">
    <span></span><span>{{ t('Ticker', '代码') }}</span><span>{{ t('State', '状态') }}</span><span>{{ t('Signs', '信号') }}</span><span>{{ t('How persistent', '持续度') }}</span>
  </div>
  {% if board_a | length > 8 %}<input type="checkbox" id="more-a" class="more-cb">{% endif %}
  <div class="lead-list">
    {% for r in board_a %}
    {% set rc = r.recurrence_count %}
    {% if r.fire_a %}{% set scls='st-fire' %}{% set slab_en='Lining up' %}{% set slab_zh='信号齐备' %}
    {% elif rc is not none and rc >= 4 %}{% set scls='st-crowd' %}{% set slab_en='Crowding in' %}{% set slab_zh='资金涌入' %}
    {% else %}{% set scls='st-watch' %}{% set slab_en='On the radar' %}{% set slab_zh='雷达关注' %}{% endif %}
    <div class="fl-row {% if r.fire_a %}lit{% endif %} {% if loop.index0 >= 8 %}extra{% endif %}">
      <span class="fl-rank">{{ '%02d' | format(loop.index) }}</span>
      <a class="fl-tk" href="us_stocks.html#{{ r.ticker }}">
        <span class="fl-sym">{{ r.ticker }}</span>
        {% if r.sector is defined and r.sector %}<span class="fl-name">{{ r.sector }}</span>{% endif %}
      </a>
      <span class="fl-state {{ scls }}">{{ t(slab_en, slab_zh) }}</span>
      {{ ladder(r, A_LEGS) }}
      <div class="fl-right">
        <div class="fl-metric">
          {% if rc is not none %}<b>{{ rc | int }}</b> {{ t('of last 10 days', '/ 近10日') }}{% else %}<span class="muted">{{ t('building history', '积累历史中') }}</span>{% endif %}
        </div>
        <div class="fl-cautions">
          {% set de = r.de_escalation if r.de_escalation is defined and r.de_escalation is not none else {} %}
          {% if de.earnings_window %}<span class="cau cau-warn" data-tip-en="Within ~2 weeks of earnings — options flow around earnings is often an event bet, not a conviction position." data-tip-zh="距财报约2周内 — 财报前后的期权资金常是押注事件，而非坚定持仓。">{{ t('Earnings soon', '临近财报') }}</span>{% endif %}
          {# Plain words on BOTH tiers. The acronym this chip and its tip used to
             carry is banned glance-tier vocabulary (Law 2, "unexplained acronyms")
             and this page never defined it — it printed the plain phrase with the
             jargon riding along, which discloses nothing to the reader who needed
             it. Wording is the estate's house form for same-day expiry: the ETF
             strip below already says "same-day"/"当日到期", and the options
             workspace ships this exact chip + tip pair
             (scripts/build_options_command.py, templates/options.html.j2's ZDTE).
             The term's sanctioned home is Tier 3, on the page that explains it:
             content/seo/learn/options/zero-dte-regime.md. #}
          {% if r.zerodte_dominated %}<span class="cau" data-tip-en="Same-day contracts are usually day-trading, not positioning for a move." data-tip-zh="当日到期合约通常用于日内交易，而非布局趋势。">{{ t('Same-day heavy', '当日到期为主') }}</span>{% endif %}
          {% if de.vol_trade %}<span class="cau" data-tip-en="Calls and puts both heavy the same day — may be a volatility bet, not a directional one." data-tip-zh="同日看涨与看跌均放量 — 可能是波动率押注，而非方向性押注。">{{ t('Both sides', '双向押注') }}</span>{% endif %}
          {% if de.protective_put %}<span class="cau" data-tip-en="Far-out-of-the-money put flow dominant — this looks more like hedging than a bullish position." data-tip-zh="远价外看跌期权资金主导 — 更像对冲，而非看多布局。">{{ t('Looks hedged', '疑似对冲') }}</span>{% endif %}
          {% if de.gamma_caution %}<span class="cau" data-tip-en="Short-gamma regime around this name — price can whip around, so the flow read is less stable." data-tip-zh="该标的处于负Gamma环境 — 价格易剧烈波动，资金解读稳定性较低。">{{ t('Fragile tape', '盘面脆弱') }}</span>{% endif %}
          {% if r.signing_source != 'tape' %}<span class="sign-dot" data-tip-en="Estimated from minute bars — magnitude leads; the direction here is a softer read than the tape-signed names (most of this board)." data-tip-zh="据分钟K线估算 — 规模为主；此处方向可靠性低于分笔签署的标的（本榜多数为分笔）。">~{{ t('est', '估') }}</span>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% if board_a | length > 8 %}<label for="more-a" class="more-btn"><span class="more-show">{{ t('Show all ' ~ (board_a|length) ~ ' →', '展开全部 ' ~ (board_a|length) ~ ' 只 →') }}</span><span class="more-hide">{{ t('Show fewer ↑', '收起 ↑') }}</span></label>{% endif %}
  {% else %}
  <div class="empty">{{ t('No leaders yet — options-flow sessions are still accruing.', '暂无领头股 — 资金流场次仍在积累。') }}</div>
  {% endif %}
</section>

{# ── BOARD B — turning up from a beating ───────────────────────────────── #}
<section class="panel">
  <h2>{{ t('Turning up from a beating', '洗盘后转强') }}
    <span class="help" data-tip-en="Beaten-down US names where options money flipped from net-selling to net-buying straight after at least 3 back-to-back negative sessions — an unbroken run, so a flat or missing session breaks it. Only turns from the last 5 sessions that are still positive today make this board; older turns drop off. A washout must already be in place (oversold and starting to reclaim) with no failed-breakout trap. Freshest turns first. Describes a flow-turn meeting a price washout — not a guarantee it holds." data-tip-zh="超跌美股中，期权资金在至少连续3个负向场次之后紧接着由净卖出转为净买入 — 该负向连续段不可中断，出现持平或缺失场次即中断。仅收录最近5个场次内、且当日仍为正向的转向，更早的转向不再列入。同时须已具备洗盘背景（超卖并开始收复）、无假突破陷阱。最新转向优先。描述资金转向与价格洗盘的重合 — 并不保证成立。">?</span>
    <span class="board-stance">{{ t('Watch — don’t chase', '观望勿追') }}</span>
  </h2>
  <p class="sect-sub">{{ t('Beaten-down names where options money <b>just flipped back positive</b>. Fresher turns sit higher.', '期权资金<b>刚刚转为流入</b>的超跌股。转向越新，排位越高。') }}</p>

  {% if board_b %}
  <div class="lead-head">
    <span></span><span>{{ t('Ticker', '代码') }}</span><span>{{ t('State', '状态') }}</span><span>{{ t('Signs', '信号') }}</span><span>{{ t('How fresh', '新近度') }}</span>
  </div>
  {% if board_b | length > 8 %}<input type="checkbox" id="more-b" class="more-cb">{% endif %}
  <div class="lead-list">
    {% for r in board_b %}
    {% set dsi = r.days_since_inflection %}
    {% if r.fire_b %}{% set scls='st-fire' %}{% set slab_en='Lining up' %}{% set slab_zh='信号齐备' %}
    {% elif dsi is not none and dsi <= 3 %}{% set scls='st-crowd' %}{% set slab_en='Just turned' %}{% set slab_zh='刚刚转向' %}
    {% else %}{% set scls='st-watch' %}{% set slab_en='Turning up' %}{% set slab_zh='转强中' %}{% endif %}
    <div class="fl-row {% if r.fire_b %}lit{% endif %} {% if loop.index0 >= 8 %}extra{% endif %}">
      <span class="fl-rank">{{ '%02d' | format(loop.index) }}</span>
      <a class="fl-tk" href="us_stocks.html#{{ r.ticker }}">
        <span class="fl-sym">{{ r.ticker }}</span>
        {% if r.sector is defined and r.sector %}<span class="fl-name">{{ r.sector }}</span>{% endif %}
      </a>
      <span class="fl-state {{ scls }}">{{ t(slab_en, slab_zh) }}</span>
      {{ ladder(r, B_LEGS) }}
      <div class="fl-right">
        <div class="fl-metric">
          {% if dsi is not none %}{% if dsi == 0 %}{{ t('turned <b>today</b>', '<b>今日</b>转向') }}{% elif dsi == 1 %}{{ t('turned <b>yesterday</b>', '<b>昨日</b>转向') }}{% else %}{{ t('turned <b>' ~ dsi ~ '</b> days ago', '<b>' ~ dsi ~ '</b> 日前转向') }}{% endif %}{% else %}<span class="muted">—</span>{% endif %}
        </div>
        <div class="fl-cautions">
          {% if r.B4_htf_cross_near is defined and r.B4_htf_cross_near %}<span class="cau cau-hint" data-tip-en="A 2-week trend indicator (MACD) is close to crossing up — a longer-timeframe tailwind. Extra context only; it doesn’t drive the ranking." data-tip-zh="2周级别趋势指标（MACD）接近向上穿越 — 更长周期的顺风。仅为补充背景，不影响排序。">{{ t('2-wk turn near', '2周拐点将至') }}</span>{% endif %}
          {% set de = r.de_escalation if r.de_escalation is defined and r.de_escalation is not none else {} %}
          {% if de.earnings_window %}<span class="cau cau-warn" data-tip-en="Within ~2 weeks of earnings — options flow around earnings is often an event bet, not a conviction position." data-tip-zh="距财报约2周内 — 财报前后的期权资金常是押注事件，而非坚定持仓。">{{ t('Earnings soon', '临近财报') }}</span>{% endif %}
          {% if de.gamma_caution %}<span class="cau" data-tip-en="Short-gamma regime around this name — price can whip around, so the flow read is less stable." data-tip-zh="该标的处于负Gamma环境 — 价格易剧烈波动，资金解读稳定性较低。">{{ t('Fragile tape', '盘面脆弱') }}</span>{% endif %}
          {% if r.signing_source != 'tape' %}<span class="sign-dot" data-tip-en="Estimated from minute bars — magnitude leads; the direction here is a softer read than the tape-signed names (most of this board)." data-tip-zh="据分钟K线估算 — 规模为主；此处方向可靠性低于分笔签署的标的（本榜多数为分笔）。">~{{ t('est', '估') }}</span>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% if board_b | length > 8 %}<label for="more-b" class="more-btn"><span class="more-show">{{ t('Show all ' ~ (board_b|length) ~ ' →', '展开全部 ' ~ (board_b|length) ~ ' 只 →') }}</span><span class="more-hide">{{ t('Show fewer ↑', '收起 ↑') }}</span></label>{% endif %}
  {% else %}
  <div class="empty">{{ t('No fresh turns right now — nothing has flipped back up from a washout.', '目前无新近转向 — 暂无超跌转升的标的。') }}</div>
  {% endif %}
</section>

{# ── Index & sector money ─────────────────────────────────────────────── #}
{% if etf_strip %}
<section class="panel">
  <h2>{{ t('Index &amp; sector money', '指数与板块资金') }}
    <span class="help" data-tip-en="Net options-premium lean across the big index and sector ETFs (flow size only — ETFs don’t get a board seat or single-stock signs). Positive = net call-side money, negative = net put-side. Direction is approximate." data-tip-zh="主要指数与板块ETF的期权净权利金倾向（仅资金规模 — ETF不进榜、无个股信号）。正=看涨方净流入，负=看跌方。方向为近似值。">?</span>
  </h2>
  <p class="sect-sub">{{ t('Which way the money leaned across the big index and sector ETFs today.', '今日大盘指数与板块ETF的资金倾向。') }}</p>
  <div class="etf-row">
  {% for e in etf_strip %}
  <div class="etf-card">
    <div class="etf-tk">{{ e.ticker }}</div>
    {% if e.net_premium_mn is defined and e.net_premium_mn is not none %}
    <div class="etf-net {% if e.net_premium_mn >= 0 %}pos{% else %}neg{% endif %}">{{ '%+.1f' | format(e.net_premium_mn) }}M</div>
    {% endif %}
    {% if e.zerodte_share is defined and e.zerodte_share is not none %}
    <div class="etf-sub">{{ '%.0f' | format(e.zerodte_share * 100) }}% {{ t('same-day', '当日到期') }}</div>
    {% endif %}
  </div>
  {% endfor %}
  </div>
</section>
{% endif %}

{# ── How to read this ─────────────────────────────────────────────────── #}
<section class="panel">
  <h2>{{ t('How to read this', '如何解读') }}</h2>
  <details class="read-more">
    <summary>{{ t('What the two boards mean', '两个榜单的含义') }}</summary>
    <div>
      <p><b>{{ t('Where money keeps landing', '资金反复流入') }}</b> — {{ t('stocks that keep drawing big options money, day after day. It marks where the money is concentrating — not a promise the price goes up.', '反复吸引大额期权资金的股票。它标记资金集中的位置 — 并非价格上涨的承诺。') }}</p>
      <p><b>{{ t('Turning up from a beating', '洗盘后转强') }}</b> — {{ t('beaten-down names where options money just flipped from selling to buying, with the price already washed out and starting to recover.', '超跌股中，期权资金刚由卖转买，且价格已洗盘并开始回升。') }}</p>
    </div>
  </details>
  <details class="read-more">
    <summary>{{ t('The ladder and the state word', '梯格与状态词') }}</summary>
    <div>
      <p>{{ t('The <b>ladder</b> is a row of dots — one per confirming sign (heavy premium, new positions opened, near a high, volume, and so on). Filled dots are confirming; dim dots aren’t yet; dotted dots mean that data isn’t in. Hover the ladder for the full read.', '<b>梯格</b>是一排圆点 — 每个对应一项确认信号（权利金放大、建立新仓、接近高点、成交量等）。实心为确认；暗色为尚未；虚线为数据未到。悬停梯格查看完整解读。') }}</p>
      <p>{{ t('<b>Crowding in / Just turned</b> means the signs are stacking up; <b>On the radar / Turning up</b> means it’s early; <b>Lining up</b> means every required sign confirmed — worth a close look, still not an automatic buy.', '<b>资金涌入 / 刚刚转向</b>表示信号在累积；<b>雷达关注 / 转强中</b>表示尚早；<b>信号齐备</b>表示所有必需信号已确认 — 值得密切关注，但仍非自动买入。') }}</p>
    </div>
  </details>
  <details class="read-more">
    <summary>{{ t('The caution tags', '警示标签') }}</summary>
    <div>
      <p>{{ t('Tags like <b>Earnings soon</b>, <b>Same-day heavy</b>, <b>Both sides</b>, <b>Looks hedged</b> and <b>Fragile tape</b> lower your confidence in a name — they never rank, score or veto it. Hover any tag for what it means.', '诸如<b>临近财报</b>、<b>当日到期为主</b>、<b>双向押注</b>、<b>疑似对冲</b>、<b>盘面脆弱</b>等标签会降低对该标的的信心 — 但从不参与排名、评分或否决。悬停任一标签查看含义。') }}</p>
    </div>
  </details>
  <p class="foot">{{ t('Display only — a watchlist, not buy or sell advice, and it doesn’t feed any rating. Direction is approximate; the <b>size</b> of the money flow is the reliable signal. Thresholds are fixed in advance, not tuned to look good.', '仅供展示 — 这是观察名单，非买卖建议，也不输入任何评级。方向为近似；可靠信号是资金流的<b>规模</b>。阈值为预先设定，非事后调优。') }}</p>
</section>

</div>
<script src="theme.js"></script>
</body>
</html>
