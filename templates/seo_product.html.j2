{#=============================================================================
  seo_product.html.j2 — public product explainer.
  Context: page, rel, site, body_html, toc, related, cta, jsonld_extra.
  Product pages use a single conversion CTA and keep limitations visible.
=============================================================================#}
{% extends "seo_base.html.j2" %}
{% block body_class %}est-product product-{{ page.slug }}{% endblock %}

{% block estate_css %}
  .prod-hero{max-width:1120px; margin:24px auto 0; padding:0 24px;
    display:grid; grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);
    gap:34px; align-items:stretch;}
  .prod-copy{border:1px solid var(--hair-strong); border-radius:var(--r-lg);
    padding:clamp(24px,4vw,46px); background:
      radial-gradient(110% 130% at 0% 0%,color-mix(in srgb,var(--link) 12%,transparent),transparent 58%),
      var(--panel); box-shadow:var(--ms);}
  .prod-copy .est-kicker{margin-bottom:16px;}
  .prod-copy .est-title{max-width:16ch;}
  .prod-copy .est-dek{max-width:58ch;}
  .prod-cta{margin-top:25px;}
  .prod-cta .gbtn{min-height:46px; padding-inline:20px;}
  .prod-workflow{border:1px solid var(--hair-strong); border-radius:var(--r-lg);
    padding:22px; background:var(--panel2); box-shadow:var(--ms);}
  .prod-workflow .pw-k{font-family:var(--num); font-size:var(--fs-label);
    letter-spacing:.12em; text-transform:uppercase; color:var(--link);}
  .prod-workflow ol{list-style:none; margin:18px 0 0; padding:0; counter-reset:step;}
  .prod-workflow li{counter-increment:step; display:grid; grid-template-columns:32px 1fr;
    gap:11px; align-items:start; padding:15px 0; border-top:1px solid var(--hair);
    color:var(--ink-1); font-size:var(--fs-body); line-height:1.45;}
  .prod-workflow li:first-child{border-top:0; padding-top:0;}
  .prod-workflow li::before{content:"0" counter(step); font-family:var(--num);
    font-size:var(--fs-label); font-weight:700; color:var(--link);
    border:1px solid color-mix(in srgb,var(--link) 34%,var(--hair-strong));
    border-radius:7px; padding:4px 5px; text-align:center;}
  .prod-layout{max-width:1120px; margin:38px auto 0; padding:0 24px;
    display:grid; grid-template-columns:210px minmax(0,1fr); gap:44px; align-items:start;}
  .prod-toc{position:sticky; top:78px; border-left:1px solid var(--hair-strong);
    padding-left:15px;}
  .prod-toc .toc-h{font-family:var(--num); font-size:var(--fs-label);
    letter-spacing:.1em; text-transform:uppercase; color:var(--ink-3); margin:0 0 9px;}
  .prod-toc a{display:block; margin-left:-16px; padding:6px 0 6px 14px;
    border-left:2px solid transparent; color:var(--ink-2); font-size:var(--fs-sm);
    line-height:1.35;}
  .prod-toc a:hover,.prod-toc a.active{border-left-color:var(--link);
    color:var(--ink-1); text-decoration:none;}
  .prod-main{min-width:0;}
  .prod-related{margin:36px 0 0; padding-top:22px; border-top:1px solid var(--hair-strong);}
  .prod-related h2{font-size:var(--fs-h2); margin:0 0 14px;}
  .prod-rel-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px;}
  .prod-rel{display:flex; flex-direction:column; min-height:116px; padding:16px;
    border:1px solid var(--hair-strong); border-radius:var(--r-md); background:var(--panel);
    color:var(--ink-1); text-decoration:none; transition:transform .18s,border-color .18s;}
  .prod-rel:hover{transform:translateY(-2px); border-color:var(--link); text-decoration:none;}
  .prod-rel .kind{font-family:var(--num); font-size:var(--fs-label);
    letter-spacing:.08em; text-transform:uppercase; color:var(--link);}
  .prod-rel .name{font-weight:700; margin-top:8px; line-height:1.35;}
  .prod-rel .go{margin-top:auto; padding-top:10px; color:var(--ink-3); font-size:var(--fs-sm);}
  @media (max-width:860px){
    .prod-hero,.prod-layout{grid-template-columns:1fr;}
    .prod-workflow ol{display:grid; grid-template-columns:repeat(3,1fr); gap:12px;}
    .prod-workflow li{display:block; border:1px solid var(--hair); border-radius:var(--r-sm); padding:13px;}
    .prod-workflow li::before{display:block; width:max-content; margin-bottom:10px;}
    .prod-toc{position:static; display:flex; flex-wrap:wrap; gap:7px; border:0; padding:0;}
    .prod-toc .toc-h{flex-basis:100%;}
    .prod-toc a{margin:0; padding:6px 10px; border:1px solid var(--hair);
      border-radius:999px;}
  }
  @media (max-width:600px){
    .prod-hero,.prod-layout{padding-inline:16px;}
    .prod-copy{padding:24px 20px;}
    .prod-workflow ol{grid-template-columns:1fr;}
  }
{%- endblock %}

{% block main %}
<section class="prod-hero">
  <div class="prod-copy">
    <span class="est-kicker">{{ page.eyebrow }}</span>
    <h1 class="est-title">{{ page.title }}</h1>
    <p class="est-dek">{{ page.description }}</p>
    {% if cta %}
    <div class="prod-cta">
      <a class="gbtn gbtn-lg gbtn-cta" href="{% if cta.href.startswith('http') %}{{ cta.href }}{% else %}{{ rel }}{{ cta.href.lstrip('/') }}{% endif %}">{{ cta.label }} →</a>
    </div>
    {% endif %}
  </div>
  <aside class="prod-workflow" aria-label="Product workflow">
    <span class="pw-k">{{ t('How it fits', '使用流程') }}</span>
    <ol>
      {% for step in page.workflow %}<li>{{ step }}</li>{% endfor %}
    </ol>
  </aside>
</section>

<div class="prod-layout">
  <nav class="prod-toc" aria-label="On this page">
    <p class="toc-h">{{ t('On this page', '本页目录') }}</p>
    {% for h in toc %}<a href="#{{ h.id }}">{{ h.label }}</a>{% endfor %}
  </nav>
  <div class="prod-main">
    <article class="est-prose">
      {{ body_html|safe }}
    </article>

    {% if related and (related.products or related.live) %}
    <aside class="prod-related" aria-label="Related product and research pages">
      <h2>{{ t('Continue the workflow', '继续探索') }}</h2>
      <div class="prod-rel-grid">
        {% for r in related.products %}
        <a class="prod-rel" href="{{ rel }}{{ r.href.lstrip('/') }}">
          <span class="kind">{{ t('Product', '产品') }}</span>
          <span class="name">{{ r.title }}</span>
          <span class="go">{{ t('Explore', '查看') }} →</span>
        </a>
        {% endfor %}
        {% for r in related.live %}
        <a class="prod-rel" href="{{ rel }}{{ r.href.lstrip('/') }}">
          <span class="kind">{{ t('Research surface', '研究页面') }}</span>
          <span class="name">{{ r.title }}</span>
          <span class="go">{{ t('Open', '打开') }} →</span>
        </a>
        {% endfor %}
      </div>
    </aside>
    {% endif %}
  </div>
</div>
{% endblock %}

{% block body_scripts %}
{% if toc %}
<script>
(function(){
  var links=[].slice.call(document.querySelectorAll('.prod-toc a'));
  var heads=links.map(function(a){return document.querySelector(a.getAttribute('href'));});
  if(!links.length)return;
  function spy(){
    var y=window.scrollY+100, active=0;
    heads.forEach(function(h,i){if(h&&h.offsetTop<=y)active=i;});
    links.forEach(function(a,i){a.classList.toggle('active',i===active);});
  }
  window.addEventListener('scroll',spy,{passive:true}); spy();
})();
</script>
{% endif %}
{% endblock %}
