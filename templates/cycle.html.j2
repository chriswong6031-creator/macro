<!DOCTYPE html>
<html lang="en" class="cyc-page cyc-main">
{# Cycle Intelligence — flagship cross-cycle dashboard. Bespoke SVG charts via the
   reusable mm_charts.js engine (NOT Plotly). Data + logic + styles are committed
   site/ assets (cycle_data.js / cycle_app.js / cycle.css / mm_charts.js); this
   template only owns the page shell + the shared nav include, rendered by
   scripts/build_cycle.py into site/cycle.html. #}
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Cycle Intelligence — Mastermind</title>
{% set seo_title = 'Cycle Intelligence — 15 Boom-Bust Cycles on One Clock | Mastermind' %}{% set seo_desc = 'Fifteen boom-bust cycles on one clock — observed history and regime-conditioned projections, so you can see exactly where each asset sits in its lifespan.' %}{% set seo_path = 'cycle.html' %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="cycle.css?v=3">
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="cyc-wrap">
  <header class="cyc-hd">
    <div class="ht">
      <div class="cyc-kicker"><span class="hb"></span> <span class="l-en">Cycle Intelligence</span><span class="l-zh">周期智慧</span></div>
      <h1 class="cyc-title"><span class="l-en">Where every cycle stands</span><span class="l-zh">每个周期所处的位置</span></h1>
      <p class="cyc-sub"><span class="l-en">Two dozen boom-bust cycles on one clock. <b>MEASURED</b> cards plot the engine's own
        oscillator, turns and projection from the live backing tape; <b>FRAME</b> cards show only the curated turning-point
        history — structural clocks, never a hand-typed position. So you can see exactly where each measurable asset sits,
        and how the long clocks line up beside them.</span><span class="l-zh">二十多个繁荣—萧条周期同处一张时钟之上。<b>已测量</b>卡片由底层数据实时计算引擎自身的振荡指标、拐点与投影；<b>框架</b>卡片仅展示人工整理的拐点历史——结构性时钟，绝无人工录入的位置。让你清楚看到每类可测量资产的位置，以及长周期时钟如何在旁排布。</span></p>
    </div>
    <div class="cyc-ctrls">
      <span class="cyc-asof"><span class="l-en">As of</span><span class="l-zh">截至</span> <span id="cyc-asof">…</span></span>
    </div>
  </header>

  <section class="cyc-stage">
    <div class="cyc-hero">
      <div class="cyc-hero-hd">
        <h2><span class="l-en">Cross-cycle overlay</span><span class="l-zh">跨周期叠加</span></h2>
        <div class="cyc-hero-tools">
          <div class="cyc-legend">
            <span><i class="ls"></i> <span class="l-en">History</span><span class="l-zh">历史</span></span>
            <span><i class="lp"></i> <span class="l-en">Projection</span><span class="l-zh">推演</span></span>
            <span><i class="lc"></i> <span class="l-en">Uncertainty</span><span class="l-zh">不确定性</span></span>
          </div>
          <div class="cyc-zoom" id="cyc-zoom" aria-label="Zoom"></div>
        </div>
      </div>
      <div id="cyc-stale-banner"></div>
      <div id="regime-prior-banner"></div>
      <div class="cyc-groups" id="cyc-groups" aria-label="Group filter"></div>
      <div class="cyc-chips" id="cyc-chips" aria-label="Cycle toggles"></div>
      <div id="cyc-chart" data-h="452" role="img" aria-label="Cross-cycle overlay chart"></div>
    </div>

    <aside class="cyc-detail" id="cyc-detail">
      <div class="cyc-handle" id="cyc-handle" aria-hidden="true"></div>
      <div class="cyc-panels">
        <div class="cyc-panel show" id="cyc-panel-default"></div>
        <div class="cyc-panel" id="cyc-panel-focus"></div>
      </div>
    </aside>
  </section>

  <div class="cyc-cards-hd">
    <h2><span class="l-en">Cycle scorecards</span><span class="l-zh">周期记分卡</span></h2>
    <span class="sub"><span class="l-en">Tap any card — or its line on the chart — to focus it</span><span class="l-zh">点按任意卡片（或图中其曲线）以聚焦</span></span>
  </div>
  <div class="cyc-cards" id="cyc-cards"></div>
</div>

<script src="regimedata/regime_prior.js"></script>
<script src="cycle_data.js"></script>
<script src="cycledata/cycle_engine.js"></script>
<script src="mm_charts.js?v=4"></script>
<script src="cycle_i18n.js"></script>
<script src="cycle_app.js?v=2"></script>
<script>try{document.getElementById('cyc-asof').textContent=(window.CYCLE_ENGINE||window.CYCLE_META||{}).as_of||(window.CYCLE_META||{}).asOf||'';}catch(e){}</script>
<script>
/* W4.5 regime-prior reconciliation banner — rendered after all data scripts load.
   Two layers: (0) CONTRADICTION — curated regime_claim quad vs the live engine quad
   (from CYCLE_ENGINE.regime_disagreement, softened to amber when the engine read is
   itself provisional); (1) prior stale/partial; (2) curated prose > 30 days old.
   Dual-span EN/zh — no t() in attributes. */
(function(){
  try{
    var host=document.getElementById('regime-prior-banner');
    if(!host)return;
    var prior=window.REGIME_PRIOR||{};
    var meta=window.CYCLE_ENGINE||window.CYCLE_META||{};
    var lang=(document.documentElement.getAttribute('data-lang')||'').slice(0,2).toLowerCase();
    var zh=lang==='zh';
    var msgs=[];
    // 0. Contradiction: curated regime_claim quad vs live engine quad (W4.5 primary signal)
    var rd=(window.CYCLE_ENGINE||{}).regime_disagreement;
    if(rd&&rd.banner_en){
      msgs.push({en:rd.banner_en,zh:rd.banner_zh,cls:rd.cls||'stale-red'});
    }
    // 1. Prior itself stale/partial
    var ps=prior.status;
    if(ps==='stale'||ps==='partial'){
      var sources=prior.sources||{};
      var staleSrcs=[];
      for(var k in sources){if(sources[k]&&(sources[k].status==='stale'||sources[k].status==='unavailable'))staleSrcs.push(k);}
      var enMsg='Regime data is '+ps+' ('+staleSrcs.join(', ')+') — some components may not reflect the latest build.';
      var zhMsg='体制数据状态为'+ps+'（'+staleSrcs.join('、')+'）——部分组件可能未反映最新构建。';
      msgs.push({en:enMsg,zh:zhMsg,cls:'stale-amber'});
    }
    // 2. Curated prose staleness (>30d from CYCLE_META.asOf or CYCLE_ENGINE.as_of)
    var curatedAsOf=meta.asOf||meta.as_of||null;
    if(curatedAsOf){
      var d=new Date(curatedAsOf+'T00:00:00Z');
      var daysDiff=Math.round((Date.now()-d.getTime())/86400000);
      if(daysDiff>30){
        var cls2=daysDiff>60?'stale-red':'stale-amber';
        var enMsg2='Regime narrative notes last updated '+curatedAsOf+' ('+daysDiff+'d ago) — may not reflect the live engine ('+((prior.quad||'?')+' '+((prior.liquidity||'')))+ ').';
        var zhMsg2='体制叙述最后更新于 '+curatedAsOf+'（已 '+daysDiff+' 天）——可能未反映实时引擎读数（当前：'+(prior.quad||'?')+' '+(prior.liquidity||'')+'）。';
        msgs.push({en:enMsg2,zh:zhMsg2,cls:cls2});
      }
    }
    if(!msgs.length){host.innerHTML='';return;}
    var html='';
    msgs.forEach(function(m){
      html+='<div class="stale-banner '+m.cls+'">'
        +'<span class="l-en">'+m.en+'</span>'
        +'<span class="l-zh">'+m.zh+'</span>'
        +'</div>';
    });
    host.innerHTML=html;
  }catch(e){}
})();
</script>
<script src="theme.js"></script>
</body>
</html>
