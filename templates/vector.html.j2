{# Bitcoin command deck — Wave 1.
   Six Tier-1 shelves are structural roots. The governor requires exact S1–S6
   equality and exactly one data-verdict marker. #}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro qmark(en, zh='') -%}
<span class="qm" tabindex="0" role="note" data-tip-en="{{ en }}"{% if zh %} data-tip-zh="{{ zh }}"{% endif %}>?</span>
{%- endmacro %}
{% macro tone_class(tone) -%}
{{- 'tone-up' if tone == 'bull' else ('tone-down' if tone == 'bear' else 'tone-flat') -}}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<script>try{var th=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',th||'dark');var la=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh'}catch(e){}return''})();if(la)document.documentElement.setAttribute('data-lang',la)}catch(e){}</script>
<title>Bitcoin Vector — {{ as_of }}</title>
{% set seo_title = "Bitcoin Vector — MastermindX" %}
{% set seo_desc = "Bitcoin's regime, final model exposure, six governing drivers and full strategy track record on one calm decision surface." %}
{% set seo_path = "vector.html" %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="illus.css">
<style>
*{box-sizing:border-box}
:root{
  --btc:#f7931a;--btc-soft:color-mix(in srgb,var(--btc) 12%,transparent);
  --btc-line:color-mix(in srgb,var(--btc) 35%,var(--line));
  /* Compatibility aliases for the two retained interactive instruments. */
  --blue:var(--info);--r3:var(--down);--bull:var(--up);--bear:var(--down);
  --grid:var(--line);--card:var(--panel);--ink:var(--text);--faint:var(--muted);
  --amber:var(--warn);--surface:var(--panel);--surface-brd:var(--line);
}
html[data-theme="dark"]{--btc:#f5a43b}
html body.page-vector{
  margin:0;padding:18px 0 0;background:var(--bg);color:var(--text);
  font-family:var(--font-ui);font-size:15px;line-height:1.48;--num:var(--font-mono);
}
body.page-vector::before{opacity:.46}
.site-nav .nav-links>.nav-dd:nth-last-child(3) .nav-sub>.nav-dd-menu{left:auto;right:100%}
.site-nav .nav-links>.nav-dd:nth-last-child(3) .nav-sub::after{left:auto;right:100%}
.vector-wrap{width:min(1500px,calc(100% - 40px));margin:0 auto;padding:8px 0 76px}
.shelf{position:relative;margin-top:18px;background:color-mix(in srgb,var(--panel) 96%,transparent);
  border:1px solid var(--line);border-radius:12px;overflow:hidden;box-shadow:var(--card-shadow)}
.shelf::before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--btc);opacity:.88}
.shelf-inner{padding:22px 24px}
.shelf-head{display:flex;align-items:baseline;gap:10px;margin-bottom:15px}
.shelf-kicker{font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--btc)}
.shelf-title{margin:0;font-size:16px;line-height:1.2;font-weight:760;letter-spacing:-.01em}
.shelf-sub{margin-left:auto;color:var(--muted);font-size:11.5px;white-space:nowrap}
.num{font-family:var(--num);font-variant-numeric:tabular-nums}
.tone-up{--tone:var(--up)}.tone-down{--tone:var(--down)}.tone-flat{--tone:var(--muted)}
.state-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--tone,var(--muted));flex:none}
.qm{display:inline-grid;place-items:center;width:18px;height:18px;border:1px solid var(--line);
  border-radius:50%;color:var(--muted);font:700 10px/1 var(--font-ui);cursor:help}
.qm:hover,.qm:focus-visible{color:var(--text);border-color:var(--btc)}
a{color:var(--link)}

/* S1 — the read */
.hero{padding:26px 28px 22px;background:
  linear-gradient(110deg,color-mix(in srgb,var(--btc) 5%,var(--panel)),var(--panel) 43%)}
.hero-line{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.wordmark{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:780;letter-spacing:.01em}
.wordmark .mark{color:var(--btc);font:800 26px/1 var(--font-ui)}
.live-quote{display:flex;align-items:baseline;gap:8px;margin-left:auto}
.live-price{font:760 19px/1 var(--num);font-variant-numeric:tabular-nums}
.live-change{font:700 12px/1 var(--num);font-variant-numeric:tabular-nums}
.asof-chip{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border:1px solid var(--line);
  border-radius:999px;color:var(--muted);font-size:10.5px;font-variant-numeric:tabular-nums}
.asof-chip i{width:5px;height:5px;border-radius:50%;background:var(--btc)}
.hero-read{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:28px;align-items:end;margin:28px 0 8px}
.stance{margin:0;font-size:clamp(42px,6vw,82px);font-weight:820;letter-spacing:-.055em;line-height:.92;
  color:var(--text);text-wrap:balance}
.hero-summary{max-width:720px;margin:14px 0 0;color:var(--muted);font-size:14px}
.master-meter{padding:14px 16px;border-left:1px solid var(--line)}
.meter-top{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.meter-label{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:700}
.meter-score{font:760 24px/1 var(--num);font-variant-numeric:tabular-nums;color:var(--tone,var(--muted))}
.meter-rail{position:relative;height:4px;margin:11px 0 7px;border-radius:4px;background:var(--line)}
.meter-rail::before{content:"";position:absolute;left:50%;top:-3px;width:1px;height:10px;background:var(--muted);opacity:.45}
.meter-rail i{position:absolute;top:-3px;width:2px;height:10px;border-radius:2px;background:var(--tone,var(--muted));
  left:calc({{ master.gauge if master and master.ok else 50 }}% - 1px)}
.meter-note{font-size:10.5px;color:var(--muted)}
.tape-shell{position:relative;padding:14px 12px 4px;border-top:1px solid var(--line)}
.tape-legend{position:absolute;top:18px;left:14px;z-index:2;display:flex;gap:13px;align-items:center;
  color:var(--muted);font-size:10px;pointer-events:none}
.tape-legend span{display:inline-flex;align-items:center;gap:5px}
.tape-legend i{width:9px;height:3px;border-radius:2px}
.what-changed{display:flex;align-items:center;gap:7px;flex-wrap:wrap;padding-top:13px;margin-top:5px;border-top:1px solid var(--line)}
.what-label{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:750;color:var(--muted);margin-right:3px}
.change-chip{display:inline-flex;align-items:center;gap:6px;min-width:0;color:var(--text);font-size:11.5px}
.change-chip i{width:5px;height:5px;border-radius:50%;background:var(--muted);flex:none}
.change-chip span:last-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:300px}
.all-alerts{margin-left:auto;font-size:11.5px;text-decoration:none}

/* S2 — one verdict */
.decision-grid{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(430px,1.45fr);gap:0;border-top:1px solid var(--line)}
.decision-main{padding:28px;border-right:1px solid var(--line)}
.decision-eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:750}
.decision-action{margin-top:8px;font-size:clamp(28px,3.7vw,50px);font-weight:820;letter-spacing:-.035em;line-height:1.02;
  color:var(--tone,var(--text))}
.decision-basis{margin-top:12px;color:var(--muted);font-size:12.5px}
.decision-basis b{color:var(--text)}
.decision-detail{padding:25px 28px}
.exposure-top{display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
.exposure-band{font:800 36px/1 var(--num);font-variant-numeric:tabular-nums;letter-spacing:-.04em}
.risk-context{text-align:right;color:var(--muted);font-size:11px}
.risk-context b{display:block;color:var(--text);font:760 20px/1.1 var(--num);font-variant-numeric:tabular-nums}
.exposure-rail{position:relative;height:10px;margin:14px 0 5px;border-radius:6px;background:var(--panel2);overflow:visible}
.exposure-rail .band{position:absolute;top:0;height:100%;border-radius:6px;background:var(--tone,var(--muted));opacity:.82}
.exposure-rail .model{position:absolute;top:-4px;width:2px;height:18px;background:var(--text)}
.exposure-scale{display:flex;justify-content:space-between;color:var(--muted);font-size:9.5px}
.level-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
.level{padding:11px 12px;border:1px solid var(--line);border-radius:9px;background:var(--bg)}
.level .k{display:block;color:var(--muted);font-size:9.5px;text-transform:uppercase;letter-spacing:.06em}
.level b{display:block;margin-top:4px;font:720 13px/1.25 var(--num);font-variant-numeric:tabular-nums}
.decision-foot{margin-top:14px;color:var(--muted);font-size:11px}

/* S3 — why */
.axis-board{border-top:1px solid var(--line)}
.axis-row{display:grid;grid-template-columns:minmax(190px,1.2fr) minmax(130px,.75fr) 170px 120px 24px;
  gap:18px;align-items:center;min-height:66px;padding:12px 22px;border-bottom:1px solid var(--line)}
.axis-row:last-child{border-bottom:none}
.axis-name{display:flex;align-items:center;gap:9px;font-weight:690;font-size:13px}
.axis-state{font-weight:740;font-size:13px;color:var(--tone,var(--muted))}
.axis-spark{width:150px;height:34px}
.axis-spark polyline{fill:none;stroke:var(--tone,var(--muted));stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.axis-micro{text-align:right}
.axis-micro b{display:block;font:720 13px/1 var(--num);font-variant-numeric:tabular-nums}
.axis-micro span{display:block;margin-top:4px;color:var(--muted);font-size:9.5px}

/* S4 — watch conditions */
.watch-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}
.watch-item{padding:18px 22px;min-height:116px;border-right:1px solid var(--line)}
.watch-item:last-child{border-right:none}
.watch-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.watch-name{font-weight:720;font-size:13px}
.watch-state{font-size:10px;font-weight:720;color:var(--tone,var(--muted))}
.watch-copy{margin-top:9px;color:var(--muted);font-size:11.5px;line-height:1.48}
.projection-note{padding:10px 22px;border-top:1px solid var(--line);color:var(--muted);font-size:10.5px}

/* S5 — complex */
.complex-grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line)}
.complex-card{min-width:0;padding:16px 16px 13px;border-right:1px solid var(--line)}
.complex-card:last-child{border-right:none}
.complex-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
.complex-symbol{font:740 10px/1 var(--num);letter-spacing:.08em;color:var(--muted)}
.complex-name{margin-top:5px;font-weight:680;font-size:12px}
.complex-value{font:740 13px/1 var(--num);font-variant-numeric:tabular-nums;white-space:nowrap}
.complex-chart{margin:7px 0 3px}
.complex-context{min-height:28px;color:var(--muted);font-size:9.5px;line-height:1.4}

/* S6 — study shelf */
.study-list{border-top:1px solid var(--line)}
.study-fold{margin:0;border-bottom:1px solid var(--line);background:var(--panel)}
.study-fold:last-child{border-bottom:none}
.study-fold>summary{display:grid;grid-template-columns:180px 1fr auto;gap:14px;align-items:center;
  padding:15px 22px;list-style:none;cursor:pointer;color:var(--text)}
.study-fold>summary::-webkit-details-marker{display:none}
.study-fold>summary::after{content:"▾";color:var(--muted);font-size:11px;transition:transform .18s}
.study-fold[open]>summary::after{transform:rotate(180deg)}
.fold-title{font-weight:720;font-size:13px}
.fold-hint{color:var(--muted);font-size:11.5px}
.fold-stat{color:var(--muted);font:650 11px/1 var(--num);font-variant-numeric:tabular-nums;text-align:right}
.study-body{padding:22px;border-top:1px solid var(--line);background:var(--bg)}
.study-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.study-card{padding:16px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}
.study-card h3{margin:0 0 11px;font-size:13px}
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.metric{padding:12px;border:1px solid var(--line);border-radius:9px;background:var(--bg)}
.metric .k{font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
.metric .v{margin-top:5px;font:760 20px/1 var(--num);font-variant-numeric:tabular-nums}
.metric .sub{margin-top:5px;color:var(--muted);font-size:9.5px;line-height:1.35}
.fact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.fact{padding:11px 12px;border:1px solid var(--line);border-radius:9px;background:var(--panel)}
.fact .k{color:var(--muted);font-size:9.5px}.fact .v{margin-top:4px;font:720 13px/1.2 var(--num);font-variant-numeric:tabular-nums}
.chart-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:14px}
.chart-card{padding:15px;border:1px solid var(--line);border-radius:10px;background:var(--panel)}
.chart-title{margin-bottom:8px;font-size:11px;font-weight:700;color:var(--muted)}
.receipt-line{margin-top:12px;color:var(--muted);font-size:10.5px}
.data-table{width:100%;border-collapse:collapse;font-size:11.5px;font-variant-numeric:tabular-nums}
.data-table th{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line);color:var(--muted);
  font-size:9px;text-transform:uppercase;letter-spacing:.06em}
.data-table td{padding:8px;border-bottom:1px solid var(--line)}
.data-table tr:last-child td{border-bottom:none}
.data-table .blown td{color:var(--down)}

/* strategy fold */
.strategy-tabs{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px}
.strategy-tab{font:650 11px/1 var(--font-ui);padding:8px 11px;border:1px solid var(--line);border-radius:8px;
  color:var(--muted);background:var(--panel);cursor:pointer}
.strategy-tab.on{color:var(--text);border-color:var(--btc-line);background:var(--btc-soft)}
.strategy-panel[hidden]{display:none}
.strategy-thesis{margin:0 0 13px;color:var(--muted);font-size:11.5px;max-width:1050px}
.equity-box{margin-top:13px;padding:14px;border:1px solid var(--line);border-radius:9px;background:var(--panel)}
.equity-box svg{height:250px!important}
.strategy-split{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;margin-top:14px}
.rule-list{margin:0;padding-left:18px;color:var(--muted);font-size:11.5px}.rule-list li{margin:5px 0}

/* time machine — retained advanced instrument */
.vtm-wrap{position:relative;margin:2px 0}
.vtm-canvas{display:block;width:100%;height:64px;cursor:ew-resize;border-radius:8px;touch-action:none}
.vtm-range{appearance:none;width:100%;height:16px;background:transparent;margin:2px 0 0;cursor:ew-resize}
.vtm-range::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:var(--line)}
.vtm-range::-webkit-slider-thumb{appearance:none;width:16px;height:16px;margin-top:-6px;border-radius:50%;
  background:var(--text);border:2px solid var(--panel)}
.vtm-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:10px 0 4px}
.vtm-btn{font:650 11px/1 var(--font-ui);cursor:pointer;background:var(--panel);border:1px solid var(--line);
  border-radius:7px;padding:7px 10px;color:var(--muted)}
.vtm-play{width:32px}.vtm-play-ico{display:inline-block;width:0;height:0;border-style:solid;border-width:5px 0 5px 8px;
  border-color:transparent transparent transparent var(--text)}
.vtm-play.is-playing .vtm-play-ico{width:8px;height:10px;border:none;border-left:2px solid var(--text);border-right:2px solid var(--text)}
.vtm-presets{display:flex;gap:5px;flex-wrap:wrap}
.vtm-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:9.5px;color:var(--muted);margin:7px 0}
.vtm-legend i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px}
.vtm-readout{border:1px solid var(--line);border-radius:9px;padding:13px 14px;margin-top:10px;background:var(--panel)}
.vtm-asof{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.vtm-date{font:760 16px/1 var(--num)}.vtm-tag{font-size:9px;text-transform:uppercase;letter-spacing:.06em;
  padding:2px 7px;border-radius:7px;background:var(--panel2);color:var(--muted)}
.vtm-price{margin-left:auto;font:740 14px/1 var(--num)}
.vtm-badges{display:flex;align-items:center;gap:7px 13px;flex-wrap:wrap;margin-top:11px;font-size:10.5px;color:var(--muted)}
.vtm-badge{padding:3px 8px;border-radius:7px;font-weight:700;background:var(--panel2);color:var(--text)}
.vtm-badges .kv b{color:var(--text)}
.vtm-gauge{margin-top:11px}.vtm-glabel{display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-bottom:4px}
.vtm-grail{position:relative;height:4px;border-radius:3px;background:linear-gradient(90deg,var(--up),var(--line) 50%,var(--down))}
.vtm-grail i{position:absolute;top:50%;width:10px;height:10px;border-radius:50%;background:var(--text);border:2px solid var(--panel);transform:translate(-50%,-50%)}

.page-foot{margin-top:28px;text-align:center;color:var(--muted);font-size:10.5px}
:focus-visible{outline:2px solid var(--btc);outline-offset:2px}
@media(max-width:1050px){
  .complex-grid{grid-template-columns:repeat(3,1fr)}.complex-card{border-bottom:1px solid var(--line)}
  .complex-card:nth-child(3){border-right:none}.complex-card:nth-last-child(-n+2){border-bottom:none}
  .axis-row{grid-template-columns:minmax(170px,1fr) 130px 150px 105px 24px}
}
@media(max-width:780px){
  .vector-wrap{width:min(100% - 24px,1500px)}.shelf-inner{padding:18px}
  .hero{padding:20px 18px}.hero-read{grid-template-columns:1fr;gap:16px}.master-meter{border-left:none;border-top:1px solid var(--line);padding:13px 0 0}
  .decision-grid{grid-template-columns:1fr}.decision-main{border-right:none;border-bottom:1px solid var(--line);padding:22px 18px}.decision-detail{padding:20px 18px}
  .axis-row{grid-template-columns:1fr auto 24px;gap:8px 12px;padding:13px 17px}
  .axis-spark{grid-column:1/2;width:100%;height:28px}.axis-micro{grid-column:2/3;grid-row:2;text-align:right}.axis-row>.qm{grid-column:3;grid-row:1/3}
  .watch-grid{grid-template-columns:1fr}.watch-item{border-right:none;border-bottom:1px solid var(--line);min-height:0}.watch-item:last-child{border-bottom:none}
  .complex-grid{grid-template-columns:repeat(2,1fr)}.complex-card:nth-child(3){border-right:1px solid var(--line)}
  .complex-card:nth-child(even){border-right:none}.complex-card:nth-last-child(2){border-bottom:1px solid var(--line)}
  .complex-card:last-child{grid-column:1/-1;border-bottom:none}
  .study-fold>summary{grid-template-columns:1fr auto;gap:4px 10px}.fold-hint{grid-column:1}.fold-stat{grid-column:1;text-align:left}
  .study-body{padding:16px}.study-grid,.chart-grid,.strategy-split{grid-template-columns:1fr}.metric-grid,.fact-grid{grid-template-columns:repeat(2,1fr)}
  .level-grid{grid-template-columns:1fr 1fr}.level:last-child{grid-column:1/-1}
}
@media(max-width:480px){
  .vector-wrap{width:calc(100% - 16px)}.shelf{margin-top:12px}.stance{font-size:42px}
  .wordmark{width:100%}.live-quote{margin-left:0}.asof-chip{margin-left:auto}
  .tape-shell{padding-left:2px;padding-right:2px}.tape-legend{position:static;margin:0 8px 5px}
  .what-changed{align-items:flex-start}.all-alerts{margin-left:0;width:100%}
  .level-grid,.complex-grid,.metric-grid,.fact-grid{grid-template-columns:1fr}
  .complex-card,.complex-card:nth-child(3),.complex-card:nth-child(even){border-right:none;border-bottom:1px solid var(--line)}
  .complex-card:last-child{grid-column:auto}.equity-box svg{height:210px!important}
  .axis-row{grid-template-columns:1fr auto 22px}.axis-name{font-size:12px}.axis-state{font-size:12px}
}
@media(prefers-reduced-motion:reduce){.ilx-path,.ilx-bar{animation:none!important}}
</style>
</head>
<body class="page-vector">
{% include "_site_nav.html.j2" %}
<main class="vector-wrap">

  <section class="shelf" data-shelf="S1">
    <div class="hero">
      <div class="hero-line">
        <div class="wordmark"><span class="mark">₿</span><span>Bitcoin Vector</span></div>
        <div class="live-quote">
          <span class="live-price" data-sym="BTC-USD">${{ "{:,.0f}".format(price) }}</span>
          <span class="live-change {{ 'pos' if chg24 >= 0 else 'neg' }}" data-sym-chg="BTC-USD">{{ "%+.1f"|format(chg24) }}%</span>
        </div>
        <span class="asof-chip"><i></i>{{ t('Daily close','日线收盘') }} · {{ as_of }}</span>
      </div>
      {% set hero_tone = master.tone if master and master.ok else 'neutral' %}
      <div class="hero-read">
        <div>
          <h1 class="stance">{{ t(master.band if master and master.ok else 'READ UNAVAILABLE', master.band_zh if master and master.ok else '暂无判断') }}</h1>
          <p class="hero-summary">
            {% if hero_tone == 'bull' %}{{ t('The long-cycle read is constructive, while short-term direction remains uncertain.','长周期判断偏积极，但短期方向仍不确定。') }}
            {% elif hero_tone == 'bear' %}{{ t('The long-cycle read is defensive, while short-term direction remains uncertain.','长周期判断偏防守，但短期方向仍不确定。') }}
            {% else %}{{ t('The long-cycle evidence is mixed; position size matters more than short-term prediction.','长周期证据分化；仓位管理比短期预测更重要。') }}{% endif %}
          </p>
        </div>
        <div class="master-meter {{ tone_class(hero_tone) }}">
          <div class="meter-top"><span class="meter-label">{{ t('Master read','总读数') }}</span><span class="meter-score">{{ "%+d"|format(master.score) if master and master.ok else '—' }}</span></div>
          <div class="meter-rail"><i></i></div>
          <div class="meter-note">{{ master.n_bull if master and master.ok else 0 }} {{ t('supportive','项支撑') }} · {{ master.n_bear if master and master.ok else 0 }} {{ t('cautious','项谨慎') }}</div>
        </div>
      </div>
      <div class="tape-shell">
        <div class="tape-legend">
          <span><i style="background:var(--btc)"></i>{{ t('BTC price','BTC 价格') }}</span>
          <span><i style="background:var(--up)"></i>{{ t('final exposure','最终仓位') }}</span>
          <span><i style="background:var(--muted)"></i>{{ t('regime bands','状态区间') }}</span>
        </div>
        {{ presentation.tape|safe }}
      </div>
      <div class="what-changed">
        <span class="what-label">{{ t('What changed','最新变化') }}</span>
        {% if timeline and timeline[0] and timeline[0].events %}
          {% for e in timeline[0].events[:3] %}
          <span class="change-chip"><i></i><span>{{ t(e.headline, e.headline_zh) }}</span></span>
          {% endfor %}
        {% else %}
          <span class="change-chip"><i></i><span>{{ t('No material change in the latest daily read.','最新日线判断无明显变化。') }}</span></span>
        {% endif %}
        <a class="all-alerts" href="alerts.html">{{ t('Alert Center','警报中心') }} →</a>
      </div>
    </div>
  </section>

  {% set gate_on = gate and gate.active %}
  {% set rec_ok = rec and rec.ok and not rec.suppressed_by_blackout %}
  {% set rt = rec.tone if rec_ok else 'neutral' %}
  {% set L = rec.levels if rec and rec.ok else {} %}
  <section class="shelf {{ tone_class(rt) }}" data-shelf="S2" data-verdict>
    <div class="shelf-inner">
      <div class="shelf-head"><span class="shelf-kicker">S2</span><h2 class="shelf-title">{{ t('What To Do','该怎么做') }}</h2><span class="shelf-sub">{{ t('one action · one sizing source','一个行动 · 一个仓位来源') }}</span></div>
    </div>
    <div class="decision-grid">
      <div class="decision-main">
        <div class="decision-eyebrow">{{ t('Current action','当前行动') }}</div>
        <div class="decision-action">
          {% if gate_on %}{{ t('WAIT IN CASH','持币等待') }}
          {% elif rec_ok %}{{ t(rec.action, rec.action_zh) }}
          {% else %}{{ t('HOLD POSITION','维持仓位') }}{% endif %}
        </div>
        <div class="decision-basis">
          {% if gate_on %}<b>{{ t('Timing model active.','择时模型生效。') }}</b> {{ t('The final allocation remains in cash until the standing window releases.','最终配置保持现金，直至既定窗口解除。') }}
          {% elif rec_ok %}<b>{{ t({'HIGH':'Higher confidence','MODERATE':'Moderate confidence','LOW':'Lower confidence'}.get(rec.conviction,rec.conviction), {'HIGH':'较高把握','MODERATE':'中等把握','LOW':'把握较低'}.get(rec.conviction,rec.conviction)) }}</b> · {{ t(rec.basis_en,rec.basis_zh) }}
          {% else %}{{ t('The decision layer is updating; do not change size from this page.','决策层正在更新；不要仅凭此页调整仓位。') }}{% endif %}
        </div>
      </div>
      <div class="decision-detail">
        {% set elo = 0 if gate_on else (rec.exposure_lo if rec_ok else alloc_pct) %}
        {% set ehi = 0 if gate_on else (rec.exposure_hi if rec_ok else alloc_pct) %}
        <div class="exposure-top">
          <div><div class="decision-eyebrow">{{ t('Target BTC exposure','目标 BTC 仓位') }}</div><div class="exposure-band">{{ elo }}–{{ ehi }}%</div></div>
          <div class="risk-context">{{ t('Risk level','风险程度') }}<b>{{ risk_index }}/100</b>{{ t(risk_label, '低风险' if risk_on else '高风险') }}</div>
        </div>
        <div class="exposure-rail">
          <i class="band" style="left:{{ elo }}%;width:{{ [ehi-elo,1]|max }}%"></i>
          <i class="model" style="left:{{ alloc_pct }}%" data-tip-en="Final model exposure" data-tip-zh="最终模型仓位"></i>
        </div>
        <div class="exposure-scale"><span>0% {{ t('cash','现金') }}</span><span>{{ t('final model','最终模型') }} {{ alloc_pct }}%</span><span>100% BTC</span></div>
        <div class="level-grid">
          <div class="level"><span class="k">{{ t('Accumulate zone','累积区间') }}</span><b>{% if L.accumulate_lo and L.accumulate_hi %}${{ "{:,.0f}".format(L.accumulate_lo) }}–${{ "{:,.0f}".format(L.accumulate_hi) }}{% else %}—{% endif %}</b></div>
          <div class="level"><span class="k">{{ t(L.invalid_label_en if L.invalid_label_en else 'Level that changes the read',L.invalid_label_zh if L.invalid_label_zh else '改变判断的价位') }}</span><b>{% if L.invalidation %}${{ "{:,.0f}".format(L.invalidation) }}{% else %}—{% endif %}</b></div>
          <div class="level"><span class="k">{{ t('Typical 90-day range','90 天常见区间') }}</span><b>{% if L.downside_90 and L.upside_90 %}${{ "{:,.0f}".format(L.downside_90) }}–${{ "{:,.0f}".format(L.upside_90) }}{% else %}—{% endif %}</b></div>
        </div>
        <div class="decision-foot">{{ t('Direction can remain uncertain even when sizing is clear. The final exposure is the engine output after all standing gates.','即使方向不确定，仓位仍可明确。最终仓位是所有既定规则生效后的引擎输出。') }}</div>
      </div>
    </div>
  </section>

  <section class="shelf" data-shelf="S3">
    <div class="shelf-inner">
      <div class="shelf-head"><span class="shelf-kicker">S3</span><h2 class="shelf-title">{{ t('Why','为什么') }}</h2><span class="shelf-sub">{{ t('six governing drivers','六个主导因素') }}</span></div>
    </div>
    <div class="axis-board">
      {% for row in presentation.axes %}
      <div class="axis-row {{ tone_class(row.primary.tone) }}">
        <div class="axis-name"><span class="state-dot"></span>{{ t(row.label_en,row.label_zh) }}</div>
        <div class="axis-state">{{ t(row.primary.state_en,row.primary.state_zh) }}</div>
        <svg class="axis-spark" viewBox="0 0 150 34" preserveAspectRatio="none" aria-hidden="true"><polyline points="{{ row.spark }}"></polyline></svg>
        <div class="axis-micro"><b>{{ row.micro }}</b><span>{{ t(row.micro_en,row.micro_zh) }}</span></div>
        {{ qmark(row.receipt_en,row.receipt_zh) }}
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="shelf" data-shelf="S4">
    <div class="shelf-inner">
      <div class="shelf-head"><span class="shelf-kicker">S4</span><h2 class="shelf-title">{{ t("What We're Watching",'正在观察') }}</h2><span class="shelf-sub">{{ t('conditions that could change the read','可能改变判断的条件') }}</span></div>
    </div>
    <div class="watch-grid">
      {% for w in presentation.watch %}
      <div class="watch-item {{ 'tone-up' if w.level=='ok' else ('tone-down' if w.level=='alert' else 'tone-flat') }}">
        <div class="watch-top"><span class="watch-name">{{ t(w.title_en,w.title_zh) }}</span><span class="watch-state">{{ t(w.state_en,w.state_zh) }}</span></div>
        <div class="watch-copy">{{ t(w.body_en,w.body_zh) }}</div>
      </div>
      {% else %}
      <div class="watch-item tone-flat">
        <div class="watch-top"><span class="watch-name">{{ t('Cycle window','周期窗口') }}</span><span class="watch-state">{{ t('Updating','更新中') }}</span></div>
        <div class="watch-copy">{{ t('The next timing window is being refreshed from the latest close.','下一时间窗口正在依据最新收盘更新。') }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="projection-note">{{ t('Windows, not certainties. The watch window is re-drawn nightly as the evidence changes.','这是观察窗口，不是确定预测。证据变化时，窗口会在每晚重新绘制。') }}</div>
  </section>

  <section class="shelf" data-shelf="S5">
    <div class="shelf-inner">
      <div class="shelf-head"><span class="shelf-kicker">S5</span><h2 class="shelf-title">{{ t('The Complex','加密市场全景') }}</h2><span class="shelf-sub">{{ t('Bitcoin in context','把比特币放回全市场') }}</span></div>
    </div>
    <div class="complex-grid">
      {% for c in presentation.complex %}
      <div class="complex-card">
        <div class="complex-top">
          <div><div class="complex-symbol">{{ c.symbol }}</div><div class="complex-name">{{ t(c.name_en,c.name_zh) }}</div></div>
          <div class="complex-value">{{ c.value }}</div>
        </div>
        <div class="complex-chart">{{ c.chart|safe }}</div>
        <div class="complex-context {{ 'pos' if c.tone=='up' else ('neg' if c.tone=='down' else '') }}">{{ t(c.context_en,c.context_zh) }}</div>
      </div>
      {% endfor %}
    </div>
  </section>

  <section class="shelf" data-shelf="S6">
    <div class="shelf-inner">
      <div class="shelf-head"><span class="shelf-kicker">S6</span><h2 class="shelf-title">{{ t('Study Shelf','研究架') }}</h2><span class="shelf-sub">{{ t('depth on demand','按需查看深度') }}</span></div>
    </div>
    <div class="study-list">
      <details class="study-fold" id="cycle-lab">
        <summary><span class="fold-title">{{ t('Cycle Lab','周期实验室') }}</span><span class="fold-hint">{{ t('Rewind every point-in-time read','回看每个历史时点的完整判断') }}</span><span class="fold-stat">{{ cycle_stage }} · {{ cycle_pos }}%</span></summary>
        <div class="study-body">
          <div id="vtm" class="vtm-wrap">
            <canvas id="vtm-canvas" class="vtm-canvas"></canvas>
            <input id="vtm-range" class="vtm-range" type="range" min="0" max="0" value="0" aria-label="Scrub BTC cycle history">
            <div class="vtm-legend">
              <span><i style="background:#3b6fe0"></i>{{ t('Accumulation','吸筹') }}</span>
              <span><i style="background:#1f9d57"></i>{{ t('Markup','拉升') }}</span>
              <span><i style="background:#e0a43a"></i>{{ t('Recovery','修复') }}</span>
              <span><i style="background:#cf4f4f"></i>{{ t('Markdown','派发下行') }}</span>
            </div>
            <div class="vtm-controls">
              <button class="vtm-btn vtm-play" id="vtm-play" aria-label="Play"><span class="vtm-play-ico"></span></button>
              <span class="vtm-presets">
                <button class="vtm-btn" data-vtm-jump="now">{{ t('Now','当前') }}</button>
                <button class="vtm-btn" data-vtm-jump="2017-12-17">{{ t('2017 high','2017 高点') }}</button>
                <button class="vtm-btn" data-vtm-jump="2018-12-15">{{ t('2018 low','2018 低点') }}</button>
                <button class="vtm-btn" data-vtm-jump="2021-04-14">{{ t('2021 high','2021 高点') }}</button>
                <button class="vtm-btn" data-vtm-jump="2022-11-09">{{ t('2022 break','2022 急跌') }}</button>
              </span>
            </div>
            <div class="vtm-readout">
              <div class="vtm-asof"><span class="vtm-date" id="vtm-date">—</span><span class="vtm-tag is-live" id="vtm-tag">—</span><span class="vtm-price" id="vtm-price">—</span></div>
              <div class="vtm-badges">
                <span class="vtm-badge" id="vtm-phase">—</span><span class="vtm-badge" id="vtm-regime">—</span><span class="vtm-badge" id="vtm-extreme" style="display:none">—</span>
                <span class="kv">{{ t('stage','阶段') }} <b id="vtm-stage">—</b></span>
                <span class="kv">{{ t('cycle','周期') }} <b id="vtm-cphase">—</b></span>
                <span class="kv">{{ t('ladder','阶梯') }} <b id="vtm-ladder">—</b></span>
                <span class="kv">{{ t('momentum','动量') }} <b id="vtm-mom">—</b></span>
                <span class="kv">{{ t('valuation','估值') }} <b id="vtm-val">—</b></span>
                <span class="kv">{{ t('stance','立场') }} <b id="vtm-composite">—</b></span>
                <span class="kv">{{ t('model exposure','模型仓位') }} <b id="vtm-alloc">—</b></span>
              </div>
              <div class="vtm-gauge"><div class="vtm-glabel"><span>{{ t('Risk level','风险程度') }}</span><span id="vtm-risk-v">—</span></div><div class="vtm-grail"><i id="vtm-risk-i" style="left:50%"></i></div></div>
            </div>
          </div>
          <div class="receipt-line">{{ t('Every historical frame uses the data and standing rules available on that date.','每个历史画面仅使用当日可得数据与当时既定规则。') }}</div>
        </div>
      </details>

      <details class="study-fold" id="derivatives-desk">
        <summary><span class="fold-title">{{ t('Derivatives Desk','衍生品台') }}</span><span class="fold-hint">{{ t('Volatility, leverage and positioning receipts','波动、杠杆与持仓明细') }}</span><span class="fold-stat">{{ options.dvol if options.dvol is not none else '—' }} DVOL · {{ leverage.funding_annual if leverage.funding_annual is not none else '—' }}%</span></summary>
        <div class="study-body">
          <div class="fact-grid">
            <div class="fact"><div class="k">{{ t('Implied volatility','隐含波动率') }}</div><div class="v">{{ "%.1f"|format(btc_options.volatility.atm_iv_30d) if btc_options.volatility.atm_iv_30d is not none else (options.dvol if options.dvol is not none else '—') }}</div></div>
            <div class="fact"><div class="k">{{ t('Gamma flip','Gamma 翻转位') }}</div><div class="v">{% if btc_options.gamma.flip is not none %}${{ "{:,.0f}".format(btc_options.gamma.flip) }}{% elif options.gamma_flip %}${{ "{:,.0f}".format(options.gamma_flip) }}{% else %}—{% endif %}</div></div>
            <div class="fact"><div class="k">{{ t('Distance to flip','距翻转位') }}</div><div class="v">{{ "%+.1f%%"|format(btc_options.gamma.distance_pct) if btc_options.gamma.distance_pct is not none else '—' }}</div></div>
            <div class="fact"><div class="k">{{ t('Put / call OI','看跌/看涨持仓') }}</div><div class="v">{{ "%.2f×"|format(btc_options.positioning.put_call_oi_ratio) if btc_options.positioning.put_call_oi_ratio is not none else '—' }}</div></div>
            <div class="fact"><div class="k">{{ t('Max pain','最大痛点') }}</div><div class="v">{% if btc_options.positioning.max_pain is not none %}${{ "{:,.0f}".format(btc_options.positioning.max_pain) }}{% else %}—{% endif %}</div></div>
            <div class="fact"><div class="k">{{ t('Futures basis','期货基差') }}</div><div class="v">{{ "%+.1f%%"|format(btc_options.basis.annualized_pct) if btc_options.basis.annualized_pct is not none else '—' }}</div></div>
            <div class="fact"><div class="k">{{ t('Funding, annualized','资金费率年化') }}</div><div class="v">{{ leverage.funding_annual if leverage.funding_annual is not none else '—' }}%</div></div>
            <div class="fact"><div class="k">{{ t('Open interest','未平仓量') }}</div><div class="v">{% if leverage.oi_total %}${{ "{:,.0f}".format(leverage.oi_total/1e9) }}B{% else %}—{% endif %}</div></div>
            {% if leverage.okx_ls_ratio is not none %}
            <div class="fact"><div class="k">{{ t('Retail long/short ratio','散户账户多空比') }} {{ qmark('Contrarian context only. ' ~ leverage.okx_ls_pctile ~ '%ile · z ' ~ leverage.okx_ls_z ~ '. A crowded long is not a buy signal.','仅作反向背景参考。' ~ leverage.okx_ls_pctile ~ ' 百分位 · 标准分 ' ~ leverage.okx_ls_z ~ '。多头拥挤不等于买入信号。') }}</div><div class="v">{{ leverage.okx_ls_ratio }}×</div></div>
            {% endif %}
            {% if leverage.okx_taker_buy is not none %}
            <div class="fact"><div class="k">{{ t('Taker buy share','主动买盘占比') }} {{ qmark('Share of aggressive OKX volume crossing the offer. Context only; not a standalone trade signal.','OKX 主动成交量中向上吃单的占比。仅作背景，不是独立交易信号。') }}</div><div class="v">{{ "%.1f%%"|format(leverage.okx_taker_buy*100) }}</div></div>
            {% endif %}
          </div>
          {% if charts.etf_flow %}<div class="chart-card" style="margin-top:14px"><div class="chart-title">{{ t('ETF net flow','ETF 净流量') }}</div>{{ charts.etf_flow|safe }}</div>{% endif %}
          <div class="receipt-line">{{ t(btc_options.coverage.note_en,btc_options.coverage.note_zh) }} {{ t(btc_options.gamma.assumption_en,btc_options.gamma.assumption_zh) }}</div>
          <div class="receipt-line">{{ t('Positioning describes pressure, not direction. It never changes the verdict by itself.','持仓数据描述压力，不直接判断方向，也不会单独改变结论。') }}</div>
        </div>
      </details>

      <details class="study-fold" id="onchain-lab">
        <summary><span class="fold-title">{{ t('On-chain Lab','链上实验室') }}</span><span class="fold-hint">{{ t('Valuation, holders, miners and demand','估值、持币者、矿工与需求') }}</span><span class="fold-stat">BFI {{ bfi if bfi is not none else '—' }} · MVRV {{ valuation.mvrv_z if valuation.mvrv_z is not none else '—' }}</span></summary>
        <div class="study-body">
          <div class="fact-grid">
            <div class="fact"><div class="k">MVRV</div><div class="v">{{ valuation.mvrv_z if valuation.mvrv_z is not none else '—' }}</div></div>
            <div class="fact"><div class="k">{{ t('Holder behavior','持币者行为') }}</div><div class="v">{{ t(newf.holders.state or 'Unavailable',newf.holders.state or '暂无') }}</div></div>
            <div class="fact"><div class="k">{{ t('Miner economics','矿工经济') }}</div><div class="v">{{ t(newf.miner.state or 'Unavailable',newf.miner.state or '暂无') }}</div></div>
            <div class="fact"><div class="k">{{ t('Coinbase demand','Coinbase 需求') }}</div><div class="v">{{ t(onchain.premium_state or 'Unavailable',onchain.premium_state or '暂无') }}</div></div>
          </div>
          <div class="chart-grid">
            <div class="chart-card"><div class="chart-title">{{ t('Momentum','动量') }}</div>{{ charts.momentum|safe }}</div>
            <div class="chart-card"><div class="chart-title">{{ t('Market structure','市场结构') }}</div>{{ charts.structure|safe }}</div>
            <div class="chart-card"><div class="chart-title">{{ t('Fundamentals','基本面') }}</div>{{ charts.bfi|safe }}</div>
          </div>
          {% if cycle_vintage.reserve_risk_asof or cycle_vintage.vdd_asof %}
          <div class="receipt-line">{{ t('Reserve Risk and VDD use backfill vintages only: Reserve Risk through ' ~ (cycle_vintage.reserve_risk_asof or 'unavailable') ~ '; VDD through ' ~ (cycle_vintage.vdd_asof or 'unavailable') ~ '. No daily scrape or quota expansion is used.','储备风险与 VDD 仅使用历史回填版本：储备风险截至 ' ~ (cycle_vintage.reserve_risk_asof or '暂无') ~ '；VDD 截至 ' ~ (cycle_vintage.vdd_asof or '暂无') ~ '。未使用每日抓取或扩大配额。') }}</div>
          {% endif %}
          <div class="receipt-line">{{ t('These are supporting receipts. The final position remains governed by the allocation engine.','这些是支撑性明细。最终仓位仍由配置引擎决定。') }}</div>
        </div>
      </details>

      <details class="study-fold" id="strategy-track-record">
        <summary><span class="fold-title">{{ t('Strategy & Track Record','策略与历史表现') }}</span><span class="fold-hint">{{ t('Two rule sets, dual timing metrics and honest leverage outcomes','两套规则、双口径计时指标与真实杠杆结果') }}</span><span class="fold-stat">{{ strategy.as_of if strategy.as_of else as_of }}</span></summary>
        <div class="study-body">
          <div class="strategy-tabs" role="tablist">
            {% for s in strategy.strategies %}
            <button class="strategy-tab {{ 'on' if loop.first }}" data-strategy="{{ s.id }}" role="tab">{{ t('Cycle Timer' if s.id=='cycle' else 'Risk Allocation','周期计时' if s.id=='cycle' else '风险配置') }}</button>
            {% endfor %}
          </div>
          {% for s in strategy.strategies %}
          <section class="strategy-panel" data-strategy-panel="{{ s.id }}"{% if not loop.first %} hidden{% endif %}>
            <p class="strategy-thesis">
              {% if s.id=='cycle' %}{{ t('A chained cycle schedule holds BTC through the projected up-phase and moves to cash through the projected down-phase. The exact timing model remains proprietary.','链式周期计划在预测上行阶段持有 BTC，并在预测下行阶段转为现金。具体计时模型保持专有。') }}
              {% else %}{{ t('A 200-day trend filter and long-term stretch throttle scale exposure, with the standing timing window applied separately.','通过 200 日趋势过滤与长期偏离节流器调整仓位，并另行应用既定时间窗口。') }}{% endif %}
            </p>
            <div class="metric-grid">
              <div class="metric"><div class="k">{{ t('Total return','总回报') }}</div><div class="v">{{ "{:,.0f}".format(s.metrics.total) }}×</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ "{:,.0f}".format(strategy.hodl.total) }}×{% if s.metrics_raw.total != s.metrics.total %}<br>{{ t('without timing window','不含时间窗口') }} {{ "{:,.0f}".format(s.metrics_raw.total) }}×{% endif %}</div></div>
              <div class="metric"><div class="k">CAGR</div><div class="v">{{ "%.0f"|format(s.metrics.cagr) }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ "%.0f"|format(strategy.hodl.cagr) }}%{% if s.metrics_raw.cagr != s.metrics.cagr %}<br>{{ t('without timing window','不含时间窗口') }} {{ "%.0f"|format(s.metrics_raw.cagr) }}%{% endif %}</div></div>
              <div class="metric"><div class="k">{{ t('Sharpe','夏普') }}</div><div class="v">{{ "%.2f"|format(s.metrics.sharpe) }}</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ "%.2f"|format(strategy.hodl.sharpe) }}{% if s.metrics_raw.sharpe != s.metrics.sharpe %}<br>{{ t('without timing window','不含时间窗口') }} {{ "%.2f"|format(s.metrics_raw.sharpe) }}{% endif %}</div></div>
              <div class="metric"><div class="k">{{ t('Max drawdown','最大回撤') }}</div><div class="v">{{ "%.0f"|format(s.metrics.maxdd) }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ "%.0f"|format(strategy.hodl.maxdd) }}%{% if s.metrics_raw.maxdd != s.metrics.maxdd %}<br>{{ t('without timing window','不含时间窗口') }} {{ "%.0f"|format(s.metrics_raw.maxdd) }}%{% endif %}</div></div>
            </div>
            <div class="equity-box">{{ s.svg|safe }}</div>
            <div class="strategy-split">
              {% if s.id=='cycle' %}
              <div class="study-card"><h3>{{ t('Leverage · honest outcomes','杠杆 · 真实结果') }}</h3>
                <table class="data-table"><thead><tr><th>{{ t('Leverage','杠杆') }}</th><th>{{ t('Total','总计') }}</th><th>CAGR</th><th>{{ t('Max drawdown','最大回撤') }}</th><th>{{ t('Outcome','结果') }}</th></tr></thead><tbody>
                {% for r in s.leverage %}<tr class="{{ 'blown' if r.blown }}"><td><b>{{ r.lev }}×</b></td><td>{{ '$0' if r.blown else "{:,.0f}×".format(r.total) }}</td><td>{{ "%.0f"|format(r.cagr) }}%</td><td>{{ "%.0f"|format(r.maxdd) }}%</td><td>{{ t('liquidated to $0' if r.blown else 'survived','强平归零' if r.blown else '存续') }}</td></tr>{% endfor %}
                </tbody></table>
                <div class="receipt-line">{{ t('Includes transaction costs, about 10% annual borrowing cost on the levered portion, and liquidation when position equity reaches zero.','包含交易成本、杠杆部分约 10% 年借贷成本，以及仓位净值归零时的强平。') }}</div>
              </div>
              <div class="study-card"><h3>{{ t('Projected cycle pivots','预测周期拐点') }}</h3>
                <table class="data-table"><thead><tr><th>{{ t('Date','日期') }}</th><th>{{ t('Pivot','拐点') }}</th><th>BTC</th></tr></thead><tbody>
                {% for p in s.pivots %}<tr><td>{{ p.date }}</td><td>{{ t('Low' if p.is_bottom else 'High','低点' if p.is_bottom else '高点') }}</td><td>{{ ('$' ~ "{:,.0f}".format(p.price)) if p.price else t('projected','预测') }}</td></tr>{% endfor %}
                </tbody></table>
              </div>
              {% else %}
              <div class="study-card"><h3>{{ t('Rule book','规则手册') }}</h3><ul class="rule-list"><li>{{ t('Hold only while price is above the 200-day trend.','仅在价格高于 200 日趋势时持有。') }}</li><li>{{ t('Reduce exposure as price stretches above its long-term mean.','价格过度偏离长期均值时降低仓位。') }}</li><li>{{ t('Move to cash when the trend breaks.','趋势走坏时转为现金。') }}</li></ul></div>
              <div class="study-card"><h3>{{ t('Honest limits','真实局限') }}</h3><ul class="rule-list"><li>{{ t('Trend following gives back part of every high and re-enters late after lows.','趋势策略会回吐部分顶部收益，也会在低点后较晚重新入场。') }}</li><li>{{ t('The calendar rule has only a few completed cycles of history.','日历规则仅有少数完整周期的历史。') }}</li></ul></div>
              {% endif %}
            </div>
          </section>
          {% endfor %}

          <div class="study-card" style="margin-top:16px">
            <h3>{{ t('Allocation replay','配置回放') }} <span id="vrc-variant-label" style="color:var(--muted);font-weight:500">{{ t('· Optimal variant','· 最优变体') }}</span></h3>
            <div id="vec-risk-chart" class="vchart-wrap" style="--vchart-h:470px"><div class="receipt-line">{{ t('Loading interactive chart…','正在加载交互图表…') }}</div></div>
            <div class="metric-grid" id="vrc-score" data-cards="{{ cards|tojson|forceescape }}" style="margin-top:12px">
              <div class="metric"><div class="k">CAGR</div><div class="v" data-m="cagr">—</div></div>
              <div class="metric"><div class="k">{{ t('Sharpe','夏普') }}</div><div class="v" data-m="sharpe">—</div></div>
              <div class="metric"><div class="k">{{ t('Max drawdown','最大回撤') }}</div><div class="v" data-m="maxdd">—</div></div>
              <div class="metric"><div class="k">{{ t('Time invested','在场时间') }}</div><div class="v" data-m="in_market">—</div></div>
            </div>
          </div>
          <div class="receipt-line"><a href="strategy_btc_trend.html">{{ t('Trend strategy detail','趋势策略详情') }} →</a></div>
        </div>
      </details>

      <details class="study-fold" id="signal-health">
        <summary><span class="fold-title">{{ t('Signal Health','信号健康度') }}</span><span class="fold-hint">{{ t('Historical measurement and coverage receipts','历史测量与覆盖明细') }}</span><span class="fold-stat">{{ calib.meta.span if calib and calib.meta else as_of }}</span></summary>
        <div class="study-body">
          <table class="data-table">
            <thead><tr><th>{{ t('Signal','信号') }}</th><th>{{ t('Measurement band','测量级别') }}</th><th>{{ t('What is checked','检查内容') }}</th></tr></thead>
            <tbody>
            {% for name,e in calib.signals.items() %}
            <tr><td>{{ td(name) }}</td><td>{{ td(e.verdict) }}</td><td>{{ t('Whether past readings carried useful follow-through across history.','历史读数在不同阶段是否有持续参考价值。') }}</td></tr>
            {% endfor %}
            {% if calib.risk_drawdown %}<tr><td>{{ t('Risk level','风险程度') }}</td><td>{{ td(calib.risk_drawdown.verdict) }}</td><td>{{ t('Whether past readings anticipated near-term dips.','历史读数是否提前反映近期回撤。') }}</td></tr>{% endif %}
            </tbody>
          </table>
          <div class="receipt-line">{{ t('New display reads can appear before they are eligible to size money.','新的展示读数可先上线，但在满足条件前不得决定仓位。') }} <a href="measurement.html">{{ t('Open Measurement','打开测量中心') }} →</a></div>
        </div>
      </details>
    </div>
  </section>

  <div class="page-foot">Bitcoin Vector · {{ t('built','生成于') }} {{ built }} · {{ t('data through','数据截至') }} {{ as_of }}<br>© 2026 MastermindX Inc</div>
</main>

<script defer src="illus.js"></script>
<script src="theme.js"></script>
<script src="vector_timemachine.js?v=2"></script>
<script src="lightweight-charts-v5.js"></script>
<script src="vector_chart.js"></script>
<script>
(function(){
  var tabs=document.querySelectorAll('[data-strategy]'),panels=document.querySelectorAll('[data-strategy-panel]');
  tabs.forEach(function(btn){btn.addEventListener('click',function(){
    var id=btn.getAttribute('data-strategy');
    tabs.forEach(function(x){x.classList.toggle('on',x===btn)});
    panels.forEach(function(x){x.hidden=x.getAttribute('data-strategy-panel')!==id});
  })});
  var el=document.getElementById('vec-risk-chart'),sc=document.getElementById('vrc-score'),lab=document.getElementById('vrc-variant-label');
  if(!el||!sc||!window.VectorChart)return;
  var cards={};try{cards=JSON.parse(sc.getAttribute('data-cards'))}catch(e){}
  function zh(){return document.documentElement.getAttribute('data-lang')==='zh'}
  var names={conservative:['Conservative','保守'],moderate:['Moderate','稳健'],aggressive:['Aggressive','进取'],optimal:['Optimal','最优']};
  function sync(v){
    var c=cards[v];if(!c)return;
    sc.querySelectorAll('[data-m]').forEach(function(n){var m=n.getAttribute('data-m'),x=c[m];n.textContent=(m==='cagr'||m==='maxdd'||m==='in_market')?(x+'%'):x});
    if(lab){var nm=names[v]||[v,v];lab.textContent='· '+nm[zh()?1:0]+(zh()?' 变体':' variant')}
  }
  window.VectorChart.mount(el,'vector_risk_strategy.json',{onVariant:sync});
})();
</script>
</body>
</html>
