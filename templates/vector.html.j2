    </div>
  </div>
</nav>

<div class="wrap">

  <!-- ===================== MASTER SIGNAL · COMMAND CENTER ===================== -->
  {% if master and master.ok %}
  <style>
    /* §4 living hero: .cmd uses --hero token set from mcol */
    .cmd{display:grid;grid-template-columns:300px 1fr;gap:22px;position:relative;
      background:radial-gradient(120% 140% at 0% 0%, color-mix(in srgb,var(--hero,var(--blue)) 10%,var(--card)) 0%, var(--surface) 55%);
      border:1px solid color-mix(in srgb,var(--hero,var(--blue)) 24%,var(--surface-brd));
      border-radius:22px;padding:24px;margin-bottom:8px;
      -webkit-backdrop-filter:blur(20px) saturate(160%);backdrop-filter:blur(20px) saturate(160%);
      box-shadow:var(--surface-shadow);
      animation:vec-rise .5s cubic-bezier(.2,.7,.3,1) both}
    /* §4 breathing under-glow */
    .cmd::after{content:"";position:absolute;left:12%;right:12%;bottom:-16px;height:34px;z-index:-1;
      border-radius:50%;background:color-mix(in srgb,var(--hero,var(--blue)) 30%,transparent);filter:blur(16px);
      animation:vec-breathe 7s ease-in-out infinite}
    @keyframes vec-breathe{0%,100%{opacity:.35;filter:blur(16px)}50%{opacity:.6;filter:blur(20px)}}
    @media(max-width:780px){.cmd{grid-template-columns:1fr}}
    .cmd-h{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin:0 0 2px}
    .mg-wrap{position:relative;width:280px;height:150px;margin:6px auto 2px}
    /* §4 needle sweep via CSS var --mg-rot */
    .mg-needle{position:absolute;left:138px;top:32px;width:4px;height:108px;border-radius:3px;
      transform-origin:50% 100%;
      transform:rotate(var(--mg-rot,0deg));
      animation:mg-sweep 1.1s cubic-bezier(.34,1.3,.5,1) both;
      filter:drop-shadow(0 0 6px color-mix(in srgb,var(--hero,var(--blue)) 55%,transparent))}
    @keyframes mg-sweep{from{transform:rotate(-90deg)}to{transform:rotate(var(--mg-rot,0deg))}}
    /* §4 live-price pulse dot */
    .live-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--blue);
      margin-right:2px;vertical-align:6px;animation:vec-live 2.2s ease-in-out infinite}
    @keyframes vec-live{0%,100%{opacity:1;box-shadow:0 0 0 0 color-mix(in srgb,var(--blue) 45%,transparent)}
      50%{opacity:.55;box-shadow:0 0 0 5px transparent}}
    .mg-hub{position:absolute;left:130px;top:130px;width:20px;height:20px;border-radius:50%;border:3px solid var(--card)}
    .mg-score{position:absolute;left:0;right:0;top:74px;text-align:center;font-size:38px;font-weight:800;letter-spacing:-.03em;line-height:1}
    .mg-ends{display:flex;justify-content:space-between;font-size:11px;font-weight:700;color:var(--faint);margin:-6px 6px 0}
    .mg-band{text-align:center;font-size:22px;font-weight:800;letter-spacing:-.02em;margin-top:8px}
    .mg-tally{text-align:center;font-size:12px;color:var(--muted);margin-top:3px}
    .mg-tally b.bu{color:var(--blue)} .mg-tally b.be{color:var(--r3)}
    .cmd-r-top{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
    .cmd-price{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
    .cmd-stance{font-size:15px;font-weight:800}
    .cmd-head{font-size:13.5px;color:var(--text);line-height:1.55;margin-top:10px}
    .cmd-drv{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px}
    .cmd-drv .col{flex:1;min-width:200px}
    .cmd-drv .ch{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);margin-bottom:6px}
    .drvchip{display:flex;align-items:center;gap:7px;font-size:12.5px;padding:4px 0}
    .drvchip i{width:8px;height:8px;border-radius:50%;flex:none}
    .drvchip i.bull{background:var(--blue)} .drvchip i.bear{background:var(--r3)}
    .drvchip b{color:var(--ink);font-weight:700} .drvchip span{color:var(--muted)}
    .cmd-act{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px;
      border-top:1px solid var(--grid);padding-top:14px}
    .cmd-act .a{text-align:center}
    .cmd-act .a .k{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
    .cmd-act .a .v{font-size:18px;font-weight:800;color:var(--ink);margin-top:2px}
    .cmd-act .a .h{font-size:11px;color:var(--faint);margin-top:1px}
    /* Signal Board */
    .board{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media(max-width:900px){.board{grid-template-columns:1fr}}
    /* §2 bgrp surface recipe */
    .bgrp{background:var(--surface);border:1px solid var(--surface-brd);border-radius:16px;padding:14px 16px}
    .bgrp h4{margin:0 0 8px;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
    .brow{display:grid;grid-template-columns:12px minmax(0,1fr) auto;grid-template-rows:auto auto;
      gap:2px 10px;align-items:center;padding:8px 0;border-top:1px solid var(--grid)}
    .brow:first-of-type{border-top:none}
    .brow .dot{grid-area:1/1/3/2;width:9px;height:9px;border-radius:50%}
    .brow .dot.bull{background:var(--blue)} .brow .dot.bear{background:var(--r3)} .brow .dot.neutral{background:var(--muted)}
    .brow .lab{grid-area:1/2/2/3;font-size:13px;font-weight:600;color:var(--ink)}
    .brow .st{grid-area:2/2/3/3;font-size:11.5px;color:var(--muted)}
    .brow .spk{grid-area:1/3/2/4;justify-self:end;width:62px;height:24px}
    .brow .gr{grid-area:2/3/3/4;justify-self:end;font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:6px;letter-spacing:.02em}
    .gr-CONFIRMED{background:#E3F5E9;color:#1a7f43} .gr-DIRECTIONAL{background:#ECE9FB;color:#5b46c8}
    .gr-EXTREMES{background:#FFF2D9;color:#9a6a00} .gr-CONTEXT{background:var(--grid);color:var(--muted)}
    .gr-NEW{background:#DDF3F6;color:#0d7b8a} .gr-INVERTED{background:var(--grid);color:var(--muted)}
    html[data-theme="dark"] .gr-CONFIRMED{background:#16331f;color:#5fd08a}
    html[data-theme="dark"] .gr-DIRECTIONAL{background:#241d44;color:#a594f0}
    html[data-theme="dark"] .gr-EXTREMES{background:#3a2e12;color:#e0b34e}
    html[data-theme="dark"] .gr-NEW{background:#10333a;color:#4fc6d8}
    /* .brow .st and .brow .spk placement now defined in the grid-area block above */
    /* §4 sparkline draw-in */
    .brow .spk polyline{fill:none;stroke-width:1.6;vector-effect:non-scaling-stroke;
      stroke-dasharray:100;stroke-dashoffset:0;animation:spk-draw 1.2s ease-out both}
    @keyframes spk-draw{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
    .spk.bull polyline{stroke:var(--bull)} .spk.bear polyline{stroke:var(--bear)} .spk.neutral polyline{stroke:var(--neutral)}
    /* §4 RECOMMENDATION card — glass surface, pairs with .cmd */
    .reco{display:grid;grid-template-columns:1.1fr 1fr;gap:0;
      border:1px solid var(--surface-brd);border-radius:18px;overflow:hidden;margin-top:10px;
      box-shadow:var(--surface-shadow);
      animation:vec-rise .5s cubic-bezier(.2,.7,.3,1) both;animation-delay:.08s}
    @media(max-width:780px){.reco{grid-template-columns:1fr}}
    .reco-l{padding:20px 22px;border-right:1px solid var(--grid)}
    @media(max-width:780px){.reco-l{border-right:none;border-bottom:1px solid var(--grid)}}
    .reco-r{padding:20px 22px;display:flex;flex-direction:column;gap:14px}
    .reco-l.t-bull{background:linear-gradient(120% 140% at 0 0,var(--bull-soft),var(--surface) 60%)}
    .reco-l.t-bear{background:linear-gradient(120% 140% at 0 0,var(--bear-soft),var(--surface) 60%)}
    .reco-l.t-neutral{background:var(--surface)}
    .reco-k{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
    .reco-act{font-size:34px;font-weight:800;letter-spacing:-.02em;line-height:1.08;margin:6px 0 8px}
    .reco-act.t-bull{color:var(--bull)} .reco-act.t-bear{color:var(--bear)} .reco-act.t-neutral{color:var(--ink)}
    .reco-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--muted)}
    .reco-conv{font-size:11px;font-weight:800;padding:2px 9px;border-radius:7px;letter-spacing:.03em}
    .conv-high{background:var(--bull);color:#fff} .conv-moderate{background:var(--warn);color:#fff} .conv-low{background:var(--grid);color:var(--muted)}
    .reco-conv.bear.conv-high{background:var(--bear)}
    .reco-exp-band{font-size:24px;font-weight:800;color:var(--ink);margin:2px 0 6px}
    .exp-track{position:relative;height:12px;border-radius:7px;background:var(--grid)}
    .exp-fill{position:absolute;top:0;bottom:0;border-radius:7px;background:color-mix(in srgb,var(--bull) 55%,var(--grid))}
    .exp-fill.t-bear{background:color-mix(in srgb,var(--bear) 50%,var(--grid))}
    .exp-kelly{position:absolute;top:-3px;bottom:-3px;width:3px;margin-left:-1.5px;background:var(--ink);border-radius:2px}
    .exp-scale{display:flex;justify-content:space-between;font-size:10px;color:var(--faint);margin-top:4px}
    .reco-lvls{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px}
    .reco-lvls .lv .k{font-size:11px;color:var(--muted);font-weight:600;display:block}
    .reco-lvls .lv b{font-size:15px;color:var(--ink);font-weight:800}
    .reco-lvls .lv b.up{color:var(--bull)} .reco-lvls .lv b.down{color:var(--bear)}
    .reco-risk{font-size:12.5px;color:var(--bear);background:var(--bear-soft);border-radius:9px;padding:8px 11px;line-height:1.45}
    .reco-rats{display:flex;flex-wrap:wrap;gap:6px}
    .rchip{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:8px;background:var(--bg);border:1px solid var(--grid);color:var(--text)}
    html[data-theme="dark"] .rchip{background:var(--grid)}
    .rchip i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:middle}
    .rchip i.bull{background:var(--bull)} .rchip i.bear{background:var(--bear)} .rchip i.neutral{background:var(--neutral)}
    /* FORWARD-RETURN CONES */
    .cone-sub{color:var(--muted);font-size:12.5px;line-height:1.55;margin:8px 0 2px}
    .cone-legend{display:flex;flex-wrap:wrap;gap:16px;font-size:11px;color:var(--muted);margin:10px 0 12px}
    .cone-legend i{display:inline-block;vertical-align:middle;margin-right:6px}
    .cl-med{width:9px;height:9px;border-radius:50%;background:var(--muted);border:2px solid var(--card)}
    .cl-box{width:18px;height:9px;border-radius:3px;background:color-mix(in srgb,var(--muted) 30%,var(--card));border:1px solid var(--grid)}
    .cl-wh{width:18px;height:2px;background:color-mix(in srgb,var(--muted) 45%,var(--grid))}
    .cone-head{display:flex;align-items:center;gap:12px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);padding-bottom:4px;border-bottom:1px solid var(--grid)}
    .cone-head .ch-bar{flex:1}
    .cone-head .ch-s{width:84px;flex:none;text-align:right}
    .cone-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--grid)}
    .cone-row:first-of-type{border-top:none}
    .cone-h{width:34px;font-size:13px;font-weight:800;color:var(--ink);flex:none}
    .cone-bar{position:relative;flex:1;height:22px}
    .cone-axis{position:absolute;top:50%;left:0;right:0;height:2px;background:var(--grid);transform:translateY(-50%)}
    .cone-zero{position:absolute;top:1px;bottom:1px;width:1px;background:var(--muted);opacity:.6}
    .cone-whisk{position:absolute;top:50%;height:2px;transform:translateY(-50%);border-radius:2px}
    .cone-box{position:absolute;top:50%;height:13px;transform:translateY(-50%);border-radius:4px;opacity:.9}
    .cone-box.bull{background:color-mix(in srgb,var(--bull) 60%,var(--card))} .cone-whisk.bull{background:color-mix(in srgb,var(--bull) 38%,var(--grid))}
    .cone-box.bear{background:color-mix(in srgb,var(--bear) 55%,var(--card))} .cone-whisk.bear{background:color-mix(in srgb,var(--bear) 38%,var(--grid))}
    .cone-box.flat{background:color-mix(in srgb,var(--muted) 30%,var(--card))} .cone-whisk.flat{background:color-mix(in srgb,var(--muted) 36%,var(--grid))}
    .cone-med{position:absolute;top:50%;width:11px;height:11px;margin-left:-5.5px;transform:translateY(-50%);border-radius:50%;border:2px solid var(--card);box-shadow:0 0 0 1px var(--grid)}
    .cone-med.bull{background:var(--bull)} .cone-med.bear{background:var(--bear)} .cone-med.flat{background:var(--muted)}
    .cone-stat{width:84px;flex:none;text-align:right;font-size:10.5px;color:var(--faint);line-height:1.3}
    .cone-stat b{display:block;font-size:14px;font-weight:800;color:var(--ink)}
    .cone-stat b.bull{color:var(--bull)} .cone-stat b.bear{color:var(--bear)}
    /* collapsed section fold */
    details.sec-fold{margin-top:18px}
    details.sec-fold>summary{cursor:pointer;list-style:none;display:flex;align-items:baseline;gap:10px;
      font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;
      padding:10px 4px;border-radius:8px;user-select:none}
    details.sec-fold>summary::-webkit-details-marker{display:none}
    details.sec-fold>summary::before{content:"▸";font-size:11px;transition:transform .15s;color:var(--muted)}
    details.sec-fold[open]>summary::before{transform:rotate(90deg)}
    details.sec-fold>summary:hover{color:var(--ink)}
    details.sec-fold>summary .hint{font-weight:600;text-transform:none;letter-spacing:0;font-size:12px;color:var(--faint, var(--muted))}
    /* compact strip absorbed from old market-state hero */
    .cmd-mini{display:flex;flex-wrap:wrap;gap:10px 20px;margin-top:12px;padding-top:11px;border-top:1px solid var(--grid);align-items:flex-start}
    .cmd-mini-col{display:flex;flex-direction:column;gap:3px}
    .cmd-mini-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);margin-bottom:2px}
    .cmd-mini-chip{font-size:11.5px;font-weight:600;color:var(--muted)}
    .cmd-mini-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px;vertical-align:middle}
  </style>
  {% set tone_col = {'bull':'var(--blue)','bear':'var(--r3)','neutral':'var(--muted)'} %}
  {% set mcol = tone_col.get(master.tone,'var(--muted)') %}
  <div class="section-title" style="margin-top:6px"><span class="st-lab">⌖ {{ t("Today's read · Bitcoin", '今日判断 · 比特币') }}</span></div>
  <div class="cmd" style="--hero:{{ mcol }}">
    <div>
      <div class="cmd-h">{{ t('Big-picture backdrop', '大背景') }}</div>
      <div class="mg-wrap">
        <svg viewBox="0 0 280 150" width="280" height="150" aria-hidden="true">
          <defs><linearGradient id="mgarc" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--r3)"/><stop offset="42%" stop-color="var(--muted)"/>
            <stop offset="58%" stop-color="var(--muted)"/><stop offset="100%" stop-color="var(--blue)"/>
          </linearGradient></defs>
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="var(--grid)" stroke-width="16" stroke-linecap="round"/>
          <!-- §4 glow layer under arc -->
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="url(#mgarc)" stroke-width="15" stroke-linecap="round" opacity=".25" style="filter:blur(6px)"/>
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="url(#mgarc)" stroke-width="15" stroke-linecap="round" opacity="1"/>
          <line x1="140" y1="20" x2="140" y2="34" stroke="var(--card)" stroke-width="3"/>
        </svg>
        <div class="mg-needle" style="--mg-rot:{{ (master.gauge - 50) * 1.8 }}deg;background:{{ mcol }}"></div>
        <div class="mg-hub" style="background:{{ mcol }}"></div>
        <div class="mg-score" style="color:{{ mcol }}">{{ '%+d'|format(master.score) }}</div>
      </div>
      <div class="mg-ends"><span>{{ t('Bearish','偏空') }}</span><span>{{ t('Bullish','偏多') }}</span></div>
      <div class="mg-band" style="color:{{ mcol }}">{{ t(master.band, master.band_zh) }}</div>
      <div class="mg-tally"><b class="bu">{{ master.n_bull }}</b> {{ t('signals up','项看多') }} · <b class="be">{{ master.n_bear }}</b> {{ t('down','项看空') }} {{ t('(of','（共') }} {{ master.n_axes }} {{ t('tracked)','维）') }}</div>
    </div>
    <div>
      <div class="cmd-r-top">
        {# live.js patches the price + 24h change in place from the same-origin live snapshot
           (site/live/quotes.json, refreshed hourly 24/7 by the btc-live Action) — .nb-px / .nb-chg
           carry the canonical Yahoo symbol; the baked values below are the fallback until JS runs.
           Both live nodes hold ONLY the number: live.js overwrites textContent, so the "24h" label stays outside. #}
        <span class="live-dot" aria-hidden="true"></span><span class="cmd-price nb-px" data-sym="BTC-USD" data-mkt="crypto">{{ price|money }}</span>
        <span style="font-weight:700"><span class="nb-chg {{ 'up' if chg24>=0 else 'down' }}" data-sym="BTC-USD" data-mkt="crypto">{{ '%+0.2f'|format(chg24) }}%</span> {{ t('24h','24小时') }}</span>
        {% set cs_c = {'ACCUMULATE':'var(--blue)','RISK-ON':'var(--blue)','DISTRIBUTE':'var(--r3)','RISK-OFF':'var(--r3)','NEUTRAL':'var(--muted)'} %}
        {% set cs_en = {'ACCUMULATE':'Buy carefully','RISK-ON':'Stay long','DISTRIBUTE':'Start trimming','RISK-OFF':'Reduce or stand aside','NEUTRAL':'Hold and watch'} %}
        {% set cs_z = {'ACCUMULATE':'谨慎买入','RISK-ON':'保持多仓','DISTRIBUTE':'开始减仓','RISK-OFF':'减仓或观望','NEUTRAL':'持仓观察'} %}
        <span class="cmd-stance" style="color:{{ cs_c.get(composite_state,'var(--muted)') }}">{{ t(cs_en.get(composite_state, composite_state), cs_z.get(composite_state, composite_state)) }}</span>
        {% if composite_context == 'crowded_short' %}<span class="tip" data-tip-en="Many traders are short — this can mark a turning point. Background context only." data-tip-zh="大量空头持仓 — 可能接近拐点。仅供参考。" style="font-size:11.5px;font-weight:600;color:var(--blue);border:1px solid var(--blue);border-radius:999px;padding:1px 9px">⚠ {{ t('Many traders are short · could mark a turning point', '大量空头持仓 · 可能接近拐点') }}</span>{% elif composite_context == 'froth' %}<span class="tip" data-tip-en="Many traders are long — this can mark an overheated top. Background context only." data-tip-zh="大量多头持仓 — 可能接近过热顶部。仅供参考。" style="font-size:11.5px;font-weight:600;color:var(--r3);border:1px solid var(--r3);border-radius:999px;padding:1px 9px">🔥 {{ t('Overheated · too many traders long', '过热 · 多头持仓拥挤') }}</span>{% endif %}
        {% if verdict and verdict.grade %}{% set vg = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
        <span style="font-size:11px;font-weight:800;color:#fff;background:{{ vg.get(verdict.grade,'var(--muted)') }};padding:3px 9px;border-radius:7px">{{ t(verdict.grade, verdict.grade_zh) }}</span>{% endif %}
      </div>
      <div class="cmd-head">{{ t(master.headline_en, master.headline_zh) }}</div>
      <div class="cmd-drv">
        <div class="col"><div class="ch">▲ {{ t('Supporting a buy / hold','支持买入/持有') }}</div>
          {% for d in master.drivers_pos %}<div class="drvchip"><i class="bull"></i><b>{{ t(d.label_en, d.label_zh) }}</b> <span>· {{ t(d.state_en, d.state_zh) }}</span></div>{% else %}<div class="drvchip"><span>{{ t('none meaningful','无明显') }}</span></div>{% endfor %}
        </div>
        <div class="col"><div class="ch">▼ {{ t('Urging caution','提示谨慎') }}</div>
          {% for d in master.drivers_neg %}<div class="drvchip"><i class="bear"></i><b>{{ t(d.label_en, d.label_zh) }}</b> <span>· {{ t(d.state_en, d.state_zh) }}</span></div>{% else %}<div class="drvchip"><span>{{ t('none meaningful','无明显') }}</span></div>{% endfor %}
        </div>
      </div>
      <div class="cmd-act">
        <div class="a"><div class="k">{{ t('Risk level (0–100)','风险程度（0–100）') }}</div><div class="v" style="color:{{ 'var(--blue)' if risk_on else 'var(--r3)' }}">{{ risk_index }}</div><div class="h">{{ td(risk_label) }}</div></div>
        {% if env and env.risk and env.risk.tail is not none %}<div class="a"><div class="k">{{ t('Expected dip (next 7 days)','预期回撤（未来 7 天）') }}</div><div class="v" style="color:var(--r3)">{{ env.risk.avg }}%</div><div class="h">{{ t('worst','极端') }} {{ env.risk.tail }}%</div></div>{% else %}<div class="a"><div class="k">{{ t('Momentum','动量') }}</div><div class="v">{{ momentum }}</div><div class="h">{{ td(momentum_state) }}</div></div>{% endif %}
        <div class="a"><div class="k">{{ t('Model allocation','模型仓位') }}</div><div class="v" style="color:{{ 'var(--blue)' if alloc_pct>=50 else 'var(--r3)' }}">{{ alloc_pct }}%</div><div class="h">{% if gate.active %}{{ t('timing model','择时模型') }}{% elif sizing %}{{ t('Suggested size · ','建议仓位 · ') }}{{ sizing.size_pct }}%{% else %}BTC{% endif %}</div></div>
      </div>
      {# -- compact strip absorbed from old Market State hero -- #}
      <div class="cmd-mini">
        {# trend-by-timeframe dots #}
        {% if verdict and verdict.headline %}
        {% set tfc2 = {'up':'var(--blue)','down':'var(--r3)','flat':'var(--muted)'} %}
        {% set tlab2 = {'D':'D','3D':'3D','W':'W','2W':'2W','ME':'M'} %}
        <div class="cmd-mini-col">
          <div class="cmd-mini-label">{{ t('Trend by timeframe','各周期趋势') }}</div>
          <div style="font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:4px">{{ t(verdict.headline, verdict.headline_zh) }}</div>
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
            {% for r in mtf_rows %}
            <span style="display:inline-flex;align-items:center;gap:3px;font-size:11px;color:var(--muted)"><i style="width:8px;height:8px;border-radius:50%;background:{{ tfc2.get(r.trend,'var(--muted)') }}"></i>{{ tlab2.get(r.key, r.key) }}</span>
            {% endfor %}
            <span class="faint" style="font-size:10px"> · {{ t('short','短') }} {{ '↑' if verdict.short_sign>0 else ('↓' if verdict.short_sign<0 else '→') }} · {{ t('mid','中') }} {{ '↑' if verdict.mid_sign>0 else ('↓' if verdict.mid_sign<0 else '→') }} · {{ t('long','长') }} {{ '↑' if verdict.long_sign>0 else ('↓' if verdict.long_sign<0 else '→') }}</span>
          </div>
        </div>
        {% endif %}
        {# cycle stage slider compact #}
        <div class="cmd-mini-col">
          <div class="cmd-mini-label">{{ t('Cycle stage','周期阶段') }}</div>
          {% set stage_en = {'Defensive':'Defensive (hold cash)','Fragile':'Fragile (watch)','Recovery':'Recovery (buy dips)','Expansion':'Expansion (stay long)'} %}
          {% set stage_zh = {'Defensive':'防御（持现）','Fragile':'脆弱（观望）','Recovery':'修复（逢低买）','Expansion':'扩张（持多）'} %}
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            {% for s in ['Defensive','Fragile','Recovery','Expansion'] %}
            <span style="font-size:11.5px;font-weight:{{ '800' if s==cycle_stage else '500' }};color:{{ 'var(--ink)' if s==cycle_stage else 'var(--faint)' }}">{{ t(stage_en.get(s,s), stage_zh.get(s,s)) if s==cycle_stage else td(s) }}</span>
            {% endfor %}
          </div>
        </div>
        {# vol + flow chips #}
        <div class="cmd-mini-col">
          <div class="cmd-mini-label">{{ t('Vol · Flow','波动 · 流量') }}</div>
          <div style="display:flex;gap:8px;align-items:center">
            <span class="cmd-mini-chip">{{ t('Vol','波动') }}: <b>{{ td(vol_state) }}</b>{% if vol_side %} · {{ td(vol_side) }}{% endif %}</span>
            <span class="cmd-mini-chip">{{ t('Flow','流量') }}: <b>{{ td(flow_state) }}</b></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  {# ---------------- THE RECOMMENDATION (the actionable decision) ---------------- #}
  {# Fix #34 + W3: suppress the recommendation card during a blackout. Both pages read
     rec.suppressed_by_blackout, stamped in build_vector.py from the ONE gate_state()
     object (engine.btc_signals) — no per-template re-derivation, so the guard cannot
     drift between pages. #}
  {% if rec and rec.ok and not rec.suppressed_by_blackout %}
  {% set rt = rec.tone %}
  {% set L = rec.levels %}
  <div class="reco">
    <div class="reco-l t-{{ rt }}">
      <div class="reco-k">▶ {{ t('What to do','操作建议') }}</div>
      <div class="reco-act t-{{ rt }}">{{ t(rec.action, rec.action_zh) }}</div>
      <div class="reco-meta">
        {% set conv_en = {'HIGH':'HIGH confidence','MODERATE':'MODERATE confidence','LOW':'LOW confidence'} %}
        {% set conv_zh = {'HIGH':'较高把握','MODERATE':'中等把握','LOW':'把握不足'} %}
        <span class="reco-conv {{ rt }} conv-{{ rec.conviction|lower }}">{{ t(conv_en.get(rec.conviction, rec.conviction ~ ' confidence'), conv_zh.get(rec.conviction, rec.conviction)) }}</span>
        <span>· {{ t(rec.basis_en, rec.basis_zh) }}</span>
        <span>· {{ t(rec.horizon_en, rec.horizon_zh) }}</span>
      </div>
      {% if rec.directional %}<div class="reco-meta" style="margin-top:8px;color:var(--bull)"><b>{{ t('Directional call — measured at this extreme','方向性判断 — 该极值经实测') }}</b></div>
      {% else %}<div class="reco-meta" style="margin-top:8px">{{ t('Direction is uncertain — this position size is about limiting losses, not predicting price.','方向不确定 — 此仓位是为了控制亏损，不是预测价格。') }}</div>{% endif %}
      <div class="reco-rats" style="margin-top:12px">
        {% for d in rec.rationale %}<span class="rchip"><i class="{{ d.tone }}"></i>{{ t(d.label_en, d.label_zh) }} · {{ t(d.state_en, d.state_zh) }}</span>{% endfor %}
      </div>
    </div>
    <div class="reco-r">
      <div>
        <div class="reco-k">{{ t('Target BTC exposure','目标 BTC 仓位') }}</div>
        <div class="reco-exp-band">{{ rec.exposure_lo }}–{{ rec.exposure_hi }}%</div>
        <div class="exp-track">
          <div class="exp-fill {{ 't-bear' if rt=='bear' else '' }}" style="left:{{ rec.exposure_lo }}%;width:{{ rec.exposure_hi - rec.exposure_lo }}%"></div>
          {% if rec.kelly_pct is not none %}<div class="exp-kelly" style="left:{{ rec.kelly_pct }}%" data-tip-en="Model size marker" data-tip-zh="模型建议仓位标记"></div>{% endif %}
        </div>
        <div class="exp-scale"><span>0% {{ t('cash','现金') }}</span><span>{{ t('Model size marker','模型建议仓位标记') }} {{ rec.kelly_pct }}%</span><span>100% {{ t('BTC','BTC') }}</span></div>
      </div>
      <div class="reco-lvls">
        {% if L.accumulate_lo and L.accumulate_hi %}<div class="lv"><span class="k">{{ t('Accumulate zone','累积区间') }}</span><b>${{ '{:,}'.format(L.accumulate_lo) }}–${{ '{:,}'.format(L.accumulate_hi) }}</b></div>{% endif %}
        {% if L.invalidation %}<div class="lv"><span class="k">{{ t(L.invalid_label_en, L.invalid_label_zh) }}</span><b>${{ '{:,}'.format(L.invalidation) }}</b></div>{% endif %}
        {% if L.downside_90 and L.upside_90 %}<div class="lv" style="grid-column:1/3"><span class="k">{{ t('Where BTC typically lands in 90 days (middle 50% of past outcomes)','BTC 90 天后的常见区间（历史中间 50% 的结果）') }}</span><b class="down">${{ '{:,}'.format(L.downside_90) }}</b> → <b class="up">${{ '{:,}'.format(L.upside_90) }}</b></div>{% endif %}
      </div>
      {% if rec.key_risk_en %}<div class="reco-risk">⚠ {{ t(rec.key_risk_en, rec.key_risk_zh) }}</div>{% endif %}
    </div>
  </div>
  {% endif %}

  {# ---------------- MACRO-REGIME SCORECARD · five-tier composite (DISPLAY-ONLY) [collapsed] ---------------- #}
  {% if regime and regime.ok %}
  {% set rtone = {'bull':'var(--bull)','bull-soft':'var(--blue)','neutral':'var(--muted)','bear-soft':'var(--amber)','bear':'var(--r3)'} %}
  {% set rcol = rtone.get(regime.band_tone, 'var(--muted)') %}
  {% set fl = regime.flags %}
  <style>
  .rgc-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:16px}
  @media(max-width:760px){.rgc-grid{grid-template-columns:1fr}}
  .rgc-meter{height:12px;border-radius:7px;background:linear-gradient(90deg,var(--r3),var(--amber) 38%,var(--muted) 50%,var(--blue) 64%,var(--bull));position:relative;margin:10px 0 4px}
  .rgc-mk{position:absolute;top:-4px;width:4px;height:20px;border-radius:2px;background:var(--ink);box-shadow:0 0 0 2px var(--card)}
  .rgc-tier{display:grid;grid-template-columns:96px 1fr 42px;align-items:center;gap:10px;margin:7px 0;font-size:12.5px}
  .rgc-bar{height:9px;border-radius:5px;background:var(--hair);position:relative;overflow:hidden}
  .rgc-bar > i{position:absolute;top:0;height:100%;border-radius:5px}
  .rgc-fac{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;border:1px solid var(--hair);font-size:11.5px;margin:3px 4px 3px 0}
  .rgc-org{font-size:9px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;font-weight:700}
  .rgc-flag{border:1px solid var(--hair);border-radius:10px;padding:10px 12px;font-size:12px}
  .rgc-cond{display:flex;align-items:center;gap:6px;margin:3px 0;font-size:11.5px}
  .rgc-dot{width:7px;height:7px;border-radius:50%;flex:none}
  </style>
  <details class="sec-fold" id="macro-regime-scorecard">
  <summary>🧭 {{ t('Macro backdrop · advanced', '宏观背景 · 进阶') }} <span class="hint">{{ t('Five market dimensions · context only, does not drive position size', '五个市场维度 · 仅供参考，不决定仓位') }}</span></summary>
  <div class="card" style="padding:18px 22px">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div style="display:flex;align-items:baseline;gap:12px">
        <div style="font-size:30px;font-weight:800;color:{{ rcol }};font-variant-numeric:tabular-nums">{{ regime.index|round|int }}</div>
        <div>
          <div style="font-weight:700;color:{{ rcol }}">{{ t(regime.band, regime.band_zh) }}{% if regime.thin %} · <span class="faint">{{ t('thin','数据稀疏') }}</span>{% endif %}</div>
          <div class="faint" style="font-size:11.5px">{{ t('0 = very unfavourable backdrop · 100 = very favourable backdrop','0 = 背景很不利 · 100 = 背景非常有利') }}</div>
        </div>
      </div>
      <div style="text-align:right">
        <span class="chip" style="border-color:{{ rcol }};color:{{ rcol }}">{{ t('Context only — does not set position size','仅供参考 — 不决定仓位大小') }}</span>
        {% if regime.mode_lean and regime.mode_lean.ok %}<div class="faint" style="font-size:11.5px;margin-top:5px">{{ t('mode','模式') }}: <b style="color:var(--ink)">{{ td(regime.mode_lean.chip) }}</b></div>{% endif %}
      </div>
    </div>
    <div class="rgc-meter"><div class="rgc-mk" style="left:calc({{ regime.index }}% - 2px)"></div></div>
    <div class="faint" style="font-size:11.5px">{{ t('Reference level (not what to hold):','参考水位（非实际持仓）：') }} <b style="color:var(--ink)">{{ (regime.exposure_display*100)|round|int }}%</b> · {{ regime.n_live }} {{ t('factors active','项有效') }}</div>

    <div class="rgc-grid" style="margin-top:14px">
      {# ---- per-tier sub-scores ---- #}
      <div>
        <div class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px">{{ t('What feeds the score','分数构成') }}</div>
        {% for tr_ in regime.tiers %}
        {% set nv = tr_.norm if tr_.norm is not none else 0 %}
        {% set tcol = 'var(--bull)' if nv > 0.05 else ('var(--r3)' if nv < -0.05 else 'var(--muted)') %}
        {% set wpct = (nv*50)|abs|round|int %}
        <div class="rgc-tier">
          <span>{{ tr_.tier }} <span class="faint">{{ t(tr_.label, tr_.label) }}</span></span>
          <span class="rgc-bar"><i style="background:{{ tcol }};{{ 'left' if nv>=0 else 'right' }}:50%;width:{{ wpct }}%"></i><i style="left:50%;width:1px;background:var(--muted);opacity:.4"></i></span>
          <span style="text-align:right;color:{{ tcol }};font-variant-numeric:tabular-nums">{{ '%+0.0f'|format(tr_.sub) }}</span>
        </div>
        {% endfor %}
        <div style="margin-top:10px">
          {% for f in regime.factors %}
          {% set fc = 'var(--bull)' if (f.score or 0) > 0 else ('var(--r3)' if (f.score or 0) < 0 else 'var(--muted)') %}
          <span class="rgc-fac" style="{{ 'opacity:.45' if not f.present else '' }}">
            <b style="color:{{ fc }};font-variant-numeric:tabular-nums">{{ ('%+d'|format(f.score)) if f.present else '–' }}</b>
            {{ t(f.label, f.label) }}
            {% set _org_map = {'APRIORI':['pre-set','预设'],'MEASURED':['measured','实测'],'CONTEXT':['context','背景']} %}
            <span class="rgc-org">{{ t(_org_map.get(f.origin, [f.origin, f.origin])[0], _org_map.get(f.origin, [f.origin, f.origin])[1]) }}</span>
          </span>
          {% endfor %}
        </div>
      </div>

      {# ---- confluence tail flags ---- #}
      <div>
        <div class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px">{{ t('Extreme signal cluster','极端信号集群') }}</div>
        <div style="font-size:12.5px;margin-bottom:8px">
          {% if fl and fl.ok %}
          {% if fl.active == 'STAY-AWAY' %}<b style="color:var(--r3)">🔴 {{ t('Stay away','回避') }}</b>
          {% elif fl.active == 'DOUBLE-DOWN' %}<b style="color:var(--bull)">🟢 {{ t('Double down','加倍') }}</b>
          {% else %}<b class="faint">{{ t('No extreme cluster active','无极端集群触发') }}</b>{% endif %}
          <span class="faint">· {{ fl.stay_away.count }}/{{ fl.stay_away.n_available }} {{ t('extreme conditions firing','项极端条件触发') }}{{ qmark('Fires when 4, 5, or 6 conditions align simultaneously. Count is illustrative across ~5 historical cycles.','当 4、5 或 6 项条件同时触发时激活。计数在约 5 个历史周期中仅供参考。') }}</span>
          {% endif %}
        </div>
        {% if fl and fl.ok %}
        <div class="rgc-flag" style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between"><b style="color:var(--r3)">{{ t('Stay away','回避') }}</b><span style="font-variant-numeric:tabular-nums">{{ fl.stay_away.count }}/{{ fl.stay_away.n_available }}</span></div>
          {% for c in fl.stay_away.conditions %}<div class="rgc-cond"><span class="rgc-dot" style="background:{{ 'var(--r3)' if c.fired else 'var(--hair)' }}"></span>{{ t(c.label, c.label) }}{% if c.prov %} <span class="faint" style="font-size:10px">({{ t('shared','共享') }})</span>{% endif %}</div>{% endfor %}
        </div>
        <div class="rgc-flag">
          <div style="display:flex;justify-content:space-between"><b style="color:var(--bull)">{{ t('Double down','加倍') }}</b><span style="font-variant-numeric:tabular-nums">{{ fl.double_down.count }}/{{ fl.double_down.n_available }} · {{ t('Required condition:','前提条件：') }} {{ '✓ ' ~ t('met','已满足') if fl.double_down.prereq_ok else '✗ ' ~ t('not met','未满足') }}</span></div>
          {% for c in fl.double_down.conditions %}<div class="rgc-cond"><span class="rgc-dot" style="background:{{ 'var(--bull)' if c.fired else 'var(--hair)' }}"></span>{{ t(c.label, c.label) }}</div>{% endfor %}
          {% if fl.double_down.override %}<div class="faint" style="font-size:11px;margin-top:4px">⛔ {{ t('suppressed by trend filter (Override #1)','受趋势过滤抑制（覆盖规则 #1）') }}</div>{% endif %}
        </div>
        {% if fl.onchain_panel and fl.onchain_panel.ok %}
        <div class="faint" style="font-size:11.5px;margin-top:8px">{{ t('On-chain reads:','链上读数：') }}
          {% if fl.onchain_panel.depressed_co_flash %}<b style="color:var(--bull)">{{ t('cheap','偏便宜') }}</b>
          {% elif fl.onchain_panel.stretched_co_flash %}<b style="color:var(--r3)">{{ t('expensive','偏贵') }}</b>
          {% else %}<b>{{ t('mixed','混合') }}</b>{% endif %}
          {{ qmark('On-chain signal count: ' ~ fl.onchain_panel.n_depressed ~ ' cheap / ' ~ fl.onchain_panel.n_stretched ~ ' expensive of ' ~ fl.onchain_panel.n ~ ' tracked. Based on rolling percentiles across multiple on-chain metrics.','链上信号计数：共 ' ~ fl.onchain_panel.n ~ ' 项，其中 ' ~ fl.onchain_panel.n_depressed ~ ' 项偏便宜 / ' ~ fl.onchain_panel.n_stretched ~ ' 项偏贵。基于多项链上指标的滚动分位。') }}
        </div>
        {% endif %}
        {% endif %}
      </div>
    </div>
    {% set cl = regime.context_legs %}
    {% if cl %}
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">
      {% set _imp_d = {'contracting':['Contracting','收缩'],'expanding-accelerating':['Expanding (accelerating)','扩张（加速）'],'expanding-decelerating':['Expanding (slowing)','扩张（减速）'],'unknown':['Unknown','未知']} %}
      {% if cl.netliq and cl.netliq.ok %}<span class="rgc-fac">🌊 {{ t('Net-liquidity','净流动性') }}: <b>{{ t(_imp_d.get(cl.netliq.impulse_state,_imp_d.get('unknown'))[0], _imp_d.get(cl.netliq.impulse_state,_imp_d.get('unknown'))[1]) }}</b></span>{% endif %}
      {% set _rsk_d = {'low':['Low','低'],'elevated':['Elevated','偏高'],'high':['High','高']} %}
      {% if cl.leverage and cl.leverage.ok %}
      {% set lev_col = {'high':'var(--red)','elevated':'var(--warn)'} %}
      {% set _lc = lev_col.get(cl.leverage.cascade_risk,'') %}
      {% set _oi_gated = cl.leverage.reliability and cl.leverage.reliability.oi_only_risk and cl.leverage.reliability.oi_only_risk.gated_out %}
      <span class="rgc-fac" style="{% if _lc %}border-color:{{ _lc }};color:{{ _lc }}{% endif %}">⚡ {{ t('Leverage','杠杆') }}: <b>{{ t(_rsk_d.get(cl.leverage.cascade_risk,[cl.leverage.cascade_risk,cl.leverage.cascade_risk])[0], _rsk_d.get(cl.leverage.cascade_risk,[cl.leverage.cascade_risk,cl.leverage.cascade_risk])[1]) }}</b>{% if cl.leverage.cascade_risk=='low' and cl.leverage.oi_only_risk and cl.leverage.oi_only_risk != 'low' %} · <span class="muted" data-tip-en="Positioning context only." data-tip-zh="仅为持仓背景。">{{ t('OI crowding','持仓拥挤') }} {{ t(_rsk_d.get(cl.leverage.oi_only_risk,[cl.leverage.oi_only_risk,cl.leverage.oi_only_risk])[0], _rsk_d.get(cl.leverage.oi_only_risk,[cl.leverage.oi_only_risk,cl.leverage.oi_only_risk])[1]) }}{% if _oi_gated %} ({{ t('context','参考') }}){% endif %}</span>{% endif %}{% if cl.leverage.derisk_cap %} · {{ t('cap','上限') }} {{ (cl.leverage.derisk_cap*100)|round|int }}%{% endif %}</span>
      {% endif %}
      {% set _dat_d = {'premium':['Premium','溢价'],'discount':['Discount','折价'],'par':['Par','平价'],'deep_discount':['Deep discount','深度折价']} %}
      {% if cl.dat and cl.dat.ok and cl.dat.mnav is not none %}<span class="rgc-fac" style="{{ 'border-color:var(--r3)' if cl.dat.state=='discount' else '' }}">🏛 {{ t('MSTR mNAV','MSTR mNAV') }}: <b>{{ '%.2f'|format(cl.dat.mnav) }}×</b> {{ t(_dat_d.get(cl.dat.state,[cl.dat.state,cl.dat.state])[0], _dat_d.get(cl.dat.state,[cl.dat.state,cl.dat.state])[1]) }}</span>{% endif %}
      {% if cl.etf_perfund and cl.etf_perfund.ok and cl.etf_perfund.ibit_share is not none %}<span class="rgc-fac">📊 IBIT {{ (cl.etf_perfund.ibit_share*100)|round|int }}%</span>{% endif %}
    </div>
    {% endif %}
    {% if regime.ledger and regime.ledger.honesty_note %}<div class="sub faint" style="margin-top:12px;font-size:11.5px">{{ t('Fixed weights.', '固定权重。') }} {{ qmark('Forward tracking: ' ~ regime.ledger.honesty_note, '前瞻跟踪：' ~ (regime.ledger.honesty_note_zh or regime.ledger.honesty_note)) }}</div>{% else %}<div class="sub faint" style="margin-top:12px;font-size:11.5px">{{ t('Fixed weights.', '固定权重。') }}</div>{% endif %}
  </div>
  </details>
  {% endif %}

  {# ---------------- BTC ALLOCATION + CONES · cols-2 row ---------------- #}
  {# ALLOCATION CARD (moved up from old Market State grid) #}
  {# gcol/gcolor must be set here as convcard uses them later #}
  {% set gcol = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
  {% set gcolor = gcol.get(verdict.grade,'var(--muted)') %}
  <div class="grid cols-2" style="margin-top:18px">
    <!-- allocation -->
    <div class="card">
      <h2>{{ t('BTC Allocation · Optimal strategy', 'BTC 仓位 · 最优策略') }}</h2>
      {% if gate.active %}
      <div style="margin:2px 0 12px;padding:11px 13px;border:1px solid var(--amber);border-radius:11px;background:color-mix(in srgb, var(--amber) 9%, transparent)">
        <div style="font-weight:700;font-size:13.5px;color:var(--amber)">⏳ {{ t('Staying out · timing model says avoid BTC for now', '回避中 · 择时模型建议暂时回避 BTC') }}</div>
        <div class="sub" style="margin-top:5px;font-size:12.5px">{{ t('Our timing model says avoid BTC until around','择时模型建议在') }} <b>{{ gate.release or '—' }}</b>{{ t('. Allocation is set to 0%.', ' 前回避 BTC，仓位设为 0%。') }}</div>
      </div>
      {% endif %}
      <div class="allocbar">
        {% if alloc_pct > 0 %}<div class="btc" style="width:{{ alloc_pct }}%">{{ alloc_pct }}% BTC</div>{% endif %}
        {% if alloc_pct < 100 %}<div class="cash" style="width:{{ 100-alloc_pct }}%">{{ 100-alloc_pct }}% {{ t('Cash', '现金') }}</div>{% endif %}
      </div>
      <div class="sub" style="margin-top:10px">{{ t('Mode:', '模式：') }}
        {% set mode_en = {'Strategic':'Long-term (Strategic)','Tactical':'Short-term (Tactical)'} %}
        {% set mode_zh = {'Strategic':'长期（战略）','Tactical':'短期（战术）'} %}
        <span class="chip {{ 'chip-strategic' if market_mode=='Strategic' else 'chip-tactical' }}">{{ t(mode_en.get(market_mode, market_mode), mode_zh.get(market_mode, market_mode)) }}</span>
        · {{ t('Leading now:', '当前领涨：') }} <b>{{ td(alt_leader) }}</b></div>
      {% if sizing and not gate.active %}
      <div class="mini" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:11px"><div class="lab" style="border:none;padding-top:0"><span>{{ t('Suggested size after risk caps','按风险上限后的建议仓位') }}{{ qmark('How we size: a model edge of ' ~ ('%+0.0f'|format(sizing.edge_90)) ~ '%/90d in the current regime (volatility ' ~ sizing.vol_90~ '%) gives a full Kelly size, then we apply a half-Kelly fraction and cap by a ' ~ sizing.dd_budget ~ '% drawdown budget' ~ (', further limited by the ' ~ sizing.tail_90 ~ '% worst-case scenario.' if sizing.binding=='tail' else '.'), '如何计算仓位：当前格局中模型 ' ~ ('%+0.0f'|format(sizing.edge_90)) ~ '%/90d 的优势，结合波动率 ' ~ sizing.vol_90 ~ '%，得出满仓 Kelly，再乘以半 Kelly 系数，并以 ' ~ sizing.dd_budget ~ '% 回撤预算封顶' ~ ('，进一步受限于 ' ~ sizing.tail_90 ~ '% 极端情形。' if sizing.binding=='tail' else '。')) }}</span><span><b style="font-size:17px;color:{{ 'var(--blue)' if sizing.size_pct>=40 else 'var(--r3)' }}">{{ sizing.size_pct }}%</b></span></div></div>
      {% endif %}
      {% if alloc_sizing and not gate.active %}
      <div class="mini" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:11px"><div class="lab" style="border:none;padding-top:0"><span>{{ t('Crash-buying feature','抄底功能') }}{{ qmark('Activates only at deep sell-offs (washout lows). Historically added +15.6% returns at similar risk levels.','仅在深度抛售（洗盘低点）时启动。历史上在同等风险下额外贡献 +15.6%。') }}</span><span><b style="font-size:16px;color:{{ 'var(--blue)' if alloc_sizing.bottom_active else 'var(--muted)' }}">{% if alloc_sizing.bottom_active %}{{ t('Active · adding','激活 · 加仓') }} +{{ alloc_sizing.bottom_add }}%{% else %}{{ t('Not active','未激活') }}{% endif %}</b></span></div></div>
      {% if alloc_sizing.bottom_active %}<div class="sub faint" style="margin-top:4px;font-size:12px">{{ t('Deep sell-off detected — buying in at lower prices.','检测到深度抛售 — 以更低价格买入。') }}</div>{% endif %}
      {% endif %}
      {% if catalyst %}
      <div class="sub" style="margin-top:8px;font-size:12px;color:{{ 'var(--amber)' if catalyst.imminent else 'var(--muted)' }}">{% if catalyst.imminent %}⚠ {% endif %}{{ t('Upcoming event:','即将到来：') }} <b>{{ td(catalyst.next_event) }}</b> {{ t('in','还有') }} {{ catalyst.days }} {{ t('day' if catalyst.days==1 else 'days','天') }} ({{ catalyst.next_date }}){% if catalyst.imminent %} — {{ t('Expect bigger price swings around it. Don\'t add size right before.','届时波动可能加大，不宜在此前加仓。') }}{% endif %}</div>
      {% endif %}
      <a href="vector_allocation.html" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px;padding:11px 14px;border:1px solid var(--grid);border-radius:11px;background:var(--bg);text-decoration:none;color:var(--ink);font-weight:600;font-size:13.5px">
        <span>◎ {{ t('Full allocation strategy — BTC · ETH · alts · cash', '完整仓位策略 — BTC · ETH · 山寨 · 现金') }}</span>
        <span style="color:var(--blue);font-size:16px">→</span>
      </a>
    </div>
    {# -- CONES CARD (moved here from old location after macro-regime scorecard) -- #}
    {% if cones and cones.ok and cones.horizons %}
    {% set ch = cones.horizons %}
    {% set cvals = [] %}
    {% for k in ['7d','30d','90d'] %}{% set _h = ch.get(k) %}{% if _h and _h.p95 is not none and _h.p5 is not none %}{% set _ = cvals.append(_h.p95|abs) %}{% set _ = cvals.append(_h.p5|abs) %}{% endif %}{% endfor %}
    {% set cscale = (cvals|max) if cvals else 50 %}
    {% macro cpct(v) %}{{ [[(50 + 50*v/cscale), 2]|max, 98]|min }}{% endmacro %}
    {% set degraded = [] %}
    {% for k in ['7d','30d','90d'] %}{% set _h = ch.get(k) %}{% if _h and (_h.thin or (_h.cond and _h.cond != cones.regime)) %}{% set _ = degraded.append(k) %}{% endif %}{% endfor %}
    <div class="card" style="padding:18px 22px">
      <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <h3 style="margin:0">{{ t('What BTC did next · on days like today','类似今日的历史日 · BTC 后续走势') }}</h3>
        {% set _cone_reg_en = {'ACCUMULATE':'Accumulation days','DISTRIBUTE':'Distribution days','RISK-ON':'Risk-on days','RISK-OFF':'Risk-off days','NEUTRAL':'Neutral days'} %}
        {% set _cone_reg_zh = {'ACCUMULATE':'吸筹日','DISTRIBUTE':'派发日','RISK-ON':'风险偏好日','RISK-OFF':'风险规避日','NEUTRAL':'中性日'} %}
        <span class="faint" style="font-size:12px">{{ t('matched to','匹配') }} <b style="color:var(--ink)">{{ t(_cone_reg_en.get(cones.regime, cones.regime or 'all history'), _cone_reg_zh.get(cones.regime, cones.regime or '全历史')) }}</b></span>
      </div>
      <div class="cone-sub">{{ t('History, not a forecast.','是历史，不是预测。') }}</div>
      <div class="cone-legend">
        <span><i class="cl-wh"></i>{{ t('rare','罕见') }}</span>
        <span><i class="cl-box"></i>{{ t('typical','常见') }}</span>
        <span><i class="cl-med"></i>{{ t('midpoint','中间值') }}</span>
        {{ qmark('Outer whiskers show the 5th–95th percentile range (rare outcomes). The shaded box is the middle 50% of past results. The dot is the median. Full percentile labels are for context only.','外侧须线为 5–95 百分位（罕见结果）。阴影框为过去结果的中间 50%。圆点为中位数。百分位标注仅供参考。') }}
      </div>
      <div class="cone-head">
        <span class="cone-h"></span>
        <span class="ch-bar">{{ t('What happened next','后续走势') }}</span>
        <span class="ch-s">{{ t('Most likely result','最可能结果') }}</span>
        <span class="ch-s">{{ t('Chance of being higher','收高概率') }}</span>
      </div>
      {% for k in ['7d','30d','90d'] %}{% set h = ch.get(k) %}{% if h and h.p50 is not none %}
        {% set edge = ((h.p_up - h.base_up) * 100) if (h.p_up is not none and h.base_up is not none) else 0 %}
        {% set tilt = 'flat' if (h.thin or edge|abs < 5) else ('bull' if edge >= 5 else 'bear') %}
        {% set edgecol = 'var(--muted)' if tilt == 'flat' else ('var(--bull)' if tilt == 'bull' else 'var(--bear)') %}
        <div class="cone-row" {% if h.thin %}style="opacity:.62"{% endif %}>
          <span class="cone-h">{{ k }}</span>
          <div class="cone-bar">
            <div class="cone-axis"></div>
            <div class="cone-zero" style="left:{{ cpct(0) }}%"></div>
            <div class="cone-whisk {{ tilt }}" style="left:{{ cpct(h.p5) }}%;width:{{ cpct(h.p95)|float - cpct(h.p5)|float }}%"></div>
            <div class="cone-box {{ tilt }}" style="left:{{ cpct(h.p25) }}%;width:{{ cpct(h.p75)|float - cpct(h.p25)|float }}%"></div>
            <div class="cone-med {{ tilt }}" style="left:{{ cpct(h.p50) }}%"></div>
          </div>
          <div class="cone-stat">
            <b class="{{ tilt }}">{{ '%+.1f'|format(h.p50) }}%</b>
            {{ '%+.0f'|format(h.p25) }}…{{ '%+.0f'|format(h.p75) }}%
          </div>
          <div class="cone-stat">
            <b style="color:{{ edgecol }}">{{ (h.p_up*100)|round|int }}%</b>
            {{ t('vs history','对比历史') }} {{ (h.base_up*100)|round|int }}%
          </div>
        </div>
      {% endif %}{% endfor %}
      <div class="exp-scale" style="margin-top:6px"><span>−{{ cscale|round|int }}%</span><span>0</span><span>+{{ cscale|round|int }}%</span></div>
      <div class="sub faint" style="margin-top:10px;font-size:11.5px">
        {{ t('Small gaps between "chance of being higher" and the history baseline mean no direction edge — don\'t read more into them.','若"收高概率"与历史基准差距小，表示无方向优势，不要过度解读。') }}
        {{ qmark('Midpoint = median. "Chance of being higher" = how often BTC closed above its current price by that date. History is matched to the current market regime when enough data exists.' ~ (' Limited regime-matched history for ' ~ degraded|join(' · ') ~ ' — using a wider sample.' if degraded else ''), '中间值 = 中位数。"收高概率" = BTC 在该日期之前收高于当前价格的频率。当数据足够时，历史与当前市场格局匹配。' ~ ('格局匹配样本不足（' ~ degraded|join('、') ~ '），已采用更宽样本。' if degraded else '')) }}
      </div>
    </div>
    {% else %}
    <div></div>
    {% endif %}
  </div>

  <!-- ===================== SIGNAL BOARD ===================== -->
  <div class="section-title"><span class="st-lab">{{ t('Signal Board · every axis at a glance', '信号面板 · 一览全维度') }}</span></div>
  <div class="board">
    {% for grp in master.board %}
    <div class="bgrp">
      <h4>{{ t(grp.group_en, grp.group_zh) }}</h4>
      {% set grade_en = {'CONFIRMED':'Proven','DIRECTIONAL':'Directional','EXTREMES':'At extremes','CONTEXT':'Context','NEW':'New','INVERTED':'Contrarian'} %}
      {% set grade_zh = {'CONFIRMED':'已证实','DIRECTIONAL':'方向信号','EXTREMES':'极值有效','CONTEXT':'仅背景','NEW':'早期数据','INVERTED':'逆向'} %}
      {% for r in grp.rows %}
      <div class="brow">
        <span class="dot {{ r.tone }}"></span>
        <span class="lab">{{ t(r.label_en, r.label_zh) }}</span>
        {% if r.grade %}<span class="gr gr-{{ r.grade }}">{{ t(grade_en.get(r.grade, r.grade), grade_zh.get(r.grade, r.grade)) }}</span>{% else %}<span></span>{% endif %}
        <span class="st">{{ t(r.state_en, r.state_zh) }}</span>
        {% if r.spark %}<svg class="spk {{ r.tone }}" viewBox="0 0 100 26" preserveAspectRatio="none"><polyline points="{{ r.spark }}" pathLength="100"/></svg>{% else %}<span></span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="sub faint" style="margin:8px 4px 4px;font-size:12px">{{ t('Track record: Proven · Suggestive · Too early to tell', '历史记录：已证实 · 仅参考 · 历史尚短') }}</div>
  {% endif %}

  <!-- ===================== IMPULSE RADAR (forward pressure) ===================== -->
  {% set ir = regime.context_legs.impulse_radar if regime.context_legs else none %}
  {% if ir and ir.ok %}
  {% set lad_col = {'quiet':'var(--muted)','coiled':'var(--blue)','warning':'var(--warn)','trigger':'var(--red)'} %}
  {% set lad_lab = {'quiet':'Calm','coiled':'Building','warning':'Alert','trigger':'Act'} %}
  {% set lad_zh = {'quiet':'平静','coiled':'蓄势','warning':'警告','trigger':'触发'} %}
  <div class="card" id="impulse" style="margin-bottom:18px">
    <h2>{{ t('Impulse Radar · forward pressure','脉冲雷达 · 前瞻压力') }}</h2>
    <div class="sub" style="margin-top:2px">{{ t('Early warning tracker — shows whether pressure is building or fading. Watch; don\'t act on background readings alone.','早期预警追踪 — 显示压力是否正在积累或消退。观察即可，仅凭背景读数不宜行动。') }}</div>
    {% if ir.staleness and ir.staleness.stale %}
    <div style="margin-top:10px;padding:8px 12px;border-radius:8px;background:var(--bear-soft);border:1px solid var(--bear);color:var(--bear);font-weight:600;font-size:12.5px">⚠ {{ t('Intraday data STALE — freshest hourly candle','日内数据过期 — 最新小时K线') }} {{ ir.staleness.intraday_asof }} ({{ t('daily close','日线收盘') }} {{ ir.staleness.daily_asof }}). {{ t('An intraday flush could go unseen — check the hourly feed.','日内闪跌可能无法被捕捉 — 请检查小时数据源。') }}</div>
    {% endif %}
    <div class="grid cols-2" style="margin-top:12px">
      {% for g in [ir.down, ir.up] %}
      {% set gnm = 'Down' if loop.first else 'Up' %}{% set gnm_zh = '下行' if loop.first else '上行' %}
      <div style="border:1px solid var(--grid);border-radius:12px;padding:13px 15px;background:var(--bg)">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <b style="font-size:13px;color:var(--ink)">{{ t(gnm,gnm_zh) }}-{{ t('impulse','脉冲') }}</b>
          <span style="font-weight:800;font-size:11.5px;padding:2px 9px;border-radius:7px;color:#fff;background:{{ lad_col.get(g.ladder,'var(--muted)') }}">{{ t(lad_lab.get(g.ladder,g.ladder), lad_zh.get(g.ladder,g.ladder)) }}</span>
        </div>
        <div style="margin-top:9px;height:9px;border-radius:6px;background:var(--grid);overflow:hidden"><div style="height:100%;width:{{ g.score }}%;background:{{ lad_col.get(g.ladder,'var(--muted)') }}"></div></div>
        <div class="faint" style="font-size:11px;margin-top:4px">{{ t('Pressure','压力') }} {{ g.score }}/100{% if not g.act_live %} · {{ t('no action threshold crossed','未触发行动级别') }}{% endif %}</div>
        <div style="margin-top:9px;display:flex;flex-direction:column;gap:3px">
          {% for l in g.legs if l.points > 0 %}
          <div style="display:flex;justify-content:space-between;font-size:11.5px">
            <span style="color:{{ 'var(--ink)' if l.tier=='act' else 'var(--muted)' }}">{{ '●' if l.tier=='act' else '○' }} {{ t(l.label, l.label) }} <span class="faint" style="font-size:10.5px">({{ t('Action signal','行动信号') if l.tier=='act' else t('Background signal','背景信号') }})</span></span>
            <span class="faint">{% if l.fired_today %}{{ t('today','今日') }}{% elif l.days_since is not none %}{{ l.days_since }} {{ t('days ago','天前') }}{% endif %}{{ qmark('Score contribution: ' ~ l.points ~ ' points.', '积分贡献：' ~ l.points ~ ' 分。') }}</span>
          </div>
          {% else %}
          <div class="faint" style="font-size:11px">{{ t('no live legs','无活跃因子') }}</div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px">
      {% if ir.fuel_gauge %}<span class="rgc-fac" style="{{ 'border-color:var(--warn);color:var(--warn)' if ir.fuel_gauge.lit else '' }}">🔋 {{ t('Fuel','燃料') }}{{ qmark('How much potential exists for a sharp move. Open interest percentile: ' ~ ((ir.fuel_gauge.oi_pctile*100)|round|int if ir.fuel_gauge.oi_pctile is not none else '—') ~ '%. Volatility instability percentile: ' ~ ((ir.fuel_gauge.vov_pctile*100)|round|int if ir.fuel_gauge.vov_pctile is not none else '—') ~ '%.','剧烈波动的潜力。持仓规模百分位：' ~ ((ir.fuel_gauge.oi_pctile*100)|round|int if ir.fuel_gauge.oi_pctile is not none else '—') ~ '%。波动不稳定度百分位：' ~ ((ir.fuel_gauge.vov_pctile*100)|round|int if ir.fuel_gauge.vov_pctile is not none else '—') ~ '%。') }}: {% if ir.fuel_gauge.lit %}{{ t('loaded','已蓄能') }}{% else %}{{ t('normal','正常') }}{% endif %}</span>{% endif %}
      {% if ir.cascade and ir.cascade.oi_only_risk and ir.cascade.oi_only_risk != 'low' %}{% set _oi_gated = ir.cascade.reliability and ir.cascade.reliability.oi_only_risk and ir.cascade.reliability.oi_only_risk.gated_out %}{% set _rsk_d2 = {'low':['Low','低'],'elevated':['Elevated','偏高'],'high':['High','高']} %}<span class="rgc-fac muted" data-tip-en="Positioning pressure only; not a de-risk signal by itself." data-tip-zh="仅为持仓背景；本身不是减仓信号。">⚡ {{ t('Positioning pressure','持仓拥挤度') }}: <b>{{ t(_rsk_d2.get(ir.cascade.oi_only_risk,[ir.cascade.oi_only_risk,ir.cascade.oi_only_risk])[0], _rsk_d2.get(ir.cascade.oi_only_risk,[ir.cascade.oi_only_risk,ir.cascade.oi_only_risk])[1]) }}</b> · {{ t('background only','仅背景') }}</span>{% endif %}
    </div>
    {% set cv = regime.context_legs.intraday_cvd if regime.context_legs else none %}
    {% if cv and cv.ok %}
    {% set cvcol = {'distribution':'var(--bear)','accumulation':'var(--blue)','neutral':'var(--muted)'} %}
    <div class="sub faint" style="margin-top:8px;font-size:11px;border-top:1px solid var(--grid);padding-top:8px">🌊 {{ t('Intraday buy–sell pressure','日内买卖压力') }}: {% if cv.stale %}<b style="color:var(--bear)">⚠ {{ t('stale','过期') }}{% if cv.hours_behind_ref is not none %} ({{ cv.hours_behind_ref|round|int }}h)</b>{% else %}</b>{% endif %}{% else %}<b style="color:{{ cvcol.get(cv.flow_state,'var(--muted)') }}">{{ td(cv.flow_state) }}</b>{% if cv.net_flow_24h_mn is not none %} · {{ '%+0.0f'|format(cv.net_flow_24h_mn) }}M{% endif %}{% if cv.divergence and cv.divergence.state != 'none' %} · <b style="color:var(--bear)">{{ td(cv.divergence.state) }}</b>{% endif %}{% if cv.accruing %} · <span class="faint">{{ t('context','背景') }}</span>{% endif %}{% endif %}</div>
    {% endif %}
    <div class="sub faint" style="margin-top:10px;font-size:11px">{{ t('Read this as early pressure, not a top or bottom call.', '把它当作早期压力读数，不是顶部或底部预言。') }}</div>
    {% set _act = (ir.down.legs + ir.up.legs) | selectattr('tier','equalto','act') | list %}
    {% set _dem = _act | selectattr('demoted') | list %}
    {% if _dem %}<div class="sub faint" style="margin-top:5px;font-size:11px">{{ qmark('Quality check: ' ~ (_act|length - _dem|length) ~ ' of ' ~ _act|length ~ ' action-tier signals still confirmed. ' ~ _dem|length ~ ' have been demoted (their follow-through did not hold).', '质量检查：' ~ _act|length ~ ' 项行动级信号中 ' ~ (_act|length - _dem|length) ~ ' 项仍有效，' ~ _dem|length ~ ' 项已降级（后续未能持续）。') }} <b style="color:var(--bear)">{{ _dem|length }} {{ t('signal(s) lost follow-through','个信号未能持续') }}</b></div>{% endif %}
  </div>
  {% endif %}

  {# ---- conviction card macro (shared by mid & short so they are byte-identical "same format") ---- #}
  {% macro convcard(c, R, title_en, title_zh, vsign, grade, grade_zh, gcolor) %}
    {% set dword = 'bull' if c.dir>0 else 'bear' %}
    {% set dottint = 'var(--muted)' if (c.state=='TOSS-UP' or c.lean<=3) else ('var(--blue)' if (c.state=='EDGE' and c.dir>0) else ('var(--r3)' if (c.state=='EDGE' and c.dir<0) else ('color-mix(in srgb,var(--blue) 58%,var(--grid))' if c.dir>0 else 'color-mix(in srgb,var(--r3) 60%,var(--grid))'))) %}
    <div class="conv-head">
      <span style="font-size:14px;font-weight:700;color:var(--ink)">{{ t(title_en, title_zh) }}</span>
      {% if R and R.tail is not none %}{% set _qen = ('Based on ' ~ '{:,}'.format(R.n) ~ ' past cases in similar conditions.') if R.n > 30 else ('Limited history (' ~ '{:,}'.format(R.n) ~ ' cases) — treat with caution.') %}{% set _qzh = ('基于类似条件下 ' ~ '{:,}'.format(R.n) ~ ' 个历史案例。') if R.n > 30 else ('历史有限（' ~ '{:,}'.format(R.n) ~ ' 个案例）— 谨慎参考。') %}{% set _qen2 = _qen ~ (' — ' ~ R.guard_en if R.guard_en else '') %}{% set _qzh2 = _qzh ~ (' — ' ~ R.guard_zh if R.guard_zh else '') %}<span class="conv-n">{{ qmark(_qen2, _qzh2) }}</span>{% elif c.n %}<span class="conv-n">{{ qmark('Based on ' ~ '{:,}'.format(c.n) ~ ' past cases.', '基于 ' ~ '{:,}'.format(c.n) ~ ' 个历史案例。') }}</span>{% endif %}
    </div>
    {% if R and R.tail is not none %}
    {# ---------- PRIMARY: forward drawdown / risk (the CONFIRMED quantity) ---------- #}
    {% set rwc = {'CALM':'var(--muted)','ELEVATED':'var(--r3)','HIGH':'color-mix(in srgb,var(--r3) 80%,var(--ink))','EXTREME':'color-mix(in srgb,var(--r3) 80%,var(--ink))'} %}
    <div class="risk-word" style="color:{{ rwc.get(R.word_en,'var(--r3)') }}">{{ t(R.head_en, R.head_zh) }}
      {%- if R.contrarian %} <span class="conv-tag" data-tip-en="Selling pressure this high often marks a bottom." data-tip-zh="抛售压力如此之高，历史上往往接近底部。">{{ t('often marks a bottom','往往接近底部') }}</span>{% endif %}
      {%- if R.thin %} <span class="conv-tag">{{ t('limited history','历史有限') }}</span>{% endif %}
    </div>
    <div class="risk-nums">{{ t('Typical dip:','常见回撤：') }} <b>{{ R.avg }}%</b> · {{ t('Worst case:','极端情形：') }} <b{% if R.thin %} class="faint"{% endif %}>{{ R.tail }}%</b> <span class="faint">· {{ t('In quiet markets:','平静市场下：') }} {{ R.calm_avg }}% / {{ R.calm_tail }}%</span></div>
    {% set scale = (1.25 * ([(R.tail|abs),(R.calm_tail|abs)]|max)) %}
    {% set scale = scale if scale > 0 else 20 %}
    <div class="ddrail">
      <div class="ddrail-bar">
        <div class="dd-down" style="left:0;width:70%"></div>
        <div class="dd-up" style="left:70%;width:30%"></div>
        <div class="dd-mk dd-calm" style="left:{{ (70 - 70*(R.calm_tail|abs)/scale)|round(1) }}%" title="calm baseline"></div>
        <div class="dd-mk dd-typ" style="left:{{ (70 - 70*(R.avg|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-tail{% if R.thin %} thin{% endif %}" style="left:{{ (70 - 70*(R.tail|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-uptick" style="left:{{ (70 + 30*R.up/scale)|round(1) }}%"></div>
        <div class="dd-now" style="left:70%"></div>
      </div>
      <div class="ddrail-lab"><span class="r3b">{{ R.tail }}%</span><span class="mut">{{ R.avg }}%</span><span class="now">{{ t('now','当前') }}</span><span class="upf">+{{ R.up }}%</span></div>
    </div>
    {# ---------- SECONDARY: demoted direction strip (the honest coin-flip) ---------- #}
    <div class="dir-strip">
      <span class="dir-chip">{% if c.state=='TOSS-UP' %}{{ t('Direction unclear','方向不明') }}{% elif c.state=='LEAN' %}{{ t('Slight tilt ' ~ dword, '轻微偏' ~ ('多' if c.dir>0 else '空')) }}{% else %}{{ t('Meaningful tilt ' ~ dword, '明显偏' ~ ('多' if c.dir>0 else '空')) }}{% endif %}</span>
      <div class="mini-needle"><div class="mn-dead"></div><div class="mn-tick"></div><div class="mn-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <span class="dir-num">{{ c.p_bull }}% {{ t('up','偏多') }} / {{ c.p_bear }}% {{ t('down','偏空') }}</span>{{ qmark('Direction is uncertain. Pay more attention to how much you could lose than to which way it goes.','方向不明确。比起方向，更应关注可能损失多少。') }}
    </div>
    <div class="conv-why">{{ t(R.main_en, R.main_zh) }}</div>
    {% else %}
    {# ---------- fallback: conviction-led (no calibrated risk) ---------- #}
    {% set wcls = 'cw-toss' if c.state=='TOSS-UP' else (('cw-lean ' if c.state=='LEAN' else 'cw-edge ') ~ dword) %}
    <div class="cw {{ wcls }}">{% if c.state=='TOSS-UP' %}{{ t('Direction unclear','方向不明') }}{% elif c.state=='LEAN' %}{{ t('Slight tilt ' ~ dword, '轻微偏' ~ ('多' if c.dir>0 else '空')) }}{% else %}{{ t('Meaningful tilt ' ~ dword, '明显偏' ~ ('多' if c.dir>0 else '空')) }}{% endif %}</div>
    <div class="needle"><div class="needle-axis"><div class="needle-dead"></div><div class="needle-tick"></div><div class="needle-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <div class="needle-ends"><span>{{ t('Down','偏空') }}</span><span class="needle-num">{{ c.p_bull }}% {{ t('up','偏多') }} / {{ c.p_bear }}% {{ t('down','偏空') }}</span><span>{{ t('Up','偏多') }}</span></div></div>
    <div class="conv-why">{{ t(c.why_en, c.why_zh) }}</div>
    {% endif %}
    <div class="conv-defer" style="color:{{ gcolor }}">↳ {{ t('Sits under the overall','从属于整体') }} <b>{{ t(grade, grade_zh) }}</b> {{ t('view — think of this as the near-term detail','判断 — 视为近期细节') }}</div>
  {% endmacro %}

