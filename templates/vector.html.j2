  <div class="grid cols-2">
    <div class="card">
      {% set bkt = breadth.bucket %}
      {% set bk_color = {'Alt season':'var(--blue)','BTC season':'var(--amber)','Mixed':'var(--muted)'} %}
      {% set bk_zh = {'Alt season':'山寨季','BTC season':'BTC 季','Mixed':'混合'} %}
      <h3>{{ t('Breadth regime', '广度状态') }}
        <b style="color:{{ bk_color.get(bkt,'var(--muted)') }}"> · {{ t(bkt, bk_zh.get(bkt, bkt)) }}</b>
        {% if breadth.score is not none %}<span class="faint" style="font-size:13px"> ({{ breadth.score|int }}/100)</span>{% endif %}</h3>
      {% if breadth.score is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Alt-season score (ETH/BTC + dominance)','山寨季评分（ETH/BTC + 占比）') }}</span><span><b>{{ breadth.score|int }}/100</b> <span class="faint">{{ t('0 = BTC-only · 100 = broad','0 = 仅 BTC · 100 = 广泛') }}</span></span></div>
        <div class="bar"><div class="fill" style="width:{{ breadth.score|int }}%"></div></div></div>{% endif %}
      {% if breadth.ethbtc is not none %}
      {% set es_color = {'alt':'var(--blue)','btc':'var(--amber)','mixed':'var(--muted)'} %}
