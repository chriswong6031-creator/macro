        <thead><tr style="color:var(--muted)"><th style="text-align:left;padding:4px 8px">{{ t('Issuer','发行人') }}</th><th style="text-align:right;padding:4px 8px">{{ t('5-day ($m)','5 日（百万）') }}</th><th style="text-align:right;padding:4px 8px">{{ t('Since launch ($m)','上线以来（百万）') }}</th></tr></thead>
        <tbody>
