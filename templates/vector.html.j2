           "Buy / add":"买入 / 加仓","Sell / trim":"卖出 / 减仓",
           "5-day net flow":"5 日净流入","Net flow (BTC)":"净流入（BTC）",
           "Network Growth":"网络增长","Liquidity":"流动性","Momentum":"动量",
           "Structure Shift":"结构转变","Price $":"价格 $","Risk":"风险","Alloc":"仓位"}
};
</script>
