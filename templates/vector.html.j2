      <div class="s"><div class="k">{{ t('Return per unit of risk', '风险调整后收益') }}</div><div class="v" data-m="sharpe">{{ cards.optimal.sharpe }}</div><div class="h">{{ t('Buy-and-hold', '买入持有') }} {{ cards.optimal.hodl_sharpe }}</div></div>
      <div class="s"><div class="k">{{ t('Worst peak-to-trough drop', '最大回撤') }}</div><div class="v" data-m="maxdd">{{ cards.optimal.maxdd }}%</div><div class="h">{{ t('Buy-and-hold', '买入持有') }} {{ cards.optimal.hodl_maxdd }}%</div></div>
