  {# Cycle & Valuation section above now contains the merged cycle clock + positioning cards #}

  <!-- ===================== MASTERMIND FACTORS (new) ===================== -->
  {% if newf %}
  <details class="sec-fold" id="mastermind-factors">
  <summary>{{ t('Advanced factors · miners, beta, holders, attention, flow', '高阶因子 · 矿工·贝塔·持有者·关注度·主动盘') }}</summary>
  <div class="grid cols-2">
    <!-- Miner economics (deep 2010-> margin anchor) -->
    <div class="card">
      {% set ms = newf.miner.state %}
      {% set ms_c = {'capitulation':'var(--blue)','stress':'var(--amber)','healthy':'var(--muted)','euphoria':'var(--r3)'} %}
      {% set ms_z = {'capitulation':'投降（筑底）','stress':'承压','healthy':'健康','euphoria':'亢奋'} %}
      <h3>{{ t('Miner economics · hashprice', '矿工经济 · 哈希价格') }}
        {% if ms %}<b style="color:{{ ms_c.get(ms,'var(--muted)') }}"> · {{ t(ms|upper, ms_z.get(ms,'—')) }}</b>{% endif %}
        <span class="verdict v-conf" style="font-size:10px;vertical-align:middle">{{ t('deep 2010→','深度 2010→') }}</span></h3>
      {% if newf.miner.hashprice_pctile is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Miner profit margin (vs history)','矿工利润率（vs 历史）') }}{{ qmark('Hashprice percentile: ' ~ newf.miner.hashprice_pctile ~ '% (z ' ~ ('%+0.1f'|format(newf.miner.hashprice_z) if newf.miner.hashprice_z is not none else '—') ~ '). Low = squeezed margins, often marks cycle bottoms.','哈希价格百分位：' ~ newf.miner.hashprice_pctile ~ '%（z ' ~ ('%+0.1f'|format(newf.miner.hashprice_z) if newf.miner.hashprice_z is not none else '—') ~ '）。低 = 利润被压缩，往往对应周期底部。') }}</span><span><b style="color:{{ 'var(--blue)' if newf.miner.hashprice_pctile<20 else ('var(--r3)' if newf.miner.hashprice_pctile>85 else 'var(--ink)') }}">{{ newf.miner.hashprice_pctile }}%</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ newf.miner.hashprice_pctile }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Miner stress','矿工压力') }}</span><span><b>{{ newf.miner.stress if newf.miner.stress is not none else '—' }}/100</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Recent hashrate change (14d)','近期算力变化（14 天）') }}</span><span><b style="color:{{ 'var(--r3)' if (newf.miner.hashrate_shock is not none and newf.miner.hashrate_shock<-8) else 'var(--ink)' }}">{{ '%+0.1f'|format(newf.miner.hashrate_shock) if newf.miner.hashrate_shock is not none else '—' }}%</b>{% if newf.miner.difficulty_shock is not none %} <span class="faint">/ diff {{ '%+0.1f'|format(newf.miner.difficulty_shock) }}%</span>{% endif %}</span></div></div>
      <div class="sub" style="margin-top:10px">{{ t('Low miner margins historically mark cycle bottoms.','矿工利润低历史上对应周期底部。') }}{{ qmark("Hashprice = USD revenue per unit of hashrate = the miner's profit margin (Puell/MPI pick up downstream). Deep history (2010→) makes it a real cycle-bottom anchor. A sharp hashrate drop is a forced-shutdown trigger.",'哈希价格 = 每单位算力的美元收入 = 矿工利润率。深度历史（2010 起）使其成为真正的周期底部锚点。算力骤降则是被迫关机的触发。') }}</div>
    </div>
    <!-- Conditional downside/upside beta -->
    <div class="card">
      {% set br = newf.cbeta.regime %}
      {% set br_c = {'drawdown_amplifier':'var(--r3)','diversifier':'var(--blue)','mixed':'var(--muted)'} %}
      {% set br_l = {'drawdown_amplifier':['DRAWDOWN AMPLIFIER','回撤放大器'],'diversifier':['DIVERSIFIER','分散器'],'mixed':['MIXED','混合']} %}
      <h3>{{ t('Conditional beta · NDX downside vs upside', '条件贝塔 · 纳指下行 vs 上行') }}
        {% if br %}<b style="color:{{ br_c.get(br,'var(--muted)') }}"> · {{ t(br_l.get(br,['—'])[0], br_l.get(br,['—','—'])[1]) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Downside beta (on NDX down-days)','下行贝塔（纳指下跌日）') }}</span><span><b style="color:{{ 'var(--r3)' if (newf.cbeta.down_beta is not none and newf.cbeta.down_beta>0.8) else 'var(--ink)' }}">{{ newf.cbeta.down_beta if newf.cbeta.down_beta is not none else '—' }}</b>{% if newf.cbeta.down_beta_pctile is not none %} <span class="faint">({{ newf.cbeta.down_beta_pctile }}%ile)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Upside beta (on NDX up-days)','上行贝塔（纳指上涨日）') }}</span><span><b>{{ newf.cbeta.up_beta if newf.cbeta.up_beta is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Asymmetry (up − down)','不对称（上 − 下）') }}</span><span><b style="color:{{ 'var(--blue)' if (newf.cbeta.asym is not none and newf.cbeta.asym>=0) else 'var(--r3)' }}">{{ '%+0.2f'|format(newf.cbeta.asym) if newf.cbeta.asym is not none else '—' }}</b> <span class="faint">{{ t('(<0 = couples harder down)','（<0 = 下跌时耦合更强）') }}</span></span></div></div>
      {% if newf.cbeta.down_beta_gold is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Downside beta to gold','对黄金的下行贝塔') }}</span><span><b>{{ newf.cbeta.down_beta_gold }}</b></span></div></div>{% endif %}
      {% set _db = newf.cbeta.down_beta|string if newf.cbeta.down_beta is not none else '—' %}
      <div class="sub" style="margin-top:10px">{{ t('When stocks fall, Bitcoin falls harder (amplifier) or holds up better (diversifier). Downside risk:','股市下跌时，比特币跌得更多（放大器）或相对抗跌（分散器）。下行贝塔：') }} {{ _db }}× {{ t('Nasdaq.','纳指。') }}{{ qmark("BTC couples hard to risk assets on the way down and decouples on the way up — a single correlation hides this. Downside beta percentile: " ~ (newf.cbeta.down_beta_pctile|string if newf.cbeta.down_beta_pctile is not none else '—') ~ "%. Asymmetry (up−down): " ~ ('%+0.2f'|format(newf.cbeta.asym) if newf.cbeta.asym is not none else '—') ~ " (<0 = amplifier; ≥0 = diversifier). Computed from Yahoo closes.",'BTC 在下跌时与风险资产强耦合、上涨时脱钩。下行贝塔百分位：' ~ (newf.cbeta.down_beta_pctile|string if newf.cbeta.down_beta_pctile is not none else '—') ~ '%。不对称（上−下）：' ~ ('%+0.2f'|format(newf.cbeta.asym) if newf.cbeta.asym is not none else '—') ~ '（<0 = 放大；≥0 = 分散）。') }}</div>
    </div>
  </div>
  <div class="grid cols-3" style="margin-top:18px">
    <!-- Holder spread -->
    <div class="card">
      {% set hst = newf.holders.state %}
      {% set hst_c = {'accumulation':'var(--blue)','distribution':'var(--r3)','neutral':'var(--muted)'} %}
      {% set hst_z = {'accumulation':'累积','distribution':'派发','neutral':'中性'} %}
      <h3>{{ t('Holder spread', '持有者价差') }}
        {% if hst %}<b style="color:{{ hst_c.get(hst,'var(--muted)') }}"> · {{ t(hst|capitalize, hst_z.get(hst,'—')) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Recent buyers vs long-term holders: who is taking profit?','近期买家 vs 长期持有者：谁在获利了结？') }}{{ qmark('STH−LTH SOPR spread: ' ~ ('%+0.3f'|format(newf.holders.sopr_spread) if newf.holders.sopr_spread is not none else '—') ~ '. Positive = recent buyers spending more than long-term holders.','短期持有者 SOPR − 长期持有者 SOPR 价差：' ~ ('%+0.3f'|format(newf.holders.sopr_spread) if newf.holders.sopr_spread is not none else '—') ~ '。正值 = 近期买家花费多于长期持有者。') }}</span><span><b>{{ '%+0.3f'|format(newf.holders.sopr_spread) if newf.holders.sopr_spread is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('How much did recent buyers pay vs current price','近期买入成本与现价对比') }}</span><span><b>{{ '%+0.1f'|format(newf.holders.realized_premium) if newf.holders.realized_premium is not none else '—' }}%</b></span></div></div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Shows whether short-term holders are taking profit or accumulating. Context only.', '显示短期持有者是在获利了结还是累积。仅背景。') }}</div>
    </div>
    <!-- Attention -->
    <div class="card">
      {% set at = newf.attention.state %}
      {% set at_c = {'mania':'var(--r3)','apathy':'var(--blue)','normal':'var(--muted)'} %}
      {% set at_z = {'mania':'狂热','apathy':'冷清','normal':'正常'} %}
      <h3>{{ t('Attention · Wikipedia', '关注度 · 维基百科') }}
        {% if at %}<b style="color:{{ at_c.get(at,'var(--muted)') }}"> · {{ t(at|capitalize, at_z.get(at,'—')) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Pageviews (7d avg)','页面浏览（7天均）') }}</span><span><b>{{ '{:,}'.format(newf.attention.views|int) if newf.attention.views is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Interest level vs normal','关注度 vs 正常水平') }}</span><span><b style="color:{{ 'var(--r3)' if (newf.attention.z is not none and newf.attention.z>2) else ('var(--blue)' if (newf.attention.z is not none and newf.attention.z<-1) else 'var(--ink)') }}">{{ '%+0.1f'|format(newf.attention.z) if newf.attention.z is not none else '—' }}</b> <span class="faint">{{ t('(above +2 = mania, below −1 = ignored)','（超过 +2 = 狂热，低于 −1 = 无人关注）') }}</span></span></div></div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Attention predicts volatility, not direction. Extremes matter most.', '关注度预测波动，不预测方向。极值最重要。') }}</div>
    </div>
    <!-- Taker flow -->
    <div class="card">
      {% set tdv = newf.taker.divergence %}
      {% set tdv_c = {'bullish':'var(--blue)','bearish':'var(--r3)','aligned':'var(--muted)'} %}
      {% set tdv_z = {'bullish':'看多背离','bearish':'看空背离','aligned':'一致'} %}
      <h3>{{ t('Taker flow · buy/sell balance', '主动盘 · 买卖失衡') }}
        {% if tdv %}<b style="color:{{ tdv_c.get(tdv,'var(--muted)') }}"> · {{ t(tdv|capitalize, tdv_z.get(tdv,'—')) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Taker buy share','主动买盘占比') }}{{ qmark('z-score vs history: ' ~ ('%+0.1f'|format(newf.taker.z) if newf.taker.z is not none else '—') ~ '. Above 50% = more buyers than sellers.','与历史相比的 z 值：' ~ ('%+0.1f'|format(newf.taker.z) if newf.taker.z is not none else '—') ~ '。超过 50% = 买方多于卖方。') }}</span><span><b style="color:{{ 'var(--blue)' if (newf.taker.buy_share is not none and newf.taker.buy_share>=0.5) else 'var(--r3)' }}">{{ '%.0f'|format(100*newf.taker.buy_share) if newf.taker.buy_share is not none else '—' }}%</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('30-day buy/sell balance','30 天买卖失衡') }}</span><span><b>{{ '%+0.2f'|format(newf.taker.cvd) if newf.taker.cvd is not none else '—' }}</b> <span class="faint">{{ t('(positive = more buying pressure)','（正值 = 买盘更强）') }}</span></span></div></div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Shows who is driving trades. Background only — not a buy or sell signal.', '显示谁在主动推动交易。仅背景 — 不是买卖信号。') }}</div>
    </div>
  </div>
  </details>
  {% endif %}

  <!-- ===================== CROSS-ASSET MAP ===================== -->
  <div class="section-title"><span class="st-lab">{{ t('Markets at a glance · 3-day direction & signal strength', '市场一览 · 3 天方向与信号强度') }}</span></div>
  <div class="grid cols-3">
