      <span><span style="display:inline-block;width:14px;height:2px;background:var(--blue);vertical-align:3px;margin-right:5px"></span>{{ t('Strategy equity', '策略净值') }}</span>
      <span style="color:var(--bull);font-weight:600">▲ {{ t('buy / add', '买入 / 加仓') }}</span>
