  <!-- ===================== ALERT TIMELINE ===================== -->
  <div class="section-title" id="timeline"><span class="st-lab">{{ t('Alert Timeline · last', '警报时间线 · 最近') }} {{ timeline_days }} {{ t('days', '天') }}<span class="faint" style="font-weight:600;text-transform:none;letter-spacing:0"> · {{ n_alerts }} {{ t('alerts', '条警报') }}</span></span></div>
  <div class="card">
    <div class="tl-filters">
      {% set filter_zh = {'All':'全部','Flash Crash':'闪崩','Risk':'风险','Structure':'结构','Momentum':'动量','Other':'其他'} %}
      {% for f,lab in [('all','All'),('flash','Flash Crash'),('risk','Risk'),('structure','Structure'),('momentum','Momentum'),('other','Other')] %}
      <button class="tlf {{ 'active' if f=='all' else '' }}" data-f="{{ f }}">{{ t(lab, filter_zh[lab]) }}</button>{% endfor %}
    </div>
    {% if timeline %}
    <div class="timeline">
      {% for day in timeline %}
      <div class="tl-day">
        <div class="tl-date">{{ t(day.daylabel, day.daylabel_zh) }}</div>
        {% for e in day.events %}
        {% set _lab = e.label|replace('_',' ')|capitalize if '_' in e.label else e.label %}
        {% set _labz = e.label_zh if e.label_zh and e.label_zh != e.label else _lab %}
        <details class="tl-item sev-{{ e.severity }}" data-f="{{ e.filter }}">
          <summary>
            <span class="tl-node n-{{ e.type }} n-{{ e.severity }}"></span>
            <span class="tl-chip f-{{ e.filter }}">{{ t(_lab, _labz) }}</span>
            <span class="tl-head">{{ t(e.headline, e.headline_zh) }}</span>
            <span class="tl-time">{{ e.time }}</span>
          </summary>
          <div class="tl-detail">
            {{ t(e.detail, e.detail_zh) }}
            {% if e.edge %}<div class="tl-edge"><b>{{ t('Conviction:', '可信度：') }}</b> {{ t(e.edge, e.edge_zh) }}</div>{% endif %}
            {% if e.forward %}<div class="tl-fwd">{{ t(e.forward, e.forward_zh) }}</div>{% endif %}
            {% if e.anchor %}<a href="{{ e.anchor }}" class="tl-link">{{ t('View on dashboard →', '在仪表盘查看 →') }}</a>{% endif %}
          </div>
        </details>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="sub faint" style="padding:10px 0">{{ t('No alerts in the last', '最近') }} {{ timeline_days }} {{ t('days — markets quiet on every tracked signal.', '天无警报 — 所有跟踪信号均平静。') }}</div>
    {% endif %}
    <div class="sub faint" style="margin-top:14px">{{ t('Intraday alerts update during the day; regime and on-chain signals update daily. Built', '日内警报盘中更新；周期与链上信号每日更新。生成于') }} {{ built }}.</div>
  </div>

  <!-- ===================== CALIBRATION TRANSPARENCY ===================== -->
  <details class="sec-fold" id="calibration">
  <summary>{{ t('How much to trust this · measured records', '可信度如何 · 实测记录') }} <span class="hint">{{ t('Signal verdicts & ensemble test', '信号评定与集成检验') }}</span></summary>
  <div class="card">
    <h3>{{ t('Signal verdicts', '信号评定') }} <span class="faint" style="font-size:13px;font-weight:600">{{ calib.meta.span }}</span></h3>
    <table class="catbl">
      <tr><td class="a">{{ t('Signal', '信号') }}</td><td>{{ t('Verdict', '评定') }}</td><td class="a">{{ t('What\'s measured', '测量内容') }}</td></tr>
      {% for sig,e in calib.signals.items() %}
      <tr><td class="a">{{ td(sig) }}</td>
        <td><span class="verdict {{ 'v-conf' if 'CONFIRMED' in e.verdict else ('v-dir' if 'DIRECTIONAL' in e.verdict else 'v-ctx') }}">{{ td(e.verdict) }}</span></td>
        <td class="sub">{{ t('how well past readings predicted returns', '历史读数预测收益的效果') }}</td></tr>
      {% endfor %}
      {% if calib.risk_drawdown %}
      <tr><td class="a">{{ t('Risk Index (as risk signal)', '风险指数（风险信号）') }}</td>
        <td><span class="verdict {{ 'v-conf' if 'CONFIRMED' in calib.risk_drawdown.verdict else 'v-dir' }}">{{ td(calib.risk_drawdown.verdict) }}</span></td>
        <td class="sub">{{ t('how well past readings predicted 7-day dips', '历史读数预测 7 天回撤的效果') }}</td></tr>
      {% endif %}
    </table>
    <div class="sub" style="margin-top:12px">{{ t('We test each signal on how well past readings predicted future results. We only call a signal reliable if it worked in both the first and second half of history. Results below.', '我们检验每个信号是否能预测后续走势。只有在历史前后两半段均有效的信号才会被采用。') }}</div>
  </div>

  {% set ep = calib.ensemble_promotion %}
  {% if ep and ep.net_sharpe %}
  <div class="card" style="margin-top:18px">
    <h3>{{ t('Does blending signals beat our main strategy?', '信号组合能否超过主策略？') }}</h3>
    <div class="sub">{{ t('Six uncorrelated signals, tested after costs in both halves of history. Result: the hand-crafted strategy wins.', '六个独立信号扣除成本后在历史前后两段检验。结论：人工调优策略更优。') }}</div>
    <div class="sub" style="margin-top:8px;font-weight:700;color:var(--ink)">{{ td(ep.verdict) }}</div>
    <table class="catbl" style="margin-top:10px">
      <tr><td class="a">{{ t('Read','读数') }}</td><td>{{ t('Return per risk (full)','风险调整收益（全样本）') }}</td><td>{{ t('pre-2021','2021 前') }}</td><td>{{ t('post-2021','2021 后') }}</td></tr>
      {% set names = {'heuristic':['Our main strategy','主策略'],'ensemble_eqw':['Combined signals','信号组合'],'best_single':['Single best signal','单一最优信号']} %}
      {% for key in ['heuristic','ensemble_eqw','best_single'] %}{% set row = ep.net_sharpe[key] %}
      <tr><td class="a">{{ t(names[key][0], names[key][1]) }}{% if key=='best_single' %} <span class="faint">({{ ep.best_single }})</span>{% endif %}</td>
        <td><b>{{ row.full }}</b></td><td>{{ row.pre }}</td><td>{{ row.post }}</td></tr>
      {% endfor %}
    </table>
    <div class="sub faint" style="margin-top:10px;font-size:12px">{{ t('The ensemble beats any single signal, but not the shipped hand-tuned stance. So the stance stays.', '集成优于任何单一信号，但未超过当前采用的手调立场。因此保留现有立场。') }}</div>
  </div>
  {% endif %}
  </details>

  <div class="foot">
    Bitcoin Vector · {{ t('built', '生成于') }} {{ built }} · {{ t('data as of', '数据截至') }} {{ as_of }}<br>
    <span class="made">© 2026 Mastermind Inc</span>
  </div>
</div>
<script>
(function(){
  var fil=document.querySelectorAll('.tlf'), items=document.querySelectorAll('.tl-item');
  fil.forEach(function(b){b.addEventListener('click',function(){
    fil.forEach(function(x){x.classList.remove('active')}); b.classList.add('active');
    var f=b.dataset.f;
    items.forEach(function(it){ it.hidden=!(f==='all'||it.dataset.f===f); });
    document.querySelectorAll('.tl-day').forEach(function(d){
      var any=[...d.querySelectorAll('.tl-item')].some(function(i){return !i.hidden});
      d.style.display=any?'':'none';
    });
  });});
})();
</script>
<script>
/* Anchor-inside-details: open parent <details> when navigating to a hash target */
(function(){
  function openParentDetails(el){
    var p=el;
    while(p=p.parentElement){
      if(p.tagName==='DETAILS' && !p.open){ p.open=true; }
    }
  }
  function handleHash(){
    var h=location.hash; if(!h) return;
    var el=document.querySelector(h); if(!el) return;
    openParentDetails(el);
    setTimeout(function(){ el.scrollIntoView({behavior:'smooth',block:'start'}); },50);
  }
  document.addEventListener('DOMContentLoaded', handleHash);
  window.addEventListener('hashchange', handleHash);
})();
</script>
<script>
/* Vector charts keep their blue/red palette in zh mode — only axis titles + legend
   names translate. The CSS direction/risk colours DO invert in zh (red=up/green=down,
   see the html[data-lang="zh"] block), but the charts can't follow: most are single
   blue data-lines (inversion is meaningless) and chart_i18n only supports SYMMETRIC
   colour swaps, which can't express the blue->red / red->green remap (red is both a
   pole and a target). So charts stay descriptive blue/red. */
window.__CHART_SWAP__ = {
  colors: {},
  labels: {"BTC Price":"BTC 价格","Optimal strategy":"最优策略","Allocation":"仓位",
           "Buy / add":"买入 / 加仓","Sell / trim":"卖出 / 减仓",
           "5-day net flow":"5 日净流入","Net flow (BTC)":"净流入（BTC）",
           "Network Growth":"网络增长","Liquidity":"流动性","Momentum":"动量",
           "Structure Shift":"结构转变","Price $":"价格 $","Risk":"风险","Alloc":"仓位"}
};
</script>
<script>
/* §6 Grow bar fills on first reveal. Degrades to server-rendered widths (no-op) if IO is missing. */
(function(){
  if(matchMedia('(prefers-reduced-motion: reduce)').matches||!('IntersectionObserver'in window))return;
  var els=document.querySelectorAll('.mini .fill,.prob .fill,.exp-fill,.rgc-bar>i:first-child,.allocbar .btc');
  els.forEach(function(el){var w=el.style.width;if(!w)return;if(el.closest('details:not([open])'))return;el.dataset.w=w;el.style.width='0%';});
  var io=new IntersectionObserver(function(es){es.forEach(function(e){
    if(!e.isIntersecting)return;var el=e.target;io.unobserve(el);
    el.style.transition='width .9s cubic-bezier(.2,.7,.3,1)';
    setTimeout(function(){el.style.width=el.dataset.w;},40);});},{threshold:.4});
  els.forEach(function(el){if(el.dataset.w)io.observe(el);});
})();
</script>
