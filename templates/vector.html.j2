      <div class="s"><div class="k">{{ t('5-day net (USD)','5 日净流入（美元）') }}</div><div class="v" style="font-size:18px">{{ etf.usd_5d_str }}</div><div class="h">z {{ '%+0.2f'|format(etf.usd_z) if etf.usd_z is not none else '—' }}</div></div>
      <div class="s"><div class="k">{{ t('Net $ since launch','上线以来净流入') }}</div><div class="v" style="font-size:18px">{% if etf.usd_cum_bn is not none %}${{ etf.usd_cum_bn }}B{% else %}—{% endif %}</div><div class="h">{% if etf.exgbtc_cum_bn is not none %}{{ t('ex-GBTC','剔除 GBTC') }} ${{ etf.exgbtc_cum_bn }}B{% endif %}</div></div>
      <div class="s"><div class="k">{{ t('Issuer concentration','发行人集中度') }}</div><div class="v" style="font-size:18px">{% if etf.concentration is not none %}{{ etf.concentration }}%{% else %}—{% endif %}</div><div class="h">{{ t('top-fund share (21d)','头部基金占比（21天）') }}</div></div>
