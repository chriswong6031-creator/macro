    </div>
    {% else %}
    <div class="sub faint" style="padding:10px 0">{{ t('No alerts in the last', '最近') }} {{ timeline_days }} {{ t('days — markets quiet on every tracked signal.', '天无警报 — 所有跟踪信号均平静。') }}</div>
    {% endif %}
    <div class="sub faint" style="margin-top:14px">{{ t('Near-real-time: flash-crash & impulse update intraday (~15–45 min, price-only); on-chain & regime signals update daily. Built', '近实时：闪崩与脉冲信号日内更新（约 15–45 分钟，仅价格）；链上与周期信号每日更新。生成于') }} {{ built }}.</div>
  </div>

  <!-- ===================== CALIBRATION TRANSPARENCY ===================== -->
  <div class="section-title">{{ t('How much to trust this · measured records', '可信度如何 · 实测记录') }}</div>
  <div class="card">
    <h3>{{ t('Signal verdicts', '信号评定') }} <span class="faint" style="font-size:13px;font-weight:600">{{ t('forward outcomes,', '前瞻结果，') }} {{ calib.meta.span }}{{ t(', split-half', '，前后半段分检') }}</span></h3>
    <table class="catbl">
      <tr><td class="a">{{ t('Signal', '信号') }}</td><td>{{ t('Verdict', '评定') }}</td><td class="a">{{ t('What\'s measured', '测量内容') }}</td></tr>
      {% for sig,e in calib.signals.items() %}
      <tr><td class="a">{{ sig }}</td>
        <td><span class="verdict {{ 'v-conf' if 'CONFIRMED' in e.verdict else ('v-dir' if 'DIRECTIONAL' in e.verdict else 'v-ctx') }}">{{ td(e.verdict) }}</span></td>
        <td class="sub">{{ t('forward-return monotonicity by band', '按分档的前瞻收益单调性') }}</td></tr>
      {% endfor %}
      {% if calib.risk_drawdown %}
      <tr><td class="a">{{ t('risk_index (as risk)', 'risk_index（作为风险）') }}</td>
        <td><span class="verdict {{ 'v-conf' if 'CONFIRMED' in calib.risk_drawdown.verdict else 'v-dir' }}">{{ td(calib.risk_drawdown.verdict) }}</span></td>
        <td class="sub">{{ t('forward 7-day drawdown by band (its real job)', '按分档的前瞻 7 天回撤（其真正职责）') }}</td></tr>
      {% endif %}
    </table>
    <div class="sub" style="margin-top:12px">{{ t('House rule: a signal is labelled trustworthy only if its forward record holds in both halves of history. The Risk Index is judged on forward', '内部准则：只有当一个信号的前瞻记录在历史的前后两半段都成立时，才会被标记为可信。风险指数以前瞻') }} <b>{{ t('drawdown', '回撤') }}</b> {{ t('(not return) — at long horizons extreme risk marks capitulation, so it is contrarian there by design. Momentum on free data', '（而非收益）来评判 — 在长周期下，极端风险标志着投降式抛售，因此其在该处的设计本就是逆向的。在免费数据上，动量') }} <b>{{ t('leads', '领先') }}</b> {{ t('Swissblock\'s by ~2 weeks and matches their published', 'Swissblock 约 2 周，并在 65–69% 的交易日与其公布的') }} <em>{{ t('risk regime', '风险周期') }}</em> {{ t('65–69% of days; their proprietary momentum uses entity-adjusted flows we can\'t replicate for free.', '相符；他们的专有动量使用了我们无法免费复现的实体调整资金流。') }}</div>
  </div>

  {% set ep = calib.ensemble_promotion %}
  {% if ep and ep.net_sharpe %}
  <div class="card" style="margin-top:18px">
    <h3>{{ t('Ensemble capstone · does combining beat the hand-tuned stance?', '集成总验 · 组合能否击败手调立场？') }}</h3>
    <div class="sub">{{ t('We tested a principled, fixed-form ensemble (the gate-passed signals collapsed to 6 orthogonal axes, each oriented by its CALIBRATED expected-return map, de-correlated, equal-weight combined) against the hand-tuned Stance and the single best signal — net of cost, in both halves. The honest result:', '我们用一个有原则的固定形式集成（将通过校准的信号收敛为 6 个正交轴，各按其已校准的预期收益映射定向、去相关、等权组合）对比手调“立场”与单一最佳信号 — 扣除成本、在前后两半段中检验。诚实结论：') }}</div>
    <div class="sub" style="margin-top:8px;font-weight:700;color:var(--ink)">{{ td(ep.verdict) }}</div>
    <table class="catbl" style="margin-top:10px">
      <tr><td class="a">{{ t('Read','读数') }}</td><td>{{ t('Net Sharpe (full)','净夏普（全样本）') }}</td><td>{{ t('pre-2021','2021 前') }}</td><td>{{ t('post-2021','2021 后') }}</td></tr>
      {% set names = {'heuristic':['Hand-tuned Stance (shipped)','手调立场（已采用）'],'ensemble_eqw':['Orthogonalized ensemble','正交集成'],'best_single':['Best single signal','单一最佳信号']} %}
      {% for key in ['heuristic','ensemble_eqw','best_single'] %}{% set row = ep.net_sharpe[key] %}
      <tr><td class="a">{{ t(names[key][0], names[key][1]) }}{% if key=='best_single' %} <span class="faint">({{ ep.best_single }})</span>{% endif %}</td>
        <td><b>{{ row.full }}</b></td><td>{{ row.pre }}</td><td>{{ row.post }}</td></tr>
      {% endfor %}
    </table>
    <div class="sub faint" style="margin-top:10px;font-size:12px">{{ t('The ensemble (rank-IC', '该集成（秩 IC') }} {{ ep.ensemble_ic }}{{ t(' vs 90-day return) clearly beats the best single signal — de-redundancy + orthogonalization earn their keep — but does NOT beat the hand-tuned Stance in either half, so the Stance is KEPT and is now validated rather than just hand-set. We do not ship a worse model to look sophisticated (forecast-combination on ~3 cycles: equal-weight and best-single are brutal baselines). The ensemble research lives in the calibration report.', ' 对比 90 天收益）明显优于单一最佳信号 — 去冗余与正交化确有其值 — 但在任一半段均未击败手调“立场”，故保留“立场”，且其现已被验证而非仅靠手调。我们不会为了显得高级而采用更差的模型（约 3 个周期上的预测组合：等权与单一最佳是极难超越的基准）。集成研究详见校准报告。') }}</div>
  </div>
  {% endif %}

  <div class="foot">
    Bitcoin Vector · {{ t('built', '生成于') }} {{ built }} · {{ t('data as of', '数据截至') }} {{ as_of }}.
    {{ t('Independent reverse-engineering of Glassnode/Swissblock\'s Bitcoin Vector on free public data', '基于免费公开数据对 Glassnode/Swissblock 的 Bitcoin Vector 进行的独立逆向工程') }}
    (CoinMetrics, BGeometrics, Coinbase, Deribit, DefiLlama, mempool.space, Fear&amp;Greed).
    {{ t('Not investment advice. Signals are mechanical and backtested; every claim carries its measured record.', '非投资建议。信号为机械化且经回测；每一项主张均附带其实测记录。') }}
    {{ t('Limitations:', '局限性：') }} <a href="https://github.com/chriswong6031-creator/macro/blob/main/LIMITATIONS.md">LIMITATIONS.md</a>.
  </div>
</div>
<script>
(function(){
  var fil=document.querySelectorAll('.tlf'), items=document.querySelectorAll('.tl-item');
  fil.forEach(function(b){b.addEventListener('click',function(){
    fil.forEach(function(x){x.classList.remove('active')}); b.classList.add('active');
    var f=b.dataset.f;
    items.forEach(function(it){ it.hidden=!(f==='all'||it.dataset.f===f); });
    document.querySelectorAll('.tl-day').forEach(function(d){
      var any=[...d.querySelectorAll('.tl-item')].some(function(i){return !i.hidden});
      d.style.display=any?'':'none';
    });
  });});
})();
</script>
<script>
/* Vector charts keep their blue/red palette in zh mode (risk semantics, no green),
   so colours don't swap — only the axis titles + legend names translate. */
window.__CHART_SWAP__ = {
  colors: {},
  labels: {"BTC Price":"BTC 价格","Optimal strategy":"最优策略","Allocation":"仓位",
           "Buy / add":"买入 / 加仓","Sell / trim":"卖出 / 减仓",
           "5-day net flow":"5 日净流入","Net flow (BTC)":"净流入（BTC）",
           "Network Growth":"网络增长","Liquidity":"流动性","Momentum":"动量",
           "Structure Shift":"结构转变","Price $":"价格 $","Risk":"风险","Alloc":"仓位"}
};
</script>
<script src="theme.js"></script>
<script src="chart_i18n.js"></script>
<script src="vector_timemachine.js"></script>
