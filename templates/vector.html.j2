<div class="wrap">

  <!-- ===================== MARKET STATE HERO ===================== -->
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Market State · Long term', '市场状态 · 长期') }}</h2>
      <div class="hero-state">
        <span class="hero-dot {{ 'dot-on' if risk_on else 'dot-off' }}"></span>{{ t('Risk', '风险') }}
        <span class="{{ 'on' if risk_on else 'off' }}">{{ td(risk_word) }}</span>
      </div>
      <div class="hero-meta">
        <span class="{{ 'up' if risk_on else 'down' }}">{{ t('Risk Index', '风险指数') }} {{ risk_index }}</span>
        · <b>{{ td(risk_label) }}</b>
        · <span class="tip" title="Momentum vote-ensemble in [-1,+1]; ±0.5 = trigger · 动量投票集成，区间 [-1,+1]；±0.5 = 触发">{{ t('Momentum', '动量') }} {{ momentum }} ({{ td(momentum_state) }})</span>
      </div>
      {% set cs_color = {'ACCUMULATE':'var(--blue)','RISK-ON':'var(--blue)','DISTRIBUTE':'var(--r3)','RISK-OFF':'var(--r3)','NEUTRAL':'var(--muted)'} %}
      {% set cs_zh = {'ACCUMULATE':'累积','RISK-ON':'风险偏好','DISTRIBUTE':'派发','RISK-OFF':'风险规避','NEUTRAL':'中性'} %}
      <div class="hero-meta" style="margin-top:6px;font-size:17px">
        <b style="color:{{ cs_color.get(composite_state,'var(--muted)') }}">{{ t('Stance', '立场') }}: {{ t(composite_state, cs_zh.get(composite_state, composite_state)) }}</b>
        {% if composite_context == 'crowded_short' %}<span class="tip" title="Funding z below -1 = crowded shorts. A capitulation CONTEXT confirmer — surfaced but deliberately NOT wired into the allocation (no pre-2021 history to validate it). 资金费率 z 低于 -1 = 空头拥挤；投降式背景确认，仅展示不参与仓位。" style="font-size:12.5px;font-weight:600;color:var(--blue);border:1px solid var(--blue);border-radius:999px;padding:1px 9px;margin-left:8px">⚠ {{ t('Crowded shorts · capitulation context', '空头拥挤 · 投降式背景') }}</span>{% elif composite_context == 'froth' %}<span class="tip" title="CME spec net-long z above 1.5 = crowded longs = froth. A distribution CONTEXT confirmer (display-only). CME 投机净多 z 高于 1.5 = 多头拥挤 = 过热；派发背景确认，仅展示。" style="font-size:12.5px;font-weight:600;color:var(--r3);border:1px solid var(--r3);border-radius:999px;padding:1px 9px;margin-left:8px">🔥 {{ t('Froth · crowded longs', '过热 · 多头拥挤') }}</span>{% endif %}
        <span class="faint" style="font-size:13px"> · {{ t('valuation + extremes resolve the risk U-shape into a direction', '估值 + 极值将风险 U 形解析为方向') }}</span>
      </div>

      {# ---- multi-timeframe CONFLUENCE VERDICT (reconciles short bounce vs bigger picture) ---- #}
      {% if verdict and verdict.headline %}
      {% set vg = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
      {% set tfc = {'up':'var(--blue)','down':'var(--r3)','flat':'var(--grid)'} %}
      <div style="margin-top:14px;padding:13px 15px;border:1px solid var(--grid);border-radius:12px;background:var(--bg)">
        <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
          <span style="font-weight:800;font-size:12px;letter-spacing:.04em;padding:3px 9px;border-radius:7px;color:#fff;background:{{ vg.get(verdict.grade,'var(--muted)') }}">{{ t(verdict.grade, verdict.grade_zh) }}</span>
          <b style="font-size:16px;color:var(--ink)">{{ t(verdict.headline, verdict.headline_zh) }}</b>
        </div>
        <div class="sub" style="margin-top:7px">{{ t(verdict.sub, verdict.sub_zh) }}</div>
        <div style="display:flex;align-items:center;gap:7px;margin-top:10px;flex-wrap:wrap">
          <span class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.04em">{{ t('Trend by timeframe','各周期趋势') }}</span>
          {% set tlab = {'D':'D','3D':'3D','W':'W','2W':'2W','ME':'M'} %}
          {% for r in mtf_rows %}
          <span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--muted)"><i style="width:9px;height:9px;border-radius:50%;background:{{ tfc.get(r.trend,'var(--grid)') }}"></i>{{ tlab.get(r.key, r.key) }}</span>
          {% endfor %}
          <span class="faint" style="font-size:11px"> · {{ t('short','短') }} {{ '↑' if verdict.short_sign>0 else ('↓' if verdict.short_sign<0 else '→') }} · {{ t('mid','中') }} {{ '↑' if verdict.mid_sign>0 else ('↓' if verdict.mid_sign<0 else '→') }} · {{ t('long','长') }} {{ '↑' if verdict.long_sign>0 else ('↓' if verdict.long_sign<0 else '→') }}</span>
        </div>
      </div>{% endif %}

      <!-- cycle slider -->
      <div class="slider">
        <div class="track"><div class="knob" style="left:{{ cycle_pos }}%"></div></div>
        <div class="labels">
          {% for s in ['Defensive','Fragile','Recovery','Expansion'] %}
          <span class="{{ 'cur' if s==cycle_stage else '' }}">{{ td(s) }}</span>
          {% endfor %}
        </div>
      </div>

      <!-- momentum / volatility / flow -->
      <div class="metric-row">
        <div class="m"><div class="k">{{ t('Momentum', '动量') }}</div><div class="v">{{ td(mom_strength) }}</div></div>
        <div class="m"><div class="k">{{ t('Volatility', '波动率') }}</div><div class="v">{{ td(vol_state) }}</div>
          <div class="sub">{{ td(vol_side) }}</div></div>
        <div class="m"><div class="k">{{ t('Flow', '资金流') }}</div><div class="v">{{ td(flow_state) }}</div></div>
      </div>
    </div>

    <!-- allocation (next to the long-term scorecard) -->
    <div class="card">
      <h2>{{ t('BTC Allocation · Optimal strategy', 'BTC 仓位 · 最优策略') }}</h2>
      <div class="allocbar">
        {% if alloc_pct > 0 %}<div class="btc" style="width:{{ alloc_pct }}%">{{ alloc_pct }}% BTC</div>{% endif %}
        {% if alloc_pct < 100 %}<div class="cash" style="width:{{ 100-alloc_pct }}%">{{ 100-alloc_pct }}% {{ t('Cash', '现金') }}</div>{% endif %}
      </div>
      <div class="sub" style="margin-top:10px">{{ t('Market mode:', '市场模式：') }}
        <span class="chip {{ 'chip-strategic' if market_mode=='Strategic' else 'chip-tactical' }}">{{ td(market_mode) }}</span>
        · {{ t('BTC vs Alts leader:', 'BTC vs 山寨币 领先：') }} <b>{{ td(alt_leader) }}</b></div>
      {% if sizing %}
      <div class="mini" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:11px"><div class="lab" style="border:none;padding-top:0"><span>{{ t('Risk-budgeted Kelly size','风险预算 Kelly 仓位') }} <span class="faint" style="font-size:11px">({{ '½' if sizing.kelly_frac==0.5 else (sizing.kelly_frac|string) }}-Kelly, {{ sizing.dd_budget }}% {{ t('DD budget','回撤预算') }})</span></span><span><b style="font-size:17px;color:{{ 'var(--blue)' if sizing.size_pct>=40 else 'var(--r3)' }}">{{ sizing.size_pct }}%</b></span></div></div>
      <div class="sub faint" style="margin-top:4px;font-size:12px">{{ t('Half-Kelly on the','半 Kelly 基于') }} <b>{{ '%+0.0f'|format(sizing.edge_90) }}%/90d</b> {{ t('regime edge (','格局优势（') }}{{ td(sizing.stance|capitalize) }}{{ t(', σ','，σ') }} {{ sizing.vol_90 }}%), {% if sizing.binding=='tail' %}{{ t('capped by the','受限于') }} {{ sizing.tail_90 }}% {{ t('worst-case 90d dip','90 天极端回撤') }}{% else %}{{ t('edge-limited (the tail cap would allow','受优势限制（尾部上限允许') }} {{ (sizing.f_tail*100)|round|int }}%){% endif %}. {{ t('Direction is a coin-flip, so the edge is the regime, not the week.','方向接近抛硬币，故优势来自格局而非本周。') }}</div>
      {% endif %}
      {% if catalyst %}
      <div class="sub" style="margin-top:8px;font-size:12px;color:{{ 'var(--amber)' if catalyst.imminent else 'var(--muted)' }}">{% if catalyst.imminent %}⚠ {% endif %}{{ t('Next macro binary:','下一宏观二元事件：') }} <b>{{ td(catalyst.next_event) }}</b> {{ t('in','还有') }} {{ catalyst.days }} {{ t('day' if catalyst.days==1 else 'days','天') }} ({{ catalyst.next_date }}){% if catalyst.imminent %} — {{ t('expect a vol jump; the Kelly size models neither the gap nor the vol crush, so don\'t size up into it.','预期波动跳升；Kelly 仓位既不计入跳空也不计入波动收敛，故勿在此前加仓。') }}{% endif %}</div>
      {% endif %}
      <a href="vector_allocation.html" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px;padding:11px 14px;border:1px solid var(--grid);border-radius:11px;background:var(--bg);text-decoration:none;color:var(--ink);font-weight:600;font-size:13.5px">
        <span>◎ {{ t('Full allocation strategy — BTC · ETH · alts · cash', '完整仓位策略 — BTC · ETH · 山寨 · 现金') }}</span>
        <span style="color:var(--blue);font-size:16px">→</span>
      </a>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('The deep-dive page sizes ETH & altcoins by where we are in the alt-cycle (ETH/BTC ratio, alt-season).', '深度页面按所处山寨周期（ETH/BTC 比率、山寨季）配置 ETH 与山寨币。') }}</div>
    </div>
  </div>

  {# ---- conviction card macro (shared by mid & short so they are byte-identical "same format") ---- #}
  {% set gcol = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
  {% set gcolor = gcol.get(verdict.grade,'var(--muted)') %}
  {% macro convcard(c, R, title_en, title_zh, vsign, grade, grade_zh, gcolor) %}
    {% set dword = 'bull' if c.dir>0 else 'bear' %}
    {% set dottint = 'var(--muted)' if (c.state=='TOSS-UP' or c.lean<=3) else ('var(--blue)' if (c.state=='EDGE' and c.dir>0) else ('var(--r3)' if (c.state=='EDGE' and c.dir<0) else ('color-mix(in srgb,var(--blue) 58%,var(--grid))' if c.dir>0 else 'color-mix(in srgb,var(--r3) 60%,var(--grid))'))) %}
    <div class="conv-head">
      <span style="font-size:14px;font-weight:700;color:var(--ink)">{{ t(title_en, title_zh) }}</span>
      <span class="conv-n">{% if R and R.tail is not none %}n={{ '{:,}'.format(R.n) }}{% elif c.n %}n={{ '{:,}'.format(c.n) }}{% else %}—{% endif %}</span>
    </div>
    {% if R and R.tail is not none %}
    {# ---------- PRIMARY: forward drawdown / risk (the CONFIRMED quantity) ---------- #}
    {% set rwc = {'CALM':'var(--muted)','ELEVATED':'var(--r3)','HIGH':'color-mix(in srgb,var(--r3) 80%,var(--ink))','EXTREME':'color-mix(in srgb,var(--r3) 80%,var(--ink))'} %}
    <div class="risk-word" style="color:{{ rwc.get(R.word_en,'var(--r3)') }}">{{ t(R.head_en, R.head_zh) }}
      {%- if R.contrarian %} <span class="conv-tag">{{ t('contrarian zone','逆势区') }}</span>{% endif %}
      {%- if R.thin %} <span class="conv-tag">{{ t('thin sample','样本偏少') }}</span>{% endif %}
    </div>
    <div class="risk-nums">{{ t('Typical dip','常见回撤') }} <b>{{ R.avg }}%</b> <span class="faint">({{ t('calm','平静') }} {{ R.calm_avg }}%)</span> · {{ t('worst-case','极端') }} <b{% if R.thin %} class="faint"{% endif %}>{{ R.tail }}%</b> <span class="faint">({{ t('calm','平静') }} {{ R.calm_tail }}%)</span></div>
    {% set scale = (1.25 * ([(R.tail|abs),(R.calm_tail|abs)]|max)) %}
    {% set scale = scale if scale > 0 else 20 %}
    <div class="ddrail">
      <div class="ddrail-bar">
        <div class="dd-down" style="left:0;width:70%"></div>
        <div class="dd-up" style="left:70%;width:30%"></div>
        <div class="dd-mk dd-calm" style="left:{{ (70 - 70*(R.calm_tail|abs)/scale)|round(1) }}%" title="calm baseline"></div>
        <div class="dd-mk dd-typ" style="left:{{ (70 - 70*(R.avg|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-tail{% if R.thin %} thin{% endif %}" style="left:{{ (70 - 70*(R.tail|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-uptick" style="left:{{ (70 + 30*R.up/scale)|round(1) }}%"></div>
        <div class="dd-now" style="left:70%"></div>
      </div>
      <div class="ddrail-lab"><span class="r3b">{{ R.tail }}%</span><span class="mut">{{ R.avg }}%</span><span class="now">{{ t('now','当前') }}</span><span class="upf">+{{ R.up }}%</span></div>
    </div>
    {# ---------- SECONDARY: demoted direction strip (the honest coin-flip) ---------- #}
    <div class="dir-strip">
      <span class="dir-chip">{% if c.state=='TOSS-UP' %}{{ t('Toss-up','势均力敌') }}{% elif c.state=='LEAN' %}{{ t('Lean ' ~ dword, '倾向看多' if c.dir>0 else '倾向看空') }}{% else %}{{ t('Edge ' ~ dword, '看多优势' if c.dir>0 else '看空优势') }}{% endif %}</span>
      <div class="mini-needle"><div class="mn-dead"></div><div class="mn-tick"></div><div class="mn-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <span class="dir-num">{{ c.p_bear }}/{{ c.p_bull }}</span>
    </div>
    <div class="conv-sub">{{ t('direction is a coin-flip — drawdown above is the predicted quantity, direction is not','方向接近抛硬币 — 上方回撤才是可预测量，方向不是') }}</div>
    <div class="conv-why">{{ t(R.main_en, R.main_zh) }}</div>
    <div class="conv-why faint">{{ t(R.guard_en, R.guard_zh) }}</div>
    {% else %}
    {# ---------- fallback: conviction-led (no calibrated risk) ---------- #}
    {% set wcls = 'cw-toss' if c.state=='TOSS-UP' else (('cw-lean ' if c.state=='LEAN' else 'cw-edge ') ~ dword) %}
    <div class="cw {{ wcls }}">{% if c.state=='TOSS-UP' %}{{ t('Toss-up','势均力敌') }}{% elif c.state=='LEAN' %}{{ t('Lean ' ~ dword, '倾向看多' if c.dir>0 else '倾向看空') }}{% else %}{{ t('Edge ' ~ dword, '看多优势' if c.dir>0 else '看空优势') }}{% endif %}</div>
    <div class="needle"><div class="needle-axis"><div class="needle-dead"></div><div class="needle-tick"></div><div class="needle-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <div class="needle-ends"><span>{{ t('Bear','看空') }}</span><span class="needle-num">{{ c.p_bear }}% / {{ c.p_bull }}%</span><span>{{ t('Bull','看多') }}</span></div></div>
    <div class="conv-why">{{ t(c.why_en, c.why_zh) }}</div>
    {% endif %}
    <div class="conv-defer" style="color:{{ gcolor }}">↳ {{ t('Defers to','服从') }} <b>{{ t(grade, grade_zh) }}</b> — {{ t('the near-term texture under that bigger-picture call','大局判断之下的近端纹理') }}</div>
  {% endmacro %}

  {# AI Master Brief — Bitcoin-focused LLM synthesis (engine/master_brain.py, btc
     lens). Client-fetched from btc_brief.json so it never depends on build order;
     hidden until a usable brief loads. Research context only — never a signal. #}
  <div class="section-title">🧠 {{ t('AI Master Brief · Bitcoin synthesis', 'AI 主脑简报 · 比特币综合') }}</div>
  <div class="card ai-brief" id="btc-brief" data-brief-src="btc_brief.json" style="display:none">
    <style>
      #btc-brief .mb-sum{font-size:15px;font-weight:600;color:var(--ink);margin:0 0 10px}
      #btc-brief .mb-sec{margin:12px 0}
      #btc-brief .mb-h{font-weight:700;color:var(--blue);margin:0 0 4px;font-size:13px;text-transform:uppercase;letter-spacing:.04em}
      #btc-brief .mb-list{margin:4px 0 0 18px;padding:0}
      #btc-brief .mb-list li{margin:4px 0}
      #btc-brief .mb-foot{margin-top:14px;color:var(--muted);font-size:12px}
      #btc-brief [data-brief-body]{color:var(--text);font-size:14px;line-height:1.5}
    </style>
    <div class="sub" style="margin-bottom:10px">{{ t('AI synthesis across the vector\'s layers — cycle, valuation, leverage, on-chain, ETF flows and the macro-liquidity backdrop. Research context only; never a signal — verify against the panels below.', 'AI 对各层信号的综合 — 周期、估值、杠杆、链上、ETF 资金流与宏观流动性背景。仅供研究参考，绝非信号 — 请对照下方面板核实。') }}</div>
    <div data-brief-body></div>
  </div>

  <!-- ===================== MID & SHORT TERM (side by side, same format) ===================== -->
  <div class="section-title">{{ t('Mid term & Short term · near-term drawdown risk', '中期与短期 · 近端回撤风险') }}</div>
  <div class="grid cols-eq">

    <!-- mid term · 7-day outlook (risk-led) -->
    <div class="card">{{ convcard(env.conv, env.risk, 'Mid term · 7-day outlook', '中期 · 7 天展望', verdict.mid_sign, verdict.grade, verdict.grade_zh, gcolor) }}</div>

    <!-- short term · 3-day outlook (risk-led) + ATR scenario levels -->
    <div class="card">
      {{ convcard(scn.conv, scn.risk, 'Short term · 3-day outlook', '短期 · 3 天展望', verdict.short_sign, verdict.grade, verdict.grade_zh, gcolor) }}
      <div style="border-top:1px solid var(--grid);margin-top:14px;padding-top:12px;display:flex;gap:18px;flex-wrap:wrap">
        <div style="flex:1;min-width:150px">
          <div class="sub" style="font-weight:700;color:var(--ink)">{{ t('If it resolves down', '若向下') }}</div>
          <div class="scn-line"><span class="mut">{{ t('Target', '目标') }}</span><b class="down">{{ scn.bear_target|money }} → {{ scn.bear_target2|money }}</b></div>
          <div class="scn-line"><span class="mut">{{ t('Invalidation', '失效位') }}</span><b>{{ scn.bear_invalid|money }}</b></div>
        </div>
        <div style="flex:1;min-width:150px;border-left:1px solid var(--grid);padding-left:18px">
          <div class="sub" style="font-weight:700;color:var(--ink)">{{ t('If it resolves up', '若向上') }}</div>
          <div class="scn-line"><span class="mut">{{ t('Target', '目标') }}</span><b class="up">{{ scn.bull_target|money }} → {{ scn.bull_target2|money }}</b></div>
          <div class="scn-line"><span class="mut">{{ t('Invalidation', '失效位') }}</span><b>{{ scn.bull_invalid|money }}</b></div>
        </div>
      </div>
      <div class="sub" style="margin-top:10px">{{ t('ATR bands ×', 'ATR 带宽 ×') }}{{ scn.vscale }} {{ t('by forward vol — trade the level, not the bias; direction itself is a coin-flip.', '按前瞻波动率 — 交易关键位而非方向；方向本身接近抛硬币。') }}</div>
    </div>

  </div>

  <!-- ===================== RISK INDEX vs STRATEGY ===================== -->
  <div class="section-title">{{ t('Risk Index vs Strategy · backtested', '风险指数 vs 策略 · 已回测') }}</div>
  <div class="card">
    <h3>{{ t('BTC price, Risk Index & allocation', 'BTC 价格、风险指数与仓位') }}</h3>
    {{ charts.risk_strategy|safe }}
    <div class="sub" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;font-size:12px">
      <span style="opacity:.8">{{ t('Price shaded by allocation:', '价格按仓位着色：') }}</span>
      <span><span style="display:inline-block;width:12px;height:11px;border-radius:2px;background:rgba(34,170,94,0.45);vertical-align:-1px;margin-right:5px"></span>{{ t('Fully in (100%)', '满仓（100%）') }}</span>
      <span><span style="display:inline-block;width:12px;height:11px;border-radius:2px;background:rgba(245,173,66,0.55);vertical-align:-1px;margin-right:5px"></span>{{ t('Half (50%)', '半仓（50%）') }}</span>
      <span><span style="display:inline-block;width:12px;height:11px;border-radius:2px;border:1px solid var(--grid);vertical-align:-1px;margin-right:5px"></span>{{ t('Out (0%)', '空仓（0%）') }}</span>
      <span style="color:#1FA971;font-weight:600">▲ {{ t('buy / add', '买入 / 加仓') }}</span>
      <span style="color:#D30B0B;font-weight:600">▼ {{ t('sell / trim', '卖出 / 减仓') }}</span>
    </div>
    <div class="variant-tabs" style="margin-top:14px">
      {% set variant_zh = {'conservative':'保守','moderate':'稳健','aggressive':'进取','optimal':'最优'} %}
      {% for v in ['conservative','moderate','aggressive','optimal'] %}
      <span class="t {{ 'active' if v=='optimal' else '' }}">{{ t(v|capitalize, variant_zh[v]) }}</span>{% endfor %}
    </div>
    <div class="score">
      <div class="s"><div class="k">CAGR</div><div class="v">{{ cards.optimal.cagr }}%</div><div class="h">HODL {{ cards.optimal.hodl_cagr }}%</div></div>
      <div class="s"><div class="k">Sharpe</div><div class="v">{{ cards.optimal.sharpe }}</div><div class="h">HODL {{ cards.optimal.hodl_sharpe }}</div></div>
      <div class="s"><div class="k">{{ t('Max Drawdown', '最大回撤') }}</div><div class="v">{{ cards.optimal.maxdd }}%</div><div class="h">HODL {{ cards.optimal.hodl_maxdd }}%</div></div>
      <div class="s"><div class="k">{{ t('Time in market', '在场时间') }}</div><div class="v">{{ cards.optimal.in_market }}%</div><div class="h">{{ cards.optimal.x_hodl }}× HODL</div></div>
    </div>
    <div class="sub" style="margin-top:10px">{{ t('Long-only, acts next-day on the signal (no look-ahead). Every variant beats HODL\'s Sharpe', '仅做多，信号次日生效（无前视）。每个变体的 Sharpe 均优于 HODL') }} ({{ cards.optimal.hodl_sharpe }}){{ t(' and cuts max drawdown.', '，且降低了最大回撤。') }}</div>
  </div>

  <!-- ===================== CYCLE TIME MACHINE ===================== -->
  <div class="section-title">{{ t('Cycle Time Machine · scrub 10+ years of point-in-time history', '周期时光机 · 回溯十余年实时历史') }}</div>
  <div class="card" id="vtm" data-timeline="vector_timeline.json">
    <div class="vtm-wrap">
      <canvas id="vtm-canvas" class="vtm-canvas"></canvas>
      <input id="vtm-range" class="vtm-range" type="range" min="0" max="0" value="0" aria-label="Scrub BTC cycle history">
    </div>
    <div class="vtm-legend">
      <span><i style="background:#3b6fe0"></i>{{ t('Accumulation','吸筹') }}</span>
      <span><i style="background:#1f9d57"></i>{{ t('Markup','拉升') }}</span>
      <span><i style="background:#e0a43a"></i>{{ t('Recovery','修复') }}</span>
      <span><i style="background:#cf4f4f"></i>{{ t('Markdown','派发下行') }}</span>
    </div>
    <div class="vtm-controls">
      <button class="vtm-btn vtm-play" id="vtm-play" aria-label="Play"><span class="vtm-play-ico"></span></button>
      <span class="vtm-presets">
        <button class="vtm-btn" data-vtm-jump="now">{{ t('Now','当前') }}</button>
        <button class="vtm-btn" data-vtm-jump="2017-12-17">{{ t('2017 top','2017 顶') }}</button>
        <button class="vtm-btn" data-vtm-jump="2018-12-15">{{ t('2018 bottom','2018 底') }}</button>
        <button class="vtm-btn" data-vtm-jump="2021-04-14">{{ t('2021 top','2021 顶') }}</button>
        <button class="vtm-btn" data-vtm-jump="2022-11-09">{{ t('FTX crash','FTX 崩盘') }}</button>
      </span>
    </div>
    <div class="vtm-readout">
      <div class="vtm-asof">
        <span class="vtm-date" id="vtm-date">—</span>
        <span class="vtm-tag is-live" id="vtm-tag">—</span>
        <span class="vtm-price" id="vtm-price">—</span>
      </div>
      <div class="vtm-badges">
        <span class="vtm-badge" id="vtm-phase">—</span>
        <span class="vtm-badge" id="vtm-regime">—</span>
        <span class="vtm-badge" id="vtm-extreme" style="display:none">—</span>
        <span class="kv">{{ t('cycle stage','周期阶段') }} <b id="vtm-stage">—</b></span>
        <span class="kv">{{ t('ladder','阶梯') }} <b id="vtm-ladder">—</b></span>
        <span class="kv">{{ t('momentum','动量') }} <b id="vtm-mom">—</b></span>
        <span class="kv">{{ t('valuation','估值') }} <b id="vtm-val">—</b></span>
        <span class="kv">{{ t('stance','立场') }} <b id="vtm-composite">—</b></span>
        <span class="kv">{{ t('model alloc','模型仓位') }} <b id="vtm-alloc">—</b></span>
      </div>
      <div class="vtm-gauge">
        <div class="vtm-glabel"><span>{{ t('Risk Index (0–100)','风险指数（0–100）') }}</span><span id="vtm-risk-v">—</span></div>
        <div class="vtm-grail"><i id="vtm-risk-i" style="left:50%"></i></div>
      </div>
    </div>
    <div class="sub faint" style="margin-top:11px;font-size:12px">{{ t('Every value is point-in-time — no look-ahead. Drag the playhead (or press play) and the cycle phase, stage, ladder state, regime, risk index, valuation, stance and the model\'s allocation all rewind to exactly what the dashboard showed that day. The ladder & regime are backtested by replaying the cycle engine on each day\'s history.','每个数值均为实时快照 — 无前视。拖动播放头（或点击播放），周期阶段、阶梯状态、格局、风险指数、估值、立场与模型仓位都会回溯到当天看板的真实状态。阶梯与格局通过对每日历史重放周期引擎回测得到。') }}</div>
  </div>

  <!-- ===================== MULTI-TIMEFRAME TECHNICALS ===================== -->
  {% if mtf_rows %}
  <div class="section-title">{{ t('Multi-Timeframe Momentum & Technicals · Daily → Monthly', '多周期动量与技术指标 · 日线 → 月线') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Cycle ladder (shared with the stock analyzer)', '周期阶梯（与个股分析器一致）') }}
        {% if ladder.regime %}<b style="color:{{ 'var(--r3)' if ladder.regime=='bear' else ('var(--blue)' if ladder.regime=='bull' else 'var(--muted)') }}"> · {{ td(ladder.regime_label or ladder.regime) }}</b>{% endif %}</h3>
      {% if ladder.label %}<div class="mini"><div class="lab"><span>{{ t('Daily cycle state','日线周期状态') }}</span><span><b>{{ t(ladder.label, ladder.label_zh) }}</b>{% if ladder.age_short %} <span class="faint">· {{ td(ladder.age_short) }}</span>{% endif %}</span></div></div>{% endif %}
      {% if ladder.summary_line %}<div class="sub" style="margin-top:8px">{{ t(ladder.summary_line, ladder.summary_line_zh) }}</div>{% endif %}
      {% if ladder.entry_text %}<div class="sub" style="margin-top:6px;color:var(--ink)">{{ t(ladder.entry_text, ladder.entry_text_zh) }}</div>{% endif %}
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Same calibrated DCL/ICL cycle engine the Macro Dashboard runs on every asset (crypto preset: ~56–70d daily cycle).', '与宏观看板对每个资产运行的、同一套已校准的 DCL/ICL 周期引擎（加密预设：约 56–70 天日线周期）。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Technicals across timeframes', '跨周期技术指标') }}</h3>
      {% set tfc = {'up':'var(--blue)','down':'var(--r3)','flat':'var(--muted)'} %}
      {% set mz = {'up':'转多','down':'转空','pos':'多头','neg':'空头'} %}
      <table style="width:100%;border-collapse:collapse;font-size:13px">
        <tr style="color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.03em">
          <td style="padding:5px 4px">{{ t('TF','周期') }}</td><td style="text-align:right">RSI</td><td style="text-align:right">StochRSI</td><td style="text-align:right">MACD</td><td style="text-align:right">{{ t('Trend','趋势') }}</td></tr>
        {% set tlab = {'D':['Daily','日线'],'3D':['3-Day','3日'],'W':['Weekly','周线'],'2W':['Biweekly','双周'],'ME':['Monthly','月线']} %}
        {% for r in mtf_rows %}
        <tr style="border-top:1px solid var(--grid)">
          <td style="padding:7px 4px;font-weight:600;color:var(--ink)">{{ t(tlab.get(r.key,[r.key,r.key])[0], tlab.get(r.key,[r.key,r.key])[1]) }}</td>
          <td style="text-align:right;color:{{ 'var(--r3)' if r.rsi14 and r.rsi14>=70 else ('var(--blue)' if r.rsi14 and r.rsi14<=30 else 'var(--text)') }}">{{ r.rsi14 if r.rsi14 is not none else '—' }}</td>
          <td style="text-align:right;color:{{ 'var(--r3)' if r.stoch and r.stoch>=80 else ('var(--blue)' if r.stoch and r.stoch<=20 else 'var(--text)') }}">{{ r.stoch if r.stoch is not none else '—' }}</td>
          <td style="text-align:right;color:{{ 'var(--blue)' if r.macd in ('up','pos') else 'var(--r3)' }}">{{ t(r.macd|capitalize, mz.get(r.macd, r.macd)) }}</td>
          <td style="text-align:right"><i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{ tfc.get(r.trend,'var(--muted)') }}"></i></td>
        </tr>{% endfor %}
      </table>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('RSI red >70 / blue <30; StochRSI red >80 / blue <20. The trend dot is each timeframe’s MACD-trend direction — when short timeframes turn up while long ones stay red, it is a counter-trend bounce.', 'RSI 红 >70 / 蓝 <30；StochRSI 红 >80 / 蓝 <20。趋势圆点为各周期 MACD 趋势方向 — 当短周期转多而长周期仍为红时，即为逆势反弹。') }}</div>
    </div>
  </div>{% endif %}

  <!-- ===================== MOMENTUM / STRUCTURE ===================== -->
  <div class="section-title">{{ t('Momentum & Structure', '动量与结构') }}</div>
  <div class="grid cols-2">
    <div class="card"><h3>{{ t('Momentum', '动量') }} <span class="faint" style="font-size:14px">{{ momentum }}</span></h3>{{ charts.momentum|safe }}
      <div class="sub">{{ t('Bullish above +0.5, bearish below −0.5. State:', '高于 +0.5 看多，低于 −0.5 看空。状态：') }} <b>{{ td(momentum_state) }}</b>.</div></div>
    <div class="card"><h3>{{ t('Structure Shift', '结构转变') }} <span class="faint" style="font-size:14px">{{ structure }}</span></h3>{{ charts.structure|safe }}
      <div class="sub">{{ t('Constructive above +0.5, broken below −0.5. State:', '高于 +0.5 偏多，低于 −0.5 走坏。状态：') }} <b>{{ td(structure_state) }}</b>.</div></div>
  </div>

  <!-- ===================== IMPULSE ===================== -->
  <div class="section-title">{{ t('Impulse · acceleration of the move (start & exhaustion)', '脉冲 · 走势加速度（启动与衰竭）') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Impulse', '脉冲') }}
        {% set ic = {'positive':'var(--blue)','negative':'var(--r3)','neutral':'var(--muted)'} %}
        {% set iz = {'positive':'正向','negative':'负向','neutral':'中性'} %}
        <b style="color:{{ ic.get(impulse.state,'var(--muted)') }}"> · {{ t((impulse.state or '—')|upper, iz.get(impulse.state,'—')) }}</b>
        <span class="faint" style="font-size:14px"> {{ impulse.value if impulse.value is not none else '—' }}</span></h3>
      {% if impulse.pos_pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Positive participation (14d)','正向占比（14 天）') }}</span><span><b>{{ impulse.pos_pct }}%</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ impulse.pos_pct }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Trend efficiency (chop gate)','趋势效率（震荡过滤）') }}</span><span><b>{{ impulse.er if impulse.er is not none else '—' }}</b> <span class="faint">{{ t('(0 = chop, 1 = clean trend)','（0 = 震荡，1 = 单边）') }}</span></span></div></div>
      <div class="sub" style="margin-top:10px">{{ t('Glassnode/Swissblock-style: the z-scored ACCELERATION of momentum (MACD-histogram), gated by trend-efficiency so chop reads ~0, fused with a funding/OI positioning shock. It catches the START of a move and exhaustion — a level says “cheap”, Impulse says “selling force is burning out now.”', 'Glassnode/Swissblock 风格：动量的标准化加速度（MACD 柱），用趋势效率过滤震荡（震荡时约为 0），并融合资金费率/持仓的持仓冲击。它捕捉走势的启动与衰竭 — 估值说“便宜”，脉冲说“抛压此刻正在衰竭”。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Why it matters', '为何重要') }}</h3>
      <div class="sub">{{ t('CALIBRATED & CONFIRMED in both split-halves (2014→) — one of only four signals to clear that bar (with the Risk Index, BFI and the macro overlay). Strong-positive impulse (>0.5) preceded +3.7%/7d and +32.6%/90d at 66% hit; the deeply-negative “exhaustion” band (<−0.5) bounced +1.5%/7d (selling force spent). It feeds the short-term scenario odds.', '在两个分半样本中均已校准且确认（2014 起）— 仅有的四个达标信号之一（另三为风险指数、BFI 与宏观叠加）。强正脉冲（>0.5）后 7 天 +3.7%、90 天 +32.6%、胜率 66%；深度负值“衰竭”区（<−0.5）后 7 天反弹 +1.5%（抛压耗尽）。它参与短期情景概率。') }}</div>
    </div>
  </div>

  <!-- ===================== BFI ===================== -->
  <div class="section-title">{{ t('Bitcoin Fundamental Index', '比特币基本面指数（BFI）') }}</div>
  <div class="grid cols-2">
    <div class="card"><h3>{{ t('BFI = Network Growth × Liquidity', 'BFI = 网络增长 × 流动性') }}</h3>{{ charts.bfi|safe }}
      <div class="sub">{{ t('Positive above 60, negative below 40. Now:', '高于 60 为正向，低于 40 为负向。当前：') }} <b>{{ bfi }}</b> ({{ td(bfi_zone) }}).</div></div>
    <div class="card">
      <h3>{{ t('Fundamental gauges', '基本面指标') }}</h3>
      {% set gauge_zh = {'Network Growth':'网络增长','Liquidity':'流动性','BFI':'BFI'} %}
      {% for nm,val in [('Network Growth',network_growth),('Liquidity',liquidity),('BFI',bfi)] %}
