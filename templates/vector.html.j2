  <!-- ===================== CYCLE / POSITIONING / CORRELATION ===================== -->
  <div class="section-title">{{ t('Cycle Clock · Positioning · Cross-Asset Correlation', '周期时钟 · 持仓 · 跨资产相关性') }}</div>
  <div class="grid cols-2">
    <div class="card">
      {% set ph = cycle.phase %}
      {% set ph_color = {'accumulation':'var(--blue)','markup':'var(--blue)','markdown':'var(--r3)','recovery':'var(--ink)'} %}
