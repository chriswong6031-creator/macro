        {% elif valuation.overvalued %}<b style="color:var(--r3)"> · {{ t('OVERVALUED','高估') }}</b>
        {% elif valuation.state %}<span class="faint"> · {{ td(valuation.state|capitalize) }}</span>{% endif %}</h3>
      {% for nm,v,p in [('MVRV-Z', valuation.mvrv_z, valuation.mvrv_z_pctile), ('NUPL', valuation.nupl, None), ('Mayer Multiple', valuation.mayer, None)] %}
      <div class="mini"><div class="lab"><span>{{ t(nm) }}</span><span><b>{{ v if v is not none else '—' }}</b>{% if p is not none %} <span class="faint">({{ p }}%ile)</span>{% endif %}</span></div></div>
      {% endfor %}
      {% if valuation.reserve_risk is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Reserve Risk','储备风险') }}</span><span><b style="color:{{ 'var(--r3)' if valuation.rr_top else ('var(--blue)' if (valuation.reserve_risk_pctile is not none and valuation.reserve_risk_pctile < 25) else 'var(--ink)') }}">{{ '%.4f'|format(valuation.reserve_risk) }}</b>{% if valuation.reserve_risk_pctile is not none %} <span class="faint">({{ valuation.reserve_risk_pctile }}%ile)</span>{% endif %}{% if valuation.rr_top %} <b style="color:var(--r3)"> · {{ t('TOP','顶部') }}</b>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Calibrated (2010→): MVRV-Z below 0 preceded +40%/90d at 72% hit — the deepest-history accumulation signal; Mayer above 2.4 marked tops (−14%/90d). Both are now folded into the allocation: buy deep value, trim cycle tops.', '已校准（2010 起）：MVRV-Z 低于 0 时未来 90 天平均 +40%、胜率 72% — 历史最久的累积信号；Mayer 高于 2.4 标记顶部（90 天 −14%）。两者已并入仓位：低估买入、顶部减仓。') }}</div>
      <div class="sub" style="margin-top:6px">{{ t('Reserve Risk = price vs the opportunity cost of HODLing (checkonchain, 2010→): above 0.02 is a powerful TOP — −42.6%/90d at just 4% hit; the low band is accumulation (+18.6%/90d).', '储备风险 = 价格 vs 持有的机会成本（checkonchain，2010 起）：高于 0.02 是强力顶部信号 — 90 天 −42.6%、胜率仅 4%；低位区为累积（90 天 +18.6%）。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Miner cycle & cost basis', '矿工周期与成本基准') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Hash Ribbons','哈希丝带') }}</span><span><b>{{ td(valuation.hash_ribbon|capitalize) if valuation.hash_ribbon else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Puell Multiple','Puell 倍数') }}</span><span><b>{{ valuation.puell if valuation.puell is not none else '—' }}</b></span></div></div>
      {% if valuation.sth_cb_ratio is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Price vs STH cost basis','价格 vs 短期持有者成本') }}</span><span><b style="color:{{ 'var(--blue)' if valuation.sth_cb_ratio>=0 else 'var(--r3)' }}">{{ '%+0.1f'|format(valuation.sth_cb_ratio) }}%</b></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Hash Ribbons = 30/60-day hashrate (miner capitulation marks bottoms in hindsight, no average-return edge — context). STH cost basis is the bull/bear pivot.', '哈希丝带 = 30/60 天算力（矿工投降事后标记底部，但无平均收益优势 — 仅作背景）。短期持有者成本是牛熊分界。') }}</div>
    </div>
  </div>

  <!-- ===================== OPTIONS STRUCTURE ===================== -->
  <div class="section-title">{{ t('Options Structure · Deribit (forward-looking vol)', '期权结构 · Deribit（前瞻波动率）') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Implied volatility', '隐含波动率') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('DVOL (crypto VIX)','DVOL（加密 VIX）') }}</span><span><b>{{ options.dvol if options.dvol is not none else '—' }}</b>{% if options.dvol_pctile is not none %} <span class="faint">({{ options.dvol_pctile }}%ile)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Variance risk premium (IV−RV)','方差风险溢价（IV−RV）') }}</span><span><b>{{ options.vrp if options.vrp is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('ATM IV 30d / term slope','平值 30 天 IV / 期限斜率') }}</span><span><b>{{ options.atm_iv_30d if options.atm_iv_30d is not none else '—' }}</b> / {{ options.term_slope if options.term_slope is not none else '—' }}</span></div></div>
      {% if options.rv_cone_pctile is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Realized-vol cone (full history)','已实现波动锥（全历史）') }}</span><span><b>{{ options.rv_realized }}%</b> <span class="faint">({{ options.rv_cone_pctile }}%ile · {{ t('vol-of-vol','波动的波动') }} {{ options.vov_pctile }}%ile)</span></span></div></div>{% endif %}
      {% if options.gamma_regime %}
      {% set gr = {'long':['Long-gamma (pinning)','正Gamma（黏滞）','var(--blue)'],'short':['Short-gamma (amplifies)','负Gamma（放大）','var(--r3)']} %}
      <div class="mini"><div class="lab"><span>{{ t('Dealer gamma regime / flip','做市商 Gamma 格局 / 翻转位') }}</span><span><b style="color:{{ gr.get(options.gamma_regime,['','','var(--muted)'])[2] }}">{{ t(gr.get(options.gamma_regime,['—'])[0], gr.get(options.gamma_regime,['—','—'])[1]) }}</b> <span class="faint">({{ t('flip','翻转') }} {{ options.gamma_flip|money if options.gamma_flip else '—' }} · {{ '%+0.1f'|format(options.dist_to_flip_pct) if options.dist_to_flip_pct is not none else '—' }}%)</span></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Calibrated (2021→, confirmation-only): DVOL 70–90 is the bleed zone (−13%/90d); VRP below −5 (realized overshooting implied) marked recoveries (+17%/90d).', '已校准（2021 起，仅作确认）：DVOL 70–90 为失血区（90 天 −13%）；VRP 低于 −5（已实现超过隐含）标记反弹（90 天 +17%）。') }}</div>
      <div class="sub faint" style="margin-top:6px;font-size:12px">{{ t('The realized-vol cone + vol-of-vol are full-history (2015→) — the only vol-regime read that survives BOTH calibration halves. U-shaped at 90d: a high vol-of-vol percentile (panic) preceded +37.7%/90d at 76% hit (capitulation bounce), a calm cone +24.8%/90d. A near-term risk gauge, not a direction call.','已实现波动锥与“波动的波动”为全历史（2015 起）— 唯一在两个校准半样本中均成立的波动状态读数。90 天呈 U 形：高“波动的波动”分位（恐慌）后 90 天 +37.7%、胜率 76%（投降式反弹），平静波动锥 90 天 +24.8%。为近端风险计，而非方向判断。') }}</div>
      <div class="sub faint" style="margin-top:6px;font-size:12px">{{ t('Dealer gamma-flip = the spot where net dealer gamma crosses zero. ABOVE it (long-gamma) dealers hedge AGAINST the move → pinning / mean-reversion / suppressed vol; BELOW it (short-gamma) they hedge WITH the move → amplification / trend / vol expansion. A regime BOUNDARY, not a forecast — snapshot-only (no free options history) so it accrues forward rather than being back-calibrated.','做市商 Gamma 翻转位 = 净 Gamma 过零的现货价位。在其上方（正 Gamma），做市商逆势对冲 → 黏滞 / 均值回归 / 波动受抑；在其下方（负 Gamma），顺势对冲 → 放大 / 趋势 / 波动扩张。这是格局边界而非预测 — 仅快照（期权无免费历史），故向前累积而非回溯校准。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Skew & positioning (snapshot)', '偏斜与持仓（快照）') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('25Δ risk reversal','25Δ 风险逆转') }}</span><span><b style="color:{{ 'var(--r3)' if (options.rr_25d is not none and options.rr_25d<0) else 'var(--blue)' }}">{{ options.rr_25d if options.rr_25d is not none else '—' }}</b> <span class="faint">{{ t('(<0 = downside bid)','（<0 = 下行需求）') }}</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Put/Call OI ratio','看跌/看涨 持仓比') }}</span><span><b>{{ options.put_call if options.put_call is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Max pain','最大痛点') }}</span><span><b>{{ ('$%s'|format('{:,.0f}'.format(options.max_pain))) if options.max_pain is not none else '—' }}</b></span></div></div>
      {% if options.basis_ann is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Futures basis (annualized)','期货基差（年化）') }}</span><span><b style="color:{{ 'var(--r3)' if options.basis_ann>15 else ('var(--blue)' if options.basis_ann>=0 else 'var(--r3)') }}">{{ '%+0.1f'|format(options.basis_ann) }}%</b> <span class="faint">{{ t('(>15 froth, <0 stress)','（>15 过热，<0 承压）') }}</span></span></div></div>{% endif %}
      {% if options.skew_term is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Skew term (7d−90d)','偏斜期限（7天−90天）') }}</span><span><b>{{ '%+0.3f'|format(options.skew_term) }}</b> <span class="faint">{{ t('(>0 = acute near-term fear)','（>0 = 近端急性恐慌）') }}</span></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Rebuilt from the free Deribit chain (what Laevitas sells) — now incl. the futures-basis curve (leverage demand) and the skew term structure (near-term vs structural fear). The per-strike snapshot accumulates daily — context until ~6–12mo of history enables calibration.', '基于免费的 Deribit 期权链重建（即 Laevitas 所售）— 现含期货基差曲线（杠杆需求）与偏斜期限结构（近端 vs 结构性恐慌）。逐行权价快照每日累积 — 在约 6–12 个月历史前仅作背景。') }}</div>
    </div>
  </div>

  <!-- ===================== LEVERAGE & POSITIONING ===================== -->
  <div class="section-title">{{ t('Leverage & Positioning · liquidation risk', '杠杆与持仓 · 清算风险') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Leverage state', '杠杆状态') }}</h3>
      {% if leverage.stress is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Leverage stress','杠杆压力') }}</span><span><b>{{ leverage.stress }}/100</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ leverage.stress }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Aggregate open interest','总持仓量') }}</span><span><b>{{ ('$%.1fB'|format(leverage.oi_total/1e9)) if leverage.oi_total is not none else '—' }}</b>{% if leverage.oi_mcap_pctile is not none %} <span class="faint">({{ leverage.oi_mcap_pctile }}%ile vs mcap)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Funding (annualized)','资金费率（年化）') }}</span><span><b>{{ ('%+0.1f%%'|format(leverage.funding_annual)) if leverage.funding_annual is not none else '—' }}</b>{% if leverage.funding_z is not none %} <span class="faint">(z {{ leverage.funding_z }})</span>{% endif %}</span></div></div>
      {% if leverage.okx_ls_ratio is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OKX retail long/short (accounts)','OKX 散户多空比（账户数）') }}</span><span><b style="color:{{ 'var(--r3)' if leverage.okx_ls_lean=='crowded_long' else ('var(--blue)' if leverage.okx_ls_lean=='crowded_short' else 'var(--ink)') }}">{{ '%.2f'|format(leverage.okx_ls_ratio) }}</b>{% if leverage.okx_ls_pctile is not none %} <span class="faint">({{ leverage.okx_ls_pctile }}%ile{% if leverage.okx_ls_z is not none %} · z {{ leverage.okx_ls_z }}{% endif %})</span>{% endif %}
      {% if leverage.okx_ls_lean=='crowded_long' %} <span class="faint" style="color:var(--r3)">· {{ t('crowded longs (contrarian caution, not a buy)','多头拥挤（反向警示，非买入信号）') }}</span>{% elif leverage.okx_ls_lean=='crowded_short' %} <span class="faint" style="color:var(--blue)">· {{ t('crowded shorts (capitulation context)','空头拥挤（投降式背景）') }}</span>{% endif %}</span></div></div>{% endif %}
      {% if leverage.okx_taker_buy is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OKX taker buy/sell flow','OKX 主动买卖盘占比') }}</span><span><b>{{ '%.0f'|format(100*leverage.okx_taker_buy) }}%</b> <span class="faint">{{ t('buy share','主动买占比') }}{% if leverage.okx_taker_pctile is not none %} ({{ leverage.okx_taker_pctile }}%ile){% endif %}</span></span></div></div>{% endif %}
      {% if leverage.cme_basis is not none %}
      {% set creg = {'contango':'var(--amber)','backwardation':'var(--r3)','flat':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('CME basis (regulated carry)','CME 基差（受监管套利）') }}</span><span><b>{{ '%+0.2f'|format(leverage.cme_basis) }}%</b> <span class="faint">(~{{ '%+0.0f'|format(leverage.cme_basis_ann) }}%/yr · {{ leverage.cme_basis_pctile }}%ile · <span style="color:{{ creg.get(leverage.cme_basis_regime,'var(--muted)') }}">{{ td(leverage.cme_basis_regime) }}</span>)</span></span></div></div>{% endif %}
      {% if leverage.oi_divergence is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OI vs price divergence (14d)','持仓 vs 价格背离（14 天）') }}</span><span><b>{{ '%+0.1f'|format(leverage.oi_divergence) }}%</b></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Rebuilt from 15-exchange BGeometrics OI + funding (what CoinGlass aggregates). Calibrated (2022→, confirmation): funding-z below −1 (crowded shorts) preceded +18%/90d at 70% hit; OI building faster than price drags forward returns.', '基于 15 家交易所 BGeometrics 持仓 + 资金费率重建（即 CoinGlass 所聚合）。已校准（2022 起，确认）：资金费率 z 低于 −1（空头拥挤）未来 90 天 +18%、胜率 70%；持仓增速快于价格则拖累未来收益。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('How to read it', '如何解读') }}</h3>
      <div class="sub">{{ t('This layer is a short-horizon RISK amplifier, not a trend signal. High leverage stress + crowded one-sided funding = fragility: a small move can cascade into liquidations. Deeply negative funding or a sharp OI flush (deleveraging) is the contrarian tell that a local bottom is near.', '该层是短期风险放大器，而非趋势信号。高杠杆压力 + 单边拥挤资金费率 = 脆弱：小幅波动可能引发连环清算。深度负资金费率或持仓骤降（去杠杆）是局部底部临近的反向信号。') }}</div>
      <div class="sub faint" style="margin-top:6px;font-size:12px">{{ t('CME basis is the REGULATED, real-money carry (front-month future vs spot) — distinct from the offshore perp funding above. Rich contango = leverage/positioning froth; backwardation = stress. HONEST: measured ~ZERO forward-return edge for BTC (rank-IC ~0, 2021→), so it is shown as institutional POSITIONING CONTEXT, not a predictive signal.', 'CME 基差为受监管的真实资金套利（近月期货对现货）— 区别于上方离岸永续资金费率。高升水 = 杠杆/持仓过热；贴水 = 承压。诚实说明：对 BTC 前瞻收益的实测优势约为零（秩 IC ≈ 0，2021 起），故仅作机构持仓背景，而非预测信号。') }}</div>
      <div class="sub faint" style="margin-top:6px;font-size:12px">{{ t('OKX retail long/short & taker flow are DISPLAY-ONLY positioning context (rubik free data, shallow history) — shown as crowding context, never wired into the allocation or scored. Extreme retail-long = crowded/contrarian, not a buy.', 'OKX 散户多空比与主动买卖盘为仅展示的持仓背景（rubik 免费数据，历史较浅）— 仅作拥挤度背景，不参与仓位或评分。散户极度看多 = 拥挤/反向，而非买入信号。') }}</div>
    </div>
  </div>

