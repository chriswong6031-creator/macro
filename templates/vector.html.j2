      <span>{{ t('lower panes:', '下方面板：') }} {{ t('Risk level (blue = low risk / red = elevated risk)', '风险水平（蓝 = 低风险 / 红 = 偏高风险）') }} · {{ t('allocation %', '仓位 %') }}</span>
