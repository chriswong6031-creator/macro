{# Bilingual but GRACEFULLY DEGRADING: the macro emits both language spans (static
   zh is hardcoded at call sites, so it needs no engine.i18n). Only the dynamic
   td/tr globals consult the glossary — build_vector wires those optionally, so
   the page renders English-only if the i18n layer is ever absent. #}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Bitcoin Vector — {{ as_of }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.plot.ly/plotly-2.32.0.min.js"></script>
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r1:{{C.r1}}; --r2:{{C.r2}}; --r3:{{C.bear}};
  --r4:{{C.r4}}; --r5:{{C.r5}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --redfill:{{C.redfill}}; --amber:{{C.amber}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
  /* DIVERGING tone semantic: bull=blue (brand), bear=red, caution=amber, neutral=grey.
     --r3 is remapped to red above so every legacy bear/down/risk element flips to red. */
  --bull:var(--blue); --bull-soft:{{C.bull_soft}}; --bear:{{C.bear}}; --bear-soft:{{C.bear_soft}};
  --warn:{{C.warn}}; --neutral:var(--muted);
}
*{box-sizing:border-box}
/* language toggle: dual-emit text, hide the inactive language (blue/red palette
   is kept in zh mode — it encodes risk, not price direction). */
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB",
  "Microsoft YaHei","Noto Sans CJK SC","Microsoft JhengHei","Heiti SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;
  font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.brand{font-weight:800;font-size:20px;color:var(--ink);letter-spacing:-.02em}
.brand .gn{color:var(--blue)}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280;--r1:#1b2740;--r2:#243352;--r3:{{C.bear_dk}};--bear:{{C.bear_dk}};--bear-soft:#3a1c1c;--bull-soft:#14233f}
html[data-theme="dark"] body{-webkit-font-smoothing:antialiased}
/* layout */
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.15fr .85fr}
.cols-eq{grid-template-columns:1fr 1fr}
.cols-3{grid-template-columns:repeat(3,1fr)}
.cols-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.cols-2,.cols-eq,.cols-3,.cols-4{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.04em}
.card h3{margin:0 0 14px;font-size:18px;font-weight:700;color:var(--ink)}
.sub{color:var(--muted);font-size:13px}
.mut{color:var(--muted)} .faint{color:var(--faint)}
.section-title{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;
  letter-spacing:.05em;margin:30px 4px 12px}
/* hero risk headline */
.hero-state{font-size:64px;font-weight:800;color:var(--ink);line-height:1;letter-spacing:-.03em}
.hero-state .on{color:var(--blue)} .hero-state .off{color:var(--r3)}
.hero-dot{display:inline-block;width:18px;height:18px;border-radius:50%;
  vertical-align:middle;margin-right:14px}
.dot-on{background:var(--blue)} .dot-off{background:var(--r3)}
.hero-meta{margin-top:10px;font-size:16px}
.pill-price{font-weight:700;color:var(--ink)}
.up{color:var(--blue)} .down{color:var(--r3)}
/* gradient slider gauge */
.slider{margin:18px 0 6px}
.slider .track{position:relative;height:8px;border-radius:6px;
  background:linear-gradient(90deg,var(--r1),var(--r2),var(--r4),var(--r5))}
.slider .knob{position:absolute;top:50%;width:18px;height:18px;border-radius:50%;
  background:#fff;border:3px solid var(--blue);transform:translate(-50%,-50%);box-shadow:0 1px 4px rgba(0,0,0,.15)}
.slider .labels{display:flex;justify-content:space-between;margin-top:8px;
  font-size:12px;color:var(--muted);font-weight:600}
.slider .labels span.cur{color:var(--ink)}
/* small mini-gauge */
.mini{margin-top:4px}
.mini .bar{height:6px;border-radius:4px;background:var(--grid);position:relative;margin:6px 0}
.mini .fill{position:absolute;height:100%;border-radius:4px;background:var(--blue)}
.mini .lab{display:flex;justify-content:space-between;font-size:12px;color:var(--muted)}
.metric-row{display:flex;gap:0;margin-top:18px;border-top:1px solid var(--grid);padding-top:16px}
.metric-row .m{flex:1;text-align:center}
.metric-row .m .k{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
.metric-row .m .v{font-size:18px;font-weight:700;color:var(--ink);margin-top:2px}
/* allocation bar */
.allocbar{height:46px;border-radius:12px;overflow:hidden;display:flex;font-weight:700;color:#fff;margin-top:6px}
.allocbar .btc{background:linear-gradient(90deg,var(--r4),var(--blue));display:flex;align-items:center;justify-content:center}
.allocbar .cash{background:linear-gradient(90deg,#cfd4dc,#9aa4b2);display:flex;align-items:center;justify-content:center;color:#fff}
/* chips */
.chip{display:inline-block;padding:6px 14px;border-radius:10px;font-weight:700;font-size:14px}
.chip-bull{background:var(--bull);color:#fff} .chip-bear{background:var(--bear);color:#fff}
.chip-ghost{background:var(--grid);color:var(--muted)}
.chip-strategic{background:var(--blue);color:#fff} .chip-tactical{background:var(--redfill);color:var(--red)}
/* probability bar */
.prob{display:flex;align-items:center;gap:10px;margin:8px 0}
.prob .lab{width:54px} .prob .track{flex:1;height:10px;border-radius:6px;background:var(--grid);overflow:hidden}
.prob .fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--r3),var(--blue))}
.prob .fill.bear{background:linear-gradient(90deg,var(--r1),var(--r3))}
.prob .pct{width:42px;text-align:right;font-weight:700;color:var(--ink)}
/* conviction dots */
.dots{display:inline-flex;gap:6px}
.dots i{width:14px;height:14px;border-radius:50%;border:1.5px solid var(--r2);display:inline-block}
.dots i.on{background:var(--bull);border-color:var(--bull)}
.dots i.on.bear{background:var(--bear);border-color:var(--bear)}
/* cross-asset table */
.catbl{width:100%;border-collapse:collapse}
.catbl td{padding:9px 4px;border-bottom:1px solid var(--grid);font-size:14px}
.catbl td.a{font-weight:700;color:var(--ink)} .catbl td.r{text-align:right}
.catbl tr:last-child td{border-bottom:none}
.cat-h{font-weight:700;color:var(--ink);margin:2px 0 4px;font-size:15px}
/* scorecard */
.score{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.score .s{background:var(--bg);border-radius:10px;padding:12px;text-align:center}
html[data-theme="dark"] .score .s{background:var(--grid)} /* --bg is near-black in dark → lift tiles to the card-elevation grey so they read on the card */
.score .s .k{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase}
.score .s .v{font-size:20px;font-weight:800;color:var(--ink)}
.score .s .h{font-size:11px;color:var(--faint);margin-top:2px}
.variant-tabs{display:flex;gap:8px;margin-bottom:6px;flex-wrap:wrap}
.variant-tabs .t{padding:6px 14px;border-radius:9px;background:var(--grid);color:var(--muted);
  font-weight:700;font-size:13px;cursor:pointer;border:none}
.variant-tabs .t.active{background:var(--blue);color:#fff}
/* badges / verdict */
.verdict{display:inline-block;padding:3px 9px;border-radius:7px;font-size:12px;font-weight:700}
.v-conf{background:#E3F5E9;color:#1a7f43} .v-dir{background:#FFF2D9;color:#9a6a00}
.v-ctx{background:var(--grid);color:var(--muted)}
.tip{border-bottom:1px dashed var(--faint);cursor:help}
.foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--grid);
  font-size:12px;color:var(--faint);line-height:1.7}
.site-footer{max-width:1180px;margin:40px auto 8px;padding-top:22px;
  border-top:1px solid var(--grid);text-align:center;line-height:1.6}
.site-footer .made{display:block;font-size:13.5px;font-weight:700;
  color:var(--ink);letter-spacing:.2px}
.site-footer .dev{display:block;margin-top:1px;font-size:12px;color:var(--muted)}
.scn-line{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--grid);font-size:14px}
.scn-line:last-child{border:none}
.big{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
/* conviction layer (TOSS-UP / LEAN / EDGE) — honest no-edge labeling. Monochrome:
   bull=blue, bear=r3 (lighter blue), toss-up=grey; no red (reserved for alerts). */
.conv-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.conv-n{font-size:11px;color:var(--faint);font-weight:600;white-space:nowrap}
.cw{font-size:31px;font-weight:800;letter-spacing:-.02em;line-height:1.08;margin-top:7px}
.cw-toss{color:var(--muted)}
.cw-lean.bull{color:color-mix(in srgb,var(--blue) 58%,var(--grid))}
.cw-lean.bear{color:color-mix(in srgb,var(--r3) 60%,var(--grid))}
.cw-edge.bull{color:var(--blue)} .cw-edge.bear{color:var(--r3)}
.conv-tag{display:inline-block;padding:2px 8px;border-radius:7px;font-size:11.5px;font-weight:700;vertical-align:middle;margin-left:8px;background:var(--grid);color:var(--muted)}
.conv-ok{margin-left:6px;color:var(--blue);font-weight:800;font-size:20px;vertical-align:middle}
.conv-sub{font-size:13px;color:var(--muted);margin-top:2px}
.needle{margin:15px 0 4px}
.needle-axis{position:relative;height:14px;border-radius:8px;background:var(--grid)}
.needle-dead{position:absolute;left:47%;width:6%;top:0;bottom:0;background:var(--muted);opacity:.32;border-radius:4px}
.needle-tick{position:absolute;left:50%;top:-4px;bottom:-4px;width:2px;margin-left:-1px;background:var(--muted);opacity:.65}
.needle-dot{position:absolute;top:50%;width:15px;height:15px;margin-left:-7.5px;transform:translateY(-50%);border-radius:50%;box-shadow:0 0 0 3px var(--card)}
.needle-ends{display:flex;justify-content:space-between;font-size:11px;color:var(--faint);font-weight:600;margin-top:6px}
.needle-num{color:var(--muted);font-weight:700}
.conv-why{font-size:12.5px;color:var(--muted);margin-top:12px;line-height:1.5}
.conv-defer{font-size:12px;margin-top:7px;font-weight:600;line-height:1.45}
/* forward-risk (drawdown) layer — risk LEADS, direction demoted. Monochrome:
   downside=r3, upside=faint blue, now/calm=grey; no red. */
.risk-word{font-size:25px;font-weight:800;letter-spacing:-.01em;line-height:1.12;margin-top:6px}
.risk-nums{font-size:13px;color:var(--ink);margin-top:5px}
.risk-nums b{font-weight:800}
.ddrail{margin:13px 0 2px}
.ddrail-bar{position:relative;height:14px;border-radius:8px;background:var(--grid)}
.dd-down{position:absolute;top:0;bottom:0;border-radius:8px 0 0 8px;background:linear-gradient(90deg,var(--r3),color-mix(in srgb,var(--r3) 18%,var(--grid)))}
.dd-up{position:absolute;top:0;bottom:0;border-radius:0 8px 8px 0;background:color-mix(in srgb,var(--blue) 16%,var(--grid))}
.dd-now{position:absolute;top:-3px;bottom:-3px;width:2px;margin-left:-1px;background:var(--ink)}
.dd-mk{position:absolute;top:50%;width:13px;height:13px;margin-left:-6.5px;transform:translateY(-50%);border-radius:50%;box-shadow:0 0 0 3px var(--card)}
.dd-tail{background:var(--r3)} .dd-tail.thin{opacity:.45}
.dd-typ{background:color-mix(in srgb,var(--r3) 50%,var(--grid))}
.dd-calm{width:9px;height:9px;margin-left:-4.5px;background:var(--faint);box-shadow:0 0 0 2px var(--card)}
.dd-uptick{width:9px;height:9px;margin-left:-4.5px;background:color-mix(in srgb,var(--blue) 55%,var(--grid))}
.ddrail-lab{display:flex;justify-content:space-between;font-size:11px;margin-top:8px}
.ddrail-lab .r3b{color:var(--r3);font-weight:700} .ddrail-lab .now{color:var(--muted)}
.ddrail-lab .upf{color:color-mix(in srgb,var(--blue) 60%,var(--muted))}
.dir-strip{display:flex;align-items:center;gap:10px;margin-top:14px;padding-top:11px;border-top:1px solid var(--grid)}
.dir-chip{font-size:12.5px;font-weight:700;color:var(--muted);white-space:nowrap}
.mini-needle{position:relative;flex:1;max-width:120px;height:10px;border-radius:5px;background:var(--grid)}
.mn-dead{position:absolute;left:47%;width:6%;top:0;bottom:0;background:var(--muted);opacity:.32;border-radius:3px}
.mn-tick{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--muted);opacity:.6}
.mn-dot{position:absolute;top:50%;width:11px;height:11px;margin-left:-5.5px;transform:translateY(-50%);border-radius:50%;box-shadow:0 0 0 2px var(--card)}
.dir-num{font-size:12px;color:var(--muted);font-weight:700;white-space:nowrap}
/* alert timeline */
.tl-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.tlf{padding:6px 14px;border-radius:9px;background:var(--grid);color:var(--muted);
 font-weight:700;font-size:13px;cursor:pointer;border:none}
.tlf.active{background:var(--blue);color:#fff}
.timeline{position:relative}
.tl-day{margin-bottom:20px}
.tl-date{font-size:12px;font-weight:700;color:var(--faint);text-transform:uppercase;
 letter-spacing:.05em;margin:0 0 10px;position:sticky;top:64px;background:var(--card);padding:4px 0;z-index:5}
.tl-item{border-left:2px solid var(--grid);padding:0 0 0 18px;margin-left:6px;position:relative}
.tl-item summary{display:flex;align-items:center;gap:10px;padding:9px 0;cursor:pointer;
 list-style:none;flex-wrap:wrap}
.tl-item summary::-webkit-details-marker{display:none}
.tl-node{position:absolute;left:-7px;top:15px;width:12px;height:12px;border-radius:50%;
 background:var(--faint);border:2px solid var(--card)}
.tl-node.n-high{background:var(--red)} .tl-node.n-medium{background:var(--blue)} .tl-node.n-info{background:var(--r3)}
.tl-node.n-flash_crash{background:var(--red)} .tl-node.n-momentum_trigger{background:var(--indigo)}
.tl-chip{font-size:11px;font-weight:700;padding:2px 9px;border-radius:7px;background:var(--grid);color:var(--muted)}
.tl-chip.f-flash{background:var(--redfill);color:var(--red)}
.tl-chip.f-risk{background:#FDEBEB;color:var(--red)}
.tl-chip.f-structure{background:#E8EEFF;color:var(--blue)}
.tl-chip.f-momentum{background:#ECE9FB;color:var(--indigo)}
.tl-head{font-weight:600;color:var(--ink);font-size:14px;flex:1;min-width:200px}
.tl-time{font-size:12px;color:var(--faint);font-weight:600}
.tl-detail{padding:2px 0 12px;font-size:13px;color:var(--muted);line-height:1.6}
.tl-edge{margin-top:7px;font-size:12px;color:var(--ink)}
.tl-fwd{margin-top:3px;font-size:12px;color:var(--muted)}
.tl-link{display:inline-block;margin-left:8px;font-weight:700;font-size:13px}
.tl-item[hidden]{display:none}
/* cycle time machine (vector_timemachine.js) */
#vtm{padding:20px 22px}
.vtm-wrap{position:relative;margin:2px 0}
.vtm-canvas{display:block;width:100%;height:56px;cursor:ew-resize;border-radius:8px;touch-action:none}
.vtm-range{-webkit-appearance:none;appearance:none;width:100%;height:16px;background:transparent;margin:2px 0 0;cursor:ew-resize}
.vtm-range::-webkit-slider-runnable-track{height:4px;border-radius:2px;background:var(--grid)}
.vtm-range::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:16px;height:16px;margin-top:-6px;border-radius:50%;background:var(--ink);border:2px solid var(--card);box-shadow:0 1px 4px rgba(0,0,0,.3)}
.vtm-range::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--ink);border:2px solid var(--card)}
.vtm-controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:10px 0 4px}
.vtm-btn{font:inherit;font-size:12.5px;font-weight:600;cursor:pointer;background:var(--bg);border:1px solid var(--grid);border-radius:8px;padding:5px 11px;color:var(--muted);transition:color .15s,border-color .15s}
.vtm-btn:hover{color:var(--ink);border-color:var(--muted)}
.vtm-play{display:inline-flex;align-items:center;justify-content:center;width:34px;padding:0}
.vtm-play-ico{width:0;height:0;border-style:solid;border-width:6px 0 6px 10px;border-color:transparent transparent transparent var(--ink)}
.vtm-play.is-playing .vtm-play-ico{width:9px;height:11px;border:none;border-left:3px solid var(--ink);border-right:3px solid var(--ink)}
.vtm-presets{display:flex;gap:6px;flex-wrap:wrap}
.vtm-legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin:9px 2px 0}
.vtm-legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:middle}
.vtm-readout{background:var(--bg);border:1px solid var(--grid);border-radius:12px;padding:14px 16px;margin-top:13px}
.vtm-asof{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.vtm-date{font-size:20px;font-weight:800;color:var(--ink);letter-spacing:-.01em}
.vtm-tag{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:2px 9px;border-radius:9px}
.vtm-tag.is-live{color:var(--blue);background:color-mix(in srgb,var(--blue) 14%,var(--card))}
.vtm-tag.is-hist{color:var(--muted);background:var(--grid)}
.vtm-price{margin-left:auto;font-size:17px;font-weight:800;color:var(--ink)}
.vtm-badges{display:flex;align-items:center;gap:9px 16px;flex-wrap:wrap;margin-top:13px;font-size:13px;color:var(--muted)}
.vtm-badge{display:inline-block;padding:3px 11px;border-radius:10px;font-weight:700;font-size:12.5px;background:var(--grid);color:var(--ink)}
.vtm-badges .kv b{color:var(--ink);font-weight:700}
.vtm-gauge{margin-top:15px}
.vtm-glabel{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:5px}
.vtm-glabel span:last-child{font-weight:700;color:var(--ink)}
.vtm-grail{position:relative;height:6px;border-radius:3px;background:linear-gradient(90deg,var(--blue),var(--grid) 50%,var(--r3))}
.vtm-grail i{position:absolute;top:50%;width:12px;height:12px;border-radius:50%;background:var(--ink);border:2px solid var(--card);transform:translate(-50%,-50%)}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav" style="max-width:1180px;margin:18px auto 16px;padding:0 20px">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">

  <!-- ===================== MASTER SIGNAL · COMMAND CENTER ===================== -->
  {% if master and master.ok %}
  <style>
    .cmd{display:grid;grid-template-columns:300px 1fr;gap:22px;background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb,var(--blue) 9%,var(--card)) 0%, var(--card) 55%);
      border:1px solid var(--grid);border-radius:20px;padding:24px;margin-bottom:8px}
    @media(max-width:780px){.cmd{grid-template-columns:1fr}}
    .cmd-h{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin:0 0 2px}
    .mg-wrap{position:relative;width:280px;height:150px;margin:6px auto 2px}
    .mg-needle{position:absolute;left:138px;top:32px;width:4px;height:108px;border-radius:3px;
      transform-origin:50% 100%;transition:transform .7s cubic-bezier(.34,1.3,.5,1)}
    .mg-hub{position:absolute;left:130px;top:130px;width:20px;height:20px;border-radius:50%;border:3px solid var(--card)}
    .mg-score{position:absolute;left:0;right:0;top:74px;text-align:center;font-size:38px;font-weight:800;letter-spacing:-.03em;line-height:1}
    .mg-ends{display:flex;justify-content:space-between;font-size:11px;font-weight:700;color:var(--faint);margin:-6px 6px 0}
    .mg-band{text-align:center;font-size:21px;font-weight:800;letter-spacing:-.01em;margin-top:8px}
    .mg-tally{text-align:center;font-size:12px;color:var(--muted);margin-top:3px}
    .mg-tally b.bu{color:var(--blue)} .mg-tally b.be{color:var(--r3)}
    .cmd-r-top{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
    .cmd-price{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
    .cmd-stance{font-size:15px;font-weight:800}
    .cmd-head{font-size:13.5px;color:var(--text);line-height:1.55;margin-top:10px}
    .cmd-drv{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px}
    .cmd-drv .col{flex:1;min-width:200px}
    .cmd-drv .ch{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);margin-bottom:6px}
    .drvchip{display:flex;align-items:center;gap:7px;font-size:12.5px;padding:4px 0}
    .drvchip i{width:8px;height:8px;border-radius:50%;flex:none}
    .drvchip i.bull{background:var(--blue)} .drvchip i.bear{background:var(--r3)}
    .drvchip b{color:var(--ink);font-weight:700} .drvchip span{color:var(--muted)}
    .cmd-act{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px;
      border-top:1px solid var(--grid);padding-top:14px}
    .cmd-act .a{text-align:center}
    .cmd-act .a .k{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
    .cmd-act .a .v{font-size:18px;font-weight:800;color:var(--ink);margin-top:2px}
    .cmd-act .a .h{font-size:11px;color:var(--faint);margin-top:1px}
    /* Signal Board */
    .board{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media(max-width:900px){.board{grid-template-columns:1fr}}
    .bgrp{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:14px 16px}
    .bgrp h4{margin:0 0 8px;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
    .brow{display:grid;grid-template-columns:12px 1fr auto;grid-template-rows:auto auto;
      gap:1px 9px;align-items:center;padding:8px 0;border-top:1px solid var(--grid)}
    .brow:first-of-type{border-top:none}
    .brow .dot{grid-row:1/3;width:9px;height:9px;border-radius:50%}
    .brow .dot.bull{background:var(--blue)} .brow .dot.bear{background:var(--r3)} .brow .dot.neutral{background:var(--muted)}
    .brow .lab{font-size:13px;font-weight:600;color:var(--ink)}
    .brow .gr{justify-self:end;font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:6px;letter-spacing:.02em}
    .gr-CONFIRMED{background:#E3F5E9;color:#1a7f43} .gr-DIRECTIONAL{background:#ECE9FB;color:#5b46c8}
    .gr-EXTREMES{background:#FFF2D9;color:#9a6a00} .gr-CONTEXT{background:var(--grid);color:var(--muted)}
    .gr-NEW{background:#DDF3F6;color:#0d7b8a} .gr-INVERTED{background:var(--grid);color:var(--muted)}
    html[data-theme="dark"] .gr-CONFIRMED{background:#16331f;color:#5fd08a}
    html[data-theme="dark"] .gr-DIRECTIONAL{background:#241d44;color:#a594f0}
    html[data-theme="dark"] .gr-EXTREMES{background:#3a2e12;color:#e0b34e}
    html[data-theme="dark"] .gr-NEW{background:#10333a;color:#4fc6d8}
    .brow .st{font-size:11.5px;color:var(--muted)}
    .brow .spk{grid-row:1/3;justify-self:end;width:62px;height:24px}
    .brow .spk polyline{fill:none;stroke-width:1.6;vector-effect:non-scaling-stroke}
    .spk.bull polyline{stroke:var(--bull)} .spk.bear polyline{stroke:var(--bear)} .spk.neutral polyline{stroke:var(--neutral)}
    /* RECOMMENDATION card */
    .reco{display:grid;grid-template-columns:1.1fr 1fr;gap:0;border:1px solid var(--grid);border-radius:18px;overflow:hidden;margin-top:14px}
    @media(max-width:780px){.reco{grid-template-columns:1fr}}
    .reco-l{padding:20px 22px;border-right:1px solid var(--grid)}
    @media(max-width:780px){.reco-l{border-right:none;border-bottom:1px solid var(--grid)}}
    .reco-r{padding:20px 22px;display:flex;flex-direction:column;gap:14px}
    .reco-l.t-bull{background:linear-gradient(120% 140% at 0 0,var(--bull-soft),var(--card) 60%)}
    .reco-l.t-bear{background:linear-gradient(120% 140% at 0 0,var(--bear-soft),var(--card) 60%)}
    .reco-l.t-neutral{background:var(--card)}
    .reco-k{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
    .reco-act{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1.08;margin:6px 0 8px}
    .reco-act.t-bull{color:var(--bull)} .reco-act.t-bear{color:var(--bear)} .reco-act.t-neutral{color:var(--ink)}
    .reco-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--muted)}
    .reco-conv{font-size:11px;font-weight:800;padding:2px 9px;border-radius:7px;letter-spacing:.03em}
    .conv-high{background:var(--bull);color:#fff} .conv-moderate{background:var(--warn);color:#fff} .conv-low{background:var(--grid);color:var(--muted)}
    .reco-conv.bear.conv-high{background:var(--bear)}
    .reco-exp-band{font-size:24px;font-weight:800;color:var(--ink);margin:2px 0 6px}
    .exp-track{position:relative;height:12px;border-radius:7px;background:var(--grid)}
    .exp-fill{position:absolute;top:0;bottom:0;border-radius:7px;background:color-mix(in srgb,var(--bull) 55%,var(--grid))}
    .exp-fill.t-bear{background:color-mix(in srgb,var(--bear) 50%,var(--grid))}
    .exp-kelly{position:absolute;top:-3px;bottom:-3px;width:3px;margin-left:-1.5px;background:var(--ink);border-radius:2px}
    .exp-scale{display:flex;justify-content:space-between;font-size:10px;color:var(--faint);margin-top:4px}
    .reco-lvls{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px}
    .reco-lvls .lv .k{font-size:11px;color:var(--muted);font-weight:600;display:block}
    .reco-lvls .lv b{font-size:15px;color:var(--ink);font-weight:800}
    .reco-lvls .lv b.up{color:var(--bull)} .reco-lvls .lv b.down{color:var(--bear)}
    .reco-risk{font-size:12.5px;color:var(--bear);background:var(--bear-soft);border-radius:9px;padding:8px 11px;line-height:1.45}
    .reco-rats{display:flex;flex-wrap:wrap;gap:6px}
    .rchip{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:8px;background:var(--bg);border:1px solid var(--grid);color:var(--text)}
    html[data-theme="dark"] .rchip{background:var(--grid)}
    .rchip i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:middle}
    .rchip i.bull{background:var(--bull)} .rchip i.bear{background:var(--bear)} .rchip i.neutral{background:var(--neutral)}
    /* FORECAST CONES */
    .cone-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--grid)}
    .cone-row:first-of-type{border-top:none}
    .cone-h{width:34px;font-size:13px;font-weight:800;color:var(--ink);flex:none}
    .cone-bar{position:relative;flex:1;height:22px}
    .cone-axis{position:absolute;top:50%;left:0;right:0;height:2px;background:var(--grid);transform:translateY(-50%)}
    .cone-zero{position:absolute;top:2px;bottom:2px;width:1px;background:var(--muted);opacity:.55}
    .cone-whisk{position:absolute;top:50%;height:2px;transform:translateY(-50%);border-radius:2px}
    .cone-box{position:absolute;top:50%;height:13px;transform:translateY(-50%);border-radius:4px;opacity:.85}
    .cone-box.bull{background:color-mix(in srgb,var(--bull) 60%,var(--card))} .cone-whisk.bull{background:color-mix(in srgb,var(--bull) 35%,var(--grid))}
    .cone-box.bear{background:color-mix(in srgb,var(--bear) 55%,var(--card))} .cone-whisk.bear{background:color-mix(in srgb,var(--bear) 35%,var(--grid))}
    .cone-med{position:absolute;top:50%;width:11px;height:11px;margin-left:-5.5px;transform:translateY(-50%);border-radius:50%;border:2px solid var(--card)}
    .cone-med.bull{background:var(--bull)} .cone-med.bear{background:var(--bear)}
    .cone-pup{width:118px;flex:none;text-align:right;font-size:11.5px;color:var(--muted)}
    .cone-pup b{font-weight:800}
  </style>
  {% set tone_col = {'bull':'var(--blue)','bear':'var(--r3)','neutral':'var(--muted)'} %}
  {% set mcol = tone_col.get(master.tone,'var(--muted)') %}
  <div class="section-title" style="margin-top:6px">⌖ {{ t('Master Signal · command center', '主信号 · 指挥中心') }}</div>
  <div class="cmd">
    <div>
      <div class="cmd-h">{{ t('Strategic regime', '战略格局') }}</div>
      <div class="mg-wrap">
        <svg viewBox="0 0 280 150" width="280" height="150" aria-hidden="true">
          <defs><linearGradient id="mgarc" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--r3)"/><stop offset="42%" stop-color="var(--muted)"/>
            <stop offset="58%" stop-color="var(--muted)"/><stop offset="100%" stop-color="var(--blue)"/>
          </linearGradient></defs>
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="var(--grid)" stroke-width="16" stroke-linecap="round"/>
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="url(#mgarc)" stroke-width="14" stroke-linecap="round" opacity=".92"/>
          <line x1="140" y1="20" x2="140" y2="34" stroke="var(--card)" stroke-width="3"/>
        </svg>
        <div class="mg-needle" style="background:{{ mcol }};transform:rotate({{ (master.gauge - 50) * 1.8 }}deg)"></div>
        <div class="mg-hub" style="background:{{ mcol }}"></div>
        <div class="mg-score" style="color:{{ mcol }}">{{ '%+d'|format(master.score) }}</div>
      </div>
      <div class="mg-ends"><span>{{ t('Risk-off','偏空') }}</span><span>{{ t('Risk-on','偏多') }}</span></div>
      <div class="mg-band" style="color:{{ mcol }}">{{ t(master.band, master.band_zh) }}</div>
      <div class="mg-tally"><b class="bu">{{ master.n_bull }}</b> {{ t('bullish','看多') }} · <b class="be">{{ master.n_bear }}</b> {{ t('bearish','看空') }} · {{ master.n_axes }} {{ t('axes','维度') }}</div>
    </div>
    <div>
      <div class="cmd-r-top">
        <span class="cmd-price">{{ price|money }}</span>
        <span class="{{ 'up' if chg24>=0 else 'down' }}" style="font-weight:700">{{ '%+0.2f'|format(chg24) }}% {{ t('24h','24小时') }}</span>
        {% set cs_c = {'ACCUMULATE':'var(--blue)','RISK-ON':'var(--blue)','DISTRIBUTE':'var(--r3)','RISK-OFF':'var(--r3)','NEUTRAL':'var(--muted)'} %}
        {% set cs_z = {'ACCUMULATE':'累积','RISK-ON':'风险偏好','DISTRIBUTE':'派发','RISK-OFF':'风险规避','NEUTRAL':'中性'} %}
        <span class="cmd-stance" style="color:{{ cs_c.get(composite_state,'var(--muted)') }}">{{ t('Stance','立场') }}: {{ t(composite_state, cs_z.get(composite_state, composite_state)) }}</span>
        {% if verdict and verdict.grade %}{% set vg = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
        <span style="font-size:11px;font-weight:800;color:#fff;background:{{ vg.get(verdict.grade,'var(--muted)') }};padding:3px 9px;border-radius:7px">{{ t(verdict.grade, verdict.grade_zh) }}</span>{% endif %}
      </div>
      <div class="cmd-head">{{ t(master.headline_en, master.headline_zh) }}</div>
      <div class="cmd-drv">
        <div class="col"><div class="ch">▲ {{ t('Pulling constructive','偏多拉力') }}</div>
          {% for d in master.drivers_pos %}<div class="drvchip"><i class="bull"></i><b>{{ t(d.label_en, d.label_zh) }}</b> <span>· {{ t(d.state_en, d.state_zh) }}</span></div>{% else %}<div class="drvchip"><span>{{ t('none meaningful','无明显') }}</span></div>{% endfor %}
        </div>
        <div class="col"><div class="ch">▼ {{ t('Pulling cautionary','偏空拉力') }}</div>
          {% for d in master.drivers_neg %}<div class="drvchip"><i class="bear"></i><b>{{ t(d.label_en, d.label_zh) }}</b> <span>· {{ t(d.state_en, d.state_zh) }}</span></div>{% else %}<div class="drvchip"><span>{{ t('none meaningful','无明显') }}</span></div>{% endfor %}
        </div>
      </div>
      <div class="cmd-act">
        <div class="a"><div class="k">{{ t('Risk Index','风险指数') }}</div><div class="v" style="color:{{ 'var(--blue)' if risk_on else 'var(--r3)' }}">{{ risk_index }}</div><div class="h">{{ td(risk_label) }}</div></div>
        {% if env and env.risk and env.risk.tail is not none %}<div class="a"><div class="k">{{ t('Next-7d drawdown','未来7天回撤') }}</div><div class="v" style="color:var(--r3)">{{ env.risk.avg }}%</div><div class="h">{{ t('worst','极端') }} {{ env.risk.tail }}%</div></div>{% else %}<div class="a"><div class="k">{{ t('Momentum','动量') }}</div><div class="v">{{ momentum }}</div><div class="h">{{ td(momentum_state) }}</div></div>{% endif %}
        <div class="a"><div class="k">{{ t('Model allocation','模型仓位') }}</div><div class="v" style="color:{{ 'var(--blue)' if alloc_pct>=50 else 'var(--r3)' }}">{{ alloc_pct }}%</div><div class="h">{% if sizing %}Kelly {{ sizing.size_pct }}%{% else %}BTC{% endif %}</div></div>
      </div>
    </div>
  </div>
  {# ---------------- THE RECOMMENDATION (the actionable decision) ---------------- #}
  {% if rec and rec.ok %}
  {% set rt = rec.tone %}
  {% set L = rec.levels %}
  <div class="reco">
    <div class="reco-l t-{{ rt }}">
      <div class="reco-k">▶ {{ t('Recommendation · strategic','建议 · 战略') }}</div>
      <div class="reco-act t-{{ rt }}">{{ t(rec.action, rec.action_zh) }}</div>
      <div class="reco-meta">
        <span class="reco-conv {{ rt }} conv-{{ rec.conviction|lower }}">{{ t(rec.conviction ~ ' conviction', rec.conviction ~ ' 信心') }}</span>
        <span>· {{ t(rec.basis_en, rec.basis_zh) }}</span>
        <span>· {{ t(rec.horizon_en, rec.horizon_zh) }}</span>
      </div>
      {% if rec.directional %}<div class="reco-meta" style="margin-top:8px;color:var(--bull)"><b>{{ t('Directional call — measured at this extreme','方向性判断 — 该极值经实测') }}</b></div>
      {% else %}<div class="reco-meta" style="margin-top:8px">{{ t('Direction is a coin-flip here — this is drawdown-managed sizing, not a price call.','此处方向接近抛硬币 — 这是按回撤管理的仓位，而非价格预测。') }}</div>{% endif %}
      <div class="reco-rats" style="margin-top:12px">
        {% for d in rec.rationale %}<span class="rchip"><i class="{{ d.tone }}"></i>{{ t(d.label_en, d.label_zh) }} · {{ t(d.state_en, d.state_zh) }}</span>{% endfor %}
      </div>
    </div>
    <div class="reco-r">
      <div>
        <div class="reco-k">{{ t('Target BTC exposure','目标 BTC 仓位') }}</div>
        <div class="reco-exp-band">{{ rec.exposure_lo }}–{{ rec.exposure_hi }}%</div>
        <div class="exp-track">
          <div class="exp-fill {{ 't-bear' if rt=='bear' else '' }}" style="left:{{ rec.exposure_lo }}%;width:{{ rec.exposure_hi - rec.exposure_lo }}%"></div>
          {% if rec.kelly_pct is not none %}<div class="exp-kelly" style="left:{{ rec.kelly_pct }}%" title="Kelly-sized"></div>{% endif %}
        </div>
        <div class="exp-scale"><span>0% {{ t('cash','现金') }}</span><span>{{ t('Kelly','Kelly') }} {{ rec.kelly_pct }}%</span><span>100% {{ t('BTC','BTC') }}</span></div>
      </div>
      <div class="reco-lvls">
        {% if L.accumulate_lo and L.accumulate_hi %}<div class="lv"><span class="k">{{ t('Accumulate zone','累积区间') }}</span><b>${{ '{:,}'.format(L.accumulate_lo) }}–${{ '{:,}'.format(L.accumulate_hi) }}</b></div>{% endif %}
        {% if L.invalidation %}<div class="lv"><span class="k">{{ t(L.invalid_label_en, L.invalid_label_zh) }}</span><b>${{ '{:,}'.format(L.invalidation) }}</b></div>{% endif %}
        {% if L.downside_90 and L.upside_90 %}<div class="lv" style="grid-column:1/3"><span class="k">{{ t('90-day range (cone p25→p75)','90 天区间（锥体 p25→p75）') }}</span><b class="down">${{ '{:,}'.format(L.downside_90) }}</b> → <b class="up">${{ '{:,}'.format(L.upside_90) }}</b></div>{% endif %}
      </div>
      {% if rec.key_risk_en %}<div class="reco-risk">⚠ {{ t(rec.key_risk_en, rec.key_risk_zh) }}</div>{% endif %}
    </div>
  </div>
  {% endif %}

  {# ---------------- MACRO-REGIME SCORECARD · five-tier composite (DISPLAY-ONLY) ---------------- #}
  {% if regime and regime.ok %}
  {% set rtone = {'bull':'var(--bull)','bull-soft':'var(--blue)','neutral':'var(--muted)','bear-soft':'var(--amber)','bear':'var(--r3)'} %}
  {% set rcol = rtone.get(regime.band_tone, 'var(--muted)') %}
  {% set fl = regime.flags %}
  <style>
  .rgc-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:16px}
  @media(max-width:760px){.rgc-grid{grid-template-columns:1fr}}
  .rgc-meter{height:12px;border-radius:7px;background:linear-gradient(90deg,var(--r3),var(--amber) 38%,var(--muted) 50%,var(--blue) 64%,var(--bull));position:relative;margin:10px 0 4px}
  .rgc-mk{position:absolute;top:-4px;width:4px;height:20px;border-radius:2px;background:var(--ink);box-shadow:0 0 0 2px var(--card)}
  .rgc-tier{display:grid;grid-template-columns:96px 1fr 42px;align-items:center;gap:10px;margin:7px 0;font-size:12.5px}
  .rgc-bar{height:9px;border-radius:5px;background:var(--hair);position:relative;overflow:hidden}
  .rgc-bar > i{position:absolute;top:0;height:100%;border-radius:5px}
  .rgc-fac{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;border:1px solid var(--hair);font-size:11.5px;margin:3px 4px 3px 0}
  .rgc-org{font-size:9px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;font-weight:700}
  .rgc-flag{border:1px solid var(--hair);border-radius:10px;padding:10px 12px;font-size:12px}
  .rgc-cond{display:flex;align-items:center;gap:6px;margin:3px 0;font-size:11.5px}
  .rgc-dot{width:7px;height:7px;border-radius:50%;flex:none}
  </style>
  <div class="section-title" style="margin-top:18px">🧭 {{ t('Macro-Regime Scorecard · five-tier composite', '宏观格局记分卡 · 五层综合') }}</div>
  <div class="card" style="padding:18px 22px">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div style="display:flex;align-items:baseline;gap:12px">
        <div style="font-size:30px;font-weight:800;color:{{ rcol }};font-variant-numeric:tabular-nums">{{ regime.index|round|int }}</div>
        <div>
          <div style="font-weight:700;color:{{ rcol }}">{{ t(regime.band, regime.band_zh) }}{% if regime.thin %} · <span class="faint">{{ t('thin','数据稀疏') }}</span>{% endif %}</div>
          <div class="faint" style="font-size:11.5px">{{ t('0 = strong headwind · 100 = strong tailwind','0 = 强逆风 · 100 = 强顺风') }}</div>
        </div>
      </div>
      <div style="text-align:right">
        <span class="chip" style="border-color:{{ rcol }};color:{{ rcol }}">{{ t('DISPLAY-ONLY · does not size','仅供参考 · 不用于定仓') }}</span>
        {% if regime.mode_lean and regime.mode_lean.ok %}<div class="faint" style="font-size:11.5px;margin-top:5px">{{ t('regime mode','格局模式') }}: <b style="color:var(--ink)">{{ t(regime.mode_lean.chip, regime.mode_lean.chip_zh) }}</b></div>{% endif %}
      </div>
    </div>
    <div class="rgc-meter"><div class="rgc-mk" style="left:calc({{ regime.index }}% - 2px)"></div></div>
    <div class="faint" style="font-size:11.5px">{{ t('Context exposure band (NOT a position):','参考仓位区间（非实际仓位）：') }} <b style="color:var(--ink)">{{ (regime.exposure_display*100)|round|int }}%</b> · {{ regime.n_live }} {{ t('live factors','有效因子') }}</div>

    <div class="rgc-grid" style="margin-top:14px">
      {# ---- per-tier sub-scores ---- #}
      <div>
        <div class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px">{{ t('Transmission tiers','传导层') }}</div>
        {% for tr_ in regime.tiers %}
        {% set nv = tr_.norm if tr_.norm is not none else 0 %}
        {% set tcol = 'var(--bull)' if nv > 0.05 else ('var(--r3)' if nv < -0.05 else 'var(--muted)') %}
        {% set wpct = (nv*50)|abs|round|int %}
        <div class="rgc-tier">
          <span>{{ tr_.tier }} <span class="faint">{{ t(tr_.label, tr_.label) }}</span></span>
          <span class="rgc-bar"><i style="background:{{ tcol }};{{ 'left' if nv>=0 else 'right' }}:50%;width:{{ wpct }}%"></i><i style="left:50%;width:1px;background:var(--muted);opacity:.4"></i></span>
          <span style="text-align:right;color:{{ tcol }};font-variant-numeric:tabular-nums">{{ '%+0.0f'|format(tr_.sub) }}</span>
        </div>
        {% endfor %}
        <div style="margin-top:10px">
          {% for f in regime.factors %}
          {% set fc = 'var(--bull)' if (f.score or 0) > 0 else ('var(--r3)' if (f.score or 0) < 0 else 'var(--muted)') %}
          <span class="rgc-fac" style="{{ 'opacity:.45' if not f.present else '' }}">
            <b style="color:{{ fc }};font-variant-numeric:tabular-nums">{{ ('%+d'|format(f.score)) if f.present else '–' }}</b>
            {{ t(f.label, f.label) }}
            <span class="rgc-org">{{ f.origin }}</span>
          </span>
          {% endfor %}
        </div>
      </div>

      {# ---- confluence tail flags ---- #}
      <div>
        <div class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px">{{ t('Confluence tail flags','合流尾部信号') }}</div>
        <div style="font-size:12.5px;margin-bottom:8px">
          {% if fl and fl.ok %}
          {% if fl.active == 'STAY-AWAY' %}<b style="color:var(--r3)">🔴 {{ t('STAY-AWAY','回避') }}</b>
          {% elif fl.active == 'DOUBLE-DOWN' %}<b style="color:var(--bull)">🟢 {{ t('DOUBLE-DOWN','加倍') }}</b>
          {% else %}<b class="faint">{{ t('No tail flag active','无尾部信号') }}</b>{% endif %}
          <span class="faint">· {{ t('needs ≥5 of 8 (count illustrative on ~5 cycles)','需 ≥5/8（约 5 个周期下计数仅供参考）') }}</span>
          {% endif %}
        </div>
        {% if fl and fl.ok %}
        <div class="rgc-flag" style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between"><b style="color:var(--r3)">{{ t('Stay-away','回避') }}</b><span style="font-variant-numeric:tabular-nums">{{ fl.stay_away.count }}/{{ fl.stay_away.n_available }} · k4/5/6: {{ '✓' if fl.stay_away.fires_at_k[4] else '·' }}{{ '✓' if fl.stay_away.fires_at_k[5] else '·' }}{{ '✓' if fl.stay_away.fires_at_k[6] else '·' }}</span></div>
          {% for c in fl.stay_away.conditions %}<div class="rgc-cond"><span class="rgc-dot" style="background:{{ 'var(--r3)' if c.fired else 'var(--hair)' }}"></span>{{ t(c.label, c.label) }}{% if c.prov %} <span class="faint" style="font-size:10px">({{ t('shared','共享') }})</span>{% endif %}</div>{% endfor %}
        </div>
        <div class="rgc-flag">
          <div style="display:flex;justify-content:space-between"><b style="color:var(--bull)">{{ t('Double-down','加倍') }}</b><span style="font-variant-numeric:tabular-nums">{{ fl.double_down.count }}/{{ fl.double_down.n_available }} · {{ t('prereq','前提') }}: {{ '✓' if fl.double_down.prereq_ok else '✗' }}</span></div>
          {% for c in fl.double_down.conditions %}<div class="rgc-cond"><span class="rgc-dot" style="background:{{ 'var(--bull)' if c.fired else 'var(--hair)' }}"></span>{{ t(c.label, c.label) }}</div>{% endfor %}
          {% if fl.double_down.override %}<div class="faint" style="font-size:11px;margin-top:4px">⛔ {{ t('suppressed by trend filter (Override #1)','受趋势过滤抑制（覆盖规则 #1）') }}</div>{% endif %}
        </div>
        {% if fl.onchain_panel and fl.onchain_panel.ok %}
        <div class="faint" style="font-size:11.5px;margin-top:8px">{{ t('On-chain panel (rolling-percentile):','链上面板（滚动分位）：') }}
          {% if fl.onchain_panel.depressed_co_flash %}<b style="color:var(--bull)">{{ t('cheap · panel-confirmed','便宜 · 面板确认') }}</b>
          {% elif fl.onchain_panel.stretched_co_flash %}<b style="color:var(--r3)">{{ t('rich · panel-confirmed','偏贵 · 面板确认') }}</b>
          {% else %}<b>{{ t('no co-flash','无共振') }}</b>{% endif %}
          <span>({{ fl.onchain_panel.n_depressed }}↓ / {{ fl.onchain_panel.n_stretched }}↑ {{ t('of','/') }} {{ fl.onchain_panel.n }})</span>
        </div>
        {% endif %}
        {% endif %}
      </div>
    </div>
    {% set cl = regime.context_legs %}
    {% if cl %}
    <div id="leverage" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">
      {% if cl.netliq and cl.netliq.ok %}<span class="rgc-fac">🌊 {{ t('Net-liquidity','净流动性') }}: <b>{{ t(cl.netliq.impulse_state, cl.netliq.impulse_state) }}</b></span>{% endif %}
      {% if cl.leverage and cl.leverage.ok %}{% set lev_col = {'high':'var(--red)','elevated':'var(--warn)'} %}{% set _lc = lev_col.get(cl.leverage.cascade_risk,'') %}<span class="rgc-fac" style="{% if _lc %}border-color:{{ _lc }};color:{{ _lc }}{% endif %}">⚡ {{ t('Leverage','杠杆') }}: <b>{{ t(cl.leverage.cascade_risk, cl.leverage.cascade_risk) }}</b>{% if cl.leverage.cascade_risk=='low' and cl.leverage.oi_only_risk and cl.leverage.oi_only_risk != 'low' %} · {{ t('OI','持仓') }} <b style="color:var(--warn)">{{ t(cl.leverage.oi_only_risk, cl.leverage.oi_only_risk) }}</b>{% endif %}{% if cl.leverage.derisk_cap %} · {{ t('cap','上限') }} {{ (cl.leverage.derisk_cap*100)|round|int }}%{% endif %}</span>{% endif %}
      {% if cl.dat and cl.dat.ok and cl.dat.mnav is not none %}<span class="rgc-fac" style="{{ 'border-color:var(--r3)' if cl.dat.state=='discount' else '' }}">🏛 {{ t('MSTR mNAV','MSTR mNAV') }}: <b>{{ '%.2f'|format(cl.dat.mnav) }}×</b> {{ t(cl.dat.state, cl.dat.state) }}</span>{% endif %}
      {% if cl.etf_perfund and cl.etf_perfund.ok and cl.etf_perfund.ibit_share is not none %}<span class="rgc-fac">📊 IBIT {{ (cl.etf_perfund.ibit_share*100)|round|int }}%</span>{% endif %}
    </div>
    {% endif %}
    <div class="sub faint" style="margin-top:12px;font-size:11.5px">{{ t('Transparent fixed weights, no fitting. The composite did NOT beat the hand-tuned allocator out-of-sample (kill-test), so it never sizes — it is an avoidance instrument. ORIGIN: apriori = sign/economics only · context = 2024-onward flow leg (graded forward, never gates).', '透明固定权重，无拟合。该综合在样本外未能跑赢手工调校的配置器（kill-test），故从不用于定仓 — 仅作回避工具。ORIGIN：apriori = 仅基于符号/经济学 · context = 2024 年起的资金流分项（仅前瞻评分，从不作为门槛）。') }}</div>
    {% if regime.ledger and regime.ledger.honesty_note %}<div class="sub faint" style="margin-top:6px;font-size:11.5px">📒 {{ t('Forward ledger','前瞻账本') }}: {{ t(regime.ledger.honesty_note, regime.ledger.honesty_note_zh) }}</div>{% endif %}
  </div>
  {% endif %}

  {# ---------------- FORWARD OUTLOOK CONES (regime-conditioned distribution) ---------------- #}
  {% if cones and cones.ok and cones.horizons %}
  {% set ch = cones.horizons %}
  {% set cvals = [] %}
  {% for k in ['7d','30d','90d'] %}{% set _h = ch.get(k) %}{% if _h and _h.p95 is not none and _h.p5 is not none %}{% set _ = cvals.append(_h.p95|abs) %}{% set _ = cvals.append(_h.p5|abs) %}{% endif %}{% endfor %}
  {% set cscale = (cvals|max) if cvals else 50 %}
  {% macro cpct(v) %}{{ [[(50 + 50*v/cscale), 2]|max, 98]|min }}{% endmacro %}
  {# does any horizon fall back off the live regime cell, or run thin? surface it honestly #}
  {% set degraded = [] %}
  {% for k in ['7d','30d','90d'] %}{% set _h = ch.get(k) %}{% if _h and (_h.thin or (_h.cond and _h.cond != cones.regime)) %}{% set _ = degraded.append(k) %}{% endif %}{% endfor %}
  <div class="card" style="margin-top:14px;padding:18px 22px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <h3 style="margin:0">{{ t('Forward outlook · regime-conditioned cones','前瞻展望 · 按格局的收益锥') }}</h3>
      <span class="faint" style="font-size:12px">{{ t('empirical, given regime:','基于历史，当前格局：') }} <b style="color:var(--ink)">{{ cones.regime or '—' }}</b></span>
    </div>
    <div style="margin-top:10px">
    {% for k in ['7d','30d','90d'] %}{% set h = ch.get(k) %}{% if h and h.p50 is not none %}
      {% set ht = 'bull' if h.p50 >= 0 else 'bear' %}
      <div class="cone-row" {% if h.thin %}style="opacity:.6"{% endif %}>
        <span class="cone-h">{{ k }}</span>
        <div class="cone-bar">
          <div class="cone-axis"></div>
          <div class="cone-zero" style="left:{{ cpct(0) }}%"></div>
          <div class="cone-whisk {{ ht }}" style="left:{{ cpct(h.p5) }}%;width:{{ cpct(h.p95)|float - cpct(h.p5)|float }}%"></div>
          <div class="cone-box {{ ht }}" style="left:{{ cpct(h.p25) }}%;width:{{ cpct(h.p75)|float - cpct(h.p25)|float }}%"></div>
          <div class="cone-med {{ ht }}" style="left:{{ cpct(h.p50) }}%"></div>
        </div>
        <span class="cone-pup">P↑ <b style="color:{{ 'var(--muted)' if h.thin else ('var(--bull)' if h.p_up>=h.base_up else 'var(--bear)') }}">{{ (h.p_up*100)|round|int }}%</b> <span class="faint">/ {{ (h.base_up*100)|round|int }}%{% if h.cond and h.cond != cones.regime %} · {{ h.cond }}{% endif %}{% if h.thin %} · {{ t('thin','样本少') }} n={{ h.n }}{% endif %}</span></span>
      </div>
    {% endif %}{% endfor %}
    </div>
    <div class="exp-scale" style="margin-top:2px"><span>−{{ cscale|round|int }}%</span><span>0</span><span>+{{ cscale|round|int }}%</span></div>
    <div class="sub faint" style="margin-top:10px;font-size:12px">{{ t('Each bar is the EMPIRICAL forward-return distribution on days that shared the current regime — box = p25→p75, whiskers p5→p95, dot = median, P↑ = hit-rate vs the all-history base rate. Zero fitted weights; it shows the realized spread of outcomes, not a point forecast. Drawdown leads tactically; direction is only a call at the measured extremes.', '每根柱为历史上处于当前格局之日的实测前瞻收益分布 — 方框 = p25→p75，须线 p5→p95，圆点 = 中位数，P↑ = 上涨胜率对比全样本基准。无拟合权重；展示的是结果的实测分布，而非点预测。战术上以回撤为先；方向仅在实测极值处才作判断。') }}</div>
  </div>
  {% endif %}

  <div class="sub faint" style="margin:8px 4px 4px;font-size:12px">{{ t('A transparent weighted synthesis of every axis below (oriented by its MEASURED calibration sign; + = constructive). The score is the STRATEGIC regime tilt — short-horizon direction is a coin-flip, so the tactical read is the forward-drawdown card. Nothing here is a new alpha claim; it re-presents the gate-passed signals.', '对下方各维度的透明加权综合（按其实测校准方向定向；+ = 偏多）。该分数为战略格局倾向 — 近端方向接近抛硬币，故战术上以前瞻回撤卡片为准。此处并非新的阿尔法主张，仅重新呈现已通过校验的信号。') }}</div>

  <!-- ===================== SIGNAL BOARD ===================== -->
  <div class="section-title">{{ t('Signal Board · every axis at a glance', '信号面板 · 一览全维度') }}</div>
  <div class="board">
    {% for grp in master.board %}
    <div class="bgrp">
      <h4>{{ t(grp.group_en, grp.group_zh) }}</h4>
      {% for r in grp.rows %}
      <div class="brow">
        <span class="dot {{ r.tone }}"></span>
        <span class="lab">{{ t(r.label_en, r.label_zh) }}</span>
        {% if r.grade %}<span class="gr gr-{{ r.grade }}">{{ r.grade }}</span>{% else %}<span></span>{% endif %}
        <span class="st">{{ t(r.state_en, r.state_zh) }}</span>
        {% if r.spark %}<svg class="spk {{ r.tone }}" viewBox="0 0 100 26" preserveAspectRatio="none"><polyline points="{{ r.spark }}"/></svg>{% else %}<span></span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="sub faint" style="margin:8px 4px 4px;font-size:12px">{{ t('Grade = the MEASURED forward record (data/vector/calibration.json): CONFIRMED holds in both halves of history · DIRECTIONAL one half weak · EXTREMES only the tails pay · CONTEXT not predictive · NEW = a mastermind-upgrade axis still accruing its forward record. Sparklines show each axis over the last ~60 days.', '评级 = 实测前瞻记录（data/vector/calibration.json）：CONFIRMED 在前后两半段均成立 · DIRECTIONAL 有一半较弱 · EXTREMES 仅尾部有效 · CONTEXT 不具预测性 · NEW = 新增的升级维度，仍在积累前瞻记录。迷你图为各维度最近约 60 天走势。') }}</div>
  {% endif %}

  <!-- ===================== IMPULSE RADAR (forward pressure) ===================== -->
  {% set ir = regime.context_legs.impulse_radar if regime.context_legs else none %}
  {% if ir and ir.ok %}
  {% set lad_col = {'quiet':'var(--muted)','coiled':'var(--blue)','warning':'var(--warn)','trigger':'var(--red)'} %}
  {% set lad_lab = {'quiet':'Quiet','coiled':'Coiled · loading','warning':'WARNING','trigger':'TRIGGER'} %}
  {% set lad_zh = {'quiet':'平静','coiled':'蓄势','warning':'警告','trigger':'触发'} %}
  <div class="card" id="impulse" style="margin-bottom:18px">
    <h2>{{ t('Impulse Radar · forward pressure','脉冲雷达 · 前瞻压力') }}</h2>
    <div class="sub" style="margin-top:2px">{{ t('Adversarially-verified LEADING precursor crosses only — escalates on a cross and DECAYS to quiet, distinct from the standing regime read. Context legs alone cap at “coiled”; only an act-tier cross reaches warning/trigger. Display-only.','仅基于经对抗验证的领先前兆突破 — 突破时升级、随后衰减回平静，独立于当前regime读数。背景因子最高只到“蓄势”；仅行动级突破才达到警告/触发。仅供展示。') }}</div>
    {% if ir.staleness and ir.staleness.stale %}
    <div style="margin-top:10px;padding:8px 12px;border-radius:8px;background:var(--bear-soft);border:1px solid var(--bear);color:var(--bear);font-weight:600;font-size:12.5px">⚠ {{ t('Intraday data STALE — freshest hourly candle','日内数据过期 — 最新小时K线') }} {{ ir.staleness.intraday_asof }} ({{ t('daily close','日线收盘') }} {{ ir.staleness.daily_asof }}). {{ t('An intraday flush could go unseen — check the hourly feed.','日内闪跌可能无法被捕捉 — 请检查小时数据源。') }}</div>
    {% endif %}
    <div class="grid cols-2" style="margin-top:12px">
      {% for g in [ir.down, ir.up] %}
      {% set gnm = 'Down' if loop.first else 'Up' %}{% set gnm_zh = '下行' if loop.first else '上行' %}
      <div style="border:1px solid var(--grid);border-radius:12px;padding:13px 15px;background:var(--bg)">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <b style="font-size:13px;color:var(--ink)">{{ t(gnm,gnm_zh) }}-{{ t('impulse','脉冲') }}</b>
          <span style="font-weight:800;font-size:11.5px;padding:2px 9px;border-radius:7px;color:#fff;background:{{ lad_col.get(g.ladder,'var(--muted)') }}">{{ t(lad_lab.get(g.ladder,g.ladder), lad_zh.get(g.ladder,g.ladder)) }}</span>
        </div>
        <div style="margin-top:9px;height:9px;border-radius:6px;background:var(--grid);overflow:hidden"><div style="height:100%;width:{{ g.score }}%;background:{{ lad_col.get(g.ladder,'var(--muted)') }}"></div></div>
        <div class="faint" style="font-size:11px;margin-top:4px">{{ t('pressure','压力') }} {{ g.score }}/100{% if not g.act_live %} · {{ t('no act-tier cross (context only)','无行动级突破（仅背景）') }}{% endif %}</div>
        <div style="margin-top:9px;display:flex;flex-direction:column;gap:3px">
          {% for l in g.legs if l.points > 0 %}
          <div style="display:flex;justify-content:space-between;font-size:11.5px">
            <span style="color:{{ 'var(--ink)' if l.tier=='act' else 'var(--muted)' }}">{{ '●' if l.tier=='act' else '○' }} {{ t(l.label, l.label) }}</span>
            <span class="faint">{{ l.points }}{% if l.fired_today %} · {{ t('fresh','新触发') }}{% elif l.days_since is not none %} · {{ l.days_since }}d{% endif %}</span>
          </div>
          {% else %}
          <div class="faint" style="font-size:11px">{{ t('no live legs','无活跃因子') }}</div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px">
      {% if ir.fuel_gauge %}<span class="rgc-fac" style="{{ 'border-color:var(--warn);color:var(--warn)' if ir.fuel_gauge.lit else '' }}">🔋 {{ t('Fuel','燃料') }}: OI {{ (ir.fuel_gauge.oi_pctile*100)|round|int if ir.fuel_gauge.oi_pctile is not none else '—' }}%ile × vov {{ (ir.fuel_gauge.vov_pctile*100)|round|int if ir.fuel_gauge.vov_pctile is not none else '—' }}%ile{% if ir.fuel_gauge.lit %} · {{ t('loading','蓄能') }}{% endif %}</span>{% endif %}
      {% if ir.cascade and ir.cascade.oi_only_risk and ir.cascade.oi_only_risk != 'low' %}<span class="rgc-fac" style="border-color:var(--warn);color:var(--warn)">⚡ {{ t('OI-only de-risk','仅持仓减仓') }}: <b>{{ t(ir.cascade.oi_only_risk, ir.cascade.oi_only_risk) }}</b></span>{% endif %}
    </div>
    <div class="sub faint" style="margin-top:10px;font-size:11px">{{ t('Honesty: none of the three act-tier legs (DVOL jolt, SOPR spike, SOPR capitulation) led the 2026-06-24 options-calm flush — this is an early de-risk/pressure read, not a top-caller. UP fires only as a reactive wash-out bounce, never a pre-emptive bottom.','诚实说明：三个行动级因子（DVOL 跳升、SOPR 骤升、SOPR 投降）均未领先 2026-06-24 的期权平静式下跌 — 这是早期减仓/压力读数，而非顶部预言。上行仅作为反应式洗盘反弹触发，绝非提前抄底。') }}</div>
    {% set _act = (ir.down.legs + ir.up.legs) | selectattr('tier','equalto','act') | list %}
    {% set _dem = _act | selectattr('demoted') | list %}
    <div class="sub faint" style="margin-top:5px;font-size:11px">🛡 {{ t('Falsifier','证伪器') }}: <b style="color:{{ 'var(--bear)' if _dem else 'var(--blue)' }}">{{ _act|length - _dem|length }}/{{ _act|length }}</b> {{ t('act legs still leading','行动级因子仍领先') }} — {{ t('each re-validated leak-free every build; a leg that stops leading (holdout lift below floor) is auto-demoted to zero points (CI-gated).','每次构建均无前视重新验证；停止领先（留出样本 lift 低于下限）的因子自动降级为零分（CI 门控）。') }}{% if _dem %} · <b style="color:var(--bear)">{{ _dem|length }} {{ t('DEMOTED','已降级') }}</b>{% endif %}</div>
  </div>
  {% endif %}

  <!-- ===================== MARKET STATE HERO ===================== -->
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Market State · Long term', '市场状态 · 长期') }}</h2>
      <div class="hero-state">
        <span class="hero-dot {{ 'dot-on' if risk_on else 'dot-off' }}"></span>{{ t('Risk', '风险') }}
        <span class="{{ 'on' if risk_on else 'off' }}">{{ td(risk_word) }}</span>
      </div>
      <div class="hero-meta">
        <span class="{{ 'up' if risk_on else 'down' }}">{{ t('Risk Index', '风险指数') }} {{ risk_index }}</span>
        · <b>{{ td(risk_label) }}</b>
        · <span class="tip" title="Momentum vote-ensemble in [-1,+1]; ±0.5 = trigger · 动量投票集成，区间 [-1,+1]；±0.5 = 触发">{{ t('Momentum', '动量') }} {{ momentum }} ({{ td(momentum_state) }})</span>
      </div>
      {% set cs_color = {'ACCUMULATE':'var(--blue)','RISK-ON':'var(--blue)','DISTRIBUTE':'var(--r3)','RISK-OFF':'var(--r3)','NEUTRAL':'var(--muted)'} %}
      {% set cs_zh = {'ACCUMULATE':'累积','RISK-ON':'风险偏好','DISTRIBUTE':'派发','RISK-OFF':'风险规避','NEUTRAL':'中性'} %}
      <div class="hero-meta" style="margin-top:6px;font-size:17px">
        <b style="color:{{ cs_color.get(composite_state,'var(--muted)') }}">{{ t('Stance', '立场') }}: {{ t(composite_state, cs_zh.get(composite_state, composite_state)) }}</b>
        {% if composite_context == 'crowded_short' %}<span class="tip" title="Funding z below -1 = crowded shorts. A capitulation CONTEXT confirmer — surfaced but deliberately NOT wired into the allocation (no pre-2021 history to validate it). 资金费率 z 低于 -1 = 空头拥挤；投降式背景确认，仅展示不参与仓位。" style="font-size:12.5px;font-weight:600;color:var(--blue);border:1px solid var(--blue);border-radius:999px;padding:1px 9px;margin-left:8px">⚠ {{ t('Crowded shorts · capitulation context', '空头拥挤 · 投降式背景') }}</span>{% elif composite_context == 'froth' %}<span class="tip" title="CME spec net-long z above 1.5 = crowded longs = froth. A distribution CONTEXT confirmer (display-only). CME 投机净多 z 高于 1.5 = 多头拥挤 = 过热；派发背景确认，仅展示。" style="font-size:12.5px;font-weight:600;color:var(--r3);border:1px solid var(--r3);border-radius:999px;padding:1px 9px;margin-left:8px">🔥 {{ t('Froth · crowded longs', '过热 · 多头拥挤') }}</span>{% endif %}
        <span class="faint" style="font-size:13px"> · {{ t('valuation + extremes resolve the risk U-shape into a direction', '估值 + 极值将风险 U 形解析为方向') }}</span>
      </div>

      {# ---- multi-timeframe CONFLUENCE VERDICT (reconciles short bounce vs bigger picture) ---- #}
      {% if verdict and verdict.headline %}
      {% set vg = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
      {% set tfc = {'up':'var(--blue)','down':'var(--r3)','flat':'var(--grid)'} %}
      <div style="margin-top:14px;padding:13px 15px;border:1px solid var(--grid);border-radius:12px;background:var(--bg)">
        <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
          <span style="font-weight:800;font-size:12px;letter-spacing:.04em;padding:3px 9px;border-radius:7px;color:#fff;background:{{ vg.get(verdict.grade,'var(--muted)') }}">{{ t(verdict.grade, verdict.grade_zh) }}</span>
          <b style="font-size:16px;color:var(--ink)">{{ t(verdict.headline, verdict.headline_zh) }}</b>
        </div>
        <div class="sub" style="margin-top:7px">{{ t(verdict.sub, verdict.sub_zh) }}</div>
        <div style="display:flex;align-items:center;gap:7px;margin-top:10px;flex-wrap:wrap">
          <span class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.04em">{{ t('Trend by timeframe','各周期趋势') }}</span>
          {% set tlab = {'D':'D','3D':'3D','W':'W','2W':'2W','ME':'M'} %}
          {% for r in mtf_rows %}
          <span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--muted)"><i style="width:9px;height:9px;border-radius:50%;background:{{ tfc.get(r.trend,'var(--grid)') }}"></i>{{ tlab.get(r.key, r.key) }}</span>
          {% endfor %}
          <span class="faint" style="font-size:11px"> · {{ t('short','短') }} {{ '↑' if verdict.short_sign>0 else ('↓' if verdict.short_sign<0 else '→') }} · {{ t('mid','中') }} {{ '↑' if verdict.mid_sign>0 else ('↓' if verdict.mid_sign<0 else '→') }} · {{ t('long','长') }} {{ '↑' if verdict.long_sign>0 else ('↓' if verdict.long_sign<0 else '→') }}</span>
        </div>
      </div>{% endif %}

      <!-- cycle slider -->
      <div class="slider">
        <div class="track"><div class="knob" style="left:{{ cycle_pos }}%"></div></div>
        <div class="labels">
          {% for s in ['Defensive','Fragile','Recovery','Expansion'] %}
          <span class="{{ 'cur' if s==cycle_stage else '' }}">{{ td(s) }}</span>
          {% endfor %}
        </div>
      </div>

      <!-- momentum / volatility / flow -->
      <div class="metric-row">
        <div class="m"><div class="k">{{ t('Momentum', '动量') }}</div><div class="v">{{ td(mom_strength) }}</div></div>
        <div class="m"><div class="k">{{ t('Volatility', '波动率') }}</div><div class="v">{{ td(vol_state) }}</div>
          <div class="sub">{{ td(vol_side) }}</div></div>
        <div class="m"><div class="k">{{ t('Flow', '资金流') }}</div><div class="v">{{ td(flow_state) }}</div></div>
      </div>
    </div>

    <!-- allocation (next to the long-term scorecard) -->
    <div class="card">
      <h2>{{ t('BTC Allocation · Optimal strategy', 'BTC 仓位 · 最优策略') }}</h2>
      <div class="allocbar">
        {% if alloc_pct > 0 %}<div class="btc" style="width:{{ alloc_pct }}%">{{ alloc_pct }}% BTC</div>{% endif %}
        {% if alloc_pct < 100 %}<div class="cash" style="width:{{ 100-alloc_pct }}%">{{ 100-alloc_pct }}% {{ t('Cash', '现金') }}</div>{% endif %}
      </div>
      <div class="sub" style="margin-top:10px">{{ t('Market mode:', '市场模式：') }}
        <span class="chip {{ 'chip-strategic' if market_mode=='Strategic' else 'chip-tactical' }}">{{ td(market_mode) }}</span>
        · {{ t('BTC vs Alts leader:', 'BTC vs 山寨币 领先：') }} <b>{{ td(alt_leader) }}</b></div>
      {% if sizing %}
      <div class="mini" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:11px"><div class="lab" style="border:none;padding-top:0"><span>{{ t('Risk-budgeted Kelly size','风险预算 Kelly 仓位') }} <span class="faint" style="font-size:11px">({{ '½' if sizing.kelly_frac==0.5 else (sizing.kelly_frac|string) }}-Kelly, {{ sizing.dd_budget }}% {{ t('DD budget','回撤预算') }})</span></span><span><b style="font-size:17px;color:{{ 'var(--blue)' if sizing.size_pct>=40 else 'var(--r3)' }}">{{ sizing.size_pct }}%</b></span></div></div>
      <div class="sub faint" style="margin-top:4px;font-size:12px">{{ t('Half-Kelly on the','半 Kelly 基于') }} <b>{{ '%+0.0f'|format(sizing.edge_90) }}%/90d</b> {{ t('regime edge (','格局优势（') }}{{ td(sizing.stance|capitalize) }}{{ t(', σ','，σ') }} {{ sizing.vol_90 }}%), {% if sizing.binding=='tail' %}{{ t('capped by the','受限于') }} {{ sizing.tail_90 }}% {{ t('worst-case 90d dip','90 天极端回撤') }}{% else %}{{ t('edge-limited (the tail cap would allow','受优势限制（尾部上限允许') }} {{ (sizing.f_tail*100)|round|int }}%){% endif %}. {{ t('Direction is a coin-flip, so the edge is the regime, not the week.','方向接近抛硬币，故优势来自格局而非本周。') }}</div>
      {% endif %}
      {% if catalyst %}
      <div class="sub" style="margin-top:8px;font-size:12px;color:{{ 'var(--amber)' if catalyst.imminent else 'var(--muted)' }}">{% if catalyst.imminent %}⚠ {% endif %}{{ t('Next macro binary:','下一宏观二元事件：') }} <b>{{ td(catalyst.next_event) }}</b> {{ t('in','还有') }} {{ catalyst.days }} {{ t('day' if catalyst.days==1 else 'days','天') }} ({{ catalyst.next_date }}){% if catalyst.imminent %} — {{ t('expect a vol jump; the Kelly size models neither the gap nor the vol crush, so don\'t size up into it.','预期波动跳升；Kelly 仓位既不计入跳空也不计入波动收敛，故勿在此前加仓。') }}{% endif %}</div>
      {% endif %}
      <a href="vector_allocation.html" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px;padding:11px 14px;border:1px solid var(--grid);border-radius:11px;background:var(--bg);text-decoration:none;color:var(--ink);font-weight:600;font-size:13.5px">
        <span>◎ {{ t('Full allocation strategy — BTC · ETH · alts · cash', '完整仓位策略 — BTC · ETH · 山寨 · 现金') }}</span>
        <span style="color:var(--blue);font-size:16px">→</span>
      </a>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('The deep-dive page sizes ETH & altcoins by where we are in the alt-cycle (ETH/BTC ratio, alt-season).', '深度页面按所处山寨周期（ETH/BTC 比率、山寨季）配置 ETH 与山寨币。') }}</div>
    </div>
  </div>

  {# ---- conviction card macro (shared by mid & short so they are byte-identical "same format") ---- #}
  {% set gcol = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
  {% set gcolor = gcol.get(verdict.grade,'var(--muted)') %}
  {% macro convcard(c, R, title_en, title_zh, vsign, grade, grade_zh, gcolor) %}
    {% set dword = 'bull' if c.dir>0 else 'bear' %}
    {% set dottint = 'var(--muted)' if (c.state=='TOSS-UP' or c.lean<=3) else ('var(--blue)' if (c.state=='EDGE' and c.dir>0) else ('var(--r3)' if (c.state=='EDGE' and c.dir<0) else ('color-mix(in srgb,var(--blue) 58%,var(--grid))' if c.dir>0 else 'color-mix(in srgb,var(--r3) 60%,var(--grid))'))) %}
    <div class="conv-head">
      <span style="font-size:14px;font-weight:700;color:var(--ink)">{{ t(title_en, title_zh) }}</span>
      <span class="conv-n">{% if R and R.tail is not none %}n={{ '{:,}'.format(R.n) }}{% elif c.n %}n={{ '{:,}'.format(c.n) }}{% else %}—{% endif %}</span>
    </div>
    {% if R and R.tail is not none %}
    {# ---------- PRIMARY: forward drawdown / risk (the CONFIRMED quantity) ---------- #}
    {% set rwc = {'CALM':'var(--muted)','ELEVATED':'var(--r3)','HIGH':'color-mix(in srgb,var(--r3) 80%,var(--ink))','EXTREME':'color-mix(in srgb,var(--r3) 80%,var(--ink))'} %}
    <div class="risk-word" style="color:{{ rwc.get(R.word_en,'var(--r3)') }}">{{ t(R.head_en, R.head_zh) }}
      {%- if R.contrarian %} <span class="conv-tag">{{ t('contrarian zone','逆势区') }}</span>{% endif %}
      {%- if R.thin %} <span class="conv-tag">{{ t('thin sample','样本偏少') }}</span>{% endif %}
    </div>
    <div class="risk-nums">{{ t('Typical dip','常见回撤') }} <b>{{ R.avg }}%</b> <span class="faint">({{ t('calm','平静') }} {{ R.calm_avg }}%)</span> · {{ t('worst-case','极端') }} <b{% if R.thin %} class="faint"{% endif %}>{{ R.tail }}%</b> <span class="faint">({{ t('calm','平静') }} {{ R.calm_tail }}%)</span></div>
    {% set scale = (1.25 * ([(R.tail|abs),(R.calm_tail|abs)]|max)) %}
    {% set scale = scale if scale > 0 else 20 %}
    <div class="ddrail">
      <div class="ddrail-bar">
        <div class="dd-down" style="left:0;width:70%"></div>
        <div class="dd-up" style="left:70%;width:30%"></div>
        <div class="dd-mk dd-calm" style="left:{{ (70 - 70*(R.calm_tail|abs)/scale)|round(1) }}%" title="calm baseline"></div>
        <div class="dd-mk dd-typ" style="left:{{ (70 - 70*(R.avg|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-tail{% if R.thin %} thin{% endif %}" style="left:{{ (70 - 70*(R.tail|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-uptick" style="left:{{ (70 + 30*R.up/scale)|round(1) }}%"></div>
        <div class="dd-now" style="left:70%"></div>
      </div>
      <div class="ddrail-lab"><span class="r3b">{{ R.tail }}%</span><span class="mut">{{ R.avg }}%</span><span class="now">{{ t('now','当前') }}</span><span class="upf">+{{ R.up }}%</span></div>
    </div>
    {# ---------- SECONDARY: demoted direction strip (the honest coin-flip) ---------- #}
    <div class="dir-strip">
      <span class="dir-chip">{% if c.state=='TOSS-UP' %}{{ t('Toss-up','势均力敌') }}{% elif c.state=='LEAN' %}{{ t('Lean ' ~ dword, '倾向看多' if c.dir>0 else '倾向看空') }}{% else %}{{ t('Edge ' ~ dword, '看多优势' if c.dir>0 else '看空优势') }}{% endif %}</span>
      <div class="mini-needle"><div class="mn-dead"></div><div class="mn-tick"></div><div class="mn-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <span class="dir-num">{{ c.p_bear }}/{{ c.p_bull }}</span>
    </div>
    <div class="conv-sub">{{ t('direction is a coin-flip — drawdown above is the predicted quantity, direction is not','方向接近抛硬币 — 上方回撤才是可预测量，方向不是') }}</div>
    <div class="conv-why">{{ t(R.main_en, R.main_zh) }}</div>
    <div class="conv-why faint">{{ t(R.guard_en, R.guard_zh) }}</div>
    {% else %}
    {# ---------- fallback: conviction-led (no calibrated risk) ---------- #}
    {% set wcls = 'cw-toss' if c.state=='TOSS-UP' else (('cw-lean ' if c.state=='LEAN' else 'cw-edge ') ~ dword) %}
    <div class="cw {{ wcls }}">{% if c.state=='TOSS-UP' %}{{ t('Toss-up','势均力敌') }}{% elif c.state=='LEAN' %}{{ t('Lean ' ~ dword, '倾向看多' if c.dir>0 else '倾向看空') }}{% else %}{{ t('Edge ' ~ dword, '看多优势' if c.dir>0 else '看空优势') }}{% endif %}</div>
    <div class="needle"><div class="needle-axis"><div class="needle-dead"></div><div class="needle-tick"></div><div class="needle-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <div class="needle-ends"><span>{{ t('Bear','看空') }}</span><span class="needle-num">{{ c.p_bear }}% / {{ c.p_bull }}%</span><span>{{ t('Bull','看多') }}</span></div></div>
    <div class="conv-why">{{ t(c.why_en, c.why_zh) }}</div>
    {% endif %}
    <div class="conv-defer" style="color:{{ gcolor }}">↳ {{ t('Defers to','服从') }} <b>{{ t(grade, grade_zh) }}</b> — {{ t('the near-term texture under that bigger-picture call','大局判断之下的近端纹理') }}</div>
  {% endmacro %}

  {# AI Daily Brief — the single in-page doorway to the cross-asset LLM synthesis
     (aibrief.html). Replaces the old inline AI Master Brief (Bitcoin) card. #}
  <a class="card aibrief-card" href="aibrief.html">
    <span class="abc-ic">🧠</span>
    <span class="abc-mid">
      <span class="abc-tit">{{ t('AI Daily Brief · Bitcoin & cross-asset synthesis', 'AI 每日简报 · 比特币与跨资产综合') }}</span>
      <span class="abc-sub muted sm">{{ t('AI reads the Bitcoin vector and the macro-liquidity backdrop in one place — cycle, valuation, leverage, on-chain and ETF flows, and what to watch. Research context only, never a signal.', 'AI 在一处解读比特币向量与宏观流动性背景 — 周期、估值、杠杆、链上与 ETF 资金流，及后续关注。仅供研究参考，绝非交易信号。') }}</span>
    </span>
    <span class="abc-go">→</span>
  </a>

  <!-- ===================== MID & SHORT TERM (side by side, same format) ===================== -->
  <div class="section-title">{{ t('Mid term & Short term · near-term drawdown risk', '中期与短期 · 近端回撤风险') }}</div>
  <div class="grid cols-eq">

    <!-- mid term · 7-day outlook (risk-led) -->
    <div class="card">{{ convcard(env.conv, env.risk, 'Mid term · 7-day outlook', '中期 · 7 天展望', verdict.mid_sign, verdict.grade, verdict.grade_zh, gcolor) }}</div>

    <!-- short term · 3-day outlook (risk-led) + ATR scenario levels -->
    <div class="card">
      {{ convcard(scn.conv, scn.risk, 'Short term · 3-day outlook', '短期 · 3 天展望', verdict.short_sign, verdict.grade, verdict.grade_zh, gcolor) }}
      <div style="border-top:1px solid var(--grid);margin-top:14px;padding-top:12px;display:flex;gap:18px;flex-wrap:wrap">
        <div style="flex:1;min-width:150px">
          <div class="sub" style="font-weight:700;color:var(--ink)">{{ t('If it resolves down', '若向下') }}</div>
          <div class="scn-line"><span class="mut">{{ t('Target', '目标') }}</span><b class="down">{{ scn.bear_target|money }} → {{ scn.bear_target2|money }}</b></div>
          <div class="scn-line"><span class="mut">{{ t('Invalidation', '失效位') }}</span><b>{{ scn.bear_invalid|money }}</b></div>
        </div>
        <div style="flex:1;min-width:150px;border-left:1px solid var(--grid);padding-left:18px">
          <div class="sub" style="font-weight:700;color:var(--ink)">{{ t('If it resolves up', '若向上') }}</div>
          <div class="scn-line"><span class="mut">{{ t('Target', '目标') }}</span><b class="up">{{ scn.bull_target|money }} → {{ scn.bull_target2|money }}</b></div>
          <div class="scn-line"><span class="mut">{{ t('Invalidation', '失效位') }}</span><b>{{ scn.bull_invalid|money }}</b></div>
        </div>
      </div>
      <div class="sub" style="margin-top:10px">{{ t('ATR bands ×', 'ATR 带宽 ×') }}{{ scn.vscale }} {{ t('by forward vol — trade the level, not the bias; direction itself is a coin-flip.', '按前瞻波动率 — 交易关键位而非方向；方向本身接近抛硬币。') }}</div>
    </div>

  </div>

  <!-- ===================== RISK INDEX vs STRATEGY ===================== -->
  <div class="section-title">{{ t('Risk Index vs Strategy · backtested', '风险指数 vs 策略 · 已回测') }}</div>
  <div class="card">
    <h3>{{ t('BTC price, Risk Index & allocation', 'BTC 价格、风险指数与仓位') }} <span class="faint" style="font-size:13px;font-weight:600" id="vrc-variant-label">{{ t('· Optimal variant','· 最优变体') }}</span></h3>
    <div id="vec-risk-chart" class="vchart-wrap" style="--vchart-h:500px"><div class="sub faint" style="padding:18px 0">{{ t('Loading interactive chart…','加载交互图表…') }}</div></div>
    <div class="sub" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;font-size:12px">
      <span><span style="display:inline-block;width:14px;height:2px;background:var(--faint);vertical-align:3px;margin-right:5px"></span>{{ t('BTC price (log)', 'BTC 价格（对数）') }}</span>
      <span><span style="display:inline-block;width:14px;height:2px;background:var(--blue);vertical-align:3px;margin-right:5px"></span>{{ t('Strategy equity', '策略净值') }}</span>
      <span style="color:var(--bull);font-weight:600">▲ {{ t('buy / add', '买入 / 加仓') }}</span>
      <span style="color:var(--bear);font-weight:600">▼ {{ t('sell / trim', '卖出 / 减仓') }}</span>
      <span>{{ t('lower panes:', '下方面板：') }} {{ t('Risk Index (blue<25 / red≥25)', '风险指数（蓝<25 / 红≥25）') }} · {{ t('allocation %', '仓位 %') }}</span>
    </div>
    <div class="score" style="margin-top:14px" id="vrc-score"
         data-cards='{{ {"conservative":cards.conservative,"moderate":cards.moderate,"aggressive":cards.aggressive,"optimal":cards.optimal}|tojson }}'>
      <div class="s"><div class="k">CAGR</div><div class="v" data-m="cagr">{{ cards.optimal.cagr }}%</div><div class="h">HODL {{ cards.optimal.hodl_cagr }}%</div></div>
      <div class="s"><div class="k">Sharpe</div><div class="v" data-m="sharpe">{{ cards.optimal.sharpe }}</div><div class="h">HODL {{ cards.optimal.hodl_sharpe }}</div></div>
      <div class="s"><div class="k">{{ t('Max Drawdown', '最大回撤') }}</div><div class="v" data-m="maxdd">{{ cards.optimal.maxdd }}%</div><div class="h">HODL {{ cards.optimal.hodl_maxdd }}%</div></div>
      <div class="s"><div class="k">{{ t('Time in market', '在场时间') }}</div><div class="v" data-m="in_market">{{ cards.optimal.in_market }}%</div><div class="h" data-m="x_hodl">{{ cards.optimal.x_hodl }}× HODL</div></div>
    </div>
    <div class="sub" style="margin-top:10px">{{ t('Interactive: switch variant / timeframe / log·linear above, hover for point-in-time values. Long-only, acts next-day on the signal (no look-ahead). Every variant beats HODL\'s Sharpe', '可交互：上方切换变体 / 周期 / 对数·线性，悬停查看实时数值。仅做多，信号次日生效（无前视）。每个变体的 Sharpe 均优于 HODL') }} ({{ cards.optimal.hodl_sharpe }}){{ t(' and cuts max drawdown.', '，且降低了最大回撤。') }}</div>
  </div>

  <!-- ===================== CYCLE TIME MACHINE ===================== -->
  <div class="section-title">{{ t('Cycle Time Machine · scrub 10+ years of point-in-time history', '周期时光机 · 回溯十余年实时历史') }}</div>
  <div class="card" id="vtm" data-timeline="vector_timeline.json">
    <div class="vtm-wrap">
      <canvas id="vtm-canvas" class="vtm-canvas"></canvas>
      <input id="vtm-range" class="vtm-range" type="range" min="0" max="0" value="0" aria-label="Scrub BTC cycle history">
    </div>
    <div class="vtm-legend">
      <span><i style="background:#3b6fe0"></i>{{ t('Accumulation','吸筹') }}</span>
      <span><i style="background:#1f9d57"></i>{{ t('Markup','拉升') }}</span>
      <span><i style="background:#e0a43a"></i>{{ t('Recovery','修复') }}</span>
      <span><i style="background:#cf4f4f"></i>{{ t('Markdown','派发下行') }}</span>
    </div>
    <div class="vtm-controls">
      <button class="vtm-btn vtm-play" id="vtm-play" aria-label="Play"><span class="vtm-play-ico"></span></button>
      <span class="vtm-presets">
        <button class="vtm-btn" data-vtm-jump="now">{{ t('Now','当前') }}</button>
        <button class="vtm-btn" data-vtm-jump="2017-12-17">{{ t('2017 top','2017 顶') }}</button>
        <button class="vtm-btn" data-vtm-jump="2018-12-15">{{ t('2018 bottom','2018 底') }}</button>
        <button class="vtm-btn" data-vtm-jump="2021-04-14">{{ t('2021 top','2021 顶') }}</button>
        <button class="vtm-btn" data-vtm-jump="2022-11-09">{{ t('FTX crash','FTX 崩盘') }}</button>
      </span>
    </div>
    <div class="vtm-readout">
      <div class="vtm-asof">
