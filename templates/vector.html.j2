  </div>{% endif %}

  <!-- ===================== CORE SIGNALS (merged: momentum, structure, impulse, BFI) ===================== -->
  <div class="section-title"><span class="st-lab">{{ t('Core signals · momentum, structure, impulse, fundamentals', '核心信号 · 动量·结构·脉冲·基本面') }}</span></div>
  <div class="grid cols-2">
    <div class="card"><h3>{{ t('Momentum', '动量') }} <span class="faint" style="font-size:14px">{{ momentum }}</span></h3>{{ charts.momentum|safe }}
      <div class="sub">{{ t('Above +0.5 = momentum is with us · Below −0.5 = momentum is against us · Now:', '高于 +0.5 = 动量顺势 · 低于 −0.5 = 动量逆势 · 当前：') }} <b>{{ td(momentum_state) }}</b></div></div>
    <div class="card"><h3>{{ t('Structure Shift', '结构转变') }} <span class="faint" style="font-size:14px">{{ structure }}</span></h3>{{ charts.structure|safe }}
      <div class="sub">{{ t('Above +0.5 = structure is supportive · Below −0.5 = structure is broken · Now:', '高于 +0.5 = 结构支撑 · 低于 −0.5 = 结构走坏 · 当前：') }} <b>{{ td(structure_state) }}</b></div></div>
    <div class="card">
      <h3>{{ t('Impulse', '脉冲') }}
        {% set ic = {'positive':'var(--blue)','negative':'var(--r3)','neutral':'var(--muted)'} %}
        {% set iz = {'positive':'正向','negative':'负向','neutral':'中性'} %}
        <b style="color:{{ ic.get(impulse.state,'var(--muted)') }}"> · {{ t((impulse.state or '—')|upper, iz.get(impulse.state,'—')) }}</b>
        <span class="faint" style="font-size:14px"> {{ impulse.value if impulse.value is not none else '—' }}</span></h3>
      {% if impulse.pos_pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Positive participation (14d)','正向占比（14 天）') }}</span><span><b>{{ impulse.pos_pct }}%</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ impulse.pos_pct }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Trend clarity','趋势清晰度') }}</span><span><b>{{ impulse.er if impulse.er is not none else '—' }}</b> <span class="faint">{{ t('(0 = choppy, 1 = clear trend)','（0 = 震荡，1 = 单边趋势）') }}</span></span></div></div>
      <div class="sub" style="margin-top:10px">{{ t("Momentum's acceleration, chop-filtered — it flags when a move starts or burns out.",'动量的加速度，经震荡过滤 — 捕捉走势启动或衰竭的时机。') }}</div>
    </div>
    <div class="card"><h3>{{ t('Bitcoin Fundamental Index (BFI) — Network growth × Liquidity', '比特币基本面指数（BFI）— 网络增长 × 流动性') }}</h3>{{ charts.bfi|safe }}
      <div class="sub">{{ t('Above 60 = supportive environment · Below 40 = challenging environment · Now:', '高于 60 = 有利环境 · 低于 40 = 不利环境 · 当前：') }} <b>{{ bfi }}</b> ({{ td(bfi_zone) }})</div>
      {% set gauge_zh = {'Network Growth':'网络增长','Liquidity':'流动性','BFI':'BFI'} %}
      {% for nm,val in [('Network Growth',network_growth),('Liquidity',liquidity),('BFI',bfi)] %}
      <div class="mini"><div class="lab"><span>{{ t(nm, gauge_zh[nm]) }}</span><span><b>{{ val if val is not none else '—' }}</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ val if val is not none else 0 }}%"></div></div></div>
      {% endfor %}
      <div class="sub" style="margin-top:10px">{{ t('Never turned negative through the 2025 stress — a long-term anchor.','2025 年压力期间从未转负 — 一个长期锚点。') }}</div>
    </div>
  </div>

  <!-- ===================== CYCLE & VALUATION (merged) ===================== -->
  <div class="section-title"><span class="st-lab">{{ t('Cycle & valuation', '周期与估值') }}</span></div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Valuation anchors', '估值锚点') }}
        {% if valuation.deep_value %}<b style="color:var(--blue)"> · {{ t('DEEP VALUE','深度低估') }}</b>
        {% elif valuation.overvalued %}<b style="color:var(--r3)"> · {{ t('OVERVALUED','高估') }}</b>
        {% elif valuation.state %}<span class="faint"> · {{ td(valuation.state|capitalize) }}</span>{% endif %}</h3>
      {% set val_en = {'MVRV-Z':'Market vs cost base (MVRV-Z)','NUPL':'Profit in market (NUPL)','Mayer Multiple':'Price vs 200-day average'} %}
      {% set val_zh = {'MVRV-Z':'市价对比成本（MVRV-Z）','NUPL':'市场整体盈亏状态（NUPL）','Mayer Multiple':'价格对比 200 日均线'} %}
      {% for nm,v,p in [('MVRV-Z', valuation.mvrv_z, valuation.mvrv_z_pctile), ('NUPL', valuation.nupl, None), ('Mayer Multiple', valuation.mayer, None)] %}
      <div class="mini"><div class="lab"><span>{{ t(val_en.get(nm, nm), val_zh.get(nm, nm)) }}</span><span><b>{{ v if v is not none else '—' }}</b>{% if p is not none %} <span class="faint">{{ qmark('Historical percentile: ' ~ p ~ '%. Shows where the current reading falls vs all past readings.', '历史百分位：' ~ p ~ '%。显示当前读数在所有历史读数中的位置。') }}</span>{% endif %}</span></div></div>
      {% endfor %}
      {% if valuation.reserve_risk is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Is it a good time to hold long-term? (Reserve Risk)','现在适合长期持有吗？（储备风险）') }}</span><span><b style="color:{{ 'var(--r3)' if valuation.rr_top else ('var(--blue)' if (valuation.reserve_risk_pctile is not none and valuation.reserve_risk_pctile < 25) else 'var(--ink)') }}">{{ '%.4f'|format(valuation.reserve_risk) }}</b>{% if valuation.reserve_risk_pctile is not none %} <span class="faint">{{ qmark('Reserve Risk historical percentile: ' ~ valuation.reserve_risk_pctile ~ '%. Low = good time to hold long-term; high = top risk.', '储备风险历史百分位：' ~ valuation.reserve_risk_pctile ~ '%。低 = 适合长期持有；高 = 顶部风险。') }}</span>{% endif %}{% if valuation.rr_top %} <b style="color:var(--r3)"> · {{ t('Top risk','顶部风险') }}</b>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Deep value supports adding; overheated supports trimming. Reserve Risk low = accumulation, high = top risk.', '深度低估支持加仓；过热支持减仓。储备风险低 = 累积，高 = 顶部风险。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Miner cycle & cost basis', '矿工周期与成本基准') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Miner income signal (Hash Ribbons)','矿工收入信号（哈希丝带）') }}</span><span><b>{{ td(valuation.hash_ribbon|capitalize) if valuation.hash_ribbon else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Miner revenue ratio (Puell)','矿工收入比率（Puell）') }}</span><span><b>{{ valuation.puell if valuation.puell is not none else '—' }}</b></span></div></div>
      {% if valuation.sth_cb_ratio is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Price vs recent buyers\' average cost','价格对比近期买入者成本') }}</span><span><b style="color:{{ 'var(--blue)' if valuation.sth_cb_ratio>=0 else 'var(--r3)' }}">{{ '%+0.1f'|format(valuation.sth_cb_ratio) }}%</b></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Miner income signals flag stress early. Recent buyer cost is the key support / resistance level.', '矿工收入信号能早期标记压力。近期买入者成本是关键支撑/阻力位。') }}</div>
    </div>
    {# merged cycle clock card — halving progress row + phase timer row #}
    <div class="card">
      {% set ph = cycle.phase %}
      {% set ph_color = {'accumulation':'var(--blue)','markup':'var(--blue)','markdown':'var(--r3)','recovery':'var(--ink)'} %}
      {% set ph_zh = {'accumulation':'累积','markup':'上涨','markdown':'下跌','recovery':'复苏'} %}
      {% set cp = cycle_phase %}
      {% set cpc = {'markup':'var(--blue)','markdown':'var(--r3)'} %}
      {% set cpz = {'markup':'上涨腿','markdown':'下跌腿'} %}
      {% set kz = {'top':'顶部','bottom':'底部'} %}
      {% set stz = {'on_track':'按节奏','overdue':'已超期','invalidated':'已失效'} %}
      {% set stc = {'on_track':'var(--blue)','overdue':'var(--amber)','invalidated':'var(--r3)'} %}
      {# show phase label — if halving and phase clocks agree, show once; if they differ, both colors #}
      {% set ph_label = ph or '—' %}
      {% set cp_label = cp.phase or '—' %}
      <h3>{{ t('Cycle clock', '周期时钟') }}
        {% if ph_label == cp_label %}<b style="color:{{ ph_color.get(ph,'var(--muted)') }}"> · {{ t(ph_label|upper, ph_zh.get(ph,'—')) }}</b>
        {% else %}<b style="color:{{ ph_color.get(ph,'var(--muted)') }}"> · {{ t(ph_label|upper, ph_zh.get(ph,'—')) }}</b><b style="color:{{ cpc.get(cp.phase,'var(--muted)') }}"> / {{ t(cp_label|upper, cpz.get(cp.phase,'—')) }}</b>{% endif %}
        {% if cp.status and cp.status != 'on_track' %}<b style="color:{{ stc.get(cp.status,'var(--muted)') }}"> · {{ t(cp.status|replace('_',' ')|upper, stz.get(cp.status,'')) }}</b>{% endif %}</h3>
      {# halving clock row #}
      <div class="faint" style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;margin-top:4px">{{ t('Halving clock','减半时钟') }}</div>
      {% if cycle.pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Cycle progress (since halving)','周期进度（自减半起）') }}</span><span><b>{{ cycle.pct }}%</b> <span class="faint">({{ cycle.days }}d)</span></span></div>
        <div class="bar"><div class="fill" style="width:{{ cycle.pct if cycle.pct<=100 else 100 }}%"></div></div></div>{% endif %}
      {% if cycle.vdd is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Coin spending signal (VDD)','持币者花费信号（VDD）') }}{{ qmark('VDD Multiple above 2.9 = holders spending heavily (distribution). Below 0.75 = coins are dormant (accumulation). Percentile: ' ~ (cycle.vdd_pctile or '—') ~ '%.', 'VDD 倍数高于 2.9 = 持有者大量出货（派发）。低于 0.75 = 筹码休眠（累积）。百分位：' ~ (cycle.vdd_pctile or '—') ~ '%。') }}</span><span><b>{{ cycle.vdd }}</b> <span class="faint">({% if cycle.vdd > 2.9 %}{{ t('holders spending','持有者出货') }}{% elif cycle.vdd < 0.75 %}{{ t('coins dormant','筹码休眠') }}{% else %}{{ t('normal','正常') }}{% endif %})</span></span></div></div>{% endif %}
      {# phase timer row #}
      <div class="faint" style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;margin-top:10px">{{ t('Phase timer','相位计时') }}</div>
      {% if cp.pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Phase progress','相位进度') }}</span><span><b>{{ cp.pct }}%</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ cp.pct if cp.pct<=100 else 100 }}%;background:{{ cpc.get(cp.phase,'var(--blue)') }}"></div></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Next likely turning point','下一个可能的价格转折点') }}{% if cp.next_kind %} <span class="faint">({{ t(cp.next_kind, kz.get(cp.next_kind,'')) }})</span>{% endif %}</span><span><b>{{ cp.next_pivot or '—' }}</b>{% if cp.days_left is not none %} <span class="faint">({{ cp.days_left|int }}{{ t('d away','天后') }})</span>{% endif %}</span></div></div>
      {% endif %}
      <div class="sub" style="margin-top:8px">{{ t('Post-halving phases are historically bullish — useful context, not a trigger.','减半后历史上偏多 — 仅供参考，不触发操作。') }}{{ qmark('Post-halving accumulation phases averaged +48%/90d (81% hit rate). Mid-cycle markdowns averaged +5%/90d (43% hit rate). Soft prior — never a standalone trigger.','减半后累积期平均 +48%/90d（胜率 81%）。周期中段下跌期平均 +5%/90d（胜率 43%）。软先验 — 从不单独触发。') }}</div>
    </div>
    {# Cycle Thesis Monitor — W3 house law: keep blackout logic untouched #}
    <div class="card">
      {% set ct = cycle_thesis %}
      {% if ct and ct.ok %}
      {% set tsc = {'intact':'var(--blue)','watch':'var(--amber)','breaking':'var(--r3)'} %}
      {% set tsz = {'intact':'成立','watch':'观察','breaking':'破位'} %}
      {% set flc = {'ok':'var(--blue)','watch':'var(--amber)','alert':'var(--r3)'} %}
      {% set fli = {'ok':'✓','watch':'▲','alert':'✕'} %}
      <h3>{{ t('Cycle Thesis Monitor','周期论点监测') }}
        <b style="color:{{ tsc.get(ct.thesis_status,'var(--muted)') }}"> · {{ t(ct.thesis_status|upper, tsz.get(ct.thesis_status,'—')) }}</b>
        {#- W3: buy-side badge — suppressed under the gate via the SAME stamped key the rec
           card uses (build_vector.py), else Oct–Nov 2026 would flash "ACCUMULATION ZONE"
           beside a forced-flat 0% allocation. #}
        {% if ct.accumulate and not ct.suppressed_by_blackout %}<b style="color:var(--blue)"> · {{ t('ACCUMULATION ZONE','吸筹区') }}</b>{% endif %}
        {{ qmark(ct.caveat_en, ct.caveat_zh) }}</h3>
      {% if ct.drawdown_from_peak is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Drawdown from cycle peak','较周期顶部回撤') }} <span class="faint">({{ ct.peak_date }})</span></span><span><b style="color:var(--r3)">{{ (ct.drawdown_from_peak*100)|round|int }}%</b>{% if ct.prior_bear_mean is not none %} <span class="faint">{{ t('vs','对比') }} {{ (ct.prior_bear_mean*100)|round|int }}% {{ t('prior-bear avg','历史熊市均值') }}</span>{% endif %}</span></div></div>
      {% endif %}
      {% if ct.window_start %}
      <div class="mini"><div class="lab"><span>{{ t('Projected bottom window','预测底部窗口') }}</span><span><b>{{ ct.window_start }} → {{ ct.window_end }}</b></span></div></div>
      {% endif %}
      <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
        {% for f in ct.flags %}
        <div style="display:flex;gap:6px;align-items:flex-start;font-size:11px;line-height:1.35"><span style="color:{{ flc.get(f.level,'var(--muted)') }};font-weight:700;flex:0 0 auto">{{ fli.get(f.level,'·') }}</span><span>{{ t(f.en, f.zh) }}</span></div>
        {% endfor %}
      </div>
      {% else %}
      <h3>{{ t('Cycle Thesis Monitor','周期论点监测') }}</h3>
      <div class="sub">{{ t('Monitor unavailable for this build.','本次构建暂无监测数据。') }}</div>
      {% endif %}
    </div>
    <div class="card">
      <h3>{{ t('CME positioning & correlation', 'CME 持仓与相关性') }}
        {% if positioning.crowded %}<b style="color:var(--r3)"> · {{ t('CROWDED LONG','多头拥挤') }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Large-traders net position (CME)','大型交易商净持仓（CME）') }}</span><span><b style="color:{{ 'var(--r3)' if positioning.crowded else 'var(--ink)' }}">{{ positioning.cot_z if positioning.cot_z is not none else '—' }}</b>{% if positioning.cot_net_pct is not none %} <span class="faint">{{ qmark('z-score: how extreme vs history. % of open contracts: ' ~ positioning.cot_net_pct ~ '%.', 'z 值：偏离历史程度。占总持仓：' ~ positioning.cot_net_pct ~ '%。') }}</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('BTC↔S&P 500 correlation (90d)','BTC↔标普 500 相关性（90 天）') }}</span><span><b>{{ correlation.spx if correlation.spx is not none else '—' }}</b> <span class="faint">{{ td((correlation.regime or '')|capitalize) }}</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('BTC↔Gold correlation (90d)','BTC↔黄金 相关性（90 天）') }}</span><span><b>{{ correlation.gold if correlation.gold is not none else '—' }}</b></span></div></div>
      <div class="sub" style="margin-top:8px">{{ t('When big traders are very long, it often marks a top. BTC also tends to do better when it\'s moving independently of stocks.','当大型交易商大幅净多时，往往接近高点。BTC 与股市脱钩时通常表现更好。') }}{{ qmark('Crowded CME longs were contrarian: −5.8%/90d (35% hit rate). BTC coupled to equities: +13%/90d vs +33% when decoupled.','CME 多头拥挤具反向性：−5.8%/90d，胜率 35%。与股票耦合时 +13%/90d，脱钩时 +33%。') }}</div>
    </div>
  </div>

  <!-- ===================== DERIVATIVES (merged: options + leverage) ===================== -->
  <details class="sec-fold" id="derivatives">
  <summary>⚙ {{ t('Options & leverage · advanced', '期权与杠杆 · 进阶') }} <span class="hint">{{ t('volatility, skew, funding, open interest', '波动率、偏斜、资金费率、持仓') }}</span></summary>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Implied volatility', '隐含波动率') }}</h3>
      {# Tier-1: Option-market mood summary. All z-scores/percentiles in hover. #}
      {% set iv_mood = 'Expensive options' if (options.vrp_state=='vol_rich') else ('Cheap options' if (options.vrp_state=='vol_cheap') else ('High fear' if (options.dvol is not none and options.dvol > 70) else 'Calm')) %}
      {% set iv_mood_zh = '期权偏贵' if (options.vrp_state=='vol_rich') else ('期权偏便宜' if (options.vrp_state=='vol_cheap') else ('高度恐慌' if (options.dvol is not none and options.dvol > 70) else '平静')) %}
      <div style="font-size:18px;font-weight:800;color:{{ 'var(--r3)' if options.vrp_state=='vol_rich' or (options.dvol and options.dvol>70) else ('var(--amber)' if options.vrp_state=='vol_cheap' else 'var(--muted)') }};margin:8px 0">{{ t(iv_mood, iv_mood_zh) }}</div>
      {% if options.em_pct is not none %}
      <div class="sub">{{ t('Options are pricing a ±','期权定价的未来 30 天波幅约为 ±') }}{{ options.em_pct }}% {{ t('move over 30 days','波幅（30 天）') }} ({{ options.em_lower|money }} – {{ options.em_upper|money }})</div>{% endif %}
      {% if options.gamma_regime %}
      {% set gr = {'long':['Price tends to pin here (low volatility likely)','价格倾向于在此黏滞（低波动可能）','var(--blue)'],'short':['Price swings may be amplified (gamma short)','价格波动可能被放大（负 Gamma）','var(--r3)']} %}
      <div class="sub" style="margin-top:6px">{{ t(gr.get(options.gamma_regime,['—'])[0], gr.get(options.gamma_regime,['—','—'])[1]) }}{% if options.gamma_flip %} · {{ t('key level','关键价位') }}: {{ options.gamma_flip|money }}{% endif %}</div>{% endif %}
      {{ qmark('DVOL (crypto implied vol index): ' ~ (options.dvol or '—') ~ ((' (' ~ options.dvol_pctile ~ '%ile)') if options.dvol_pctile is not none else '') ~ '. Variance Risk Premium (IV−RV): ' ~ (options.vrp or '—') ~ ((' (z ' ~ ('%+0.1f'|format(options.vrp_z)) ~ ')') if options.vrp_z is not none else '') ~ '. ATM IV 30d: ' ~ (options.atm_iv_30d or '—') ~ '. Realized vol: ' ~ ((options.rv_realized|string ~ '%') if options.rv_realized is not none else '—') ~ ((' (' ~ options.rv_cone_pctile ~ '%ile, vol-of-vol ' ~ options.vov_pctile ~ '%ile)') if options.rv_cone_pctile is not none else '') ~ '. Context (2021→): DVOL 70–90 averaged −13%/90d; VRP below −5 marked recoveries (+17%/90d).', 'DVOL（加密波动率指数）：' ~ (options.dvol or '—') ~ (('（' ~ options.dvol_pctile ~ '%ile）') if options.dvol_pctile is not none else '') ~ '。方差风险溢价（VRP）：' ~ (options.vrp or '—') ~ (('（z ' ~ ('%+0.1f'|format(options.vrp_z)) ~ '）') if options.vrp_z is not none else '') ~ '。平值 30 天 IV：' ~ (options.atm_iv_30d or '—') ~ '。已实现波动率：' ~ ((options.rv_realized|string ~ '%') if options.rv_realized is not none else '—') ~ '。') }}
      <div class="sub" style="margin-top:10px">{{ t('Options tell you how big moves might be, not which way.','期权反映波幅大小，不预测方向。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Skew & positioning (snapshot)', '偏斜与持仓（快照）') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('25Δ risk reversal','25Δ 风险逆转') }}</span><span><b style="color:{{ 'var(--r3)' if (options.rr_25d is not none and options.rr_25d<0) else 'var(--blue)' }}">{{ options.rr_25d if options.rr_25d is not none else '—' }}</b> <span class="faint">{{ t('(<0 = downside bid)','（<0 = 下行需求）') }}</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Put/Call OI ratio','看跌/看涨 持仓比') }}</span><span><b>{{ options.put_call if options.put_call is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Max pain','最大痛点') }}</span><span><b>{{ ('$%s'|format('{:,.0f}'.format(options.max_pain))) if options.max_pain is not none else '—' }}</b></span></div></div>
      {% if options.basis_ann is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Futures basis (annualized)','期货基差（年化）') }}</span><span><b style="color:{{ 'var(--r3)' if options.basis_ann>15 else ('var(--blue)' if options.basis_ann>=0 else 'var(--r3)') }}">{{ '%+0.1f'|format(options.basis_ann) }}%</b> <span class="faint">{{ t('(>15 froth, <0 stress)','（>15 过热，<0 承压）') }}</span></span></div></div>{% endif %}
      {% if options.skew_term is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Skew term (7d−90d)','偏斜期限（7天−90天）') }}</span><span><b>{{ '%+0.3f'|format(options.skew_term) }}</b> <span class="faint">{{ t('(>0 = acute near-term fear)','（>0 = 近端急性恐慌）') }}</span></span></div></div>{% endif %}
      {% if options.iv_term_state %}
      {% set its = {'contango':['Contango (calm)','正向（平静）','var(--blue)'],'backwardation':['Backwardation (front-end stress)','逆向（近端承压）','var(--r3)'],'flat':['Flat','持平','var(--muted)']} %}
      <div class="mini"><div class="lab"><span>{{ t('IV term structure','IV 期限结构') }}</span><span><b style="color:{{ its.get(options.iv_term_state,['','','var(--muted)'])[2] }}">{{ t(its.get(options.iv_term_state,['—'])[0], its.get(options.iv_term_state,['—','—'])[1]) }}</b>{% if options.iv_term_spread is not none %} <span class="faint">({{ '%+0.1f'|format(options.iv_term_spread) }}pt 90d−30d)</span>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">
        {% if options.rr_25d is not none and options.rr_25d < 0 %}
        {{ t('Options traders are paying up for downside protection — puts cost more than calls.', '期权交易者正在为下行保护支付溢价 — 看跌期权比看涨期权更贵。') }}
        {% elif options.rr_25d is not none and options.rr_25d > 0 %}
        {{ t('Options traders are bidding for upside — calls cost more than puts.', '期权交易者正在押注上行 — 看涨期权比看跌期权更贵。') }}
        {% else %}
        {{ t('Options skew is balanced — no strong lean toward upside or downside protection.', '期权偏斜平衡 — 上下行保护需求相当。') }}
        {% endif %}
        {{ qmark('Rebuilt from the free Deribit options chain — includes the futures-basis curve (leverage demand) and the skew term structure (near-term vs. structural fear). The per-strike snapshot builds up daily — treat as context until ~6–12 months of history allow calibration.', '基于免费的 Deribit 期权链重建 — 含期货基差曲线（杠杆需求）与偏斜期限结构（近端 vs 结构性恐慌）。逐行权价快照每日累积 — 在约 6–12 个月历史前仅作背景参考。') }}
      </div>
    </div>
  </div>

  <div class="grid cols-2">
    <div class="card" id="leverage">
      <h3>{{ t('Leverage state', '杠杆状态') }}</h3>
      {% if leverage.stress is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Leverage stress','杠杆压力') }}</span><span><b>{{ leverage.stress }}/100</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ leverage.stress }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Aggregate open interest','总持仓量') }}{{ qmark('Open interest as % of market cap (percentile vs history): ' ~ (leverage.oi_mcap_pctile|string if leverage.oi_mcap_pctile is not none else '—') ~ '%ile. High = elevated leverage.','持仓量占市值比例（历史百分位）：' ~ (leverage.oi_mcap_pctile|string if leverage.oi_mcap_pctile is not none else '—') ~ '%ile。高 = 杠杆偏高。') }}</span><span><b>{{ ('$%.1fB'|format(leverage.oi_total/1e9)) if leverage.oi_total is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Funding rate (annualized)','资金费率（年化）') }}{{ qmark('Funding rate z-score: ' ~ (leverage.funding_z|string if leverage.funding_z is not none else '—') ~ '. Negative z = shorts paying = crowded shorts.','资金费率 z 值：' ~ (leverage.funding_z|string if leverage.funding_z is not none else '—') ~ '。负 z = 空头付费 = 空头拥挤。') }}</span><span><b>{{ ('%+0.1f%%'|format(leverage.funding_annual)) if leverage.funding_annual is not none else '—' }}</b></span></div></div>
      {% if leverage.okx_ls_ratio is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Retail long/short ratio (OKX accounts)','散户多空比（OKX 账户数）') }}{{ qmark('OKX long/short ratio: ' ~ '%.2f'|format(leverage.okx_ls_ratio) ~ ((' (' ~ leverage.okx_ls_pctile ~ '%ile') if leverage.okx_ls_pctile is not none else '') ~ ((' · z ' ~ leverage.okx_ls_z) if leverage.okx_ls_z is not none else '') ~ (')' if leverage.okx_ls_pctile is not none else '') ~ '. Crowded longs = contrarian caution; crowded shorts = capitulation context.','OKX 多空比：' ~ '%.2f'|format(leverage.okx_ls_ratio) ~ '。多头拥挤 = 反向警示；空头拥挤 = 投降式背景。') }}</span><span><b style="color:{{ 'var(--r3)' if leverage.okx_ls_lean=='crowded_long' else ('var(--blue)' if leverage.okx_ls_lean=='crowded_short' else 'var(--ink)') }}">{{ '%.2f'|format(leverage.okx_ls_ratio) }}</b>
      {% if leverage.okx_ls_lean=='crowded_long' %} <span class="faint" style="color:var(--r3)">· {{ t('many traders long','多头拥挤') }}</span>{% elif leverage.okx_ls_lean=='crowded_short' %} <span class="faint" style="color:var(--blue)">· {{ t('many traders short','空头拥挤') }}</span>{% endif %}</span></div></div>{% endif %}
      {% if leverage.okx_taker_buy is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OKX aggressive buy share','OKX 主动买盘占比') }}{{ qmark('Taker buy share: ' ~ '%.0f'|format(100*leverage.okx_taker_buy) ~ '%' ~ ((' (' ~ leverage.okx_taker_pctile ~ '%ile)') if leverage.okx_taker_pctile is not none else '') ~ '. Shows whether buyers or sellers are more aggressive.','主动买盘占比：' ~ '%.0f'|format(100*leverage.okx_taker_buy) ~ '%。显示买卖双方谁更主动。') }}</span><span><b>{{ '%.0f'|format(100*leverage.okx_taker_buy) }}%</b></span></div></div>{% endif %}
      {% if leverage.cme_basis is not none %}
      {% set creg = {'contango':'var(--amber)','backwardation':'var(--r3)','flat':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('CME futures basis (carry)','CME 期货基差（套利）') }}{{ qmark('CME basis: ' ~ '%+0.2f'|format(leverage.cme_basis) ~ '% (~' ~ '%+0.0f'|format(leverage.cme_basis_ann) ~ '%/yr, ' ~ (leverage.cme_basis_pctile|string if leverage.cme_basis_pctile is not none else '—') ~ '%ile). Regulated carry demand by professional traders.','CME 基差：' ~ '%+0.2f'|format(leverage.cme_basis) ~ '%（约 ' ~ '%+0.0f'|format(leverage.cme_basis_ann) ~ '%/年）。机构套利需求指标。') }}</span><span><b>{{ '%+0.2f'|format(leverage.cme_basis) }}%</b> <span class="faint" style="color:{{ creg.get(leverage.cme_basis_regime,'var(--muted)') }}">{{ td(leverage.cme_basis_regime) }}</span></span></div></div>{% endif %}
      {% if leverage.oi_divergence is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Open interest vs price divergence (14d)','持仓量 vs 价格背离（14 天）') }}</span><span><b>{{ '%+0.1f'|format(leverage.oi_divergence) }}%</b></span></div></div>{% endif %}
      {% if leverage.carry_state %}
      {% set fcs = {'froth':['Froth (longs paying up)','过热（多头付溢价）','var(--r3)'],'stress':['Stress (deleveraging)','承压（去杠杆）','var(--blue)'],'neutral':['Neutral','中性','var(--muted)']} %}
      <div class="mini"><div class="lab"><span>{{ t('Consolidated futures carry','综合期货套利') }}{{ qmark('Carry z-score: ' ~ ('%+0.1f'|format(leverage.carry_z) if leverage.carry_z is not none else '—') ~ '. One blended leverage-cycle read across exchanges.','套利 z 值：' ~ ('%+0.1f'|format(leverage.carry_z) if leverage.carry_z is not none else '—') ~ '。跨交易所的单一综合杠杆周期读数。') }}</span><span><b style="color:{{ fcs.get(leverage.carry_state,['','','var(--muted)'])[2] }}">{{ t(fcs.get(leverage.carry_state,['—'])[0], fcs.get(leverage.carry_state,['—','—'])[1]) }}</b></span></div>
      </div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Crowding makes the tape fragile. When traders are very short, it can mark a bottom.','拥挤使行情脆弱。交易者高度做空时，往往接近底部。') }}{{ qmark('Crowded shorts (funding-rate z < −1) were followed by +18%/90d at 70% hit rate. Context, not a signal by itself.','空头拥挤（资金费率 z < −1）后 90 天 +18%，胜率 70%。仅为背景，本身不是交易信号。') }}</div>
    </div>
  </div>
  </details>

  <!-- ===================== THE BACKDROP · LIQUIDITY & BREADTH ===================== -->
  <div class="section-title"><span class="st-lab">{{ t('The backdrop · liquidity & breadth', '大背景 · 流动性与广度') }}</span></div>
  <div class="grid cols-2">
    <div class="card">
      {% set mr = macro.regime %}
      {% set mr_color = {'tailwind':'var(--blue)','headwind':'var(--r3)','neutral':'var(--muted)'} %}
      {% set mr_label = {'tailwind':'TAILWIND','headwind':'HEADWIND','neutral':'NEUTRAL'} %}
      {% set mr_zh = {'tailwind':'顺风','headwind':'逆风','neutral':'中性'} %}
      <h3>{{ t('Macro backdrop', '宏观背景') }}
        <b style="color:{{ mr_color.get(mr,'var(--muted)') }}"> · {{ t(mr_label.get(mr,'—'), mr_zh.get(mr,'—')) }}</b>
        {% if macro.score is not none %}<span class="faint" style="font-size:13px"> ({{ '%+0.2f'|format(macro.score) }})</span>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Fed net money supply','Fed 净流动性') }}{{ qmark('Net liquidity = Fed balance sheet (WALCL) minus Reverse Repo (RRP) minus Treasury General Account (TGA). A rising number means more money in markets.','净流动性 = Fed 资产负债表（WALCL）减去逆回购（RRP）减去财政部一般账户（TGA）。上升意味着市场中钱更多。') }}</span><span><b>{{ ('$%.2fT'|format(macro.net_liq_bn/1000)) if macro.net_liq_bn is not none else '—' }}</b>{% if macro.net_liq_roc is not none %} <span class="faint" style="color:{{ 'var(--blue)' if macro.net_liq_roc>=0 else 'var(--r3)' }}">({{ '%+0.1f'|format(macro.net_liq_roc) }}% 13w)</span>{% endif %}</span></div></div>
      {% if macro.global_m2_yoy is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Global M2 growth (US+China)','全球 M2 增速（美+中）') }}</span><span><b style="color:{{ 'var(--blue)' if macro.global_m2_yoy>=5 else 'var(--r3)' }}">{{ macro.global_m2_yoy }}% YoY</b> <span class="faint">({{ td((macro.global_liq_regime or '')|capitalize) }})</span></span></div></div>{% endif %}
      {% if macro.get('stbl_growth_z') is not none %}
      {% set sreg = {'expanding':'var(--blue)','contracting':'var(--r3)','neutral':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('Stablecoin supply (crypto-native liquidity)','稳定币供应（加密原生流动性）') }}{{ qmark('z-score of stablecoin supply growth: ' ~ '%+0.1f'|format(macro.stbl_growth_z) ~ '. Total stablecoin market cap: $' ~ macro.stbl_mcap_bn ~ 'B.','稳定币供应增速 z 值：' ~ '%+0.1f'|format(macro.stbl_growth_z) ~ '。稳定币总市值：$' ~ macro.stbl_mcap_bn ~ 'B。') }}</span><span><b style="color:{{ sreg.get(macro.stbl_regime,'var(--muted)') }}">{{ td((macro.stbl_regime or '')|capitalize) }}</b></span></div></div>{% endif %}
      {% if macro.peg_state %}
      {% set pst = {'stable':['Stable','稳定','var(--blue)'],'watch':['Watch','观察','var(--amber)'],'break':['BREAK','脱锚','var(--red)']} %}
      <div class="mini"><div class="lab"><span>{{ t('Stablecoin peg health (USDT/USDC/DAI)','稳定币锚定健康（USDT/USDC/DAI）') }}{{ qmark('Maximum peg deviation: ' ~ macro.peg_dev_bps ~ 'bps (basis points).','最大锚定偏离：' ~ macro.peg_dev_bps ~ ' 个基点。') }}</span><span><b style="color:{{ pst.get(macro.peg_state,['','','var(--muted)'])[2] }}">{{ t(pst.get(macro.peg_state,['—'])[0], pst.get(macro.peg_state,['—','—'])[1]) }}</b></span></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('10y real yield','10 年期实际收益率') }}</span><span><b>{{ ('%.2f%%'|format(macro.real_yield)) if macro.real_yield is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Junk bond stress (credit spread)','垃圾债利差') }}</span><span><b>{{ ('%.2f%%'|format(macro.hy_oas)) if macro.hy_oas is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Fear index / Dollar (VIX / DXY)','恐慌指数 / 美元指数') }}</span><span><b>{{ macro.vix if macro.vix is not none else '—' }}</b> / {{ macro.dxy if macro.dxy is not none else '—' }}</span></div></div>
      <div class="sub" style="margin-top:10px">{{ t('BTC follows the change in liquidity — a months-out tide, not a trigger.', 'BTC 跟随流动性变化 — 数月维度的潮汐，而非触发器。') }}{{ qmark('In tailwind conditions (score > +0.3), BTC returned +48.8%/90d on average (hit rate 76%). In headwinds (score < −0.3), +1.4%/90d (41%).','顺风时（评分 > +0.3），BTC 90 天平均 +48.8%，胜率 76%；逆风时（评分 < −0.3），+1.4%，胜率 41%。') }}</div>
    </div>
    {% if breadth and breadth.bucket and breadth.bucket != '—' %}
    <div class="card">
      {% set bkt = breadth.bucket %}
      {% set bk_color = {'Alt season':'var(--blue)','BTC season':'var(--amber)','Mixed':'var(--muted)'} %}
      {% set bk_zh = {'Alt season':'山寨季','BTC season':'BTC 季','Mixed':'混合'} %}
      <h3>{{ t('Market breadth', '市场广度') }}
        <b style="color:{{ bk_color.get(bkt,'var(--muted)') }}"> · {{ t(bkt, bk_zh.get(bkt, bkt)) }}</b>
        {% if breadth.score is not none %}<span class="faint" style="font-size:13px"> ({{ breadth.score|int }}/100)</span>{% endif %}</h3>
      {% if breadth.score is not none %}
      <div class="mini"><div class="lab"><span>{{ t('How spread the rally is','涨势广度') }}</span><span><b>{{ breadth.score|int }}/100</b> <span class="faint">{{ t('(0 = Bitcoin only · 100 = broad market)','（0 = 仅比特币 · 100 = 普涨）') }}</span></span></div>
        <div class="bar"><div class="fill" style="width:{{ breadth.score|int }}%"></div></div></div>{% endif %}
      {% if breadth.ethbtc is not none %}
      {% set es_color = {'alt':'var(--blue)','btc':'var(--amber)','mixed':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('ETH/BTC (alt-cycle core)','ETH/BTC（山寨周期核心）') }}</span><span><b style="color:{{ es_color.get(breadth.ethbtc_season,'var(--ink)') }}">{{ '%.4f'|format(breadth.ethbtc) }}</b>{% if breadth.ethbtc_slope is not none %} <span class="faint" style="color:{{ 'var(--blue)' if breadth.ethbtc_slope>=0 else 'var(--r3)' }}">({{ '%+0.1f'|format(breadth.ethbtc_slope) }}% 8w)</span>{% endif %}{% if breadth.ethbtc_pctile is not none %} <span class="faint">· {{ breadth.ethbtc_pctile|int }}%ile</span>{% endif %}</span></div></div>{% endif %}
      {% if breadth.soleth is not none %}
      {% set st_color = {'rising':'var(--blue)','falling':'var(--r3)','flat':'var(--muted)'} %}
      {% set st_lab = {'rising':['rising — high-beta bid','上升 — 高贝塔买盘'],'falling':['falling — risk-off','下降 — 避险'],'flat':['flat','走平']} %}
      <div class="mini"><div class="lab"><span>{{ t('SOL/ETH (high-beta appetite)','SOL/ETH（高贝塔偏好）') }} <span class="faint">{{ t('NEW','新增') }}</span></span><span><b>{{ '%.4f'|format(breadth.soleth) }}</b>{% if breadth.soleth_trend %} <span class="faint" style="color:{{ st_color.get(breadth.soleth_trend,'var(--muted)') }}">· {{ t(st_lab.get(breadth.soleth_trend,['—'])[0], st_lab.get(breadth.soleth_trend,['—','—'])[1]) }}</span>{% endif %}{% if breadth.soleth_pctile is not none %} <span class="faint">· {{ breadth.soleth_pctile|int }}%ile</span>{% endif %}</span></div></div>{% endif %}
      {% if breadth.dom is not none %}
      <div class="mini"><div class="lab"><span>{{ t('BTC dominance','BTC 占比') }}</span><span><b>{{ '%.1f%%'|format(breadth.dom) }}</b>{% if breadth.ethdom is not none %} <span class="faint">· ETH {{ '%.1f%%'|format(breadth.ethdom) }}</span>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t("Shows how far out the risk curve money is going. Confirms the mood; doesn't lead it.","显示资金在风险曲线上走多远。确认市场情绪，并非领先指标。") }}</div>
    </div>
    {% endif %}
  </div>

  <!-- ===================== ON-CHAIN & ETF DEMAND ===================== -->
  <div class="section-title"><span class="st-lab">{{ t('On-chain & ETF demand', '链上与 ETF 需求') }}</span></div>
  <div class="grid cols-2">
    <div class="card">
      {% set ps = {'overheated':['OVERHEATED','过热','var(--r3)'],'premium':['PREMIUM · US bid','溢价 · 美国买盘','var(--blue)'],'neutral':['NEUTRAL','中性','var(--muted)'],'discount':['DISCOUNT','折价','var(--amber)'],'deep_discount':['DEEP DISCOUNT','深度折价','var(--r3)']} %}
      <h3>{{ t('Coinbase Premium', 'Coinbase 溢价') }}
        {% if onchain.premium_state %}<b style="color:{{ ps.get(onchain.premium_state,['','','var(--muted)'])[2] }}"> · {{ t(ps.get(onchain.premium_state,['—'])[0], ps.get(onchain.premium_state,['—','—'])[1]) }}</b>{% endif %}
        <span class="verdict v-dir" style="font-size:10px;vertical-align:middle" data-tip-en="Track record measured separately in both halves of history — it held in both." data-tip-zh="记录在历史前后两半段分别检验，均成立。">{{ t('Proven record','实测记录') }}</span></h3>
      <div class="mini"><div class="lab"><span>{{ t('US buyer premium (7-day average)','美国买家溢价（7 日均值）') }}{{ qmark('Coinbase USD minus OKX USDT price. z-score: ' ~ ('%+0.1f'|format(onchain.premium_z) if onchain.premium_z is not none else '—') ~ '. Percentile vs history: ' ~ (onchain.premium_pctile|string if onchain.premium_pctile is not none else '—') ~ '%ile.','Coinbase USD 与 OKX USDT 价差。z 值：' ~ ('%+0.1f'|format(onchain.premium_z) if onchain.premium_z is not none else '—') ~ '。历史百分位：' ~ (onchain.premium_pctile|string if onchain.premium_pctile is not none else '—') ~ '%ile。') }}</span><span><b style="color:{{ 'var(--blue)' if (onchain.premium is not none and onchain.premium>=0) else 'var(--r3)' }}">{{ ('%+0.2f%%'|format(onchain.premium)) if onchain.premium is not none else '—' }}</b></span></div></div>
      {% if onchain.premium_div and onchain.premium_div!='aligned' %}
      <div class="mini"><div class="lab"><span>{{ t('Smart-money divergence','聪明钱背离') }}</span><span><b style="color:{{ 'var(--r3)' if onchain.premium_div=='distribution' else 'var(--blue)' }}">{{ t('US selling strength','美国逢高卖出') if onchain.premium_div=='distribution' else t('US buying weakness','美国逢低买入') }}</b></span></div></div>{% endif %}
      <div class="sub" style="margin-top:8px">{{ t('Shows whether US buyers are paying a premium. Extreme readings matter most; divergence flags when price and US demand disagree.', '显示美国买家是否愿意付溢价。极端读数最重要；背离提示价格与美国需求不一致。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Dry powder & miners (context)', '场外资金与矿工（背景）') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Stablecoin buying potential (SSR)','稳定币购买力（SSR）') }}</span><span><b>{{ onchain.ssr_osc if onchain.ssr_osc is not none else '—' }}</b> <span class="faint">{{ t('(high = more potential buying power)','（高 = 潜在买盘更强）') }}</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Miner selling pressure (MPI)','矿工出售压力（MPI）') }}</span><span><b>{{ onchain.mpi if onchain.mpi is not none else '—' }}</b></span></div></div>
      <div class="sub" style="margin-top:8px">{{ t('Context only. These free versions are useful color, not trade signals.', '仅作背景。免费版本可作参考，不是交易信号。') }}</div>
    </div>
  </div>

  <!-- ===================== BTC SPOT-ETF NET FLOWS ===================== -->
  {% if etf.present or etf.usd_present %}
  <div class="card">
    <h3>{{ t('Risk Index & ETF Net Flows', '风险指数与 ETF 净流入') }}
      {% set _st = etf.state %}
      <b style="color:{{ 'var(--blue)' if _st=='accumulation' else ('var(--r3)' if _st=='distribution' else 'var(--muted)') }}"> · {{ (t('ACCUMULATION','吸筹') if _st=='accumulation' else (t('DISTRIBUTION','派发') if _st=='distribution' else t('NEUTRAL','中性'))) }}</b>
      {% if etf.asof %}<span class="faint" style="font-size:12px;font-weight:400"> · {{ t('as of','截至') }} {{ etf.asof }}</span>{% endif %}
    </h3>
    {% if etf.present %}
    {{ charts.etf_flow|safe }}
    <div class="sub" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;font-size:12px">
      <span style="opacity:.8">{{ t('Price shaded by flow regime:', '价格按资金流状态着色：') }}</span>
      <span><span style="display:inline-block;width:12px;height:11px;border-radius:2px;background:rgba(40,95,255,0.45);vertical-align:-1px;margin-right:5px"></span>{{ t('Accumulation (net inflows)', '吸筹（净流入）') }}</span>
