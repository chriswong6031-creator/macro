<div class="wrap">

  <!-- ===================== MASTER SIGNAL · COMMAND CENTER ===================== -->
  {% if master and master.ok %}
  <style>
    .cmd{display:grid;grid-template-columns:300px 1fr;gap:22px;background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb,var(--blue) 9%,var(--card)) 0%, var(--card) 55%);
      border:1px solid var(--grid);border-radius:20px;padding:24px;margin-bottom:8px}
    @media(max-width:780px){.cmd{grid-template-columns:1fr}}
    .cmd-h{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin:0 0 2px}
    .mg-wrap{position:relative;width:280px;height:150px;margin:6px auto 2px}
    .mg-needle{position:absolute;left:138px;top:32px;width:4px;height:108px;border-radius:3px;
      transform-origin:50% 100%;transition:transform .7s cubic-bezier(.34,1.3,.5,1)}
    .mg-hub{position:absolute;left:130px;top:130px;width:20px;height:20px;border-radius:50%;border:3px solid var(--card)}
    .mg-score{position:absolute;left:0;right:0;top:74px;text-align:center;font-size:38px;font-weight:800;letter-spacing:-.03em;line-height:1}
    .mg-ends{display:flex;justify-content:space-between;font-size:11px;font-weight:700;color:var(--faint);margin:-6px 6px 0}
    .mg-band{text-align:center;font-size:21px;font-weight:800;letter-spacing:-.01em;margin-top:8px}
    .mg-tally{text-align:center;font-size:12px;color:var(--muted);margin-top:3px}
    .mg-tally b.bu{color:var(--blue)} .mg-tally b.be{color:var(--r3)}
    .cmd-r-top{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
    .cmd-price{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
    .cmd-stance{font-size:15px;font-weight:800}
    .cmd-head{font-size:13.5px;color:var(--text);line-height:1.55;margin-top:10px}
    .cmd-drv{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px}
    .cmd-drv .col{flex:1;min-width:200px}
    .cmd-drv .ch{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);margin-bottom:6px}
    .drvchip{display:flex;align-items:center;gap:7px;font-size:12.5px;padding:4px 0}
    .drvchip i{width:8px;height:8px;border-radius:50%;flex:none}
    .drvchip i.bull{background:var(--blue)} .drvchip i.bear{background:var(--r3)}
    .drvchip b{color:var(--ink);font-weight:700} .drvchip span{color:var(--muted)}
    .cmd-act{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px;
      border-top:1px solid var(--grid);padding-top:14px}
    .cmd-act .a{text-align:center}
    .cmd-act .a .k{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
    .cmd-act .a .v{font-size:18px;font-weight:800;color:var(--ink);margin-top:2px}
    .cmd-act .a .h{font-size:11px;color:var(--faint);margin-top:1px}
    /* Signal Board */
    .board{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
    @media(max-width:900px){.board{grid-template-columns:1fr}}
    .bgrp{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:14px 16px}
    .bgrp h4{margin:0 0 8px;font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
    .brow{display:grid;grid-template-columns:12px 1fr auto;grid-template-rows:auto auto;
      gap:1px 9px;align-items:center;padding:8px 0;border-top:1px solid var(--grid)}
    .brow:first-of-type{border-top:none}
    .brow .dot{grid-row:1/3;width:9px;height:9px;border-radius:50%}
    .brow .dot.bull{background:var(--blue)} .brow .dot.bear{background:var(--r3)} .brow .dot.neutral{background:var(--muted)}
    .brow .lab{font-size:13px;font-weight:600;color:var(--ink)}
    .brow .gr{justify-self:end;font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:6px;letter-spacing:.02em}
    .gr-CONFIRMED{background:#E3F5E9;color:#1a7f43} .gr-DIRECTIONAL{background:#ECE9FB;color:#5b46c8}
    .gr-EXTREMES{background:#FFF2D9;color:#9a6a00} .gr-CONTEXT{background:var(--grid);color:var(--muted)}
    .gr-NEW{background:#DDF3F6;color:#0d7b8a} .gr-INVERTED{background:var(--grid);color:var(--muted)}
    html[data-theme="dark"] .gr-CONFIRMED{background:#16331f;color:#5fd08a}
    html[data-theme="dark"] .gr-DIRECTIONAL{background:#241d44;color:#a594f0}
    html[data-theme="dark"] .gr-EXTREMES{background:#3a2e12;color:#e0b34e}
    html[data-theme="dark"] .gr-NEW{background:#10333a;color:#4fc6d8}
    .brow .st{font-size:11.5px;color:var(--muted)}
    .brow .spk{grid-row:1/3;justify-self:end;width:62px;height:24px}
    .brow .spk polyline{fill:none;stroke-width:1.6;vector-effect:non-scaling-stroke}
    .spk.bull polyline{stroke:var(--bull)} .spk.bear polyline{stroke:var(--bear)} .spk.neutral polyline{stroke:var(--neutral)}
    /* RECOMMENDATION card */
    .reco{display:grid;grid-template-columns:1.1fr 1fr;gap:0;border:1px solid var(--grid);border-radius:18px;overflow:hidden;margin-top:14px}
    @media(max-width:780px){.reco{grid-template-columns:1fr}}
    .reco-l{padding:20px 22px;border-right:1px solid var(--grid)}
    @media(max-width:780px){.reco-l{border-right:none;border-bottom:1px solid var(--grid)}}
    .reco-r{padding:20px 22px;display:flex;flex-direction:column;gap:14px}
    .reco-l.t-bull{background:linear-gradient(120% 140% at 0 0,var(--bull-soft),var(--card) 60%)}
    .reco-l.t-bear{background:linear-gradient(120% 140% at 0 0,var(--bear-soft),var(--card) 60%)}
    .reco-l.t-neutral{background:var(--card)}
    .reco-k{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
    .reco-act{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1.08;margin:6px 0 8px}
    .reco-act.t-bull{color:var(--bull)} .reco-act.t-bear{color:var(--bear)} .reco-act.t-neutral{color:var(--ink)}
    .reco-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--muted)}
    .reco-conv{font-size:11px;font-weight:800;padding:2px 9px;border-radius:7px;letter-spacing:.03em}
    .conv-high{background:var(--bull);color:#fff} .conv-moderate{background:var(--warn);color:#fff} .conv-low{background:var(--grid);color:var(--muted)}
    .reco-conv.bear.conv-high{background:var(--bear)}
    .reco-exp-band{font-size:24px;font-weight:800;color:var(--ink);margin:2px 0 6px}
    .exp-track{position:relative;height:12px;border-radius:7px;background:var(--grid)}
    .exp-fill{position:absolute;top:0;bottom:0;border-radius:7px;background:color-mix(in srgb,var(--bull) 55%,var(--grid))}
    .exp-fill.t-bear{background:color-mix(in srgb,var(--bear) 50%,var(--grid))}
    .exp-kelly{position:absolute;top:-3px;bottom:-3px;width:3px;margin-left:-1.5px;background:var(--ink);border-radius:2px}
    .exp-scale{display:flex;justify-content:space-between;font-size:10px;color:var(--faint);margin-top:4px}
    .reco-lvls{display:grid;grid-template-columns:1fr 1fr;gap:10px 16px}
    .reco-lvls .lv .k{font-size:11px;color:var(--muted);font-weight:600;display:block}
    .reco-lvls .lv b{font-size:15px;color:var(--ink);font-weight:800}
    .reco-lvls .lv b.up{color:var(--bull)} .reco-lvls .lv b.down{color:var(--bear)}
    .reco-risk{font-size:12.5px;color:var(--bear);background:var(--bear-soft);border-radius:9px;padding:8px 11px;line-height:1.45}
    .reco-rats{display:flex;flex-wrap:wrap;gap:6px}
    .rchip{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:8px;background:var(--bg);border:1px solid var(--grid);color:var(--text)}
    html[data-theme="dark"] .rchip{background:var(--grid)}
    .rchip i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:middle}
    .rchip i.bull{background:var(--bull)} .rchip i.bear{background:var(--bear)} .rchip i.neutral{background:var(--neutral)}
    /* FORWARD-RETURN CONES */
    .cone-sub{color:var(--muted);font-size:12.5px;line-height:1.55;margin:8px 0 2px}
    .cone-legend{display:flex;flex-wrap:wrap;gap:16px;font-size:11px;color:var(--muted);margin:10px 0 12px}
    .cone-legend i{display:inline-block;vertical-align:middle;margin-right:6px}
    .cl-med{width:9px;height:9px;border-radius:50%;background:var(--muted);border:2px solid var(--card)}
    .cl-box{width:18px;height:9px;border-radius:3px;background:color-mix(in srgb,var(--muted) 30%,var(--card));border:1px solid var(--grid)}
    .cl-wh{width:18px;height:2px;background:color-mix(in srgb,var(--muted) 45%,var(--grid))}
    .cone-head{display:flex;align-items:center;gap:12px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);padding-bottom:4px;border-bottom:1px solid var(--grid)}
    .cone-head .ch-bar{flex:1}
    .cone-head .ch-s{width:84px;flex:none;text-align:right}
    .cone-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--grid)}
    .cone-row:first-of-type{border-top:none}
    .cone-h{width:34px;font-size:13px;font-weight:800;color:var(--ink);flex:none}
    .cone-bar{position:relative;flex:1;height:22px}
    .cone-axis{position:absolute;top:50%;left:0;right:0;height:2px;background:var(--grid);transform:translateY(-50%)}
    .cone-zero{position:absolute;top:1px;bottom:1px;width:1px;background:var(--muted);opacity:.6}
    .cone-whisk{position:absolute;top:50%;height:2px;transform:translateY(-50%);border-radius:2px}
    .cone-box{position:absolute;top:50%;height:13px;transform:translateY(-50%);border-radius:4px;opacity:.9}
    .cone-box.bull{background:color-mix(in srgb,var(--bull) 60%,var(--card))} .cone-whisk.bull{background:color-mix(in srgb,var(--bull) 38%,var(--grid))}
    .cone-box.bear{background:color-mix(in srgb,var(--bear) 55%,var(--card))} .cone-whisk.bear{background:color-mix(in srgb,var(--bear) 38%,var(--grid))}
    .cone-box.flat{background:color-mix(in srgb,var(--muted) 30%,var(--card))} .cone-whisk.flat{background:color-mix(in srgb,var(--muted) 36%,var(--grid))}
    .cone-med{position:absolute;top:50%;width:11px;height:11px;margin-left:-5.5px;transform:translateY(-50%);border-radius:50%;border:2px solid var(--card);box-shadow:0 0 0 1px var(--grid)}
    .cone-med.bull{background:var(--bull)} .cone-med.bear{background:var(--bear)} .cone-med.flat{background:var(--muted)}
    .cone-stat{width:84px;flex:none;text-align:right;font-size:10.5px;color:var(--faint);line-height:1.3}
    .cone-stat b{display:block;font-size:14px;font-weight:800;color:var(--ink)}
    .cone-stat b.bull{color:var(--bull)} .cone-stat b.bear{color:var(--bear)}
    /* collapsed section fold */
    details.sec-fold{margin-top:18px}
    details.sec-fold>summary{cursor:pointer;list-style:none;display:flex;align-items:baseline;gap:10px;
      font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;
      padding:10px 4px;border-radius:8px;user-select:none}
    details.sec-fold>summary::-webkit-details-marker{display:none}
    details.sec-fold>summary::before{content:"▸";font-size:11px;transition:transform .15s;color:var(--muted)}
    details.sec-fold[open]>summary::before{transform:rotate(90deg)}
    details.sec-fold>summary:hover{color:var(--ink)}
    details.sec-fold>summary .hint{font-weight:600;text-transform:none;letter-spacing:0;font-size:12px;color:var(--faint, var(--muted))}
    /* compact strip absorbed from old market-state hero */
    .cmd-mini{display:flex;flex-wrap:wrap;gap:10px 20px;margin-top:12px;padding-top:11px;border-top:1px solid var(--grid);align-items:flex-start}
    .cmd-mini-col{display:flex;flex-direction:column;gap:3px}
    .cmd-mini-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);margin-bottom:2px}
    .cmd-mini-chip{font-size:11.5px;font-weight:600;color:var(--muted)}
    .cmd-mini-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:4px;vertical-align:middle}
  </style>
  {% set tone_col = {'bull':'var(--blue)','bear':'var(--r3)','neutral':'var(--muted)'} %}
  {% set mcol = tone_col.get(master.tone,'var(--muted)') %}
  <div class="section-title" style="margin-top:6px">⌖ {{ t("Master Signal · today's verdict", '主信号 · 今日判断') }}</div>
  <div class="cmd">
    <div>
      <div class="cmd-h">{{ t('Strategic regime', '战略格局') }}</div>
      <div class="mg-wrap">
        <svg viewBox="0 0 280 150" width="280" height="150" aria-hidden="true">
          <defs><linearGradient id="mgarc" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="var(--r3)"/><stop offset="42%" stop-color="var(--muted)"/>
            <stop offset="58%" stop-color="var(--muted)"/><stop offset="100%" stop-color="var(--blue)"/>
          </linearGradient></defs>
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="var(--grid)" stroke-width="16" stroke-linecap="round"/>
          <path d="M22,140 A118,118 0 0 1 258,140" fill="none" stroke="url(#mgarc)" stroke-width="14" stroke-linecap="round" opacity=".92"/>
          <line x1="140" y1="20" x2="140" y2="34" stroke="var(--card)" stroke-width="3"/>
        </svg>
        <div class="mg-needle" style="background:{{ mcol }};transform:rotate({{ (master.gauge - 50) * 1.8 }}deg)"></div>
        <div class="mg-hub" style="background:{{ mcol }}"></div>
        <div class="mg-score" style="color:{{ mcol }}">{{ '%+d'|format(master.score) }}</div>
      </div>
      <div class="mg-ends"><span>{{ t('Risk-off','偏空') }}</span><span>{{ t('Risk-on','偏多') }}</span></div>
      <div class="mg-band" style="color:{{ mcol }}">{{ t(master.band, master.band_zh) }}</div>
      <div class="mg-tally"><b class="bu">{{ master.n_bull }}</b> {{ t('bullish','看多') }} · <b class="be">{{ master.n_bear }}</b> {{ t('bearish','看空') }} · {{ master.n_axes }} {{ t('axes','维度') }}</div>
    </div>
    <div>
      <div class="cmd-r-top">
        {# live.js patches the price + 24h change in place from the same-origin live snapshot
           (site/live/quotes.json, refreshed hourly 24/7 by the btc-live Action) — .nb-px / .nb-chg
           carry the canonical Yahoo symbol; the baked values below are the fallback until JS runs.
           Both live nodes hold ONLY the number: live.js overwrites textContent, so the "24h" label stays outside. #}
        <span class="cmd-price nb-px" data-sym="BTC-USD" data-mkt="crypto">{{ price|money }}</span>
        <span style="font-weight:700"><span class="nb-chg {{ 'up' if chg24>=0 else 'down' }}" data-sym="BTC-USD" data-mkt="crypto">{{ '%+0.2f'|format(chg24) }}%</span> {{ t('24h','24小时') }}</span>
        {% set cs_c = {'ACCUMULATE':'var(--blue)','RISK-ON':'var(--blue)','DISTRIBUTE':'var(--r3)','RISK-OFF':'var(--r3)','NEUTRAL':'var(--muted)'} %}
        {% set cs_z = {'ACCUMULATE':'累积','RISK-ON':'风险偏好','DISTRIBUTE':'派发','RISK-OFF':'风险规避','NEUTRAL':'中性'} %}
        <span class="cmd-stance" style="color:{{ cs_c.get(composite_state,'var(--muted)') }}">{{ t('Stance','立场') }}: {{ t(composite_state, cs_z.get(composite_state, composite_state)) }}</span>
        {% if composite_context == 'crowded_short' %}<span class="tip" data-tip-en="Crowded shorts can mark capitulation. Context only." data-tip-zh="空头拥挤可能代表投降式抛售。仅背景。" style="font-size:11.5px;font-weight:600;color:var(--blue);border:1px solid var(--blue);border-radius:999px;padding:1px 9px">⚠ {{ t('Crowded shorts · capitulation context', '空头拥挤 · 投降式背景') }}</span>{% elif composite_context == 'froth' %}<span class="tip" data-tip-en="Crowded longs can mark froth. Display-only." data-tip-zh="多头拥挤可能代表过热。仅展示。" style="font-size:11.5px;font-weight:600;color:var(--r3);border:1px solid var(--r3);border-radius:999px;padding:1px 9px">🔥 {{ t('Froth · crowded longs', '过热 · 多头拥挤') }}</span>{% endif %}
        {% if verdict and verdict.grade %}{% set vg = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
        <span style="font-size:11px;font-weight:800;color:#fff;background:{{ vg.get(verdict.grade,'var(--muted)') }};padding:3px 9px;border-radius:7px">{{ t(verdict.grade, verdict.grade_zh) }}</span>{% endif %}
      </div>
      <div class="cmd-head">{{ t(master.headline_en, master.headline_zh) }}</div>
      <div class="cmd-drv">
        <div class="col"><div class="ch">▲ {{ t('Pulling constructive','偏多拉力') }}</div>
          {% for d in master.drivers_pos %}<div class="drvchip"><i class="bull"></i><b>{{ t(d.label_en, d.label_zh) }}</b> <span>· {{ t(d.state_en, d.state_zh) }}</span></div>{% else %}<div class="drvchip"><span>{{ t('none meaningful','无明显') }}</span></div>{% endfor %}
        </div>
        <div class="col"><div class="ch">▼ {{ t('Pulling cautionary','偏空拉力') }}</div>
          {% for d in master.drivers_neg %}<div class="drvchip"><i class="bear"></i><b>{{ t(d.label_en, d.label_zh) }}</b> <span>· {{ t(d.state_en, d.state_zh) }}</span></div>{% else %}<div class="drvchip"><span>{{ t('none meaningful','无明显') }}</span></div>{% endfor %}
        </div>
      </div>
      <div class="cmd-act">
        <div class="a"><div class="k">{{ t('Risk Index','风险指数') }}</div><div class="v" style="color:{{ 'var(--blue)' if risk_on else 'var(--r3)' }}">{{ risk_index }}</div><div class="h">{{ td(risk_label) }}</div></div>
        {% if env and env.risk and env.risk.tail is not none %}<div class="a"><div class="k">{{ t('Next-7d drawdown','未来7天回撤') }}</div><div class="v" style="color:var(--r3)">{{ env.risk.avg }}%</div><div class="h">{{ t('worst','极端') }} {{ env.risk.tail }}%</div></div>{% else %}<div class="a"><div class="k">{{ t('Momentum','动量') }}</div><div class="v">{{ momentum }}</div><div class="h">{{ td(momentum_state) }}</div></div>{% endif %}
        <div class="a"><div class="k">{{ t('Model allocation','模型仓位') }}</div><div class="v" style="color:{{ 'var(--blue)' if alloc_pct>=50 else 'var(--r3)' }}">{{ alloc_pct }}%</div><div class="h">{% if gate.active %}{{ t('cycle timer','周期计时') }}{% elif sizing %}Kelly {{ sizing.size_pct }}%{% else %}BTC{% endif %}</div></div>
      </div>
      {# -- compact strip absorbed from old Market State hero -- #}
      <div class="cmd-mini">
        {# trend-by-timeframe dots #}
        {% if verdict and verdict.headline %}
        {% set tfc2 = {'up':'var(--blue)','down':'var(--r3)','flat':'var(--muted)'} %}
        {% set tlab2 = {'D':'D','3D':'3D','W':'W','2W':'2W','ME':'M'} %}
        <div class="cmd-mini-col">
          <div class="cmd-mini-label">{{ t('Trend by timeframe','各周期趋势') }}</div>
          <div style="font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:4px">{{ t(verdict.headline, verdict.headline_zh) }}</div>
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
            {% for r in mtf_rows %}
            <span style="display:inline-flex;align-items:center;gap:3px;font-size:11px;color:var(--muted)"><i style="width:8px;height:8px;border-radius:50%;background:{{ tfc2.get(r.trend,'var(--muted)') }}"></i>{{ tlab2.get(r.key, r.key) }}</span>
            {% endfor %}
            <span class="faint" style="font-size:10px"> · {{ t('short','短') }} {{ '↑' if verdict.short_sign>0 else ('↓' if verdict.short_sign<0 else '→') }} · {{ t('mid','中') }} {{ '↑' if verdict.mid_sign>0 else ('↓' if verdict.mid_sign<0 else '→') }} · {{ t('long','长') }} {{ '↑' if verdict.long_sign>0 else ('↓' if verdict.long_sign<0 else '→') }}</span>
          </div>
        </div>
        {% endif %}
        {# cycle stage slider compact #}
        <div class="cmd-mini-col">
          <div class="cmd-mini-label">{{ t('Cycle stage','周期阶段') }}</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            {% for s in ['Defensive','Fragile','Recovery','Expansion'] %}
            <span style="font-size:11.5px;font-weight:{{ '800' if s==cycle_stage else '500' }};color:{{ 'var(--ink)' if s==cycle_stage else 'var(--faint)' }}">{{ td(s) }}</span>
            {% endfor %}
          </div>
        </div>
        {# vol + flow chips #}
        <div class="cmd-mini-col">
          <div class="cmd-mini-label">{{ t('Vol · Flow','波动 · 流量') }}</div>
          <div style="display:flex;gap:8px;align-items:center">
            <span class="cmd-mini-chip">{{ t('Vol','波动') }}: <b>{{ td(vol_state) }}</b>{% if vol_side %} · {{ td(vol_side) }}{% endif %}</span>
            <span class="cmd-mini-chip">{{ t('Flow','流量') }}: <b>{{ td(flow_state) }}</b></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  {# ---------------- THE RECOMMENDATION (the actionable decision) ---------------- #}
  {# Fix #34 + W3: suppress the recommendation card during a blackout. Both pages read
     rec.suppressed_by_blackout, stamped in build_vector.py from the ONE gate_state()
     object (engine.btc_signals) — no per-template re-derivation, so the guard cannot
     drift between pages. #}
  {% if rec and rec.ok and not rec.suppressed_by_blackout %}
  {% set rt = rec.tone %}
  {% set L = rec.levels %}
  <div class="reco">
    <div class="reco-l t-{{ rt }}">
      <div class="reco-k">▶ {{ t('Recommendation · strategic','建议 · 战略') }}</div>
      <div class="reco-act t-{{ rt }}">{{ t(rec.action, rec.action_zh) }}</div>
      <div class="reco-meta">
        <span class="reco-conv {{ rt }} conv-{{ rec.conviction|lower }}">{{ t(rec.conviction ~ ' conviction', rec.conviction ~ ' 信心') }}</span>
        <span>· {{ t(rec.basis_en, rec.basis_zh) }}</span>
        <span>· {{ t(rec.horizon_en, rec.horizon_zh) }}</span>
      </div>
      {% if rec.directional %}<div class="reco-meta" style="margin-top:8px;color:var(--bull)"><b>{{ t('Directional call — measured at this extreme','方向性判断 — 该极值经实测') }}</b></div>
      {% else %}<div class="reco-meta" style="margin-top:8px">{{ t('Direction ~coin-flip — this sizes drawdown, not price.','方向近似抛硬币 — 这是回撤管理仓位，而非价格预测。') }}</div>{% endif %}
      <div class="reco-rats" style="margin-top:12px">
        {% for d in rec.rationale %}<span class="rchip"><i class="{{ d.tone }}"></i>{{ t(d.label_en, d.label_zh) }} · {{ t(d.state_en, d.state_zh) }}</span>{% endfor %}
      </div>
    </div>
    <div class="reco-r">
      <div>
        <div class="reco-k">{{ t('Target BTC exposure','目标 BTC 仓位') }}</div>
        <div class="reco-exp-band">{{ rec.exposure_lo }}–{{ rec.exposure_hi }}%</div>
        <div class="exp-track">
          <div class="exp-fill {{ 't-bear' if rt=='bear' else '' }}" style="left:{{ rec.exposure_lo }}%;width:{{ rec.exposure_hi - rec.exposure_lo }}%"></div>
          {% if rec.kelly_pct is not none %}<div class="exp-kelly" style="left:{{ rec.kelly_pct }}%" title="Kelly-sized"></div>{% endif %}
        </div>
        <div class="exp-scale"><span>0% {{ t('cash','现金') }}</span><span>{{ t('Kelly','Kelly') }} {{ rec.kelly_pct }}%</span><span>100% {{ t('BTC','BTC') }}</span></div>
      </div>
      <div class="reco-lvls">
        {% if L.accumulate_lo and L.accumulate_hi %}<div class="lv"><span class="k">{{ t('Accumulate zone','累积区间') }}</span><b>${{ '{:,}'.format(L.accumulate_lo) }}–${{ '{:,}'.format(L.accumulate_hi) }}</b></div>{% endif %}
        {% if L.invalidation %}<div class="lv"><span class="k">{{ t(L.invalid_label_en, L.invalid_label_zh) }}</span><b>${{ '{:,}'.format(L.invalidation) }}</b></div>{% endif %}
        {% if L.downside_90 and L.upside_90 %}<div class="lv" style="grid-column:1/3"><span class="k">{{ t('90-day range (cone p25→p75)','90 天区间（锥体 p25→p75）') }}</span><b class="down">${{ '{:,}'.format(L.downside_90) }}</b> → <b class="up">${{ '{:,}'.format(L.upside_90) }}</b></div>{% endif %}
      </div>
      {% if rec.key_risk_en %}<div class="reco-risk">⚠ {{ t(rec.key_risk_en, rec.key_risk_zh) }}</div>{% endif %}
    </div>
  </div>
  {% endif %}

  {# ---------------- MACRO-REGIME SCORECARD · five-tier composite (DISPLAY-ONLY) [collapsed] ---------------- #}
  {% if regime and regime.ok %}
  {% set rtone = {'bull':'var(--bull)','bull-soft':'var(--blue)','neutral':'var(--muted)','bear-soft':'var(--amber)','bear':'var(--r3)'} %}
  {% set rcol = rtone.get(regime.band_tone, 'var(--muted)') %}
  {% set fl = regime.flags %}
  <style>
  .rgc-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:16px}
  @media(max-width:760px){.rgc-grid{grid-template-columns:1fr}}
  .rgc-meter{height:12px;border-radius:7px;background:linear-gradient(90deg,var(--r3),var(--amber) 38%,var(--muted) 50%,var(--blue) 64%,var(--bull));position:relative;margin:10px 0 4px}
  .rgc-mk{position:absolute;top:-4px;width:4px;height:20px;border-radius:2px;background:var(--ink);box-shadow:0 0 0 2px var(--card)}
  .rgc-tier{display:grid;grid-template-columns:96px 1fr 42px;align-items:center;gap:10px;margin:7px 0;font-size:12.5px}
  .rgc-bar{height:9px;border-radius:5px;background:var(--hair);position:relative;overflow:hidden}
  .rgc-bar > i{position:absolute;top:0;height:100%;border-radius:5px}
  .rgc-fac{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;border:1px solid var(--hair);font-size:11.5px;margin:3px 4px 3px 0}
  .rgc-org{font-size:9px;text-transform:uppercase;letter-spacing:.04em;opacity:.6;font-weight:700}
  .rgc-flag{border:1px solid var(--hair);border-radius:10px;padding:10px 12px;font-size:12px}
  .rgc-cond{display:flex;align-items:center;gap:6px;margin:3px 0;font-size:11.5px}
  .rgc-dot{width:7px;height:7px;border-radius:50%;flex:none}
  </style>
  <details class="sec-fold" id="macro-regime-scorecard">
  <summary>🧭 {{ t('Macro-Regime Scorecard · advanced', '宏观格局记分卡 · 进阶') }} <span class="hint">{{ t('Five-tier composite backdrop · display-only', '五层综合背景 · 仅供参考') }}</span></summary>
  <div class="card" style="padding:18px 22px">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
      <div style="display:flex;align-items:baseline;gap:12px">
        <div style="font-size:30px;font-weight:800;color:{{ rcol }};font-variant-numeric:tabular-nums">{{ regime.index|round|int }}</div>
        <div>
          <div style="font-weight:700;color:{{ rcol }}">{{ t(regime.band, regime.band_zh) }}{% if regime.thin %} · <span class="faint">{{ t('thin','数据稀疏') }}</span>{% endif %}</div>
          <div class="faint" style="font-size:11.5px">{{ t('0 = strong headwind · 100 = strong tailwind','0 = 强逆风 · 100 = 强顺风') }}</div>
        </div>
      </div>
      <div style="text-align:right">
        <span class="chip" style="border-color:{{ rcol }};color:{{ rcol }}">{{ t('DISPLAY-ONLY · does not size','仅供参考 · 不用于定仓') }}</span>
        {% if regime.mode_lean and regime.mode_lean.ok %}<div class="faint" style="font-size:11.5px;margin-top:5px">{{ t('regime mode','格局模式') }}: <b style="color:var(--ink)">{{ t(regime.mode_lean.chip, regime.mode_lean.chip_zh) }}</b></div>{% endif %}
      </div>
    </div>
    <div class="rgc-meter"><div class="rgc-mk" style="left:calc({{ regime.index }}% - 2px)"></div></div>
    <div class="faint" style="font-size:11.5px">{{ t('Context exposure band (NOT a position):','参考仓位区间（非实际仓位）：') }} <b style="color:var(--ink)">{{ (regime.exposure_display*100)|round|int }}%</b> · {{ regime.n_live }} {{ t('live factors','有效因子') }}</div>

    <div class="rgc-grid" style="margin-top:14px">
      {# ---- per-tier sub-scores ---- #}
      <div>
        <div class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px">{{ t('Transmission tiers','传导层') }}</div>
        {% for tr_ in regime.tiers %}
        {% set nv = tr_.norm if tr_.norm is not none else 0 %}
        {% set tcol = 'var(--bull)' if nv > 0.05 else ('var(--r3)' if nv < -0.05 else 'var(--muted)') %}
        {% set wpct = (nv*50)|abs|round|int %}
        <div class="rgc-tier">
          <span>{{ tr_.tier }} <span class="faint">{{ t(tr_.label, tr_.label) }}</span></span>
          <span class="rgc-bar"><i style="background:{{ tcol }};{{ 'left' if nv>=0 else 'right' }}:50%;width:{{ wpct }}%"></i><i style="left:50%;width:1px;background:var(--muted);opacity:.4"></i></span>
          <span style="text-align:right;color:{{ tcol }};font-variant-numeric:tabular-nums">{{ '%+0.0f'|format(tr_.sub) }}</span>
        </div>
        {% endfor %}
        <div style="margin-top:10px">
          {% for f in regime.factors %}
          {% set fc = 'var(--bull)' if (f.score or 0) > 0 else ('var(--r3)' if (f.score or 0) < 0 else 'var(--muted)') %}
          <span class="rgc-fac" style="{{ 'opacity:.45' if not f.present else '' }}">
            <b style="color:{{ fc }};font-variant-numeric:tabular-nums">{{ ('%+d'|format(f.score)) if f.present else '–' }}</b>
            {{ t(f.label, f.label) }}
            <span class="rgc-org">{{ f.origin }}</span>
          </span>
          {% endfor %}
        </div>
      </div>

      {# ---- confluence tail flags ---- #}
      <div>
        <div class="faint" style="font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-bottom:4px">{{ t('Confluence tail flags','合流尾部信号') }}</div>
        <div style="font-size:12.5px;margin-bottom:8px">
          {% if fl and fl.ok %}
          {% if fl.active == 'STAY-AWAY' %}<b style="color:var(--r3)">🔴 {{ t('STAY-AWAY','回避') }}</b>
          {% elif fl.active == 'DOUBLE-DOWN' %}<b style="color:var(--bull)">🟢 {{ t('DOUBLE-DOWN','加倍') }}</b>
          {% else %}<b class="faint">{{ t('No tail flag active','无尾部信号') }}</b>{% endif %}
          <span class="faint">· {{ t('needs ≥5 of 8 (count illustrative on ~5 cycles)','需 ≥5/8（约 5 个周期下计数仅供参考）') }}</span>
          {% endif %}
        </div>
        {% if fl and fl.ok %}
        <div class="rgc-flag" style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between"><b style="color:var(--r3)">{{ t('Stay-away','回避') }}</b><span style="font-variant-numeric:tabular-nums">{{ fl.stay_away.count }}/{{ fl.stay_away.n_available }} · k4/5/6: {{ '✓' if fl.stay_away.fires_at_k[4] else '·' }}{{ '✓' if fl.stay_away.fires_at_k[5] else '·' }}{{ '✓' if fl.stay_away.fires_at_k[6] else '·' }}</span></div>
          {% for c in fl.stay_away.conditions %}<div class="rgc-cond"><span class="rgc-dot" style="background:{{ 'var(--r3)' if c.fired else 'var(--hair)' }}"></span>{{ t(c.label, c.label) }}{% if c.prov %} <span class="faint" style="font-size:10px">({{ t('shared','共享') }})</span>{% endif %}</div>{% endfor %}
        </div>
        <div class="rgc-flag">
          <div style="display:flex;justify-content:space-between"><b style="color:var(--bull)">{{ t('Double-down','加倍') }}</b><span style="font-variant-numeric:tabular-nums">{{ fl.double_down.count }}/{{ fl.double_down.n_available }} · {{ t('prereq','前提') }}: {{ '✓' if fl.double_down.prereq_ok else '✗' }}</span></div>
          {% for c in fl.double_down.conditions %}<div class="rgc-cond"><span class="rgc-dot" style="background:{{ 'var(--bull)' if c.fired else 'var(--hair)' }}"></span>{{ t(c.label, c.label) }}</div>{% endfor %}
          {% if fl.double_down.override %}<div class="faint" style="font-size:11px;margin-top:4px">⛔ {{ t('suppressed by trend filter (Override #1)','受趋势过滤抑制（覆盖规则 #1）') }}</div>{% endif %}
        </div>
        {% if fl.onchain_panel and fl.onchain_panel.ok %}
        <div class="faint" style="font-size:11.5px;margin-top:8px">{{ t('On-chain panel (rolling-percentile):','链上面板（滚动分位）：') }}
          {% if fl.onchain_panel.depressed_co_flash %}<b style="color:var(--bull)">{{ t('cheap · panel-confirmed','便宜 · 面板确认') }}</b>
          {% elif fl.onchain_panel.stretched_co_flash %}<b style="color:var(--r3)">{{ t('rich · panel-confirmed','偏贵 · 面板确认') }}</b>
          {% else %}<b>{{ t('no co-flash','无共振') }}</b>{% endif %}
          <span>({{ fl.onchain_panel.n_depressed }}↓ / {{ fl.onchain_panel.n_stretched }}↑ {{ t('of','/') }} {{ fl.onchain_panel.n }})</span>
        </div>
        {% endif %}
        {% endif %}
      </div>
    </div>
    {% set cl = regime.context_legs %}
    {% if cl %}
    <div id="leverage" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:14px">
      {% if cl.netliq and cl.netliq.ok %}<span class="rgc-fac">🌊 {{ t('Net-liquidity','净流动性') }}: <b>{{ t(cl.netliq.impulse_state, cl.netliq.impulse_state) }}</b></span>{% endif %}
      {% if cl.leverage and cl.leverage.ok %}
      {% set lev_col = {'high':'var(--red)','elevated':'var(--warn)'} %}
      {% set _lc = lev_col.get(cl.leverage.cascade_risk,'') %}
      {% set _oi_gated = cl.leverage.reliability and cl.leverage.reliability.oi_only_risk and cl.leverage.reliability.oi_only_risk.gated_out %}
      <span class="rgc-fac" style="{% if _lc %}border-color:{{ _lc }};color:{{ _lc }}{% endif %}">⚡ {{ t('Leverage','杠杆') }}: <b>{{ t(cl.leverage.cascade_risk, cl.leverage.cascade_risk) }}</b>{% if cl.leverage.cascade_risk=='low' and cl.leverage.oi_only_risk and cl.leverage.oi_only_risk != 'low' %} · <span class="muted" data-tip-en="Positioning context only." data-tip-zh="仅为持仓背景。">{{ t('OI crowding','持仓拥挤') }} {{ t(cl.leverage.oi_only_risk, cl.leverage.oi_only_risk) }}{% if _oi_gated %} ({{ t('context','参考') }}){% endif %}</span>{% endif %}{% if cl.leverage.derisk_cap %} · {{ t('cap','上限') }} {{ (cl.leverage.derisk_cap*100)|round|int }}%{% endif %}</span>
      {% endif %}
      {% if cl.dat and cl.dat.ok and cl.dat.mnav is not none %}<span class="rgc-fac" style="{{ 'border-color:var(--r3)' if cl.dat.state=='discount' else '' }}">🏛 {{ t('MSTR mNAV','MSTR mNAV') }}: <b>{{ '%.2f'|format(cl.dat.mnav) }}×</b> {{ t(cl.dat.state, cl.dat.state) }}</span>{% endif %}
      {% if cl.etf_perfund and cl.etf_perfund.ok and cl.etf_perfund.ibit_share is not none %}<span class="rgc-fac">📊 IBIT {{ (cl.etf_perfund.ibit_share*100)|round|int }}%</span>{% endif %}
    </div>
    {% endif %}
    <div class="sub faint" style="margin-top:12px;font-size:11.5px">{{ t('Fixed weights. This block flags risk, but does not set position size.', '固定权重。本模块提示风险，但不决定仓位。') }}</div>
    {% if regime.ledger and regime.ledger.honesty_note %}<div class="sub faint" style="margin-top:6px;font-size:11.5px">📒 {{ t('Forward ledger','前瞻账本') }}: {{ t(regime.ledger.honesty_note, regime.ledger.honesty_note_zh) }}</div>{% endif %}
  </div>
  </details>
  {% endif %}

  {# ---------------- BTC ALLOCATION + CONES · cols-2 row ---------------- #}
  {# ALLOCATION CARD (moved up from old Market State grid) #}
  {# gcol/gcolor must be set here as convcard uses them later #}
  {% set gcol = {'CAUTION':'var(--amber)','AVOID':'var(--r3)','TREND-FOLLOW':'var(--blue)','BUY-THE-DIP':'var(--blue)','WAIT':'var(--muted)'} %}
  {% set gcolor = gcol.get(verdict.grade,'var(--muted)') %}
  <div class="grid cols-2" style="margin-top:18px">
    <!-- allocation -->
    <div class="card">
      <h2>{{ t('BTC Allocation · Optimal strategy', 'BTC 仓位 · 最优策略') }}</h2>
      {% if gate.active %}
      <div style="margin:2px 0 12px;padding:11px 13px;border:1px solid var(--amber);border-radius:11px;background:color-mix(in srgb, var(--amber) 9%, transparent)">
        <div style="font-weight:700;font-size:13.5px;color:var(--amber)">⏳ {{ t('Proprietary cycle timer · holding cash', '专有周期计时器 · 持有现金') }}</div>
        <div class="sub" style="margin-top:5px;font-size:12.5px">{{ t('Cycle timing flags this as a stay-out window — tactical model overridden to 0%, re-engaging around','周期择时判定为 BTC 回避窗口，战术模型覆盖为 0%，将在以下时间前后重新参与') }} <b>{{ gate.release or '—' }}</b>.</div>
      </div>
      {% endif %}
      <div class="allocbar">
        {% if alloc_pct > 0 %}<div class="btc" style="width:{{ alloc_pct }}%">{{ alloc_pct }}% BTC</div>{% endif %}
        {% if alloc_pct < 100 %}<div class="cash" style="width:{{ 100-alloc_pct }}%">{{ 100-alloc_pct }}% {{ t('Cash', '现金') }}</div>{% endif %}
      </div>
      <div class="sub" style="margin-top:10px">{{ t('Market mode:', '市场模式：') }}
        <span class="chip {{ 'chip-strategic' if market_mode=='Strategic' else 'chip-tactical' }}">{{ td(market_mode) }}</span>
        · {{ t('BTC vs Alts leader:', 'BTC vs 山寨币 领先：') }} <b>{{ td(alt_leader) }}</b></div>
      {% if sizing and not gate.active %}
      <div class="mini" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:11px"><div class="lab" style="border:none;padding-top:0"><span>{{ t('Risk-budgeted Kelly size','风险预算 Kelly 仓位') }}{{ qmark('Suggested size after capping for drawdown risk.','按回撤风险封顶后的建议仓位。') }} <span class="faint" style="font-size:11px">({{ '½' if sizing.kelly_frac==0.5 else (sizing.kelly_frac|string) }}-Kelly, {{ sizing.dd_budget }}% {{ t('DD budget','回撤预算') }})</span></span><span><b style="font-size:17px;color:{{ 'var(--blue)' if sizing.size_pct>=40 else 'var(--r3)' }}">{{ sizing.size_pct }}%</b></span></div></div>
      <div class="sub faint" style="margin-top:4px;font-size:12px">{{ t('Sized off a','基于') }} <b>{{ '%+0.0f'|format(sizing.edge_90) }}%/90d</b> {{ t('edge in the','优势，处于') }} {{ td(sizing.stance|capitalize) }} {{ t('regime (σ','格局（σ') }} {{ sizing.vol_90 }}%){% if sizing.binding=='tail' %} · {{ t('held back by the','受限于') }} {{ sizing.tail_90 }}% {{ t('worst-case dip','极端回撤') }}{% endif %}.</div>
      {% endif %}
      {% if alloc_sizing and not gate.active %}
      <div class="mini" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:11px"><div class="lab" style="border:none;padding-top:0"><span>{{ t('Bottom-detector overlay','底部探测叠加') }} <span class="faint" style="font-size:11px">({{ t('adds size at washout lows','洗盘低点加仓') }})</span></span><span><b style="font-size:16px;color:{{ 'var(--blue)' if alloc_sizing.bottom_active else 'var(--muted)' }}">{{ t('Pressure','压力') }} {{ alloc_sizing.bottom_pressure }}/100{% if alloc_sizing.bottom_active %} · +{{ alloc_sizing.bottom_add }}%{% endif %}</b></span></div></div>
      <div class="sub faint" style="margin-top:4px;font-size:12px">{% if alloc_sizing.bottom_active %}{{ t('Washout bottom forming — overlay adding','洗盘底部正在形成 — 叠加加仓') }} <b>+{{ alloc_sizing.bottom_add }}%</b> {{ t('to buy in lower.','以更低价买入。') }}{% else %}{{ t('Dormant — adds size only at washed-out lows; backtested +15.6% at same Sharpe.','休眠中 — 仅在洗盘低点加仓；回测 +15.6%，夏普持平。') }}{% endif %}</div>
      {% endif %}
      {% if catalyst %}
      <div class="sub" style="margin-top:8px;font-size:12px;color:{{ 'var(--amber)' if catalyst.imminent else 'var(--muted)' }}">{% if catalyst.imminent %}⚠ {% endif %}{{ t('Next macro binary:','下一宏观二元事件：') }} <b>{{ td(catalyst.next_event) }}</b> {{ t('in','还有') }} {{ catalyst.days }} {{ t('day' if catalyst.days==1 else 'days','天') }} ({{ catalyst.next_date }}){% if catalyst.imminent %} — {{ t('expect a vol jump; the Kelly size models neither the gap nor the vol crush, so don\'t size up into it.','预期波动跳升；Kelly 仓位既不计入跳空也不计入波动收敛，故勿在此前加仓。') }}{% endif %}</div>
      {% endif %}
      <a href="vector_allocation.html" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px;padding:11px 14px;border:1px solid var(--grid);border-radius:11px;background:var(--bg);text-decoration:none;color:var(--ink);font-weight:600;font-size:13.5px">
        <span>◎ {{ t('Full allocation strategy — BTC · ETH · alts · cash', '完整仓位策略 — BTC · ETH · 山寨 · 现金') }}</span>
        <span style="color:var(--blue);font-size:16px">→</span>
      </a>
    </div>
    {# -- CONES CARD (moved here from old location after macro-regime scorecard) -- #}
    {% if cones and cones.ok and cones.horizons %}
    {% set ch = cones.horizons %}
    {% set cvals = [] %}
    {% for k in ['7d','30d','90d'] %}{% set _h = ch.get(k) %}{% if _h and _h.p95 is not none and _h.p5 is not none %}{% set _ = cvals.append(_h.p95|abs) %}{% set _ = cvals.append(_h.p5|abs) %}{% endif %}{% endfor %}
    {% set cscale = (cvals|max) if cvals else 50 %}
    {% macro cpct(v) %}{{ [[(50 + 50*v/cscale), 2]|max, 98]|min }}{% endmacro %}
    {% set degraded = [] %}
    {% for k in ['7d','30d','90d'] %}{% set _h = ch.get(k) %}{% if _h and (_h.thin or (_h.cond and _h.cond != cones.regime)) %}{% set _ = degraded.append(k) %}{% endif %}{% endfor %}
    <div class="card" style="padding:18px 22px">
      <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
        <h3 style="margin:0">{{ t('What BTC did next · on days like today','类似今日的历史日 · BTC 后续走势') }}</h3>
        <span class="faint" style="font-size:12px">{{ t('history matched to regime:','匹配格局：') }} <b style="color:var(--ink)">{{ cones.regime or t('all history','全历史') }}</b></span>
      </div>
      <div class="cone-sub">{{ t('What BTC actually did over the next 7/30/90 days on past days like today — history, not a forecast.','历史上与今日相似的每一天，BTC 在随后 7/30/90 天的真实表现 —— 是历史，不是预测。') }}</div>
      <div class="cone-legend">
        <span><i class="cl-wh"></i>{{ t('5th–95th percentile','5–95 百分位') }}</span>
        <span><i class="cl-box"></i>{{ t('middle 50% of outcomes','中间 50% 的结果') }}</span>
        <span><i class="cl-med"></i>{{ t('median','中位数') }}</span>
      </div>
      <div class="cone-head">
        <span class="cone-h"></span>
        <span class="ch-bar">{{ t('range of next-period returns','下一周期收益区间') }}</span>
        <span class="ch-s">{{ t('typical','典型') }}</span>
        <span class="ch-s">{{ t('odds ↑','上涨概率') }}</span>
      </div>
      {% for k in ['7d','30d','90d'] %}{% set h = ch.get(k) %}{% if h and h.p50 is not none %}
        {% set edge = ((h.p_up - h.base_up) * 100) if (h.p_up is not none and h.base_up is not none) else 0 %}
        {% set tilt = 'flat' if (h.thin or edge|abs < 5) else ('bull' if edge >= 5 else 'bear') %}
        {% set edgecol = 'var(--muted)' if tilt == 'flat' else ('var(--bull)' if tilt == 'bull' else 'var(--bear)') %}
        <div class="cone-row" {% if h.thin %}style="opacity:.62"{% endif %}>
          <span class="cone-h">{{ k }}</span>
          <div class="cone-bar">
            <div class="cone-axis"></div>
            <div class="cone-zero" style="left:{{ cpct(0) }}%"></div>
            <div class="cone-whisk {{ tilt }}" style="left:{{ cpct(h.p5) }}%;width:{{ cpct(h.p95)|float - cpct(h.p5)|float }}%"></div>
            <div class="cone-box {{ tilt }}" style="left:{{ cpct(h.p25) }}%;width:{{ cpct(h.p75)|float - cpct(h.p25)|float }}%"></div>
            <div class="cone-med {{ tilt }}" style="left:{{ cpct(h.p50) }}%"></div>
          </div>
          <div class="cone-stat">
            <b class="{{ tilt }}">{{ '%+.1f'|format(h.p50) }}%</b>
            {{ '%+.0f'|format(h.p25) }}…{{ '%+.0f'|format(h.p75) }}%
          </div>
          <div class="cone-stat">
            <b style="color:{{ edgecol }}">{{ (h.p_up*100)|round|int }}%</b>
            {{ t('base','基准') }} {{ (h.base_up*100)|round|int }}%
          </div>
        </div>
      {% endif %}{% endfor %}
      <div class="exp-scale" style="margin-top:6px"><span>−{{ cscale|round|int }}%</span><span>0</span><span>+{{ cscale|round|int }}%</span></div>
      <div class="sub faint" style="margin-top:10px;font-size:11.5px">
        {{ t('Typical = median. Odds ↑ = how often BTC was higher by then. Small gaps mean no direction edge.','典型 = 中位数。上涨概率 = 到期时 BTC 收高的频率。差距小则无方向优势。') }}
        {% if degraded %}<br>{{ t('Limited regime-matched history — using a wider sample:','格局匹配样本有限 —— 已采用更宽样本：') }} {% for k in degraded %}{% set _h = ch.get(k) %}<b>{{ k }}</b> {{ _h.cond }} (n={{ _h.n }}){{ ' · ' if not loop.last }}{% endfor %}{% endif %}
      </div>
    </div>
    {% else %}
    <div></div>
    {% endif %}
  </div>

  <!-- ===================== SIGNAL BOARD ===================== -->
  <div class="section-title">{{ t('Signal Board · every axis at a glance', '信号面板 · 一览全维度') }}</div>
  <div class="board">
    {% for grp in master.board %}
    <div class="bgrp">
      <h4>{{ t(grp.group_en, grp.group_zh) }}</h4>
      {% for r in grp.rows %}
      <div class="brow">
        <span class="dot {{ r.tone }}"></span>
        <span class="lab">{{ t(r.label_en, r.label_zh) }}</span>
        {% if r.grade %}<span class="gr gr-{{ r.grade }}">{{ r.grade }}</span>{% else %}<span></span>{% endif %}
        <span class="st">{{ t(r.state_en, r.state_zh) }}</span>
        {% if r.spark %}<svg class="spk {{ r.tone }}" viewBox="0 0 100 26" preserveAspectRatio="none"><polyline points="{{ r.spark }}"/></svg>{% else %}<span></span>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="sub faint" style="margin:8px 4px 4px;font-size:12px">{{ t('Grade = track record. CONFIRMED is strongest; CONTEXT is descriptive; NEW is still building history.', '评级 = 历史记录。CONFIRMED 最强；CONTEXT 仅描述；NEW 仍在积累历史。') }}</div>
  {% endif %}

  <!-- ===================== IMPULSE RADAR (forward pressure) ===================== -->
  {% set ir = regime.context_legs.impulse_radar if regime.context_legs else none %}
  {% if ir and ir.ok %}
  {% set lad_col = {'quiet':'var(--muted)','coiled':'var(--blue)','warning':'var(--warn)','trigger':'var(--red)'} %}
  {% set lad_lab = {'quiet':'Quiet','coiled':'Coiled · loading','warning':'WARNING','trigger':'TRIGGER'} %}
  {% set lad_zh = {'quiet':'平静','coiled':'蓄势','warning':'警告','trigger':'触发'} %}
  <div class="card" id="impulse" style="margin-bottom:18px">
    <h2>{{ t('Impulse Radar · forward pressure','脉冲雷达 · 前瞻压力') }}</h2>
    <div class="sub" style="margin-top:2px">{{ t('Leading warning-crosses only — it spikes on a cross, then fades; background signals alone can\'t pass "coiled".','仅跟踪领先预警突破 — 突破时升级，随后衰减；仅背景信号无法超过"蓄势"。') }}</div>
    {% if ir.staleness and ir.staleness.stale %}
    <div style="margin-top:10px;padding:8px 12px;border-radius:8px;background:var(--bear-soft);border:1px solid var(--bear);color:var(--bear);font-weight:600;font-size:12.5px">⚠ {{ t('Intraday data STALE — freshest hourly candle','日内数据过期 — 最新小时K线') }} {{ ir.staleness.intraday_asof }} ({{ t('daily close','日线收盘') }} {{ ir.staleness.daily_asof }}). {{ t('An intraday flush could go unseen — check the hourly feed.','日内闪跌可能无法被捕捉 — 请检查小时数据源。') }}</div>
    {% endif %}
    <div class="grid cols-2" style="margin-top:12px">
      {% for g in [ir.down, ir.up] %}
      {% set gnm = 'Down' if loop.first else 'Up' %}{% set gnm_zh = '下行' if loop.first else '上行' %}
      <div style="border:1px solid var(--grid);border-radius:12px;padding:13px 15px;background:var(--bg)">
        <div style="display:flex;justify-content:space-between;align-items:baseline">
          <b style="font-size:13px;color:var(--ink)">{{ t(gnm,gnm_zh) }}-{{ t('impulse','脉冲') }}</b>
          <span style="font-weight:800;font-size:11.5px;padding:2px 9px;border-radius:7px;color:#fff;background:{{ lad_col.get(g.ladder,'var(--muted)') }}">{{ t(lad_lab.get(g.ladder,g.ladder), lad_zh.get(g.ladder,g.ladder)) }}</span>
        </div>
        <div style="margin-top:9px;height:9px;border-radius:6px;background:var(--grid);overflow:hidden"><div style="height:100%;width:{{ g.score }}%;background:{{ lad_col.get(g.ladder,'var(--muted)') }}"></div></div>
        <div class="faint" style="font-size:11px;margin-top:4px">{{ t('pressure','压力') }} {{ g.score }}/100{% if not g.act_live %} · {{ t('no act-tier cross (context only)','无行动级突破（仅背景）') }}{% endif %}</div>
        <div style="margin-top:9px;display:flex;flex-direction:column;gap:3px">
          {% for l in g.legs if l.points > 0 %}
          <div style="display:flex;justify-content:space-between;font-size:11.5px">
            <span style="color:{{ 'var(--ink)' if l.tier=='act' else 'var(--muted)' }}">{{ '●' if l.tier=='act' else '○' }} {{ t(l.label, l.label) }}</span>
            <span class="faint">{{ l.points }}{% if l.fired_today %} · {{ t('fresh','新触发') }}{% elif l.days_since is not none %} · {{ l.days_since }}d{% endif %}</span>
          </div>
          {% else %}
          <div class="faint" style="font-size:11px">{{ t('no live legs','无活跃因子') }}</div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px">
      {% if ir.fuel_gauge %}<span class="rgc-fac" style="{{ 'border-color:var(--warn);color:var(--warn)' if ir.fuel_gauge.lit else '' }}">🔋 {{ t('Fuel','燃料') }}{{ qmark('How much fuel exists for a sharp move: open interest plus volatility instability.','剧烈波动的燃料：持仓规模加波动不稳定度。') }}: OI {{ (ir.fuel_gauge.oi_pctile*100)|round|int if ir.fuel_gauge.oi_pctile is not none else '—' }}%ile × vov {{ (ir.fuel_gauge.vov_pctile*100)|round|int if ir.fuel_gauge.vov_pctile is not none else '—' }}%ile{% if ir.fuel_gauge.lit %} · {{ t('loading','蓄能') }}{% endif %}</span>{% endif %}
      {% if ir.cascade and ir.cascade.oi_only_risk and ir.cascade.oi_only_risk != 'low' %}{% set _oi_gated = ir.cascade.reliability and ir.cascade.reliability.oi_only_risk and ir.cascade.reliability.oi_only_risk.gated_out %}<span class="rgc-fac muted" data-tip-en="Positioning texture only; not a de-risk signal by itself." data-tip-zh="仅为持仓背景；本身不是减仓信号。">⚡ {{ t('OI crowding','持仓拥挤') }}: <b>{{ t(ir.cascade.oi_only_risk, ir.cascade.oi_only_risk) }}</b>{% if _oi_gated %} <span class="muted sm">({{ t('context only','仅供参考') }})</span>{% endif %}</span>{% endif %}
    </div>
    {% set cv = regime.context_legs.intraday_cvd if regime.context_legs else none %}
    {% if cv and cv.ok %}
    {% set cvcol = {'distribution':'var(--bear)','accumulation':'var(--blue)','neutral':'var(--muted)'} %}
    <div class="sub faint" style="margin-top:8px;font-size:11px;border-top:1px solid var(--grid);padding-top:8px">🌊 {{ t('Intraday buy–sell pressure','日内买卖压力') }}: {% if cv.stale %}<b style="color:var(--bear)">⚠ {{ t('stale','过期') }}{% if cv.hours_behind_ref is not none %} ({{ cv.hours_behind_ref|round|int }}h)</b>{% else %}</b>{% endif %}{% else %}<b style="color:{{ cvcol.get(cv.flow_state,'var(--muted)') }}">{{ td(cv.flow_state) }}</b>{% if cv.net_flow_24h_mn is not none %} · {{ '%+0.0f'|format(cv.net_flow_24h_mn) }}M{% endif %}{% if cv.divergence and cv.divergence.state != 'none' %} · <b style="color:var(--bear)">{{ td(cv.divergence.state) }}</b>{% endif %}{% if cv.accruing %} · <span class="faint">{{ t('context','背景') }}</span>{% endif %}{% endif %}</div>
    {% endif %}
    <div class="sub faint" style="margin-top:10px;font-size:11px">{{ t('Read this as early pressure, not a top or bottom call.', '把它当作早期压力读数，不是顶部或底部预言。') }}</div>
    {% set _act = (ir.down.legs + ir.up.legs) | selectattr('tier','equalto','act') | list %}
    {% set _dem = _act | selectattr('demoted') | list %}
    <div class="sub faint" style="margin-top:5px;font-size:11px">🛡 {{ t('Falsifier','证伪器') }}: <b style="color:{{ 'var(--bear)' if _dem else 'var(--blue)' }}">{{ _act|length - _dem|length }}/{{ _act|length }}</b> {{ t('act legs still leading','行动级因子仍领先') }}{% if _dem %} · <b style="color:var(--bear)">{{ _dem|length }} {{ t('DEMOTED','已降级') }}</b>{% endif %}</div>
  </div>
  {% endif %}

  {# ---- conviction card macro (shared by mid & short so they are byte-identical "same format") ---- #}
  {% macro convcard(c, R, title_en, title_zh, vsign, grade, grade_zh, gcolor) %}
    {% set dword = 'bull' if c.dir>0 else 'bear' %}
    {% set dottint = 'var(--muted)' if (c.state=='TOSS-UP' or c.lean<=3) else ('var(--blue)' if (c.state=='EDGE' and c.dir>0) else ('var(--r3)' if (c.state=='EDGE' and c.dir<0) else ('color-mix(in srgb,var(--blue) 58%,var(--grid))' if c.dir>0 else 'color-mix(in srgb,var(--r3) 60%,var(--grid))'))) %}
    <div class="conv-head">
      <span style="font-size:14px;font-weight:700;color:var(--ink)">{{ t(title_en, title_zh) }}</span>
      <span class="conv-n">{% if R and R.tail is not none %}n={{ '{:,}'.format(R.n) }}{% elif c.n %}n={{ '{:,}'.format(c.n) }}{% else %}—{% endif %}</span>
    </div>
    {% if R and R.tail is not none %}
    {# ---------- PRIMARY: forward drawdown / risk (the CONFIRMED quantity) ---------- #}
    {% set rwc = {'CALM':'var(--muted)','ELEVATED':'var(--r3)','HIGH':'color-mix(in srgb,var(--r3) 80%,var(--ink))','EXTREME':'color-mix(in srgb,var(--r3) 80%,var(--ink))'} %}
    <div class="risk-word" style="color:{{ rwc.get(R.word_en,'var(--r3)') }}">{{ t(R.head_en, R.head_zh) }}
      {%- if R.contrarian %} <span class="conv-tag">{{ t('contrarian zone','逆势区') }}</span>{% endif %}
      {%- if R.thin %} <span class="conv-tag">{{ t('thin sample','样本偏少') }}</span>{% endif %}
    </div>
    <div class="risk-nums">{{ t('Typical dip','常见回撤') }} <b>{{ R.avg }}%</b> <span class="faint">({{ t('calm','平静') }} {{ R.calm_avg }}%)</span> · {{ t('worst-case','极端') }} <b{% if R.thin %} class="faint"{% endif %}>{{ R.tail }}%</b> <span class="faint">({{ t('calm','平静') }} {{ R.calm_tail }}%)</span></div>
    {% set scale = (1.25 * ([(R.tail|abs),(R.calm_tail|abs)]|max)) %}
    {% set scale = scale if scale > 0 else 20 %}
    <div class="ddrail">
      <div class="ddrail-bar">
        <div class="dd-down" style="left:0;width:70%"></div>
        <div class="dd-up" style="left:70%;width:30%"></div>
        <div class="dd-mk dd-calm" style="left:{{ (70 - 70*(R.calm_tail|abs)/scale)|round(1) }}%" title="calm baseline"></div>
        <div class="dd-mk dd-typ" style="left:{{ (70 - 70*(R.avg|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-tail{% if R.thin %} thin{% endif %}" style="left:{{ (70 - 70*(R.tail|abs)/scale)|round(1) }}%"></div>
        <div class="dd-mk dd-uptick" style="left:{{ (70 + 30*R.up/scale)|round(1) }}%"></div>
        <div class="dd-now" style="left:70%"></div>
      </div>
      <div class="ddrail-lab"><span class="r3b">{{ R.tail }}%</span><span class="mut">{{ R.avg }}%</span><span class="now">{{ t('now','当前') }}</span><span class="upf">+{{ R.up }}%</span></div>
    </div>
    {# ---------- SECONDARY: demoted direction strip (the honest coin-flip) ---------- #}
    <div class="dir-strip">
      <span class="dir-chip">{% if c.state=='TOSS-UP' %}{{ t('Toss-up','势均力敌') }}{% elif c.state=='LEAN' %}{{ t('Lean ' ~ dword, '倾向看多' if c.dir>0 else '倾向看空') }}{% else %}{{ t('Edge ' ~ dword, '看多优势' if c.dir>0 else '看空优势') }}{% endif %}</span>
      <div class="mini-needle"><div class="mn-dead"></div><div class="mn-tick"></div><div class="mn-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <span class="dir-num">{{ c.p_bear }}/{{ c.p_bull }}</span>{{ qmark('Direction is weak here. Focus on drawdown risk.','此处方向信号弱。重点看回撤风险。') }}
    </div>
    <div class="conv-why">{{ t(R.main_en, R.main_zh) }}</div>
    <div class="conv-why faint">{{ t(R.guard_en, R.guard_zh) }}</div>
    {% else %}
    {# ---------- fallback: conviction-led (no calibrated risk) ---------- #}
    {% set wcls = 'cw-toss' if c.state=='TOSS-UP' else (('cw-lean ' if c.state=='LEAN' else 'cw-edge ') ~ dword) %}
    <div class="cw {{ wcls }}">{% if c.state=='TOSS-UP' %}{{ t('Toss-up','势均力敌') }}{% elif c.state=='LEAN' %}{{ t('Lean ' ~ dword, '倾向看多' if c.dir>0 else '倾向看空') }}{% else %}{{ t('Edge ' ~ dword, '看多优势' if c.dir>0 else '看空优势') }}{% endif %}</div>
    <div class="needle"><div class="needle-axis"><div class="needle-dead"></div><div class="needle-tick"></div><div class="needle-dot" style="left:{{ c.p_bull }}%;background:{{ dottint }}"></div></div>
      <div class="needle-ends"><span>{{ t('Bear','看空') }}</span><span class="needle-num">{{ c.p_bear }}% / {{ c.p_bull }}%</span><span>{{ t('Bull','看多') }}</span></div></div>
    <div class="conv-why">{{ t(c.why_en, c.why_zh) }}</div>
    {% endif %}
    <div class="conv-defer" style="color:{{ gcolor }}">↳ {{ t('Defers to','服从') }} <b>{{ t(grade, grade_zh) }}</b> — {{ t('the near-term read beneath that bigger-picture call','大局判断之下的近端读数') }}</div>
  {% endmacro %}

  {# AI Daily Brief — the single in-page doorway to the cross-asset LLM synthesis
     (aibrief.html). Replaces the old inline AI Master Brief (Bitcoin) card. #}
  <a class="card aibrief-card" href="aibrief.html">
    <span class="abc-ic">🧠</span>
    <span class="abc-mid">
      <span class="abc-tit">{{ t('AI Daily Brief · Bitcoin & cross-asset synthesis', 'AI 每日简报 · 比特币与跨资产综合') }}</span>
      <span class="abc-sub muted sm">{{ t('AI reads the Bitcoin vector and the macro-liquidity backdrop in one place — cycle, valuation, leverage, on-chain and ETF flows, and what to watch. Research context only, never a signal.', 'AI 在一处解读比特币向量与宏观流动性背景 — 周期、估值、杠杆、链上与 ETF 资金流，及后续关注。仅供研究参考，绝非交易信号。') }}</span>
    </span>
    <span class="abc-go">→</span>
  </a>

  <!-- ===================== MID & SHORT TERM (side by side, same format) ===================== -->
  <div class="section-title">{{ t('Next 3–7 days · drawdown risk', '未来 3–7 天 · 回撤风险') }}</div>
  <div class="grid cols-eq">

    <!-- mid term · 7-day outlook (risk-led) -->
    <div class="card">{{ convcard(env.conv, env.risk, 'Mid term · 7-day outlook', '中期 · 7 天展望', verdict.mid_sign, verdict.grade, verdict.grade_zh, gcolor) }}</div>

    <!-- short term · 3-day outlook (risk-led) + ATR scenario levels -->
    <div class="card">
      {{ convcard(scn.conv, scn.risk, 'Short term · 3-day outlook', '短期 · 3 天展望', verdict.short_sign, verdict.grade, verdict.grade_zh, gcolor) }}
      <div style="border-top:1px solid var(--grid);margin-top:14px;padding-top:12px;display:flex;gap:18px;flex-wrap:wrap">
        <div style="flex:1;min-width:150px">
          <div class="sub" style="font-weight:700;color:var(--ink)">{{ t('If it resolves down', '若向下') }}</div>
          <div class="scn-line"><span class="mut">{{ t('Target', '目标') }}</span><b class="down">{{ scn.bear_target|money }} → {{ scn.bear_target2|money }}</b></div>
          <div class="scn-line"><span class="mut">{{ t('Invalidation', '失效位') }}</span><b>{{ scn.bear_invalid|money }}</b></div>
        </div>
        <div style="flex:1;min-width:150px;border-left:1px solid var(--grid);padding-left:18px">
          <div class="sub" style="font-weight:700;color:var(--ink)">{{ t('If it resolves up', '若向上') }}</div>
          <div class="scn-line"><span class="mut">{{ t('Target', '目标') }}</span><b class="up">{{ scn.bull_target|money }} → {{ scn.bull_target2|money }}</b></div>
          <div class="scn-line"><span class="mut">{{ t('Invalidation', '失效位') }}</span><b>{{ scn.bull_invalid|money }}</b></div>
        </div>
      </div>
      <div class="sub" style="margin-top:10px">{{ t('Levels to watch, not a direction call.', '关注的价位，而非方向判断。') }}{{ qmark('Levels come from recent volatility. Wait for an actual break.','价位来自近期波动。等待真实突破。') }}</div>
    </div>

  </div>

  <!-- ===================== RISK INDEX vs STRATEGY ===================== -->
  <div class="section-title">{{ t('Risk Index vs Strategy · backtested', '风险指数 vs 策略 · 已回测') }}</div>
  <div class="card">
    <h3>{{ t('BTC price, Risk Index & allocation', 'BTC 价格、风险指数与仓位') }} <span class="faint" style="font-size:13px;font-weight:600" id="vrc-variant-label">{{ t('· Optimal variant','· 最优变体') }}</span></h3>
    <div id="vec-risk-chart" class="vchart-wrap" style="--vchart-h:500px"><div class="sub faint" style="padding:18px 0">{{ t('Loading interactive chart…','加载交互图表…') }}</div></div>
    <div class="sub" style="margin-top:6px;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;font-size:12px">
      <span><span style="display:inline-block;width:14px;height:2px;background:var(--faint);vertical-align:3px;margin-right:5px"></span>{{ t('BTC price (log)', 'BTC 价格（对数）') }}</span>
      <span><span style="display:inline-block;width:14px;height:2px;background:var(--blue);vertical-align:3px;margin-right:5px"></span>{{ t('Strategy equity', '策略净值') }}</span>
      <span style="color:var(--bull);font-weight:600">▲ {{ t('buy / add', '买入 / 加仓') }}</span>
      <span style="color:var(--bear);font-weight:600">▼ {{ t('sell / trim', '卖出 / 减仓') }}</span>
      <span>{{ t('lower panes:', '下方面板：') }} {{ t('Risk Index (blue<25 / red≥25)', '风险指数（蓝<25 / 红≥25）') }} · {{ t('allocation %', '仓位 %') }}</span>
    </div>
    <div class="score" style="margin-top:14px" id="vrc-score"
         data-cards='{{ {"conservative":cards.conservative,"moderate":cards.moderate,"aggressive":cards.aggressive,"optimal":cards.optimal}|tojson }}'>
      <div class="s"><div class="k">CAGR</div><div class="v" data-m="cagr">{{ cards.optimal.cagr }}%</div><div class="h">HODL {{ cards.optimal.hodl_cagr }}%</div></div>
      <div class="s"><div class="k">Sharpe</div><div class="v" data-m="sharpe">{{ cards.optimal.sharpe }}</div><div class="h">HODL {{ cards.optimal.hodl_sharpe }}</div></div>
      <div class="s"><div class="k">{{ t('Max Drawdown', '最大回撤') }}</div><div class="v" data-m="maxdd">{{ cards.optimal.maxdd }}%</div><div class="h">HODL {{ cards.optimal.hodl_maxdd }}%</div></div>
      <div class="s"><div class="k">{{ t('Time in market', '在场时间') }}</div><div class="v" data-m="in_market">{{ cards.optimal.in_market }}%</div><div class="h" data-m="x_hodl">{{ cards.optimal.x_hodl }}× HODL</div></div>
    </div>
    <div class="sub" style="margin-top:10px">{{ t('Long-only, acts the day after each signal — every variant beats HODL Sharpe and cuts max drawdown.', '仅做多，信号次日生效 — 每个变体的 Sharpe 均优于 HODL，且降低最大回撤。') }}</div>
  </div>

  <!-- ===================== CYCLE TIME MACHINE ===================== -->
  <div class="section-title">{{ t('Cycle Time Machine · scrub 10+ years of point-in-time history', '周期时光机 · 回溯十余年实时历史') }}</div>
  <div class="card" id="vtm" data-timeline="vector_timeline.json">
    <div class="vtm-wrap">
      <canvas id="vtm-canvas" class="vtm-canvas"></canvas>
      <input id="vtm-range" class="vtm-range" type="range" min="0" max="0" value="0" aria-label="Scrub BTC cycle history">
    </div>
    <div class="vtm-legend">
      <span><i style="background:#3b6fe0"></i>{{ t('Accumulation','吸筹') }}</span>
      <span><i style="background:#1f9d57"></i>{{ t('Markup','拉升') }}</span>
      <span><i style="background:#e0a43a"></i>{{ t('Recovery','修复') }}</span>
      <span><i style="background:#cf4f4f"></i>{{ t('Markdown','派发下行') }}</span>
    </div>
    <div class="vtm-controls">
      <button class="vtm-btn vtm-play" id="vtm-play" aria-label="Play"><span class="vtm-play-ico"></span></button>
      <span class="vtm-presets">
        <button class="vtm-btn" data-vtm-jump="now">{{ t('Now','当前') }}</button>
        <button class="vtm-btn" data-vtm-jump="2017-12-17">{{ t('2017 top','2017 顶') }}</button>
        <button class="vtm-btn" data-vtm-jump="2018-12-15">{{ t('2018 bottom','2018 底') }}</button>
        <button class="vtm-btn" data-vtm-jump="2021-04-14">{{ t('2021 top','2021 顶') }}</button>
        <button class="vtm-btn" data-vtm-jump="2022-11-09">{{ t('FTX crash','FTX 崩盘') }}</button>
      </span>
    </div>
    <div class="vtm-readout">
      <div class="vtm-asof">
        <span class="vtm-date" id="vtm-date">—</span>
        <span class="vtm-tag is-live" id="vtm-tag">—</span>
        <span class="vtm-price" id="vtm-price">—</span>
      </div>
      <div class="vtm-badges">
        <span class="vtm-badge" id="vtm-phase">—</span>
        <span class="vtm-badge" id="vtm-regime">—</span>
        <span class="vtm-badge" id="vtm-extreme" style="display:none">—</span>
        <span class="kv">{{ t('cycle stage','周期阶段') }} <b id="vtm-stage">—</b></span>
        <span class="kv">{{ t('Cycle phase','周期相位') }} <b id="vtm-cphase">—</b></span>
        <span class="kv">{{ t('ladder','阶梯') }} <b id="vtm-ladder">—</b></span>
        <span class="kv">{{ t('momentum','动量') }} <b id="vtm-mom">—</b></span>
        <span class="kv">{{ t('valuation','估值') }} <b id="vtm-val">—</b></span>
        <span class="kv">{{ t('stance','立场') }} <b id="vtm-composite">—</b></span>
        <span class="kv">{{ t('model alloc','模型仓位') }} <b id="vtm-alloc">—</b></span>
      </div>
      <div class="vtm-gauge">
        <div class="vtm-glabel"><span>{{ t('Risk Index (0–100)','风险指数（0–100）') }}</span><span id="vtm-risk-v">—</span></div>
        <div class="vtm-grail"><i id="vtm-risk-i" style="left:50%"></i></div>
      </div>
    </div>
    <div class="sub faint" style="margin-top:11px;font-size:12px">{{ t('Drag to replay what the dashboard would have shown on that day. No look-ahead.', '拖动可回放当日看板读数。无前视。') }}</div>
  </div>

  <!-- ===================== MULTI-TIMEFRAME TECHNICALS ===================== -->
  {% if mtf_rows %}
  <div class="section-title">{{ t('Technicals · daily → monthly', '技术指标 · 日线 → 月线') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Cycle ladder (shared with the stock analyzer)', '周期阶梯（与个股分析器一致）') }}
        {% if ladder.regime %}<b style="color:{{ 'var(--r3)' if ladder.regime=='bear' else ('var(--blue)' if ladder.regime=='bull' else 'var(--muted)') }}"> · {{ td(ladder.regime_label or ladder.regime) }}</b>{% endif %}</h3>
      {% if ladder.label %}<div class="mini"><div class="lab"><span>{{ t('Daily cycle state','日线周期状态') }}</span><span><b>{{ t(ladder.label, ladder.label_zh) }}</b>{% if ladder.age_short %} <span class="faint">· {{ td(ladder.age_short) }}</span>{% endif %}</span></div></div>{% endif %}
      {% if ladder.summary_line %}<div class="sub" style="margin-top:8px">{{ t(ladder.summary_line, ladder.summary_line_zh) }}</div>{% endif %}
      {% if ladder.entry_text %}<div class="sub" style="margin-top:6px;color:var(--ink)">{{ t(ladder.entry_text, ladder.entry_text_zh) }}</div>{% endif %}
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('The same calibrated cycle engine (DCL/ICL) the Macro Dashboard runs on every asset — crypto preset is a ~56–70-day daily cycle.', '与宏观看板对每个资产运行的同一套已校准周期引擎（DCL/ICL）— 加密预设为约 56–70 天的日线周期。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Technicals across timeframes', '跨周期技术指标') }}</h3>
      {% set tfc = {'up':'var(--blue)','down':'var(--r3)','flat':'var(--muted)'} %}
      {% set mz = {'up':'转多','down':'转空','pos':'多头','neg':'空头'} %}
      <table style="width:100%;border-collapse:collapse;font-size:13px">
        <tr style="color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.03em">
          <td style="padding:5px 4px">{{ t('TF','周期') }}</td><td style="text-align:right">RSI</td><td style="text-align:right">StochRSI</td><td style="text-align:right">MACD</td><td style="text-align:right">{{ t('Trend','趋势') }}</td></tr>
        {% set tlab = {'D':['Daily','日线'],'3D':['3-Day','3日'],'W':['Weekly','周线'],'2W':['Biweekly','双周'],'ME':['Monthly','月线']} %}
        {% for r in mtf_rows %}
        <tr style="border-top:1px solid var(--grid)">
          <td style="padding:7px 4px;font-weight:600;color:var(--ink)">{{ t(tlab.get(r.key,[r.key,r.key])[0], tlab.get(r.key,[r.key,r.key])[1]) }}</td>
          <td style="text-align:right;color:{{ 'var(--hot)' if r.rsi14 and r.rsi14>=70 else ('var(--cold)' if r.rsi14 and r.rsi14<=30 else 'var(--text)') }}">{{ r.rsi14 if r.rsi14 is not none else '—' }}</td>
          <td style="text-align:right;color:{{ 'var(--hot)' if r.stoch and r.stoch>=80 else ('var(--cold)' if r.stoch and r.stoch<=20 else 'var(--text)') }}">{{ r.stoch if r.stoch is not none else '—' }}</td>
          <td style="text-align:right;color:{{ 'var(--blue)' if r.macd in ('up','pos') else 'var(--r3)' }}">{{ t(r.macd|capitalize, mz.get(r.macd, r.macd)) }}</td>
          <td style="text-align:right"><i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{ tfc.get(r.trend,'var(--muted)') }}"></i></td>
        </tr>{% endfor %}
      </table>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('RSI/StochRSI mark overbought and oversold. Trend dot = MACD direction for that timeframe.', 'RSI/StochRSI 标记超买超卖。趋势圆点 = 该周期 MACD 方向。') }}</div>
    </div>
  </div>{% endif %}

  <!-- ===================== CORE SIGNALS (merged: momentum, structure, impulse, BFI) ===================== -->
  <div class="section-title">{{ t('Core signals · momentum, structure, impulse, fundamentals', '核心信号 · 动量·结构·脉冲·基本面') }}</div>
  <div class="grid cols-2">
    <div class="card"><h3>{{ t('Momentum', '动量') }} <span class="faint" style="font-size:14px">{{ momentum }}</span></h3>{{ charts.momentum|safe }}
      <div class="sub">{{ t('Bullish above +0.5, bearish below −0.5. State:', '高于 +0.5 看多，低于 −0.5 看空。状态：') }} <b>{{ td(momentum_state) }}</b>.</div></div>
    <div class="card"><h3>{{ t('Structure Shift', '结构转变') }} <span class="faint" style="font-size:14px">{{ structure }}</span></h3>{{ charts.structure|safe }}
      <div class="sub">{{ t('Constructive above +0.5, broken below −0.5. State:', '高于 +0.5 偏多，低于 −0.5 走坏。状态：') }} <b>{{ td(structure_state) }}</b>.</div></div>
    <div class="card">
      <h3>{{ t('Impulse', '脉冲') }}
        {% set ic = {'positive':'var(--blue)','negative':'var(--r3)','neutral':'var(--muted)'} %}
        {% set iz = {'positive':'正向','negative':'负向','neutral':'中性'} %}
        <b style="color:{{ ic.get(impulse.state,'var(--muted)') }}"> · {{ t((impulse.state or '—')|upper, iz.get(impulse.state,'—')) }}</b>
        <span class="faint" style="font-size:14px"> {{ impulse.value if impulse.value is not none else '—' }}</span></h3>
      {% if impulse.pos_pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Positive participation (14d)','正向占比（14 天）') }}</span><span><b>{{ impulse.pos_pct }}%</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ impulse.pos_pct }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Trend efficiency (chop gate)','趋势效率（震荡过滤）') }}</span><span><b>{{ impulse.er if impulse.er is not none else '—' }}</b> <span class="faint">{{ t('(0 = chop, 1 = clean trend)','（0 = 震荡，1 = 单边）') }}</span></span></div></div>
      <div class="sub" style="margin-top:10px">{{ t("Momentum's acceleration, chop-filtered — it flags when a move starts or burns out.",'动量的加速度，经震荡过滤 — 捕捉走势启动或衰竭的时机。') }}</div>
    </div>
    <div class="card"><h3>{{ t('BFI = Network Growth × Liquidity', 'BFI = 网络增长 × 流动性') }}</h3>{{ charts.bfi|safe }}
      <div class="sub">{{ t('Positive above 60, negative below 40. Now:', '高于 60 为正向，低于 40 为负向。当前：') }} <b>{{ bfi }}</b> ({{ td(bfi_zone) }}).</div>
      {% set gauge_zh = {'Network Growth':'网络增长','Liquidity':'流动性','BFI':'BFI'} %}
      {% for nm,val in [('Network Growth',network_growth),('Liquidity',liquidity),('BFI',bfi)] %}
      <div class="mini"><div class="lab"><span>{{ t(nm, gauge_zh[nm]) }}</span><span><b>{{ val if val is not none else '—' }}</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ val if val is not none else 0 }}%"></div></div></div>
      {% endfor %}
      <div class="sub" style="margin-top:10px">{{ t('Never turned negative through the 2025 stress — a long-term anchor.','2025 年压力期间从未转负 — 一个长期锚点。') }}</div>
    </div>
  </div>

  <!-- ===================== CYCLE & VALUATION (merged) ===================== -->
  <div class="section-title">{{ t('Cycle & valuation', '周期与估值') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Valuation anchors', '估值锚点') }}
        {% if valuation.deep_value %}<b style="color:var(--blue)"> · {{ t('DEEP VALUE','深度低估') }}</b>
        {% elif valuation.overvalued %}<b style="color:var(--r3)"> · {{ t('OVERVALUED','高估') }}</b>
        {% elif valuation.state %}<span class="faint"> · {{ td(valuation.state|capitalize) }}</span>{% endif %}</h3>
      {% for nm,v,p in [('MVRV-Z', valuation.mvrv_z, valuation.mvrv_z_pctile), ('NUPL', valuation.nupl, None), ('Mayer Multiple', valuation.mayer, None)] %}
      <div class="mini"><div class="lab"><span>{{ t(nm) }}</span><span><b>{{ v if v is not none else '—' }}</b>{% if p is not none %} <span class="faint">({{ p }}%ile)</span>{% endif %}</span></div></div>
      {% endfor %}
      {% if valuation.reserve_risk is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Reserve Risk','储备风险') }}</span><span><b style="color:{{ 'var(--r3)' if valuation.rr_top else ('var(--blue)' if (valuation.reserve_risk_pctile is not none and valuation.reserve_risk_pctile < 25) else 'var(--ink)') }}">{{ '%.4f'|format(valuation.reserve_risk) }}</b>{% if valuation.reserve_risk_pctile is not none %} <span class="faint">({{ valuation.reserve_risk_pctile }}%ile)</span>{% endif %}{% if valuation.rr_top %} <b style="color:var(--r3)"> · {{ t('TOP','顶部') }}</b>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Deep value supports adding; overheated supports trimming. Reserve Risk low = accumulation, high = top risk.', '深度低估支持加仓；过热支持减仓。储备风险低 = 累积，高 = 顶部风险。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Miner cycle & cost basis', '矿工周期与成本基准') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Hash Ribbons','哈希丝带') }}</span><span><b>{{ td(valuation.hash_ribbon|capitalize) if valuation.hash_ribbon else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Puell Multiple','Puell 倍数') }}</span><span><b>{{ valuation.puell if valuation.puell is not none else '—' }}</b></span></div></div>
      {% if valuation.sth_cb_ratio is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Price vs STH cost basis','价格 vs 短期持有者成本') }}</span><span><b style="color:{{ 'var(--blue)' if valuation.sth_cb_ratio>=0 else 'var(--r3)' }}">{{ '%+0.1f'|format(valuation.sth_cb_ratio) }}%</b></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Hash Ribbons mark miner stress (context only). STH cost basis is the bull/bear pivot.', '哈希丝带标记矿工压力（仅背景）。短期持有者成本是牛熊分界。') }}</div>
    </div>
    {# merged cycle clock card — halving progress row + phase timer row #}
    <div class="card">
      {% set ph = cycle.phase %}
      {% set ph_color = {'accumulation':'var(--blue)','markup':'var(--blue)','markdown':'var(--r3)','recovery':'var(--ink)'} %}
      {% set ph_zh = {'accumulation':'累积','markup':'上涨','markdown':'下跌','recovery':'复苏'} %}
      {% set cp = cycle_phase %}
      {% set cpc = {'markup':'var(--blue)','markdown':'var(--r3)'} %}
      {% set cpz = {'markup':'上涨腿','markdown':'下跌腿'} %}
      {% set kz = {'top':'顶部','bottom':'底部'} %}
      {% set stz = {'on_track':'按节奏','overdue':'已超期','invalidated':'已失效'} %}
      {% set stc = {'on_track':'var(--blue)','overdue':'var(--amber)','invalidated':'var(--r3)'} %}
      {# show phase label — if halving and phase clocks agree, show once; if they differ, both colors #}
      {% set ph_label = ph or '—' %}
      {% set cp_label = cp.phase or '—' %}
      <h3>{{ t('Cycle clock', '周期时钟') }}
        {% if ph_label == cp_label %}<b style="color:{{ ph_color.get(ph,'var(--muted)') }}"> · {{ t(ph_label|upper, ph_zh.get(ph,'—')) }}</b>
        {% else %}<b style="color:{{ ph_color.get(ph,'var(--muted)') }}"> · {{ t(ph_label|upper, ph_zh.get(ph,'—')) }}</b><b style="color:{{ cpc.get(cp.phase,'var(--muted)') }}"> / {{ t(cp_label|upper, cpz.get(cp.phase,'—')) }}</b>{% endif %}
        {% if cp.status and cp.status != 'on_track' %}<b style="color:{{ stc.get(cp.status,'var(--muted)') }}"> · {{ t(cp.status|replace('_',' ')|upper, stz.get(cp.status,'')) }}</b>{% endif %}</h3>
      {# halving clock row #}
      <div class="faint" style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;margin-top:4px">{{ t('Halving clock','减半时钟') }}</div>
      {% if cycle.pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Cycle progress (since halving)','周期进度（自减半起）') }}</span><span><b>{{ cycle.pct }}%</b> <span class="faint">({{ cycle.days }}d)</span></span></div>
        <div class="bar"><div class="fill" style="width:{{ cycle.pct if cycle.pct<=100 else 100 }}%"></div></div></div>{% endif %}
      {% if cycle.vdd is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Spending behaviour · VDD Multiple','支出行为 · VDD 倍数') }}</span><span><b>{{ cycle.vdd }}</b> <span class="faint">({{ cycle.vdd_pctile }}%ile · {{ t('>2.9 distribution, <0.75 dormant','>2.9 派发，<0.75 沉睡') }})</span></span></div></div>{% endif %}
      {# phase timer row #}
      <div class="faint" style="font-size:10px;text-transform:uppercase;letter-spacing:.04em;margin-top:10px">{{ t('Phase timer','相位计时') }}</div>
      {% if cp.pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Phase progress','相位进度') }}</span><span><b>{{ cp.pct }}%</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ cp.pct if cp.pct<=100 else 100 }}%;background:{{ cpc.get(cp.phase,'var(--blue)') }}"></div></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Projected next pivot','预计下一转折') }}{% if cp.next_kind %} <span class="faint">{{ t(cp.next_kind, kz.get(cp.next_kind,'')) }}</span>{% endif %}</span><span><b>{{ cp.next_pivot or '—' }}</b>{% if cp.days_left is not none %} <span class="faint">({{ cp.days_left|int }}d)</span>{% endif %}</span></div></div>
      {% endif %}
      <div class="sub" style="margin-top:8px">{{ t('Post-halving accumulation phases averaged +48%/90d (81% hit); mid-cycle markdowns +5% (43%) — a soft prior, never a trigger.','减半后累积期平均 +48%/90d（胜率 81%）；周期中段下跌期 +5%（43%）— 软先验，从不触发。') }}</div>
    </div>
    {# Cycle Thesis Monitor — W3 house law: keep blackout logic untouched #}
    <div class="card">
      {% set ct = cycle_thesis %}
      {% if ct and ct.ok %}
      {% set tsc = {'intact':'var(--blue)','watch':'var(--amber)','breaking':'var(--r3)'} %}
      {% set tsz = {'intact':'成立','watch':'观察','breaking':'破位'} %}
      {% set flc = {'ok':'var(--blue)','watch':'var(--amber)','alert':'var(--r3)'} %}
      {% set fli = {'ok':'✓','watch':'▲','alert':'✕'} %}
      <h3>{{ t('Cycle Thesis Monitor','周期论点监测') }}
        <b style="color:{{ tsc.get(ct.thesis_status,'var(--muted)') }}"> · {{ t(ct.thesis_status|upper, tsz.get(ct.thesis_status,'—')) }}</b>
        {#- W3: buy-side badge — suppressed under the gate via the SAME stamped key the rec
           card uses (build_vector.py), else Oct–Nov 2026 would flash "ACCUMULATION ZONE"
           beside a forced-flat 0% allocation. #}
        {% if ct.accumulate and not ct.suppressed_by_blackout %}<b style="color:var(--blue)"> · {{ t('ACCUMULATION ZONE','吸筹区') }}</b>{% endif %}</h3>
      {% if ct.drawdown_from_peak is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Drawdown from cycle peak','较周期顶部回撤') }} <span class="faint">({{ ct.peak_date }})</span></span><span><b style="color:var(--r3)">{{ (ct.drawdown_from_peak*100)|round|int }}%</b>{% if ct.prior_bear_mean is not none %} <span class="faint">{{ t('vs','对比') }} {{ (ct.prior_bear_mean*100)|round|int }}% {{ t('prior-bear avg','历史熊市均值') }}</span>{% endif %}</span></div></div>
      {% endif %}
      {% if ct.window_start %}
      <div class="mini"><div class="lab"><span>{{ t('Projected bottom window','预测底部窗口') }}</span><span><b>{{ ct.window_start }} → {{ ct.window_end }}</b></span></div></div>
      {% endif %}
      <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">
        {% for f in ct.flags %}
        <div style="display:flex;gap:6px;align-items:flex-start;font-size:11px;line-height:1.35"><span style="color:{{ flc.get(f.level,'var(--muted)') }};font-weight:700;flex:0 0 auto">{{ fli.get(f.level,'·') }}</span><span>{{ t(f.en, f.zh) }}</span></div>
        {% endfor %}
      </div>
      <div class="sub" style="margin-top:8px">{{ t(ct.caveat_en, ct.caveat_zh) }}</div>
      {% else %}
      <h3>{{ t('Cycle Thesis Monitor','周期论点监测') }}</h3>
      <div class="sub">{{ t('Monitor unavailable for this build.','本次构建暂无监测数据。') }}</div>
      {% endif %}
    </div>
    <div class="card">
      <h3>{{ t('CME positioning & correlation', 'CME 持仓与相关性') }}
        {% if positioning.crowded %}<b style="color:var(--r3)"> · {{ t('CROWDED LONG','多头拥挤') }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('CME spec net (z-score)','CME 投机净持仓（z）') }}</span><span><b style="color:{{ 'var(--r3)' if positioning.crowded else 'var(--ink)' }}">{{ positioning.cot_z if positioning.cot_z is not none else '—' }}</b>{% if positioning.cot_net_pct is not none %} <span class="faint">({{ positioning.cot_net_pct }}% of OI)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('BTC↔S&P 500 correlation (90d)','BTC↔标普 500 相关性（90 天）') }}</span><span><b>{{ correlation.spx if correlation.spx is not none else '—' }}</b> <span class="faint">{{ td((correlation.regime or '')|capitalize) }}</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('BTC↔Gold correlation (90d)','BTC↔黄金 相关性（90 天）') }}</span><span><b>{{ correlation.gold if correlation.gold is not none else '—' }}</b></span></div></div>
      <div class="sub" style="margin-top:8px">{{ t('Crowded CME longs were contrarian (−5.8%/90d, 35% hit); coupled to equities averaged +13%/90d vs +33% when decoupled.','CME 多头拥挤具反向性（−5.8%/90d，胜率 35%）；与股票耦合时 90 天平均 +13%，脱钩时 +33%。') }}</div>
    </div>
  </div>

  <!-- ===================== DERIVATIVES (merged: options + leverage) ===================== -->
  <div class="section-title">{{ t('Derivatives · volatility & leverage', '衍生品 · 波动率与杠杆') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Implied volatility', '隐含波动率') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('DVOL (crypto VIX)','DVOL（加密 VIX）') }}</span><span><b>{{ options.dvol if options.dvol is not none else '—' }}</b>{% if options.dvol_pctile is not none %} <span class="faint">({{ options.dvol_pctile }}%ile)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Variance risk premium (IV−RV)','方差风险溢价（IV−RV）') }}</span><span><b>{{ options.vrp if options.vrp is not none else '—' }}</b></span></div></div>
      {% if options.vrp_state %}
      {% set vs = {'vol_rich':['Vol rich (sell-vol bias)','波动偏贵（卖波倾向）','var(--r3)'],'vol_cheap':['Vol cheap (expansion risk)','波动偏便宜（扩张风险）','var(--amber)'],'vol_fair':['Vol fair','波动合理','var(--muted)']} %}
      <div class="mini"><div class="lab"><span>{{ t('VRP regime','VRP 状态') }}</span><span><b style="color:{{ vs.get(options.vrp_state,['','','var(--muted)'])[2] }}">{{ t(vs.get(options.vrp_state,['—'])[0], vs.get(options.vrp_state,['—','—'])[1]) }}</b>{% if options.vrp_z is not none %} <span class="faint">(z {{ '%+0.1f'|format(options.vrp_z) }})</span>{% endif %}</span></div></div>{% endif %}
      {% if options.em_pct is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Implied 30d expected move (±1σ)','隐含 30 天预期波动（±1σ）') }}</span><span><b>±{{ options.em_pct }}%</b> <span class="faint">({{ options.em_lower|money }}–{{ options.em_upper|money }})</span></span></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('ATM IV 30d / term slope','平值 30 天 IV / 期限斜率') }}</span><span><b>{{ options.atm_iv_30d if options.atm_iv_30d is not none else '—' }}</b> / {{ options.term_slope if options.term_slope is not none else '—' }}</span></div></div>
      {% if options.rv_cone_pctile is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Realized-vol cone (full history)','已实现波动锥（全历史）') }}</span><span><b>{{ options.rv_realized }}%</b> <span class="faint">({{ options.rv_cone_pctile }}%ile · {{ t('vol-of-vol','波动的波动') }} {{ options.vov_pctile }}%ile)</span></span></div></div>{% endif %}
      {% if options.gamma_regime %}
      {% set gr = {'long':['Long-gamma (pinning)','正Gamma（黏滞）','var(--blue)'],'short':['Short-gamma (amplifies)','负Gamma（放大）','var(--r3)']} %}
      <div class="mini"><div class="lab"><span>{{ t('Dealer gamma regime / flip','做市商 Gamma 格局 / 翻转位') }}</span><span><b style="color:{{ gr.get(options.gamma_regime,['','','var(--muted)'])[2] }}">{{ t(gr.get(options.gamma_regime,['—'])[0], gr.get(options.gamma_regime,['—','—'])[1]) }}</b> <span class="faint">({{ t('flip','翻转') }} {{ options.gamma_flip|money if options.gamma_flip else '—' }} · {{ '%+0.1f'|format(options.dist_to_flip_pct) if options.dist_to_flip_pct is not none else '—' }}%)</span></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Measured 2021→ (confirmation only): DVOL 70–90 bled −13%/90d; VRP below −5 marked recoveries (+17%/90d). Vol describes size of moves, not direction.', '实测 2021 起（仅作确认）：DVOL 70–90 失血 −13%/90d；VRP 低于 −5 标记反弹（+17%/90d）。波动描述波幅大小，不判断方向。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Skew & positioning (snapshot)', '偏斜与持仓（快照）') }}</h3>
      <div class="mini"><div class="lab"><span>{{ t('25Δ risk reversal','25Δ 风险逆转') }}</span><span><b style="color:{{ 'var(--r3)' if (options.rr_25d is not none and options.rr_25d<0) else 'var(--blue)' }}">{{ options.rr_25d if options.rr_25d is not none else '—' }}</b> <span class="faint">{{ t('(<0 = downside bid)','（<0 = 下行需求）') }}</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Put/Call OI ratio','看跌/看涨 持仓比') }}</span><span><b>{{ options.put_call if options.put_call is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Max pain','最大痛点') }}</span><span><b>{{ ('$%s'|format('{:,.0f}'.format(options.max_pain))) if options.max_pain is not none else '—' }}</b></span></div></div>
      {% if options.basis_ann is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Futures basis (annualized)','期货基差（年化）') }}</span><span><b style="color:{{ 'var(--r3)' if options.basis_ann>15 else ('var(--blue)' if options.basis_ann>=0 else 'var(--r3)') }}">{{ '%+0.1f'|format(options.basis_ann) }}%</b> <span class="faint">{{ t('(>15 froth, <0 stress)','（>15 过热，<0 承压）') }}</span></span></div></div>{% endif %}
      {% if options.skew_term is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Skew term (7d−90d)','偏斜期限（7天−90天）') }}</span><span><b>{{ '%+0.3f'|format(options.skew_term) }}</b> <span class="faint">{{ t('(>0 = acute near-term fear)','（>0 = 近端急性恐慌）') }}</span></span></div></div>{% endif %}
      {% if options.iv_term_state %}
      {% set its = {'contango':['Contango (calm)','正向（平静）','var(--blue)'],'backwardation':['Backwardation (front-end stress)','逆向（近端承压）','var(--r3)'],'flat':['Flat','持平','var(--muted)']} %}
      <div class="mini"><div class="lab"><span>{{ t('IV term structure','IV 期限结构') }}</span><span><b style="color:{{ its.get(options.iv_term_state,['','','var(--muted)'])[2] }}">{{ t(its.get(options.iv_term_state,['—'])[0], its.get(options.iv_term_state,['—','—'])[1]) }}</b>{% if options.iv_term_spread is not none %} <span class="faint">({{ '%+0.1f'|format(options.iv_term_spread) }}pt 90d−30d)</span>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Rebuilt from the free Deribit options chain — now including the futures-basis curve (leverage demand) and the skew term structure (near-term vs. structural fear). The per-strike snapshot builds up daily — context until ~6–12 months of history allow calibration.', '基于免费的 Deribit 期权链重建 — 现含期货基差曲线（杠杆需求）与偏斜期限结构（近端 vs 结构性恐慌）。逐行权价快照每日累积 — 在约 6–12 个月历史前仅作背景。') }}</div>
    </div>
  </div>

  <div class="grid cols-2">
    <div class="card">
      <h3>{{ t('Leverage state', '杠杆状态') }}</h3>
      {% if leverage.stress is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Leverage stress','杠杆压力') }}</span><span><b>{{ leverage.stress }}/100</b></span></div>
        <div class="bar"><div class="fill" style="width:{{ leverage.stress }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Aggregate open interest','总持仓量') }}</span><span><b>{{ ('$%.1fB'|format(leverage.oi_total/1e9)) if leverage.oi_total is not none else '—' }}</b>{% if leverage.oi_mcap_pctile is not none %} <span class="faint">({{ leverage.oi_mcap_pctile }}%ile vs mcap)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Funding (annualized)','资金费率（年化）') }}</span><span><b>{{ ('%+0.1f%%'|format(leverage.funding_annual)) if leverage.funding_annual is not none else '—' }}</b>{% if leverage.funding_z is not none %} <span class="faint">(z {{ leverage.funding_z }})</span>{% endif %}</span></div></div>
      {% if leverage.okx_ls_ratio is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OKX retail long/short (accounts)','OKX 散户多空比（账户数）') }}</span><span><b style="color:{{ 'var(--r3)' if leverage.okx_ls_lean=='crowded_long' else ('var(--blue)' if leverage.okx_ls_lean=='crowded_short' else 'var(--ink)') }}">{{ '%.2f'|format(leverage.okx_ls_ratio) }}</b>{% if leverage.okx_ls_pctile is not none %} <span class="faint">({{ leverage.okx_ls_pctile }}%ile{% if leverage.okx_ls_z is not none %} · z {{ leverage.okx_ls_z }}{% endif %})</span>{% endif %}
      {% if leverage.okx_ls_lean=='crowded_long' %} <span class="faint" style="color:var(--r3)">· {{ t('crowded longs (contrarian caution, not a buy)','多头拥挤（反向警示，非买入信号）') }}</span>{% elif leverage.okx_ls_lean=='crowded_short' %} <span class="faint" style="color:var(--blue)">· {{ t('crowded shorts (capitulation context)','空头拥挤（投降式背景）') }}</span>{% endif %}</span></div></div>{% endif %}
      {% if leverage.okx_taker_buy is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OKX taker buy/sell flow','OKX 主动买卖盘占比') }}</span><span><b>{{ '%.0f'|format(100*leverage.okx_taker_buy) }}%</b> <span class="faint">{{ t('buy share','主动买占比') }}{% if leverage.okx_taker_pctile is not none %} ({{ leverage.okx_taker_pctile }}%ile){% endif %}</span></span></div></div>{% endif %}
      {% if leverage.cme_basis is not none %}
      {% set creg = {'contango':'var(--amber)','backwardation':'var(--r3)','flat':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('CME basis (regulated carry)','CME 基差（受监管套利）') }}</span><span><b>{{ '%+0.2f'|format(leverage.cme_basis) }}%</b> <span class="faint">(~{{ '%+0.0f'|format(leverage.cme_basis_ann) }}%/yr · {{ leverage.cme_basis_pctile }}%ile · <span style="color:{{ creg.get(leverage.cme_basis_regime,'var(--muted)') }}">{{ td(leverage.cme_basis_regime) }}</span>)</span></span></div></div>{% endif %}
      {% if leverage.oi_divergence is not none %}
      <div class="mini"><div class="lab"><span>{{ t('OI vs price divergence (14d)','持仓 vs 价格背离（14 天）') }}</span><span><b>{{ '%+0.1f'|format(leverage.oi_divergence) }}%</b></span></div></div>{% endif %}
      {% if leverage.carry_state %}
      {% set fcs = {'froth':['Froth (longs paying up)','过热（多头付溢价）','var(--r3)'],'stress':['Stress (deleveraging)','承压（去杠杆）','var(--blue)'],'neutral':['Neutral','中性','var(--muted)']} %}
      <div class="mini"><div class="lab"><span>{{ t('Consolidated futures carry','综合期货套利') }}</span><span><b style="color:{{ fcs.get(leverage.carry_state,['','','var(--muted)'])[2] }}">{{ t(fcs.get(leverage.carry_state,['—'])[0], fcs.get(leverage.carry_state,['—','—'])[1]) }}</b>{% if leverage.carry_z is not none %} <span class="faint">(z {{ '%+0.1f'|format(leverage.carry_z) }})</span>{% endif %}</span></div>
        <div class="sub faint" style="margin-top:4px;font-size:11px">{{ t('One blended leverage-cycle read. Context only.', '单一杠杆周期读数。仅背景。') }}</div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Context, not a signal — crowding makes the tape fragile; crowded shorts (funding-z < −1) were followed by +18%/90d at 70% hit.', '背景而非信号 — 拥挤使行情脆弱；空头拥挤（资金费率 z < −1）后 90 天 +18%、胜率 70%。') }}</div>
    </div>
  </div>

  <!-- ===================== THE BACKDROP · LIQUIDITY & BREADTH ===================== -->
  <div class="section-title">{{ t('The backdrop · liquidity & breadth', '大背景 · 流动性与广度') }}</div>
  <div class="grid cols-2">
    <div class="card">
      {% set mr = macro.regime %}
      {% set mr_color = {'tailwind':'var(--blue)','headwind':'var(--r3)','neutral':'var(--muted)'} %}
      {% set mr_label = {'tailwind':'TAILWIND','headwind':'HEADWIND','neutral':'NEUTRAL'} %}
      {% set mr_zh = {'tailwind':'顺风','headwind':'逆风','neutral':'中性'} %}
      <h3>{{ t('Macro backdrop', '宏观背景') }}
        <b style="color:{{ mr_color.get(mr,'var(--muted)') }}"> · {{ t(mr_label.get(mr,'—'), mr_zh.get(mr,'—')) }}</b>
        {% if macro.score is not none %}<span class="faint" style="font-size:13px"> ({{ '%+0.2f'|format(macro.score) }})</span>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Net liquidity (WALCL−RRP−TGA)','净流动性（WALCL−RRP−TGA）') }}</span><span><b>{{ ('$%.2fT'|format(macro.net_liq_bn/1000)) if macro.net_liq_bn is not none else '—' }}</b>{% if macro.net_liq_roc is not none %} <span class="faint" style="color:{{ 'var(--blue)' if macro.net_liq_roc>=0 else 'var(--r3)' }}">({{ '%+0.1f'|format(macro.net_liq_roc) }}% 13w)</span>{% endif %}</span></div></div>
      {% if macro.global_m2_yoy is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Global M2 growth (US+China)','全球 M2 增速（美+中）') }}</span><span><b style="color:{{ 'var(--blue)' if macro.global_m2_yoy>=5 else 'var(--r3)' }}">{{ macro.global_m2_yoy }}% YoY</b> <span class="faint">({{ td((macro.global_liq_regime or '')|capitalize) }})</span></span></div></div>{% endif %}
      {% if macro.get('stbl_growth_z') is not none %}
      {% set sreg = {'expanding':'var(--blue)','contracting':'var(--r3)','neutral':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('Stablecoin tide (crypto-native liquidity)','稳定币潮汐（加密原生流动性）') }}</span><span><b style="color:{{ sreg.get(macro.stbl_regime,'var(--muted)') }}">{{ td((macro.stbl_regime or '')|capitalize) }}</b> <span class="faint">(z {{ '%+0.1f'|format(macro.stbl_growth_z) }} · ${{ macro.stbl_mcap_bn }}B)</span></span></div></div>{% endif %}
      {% if macro.peg_state %}
      {% set pst = {'stable':['Stable','稳定','var(--blue)'],'watch':['Watch','观察','var(--amber)'],'break':['BREAK','脱锚','var(--red)']} %}
      <div class="mini"><div class="lab"><span>{{ t('Stablecoin peg health (USDT/USDC/DAI)','稳定币锚定健康（USDT/USDC/DAI）') }}</span><span><b style="color:{{ pst.get(macro.peg_state,['','','var(--muted)'])[2] }}">{{ t(pst.get(macro.peg_state,['—'])[0], pst.get(macro.peg_state,['—','—'])[1]) }}</b> <span class="faint">({{ t('max dev','最大偏离') }} {{ macro.peg_dev_bps }}bps)</span></span></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('10y real yield','10 年期实际收益率') }}</span><span><b>{{ ('%.2f%%'|format(macro.real_yield)) if macro.real_yield is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('HY credit spread (OAS)','高收益信用利差') }}</span><span><b>{{ ('%.2f%%'|format(macro.hy_oas)) if macro.hy_oas is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('VIX / Dollar (DXY)','VIX / 美元指数') }}</span><span><b>{{ macro.vix if macro.vix is not none else '—' }}</b> / {{ macro.dxy if macro.dxy is not none else '—' }}</span></div></div>
      <div class="mini" style="margin-top:6px"><div class="lab"><span style="color:var(--r3)">{{ t('Headwind (score < −0.3)','逆风（评分 < −0.3）') }}</span><span><b>+1.4%</b> <span class="faint">/90d · 41% hit</span></span></div></div>
      <div class="mini"><div class="lab"><span style="color:var(--blue)">{{ t('Tailwind (score > +0.3)','顺风（评分 > +0.3）') }}</span><span><b>+48.8%</b> <span class="faint">/90d · 76% hit</span></span></div></div>
      <div class="sub" style="margin-top:10px">{{ t('BTC follows the change in liquidity — a months-out tide, not a trigger.', 'BTC 跟随流动性变化 — 数月维度的潮汐，而非触发器。') }}</div>
    </div>
    {% if breadth and breadth.bucket and breadth.bucket != '—' %}
    <div class="card">
      {% set bkt = breadth.bucket %}
      {% set bk_color = {'Alt season':'var(--blue)','BTC season':'var(--amber)','Mixed':'var(--muted)'} %}
      {% set bk_zh = {'Alt season':'山寨季','BTC season':'BTC 季','Mixed':'混合'} %}
      <h3>{{ t('Breadth regime', '广度状态') }}
        <b style="color:{{ bk_color.get(bkt,'var(--muted)') }}"> · {{ t(bkt, bk_zh.get(bkt, bkt)) }}</b>
        {% if breadth.score is not none %}<span class="faint" style="font-size:13px"> ({{ breadth.score|int }}/100)</span>{% endif %}</h3>
      {% if breadth.score is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Alt-season score (ETH/BTC + dominance)','山寨季评分（ETH/BTC + 占比）') }}</span><span><b>{{ breadth.score|int }}/100</b> <span class="faint">{{ t('0 = BTC-only · 100 = broad','0 = 仅 BTC · 100 = 广泛') }}</span></span></div>
        <div class="bar"><div class="fill" style="width:{{ breadth.score|int }}%"></div></div></div>{% endif %}
      {% if breadth.ethbtc is not none %}
      {% set es_color = {'alt':'var(--blue)','btc':'var(--amber)','mixed':'var(--muted)'} %}
      <div class="mini"><div class="lab"><span>{{ t('ETH/BTC (alt-cycle core)','ETH/BTC（山寨周期核心）') }}</span><span><b style="color:{{ es_color.get(breadth.ethbtc_season,'var(--ink)') }}">{{ '%.4f'|format(breadth.ethbtc) }}</b>{% if breadth.ethbtc_slope is not none %} <span class="faint" style="color:{{ 'var(--blue)' if breadth.ethbtc_slope>=0 else 'var(--r3)' }}">({{ '%+0.1f'|format(breadth.ethbtc_slope) }}% 8w)</span>{% endif %}{% if breadth.ethbtc_pctile is not none %} <span class="faint">· {{ breadth.ethbtc_pctile|int }}%ile</span>{% endif %}</span></div></div>{% endif %}
      {% if breadth.soleth is not none %}
      {% set st_color = {'rising':'var(--blue)','falling':'var(--r3)','flat':'var(--muted)'} %}
      {% set st_lab = {'rising':['rising — high-beta bid','上升 — 高贝塔买盘'],'falling':['falling — risk-off','下降 — 避险'],'flat':['flat','走平']} %}
      <div class="mini"><div class="lab"><span>{{ t('SOL/ETH (high-beta appetite)','SOL/ETH（高贝塔偏好）') }} <span class="faint">{{ t('NEW','新增') }}</span></span><span><b>{{ '%.4f'|format(breadth.soleth) }}</b>{% if breadth.soleth_trend %} <span class="faint" style="color:{{ st_color.get(breadth.soleth_trend,'var(--muted)') }}">· {{ t(st_lab.get(breadth.soleth_trend,['—'])[0], st_lab.get(breadth.soleth_trend,['—','—'])[1]) }}</span>{% endif %}{% if breadth.soleth_pctile is not none %} <span class="faint">· {{ breadth.soleth_pctile|int }}%ile</span>{% endif %}</span></div></div>{% endif %}
      {% if breadth.dom is not none %}
      <div class="mini"><div class="lab"><span>{{ t('BTC dominance','BTC 占比') }}</span><span><b>{{ '%.1f%%'|format(breadth.dom) }}</b>{% if breadth.ethdom is not none %} <span class="faint">· ETH {{ '%.1f%%'|format(breadth.ethdom) }}</span>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Shows how far out the risk curve money is going. Confirms the regime; doesn\'t lead it.', '显示资金在风险曲线上走多远。确认格局，而非领先。') }}</div>
    </div>
    {% endif %}
  </div>

  <!-- ===================== ON-CHAIN & ETF DEMAND ===================== -->
  <div class="section-title">{{ t('On-chain & ETF demand', '链上与 ETF 需求') }}</div>
  <div class="grid cols-2">
    <div class="card">
      {% set ps = {'overheated':['OVERHEATED','过热','var(--r3)'],'premium':['PREMIUM · US bid','溢价 · 美国买盘','var(--blue)'],'neutral':['NEUTRAL','中性','var(--muted)'],'discount':['DISCOUNT','折价','var(--amber)'],'deep_discount':['DEEP DISCOUNT','深度折价','var(--r3)']} %}
      <h3>{{ t('Coinbase Premium', 'Coinbase 溢价') }}
        {% if onchain.premium_state %}<b style="color:{{ ps.get(onchain.premium_state,['','','var(--muted)'])[2] }}"> · {{ t(ps.get(onchain.premium_state,['—'])[0], ps.get(onchain.premium_state,['—','—'])[1]) }}</b>{% endif %}
        <span class="verdict v-dir" style="font-size:10px;vertical-align:middle">{{ t('measured · both halves','实测 · 双半段') }}</span></h3>
      <div class="mini"><div class="lab"><span>{{ t('Premium (Coinbase USD − OKX USDT, 7d)','溢价（Coinbase USD − OKX USDT，7 天）') }}</span><span><b style="color:{{ 'var(--blue)' if (onchain.premium is not none and onchain.premium>=0) else 'var(--r3)' }}">{{ ('%+0.2f%%'|format(onchain.premium)) if onchain.premium is not none else '—' }}</b>{% if onchain.premium_pctile is not none %} <span class="faint">(z {{ '%+0.1f'|format(onchain.premium_z) if onchain.premium_z is not none else '—' }} · {{ onchain.premium_pctile }}%ile)</span>{% endif %}</span></div></div>
