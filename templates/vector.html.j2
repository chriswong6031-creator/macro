<!-- interactive Risk-Index-vs-Strategy backtest chart (bespoke Lightweight Charts v5) -->
<script src="lightweight-charts-v5.js"></script>
<script src="vector_chart.js"></script>
<script>
(function(){
  var el=document.getElementById('vec-risk-chart'); if(!el||!window.VectorChart) return;
  var sc=document.getElementById('vrc-score'), lab=document.getElementById('vrc-variant-label');
  var cards={}; try{cards=JSON.parse(sc.getAttribute('data-cards'));}catch(e){}
  var zh=(document.documentElement.getAttribute('data-lang')==='zh');
  var vname={conservative:zh?'保守':'Conservative',moderate:zh?'稳健':'Moderate',aggressive:zh?'进取':'Aggressive',optimal:zh?'最优':'Optimal'};
  function sync(v){
    var c=cards[v]; if(!c||!sc) return;
    sc.querySelectorAll('[data-m]').forEach(function(n){
      var m=n.getAttribute('data-m'), val=c[m];
      n.textContent = (m==='cagr'||m==='maxdd'||m==='in_market')?(val+'%'):(m==='x_hodl')?(val+'× HODL'):val;
    });
    if(lab) lab.textContent='· '+(vname[v]||v)+(zh?' 变体':' variant');
  }
  window.VectorChart.mount(el,'vector_risk_strategy.json',{onVariant:sync});
})();
</script>
<footer class="site-footer">
  <span class="made">{{ t('Made with ❤️ in Canada', '用 ❤️ 在加拿大制作') }}</span>
  <span class="dev">{{ t('Developed by', '开发者') }} Chris Wong</span>
</footer>
</body>
</html>
