      <div class="mini"><div class="lab"><span>{{ t('Reserve Risk','储备风险') }}</span><span><b style="color:{{ 'var(--r3)' if valuation.rr_top else ('var(--blue)' if (valuation.reserve_risk_pctile is not none and valuation.reserve_risk_pctile < 25) else 'var(--ink)') }}">{{ '%.4f'|format(valuation.reserve_risk) }}</b>{% if valuation.reserve_risk_pctile is not none %} <span class="faint">({{ valuation.reserve_risk_pctile }}%ile)</span>{% endif %}{% if valuation.rr_top %} <b style="color:var(--r3)"> · {{ t('TOP','顶部') }}</b>{% endif %}</span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t('Calibrated (2010→): MVRV-Z below 0 preceded +40%/90d at 72% hit — the deepest-history accumulation signal; Mayer above 2.4 marked tops (−14%/90d). Both are now folded into the allocation: buy deep value, trim cycle tops.', '已校准（2010 起）：MVRV-Z 低于 0 时未来 90 天平均 +40%、胜率 72% — 历史最久的累积信号；Mayer 高于 2.4 标记顶部（90 天 −14%）。两者已并入仓位：低估买入、顶部减仓。') }}</div>
      <div class="sub" style="margin-top:6px">{{ t('Reserve Risk = price vs the opportunity cost of HODLing (checkonchain, 2010→): above 0.02 is a powerful TOP — −42.6%/90d at just 4% hit; the low band is accumulation (+18.6%/90d).', '储备风险 = 价格 vs 持有的机会成本（checkonchain，2010 起）：高于 0.02 是强力顶部信号 — 90 天 −42.6%、胜率仅 4%；低位区为累积（90 天 +18.6%）。') }}</div>
