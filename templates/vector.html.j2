    <div class="score" style="margin-top:12px">
      <div class="s"><div class="k">{{ t('5-day net flow','5 日净流入') }}</div><div class="v" style="font-size:18px">{{ etf.flow_5d_str }}</div><div class="h">z {{ '%+0.2f'|format(etf.flow_z) if etf.flow_z is not none else '—' }}</div></div>
      <div class="s"><div class="k">{{ t('Latest day','最新一日') }}</div><div class="v" style="font-size:18px">{{ etf.daily_str }}</div><div class="h">{{ t('net flow','净流入') }}</div></div>
      <div class="s"><div class="k">{{ t('Net since launch','上线以来净流入') }}</div><div class="v" style="font-size:18px">${{ etf.cum_usd_bn }}B</div><div class="h">{{ etf.cum_btc_str }}</div></div>
    </div>
    <div class="sub" style="margin-top:10px">{{ t('ETF flows are useful risk context, but the ETF era is short. They confirm the read; they do not set allocation.', 'ETF 资金流是有用风险背景，但 ETF 时代样本较短。它用于确认读数，不决定仓位。') }}</div>
    {% endif %}
    {% if etf.usd_present %}
    <div class="score" style="margin-top:12px;border-top:1px solid var(--grid);padding-top:14px">
      <div class="s"><div class="k">{{ t('Net flow (USD, latest)','净流入（美元，最新）') }}</div><div class="v" style="font-size:18px">{{ etf.total_usd_str }}</div><div class="h">{% if etf.usd_asof %}{{ t('as of','截至') }} {{ etf.usd_asof }}{% endif %}</div></div>
      <div class="s"><div class="k">{{ t('5-day net (USD)','5 日净流入（美元）') }}</div><div class="v" style="font-size:18px">{{ etf.usd_5d_str }}</div><div class="h">z {{ '%+0.2f'|format(etf.usd_z) if etf.usd_z is not none else '—' }}</div></div>
      <div class="s"><div class="k">{{ t('Net $ since launch','上线以来净流入') }}</div><div class="v" style="font-size:18px">{% if etf.usd_cum_bn is not none %}${{ etf.usd_cum_bn }}B{% else %}—{% endif %}</div><div class="h">{% if etf.exgbtc_cum_bn is not none %}{{ t('ex-GBTC','剔除 GBTC') }} ${{ etf.exgbtc_cum_bn }}B{% endif %}</div></div>
      <div class="s"><div class="k">{{ t('Issuer concentration','发行人集中度') }}</div><div class="v" style="font-size:18px">{% if etf.concentration is not none %}{{ etf.concentration }}%{% else %}—{% endif %}</div><div class="h">{{ t('top-fund share (21d)','头部基金占比（21天）') }}</div></div>
    </div>
    {% if etf.divergence and etf.divergence!='aligned' %}
    <div class="mini" style="margin-top:8px"><div class="lab"><span>{{ t('Price vs flow divergence','价格 vs 资金流背离') }}</span><span><b style="color:{{ 'var(--r3)' if etf.divergence=='distribution' else 'var(--blue)' }}">{{ t('price up, flows fading','价格上行，资金流减弱') if etf.divergence=='distribution' else t('price down, flows building','价格下行，资金流增强') }}</b></span></div></div>{% endif %}
    {% if etf.funds %}
    <div style="margin-top:14px;overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        <thead><tr style="color:var(--muted)"><th style="text-align:left;padding:4px 8px">{{ t('Issuer','发行人') }}</th><th style="text-align:right;padding:4px 8px">{{ t('5-day ($m)','5 日（百万）') }}</th><th style="text-align:right;padding:4px 8px">{{ t('Since launch ($m)','上线以来（百万）') }}</th></tr></thead>
        <tbody>
        {% for f in etf.funds %}
          <tr style="border-top:1px solid var(--grid)">
            <td style="text-align:left;padding:4px 8px">{{ f.name }}</td>
            <td style="text-align:right;padding:4px 8px;color:{{ 'var(--blue)' if f.recent>=0 else 'var(--r3)' }}">{{ '{:+,.0f}'.format(f.recent) }}</td>
            <td style="text-align:right;padding:4px 8px;color:{{ 'var(--blue)' if f.cum>=0 else 'var(--r3)' }}">{{ '{:+,.0f}'.format(f.cum) }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>{% endif %}
    <div class="sub" style="margin-top:10px">{{ t('Per-issuer detail from Farside Investors (US$m, since 2024-01-11) — ETF-era only (~2.4y), context not a both-halves anchor.','按发行人明细，来自 Farside Investors（百万美元，2024-01-11 起）— 仅 ETF 时代（约 2.4 年），作背景参考而非双半段锚点。') }}</div>
    {% endif %}
  </div>
  {% endif %}

  {# Cycle & Valuation section above now contains the merged cycle clock + positioning cards #}

  <!-- ===================== MASTERMIND FACTORS (new) ===================== -->
  {% if newf %}
  <details class="sec-fold" id="mastermind-factors">
  <summary>{{ t('Advanced factors · miners, beta, holders, attention, flow', '高阶因子 · 矿工·贝塔·持有者·关注度·主动盘') }}</summary>
  <div class="grid cols-2">
    <!-- Miner economics (deep 2010-> margin anchor) -->
    <div class="card">
      {% set ms = newf.miner.state %}
      {% set ms_c = {'capitulation':'var(--blue)','stress':'var(--amber)','healthy':'var(--muted)','euphoria':'var(--r3)'} %}
      {% set ms_z = {'capitulation':'投降（筑底）','stress':'承压','healthy':'健康','euphoria':'亢奋'} %}
      <h3>{{ t('Miner economics · hashprice', '矿工经济 · 哈希价格') }}
        {% if ms %}<b style="color:{{ ms_c.get(ms,'var(--muted)') }}"> · {{ t(ms|upper, ms_z.get(ms,'—')) }}</b>{% endif %}
        <span class="verdict v-conf" style="font-size:10px;vertical-align:middle">{{ t('deep 2010→','深度 2010→') }}</span></h3>
      {% if newf.miner.hashprice_pctile is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Hashprice percentile (margin position)','哈希价格百分位（利润水位）') }}</span><span><b style="color:{{ 'var(--blue)' if newf.miner.hashprice_pctile<20 else ('var(--r3)' if newf.miner.hashprice_pctile>85 else 'var(--ink)') }}">{{ newf.miner.hashprice_pctile }}%ile</b> <span class="faint">(z {{ '%+0.1f'|format(newf.miner.hashprice_z) if newf.miner.hashprice_z is not none else '—' }})</span></span></div>
        <div class="bar"><div class="fill" style="width:{{ newf.miner.hashprice_pctile }}%"></div></div></div>{% endif %}
      <div class="mini"><div class="lab"><span>{{ t('Miner stress','矿工压力') }}</span><span><b>{{ newf.miner.stress if newf.miner.stress is not none else '—' }}/100</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Hashrate / difficulty shock (14d)','算力 / 难度冲击（14天）') }}</span><span><b style="color:{{ 'var(--r3)' if (newf.miner.hashrate_shock is not none and newf.miner.hashrate_shock<-8) else 'var(--ink)' }}">{{ '%+0.1f'|format(newf.miner.hashrate_shock) if newf.miner.hashrate_shock is not none else '—' }}%</b>{% if newf.miner.difficulty_shock is not none %} <span class="faint">/ {{ '%+0.1f'|format(newf.miner.difficulty_shock) }}%</span>{% endif %}</span></div></div>
      <div class="sub" style="margin-top:10px">{{ t("Hashprice = USD revenue per unit of hashrate = the miner's profit margin (the cause Puell/MPI pick up downstream). Deep history (2010→) makes it a real cycle-bottom anchor: a low percentile = squeezed margins = capitulation/bottoming, and a sharp hashrate flush is a precise forced-shutdown trigger.", '哈希价格 = 每单位算力的美元收入 = 矿工利润率（Puell/MPI 在下游观察到的根因）。深度历史（2010 起）使其成为真正的周期底部锚点：低百分位 = 利润被压缩 = 投降/筑底；算力骤降则是被迫关机的精确触发。') }}</div>
    </div>
    <!-- Conditional downside/upside beta -->
    <div class="card">
      {% set br = newf.cbeta.regime %}
      {% set br_c = {'drawdown_amplifier':'var(--r3)','diversifier':'var(--blue)','mixed':'var(--muted)'} %}
      {% set br_l = {'drawdown_amplifier':['DRAWDOWN AMPLIFIER','回撤放大器'],'diversifier':['DIVERSIFIER','分散器'],'mixed':['MIXED','混合']} %}
      <h3>{{ t('Conditional beta · NDX downside vs upside', '条件贝塔 · 纳指下行 vs 上行') }}
        {% if br %}<b style="color:{{ br_c.get(br,'var(--muted)') }}"> · {{ t(br_l.get(br,['—'])[0], br_l.get(br,['—','—'])[1]) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Downside beta (on NDX down-days)','下行贝塔（纳指下跌日）') }}</span><span><b style="color:{{ 'var(--r3)' if (newf.cbeta.down_beta is not none and newf.cbeta.down_beta>0.8) else 'var(--ink)' }}">{{ newf.cbeta.down_beta if newf.cbeta.down_beta is not none else '—' }}</b>{% if newf.cbeta.down_beta_pctile is not none %} <span class="faint">({{ newf.cbeta.down_beta_pctile }}%ile)</span>{% endif %}</span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Upside beta (on NDX up-days)','上行贝塔（纳指上涨日）') }}</span><span><b>{{ newf.cbeta.up_beta if newf.cbeta.up_beta is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Asymmetry (up − down)','不对称（上 − 下）') }}</span><span><b style="color:{{ 'var(--blue)' if (newf.cbeta.asym is not none and newf.cbeta.asym>=0) else 'var(--r3)' }}">{{ '%+0.2f'|format(newf.cbeta.asym) if newf.cbeta.asym is not none else '—' }}</b> <span class="faint">{{ t('(<0 = couples harder down)','（<0 = 下跌时耦合更强）') }}</span></span></div></div>
      {% if newf.cbeta.down_beta_gold is not none %}
      <div class="mini"><div class="lab"><span>{{ t('Downside beta to gold','对黄金的下行贝塔') }}</span><span><b>{{ newf.cbeta.down_beta_gold }}</b></span></div></div>{% endif %}
      <div class="sub" style="margin-top:10px">{{ t("BTC couples hard to risk assets on the way down and decouples on the way up — a single correlation number hides this, and the downside beta is what predicts forward drawdown. Negative asymmetry + a high downside-beta percentile = a drawdown-amplifier regime (BTC falls with the Nasdaq); a low downside beta = it's trading as a diversifier. Computed from Yahoo closes.", 'BTC 在下跌时与风险资产强耦合、上涨时脱钩 — 单一相关性数字掩盖了这一点，而下行贝塔才能预测前瞻回撤。负不对称 + 高下行贝塔百分位 = 回撤放大格局（BTC 随纳指下跌）；低下行贝塔 = 其作为分散器交易。基于雅虎收盘价计算。') }}</div>
    </div>
  </div>
  <div class="grid cols-3" style="margin-top:18px">
    <!-- Holder spread -->
    <div class="card">
      {% set hst = newf.holders.state %}
      {% set hst_c = {'accumulation':'var(--blue)','distribution':'var(--r3)','neutral':'var(--muted)'} %}
      {% set hst_z = {'accumulation':'累积','distribution':'派发','neutral':'中性'} %}
      <h3>{{ t('Holder spread', '持有者价差') }}
        {% if hst %}<b style="color:{{ hst_c.get(hst,'var(--muted)') }}"> · {{ t(hst|capitalize, hst_z.get(hst,'—')) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('STH−LTH SOPR spread','短−长持有者 SOPR 价差') }}</span><span><b>{{ '%+0.3f'|format(newf.holders.sopr_spread) if newf.holders.sopr_spread is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('STH realized-price premium','短持成本溢价') }}</span><span><b>{{ '%+0.1f'|format(newf.holders.realized_premium) if newf.holders.realized_premium is not none else '—' }}%</b></span></div></div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Shows whether short-term holders are taking profit or accumulating. Context only.', '显示短期持有者是在获利了结还是累积。仅背景。') }}</div>
    </div>
    <!-- Attention -->
    <div class="card">
      {% set at = newf.attention.state %}
      {% set at_c = {'mania':'var(--r3)','apathy':'var(--blue)','normal':'var(--muted)'} %}
      {% set at_z = {'mania':'狂热','apathy':'冷清','normal':'正常'} %}
      <h3>{{ t('Attention · Wikipedia', '关注度 · 维基百科') }}
        {% if at %}<b style="color:{{ at_c.get(at,'var(--muted)') }}"> · {{ t(at|capitalize, at_z.get(at,'—')) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Pageviews (7d avg)','页面浏览（7天均）') }}</span><span><b>{{ '{:,}'.format(newf.attention.views|int) if newf.attention.views is not none else '—' }}</b></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('Attention z-score','关注度 z 值') }}</span><span><b style="color:{{ 'var(--r3)' if (newf.attention.z is not none and newf.attention.z>2) else ('var(--blue)' if (newf.attention.z is not none and newf.attention.z<-1) else 'var(--ink)') }}">{{ '%+0.1f'|format(newf.attention.z) if newf.attention.z is not none else '—' }}</b></span></div></div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Attention predicts volatility, not direction. Extremes matter most.', '关注度预测波动，不预测方向。极值最重要。') }}</div>
    </div>
    <!-- Taker flow -->
    <div class="card">
      {% set tdv = newf.taker.divergence %}
      {% set tdv_c = {'bullish':'var(--blue)','bearish':'var(--r3)','aligned':'var(--muted)'} %}
      {% set tdv_z = {'bullish':'看多背离','bearish':'看空背离','aligned':'一致'} %}
      <h3>{{ t('Taker flow · CVD', '主动盘 · CVD') }}
        {% if tdv %}<b style="color:{{ tdv_c.get(tdv,'var(--muted)') }}"> · {{ t(tdv|capitalize, tdv_z.get(tdv,'—')) }}</b>{% endif %}</h3>
      <div class="mini"><div class="lab"><span>{{ t('Taker buy share','主动买盘占比') }}</span><span><b style="color:{{ 'var(--blue)' if (newf.taker.buy_share is not none and newf.taker.buy_share>=0.5) else 'var(--r3)' }}">{{ '%.0f'|format(100*newf.taker.buy_share) if newf.taker.buy_share is not none else '—' }}%</b> <span class="faint">(z {{ '%+0.1f'|format(newf.taker.z) if newf.taker.z is not none else '—' }})</span></span></div></div>
      <div class="mini"><div class="lab"><span>{{ t('30d CVD (cumulative imbalance)','30天 CVD（累计失衡）') }}</span><span><b>{{ '%+0.2f'|format(newf.taker.cvd) if newf.taker.cvd is not none else '—' }}</b></span></div></div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Taker flow shows aggressive buying or selling. Display-only.', '主动盘显示主动买入或卖出。仅展示。') }}</div>
    </div>
  </div>
  </details>
  {% endif %}

  <!-- ===================== CROSS-ASSET MAP ===================== -->
  <div class="section-title">{{ t('Cross-Asset Regime Map · Trend (3d) & Conviction', '跨资产周期图 · 趋势（3 天）与信心') }}</div>
  <div class="grid cols-3">
    {% for g in cross %}
    <div class="card">
      <div class="cat-h">{{ td(g.group) }}</div>
      <table class="catbl">
        {% for r in g.rows %}
        <tr>
          <td class="a">{{ r.label }}</td>
          <td class="r"><span class="chip {{ 'chip-bull' if r.trend=='Bull' else ('chip-bear' if r.trend=='Bear' else 'chip-ghost') }}" style="padding:3px 10px">{{ t(r.trend, tr(r.trend|lower)) }}</span></td>
          <td class="r"><span class="dots">
            {% for i in range(3) %}<i class="{{ 'on' if i<r.conv else '' }}{{ ' bear' if r.trend=='Bear' else '' }}"></i>{% endfor %}
          </span></td>
        </tr>
        {% endfor %}
      </table>
    </div>
    {% endfor %}
  </div>

  <!-- ===================== ALERT TIMELINE ===================== -->
  <div class="section-title" id="timeline">{{ t('Alert Timeline · last', '警报时间线 · 最近') }} {{ timeline_days }} {{ t('days', '天') }}
    <span class="faint" style="font-weight:600;text-transform:none;letter-spacing:0"> · {{ n_alerts }} {{ t('alerts', '条警报') }}</span></div>
  <div class="card">
    <div class="tl-filters">
      {% set filter_zh = {'All':'全部','Flash Crash':'闪崩','Risk':'风险','Structure':'结构','Momentum':'动量','Other':'其他'} %}
      {% for f,lab in [('all','All'),('flash','Flash Crash'),('risk','Risk'),('structure','Structure'),('momentum','Momentum'),('other','Other')] %}
      <button class="tlf {{ 'active' if f=='all' else '' }}" data-f="{{ f }}">{{ t(lab, filter_zh[lab]) }}</button>{% endfor %}
    </div>
    {% if timeline %}
    <div class="timeline">
      {% for day in timeline %}
      <div class="tl-day">
        <div class="tl-date">{{ t(day.daylabel, day.daylabel_zh) }}</div>
        {% for e in day.events %}
        <details class="tl-item sev-{{ e.severity }}" data-f="{{ e.filter }}">
          <summary>
            <span class="tl-node n-{{ e.type }} n-{{ e.severity }}"></span>
            <span class="tl-chip f-{{ e.filter }}">{{ t(e.label, e.label_zh) }}</span>
            <span class="tl-head">{{ t(e.headline, e.headline_zh) }}</span>
            <span class="tl-time">{{ e.time }}</span>
          </summary>
          <div class="tl-detail">
            {{ t(e.detail, e.detail_zh) }}
            {% if e.edge %}<div class="tl-edge"><b>{{ t('Conviction:', '可信度：') }}</b> {{ t(e.edge, e.edge_zh) }}</div>{% endif %}
            {% if e.forward %}<div class="tl-fwd">{{ t(e.forward, e.forward_zh) }}</div>{% endif %}
            {% if e.anchor %}<a href="{{ e.anchor }}" class="tl-link">{{ t('View on dashboard →', '在仪表盘查看 →') }}</a>{% endif %}
          </div>
        </details>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="sub faint" style="padding:10px 0">{{ t('No alerts in the last', '最近') }} {{ timeline_days }} {{ t('days — markets quiet on every tracked signal.', '天无警报 — 所有跟踪信号均平静。') }}</div>
    {% endif %}
    <div class="sub faint" style="margin-top:14px">{{ t('Intraday alerts update during the day; regime and on-chain signals update daily. Built', '日内警报盘中更新；周期与链上信号每日更新。生成于') }} {{ built }}.</div>
  </div>

  <!-- ===================== CALIBRATION TRANSPARENCY ===================== -->
  <details class="sec-fold" id="calibration">
  <summary>{{ t('How much to trust this · measured records', '可信度如何 · 实测记录') }} <span class="hint">{{ t('Signal verdicts & ensemble test', '信号评定与集成检验') }}</span></summary>
  <div class="card">
    <h3>{{ t('Signal verdicts', '信号评定') }} <span class="faint" style="font-size:13px;font-weight:600">{{ t('forward outcomes,', '前瞻结果，') }} {{ calib.meta.span }}{{ t(', split-half', '，前后半段分检') }}</span></h3>
    <table class="catbl">
      <tr><td class="a">{{ t('Signal', '信号') }}</td><td>{{ t('Verdict', '评定') }}</td><td class="a">{{ t('What\'s measured', '测量内容') }}</td></tr>
      {% for sig,e in calib.signals.items() %}
      <tr><td class="a">{{ sig }}</td>
        <td><span class="verdict {{ 'v-conf' if 'CONFIRMED' in e.verdict else ('v-dir' if 'DIRECTIONAL' in e.verdict else 'v-ctx') }}">{{ td(e.verdict) }}</span></td>
        <td class="sub">{{ t('forward-return monotonicity by band', '按分档的前瞻收益单调性') }}</td></tr>
      {% endfor %}
      {% if calib.risk_drawdown %}
      <tr><td class="a">{{ t('risk_index (as risk)', 'risk_index（作为风险）') }}</td>
        <td><span class="verdict {{ 'v-conf' if 'CONFIRMED' in calib.risk_drawdown.verdict else 'v-dir' }}">{{ td(calib.risk_drawdown.verdict) }}</span></td>
        <td class="sub">{{ t('forward 7-day drawdown by band (its real job)', '按分档的前瞻 7 天回撤（其真正职责）') }}</td></tr>
      {% endif %}
    </table>
    <div class="sub" style="margin-top:12px">{{ t('House rule: a signal is called trustworthy only if its track record holds in both halves of history. The Risk Index is judged on forward', '内部准则：只有当一个信号的记录在历史的前后两半段都成立时，才会被称为可信。风险指数以前瞻') }} <b>{{ t('drawdown', '回撤') }}</b> {{ t('(not return) — at long horizons extreme risk marks capitulation, so it is contrarian there by design.', '（而非收益）来评判 — 在长周期下，极端风险标志着投降式抛售，故其在该处的设计本就是逆向的。') }}</div>
  </div>

  {% set ep = calib.ensemble_promotion %}
  {% if ep and ep.net_sharpe %}
  <div class="card" style="margin-top:18px">
    <h3>{{ t('Ensemble capstone · does combining beat the hand-tuned stance?', '集成总验 · 组合能否击败手调立场？') }}</h3>
    <div class="sub">{{ t('Six independent, de-correlated, equal-weighted signals tested net of cost in both halves — the stance stays.', '六个独立去相关等权信号扣除成本后在前后两半段检验 — 立场不变。') }}</div>
    <div class="sub" style="margin-top:8px;font-weight:700;color:var(--ink)">{{ td(ep.verdict) }}</div>
    <table class="catbl" style="margin-top:10px">
      <tr><td class="a">{{ t('Read','读数') }}</td><td>{{ t('Net Sharpe (full)','净夏普（全样本）') }}</td><td>{{ t('pre-2021','2021 前') }}</td><td>{{ t('post-2021','2021 后') }}</td></tr>
      {% set names = {'heuristic':['Hand-tuned Stance (shipped)','手调立场（已采用）'],'ensemble_eqw':['Orthogonalized ensemble','正交集成'],'best_single':['Best single signal','单一最佳信号']} %}
      {% for key in ['heuristic','ensemble_eqw','best_single'] %}{% set row = ep.net_sharpe[key] %}
      <tr><td class="a">{{ t(names[key][0], names[key][1]) }}{% if key=='best_single' %} <span class="faint">({{ ep.best_single }})</span>{% endif %}</td>
        <td><b>{{ row.full }}</b></td><td>{{ row.pre }}</td><td>{{ row.post }}</td></tr>
      {% endfor %}
    </table>
    <div class="sub faint" style="margin-top:10px;font-size:12px">{{ t('The ensemble beats any single signal, but not the shipped hand-tuned stance. So the stance stays.', '集成优于任何单一信号，但未超过当前采用的手调立场。因此保留现有立场。') }}</div>
  </div>
  {% endif %}
  </details>

  <div class="foot">
    Bitcoin Vector · {{ t('built', '生成于') }} {{ built }} · {{ t('data as of', '数据截至') }} {{ as_of }}<br>
    <span class="made">© 2026 Mastermind Inc</span>
  </div>
</div>
<script>
(function(){
  var fil=document.querySelectorAll('.tlf'), items=document.querySelectorAll('.tl-item');
  fil.forEach(function(b){b.addEventListener('click',function(){
    fil.forEach(function(x){x.classList.remove('active')}); b.classList.add('active');
    var f=b.dataset.f;
    items.forEach(function(it){ it.hidden=!(f==='all'||it.dataset.f===f); });
    document.querySelectorAll('.tl-day').forEach(function(d){
      var any=[...d.querySelectorAll('.tl-item')].some(function(i){return !i.hidden});
      d.style.display=any?'':'none';
    });
  });});
})();
</script>
<script>
/* Anchor-inside-details: open parent <details> when navigating to a hash target */
(function(){
  function openParentDetails(el){
    var p=el;
    while(p=p.parentElement){
      if(p.tagName==='DETAILS' && !p.open){ p.open=true; }
    }
  }
  function handleHash(){
    var h=location.hash; if(!h) return;
    var el=document.querySelector(h); if(!el) return;
    openParentDetails(el);
    setTimeout(function(){ el.scrollIntoView({behavior:'smooth',block:'start'}); },50);
  }
  document.addEventListener('DOMContentLoaded', handleHash);
  window.addEventListener('hashchange', handleHash);
})();
</script>
<script>
/* Vector charts keep their blue/red palette in zh mode — only axis titles + legend
   names translate. The CSS direction/risk colours DO invert in zh (red=up/green=down,
   see the html[data-lang="zh"] block), but the charts can't follow: most are single
   blue data-lines (inversion is meaningless) and chart_i18n only supports SYMMETRIC
   colour swaps, which can't express the blue->red / red->green remap (red is both a
   pole and a target). So charts stay descriptive blue/red. */
window.__CHART_SWAP__ = {
  colors: {},
  labels: {"BTC Price":"BTC 价格","Optimal strategy":"最优策略","Allocation":"仓位",
           "Buy / add":"买入 / 加仓","Sell / trim":"卖出 / 减仓",
           "5-day net flow":"5 日净流入","Net flow (BTC)":"净流入（BTC）",
           "Network Growth":"网络增长","Liquidity":"流动性","Momentum":"动量",
           "Structure Shift":"结构转变","Price $":"价格 $","Risk":"风险","Alloc":"仓位"}
};
</script>
<script src="theme.js"></script>
<script src="chart_i18n.js"></script>
<script src="vector_timemachine.js"></script>
<!-- interactive Risk-Index-vs-Strategy backtest chart (bespoke Lightweight Charts v5) -->
<script src="lightweight-charts-v5.js"></script>
<script src="vector_chart.js"></script>
<script>
(function(){
  var el=document.getElementById('vec-risk-chart'); if(!el||!window.VectorChart) return;
  var sc=document.getElementById('vrc-score'), lab=document.getElementById('vrc-variant-label');
  var cards={}; try{cards=JSON.parse(sc.getAttribute('data-cards'));}catch(e){}
  var zh=(document.documentElement.getAttribute('data-lang')==='zh');
  var vname={conservative:zh?'保守':'Conservative',moderate:zh?'稳健':'Moderate',aggressive:zh?'进取':'Aggressive',optimal:zh?'最优':'Optimal'};
  function sync(v){
    var c=cards[v]; if(!c||!sc) return;
    sc.querySelectorAll('[data-m]').forEach(function(n){
      var m=n.getAttribute('data-m'), val=c[m];
      n.textContent = (m==='cagr'||m==='maxdd'||m==='in_market')?(val+'%'):(m==='x_hodl')?(val+'× HODL'):val;
    });
    if(lab) lab.textContent='· '+(vname[v]||v)+(zh?' 变体':' variant');
  }
  window.VectorChart.mount(el,'vector_risk_strategy.json',{onVariant:sync});
})();
</script>
<footer class="site-footer">
  <span class="made">© 2026 Mastermind Inc</span>
</footer>
</body>
