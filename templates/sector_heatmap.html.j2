{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>S&P 500 Heatmap — Market Intelligence</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 'Inter',-apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:0 0 28px; }
  a { text-decoration:none; }
  .wrap { padding:16px; }
  @media (min-width:1100px){ .wrap{ padding:18px max(28px,calc((100vw - 1680px)/2)); } }
  .hm-head { display:flex; flex-wrap:wrap; align-items:flex-end; gap:8px 22px; margin:10px 2px 16px; }
  .hm-head h1 { font-size:23px; margin:0; font-weight:800; letter-spacing:-.015em; }
  .hm-head .sub { color:var(--muted); font-size:12.5px; margin-top:5px; max-width:74ch; line-height:1.5; }
  .hm-foot { color:var(--muted); font-size:11px; margin:14px 2px 0; line-height:1.6; }
</style>
</head>
<body>
<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="aibrief.html">🧠 {{ t('AI Daily Brief', 'AI每日简报') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <div class="hm-head">
    <div>
      <h1>🔥 {{ t('S&P 500 Heatmap', 'S&P 500 热力图') }}</h1>
      <div class="sub">{{ t('Every S&P 500 name, grouped by sector and industry, sized by market cap and shaded by the move over the timeframe you pick. Hover any tile for our conviction read on it; click through to the full stock analyzer.',
                            '全部标普500成份股，按板块与行业分组，按市值定大小，并按所选周期的涨跌幅着色。将鼠标悬停在任意方块上查看我们对它的研判；点击进入完整的个股分析器。') }}</div>
    </div>
  </div>

  <div id="heatmap-full"></div>

  <div class="hm-foot">
    {{ t('Tiles are sized by market cap and binned by the % change over the selected timeframe (the 1D view uses ±1/2/3% bins; longer windows widen the bins so the map stays legible — green = up, red = down, inverted in 中文 to the Asian convention). Daily windows (1D–1Y) are computed from adjusted closes. The hover card shows our own conviction read (verdict, 0–100 score, drivers and cautions) — research context, never a buy signal.',
          '方块按市值定大小，并按所选周期的涨跌幅分档着色（1天视图采用 ±1/2/3% 分档；更长周期会拓宽分档以保持可读性 — 绿涨红跌，中文模式按亚洲习惯反转）。日线周期（1天–1年）由复权收盘价计算。悬停卡片展示我们自有的研判（结论、0–100 评分、驱动因素与风险提示）——仅作研究参考，绝非买入信号。') }}
  </div>
</div>

<footer class="site-footer">
  <span class="made">Made with ❤️ in Canada</span>
  <span class="dev">Developed by Chris Wong</span>
</footer>

<script src="theme.js"></script>
<script src="stockdata.js"></script>
<script src="heatmap.js"></script>
</body>
</html>
