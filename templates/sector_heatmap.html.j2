{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>S&P 500 Sector Heatmap — Market Intelligence</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 'Inter',-apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:0 0 28px; }
  a { text-decoration:none; }
  .wrap { padding:16px; }
  @media (min-width:1100px){ .wrap{ padding:18px max(28px,calc((100vw - 1640px)/2)); } }

  /* ---- header ------------------------------------------------------------ */
  .hm-head { display:flex; flex-wrap:wrap; align-items:flex-end; gap:14px 22px;
             margin:6px 2px 14px; }
  .hm-title h1 { font-size:21px; margin:0; font-weight:800; letter-spacing:-.01em; }
  .hm-title .sub { color:var(--muted); font-size:12.5px; margin-top:3px; }
  .hm-status { display:flex; align-items:center; gap:8px; font-size:11.5px;
               color:var(--muted); flex-wrap:wrap; }
  .hm-dot { width:7px; height:7px; border-radius:50%; background:var(--muted);
            box-shadow:0 0 0 3px color-mix(in srgb,var(--muted) 22%,transparent); }
  .hm-dot.live { background:var(--up); box-shadow:0 0 0 3px color-mix(in srgb,var(--up) 26%,transparent); }
  .hm-chip { padding:2px 9px; border-radius:20px; background:var(--panel2);
             border:1px solid var(--line); font-weight:600; }

  /* ---- controls ---------------------------------------------------------- */
  .hm-bar { display:flex; flex-wrap:wrap; align-items:center; gap:12px 16px;
            background:var(--panel); border:1px solid var(--line); border-radius:12px;
            padding:11px 14px; margin:0 2px 14px; box-shadow:var(--card-shadow); }
  .tf-group { display:flex; flex-direction:column; gap:5px; }
  .tf-group .lab { font-size:10px; text-transform:uppercase; letter-spacing:.08em;
                   color:var(--muted); font-weight:700; }
  .tf-pills { display:flex; flex-wrap:wrap; gap:4px; }
  .tf { font-size:12px; font-weight:600; padding:5px 11px; border-radius:8px;
        background:var(--panel2); color:var(--text); border:1px solid var(--line);
        cursor:pointer; user-select:none; transition:background .12s,border-color .12s,color .12s;
        white-space:nowrap; }
  .tf:hover:not(.off) { border-color:color-mix(in srgb,var(--link) 60%,var(--line)); }
  .tf.on { background:var(--link); border-color:var(--link); color:#fff; }
  .tf.off { opacity:.4; cursor:not-allowed; filter:grayscale(.4); }
  .tf .soon { font-size:9px; opacity:.7; margin-left:3px; }
  .hm-sep { width:1px; align-self:stretch; background:var(--line); margin:2px 2px; }
  .hm-spacer { flex:1 1 14px; }

  /* metric toggle (% vs abs scale) + size note */
  .hm-opt { display:flex; align-items:center; gap:9px; font-size:11.5px; color:var(--muted); }
  .hm-opt .sw { display:inline-flex; border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  .hm-opt .sw b { padding:4px 9px; cursor:pointer; font-weight:600; color:var(--muted);
                  background:var(--panel2); }
  .hm-opt .sw b.on { background:var(--link); color:#fff; }

  /* ---- legend ------------------------------------------------------------ */
  .legend { display:flex; align-items:center; gap:8px; font-size:11px; color:var(--muted); }
  .legend .bar { width:170px; height:11px; border-radius:6px; border:1px solid var(--line);
                 background:linear-gradient(90deg,var(--down),var(--g-mid),var(--up)); }
  html[data-lang="zh"] .legend .bar { background:linear-gradient(90deg,var(--down),var(--g-mid),var(--up)); }
  .legend b { color:var(--text); font-weight:700; font-variant-numeric:tabular-nums; }

  /* ---- treemap ----------------------------------------------------------- */
  #tm-wrap { position:relative; width:100%; border-radius:12px; overflow:hidden;
             background:var(--panel); border:1px solid var(--line); }
  #tm { position:relative; width:100%; }
  .sec { position:absolute; overflow:hidden; }
  .sec-hd { position:absolute; left:0; top:0; width:100%; display:flex; align-items:center;
            gap:7px; padding:0 7px; font-weight:800; letter-spacing:.01em;
            color:var(--text); white-space:nowrap; pointer-events:none; z-index:3;
            text-shadow:0 1px 2px rgba(0,0,0,.35); }
  .sec-hd .pc { font-weight:700; font-variant-numeric:tabular-nums; opacity:.95; }
  .ind-hd { position:absolute; padding:0 4px; font-size:10px; font-weight:700;
            color:color-mix(in srgb,var(--text) 78%,transparent); white-space:nowrap;
            pointer-events:none; z-index:2; text-transform:uppercase; letter-spacing:.03em;
            overflow:hidden; text-overflow:ellipsis; }
  .tile { position:absolute; overflow:hidden; cursor:pointer; border:0.5px solid rgba(0,0,0,.18);
          display:flex; flex-direction:column; align-items:center; justify-content:center;
          text-align:center; line-height:1.08; }
  .tile:hover { outline:1.5px solid #fff; outline-offset:-1.5px; z-index:5; }
  .tile .sym { font-weight:800; }
  .tile .pc { font-weight:600; font-variant-numeric:tabular-nums; opacity:.96; }
  .tile.tiny .pc { display:none; }
  .tile.micro .sym { display:none; }

  /* ---- tooltip ----------------------------------------------------------- */
  #tm-tip { position:fixed; z-index:80; pointer-events:none; display:none; max-width:280px;
            background:var(--panel); border:1px solid var(--line); border-radius:10px;
            padding:9px 11px; box-shadow:var(--popover-shadow); font-size:12px; }
  #tm-tip .tt-sym { font-weight:800; font-size:13.5px; }
  #tm-tip .tt-nm { color:var(--muted); font-size:11px; margin:1px 0 6px; }
  #tm-tip .tt-row { display:flex; justify-content:space-between; gap:18px; }
  #tm-tip .tt-row span:first-child { color:var(--muted); }
  #tm-tip .tt-row b { font-variant-numeric:tabular-nums; }
  #tm-tip .tt-grid { display:grid; grid-template-columns:auto auto; gap:2px 16px; margin-top:6px;
                     padding-top:6px; border-top:1px solid var(--line); font-size:11px; }
  #tm-tip .tt-grid span { color:var(--muted); }
  #tm-tip .tt-grid b { font-variant-numeric:tabular-nums; text-align:right; }
  .pos { color:var(--up); } .neg { color:var(--down); }

  .hm-empty { padding:50px 20px; text-align:center; color:var(--muted); }
  .hm-foot { color:var(--muted); font-size:11px; margin:12px 2px 0; line-height:1.55; }
</style>
</head>
<body>
<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <div class="hm-head">
    <div class="hm-title">
      <h1>🔥 {{ t('S&P 500 Sector Heatmap', 'S&P 500 板块热力图') }}</h1>
      <div class="sub">{{ t('Every S&P 500 constituent, grouped by sector and industry, sized by market cap and shaded by performance.',
                            '全部标普500成份股，按板块与行业分组，按市值定大小、按涨跌幅着色。') }}</div>
    </div>
    <span class="hm-spacer"></span>
    <div class="hm-status" id="hm-status">
      <span class="hm-dot" id="hm-dot"></span>
      <span id="hm-src">{{ t('Loading…', '加载中…') }}</span>
    </div>
  </div>

  <div class="hm-bar">
    <div class="tf-group">
      <span class="lab">{{ t('Timeframe', '时间周期') }}</span>
      <div class="tf-pills" id="tm-tabs"></div>
    </div>
    <span class="hm-sep"></span>
    <div class="legend" id="hm-legend">
      <b id="lg-lo">–</b>
      <span class="bar"></span>
      <b id="lg-hi">+</b>
      <span style="margin-left:4px">{{ t('scale', '量程') }}</span>
    </div>
    <span class="hm-spacer"></span>
    <div class="hm-opt">
      <span>{{ t('Size', '大小') }}</span>
      <span id="hm-size-basis" class="hm-chip">{{ t('Market cap', '市值') }}</span>
    </div>
  </div>

  <div id="tm-wrap"><div id="tm"><div class="hm-empty">{{ t('Loading heatmap…', '正在加载热力图…') }}</div></div></div>

  <div class="hm-foot">
    {{ t('Tiles are sized by market cap and coloured by the % change over the selected timeframe (green = up, red = down; inverted in 中文 to the Asian convention). Daily windows (1D–1Y) are computed from adjusted closes; intraday and after-hours windows light up once a live/minute feed is connected. Prices are 15-minute delayed via Polygon.',
          '方块按市值定大小，按所选周期的涨跌幅着色（绿涨红跌；中文模式按亚洲习惯反转）。日线周期（1天–1年）由复权收盘价计算；日内与盘后周期将在接入实时/分钟级数据后启用。价格经 Polygon 延迟约15分钟。') }}
  </div>
</div>

<div id="tm-tip"></div>

<footer class="site-footer">
  <span class="made">Made with ❤️ in Canada</span>
  <span class="dev">Developed by Chris Wong</span>
</footer>

<script src="theme.js"></script>
<script src="live_config.js"></script>
<script src="sp500_heatmap.js"></script>
</body>
</html>
