{# Shared base-effect forward-regime strip (v0): the forward ECONOMIC quad the KNOWN base is
   forcing over the next 3 quarters. Included by dashboard.html.j2 (US) and china.html.j2. Uses
   the parent's t()/help() (with-context) + latest.base_effect. Text is market-neutral. DISPLAY-
   ONLY / MODELED; hidden until a render writes latest.base_effect (guarded, degrade-never-raise). #}
{% if latest.base_effect and latest.base_effect.growth and latest.base_effect.inflation %}
{% set _be = latest.base_effect %}
{% set _bg = _be.growth %}
{% set _bi = _be.inflation %}
{% set _QN = {'Q1':['GOLDILOCKS','理想增长'],'Q2':['REFLATION','再通胀'],'Q3':['STAGFLATION','滞胀'],'Q4':['GROWTH SCARE','增长恐慌']} %}
{% macro _iq(g, i) %}{% if g >= 0 and i < 0 %}Q1{% elif g >= 0 and i >= 0 %}Q2{% elif g < 0 and i >= 0 %}Q3{% else %}Q4{% endif %}{% endmacro %}
{% macro _accel(s) %}{% if s > 0 %}▲ {{ t('accelerating','加速') }}{% elif s < 0 %}▼ {{ t('decelerating','减速') }}{% else %}– {{ t('flat','走平') }}{% endif %}{% endmacro %}
{% macro _axnote(a) %}{% set c = a.q1 %}{{ t('low base' if c > 0 else ('high base' if c < 0 else 'neutral base'), '低基数' if c > 0 else ('高基数' if c < 0 else '中性基数')) }}{% if a.current_yoy is not none and a.yoy_path and a.yoy_path[-1] is not none %} · {{ t('YoY','同比') }} {{ '%.1f'|format(a.current_yoy) }}%→{{ '%.1f'|format(a.yoy_path[-1]) }}% {{ t('3q','3季') }}{% endif %}{% endmacro %}
{% set _q1q = _iq(_bg.q1, _bi.q1)|trim %}
{# _embedded (set by _regime_read_panel) drops the standalone panel chrome so this can sit
   inside the combined "Regime — now & next" card; china.html.j2 includes it unembedded. #}
<div class="{{ 'rr-part' if _embedded else 'panel span12 bfwd' }}">
  <div class="bfwd-head">
    <h3>{{ t('Where the regime is headed','周期将去往何处') }} · {{ t('base-effect forward path','基数效应前瞻路径') }}</h3>
    <span class="mbadge modeled">{{ t('MODELED','模型推算') }}</span>
    {{ help("Forward growth/inflation path implied by known base effects.",
             "由已知基数效应推算的增长/通胀前瞻路径。") }}
  </div>
  <div class="bfwd-main">
    <div class="bfwd-now q-{{ _q1q }}" style="background:var(--q{{ _q1q[1] }})">
      <span class="k">{{ t('NEXT QUARTER','下一季度') }}</span>
      <span class="v">{{ t(_QN[_q1q][0], _QN[_q1q][1]) }}</span>
      <span class="s">{{ t('base-forced','基数迫使') }}</span>
    </div>
    <div class="bfwd-axes">
      <span class="bfwd-ax-l">{{ t('Growth','增长') }}</span>
      <span class="bfwd-ax-v">{{ '%.1f'|format(_bg.current_yoy) }}%<span class="bfa">{{ _accel(_bg.q1) }}</span></span>
      <span class="bfwd-ax-n">{{ _axnote(_bg) }}</span>
      <span class="bfwd-ax-l">{{ t('Inflation','通胀') }}</span>
      <span class="bfwd-ax-v">{{ '%.1f'|format(_bi.current_yoy) }}%<span class="bfa">{{ _accel(_bi.q1) }}</span></span>
      <span class="bfwd-ax-n">{{ _axnote(_bi) }}</span>
    </div>
  </div>
  <div class="bfwd-path">
    <span class="pl">{{ t('3-quarter path','三季度路径') }}</span>
    {% for _q in ['q1','q2','q3'] %}
      {% set _qq = _iq(_bg[_q], _bi[_q])|trim %}
      {% if not loop.first %}<span class="arw">→</span>{% endif %}
      <span class="bfq q-{{ _qq }}" style="background:var(--q{{ _qq[1] }})">+{{ loop.index }}Q <small>{{ t(_QN[_qq][0], _QN[_qq][1]) }}</small></span>
    {% endfor %}
  </div>
</div>
{% endif %}
