  {% set _n_entry = (_entry_rows | length) + _n_more_lane %}
  {% set _n_rip = _rip_ready | length %}
  {% set _n_early = (_rip_basing | length) + (_rip_fall | length) + _n_forming_lane %}
  {% set _n_ran = (_ran_late_rows | length) + (_ran | length) + _n_late_lane %}
  {% set _stf_default = 'entry' if _n_entry else 'all' %}
  <div class="panel span12" id="standouts" data-stfacet="{{ _stf_default }}">
    <h2>{{ t('⚡ China Prophet — Featured Entries', '⚡ 中国先知 — 精选入场') }}
      {{ help("The featured shelf is deliberately selective: an actionable T1–T3 confluence (T3 is anticipatory), ENTRY lifecycle, an open/partial entry gauge, known liquidity, same-session fillability, no chase veto, and no extension flag. Priority 0–100 is a transparent readiness rank: signal 35%, entry 25%, runway 20%, bottom quality 10%, and deepest-quintile within-sector reversal membership 10%. Residual momentum, sector stories and fundamentals do not move the live rank because China tests have not proven an incremental edge from them. The score is not a win probability or return forecast; the new definition's forward record is accruing. Broader and blocked names remain below on demand.", "精选区刻意保持严格：必须具备可操作的T1–T3共振（T3为前瞻信号）、处于ENTRY生命周期、入场量表已开启/部分开启、流动性已知、当日可成交、无追涨否决且未过度延伸。优先级0–100采用透明的就绪度排序：信号35%、入场25%、上行空间20%、底部质量10%、行业内3个月跌幅最深五分位成员10%。残差动量、板块叙事与基本面不会影响实时排名，因为中国市场测试尚未证明它们具有增量优势。该分数不是胜率或收益预测；新定义的前瞻记录仍在积累。更多候选与受阻标的可在下方按需展开。") }}
      {# W8-E: grid/table view toggle #}
      <span class="st-view-toggle" id="st-view-toggle" role="group" data-tip-en="Switch between grid and table view" data-tip-zh="切换卡片视图与表格视图">
        <button id="st-btn-grid" aria-selected="true" onclick="StockTable._setView('grid')">⊞ <span class="l-en">Grid</span><span class="l-zh">卡片</span></button>
        <button id="st-btn-table" aria-selected="false" onclick="StockTable._setView('table')">☰ <span class="l-en">Table</span><span class="l-zh">表格</span></button>
      </span>
    </h2>
    {# W0.7 DATA OUTAGE BANNER — raw/actionable/featured width or same-day
       execution coverage degraded. Never rendered on a normal board. #}
    {% set _do = setups.get('data_outage') %}
    {% if _do and _do.get('flag') %}
    <div style="margin:6px 0 10px;padding:9px 13px;border-radius:9px;font-size:12px;line-height:1.5;border:1.5px solid var(--down);background:color-mix(in srgb,var(--down) 10%,var(--panel));color:var(--down)">
      ⚠ <b><span class="l-en">data coverage degraded — board incomplete today</span><span class="l-zh">数据覆盖下降 — 今日看板不完整</span></b>
      <span class="muted" style="font-size:10.5px;display:block;margin-top:2px"><span class="l-en">{{ _do.get('reason','') }}</span><span class="l-zh">{{ _do.get('reason_zh', _do.get('reason','')) }}</span></span>
    </div>
    {% endif %}
    {# ── W8-E: count chips row (live-updated by JS when in table mode) ── #}
    <div id="st-count-chips" style="display:none"></div>

    {# ── W8-E: table view mount point ─────────────────────────────────── #}
    <div id="stocktable-wrap"></div>

    {# ── W8-E: grid section (hidden in table mode by CSS .nb-grid-section) ── #}
    <div class="nb-grid-section">
    {# ── W-FCT: stage facet bar — filter the shelves instead of scrolling them.
       Lives inside .nb-grid-section so table mode hides it (the table has its own
       stage filter). Chips render only for non-empty shelves; Entry is the default
       (falls back to All when the entry shelf is empty today). #}
    <div class="sb-seg stgf-bar" id="st-facet-bar" role="tablist" aria-label="stage filter">
      <button role="tab" data-facet="entry" aria-selected="{{ 'true' if _stf_default == 'entry' else 'false' }}" data-tip-en="Featured entries plus broader actionable T1–T3 signals. Only the full cards cleared every buy-now check." data-tip-zh="精选入场加上更广泛的可操作T1–T3信号。只有完整卡片通过了全部即时入场检查。">🎯 {{ t('Live signals', '实时信号') }}<span class="stgf-n">{{ _n_entry }}</span></button>
      {% if _n_rip %}<button role="tab" data-facet="rip" aria-selected="false" data-tip-en="The turn is forming — nearest to entry, but not buyable yet." data-tip-zh="转向形成中——最接近入场，但尚不可买。">🌱 {{ t('Ripening', '蓄势中') }}<span class="stgf-n">{{ _n_rip }}</span></button>{% endif %}
      {% if _n_early %}<button role="tab" data-facet="early" aria-selected="false" data-tip-en="Still basing or still falling — no turn yet. Watch, don't touch." data-tip-zh="仍在筑底或下跌——尚未转向。只看不动。">⏳ {{ t('Too early', '为时尚早') }}<span class="stgf-n">{{ _n_early }}</span></button>{% endif %}
      {% if _n_ran %}<button role="tab" data-facet="ran" aria-selected="false" data-tip-en="Execution-blocked or late: unfillable, chase-vetoed, illiquid, extended, or past the entry lifecycle. Inspect the reason; do not chase." data-tip-zh="执行受阻或已晚：不可成交、追涨否决、流动性不足、过度延伸或已过入场周期。请查看原因，勿追涨。">⛔ {{ t('Blocked / late', '受阻 / 已晚') }}<span class="stgf-n">{{ _n_ran }}</span></button>{% endif %}
      <button role="tab" data-facet="all" aria-selected="{{ 'true' if _stf_default == 'all' else 'false' }}">{{ t('All', '全部') }}<span class="stgf-n">{{ _n_entry + _n_rip + _n_early + _n_ran }}</span></button>
    </div>
    {# ── W1-C: ENTRY SHELF ────────────────────────────────────────────────────
       Only ENTRY cards may use BUY-family language. Stage badge is the loudest element.
       Preserves existing blend_sorted order unchanged (F3 discipline).
       Row partition (_entry_rows / _ran_late_rows sets) hoisted above the panel div — W-FCT. #}
    {{ pv.pv_css() }}
    <div class="stgf-grp" data-stf="entry">
    {% if not _entry_rows %}
    <div style="padding:12px;border:1px dashed var(--line);border-radius:9px;color:var(--muted);font-size:11.5px">
      {{ t('No name cleared every featured-entry check today. That is a valid selective result; broader live signals and early warnings remain available below.', '今日没有个股通过全部精选入场检查。这是严格筛选下的正常结果；更广泛的实时信号与早期预警仍可在下方查看。') }}
    </div>
    {% endif %}
    <div class="nbgrid" data-showmore-rows="3">
    {% for n in _entry_rows %}
      {# ═══ PROPHET CARD (flagship redesign 2026-07-21) — ENTRY shelf. Old nbcard retired;
         disclosures demoted, not deleted: verdict + entry headline + washout/coiled context →
         verb-chip tooltip; cautions / extension / chase-veto / limit-state → ⚠N popover;
         cycle-day + window + tier/sig detail → china_lookup analyzer (one click). #}
      {% set c = n.conviction %}
      {% set es = n.entry_signal %}
      {% set _pr = n.get('prophet') or {} %}
      {% set _pc = _pr.get('components') or {} %}
      {% set _st = es.status if es else none %}
      {% set _verb = 'buy' if _st in ('buy_now','partial')
               else ('near' if _st in ('buy_soon','await_confluence')
               else ('hold' if _st in ('hold','topping')
               else ('avoid' if _st in ('exit','avoid') else 'near'))) %}
      {% set _nmp = (n.name or n.ticker).split(' / ') %}
      {% set _mpkt = n.get('microstructure') or (cn_micro_by_ticker.get(n.ticker) if cn_micro_by_ticker else none) %}
      {% set _fl = namespace(rows=[]) %}
      {% if c %}{% for cau in (c.cautions or []) %}{% set _z = c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau %}{% set _fl.rows = _fl.rows + [(cau, _z)] %}{% endfor %}{% endif %}
      {% if n.extension and n.extension.extended %}{% set _fl.rows = _fl.rows + [('Already ran a lot — chase risk', '已经大涨 — 追高风险')] %}{% endif %}
      {% if _mpkt and (_mpkt.get('chase_veto') or {}).get('flag') %}{% set _fl.rows = _fl.rows + [('Chase veto — recent spike (CN-SYS-R3)', '追涨否决 — 近期涨幅过大（CN-SYS-R3）')] %}{% endif %}
      {% if _mpkt and _mpkt.get('limit_state') and _mpkt.get('limit_state') != 'open' %}{% set _fl.rows = _fl.rows + [('Limit state: ' ~ _mpkt.limit_state, '涨跌停状态：' ~ tr(_mpkt.limit_state)) ] %}{% endif %}
      {% if _pc.get('reversal_member') %}{% set _fl.rows = _fl.rows + [('Validated reversal sleeve member — deepest within-sector 3-month quintile', '已验证反转组合成员 — 行业内3个月跌幅最深五分位')] %}{% endif %}
      {% set _ctx_en = (' · washed out (2W)' if n.washout_2w else '') ~ (' · coiled' if (n.get('coiled') and n.get('coiled').get('coiled')) else '') %}
      {% set _ctx_zh = (' · 2周洗盘' if n.washout_2w else '') ~ (' · 蓄势' if (n.get('coiled') and n.get('coiled').get('coiled')) else '') %}
      {% set _tip_en = ((c.verdict if c else '') ~ (' · ' if (c and es) else '') ~ (es.headline if es else '')) ~ _ctx_en %}
      {% set _tip_zh = ((c.verdict_zh if c else '') ~ (' · ' if (c and es) else '') ~ (es.headline_zh if es else '')) ~ _ctx_zh %}
      {% set _bz = es.buy_zone if es else none %}
      {% set _zk = ('active' if _verb in ('buy','near') else 'muted') if (_bz and _bz.high is not none) else 'confirm' %}
      {{ pv.pv_card({
        'href': 'china_lookup.html#' ~ n.ticker, 'tk': n.ticker, 'mkt': 'cn',
        'name': _nmp[0], 'name_zh': _nmp[-1], 'sec': n.sector, 'sec_zh': SECZH.get(n.sector, n.sector),
        'price_txt': ('%.2f'|format(n.price)) if n.price is not none else none,
        'verb': _verb, 'tip_en': _tip_en, 'tip_zh': _tip_zh,
        'edge': (_pr.get('score') if _pr.get('score') is not none else (c.score if (c and c.score is not none) else none)),
        'edge_label_en': 'Priority', 'edge_label_zh': '优先级',
        'edge_tip_en': 'China Prophet priority 0–100 — signal 35% · entry 25% · runway 20% · bottom quality 10% · reversal-sleeve membership 10%. Transparent readiness rank; not a win probability or return forecast.',
        'edge_tip_zh': '中国先知优先级0–100 — 信号35% · 入场25% · 上行空间20% · 底部质量10% · 反转组合成员10%。透明就绪度排序；不是胜率或收益预测。',
        'stage': 3, 'spark': n.get('spark_svg'),
        'zone_kind': _zk,
        'zone_lo': ('%.2f'|format(_bz.low)) if (_bz and _bz.low is not none) else none,
        'zone_hi': ('%.2f'|format(_bz.high)) if (_bz and _bz.high is not none) else none,
        'date': (n.signal or {}).get('asof') or setups.get('as_of'),
        'flags': _fl.rows
      }) }}
    {% endfor %}
    </div>
    </div>{# /stgf-entry #}

    {# ── W1-C: RAN / LATE SHELF (buy rows — rule 2) ──────────────────────────
       These are gate-eligible names whose entry_signal says hold/extended/topping.
       Signal is live but entry timing has passed. No BUY-family language.
       Score is muted (opacity:0.45 via nb-stage-ran-card). #}
    {% if _ran_late_rows %}
    <div class="stgf-grp" data-stf="ran">
    <div class="nb-shelf-hdr" style="margin-top:16px">
      <span class="nb-shelf-tag st-ran"><span class="l-en">RAN / LATE</span><span class="l-zh">信号已过</span></span>
      <span class="nb-shelf-expl"><span class="l-en">signal live — entry passed; wait for pullback. Shown for honesty, not action — do not chase.</span><span class="l-zh">信号有效但入场时机已过；等待回调。出于诚实展示 — 不要追涨。</span></span>
    </div>
    <div class="nbgrid" data-showmore-rows="1">
    {% for n in _ran_late_rows %}
      {# ═══ PROPHET CARD — RAN / LATE shelf (W1-C rule 2 kept: signal live, entry passed;
         honesty display, no BUY-family language — verb is WAIT, zone slot carries the
         "entry passed" note, stage sits at Trend). F6 muted_entry (gauge open but extended)
         folds into the same WAIT verb with its own tooltip line. #}
      {% set c = n.conviction %}
      {% set es = n.entry_signal %}
      {% set _nmp = (n.name or n.ticker).split(' / ') %}
      {% set _fl = namespace(rows=[]) %}
      {% if c %}{% for cau in (c.cautions or []) %}{% set _z = c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau %}{% set _fl.rows = _fl.rows + [(cau, _z)] %}{% endfor %}{% endif %}
      {% if n.extension and n.extension.extended %}{% set _fl.rows = _fl.rows + [('Already ran a lot — chase risk', '已经大涨 — 追高风险')] %}{% endif %}
      {% set _hd_en = ('gauge open — but extended; not actionable' if n.get('muted_entry') else (es.headline if es else '')) %}
      {% set _hd_zh = ('量表打开 — 但已延伸；当前不可操作' if n.get('muted_entry') else (es.headline_zh if es else '')) %}
      {% set _ctx_en = (' · washed out (2W)' if n.washout_2w else '') ~ (' · coiled' if (n.get('coiled') and n.get('coiled').get('coiled')) else '') %}
      {% set _ctx_zh = (' · 2周洗盘' if n.washout_2w else '') ~ (' · 蓄势' if (n.get('coiled') and n.get('coiled').get('coiled')) else '') %}
      {% set _tip_en = ((c.verdict if c else '') ~ (' · ' if (c and _hd_en) else '') ~ _hd_en) ~ _ctx_en %}
      {% set _tip_zh = ((c.verdict_zh if c else '') ~ (' · ' if (c and _hd_zh) else '') ~ _hd_zh) ~ _ctx_zh %}
      {{ pv.pv_card({
        'href': 'china_lookup.html#' ~ n.ticker, 'tk': n.ticker, 'mkt': 'cn',
        'name': _nmp[0], 'name_zh': _nmp[-1], 'sec': n.sector, 'sec_zh': SECZH.get(n.sector, n.sector),
        'price_txt': ('%.2f'|format(n.price)) if n.price is not none else none,
        'verb': 'wait', 'tip_en': _tip_en, 'tip_zh': _tip_zh,
        'edge': (c.score if (c and c.score is not none) else none),
        'edge_label_en': 'Readiness', 'edge_label_zh': '就绪度',
        'edge_tip_en': 'Buy-readiness 0–100, muted — this name is on the RAN/LATE shelf: entry timing passed.',
        'edge_tip_zh': '买入就绪度0–100（已淡化）— 此股处于信号已过板块，入场时机已过。',
        'stage': 4, 'spark': n.get('spark_svg'),
        'zone_kind': 'note',
        'zone_note_en': 'Entry passed — wait for the pullback; do not chase',
        'zone_note_zh': '入场已过 — 等待回调，不要追涨',
        'date': (n.signal or {}).get('asof') or setups.get('as_of'),
        'flags': _fl.rows
      }) }}
    {% endfor %}
    </div>
    </div>{# /stgf-ran #}
    {% endif %}

    {# ── W8-R1: RIPENING SHELF (three-zone lifecycle: READY / BASING / FALLING sink) ─
       Full scorecards for READY + BASING; collapsed knife-sink for FALLING.
       NOT entry signals. No BUY-family language anywhere.
       Zone partition (_rip / _rip_ready / _rip_basing / _rip_fall sets) hoisted
       above the panel div — W-FCT. Tagged for BOTH facets: READY carries the
       "rip" facet, BASING + FALLING carry "early"; CSS splits the zones. #}
    {% if _rip or _rip_fall %}
    <div class="rip-shelf" data-stf="rip early" style="margin-top:16px">
      {# ── Shelf header ──────────────────────────────────────────────── #}
      <div class="rip-shelf-hdr">
        <span class="rip-shelf-title"><span class="l-en">RIPENING SHELF</span><span class="l-zh">筑底观察区</span></span>
        <span class="rip-shelf-sub"><span class="l-en">setup forming — NOT an entry signal</span><span class="l-zh">形态形成中 — 非入场信号</span></span>
        {% if setups.get('as_of') %}<span class="rip-shelf-asof"><span class="l-en">as of {{ setups.get('as_of','') }}</span><span class="l-zh">截至 {{ setups.get('as_of','') }}</span></span>{% endif %}
      </div>

      {# ── ZONE 1: READY — confluence forming, nearest to entry ─────────────── #}
      {% if _rip_ready %}
      <div class="rip-zone rz-ready">
        <div class="rip-zone-hdr">
          <span class="rip-zone-label"><span class="l-en">READY</span><span class="l-zh">共振形成中</span></span>
          <span class="rip-zone-count">{{ _rip_ready|length }}</span>
          <span class="rip-zone-defn"><span class="l-en">confluence forming — nearest to entry</span><span class="l-zh">接近入场条件</span></span>
        </div>
        <div class="rip-grid">
        {% for r in _rip_ready %}
        {%- set _r_ticker = r.get('ticker','') -%}
        {%- set _r_hist = r.get('macd_hist_d') -%}
        {%- set _r_slope = r.get('macd_hist_slope', 0) -%}
        {%- set _r_stoch = r.get('w2_stoch') -%}
        {%- set _r_arrow = r.get('w2_stoch_arrow', 0) -%}
        {%- set _r_bars = r.get('w1_cross_bars_since') -%}
        {%- set _r_d = r.get('w1_d_at_cross') -%}
        {%- set _r_diw = r.get('days_in_washout') -%}
        {%- set _r_rng = r.get('spot_pct_in_range') -%}
        {%- set _r_ret = r.get('ret_5d') -%}
        {%- set _r_price = r.get('price') -%}
        {%- set _r_imm = r.get('imminence') -%}
        <a href="china_lookup.html#{{ _r_ticker }}" class="rip-card" style="text-decoration:none;color:inherit">
          <div class="rip-card-stripe"></div>
          <div class="rip-card-body">
            {# Identity #}
            <div class="rip-card-id">
              <div>
                <div class="rip-card-tk">{{ _r_ticker }}</div>
                <div class="rip-card-nm">{{ nm(r.get('name','')) }}</div>
                <div class="rip-card-sec">{{ t(r.get('sector',''), SECZH.get(r.get('sector',''), r.get('sector',''))) }}</div>
              </div>
              {% if _r_price is not none %}
              <div style="text-align:right">
                <div class="rip-card-px">{{ '%.2f'|format(_r_price) }}</div>
                {% if _r_ret is not none %}<div style="font-size:10px;color:{{ 'var(--up)' if _r_ret >= 0 else 'var(--down)' }}">{{ '%+.1f'|format(_r_ret * 100) }}%</div>{% endif %}
              </div>
              {% endif %}
            </div>
            {# Sparkline #}
            {% if r.get('spark_svg') %}<div class="rip-card-spark">{{ r.get('spark_svg') | safe }}</div>{% endif %}
            {# Metrics grid #}
            <div class="rip-metrics">
              {# 2W Stoch + reclaim arrow #}
              <div class="rip-metric" data-tip-en="Oversold gauge — the 2-week StochRSI. 35 and below = washout zone, 20 and below = deeply oversold; the arrow is its direction." data-tip-zh="超卖量表 — 双周随机RSI。≤35＝洗盘区，≤20＝深度超卖；箭头为其方向。">
                <div class="rip-metric-lbl"><span class="l-en">Oversold gauge</span><span class="l-zh">超卖程度</span></div>
                <div class="rip-metric-val {% if _r_stoch is not none and _r_stoch <= 20 %}pos{% elif _r_stoch is not none and _r_stoch > 35 %}mut{% endif %}">
                  {% if _r_stoch is not none %}{{ '%.1f'|format(_r_stoch) }}{% else %}—{% endif %}
                  {% if _r_arrow == 1 %}<span class="rip-arrow up">↑</span>{% elif _r_arrow == -1 %}<span class="rip-arrow dn">↓</span>{% else %}<span class="rip-arrow fl">→</span>{% endif %}
                </div>
              </div>
              {# MACD D hist #}
              <div class="rip-metric" data-tip-en="Daily momentum — the daily MACD histogram. Above zero = short-term momentum has turned up; the small arrow is its recent slope." data-tip-zh="日线动能 — 日MACD柱。高于零＝短线动能转正；小箭头为近期斜率。">
                <div class="rip-metric-lbl"><span class="l-en">Daily momentum</span><span class="l-zh">日线动能</span></div>
                <div class="rip-metric-val {% if _r_hist is not none and _r_hist >= 0 %}pos{% elif _r_hist is not none %}neg{% endif %}">
                  {% if _r_hist is not none %}{{ '%+.3f'|format(_r_hist) }}{% else %}—{% endif %}
                  {%- if _r_slope == 1 %}<span style="font-size:9px">↑</span>{%- elif _r_slope == -1 %}<span style="font-size:9px">↓</span>{%- endif %}
                </div>
              </div>
              {# Washout depth (d at cross) #}
              <div class="rip-metric" data-tip-en="How oversold the weekly gauge was when it turned up (weekly StochRSI %D at the cross, 0–100 scale). Below 25 = turned up from a true washout; lower = deeper reset." data-tip-zh="周线量表转向时的超卖深度（周随机RSI %D，0–100）。低于25＝从真正的洗盘区转向；越低洗盘越深。">
                <div class="rip-metric-lbl"><span class="l-en">Washout depth</span><span class="l-zh">超卖深度</span></div>
                <div class="rip-metric-val mut">{% if _r_d is not none %}{{ '%.1f'|format(_r_d) }}{% else %}—{% endif %}</div>
              </div>
              {# Range position #}
              <div class="rip-metric" data-tip-en="Where the price sits inside its 2-year range — 0% = at the low, 100% = at the high." data-tip-zh="价格在两年区间中的位置 — 0%＝区间底部，100%＝区间顶部。">
                <div class="rip-metric-lbl"><span class="l-en">Range position</span><span class="l-zh">区间位置</span></div>
                <div class="rip-metric-val mut">{% if _r_rng is not none %}{{ '%.0f'|format(_r_rng) }}%{% else %}—{% endif %}</div>
              </div>
              {# Days in washout #}
              <div class="rip-metric" data-tip-en="How many trading days this name has spent in the washout zone so far." data-tip-zh="该股迄今处于洗盘（超卖）状态的交易日数。">
                <div class="rip-metric-lbl"><span class="l-en">Days in washout</span><span class="l-zh">超卖天数</span></div>
                <div class="rip-metric-val mut">{% if _r_diw %}~{{ _r_diw }}d{% else %}—{% endif %}</div>
              </div>
              {# 2W MACD imminence #}
              <div class="rip-metric" data-tip-en="Time to turn — estimated weeks until the 2-week MACD crosses upward at its current pace (the ripening clock). An estimate, not a promise." data-tip-zh="距转向 — 按当前速度估算双周MACD上穿还需的周数（成熟时钟）。仅为估算，非承诺。">
                <div class="rip-metric-lbl"><span class="l-en">Time to turn</span><span class="l-zh">距转向</span></div>
                <div class="rip-metric-val mut">{% if _r_imm is not none %}~{{ '%.1f'|format(_r_imm) }}{{ t('W','周') }}{% else %}—{% endif %}</div>
              </div>
            </div>
            {# Evidence + context chips — plain words at rest, engine receipt demoted to hover (doctrine Law 2) #}
            <div class="rip-chips">
              {% set _evd = r.get('evidence_display') or [] %}
              {% for ev in _evd %}
                <span class="rip-chip cp-ready" data-tip-en="Technical: {{ ev.get('receipt','') }}" data-tip-zh="技术依据：{{ ev.get('receipt','') }}"><span class="l-en">{{ ev.get('en','') }}</span><span class="l-zh">{{ ev.get('zh') or ev.get('en','') }}</span></span>
              {% endfor %}
              {# weekly-cross note — only when the evidence chips don't already say it #}
              {% if _r_bars is not none and '1W cross' not in ((r.get('evidence') or []) | join(' ')) %}
                <span class="rip-chip cp-cross"><span class="l-en">weekly gauge crossed up {% if _r_bars == 0 %}this week{% elif _r_bars == 1 %}1 wk ago{% else %}{{ _r_bars }} wks ago{% endif %}</span><span class="l-zh">周线{% if _r_bars == 0 %}本周{% else %}{{ _r_bars }}周前{% endif %}上穿</span></span>
              {% endif %}
              {% set _rr_narr = r.get('narrative') %}
              {% if _rr_narr and _rr_narr.get('theme') %}
                <span class="rip-chip cp-warn"><span class="l-en">{{ _rr_narr.get('theme') }}</span><span class="l-zh">{{ _rr_narr.get('theme_zh') or _rr_narr.get('theme') }}</span></span>
              {% endif %}
            </div>
          </div>
        </a>
        {% endfor %}
        </div>{# /rip-grid #}
      </div>{# /rz-ready #}
      {% endif %}

      {# ── ZONE 2: BASING — washout present, no directional trigger yet ──────── #}
      {% if _rip_basing %}
      <div class="rip-zone rz-basing">
        <div class="rip-zone-hdr">
