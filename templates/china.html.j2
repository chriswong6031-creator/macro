  /* Dialog open/close animation — ported from the US mx5 dialogs: the backdrop fades,
     the panel rises + scales in, and the body's first children stagger-fade-up. JS adds
     .cnx-in on the next frame after .open so the transitions actually run; .cnx-closing
     reverses faster on close. Reduced-motion shows everything instantly. */
  @media(prefers-reduced-motion:no-preference){
    body.page-china .cnx-dlg-backdrop{opacity:0;transition:opacity 240ms ease-out}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-backdrop{opacity:1}
    body.page-china .cnx-dlg-panel{opacity:0;transform:translateY(14px) scale(.965);transition:opacity 320ms cubic-bezier(.22,.9,.26,1.02),transform 320ms cubic-bezier(.22,.9,.26,1.02)}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-panel{opacity:1;transform:translateY(0) scale(1)}
    body.page-china .cnx-dlg.cnx-closing .cnx-dlg-backdrop{transition-duration:180ms}
    body.page-china .cnx-dlg.cnx-closing .cnx-dlg-panel{transition-duration:180ms}
    body.page-china .cnx-dlg-body > *{opacity:0;transform:translateY(10px);transition:opacity 300ms ease-out,transform 300ms cubic-bezier(.22,.9,.26,1.02)}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *{opacity:1;transform:translateY(0)}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *:nth-child(1){transition-delay:60ms}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *:nth-child(2){transition-delay:100ms}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *:nth-child(3){transition-delay:140ms}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *:nth-child(4){transition-delay:180ms}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *:nth-child(5){transition-delay:220ms}
    body.page-china .cnx-dlg.cnx-in .cnx-dlg-body > *:nth-child(n+6){transition-delay:0ms}
    body.page-china .cnx-dlg.cnx-closing .cnx-dlg-body > *{transition-delay:0ms!important}
    body.page-china .cnx-pop{transform-origin:top left;animation:cnxPopIn .16s cubic-bezier(.22,.9,.26,1.02)}
    @keyframes cnxPopIn{from{opacity:0;transform:translateY(-6px) scale(.97)}to{opacity:1;transform:none}}
  }
  @media(prefers-reduced-motion:reduce){
