    <p class="note">{{ t(
      pb.progress.age_days|string + ' trading days in, vs a median of ' + pb.progress.median_days|string + ' across ' + pb.progress.n_history|string + ' past ' + latest.quad_name + ' periods.',
      '已运行 ' + pb.progress.age_days|string + ' 个交易日，对比 ' + pb.progress.n_history|string + ' 段过往同象限周期的中位数 ' + pb.progress.median_days|string + ' 个交易日。') }}
      {% if pb.progress.pct_longer is not none %}{{ t(pb.progress.pct_longer|string + '% lasted longer than this so far' + (', and those typically ran ~' + pb.progress.median_remaining_days|string + ' more days.' if pb.progress.median_remaining_days else '.'), '其中 ' + pb.progress.pct_longer|string + '% 比当前持续更久' + ('，通常还会再运行约 ' + pb.progress.median_remaining_days|string + ' 个交易日。' if pb.progress.median_remaining_days else '。')) }}{% endif %}</p>
