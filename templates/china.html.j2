  body.page-china .mx5-regime-pill .mx5-dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--mx5-accent);box-shadow:0 0 6px var(--mx5-accent-glow);
  }
  body.page-china .mx5-pill-info{font-size:10px;opacity:.6;margin-left:3px;flex-shrink:0;}
  /* Score + verdict beside gauge */
  body.page-china .mx5-score-line{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;}
  body.page-china .mx5-verdict-word{
    white-space:nowrap;font-size:19px;font-weight:700;color:var(--ink-1);
  }
  body.page-china .mx5-big-score{
    font-size:64px;font-weight:800;line-height:.95;color:var(--mx5-accent-ink);
    text-shadow:0 0 40px var(--mx5-accent-glow);
    letter-spacing:-.035em;font-variant-numeric:tabular-nums;
  }
  body.page-china .mx5-sub-line{
    font-size:11px;color:var(--mx5-accent-ink);font-weight:600;margin-top:3px;
    letter-spacing:.02em;
  }
  body.page-china .mx5-score-yellow .mx5-sub-line{color:var(--mx5-warn-ink);}
  body.page-china .mx5-score-red .mx5-sub-line{color:var(--down);}
  /* In-gauge score numeral + needle inner-ring are mx5-only elements — paint them from the
     zh-flipping --up/--warn/--down pair directly (as #3174 does for .cnx-gauge-fill/.cnx-needle-*
     /.cnx-big-score/.cnx-verdict/.cnx-sub-line), so "risk-off = GREEN" in zh (operator ruling
     2026-07-21). Default amber (Mixed); the .ms-* rules below override. */
  body.page-china #mx5-score-numeral{fill:var(--warn);}
  body.page-china .ms-green  #mx5-score-numeral{fill:var(--up);}
  body.page-china .ms-red    #mx5-score-numeral{fill:var(--down);}
  body.page-china .ms-yellow #mx5-score-numeral{fill:var(--warn);}
  /* needle inner ring: accent STROKE, dark fill (kept from the presentation attr) */
  body.page-china .cnx-needle-ring{stroke:var(--warn);}
  body.page-china .ms-green .cnx-needle-ring{stroke:var(--up);}
  body.page-china .ms-red   .cnx-needle-ring{stroke:var(--down);}

  /* ── B · 60-session path panel (right) ── */
  body.page-china .mx5-sc-right{padding:22px 28px 20px;display:flex;flex-direction:column;}
  body.page-china .mx5-path-header{
    display:flex;justify-content:space-between;align-items:baseline;margin-bottom:14px;
  }
  body.page-china .mx5-path-title{
    font-size:11px;font-weight:700;letter-spacing:.10em;
    text-transform:uppercase;color:var(--ink-3);
  }
  body.page-china .mx5-path-meta{font-size:11px;color:var(--ink-3);}
  body.page-china .mx5-path-plot{position:relative;flex:1;min-height:190px;display:flex;}
  body.page-china .mx5-path-svg{
    display:block;width:100%;flex:1;min-height:190px;overflow:visible;touch-action:pan-y;
  }
  body.page-china .mx5-path-labels{
    position:absolute;inset:0;pointer-events:none;
    font-family:Inter,-apple-system,sans-serif;font-size:11px;line-height:1;
  }
  body.page-china .mx5-path-labels > span{position:absolute;white-space:nowrap;}
  body.page-china .mx5-pl-y{
    left:6px;transform:translateY(-50%);color:var(--ink-3);font-variant-numeric:tabular-nums;
  }
  body.page-china .mx5-pl-zone{right:14px;transform:translateY(-50%);font-weight:600;}
  body.page-china .mx5-pl-zone.on{color:color-mix(in srgb,var(--up) 62%,transparent);}
  body.page-china .mx5-pl-zone.mid{color:color-mix(in srgb,var(--warn) 66%,transparent);}
  body.page-china .mx5-pl-zone.off{color:color-mix(in srgb,var(--down) 60%,transparent);}
  body.page-china .mx5-pl-x{top:96.4%;color:var(--ink-3);}
  body.page-china .mx5-pl-today{
    width:9px;height:9px;border-radius:50%;transform:translate(-50%,-50%);
    background:currentColor;box-shadow:0 0 6px currentColor;
  }
  body.page-china .mx5-path-cross{
    position:absolute;top:0;width:1px;height:100%;
    background:linear-gradient(rgba(255,255,255,.28),rgba(255,255,255,.06));
    opacity:0;transform:translateX(-1px);pointer-events:none;
    transition:opacity .12s ease-out;will-change:left,opacity;
  }
  body.page-china .mx5-path-dot{
    position:absolute;width:11px;height:11px;border-radius:50%;
    background:var(--mx5-accent);border:2px solid var(--mx5-pop-bg);
    box-shadow:0 0 10px var(--mx5-accent-glow),0 0 0 1px rgba(255,255,255,.25);
    opacity:0;pointer-events:none;transform:translate(-50%,-50%);
    transition:opacity .12s ease-out;will-change:left,top,opacity;
  }
  body.page-china .mx5-path-tip{
    position:absolute;z-index:6;pointer-events:none;
    display:flex;flex-direction:column;gap:2px;padding:8px 11px;border-radius:10px;
    background:rgba(15,19,26,.72);border:1px solid rgba(255,255,255,.12);
    box-shadow:0 8px 30px rgba(0,0,0,.5);
    backdrop-filter:blur(16px) saturate(1.3);-webkit-backdrop-filter:blur(16px) saturate(1.3);
    opacity:0;transform:translate(-50%,calc(-100% - 14px)) translateY(4px);
    transition:opacity .13s ease-out,transform .13s ease-out;white-space:nowrap;
  }
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){
    body.page-china .mx5-path-tip{background:var(--mx5-pop-bg);}
  }
  [data-theme="light"] body.page-china .mx5-path-tip{
    background:rgba(255,255,255,.82);border-color:rgba(0,0,0,.10);box-shadow:0 8px 30px rgba(0,0,0,.16);
  }
  body.page-china .mx5-path-tip.show{opacity:1;transform:translate(-50%,calc(-100% - 14px));}
  body.page-china .mx5-path-tip-date{
    font-size:11px;font-weight:600;letter-spacing:.03em;color:var(--ink-3);text-transform:uppercase;
  }
  body.page-china .mx5-path-tip-row{display:flex;align-items:baseline;gap:7px;}
  body.page-china .mx5-path-tip-score{
    font-size:16px;font-weight:800;line-height:1;color:var(--ink-1);font-variant-numeric:tabular-nums;
  }
  body.page-china .mx5-path-tip-verdict{font-size:12px;font-weight:600;}
  @media(prefers-reduced-motion:reduce){
    body.page-china .mx5-path-cross,
    body.page-china .mx5-path-dot,
    body.page-china .mx5-path-tip{transition:none;}
  }

  /* ── C · Market tiles face (ONE glass button → markets dialog) ── */
  /* The face now replaces the four separate tiles inside .cnx-tiles (a 4-col grid),
     so it must span the full row; its own .mx5-mkt-grid holds the four tiles. */
  body.page-china .cnx-tiles > .sxg-face.mx5-card-face{grid-column:1 / -1;}
  body.page-china .sxg-face{display:flex;}
  body.page-china .sxg-face.mx5-card-face{
    flex-direction:column;cursor:pointer;user-select:none;position:relative;
    background:var(--mx5-glass-bg);border:1px solid var(--mx5-glass-border);
    border-radius:var(--mx5-radius-card);backdrop-filter:var(--mx5-blur);-webkit-backdrop-filter:var(--mx5-blur);
    box-shadow:var(--mx5-glass-shadow);
    padding:18px 20px 14px;min-height:unset;height:100%;
    transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;
  }
  body.page-china .sxg-face.mx5-card-face::before{
    content:"";position:absolute;inset:0;border-radius:inherit;
    background:linear-gradient(135deg,rgba(255,255,255,.04) 0%,transparent 55%);pointer-events:none;
  }
  body.page-china .sxg-face.mx5-card-face:hover{
    background:var(--mx5-hover-bg);border-color:var(--mx5-hover-border);
    box-shadow:var(--mx5-hover-shadow);transform:translateY(-1px);
  }
  body.page-china .sxg-face.mx5-card-face:focus-visible{
    outline:none;box-shadow:var(--mx5-focus-ring),var(--mx5-hover-shadow);
  }
  body.page-china .mx5-mkt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media(max-width:1100px){body.page-china .mx5-mkt-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){body.page-china .mx5-mkt-grid{grid-template-columns:1fr 1fr;}}
  body.page-china .mx5-mkt-tile{
    background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);
    border-radius:12px;padding:16px 18px 12px;position:relative;overflow:hidden;cursor:pointer;
    transition:background .2s ease-out,border-color .2s ease-out,box-shadow .2s ease-out,transform .2s ease-out;
  }
  [data-theme="light"] body.page-china .mx5-mkt-tile{background:rgba(0,0,0,.03);border-color:rgba(0,0,0,.07);}
  body.page-china .mx5-mkt-tile.up,
  body.page-china .mx5-mkt-tile.dn{border-color:var(--glass-border);}
  body.page-china .mx5-mkt-tile:hover,
  body.page-china .mx5-mkt-tile.up:hover,
  body.page-china .mx5-mkt-tile.dn:hover{
    background:var(--mx5-hover-bg);border-color:var(--mx5-hover-border);
    box-shadow:var(--mx5-hover-shadow);transform:translateY(-1px);
  }
  body.page-china .mx5-mkt-tile:focus-visible{outline:none;box-shadow:var(--mx5-focus-ring),var(--mx5-hover-shadow);}
  body.page-china .mx5-mkt-ticker{
    font-size:11px;font-weight:700;letter-spacing:.07em;color:var(--ink-3);text-transform:uppercase;margin-bottom:3px;
  }
  body.page-china .mx5-mkt-sub{
    font-size:11px;color:var(--ink-3);letter-spacing:.04em;text-transform:uppercase;margin-bottom:4px;
  }
  body.page-china .mx5-mkt-price{
    font-size:19px;font-weight:700;line-height:1;color:var(--ink-1);margin-bottom:4px;font-variant-numeric:tabular-nums;
  }
  body.page-china .mx5-mkt-delta{font-size:13px;font-weight:600;}
  body.page-china .mx5-mkt-delta.up{color:var(--up);}
  body.page-china .mx5-mkt-delta.dn{color:var(--down);}
  body.page-china .mx5-spark{margin-top:10px;}
  body.page-china .mx5-spark svg{width:100%;height:32px;display:block;}
  /* spark colour follows sign, routed through --up/--down so it flips in zh */
  body.page-china .mx5-spark-up path.mx5-spark-area{fill:color-mix(in srgb,var(--up) 10%,transparent);}
  body.page-china .mx5-spark-up path.mx5-spark-line,
  body.page-china .mx5-spark-up polyline{stroke:var(--up);}
  body.page-china .mx5-spark-dn path.mx5-spark-area{fill:color-mix(in srgb,var(--down) 8%,transparent);}
  body.page-china .mx5-spark-dn path.mx5-spark-line,
  body.page-china .mx5-spark-dn polyline{stroke:var(--down);}
  @media(prefers-reduced-motion:reduce){
    body.page-china .sxg-face.mx5-card-face,
    body.page-china .mx5-mkt-tile{transition:none!important;}
    body.page-china .sxg-face.mx5-card-face:hover,
    body.page-china .mx5-mkt-tile:hover,
    body.page-china .mx5-mkt-tile.up:hover,
    body.page-china .mx5-mkt-tile.dn:hover{transform:none!important;}
  }

  /* ── D · Market Sentiment odometer (dial-only; lives in the cnx-rack cnx-card) ── */
  body.page-china .mx5-sentiment-dial-wrap{text-align:center;margin-bottom:4px;}
  body.page-china .mx5-sentiment-zone-text{
    font-size:15px;font-weight:700;color:var(--mx5-accent-ink);text-align:center;margin-bottom:3px;
  }
  body.page-china .mx5-sentiment-label{
    font-size:11px;color:var(--ink-3);text-align:center;margin-top:2px;
  }
  /* zh 红涨绿跌 for the sentiment gauge: Euphoria=bullish→red, Panic=bearish→green (neutral amber).
     --fg-col routes through --up/--warn/--down so it auto-flips in zh; SVG marks + zone word read it. */
  body.page-china .fg-greed{--fg-col:var(--up)}
  body.page-china .fg-fear{--fg-col:var(--down)}
  body.page-china .fg-neutral{--fg-col:var(--warn)}
  body.page-china #cnx-sentiment .fg-mark-s{stroke:var(--fg-col)}
  body.page-china #cnx-sentiment .fg-mark-f{fill:var(--fg-col)}
  body.page-china #cnx-sentiment .fg-lab-panic{fill:var(--down)}
  body.page-china #cnx-sentiment .fg-lab-euph{fill:var(--up)}

{%- endif %}{# /mode != stocks — MX5 CSS #}
  /* ── AI BRIEF DIALOG — ABX v2: rules live in the shared _aibrief_css.j2 include
     (.aib2-* namespace, appended below). China keeps the ZH-safe blue accent by
     inheriting the shared --aib2-acc default (--info) — no override needed. Empty-
     brief fallback text keeps a local class. ──────────────────────────────────── */
  body.page-china .aib-empty{font-size:13px;color:var(--muted);line-height:1.6;margin:4px 0;}
{% include "_aibrief_css.j2" %}
</style>
</head>
<body class="{{ 'page-china-stocks' if mode == 'stocks' else 'page-china mx4-grid' }}">
{%- if mode != 'stocks' %}{%- set _aur_color = (market_state.color if market_state else 'yellow') %}<div class="aurora{{ ' au-red' if _aur_color == 'red' else (' au-yellow' if _aur_color == 'yellow' else '') }}" aria-hidden="true"><div class="au-a3"></div></div>
{%- endif %}

{% include "_site_nav.html.j2" %}

<div class="grid">

  {% if mode == 'stocks' %}
  <!-- ===================== A-SHARE STOCK DASHBOARD HEADER ===================== -->
  <div class="panel span12" id="stocks-header">
    <div style="display:flex;align-items:center;gap:12px 14px;flex-wrap:wrap">
      <h1 style="margin:0">🇨🇳 {{ t('A-Share Stock Dashboard', 'A股个股看板') }}
        {{ help('A stock-picking watchlist for China A-shares: names that sold off hard and just started turning back up. Rank means how ready a setup looks to buy — research context, not advice.', 'A股选股观察表：大幅回调后刚开始回升的个股。排序表示形态离买点有多近——研究参考，非投资建议。') }}</h1>
      {# Regime + Posture header pills, aligned with the US stock dashboard (Regime: … / Posture: …) #}
      <span style="display:inline-flex;align-items:center">
        <span class="badge quad-{{ latest.quad }}">{{ t('Regime', '周期') }}: {{ td(latest.quad_name) }}</span>{{ help("The macro / economic regime (growth × inflation quadrant) the whole page is filtered by — it describes the ECONOMY, not today's tape, so it shifts slowly. Use it for which sectors & factors are favoured, not for market timing. For whether the market itself is turning over, use the China macro dashboard's risk read.", "整页据以过滤的宏观／经济周期（增长×通胀象限）— 它描述的是经济，而非今日盘面，因此变化缓慢。用于判断哪些板块与因子占优，而非择时。市场本身是否转向，请看中国宏观看板的风险读数。") }}
      </span>
      {% if pb and pb.dial %}{% set pzh = {'DEFENSIVE':'防御','CAREFUL':'谨慎','NEUTRAL':'中性','CONSTRUCTIVE':'积极','AGGRESSIVE':'进取'} %}<span style="display:inline-flex;align-items:center">
        <span class="badge" style="background:var(--panel2);color:var(--text)">{{ t('Posture', '姿态') }}: {{ t(pb.dial.posture, pzh.get(pb.dial.posture, pb.dial.posture)) }}</span>{{ help("How to TRADE the current regime — a defensive → aggressive stance dial (Defensive · Careful · Neutral · Constructive · Aggressive) set by the playbook. It sizes risk; it is not a buy/sell or stock-selection call. The full dial with its reasoning lives on the China macro dashboard.", "如何“交易”当前周期 — 一个防御→进取的姿态刻度（防御·谨慎·中性·建设性·进取），由策略手册设定。它用于调整风险敞口，并非买卖或选股建议。完整刻度及其推理见中国宏观看板。") }}
      </span>{% endif %}
    </div>
    <p class="note" style="margin:8px 0 0;text-transform:none">
      <a href="china.html" style="color:var(--link);font-weight:600">← {{ t('China macro dashboard', '中国宏观看板') }}</a>
      <a href="china_stocks_lab.html" style="margin-left:14px;padding:4px 11px;border:1.5px solid var(--link);border-radius:8px;font-size:12px;font-weight:700;color:var(--link);white-space:nowrap;display:inline-block;margin-top:4px">🧪 <span class="l-en">Pick Lab</span><span class="l-zh">选股实验室</span></a></p>
    {# W5b EDGE-1 — CN drawdown-radar RISK-BACKDROP cue. Source: engine/risk_radar_intl.py
       cn_sleeve_chip(), wired into setups.sleeve_chip by build_china_library.main().
       Plain-word rebuild of the old "Sleeve ×0.62" chip: the "sleeve" multiplier was
       jargon. Coloured from the zh-flipping direction pair --down/--warn/--up (operator
       ruling 2026-07-21, reverses #2947's no-flip): the risk backdrop is a market-
       direction read, so risk-off shows green in zh per the Asia convention, matching
       theme.css's .rrx remap and the macro-board state gauge. This is the ONLY risk read on the
       stocks page (Pullback-Risk card is macro-mode only). Degrades: hidden when
       sleeve_chip absent or radar_state None. CN-SYS-R7: display context, never board-sort. #}
    {% set _sc = setups.sleeve_chip if setups else none %}
    {% if _sc and _sc.radar_state and _sc.radar_state != 'None' %}
    {% set _rs = _sc.radar_state %}
    {% set _rs_col = 'var(--down)' if _rs in ('elevated','risk-off') else ('var(--warn)' if _rs == 'caution' else 'var(--up)') %}
    {% set _rs_en = {'risk-off':'RISK-OFF','elevated':'ELEVATED','caution':'CAUTION','calm':'CALM'}.get(_rs, _rs|upper) %}
    {% set _rs_zh = {'risk-off':'避险','elevated':'偏高','caution':'谨慎','calm':'平静'}.get(_rs, _rs) %}
    {% set _rs_act_en = {'risk-off':'trade smaller','elevated':'trade smaller','caution':'avoid chasing','calm':'normal sizing'}.get(_rs, '') %}
    {% set _rs_act_zh = {'risk-off':'减小仓位','elevated':'减小仓位','caution':'谨慎追高','calm':'正常仓位'}.get(_rs, '') %}
    {% set _rs_idx = {'calm':0,'caution':1,'elevated':2,'risk-off':3}.get(_rs, 1) %}
    <div style="margin:8px 0 0;padding:6px 10px;border-radius:8px;font-size:11.5px;line-height:1.5;display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;border:1px solid var(--line);border-left:3px solid {{ _rs_col }};background:color-mix(in srgb,{{ _rs_col }} 6%,var(--panel))">
      <span style="font-weight:600;color:var(--muted)"><span class="l-en">Risk backdrop</span><span class="l-zh">风险背景</span></span>
      <span aria-hidden="true" style="display:inline-flex;gap:3px;align-items:center">{% for _i in range(4) %}<span style="width:{{ 15 if _i == _rs_idx else 9 }}px;height:6px;border-radius:3px;background:{{ _rs_col if _i == _rs_idx else 'var(--line)' }}"></span>{% endfor %}</span>
      <span style="color:{{ _rs_col }};font-weight:700"><span class="l-en">{{ _rs_en }} — {{ _rs_act_en }}</span><span class="l-zh">{{ _rs_zh }} — {{ _rs_act_zh }}</span></span>
      {% if _sc.dominant_driver_en %}<span class="muted" style="font-size:10.5px">· <span class="l-en">main risk: {{ _sc.dominant_driver_en.split(' (')[0] }}</span><span class="l-zh">主要风险：{{ (_sc.dominant_driver_zh or _sc.dominant_driver_en).split('（')[0] }}</span></span>{% endif %}
      {% if _sc.radar_as_of %}<span class="muted" style="font-size:10px">· {{ t('as of', '截至') }} {{ _sc.radar_as_of }}</span>{% endif %}
      {{ help('CN drawdown radar: external-driver risk (US rate shocks, USD/CNH, US–China yield gap, market breadth). Sets a risk backdrop for sizing — context only, never vetoes names or changes board rank (CN-SYS-R7).', 'CN回撤雷达：衡量外部驱动风险（美债利率冲击、美元/人民币、中美利差、市场广度）。用于设定仓位风险背景——仅供背景参考，不排除个股或改变看板排名（CN-SYS-R7）。') }}
    </div>
    {% endif %}
  </div>

  <!-- ===================== ACT-NOW v2 — FOUR-LANE BOARD (W8-R3) ===================== -->
  {# act_now_v2: assembled by engine/china_act_now.assemble_act_now() in build_china.py.
     Sectors + themes co-exist as typed rows (THEME / SECTOR / BASKET chips).
     Bottoming lane copy law: never BUY-family words (F1/W8-R3).
     Dual-read law (FT-R1): a name in reduce AND bottoming appears in BOTH lanes.
     Macro mode: only the legacy actcol sub-panel is used (untouched, see line ~1275). #}
  {% if act_now_v2 %}
  {% set _anv2 = act_now_v2 %}
  {% set _anl = _anv2.lanes %}
  <div class="panel span12 anv2-board" id="act-now">
    <div class="anv2-hd">
      <h2 style="margin:0">⚡ {{ t('What to Act On Now', '现在行动') }}
        <span class="anv2-v2pill">v2</span>
        {{ help('Four lanes, read left to right: Buy Now = a clean entry point today. In Favour = still in favour, but it has run — wait for a dip. Bottoming Watch = beaten-down groups showing the first signs of turning up (watch only, never a buy signal). Reduce / Avoid = the trend is weakening. Rows mix investment themes (scored 0-100 by the basket engine) and sectors (timed by the cycle ladder). A name can honestly sit in two lanes at once — e.g. weakening trend but an early bottom forming — and is shown in both, never merged.', '四个分栏从左到右：立即买入＝今天有干净入场点。看好＝仍看好但已涨高，等回调再买。洗盘观察＝超跌板块初现回升迹象（仅观察，绝非买入信号）。减仓/回避＝趋势转弱。行内混合投资主题（篮子引擎0-100打分）与行业板块（周期阶梯定时机）。同一名称可能同时出现在两个分栏——例如趋势转弱但初现筑底——两种判读并列显示，永不合并。') }}
      </h2>
      <div class="anv2-meta">
        {% if _anv2.as_of %}<span class="muted" style="font-size:11px">{{ t('themes as of','主题截至') }} {{ _anv2.as_of }}</span>{% endif %}
        <a href="baskets_china.html#actnow" class="anv2-xlink">{{ t('theme desk →', '主题面板 →') }}</a>
      </div>
    </div>
    {% if _anv2.notes %}
    <div class="anv2-notes">{% for n in _anv2.notes %}<span class="muted" style="font-size:11px">⚠ {{ n }}</span>{% endfor %}</div>
    {% endif %}
    <div class="anv2-grid">

    {# ── Macro: row item helper ─────────────────────────────────────────── #}
    {%- macro _anrow(row, lane) -%}
    {# PR-4: resolve sector card for SECTOR rows (O(1) via sectors_by_ticker) #}
    {%- set _sc = (sectors_by_ticker.get(row.id) if row.kind == 'SECTOR' and sectors_by_ticker is defined else none) -%}
    {# PR-4: compute tag tone for hover card header #}
    {%- set _rptag_cls = 'up' if row.reco in ('accumulate','buy','add') else ('dn' if row.reco in ('avoid','trim','reduce','exit') else 'warn') -%}
    <div class="anv2-row" data-rpop>
      {# PR-4: hover card payload — cloned by theme.js into a .row-pop overlay #}
      <span class="rp-src" hidden>
        <div class="row-pop-hd">
          <span class="row-pop-name"><span class="l-en">{{ row.name }}</span><span class="l-zh">{{ row.name_zh or tr(row.name) }}</span></span>
          <span class="row-pop-kind"><span class="l-en">{{ row.kind }}</span><span class="l-zh">{{ tr(row.kind) }}</span></span>
          {%- if row.reco_en -%}
          <span class="row-pop-tag {{ _rptag_cls }}"><span class="l-en">{{ row.reco_en }}</span><span class="l-zh">{{ row.reco_zh or tr(row.reco_en) }}</span></span>
          {%- elif row.tag -%}
          <span class="row-pop-tag warn"><span class="l-en">{{ row.tag }}</span><span class="l-zh">{{ row.tag_zh or tr(row.tag) }}</span></span>
          {%- elif row.phase -%}
          <span class="row-pop-tag warn"><span class="l-en">{{ row.phase }}</span><span class="l-zh">{{ tr(row.phase) }}</span></span>
          {%- endif -%}
        </div>
        <div class="row-pop-div"></div>
        <div class="row-pop-grid">
          {%- if row.score is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Composite score</span><span class="l-zh">综合评分</span></span>
            <span class="row-pop-val">{{ row.score }}</span></div>
          {%- endif -%}
          {%- if row.rel20 is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">20d vs CSI 300</span><span class="l-zh">20日相对沪深300</span></span>
            <span class="row-pop-val"><span class="{{ 'up' if row.rel20 >= 0 else 'dn' }}">{{ '%+.1f'|format(row.rel20 * 100) }}%</span></span></div>
          {%- endif -%}
          {%- if row.rel5 is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">5d vs CSI 300</span><span class="l-zh">5日相对沪深300</span></span>
            <span class="row-pop-val"><span class="{{ 'up' if row.rel5 >= 0 else 'dn' }}">{{ '%+.1f'|format(row.rel5 * 100) }}%</span></span></div>
          {%- endif -%}
          {%- if row.rs_63d is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">63d RS · rank</span><span class="l-zh">63日相对强度 · 排名</span></span>
            <span class="row-pop-val"><span class="{{ 'up' if row.rs_63d >= 0 else 'dn' }}">{{ '%+.1f'|format(row.rs_63d) }}%</span>{% if row.rs_rank is not none %} <span class="mut">· #{{ row.rs_rank }}</span>{% endif %}</span></div>
          {%- endif -%}
          {%- if row.phase is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Cycle phase · position</span><span class="l-zh">周期阶段 · 位置</span></span>
            <span class="row-pop-val"><span class="l-en">{{ row.phase }}</span><span class="l-zh">{{ tr(row.phase) }}</span>{% if row.pos is not none %} <span class="mut">· {{ '%.0f'|format(row.pos) }}%</span>{% endif %}</span></div>
          {%- endif -%}
          {%- if row.osc_slope is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Turn oscillator</span><span class="l-zh">转向振荡器</span></span>
            <span class="row-pop-val"><span class="{{ 'up' if row.osc_slope > 0 else 'dn' }}">{{ '↗' if row.osc_slope > 0 else '↘' }} {{ '%.1f'|format(row.osc_slope) }}</span></span></div>
          {%- endif -%}
          {%- if row.organ_state is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Price tape</span><span class="l-zh">价格走势</span></span>
            <span class="row-pop-val"><span class="l-en">{{ row.organ_state|replace('_',' ')|title }}</span><span class="l-zh">{{ tr(row.organ_state) }}</span></span></div>
          {%- endif -%}
          {# SECTOR rows: enrich from sector card via sectors_by_ticker #}
          {%- if _sc is not none -%}
          {%- if _sc.get('mom20') is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">20d mom</span><span class="l-zh">20日动能</span></span>
            <span class="row-pop-val"><span class="{{ 'up' if _sc.get('mom20') >= 0 else 'dn' }}">{{ '%+.1f'|format(_sc.get('mom20')) }}%</span></span></div>
          {%- endif -%}
          {%- if _sc.get('mom60') is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">60d mom</span><span class="l-zh">60日动能</span></span>
            <span class="row-pop-val"><span class="{{ 'up' if _sc.get('mom60') >= 0 else 'dn' }}">{{ '%+.1f'|format(_sc.get('mom60')) }}%</span></span></div>
          {%- endif -%}
          {%- if _sc.get('above200') is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Above 200d</span><span class="l-zh">高于200日均线</span></span>
            <span class="row-pop-val">{% if _sc.get('above200') %}<span class="up">▲</span> <span class="l-en">above 200d</span><span class="l-zh">高于均线</span>{% else %}<span class="mut">—</span> <span class="l-en">below 200d</span><span class="l-zh">低于均线</span>{% endif %}</span></div>
          {%- endif -%}
          {%- if _sc.get('pctile') is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">RS percentile</span><span class="l-zh">相对强度百分位</span></span>
            <span class="row-pop-val">{{ '%.0f'|format(_sc.get('pctile')) }}p</span></div>
          {%- endif -%}
          {%- if _sc.get('dc_day') is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">Cycle day · band</span><span class="l-zh">周期日数 · 区间</span></span>
            <span class="row-pop-val">{{ _sc.get('dc_day') }}{% if _sc.get('dc_band') is not none %} <span class="mut">· {{ _sc.get('dc_band') }}</span>{% endif %}</span></div>
          {%- endif -%}
          {%- set _sce = _sc.get('entry') or {} -%}
          {%- if _sce.get('text') is not none or _sce.get('text_zh') is not none -%}
          <div class="row-pop-cell wide"><span class="row-pop-lbl"><span class="l-en">Entry signal</span><span class="l-zh">入场信号</span></span>
            <span class="row-pop-val"><span class="l-en">{{ _sce.get('text') or '' }}</span><span class="l-zh">{{ _sce.get('text_zh') or _sce.get('text') or '' }}</span>{% if _sc.get('age_short') is not none %} <span class="mut">· <span class="l-en">{{ _sc.get('age_short') }}</span><span class="l-zh">{{ _sc.get('age_short_zh') or _sc.get('age_short') }}</span></span>{% endif %}</span></div>
          {%- endif -%}
          {%- if _sc.get('eq_badge') is not none -%}
          <div class="row-pop-cell"><span class="row-pop-lbl"><span class="l-en">EQ</span><span class="l-zh">入场质量</span></span>
            <span class="row-pop-val">{{ _sc.get('eq_badge') }}</span></div>
          {%- endif -%}
          {%- endif -%}{# /_sc enrichment #}
        </div>
        {%- if row.reasons -%}
        <ul class="row-pop-why">
          {%- for _r in row.reasons -%}<li><span class="l-en">{{ _r }}</span><span class="l-zh">{{ tr(_r) }}</span></li>{%- endfor -%}
        </ul>
        {%- endif -%}
        <div class="row-pop-ft">
          <span>{{ _anv2.as_of if _anv2.as_of else '' }}</span>
        </div>
      </span>
      <div class="anv2-row-top">
        {%- if row.href -%}
        <a class="anv2-name anv2-name-link" href="{{ row.href }}"><span class="l-en">{{ row.name }}</span><span class="l-zh">{{ row.name_zh or tr(row.name) }}</span><span class="anv2-go" aria-hidden="true">↗</span></a>
        {%- else -%}
        <span class="anv2-name"><span class="l-en">{{ row.name }}</span><span class="l-zh">{{ row.name_zh or tr(row.name) }}</span></span>
        {%- endif -%}
        {% if row.score is not none %}<span class="anv2-score{% if row.score >= 60 %} anv2-score-hi{% elif row.score >= 40 %} anv2-score-mid{% else %} anv2-score-lo{% endif %}">{{ row.score }}</span>{% endif %}
      </div>
      <div class="anv2-chips">
        {# type chips (THEME/SECTOR/BASKET) removed by operator request 2026-07-10 —
           row provenance lives in the board help() tooltip instead #}
        {# reco chip (theme rows) #}
        {% if row.reco_en %}<span class="anv2-chip anv2-chip-reco-{{ row.reco or 'hold' }}">{{ t(row.reco_en, row.reco_zh or tr(row.reco_en)) }}</span>{% endif %}
        {# sector urgency/tag chip #}
        {% if row.tag and row.kind != 'THEME' %}<span class="anv2-chip anv2-chip-tag">{{ t(row.tag, row.tag_zh or tr(row.tag)) }}</span>{% endif %}
        {# dual-read chip on reduce lane #}
        {% if lane == 'reduce' and row.dual_read %}
        <span class="anv2-chip anv2-chip-washout" data-tip-en="Mixed picture: the longer trend still says reduce, but the recent price action shows early signs of a bottom. This name also appears in Bottoming Watch — both reads are shown so you see the disagreement." data-tip-zh="信号矛盾：长期趋势仍建议减仓，但近期价格已初现筑底迹象。该名称同时出现在洗盘观察栏——两种判读并列显示，便于看清分歧。">{{ t(row.dual_chip_en, row.dual_chip_zh) }}</span>
        {% endif %}
        {# bottoming lane: trough+slope chip #}
        {% if lane == 'bot' and row.osc_slope is not none %}
        <span class="anv2-chip anv2-chip-trough" data-tip-en="At the low point of its cycle — the most beaten-down phase." data-tip-zh="处于周期低谷——最超跌的阶段。">{{ t('TROUGH','低谷') }}</span>
        <span class="anv2-chip anv2-chip-turn" data-tip-en="Momentum is turning up from the low — higher number = sharper turn. A first hint, not a buy signal." data-tip-zh="动能正从低位回升——数字越大转向越明显。仅是初步迹象，非买入信号。">↗ {{ '%.1f'|format(row.osc_slope) }}</span>
        {% endif %}
        {# price-tape chip (W8-R7 rider) — TURNING/CONFIRMED state from basket_turn_cn #}
        {% if row.organ_chip_en %}<span class="anv2-chip anv2-chip-tape">{{ t(row.organ_chip_en, row.organ_chip_zh or tr(row.organ_chip_en)) }}</span>{% endif %}
      </div>
      {# stat line: rel20 for themes, rs_63d+pos for bottoming #}
      {% if lane == 'bot' %}
      <div class="anv2-stat">
        {% if row.rs_63d is not none %}<span class="{% if row.rs_63d < 0 %}anv2-neg{% else %}anv2-pos{% endif %}">{{ '%+.1f'|format(row.rs_63d) }}%</span><span class="muted"> {{ t('63d RS','63日相对强度') }}</span>{% endif %}
        {% if row.pos is not none %} · <span class="muted">{{ t('pos','位置') }} {{ '%.0f'|format(row.pos) }}%</span>{% endif %}
      </div>
      {% elif row.rel20 is not none %}
      {# 20d + 5d side by side: the fast window exposes a rollover the slow 20d
         ruler still hides (2026-07-14 semis: 20d +22% while 5d already negative) #}
      <div class="anv2-stat">
        <span class="{% if row.rel20 < 0 %}anv2-neg{% else %}anv2-pos{% endif %}">{{ '%+.1f'|format(row.rel20 * 100) }}%</span><span class="muted"> {{ t('20d','20日') }}</span>
        {%- if row.rel5 is not none %} · <span class="{% if row.rel5 < 0 %}anv2-neg{% else %}anv2-pos{% endif %}">{{ '%+.1f'|format(row.rel5 * 100) }}%</span><span class="muted"> {{ t('5d','5日') }}</span>{% endif -%}
        <span class="muted"> {{ t('vs CSI 300','相对沪深300') }}</span>
      </div>
      {% endif %}
    </div>
    {%- endmacro -%}

    {# ── Lane macro ─────────────────────────────────────────────────────── #}
    {%- macro _anlane(lane_key, cls, title_en, title_zh, subtitle_en, subtitle_zh, items, lane_id) -%}
    <div class="anv2-lane anv2-lane--{{ cls }}" id="{{ lane_id }}">
      <div class="anv2-lane-hd">
        <div class="anv2-lane-title">
          <span class="l-en">{{ title_en }}</span><span class="l-zh">{{ title_zh }}</span>
          <span class="anv2-lane-count">({{ items|length }})</span>
        </div>
        {% if subtitle_en %}<div class="anv2-lane-sub"><span class="l-en">{{ subtitle_en }}</span><span class="l-zh">{{ subtitle_zh }}</span></div>{% endif %}
      </div>
      <div class="anv2-lane-body lst-wrap">
      <div class="anv2-lst lst-collapse lst-cap4 is-collapsed">
        {% for row in items %}{{ _anrow(row, lane_key) }}{% endfor %}
      </div>
      {% if items|length > 4 %}<button class="lst-more" type="button" aria-expanded="false"><span class="lm-show">{{ t('Show more','显示更多') }} ▾</span><span class="lm-hide">{{ t('Show less','收起') }} ▴</span></button>{% endif %}
      </div>
    </div>
    {%- endmacro -%}

    {{ _anlane('buy',  'buy',  'Buy Now',               '立即买入',
               'Clean entry point today', '今日有干净入场点',
               _anl.buy_now, 'anv2-buy') }}
    {{ _anlane('pull', 'pull', 'In Favour', '看好',
               'Still in favour — wait for a dip before adding', '仍看好 — 等回调再加仓',
               _anl.wait_pullback, 'anv2-pull') }}
    {{ _anlane('bot',  'bot',  'Bottoming Watch',        '洗盘观察',
               'Beaten down, first signs of turning up — watch only', '超跌初现回升迹象 — 仅观察',
               _anl.bottoming_watch, 'anv2-bot') }}
    {{ _anlane('reduce', 'red', 'Reduce / Avoid',        '减仓 / 回避',
               'Trend weakening — consider trimming', '趋势转弱 — 考虑减仓',
               _anl.reduce_avoid, 'anv2-red') }}

    </div>{# /.anv2-grid #}
  </div>{# /.anv2-board #}
  {% endif %}
  {% endif %}

  {% if mode != 'stocks' %}
  <!-- ===================== MX5 CHINA GLANCE REDESIGN — macro mode ===================== -->
  {# hero locals #}
  {% set ms = market_state %}
  {% set _ms_color = (ms.color if ms else 'yellow') %}
  {% set _ms_score = (ms.score if ms else 50) %}
  {% set _ms_verdict = (ms.verdict if ms else 'MIXED') %}
  {% set _ms_label = (ms.label_en if ms else 'Mixed') %}
  {% set _ms_label_zh = (ms.label_zh if ms else '混合') %}
  {% set _ms_posture = (ms.posture_en if ms else 'Trade with caution') %}
  {% set _ms_posture_zh = (ms.posture_zh if ms else '谨慎交易') %}
  {% set _ms_thesis = (ms.headline_en if ms else '') %}
  {% set _ms_thesis_zh = (ms.headline_zh if ms else '') %}
  {% set _ms_flip = (ms.flip_en if ms else '') %}
  {% set _ms_flip_zh = (ms.flip_zh if ms else '') %}
  {% set _comps = (ms.components if ms else []) %}
  {% set _rr = (ms.radar if ms else {}) %}
  {% set I = internals or {} %}
  {% set P = property %}
  {% set pb_obj = pb %}
  {% set CN = china_news %}

  <div class="cnx-wrap">

  <!-- =============== HERO =============== -->
  <div class="cnx-card cnx-hero{{ ' cnx-hero-solo' if not (ms_history and ms_history|length >= 2) else '' }} ms-front ms ms-{{ _ms_color }}" style="padding:0">
    <div class="cnx-hero-left">
      <span class="cnx-regime-pill"><span class="dot"></span>
        {{ td(latest.quad_name) }}<span style="opacity:.55"> · {{ td(latest.cycle_tag or 'mid') }}</span></span>
      <span id="ms-live-pill" class="cnx-live-pill"><span class="d"></span>
        <span class="l-en">LIVE</span><span class="l-zh">实时</span>
        <span id="ms-date" style="margin-left:4px">{{ latest.date }}</span></span>
      {# ── A · US mx5 semicircle gauge (ported from dashboard.html.j2 6556–6631) ──
         Geometry: arc M14,75 A56 → π·56≈175.93 arc-len; needle+numeral rotate around
         (70,75). data-gauge-* attrs let china_risk_state_live.js patch geometry without
         hardcoding it. Arc / needle / numeral colour comes from the .ms-{color} wrapper via
         .cnx-gauge-fill / .cnx-needle-* / #mx5-score-numeral — DIRECTION reads that FLIP in zh
         (risk-off → green, operator ruling 2026-07-21), same as the tiles/path/pullback family. #}
      {% set _mx5_arc_len = 175.93 %}
      {% set _mx5_filled = (_ms_score / 100 * _mx5_arc_len) | round(1) %}
      {% set _mx5_gap = (_mx5_arc_len - _mx5_filled) | round(1) %}
      {% set _mx5_needle_deg = (_ms_score / 100 * 180 - 90) | round(1) %}
      {% set _mx5_sc_cls = 'mx5-score-green' if _ms_color == 'green' else ('mx5-score-yellow' if _ms_color == 'yellow' else 'mx5-score-red') %}
      <div class="mx5-sc-gauge-row {{ _mx5_sc_cls }}">
        <svg class="mx5-gauge-svg" viewBox="0 -4 140 101" fill="none"
             aria-label="{{ _ms_label }} — {{ _ms_score }}"
             data-gauge-arc-len="{{ _mx5_arc_len }}"
             data-gauge-radius="56" data-gauge-cx="70" data-gauge-cy="75">
          <defs>
            <filter id="cnxNeedleGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="2.5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="cnxArcGlow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>
          {# Track #}
          <path d="M 14 75 A 56 56 0 0 1 126 75" stroke="rgba(255,255,255,.08)" stroke-width="10" stroke-linecap="round" fill="none"/>
          {# Filled arc — dasharray baked by Jinja; CSS recolours via #mx5-gauge-arc-fill;
             live JS patches dasharray via data-gauge-arc-len #}
          <path id="mx5-gauge-arc-fill" class="cnx-gauge-fill"
                d="M 14 75 A 56 56 0 0 1 126 75" stroke-width="10" stroke-linecap="round" fill="none"
                stroke-dasharray="{{ _mx5_filled }} {{ _mx5_gap }}" filter="url(#cnxArcGlow)"/>
          {# Tick marks at 0/25/50/75/100 #}
          <g stroke="rgba(255,255,255,.22)" stroke-width="1.2">
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-90 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(-45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(0 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(45 70 75)"/>
            <line x1="70" y1="19" x2="70" y2="26" transform="rotate(90 70 75)"/>
          </g>
          <text x="14"  y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">0</text>
          <text x="70"  y="10" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">50</text>
          <text x="126" y="95" fill="rgba(255,255,255,.26)" font-size="11" text-anchor="middle" font-family="Inter,-apple-system,sans-serif">100</text>
          {# Needle — rotation baked by Jinja; live JS patches via data attrs. Core/tip/
             numeral fills are CSS-driven (.cnx-needle-core/tip, #mx5-score-numeral) so they
             follow --mx5-gauge and flip in zh; the white stem stays neutral. #}
          <g class="cnx-gauge-needle" id="mx5-gauge-needle" transform="rotate({{ _mx5_needle_deg }} 70 75)" filter="url(#cnxNeedleGlow)">
            <line x1="70" y1="75" x2="70" y2="24" stroke="rgba(255,255,255,.30)" stroke-width="5" stroke-linecap="round"/>
            <polygon points="69,75 71,75 70.5,24 69.5,24" fill="white" opacity=".94"/>
            <circle cx="70" cy="75" r="7"  fill="rgba(255,255,255,.10)"/>
            <circle class="cnx-needle-ring" cx="70" cy="75" r="4.5" stroke-width="1.5" fill="rgba(8,12,18,.8)"/>
            <circle class="cnx-needle-core" cx="70" cy="75" r="2"/>
            <circle class="cnx-needle-tip" cx="70" cy="25.5" r="2.5"/>
          </g>
          {# Score numeral inside arc #}
          <text id="mx5-score-numeral" x="70" y="62" font-size="24" font-weight="800"
                text-anchor="middle" font-family="Inter,-apple-system,sans-serif">{{ _ms_score }}</text>
          <text x="70" y="73" fill="rgba(255,255,255,.32)" font-size="11"
                text-anchor="middle" font-family="Inter,-apple-system,sans-serif">/ 100</text>
        </svg>
        {# Right of gauge: big score + verdict word. Colour comes from the .ms-{green|yellow|red}
           wrapper via .cnx-big-score/.cnx-verdict/.cnx-sub-line rules (--up/--down), so these
           DIRECTION reads flip in zh (risk-off → green), matching the gauge, tiles and path. #}
        <div>
          <div class="cnx-score-line"><span id="ms-score" class="cnx-big-score">{{ _ms_score }}</span><span id="ms-word" class="cnx-verdict">{{ t(_ms_label, _ms_label_zh) }} <span class="arr">▶</span></span></div>
          <div class="cnx-sub-line">
            {# zh names the TIER (偏多/中性/避险), never the colour word — the paint flips 红涨绿跌
               in zh (risk-off→green), so a literal 红/绿 would contradict it. Matches macro.html. #}
            <span class="cnx-sub-g"><span class="l-en">GREEN — TREND-FOLLOWING SUPPORTED</span><span class="l-zh">偏多 — 支持趋势跟随</span></span>
            <span class="cnx-sub-y"><span class="l-en">YELLOW — TRADE WITH CAUTION</span><span class="l-zh">中性 — 谨慎交易</span></span>
            <span class="cnx-sub-r"><span class="l-en">RED — DEFEND CAPITAL</span><span class="l-zh">避险 — 优先保住本金</span></span>
          </div>
        </div>
      </div>
      <p class="v-thesis cnx-thesis">{{ t(_ms_thesis or 'China A-share market state.', _ms_thesis_zh or '中国A股市场状态。') }}</p>
      <div class="v-flip cnx-flip">{{ t(_ms_flip or '—', _ms_flip_zh or '—') }}</div>
      <div class="cnx-hero-btns">
        {# signals button #}
        {% set _n_bull = (_comps | selectattr('tone', 'equalto', 'pos') | list | length) %}
        {% set _n_total = (_comps | length) %}
        <button class="cnx-hbtn" onclick="cnxTogglePop('cnx-pop-signals',event)">⌁
          <span class="l-en">{{ _n_bull }} of {{ _n_total }} signals aligned</span><span class="l-zh">{{ _n_total }} 项中 {{ _n_bull }} 项一致</span>
          <span class="n">▾</span></button>
        {# risk button #}
        {% set _rr_score = (_rr.get('top_score') if (_rr and _rr.get('top_score') is not none and _rr.get('top_score') != '') else none) %}
        {% set _rr_p21 = _rr.get('dd21') if _rr else none %}
        {% set _rr_lift = _rr.get('dd_lift') if _rr else none %}
        {% set _rr_do_en = (_rr.get('do_en') or '') if _rr else '' %}
        {% set _rr_do_zh = (_rr.get('do_zh') or '') if _rr else '' %}
        {% set _rr_sub_en = ('~%d%% chance of a ≥5%% pullback within a month'|format((_rr_p21*100)|round|int) ~ (' · %.1f× the usual odds'|format(_rr_lift) if _rr_lift else '')) if _rr_p21 is not none else (_rr_do_en or ms.posture_en or '') %}
        {% set _rr_sub_zh = ('未来一个月内出现≥5%%回撤的概率约%d%%'|format((_rr_p21*100)|round|int) ~ (' · 约为平时的%.1f倍'|format(_rr_lift) if _rr_lift else '')) if _rr_p21 is not none else (_rr_do_zh or ms.posture_zh or '') %}
        <button class="cnx-hbtn" onclick="cnxTogglePop('cnx-pop-risk',event)" style="border-color:color-mix(in srgb,var(--down) 50%,transparent)">⚠
          <span class="l-en">Pullback risk</span><span class="l-zh">回撤风险</span>{% if _rr_score is not none %} · <span class="n" style="color:var(--down)">{{ _rr_score }}</span>{% endif %} ▾</button>

        <!-- popover: factor breakdown -->
        <div class="cnx-pop" id="cnx-pop-signals">
          <div class="cnx-pop-h">{{ t('Factor breakdown', '因子分解') }} — {{ _n_total }} {{ t('signals', '信号') }}</div>
          {% for c in _comps %}
          <div class="cnx-pop-row">
            <div class="pr-t">
              <span {% if c.tone == 'neg' %}style="color:var(--down)"{% elif c.tone == 'pos' %}style="color:var(--up)"{% endif %}>{{ t(c.label_en, c.label_zh) }}</span>
              <b {% if c.tone == 'neg' %}style="color:var(--down)"{% elif c.tone == 'pos' %}style="color:var(--up)"{% endif %}>{{ c.score }}</b>
            </div>
            <div class="cnx-pop-bar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'pos' else ('var(--down)' if c.tone == 'neg' else 'var(--warn)') }}"></i></div>
          </div>
          {% endfor %}
          <span class="cnx-pop-link" onclick="cnxClosePops();cnxOpenDlg('cnx-dlg-read')">{{ t('Full breakdown ↓', '完整分解 ↓') }}</span>
        </div>

        <!-- popover: risk radar -->
        <div class="cnx-pop" id="cnx-pop-risk" style="left:auto">
          <div class="cnx-pop-h">{{ t('Pullback risk radar', '回撤风险雷达') }}</div>
          {% if _rr_score is not none %}
          <div class="cnx-pop-big"><span class="n">{{ _rr_score }}</span><span class="t">{{ t(_rr.label_en or '', _rr.label_zh or '') }}</span></div>
          <div class="cnx-pop-sub">{{ t(_rr_sub_en, _rr_sub_zh) }}</div>
          {% for leg in (_rr.scares or [])[:3] %}
          <div class="cnx-pop-row">
            <div class="pr-t"><span>{{ t(leg.label_en or leg.scare, leg.label_zh or leg.scare or '') }}</span><b>{{ leg.score|round|int }}</b></div>
            <div class="cnx-pop-bar"><i style="width:{{ leg.score|round|int }}%;background:var(--down)"></i></div>
          </div>
          {% endfor %}
          {% else %}
          <div class="cnx-pop-sub">{{ t('No radar data available.', '暂无雷达数据。') }}</div>
          {% endif %}
          <span class="cnx-pop-link" onclick="cnxClosePops();cnxOpenDlg('cnx-dlg-risk')">{{ t('Full risk detail ↓', '完整风险详情 ↓') }}</span>
        </div>
      </div>
    </div>
    {# ── B · US mx5 session-path graph (ported from dashboard.html.j2 6964–7106).
       China's ms_history rows carry {date, score, verdict, color}; the US block keyed on
       row.asof, so every .asof below is mapped to .date. Verdict bands: risk-off <42, mixed
       42–60, risk-on ≥60 (same thresholds). Zone tints + line paint from the --up/--warn/--down
       triad so they flip in zh (risk-off → green), matching the gauge above and macro.html.
       Honest "<2 rows" placeholder kept. #}
    {% set _mx5_hist = ms_history if (ms_history and ms_history | length >= 2) else none %}
    {% set _mx5_hist_n = _mx5_hist | length if _mx5_hist else 0 %}
    {# zh 红涨绿跌: the regime score is a DIRECTION read (risk-on=bullish) — paint from --up/--down
       so it flips in zh (operator ruling 2026-07-21), matching macro.html + HK/Canada. #}
    {% set _path_col = 'var(--up)' if _ms_color == 'green' else ('var(--down)' if _ms_color == 'red' else 'var(--warn)') %}
    <div class="cnx-hero-right mx5-sc-right">
      <div class="mx5-path-header">
        <span class="mx5-path-title">
          <span class="l-en">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}{{ _mx5_hist_n }}-session path{% else %}60-session path{% endif %}</span>
          <span class="l-zh">{% if _mx5_hist_n > 0 and _mx5_hist_n < 60 %}近 {{ _mx5_hist_n }} 交易日走势{% else %}60 交易日走势{% endif %}</span>
        </span>
        <span class="mx5-path-meta"><span class="l-en">Score vs time</span><span class="l-zh">综合评分 · 时序</span></span>
      </div>
      {% if _mx5_hist %}
      {% set _ph_n = _mx5_hist | length %}
      {% set PX0 = 44 %}{% set PXW = 944 %}{% set PY0 = 10 %}{% set PYB = 194 %}
      {% set _mx5_mos_en = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] %}
      {% set _ph_yfor = PYB - PY0 %}
      {% set _y100 = PY0 %}
      {% set _y75  = (PY0 + 25.0/100 * _ph_yfor) | round(2) %}
      {% set _y60  = (PY0 + 40.0/100 * _ph_yfor) | round(2) %}
      {% set _y50  = (PY0 + 50.0/100 * _ph_yfor) | round(2) %}
      {% set _y42  = (PY0 + 58.0/100 * _ph_yfor) | round(2) %}
      {% set _y25  = (PY0 + 75.0/100 * _ph_yfor) | round(2) %}
      {% set _y0   = PYB %}
      {% set _ph_pts_line = [] %}
      {% set _ph_json = [] %}
      {% for row in _mx5_hist %}
        {% set _ph_x = (PX0 + (loop.index0 / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
        {% set _row_s = row.score if (row.score is defined and row.score is not none) else 50 %}
        {% set _ph_y = (PY0 + (100 - _row_s) / 100 * _ph_yfor) | round(2) %}
        {% set _rv = 'Risk-on' if _row_s >= 60 else ('Mixed' if _row_s >= 42 else 'Risk-off') %}
        {% set _rvz = '偏多' if _row_s >= 60 else ('中性' if _row_s >= 42 else '偏空') %}
        {% if _ph_pts_line.append(_ph_x ~ ',' ~ _ph_y) %}{% endif %}
        {% if _ph_json.append({'d': row.date, 'md': (_mx5_mos_en[row.date[5:7]|int] ~ ' ' ~ (row.date[8:10]|int)) if (row.date and row.date|length >= 10) else '', 'mz': ((row.date[5:7]|int)|string ~ '月' ~ (row.date[8:10]|int)|string) if (row.date and row.date|length >= 10) else '', 's': row.score, 'v': _rv, 'vz': _rvz, 'x': _ph_x, 'y': _ph_y}) %}{% endif %}
      {% endfor %}
      {% set _ph_nticks = [_ph_n, 5] | min %}
      {% set _ph_tick_idx = [] %}
      {% if _ph_n <= 6 %}
        {% for i in range(_ph_n) %}{% if _ph_tick_idx.append(i) %}{% endif %}{% endfor %}
      {% else %}
        {% for k in range(_ph_nticks + 1) %}{% if _ph_tick_idx.append((k / _ph_nticks * (_ph_n - 1)) | round | int) %}{% endif %}{% endfor %}
      {% endif %}
      <div class="mx5-path-plot">
      <svg class="mx5-path-svg" viewBox="0 0 1000 224" preserveAspectRatio="none"
           data-points='{{ _ph_json | tojson }}'
           data-px0="{{ PX0 }}" data-pxw="{{ PXW }}" data-py0="{{ PY0 }}" data-pyb="{{ PYB }}"
           data-vbw="1000" data-vbh="224"
           role="img" aria-label="{{ _mx5_hist_n }}-session China market score path">
        <defs>
          <linearGradient id="cnxPathAreaGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="{{ _path_col }}" stop-opacity=".40"/>
            <stop offset="62%"  stop-color="{{ _path_col }}" stop-opacity=".07"/>
            <stop offset="100%" stop-color="{{ _path_col }}" stop-opacity="0"/>
          </linearGradient>
        </defs>
        {# Verdict-band tinted zones — routed through --up/--warn/--down so they flip in zh #}
        <rect x="0" y="{{ _y100 }}" width="1000" height="{{ (_y60 - _y100) | round(2) }}" fill="color-mix(in srgb, var(--up) 5%, transparent)"/>
        <rect x="0" y="{{ _y60 }}"  width="1000" height="{{ (_y42 - _y60) | round(2) }}" fill="color-mix(in srgb, var(--warn) 5%, transparent)"/>
        <rect x="0" y="{{ _y42 }}"  width="1000" height="{{ (_y0 - _y42) | round(2) }}" fill="color-mix(in srgb, var(--down) 5%, transparent)"/>
        <line x1="0" y1="{{ _y60 }}" x2="1000" y2="{{ _y60 }}" stroke="color-mix(in srgb, var(--up) 22%, transparent)" stroke-width="1" stroke-dasharray="2,5"/>
        <line x1="0" y1="{{ _y42 }}" x2="1000" y2="{{ _y42 }}" stroke="color-mix(in srgb, var(--down) 20%, transparent)" stroke-width="1" stroke-dasharray="2,5"/>
        {# Y gridlines at 0/25/50/75/100 #}
        <g stroke="rgba(255,255,255,.06)" stroke-width="1">
          <line x1="{{ PX0 }}" y1="{{ _y100 }}" x2="988" y2="{{ _y100 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y75 }}"  x2="988" y2="{{ _y75 }}"/>
          <line x1="{{ PX0 }}" y1="{{ _y50 }}"  x2="988" y2="{{ _y50 }}" stroke-dasharray="4,5"/>
          <line x1="{{ PX0 }}" y1="{{ _y25 }}"  x2="988" y2="{{ _y25 }}"/>
        </g>
        {# Area fill + line #}
        <path d="M{{ _ph_pts_line | join(' L') }} L{{ (PX0 + PXW) | round(2) }},{{ PYB }} L{{ PX0 }},{{ PYB }} Z" fill="url(#cnxPathAreaGrad)" stroke="none"/>
        <polyline points="{{ _ph_pts_line | join(' ') }}" fill="none" stroke="{{ _path_col }}" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" opacity=".92"/>
        <line x1="{{ PX0 }}" y1="{{ PYB }}" x2="988" y2="{{ PYB }}" stroke="rgba(255,255,255,.16)" stroke-width="1"/>
        <g>
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          <line x1="{{ _tx }}" y1="{{ PYB }}" x2="{{ _tx }}" y2="{{ (PYB + 4) | round(1) }}" stroke="rgba(255,255,255,.20)" stroke-width="1"/>
        {% endfor %}
        </g>
        {% set _ph_last_x = (PX0 + PXW) | round(2) %}
        {% set _ph_last_y = (PY0 + (100 - _mx5_hist[-1].score) / 100 * _ph_yfor) | round(2) %}
      </svg>
      {# Axis labels + today marker: screen-space HTML overlay (SVG uses non-uniform stretch) #}
      <div class="mx5-path-labels" aria-hidden="true">
        <span class="mx5-pl-y" style="top:{{ (_y100 / 224 * 100) | round(2) }}%">100</span>
        <span class="mx5-pl-y" style="top:{{ (_y75  / 224 * 100) | round(2) }}%">75</span>
        <span class="mx5-pl-y" style="top:{{ (_y50  / 224 * 100) | round(2) }}%">50</span>
        <span class="mx5-pl-y" style="top:{{ (_y25  / 224 * 100) | round(2) }}%">25</span>
        <span class="mx5-pl-y" style="top:{{ (_y0   / 224 * 100) | round(2) }}%">0</span>
        <span class="mx5-pl-zone on"  style="top:{{ ((_y100 + 13) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-on</span><span class="l-zh">偏多</span></span>
        <span class="mx5-pl-zone mid" style="top:{{ (((_y60 + _y42) / 2) / 224 * 100) | round(2) }}%"><span class="l-en">Mixed</span><span class="l-zh">中性</span></span>
        <span class="mx5-pl-zone off" style="top:{{ ((_y0 - 7) / 224 * 100) | round(2) }}%"><span class="l-en">Risk-off</span><span class="l-zh">偏空</span></span>
        {% for _ti in _ph_tick_idx %}
          {% set _tx = (PX0 + (_ti / (_ph_n - 1) * PXW if _ph_n > 1 else PXW / 2)) | round(2) %}
          {% set _txf = 'translate(0,-50%)' if loop.first else ('translate(-100%,-50%)' if loop.last else 'translate(-50%,-50%)') %}
          {% set _tdate = _mx5_hist[_ti].date %}
          {% if _tdate and _tdate|length >= 10 %}
          <span class="mx5-pl-x" style="left:{{ (_tx / 1000 * 100) | round(3) }}%;transform:{{ _txf }}"><span class="l-en">{{ _mx5_mos_en[_tdate[5:7]|int] }} {{ _tdate[8:10]|int }}</span><span class="l-zh">{{ _tdate[5:7]|int }}月{{ _tdate[8:10]|int }}</span></span>
          {% endif %}
        {% endfor %}
        <span class="mx5-pl-today" style="left:{{ (_ph_last_x / 1000 * 100) | round(3) }}%;top:{{ (_ph_last_y / 224 * 100) | round(3) }}%;color:{{ _path_col }}"></span>
      </div>
      <div class="mx5-path-cross" aria-hidden="true"></div>
      <div class="mx5-path-dot" aria-hidden="true"></div>
      <div class="mx5-path-tip" role="status" aria-live="off">
        <span class="mx5-path-tip-date"></span>
        <span class="mx5-path-tip-row"><b class="mx5-path-tip-score"></b><span class="mx5-path-tip-verdict"></span></span>
      </div>
      </div>{# /mx5-path-plot #}
      {% else %}
      {# Honest placeholder when ms_history absent or <2 points #}
      <div style="flex:1;display:flex;align-items:center;justify-content:center;">
        <span style="font-size:12px;color:var(--muted)">{{ t('Building score history…','评分历史积累中…') }}</span>
      </div>
      {% endif %}
    </div>
  </div>
  {# /hero #}

  <!-- =============== MARKET TILES (C · US mx5 combined index face: SSE / CSI300 / ChiNext / HSI) =============== -->
  <div class="cnx-secbar"><b>{{ t('CHINA DASHBOARD','中国看板') }}</b><span>{{ latest.date }}</span></div>
  {# ── C · One glass face → markets dialog (ported from dashboard.html.j2 9959–10042).
     Preserves China's four indexes + their live data-sym/data-mkt hooks (SSE + HSI patch
     via live.js; CSI/ChiNext read the nightly market_tiles level). tone (pos/neg) → up/dn
     drives the delta colour, which routes through --up/--down so it flips in zh. No idx_spark
     on the China VM, so sparklines are omitted (the same honest guard as the US block). #}
  {% set _tile_by_sym = {} %}
  {% for _mt in (market_tiles or []) %}{% set _ = _tile_by_sym.update({_mt.sym: _mt}) %}{% endfor %}
  {% set _sse = _tile_by_sym.get('000001.SS') %}
  {% set _csi = _tile_by_sym.get('510300.SS') %}
  {% set _cnx_tile = _tile_by_sym.get('159915.SZ') %}
  {% set _tone_dir = {'pos':'up','neg':'dn'} %}
  <div class="cnx-tiles">
    <div class="sxg-face mx5-card-face" role="button" tabindex="0" aria-haspopup="dialog"
         aria-label="China and Hong Kong indexes" onclick="cnxOpenDlg('cnx-dlg-markets')"
         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();cnxOpenDlg('cnx-dlg-markets');}">
      <div class="mx5-mkt-grid">
        {# Shanghai Composite (live) #}
        {% set _d = _tone_dir.get(_sse.tone, '') if _sse else '' %}
        <div class="mx5-mkt-tile {{ _d }}" data-sym="000001.SS" data-mkt="cn">
          <div class="mx5-mkt-ticker">SSE</div>
          <div class="mx5-mkt-sub"><span class="l-en">Shanghai</span><span class="l-zh">上证综指</span></div>
          {% if _sse %}
          <div class="mx5-mkt-price nb-px" data-sym="000001.SS" data-mkt="cn" data-bare>{{ _sse.level }}</div>
          <div class="mx5-mkt-delta {{ _d }}">{{ _sse.pct }}</div>
          {% else %}<div class="mx5-mkt-price">—</div><div class="mx5-mkt-delta">—</div>{% endif %}
        </div>
        {# CSI 300 ETF #}
        {% set _d = _tone_dir.get(_csi.tone, '') if _csi else '' %}
        <div class="mx5-mkt-tile {{ _d }}">
          <div class="mx5-mkt-ticker">CSI 300</div>
          <div class="mx5-mkt-sub"><span class="l-en">Large cap</span><span class="l-zh">沪深300</span></div>
          {% if _csi %}
          <div class="mx5-mkt-price">{{ _csi.level }}</div>
          <div class="mx5-mkt-delta {{ _d }}">{{ _csi.pct }}</div>
          {% else %}<div class="mx5-mkt-price">—</div><div class="mx5-mkt-delta">—</div>{% endif %}
        </div>
        {# ChiNext ETF #}
        {% set _d = _tone_dir.get(_cnx_tile.tone, '') if _cnx_tile else '' %}
        <div class="mx5-mkt-tile {{ _d }}">
          <div class="mx5-mkt-ticker">ChiNext</div>
          <div class="mx5-mkt-sub"><span class="l-en">Growth</span><span class="l-zh">创业板</span></div>
          {% if _cnx_tile %}
          <div class="mx5-mkt-price">{{ _cnx_tile.level }}</div>
          <div class="mx5-mkt-delta {{ _d }}">{{ _cnx_tile.pct }}</div>
          {% else %}<div class="mx5-mkt-price">—</div><div class="mx5-mkt-delta">—</div>{% endif %}
        </div>
        {# Hang Seng (live) #}
        {% set _d = _tone_dir.get(hsi_tile.tone, '') if hsi_tile else '' %}
        <div class="mx5-mkt-tile {{ _d }}" data-sym="^HSI" data-mkt="hk">
          <div class="mx5-mkt-ticker">HSI</div>
          <div class="mx5-mkt-sub"><span class="l-en">Hang Seng</span><span class="l-zh">恒生</span></div>
          {% if hsi_tile %}
          <div class="mx5-mkt-price nb-px" data-sym="^HSI" data-mkt="hk" data-bare>{{ hsi_tile.level }}</div>
          <div class="mx5-mkt-delta {{ _d }}">{{ hsi_tile.pct }}</div>
          {% else %}<div class="mx5-mkt-price">—</div><div class="mx5-mkt-delta">—</div>{% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- =============== ROW 1: What To Do + Upcoming Events =============== -->
  <div class="cnx-rack2">
    {# What To Do card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-playbook')">
      <div class="cnx-ctitle">{{ t('What To Do','该怎么做') }}</div>
      {% if pb_obj %}
        {% set _pd = pb_obj.dial %}
        <div class="cnx-row"><span class="ic">{{ {'DEFENSIVE':'🛡','CAREFUL':'⚠','NEUTRAL':'◐','CONSTRUCTIVE':'✅','AGGRESSIVE':'🚀'}.get(_pd.posture,'◐') }}</span>
          <div class="tx"><b>{{ t(_pd.posture, {'DEFENSIVE':'防御','CAREFUL':'谨慎','NEUTRAL':'中性','CONSTRUCTIVE':'积极','AGGRESSIVE':'进取'}.get(_pd.posture,'')) }}</b></div></div>
        {% for sign, r_en, r_zh in (_pd.reasons[:4] if _pd.reasons else []) %}
        <div class="cnx-row"><span class="ic">{{ '+' if sign == '+' else ('−' if sign == '-' else 'ℹ') }}</span>
          <div class="tx"><span class="sub">{{ t(r_en, r_zh) }}</span></div></div>
        {% endfor %}
        {% if imminent %}<div class="cnx-row"><span class="ic">📅</span><div class="tx"><b><span class="l-en">{{ imminent.en }}</span><span class="l-zh">{{ imminent.zh }}</span></b><span class="sub">{{ t('Highest-impact print soon','近期最重要数据') }}</span></div></div>{% endif %}
      {% else %}
      <div class="cnx-row"><span class="ic">◐</span><div class="tx"><b>{{ t('Regime data loading…','周期数据加载中…') }}</b></div></div>
      {% endif %}
    </div>
    {# Upcoming Events card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-events')">
      <div class="cnx-ctitle">{{ t('Upcoming Events','近期数据') }} <span style="margin-left:auto;font-size:10px;color:var(--muted)">{{ t('NEXT 14 DAYS','未来14天') }}</span></div>
      {% set _high_ev = [] %}
      {% for c in (calendar or []) %}{% if c.importance == 'high' %}{% set _ = _high_ev.append(c) %}{% endif %}{% endfor %}
      {% if _high_ev %}<div style="font-size:11.5px;color:var(--muted)">{{ _high_ev | length }} {{ t('high-impact print ahead','项高影响数据待发') }}</div>{% endif %}
      <div class="cnx-estrip">
        {% for c in (event_strip or [])[:4] %}
        <div class="cnx-ev">
          <div class="edot {{ 'h' if c.importance == 'high' else 'm' }}"></div>
          <div class="en">{{ t((c.name_en or '')|truncate(18, true, '…'), (c.name_zh or '')|truncate(18, true, '…')) }}</div>
          <div class="ed">{{ c.date }}</div>
          <span class="cnx-imp {{ c.importance }}">{{ c.importance | upper }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- =============== ROW 2: Pullback Risk / Top Stocks + Sentiment + Sector Temperature =============== -->
  <div class="cnx-rack3">
    {# Pullback Risk vs Top Stocks conditional #}
    {% set _risk_state = (latest.risk_radar.state if latest.risk_radar else 'calm') %}
    {% set _show_risk = _risk_state in ('caution', 'elevated', 'risk-off') %}
    {% if _show_risk %}
    {# Pullback Risk card. NOTE: china INTENTIONALLY hand-rolls its pullback surfaces
       (this card + hero popover + cnx-dlg-risk) in the bespoke cnx-* design rather than
       the shared .rrx card (_risk_radar_card.html.j2, used by macro / HK / Canada): this
       card sits in a cnx-rack beside the Sentiment/Sector cards, and the dialog carries
       CN-only gauges (deep-drawdown, slowdown, FX context) the .rrx card doesn't have.
       COLOURS (operator ruling 2026-07-21, reverses #2947's no-flip): the pullback family
       is a market-direction read — paint danger from the zh-flipping var(--down) (via
       color-mix for washes) exactly like theme.css's `html[data-lang="zh"] .rrx` remap on
       the sibling boards, so risk-off reads green in zh (Asia convention). --warn neutral.
       Severity tier drives the pill/number colour (was hardcoded HIGH/red for caution,
       elevated AND risk-off alike): caution → amber CAUTION, elevated/risk-off → red. #}
    {% set _rr_sev_col  = 'var(--warn)' if _risk_state == 'caution' else 'var(--down)' %}
    {% set _rr_sev_bg   = 'rgba(224,160,48,.16)' if _risk_state == 'caution' else 'color-mix(in srgb,var(--down) 16%,transparent)' %}
    {% set _rr_sev_bord = 'rgba(224,160,48,.35)' if _risk_state == 'caution' else 'color-mix(in srgb,var(--down) 35%,transparent)' %}
    {% set _rr_sev_en   = 'HIGH' if _risk_state == 'risk-off' else ('ELEVATED' if _risk_state == 'elevated' else 'CAUTION') %}
    {% set _rr_sev_zh   = '高' if _risk_state == 'risk-off' else ('偏高' if _risk_state == 'elevated' else '谨慎') %}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-risk')" style="border-color:{{ _rr_sev_bord }}">
      <div class="cnx-ctitle">{{ t('Pullback Risk','回撤风险') }} <span class="cnx-alert-pill" style="background:{{ _rr_sev_bg }};color:{{ _rr_sev_col }}">{{ t(_rr_sev_en, _rr_sev_zh) }}</span></div>
      {% if _rr_score is not none %}
      <div class="cnx-bignum" style="color:{{ _rr_sev_col }}">{{ _rr_score }}<span style="font-size:14px;color:var(--muted)"> /100</span></div>
      <div class="cnx-bigsub" style="color:{{ _rr_sev_col }}">{{ t(_rr.label_en or '', _rr.label_zh or '') }}</div>
      {% endif %}
      <div class="cnx-kv"><span class="k">{{ t('≥5% dip odds','≥5%回撤概率') }}</span><span class="v">{% if _rr_p21 is not none %}{{ (_rr_p21*100)|round|int }}%{% else %}{{ t('—','—') }}{% endif %}</span></div>
      <div class="cnx-kv"><span class="k">{{ t('Deep-drawdown gauge','深跌仪表') }}</span>
        {# SAME recession score + 60/40 bands as the detail dialog (was label-based, which
           could disagree with the dialog's score-based colour); direction pair per the
           2026-07-21 ruling so the whole pullback family flips together in zh. #}
        {% set _rr_rec_sc = (latest.conditions.recession.score if latest.conditions and latest.conditions.get('recession') and latest.conditions.recession else none) %}
        <span class="v"><span style="font-weight:700;color:{{ 'var(--down)' if (_rr_rec_sc or 0) >= 60 else ('var(--warn)' if (_rr_rec_sc or 0) >= 40 else 'var(--up)') }}">{{ t('High','高危') if (_rr_rec_sc or 0) >= 60 else (t('Elevated','偏高') if (_rr_rec_sc or 0) >= 40 else t('Calm','平静')) }}</span></span></div>
      <div class="cnx-foot">{{ t(_rr_do_en or 'High pullback risk — size down, watch alerts.', _rr_do_zh or '回撤风险高 — 缩仓，关注警报。') }}</div>
    </div>
    {% else %}
    {# Top Stocks card — when radar is quiet #}
    <div class="cnx-card">
      <div class="cnx-ctitle">{{ t('Top Stock Setups','精选买点') }} <span style="margin-left:auto;font-size:10px;color:var(--muted)">{{ t('FROM THE STOCK BOARD','来自股票看板') }}</span></div>
      {% for s in (top_setups or []) %}
      <div class="cnx-stk">
        <span class="tkr"><a class="cnx-tkr-btn" href="https://app.mastermind-x.com/terminal?symbol={{ s.ticker }}" target="_blank" rel="noopener">{{ s.name_zh or s.name }}</a></span>
        <div class="meta"><b>{{ s.ticker }}</b> · {{ s.industry or s.sector or '' }}</div>
        <span class="cnx-stage">{{ t(s.stage or 'ENTRY', s.stage or 'ENTRY') }}</span>
      </div>
      {% else %}
      <div style="font-size:12px;color:var(--muted);padding:8px 0">{{ t('No active setups right now.','暂无有效买点。') }}</div>
      {% endfor %}
      <a class="cnx-screener-btn" href="china_stocks.html">{{ t('Stock Screener →','选股看板 →') }}</a>
    </div>
    {% endif %}

    {# ── D · Market Sentiment odometer (ported from dashboard.html.j2 9808–9884) —
       replaces the crude washed-out cnx-dial (the "torching" bug). Dial = fear_euphoria.score
       (0–100), falling back to the turnover-heat percentile — the SAME series the fallback
       band word comes from, so the needle can never contradict the word. Zone class
       (fg-greed/fg-fear/fg-neutral) drives --fg-col → --up/--warn/--down so the needle + zone
       text flip in zh (Euphoria=bullish→red, Panic=bearish→green). #}
    {% set _fe = latest.fear_euphoria %}
    {% set _fe_score = (_fe.score if _fe and _fe.score is defined and _fe.score is not none else none) %}
    {% set _fe_label = (_fe.label if _fe and _fe.label is defined else 'Neutral') %}
    {% set _to_pct = (I.turnover.pctile | float) if (I.turnover and I.turnover.get('pctile') is not none) else none %}
    {% set _sent_dial = (_fe_score | float) if _fe_score is not none else _to_pct %}
    {% set _sent_zone = ('fg-greed' if _sent_dial > 60 else ('fg-fear' if _sent_dial < 40 else 'fg-neutral')) if _sent_dial is not none else 'fg-neutral' %}
    {% set _sent_rot = ((_sent_dial / 100 * 180 - 90) | round(1)) if _sent_dial is not none else 0 %}
    <div class="cnx-card {{ _sent_zone }}" role="button" tabindex="0" aria-haspopup="dialog" onclick="cnxOpenDlg('cnx-dlg-sentiment')"
         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();cnxOpenDlg('cnx-dlg-sentiment');}">
      <div class="cnx-ctitle">{{ t('Market Sentiment','市场情绪') }}</div>
      {% if I.margin or I.turnover %}
      <div class="mx5-sentiment-dial-wrap" id="cnx-sentiment">
        <svg viewBox="0 0 380 212" style="width:100%;max-width:300px;height:170px;display:inline-block;overflow:visible">
          <defs>
            <linearGradient id="cnxSentGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="var(--down)"/>
              <stop offset="35%"  stop-color="var(--warn)"/>
              <stop offset="65%"  stop-color="var(--up)"/>
              <stop offset="100%" stop-color="var(--up)"/>
            </linearGradient>
            <filter id="cnxDialGlow"><feGaussianBlur stdDeviation="3" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
          </defs>
          {# Track #}
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="18" stroke-linecap="round"/>
          {# Gradient decorative track #}
          <path d="M 35 185 A 155 155 0 0 1 345 185" fill="none" stroke="url(#cnxSentGrad)" stroke-width="18" stroke-linecap="round" opacity=".55"/>
          {% if _sent_dial is not none %}
          {# Needle wrapped in <g> so filter bbox is always non-zero (group includes the hub circles).
             fg-mark-s/fg-mark-f pick up --fg-col via CSS so the needle flips colour in zh. #}
          <g filter="url(#cnxDialGlow)">
            <line class="fg-mark-s" x1="190" y1="185" x2="190" y2="30"
                  stroke-width="4" stroke-linecap="round"
                  transform="rotate({{ _sent_rot }}, 190, 185)"/>
            <circle class="fg-mark-s" cx="190" cy="185" r="9"  fill="rgba(8,12,18,.8)" stroke-width="2.5"/>
            <circle class="fg-mark-f" cx="190" cy="185" r="4"/>
          </g>
          {% endif %}
          {# Zone labels: bilingual dual-text; placed below arc for clearance #}
          <text class="l-en fg-lab-panic" x="26"  y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">PANIC</text>
          <text class="l-zh fg-lab-panic" x="26"  y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" font-weight="700" text-anchor="start">恐慌</text>
          <text class="l-en fg-lab-euph" x="354" y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">EUPHORIA</text>
          <text class="l-zh fg-lab-euph" x="354" y="208" font-size="13" font-family="Inter,-apple-system,sans-serif" text-anchor="end" font-weight="700">亢奋</text>
        </svg>
      </div>
      <div class="mx5-sentiment-zone-text" style="color:var(--fg-col)">
        {% if _fe_score is not none %}
        <span>{{ t(_fe_label, _fe_label) }}</span>
        {% elif I.turnover %}
        <span>{{ t(I.turnover.band | title, {'apathy':'清淡','normal':'正常','active':'活跃','mania':'狂热'}.get(I.turnover.band, I.turnover.band | title)) }}</span>
        {% else %}
        <span>{{ t('Neutral','中性') }}</span>
        {% endif %}
      </div>
      <div class="mx5-sentiment-label">
        {% if _sent_dial is not none %}
        <span class="l-en">Composite at {{ _sent_dial | int }} &middot; a heads-up, not a scored signal</span>
        <span class="l-zh">综合指数 {{ _sent_dial | int }} &middot; 仅供参考，不构成评分信号</span>
        {% else %}
        <span class="l-en">a heads-up, not a scored signal</span>
        <span class="l-zh">仅供参考，不构成评分信号</span>
        {% endif %}
      </div>
      {% else %}
      <div style="font-size:12px;color:var(--muted)">{{ t('Data building…','数据积累中…') }}</div>
      {% endif %}
    </div>

    {# Sector Temperature card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-sector')">
      <div class="cnx-ctitle">{{ t('Sector Temperature','板块温度') }}</div>
      {% if pb_obj and pb_obj.leaders %}
      <div class="cnx-lbl">{{ t('Hot','热门') }}</div>
      <div class="cnx-chips">
        {% for x in pb_obj.leaders[:3] %}<span class="cnx-chip hot">{{ td(x.name) }}</span>{% endfor %}
      </div>
      {% endif %}
      {% set _buy_chips = ((actions.buy_now if actions and actions.buy_now else []) + (actions.buy_soon if actions and actions.buy_soon else []))[:3] %}
      {% if _buy_chips %}
      <div class="cnx-lbl">{{ t('Turning up — buy zone','回升中 — 买入区') }}</div>
      <div class="cnx-chips">
        {% for x in _buy_chips %}<span class="cnx-chip turn">{{ td(x.name) }}</span>{% endfor %}
      </div>
      {% endif %}
      <div class="cnx-lbl">{{ t('Sector heat','板块热度') }}</div>
      <div class="cnx-heat">
        {% for s in (sectors[:16] if sectors else []) %}
        {# Tone keyed on s.dir which is always populated with the real uppercase-state-derived direction #}
        {% set _tone = 'c' if s.dir == 'down' else ('h2' if s.dir == 'caution' else ('h3' if s.dir == 'up' else 'n')) %}
        <i class="{{ _tone }}"></i>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- =============== ROW 3: Policy Monitor + Connect Flows + Macro News =============== -->
  <div class="cnx-rack3">
    {# Policy Monitor card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-policy')">
      <div class="cnx-ctitle">{{ t('Policy Monitor','政策监控') }}</div>
      {% if I.pboc %}
      <div class="cnx-kv"><span class="k">{{ t('PBoC stance','央行立场') }}</span><span class="v"><span class="cnx-stword ok">{{ t(I.pboc.bias, {'easing':'宽松','neutral':'中性','tightening':'收紧'}.get(I.pboc.bias,'')) }}</span></span></div>
      <div class="cnx-kv"><span class="k">{{ t('Reserve ratio','存准率') }}</span><span class="v">{{ I.pboc.rrr_big }}%</span></div>
      {% endif %}
      {% if I.credit %}
      {% if I.credit.credit_impulse is not none and I.credit.credit_impulse is defined %}
      <div class="cnx-kv"><span class="k">{{ t('Credit impulse','信贷脉冲') }}</span><span class="v"><span class="cnx-stword {{ 'ok' if I.credit.credit_impulse >= 0 else 'bad' }}">{{ '%+.1f'|format(I.credit.credit_impulse) }}%</span></span></div>
      {% endif %}
      {% endif %}
      {% if CN and CN.tone %}
      <div class="cnx-kv"><span class="k">{{ t('Official tone','官方基调') }}</span><span class="v"><span class="cnx-stword ok">{{ t(CN.tone.label_en, CN.tone.label_zh) }}</span></span></div>
      {% endif %}
      <div class="cnx-foot">{{ t('Easy policy, but new credit is still slowing.','政策宽松，但新信贷仍在放缓。') if (I.credit and I.credit.credit_impulse is defined and I.credit.credit_impulse < 0) else t('Policy context.','政策背景。') }}</div>
    </div>

    {# Connect Flows card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-flows')">
      <div class="cnx-ctitle">{{ t('Connect Flows','互联通资金') }}</div>
      {% if I.southbound %}
      <div class="cnx-bignum" style="color:{{ 'var(--up)' if I.southbound.net >= 0 else 'var(--down)' }}">{{ '+¥' if I.southbound.net >= 0 else '−¥' }}{{ '{:,.0f}'.format((I.southbound.net | abs) / 100) }}亿</div>
      <div class="cnx-bigsub" style="color:{{ 'var(--up)' if I.southbound.net >= 0 else 'var(--down)' }}">{{ t('Southbound buying' if I.southbound.net >= 0 else 'Southbound selling', '南向买入' if I.southbound.net >= 0 else '南向卖出') }}</div>
      <div class="cnx-kv"><span class="k">{{ t('Streak','连续') }}</span><span class="v">{{ I.southbound.pos_days_20 }}/20 {{ t('days','天') }}</span></div>
      {% endif %}
      {% if leaderboard and leaderboard.southbound_buy %}
      <div class="cnx-kv"><span class="k">{{ t('Top buys','主要买入') }}</span><span class="v">{{ leaderboard.southbound_buy[:3] | map(attribute='name_zh') | select | list | join(' · ') or '—' }}</span></div>
      {% endif %}
      <div class="cnx-foot">{{ t('Mainland money supporting Hong Kong.','内地资金持续支撑香港。') }}</div>
    </div>

    {# Macro News card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-news')">
      <div class="cnx-ctitle">{{ t('Macro News','宏观新闻') }}</div>
      {% if CN and CN.news and CN.news.headlines %}
        {% for h in CN.news.headlines[:2] %}
        <div class="cnx-row">
          <span class="ic">{{ {'pboc_liquidity':'🏦','market':'🏛','policy':'🏛','global':'🌐','company':'📉'}.get((h.channels[:1] or [''])[0], '📰') }}</span>
          <div class="tx"><b>{{ h.title | truncate(80, true, '…') }}</b>
            <span class="sub">{{ CN.theme_label.get(h.theme, [h.theme, h.theme]) | first if CN.theme_label else h.theme }} · {{ h.source_name or '' }}</span></div>
        </div>
        {% endfor %}
        <div class="cnx-view-all">{{ (CN.news.n_kept or 0) }} {{ t('of','/') }} {{ (CN.news.n_raw or 0) }} {{ t('stories kept · full feed →','条新闻保留 · 完整新闻流 →') }}</div>
      {% else %}
      <div style="font-size:12px;color:var(--muted);padding:8px 0">{{ t('No news right now.','暂无新闻。') }}</div>
      {% endif %}
    </div>
  </div>

  <!-- =============== ROW 4: Property + AI Brief + Alerts Centre =============== -->
  <div class="cnx-rack3">
    {# Property card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-property')">
      <div class="cnx-ctitle">{{ t('Property','房地产') }}</div>
      {% if P %}
      {% set R = P.regime %}
      <div class="cnx-bignum" style="color:var(--down);font-size:22px">{{ t(R.label_en, R.label_zh) }}</div>
      <div class="cnx-bigsub" style="color:var(--warn)">{{ t('easing at the margin','边际宽松') if R.tone in ('neutral','pos') else t('still contracting','仍在收缩') }}</div>
      {% if P.breadth %}
      <div class="cnx-kv"><span class="k">{{ t('70-city prices','70城价格') }}</span><span class="v">{{ '%+d'|format(P.breadth.new) }} {{ t('net cities','净城市数') }}</span></div>
      {% endif %}
      <div class="cnx-foot">{{ t('Still the economy\'s main drag.','仍是经济的主要拖累。') }}</div>
      {% else %}
      <div style="font-size:12px;color:var(--muted)">{{ t('Data loading…','数据加载中…') }}</div>
      {% endif %}
    </div>

    {# AI Brief card — v2 teaser: lead with the first key reading + the plain-word
       gist line (falls back to summary on v1 payloads). No raw slugs (doctrine Law 2). #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-aibrief')">
      <div class="cnx-ctitle">{{ t('AI Brief','AI 简报') }}</div>
      {% if china_brief %}
      {% set _cb = china_brief %}
      {% set _cbzh = _cb.zh if _cb.zh is defined and _cb.zh else {} %}
      {% set _kf = _cb.key_facts or [] %}
      {% if _kf %}
      {# first ≤2 engine-computed key readings as chips (label · value) #}
      <div class="cnx-chips">
        {% for _f in _kf[:2] %}
        <span class="cnx-chip"><span class="l-en">{{ _f.get('label_en') }}: {{ _f.get('value_en') }}</span><span class="l-zh">{{ _f.get('label_zh') or _f.get('label_en') }}：{{ _f.get('value_zh') or _f.get('value_en') }}</span></span>
        {% endfor %}
      </div>
      {% else %}
      <div class="cnx-chips">
        <span class="cnx-chip">{{ t('Regime','周期') }}</span>
        <span class="cnx-chip">{{ t('Policy','政策') }}</span>
        <span class="cnx-chip">{{ t('Southbound','南向') }}</span>
      </div>
      {% endif %}
      {# the plain-word gist: prefer the tldr stance line, else the one-line summary #}
      {% set _tldr = _cb.tldr or [] %}
      {% set _tldr_zh = _cbzh.get('tldr') or [] %}
      {% if _tldr %}
      {% set _lead = _tldr[0] %}
      {% set _lead_zh = _tldr_zh[0] if _tldr_zh else _lead %}
      <p style="font-size:12px;margin:6px 0 0"><span class="l-en">{{ _lead }}</span><span class="l-zh">{{ _lead_zh }}</span></p>
      {% elif _cb.summary %}
      <p style="font-size:12px;margin:6px 0 0"><span class="l-en">{{ _cb.summary | truncate(110, true, '…') }}</span><span class="l-zh">{{ (_cbzh.get('summary') or _cb.summary) | truncate(110, true, '…') }}</span></p>
      {% endif %}
      {% else %}
      <div class="cnx-chips"><span class="cnx-chip">{{ t('Regime','周期') }}</span><span class="cnx-chip">{{ t('Policy','政策') }}</span></div>
      {% endif %}
      <div class="cnx-foot">{{ t('A read-through of signals — not a signal source.','信号解读 — 非信号来源。') }}</div>
    </div>

    {# Alerts Centre card #}
    <div class="cnx-card" role="button" tabindex="0" onclick="cnxOpenDlg('cnx-dlg-alerts')">
      <div class="cnx-ctitle">{{ t('Alerts Centre','警报中心') }}
        {% if latest.alerts %}<span class="cnx-alert-pill">{{ latest.alerts | length }} {{ t('FIRED','已触发') }}</span>{% endif %}</div>
