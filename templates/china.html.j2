<script>
/* W8-E: StockTable init — standout board table view (CN market).
   Wired only on the stocks mode page (setups.buy exists); safe no-op if element absent. */
(function(){
function initStockTableView(){
  if (!window.StockTable) return;
  var SECZH = {"Technology":"科技","Industrials":"工业","Basic Materials":"原材料","Financial Services":"金融","Consumer Cyclical":"可选消费","Healthcare":"医疗保健","Utilities":"公用事业","Consumer Defensive":"必需消费","Energy":"能源","Communication Services":"通信服务","Real Estate":"房地产"};
  var STAGE_LABELS = {"ENTRY":["ENTRY","入场"],"RAN_LATE":["RAN/LATE","信号已过"],"RIPENING":["RIPENING","蓄势中"]};
  var ZONE_LABELS = {"READY":["READY","就绪"],"BASING":["BASING","筑底"],"FALLING":["FALLING","下跌"]};
  var LANE_LABELS = {
    "featured":["Featured","精选入场"],
    "more_actionable":["More live","更多实时"],
    "late_or_unfillable":["Blocked / late","受阻 / 已晚"],
    "forming":["Early warning","早期预警"],
    "ripening":["Ripening","蓄势中"],
    "falling":["Falling","下跌中"],
    "ran":["Already ran","信号已过"]
  };
  var TIER_ZH = {"PRIME":"极佳","CONFIRMED":"确认","CONFIRMING":"确认中","APPROACHING":"临近","FIRST SPARK":"首信号"};
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum, mg = StockTable._macdGlyph;

  function legacyContextRank(r) {
    /* Context-only ordering for the older ripening/ran shelves. Prophet board
       rows never enter this heuristic. */
    var st = r.stage || r._stage, zone = r.zone, v;
    if (st === 'ENTRY') {
      v = (r.conviction != null ? parseFloat(r.conviction) : 45);
      if (r.days_since_signal != null && r.days_since_signal <= 2) v += 8;
      if (r.washout_2w) v += 4;
      if (r.coiled) v += 2;
    } else if (st === 'RIPENING' && zone === 'READY') {
      v = 55;
      if (r.imminence != null) v += Math.max(0, 18 - 8 * r.imminence);
      if (r.w2_stoch != null) v += r.w2_stoch <= 20 ? 10 : (r.w2_stoch <= 35 ? 6 : 0);
      if (r.w2_stoch_arrow === 1) v += 4;
      if (r.macd_hist_d != null && r.macd_hist_d > 0) v += 3;
    } else if (st === 'RIPENING' && zone === 'BASING') {
      v = 35;
      if (r.w2_stoch != null) v += r.w2_stoch <= 20 ? 12 : (r.w2_stoch <= 35 ? 7 : 0);
      if (r.w2_stoch_arrow === 1) v += 5;
      if (r.macd_hist_d != null && r.macd_hist_d > 0) v += 3;
      if (r.spot_pct_in_range != null) v += r.spot_pct_in_range <= 15 ? 6 : (r.spot_pct_in_range <= 30 ? 3 : 0);
    } else if (st === 'RIPENING') {   // FALLING — knife; stays near the bottom
      v = 8;
      if (r.w2_stoch_arrow === 1) v += 4;
    } else {                          // RAN_LATE — signal spent
      v = 2;
    }
    return Math.max(0, Math.min(100, v));
  }

  function prophetTableRank(r) {
    /* Preserve semantic lanes first, then the server-issued Prophet priority.
       This keeps execution-blocked and early-warning rows from sorting above
       featured entries because of an unrelated client-side heuristic. */
    var laneOrder = {
      featured:7, more_actionable:6, late_or_unfillable:5,
      ripening:4, forming:3, falling:2, ran:1
    };
    var bucket = laneOrder[r.lane] || 0;
    var score = r.prophet_score == null ? legacyContextRank(r) : parseFloat(r.prophet_score);
    if (isNaN(score)) score = 0;
    var tie = r.score_rank == null ? 0 : Math.max(0, 10000 - parseInt(r.score_rank,10)) / 100000;
    return bucket * 1000 + score + tie;
  }

  function laneBadge(lane) {
    if (!lane) return '<span class="st-muted">—</span>';
    var pair = LANE_LABELS[lane] || [lane.replace(/_/g,' '),lane.replace(/_/g,' ')];
    var cls = lane === 'featured' ? 'st-chip-entry' :
      lane === 'late_or_unfillable' || lane === 'ran' ? 'st-chip-ran' :
      lane === 'forming' || lane === 'falling' ? 'st-chip-knife' : 'st-chip-rip';
    return '<span class="st-chip ' + cls + '">' + b(esc(pair[0]),esc(pair[1])) + '</span>';
  }

  function stageBadge(stage, zone) {
    if (!stage) return '<span class="st-muted">—</span>';
    var cls = stage === 'ENTRY' ? 'st-chip-entry' : stage === 'RAN_LATE' ? 'st-chip-ran' : zone === 'FALLING' ? 'st-chip-knife' : 'st-chip-rip';
    var lbl = stage === 'RIPENING' ? (zone || 'RIPENING') : stage;
    var lzh = ZONE_LABELS[lbl] ? ZONE_LABELS[lbl][1] : (STAGE_LABELS[lbl] ? STAGE_LABELS[lbl][1] : lbl);
    var len = ZONE_LABELS[lbl] ? ZONE_LABELS[lbl][0] : (STAGE_LABELS[lbl] ? STAGE_LABELS[lbl][0] : lbl);
    return '<span class="st-chip ' + cls + '">' + b(len, lzh) + '</span>';
  }

  /* Default view = 9 columns that fit a laptop viewport with no horizontal
     scroll (operator request 2026-07-10). Specialist columns (tier, theme,
     2W stoch, MACD, imminence, range%…) stay available via the Columns chooser. */
  var cols = [
    { key:'lane', labelEn:'Lane', labelZh:'通道', default:true, sortable:true,
      fmt:function(v){ return laneBadge(v); },
      tip:{en:'Prophet admission lane. Featured cleared every execution check; depth lanes state why a name did not.',zh:'先知准入通道。精选标的通过全部成交检查；扩展通道说明未入选原因。'} },
    { key:'_stage_zone', labelEn:'Stage', labelZh:'阶段', default:false, sortable:false,
      fmt:function(v,r){ return stageBadge(r.stage||r._stage, r.zone); },
      tip:{en:'Signal stage and zone (rows are pre-ranked by system)',zh:'信号阶段与区域（行已按系统排序）'} },
    { key:'ticker', labelEn:'Ticker', labelZh:'代码', default:true, sortable:true,
      fmt:function(v,r){
        var fresh = (r.days_since_signal != null && r.days_since_signal <= 2);
        return (fresh ? '<span class="st-new-dot"></span>' : '') + '<b>' + esc(v||'') + '</b>';
      }},
    { key:'name', labelEn:'Name', labelZh:'名称', default:true, sortable:true, cls:'st-name',
      fmt:function(v,r){
        var parts = (v||'').split(' / ');
        return '<span class="l-en">' + esc(parts[0]||'') + '</span><span class="l-zh">' + esc(parts[1]||parts[0]||'') + '</span>';
      }},
    { key:'tier', labelEn:'Tier', labelZh:'级别', default:false, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return '<span class="st-chip st-chip-entry" style="font-size:9px;padding:1px 6px">' + b(esc(v), esc(TIER_ZH[v]||v)) + '</span>'; }},
    { key:'sector', labelEn:'Sector', labelZh:'板块', default:true, sortable:true, cls:'st-hide-sm',
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return b(esc(v), esc(SECZH[v]||v)); }},
    { key:'theme', labelEn:'Theme', labelZh:'主题', default:false, sortable:true,
      fmt:function(v,r){
        var en = (r.narrative&&r.narrative.theme)||r.theme||'';
        var zh = (r.narrative&&r.narrative.theme_zh)||r.theme_zh||'';
        if(!en&&!zh) return '<span class="st-muted">—</span>';
        return b(esc(en), esc(zh));
      }},
    { key:'price', labelEn:'Price', labelZh:'价格', default:true, sortable:true, right:true, cls:'st-hide-sm',
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fn(v,2); }},
    { key:'prophet_score', labelEn:'Priority', labelZh:'优先级', default:true, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = Math.round(parseFloat(v)); var cls = n>=70?'st-pos':n>=40?'':'st-neg';
        return '<span class="' + cls + '">' + n + '</span>'; },
      tip:{en:'China Prophet priority 0–100. Readiness rank, not a win probability or return forecast.',zh:'中国先知优先级0–100。就绪度排序，不是胜率或收益预测。'} },
    { key:'conviction', labelEn:'Context score', labelZh:'情境评分', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': String(Math.round(parseFloat(v))); },
      tip:{en:'Legacy profile score shown only as context; it does not control Prophet v2 order.',zh:'旧版画像评分仅作情境参考；不影响先知v2排序。'} },
    { key:'mcap', labelEn:'Mkt cap', labelZh:'市值(亿)', default:true, sortable:true, right:true, cls:'st-hide-sm',
      fmt:function(v,r){ if(v==null) return '<span class="st-muted">—</span>';
