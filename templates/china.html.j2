        <span class="cn-intel"><span class="cn-pill cn-imp-{{ h.importance }}"><b>{{ h.importance_score }}</b>/100 · {{ h.importance }}</span>{% if h.source_name %}<span class="cn-pill">{{ h.source_name }}{% if h.source_tier %} · {{ h.source_tier }}{% endif %}</span>{% endif %}{% for c in h.channels[:4] %}<span class="cn-pill">{{ c }}</span>{% endfor %}{% for tk in h.tickers[:5] %}<span class="cn-pill cn-tk">{{ tk }}</span>{% endfor %}</span>
      {% if h.url %}</a>{% else %}</span>{% endif %}
      {% endfor %}
      </div>
    {% else %}
      <p class="note" style="text-transform:none">{{ t('No macro flashes right now — the flash fetch is off (default) or temporarily unavailable.', '暂无宏观快讯 —— 快讯抓取已关闭（默认）或暂不可用。') }}</p>
    {% endif %}
    <p class="cn-disc">{{ t('News context only.', '新闻仅作背景。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== REGIME PLAYBOOK (posture · where · next · calibration) ===================== -->
  <div class="panel span12" id="regime-playbook">
