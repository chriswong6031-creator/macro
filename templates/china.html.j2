          <span>{{ t(c.label_en, c.label_zh) }}</span>
          <span><div class="cnx-fbar"><i style="width:{{ c.score }}%;background:{{ 'var(--up)' if c.tone == 'pos' else ('var(--down)' if c.tone == 'neg' else 'var(--warn)') }}"></i></div>
            <div class="fread">{{ t(c.read_en or '', c.read_zh or '') }}</div></span>
          <span class="cnx-fscore" style="color:{{ 'var(--up)' if c.tone == 'pos' else ('var(--down)' if c.tone == 'neg' else 'var(--warn)') }}">{{ c.score }}</span>
