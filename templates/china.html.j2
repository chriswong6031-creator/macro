      </h2>
      <span class="chip c-muted" style="font-size:11px;font-weight:600">{{ t('display-only', '仅展示') }}</span>
    </div>
    {# stale / as_of stamp #}
    {% set _rd_asof = _rd.get('as_of') %}
    {% if _rd_asof %}
    <p class="note" style="font-size:11px;margin:0 0 10px;color:var(--muted)">{{ t('as of', '截至') }} {{ _rd_asof }}</p>
    {% endif %}
    {# top picks cards #}
    {% set _rd_picks = _rd.get('picks') or [] %}
    {% if _rd_picks %}
    <div class="nbgrid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px" data-showmore-rows="2">
      {% for n in _rd_picks %}
      {# W-FCT: whole card links to the stock's chart (china_lookup anchor —
         theme.js reroutes these to the Terminal app), same idiom as the
         standout ENTRY cards above. #}
      <a class="nbcard nb-up" href="china_lookup.html#{{ n.get('ticker','') }}">
        <div class="nb-id">
          <div class="nb-tkrow">
            <span class="nb-tk">{{ n.get('ticker','') }}</span>
            {% set _np = n.get('price') %}
            {% if _np is not none %}<span class="nb-px" data-sym="{{ n.get('ticker','') }}" data-mkt="cn">{{ '%.2f'|format(_np) }}</span>{% endif %}
          </div>
          <div class="nb-nm">
            {% set _nn = (n.get('name') or '').split(' / ') %}
            <span class="l-en">{{ _nn[0] }}</span><span class="l-zh">{{ _nn[1] if _nn|length > 1 else _nn[0] }}</span>
          </div>
          <div class="nb-secrow">
            {% set _ns = n.get('sector','') %}
            <span class="nb-sec">{{ t(_ns, {'Technology':'科技','Industrials':'工业','Basic Materials':'原材料','Financial Services':'金融','Consumer Cyclical':'可选消费','Healthcare':'医疗保健','Utilities':'公用事业','Consumer Defensive':'必需消费','Energy':'能源','Communication Services':'通信服务','Real Estate':'房地产'}.get(_ns, _ns)) }}</span>
            {% set _noh = n.get('off_high') %}
            {% if _noh is not none %}<span class="nb-offh">{{ '%+.1f'|format(_noh) }}% {{ t('off high', '距高点') }}</span>{% endif %}
          </div>
        </div>
        <div class="nb-ctx">
          {# reversal depth chip #}
          {% set _nrd = n.get('rev_depth_pct') %}
          {% if _nrd is not none %}<span class="chip c-muted" style="font-size:10px">{{ t('3m rev', '3月回归') }} {{ '%+.1f'|format(_nrd) }}%</span>{% endif %}
          {# CN-native bonus chips — washout, coiled/star, extension #}
          {% if n.get('washout_2w') %}<span class="nb-washout" style="font-size:10px"><span class="l-en">🌊 2W washout</span><span class="l-zh">🌊 2周洗盘</span></span>{% endif %}
          {% if n.get('coiled') %}<span class="nb-coiled" style="font-size:10px"><span class="l-en">⚡ Coiled</span><span class="l-zh">⚡ 蓄势</span></span>{% endif %}
          {# chase / T+1-risk chip (display only — never a veto here) #}
          {% if n.get('chase_veto') %}<span class="nb-ext" style="font-size:10px">⚠ <span class="l-en">chase risk</span><span class="l-zh">追高风险</span></span>{% endif %}
          {# cycle-phase chip if present #}
          {% set _ncp = n.get('cycle_phase') %}
          {% if _ncp %}<span class="chip c-muted" style="font-size:10px">{{ _ncp }}</span>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p class="note" style="text-transform:none;font-size:12.5px;color:var(--muted)">{{ t('No picks available for the Reversion Desk today.', '今日回归台暂无选择。') }}</p>
    {% endif %}
  </div>
  {% endif %}{# /_rd #}
  {% endif %}{# /mode == 'stocks' reversion desk #}

