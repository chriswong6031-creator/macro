      tip:{en:'Price position inside 2-year range (0=bottom, 100=top)',zh:'价格在2年区间内的位置（0=底部，100=顶部）'} },
    { key:'w2_stoch', labelEn:'2W Stoch', labelZh:'双周随机', default:false, sortable:true, right:true,
