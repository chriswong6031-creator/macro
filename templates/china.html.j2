<script>
/* MX5 dialog / popover / heatmap helpers (macro mode only) */
(function(){
  var _hmMounted=false;
  function cnxOpenDlg(id){
    var el=document.getElementById(id);
    if(!el)return;
    document.querySelectorAll('.cnx-dlg.open').forEach(function(d){d.classList.remove('open','cnx-in','cnx-closing');});
    el.classList.add('open');
    document.body.style.overflow='hidden';
    history.replaceState(null,'',location.pathname+'#'+id);
    /* Add .cnx-in on the next frame (after .open paints the start state) so the
       entrance transition — backdrop fade + panel rise/scale + body stagger — runs. */
    requestAnimationFrame(function(){requestAnimationFrame(function(){el.classList.add('cnx-in');});});
    /* Lazy-mount the China heatmap the first time the Markets dialog opens — the
       treemap needs a laid-out (visible) container, so we can't render it while hidden. */
    if(id==='cnx-dlg-markets'&&!_hmMounted&&window.MMHeatmap&&MMHeatmap.mountScorecard){
      _hmMounted=true;
      try{MMHeatmap.mountScorecard('cn-hm-embed','marketdata/china_heatmap.json');}
      catch(e){_hmMounted=false;}
    }
    /* Plotly charts render at a fixed width that overflows the narrower dialog columns.
       Once the panel is laid out (after the entrance animation), resize each chart so its
       SVG redraws to the column width. */
    setTimeout(function(){
      if(window.Plotly&&Plotly.Plots){
        el.querySelectorAll('.js-plotly-plot').forEach(function(g){try{
          var host=g.parentElement,w=host?host.clientWidth:0;
          if(Plotly.relayout&&w>10){Plotly.relayout(g,{width:w});}else{Plotly.Plots.resize(g);}
        }catch(e){}});
      }
    },380);
  }
  function cnxCloseDlg(){
    document.querySelectorAll('.cnx-dlg.open').forEach(function(el){
      var panel=el.querySelector('.cnx-dlg-panel');
      el.classList.add('cnx-closing');el.classList.remove('cnx-in');
      var fired=false;
      var done=function(){if(fired)return;fired=true;if(panel)panel.removeEventListener('transitionend',onEnd);el.classList.remove('open','cnx-closing');};
      var onEnd=function(e){if(e.target===panel)done();};
      if(panel)panel.addEventListener('transitionend',onEnd);
      setTimeout(done,360); /* fallback for reduced-motion / no transitionend */
    });
    document.body.style.overflow='';
    history.replaceState(null,'',location.pathname);
  }
  function cnxTogglePop(id,ev){
    if(ev){ev.stopPropagation();}
    var el=document.getElementById(id);
    if(!el)return;
    var was=el.classList.contains('open');
    cnxClosePops();
    if(!was)el.classList.add('open');
  }
  function cnxClosePops(){
    document.querySelectorAll('.cnx-pop.open').forEach(function(p){p.classList.remove('open');});
  }
  function cnxToggleHm(ev){
    if(ev){ev.stopPropagation();}
    var w=document.getElementById('cnx-hm');
    if(w)w.classList.toggle('expanded');
  }
  /* hash-resolver: open dialog if URL hash matches a cnx-dlg id */
  function cnxResolveHash(){
    var h=(location.hash||'').slice(1);
    if(!h)return;
    var el=document.getElementById(h);
    if(el&&el.classList.contains('cnx-dlg'))cnxOpenDlg(h);
    else if(el)el.scrollIntoView({behavior:'smooth'});
  }
  /* close dialog on Escape key */
  /* Escape: if the fullscreen heatmap overlay is open, let ITS own handler close it
     (don't also close the Markets dialog underneath). */
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){if(document.querySelector('.hm-ov'))return;cnxCloseDlg();}});
  /* close popovers on outside click */
  document.addEventListener('click',function(){cnxClosePops();});
  /* expose on window for onclick= attrs */
  window.cnxOpenDlg=cnxOpenDlg;
  window.cnxCloseDlg=cnxCloseDlg;
  window.cnxTogglePop=cnxTogglePop;
  window.cnxClosePops=cnxClosePops;
  window.cnxToggleHm=cnxToggleHm;
  cnxResolveHash();
  window.addEventListener('hashchange',cnxResolveHash);
})();
</script>
