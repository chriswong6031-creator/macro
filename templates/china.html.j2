        <div class="cnx-eyebrow">{{ t('Where we are in this regime','周期中的位置') }}</div>
        <div class="lifebar">
          <div class="zone" style="left:0;width:{{ pb_obj.progress.zone_early_pct }}%;background:color-mix(in srgb,var(--up) 32%,var(--panel))"></div>
          <div class="zone" style="left:{{ pb_obj.progress.zone_early_pct }}%;width:{{ pb_obj.progress.zone_mid_pct - pb_obj.progress.zone_early_pct }}%;background:color-mix(in srgb,var(--warn) 32%,var(--panel))"></div>
          <div class="zone" style="left:{{ pb_obj.progress.zone_mid_pct }}%;width:{{ 100 - pb_obj.progress.zone_mid_pct }}%;background:color-mix(in srgb,var(--down) 32%,var(--panel))"></div>
          <div class="marker" style="left:{{ pb_obj.progress.bar_pct }}%"></div>
        </div>
        <p style="margin:8px 0;font-size:12px;color:var(--muted)">{{ pb_obj.progress.age_days }} {{ t('trading days in','个交易日') }}</p>
        {% endif %}
