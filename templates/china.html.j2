          <span class="cn-depth-sub">{{ t('legacy early/T4/null-tier observations; useful for discovery, never counted as actionable buys', '旧版早期/T4/空层级观察；可用于发现机会，但绝不计为可操作买入') }}</span>
        </span>
        <span class="cn-depth-n">{{ _forming|length }}</span>
      </summary>
