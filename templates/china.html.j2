    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title">{{ t('Policy & Credit — PBoC, Impulse & Tape','政策与信贷 — 央行、脉冲与盘面') }}</span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        <div class="cnx-cols2">
          <div>
            <div class="cnx-eyebrow">{{ t('PBoC policy — reserve ratio','央行政策 — 存准率') }}</div>
