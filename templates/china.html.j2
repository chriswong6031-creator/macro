  body.page-china .cnx-sub-line .cnx-sub-g,body.page-china .cnx-sub-line .cnx-sub-r{display:none}
  body.page-china .cnx-sub-line .cnx-sub-y{display:inline}
  body.page-china .ms-green .cnx-sub-line .cnx-sub-g{display:inline}
  body.page-china .ms-green .cnx-sub-line .cnx-sub-y{display:none}
  body.page-china .ms-red .cnx-sub-line .cnx-sub-r{display:inline}
  body.page-china .ms-red .cnx-sub-line .cnx-sub-y{display:none}
