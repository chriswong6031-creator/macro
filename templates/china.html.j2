      {% if pair.cyc_def %}<tr><td class="l">{{ t('Cyclical / Defensive', '周期 / 防御') }}</td><td class="{{ 'pos' if pair.cyc_def.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.cyc_def.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.smallcap_largecap %}<tr><td class="l">{{ t('Small / Large cap', '小盘 / 大盘') }}</td><td class="{{ 'pos' if pair.smallcap_largecap.chg_20d_pct>=0 else 'neg' }}">{{ '%+.1f'|format(pair.smallcap_largecap.chg_20d_pct) }}</td></tr>{% endif %}
      {% if pair.usdcny %}<tr><td class="l">{{ t('USD / CNY', '美元 / 人民币') }}</td><td class="{{ 'neg' if pair.usdcny.chg_20d_pct>=0 else 'pos' }}">{{ '%+.1f'|format(pair.usdcny.chg_20d_pct) }}</td></tr>{% endif %}
    </table>
    {% endif %}
  </div>

