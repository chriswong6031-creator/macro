    {% if _late %}
    <details class="cn-depth late" data-stf="ran">
      <summary>
        <span>⚠ {{ t('Wait / unfillable / do not chase', '等待 / 无法成交 / 勿追涨') }}
          <span class="cn-depth-sub">{{ t('the signal exists, but lifecycle, extension or A-share execution checks block a featured entry', '信号存在，但生命周期、过度延伸或A股成交检查阻止其进入精选区') }}</span>
