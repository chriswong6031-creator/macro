      'tier':             '',
      'price':            _rr.get('price'),
      'off_high':         none,
      'spot_pct_in_range': _rr.get('spot_pct_in_range'),
      'conviction':       none,
      'mcap':             _rr.get('mcap'),
      'cap_bucket':       _rr.get('cap_bucket'),
      'days_since_signal': _rr.get('days_since_signal'),
      'washout_2w':       true,
      'macd_hist_d':      _rr.get('macd_hist_d'),
      'macd_d2':          _rr.get('macd_d2'),
      'macd_d3':          _rr.get('macd_d3'),
      'imminence':        _rr.get('imminence'),
      'w2_stoch':         _rr.get('w2_stoch'),
      'w2_stoch_arrow':   _rr.get('w2_stoch_arrow'),
