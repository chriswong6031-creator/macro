          <button class="rip-toggle-btn" onclick="var b=this.closest('.rip-zone').querySelector('.rip-fall-body');b.classList.toggle('rip-collapsed');this.innerHTML=b.classList.contains('rip-collapsed')?'{{ t('show','展开')|replace('"','&quot;') }}':'{{ t('hide','收起')|replace('"','&quot;') }}'">
