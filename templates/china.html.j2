          {% for tl in (market_tiles or []) %}{% if 'CGB' in (tl.tag | string) or 'yield' in (tl.tag | string) %}{% if not _cgb %}{% set _cgb = tl %}{% endif %}{% endif %}{% endfor %}
          {% if _cgb %}
          <div class="cnx-ihcard"><div class="t">10Y CGB</div><div class="p">{{ _cgb.level }}</div><span class="cnx-nchip">{{ t('govt bond yield','国债收益率') }}</span></div>
          {% endif %}
          {# QVIX #}
          {% if I.margin and I.margin.qvix is defined %}
