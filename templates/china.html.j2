      <div class="tile"><div class="tv neg">{{ I.flows.limit.dt }}</div><div class="tk">{{ t('limit-down 跌停', '跌停') }}</div></div>
      {% if I.flows.limit.seal_rate is not none %}<div class="tile"><div class="tv">{{ I.flows.limit.seal_rate }}%</div><div class="tk">{{ t('seal rate 封板率', '封板率') }}</div></div>{% endif %}
    </div>
    <p class="note" style="font-size:11px;margin:0">{{ t('as of', '截至') }} {{ I.flows.limit.date }} · {{ t('炸板', '炸板') }} {{ I.flows.limit.zb }}</p>
    {% endif %}
    {% if I.flows.etf %}
    <p class="note" style="margin:8px 0 0">{% if I.flows.etf.building %}{{ t('ETF flow: building (needs a 2nd daily snapshot)', 'ETF 资金流：积累中（需第二个每日快照）') }}{% else %}{{ t('ETF net creation', 'ETF 净申购') }}: <b class="{{ 'pos' if I.flows.etf.net_creation>=0 else 'neg' }}">{{ '{:+,d}'.format(I.flows.etf.net_creation) }}</b> {{ t('shares', '份') }} ({{ I.flows.etf.up }}↑/{{ I.flows.etf.down }}↓){% endif %}</p>
    {% endif %}
  </div>
  {% endif %}

    </div>
  </div>
  {% endif %}

