  {% set SECZH = {'Technology':'科技','Industrials':'工业','Basic Materials':'原材料','Financial Services':'金融','Consumer Cyclical':'可选消费','Healthcare':'医疗保健','Utilities':'公用事业','Consumer Defensive':'必需消费','Energy':'能源','Communication Services':'通信服务','Real Estate':'房地产'} %}

  {% if mode != 'macro' %}
  <!-- ===================== STANDOUT STOCKS (reversal-led cards · selection × timing) ===================== -->
