        {% endfor %}
        {# Signal stack strip — 'do they agree?' (vm.signal_stack) #}
        {% if signal_stack and signal_stack.legs %}
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('Signals — do they agree?','各信号 — 是否一致？') }}</div>
        {% for leg in signal_stack.legs %}
        <div class="cnx-frow" style="grid-template-columns:160px 1fr">
          <span>{{ t(leg.label_en, leg.label_zh) }}</span>
          <span class="cnx-stword {{ 'ok' if leg.tone == 'up' else ('bad' if leg.tone == 'down' else 'warn') }}">{{ t(leg.state_en, leg.state_zh) }}</span>
        </div>
        {% endfor %}
        <div style="margin-top:8px;font-size:11.5px">
          <span class="cnx-stword {{ 'ok' if signal_stack.anchor_tone == 'up' else ('bad' if signal_stack.anchor_tone == 'down' else 'warn') }}">{{ signal_stack.agreement_pct }}% {{ t('agreement','一致度') }}</span>
          · {{ t(signal_stack.quality_en, signal_stack.quality_zh) }}
          · {{ t(signal_stack.final_en, signal_stack.final_zh) }}
        </div>
        {% if signal_stack.contradiction_en %}
        <div style="font-size:11px;color:var(--muted);margin-top:4px">{{ t(signal_stack.contradiction_en, signal_stack.contradiction_zh) }}</div>
        {% endif %}
        {% endif %}
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('The regime — and where it\'s headed','当前周期 — 及走向') }}</div>
        <div class="cnx-cols2">
          <div>
            <div class="cnx-kv"><span class="k">{{ t('Regime','周期') }}</span><span class="v">{{ td(latest.quad_name) }}</span></div>
            <div class="cnx-kv"><span class="k">{{ t('Regime watch','周期预警') }}</span><span class="v">
              {% if latest.pending_quad in ['Q1','Q2','Q3','Q4'] and latest.pending_days %}
              {{ t('BUILDING','累积中') }} → {{ td({'Q1':'Goldilocks','Q2':'Reflation','Q3':'Stagflation','Q4':'Growth scare'}[latest.pending_quad]) }}
              {% else %}{{ t('Stable','稳定') }}{% endif %}</span></div>
            <div class="cnx-kv"><span class="k">{{ t('Signal agreement','信号一致度') }}</span><span class="v">{{ (latest.confidence*100)|round|int }}%</span></div>
            <div class="cnx-kv"><span class="k">{{ t('Cycle backdrop','商业周期') }}</span><span class="v">{{ td(latest.cycle_tag) }}</span></div>
          </div>
          <div>
            {% if latest.confirming %}<p style="font-size:11px;color:var(--muted)">{{ t('Confirming','确认') }}: {{ latest.confirming | join(', ') }}</p>{% endif %}
            {% if latest.contradicting %}<p style="font-size:11px;color:var(--muted)">{{ t('Contradicting','矛盾') }}: {{ latest.contradicting | join(', ') }}</p>{% endif %}
          </div>
        </div>
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('Market drivers','市场驱动') }}</div>
        {% if ms and ms.mtf and ms.mtf.indices %}
        <table class="cnx-mt">
          <tr><th>{{ t('Index','指数') }}</th><th class="r">1D</th><th class="r">7D</th><th class="r">30D</th><th class="r">{{ t('Read','判断') }}</th></tr>
          {% for ix in ms.mtf.indices %}
          <tr><td>{{ ix.label }}</td>
            <td class="r">{{ ix.scores[0] if ix.scores else '—' }}</td>
            <td class="r">{{ ix.scores[2] if ix.scores and ix.scores | length > 2 else '—' }}</td>
            <td class="r">{{ ix.scores[3] if ix.scores and ix.scores | length > 3 else '—' }}</td>
            <td class="r {{ 'cnx-tt-up' if ix.mean > 0.33 else ('cnx-tt-dn' if ix.mean < -0.1 else 'cnx-tt-fl') }}">{{ t((ix.confluence_en or '')|truncate(16, true, '…'), (ix.confluence_zh or '')|truncate(16, true, '…')) }}</td>
          </tr>
          {% endfor %}
        </table>
        {% endif %}
        {# China state cockpit — phase card, context chips #}
        {% if cn_market_state_json %}
        {% set _cms = cn_market_state_json %}
        {% set _ph = (_cms.get('phase') or {}) %}
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('A-Share Phase','A股阶段') }}</div>
        {% endif %}
        <div class="cnx-receipt">{{ t('Context, not a forecast. China-native composite — options-fear and margin-froth legs stand in for VIX/HY.','仅作背景，非预测。中国本土综合指标——期权恐慌与两融拥挤腿代替VIX/HY。') }}</div>
      </div>
    </div>
  </div>

  <!-- Pullback risk dialog -->
  <div class="cnx-dlg" id="cnx-dlg-risk">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title">{{ t('Pullback Risk — Radar & Gauges','回撤风险 — 雷达与仪表') }}</span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        <div class="cnx-cols2">
          <div>
            <div class="cnx-eyebrow">{{ t('Risk radar','风险雷达') }}{% if _rr_score is not none %} · {{ _rr_score }}/100{% endif %}</div>
            {% if _rr_score is not none %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 8px">
              <span class="cnx-bignum" style="color:var(--down)">{{ _rr_score }}</span>
              <span class="cnx-alert-pill" style="background:color-mix(in srgb,var(--down) 16%,transparent);color:var(--down);margin:0">{{ t((_rr.label_en or '').upper(), (_rr.label_zh or '').upper()) }}</span>
            </div>
            <div style="font-size:12px;color:var(--muted);margin-bottom:10px">{{ t(_rr_sub_en, _rr_sub_zh) }}</div>
            {% for leg in (_rr.scares or [])[:4] %}
            <div class="cnx-frow" style="grid-template-columns:170px 1fr 40px">
              <span>{{ t(leg.label_en or leg.scare, leg.label_zh or leg.scare or '') }}</span>
              <span><div class="cnx-fbar"><i style="width:{{ leg.score|round|int }}%;background:var(--down)"></i></div></span>
              <span class="cnx-fscore" style="color:var(--down)">{{ leg.score|round|int }}</span>
            </div>
            {% endfor %}
            {% endif %}
          </div>
          <div>
            <div class="cnx-eyebrow">{{ t('Deep-drawdown gauge','深跌仪表') }}</div>
            {% if latest.conditions and latest.conditions.get('recession') %}
            {% set _cr = latest.conditions.recession %}
            <div style="display:flex;gap:10px;align-items:baseline;margin:2px 0 6px">
              <span class="cnx-bignum" style="color:{{ 'var(--down)' if (_cr.score or 0) >= 60 else 'var(--warn)' if (_cr.score or 0) >= 40 else 'var(--up)' }}">{{ (_cr.score or 0) | round | int }}</span>
            </div>
            {% if _cr.chart_html %}<div class="chart">{{ _cr.chart_html | safe }}</div>{% endif %}
            {% else %}
            <div style="font-size:12px;color:var(--muted)">{{ t('No gauge data.','无仪表数据。') }}</div>
            {% endif %}
            <div class="cnx-eyebrow">{{ t('Slowdown gauge','放缓仪表') }}</div>
            {% if latest.conditions and latest.conditions.get('drawdown') %}
            {% set _cdd = latest.conditions.drawdown %}
            {% if _cdd.chart_html %}<div class="chart">{{ _cdd.chart_html | safe }}</div>{% endif %}
            {% endif %}
          </div>
        </div>
        {# FX context row-pair (MSX-1, Tier-2, adjacent to CGL pattern).
           Guard: entire block absent when _rr.fx_context is not present.
           Dual-span l-en/l-zh; no title= translated text; no <svg><text> spans. #}
        {% if _rr and _rr.fx_context is defined and _rr.fx_context %}
        {% set _fxc = _rr.fx_context %}
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('FX context','外汇背景') }}</div>
        {%- set _cnh_st = _fxc.cnh_basis_state if _fxc.cnh_basis_state is defined else none -%}
        {%- set _cnh_en = 'Offshore yuan: outflow pressure' if _cnh_st == 'outflow_stress' else ('Offshore yuan: inflow bid' if _cnh_st == 'inflow' else 'Offshore yuan: no unusual pressure') -%}
        {%- set _cnh_zh = '离岸人民币：资金外流压力' if _cnh_st == 'outflow_stress' else ('离岸人民币：资金流入' if _cnh_st == 'inflow' else '离岸人民币：无异常压力') -%}
        {%- set _cnh_chip = 'cnx-alert-pill' if _cnh_st == 'outflow_stress' else ('cnx-nchip' if _cnh_st == 'inflow' else 'cnx-okchip') -%}
        {%- set _usd = _fxc.usd_dir if _fxc.usd_dir is defined else none -%}
        {%- set _usd_en = 'Dollar rising — headwind for EM' if _usd == 'strengthening' else ('Dollar falling — tailwind for EM' if _usd == 'weakening' else 'Dollar: mixed') -%}
        {%- set _usd_zh = '美元走强 — 新兴市场逆风' if _usd == 'strengthening' else ('美元走弱 — 新兴市场顺风' if _usd == 'weakening' else '美元：方向混乱') -%}
        {%- set _usd_chip = 'cnx-alert-pill' if _usd == 'strengthening' else ('cnx-okchip' if _usd == 'weakening' else 'cnx-nchip') -%}
        <div class="cnx-frow" style="grid-template-columns:160px 1fr">
          <span>{{ t('Yuan pressure','人民币压力') }}</span>
          <span><span class="{{ _cnh_chip }}" style="font-size:11px"><span class="l-en">{{ _cnh_en }}</span><span class="l-zh">{{ _cnh_zh }}</span></span>
          {%- if _fxc.cnh_basis_bps is defined and _fxc.cnh_basis_bps is not none %} <span class="cnx-nchip">{{ '%.0f'|format(_fxc.cnh_basis_bps) }}bp</span>{%- endif -%}
          </span>
        </div>
        <div class="cnx-frow" style="grid-template-columns:160px 1fr">
          <span>{{ t('Dollar direction','美元方向') }}</span>
          <span><span class="{{ _usd_chip }}" style="font-size:11px"><span class="l-en">{{ _usd_en }}</span><span class="l-zh">{{ _usd_zh }}</span></span></span>
        </div>
        {%- if _fxc.stale is defined and _fxc.stale and _fxc.built_date is defined and _fxc.built_date %}
        <div style="font-size:9.5px;color:var(--muted)"><span class="l-en">FX data as of {{ _fxc.built_date }}</span><span class="l-zh">外汇数据截至 {{ _fxc.built_date }}</span></div>
        {%- endif %}
        {% endif %}
        <div class="cnx-receipt">{{ t('Gauges read what has already turned — context, not a forecast.','仪表读取的是已经转变的信号 — 仅作背景，非预测。') }}</div>
      </div>
    </div>
  </div>

  <!-- Markets dialog (index health + heatmap + cross-asset rates) -->
  <div class="cnx-dlg" id="cnx-dlg-markets">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
