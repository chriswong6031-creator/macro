            <div class="t">{{ t((ix.label or '')|upper, ix.label_zh or '') }}</div>
            <div class="p">{{ '%.2f'|format(ix.price) }}</div>
            <span class="{{ 'cnx-okchip' if ix.above200 else 'cnx-badchip' }}">{{ t('Above','上方') if ix.above200 else t('Below','下方') }} 200d {{ '✓' if ix.above200 else '✕' }}</span>
            <span class="{{ 'cnx-okchip' if ix.above50 else 'cnx-badchip' }}">{{ t('Above','上方') if ix.above50 else t('Below','下方') }} 50d {{ '✓' if ix.above50 else '✕' }}</span>
            <span class="cnx-nchip">{{ '%+.1f'|format(ix.dd) }}% {{ t('off high','距高点') }}</span>
          </div>
          {% endfor %}
          {# HSI card #}
          {% if hsi_tile %}
          <div class="cnx-ihcard">
            <div class="t"><span class="l-en">HANG SENG</span><span class="l-zh">恒生指数</span></div>
            <div class="p">{{ hsi_tile.level }} <span class="{{ 'cnx-tt-up' if hsi_tile.tone == 'pos' else 'cnx-tt-dn' }}" style="font-size:12px">{{ hsi_tile.pct }}</span></div>
            <span class="cnx-nchip"><span class="l-en">live-patched intraday</span><span class="l-zh">盘中实时更新</span></span>
          </div>
          {% endif %}
        </div>
        {% endif %}
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('Sector temperature','板块温度') }}</div>
        <div class="cnx-cols2">
          <div>
            <div class="cnx-lbl" style="margin-top:0">{{ t('Leading sectors','领先板块') }}</div>
            {# Leading = first 4 sectors in rotation order (sectors is rotation-ranked best-first).
               The Python-side score_and_rank() already sorted the list; we just slice here.
               Do NOT re-sort with |sort — that would contradict the Rotation table. #}
            {% for s in sectors[:4] %}
            <div class="cnx-ledd"><span class="cnx-tt-up">▲ {{ td(s.name) }}</span><span class="rk">#{{ loop.index }}</span></div>
            {% endfor %}
          </div>
          <div>
            <div class="cnx-lbl" style="margin-top:0">{{ t('Lagging sectors','落后板块') }}</div>
            {# Lagging = last 4 sectors in rotation order — worst rotation rank first. #}
            {% if sectors %}
            {% for s in sectors[-4:] | reverse %}
            <div class="cnx-ledd"><span class="cnx-tt-dn">▽ {{ td(s.name) }}</span><span class="rk">#{{ sectors | length - loop.index0 }}</span></div>
            {% endfor %}
            {% endif %}
          </div>
        </div>
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('A-share sector heatmap','A股板块热力图') }}</div>
        <div class="cnx-hm-wrap" id="cnx-hm">
          {# MMHeatmap.mountScorecard renders the FULL scorecard here on first open of
             dlg-markets — it brings its own title, Expand button and breadth footer, so
             we don't wrap it with our own (that was the duplicate header/Expand). If
             heatmap.js/MMHeatmap is unavailable, the link fallback below stays. #}
          <div id="cn-hm-embed">
            <div style="display:flex;align-items:center;justify-content:center;height:80px;font-size:12px;color:var(--muted)">
              <a href="china_heatmap.html" style="color:var(--link)">{{ t('→ Open full heatmap','→ 打开完整热力图') }}</a>
            </div>
          </div>
        </div>
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('Key rates & cross-asset','关键利率与跨资产') }}</div>
        <div class="cnx-ihgrid">
          {# USD/CNH #}
          {% set _cnh = none %}
          {% for tl in (market_tiles or []) %}{% if 'CNH' in (tl.tag | string) or 'yuan' in (tl.label | string) %}{% if not _cnh %}{% set _cnh = tl %}{% endif %}{% endif %}{% endfor %}
          {% if _cnh %}
          <div class="cnx-ihcard"><div class="t">USD/CNH</div><div class="p">{{ _cnh.level }}</div><span class="cnx-nchip">{{ t('offshore yuan','离岸人民币') }}</span></div>
          {% endif %}
          {# 10Y CGB #}
          {% set _cgb = none %}
          {% for tl in (market_tiles or []) %}{% if 'CGB' in (tl.tag | string) or 'yield' in (tl.tag | string) %}{% if not _cgb %}{% set _cgb = tl %}{% endif %}{% endif %}{% endfor %}
          {% if _cgb %}
          <div class="cnx-ihcard"><div class="t">10Y CGB</div><div class="p">{{ _cgb.level }}</div><span class="cnx-nchip">{{ t('govt bond yield','国债收益率') }}</span></div>
          {% endif %}
          {# QVIX #}
          {% if I.margin and I.margin.qvix is defined %}
          <div class="cnx-ihcard"><div class="t">QVIX</div><div class="p">{{ I.margin.qvix }}</div><span class="cnx-okchip">{{ t('options fear','期权恐慌') }}</span></div>
          {% endif %}
        </div>
        <div class="cnx-receipt">{{ t('Context only — click a sector or name to open in the Terminal.','仅作背景 — 点击板块或个股在终端中查看。') }}</div>
      </div>
    </div>
  </div>

  <!-- Sentiment dialog -->
  <div class="cnx-dlg" id="cnx-dlg-sentiment">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title">{{ t('Market Sentiment — Breakdown','市场情绪 — 分解') }}</span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        {% set _fe = latest.fear_euphoria %}
        {% if _fe and _fe.components %}
        <div class="cnx-eyebrow">{{ t('Fear ↔ euphoria','恐惧 ↔ 亢奋') }}</div>
        {% for leg in _fe.components %}
        <div class="cnx-frow" style="grid-template-columns:190px 1fr 44px">
          <span>{{ t(leg.label_en or leg.label, leg.label_zh or leg.label) }}</span>
          <span><div class="cnx-fbar"><i style="width:{{ leg.score }}%;background:{{ 'var(--up)' if leg.score >= 60 else ('var(--warn)' if leg.score >= 40 else 'var(--down)') }}"></i></div></span>
          <span class="cnx-fscore {{ 'cnx-tt-up' if leg.score >= 60 else ('cnx-tt-dn' if leg.score < 40 else '') }}">{{ leg.score }}</span>
        </div>
        {% endfor %}
        {% if _fe.chart_html %}<div class="chart">{{ _fe.chart_html | safe }}</div>{% endif %}
        <div class="cnx-sep"></div>
        {% endif %}
        <div class="cnx-cols2">
          <div>
            <div class="cnx-eyebrow">{{ t('Margin crowd meter','两融拥挤度') }}</div>
            {% if I.margin %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 6px">
              <span class="cnx-bignum">{{ I.margin.fin_pct_float }}%</span>
            </div>
            <div class="cnx-kv"><span class="k">{{ t('Pctile','分位') }}</span><span class="v">{{ I.margin.pctile }}</span></div>
            <div class="cnx-kv"><span class="k">{{ t('Maint. ratio','维持担保') }}</span><span class="v">{{ I.margin.guarantee_ratio if I.margin.guarantee_ratio is defined else '—' }}%</span></div>
            <div class="cnx-kv"><span class="k">{{ t('20d net buy','20日净买入') }}</span>
              <span class="v {{ 'cnx-tt-up' if (I.margin.net_fin_buy_20d or 0) >= 0 else 'cnx-tt-dn' }}">{{ '%+d'|format(I.margin.net_fin_buy_20d) if I.margin.net_fin_buy_20d is not none else '—' }}</span></div>
            {% if I.margin.chart_html %}<div class="chart">{{ I.margin.chart_html | safe }}</div>{% endif %}
            {% endif %}
          </div>
          <div>
            <div class="cnx-eyebrow">{{ t('Sentiment thermometer','情绪温度计') }}</div>
            {% if I.turnover %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 6px">
              <span class="cnx-bignum">¥{{ I.turnover.turnover_t }}{{ t('T','万亿') }}</span>
            </div>
            <div class="cnx-kv"><span class="k">{{ t('Band','区间') }}</span><span class="v">{{ t(I.turnover.band, {'apathy':'清淡','normal':'正常','active':'活跃','mania':'狂热'}.get(I.turnover.band,'')) }}</span></div>
            {% if I.turnover.pctile is defined and I.turnover.pctile is not none %}
            <div class="cnx-kv"><span class="k">{{ t('Turnover heat','成交热度') }}</span><span class="v {{ 'cnx-tt-up' if (I.turnover.pctile|int) >= 80 else '' }}">{{ t(I.turnover.pctile|string ~ t('th percentile','th百分位'), I.turnover.pctile|string ~ '第百分位') }}{{ t(' — near record froth',' — 接近历史极值') if (I.turnover.pctile|int) >= 95 else (t(' — elevated',' — 偏高') if (I.turnover.pctile|int) >= 80 else '') }}</span></div>
            {% endif %}
            {% if I.flows and I.flows.limit %}
            <div class="cnx-kv"><span class="k">{{ t('Limit-up / down','涨停 / 跌停') }}</span><span class="v cnx-tt-up">{{ I.flows.limit.zt }}</span> / <span class="cnx-tt-dn">{{ I.flows.limit.dt }}</span></div>
            {% endif %}
            {% if I.turnover.chart_html %}<div class="chart">{{ I.turnover.chart_html | safe }}</div>{% endif %}
            {% endif %}
          </div>
        </div>
        <div class="cnx-receipt">{{ t('A heads-up, not a scored signal.','仅供参考，不构成评分信号。') }}</div>
      </div>
    </div>
  </div>

  <!-- Sector dialog -->
  <div class="cnx-dlg" id="cnx-dlg-sector">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title">{{ t('Sectors — Ladder, Rotation & Breadth','板块 — 阶梯、轮动与宽度') }}</span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        {% if pb_obj %}
        <div class="cnx-eyebrow">{{ t('Act on now','现在行动') }}</div>
        {# BUY ZONE: action-board buy_now + buy_soon (not macro-quad preferred list) #}
        {% set _dlg_buy = ((actions.buy_now if actions and actions.buy_now else []) + (actions.buy_soon if actions and actions.buy_soon else [])) %}
        {% if _dlg_buy %}
        <div class="cnx-lbl" style="margin-top:2px">{{ t('Buy zone','买入区') }}</div>
        <div class="cnx-chips">{% for x in _dlg_buy %}{%- set _sc = (sectors_by_ticker.get(x.ticker) if sectors_by_ticker is defined else none) -%}<span class="cnx-chip turn">{{ td(x.name) }}{% if _sc and _sc.rank %} · <span style="opacity:.6">#{{ _sc.rank }}</span>{% endif %}</span>{% endfor %}</div>
        {% endif %}
        {# AVOID: action-board avoid list #}
        {% set _dlg_avoid = (actions.avoid if actions and actions.avoid else []) %}
        {% if _dlg_avoid %}
        <div class="cnx-lbl">{{ t('Avoid','回避') }}</div>
        <div class="cnx-chips">{% for x in _dlg_avoid %}{%- set _sc = (sectors_by_ticker.get(x.ticker) if sectors_by_ticker is defined else none) -%}<span class="cnx-chip">{{ td(x.name) }}{% if _sc and _sc.rank %} · <span style="opacity:.6">#{{ _sc.rank }}</span>{% endif %}</span>{% endfor %}</div>
        {% endif %}
        {# Leaders — hot names already in uptrend, don't chase #}
        {% if pb_obj.leaders %}
        <div class="cnx-lbl">{{ t('Leaders','领先') }}</div>
        <div class="cnx-chips">{% for x in pb_obj.leaders %}<span class="cnx-chip hot">{{ td(x.name) }}</span>{% endfor %}</div>
        {% endif %}
        {% endif %}
        <div class="cnx-sep"></div>
        <div class="cnx-eyebrow">{{ t('Rotation vs CSI 300','相对沪深300轮动') }}</div>
        {% if sectors %}
        <table class="cnx-mt">
          {# plain label (s.label), real state-driven color, OB chip driver field #}
          <tr><th>{{ t('Sector','板块') }}</th><th class="r">{{ t('Rank','排名') }}</th><th class="r">5d</th><th class="r">20d</th><th class="r">60d</th><th class="r">{{ t('Trend','趋势') }}</th><th class="r">{{ t('Read','判断') }}</th></tr>
          {% for s in sectors[:10] %}
          {# color on s.dir (up/down/caution) which is always populated and maps to real states #}
          {% set _row_class = 'cnx-tt-dn' if s.dir == 'down' else ('cnx-tt-fl' if s.dir == 'caution' else ('cnx-tt-up' if s.dir == 'up' else '')) %}
          <tr>
            <td>{{ td(s.name) }}</td>
            <td class="r">{{ loop.index }}</td>
            <td class="r {{ 'cnx-tt-up' if (s.mom5 or 0) > 0 else ('cnx-tt-dn' if (s.mom5 or 0) < 0 else '') }}">{{ '%+.1f'|format(s.mom5) if s.mom5 is not none else '—' }}%</td>
            <td class="r {{ 'cnx-tt-up' if (s.mom20 or 0) >= 0 else 'cnx-tt-dn' }}">{{ '%+.1f'|format(s.mom20) if s.mom20 is not none else '—' }}%</td>
            <td class="r {{ 'cnx-tt-up' if (s.mom60 or 0) >= 0 else 'cnx-tt-dn' }}">{{ '%+.1f'|format(s.mom60) if s.mom60 is not none else '—' }}%</td>
            <td class="r">{{ '▲' if s.dir == 'up' else ('▼' if s.dir == 'down' else '▶') }}</td>
            {# render s.label (plain display word), NOT s.state (raw internal key) #}
            {# append OB chip when overbought score >= 0.5 #}
            <td class="r {{ _row_class }}">{{ t(s.label or '', s.label_zh or (s.label or '')) }}{% if (s.ob or 0) >= 0.5 %} <span style="font-size:10px;opacity:.75;background:var(--warn);color:#000;padding:1px 4px;border-radius:3px;vertical-align:middle">{{ t('OB','超买') }}</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </table>
        {% endif %}
        <div class="cnx-sep"></div>
        <div class="cnx-cols2">
          <div>
            <div class="cnx-eyebrow">{{ t('Breadth — is the move broad?','宽度 — 行情是否广泛？') }}</div>
            {% if breadth %}
            <div class="cnx-kv"><span class="k">{{ t('Above 50-day','50日上方') }}</span><span class="v">{{ breadth.pct_above_50 }}%</span></div>
            <div class="cnx-kv"><span class="k">{{ t('Above 200-day','200日上方') }}</span><span class="v">{{ breadth.pct_above_200 }}%</span></div>
            <div class="cnx-kv"><span class="k">{{ t('Advancers vs decliners','涨跌家数') }}</span><span class="v"><span class="cnx-tt-up">{{ breadth.adv }}</span> / <span class="cnx-tt-dn">{{ breadth.dec }}</span></span></div>
            <div class="cnx-kv"><span class="k">{{ t('New highs − lows','新高-新低') }}</span><span class="v">{{ breadth.net_nh }}</span></div>
            {% endif %}
          </div>
          <div>
            <div class="cnx-eyebrow">{{ t('Key ratios','关键比价') }}</div>
            {% if pair %}
            {% if pair.cyc_def %}<div class="cnx-kv"><span class="k">{{ t('Large vs mid','大盘 vs 中盘') }}</span><span class="v">{{ '%+.1f'|format(pair.cyc_def.chg_20d_pct) }}%</span></div>{% endif %}
            {% if pair.smallcap_largecap %}<div class="cnx-kv"><span class="k">{{ t('Small vs large','小盘 vs 大盘') }}</span><span class="v {{ 'cnx-tt-up' if pair.smallcap_largecap.chg_20d_pct >= 0 else 'cnx-tt-dn' }}">{{ '%+.1f'|format(pair.smallcap_largecap.chg_20d_pct) }}%</span></div>{% endif %}
            {% endif %}
          </div>
        </div>
        <div class="cnx-receipt">{{ t('Ranked by the fast 5–10 day turn vs CSI 300, with the 20-day trend and overbought as guards.','按相对沪深300的5–10日快速转向排序，20日趋势与超买作为约束。') }}</div>
      </div>
    </div>
  </div>

  <!-- Policy dialog -->
  <div class="cnx-dlg" id="cnx-dlg-policy">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title">{{ t('Policy & Credit — PBoC, Impulse & Tape','政策与信贷 — 央行、脉冲与盘面') }}</span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        <div class="cnx-cols2">
          <div>
            <div class="cnx-eyebrow">{{ t('PBoC policy — reserve ratio','央行政策 — 存准率') }}</div>
            {% if I.pboc %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 8px">
              <span class="cnx-bignum">{{ I.pboc.rrr_big }}%</span>
              {% set _pboc_clr = 'var(--up)' if I.pboc.bias == 'easing' else ('var(--warn)' if I.pboc.bias == 'tightening' else 'var(--muted)') %}
              {% set _pboc_bg = 'rgba(69,184,115,.14)' if I.pboc.bias == 'easing' else ('rgba(224,160,48,.14)' if I.pboc.bias == 'tightening' else 'rgba(128,128,128,.10)') %}
              <span class="cnx-alert-pill" style="background:{{ _pboc_bg }};color:{{ _pboc_clr }};margin:0">{{ t(I.pboc.bias, {'easing':'宽松','neutral':'中性','tightening':'收紧'}.get(I.pboc.bias,'')) }}</span>
            </div>
            <table class="cnx-mt">
              <tr><th>{{ t('Date','日期') }}</th><th class="r">{{ t('Move','变动') }}</th><th class="r">{{ t('To','至') }}</th></tr>
              {% for e in (I.pboc.events or [])[:4] %}
              <tr><td>{{ e.date }}</td><td class="r {{ 'cnx-tt-up' if e.dir == 'cut' else 'cnx-tt-dn' }}">{{ t('cut','降') if e.dir == 'cut' else t('hike','升') }}{% if e.change is not none and e.change is defined %} {{ '%.2f'|format(e.change | abs) }}pp{% endif %}</td><td class="r">{{ e.level }}%</td></tr>
              {% endfor %}
            </table>
            {% endif %}
            {% if CN and CN.tone %}
            <div class="cnx-eyebrow" style="margin-top:14px">{{ t('Official tone','官方基调') }}</div>
            <div class="cnx-kv"><span class="k">{{ t('Band','区间') }}</span><span class="v"><span class="cnx-stword ok">{{ t(CN.tone.label_en, CN.tone.label_zh) }}</span></span></div>
            <div class="cnx-kv"><span class="k">{{ t('Trend','趋势') }}</span><span class="v">{{ t('firming','走强') if (CN.tone.z or 0) > 0 else t('easing','趋弱') }}</span></div>
            {% endif %}
          </div>
          <div>
            <div class="cnx-eyebrow">{{ t('Credit impulse & macro tape','信贷脉冲与宏观盘面') }}</div>
            {% if I.credit %}
            {% if I.credit.credit_impulse is not none and I.credit.credit_impulse is defined %}
            <div class="cnx-kv"><span class="k">{{ t('Credit impulse','信贷脉冲') }}</span><span class="v"><span class="cnx-stword {{ 'ok' if I.credit.credit_impulse >= 0 else 'bad' }}">{{ '%+.1f'|format(I.credit.credit_impulse) }}%</span></span></div>
            {% endif %}
            {% if I.credit.impulse_html %}<div class="chart">{{ I.credit.impulse_html | safe }}</div>{% endif %}
            <div class="cnx-kv"><span class="k">{{ t('M1−M2 scissors','M1−M2剪刀差') }}</span><span class="v"><span class="cnx-stword {{ 'ok' if (I.credit.scissors or 0) >= 0 else 'bad' }}">{{ '%+.1f'|format(I.credit.scissors) if I.credit.scissors is defined else '—' }}pp</span></span></div>
            {% if I.credit.scissors_html %}<div class="chart">{{ I.credit.scissors_html | safe }}</div>{% endif %}
            {% if I.credit.tape %}<div class="cnx-kv"><span class="k">{{ t('Macro tape','宏观盘面') }}</span><span class="v">{% for tp in I.credit.tape %}<span class="{{ 'cnx-tt-up' if tp.val >= 0 else 'cnx-tt-dn' }}">{{ t(tp.en, tp.zh) }} {{ '%+.1f'|format(tp.val) }}%</span>{% if not loop.last %} · {% endif %}{% endfor %}</span></div>{% endif %}
            {% endif %}
            {# Leverage build from cn_participation_json #}
            {% if cn_participation_json and cn_participation_json.margin_to_mcap is defined and cn_participation_json.margin_to_mcap is not none %}
            <div class="cnx-kv"><span class="k">{{ t('Margin / market cap','融资余额 / 市值') }}</span><span class="v">{{ '%.2f'|format(cn_participation_json.margin_to_mcap) }}%{% if cn_participation_json.margin_chg_5d is defined and cn_participation_json.margin_chg_5d is not none %} · <span class="{{ 'cnx-tt-up' if cn_participation_json.margin_chg_5d > 0 else ('cnx-tt-dn' if cn_participation_json.margin_chg_5d < 0 else '') }}">5d {{ '%+.2f'|format(cn_participation_json.margin_chg_5d) }}%</span>{% endif %}</span></div>
            {% endif %}
          </div>
        </div>
        <div class="cnx-receipt">{{ t('Credit-impulse direction is one of the two reads that historically led this market.','信贷脉冲方向是历史上领先该市场的两个读数之一。') }}</div>
      </div>
    </div>
  </div>

  <!-- Connect Flows dialog -->
  <div class="cnx-dlg" id="cnx-dlg-flows">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title">{{ t('Connect Flows — Southbound & Smart Money','互联通资金 — 南向与聪明钱') }}</span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        <div class="cnx-cols2">
          <div>
            <div class="cnx-eyebrow">{{ t('Southbound flow · mainland → Hong Kong','南向资金 · 内地 → 香港') }}</div>
            {% if I.southbound %}
            <div style="display:flex;gap:12px;align-items:baseline;margin:2px 0 8px">
              <span class="cnx-bignum" style="color:{{ 'var(--up)' if I.southbound.net >= 0 else 'var(--down)' }}">{{ '+¥' if I.southbound.net >= 0 else '−¥' }}{{ '{:,.0f}'.format((I.southbound.net | abs) / 100) }}亿</span>
            </div>
