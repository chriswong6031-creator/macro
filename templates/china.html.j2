      'mcap':             _fr.get('mcap'),
      'cap_bucket':       _fr.get('cap_bucket'),
      'days_since_signal': _fr.get('days_since_signal'),
      'washout_2w':       true,
      'macd_hist_d':      _fr.get('macd_hist_d'),
      'macd_d2':          none,
      'macd_d3':          none,
      'imminence':        _fr.get('imminence'),
      'w2_stoch':         _fr.get('w2_stoch'),
      'w2_stoch_arrow':   _fr.get('w2_stoch_arrow'),
      'ret_5d':           _fr.get('ret_5d'),
      'theme':            _fr_narr.get('theme') or '',
      'theme_zh':         _fr_narr.get('theme_zh') or '',
      'basket_id':        _fr_narr.get('basket_id') or '',
      'narrative':        _fr_narr,
      'alpha':            none,
      'coiled':           false,
    } %}
    {% set _ = _st_fall_rows.append(_fr_row) %}
  {% endfor %}
  {% set _st_ran_rows = [] %}
  {% for _ranr in (setups.get('ran') or []) %}
    {% set _ran_row = {
      'ticker':           _ranr.get('ticker',''),
      'name':             _ranr.get('name',''),
      'sector':           _ranr.get('sector',''),
      'stage':            'RAN_LATE',
      '_stage':           'RAN_LATE',
      'zone':             none,
      'tier':             '',
      'price':            none,
      'off_high':         none,
      'spot_pct_in_range': none,
      'conviction':       none,
      'mcap':             _ranr.get('mcap'),
      'cap_bucket':       _ranr.get('cap_bucket'),
      'days_since_signal': _ranr.get('days_since_signal'),
      'washout_2w':       false,
      'macd_hist_d':      none,
      'macd_d2':          none,
      'macd_d3':          none,
      'imminence':        none,
      'w2_stoch':         none,
      'w2_stoch_arrow':   none,
      'ret_5d':           none,
      'theme':            '',
      'theme_zh':         '',
      'basket_id':        '',
      'narrative':        {},
      'alpha':            none,
      'coiled':           false,
    } %}
    {% set _ = _st_ran_rows.append(_ran_row) %}
  {% endfor %}
  <script type="application/json" id="stocktable-data">
  {
    "rows": {{ (_st_buy_rows + _st_rip_rows + _st_fall_rows + _st_ran_rows) | tojson }},
    "as_of": {{ (setups.as_of or '') | tojson }},
    "cap_composition": {{ (setups.get('cap_composition') or {}) | tojson }}
  }
  </script>
  <div class="panel span12" id="standouts">
    <h2>{{ t('⚡ Standout individual stocks', '⚡ 表现突出的个股') }}
      {{ help("How to read this board. Each card is an A-share name that sold off hard, settled, and just turned back up (the system grades that washout → base → fresh-turn sequence, T1–T4). Score 0–100 = buy-readiness: how ready it looks to buy, not a win-rate or a guarantee. Rank puts the cleanest setups first. Two gauges show setup quality and entry timing (buy now vs wait for a pullback). It is a research shortlist, not a buy list — and its track record is still accruing.", "如何看这个榜单。每张卡片都是一只大幅回调、企稳后刚刚回升的A股（系统按 洗盘→筑底→新转向 顺序分级，T1–T4）。评分0–100＝买入就绪度：该股离买点有多近，并非胜率或保证。排序把形态最干净的排在前面。两个量表显示形态质量与入场时机（现在买还是等回调）。这是研究备选清单，而非买入清单——其成绩仍在累积。") }}
      {# W8-E: grid/table view toggle #}
      <span class="st-view-toggle" id="st-view-toggle" role="group" data-tip-en="Switch between grid and table view" data-tip-zh="切换卡片视图与表格视图">
        <button id="st-btn-grid" aria-selected="true" onclick="StockTable._setView('grid')">⊞ <span class="l-en">Grid</span><span class="l-zh">卡片</span></button>
        <button id="st-btn-table" aria-selected="false" onclick="StockTable._setView('table')">☰ <span class="l-en">Table</span><span class="l-zh">表格</span></button>
      </span>
    </h2>
    {# W0.7 DATA OUTAGE BANNER — rendered when the board-width guard stamps data_outage.flag=true
       (buy-count dropped >40% day-over-day). Never rendered on a normal board. Dual-span i18n. #}
    {% set _do = setups.get('data_outage') %}
    {% if _do and _do.get('flag') %}
    <div style="margin:6px 0 10px;padding:9px 13px;border-radius:9px;font-size:12px;line-height:1.5;border:1.5px solid var(--down);background:color-mix(in srgb,var(--down) 10%,var(--panel));color:var(--down)">
      ⚠ <b><span class="l-en">data coverage degraded — board incomplete today</span><span class="l-zh">数据覆盖下降 — 今日看板不完整</span></b>
      <span class="muted" style="font-size:10.5px;display:block;margin-top:2px"><span class="l-en">{{ _do.get('reason','') }}</span><span class="l-zh">买入数量从 {{ _do.get('prev_n') }} 降至 {{ _do.get('new_n') }}（下降 {{ _do.get('drop_pct') }}%），超过40%阈值。可能原因：数据缺口/采集中断。本看板不完整，请谨慎参考。</span></span>
    </div>
    {% endif %}
    {# ── W8-E: count chips row (live-updated by JS when in table mode) ── #}
    <div id="st-count-chips" style="display:none"></div>

    {# ── W8-E: table view mount point ─────────────────────────────────── #}
    <div id="stocktable-wrap"></div>

    {# ── W8-E: grid section (hidden in table mode by CSS .nb-grid-section) ── #}
    <div class="nb-grid-section">
    {# ── W1-C: ENTRY SHELF ────────────────────────────────────────────────────
       Only ENTRY cards may use BUY-family language. Stage badge is the loudest element.
       Preserves existing blend_sorted order unchanged (F3 discipline). #}
    {% set _entry_rows = setups.buy | selectattr('stage', 'equalto', 'ENTRY') | list %}
    {% set _ran_late_rows = setups.buy | selectattr('stage', 'equalto', 'RAN_LATE') | list %}
    {# Backward compat: if no rows were partitioned (pre-W1 artifact where 'stage' key absent or all None),
       fall back to showing all buy rows on the ENTRY shelf so the board degrades gracefully. #}
    {% if (_entry_rows | length == 0) and (_ran_late_rows | length == 0) and (setups.buy | length > 0) %}
      {% set _entry_rows = setups.buy %}
    {% endif %}
    <div class="nbgrid" data-showmore-rows="3">
    {% for n in _entry_rows %}
      {% set _d = n.dir or 'caution' %}
      <a class="nbcard nb-{{ _d }}" href="china_lookup.html#{{ n.ticker }}">
        {# ── IDENTITY ZONE ─────────────────────────────────────────────────── #}
        <div class="nb-id">
          {# row 0: stage badge (loudest element) + gate badge + why_ranked chip #}
          <div class="nb-badges">
            <span class="nb-stage stg-entry"><span class="l-en">ENTRY</span><span class="l-zh">入场</span></span>
            {% with sig = n.signal %}{% include "_sig_badge.html.j2" %}{% endwith %}
            {% if n.get('why_ranked') and not (n.washout_2w and n.get('why_ranked') == '2W-washout') %}<span class="nb-why" data-tip-en="Why it ranks here: {{ n.get('why_ranked','') }}" data-tip-zh="此处排序原因：{{ n.get('why_ranked','') }}">{{ n.get('why_ranked') }}</span>{% endif %}
          </div>
          {# row 1: ticker + price #}
          <div class="nb-tkrow">
            <span class="nb-tk">{{ n.ticker }}</span>
            {% if n.price is not none %}<span class="nb-px" data-sym="{{ n.ticker }}" data-mkt="cn">{{ '%.2f'|format(n.price) }}</span>{% endif %}
          </div>
          {# row 2: full name — own full-width line #}
          <div class="nb-nm">{{ nm(n.name) }}</div>
          {# row 3: sector left + off-52w-high right #}
          <div class="nb-secrow">
            <span class="nb-sec">{{ t(n.sector, SECZH.get(n.sector, n.sector)) }}</span>
            {% if n.off_high is not none %}<span class="nb-offh">{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}
          </div>
        </div>
        {# ── ACTION ZONE ─────────────────────────────────────────────────────── #}
        <div class="nb-act">
          {% if n.spark_svg %}{{ n.spark_svg | safe }}{% endif %}
          {% set c = n.conviction %}
          {% set es = n.entry_signal %}
          {% if c %}
          {# Fused READY-score + verdict + entry-gauge block #}
          <div class="nb-conv">
            <div class="nb-conv-top">
              {% if c.score is not none %}<span class="nb-cscore band-{{ c.band }}" data-tip-en="Buy-readiness 0–100 — how ready it looks to buy, not a win-rate." data-tip-zh="买入就绪度0–100——看起来离买点有多近，并非胜率。"><span class="nb-crank">{{ t('ready','就绪') }}</span>{{ c.score }}</span>{% endif %}
              <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
            </div>
            {% if es %}
            {# ENTRY-timing gauge: buy now / wait for the pullback / extended, with the
               actual buy-zone price + cycle position. Market-agnostic (reads the cycle/ladder + vol). #}
            <div class="nb-entry nbe-{{ es.status }}" data-tip-en="Entry timing — when and at what price to buy. {{ es.action }}" data-tip-zh="入场时机——何时、以何价买入。{{ es.action_zh or es.action }}">
              <div class="nbe-head">
                <span class="nbe-dot a{{ es.act_level }}"></span>
                <span class="nbe-status"><span class="l-en">{{ es.headline }}</span><span class="l-zh">{{ es.headline_zh }}</span></span>
              </div>
              {% if es.buy_zone and es.buy_zone.high is not none %}
              <div class="nbe-zone">
                <span class="nbe-lbl">{{ t('Buy zone', '买入区') }}</span>
                <span class="nbe-px">{{ '%.2f'|format(es.buy_zone.low) }}{% if es.buy_zone.high != es.buy_zone.low %}–{{ '%.2f'|format(es.buy_zone.high) }}{% endif %}</span>
                {% if es.buy_zone.pct_from_spot is not none %}<span class="nbe-pct">{{ '%+.1f'|format(es.buy_zone.pct_from_spot) }}%</span>{% endif %}
              </div>
              {% endif %}
              {% if es.cycle_pos and es.cycle_pos.dc_day is not none %}
              <div class="nbe-cyc">
                <span>{{ t('cycle day', '周期第') }} {{ es.cycle_pos.dc_day }}{{ t('', '天') }}/{{ es.cycle_pos.dc_band[0] }}–{{ es.cycle_pos.dc_band[1] }}</span>
                <span class="nbe-bar"><span class="nbe-bf" style="width:{{ [es.cycle_pos.pct_through or 0, 100]|min }}%"></span></span>
                {% if es.timing and es.timing.opens_in_days_lo is not none and es.status not in ['buy_now','partial'] %}<span>· {{ t('window', '窗口') }} ~{{ es.timing.opens_in_days_lo }}{% if es.timing.opens_in_days_hi and es.timing.opens_in_days_hi != es.timing.opens_in_days_lo %}–{{ es.timing.opens_in_days_hi }}{% endif %}d</span>{% endif %}
              </div>
              {% endif %}
            </div>
            {% endif %}
          </div>
          {% endif %}
        </div>
        {# ── CONTEXT STRIP ─────────────────────────────────────────────────── #}
        <div class="nb-ctx">
          <span class="nb-state">{{ td(n.label or n.state) }}</span>
          {# condition chips #}
          {% if n.washout_2w %}<span class="nb-washout" data-tip-en="Washed out on the 2-week chart and turning back up — usually a more durable bottom than a daily bounce." data-tip-zh="2周线已洗盘并回升——通常比日线反弹更稳的底部。"><span class="l-en">🌊 2W washout</span><span class="l-zh">🌊 2周洗盘</span></span>{% endif %}
          {% if n.get('coiled') and n.get('coiled').get('coiled') %}{% set _cf = n.get('coiled').get('fire') %}<span class="nb-coiled{% if _cf %} fire{% elif n.get('coiled').get('star') %} star{% endif %}" data-tip-en="Volatility squeezed tight — a big move is loading." data-tip-zh="波动被极度压缩——大行情正在酝酿。"><span class="l-en">{% if _cf %}⚡ Coiled·FIRE{% else %}⚡ Coiled{% endif %}{% if n.get('coiled').get('star') %} ★{% endif %}</span><span class="l-zh">{% if _cf %}⚡ 蓄势·触发{% else %}⚡ 蓄势{% endif %}{% if n.get('coiled').get('star') %} ★{% endif %}</span></span>{% endif %}
          {% if n.extension and n.extension.extended %}<span class="nb-ext" data-tip-en="Already run up a lot — higher chase risk, so it is ranked lower." data-tip-zh="已经大涨——追高风险较大，故排名靠后。">⚠ <span class="l-en">extended</span><span class="l-zh">已大涨</span></span>{% endif %}
          {# microstructure chips (limit_state / chase_veto) — CN-SYS-R3 #}
          {% set _mpkt = cn_micro_by_ticker.get(n.ticker) if cn_micro_by_ticker else none %}
          {% if _mpkt %}
            {% set _ls = _mpkt.get('limit_state') %}
            {% set _cv = (_mpkt.get('chase_veto') or {}) %}
            {% if _ls and _ls != 'open' %}<span style="font-size:8px;font-weight:800;padding:1px 5px;border-radius:6px;white-space:nowrap;background:color-mix(in srgb,var(--warn) 14%,transparent);color:var(--warn);border:1px solid color-mix(in srgb,var(--warn) 35%,transparent)" data-tip-en="Microstructure: limit state={{ _ls }}. Context only — CN-SYS-R3." data-tip-zh="市场结构：涨跌停状态={{ _ls }}。仅供参考 — CN-SYS-R3。"><span class="l-en">{{ _ls }}</span><span class="l-zh">{{ _ls }}</span></span>{% endif %}
            {# CN-SYS-R3: chase-veto ZH tooltip uses generic Chinese reason #}
            {% if _cv.get('flag') %}<span style="font-size:8px;font-weight:800;padding:1px 5px;border-radius:6px;white-space:nowrap;background:color-mix(in srgb,var(--down) 13%,transparent);color:var(--down);border:1px solid color-mix(in srgb,var(--down) 30%,transparent)" data-tip-en="Chase veto: {{ _cv.get('reason') or 'limit-up context (CN-SYS-R3)' }}" data-tip-zh="追涨否决：近期涨幅过大（追高风险）— CN-SYS-R3"><span class="l-en">chase ⚑</span><span class="l-zh">追涨 ⚑</span></span>{% endif %}
          {% endif %}
          {# caution popover #}
          {% set c = n.conviction %}
          {% if c and c.cautions %}<div class="nb-cau"><button class="nb-cau-btn" type="button" aria-label="Caution notes ({{ c.cautions|length }})"><span class="l-en">⚠ Caution</span><span class="l-zh">⚠ 注意</span><span class="nb-cau-badge">{{ c.cautions|length }}</span></button><div class="nb-cau-pop" role="tooltip">{% for cau in c.cautions %}<span class="cau-row"><span class="l-en">{{ cau }}</span><span class="l-zh">{{ c.cautions_zh[loop.index0] if (c.cautions_zh and c.cautions_zh|length > loop.index0) else cau }}</span></span>{% endfor %}</div></div>{% endif %}
          {# freshness: signal as-of pushed to the right #}
          {% set _sig_asof = (n.signal or {}).get('asof') %}
          {% if _sig_asof and setups.as_of and _sig_asof < setups.as_of %}<span class="nb-asof" data-tip-en="This signal is from {{ _sig_asof }}, a bar or two behind today's board (the 3-day bucket was not complete yet). Prices are current." data-tip-zh="该信号基于 {{ _sig_asof }}，比看板日期早一两个交易日（3日周期桶尚未收盘）。价格为最新。"><span class="l-en">signal as of {{ _sig_asof }}</span><span class="l-zh">信号截至 {{ _sig_asof }}</span></span>{% endif %}
        </div>
      </a>
    {% endfor %}
    </div>

    {# ── W1-C: RAN / LATE SHELF (buy rows — rule 2) ──────────────────────────
       These are gate-eligible names whose entry_signal says hold/extended/topping.
       Signal is live but entry timing has passed. No BUY-family language.
       Score is muted (opacity:0.45 via nb-stage-ran-card). #}
    {% if _ran_late_rows %}
    <div class="nb-shelf-hdr" style="margin-top:16px">
      <span class="nb-shelf-tag st-ran"><span class="l-en">RAN / LATE</span><span class="l-zh">信号已过</span></span>
      <span class="nb-shelf-expl"><span class="l-en">signal live — entry passed; wait for pullback. Shown for honesty, not action — do not chase.</span><span class="l-zh">信号有效但入场时机已过；等待回调。出于诚实展示 — 不要追涨。</span></span>
    </div>
    <div class="nbgrid" data-showmore-rows="1">
    {% for n in _ran_late_rows %}
      {% set _d = 'caution' %}
      <a class="nbcard nb-{{ _d }} nb-stage-ran-card" href="china_lookup.html#{{ n.ticker }}">
        {# ── IDENTITY ZONE (RAN) ──────────────────────────────────────────── #}
        <div class="nb-id">
          {# row 0: stage badge (muted RAN) + gate badge (muted via CSS) #}
          <div class="nb-badges">
            <span class="nb-stage stg-ran"><span class="l-en">RAN / LATE</span><span class="l-zh">信号已过</span></span>
            {% with sig = n.signal %}{% include "_sig_badge.html.j2" %}{% endwith %}
          </div>
          {# row 1: ticker + price #}
          <div class="nb-tkrow">
            <span class="nb-tk">{{ n.ticker }}</span>
            {% if n.price is not none %}<span class="nb-px" data-sym="{{ n.ticker }}" data-mkt="cn">{{ '%.2f'|format(n.price) }}</span>{% endif %}
          </div>
          {# row 2: full name — own full-width line #}
          <div class="nb-nm">{{ nm(n.name) }}</div>
          {# row 3: sector + off-high #}
          <div class="nb-secrow">
            <span class="nb-sec">{{ t(n.sector, SECZH.get(n.sector, n.sector)) }}</span>
            {% if n.off_high is not none %}<span class="nb-offh">{{ '%+.1f'|format(n.off_high) }}% {{ t('off 52w high', '距52周高') }}</span>{% endif %}
          </div>
        </div>
        {# Prominent honesty sublabel — DIRECTLY under identity zone (W1-C rule 2) #}
        {% set _sl = n.get('stage_sublabel') %}
        {% if _sl %}
        <div class="nb-ran-detail"><span class="l-en">{{ _sl }}</span><span class="l-zh">{{ n.get('stage_sublabel_zh') or '信号有效但入场时机已过；等待回调' }}</span></div>
        {% endif %}
        {# ── ACTION ZONE (RAN) ────────────────────────────────────────────── #}
        <div class="nb-act">
          {% if n.spark_svg %}{{ n.spark_svg | safe }}{% endif %}
          {% set c = n.conviction %}
          {% set es = n.entry_signal %}
          {% if c %}
          <div class="nb-conv">
            <div class="nb-conv-top">
              {% if c.score is not none %}<span class="nb-cscore band-{{ c.band }}" data-tip-en="Score muted — this name is on the RAN/LATE shelf: entry timing passed." data-tip-zh="评分已淡化 — 此股处于信号已过板块，入场时机已过。"><span class="nb-crank">{{ t('ready','就绪') }}</span>{{ c.score }}</span>{% endif %}
              <span class="nb-verdict"><span class="l-en">{{ c.verdict }}</span><span class="l-zh">{{ c.verdict_zh }}</span></span>
            </div>
            {% if es %}
            {% if n.get('muted_entry') %}
            {# F6 adjudicated design: entry gauge was open (buy_now/partial) but name is overextended.
               Extension beats the timing gauge — render a neutral muted line, no green class, no Buy-now.
               Dual-span per i18n rules. #}
            <div class="nb-entry nbe-wait_pullback" data-tip-en="Entry gauge open but name is extended — not actionable here. Wait for pullback." data-tip-zh="入场量表打开但股票已延伸 — 当前不可操作，等待回调。">
              <div class="nbe-head">
                <span class="nbe-dot a1"></span>
                <span class="nbe-status"><span class="l-en">gauge open — but extended; not actionable</span><span class="l-zh">量表打开 — 但已延伸；当前不可操作</span></span>
              </div>
            </div>
            {% else %}
            <div class="nb-entry nbe-{{ es.status }}" data-tip-en="Entry timing — {{ es.action }}" data-tip-zh="入场时机——{{ es.action_zh or es.action }}">
              <div class="nbe-head">
                <span class="nbe-dot a{{ es.act_level }}"></span>
                <span class="nbe-status"><span class="l-en">{{ es.headline }}</span><span class="l-zh">{{ es.headline_zh }}</span></span>
              </div>
            </div>
            {% endif %}
            {% endif %}
          </div>
          {% endif %}
        </div>
        {# ── CONTEXT STRIP (RAN) ──────────────────────────────────────────── #}
        <div class="nb-ctx">
          <span class="nb-state">{{ td(n.label or n.state) }}</span>
          {% if n.washout_2w %}<span class="nb-washout"><span class="l-en">🌊 2W washout</span><span class="l-zh">🌊 2周洗盘</span></span>{% endif %}
          {% if n.get('coiled') and n.get('coiled').get('coiled') %}{% set _cf = n.get('coiled').get('fire') %}<span class="nb-coiled{% if _cf %} fire{% elif n.get('coiled').get('star') %} star{% endif %}"><span class="l-en">{% if _cf %}⚡ Coiled·FIRE{% else %}⚡ Coiled{% endif %}</span><span class="l-zh">{% if _cf %}⚡ 蓄势·触发{% else %}⚡ 蓄势{% endif %}</span></span>{% endif %}
          {% if n.extension and n.extension.extended %}<span class="nb-ext">⚠ <span class="l-en">extended</span><span class="l-zh">已大涨</span></span>{% endif %}
        </div>
      </a>
    {% endfor %}
    </div>
    {% endif %}

    {# ── W8-R1: RIPENING SHELF (three-zone lifecycle: READY / BASING / FALLING sink) ─
       Full scorecards for READY + BASING; collapsed knife-sink for FALLING.
       NOT entry signals. No BUY-family language anywhere. #}
    {% set _rip = setups.get('ripening') or [] %}
    {# ── W8-R1: RIPENING three-zone shelf (READY / BASING / FALLING sink) ────────────
       Full scorecards for READY + BASING; collapsed knife-sink for FALLING.
       NOT an entry signal. No BUY-family words. W8-R1/R2. #}
    {% set _rip_ready  = (_rip | selectattr('zone','equalto','READY')  | list) if _rip else [] %}
    {% set _rip_basing = (_rip | selectattr('zone','equalto','BASING') | list) if _rip else [] %}
    {% set _rip_fall   = setups.get('ripening_falling') or [] %}
    {% if _rip or _rip_fall %}
    <div class="rip-shelf" style="margin-top:16px">
      {# ── Shelf header ──────────────────────────────────────────────── #}
      <div class="rip-shelf-hdr">
        <span class="rip-shelf-title"><span class="l-en">RIPENING SHELF</span><span class="l-zh">筑底观察区</span></span>
        <span class="rip-shelf-sub"><span class="l-en">setup forming — NOT an entry signal</span><span class="l-zh">形态形成中 — 非入场信号</span></span>
        {% if setups.get('as_of') %}<span class="rip-shelf-asof"><span class="l-en">as of {{ setups.get('as_of','') }}</span><span class="l-zh">截至 {{ setups.get('as_of','') }}</span></span>{% endif %}
      </div>

      {# ── ZONE 1: READY — confluence forming, nearest to entry ─────────────── #}
