<div class="grid">

  {% if mode == 'stocks' %}
  <!-- ===================== A-SHARE STOCK DASHBOARD HEADER ===================== -->
  <div class="panel span12" id="stocks-header">
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <h1 style="margin:0">🇨🇳 {{ t('A-Share Stock Dashboard', 'A股个股看板') }}</h1>
      <span class="quad-badge quad-{{ latest.quad }}">{{ td(latest.quad_name) }}</span>
      {% if pb and pb.dial %}{% set pzh = {'DEFENSIVE':'防御','CAREFUL':'谨慎','NEUTRAL':'中性','CONSTRUCTIVE':'积极','AGGRESSIVE':'进取'} %}<span class="chip c-muted">{{ t(pb.dial.posture, pzh.get(pb.dial.posture, pb.dial.posture)) }}</span>{% endif %}
    </div>
    <p class="note" style="margin:8px 0 0;text-transform:none">{{ t('Where to look for A-shares — the validated mean-reversion setups, sector relative strength and residual-alpha context, filtered by the current macro regime.', '在哪里找 A 股 —— 已验证的均值回归形态、板块相对强度与残差阿尔法背景，按当前宏观周期过滤。') }}
      <a href="china.html" style="color:var(--link);font-weight:600">← {{ t('China macro dashboard', '中国宏观看板') }}</a></p>
  </div>
  {% endif %}

  {% if mode != 'stocks' %}
  <!-- ===================== MACRO REGIME DASHBOARD (compact scorecard) ===================== -->
  <div class="panel span12" id="regime-hero">
    <h1>{{ t('China A-Share Regime', '中国A股周期') }}</h1>
    <h2 style="margin-top:1px">{{ t('Macro Regime Dashboard', '宏观周期仪表盘') }} · {{ latest.date }}</h2>
    <div class="hero">
      <span class="quad-badge quad-{{ latest.quad }}">{{ td(latest.quad_name) }}</span>
      <div class="metric"><span class="v {{ 'pos' if latest.growth_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.growth_score) }}</span><span class="k">{{ t('Growth', '增长') }}</span></div>
      <div class="metric"><span class="v {{ 'pos' if latest.inflation_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.inflation_score) }}</span><span class="k">{{ t('Inflation', '通胀') }}</span></div>
      <div class="metric"><span class="v">{{ (latest.confidence*100)|round|int }}%</span><span class="k">{{ t('Confidence', '置信度') }}</span></div>
      <div class="metric"><span class="chip c-info">{{ t('PBoC', '央行') }} {{ td(latest.liquidity_overlay) }}</span><span class="k">{{ t('Liquidity', '流动性') }}</span></div>
      <div class="metric"><span class="chip c-muted">{{ td(latest.cycle_tag) }}</span><span class="k">{{ t('Cycle', '周期阶段') }}</span></div>
    </div>
    <div class="herogauges">
      <div><div class="hg-l"><span>{{ t('Growth', '增长') }} <span class="muted" style="font-weight:400">{{ t('falling ↔ rising', '下行 ↔ 上行') }}</span></span><span class="hv {{ 'pos' if latest.growth_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.growth_score) }}</span></div><div class="gauge"><i style="left:{{ ((latest.growth_score+1)/2*100)|round(1) }}%"></i></div></div>
      <div><div class="hg-l"><span>{{ t('Inflation', '通胀') }} <span class="muted" style="font-weight:400">{{ t('falling ↔ rising', '下行 ↔ 上行') }}</span></span><span class="hv {{ 'pos' if latest.inflation_score>=0 else 'neg' }}">{{ '%+.2f'|format(latest.inflation_score) }}</span></div><div class="gauge"><i style="left:{{ ((latest.inflation_score+1)/2*100)|round(1) }}%"></i></div></div>
    </div>
    {% if pb and pb.quad_meaning %}<p class="qmeaning">{{ t(pb.quad_meaning.en, pb.quad_meaning.zh) }}</p>{% endif %}
    {% if latest.pending_quad in ['Q1','Q2','Q3','Q4'] and latest.pending_days %}
    <p class="regwatch">⚠️ {{ t('Regime watch', '周期预警') }}: {{ t('evidence is building toward', '证据正在累积，指向') }}
      <b>{{ td({'Q1':'Goldilocks','Q2':'Reflation','Q3':'Stagflation','Q4':'Growth scare'}[latest.pending_quad]) }}</b>
      ({{ latest.pending_days }}{{ t(' day(s) so far; the label flips after 7)', ' 天；标签将在第 7 天翻转）') }}</p>
    {% endif %}
    {% if latest.confirming %}<p class="note" style="margin:10px 0 0">{{ t('Confirming', '确认') }}: {{ latest.confirming|join(', ') }}{% if latest.contradicting %} · {{ t('Contradicting', '矛盾') }}: {{ latest.contradicting|join(', ') }}{% endif %}</p>{% endif %}
  </div>

  <!-- ===================== FIRED ALERTS (today) ===================== -->
  {% set ALERTS = latest.alerts %}
  {% if ALERTS %}
  <div class="panel span12" id="china-fired-alerts">
    <h2>🚨 {{ t('Fired alerts (today)', '已触发警报（今日）') }}
      {{ help("Alerts fire only when something CHANGES — a confidence drop, a crossing, a sign flip, a fresh policy event — never just because a level is high. They're rare by design; read every one. Click any alert to jump to the panel it came from. All display-only — alerts are surfaced notifications, never scored into the regime.", "警报只在某物发生变化时触发 — 置信度下降、出现交叉、符号翻转、新的政策事件 — 绝不仅因某个水平偏高而触发。它们刻意设计得稀少；每一条都要读。点击任意警报可跳转到其来源面板。全部仅展示 —— 警报是提示，从不计入区制评分。") }}
    </h2>
    {% for a in ALERTS %}
      <a class="alert alert-{{ a.severity }}" {% if a.anchor %}href="#{{ a.anchor }}"{% endif %}>
        <div class="alert-head">
          <span class="alert-ico">{{ a.icon }}</span>
          <b><span class="l-en">{{ a.plain_en }}</span><span class="l-zh">{{ a.plain_zh }}</span></b>
          {% if a.anchor %}<span class="alert-jump">{{ t('View panel ↓', '查看面板 ↓') }}</span>{% endif %}
        </div>
        <div class="alert-detail"><span class="l-en">{{ a.message }}</span><span class="l-zh">{{ a.message_zh or a.message }}</span></div>
        {% if a.what_en %}<div class="alert-what"><span class="l-en">{{ a.what_en }}</span><span class="l-zh">{{ a.what_zh or a.what_en }}</span></div>{% endif %}
        {% if a.edge_en %}<div class="alert-edge"><b>{{ t('Conviction:', '可信度：') }}</b> <span class="l-en">{{ a.edge_en }}</span><span class="l-zh">{{ a.edge_zh or a.edge_en }}</span></div>{% endif %}
      </a>
    {% endfor %}
  </div>
  {% endif %}

  <!-- ===================== SIGNAL STACK — consolidated cross-subsystem read ===================== -->
  {% if signal_stack %}
  <div class="panel span12" id="signal-stack">
    <h2>{{ t('Signal stack — where the evidence agrees & disagrees', '信号堆栈 — 证据在何处一致、在何处分歧') }}
      {{ help("Don't ask 'is it bullish?' — ask 'which parts of the evidence disagree?'. This collapses the dashboard's subsystem reads into one stack: each leg's lean, the regime-core agreement, and the single biggest contradiction. It re-presents signals detailed below — it invents nothing and is never scored. SCORED legs drive the regime; CONTEXT legs are positioning colour only.", "不要问'是不是看多？'，而要问'证据的哪些部分相互矛盾？'。这把仪表盘各子系统读数汇聚为一个堆栈：每条腿的倾向、周期核心一致度，以及最大的那条矛盾。它只是对下方详述信号的再呈现 — 不创造新信号，也从不计入评分。已评分腿驱动周期；背景腿仅为仓位色彩。") }}
    </h2>
    <div class="sstack-grid">
      <div class="sstack-legs">
        {% for leg in signal_stack.legs %}
        <div class="sstack-leg">
          <span class="sstack-dot tone-{{ leg.tone }}"></span>
          <span class="sstack-name">{{ t(leg.label_en, leg.label_zh) }}{% if leg.tier == 'context' %}<span class="sstack-tier">{{ t('context', '背景') }}</span>{% endif %}</span>
          <span class="sstack-state tone-{{ leg.tone }}">{{ t(leg.state_en, leg.state_zh) }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="sstack-verdict">
        <div class="sstack-final tone-{{ signal_stack.anchor_tone }}">{{ t('Final', '结论') }}: <b>{{ t(signal_stack.final_en, signal_stack.final_zh) }}</b></div>
        {% if signal_stack.agreement_pct is not none %}
        <div class="sstack-agree">{{ t('Regime agreement', '周期一致度') }} <b>{{ signal_stack.agreement_pct }}%</b>{% if signal_stack.quality_en %} — {{ t(signal_stack.quality_en, signal_stack.quality_zh) }}{% endif %}</div>
        {% endif %}
        <div class="sstack-tally"><b class="tone-up">{{ signal_stack.n_bull }}</b> {{ t('constructive', '建设性') }} · <b>{{ signal_stack.n_flat }}</b> {{ t('neutral', '中性') }} · <b class="tone-down">{{ signal_stack.n_bear }}</b> {{ t('cautionary', '谨慎') }} {{ t('of', '／共') }} {{ signal_stack.n }}</div>
        {% if signal_stack.contradiction_en %}
        <div class="sstack-contra">⚠ {{ t('Main contradiction', '主要矛盾') }}: {{ t(signal_stack.contradiction_en, signal_stack.contradiction_zh) }}</div>
        {% else %}
        <div class="sstack-contra ok">✓ {{ t('Broad agreement — no leg is fighting the regime', '广泛一致 — 没有腿与周期相左') }}</div>
        {% endif %}
      </div>
    </div>
    <p class="note" style="margin:10px 0 0;text-transform:none;font-size:11px">{{ t('Display-only consolidation of the signals detailed below — it changes no score. The agreement % is the regime-core confidence; the legs are context.', '仅为下方详述信号的展示性汇总 — 不改变任何评分。一致度为周期核心置信度；各腿为背景。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== MAJOR CHINA INDEXES — HEALTH & RISK ===================== -->
  {% if index_health %}
  <div class="panel span12" id="index-health">
    <h2>{{ t('Major China index — health & risk', '中国主要指数 — 健康度与风险') }}
      {{ help("How the market itself is doing, before the macro engine. Price, % below the 52-week high (drawdown), trend vs the 50/200-day averages, and RSI(14) for the major mainland indexes. RSI &gt; 70 is stretched, &lt; 30 is washed out.", "在看宏观引擎之前，先看市场本身。各主要内地指数的价格、距52周高点的回撤、相对50/200日均线的趋势、RSI(14)。RSI &gt; 70 偏热，&lt; 30 超卖。") }}
    </h2>
    <div class="idx-grid">
      {% for ix in index_health %}
      <div class="idx-tile">
        <div class="idx-top"><b>{{ t(ix.label, ix.label_zh) }}</b> <span class="idx-px">{{ '%.2f'|format(ix.price) }}</span></div>
        <div class="idx-row">
          <span class="{{ 'pos' if ix.dd >= -1 else ('warn' if ix.dd >= -10 else 'neg') }}">{{ '%+.1f'|format(ix.dd) }}% {{ t('off high', '距高点') }}</span>
          <span>RSI {{ ix.rsi if ix.rsi is not none else '—' }}</span>
        </div>
        <div class="idx-trend">
          <span class="{{ 'pos' if ix.above200 else 'neg' }}">{{ '✓' if ix.above200 else '✕' }} 200d</span>
          <span class="{{ 'pos' if ix.above50 else 'neg' }}">{{ '✓' if ix.above50 else '✕' }} 50d</span>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="idx-risk">
      {% set rc = latest.conditions.recession if latest.conditions else none %}
      {% set dr = latest.conditions.drawdown_risk if latest.conditions else none %}
      <div class="idx-gauge">
        <div class="idx-gk">{{ t('Slowdown risk', '放缓风险') }}</div>
        <div class="idx-gv {{ 'neg' if rc and rc.score>=60 else ('warn' if rc and rc.score>=40 else '') }}">{{ rc.score|round|int if rc and rc.score is not none else '—' }}<small>/100</small></div>
        <div class="muted" style="font-size:11px">{% if rc and rc.label %}{{ t(rc.label, {'low':'低','elevated':'偏高','high':'高'}.get(rc.label, rc.label)) }}{% endif %}</div>
      </div>
      <div class="idx-gauge">
        <div class="idx-gk">{{ t('Drawdown risk', '回撤风险') }}</div>
        <div class="idx-gv {{ 'neg' if dr and dr.score>=60 else ('warn' if dr and dr.score>=40 else '') }}">{{ dr.score|round|int if dr and dr.score is not none else '—' }}<small>/100</small></div>
        <div class="muted" style="font-size:11px">{% if dr and dr.band %}{{ t(dr.band, {'calm':'平静','low':'低','elevated':'偏高','high':'高','fragile':'脆弱'}.get(dr.band, dr.band)) }}{% endif %}</div>
      </div>
      {% if alloc_card and alloc_card.present %}
      <a class="idx-alloc" href="china_allocation.html">
        <div class="idx-gk">◎ {{ t('Income Vector allocation', '红利向量仓位') }} →</div>
        <div class="idx-gv" style="color:{{ '#1FA971' if alloc_card.band == 'low' else ('var(--warn)' if alloc_card.band == 'elevated' else 'var(--down)') }}">{{ alloc_card.growth_w }}%<small> {{ t('growth', '增长') }} / {{ alloc_card.defensive_w }}% {{ t('defensive', '防御') }}</small></div>
        <div class="muted" style="font-size:11px">{{ t(alloc_card.label_en, alloc_card.label_zh) }} · Sharpe {{ alloc_card.sharpe }} · MaxDD {{ alloc_card.maxdd }}%</div>
      </a>
      {% else %}
      <a class="idx-alloc" href="china_allocation.html">
        <div class="idx-gk">◎ {{ t('Allocation strategy', '仓位策略') }} →</div>
        <div class="muted" style="font-size:12px;margin-top:4px">{{ t('Income core + gold + bonds — a validated drawdown / Sharpe engine.', '红利核心 + 黄金 + 国债 — 经验证的回撤 / 夏普引擎。') }}</div>
      </a>
      {% endif %}
    </div>
    <p class="note" style="margin:10px 0 0;text-transform:none">{{ t('Looking for individual A-shares?', '想找个股？') }}
      <a href="china_stocks.html" style="color:var(--link);font-weight:600">→ {{ t('A-share stock dashboard', 'A股个股看板') }}</a></p>
  </div>
  {% endif %}

  <!-- ===================== MARKET SNAPSHOT (cross-asset tiles + benchmark cycle) ===================== -->
  {% if market_tiles or benchmark %}
  <div class="panel span12" id="market-snapshot">
    <h2>{{ t('Market snapshot', '市场快照') }}
      {{ help("The headline cross-asset levels in one glance — the mainland indexes, the offshore yuan, gold and the 10-year government bond yield — each with its 1-day move. A quick orientation; the read and the why live in the panels below.", "一眼看尽跨资产关键水平 — 内地指数、离岸人民币、黄金与10年期国债收益率 — 各附其单日变动。用于快速定位；解读与原因见下方面板。") }}
    </h2>
    {% if market_tiles %}
    <div class="mtiles">
      {% for tl in market_tiles %}
      <div class="mtile">
        <div class="mtile-top"><span class="mtile-lbl">{{ tl.label }}</span><span class="mtile-tag">{{ tl.tag }}</span></div>
        <div class="mtile-val">{{ tl.level }}</div>
        <div class="mtile-chg {{ tl.tone }}">{{ tl.chg }} ({{ tl.pct }})</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if benchmark %}
    <div style="margin-top:14px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <b>{{ td(benchmark.name) }}</b>
      <span style="font-size:18px;font-weight:800">{{ '%.2f'|format(benchmark.price) }}</span>
      <span class="{{ 'pos' if benchmark.chg>=0 else 'neg' }}" style="font-size:13px">{{ '%+.2f'|format(benchmark.chg) }}%</span>
      <span class="lad {{ 'up' if benchmark.dir=='up' else ('down' if benchmark.dir=='down' else 'flat') }}">{{ td(benchmark.label or benchmark.state) }}</span>
    </div>
    <div class="mtf" data-mtf='{{ benchmark.mtf_json }}'></div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ===================== REGIME TIME MACHINE ===================== -->
  {% if lifespan_rows %}
  <div class="panel span12" id="time-machine" data-timeline="china_regime_timeline.json">
    <h2>{{ t('⏳ Regime time machine', '⏳ 周期时光机') }}
      {{ help("Drag the playhead across ~20 years of A-share history and the readout rewinds the regime CORE to that day — quadrant, growth/inflation scores, agreement, PBoC liquidity and the business cycle. China’s engine doesn’t track transition/warning flags, so those stay blank. Hit ▶ to watch the quad ribbon flip at every major turn — 2008, the 2015 bubble, 2018, 2020.", "拖动播放头横扫约 20 年 A 股历史，下方读数会把周期核心回退到那一天 — 象限、增长／通胀分数、一致度、央行流动性与商业周期。中国引擎不追踪转换／预警旗，故此处留空。点击 ▶ 观看周期色带在每个重大转折处翻转 — 2008、2015 泡沫、2018、2020。") }}
    </h2>
    <div class="tm-wrap">
      <canvas id="tm-canvas" class="tm-canvas"></canvas>
      <input id="tm-range" class="tm-range" type="range" min="0" max="0" value="0" aria-label="Scrub regime history">
    </div>
    <div class="tm-controls">
      <button class="tm-btn tm-play" id="tm-play" aria-label="play/pause" title="Play / pause"><span class="tm-play-ico"></span></button>
      <span class="tm-presets">
        <button class="tm-btn" data-tm-jump="now">{{ t('Now', '现在') }}</button>
        <button class="tm-btn" data-tm-jump="2015-06-12">{{ t('2015 bubble', '2015 泡沫') }}</button>
        <button class="tm-btn" data-tm-jump="2018-12-28">{{ t('2018 bear', '2018 熊市') }}</button>
        <button class="tm-btn" data-tm-jump="2020-03-23">{{ t('2020 COVID', '2020 疫情') }}</button>
      </span>
    </div>
    <div class="tm-readout">
      <div class="tm-asof">
        <span class="tm-date" id="tm-date">—</span>
        <span class="tm-state-tag is-live" id="tm-tag">—</span>
      </div>
      <div class="tm-badges">
        <span class="badge" id="tm-quad">—</span>
        <span class="badge" id="tm-trans">—</span>
        <span class="kv">{{ t('agreement', '一致度') }} <b id="tm-conf">—</b></span>
        <span class="kv">{{ t('cycle', '商业周期') }} <b id="tm-cyc">—</b></span>
        <span class="kv">{{ t('liquidity', '流动性') }} <b id="tm-liq">—</b></span>
      </div>
      <div class="tm-gauges">
        <div class="tm-gauge">
          <div class="tm-glabel"><span>{{ t('Growth', '增长') }}</span><span class="sub" id="tm-g-v">—</span></div>
          <div class="gauge"><i id="tm-g-i" style="left:50%"></i></div>
        </div>
        <div class="tm-gauge">
          <div class="tm-glabel"><span>{{ t('Inflation', '通胀') }}</span><span class="sub" id="tm-i-v">—</span></div>
          <div class="gauge"><i id="tm-i-i" style="left:50%"></i></div>
        </div>
      </div>
      <div class="tm-flags" id="tm-flags"></div>
    </div>
  </div>
  {% endif %}

  <!-- ===================== DRAWDOWN & SLOWDOWN RISK (calibrated, display-only) ===================== -->
  {% if latest.conditions and latest.conditions.recession and latest.conditions.recession.score is not none %}
  {% set CO = latest.conditions %}
  <div class="panel span12" id="china-risk">
    <h2>{{ t('China drawdown & slowdown risk', '中国回撤与放缓风险') }}
      <span class="note" style="text-transform:none">· {{ t('calibrated 2006→2026 · display only', '已校准 2006→2026 · 仅展示') }}</span>
      {{ help("Two China-native risk gauges, both 0–100. Phase-0 calibrated against 20 years of forward A-share outcomes (scripts/calibrate_china_conditions.py): the bands are now anchored to each gauge's OWN historical distribution, but the study found NO forward-drawdown edge — A-shares mean-revert, so a high reading has historically been flat-to-mildly-contrarian, not bearish. So these stay descriptive context, never scored into the regime. <b>Slowdown</b> blends the credit impulse (社融), PPI deflation, manufacturing PMI, the M1−M2 scissors, property breadth and GDP. <b>Drawdown risk</b> is the rank-percentile of stacked stress legs (slowdown, margin froth, a flat CGB curve at low weight since the PBoC pins the front end, the QVIX level and turnover mania).", "两个中国本土风险仪表，均为 0–100。已用20年A股前瞻数据做 Phase-0 校准（scripts/calibrate_china_conditions.py）：区间现锚定于各自的历史分布，但研究发现<b>无前瞻回撤优势</b> —— A股均值回归，高读数历史上偏平/略逆向，而非看跌。故仍为描述性背景，从不计入区制评分。<b>放缓</b>融合社融信用脉冲、PPI 通缩、制造业 PMI、M1−M2 剪刀差、房价宽度与 GDP。<b>回撤风险</b>是各压力腿（放缓、两融拥挤、低权重的 CGB 平坦曲线[央行锚定短端]、QVIX 水平与成交亢奋）的排名分位。") }}
    </h2>
    <div class="grid" style="gap:18px">
      <div class="span6">
        <div style="display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'neg' if CO.recession.score>=60 else ('warn' if CO.recession.score>=40 else 'pos') }}">{{ CO.recession.score|round|int }}</span>
          <span class="sub">{{ t('Slowdown score', '放缓评分') }} · {{ t(CO.recession.label, {'low':'低','elevated':'偏高','high':'高'}.get(CO.recession.label, CO.recession.label)) }}</span>
        </div>
        <div class="dial"><i style="left:{{ CO.recession.score }}%"></i></div>
        <div class="dial-ends"><span>{{ t('expansion', '扩张') }}</span><span>{{ t('contraction', '收缩') }}</span></div>
        {% if CO.recession.fwd %}<p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('At this band, historically (SHCOMP)', '该区间历史上（上证）') }}: {{ t('3m forward return', '3月前瞻收益') }} <b>{{ CO.recession.fwd.fwd_ret_3m }}%</b> · {{ t('3m max drawdown', '3月最大回撤') }} <b>{{ CO.recession.fwd.fwd_maxdd_3m }}%</b> — {{ t('no forward edge (mean-reverting)', '无前瞻优势（均值回归）') }}</p>{% endif %}
        <table style="margin-top:8px">
          <tbody>
          {% for lg in CO.recession.legs if lg.active %}
          <tr><td class="l">{{ t(lg.label, lg.label_zh) }}</td>
            <td>{{ '%.0f'|format(lg.points) if lg.points is not none else '—' }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {% if CO.recession_html %}<div class="chart">{{ CO.recession_html | safe }}</div>{% endif %}
      </div>
      <div class="span6">
        {% if CO.drawdown_risk and CO.drawdown_risk.score is not none %}
        <div style="display:flex;align-items:baseline;gap:10px">
          <span class="bignum {{ 'neg' if CO.drawdown_risk.score>=60 else ('warn' if CO.drawdown_risk.score>=40 else 'pos') }}">{{ CO.drawdown_risk.score|round|int }}</span>
          <span class="sub">{{ t('Drawdown-risk percentile', '回撤风险分位') }} · {{ t(CO.drawdown_risk.band, {'calm':'平静','low':'低','elevated':'偏高','high':'高','fragile':'脆弱'}.get(CO.drawdown_risk.band, CO.drawdown_risk.band)) }}</span>
        </div>
        <div class="dial"><i style="left:{{ CO.drawdown_risk.score }}%"></i></div>
        <div class="dial-ends"><span>{{ t('calm', '平静') }}</span><span>{{ t('fragile', '脆弱') }}</span></div>
        {% if CO.drawdown_risk.fwd %}<p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('At this band, historically (SHCOMP)', '该区间历史上（上证）') }}: {{ t('3m forward return', '3月前瞻收益') }} <b>{{ CO.drawdown_risk.fwd.fwd_ret_3m }}%</b> · {{ t('3m max drawdown', '3月最大回撤') }} <b>{{ CO.drawdown_risk.fwd.fwd_maxdd_3m }}%</b> — {{ t('weak, sign-unstable link', '关联弱且符号不稳') }}</p>{% endif %}
        {% if CO.drawdown_html %}<div class="chart">{{ CO.drawdown_html | safe }}</div>{% endif %}
        {% endif %}
      </div>
    </div>
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">{{ t('Calibrated against 20y of forward A-share outcomes (scripts/calibrate_china_conditions.py): bands are history-anchored, but the gauges have NO forward-drawdown edge — A-shares mean-revert, so high readings are flat-to-contrarian. Descriptive context only, never scored into the quad / axes / playbook.', '已用20年A股前瞻数据校准（scripts/calibrate_china_conditions.py）：区间为历史锚定，但仪表无前瞻回撤优势 —— A股均值回归，高读数偏平/逆向。仅作描述性背景，从不计入象限／轴／策略评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== WHAT'S DRIVING THE TAPE (market drivers, display-only) ===================== -->
  {% if latest.market_drivers and latest.market_drivers.verdict not in [none, 'unknown'] %}
  {% set MD = latest.market_drivers %}
  <div class="panel span12" id="market-drivers">
    <h2>{{ t("What's driving the A-share tape", 'A股市场驱动因素') }}
      <span class="note" style="text-transform:none">· {{ t('past week', '过去一周') }}{% if MD.window_d %} · {{ MD.window_d }}d z{% endif %}</span>
      {{ help("Deterministic cross-asset attribution — which macro <b>fingerprint</b> best explains the last week's moves. NO news feed: it z-scores China cross-asset legs (PBoC rates & SHIBOR, on/offshore yuan, M1/M2 & margin liquidity, the stimulus tape of CSI300/brokers/property/copper-rebar, PPI & commodities, AI-semis relative strength, southbound flow & A/H, and a QVIX/breadth risk-off washout) and attributes the day to the driver whose legs line up best. A regime READ, never a signal — it never gates the quad or any score.", "确定性的跨资产归因 —— 哪个宏观<b>指纹</b>最能解释过去一周的走势。无新闻源：它对中国跨资产分腿（央行利率与 SHIBOR、在/离岸人民币、M1/M2 与两融流动性、沪深300/券商/地产/铜螺纹的刺激行情、PPI 与商品、AI-半导体相对强度、南向资金与 A/H、以及 QVIX/宽度的风险厌恶出清）进行 z 标准化，并把当下归因于分腿最吻合的驱动。这是区制解读，而非信号 —— 从不决定象限或任何评分。") }}
    </h2>
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:10px">
      <span class="chip c-{{ 'info' if MD.verdict=='clear' else ('warn' if MD.verdict=='mixed' else 'muted') }}"><span class="l-en">{{ MD.verdict }}</span><span class="l-zh">{{ MD.verdict_zh }}</span></span>
      <span style="font-size:18px;font-weight:800">{{ t(MD.primary_label, MD.primary_label_zh) }}</span>
      <span class="sub">{{ t('confidence', '置信度') }} <span class="l-en">{{ MD.confidence }}</span><span class="l-zh">{{ MD.confidence_zh }}</span> · {{ t('agreement', '一致度') }} {{ (MD.agreement*100)|round|int }}%</span>
    </div>
    <p class="note" style="margin:8px 0 8px;text-transform:none"><span class="l-en">{{ MD.direction }}</span><span class="l-zh">{{ MD.direction_zh }}</span></p>
    {% if MD.evidence_legs %}
    <div style="display:flex;flex-direction:column;gap:5px;max-width:560px">
      {% for lg in MD.evidence_legs %}
      {% set w = (([lg.z|abs, 3]|min)/3*50)|round(1) %}
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:0 0 160px;font-size:12.5px">{{ t(lg.en, lg.zh) }}</span>
        <div style="flex:1;height:9px;border-radius:5px;background:var(--panel2);position:relative">
          <i style="position:absolute;top:0;height:100%;border-radius:5px;{{ 'right:50%;background:var(--down)' if lg.z<0 else 'left:50%;background:var(--up)' }};width:{{ w }}%"></i>
          <span style="position:absolute;left:50%;top:-2px;height:13px;width:1px;background:var(--muted)"></span>
        </div>
        <span class="sub" style="flex:0 0 48px;text-align:right">{{ '%+.1f'|format(lg.z) }}σ</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if MD.runner_up_label %}<p class="sub" style="margin:8px 0 0">{{ t('Runner-up', '次因') }}: {{ t(MD.runner_up_label, MD.runner_up_label_zh) }}</p>{% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none"><span class="l-en">{{ MD.note }}{% if MD.invalidation %} · {{ MD.invalidation }}{% endif %}</span><span class="l-zh">确定性的中国跨资产归因 —— 区制解读，而非信号；从不决定评分或象限。{% if MD.invalidation_zh %} · {{ MD.invalidation_zh }}{% endif %}</span></p>
  </div>
  {% endif %}

  <!-- ===================== FEAR ↔ EUPHORIA + RORO (display-only) ===================== -->
  {% if latest.fear_euphoria %}
  {% set FE = latest.fear_euphoria %}
  <div class="panel span12" id="fear-euphoria">
    <h2>{{ t('🌡️ Fear ↔ Euphoria — A-share regime synthesis', '🌡️ 恐惧 ↔ 欣喜 — A股情绪综合') }}
      <span class="note" style="text-transform:none">· RORO {{ '%+.2f'|format(FE.roro) }} ({{ td(FE.roro_state) }}){% if FE.warming_up %} · {{ t('history warming up', '历史预热中') }}{% endif %}</span>
      {{ help("A 0–100 sentiment synthesis: the rolling-5y percentile of a China risk-on/risk-off (RORO) composite. The RORO is the equal-weight mean of causal-z legs — copper/gold, breadth, southbound smart-money, M1−M2 scissors and turnover (risk-ON), against QVIX, a weaker offshore yuan, margin froth and the A/H premium (risk-OFF). The cross-asset confirmation tally shows whether the legs agree or the tape is internally divergent. Display-only — never scored.", "0–100 的情绪综合：中国风险偏好（RORO）综合指标的滚动 5 年分位。RORO 是因果 z 分腿的等权平均 —— 铜/金、宽度、南向聪明钱、M1−M2 剪刀差与成交（偏多），对 QVIX、离岸人民币走弱、两融拥挤与 A/H 溢价（偏空）。跨资产确认计数显示各腿是否一致、或市场内部背离。仅展示 —— 从不评分。") }}
    </h2>
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
      <span class="bignum">{{ FE.fe_score }}</span>
      <span class="chip c-{{ 'down' if FE.fe_score>=75 else ('up' if FE.fe_score<=25 else 'muted') }}" style="font-size:15px">{{ t(FE.band, FE.band_zh) }}</span>
      <span class="sub">{{ t('0 = Panic · 100 = Euphoria', '0＝恐慌 · 100＝欣喜') }}</span>
    </div>
    <div class="dial"><i style="left:{{ FE.fe_score }}%"></i></div>
    <div class="dial-ends"><span>{{ t('Panic', '恐慌') }}</span><span>{{ t('Neutral', '中性') }}</span><span>{{ t('Euphoria', '欣喜') }}</span></div>
    {% if FE.chart_html %}<div class="chart">{{ FE.chart_html | safe }}</div>{% endif %}
    <h3>{{ t('Risk-on / risk-off legs (percentile)', '风险偏好分腿（分位）') }}</h3>
    <div style="display:flex;flex-direction:column;gap:5px;max-width:600px">
      {% for lg in FE.legs %}
      <div style="display:flex;align-items:center;gap:8px">
        <span style="flex:0 0 180px;font-size:12.5px">{{ t(lg.name_en, lg.name_zh) }}</span>
        <div style="flex:1;height:9px;border-radius:5px;background:var(--panel2);position:relative">
          <i style="position:absolute;top:0;left:0;height:100%;border-radius:5px;background:{{ 'var(--up)' if lg.lean=='risk-on' else ('var(--down)' if lg.lean=='risk-off' else 'var(--muted)') }};width:{{ lg.pct }}%"></i>
        </div>
        <span class="sub" style="flex:0 0 34px;text-align:right">{{ lg.pct }}</span>
      </div>
      {% endfor %}
    </div>
    {% if FE.confirmation %}
    <p class="note" style="margin:9px 0 0;text-transform:none">{{ t('Cross-asset confirmation', '跨资产确认') }}:
      <b><span class="l-en">{{ FE.confirmation.verdict_en }}</span><span class="l-zh">{{ FE.confirmation.verdict_zh }}</span></b>
      — {{ FE.confirmation.n_on }} {{ t('risk-on', '偏多') }} / {{ FE.confirmation.n_off }} {{ t('risk-off', '偏空') }}.</p>
    {% endif %}
    <p class="note" style="margin:6px 0 0;font-size:11px;text-transform:none">{{ t('Display-only sentiment synthesis — never scored into the China regime.', '仅展示的情绪综合 —— 从不计入中国区制评分。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== CHINA MACRO CALENDAR (display-only, no news API) ===================== -->
  {% if event_strip or calendar %}
  <div class="panel span12" id="china-calendar">
    <h2>📅 {{ t('China macro calendar — releases & catalysts', '中国宏观日历 — 数据与催化') }}
      <span class="note" style="text-transform:none">· {{ t('next 14 days', '未来14天') }}</span>
      {{ help("Scheduled China macro/policy releases (NBS PMI, CPI/PPI, M1/M2 + RMB loans + TSF, customs trade, IP/FAI/retail, GDP, the LPR fix on the 20th, MLF, SAFE FX reserves). All CONTEXT — none of it feeds any score, signal or regime, and there is no event-risk dampener. Dates come from the known monthly cadence (pure date arithmetic), not forecasts, and NO news feed is used.", "排定的中国宏观/政策数据（统计局 PMI、CPI/PPI、M1/M2＋人民币贷款＋社融、海关进出口、工业/固投/社零、GDP、每月 20 日的 LPR 报价、MLF、外汇局外储）。全部为背景 —— 不进入任何评分、信号或区制，亦无事件风险衰减。日期来自已知月度节律（纯日期推算），而非预测，且不使用任何新闻源。") }}
    </h2>
    {% if imminent %}<p class="note" style="margin:0 0 8px;text-transform:none"><b>{{ t('Imminent', '临近') }}:</b> <span class="l-en">{{ imminent.en }}</span><span class="l-zh">{{ imminent.zh }}</span></p>{% endif %}
    {% if calendar %}
    <table>
      <thead><tr><th class="l">{{ t('Date', '日期') }}</th><th class="l">{{ t('In', '距今') }}</th><th class="l">{{ t('Release', '数据') }}</th><th class="l">{{ t('Type', '类别') }}</th></tr></thead>
      <tbody>
      {% for c in calendar %}
      <tr>
        <td class="l">{{ c.date }}</td>
        <td class="l note">+{{ c.days_until }}{{ t('d', '天') }}</td>
        <td class="l">{% if c.importance=='high' %}<b>{{ t(c.name_en, c.name_zh) }}</b>{% else %}{{ t(c.name_en, c.name_zh) }}{% endif %}</td>
        <td class="l"><span class="chip c-{{ 'info' if c.importance=='high' else 'muted' }}" style="font-size:10.5px">{{ c.type }}</span></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
    <p class="note" style="margin:8px 0 0;font-size:11px;text-transform:none">{{ t('Scheduling context only — never scored, no event-risk dampener, no news API.', '仅日程背景 —— 从不评分、无事件风险衰减、无新闻接口。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== ACTION BOARD ===================== -->
  {% if actions and (actions.buy_now or actions.buy_soon or actions.take_profits or actions.hold or actions.avoid) %}
  <div class="panel span12">
    <h2>⚡ {{ t('What to act on now — sectors', '当前可操作 — 板块') }}
      {{ help("The 16 sector ETFs bucketed by the cycle ladder’s entry-timing call (same engine as the US action board). A structure/risk map, not an allocation rule — read alongside the calibration note below.", "16 个板块 ETF 按周期阶梯的入场时机分桶（与美国操作板同一引擎）。这是结构／风险图，而非配置规则 — 请结合下方校准说明阅读。") }}
    </h2>
    <div class="act-grid">
      {% macro actcol(cls, title_en, title_zh, items) %}
      {% if items %}
      <div class="act-col {{ cls }}">
        <h3>{{ t(title_en, title_zh) }} · {{ items|length }}</h3>
        {% for it in items %}
        <div class="act-item"><a class="an" href="sectors/{{ it.ticker }}.html">{{ td(it.name) }}</a>
          <div class="at">{{ td(it.label) }}{% if it.days is not none %} · ~{{ it.days }}{{ t('d', '天') }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% endmacro %}
      {{ actcol('act-now', 'Buy zone', '买入区', actions.buy_now) }}
      {{ actcol('act-soon', 'Setting up', '即将到位', actions.buy_soon) }}
      {{ actcol('act-tp', 'Take profits', '止盈', actions.take_profits) }}
      {{ actcol('act-hold', 'Hold', '持有', actions.hold) }}
      {{ actcol('act-avoid', 'Avoid', '回避', actions.avoid) }}
    </div>
    <p class="note" style="margin:10px 0 0;text-transform:none"><a href="china_stocks.html" style="color:var(--link);font-weight:600">→ {{ t('A-share stock dashboard — setups, reversal watch & relative strength', 'A股个股看板 — 形态、反转观察与相对强度') }}</a></p>
  </div>
  {% endif %}

  {% if pb %}
  <!-- ===================== WHERE WE ARE ===================== -->
  {% if pb.progress %}
  <div class="panel span6">
    <h2>{{ t('Where we are in this regime', '我们身处此周期何处') }}
      {{ help("This regime's age vs every same-quad period since ~2006 in this classifier. Regimes don't die of old age, but the older one gets relative to history, the more weight each warning deserves. China regimes are short — context, not a forecast.", "当前周期的年龄对比本分类器自约 2006 年以来每一段同象限周期。周期不会因年老而消亡，但相对历史越老，每一面预警越值得加重。中国周期很短 — 仅作背景，而非预测。") }}
    </h2>
    <div class="lifebar">
      <div class="zone" style="left:0;width:{{ pb.progress.zone_early_pct }}%;background:color-mix(in srgb,var(--up) 32%,var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_early_pct }}%;width:{{ pb.progress.zone_mid_pct - pb.progress.zone_early_pct }}%;background:color-mix(in srgb,var(--warn) 32%,var(--panel))"></div>
      <div class="zone" style="left:{{ pb.progress.zone_mid_pct }}%;width:{{ 100 - pb.progress.zone_mid_pct }}%;background:color-mix(in srgb,var(--down) 32%,var(--panel))"></div>
      <div class="marker" style="left:{{ pb.progress.bar_pct }}%"></div>
    </div>
    <div class="lifelabels"><span>{{ t('young', '年轻') }}</span><span>{{ t('mid-life', '中年') }}</span><span>{{ t('old', '年老') }}</span></div>
    <p style="margin:10px 0 4px"><b>{{ t(pb.progress.phase|upper, {'young':'年轻','mid':'中年','old':'年老'}[pb.progress.phase]) }}</b> — {{ t(pb.progress.phase_note, pb.progress.phase_note_zh) }}.</p>
    <p class="note">{{ t(
      pb.progress.age_days|string + ' trading days in, vs a median of ' + pb.progress.median_days|string + ' across ' + pb.progress.n_history|string + ' past ' + latest.quad_name + ' periods.',
      '已运行 ' + pb.progress.age_days|string + ' 个交易日，对比 ' + pb.progress.n_history|string + ' 段过往同象限周期的中位数 ' + pb.progress.median_days|string + ' 个交易日。') }}
      {% if pb.progress.pct_longer is not none %}{{ t(pb.progress.pct_longer|string + '% lasted longer than this so far' + (', and those typically ran ~' + pb.progress.median_remaining_days|string + ' more days.' if pb.progress.median_remaining_days else '.'), '其中 ' + pb.progress.pct_longer|string + '% 比当前持续更久' + ('，通常还会再运行约 ' + pb.progress.median_remaining_days|string + ' 个交易日。' if pb.progress.median_remaining_days else '。')) }}{% endif %}</p>
  </div>
  {% endif %}

  <!-- ===================== WHAT'S NEXT ===================== -->
  {% if pb.next_list %}
  <div class="panel span6">
    <h2>{{ t("What's likely next", '接下来可能发生什么') }}
      {{ help("Historical frequencies: across every same-quad period in this classifier, which regime came next. Base rates, not forecasts — but they tell you which playbook to keep warm.", "历史频率：本分类器中每一段同象限周期之后，接下来出现的是哪个周期。是基础概率而非预测 — 但能告诉你该把哪套剧本备着。") }}
    </h2>
    {% for n in pb.next_list %}
    <div class="prob">
      <span class="nm">{{ t(n.name, n.name_zh) }}</span>
      <span class="bar"><i style="width:{{ n.prob_pct }}%;background:var(--q{{ n.code[1] }})"></i></span>
      <span class="pc">{{ n.prob_pct }}%</span>
    </div>
    {% endfor %}
    <p class="note" style="margin-top:10px">{{ t(
      'These are unconditional base rates from a short, regime-unstable history — keep the top path\'s playbook warm, but wait for the growth/inflation dials to actually cross before acting.',
      '这些是来自一段短而不稳定历史的无条件基础概率 — 把最可能路径的剧本备着，但要等增长／通胀刻度盘真正穿越后再行动。') }}</p>
  </div>
  {% endif %}

  <!-- ===================== HOW TO TRADE NOW ===================== -->
  <div class="panel span12">
    <h2>{{ t('How to trade the current regime', '如何交易当前周期') }}
      {{ help("The dial is the headline: how much risk current conditions support, built from the quad's calibrated edge plus live internals (PBoC liquidity, margin crowding, southbound flow, the M1-M2 scissors). Sector names are risk filters — no stable monthly single-sector outperformance signal exists in China.", "刻度盘是核心：当前条件支持多大风险，由象限的校准优势加实时内部结构（央行流动性、两融拥挤度、南向资金、M1-M2 剪刀差）构建。板块名称是风险过滤器 — 中国不存在稳定的月度单一板块跑赢信号。") }}
    </h2>
    <div class="pdial">
      {% set pmap = {'DEFENSIVE':'on-def','CAREFUL':'on-car','NEUTRAL':'on-neu','CONSTRUCTIVE':'on-con','AGGRESSIVE':'on-agg'} %}
      {% set pzh = {'DEFENSIVE':'防御','CAREFUL':'谨慎','NEUTRAL':'中性','CONSTRUCTIVE':'积极','AGGRESSIVE':'进取'} %}
      {% for p in ['DEFENSIVE','CAREFUL','NEUTRAL','CONSTRUCTIVE','AGGRESSIVE'] %}
        <span class="{{ pmap[p] if pb.dial.posture==p }}">{{ t(p, pzh[p]) }}</span>
      {% endfor %}
    </div>
    {% for sign, r_en, r_zh in pb.dial.reasons %}
      <div class="reason"><span class="sig sig-{{ {'+':'p','-':'m','i':'i'}[sign] }}">{{ {'+':'+','-':'−','i':'i'}[sign] }}</span> <span>{{ t(r_en, r_zh) }}</span></div>
    {% endfor %}

    <div class="grid" style="margin-top:14px">
      <div class="span4">
        <h3>🎯 {{ t('Framework-preferred sectors', '框架偏好板块') }}{% if pb.pref_agreement is not none %} <span class="note" style="text-transform:none">· {{ t('tape agrees', '盘面一致') }} {{ (pb.pref_agreement*100)|round|int }}%</span>{% endif %}</h3>
        {% for x in pb.preferred %}
          <div class="pcard"><span class="calltag tag-pref">{{ t('PREFERRED', '偏好') }}</span><a class="tk" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b></a>{% if x.rank %} <span class="note">{{ t('RS rank', '相对排名') }} #{{ x.rank }}/16</span>{% endif %}</div>
        {% else %}<p class="note">—</p>{% endfor %}
      </div>
      <div class="span4">
        <h3>✅ {{ t('Confirmed leaders', '已确认领先') }} <span class="note" style="text-transform:none">· {{ t('uptrend + momentum', '上涨趋势 + 动量') }}</span></h3>
        {% for x in pb.leaders %}
          <div class="pcard"><span class="calltag tag-lead">{{ t('LEADER', '领先') }}</span><a class="tk" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b></a>{% if x.mom20 is not none %} <span class="pos">{{ '%+.1f'|format(x.mom20) }}</span>{% endif %}</div>
        {% else %}<p class="note">{{ t('None confirmed — leadership unconfirmed or stretched. Stay close to the index.', '无确认领先 — 领先地位未确认或已过度拉伸。紧贴指数。') }}</p>{% endfor %}
      </div>
      <div class="span4">
        <h3>🚫 {{ t('Avoid right now', '现在回避') }} <span class="note" style="text-transform:none">· {{ t('downtrend / topping', '下跌 / 见顶') }}</span></h3>
        {% for x in pb.avoid %}
          <div class="pcard"><span class="calltag tag-avoid">{{ t('AVOID', '回避') }}</span><a class="tk" href="sectors/{{ x.ticker }}.html"><b>{{ td(x.name) }}</b></a> <span class="note">{{ td(x.state) }}</span></div>
        {% else %}<p class="note">{{ t('Nothing triggers the avoid rules.', '当前没有标的触发回避规则。') }}</p>{% endfor %}
      </div>
    </div>
    <p class="note" style="margin-top:10px">⚖️ {{ t(pb.honesty.en, pb.honesty.zh) }}</p>
  </div>
  {% endif %}

  <!-- honest calibration framing -->
  <div class="panel span12">
    <h2>{{ t('How to read this', '如何解读') }}</h2>
    <p class="note">{{ t(
      'Calibrated 2008→2026 (split-half). Two signals survive both halves: the <b>Growth-scare</b> quad is the market\'s best contrarian-bottom (it has the highest forward return, ~70% hit), and an <b>expanding</b> PBoC stance (M2 accelerating) is a measurable tailwind. The other quads are flat-to-negative forward and partly regime-unstable — treat the regime as a risk-context map, not an allocation rule. The cycle ladder below is a drawdown/structure tool, never a standalone buy trigger.',
      '校准区间 2008→2026（折半验证）。两个信号在两个子区间均成立：<b>增长恐慌</b>象限是最佳的逆向抄底区（前瞻收益最高，命中率约70%），而<b>扩张</b>的央行立场（M2加速）是可衡量的顺风。其余象限前瞻收益平淡或为负、且部分周期不稳定——请将市场周期视作风险背景图，而非配置规则。下方的周期阶梯是回撤/结构工具，绝非独立买入信号。') }}</p>
  </div>

  {# AI Master Brief — China/HK-focused LLM synthesis (engine/master_brain.py, china
     lens). Client-fetched from china_brief.json so it never depends on build order;
     hidden until a usable brief loads. Research context only — never a signal. #}
  <div class="panel span12 ai-brief" id="china-brief" data-brief-src="china_brief.json" style="display:none">
    <style>
      #china-brief .mb-sum{font-size:15px;font-weight:600;margin:0 0 10px}
      #china-brief .mb-sec{margin:10px 0}
      #china-brief .mb-h{font-weight:600;color:var(--link);margin:0 0 4px}
      #china-brief .mb-list{margin:4px 0 0 18px;padding:0}
      #china-brief .mb-list li{margin:3px 0}
      #china-brief .mb-foot{margin-top:12px;color:var(--muted);font-size:12px}
    </style>
    <h2>🧠 {{ t('AI Master Brief · China & HK synthesis', 'AI 主脑简报 · 中港综合') }}
      {{ help('An AI-generated synthesis of the China & Hong-Kong dashboards, with US macro, the dollar, global liquidity and commodities as backdrop. RESEARCH CONTEXT only — it narrates the regime, flags where signals conflict and tests the policy/liquidity thesis (A-shares mean-revert, so leaders read as extended); it never feeds a score, signal or allocation. Can be wrong or overconfident — verify against the underlying panels.', 'AI 对中港看板的综合分析，以美国宏观、美元、全球流动性与商品为背景。仅供研究参考——它解读周期、标注信号冲突并检验政策／流动性假设（A股均值回归，故强势股视为已拉伸），绝不参与任何评分、信号或仓位。可能出错或过度自信，请对照各底层面板核实。') }}
    </h2>
    <div data-brief-body class="muted sm"></div>
  </div>
  <script src="aibrief.js"></script>

  <!-- sector rotation board -->
  <div class="panel span8">
    <h2>{{ t('Sector Rotation', '板块轮动') }} <span class="note" style="text-transform:none">· {{ t('RS vs CSI 300', '相对沪深300') }} · {{ t('click a header to sort', '点击表头排序') }}</span></h2>
    <table class="sortable">
      <thead><tr>
        <th class="l">{{ t('Sector', '板块') }}</th>
        <th>{{ t('Rank', '排名') }}</th>
        <th>{{ t('20d RS', '20日相对') }}</th>
        <th>{{ t('60d RS', '60日相对') }}</th>
        <th>{{ t('200d', '200日') }}</th>
        <th>{{ t('%ile', '分位') }}</th>
        <th class="l">{{ t('Cycle state', '周期状态') }}</th>
      </tr></thead>
      <tbody>
      {% for s in sectors %}
        <tr>
          <td class="l"><a href="sectors/{{ s.ticker }}.html">{{ td(s.name) }}</a></td>
          <td>{{ s.rank if s.rank is not none else '—' }}</td>
          <td class="{{ 'pos' if (s.mom20 or 0)>=0 else 'neg' }}">{{ '%+.1f'|format(s.mom20) if s.mom20 is not none else '—' }}</td>
          <td class="{{ 'pos' if (s.mom60 or 0)>=0 else 'neg' }}">{{ '%+.1f'|format(s.mom60) if s.mom60 is not none else '—' }}</td>
          <td>{{ '↑' if s.above200 else '↓' }}</td>
          <td>{{ s.pctile|round|int if s.pctile is not none else '—' }}</td>
          <td class="l"><span class="lad {{ 'up' if s.dir=='up' else ('down' if s.dir=='down' else 'flat') }}">{{ td(s.label or s.state) }}</span>{% if s.age_short %}<span class="agechip" title="when this signal last crossed">⏱ {{ t(s.age_short, s.age_short_zh) }}</span>{% endif %}{% if s.eq_badge %}<span class="eqmini eq-{{ s.eq_dir }}" title="{{ s.eq_tip }}">{{ s.eq_badge }}</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- breadth + cross-market ratios -->
  <div class="panel span4">
    <h2>{{ t('Breadth & Ratios', '宽度与比价') }}</h2>
    {% if breadth %}
    <p class="note" style="margin:0 0 8px">{{ t('Large-cap breadth', '大盘宽度') }} ({{ breadth.n_members }} {{ t('names', '只') }})</p>
    <table>
      <tr><td class="l">{{ t('% above 50-day', '50日上方占比') }}</td><td>{{ breadth.pct_above_50 }}% <span class="note">({{ '%+.0f'|format(breadth.pct50_chg20) }})</span></td></tr>
      <tr><td class="l">{{ t('% above 200-day', '200日上方占比') }}</td><td>{{ breadth.pct_above_200 }}%</td></tr>
      <tr><td class="l">{{ t('New highs − lows', '新高−新低') }}</td><td>{{ breadth.nh }} − {{ breadth.nl }}</td></tr>
