            <span class="dash-mtf-leg {{ 'on' if _legs.get('w2_macd') else 'off' }}">2W</span>
          </div>
        </td>
        <td class="dash-mtf-phase muted">{{ _td.get('monthly_phase', '—') }}</td>
        <td class="l"><a href="china_lookup.html#{{ _sym }}" class="muted" style="font-size:11px">{{ t('lookup', '查看') }}</a></td>
      </tr>
      {% endfor %}
      </tbody>
      {% if _mtf_hidden %}
      <tbody id="cn-mtf-tbody-hid" style="display:none">
      {% for _sym, _td in _mtf_hidden %}
      {% set _state = _td.get('state', 'NONE') %}
      {% set _legs = _td.get('legs', {}) %}
      <tr>
        <td class="l"><b>{{ _sym }}</b></td>
        <td>
          <span class="dash-mtf-badge {{ 'confirmed' if _state == 'UPTURN_CONFIRMED' else 'watch' if _state == 'UPTURN_WATCH' else 'none' }}">
            <span class="l-en">{{ 'CONFIRMED' if _state == 'UPTURN_CONFIRMED' else 'WATCH' if _state == 'UPTURN_WATCH' else '—' }}</span>
            <span class="l-zh">{{ '已确认' if _state == 'UPTURN_CONFIRMED' else '观察' if _state == 'UPTURN_WATCH' else '—' }}</span>
          </span>
        </td>
        <td class="r"><span class="dash-mtf-k">{{ _td.get('k', 0) }}</span></td>
        <td>
          <div class="dash-mtf-legs">
            <span class="dash-mtf-leg {{ 'on' if _legs.get('d_macd') else 'off' }}">D</span>
            <span class="dash-mtf-leg {{ 'on' if _legs.get('d3_confluence') else 'off' }}">3D</span>
            {% set _wm = _legs.get('w_macd', 'none') %}
            <span class="dash-mtf-leg {{ 'on' if _wm == 'cross' else 'partial' if _wm == 'approaching' else 'off' }}"{% if _wm == 'approaching' %} style="border-style:dashed"{% endif %}>W</span>
            <span class="dash-mtf-leg {{ 'on' if _legs.get('w2_macd') else 'off' }}">2W</span>
          </div>
        </td>
        <td class="dash-mtf-phase muted">{{ _td.get('monthly_phase', '—') }}</td>
        <td class="l"><a href="china_lookup.html#{{ _sym }}" class="muted" style="font-size:11px">{{ t('lookup', '查看') }}</a></td>
      </tr>
      {% endfor %}
      </tbody>
      {% endif %}
    </table>
    {% if _mtf_hidden %}
    <button class="lst-more cn-mtf-more" type="button" aria-expanded="false" onclick="(function(b){var h=document.getElementById('cn-mtf-tbody-hid');if(h){var show=h.style.display==='none';h.style.display=show?'':'none';b.setAttribute('aria-expanded',show);}})(this)">
      <span class="lm-show">{{ t('Show more', '显示更多') }} ({{ _mtf_hidden|length }}) ▾</span>
      <span class="lm-hide">{{ t('Show less', '收起') }} ▴</span>
    </button>
    {% endif %}
    {% else %}
    <p class="note">
      <span class="l-en">No UPTURN_CONFIRMED or UPTURN_WATCH names in today's universe — expected null in this tape.</span>
      <span class="l-zh">今日覆盖股票中无UPTURN_CONFIRMED或UPTURN_WATCH — 当前行情下预期为空值。</span>
    </p>
    {% endif %}
  </div>
  {% endif %}{# /mode == 'stocks' and mtf_upturn_cn #}

