    {# ── China Prophet v2 depth lanes.  Every raw eligible row remains visible,
       but each lane states what actually stopped it from the featured shelf.
       Pre-v2 fallback artifacts are collapsed into an explicitly unclassified
       legacy lane; they never return to the old flat-name spam. #}
    {% set _more = setups.get('more_actionable') or [] %}
    {% set _late = setups.get('late_or_unfillable') or [] %}
    {% set _forming = setups.get('forming') or [] %}
    {% set _legacy_depth = (setups.get('watch') or []) if not (_more or _late or _forming) else [] %}

    {% if _more %}
    <details class="cn-depth" data-stf="entry">
      <summary>
        <span>＋ {{ t('More live setups', '更多实时形态') }}
          <span class="cn-depth-sub">{{ t('real T1–T3 confluence, but entry is not fully open or it missed a featured verification/cap check', '真实T1–T3共振，但入场尚未完全开启，或未通过精选验证/数量上限') }}</span>
