      </div>
      <div style="flex:none;text-align:right;font-size:9px;color:var(--muted)">
        <span>{{ t(r.get('sector',''), SECZH.get(r.get('sector',''), r.get('sector',''))) }}</span>
        {% if r.get('sessions_since') is not none %}<span style="display:block">{{ r.get('sessions_since') }}{{ t(' sessions ago','个交易日前') }}</span>{% endif %}
      </div>
