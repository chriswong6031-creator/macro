            <div class="rip-fall-lbl"><span class="l-en">5d</span><span class="l-zh">5日</span></div>
          </div>
          {% endfor %}
          </div>
        </div>
      </div>{# /rz-fall #}
      {% endif %}

    </div>{# /rip-shelf #}
    {% endif %}

    {# ── W1-C: RAN array (non-buy universe, rule 3) ───────────────────────────
       Names whose 3D/2D cross fired within 15 sessions but are now gate-ineligible.
       Shown for honesty — do not chase. No BUY-family language. #}
    {% set _ran = setups.get('ran') or [] %}
    {% if _ran %}
    <div class="nb-shelf-hdr" style="margin-top:16px">
      <span class="nb-shelf-tag st-ran"><span class="l-en">RAN / LATE</span><span class="l-zh">信号已过</span></span>
      <span class="nb-shelf-expl"><span class="l-en">signal fired and aged out — shown for honesty, not action. Do not chase.</span><span class="l-zh">信号已触发并过期 — 出于诚实展示，不可追涨。</span></span>
    </div>
    <div style="display:flex;flex-direction:column;gap:5px;margin-top:8px" data-showmore="1">
    {% for r in _ran %}
    <div style="display:flex;align-items:flex-start;gap:9px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel);font-size:10.5px">
      <div style="flex:none;min-width:90px">
        <a href="china_lookup.html#{{ r.get('ticker','') }}" style="font-weight:800;color:var(--text)">{{ r.get('ticker','') }}</a>
        <span class="muted" style="font-size:9px;display:block">{{ nm(r.get('name','')) }}</span>
      </div>
      <div style="flex:1;min-width:0">
        {% set _rsl = r.get('sublabel') %}
        {% if _rsl %}<span style="color:var(--muted)"><span class="l-en">{{ _rsl }}</span><span class="l-zh">{% if r.get('cross_date') %}信号触发于{{ r.get('cross_date') }}（{{ r.get('sessions_since',0) }}个交易日前），自那时起+{{ '%.1f'|format(r.get('pct_since',0)) }}%{% endif %}</span></span>{% endif %}
        {% set _rbc = r.get('basing_chip') %}
        {% if _rbc %}<span style="display:block;font-size:9px;color:var(--link);margin-top:2px"><span class="l-en">{{ _rbc }}</span><span class="l-zh">筑底中</span></span>{% endif %}
        {% set _rlc = r.get('launched_chip') %}
        {% if _rlc %}<span style="display:block;font-size:9px;color:var(--up);margin-top:2px"><span class="l-en">{{ _rlc }}</span><span class="l-zh">已突破</span></span>{% endif %}
      </div>
      <div style="flex:none;text-align:right;font-size:9px;color:var(--muted)">
        <span>{{ t(r.get('sector',''), SECZH.get(r.get('sector',''), r.get('sector',''))) }}</span>
        {% if r.get('sessions_since') is not none %}<span style="display:block">{{ r.get('sessions_since') }}{{ t(' sessions ago','个交易日前') }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
    </div>
    {% endif %}

    {% if setups.laggards %}
    <p class="note" style="margin:13px 0 5px;text-transform:none;color:var(--down);font-weight:700">⚠ {{ t('Weakest relative momentum (laggards) — distribution risk:', '相对动量最弱（落后股）— 派发风险：') }}</p>
    <p style="margin:0;display:flex;flex-wrap:wrap;gap:4px 0;align-items:center">
      {% for r in setups.laggards %}<a href="china_lookup.html#{{ r.ticker }}" style="margin-right:14px;white-space:normal;overflow-wrap:anywhere"><b>{{ r.ticker }}</b> <span class="note">{{ nm(r.name) }}</span> <span class="neg">{{ '%+.2f'|format(r.alpha) }}</span></a>{% endfor %}
    </p>
    {% endif %}
    <p class="note" style="margin:8px 0 0;font-size:11px"><span class="l-en">Setup path: washout &rarr; base &rarr; fresh turn. Score = buy-readiness; forward grades are still accruing.</span><span class="l-zh">设置路径：洗盘 &rarr; 筑底 &rarr; 新转向。评分＝买入就绪度；前瞻成绩仍在累积。</span></p>
    </div>{# /nb-grid-section #}

    {# ── BOARD TRACK RECORD (honest forward ledger) ─────────────────────────────
       The board earns trust over time: this logs the ranked top-N each session and grades the
       forward CSI300-relative, fill-realistic (T+1) outcome. Display-only telemetry — the whole
       point is to hold the board accountable, so it shows the honest "accruing" state until the
       first maturities land (~21 sessions after the ledger's first date). #}
    {% set bt = setups.board_track %}
    {% if bt and bt.available %}
    {% set cov = setups.coverage %}
    <div class="nb-track" style="margin:14px 0 0;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:color-mix(in srgb,var(--link) 4%,var(--panel))">
      <div style="font-weight:700;font-size:12.5px;margin-bottom:5px">📒 {{ t('Board track record', '榜单成绩单') }}
        <span class="note" style="text-transform:none;font-weight:400">· {{ t('does the top of this board actually beat the index?', '本榜单头部是否真的跑赢指数？') }}</span>
        {{ help("Forward ledger for the board order. Matured picks are graded vs CSI300 from a realistic T+1 entry.", "榜单排序的前瞻账本。成熟样本按相对沪深300、可成交T+1入场打分。") }}
      </div>
      {% set h21 = bt.by_horizon['21d'] %}
      {% set itm = bt.interim %}
      {% if h21 and h21.n and h21.n >= 8 %}
      <div style="display:flex;flex-wrap:wrap;gap:6px 16px;align-items:baseline;font-size:12px">
        <span><b>{{ t('Hit vs CSI300', '跑赢沪深300') }}</b> (21d): <span class="{{ 'pos' if h21.hit_vs_csi300 >= 0.5 else 'neg' }}"><b>{{ '%.0f'|format(h21.hit_vs_csi300 * 100) }}%</b></span>{% if h21.hit_ci %} <span class="note">CI {{ '%.0f'|format(h21.hit_ci[0]*100) }}–{{ '%.0f'|format(h21.hit_ci[1]*100) }}%</span>{% endif %}</span>
        {% if h21.median_excess is not none %}<span><b>{{ t('Median excess', '超额中位数') }}</b>: <span class="{{ 'pos' if h21.median_excess >= 0 else 'neg' }}">{{ '%+.1f'|format(h21.median_excess * 100) }}%</span></span>{% endif %}
        {% if h21.board_rank_ic is not none %}<span><b>{{ t('Rank-IC', '排序 IC') }}</b>: <span class="{{ 'pos' if h21.board_rank_ic <= 0 else 'neg' }}">{{ '%+.2f'|format(h21.board_rank_ic) }}</span> <span class="note">{{ t('(negative = well-ordered)', '（为负＝排序良好）') }}</span></span>{% endif %}
        <span class="note">n={{ h21.n }}</span>
      </div>
      {% if h21.extended_fwd is not none and h21.not_extended_fwd is not none %}
      <div style="font-size:11.5px;margin-top:4px" class="note">{{ t('Extended-tagged picks', '已大涨标记') }}: <span class="{{ 'pos' if h21.extended_fwd >= 0 else 'neg' }}">{{ '%+.1f'|format(h21.extended_fwd*100) }}%</span> {{ t('vs not-extended', '对比未大涨') }} <span class="{{ 'pos' if h21.not_extended_fwd >= 0 else 'neg' }}">{{ '%+.1f'|format(h21.not_extended_fwd*100) }}%</span> {{ t('(21d, CSI300-relative)', '（21日，相对沪深300）') }}</div>
      {% endif %}
      {% elif itm and itm.available and itm.n and itm.n >= 8 %}
      {# INTERIM read: the 21d forward grade hasn't matured (first ~2026-07-29), so show an honest,
         explicitly UNREALIZED mark-to-latest-close read instead of a black box. Very early — median
         hold is only a session or two — so it is framed as "so far", never as a validated edge. #}
      <div style="display:flex;flex-wrap:wrap;gap:6px 16px;align-items:baseline;font-size:12px">
        <span class="note" style="text-transform:none;font-weight:700;color:var(--warn)">⏳ {{ t('Interim — unrealized, marked to latest close', '临时 —— 未实现，按最新收盘价标记') }}</span>
        <span><b>{{ t('Beating CSI300 so far', '暂时跑赢沪深300') }}</b>: <span class="{{ 'pos' if itm.hit_vs_csi300 >= 0.5 else 'neg' }}"><b>{{ '%.0f'|format(itm.hit_vs_csi300 * 100) }}%</b></span>{% if itm.hit_ci %} <span class="note">CI {{ '%.0f'|format(itm.hit_ci[0]*100) }}–{{ '%.0f'|format(itm.hit_ci[1]*100) }}%</span>{% endif %}</span>
        {% if itm.median_excess is not none %}<span><b>{{ t('Median excess', '超额中位数') }}</b>: <span class="{{ 'pos' if itm.median_excess >= 0 else 'neg' }}">{{ '%+.1f'|format(itm.median_excess * 100) }}%</span></span>{% endif %}
        <span class="note">n={{ itm.n }}</span>
      </div>
      <div style="font-size:11px;margin-top:4px" class="note">{{ t('This is NOT the matured grade — median', '这不是成熟评分 —— 中位持有') }} {{ itm.median_days_held }} {{ t('session(s) held so far (max', '个交易日（最长') }} {{ itm.max_days_held }}{{ t('); far too early to read as an edge. First matured 21-day grades ~2026-07-29.', '）；过早，不能视作优势。首批21日成熟评分约在 2026-07-29。') }}{% if bt.dates %} <span class="l-en">Logging since {{ bt.dates[0] }} ({{ bt.n_rows }} rows).</span><span class="l-zh">自 {{ bt.dates[0] }} 起记录（{{ bt.n_rows }} 条）。</span>{% endif %}</div>
      {% else %}
      <div style="font-size:12px" class="note">{{ t('Accruing — no picks have matured yet. First 21-day maturities ~2026-07-29.', '累积中 —— 尚无成熟样本。首批21日成熟约在 2026-07-29。') }}{% if bt.dates %} <span class="l-en">Logging since {{ bt.dates[0] }} ({{ bt.n_rows }} rows).</span><span class="l-zh">自 {{ bt.dates[0] }} 起记录（{{ bt.n_rows }} 条）。</span>{% endif %}</div>
      {% endif %}
      <div style="font-size:10.5px;margin-top:5px" class="note">
        <span class="l-en">Grading: CSI300-relative excess, fill-realistic T+1 {% if bt.grading and bt.grading.entry_basis == 't1_hl2' %}(H+L)/2 proxy{% else %}open{% endif %} entry, locked-limit days excluded, never marker-dated.</span><span class="l-zh">打分：相对沪深300 超额，可成交 T+1 {% if bt.grading and bt.grading.entry_basis == 't1_hl2' %}(最高+最低)/2 代理{% else %}开盘{% endif %}入场，剔除一字涨停日，绝不用标记日。</span>
        {% if cov %} {% if cov.data_through %}<span class="l-en">Data through {{ cov.data_through }}.</span><span class="l-zh">数据截至 {{ cov.data_through }}。</span>{% endif %}{% if cov.partial_session %} <span class="neg"><b>{{ t('partial session — not logged', '盘中未收 —— 未记录') }}</b></span>{% endif %}{% endif %}
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <!-- ===================== STOCK SCREENER (consolidated · toggle) ===================== -->
  {% if scoreboard and scoreboard.modes %}
  <div class="panel span12" id="stock-screener">
    <h2>{{ t('🎯 Stock screener — one board, two validated lenses', '🎯 选股面板 — 一板双镜') }}
      <span class="note" style="text-transform:none">· {{ t('switch the lens; the table re-sorts', '切换视角；表格随之重排') }}{% if scoreboard.as_of %} · {{ scoreboard.as_of }}{% endif %}</span>
      {{ help("Two validated lenses: within-sector mean reversion and low-vol defensive. Sortable context, not a buy list.", "两种已验证视角：板块内均值回归与防御低波。可排序背景，非买入清单。") }}
    </h2>
    <div class="sb-seg" role="tablist" aria-label="screener mode">
      <button role="tab" data-mode="reversal" aria-selected="true">{{ t('🔄 Mean-reversion', '🔄 均值回归') }}</button>
      <button role="tab" data-mode="lowvol" aria-selected="false">{{ t('🛡 Low-vol defensive', '🛡 防御低波') }}</button>
    </div>
    <p class="note sb-cap" id="sb-cap"><!-- per-mode caption injected by JS --></p>
    <p class="note sbt-legend" id="sbt-legend" style="display:none"><!-- sector-turn legend injected by JS when any sector is boosted --></p>
    <table class="sb-table"><thead id="sb-head"></thead><tbody id="sb-body"></tbody></table>
    <p class="note" style="margin:8px 0 0;font-size:11px">{{ t('Validated lenses only: short-term reversal and low-vol defensive. Research context, not a buy list.', '仅保留已验证视角：短期反转与防御低波。研究背景，非买入清单。') }}</p>
    <script type="application/json" id="sb-data">{{ scoreboard.modes | tojson }}</script>
    <script type="application/json" id="sb-seczh">{{ SECZH | tojson }}</script>
    <script type="application/json" id="sb-turn">{{ (scoreboard.get('sector_turn') or {}) | tojson }}</script>
    <script>
    (function () {
      var DATA, SECZH, TURN;
      try { DATA = JSON.parse(document.getElementById('sb-data').textContent); } catch (e) { return; }
      try { SECZH = JSON.parse(document.getElementById('sb-seczh').textContent); } catch (e) { SECZH = {}; }
      try { TURN = JSON.parse(document.getElementById('sb-turn').textContent) || {}; } catch (e) { TURN = {}; }
      var head = document.getElementById('sb-head'), body = document.getElementById('sb-body'),
          cap = document.getElementById('sb-cap'),
          seg = document.querySelector('#stock-screener .sb-seg');
      // bilingual span (CSS shows the active language)
      function bl(en, zh) { return '<span class="l-en">' + en + '</span><span class="l-zh">' + (zh || en) + '</span>'; }
      function sgn(v, d) { return (v >= 0 ? '+' : '') + v.toFixed(d); }
      function cls(v) { return v >= 0 ? 'pos' : 'neg'; }
      function nm(name) { var p = String(name || '').split(' / '); return bl(p[0], p[1] || p[0]); }
      function ladDir(d) { return d === 'up' ? 'up' : (d === 'down' ? 'down' : 'flat'); }
      // sector washout→turn boost (per-sector map built by engine/china_sector_turn):
      // leg A = the sector composite washed out AND just fired the validated 2D-MACD x
      // 3D-StochRSI turn; leg B = the sector's washed-out peers have stopped falling
      // (decline velocity collapsed / slight uptick). Re-ranks the DEFAULT view + tints
      // rows; an explicit column click always gives the pure sort (never a filter).
      function turnOf(r) { return (r.sector && TURN[r.sector]) || null; }
      function boostOf(r) { var t = turnOf(r); return t ? (t.boost || 0) : 0; }
      function turnChips(r) {
        var t = turnOf(r), out = '';
        if (!t) return out;
        if (t.leg_turn) {
          var proj = t.turn && t.turn.tier === 'T3';
          out += ' <span class="sbt-chip">▲ ' + (proj
            ? bl('sector turning (proj)', '板块转向临近（预测）')
            : bl('sector turned 2D×3D', '板块2D×3D已转向')) + '</span>';
        }
        if (t.leg_peers) {
          out += ' <span class="sbt-chip soft">' + bl('peers basing', '同板块筑底')
               + ' ' + t.peers.based_n + '/' + t.peers.washed_n + '</span>';
        }
        return out;
      }
      var COL = {
        stock: { en: 'Stock', zh: '个股', l: true, key: function (r) { return r.ticker; },
          cell: function (r) { return '<a href="china_lookup.html#' + r.ticker + '"><b>' + r.ticker + '</b></a> <span class="note">' + nm(r.name) + '</span>'; } },
        sector: { en: 'Sector', zh: '板块', l: true, key: function (r) { return r.sector || ''; },
          cell: function (r) { return '<span class="note">' + bl(r.sector || '—', SECZH[r.sector] || r.sector || '—') + '</span>' + turnChips(r); } },
        price: { en: 'Price', zh: '价格', key: function (r) { return r.price; },
          cell: function (r) { return r.price != null ? r.price.toFixed(2) : '—'; } },
        cycle: { en: 'Cycle', zh: '周期', l: true, key: null,
          cell: function (r) { return r.cycle ? '<span class="lad ' + ladDir(r.cycle_dir) + '">' + bl(r.cycle, r.cycle_zh || r.cycle) + '</span>' : '—'; } },
        ret3m: { en: '3-mo', zh: '近3月', key: function (r) { return r.ret_3m; },
          cell: function (r) { return r.ret_3m != null ? '<span class="neg">' + sgn(r.ret_3m, 1) + '%</span>' : '—'; } },
        revz: { en: 'rev-z', zh: '反转强度', key: function (r) { return r.rev_z; }, def: 'desc',
          cell: function (r) { return r.rev_z != null ? '<b>' + r.rev_z.toFixed(2) + '</b>' : '—'; } },
        srank: { en: 'sector rank', zh: '板块排名', key: function (r) { return r.sector_rank; },
          cell: function (r) { return r.sector_rank != null ? '<span class="note">' + r.sector_rank + '/' + r.sector_n + '</span>' : '—'; } },
        mcap: { en: 'mkt cap', zh: '市值', key: function (r) { return r.mktcap_yi; },
          cell: function (r) { return r.mktcap_yi != null ? '<span class="note">' + Math.round(r.mktcap_yi) + '亿</span>' : '—'; } },
        vol: { en: 'σ (ann)', zh: '年化波动', key: function (r) { return r.vol_pct_ann; }, def: 'asc',
          cell: function (r) { return r.vol_pct_ann != null ? '<b>' + r.vol_pct_ann.toFixed(1) + '%</b>' : '—'; } },
        beta: { en: 'beta', zh: '贝塔', key: function (r) { return r.beta; },
          cell: function (r) { return r.beta != null ? '<span class="note">' + r.beta.toFixed(2) + '</span>' : '—'; } },
      };
      var MODES = {
        reversal: { cols: ['stock', 'sector', 'price', 'ret3m', 'revz', 'srank', 'mcap', 'cycle'],
          cap: bl('Deepest 3-month dips vs sector. Validated mean-reversion lens; not a buy list.', '相对板块近3个月跌幅最深。已验证的均值回归视角；非买入清单。') },
        lowvol: { cols: ['stock', 'sector', 'price', 'vol', 'beta', 'mcap', 'cycle'],
          cap: bl('Lowest-volatility names. Defensive exposure lens, not return maximization.', '波动率最低的个股。防御敞口视角，非收益最大化。') },
      };
      var cur = 'reversal', sortCol = null, sortDir = 'desc', userSorted = false;
      var legend = document.getElementById('sbt-legend');
      function render() {
        var spec = MODES[cur], cols = spec.cols.map(function (c) { return COL[c]; });
        cap.innerHTML = spec.cap;
        // sector-turn legend: only when a shown sector actually carries a boost
        var anyBoost = (DATA[cur] || []).some(function (r) { return boostOf(r) > 0; });
        if (legend) {
          legend.style.display = anyBoost ? '' : 'none';
          if (anyBoost) legend.innerHTML = '<span class="sbt-chip">▲ ' + bl('sector turned', '板块已转向') + '</span> ' + bl('= the name’s sector washed out with it and just fired the validated 2D-MACD × 3D-StochRSI turn.', '＝该股所在板块随其一同洗盘，且刚在已验证的 2D-MACD × 3D-StochRSI 上转向。') + ' <span class="sbt-chip soft">' + bl('peers basing', '同板块筑底') + '</span> ' + bl('= the sector’s washed-out peers have stopped falling (velocity collapsed, some ticking up).', '＝板块内洗盘个股大多已止跌（下跌骤减、部分回升）。') + ' ' + bl('Boosted rows float to the top of the default order — click any column for the pure sort. A display re-rank, never a filter.', '仅提升默认排序（点击任意列即为纯排序）。展示层重排、绝非过滤。');
        }
        // header
        var hh = '<tr>';
        cols.forEach(function (c, i) {
          var sortable = c.key !== null;
          var arrow = '';
          if (sortable) arrow = '<span class="sarrow">' + (sortCol === i ? (sortDir === 'desc' ? '↓' : '↑') : '↕') + '</span>';
          hh += '<th class="' + (c.l ? 'l ' : '') + (sortable ? 'th-sort ' : '') + (sortCol === i ? 'sorted' : '') + '"'
              + (sortable ? ' data-i="' + i + '"' : '') + '>' + bl(c.en, c.zh) + arrow + '</th>';
        });
        hh += '</tr>';
        head.innerHTML = hh;
        // rows — DEFAULT order pushes sector-turn boosted names to the top (boost desc,
        // then the mode's default key inside each group); an explicit header click gives
        // the pure single-column sort with no boost.
        var rows = DATA[cur] ? DATA[cur].slice() : [];
        if (sortCol !== null && cols[sortCol] && cols[sortCol].key) {
          var kf = cols[sortCol].key, sgnd = sortDir === 'desc' ? -1 : 1;
          rows.sort(function (a, b) {
            if (!userSorted) { var db = boostOf(b) - boostOf(a); if (db) return db; }
            var va = kf(a), vb = kf(b);
            if (va == null) va = -Infinity; if (vb == null) vb = -Infinity;
            if (typeof va === 'string' || typeof vb === 'string')
              return sgnd * String(va).localeCompare(String(vb), undefined, { numeric: true });
            return sgnd * (va - vb);
          });
        }
        var bb = '';
        rows.forEach(function (r) {
          var bcls = boostOf(r);  // tint follows the boost even under a user sort
          bb += '<tr' + (bcls ? ' class="sbt' + bcls + '"' : '') + '>' + cols.map(function (c) {
            return '<td class="' + (c.l ? 'l' : '') + '">' + c.cell(r) + '</td>';
          }).join('') + '</tr>';
        });
        body.innerHTML = bb || '<tr><td>—</td></tr>';
      }
      // default sort per mode
      function setMode(m) {
        cur = m;
        var cols = MODES[cur].cols.map(function (c) { return COL[c]; });
        sortCol = null; sortDir = 'desc'; userSorted = false;
        cols.forEach(function (c, i) { if (c.def && sortCol === null) { sortCol = i; sortDir = c.def; } });
        Array.prototype.forEach.call(seg.querySelectorAll('button'), function (b) {
          b.setAttribute('aria-selected', b.getAttribute('data-mode') === m ? 'true' : 'false');
        });
        render();
      }
      seg.addEventListener('click', function (e) {
        var b = e.target.closest('button[data-mode]'); if (!b) return;
        setMode(b.getAttribute('data-mode'));
      });
      head.addEventListener('click', function (e) {
        var th = e.target.closest('th.th-sort'); if (!th) return;
        var i = parseInt(th.getAttribute('data-i'), 10);
        if (sortCol === i) sortDir = sortDir === 'desc' ? 'asc' : 'desc';
        else { sortCol = i; sortDir = 'desc'; }
        userSorted = true;
        render();
      });
      setMode('reversal');
    })();
    </script>
  </div>
  {% endif %}

  {# ======= REVERSION DESK — flagship-2 (china_stocks.html only) ========================
     Spec: CHINA_PICK_LAB_MASTERPLAN_BY_FABLE.md §4 + §7.
     VM key: reversion_desk (loaded from site/factordata/china_reversion_desk.json by
     build_china.py as a fallback when the producer block sets it). Degrades gracefully
     when the key is absent — the block is simply hidden. Authority: display_only (CNPL-R1).
     GOTCHA: Jinja `is not none` on a missing key CRASHES — use .get() guards throughout.
  #}
  {% if mode == 'stocks' %}
  {% set _rd = reversion_desk if reversion_desk is defined else none %}
  {% if _rd %}
  <!-- ===================== REVERSION DESK (flagship-2, A-share native edge) ===================== -->
  <div class="panel span12" id="reversion-desk">
    {# lane header #}
    <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:6px">
      <h2 style="margin:0">🔄 {{ t('Reversion Desk', '回归台') }}
        {{ help("Stocks that fell the most within their own sector over the last 3 months — historically the deepest fallers tend to snap back. Ranked by how deep the fall is, with bonus credit for A-share-specific signs (a 2-week washout, a coiled volatility squeeze). Scored against the CSI 300 over the next 21 sessions, entering at the next day's price (T+1). Track record still accruing — display context, not a signal and not a buy list (CNPL-R1/R3/R4).", "同行业内近3个月跌幅最深的个股——历史上跌得最深的往往反弹也快。按跌幅深度排序，并对A股特有迹象（2周洗盘、波动压缩蓄势）加分。以次日价格入场（T+1）、未来21个交易日对沪深300的超额收益计分。成绩仍在累积——仅供展示参考，非信号、非买入清单（CNPL-R1/R3/R4）。") }}
      </h2>
      <span class="chip c-muted" style="font-size:11px;font-weight:600">{{ t('display-only', '仅展示') }}</span>
    </div>
    {# stale / as_of stamp #}
    {% set _rd_asof = _rd.get('as_of') %}
    {% if _rd_asof %}
    <p class="note" style="font-size:11px;margin:0 0 10px;color:var(--muted)">{{ t('as of', '截至') }} {{ _rd_asof }}</p>
    {% endif %}
    {# top picks cards #}
    {% set _rd_picks = _rd.get('picks') or [] %}
    {% if _rd_picks %}
    <div class="nbgrid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px" data-showmore-rows="2">
      {% for n in _rd_picks %}
      <div class="nbcard nb-up" style="cursor:default">
        <div class="nb-id">
          <div class="nb-tkrow">
            <span class="nb-tk">{{ n.get('ticker','') }}</span>
            {% set _np = n.get('price') %}
            {% if _np is not none %}<span class="nb-px" data-sym="{{ n.get('ticker','') }}" data-mkt="cn">{{ '%.2f'|format(_np) }}</span>{% endif %}
          </div>
          <div class="nb-nm">
            {% set _nn = (n.get('name') or '').split(' / ') %}
            <span class="l-en">{{ _nn[0] }}</span><span class="l-zh">{{ _nn[1] if _nn|length > 1 else _nn[0] }}</span>
          </div>
          <div class="nb-secrow">
            {% set _ns = n.get('sector','') %}
