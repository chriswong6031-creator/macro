<script>
/* MX5 dialog / popover / heatmap helpers (macro mode only) */
(function(){
  var _hmMounted=false;
  function cnxOpenDlg(id){
    var el=document.getElementById(id);
    if(!el)return;
    document.querySelectorAll('.cnx-dlg.open').forEach(function(d){d.classList.remove('open','cnx-in','cnx-closing');});
    el.classList.add('open');
    document.body.style.overflow='hidden';
    history.replaceState(null,'',location.pathname+'#'+id);
    /* Add .cnx-in on the next frame (after .open paints the start state) so the
       entrance transition — backdrop fade + panel rise/scale + body stagger — runs. */
    requestAnimationFrame(function(){requestAnimationFrame(function(){el.classList.add('cnx-in');});});
    /* Lazy-mount the China heatmap the first time the Markets dialog opens — the
       treemap needs a laid-out (visible) container, so we can't render it while hidden. */
    if(id==='cnx-dlg-markets'&&!_hmMounted){
      var mountHm=function(){
        if(_hmMounted||!el.classList.contains('open')||!window.MMHeatmap||!MMHeatmap.mountScorecard)return;
        _hmMounted=true;
        try{MMHeatmap.mountScorecard('cn-hm-embed','marketdata/china_heatmap.json');}
        catch(e){_hmMounted=false;}
      };
      if(window.MMHeatmap)mountHm();
      else if(window.mmLoadHeatmap)window.mmLoadHeatmap().then(mountHm).catch(function(){});
    }
    /* Replay the ilx / Signal-Ink charts in this dialog. They're already laid out
       (stretch to their column via illus.css); ilxReveal restarts the ink draw once
       the panel entrance has settled, so every open re-animates. */
    if(window.ilxReveal){setTimeout(function(){ilxReveal(el);},340);}
  }
  function cnxCloseDlg(){
    document.querySelectorAll('.cnx-dlg.open').forEach(function(el){
      var panel=el.querySelector('.cnx-dlg-panel');
      el.classList.add('cnx-closing');el.classList.remove('cnx-in');
      var fired=false;
      var done=function(){if(fired)return;fired=true;if(panel)panel.removeEventListener('transitionend',onEnd);el.classList.remove('open','cnx-closing');};
      var onEnd=function(e){if(e.target===panel)done();};
      if(panel)panel.addEventListener('transitionend',onEnd);
      setTimeout(done,360); /* fallback for reduced-motion / no transitionend */
    });
    document.body.style.overflow='';
    history.replaceState(null,'',location.pathname);
  }
  function cnxTogglePop(id,ev){
    if(ev){ev.stopPropagation();}
    var el=document.getElementById(id);
    if(!el)return;
    var was=el.classList.contains('open');
    cnxClosePops();
    if(!was)el.classList.add('open');
  }
  function cnxClosePops(){
    document.querySelectorAll('.cnx-pop.open').forEach(function(p){p.classList.remove('open');});
  }
  function cnxToggleHm(ev){
    if(ev){ev.stopPropagation();}
    var w=document.getElementById('cnx-hm');
    if(w)w.classList.toggle('expanded');
  }
  /* hash-resolver: open dialog if URL hash matches a cnx-dlg id */
  function cnxResolveHash(){
    var h=(location.hash||'').slice(1);
    if(!h)return;
    var el=document.getElementById(h);
    if(el&&el.classList.contains('cnx-dlg'))cnxOpenDlg(h);
    else if(el)el.scrollIntoView({behavior:'smooth'});
  }
  /* close dialog on Escape key */
  /* Escape: if the fullscreen heatmap overlay is open, let ITS own handler close it
     (don't also close the Markets dialog underneath). */
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){if(document.querySelector('.hm-ov'))return;cnxCloseDlg();}});
  /* close popovers on outside click */
  document.addEventListener('click',function(){cnxClosePops();});
  /* expose on window for onclick= attrs */
  window.cnxOpenDlg=cnxOpenDlg;
  window.cnxCloseDlg=cnxCloseDlg;
  window.cnxTogglePop=cnxTogglePop;
  window.cnxClosePops=cnxClosePops;
  window.cnxToggleHm=cnxToggleHm;
  cnxResolveHash();
  window.addEventListener('hashchange',cnxResolveHash);
})();
</script>
{# ── B · Path-chart hover enhancement (ported from dashboard.html.j2 ~7141) — pure
   progressive layer. Reads data-points (viewBox x/y baked in) + the SVG's live bounding
   rect, maps viewBox→screen so the crosshair/dot/tooltip stay pixel-crisp under the
   non-uniform stretch. Chart is fully legible without this. Verdict colours resolve from
   the page's --up/--warn/--down CSS vars (not hardcoded hex) so the dot + tooltip verdict
   flip correctly in zh 红涨绿跌. #}
<script>
(function(){
  var svg = document.querySelector('.mx5-sc-right .mx5-path-svg[data-points]');
  if(!svg) return;
  var plot = svg.closest('.mx5-path-plot'); if(!plot) return;
  var cross = plot.querySelector('.mx5-path-cross');
  var dot   = plot.querySelector('.mx5-path-dot');
  var tip   = plot.querySelector('.mx5-path-tip');
  if(!cross || !dot || !tip) return;
  var tDate = tip.querySelector('.mx5-path-tip-date');
  var tScore= tip.querySelector('.mx5-path-tip-score');
  var tVerd = tip.querySelector('.mx5-path-tip-verdict');
  var pts;
  try { pts = JSON.parse(svg.getAttribute('data-points') || '[]'); } catch(e){ return; }
  if(!pts.length) return;
  var VBW = +(svg.getAttribute('data-vbw')||1000);
  var VBH = +(svg.getAttribute('data-vbh')||224);
  /* Resolve verdict colours from CSS custom props so they follow the html[data-lang] zh
     swap (risk-on=red / risk-off=green in Chinese). Re-read on langchange. */
  var COL = {};
  function refreshCol(){
    var cs = getComputedStyle(document.documentElement);
    COL = {
      'Risk-on': (cs.getPropertyValue('--up')||'#22d97a').trim(),
      'Mixed':   (cs.getPropertyValue('--warn')||'#f59e0b').trim(),
      'Risk-off':(cs.getPropertyValue('--down')||'#ef4444').trim()
    };
  }
  refreshCol();
  function isZh(){
    var el=document.documentElement;
    return (el.getAttribute('data-lang')||'').slice(0,2)==='zh';
  }
  function nearest(clientX){
    var r = svg.getBoundingClientRect();
    var vx = (clientX - r.left) / r.width * VBW;
    var best=0, bd=Infinity;
    for(var i=0;i<pts.length;i++){
      var d=Math.abs(pts[i].x - vx);
      if(d<bd){ bd=d; best=i; }
    }
    return best;
  }
  function show(i){
    var p = pts[i]; if(!p) return;
    var r = svg.getBoundingClientRect();
    var pr = plot.getBoundingClientRect();
    var sx = (p.x / VBW) * r.width  + (r.left - pr.left);
    var sy = (p.y / VBH) * r.height + (r.top  - pr.top);
    cross.style.left = sx + 'px';   cross.style.opacity = '1';
    dot.style.left = sx + 'px';     dot.style.top = sy + 'px';
    dot.style.background = COL[p.v] || COL['Risk-on'];
    dot.style.opacity = '1';
    tDate.textContent = isZh() ? (p.mz || p.d) : (p.md || p.d);
    tScore.textContent = p.s;
    tVerd.textContent = isZh() ? (p.vz||p.v) : p.v;
    tVerd.style.color = COL[p.v] || COL['Risk-on'];
    var half = tip.offsetWidth/2 || 60;
    var clx = Math.max(half+2, Math.min(pr.width-half-2, sx));
    tip.style.left = clx + 'px';
    tip.style.top  = sy + 'px';
    tip.classList.add('show');
  }
  function hide(){
    cross.style.opacity='0'; dot.style.opacity='0'; tip.classList.remove('show');
  }
  var raf=0, lastX=0;
  function onMove(clientX){
    lastX=clientX;
    if(raf) return;
    raf=requestAnimationFrame(function(){ raf=0; show(nearest(lastX)); });
  }
  svg.addEventListener('mousemove', function(e){ onMove(e.clientX); });
  svg.addEventListener('mouseleave', hide);
  svg.addEventListener('touchstart', function(e){
    if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX));
  }, {passive:true});
  svg.addEventListener('touchmove', function(e){
    if(e.touches && e.touches[0]) show(nearest(e.touches[0].clientX));
  }, {passive:true});
  svg.addEventListener('touchend', function(){ setTimeout(hide, 1400); }, {passive:true});
  document.addEventListener('langchange', function(){
    refreshCol();
    if(tip.classList.contains('show')) show(nearest(lastX));
  });
})();
</script>
