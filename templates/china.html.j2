          <span class="pc">{{ n.prob_pct }}%</span>
        </div>
        {% endfor %}
        {% endif %}
        <p class="cnx-foot">⚖️ {{ t(pb_obj.honesty.en, pb_obj.honesty.zh) }}</p>
        {% endif %}
      </div>
    </div>
  </div>

