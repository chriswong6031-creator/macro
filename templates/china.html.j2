      <summary>
        <span>◌ {{ t('Legacy depth — classification pending', '旧版扩展名单 — 等待重新分类') }}
          <span class="cn-depth-sub">{{ t('persisted fallback data from the former board definition; collapsed and not represented as confirmed', '旧版榜单定义的持久化回退数据；已折叠，且不再表示为已确认') }}</span>
        </span>
        <span class="cn-depth-n">{{ _legacy_depth|length }}</span>
      </summary>
      {{ cn_depth_grid(_legacy_depth) }}
    </details>
