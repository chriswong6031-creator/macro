          <td>{{ s.pctile|round|int if s.pctile is not none else '—' }}</td>
          <td class="l"><span class="lad {{ 'up' if s.dir=='up' else ('down' if s.dir=='down' else 'flat') }}">{{ td(s.label or s.state) }}</span>{% if s.age_short %}<span class="agechip" title="when this signal last crossed">⏱ {{ t(s.age_short, s.age_short_zh) }}</span>{% endif %}{% if s.eq_badge %}<span class="eqmini eq-{{ s.eq_dir }}" title="{{ s.eq_tip }}">{{ s.eq_badge }}</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

