<script>
/* W8-E: StockTable init — standout board table view (CN market).
   Wired only on the stocks mode page (setups.buy exists); safe no-op if element absent. */
(function(){
  var SECZH = {"Technology":"科技","Industrials":"工业","Basic Materials":"原材料","Financial Services":"金融","Consumer Cyclical":"可选消费","Healthcare":"医疗保健","Utilities":"公用事业","Consumer Defensive":"必需消费","Energy":"能源","Communication Services":"通信服务","Real Estate":"房地产"};
  var STAGE_LABELS = {"ENTRY":["ENTRY","入场"],"RAN_LATE":["RAN/LATE","信号已过"],"RIPENING":["RIPENING","蓄势中"]};
  var ZONE_LABELS = {"READY":["READY","就绪"],"BASING":["BASING","筑底"],"FALLING":["FALLING","下跌"]};
  var TIER_ZH = {"PRIME":"极佳","CONFIRMED":"确认","CONFIRMING":"确认中","APPROACHING":"临近","FIRST SPARK":"首信号"};
  var b = StockTable._bi, esc = StockTable._esc, fp = StockTable._fmtPct, fn = StockTable._fmtNum, mg = StockTable._macdGlyph;

  function stageBadge(stage, zone) {
    if (!stage) return '<span class="st-muted">—</span>';
    var cls = stage === 'ENTRY' ? 'st-chip-entry' : stage === 'RAN_LATE' ? 'st-chip-ran' : zone === 'FALLING' ? 'st-chip-knife' : 'st-chip-rip';
    var lbl = stage === 'RIPENING' ? (zone || 'RIPENING') : stage;
    var lzh = ZONE_LABELS[lbl] ? ZONE_LABELS[lbl][1] : (STAGE_LABELS[lbl] ? STAGE_LABELS[lbl][1] : lbl);
    var len = ZONE_LABELS[lbl] ? ZONE_LABELS[lbl][0] : (STAGE_LABELS[lbl] ? STAGE_LABELS[lbl][0] : lbl);
    return '<span class="st-chip ' + cls + '">' + b(len, lzh) + '</span>';
  }

  /* Default view = 9 columns that fit a laptop viewport with no horizontal
     scroll (operator request 2026-07-10). Specialist columns (tier, theme,
     2W stoch, MACD, imminence, range%…) stay available via the Columns chooser. */
  var cols = [
    { key:'_stage_zone', labelEn:'Stage', labelZh:'阶段', default:true, sortable:false,
      fmt:function(v,r){ return stageBadge(r.stage||r._stage, r.zone); },
      tip:{en:'Signal stage and zone (rows are pre-ranked by system)',zh:'信号阶段与区域（行已按系统排序）'} },
    { key:'ticker', labelEn:'Ticker', labelZh:'代码', default:true, sortable:true,
      fmt:function(v,r){
        var fresh = (r.days_since_signal != null && r.days_since_signal <= 2);
        return (fresh ? '<span class="st-new-dot"></span>' : '') + '<b>' + esc(v||'') + '</b>';
      }},
    { key:'name', labelEn:'Name', labelZh:'名称', default:true, sortable:true, cls:'st-name',
      fmt:function(v,r){
        var parts = (v||'').split(' / ');
        return '<span class="l-en">' + esc(parts[0]||'') + '</span><span class="l-zh">' + esc(parts[1]||parts[0]||'') + '</span>';
      }},
    { key:'tier', labelEn:'Tier', labelZh:'级别', default:false, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return '<span class="st-chip st-chip-entry" style="font-size:9px;padding:1px 6px">' + b(esc(v), esc(TIER_ZH[v]||v)) + '</span>'; }},
    { key:'sector', labelEn:'Sector', labelZh:'板块', default:true, sortable:true, cls:'st-hide-sm',
      fmt:function(v){ if(!v) return '<span class="st-muted">—</span>';
        return b(esc(v), esc(SECZH[v]||v)); }},
    { key:'theme', labelEn:'Theme', labelZh:'主题', default:false, sortable:true,
      fmt:function(v,r){
        var en = (r.narrative&&r.narrative.theme)||r.theme||'';
        var zh = (r.narrative&&r.narrative.theme_zh)||r.theme_zh||'';
        if(!en&&!zh) return '<span class="st-muted">—</span>';
        return b(esc(en), esc(zh));
      }},
    { key:'price', labelEn:'Price', labelZh:'价格', default:true, sortable:true, right:true, cls:'st-hide-sm',
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fn(v,2); }},
    { key:'conviction', labelEn:'Score', labelZh:'评分', default:true, sortable:true, right:true,
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v); var cls = n>=70?'st-pos':n>=40?'':'st-neg';
        return '<span class="' + cls + '">' + n + '</span>'; },
      tip:{en:'Buy-readiness 0–100 (ENTRY rows only)',zh:'买入就绪度0–100（仅入场行）'} },
    { key:'mcap', labelEn:'Mkt cap', labelZh:'市值(亿)', default:true, sortable:true, right:true, cls:'st-hide-sm',
      fmt:function(v,r){ if(v==null) return '<span class="st-muted">—</span>';
        var b2 = r.cap_bucket; var cls = b2==='large'?'st-pos':b2==='small'?'st-neg':'';
        return '<span class="' + cls + '">' + fn(v,0) + '</span>'; },
      tip:{en:'Market cap (亿 RMB = 100M). — = unknown (placeholder); large ≥500 / mid 100-500 / small <100',zh:'市值（亿人民币）。— = 未知（占位符）；大盘≥500 / 中盘100-500 / 小盘<100'} },
    { key:'cap_bucket', labelEn:'Cap', labelZh:'市值档', default:false, sortable:true,
      fmt:function(v){ if(!v) return '<span class="st-muted">?</span>';
        var cls = v==='large'?'st-pos':v==='small'?'st-neg':'';
        return '<span class="' + cls + '">' + b(v, {large:'大盘',mid:'中盘',small:'小盘'}[v]||v) + '</span>'; }},
    { key:'off_high', labelEn:'Off High', labelZh:'距高点', default:true, sortable:true, right:true, cls:'st-hide-sm',
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v,1); }},
    { key:'spot_pct_in_range', labelEn:'Range%', labelZh:'区间位置', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fn(v,0)+'%'; },
      tip:{en:'Price position inside 2-year range (0=bottom, 100=top)',zh:'价格在2年区间内的位置（0=底部，100=顶部）'} },
    { key:'w2_stoch', labelEn:'2W Stoch', labelZh:'双周随机', default:false, sortable:true, right:true,
      fmt:function(v,r){
        if(v==null) return '<span class="st-muted">—</span>';
        var arr = r.w2_stoch_arrow; var arrowStr = arr===1?' ↑':arr===-1?' ↓':'';
        var cls = v<=20?'st-neg':v<=35?'':'st-pos';
        return '<span class="' + cls + '">' + fn(v,1) + arrowStr + '</span>';
      }, tip:{en:'2W StochRSI washout level. ≤35 = washout zone; arrow = direction',zh:'双周随机RSI洗盘水平。≤35=洗盘区；箭头=方向'} },
    { key:'macd_hist_d', labelEn:'MACD D/2D/3D', labelZh:'MACD多周期', default:false, sortable:false,
      fmt:function(v,r){ return mg(r.macd_hist_d, r.macd_d2, r.macd_d3); },
      tip:{en:'Daily / 2D / 3D MACD histogram direction (▲ pos / ▼ neg / · unknown)',zh:'日线/2日/3日MACD柱方向（▲正 / ▼负 / ·未知）'} },
    { key:'days_since_signal', labelEn:'Days', labelZh:'信号天数', default:true, sortable:true, right:true, cls:'st-hide-sm',
      fmt:function(v){ if(v==null) return '<span class="st-muted">—</span>';
        var n = parseInt(v);
        return n<=2 ? '<span class="st-pos">' + n + '</span>' : String(n); },
      tip:{en:'Days since first appearance on this board (from ledger; history starts 2026-06-30)',zh:'首次出现在本榜单的天数（账本自2026-06-30起）'} },
    { key:'imminence', labelEn:'Imminence', labelZh:'临近度', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>':
        '<span class="st-pos">~' + fn(v,1) + 'W</span>'; },
      tip:{en:'2W MACD bars until projected cross (ripening rows)',zh:'预计2W MACD穿越前的周期数（蓄势行）'} },
    { key:'ret_5d', labelEn:'5d Ret', labelZh:'5日涨跌', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v*100,1); }},
    { key:'alpha', labelEn:'Alpha', labelZh:'Alpha', default:false, sortable:true, right:true,
      fmt:function(v){ return v==null?'<span class="st-muted">—</span>': fp(v*100,2); },
      tip:{en:'Sector-neutral residual alpha (display context only)',zh:'板块中性残差Alpha（仅供参考）'} },
  ];

  /* Filter dropdown labels — single active language per option (operator request:
     EN/ZH never shown together in the filter row). */
  var SECTOR_LABELS = {};
  Object.keys(SECZH).forEach(function(k){ SECTOR_LABELS[k] = [k, SECZH[k]]; });
  var OPTION_LABELS = {
    stage: { 'ENTRY':['Entry','入场'], 'RAN_LATE':['Ran / late','信号已过'],
             'RIPENING':['Ripening','蓄势中'], 'KNIFE':['Falling knife','下跌中'] },
    zone:  { 'READY':['Ready','就绪'], 'BASING':['Basing','筑底'], 'FALLING':['Falling','下跌'] },
    capBucket: { 'large':['Large cap','大盘'], 'mid':['Mid cap','中盘'], 'small':['Small cap','小盘'] },
    sector: SECTOR_LABELS,
  };

  // Set the internal key for the stage+zone column to something that won't collide
  // with a real row field
  cols[0].key = '_stage_zone_display';

  /* ── view persistence ── */
  var LS_VIEW = 'mdx_stocktable_cn_view';
  var currentView = localStorage.getItem(LS_VIEW) || 'grid';

  function applyView(v) {
    currentView = v;
    localStorage.setItem(LS_VIEW, v);
    var standouts = document.getElementById('standouts');
    var chipsEl   = document.getElementById('st-count-chips');
    var gbtn = document.getElementById('st-btn-grid');
    var tbtn = document.getElementById('st-btn-table');
    if (!standouts) return;
    if (v === 'table') {
      standouts.classList.add('st-table-mode');
      if (chipsEl) chipsEl.style.display = '';
      if (gbtn) gbtn.setAttribute('aria-selected','false');
      if (tbtn) tbtn.setAttribute('aria-selected','true');
    } else {
      standouts.classList.remove('st-table-mode');
      if (chipsEl) chipsEl.style.display = 'none';
      if (gbtn) gbtn.setAttribute('aria-selected','true');
      if (tbtn) tbtn.setAttribute('aria-selected','false');
    }
  }

  StockTable._setView = applyView;

  /* ── init ── */
  StockTable.init({
    dataId: 'stocktable-data',
    containerId: 'stocktable-wrap',
    market: 'cn',
    linkPattern: 'china_lookup.html#{ticker}',
    columns: cols,
    optionLabels: OPTION_LABELS,
    searchPlaceholder: ['Search name or theme…','搜索名称或主题…'],
  });

  /* restore persisted view */
  applyView(currentView);
})();
</script>
<script>
  // keep tooltips on-screen: flip below near the top of the viewport, and anchor to
  // the nearest side when the help icon is close to the left/right edge
  document.addEventListener('mouseover', function (e) {
    var h = e.target.closest('.help'); if (!h) return;
    var r = h.getBoundingClientRect();
    h.classList.toggle('below', r.top < 340);
    var tip = h.querySelector('.tip');
    var half = ((tip && tip.offsetWidth) || 300) / 2 + 16;
    h.classList.remove('edge-right', 'edge-left');
    if (r.left + r.width / 2 + half > window.innerWidth) h.classList.add('edge-right');
    else if (r.left + r.width / 2 - half < 0) h.classList.add('edge-left');
  });
</script>
<script>
/* Caution icon popover — tap-to-toggle on mobile, hover on desktop via CSS.
   Also corrects popover position (flip above/below, clamp to right edge). */
(function(){
  function placePop(wrap){
    var pop = wrap.querySelector('.nb-cau-pop');
    if (!pop) return;
    var r = wrap.getBoundingClientRect();
    wrap.classList.toggle('pop-below', r.top < 180);
    wrap.classList.toggle('pop-right', r.left > window.innerWidth - 200);
  }
  /* Tap the button → toggle open/closed */
  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('.nb-cau-btn');
    if (btn){
      e.preventDefault(); e.stopPropagation();
      var wrap = btn.closest('.nb-cau');
      if (!wrap) return;
      var wasOpen = wrap.classList.contains('nb-cau-open');
      /* close any other open popovers */
      document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      if (!wasOpen){ placePop(wrap); wrap.classList.add('nb-cau-open'); }
    } else {
      /* outside tap: close all */
      if (!e.target.closest('.nb-cau-pop')){
        document.querySelectorAll('.nb-cau.nb-cau-open').forEach(function(el){ el.classList.remove('nb-cau-open'); });
      }
    }
  }, true);
  /* Also position-correct on hover (desktop) */
  document.addEventListener('pointerover', function(e){
    var wrap = e.target.closest && e.target.closest('.nb-cau');
    if (wrap) placePop(wrap);
  }, true);
})();
</script>
</body>
