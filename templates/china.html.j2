  <!-- AI Brief dialog — aib-* rich structure (ported from dashboard.html.j2; scoped to body.page-china) -->
  <div class="cnx-dlg" id="cnx-dlg-aibrief">
    <div class="cnx-dlg-backdrop" onclick="cnxCloseDlg()"></div>
    <div class="cnx-dlg-panel">
      <div class="cnx-dlg-head"><span class="cnx-dlg-title"><span class="l-en">AI Brief — China Synthesis</span><span class="l-zh">AI简报 — 中国综合</span></span><button class="cnx-dlg-close" onclick="cnxCloseDlg()">×</button></div>
      <div class="cnx-dlg-body">
        {# ABX v2 — the ONE shared body renderer. China lens; no catalysts (china_brief
           has no forward_watch). The nightly receipt is injected into the footer slot. #}
        {% if china_brief and (china_brief.get('summary') or china_brief.get('tldr') or china_brief.get('regime_read')) %}
        {% call aib.aibrief_body(china_brief, 'china', show_catalysts=False) %}
        <div class="cnx-receipt">{{ t('Research context only — not a signal. Generated nightly from the dashboards; full brief at','仅供研究参考 — 非交易信号。每晚由看板生成；完整简报位于') }} <a href="aibrief.html">aibrief.html</a>.</div>
        {% endcall %}
        {% else %}
