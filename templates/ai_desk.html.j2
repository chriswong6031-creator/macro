{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>AI Desk — {{ as_of }}</title>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1100px)/2)); } }
  a { text-decoration:none; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:15px; margin:0 0 8px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .muted { color:var(--muted); }
  .sm { font-size:13px; }
  .mono { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; }
  /* thesis cards */
  .thesis { border:1px solid var(--line); border-radius:9px; padding:12px 14px; margin:10px 0;
            background:var(--bg); }
  .thesis-head { display:flex; flex-wrap:wrap; align-items:center; gap:9px; margin-bottom:6px; }
  .thesis-subj { font-weight:700; font-size:15px; }
  .chip { border-radius:999px; padding:3px 10px; font:600 12px/1 inherit; border:1px solid var(--line); }
  .chip.ow { background:rgba(34,160,90,.14); color:#1f9d57; border-color:rgba(34,160,90,.4); }
  .chip.uw, .chip.avoid { background:rgba(210,70,70,.14); color:#cf4b4b; border-color:rgba(210,70,70,.4); }
  .chip.fade { background:rgba(70,120,210,.14); color:#3f72d6; border-color:rgba(70,120,210,.4); }
  .chip.conv { background:var(--grid); color:var(--muted); }
  .thesis .body { margin:6px 0; }
  .thesis .row { margin:6px 0; }
  .thesis .k { font-weight:600; color:var(--link); margin-right:4px; }
  .thesis .dissent { background:rgba(210,140,40,.10); border-left:3px solid rgba(210,140,40,.6);
                     padding:6px 10px; border-radius:0 6px 6px 0; margin:6px 0; }
  .thesis .fals { background:var(--grid); border-radius:6px; padding:7px 10px; margin:6px 0; }
  ul.ev { margin:4px 0 0 18px; padding:0; } ul.ev li { margin:2px 0; }
  /* track-record badge */
  .tr-grid { display:flex; flex-wrap:wrap; gap:10px; margin:8px 0 0; }
  .tr-cell { border:1px solid var(--line); border-radius:8px; padding:8px 12px; min-width:96px; }
  .tr-cell .v { font-size:18px; font-weight:700; } .tr-cell .l { font-size:11px; color:var(--muted); }
  /* panel accordion */
  details.panel-acc { margin:8px 0 0; }
  details.panel-acc > summary { cursor:pointer; font-weight:600; color:var(--link); }
  .stance { border:1px solid var(--line); border-radius:8px; padding:9px 11px; margin:8px 0; }
  .stance .role { font-weight:700; text-transform:capitalize; }
  .stance .risk { color:var(--muted); font-size:12px; margin-top:4px; }
  .out-hit { color:#1f9d57; font-weight:700; } .out-miss { color:#cf4b4b; font-weight:700; }
  .out-open { color:var(--muted); }
  table.rec { width:100%; border-collapse:collapse; font-size:12.5px; margin-top:6px; }
  table.rec th, table.rec td { text-align:left; padding:5px 8px; border-bottom:1px solid var(--line); }
</style>
</head>
<body>

<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <a class="ai-brief-link active" href="ai_desk.html">🖥️ {{ t('AI Desk', 'AI交易台') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="panel">
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px">
    <h1>🖥️ {{ t('AI Desk', 'AI交易台') }}</h1>
    <span class="muted">{{ t('accountable, falsifiable leans on the trust-graded detectors — graded over time', '在可信分级检测器之上的可问责、可证伪倾向 — 并持续打分') }}</span>
  </div>
  <p class="muted sm" style="margin:10px 0 0">{{ t(
    'An AI analyst PANEL (opportunity / skeptic / base-rate / structural) reads the thematic-flow and relief-radar detectors, and a desk-head adjudicates a short set of directional leans. Each lean ships with the bear case (dissent) and a CONCRETE falsifier + check-by date, and is scored against realised prices so conviction is earned, not asserted. RESEARCH CONTEXT ONLY: a lean is a direction, never a position size or a trade — the detectors are display-only (the flow lens has no validated forward edge; the relief snap is coincident). Regenerated each day after the close.',
    '一个 AI 分析师小组（机会派／怀疑派／基率派／结构派）研读主题资金流与避险雷达检测器，再由“交易台主管”裁决出一小组方向性倾向。每个倾向都附带反方观点（异议）与一个具体的证伪条件＋检验日期，并对照真实价格打分 — 信心由战绩赢得，而非自我宣称。仅供研究参考：倾向只是方向，绝非仓位或交易 — 检测器仅作展示（资金流无经验证的前瞻性，避险信号为同步指标）。每个交易日收盘后更新。') }}</p>
</div>

{# All content is client-fetched from ai_desk.json (written by engine/ai_desk.py) and
   rendered by ai_desk.js — this page does no data work and is order-independent. #}
<div id="desk-root" data-src="ai_desk.json">
  <div class="panel muted sm">{{ t('Loading the AI desk note… it regenerates daily after the close.', '正在加载 AI 交易台笔记…每个交易日收盘后更新。') }}</div>
</div>

<div class="panel">
  <p class="muted" style="font-size:12px;margin:0">{{ t('AI research context, not investment advice — leans are generated by an LLM and graded mechanically; they can be wrong. Nothing here feeds a score, signal, or allocation.', 'AI 研究背景，非投资建议 — 倾向由大模型生成并以机械方式打分，可能出错。此处内容不参与任何评分、信号或仓位。') }}
    {% if as_of %} · {{ t('Page built', '页面生成于') }} {{ as_of }}{% endif %}</p>
</div>

<script src="theme.js"></script>
<script src="ai_desk.js"></script>
<footer class="site-footer">
  <span class="made">© 2026 Mastermind Inc</span>
</footer>
</body>
</html>
