{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% macro bl(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{# bilingual helpers for controlled-vocab codes + provenance tags — translate without touching data #}
{% set _CONF_TR = [['medium-high','中高'],['low-medium','中低'],['high','高'],['medium','中'],['low','低']] %}
{% set _BASIS_TR = [
  ['execution slipping','执行滑期'],['headline-fragile','易受头条扰动'],['truce caveat','休战告诫'],
  ['Miran role','Miran 角色'],['FACT','事实'],['INFERENCE','推断'],['PRIOR','先验'],['THEORY','理论'],
  ['CORRECTED','已更正'],['CAVEAT','告诫'],['charter','章程'],['directive','指令'],['proxies','代理'],
  ['mechanism','机制'],['read','解读'],['budget','预算'],['tariff','关税'],['ceasefire','停火'],
  ['conflict','冲突'],['oil','油价'],['deal','协议']
] %}
{% set _THREAD  = {'fed':'美联储','treasury':'财政部','policy':'政策','rotation':'轮动','china':'中国','iran':'伊朗','nato':'北约','dollar':'美元','debasement':'去货币化'} %}
{% set _TIER    = {'policy-action':'政策行动','market-outcome':'市场结果'} %}
{% set _STATUS  = {'open':'未结','hit':'命中','miss':'落空','pending':'待定'} %}
{% set _VERDICT = {'working':'达标','lagging':'落后','mixed':'混合'} %}
{% set _STANCE  = {'hawkish':'鹰派','dovish':'鸽派','neutral':'中性 / 按兵','unknown':'未知'} %}
{% set _LEAN    = {'overweight':'超配','underweight':'低配','avoid':'回避'} %}
{% set _ACTOR   = {'FED':'美联储','ADMIN':'行政当局','POLICY':'政策','ADMIN ':'行政当局'} %}
{% set _KIND    = {'rel_return':'相对收益核验','soft':'软性','level':'水平'} %}
{# exact-enum: english in en-mode, mapped value in zh-mode (falls back to original) #}
{% macro code(val, m) -%}
<span class="l-en">{{ val }}</span><span class="l-zh">{{ m.get(val, val) }}</span>
{%- endmacro %}
{# token-replace: translate recognized tokens in a free-form provenance tag, leave the rest #}
{% macro tr(s, pairs) -%}
{% set ns = namespace(v=s) %}{% for a, b in pairs %}{% set ns.v = ns.v|replace(a, b) %}{% endfor -%}
<span class="l-en">{{ s }}</span><span class="l-zh">{{ ns.v }}</span>
{%- endmacro %}

{% block title %}Fed & Policy Watch — Macro Dashboard{% endblock %}

{%- block head_extra %}
{% set seo_title = "Fed & Policy Watch — Mastermind" %}
{% set seo_desc = "The Fed's path, real-time policy expectations and what would change them — read from market prices, updated daily." %}
{% set seo_path = "policy_watch.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  /* callouts (this page extends report_base, not article_base) */
  .callout { border-radius:12px; padding:14px 17px; margin:14px 0; border:1px solid var(--line); background:var(--panel2); font-size:14px; line-height:1.6; }
  .callout .co-h { font-weight:700; display:block; margin-bottom:4px; }
  .callout.key  { border-left:4px solid #46b87a; background:color-mix(in srgb,#46b87a 8%,var(--panel2)); }
  .callout.warn { border-left:4px solid var(--warn); background:color-mix(in srgb,var(--warn) 9%,var(--panel2)); }
  .pw-hero { max-width:1060px; margin:18px auto 0; }
  .pw-hero .eyebrow { font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--link); font-weight:600; margin:0 0 8px; }
  .pw-hero h1 { font-size:29px; margin:0 0 8px; letter-spacing:-.01em; }
  html[data-lang="zh"] .pw-hero h1 { letter-spacing:0; }
  .pw-hero .lens { font-size:12px; color:var(--muted); }
  .pw-wrap { max-width:1060px; margin:0 auto; }
  h2.sec { font-size:19px; margin:30px 0 8px; padding-top:6px; display:flex; align-items:baseline; gap:9px; border-top:1px solid var(--line); padding-top:18px; }
  h3.sub { font-size:14px; margin:16px 0 6px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .lede { font-size:14px; line-height:1.6; }
  /* basis / status / confidence badges */
  .b { display:inline-block; font-size:10px; font-weight:700; letter-spacing:.03em; padding:2px 7px; border-radius:6px; white-space:nowrap; }
  .b-fact { color:#1f9a55; background:color-mix(in srgb,#1f9a55 13%,transparent); }
  .b-inf  { color:#c77dff; background:color-mix(in srgb,#c77dff 14%,transparent); }
  .b-prior{ color:#e0973a; background:color-mix(in srgb,#e0973a 14%,transparent); }
  .b-open { color:var(--muted); background:var(--panel2); }
  .b-hit  { color:#1f9a55; background:color-mix(in srgb,#1f9a55 13%,transparent); }
  .b-miss { color:#d23f3f; background:color-mix(in srgb,#d23f3f 13%,transparent); }
  .th-fed{color:#c77dff}.th-treasury{color:#3fb6c0}.th-policy{color:#5b8def}.th-rotation{color:#46b87a}.th-debasement{color:#e0973a}.th-dollar{color:#3fb6c0}
  .conf { font-size:11px; color:var(--muted); }
  /* task-force + lever cards */
  .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:12px; margin:12px 0; }
  .card { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; }
  .card .cn { font-weight:700; font-size:14.5px; margin:0 0 2px; }
  .card .cmeta { font-size:11px; color:var(--muted); margin-bottom:7px; display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .card .cch { font-size:12.5px; line-height:1.5; margin:5px 0; }
  .card .crp { font-size:12.5px; line-height:1.5; color:var(--text); opacity:.86; border-left:2px solid var(--link); padding-left:9px; margin-top:7px; }
  .card .crp b { color:var(--link); font-weight:600; }
  table.data { border-collapse:collapse; width:100%; font-size:12.5px; margin:10px 0; }
  table.data th { text-align:left; padding:7px 9px; background:var(--panel2); color:var(--muted); font-weight:600; border-bottom:2px solid var(--line); }
  table.data td { padding:7px 9px; border-bottom:1px solid var(--line); vertical-align:top; }
  table.data tr:hover td { background:var(--panel2); }
  .prox { font-family:ui-monospace,Menlo,monospace; font-size:11px; }
  .led-stat { display:flex; gap:18px; flex-wrap:wrap; margin:8px 0 4px; font-size:12.5px; color:var(--muted); }
  .led-stat b { color:var(--text); font-size:16px; }
  .monitor a { color:var(--link); }
  .monitor li { margin:5px 0; font-size:13px; }
  .srcs { font-size:11.5px; color:var(--muted); word-break:break-word; }
  .srcs a { color:var(--link); }
  /* intel staleness age chip */
  .pw-age-chip { display:inline-flex; align-items:center; gap:5px; padding:3px 10px; border-radius:20px; font-size:11px; font-weight:700; letter-spacing:.03em; margin-top:6px; }
  .pw-age-chip.age-ok     { background:color-mix(in srgb,#46b87a 13%,var(--panel2)); color:#46b87a; border:1px solid color-mix(in srgb,#46b87a 30%,transparent); }
  .pw-age-chip.age-amber  { background:color-mix(in srgb,var(--warn) 13%,var(--panel2)); color:var(--warn); border:1px solid color-mix(in srgb,var(--warn) 30%,transparent); }
  .pw-age-chip.age-red    { background:color-mix(in srgb,#d23f3f 13%,var(--panel2)); color:#d23f3f; border:1px solid color-mix(in srgb,#d23f3f 30%,transparent); }
{% endblock %}

{% block content %}
<section class="pw-hero">
  <p class="eyebrow">🏛️ {{ t('Fed & Policy Watch', '美联储与政策观察') }}</p>
  <h1>{{ t('Fed & Policy Watch', '美联储与政策观察') }}</h1>
  <p class="lens">{{ t('Realpolitik / revealed-preference lens · non-partisan · as of', '现实政治／显示性偏好视角 · 非党派 · 截至') }} {{ intel.as_of }}</p>
  {% if dates and dates.staleness and dates.staleness.age_days is not none %}
  {% set _age = dates.staleness.age_days %}
  {% set _age_cls = 'age-red' if _age > 14 else ('age-amber' if _age > 7 else 'age-ok') %}
  <div>
    <span class="pw-age-chip {{ _age_cls }}">
      <span class="l-en">intel {{ _age }}d old</span>
      <span class="l-zh">情报已{{ _age }}天未更新</span>
    </span>
  </div>
  {% endif %}
</section>

<div class="pw-wrap">

  {% if scorecard %}
  <div class="led-stat" style="margin-top:14px;font-size:13px">
    <span><b>{{ scorecard.predictions.total }}</b> {{ t('predictions', '预测') }} ({{ scorecard.predictions.resolved }} {{ t('resolved', '已结') }}{% if scorecard.predictions.hit_rate is not none %}, {{ (scorecard.predictions.hit_rate*100)|round|int }}% {{ t('hit', '命中') }}{% endif %}{% if scorecard.predictions.overdue %}, <span class="r-neg">{{ scorecard.predictions.overdue }} {{ t('due', '待结') }}</span>{% endif %})</span>
    <span>{{ t('rotation', '轮动') }}: <span class="r-pos">{{ scorecard.rotation.working }} {{ t('working', '达标') }}</span> · <span class="r-neg">{{ scorecard.rotation.lagging }} {{ t('lagging', '落后') }}</span></span>
    {% if scorecard.stance %}<span>{{ t('Fed', '美联储') }}: <b>{{ code(scorecard.stance.current, _STANCE) }}</b>{% if scorecard.stance.days is not none %} {{ scorecard.stance.days }}{{ t('d', '天') }}{% endif %}{% if scorecard.stance.changed_recently %} <span class="b b-open">{{ t('shifted', '转变') }}</span>{% endif %}</span>{% endif %}
    <span>{{ t('intel', '情报') }}: {% if scorecard.intel.stale %}<span class="r-neg">{{ scorecard.intel.age_days }}{{ t('d old', '天') }}</span>{% else %}{{ t('fresh', '最新') }}{% endif %}</span>
  </div>
  {% if scorecard.rotation.sharpest_divergence %}
  {% set _sd = scorecard.rotation.sharpest_divergence %}
  {% set _sd_zh = (intel.rotation.targeted | selectattr('theme_en', 'equalto', _sd.theme) | map(attribute='theme_zh') | first) or _sd.theme %}
  <div class="callout warn">⚠ <b>{{ t('Sharpest divergence', '最大背离') }}:</b> {{ t('the map targets', '地图看好') }} <b>{{ bl(_sd.theme, _sd_zh) }}</b> {{ t('but it is lagging SPY by', '但其跑输标普') }} {{ '%.1f'|format(_sd.rel*100) }}% — {{ t('evidence against that leg of the rotation thesis.', '是对该轮动判断的反证。') }}</div>
  {% endif %}
  {% endif %}

  {% if dates and dates.staleness and dates.staleness.stale %}
  <div class="callout warn" style="margin-top:16px">⏳ <b>{{ t('Intel is', '情报已') }} {{ dates.staleness.age_days }} {{ t('days old', '天未更新') }}</b> — {{ t('re-verify before acting; this layer is time-sensitive (truces, ceasefires and pending rulings move).', '行动前请重新核实；该层具时效性（休战、停火与待决裁决随时变化）。') }}{% if dates.overdue_predictions %} · {{ dates.overdue_predictions }} {{ t('prediction(s) past check-by', '条预测已过核查日') }}{% endif %}</div>
  {% endif %}

  <div class="callout key" style="margin-top:16px">
    <span class="co-h">{{ t('The thesis', '核心论点') }}</span>
    {{ bl(intel.thesis.en, intel.thesis.zh) }}
  </div>
  <div class="callout warn">
    <span class="co-h">{{ t('Narrative vs revealed interest', '叙事 vs 真实利益') }}</span>
    {{ bl(intel.regime_read.en, intel.regime_read.zh) }}
  </div>

  <!-- ================= CATALYST SPINE ================= -->
  {% if catalysts and catalysts.spine %}
  {% set _WEIGHT = {'high':'高','medium':'中','low':'低'} %}
  {% set _wcls = {'high':'b-inf','medium':'b-prior','low':'b-open'} %}
  <h2 class="sec">🗓️ {{ t('Catalyst spine — inflation to decision', '催化剂主线 — 从通胀到决议') }}</h2>
  <p class="lede" style="color:var(--muted)">{{ bl(catalysts.intro_en, catalysts.intro_zh) }}</p>
  <table class="data">
    <tr><th>{{ t('Date', '日期') }}</th><th>{{ t('Event', '事件') }}</th><th>{{ t('Impact', '影响') }}</th><th>{{ t('Read', '解读') }}</th></tr>
    {% for c in catalysts.spine %}
    <tr{% if c.key %} style="background:color-mix(in srgb,var(--link) 7%,transparent)"{% endif %}>
      <td style="white-space:nowrap">
        <strong>{{ c.date }}</strong><br>
        <span class="conf">{{ bl(c.when_en, c.when_zh) }}</span>
        {% if c.days_to is not none %}<br><span class="b {{ 'b-open' if c.past else 'b-fact' }}">{% if c.past %}{{ t('passed', '已过') }}{% elif c.days_to == 0 %}{{ t('today', '今日') }}{% elif c.days_to == 1 %}{{ t('tomorrow', '明日') }}{% else %}{{ t('in', '剩') }} {{ c.days_to }}{{ t('d', '天') }}{% endif %}</span>{% endif %}
      </td>
      <td>{% if c.key %}★ {% endif %}<strong>{{ bl(c.event_en, c.event_zh) }}</strong></td>
      <td><span class="b {{ _wcls.get(c.weight, 'b-open') }}">{{ code(c.weight, _WEIGHT) }}</span></td>
      <td>{{ bl(c.note_en, c.note_zh) }}</td>
    </tr>
    {% endfor %}
  </table>
  <p class="conf">{{ t('★ = the catalysts that actually move the decision (June CPI → the July 28–29 FOMC). Each hot print ratchets hike odds; PCE is largely pre-figured. Display / context only.', '★ = 真正影响决议的催化剂（6月CPI → 7月28–29日FOMC）。每次偏热读数都上调加息概率；PCE 大体已被预定。仅供展示／参考。') }}</p>
  {% endif %}

  <!-- ================= INTENT DESK (LLM, accountable) ================= -->
  {% if desk %}
  <h2 class="sec">🤖 {{ t('Intent Desk — accountable realpolitik leans', '意图台 — 可问责的现实政治判断') }}</h2>
  <p class="lede" style="color:var(--muted)">{{ t('An LLM reads the sourced intel + live market state and emits dated, FALSIFIABLE leans (a proxy ticker vs SPY) that are scored over time. Context only — never a size or a trade; intent is a tracked hypothesis, not an oracle.',
      '由LLM读取来源情报+实时市场状态，给出有日期、可证伪的判断（某代理标的 vs SPY），并随时间评分。仅供参考——绝非仓位或交易；意图是被追踪的假设，而非神谕。') }}</p>
  {% if desk.regime_context %}<div class="callout">{{ bl(desk.regime_context, desk.regime_context_zh) }}</div>{% endif %}
  {% if desk.track_record and desk.track_record.overall and desk.track_record.overall.n %}
  <div class="led-stat">
    <span><b>{{ desk.track_record.overall.n }}</b> {{ t('scored', '已评分') }}</span>
    {% if desk.track_record.overall.hit_rate is not none %}<span><b>{{ (desk.track_record.overall.hit_rate*100)|round|int }}%</b> {{ t('not falsified', '未被证伪') }}</span>{% endif %}
    {% if desk.track_record.open %}<span>{{ desk.track_record.open }} {{ t('open', '未结') }}</span>{% endif %}
    <span class="conf">{{ bl(desk.track_record.calibration_note, desk.track_record.calibration_note_zh) }}</span>
  </div>
  {% endif %}
  {% if desk.theses %}
  <div class="cards">
    {% for th in desk.theses %}
    <div class="card">
      <div class="cn"><span class="th-{{ 'fed' if th.actor=='fed' else 'policy' }}">{{ code((th.actor or 'admin')|upper, _ACTOR) }}</span> · {{ th.subject }} — <span class="b {{ 'b-fact' if th.lean=='overweight' else 'b-miss' }}">{{ code(th.lean, _LEAN) }}</span></div>
      <div class="cmeta">
        <span class="conf">{{ tr(th.conviction, _CONF_TR) }} {{ t('conviction', '置信') }}</span>
        <span class="b b-open">{{ t('check by', '核查于') }} {{ th.check_by }}</span>
        <span class="conf">{{ code(th.falsifier.check.kind if th.falsifier and th.falsifier.check else 'soft', _KIND) }}</span>
      </div>
      <div class="cch">{{ bl(th.thesis, th.thesis_zh) }}</div>
      {% if th.dissent %}<div class="cch" style="color:var(--muted)"><b>{{ t('Dissent', '反方') }}:</b> {{ bl(th.dissent, th.dissent_zh) }}</div>{% endif %}
      {% if th.falsifier and th.falsifier.text %}<div class="crp"><b>{{ t('Falsifier', '证伪条件') }}:</b> {{ bl(th.falsifier.text, th.falsifier.text_zh) }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% elif desk.degraded_reason %}
  <div class="callout warn">{{ t('Desk note pending — the LLM layer generates in CI (needs the model key).', '台注待生成 —— LLM层在CI中生成（需模型密钥）。') }} <span class="conf">({{ desk.degraded_reason }})</span></div>
  {% endif %}
  <p class="conf">{{ bl(desk.disclaimer, desk.disclaimer_zh) }}</p>
  {% endif %}

  <!-- ================= THE FED ================= -->
  <h2 class="sec">🏦 {{ t('The Fed under Warsh', '沃什治下的美联储') }}</h2>
  <p class="lede">{{ bl(intel.fed.profile.en, intel.fed.profile.zh) }}</p>

  {% if fed_stance and fed_stance.stance != 'unknown' %}
  {% set scls = 'b-miss' if fed_stance.color=='down' else ('b-fact' if fed_stance.color=='up' else 'b-open') %}
  <div class="callout">
    <span class="co-h">{{ t('Reaction function (explicit, display-only)', '反应函数（显式，仅展示）') }}
      <span class="b {{ scls }}">{{ bl(fed_stance.label_en, fed_stance.label_zh) }}</span>{% if fed_hist and fed_hist.days_in_stance is not none %} <span class="conf">{{ t('for', '已持续') }} {{ fed_hist.days_in_stance }}{{ t('d', '天') }} ({{ t('since', '自') }} {{ fed_hist.since }}){% if fed_hist.changed_recently %} <span class="b b-open">{{ t('recently shifted', '近期转变') }}</span>{% endif %}</span>{% endif %}</span>
    {% if fed_stance.drivers_en %}<span class="l-en">{{ fed_stance.drivers_en | join(' · ') }}</span><span class="l-zh">{{ fed_stance.drivers_zh | join(' · ') }}</span>. {% endif %}
    <span class="conf">{{ bl(fed_stance.note_en, fed_stance.note_zh) }}</span>
  </div>
  {% endif %}

  {% if intel.fed.optionality_read %}
  <div class="callout warn">
    <span class="co-h">{{ t('Pivot infrastructure — the 6/24 read', '转向基础设施 —— 6/24 解读') }}
      <span class="b b-inf">{{ tr(intel.fed.optionality_read.basis, _BASIS_TR) }}</span> <span class="conf">{{ tr(intel.fed.optionality_read.confidence, _CONF_TR) }}</span></span>
    {{ bl(intel.fed.optionality_read.en, intel.fed.optionality_read.zh) }}
  </div>
  {% endif %}

  <h3 class="sub">{{ t('Reform task forces — dated, falsifiable', '改革工作组 — 有日期、可证伪') }}</h3>
  <div class="cards">
    {% for tf in intel.fed.task_forces %}
    <div class="card">
      <div class="cn">{{ bl(tf.name_en, tf.name_zh) }}</div>
      <div class="cmeta">
        <span class="b b-open">{{ t('check by', '核查于') }} {{ tf.check_by }}</span>
        {% set td = (dates.task_forces[tf.id] if dates and dates.task_forces and tf.id in dates.task_forces else None) %}
        {% if td and td.days_to is not none %}{% if td.overdue %}<span class="b b-miss">{{ t('overdue', '已逾期') }}</span>{% else %}<span class="conf">{{ t('in', '剩') }} {{ td.days_to }}{{ t('d', '天') }}</span>{% endif %}{% endif %}
        <span class="b {{ 'b-fact' if 'FACT' in tf.basis else 'b-inf' }}">{{ tr(tf.basis, _BASIS_TR) }}</span>
        <span class="conf">{{ tr(tf.confidence, _CONF_TR) }}</span>
      </div>
      <div class="cch">{{ bl(tf.charter_en, tf.charter_zh) }}</div>
      <div class="crp"><b>{{ t('Realpolitik read', '现实政治解读') }}:</b> {{ bl(tf.realpolitik_en, tf.realpolitik_zh) }}</div>
    </div>
    {% endfor %}
  </div>
  <p class="lede" style="color:var(--muted)">⏳ {{ bl(intel.fed.staffing_note.en, intel.fed.staffing_note.zh) }}</p>

  <!-- ================= THE ADMINISTRATION ================= -->
  <h2 class="sec">🇺🇸 {{ t('The Administration', '行政当局') }}</h2>
  <p class="lede">{{ bl(intel.administration.grand_strategy.en, intel.administration.grand_strategy.zh) }}</p>
  <p class="conf">{{ t('Decision-makers tracked', '追踪的决策者') }}: <span class="l-en">{{ intel.administration.decision_makers | join(' · ') }}</span><span class="l-zh">{{ (intel.administration.decision_makers_zh if intel.administration.decision_makers_zh else intel.administration.decision_makers) | join(' · ') }}</span></p>

  <h3 class="sub">{{ t('Verified policy levers', '已核实的政策杠杆') }}</h3>
  <div class="cards">
    {% for lv in intel.administration.verified_levers %}
    <div class="card">
      <div class="cn">{{ bl(lv.title_en, lv.title_zh) }}</div>
      <div class="cmeta">
        <span class="b {{ 'b-fact' if lv.basis.startswith('FACT') else 'b-inf' }}">{{ tr(lv.basis, _BASIS_TR) }}</span>
        <span class="conf">{{ tr(lv.confidence, _CONF_TR) }}</span>
      </div>
      <div class="cch">{{ bl(lv.detail_en, lv.detail_zh) }}</div>
    </div>
    {% endfor %}
  </div>
  <h3 class="sub">{{ t('Geopolitical theaters', '地缘政治战区') }}</h3>
  <div class="cards">
    {% for th in intel.administration.theaters %}
    <div class="card">
      <div class="cn">{{ bl(th.title_en, th.title_zh) }}</div>
      <div class="cmeta">
        <span class="b {{ 'b-fact' if th.basis.startswith('FACT') else 'b-prior' }}">{{ tr(th.basis, _BASIS_TR) }}</span>
        <span class="conf">{{ tr(th.confidence, _CONF_TR) }}</span>
      </div>
      <div class="cch">{{ bl(th.facts_en, th.facts_zh) }}</div>
      <div class="crp"><b>{{ t('Realpolitik', '现实政治') }}:</b> {{ bl(th.realpolitik_en, th.realpolitik_zh) }}</div>
      <div class="cch" style="margin-top:6px"><b>💰 {{ t('Capital', '资本') }}:</b> {{ bl(th.capital_en, th.capital_zh) }}</div>
    </div>
    {% endfor %}
  </div>

  <!-- ================= CAPITAL ROTATION ================= -->
  <h2 class="sec">🧭 {{ t('Capital-rotation map', '资本轮动地图') }}</h2>
  <h3 class="sub">🎯 {{ t('Targeted / protected / subsidized', '受益 / 受保护 / 受补贴') }}</h3>
  <table class="data">
    <tr><th>{{ t('Theme', '主题') }}</th><th>{{ t('Mechanism', '机制') }}</th><th>{{ t('Proxies', '代理标的') }}</th><th>{{ t('Realized 63d vs SPY', '近63日 vs 标普') }}</th><th>{{ t('Basis', '依据') }}</th></tr>
    {% for r in intel.rotation.targeted %}
    <tr>
      <td><strong>{{ bl(r.theme_en, r.theme_zh) }}</strong></td>
      <td>{{ bl(r.mechanism_en, r.mechanism_zh) }}</td>
      <td class="prox">{{ r.proxies | join(' ') if r.proxies else '—' }}</td>
      <td class="num">{% set rc = (rot.themes[r.theme_en] if rot and rot.themes and (r.theme_en in rot.themes) else None) %}{% set rh = (rot_hist[r.theme_en] if rot_hist and (r.theme_en in rot_hist) else None) %}{% if rc and rc.verdict != 'na' %}<span class="b {{ {'working':'b-fact','lagging':'b-miss','mixed':'b-open'}[rc.verdict] }}">{{ code(rc.verdict, _VERDICT) }}</span> {{ '%+.1f'|format(rc.avg_rel*100) }}%{% if rh and rh.reads %}<br><span class="conf">{{ t('working', '达标') }} {{ rh.working }}/{{ rh.reads }}</span>{% endif %}{% else %}<span class="conf">—</span>{% endif %}</td>
      <td><span class="b {{ 'b-prior' if 'PRIOR' in r.basis else ('b-fact' if 'FACT' in r.basis else 'b-inf') }}">{{ tr(r.basis, _BASIS_TR) }}</span><br><span class="conf">{{ tr(r.confidence, _CONF_TR) }}</span></td>
    </tr>
    {% endfor %}
  </table>
  {% if rot %}<p class="conf">{{ t('Realized = mean trailing-63d return of the theme&#39;s proxies minus SPY (coincident, display-only — a persistently lagging TARGETED theme is evidence against the rotation call).', '“近63日”= 该主题代理标的过去63个交易日相对标普的平均超额收益（同步、仅展示——长期跑输的受益主题即是对该轮动判断的反证）。') }}</p>{% endif %}
  <h3 class="sub">🥶 {{ t('Starved / pressured', '受冷落 / 承压') }}</h3>
  <table class="data">
    <tr><th>{{ t('Theme', '主题') }}</th><th>{{ t('Mechanism', '机制') }}</th><th>{{ t('Proxies', '代理标的') }}</th><th>{{ t('Basis', '依据') }}</th></tr>
    {% for r in intel.rotation.starved %}
    <tr>
      <td><strong>{{ bl(r.theme_en, r.theme_zh) }}</strong></td>
      <td>{{ bl(r.mechanism_en, r.mechanism_zh) }}</td>
      <td class="prox">{{ r.proxies | join(' ') if r.proxies else '—' }}</td>
      <td><span class="b {{ 'b-prior' if 'PRIOR' in r.basis else ('b-fact' if 'FACT' in r.basis else 'b-inf') }}">{{ tr(r.basis, _BASIS_TR) }}</span><br><span class="conf">{{ tr(r.confidence, _CONF_TR) }}</span></td>
    </tr>
    {% endfor %}
  </table>

  <!-- ================= PREDICTION LEDGER ================= -->
  <h2 class="sec">🎯 {{ t('Falsifiable prediction ledger', '可证伪预测台账') }}</h2>
  <p class="lede" style="color:var(--muted)">{{ t('The accountability spine: each call has a measurable outcome and a check-by date. Outcomes get scored over time so this layer earns a track record instead of being vibes. Policy-action calls (high-confidence, track explicit directives) are scored separately from market-outcome calls (lower-confidence inference).',
      '问责脊柱：每条判断都有可衡量的结果与核查日期。结果将随时间被评分，使该层积累真实战绩而非凭感觉。政策行动类判断（高置信、追踪明确指令）与市场结果类判断（低置信、属推断）分开评分。') }}</p>
  <div class="led-stat">
    <span><b>{{ counts.total }}</b> {{ t('total', '总计') }}</span>
    <span><b>{{ counts.open }}</b> {{ t('open', '未结') }}</span>
    <span><b>{{ counts.hit }}</b> {{ t('hit', '命中') }}</span>
    <span><b>{{ counts.miss }}</b> {{ t('miss', '落空') }}</span>
    {% if dates and dates.overdue_predictions %}<span><b>{{ dates.overdue_predictions }}</b> {{ t('past check-by', '已过核查') }}</span>{% endif %}
    <span>{{ counts.policy_action }} {{ t('policy-action', '政策行动') }} · {{ counts.market_outcome }} {{ t('market-outcome', '市场结果') }}</span>
  </div>
  <table class="data">
    <tr><th>#</th><th>{{ t('Thread', '线索') }}</th><th>{{ t('Prediction', '预测') }}</th><th>{{ t('Check by', '核查于') }}</th><th>{{ t('Tier', '层级') }}</th><th>{{ t('Conf', '置信') }}</th><th>{{ t('Status', '状态') }}</th></tr>
    {% for p in intel.predictions %}
    <tr>
      <td><strong>{{ p.id }}</strong></td>
      <td><span class="th-{{ p.thread }}">{{ code(p.thread, _THREAD) }}</span></td>
      <td>{{ bl(p.text_en, p.text_zh) }}</td>
      <td>{{ p.check_by }}</td>
      <td><span class="conf">{{ code(p.tier, _TIER) }}</span></td>
      <td><span class="conf">{{ tr(p.confidence, _CONF_TR) }}</span></td>
      <td><span class="b b-{{ p.status }}">{{ code(p.status, _STATUS) }}</span>{% set pdt = (dates.predictions[p.id] if dates and dates.predictions and p.id in dates.predictions else None) %}{% if pdt and pdt.overdue %} <span class="b b-miss">{{ t('due', '待结') }}</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </table>

  <!-- ================= MONITOR ================= -->
  <h2 class="sec">📡 {{ t('Monitor — highest-signal sources', '监测 — 最高信号来源') }}</h2>
  <ul class="monitor">
    {% for m in intel.monitor %}
    <li>{% if m.url %}<a href="{{ m.url }}" target="_blank" rel="noopener">{{ bl(m.name, m.name_zh) }}</a>{% else %}<strong>{{ bl(m.name, m.name_zh) }}</strong>{% endif %} — <span class="conf">{{ bl(m.who, m.who_zh) }} · {{ bl(m.cadence, m.cadence_zh) }}</span></li>
    {% endfor %}
  </ul>

  <!-- ================= SOURCES + CAVEATS ================= -->
  <h2 class="sec">📚 {{ t('Sources & caveats', '来源与说明') }}</h2>
  <div class="callout">
    {{ bl(intel.caveats.en, intel.caveats.zh) }}
  </div>
  <p class="srcs"><strong>{{ t('Primary sources', '一手来源') }}:</strong>
    {% for s in intel.sources %}<a href="{{ s }}" target="_blank" rel="noopener">[{{ loop.index }}]</a> {% endfor %}
  </p>
  <p class="conf">{{ t('Generated', '生成于') }} {{ generated_utc }} · {{ t('display / context only — not investment advice', '仅供展示／参考——不构成投资建议') }}</p>

</div>
{% endblock %}
