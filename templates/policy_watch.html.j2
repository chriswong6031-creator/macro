{% macro basis_tags(value) -%}
  {% set s = value or '' %}
  {% if 'FACT' in s %}<span class="pw-badge fact">{{ t('Confirmed','已确认') }}</span>{% endif %}
  {% if 'INFERENCE' in s %}<span class="pw-badge read">{{ t('Our read','我们的解读') }}</span>{% elif 'PRIOR' in s or 'THEORY' in s %}<span class="pw-badge scenario">{{ t('Scenario','情景') }}</span>{% endif %}
  {% if 'CORRECTED' in s %}<span class="pw-badge updated">{{ t('Updated','已更正') }}</span>{% endif %}
{%- endmacro %}
{% macro confidence_tag(value) -%}
  {% set s = (value or '')|lower %}
  {% if s.startswith('high') %}<span class="pw-meta">{{ t('High confidence','较高把握') }}</span>{% elif s.startswith('medium') %}<span class="pw-meta">{{ t('Medium confidence','中等把握') }}</span>{% else %}<span class="pw-meta">{{ t('Low confidence','较低把握') }}</span>{% endif %}
{%- endmacro %}
{% macro lean_tag(value) -%}
  {% set labels = LEAN.get(value, [value, value]) %}
  <span class="pw-badge {{ 'fact' if value == 'overweight' else ('warn' if value == 'underweight' else 'miss') }}">{{ bl(labels[0], labels[1]) }}</span>
{%- endmacro %}
{% macro status_tag(value, needs_review=false) -%}
  {% if needs_review %}<span class="pw-badge warn">{{ t('Needs review','需要复核') }}</span>
  {% elif value == 'hit' %}<span class="pw-badge fact">{{ t('Right','正确') }}</span>
  {% elif value == 'miss' %}<span class="pw-badge miss">{{ t('Wrong','错误') }}</span>
  {% else %}<span class="pw-badge neutral">{{ t('Open','待定') }}</span>{% endif %}
{%- endmacro %}
{% macro section_head(kicker_en, kicker_zh, title_en, title_zh, desc_en='', desc_zh='') -%}
<div class="pw-section-head">
  <p class="pw-eyebrow">{{ t(kicker_en, kicker_zh) }}</p>
  <h2>{{ t(title_en, title_zh) }}</h2>
  {% if desc_en %}<p>{{ t(desc_en, desc_zh) }}</p>{% endif %}
</div>
{%- endmacro %}

