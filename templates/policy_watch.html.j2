{% block base_css %}
  @font-face{font-family:"MX Inter Display";src:url("/fonts/InterDisplay-500.woff2") format("woff2");font-style:normal;font-weight:500;font-display:swap}
  @font-face{font-family:"MX Inter Display";src:url("/fonts/InterDisplay-600.woff2") format("woff2");font-style:normal;font-weight:600;font-display:swap}
  @font-face{font-family:"MX Inter Display";src:url("/fonts/InterDisplay-700.woff2") format("woff2");font-style:normal;font-weight:700;font-display:swap}
  body{
    --font-ui:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",sans-serif;
    --font-display:"MX Inter Display",Inter,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    --font-data:Inter,"SF Pro Text","SF Pro Display",-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",sans-serif;
    --pw-hair:color-mix(in srgb,var(--line) 82%,transparent);
    --pw-tile:color-mix(in srgb,var(--panel2) 86%,var(--panel));
    --pw-ink-2:color-mix(in srgb,var(--text) 68%,transparent);
    --pw-shadow:inset 0 1px 0 color-mix(in srgb,var(--text) 8%,transparent),0 1px 1px rgba(0,0,0,.24),0 14px 30px -18px rgba(0,0,0,.52);
    --pw-purple:#a879e8;--pw-blue:#5b8def;--pw-teal:#3fb6c0;--pw-green:var(--up);--pw-amber:var(--warn);--pw-red:var(--down);
    background:#0a0c11;color:var(--text);font-family:var(--font-ui);font-size:14px;line-height:1.55;font-weight:500;
    padding:18px 18px 60px;font-synthesis:none;text-rendering:optimizeLegibility;
  }
  @media(min-width:1100px){body{padding:26px max(40px,calc((100vw - 1500px)/2)) 72px}}
  html[data-theme="light"] body{--pw-tile:#eef1f6;--pw-ink-2:color-mix(in srgb,var(--text) 72%,transparent);--pw-shadow:0 1px 2px rgba(23,32,55,.05),0 8px 24px -12px rgba(23,32,55,.12);background:#e8ebf1}
  html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif;letter-spacing:normal}
  .pw-shell{width:100%;max-width:1500px;margin:18px auto 0;min-width:0}
  .pw-shell *{min-width:0}
  .pw-shell :is(h1,h2,h3,.pw-state,.pw-card-title){font-family:var(--font-display)}
  .pw-shell :is(.pw-date,.pw-stat strong,.pw-count,.pw-performance){font-family:var(--font-data);font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1}
  .pw-surface,.pw-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--pw-shadow)}
  .pw-hero{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:28px;padding:26px 28px}
  .pw-hero::before{content:"";position:absolute;inset:0 0 auto;height:3px;background:linear-gradient(90deg,var(--pw-purple),color-mix(in srgb,var(--pw-blue) 50%,transparent) 62%,transparent)}
  .pw-eyebrow{margin:0 0 8px;color:var(--pw-purple);font-family:var(--font-display);font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
  html[data-lang="zh"] .pw-eyebrow{letter-spacing:0}
  .pw-hero h1{margin:0;font-size:32px;line-height:1.12;font-weight:700;letter-spacing:-.025em}
  html[data-lang="zh"] .pw-hero h1{letter-spacing:0}
  .pw-subtitle{max-width:60ch;margin:10px 0 16px;color:var(--pw-ink-2);font-size:14px}
  .pw-chips,.pw-meta-row,.pw-toc{display:flex;flex-wrap:wrap;align-items:center;gap:7px}
  .pw-chip,.pw-badge{display:inline-flex;align-items:center;max-width:100%;border-radius:999px;border:1px solid var(--pw-hair);background:var(--pw-tile);overflow-wrap:anywhere;white-space:normal}
  .pw-chip{gap:5px;padding:5px 10px;color:var(--pw-ink-2);font-size:11.5px;line-height:1.2}
  .pw-chip strong{color:var(--text)}
  .pw-chip.stale,.pw-badge.warn{color:var(--pw-amber);border-color:color-mix(in srgb,var(--pw-amber) 42%,var(--line));background:color-mix(in srgb,var(--pw-amber) 10%,var(--panel))}
  .pw-badge{padding:3px 8px;font-size:10.5px;font-weight:700;line-height:1.25}
  .pw-badge.fact{color:var(--pw-green);border-color:color-mix(in srgb,var(--pw-green) 38%,var(--line));background:color-mix(in srgb,var(--pw-green) 9%,var(--panel))}
  .pw-badge.read{color:var(--pw-purple);border-color:color-mix(in srgb,var(--pw-purple) 38%,var(--line));background:color-mix(in srgb,var(--pw-purple) 9%,var(--panel))}
  .pw-badge.scenario,.pw-badge.updated{color:var(--pw-blue);border-color:color-mix(in srgb,var(--pw-blue) 38%,var(--line));background:color-mix(in srgb,var(--pw-blue) 9%,var(--panel))}
  .pw-badge.miss{color:var(--pw-red);border-color:color-mix(in srgb,var(--pw-red) 38%,var(--line));background:color-mix(in srgb,var(--pw-red) 9%,var(--panel))}
  .pw-badge.neutral{color:var(--pw-ink-2)}
  .pw-meta{color:var(--muted);font-size:11px}
  .pw-hero-side{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:22px;border-left:1px solid var(--pw-hair);padding-left:26px}
  .pw-mini-title{margin:0 0 7px;color:var(--muted);font-family:var(--font-display);font-size:10.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
  .pw-state{margin:0;color:var(--text);font-size:23px;font-weight:700;line-height:1.16;letter-spacing:-.02em}
  .pw-state.hawkish{color:var(--pw-amber)}.pw-state.dovish{color:var(--pw-green)}
  .pw-mini-copy{margin:7px 0 0;color:var(--pw-ink-2);font-size:12px;line-height:1.45}
  .pw-event-list{display:grid;gap:0}
  .pw-event{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:9px;align-items:start;padding:7px 0;border-bottom:1px solid var(--pw-hair)}
  .pw-event:last-child{border-bottom:0}.pw-date{font-size:11.5px;font-weight:700}.pw-event-name{font-size:12px;line-height:1.35}.pw-event-note{grid-column:2/-1;margin:0;color:var(--pw-ink-2);font-size:11.5px}
  .pw-alert{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:14px;padding:11px 15px;border:1px solid color-mix(in srgb,var(--pw-amber) 36%,var(--line));border-left:3px solid var(--pw-amber);border-radius:12px;background:color-mix(in srgb,var(--pw-amber) 7%,var(--panel));font-size:12.5px}
  .pw-toc{margin:14px 0 0}.pw-toc .gbtn{font-family:var(--font-display);font-size:11px;text-transform:none}
  .pw-section{scroll-margin-top:84px;margin-top:34px}
  .pw-section-head{display:grid;grid-template-columns:auto 1fr;align-items:end;gap:0 12px;margin:0 0 13px;padding:0 0 11px;border-bottom:1px solid var(--line)}
  .pw-section-head::before{content:"";grid-row:1/4;width:3px;height:20px;align-self:start;margin-top:3px;border-radius:2px;background:linear-gradient(180deg,var(--pw-purple),color-mix(in srgb,var(--pw-purple) 30%,transparent))}
  .pw-section-head .pw-eyebrow{grid-column:2;margin:0 0 2px}.pw-section-head h2{grid-column:2;margin:0;font-size:19px;font-weight:700;line-height:1.3;letter-spacing:-.01em}.pw-section-head>p:last-child:not(.pw-eyebrow){grid-column:2;margin:4px 0 0;color:var(--pw-ink-2);font-size:13px}
  .pw-glance-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .pw-card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}
  .pw-card{position:relative;padding:17px 18px;overflow:hidden;overflow-wrap:anywhere}.pw-card::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--card-accent,var(--pw-purple))}.pw-card.green{--card-accent:var(--pw-green)}.pw-card.blue{--card-accent:var(--pw-blue)}.pw-card.amber{--card-accent:var(--pw-amber)}.pw-card.teal{--card-accent:var(--pw-teal)}
  .pw-card-title{margin:0;font-size:15px;font-weight:600;line-height:1.35;letter-spacing:-.01em}.pw-card p{margin:8px 0 0;color:var(--pw-ink-2);font-size:13px;line-height:1.5}.pw-card p.pw-primary{color:var(--text);font-size:13.5px}.pw-card .pw-meta-row{margin-top:10px}.pw-card-label{display:block;margin-bottom:3px;color:var(--muted);font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
  .pw-stance{display:inline-flex;margin-top:12px;padding:5px 10px;border-radius:8px;color:var(--pw-amber);border:1px solid color-mix(in srgb,var(--pw-amber) 38%,var(--line));background:color-mix(in srgb,var(--pw-amber) 9%,var(--panel));font-size:11.5px;font-weight:700}
  details.pw-details{margin-top:12px}.pw-details>summary{list-style:none}.pw-details>summary::-webkit-details-marker{display:none}.pw-details[open]>summary{margin-bottom:9px}.pw-detail-body{padding:11px 13px;border:1px solid var(--pw-hair);border-radius:10px;background:var(--pw-tile);color:var(--pw-ink-2);font-size:12px;line-height:1.55;overflow-wrap:anywhere}.pw-detail-body p{margin:0 0 8px;font-size:12px}.pw-detail-body p:last-child{margin-bottom:0}
  .pw-statbar{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px}.pw-stat{padding:7px 10px;border:1px solid var(--pw-hair);border-radius:9px;background:var(--pw-tile);color:var(--pw-ink-2);font-size:11.5px}.pw-stat strong{color:var(--text);font-size:13px}
  .pw-market-card .pw-examples{color:var(--text);font-family:var(--font-data);font-size:11.5px;font-weight:600;letter-spacing:.01em}.pw-performance{font-size:11.5px}
  .pw-ledger{display:grid;gap:8px}.pw-call{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:9px 14px;align-items:start;padding:12px 14px;border:1px solid var(--pw-hair);border-radius:11px;background:var(--panel)}.pw-call-topic{color:var(--muted);font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}.pw-call-text{grid-column:1;margin:2px 0 0;color:var(--text);font-size:12.5px;line-height:1.45}.pw-call-date{font-family:var(--font-data);font-size:11.5px;white-space:nowrap}.pw-call-status{grid-column:3;grid-row:1/3}.pw-call-id{color:var(--muted);font-family:var(--font-data);font-size:10.5px}
  .pw-monitor{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.pw-monitor-row{padding:11px 12px;border:1px solid var(--pw-hair);border-radius:10px;background:var(--pw-tile)}.pw-monitor-row strong{display:block;font-size:12.5px}.pw-monitor-row span{display:block;margin-top:3px;color:var(--pw-ink-2);font-size:11.5px}.pw-sources{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.pw-sources a{max-width:100%;overflow-wrap:anywhere}.pw-build-note{margin:13px 0 0;color:var(--muted);font-size:11px}
  .pw-extra[hidden]{display:none!important}.pw-reveal{margin-top:12px}.pw-shell .gbtn{max-width:100%;font-family:var(--font-ui);white-space:normal;text-align:left}
  @media(max-width:1000px){.pw-hero{grid-template-columns:1fr}.pw-hero-side{border-left:0;border-top:1px solid var(--pw-hair);padding:18px 0 0}.pw-card-grid{grid-template-columns:1fr}.pw-monitor{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:680px){.pw-shell{margin-top:14px}.pw-hero{padding:22px 18px}.pw-hero h1{font-size:28px}.pw-hero-side,.pw-glance-grid{grid-template-columns:1fr}.pw-event{grid-template-columns:58px minmax(0,1fr) auto}.pw-section{margin-top:28px}.pw-card{padding:15px 16px}.pw-monitor{grid-template-columns:1fr}.pw-call{grid-template-columns:minmax(0,1fr) auto}.pw-call-date{grid-column:1}.pw-call-status{grid-column:2;grid-row:1/4}.pw-toc{gap:6px}.pw-toc .gbtn{padding:6px 10px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
{% endblock %}

{% block content %}
{% set spine = catalysts.spine if catalysts and catalysts.spine else [] %}
{% set upcoming = spine|rejectattr('past')|list %}
{% set past = spine|selectattr('past')|list %}
{% set age = dates.staleness.age_days if dates and dates.staleness else none %}
{% set stance = fed_stance.stance if fed_stance else 'unknown' %}
{% set divergence = scorecard.sharpest_divergence if scorecard and scorecard.sharpest_divergence else none %}

<main class="pw-shell">
  <section class="pw-hero pw-surface" aria-labelledby="pw-title">
    <div>
      <p class="pw-eyebrow">{{ t('Market policy','市场政策') }}</p>
      <h1 id="pw-title">{{ t('Fed & Policy Watch','美联储与政策观察') }}</h1>
      <p class="pw-subtitle">{{ t('The policy moves that matter for markets. Last verified','影响市场的政策变化。最近核实于') }} <span class="l-en">{{ verified_en }}</span><span class="l-zh">{{ verified_zh }}</span>.</p>
      <div class="pw-chips">
        {% if age is not none and age > 14 %}<span class="pw-chip stale">{{ t('Needs refresh','需要更新') }}</span>{% endif %}
        <span class="pw-chip">{{ t('Facts and analysis kept separate','事实与分析分开呈现') }}</span>
      </div>
      <span class="pw-stance">{{ t('Watch — don’t chase','观察，不追涨') }}</span>
    </div>
    <div class="pw-hero-side">
      <div>
        <p class="pw-mini-title">{{ t('Rate outlook','利率前景') }}</p>
        {% if stance == 'hawkish' %}<p class="pw-state hawkish">{{ t('Rates may stay high','利率可能维持高位') }}</p>
        {% elif stance == 'dovish' %}<p class="pw-state dovish">{{ t('Cuts are priced','市场已计入降息') }}</p>
        {% elif stance == 'neutral' %}<p class="pw-state">{{ t('No change priced','市场预期利率不变') }}</p>
        {% else %}<p class="pw-state">{{ t('No current read','暂无最新判断') }}</p>{% endif %}
        {% if fed_hist and fed_hist.since %}<p class="pw-mini-copy">{{ t('Unchanged since','自此日期以来未变') }} {{ fed_hist.since }}{% if fed_hist.changed_recently %} · {{ t('changed recently','近期有变化') }}{% endif %}</p>{% endif %}
      </div>
      <div>
        <p class="pw-mini-title">{{ t('Key dates','关键日期') }}</p>
        {% if upcoming %}
        <div class="pw-event-list">
          {% for event in upcoming[:3] %}
          <div class="pw-event">
            <span class="pw-date">{{ event.date[5:] }}</span>
            <span class="pw-event-name">{% if event.key %}★ {% endif %}{{ bl(event.event_en, event.event_zh) }}</span>
            <span class="pw-badge neutral">{% if event.days_to == 0 %}{{ t('Today','今天') }}{% elif event.days_to == 1 %}{{ t('Tomorrow','明天') }}{% else %}{{ event.days_to }}{{ t('d','天') }}{% endif %}</span>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <p class="pw-mini-copy">{{ t('No upcoming policy dates in this update.','本次更新没有未来政策日期。') }}</p>
        {% endif %}
        {% if past %}
        <details class="pw-details">
          <summary class="gbtn gbtn-sm gbtn-quiet">{{ t('Past dates','过去日期') }}</summary>
          <div class="pw-detail-body pw-event-list">
            {% for event in (past[-4:]|reverse|list) %}
            <div class="pw-event"><span class="pw-date">{{ event.date[5:] }}</span><span class="pw-event-name">{{ bl(event.event_en, event.event_zh) }}</span><span class="pw-badge neutral">{{ t('Past','已过') }}</span></div>
            {% endfor %}
          </div>
        </details>
        {% endif %}
      </div>
    </div>
  </section>

  {% if (age is not none and age > 14) or divergence %}
  <div class="pw-alert" role="note">
    {% if age is not none and age > 14 %}<span><strong>{{ t('Needs refresh.','需要更新。') }}</strong> {{ t('Check the latest news before acting.','采取行动前请先核对最新消息。') }}</span>{% endif %}
    {% if divergence %}<span><strong>{{ t('Not working:','尚未奏效：') }}</strong> {{ bl(divergence.theme, divergence.theme_zh if divergence.theme_zh else divergence.theme) }} {{ t('is trailing the S&P 500.','目前跑输标普500。') }}</span>{% endif %}
  </div>
  {% endif %}

  <nav class="pw-toc" aria-label="Jump to section">
    <a class="gbtn gbtn-sm gbtn-pill" href="#overview">{{ t('Quick take','快速了解') }}</a>
    {% if desk %}<a class="gbtn gbtn-sm gbtn-pill" href="#views">{{ t('Market views','市场观点') }}</a>{% endif %}
    <a class="gbtn gbtn-sm gbtn-pill" href="#fed">{{ t('The Fed','美联储') }}</a>
    <a class="gbtn gbtn-sm gbtn-pill" href="#policy">{{ t('Policy moves','政策行动') }}</a>
    <a class="gbtn gbtn-sm gbtn-pill" href="#impact">{{ t('Market impact','市场影响') }}</a>
    <a class="gbtn gbtn-sm gbtn-pill" href="#ledger">{{ t('Calls & results','判断与结果') }}</a>
    <a class="gbtn gbtn-sm gbtn-pill" href="#sources">{{ t('Sources','来源') }}</a>
  </nav>

  <section class="pw-section" id="overview">
    {{ section_head('Quick take','快速了解','What matters now','当前重点','The short version.','先看最重要的。') }}
    <div class="pw-glance-grid">
      <article class="pw-card green">
        <h3 class="pw-card-title">{{ t('Bottom line','核心结论') }}</h3>
        <p class="pw-primary">{{ t('The Fed is staying tough on inflation while Treasury tries to lower borrowing costs and fund domestic industry.','美联储仍严控通胀，财政部则试图降低融资成本并支持国内产业。') }}</p>
      </article>
      <article class="pw-card amber">
        <h3 class="pw-card-title">{{ t('What to watch','需要关注') }}</h3>
        <p class="pw-primary">{{ t('Jobs, inflation and Treasury funding matter more than speeches. Weak growth could reopen cuts; sticky inflation could delay them.','就业、通胀和国债融资比讲话更重要。增长转弱可能重启降息，通胀黏性则会推迟行动。') }}</p>
      </article>
    </div>
    <p class="pw-build-note">{{ t('The Fed and Treasury appear aligned on lower borrowing costs, but there is no proof of a coordinated plan.','美联储与财政部似乎都希望降低融资成本，但没有证据表明双方存在协同计划。') }}</p>
  </section>

  {% if desk %}
  <section class="pw-section" id="views">
    {{ section_head('Market views','市场观点','Ideas we’re tracking','我们正在跟踪的观点','Early views with a clear review date.','早期观点，均设有复核日期。') }}
    {% if desk.track_record and desk.track_record.overall and desk.track_record.overall.n %}
    <div class="pw-statbar"><span class="pw-stat"><strong>{{ desk.track_record.overall.n }}</strong> {{ t('checked','已复核') }}</span>{% if desk.track_record.overall.hit_rate is not none %}<span class="pw-stat"><strong>{{ (desk.track_record.overall.hit_rate*100)|round|int }}%</strong> {{ t('right so far','目前正确') }}</span>{% endif %}</div>
    {% else %}<p class="pw-build-note">{{ t('No results yet. Treat these as early ideas.','暂无结果，请将这些视为早期观点。') }}</p>{% endif %}
    {% if desk.theses %}
    <div class="pw-card-grid">
      {% for view in desk.theses %}
      {% set actor = THREAD.get('fed' if view.actor == 'fed' else 'policy', ['Policy','政策']) %}
      {% set view_copy = VIEW_COPY.get(view.subject) %}
      <article class="pw-card blue" data-policy-id="view-{{ loop.index }}">
        <span class="pw-card-label">{{ bl(actor[0], actor[1]) }}</span>
        <h3 class="pw-card-title">{{ view.subject }} · {{ lean_tag(view.lean) }}</h3>
        <p class="pw-primary">{{ bl(view_copy.en if view_copy else brief(view.thesis, 150), view_copy.zh if view_copy else brief(view.thesis_zh, 72)) }}</p>
        <div class="pw-meta-row"><span class="pw-chip">{{ t('Review by','复核日期') }} {{ view.check_by }}</span>{{ confidence_tag(view.conviction) }}</div>
        {% if view.dissent or (view.falsifier and view.falsifier.text) %}
        <details class="pw-details">
          <summary class="gbtn gbtn-sm">{{ t('Risks & review','风险与复核条件') }}</summary>
          <div class="pw-detail-body">
            {% if view.dissent %}<p><strong>{{ t('Main risk:','主要风险：') }}</strong> {{ bl(view_copy.risk_en if view_copy else brief(view.dissent, 160), view_copy.risk_zh if view_copy else brief(view.dissent_zh, 80)) }}</p>{% endif %}
            {% if view.falsifier and view.falsifier.text %}<p><strong>{{ t('What would change this:','什么会改变判断：') }}</strong> {{ bl(brief(view.falsifier.text, 170), brief(view.falsifier.text_zh, 85)) }}</p>{% endif %}
          </div>
        </details>
        {% endif %}
      </article>
      {% endfor %}
    </div>
    {% else %}<div class="pw-card amber"><p class="pw-primary">{{ t('Market views are unavailable today.','今天暂无市场观点。') }}</p></div>{% endif %}
    <p class="pw-build-note">{{ t('Unproven market views—not trade instructions.','这些观点尚未得到验证，不是交易指令。') }}</p>
  </section>
  {% endif %}

  <section class="pw-section" id="fed">
    {{ section_head('The Fed','美联储','Fed changes to watch','值得关注的美联储变化','Rates may stay high until inflation cools.','在通胀降温前，利率可能维持高位。') }}
    <div class="pw-glance-grid">
      <article class="pw-card amber"><h3 class="pw-card-title">{{ t('Current direction','当前方向') }}</h3><p class="pw-primary">{{ t('Warsh is pushing a stricter 2% target, less bond buying and less forward guidance.','沃什正推动更严格的2%目标、减少购债并减少前瞻指引。') }}</p></article>
      <article class="pw-card blue"><h3 class="pw-card-title">{{ t('What could change','可能的变化') }}</h3><p class="pw-primary">{{ t('Rule changes could make a later pivot easier, but there is no clear rate-cut signal yet.','规则调整可能让未来转向更容易，但目前没有明确的降息信号。') }}</p></article>
    </div>
    <div class="pw-card-grid" style="margin-top:12px">
      {% for item in intel.fed.task_forces %}
      {% set copy = TF_COPY.get(item.id) %}
      <article class="pw-card" data-policy-id="{{ item.id }}">
        <h3 class="pw-card-title">{{ bl(item.name_en, item.name_zh) }}</h3>
        <p class="pw-primary">{{ bl(copy.en if copy else brief(item.charter_en), copy.zh if copy else brief(item.charter_zh, 72)) }}</p>
        <div class="pw-meta-row"><span class="pw-chip">{{ t('Expected by','预计完成') }} {{ item.check_by }}</span>{{ basis_tags(item.basis) }}</div>
        {% if copy %}<details class="pw-details"><summary class="gbtn gbtn-sm">{{ t('Why it matters','为何重要') }}</summary><div class="pw-detail-body">{{ bl(copy.why_en, copy.why_zh) }}</div></details>{% endif %}
      </article>
      {% endfor %}
    </div>
    <p class="pw-build-note">{{ t('No outside experts have been named yet.','目前尚未公布外部专家名单。') }}</p>
  </section>

  <section class="pw-section" id="policy">
    {{ section_head('Policy moves','政策行动','White House & Treasury','白宫与财政部','Keeping borrowing costs manageable while steering money toward strategic industries.','在控制融资成本的同时，把资金引向战略产业。') }}
    <h3 class="pw-mini-title">{{ t('Moves in force','已落地的行动') }}</h3>
    <div class="pw-card-grid">
      {% for lever in intel.administration.verified_levers %}
      {% set copy = LEVER_COPY.get(lever.id) %}
      <article class="pw-card blue" data-policy-id="{{ lever.id }}">
        <h3 class="pw-card-title">{{ bl(copy.title_en if copy else lever.title_en, copy.title_zh if copy else lever.title_zh) }}</h3>
        <p class="pw-primary">{{ bl(copy.en if copy else brief(lever.detail_en), copy.zh if copy else brief(lever.detail_zh, 72)) }}</p>
        <div class="pw-meta-row">{{ basis_tags(lever.basis) }}{% if 'INFERENCE' in lever.basis %}{{ confidence_tag(lever.confidence) }}{% endif %}</div>
      </article>
      {% endfor %}
    </div>
    <h3 class="pw-mini-title" style="margin-top:20px">{{ t('World events that matter','重要的全球事件') }}</h3>
    <div class="pw-card-grid">
      {% for theater in intel.administration.theaters %}
      {% set copy = THEATER_COPY.get(theater.id) %}
      <article class="pw-card amber" data-policy-id="{{ theater.id }}">
        <h3 class="pw-card-title">{{ bl(copy.title_en if copy else theater.title_en, copy.title_zh if copy else theater.title_zh) }}</h3>
        <p class="pw-primary">{{ bl(copy.fact_en if copy else brief(theater.facts_en), copy.fact_zh if copy else brief(theater.facts_zh, 72)) }}</p>
        <div class="pw-meta-row">{{ basis_tags(theater.basis) }}</div>
        {% if copy %}<details class="pw-details"><summary class="gbtn gbtn-sm">{{ t('Why it matters','为何重要') }}</summary><div class="pw-detail-body"><p><strong>{{ t('Why:','原因：') }}</strong> {{ bl(copy.why_en, copy.why_zh) }}</p><p><strong>{{ t('Market impact:','市场影响：') }}</strong> {{ bl(copy.market_en, copy.market_zh) }}</p></div></details>{% endif %}
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="pw-section" id="impact">
    {{ section_head('Market impact','市场影响','Where policy may help or hurt','政策可能利好或利空的方向','Examples to watch—not a buy list.','仅供观察，并非买入清单。') }}
    <h3 class="pw-mini-title">{{ t('Potential beneficiaries','可能受益') }}</h3>
    <div class="pw-card-grid" id="pw-target-grid">
      {% for row in intel.rotation.targeted %}
      {% set copy = TARGET_COPY.get(row.theme_en, [row.theme_en,row.theme_zh,brief(row.mechanism_en),brief(row.mechanism_zh,72)]) %}
      {% set current = rot.themes[row.theme_en] if rot and rot.themes and row.theme_en in rot.themes else none %}
      <article class="pw-card green pw-market-card pw-extra" data-policy-id="target-{{ loop.index }}"{% if loop.index > 6 %} hidden{% endif %}>
        <h3 class="pw-card-title">{{ bl(copy[0],copy[1]) }}</h3>
        <p class="pw-primary">{{ bl(copy[2],copy[3]) }}</p>
        <p class="pw-examples">{{ row.proxies|join(' · ') if row.proxies else '—' }}</p>
        <div class="pw-meta-row">{% if current and current.verdict != 'na' %}<span class="pw-badge {{ 'fact' if current.verdict == 'working' else ('miss' if current.verdict == 'lagging' else 'neutral') }}">{% if current.verdict == 'working' %}{{ t('Ahead','领先') }}{% elif current.verdict == 'lagging' %}{{ t('Behind','落后') }}{% else %}{{ t('Mixed','分化') }}{% endif %}</span>{% endif %}</div>
        {% if current and current.verdict != 'na' %}<details class="pw-details"><summary class="gbtn gbtn-sm">{{ t('Performance','表现') }}</summary><div class="pw-detail-body pw-performance">{{ t('Last 3 months vs S&P 500:','近3个月相对标普500：') }} {{ '%+.1f'|format(current.avg_rel*100) }}%. {{ t('A check, not a forecast.','这只是核对结果，不是预测。') }}</div></details>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% if intel.rotation.targeted|length > 6 %}<button class="gbtn gbtn-sm pw-reveal" type="button" data-reveal="#pw-target-grid .pw-extra[hidden]">{{ t('Show all areas','显示全部方向') }}</button>{% endif %}
    <h3 class="pw-mini-title" style="margin-top:20px">{{ t('Potential headwinds','可能承压') }}</h3>
    <div class="pw-card-grid">
      {% for row in intel.rotation.starved %}
      {% set copy = HEADWIND_COPY.get(row.theme_en, [row.theme_en,row.theme_zh,brief(row.mechanism_en),brief(row.mechanism_zh,72)]) %}
      <article class="pw-card amber pw-market-card" data-policy-id="headwind-{{ loop.index }}"><h3 class="pw-card-title">{{ bl(copy[0],copy[1]) }}</h3><p class="pw-primary">{{ bl(copy[2],copy[3]) }}</p><p class="pw-examples">{{ row.proxies|join(' · ') if row.proxies else '—' }}</p></article>
      {% endfor %}
    </div>
  </section>

  <section class="pw-section" id="ledger">
    {{ section_head('Track record','记录','Calls and results','判断与结果','Each view gets a review date, then a result.','每条判断都有复核日期和最终结果。') }}
    <div class="pw-statbar">
      <span class="pw-stat"><strong>{{ counts.total }}</strong> {{ t('tracked','已跟踪') }}</span>
      <span class="pw-stat"><strong>{{ counts.open }}</strong> {{ t('open','待定') }}</span>
      <span class="pw-stat"><strong>{{ counts.hit }}</strong> {{ t('right','正确') }}</span>
      <span class="pw-stat"><strong>{{ counts.miss }}</strong> {{ t('wrong','错误') }}</span>
      {% if dates and dates.overdue_predictions %}<span class="pw-stat"><strong>{{ dates.overdue_predictions }}</strong> {{ t('need review','需要复核') }}</span>{% endif %}
    </div>
    <div class="pw-ledger">
      {% for call in featured_predictions %}
      {% set topic = THREAD.get(call.thread, [call.thread,call.thread]) %}
      {% set call_copy = CALL_COPY.get(call.id, [brief(call.text_en,180),brief(call.text_zh,90)]) %}
      <article class="pw-call" data-policy-id="{{ call.id }}">
        <div><span class="pw-call-topic">{{ bl(topic[0],topic[1]) }}</span> <span class="pw-call-id">{{ call.id }}</span><p class="pw-call-text">{{ bl(call_copy[0],call_copy[1]) }}</p></div>
        <span class="pw-call-date">{{ t('Review','复核') }} {{ call.check_by }}</span>
        <span class="pw-call-status">{{ status_tag(call.status,call.needs_review) }}</span>
      </article>
      {% endfor %}
    </div>
    <details class="pw-details">
      <summary class="gbtn gbtn-sm">{{ t('See all calls','查看全部判断') }} ({{ counts.total }})</summary>
      <div class="pw-detail-body pw-ledger">
        {% for call in intel.predictions %}
        {% set date_row = dates.predictions[call.id] if dates and dates.predictions and call.id in dates.predictions else none %}
        {% set topic = THREAD.get(call.thread,[call.thread,call.thread]) %}
        {% set call_copy = CALL_COPY.get(call.id, [brief(call.text_en,180),brief(call.text_zh,90)]) %}
        <article class="pw-call" data-policy-id="full-{{ call.id }}"><div><span class="pw-call-topic">{{ bl(topic[0],topic[1]) }}</span> <span class="pw-call-id">{{ call.id }}</span><p class="pw-call-text">{{ bl(call_copy[0],call_copy[1]) }}</p></div><span class="pw-call-date">{{ call.check_by }}</span><span class="pw-call-status">{{ status_tag(call.status,(date_row.overdue if date_row else false) or call.id == 'P44') }}</span></article>
        {% endfor %}
      </div>
    </details>
  </section>

  <section class="pw-section" id="sources">
    {{ section_head('Receipts','依据','What we watch','我们关注什么','Details only when you need them.','需要时再查看细节。') }}
    <details class="pw-details">
      <summary class="gbtn gbtn-sm">{{ t('Watch list','关注清单') }}</summary>
      <div class="pw-detail-body pw-monitor">
        {% for row in MONITOR_COPY %}<div class="pw-monitor-row"><strong>{{ bl(row[0],row[1]) }}</strong><span>{{ bl(row[2],row[3]) }} · {{ bl(row[4],row[5]) }}</span></div>{% endfor %}
      </div>
    </details>
    <details class="pw-details">
      <summary class="gbtn gbtn-sm">{{ t('Sources and limits','来源与局限') }}</summary>
      <div class="pw-detail-body">
        <p>{{ t('This page mixes confirmed policy facts with clearly labelled analysis. Fast-moving China and Iran items may change between updates.','本页将已确认的政策事实与明确标注的分析分开。中国和伊朗相关信息变化很快，更新之间可能出现变化。') }}</p>
        <div class="pw-sources">
          {% for source in source_links %}<a class="gbtn gbtn-sm gbtn-quiet" href="{{ source.url }}" target="_blank" rel="noopener">{{ source.label }}</a>{% endfor %}
        </div>
      </div>
    </details>
    <p class="pw-build-note">{{ t('Last verified','最近核实') }} <span class="l-en">{{ verified_en }}</span><span class="l-zh">{{ verified_zh }}</span> · {{ t('Built','构建于') }} {{ generated_utc }} · {{ t('For information only—not investment advice.','仅供参考，不构成投资建议。') }}</p>
  </section>
</main>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  document.querySelectorAll('[data-reveal]').forEach(function(button){
    button.addEventListener('click',function(){
      document.querySelectorAll(button.getAttribute('data-reveal')).forEach(function(item){item.hidden=false;});
      button.remove();
    });
  });
})();
</script>
{% endblock %}
