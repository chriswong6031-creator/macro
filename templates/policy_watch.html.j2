{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% macro bl(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{# bilingual helpers for controlled-vocab codes + provenance tags — translate without touching data #}
{% set _CONF_TR = [['medium-high','中高'],['low-medium','中低'],['high','高'],['medium','中'],['low','低']] %}
{% set _BASIS_TR = [
  ['execution slipping','执行滑期'],['headline-fragile','易受头条扰动'],['truce caveat','休战告诫'],
  ['Miran role','Miran 角色'],['FACT','事实'],['INFERENCE','推断'],['PRIOR','先验'],['THEORY','理论'],
  ['CORRECTED','已更正'],['CAVEAT','告诫'],['charter','章程'],['directive','指令'],['proxies','代理'],
  ['mechanism','机制'],['read','解读'],['budget','预算'],['tariff','关税'],['ceasefire','停火'],
  ['conflict','冲突'],['oil','油价'],['deal','协议']
] %}
{% set _THREAD  = {'fed':'美联储','treasury':'财政部','policy':'政策','rotation':'轮动','china':'中国','iran':'伊朗','nato':'北约','dollar':'美元','debasement':'去货币化'} %}
{% set _TIER    = {'policy-action':'政策行动','market-outcome':'市场结果'} %}
{% set _STATUS  = {'open':'未结','hit':'命中','miss':'落空','pending':'待定'} %}
{% set _VERDICT = {'working':'达标','lagging':'落后','mixed':'混合'} %}
{% set _STANCE  = {'hawkish':'鹰派','dovish':'鸽派','neutral':'中性 / 按兵','unknown':'未知'} %}
{% set _LEAN    = {'overweight':'超配','underweight':'低配','avoid':'回避'} %}
{% set _ACTOR   = {'FED':'美联储','ADMIN':'行政当局','POLICY':'政策','ADMIN ':'行政当局'} %}
{% set _KIND    = {'rel_return':'相对收益核验','soft':'软性','level':'水平'} %}
{# exact-enum: english in en-mode, mapped value in zh-mode (falls back to original) #}
{% macro code(val, m) -%}
<span class="l-en">{{ val }}</span><span class="l-zh">{{ m.get(val, val) }}</span>
{%- endmacro %}
{# token-replace: translate recognized tokens in a free-form provenance tag, leave the rest #}
{% macro tr(s, pairs) -%}
{% set ns = namespace(v=s) %}{% for a, b in pairs %}{% set ns.v = ns.v|replace(a, b) %}{% endfor -%}
<span class="l-en">{{ s }}</span><span class="l-zh">{{ ns.v }}</span>
{%- endmacro %}
{# section header: colored thread dot + overline + display heading #}
{% macro sec_head(anchor, dot, ovl_en, ovl_zh, h_en, h_zh) -%}
<div class="pw-sec" id="{{ anchor }}">
  <p class="pw-ovl"><i class="pw-dot" style="--c:{{ dot }}"></i>{{ t(ovl_en, ovl_zh) }}</p>
  <h2>{{ t(h_en, h_zh) }}</h2>
</div>
{%- endmacro %}

{% block title %}Fed & Policy Watch — Macro Dashboard{% endblock %}

{%- block head_extra %}
{% set seo_title = "Fed & Policy Watch — Mastermind" %}
{% set seo_desc = "The Fed's path, real-time policy expectations and what would change them — read from market prices, updated daily." %}
{% set seo_path = "policy_watch.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  /* ── Policy Watch — situation-desk revamp ──────────────────────────────────
     Type roles follow the macro.html Attio trial: Inter Display carries
     headings, state words and overlines; body stays on the shared UI stack;
     dates, counts and percentages get tabular figures. Fonts are the same
     self-hosted files macro.html uses (China-safe, no third-party request). */
  @font-face { font-family:"MX Inter Display"; src:url("fonts/InterDisplay-600.woff2") format("woff2");
               font-style:normal; font-weight:600; font-display:swap; }
  @font-face { font-family:"MX Inter Display"; src:url("fonts/InterDisplay-700.woff2") format("woff2");
               font-style:normal; font-weight:700; font-display:swap; }
  :root {
    --pw-disp: "MX Inter Display", Inter, "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", "Noto Sans CJK SC", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    /* page accent set = the dossier's existing thread colors, promoted to tokens
       (dark values are the base — theme.css is dark-default, light overrides) */
    --pwa: #c77dff;   /* fed violet — the page identity */
    --pwb: #5b8def;   /* policy blue */
    --pwt: #3fb6c0;   /* treasury / dollar teal */
    --pwg: #3fc07e;   /* working / hit green */
    --pwam: #e0973a;  /* prior / caution amber */
    --pwr: #ef6a6a;   /* miss / lagging red */
  }
  html[data-theme="light"] {
    --pwa: #8b46e0; --pwb: #3b63d4; --pwt: #147f8a; --pwg: #1f9a55; --pwam: #a8701f; --pwr: #d23f3f;
  }
  html { scroll-behavior:smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior:auto; } }

  /* ── hero ── */
  .pw-hero { max-width:1060px; margin:18px auto 0; position:relative; overflow:hidden;
             background:radial-gradient(620px 240px at 88% -30%, color-mix(in srgb, var(--pwa) 10%, transparent), transparent 70%), var(--panel);
             border:1px solid var(--line); border-radius:16px; padding:24px 28px 22px;
             display:grid; grid-template-columns:1.35fr .85fr 1fr; gap:14px 30px; box-shadow:var(--card-shadow, none); }
  .pw-hero::before { content:""; position:absolute; inset:0 0 auto 0; height:3px;
             background:linear-gradient(90deg, var(--pwa), color-mix(in srgb, var(--pwa) 12%, transparent) 60%, transparent); }
  @media (max-width: 960px) { .pw-hero { grid-template-columns:1fr; } }
  .pw-hero .eyebrow { font-family:var(--pw-disp); font-size:11px; font-weight:600; letter-spacing:.06em;
             text-transform:uppercase; color:var(--pwa); margin:0 0 10px; }
  .pw-hero h1 { font-family:var(--pw-disp); font-size:30px; font-weight:700; letter-spacing:-.02em; margin:0 0 8px; line-height:1.12; }
  html[data-lang="zh"] .pw-hero h1, html[data-lang="zh"] .pw-hero .eyebrow, html[data-lang="zh"] .pw-ovl { letter-spacing:0; }
  .pw-hero .lens { font-size:13px; color:var(--muted); margin:0 0 14px; line-height:1.55; max-width:46ch; }
  .pw-chips { display:flex; flex-wrap:wrap; gap:7px; }
  .pwc { display:inline-flex; align-items:center; gap:5px; font-size:11.5px; line-height:1; padding:6px 10px;
         border-radius:999px; background:var(--panel2); border:1px solid var(--line); color:var(--muted); white-space:nowrap; }
  .pwc b { color:var(--text); font-variant-numeric:tabular-nums; }
  .pwc.age-ok    { color:var(--pwg); border-color:color-mix(in srgb, var(--pwg) 30%, transparent); }
  .pwc.age-amber { color:var(--pwam); border-color:color-mix(in srgb, var(--pwam) 32%, transparent); }
  .pwc.age-red   { color:var(--pwr); border-color:color-mix(in srgb, var(--pwr) 32%, transparent); }
  /* stance cell */
  .pw-ovl { font-family:var(--pw-disp); font-size:11px; font-weight:600; letter-spacing:.06em;
            text-transform:uppercase; color:var(--muted); margin:0 0 8px; display:flex; align-items:center; gap:7px; }
  .pw-dot { width:7px; height:7px; border-radius:50%; background:var(--c, var(--muted)); flex:0 0 auto; }
  .pw-state { font-family:var(--pw-disp); font-size:26px; font-weight:700; letter-spacing:-.02em; margin:0 0 6px; line-height:1.15; }
  html[data-lang="zh"] .pw-state { letter-spacing:0; }
  .pw-state.s-down { color:var(--pwr); }
  .pw-state.s-up { color:var(--pwg); }
  .pw-state.s-muted { color:var(--text); }
  .pw-since { font-size:12px; color:var(--muted); margin:0 0 8px; font-variant-numeric:tabular-nums; }
  .pw-drv { font-size:11.5px; color:var(--muted); margin:0; line-height:1.6; }
  /* decision clock cell */
  .pw-clock { border-left:1px solid var(--line); padding-left:26px; }
  @media (max-width: 960px) { .pw-clock { border-left:none; padding-left:0; border-top:1px solid var(--line); padding-top:14px; } }
  .pw-ck-row { display:flex; align-items:baseline; gap:9px; padding:6px 0; border-bottom:1px dashed color-mix(in srgb, var(--line) 72%, transparent); }
  .pw-ck-row:last-of-type { border-bottom:none; }
  .pw-ck-date { font-family:var(--pw-disp); font-weight:600; font-size:12px; font-variant-numeric:tabular-nums; white-space:nowrap; color:var(--text); }
  .pw-ck-ev { font-size:12px; line-height:1.4; color:var(--text); opacity:.9; flex:1; min-width:0; }
  .pw-ck-ev .imp { margin-left:6px; }
  .pw-ck-chip { font-size:10px; font-weight:700; letter-spacing:.03em; padding:2px 7px; border-radius:6px; white-space:nowrap; }
  .pw-ck-chip.up { color:var(--pwa); background:color-mix(in srgb, var(--pwa) 14%, transparent); }
  .pw-ck-chip.past { color:var(--muted); background:var(--panel2); }
  .pw-ck-note { font-size:11px; color:var(--muted); margin:8px 0 0; }
  /* impact dots: 3/2/1 filled for high/medium/low */
  .imp { display:inline-flex; gap:3px; align-items:center; vertical-align:middle; }
  .imp i { width:5px; height:5px; border-radius:50%; background:color-mix(in srgb, var(--muted) 32%, transparent); }
  .imp i.on { background:var(--pwa); }

  /* ── merged notice band (divergence + staleness live here, once) ── */
  .pw-note { max-width:1060px; margin:14px auto 0; border:1px solid color-mix(in srgb, var(--pwam) 32%, transparent);
             border-left:3px solid var(--pwam); background:color-mix(in srgb, var(--pwam) 7%, var(--panel));
             border-radius:12px; padding:11px 16px; font-size:13px; line-height:1.6; }
  .pw-note p { margin:2px 0; }

  /* ── on-page jump chips ── */
  .pw-toc { max-width:1060px; margin:16px auto 0; display:flex; flex-wrap:wrap; gap:7px; }
  .pw-toc a { font-family:var(--pw-disp); font-size:11px; font-weight:600; letter-spacing:.04em; text-transform:uppercase;
              color:var(--muted); border:1px solid var(--line); border-radius:999px; padding:6px 12px;
              transition:color .16s, border-color .16s; }
  .pw-toc a:hover { color:var(--text); border-color:color-mix(in srgb, var(--text) 26%, transparent); }
  html[data-lang="zh"] .pw-toc a { letter-spacing:0; }

  .pw-wrap { max-width:1060px; margin:0 auto; }

  /* ── thesis duo ── */
  .pw-duo { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin:18px 0 0; }
  @media (max-width: 860px) { .pw-duo { grid-template-columns:1fr; } }
  .pw-th { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 19px; box-shadow:var(--card-shadow, none); }
  .pw-th.key { border-top:3px solid var(--pwg); }
  .pw-th.warn { border-top:3px solid var(--pwam); }
  .pw-th .pw-ovl { margin-bottom:9px; }
  .pw-prose { font-size:13.5px; line-height:1.65; margin:0; display:-webkit-box; -webkit-line-clamp:8; -webkit-box-orient:vertical; overflow:hidden; }
  .pw-prose.open { display:block; -webkit-line-clamp:unset; overflow:visible; }
  .pw-more { appearance:none; background:none; border:none; padding:8px 0 0; cursor:pointer;
             font:600 12px/1 var(--pw-disp); color:var(--pwa); letter-spacing:.02em; }
  .pw-more:hover { text-decoration:underline; }
  .pw-more .less, .pw-more.open .more { display:none; }
  .pw-more.open .less { display:inline; }

  /* ── section rhythm ── */
  .pw-sec { border-top:1px solid var(--line); margin-top:40px; padding-top:26px; scroll-margin-top:84px; }
  .pw-sec h2 { font-family:var(--pw-disp); font-size:20px; font-weight:600; letter-spacing:-.01em; margin:0 0 6px; }
  html[data-lang="zh"] .pw-sec h2 { letter-spacing:0; }
  h3.sub { font-family:var(--pw-disp); font-size:11.5px; margin:20px 0 8px; color:var(--muted);
           text-transform:uppercase; letter-spacing:.06em; font-weight:600; }
  html[data-lang="zh"] h3.sub { letter-spacing:0; }
  .lede { font-size:13.5px; line-height:1.65; }
  .pw-lede { font-size:13px; line-height:1.6; color:var(--muted); margin:4px 0 10px; max-width:88ch; }

  /* ── badges (basis / status / confidence) ── */
  .b { display:inline-block; font-size:10px; font-weight:700; letter-spacing:.03em; padding:2.5px 7px; border-radius:6px; white-space:nowrap; }
  .b-fact { color:var(--pwg); background:color-mix(in srgb, var(--pwg) 13%, transparent); }
  .b-inf  { color:var(--pwa); background:color-mix(in srgb, var(--pwa) 14%, transparent); }
  .b-prior{ color:var(--pwam); background:color-mix(in srgb, var(--pwam) 14%, transparent); }
  .b-open { color:var(--muted); background:var(--panel2); }
  .b-hit  { color:var(--pwg); background:color-mix(in srgb, var(--pwg) 13%, transparent); }
  .b-miss { color:var(--pwr); background:color-mix(in srgb, var(--pwr) 13%, transparent); }
  .th-fed{color:var(--pwa)}.th-treasury{color:var(--pwt)}.th-policy{color:var(--pwb)}.th-rotation{color:var(--pwg)}.th-debasement{color:var(--pwam)}.th-dollar{color:var(--pwt)}
  .conf { font-size:11px; color:var(--muted); }

  /* ── panels + cards ── */
  .pw-panel { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:15px 18px; margin:12px 0; box-shadow:var(--card-shadow, none); }
  .pw-panel .pw-ovl { margin-bottom:7px; }
  .pw-panel.warn { border-left:3px solid var(--pwam); }
  .pw-quote { border-left:3px solid var(--pwa); background:var(--panel2); border-radius:0 10px 10px 0;
              padding:10px 14px; margin:12px 0; font-size:13px; line-height:1.6; }
  .cards { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:12px; margin:12px 0; }
  .card { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:15px 17px;
          box-shadow:var(--card-shadow, none); transition:border-color .16s; }
  .card:hover { border-color:color-mix(in srgb, var(--text) 18%, var(--line)); }
  .card .cn { font-family:var(--pw-disp); font-weight:600; font-size:14.5px; letter-spacing:-.01em; margin:0 0 4px; line-height:1.35; }
  .card .cmeta { font-size:11px; color:var(--muted); margin-bottom:8px; display:flex; gap:7px; flex-wrap:wrap; align-items:center; }
  .card .cch { font-size:12.5px; line-height:1.55; margin:6px 0; }
  .pw-block { margin-top:9px; padding-left:10px; border-left:2px solid var(--line); font-size:12.5px; line-height:1.55; }
  .pw-block.read { border-left-color:var(--pwa); }
  .pw-block.cap { border-left-color:var(--pwt); }
  .pw-block .pw-bl { display:block; font-family:var(--pw-disp); font-size:10px; font-weight:600;
                     letter-spacing:.06em; text-transform:uppercase; color:var(--muted); margin-bottom:3px; }
  html[data-lang="zh"] .pw-block .pw-bl { letter-spacing:0; }
  .pw-tkr { font-family:var(--pw-disp); font-weight:600; letter-spacing:0; }

  /* ── tables ── */
  table.data { border-collapse:collapse; width:100%; font-size:12.5px; margin:10px 0; }
  table.data th { font-family:var(--pw-disp); text-align:left; padding:8px 10px; background:var(--panel2); color:var(--muted);
                  font-weight:600; font-size:10.5px; letter-spacing:.06em; text-transform:uppercase; border-bottom:2px solid var(--line); }
  html[data-lang="zh"] table.data th { letter-spacing:0; }
  table.data td { padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; line-height:1.5; }
  table.data tr:hover td { background:var(--panel2); }
  table.data td .num, table.data td strong { font-variant-numeric:tabular-nums; }
  tr.key-row td { background:color-mix(in srgb, var(--pwa) 6%, transparent); }
  tr.key-row:hover td { background:color-mix(in srgb, var(--pwa) 10%, transparent); }
  .k-star { color:var(--pwa); }
  .prox { font-family:var(--pw-disp); font-weight:600; font-size:11px; letter-spacing:.01em; color:var(--text); opacity:.85; }
  .led-stat { display:flex; gap:8px; flex-wrap:wrap; margin:8px 0 4px; }

  /* ── monitor + sources ── */
  .monitor { list-style:none; padding:0; margin:12px 0; display:grid; grid-template-columns:1fr 1fr; gap:2px 26px; }
  @media (max-width: 760px) { .monitor { grid-template-columns:1fr; } }
  .monitor li { margin:0; padding:8px 2px; font-size:13px; border-bottom:1px dashed color-mix(in srgb, var(--line) 72%, transparent); }
  .monitor a { color:var(--link); }
  .srcs { font-size:11.5px; color:var(--muted); word-break:break-word; line-height:2; }
  .srcs a { color:var(--link); border:1px solid var(--line); border-radius:6px; padding:2px 6px; margin-right:2px; white-space:nowrap; }
  .srcs a:hover { border-color:color-mix(in srgb, var(--link) 45%, transparent); }
{% endblock %}

{% block content %}
{# decision clock feed: next 3 upcoming catalysts, else the 3 most recent past #}
{% set _spine = catalysts.spine if catalysts and catalysts.spine else [] %}
{% set _up = _spine | rejectattr('past') | list %}
{% set _past = _spine | selectattr('past') | list %}
{% set _clock = _up[:3] if _up else (_past[-3:] | reverse | list) %}
{% set _WEIGHT = {'high':'高','medium':'中','low':'低'} %}
{% set _WN = {'high':3,'medium':2,'low':1} %}

<section class="pw-hero">
  <div>
    <p class="eyebrow">{{ t('Policy intelligence', '政策情报') }}</p>
    <h1>{{ t('Fed & Policy Watch', '美联储与政策观察') }}</h1>
    <p class="lens">{{ t('What policymakers do, not what they say — non-partisan · as of', '看政策制定者做什么，而非说什么 — 非党派 · 截至') }} {{ intel.as_of }}</p>
    <div class="pw-chips">
      {% set _resolved = counts.hit + counts.miss %}
      <span class="pwc"><b>{{ counts.total }}</b> {{ t('calls on record', '在案判断') }}</span>
      <span class="pwc">{{ _resolved }} {{ t('graded', '已核') }}{% if counts.hit_rate is not none %} · <b>{{ (counts.hit_rate*100)|round|int }}%</b> {{ t('landed', '命中') }}{% endif %}{% if dates and dates.overdue_predictions %} · <span class="r-neg">{{ dates.overdue_predictions }} {{ t('due', '待结') }}</span>{% endif %}</span>
      {% if scorecard %}
      <span class="pwc">{{ t('rotation', '轮动') }}: <span class="r-pos">{{ scorecard.rotation.working }} {{ t('working', '达标') }}</span> · <span class="r-neg">{{ scorecard.rotation.lagging }} {{ t('lagging', '落后') }}</span></span>
      {% endif %}
      {% if dates and dates.staleness and dates.staleness.age_days is not none %}
      {% set _age = dates.staleness.age_days %}
      {% set _age_cls = 'age-red' if _age > 14 else ('age-amber' if _age > 7 else 'age-ok') %}
      <span class="pwc {{ _age_cls }}"><span class="l-en">intel {{ _age }}d old</span><span class="l-zh">情报已{{ _age }}天未更新</span></span>
      {% endif %}
    </div>
  </div>
  {% if fed_stance and fed_stance.stance != 'unknown' %}
  <div>
    <p class="pw-ovl"><i class="pw-dot" style="--c:var(--pwa)"></i>{{ t('Fed stance — read from market prices', '美联储姿态 — 由市场价格读出') }}</p>
    <p class="pw-state s-{{ fed_stance.color }}">{{ bl(fed_stance.label_en, fed_stance.label_zh) }}</p>
    {% if fed_hist and fed_hist.days_in_stance is not none %}
    <p class="pw-since">{{ t('for', '已持续') }} {{ fed_hist.days_in_stance }}{{ t('d', '天') }} · {{ t('since', '自') }} {{ fed_hist.since }}{% if fed_hist.changed_recently %} <span class="b b-open">{{ t('recently shifted', '近期转变') }}</span>{% endif %}</p>
    {% endif %}
    {% if fed_stance.drivers_en %}
    <p class="pw-drv"><span class="l-en">{{ fed_stance.drivers_en | join(' · ') }}</span><span class="l-zh">{{ fed_stance.drivers_zh | join(' · ') }}</span></p>
    {% endif %}
  </div>
  {% endif %}
  {% if _clock %}
  <div class="pw-clock">
    <p class="pw-ovl"><i class="pw-dot" style="--c:var(--pwb)"></i>{{ t('Decision clock', '决议时钟') }}</p>
    {% for c in _clock %}
    <div class="pw-ck-row">
      <span class="pw-ck-date">{{ c.date[5:] if c.date|length == 10 else c.date }}</span>
      <span class="pw-ck-ev">{% if c.key %}<span class="k-star">★</span> {% endif %}{{ bl(c.event_en, c.event_zh) }}<span class="imp" aria-hidden="true">{% for i in range(3) %}<i class="{{ 'on' if i < _WN.get(c.weight, 1) }}"></i>{% endfor %}</span></span>
      <span class="pw-ck-chip {{ 'past' if c.past else 'up' }}">{% if c.past %}{{ t('passed', '已过') }}{% elif c.days_to == 0 %}{{ t('today', '今日') }}{% elif c.days_to == 1 %}{{ t('tomorrow', '明日') }}{% elif c.days_to is not none %}{{ t('in', '剩') }} {{ c.days_to }}{{ t('d', '天') }}{% else %}{{ t('dated', '已定') }}{% endif %}</span>
    </div>
    {% endfor %}
    {% if not _up %}<p class="pw-ck-note">{{ t('No dated catalysts ahead — calendar refreshes with the next intel update.', '暂无未来催化剂 — 日历将随下次情报更新刷新。') }}</p>{% endif %}
  </div>
  {% endif %}
</section>

{% set _stale = dates and dates.staleness and dates.staleness.stale %}
{% set _sd = scorecard.rotation.sharpest_divergence if scorecard and scorecard.rotation.sharpest_divergence else None %}
{% if _sd or _stale %}
<div class="pw-note">
  {% if _sd %}
  {% set _sd_zh = (intel.rotation.targeted | selectattr('theme_en', 'equalto', _sd.theme) | map(attribute='theme_zh') | first) or _sd.theme %}
  <p>⚠ <b>{{ t('Sharpest divergence', '最大背离') }}:</b> {{ t('the map targets', '地图看好') }} <b>{{ bl(_sd.theme, _sd_zh) }}</b> {{ t('but it is lagging SPY by', '但其跑输标普') }} {{ '%.1f'|format(_sd.rel*100) }}% — {{ t('evidence against that leg of the rotation thesis.', '是对该轮动判断的反证。') }}</p>
  {% endif %}
  {% if _stale %}
  <p>⏳ <b>{{ t('Intel is', '情报已') }} {{ dates.staleness.age_days }} {{ t('days old', '天未更新') }}</b> — {{ t('re-verify before acting; this layer is time-sensitive (truces, ceasefires and pending rulings move).', '行动前请重新核实；该层具时效性（休战、停火与待决裁决随时变化）。') }}</p>
  {% endif %}
</div>
{% endif %}

<nav class="pw-toc" aria-label="On this page">
  {% if catalysts and catalysts.spine %}<a href="#calendar">{{ t('Calendar', '日历') }}</a>{% endif %}
  {% if desk %}<a href="#desk">{{ t('Intent desk', '意图台') }}</a>{% endif %}
  <a href="#fed">{{ t('The Fed', '美联储') }}</a>
  <a href="#admin">{{ t('Administration', '行政当局') }}</a>
  <a href="#rotation">{{ t('Rotation map', '轮动地图') }}</a>
  <a href="#ledger">{{ t('Ledger', '台账') }}</a>
  <a href="#monitor">{{ t('Monitor', '监测') }}</a>
  <a href="#sources">{{ t('Sources', '来源') }}</a>
</nav>

<div class="pw-wrap">

  <div class="pw-duo">
    <div class="pw-th key">
      <p class="pw-ovl"><i class="pw-dot" style="--c:var(--pwg)"></i>{{ t('The thesis', '核心论点') }}</p>
      <p class="pw-prose" id="pw-thesis">{{ bl(intel.thesis.en, intel.thesis.zh) }}</p>
      <button class="pw-more" aria-expanded="false" aria-controls="pw-thesis" type="button"><span class="more">{{ t('Read the full thesis ▾', '展开全文 ▾') }}</span><span class="less">{{ t('Show less ▴', '收起 ▴') }}</span></button>
    </div>
    <div class="pw-th warn">
      <p class="pw-ovl"><i class="pw-dot" style="--c:var(--pwam)"></i>{{ t('Narrative vs revealed interest', '叙事 vs 真实利益') }}</p>
      <p class="pw-prose" id="pw-regime">{{ bl(intel.regime_read.en, intel.regime_read.zh) }}</p>
      <button class="pw-more" aria-expanded="false" aria-controls="pw-regime" type="button"><span class="more">{{ t('Read the full read ▾', '展开全文 ▾') }}</span><span class="less">{{ t('Show less ▴', '收起 ▴') }}</span></button>
    </div>
  </div>

  <!-- ================= CATALYST SPINE ================= -->
  {% if catalysts and catalysts.spine %}
  {% set _wcls = {'high':'b-inf','medium':'b-prior','low':'b-open'} %}
  {{ sec_head('calendar', 'var(--pwb)', 'Calendar', '日历', 'Catalyst spine — inflation to decision', '催化剂主线 — 从通胀到决议') }}
  <p class="pw-lede">{{ bl(catalysts.intro_en, catalysts.intro_zh) }}</p>
  <table class="data">
    <tr><th>{{ t('Date', '日期') }}</th><th>{{ t('Event', '事件') }}</th><th>{{ t('Impact', '影响') }}</th><th>{{ t('Read', '解读') }}</th></tr>
    {% for c in catalysts.spine %}
    <tr{% if c.key %} class="key-row"{% endif %}>
      <td style="white-space:nowrap">
        <strong>{{ c.date }}</strong><br>
        <span class="conf">{{ bl(c.when_en, c.when_zh) }}</span>
        {% if c.days_to is not none %}<br><span class="b {{ 'b-open' if c.past else 'b-fact' }}">{% if c.past %}{{ t('passed', '已过') }}{% elif c.days_to == 0 %}{{ t('today', '今日') }}{% elif c.days_to == 1 %}{{ t('tomorrow', '明日') }}{% else %}{{ t('in', '剩') }} {{ c.days_to }}{{ t('d', '天') }}{% endif %}</span>{% endif %}
      </td>
      <td>{% if c.key %}<span class="k-star">★</span> {% endif %}<strong>{{ bl(c.event_en, c.event_zh) }}</strong></td>
      <td><span class="imp" aria-hidden="true">{% for i in range(3) %}<i class="{{ 'on' if i < _WN.get(c.weight, 1) }}"></i>{% endfor %}</span> <span class="b {{ _wcls.get(c.weight, 'b-open') }}">{{ code(c.weight, _WEIGHT) }}</span></td>
      <td>{{ bl(c.note_en, c.note_zh) }}</td>
    </tr>
    {% endfor %}
  </table>
  <p class="conf">{{ t('★ = the catalysts that actually move the decision (June CPI → the July 28–29 FOMC). Each hot print ratchets hike odds; PCE is largely pre-figured. Context, not a signal.', '★ = 真正影响决议的催化剂（6月CPI → 7月28–29日FOMC）。每次偏热读数都上调加息概率；PCE 大体已被预定。仅供参考、并非信号。') }}</p>
  {% endif %}

  <!-- ================= INTENT DESK (LLM, accountable) ================= -->
  {% if desk %}
  {{ sec_head('desk', 'var(--pwa)', 'Intent desk', '意图台', 'Intent Desk — accountable realpolitik leans', '意图台 — 可问责的现实政治判断') }}
  <p class="pw-lede">{{ t('An LLM reads the sourced intel + live market state and emits dated, checkable leans (a proxy ticker vs SPY) that are scored over time. Context only — never a size or a trade; intent is a tracked hypothesis, not an oracle.',
      '由LLM读取来源情报+实时市场状态，给出有日期、可检验的判断（某代理标的 vs SPY），并随时间评分。仅供参考——绝非仓位或交易；意图是被追踪的假设，而非神谕。') }}</p>
  {% if desk.regime_context %}<div class="pw-quote">{{ bl(desk.regime_context, desk.regime_context_zh) }}</div>{% endif %}
  {% if desk.track_record and desk.track_record.overall and desk.track_record.overall.n %}
  <div class="led-stat">
    <span class="pwc"><b>{{ desk.track_record.overall.n }}</b> {{ t('scored', '已评分') }}</span>
    {% if desk.track_record.overall.hit_rate is not none %}<span class="pwc"><b>{{ (desk.track_record.overall.hit_rate*100)|round|int }}%</b> {{ t('held up', '至今成立') }}</span>{% endif %}
    {% if desk.track_record.open %}<span class="pwc">{{ desk.track_record.open }} {{ t('open', '未结') }}</span>{% endif %}
    <span class="conf">{{ bl(desk.track_record.calibration_note, desk.track_record.calibration_note_zh) }}</span>
  </div>
  {% endif %}
  {% if desk.theses %}
  <div class="cards">
    {% for th in desk.theses %}
    <div class="card">
      <div class="cn"><span class="th-{{ 'fed' if th.actor=='fed' else 'policy' }}">{{ code((th.actor or 'admin')|upper, _ACTOR) }}</span> · <span class="pw-tkr">{{ th.subject }}</span> — <span class="b {{ 'b-fact' if th.lean=='overweight' else 'b-miss' }}">{{ code(th.lean, _LEAN) }}</span></div>
      <div class="cmeta">
        <span class="conf">{{ tr(th.conviction, _CONF_TR) }} {{ t('conviction', '置信') }}</span>
        <span class="b b-open">{{ t('check by', '核查于') }} {{ th.check_by }}</span>
        <span class="conf">{{ code(th.falsifier.check.kind if th.falsifier and th.falsifier.check else 'soft', _KIND) }}</span>
      </div>
      <div class="cch">{{ bl(th.thesis, th.thesis_zh) }}</div>
      {% if th.dissent %}<div class="cch" style="color:var(--muted)"><b>{{ t('Dissent', '反方') }}:</b> {{ bl(th.dissent, th.dissent_zh) }}</div>{% endif %}
      {% if th.falsifier and th.falsifier.text %}<div class="pw-block read"><span class="pw-bl">{{ t('What changes this read', '改判条件') }}</span>{{ bl(th.falsifier.text, th.falsifier.text_zh) }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% elif desk.degraded_reason %}
  <div class="pw-panel warn">{{ t('Desk note pending — the LLM layer generates in CI (needs the model key).', '台注待生成 —— LLM层在CI中生成（需模型密钥）。') }} <span class="conf">({{ desk.degraded_reason }})</span></div>
  {% endif %}
  <p class="conf">{{ bl(desk.disclaimer, desk.disclaimer_zh) }}</p>
  {% endif %}

  <!-- ================= THE FED ================= -->
  {{ sec_head('fed', 'var(--pwa)', 'The Fed', '美联储', 'The Fed under Warsh', '沃什治下的美联储') }}
  <p class="lede">{{ bl(intel.fed.profile.en, intel.fed.profile.zh) }}</p>

  {% if fed_stance and fed_stance.stance != 'unknown' %}
  {% set scls = 'b-miss' if fed_stance.color=='down' else ('b-fact' if fed_stance.color=='up' else 'b-open') %}
  <div class="pw-panel">
    <p class="pw-ovl"><i class="pw-dot" style="--c:var(--pwa)"></i>{{ t('Reaction function — read from market prices, not a forecast', '反应函数 — 由市场价格读出、并非预测') }}
      <span class="b {{ scls }}">{{ bl(fed_stance.label_en, fed_stance.label_zh) }}</span>{% if fed_hist and fed_hist.days_in_stance is not none %} <span class="conf">{{ t('for', '已持续') }} {{ fed_hist.days_in_stance }}{{ t('d', '天') }} ({{ t('since', '自') }} {{ fed_hist.since }}){% if fed_hist.changed_recently %} <span class="b b-open">{{ t('recently shifted', '近期转变') }}</span>{% endif %}</span>{% endif %}</p>
    {% if fed_stance.drivers_en %}<span class="l-en">{{ fed_stance.drivers_en | join(' · ') }}</span><span class="l-zh">{{ fed_stance.drivers_zh | join(' · ') }}</span>. {% endif %}
    <span class="conf">{{ bl(fed_stance.note_en, fed_stance.note_zh) }}</span>
  </div>
  {% endif %}

  {% if intel.fed.optionality_read %}
  <div class="pw-panel warn">
    <p class="pw-ovl"><i class="pw-dot" style="--c:var(--pwam)"></i>{{ t('Pivot infrastructure — the 6/24 read', '转向基础设施 —— 6/24 解读') }}
      <span class="b b-inf">{{ tr(intel.fed.optionality_read.basis, _BASIS_TR) }}</span> <span class="conf">{{ tr(intel.fed.optionality_read.confidence, _CONF_TR) }}</span></p>
    {{ bl(intel.fed.optionality_read.en, intel.fed.optionality_read.zh) }}
  </div>
  {% endif %}

  <h3 class="sub">{{ t('Reform task forces — dated, checkable', '改革工作组 — 有日期、可检验') }}</h3>
  <div class="cards">
    {% for tf in intel.fed.task_forces %}
    <div class="card">
      <div class="cn">{{ bl(tf.name_en, tf.name_zh) }}</div>
      <div class="cmeta">
        <span class="b b-open">{{ t('check by', '核查于') }} {{ tf.check_by }}</span>
        {% set td = (dates.task_forces[tf.id] if dates and dates.task_forces and tf.id in dates.task_forces else None) %}
        {% if td and td.days_to is not none %}{% if td.overdue %}<span class="b b-miss">{{ t('overdue', '已逾期') }}</span>{% else %}<span class="conf">{{ t('in', '剩') }} {{ td.days_to }}{{ t('d', '天') }}</span>{% endif %}{% endif %}
        <span class="b {{ 'b-fact' if 'FACT' in tf.basis else 'b-inf' }}">{{ tr(tf.basis, _BASIS_TR) }}</span>
        <span class="conf">{{ tr(tf.confidence, _CONF_TR) }}</span>
      </div>
      <div class="cch">{{ bl(tf.charter_en, tf.charter_zh) }}</div>
      <div class="pw-block read"><span class="pw-bl">{{ t('Realpolitik read', '现实政治解读') }}</span>{{ bl(tf.realpolitik_en, tf.realpolitik_zh) }}</div>
    </div>
    {% endfor %}
  </div>
  <p class="pw-lede">⏳ {{ bl(intel.fed.staffing_note.en, intel.fed.staffing_note.zh) }}</p>

  <!-- ================= THE ADMINISTRATION ================= -->
  {{ sec_head('admin', 'var(--pwb)', 'Administration', '行政当局', 'The Administration', '行政当局') }}
  <p class="lede">{{ bl(intel.administration.grand_strategy.en, intel.administration.grand_strategy.zh) }}</p>
  <p class="conf">{{ t('Decision-makers tracked', '追踪的决策者') }}: <span class="l-en">{{ intel.administration.decision_makers | join(' · ') }}</span><span class="l-zh">{{ (intel.administration.decision_makers_zh if intel.administration.decision_makers_zh else intel.administration.decision_makers) | join(' · ') }}</span></p>

  <h3 class="sub">{{ t('Verified policy levers', '已核实的政策杠杆') }}</h3>
  <div class="cards">
    {% for lv in intel.administration.verified_levers %}
    <div class="card">
      <div class="cn">{{ bl(lv.title_en, lv.title_zh) }}</div>
      <div class="cmeta">
        <span class="b {{ 'b-fact' if lv.basis.startswith('FACT') else 'b-inf' }}">{{ tr(lv.basis, _BASIS_TR) }}</span>
        <span class="conf">{{ tr(lv.confidence, _CONF_TR) }}</span>
      </div>
      <div class="cch">{{ bl(lv.detail_en, lv.detail_zh) }}</div>
    </div>
    {% endfor %}
  </div>
  <h3 class="sub">{{ t('Geopolitical theaters', '地缘政治战区') }}</h3>
  <div class="cards">
    {% for th in intel.administration.theaters %}
    <div class="card">
      <div class="cn">{{ bl(th.title_en, th.title_zh) }}</div>
      <div class="cmeta">
        <span class="b {{ 'b-fact' if th.basis.startswith('FACT') else 'b-prior' }}">{{ tr(th.basis, _BASIS_TR) }}</span>
        <span class="conf">{{ tr(th.confidence, _CONF_TR) }}</span>
      </div>
      <div class="cch">{{ bl(th.facts_en, th.facts_zh) }}</div>
      <div class="pw-block read"><span class="pw-bl">{{ t('Realpolitik', '现实政治') }}</span>{{ bl(th.realpolitik_en, th.realpolitik_zh) }}</div>
      <div class="pw-block cap"><span class="pw-bl">{{ t('Capital', '资本') }}</span>{{ bl(th.capital_en, th.capital_zh) }}</div>
    </div>
    {% endfor %}
  </div>

  <!-- ================= CAPITAL ROTATION ================= -->
  {{ sec_head('rotation', 'var(--pwg)', 'Rotation', '资本轮动', 'Capital-rotation map', '资本轮动地图') }}
  <h3 class="sub">{{ t('Targeted / protected / subsidized', '受益 / 受保护 / 受补贴') }}</h3>
  <table class="data">
    <tr><th>{{ t('Theme', '主题') }}</th><th>{{ t('Mechanism', '机制') }}</th><th>{{ t('Proxies', '代理标的') }}</th><th>{{ t('Realized 63d vs SPY', '近63日 vs 标普') }}</th><th>{{ t('Basis', '依据') }}</th></tr>
    {% for r in intel.rotation.targeted %}
    <tr>
      <td><strong>{{ bl(r.theme_en, r.theme_zh) }}</strong></td>
      <td>{{ bl(r.mechanism_en, r.mechanism_zh) }}</td>
      <td class="prox">{{ r.proxies | join(' ') if r.proxies else '—' }}</td>
      <td class="num">{% set rc = (rot.themes[r.theme_en] if rot and rot.themes and (r.theme_en in rot.themes) else None) %}{% set rh = (rot_hist[r.theme_en] if rot_hist and (r.theme_en in rot_hist) else None) %}{% if rc and rc.verdict != 'na' %}<span class="b {{ {'working':'b-fact','lagging':'b-miss','mixed':'b-open'}[rc.verdict] }}">{{ code(rc.verdict, _VERDICT) }}</span> {{ '%+.1f'|format(rc.avg_rel*100) }}%{% if rh and rh.reads %}<br><span class="conf">{{ t('working', '达标') }} {{ rh.working }}/{{ rh.reads }}</span>{% endif %}{% else %}<span class="conf">—</span>{% endif %}</td>
      <td><span class="b {{ 'b-prior' if 'PRIOR' in r.basis else ('b-fact' if 'FACT' in r.basis else 'b-inf') }}">{{ tr(r.basis, _BASIS_TR) }}</span><br><span class="conf">{{ tr(r.confidence, _CONF_TR) }}</span></td>
    </tr>
    {% endfor %}
  </table>
  {% if rot %}<p class="conf">{{ t('Realized = mean trailing-63d return of the theme&#39;s proxies minus SPY (coincident, context-only — a persistently lagging TARGETED theme is evidence against the rotation call).', '“近63日”= 该主题代理标的过去63个交易日相对标普的平均超额收益（同步、仅供参考——长期跑输的受益主题即是对该轮动判断的反证）。') }}</p>{% endif %}
  <h3 class="sub">{{ t('Starved / pressured', '受冷落 / 承压') }}</h3>
  <table class="data">
    <tr><th>{{ t('Theme', '主题') }}</th><th>{{ t('Mechanism', '机制') }}</th><th>{{ t('Proxies', '代理标的') }}</th><th>{{ t('Basis', '依据') }}</th></tr>
    {% for r in intel.rotation.starved %}
    <tr>
      <td><strong>{{ bl(r.theme_en, r.theme_zh) }}</strong></td>
      <td>{{ bl(r.mechanism_en, r.mechanism_zh) }}</td>
      <td class="prox">{{ r.proxies | join(' ') if r.proxies else '—' }}</td>
      <td><span class="b {{ 'b-prior' if 'PRIOR' in r.basis else ('b-fact' if 'FACT' in r.basis else 'b-inf') }}">{{ tr(r.basis, _BASIS_TR) }}</span><br><span class="conf">{{ tr(r.confidence, _CONF_TR) }}</span></td>
    </tr>
    {% endfor %}
  </table>

  <!-- ================= PREDICTION LEDGER ================= -->
  {{ sec_head('ledger', 'var(--pwam)', 'Ledger', '台账', 'Prediction ledger — dated calls, checked on schedule', '预测台账 — 有日期的判断，按期核查') }}
  <p class="pw-lede">{{ t('The accountability spine: each call has a measurable outcome and a check-by date. Outcomes get scored over time so this layer earns a track record instead of being vibes. Policy-action calls (high-confidence, track explicit directives) are scored separately from market-outcome calls (lower-confidence inference).',
      '问责脊柱：每条判断都有可衡量的结果与核查日期。结果将随时间被评分，使该层积累真实战绩而非凭感觉。政策行动类判断（高置信、追踪明确指令）与市场结果类判断（低置信、属推断）分开评分。') }}</p>
  <div class="led-stat">
    <span class="pwc"><b>{{ counts.total }}</b> {{ t('total', '总计') }}</span>
    <span class="pwc"><b>{{ counts.open }}</b> {{ t('open', '未结') }}</span>
    <span class="pwc"><b{% if counts.hit %} class="r-pos"{% endif %}>{{ counts.hit }}</b> {{ t('hit', '命中') }}</span>
    <span class="pwc"><b{% if counts.miss %} class="r-neg"{% endif %}>{{ counts.miss }}</b> {{ t('miss', '落空') }}</span>
    {% if dates and dates.overdue_predictions %}<span class="pwc"><b>{{ dates.overdue_predictions }}</b> {{ t('past check-by', '已过核查') }}</span>{% endif %}
    <span class="pwc">{{ counts.policy_action }} {{ t('policy-action', '政策行动') }} · {{ counts.market_outcome }} {{ t('market-outcome', '市场结果') }}</span>
  </div>
  <table class="data">
    <tr><th>#</th><th>{{ t('Thread', '线索') }}</th><th>{{ t('Prediction', '预测') }}</th><th>{{ t('Check by', '核查于') }}</th><th>{{ t('Tier', '层级') }}</th><th>{{ t('Conf', '置信') }}</th><th>{{ t('Status', '状态') }}</th></tr>
    {% for p in intel.predictions %}
    <tr>
      <td><strong>{{ p.id }}</strong></td>
      <td><span class="th-{{ p.thread }}">{{ code(p.thread, _THREAD) }}</span></td>
      <td>{{ bl(p.text_en, p.text_zh) }}</td>
      <td style="white-space:nowrap"><span class="num">{{ p.check_by }}</span></td>
      <td><span class="conf">{{ code(p.tier, _TIER) }}</span></td>
      <td><span class="conf">{{ tr(p.confidence, _CONF_TR) }}</span></td>
      <td><span class="b b-{{ p.status }}">{{ code(p.status, _STATUS) }}</span>{% set pdt = (dates.predictions[p.id] if dates and dates.predictions and p.id in dates.predictions else None) %}{% if pdt and pdt.overdue %} <span class="b b-miss">{{ t('due', '待结') }}</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </table>

  <!-- ================= MONITOR ================= -->
  {{ sec_head('monitor', 'var(--pwt)', 'Monitor', '监测', 'Monitor — highest-signal sources', '监测 — 最高信号来源') }}
  <ul class="monitor">
    {% for m in intel.monitor %}
    <li>{% if m.url %}<a href="{{ m.url }}" target="_blank" rel="noopener">{{ bl(m.name, m.name_zh) }}</a>{% else %}<strong>{{ bl(m.name, m.name_zh) }}</strong>{% endif %} — <span class="conf">{{ bl(m.who, m.who_zh) }} · {{ bl(m.cadence, m.cadence_zh) }}</span></li>
    {% endfor %}
  </ul>

  <!-- ================= SOURCES + CAVEATS ================= -->
  {{ sec_head('sources', 'var(--pwt)', 'Sources', '来源', 'Sources & caveats', '来源与说明') }}
  <div class="pw-panel">
    {{ bl(intel.caveats.en, intel.caveats.zh) }}
  </div>
  <p class="srcs"><strong>{{ t('Primary sources', '一手来源') }}:</strong>
    {% for s in intel.sources %}<a href="{{ s }}" target="_blank" rel="noopener">[{{ loop.index }}]</a> {% endfor %}
  </p>
  <p class="conf">{{ t('Generated', '生成于') }} {{ generated_utc }} · {{ t('context only — not investment advice', '仅供参考——不构成投资建议') }}</p>

</div>
{% endblock %}

{% block body_scripts %}
<script>
(function () {
  // thesis read-more: clamp is CSS; the button just toggles + hides itself when
  // the paragraph already fits (short intel updates shouldn't show a dead toggle)
  document.querySelectorAll('.pw-more').forEach(function (b) {
    var p = document.getElementById(b.getAttribute('aria-controls'));
    if (!p) { b.hidden = true; return; }
    if (p.scrollHeight <= p.clientHeight + 6) { b.hidden = true; return; }
    b.addEventListener('click', function () {
      var open = p.classList.toggle('open');
      b.classList.toggle('open', open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });
})();
</script>
{% endblock %}
