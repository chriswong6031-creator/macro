{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help" tabindex="0" role="button" aria-label="What is this?">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Options Desk — GEX, walls & vol surface · 期权台</title>
{% set seo_title = "Options Desk: GEX, Walls & Vol Surface — Mastermind" %}{% set seo_desc = "Gamma exposure, option walls and the vol surface for major indexes and stocks — where dealers pin and where moves accelerate." %}{% set seo_path = "gex.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="illus.css">
<style>
  /* ============================================================================
     OPTIONS DESK — remaster. Built on theme.css tokens (Inter, --up/--down/
     --info/--orange, dark/light, zh red-green swap).
     · The workspace carries the regime accent (--rg): green calm / red jumpy.
     · Signature: the horizontal price ladder (walls, flip, magnet, expected
       range on one axis, low→high like a chart).
     · ALL "?" tips render through ONE floating, viewport-clamped popover
       (#gx-htip) — cards never clip them. No overflow:hidden on cards.
     · body top padding 18px = nav-gap law.
     ============================================================================ */
  *{box-sizing:border-box}
  body{background:var(--bg);color:var(--text);font-family:var(--font-ui,Inter,-apple-system,"Segoe UI",Roboto,sans-serif);
    font-size:15px;line-height:1.5;margin:0;padding:18px 0 0;-webkit-font-smoothing:antialiased}
  a{text-decoration:none;color:inherit}
  .wrap{max-width:1200px;margin:0 auto;padding:0 20px 64px}
  :focus-visible{outline:2px solid var(--info);outline-offset:2px;border-radius:6px}
  h1,h2,h3{margin:0}
  .muted{color:var(--muted)} .sm{font-size:12.5px} .xs{font-size:11px}
  .pos{color:var(--up)} .neg{color:var(--down)}
  .tabnum{font-variant-numeric:tabular-nums}
  [data-lang="en"] .l-zh,[data-lang="zh"] .l-en{display:none}

  /* ---- cards: airy, 16px radius, NO overflow clipping ---- */
  .card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px 22px;position:relative;margin:0 0 14px}
  .cardhead{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .kick{font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
  .anim{animation:gxUp .45s cubic-bezier(.2,.7,.3,1) both}
  .d1{animation-delay:.05s}.d2{animation-delay:.09s}.d3{animation-delay:.13s}.d4{animation-delay:.17s}

  /* ---- "?" help: the inline .tip is NEVER shown in place — gex.js clones it
         into the floating #gx-htip popover (viewport-clamped, never clipped) ---- */
  .help{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;
    border:1px solid var(--line);color:var(--muted);font-size:10px;font-weight:700;cursor:help;vertical-align:middle;margin-left:5px;flex:none}
  .help:hover,.help:focus{color:var(--text);border-color:var(--muted);outline:none}
  .help .tip{display:none}
  .help-pop{position:fixed;z-index:95;max-width:330px;background:var(--panel);border:1px solid var(--line);border-radius:11px;
    padding:11px 13px;font-size:12.5px;line-height:1.55;color:var(--text);box-shadow:var(--popover-shadow);display:none}
  .help-pop b{font-weight:700}

  /* ============================ PAGE HEADER ============================ */
  .pg{padding:8px 0 16px}
  .pg h1{font-size:22px;font-weight:800;letter-spacing:-.01em}
  .pg-sub{font-size:13.5px;color:var(--muted);margin:4px 0 0;max-width:720px}

  /* ---- Market Weather: slim, clearly WHOLE-MARKET strip ---- */
  .wx{padding:15px 20px}
  .wx-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin-top:8px}
  .wx-ic{font-size:21px;line-height:1}
  .wx-v{font-size:16px;font-weight:800;letter-spacing:-.01em}
  .wx-calm .wx-v,.wx-up .wx-v{color:var(--up)}
  .wx-jumpy .wx-v{color:var(--down)} .wx-warn .wx-v{color:var(--orange)}
  .wx-gauge{flex:0 1 180px;min-width:130px}
  .wx-gauge .track{position:relative;display:block;height:7px;border-radius:5px;background:linear-gradient(90deg,var(--down),var(--panel2) 50%,var(--up));border:1px solid var(--line)}
  .wx-gauge .mk{position:absolute;top:-4px;width:3px;height:13px;background:var(--text);transform:translateX(-50%);border-radius:2px}
  .wx-gauge .lbls{display:flex;justify-content:space-between;font-size:9.5px;color:var(--muted);margin-top:4px}
  .wx-stat{background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:5px 10px;font-size:12px}
  .wx-stat .k{color:var(--muted);font-size:9.5px;display:block;text-transform:uppercase;letter-spacing:.04em}
  .wx-stat .v{font-weight:700;font-size:12.5px;font-variant-numeric:tabular-nums}
  .wx-sub{font-size:13px;line-height:1.55;margin-top:9px;max-width:900px}
  .wx-more{margin-top:8px}
  .wx-more summary{cursor:pointer;font-size:12px;color:var(--muted);font-weight:600;list-style:none;display:inline-flex;align-items:center;gap:6px}
  .wx-more summary::-webkit-details-marker{display:none}
  .wx-more summary::after{content:"▸";font-size:10px;transition:transform .2s}
  .wx-more[open] summary::after{transform:rotate(90deg)}
  .wx-more summary:hover{color:var(--text)}
  .wx-bullets{margin:9px 0 0;padding:0;list-style:none;display:grid;gap:6px}
  .wx-bullets li{font-size:12.5px;line-height:1.5;padding-left:16px;position:relative}
  .wx-bullets li::before{content:"▸";position:absolute;left:2px;color:var(--muted)}
  .wx-foot{font-size:11px;color:var(--muted);margin-top:9px;line-height:1.5}
  .wx-scored{font-size:10.5px;font-weight:800;letter-spacing:.03em;color:var(--up);border:1px solid color-mix(in srgb,var(--up) 45%,var(--line));
    border-radius:999px;padding:2px 10px;white-space:nowrap;margin-left:auto}

  /* ---- primer ---- */
  .primer{border:1px solid var(--line);border-radius:14px;background:var(--panel);margin:0 0 14px}
  .primer summary{cursor:pointer;padding:13px 20px;font-weight:700;font-size:13px;list-style:none;display:flex;align-items:center;gap:10px}
  .primer summary::-webkit-details-marker{display:none}
  .primer summary .ic{width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:var(--panel2);flex:none}
  .primer summary .caret{margin-left:auto;font-size:11px;color:var(--muted);transition:transform .25s}
  .primer[open] summary .caret{transform:rotate(90deg)}
  .primer .body{padding:2px 22px 18px;border-top:1px solid var(--line)}
  .primer .body p{margin:13px 0 4px;font-weight:600;line-height:1.55;font-size:13.5px}
  .primer .body ul{margin:6px 0 0;padding-left:20px}
  .primer .body li{margin:7px 0;font-size:13px;line-height:1.6}
  .primer .body li b{color:var(--text)}

  /* ============================ WORKSPACE ============================ */
  /* toolbar + detail are one fused unit, so it's obvious the search drives
     the panel below it. The regime accent (--rg) lives on the toolbar. */
  .ws{--rg:var(--info)}
  .ws.gx-calm{--rg:var(--up)} .ws.gx-jumpy{--rg:var(--down)} .ws.gx-mixed{--rg:var(--info)}
  .ws-bar{position:relative;background:var(--panel);border:1px solid var(--line);border-bottom:0;border-radius:16px 16px 0 0;
    padding:13px 18px 12px;display:flex;flex-wrap:wrap;gap:9px 12px;align-items:center}
  .ws-bar::before{content:'';position:absolute;inset:0 0 auto 0;height:3px;border-radius:16px 16px 0 0;background:var(--rg)}
  .ws-search{position:relative;flex:1 1 250px;max-width:400px}
  .ws-search .mag{position:absolute;left:13px;top:50%;transform:translateY(-50%);opacity:.55;font-size:14px}
  .ws-search input{width:100%;padding:10px 13px 10px 38px;border:1px solid var(--line);border-radius:11px;
    background:var(--panel2);color:var(--text);font:inherit;font-size:14px;transition:border-color .15s,box-shadow .2s}
  .ws-search input:focus{outline:none;border-color:var(--info);box-shadow:0 0 0 3px color-mix(in srgb,var(--info) 16%,transparent)}
  .gx-sugg{position:absolute;top:112%;left:0;right:0;min-width:300px;background:var(--panel);border:1px solid var(--line);border-radius:12px;
    box-shadow:var(--popover-shadow);z-index:50;max-height:340px;overflow:auto;display:none;padding:5px}
  .gx-sugg.on{display:block}
  .gx-sugg .row{display:flex;justify-content:space-between;gap:10px;padding:8px 11px;cursor:pointer;border-radius:8px;align-items:center}
  .gx-sugg .row:hover,.gx-sugg .row.hl{background:var(--panel2)}
  .gx-sugg .row b{font-weight:700} .gx-sugg .row .g{color:var(--muted);font-size:11.5px}
  .ws-quick{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
  .qchip{padding:6px 12px;font-size:12px;font-weight:600;border:1px solid var(--line);background:var(--panel2);color:var(--muted);
    border-radius:999px;cursor:pointer;font-family:inherit;transition:color .12s,border-color .12s}
  .qchip:hover{color:var(--text);border-color:var(--muted)}
  .qchip.on{color:var(--rg);border-color:color-mix(in srgb,var(--rg) 45%,var(--line));background:color-mix(in srgb,var(--rg) 8%,var(--panel2))}
  .ws-hint{margin-left:auto;font-size:11.5px;color:var(--muted);white-space:nowrap}
  @media(max-width:700px){.ws-hint{display:none}}
  #gx-detail>.card:first-child{border-top-left-radius:0;border-top-right-radius:0}
  .gx-loading{color:var(--muted);padding:46px 6px;text-align:center}

  /* ---- hero ---- */
  .hero-top{display:flex;flex-wrap:wrap;align-items:flex-start;justify-content:space-between;gap:10px 16px}
  .hid .sym{font-size:30px;font-weight:900;letter-spacing:-.02em;line-height:1.05}
  .hid .nm{color:var(--muted);font-size:14px;margin-left:8px;font-weight:500}
  .hid .tag{display:block;font-size:11px;color:var(--muted);margin-top:5px;font-weight:600;letter-spacing:.02em}
  .hspot{text-align:right}
  .hspot .k{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;display:block;margin-bottom:2px}
  .hspot .v{font-size:28px;font-weight:800;line-height:1}
  .hv{display:flex;align-items:flex-start;gap:12px;margin-top:18px}
  .hv-ic{font-size:26px;line-height:1.15;flex:none}
  .hv-h{font-size:clamp(19px,2.6vw,24px);font-weight:800;letter-spacing:-.015em;line-height:1.2;color:var(--rg)}
  .hv-s{font-size:14px;line-height:1.55;color:var(--text);margin-top:5px;max-width:700px}
  .hv-s b{font-weight:700}
  .hchips{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px}
  .stance{display:inline-flex;align-items:center;gap:7px;padding:7px 14px;border-radius:999px;font-size:12.5px;font-weight:700;
    background:color-mix(in srgb,var(--rg) 11%,var(--panel));color:var(--rg);border:1px solid color-mix(in srgb,var(--rg) 32%,var(--line))}
  .stance .bd{width:7px;height:7px;border-radius:50%;background:currentColor;animation:gxBreathe 2.6s ease-in-out infinite;flex:none}
  .hchip{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:10px;background:var(--panel2);
    border:1px solid var(--line);font-size:12.5px}
  .hchip .k{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700}
  .hchip b{font-weight:800}
  .hchip.warn{color:var(--orange);border-color:color-mix(in srgb,var(--orange) 42%,var(--line));background:color-mix(in srgb,var(--orange) 7%,var(--panel2))}
  /* deep link to the live view of the same name in the Terminal (built in gex.js
     via theme.js MDXTerminal.url — carries &from=macro and the &ret= return stamp).
     Deliberately --info, NOT the regime accent --rg: this is navigation, and a chip
     that turned red on a jumpy name would read as a market warning it is not. */
  a.hchip.gx-term{text-decoration:none;color:var(--info);gap:6px;
    border-color:color-mix(in srgb,var(--info) 34%,var(--line));
    background:color-mix(in srgb,var(--info) 8%,var(--panel2));
    transition:background .16s ease,border-color .16s ease,transform .16s ease}
  a.hchip.gx-term:hover{background:color-mix(in srgb,var(--info) 15%,var(--panel2));
    border-color:color-mix(in srgb,var(--info) 55%,var(--line))}
  a.hchip.gx-term:focus-visible{outline:2px solid var(--info);outline-offset:2px}
  a.hchip.gx-term .gx-term-ar{font-size:11px;opacity:.75;transition:transform .16s ease}
  a.hchip.gx-term:hover .gx-term-ar{transform:translate(1px,-1px)}
  @media (prefers-reduced-motion:reduce){a.hchip.gx-term,a.hchip.gx-term .gx-term-ar{transition:none}}
  .hasof{margin-left:auto;display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--muted)}
  .hasof .bd{width:6px;height:6px;border-radius:50%;background:var(--up);animation:gxBreathe 2.8s ease-in-out infinite}

  /* ============================ PRICE LADDER (signature) ============================ */
  .lad{margin-top:14px}
  .lad svg{width:100%;height:auto;display:block;overflow:visible}
  .lad-key{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:10.5px;color:var(--muted);margin-top:6px}
  .lad-key i{display:inline-block;width:14px;height:8px;border-radius:2px;margin-right:5px;vertical-align:middle}
  .lrows{margin-top:14px;border-top:1px solid var(--line)}
  .lrow{display:grid;grid-template-columns:10px minmax(0,1fr) auto auto;gap:3px 10px;align-items:baseline;
    padding:10px 0;border-bottom:1px solid color-mix(in srgb,var(--line) 60%,transparent)}
  .lrow:last-child{border-bottom:none}
  .ldot{width:10px;height:10px;border-radius:3px;align-self:center}
  .lrow.cw .ldot{background:var(--up)} .lrow.pw .ldot{background:var(--down)}
  .lrow.flip .ldot{background:var(--info)} .lrow.mp .ldot{background:var(--orange)}
  .lname{font-size:13px;font-weight:700;min-width:0}
  .lstr{display:inline-flex;gap:2px;margin-left:8px;vertical-align:middle}
  .lstr i{width:6px;height:10px;border-radius:2px;background:var(--line);display:inline-block}
  .ldist{font-size:11.5px;color:var(--muted)}
  .lprice{font-size:15px;font-weight:800;text-align:right}
  .lwhy{grid-column:2/-1;font-size:12px;color:var(--muted);line-height:1.55}
  .lwhy b{color:var(--text);font-weight:600}
  .lad-foot{font-size:11px;color:var(--muted);line-height:1.5;margin-top:12px}
  .lad-foot b{color:var(--text);font-weight:600}
  .lad-empty{font-size:13px;color:var(--muted);margin:10px 0 0}
  .vh-pill{font-size:10.5px;font-weight:700;padding:2px 9px;border-radius:6px;border:1px solid var(--line);white-space:nowrap;margin-left:auto}
  .vh-pill.up{color:var(--up)} .vh-pill.down{color:var(--down)} .vh-pill.neu{color:var(--info)}
  .vh-pill.vol{color:var(--orange)} .vh-pill.na{color:var(--muted)}

  /* ============================ THREE READS ============================ */
  .reads{display:grid;grid-template-columns:1fr;gap:14px;margin:0 0 14px}
  @media(min-width:980px){.reads{grid-template-columns:repeat(3,1fr)}}
  .reads>.card{margin:0;min-width:0}
  .rhead{font-size:21px;font-weight:800;letter-spacing:-.015em;line-height:1.15;margin:9px 0 3px}
  .rhead.up{color:var(--up)} .rhead.down{color:var(--down)} .rhead.warn{color:var(--orange)} .rhead.info{color:var(--info)}
  .rsub{font-size:12.5px;color:var(--muted);line-height:1.55}
  .rmet{display:flex;align-items:baseline;gap:8px;margin-top:13px}
  .rmet b{font-size:20px;font-weight:800}
  .rmet .u{font-size:11px;color:var(--muted);line-height:1.3}
  .rgs{display:flex;gap:2px;margin-top:13px}
  .rgs i{flex:1 1 0;max-width:12px;height:16px;border-radius:2px}
  .rgs-cap{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:10.5px;color:var(--muted);margin-top:6px;align-items:center}
  .rgs-cap i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px;vertical-align:middle}
  .rspark{margin-top:12px}
  .mets{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
  .met{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:7px 11px;min-width:84px}
  .met .k{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;font-weight:700;display:block}
  .met .v{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;margin-top:1px}
  .ivr-building{display:inline-block;font-size:10px;background:var(--panel2);border:1px dashed var(--orange);border-radius:6px;
    padding:1px 7px;color:var(--orange);vertical-align:middle;margin-left:6px}
  .ivr-chip{display:inline-block;font-size:10px;font-weight:700;border-radius:6px;padding:1px 7px;margin-left:6px;vertical-align:middle;
    border:1px solid var(--line)}
  .leg{padding:9px 0;border-top:1px solid color-mix(in srgb,var(--line) 60%,transparent)}
  .leg:first-of-type{border-top:none}
  .legs{margin-top:11px}
  .leg-t{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .leg-ar{font-size:14px;font-weight:800;line-height:1;flex:none}
  .leg-ar.up{color:var(--up)} .leg-ar.down{color:var(--down)} .leg-ar.pin{color:var(--orange)} .leg-ar.flat{color:var(--muted)}
  .leg-n{font-size:12.5px;font-weight:700}
  .leg-hz{font-size:10px;font-weight:700;color:var(--info);border:1px solid color-mix(in srgb,var(--info) 35%,var(--line));
    border-radius:999px;padding:1px 8px}
  .leg-w{font-size:11.5px;color:var(--muted);line-height:1.5;margin-top:3px}
  .rfoot{font-size:10.5px;color:var(--muted);margin-top:12px;line-height:1.5}

  /* ============================ FLOW ============================ */
  .fl-head{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px}
  .fl-tag{font-size:13px;font-weight:800;display:flex;align-items:center;gap:7px}
  .fl-verdict{font-size:13px;font-weight:600}
  .fl.s-pos .fl-verdict{color:var(--up)} .fl.s-neg .fl-verdict{color:var(--down)}
  .fl-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px}
  .fl-chip{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:7px 11px;font-size:12px}
  .fl-chip .k{color:var(--muted);font-size:9.5px;display:block;text-transform:uppercase;letter-spacing:.04em;font-weight:700}
  .fl-chip .v{font-weight:800;font-size:13.5px;font-variant-numeric:tabular-nums}
  .fl-chip.pos .v{color:var(--up)} .fl-chip.neg .v{color:var(--down)}
  .fl-chip.soft{border-style:dashed;opacity:.8} .fl-chip.soft .v{color:var(--muted);font-weight:700}
  .fl-sec{margin-top:13px;border-top:1px solid var(--line);padding-top:11px}
  .fl-h{font-size:10.5px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.04em}
  .fl-sec ul{margin:7px 0 0;padding-left:18px} .fl-sec li{font-size:12px;line-height:1.55;margin:3px 0;font-variant-numeric:tabular-nums}
  .fl-foot{font-size:10.5px;color:var(--muted);margin-top:12px;line-height:1.5}
  .fl-accruing{opacity:.85}
  .fl-accruing-msg{font-size:12.5px;color:var(--muted);line-height:1.5;margin-top:8px}

  /* ============================ RAW-STRUCTURE SHELF ============================ */
  .shelf{margin:0 0 14px}
  .shelf-cap{font-size:10.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin:4px 2px 10px}
  .shelf details{border:1px solid var(--line);border-radius:14px;margin-bottom:10px;background:var(--panel)}
  .shelf summary{list-style:none;cursor:pointer;padding:14px 20px;display:flex;align-items:center;gap:12px;font-size:13.5px;font-weight:700}
  .shelf summary::-webkit-details-marker{display:none}
  .shelf summary:hover{background:color-mix(in srgb,var(--info) 5%,var(--panel));border-radius:14px}
  .shelf summary .sh-ic{flex:none;width:28px;height:28px;border-radius:9px;display:flex;align-items:center;justify-content:center;
    font-size:14px;background:var(--panel2)}
  .shelf summary .sh-hint{margin-left:auto;font-size:11px;font-weight:600;color:var(--muted);white-space:nowrap}
  .shelf summary .sh-caret{flex:none;font-size:11px;color:var(--muted);transition:transform .25s}
  .shelf details[open] summary .sh-caret{transform:rotate(90deg)}
  .shelf .sh-body{padding:8px 20px 20px;border-top:1px solid var(--line)}
  .sh-grid2{display:grid;grid-template-columns:1fr;gap:18px} @media(min-width:820px){.sh-grid2{grid-template-columns:1fr 1fr}}
  .sh-sub{font-size:12px;color:var(--muted);line-height:1.5;margin:0 0 10px}
  .chartbox{width:100%} .chartbox svg{width:100%;height:auto;display:block;overflow:visible}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11.5px;color:var(--muted);margin-top:6px}
  .legend i{display:inline-block;width:11px;height:11px;border-radius:3px;vertical-align:-1px;margin-right:5px}
  .hm-tabs{display:flex;gap:6px;margin:10px 0 4px}
  .hm-tab{font-size:12px;padding:5px 12px;border:1px solid var(--line);background:var(--panel2);color:var(--muted);border-radius:8px;cursor:pointer}
  .hm-tab.on{color:var(--text);border-color:var(--muted);background:var(--panel)}
  .hm-scroll{overflow-x:auto}
  .heat{border-collapse:separate;border-spacing:2px;font-size:11.5px;width:100%;min-width:680px;table-layout:fixed}
  .heat th{color:var(--muted);font-weight:500;padding:3px 4px;white-space:nowrap}
  .heat thead th:first-child{width:56px} .heat th.col{font-size:10.5px}
  .heat td.kk{width:56px;color:var(--muted);text-align:right;padding-right:8px;font-variant-numeric:tabular-nums;white-space:nowrap}
  .heat td.cell{height:30px;text-align:center;border-radius:5px;color:var(--text);font-variant-numeric:tabular-nums}
  .heat td.cell.spotrow{box-shadow:inset 0 0 0 1px var(--text)}
  .heat td.cell:hover{outline:2px solid var(--text);outline-offset:-2px}
  .hm-legend{display:flex;gap:14px;align-items:center;margin-top:8px;font-size:11px;color:var(--muted);flex-wrap:wrap}
  .hm-legend .sw{display:inline-block;width:34px;height:11px;border-radius:3px;vertical-align:middle;margin-right:5px}
  .term{width:100%;border-collapse:collapse;font-size:12.5px}
  .term th{color:var(--muted);font-weight:600;text-align:right;padding:6px 9px;border-bottom:1px solid var(--line);text-transform:uppercase;font-size:10px;letter-spacing:.03em}
  .term th:first-child,.term td:first-child{text-align:left}
  .term td{padding:6px 9px;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums}
  .term tr:last-child td{border-bottom:none}
  .greeks{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-top:4px}
  .greek{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:9px 12px}
  .greek .k{font-size:11px;color:var(--muted)} .greek .v{font-size:15px;font-weight:700;margin-top:2px;font-variant-numeric:tabular-nums}

  /* ============================ BOARD ============================ */
  .gx-board-cta{display:flex;flex-direction:column;align-items:center;gap:4px;width:100%;max-width:560px;margin:8px auto;padding:18px 28px;
    border:1px dashed var(--line);border-radius:16px;background:var(--panel);color:var(--text);cursor:pointer;text-align:center;font:inherit;
    transition:transform .16s,border-color .16s,box-shadow .2s}
  .gx-board-cta:hover{transform:translateY(-2px);border-color:var(--info);border-style:solid;
    box-shadow:0 14px 34px -16px color-mix(in srgb,var(--info) 55%,transparent)}
  .gx-board-cta .big{font-size:15px;font-weight:800}
  .gx-board-cta .sub{font-size:12px;color:var(--muted)}
  #gx-boardwrap{position:relative;margin:20px 0 8px}
  #gx-boardwrap.collapsed #gx-board-inner{display:none}
  #gx-boardwrap:not(.collapsed) #gx-board-expand{display:none}
  #gx-board-inner{position:relative;border:1px solid var(--line);border-radius:16px;background:var(--panel);padding:22px 18px;animation:gxUp .3s ease}
  .board-collapse{position:absolute;left:50%;transform:translateX(-50%);z-index:4;padding:6px 18px;border-radius:999px;
    border:1px solid var(--line);background:var(--panel);color:var(--muted);font:inherit;font-size:12px;font-weight:700;cursor:pointer;white-space:nowrap;
    box-shadow:var(--popover-shadow);transition:color .15s,border-color .15s}
  .board-collapse:hover{color:var(--text);border-color:var(--info)}
  .board-collapse.top{top:-14px} .board-collapse.bottom{bottom:-14px}
  .board-head{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:baseline;justify-content:space-between;margin-bottom:12px}
  .chips{display:flex;flex-wrap:wrap;gap:6px}
  .chip{padding:5px 12px;font-size:12px;border:1px solid var(--line);background:var(--panel2);color:var(--muted);border-radius:999px;cursor:pointer;white-space:nowrap}
  .chip.on{color:var(--text);border-color:var(--muted);background:var(--panel)}
  .board{width:100%;border-collapse:collapse;font-size:12.5px}
  .board th{text-align:right;color:var(--muted);font-weight:600;padding:7px 9px;border-bottom:1px solid var(--line);cursor:pointer;white-space:nowrap;
    text-transform:uppercase;font-size:10px;letter-spacing:.03em}
  .board th:first-child,.board td:first-child{text-align:left}
  .board td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums}
  .board tr.sym{cursor:pointer} .board tr.sym:hover td{background:var(--panel2)}
  .board tr.sym.sel td{background:color-mix(in srgb,var(--info) 8%,var(--panel2))}
  .board tr.sym.thin td{opacity:.6}
  .board tr.ghead td{color:var(--muted);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;padding-top:16px;border-bottom:none;font-weight:700}
  .board tr.ghead td .cov{text-transform:none;letter-spacing:0;color:var(--muted);font-weight:500;margin-left:8px}
  .reg{font-size:11px;font-weight:700;padding:2px 9px;border-radius:7px;border:1px solid var(--line);white-space:nowrap}
  .reg-long{color:var(--up);border-color:color-mix(in srgb,var(--up) 45%,var(--line))}
  .reg-short{color:var(--down);border-color:color-mix(in srgb,var(--down) 45%,var(--line))}
  .reg-na{color:var(--muted)}
  .board .symk{font-weight:700} .board .symn{color:var(--muted);font-size:11px;margin-left:5px}
  .board .thinmk{color:var(--orange);margin-left:5px;cursor:help}
  .bhelp{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;border:1px solid var(--muted);
    color:var(--muted);font-size:9px;font-weight:700;cursor:help;margin-left:5px;vertical-align:middle}
  .bhelp:hover,.bhelp:focus{color:var(--text);border-color:var(--text);outline:none}

  /* ---- floating tooltip (charts) ---- */
  .floaty-tip{position:fixed;pointer-events:none;z-index:90;background:var(--panel);border:1px solid var(--line);border-radius:8px;
    padding:7px 10px;font-size:11.5px;box-shadow:var(--popover-shadow);display:none;white-space:nowrap}

  /* ============================ MOTION ============================ */
  @keyframes gxUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @keyframes gxBreathe{0%,100%{opacity:.45;transform:scale(.85)}50%{opacity:1;transform:scale(1.1)}}
  @keyframes gxHalo{0%,100%{opacity:.09}50%{opacity:.2}}
  @keyframes gxDash{to{stroke-dashoffset:-18}}
  .lad-halo{animation:gxHalo 3.2s ease-in-out infinite}
  .lad-flip{animation:gxDash 2.8s linear infinite}
  @media (prefers-reduced-motion:reduce){
    .anim,#gx-board-inner{animation:none}
    .stance .bd,.hasof .bd,.lad-halo,.lad-flip{animation:none!important}
    *{transition:none!important}
  }
</style>
</head>
<body class="page-gex">

{% include "_site_nav.html.j2" %}

{# OEU M-CMD — this per-name workbench is now Ticker mode of the Options workspace. #}
{% set oew_mode = 'ticker' %}{% include "_options_workspace_banner.html.j2" %}

<div class="wrap">

  <!-- ===================== PAGE HEADER ===================== -->
  <header class="pg">
    <h1>🧲 {{ t('Options Desk', '期权台') }}</h1>
    <p class="pg-sub">{{ t("Where option dealers' hedging pins the price — and where it lets moves run. Look up any name below.", "期权做市商的对冲在哪里钉住价格、又在哪里放任波动。可在下方查询任意标的。") }}
      {{ help('Built from daily, delayed Cboe option chains — NOT live intraday flow. This is a volatility-regime and levels map (where dealer hedging concentrates), not a buy list and not a direction call. The dealer long-call/short-put sign is an assumption: solid for indices and big ETFs, shaky for single stocks. Walls, flip and max-pain are levels to watch, never price targets; every trigger on this page means a full daily CLOSE beyond a level.',
      '基于每日、延迟的 Cboe 期权链 — 并非实时盘中流动。这是波动率体制 + 价位地图（做市商对冲集中之处），并非买入清单、也非方向判断。做市商"多头看涨/空头看跌"符号是一种假设：对指数与大型ETF稳健，对个股不稳。墙/翻转/最大痛点仅供观察、绝非目标价；本页所有触发均指日线收盘越过某价位。') }}
    </p>
  </header>

  <!-- ===================== MARKET WEATHER (whole market; engine/vol_regime) ===================== -->
  <section class="wx card" id="gx-weather" hidden>
    <div class="cardhead">
      <span class="kick">🌦️ {{ t('Market weather — the whole market, not one name', '市场天气 — 整体市场，非单一标的') }}</span>
      {{ help('The one read on this page that is VALIDATED, not just displayed: a composite of the VIX/VIX3M term-structure slope, bond volatility (MOVE) and the vol-risk premium, built on 1990+ history. It predicts forward realized volatility and, used as a sizing overlay, improves risk-adjusted returns in backtests. No dealer-sign assumption. It drives a subtract-only sizing nudge — a market-wide regime read, never an intraday timer.',
      '本页唯一经过验证（而非仅展示）的读数：VIX/VIX3M 期限结构斜率 + 债券波动率(MOVE) + 波动风险溢价的综合，基于1990年以来历史。可预测前瞻已实现波动率，作为仓位叠加层在回测中改善风险调整后收益。无做市商符号假设。它只做减法的仓位微调 — 市场整体体制读数，绝非盘中择时。') }}
      <span class="wx-scored" id="wx-scored" hidden>✓ {{ t('validated', '已验证') }}</span>
    </div>
    <div id="gx-weather-body"></div>
  </section>

  <!-- ===================== PRIMER ===================== -->
  <details class="primer">
    <summary><span class="ic">📘</span>{{ t('New to options? Read this first.', '不熟悉期权？先读这里。') }}<span class="caret">▸</span></summary>
    <div class="body">
      <p>{{ t("This page maps where big options dealers are likely to push or cushion the price. It's a map of levels — not a buy/sell signal, not a price target.", "本页标示大型期权做市商可能推动或缓冲价格之处。这是价位地图 — 并非买卖信号、也非目标价。") }}</p>
      <ul>
        <li>{{ t("<b>Dealers</b> are the banks that sell most options. To stay neutral they constantly buy and sell the stock against what they've sold — and that hedging quietly pushes the price around.", "<b>做市商</b>是卖出大部分期权的银行。为保持中性，它们不断反向买卖股票 — 这种对冲会悄悄推动价格。")|safe }}</li>
        <li>{{ t("Sometimes their hedging <b>calms</b> the market, sometimes it makes it <b>jumpy</b>. Leaning against moves keeps price in a range; piling into moves makes trends and air-pockets bigger. It's about how volatile — not which direction.", "对冲有时让市场<b>平静</b>、有时让市场<b>跳动</b>。逆势对冲使价格停在区间；顺势对冲使趋势与急跌更大。这关乎波动多大 — 而非方向。")|safe }}</li>
        <li>{{ t("<b>Walls</b> are the prices where that hedging is heaviest — a call wall above acts like a ceiling, a put wall below like a floor. Each is scored Strong → Faint. Price tends to stall there; it doesn't aim there.", "<b>墙</b>是对冲最重的价位 — 上方看涨墙像天花板，下方看跌墙像地板。每面墙有强弱评分。价格倾向在此停滞，而非以此为目标。")|safe }}</li>
        <li>{{ t("<b>The flip</b> is the line between the calm and jumpy regimes — watch it like a thermostat, not like support/resistance.", "<b>翻转</b>是平静与跳动体制的分界 — 像恒温器一样观察它，而非支撑/阻力。")|safe }}</li>
        <li>{{ t("How to use it: pick a name, read the one-line verdict, look at the ladder, then watch the <b>daily-close</b> triggers. The math is solid for indices and big ETFs, loose for single stocks.", "用法：选一个标的，读一行结论，看价位图，再关注<b>日线收盘</b>触发。对指数与大型ETF稳健，对个股宽松。")|safe }}</li>
      </ul>
    </div>
  </details>

  <!-- ===================== TICKER WORKSPACE (toolbar + detail, fused) ===================== -->
  <section class="ws" id="gx-ws">
    <div class="ws-bar">
      <div class="ws-search">
        <span class="mag">🔎</span>
        <input id="gx-q" type="text" autocomplete="off" aria-label="Look up a ticker"
          placeholder="Look up a ticker — SPY, NVDA, TSLA…" data-ph-zh="查询代码 — SPY、NVDA、TSLA…">
        <div class="gx-sugg" id="gx-sugg"></div>
      </div>
      <div class="ws-quick" id="gx-quick"></div>
      <span class="ws-hint">{{ t('press / to search · full board below ↓', '按 / 搜索 · 完整看板见下方 ↓') }}</span>
    </div>
    <div id="gx-detail"><div class="card gx-loading">{{ t('Loading…', '加载中…') }}</div></div>
  </section>

  <!-- ===================== BOARD (every name) ===================== -->
  <section id="gx-boardwrap" class="collapsed">
    <button id="gx-board-expand" class="gx-board-cta" type="button">
      <span class="big">📋 {{ t('Open the full board', '打开完整看板') }}</span>
      <span class="sub" id="gx-board-cta-sub">{{ t('every name at a glance · sortable · scored', '所有标的一览 · 可排序 · 已评分') }}</span>
    </button>
    <div id="gx-board-inner">
      <button class="board-collapse top" type="button" data-act="collapse">▴ {{ t('Hide board', '收起看板') }}</button>
      <div class="board-head">
        <h2 style="font-size:14px">{{ t('Board — every name at a glance', '总览 — 所有标的一览') }} {{ help('Each column has its own ❓ — hover for a plain-English explanation. Click a header to sort, or a row for the full breakdown. Greyed rows (◐) have chains too thin to trust the dealer sign.', '每列都有自己的 ❓ — 悬停查看通俗解释。点击表头排序，或点击任意行查看完整分解。灰色行（◐）期权链过薄，方向不可靠。') }}</h2>
        <span id="gx-coverage" class="muted sm"></span>
      </div>
      <div class="chips" id="gx-chips">
        <span class="chip on" data-grp="__all">{{ t('All', '全部') }}</span>
        {% for g in groups %}<span class="chip" data-grp="{{ g }}">{{ td(g) }}</span>{% endfor %}
      </div>
      <div class="hm-scroll" id="gx-board-scroll" style="margin-top:12px">
        <table class="board" id="gx-board">
          <thead><tr>
            <th data-sort="key">{{ t('Symbol', '代码') }}</th>
            <th data-sort="spot">{{ t('Spot', '现价') }}</th>
            <th data-sort="regime">{{ t('Regime', '体制') }}<span class="bhelp" data-h="regime" tabindex="0" role="button" aria-label="What is Regime?">?</span></th>
            <th data-sort="vh_state">{{ t('Vol hole', '波动洞') }}<span class="bhelp" data-h="volhole" tabindex="0" role="button" aria-label="What is Vol hole?">?</span></th>
            <th data-sort="tilt_read">{{ t('Lean', '倾向') }}<span class="bhelp" data-h="lean" tabindex="0" role="button" aria-label="What is Lean?">?</span></th>
            <th data-sort="net_gex_bn">{{ t('Net GEX', '净GEX') }}<span class="bhelp" data-h="netgex" tabindex="0" role="button" aria-label="What is Net GEX?">?</span></th>
            <th data-sort="dist_to_flip_pct">{{ t('Flip', '翻转') }}<span class="bhelp" data-h="flip" tabindex="0" role="button" aria-label="What is Flip?">?</span></th>
            <th data-sort="iv30">IV30<span class="bhelp" data-h="iv30" tabindex="0" role="button" aria-label="What is IV30?">?</span></th>
            <th data-sort="iv_rank_band">IVR<span class="bhelp" data-h="ivr" tabindex="0" role="button" aria-label="What is IV rank?">?</span></th>
            <th data-sort="daily_move_pct">{{ t('Exp. move', '预期波动') }}<span class="bhelp" data-h="expmove" tabindex="0" role="button" aria-label="What is Expected move?">?</span></th>
            <th data-sort="put_call_oi_ratio">P/C<span class="bhelp" data-h="pc" tabindex="0" role="button" aria-label="What is Put/Call?">?</span></th>
          </tr></thead>
          <tbody><!-- filled by gex.js --></tbody>
        </table>
      </div>
      <button class="board-collapse bottom" type="button" data-act="collapse">▴ {{ t('Hide board', '收起看板') }}</button>
    </div>
  </section>

  <!-- ===================== SOURCE FOOTER ===================== -->
  <p class="muted xs" style="margin:26px 0 0;padding-top:16px;border-top:1px solid var(--line);line-height:1.55">{{ t(
    'Source: Cboe delayed option chains (free, keyless) → engine/gex_model.py + engine/gex_engine.py. Greeks dividend-adjusted; the gamma-flip & profile curve are grid-reevaluated across spot. Level strength, 25Δ skew, IV-rank & the timeframed tilt are transparent display-only derivations — never scored signals. Daily EOD levels, delayed — OI updates once per day, this is NOT live intraday flow and misses 0DTE. See LIMITATIONS.md.',
    '来源：Cboe 延迟期权链（免费、无需密钥）→ engine/gex_model.py + engine/gex_engine.py。希腊字母经股息调整；Gamma翻转与曲线在现价网格上重估。墙强度、25Δ偏斜、IV分位与带时间窗的倾向均为透明的仅供展示推导 — 绝非评分信号。每日延迟价位 — OI每日更新一次，并非实时盘中流动、且不含0DTE。') }}
    {{ t('Generated', '生成于') }} {{ built }}</p>
</div>

<div class="floaty-tip" id="gx-tip"></div>
<div class="help-pop" id="gx-htip"></div>
<script>window.GEX_MANIFEST = {{ manifest_json|safe }}; window.GEX_DEFAULT = "{{ default_key }}"; window.GEX_COVERAGE = {{ coverage_json|safe }};</script>
<script src="gex.js?v={{ built|replace(' ','')|replace(':','')|replace('UTC','') }}"></script>
<script src="theme.js"></script>
<script defer src="illus.js"></script>
</body>
</html>
