{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro card(lbl, zh, val, sub='') -%}
<div class="gcard"><div class="muted" style="font-size:12px">{{ t(lbl, zh) }}</div><div class="gval">{{ val }}</div>{% if sub %}<div class="muted sm">{{ sub }}</div>{% endif %}</div>
{%- endmacro %}
