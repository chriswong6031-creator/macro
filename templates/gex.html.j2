{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Options Desk — GEX, walls & vol surface · 期权台</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(40px,calc((100vw - 1360px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; font-weight:600; letter-spacing:.2px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:14px; }
  .muted { color:var(--muted); } .sm { font-size:12px; } .xs { font-size:11px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .topline { display:flex; flex-wrap:wrap; align-items:baseline; gap:10px 14px; }
  .note { margin:8px 0 0; line-height:1.5; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:280px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:none; }
  .help:hover .tip { display:block; }

  /* ---- symbol picker ---- */
  .pickbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
  .gx-search { position:relative; flex:1 1 280px; max-width:420px; }
  .gx-search input { width:100%; padding:9px 12px 9px 34px; border:1px solid var(--line); border-radius:9px; background:var(--panel2); color:var(--text); font:inherit; font-size:14px; }
  .gx-search .mag { position:absolute; left:11px; top:50%; transform:translateY(-50%); opacity:.6; }
  .gx-sugg { position:absolute; top:108%; left:0; right:0; background:var(--panel); border:1px solid var(--line); border-radius:9px; box-shadow:var(--popover-shadow); z-index:50; max-height:320px; overflow:auto; display:none; }
  .gx-sugg.on { display:block; }
  .gx-sugg .row { display:flex; justify-content:space-between; gap:8px; padding:7px 11px; cursor:pointer; }
  .gx-sugg .row:hover, .gx-sugg .row.hl { background:var(--panel2); }
  .gx-sugg .row b { font-weight:600; } .gx-sugg .row .g { color:var(--muted); font-size:11px; }
  .chips { display:flex; flex-wrap:wrap; gap:6px; }
  .chip { padding:5px 11px; font-size:12px; border:1px solid var(--line); background:var(--panel2); color:var(--muted); border-radius:20px; cursor:pointer; white-space:nowrap; }
  .chip.on { color:var(--text); border-color:var(--muted); background:var(--panel); }

  /* ---- board ---- */
  .boardwrap { margin-top:12px; }
  .board { width:100%; border-collapse:collapse; font-size:12.5px; }
  .board th { text-align:right; color:var(--muted); font-weight:500; padding:6px 9px; border-bottom:1px solid var(--line); cursor:pointer; white-space:nowrap; }
  .board th:first-child, .board td:first-child { text-align:left; }
  .board td { padding:6px 9px; border-bottom:1px solid var(--line); text-align:right; font-variant-numeric:tabular-nums; }
  .board tr.sym { cursor:pointer; } .board tr.sym:hover td { background:var(--panel2); }
  .board tr.sym.sel td { background:var(--panel2); }
  .board tr.ghead td { color:var(--muted); font-size:11px; letter-spacing:.4px; text-transform:uppercase; padding-top:12px; border-bottom:none; }
  .reg { font-size:11px; font-weight:600; padding:2px 8px; border-radius:6px; border:1px solid var(--line); white-space:nowrap; }
  .reg-long { color:var(--up); border-color:var(--up); } .reg-short { color:var(--down); border-color:var(--down); } .reg-na { color:var(--muted); }
  .board .symk { font-weight:600; } .board .symn { color:var(--muted); font-size:11px; margin-left:5px; }
  .collapse-btn { background:none; border:none; color:var(--link); cursor:pointer; font:inherit; font-size:12px; padding:0; }

  /* ---- detail ---- */
  #gx-detail { min-height:120px; }
  .hero { display:flex; flex-wrap:wrap; align-items:center; gap:8px 20px; }
  .hero .sym { font-size:24px; font-weight:700; } .hero .nm { color:var(--muted); font-size:13px; }
  .regbadge { font-size:13px; font-weight:600; padding:5px 13px; border-radius:9px; border:1px solid var(--line); }
  .heronum { font-size:13px; } .heronum b { font-size:16px; } .heronum.big b { font-size:19px; }
  .grid2 { display:grid; grid-template-columns:1fr; gap:14px; } @media(min-width:900px){ .grid2 { grid-template-columns:1fr 1fr; } }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:10px; }
  .gcard { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:9px 11px; }
  .gcard .k { font-size:11.5px; color:var(--muted); } .gcard .v { font-size:17px; font-weight:600; margin-top:2px; }

  /* the plain-English read (legacy) */
  .gx-read { background:var(--panel2); border:1px solid var(--line); border-left:3px solid var(--info); border-radius:9px; padding:11px 14px; margin-top:12px; font-size:13.5px; line-height:1.6; }
  .gx-read b { font-weight:700; }

  /* ---- "New to options?" primer ---- */
  .primer { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:0 16px; margin-bottom:14px; }
  .primer summary { cursor:pointer; padding:13px 0; font-weight:600; font-size:13.5px; list-style:none; }
  .primer summary::-webkit-details-marker { display:none; }
  .primer summary::before { content:"📘  "; }
  .primer[open] summary { border-bottom:1px solid var(--line); }
  .primer-intro { margin:13px 0 4px; font-weight:600; line-height:1.55; }
  .primer ul { margin:6px 0 16px; padding-left:20px; }
  .primer li { margin:8px 0; font-size:13px; line-height:1.6; }

  /* ---- board-column "?" help + its wrapping floating popover ---- */
  .bhelp { display:inline-flex; align-items:center; justify-content:center; width:14px; height:14px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:9px; font-weight:600; cursor:help; margin-left:5px; vertical-align:middle; }
  .bhelp:hover, .bhelp:focus { color:var(--text); border-color:var(--text); outline:none; }
  .help-pop { position:fixed; z-index:95; max-width:300px; background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:9px 11px; font-size:12px; line-height:1.5; color:var(--text); box-shadow:var(--popover-shadow); display:none; }
  .help-pop b { font-weight:700; }

  /* ---- the Game Plan card (beginner signal read) ---- */
  .gx-gameplan { background:var(--panel2); border:1px solid var(--line); border-left:3px solid var(--info); border-radius:10px; padding:12px 15px; margin-top:12px; }
  .gx-gameplan.gp-calm, .gx-gameplan.gp-up { border-left-color:var(--up); }
  .gx-gameplan.gp-jumpy { border-left-color:var(--down); }
  .gx-gameplan.gp-warn { border-left-color:var(--orange); }
  .gx-gameplan.gp-neutral { border-left-color:var(--info); }
  .gp-head { display:flex; align-items:center; gap:9px; }
  .gp-icon { font-size:20px; line-height:1; }
  .gp-verdict { font-size:17px; font-weight:700; letter-spacing:.2px; }
  .gp-calm .gp-verdict, .gp-up .gp-verdict { color:var(--up); }
  .gp-jumpy .gp-verdict { color:var(--down); }
  .gp-warn .gp-verdict { color:var(--orange); }
  .gp-sub { font-size:13.5px; line-height:1.55; margin-top:6px; }
  .gp-levels { margin-top:11px; border-top:1px solid var(--line); padding-top:10px; display:flex; flex-direction:column; gap:9px; }
  .gp-weak { font-size:12px; color:var(--muted); font-style:italic; }
  .gp-lvl { display:grid; grid-template-columns:max-content 1fr; gap:3px 16px; align-items:baseline; }
  @media (max-width:640px){ .gp-lvl { grid-template-columns:1fr; gap:2px; } }
  .gp-lk { font-size:13px; white-space:nowrap; }
  .gp-li { margin-right:5px; }
  .gp-ll { color:var(--muted); }
  .gp-lv { font-size:14.5px; font-weight:700; margin-left:3px; }
  .gp-lt { font-size:12.5px; color:var(--muted); line-height:1.5; }
  .gp-range { margin-top:11px; border-top:1px solid var(--line); padding-top:10px; }
  .gp-rk { font-size:12.5px; color:var(--muted); }
  .gp-rv { font-size:15px; margin-top:2px; }
  .gp-rc { margin-top:3px; }
  .gp-chip { margin-top:11px; font-size:12px; line-height:1.5; border:1px solid var(--orange); border-radius:8px; padding:8px 11px; }

  /* ---- volatility hole ---- */
  .vhole { border-left:3px solid var(--info); }
  .vhole.vh-up { border-left-color:var(--up); } .vhole.vh-down { border-left-color:var(--down); }
  .vhole.vh-neutral { border-left-color:var(--info); } .vhole.vh-volatile { border-left-color:var(--orange); }
  .vh-badge { font-size:12.5px; font-weight:600; padding:4px 12px; border-radius:8px; border:1px solid var(--line); white-space:nowrap; }
  .vh-badge.up { color:var(--up); border-color:var(--up); } .vh-badge.down { color:var(--down); border-color:var(--down); }
  .vh-badge.neu { color:var(--info); border-color:var(--info); } .vh-badge.vol { color:var(--orange); border-color:var(--orange); }
  .vh-badge.na { color:var(--muted); }
  .vh-read { font-size:13.5px; line-height:1.62; margin-top:10px; } .vh-read b { font-weight:700; }
  .vh-band { position:relative; height:52px; margin:16px 8px 8px; }
  .vh-band .track { position:absolute; left:0; right:0; top:23px; height:8px; border-radius:5px; background:var(--panel2); border:1px solid var(--line); }
  .vh-band .fill { position:absolute; top:0; bottom:0; border-radius:5px; opacity:.5; }
  .vh-band .mk { position:absolute; top:14px; width:2px; height:26px; transform:translateX(-50%); }
  .vh-band .mk.lo { background:var(--down); } .vh-band .mk.hi { background:var(--up); }
  .vh-band .mk.spot { background:var(--text); top:8px; height:38px; width:2px; }
  .vh-band .cap { position:absolute; font-size:10.5px; color:var(--muted); top:33px; transform:translateX(-50%); white-space:nowrap; text-align:center; }
  .vh-band .cap.spot { top:-4px; color:var(--text); font-weight:600; }
  .vh-band .cap .v { display:block; font-weight:600; color:var(--text); font-size:11px; }
  .vh-stats { display:flex; flex-wrap:wrap; gap:6px 18px; font-size:12px; color:var(--muted); margin-top:8px; }
  .vh-stats b { color:var(--text); font-weight:600; }
  .vh-pill { font-size:10.5px; font-weight:600; padding:1px 7px; border-radius:6px; border:1px solid var(--line); white-space:nowrap; }
  .vh-pill.up { color:var(--up); border-color:var(--up); } .vh-pill.down { color:var(--down); border-color:var(--down); }
  .vh-pill.neu { color:var(--info); } .vh-pill.vol { color:var(--orange); border-color:var(--orange); } .vh-pill.na { color:var(--muted); }

  /* levels ruler — two label lanes (above / below the axis) to avoid collisions */
  .ruler { position:relative; height:88px; margin:14px 6px 4px; }
  .ruler .axis { position:absolute; left:0; right:0; top:44px; height:2px; background:var(--line); }
  .ruler .mk { position:absolute; top:0; bottom:0; width:0; transform:translateX(-50%); }
  .ruler .mk i { position:absolute; top:38px; left:0; transform:translateX(-50%); width:2px; height:14px; background:var(--muted); }
  .ruler .mk .lbl { position:absolute; left:0; transform:translateX(-50%); text-align:center; white-space:nowrap; }
  .ruler .mk.lane0 .lbl { top:2px; } .ruler .mk.lane1 .lbl { bottom:2px; }
  .ruler .mk .val { display:block; font-size:11.5px; font-weight:600; }
  .ruler .mk .lab { display:block; font-size:10px; color:var(--muted); }
  .ruler .mk.spot i { background:var(--text); height:18px; top:36px; } .ruler .mk.spot .val { color:var(--text); }
  .ruler .mk.cw i { background:var(--up); } .ruler .mk.pw i { background:var(--down); }
  .ruler .mk.flip i { background:var(--info); } .ruler .mk.mp i { background:var(--orange); }

  /* heatmap — fills the panel width on desktop, scrolls on mobile */
  .hm-tabs { display:flex; gap:6px; margin-bottom:8px; }
  .hm-tab { font-size:12px; padding:4px 11px; border:1px solid var(--line); background:var(--panel2); color:var(--muted); border-radius:7px; cursor:pointer; }
  .hm-tab.on { color:var(--text); border-color:var(--muted); background:var(--panel); }
  .hm-scroll { overflow-x:auto; }
  .heat { border-collapse:separate; border-spacing:2px; font-size:11.5px; width:100%; min-width:680px; table-layout:fixed; }
  .heat th { color:var(--muted); font-weight:500; padding:3px 4px; white-space:nowrap; }
  .heat thead th:first-child { width:56px; }
  .heat th.col { font-size:10.5px; }
  .heat td.kk { width:56px; color:var(--muted); text-align:right; padding-right:8px; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .heat td.cell { height:30px; text-align:center; border-radius:5px; color:var(--text); font-variant-numeric:tabular-nums; }
  .heat td.cell.spotrow { box-shadow:inset 0 0 0 1px var(--text); }
  .heat td.cell:hover { outline:2px solid var(--text); outline-offset:-2px; }
  .hm-legend { display:flex; gap:14px; align-items:center; margin-top:8px; font-size:11px; color:var(--muted); flex-wrap:wrap; }
  .hm-legend .sw { display:inline-block; width:34px; height:11px; border-radius:3px; vertical-align:middle; margin-right:5px; }

  /* svg charts */
  .chartbox { width:100%; } .chartbox svg { width:100%; height:auto; display:block; overflow:visible; }
  .legend { display:flex; gap:14px; flex-wrap:wrap; font-size:11.5px; color:var(--muted); margin-top:4px; }
  .legend i { display:inline-block; width:11px; height:11px; border-radius:3px; vertical-align:-1px; margin-right:5px; }

  /* term table */
  .term { width:100%; border-collapse:collapse; font-size:12px; }
  .term th { color:var(--muted); font-weight:500; text-align:right; padding:5px 8px; border-bottom:1px solid var(--line); }
  .term th:first-child, .term td:first-child { text-align:left; }
  .term td { padding:5px 8px; border-bottom:1px solid var(--line); text-align:right; font-variant-numeric:tabular-nums; }

  .floaty-tip { position:fixed; pointer-events:none; z-index:90; background:var(--panel); border:1px solid var(--line); border-radius:7px; padding:6px 9px; font-size:11.5px; box-shadow:var(--popover-shadow); display:none; white-space:nowrap; }
  .gx-loading { color:var(--muted); padding:30px 6px; text-align:center; }
  [data-lang="en"] .l-zh, [data-lang="zh"] .l-en { display:none; }
</style>
</head>
<body>

<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="aibrief.html">🧠 {{ t('AI Daily Brief', 'AI每日简报') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="panel">
  <div class="topline">
    <h1>🧲 {{ t('Options Desk', '期权台') }}</h1>
    <span class="muted sm">{{ t('dealer-gamma levels, the walls, the vol surface & expected move — look up any name', '做市商Gamma价位、墙、波动率曲面与预期波动 — 可查询任意标的') }}</span>
  </div>
  <p class="muted sm note">{{ t(
    "Daily, delayed Cboe chains — NOT live intraday flow. A VOL-REGIME + LEVELS MAP (where dealer hedging concentrates), not a buy list and not directional: long gamma → dealers fade moves (price pins / mean-reverts, lower realized vol); short gamma → dealers chase (moves trend / amplify, higher vol). The dealer long-call/short-put SIGN is an unobservable assumption — robust for indices, FRAGILE for single names (a covered-call ETF or heavy retail call-buying can flip it). Walls / flip / max-pain are levels to watch, never targets.",
    "每日、延迟的 Cboe 期权链 — 并非实时盘中流动。这是波动率体制 + 价位地图（做市商对冲集中之处），并非买入清单、也无方向性：多头Gamma → 做市商抑制走势（价格磁吸/均值回归、已实现波动更低）；空头Gamma → 做市商追逐（走势趋势化/放大、波动更高）。做市商“多头看涨/空头看跌”的符号是不可观测的假设 — 对指数稳健，对个股脆弱（卖备兑ETF或散户大量买看涨可翻转）。墙/翻转/最大痛点仅供观察，绝非目标价。") }}</p>
</div>

<details class="primer">
  <summary>{{ t('New to options? Read this first.', '不熟悉期权？先读这里。') }}</summary>
  <p class="primer-intro">{{ t("This page maps where big options dealers are likely to push or cushion the price. It's a map of levels, not a buy/sell signal and not a price target.", "本页标示大型期权做市商可能推动或缓冲价格之处。这是价位地图，并非买卖信号、也非目标价。") }}</p>
  <ul>
    <li>{{ t("Dealers are the banks that sell most options. To stay market-neutral, they constantly buy and sell the stock to offset what they've sold — and that hedging quietly pushes the price around.", "做市商是卖出大部分期权的银行。为保持市场中性，它们不断买卖股票以对冲卖出的部分 — 这种对冲会悄悄地推动价格。") }}</li>
    <li>{{ t("Sometimes their hedging calms the market, sometimes it makes it jumpy. When dealers lean against moves (sell rallies, buy dips), price tends to stick in a range. When they pile into moves (buy higher, sell lower), trends and air-pockets run bigger. This is about how volatile, not which direction.", "它们的对冲有时让市场平静、有时让市场跳动。当做市商逆势（涨时卖、跌时买），价格倾向停在区间；当它们顺势（追高、杀低），趋势与急跌都会更大。这关乎波动多大，而非方向。") }}</li>
    <li>{{ t("“Walls” are price levels where that hedging is heaviest — a call wall above tends to act like a ceiling, a put wall below like a floor. They're where price tends to stall, not targets it aims for.", "“墙”是对冲最重的价位 — 上方看涨墙像天花板，下方看跌墙像地板。价格倾向在此停滞，而非以其为目标。") }}</li>
    <li>{{ t("“The flip” is the line between calm and jumpy. Above it the market is usually calmer; below it, jumpier. It's a regime boundary you watch like a thermostat — not a support or resistance level.", "“翻转”是平静与跳动的分界。其上市场通常更平静，其下更跳动。它是像恒温器一样观察的体制边界 — 而非支撑或阻力位。") }}</li>
    <li>{{ t("How to use it: pick a ticker, read the one-line Game Plan, then watch the walls and the flip as the levels that matter today. Every trigger is a daily closing price beyond a level, since the data is end-of-day.", "用法：选一个代码，读一行“行动计划”，再把墙与翻转作为今日关键价位观察。由于数据为收盘，每个触发都是日线收盘越过某价位。") }}</li>
    <li>{{ t("The dealer math is an assumption — solid for big indices and ETFs (SPX, SPY, QQQ), but shaky and sometimes flat wrong for single stocks. Treat single-name levels as loose context.", "做市商的推算是一种假设 — 对大型指数与ETF（SPX、SPY、QQQ）稳健，但对个股不稳、有时完全错误。个股价位仅作宽松背景。") }}</li>
  </ul>
</details>

<div class="panel">
  <div class="pickbar">
    <div class="gx-search">
      <span class="mag">🔎</span>
      <input id="gx-q" type="text" autocomplete="off" placeholder="Look up a ticker — SPY, NVDA, TSLA…" data-ph-zh="查询代码 — SPY、NVDA、TSLA…">
      <div class="gx-sugg" id="gx-sugg"></div>
    </div>
    <div class="chips" id="gx-chips">
      <span class="chip on" data-grp="__all">{{ t('All', '全部') }}</span>
      {% for g in groups %}<span class="chip" data-grp="{{ g }}">{{ td(g) }}</span>{% endfor %}
    </div>
  </div>
  <div class="boardwrap">
    <div class="topline" style="justify-content:space-between">
      <h2 style="margin:0">{{ t('Board — every name at a glance', '总览 — 所有标的一览') }} {{ help('Each column has its own ❓ — hover it for a plain-English explanation. Click a header to sort, or click any row for the full breakdown.', '每列都有自己的 ❓ — 悬停查看通俗解释。点击表头排序，或点击任意行查看完整分解。') }}</h2>
      <button class="collapse-btn" id="gx-board-toggle">{{ t('hide', '隐藏') }}</button>
    </div>
    <div class="hm-scroll" id="gx-board-scroll">
      <table class="board" id="gx-board">
        <thead><tr>
          <th data-sort="key">{{ t('Symbol', '代码') }}</th>
          <th data-sort="spot">{{ t('Spot', '现价') }}</th>
          <th data-sort="regime">{{ t('Regime', '体制') }}<span class="bhelp" data-h="regime" tabindex="0" role="button" aria-label="What is Regime?">?</span></th>
          <th data-sort="vh_state">{{ t('Vol hole', '波动洞') }}<span class="bhelp" data-h="volhole" tabindex="0" role="button" aria-label="What is Vol hole?">?</span></th>
          <th data-sort="net_gex_bn">{{ t('Net GEX', '净GEX') }}<span class="bhelp" data-h="netgex" tabindex="0" role="button" aria-label="What is Net GEX?">?</span></th>
          <th data-sort="dist_to_flip_pct">{{ t('Flip', '翻转') }}<span class="bhelp" data-h="flip" tabindex="0" role="button" aria-label="What is Flip?">?</span></th>
          <th data-sort="iv30">IV30<span class="bhelp" data-h="iv30" tabindex="0" role="button" aria-label="What is IV30?">?</span></th>
          <th data-sort="daily_move_pct">{{ t('Exp. move', '预期波动') }}<span class="bhelp" data-h="expmove" tabindex="0" role="button" aria-label="What is Expected move?">?</span></th>
          <th data-sort="put_call_oi_ratio">P/C<span class="bhelp" data-h="pc" tabindex="0" role="button" aria-label="What is Put/Call?">?</span></th>
        </tr></thead>
        <tbody><!-- filled by gex.js --></tbody>
      </table>
    </div>
  </div>
</div>

<div id="gx-detail"><div class="gx-loading">{{ t('Loading…', '加载中…') }}</div></div>

<div class="panel">
  <p class="muted xs" style="margin:0">{{ t(
    'Source: Cboe delayed option chains (free, keyless) → engine/gex_model.py + engine/gex_engine.py. Greeks dividend-adjusted; the gamma-flip & profile curve are grid-reevaluated across spot. Daily EOD levels, delayed — OI updates once per day, this is NOT live intraday flow. A regime + levels map, display-only, never a scored signal. See LIMITATIONS.md.',
    '来源：Cboe 延迟期权链（免费、无需密钥）→ engine/gex_model.py + engine/gex_engine.py。希腊字母经股息调整；Gamma翻转与曲线在现价网格上重估。每日延迟价位 — OI每日更新一次，并非实时盘中流动。体制+价位地图，仅供展示，绝非评分信号。') }}
    {{ t('Generated', '生成于') }} {{ built }}</p>
</div>

<div class="floaty-tip" id="gx-tip"></div>
<div class="help-pop" id="gx-htip"></div>
<script>window.GEX_MANIFEST = {{ manifest_json|safe }}; window.GEX_DEFAULT = "{{ default_key }}";</script>
<script src="gex.js"></script>
<script src="theme.js"></script>
</body>
</html>
