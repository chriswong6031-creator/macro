<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1320px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); } .sm { font-size:12px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .note { margin:8px 0 0; line-height:1.5; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:280px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:none; }
  .help:hover .tip { display:block; }
  .tabs { display:flex; gap:6px; flex-wrap:wrap; margin:0 0 14px; }
  .tabbtn { padding:7px 14px; font:inherit; font-size:13px; border:1px solid var(--line); background:var(--panel); color:var(--muted); border-radius:8px; cursor:pointer; }
  .tabbtn.on { background:var(--panel2); color:var(--text); border-color:var(--muted); }
  .hero { display:flex; flex-wrap:wrap; align-items:center; gap:18px; margin-bottom:14px; }
  .regbadge { font-size:13px; font-weight:600; padding:5px 12px; border-radius:8px; border:1px solid var(--line); }
  .reg-long { color:var(--up); border-color:var(--up); }
  .reg-short { color:var(--down); border-color:var(--down); }
  .reg-na { color:var(--muted); }
  .heronum b { font-size:16px; } .heronum { font-size:13px; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:10px; margin-bottom:14px; }
  .gcard { background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:9px 11px; }
  .gval { font-size:17px; font-weight:600; margin-top:2px; }
  .lad { font-size:12px; }
  .lad-row { display:grid; grid-template-columns:62px 1fr 64px; align-items:center; gap:8px; padding:2px 4px; border-radius:4px; }
  .lad-row.mag { background:var(--panel2); }
  .lad-k { text-align:right; font-variant-numeric:tabular-nums; } .lad-k b { color:var(--text); }
  .lad-bar { position:relative; height:11px; border-radius:5px; background:var(--panel2); overflow:hidden; }
  .lad-bar > i { position:absolute; top:0; bottom:0; } .lad-bar > i.mid { left:50%; width:1px; background:var(--muted); opacity:.5; }
  .lad-v { text-align:right; font-variant-numeric:tabular-nums; }
  .magtag { font-size:10px; padding:0 6px; border-radius:6px; border:1px solid var(--line); color:var(--muted); margin-left:6px; }
</style>
</head>
