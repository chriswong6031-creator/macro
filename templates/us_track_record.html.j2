{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro td(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{#
  US Track Record — Prophet W1 depth page.
  Spec: research/PROPHET_MASTERPLAN_BY_FABLE.md §PR-R9.
  Data: site/factordata/us_track_history.json (builder: scripts/build_track_record_page.py)
        site/factordata/us_board_track.json
        site/factordata/us_board_outcomes.json
        site/factordata/us_audit_scoreboard.json
  Authority: display_only, accruing. No scoring / promotion here.
  The word "validated" never appears (CI-guarded).
  Design: Tier-3 depth page; top-of-page header follows Tier-1 rules (docs/DESIGN_DOCTRINE.md).
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>US Buy Board — Track Record</title>
{% set seo_title = "US Buy Board — Track Record — Mastermind" %}{% set seo_desc = "The full record of US buy-board calls — every entry, how it played out, and what the numbers say about signal quality." %}{% set seo_path = "us_track_record.html" %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="theme.css">
<style>
  *{box-sizing:border-box}
  body{margin:0;padding-top:24px;background:var(--bg);color:var(--text);font-family:var(--font-ui);font-size:14px;line-height:1.5}
  a{text-decoration:none;color:inherit}
  .tr-wrap{max-width:1200px;margin:0 auto;padding:0 20px 80px}

  /* ── page header ── */
  .tr-hd{padding:18px 0 14px}
  .tr-back{font-size:12px;color:var(--link);display:inline-flex;align-items:center;gap:4px;margin-bottom:10px}
  .tr-back:hover{opacity:.8}
  .tr-eyebrow{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 4px}
  .tr-title{font-size:clamp(22px,3vw,30px);font-weight:800;letter-spacing:-.02em;margin:0 0 6px}
  .tr-sub{color:var(--muted);font-size:13px;max-width:80ch;margin:0 0 4px}
  .tr-asof{color:var(--muted);font-size:12px}

  /* ── glance hero card ── */
  .tr-hero{display:flex;flex-wrap:wrap;gap:16px;margin:20px 0 28px;
    padding:18px 20px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}
  .tr-hero-stat{display:flex;flex-direction:column;gap:2px;min-width:120px}
  .tr-hero-stat .val{font-size:28px;font-weight:800;letter-spacing:-.02em}
  .tr-hero-stat .lbl{font-size:12px;color:var(--muted);font-weight:600}
  .tr-hero-stat.up .val{color:var(--up)}
  .tr-hero-stat.dn .val{color:var(--down)}
  .tr-hero-divider{width:1px;background:var(--line);align-self:stretch}
  .tr-hero-stance{flex:1;min-width:220px}
  .tr-hero-stance .stance-main{font-size:14.5px;font-weight:700;line-height:1.5}
  .tr-hero-stance .stance-sub{font-size:12.5px;color:var(--muted);margin-top:4px}
  .accruing-chip{display:inline-block;font-size:10px;font-weight:700;padding:2px 8px;border-radius:6px;
    border:1px solid color-mix(in srgb,var(--warn) 50%,var(--line));
    color:var(--warn);background:color-mix(in srgb,var(--warn) 10%,transparent);
    margin-left:6px;vertical-align:middle}

  /* ── section headers ── */
  .tr-section{margin-top:32px;padding-top:24px;border-top:1px solid var(--line)}
  .tr-section:first-of-type{border-top:none;margin-top:0;padding-top:0}
  .tr-section-hd{font-size:15px;font-weight:750;margin:0 0 4px}
  .tr-section-sub{font-size:12.5px;color:var(--muted);margin:0 0 14px;max-width:72ch}

  /* ── chart canvas ── */
  .tr-chart-wrap{position:relative;width:100%;height:160px;margin:0 0 8px;
    border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden}
  .tr-chart-wrap svg{position:absolute;inset:0;width:100%;height:100%}
  .tr-chart-legend{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:16px;font-size:11.5px;color:var(--muted)}
  .tr-chart-legend span{display:flex;align-items:center;gap:5px}
  .tr-chart-legend .dot{width:10px;height:10px;border-radius:50%}
  .chart-accruing{display:flex;align-items:center;justify-content:center;
    height:160px;border:1px solid var(--line);border-radius:10px;background:var(--panel);
    color:var(--muted);font-size:13px;font-style:italic;margin-bottom:8px}

  /* ── horizon ladder table ── */
  .tbl-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table.tr-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums;white-space:nowrap}
  table.tr-tbl th{text-align:right;padding:7px 10px;border-bottom:1.5px solid var(--line);
    color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  table.tr-tbl th:first-child{text-align:left}
  table.tr-tbl td{text-align:right;padding:7px 10px;border-bottom:1px solid var(--line)}
  table.tr-tbl td:first-child{text-align:left;font-weight:700}
  table.tr-tbl tr:last-child td{border-bottom:none}
  .pos{color:var(--up)} .neg{color:var(--down)} .neu{color:var(--muted)}
  .ci-range{font-size:10.5px;color:var(--muted)}
  .n-col{font-size:11px;color:var(--muted)}

  /* ── outcomes table ── */
  table.tr-out-tbl{width:100%;border-collapse:collapse;font-size:12.5px;font-variant-numeric:tabular-nums}
  table.tr-out-tbl th{text-align:right;padding:6px 9px;border-bottom:1.5px solid var(--line);
    color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
  table.tr-out-tbl th:first-child{text-align:left}
  table.tr-out-tbl td{text-align:right;padding:6px 9px;border-bottom:1px solid var(--line)}
  table.tr-out-tbl td:first-child{text-align:left}
  table.tr-out-tbl td.tk-cell{font-weight:700}
  table.tr-out-tbl tr:last-child td{border-bottom:none}
  .oc-dot{display:inline-block;width:8px;height:8px;border-radius:50%;vertical-align:middle}
  .oc-dot.running{background:var(--up)}
  .oc-dot.stopped{background:var(--down)}
  .oc-dot.flat{background:var(--muted)}
  .autopsy-col{color:var(--muted);font-size:11px}

  /* ── coverage / loss ledger cards ── */
  .tr-row-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:0 0 14px}
  @media(max-width:620px){.tr-row-grid{grid-template-columns:1fr}}
  .tr-card{border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--panel)}
  .tr-card-title{font-size:12.5px;font-weight:700;margin:0 0 8px}
  .tr-card-val{font-size:22px;font-weight:800;letter-spacing:-.02em}
  .tr-card-sub{font-size:11.5px;color:var(--muted);margin-top:3px}
  .tr-gap-note{font-size:12px;color:var(--muted);font-style:italic;padding:10px 0 0}

  /* ── accrual clock banner ── */
  .tr-clock{display:flex;align-items:flex-start;gap:10px;padding:12px 15px;
    border:1.5px solid color-mix(in srgb,var(--warn) 40%,var(--line));
    border-radius:10px;background:color-mix(in srgb,var(--warn) 6%,var(--panel));
    margin-bottom:16px;font-size:12.5px}
  .tr-clock-icon{font-size:18px;flex-shrink:0;margin-top:1px}
  .tr-clock-body{color:var(--muted)}
  .tr-clock-body b{color:var(--text)}

  /* ── disclosure footnote ── */
  .tr-footnote{font-size:11.5px;color:var(--muted);border-top:1px solid var(--line);
    padding-top:14px;margin-top:28px;max-width:90ch;line-height:1.65}
  .tr-footnote b{color:var(--text)}

  /* ── data-gap placeholder ── */
  .tr-gap-block{padding:18px;border:1px dashed var(--line);border-radius:10px;
    background:color-mix(in srgb,var(--muted) 4%,var(--panel));color:var(--muted);
    font-size:12.5px;font-style:italic;text-align:center}
</style>
</head>
<body>
<div class="tr-wrap">

  <!-- ── Back link + page header ── -->
  <div class="tr-hd">
    <a class="tr-back" href="us_stocks.html">← <span class="l-en">Buy Board</span><span class="l-zh">买入榜</span></a>
    <div class="tr-eyebrow">{{ t('US Buy Board', '美股买入榜') }}</div>
    <h1 class="tr-title">{{ t('Track Record', '往绩记录') }}</h1>
    <p class="tr-sub">{{ t('How names that left the buy board have performed since they were first surfaced — updated each night.', '离开买入榜的标的自首次上榜以来的表现——每晚更新。') }}</p>
    <div class="tr-asof">{{ t('as of', '截至') }} {{ outcomes_as_of }}{% if cohort_accruing %} <span class="accruing-chip">{{ t('ACCRUING', '积累中') }}</span>{% endif %}</div>
  </div>

  <!-- ── Section 1: Glance hero ── -->
  <div class="tr-hero">
    {% if win_rate_pct is not none %}
    <div class="tr-hero-stat up">
      <span class="val">{{ win_rate_pct }}%</span>
      <span class="lbl">{{ t('above surfacing price', '高于上榜价') }}</span>
    </div>
    <div class="tr-hero-divider"></div>
    {% if avg_pct is not none %}
    <div class="tr-hero-stat {{ 'up' if avg_pct > 0 else 'dn' if avg_pct < 0 else '' }}">
      <span class="val">{{ '%+.1f'|format(avg_pct) }}%</span>
      <span class="lbl">{{ t('avg move since surfaced', '上榜后平均涨跌幅') }}</span>
    </div>
    <div class="tr-hero-divider"></div>
    {% endif %}
    {% if n_outcomes is not none %}
    <div class="tr-hero-stat">
      <span class="val">{{ n_outcomes }}</span>
      <span class="lbl">{{ t('names tracked', '追踪标的数') }}</span>
    </div>
    <div class="tr-hero-divider"></div>
    {% endif %}
    <div class="tr-hero-stance">
      <div class="stance-main">
        {% if win_rate_pct is not none and win_rate_pct >= 55 %}
        {{ t('Most exits are still above their surfacing price — watch, do not chase new entries.', '多数标的仍高于上榜价——观察，勿追新入场机会。') }}
        {% elif win_rate_pct is not none and win_rate_pct < 50 %}
        {{ t('Under half of exits are above their surfacing price — approach new entries cautiously.', '不足半数标的高于上榜价——对新入场机会需审慎。') }}
        {% else %}
        {{ t('Watch — results accruing. Enough data to show direction but not enough for strong conclusions.', '观察——数据积累中。已有初步方向，但尚不足以得出明确结论。') }}
        {% endif %}
      </div>
      <div class="stance-sub">{{ t('Display-only context. These outcomes show past board members — not a return forecast.', '仅供展示参考。以上为历史上榜标的表现，不构成收益预测。') }}</div>
    </div>
    {% else %}
    <div class="tr-gap-block" style="flex:1">
      {{ t('Track record accruing — first board members surfaced in mid-June 2026.', '往绩积累中——买入榜首批标的于2026年6月中旬首次上榜。') }}
    </div>
    {% endif %}
  </div>
  {% if win_rate_pct is not none %}
  <p style="font-size:11.5px;color:var(--muted);margin:-12px 0 20px"><span class="l-en">Counts names still above their surfacing price — the 'vs S&amp;P 500' report cards below use a stricter ruler.</span><span class="l-zh">此处统计仍高于上榜价的标的数——下方"对比标普500"成绩单采用更严格的标准。</span></p>
  {% endif %}

  <!-- ── Section 2: Record over time ── -->
  <div class="tr-section">
    <div class="tr-section-hd">{{ t('Weekly win rate over time', '每周胜率走势') }}</div>
    <div class="tr-section-sub">
      {{ t('Rolling win rate by entry cohort — share of names still above their surfacing price at the 5-day mark.', '按入场批次的滚动胜率——5日时点仍高于上榜价的标的占比。') }}
      <span class="accruing-chip">{{ t('ACCRUING', '积累中') }}</span>
    </div>

    <!-- Inline chart rendered by vanilla JS from embedded JSON -->
    <div class="tr-clock">
      <div class="tr-clock-icon">⏳</div>
      <div class="tr-clock-body">
        <b>{{ t('Trend verdicts unlock later.', '趋势判断稍后开放。') }}</b>
        {{ t('First full 5-day report cards are already in — weekly trend unlocks once 4+ independent entry weeks have graded results. First 21-day grades arrive around mid-August 2026; trend conclusions on 21-day outcomes ~September 2026.', '5日成绩单已陆续出炉——需累计4个以上独立入场周方可作出每周趋势判断。21日成绩单约于2026年8月中旬出现；21日结果的趋势结论约于2026年9月形成。') }}
      </div>
    </div>

    <div id="chart-h5-wrap" class="tr-chart-wrap">
      <svg id="chart-h5" viewBox="0 0 800 160" preserveAspectRatio="none"></svg>
    </div>
    <div class="tr-chart-legend">
      <span><span class="dot" style="background:var(--up)"></span>{{ t('5-day win rate', '5日胜率') }}</span>
      <span class="neu" style="font-size:11px">{{ t('Dashed line = 50%', '虚线 = 50%') }}</span>
    </div>

    <div id="chart-h10-wrap" class="tr-chart-wrap">
      <svg id="chart-h10" viewBox="0 0 800 160" preserveAspectRatio="none"></svg>
    </div>
    <div class="tr-chart-legend">
      <span><span class="dot" style="background:var(--link,#4c8bf5)"></span>{{ t('10-day win rate', '10日胜率') }}</span>
    </div>
  </div>

  <!-- ── Section 3: Horizon ladder ── -->
  <div class="tr-section">
    <div class="tr-section-hd">{{ t('Results by holding period', '按持有周期的结果') }}</div>
    <div class="tr-section-sub">{{ t('How buy board names have done vs. the S&amp;P 500 over different holding windows. Range shown is a confidence interval — the true long-run rate is likely between these numbers.', '买入榜标的在不同持有窗口内相对标普500的表现。区间为置信区间——长期真实胜率大概率在此范围内。') }}</div>
    <div class="tbl-scroll">
    <table class="tr-tbl">
      <thead><tr>
        <th>{{ t('Window', '窗口') }}</th>
        <th>{{ t('Win rate', '胜率') }}</th>
        <th>{{ t('Likely range', '可能区间') }}</th>
        <th>{{ t('Avg excess', '平均超额') }}</th>
        <th>{{ t('Observations', '样本数') }}</th>
        <th>{{ t('Status', '状态') }}</th>
      </tr></thead>
      <tbody>
      {% if horizon_ladder %}
        {% for row in horizon_ladder %}
        <tr>
          <td>{{ row.horizon }}{{ t('-day', '日') }}</td>
          {% if row.accruing %}
          <td class="neu">—</td>
          <td class="neu">—</td>
          <td class="neu">—</td>
          <td class="n-col">{{ t('n=', 'n=') }}{{ row.raw_n }}</td>
          <td><span class="accruing-chip">{{ t('ACCRUING', '积累中') }}</span></td>
          {% else %}
          <td class="{{ 'pos' if row.hit_rate is not none and row.hit_rate > 0.5 else ('neg' if row.hit_rate is not none and row.hit_rate < 0.5 else 'neu') }}" data-tip-en="{{ row.horizon }}-day hit rate: {{ (row.hit_rate * 100)|round(1) }}% (raw n={{ row.raw_n }}, independent windows={{ row.effective_n }})" data-tip-zh="{{ row.horizon }}日胜率：{{ (row.hit_rate * 100)|round(1) }}%（原始样本数={{ row.raw_n }}，独立窗口={{ row.effective_n }}）">
            {{ (row.hit_rate * 100)|round|int }}%
          </td>
          <td class="ci-range" data-tip-en="90% confidence interval based on independent entry-date windows. True long-run rate likely between these bounds. Small n = wide interval." data-tip-zh="基于独立入场日窗口的90%置信区间。长期真实胜率大概率在此区间内。样本量小=区间宽。">
            {{ (row.wilson_lo * 100)|round|int }}–{{ (row.wilson_hi * 100)|round|int }}%
          </td>
          <td class="{{ 'pos' if row.mean_excess is not none and row.mean_excess > 0 else ('neg' if row.mean_excess is not none and row.mean_excess < 0 else 'neu') }}" data-tip-en="Average excess return vs SPY over {{ row.horizon }} days (buy-lane names, next-close entry realism)" data-tip-zh="买入榜标的相对SPY的{{ row.horizon }}日平均超额收益（次收盘入场）">
            {% if row.mean_excess is not none %}{{ '%+.2f'|format(row.mean_excess * 100) }}%{% else %}—{% endif %}
          </td>
          <td class="n-col" data-tip-en="Raw observations = {{ row.raw_n }} rows; independent entry-date windows = {{ row.effective_n }} (used for interval estimation)" data-tip-zh="原始样本={{ row.raw_n }}行；独立入场日窗口={{ row.effective_n }}（用于区间估计）">
            {{ row.raw_n }} / {{ row.effective_n }}
          </td>
          <td><span class="accruing-chip" style="border-color:color-mix(in srgb,var(--up) 50%,var(--line));color:var(--up);background:color-mix(in srgb,var(--up) 10%,transparent)">{{ t('LIVE', '实时') }}</span></td>
          {% endif %}
        </tr>
        {% endfor %}
      {% else %}
      <tr><td colspan="6" class="neu" style="text-align:center;padding:20px;font-style:italic">{{ t('Horizon data accruing — check back after the first few weeks of results.', '持有周期数据积累中——请在最初几周结果出炉后再查看。') }}</td></tr>
      {% endif %}
      </tbody>
    </table>
    </div>
    <p style="font-size:11px;color:var(--muted);margin:6px 0 0">{{ t('Observations = raw count / independent entry-date windows. Interval uses cluster-unit estimation to account for overlapping windows.', '样本数 = 原始计数 / 独立入场日窗口数。区间采用集群单元估计以修正重叠窗口影响。') }}</p>
  </div>

  <!-- ── Section 4: Per-pick outcomes table ── -->
  <div class="tr-section">
    <div class="tr-section-hd">{{ t('Recent board exits', '近期离榜标的') }}</div>
    <div class="tr-section-sub">
      {{ t('Names that left the buy board — their price since first surfacing.', '已离开买入榜的标的——自首次上榜以来的价格变化。') }}
      {% if outcomes_rows | length > 0 %}{{ t('Showing', '显示') }} {{ outcomes_rows | length }} {{ t('names.', '个标的。') }}{% endif %}
    </div>
    <!-- W2: pick_autopsies join -->
    {% if outcomes_rows %}
    <div class="tbl-scroll">
    <table class="tr-out-tbl">
      <thead><tr>
        <th>{{ t('Stock', '个股') }}</th>
        <th>{{ t('Sector', '行业') }}</th>
        <th>{{ t('Surfaced', '上榜日') }}</th>
        <th>{{ t('Return', '涨跌') }}</th>
        <th>{{ t('Status', '状态') }}</th>
        <th>{{ t('Notes', '备注') }}</th>
      </tr></thead>
      <tbody>
      {% for oc in outcomes_rows %}
      <tr>
        <td class="tk-cell"><a href="stock.html#{{ oc.ticker }}" data-tip-en="Open {{ oc.ticker }} stock page" data-tip-zh="打开{{ oc.ticker }}个股页面">{{ oc.ticker }}</a></td>
        <td class="neu" style="font-size:11px">{{ td(oc.get('sector','—')) }}</td>
        <td class="neu" style="font-size:11.5px">{{ oc.get('first_surfaced','—') }}</td>
        <td data-sort="{{ oc.pct_since if (oc.pct_since is defined and oc.pct_since is not none) else 0 }}">
          <span class="{{ 'pos' if (oc.pct_since is defined and oc.pct_since is not none and oc.pct_since > 0) else ('neg' if (oc.pct_since is defined and oc.pct_since is not none and oc.pct_since < 0) else 'neu') }}">
            {% if oc.pct_since is defined and oc.pct_since is not none %}{{ '%+.1f'|format(oc.pct_since) }}%{% else %}—{% endif %}
          </span>
        </td>
        <td><span class="oc-dot {{ oc.get('status','flat') }}"></span></td>
        <td class="autopsy-col">—</td><!-- W2: pick_autopsies join -->
      </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}
    <div class="tr-gap-block">
      {{ t('No board exits recorded yet — check back as names cycle through the buy board.', '尚无离榜记录——随着标的在买入榜上进出，请稍后再查看。') }}
    </div>
    {% endif %}
  </div>

  <!-- ── Section 5: Failure-mode mix ── -->
  <div class="tr-section">
    <div class="tr-section-hd">{{ t('Why names stopped out', '标的止损原因分析') }}</div>
    <div class="tr-section-sub">{{ t('Attribution of stopped-out names by category — what drove the loss.', '止损标的的原因归因——亏损的驱动因素。') }}</div>
    {% if failure_mix_data_gap %}
    <div class="tr-gap-block">
      {{ t('Attribution data accruing — this section fills in as more exits are graded.', '归因数据积累中——随着更多标的被评级，本节将逐步填充。') }}
    </div>
    {% else %}
    <div class="tr-row-grid">
      {% for col, vc in failure_mix.items() %}
      <div class="tr-card">
        <div class="tr-card-title">{{ col.replace('_',' ').title() }}</div>
        {% for k, v in vc.items() %}
        <div style="display:flex;justify-content:space-between;font-size:12px;padding:2px 0">
          <span class="neu">{{ k }}</span><span>{{ v }}</span>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <!-- ── Section 6: Coverage monitor + loss ledgers ── -->
  <div class="tr-section">
    <div class="tr-section-hd">{{ t('Coverage and audit', '覆盖率与审计') }}</div>
    <div class="tr-section-sub">{{ t('Weekly buy board activity and surfaced-vs-missed performance gap — an honest check on what the board catches vs. misses.', '每周买入榜活跃情况及上榜与未上榜标的表现差距——对买入榜覆盖率与遗漏情况的如实监测。') }}</div>

    <div class="tr-row-grid">
      <div class="tr-card">
        <div class="tr-card-title">{{ t('Weekly board activity', '每周榜单活跃度') }}</div>
        {% if coverage_monitor.get('weekly_history') %}
        {% for wk in coverage_monitor.weekly_history %}
        <div style="display:flex;justify-content:space-between;font-size:12px;padding:2px 0">
          <span class="neu">{{ wk.get('week','') }}</span>
          <span><b>{{ wk.get('unique_tickers',0) }}</b> {{ t('names', '个标的') }}</span>
        </div>
        {% endfor %}
        {% else %}
        <div class="tr-gap-note">{{ t('Weekly history accruing.', '每周历史积累中。') }}</div>
        {% endif %}
        {% if coverage_monitor.get('trailing_4wk_buy_count') is not none %}
        <div style="font-size:11.5px;color:var(--muted);margin-top:8px">{{ t('Trailing 4-week total:', '近4周合计：') }} <b>{{ coverage_monitor.trailing_4wk_buy_count }}</b></div>
        {% endif %}
      </div>

      <div class="tr-card">
        <div class="tr-card-title">{{ t('Surfaced vs. missed', '上榜与遗漏对比') }}</div>
        {% if gate_suppressed and gate_suppressed.get('state') == 'data_gap' %}
        <div class="tr-gap-note">{{ t('Attribution data accruing — surfaced-winner vs. unsurfaced-winner breakdown fills in once enough exits grade.', '归因数据积累中——上榜与未上榜领涨股对比将在足量标的评级后逐步填充。') }}</div>
        {% else %}
        <div style="font-size:12px">
          <div style="display:flex;justify-content:space-between;padding:3px 0">
            <span class="neu">{{ t('Buy board rows (graded)', '已评级买入榜行数') }}</span><span><b>{{ buy_lane_rows }}</b></span>
          </div>
          <div style="display:flex;justify-content:space-between;padding:3px 0">
            <span class="neu">{{ t('All lanes graded', '全部通道已评级') }}</span><span><b>{{ all_lanes_rows }}</b></span>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    <p style="font-size:12px;color:var(--muted);margin:0" class="tr-asof">{{ t('Audit data as of', '审计数据截至') }} {{ sb_as_of }}</p>
  </div>

  <!-- ── Section 7: Disclosures ── -->
  <div class="tr-footnote">
    <b>{{ t('Notes', '说明') }}</b> ·
    {{ t('Entry prices are the next session\'s close after the name first appeared on the board (next-bar realism). Returns are total-return (dividend-adjusted).', '入场价为标的首次上榜后下一交易日的收盘价（次日收盘入场）。收益为全收益（含股息调整）。') }}
    {% if n_skipped %} · {{ n_skipped }} {{ t('names excluded for missing prices (likely delisted).', '个标的因缺少价格被排除（可能已退市）。') }}{% endif %}
    · {{ t('Trend verdicts unlock once enough independent holding-period windows accrue — first full 21-day grades around mid-August 2026; trend conclusions on 21-day results around September 2026. Display-only throughout.', '趋势判断需积累足量独立持有期窗口后方可开放——21日完整成绩单约于2026年8月中旬出现；21日结果的趋势结论约于2026年9月形成。全程仅供展示参考。') }}
  </div>

</div><!-- end .tr-wrap -->

<script>
// Inline sparkline charts from embedded JSON — no chart libraries.
// Draws win-rate line + 50% reference on a small SVG canvas.
(function(){
  var seriesH5 = {{ chart_series_h5_json|safe }};
  var seriesH10 = {{ chart_series_h10_json|safe }};

  function drawChart(svgId, series, color) {
    var svg = document.getElementById(svgId);
    if (!svg || !series || series.length < 2) return;
    var W = 800, H = 160, PAD = 20;
    var vals = series.map(function(d){ return d.win_rate; });
    // Draw 50% reference line
    var y50 = H - PAD - (0.5) * (H - PAD * 2);
    var dashed = document.createElementNS('http://www.w3.org/2000/svg','line');
    dashed.setAttribute('x1', PAD); dashed.setAttribute('y1', y50);
    dashed.setAttribute('x2', W - PAD); dashed.setAttribute('y2', y50);
    dashed.setAttribute('stroke', 'var(--muted)');
    dashed.setAttribute('stroke-width', '1');
    dashed.setAttribute('stroke-dasharray', '4 4');
    svg.appendChild(dashed);
    // Draw win-rate line
    var n = vals.length;
    var xStep = (W - PAD * 2) / Math.max(n - 1, 1);
    var pts = vals.map(function(v, i){
      var x = PAD + i * xStep;
      var y = H - PAD - Math.max(0, Math.min(1, v)) * (H - PAD * 2);
      return x.toFixed(1) + ',' + y.toFixed(1);
    });
    var poly = document.createElementNS('http://www.w3.org/2000/svg','polyline');
    poly.setAttribute('points', pts.join(' '));
    poly.setAttribute('fill', 'none');
    poly.setAttribute('stroke', color);
    poly.setAttribute('stroke-width', '2');
    poly.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(poly);
    // Dots
    vals.forEach(function(v, i){
      var x = PAD + i * xStep;
      var y = H - PAD - Math.max(0, Math.min(1, v)) * (H - PAD * 2);
      var wr = Math.round(v * 100);
      var c = document.createElementNS('http://www.w3.org/2000/svg','circle');
      c.setAttribute('cx', x.toFixed(1));
      c.setAttribute('cy', y.toFixed(1));
      c.setAttribute('r', '4');
      c.setAttribute('fill', color);
      c.setAttribute('opacity', '0.85');
      c.setAttribute('title', series[i].week + ': ' + wr + '% (' + series[i].raw_n + ' names)');
      svg.appendChild(c);
    });
  }

  var upColor = getComputedStyle(document.documentElement).getPropertyValue('--up').trim() || '#34d17a';
  var lnkColor = getComputedStyle(document.documentElement).getPropertyValue('--link').trim() || '#4c8bf5';
  drawChart('chart-h5', seriesH5, upColor);
  drawChart('chart-h10', seriesH10, lnkColor);
})();
</script>
</body>
</html>
