      'When A15 fires (washout + ≥2 opposite-complex sectors rotating out), the armed window opens for up to 10 sessions. This desk shows today\'s armed sectors and which member stocks from those sectors currently have a T1–T3 cascade signal. DISPLAY-ONLY — feeds no score, gate, or ordering surface.',
      '当A15触发（洗盘 + ≥2个对立复合板块轮出），入场窗口开启，持续最多10个交易日。此台显示当前处于入场窗口的板块，以及这些板块中当前有T1–T3级联信号的成员股票。仅供展示——不驱动任何评分、门控或排序。'
    ) }}</p>

    <div id="td-content">
      <p class="td-quiet">
        <span class="l-en">Loading…</span><span class="l-zh">加载中…</span>
      </p>
    </div>

    <script>
    (function(){
    'use strict';
    function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
    function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
    function t(en,zh){return isZh()&&zh?zh:en;}

    var ARTIFACT = 'basketdata/oracle_turn_desk.json';

    function render(d){
      var el = document.getElementById('td-content');
      if(!el) return;
      var armed = d.armed || [];
      var br    = d.base_rates || {};
      var pc    = d.promotion_clock || {};
      var qualNote = d.qual_accrual_note || '';

      // Staleness note when asof differs
      var staleHtml = '';
      if(d.asof && d.member_fires_asof && d.asof !== d.member_fires_asof){
        staleHtml = '<p class="td-staleness-note">'
          + t('Note: panel asof ','注意：面板日期')
          + esc(d.asof)
          + t(' / member signals asof ','，成员信号日期')
          + esc(d.member_fires_asof)
          + '</p>';
      }

      if(!armed.length){
        el.innerHTML = staleHtml
          + '<p class="td-quiet">'
          + t('No sectors currently armed — A15 has not fired in the last 10 sessions. Quiet state is a valid state.',
              '当前无板块处于入场窗口——A15在过去10个交易日内未触发。安静状态是有效状态。')
          + '</p>'
          + _caveatsHtml(br, pc, qualNote);
        return;
      }

      var cardsHtml = '<div class="td-armed-grid">';
      armed.forEach(function(sec){
        var name = isZh() ? (sec.name_zh||sec.node) : (sec.name_en||sec.node);
        var mfires = sec.member_fires || [];
        var firesHtml = '';
        if(mfires.length){
          firesHtml = '<ul class="td-member-list">';
          mfires.forEach(function(m){
            var tierCls = m.tier==='T3' ? ' t3' : '';
            var provNote = m.provisional
              ? '<span class="td-provisional-note">'
                + t('(repaint ~9.4%)', '（约9.4%重绘）')
                + '</span>'
              : '';
            firesHtml += '<li class="td-member-item">'
              + '<span class="td-member-ticker">'+esc(m.ticker)+'</span>'
              + '<span class="td-tier-tag'+tierCls+'">'+esc(m.tier)+'</span>'
              + provNote
              + '</li>';
          });
          firesHtml += '</ul>';
        } else {
          firesHtml = '<p class="td-no-fires">'
            + t('No cascade fires in this sector today','此板块今日暂无级联信号')
            + '</p>';
        }
        var qualFilters = sec.qual_filters_true || [];
        var qualHtml = '';
        if(qualFilters.length){
          qualHtml = '<div class="td-qual-filters">'
            + '<span style="margin-right:4px">'
            + t('Context filters active:', '上下文过滤器激活：')
            + '</span>';
          qualFilters.forEach(function(fid){
            var tipEn = '', tipZh = '';
            if(fid==='F-Q2-RISKOFF'){ tipEn='Market state is NOT risk-off'; tipZh='市场状态非避险'; }
            else if(fid==='F-Q2-HIGHVIX'){ tipEn='VIX percentile ≥0.6'; tipZh='VIX百分位≥0.6'; }
            else if(fid==='F-Q3-TAPE'){ tipEn='Operator tape touch'; tipZh='运营商标注匹配'; }
            var tipAttrs = (tipEn ? ' data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'"' : '');
            qualHtml += '<span class="td-qual-filter-tag"'
              + tipAttrs
              + '>'+esc(fid)+'</span>';
          });
          qualHtml += '</div>';
        }
        cardsHtml += '<div class="td-sector-card">'
          + '<div class="td-card-hd">'
          + '<span class="td-sector-name">'+esc(name)+'</span>'
          + '<span class="td-window-badge">'
          + t('ARMED', '已激活')
          + '</span>'
          + '<span class="td-sessions-left">'
          + esc(sec.sessions_remaining)
          + t(' sessions left', ' 日剩余')
          + '</span>'
          + '</div>'
          + firesHtml
          + qualHtml
          + '</div>';
      });
      cardsHtml += '</div>';

      el.innerHTML = staleHtml + cardsHtml + _caveatsHtml(br, pc, qualNote);
    }

    function _caveatsHtml(br, pc, qualNote){
      var wrIn  = br.in_window_wr21  != null ? (br.in_window_wr21*100).toFixed(1)+'%' : '65.2%';
      var wrOut = br.outside_window_wr21 != null ? (br.outside_window_wr21*100).toFixed(1)+'%' : '53.6%';
      var delta = br.holdout_delta_pp != null ? '+'+br.holdout_delta_pp.toFixed(1)+'pp' : '+10.7pp';
      var ciLo  = br.holdout_ci_lo_pp != null ? br.holdout_ci_lo_pp.toFixed(1) : '3.8';
      var ciHi  = br.holdout_ci_hi_pp != null ? br.holdout_ci_hi_pp.toFixed(1) : '17.9';
      var nw    = br.n_windows || 31;
      var from  = br.modern_track_from || '2022-06-30';
      var accrued  = pc.windows_accrued || 0;
      var required = pc.windows_required || 15;

      return '<div class="td-caveats">'
        + '<strong>'
        + t('Base rates (display-with-edge, lineage: #1533):', '基础胜率（展示边缘级，来源：#1533）：')
        + '</strong> '
        + t('IN-window member fires WR21 ', '窗口内成员触发WR21 ')
        + wrIn
        + t(' vs ', ' vs ')
        + wrOut
        + t(' outside; holdout Δ', '（窗口外）；持出集Δ')
        + delta
        + ' CI [+'+ciLo+', +'+ciHi+'pp]. '
        + nw + t(' modern-track windows (holdout n=15)', '个现代追踪窗口（持出集n=15）') + ', ≥' + from + '. '
        + t('Growth/cyclical tilt; defensive sectors negative.', '成长/周期偏向；防御性板块为负。')
        + ' <em>'
        + t('Not a forecast.', '非预测。')
        + '</em><br>'
        + '<span class="td-promotion-clock">'
        + t('Promotion clock: ', '晋升计数：')
        + accrued + ' / ' + required
        + t(' windows accrued (re-evaluation gate at 15).', ' 个窗口已累积（15个触发复评）。')
        + '</span>'
        + (qualNote ? '<div class="td-qual-accrual-note" data-tip-en="Qualitative filters log context at window open; accrual is descriptive-only — no ranking or gating." data-tip-zh="定性过滤器在窗口开启时记录上下文；积累数据为描述性——不排名不设门控。">'+esc(qualNote)+'</div>' : '')
        + '</div>';
    }

    fetch(ARTIFACT, {cache:'no-cache'})
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){
        if(!d){ throw new Error('no data'); }
        render(d);
      })
      .catch(function(){
        var el = document.getElementById('td-content');
        if(el) el.innerHTML = '<p class="td-quiet">'
          + '<span class="l-en">Turn Desk data unavailable.</span>'
          + '<span class="l-zh">入场台数据暂不可用。</span>'
          + '</p>';
      });

    // Re-render on lang/theme change
    var _obs = new MutationObserver(function(){
      fetch(ARTIFACT, {cache:'no-cache'})
        .then(function(r){ return r.ok ? r.json() : null; })
        .then(function(d){ if(d) render(d); })
        .catch(function(){});
    });
    _obs.observe(document.documentElement, {attributes:true, attributeFilter:['data-lang','data-theme']});

    })();
    </script>

