<script>
/* Oracle Time Machine — inline JS for subsector_rotation.html
 * Lazy-loads from oracledata/ (IntersectionObserver); canvas-based RRG scatter.
 * No new JS dependencies.  All color tokens from CSS custom properties so
 * theme/lang switches apply instantly.
 */
(function(){
'use strict';

var BASE  = 'oracledata/';
var MANI  = BASE + 'tm_manifest.json';
var EP    = BASE + 'tm_episodes.json';

/* ── state ── */
var _manifest = null, _epFeed = null;
var _tier = 's';
var _registry = null;        // active tier registry
var _chunks = {};            // cache: "2022M01" -> chunk data
var _dates = [];             // merged sorted date list for active tier
var _chunkMeta = [];         // manifest chunks for active tier
var _pos = 0;                // current date index
var _playing = false;
var _playTimer = null;
var _canvas = null, _ctx = null;
var _canvW = 0, _canvH = 0;
var _manifest_loaded = false;
var _ep_loaded = false;
var _TRAIL = 10;             // trail length in frames

/* ── helpers ── */
function cssVar(n){return getComputedStyle(document.documentElement).getPropertyValue(n).trim();}
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
function L(r){return r ? (isZh() && r.label_zh ? r.label_zh : r.label_en) : '';}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function clamp(v,mn,mx){return Math.max(mn,Math.min(mx,v));}

/* ── boot via IntersectionObserver ── */
document.addEventListener('DOMContentLoaded', function(){
  var sec = document.getElementById('tm-section');
  if(!sec) return;
  if(!('IntersectionObserver' in window)){
    _init();
    return;
  }
  var obs = new IntersectionObserver(function(entries){
    if(entries[0].isIntersecting){ obs.disconnect(); _init(); }
  }, {rootMargin:'200px'});
  obs.observe(sec);
});

function _init(){
  _setupCanvas();
  Promise.all([
    fetch(MANI, {cache:'no-cache'}).then(function(r){if(!r.ok)throw new Error('manifest');return r.json();}),
    fetch(EP,   {cache:'no-cache'}).then(function(r){if(!r.ok)throw new Error('episodes');return r.json();})
  ]).then(function(results){
    _manifest = results[0];
    _epFeed   = results[1];
    _buildPresets();
    _setTier('s');
    _wireControls();
  }).catch(function(e){
    var ld = document.getElementById('tm-loading');
    if(ld) ld.innerHTML = '<span class="l-en">Could not load Time Machine data.</span><span class="l-zh">无法加载时光机数据。</span>';
  });
}

/* ── canvas setup ── */
function _setupCanvas(){
  var box = document.getElementById('tm-canvas-box');
  if(!box) return;
  var ld = document.getElementById('tm-loading');
  var cvs = document.createElement('canvas');
  cvs.id = 'tm-canvas';
  cvs.setAttribute('aria-label', 'Rotation scatter chart');
  _canvas = cvs;
  _ctx = cvs.getContext('2d');
  if(ld) box.insertBefore(cvs, ld); else box.appendChild(cvs);

  /* Quadrant labels */
  var labels = [
    {cls:'q-tl tm-scatter-label', en:'Improving', zh:'改善'},
    {cls:'q-tr tm-scatter-label', en:'Leading',   zh:'领先'},
    {cls:'q-bl tm-scatter-label', en:'Lagging',   zh:'落后'},
    {cls:'q-br tm-scatter-label', en:'Weakening', zh:'走弱'}
  ];
  labels.forEach(function(l){
    var sp = document.createElement('span');
    sp.className = l.cls;
    sp.innerHTML = '<span class="l-en">'+esc(l.en)+'</span><span class="l-zh">'+esc(l.zh)+'</span>';
    box.appendChild(sp);
  });

  _resizeCanvas();
  window.addEventListener('resize', _resizeCanvas);
}

function _resizeCanvas(){
  if(!_canvas) return;
  var box = document.getElementById('tm-canvas-box');
  if(!box) return;
  var w = box.clientWidth || 340;
  var h = Math.round(w * 0.72);
  _canvW = w; _canvH = h;
  var dpr = window.devicePixelRatio || 1;
  _canvas.width  = w * dpr;
  _canvas.height = h * dpr;
  _canvas.style.width  = w + 'px';
  _canvas.style.height = h + 'px';
  if(_ctx) _ctx.scale(dpr, dpr);
  _draw();
}

/* ── tier management ── */
function _setTier(tier){
  _tier = tier;
  if(!_manifest) return;
  var info = _manifest.tiers[tier];
  if(!info) return;
  _registry = _manifest.registry[tier];
  _chunkMeta = info.chunks || [];
  // Build full sorted date list from chunk metadata
  _dates = [];
  _chunkMeta.forEach(function(c){ /* actual dates loaded on demand */ });
  // Prime date list from chunk meta (conservative: use chunk date ranges)
  // Actual dates are loaded per-chunk
  _chunks = {};
  _pos = 0;

  // Load first chunk to populate slider
  _loadChunkForPos(0, function(){
    _buildDateList(function(){
      var slider = document.getElementById('tm-slider');
      if(slider){ slider.max = Math.max(0, _dates.length - 1); slider.value = _dates.length - 1; }
      _pos = _dates.length - 1;
      _updateDateLabel();
      _draw();
      var ld = document.getElementById('tm-loading');
      if(ld) ld.style.display = 'none';
    });
  });

  // Watermark
  var wm = document.getElementById('tm-watermark');
  if(wm) wm.style.display = (tier === 'm') ? '' : 'none';

  // Tier buttons
  document.querySelectorAll('.tm-tier-btn').forEach(function(b){
    b.classList.toggle('active', b.getAttribute('data-tier') === tier);
  });
}

function _buildDateList(cb){
  // Load all chunks sequentially to build complete date list
  var allDates = [];
  var i = 0;
  function next(){
    if(i >= _chunkMeta.length){ _dates = allDates; if(cb) cb(); return; }
    var meta = _chunkMeta[i++];
    _getChunk(meta.key, function(chunk){
      if(chunk && chunk.dates) chunk.dates.forEach(function(d){ allDates.push(d); });
      next();
    });
  }
  next();
}

/* ── chunk loader ── */
function _getChunk(periodKey, cb){
  if(_chunks[periodKey]){ cb(_chunks[periodKey]); return; }
  var meta = _chunkMeta.filter(function(c){ return c.key === periodKey; })[0];
  if(!meta){ cb(null); return; }
  fetch(BASE + meta.file, {cache:'no-cache'})
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){ _chunks[periodKey] = d || {}; cb(_chunks[periodKey]); })
    .catch(function(){ _chunks[periodKey] = {}; cb({}); });
}

function _loadChunkForPos(pos, cb){
  if(!_dates.length){
    // No dates yet; load the last chunk (most recent) first
    if(_chunkMeta.length){
      var meta = _chunkMeta[_chunkMeta.length - 1];
      _getChunk(meta.key, cb || function(){});
    } else { if(cb) cb(); }
    return;
  }
  var dateStr = _dates[pos];
  var ym = dateStr.slice(0, 7).replace('-', _tier === 's' ? '-' : '-');
  // Find chunk whose date_from <= dateStr <= date_to
  var meta = _chunkMeta.filter(function(c){ return c.date_from <= dateStr && dateStr <= c.date_to; })[0];
  if(!meta) meta = _chunkMeta[_chunkMeta.length - 1];
  if(meta) _getChunk(meta.key, cb || function(){}); else if(cb) cb();
}

/* ── drawing ── */
function _getNodePoints(dateStr){
  if(!_registry || !dateStr) return [];
  // Find which chunk owns this date
  var meta = _chunkMeta.filter(function(c){
    return c.date_from <= dateStr && dateStr <= c.date_to;
  })[0];
  if(!meta) return [];
  var chunk = _chunks[meta.key];
  if(!chunk || !chunk.dates) return [];
  var dateIdx = chunk.dates.indexOf(dateStr);
  if(dateIdx < 0) return [];
  var pts = [];
  _registry.forEach(function(reg){
    var arr = chunk.data && chunk.data[String(reg.id)];
    if(!arr || dateIdx >= arr.length) return;
    var v = arr[dateIdx];
    if(!v) return;
    var rs = v[0], az = v[1];
    if(rs == null || az == null) return;
    pts.push({id: reg.id, name: reg.name, name_zh: reg.name_zh, tier: reg.tier, theme: reg.theme, rs: rs, az: az});
  });
  return pts;
}

function _draw(){
  if(!_ctx || !_canvW) return;
  var W = _canvW, H = _canvH;
  var ctx = _ctx;
  ctx.clearRect(0, 0, W, H);

  var bg     = cssVar('--panel') || '#181b21';
  var line   = cssVar('--line')  || '#2a2f3a';
  var muted  = cssVar('--muted') || '#8b93a1';
  var up     = cssVar('--up')    || '#45b873';
  var down   = cssVar('--down')  || '#e06464';
  var txt    = cssVar('--text')  || '#d7dce3';

  // Padding
  var PAD = {l:40, r:20, t:20, b:30};
  var pw = W - PAD.l - PAD.r;
  var ph = H - PAD.t - PAD.b;

  // Background
  ctx.fillStyle = bg;
  ctx.fillRect(0, 0, W, H);

  // Determine axis ranges from current visible points
  var allPts = _getNodePoints(_dates[_pos]);
  if(!allPts.length){
    ctx.fillStyle = muted;
    ctx.font = '13px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Loading…', W/2, H/2);
    return;
  }

  var rsVals  = allPts.map(function(p){return p.rs;});
  var azVals  = allPts.map(function(p){return p.az;});
  var rsMax = Math.max(0.15, Math.max.apply(null, rsVals.map(Math.abs)) * 1.2);
  var azMax = Math.max(1.5,  Math.max.apply(null, azVals.map(Math.abs)) * 1.2);

  function toX(rs){ return PAD.l + (rs / rsMax + 1) / 2 * pw; }
  function toY(az){ return PAD.t + (1 - (az / azMax + 1) / 2) * ph; }

  // Quadrant fill
  var cx = toX(0), cy = toY(0);
  ctx.globalAlpha = 0.04;
  ctx.fillStyle = up;
  ctx.fillRect(cx, PAD.t, W - PAD.r - cx, ph / 2);           // TR: leading
  ctx.fillRect(PAD.l, PAD.t, cx - PAD.l, ph / 2);             // TL: improving
  ctx.globalAlpha = 0.04;
  ctx.fillStyle = down;
  ctx.fillRect(cx, cy, W - PAD.r - cx, H - PAD.b - cy);       // BR: weakening
  ctx.fillRect(PAD.l, cy, cx - PAD.l, H - PAD.b - cy);         // BL: lagging
  ctx.globalAlpha = 1;

  // Grid lines (center cross)
  ctx.strokeStyle = line;
  ctx.lineWidth = 1;
  ctx.setLineDash([4, 3]);
  ctx.beginPath(); ctx.moveTo(cx, PAD.t); ctx.lineTo(cx, H - PAD.b); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(PAD.l, cy); ctx.lineTo(W - PAD.r, cy); ctx.stroke();
  ctx.setLineDash([]);

  // Axis labels
  ctx.fillStyle = muted;
  ctx.font = '10px Inter, sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('RS', W/2, H - 4);
  ctx.save(); ctx.translate(10, H/2); ctx.rotate(-Math.PI/2);
  ctx.fillText('Accel', 0, 0);
  ctx.restore();

  // Build active episodes index for this date
  var dateStr = _dates[_pos];
  var activeEpNodes = {};   // node -> {dir, stage}
  if(_epFeed && _epFeed.episodes){
    _epFeed.episodes.forEach(function(ep){
      if(!ep.onset_date) return;
      var active = ep.onset_date <= dateStr &&
                   (ep.exhausted_date ? ep.exhausted_date >= dateStr : ep.confirmed_date >= dateStr || true);
      if(!active) return;
      // Determine stage
      var stage = 'onset';
      if(ep.undeniable_date && ep.undeniable_date <= dateStr) stage = 'undeniable';
      else if(ep.confirmed_date && ep.confirmed_date <= dateStr) stage = 'confirmed';
      if(!activeEpNodes[ep.node] || stage === 'undeniable') {
        activeEpNodes[ep.node] = {dir: ep.direction, stage: stage, ep: ep};
      }
    });
  }

  // Draw trails + dots
  var TRAIL = _TRAIL;
  allPts.forEach(function(pt){
    // Collect trail
    var trail = [];
    for(var t = Math.max(0, _pos - TRAIL); t <= _pos; t++){
      var tp = _getNodePoints(_dates[t]).filter(function(p){return p.id===pt.id;})[0];
      if(tp) trail.push({x: toX(tp.rs), y: toY(tp.az)});
    }

    // Draw trail
    if(trail.length > 1){
      for(var ti = 1; ti < trail.length; ti++){
        var alpha = 0.12 + 0.4 * (ti / trail.length);
        ctx.beginPath();
        ctx.strokeStyle = 'rgba(' + (pt.az >= 0 ? '69,184,115' : '224,100,100') + ',' + alpha + ')';
        ctx.lineWidth = 1;
        ctx.moveTo(trail[ti-1].x, trail[ti-1].y);
        ctx.lineTo(trail[ti].x, trail[ti].y);
        ctx.stroke();
      }
    }

    // Dot
    var ep = activeEpNodes[pt.name];
    var dotR = 4;
    var dotColor = pt.az >= 0 ? up : down;
    ctx.beginPath();
    ctx.arc(toX(pt.rs), toY(pt.az), dotR, 0, Math.PI * 2);
    ctx.fillStyle = dotColor;
    ctx.globalAlpha = 0.85;
    ctx.fill();
    ctx.globalAlpha = 1;

    // Episode ring
    if(ep){
      var ringColor = ep.dir === 'in' ? up : down;
      ctx.beginPath();
      ctx.arc(toX(pt.rs), toY(pt.az), dotR + 3, 0, Math.PI * 2);
      ctx.strokeStyle = ringColor;
      ctx.lineWidth = ep.stage === 'undeniable' ? 2.5 : (ep.stage === 'confirmed' ? 1.8 : 1.2);
      ctx.stroke();
    }
  });

  // Node labels for tier-s (11 nodes, label all)
  if(_tier === 's'){
    ctx.fillStyle = txt;
    ctx.font = '10px Inter, sans-serif';
    ctx.globalAlpha = 0.8;
    allPts.forEach(function(pt){
      ctx.textAlign = pt.rs >= 0 ? 'left' : 'right';
      var name = isZh() && pt.name_zh ? pt.name_zh : pt.name;
      ctx.fillText(name, toX(pt.rs) + (pt.rs >= 0 ? 6 : -6), toY(pt.az) + 4);
    });
    ctx.globalAlpha = 1;
  }
}

/* ── episode side panel ── */
function _updateEpPanel(){
  var el = document.getElementById('tm-ep-list');
  if(!el || !_epFeed) return;
  var dateStr = _dates[_pos];
  if(!dateStr){ el.innerHTML = '<span class="tm-ep-empty"><span class="l-en">—</span><span class="l-zh">—</span></span>'; return; }

  var active = [];
  _epFeed.episodes.forEach(function(ep){
    if(!ep.onset_date) return;
    if(ep.onset_date > dateStr) return;
    var end = ep.exhausted_date || ep.confirmed_date;
    if(end && end < dateStr) return;
    active.push(ep);
  });

  if(!active.length){
    el.innerHTML = '<span class="tm-ep-empty"><span class="l-en">No episodes on this date</span><span class="l-zh">此日期暂无情节</span></span>';
    return;
  }

  // Sort: in first then out, then by onset_date desc
  active.sort(function(a,b){ return (a.direction==='in'?0:1) - (b.direction==='in'?0:1) || (b.onset_date||'').localeCompare(a.onset_date||''); });
  active = active.slice(0, 20);

  var html = active.map(function(ep){
    var stage = 'onset';
    if(ep.undeniable_date && ep.undeniable_date <= dateStr) stage = 'undeniable';
    else if(ep.confirmed_date && ep.confirmed_date <= dateStr) stage = 'confirmed';
    var dirClass = ep.direction === 'in' ? 'tm-ep-dir-in' : 'tm-ep-dir-out';
    var dirLabel = ep.direction === 'in'
      ? '<span class="l-en">Rotating in</span><span class="l-zh">轮入</span>'
      : '<span class="l-en">Rotating out</span><span class="l-zh">轮出</span>';
    var tierBadge = ep.tier === 's'
      ? '<span class="tm-ep-badge"><span class="l-en">sector</span><span class="l-zh">板块</span></span>'
      : '';
    return '<div class="tm-ep-item '+dirClass+'">'
      + '<div class="tm-ep-node">'+esc(ep.node)+tierBadge+'</div>'
      + '<div>'+dirLabel
      + ' <span class="tm-ep-badge '+stage+'">'+stage+'</span></div>'
      + (ep.paired_episode_id ? '<div class="tm-ep-pair"><span class="l-en">Pair: </span><span class="l-zh">配对：</span>'+esc(ep.paired_episode_id)+'</div>' : '')
      + '</div>';
  }).join('');
  el.innerHTML = html;
}

/* ── preset playlist ── */
function _buildPresets(){
  var strip = document.getElementById('tm-presets');
  if(!strip || !_epFeed || !_epFeed.presets) return;
  // Remove loading text, keep heading
  strip.innerHTML = '<span class="tm-ep-hd l-en">Famous episodes</span><span class="tm-ep-hd l-zh">经典轮动片段</span>';
  _epFeed.presets.forEach(function(preset){
    var btn = document.createElement('button');
    btn.className = 'tm-preset-btn';
    btn.innerHTML = '<span class="l-en">'+esc(preset.label_en)+'</span>'
      + '<span class="l-zh">'+esc(preset.label_zh)+'</span>';
    btn.addEventListener('click', function(){
      _activatePreset(preset);
    });
    strip.appendChild(btn);
  });
}

function _activatePreset(preset){
  var tier = preset.tier || 's';
  // Switch tier if needed
  if(tier !== _tier){
    _setTier(tier);
    // Wait for dates to load before seeking
    var attempts = 0;
    var iv = setInterval(function(){
      if(_dates.length || attempts++ > 20){ clearInterval(iv); _seekToPreset(preset); }
    }, 150);
  } else {
    _seekToPreset(preset);
  }
}

function _seekToPreset(preset){
  if(!_dates.length) return;
  // Seek to date_from
  var target = preset.date_from;
  var idx = _dates.indexOf(target);
  if(idx < 0){
    // Find closest date
    idx = _dates.length - 1;
    for(var i = 0; i < _dates.length; i++){
      if(_dates[i] >= target){ idx = i; break; }
    }
  }
  _pos = idx;
  var slider = document.getElementById('tm-slider');
  if(slider) slider.value = _pos;
  _updateDateLabel();
  _loadChunkForPos(_pos, function(){ _draw(); _updateEpPanel(); });
}

/* ── controls ── */
function _updateDateLabel(){
  var el = document.getElementById('tm-date-lbl');
  if(el) el.textContent = _dates[_pos] || '—';
}

function _wireControls(){
  /* tier buttons */
  document.querySelectorAll('.tm-tier-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      _setTier(btn.getAttribute('data-tier'));
    });
  });

  /* play/pause */
  var playBtn = document.getElementById('tm-play');
  if(playBtn){
    playBtn.addEventListener('click', function(){
      _playing = !_playing;
      playBtn.textContent = _playing ? '⏸' : '▶';
      if(_playing) _tick();
    });
  }

  /* slider */
  var slider = document.getElementById('tm-slider');
  if(slider){
    slider.addEventListener('input', function(){
      _pos = parseInt(slider.value, 10);
      _updateDateLabel();
      _loadChunkForPos(_pos, function(){ _draw(); _updateEpPanel(); });
    });
  }
}

function _tick(){
  if(!_playing) return;
  var speed = parseInt((document.getElementById('tm-speed') || {}).value || 1, 10);
  _pos = Math.min(_dates.length - 1, _pos + 1);
  if(_pos >= _dates.length - 1){ _playing = false; var p = document.getElementById('tm-play'); if(p) p.textContent = '▶'; }
  var slider = document.getElementById('tm-slider');
  if(slider) slider.value = _pos;
  _updateDateLabel();
  _loadChunkForPos(_pos, function(){ _draw(); _updateEpPanel(); });
  if(_playing) _playTimer = setTimeout(_tick, Math.max(80, Math.round(300 / speed)));
}

/* ── theme/lang change: redraw ── */
var _themeObs = new MutationObserver(function(){ _draw(); });
_themeObs.observe(document.documentElement, {attributes:true, attributeFilter:['data-theme','data-lang']});

})();
</script>
</body>
</html>
