  .tm-scatter-label { position:absolute; font-size:10px; color:var(--muted); pointer-events:none; }
  .tm-scatter-label.q-tl { top:6px; left:8px; }
  .tm-scatter-label.q-tr { top:6px; right:8px; text-align:right; }
