{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>China Strategy Scorecards — Market Intelligence</title>
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}}; --grid:{{C.grid}}; --card:{{C.card}};
  --bg:{{C.bg}}; --green:#1FA971;
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0 14px;border-bottom:1px solid var(--grid);margin-bottom:24px;position:sticky;top:0;background:var(--bg);z-index:20}
.nav-links{display:flex;align-items:center;gap:2px;flex-wrap:wrap}
a.nav-link{padding:7px 11px;border-radius:9px;font-size:13.5px;font-weight:500;color:var(--muted);text-decoration:none;white-space:nowrap;transition:color .18s,background .18s}
a.nav-link:hover,a.nav-link.active{color:var(--ink);background:#eef1f6}
.nav-dd{position:relative;display:inline-flex}
.nav-dd>a.nav-link .caret{display:inline-block;margin-left:3px;font-size:9px;opacity:.6;transition:transform .2s}
.nav-dd:hover>a.nav-link .caret,.nav-dd:focus-within>a.nav-link .caret{transform:rotate(180deg)}
.nav-dd::after{content:"";position:absolute;left:0;right:0;top:100%;height:9px}
.nav-dd-menu{position:absolute;top:calc(100% + 7px);left:0;min-width:218px;background:var(--card);border:1px solid var(--grid);border-radius:13px;box-shadow:0 12px 34px rgba(16,24,40,.14);padding:6px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:70}
.nav-dd:hover>.nav-dd-menu,.nav-dd:focus-within>.nav-dd-menu{opacity:1;visibility:visible;transform:translateY(0)}
.nav-dd-menu a{display:block;padding:9px 12px;border-radius:9px;font-size:13.5px;font-weight:600;color:var(--text);text-decoration:none;white-space:nowrap;transition:background .15s,color .15s}
.nav-dd-menu a .d{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:2px}
.nav-dd-menu a:hover,.nav-dd-menu a.active{background:#eef1f6;color:var(--ink)}
.nav-ctrls{display:flex;align-items:center;gap:10px;flex:none}
.nav-ctrls .ai-brief-link{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;flex:none;padding:5px 12px;border-radius:999px;background:var(--card);border:1px solid var(--grid);color:var(--text);font-size:12.5px;font-weight:600;line-height:1;text-decoration:none;transition:border-color .15s,color .15s}
.nav-ctrls .ai-brief-link:hover{border-color:var(--blue);color:var(--blue)}
.lang-toggle{display:inline-flex;position:relative;background:#eef1f6;border:1px solid var(--grid);border-radius:999px;padding:3px;cursor:pointer;flex:none}
.lang-toggle .pill{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);border-radius:999px;background:var(--blue);transition:transform .34s cubic-bezier(.34,1.4,.5,1)}
html[data-lang="zh"] .lang-toggle .pill{transform:translateX(100%)}
.lang-toggle .opt{position:relative;z-index:1;min-width:28px;text-align:center;padding:3px 9px;font-size:11.5px;font-weight:600;color:var(--muted);transition:color .25s;user-select:none}
html:not([data-lang="zh"]) .lang-toggle .en-opt{color:#fff}
html[data-lang="zh"] .lang-toggle .zh-opt{color:#fff}
.theme-switch{width:56px;height:27px;border-radius:999px;background:#eef1f6;border:1px solid var(--grid);position:relative;cursor:pointer;padding:0;flex:none}
.theme-switch .ic{position:absolute;top:50%;transform:translateY(-50%);font-size:10.5px;opacity:.5;line-height:1}
.theme-switch .ic.sun{right:8px}.theme-switch .ic.moon{left:8px}
.theme-switch .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 5px rgba(0,0,0,.3);transform:translateX(29px);transition:transform .34s cubic-bezier(.34,1.45,.5,1),background .3s}
.theme-switch .knob::before{content:"☀️"}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280}
html[data-theme="dark"] a.nav-link:hover,html[data-theme="dark"] a.nav-link.active{background:#222732}
html[data-theme="dark"] .nav-dd-menu a:hover,html[data-theme="dark"] .nav-dd-menu a.active{background:#222732}
html[data-theme="dark"] .lang-toggle{background:#222732}
html[data-theme="dark"] .theme-switch{background:#222732}
html[data-theme="dark"] .theme-switch .knob{transform:translateX(0);background:#e8c15a}
html[data-theme="dark"] .theme-switch .knob::before{content:"🌙"}
.h1{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em;margin:6px 0 4px}
.intro{color:var(--muted);font-size:14.5px;max-width:760px;margin-bottom:6px}
.note{border-left:3px solid var(--blue);padding:6px 0 6px 14px;margin:12px 0 4px;color:var(--text);font-size:13px;max-width:820px}
.sgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:20px;margin-top:22px}
@media(max-width:720px){.sgrid{grid-template-columns:1fr}}
.scard{background:var(--card);border:1px solid var(--grid);border-radius:18px;padding:22px;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s,border-color .15s}
.scard:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(16,24,64,.16);border-color:var(--blue)}
.scard-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.scard-top .ico{font-size:26px}
.scard-top h2{font-size:20px;font-weight:800;color:var(--ink);margin:0;letter-spacing:-.02em}
.exp{margin-left:auto;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#a01457;background:#fde7ef;padding:3px 8px;border-radius:7px;white-space:nowrap}
html[data-theme="dark"] .exp{background:#3a1d2b;color:#f08bb4}
.scard p{color:var(--muted);font-size:13.5px;margin:0 0 16px;min-height:38px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:14px}
.metrics>div{background:var(--bg);border-radius:10px;padding:10px 8px;text-align:center}
html[data-theme="dark"] .metrics>div{background:var(--grid)}
.m-k{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:600;letter-spacing:.03em}
.m-v{display:block;font-size:18px;font-weight:800;color:var(--ink);margin-top:3px}
.m-v.win{color:var(--green)} .m-v.lose{color:var(--red)}
.m-sub{display:block;font-size:10.5px;color:var(--faint);margin-top:1px}
.scard-foot{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:6px;gap:10px;flex-wrap:wrap}
.stance{font-size:12.5px;font-weight:700;color:var(--text);background:var(--bg);border:1px solid var(--grid);border-radius:8px;padding:5px 10px}
html[data-theme="dark"] .stance{background:var(--grid)}
.go{font-weight:700;color:var(--blue);font-size:14px}
.foot{margin-top:40px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--faint);line-height:1.7;max-width:900px}
/* ===== China Mastermind Flagships — pinned, highlighted hero (byte-faithful copy of the US strategies.html hero) ===== */
.mm-hero{position:relative;margin:22px 0 8px;padding:20px 20px 22px;border-radius:20px;
  background:linear-gradient(var(--card),var(--card)) padding-box,linear-gradient(120deg,#1FA971,#285fff,#a855f7) border-box;
  border:1.5px solid transparent;box-shadow:0 10px 40px rgba(40,95,255,.10)}
html[data-theme="dark"] .mm-hero{box-shadow:0 14px 50px rgba(120,80,255,.18)}
.mm-hero-head{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.mm-pin{font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#fff;
  background:linear-gradient(120deg,#285fff,#a855f7);padding:4px 10px;border-radius:999px;animation:mm-pulse 2.6s ease-out infinite}
@keyframes mm-pulse{0%{box-shadow:0 0 0 0 rgba(168,85,247,.45)}70%{box-shadow:0 0 0 9px rgba(168,85,247,0)}100%{box-shadow:0 0 0 0 rgba(168,85,247,0)}}
.mm-title{font-size:20px;font-weight:800;letter-spacing:-.02em;
  background:linear-gradient(90deg,#1FA971,#285fff,#a855f7,#1FA971);background-size:300% 100%;
  -webkit-background-clip:text;background-clip:text;color:transparent;animation:mm-shimmer 9s linear infinite}
@keyframes mm-shimmer{to{background-position:300% 0}}
.mm-sub{color:var(--muted);font-size:13px}
.mm-hub-link{margin-left:auto;font-size:13px;font-weight:700;color:var(--blue);text-decoration:none;white-space:nowrap}
.mm-hub-link:hover{text-decoration:underline}
.mm-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
@media(max-width:760px){.mm-grid{grid-template-columns:1fr}}
.mm-card{position:relative;overflow:hidden;display:block;text-decoration:none;color:inherit;background:var(--bg);
  border:1px solid var(--grid);border-top:3px solid var(--accent);border-radius:16px;padding:18px 18px 16px;
  transition:transform .18s ease,box-shadow .18s ease,border-color .18s}
html[data-theme="dark"] .mm-card{background:var(--grid)}
.mm-card:hover{transform:translateY(-5px);box-shadow:0 16px 42px color-mix(in srgb,var(--accent) 32%,transparent)}
.mm-glow{position:absolute;inset:0;pointer-events:none;opacity:.45;transition:opacity .25s;
  background:radial-gradient(130px 90px at 82% -12%,color-mix(in srgb,var(--accent) 30%,transparent),transparent 72%)}
.mm-card:hover .mm-glow{opacity:1}
.mm-top{display:flex;align-items:center;gap:9px;margin-bottom:8px}
.mm-ico{font-size:22px}
.mm-prof{font-size:16px;font-weight:800;color:var(--ink)}
.mm-prof::after{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--accent);margin-left:8px;vertical-align:middle;box-shadow:0 0 8px var(--accent)}
.mm-cagr{font-size:34px;font-weight:800;color:var(--ink);line-height:1;letter-spacing:-.02em;display:flex;align-items:baseline;gap:8px}
.mm-cagr small{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.mm-bench{font-size:11.5px;color:var(--faint);margin:5px 0 10px}
.mm-bench b{color:var(--accent);font-weight:800}
.mm-meter{height:6px;border-radius:999px;background:linear-gradient(90deg,#1FA971,#e0a106,#a855f7);position:relative;margin:2px 2px 13px}
.mm-meter::after{content:"";position:absolute;top:50%;left:calc(var(--pos) * 100%);transform:translate(-50%,-50%);width:13px;height:13px;border-radius:50%;background:#fff;border:2.5px solid var(--accent);box-shadow:0 1px 4px rgba(0,0,0,.35)}
.mm-mets{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.mm-mets>div{text-align:center;background:var(--card);border-radius:9px;padding:7px 4px}
html[data-theme="dark"] .mm-mets>div{background:var(--bg)}
.mm-k{display:block;font-size:9.5px;color:var(--muted);text-transform:uppercase;font-weight:700;letter-spacing:.03em}
.mm-v{display:block;font-size:15px;font-weight:800;color:var(--ink);margin-top:2px}
.mm-d{display:block;font-size:9.5px;color:var(--faint)}
.mm-go{font-size:13px;font-weight:800;color:var(--accent)}
</style>{% include "_vector_polish.html.j2" %}
</head>
<body>
<div class="wrap">
  <div class="topbar">
      {% include "_navlinks.html.j2" %}
    <div class="nav-ctrls">
      <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
      <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
      <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
      <div class="lang-toggle" role="group" aria-label="Language">
        <span class="pill"></span>
        <span class="opt en-opt" data-l="en">EN</span>
        <span class="opt zh-opt" data-l="zh">中文</span>
      </div>
    </div>
  </div>

  <div class="h1">🎛️ {{ t('China Strategy Scorecards','中国策略记分卡') }}</div>
  <div class="intro">{{ t('Onshore China strategies with live stance, backtest and rule-book on each card.','中国境内策略卡片：实时立场、回测与规则手册。') }}</div>
  {% if masterminds %}
  <div class="mm-hero">
    <div class="mm-hero-head">
      <span class="mm-pin">★ {{ t('Pinned','置顶') }}</span>
      <span class="mm-title">🧠 {{ t('China Mastermind Flagships','中国操盘大师旗舰') }}</span>
      <span class="mm-sub">{{ t('Multi-asset active allocation · Mainland-investible · the flagship tier','多资产主动配置 · 境内可投 · 旗舰系列') }}</span>
    </div>
    <div class="mm-grid">
      {% for m in masterminds %}
      <a class="mm-card" href="{{ m.href }}" style="--accent:{{ m.accent }};--pos:{{ m.riskpos }}">
        <span class="mm-glow"></span>
        <div class="mm-top"><span class="mm-ico">{{ m.icon }}</span><span class="mm-prof">{{ t(m.profile_en, m.profile_zh) }}</span></div>
        <div class="mm-cagr">{{ m.cagr }}%<small>CAGR</small></div>
        <div class="mm-bench">{{ t('vs','对比') }} {{ t(m.bench_en, m.bench_zh) }} {{ m.hodl_cagr }}%{% if m.sharpe_mult %} · <b>{{ m.sharpe_mult }}× {{ t('its Sharpe','其夏普') }}</b>{% endif %}</div>
        <div class="mm-meter"></div>
        <div class="mm-mets">
          <div><span class="mm-k">Sharpe</span><span class="mm-v">{{ m.sharpe }}</span><span class="mm-d">{{ t('B&H','买持') }} {{ m.hodl_sharpe }}</span></div>
          <div><span class="mm-k">{{ t('Max DD','最大回撤') }}</span><span class="mm-v">{{ m.maxdd }}%</span><span class="mm-d">{{ t('B&H','买持') }} {{ m.hodl_maxdd }}%</span></div>
          <div><span class="mm-k">{{ t('Leverage','杠杆') }}</span><span class="mm-v">{{ m.gross_now }}x</span><span class="mm-d">{{ m.years }}y</span></div>
        </div>
        <div class="mm-go">{{ t('Open strategy','打开策略') }} →</div>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="note">{{ t('Honest framing: cash is mainly a drawdown control leg. Each card compares against CSI 300 buy-and-hold.','诚实说明：现金主要用于控制回撤。每张卡片都与沪深300买入持有对比。') }}</div>

  <div class="sgrid">
    {% for c in cards %}
    <a class="scard" href="{{ c.href }}">
      <div class="scard-top">
        <span class="ico">{{ c.icon }}</span>
        <h2>{{ t(c.name_en, c.name_zh) }}</h2>
        {% if c.experimental %}<span class="exp">⚗ {{ t('Experimental','实验性') }}</span>{% endif %}
      </div>
      <p>{{ t(c.thesis_en|truncate(125, true, '...'), c.thesis_zh|truncate(70, true, '...')) }}</p>
      <div class="metrics">
        <div><span class="m-k">CAGR</span><span class="m-v {{ 'win' if c.cagr >= c.hodl_cagr else 'lose' }}">{{ c.cagr }}%</span><span class="m-sub">{{ t('B&H','买持') }} {{ c.hodl_cagr }}%</span></div>
        <div><span class="m-k">Sharpe</span><span class="m-v {{ 'win' if c.sharpe >= c.hodl_sharpe else 'lose' }}">{{ c.sharpe }}</span><span class="m-sub">{{ t('B&H','买持') }} {{ c.hodl_sharpe }}</span></div>
        <div><span class="m-k">{{ t('Max DD','最大回撤') }}</span><span class="m-v {{ 'win' if c.maxdd >= c.hodl_maxdd else 'lose' }}">{{ c.maxdd }}%</span><span class="m-sub">{{ t('B&H','买持') }} {{ c.hodl_maxdd }}%</span></div>
        <div><span class="m-k">{{ t('Income','票息') }}</span><span class="m-v">{{ c.income }}%</span><span class="m-sub">{{ c.years }}y</span></div>
      </div>
      <div class="scard-foot">
        <span class="stance">{{ t(c.stance_en, c.stance_zh) }}</span>
        <span class="go">{{ t('Open →','打开 →') }}</span>
      </div>
    </a>
    {% endfor %}
  </div>

  <div class="foot">
    {{ t('Built', '生成于') }} {{ built }}<br>
    <span class="made">© 2026 Mastermind Inc</span>
  </div>
</div>
<script src="theme.js"></script>
</body></html>
