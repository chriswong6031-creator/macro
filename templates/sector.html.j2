  <div class="panel">
    <div class="topline">
      <h1>{{ td(s.name) }} <span class="muted">({{ s.fund }})</span></h1>
      <span class="state st-{{ s.ladder.state | replace(" ", "_") }}">{{ td(s.ladder.label) }}</span>
      {% if s.ladder.eq_badge %}<span class="eqbadge eq-{{ s.ladder.eq_dir }}">{{ t('Entry','入场') }} {{ s.ladder.eq_badge }} <span class="eqg">{{ td(s.ladder.eq_grade) }}</span></span>{{ help(s.ladder.eq_tip, s.ladder.eq_tip_zh) }}{% endif %}
      <span style="flex:1"></span>
      <span class="af-wrap">
        <button class="af-toggle" id="af-btn" type="button" aria-label="Toggle alert feed" aria-expanded="false" aria-controls="af-feed">🔔 <span>{{ t('Alerts','警报') }}</span>{% if alerts and alerts.n_recent %}<span class="af-badge">{{ alerts.n_recent }}</span>{% endif %} <span class="af-caret">▾</span></button>
        <div class="af-scrim" id="af-scrim"></div>
        <div class="af" id="af-feed" role="dialog" aria-label="Alerts" aria-hidden="true">
          <div class="af-bar"><span class="af-bar-t">🔔 {{ t('Alerts','警报') }}</span>
            <button class="af-x" id="af-close" type="button" aria-label="Close">✕</button></div>
          <div class="af-body">
            {% if alerts and alerts.pinned %}{% set p = alerts.pinned %}
            <div class="af-pin dir-{{ p.dir }}">
              <div class="af-pin-h"><span class="af-pin-tag">{{ t('Current signal','当前信号') }}</span>
                <span class="af-pin-title">{{ t(p.headline|e, p.headline_zh|e) }}</span></div>
              <p class="af-pin-d">{{ t(p.detail|e, p.detail_zh|e) }}</p>
            </div>{% endif %}
            {% if alerts and alerts.timeline %}
            <div class="af-filters">
              {% set flz = {'All':'全部','Signal':'信号','Trend':'趋势','Momentum':'动量','vs Market':'相对强弱','Cycle':'周期'} %}
              {% for f,lab in [('all','All'),('signal','Signal'),('trend','Trend'),('momentum','Momentum'),('strength','vs Market'),('cycle','Cycle')] %}
              <button class="aff {{ 'active' if f=='all' else '' }}" type="button" data-f="{{ f }}">{{ t(lab, flz[lab]) }}</button>{% endfor %}
            </div>
            {% for day in alerts.timeline %}
            <div class="af-day">
              <div class="af-date">{{ t(day.daylabel, day.daylabel_zh) }}</div>
              {% for ev in day.events %}
              <details class="af-item{{ ' pinned' if ev.pinned else '' }}" data-f="{{ ev.filter }}">
                <summary>
                  <span class="af-node dir-{{ ev.dir }}"></span>
                  <span class="af-chip f-{{ ev.filter }}">{{ t(ev.label, ev.label_zh) }}</span>
                  <span class="af-head">{{ t(ev.headline|e, ev.headline_zh|e) }}</span>
                </summary>
                <div class="af-detail">{{ t(ev.detail|e, ev.detail_zh|e) }}
                  {% if ev.edge %}<div class="af-edge"><b>{{ t('Edge:','优势：') }}</b> {{ t(ev.edge|e, ev.edge_zh|e) }}</div>{% endif %}
                  {% if ev.forward %}<div class="af-fwd">{{ t(ev.forward|e, ev.forward_zh|e) }}</div>{% endif %}
                </div>
              </details>
              {% endfor %}
            </div>
            {% endfor %}
            {% else %}
            <div class="af-empty">{{ t('No signal changes in the recent window — quiet on every tracked signal.','近期无信号变化 — 所有跟踪信号均平静。') }}</div>
            {% endif %}
          </div>
        </div>
      </span>
    </div>
    {% set e = s.ladder.entry %}
    {# ---- bold VERDICT: the action verb + tag + call, read in a glance ---- #}
    <div class="verdict urg-{{ e.urgency }}">
      <span class="v-act">{{ td(s.ladder.action) }}</span>
      <span class="v-tag">{{ td(e.tag) }}</span>
      <span class="v-text">{{ t(e.text, e.text_zh) }}</span>
    </div>
    {# ---- at-a-glance signal-chip strip (from the same tech/mtf/cycle data) ---- #}
    {% set tech = s.tech or {} %}{% set d = (s.mtf or {}).get('D') or {} %}
    <div class="sigstrip">
      {% set ab = tech.above200 %}
      <div class="sigchip {{ 'up' if ab else 'down' }}">
        <span class="sc-k">{{ t('Trend','趋势') }}</span>
        <span class="sc-v">{{ '▲' if ab else '▼' }} 200d</span>
        <span class="sc-s">{% if tech.pct_vs_200dma is not none %}{{ "%+.1f"|format(tech.pct_vs_200dma) }}%{% endif %}</span>
      </div>
      {% set mpos = d.macd_pos %}
      <div class="sigchip {{ 'up' if mpos else 'down' }}">
        <span class="sc-k">{{ t('Momentum','动量') }}</span>
        <span class="sc-v">MACD {{ '＋' if mpos else '－' }}{% if d.macd_cross_up %} ↑{% elif d.macd_cross_dn %} ↓{% endif %}</span>
        <span class="sc-s">{{ t('daily','日线') }}</span>
      </div>
      {% set r = tech.rsi14 %}
      <div class="sigchip {{ 'warn' if (r is not none and (r>=70 or r<=30)) else 'neutral' }}">
        <span class="sc-k">RSI</span>
        <span class="sc-v">{{ r|round(0)|int if r is not none else '—' }}</span>
        <span class="sc-s">{{ t('overbought','超买') if (r is not none and r>=70) else (t('oversold','超卖') if (r is not none and r<=30) else t('neutral','中性')) }}</span>
      </div>
      {% set sv = d.stoch %}
      <div class="sigchip {{ 'warn' if (sv is not none and (sv>=80 or sv<=20)) else 'neutral' }}">
        <span class="sc-k">Stoch</span>
        <span class="sc-v">{{ sv|round(0)|int if sv is not none else '—' }}</span>
        <span class="sc-s">{{ t('StochRSI','随机RSI') }}</span>
      </div>
      {% set dd = s.cycle.dc_day %}{% set band = s.cycle.dc_band %}
      <div class="sigchip {{ 'warn' if (dd is not none and band and dd >= band[0]) else 'neutral' }}">
        <span class="sc-k">{{ t('Cycle','周期') }}</span>
        <span class="sc-v">{{ t('Day','第') }} {{ dd }}</span>
        <span class="sc-s">{% if band %}{{ t('of','/') }} {{ band[0] }}–{{ band[1] }}{% endif %}</span>
      </div>
    </div>
    {% if s.ladder.age_line %}<p class="agewhen">{{ t(s.ladder.age_line, s.ladder.age_line_zh) }}</p>{% endif %}
    {% if s.ladder.early_note %}<p class="early">{{ t(s.ladder.early_note, s.ladder.early_note_zh) }}</p>{% endif %}
    {% if s.ladder.macro_line %}<p class="macro-caution">⚠ {{ t(s.ladder.macro_line, s.ladder.macro_line_zh) }}</p>{% endif %}
    <ul class="points">
      {% for p, pz in zip(s.ladder.points, s.ladder.points_zh) %}<li>{{ t(p, pz) }}</li>{% endfor %}
    </ul>
    {% set cp = s.ladder.cycle_plain %}
    <div class="cyclebox">
      <div><b>📅 {{ t(cp.daily_line, cp.daily_line_zh) }}</b> — {{ t(cp.daily_phase, cp.daily_phase_zh) }}
        {{ help("The DAILY cycle is the short rhythm — equities tend to bottom every ~36-42 trading days. 'Day N' counts trading days since the last daily low. Past ~42 (overdue) means a fresh low could come any day.", "日线周期是短节奏 — 股市通常每约 36-42 个交易日筑底一次。“第 N 天”指自上次日线低点以来的交易日数。超过约 42 天（已逾期）意味着新低随时可能出现。") }}</div>
      {% if cp.weekly_line %}<div><b>🗓 {{ t(cp.weekly_line, cp.weekly_line_zh) }}</b> — {{ t(cp.weekly_phase, cp.weekly_phase_zh) }}
        {{ help("The WEEKLY (investor) cycle is the bigger rhythm — ~16-26 weeks, containing several daily cycles. It sets the tide the daily cycles swim in; early weeks = more upside room, late weeks = treat rallies cautiously.", "周线（投资者）周期是更大的节奏 — 约 16-26 周，包含数个日线周期。它决定了日线周期所处的大势；早期周次=上行空间更大，晚期周次=对反弹保持谨慎。") }}</div>{% endif %}
      {% if cp.translation %}<div class="muted">{{ t(cp.translation, cp.translation_zh) }}</div>{% endif %}
    </div>
    {% if s.cycle.failed_cycle %}<p class="neg" style="margin:6px 0 0">⚠ {{ t('Failed cycle: price is below the low that started this cycle — historically the larger trend is rolling over in ~80% of such cases.', '周期失败：价格已跌破启动本周期的低点 — 历史上约 80% 的此类情形中，更大的趋势正在转向。') }}</p>{% endif %}
    <details style="margin-top:8px"><summary>{{ t('full reasoning', '完整推理') }}</summary>
      <p class="muted" style="margin:6px 0">{{ t(s.ladder.why, s.ladder.why_zh) }} {{ t('Next:', '下一步：') }} {{ t(s.ladder.next, s.ladder.next_zh) }}</p>
    </details>
  </div>

  <div class="panel">
    <h2>{{ t('Momentum across timeframes', '跨周期动量') }}
      {{ help("Daily / 3-day / weekly views of the same ETF. Weekly is the tide, 3-day the wave, daily the ripple — signals are strongest when all three agree. RSI & StochRSI gauges show oversold→overbought; the MACD bars show momentum's trajectory and the estimated days to its next cross.", "同一只 ETF 的日线／3 日／周线视角。周线是潮汐，3 日是波浪，日线是涟漪 — 三者一致时信号最强。RSI 与 StochRSI 表盘显示超卖→超买；MACD 柱状图显示动量轨迹及距下次交叉的预估天数。") }}
    </h2>
    <div data-mtf='{{ s.mtf_json }}'></div>
  </div>

  <div class="panel">
    <h2>{{ t('Chart', '图表') }}</h2>
    <div class="tv">
      <div class="tradingview-widget-container">
        <div id="tv_main"></div>
        <script src="https://s3.tradingview.com/tv.js"></script>
        <script>new TradingView.widget({"container_id":"tv_main","symbol":"{{ s.fund }}","interval":"D","theme":(localStorage.getItem('theme')==='light'?'light':'dark'),"style":"1","height":440,"width":"100%","hide_side_toolbar":true,"allow_symbol_change":true,"studies":["RSI@tv-basicstudies","MACD@tv-basicstudies"]});</script>
      </div>
    </div>
  </div>

  {% if s.accumulation %}
  <div class="panel" id="accumulation">
    <h2>{{ t('🐳 Accumulation watch — weight change beyond price', '🐳 增持监测 — 超越价格的权重变动') }}
      {{ help("Each top-10 holding's weight change since the prior snapshot, split into the part explained by the stock's own price move and a residual ('active' = weight beyond price). A large positive residual = real buying flowed in beyond market drift. HONEST CAVEAT: this is a PASSIVE index fund, so the residual is index reconstitution / float-weight flow (forced buying), NOT discretionary manager conviction. ✅ = accumulation that also has a forming technical buy setup. Thresholds uncalibrated until more snapshots accumulate.", "每只前十大持仓自上一快照以来的权重变动，被拆分为“由个股自身价格变动解释的部分”与“残差”（“主动”=超越价格的权重）。较大的正残差=除市场漂移外确有真实买盘流入。诚实提示：这是被动指数基金，故残差代表指数再平衡／流通权重调整带来的资金流（强制买入），并非主动经理的信念。✅=增持同时出现正在形成的技术买入形态。在积累更多快照前阈值未校准。") }}
    </h2>
    <table>
      <tr>
        <th class="l">{{ t('stock', '个股') }}</th>
        <th>{{ t('weight', '权重') }}</th>
        <th>{{ t('raw Δ', '原始Δ') }}</th>
        <th>{{ t('active Δ', '主动Δ') }}</th>
        <th>{{ t('active %', '主动%') }}</th>
        <th class="l">{{ t('technical', '技术面') }}</th>
      </tr>
      {% for a in s.accumulation %}
      <tr>
        <td class="l"><a href="../stock.html#{{ a.ticker }}"><b>{{ a.ticker }}</b></a> <span class="muted">{{ a.name }}</span></td>
        <td class="muted">{{ "%.2f" | format(a.w1) }}%</td>
        <td class="{{ 'pos' if a.raw_change >= 0 else 'neg' }}">{{ "%+.2f" | format(a.raw_change) }}pp</td>
        <td class="{{ 'pos' if a.active_change >= 0 else 'neg' }}"><b>{{ "%+.2f" | format(a.active_change) }}pp</b></td>
        <td class="{{ 'pos' if (a.active_pct or 0) >= 0 else 'neg' }}">{% if a.active_pct is not none %}{{ "%+.0f" | format(a.active_pct) }}%{% else %}—{% endif %}</td>
        <td class="l">{% if a.ladder %}<span class="state st-{{ a.ladder.state | replace(' ', '_') }}">{{ td(a.ladder.label) }}</span>{% if a.confirmed %} ✅{% endif %}{% else %}<span class="muted">—</span>{% endif %}{% if a.vol and a.vol.surging %} <span title="volume {{ a.vol.ratio }}× recent avg">📊</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted" style="font-size:12px;margin-top:8px">{{ t('Window: prior snapshot → latest. “Active Δ” strips out price action; on this passive ETF it reflects index reconstitution / float-weight flow, not a manager’s discretion.', '窗口：上一快照 → 最新快照。“主动Δ”已剔除价格变动；在该被动 ETF 上反映的是指数再平衡／流通权重调整带来的资金流，而非经理人的主动决策。') }}</p>
  </div>
  {% endif %}

  {% if s.alpha_leaders %}
  <div class="panel" id="alpha-leaders">
    <h2>{{ t('Alpha leaders — strongest stock-specific momentum in the sector', '阿尔法领跑 — 板块内最强个股动量') }}
      {{ help("Each stock's return with its MARKET and SECTOR beta removed — sector-neutral residual momentum over a 12-1-month window. It ranks the names pulling ahead of their OWN sector on stock-specific strength, not just riding the sector tide. 'idio ann' is the annualized idiosyncratic (beta-stripped) return; the entry tag flags a leader that just spiked ('extended' = short-term reversal risk) vs one on a recent dip ('pullback' = constructive entry). Phase-0 validated as a MODEST, regime-decayed edge — context, not a buy list (research/RESIDUAL_ALPHA_MOMENTUM.md).", "每只股票剔除其市场与板块贝塔后的收益 —— 12-1 个月的板块中性残差动量。它排出在个股特定强度上领先于自身板块、而非仅随板块上涨的股票。“年化残差”为年化的特异（剔除贝塔）收益；入场标签标记刚急涨的领跑股（“extended”=短期反转风险）与近期回调者（“pullback”=较佳入场）。第 0 阶段验证为温和、随周期衰减的优势 —— 仅供参考，而非买入清单。") }}
    </h2>
    <table>
      <tr>
        <th class="l">{{ t('stock','个股') }}</th>
        <th>{{ t('alpha z','阿尔法 z') }}</th>
        <th>{{ t('sector rank','板块排名') }}</th>
        <th>{{ t('idio ann','年化残差') }}</th>
        <th>{{ t('1-mo','近一月') }}</th>
        <th class="l">{{ t('entry','入场') }}</th>
      </tr>
      {% for a in s.alpha_leaders %}
      <tr>
        <td class="l"><a href="../stock.html#{{ a.ticker }}"><b>{{ a.ticker }}</b></a> <span class="muted">{{ a.name }}</span></td>
        <td><b class="pos">{% if a.alpha is not none %}{{ "%+.2f"|format(a.alpha) }}{% else %}—{% endif %}</b></td>
        <td class="muted">{{ a.sector_rank }}/{{ a.sector_n }}</td>
        <td class="{{ 'pos' if (a.resid_ann or 0) >= 0 else 'neg' }}">{% if a.resid_ann is not none %}{{ "%+.0f"|format(a.resid_ann) }}%{% else %}—{% endif %}</td>
        <td class="{{ 'pos' if (a.rev_1m or 0) >= 0 else 'neg' }}">{% if a.rev_1m is not none %}{{ "%+.1f"|format(a.rev_1m) }}%{% else %}—{% endif %}</td>
        <td class="l">{% if a.entry %}<span class="alpha-entry ae-{{ a.entry }}">{{ a.entry }}</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted" style="font-size:12px;margin-top:8px">{{ t('Sector-neutral residual momentum — a modest, regime-decayed edge measured over 1962–2026 (research/RESIDUAL_ALPHA_MOMENTUM.md). Stock-selection context within the sector, not a standalone buy list.', '板块中性残差动量 —— 基于 1962–2026 测得的温和、随周期衰减的优势。用于板块内选股的参考，而非独立买入清单。') }}</p>
  </div>
  {% endif %}

  <div class="panel">
    <h2>{{ t('Top 10 holdings — each analyzed on its own cycle', '前 10 大持仓 — 各自按其周期分析') }}
      {{ help("Every holding gets the same treatment as the ETF: daily-cycle position, multi-timeframe momentum, and a ladder state. The states carry measured base rates (table at the bottom). Weight = % of the ETF this stock represents — the top names drive the fund.", "每只持仓都与 ETF 同样处理：日线周期位置、跨周期动量及阶梯状态。各状态附有实测基准胜率（见底部表格）。权重=该股票占 ETF 的百分比 — 前几大成分股主导基金走势。") }}
    </h2>
    {% for h in s.holdings %}
    <div class="card">
      <div class="topline">
        <a href="../stock.html#{{ h.ticker }}"><b style="font-size:15px">{{ h.ticker }}</b></a>
        <span class="muted">{{ h.name }}</span>
        <span class="muted">{{ h.weight_pct }}%{{ t(' of fund', ' 占基金') }}</span>
        <span class="state st-{{ h.ladder.state | replace(" ", "_") }}">{{ td(h.ladder.label) }}</span>
        <span class="urgpill urg-{{ h.ladder.entry.urgency }}">{{ td(h.ladder.entry.tag) }}{% if h.ladder.entry.days_hi and h.ladder.entry.urgency == 'imminent' %} ~{{ h.ladder.entry.days_hi }}d{% endif %}</span>
        {% if h.ladder.age_short %}<span class="agechip" title="when this signal last crossed">⏱ {{ t(h.ladder.age_short, h.ladder.age_short_zh) }}</span>{% endif %}
        {% if h.ladder.eq_badge %}<span class="eqbadge sm eq-{{ h.ladder.eq_dir }}" title="{{ h.ladder.eq_tip }}">{{ h.ladder.eq_badge }}</span>{% endif %}
        <span style="flex:1"></span>
        <span class="muted" style="font-size:12px">{{ t('daily cycle day', '日线周期第') }} {{ h.cycle.dc_day }}/~{{ h.cycle.dc_band[1] }}{{ t('', ' 天') }}</span>
      </div>
      <ul class="points sm">
        {% for p, pz in zip(h.ladder.points[:3], h.ladder.points_zh[:3]) %}<li>{{ t(p, pz) }}</li>{% endfor %}
      </ul>
      {% if h.ladder.early_note %}<p class="early">{{ t(h.ladder.early_note, h.ladder.early_note_zh) }}</p>{% endif %}
      {% if h.ladder.macro_line %}<p class="macro-caution">⚠ {{ t(h.ladder.macro_line, h.ladder.macro_line_zh) }}</p>{% endif %}
      {% if h.fundamentals and (h.fundamentals.fwd_pe or h.fundamentals.rev_growth) %}
      <p class="muted" style="font-size:12px; margin:4px 0">{% if h.fundamentals.fwd_pe %}{{ t('fwd P/E', '预期市盈率') }} <b>{{ h.fundamentals.fwd_pe | round(1) }}</b>{% endif %}{% if h.fundamentals.rev_growth %} · {{ t('rev growth', '营收增长') }} <b>{{ (h.fundamentals.rev_growth * 100) | round(1) }}%</b>{% endif %}{% if h.fundamentals.profit_margin %} · {{ t('margin', '利润率') }} <b>{{ (h.fundamentals.profit_margin * 100) | round(0) }}%</b>{% endif %} {{ help("Best-effort weekly valuation snapshot from free sources — LOW CONFIDENCE, rough context only.", "来自免费数据源的尽力而为的每周估值快照 — 低可信度，仅供粗略参考。") }}</p>
      {% endif %}
      <div data-mtf='{{ h.mtf_json }}'></div>
      <details style="margin-top:6px"><summary>{{ t('full reasoning', '完整推理') }}</summary>
        <p class="muted" style="margin:5px 0">{{ t(h.ladder.why, h.ladder.why_zh) }} {{ t('Next:', '下一步：') }} {{ t(h.ladder.next, h.ladder.next_zh) }}</p>
      </details>
    </div>
    {% endfor %}
  </div>

  <div class="panel">
    <h2>{{ t('How much to trust these states — measured, not promised', '这些状态有多可信 — 实测得出，而非承诺') }}
      {{ help("Every trading day since 2000, across sector ETFs and large stocks, we computed the same ladder state from data available at the time and measured what price did over the next month. These are those base rates. They are tendencies with real spread around them — position sizing beats certainty.", "自 2000 年以来的每个交易日，针对各行业 ETF 与大型股票，我们用当时可得的数据计算出相同的阶梯状态，并测量此后一个月的价格表现。以下即为这些基准胜率。它们是带有实际离散度的倾向 — 仓位管理胜过确定性。") }}
    </h2>
    {% if calibration %}
    <table>
      <tr><th>{{ t('state', '状态') }}</th><th>{{ t('samples', '样本数') }}</th><th>{{ t('up next month', '下月上涨') }}</th><th>{{ t('avg next month', '下月均值') }}</th></tr>
      {% for st in ladder_order %}{% if calibration.get(st) %}
      <tr>
        <td><span class="state st-{{ st | replace(" ", "_") }}">{{ td(state_display[st].label) }} · {{ td(state_display[st].action) }}</span></td>
        <td>{{ calibration[st].n }}</td>
        <td>{{ calibration[st].hit_pct }}%</td>
        <td class="{{ 'pos' if calibration[st].avg_fwd_pct > 0 else 'neg' }}">{{ "%+.2f" | format(calibration[st].avg_fwd_pct) }}%</td>
      </tr>
      {% endif %}{% endfor %}
    </table>
    <p style="margin:10px 0 0"><b>{{ t('Read the table before trusting any state.', '相信任何状态之前，先读这张表。') }}</b>
      <span class="muted"><span class="l-en">What it shows: stocks drift up over a month from EVERY state
      (that's the market's long upward bias), the spread between states is small, and the
      "scary" states measured slightly BETTER forward returns than the buy states —
      markets mean-revert, and waiting for full confirmation costs part of the bounce.
      So use the ladder for <b>structure</b>: where you are in the cycle, what would
      confirm a turn, and exactly where you're wrong (the invalidation price) — and use
      position size, not certainty, to express conviction. It is not a return predictor,
      and the table proves we checked.</span><span class="l-zh">它说明了什么：从每一种状态出发，股票在一个月内平均都会上行
      （这是市场长期的向上偏向），各状态之间的差距很小，而那些“吓人”的状态实测的远期收益
      反而略优于买入状态 — 市场会均值回归，等待完全确认会损失一部分反弹。
      所以请把阶梯用于<b>结构判断</b>：你处于周期的哪个位置、什么信号能确认转向，
      以及你在哪里就错了（失效价位）— 然后用仓位大小、而非确定性来表达信念。
      它不是收益预测器，这张表正证明我们核查过了。</span></span></p>
    {% if calibration.get("BOTTOM WATCH +early-bull") and calibration.get("BOTTOM WATCH no-early") %}
    {% set ew = calibration["BOTTOM WATCH +early-bull"] %}{% set nw = calibration["BOTTOM WATCH no-early"] %}
    <p class="early" style="margin-top:10px">⚡ <span class="l-en"><b>Do the early (pre-emptive) signals actually help?</b>
      We measured it the same way. When a "nearing a low" reading ALSO had an early bullish signal
      (RSI divergence / histogram turning / StochRSI pop), the next month was up
      <b>{{ ew.hit_pct }}%</b> of the time (avg {{ "%+.2f" | format(ew.avg_fwd_pct) }}%, n={{ ew.n }}) —
      versus <b>{{ nw.hit_pct }}%</b> (avg {{ "%+.2f" | format(nw.avg_fwd_pct) }}%, n={{ nw.n }}) without one.
      So on average the early signals did <b>not</b> beat simply waiting — they fire sooner and catch the
      occasional sharp V-bottom, but at a higher false-alarm rate. Use them to know <i>when to pay
      attention</i>, then still require confirmation before committing. That's the honest tradeoff,
      measured rather than assumed.</span><span class="l-zh"><b>这些提前（预判）信号真的有用吗？</b>
      我们用同样的方法做了测量。当一次“接近低点”的读数同时伴有提前的看多信号
      （RSI 背离／柱状图转向／StochRSI 跳升）时，此后一个月上涨的概率为
      <b>{{ ew.hit_pct }}%</b>（均值 {{ "%+.2f" | format(ew.avg_fwd_pct) }}%，n={{ ew.n }}）—
      而没有此信号时为 <b>{{ nw.hit_pct }}%</b>（均值 {{ "%+.2f" | format(nw.avg_fwd_pct) }}%，n={{ nw.n }}）。
      所以平均而言，提前信号并<b>未</b>胜过单纯等待 — 它们触发更早，能抓住偶尔出现的尖锐 V 型底，
      但误报率也更高。用它们来判断<i>何时该留意</i>，然后在投入之前仍需要确认。
      这就是诚实的取舍 — 实测得出，而非臆断。</span></p>
    {% endif %}
    {% else %}<p class="muted">{{ t('Calibration pending — regenerates with the weekly run.', '校准待定 — 将随每周运行重新生成。') }}</p>{% endif %}
    <p class="muted" style="font-size:12px"><span class="l-en">Cycle methodology after graddhy.com / thefinancialtap.com: equity daily cycles
       typically run 36-42 trading days trough-to-trough; timing bands catch roughly 70% of lows, so ~3 in 10 arrive
       early or late — that's why confirmation (swing low, 10-day average) gates every buy state. Charts by TradingView.</span><span class="l-zh">周期方法论参考 graddhy.com / thefinancialtap.com：股票日线周期
       通常为 36-42 个交易日（谷底到谷底）；时间窗能捕捉约 70% 的低点，故约十分之三会提前或滞后出现 —
       这正是为何每个买入状态都以确认（摆动低点、10 日均线）为前提。图表由 TradingView 提供。</span></p>
  </div>

<script>
/* alert feed: floating popover (grows out of the 🔔 button, overlays the page)
   + filter chips */
(function(){
  var btn=document.getElementById('af-btn'), feed=document.getElementById('af-feed'),
      scrim=document.getElementById('af-scrim'), x=document.getElementById('af-close');
  function place(){
    // phone (≤560) is a CSS bottom-sheet — clear any desktop inline pinning
    if(window.matchMedia('(max-width: 560px)').matches){
      feed.style.left=feed.style.top=feed.style.right=feed.style.transformOrigin=''; return;
    }
    var b=btn.getBoundingClientRect(), pw=feed.offsetWidth||470, m=10;
    var left=Math.min(b.right-pw, window.innerWidth-m-pw);
    if(left<m) left=m;
    feed.style.left=left+'px'; feed.style.right='auto';
    feed.style.top=(b.bottom+9)+'px';
    feed.style.transformOrigin=Math.max(14,Math.min(pw-14,(b.left+b.right)/2-left))+'px top';
  }
  function set(open){
    feed.classList.toggle('af-open',open);
    if(scrim) scrim.classList.toggle('af-open',open);
    btn.setAttribute('aria-expanded',open?'true':'false');
    feed.setAttribute('aria-hidden',open?'false':'true');
  }
  function open(){ place(); set(true); document.addEventListener('keydown',onKey);
    window.addEventListener('scroll',close); window.addEventListener('resize',close); }
  function close(){ set(false); document.removeEventListener('keydown',onKey);
    window.removeEventListener('scroll',close); window.removeEventListener('resize',close); }
  function onKey(e){ if(e.key==='Escape'||e.key==='Esc') close(); }
  if(btn&&feed){
    btn.addEventListener('click',function(){ feed.classList.contains('af-open')?close():open(); });
    if(x) x.addEventListener('click',close);
    if(scrim) scrim.addEventListener('click',close);
  }
  var fil=document.querySelectorAll('.aff'), items=document.querySelectorAll('.af-item');
  fil.forEach(function(b){b.addEventListener('click',function(){
    fil.forEach(function(x){x.classList.remove('active')}); b.classList.add('active');
    var f=b.dataset.f;
    items.forEach(function(it){ it.hidden=!(f==='all'||it.dataset.f===f); });
    document.querySelectorAll('.af-day').forEach(function(dd){
      var any=[].slice.call(dd.querySelectorAll('.af-item')).some(function(i){return !i.hidden});
      dd.style.display=any?'':'none';
    });
  });});
})();
</script>
