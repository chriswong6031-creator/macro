{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.name }} ({{ s.fund }}) — cycle & holdings</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="../theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1200px)/2)); } }
  .early { margin:6px 0; padding:8px 12px; border-radius:8px;
           background:color-mix(in srgb, var(--g-cold) 14%, var(--panel2));
           border-left:3px solid var(--g-cold); font-size:13px; }
  .macro-caution { margin:6px 0; padding:8px 12px; border-radius:8px;
           background:color-mix(in srgb, var(--down) 10%, var(--panel2));
           border-left:3px solid var(--down); font-size:13px; }
  .agewhen { margin:6px 0; padding:7px 11px; border-radius:8px; background:var(--panel2);
             border-left:3px solid var(--link); font-size:13px; color:var(--text); }
  .agechip { font-size:11px; font-weight:700; padding:2px 7px; border-radius:9px;
             background:var(--panel); color:var(--muted); border:1px solid var(--line);
             white-space:nowrap; }
  .eqbadge { display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
             border-radius:11px; font-size:12.5px; font-weight:700; white-space:nowrap;
             border:1px solid var(--line); }
  .eqbadge.sm { font-size:11px; padding:2px 7px; border-radius:9px; }
  .eqbadge .eqg { font-weight:500; opacity:.8; }
  .eqbadge.eq-up { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
                   border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .eqbadge.eq-down { background:color-mix(in srgb,var(--down) 16%,transparent); color:var(--down);
                     border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .eqbadge.eq-flat { background:var(--panel2); color:var(--muted); }
  .alpha-entry { font-size:11px; font-weight:700; padding:2px 8px; border-radius:9px;
                 text-transform:capitalize; border:1px solid var(--line); white-space:nowrap; }
  .ae-pullback { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
                 border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .ae-extended { background:color-mix(in srgb,var(--warn) 22%,transparent); color:var(--text);
                 border-color:color-mix(in srgb,var(--warn) 55%,transparent); }
  .ae-intact { background:color-mix(in srgb,var(--link) 14%,transparent); color:var(--link); }
  .ae-laggard,.ae-neutral { background:var(--panel); color:var(--muted); }
  /* entry call bar + urgency colors */
  .entrybar { display:flex; gap:10px; align-items:flex-start; margin:10px 0 8px;
              padding:9px 12px; border-radius:9px; background:var(--panel2);
              border-left:4px solid var(--muted); font-size:14px; }
  .entrytag { font-weight:800; font-size:12px; letter-spacing:.04em; white-space:nowrap;
              padding:3px 9px; border-radius:7px; }
  .urgpill { font-weight:700; font-size:11px; padding:2px 8px; border-radius:9px; }
  .urg-now .entrytag, .urgpill.urg-now { background:var(--up); color:#fff; }
  .urg-now { border-left-color:var(--up); }
  .urg-imminent .entrytag, .urgpill.urg-imminent { background:var(--g-cold); color:#fff; }
  .urg-imminent { border-left-color:var(--g-cold); }
  .urg-soon .entrytag, .urgpill.urg-soon { background:color-mix(in srgb,var(--g-cold) 30%,var(--panel)); color:var(--text); }
  .urg-soon { border-left-color:var(--g-cold); }
  .urg-hold .entrytag, .urgpill.urg-hold { background:var(--panel); color:var(--muted); border:1px solid var(--line); }
  .urg-hold { border-left-color:var(--muted); }
  .urg-later .entrytag, .urgpill.urg-later { background:var(--panel); color:var(--muted); border:1px solid var(--line); }
  .urg-later { border-left-color:var(--muted); }
  .urg-caution .entrytag, .urgpill.urg-caution { background:var(--warn); color:#1a1a1a; }
  .urg-caution { border-left-color:var(--warn); }
  .urg-exit .entrytag, .urgpill.urg-exit { background:var(--down); color:#fff; }
  .urg-exit { border-left-color:var(--down); }
  .urg-avoid .entrytag, .urgpill.urg-avoid { background:color-mix(in srgb,var(--down) 30%,var(--panel)); color:var(--text); }
  .urg-avoid { border-left-color:var(--down); }
  .points { margin:6px 0; padding-left:18px; } .points li { margin:2px 0; }
  .points.sm { font-size:12.5px; }
  .cyclebox { margin:8px 0; padding:9px 12px; border-radius:9px; background:var(--panel2);
              font-size:13px; line-height:1.6; }
  a { text-decoration:none; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; color:var(--muted); text-transform:uppercase;
       letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); }
  .state { display:inline-block; padding:2px 11px; border-radius:12px; font-weight:700;
           font-size:12.5px; }
  .card { background:var(--panel2); border:1px solid var(--line); border-radius:10px;
          padding:12px 14px; margin:10px 0; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px;
          height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted);
          font-size:10px; font-weight:600; cursor:help; position:relative;
          vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%;
               transform:translateX(-50%); width:300px; background:var(--panel);
               border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60;
               font-size:12px; line-height:1.45; color:var(--text); font-weight:400;
               box-shadow:var(--popover-shadow); pointer-events:none; }
  .help:hover .tip { display:block; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:left; padding:4px 8px; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:500; }
  .tv { margin-top:8px; overflow:hidden; }
  details summary { cursor:pointer; color:var(--link); font-size:12.5px; margin-top:6px; }
</style>
</head>
