{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ s.name }} ({{ s.fund }}) — cycle & holdings</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="../theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1200px)/2)); } }
  .early { margin:6px 0; padding:8px 12px; border-radius:8px;
           background:color-mix(in srgb, var(--g-cold) 14%, var(--panel2));
           border-left:3px solid var(--g-cold); font-size:13px; }
  .macro-caution { margin:6px 0; padding:8px 12px; border-radius:8px;
           background:color-mix(in srgb, var(--down) 10%, var(--panel2));
           border-left:3px solid var(--down); font-size:13px; }
  .shock-deesc-banner { margin:10px 0; padding:10px 14px; border-radius:8px;
           background:color-mix(in srgb, var(--warn) 15%, var(--panel2));
           border-left:4px solid var(--warn); font-size:13px; font-weight:600; }
  .agewhen { margin:6px 0; padding:7px 11px; border-radius:8px; background:var(--panel2);
             border-left:3px solid var(--link); font-size:13px; color:var(--text); }
  .agechip { font-size:11px; font-weight:700; padding:2px 7px; border-radius:9px;
             background:var(--panel); color:var(--muted); border:1px solid var(--line);
             white-space:nowrap; }
  .eqbadge { display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
             border-radius:11px; font-size:12.5px; font-weight:700; white-space:nowrap;
             border:1px solid var(--line); }
  .eqbadge.sm { font-size:11px; padding:2px 7px; border-radius:9px; }
  .eqbadge .eqg { font-weight:500; opacity:.8; }
  .eqbadge.eq-up { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
                   border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .eqbadge.eq-down { background:color-mix(in srgb,var(--down) 16%,transparent); color:var(--down);
                     border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .eqbadge.eq-flat { background:var(--panel2); color:var(--muted); }
  .alpha-entry { font-size:11px; font-weight:700; padding:2px 8px; border-radius:9px;
                 text-transform:capitalize; border:1px solid var(--line); white-space:nowrap; }
  .ae-pullback { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
                 border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .ae-extended { background:color-mix(in srgb,var(--warn) 22%,transparent); color:var(--text);
                 border-color:color-mix(in srgb,var(--warn) 55%,transparent); }
  .ae-intact { background:color-mix(in srgb,var(--link) 14%,transparent); color:var(--link); }
  .ae-laggard,.ae-neutral { background:var(--panel); color:var(--muted); }
  /* entry call bar + urgency colors */
  .entrybar { display:flex; gap:10px; align-items:flex-start; margin:10px 0 8px;
              padding:9px 12px; border-radius:9px; background:var(--panel2);
              border-left:4px solid var(--muted); font-size:14px; }
  .entrytag { font-weight:800; font-size:12px; letter-spacing:.04em; white-space:nowrap;
              padding:3px 9px; border-radius:7px; }
  .urgpill { font-weight:700; font-size:11px; padding:2px 8px; border-radius:9px; }
  .urg-now .entrytag, .urgpill.urg-now { background:var(--up); color:#fff; }
  .urg-now { border-left-color:var(--up); }
  .urg-imminent .entrytag, .urgpill.urg-imminent { background:var(--g-cold); color:#fff; }
  .urg-imminent { border-left-color:var(--g-cold); }
  .urg-soon .entrytag, .urgpill.urg-soon { background:color-mix(in srgb,var(--g-cold) 30%,var(--panel)); color:var(--text); }
  .urg-soon { border-left-color:var(--g-cold); }
  .urg-hold .entrytag, .urgpill.urg-hold { background:var(--panel); color:var(--muted); border:1px solid var(--line); }
  .urg-hold { border-left-color:var(--muted); }
  .urg-later .entrytag, .urgpill.urg-later { background:var(--panel); color:var(--muted); border:1px solid var(--line); }
  .urg-later { border-left-color:var(--muted); }
  .urg-caution .entrytag, .urgpill.urg-caution { background:var(--warn); color:#1a1a1a; }
  .urg-caution { border-left-color:var(--warn); }
  .urg-exit .entrytag, .urgpill.urg-exit { background:var(--down); color:#fff; }
  .urg-exit { border-left-color:var(--down); }
  .urg-avoid .entrytag, .urgpill.urg-avoid { background:color-mix(in srgb,var(--down) 30%,var(--panel)); color:var(--text); }
  .urg-avoid { border-left-color:var(--down); }
  /* glance-level two-timeframe synthesis sentence, sits right under the verdict */
  .synthesis { margin:8px 0 4px; padding:9px 13px; border-radius:9px; font-size:13.5px; line-height:1.5;
               background:color-mix(in srgb, var(--link) 9%, var(--panel2)); border-left:3px solid var(--link); }
  /* context-indicator chip: factual extreme, NOT an alarm — neutral so it can't compete with the verdict */
  .sigchip.ctx { border-color:var(--line); }
  .sigchip.ctx .sc-v, .sigchip.ctx .sc-s { color:var(--muted); }
  .sigstrip-label { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; margin:8px 0 4px; }
  .points { margin:6px 0; padding-left:18px; } .points li { margin:2px 0; }
  .points.sm { font-size:12.5px; }
  .cyclebox { margin:8px 0; padding:9px 12px; border-radius:9px; background:var(--panel2);
              font-size:13px; line-height:1.6; }
  a { text-decoration:none; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; color:var(--muted); text-transform:uppercase;
       letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); }
  .state { display:inline-block; padding:2px 11px; border-radius:12px; font-weight:700;
           font-size:12.5px; }
  .card { background:var(--panel2); border:1px solid var(--line); border-radius:10px;
          padding:12px 14px; margin:10px 0; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px;
          height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted);
          font-size:10px; font-weight:600; cursor:help; position:relative;
          vertical-align:middle; margin-left:5px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%;
               transform:translateX(-50%); width:300px; background:var(--panel);
               border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60;
               font-size:12px; line-height:1.45; color:var(--text); font-weight:400;
               box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto;
               max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:left; padding:4px 8px; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:500; }
  .tv { margin-top:8px; overflow:hidden; }
  details summary { cursor:pointer; color:var(--link); font-size:12.5px; margin-top:6px; }
</style>
</head>
<body>
{# NOTE: sector pages render under site/sectors/, one level deep — every nav link
   MUST be ../-prefixed (like ../theme.css above), or it 404s as /sectors/<page>. #}
<nav class="site-nav">
    {% set nav_prefix = '../' %}
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="../mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>
{# ---- Policy-Shock de-escalation banner (PS-R3: display de-escalation only — no reordering, no sizing) ---- #}
{% if shock_state is defined and shock_state and shock_state.get('active') %}
<div class="shock-deesc-banner">⚠ <span class="l-en">SHOCK — ranks computed on pre-shock data; discount until {{ shock_state.get('expires', '') }}.</span><span class="l-zh">冲击 — 排名依据冲击前数据计算；有效期至 {{ shock_state.get('expires', '') }}，届前请酌情折扣。</span></div>
{% endif %}
  <div class="panel">
    <div class="topline">
      <h1>{{ td(s.name) }} <span class="muted">({{ s.fund }})</span></h1>
      <span class="state st-{{ s.ladder.state | replace(" ", "_") }}">{{ td(s.ladder.label) }}</span>
      {% if s.ladder.eq_badge %}<span class="eqbadge eq-{{ s.ladder.eq_dir }}">{{ t('Entry','入场') }} {{ s.ladder.eq_badge }} <span class="eqg">{{ td(s.ladder.eq_grade) }}</span></span>{{ help(s.ladder.eq_tip, s.ladder.eq_tip_zh) }}{% endif %}
      <span style="flex:1"></span>
      <span class="af-wrap">
        <button class="af-toggle" id="af-btn" type="button" aria-label="Toggle alert feed" aria-expanded="false" aria-controls="af-feed">🔔 <span>{{ t('Alerts','警报') }}</span>{% if alerts and alerts.n_recent %}<span class="af-badge">{{ alerts.n_recent }}</span>{% endif %} <span class="af-caret">▾</span></button>
        <div class="af-scrim" id="af-scrim"></div>
        <div class="af" id="af-feed" role="dialog" aria-label="Alerts" aria-hidden="true">
          <div class="af-bar"><span class="af-bar-t">🔔 {{ t('Alerts','警报') }}</span>
            <button class="af-x" id="af-close" type="button" aria-label="Close">✕</button></div>
          <div class="af-body">
            {% if alerts and alerts.pinned %}{% set p = alerts.pinned %}
            <div class="af-pin dir-{{ p.dir }}">
              <div class="af-pin-h"><span class="af-pin-tag">{{ t('Current signal','当前信号') }}</span>
                <span class="af-pin-title">{{ t(p.headline|e, p.headline_zh|e) }}</span></div>
              <p class="af-pin-d">{{ t(p.detail|e, p.detail_zh|e) }}</p>
            </div>{% endif %}
            {% if alerts and alerts.timeline %}
            <div class="af-filters">
              {% set flz = {'All':'全部','Signal':'信号','Trend':'趋势','Momentum':'动量','vs Market':'相对强弱','Cycle':'周期'} %}
              {% for f,lab in [('all','All'),('signal','Signal'),('trend','Trend'),('momentum','Momentum'),('strength','vs Market'),('cycle','Cycle')] %}
              <button class="aff {{ 'active' if f=='all' else '' }}" type="button" data-f="{{ f }}">{{ t(lab, flz[lab]) }}</button>{% endfor %}
            </div>
            {% for day in alerts.timeline %}
            <div class="af-day">
              <div class="af-date">{{ t(day.daylabel, day.daylabel_zh) }}</div>
              {% for ev in day.events %}
              <details class="af-item{{ ' pinned' if ev.pinned else '' }}" data-f="{{ ev.filter }}">
                <summary>
                  <span class="af-node dir-{{ ev.dir }}"></span>
                  <span class="af-chip f-{{ ev.filter }}">{{ t(ev.label, ev.label_zh) }}</span>
                  <span class="af-head">{{ t(ev.headline|e, ev.headline_zh|e) }}</span>
                </summary>
                <div class="af-detail">{{ t(ev.detail|e, ev.detail_zh|e) }}
                  {% if ev.edge %}<div class="af-edge"><b>{{ t('Edge:','优势：') }}</b> {{ t(ev.edge|e, ev.edge_zh|e) }}</div>{% endif %}
                  {% if ev.forward %}<div class="af-fwd">{{ t(ev.forward|e, ev.forward_zh|e) }}</div>{% endif %}
                </div>
              </details>
              {% endfor %}
            </div>
            {% endfor %}
            {% else %}
            <div class="af-empty">{{ t('No signal changes in the recent window — quiet on every tracked signal.','近期无信号变化 — 所有跟踪信号均平静。') }}</div>
            {% endif %}
          </div>
        </div>
      </span>
    </div>
    {% set e = s.ladder.entry %}
    {# ---- bold VERDICT: the action verb + tag + call, read in a glance ---- #}
    <div class="verdict urg-{{ e.urgency }}">
      <span class="v-act">{{ td(s.ladder.action) }}</span>
      <span class="v-tag">{{ td(e.tag) }}</span>
      <span class="v-text">{{ t(e.text, e.text_zh) }}</span>
    </div>
    {# ---- glance-level SYNTHESIS: reconciles daily-vs-weekly so the context chips below
       can't read as a contradiction (emitted by the engine on the weekly-cross rescue) ---- #}
    {% if s.ladder.synthesis_line %}
    <p class="synthesis">🧭 {{ t(s.ladder.synthesis_line, s.ladder.synthesis_line_zh) }}</p>
    {% endif %}
    {# ---- at-a-glance signal-chip strip — CONTEXT only (already weighed into the verdict) ---- #}
    {% set tech = s.tech or {} %}{% set d = (s.mtf or {}).get('D') or {} %}
    <div class="sigstrip-label">{{ t('Indicators · context — already weighed into the verdict above', '指标 · 参考 — 已计入上方研判') }}</div>
    <div class="sigstrip">
      {% set ab = tech.above200 %}
      <div class="sigchip {{ 'up' if ab else 'down' }}">
        <span class="sc-k">{{ t('Trend','趋势') }}</span>
        <span class="sc-v">{{ '▲' if ab else '▼' }} 200d</span>
        <span class="sc-s">{% if tech.pct_vs_200dma is not none %}{{ "%+.1f"|format(tech.pct_vs_200dma) }}%{% endif %}</span>
      </div>
      {% set mpos = d.macd_pos %}
      <div class="sigchip {{ 'up' if mpos else 'down' }}">
        <span class="sc-k">{{ t('Momentum','动量') }}</span>
        <span class="sc-v">MACD {{ '＋' if mpos else '－' }}{% if d.macd_cross_up %} ↑{% elif d.macd_cross_dn %} ↓{% endif %}</span>
        <span class="sc-s">{{ t('daily','日线') }}</span>
      </div>
      {% set r = tech.rsi14 %}
      <div class="sigchip ctx">
        <span class="sc-k">RSI</span>
        <span class="sc-v">{{ r|round(0)|int if r is not none else '—' }}</span>
        <span class="sc-s">{{ t('high','偏高') if (r is not none and r>=70) else (t('low','偏低') if (r is not none and r<=30) else t('mid','中性')) }}</span>
      </div>
      {% set sv = d.stoch %}
      <div class="sigchip ctx">
        <span class="sc-k">Stoch</span>
        <span class="sc-v">{{ sv|round(0)|int if sv is not none else '—' }}</span>
        <span class="sc-s">{{ t('StochRSI','随机RSI') }}</span>
      </div>
      {% set dd = s.cycle.dc_day %}{% set band = s.cycle.dc_band %}
      <div class="sigchip ctx">
        <span class="sc-k">{{ t('Cycle','周期') }}</span>
        <span class="sc-v">{{ t('Day','第') }} {{ dd }}</span>
        <span class="sc-s">{% if band %}{{ t('of','/') }} {{ band[0] }}–{{ band[1] }}{% endif %}</span>
      </div>
    </div>
    {# ---- rate & inflation transmission overlay (display-only macro context) ---- #}
    {% if s.rate_infl and (s.rate_infl.rate.measured or s.rate_infl.inflation.measured) %}
    {% set ri = s.rate_infl %}{% set _ric = {'neg':'var(--down)','pos':'var(--up)','muted':'var(--muted)'} %}
    <div class="ri-strip" style="margin:10px 0 0;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:12px">
      <span class="muted" style="font-weight:700">{{ t('Rate & inflation','利率与通胀') }}
        {{ help("Per-channel rate / inflation headwind or tailwind this sector faces RIGHT NOW — the MEASURED cross-asset transmission coefficient (split-half forward IC) times the current driver state, split into a rate channel (real-rate speed, curve, policy pricing) and an inflation channel (breakevens, core-PCE gap, re-acceleration, expectations). DISPLAY-ONLY: it is never part of the heat or cycle score — the foundation's scored-leg gate found no rate/inflation leg robust enough to time returns. A 'regime-dependent' tag means the sector's link to that channel is only context-conditional (CONTEXT) on a forward-IC basis, so no robust headwind/tailwind is claimed.", "该板块当前在利率／通胀两个通道上面临的逆风或顺风 —— 实测的跨资产传导系数（分半前瞻IC）乘以当前驱动状态，分为利率通道（实际利率速度、曲线、政策定价）与通胀通道（盈亏平衡、核心PCE缺口、再加速、预期）。仅供展示：绝不计入热度或周期分数 —— 基础层的可计分腿检验未发现足够稳健以择时回报的利率/通胀腿。“依赖状态”标签表示在前瞻IC基础上该板块与该通道的关联仅在特定市场状态下成立（CONTEXT），因此不主张稳健的逆风/顺风。") }}
      </span>
      {% for ch in [ri.rate, ri.inflation] %}
      <span style="border:1px solid var(--line);border-radius:6px;padding:2px 8px;font-weight:600;color:{{ _ric[ch.tone] }}">{{ ch.arrow }} {{ t(ch.chip.en, ch.chip.zh) }}{% if ch.drivers %}<span class="muted" style="font-weight:400;font-size:11px"> · {{ t(ch.drivers[0].label.en, ch.drivers[0].label.zh) }} IC {{ '%+.2f'|format(ch.drivers[0].ic) }}</span>{% endif %}</span>
      {% endfor %}
    </div>
    <p class="muted" style="margin:4px 0 0;font-size:11px">{{ t(ri.summary.en, ri.summary.zh) }}</p>
    {% endif %}
    {# ---- dollar-desk lean → DISPLAY-ONLY context chip (W3-C4b, dollar-sensitive sectors) ---- #}
    {% if s.dollar_ctx %}{% set dc = s.dollar_ctx %}
    {% set _dct = {'headwind':'var(--down)','tailwind':'var(--up)','neutral':'var(--muted)'} %}
    <div class="ri-strip" style="margin:8px 0 0;display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:12px">
      <span class="muted" style="font-weight:700">{{ t('Dollar','美元') }}
        {{ help("The forex Dollar Desk's MEASURED broad-dollar lean (real-rate regime + trend stack + liquidity + Fed path) as CONTEXT for this dollar-sensitive sector. A strong dollar is a mechanical headwind for multinational / commodity / export cyclicals (cheaper USD-priced commodities + FX-translation drag on overseas revenue); a soft dollar is a tailwind. DISPLAY-ONLY and UNVALIDATED FOR SIZING — it never enters the heat, cycle, or basket score. The forex 60-trial family found no per-pair dollar conviction that clears the DSR door (INTL-43); the direction shown is the MECHANISM, not a measured return coefficient.", "外汇美元台的实测宽美元倾向（实际利率状态+趋势栈+流动性+美联储路径），作为该美元敏感板块的参考背景。强美元对跨国/大宗商品/出口周期股构成机械性逆风（以美元计价的大宗商品更便宜+海外收入折算拖累）；弱美元为顺风。仅供展示、不用于仓位——绝不计入热度、周期或篮子分数。外汇60试验家族未发现任何可过DSR门的单对美元信念（INTL-43）；所示方向为机制，而非实测回报系数。") }}
      </span>
      <span style="border:1px solid var(--line);border-radius:6px;padding:2px 8px;font-weight:600;color:{{ _dct[dc.tone] }}">{{ dc.arrow }} {{ t(dc.chip_en, dc.chip_zh) }}<span class="muted" style="font-weight:400;font-size:11px"> · {{ t(dc.lean_en, dc.lean_zh) }}</span></span>
    </div>
    <p class="muted" style="margin:4px 0 0;font-size:11px">{{ t(dc.note_en, dc.note_zh) }} — {{ t('context only, not sized', '仅供参考，不用于仓位') }}</p>
    {% endif %}
    {% if s.ladder.age_line %}<p class="agewhen">{{ t(s.ladder.age_line, s.ladder.age_line_zh) }}</p>{% endif %}
    {% if s.ladder.early_note %}<p class="early">{{ t(s.ladder.early_note, s.ladder.early_note_zh) }}</p>{% endif %}
    {% if s.ladder.macro_line %}<p class="macro-caution">⚠ {{ t(s.ladder.macro_line, s.ladder.macro_line_zh) }}</p>{% endif %}
    <ul class="points">
      {% for p, pz in zip(s.ladder.points, s.ladder.points_zh) %}<li>{{ t(p, pz) }}</li>{% endfor %}
    </ul>
    {% set cp = s.ladder.cycle_plain %}
    <div class="cyclebox">
