    <details style="margin-top:8px"><summary>{{ t('full reasoning', '完整推理') }}</summary>
      <p class="muted" style="margin:6px 0">{{ t(s.ladder.why, s.ladder.why_zh) }} {{ t('Next:', '下一步：') }} {{ t(s.ladder.next, s.ladder.next_zh) }}</p>
