{#- ============================================================================
    SHARED HOVER DECISION CARD — one source for every action-board popover.

    Before this partial the US board (dashboard.html.j2) had a rich decision card
    — score ring, plain-word read, three decision metrics, leaders, "what matters"
    — while China / HK rendered a bland label:value grid and Canada rendered no
    hover at all. Same product, four different answers to the same question.
    Operator order 2026-08-02: China / HK / Canada get the US card, same info,
    same structure, same CSS.

    Two macros:
      dc_css()   — the component stylesheet. Include ONCE per page, inside the
                   board's own <style> scope-free (it is already class-scoped).
      dc_card(d) — the markup, driven by a normalised dict so each page maps its
                   own row shape in one place. Every section is optional: pass
                   nothing and it is omitted, never rendered empty.

    SCORE RING (fixed 2026-08-02) — the numeral owns the circle and the caption
    sits BENEATH it. The old build centred a 7.5px "SCORE" inside the 62px disc;
    7.5px is under every browser's minimum-font-size floor, so a reader with that
    accessibility setting on had the word clamped up to 12-16px and it ran
    straight through the ring stroke. Nothing inside the disc may depend on a
    sub-minimum font size — the caption outside it can be clamped freely and only
    ever grows into its own 72px column.

    d = {
      'kind':      'theme' | 'sector',     # picks the mark tint
      'mark':      '◆',                    # one glyph, aria-hidden
      'eyebrow':   (en, zh),               # "Theme basket" / "Sector pulse"
      'name':      (en, zh),
      'tag':       (en, zh), 'tone': 'up'|'warn'|'dn'|'',
      'score':     0-100 | none,           # renders the ring hero
      'kicker':    (en, zh),               # "Leadership read" / "Current setup"
      'read':      (en, zh),               # the plain-word headline
      'sub':       (en, zh),               # optional line under the headline
      'trust':     [{'tone','en','zh'}],   # ★/✓ provenance chips
      'bars':      [{'label','pct','val'}],# optional 0-100 gauges (RSI/STO)
      'stats':     [{'label':(en,zh),'val'|'val2':(en,zh),'tone','sub':(en,zh)}],
      'leaders':   {'label':(en,zh),'val':(en,zh)},
      'takeaway':  (en, zh),
      'foot':      (en, zh), 'foot_b': (en, zh),
    }
    Tuples are (english, chinese); pass a 1-tuple or a bare string when the value
    is language-neutral (a number, a ticker).
============================================================================ -#}

{%- macro _b(v) -%}
{#- Bilingual span pair. A bare string renders once, untranslated (numbers,
    tickers). A 1-tuple is RAW PASSTHROUGH — the caller already emitted its own
    l-en/l-zh pair (td() does), and wrapping that again nests both languages
    inside the English span, printing Chinese to English readers. -#}
{%- if v is string or v is number -%}{{ v }}
{%- elif v and v|length == 1 -%}{{ v[0] }}
{%- elif v -%}<span class="l-en">{{ v[0] }}</span><span class="l-zh">{{ v[1] if v[1] else v[0] }}</span>
{%- endif -%}
{%- endmacro -%}

{%- macro dc_css() -%}
  <style id="decision-card-css">
  .row-pop:has(> .row-pop-decision){
    z-index:2147483001;width:344px;max-width:calc(100vw - 20px);
    max-height:calc(100dvh - 20px);overflow:auto;overscroll-behavior:contain;
    scrollbar-width:thin;border-color:color-mix(in srgb,var(--line) 76%,var(--text) 10%);
    border-radius:16px;
    background:
      radial-gradient(circle at 0 0,color-mix(in srgb,var(--link) 7%,transparent),transparent 42%),
      var(--panel);
    box-shadow:0 22px 64px rgba(0,0,0,.34),0 3px 12px rgba(0,0,0,.18);
  }
  .row-pop:has(> .row-pop-decision)::before{
    content:"";display:block;height:3px;position:sticky;top:0;z-index:2;
    background:linear-gradient(90deg,var(--link),color-mix(in srgb,var(--link) 12%,transparent));
  }
  .row-pop-decision{display:block}
  .row-pop-decision-hd{
    display:grid;grid-template-columns:36px minmax(0,1fr) auto;align-items:center;
    gap:10px;padding:12px 14px 10px;
  }
  .row-pop-mark{
    width:34px;height:34px;display:grid;place-items:center;flex:none;border-radius:11px;
    font-size:15px;line-height:1;color:var(--link);
    border:1px solid color-mix(in srgb,var(--link) 24%,var(--line));
    background:color-mix(in srgb,var(--link) 9%,var(--panel2));
  }
  .row-pop-mark--theme{
    color:var(--up);border-color:color-mix(in srgb,var(--up) 24%,var(--line));
    background:color-mix(in srgb,var(--up) 9%,var(--panel2));
  }
  .row-pop-heading{display:flex;min-width:0;flex-direction:column;gap:2px}
  .row-pop-eyebrow{
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:9px;font-weight:700;
    letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
  }
  .row-pop-decision .row-pop-name{
    overflow:hidden;font-size:13.5px;line-height:1.25;white-space:normal;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  }
  .row-pop-decision .row-pop-tag{
    margin-left:0;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
    padding:3px 7px;border-radius:7px;font-size:9px;
  }
  .row-pop-summary,.row-pop-theme-hero{
    display:flex;align-items:center;justify-content:space-between;gap:14px;margin:0 14px;
    padding:12px;border:1px solid color-mix(in srgb,var(--line) 82%,transparent);
    border-radius:12px;background:color-mix(in srgb,var(--panel2) 78%,transparent);
  }
  .row-pop-summary-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:3px}
  .row-pop-kicker{
    font-size:9px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);
  }
  .row-pop-summary-copy>strong{font-size:15px;line-height:1.15;color:var(--text)}
  .row-pop-sub{min-height:13px;font-size:10px;color:var(--muted)}
  .row-pop-bars{display:flex;width:118px;flex-direction:column;gap:6px}
  .row-pop-bars>span{
    display:grid;grid-template-columns:24px minmax(38px,1fr) 23px;align-items:center;gap:5px;
  }
  .row-pop-bars em{
    font-style:normal;font-size:8px;font-weight:700;letter-spacing:.05em;color:var(--muted);
  }
  .row-pop-bars i{
    height:5px;position:relative;overflow:hidden;border-radius:999px;
    background:color-mix(in srgb,var(--muted) 15%,transparent);
  }
  .row-pop-bars i b{
    position:absolute;inset:0 auto 0 0;width:clamp(0%,var(--bar),100%);border-radius:inherit;
    background:linear-gradient(90deg,var(--link),var(--up));
  }
  .row-pop-bars strong{
    text-align:right;font-size:9px;font-variant-numeric:tabular-nums;color:var(--text);
  }
  .row-pop-stats{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(82px,1fr));gap:1px;
    margin:11px 14px;overflow:hidden;border:1px solid color-mix(in srgb,var(--line) 82%,transparent);
    border-radius:11px;background:color-mix(in srgb,var(--line) 75%,transparent);
  }
  .row-pop-stat{
    display:flex;min-width:0;min-height:64px;flex-direction:column;justify-content:center;
    padding:9px 10px;background:var(--panel);
  }
  .row-pop-stat>strong{
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:2px;font-size:15px;
    line-height:1.1;font-variant-numeric:tabular-nums;color:var(--text);
  }
  .row-pop-stat>strong.up,.row-pop-stat>strong .up{color:var(--up)}
  .row-pop-stat>strong.dn,.row-pop-stat>strong .dn{color:var(--down)}
  .row-pop-stat>strong.warn{color:var(--warn)}
  .row-pop-stat small{margin-top:3px;font-size:9px;color:var(--muted)}
  {#- Score gauge. The caption is a SIBLING of the disc, never a child: a reader
      with a minimum-font-size setting has it clamped up, and outside the disc that
      only widens its own column instead of crossing the ring stroke. -#}
  .row-pop-score{display:grid;justify-items:center;gap:5px;flex:none;width:72px}
  .row-pop-score-ring{
    --ring-color:var(--muted);width:72px;height:72px;position:relative;isolation:isolate;
    display:grid;place-content:center;text-align:center;border-radius:50%;
    background:conic-gradient(var(--ring-color) calc(var(--score) * 1%),color-mix(in srgb,var(--muted) 13%,transparent) 0);
  }
  .row-pop-score-ring::before{
    content:"";position:absolute;inset:5px;z-index:0;border-radius:50%;background:var(--panel);
    box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--line) 80%,transparent);
  }
  .row-pop-score-ring.up{--ring-color:var(--up)}
  .row-pop-score-ring.warn{--ring-color:var(--warn)}
  .row-pop-score-ring.dn{--ring-color:var(--down)}
  .row-pop-score-ring strong{
    position:relative;z-index:1;font-size:23px;line-height:1;letter-spacing:-.02em;color:var(--text);
  }
  .row-pop-score-cap{
    max-width:100%;overflow:hidden;white-space:nowrap;text-align:center;
    font-size:8px;line-height:1;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);
  }
  .row-pop-trust{display:flex;min-height:18px;flex-wrap:wrap;gap:5px;margin-top:2px}
  .row-pop-trust>span{
    padding:2px 6px;border-radius:999px;font-size:8.5px;font-weight:700;
    background:color-mix(in srgb,currentColor 9%,transparent);
  }
  .row-pop-trust>span.up{color:var(--up)}
  .row-pop-trust>span.warn{color:var(--warn)}
  .row-pop-trust>span.dn{color:var(--down)}
  .row-pop-leaders{display:flex;align-items:center;gap:10px;margin:0 14px 11px;padding:0 2px}
  .row-pop-leaders>span{
    flex:none;font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    color:var(--muted);
  }
  .row-pop-leaders strong{
    min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px;
    font-variant-numeric:tabular-nums;color:var(--text);
  }
  .row-pop-takeaway{
    --takeaway:var(--muted);display:grid;grid-template-columns:24px minmax(0,1fr);gap:8px;
    margin:0 14px 12px;padding:9px 10px;border-radius:10px;
    border:1px solid color-mix(in srgb,var(--takeaway) 22%,var(--line));
    background:color-mix(in srgb,var(--takeaway) 7%,var(--panel2));
  }
  .row-pop-takeaway.up{--takeaway:var(--up)}
  .row-pop-takeaway.warn{--takeaway:var(--warn)}
  .row-pop-takeaway.dn{--takeaway:var(--down)}
  .row-pop-takeaway>span:first-child{
    width:22px;height:22px;display:grid;place-items:center;border-radius:7px;
    color:var(--takeaway);background:color-mix(in srgb,var(--takeaway) 12%,transparent);
    font-size:13px;font-weight:800;
  }
  .row-pop-takeaway>span:last-child{display:flex;min-width:0;flex-direction:column;gap:2px}
  .row-pop-takeaway b{
    font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--takeaway);
  }
  .row-pop-takeaway b+span{font-size:10.5px;line-height:1.35;color:var(--text)}
  .row-pop-decision-ft{
    display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 14px 11px;
    border-top:1px solid color-mix(in srgb,var(--line) 75%,transparent);
    font-size:9px;color:var(--muted);
  }
  .row-pop-decision-ft b{
    flex:none;color:var(--link);font-size:9px;letter-spacing:.04em;text-transform:uppercase;
  }
  [data-theme="light"] .row-pop:has(> .row-pop-decision){
    box-shadow:0 18px 48px rgba(31,41,55,.18),0 2px 8px rgba(31,41,55,.1);
  }
  @media(max-width:380px){
    .row-pop-decision-hd{grid-template-columns:34px minmax(0,1fr)}
    .row-pop-decision .row-pop-tag{grid-column:2;justify-self:start}
    .row-pop-summary,.row-pop-theme-hero{align-items:flex-start;flex-direction:column;gap:9px}
    .row-pop-bars{width:100%}
  }
  </style>
{%- endmacro -%}

{%- macro dc_card(d) -%}
{%- set _tone = d.get('tone') or '' -%}
<div class="rp-src row-pop-decision" hidden>
  <div class="row-pop-decision-hd">
    <span class="row-pop-mark row-pop-mark--{{ d.get('kind') or 'sector' }}" aria-hidden="true">{{ d.get('mark') or '◆' }}</span>
    <span class="row-pop-heading">
      {%- if d.get('eyebrow') %}<span class="row-pop-eyebrow">{{ _b(d.eyebrow) }}</span>{% endif %}
      <span class="row-pop-name">{{ _b(d.get('name')) }}</span>
    </span>
    {%- if d.get('tag') %}<span class="row-pop-tag {{ _tone }}">{{ _b(d.tag) }}</span>{% endif %}
  </div>

  {%- set _has_score = d.get('score') is not none and d.get('score') is defined -%}
  {%- if _has_score or d.get('read') or d.get('bars') %}
  <div class="{{ 'row-pop-theme-hero' if _has_score else 'row-pop-summary' }}">
    {%- if _has_score %}
    {%- set _sc = d.score -%}
    <span class="row-pop-score">
      <span class="row-pop-score-ring {{ 'up' if _sc >= 60 else ('warn' if _sc >= 40 else 'dn') }}" style="--score:{{ '%.0f'|format(_sc) }}">
        <strong>{{ '%.0f'|format(_sc) }}</strong>
      </span>
      <span class="row-pop-score-cap">{{ _b(d.get('score_cap') or ('Score','评分')) }}</span>
    </span>
    {%- endif %}
    <span class="row-pop-summary-copy">
      {%- if d.get('kicker') %}<span class="row-pop-kicker">{{ _b(d.kicker) }}</span>{% endif %}
      {%- if d.get('read') %}<strong>{{ _b(d.read) }}</strong>{% endif %}
      {%- if d.get('sub') %}<span class="row-pop-sub">{{ _b(d.sub) }}</span>{% endif %}
      {%- if d.get('trust') %}
      <span class="row-pop-trust">
        {%- for c in d.trust %}<span class="{{ c.get('tone') or '' }}">{{ _b((c.get('en'), c.get('zh'))) }}</span>{% endfor -%}
      </span>
      {%- endif %}
    </span>
    {%- if d.get('bars') %}
    <span class="row-pop-bars" aria-label="momentum">
      {%- for g in d.bars %}<span><em>{{ g.label }}</em><i><b style="--bar:{{ '%.0f'|format(g.pct) }}%"></b></i><strong>{{ g.val }}</strong></span>{% endfor -%}
    </span>
    {%- endif %}
  </div>
  {%- endif %}

  {%- if d.get('stats') %}
  <div class="row-pop-stats">
    {%- for s in d.stats %}
    <span class="row-pop-stat">
      <span class="row-pop-lbl">{{ _b(s.get('label')) }}</span>
      <strong class="{{ s.get('tone') or '' }}">{{ _b(s.get('val')) }}</strong>
      {%- if s.get('sub') %}<small>{{ _b(s.sub) }}</small>{% endif %}
    </span>
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if d.get('leaders') %}
  <div class="row-pop-leaders">
    <span>{{ _b(d.leaders.get('label') or ('Leaders','龙头')) }}</span>
    <strong>{{ _b(d.leaders.get('val')) }}</strong>
  </div>
  {%- endif %}

  {%- if d.get('takeaway') %}
  <div class="row-pop-takeaway {{ _tone }}">
    <span aria-hidden="true">&rarr;</span>
    <span>
      <b>{{ _b(d.get('takeaway_label') or ('What matters','要点')) }}</b>
      <span>{{ _b(d.takeaway) }}</span>
    </span>
  </div>
  {%- endif %}

  {%- if d.get('foot') or d.get('foot_b') %}
  <div class="row-pop-decision-ft">
    <span>{{ _b(d.get('foot')) }}</span>
    {%- if d.get('foot_b') %}<b>{{ _b(d.foot_b) }}</b>{% endif %}
  </div>
  {%- endif %}
</div>
{%- endmacro -%}
