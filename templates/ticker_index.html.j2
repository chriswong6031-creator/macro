{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% set nav_prefix = '../' %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stock dossiers — S&amp;P 500 signals, options &amp; factor profiles | Mastermind</title>
<meta name="description" content="Per-stock research dossiers for S&P 500 members: signals, options positioning, factor profile, themes. Updated nightly.">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="Stock dossiers — S&amp;P 500 coverage | Mastermind">
<meta property="og:description" content="Per-stock research dossiers for S&P 500 members: signals, options positioning, factor profile, themes. Updated nightly.">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="website">
<script data-dbase src="../data_base.js"></script>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="../theme.css">
<style>
* { box-sizing:border-box; }
body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
@media (min-width:1100px){ body{ padding:24px max(34px,calc((100vw - 1340px)/2)); } }
a { text-decoration:none; color:inherit; }
h1 { font-size:22px; margin:0 0 4px; }
.muted { color:var(--muted); } .sm { font-size:12px; } .pos { color:var(--up); } .neg { color:var(--down); }
.back { font-size:12.5px; color:var(--muted); }
.back:hover { color:var(--link); }

/* hero stats bar */
.hero-bar { display:flex; gap:24px; margin:16px 0 20px; flex-wrap:wrap; }
.hero-stat { display:flex; flex-direction:column; gap:2px; }
.hero-stat .hn { font-size:22px; font-weight:720; font-variant-numeric:tabular-nums; }
.hero-stat .hk { font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }

/* filter controls */
.filter-bar { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:14px; }
.search-box { background:var(--panel); border:1px solid var(--line); border-radius:8px; color:var(--text); font-size:13px; padding:6px 12px; outline:none; min-width:180px; }
.search-box:focus { border-color:var(--link); }
.sector-chips { display:flex; gap:6px; flex-wrap:wrap; }

/* chips */
.chip { display:inline-block; font-size:11px; padding:2px 8px; border-radius:7px; background:var(--panel2); border:1px solid var(--line); color:var(--muted); white-space:nowrap; cursor:pointer; transition:border-color .12s; }
.chip:hover { border-color:var(--muted); }
.chip.active { background:color-mix(in srgb,var(--link) 15%,var(--panel2)); border-color:var(--link); color:var(--link); }
.chip.pos { color:var(--up); border-color:color-mix(in srgb,var(--up) 38%,var(--line)); background:color-mix(in srgb,var(--up) 10%,var(--panel2)); }
.chip.neg { color:var(--down); border-color:color-mix(in srgb,var(--down) 38%,var(--line)); background:color-mix(in srgb,var(--down) 10%,var(--panel2)); }
.chip.warn { color:var(--warn); border-color:color-mix(in srgb,var(--warn) 38%,var(--line)); background:color-mix(in srgb,var(--warn) 10%,var(--panel2)); }

/* grid */
.grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:8px; margin-top:4px; }
.card { background:rgba(16,22,30,.55); border:1px solid rgba(255,255,255,.12); border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,.45),0 1.5px 0 rgba(255,255,255,.07) inset; backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); padding:12px 14px; display:flex; flex-direction:column; gap:4px; transition:background .2s,border-color .2s,transform .2s,box-shadow .2s; }
[data-theme="light"] .card { background:rgba(255,255,255,.82); border-color:rgba(0,0,0,.09); box-shadow:0 8px 32px rgba(0,0,0,.08); }
.card:hover { background:rgba(22,29,38,.62); border-color:rgba(255,255,255,.16); transform:translateY(-1px); box-shadow:0 12px 40px rgba(0,0,0,.55),0 1.5px 0 rgba(255,255,255,.09) inset; }
.card a { display:block; }
.card .ticker { font-size:16px; font-weight:720; color:var(--link); font-variant-numeric:tabular-nums; }
.card .name { font-size:12px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.card .price-row { display:flex; align-items:baseline; gap:7px; margin-top:3px; }
.card .price { font-size:14px; font-weight:600; font-variant-numeric:tabular-nums; }
.card .ytd { font-size:11px; font-weight:600; }
.card .meta { display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:2px; }
.card .sector { font-size:11px; color:var(--muted); }

/* no results */
.no-results { padding:32px 0; color:var(--muted); text-align:center; font-size:14px; display:none; }

footer { color:var(--muted); font-size:11.5px; margin-top:28px; border-top:1px solid var(--line); padding-top:12px; }
@media (max-width:600px) {
  body { padding:12px; }
  .grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .hero-bar { gap:16px; }
  .hero-stat .hn { font-size:18px; }
}
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}
<div style="padding-top:8px;">
<p class="back"><a href="../stock.html">{{ t('← Analyzer', '← 分析器') }}</a></p>

<h1>{{ t('Stock Coverage', '股票覆盖范围') }}</h1>
<p class="sm muted">{{ t('S&P 500 research dossiers — signals, options positioning, factor profile. Updated nightly.', 'S&P 500 研究报告 — 信号、期权持仓、因子概况。每日更新。') }}</p>

<!-- hero count stats -->
{%- set n_pos = rows | selectattr('stance_class', 'eq', 'pos') | list | length -%}
{%- set n_neg = rows | selectattr('stance_class', 'eq', 'neg') | list | length -%}
{%- set n_warn = rows | selectattr('stance_class', 'eq', 'warn') | list | length -%}
<div class="hero-bar">
  <div class="hero-stat">
    <span class="hn">{{ n_total }}</span>
    <span class="hk">{{ t('Stocks covered', '覆盖股票') }}</span>
  </div>
  <div class="hero-stat">
    <span class="hn pos">{{ n_pos }}</span>
    <span class="hk">{{ t('Uptrend / bullish', '上涨/看涨') }}</span>
  </div>
  <div class="hero-stat">
    <span class="hn neg">{{ n_neg }}</span>
    <span class="hk">{{ t('Downtrend / defensive', '下跌/防御') }}</span>
  </div>
  <div class="hero-stat">
    <span class="hn muted">{{ n_warn }}</span>
    <span class="hk">{{ t('Mixed / watch', '混杂/观察') }}</span>
  </div>
</div>

<!-- filter controls -->
{%- set sectors = rows | map(attribute='sector') | select | unique | sort | list -%}
<div class="filter-bar">
  <input class="search-box" type="search" id="stk-search" placeholder="Search / 搜索" autocomplete="off">
  <div class="sector-chips" id="sec-chips">
    <span class="chip active" data-sec="">{{ t('All', '全部') }}</span>
    {% for sec in sectors %}
    <span class="chip" data-sec="{{ sec }}">{{ sec }}</span>
    {% endfor %}
  </div>
</div>

<div class="grid" id="stk-grid">
  {% for row in rows %}
  <div class="card" data-ticker="{{ row.ticker }}" data-name="{{ row.name | lower }}" data-sec="{{ row.sector or '' }}">
    <a href="{{ row.ticker }}.html">
      <div class="ticker">{{ row.ticker }}</div>
      <div class="name">{{ row.name }}</div>
    </a>
    {% if row.price or row.ytd %}
    <div class="price-row">
      {% if row.price %}<span class="price">{{ row.price }}</span>{% endif %}
      {% if row.ytd %}<span class="ytd {{ 'pos' if row.ytd_pos else 'neg' }}">{{ row.ytd }}</span>{% endif %}
    </div>
    {% endif %}
    <div class="meta">
      {% if row.sector %}<span class="sector">{{ row.sector }}</span>{% endif %}
      <span class="chip {{ row.stance_class }}">
        {{ t(row.state_chip, row.state_chip_zh) }}
      </span>
    </div>
  </div>
  {% endfor %}
</div>
<div class="no-results" id="no-results">{{ t('No stocks match your filter.', '没有符合条件的股票。') }}</div>

<footer>
  <p>{{ t('Research context only — not investment advice.', '仅供研究参考，不构成投资建议。') }}</p>
  <p class="sm muted">{{ t('Generated', '生成') }} {{ generated_utc }}</p>
</footer>

<script>
(function(){
  var search = document.getElementById('stk-search');
  var chips = document.querySelectorAll('#sec-chips .chip');
  var cards = document.querySelectorAll('#stk-grid .card');
  var noRes = document.getElementById('no-results');
  var activeSec = '';

  function filter(){
    var q = (search.value || '').toLowerCase().trim();
    var shown = 0;
    cards.forEach(function(c){
      var matchSec = !activeSec || c.dataset.sec === activeSec;
      var matchQ = !q || c.dataset.ticker.toLowerCase().includes(q) || c.dataset.name.includes(q);
      var show = matchSec && matchQ;
      c.style.display = show ? '' : 'none';
      if(show) shown++;
    });
    noRes.style.display = shown === 0 ? 'block' : 'none';
  }

  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      chips.forEach(function(c){ c.classList.remove('active'); });
      chip.classList.add('active');
      activeSec = chip.dataset.sec;
      filter();
    });
  });

  search.addEventListener('input', filter);
})();
</script>
</div>
</body>
</html>
