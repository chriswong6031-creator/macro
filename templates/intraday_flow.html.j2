{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% set ift = intraday_flow if intraday_flow else {} %}
{% set leaders = ift.leaders if ift.leaders else [] %}
{% set rvol_confirm = ift.rvol_confirm if ift.rvol_confirm is defined else 1.30 %}
{% set dur_min = ift.durability_min if ift.durability_min is defined else 0.60 %}
{% set washout_lb = ift.washout_lookback if ift.washout_lookback is defined else 10 %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Intraday Flow · 盘中资金流</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(40px,calc((100vw - 1440px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; font-weight:600; letter-spacing:.2px; }
  h3 { font-size:12px; margin:0 0 6px; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:14px 16px; margin-bottom:14px; }
  .muted { color:var(--muted); } .sm { font-size:12px; } .xs { font-size:11px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .topline { display:flex; flex-wrap:wrap; align-items:baseline; gap:8px 14px; }
  .note { margin:8px 0 0; line-height:1.5; }
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:4px; }
  .help .tip { display:none; position:absolute; top:140%; left:50%; transform:translateX(-50%); width:280px; background:var(--panel); border:1px solid var(--line); padding:9px 11px; border-radius:8px; z-index:60; font-size:12px; line-height:1.45; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); pointer-events:auto; cursor:auto; max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; text-align:left; white-space:normal; }
  /* invisible hover pad across the icon→tip gap — keeps :hover alive mid-travel (on .help, not .tip: the tip is a scroll container and clips its pseudos) */
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:10px; }
  .help:hover .tip { display:block; }
  .tabnum { font-variant-numeric:tabular-nums; }
  .lag-tag { display:inline-block; font-size:10px; background:var(--panel2); border:1px solid var(--line); border-radius:5px; padding:1px 6px; color:var(--muted); vertical-align:middle; margin-left:4px; }
  .soft-tag { display:inline-block; font-size:10px; font-style:italic; color:var(--orange,#f97316); margin-left:3px; }

  /* ── "What's set up now" stance strip ─────────────────────────── */
  .stance-strip { display:flex; flex-wrap:wrap; gap:8px; }
  .stance-card { flex:1 1 140px; min-width:130px; border:1px solid var(--line); border-radius:10px; padding:9px 12px; cursor:pointer; user-select:none; background:var(--panel2); transition:border-color .15s, background .15s, transform .1s; position:relative; }
  .stance-card:hover { border-color:var(--muted); transform:translateY(-1px); }
  .stance-card.active { border-color:var(--blue,#3b82f6); box-shadow:inset 0 0 0 1px var(--blue,#3b82f6); }
  .stance-card .sc-top { display:flex; align-items:center; gap:6px; }
  .stance-card .sc-dot { font-size:14px; line-height:1; }
  .stance-card .sc-label { font-size:12.5px; font-weight:700; }
  .stance-card .sc-count { font-size:22px; font-weight:800; font-variant-numeric:tabular-nums; margin-top:2px; line-height:1; }
  .stance-card .sc-sub { font-size:10.5px; color:var(--muted); margin-top:2px; line-height:1.3; }
  .stance-card .sc-accent { position:absolute; left:0; top:0; bottom:0; width:3px; border-radius:10px 0 0 10px; }
  /* lane colors */
  .lane-act    { --lane:var(--up,#16a34a); }
  .lane-ready  { --lane:var(--blue,#3b82f6); }
  .lane-fav    { --lane:#22c55e; }
  html[data-lang="zh"] .lane-fav { --lane:#ef4444; }
  .lane-profit { --lane:var(--orange,#f97316); }
  .lane-watch  { --lane:#eab308; }
  .lane-aside  { --lane:var(--muted); }
  .sc-accent { background:var(--lane); }

  /* ── Filter / toolbar ─────────────────────────────────────────── */
  .toolbar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-bottom:2px; }
  .chip { display:inline-block; font-size:11px; padding:3px 9px; border-radius:20px; border:1px solid var(--line); cursor:pointer; user-select:none; background:var(--panel2); color:var(--muted); transition:background .15s,border-color .15s,color .15s; }
  .chip.active { background:var(--blue,#3b82f6); border-color:var(--blue,#3b82f6); color:#fff; }
  .chip:hover:not(.active) { border-color:var(--muted); color:var(--text); }
  .search-box { flex:1; min-width:120px; max-width:220px; }
  .search-box input { width:100%; background:var(--panel2); border:1px solid var(--line); color:var(--text); border-radius:6px; padding:4px 10px; font-size:12px; outline:none; }
  .search-box input:focus { border-color:var(--blue,#3b82f6); }
  .toggle-btn { font-size:11px; padding:3px 10px; border-radius:6px; border:1px solid var(--line); cursor:pointer; user-select:none; background:var(--panel2); color:var(--muted); }
  .toggle-btn.active { color:var(--text); border-color:var(--muted); }
  .stamp-row { margin-left:auto; font-size:11px; color:var(--muted); white-space:nowrap; }

  /* ── Leaders table ────────────────────────────────────────────── */
  .leaders-wrap { overflow-x:auto; }
  table.leaders { width:100%; border-collapse:collapse; font-size:13px; }
  table.leaders th { padding:7px 10px; text-align:left; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.3px; color:var(--muted); border-bottom:2px solid var(--line); cursor:pointer; white-space:nowrap; user-select:none; }
  table.leaders th:hover { color:var(--text); }
  table.leaders th .sort-ic { display:inline-block; margin-left:3px; opacity:.4; }
  table.leaders th.sort-asc .sort-ic::after { content:"↑"; opacity:1; }
  table.leaders th.sort-desc .sort-ic::after { content:"↓"; opacity:1; }
  table.leaders th:not(.sort-asc):not(.sort-desc) .sort-ic::after { content:"↕"; }
  table.leaders td { padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
  table.leaders tr.lead-row:hover td { background:var(--panel2); }
  table.leaders tr.group-head td { background:var(--panel2); font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:.3px; color:var(--muted); padding:5px 10px; border-bottom:1px solid var(--line); }
  .tk-link { font-weight:700; font-size:14px; color:var(--blue,#3b82f6); }
  .tk-link:hover { text-decoration:underline; }
  .tk-baskets { font-size:10px; color:var(--muted); margin-top:1px; }
  .price-cell { white-space:nowrap; }
  .pct-chg { font-size:11px; margin-left:4px; }
  .expander { cursor:pointer; color:var(--muted); font-size:12px; user-select:none; padding:2px 4px; border-radius:4px; }
  .expander:hover { color:var(--text); background:var(--panel2); }

  /* ── Stance pill + reason ─────────────────────────────────────── */
  .stance-cell { min-width:210px; }
  .stance-pill { display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:800; padding:3px 9px; border-radius:20px; border:1px solid var(--lane); color:var(--lane); white-space:nowrap; }
  .stance-reason { font-size:11.5px; color:var(--text); margin-top:3px; line-height:1.35; max-width:320px; }
  .stance-reason.muted { color:var(--muted); }

  /* ── Plain metric cells ───────────────────────────────────────── */
  .metric-lead { font-size:12.5px; }
  .metric-sub { font-size:10.5px; color:var(--muted); margin-top:1px; }
  .gauge-wrap { display:flex; align-items:center; gap:6px; white-space:nowrap; }
  .gauge-bar { width:48px; height:6px; background:var(--line); border-radius:4px; overflow:hidden; flex-shrink:0; }
  .gauge-fill { height:100%; border-radius:4px; background:var(--blue,#3b82f6); }
  .gauge-hi { background:var(--up); } .gauge-med { background:var(--orange,#f97316); } .gauge-lo { background:var(--muted); }

  /* ── Chips / badges ───────────────────────────────────────────── */
  .chip-row { display:flex; flex-wrap:wrap; gap:3px; margin-top:2px; }
  .badge { display:inline-block; font-size:10px; font-weight:600; padding:2px 6px; border-radius:5px; border:1px solid; white-space:nowrap; }
  .badge-green { color:var(--up); border-color:var(--up); }
  .badge-red { color:var(--down); border-color:var(--down); }
  .badge-blue { color:var(--blue,#3b82f6); border-color:var(--blue,#3b82f6); }
  .badge-orange { color:var(--orange,#f97316); border-color:var(--orange,#f97316); }
  .badge-muted { color:var(--muted); border-color:var(--line); }

  /* ── Dealer map cell ──────────────────────────────────────────── */
  .dealer-cell { min-width:150px; font-size:11.5px; }
  .dealer-line { line-height:1.4; }
  .regime-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; vertical-align:middle; }
  .rd-long { background:var(--up); } .rd-short { background:var(--down); } .rd-neutral { background:var(--muted); }
  .dealer-na { color:var(--muted); font-style:italic; }

  /* ── Expanded detail row ──────────────────────────────────────── */
  tr.detail-row td { background:var(--panel2); padding:0; border-bottom:1px solid var(--line); }
  .detail-inner { display:none; padding:14px 16px; }
  tr.detail-row.open .detail-inner { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; }
  .detail-block h4 { font-size:11px; text-transform:uppercase; letter-spacing:.3px; color:var(--muted); margin:0 0 6px; font-weight:700; }
  .detail-block .dl { display:grid; grid-template-columns:auto 1fr; gap:2px 10px; font-size:12px; }
  .detail-block .dl .k { color:var(--muted); }
  .detail-block .dl .v { text-align:right; font-variant-numeric:tabular-nums; }
  .posture { font-size:12px; line-height:1.5; margin:6px 0 0; color:var(--text); }
  .receipt { font-size:10.5px; color:var(--muted); margin-top:6px; font-style:italic; }
  /* checks (legs) */
  .checks { display:flex; flex-wrap:wrap; gap:4px 8px; }
  .check { display:inline-flex; align-items:center; gap:3px; font-size:11px; }
  .check .ic { font-weight:700; }
  .check.on { color:var(--up); } .check.off { color:var(--muted); } .check.na { color:var(--muted); opacity:.65; }

  /* ── Playbook accordion ──────────────────────────────────────── */
  .playbook-section { border:1px solid var(--line); border-radius:10px; overflow:hidden; margin-bottom:8px; }
  .playbook-hd { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; cursor:pointer; font-weight:600; font-size:13px; user-select:none; }
  .playbook-hd:hover { background:var(--panel2); }
  .playbook-hd .caret { font-size:11px; color:var(--muted); transition:transform .2s; }
  .playbook-section.open .playbook-hd .caret { transform:rotate(90deg); }
  .playbook-body { display:none; padding:10px 14px; font-size:13px; line-height:1.6; border-top:1px solid var(--line); }
  .playbook-section.open .playbook-body { display:block; }
  .playbook-body ul { margin:6px 0 0 18px; padding:0; }
  .playbook-body li { margin-bottom:3px; }

  .loading-row td { color:var(--muted); font-style:italic; text-align:center; padding:24px; }

  @media (max-width:820px) {
    table.leaders { font-size:12px; }
    table.leaders th, table.leaders td { padding:6px 7px; }
    .hide-narrow { display:none; }
  }
</style>
</head>
<body class="page-intraday-flow">

<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<!-- Header panel — Tier 1: title ≤4 words, subtitle ≤14, one as-of, one footnote -->
<div class="panel">
  <div class="topline">
    <h1>📊 {{ t('Intraday Flow', '盘中资金流') }}</h1>
    <span class="lag-tag">{{ t('≈15-min delayed', '≈15分钟延迟') }}</span>
    {{ help(
      'Washed-out leaders reclaiming on real volume. Direction on the options tape is approximate (~soft) — it leans, it does not confirm. Everything here annotates; nothing is trade advice, and the dealer map is a levels-and-timing map, never a forecast.',
      '经历洗盘后在真实成交量上收复的领涨股。期权带的方向为近似（~软性）——只作倾向，不作确认。所有内容仅为标注，均不构成交易建议；做市商地图仅为价位与择时参考，绝非预测。') }}
  </div>
  <p class="muted sm note">{{ t(
    "Which washed-out leaders are being bought back — right now — and what to do about each.",
    "哪些洗盘后的领涨股正在被重新买入——就在当下——以及每一只该怎么应对。") }}</p>
  <div class="topline" style="margin-top:8px">
    <span class="xs muted">{{ ift.n_leaders if ift.n_leaders else 0 }} {{ t('leaders watched', '只领涨股') }}</span>
    <span class="xs muted" id="ift-stamp">{{ t('Base:', '基础：') }} {{ ift.as_of if ift.as_of else '—' }} · <span class="l-en">tape loading…</span><span class="l-zh">资金带加载中…</span></span>
  </div>
</div>

<!-- "What's set up now" stance strip — the glance tier -->
<div class="panel">
  <h2>{{ t("What's set up now", '当前布局一览') }}
    {{ help('Each leader is sorted into one plain-word call from deterministic rules — no score, no black box. Click a card to show only those names. Counts update live as the tape moves.',
            '每只领涨股按确定性规则归入一个通俗结论——无评分、无黑箱。点击卡片仅显示该类。计数随资金带实时更新。') }}
  </h2>
  <div class="stance-strip" id="stance-strip">
    <div class="stance-card lane-act" data-stance="act"><span class="sc-accent"></span>
      <div class="sc-top"><span class="sc-dot">🟢</span><span class="sc-label">{{ t('Buy now', '现在买入') }}</span></div>
      <div class="sc-count" data-count="act">0</div>
      <div class="sc-sub">{{ t('reclaimed on durable volume', '放量收复') }}</div>
    </div>
    <div class="stance-card lane-ready" data-stance="get_ready"><span class="sc-accent"></span>
      <div class="sc-top"><span class="sc-dot">🔵</span><span class="sc-label">{{ t('Almost ready', '即将就绪') }}</span></div>
      <div class="sc-count" data-count="get_ready">0</div>
      <div class="sc-sub">{{ t('base built, awaiting reclaim', '底部已成，待收复') }}</div>
    </div>
    <div class="stance-card lane-fav" data-stance="in_favour"><span class="sc-accent"></span>
      <div class="sc-top"><span class="sc-dot">🏃</span><span class="sc-label">{{ t('In favour', '走势占优') }}</span></div>
      <div class="sc-count" data-count="in_favour">0</div>
      <div class="sc-sub">{{ t('trending — ride, no fresh chase', '趋势中——持有不追') }}</div>
    </div>
    <div class="stance-card lane-profit" data-stance="take_profits"><span class="sc-accent"></span>
      <div class="sc-top"><span class="sc-dot">🟠</span><span class="sc-label">{{ t('Take profits', '获利了结') }}</span></div>
      <div class="sc-count" data-count="take_profits">0</div>
      <div class="sc-sub">{{ t('stretched into resistance', '冲高至阻力') }}</div>
    </div>
    <div class="stance-card lane-watch" data-stance="watch"><span class="sc-accent"></span>
      <div class="sc-top"><span class="sc-dot">👀</span><span class="sc-label">{{ t("Watch — don't chase", '观望——勿追') }}</span></div>
      <div class="sc-count" data-count="watch">0</div>
      <div class="sc-sub">{{ t('moving without a base', '无底部的异动') }}</div>
    </div>
    <div class="stance-card lane-aside" data-stance="stand_aside"><span class="sc-accent"></span>
      <div class="sc-top"><span class="sc-dot">⚪</span><span class="sc-label">{{ t('Stand aside', '暂时观望') }}</span></div>
      <div class="sc-count" data-count="stand_aside">0</div>
      <div class="sc-sub">{{ t('quiet — no setup', '平静——无布局') }}</div>
    </div>
  </div>
</div>

<!-- Toolbar: basket filters + view toggle + search -->
<div class="panel" style="padding:10px 16px">
  <div class="toolbar">
    <span class="chip active" data-basket="all">{{ t('All', '全部') }}</span>
    <span class="chip" data-basket="mag7">Mag7</span>
    <span class="chip" data-basket="ai_infra">{{ t('AI Infra', 'AI基础') }}</span>
    <span class="chip" data-basket="ai_software">{{ t('AI Software', 'AI软件') }}</span>
    <span class="chip" data-basket="ai_semiconductors">{{ t('AI Semis', 'AI芯片') }}</span>
    <span class="chip" data-basket="semicap_equipment">{{ t('Semicap', '设备') }}</span>
    <span class="chip" data-basket="reshoring">{{ t('Reshoring', '回流') }}</span>
    <span class="chip" data-basket="defense">{{ t('Defense', '国防') }}</span>
    <span class="chip" data-basket="power_grid">{{ t('Power Grid', '电网') }}</span>
    <span class="toggle-btn active" id="group-toggle">{{ t('Group by call', '按结论分组') }}</span>
    <div class="search-box">
      {# EN in placeholder, ZH in data-ph-zh — never dual-language spans inside an attribute. #}
      <input type="text" id="ift-search" placeholder="Ticker search…" data-ph-zh="搜索代码…" autocomplete="off">
    </div>
    <span class="stamp-row xs muted" id="sort-label">{{ t('Most active first', '最活跃优先') }}</span>
  </div>
</div>

<!-- Leaders table -->
<div class="panel">
  <div class="leaders-wrap">
    <table class="leaders" id="leaders-table">
      <thead>
        <tr>
          <th data-col="ticker" class="col-ticker">{{ t('Name', '代码') }}<span class="sort-ic"></span></th>
          <th data-col="stance" class="col-stance">{{ t('The call', '结论') }}<span class="sort-ic"></span></th>
          <th data-col="last" class="col-last hide-narrow">{{ t('Price', '价格') }}<span class="sort-ic"></span></th>
          <th data-col="rvol" class="sort-desc col-rvol">{{ t('Volume', '成交量') }}{{ help('Today\'s volume vs a normal day at this exact time. “2.4× normal” means 2.4 times the usual pace. “Holding” = buyers keep closing bars in the upper half on above-normal volume.', '今日成交量与该时段正常水平之比。“2.4×正常”即为通常速度的2.4倍。“持稳”=买盘持续将K线收在上半段且量高于正常。') }}<span class="sort-ic"></span></th>
          <th data-col="tape" class="col-tape hide-narrow">{{ t('Tape', '盘口') }}{{ help('Where price sits vs the session’s average price (VWAP) and whether the options tape is leaning call-heavy or put-heavy. The options lean is approximate (~soft) — a lean, not a confirmation.', '价格相对当日均价（VWAP）的位置，以及期权带偏看涨还是看跌。期权倾向为近似（~软性）——只作倾向，不作确认。') }}</th>
          <th data-col="dealer" class="col-dealer hide-narrow">{{ t('Dealer map', '做市商地图') }}{{ help('From daily options chains: the nearby ceiling/floor levels dealers defend, the day’s expected move, and whether price is being pinned. A levels-and-timing map for stops — never a direction call, and single-name gamma is a near-constant product trait, not a signal.', '来自每日期权链：做市商防守的上方天花板/下方地板价位、当日预期波动幅度、以及价格是否被钉住。仅为止损用的价位与择时地图——非方向判断；单只标的gamma为近乎恒定的产品属性，非信号。') }}</th>
          <th data-col="expand" class="col-expand"></th>
        </tr>
