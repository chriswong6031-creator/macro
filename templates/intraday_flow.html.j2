  return '<div class="dl">'+dl.join('')+'</div>'+(posture?'<p class="posture">'+posture+'</p>':'')+pin+caveat;
}
function ivBandWord(b){ var m={ very_cheap:lz('very cheap','很便宜'), cheap:lz('cheap','便宜'), normal:lz('normal','正常'), elevated:lz('elevated','偏高'), rich:lz('rich','昂贵') }; return m[b]||esc(b); }
function skewWord(t){ var m={ fear:lz('downside fear bid','下行恐慌买盘'), greed:lz('upside chased','上行追捧'), balanced:lz('balanced','均衡') }; return m[t]||esc(t); }
function evidenceWord(q){ var m={ full:lz('full','完整'), partial:lz('partial','部分'), thin:lz('thin','稀薄'), stale:lz('stale','过时') }; return m[q]||lz('—','—'); }

// ── Stance counts + strip ──────────────────────────────────────────────────
function updateStanceCounts() {
  var counts = { act:0, get_ready:0, in_favour:0, take_profits:0, watch:0, stand_aside:0 };
  var rows = document.querySelectorAll('#leaders-body tr.lead-row');
  rows.forEach(function(r){ var s = r.getAttribute('data-stance'); if (counts[s]!=null) counts[s]++; });
  Object.keys(counts).forEach(function(k){ var el = document.querySelector('[data-count="'+k+'"]'); if (el) el.textContent = counts[k]; });
}

// ── Sort / filter / group ──────────────────────────────────────────────────
var COL_ATTR = { ticker:'data-ticker', last:'data-last', rvol:'data-rvol', stance:'data-stance-order', dealer:'data-rvol' };
function sortRows(rows) {
  var attr = COL_ATTR[sortCol] || 'data-rvol';
  rows.sort(function(a,b){
    if (groupByStance) {
      var ao = Number(a.getAttribute('data-stance-order')||9), bo = Number(b.getAttribute('data-stance-order')||9);
      if (ao !== bo) return ao - bo;   // group order fixed; sort within by measured
      var ar = Number(a.getAttribute('data-rvol')||0), br = Number(b.getAttribute('data-rvol')||0);
      return br - ar;
    }
    var av = a.getAttribute(attr)||'0', bv = b.getAttribute(attr)||'0';
    var an = isNaN(av)?av:Number(av), bn = isNaN(bv)?bv:Number(bv);
    if (an < bn) return sortDir; if (an > bn) return -sortDir; return 0;
  });
  return rows;
}
function applyView() {
  var tbody = document.getElementById('leaders-body');
  if (!tbody) return;
  // drop stale group headers from a prior view (standalone filter/sort re-runs)
  [].slice.call(tbody.querySelectorAll('tr.group-head')).forEach(function(g){ g.parentNode.removeChild(g); });
  // pair each lead-row with its detail-row
  var leadRows = [].slice.call(tbody.querySelectorAll('tr.lead-row'));
  var detailByTk = {};
  [].slice.call(tbody.querySelectorAll('tr.detail-row')).forEach(function(d){ detailByTk[d.getAttribute('data-detail')] = d; });
  sortRows(leadRows);
  var visible = 0, curGroup = null, frag = document.createDocumentFragment();
  leadRows.forEach(function(r){
    var tk = r.getAttribute('data-ticker'), k = Number(r.getAttribute('data-k')||0);
    var st = r.getAttribute('data-stance'), baskets = r.getAttribute('data-baskets')||'all';
    var show = true;
    if (activeBasket !== 'all' && baskets.indexOf(activeBasket) < 0 && baskets !== 'all') show = false;
    if (activeStance !== 'all' && st !== activeStance) show = false;
    if (searchQ && tk.indexOf(searchQ.toUpperCase()) < 0) show = false;
    if (!show) { r.style.display='none'; if (detailByTk[tk]) detailByTk[tk].style.display='none'; return; }
    if (groupByStance && st !== curGroup) {
      curGroup = st;
      var meta = STANCE_META[st] || STANCE_META.stand_aside;
      var gh = document.createElement('tr'); gh.className='group-head';
      gh.innerHTML = '<td colspan="7">'+meta.dot+' '+lz(meta.en, meta.zh)+'</td>';
      frag.appendChild(gh);
    }
    r.style.display=''; frag.appendChild(r);
    if (detailByTk[tk]) { detailByTk[tk].style.display=''; frag.appendChild(detailByTk[tk]); }
    visible++;
  });
  tbody.appendChild(frag);
  var lbl = document.getElementById('count-label');
  if (lbl) lbl.innerHTML = lz(visible+' of '+leadRows.length+' leaders shown', '显示 '+visible+' / '+leadRows.length+' 只');
  var ths = document.querySelectorAll('table.leaders th[data-col]');
  ths.forEach(function(th){ th.classList.remove('sort-asc','sort-desc'); if (!groupByStance && th.getAttribute('data-col')===sortCol) th.classList.add(sortDir<0?'sort-desc':'sort-asc'); });
}

// ── Full render ────────────────────────────────────────────────────────────
var _rendering = false;
function render() {
  if (_rendering) return; _rendering = true;
  var tbody = document.getElementById('leaders-body');
  if (!tbody) { _rendering = false; return; }
  // cache options_entry for detail (dealer._tk/_eq threading)
  var html = '';
  leaders.forEach(function(l){
    var d = dealerOf(l);
    if (d) { d._tk = l.ticker; d._eq = (l.options_entry||{}).evidence_quality; }
    html += buildRow(l);
  });
  tbody.innerHTML = html || '<tr class="loading-row"><td colspan="7">'+lz('No data yet','暂无数据')+'</td></tr>';
  applyView();
  updateStanceCounts();
  if (window.__mmLang) window.__mmLang();
  _rendering = false;
}

// ── Events ─────────────────────────────────────────────────────────────────
document.querySelectorAll('.playbook-hd').forEach(function(hd){
  hd.addEventListener('click', function(){ hd.parentElement.classList.toggle('open'); });
});
document.querySelectorAll('table.leaders th[data-col]').forEach(function(th){
  th.addEventListener('click', function(){
    var col = th.getAttribute('data-col');
    if (col === 'expand' || col === 'tape' || col === 'dealer') return;
    if (groupByStance) { groupByStance = false; setGroupToggle(false); }
    if (col === sortCol) sortDir = -sortDir; else { sortCol = col; sortDir = -1; }
    applyView();
    var sl = document.getElementById('sort-label'); if (sl) sl.textContent = '';
  });
});
document.querySelectorAll('.chip[data-basket]').forEach(function(chip){
  chip.addEventListener('click', function(){
    document.querySelectorAll('.chip[data-basket]').forEach(function(c){ c.classList.remove('active'); });
    chip.classList.add('active'); activeBasket = chip.getAttribute('data-basket'); applyView();
  });
});
document.querySelectorAll('.stance-card[data-stance]').forEach(function(card){
  card.addEventListener('click', function(){
    var s = card.getAttribute('data-stance');
    if (activeStance === s) { activeStance = 'all'; card.classList.remove('active'); }
    else { document.querySelectorAll('.stance-card').forEach(function(c){ c.classList.remove('active'); }); activeStance = s; card.classList.add('active'); }
    applyView();
  });
});
var groupToggle = document.getElementById('group-toggle');
function setGroupToggle(on){ groupByStance = on; if (groupToggle) groupToggle.classList.toggle('active', on); }
if (groupToggle) groupToggle.addEventListener('click', function(){ setGroupToggle(!groupByStance); applyView(); });
document.getElementById('leaders-body').addEventListener('click', function(e){
  var exp = e.target.closest ? e.target.closest('.expander') : null;
  if (!exp) return;
  var tk = exp.getAttribute('data-exp');
  openRows[tk] = !openRows[tk];
  exp.textContent = openRows[tk] ? '▾' : '▸';
  var dr = document.querySelector('tr.detail-row[data-detail="'+tk+'"]');
  if (dr) dr.classList.toggle('open', openRows[tk]);
});
var searchEl = document.getElementById('ift-search');
if (searchEl) {
  searchEl.addEventListener('input', function(){ searchQ = searchEl.value.trim(); applyView(); });
  (function(){ var en=searchEl.placeholder, zh=searchEl.getAttribute('data-ph-zh')||en;
    function setPh(){ searchEl.placeholder = document.documentElement.getAttribute('data-lang')==='zh'?zh:en; }
    setPh(); document.addEventListener('langchange', setPh); })();
}

// ── Polling ────────────────────────────────────────────────────────────────
function startPolling() {
  fetchQuotes(); fetchPulse(); fetchFlow(); updateFlowStamp(null);
  setInterval(fetchQuotes, 60*1000);
  setInterval(fetchPulse, 5*60*1000);
  setInterval(function(){ if (isMarketHours()) fetchFlow(); }, 3*60*1000);
}
setGroupToggle(true);
render();
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', startPolling);
else startPolling();

})();
</script>
<script src="theme.js"></script>
</body>
</html>
