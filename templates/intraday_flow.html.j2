{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro help(en, zh='') -%}
<span class="help">?<span class="tip"><span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span></span></span>
{%- endmacro %}
{% set ift = intraday_flow if intraday_flow else {} %}
{% set leaders = ift.leaders if ift.leaders else [] %}
{% set rvol_confirm = ift.rvol_confirm if ift.rvol_confirm is defined else 1.30 %}
{% set dur_min = ift.durability_min if ift.durability_min is defined else 0.60 %}
{% set washout_lb = ift.washout_lookback if ift.washout_lookback is defined else 10 %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Intraday Flow · 盘中资金流</title>
{% set seo_title = "Intraday Flow Tracker — Mastermind" %}{% set seo_desc = "Which washed-out market leaders (Mag 7, AI, semis, defense, power grid) are being bought back on real volume right now — with a plain-word call on each." %}{% set seo_path = "intraday_flow.html" %}
{% include "_seo_head.html.j2" %}
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  /* ══ Intraday Flow — mx5 desk design (macro.html visual language, kinetic-desk signature) ══ */
  * { box-sizing:border-box; }
  body.page-intraday-flow {
    /* deeper canvas + strict mono/type scale, macro parity */
    --bg:#0a0c11; --panel:#14171e; --panel2:#1b1f28;
    --num:var(--font-mono, ui-monospace, "SF Mono", SFMono-Regular, "Cascadia Mono", "JetBrains Mono", "Roboto Mono", Menlo, Consolas, monospace);
    --fs-display:44px; --fs-num-xl:38px; --fs-h1:27px; --fs-num-lg:22px;
    --fs-h2:17px; --fs-md:15px; --fs-body:14px; --fs-sm:12.5px; --fs-label:11px; --fs-micro:10px;
    --hair:color-mix(in srgb, var(--line) 70%, transparent);
    --hair-strong:var(--line);
    --glass:color-mix(in srgb, var(--panel) 62%, transparent);
    --glass-2:color-mix(in srgb, var(--panel2) 70%, transparent);
    --glass-line:color-mix(in srgb, #fff 9%, transparent);
    --glass-sh:0 10px 34px -8px rgba(0,0,0,.55), 0 1.5px 0 rgba(255,255,255,.05) inset;
    --blur:blur(18px) saturate(150%);
    --trk:.16em;
    --rail:var(--info,#5b9bf0);
    background:var(--bg); color:var(--text);
    font:var(--fs-body)/1.5 var(--font-ui,-apple-system,"Segoe UI",Roboto,Helvetica,sans-serif);
    margin:0; padding:18px;
  }
  html[data-theme="light"] body.page-intraday-flow {
    --bg:#f5f7fb; --panel:#ffffff; --panel2:#eef1f6;
    --glass:color-mix(in srgb, #ffffff 72%, transparent);
    --glass-2:color-mix(in srgb, #ffffff 80%, transparent);
    --glass-line:color-mix(in srgb, #1c2430 8%, transparent);
    --glass-sh:0 10px 30px -10px rgba(20,30,50,.16), 0 1px 0 rgba(255,255,255,.7) inset;
  }
  @media (min-width:1100px){ body.page-intraday-flow{ padding:24px max(40px,calc((100vw - 1440px)/2)); } }
  a { text-decoration:none; color:inherit; }
  .muted { color:var(--muted); } .sm { font-size:var(--fs-sm); } .xs { font-size:var(--fs-micro); }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .tabnum, .num { font-variant-numeric:tabular-nums; font-family:var(--num); }
  .soft-tag { display:inline-block; font-size:9.5px; font-style:italic; color:var(--orange,#e08b45); margin-left:3px; vertical-align:1px; }
  .delayed-tag { display:inline-block; font-size:var(--fs-micro); background:color-mix(in srgb,var(--panel2) 70%,transparent); border:1px solid var(--hair); border-radius:5px; padding:1px 6px; color:var(--muted); letter-spacing:.02em; }

  /* help ? tip (Tier-2 home) */
  .help { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border-radius:50%; border:1px solid var(--muted); color:var(--muted); font-size:10px; font-weight:600; cursor:help; position:relative; vertical-align:middle; margin-left:4px; }
  .help .tip { display:none; position:absolute; top:150%; left:50%; transform:translateX(-50%); width:290px; background:var(--panel); border:1px solid var(--line); padding:10px 12px; border-radius:10px; z-index:60; font-size:12px; line-height:1.5; color:var(--text); font-weight:400; box-shadow:var(--popover-shadow); max-height:min(60vh,420px); overflow-y:auto; overscroll-behavior:contain; text-align:left; white-space:normal; }
  .help:hover::before { content:''; position:absolute; top:100%; left:-30px; right:-30px; height:12px; }
  .help:hover .tip { display:block; }

  /* ── state-tinted aurora backdrop ─────────────────────────────── */
  .ift-aurora { position:fixed; inset:0; z-index:-1; pointer-events:none; overflow:hidden; }
  .ift-aurora::before, .ift-aurora::after { content:""; position:absolute; border-radius:50%; filter:blur(95px); transition:background 1.4s ease, opacity 1.4s ease; }
  .ift-aurora::before { width:920px; height:720px; top:-230px; left:-170px; background:radial-gradient(ellipse, var(--au-1, rgba(61,165,100,.13)) 0%, transparent 70%); }
  .ift-aurora::after  { width:780px; height:640px; bottom:-150px; right:-130px; background:radial-gradient(ellipse, var(--au-2, rgba(91,155,240,.10)) 0%, transparent 70%); }
  body.tape-green { --au-1:rgba(61,165,100,.15); --au-2:rgba(91,155,240,.11); }
  body.tape-blue  { --au-1:rgba(91,155,240,.14); --au-2:rgba(140,110,240,.11); }
  body.tape-amber { --au-1:rgba(224,139,69,.14); --au-2:rgba(224,160,48,.10); }
  body.tape-quiet { --au-1:rgba(120,132,148,.10); --au-2:rgba(91,110,140,.09); }

  /* ── generic panel / section header (macro idiom) ─────────────── */
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:18px 20px; margin-bottom:18px; }
  .glass { background:var(--glass); -webkit-backdrop-filter:var(--blur); backdrop-filter:var(--blur); border:1px solid var(--glass-line); box-shadow:var(--glass-sh); }
  .sect-h { display:flex; align-items:center; gap:11px; flex-wrap:wrap; margin:0 0 15px; padding:0 0 12px; border-bottom:1px solid var(--hair-strong); font-size:var(--fs-h2); font-weight:700; letter-spacing:-.01em; }
  .sect-h::before { content:""; flex:none; width:3px; height:18px; border-radius:2px; background:linear-gradient(180deg, var(--rail), color-mix(in srgb, var(--rail) 30%, transparent)); }
  .sect-note { font-size:var(--fs-sm); font-weight:500; color:var(--muted); letter-spacing:0; }
  .sect-h .help { margin-left:0; }

  /* ══ HERO — Session Pulse ══════════════════════════════════════ */
  .ift-hero { position:relative; border-radius:22px; padding:22px 26px 24px; margin-bottom:18px; overflow:hidden; }
  .ift-hero::after { content:""; position:absolute; inset:0; border-radius:inherit; pointer-events:none; background:linear-gradient(160deg, rgba(255,255,255,.04) 0%, transparent 46%); }
  .hero-inner { position:relative; z-index:1; }
  .hero-eyebrow { display:flex; align-items:center; gap:9px; flex-wrap:wrap; font-size:var(--fs-label); font-weight:700; letter-spacing:var(--trk); text-transform:uppercase; color:var(--muted); }
  .sess-pill { display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:100px; border:1px solid color-mix(in srgb, var(--sess-c, var(--muted)) 40%, transparent); background:color-mix(in srgb, var(--sess-c, var(--muted)) 12%, transparent); color:var(--sess-c, var(--muted)); letter-spacing:.06em; }
  .live-dot { width:7px; height:7px; border-radius:50%; background:var(--sess-c, var(--muted)); box-shadow:0 0 7px var(--sess-c, var(--muted)); }
  body .sess-live { --sess-c:var(--ok); }
  body .sess-pre  { --sess-c:var(--info); }
  body .sess-post { --sess-c:var(--orange); }
  body .sess-closed { --sess-c:var(--muted); }
  .sess-live .live-dot { animation:iftPulse 1.6s ease-in-out infinite; }
  .hero-thesis { font-size:var(--fs-h1); font-weight:800; line-height:1.2; letter-spacing:-.02em; margin:13px 0 0; max-width:34ch;
    background-image:linear-gradient(118deg, var(--t1,var(--muted)) 0%, var(--t2,#9aa6b6) 50%, var(--t3,var(--muted)) 92%);
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
  .thesis-green { --t1:var(--ok,#3da564); --t2:#5fc89a; --t3:var(--info,#5b9bf0); }
  .thesis-blue  { --t1:var(--info,#5b9bf0); --t2:#7db0f5; --t3:#9d7cf0; }
  .thesis-amber { --t1:var(--orange,#e08b45); --t2:var(--warn,#e0a030); --t3:var(--info,#5b9bf0); }
  .thesis-slate { --t1:var(--muted); --t2:#9aa6b6; --t3:var(--muted); }
  .hero-sub { font-size:var(--fs-md); color:var(--text); margin:9px 0 0; max-width:60ch; line-height:1.5; }
  .hero-grid { display:grid; grid-template-columns:minmax(0,auto) 1fr; gap:20px 34px; align-items:center; margin-top:20px; }
  @media (max-width:720px){ .hero-grid { grid-template-columns:1fr; gap:16px; } }

  /* score block */
  .hero-score { min-width:230px; }
  .hs-top { display:flex; align-items:flex-end; gap:12px; }
  .hs-num { font-family:var(--num); font-size:64px; font-weight:800; line-height:.92; letter-spacing:-.04em; color:var(--score-c, var(--muted)); text-shadow:0 0 46px color-mix(in srgb, var(--score-c, var(--muted)) 34%, transparent); }
  .hs-label { display:flex; flex-direction:column; padding-bottom:5px; }
  .hs-l1 { font-size:var(--fs-sm); font-weight:700; color:var(--text); }
  .hs-l2 { font-size:var(--fs-micro); color:var(--muted); margin-top:1px; }
  /* composition ribbon — the session's shape */
  .comp { display:flex; height:12px; border-radius:7px; overflow:hidden; margin-top:16px; background:color-mix(in srgb,var(--muted) 14%,transparent); border:1px solid var(--hair); }
  .comp-seg { height:100%; min-width:0; background:var(--lane,var(--muted)); transition:flex .7s cubic-bezier(.4,0,.2,1); position:relative; }
  .comp-seg + .comp-seg { border-left:1px solid color-mix(in srgb,var(--bg) 55%,transparent); }
  .comp-legend { display:flex; flex-wrap:wrap; gap:4px 13px; margin-top:9px; font-size:var(--fs-micro); }
  .cl-item { display:inline-flex; align-items:center; gap:5px; color:var(--muted); }
  .cl-dot { width:8px; height:8px; border-radius:3px; background:var(--lane,var(--muted)); }

  /* context card */
  .hero-ctx { display:flex; flex-direction:column; gap:7px; align-self:center; padding-left:26px; border-left:1px solid var(--hair); min-width:0; }
  @media (max-width:720px){ .hero-ctx { padding-left:0; border-left:0; border-top:1px solid var(--hair); padding-top:14px; } }
  .ctx-row { display:flex; align-items:baseline; gap:8px; font-size:var(--fs-sm); line-height:1.45; }
  .ctx-row .ctx-ic { flex:none; font-size:12px; opacity:.9; }
  .ctx-row b { font-family:var(--num); font-weight:700; letter-spacing:-.01em; }
  .ctx-stamp { font-size:var(--fs-micro); color:var(--muted); margin-top:2px; }

  /* ══ "What's set up now" stance strip ══════════════════════════ */
  .stance-strip { display:flex; flex-wrap:wrap; gap:9px; }
  .stance-card { flex:1 1 145px; min-width:132px; border:1px solid var(--glass-line); border-radius:13px; padding:11px 13px; cursor:pointer; user-select:none; background:var(--glass-2); -webkit-backdrop-filter:var(--blur); backdrop-filter:var(--blur); transition:border-color .16s, transform .12s, box-shadow .2s; position:relative; overflow:hidden; }
  .stance-card::before { content:""; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--lane); }
  .stance-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--lane) 55%,transparent); box-shadow:0 8px 22px -12px color-mix(in srgb,var(--lane) 60%,transparent); }
  .stance-card.active { border-color:var(--lane); box-shadow:inset 0 0 0 1px var(--lane), 0 8px 22px -12px color-mix(in srgb,var(--lane) 55%,transparent); }
  .stance-card .sc-top { display:flex; align-items:center; gap:6px; }
  .stance-card .sc-dot { width:9px; height:9px; border-radius:50%; background:var(--lane); box-shadow:0 0 8px color-mix(in srgb,var(--lane) 70%,transparent); }
  .stance-card .sc-label { font-size:12.5px; font-weight:700; }
  .stance-card .sc-count { font-family:var(--num); font-size:27px; font-weight:800; margin-top:5px; line-height:1; color:var(--lane); }
  .stance-card .sc-sub { font-size:var(--fs-micro); color:var(--muted); margin-top:3px; line-height:1.3; }
  /* lane colors — stance/mood colors are fixed across languages (only in_favour flips, per ruling) */
  .lane-act    { --lane:var(--ok,#3da564); }
  .lane-ready  { --lane:var(--info,#5b9bf0); }
  .lane-fav    { --lane:#3fb37a; }
  html[data-lang="zh"] .lane-fav { --lane:#e06464; }
  .lane-profit { --lane:var(--orange,#e08b45); }
  .lane-watch  { --lane:var(--warn,#e0a030); }
  .lane-aside  { --lane:var(--muted); }

  /* ══ Spotlight — "Look here first" ═════════════════════════════ */
  .spot-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(268px,1fr)); gap:14px; }
  .spot-card { position:relative; border:1px solid color-mix(in srgb,var(--lane) 34%,var(--glass-line)); border-top-color:color-mix(in srgb,var(--lane) 55%,rgba(255,255,255,.4)); border-radius:15px; padding:15px 16px 16px; background:var(--glass-2); -webkit-backdrop-filter:var(--blur); backdrop-filter:var(--blur); box-shadow:0 10px 30px -14px color-mix(in srgb,var(--lane) 45%,transparent), var(--glass-sh); overflow:hidden; }
  .spot-card::before { content:""; position:absolute; inset:0; border-radius:inherit; pointer-events:none; box-shadow:0 0 44px -12px color-mix(in srgb,var(--lane) 40%,transparent) inset; }
  .spot-hd { display:flex; align-items:center; justify-content:space-between; gap:8px; }
  .spot-tk { font-family:var(--num); font-size:20px; font-weight:800; letter-spacing:-.01em; color:var(--text); }
  .spot-tk:hover { color:var(--lane); }
  .spot-tk-sub { font-size:var(--fs-micro); color:var(--muted); margin-top:0; }
  .spot-reason { font-size:var(--fs-sm); color:var(--text); line-height:1.42; margin:11px 0 0; }
  .spot-metrics { display:grid; grid-template-columns:1fr 1fr; gap:8px 12px; margin-top:13px; padding-top:12px; border-top:1px solid var(--hair); }
  .sm-k { display:block; font-size:9.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }
  .sm-v { display:block; font-size:12.5px; font-weight:600; margin-top:1px; font-variant-numeric:tabular-nums; }
  .spot-empty { padding:22px; text-align:center; color:var(--muted); font-size:var(--fs-md); line-height:1.6; }
  .spot-empty b { color:var(--text); font-weight:700; }

  /* stance pill (shared) */
  .stance-pill { display:inline-flex; align-items:center; gap:5px; font-size:11.5px; font-weight:800; padding:3px 10px; border-radius:100px; border:1px solid color-mix(in srgb,var(--lane) 45%,transparent); background:color-mix(in srgb,var(--lane) 13%,transparent); color:var(--lane); white-space:nowrap; }
  .stance-pill .sp-dot { width:7px; height:7px; border-radius:50%; background:var(--lane); }

  /* ══ Board (toolbar merged into header) ════════════════════════ */
  .board-tools { display:flex; flex-wrap:wrap; gap:7px; align-items:center; margin-left:auto; }
  .chip { display:inline-flex; align-items:center; font-size:11px; padding:4px 10px; border-radius:100px; border:1px solid var(--glass-line); cursor:pointer; user-select:none; background:var(--glass-2); color:var(--muted); transition:background .15s,border-color .15s,color .15s; }
  .chip.active { background:color-mix(in srgb,var(--rail) 20%,transparent); border-color:var(--rail); color:var(--text); }
  .chip:hover:not(.active) { border-color:var(--muted); color:var(--text); }
  .toggle-btn { font-size:11px; padding:4px 11px; border-radius:100px; border:1px solid var(--glass-line); cursor:pointer; user-select:none; background:var(--glass-2); color:var(--muted); display:inline-flex; align-items:center; gap:5px; }
  .toggle-btn::before { content:""; width:7px; height:7px; border-radius:50%; border:1px solid var(--muted); }
  .toggle-btn.active { color:var(--text); border-color:var(--rail); }
  .toggle-btn.active::before { background:var(--rail); border-color:var(--rail); }
  .search-box { position:relative; }
  .search-box input { width:150px; background:var(--glass-2); border:1px solid var(--glass-line); color:var(--text); border-radius:100px; padding:5px 12px; font-size:12px; outline:none; }
  .search-box input:focus { border-color:var(--rail); width:180px; }
  .basket-scroll { display:flex; gap:6px; flex-wrap:wrap; }

  .leaders-wrap { overflow-x:auto; }
  table.leaders { width:100%; border-collapse:collapse; font-size:13px; }
  table.leaders th { padding:9px 11px; text-align:left; font-size:var(--fs-micro); font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); border-bottom:1px solid var(--hair-strong); cursor:pointer; white-space:nowrap; user-select:none; }
  table.leaders th:hover { color:var(--text); }
  table.leaders th .sort-ic { display:inline-block; margin-left:3px; opacity:.4; }
  table.leaders th.sort-asc .sort-ic::after { content:"↑"; opacity:1; }
  table.leaders th.sort-desc .sort-ic::after { content:"↓"; opacity:1; }
  table.leaders th:not(.sort-asc):not(.sort-desc) .sort-ic::after { content:"↕"; }
  table.leaders td { padding:9px 11px; border-bottom:1px solid var(--hair); vertical-align:top; }
  table.leaders tr.lead-row { transition:background .12s; }
  table.leaders tr.lead-row:hover td { background:color-mix(in srgb,var(--panel2) 60%,transparent); }
  table.leaders tr.group-head td { background:transparent; font-weight:700; font-size:var(--fs-micro); text-transform:uppercase; letter-spacing:.06em; color:var(--lane,var(--muted)); padding:14px 11px 6px; border-bottom:1px solid color-mix(in srgb,var(--lane,var(--line)) 30%,transparent); }
  table.leaders tr.group-head .gh-dot { display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--lane); margin-right:6px; vertical-align:middle; box-shadow:0 0 7px color-mix(in srgb,var(--lane) 70%,transparent); }
  .tk-link { font-family:var(--num); font-weight:700; font-size:14px; color:var(--text); }
  .tk-link:hover { color:var(--rail); text-decoration:underline; }
  .tk-baskets { font-size:9.5px; color:var(--muted); margin-top:2px; text-transform:uppercase; letter-spacing:.03em; }
  .price-cell { white-space:nowrap; font-variant-numeric:tabular-nums; }
  .pct-chg { font-size:11px; margin-left:4px; font-variant-numeric:tabular-nums; }
  .expander { cursor:pointer; color:var(--muted); font-size:12px; user-select:none; padding:3px 6px; border-radius:6px; border:1px solid transparent; }
  .expander:hover { color:var(--text); background:var(--panel2); border-color:var(--hair); }

  .stance-cell { min-width:212px; }
  .stance-reason { font-size:11.5px; color:var(--text); margin-top:4px; line-height:1.35; max-width:330px; }
  .stance-reason.muted { color:var(--muted); }

  .metric-lead { font-size:12.5px; }
  .metric-sub { font-size:var(--fs-micro); color:var(--muted); margin-top:2px; }
  .gauge-wrap { display:flex; align-items:center; gap:7px; white-space:nowrap; }
  .gauge-bar { width:50px; height:6px; background:color-mix(in srgb,var(--muted) 18%,transparent); border-radius:4px; overflow:hidden; flex-shrink:0; }
  .gauge-fill { height:100%; border-radius:4px; background:var(--info,#5b9bf0); }
  .gauge-hi { background:var(--ok,#3da564); } .gauge-med { background:var(--orange,#e08b45); } .gauge-lo { background:var(--muted); }

  .chip-row { display:flex; flex-wrap:wrap; gap:3px; margin-top:3px; }
  .badge { display:inline-block; font-size:9.5px; font-weight:600; padding:2px 6px; border-radius:5px; border:1px solid; white-space:nowrap; }
  .badge-blue { color:var(--info,#5b9bf0); border-color:color-mix(in srgb,var(--info) 45%,transparent); background:color-mix(in srgb,var(--info) 10%,transparent); }

  .dealer-cell { min-width:150px; font-size:11.5px; }
  .dealer-line { line-height:1.42; }
  .regime-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px; vertical-align:middle; }
  .rd-long { background:var(--info); } .rd-short { background:var(--orange); } .rd-neutral { background:var(--muted); }
  .dealer-na { color:var(--muted); font-style:italic; }

  /* expanded Tier-2 detail */
  tr.detail-row td { background:color-mix(in srgb,var(--panel2) 55%,transparent); padding:0; border-bottom:1px solid var(--hair); }
  .detail-inner { display:none; padding:16px 18px; }
  tr.detail-row.open .detail-inner { display:grid; grid-template-columns:repeat(auto-fit,minmax(238px,1fr)); gap:15px; }
  .detail-block { background:var(--panel); border:1px solid var(--hair); border-radius:12px; padding:13px 14px; }
  .detail-block h4 { font-size:var(--fs-micro); text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin:0 0 8px; font-weight:700; }
  .detail-block .dl { display:grid; grid-template-columns:auto 1fr; gap:3px 12px; font-size:12px; }
  .detail-block .dl .k { color:var(--muted); }
  .detail-block .dl .v { text-align:right; font-variant-numeric:tabular-nums; font-family:var(--num); }
  .posture { font-size:12px; line-height:1.55; margin:8px 0 0; color:var(--text); }
  .receipt { font-size:10.5px; color:var(--muted); margin-top:7px; font-style:italic; line-height:1.5; }
  .checks { display:flex; flex-wrap:wrap; gap:5px 9px; }
  .check { display:inline-flex; align-items:center; gap:4px; font-size:11px; }
  .check .ic { font-weight:700; }
  .check.on { color:var(--ok,#3da564); } .check.off { color:var(--muted); } .check.na { color:var(--muted); opacity:.6; }

  /* ══ Field guide accordion ═════════════════════════════════════ */
  .playbook-section { border:1px solid var(--hair); border-radius:12px; overflow:hidden; margin-bottom:9px; background:color-mix(in srgb,var(--panel2) 40%,transparent); }
  .playbook-hd { display:flex; align-items:center; justify-content:space-between; padding:12px 15px; cursor:pointer; font-weight:600; font-size:13px; user-select:none; }
  .playbook-hd:hover { background:var(--panel2); }
  .playbook-hd .caret { font-size:11px; color:var(--muted); transition:transform .2s; }
  .playbook-section.open .playbook-hd .caret { transform:rotate(90deg); }
  .playbook-body { display:none; padding:2px 15px 13px; font-size:13px; line-height:1.62; border-top:1px solid var(--hair); }
  .playbook-section.open .playbook-body { display:block; }
  .playbook-body ul { margin:8px 0 0 18px; padding:0; }
  .playbook-body li { margin-bottom:5px; }
  .foot-note { font-size:var(--fs-micro); color:var(--muted); margin-top:12px; line-height:1.55; }

  .loading-row td { color:var(--muted); font-style:italic; text-align:center; padding:26px; }

  /* ══ entrance / kinetic animations (reduced-motion gated) ══════ */
  @keyframes iftPulse { 0%,100%{ opacity:1; transform:scale(1);} 50%{ opacity:.4; transform:scale(.82);} }
  @keyframes iftRise { from{ opacity:0; transform:translateY(9px) scale(.99);} to{ opacity:1; transform:none;} }
  @keyframes iftBreathe { 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-2px);} }
  @media (prefers-reduced-motion:no-preference) {
    .reveal { animation:iftRise .5s cubic-bezier(.2,.7,.3,1) both; }
    .reveal-1{ animation-delay:.04s;} .reveal-2{ animation-delay:.10s;} .reveal-3{ animation-delay:.16s;}
    .spot-card { animation:iftRise .5s cubic-bezier(.2,.7,.3,1) both; }
    .spot-card:nth-child(2){ animation-delay:.07s;} .spot-card:nth-child(3){ animation-delay:.14s;}
    .spot-card.breathe { animation:iftRise .5s cubic-bezier(.2,.7,.3,1) both, iftBreathe 6s ease-in-out 1s infinite; }
  }
  @media (prefers-reduced-motion:reduce) { .sess-live .live-dot { animation:none; } }

  @media (max-width:820px) {
    body.page-intraday-flow { padding:14px; }
    .hero-thesis { font-size:22px; }
    .hs-num { font-size:52px; }
    table.leaders { font-size:12px; }
    table.leaders th, table.leaders td { padding:7px 8px; }
    .hide-narrow { display:none; }
    .stance-card { flex-basis:calc(50% - 5px); min-width:0; }
  }
</style>
</head>
