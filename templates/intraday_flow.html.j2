    <span class="xs muted" id="ift-quotes-stamp">{{ t('Quotes:', '报价：') }} <span class="l-en">loading…</span><span class="l-zh">加载中…</span></span>
    <span class="xs muted" id="ift-pulse-stamp">{{ t('Pulse:', '脉冲：') }} <span class="l-en">loading…</span><span class="l-zh">加载中…</span></span>
