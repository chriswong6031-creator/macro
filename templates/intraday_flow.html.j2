<!-- Leaders table -->
<div class="panel">
  <div class="leaders-wrap">
    <table class="leaders" id="leaders-table">
      <thead>
        <tr>
          <th data-col="ticker" class="col-ticker">{{ t('Ticker', '代码') }}<span class="sort-ic"></span></th>
          <th data-col="last" class="col-last">{{ t('Last / %Chg', '最新/涨跌') }}<span class="sort-ic"></span></th>
          <th data-col="rvol" class="sort-desc col-rvol">{{ t('RVOL', 'RVOL时段') }}{{ help('RVOL_tod = cumulative day volume ÷ (ADV20 × expected share at this time of day). ≥1.30 triggers L3.', 'RVOL_tod=当日累计成交量÷(ADV20×当前时段预期占比)。≥1.30触发L3。') }}<span class="sort-ic"></span></th>
          <th data-col="range_pos" class="col-range">{{ t('Day Range', '日内区间') }}<span class="sort-ic"></span></th>
          <th data-col="vwap_delta" class="col-vwap">{{ t('vs VWAP', '对VWAP') }}<span class="sort-ic"></span></th>
          <th data-col="vol_dur" class="col-voldur">{{ t('Vol Dur', '量持续') }}{{ help('Share of today\'s hourly bars closing upper-half with volume ≥ time-of-day baseline. ≥0.60 triggers L4.', '今日小时K收盘在上半段且成交量≥时段基准的比例。≥0.60触发L4。') }}<span class="sort-ic"></span></th>
          <th data-col="ncp" class="col-ncp">{{ t('~NCP / Flow', '~净看涨权利金/流速') }}{{ help('~net call premium is SOFT direction — approximate (minute tick-rule signing, RUL-F3.12). Flow velocity = slope of cumulative NCP vs session pace.', '~净看涨权利金方向软性近似（逐分钟打单，RUL-F3.12）。流速=累计NCP斜率vs当日均速。') }}<span class="sort-ic"></span></th>
          <th data-col="setup" class="col-setup">{{ t('Setup / Chips', '布局/标签') }}</th>
          <th data-col="k" class="col-k">{{ t('K/7', '汇聚K/7') }}{{ help('Boolean confluence count: L1 washout_recent · L2 reclaim · L3 rvol_elevated · L4 vol_durable · L5 flow_bid(~soft) · L6 upturn_organ · L7 leader_quality. No weighted score.', '布尔汇聚计数：L1洗盘近期·L2收复·L3放量·L4量持续·L5资金偏多(~软性)·L6上升器官·L7领涨质量。无加权分数。') }}<span class="sort-ic"></span></th>
          <th data-col="risk" class="col-risk">{{ t('Ref Levels', '参考价位') }}{{ help('Reference levels only — not trade advice. Entry stop from nightly entry_signal; session VWAP from fastpath; session low from price bars.', '仅供参考，不构成交易建议。入场止损来自夜间entry_signal；VWAP来自实时快速路径；日内低点来自价格数据。') }}</th>
        </tr>
