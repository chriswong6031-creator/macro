{% block body_scripts %}
<script>
/* Full-book column sort — the th data-col + tr data-attr idiom (desk convention:
   sort by row dataset values, numeric when parseable, re-append rows in order;
   rows with missing values always sink to the bottom). */
(function () {
  var tbody = document.getElementById('fd-book-body');
  if (!tbody) return;
  var TEXT_COLS = { ticker: 1, issuer: 1, act: 1, sector: 1 };
  var sortCol = null, sortAsc = true;
  window.fdSort = function (col) {
    if (sortCol === col) { sortAsc = !sortAsc; }
    else { sortCol = col; sortAsc = !!TEXT_COLS[col]; } /* text asc-first, numeric desc-first */
    document.querySelectorAll('#fd-book th').forEach(function (th) {
      th.classList.remove('sorted');
      var ind = th.querySelector('.sort-ind');
      if (ind) ind.textContent = '↕';
    });
    var th = document.querySelector('#fd-book th[data-col="' + col + '"]');
    if (th) {
      th.classList.add('sorted');
      var ind = th.querySelector('.sort-ind');
      if (ind) ind.textContent = sortAsc ? '↑' : '↓';
    }
    var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
    rows.sort(function (a, b) {
      var av = a.dataset[col] || '', bv = b.dataset[col] || '';
      var an = parseFloat(av), bn = parseFloat(bv);
      var aBad = isNaN(an), bBad = isNaN(bn);
      if (!aBad && !bBad) return sortAsc ? an - bn : bn - an;
      if (aBad && bBad) {
        if (av < bv) return sortAsc ? -1 : 1;
        if (av > bv) return sortAsc ? 1 : -1;
        return 0;
      }
      return aBad ? 1 : -1; /* missing values sink regardless of direction */
    });
    rows.forEach(function (r) { tbody.appendChild(r); });
  };
})();
</script>
{% endblock %}
