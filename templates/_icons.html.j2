{%- macro icon(name, cls='') -%}
<svg class="ic-svg{{ ' ' ~ cls if cls else '' }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ _ICON_PATHS.get(name, '') | safe }}</svg>
{%- endmacro -%}
