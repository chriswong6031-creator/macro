  <!-- ── Shock de-escalation banner (FTR W1 / PS-R3, de-escalation only) ── -->
  <!-- Fetched live from site/live/shock_state.json. Absent file = no banner (graceful). -->
  <div id="ftr-shock-banner"></div>
  <script>
  (function(){
  'use strict';
  function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  // Shock banner
  fetch('live/shock_state.json',{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(function(d){
      if(!d||!d.active)return;
      var el=document.getElementById('ftr-shock-banner');
      if(!el)return;
      var msg=isZh()?
        ('⚠ 冲击状态 — 评分与叙事依据冲击前数据计算，有效期至 '+esc(d.expires)+'，届前请酌情折扣。冲击期的剧烈反转多难持续：历史26次中约六成在一天内消退。'):
        ('⚠ SHOCK regime: scores &amp; narrative computed on pre-shock data — discount until '+esc(d.expires)+'. Sharp reversals during shocks usually don&#39;t hold: in 26 past cases about 6 in 10 faded within a day.');
      // --si-ink-warn exists only under light (W3 organ layer); dark falls back to
      // --warn unchanged. The banner renders OUTSIDE .si-shell, which is why the
      // ink token is declared on the page body rather than on the shell.
      el.innerHTML='<div class="shock-deesc-banner" style="background:rgba(250,204,21,.10);border:1px solid rgba(250,204,21,.4);color:var(--si-ink-warn,var(--warn));border-radius:9px;padding:9px 14px;margin:8px 0;font-size:13px">'+msg+'</div>';
    }).catch(function(){/* absent file → no banner */});
  // Policy-lever chip — inject into hero chip row (#ftr-lever-chip)
  fetch('policy_lever.json',{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(function(d){
      if(!d||!d.state)return;
      var el=document.getElementById('ftr-lever-chip');
      if(!el)return;
      var s=d.state, c=s==='ARMED'?'var(--down)':s==='ELEVATED'?'var(--orange)':'var(--muted)';
      // plain words at rest; the full framing sentence lives in the hover tip only
      var sEn={'ARMED':'Policy risk: high','ELEVATED':'Policy risk: elevated','QUIET':'Policy backdrop: quiet'}[s]||s;
      var sZh={'ARMED':'政策风险：高','ELEVATED':'政策风险：偏高','QUIET':'政策面：平静'}[s]||s;
      el.innerHTML='<span class="tc-chip lever" data-tip-en="'+esc((d.framing||''))+'" data-tip-zh="'+esc((d.framing_zh||d.framing||''))+'" style="border-color:'+c+';color:'+c+'">'
        +'<span class="l-en">'+esc(sEn)+'</span><span class="l-zh">'+esc(sZh)+'</span></span>';
    }).catch(function(){/* absent file → no chip */});
  })();
  </script>


