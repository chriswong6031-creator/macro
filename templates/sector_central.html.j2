{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{#- `pgate` is the Act-Now board's tier gate (docs/TIER_PREVIEW_PATTERN.md), set
    only by scripts/build_sector_central.py. Defaulted ONCE here rather than
    guarded at each read site, because `{{ pgate | tojson }}` on an Undefined
    RAISES — and a template error on this page is not a missing gate, it is the
    whole page falling back to last-good HTML (the builder's own render guard).
    The shared board include guards `pgate is defined` on its own, so the include
    is unaffected either way. -#}
{%- set pgate = pgate if pgate is defined else none %}
