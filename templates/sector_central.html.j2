// ── V1 Theme Rotation Desk fork removed (Sector Intelligence consolidation 2026-08).
// The live twin serving the intl pages is templates/baskets_desk.js; US uses the rvx layer.
// Inbound #theme-<id> deep links (alerts-board rows; legacy baskets.html bookmarks arrive
// via that stub's hash forward) resolve to the theme's own page — this page renders no
// #theme-<id> elements, so scrolling is not an option. replace() rather than href keeps
// the redirect out of history: Back returns to the alert that sent the visitor here
// instead of bouncing forward through the hash again (#4254 semantics, kept across #4237).
function resolveThemeHash(){
  let id=location.hash.slice(7);          // '#theme-'.length
  try{ id=decodeURIComponent(id); }catch(e){}
  if(!id||!themeById(id)) return;         // unknown id → stay put rather than 404
  location.replace('basket/'+encodeURIComponent(id)+'.html');
}

