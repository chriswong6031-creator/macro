<!DOCTYPE html>
<html lang="en" class="scc-page">
{# US Sector Central Intelligence — the consolidation hub. Renders engine.sector_central:
   a regime-gated confluence read per sector/basket with a reasoning trace, the VALIDATED
   absolute-trend drawdown gate as the forward lever, and a self-grader. It embeds the Sector
   Cycles overlay + the Sector Heatmap scorecard, and links Thematic Baskets + Narrative Rotation.
   Data is emitted by scripts/build_sector_central.py as sector_central_data.js
   (window.SECTOR_CENTRAL). Self-contained inline style + render. #}
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>US Sector Central Intelligence — Mastermind</title>
<meta name="description" content="One regime-gated confluence read per US sector & theme: where we are (cycle state) leads; the macro regime and the VALIDATED absolute-trend drawdown gate gate it; momentum, heat & crowding confirm and size — with a transparent reasoning trace and a self-grader. Embeds the Sector Cycles overlay and the Sector Heatmap.">
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="cycle.css?v=2">
<link rel="stylesheet" href="sector_cycles.css">
<style>
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font: 14px/1.55 Inter, -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; }
  a { color: inherit; text-decoration: none; }
  .scc-wrap { max-width: 1320px; margin: 0 auto; padding: 16px 22px 60px; }
  .scc-hd { margin: 14px 0 6px; }
  .scc-kick { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .scc-title { font-size: clamp(22px, 3vw, 34px); font-weight: 800; letter-spacing: -.02em; margin: 4px 0 6px; }
  .scc-sub { color: var(--muted); max-width: 92ch; font-size: 13.5px; }
  .scc-asof { color: var(--muted); font-size: 12.5px; margin-top: 4px; }
  /* regime banner */
  .regime { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 10px; margin: 14px 0; }
  @media (max-width: 880px) { .regime { grid-template-columns: 1fr 1fr; } }
  .rg-cell { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; background: var(--panel); }
  .rg-cell.lead { border-width: 1.5px; }
  .rg-k { font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .rg-v { font-size: 19px; font-weight: 760; margin-top: 3px; font-variant-numeric: tabular-nums; }
  .rg-d { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
  .rg-on { color: var(--up); } .rg-off { color: var(--down); } .rg-mix { color: var(--warn); }
  .rg-bar { height: 7px; border-radius: 5px; margin-top: 7px; overflow: hidden; background: var(--line); }
  .rg-bar i { display: block; height: 100%; }
  /* plain "new here?" orientation strip */
  .scc-howto { margin: 12px 0 2px; padding: 11px 14px; font-size: 13px; line-height: 1.55; color: var(--muted);
    background: color-mix(in srgb, var(--link) 6%, var(--panel)); border: 1px solid color-mix(in srgb, var(--link) 22%, var(--line));
    border-left: 3px solid var(--link); border-radius: 11px; max-width: 96ch; }
  .scc-howto b { color: var(--text); }
  /* plain-language headline row spanning the full regime grid */
  .regime .rg-headline-row { grid-column: 1 / -1; display: flex; align-items: center; gap: 9px;
    font-size: 14.5px; font-weight: 650; line-height: 1.4; padding: 11px 14px; border: 1px solid var(--line);
    border-radius: 12px; background: var(--panel); }
  .rg-headline-row .rg-hl-ic { font-size: 16px; flex: none; }
  .rg-headline-row.rg-hl-on { border-color: color-mix(in srgb, var(--up) 42%, var(--line)); }
  .rg-headline-row.rg-hl-on .rg-hl-ic { color: var(--up); }
  .rg-headline-row.rg-hl-off { border-color: color-mix(in srgb, var(--down) 42%, var(--line)); }
  .rg-headline-row.rg-hl-off .rg-hl-ic { color: var(--down); }
  .rg-headline-row.rg-hl-mix .rg-hl-ic { color: var(--warn); }
  /* collapse the redundant inner chart title on the hub (the universe toggle + section heading say it) */
  .scc-page #sc-hero-title { display: none; }
  /* board universe toggle: redundant with the page-level one on a phone → desktop only.
     (.scc-tabs.scc-tabs-board to outrank the later .scc-tabs{display:flex} base rule.) */
  @media (max-width: 880px) { .scc-tabs.scc-tabs-board { display: none; } }
  /* collapsible reasoning trace on conviction cards */
  .trace-d > summary { font-size: 11px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: var(--muted);
    cursor: pointer; list-style: none; padding: 4px 0; display: inline-flex; align-items: center; gap: 6px; }
  .trace-d > summary::-webkit-details-marker { display: none; }
  .trace-d > summary::after { content: "▾"; font-size: 10px; transition: transform .2s; }
  .trace-d[open] > summary::after { transform: rotate(180deg); }
  /* sub-dashboard rail */
  .scc-rail { display: flex; gap: 9px; flex-wrap: wrap; margin: 6px 0 16px; position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); padding: 7px 0; }
  .scc-rail a { font-size: 12.5px; border: 1px solid var(--line); border-radius: 9px; padding: 7px 12px;
    background: var(--panel2, var(--panel)); transition: border-color .15s; }
  .scc-rail a:hover { border-color: var(--muted); }
  /* tabs */
  .scc-tabs { display: flex; gap: 8px; margin: 6px 0 14px; }
  .scc-tab { font-size: 13px; font-weight: 600; border: 1px solid var(--line); border-radius: 9px; padding: 7px 14px;
    background: transparent; color: var(--muted); cursor: pointer; }
  .scc-tab.on { color: var(--text); background: var(--panel); border-color: var(--muted); }
  /* board */
  .board { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 13px; }
  .card { border: 1px solid var(--line); border-left: 4px solid var(--c, var(--muted)); border-radius: 13px;
    padding: 13px 15px; background: var(--panel); }
  .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .card-nm { font-size: 15.5px; font-weight: 720; } .card-sub { font-size: 11.5px; color: var(--muted); margin-top: 1px; }
  .conv { text-align: right; flex: 0 0 auto; }
  .conv-badge { font-size: 11.5px; font-weight: 800; letter-spacing: .03em; padding: 3px 9px; border-radius: 7px; }
  .conv-score { font-size: 23px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1.05; margin-top: 3px; }
  .conv-sub { font-size: 10.5px; color: var(--muted); }
  .tier-up { color: var(--up); background: color-mix(in srgb, var(--up) 14%, transparent); border: 1px solid color-mix(in srgb, var(--up) 40%, var(--line)); }
  .tier-down { color: var(--down); background: color-mix(in srgb, var(--down) 14%, transparent); border: 1px solid color-mix(in srgb, var(--down) 40%, var(--line)); }
  .tier-flat { color: var(--muted); background: var(--panel2, transparent); border: 1px solid var(--line); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 9px 0; }
  .chip2 { font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 1px 7px; }
  .chip2 b { color: var(--text); font-variant-numeric: tabular-nums; }
  .chip2.early { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, var(--line)); }
  .chip2.up { color: var(--up); } .chip2.down { color: var(--down); }
  .fwd { font-size: 12px; margin: 8px 0; padding: 8px 10px; border-radius: 9px;
    background: color-mix(in srgb, var(--link) 6%, var(--panel2, var(--panel))); border: 1px solid color-mix(in srgb, var(--link) 22%, var(--line)); }
  .fwd b { font-variant-numeric: tabular-nums; } .fwd.shut { background: color-mix(in srgb, var(--down) 6%, var(--panel2, var(--panel))); border-color: color-mix(in srgb, var(--down) 24%, var(--line)); }
  .trace { margin: 8px 0 0; display: flex; flex-direction: column; gap: 5px; }
  .tr-row { display: flex; gap: 8px; align-items: baseline; font-size: 12px; }
  .tr-dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; margin-top: 4px; }
  .tr-validated { background: var(--link); } .tr-confirmer { background: var(--warn); } .tr-display { background: var(--muted); }
  .tr-layer { font-weight: 650; flex: 0 0 88px; } .tr-txt { color: var(--muted); }
  .conflu { font-size: 10.5px; color: var(--muted); margin-top: 8px; }
  .conflu b.high { color: var(--up); } .conflu b.moderate { color: var(--warn); }
  /* grader */
  .grader { margin-top: 26px; border: 1px solid var(--line); border-radius: 13px; padding: 14px 16px; background: var(--panel); }
  /* in-board variant: the accuracy footer of the conviction scoreboard — hugs the board, subtler frame */
  .grader.grader-inboard { margin-top: 12px; background: var(--panel2, var(--panel)); border-style: dashed; }
  .grader h2 { font-size: 15px; margin: 0 0 4px; }
  .gr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 10px; }
  .gr-cell { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; background: var(--panel2, transparent); }
  .muted { color: var(--muted); } .sm { font-size: 12px; }
  footer { color: var(--muted); font-size: 11.5px; margin-top: 30px; border-top: 1px solid var(--line); padding-top: 12px; max-width: 95ch; }
  /* section heading */
  .scc-section-h { margin: 18px 0 8px; }
  .scc-section-h h2 { font-size: 17px; font-weight: 760; margin: 0; }
  .scc-section-h .scc-section-sub { font-size: 12.5px; color: var(--muted); }
  /* the embedded overlay reuses cycle.css/.sc-* but lives outside a .cyc-wrap — give the stage a panel frame */
  .scc-cycle { margin: 6px 0; }
  .scc-cycle .cyc-stage { background: var(--panel); border: 1px solid var(--line); border-radius: 13px; padding: 12px 14px; }
  /* conviction board head + linked toggle (kept prominent so it isn't missed) */
  .scc-boardhead { margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--line); }
  .scc-tabs-board { gap: 10px; margin: 10px 0 14px; }
  .scc-tabs-board .scc-tab { font-size: 13.5px; padding: 9px 16px; border-radius: 10px; border-width: 1.5px; }
  .scc-tabs-board .scc-tab.on { background: color-mix(in srgb, var(--link) 12%, var(--panel)); border-color: var(--link); color: var(--text); }
  .scc-tabs-board .scc-tab i { font-style: normal; font-variant-numeric: tabular-nums; color: var(--muted); margin-left: 2px; }
  /* conviction card name link */
  .card-nm a { color: inherit; border-bottom: 1px dotted color-mix(in srgb, var(--link) 45%, transparent); transition: color .15s, border-color .15s; }
  .card-nm a:hover { color: var(--link); border-bottom-color: var(--link); }
  #heatmap-scorecard { margin: 4px 0 8px; }
  /* sector-ETF flow board (server-rendered multi-window heatmap) */
  .scf-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 13px; background: var(--panel); padding: 4px 6px 6px; }
  table.scf { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  table.scf th, table.scf td { padding: 8px 10px; border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); white-space: nowrap; }
  table.scf thead th { font-size: 11px; font-weight: 700; color: var(--muted); text-align: right; text-transform: uppercase; letter-spacing: .03em; border-bottom: 1px solid var(--line); }
  table.scf th.scf-s { text-align: left; }
  table.scf td.scf-s { text-align: left; font-size: 13px; }
  table.scf td.scf-c { text-align: right; font-size: 12.5px; font-weight: 600; border-radius: 5px; }
  table.scf tbody tr:last-child td { border-bottom: none; }
  table.scf tr.scf-net td { border-top: 2px solid var(--line); font-weight: 700; background: color-mix(in srgb, var(--line) 22%, transparent); }
  table.scf tr.scf-net td.scf-s b { color: var(--text); }
  /* ===== index leadership rotation strip (moved from subsectors.html) ===== */
  .lead-wrap { border: 1px solid var(--line); border-radius: 13px; background: var(--panel); padding: 13px 15px; margin: 8px 0 18px; }
  .lead-wrap:empty { display: none; }
  .lead-wrap .num { font-variant-numeric: tabular-nums; }
  .lead-wrap .pos { color: var(--up); } .lead-wrap .neg { color: var(--down); }
  .lead-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; }
  .lead-head h2 { font-size: 15px; font-weight: 800; margin: 0; letter-spacing: -.01em; }
  .lead-head .asof { color: var(--muted); font-size: 11px; margin-left: auto; }
  .lead-hero { display: flex; flex-wrap: wrap; gap: 12px 30px; margin-bottom: 12px; }
  .lead-hero .lbl { color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; }
  .lead-hero .big { font-size: 17px; font-weight: 800; margin-top: 2px; }
  .lead-hero .big .las { font-size: 12px; font-weight: 700; color: var(--up); margin-left: 6px; }
  .lead-hero .why { color: var(--muted); font-size: 11.5px; margin-top: 1px; max-width: 52ch; }
  .lead-star .big { color: var(--up); }
  table.lead-tbl { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 12px; }
  table.lead-tbl th { text-align: right; color: var(--muted); font-weight: 600; font-size: 10px; text-transform: uppercase; letter-spacing: .03em; padding: 4px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  table.lead-tbl th:first-child, table.lead-tbl td:first-child { text-align: left; }
  table.lead-tbl td { padding: 5px 8px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  table.lead-tbl tr.star td { background: color-mix(in srgb, var(--up) 9%, transparent); }
  table.lead-tbl td.u { font-weight: 700; } table.lead-tbl td.b { font-weight: 800; }
  .qp { font-size: 10px; font-weight: 700; padding: 1px 7px; border-radius: 9px; border: 1px solid; }
  .lead-drivers .dh { font-size: 10.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 6px; }
  .lead-regime { font-size: 11.5px; line-height: 1.5; margin: 0 0 9px; color: var(--text); }
  .lead-regime .rg-cav { color: var(--muted); }
  .lead-drivers .chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(196px, 1fr)); gap: 8px; }
  .lead-drivers .chip { border: 1px solid var(--line); border-left-width: 3px; border-radius: 9px; padding: 7px 10px; background: var(--bg); }
  .lead-drivers .chip.up { border-left-color: var(--up); } .lead-drivers .chip.dn { border-left-color: var(--down); }
  .lead-drivers .chip .ct { font-weight: 700; font-size: 11.5px; }
  .lead-drivers .chip .cv { font-size: 11px; margin-top: 2px; line-height: 1.35; }
  .lead-drivers .chip .cm { color: var(--muted); font-size: 10.5px; margin-top: 3px; font-variant-numeric: tabular-nums; }
  .lead-macro { font-size: 12px; margin: -4px 0 12px; color: var(--text); }
  .lead-track { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); font-size: 11.5px; color: var(--muted); display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .lead-track .tr-badge { font-weight: 700; font-size: 10.5px; padding: 1px 8px; border-radius: 9px; border: 1px solid; }
  .lead-track .tr-txt { font-variant-numeric: tabular-nums; }
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="scc-wrap">
  <header class="scc-hd">
    <div class="scc-kick"><span class="l-en">US Sector Central Intelligence</span><span class="l-zh">美股行业中枢情报</span> 🇺🇸</div>
    <h1 class="scc-title"><span class="l-en">Every US sector &amp; theme, in one read</span><span class="l-zh">每个美股行业与主题，一个研判</span></h1>
    <p class="scc-sub"><span class="l-en">Every US sector &amp; theme fused into one conviction read: <b>where we are</b> (cycle state) LEADS;
      the macro regime and the <b>validated absolute-trend drawdown gate</b> GATE it; momentum, heat &amp; crowding CONFIRM and size — never override.
      Each card shows its reasoning trace; every dated call is logged and graded. Baskets, rotation, cycles &amp; the heatmap all live here.</span><span class="l-zh">将每个美股行业与主题融合为一个信念研判：<b>当前位置</b>（周期状态）主导；
      宏观体制与<b>经验证的绝对趋势回撤门控</b>进行门控；动量、热度与拥挤度仅作确认与定仓，绝不反转。每张卡片展示其推理链；每个带日期的判断都会被记录并评分。</span></p>
    <div class="scc-asof"><span class="l-en">As of</span><span class="l-zh">截至</span> <b id="scc-asof">…</b></div>
  </header>

  <p class="scc-howto"><span class="l-en"><b>New here?</b> This page maps where each US sector &amp; theme sits in its cycle on a 0–100 clock. <b>Low</b> = beaten-down / washed-out, <b>high</b> = stretched / late. Tap any line or card to read one sector’s story.</span><span class="l-zh"><b>第一次来？</b>本页用 0–100 时钟展示每个美股行业与主题在其周期中的位置。<b>低</b>=超跌／超卖，<b>高</b>=拉伸／晚期。点按任意曲线或卡片即可查看某行业的走势故事。</span></p>

  <div id="regime" class="regime"></div>
  <div class="scc-rail">
    <a href="#sc-cyclemap">🌀 <span class="l-en">Cycle map</span><span class="l-zh">周期图谱</span></a>
    <a href="#sc-board">🧠 <span class="l-en">Conviction board</span><span class="l-zh">信念研判</span></a>
    <a href="#sc-flows">💸 <span class="l-en">Sector flow</span><span class="l-zh">板块资金流</span></a>
    <a href="#sc-heatmap">🔥 <span class="l-en">Market heat</span><span class="l-zh">市场热度</span></a>
    <a href="#scc-leadership">🧭 <span class="l-en">Leadership</span><span class="l-zh">领导轮动</span></a>
    <a href="baskets.html">🧺 <span class="l-en">Thematic Baskets &amp; Rotation</span><span class="l-zh">主题篮子与轮动</span> →</a>
  </div>

  {# ===== UNIVERSE TOGGLE — the page-level Sectors⇄Baskets switch. Drives BOTH the cycle
     map and the conviction board (linkTabs() wires both ways); raised out of the chart
     card to here so it's the first, most prominent control after the regime read. #}
  <div class="scc-universe">
    <span class="scc-universe-lab"><span class="l-en">Viewing</span><span class="l-zh">查看</span></span>
    <div class="sc-tabs" id="sc-tabs" role="tablist" aria-label="Sectors or thematic baskets">
      <button class="sc-tab on" data-fam="sectors" role="tab">🧭 <span class="l-en">Sector ETFs</span><span class="l-zh">板块 ETF</span> <i id="sc-tab-n-sec"></i></button>
      <button class="sc-tab" data-fam="baskets" role="tab">🧺 <span class="l-en">Thematic Baskets</span><span class="l-zh">主题篮子</span> <i id="sc-tab-n-bsk"></i></button>
    </div>
  </div>

  {# ===== CYCLE MAP — the sector_cycles overlay, embedded so the hub carries the charting =====
     Reuses sector_cycles.js + mm_charts.js over window.SECTOR_CYCLES (the US cycles data). The
     scorecards (sc-cards) are intentionally omitted — the conviction board below replaces them. #}
  <section class="scc-cycle cyc-page sc-page" id="sc-cyclemap">
    <div class="scc-section-h">
      <h2><span class="l-en">Cycle map — every sector &amp; theme on one clock</span><span class="l-zh">周期图谱 — 各板块与主题同框</span></h2>
      <span class="scc-section-sub"><span class="l-en">Real price (rebased / log) or a 0–100 cycle-position oscillator · auto-detected turns · tap a line to read its legs</span><span class="l-zh">真实价格（再基准化／对数）或 0–100 周期位置振荡器 · 自动识别拐点 · 点击曲线查看区段</span></span>
    </div>
    <section class="cyc-stage">
      <div class="cyc-hero">
        <div class="cyc-hero-hd">
          <h2 id="sc-hero-title"><span class="l-en">Sector rotation overlay</span><span class="l-zh">板块轮动叠加</span></h2>
          <div class="cyc-hero-tools">
            <div class="sc-modes" id="sc-modes" aria-label="Chart mode">
              <button class="sc-mbtn" data-mode="price" aria-pressed="false"><span class="l-en">Price</span><span class="l-zh">价格</span></button>
              <button class="sc-mbtn on" data-mode="osc" aria-pressed="true"><span class="l-en">Cycle position</span><span class="l-zh">周期位置</span></button>
            </div>
            <div class="sc-mode-cap"><span class="l-en">Low = washed-out · High = stretched</span><span class="l-zh">低 = 超卖 · 高 = 拉伸</span></div>
            <div class="sc-advanced" id="sc-advanced">
              <button type="button" class="sc-adv-toggle" id="sc-adv-toggle" aria-expanded="false" aria-controls="sc-advbody"><span class="l-en">Chart options</span><span class="l-zh">图表选项</span></button>
              <div class="sc-adv-body" id="sc-advbody">
                <div class="sc-scale disabled" id="sc-scale" hidden aria-label="Price scale">
                  <button class="sc-sbtn on" data-scale="log" aria-pressed="true"><span class="l-en">Log</span><span class="l-zh">对数</span></button>
                  <button class="sc-sbtn" data-scale="linear" aria-pressed="false"><span class="l-en">Linear</span><span class="l-zh">线性</span></button>
                </div>
                <div class="cyc-legend" id="sc-legend" aria-label="Legend">
                  <span><i class="lc" style="background:color-mix(in srgb,var(--down) 42%,transparent)"></i> <span class="l-en">washed-out</span><span class="l-zh">超卖</span></span>
                  <span><i class="lc" style="background:color-mix(in srgb,var(--muted) 32%,transparent)"></i> <span class="l-en">mid-cycle</span><span class="l-zh">中段</span></span>
                  <span><i class="lc" style="background:color-mix(in srgb,var(--warn) 46%,transparent)"></i> <span class="l-en">stretched</span><span class="l-zh">拉伸</span></span>
                </div>
                <div class="cyc-zoom" id="sc-zoom" aria-label="Zoom"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="cyc-groups" id="sc-groups" aria-label="Phase filter"></div>
        <div class="cyc-chips" id="sc-chips" aria-label="Sector toggles"></div>
        <div class="sc-baskets" id="sc-baskets" aria-label="Thematic baskets"></div>
        <span id="sc-sr-status" class="sc-sr-status" role="status" aria-live="polite"></span>
        <div class="sc-chartwrap">
          <div id="sc-chart" data-h="560" role="img" aria-label="US sector cycle clock — each line a sector's 0 to 100 cycle position over time. Tap a line for its story."></div>
          <div class="sc-chart-hint" id="sc-chart-hint" hidden></div>
        </div>
      </div>
      <aside class="cyc-detail" id="sc-detail">
        <div class="cyc-handle" id="sc-handle" aria-hidden="true"></div>
        <div class="cyc-panels">
          <div class="cyc-panel show" id="sc-panel-default"></div>
          <div class="cyc-panel" id="sc-panel-focus"></div>
        </div>
      </aside>
    </section>
  </section>

  <div class="scc-boardhead" id="sc-board">
    <div class="scc-section-h">
      <h2><span class="l-en">Conviction board — one gated read per name</span><span class="l-zh">信念研判 — 每个标的一个门控研判</span></h2>
      <span class="scc-section-sub"><span class="l-en">One gated read per name — the cycle state leads, the macro regime gates it, momentum &amp; heat confirm.</span><span class="l-zh">每个标的一个门控研判——周期状态主导，宏观体制门控，动量与热度确认。</span></span>
    </div>
    <div class="scc-tabs scc-tabs-board" role="tablist" aria-label="Conviction board universe">
      <button class="scc-tab on" role="tab" aria-selected="true" data-fam="sectors"><span class="l-en">🧭 Sector ETFs</span><span class="l-zh">🧭 板块 ETF</span> <i id="n-sec"></i></button>
      <button class="scc-tab" role="tab" aria-selected="false" data-fam="baskets"><span class="l-en">🧺 Thematic Baskets</span><span class="l-zh">🧺 主题篮子</span> <i id="n-bsk"></i></button>
    </div>
  </div>
  <div id="board" class="board"></div>

  {# self-grader lives WITH the conviction board it measures — the realized-accuracy footer of the
     scoreboard, not a lone panel orphaned at the page bottom. #}
  <div id="grader" class="grader grader-inboard" hidden></div>

  {# ===== SECTOR-ETF FLOW — multi-window creation/redemption flow, server-rendered =====
     Built in scripts/build_sector_central._flows_section_html from collectors.sponsors. #}
  {% if flows_html %}{{ flows_html | safe }}{% endif %}

  {# ===== SECTOR HEATMAP — the compact scorecard, embedded (full treemap stays the subpage) ===== #}
  <div class="scc-section-h" id="sc-heatmap">
    <h2><span class="l-en">Market heat — breadth &amp; cap-weighted moves</span><span class="l-zh">市场热度 — 宽度与市值加权涨跌</span></h2>
    <span class="scc-section-sub"><span class="l-en">Coincident color (display context, capped in the read above) · Expand for the full 503-name treemap</span><span class="l-zh">同步色（展示背景，已在上方研判中受限计入）· 展开查看全部503只树图</span></span>
  </div>
  <div id="heatmap-scorecard"></div>

  {# ===== INDEX LEADERSHIP ROTATION — moved to the foot of the page. Which universe leads
     (large / small / tech / thematic), the rising-star accelerator, and the macro drivers behind
     it. Rendered client-side from marketdata/index_leadership.json by the inline script below. #}
  <div id="scc-leadership" class="lead-wrap"></div>

  <footer>
    <span class="l-en">Read-only analytics — not investment advice. Conviction is a gated-confluence read: the cycle state leads; the macro regime and the
      validated absolute-trend drawdown gate gate it; momentum (a focus lens, rank-IC≈0), heat and crowding are capped context. The trend gate is
      validated for drawdown/staying-power control, not return alpha. There is no directional odds forecast. The grader measures realized accuracy as it accrues.</span><span class="l-zh">只读分析 — 非投资建议。信念为门控共振研判：周期状态主导；宏观体制与经验证的绝对趋势回撤门控进行门控；
      动量（聚焦视角，秩相关≈0）、热度与拥挤度为受限背景。趋势门控仅对回撤/持续性控制有效，而非收益超额。无方向性概率预测。评分器随数据累积衡量已实现准确度。</span>
  </footer>
</div>

<script src="sector_central_data.js"></script>
<script>
(function(){
  "use strict";
  var D = window.SECTOR_CENTRAL; if (!D) return;
  var M = D.market || {}, GR = D.grader || {};
  function lang(){ return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en"; }
  function L(en, zh){ return '<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>'; }
  function esc(s){ return (s==null?'':String(s)).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  function pc(x){ return (x>0?'+':'')+x.toFixed(1)+'%'; }
  var asof=document.getElementById('scc-asof'); if(asof) asof.textContent=D.as_of||'';
  document.getElementById('n-sec').textContent=(D.sectors||[]).length;
  document.getElementById('n-bsk').textContent=(D.baskets||[]).length;

  /* ---- regime banner ---- */
  function regimeBanner(){
    var risk=M.risk_on;
    // headline tone follows the radar-aware Market State verdict (identical to macro.html); the
    // macro-risk scalar is kept only as the gate sub-line below. Fall back to risk_on if no verdict.
    var tone = M.ms_color ? ({green:'on',yellow:'mix',red:'off'}[M.ms_color]||'mix')
                          : (risk==null?'mix':(risk>0.2?'on':risk<-0.2?'off':'mix'));
    var toneCls={on:'rg-on',off:'rg-off',mix:'rg-mix'}[tone];
    var dr=M.derisk_blended;
    var postPct=(M.ms_score!=null)?Math.round(M.ms_score):(risk!=null?Math.round((risk+1)/2*100):50);
    var rsv=M.radar_state;
    // plain-language headline so a non-expert gets the "is this good or bad?" read instantly
    var headTxt = tone==='on' ? L('Markets are risk-on right now — a broadly supportive backdrop.','当前市场偏好风险——整体环境较为有利。')
      : tone==='off' ? L('Markets are leaning defensive right now — a cautious backdrop.','当前市场偏防御——环境趋于谨慎。')
      : L('Markets are mixed right now — no strong risk signal either way.','当前市场信号中性——风险方向不明确。');
    var headIc = tone==='off' ? '⚠' : tone==='on' ? '✓' : '•';
    var head='<div class="rg-headline-row rg-hl-'+tone+'"><span class="rg-hl-ic">'+headIc+'</span><span>'+headTxt+'</span></div>';
    var cells=[];
    cells.push('<div class="rg-cell lead" id="scc-marketstate"><div class="rg-k">'+L('Market state','市场状态')+' · '+L('radar-aware','含风险雷达')+'</div>'+
      '<div class="rg-v '+toneCls+'" id="scc-ms-verdict">'+esc(M.state_en||'—')+'</div>'+
      '<div class="rg-bar"><i id="scc-ms-bar" style="width:'+postPct+'%;background:'+(tone==='off'?'var(--down)':tone==='on'?'var(--up)':'var(--muted)')+'"></i></div>'+
      '<div class="rg-d">'+L('macro risk','宏观风险')+' '+(dr!=null?dr:'—')+' · '+L('gate ×','门控 ×')+(M.gate_factor!=null?M.gate_factor:'—')+(rsv?' · '+L('radar','雷达')+' '+esc(rsv):'')+'</div></div>');
    cells.push('<div class="rg-cell"><div class="rg-k">'+L('Quad','象限')+'</div>'+
      '<div class="rg-v">'+esc(M.quad_name||M.quad||'—')+'</div>'+
      '<div class="rg-d">'+L('growth','增长')+' '+(M.growth_score!=null?M.growth_score:'—')+' · '+L('infl','通胀')+' '+(M.inflation_score!=null?M.inflation_score:'—')+'</div></div>');
    var tac=M.tactical_label, tsc=M.risk_state_score;
    cells.push('<div class="rg-cell"><div class="rg-k">'+L('Net liquidity','净流动性')+' · '+L('tactical','战术')+'</div>'+
      '<div class="rg-v" style="font-size:16px">'+esc(M.liquidity||'—')+'</div>'+
      '<div class="rg-d">'+L('tactical','战术')+' '+(tac?esc(tac):'—')+(tsc!=null?' '+Math.round(tsc)+'/100':'')+(M.caution?' · '+L('breadth caution','宽度警示'):'')+'</div></div>');
    var na=M.n_above_trend, ns=M.n_sectors;
    cells.push('<div class="rg-cell"><div class="rg-k">'+L('Trend breadth','趋势宽度')+' · '+L('validated gate','已验证门控')+'</div>'+
      '<div class="rg-v">'+(na!=null&&ns?na+'/'+ns:'—')+'</div>'+
      '<div class="rg-d">'+L('sectors above own 200-day trend','行业位于自身200日趋势之上')+'</div></div>');
    document.getElementById('regime').innerHTML=head+cells.join('');
  }

  /* ---- conviction card ---- */
  function card(s){
    var c=s.conviction||{}, cy=s.cycle||{}, dir=c.dir||'flat';
    var nm = lang()==='zh' && s.name_zh ? s.name_zh : s.name;
    var sub = (s.kind==='basket' ? (s.etf_proxy?esc(s.etf_proxy)+' · ':'') : (esc(s.ticker||'')+' · ')) + esc(lang()==='zh'?(s.group_zh||s.group):s.group);
    var chips=[];
    if(cy.phaseLabel||cy.phase) chips.push('<span class="chip2">'+esc(cy.phaseLabel||cy.phase)+'</span>');
    if(cy.pos!=null) chips.push('<span class="chip2">'+L('pos','位置')+' <b>'+Math.round(cy.pos)+'</b></span>');
    if(cy.rs_rank) chips.push('<span class="chip2">RS <b>#'+cy.rs_rank+'</b></span>');
    if(c.confluence) chips.push('<span class="chip2">'+L('confluence','共振')+' <b>'+c.confluence.agree+'/'+c.confluence.of+'</b></span>');
    if(c.early) chips.push('<span class="chip2 early">'+L('early','偏早')+'</span>');
    var h=s.heat;
    if(h && h.heat_1M!=null) chips.push('<span class="chip2 '+(h.heat_1M>0?'up':'down')+'">'+L('heat','热度')+' <b>'+pc(h.heat_1M)+'</b></span>');
    // forward panel — the VALIDATED absolute-trend drawdown gate + cycle rhythm (NOT an odds forecast)
    var f=s.forward||{}, fwdHtml='';
    if(f.trend_pass!=null){
      var open=f.trend_pass===true;
      var r12=(f.ret_12m!=null)?(' · '+pc(f.ret_12m*100)+' 12m'):'';
      fwdHtml='<div class="fwd'+(open?'':' shut')+'">'+L('Trend gate','趋势门控')+': <b>'+(open?L('OPEN','开启'):L('SHUT — longs de-rated','关闭 — 多头降级'))+'</b>'+
        '<span class="muted">'+(open?L(' above own 200-day trend',' 位于自身200日趋势之上'):L(' below own 200-day trend',' 跌破自身200日趋势'))+r12+'</span></div>';
    }
    // reasoning trace
    var trace=(s.reasoning||[]).map(function(r){
      return '<div class="tr-row"><span class="tr-dot tr-'+esc(r.tier)+'"></span>'+
        '<span class="tr-layer">'+esc(r.layer)+'</span>'+
        '<span class="tr-txt">'+L(esc(r.en),esc(r.zh||r.en))+'</span></div>';
    }).join('');
    // name → its own page: baskets open the dedicated theme page; sectors focus the embedded cycle map.
    var cycHref = 'sector_cycles.html#'+esc(s.id);
    var nameHtml = s.kind==='basket'
      ? '<a href="basket/'+esc(String(s.id).replace(/^b-/,''))+'.html">'+esc(nm)+'</a>'
      : '<a href="'+cycHref+'" data-focus="'+esc(s.id)+'">'+esc(nm)+'</a>';
    return '<article class="card" style="--c:'+esc(s.accent||'var(--muted)')+'">'+
      '<div class="card-top"><div><div class="card-nm">'+nameHtml+'</div><div class="card-sub">'+sub+'</div></div>'+
        '<div class="conv"><span class="conv-badge tier-'+dir+'">'+L(esc(c.label_en),esc(c.label_zh||c.label_en))+'</span>'+
        '<div class="conv-score">'+c.score+'</div><div class="conv-sub">'+L('conviction','信念')+'</div></div></div>'+
      '<div class="chips">'+chips.join('')+'</div>'+ fwdHtml +
      '<details class="trace-d"><summary>'+L('Why — the full reasoning','为何 — 完整推理')+'</summary><div class="trace">'+trace+'</div></details>'+
      '<div class="conflu">'+L('confluence','共振度')+': <b class="'+esc((c.confluence||{}).label||'')+'">'+esc((c.confluence||{}).label||'—')+'</b> · '+
        '<a href="'+cycHref+'" data-focus="'+esc(s.id)+'" style="color:var(--link)">'+L('open cycle →','打开周期 →')+'</a></div>'+
    '</article>';
  }
  var fam='sectors';
  function renderBoard(){
    var list = fam==='baskets' ? (D.baskets||[]) : (D.sectors||[]);
    document.getElementById('board').innerHTML = list.map(card).join('');
  }
  /* keep the conviction-board universe toggle linked to the cycle-map family toggle above */
  function setBoardFam(f){
    fam=f;
    document.querySelectorAll('.scc-tab').forEach(function(x){ var on=x.getAttribute('data-fam')===f; x.classList.toggle('on', on); x.setAttribute('aria-selected', on?'true':'false'); });
    renderBoard();
  }
  function linkTabs(){
    document.querySelectorAll('.scc-tab').forEach(function(t){
      t.addEventListener('click', function(){
        var f=t.getAttribute('data-fam'); setBoardFam(f);
        var ct=document.querySelector('#sc-tabs .sc-tab[data-fam="'+f+'"]');   // drive the cycle map too
        if(ct && !ct.classList.contains('on')) ct.click();
      });
    });
    document.querySelectorAll('#sc-tabs .sc-tab').forEach(function(t){          // and mirror the cycle map back
      t.addEventListener('click', function(){ setBoardFam(t.getAttribute('data-fam')); });
    });
  }

  /* ---- grader scorecard ---- */
  function renderGrader(){
    var el=document.getElementById('grader');
    if(!GR || !GR.available){ el.hidden=false; el.innerHTML='<h2>'+L('Self-grader','自评分器')+'</h2><div class="muted sm">'+
      L('Accruing — dated calls are logged and will be graded against realized forward returns as time passes ('+(GR.n_calls||0)+' calls logged).',
        '累积中 — 带日期的判断已记录，将随时间推移对照已实现的前瞻收益进行评分（已记录 '+(GR.n_calls||0)+' 个判断）。')+'</div>'; return; }
    var bh=GR.by_horizon||{}, cells=[];
    ['21d','63d','126d'].forEach(function(k){
      var h=bh[k]; if(!h) return;
      if(h.dir_hit_rate==null){ cells.push('<div class="gr-cell"><div class="rg-k">'+k+'</div><div class="muted sm">'+L('accruing','累积中')+' (n='+(h.n||0)+')</div></div>'); return; }
      cells.push('<div class="gr-cell"><div class="rg-k">'+k+' · n='+h.n+'</div>'+
        '<div class="rg-v" style="font-size:16px">'+Math.round(h.dir_hit_rate*100)+'% '+L('hit','命中')+'</div>'+
        '<div class="rg-d">'+L('rank-IC','秩相关')+' '+(h.rank_ic!=null?h.rank_ic:'—')+' · '+L('excess','超额')+' '+(h.mean_excess_vs_bench!=null?(h.mean_excess_vs_bench*100).toFixed(1)+'%':'—')+'</div></div>');
    });
    el.hidden=false;
    el.innerHTML='<h2>'+L('Self-grader — measured accuracy','自评分器 — 已衡量准确度')+'</h2>'+
      '<div class="muted sm">'+L('Realized directional hit-rate, cross-sectional rank-IC and excess-vs-SPY of the conviction calls, by horizon. Sparse until it accrues; never fed back into the live score.',
        '按时间跨度衡量信念判断的已实现方向命中率、横截面秩相关与超越SPY的超额收益。数据累积前较稀疏；绝不回灌入实时评分。')+'</div>'+
      '<div class="gr-grid">'+(cells.join('')||'<div class="muted sm">'+L('accruing','累积中')+'</div>')+'</div>';
  }

  function focusDelegate(e){
    var a=e.target.closest('a[data-focus]'); if(!a) return;
    var id=a.getAttribute('data-focus');
    if(window.SectorCyclesFocus && window.SectorCyclesFocus(id)) e.preventDefault();
  }
  function boot(){
    regimeBanner(); renderBoard(); renderGrader(); linkTabs();
    var board=document.getElementById('board'); if(board) board.addEventListener('click', focusDelegate);
    document.addEventListener('langchange', function(){ regimeBanner(); renderBoard(); renderGrader(); });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{# the embedded cycle-map overlay — same engine + data as sector_cycles.html. It reads
   window.SECTOR_CYCLES (distinct from the board's window.SECTOR_CENTRAL) and renders into the
   cyc-stage above; missing sc-cards is handled gracefully (the board replaces the scorecards). #}
<script src="sector_cycles_data.js"></script>
<script src="mm_charts.js"></script>
<script src="sector_cycles.js"></script>
{# the embedded heatmap scorecard — heatmap.js boot() auto-mounts on #heatmap-scorecard and
   self-loads site/marketdata/sp500_heatmap.json; Expand opens the full treemap overlay. #}
<script src="heatmap.js"></script>
<script src="theme.js"></script>
<script src="live_config.js"></script>
<script src="risk_state_live.js"></script>
{# ===== INDEX LEADERSHIP ROTATION strip — moved from subsectors.html. Self-contained IIFE that
   fetches marketdata/index_leadership.json (built by scripts/build_index_leadership.py) and renders
   the rising-star + LAS table + macro drivers into #scc-leadership. Bilingual via .l-en/.l-zh. #}
<script>
(function () {
  'use strict';
  var L = function (en, zh) { return '<span class="l-en">' + en + '</span><span class="l-zh">' + (zh == null ? en : zh) + '</span>'; };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function num(x, d) { return (x == null || isNaN(x)) ? '–' : Number(x).toFixed(d == null ? 0 : d); }
  function signed(x, d) { if (x == null || isNaN(x)) return '<span class="num">–</span>'; var v = Number(x); return '<span class="num ' + (v >= 0 ? 'pos' : 'neg') + '">' + (v >= 0 ? '+' : '') + v.toFixed(d == null ? 1 : d) + '</span>'; }
  function quadInfo(q) { return ({ leading: ['Leading', '领先', 'var(--up)'], improving: ['Improving', '改善', 'var(--info)'], weakening: ['Weakening', '走弱', 'var(--orange)'], lagging: ['Lagging', '落后', 'var(--down)'] })[q] || ['—', '—', 'var(--muted)']; }
  function quadPill(q) { var i = quadInfo(q); return '<span class="qp" style="color:' + i[2] + ';border-color:' + i[2] + '">' + L(i[0], i[1]) + '</span>'; }
  function wrapTbls(root) {
    if (!root) return;
    root.querySelectorAll('table').forEach(function (t) {
      if (t.closest('.tbl-scroll') || !t.parentNode) return;
      var w = document.createElement('div'); w.className = 'tbl-scroll';
      t.parentNode.insertBefore(w, t); w.appendChild(t);
    });
  }
  function trackBox(tr) {
    if (!tr) return '';
    var vcol = tr.verdict === 'validated' ? 'var(--up)' : tr.verdict === 'measuring' ? 'var(--info)' : 'var(--muted)';
    var vlab = tr.verdict === 'validated' ? L('Validated', '已验证') : tr.verdict === 'measuring' ? L('Measuring', '测量中') : L('Accruing', '积累中');
    var days = tr.n_days || 0;
    var h = '<div class="lead-track"><span class="tr-badge" style="color:' + vcol + ';border-color:' + vcol + '">📊 ' + L('Forward track record', '前瞻战绩') + ': ' + vlab + '</span> '
      + '<span class="tr-txt">' + L((tr.n_snapshots || 0) + ' calls logged over ' + days + (days === 1 ? ' day' : ' days'), (tr.n_snapshots || 0) + ' 条记录，历时 ' + days + ' 天') + '</span>';
    var h21 = (tr.horizons || {})['21'];
    if (tr.any_matured && h21 && h21.n_matured) {
      var bs = h21.by_stage || {}, parts = [];
      ['running', 'coiling', 'coiling_primed'].forEach(function (st) { if (bs[st] && bs[st].hit_rate != null) parts.push((st === 'coiling_primed' ? 'coil✓' : st) + ' ' + Math.round(bs[st].hit_rate * 100) + '% (' + bs[st].n + ')'); });
      if (parts.length) h += ' · <span class="tr-txt">' + L('21d hit-rate: ', '21日命中率：') + parts.join(', ') + '</span>';
    } else {
      h += ' · <span class="tr-txt" style="color:var(--muted)">' + L('grades mature at 5 / 10 / 21 / 63d — measured, not asserted', '5 / 10 / 21 / 63 日后成熟评级——实测而非断言') + '</span>';
    }
    return h + '</div>';
  }
  function leadershipStrip(d) {
    var el = document.getElementById('scc-leadership'); if (!el) return;
    if (!d || !d.ok) { el.innerHTML = ''; return; }
    var star = d.rising_star, ln = d.leader_now, T = d.tabs || {};
    var order = ['subsectors', 'nasdaq', 'russell', 'baskets'].filter(function (t) { return T[t]; });
    var whyTxt = (star && star.why && star.why.length) ? star.why.map(function (w) { return w.leg; }).join(' · ') : L('mixed legs', '综合');
    var lnQuad = ln ? (T[ln.tab] || {}).quadrant : null;
    var lnNote = (lnQuad === 'weakening' || lnQuad === 'lagging') ? L(' · but weakening', ' · 但走弱') : '';
    var hero = '<div class="lead-hero">';
    if (star) hero += '<div class="lead-star"><div class="lbl">⭐ ' + L('Rising star', '上升之星') + '</div><div class="big">' + L(star.label[0], star.label[1]) + ' <span class="las">LAS ' + (star.las >= 0 ? '+' : '') + num(star.las, 2) + '</span></div><div class="why">' + L('leadership accelerating fastest — ', '领导加速最快——') + esc(whyTxt) + '</div></div>';
    if (ln) hero += '<div class="lead-leader"><div class="lbl">' + L('Leader now', '当前领导') + '</div><div class="big">' + L(ln.label[0], ln.label[1]) + '</div><div class="why">' + L('highest RS level', '相对强弱水平最高') + lnNote + '</div></div>';
    hero += '</div>';
    var rows = order.map(function (t) {
      var v = T[t], isStar = star && star.tab === t;
      return '<tr' + (isStar ? ' class="star"' : '') + '><td class="u">' + (isStar ? '⭐ ' : '') + L(v.label[0], v.label[1]) + '</td>'
        + '<td class="b">' + (v.las >= 0 ? '+' : '') + num(v.las, 2) + '</td>'
        + '<td>' + num(v.rs_ratio, 2) + '</td>'
        + '<td>' + signed(v.rs_mom, 2) + '</td>'
        + '<td style="text-align:right">' + quadPill(v.quadrant) + '</td>'
        + '<td>' + signed(v.breadth_thrust != null ? v.breadth_thrust * 100 : null, 1) + '</td>'
        + '<td>' + (v.participation != null ? num(v.participation * 100, 0) + '%' : '–') + '</td></tr>';
    }).join('');
    var tbl = '<table class="lead-tbl"><thead><tr><th>' + L('Universe', '指数域') + '</th><th>LAS</th><th>' + L('RS level', 'RS水平') + '</th><th>' + L('RS mom', 'RS动量') + '</th><th>' + L('Quadrant', '象限') + '</th><th>' + L('Breadth thrust', '广度推力') + '</th><th>' + L('Particip.', '参与度') + '</th></tr></thead><tbody>' + rows + '</tbody></table>';
    var chips = ((d.drivers && d.drivers.ratios) || []).map(function (r) {
      var up = r.rising;
      return '<div class="chip ' + (up ? 'up' : 'dn') + '"><div class="ct">' + L(r.label_en, r.label_zh) + '</div>'
        + '<div class="cv">' + (up ? '▲ ' : '▼ ') + L(r.read_en, r.read_zh) + '</div>'
        + '<div class="cm">20d ' + signed(r.mom20, 1) + ' · 60d ' + signed(r.mom60, 1) + (r.pctile != null ? ' · ' + L('pctile', '分位') + ' ' + num(r.pctile, 0) : '') + '</div></div>';
    }).join('');
    var rg = d.regime, regLine = '';
    if (rg) {
      var liqZh = ({ expanding: '扩张', contracting: '收缩', neutral: '中性', unknown: '未知' })[rg.liquidity] || rg.liquidity;
      var liqTxt = rg.liquidity ? ' · ' + L('liquidity ' + rg.liquidity, '流动性' + liqZh) : '';
      regLine = '<div class="lead-regime">🌐 ' + L('Regime backdrop', '宏观象限') + ': <b>' + esc(rg.quad) + ' ' + L(rg.name_en, rg.name_zh) + '</b> (' + L(rg.axes_en, rg.axes_zh) + ')' + liqTxt
        + ' → ' + L('expected tilt: ', '预期倾向：') + L(rg.tilt_en, rg.tilt_zh) + '. <span class="rg-cav">' + L('Odds-tilt, not a rule — compare to what is actually leading.', '仅为概率倾向，非规则——请对照上方实际领涨。') + '</span></div>';
    }
    var drivers = (chips || regLine) ? '<div class="lead-drivers"><div class="dh">' + L('Why — leadership drivers (macro cause + observable ratios)', '为什么——领导驱动（宏观成因 + 可观测比率）') + '</div>' + regLine + (chips ? '<div class="chips">' + chips + '</div>' : '') + '</div>' : '';
    var mac = d.macro, macLine = '';
    if (mac) {
      var dot = mac.color === 'red' ? '🔴' : mac.color === 'yellow' ? '🟡' : mac.color === 'green' ? '🟢' : '⚪';
      var held = mac.severity === 'risk_off' ? L(' — coil calls held back (let washouts confirm)', ' — 蓄势信号已收敛（待清洗确认）') : '';
      macLine = '<div class="lead-macro">' + L('Macro backdrop', '宏观背景') + ': ' + dot + ' ' + L(mac.label_en || mac.verdict || '—', mac.label_zh || mac.verdict || '—') + (mac.score != null ? ' <span style="color:var(--muted)">(' + mac.score + '/100)</span>' : '') + held + '</div>';
    }
    el.innerHTML = '<div class="lead-head"><h2>🧭 ' + L('Index leadership rotation', '指数领导轮动') + '</h2><span class="asof">' + L('as of ' + (d.as_of || '—'), '截至 ' + (d.as_of || '—')) + '</span></div>' + hero + macLine + tbl + drivers + trackBox(d.track_record);
    wrapTbls(el);
  }
  fetch('marketdata/index_leadership.json', { cache: 'no-cache' })
    .then(function (r) { return r.ok ? r.json() : null; })
    .catch(function () { return null; })
    .then(leadershipStrip);
})();
</script>
</body>
</html>
