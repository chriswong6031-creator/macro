    if(!d||!d.vol_regime) return;
    const el=document.getElementById('mf-vol-chip'); if(!el) return;
    const vr=d.vol_regime; const pc=d.put_call;
    const tc={warn:'var(--warn)',ok:'var(--up)',dn:'var(--down)'}[vr.tone]||'var(--muted)';
    const pcNote=pc&&pc.sentiment_en?` · ${L('options traders '+esc(String(pc.sentiment_en).replace(/\s*\(.*\)$/,'')),esc(pc.sentiment_zh))}` :'';
    el.innerHTML=`<span class="chip" style="font-size:11px;color:${tc}" data-tip-en="VIX ${vr.vix} (${Math.round(vr.vix_pctile*100)}th %ile) · ${vr.term_state||''}" data-tip-zh="VIX ${vr.vix}（${Math.round(vr.vix_pctile*100)}分位）· ${vr.term_state||''}">${L('Volatility: '+esc(String(vr.label_en).toLowerCase()),'波动率：'+esc(vr.label_zh))}${pcNote}</span>`;
  });
  // theme_extension stretch flag — inject ⚠ chip into desk Flags cells via theme-<bid> divs
  fetch('basketdata/theme_extension.json',{cache:'no-store'}).then(r=>r.ok?r.json():null).catch(()=>null).then(d=>{
    if(!d||!(d.themes||[]).length) return;
    d.themes.forEach(te=>{
      if(!te||te.tone!=='neg') return; // only stretched/parabolic
      const els=document.querySelectorAll('#theme-'+CSS.escape(te.id));
      els.forEach(el=>{
        if(el.querySelector('.te-stretch')) return; // already injected
        const tipEn=`${te.band_en} — pullbacks common from here`;
        const tipZh=`${te.band_zh}——历史上常见回撤`;
