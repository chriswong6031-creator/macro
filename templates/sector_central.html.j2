  <div id="regime" class="regime"></div>

  {# Theme Rotation Desk add-ons (display-only): ETF Pulse (style/risk/sector rotation),
     vol-regime + CBOE put/call chip, and per-theme ATR extension. Renders from
     basketdata/{etf_pulse,vol_sentiment,theme_extension}.json via theme_addons.js. #}
  {# _theme_addons.html.j2 include removed (Op 7 — Stage B rebuilds into Money-flow; partial stays untouched) #}

  {# The view read sits between the verdict and the lanes: the hero states the
     verdict, this line states what the whole view is seeing. data-from/data-to are
     server-seeded from the nightly handoff (the same fields the hero renders); the
     Buy-lane count is filled client-side by __siViewReads once the payload lands. #}
  <p class="si-view-read" id="si-read-overview" hidden
{%- if theme_context is defined and theme_context is not none and theme_context.leadership %}
{%- set _vr_l = theme_context.leadership %}
{%- if _vr_l.trailing_leader and _vr_l.trailing_leader.name %} data-from-en="{{ _vr_l.trailing_leader.name | e }}" data-from-zh="{{ (_vr_l.trailing_leader.name_zh or _vr_l.trailing_leader.name) | e }}"{% endif %}
{%- if _vr_l.strength and _vr_l.strength[0] and _vr_l.strength[0].name %} data-to-en="{{ _vr_l.strength[0].name | e }}" data-to-zh="{{ (_vr_l.strength[0].name_zh or _vr_l.strength[0].name) | e }}"{% endif %}
{%- endif %}></p>

  {# ══ ACT BOARD — server-rendered 5-lane sectors+themes board, transplanted from
     us_stocks.html #action-board (assembled by build_site.action_board(), persisted to
     basketdata/action_board.json, read fail-soft by build_sector_central). Replaces the old
     client-rendered 4-lane themes-only board (renderActBoard, removed). #grader is retained:
     its self-grader scorecard JS reads D.grader independently of the board. ══ #}
  <section class="rvx-sec rvx-reveal" id="actnow-section" style="animation-delay:.05s">
    {% if action_board %}{% include "_us_act_now_board.html.j2" %}{% else %}<p class="rvx-sec-sub muted">{{ t('Refreshing the action board — check back after tonight’s close.', '正在刷新操作板 — 今晚收盘后再查看。') }}</p>{% endif %}
    <div class="rvx-sec-sub si-lane-foot">{{ t('Lanes are the only gated, graded calls on this page — everything below is context, measured nightly.', '操作清单是本页唯一的门控与自评分判断 — 下方内容均为背景信息，每晚计算。') }}
      {# the funnel it drills into is the #confluence view on this page now, not a page away #}
      <a href="#confluence" style="color:var(--ink-link, var(--link))">{{ t('Drill to stocks →', '下钻到个股 →') }}</a></div>
    <div id="grader" class="grader grader-inboard" hidden></div>
  </section>


  {# ══ WHAT CHANGED (§1b gate 6) — at most three chips, every one a restatement of
     a field the nightly handoff already carries (theme_context.state_changes and the
     live handoff pair). Display-tier diffing only: no new artifact, no new score, no
     ranking. When the payload carries none of these the strip renders NOTHING — an
     empty session must never be dressed up as novelty. ══ #}
  {%- if theme_context is defined and theme_context is not none and theme_context.leadership %}
  {%- set _wc_l  = theme_context.leadership %}
  {%- set _wc_sc = theme_context.state_changes or {} %}
  {%- set _wc_ls = _wc_sc.leadership_state or {} %}
  {%- set _wc_tl = _wc_sc.trailing_leader_id or {} %}
  {%- set _ST_EN = {'rotating':'rotating','steady':'steady','strain':'under strain'} %}
  {%- set _ST_ZH = {'rotating':'轮动中','steady':'稳定','strain':'承压'} %}
  {%- set _wc = [] %}
  {#- a state that actually flipped since the prior session outranks every other chip -#}
  {%- if _wc_ls.current and _wc_ls.prev and _wc_ls.current != _wc_ls.prev %}
  {%- set _ = _wc.append((
      'Leadership is now ' ~ (_ST_EN.get(_wc_ls.current) or _wc_ls.current) ~ ' — it was ' ~ (_ST_EN.get(_wc_ls.prev) or _wc_ls.prev) ~ '.',
      '领涨格局转为' ~ (_ST_ZH.get(_wc_ls.current) or _wc_ls.current) ~ ' — 此前为' ~ (_ST_ZH.get(_wc_ls.prev) or _wc_ls.prev) ~ '。')) %}
  {%- endif %}
  {%- if _wc_tl.current and _wc_tl.prev and _wc_tl.current != _wc_tl.prev and _wc_l.trailing_leader and _wc_l.trailing_leader.name %}
  {%- set _ = _wc.append((
      _wc_l.trailing_leader.name ~ ' is the one losing the lead now — that changed this session.',
      (_wc_l.trailing_leader.name_zh or _wc_l.trailing_leader.name) ~ ' 成为失去领先的一方 — 本时段刚变化。')) %}
  {%- endif %}
  {#- days-in-state: how long the current read has held (§1b names it as a chip input) -#}
  {%- if _wc_l.days_in_state %}
  {%- set _ = _wc.append((
      'Held for ' ~ _wc_l.days_in_state ~ ' days.',
      '已持续 ' ~ _wc_l.days_in_state ~ ' 天。')) %}
  {%- endif %}
  {#- the live handoff pair, as a story chip -#}
  {%- if _wc_l.trailing_leader and _wc_l.trailing_leader.name and _wc_l.strength and _wc_l.strength[0] and _wc_l.strength[0].name %}
  {%- set _ = _wc.append((
      _wc_l.trailing_leader.name ~ ' → ' ~ _wc_l.strength[0].name,
      (_wc_l.trailing_leader.name_zh or _wc_l.trailing_leader.name) ~ ' → ' ~ (_wc_l.strength[0].name_zh or _wc_l.strength[0].name))) %}
  {%- endif %}
  {%- set _wc_moved = (_wc_ls.current and _wc_ls.prev and _wc_ls.current != _wc_ls.prev) or (_wc_tl.current and _wc_tl.prev and _wc_tl.current != _wc_tl.prev) %}
  {%- if _wc %}
  <div class="si-changed">
    <span class="si-changed-l">{% if _wc_moved %}{{ t('What changed', '最新变化') }}{% else %}{{ t("What's holding", '维持不变') }}{% endif %}</span>
    {%- for _c in _wc[:3] %}
    <span class="tc-chip">{{ t(_c[0], _c[1]) }}</span>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- endif %}

  </section>{# /si-view overview #}

