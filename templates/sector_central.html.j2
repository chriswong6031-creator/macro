    </div>
    <div class="rvx-chips" style="margin-top:14px">
      <span class="rvx-chip rcpt" data-tip-en="Trailing-momentum rank names {{ _tc_tl.name }} first; skips the most recent ~3 weeks by construction; suggested weights unchanged. Shape read only — not a forecast." data-tip-zh="趋势动量排名以{{ _tc_tl.name_zh }}居首；设计上跳过最近约3周数据；建议权重不变。仅为形态读数，非预测。">ⓘ {{ t('How this works', '原理说明') }}</span>
      {% if factor_season is defined and factor_season is not none %}
      {% set _fs_tone = factor_season.tone if factor_season.tone in ('headwind','tailwind') else '' %}
      <span id="factor-season" class="rvx-chip fs-chip {{ _fs_tone }}" data-tip-en="{{ factor_season.tip_en | e }}" data-tip-zh="{{ factor_season.tip_zh | e }}">{{ t(factor_season.chip_en, factor_season.chip_zh) }}</span>
      {% endif %}
      {% if theme_context.alignment is defined and theme_context.alignment.sector_rotation_agrees %}
      <span class="rvx-chip" style="color:var(--ink-up, var(--up))" data-tip-en="{{ theme_context.alignment.note_en | e }}" data-tip-zh="{{ theme_context.alignment.note_zh | e }}">✓ {{ t('sector rotation agrees', '板块轮动一致') }}</span>
      {% endif %}
      <a class="rvx-chip" href="allocation.html" style="color:var(--ink-link, var(--link))">{{ t('Open the playbook →', '打开操盘手册 →') }}</a>
    </div>
  </section>
  {% else %}
