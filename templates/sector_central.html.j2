  rvxSet('mkt-breadth-sub', mc.verdict==='broad'?(zh?'广泛参与 — 全面上涨。':'Broad participation — a risk-on tide.'):mc.verdict==='narrow'?(zh?'狭窄 — 少数个股主导。':'Narrow — a few names carry it.'):(zh?'无明显共识，领涨面较窄。':'No strong consensus. Leadership is narrow.'));
  if(mc.adv!=null&&mc.dec!=null){ rvxSet('mkt-ad', mc.adv+'<span class="rvx-mut" style="font-size:13px"> / </span>'+mc.dec);
    rvxSet('mkt-ad-sub', (zh?'涨跌比 ':'A/D ')+(mc.ad_ratio!=null?(+mc.ad_ratio).toFixed(2):'—'));
    rvxBar('mkt-ad-bar', mc.adv/((mc.adv+mc.dec)||1)*100, (mc.ad_ratio||0)>=1?'var(--up)':'var(--warn)'); }
  if(mc.nh!=null){ rvxSet('mkt-hilo', '<span class="rvx-up">'+mc.nh+'</span><span class="rvx-mut" style="font-size:13px"> / </span><span class="rvx-dn">'+mc.nl+'</span>');
    rvxSet('mkt-hilo-sub', (mc.nh>=mc.nl)?(zh?'新高多于新低':'more highs than lows'):(zh?'新低多于新高':'more lows than highs'));
    rvxBar('mkt-hilo-bar', mc.nh/(((mc.nh||0)+(mc.nl||0))||1)*100, (mc.nh>=mc.nl)?'var(--up)':'var(--down)'); }
  if(mc.pct_above_200!=null){ rvxSet('mkt-above', Math.round(mc.pct_above_200)+'<span style="font-size:13px">%</span>');
    rvxSet('mkt-above-sub', mc.pct_above_200>=60?(zh?'健康多数':'healthy majority'):mc.pct_above_200>=40?(zh?'中性':'mixed'):(zh?'偏弱':'weak'));
    rvxBar('mkt-above-bar', mc.pct_above_200, mc.pct_above_200>=60?'var(--up)':mc.pct_above_200>=40?'var(--warn)':'var(--down)'); }
}

