        </div>
        <p class="rvx-vsub">{% if theme_context.migration is defined and theme_context.migration.note_en %}{{ t(theme_context.migration.note_en, theme_context.migration.note_zh) }} {% endif %}{{ t("Favour the fresh leaders — not last month's winners.", '顺势买入新领涨，而非上月的赢家。') }}</p>
        <span class="rvx-stance">⚑ {{ t(_tc_lead.stance_en, _tc_lead.stance_zh) }}{% if _tc_lead.days_in_state is not none and _tc_lead.days_in_state %}<span class="rvx-stance-days"> · {{ t(_tc_lead.days_in_state|string + " days in", _tc_lead.days_in_state|string + " 天") }}</span>{% endif %}</span>
        <div class="rvx-chips ctx">
          <span id="ftr-lever-chip"></span>
