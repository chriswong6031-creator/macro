      +'<span class="rvx-stag" style="color:'+tagc+'">'+(zh?tag[1]:tag[0])+'</span>'
      +'<span class="mv '+((d.r20||0)>=0?'rvx-up':'rvx-dn')+'">'+(d.r20==null?'—':(d.r20>=0?'+':'')+d.r20.toFixed(1)+'%')+'</span>'
