function renderActBoard(){
  const el=document.getElementById('actnow'); if(!el) return;
  const a=(THEME&&THEME.act_now)||{};
  // MLC-W2b (#4241, ported): engine-demoted conflicted items ride the wait lane, tagged so
  // actRow can mark them — their .rsn subline already carries the engine's reason text.
  const conflicted=(a.conflicted||[]).map(x=>Object.assign({},x,{_conflicted:true}));
  const buy=a.buy||[], wait=(a.add_on_pullback||[]).concat(conflicted);
  const reduce=a.reduce||[];
  const isTrim=x=>(x.action==='trim'||x.action_en==='TRIM');
  const trim=reduce.filter(isTrim), avoid=reduce.filter(x=>!isTrim(x));
  el.innerHTML=actLane('buy','🟢',L('Buy now','立即买入'),L('In favour and a clean entry is set up right now.','看好且当前有干净入场点。'),buy)
    +actLane('wait','🔵',L('Wait for a pullback','等待回调'),L('In favour, but stretched — no clean entry yet.','看好但已拉伸 — 暂无干净入场点。'),wait)
    +actLane('trim','🟠',L('Take profits','止盈'),L('Was leading — momentum now rolling over.','曾领涨 — 动能正在回落。'),trim)
    +actLane('avoid','⚪',L('Reduce / avoid','减仓 / 回避'),L('Weak and getting weaker — stand aside.','弱且转弱 — 观望。'),avoid);
  const fn=document.getElementById('actnow-footnote');
  if(fn){ fn.innerHTML=conflicted.some(x=>x.sector_stance)
    ?L('Conflicted = in favour on its own read, but its sector view says Reduce.','观点冲突 = 自身信号看好，但所属板块评级为减配。'):''; }
  try{ renderStanceChips(); }catch(e){}
}
// MLC-W2b (#4241, ported): cross-surface stance chips on act-board rows. Fetches
// mlcdata/stance_matrix.json once (cached so langchange re-renders re-chip without
// refetching); rows whose four reads disagree get a "mixed reads" / "split view" chip
// with the matrix tip as the hover receipt. Rows already carrying the conflicted marker
// keep it (one chip per row). Fail-silent. (Port fix vs #4241: chip/footnote use
// innerHTML — L() returns an HTML dual-span string; textContent would print raw markup.)
let MLC_MX=null, MLC_MX_REQ=null;
function renderStanceChips(){
  const apply=()=>{ if(!MLC_MX||!MLC_MX.rows) return;
    const byId={}; MLC_MX.rows.forEach(r=>{ if(r&&r.id) byId[r.id]=r; });
    document.querySelectorAll('#actnow .rvx-trow[data-mlc-bid]').forEach(row=>{
      if(row.querySelector('.mlcchip')) return;
      const m=byId[row.getAttribute('data-mlc-bid')];
      if(!m||!m.agreement||(m.agreement!=='mixed'&&m.agreement!=='split')) return;
      const chip=document.createElement('span');
      chip.className='mlcchip';
      chip.setAttribute('data-tip-en',m.tip_en||'');
      chip.setAttribute('data-tip-zh',m.tip_zh||'');
      chip.innerHTML=m.agreement==='split'?L('split view','严重分歧'):L('mixed reads','观点分歧');
      const nm=row.querySelector('.tnm');
      if(nm){ nm.insertBefore(chip,nm.querySelector('.rsn')); } else row.appendChild(chip);
    });
  };
  if(MLC_MX){ apply(); return; }
  if(!MLC_MX_REQ){
    MLC_MX_REQ=fetch('mlcdata/stance_matrix.json').then(r=>r.ok?r.json():null)
      .then(d=>{ MLC_MX=d; }).catch(function(){/* absent file or fetch error — no chip */});
  }
  MLC_MX_REQ.then(apply).catch(function(){});
}

// ── Rotation map (signature) + linked board — one source, many views ──
const RVX_Q={lead:{c:'var(--rvx-lead)',en:'Leading',zh:'领先',se:'Hold / add',sz:'持有/加仓'},
  weak:{c:'var(--rvx-weak)',en:'Weakening',zh:'走弱',se:'Take profits',sz:'止盈'},
  improve:{c:'var(--rvx-improve)',en:'Improving',zh:'改善',se:'Watch',sz:'观察'},
  lag:{c:'var(--rvx-lag)',en:'Lagging',zh:'落后',se:'Avoid',sz:'回避'}};
const RVX_RECO={enter:['Buy','买入'],accumulate:['Add','加仓'],hold:['Hold','持有'],trim:['Trim','减仓'],avoid:['Avoid','回避']};
const RVX_RECO_C={enter:'var(--rvx-lead)',accumulate:'var(--rvx-lead)',hold:'var(--rvx-improve)',trim:'var(--rvx-weak)',avoid:'var(--rvx-lag)'};
let RVX_D=[], RVX_FILT='all', RVX_SHOWALL=false;
const RVX_NS='http://www.w3.org/2000/svg';
function rvxEl(t,a){const e=document.createElementNS(RVX_NS,t);for(const k in a)e.setAttribute(k,a[k]);return e;}
function rvxData(){
  const buyIds=new Set((((THEME&&THEME.act_now)||{}).buy||[]).map(x=>x.id));
  const scope=(typeof __siScope==='function')?__siScope():'themes';
  const isEW=t=>String(t.id||'').indexOf('us_sector_')===0;
  return ((THEME&&THEME.themes)||[]).filter(t=>t&&t.id).filter(t=>scope==='sectors'?isEW(t):!isEW(t)).map(t=>{
    const r20=relPct(t,'20d'), r5=relPct(t,'5d'), score=(t.score==null?50:t.score);
    let vel=t.pulse_rank_delta_5d; if(vel==null) vel=(r5==null?0:(r5>0?1:r5<0?-1:0)*Math.min(18,Math.abs(r5*100)/1.2));
    const strong=score>=50, rising=vel>=0, q=strong?(rising?'lead':'weak'):(rising?'improve':'lag');
    return {id:t.id,name:t.name,name_zh:t.name_zh,cat:t.category||'',score,
      r20:r20==null?null:r20*100, r5:r5==null?null:r5*100, vel, recoKey:(t.reco||'').toLowerCase(),
      buyable:buyIds.has(t.id), q, rank:t.rank||999};
  }).sort((a,b)=>b.score-a.score);
}
function rvxPass(d,f){ if(f==='all')return true; if(f==='buy')return d.buyable; return d.q===f; }
function rvxApplyDim(){ document.querySelectorAll('#rvx-rmap .dot').forEach(g=>{const d=RVX_D.find(x=>x.id===g.getAttribute('data-id'));g.classList.toggle('dim',!(d&&rvxPass(d,RVX_FILT)));}); }
function renderRotationMap(){
  RVX_D=rvxData();
  const svg=document.getElementById('rvx-rmap'); if(!svg) return; svg.innerHTML='';
  const PX0=70,PX1=560,PY0=34,PY1=400, cx=(PX0+PX1)/2, cy=(PY0+PY1)/2;
  const sx=s=>PX0+((Math.max(28,Math.min(70,s))-28)/42)*(PX1-PX0);
  const sy=v=>PY0+((36-Math.max(-36,Math.min(36,v)))/72)*(PY1-PY0);
  [['improve',PX0,PY0],['lead',cx,PY0],['lag',PX0,cy],['weak',cx,cy]].forEach(([q,x,y])=>
    svg.appendChild(rvxEl('rect',{class:'qfill',x,y,width:(PX1-PX0)/2,height:(PY1-PY0)/2,fill:'var(--rvx-'+q+'-t)',rx:2})));
  svg.appendChild(rvxEl('line',{class:'axis',x1:cx,y1:PY0,x2:cx,y2:PY1}));
  svg.appendChild(rvxEl('line',{class:'axis',x1:PX0,y1:cy,x2:PX1,y2:cy}));
  const zh=isZh();
  const qlab=(x,y,anc,col,tt,sub)=>{const g=rvxEl('text',{class:'qlab',x,y,fill:col,'text-anchor':anc});g.textContent=tt;svg.appendChild(g);const s=rvxEl('text',{class:'qsub',x,y:y+12,'text-anchor':anc});s.textContent=sub;svg.appendChild(s);};
  qlab(PX1-6,PY0+16,'end','var(--rvx-lead)',zh?'领先':'LEADING',zh?'强且上行':'strong & rising');
  qlab(PX1-6,cy+18,'end','var(--rvx-weak)',zh?'走弱':'WEAKENING',zh?'强但转弱':'strong but fading');
  qlab(PX0+6,PY0+16,'start','var(--rvx-improve)',zh?'改善':'IMPROVING',zh?'弱但转强':'weak but turning up');
  qlab(PX0+6,cy+18,'start','var(--rvx-lag)',zh?'落后':'LAGGING',zh?'弱且下行':'weak & falling');
  let a1=rvxEl('text',{class:'axlab',x:PX1,y:PY1+22,'text-anchor':'end'}); a1.textContent=zh?'相对标普500强度  →':'RELATIVE STRENGTH vs S&P 500  →'; svg.appendChild(a1);
  let a2=rvxEl('text',{class:'axlab',x:PX0-52,y:cy,'text-anchor':'middle',transform:'rotate(-90 '+(PX0-52)+' '+cy+')'}); a2.textContent=zh?'← 转弱    本周动能    转强 →':'← FADING    MOMENTUM    RISING →'; svg.appendChild(a2);
  const tip=document.getElementById('rvx-rtip');
  RVX_D.forEach(d=>{
    const x=sx(d.score), y=sy(d.vel), r=6+Math.min(6,Math.abs(d.r20||0)/6);
    const g=rvxEl('g',{class:'dot','data-id':d.id});
    if(d.rank===1) g.appendChild(rvxEl('circle',{class:'lead-ring',cx:x,cy:y,r:r+3}));
    g.appendChild(rvxEl('circle',{cx:x,cy:y,r,fill:'var(--rvx-'+d.q+')',opacity:.9}));
    if(Math.abs(d.r20||0)>6||d.buyable||d.rank===1){
      const tx=rvxEl('text',{x:x+(x>cx?-(r+4):(r+4)),y:y+3,'text-anchor':x>cx?'end':'start'});
      tx.textContent=(zh?d.name_zh:d.name).replace(/ &.*| \(.*/,'').slice(0,16); g.appendChild(tx);
    }
    g.addEventListener('mousemove',ev=>{ tip.classList.add('on'); const Q=RVX_Q[d.q];
      tip.innerHTML='<div class="rt-nm">'+esc(zh?d.name_zh:d.name)+'</div><div class="rt-cat">'+esc(d.cat)+'</div>'
        +'<div class="rt-row"><span>'+(zh?'强度评分':'Strength score')+'</span><span>'+d.score+'</span></div>'
        +'<div class="rt-row"><span>'+(zh?'20日相对':'20-day vs S&P')+'</span><span class="'+((d.r20||0)>=0?'rvx-up':'rvx-dn')+'">'+(d.r20==null?'—':(d.r20>=0?'+':'')+d.r20.toFixed(1)+'%')+'</span></div>'
        +'<div class="rt-row"><span>'+(zh?'本周速度':'Speed this week')+'</span><span class="'+(d.vel>=0?'rvx-up':'rvx-dn')+'">'+(d.vel>=0?'+':'')+Math.round(d.vel)+' '+(zh?'名':'ranks')+'</span></div>'
        +'<div class="rt-stance" style="color:'+Q.c+'">'+(zh?Q.zh:Q.en)+' → '+(zh?Q.sz:Q.se)+'</div>';
      const cr=tip.parentElement.getBoundingClientRect();
      tip.style.left=Math.min(ev.clientX-cr.left+12, cr.width-186)+'px'; tip.style.top=(ev.clientY-cr.top+12)+'px';
    });
    g.addEventListener('mouseleave',()=>tip.classList.remove('on'));
    svg.appendChild(g);
  });
  rvxApplyDim();
}
function rvxSpark(id,pos){ const lv=CHART.baskets[id]; if(!lv) return ''; return sparkSvg(sparkTail(ratio(lv)),{w:56,h:22,color:pos?cssv('--up'):cssv('--down')}); }
function renderRotBoard(){
  const board=document.getElementById('rvx-board'); if(!board) return; const zh=isZh();
  const rows=RVX_D.filter(d=>rvxPass(d,RVX_FILT)), shown=RVX_SHOWALL?rows:rows.slice(0,10);
  board.innerHTML=shown.map((d,i)=>{
    const tag=RVX_RECO[d.recoKey]||['—','—'], tagc=RVX_RECO_C[d.recoKey]||'var(--muted)';
    return '<a class="rvx-brow" href="basket/'+encodeURIComponent(d.id)+'.html" style="animation-delay:'+(i*.02).toFixed(2)+'s">'
      +'<span class="rk">'+d.rank+'</span>'
      +'<span class="bnm"><span class="rvx-qdot" style="background:var(--rvx-'+d.q+')"></span>'+esc(zh?d.name_zh:d.name)+' <span class="cat">'+esc(d.cat)+'</span></span>'
      +'<span class="rvx-scorebar"><i style="width:'+Math.max(3,(d.score-28)/42*100)+'%;background:var(--rvx-'+d.q+')"></i></span>'
      +'<span class="rvx-stag" style="color:'+tagc+';background:color-mix(in srgb,'+tagc+' 15%,transparent)">'+(zh?tag[1]:tag[0])+'</span>'
      +'<span class="mv '+((d.r20||0)>=0?'rvx-up':'rvx-dn')+'">'+(d.r20==null?'—':(d.r20>=0?'+':'')+d.r20.toFixed(1)+'%')+'</span>'
      +'<span class="spark">'+rvxSpark(d.id,(d.r20||0)>=0)+'</span>'
      +'<span class="rvx-vel '+(d.vel>=0?'rvx-up':'rvx-dn')+'">'+(d.vel>=0?'▲':'▼')+Math.abs(Math.round(d.vel))+'</span></a>';
  }).join('');
  const cnt=document.getElementById('rvx-count'); if(cnt) cnt.textContent=rows.length+(zh?' 个主题':' themes');
  const sa=document.getElementById('rvx-showall'); if(sa){ sa.style.display=rows.length>10?'':'none';
    sa.textContent=RVX_SHOWALL?(zh?'收起 ▴':'Show fewer ▴'):(zh?('显示全部 '+rows.length+' ▾'):('Show all '+rows.length+' ▾')); }
}
function wireRotFilters(){
  const c={all:RVX_D.length,buy:RVX_D.filter(d=>d.buyable).length,lead:0,weak:0,improve:0,lag:0};
  RVX_D.forEach(d=>c[d.q]++);
  ['all','buy','lead','weak','improve','lag'].forEach(k=>{const e=document.getElementById('fc-'+k);if(e)e.textContent=c[k];});
  document.querySelectorAll('#rvx-filters .rvx-fbtn').forEach(b=>b.onclick=()=>{
    document.querySelectorAll('#rvx-filters .rvx-fbtn').forEach(x=>x.classList.remove('on'));
    b.classList.add('on'); RVX_FILT=b.dataset.f; RVX_SHOWALL=false; renderRotBoard(); rvxApplyDim(); });
  const sa=document.getElementById('rvx-showall'); if(sa) sa.onclick=()=>{RVX_SHOWALL=!RVX_SHOWALL; renderRotBoard();};
}

// ── Market internals (breadth) from THEME.market_concentration ──
function rvxSet(id,html){const e=document.getElementById(id);if(e)e.innerHTML=html;}
function rvxBar(id,pct,col){const e=document.getElementById(id);if(e){e.style.width=Math.max(2,Math.min(100,pct))+'%';e.style.background=col;}}
function renderInternals(){
  const mc=(THEME&&THEME.market_concentration)||{}; const zh=isZh();
  const vmap={narrow:[zh?'狭窄':'Narrow','var(--down)'],broad:[zh?'广泛':'Broad','var(--up)'],mixed:[zh?'中性':'Mixed','var(--warn)']};
  const vv=vmap[mc.verdict]||vmap.mixed;
  const be=document.getElementById('mkt-breadth'); if(be){be.textContent=vv[0]; be.style.color=vv[1];}
  rvxSet('mkt-breadth-sub', mc.verdict==='broad'?(zh?'广泛参与 — 全面上涨。':'Broad participation — a risk-on tide.'):mc.verdict==='narrow'?(zh?'狭窄 — 少数个股主导。':'Narrow — a few names carry it.'):(zh?'无明显共识，领涨面较窄。':'No strong consensus. Leadership is narrow.'));
  if(mc.adv!=null&&mc.dec!=null){ rvxSet('mkt-ad', mc.adv+'<span class="rvx-mut" style="font-size:13px"> / </span>'+mc.dec);
    rvxSet('mkt-ad-sub', (zh?'涨跌比 ':'A/D ')+(mc.ad_ratio!=null?(+mc.ad_ratio).toFixed(2):'—'));
    rvxBar('mkt-ad-bar', mc.adv/((mc.adv+mc.dec)||1)*100, (mc.ad_ratio||0)>=1?'var(--up)':'var(--warn)'); }
  if(mc.nh!=null){ rvxSet('mkt-hilo', '<span class="rvx-up">'+mc.nh+'</span><span class="rvx-mut" style="font-size:13px"> / </span><span class="rvx-dn">'+mc.nl+'</span>');
    rvxSet('mkt-hilo-sub', (mc.nh>=mc.nl)?(zh?'新高多于新低':'more highs than lows'):(zh?'新低多于新高':'more lows than highs'));
    rvxBar('mkt-hilo-bar', mc.nh/(((mc.nh||0)+(mc.nl||0))||1)*100, (mc.nh>=mc.nl)?'var(--up)':'var(--down)'); }
  if(mc.pct_above_200!=null){ rvxSet('mkt-above', Math.round(mc.pct_above_200)+'<span style="font-size:13px">%</span>');
    rvxSet('mkt-above-sub', mc.pct_above_200>=60?(zh?'健康多数':'healthy majority'):mc.pct_above_200>=40?(zh?'中性':'mixed'):(zh?'偏弱':'weak'));
    rvxBar('mkt-above-bar', mc.pct_above_200, mc.pct_above_200>=60?'var(--up)':mc.pct_above_200>=40?'var(--warn)':'var(--down)'); }
}

function boot(){
  const ao=document.getElementById('asof'); if(ao) ao.textContent=BASKETS.as_of||'—';
  try{ renderVerdictHero(); }catch(e){ console.warn('rvx hero',e); }
  try{ renderActBoard(); }catch(e){ console.warn('rvx act',e); }
  try{ renderRotationMap(); renderRotBoard(); wireRotFilters(); }catch(e){ console.warn('rvx map',e); }
  try{ renderInternals(); }catch(e){ console.warn('rvx internals',e); }
  renderTabs(document.getElementById('btbl-mode'), TBL_MODES, btblMode, v=>{ btblMode=v; localStorage.setItem('fw-btbl-mode',v); renderBTableCats(); renderBTable(); });
  renderBTableCats();
  renderTabs(document.getElementById('chart-modes'), [['rel','vs S&P 500'],['abs','Absolute']], chartMode, v=>{ chartMode=v; renderChart(); });
  const rel=document.getElementById('chart-ranges');
  rel.innerHTML=RANGES.map(([lab,v])=>`<button data-v="${v}" class="${v===chartRange?'on':''}">${lab}</button>`).join('')+`<input class="rangeN" type="number" min="5" max="600" placeholder="N days">`;
  rel.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chartRange=(b.dataset.v==='ytd')?'ytd':parseInt(b.dataset.v,10); localStorage.setItem('fw-brange',String(chartRange)); rel.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); renderChart(); });
  rel.querySelector('.rangeN').onchange=function(){ const n=Math.min(600,Math.max(5,parseInt(this.value,10)||252)); chartRange=n; localStorage.setItem('fw-brange',String(n)); rel.querySelectorAll('button').forEach(x=>x.classList.remove('on')); renderChart(); };
  initChartDefaults();
  renderBTable(); renderChart();
  if(location.hash.startsWith('#theme-')) resolveThemeHash();
  const rvxRerender=()=>{ try{ renderVerdictHero(); renderActBoard(); renderRotationMap(); renderRotBoard(); renderInternals(); }catch(e){} };
  document.addEventListener('langchange',()=>{ rvxRerender(); if(chart){chart.applyOptions(chartOpts());} renderChart(); });
  document.addEventListener('themechange',()=>{ renderRotationMap(); renderRotBoard(); if(chart){chart.applyOptions(chartOpts());} renderChart(); });
}
boot();
try{ __siWireScope(); __siWireTrace(); }catch(e){ console.warn('si glue', e); }
}
/* ── Sector Intelligence glue: payload fetch, lane trace expands, map scope link, alerts ── */
function __siFetch(u){ return fetch(u,{cache:'no-store'}).then(function(r){ if(!r.ok) throw 0; return r.json(); }); }
function __siBoot(){
  __siFetch('basketdata/baskets.json').then(function(p){ __siInitPage(p); })
    .catch(function(){ var el=document.getElementById('actnow'); if(el) el.innerHTML='<div class="rvx-lane-desc">'+ (document.documentElement.getAttribute('data-lang')==='zh' ? '数据加载失败 — 请刷新。' : 'Data failed to load — please refresh.') +'</div>'; });
}
function __siWireTrace(){
  var lanes=document.getElementById('actnow'); if(!lanes||lanes.__siTraceWired) return; lanes.__siTraceWired=true;
  lanes.addEventListener('click', function(ev){
    var row=ev.target.closest('a.rvx-trow'); if(!row) return;
    if(ev.target.closest('.si-trace')) return;
    var m=(row.getAttribute('href')||'').match(/^basket\/(.+)\.html$/); if(!m) return;
    if(!window.__siTrace) return; /* conviction payload absent — row keeps its normal link */
    ev.preventDefault();
    var id=decodeURIComponent(m[1]);
    var open=lanes.querySelector('.si-trace'); var was=row.nextElementSibling===open;
    if(open) open.remove();
    if(was) return;
    var html=window.__siTrace(id); if(!html){ location.href=row.getAttribute('href'); return; }
    var d=document.createElement('div'); d.className='si-trace'; d.innerHTML=html+
      '<div class="si-trace-foot"><a href="basket/'+encodeURIComponent(id)+'.html">'+
      (document.documentElement.getAttribute('data-lang')==='zh'?'打开成分页 →':'members →')+'</a></div>';
    row.after(d); if(window.__siTraceHydrate) window.__siTraceHydrate(d);
  });
}
function __siScope(){ var on=document.querySelector('#sc-tabs .sc-tab.on'); return (on&&on.getAttribute('data-fam'))==='sectors'?'sectors':'themes'; }
function __siWireScope(){
  var tabs=document.querySelectorAll('#sc-tabs .sc-tab'); if(!tabs.length) return;
  tabs.forEach(function(t){ t.addEventListener('click', function(){
    tabs.forEach(function(x){ x.classList.toggle('on', x===t); });
    try{ renderRotationMap(); renderRotBoard(); wireRotFilters(); }catch(e){}
  }); });
}
if(document.readyState!=='loading') __siBoot(); else document.addEventListener('DOMContentLoaded',__siBoot);
</script>

{# ── __siDonorJs: transplanted sector_central engines (conviction board, cycle loader,
   heatmap scorecard, index leadership) + the whole-market rotation app ── #}
<script src="sector_central_data.js"></script>
<script>
(function(){
  "use strict";
  var D = window.SECTOR_CENTRAL; if (!D) return;
  /* FIX 1a — strip "(Equal-Weight)" / "（等权）" suffixes from all string values at boot */
  var _ewRe = /\s*[（(]\s*(?:equal[-\s]?weight(?:ed)?|等权(?:重)?)\s*[）)]/gi;
  function deepStrip(obj) {
    if (obj === null || typeof obj !== 'object') return;
    var keys = Object.keys(obj);
    for (var _k = 0; _k < keys.length; _k++) {
      var _key = keys[_k], _val = obj[_key];
      if (typeof _val === 'string') { obj[_key] = _val.replace(_ewRe, ''); }
      else if (_val && typeof _val === 'object') { deepStrip(_val); }
    }
  }
  deepStrip(D);
  var M = D.market || {}, GR = D.grader || {};
  function lang(){ return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en"; }
  function L(en, zh){ return '<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>'; }
  function esc(s){ return (s==null?'':String(s)).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  function pc(x){ return (x>0?'+':'')+x.toFixed(1)+'%'; }
  var asof=document.getElementById('scc-asof'); if(asof) asof.textContent=D.as_of||'';

  /* ---- regime banner — one plain-language line; tone follows the radar-aware Market State
     verdict (identical to macro.html), falling back to risk_on when no verdict. ---- */
  function regimeBanner(){
    var risk=M.risk_on;
    var tone = M.ms_color ? ({green:'on',yellow:'mix',red:'off'}[M.ms_color]||'mix')
                          : (risk==null?'mix':(risk>0.2?'on':risk<-0.2?'off':'mix'));
    var headTxt = tone==='on' ? L('Markets are risk-on right now.','当前市场偏好风险。')
      : tone==='off' ? L('Markets are leaning defensive right now.','当前市场偏防御。')
      : L('Markets are mixed right now.','当前市场信号中性。');
    var headIc = tone==='off' ? '⚠' : tone==='on' ? '✓' : '•';
    document.getElementById('regime').innerHTML='<div class="rg-headline-row rg-hl-'+tone+'"><span class="rg-hl-ic">'+headIc+'</span><span>'+headTxt+'</span></div>';
  }

  /* ---- mini cycle chart ---- */
  var _cycSeriesCache = {};
  function _cycSeries(id) {
    if (_cycSeriesCache[id]) return _cycSeriesCache[id];
    var cyc = window.SECTOR_CYCLES; if (!cyc) return null;
    var today = (cyc.meta && cyc.meta.today) || null;
    var lists = [cyc.sectors||[], cyc.baskets||[]];
    for (var li=0; li<lists.length; li++) {
      var list = lists[li];
      for (var i=0; i<list.length; i++) {
        var s = list[i];
        if (s.id !== id) continue;
        var raw = s.osc || []; if (!raw.length) return null;
        var cutoff = (today || raw[raw.length-1].x) - 5;
        var pts = raw.filter(function(p){ return p.x >= cutoff; });
        if (!pts.length) pts = raw.slice(-2);
        var result = { pts: pts, accent: s.accent || null };
        _cycSeriesCache[id] = result;
        return result;
      }
    }
    return null;
  }
  function miniCycChart(s) {
    var id = s.id;
    var ser = _cycSeries(id); if (!ser || !ser.pts.length) return '<div class="mini-cyc-slot" data-id="'+id+'"></div>';
    var pts = ser.pts;
    var accent = ser.accent || 'var(--link)';
    var last = pts[pts.length-1];
    var oscNow = Math.round(last.v);
    var W=320, H=52;
    var xMin = pts[0].x, xMax = last.x, xRng = xMax-xMin || 1;
    function px(p) { return ((p.x-xMin)/xRng*W).toFixed(2); }
    function py(p) { return (H - p.v/100*H).toFixed(2); }
    var pathD = pts.map(function(p,i){ return (i===0?'M':'L')+px(p)+','+py(p); }).join(' ');
    var ex = parseFloat(px(last)), ey = parseFloat(py(last));
    /* FIX 3 — bilingual aria-label */
    var ariaLabel = lang()==='zh'
      ? ('近5年周期位置，当前'+oscNow+'/100')
      : ('cycle position over 5 years, now '+oscNow+' of 100');
    /* FIX 2 — end dot, readout, crosshair/hover dot moved OUT of SVG into HTML spans */
    var dotLeftPct = (ex/W*100).toFixed(3)+'%';
    var dotTopPct  = (ey/H*100).toFixed(3)+'%';
    var readTransform = ex > W-28 ? 'translate(-100%,-50%)' : 'translate(4px,-50%)';
    return '<div class="mini-cyc" data-id="'+id+'">'+
      '<div class="mini-cyc-cap">'+L('cycle position','周期位置')+'</div>'+
      '<svg viewBox="0 0 '+W+' '+H+'" preserveAspectRatio="none" role="img" aria-label="'+ariaLabel+'">'+
        '<rect x="0" y="'+((1-0.25)*H).toFixed(2)+'" width="'+W+'" height="'+(0.25*H).toFixed(2)+'" fill="color-mix(in srgb, var(--up) 10%, transparent)"/>'+
        '<rect x="0" y="0" width="'+W+'" height="'+(0.25*H).toFixed(2)+'" fill="color-mix(in srgb, var(--warn) 12%, transparent)"/>'+
        '<path d="'+pathD+'" stroke="'+accent+'" stroke-width="1.6" fill="none" vector-effect="non-scaling-stroke"/>'+
      '</svg>'+
      '<span class="mc-dot" style="background:'+accent+';left:'+dotLeftPct+';top:'+dotTopPct+'"></span>'+
      '<span class="mc-read" data-now="'+oscNow+'" data-left="'+dotLeftPct+'" data-top="'+dotTopPct+'" data-tfm="'+readTransform+'" style="color:'+accent+';left:'+dotLeftPct+';top:'+dotTopPct+';transform:'+readTransform+'">'+oscNow+'</span>'+
      '<span class="mc-x"></span>'+
      '<span class="mc-hov" style="background:'+accent+'"></span>'+
    '</div>';
  }
  /* build id→record map once from board data, used by hydrateMiniCycs */
  function _buildSById() {
    var m = {}; var all = (D.sectors||[]).concat(D.baskets||[]);
    for (var i=0; i<all.length; i++) { m[all[i].id] = all[i]; } return m;
  }
  function hydrateMiniCycs() {
    if (!window.SECTOR_CYCLES) return;
    var slots = document.querySelectorAll('#board .mini-cyc-slot, .si-trace .mini-cyc-slot');
    if (!slots.length) return;
    var sById = _buildSById();
    for (var i=0; i<slots.length; i++) {
      var slot = slots[i], id = slot.getAttribute('data-id');
      var rec = sById[id]; if (!rec) continue;
      var html = miniCycChart(rec); if (!html || html.indexOf('mini-cyc-slot')!==-1) continue;
      slot.outerHTML = html;
    }
  }
  function _decYearToYM(x) {
    var yr = Math.floor(x);
    var mo = Math.floor((x - yr) * 12);
    return yr+'-'+(mo+1<10?'0':'')+(mo+1);
  }
  function _initMiniCycHover(board) {
    if (!board || board._mcInit) return;
    board._mcInit = true;
    board.addEventListener('pointermove', function(e) {
      /* FIX 2 — hover handler now moves HTML elements, not SVG crosshair nodes */
      var wrap = e.target.closest('.mini-cyc'); if (!wrap) return;
      var id = wrap.getAttribute('data-id'); if (!id) return;
      var ser = _cycSeries(id); if (!ser) return;
      var pts = ser.pts; if (!pts.length) return;
      var svg = wrap.querySelector('svg'); if (!svg) return;
      var rect = svg.getBoundingClientRect();
      var frac = (e.clientX - rect.left) / (rect.width || 1);
      var xMin = pts[0].x, xMax = pts[pts.length-1].x, xRng = xMax-xMin||1;
      var xAt = xMin + frac * xRng;
      var lo=0, hi=pts.length-1;
      while (lo < hi) { var mid=(lo+hi)>>1; if (pts[mid].x < xAt) lo=mid+1; else hi=mid; }
      if (lo>0 && Math.abs(pts[lo-1].x-xAt)<Math.abs(pts[lo].x-xAt)) lo--;
      var pt = pts[lo];
      var W=320, H=52;
      var ex = ((pt.x-xMin)/xRng*W);
      var ey = H - pt.v/100*H;
      var xEl = wrap.querySelector('.mc-x');
      var hovEl = wrap.querySelector('.mc-hov');
      var readEl = wrap.querySelector('.mc-read');
      var dotEl = wrap.querySelector('.mc-dot');
      if(xEl){ xEl.style.display='block'; xEl.style.left=(ex/W*100).toFixed(3)+'%'; }
      if(hovEl){ hovEl.style.display='block'; hovEl.style.left=(ex/W*100).toFixed(3)+'%'; hovEl.style.top=(ey/H*100).toFixed(3)+'%'; }
      var ym = _decYearToYM(pt.x);
      var readout = Math.round(pt.v)+' · '+ym;
      if(readEl){
        readEl.textContent=readout;
        var lPct = ex/W*100;
        readEl.style.left = lPct+'%';
        readEl.style.top = (ey/H*100).toFixed(3)+'%';
        readEl.style.transform = lPct > 75 ? 'translate(-100%,-50%)' : 'translate(4px,-50%)';
        readEl.style.display='block';
      }
      if(dotEl) dotEl.style.display='none';
    });
    board.addEventListener('pointerleave', function(e) {
      var wrap = e.target.closest && e.target.closest('.mini-cyc');
      if (!wrap) { board.querySelectorAll('.mini-cyc').forEach(function(w){ _restoreMiniCyc(w); }); return; }
      _restoreMiniCyc(wrap);
    }, true);
    board.addEventListener('pointerout', function(e) {
      var wrap = e.target.closest && e.target.closest('.mini-cyc'); if (!wrap) return;
      if (wrap.contains(e.relatedTarget)) return;
      _restoreMiniCyc(wrap);
    });
  }
  function _restoreMiniCyc(wrap) {
    var xEl = wrap && wrap.querySelector('.mc-x'); if(xEl) xEl.style.display='none';
    var hovEl = wrap && wrap.querySelector('.mc-hov'); if(hovEl) hovEl.style.display='none';
    var readEl = wrap && wrap.querySelector('.mc-read');
    if(readEl){
      var orig = readEl.getAttribute('data-now'); if(orig) readEl.textContent=orig;
      readEl.style.left=readEl.getAttribute('data-left')||readEl.style.left;
      readEl.style.top=readEl.getAttribute('data-top')||readEl.style.top;
      readEl.style.transform=readEl.getAttribute('data-tfm')||'translateY(-50%)';
      readEl.style.display='';
    }
    var dotEl = wrap && wrap.querySelector('.mc-dot'); if(dotEl) dotEl.style.display='';
  }

  /* ---- conviction card ---- */
  function card(s){
    var c=s.conviction||{}, cy=s.cycle||{}, dir=c.dir||'flat';
    var nm = lang()==='zh' && s.name_zh ? s.name_zh : s.name;
    var sub = (s.kind==='basket' ? (s.etf_proxy?esc(s.etf_proxy)+' · ':'') : (esc(s.ticker||'')+' · ')) + esc(lang()==='zh'?(s.group_zh||s.group):s.group);
    var chips=[];
    // Phase chip: RS rank (63d) moved to hover tip (XSR-R2 ONE-rank law — fast-lens rank is THE displayed rank).
    var rsHover = (cy.rs_21d_rank||cy.rs_rank) ? ' data-tip-en="63d RS rank: #'+(cy.rs_21d_rank||cy.rs_rank)+' (slow clock — see fast tape below)" data-tip-zh="63日RS排名：第'+(cy.rs_21d_rank||cy.rs_rank)+'位（慢时钟——见下方快线）"' : '';
    if(cy.phaseLabel||cy.phase) chips.push('<span class="chip2"'+rsHover+'>'+esc(cy.phaseLabel||cy.phase)+'</span>');
    // XSR-W1b: fast-tape board rail — ordinal display (#2 of 11) + plain-word state.
    // Internal enum names (TURN SIGNALED, RALLY ON, etc.) NEVER appear at tier 1 —
    // state_plain_en/zh translations from engine._STATE_PLAIN_EN are used instead.
    // When rotation artifact absent (first nightly not yet run), show a quiet placeholder.
    var rot=s.rotation||null;
    var ftRail='';
    if(rot && rot.ordinal!=null && rot.n_matched!=null){
      var rcomp = rot.components||{};
      var isTop = (rot.ordinal <= Math.max(1, Math.round(rot.n_matched*0.18)));
      // Hover receipt carries the full detail (global rank, score, internal state) — NOT tier 1.
      var tipEn = 'Fast tape: #'+rot.ordinal+' of '+rot.n_matched+' (global rank #'+rot.rank+')'
        +(rot.score!=null?' · score: '+rot.score:'')
        +(rcomp.mom20!=null?' · 20d RS: '+rcomp.mom20:'')
        +(rot.state?' · internal state: '+rot.state:'')
        +(rot.stale?' · some inputs stale':'');
      var tipZh = '快线：第'+rot.ordinal+'位/共'+rot.n_matched+'（全局排名 #'+rot.rank+'）'
        +(rot.score!=null?' · 得分: '+rot.score:'')
        +(rcomp.mom20!=null?' · 20日RS: '+rcomp.mom20:'')
        +(rot.state?' · 内部状态: '+rot.state:'')
        +(rot.stale?' · 部分输入数据陈旧':'');
      var stateEn = esc(rot.state_plain_en||'');
      var stateZh = esc(rot.state_plain_zh||rot.state_plain_en||'');
      ftRail = '<div class="ft-rail'+(isTop?' ft-top':'')+'" data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'">'
        +'<span class="ft-rank">'+L('#'+rot.ordinal+' of '+rot.n_matched,'第'+rot.ordinal+'位/共'+rot.n_matched)+'</span>'
        +(stateEn?'<span class="ft-sep">·</span><span class="ft-state">'+L(stateEn,stateZh||stateEn)+'</span>':'')
        +'</div>';
    } else if(rot===null){
      // Rotation artifact absent — first wired nightly hasn't run yet.
      ftRail='<div class="ft-rail ft-await"><span class="ft-rank">'+L('fast lens','快线')+'</span>'
        +'<span class="ft-state">'+L('awaiting tonight\'s data','等待今晚数据')+'</span></div>';
    }
    if(c.confluence) chips.push('<span class="chip2">'+L('confluence','共振')+' <b>'+c.confluence.agree+'/'+c.confluence.of+'</b></span>');
    if(c.early) chips.push('<span class="chip2 early">'+L('early','偏早')+'</span>');
    var h=s.heat;
    if(h && h.heat_1M!=null) chips.push('<span class="chip2 '+(h.heat_1M>0?'up':'down')+'">'+L('heat','热度')+' <b>'+pc(h.heat_1M)+'</b></span>');
    // name → its own page: baskets open the dedicated theme page; sectors focus the embedded cycle map.
    var cycHref = 'sector_cycles.html#'+esc(s.id);
    var nameHtml = s.kind==='basket'
      ? '<a href="basket/'+esc(String(s.id).replace(/^b-/,''))+'.html">'+esc(nm)+'</a>'
      : '<a href="'+cycHref+'" data-focus="'+esc(s.id)+'">'+esc(nm)+'</a>';
    // XSR-R9: split view line — plain-word copy when conviction and fast-lens diverge ≥ 2 tiers.
    // No banned vocab (governor, OB, MACD, mom20, state names) — checked at glance tier.
    var splitLine = '';
    if(s.split_view){
      var splitEn=s.split_copy_en||'', splitZh=s.split_copy_zh||'';
      splitLine = '<div class="xsr-split">'+L(esc(splitEn),esc(splitZh))+'</div>';
    }
    return '<article class="card" style="--c:'+esc(s.accent||'var(--muted)')+'">'+
      '<div class="card-top"><div><div class="card-nm">'+nameHtml+'</div><div class="card-sub">'+sub+'</div></div>'+
        '<div class="conv"><span class="conv-badge tier-'+dir+'">'+L(esc(c.label_en),esc(c.label_zh||c.label_en))+'</span>'+
        '<div class="conv-score">'+c.score+'</div><div class="conv-sub">'+L('conviction','信念')+'</div></div></div>'+
      '<div class="chips">'+chips.join('')+'</div>'+
      miniCycChart(s)+
      ftRail+
      splitLine+
      '<div class="conflu">'+L('confluence','共振度')+': <b class="'+esc((c.confluence||{}).label||'')+'">'+esc((c.confluence||{}).label||'—')+'</b> · '+
        '<a href="'+cycHref+'" data-focus="'+esc(s.id)+'" style="color:var(--link)">'+L('open cycle →','打开周期 →')+'</a></div>'+
    '</article>';
  }
  function renderBoard(){
    var el=document.getElementById('board'); if(!el) return;
    el.innerHTML = (D.sectors||[]).map(card).join('');
  }
  /* ---- grader scorecard ---- */
  function renderGrader(){
    var el=document.getElementById('grader');
    if(!GR || !GR.available){ el.hidden=false; el.innerHTML='<h2>'+L('Self-grader','自评分器')+'</h2><div class="muted sm">'+
      L('Accruing — dated calls are logged and will be graded against realized forward returns as time passes ('+(GR.n_calls||0)+' calls logged).',
        '累积中 — 带日期的判断已记录，将随时间推移对照已实现的前瞻收益进行评分（已记录 '+(GR.n_calls||0)+' 个判断）。')+'</div>'; return; }
    var bh=GR.by_horizon||{}, cells=[];
    ['21d','63d','126d'].forEach(function(k){
      var h=bh[k]; if(!h) return;
      if(h.dir_hit_rate==null){ cells.push('<div class="gr-cell"><div class="rg-k">'+k+'</div><div class="muted sm">'+L('accruing','累积中')+' (n='+(h.n||0)+')</div></div>'); return; }
      cells.push('<div class="gr-cell"><div class="rg-k">'+k+' · n='+h.n+'</div>'+
        '<div class="rg-v" style="font-size:16px">'+Math.round(h.dir_hit_rate*100)+'% '+L('hit','命中')+'</div>'+
        '<div class="rg-d">'+L('rank-IC','秩相关')+' '+(h.rank_ic!=null?h.rank_ic:'—')+' · '+L('excess','超额')+' '+(h.mean_excess_vs_bench!=null?(h.mean_excess_vs_bench*100).toFixed(1)+'%':'—')+'</div></div>');
    });
    el.hidden=false;
    el.innerHTML='<h2>'+L('Self-grader — measured accuracy','自评分器 — 已衡量准确度')+'</h2>'+
      '<div class="muted sm">'+L('Realized directional hit-rate, cross-sectional rank-IC and excess-vs-SPY of the conviction calls, by horizon. Sparse until it accrues; never fed back into the live score.',
        '按时间跨度衡量信念判断的已实现方向命中率、横截面秩相关与超越SPY的超额收益。数据累积前较稀疏；绝不回灌入实时评分。')+'</div>'+
      '<div class="gr-grid">'+(cells.join('')||'<div class="muted sm">'+L('accruing','累积中')+'</div>')+'</div>';
  }

  function focusDelegate(e){
    var a=e.target.closest('a[data-focus]'); if(!a) return;
    var id=a.getAttribute('data-focus');
    if(window.SectorCyclesFocus && window.SectorCyclesFocus(id)) e.preventDefault();
  }
  function boot(){
    regimeBanner(); renderBoard(); renderGrader();
    var board=document.getElementById('board'); if(board){ board.addEventListener('click', focusDelegate); _initMiniCycHover(board); }
    var lanes=document.getElementById('actnow'); if(lanes){ lanes.addEventListener('click', focusDelegate); _initMiniCycHover(lanes); }
    document.addEventListener('langchange', function(){ regimeBanner(); renderBoard(); renderGrader(); if(board) _initMiniCycHover(board); });
    if(window.SECTOR_CYCLES) hydrateMiniCycs();
  }
  window.__siTrace = function(bid){
    var all=(D.baskets||[]).concat(D.sectors||[]);
    for(var i=0;i<all.length;i++){ if(all[i].id===bid||all[i].id==='b-'+bid) return card(all[i]); }
    return null;
  };
  window.__siTraceHydrate = function(){ if(window.SECTOR_CYCLES){ try{ hydrateMiniCycs(); }catch(e){} } };
  document.addEventListener('sc:cycles-data', hydrateMiniCycs);
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();
</script>
{# the embedded cycle-map overlay — the three critical files are appended in ONE pass with
   async=false: order-preserving execution, but the browser downloads them in PARALLEL (killing
   the old load-event 3-hop waterfall), and each reuses its <link rel=preload> response. The heavy
   per-entity SERIES arrays load after first paint (SC_SERIES_DATA → sector_cycles.js); narr+dna
   stay deferred to first focus (SC_LAZY_EXTRAS). vUrl reuses the optimizer's ?v= immutable URL. #}
<script>
(function(){
  window.SC_LAZY_EXTRAS=true;  // defer narr+dna to first sector focus (see sector_cycles.js)
  window.SC_EXTRA_DATA=['sector_cycles_narr_data.js','sector_cycles_dna_data.js'];
  window.SC_SERIES_DATA='sector_cycles_series_data.js';  // heavy arrays, hydrated after first paint
  function vUrl(name){try{var l=document.querySelector('link[rel="preload"][href^="'+name+'"],link[rel="prefetch"][href^="'+name+'"]');if(l){var h=l.getAttribute('href');if(h)return h;}}catch(e){}return name;}
  var files=['sector_cycles_data.js','mm_charts.js','sector_cycles.js'];
  var head=document.head;
  files.forEach(function(f,i){
    var s=document.createElement('script'); s.async=false; s.src=vUrl(f);
    if(i===0) s.addEventListener('load',function(){ document.dispatchEvent(new CustomEvent('sc:cycles-data')); });
    head.appendChild(s);
  });
})();
</script>
