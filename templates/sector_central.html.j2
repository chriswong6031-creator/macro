          <div class="rvx-hocol in">
            <div class="lbl">{{ t('Taking the lead', '接过领先') }}</div>
            <div class="nm">{% if _tc_lead.strength %}{{ t(_tc_lead.strength[0].name, _tc_lead.strength[0].name_zh) }}{% if _tc_lead.strength|length > 1 %} · {{ t(_tc_lead.strength[1].name, _tc_lead.strength[1].name_zh) }}{% endif %}{% else %}—{% endif %}</div>
            <div class="meta" id="hero-in-meta"{% if _tc_lead.strength %} data-id="{{ _tc_lead.strength[0].id }}"{% endif %}></div>
          </div>
