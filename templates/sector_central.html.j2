<script src="lightweight-charts.js"></script>
<script>
var BASKETS=null, CHART=null, THEME=null;
function __siInitPage(payload){
BASKETS = payload; window.BASKETS = payload;
CHART = payload.chart || {dates:[],bench:[],baskets:{}};
THEME = BASKETS.theme_intel || null;
/* FIX 1c — strip "(Equal-Weight)" / "（等权）" suffixes from all string values at boot.
   deepStrip covers THEME (same object ref inside BASKETS) and the THEME_ALERTS array. */
function deepStrip(obj) {
  if (!obj || typeof obj !== 'object') return;
  const ewRe = /\s*[（(]\s*(?:equal[-\s]?weight(?:ed)?|等权(?:重)?)\s*[）)]/gi;
  for (const k of Object.keys(obj)) {
    const v = obj[k];
    if (typeof v === 'string') obj[k] = v.replace(ewRe, '');
    else if (v && typeof v === 'object') deepStrip(v);
  }
}
deepStrip(BASKETS);
/* The tape band fetches its quotes from a parse-time script and usually paints before
   this deferred payload lands, i.e. against an empty name map. Now that the map is in
   AND de-suffixed, let it repaint with real display names. */
try{ if(window.__ftrTapeNamesReady) window.__ftrTapeNamesReady(); }catch(e){ console.warn('tape names', e); }
const L = (en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`;
function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
// W4 velocity/heat card-chip helpers removed with the dead FTR chip lane (#4257).
const TBL_COLS = ['1d','5d','20d','60d','MTD','YTD'];
const TBL_MODES = [['raw','Raw'],['rel','vs S&P'],['sigma','σ']];
const RANGES = [['3M',63],['6M',126],['YTD','ytd'],['1Y',252],['All',0]];
const PALETTE = ['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635','#38bdf8','#e879f9','#34d399','#fbbf24','#60a5fa'];
const colorOf = {}; (BASKETS.baskets||[]).forEach((b,i)=>colorOf[b.id]=PALETTE[i%PALETTE.length]);
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const BENCH_COLOR = () => cssv('--muted') || '#94a3b8';

const fmtPct = x => x==null ? '—' : (x>=0?'+':'')+(x*100).toFixed(1)+'%';
const fmtZ   = x => x==null ? '—' : (x>=0?'+':'')+x.toFixed(1)+'σ';
const cls    = x => x==null ? 'muted' : (x>=0?'pos':'neg');
const esc    = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const lastIdx = a => { for(let i=a.length-1;i>=0;i--) if(a[i]!=null) return i; return -1; };

function startIdxFor(col,dates,li){
  const u = col.toUpperCase();
  if(u==='MTD'||u==='YTD'){ const p = dates[li].slice(0, u==='MTD'?7:4); let i=li; while(i>0 && dates[i-1].startsWith(p)) i--; return i>0?i-1:null; }
  const i = li-parseInt(col,10); return i>=0?i:null;
}
function winRet(levels,col){ if(!levels) return null; const li=lastIdx(levels); if(li<0) return null;
  const si=startIdxFor(col,CHART.dates,li); if(si==null||levels[si]==null) return null; return levels[li]/levels[si]-1; }
function winZ(levels,col){ const n=parseInt(col,10); if(!n||!levels) return null; const li=lastIdx(levels); if(li<252+n) return null;
  const hr=[]; for(let i=li-252;i<=li;i++) hr.push((levels[i]!=null&&levels[i-n]!=null)?levels[i]/levels[i-n]-1:null);
  const cur=hr[hr.length-1]; const base=hr.slice(0,-1).filter(v=>v!=null); if(cur==null||base.length<200) return null;
  const m=base.reduce((a,b)=>a+b,0)/base.length; const sd=Math.sqrt(base.reduce((a,b)=>a+(b-m)**2,0)/(base.length-1)); return sd>0?(cur-m)/sd:null; }
const ratio = a => a.map((v,i)=>(v!=null&&CHART.bench[i]!=null)?v/CHART.bench[i]:null);

function sparkSvg(values,{w=92,h=26,color=''}={}){
  const vs=(values||[]).filter(v=>v!=null); if(vs.length<2) return '';
  const min=Math.min(...vs),max=Math.max(...vs),span=(max-min)||1;
  const pts=vs.map((v,i)=>[i/(vs.length-1)*w, h-3-(v-min)/span*(h-7)]);
  const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
  const col = color || (vs[vs.length-1]>=vs[0]?cssv('--up'):cssv('--down'));
  const e=pts[pts.length-1];
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><path d="${d}" fill="none" stroke="${col}" stroke-width="1.4"/><circle cx="${e[0].toFixed(1)}" cy="${e[1].toFixed(1)}" r="1.6" fill="${col}"/></svg>`;
}
const sparkTail = (levels,n=60) => (levels||[]).filter(x=>x!=null).slice(-n);

function renderTabs(el, opts, active, cb){
  el.innerHTML = opts.map(([v,lab])=>`<button data-v="${v}" class="${v==active?'on':''}">${lab}</button>`).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{ el.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); cb(b.dataset.v); });
}

// ---- 01 table -------------------------------------------------------------
let btblMode = localStorage.getItem('fw-btbl-mode')||'rel';
let btblSort = JSON.parse(localStorage.getItem('fw-btbl-sort')||'{"col":"20d","dir":-1}');
let btblCat = 'All'; // active category filter
let btblShowAll = false; // module-scoped: true = render all rows, not just top-8+bottom-8
const TABLE_SHOW = 8; // top 8 + bottom 8 at rest (16 rows)

function renderBTableCats(){
  const el=document.getElementById('btbl-cat-filter'); if(!el) return;
  const cats=['All',...(BASKETS.categories||[])];
  el.innerHTML=cats.map(c=>`<button class="bcat-chip${btblCat===c?' on':''}" data-cat="${esc(c)}">${c==='All'?L('All','全部'):esc(c)}</button>`).join('');
  el.querySelectorAll('.bcat-chip').forEach(b=>b.onclick=()=>{ btblCat=b.dataset.cat; renderBTableCats(); renderBTable(); });
}

/* ── GR1 · group pulse on the board (group_pulse.v1) ────────────────────────────────
   One extra column per basket: how participation CHANGED and how many members are
   actually moving. Sorting by it is a disclosed RULE over named legs — state change,
   then breadth of movement, then agreement — never a composite, rank or heat number
   (R-TIL-3). The default sort is untouched; the reader opts in by clicking the header.
   Absent artifact (before the first nightly) → no column, no rule line, no error. */
let GPULSE=null;
const GR_CHG={strengthening:['Broadening','扩散中','↑'], steady:['Steady','持平','→'],
              cooling:['Narrowing','收窄中','↓'], quiet:['Quiet','安静','·']};
const GR_CHG_RANK={strengthening:0, steady:1, cooling:2, quiet:3};
function grPulseOf(id){ return (GPULSE&&GPULSE[id])||null; }
function grPulseCell(id){
  const p=grPulseOf(id);
  if(!p) return '<span class="muted">—</span>';
  const chg=((p.episode||{}).state_change)||'quiet', w=GR_CHG[chg]||GR_CHG.quiet;
  const pa=p.participation||{}, n=pa.activity_n, nc=p.n_covered;
  const tipEn='How the number of members moving unusually changed against the sessions before it, and how many are moving today. A member counts as moving when its move against SPY is large versus its own last 63 sessions, or its volume runs at least 1.5x its own 63-day median. Description of participation only — never a buy or sell read.';
  const tipZh='与此前几个交易日相比，出现异动的成分股数量如何变化，以及今日有多少只在动。当某只成分股对冲SPY后的涨跌明显大于其自身近63个交易日的常态，或成交量至少达到自身63日中位数的1.5倍时，计为「在动」。仅描述参与度，不构成买卖判断。';
  const mv=(n!=null&&nc!=null)?` <span class="gpr-mv">${L(`<b>${n}</b> of <b>${nc}</b> moving`,`<b>${nc}</b> 只中 <b>${n}</b> 只在动`)}</span>`:'';
  return `<span class="gpr-cell" data-tip-en="${esc(tipEn)}" data-tip-zh="${esc(tipZh)}"><span class="gpr-chg${chg==='strengthening'||chg==='cooling'?' on':''}"><span class="g">${w[2]}</span>${L(esc(w[0]),esc(w[1]))}</span>${mv}</span>`;
}
// The disclosed ordering rule, applied only when the reader selects the column.
function grCmp(a,b){
  const pa=grPulseOf(a.id), pb=grPulseOf(b.id);
  if(!pa&&!pb) return 0;
  if(!pa) return 1;                       // no read tonight → end of the list, either way
  if(!pb) return -1;
  const ca=GR_CHG_RANK[(pa.episode||{}).state_change]??3, cb=GR_CHG_RANK[(pb.episode||{}).state_change]??3;
  if(ca!==cb) return ca-cb;
  const sa=(pa.participation||{}).activity_share??-1, sb=(pb.participation||{}).activity_share??-1;
  if(sa!==sb) return sb-sa;
  const ga=(pa.direction||{}).agreement_pct??-1, gb=(pb.direction||{}).agreement_pct??-1;
  return gb-ga;
}
function renderGroupPulseCol(){
  fetch('basketdata/pulse.json',{cache:'no-cache'}).then(r=>{ if(!r.ok) throw 0; return r.json(); })
    .then(j=>{ if(!j) return; GPULSE=j; renderBTable(); })
    .catch(()=>{/* absent before the first nightly — the column simply never appears */});
}

function renderBTable(){
  let allRows = Object.entries(CHART.baskets).map(([id,lv])=>{
    const b=(BASKETS.baskets||[]).find(x=>x.id===id); const rl=ratio(lv);
    const src = btblMode==='raw'?lv:rl;
    const vals={}; TBL_COLS.forEach(c=>{ vals[c]= btblMode==='sigma' ? (/^\d/.test(c)?winZ(rl,c):null) : winRet(src,c); });
    return {id,name:b?b.name:id,cat:b?b.category:'',color:colorOf[id]||'#888',spark:sparkTail(src),vals};
  });
  // Category filter
  if(btblCat&&btblCat!=='All') allRows=allRows.filter(r=>r.cat===btblCat);
  const sc=btblSort.col, dir=btblSort.dir;
  allRows.sort((a,b)=>{ if(sc==='name') return a.name.localeCompare(b.name)*dir;
    if(sc==='group') return grCmp(a,b)*(dir<0?1:-1);
    const x=a.vals[sc], y=b.vals[sc]; if(x==null) return 1; if(y==null) return -1; return (x-y)*dir; });
  // Top 8 + bottom 8 at rest (no duplicate if ≤16 total); btblShowAll overrides to full list.
  let rows=allRows;
  if(!btblShowAll && allRows.length>TABLE_SHOW*2){
    rows=[...allRows.slice(0,TABLE_SHOW),...allRows.slice(-TABLE_SHOW)];
  }
  const fmt = btblMode==='sigma' ? fmtZ : fmtPct;
  const th = c => `<th class="num ${c===sc?'sel':''}" data-c="${c}">${c}${c===sc?(dir<0?' ▾':' ▴'):''}</th>`;
  const gp=!!GPULSE, span=TBL_COLS.length+2+(gp?1:0);
  const grTh=gp?`<th class="gpr-th ${sc==='group'?'sel':''}" data-c="group">${L('Group pulse','整体动向')}${sc==='group'?(dir<0?' ▾':' ▴'):''}</th>`:'';
  let html = `<thead><tr><th data-c="name">Basket${sc==='name'?(dir<0?' ▾':' ▴'):''}</th>${grTh}<th class="num">60d</th>${TBL_COLS.map(th).join('')}</tr></thead><tbody>`;
  html += rows.map(r=>`<tr><td class="bname" data-id="${r.id}"><span class="dot" style="background:${r.color}"></span>${esc(r.name)}</td>
    ${gp?`<td class="gpr-td">${grPulseCell(r.id)}</td>`:''}
    <td class="num">${sparkSvg(r.spark,{color:r.color})}</td>
    ${TBL_COLS.map(c=>`<td class="num ${cls(r.vals[c])}">${r.vals[c]==null?'<span class="muted">—</span>':fmt(r.vals[c])}</td>`).join('')}</tr>`).join('');
  if(!btblShowAll && allRows.length>TABLE_SHOW*2){
    html+=`<tr id="btbl-showall-row"><td colspan="${span}" style="text-align:center;padding:6px">
      <button class="lst-more" onclick="btblShowAll=true;renderBTable()">${L('Show all','显示全部')} (${allRows.length})</button>
    </td></tr>`;
  }
  if(btblMode==='raw'){ const bv={}; TBL_COLS.forEach(c=>bv[c]=winRet(CHART.bench,c));
    html += `<tr><td class="bname" style="font-weight:500"><span class="dot" style="background:${BENCH_COLOR()}"></span>S&amp;P 500</td>${gp?'<td></td>':''}<td></td>${TBL_COLS.map(c=>`<td class="num ${cls(bv[c])}">${fmtPct(bv[c])}</td>`).join('')}</tr>`; }
  html += '</tbody>';
  const tbl=document.getElementById('btable'); tbl.innerHTML=html;
  // The ordering rule is printed where it orders — never a hidden weighting.
  const rl=document.getElementById('btbl-gr-rule');
  if(rl) rl.innerHTML=gp?L(
    'Group pulse: how many members are actually moving, and whether that count is broadening or narrowing. Sorting by it orders on state change, then breadth of movement, then agreement — no composite score. Agreement counts only where at least four members are moving; a basket without one sorts below a basket that has one. Baskets with no read tonight sit at the end. Context only: it never ranks, sizes or gates a position.',
    '「整体动向」：有多少成分股真正在动，以及这个数量在扩散还是收窄。按它排序的依据为：参与度变化，其次是在动成分股的广度，再次是方向一致度 — 不使用任何综合评分。方向一致度仅在至少四只成分股在动时才计入；没有该读数的篮子排在有读数的之后。今晚没有读数的篮子排在最后。仅为背景：不参与排序权重、仓位或准入。'):'';
  tbl.querySelectorAll('th[data-c]').forEach(h=>h.onclick=()=>{ const c=h.dataset.c;
    if(c===btblSort.col) btblSort.dir*=-1; else btblSort={col:c,dir:c==='name'?1:-1};
    localStorage.setItem('fw-btbl-sort',JSON.stringify(btblSort)); renderBTable(); });
  tbl.querySelectorAll('.bname[data-id]').forEach(n=>n.onclick=()=>{ const id=n.dataset.id||''; if(/^[a-z0-9_-]+$/i.test(id)) location.href='basket/'+id+'.html'; });
}

// ---- 02 chart -------------------------------------------------------------
let chart=null, chartMode='rel', chartRange=parseInt(localStorage.getItem('fw-brange')||'252',10)||252, hidden={};
/* Set when renderChart() is asked to draw while #chart is still inside a display:none
   view; si:view clears it the moment Explore is really on screen. See renderChart(). */
let _chartDeferred=false;
function chartSets(){
  const sets=Object.entries(CHART.baskets).map(([id,levels])=>{ const b=(BASKETS.baskets||[]).find(x=>x.id===id);
    return {key:id,label:b?b.name:id,color:colorOf[id]||'#888',levels}; });
  if(chartMode==='rel') return sets.map(s=>({...s,levels:ratio(s.levels)}));
  return [...sets,{key:'bench',label:'S&P 500',color:BENCH_COLOR(),levels:CHART.bench}];
}
function rangeStart(dates){ if(chartRange==='ytd'){ const y=dates[dates.length-1].slice(0,4); const i=dates.findIndex(d=>d.startsWith(y)); return i<=0?0:i-1; }
  return chartRange?Math.max(0,dates.length-chartRange):0; }
function chartOpts(){ return { autoSize:true,
  layout:{ background:{type:'solid',color:'transparent'}, textColor:cssv('--muted')||'#9aa4b2', fontSize:11 },
  grid:{ vertLines:{visible:false}, horzLines:{color:cssv('--line')||'#222'} },
  rightPriceScale:{ borderColor:cssv('--line')||'#222' }, timeScale:{ borderColor:cssv('--line')||'#222' },
  crosshair:{ mode:0, vertLine:{labelBackgroundColor:cssv('--panel2')||'#333'}, horzLine:{labelBackgroundColor:cssv('--panel2')||'#333'} } }; }
// Crosshair floating tooltip
let _xhTooltip=null;
function _xhTip(){
  if(!_xhTooltip){
    _xhTooltip=document.createElement('div');
    _xhTooltip.id='ch-tip';
    _xhTooltip.style.cssText='position:absolute;pointer-events:none;display:none;background:var(--panel2,#1e222a);border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:11.5px;white-space:nowrap;z-index:30;box-shadow:0 4px 16px rgba(0,0,0,.3)';
    const chartEl=document.getElementById('chart');
    if(chartEl){ chartEl.style.position='relative'; chartEl.appendChild(_xhTooltip); }
  }
  return _xhTooltip;
}
function renderChart(){
  const el=document.getElementById('chart'); if(typeof LightweightCharts==='undefined'){ el.innerHTML='<p class="muted">The charting library failed to load — the rest of the page is unaffected.</p>'; return; }
  /* Under the workspace shell #chart starts inside a display:none view, where it measures
     0 wide — and the basket payload lands (calling us) long before anyone opens Explore.
     lightweight-charts binds autoSize at CREATION: a chart born zero-wide never recovers.
     Measured on the shipped page 2026-08-04: with Explore open, #chart was 0px wide and
     all seven canvases sat at the library's 300px default inside a ~950px slot, and
     neither a window resize event nor a container width nudge moved them. So do not
     create it yet — mark the draw deferred and let the si:view handler run us again. */
  if(!chart && !el.clientWidth){ _chartDeferred=true; return; }
  if(!chart){ chart=LightweightCharts.createChart(el,chartOpts()); }
  (chart.__series||[]).forEach(s=>chart.removeSeries(s)); chart.__series=[];
  const start=rangeStart(CHART.dates);
  const sets=chartSets().filter(s=>!hidden[s.key]); const nVis=sets.length;
  const seriesMeta=[]; // [{key,color,label,data}] for crosshair
  sets.forEach(set=>{
    let base=null; const data=[];
    for(let i=start;i<CHART.dates.length;i++){ const v=set.levels[i]; if(v==null) continue; if(base===null) base=v; data.push({time:CHART.dates[i], value:100*(v/base-1)}); }
    if(data.length<2) return;
    const s=chart.addLineSeries({ color:set.color, lineWidth:2, priceLineVisible:false, lastValueVisible:nVis<=4, title:nVis<=4?set.label:'',
      priceFormat:{type:'custom',minMove:0.01,formatter:v=>(v>=0?'+':'')+v.toFixed(1)+'%'} });
    s.setData(data); chart.__series.push(s); seriesMeta.push({key:set.key,color:set.color,label:set.label,s,data});
  });
  // Crosshair move — show nearest basket name + value
  if(chart.__xhSub){ try{ chart.__xhSub.unsubscribe(); }catch(e){} }
  const tip=_xhTip();
  chart.__xhSub=chart.subscribeCrosshairMove(function(param){
    if(!param||!param.point||!param.seriesData||!param.seriesData.size){tip.style.display='none';return;}
    let best=null, bestDist=Infinity;
    seriesMeta.forEach(m=>{
      const d=param.seriesData.get(m.s);
      if(d==null) return;
      // Convert series value to pixel Y for an apples-to-apples comparison with param.point.y.
      const pxY=m.s.priceToCoordinate?m.s.priceToCoordinate(d.value):null;
      const dist=pxY!=null?Math.abs(pxY-(param.point.y||0)):Math.abs(d.value-(param.point.y||0));
      if(dist<bestDist){bestDist=dist;best={...m,val:d.value};}
    });
    if(!best){tip.style.display='none';return;}
    const v=best.val;
    const nm=isZh()?(BASKETS.baskets||[]).find(b=>b.id===best.key)?.name_zh||best.label:best.label;
    tip.innerHTML=`<span style="color:${best.color}">●</span> ${esc(nm)} <b style="color:${v>=0?'var(--up)':'var(--down)'}">${(v>=0?'+':'')+v.toFixed(1)}%</b>`;
    const x=param.point.x, y=param.point.y;
    tip.style.left=(x+12)+'px'; tip.style.top=(y-18)+'px'; tip.style.display='block';
  });
  // Guard: attach mouseleave once per element (renderChart runs on every range/lang/theme change).
  if(!el._mlGuard){ el._mlGuard=true; el.addEventListener('mouseleave',()=>{tip.style.display='none';},{passive:true}); }
  chart.timeScale().fitContent(); renderChartLegend();
}
function renderChartLegend(){
  const el=document.getElementById('chart-legend'); const st=rangeStart(CHART.dates);
  const chips=chartSets().map(s=>{ const li=lastIdx(s.levels); let base=null; for(let i=st;i<=li;i++){ if(s.levels[i]!=null){ base=s.levels[i]; break; } }
    const v=(base!=null&&s.levels[li]!=null)?100*(s.levels[li]/base-1):null;
    return `<span class="lchip ${hidden[s.key]?'off':''}" data-k="${s.key}"><span class="dot" style="background:${s.color}"></span>${esc(s.label)} <span class="lv">${v==null?'':(v>=0?'+':'')+v.toFixed(1)+'%'}</span></span>`;
  }).join('');
  // All / None toggle buttons
  const allBtn=`<button class="leg-toggle" onclick="Object.keys(hidden).forEach(k=>delete hidden[k]);renderChart()">${L('All','全选')}</button>`;
  const noneBtn=`<button class="leg-toggle" onclick="chartSets().forEach(s=>hidden[s.key]=true);renderChart()">${L('None','全不选')}</button>`;
  el.innerHTML=allBtn+noneBtn+chips;
  el.querySelectorAll('.lchip').forEach(c=>c.onclick=()=>{ hidden[c.dataset.k]=!hidden[c.dataset.k]; renderChart(); });
}
function initChartDefaults(){
  const ranked=(BASKETS.baskets||[]).slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0));
  ranked.slice(6).forEach(b=>hidden[b.id]=true);
}

