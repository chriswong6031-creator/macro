  rvxApplyDim();
}
function rvxSpark(id,pos){ const lv=CHART.baskets[id]; if(!lv) return ''; return sparkSvg(sparkTail(ratio(lv)),{w:56,h:22,color:pos?cssv('--up'):cssv('--down')}); }
function renderRotBoard(){
