function renderInternals(){
  const mc=(THEME&&THEME.market_concentration)||{}; const zh=isZh();
  const vmap={narrow:[zh?'狭窄':'Narrow','var(--down)'],broad:[zh?'广泛':'Broad','var(--up)'],mixed:[zh?'中性':'Mixed','var(--warn)']};
