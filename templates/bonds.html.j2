{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro kpi(label, zh, val, unit='', sub='') -%}
<div class="kpi">{{ t(label, zh) }}<b>{% if val is none %}<span class="faint">—</span>{% else %}{{ val }}{{ unit }}{% endif %}</b>{% if sub %}<span class="ksub">{{ sub }}</span>{% endif %}</div>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Bonds & Bond Health — {{ as_of }}</title>
{% set seo_title = 'Bonds and Bond Health — Yields, Curve and Credit | Mastermind' %}{% set seo_desc = 'A bonds hub tracking Treasury yields, the yield curve, credit spreads and bond-market health with regime-aware reads.' %}{% set seo_path = 'bonds.html' %}
{% include "_seo_head.html.j2" %}
{% include '_plotly_head.html.j2' %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}}; --green:{{C.green}}; --teal:{{C.teal}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-2,.cols-3{grid-template-columns:1fr}}
.sec-head{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em;margin:26px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px;min-width:0;overflow-wrap:break-word}
.card h2{margin:0 0 4px;font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.brand{font-weight:800;font-size:21px;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.brand .gn{color:var(--blue)}
.lead{color:var(--muted);font-size:14px;margin:0 0 20px}
.hero-state{font-size:40px;font-weight:800;letter-spacing:-.02em;margin:6px 0 4px;line-height:1}
.hero-state small{font-size:18px;color:var(--muted);font-weight:700}
.hero-meta{font-size:14px;color:var(--text);margin-bottom:8px}.hero-meta b{color:var(--ink)}
.verdict-lead{font-size:15px;color:var(--text);line-height:1.5;margin:8px 0 0}
.sub{font-size:13px;color:var(--muted);min-width:0}.faint{color:var(--faint)}
.pill{display:inline-block;max-width:100%;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;background:#eef1f6;color:var(--ink);margin:2px 4px 2px 0;white-space:normal;overflow-wrap:anywhere}
html[data-theme="dark"] .pill{background:#222732}
.kpis{display:flex;gap:18px 22px;flex-wrap:wrap;margin-top:14px}
.kpi{font-size:12.5px;color:var(--muted);min-width:0}.kpi b{display:block;font-size:19px;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.kpi .ksub{font-size:11px;color:var(--faint)}
.band-chip{display:inline-block;max-width:100%;padding:4px 13px;border-radius:999px;font-size:13px;font-weight:700;color:#fff;letter-spacing:.01em;white-space:normal;overflow-wrap:anywhere}
.flag{display:inline-block;max-width:100%;padding:5px 11px;border-radius:8px;font-size:12.5px;font-weight:600;margin-top:12px;line-height:1.4;white-space:normal;overflow-wrap:anywhere}
.flag.warn{background:rgba(245,173,66,.16);color:#9a6a10}
.flag.alarm{background:rgba(211,11,11,.13);color:var(--red)}
.flag.info{background:rgba(40,95,255,.10);color:var(--blue)}
.flag.ok{background:rgba(26,127,67,.12);color:var(--green)}
.tax-note{font-size:13px;color:var(--muted);margin:8px 0 0;line-height:1.5}
/* stress-leg mini bars */
.legs{margin-top:14px;display:flex;flex-direction:column;gap:7px}
.leg{display:grid;grid-template-columns:118px 1fr 34px;align-items:center;gap:10px;font-size:12px}
.leg .lname{color:var(--text);min-width:0}
.leg .lbar{position:relative;height:8px;background:#eef1f6;border-radius:5px;overflow:hidden}
html[data-theme="dark"] .leg .lbar{background:#222732}
.leg .lfill{position:absolute;left:0;top:0;bottom:0;border-radius:5px}
.leg .lval{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.lvg{margin-left:5px;font-weight:800;font-size:11px;cursor:help}
.vg-measured{color:var(--green)}.vg-directional{color:var(--amber)}.vg-context{color:var(--faint)}.vg-inverted{color:var(--indigo)}
.measured-edge{margin-top:12px;padding:10px 13px;border-radius:10px;background:rgba(26,127,67,.08);font-size:13px;line-height:1.5;color:var(--text)}
.measured-edge b{color:var(--green)}
html[data-theme="dark"] .measured-edge{background:rgba(26,127,67,.12)}
/* cross-asset drivers */
.drv{display:grid;grid-template-columns:120px 1fr;gap:10px 16px;align-items:start;padding:12px 0;border-bottom:1px solid var(--grid);min-width:0}
.drv:last-child{border-bottom:none}
.drv .dasset{font-weight:700;color:var(--ink);font-size:14px}
.drv .dnote{font-size:13px;color:var(--muted);line-height:1.5;min-width:0;overflow-wrap:anywhere}
.drv .dnote b{color:var(--text)}
/* timeline */
.timeline{margin-top:6px}
.tl-day{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 0 4px}
.tl-ev{display:flex;align-items:baseline;gap:10px;padding:7px 0;border-bottom:1px solid var(--grid);font-size:13px}
.tl-type{flex:none;min-width:78px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
.tl-head{color:var(--text)}
.sev-high .tl-type{color:var(--red)}.sev-medium .tl-type{color:#9a6a10}.sev-info .tl-type{color:var(--muted)}
.note{font-size:13px;color:var(--muted);line-height:1.6}.note b{color:var(--ink)}
.site-footer{max-width:1180px;margin:30px auto 0;padding:18px 20px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:12.5px}
.meta-foot{font-size:12px;color:var(--faint);margin-top:8px}
/* section jump-nav */
.jump-nav{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 20px}
.jump-nav a{font-size:12px;font-weight:600;color:var(--muted);background:var(--card);border:1px solid var(--grid);border-radius:999px;padding:5px 12px;white-space:nowrap;transition:color .15s,border-color .15s}
.jump-nav a:hover{color:var(--ink);border-color:var(--blue)}
/* duration compass gauge */
.compass-wrap{margin:10px 0 4px}
.compass-track{position:relative;height:30px;border-radius:8px;background:linear-gradient(90deg,rgba(211,11,11,.16),rgba(160,160,160,.10) 50%,rgba(26,127,67,.16));border:1px solid var(--grid)}
.compass-mid{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.6}
.compass-marker{position:absolute;top:-5px;width:3px;height:40px;border-radius:2px;background:var(--ink);transition:left .4s cubic-bezier(.34,1.2,.5,1)}
.compass-ends{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:5px}
.bias-chip{display:inline-block;padding:4px 13px;border-radius:999px;font-size:13px;font-weight:700;color:#fff}
.leg-state{margin-left:auto;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
/* generic scorecard table */
.sc-wrap{overflow-x:auto}
.sc-tbl{width:100%;border-collapse:collapse;font-size:13px;min-width:640px}
.sc-tbl th{text-align:right;padding:6px 8px;border-bottom:1px solid var(--grid);color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;font-weight:700;white-space:nowrap}
.sc-tbl th:first-child,.sc-tbl td:first-child{text-align:left}
.sc-tbl td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums;white-space:nowrap}
.sc-tbl tr:hover td{background:rgba(40,95,255,.04)}
html[data-theme="dark"] .sc-tbl tr:hover td{background:rgba(40,95,255,.10)}
.sc-tbl .cty{font-weight:700;color:var(--ink)}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;vertical-align:middle}
.mini-tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;color:#fff}
.stale-tag{font-size:9.5px;color:var(--amber);font-weight:700;margin-left:4px}
/* bonds→everything transmission rows */
.xa-row{display:grid;grid-template-columns:152px 1fr 92px;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--grid)}
.xa-row:last-child{border-bottom:none}
.xa-asset{font-weight:700;color:var(--ink);font-size:13.5px}
.xa-asset .xa-sub{display:block;font-size:11px;color:var(--muted);font-weight:500}
.xa-note{margin-top:5px;font-size:12px;color:var(--muted);line-height:1.45;overflow-wrap:anywhere}
.xa-bar{position:relative;height:9px;background:#eef1f6;border-radius:5px}
html[data-theme="dark"] .xa-bar{background:#222732}
.xa-mid{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--faint);opacity:.5}
.xa-fill{position:absolute;top:0;bottom:0;border-radius:5px}
.xa-verd{text-align:right;font-size:12px;font-weight:700}
.table-wrap{overflow-x:auto}
.supply-tbl,.credit-cycle-tbl{width:100%;border-collapse:collapse;font-size:13px;min-width:620px}
/* phone: the 152px + 92px fixed columns + bar don't fit a card on a narrow screen
   (the row overflowed the viewport). Stack to two rows — asset / verdict on top,
   the bar full-width below — and let the label column shrink + wrap. */
@media(max-width:560px){
  .wrap{padding:0 12px 48px}
  .card{padding:16px}
  .hero-state{font-size:32px}
  .site-footer{padding:16px 12px}
  .drv{grid-template-columns:1fr}
  .tl-ev{align-items:flex-start}
  .tl-type{min-width:62px}
  .leg{grid-template-columns:minmax(0,1fr) 44px;row-gap:6px}
  .leg .lname{grid-column:1/2}
  .leg .lval{grid-column:2/3}
  .leg .lbar{grid-column:1/3}
  .xa-row{grid-template-columns:1fr auto;column-gap:10px;row-gap:7px}
  .xa-row>.xa-asset{grid-area:1/1;min-width:0}
  .xa-row>.xa-verd{grid-area:1/2;min-width:0}
  .xa-row>.xa-bar{grid-area:2/1/3/3}
}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
<nav class="site-nav" style="max-width:1180px;margin:18px auto 16px;padding:0 20px">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<div class="wrap">
  <div class="brand">🏛️ Bonds <span class="gn">&amp; Bond Health</span></div>
  <p class="lead">{{ t('A compact read on bond-market health: curve, credit, real rates, rates volatility, funding stress, global yields and cross-asset spillovers. Context first; trade signals elsewhere.', '债市健康度速览：曲线、信用、实际利率、利率波动、资金压力、全球收益率与跨资产传导。先看背景；交易信号另列。') }}
  <span class="faint">· {{ t('As of', '截至') }} {{ as_of }}</span></p>

  <!-- ===================== SECTION JUMP-NAV ===================== -->
  <div class="jump-nav">
    <a href="#health">🩺 {{ t('Health', '健康度') }}</a>
    <a href="#compass">🧭 {{ t('Duration Compass', '久期罗盘') }}</a>
    <a href="#curve">📐 {{ t('Curve & Recession', '曲线与衰退') }}</a>
    <a href="#credit">⚠️ {{ t('Credit', '信用') }}</a>
    <a href="#real">💵 {{ t('Real Rates', '实际利率') }}</a>
    <a href="#stress">🌡️ {{ t('Stress & Hedge', '压力与对冲') }}</a>
    <a href="#global">🌍 {{ t('Global Scorecard', '全球记分卡') }}</a>
    <a href="#transmission">🔀 {{ t('Bonds → Markets', '债券 → 各市场') }}</a>
    <a href="#supply">🏦 {{ t('Supply & Fed', '供给与美联储') }}</a>
    <a href="#timeline">🕑 {{ t('Timeline', '时间线') }}</a>
  </div>

  <!-- ===================== HEALTH HERO ===================== -->
  <div id="health" class="grid cols-2" style="margin-bottom:18px">
    <div class="card">
      <h2>{{ t('Bond health score', '债券健康度') }}</h2>
      <div class="hero-state" style="color:{{ vm.health.color }}">{{ vm.health.score if vm.health.score is not none else '—' }}<small>/100 · {{ t(vm.health.label, vm.health.label_zh) }}</small></div>
      <div class="hero-meta">
        {{ t('Cycle', '周期') }} <b style="color:{{ vm.health.phase_color }}">{{ t(vm.health.phase_en, vm.health.phase_zh) }}</b>
        <span class="faint">·</span> {{ t('recession risk', '衰退风险') }} <b>{{ vm.health.recession_risk if vm.health.recession_risk is not none else '—' }}</b>/100
        <span class="faint">·</span> {{ t('drawdown risk', '回撤风险') }} <b>{{ vm.health.drawdown_risk if vm.health.drawdown_risk is not none else '—' }}</b>/100
        {% if usd_link %}<span class="faint">·</span> {{ t('10y corr to USD', '10年债对美元相关') }} <b class="{{ 'down' if usd_link.corr<0 else 'up' }}" data-tip-en="63d correlation with the broad dollar. Context, not forecast." data-tip-zh="与广义美元的63日相关。仅作背景，非预测。">{{ '%+.2f'|format(usd_link.corr) }}</b>{% if not usd_link.stable %} <span class="faint">{{ t('(unstable)', '（不稳定）') }}</span>{% endif %}{% endif %}
      </div>
      <p class="verdict-lead"><span class="l-en">{{ vm.health.verdict_en }}</span><span class="l-zh">{{ vm.health.verdict_zh }}</span></p>
      {% if vm.alarms %}{% for a in vm.alarms %}
      <div class="flag {{ 'alarm' if a.severity=='high' else 'warn' }}">⚑ <span class="l-en">{{ a.en }}</span><span class="l-zh">{{ a.zh }}</span></div>
      {% endfor %}{% else %}<div class="flag ok">✓ {{ t('No active bond-stress alarms.', '无活跃的债市压力警报。') }}</div>{% endif %}
      {% if vm.health.stress_legs %}
      <div class="legs">
        <div class="sub" style="margin-bottom:2px">{{ t('Stress contributions (0 = calm, 100 = max)', '压力来源（0=平静，100=最大）') }}</div>
        {% for leg in vm.health.stress_legs %}
        <div class="leg"><span class="lname">{{ t(leg.en, leg.zh) }}</span>
          <span class="lbar"><span class="lfill" style="width:{{ leg.val }}%;background:{{ C.green if leg.val < 50 else C.amber if leg.val < 75 else C.red }}"></span></span>
          <span class="lval">{{ leg.val }}{% if leg.vg[0] %}<span class="lvg vg-{{ leg.vg[1] }}" title="forward-drawdown calibration: {{ leg.vg[1] }}">{{ leg.vg[0] }}</span>{% endif %}</span></div>
        {% endfor %}
        {% if vm.health.calib %}
        <div class="measured-edge">📊 {{ t('Measured', '已校准') }}: {{ t('top-stress readings were followed by a 10%+ S&P drawdown within 63 days', '压力最高档读数之后，63天内出现标普10%+回撤的概率为') }}
          <b>{{ vm.health.calib.hi_dd10 }}%</b> {{ t('of the time vs a', '，而基准为') }} <b>{{ vm.health.calib.base_dd10 }}%</b><span class="l-en"> baseline</span>
          (<b>{% if (vm.health.calib.edge_pp or 0) >= 0 %}+{% endif %}{{ vm.health.calib.edge_pp }}pp</b>){{ t('. Recession-IC', '。衰退IC') }} {{ vm.health.calib.ic_recession }}.
          <span class="faint">{{ t('Glyphs: ✓ measured · ~ directional · · context. The blend explains the risk mix; it is not better than the drawdown leg alone.', '符号：✓ 已校准 · ~ 有方向 · · 仅背景。综合用于解释风险结构，并不优于单独的回撤分项。') }}</span></div>
        {% endif %}
      </div>{% endif %}
    </div>
    <div class="card">
      <h2>{{ t('Bond health — history', '债券健康度 · 历史') }}</h2>
      {{ charts.health | safe }}
      <div class="sub faint" style="margin-top:6px">{{ t('Higher = healthier. Built from recession risk, drawdown risk, credit, rates volatility and funding stress.', '越高越健康。由衰退风险、回撤风险、信用、利率波动与资金压力构成。') }}</div>
    </div>
  </div>

  <!-- ===================== DURATION & CURVE COMPASS ===================== -->
  {% if compass %}
  {% set dur = compass.duration %}
  {% set BUCKET = {'lean_long': (C.green, 'Lean long duration', '偏多久期'), 'neutral': (C.muted, 'Neutral duration', '久期中性'), 'lean_short': (C.red, 'Lean short duration', '偏空久期')} %}
  {% set bk = BUCKET.get(dur.bucket, (C.muted, dur.bucket, dur.bucket)) %}
  {% set markpos = ((dur.lean + 1) / 2 * 100) if dur.lean is not none else 50 %}
  <div id="compass" class="sec-head">{{ t('Duration & Curve Compass — lean long or short?', '久期与曲线罗盘 · 偏多还是偏空？') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Duration lean — the classic bond factors, blended', '久期倾向 · 经典债券因子综合') }}</h2>
      <div style="margin:8px 0 2px">
        <span class="bias-chip" style="background:{{ bk[0] }}">{{ t(bk[1], bk[2]) }}</span>
        <span class="pill">{{ t('lean', '倾向') }} {{ '%+.2f'|format(dur.lean) if dur.lean is not none else '—' }}{% if dur.agreement is not none %} · {{ (dur.agreement*100)|round|int }}% {{ t('agree', '一致') }}{% endif %}</span>
      </div>
      <div class="compass-wrap">
        <div class="compass-track"><div class="compass-mid"></div>
          <div class="compass-marker" style="left:calc({{ markpos|round(1) }}% - 1.5px)"></div></div>
        <div class="compass-ends"><span>← {{ t('short (yields up)', '偏空（利率上行）') }}</span><span>{{ t('long (yields down)', '偏多（利率下行）') }} →</span></div>
      </div>
      <div class="legs" style="margin-top:14px">
        {% for leg in dur.legs %}
        {% set v = leg.value %}{% set w = (v|abs)*50 %}
        {% set lc = C.green if v > 0.15 else (C.red if v < -0.15 else C.muted) %}
        <div class="leg" style="grid-template-columns:148px 1fr 58px">
          <span class="lname" title="{{ leg.note_en }}">{{ t(leg.label_en, leg.label_zh) }}</span>
          <span class="xa-bar"><span class="xa-mid"></span>
            <span class="xa-fill" style="{% if v >= 0 %}left:50%{% else %}left:{{ (50 - w)|round(1) }}%{% endif %};width:{{ w|round(1) }}%;background:{{ lc }}"></span></span>
          <span class="lval" style="color:{{ lc }};text-align:right;font-weight:700">{{ '%+.2f'|format(v) }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="flag info" style="margin-top:14px">ℹ {{ t('Context only. The same factors helped most with drawdown control, not precise return timing.', '仅作背景。同类因子主要帮助控制回撤，而非精确择时收益。') }}</div>
    </div>
    <div class="card">
      <h2>{{ t('Curve trade & expected return', '曲线交易与预期回报') }}</h2>
      {% set ct = compass.curve_trade %}
      {% set CT = {'steepener': (C.amber, 'Steepener bias', '偏陡峭'), 'flattener': (C.teal, 'Flattener bias', '偏平坦'), 'neutral': (C.muted, 'Neutral', '中性')} %}
      {% set ctc = CT.get(ct.lean, (C.muted, ct.lean, ct.lean)) %}
      <div style="margin:8px 0 4px"><span class="bias-chip" style="background:{{ ctc[0] }}">{{ t('Curve', '曲线') }} · {{ t(ctc[1], ctc[2]) }}</span></div>
      <p class="tax-note"><span class="l-en">{{ ct.rationale_en }}</span><span class="l-zh">{{ ct.rationale_zh }}</span></p>
      {% if compass.expected %}
      {% set ex = compass.expected %}
      <div class="kpis" style="margin-top:14px">
        {{ kpi('10y carry', '10年套息', ex.carry_pct, '%') }}
        {{ kpi('Roll-down (1y)', '滚动收益(1年)', ex.rolldown_pct, '%') }}
        {{ kpi('Carry + roll', '套息+滚动', ex.carry_roll_pct, '%') }}
        {{ kpi('Yield-rise cushion', '收益率上行缓冲', ex.cushion_bp, 'bp') }}
      </div>
      <div class="sub faint" style="margin-top:8px">{{ t('Cushion = how much the 10y yield can rise before one year of carry + roll-down is erased (duration ≈ ' ~ ex.duration ~ ').', '缓冲 = 10年期收益率还能上行多少，才会抹掉一年套息+滚动收益（久期约 ' ~ ex.duration ~ '）。') }}</div>
      {% endif %}
      <div class="sub" style="margin-top:12px"><b><span class="l-en">{{ compass.verdict_en }}</span><span class="l-zh">{{ compass.verdict_zh }}</span></b></div>
    </div>
  </div>
  {% endif %}

  <!-- ===================== CURVE & GROWTH ===================== -->
  <div id="curve" class="sec-head">{{ t('① Curve & growth — the recession read', '① 收益率曲线与增长 · 衰退判读') }}</div>
  <div class="card">
    <div class="kpis">
      {{ kpi('10y−3m (NY Fed)', '10年−3月（纽约联储）', vm.curve.spread_10y3m, 'pp') }}
      {{ kpi('Near-term fwd spread', '近端远期利差', vm.curve.ntfs, 'pp') }}
      {{ kpi('2s10s', '2年/10年', vm.curve.spread_2s10s, 'pp') }}
      {{ kpi('TP-adjusted slope', '期限溢价调整斜率', vm.curve.curve_tp_adj, 'pp') }}
      {{ kpi('NY Fed recession prob', '纽约联储衰退概率', vm.curve.nyfed_prob, '%') }}
    </div>
    <div style="margin-top:14px">
      <span class="band-chip" style="background:{{ vm.curve.tax_color }}"><span class="l-en">{{ vm.curve.tax_en }}</span><span class="l-zh">{{ vm.curve.tax_zh }}</span></span>
      <span class="tax-note"><span class="l-en">{{ vm.curve.tax_note_en }}</span><span class="l-zh">{{ vm.curve.tax_note_zh }}</span></span>
    </div>
    {% if vm.curve.bull_steepener_uninversion %}
    <div class="flag alarm">⚑ {{ t('Bull-steepening un-inversion — the curve dis-inverted while short rates fall (cuts being priced). Historically the late-cycle handoff: recessions have begun ~13 months (range ~8–19) after the curve re-steepens.', '牛市陡峭式解除倒挂 — 曲线在短端利率下行（市场定价降息）时解除倒挂。历史上为周期晚段交接：衰退在曲线重新陡峭后约13个月（区间约8–19个月）开始。') }}</div>
    {% elif vm.curve.uninversion %}
    <div class="flag warn">⚑ {{ t('Curve un-inverted after a prior inversion — the dis-inversion, not the inversion, tends to lead recession.', '曲线在此前倒挂后解除 — 引领衰退的往往是解除倒挂而非倒挂本身。') }}</div>
    {% elif vm.curve.tp_adj_inverted %}
    <div class="flag warn">⚑ {{ t('Term-premium-adjusted curve is inverted (a "real" inversion, not a low-term-premium artifact).', '期限溢价调整后的曲线倒挂（“真实”倒挂，非低期限溢价造成的假象）。') }}</div>
    {% endif %}
    <div class="grid cols-2" style="margin-top:16px">
      <div><div class="sub" style="margin-bottom:4px">{{ t('Treasury curve — now vs 3mo / 1y ago', '国债曲线 · 当前 vs 3月前/1年前') }}</div>{{ charts.curve_now | safe }}</div>
      <div><div class="sub" style="margin-bottom:4px">{{ t('Recession spreads & TP-adjusted slope', '衰退利差与期限溢价调整斜率') }}</div>{{ charts.spreads | safe }}</div>
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('10y−3m feeds the NY Fed model. The near-term forward spread is cleaner when markets price Fed cuts. The TP-adjusted slope removes low-term-premium noise.', '10年−3月用于纽约联储模型。近端远期利差更能反映降息定价。期限溢价调整斜率剔除低期限溢价噪音。') }}</div>
  </div>

  <!-- ===================== FED POLICY PATH ===================== -->
  {% if fed_path %}
  <div class="sec-head">{{ t('Market-implied policy path — the Fed vs the market', '市场隐含政策路径 · 美联储 vs 市场') }}</div>
  <div class="card">
    <h2>{{ t('Where the market prices the funds rate — and where the Fed projects it', '市场为基金利率定价之处 · 以及美联储的预测') }}</h2>
    {% if fed_path.headline_en %}<div class="sub" style="margin:2px 0 8px"><b><span class="l-en">{{ fed_path.headline_en }}</span><span class="l-zh">{{ fed_path.headline_zh }}</span></b></div>{% endif %}
    {% if fed_path.gap %}
    <div style="margin:6px 0 10px">
      <span class="band-chip" style="background:var(--muted)">{{ fed_path.gap.horizon_label }} · {{ t('market', '市场') }} {{ '%.2f'|format(fed_path.gap.market) }}% · {{ t('Fed dot', '美联储点阵') }} {{ '%.2f'|format(fed_path.gap.fed_dot) }}%</span>
      <span class="pill"><span class="l-en">{{ '%+d'|format(fed_path.gap.gap_bp) }}bp · {{ fed_path.gap.lean_en }}</span><span class="l-zh">{{ '%+d'|format(fed_path.gap.gap_bp) }}基点 · {{ fed_path.gap.lean_zh }}</span></span>
    </div>
    {% endif %}
    <div class="kpis">
      {{ kpi('Target range', '目标区间', (('%.2f'|format(fed_path.target_low)) ~ '–' ~ ('%.2f'|format(fed_path.target_high))) if fed_path.target_low is not none else none, '%') }}
      {{ kpi('EFFR (policy now)', '有效联邦基金利率', fed_path.policy_rate, '%') }}
      {{ kpi('Implied 12m', '隐含12个月', fed_path.implied.get('m12'), '%') }}
      {{ kpi('Implied 25bp moves (12m)', '隐含25基点变动(12月)', fed_path.implied_cuts_12m, '', t('+ = cuts', '正=降息')) }}
      {{ kpi('Near-term fwd spread', '近端远期利差', fed_path.ntfs, 'pp') }}
      {{ kpi('us2y − funds', 'us2y − 基金利率', fed_path.rate_exp_proxy, 'pp') }}
    </div>
    {% if fed_path.implied_source_en %}<div class="sub faint" style="margin-top:6px">{{ t('Implied path source', '隐含路径来源') }}: <span class="l-en">{{ fed_path.implied_source_en }}</span><span class="l-zh">{{ fed_path.implied_source_zh }}</span></div>{% endif %}
    {% if charts.policy_path %}<div style="margin-top:14px">{{ charts.policy_path | safe }}</div>{% endif %}
    {% if fed_path.read_en %}<div class="sub" style="margin-top:8px"><span class="l-en">{{ fed_path.read_en }}</span><span class="l-zh">{{ fed_path.read_zh }}</span></div>{% endif %}
    <div class="sub faint" style="margin-top:8px">{{ t('Market-implied rates are prices, not forecasts. Use this as policy-path context.', '市场隐含利率是价格，不是预测。此处仅作政策路径背景。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== CREDIT + REAL/INFLATION ===================== -->
  <div id="credit" class="sec-head">{{ t('② Credit & ③ Real rates — risk appetite & the discount rate', '② 信用 与 ③ 实际利率 · 风险偏好与贴现率') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Credit — the "smart money" canary', '信用 · “聪明钱”预警') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.credit.band_color }}">{{ t(vm.credit.band_en, vm.credit.band_zh) }}</span>
        {% if vm.credit.direction %}<span class="pill"><span class="l-en">{{ vm.credit.direction }}</span><span class="l-zh">{{ vm.credit.direction_zh }}</span></span>{% endif %}</div>
      <div class="kpis">
        {{ kpi('HY OAS', '高收益OAS', vm.credit.hy_oas, '%') }}
        {{ kpi('IG OAS', '投资级OAS', vm.credit.ig_oas, '%') }}
        {{ kpi('HY / IG ratio', '高收益/投资级', vm.credit.hy_ig_ratio, '×') }}
        {{ kpi('Baa−Aaa', 'Baa−Aaa', vm.credit.baa_aaa, '%') }}
        {{ kpi('Excess bond premium', '超额债券溢价', vm.credit.ebp, '%') }}
        {{ kpi('HY %ile (2y)', '高收益百分位(2年)', vm.credit.pctile, '%') }}
      </div>
      <div style="margin-top:14px">{{ charts.credit | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('HY OAS shows default stress; EBP is the extra spread not explained by default risk. Credit usually weakens before equities.', '高收益OAS显示违约压力；EBP是违约风险解释不了的额外利差。信用通常早于股票走弱。') }}</div>
    </div>
    <div class="card" id="real">
      <h2>{{ t('Real rates & inflation — the discount rate', '实际利率与通胀 · 贴现率') }}</h2>
      <div class="kpis" style="margin-top:2px">
        {{ kpi('10y real (TIPS)', '10年实际利率', vm.real.real_10y, '%') }}
        {{ kpi('5y real', '5年实际利率', vm.real.real_5y, '%') }}
        {{ kpi('10y breakeven', '10年盈亏平衡通胀', vm.real.breakeven_10y, '%') }}
        {{ kpi('5y5y fwd breakeven', '5年5年远期通胀', vm.real.breakeven_5y5y, '%') }}
        {{ kpi('Term premium', '期限溢价', vm.real.term_premium, '%') }}
      </div>
      {% if vm.real.tp_positive %}<div class="flag info">ℹ {{ t('Term premium repriced positive (the 2023–25 shift) — more of any long-yield move is now supply / fiscal / risk, a bear-steepening force.', '期限溢价重新定价转正（2023–25年的转变）——长端收益率变动中更多源于供给/财政/风险，构成熊市陡峭力量。') }}</div>{% endif %}
      <div style="margin-top:14px">{{ charts.real | safe }}</div>
      {% if charts.tp_decomp %}
      <div class="sub" style="margin:12px 0 4px">{{ t('10y yield decomposed — real + breakeven = nominal, term premium overlaid', '10年收益率分解 · 实际+盈亏平衡=名义，叠加期限溢价') }}</div>
      {{ charts.tp_decomp | safe }}
      {% endif %}
      <div class="sub faint" style="margin-top:6px">{{ t('Real yields are the discount rate; breakevens are the inflation read; term premium is the extra reward for duration risk.', '实际利率是贴现率；盈亏平衡通胀是通胀读数；期限溢价是承担久期风险的额外回报。') }}</div>
    </div>
  </div>

  <!-- ===================== STRESS + CROSS-ASSET ===================== -->
  <div id="stress" class="sec-head">{{ t('④ Stress & plumbing · ⑤ the stock-bond hedge', '④ 压力与资金管道 · ⑤ 股债对冲') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Rates volatility & funding plumbing', '利率波动与资金管道') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.stress.color }}">MOVE {{ vm.stress.move }} · {{ t(vm.stress.band_en, vm.stress.band_zh) }}</span></div>
      <div class="kpis">
        {{ kpi('MOVE %ile (1y)', 'MOVE百分位(1年)', vm.stress.pctile, '%') }}
        {{ kpi('SOFR − IORB', 'SOFR − 准备金利率', vm.stress.sofr_iorb_bp, 'bp') }}
        {{ kpi('Repo spike (SOFR99)', '回购跳升(SOFR99)', vm.stress.repo_spike_bp, 'bp') }}
      </div>
      {% if vm.stress.move_leads_vix %}<div class="flag warn">⚑ {{ t('Rates vol (MOVE) leading equity vol (VIX) — stress often transmits this way.', '利率波动（MOVE）领先股票波动（VIX）——压力常以此路径传导。') }}</div>{% endif %}
      {% if vm.stress.repo_stress %}<div class="flag alarm">⚑ {{ t('Repo-stress spike — funding plumbing under strain.', '回购市场承压——资金管道紧张。') }}</div>
      {% elif vm.stress.reserve_scarcity %}<div class="flag warn">⚑ {{ t('SOFR drifting above IORB — creeping reserve scarcity.', 'SOFR持续高于准备金利率——准备金趋于稀缺。') }}</div>{% endif %}
      <div style="margin-top:14px">{{ charts.move | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('MOVE is rates stress. SOFR−IORB and SOFR spikes flag funding pressure.', 'MOVE衡量利率压力。SOFR−准备金利率与SOFR跳升提示资金压力。') }}</div>
    </div>
    <div class="card">
      <h2>{{ t('Stock-bond correlation — is the hedge working?', '股债相关性 · 对冲是否有效？') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.cross.color }}">{{ t(vm.cross.regime_en, vm.cross.regime_zh) }}</span></div>
      <div class="kpis">
        {{ kpi('63d stock-bond corr', '63日股债相关性', vm.cross.corr) }}
      </div>
      <div style="margin-top:14px">{{ charts.corr | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('Negative correlation means bonds are diversifying equities. Positive correlation means the hedge is weak.', '负相关表示债券能分散股票风险；正相关表示对冲变弱。') }}</div>
    </div>
  </div>

  <!-- ===================== SOVEREIGN / GLOBAL ===================== -->
  <div id="global" class="sec-head">{{ t('⑥ Global sovereign bonds — the world\'s cost of capital', '⑥ 全球主权债券 · 世界的资金成本') }}</div>

  {% if intl %}
  {% set g = intl.global %}{% set uw = intl.us_vs_world %}
  {% set GDIR = {'rising': (C.red, 'rising', '上行'), 'falling': (C.green, 'falling', '下行'), 'stable': (C.muted, 'stable', '平稳')} %}
  {% set gd = GDIR.get(g.direction, (C.muted, g.direction, g.direction)) %}
  <div class="card" style="margin-bottom:18px">
    <h2>{{ t('Global sovereign scorecard — G10 + EM', '全球主权记分卡 · G10 + 新兴市场') }}</h2>
    <div style="margin:6px 0 4px">
      <span class="band-chip" style="background:{{ gd[0] }}">{{ t('Global 10y', '全球10年期') }} {{ g.avg_10y }}% · {{ t(gd[1], gd[2]) }} {{ '%+.0f'|format(g.avg_10y_chg_63d_bp) if g.avg_10y_chg_63d_bp is not none else '' }}bp/3m</span>
      {% if uw.us_premium_bp is not none %}<span class="band-chip" style="background:{{ C.blue }};margin-left:6px">{{ t('US vs world', '美国 vs 世界') }} {{ '%+.0f'|format(uw.us_premium_bp) }}bp</span>{% endif %}
    </div>
    <div class="sub" style="margin:4px 0 10px"><b><span class="l-en">{{ intl.verdict_en }}</span><span class="l-zh">{{ intl.verdict_zh }}</span></b></div>
    <div class="sc-wrap">
    <table class="sc-tbl">
      <tr>
        <th>{{ t('sovereign', '主权') }}</th>
        <th>{{ t('10y', '10年') }}</th>
        <th>{{ t('real', '实际') }}</th>
        <th>{{ t('slope', '斜率') }}</th>
        <th>{{ t('3m Δ', '3月变化') }}</th>
        <th>{{ t('1y z', '1年z') }}</th>
        <th>{{ t('vs US', '对美') }}</th>
        <th>{{ t('curve', '曲线') }}</th>
      </tr>
      {% set SST = {'steep': (C.amber, 'steep', '陡峭'), 'normal': (C.blue, 'normal', '正常'), 'flat': (C.muted, 'flat', '平坦'), 'inverted': (C.red, 'inverted', '倒挂')} %}
      {% set DIR = {'rising': C.red, 'falling': C.green, 'stable': C.muted} %}
      {% for r in intl.countries %}
      {% set ss = SST.get(r.slope_state, (C.muted, r.slope_state or '—', r.slope_state or '—')) %}
      <tr>
        <td class="cty"><span class="dot" style="background:{{ {'US':C.blue,'DE':C.amber,'JP':C.red,'GB':C.teal,'CA':C.indigo,'AU':C.gold,'CH':C.muted}.get(r.code, C.muted) }}"></span>{{ t(r.en, r.zh) }}{% if r.stale %}<span class="stale-tag" data-tip-en="OECD monthly series — lags ~1 month" data-tip-zh="OECD月度序列 · 滞后约1个月">{{ t('lag','滞后') }}</span>{% elif r.cadence == 'monthly' %}<span class="faint" style="font-size:10px;margin-left:4px">{{ t('mo','月') }}</span>{% endif %}</td>
        <td><b>{{ '%.2f'|format(r.y10) }}%</b></td>
        <td>{{ ('%.2f'|format(r.real_10y) ~ '%') if r.real_10y is not none else '—' }}</td>
        <td>{{ ('%+.2f'|format(r.slope)) if r.slope is not none else '—' }}</td>
        <td style="color:{{ DIR.get(r.direction, C.muted) }}">{{ ('%+.0f'|format(r.chg_63d_bp) ~ 'bp') if r.chg_63d_bp is not none else '—' }}</td>
        <td>{{ ('%+.1f'|format(r.z1y)) if r.z1y is not none else '—' }}</td>
        <td style="color:{{ C.green if (r.diff_vs_us_bp or 0) < 0 else C.text }}">{{ ('%+.0f'|format(r.diff_vs_us_bp)) if r.diff_vs_us_bp is not none else '—' }}</td>
        <td><span class="mini-tag" style="background:{{ ss[0] }}">{{ t(ss[1], ss[2]) }}</span></td>
      </tr>
      {% endfor %}
      {% if intl.em and intl.em.em_oas is not none %}
      <tr>
        <td class="cty"><span class="dot" style="background:{{ C.gold }}"></span>{{ t('EM (hard-ccy OAS)', '新兴市场（硬通货利差）') }}</td>
        <td><b>{{ '%.2f'|format(intl.em.em_oas) }}%</b></td>
        <td colspan="2" style="text-align:left;color:var(--muted)">{{ t('pctile', '百分位') }} {{ intl.em.pctile }}%{% if intl.em.emb_trend %} · EMB {{ t(intl.em.emb_trend, {'up':'上行','down':'下行'}.get(intl.em.emb_trend,'')) }}{% endif %}</td>
        <td style="color:{{ DIR.get(intl.em.direction, C.muted) }}">{{ t(intl.em.direction or '', {'rising':'走阔','falling':'收窄','stable':'平稳'}.get(intl.em.direction,'')) }}</td>
        <td colspan="3"></td>
      </tr>
      {% endif %}
    </table>
    </div>
    {% if charts.intl_yields %}<div style="margin-top:14px">{{ charts.intl_yields | safe }}</div>{% endif %}
    <div class="sub faint" style="margin-top:8px">{{ t('Level = 10y yield. Slope = curve shape. 3m Δ = 63-day move. vs US = 10y rate gap. Monthly OECD series are tagged.', '水平=10年收益率；斜率=曲线形态；3月变化=63日变动；对美=10年利差。OECD月度序列已标注。') }}</div>
  </div>
  {% endif %}

  <div class="card">
    <h2>{{ t('Euro-area fragmentation & the JGB curve', '欧元区分化与日债曲线') }}</h2>
    <div style="margin:6px 0 4px">
      <span class="band-chip" style="background:{{ vm.sovereign.frag_color }}">{{ t('Euro fragmentation', '欧元分化') }} · {{ t(vm.sovereign.frag_en, vm.sovereign.frag_zh) }}</span>
      {% if vm.sovereign.frag_direction %}<span class="pill"><span class="l-en">{{ vm.sovereign.frag_direction }}</span><span class="l-zh">{{ vm.sovereign.frag_direction_zh }}</span></span>{% endif %}
      {% if vm.sovereign.jgb_2s10s is not none %}<span class="band-chip" style="background:{{ vm.sovereign.jgb_color }};margin-left:6px">JGB 2s10s · {{ t(vm.sovereign.jgb_en, vm.sovereign.jgb_zh) }}</span>{% endif %}
    </div>
    <div class="kpis">
      {{ kpi('Euro frag (all−AAA 10y)', '欧元分化（全体−AAA 10年）', vm.sovereign.euro_frag, 'pp') }}
      {{ kpi('Bund 10y (euro core)', '德债10年（欧元核心）', vm.sovereign.bund_10y, '%') }}
      {{ kpi('JGB 2s10s', '日债 2年/10年', vm.sovereign.jgb_2s10s, 'pp') }}
    </div>
    <div style="margin-top:14px">{{ charts.sovereign | safe }}</div>
    <div class="sub faint" style="margin-top:6px">{{ t('Euro fragmentation tracks periphery-vs-core stress. JGB 2s10s tracks Japan normalization and possible capital repatriation.', '欧元分化跟踪外围与核心压力；日债2/10年跟踪日本正常化及资本回流风险。') }}</div>
  </div>

  {% if credit_cycle %}
  <div class="card">
    <h2>{{ t('Global credit cycle — the crisis early-warning (BIS)', '全球信用周期 · 危机预警 (BIS)') }}</h2>
    <div class="sub faint" style="margin:4px 0 8px">{{ t('Private-sector leverage vs trend.', '私人部门杠杆相对趋势。') }} <b>{{ t('Latest read', '最新读数') }}</b> · {{ t('as of', '截至') }} {{ credit_cycle.asof }}</div>
    <div class="table-wrap">
    <table class="credit-cycle-tbl">
      <tr style="color:var(--muted);font-size:11px;text-transform:uppercase">
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('economy', '经济体') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('credit-to-GDP gap', '信贷/GDP 缺口') }}</th>
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('state', '状态') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--line)">{{ t('debt-service ratio', '偿债比率') }}</th>
      </tr>
      {% for r in credit_cycle.rows %}
      {% set gc = 'var(--down)' if (r.gap or 0) >= 10 else '#d9a03c' if (r.gap or 0) >= 2 else 'var(--up)' if (r.gap or 0) <= -2 else 'var(--muted)' %}
      <tr>
        <td style="padding:5px 8px;border-bottom:1px solid var(--line)"><b>{{ t(r.label_en, r.label_zh) }}</b></td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--line);color:{{ gc }};font-weight:700">{{ '%+.1f'|format(r.gap) }}pp{% if r.gap_chg_1y is not none %} <span class="sub faint" style="font-weight:400">{{ '%+.1f'|format(r.gap_chg_1y) }}/yr</span>{% endif %}</td>
        <td style="padding:5px 8px;border-bottom:1px solid var(--line);color:{{ gc }}">{{ t(r.gap_state, {'elevated risk':'风险偏高','building':'累积中','deleveraging':'去杠杆','neutral':'中性'}.get(r.gap_state, r.gap_state)) }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--line)">{{ r.dsr }}%{% if r.dsr_chg_1y is not none %} <span class="sub faint">{{ '%+.1f'|format(r.dsr_chg_1y) }}/yr</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('BIS credit-to-GDP gap: private credit versus trend. Big positive gaps warn of banking-cycle risk; negative gaps show deleveraging. Slow structural context only.', 'BIS信贷/GDP缺口：私人信贷相对趋势。大幅正缺口提示银行周期风险；负缺口表示去杠杆。仅为慢变量背景。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== BONDS → EVERYTHING (measured transmission) ===================== -->
  {% if xasset_vm %}
  {% set xa = xasset_vm %}{% set dn = xa.drivers_now %}
  <div id="transmission" class="sec-head">{{ t('⑦ Bonds → everything — the measured transmission map', '⑦ 债券 → 各市场 · 实测传导图') }}</div>
  <div class="card">
    <h2>{{ t('What bonds are doing to each market — right now', '当前债券对各市场的影响') }}</h2>
    <div class="sub" style="margin:2px 0 10px"><b><span class="l-en">{{ xa.verdict_en }}</span><span class="l-zh">{{ xa.verdict_zh }}</span></b></div>
    <div class="kpis" style="margin-bottom:6px">
      {{ kpi('Real 10y', '10年实际利率', dn.real_10y, '%', (('%+.0f'|format(dn.real_chg_bp)) ~ 'bp/3m') if dn.real_chg_bp is not none else '') }}
      {{ kpi('Curve 10y−3m', '曲线10年−3月', dn.slope, 'pp', (('%+.0f'|format(dn.slope_chg_bp)) ~ 'bp/3m') if dn.slope_chg_bp is not none else '') }}
      {{ kpi('HY OAS', '高收益利差', dn.hy_oas, '%', (('%+.0f'|format(dn.hy_chg_bp)) ~ 'bp/3m') if dn.hy_chg_bp is not none else '') }}
      {{ kpi('10y breakeven', '10年盈亏平衡', dn.breakeven, '%') }}
      {{ kpi('MOVE', 'MOVE', dn.move, '') }}
    </div>
    {% if charts.xasset_betas %}<div style="margin:8px 0 6px">{{ charts.xasset_betas | safe }}</div>{% endif %}
    <div style="margin-top:8px">
      {% for a in xa.assets %}
      {% set sc = C.blue if a.sign == 'pos' else C.amber %}
      {% set w = ((a.corr|abs) / 0.7 * 50) %}{% set w = 50 if w > 50 else w %}
      <div class="xa-row">
        <div class="xa-asset">{{ a.icon }} {{ t(a.en, a.zh) }}<span class="xa-sub">{{ t('via', '经') }} {{ t(a.driver_en, a.driver_zh) }} · {{ a.beta_disp }} · r&nbsp;{{ '%+.2f'|format(a.corr) }} ({{ t(a.conf_label, {'strong':'强','moderate':'中','weak':'弱'}.get(a.conf_label,'')) }})</span></div>
        <div>
          <div class="xa-bar"><span class="xa-mid"></span>
            <span class="xa-fill" style="{% if a.corr >= 0 %}left:50%{% else %}left:{{ (50 - w)|round(1) }}%{% endif %};width:{{ w|round(1) }}%;background:{{ sc }}"></span></div>
          <div class="xa-note"><span class="l-en">{{ a.story_en }}</span><span class="l-zh">{{ a.story_zh }}</span></div>
        </div>
        <div class="xa-verd" style="color:{{ a.vcolor }}">{{ t(a.verdict_en, a.verdict_zh) }}<span class="xa-sub" style="color:var(--muted);font-weight:500;font-size:11px">{{ a.impulse_en }}</span></div>
      </div>
      {% endfor %}
    </div>
    <div class="sub faint" style="margin-top:10px">{{ t('Betas show weekly co-movement with each asset\'s main bond driver. They describe today\'s headwind or tailwind; they are not forecasts. More chains: ', '贝塔显示各资产与主要债券驱动的周度联动。它们描述当前顺风/逆风，不是预测。更多传导链见') }} <a href="transmission.html">{{ t('Rate & Inflation Transmission', '利率与通胀传导') }}</a>.</div>
  </div>
  {% endif %}

  <!-- ===================== TREASURY SUPPLY ABSORPTION (display-only) ===================== -->
  {% if treasury_supply %}
  {% set ts = treasury_supply %}
  {% set TAG = {'strong': (C.green, '强劲'), 'soft': (C.red, '偏弱'), 'in-line': (C.muted, '中性'), 'n/a': (C.faint, '—')} %}
  <div class="card" id="supply">
    <h2>{{ t('Treasury supply absorption — is the market digesting the debt?', '美债供给吸收 · 市场能否顺利消化债务？') }}</h2>
    <div style="margin:6px 0 6px">
      {% set sc = C.green if ts.n_strong > ts.n_soft else (C.red if ts.n_soft >= 2 else C.muted) %}
      <span class="band-chip" style="background:{{ sc }}">{{ t('Recent coupon demand', '近期票息需求') }} · {{ ts.n_soft }}/{{ ts.n_scored }} {{ t('soft', '偏弱') }}</span>
      {% if ts.supply %}
      {% set pc = C.amber if ts.supply.pressure == 'coupon supply rising' else (C.teal if ts.supply.pressure == 'coupon supply easing' else C.muted) %}
      <span class="band-chip" style="background:{{ pc }};margin-left:6px">{{ t('Duration supply', '久期供给') }} · {{ t({'coupon supply rising': 'rising', 'coupon supply easing': 'easing', 'stable': 'stable', 'neutral': 'n/a'}.get(ts.supply.pressure, ts.supply.pressure), {'coupon supply rising': '上升', 'coupon supply easing': '回落', 'stable': '平稳', 'neutral': '—'}.get(ts.supply.pressure, '')) }}</span>
      {% endif %}
    </div>
    <div class="sub faint" style="margin:2px 0 10px"><b>{{ t(ts.headline, '') }}</b> · {{ t('as of', '截至') }} {{ ts.asof }}</div>
    {% if ts.supply %}
    <div class="kpis" style="margin-bottom:4px">
      {{ kpi('Coupon issuance (90d)', '票息发行(90日)', ts.supply.coupon_bn, ' $bn') }}
      {{ kpi('vs prior 90d', '较前90日', ('%+.1f'|format(ts.supply.coupon_chg_pct)) if ts.supply.coupon_chg_pct is not none else none, '%') }}
    </div>
    {% endif %}
    <div class="table-wrap">
    <table class="supply-tbl" style="margin-top:6px">
      <tr style="color:var(--muted);font-size:11px;text-transform:uppercase">
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('auction', '拍卖') }}</th>
        <th style="text-align:left;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('tenor', '期限') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('bid-to-cover', '认购倍数') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('indirect', '间接') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('dealer', '交易商') }}</th>
        <th style="text-align:right;padding:4px 8px;border-bottom:1px solid var(--grid)">{{ t('demand', '需求') }}</th>
      </tr>
      {% for r in ts.rows %}
      {% set tg = TAG.get(r.tag, (C.muted, r.tag)) %}
      <tr>
        <td style="padding:5px 8px;border-bottom:1px solid var(--grid);color:var(--muted)">{{ r.date }}{% if r.reopening %} <span class="faint" style="font-size:10px">re</span>{% endif %}</td>
        <td style="padding:5px 8px;border-bottom:1px solid var(--grid)"><b>{{ r.tenor }}</b> <span class="faint" style="font-size:11px">{{ r.type }}</span></td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)">{{ '%.2f'|format(r.bid_to_cover) if r.bid_to_cover is not none else '—' }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)">{{ ('%.0f'|format(r.indirect_pct) ~ '%') if r.indirect_pct is not none else '—' }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid)">{{ ('%.0f'|format(r.dealer_pct) ~ '%') if r.dealer_pct is not none else '—' }}</td>
        <td style="text-align:right;padding:5px 8px;border-bottom:1px solid var(--grid);color:{{ tg[0] }};font-weight:700">{{ t(r.tag, tg[1]) }}{% if r.absorption_z is not none %} <span class="faint" style="font-weight:400;font-size:11px">{{ '%+.1f'|format(r.absorption_z) }}σ</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('Auction demand is scored versus recent same-tenor auctions. Higher bid-to-cover and indirect share are stronger; higher dealer share is weaker.', '拍卖需求相对近期同期限拍卖评分。认购倍数与间接占比越高越强；交易商占比越高越弱。') }}</div>
    <div class="sub faint" style="margin-top:6px">{{ t('Supply context only; not scored.', '仅为供给背景，不参与评分。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== CROSS-ASSET DRIVERS (AI hand-off) ===================== -->
  <div class="sec-head">{{ t('Cross-asset hand-off — what bonds imply for the other boards', '跨资产传导 · 债券对其他面板的含义') }}</div>
  <div class="card">
    <div class="drv">
      <div class="dasset">💱 {{ t('Forex', '外汇') }}</div>
      <div class="dnote">{{ t('FX follows rate gaps. Wider US-favorable gaps are a dollar tailwind.', '外汇跟随利差。对美国更有利的利差走阔利好美元。') }}
        <b>{{ t('real 10y', '10年实际利率') }} {{ vm.real.real_10y }}% · {{ t('term premium', '期限溢价') }} {{ vm.real.term_premium }}%</b></div>
    </div>
    <div class="drv">
      <div class="dasset">◆ {{ t('Commodities', '大宗商品') }}</div>
      <div class="dnote">{{ t('Real yields pressure gold. Breakevens track energy inflation. Curve slope tracks growth-sensitive commodities.', '实际利率压制黄金；盈亏平衡跟踪能源通胀；曲线斜率跟踪增长敏感商品。') }}
        <b>{{ t('real 10y', '10年实际利率') }} {{ vm.real.real_10y }}% · {{ t('10y breakeven', '10年盈亏平衡通胀') }} {{ vm.real.breakeven_10y }}%</b></div>
    </div>
    <div class="drv">
      <div class="dasset">₿ {{ t('Bitcoin', '比特币') }}</div>
      <div class="dnote">{{ t('BTC likes lower real yields and easier funding; wider credit or higher MOVE is risk-off.', 'BTC受益于实际利率下降与资金宽松；信用走阔或MOVE上升偏避险。') }}
        <b>{{ t('risk-off gate', '避险闸门') }}: {{ t('ON', '开启') if vm.drivers.bitcoin and vm.drivers.bitcoin.risk_off_gate else t('off', '关闭') }}</b></div>
    </div>
    <div class="drv">
      <div class="dasset">📈 {{ t('Equities', '股票') }}</div>
      <div class="dnote">{{ t('Real yields and term premium pressure valuations. Credit leads drawdowns. MOVE captures yield-speed risk.', '实际利率与期限溢价压制估值；信用领先回撤；MOVE衡量收益率速度风险。') }}
        <b>{{ t('HY OAS', '高收益OAS') }} {{ vm.credit.hy_oas }}% · {{ t('stock-bond corr', '股债相关性') }} {{ vm.cross.corr }}</b></div>
    </div>
    <div class="sub faint" style="margin-top:10px">{{ t('These reads are exported to data/bonds/bond_health.json for the cross-asset engine.', '这些读数会导出至 data/bonds/bond_health.json，供跨资产引擎使用。') }}</div>
  </div>

  <!-- ===================== ALERT TIMELINE ===================== -->
  {% if timeline %}
  <div class="card" id="timeline" style="margin-top:20px">
    <h2>{{ t('Bond state-change timeline', '债券状态变化时间线') }} <span class="faint">· {{ n_alerts }} {{ t('events · last', '事件 · 近') }} {{ timeline_days }}d</span></h2>
    <div class="timeline">
    {% for day in timeline %}
      <div class="tl-day"><span class="l-en">{{ day.daylabel }}</span><span class="l-zh">{{ day.daylabel_zh }}</span></div>
      {% for e in day.events %}
      <div class="tl-ev sev-{{ e.severity }}">
        <span class="tl-type"><span class="l-en">{{ e.label }}</span><span class="l-zh">{{ e.label_zh }}</span></span>
        <span class="tl-head"><span class="l-en">{{ e.headline }}</span><span class="l-zh">{{ e.headline_zh }}</span></span>
      </div>
      {% endfor %}
    {% endfor %}
    </div>
    <div class="sub faint" style="margin-top:10px">{{ t('Daily state changes, debounced to reduce whipsaw. Context only.', '每日状态变化，经去抖以减少噪音。仅作背景。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== METHODOLOGY / HONESTY ===================== -->
  <div class="card" style="margin-top:22px">
    <h2>{{ t('How to read this', '如何解读') }}</h2>
    <div class="note">
      <p>{{ t('Start with the health score, then check which leg is driving it: curve, credit, real rates, rates volatility, funding stress or stock-bond correlation.', '先看健康度评分，再看驱动分项：曲线、信用、实际利率、利率波动、资金压力或股债相关性。') }}</p>
      <p>{{ t('The compass and transmission sections are context. They summarize duration lean and cross-asset pressure, but they are not standalone trade calls.', '罗盘与传导部分是背景信息。它们概括久期倾向与跨资产压力，但不是独立交易信号。') }}</p>
      <p>{{ t('Thresholds use practitioner levels; calibration only labels how useful each leg has been. Data comes mainly from FRED, Yahoo, ECB, Japan MoF, BIS, OECD and Treasury auction results.', '阈值采用常用市场水平；校准只标注各分项过去有多有用。数据主要来自FRED、Yahoo、欧洲央行、日本财务省、BIS、OECD与美债拍卖结果。') }}</p>
      <p class="meta-foot">{{ t('History', '历史') }} {{ span }} · {{ t('built', '构建于') }} {{ built }}</p>
    </div>
  </div>
</div>

<script>
window.__CHART_SWAP__ = { colors:{}, labels:{
  "Bond health":"债券健康度","Today":"当前","~3mo ago":"约3月前","~1y ago":"约1年前",
  "10y−3m (NY Fed)":"10年−3月（纽约联储）","2s10s":"2年/10年","TP-adjusted 2s10s":"期限溢价调整",
  "HY OAS":"高收益OAS","IG OAS":"投资级OAS","10y real (TIPS)":"10年实际利率","10y breakeven":"10年盈亏平衡通胀",
  "term premium":"期限溢价","MOVE":"MOVE","63d stock-bond corr":"63日股债相关性",
  "Real 10y (TIPS)":"10年实际利率","Breakeven inflation":"盈亏平衡通胀","Nominal 10y":"名义10年",
  "Term premium":"期限溢价","US":"美国","Bund":"德债","JGB":"日债","UK":"英国","Canada":"加拿大",
  "Australia":"澳大利亚","Switzerland":"瑞士"} };
</script>
<script src="theme.js"></script>
<script src="chart_i18n.js"></script>
<footer class="site-footer">
  <span>© 2026 Mastermind Inc</span>
</footer>
</body>
</html>
