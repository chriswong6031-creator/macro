{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{% macro kpi(label, zh, val, unit='', sub='') -%}
<div class="kpi">{{ t(label, zh) }}<b>{% if val is none %}<span class="faint">—</span>{% else %}{{ val }}{{ unit }}{% endif %}</b>{% if sub %}<span class="ksub">{{ sub }}</span>{% endif %}</div>
{%- endmacro %}
{% macro gauge(score, color) -%}
{%- set sc = ([0,[100,(score if score is not none else 0)]|min]|max)|float -%}
{%- set arc = 175.93 -%}
{%- set filled = (sc/100*arc)|round(2) -%}
{%- set gap = (arc-filled)|round(2) -%}
{%- set deg = (sc/100*180-90)|round(1) -%}
<figure class="bhg" style="--sc:{{ color }};--arc:{{ arc }};--arc-gap:{{ gap }}" role="img" aria-label="Bond health score {{ sc|int }} of 100">
<svg viewBox="0 -6 140 104" fill="none" aria-hidden="true">
<path class="bhg-track" d="M14 75 A56 56 0 0 1 126 75"/>
<path class="bhg-fill" d="M14 75 A56 56 0 0 1 126 75"/>
<g class="bhg-needle" transform="rotate({{ deg }} 70 75)">
<line class="bhg-ptr" x1="70" y1="75" x2="70" y2="26"/>
<circle class="bhg-hub" cx="70" cy="75" r="6.5"/>
<circle class="bhg-hub2" cx="70" cy="75" r="3"/>
</g>
</svg>
<span class="bhg-ends"><span>0</span><span>100</span></span>
</figure>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>document.documentElement.classList.add('js');try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Bonds & Bond Health — {{ as_of }}</title>
{% set seo_title = 'Bonds and Bond Health — Yields, Curve and Credit | Mastermind' %}{% set seo_desc = 'A bonds hub tracking Treasury yields, the yield curve, credit spreads and bond-market health with regime-aware reads.' %}{% set seo_path = 'bonds.html' %}
{% include "_seo_head.html.j2" %}
<link rel="stylesheet" href="illus.css">
<style>
/* ═══════════════════════════════════════════════════════════════════════════
   BONDS & BOND HEALTH — design system (Signal-Ink era)
   Ported from the macro dashboard's glass / aurora / gauge language, given a
   distinct bond identity: an indigo→blue→teal "cost-of-capital" accent, with the
   live yield curve as the hero signature. Health/credit semantics stay
   green·amber·red. Scoped to .wrap so the shared nav (_vector_polish) is untouched.
   ═══════════════════════════════════════════════════════════════════════════ */
:root{
  /* palette (shared Glassnode light base) */
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --ink:{{C.ink}}; --text:{{C.text}}; --muted:{{C.muted}};
  --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}}; --green:{{C.green}}; --teal:{{C.teal}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}}; --gold:{{C.gold}};
  /* illus + component vars the vector shell never defined (fixes the credit-cycle
     table's undefined var(--up/--down/--line) too) */
  --info:#3f74e6; --warn:{{C.amber}}; --orange:#e0883c;
  --up:{{C.green}}; --down:{{C.red}}; --line:{{C.grid}}; --panel:{{C.card}}; --panel2:#eef1f6;
  /* bond accent ramp — the page signature */
  --accent:#4d6be0; --accent2:#1f8a70;
  --accent-grad:linear-gradient(115deg,var(--indigo) 0%,var(--blue) 48%,var(--teal) 100%);
  /* elevation + glass */
  --card-brd:#e7ebf2;
  --card-shadow:0 1px 2px rgba(20,30,50,.05), 0 10px 26px -14px rgba(20,32,64,.16);
  --card-shadow-lg:0 2px 8px rgba(20,30,50,.07), 0 26px 54px -22px rgba(20,32,64,.26);
  --glass-bg:rgba(255,255,255,.72);
  --glass-blur:saturate(160%) blur(14px);
  --ring:color-mix(in srgb, var(--blue) 40%, transparent);
  /* type + rhythm */
  --fs-hero:56px; --r-lg:18px; --r-md:13px; --r-sm:9px;
}
html[data-theme="dark"]{
  --bg:#0a0d12; --card:#141821; --grid:#242a36; --ink:#eaeff6; --text:#d3d9e2; --muted:#8b93a1;
  --faint:#6b7280; --red:#e06464; --green:#45b873; --teal:#3bb597;
  --info:#5b9bf0; --orange:#e0955a; --panel:#141821; --panel2:#1b2029; --line:#242a36;
  --accent:#6f8bf0; --card-brd:#232a37;
  --card-shadow:0 1px 0 rgba(255,255,255,.03), 0 14px 34px -18px rgba(0,0,0,.66);
  --card-shadow-lg:0 1px 0 rgba(255,255,255,.05), 0 30px 64px -24px rgba(0,0,0,.78);
  --glass-bg:color-mix(in srgb, var(--card) 78%, transparent);
  --up:var(--green); --down:var(--red);
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:var(--blue);text-decoration:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 22px 72px;position:relative;z-index:1}
/* ambient aurora backdrop — quiet, tuned to the bond accent (indigo/teal), never loud */
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(760px 460px at 8% -6%, color-mix(in srgb,var(--indigo) 15%,transparent), transparent 66%),
    radial-gradient(680px 460px at 96% 0%, color-mix(in srgb,var(--teal) 12%,transparent), transparent 70%),
    radial-gradient(820px 520px at 50% 118%, color-mix(in srgb,var(--blue) 9%,transparent), transparent 72%);}
html[data-theme="dark"] body::before{
  background:
    radial-gradient(760px 460px at 8% -6%, color-mix(in srgb,var(--indigo) 26%,transparent), transparent 64%),
    radial-gradient(680px 460px at 96% 0%, color-mix(in srgb,var(--teal) 20%,transparent), transparent 68%),
    radial-gradient(820px 520px at 50% 120%, color-mix(in srgb,var(--blue) 16%,transparent), transparent 72%);}

/* grids ------------------------------------------------------------------- */
.grid{display:grid;gap:18px;align-items:start}
.cols-2{grid-template-columns:1.05fr .95fr}.cols-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.cols-2,.cols-3{grid-template-columns:1fr}}

/* section headers — quiet kicker + colored rail + hairline fading to the edge --- */
.sec-head{display:flex;align-items:center;gap:12px;margin:44px 0 16px;padding:0;
  font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.11em}
.sec-head::before{content:"";flex:none;width:3px;height:16px;border-radius:2px;
  background:var(--accent-grad)}
.sec-head::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--grid),transparent)}

/* cards — glass, floating, gentle hover lift ------------------------------ */
.card{background:var(--card);border:1px solid var(--card-brd);border-radius:var(--r-lg);
  padding:22px;min-width:0;overflow-wrap:break-word;box-shadow:var(--card-shadow);
  transition:box-shadow .24s ease,transform .24s ease,border-color .24s ease}
.card:hover{box-shadow:var(--card-shadow-lg)}
.card h2{margin:0 0 10px;font-size:11.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.card h2 .h2q{color:var(--faint);font-weight:600;text-transform:none;letter-spacing:0}

/* page header ------------------------------------------------------------- */
.brand{font-weight:800;font-size:30px;color:var(--ink);letter-spacing:-.025em;margin:14px 0 6px;line-height:1.1}
.brand .gn{background:var(--accent-grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.lead{color:var(--muted);font-size:14.5px;line-height:1.55;max-width:820px;margin:0 0 16px}
.sub{font-size:13px;color:var(--muted);min-width:0}.faint{color:var(--faint)}

/* jump-nav → floating pill row -------------------------------------------- */
.jump-nav{display:flex;flex-wrap:wrap;gap:7px;margin:6px 0 26px}
.jump-nav a{font-size:12px;font-weight:600;color:var(--muted);background:var(--card);
  border:1px solid transparent;border-radius:999px;padding:6px 13px;white-space:nowrap;
  box-shadow:var(--card-shadow);transition:color .15s,box-shadow .2s,transform .15s}
.jump-nav a:hover{color:var(--ink);box-shadow:var(--card-shadow-lg);transform:translateY(-1px)}

/* ═══════ HERO — Bond Health command scorecard ═══════════════════════════ */
.bh-hero{border-radius:22px;padding:0;overflow:hidden;border:1px solid var(--card-brd);
  background:var(--glass-bg);-webkit-backdrop-filter:var(--glass-blur);backdrop-filter:var(--glass-blur);
  box-shadow:var(--card-shadow-lg);display:grid;grid-template-columns:1.02fr .98fr;margin:2px 0 8px}
.bh-hero>div{padding:26px 28px;min-width:0}
.bh-hero-left{position:relative;border-right:1px solid var(--card-brd)}
.bh-eyebrow{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.14em;margin-bottom:6px}
.bh-scorewrap{display:flex;align-items:center;gap:20px;margin:6px 0 2px}
.bh-score{font-size:64px;font-weight:900;line-height:.92;letter-spacing:-.04em;color:var(--sc,var(--ink));
  text-shadow:0 0 46px color-mix(in srgb,var(--sc,var(--ink)) 30%,transparent);font-variant-numeric:tabular-nums}
.bh-score small{display:block;font-size:15px;font-weight:700;color:var(--muted);letter-spacing:0;margin-top:6px}
.bh-band-word{font-size:20px;font-weight:800;color:var(--sc,var(--ink));letter-spacing:-.01em}
.bh-phase{margin:12px 0 2px;display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.bh-verdict{font-size:14.5px;color:var(--text);line-height:1.55;margin:12px 0 0;max-width:52ch}
.bh-hero-right{display:flex;flex-direction:column}
.bh-curve-read{font-size:14px;color:var(--text);line-height:1.5;margin:4px 0 0}
.bh-curve-read b{color:var(--ink)}

/* the semicircle gauge (SSR SVG; needle + arc baked by Jinja, drawn by CSS) */
.bhg{position:relative;width:180px;height:112px;flex:none}
.bhg svg{width:100%;height:100%;overflow:visible;display:block}
.bhg-track{fill:none;stroke:color-mix(in srgb,var(--muted) 20%,transparent);stroke-width:11;stroke-linecap:round}
.bhg-fill{fill:none;stroke:var(--sc,var(--blue));stroke-width:11;stroke-linecap:round;
  stroke-dasharray:var(--arc,176);stroke-dashoffset:var(--arc-gap,0);
  filter:drop-shadow(0 0 6px color-mix(in srgb,var(--sc,var(--blue)) 55%,transparent))}
.bhg-ptr{stroke:var(--ink);stroke-width:3;stroke-linecap:round}
.bhg-hub{fill:var(--ink)}
.bhg-hub2{fill:var(--sc,var(--blue))}
.bhg-ends{position:absolute;left:6px;right:6px;bottom:20px;display:flex;justify-content:space-between;
  font-size:10px;font-weight:600;color:var(--faint)}
@media(prefers-reduced-motion:no-preference){
  .bhg-fill{stroke-dashoffset:var(--arc,176);animation:bhgSweep 1.15s cubic-bezier(.33,.62,.26,1) .2s forwards}
  .bhg-needle{opacity:0;transform:scale(.55);transform-origin:70px 75px;transform-box:view-box;
    animation:bhgPop .55s cubic-bezier(.34,1.28,.5,1) .55s forwards}
}
@keyframes bhgSweep{to{stroke-dashoffset:var(--arc-gap,0)}}
@keyframes bhgPop{to{opacity:1;transform:scale(1)}}

/* alarm flags + chips ----------------------------------------------------- */
.pill{display:inline-block;max-width:100%;padding:4px 11px;border-radius:999px;font-size:12px;font-weight:600;
  background:var(--panel2);color:var(--ink);border:1px solid transparent;margin:2px 4px 2px 0;
  white-space:normal;overflow-wrap:anywhere}
html[data-theme="dark"] .pill{background:#222836}
.band-chip{display:inline-block;max-width:100%;padding:4px 13px;border-radius:999px;font-size:13px;font-weight:700;
  color:#fff;letter-spacing:.01em;white-space:normal;overflow-wrap:anywhere;box-shadow:0 1px 3px rgba(20,30,50,.18)}
.bias-chip{display:inline-block;padding:4px 13px;border-radius:999px;font-size:13px;font-weight:700;color:#fff;
  box-shadow:0 1px 3px rgba(20,30,50,.18)}
.flag{display:inline-block;max-width:100%;padding:9px 13px;border-radius:11px;font-size:12.5px;font-weight:600;
  margin-top:12px;line-height:1.45;white-space:normal;overflow-wrap:anywhere}
.flag.warn{background:color-mix(in srgb,var(--amber) 16%,transparent);color:#9a6a10}
.flag.alarm{background:color-mix(in srgb,var(--red) 14%,transparent);color:var(--red)}
.flag.info{background:color-mix(in srgb,var(--blue) 11%,transparent);color:var(--blue)}
.flag.ok{background:color-mix(in srgb,var(--green) 13%,transparent);color:var(--green)}
html[data-theme="dark"] .flag.warn{color:#e0a840}

/* ═══════ GLANCE — the bottom line, every pillar at a glance ══════════════ */
.glance{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:2px 0 6px}
@media(max-width:900px){.glance{grid-template-columns:repeat(3,1fr)}}
@media(max-width:560px){.glance{grid-template-columns:repeat(2,1fr)}}
.gl-tile{display:grid;grid-template-columns:3px 1fr;background:var(--card);border:1px solid var(--card-brd);
  border-radius:var(--r-md);overflow:hidden;box-shadow:var(--card-shadow);text-decoration:none;
  transition:box-shadow .2s,transform .15s}
.gl-tile:hover{box-shadow:var(--card-shadow-lg);transform:translateY(-2px)}
.gl-tile::before{content:"";background:var(--sc,var(--muted))}
.gl-body{padding:12px 13px;min-width:0}
.gl-name{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.gl-state{font-size:16px;font-weight:800;color:var(--sc,var(--ink));line-height:1.1;letter-spacing:-.01em}
.gl-mean{font-size:11.5px;color:var(--muted);line-height:1.4;margin-top:4px}
.gl-good{--sc:var(--green)} .gl-mid{--sc:var(--blue)} .gl-warn{--sc:var(--amber)} .gl-bad{--sc:var(--red)}

/* ═══════ KEY LEVELS strip ════════════════════════════════════════════════ */
.klv{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin:2px 0}
@media(max-width:900px){.klv{grid-template-columns:repeat(4,1fr)}}
@media(max-width:560px){.klv{grid-template-columns:repeat(2,1fr)}}
.klv-tile{background:var(--panel2);border-radius:var(--r-md);padding:11px 13px;min-width:0}
html[data-theme="dark"] .klv-tile{background:var(--panel2)}
.klv-lab{font-size:10.5px;font-weight:600;color:var(--muted);letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.klv-val{font-size:20px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums;margin-top:3px;letter-spacing:-.02em}
.klv-val .u{font-size:12px;color:var(--muted);font-weight:700}
.klv-sub{font-size:10.5px;color:var(--faint);margin-top:2px;font-variant-numeric:tabular-nums}

/* KPI group -------------------------------------------------------------- */
.kpis{display:flex;gap:11px 12px;flex-wrap:wrap;margin-top:14px}
.kpi{font-size:12.5px;color:var(--muted);min-width:96px;background:var(--panel2);border-radius:12px;padding:11px 14px}
html[data-theme="dark"] .kpi{background:var(--panel2)}
.kpi b{display:block;font-size:19px;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums;margin-top:3px}
.kpi .ksub{font-size:11px;color:var(--faint)}

/* stress-leg + factor mini bars ------------------------------------------ */
.legs{margin-top:14px;display:flex;flex-direction:column;gap:8px}
.leg{display:grid;grid-template-columns:118px 1fr 34px;align-items:center;gap:10px;font-size:12px}
.leg .lname{color:var(--text);min-width:0}
.leg .lbar{position:relative;height:8px;background:var(--panel2);border-radius:5px;overflow:hidden}
.leg .lfill{position:absolute;left:0;top:0;bottom:0;border-radius:5px;transform-origin:left;
  transition:width .5s cubic-bezier(.33,.62,.26,1)}
.leg .lval{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.lvg{margin-left:5px;font-weight:800;font-size:11px;cursor:help}
.vg-measured{color:var(--green)}.vg-directional{color:var(--amber)}.vg-context{color:var(--faint)}.vg-inverted{color:var(--indigo)}
.measured-edge{margin-top:12px;padding:11px 13px;border-radius:12px;background:color-mix(in srgb,var(--green) 9%,transparent);font-size:13px;line-height:1.5;color:var(--text)}
.measured-edge b{color:var(--green)}
.tax-note{font-size:13px;color:var(--muted);margin:8px 0 0;line-height:1.5}

/* compass gauge ----------------------------------------------------------- */
.compass-wrap{margin:12px 0 4px}
.compass-track{position:relative;height:30px;border-radius:9px;background:linear-gradient(90deg,color-mix(in srgb,var(--red) 18%,transparent),color-mix(in srgb,var(--muted) 10%,transparent) 50%,color-mix(in srgb,var(--green) 18%,transparent));border:1px solid var(--grid)}
.compass-mid{position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--faint);opacity:.6}
.compass-marker{position:absolute;top:-5px;width:3px;height:40px;border-radius:2px;background:var(--ink);transition:left .5s cubic-bezier(.34,1.2,.5,1)}
.compass-ends{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:5px}
.leg-state{margin-left:auto;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}

/* bonds→everything transmission rows ------------------------------------- */
.xa-row{display:grid;grid-template-columns:154px 1fr 94px;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--grid)}
.xa-row:last-child{border-bottom:none}
.xa-asset{font-weight:700;color:var(--ink);font-size:13.5px}
.xa-asset .xa-sub{display:block;font-size:11px;color:var(--muted);font-weight:500}
.xa-note{margin-top:5px;font-size:12px;color:var(--muted);line-height:1.45;overflow-wrap:anywhere}
.xa-bar{position:relative;height:9px;background:var(--panel2);border-radius:5px}
.xa-mid{position:absolute;left:50%;top:-3px;bottom:-3px;width:1px;background:var(--faint);opacity:.5}
.xa-fill{position:absolute;top:0;bottom:0;border-radius:5px}
.xa-verd{text-align:right;font-size:12px;font-weight:700}

/* scorecard + generic tables --------------------------------------------- */
.table-wrap,.sc-wrap{overflow-x:auto}
.sc-tbl,.supply-tbl,.credit-cycle-tbl{width:100%;border-collapse:collapse;font-size:13px;min-width:620px}
.sc-tbl th{text-align:right;padding:6px 8px;border-bottom:1px solid var(--grid);color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.03em;font-weight:700;white-space:nowrap}
.sc-tbl th:first-child,.sc-tbl td:first-child{text-align:left}
.sc-tbl td{text-align:right;padding:7px 8px;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums;white-space:nowrap}
.sc-tbl tr:hover td{background:color-mix(in srgb,var(--blue) 5%,transparent)}
.sc-tbl .cty{font-weight:700;color:var(--ink)}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;vertical-align:middle}
.mini-tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:700;color:#fff}
.stale-tag{font-size:9.5px;color:var(--amber);font-weight:700;margin-left:4px}

/* cross-asset drivers + timeline + notes --------------------------------- */
.drv{display:grid;grid-template-columns:120px 1fr;gap:10px 16px;align-items:start;padding:12px 0;border-bottom:1px solid var(--grid);min-width:0}
.drv:last-child{border-bottom:none}
.drv .dasset{font-weight:700;color:var(--ink);font-size:14px}
.drv .dnote{font-size:13px;color:var(--muted);line-height:1.5;min-width:0;overflow-wrap:anywhere}
.drv .dnote b{color:var(--text)}
.timeline{margin-top:6px}
.tl-day{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:14px 0 4px}
.tl-ev{display:flex;align-items:baseline;gap:10px;padding:7px 0;border-bottom:1px solid var(--grid);font-size:13px}
.tl-type{flex:none;min-width:78px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
.tl-head{color:var(--text)}
.sev-high .tl-type{color:var(--red)}.sev-medium .tl-type{color:#9a6a10}.sev-info .tl-type{color:var(--muted)}
.note{font-size:13px;color:var(--muted);line-height:1.6}.note b{color:var(--ink)}
.meta-foot{font-size:12px;color:var(--faint);margin-top:8px}

/* illus figures fill their card + get a hairline frame ------------------- */
.chart-frame{margin-top:14px}
.chart-cap{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:.02em;margin:0 0 4px}

/* footer ------------------------------------------------------------------ */
.site-footer{max-width:1200px;margin:34px auto 0;padding:18px 22px;border-top:1px solid var(--grid);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:12.5px}

/* ═══════ scroll reveal (cards rise as they enter) ═══════════════════════ */
@media(prefers-reduced-motion:no-preference){
  html.js .reveal{opacity:0;transform:translateY(14px);transition:opacity .6s ease,transform .6s cubic-bezier(.22,.9,.26,1.02)}
  html.js .reveal.in{opacity:1;transform:none}
}

/* ═══════ responsive ═════════════════════════════════════════════════════ */
@media(max-width:820px){
  .bh-hero{grid-template-columns:1fr}
  .bh-hero-left{border-right:none;border-bottom:1px solid var(--card-brd)}
}
@media(max-width:560px){
  .wrap{padding:0 13px 56px}
  .card{padding:16px;border-radius:15px}
  .bh-hero>div{padding:20px}
  .brand{font-size:23px}
  .bh-score{font-size:50px}
  .bhg{width:150px;height:96px}
  .drv{grid-template-columns:1fr}
  .tl-ev{align-items:flex-start}.tl-type{min-width:62px}
  .leg{grid-template-columns:minmax(0,1fr) 44px;row-gap:6px}
  .leg .lname{grid-column:1/2}.leg .lval{grid-column:2/3}.leg .lbar{grid-column:1/3}
  .xa-row{grid-template-columns:1fr auto;column-gap:10px;row-gap:7px}
  .xa-row>.xa-asset{grid-area:1/1;min-width:0}.xa-row>.xa-verd{grid-area:1/2;min-width:0}.xa-row>.xa-bar{grid-area:2/1/3/3}
  .kpi{min-width:0;flex:1 1 42%}
  .sec-head{margin:32px 0 13px}
}
</style>
{% include "_vector_polish.html.j2" %}
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="wrap">
  <div class="brand">🏛️ Bonds <span class="gn">&amp; Bond Health</span></div>
  <p class="lead">{{ t('A compact read on bond-market health: curve, credit, real rates, rates volatility, funding stress, global yields and cross-asset spillovers. Context first; trade signals elsewhere.', '债市健康度速览：曲线、信用、实际利率、利率波动、资金压力、全球收益率与跨资产传导。先看背景；交易信号另列。') }}
  <span class="faint">· {{ t('As of', '截至') }} {{ as_of }}</span></p>

  <!-- ===================== SECTION JUMP-NAV ===================== -->
  <div class="jump-nav">
    <a href="#health">🩺 {{ t('Health', '健康度') }}</a>
    <a href="#compass">🧭 {{ t('Duration Compass', '久期罗盘') }}</a>
    <a href="#curve">📐 {{ t('Curve & Recession', '曲线与衰退') }}</a>
    <a href="#credit">⚠️ {{ t('Credit', '信用') }}</a>
    <a href="#real">💵 {{ t('Real Rates', '实际利率') }}</a>
    <a href="#stress">🌡️ {{ t('Stress & Hedge', '压力与对冲') }}</a>
    <a href="#global">🌍 {{ t('Global Scorecard', '全球记分卡') }}</a>
    <a href="#transmission">🔀 {{ t('Bonds → Markets', '债券 → 各市场') }}</a>
    <a href="#supply">🏦 {{ t('Supply & Fed', '供给与美联储') }}</a>
    <a href="#timeline">🕑 {{ t('Timeline', '时间线') }}</a>
    <a href="#corpcredit">🏢 {{ t('Corp Credit', '公司债') }}</a>
  </div>

  <!-- ===================== HERO — BOND HEALTH SCORECARD ===================== -->
  <div id="health" class="bh-hero" style="--sc:{{ vm.health.color }}">
    <div class="bh-hero-left">
      <div class="bh-eyebrow">{{ t('Bond health', '债券健康度') }}</div>
      <div class="bh-scorewrap">
        {{ gauge(vm.health.score, vm.health.color) }}
        <div>
          <div class="bh-score">{{ vm.health.score if vm.health.score is not none else '—' }}<small>/ 100</small></div>
          <div class="bh-band-word">{{ t(vm.health.label, vm.health.label_zh)|capitalize }}</div>
        </div>
      </div>
      <div class="bh-phase">
        <span class="band-chip" style="background:{{ vm.health.phase_color }}">{{ t('Cycle', '周期') }} · {{ t(vm.health.phase_en, vm.health.phase_zh) }}</span>
        {% if vm.health.recession_risk is not none %}<span class="pill">{{ t('recession risk', '衰退风险') }} {{ vm.health.recession_risk }}/100</span>{% endif %}
        {% if vm.health.drawdown_risk is not none %}<span class="pill">{{ t('drawdown risk', '回撤风险') }} {{ vm.health.drawdown_risk }}/100</span>{% endif %}
      </div>
      <p class="bh-verdict"><span class="l-en">{{ vm.health.verdict_en }}</span><span class="l-zh">{{ vm.health.verdict_zh }}</span></p>
      {% if vm.alarms %}{% for a in vm.alarms %}
      <div class="flag {{ 'alarm' if a.severity=='high' else 'warn' }}">⚑ <span class="l-en">{{ a.en }}</span><span class="l-zh">{{ a.zh }}</span></div>
      {% endfor %}{% else %}<div class="flag ok">✓ {{ t('No active bond-stress alarms.', '无活跃的债市压力警报。') }}</div>{% endif %}
    </div>
    <div class="bh-hero-right">
      <h2>{{ t('The yield curve', '收益率曲线') }} <span class="h2q">{{ t('— today vs 3 months / 1 year ago', '— 当前 vs 3月前 / 1年前') }}</span></h2>
      {{ charts.curve_now | safe }}
      {% if vm.curve.tax_en %}<p class="bh-curve-read"><b><span class="l-en">{{ vm.curve.tax_en }}</span><span class="l-zh">{{ vm.curve.tax_zh }}</span></b><span class="l-en"> — {{ vm.curve.tax_note_en }}</span><span class="l-zh"> — {{ vm.curve.tax_note_zh }}</span></p>{% endif %}
      <div style="margin-top:12px">
        {% if vm.curve.nyfed_prob is not none %}<span class="pill">{{ t('NY Fed recession odds', '纽约联储衰退概率') }} {{ vm.curve.nyfed_prob }}%</span>{% endif %}
        {% if vm.curve.spread_10y3m is not none %}<span class="pill">10y−3m {{ '%+.2f'|format(vm.curve.spread_10y3m) }}pp</span>{% endif %}
        {% if vm.curve.spread_2s10s is not none %}<span class="pill">2s10s {{ '%+.2f'|format(vm.curve.spread_2s10s) }}pp</span>{% endif %}
      </div>
    </div>
  </div>

  <!-- ===================== GLANCE — THE BOTTOM LINE ===================== -->
  <div class="sec-head">{{ t('The bottom line — what bonds are telling you', '一句话结论 · 债券在说什么') }}</div>
  <div class="glance">
    {% for gt in glance %}
    <a class="gl-tile {{ gt.sev }}" href="{{ gt.href }}">
      <div class="gl-body">
        <div class="gl-name">{{ t(gt.name_en, gt.name_zh) }}</div>
        <div class="gl-state">{{ t(gt.state_en, gt.state_zh) }}</div>
        <div class="gl-mean">{{ t(gt.mean_en, gt.mean_zh) }}</div>
      </div>
    </a>
    {% endfor %}
  </div>

  <!-- ===================== KEY LEVELS ===================== -->
  <div class="sec-head">{{ t('Key levels', '关键水平') }}</div>
  <div class="klv">
    {% for k in key_levels %}
    <div class="klv-tile">
      <div class="klv-lab">{{ t(k.lab_en, k.lab_zh) }}</div>
      <div class="klv-val">{{ k.val }}{% if k.unit %}<span class="u">{{ k.unit }}</span>{% endif %}</div>
      {% if k.sub %}<div class="klv-sub">{{ k.sub }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>

  <!-- ===================== BOND HEALTH DRIVERS ===================== -->
  <div class="sec-head">{{ t('Bond health — what is driving the score', '债券健康度 · 分项驱动') }}</div>
  <div class="grid cols-2">
    <div class="card reveal">
      <h2>{{ t('Bond health over time', '健康度走势') }}</h2>
      <div class="chart-frame">{{ charts.health | safe }}</div>
      <div class="sub faint" style="margin-top:8px">{{ t('Higher = healthier. Built from recession risk, drawdown risk, credit, rates volatility and funding stress.', '越高越健康。由衰退风险、回撤风险、信用、利率波动与资金压力构成。') }}</div>
    </div>
    <div class="card reveal">
      <h2>{{ t('Stress contributions', '压力来源') }} <span class="h2q">{{ t('0 = calm · 100 = max', '0=平静 · 100=最大') }}</span></h2>
      {% if vm.health.stress_legs %}
      <div class="legs" style="margin-top:4px">
        {% for leg in vm.health.stress_legs %}
        <div class="leg"><span class="lname">{{ t(leg.en, leg.zh) }}</span>
          <span class="lbar"><span class="lfill" style="width:{{ leg.val }}%;background:{{ C.green if leg.val < 50 else C.amber if leg.val < 75 else C.red }}"></span></span>
          <span class="lval">{{ leg.val }}{% if leg.vg[0] %}<span class="lvg vg-{{ leg.vg[1] }}" title="forward-drawdown calibration: {{ leg.vg[1] }}">{{ leg.vg[0] }}</span>{% endif %}</span></div>
        {% endfor %}
      </div>
      {% if vm.health.calib %}
      <div class="measured-edge">📊 {{ t('Measured', '已校准') }}: {{ t('top-stress readings were followed by a 10%+ S&P drawdown within 63 days', '压力最高档读数之后，63天内出现标普10%+回撤的概率为') }}
        <b>{{ vm.health.calib.hi_dd10 }}%</b> {{ t('of the time vs a', '，而基准为') }} <b>{{ vm.health.calib.base_dd10 }}%</b><span class="l-en"> baseline</span>
        (<b>{% if (vm.health.calib.edge_pp or 0) >= 0 %}+{% endif %}{{ vm.health.calib.edge_pp }}pp</b>){{ t('. Recession-IC', '。衰退IC') }} {{ vm.health.calib.ic_recession }}.
        <span class="faint">{{ t('Glyphs: ✓ measured · ~ directional · · context.', '符号：✓ 已校准 · ~ 有方向 · · 仅背景。') }}</span></div>
      {% endif %}
      {% else %}<div class="sub faint">{{ t('Building history.', '数据积累中。') }}</div>{% endif %}
      {% if usd_link %}
      <div class="sub" style="margin-top:14px">{{ t('10-year vs the dollar', '10年债对美元') }}: <b style="color:{{ C.teal if usd_link.corr<0 else C.amber }}" data-tip-en="63-day correlation with the broad dollar. Context, not forecast." data-tip-zh="与广义美元的63日相关。仅作背景，非预测。">{{ '%+.2f'|format(usd_link.corr) }}</b>{% if not usd_link.stable %} <span class="faint">{{ t('(unstable)', '（不稳定）') }}</span>{% endif %}
        {% if usd_link.real_rate_regime is not none %}<span class="faint"> · </span>{% if 'Rising' in usd_link.real_rate_regime %}{{ t('real rates rising', '实际利率上升') }}{% elif 'Falling' in usd_link.real_rate_regime %}{{ t('real rates falling', '实际利率下降') }}{% else %}{{ t('real rates steady', '实际利率平稳') }}{% endif %}{% endif %}</div>
      {% endif %}
    </div>
  </div>

  <!-- ===================== DURATION & CURVE COMPASS ===================== -->
  {% if compass %}
  {% set dur = compass.duration %}
  {% set BUCKET = {'lean_long': (C.green, 'Lean long duration', '偏多久期'), 'neutral': (C.muted, 'Neutral duration', '久期中性'), 'lean_short': (C.red, 'Lean short duration', '偏空久期')} %}
  {% set bk = BUCKET.get(dur.bucket, (C.muted, dur.bucket, dur.bucket)) %}
  {% set markpos = ((dur.lean + 1) / 2 * 100) if dur.lean is not none else 50 %}
  <div id="compass" class="sec-head">{{ t('Duration & Curve Compass — lean long or short?', '久期与曲线罗盘 · 偏多还是偏空？') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Duration lean — the classic bond factors, blended', '久期倾向 · 经典债券因子综合') }}</h2>
      <div style="margin:8px 0 2px">
        <span class="bias-chip" style="background:{{ bk[0] }}">{{ t(bk[1], bk[2]) }}</span>
        <span class="pill">{{ t('lean', '倾向') }} {{ '%+.2f'|format(dur.lean) if dur.lean is not none else '—' }}{% if dur.agreement is not none %} · {{ (dur.agreement*100)|round|int }}% {{ t('agree', '一致') }}{% endif %}</span>
      </div>
      <div class="compass-wrap">
        <div class="compass-track"><div class="compass-mid"></div>
          <div class="compass-marker" style="left:calc({{ markpos|round(1) }}% - 1.5px)"></div></div>
        <div class="compass-ends"><span>← {{ t('short (yields up)', '偏空（利率上行）') }}</span><span>{{ t('long (yields down)', '偏多（利率下行）') }} →</span></div>
      </div>
      <div class="legs" style="margin-top:14px">
        {% for leg in dur.legs %}
        {% set v = leg.value %}{% set w = (v|abs)*50 %}
        {% set lc = C.green if v > 0.15 else (C.red if v < -0.15 else C.muted) %}
        <div class="leg" style="grid-template-columns:148px 1fr 58px">
          <span class="lname" title="{{ leg.note_en }}">{{ t(leg.label_en, leg.label_zh) }}</span>
          <span class="xa-bar"><span class="xa-mid"></span>
            <span class="xa-fill" style="{% if v >= 0 %}left:50%{% else %}left:{{ (50 - w)|round(1) }}%{% endif %};width:{{ w|round(1) }}%;background:{{ lc }}"></span></span>
          <span class="lval" style="color:{{ lc }};text-align:right;font-weight:700">{{ '%+.2f'|format(v) }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="flag info" style="margin-top:14px">ℹ {{ t('Context only. The same factors helped most with drawdown control, not precise return timing.', '仅作背景。同类因子主要帮助控制回撤，而非精确择时收益。') }}</div>
    </div>
    <div class="card">
      <h2>{{ t('Curve trade & expected return', '曲线交易与预期回报') }}</h2>
      {% set ct = compass.curve_trade %}
      {% set CT = {'steepener': (C.amber, 'Steepener bias', '偏陡峭'), 'flattener': (C.teal, 'Flattener bias', '偏平坦'), 'neutral': (C.muted, 'Neutral', '中性')} %}
      {% set ctc = CT.get(ct.lean, (C.muted, ct.lean, ct.lean)) %}
      <div style="margin:8px 0 4px"><span class="bias-chip" style="background:{{ ctc[0] }}">{{ t('Curve', '曲线') }} · {{ t(ctc[1], ctc[2]) }}</span></div>
      <p class="tax-note"><span class="l-en">{{ ct.rationale_en }}</span><span class="l-zh">{{ ct.rationale_zh }}</span></p>
      {% if compass.expected %}
      {% set ex = compass.expected %}
      <div class="kpis" style="margin-top:14px">
        {{ kpi('10y carry', '10年套息', ex.carry_pct, '%') }}
        {{ kpi('Roll-down (1y)', '滚动收益(1年)', ex.rolldown_pct, '%') }}
        {{ kpi('Carry + roll', '套息+滚动', ex.carry_roll_pct, '%') }}
        {{ kpi('Yield-rise cushion', '收益率上行缓冲', ex.cushion_bp, 'bp') }}
      </div>
      <div class="sub faint" style="margin-top:8px">{{ t('Cushion = how much the 10y yield can rise before one year of carry + roll-down is erased (duration ≈ ' ~ ex.duration ~ ').', '缓冲 = 10年期收益率还能上行多少，才会抹掉一年套息+滚动收益（久期约 ' ~ ex.duration ~ '）。') }}</div>
      {% endif %}
      <div class="sub" style="margin-top:12px"><b><span class="l-en">{{ compass.verdict_en }}</span><span class="l-zh">{{ compass.verdict_zh }}</span></b></div>
    </div>
  </div>
  {% endif %}

  <!-- ===================== CURVE & GROWTH ===================== -->
  <div id="curve" class="sec-head">{{ t('① Curve & growth — the recession read', '① 收益率曲线与增长 · 衰退判读') }}</div>
  <div class="card">
    <div class="kpis">
      {{ kpi('10y−3m (NY Fed)', '10年−3月（纽约联储）', vm.curve.spread_10y3m, 'pp') }}
      {{ kpi('Near-term fwd spread', '近端远期利差', vm.curve.ntfs, 'pp') }}
      {{ kpi('2s10s', '2年/10年', vm.curve.spread_2s10s, 'pp') }}
      {{ kpi('TP-adjusted slope', '期限溢价调整斜率', vm.curve.curve_tp_adj, 'pp') }}
      {{ kpi('NY Fed recession prob', '纽约联储衰退概率', vm.curve.nyfed_prob, '%') }}
    </div>
    <div style="margin-top:14px">
      <span class="band-chip" style="background:{{ vm.curve.tax_color }}"><span class="l-en">{{ vm.curve.tax_en }}</span><span class="l-zh">{{ vm.curve.tax_zh }}</span></span>
      <span class="tax-note"><span class="l-en">{{ vm.curve.tax_note_en }}</span><span class="l-zh">{{ vm.curve.tax_note_zh }}</span></span>
    </div>
    {% if vm.curve.bull_steepener_uninversion %}
    <div class="flag alarm">⚑ {{ t('Bull-steepening un-inversion — the curve dis-inverted while short rates fall (cuts being priced). Historically the late-cycle handoff: recessions have begun ~13 months (range ~8–19) after the curve re-steepens.', '牛市陡峭式解除倒挂 — 曲线在短端利率下行（市场定价降息）时解除倒挂。历史上为周期晚段交接：衰退在曲线重新陡峭后约13个月（区间约8–19个月）开始。') }}</div>
    {% elif vm.curve.uninversion %}
    <div class="flag warn">⚑ {{ t('Curve un-inverted after a prior inversion — the dis-inversion, not the inversion, tends to lead recession.', '曲线在此前倒挂后解除 — 引领衰退的往往是解除倒挂而非倒挂本身。') }}</div>
    {% elif vm.curve.tp_adj_inverted %}
    <div class="flag warn">⚑ {{ t('Term-premium-adjusted curve is inverted (a "real" inversion, not a low-term-premium artifact).', '期限溢价调整后的曲线倒挂（“真实”倒挂，非低期限溢价造成的假象）。') }}</div>
    {% endif %}
    <div style="margin-top:16px">
      <div class="sub" style="margin-bottom:4px">{{ t('Recession spreads & TP-adjusted slope over time — zero = flat, below zero = inverted', '衰退利差与期限溢价调整斜率走势 · 0=平坦，负值=倒挂') }}</div>
      {{ charts.spreads | safe }}
    </div>
    <div class="sub faint" style="margin-top:8px">{{ t('10y−3m feeds the NY Fed model. The near-term forward spread is cleaner when markets price Fed cuts. The TP-adjusted slope removes low-term-premium noise.', '10年−3月用于纽约联储模型。近端远期利差更能反映降息定价。期限溢价调整斜率剔除低期限溢价噪音。') }}</div>
  </div>

  <!-- ===================== FED POLICY PATH ===================== -->
  {% if fed_path %}
  <div class="sec-head">{{ t('Market-implied policy path — the Fed vs the market', '市场隐含政策路径 · 美联储 vs 市场') }}</div>
  <div class="card">
    <h2>{{ t('Where the market prices the funds rate — and where the Fed projects it', '市场为基金利率定价之处 · 以及美联储的预测') }}</h2>
    {% if fed_path.headline_en %}<div class="sub" style="margin:2px 0 8px"><b><span class="l-en">{{ fed_path.headline_en }}</span><span class="l-zh">{{ fed_path.headline_zh }}</span></b></div>{% endif %}
    {% if fed_path.gap %}
    <div style="margin:6px 0 10px">
      <span class="band-chip" style="background:var(--muted)">{{ fed_path.gap.horizon_label }} · {{ t('market', '市场') }} {{ '%.2f'|format(fed_path.gap.market) }}% · {{ t('Fed dot', '美联储点阵') }} {{ '%.2f'|format(fed_path.gap.fed_dot) }}%</span>
      <span class="pill"><span class="l-en">{{ '%+d'|format(fed_path.gap.gap_bp) }}bp · {{ fed_path.gap.lean_en }}</span><span class="l-zh">{{ '%+d'|format(fed_path.gap.gap_bp) }}基点 · {{ fed_path.gap.lean_zh }}</span></span>
    </div>
    {% endif %}
    <div class="kpis">
      {{ kpi('Target range', '目标区间', (('%.2f'|format(fed_path.target_low)) ~ '–' ~ ('%.2f'|format(fed_path.target_high))) if fed_path.target_low is not none else none, '%') }}
      {{ kpi('EFFR (policy now)', '有效联邦基金利率', fed_path.policy_rate, '%') }}
      {{ kpi('Implied 12m', '隐含12个月', fed_path.implied.get('m12'), '%') }}
      {{ kpi('Implied 25bp moves (12m)', '隐含25基点变动(12月)', fed_path.implied_cuts_12m, '', t('+ = cuts', '正=降息')) }}
      {{ kpi('Near-term fwd spread', '近端远期利差', fed_path.ntfs, 'pp') }}
      {{ kpi('us2y − funds', 'us2y − 基金利率', fed_path.rate_exp_proxy, 'pp') }}
    </div>
    {% if fed_path.implied_source_en %}<div class="sub faint" style="margin-top:6px">{{ t('Implied path source', '隐含路径来源') }}: <span class="l-en">{{ fed_path.implied_source_en }}</span><span class="l-zh">{{ fed_path.implied_source_zh }}</span></div>{% endif %}
    {% if charts.policy_path %}<div style="margin-top:14px">{{ charts.policy_path | safe }}</div>{% endif %}
    {% if fed_path.read_en %}<div class="sub" style="margin-top:8px"><span class="l-en">{{ fed_path.read_en }}</span><span class="l-zh">{{ fed_path.read_zh }}</span></div>{% endif %}
    <div class="sub faint" style="margin-top:8px">{{ t('Market-implied rates are prices, not forecasts. Use this as policy-path context.', '市场隐含利率是价格，不是预测。此处仅作政策路径背景。') }}</div>
  </div>
  {% endif %}

  <!-- ===================== CREDIT + REAL/INFLATION ===================== -->
  <div id="credit" class="sec-head">{{ t('② Credit & ③ Real rates — risk appetite & the discount rate', '② 信用 与 ③ 实际利率 · 风险偏好与贴现率') }}</div>
  <div class="grid cols-2">
    <div class="card">
      <h2>{{ t('Credit — the "smart money" canary', '信用 · “聪明钱”预警') }}</h2>
      <div style="margin:6px 0 4px"><span class="band-chip" style="background:{{ vm.credit.band_color }}">{{ t(vm.credit.band_en, vm.credit.band_zh) }}</span>
        {% if vm.credit.direction %}<span class="pill"><span class="l-en">{{ vm.credit.direction }}</span><span class="l-zh">{{ vm.credit.direction_zh }}</span></span>{% endif %}</div>
      <div class="kpis">
        {{ kpi('HY OAS', '高收益OAS', vm.credit.hy_oas, '%') }}
        {{ kpi('IG OAS', '投资级OAS', vm.credit.ig_oas, '%') }}
        {{ kpi('HY / IG ratio', '高收益/投资级', vm.credit.hy_ig_ratio, '×') }}
        {{ kpi('Baa−Aaa', 'Baa−Aaa', vm.credit.baa_aaa, '%') }}
        {{ kpi('Excess bond premium', '超额债券溢价', vm.credit.ebp, '%') }}
        {{ kpi('HY %ile (2y)', '高收益百分位(2年)', vm.credit.pctile, '%') }}
      </div>
      <div style="margin-top:14px">{{ charts.credit | safe }}</div>
      <div class="sub faint" style="margin-top:6px">{{ t('HY OAS shows default stress; EBP is the extra spread not explained by default risk. Credit usually weakens before equities.', '高收益OAS显示违约压力；EBP是违约风险解释不了的额外利差。信用通常早于股票走弱。') }}</div>
    </div>
    <div class="card" id="real">
      <h2>{{ t('Real rates & inflation — the discount rate', '实际利率与通胀 · 贴现率') }}</h2>
      <div class="kpis" style="margin-top:2px">
        {{ kpi('10y real (TIPS)', '10年实际利率', vm.real.real_10y, '%') }}
        {{ kpi('5y real', '5年实际利率', vm.real.real_5y, '%') }}
        {{ kpi('10y breakeven', '10年盈亏平衡通胀', vm.real.breakeven_10y, '%') }}
        {{ kpi('5y5y fwd breakeven', '5年5年远期通胀', vm.real.breakeven_5y5y, '%') }}
        {{ kpi('Term premium', '期限溢价', vm.real.term_premium, '%') }}
      </div>
      {% if vm.real.tp_positive %}<div class="flag info">ℹ {{ t('Term premium repriced positive (the 2023–25 shift) — more of any long-yield move is now supply / fiscal / risk, a bear-steepening force.', '期限溢价重新定价转正（2023–25年的转变）——长端收益率变动中更多源于供给/财政/风险，构成熊市陡峭力量。') }}</div>{% endif %}
      <div style="margin-top:14px">{{ charts.real | safe }}</div>
      {% if charts.tp_decomp %}
      <div class="sub" style="margin:12px 0 4px">{{ t('10y yield decomposed — real + breakeven = nominal, term premium overlaid', '10年收益率分解 · 实际+盈亏平衡=名义，叠加期限溢价') }}</div>
      {{ charts.tp_decomp | safe }}
      {% endif %}
      <div class="sub faint" style="margin-top:6px">{{ t('Real yields are the discount rate; breakevens are the inflation read; term premium is the extra reward for duration risk.', '实际利率是贴现率；盈亏平衡通胀是通胀读数；期限溢价是承担久期风险的额外回报。') }}</div>
    </div>
  </div>

  <!-- ===================== CCW-W4: CORPORATE CREDIT DESK ===================== -->
<style>
/* ── CCW-W4 corporate credit desk — page-scoped styles ───────────────────── */
/* card base overrides (bonds.html already defines .card; these extend it) */
.cc-sec-head{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.05em;margin:26px 0 12px;padding-bottom:6px;border-bottom:1px solid var(--grid)}
/* 3px top-stripe severity accent — uses severity tokens (--red/--amber/--green/--faint)
   NOT direction tokens, so zh directional colour swap NEVER fires here (R13). */
.cs-card{position:relative;overflow:hidden}
.cs-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;border-radius:16px 16px 0 0;pointer-events:none;opacity:0}
.cs-amber::before{background:linear-gradient(90deg,var(--amber),color-mix(in srgb,var(--amber) 30%,transparent));opacity:1}
.cs-red::before{background:linear-gradient(90deg,var(--red),color-mix(in srgb,var(--red) 30%,transparent));opacity:1}
.cs-calm::before{background:linear-gradient(90deg,var(--green),color-mix(in srgb,var(--green) 30%,transparent));opacity:1}
.cs-neutral::before{background:linear-gradient(90deg,var(--faint),color-mix(in srgb,var(--faint) 30%,transparent));opacity:1}
/* hero */
.cc-hero-state{font-size:40px;font-weight:800;letter-spacing:-.02em;margin:6px 0 4px;line-height:1;color:var(--ink)}
.cc-verdict-lead{font-size:15px;color:var(--text);line-height:1.5;margin:8px 0 0}
.cc-as-of{font-size:12px;color:var(--faint);margin-top:8px}
/* stance pill — severity, not direction */
.stance-pill{display:inline-block;padding:5px 16px;border-radius:999px;font-size:14px;font-weight:700;color:#fff;letter-spacing:.02em;margin:6px 0}
.stance-amber{background:var(--amber);color:#5a3800}
.stance-red{background:var(--red)}
.stance-calm{background:var(--green)}
.stance-neutral{background:var(--faint);color:var(--ink)}
/* market strip chips */
.cc-mkt-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
.cc-mkt-chip{display:inline-flex;flex-direction:column;gap:2px;padding:10px 14px;border-radius:12px;border:1px solid var(--grid);background:var(--card);cursor:help;flex:1;min-width:160px}
.cc-mkt-chip .chip-label{font-size:13px;font-weight:700;color:var(--ink)}
/* Bottom-align the sub-line: chip labels are state-dependent copy that changes
   nightly, so some wrap to two lines at a given chip width and others don't.
   margin-top:auto pins every sub to the foot of its (equal-height) chip, keeping
   the row of values on one baseline whatever the labels do. */
.cc-mkt-chip .chip-sub{font-size:11px;color:var(--muted);margin-top:auto}
.cc-mkt-chip.chip-amber{border-color:color-mix(in srgb,var(--amber) 55%,var(--grid));background:color-mix(in srgb,var(--amber) 7%,var(--card))}
.cc-mkt-chip.chip-red{border-color:color-mix(in srgb,var(--red) 45%,var(--grid));background:color-mix(in srgb,var(--red) 6%,var(--card))}
.cc-mkt-chip.chip-calm{border-color:color-mix(in srgb,var(--green) 40%,var(--grid));background:color-mix(in srgb,var(--green) 5%,var(--card))}
/* m3 fix: chip-sub color classes for dark-mode-safe coloring (no inline hex) */
.cc-sub-amber{color:#8a5c00}
.cc-sub-red{color:var(--red)}
.cc-sub-calm{color:var(--green)}
html[data-theme="dark"] .cc-sub-amber{color:#e0a030}
html[data-theme="dark"] .cc-sub-red{color:#ff6b6b}
html[data-theme="dark"] .cc-sub-calm{color:#4ade80}
/* theme tiles */
.cc-theme-tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:4px}
.cc-tile{background:var(--card);border:1px solid var(--grid);border-radius:14px;padding:16px;position:relative;overflow:hidden;cursor:help}
.cc-tile::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;border-radius:14px 14px 0 0;pointer-events:none;opacity:0}
.cc-tile.t-amber::before{background:linear-gradient(90deg,var(--amber),color-mix(in srgb,var(--amber) 30%,transparent));opacity:1}
.cc-tile.t-red::before{background:linear-gradient(90deg,var(--red),color-mix(in srgb,var(--red) 30%,transparent));opacity:1}
.cc-tile.t-calm::before{background:linear-gradient(90deg,var(--green),color-mix(in srgb,var(--green) 30%,transparent));opacity:1}
.cc-tile.t-neutral::before{background:linear-gradient(90deg,var(--faint),color-mix(in srgb,var(--faint) 30%,transparent));opacity:1}
.cc-tile .t-name{font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin:0 0 6px}
.cc-tile .t-val{font-size:26px;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1;margin-bottom:4px}
.cc-tile .t-sub{font-size:11.5px;color:var(--muted);margin-top:3px;line-height:1.4}
.cc-tile .t-stance{display:inline-block;margin-top:8px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700}
.cc-tile .ts-amber{background:color-mix(in srgb,var(--amber) 18%,transparent);color:#8a5c00}
.cc-tile .ts-red{background:color-mix(in srgb,var(--red) 15%,transparent);color:var(--red)}
.cc-tile .ts-calm{background:color-mix(in srgb,var(--green) 13%,transparent);color:var(--green)}
.cc-tile .ts-neutral{background:color-mix(in srgb,var(--faint) 20%,transparent);color:var(--faint)}
html[data-theme="dark"] .cc-tile .ts-amber{color:#e0a030}
html[data-theme="dark"] .cc-tile .ts-red{color:#ff6b6b}
html[data-theme="dark"] .cc-tile .ts-calm{color:#4ade80}
html[data-theme="dark"] .cc-tile .ts-neutral{color:var(--faint)}
/* watch strip */
.cc-watch-strip{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}
.cc-watch-chip{display:inline-block;padding:8px 14px;border-radius:12px;font-size:13px;font-weight:600;color:var(--ink);border:1px solid var(--grid);flex:1;min-width:200px;line-height:1.45}
.cc-watch-chip.wc-amber{border-color:color-mix(in srgb,var(--amber) 55%,var(--grid));background:color-mix(in srgb,var(--amber) 7%,var(--card));color:#6b4300}
.cc-watch-chip.wc-neutral{background:var(--card)}
html[data-theme="dark"] .cc-watch-chip.wc-amber{color:#e0a030}
/* tape card */
.cc-tape-line{font-size:14px;font-weight:600;color:var(--ink);line-height:1.5;margin:6px 0 10px}
.cc-source-chip{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700;background:var(--grid);color:var(--muted)}
/* maturity wall mini bars */
.cc-mat-wall{display:flex;flex-direction:column;gap:10px;margin-top:4px}
.cc-mat-row{display:grid;grid-template-columns:128px 1fr;gap:10px;align-items:center;font-size:12px}
.cc-mat-label{color:var(--text);font-weight:600;min-width:0}
.cc-mat-bars{display:flex;gap:2px;height:14px;border-radius:4px;overflow:hidden}
.cc-mat-seg{display:block;height:100%;min-width:2px}
.cc-seg-0{background:color-mix(in srgb,var(--amber) 80%,var(--red))}
.cc-seg-1{background:var(--amber)}
.cc-seg-2{background:color-mix(in srgb,var(--blue) 60%,var(--faint))}
.cc-seg-3{background:var(--blue)}
.cc-seg-4{background:var(--indigo)}
.cc-mat-legend{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;font-size:10.5px;color:var(--muted)}
.cc-mat-legend span{display:flex;align-items:center;gap:4px}
.cc-mat-legend .cc-dot{width:8px;height:8px;border-radius:2px;flex:none}
.cc-placeholder-bar{padding:12px 20px;background:color-mix(in srgb,var(--faint) 8%,var(--bg));border:1px dashed var(--grid);border-radius:10px;text-align:center;font-size:13px;color:var(--faint);font-style:italic;margin:10px 0}
.cc-foot-note{font-size:12px;color:var(--faint);margin-top:12px;line-height:1.6;border-top:1px solid var(--grid);padding-top:10px}
@media(max-width:900px){
  .cc-theme-tiles{grid-template-columns:repeat(2,1fr)}
  .cc-mkt-strip,.cc-watch-strip{flex-direction:column}
}
@media(max-width:560px){
  .cc-hero-state{font-size:32px}
  .cc-theme-tiles{grid-template-columns:1fr}
  .cc-mat-row{grid-template-columns:100px 1fr}
}
</style>

{% if cc_vm is defined %}
  {# 1. SECTION HEAD #}
  <div class="cc-sec-head" id="corpcredit">
    <span class="l-en">Company bonds — credit watch</span><span class="l-zh">公司债 · 信用观察</span>
  </div>

  {# 2. HERO STANCE CARD #}
  <div class="card cs-card {{ cc_vm.hero.hero_cs }}">
    <h2>{{ t('Overall read', '整体研判') }}</h2>
    <div class="cc-hero-state">
      <span class="l-en">{{ cc_vm.hero.state_en }}</span><span class="l-zh">{{ cc_vm.hero.state_zh }}</span>
    </div>
    <div>
      <span class="stance-pill {{ cc_vm.hero.pill_css }}">
        <span class="l-en">{{ cc_vm.hero.pill_en }}</span><span class="l-zh">{{ cc_vm.hero.pill_zh }}</span>
      </span>
    </div>
    <div class="cc-verdict-lead">
      <span class="l-en">{{ cc_vm.hero.subtitle_en }}</span><span class="l-zh">{{ cc_vm.hero.subtitle_zh }}</span>
    </div>
    <div class="cc-as-of">{{ t('as of', '截至') }} {{ cc_vm.as_of }}</div>
  </div>

  {# 3. SPREAD GAUGES (4 chips) #}
  <div class="card" style="margin-top:0">
    <h2>{{ t('Spread gauges', '利差仪表') }}</h2>
    <div class="cc-mkt-strip">
      {% for g in cc_vm.gauges %}
      <div class="cc-mkt-chip {{ g.chip_css }}"
           data-tip-en="{{ g.tip_en }}"
           data-tip-zh="{{ g.tip_zh }}">
        <span class="chip-label">
          <span class="l-en">{{ g.label_en }}</span><span class="l-zh">{{ g.label_zh }}</span>
        </span>
        <span class="chip-sub {{ g.sub_color }}">
          <span class="l-en">{{ g.sub_en }}</span><span class="l-zh">{{ g.sub_zh }}</span>
        </span>
      </div>
      {% endfor %}
      {% if not cc_vm.gauges %}
      <span class="faint" style="font-size:13px">{{ t('Building history — check back soon.', '数据积累中，稍后查看。') }}</span>
      {% endif %}
    </div>
  </div>

  {# 4. THEME TILES (7 tiles) #}
  <div class="card" style="margin-top:0">
    <h2>{{ t('AI & tech themes', 'AI与科技主题') }}</h2>
    <div class="cc-theme-tiles">
      {% for tile in cc_vm.themes %}
      <div class="cc-tile {{ tile.tile_stripe }}"
           data-tip-en="{{ tile.tip_en }}"
           data-tip-zh="{{ tile.tip_zh }}">
        <div class="t-name">
          {% if tile.equity_link %}
          <a href="{{ tile.equity_link }}" style="color:var(--muted);text-decoration:none">
            <span class="l-en">{{ tile.en }}</span><span class="l-zh">{{ tile.zh }}</span>
          </a>
          {% else %}
          <span class="l-en">{{ tile.en }}</span><span class="l-zh">{{ tile.zh }}</span>
          {% endif %}
        </div>
        <div class="t-val">
          {% if tile.level_disp %}{{ tile.level_disp }}{% else %}<span class="faint" style="font-size:16px">—</span>{% endif %}
        </div>
        <div class="t-sub">
          {# M2 fix: always show ratified static descriptor as the primary sub line.
             The Δ21 delta is only rendered as a separate small line once d21 is present.
             Never overwrite the descriptor with "building history". #}
          {% if tile.sub_en %}
          <span class="l-en">{{ tile.sub_en }}</span><span class="l-zh">{{ tile.sub_zh }}</span>
          {% else %}
          <span style="min-height:18px;display:block"></span>
          {% endif %}
          {% if not tile.accruing and tile.d21_disp %}
          <span style="font-size:10px;color:var(--faint);display:block;margin-top:2px">{{ tile.d21_disp }}</span>
          {% endif %}
        </div>
        <span class="t-stance {{ tile.stance_css }}">
          <span class="l-en">{{ tile.stance_en }}</span><span class="l-zh">{{ tile.stance_zh }}</span>
        </span>
      </div>
      {% endfor %}
    </div>
  </div>

  {# 5. WATCH STRIP #}
  <div class="card" style="margin-top:0">
    <h2>{{ t('On the watch list', '观察名单') }}</h2>
    <div class="cc-watch-strip">

      {% if cc_vm.watch.orcl and cc_vm.watch.orcl.g_spread_bp is not none %}
      {% set orcl = cc_vm.watch.orcl %}
      {# B1 fix: guard requires both orcl truthy AND g_spread_bp not None before division.
         Defect 2 fix: display in plain % form (+0.7%), not raw bp (banned Tier-1 vocab).
         g_spread_bp and premium_bp are in basis points; divide by 100 for % display. #}
      <div class="cc-watch-chip wc-amber"
           data-tip-en="Oracle bonds yield {{ '%.2f'|format(orcl.g_spread_bp / 100) }}% over Treasuries{% if orcl.premium_bp is not none %} vs {{ '%.2f'|format((orcl.g_spread_bp - orcl.premium_bp) / 100) }}% for quality-grade peers at the same maturities{% endif %}; all three rating agencies have Oracle on negative outlook. A downgrade to junk would be the largest such event in history."
           data-tip-zh="甲骨文债券相对国债收益率高{{ '%.2f'|format(orcl.g_spread_bp / 100) }}%{% if orcl.premium_bp is not none %}，同期限投资级同行仅{{ '%.2f'|format((orcl.g_spread_bp - orcl.premium_bp) / 100) }}%{% endif %}；三大评级机构均给予负面展望。若降至高收益级将成史上最大规模降级事件。">
        <span style="font-weight:700">ORCL</span> —
        {% if orcl.premium_bp is not none %}
        <span class="l-en">Oracle pays +{{ '%.1f'|format(orcl.premium_bp / 100) }}% over similar bonds — the market votes before the raters</span><span class="l-zh">甲骨文比同级债券多付{{ '%.1f'|format(orcl.premium_bp / 100) }}% · 市场先于评级机构投票</span>
        {% else %}
        <span class="l-en">Oracle pays a premium over similar bonds — the market votes before the raters</span><span class="l-zh">甲骨文比同级债券利率更高 · 市场先于评级机构投票</span>
        {% endif %}
      </div>
      {% endif %}

      {% if cc_vm.watch.fallen_angel_accruing %}
      <div class="cc-watch-chip wc-neutral">
        <span class="l-en">No downgrades-in-motion visible yet — history building</span><span class="l-zh">尚未见降级迹象 · 数据积累中</span>
      </div>
      {% else %}
      {% for candidate in cc_vm.watch.fallen_angel_candidates %}
      <div class="cc-watch-chip wc-amber">
        <span style="font-weight:700">{{ candidate.issuer }}</span> — {{ t('downgrade candidate', '降级候选') }}
      </div>
      {% endfor %}
      {% if not cc_vm.watch.fallen_angel_candidates %}
      <div class="cc-watch-chip wc-neutral">
        <span class="l-en">No fallen-angel candidates in motion</span><span class="l-zh">暂无天使跌落候选</span>
      </div>
      {% endif %}
      {% endif %}

      {% if cc_vm.watch.new_issuance_accruing %}
      <div class="cc-watch-chip wc-neutral">
        <span class="l-en">New-issue tracking starts 14 Jul 2026</span><span class="l-zh">新发债跟踪自2026年7月14日起</span>
      </div>
      {% endif %}

    </div>
  </div>

  {# 6. FINRA TAPE CARD #}
  {% if cc_vm.finra %}
  {% set finra = cc_vm.finra %}
  <div class="card cs-card cs-amber"
       data-tip-en="Market-wide bond tape from actual trades. Price lows can reflect Treasury yields rising rather than company stress — read alongside the extra-yield gauges above. Our own fund-level tape ships separately once history accrues; the two are never blended."
       data-tip-zh="基于真实成交的全市场债券行情。价格新低可能源于国债收益率上行而非公司风险——请结合上方额外收益指标解读。我们自建的基金层面行情将在数据积累后单独展示，两者不混合。">
    <h2>{{ t('Bond market tape', '债券市场行情') }}</h2>
    {% if finra.accruing %}
    <div class="cc-tape-line">
      <span class="l-en">Bond market breadth — building history</span><span class="l-zh">债券市场广度 · 数据积累中</span>
    </div>
    {% else %}
    <div class="cc-tape-line">
      <span class="l-en">{{ t('Latest:', '最新：') }} {{ finra.advance_pct }}% {{ t('of bonds rose', '债券上涨') }} · {{ finra.lows_pct }}% {{ t('touched 1-year lows', '创一年新低') }} · {{ t('as of', '截至') }} {{ finra.date }}</span>
      <span class="l-zh">最新：{{ finra.advance_pct }}%债券上涨 · {{ finra.lows_pct }}%创一年新低 · 截至{{ finra.date }}</span>
    </div>
    {% endif %}
    <span class="cc-source-chip"><span class="l-en">FINRA trade data</span><span class="l-zh">FINRA成交数据</span></span>
  </div>
  {% else %}
  <div class="card cs-card cs-neutral">
    <h2>{{ t('Bond market tape', '债券市场行情') }}</h2>
    <div class="cc-tape-line">
      <span class="l-en">Bond market breadth — building history</span><span class="l-zh">债券市场广度 · 数据积累中</span>
    </div>
    <span class="cc-source-chip"><span class="l-en">FINRA trade data</span><span class="l-zh">FINRA成交数据</span></span>
  </div>
  {% endif %}

  {# 7. MATURITY WALL MINI-CARD #}
  {% if cc_vm.maturity_wall %}
  <div class="card cs-card cs-neutral">
    <h2>{{ t('When the debt comes due', '债务到期分布') }}</h2>
    <div class="cc-mat-wall">
      {% for row in cc_vm.maturity_wall %}
      <div class="cc-mat-row">
        <span class="cc-mat-label">
          <span class="l-en">{{ row.en }}</span><span class="l-zh">{{ row.zh }}</span>
        </span>
        <div class="cc-mat-bars">
          {% for seg in row.segs %}
          <span class="cc-mat-seg cc-{{ seg.css_class }}" style="flex:{{ seg.flex }}"></span>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="cc-mat-legend">
      <span><span class="cc-dot" style="background:color-mix(in srgb,var(--amber) 80%,var(--red))"></span><span class="l-en">0–1y</span><span class="l-zh">0–1年</span></span>
      <span><span class="cc-dot" style="background:var(--amber)"></span><span class="l-en">1–3y</span><span class="l-zh">1–3年</span></span>
      <span><span class="cc-dot" style="background:color-mix(in srgb,var(--blue) 60%,var(--faint))"></span><span class="l-en">3–5y</span><span class="l-zh">3–5年</span></span>
