{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{# ── Internal chip keys — never shown on glance tier ── #}
{% set _INTERNAL_CHIPS = ['qa_context','context_ok','bw_failed','bw_continuation_pre_leadership'] %}
{# ── Lead signal keys for SUPPRESSED lane ── #}
{% set _LEAD_KEYS = ['revision_positive','rs_turn','obv_divergence','accum_evidence','insider_cluster'] %}
{# ── Safe-access helpers ────────────────────────────────────────────── #}
{% set lr = leader_radar if leader_radar is defined and leader_radar else {} %}
{% set rows = lr.rows if lr.rows is defined and lr.rows is not none else [] %}
{% set cov = lr.coverage if lr.coverage is defined and lr.coverage is not none else {} %}
{% set regime = lr.regime if lr.regime is defined and lr.regime is not none else {} %}
{% set handoff_pairs = lr.handoff_pairs if lr.handoff_pairs is defined and lr.handoff_pairs is not none else [] %}
{% set rerating_watch = lr.rerating_watch if lr.rerating_watch is defined and lr.rerating_watch is not none else [] %}
{% set handoff_context = lr.handoff_context if lr.handoff_context is defined and lr.handoff_context is not none else [] %}
{# ── State order for display ── #}
{% set _state_order = ['BREAKAWAY','QUIET_ACCUMULATION','CATALYST_WINDOW','SUPPRESSED','FAILED','NONE'] %}
{# ── Compute state buckets ── #}
{% set ns = namespace(
  catalyst_rows=[],
  quiet_rows=[],
  suppressed_rows=[],
  breakaway_rows=[],
  failed_rows=[],
  none_rows=[],
  leadership_rows=[],
  crowded_rows=[],
  cnt_catalyst=0, cnt_quiet=0, cnt_suppressed=0, cnt_breakaway=0, cnt_failed=0, cnt_none=0,
  cnt_leadership=0, cnt_crowded=0
) %}
{% for r in rows %}
  {% if r.state == 'CATALYST_WINDOW' %}
    {% set ns.catalyst_rows = ns.catalyst_rows + [r] %}
    {% set ns.cnt_catalyst = ns.cnt_catalyst + 1 %}
  {% elif r.state == 'QUIET_ACCUMULATION' %}
    {% set ns.quiet_rows = ns.quiet_rows + [r] %}
    {% set ns.cnt_quiet = ns.cnt_quiet + 1 %}
  {% elif r.state == 'SUPPRESSED' %}
    {% set ns.suppressed_rows = ns.suppressed_rows + [r] %}
    {% set ns.cnt_suppressed = ns.cnt_suppressed + 1 %}
  {% elif r.state == 'BREAKAWAY' %}
    {% set ns.breakaway_rows = ns.breakaway_rows + [r] %}
    {% set ns.cnt_breakaway = ns.cnt_breakaway + 1 %}
  {% elif r.state == 'FAILED' %}
    {% set ns.failed_rows = ns.failed_rows + [r] %}
    {% set ns.cnt_failed = ns.cnt_failed + 1 %}
  {% elif r.state == 'LEADERSHIP' %}
    {% set ns.leadership_rows = ns.leadership_rows + [r] %}
    {% set ns.cnt_leadership = ns.cnt_leadership + 1 %}
  {% elif r.state == 'CROWDED' %}
    {% set ns.crowded_rows = ns.crowded_rows + [r] %}
    {% set ns.cnt_crowded = ns.cnt_crowded + 1 %}
  {% else %}
    {% set ns.none_rows = ns.none_rows + [r] %}
    {% set ns.cnt_none = ns.cnt_none + 1 %}
  {% endif %}
{% endfor %}
{# ── Count positive (non-internal) chips for a row ── #}
{# We embed chip counts into a JS data attribute; Jinja loops count them here #}
{# ── Plain-word state labels (EN/ZH) ── #}
{# stage_plain_en / stage_plain_zh used by pipeline and full board #}
