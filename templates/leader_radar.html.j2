<link rel="stylesheet" href="theme.css">
<style>
/* ── CSS Variables (aurora-glass palette) ── */
:root {
  --bg-base:       var(--bg, #0d0f14);
  --bg-glass:      rgba(18,22,32,0.72);
  --bg-glass-2:    rgba(24,28,42,0.60);
  --bg-card:       rgba(20,24,36,0.85);
  --border:        rgba(255,255,255,0.07);
  --border-strong: rgba(255,255,255,0.14);
  --text-primary:  var(--text, #e8eaf0);
  --text-secondary:var(--muted, #8b90a8);
  --text-muted:    #4e5370;
  --text-dim:      #3a3e54;
  --col-ignition:  #3b82f6;
  --col-quiet:     #7c3aed;
  --col-suppressed:#6b7280;
  --col-breakaway: #22c55e;
  --col-leading:   #16a34a;
  --col-crowded:   #f59e0b;
  --col-failed:    #ef4444;
  --glow-ignition:  rgba(59,130,246,0.18);
  --glow-quiet:     rgba(124,58,237,0.18);
  --glow-suppressed:rgba(107,114,128,0.12);
  --glow-breakaway: rgba(34,197,94,0.15);
  --glow-failed:    rgba(239,68,68,0.10);
  --radius-card: 14px;
  --radius-chip: 6px;
  --transition: 0.18s ease;
  /* ── mx5 port: mono numerals + deliberate type scale ──
     Alias the house mono token (theme.css --font-mono) so the numeric face
     matches the rest of the site. Lead the inline fallback with ui-monospace,
     NOT the literal "SF Mono": Chromium can't resolve "SF Mono" by that family
     name and falls back to SERIF, which is what broke the gauge numerals.
     ui-monospace resolves to SF Mono on macOS/iOS and the platform mono
     elsewhere. */
  --num: var(--font-mono, ui-monospace, "SF Mono", SFMono-Regular, "Cascadia Mono", "JetBrains Mono", "Roboto Mono", Menlo, Consolas, "DejaVu Sans Mono", monospace);
  --fs-display: 44px;
  --fs-num-xl:  38px;
  --fs-h1:      27px;
  --fs-num-lg:  22px;
  --fs-h2:      16px;
  --fs-md:      15px;
  --fs-body:    14px;
  --fs-sm:      12.5px;
  --fs-label:   11px;
  --fs-micro:   10px;
  /* ── laser hairlines + machined-surface shadow ── */
  --hair:        rgba(255,255,255,0.06);
  --hair-strong: rgba(255,255,255,0.11);
  --tile:        rgba(255,255,255,0.025);
  --ms: inset 0 1px 0 0 rgba(255,255,255,.05), 0 1px 1px rgba(0,0,0,.28), 0 16px 36px -22px rgba(0,0,0,.62);
  /* ── mx5 glass card system ── */
  --mx5-glass-bg:     rgba(17,22,31,.60);
  --mx5-glass-border: rgba(255,255,255,.10);
  --mx5-glass-shadow: 0 8px 32px rgba(0,0,0,.5), 0 1.5px 0 rgba(255,255,255,.06) inset;
  --mx5-glass-hover:  0 16px 46px -8px rgba(0,0,0,.6), 0 1.5px 0 rgba(255,255,255,.10) inset;
  --mx5-blur:         blur(20px) saturate(1.35);
  --mx5-radius-card:  18px;
  /* ── section rail + eyebrow tracking ── */
  --rail: var(--col-ignition);
  --trk:  .16em;
}
[data-theme="light"] {
  --bg-base: #f0f2f8;
  --bg-glass: rgba(255,255,255,0.78);
  --bg-glass-2: rgba(240,242,248,0.82);
  --bg-card: rgba(255,255,255,0.92);
  --border: rgba(0,0,0,0.07);
  --border-strong: rgba(0,0,0,0.13);
  --text-primary: #0f1117;
  --text-secondary: #4b5068;
  --text-muted: #8a8fa8;
  --text-dim: #c0c3d0;
  --glow-ignition: rgba(59,130,246,0.10);
  --glow-quiet: rgba(124,58,237,0.10);
  --glow-breakaway: rgba(34,197,94,0.10);
  --glow-failed: rgba(239,68,68,0.07);
  /* mx5 light overrides */
  --hair:        rgba(15,20,35,0.07);
  --hair-strong: rgba(15,20,35,0.12);
  --tile:        rgba(15,20,35,0.02);
  --ms: inset 0 1px 0 0 rgba(255,255,255,.7), 0 1px 2px rgba(20,30,50,.05), 0 16px 34px -22px rgba(20,30,50,.18);
  --mx5-glass-bg:     rgba(255,255,255,.82);
  --mx5-glass-border: rgba(15,20,35,.09);
  --mx5-glass-shadow: 0 12px 34px -14px rgba(20,32,64,.22), 0 1.5px 0 rgba(255,255,255,.9) inset;
  --mx5-glass-hover:  0 18px 46px -12px rgba(20,32,64,.28), 0 1.5px 0 rgba(255,255,255,.95) inset;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{font-size:15px;scroll-behavior:smooth;}
body{font-family:var(--font-ui,-apple-system,BlinkMacSystemFont,'SF Pro Display','Segoe UI',sans-serif);background:var(--bg-base);color:var(--text-primary);min-height:100vh;line-height:1.5;-webkit-font-smoothing:antialiased;margin:0;padding-top:24px;
  --aur-a:rgba(59,130,246,0.13);--aur-b:rgba(124,58,237,0.12);--aur-c:rgba(34,197,94,0.06);}
/* Regime-tinted ambient aurora (static — painted once, perf-safe) */
body.rg-narrow{--aur-a:rgba(245,158,11,0.14);--aur-b:rgba(59,130,246,0.10);--aur-c:rgba(124,58,237,0.06);}
body.rg-broad{--aur-a:rgba(34,197,94,0.15);--aur-b:rgba(59,130,246,0.10);--aur-c:rgba(34,197,94,0.07);}
body.rg-mixed{--aur-a:rgba(59,130,246,0.12);--aur-b:rgba(124,58,237,0.11);--aur-c:rgba(148,163,184,0.05);}
body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(680px 460px at 12% -6%,var(--aur-a) 0%,transparent 68%),
    radial-gradient(620px 460px at 92% 2%,var(--aur-b) 0%,transparent 70%),
    radial-gradient(760px 520px at 55% 114%,var(--aur-c) 0%,transparent 70%);}
a{text-decoration:none;color:inherit;}
.page-wrap{position:relative;z-index:1;max-width:1500px;margin:0 auto;padding:20px 28px 52px;}
.glass{background:var(--mx5-glass-bg);border:1px solid var(--mx5-glass-border);border-radius:var(--mx5-radius-card);backdrop-filter:var(--mx5-blur);-webkit-backdrop-filter:var(--mx5-blur);box-shadow:var(--mx5-glass-shadow);}
/* Mono tabular numerals — the terminal feel */
.num{font-family:var(--num);font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1;letter-spacing:-.01em;}
/* ── mx5 animation keyframes (opacity / dash-reveal — one-shot, perf-safe) ── */
@keyframes lrRise{from{opacity:0;transform:translateY(9px);}to{opacity:1;transform:none;}}
@keyframes lrGlowBreathe{0%,100%{opacity:.32;}50%{opacity:.72;}}
@keyframes lrDrawIn{to{stroke-dashoffset:0;}}
@keyframes lrBarGrow{from{transform:scaleX(0);}to{transform:scaleX(1);}}
@keyframes lrDotPulse{0%,100%{opacity:1;}50%{opacity:.4;}}
/* breadth gauge: the scale arc draws left→right, then the value marker fades in.
   Rest state is the finished frame (full arc / visible marker) so the value is
   correct even when the animation is skipped — the old needle broke precisely
   because its resting value lived only inside a (losing) keyframe. */
@keyframes lrArcReveal{from{stroke-dashoffset:100;}}
@keyframes lrMarkFade{from{opacity:0;}to{opacity:1;}}
/* ═══════════════ HERO ═══════════════ */
.lr-hero{position:relative;display:grid;grid-template-columns:minmax(0,0.86fr) minmax(0,1.14fr);gap:0;overflow:hidden;margin-bottom:20px;padding:0;animation:lrRise .5s cubic-bezier(.22,.9,.26,1.02) both;}
.lr-hero-read{padding:24px 26px 22px;display:flex;flex-direction:column;gap:12px;min-width:0;}
.lr-eyebrow{font-size:var(--fs-label);font-weight:700;letter-spacing:var(--trk);text-transform:uppercase;color:var(--text-muted);}
.lr-verdict-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
.lr-verdict{font-size:var(--fs-display);font-weight:800;letter-spacing:-.025em;line-height:.98;color:var(--text-primary);}
.lr-verdict.r-narrow{color:var(--col-crowded);}
.lr-verdict.r-broad{color:var(--col-breakaway);}
.lr-verdict.r-mixed{color:var(--text-primary);}
.lr-stance{font-size:var(--fs-md);font-weight:700;letter-spacing:-.01em;color:var(--text-primary);}
.lr-stance .lr-stance-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:baseline;box-shadow:0 0 10px currentColor;}
.lr-says{font-size:var(--fs-sm);color:var(--text-secondary);line-height:1.5;max-width:46ch;}
/* what-would-flip-it callout */
.lr-flip{display:flex;gap:9px;align-items:flex-start;font-size:0.78rem;line-height:1.45;color:var(--text-secondary);padding:9px 12px;border-radius:10px;background:color-mix(in srgb,var(--col-crowded) 8%,transparent);border:1px solid color-mix(in srgb,var(--col-crowded) 22%,transparent);}
.lr-flip .lr-flip-ar{color:var(--col-crowded);font-weight:800;flex-shrink:0;}
/* count chips */
.lr-counts{display:flex;gap:8px;flex-wrap:wrap;margin-top:2px;}
.lr-count{display:inline-flex;align-items:center;gap:7px;padding:5px 11px 5px 9px;border-radius:9px;background:var(--tile);border:1px solid var(--hair-strong);font-size:0.74rem;font-weight:600;color:var(--text-secondary);}
.lr-count b{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:0.95rem;font-weight:800;color:var(--text-primary);letter-spacing:-.02em;}
.lr-count .lr-cdot{width:7px;height:7px;border-radius:50%;}
/* ── breadth arc gauge — mx5 idiom (gradient scale + value marker, no centre
   needle). The value is a marker riding the arc + the numeral in the well;
   nothing crosses the number, so the read is always clean. ── */
.lr-gauge-wrap{display:flex;align-items:center;gap:20px;margin:8px 0 2px;}
.lr-gauge{position:relative;width:158px;height:96px;flex-shrink:0;}
.lr-gauge svg{width:158px;height:96px;overflow:visible;display:block;}
.lr-br-track{fill:none;stroke:var(--hair-strong);stroke-width:9;stroke-linecap:round;}
.lr-br-scale{fill:none;stroke-width:9;stroke-linecap:round;stroke-dasharray:100;stroke-dashoffset:0;
  filter:drop-shadow(0 1px 5px rgba(0,0,0,.28));animation:lrArcReveal 1.05s cubic-bezier(.22,.9,.26,1.02);}
/* Breadth is a direction read (advance/decline) → paint from --down/--up so the
   global zh swap flips it to 红涨绿跌. Stops get their colour from a CSS rule,
   not a stop-color="var(…)" presentation attribute (SVG can't resolve var there). */
.lr-br-g0{stop-color:var(--down);}   /* weak / narrow breadth */
.lr-br-gm{stop-color:var(--text-muted);}
.lr-br-g1{stop-color:var(--up);}     /* broad advance */
/* regime gates etched on the dial: below 40% narrows, over 61% broadens */
.lr-br-tick{stroke:var(--text-secondary);stroke-width:2;stroke-linecap:round;opacity:.62;}
.lr-br-halo{fill:color-mix(in srgb,var(--text-primary) 16%,transparent);animation:lrMarkFade .6s .34s both;}
.lr-br-core{fill:var(--text-primary);stroke:var(--bg-base);stroke-width:2;
  filter:drop-shadow(0 0 6px color-mix(in srgb,var(--text-primary) 55%,transparent));animation:lrMarkFade .6s .34s both;}
.lr-gauge-val{position:absolute;left:0;right:0;bottom:2px;text-align:center;pointer-events:none;}
.lr-gauge-num{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:30px;font-weight:800;letter-spacing:-.03em;color:var(--text-primary);line-height:1;}
.lr-gauge-cap{font-size:0.58rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);margin-top:4px;}
.lr-gauge-side{min-width:0;}
.lr-gauge-side .lr-gs-line{font-size:0.82rem;color:var(--text-secondary);line-height:1.5;}
.lr-gauge-side .lr-gs-line b{color:var(--text-primary);font-weight:700;}
/* ── lifecycle funnel (hero right) ── */
.lr-funnel{position:relative;padding:22px 24px 20px;border-left:1px solid var(--hair);display:flex;flex-direction:column;justify-content:center;min-width:0;background:linear-gradient(180deg,rgba(255,255,255,0.012),transparent 40%);}
.lr-dist{display:flex;height:8px;border-radius:5px;overflow:hidden;margin:18px 0 8px;background:var(--hair-strong);}
.lr-dist-seg{height:100%;animation:lrBarGrow .7s cubic-bezier(.22,.9,.26,1.02) both;transform-origin:left;}
.lr-dist-key{display:flex;gap:16px;font-size:0.66rem;color:var(--text-muted);}
.lr-dist-key .num{color:var(--text-secondary);font-weight:700;}
.lr-dist-key .lr-dk-dot{display:inline-block;width:7px;height:7px;border-radius:2px;margin-right:5px;vertical-align:middle;}
.lr-funnel-hd{display:flex;align-items:baseline;gap:8px;margin-bottom:13px;}
.lr-funnel-title{font-size:var(--fs-label);font-weight:700;letter-spacing:var(--trk);text-transform:uppercase;color:var(--text-muted);}
.lr-funnel-sub{font-size:0.7rem;color:var(--text-dim);}
.lr-flow{display:flex;align-items:stretch;gap:0;}
.lr-fstage{position:relative;flex:1 1 0;min-width:0;padding:2px 8px 2px 0;display:flex;flex-direction:column;gap:3px;animation:lrRise .5s cubic-bezier(.22,.9,.26,1.02) both;}
.lr-fstage+.lr-fstage{padding-left:12px;border-left:1px solid var(--hair);}
.lr-fstage.is-empty{opacity:.5;}
.lr-fs-top{display:flex;align-items:center;gap:5px;}
.lr-fs-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.lr-fs-name{font-size:0.66rem;font-weight:700;color:var(--text-secondary);line-height:1.15;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.lr-fs-count{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:1.7rem;font-weight:800;line-height:1;letter-spacing:-.03em;}
.lr-fs-stance{font-size:0.6rem;color:var(--text-muted);line-height:1.25;}
.lr-fs-arrow{position:absolute;right:-6px;top:16px;z-index:2;font-size:0.6rem;color:var(--text-dim);pointer-events:none;}
.lr-funnel-foot{display:flex;gap:10px;margin-top:14px;padding-top:12px;border-top:1px solid var(--hair);align-items:center;flex-wrap:wrap;}
.lr-ff-item{display:flex;align-items:center;gap:7px;font-size:0.7rem;color:var(--text-muted);}
.lr-ff-item b{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:0.95rem;font-weight:800;letter-spacing:-.01em;}
.lr-ff-item.failed b{color:var(--col-failed);}
.lr-ff-sep{width:1px;height:14px;background:var(--hair-strong);}
.lr-ff-chips{display:flex;gap:4px;flex-wrap:wrap;margin-left:auto;}
.lr-ff-chip{font-family:var(--num);font-size:0.6rem;padding:1px 5px;border-radius:4px;background:color-mix(in srgb,var(--col-failed) 11%,transparent);color:var(--col-failed);font-weight:600;text-decoration:none;}
.lr-ff-chip:hover{background:color-mix(in srgb,var(--col-failed) 20%,transparent);}
@media(max-width:920px){
  .lr-hero{grid-template-columns:1fr;}
  .lr-funnel{border-left:none;border-top:1px solid var(--hair);}
  .lr-flow{overflow-x:auto;}
  .lr-fstage{min-width:78px;}
}
@media(prefers-reduced-motion:reduce){
  .lr-hero,.lr-fstage{animation:none;}
  .lr-br-scale,.lr-br-halo,.lr-br-core{animation:none;}
}
/* ── LANG/THEME visibility ── */
.l-zh{display:none;}
[data-lang="zh"] .l-en{display:none;}
[data-lang="zh"] .l-zh{display:inline;}
/* ── Banner ── */
.banner{padding:10px 14px;border-radius:10px;margin-bottom:14px;font-size:12px;border:1px solid;}
.banner-stale{background:rgba(239,68,68,.08);border-color:#ef4444;color:#ef4444;}
.banner-degraded{background:rgba(245,158,11,.08);border-color:#f59e0b;color:#f59e0b;}
/* ── HERO META + affordances ── */
.header-meta{display:flex;align-items:center;gap:10px;margin-top:6px;font-size:0.75rem;color:var(--text-muted);flex-wrap:wrap;}
.header-meta .dot{width:3px;height:3px;border-radius:50%;background:var(--text-dim);}
.q-afford{display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;border-radius:50%;background:var(--border-strong);color:var(--text-muted);font-size:0.65rem;cursor:pointer;transition:var(--transition);font-weight:700;border:1px solid var(--border);}
.q-afford:hover{background:var(--col-ignition);color:#fff;}
/* ── SECTION LABELS ── */
.section-header{display:flex;align-items:baseline;gap:10px;margin-bottom:14px;}
.section-title{font-size:0.78rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);}
.section-count{font-size:0.72rem;color:var(--text-dim);}
.section-rule{flex:1;height:1px;background:var(--border);}
/* ── TONIGHT'S FOCUS ── */
.tonight-section{margin-bottom:20px;}
.section-note{font-size:0.72rem;color:var(--text-muted);font-weight:500;}
.tonight-wrap{padding:15px 17px;}
.tonight-grid{display:flex;flex-wrap:wrap;gap:9px;}
.move-card{display:inline-flex;align-items:center;gap:9px;padding:9px 14px 9px 12px;border-radius:11px;background:var(--bg-card);border:1px solid var(--border);position:relative;overflow:hidden;transition:var(--transition);text-decoration:none;animation:lrRise .4s cubic-bezier(.22,.9,.26,1.02) both;}
.move-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--mv-c,var(--text-muted));}
.move-card:hover{border-color:var(--mv-c,var(--border-strong));transform:translateY(-1px);box-shadow:0 7px 20px rgba(0,0,0,.24);}
.move-glyph{color:var(--mv-c);font-size:0.9rem;filter:drop-shadow(0 0 6px var(--mv-c));}
.move-tkr{font-weight:800;font-size:0.92rem;color:var(--text-primary);letter-spacing:-.01em;}
.move-ar{color:var(--text-dim);font-size:0.82rem;}
.move-badge{font-size:0.68rem;font-weight:700;padding:2px 9px;border-radius:6px;background:color-mix(in srgb,var(--mv-c) 16%,transparent);color:var(--mv-c);white-space:nowrap;}
.move-from{font-size:0.68rem;color:var(--text-muted);}
.move-card.is-fire{--mv-c:var(--col-ignition);box-shadow:0 0 0 1px color-mix(in srgb,var(--col-ignition) 24%,transparent),0 6px 20px -6px var(--glow-ignition);}
.move-card.is-crowded{--mv-c:var(--col-crowded);}
.tonight-empty{font-size:0.82rem;color:var(--text-muted);padding:2px 0;}
/* one signal away — folded in */
.tonight-near{margin-top:13px;padding-top:12px;border-top:1px solid var(--hair);display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
.tn-label{font-size:0.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted);flex-shrink:0;}
.tn-chip{display:inline-flex;align-items:center;gap:7px;padding:4px 10px;border-radius:8px;background:var(--tile);border:1px solid var(--hair-strong);font-size:0.74rem;text-decoration:none;transition:var(--transition);}
.tn-chip:hover{border-color:var(--col-ignition);}
.tn-chip .tn-tkr{font-weight:800;color:var(--text-primary);}
.tn-chip .tn-miss{color:var(--col-crowded);font-size:0.66rem;}
/* cooled summary — the de-noised de-escalations */
.tonight-cooled{margin-top:13px;padding-top:12px;border-top:1px solid var(--hair);font-size:0.74rem;color:var(--text-muted);display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;}
.tonight-cooled b{color:var(--text-secondary);font-weight:700;}
/* ── entry-read shelves (LRV-O9): stance-graded overnight moves ── */
.tn-shelf{margin-bottom:13px;}
.tn-shelf:last-of-type{margin-bottom:0;}
.tn-shelf-label{display:flex;align-items:center;gap:7px;font-size:0.62rem;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;}
.tn-shelf-label .tns-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.tn-shelf-label .tns-sub{font-weight:500;text-transform:none;letter-spacing:0;color:var(--text-dim);}
.move-card.is-late{--mv-c:var(--col-crowded);}
.move-card.is-late .move-badge{color:var(--col-crowded);}
.move-card.is-late .move-glyph{filter:none;}
.move-card.is-turn{--mv-c:var(--col-suppressed);}
.move-card.is-turn .move-tkr{color:var(--text-secondary);}
.move-card.is-turn .move-badge{color:var(--text-muted);}
.move-read{font-size:0.68rem;color:var(--text-muted);border-left:1px solid var(--hair-strong);padding-left:9px;white-space:nowrap;}
.move-read b{color:var(--text-secondary);font-weight:700;}
.tonight-baserate{margin-top:13px;padding-top:12px;border-top:1px solid var(--hair);font-size:0.7rem;color:var(--text-dim);line-height:1.5;}
/* lane-card entry flags */
.entry-flag{display:inline-block;font-size:0.66rem;font-weight:600;padding:3px 9px;border-radius:5px;margin-top:7px;letter-spacing:0.01em;}
.entry-flag.late{background:color-mix(in srgb,var(--col-crowded) 12%,transparent);color:var(--col-crowded);}
.entry-flag.turn{background:rgba(255,255,255,0.04);color:var(--text-muted);}
/* OEU M-PRO options caveat — quietest of the three: context, not a verdict. */
.entry-flag.opt{background:rgba(255,255,255,0.03);color:var(--text-muted);font-weight:500;}
.cooled-list{font-size:0.68rem;color:var(--text-dim);font-family:var(--num);letter-spacing:.01em;}
/* ── FIRE RECEIPTS ── */
.fire-receipts-section{margin-bottom:20px;}
.fire-receipts-table{width:100%;border-collapse:collapse;font-size:0.8rem;}
.fire-receipts-table th{text-align:left;padding:7px 12px;color:var(--text-dim);font-size:0.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--hair-strong);}
.fire-receipts-table td{padding:8px 12px;border-bottom:1px solid var(--hair);color:var(--text-secondary);font-variant-numeric:tabular-nums;}
.fire-receipts-table tr:last-child td{border-bottom:none;}
.fire-receipts-table tbody tr{transition:var(--transition);}
.fire-receipts-table tbody tr:hover td{background:color-mix(in srgb,var(--col-ignition) 6%,transparent);}
.fire-receipts-table td:first-child,.fire-receipts-table td:nth-child(2){font-family:var(--num);}
.fire-receipts-footer{font-size:0.72rem;color:var(--text-dim);padding:9px 2px 2px;}
/* ── EARLY ENTRY BOARD ── */
.early-entry-section{margin-bottom:26px;}
.lane-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}
.lane-col{display:flex;flex-direction:column;gap:11px;}
.lane-header{display:flex;align-items:center;gap:9px;padding:11px 15px;border-radius:12px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);}
.lane-header.ignition{background:color-mix(in srgb,var(--col-ignition) 12%,transparent);border:1px solid color-mix(in srgb,var(--col-ignition) 26%,transparent);}
.lane-header.quiet{background:color-mix(in srgb,var(--col-quiet) 12%,transparent);border:1px solid color-mix(in srgb,var(--col-quiet) 24%,transparent);}
.lane-header.suppressed{background:color-mix(in srgb,var(--col-suppressed) 10%,transparent);border:1px solid color-mix(in srgb,var(--col-suppressed) 18%,transparent);}
.lane-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.lane-dot.ignition{background:var(--col-ignition);box-shadow:0 0 10px var(--col-ignition);}
.lane-dot.quiet{background:var(--col-quiet);box-shadow:0 0 10px var(--col-quiet);}
.lane-dot.suppressed{background:var(--col-suppressed);}
.lane-name{font-size:0.86rem;font-weight:700;color:var(--text-primary);flex:1;letter-spacing:-.01em;}
.lane-count-chip{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:0.72rem;font-weight:800;padding:2px 9px;border-radius:10px;}
.lane-count-chip.ignition{background:color-mix(in srgb,var(--col-ignition) 22%,transparent);color:#93c5fd;}
.lane-count-chip.quiet{background:color-mix(in srgb,var(--col-quiet) 22%,transparent);color:#c4b5fd;}
.lane-count-chip.suppressed{background:color-mix(in srgb,var(--col-suppressed) 18%,transparent);color:var(--text-muted);}
/* Entry card */
.entry-card{background:var(--bg-card);border:1px solid var(--border);border-radius:13px;padding:14px 16px;transition:transform .16s ease,box-shadow .22s ease,border-color .2s ease;cursor:pointer;position:relative;overflow:hidden;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);animation:lrRise .45s cubic-bezier(.22,.9,.26,1.02) both;}
.entry-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;z-index:2;}
.entry-card:hover{transform:translateY(-2px);}
.entry-card.ignition{border-color:color-mix(in srgb,var(--col-ignition) 28%,transparent);}
.entry-card.ignition::before{background:linear-gradient(90deg,var(--col-ignition),color-mix(in srgb,var(--col-ignition) 30%,transparent));}
.entry-card.ignition:hover{box-shadow:0 10px 28px -6px var(--glow-ignition);border-color:color-mix(in srgb,var(--col-ignition) 50%,transparent);}
.entry-card.quiet{border-color:color-mix(in srgb,var(--col-quiet) 24%,transparent);}
.entry-card.quiet::before{background:linear-gradient(90deg,var(--col-quiet),color-mix(in srgb,var(--col-quiet) 30%,transparent));}
.entry-card.quiet:hover{box-shadow:0 10px 28px -6px var(--glow-quiet);border-color:color-mix(in srgb,var(--col-quiet) 42%,transparent);}
.entry-card.suppressed{border-color:color-mix(in srgb,var(--col-suppressed) 18%,transparent);}
.entry-card.suppressed::before{background:linear-gradient(90deg,var(--col-suppressed),transparent);}
.entry-card.suppressed:hover{box-shadow:0 8px 20px -6px var(--glow-suppressed);}
/* breathing glow — draws the eye to the time-sensitive ignition names */
.entry-card.ignition::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;box-shadow:0 0 0 1px color-mix(in srgb,var(--col-ignition) 40%,transparent),0 0 20px 1px var(--glow-ignition);opacity:0;animation:lrGlowBreathe 3.9s ease-in-out infinite;}
.card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:9px;}
.card-ticker{font-size:1.34rem;font-weight:800;letter-spacing:-0.03em;color:var(--text-primary);line-height:1;}
.card-right{display:flex;flex-direction:column;align-items:flex-end;gap:5px;}
.card-days{font-family:var(--num);font-variant-numeric:tabular-nums;font-size:0.66rem;color:var(--text-muted);letter-spacing:-.01em;}
.card-sparkline{width:66px;height:24px;}
.spark-path{fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;}
.spark-path.up{stroke:#4ade80;}
.spark-path.down{stroke:#f87171;}
.spark-path.flat{stroke:#8b90a8;}
/* dot bar */
.evidence-bar{display:flex;align-items:center;gap:6px;margin-bottom:7px;}
.dot-bar{display:flex;gap:3px;}
.dot-bar-dot{width:6px;height:6px;border-radius:50%;transition:var(--transition);}
.dot-bar-dot.filled.ignition{background:var(--col-ignition);box-shadow:0 0 6px color-mix(in srgb,var(--col-ignition) 60%,transparent);}
.dot-bar-dot.filled.quiet{background:var(--col-quiet);box-shadow:0 0 6px color-mix(in srgb,var(--col-quiet) 55%,transparent);}
.dot-bar-dot.filled.suppressed{background:var(--text-muted);}
.dot-bar-dot.empty{background:var(--text-dim);}
.ev-label{font-size:0.7rem;color:var(--text-muted);}
.ev-label strong{color:var(--text-secondary);}
/* evidence line */
.evidence-line{font-size:0.78rem;color:var(--text-secondary);line-height:1.45;}
.ev-sep{color:var(--text-dim);margin:0 3px;}
/* timing chip */
.timing-chip{display:inline-flex;align-items:center;gap:4px;margin-top:8px;padding:3px 9px;border-radius:6px;font-size:0.7rem;font-weight:600;}
.timing-chip.near{background:color-mix(in srgb,var(--col-ignition) 15%,transparent);border:1px solid color-mix(in srgb,var(--col-ignition) 30%,transparent);color:#93c5fd;}
.timing-chip.watch{background:color-mix(in srgb,var(--col-quiet) 15%,transparent);border:1px solid color-mix(in srgb,var(--col-quiet) 30%,transparent);color:#c4b5fd;}
/* fire badge */
.fire-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:6px;font-size:0.68rem;font-weight:700;background:color-mix(in srgb,var(--col-ignition) 15%,transparent);border:1px solid color-mix(in srgb,var(--col-ignition) 30%,transparent);color:#93c5fd;}
/* Empty lane state */
.lane-empty{padding:12px 13px;font-size:0.72rem;color:var(--text-muted);font-style:italic;border:1px dashed color-mix(in srgb,var(--col-ignition) 18%,transparent);border-radius:10px;background:color-mix(in srgb,var(--col-ignition) 4%,transparent);line-height:1.5;}
@media(prefers-reduced-motion:reduce){.entry-card{animation:none;}.entry-card.ignition::after{animation:none;opacity:0;}}
@media(pointer:coarse){.entry-card.ignition::after{animation:none;opacity:.25;}}
/* ── DUAL CARDS ── */
.dual-cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:26px;}
.side-card{padding:20px 22px;}
.side-card-title{font-size:0.92rem;font-weight:700;color:var(--text-primary);margin-bottom:5px;letter-spacing:-.01em;display:flex;align-items:center;gap:9px;}
.side-card-title::before{content:'';width:3px;height:15px;border-radius:2px;background:linear-gradient(180deg,var(--rail),color-mix(in srgb,var(--rail) 35%,transparent));flex:none;}
.side-card.sc-handoff{--rail:var(--col-breakaway);}
.side-card.sc-rerate{--rail:var(--col-quiet);}
.side-card-sub{font-size:0.75rem;color:var(--text-muted);margin-bottom:15px;margin-left:12px;}
/* Handoff empty state */
.empty-state{display:flex;flex-direction:column;align-items:flex-start;padding:4px 0 2px;gap:5px;color:var(--text-muted);}
.empty-label{font-size:0.8rem;font-weight:700;color:var(--text-secondary);}
.empty-sub{font-size:0.73rem;line-height:1.5;}
.closest-list{margin-top:15px;}
.closest-title{font-size:0.64rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:var(--text-dim);margin-bottom:9px;}
.closest-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--hair);font-size:0.78rem;}
.closest-row:last-child{border-bottom:none;}
.closest-ticker{font-weight:700;min-width:118px;color:var(--text-primary);font-size:0.76rem;}
.closest-why{color:var(--text-muted);flex:1;font-size:0.72rem;line-height:1.4;}
/* Rerating card */
.rerating-rows{display:flex;flex-direction:column;gap:7px;}
.rerating-row{display:flex;align-items:center;gap:10px;padding:8px 11px;border-radius:9px;background:var(--tile);border:1px solid var(--hair-strong);font-size:0.78rem;transition:var(--transition);}
.rerating-row:hover{border-color:var(--border-strong);}
.rerating-row.rr-dim{opacity:0.6;}
.rerating-ticker{font-family:var(--num);font-weight:800;min-width:46px;color:var(--text-primary);letter-spacing:-.01em;}
.rerating-stage-chip{padding:2px 7px;border-radius:5px;font-size:0.63rem;font-weight:700;white-space:nowrap;}
.rerating-stage-chip.s-breakaway{background:color-mix(in srgb,var(--col-breakaway) 14%,transparent);color:#4ade80;}
.rerating-stage-chip.s-quiet{background:color-mix(in srgb,var(--col-quiet) 16%,transparent);color:#c4b5fd;}
.rerating-stage-chip.s-suppressed{background:color-mix(in srgb,var(--col-suppressed) 16%,transparent);color:#9ca3af;}
.rerating-stage-chip.s-leadership{background:color-mix(in srgb,var(--col-leading) 16%,transparent);color:#4ade80;}
.rerating-stage-chip.s-crowded{background:color-mix(in srgb,var(--col-crowded) 16%,transparent);color:#fcd34d;}
.rerating-stage-chip.s-none{background:color-mix(in srgb,var(--text-muted) 14%,transparent);color:var(--text-muted);}
.rerating-chips{display:flex;gap:5px;flex:1;flex-wrap:wrap;align-items:center;}
.rerate-chip{padding:2px 8px;border-radius:5px;font-size:0.65rem;font-weight:600;background:color-mix(in srgb,var(--col-breakaway) 13%,transparent);color:#4ade80;border:1px solid color-mix(in srgb,var(--col-breakaway) 24%,transparent);}
.rerate-chip.warn{background:color-mix(in srgb,var(--col-crowded) 12%,transparent);color:#fcd34d;border-color:color-mix(in srgb,var(--col-crowded) 22%,transparent);}
.rr-watching{font-size:0.68rem;color:var(--text-dim);font-style:italic;}
.rr-footer{margin-top:12px;font-size:0.68rem;color:var(--text-dim);line-height:1.45;padding-top:10px;border-top:1px solid var(--hair);}
/* ── FULL BOARD ── */
.full-board-section{margin-bottom:24px;}
.board-toggle{display:flex;align-items:center;gap:8px;padding:12px 18px;cursor:pointer;border-radius:var(--radius-card);border:1px solid var(--border);background:var(--bg-glass-2);transition:var(--transition);user-select:none;justify-content:space-between;}
.board-toggle:hover{border-color:var(--border-strong);}
.board-toggle-left{display:flex;align-items:center;gap:10px;}
.board-toggle-label{font-size:0.82rem;font-weight:600;color:var(--text-primary);}
.board-toggle-sub{font-size:0.73rem;color:var(--text-muted);}
.board-caret{color:var(--text-muted);font-size:0.75rem;transition:transform 0.2s;}
.board-caret.open{transform:rotate(180deg);}
.board-table-wrap{display:none;padding:0 0 6px;overflow-x:auto;border-radius:0 0 var(--radius-card) var(--radius-card);}
.board-table-wrap.open{display:block;}
.board-table{width:100%;border-collapse:collapse;font-size:0.78rem;}
.board-table th{text-align:left;padding:8px 10px;font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-dim);border-bottom:1px solid var(--border);white-space:nowrap;}
.board-table td{padding:7px 10px;border-bottom:1px solid var(--border);vertical-align:middle;}
.board-table tr:hover td{background:rgba(255,255,255,0.025);}
.board-table tr:last-child td{border-bottom:none;}
/* Board group headers */
.board-grp-hd td{background:var(--bg-glass-2);font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-muted);cursor:pointer;user-select:none;}
.board-grp-hd td:hover{background:var(--bg-base);}
.board-grp-body.collapsed{display:none;}
/* Stage pills */
.stage-pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:0.65rem;font-weight:700;white-space:nowrap;}
.stage-pill.QUIET_ACCUMULATION{background:rgba(124,58,237,0.18);color:#c4b5fd;}
.stage-pill.BREAKAWAY{background:rgba(34,197,94,0.15);color:#4ade80;}
.stage-pill.SUPPRESSED{background:rgba(107,114,128,0.15);color:#9ca3af;}
.stage-pill.FAILED{background:rgba(239,68,68,0.12);color:#f87171;}
.stage-pill.CATALYST_WINDOW{background:rgba(59,130,246,0.18);color:#93c5fd;}
.stage-pill.NONE{background:rgba(55,65,81,0.30);color:var(--text-muted);}
.stage-pill.LEADERSHIP{background:rgba(22,163,74,0.18);color:#4ade80;}
.stage-pill.CROWDED{background:rgba(245,158,11,0.18);color:#fcd34d;}
.ticker-link{font-weight:700;font-size:0.85rem;color:var(--text-primary);}
.board-spark{width:48px;height:18px;display:inline-block;vertical-align:middle;}
.leg-chips{display:flex;flex-wrap:wrap;gap:3px;}
.leg-chip{font-size:0.63rem;padding:1px 5px;border-radius:4px;background:rgba(124,58,237,0.12);color:#c4b5fd;}
.leg-chip.green{background:rgba(34,197,94,0.12);color:#4ade80;}
.leg-chip.blue{background:rgba(59,130,246,0.12);color:#93c5fd;}
.leg-chip.gray{background:rgba(107,114,128,0.12);color:#9ca3af;}
/* ── FIELD GUIDE ACCORDION ── */
.guide-section{margin-bottom:24px;}
.guide-wrap{padding:16px 20px;}
.guide-title{font-size:0.88rem;font-weight:700;margin-bottom:4px;color:var(--text-primary);}
.guide-sub{font-size:0.75rem;color:var(--text-muted);margin-bottom:14px;}
.playbook{border:1px solid var(--border);border-radius:10px;overflow:hidden;margin-bottom:8px;}
.pb-hd{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;cursor:pointer;font-weight:600;font-size:0.82rem;user-select:none;color:var(--text-primary);}
.pb-hd:hover{background:var(--bg-glass-2);}
.pb-hd .car{font-size:11px;color:var(--text-muted);transition:transform .2s;}
.pb-hd.open .car{transform:rotate(90deg);}
.pb-bd{display:none;padding:12px 14px;font-size:0.77rem;line-height:1.7;border-top:1px solid var(--border);color:var(--text-secondary);}
.pb-hd.open+.pb-bd{display:block;}
/* ── FOOTER ── */
footer{padding:18px 24px;margin-top:8px;}
.footer-honesty{font-size:0.76rem;color:var(--text-muted);line-height:1.5;}
/* ── POPOVER ── */
.popover-backdrop{display:none;position:fixed;inset:0;background:rgba(3,6,10,0.55);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);z-index:1000;align-items:center;justify-content:center;}
.popover-backdrop.open{display:flex;}
.popover-box{background:var(--mx5-glass-bg);border:1px solid var(--mx5-glass-border);border-radius:16px;padding:22px 24px;max-width:420px;width:90%;box-shadow:var(--mx5-glass-shadow);-webkit-backdrop-filter:blur(28px) saturate(1.4);backdrop-filter:blur(28px) saturate(1.4);}
.popover-title{font-size:0.9rem;font-weight:700;margin-bottom:6px;color:var(--text-primary);}
.popover-body{font-size:0.78rem;color:var(--text-secondary);line-height:1.55;}
.popover-body p{margin:0 0 8px;}
.popover-body p:last-child{margin-bottom:0;}
.popover-close{float:right;border:none;background:none;color:var(--text-muted);cursor:pointer;font-size:1rem;line-height:1;padding:0 0 4px 8px;}
.receipt-chip-list{display:flex;flex-wrap:wrap;gap:5px;margin:6px 0;}
.receipt-chip{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:5px;font-size:0.72rem;font-weight:600;}
.receipt-chip.on{background:rgba(124,58,237,0.18);color:#c4b5fd;}
.receipt-chip.on.ignition{background:rgba(59,130,246,0.18);color:#93c5fd;}
.receipt-chip.on.suppressed{background:rgba(107,114,128,0.18);color:#9ca3af;}
.receipt-chip.null{background:rgba(255,255,255,0.04);color:var(--text-muted);border:1px solid var(--border);opacity:0.7;font-style:italic;}
.receipt-machine-state{font-size:0.68rem;color:var(--text-dim);font-family:'SF Mono',monospace;padding:4px 8px;background:rgba(255,255,255,0.03);border-radius:5px;margin-top:8px;}
.receipt-seeding-note{font-size:0.7rem;color:var(--text-muted);margin-top:8px;padding:6px 8px;background:rgba(255,200,0,0.07);border:1px solid rgba(255,200,0,0.14);border-radius:6px;}
.receipt-context-line{font-size:0.72rem;color:var(--text-secondary);margin-top:4px;padding:2px 8px;}
/* ── RESPONSIVE ── */
@media(max-width:900px){
  .lane-grid{grid-template-columns:1fr;}
  .dual-cards{grid-template-columns:1fr;}
  .page-wrap{padding:14px 14px 36px;}
  .lr-verdict{font-size:36px;}
}
@media(max-width:390px){
  .lr-verdict{font-size:31px;}
  .entry-card{padding:11px 12px;}
  .card-ticker{font-size:1.1rem;}
  .move-card{padding:8px 11px;}
}
/* ── 红涨绿跌: directional colour flips for Chinese mode ── */
html[data-lang="zh"] { --col-breakaway:#ef4444; --col-leading:#dc2626; --col-failed:#22c55e; --glow-breakaway:rgba(239,68,68,0.15); --glow-failed:rgba(34,197,94,0.10); }
html[data-lang="zh"][data-theme="light"] { --col-breakaway:#dc2626; --col-leading:#b91c1c; --col-failed:#16a34a; }
/* Sparkline strokes */
html[data-lang="zh"] .spark-path.up{stroke:#f87171;}
html[data-lang="zh"] .spark-path.down{stroke:#4ade80;}
/* Stage pills — BREAKAWAY (bullish) and FAILED (bearish) */
html[data-lang="zh"] .stage-pill.BREAKAWAY{background:rgba(239,68,68,0.15);color:#f87171;}
html[data-lang="zh"] .stage-pill.FAILED{background:rgba(34,197,94,0.12);color:#4ade80;}
html[data-lang="zh"] .stage-pill.LEADERSHIP{background:rgba(220,38,38,0.18);color:#f87171;}
/* Rerating stage chip */
html[data-lang="zh"] .rerating-stage-chip.s-breakaway{background:rgba(239,68,68,0.12);color:#f87171;}
/* Leg chip green (breakaway context) */
html[data-lang="zh"] .leg-chip.green{background:rgba(239,68,68,0.12);color:#f87171;}
</style>
</head>
<body class="{% if regime.label == 'narrow_leadership' %}rg-narrow{% elif regime.label == 'broad_thrust' %}rg-broad{% else %}rg-mixed{% endif %}">
{% include "_site_nav.html.j2" %}

{# ── Coverage popover ── #}
<div class="popover-backdrop" id="coverage-popover" onclick="closePopover('coverage-popover')">
  <div class="popover-box" onclick="event.stopPropagation()">
    <button class="popover-close" onclick="closePopover('coverage-popover')">&#x2715;</button>
    <div class="popover-title">
      {{ t('Coverage receipt', '覆盖情况说明') }}
    </div>
    <div class="popover-body">
      {% set n_univ = cov.n_universe if cov.n_universe is defined and cov.n_universe is not none else '—' %}
      {% set rev_unc = cov.revisions_uncovered if cov.revisions_uncovered is defined and cov.revisions_uncovered is not none else [] %}
      <p><strong>{{ t('Universe:', '样本：') }}</strong> {{ n_univ }} {{ t('names tracked', '个标的追踪中') }}</p>
      <p><strong>{{ t('Price data:', '价格数据：') }}</strong> {{ n_univ }} / {{ n_univ }} {{ t('covered', '已覆盖') }}</p>
      {% if rev_unc | length > 0 %}
      <p><strong>{{ t('Revision data:', '预测修订数据：') }}</strong>
        {% if cov.n_universe is defined and cov.n_universe is not none %}{{ cov.n_universe - rev_unc|length }}{% else %}—{% endif %} / {{ n_univ }} —
        {{ rev_unc | length }} {{ t('names lack analyst coverage and receive no revision signals.', '个标的缺少分析师覆盖，不含预测修订信号。') }}
      </p>
      {% else %}
      <p><strong>{{ t('Revision data:', '预测修订数据：') }}</strong> {{ t('All names covered.', '全部标的已覆盖。') }}</p>
      {% endif %}
      {% if cov.analyst_covered is defined and cov.analyst_covered is not none %}
      {% set ana_unc = cov.analyst_uncovered if cov.analyst_uncovered is defined and cov.analyst_uncovered is not none else [] %}
      {% if cov.analyst_covered > 0 %}
      <p><strong>{{ t('Analyst rating data:', '分析师评级数据：') }}</strong> {{ cov.analyst_covered }} / {{ n_univ }} {{ t('covered', '已覆盖') }}{% if ana_unc | length > 0 %} — {{ ana_unc | length }} {{ t('without', '个缺少') }}{% endif %} <span class="young-tag">{{ t('young data', '数据较新') }}</span></p>
      {% else %}
      <p><strong>{{ t('Analyst rating data:', '分析师评级数据：') }}</strong> {{ t('unavailable — the crowding signal that reads it stays blank.', '不可用 — 依赖它的拥挤信号留空。') }}</p>
      {% endif %}
      {% endif %}
      {% if cov.tape_note is defined and cov.tape_note is not none %}
      <p>{{ cov.tape_note }}</p>
      {% endif %}
      <p><strong>{{ t('Machine state', '机器状态') }}</strong> {{ t('labels appear only in receipts and the field guide. Glance tier uses plain English only.', '标签仅出现在说明弹窗和字段指南中。概览层仅使用通俗语言。') }}</p>
      {% if rows and rows[0].days_in_state is defined and rows[0].days_in_state == 1 %}
      <p><em>{{ t('Days-in-stage reads 1 everywhere — state store accumulates nightly from here.', '各阶段天数均显示1 — 状态存储从此次起每晚累计。') }}</em></p>
      {% endif %}
    </div>
  </div>
</div>

{# ── Regime detail popover ── #}
<div class="popover-backdrop" id="regime-popover" onclick="closePopover('regime-popover')">
  <div class="popover-box" onclick="event.stopPropagation()">
    <button class="popover-close" onclick="closePopover('regime-popover')">&#x2715;</button>
    <div class="popover-title">
      {{ t('What does the market regime mean?', '"市场制度"是什么意思？') }}
    </div>
    <div class="popover-body">
      <p>{{ t("The market's internal structure is checked across breadth conditions: what share of stocks are above their 200-day average, how correlated they are, whether leadership is concentrated in a few mega-caps, and whether a rare breadth thrust event fired.", '市场内部结构通过多项广度条件检验：多少股票站在200日均线以上、相关性高低、领涨是否集中于少数超大盘股，以及是否触发罕见的广度冲击事件。') }}</p>
      {% set rc = regime.chips if regime.chips is defined and regime.chips is not none else {} %}
      {% if rc.zweig_thrust is defined and rc.zweig_thrust %}
      <p>
        {{ t('Breadth surges are rare — 8 times since 2020 in our data. The stage machine weights breakout setups more heavily during broad advances.', '广度冲击罕见——2020年以来数据中仅8次。在普涨行情中，状态机对突破布局赋予更高权重。') }}
      </p>
      {% endif %}
      {% set _pop_rl = regime.label if regime.label is defined else '' %}
      {% if _pop_rl != 'broad_thrust' %}
      <p>
        {% if _pop_rl == 'narrow_leadership' %}
        <span class="l-en">A few names carry the tape while breadth lags</span><span class="l-zh">少数个股主导，市场宽度偏弱</span>
        {% else %}
        <span class="l-en">Breadth and dispersion mixed — no clear regime</span><span class="l-zh">宽度与分散度交织——无明确格局</span>
        {% endif %}
      </p>
      {% endif %}
      <p><strong>{{ t('Machine label:', '机器标签：') }}</strong> <code>{{ regime.label if regime.label is defined else '—' }}</code> · {{ t('display only', '仅供展示') }}</p>
      {% set _bun = regime.breadth_universe_n if regime.breadth_universe_n is defined and regime.breadth_universe_n is not none else none %}
      {% set _dun = regime.desk_universe_n if regime.desk_universe_n is defined and regime.desk_universe_n is not none else none %}
      {% if _bun is not none and _dun is not none %}
      <p style="font-size:0.8em;color:var(--text-secondary);">
        {{ t('Breadth legs read the broad market (' + (_bun|string) + ' names); this desk tracks ' + (_dun|string) + '.', '广度指标取自大盘（' + (_bun|string) + '只）；本雷达追踪' + (_dun|string) + '只。') }}
      </p>
      {% endif %}
      {% set _tw = regime.top5_weighting if regime.top5_weighting is defined and regime.top5_weighting is not none else none %}
      {% set _mn = regime.mktcap_n_covered if regime.mktcap_n_covered is defined and regime.mktcap_n_covered is not none else 0 %}
      {% if _tw is not none and _tw != 'cap' %}
      <p style="font-size:0.8em;color:var(--text-secondary);">
        {{ t('Mega-cap weighting unavailable — equal-weighted fallback (' + (_mn|string) + ' caps found).', '市值加权不可用——等权回退（' + (_mn|string) + '只有市值数据）。') }}
      </p>
      {% endif %}
    </div>
  </div>
</div>

{# ── Card receipt popover (single shared, filled by JS) ── #}
<div class="popover-backdrop" id="card-popover" onclick="closePopover('card-popover')">
  <div class="popover-box" onclick="event.stopPropagation()">
    <button class="popover-close" onclick="closePopover('card-popover')">&#x2715;</button>
    <div class="popover-title" id="card-popover-title"></div>
    <div class="popover-body" id="card-popover-body"></div>
  </div>
</div>

<div class="page-wrap">

{# ── Stale banner ── #}
{% if lr.stale is defined and lr.stale %}
<div class="banner banner-stale">
  {{ t('Price store is stale — data may lag by more than 2 sessions. State classification frozen.', '价格存储数据陈旧 — 可能落后超过2个交易日，状态分类已冻结。') }}
</div>
{% endif %}

{# ── Degraded banner (amber) — data health issues ── #}
{% set _degraded = lr.degraded if lr.degraded is defined and lr.degraded is not none else [] %}
{% set _degraded_zh = lr.degraded_zh if lr.degraded_zh is defined and lr.degraded_zh is not none else [] %}
{% if _degraded | length > 0 %}
<div class="banner banner-degraded">
  <span class="l-en"><strong>Data health:</strong> {{ _degraded | join(' · ') }}</span>
  <span class="l-zh"><strong>数据状态：</strong>{{ (_degraded_zh if _degraded_zh | length > 0 else _degraded) | join(' · ') }}</span>
</div>
{% endif %}

{# ══════════════ HERO ══════════════ #}
{% set _rl = regime.label if regime.label is defined and regime.label is not none else 'mixed' %}
{% set _rchips = regime.chips if regime.chips is defined and regime.chips is not none else {} %}
{% set _disp_edge = (_rchips.dispersion_high is defined and _rchips.dispersion_high) and (_rchips.corr_low is defined and _rchips.corr_low) %}
{% set _brd = regime.adv_share_10d if regime.adv_share_10d is defined and regime.adv_share_10d is not none else none %}
{% set n_lead = ns.cnt_breakaway + ns.cnt_leadership %}
<section class="lr-hero glass">
  <div class="lr-hero-read">
    <div class="lr-eyebrow">{{ t('Leader Radar', '领袖雷达') }} · {{ t('Early-entry desk', '早入场台') }}</div>
    <div class="lr-verdict-row">
      <span class="lr-verdict {% if _rl == 'broad_thrust' %}r-broad{% elif _rl == 'narrow_leadership' %}r-narrow{% else %}r-mixed{% endif %}">
        {% if _rl == 'broad_thrust' %}{{ t('Broad advance', '普涨行情') }}
        {% elif _rl == 'narrow_leadership' %}{{ t('Narrow leadership', '少数领涨') }}
        {% else %}{{ t('Mixed tape', '多空交织') }}{% endif %}
      </span>
    </div>
    <div class="lr-stance">
      {% if _rl == 'broad_thrust' %}
        <span class="lr-stance-dot" style="color:var(--col-breakaway);"></span>{{ t('Broad tape — leadership is diffuse', '普涨——领涨分散') }}
      {% elif _rl == 'narrow_leadership' %}
        <span class="lr-stance-dot" style="color:var(--col-crowded);"></span>{{ t('Get ready — track the staged few', '做好准备——盯紧已就位的少数') }}
      {% elif _disp_edge %}
        <span class="lr-stance-dot" style="color:var(--col-ignition);"></span>{{ t("Selection pays — a stock-picker's tape", '选股为王——个股行情') }}
      {% else %}
        <span class="lr-stance-dot" style="color:var(--text-muted);"></span>{{ t("Watch — don't chase", '观察——勿追高') }}
      {% endif %}
    </div>
    <div class="lr-says">{{ t('Stocks staged before the crowd arrives — this desk describes stages and prints its evidence. Observation, not prediction.', '在人群涌入前已布局的股票——本台只描述阶段并列出证据。观察，非预测。') }}</div>

    {# ── breadth arc-gauge + regime evidence ── #}
    <div class="lr-gauge-wrap">
      {% if _brd is not none %}
        {% set _gv = (_brd * 100) %}
        {% set _gf_raw = ((_gv - 30) / 40) %}
        {% set _gf = 0 if _gf_raw < 0 else (1 if _gf_raw > 1 else _gf_raw) %}
        {% set _grot = ((_gf - 0.5) * 180) %}
      <div class="lr-gauge">
        <svg viewBox="0 0 156 96" aria-hidden="true">
          <defs>
            <linearGradient id="lrGaugeGrad" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" class="lr-br-g0"/>
              <stop offset="42%" class="lr-br-gm"/>
              <stop offset="60%" class="lr-br-gm"/>
              <stop offset="100%" class="lr-br-g1"/>
            </linearGradient>
          </defs>
          {# faint base, then the red→green scale arc drawn over it #}
          <path class="lr-br-track" d="M 14 82 A 64 64 0 0 1 142 82"/>
          <path class="lr-br-scale" d="M 14 82 A 64 64 0 0 1 142 82" stroke="url(#lrGaugeGrad)" pathLength="100"/>
          {# regime gates: 40% (narrows below) at rot −45°, 61% (broad thrust) at rot +49.5° #}
          <g transform="rotate(-45 78 82)"><line class="lr-br-tick" x1="78" y1="11" x2="78" y2="25"/></g>
          <g transform="rotate(49.5 78 82)"><line class="lr-br-tick" x1="78" y1="11" x2="78" y2="25"/></g>
          {# value marker riding the arc (rotation is a static, server-computed transform) #}
          <g transform="rotate({{ '%.1f'|format(_grot) }} 78 82)">
            <circle class="lr-br-halo" cx="78" cy="18" r="8.5"/>
            <circle class="lr-br-core" cx="78" cy="18" r="4.5"/>
          </g>
        </svg>
        <div class="lr-gauge-val">
          <div class="lr-gauge-num">{{ '%.0f'|format(_gv) }}</div>
          <div class="lr-gauge-cap">{{ t('10-day breadth', '10日广度') }}</div>
        </div>
      </div>
      <div class="lr-gauge-side">
        <div class="lr-gs-line">
          {% if _disp_edge %}{{ t('Dispersion <b>high</b>, correlation <b>low</b> — names move on their own.', '分散度<b>高</b>、相关性<b>低</b>——个股各行其道。') }}
          {% elif _rl == 'narrow_leadership' %}{{ t('A few names carry the tape while breadth lags.', '少数个股主导，市场宽度偏弱。') }}
          {% elif _rl == 'broad_thrust' %}{{ t('Broad participation — most names rising together.', '普遍参与——多数个股同步上行。') }}
          {% else %}{{ t('Breadth and dispersion mixed — no clear regime.', '宽度与分散度交织——格局未明。') }}{% endif %}
        </div>
      </div>
      {% else %}
      <div class="lr-gauge-side"><div class="lr-gs-line">{{ t('Breadth data unavailable tonight.', '今夜广度数据不可用。') }}</div></div>
      {% endif %}
    </div>

    {# what would flip it #}
    <div class="lr-flip">
      <span class="lr-flip-ar">→</span>
      <span>
      {% if _rl == 'narrow_leadership' %}{{ t('Broadens on a breadth thrust — 10-day advance share pushing over 61%.', '若广度冲击——10日上涨占比升破61%，则转为普涨。') }}
      {% elif _rl == 'broad_thrust' %}{{ t('Fades to mixed if participation rolls back under 61%.', '若参与度回落至61%以下，则转为交织。') }}
      {% else %}{{ t('Narrows if breadth holds under 40% · broadens on a thrust over 61%.', '若广度维持40%以下则收窄 · 若升破61%则转普涨。') }}{% endif %}
      </span>
    </div>

    {# count chips #}
    <div class="lr-counts">
      <span class="lr-count"><span class="lr-cdot" style="background:var(--col-quiet);"></span><b class="num">{{ ns.cnt_quiet }}</b> {{ t('quietly building', '静默筑底') }}</span>
      <span class="lr-count"><span class="lr-cdot" style="background:var(--col-ignition);"></span><b class="num">{{ ns.cnt_catalyst }}</b> {{ t('in ignition', '点火中') }}</span>
      <span class="lr-count"><span class="lr-cdot" style="background:var(--col-breakaway);"></span><b class="num">{{ n_lead }}</b> {{ t('leading', '领涨中') }}</span>
    </div>

    {# ── freshness / coverage meta ── #}
    <div class="header-meta" style="margin-top:2px;">
      {% set n_univ = cov.n_universe if cov.n_universe is defined and cov.n_universe is not none else 0 %}
      {% if n_univ %}
      <span>{{ n_univ }} {{ t('names tracked', '个标的追踪中') }}</span>
      <span class="dot"></span>
      {% endif %}
      {% set rev_unc = cov.revisions_uncovered if cov.revisions_uncovered is defined and cov.revisions_uncovered is not none else [] %}
      {% if n_univ and rev_unc | length < n_univ %}
      <span>{{ n_univ - rev_unc|length }} {{ t('with revision data', '有预测修订数据') }}</span>
      <span class="dot"></span>
      {% endif %}
      {# ── Freshness token (replaces bare "As of" stamp — ONE as-of per panel per doctrine Law 4) ── #}
      {% set _freshness = lr.freshness if lr.freshness is defined and lr.freshness is not none else {} %}
      {% set _pt = _freshness.price_through if _freshness.price_through is defined and _freshness.price_through is not none else (lr.as_of[:10] if lr.as_of is defined and lr.as_of is not none else none) %}
      {% if _pt %}
        {# Format price_through as "Jul 15" / "7月15日" #}
        {% set _pt_parts = _pt.split('-') %}
        {% set _mon_map_en = {'01':'Jan','02':'Feb','03':'Mar','04':'Apr','05':'May','06':'Jun','07':'Jul','08':'Aug','09':'Sep','10':'Oct','11':'Nov','12':'Dec'} %}
        {% set _mon_en = _mon_map_en[_pt_parts[1]] if _pt_parts|length >= 3 and _pt_parts[1] in _mon_map_en else (_pt_parts[1] if _pt_parts|length >= 2 else _pt) %}
        {% set _day_en = _pt_parts[2] | int if _pt_parts|length >= 3 else 0 %}
        {% set _mon_zh = _pt_parts[1] | int if _pt_parts|length >= 2 else 0 %}
        {% set _day_zh = _pt_parts[2] | int if _pt_parts|length >= 3 else 0 %}
      <span>{{ t('Data through ' + _mon_en + ' ' + (_day_en | string) + ' close · updates nightly', '数据截至' + (_mon_zh | string) + '月' + (_day_zh | string) + '日收盘 · 每晚更新') }}</span>
      {% endif %}
      {# Tracking honesty line — only when history_since is set #}
      {% if lr.history_since is defined and lr.history_since is not none %}
        {% set _hs = lr.history_since %}
        {% set _hs_parts = _hs.split('-') %}
        {% set _hs_mon_en = _mon_map_en[_hs_parts[1]] if _hs_parts|length >= 3 and _hs_parts[1] in _mon_map_en else (_hs_parts[1] if _hs_parts|length >= 2 else _hs) %}
        {% set _hs_day_en = _hs_parts[2] | int if _hs_parts|length >= 3 else 0 %}
        {% set _hs_mon_zh = _hs_parts[1] | int if _hs_parts|length >= 2 else 0 %}
        {% set _hs_day_zh = _hs_parts[2] | int if _hs_parts|length >= 3 else 0 %}
        {% set _gaps = lr.history_gaps if lr.history_gaps is defined and lr.history_gaps is not none else [] %}
        <span class="dot"></span>
        <span>
          {{ t('State tracking since ' + _hs_mon_en + ' ' + (_hs_day_en | string), '状态追踪自' + (_hs_mon_zh | string) + '月' + (_hs_day_zh | string) + '日起') }}{% if _gaps | length > 0 %} · {{ t(_gaps|length|string + '-session gap', '缺口' + (_gaps|length|string) + '个交易日') }}{% endif %}
        </span>
      {% endif %}
      <span class="q-afford" onclick="openPopover('coverage-popover')" data-tip-en="Coverage receipt" data-tip-zh="覆盖情况说明">?</span>
    </div>
  </div>
  {# ── lifecycle funnel (hero right) ── #}
  <div class="lr-funnel">
    <div class="lr-funnel-hd">
      <span class="lr-funnel-title">{{ t('The lifecycle', '生命周期') }}</span>
      <span class="lr-funnel-sub">{{ t('where the universe sits tonight', '今夜全样本分布') }}</span>
      <span class="q-afford" style="margin-left:auto;" onclick="openPopover('regime-popover')" data-tip-en="What does this mean?" data-tip-zh="这是什么意思？">?</span>
    </div>
    <div class="lr-flow">
      <div class="lr-fstage {% if ns.cnt_suppressed == 0 %}is-empty{% endif %}" style="animation-delay:.04s;">
        <div class="lr-fs-top"><span class="lr-fs-dot" style="background:var(--col-suppressed);"></span><span class="lr-fs-name">{{ t('Left for dead','无人问津') }}</span></div>
        <div class="lr-fs-count num" style="color:var(--col-suppressed);">{{ ns.cnt_suppressed }}</div>
        <div class="lr-fs-stance">{{ t('First stirrings','初现异动') }}</div>
        <span class="lr-fs-arrow">›</span>
      </div>
      <div class="lr-fstage {% if ns.cnt_quiet == 0 %}is-empty{% endif %}" style="animation-delay:.10s;">
        <div class="lr-fs-top"><span class="lr-fs-dot" style="background:var(--col-quiet);"></span><span class="lr-fs-name">{{ t('Quiet build','静默筑底') }}</span></div>
        <div class="lr-fs-count num" style="color:#a78bfa;">{{ ns.cnt_quiet }}</div>
        <div class="lr-fs-stance">{{ t("Watch — don't chase",'观察勿追') }}</div>
        <span class="lr-fs-arrow">›</span>
      </div>
      <div class="lr-fstage {% if ns.cnt_catalyst == 0 %}is-empty{% endif %}" style="animation-delay:.16s;">
        <div class="lr-fs-top"><span class="lr-fs-dot" style="background:var(--col-ignition);"></span><span class="lr-fs-name">{{ t('Ignition','点火窗口') }}</span></div>
        <div class="lr-fs-count num" style="color:#93c5fd;">{{ ns.cnt_catalyst }}</div>
        <div class="lr-fs-stance">{{ t('Get ready','做好准备') }}</div>
        <span class="lr-fs-arrow">›</span>
      </div>
      <div class="lr-fstage {% if ns.cnt_breakaway == 0 %}is-empty{% endif %}" style="animation-delay:.22s;">
        <div class="lr-fs-top"><span class="lr-fs-dot" style="background:var(--col-breakaway);"></span><span class="lr-fs-name">{{ t('Breaking','突破启动') }}</span></div>
        <div class="lr-fs-count num" style="color:var(--col-breakaway);">{{ ns.cnt_breakaway }}</div>
        <div class="lr-fs-stance">{{ t('In motion','运行中') }}</div>
        <span class="lr-fs-arrow">›</span>
      </div>
      <div class="lr-fstage {% if ns.cnt_leadership == 0 %}is-empty{% endif %}" style="animation-delay:.28s;">
        <div class="lr-fs-top"><span class="lr-fs-dot" style="background:var(--col-leading);"></span><span class="lr-fs-name">{{ t('Leading','领涨中') }}</span></div>
        <div class="lr-fs-count num" style="color:var(--col-leading);">{{ ns.cnt_leadership }}</div>
        <div class="lr-fs-stance">{{ t('In favour','受青睐') }}</div>
        <span class="lr-fs-arrow">›</span>
      </div>
      <div class="lr-fstage {% if ns.cnt_crowded == 0 %}is-empty{% endif %}" style="animation-delay:.34s;">
        <div class="lr-fs-top"><span class="lr-fs-dot" style="background:var(--col-crowded);"></span><span class="lr-fs-name">{{ t('Crowded','过度拥挤') }}</span></div>
        <div class="lr-fs-count num" style="color:#fcd34d;">{{ ns.cnt_crowded }}</div>
        <div class="lr-fs-stance">{{ t('Protect gains','保护盈利') }}</div>
      </div>
    </div>
    {# ── universe distribution bar ── #}
    {% set _u_dormant = ns.cnt_none + ns.cnt_failed %}
    {% set _u_building = ns.cnt_suppressed + ns.cnt_quiet %}
    {% set _u_live = ns.cnt_catalyst + ns.cnt_breakaway + ns.cnt_leadership %}
    {% set _u_tot = _u_dormant + _u_building + _u_live + ns.cnt_crowded %}
    {% if _u_tot > 0 %}
    <div class="lr-dist" aria-hidden="true">
      <span class="lr-dist-seg" style="width:{{ '%.1f'|format(100*_u_dormant/_u_tot) }}%;background:var(--text-dim);animation-delay:.02s;"></span>
      <span class="lr-dist-seg" style="width:{{ '%.1f'|format(100*_u_building/_u_tot) }}%;background:var(--col-quiet);animation-delay:.08s;"></span>
      <span class="lr-dist-seg" style="width:{{ '%.1f'|format(100*_u_live/_u_tot) }}%;background:var(--col-breakaway);animation-delay:.14s;"></span>
      {% if ns.cnt_crowded > 0 %}<span class="lr-dist-seg" style="width:{{ '%.1f'|format(100*ns.cnt_crowded/_u_tot) }}%;background:var(--col-crowded);animation-delay:.2s;"></span>{% endif %}
    </div>
    <div class="lr-dist-key">
      <span><span class="lr-dk-dot" style="background:var(--text-dim);"></span>{{ t('Dormant','沉寂') }} <span class="num">{{ _u_dormant }}</span></span>
      <span><span class="lr-dk-dot" style="background:var(--col-quiet);"></span>{{ t('Building','筑底') }} <span class="num">{{ _u_building }}</span></span>
      <span><span class="lr-dk-dot" style="background:var(--col-breakaway);"></span>{{ t('Live','活跃') }} <span class="num">{{ _u_live }}</span></span>
    </div>
    {% endif %}
    <div class="lr-funnel-foot">
      <span class="lr-ff-item failed"><b class="num">{{ ns.cnt_failed }}</b> {{ t('failed breaks','突破失败') }}</span>
      <span class="lr-ff-sep"></span>
      <span class="lr-ff-item"><b class="num">{{ ns.cnt_none }}</b> {{ t('no signal','无信号') }}</span>
      {% if ns.failed_rows | length > 0 %}
      <span class="lr-ff-chips">
        {% for r in ns.failed_rows[:8] %}<a class="lr-ff-chip" href="us_stocks.html#{{ r.ticker }}">{{ r.ticker }}</a>{% endfor %}
        {% if ns.failed_rows | length > 8 %}<span class="lr-ff-chip" style="background:none;color:var(--text-dim);">+{{ ns.failed_rows | length - 8 }}</span>{% endif %}
      </span>
      {% endif %}
    </div>
  </div>
</section>

{# ── CHANGED TONIGHT strip ── #}
{% set _ct = lr.changed_today if lr.changed_today is defined and lr.changed_today is not none else {} %}
{% set _ct_entered = _ct.entered if _ct.entered is defined and _ct.entered is not none else [] %}
{% set _ct_exited = _ct.exited if _ct.exited is defined and _ct.exited is not none else [] %}
{% set _ct_fired = _ct.fired if _ct.fired is defined and _ct.fired is not none else [] %}
{% set _ct_total = _ct_entered|length + _ct_exited|length + _ct_fired|length %}
{# Plain-word state names map for changed-tonight display #}
{% set _STATE_PLAIN_EN = {
  'CATALYST_WINDOW': 'Ignition window',
  'QUIET_ACCUMULATION': 'Quiet build',
  'SUPPRESSED': 'Left for dead',
  'BREAKAWAY': 'Breaking away',
  'LEADERSHIP': 'Leading',
  'CROWDED': 'Crowded',
  'FAILED': 'Failed break',
  'NONE': 'No signal',
} %}
{% set _STATE_PLAIN_ZH = {
  'CATALYST_WINDOW': '点火窗口',
  'QUIET_ACCUMULATION': '静默筑底',
  'SUPPRESSED': '无人问津',
  'BREAKAWAY': '突破启动',
  'LEADERSHIP': '领涨中',
  'CROWDED': '过度拥挤',
  'FAILED': '突破失败',
  'NONE': '无信号',
} %}
{# ══════════════ TONIGHT'S FOCUS — stance shelves (LRV-O9) ══════════════ #}
{# Every overnight move is graded by its entry_read verdict (engine display layer):
   clean staged names lead; extended movers are flagged "don't chase", not celebrated;
   downtrend build-attempts are labeled for what they are. #}
{% set _RANK = {'NONE':0,'FAILED':0,'SUPPRESSED':1,'QUIET_ACCUMULATION':2,'CATALYST_WINDOW':3,'BREAKAWAY':4,'LEADERSHIP':5,'CROWDED':4} %}
{% set _STATE_COL = {'CATALYST_WINDOW':'var(--col-ignition)','QUIET_ACCUMULATION':'var(--col-quiet)','BREAKAWAY':'var(--col-breakaway)','LEADERSHIP':'var(--col-leading)','SUPPRESSED':'var(--col-suppressed)','CROWDED':'var(--col-crowded)'} %}
{% set _fired_tkrs = _ct_fired | map(attribute='ticker') | list %}
{# Bucket by entry_read.key; items with no entry_read (older payloads) fall back to the clean shelf. #}
{% set nsf = namespace(look=[], late=[], turn=[], cooled=[], crowded=[]) %}
{% for item in _ct_fired %}
  {% set _ek = item.entry_read.key if item.entry_read is defined and item.entry_read is not none and item.entry_read.key is defined else 'staged' %}
  {% set _it = {'ticker': item.ticker, 'state': item.state if item.state is defined and item.state is not none else 'CATALYST_WINDOW', 'prev_state': none, 'entry_read': item.entry_read if item.entry_read is defined else none, 'fired': true} %}
  {% if _ek == 'extended' %}{% set nsf.late = nsf.late + [_it] %}
  {% elif _ek == 'turnaround_watch' %}{% set nsf.turn = nsf.turn + [_it] %}
  {% else %}{% set nsf.look = nsf.look + [_it] %}{% endif %}
{% endfor %}
{% for item in _ct_entered %}
  {% set _nr = _RANK[item.state] if item.state in _RANK else 0 %}
  {% set _pr = _RANK[item.prev_state] if (item.prev_state is not none and item.prev_state in _RANK) else -1 %}
  {% if item.ticker in _fired_tkrs %}
    {# fire card already covers this name — skip to avoid a duplicate row #}
  {% elif item.state == 'CROWDED' %}
    {% set nsf.crowded = nsf.crowded + [item] %}
  {% elif item.state in ('NONE','FAILED') or _nr < _pr %}
    {% set nsf.cooled = nsf.cooled + [item] %}
  {% else %}
    {% set _ek = item.entry_read.key if item.entry_read is defined and item.entry_read is not none and item.entry_read.key is defined else 'staged' %}
    {% set _it = {'ticker': item.ticker, 'state': item.state, 'prev_state': item.prev_state, 'entry_read': item.entry_read if item.entry_read is defined else none, 'fired': false} %}
    {% if _ek == 'extended' %}{% set nsf.late = nsf.late + [_it] %}
    {% elif _ek == 'turnaround_watch' %}{% set nsf.turn = nsf.turn + [_it] %}
    {% else %}{% set nsf.look = nsf.look + [_it] %}{% endif %}
  {% endif %}
{% endfor %}
{% set _nt = lr.near_trigger if lr.near_trigger is defined and lr.near_trigger is not none else [] %}
{% set _n_focus = nsf.look|length + nsf.late|length + nsf.turn|length + nsf.crowded|length %}
{# Shared card macros for the three shelves #}
{% macro _mv_from(item) -%}
  {% if item.prev_state is not none and item.prev_state and item.prev_state not in ('NONE','') %}<span class="move-from"><span class="l-en">from {{ _STATE_PLAIN_EN[item.prev_state] if item.prev_state in _STATE_PLAIN_EN else item.prev_state }}</span><span class="l-zh">来自{{ _STATE_PLAIN_ZH[item.prev_state] if item.prev_state in _STATE_PLAIN_ZH else item.prev_state }}</span></span>{% endif %}
{%- endmacro %}
{% macro _mv_ext(item) -%}
  {%- set _er = item.entry_read if item.entry_read is defined and item.entry_read is not none else {} -%}
  {%- set _ep = _er.extension_pct_50d if _er.extension_pct_50d is defined and _er.extension_pct_50d is not none else none -%}
  {%- set _cv = _er.caveats if _er.caveats is defined and _er.caveats is not none else [] -%}
  {%- set _bs = _er.basis if _er.basis is defined and _er.basis is not none else [] -%}
  <span class="move-read">{% if 'extension_extreme' in _bs and _ep is not none and _ep > 0 %}<b>+{{ _ep | round | int }}%</b> {{ t('vs 50-day', '对50日线') }}{% elif 'monthly_rsi_80' in _bs %}{{ t('overheated on the monthly chart', '月线级别已过热') }}{% else %}{{ t('stretched for this name', '相对自身历史已过热') }}{% endif %}{% if 'earnings_window' in _cv %} · {{ t('earnings window', '财报窗口') }}{% endif %}</span>
{%- endmacro %}
{% macro _mv_turn(item) -%}
  {%- set _er = item.entry_read if item.entry_read is defined and item.entry_read is not none else {} -%}
  {%- set _bs = _er.basis if _er.basis is defined and _er.basis is not none else [] -%}
  <span class="move-read">{% if 'below_200dma_12m' in _bs %}{{ t('below its 200-day for a year', '低于200日线已一年') }}{% else %}{{ t('still in a deep drawdown', '仍处深度回撤') }}{% endif %}</span>
{%- endmacro %}
{# OEU M-PRO — options caveats from entry_read().caveats, plain words only. This is
   CONTEXT hanging off the verdict, never the verdict: the stance above it is set by
   the same chips it always was. Renders nothing for names without options coverage. #}
{% macro _opt_cav(er) -%}
  {%- set _cv = er.caveats if (er is defined and er is not none and er.caveats is defined and er.caveats is not none) else [] -%}
  {%- if 'gex_pin_risk' in _cv or 'iv_rank_elevated' in _cv -%}
  <div class="entry-flag opt">{% if 'gex_pin_risk' in _cv %}{{ t('Options ceiling just above — price tends to stall there', '上方紧邻期权天花板——价格倾向在此停滞') }}{% endif %}{% if 'gex_pin_risk' in _cv and 'iv_rank_elevated' in _cv %} · {% endif %}{% if 'iv_rank_elevated' in _cv %}{{ t('Options pricing a bigger move than usual', '期权定价高于平常的波动') }}{% endif %}</div>
  {%- endif -%}
{%- endmacro %}
<section class="tonight-section">
  <div class="section-header">
    <span class="section-title">{{ t("Tonight's focus", '今夜焦点') }}</span>
    <span class="q-afford" style="margin-left:6px;" data-tip-en="Overnight state changes and fires, graded by entry quality from the same evidence chips shown on each card: names still below a year-long 200-day downtrend read 'turnaround attempt'; names stretched vs their 50-day (or flashing other exit-side markers) read 'don't chase'. Context, not signals — not a buy list." data-tip-zh="隔夜状态变化与触发，按入场质量分级（依据卡片上的证据）：仍处于一年以上200日均线下行趋势的标的标注「反转尝试」；相对50日均线过度拉伸（或出现其他出场端信号）的标的标注「勿追」。仅供参考，非买入清单。">?</span>
    <span class="section-rule"></span>
    <span class="section-note">{{ t('Overnight moves, graded for entry — late movers get flagged, not celebrated', '隔夜变化按入场质量分级——已错过的标注勿追，不吹捧') }}</span>
  </div>
  <div class="glass tonight-wrap">
  {% if _n_focus > 0 %}
      {# ── Shelf 1: clean staged names — the desk's product ── #}
      {% if nsf.look | length > 0 %}
      <div class="tn-shelf">
        <div class="tn-shelf-label"><span class="tns-dot" style="background:var(--col-ignition);"></span>{{ t('Worth a look', '值得关注') }} <span class="tns-sub">— {{ t('staged, not extended', '蓄势·未过热') }}</span></div>
        <div class="tonight-grid">
        {% for item in nsf.look %}
        <a class="move-card{% if item.fired %} is-fire{% endif %}" href="us_stocks.html#{{ item.ticker }}"{% if not item.fired %} style="--mv-c:{{ _STATE_COL[item.state] if item.state in _STATE_COL else 'var(--text-muted)' }};"{% endif %}>
          {% if item.fired %}<span class="move-glyph">⚡</span>{% endif %}
          <span class="move-tkr">{{ item.ticker }}</span>
          {% if not item.fired %}<span class="move-ar">→</span>{% endif %}
          <span class="move-badge">{% if item.fired %}{{ t('Ignition fired · get ready', '点火触发·准备就绪') }}{% else %}<span class="l-en">{{ _STATE_PLAIN_EN[item.state] if item.state in _STATE_PLAIN_EN else item.state }}</span><span class="l-zh">{{ _STATE_PLAIN_ZH[item.state] if item.state in _STATE_PLAIN_ZH else item.state }}</span>{% endif %}</span>
          {{ _mv_from(item) }}
        </a>
        {% endfor %}
        </div>
      </div>
      {% endif %}
      {# ── Shelf 2: already moved — the anti-chase read leads ── #}
      {% if nsf.late | length > 0 %}
      <div class="tn-shelf">
        <div class="tn-shelf-label"><span class="tns-dot" style="background:var(--col-crowded);"></span>{{ t("Already moved — don't chase", '已经启动——勿追高') }} <span class="tns-sub">— {{ t('wait for the first base', '等待首个整理平台') }}</span></div>
        <div class="tonight-grid">
        {% for item in nsf.late %}
        <a class="move-card is-late" href="us_stocks.html#{{ item.ticker }}">
          <span class="move-glyph">⚠</span>
          <span class="move-tkr">{{ item.ticker }}</span>
          <span class="move-badge">{% if item.fired %}{{ t('Fired · late', '已触发·偏晚') }}{% else %}<span class="l-en">{{ _STATE_PLAIN_EN[item.state] if item.state in _STATE_PLAIN_EN else item.state }}</span><span class="l-zh">{{ _STATE_PLAIN_ZH[item.state] if item.state in _STATE_PLAIN_ZH else item.state }}</span>{% endif %}</span>
          {{ _mv_ext(item) }}
        </a>
        {% endfor %}
        </div>
      </div>
      {% endif %}
      {# ── Shelf 3: turnaround attempts — downtrend intact ── #}
      {% if nsf.turn | length > 0 %}
      <div class="tn-shelf">
        <div class="tn-shelf-label"><span class="tns-dot" style="background:var(--col-suppressed);"></span>{{ t('Turnaround attempts', '反转尝试') }} <span class="tns-sub">— {{ t('long downtrend still intact — watch only', '长期下行未改——仅观察') }}</span></div>
        <div class="tonight-grid">
        {% for item in nsf.turn %}
        <a class="move-card is-turn" href="us_stocks.html#{{ item.ticker }}">
          <span class="move-tkr">{{ item.ticker }}</span>
          <span class="move-ar">→</span>
          <span class="move-badge"><span class="l-en">{{ _STATE_PLAIN_EN[item.state] if item.state in _STATE_PLAIN_EN else item.state }}</span><span class="l-zh">{{ _STATE_PLAIN_ZH[item.state] if item.state in _STATE_PLAIN_ZH else item.state }}</span></span>
          {{ _mv_turn(item) }}
        </a>
        {% endfor %}
        </div>
      </div>
      {% endif %}
      {# Newly crowded — exit-side warning #}
      {% if nsf.crowded | length > 0 %}
      <div class="tn-shelf">
        <div class="tonight-grid">
        {% for item in nsf.crowded %}
        <a class="move-card is-crowded" href="us_stocks.html#{{ item.ticker }}">
          <span class="move-tkr">{{ item.ticker }}</span>
          <span class="move-ar">→</span>
          <span class="move-badge">{{ t('Crowded · protect gains', '过度拥挤·保护盈利') }}</span>
        </a>
        {% endfor %}
        </div>
      </div>
      {% endif %}
  {% else %}
    <div class="tonight-empty">{{ t('Quiet night — no new escalations or fires.', '平静之夜——无新升级或触发。') }}</div>
  {% endif %}

  {# One signal away — folded in #}
  {% if _nt | length > 0 %}
    <div class="tonight-near">
      <span class="tn-label">{{ t('One signal away', '差一个信号') }}</span>
      {% for item in _nt %}
      {% if loop.index <= 8 %}
      <a class="tn-chip" href="us_stocks.html#{{ item.ticker }}">
        <span class="tn-tkr">{{ item.ticker }}</span>
        {% for chip_key in item.missing_chips if item.missing_chips is defined and item.missing_chips is not none %}
        {% if loop.index == 1 %}<span class="tn-miss"><span class="l-en js-chip-en" data-chip-key="{{ chip_key }}">{{ chip_key | replace('_',' ') | title }}</span><span class="l-zh js-chip-zh" data-chip-key="{{ chip_key }}">{{ chip_key | replace('_',' ') | title }}</span></span>{% endif %}
        {% else %}
        <span class="tn-miss" style="font-style:italic;opacity:0.75;">{{ t('one chip pending', '待确认一项') }}</span>
        {% endfor %}
      </a>
      {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {# Cooled — the de-noised de-escalations, one muted line #}
  {% if nsf.cooled | length > 0 %}
    <div class="tonight-cooled">
      <span>{{ t('Also', '另有') }} <b class="num">{{ nsf.cooled | length }}</b> {{ t('names cooled out of earlier stages', '个标的自早前阶段回落') }}</span>
      <span class="cooled-list">{% for item in nsf.cooled %}{% if loop.index <= 14 %}{{ item.ticker }}{% if not loop.last and loop.index < 14 %} · {% endif %}{% endif %}{% endfor %}{% if nsf.cooled | length > 14 %} +{{ nsf.cooled | length - 14 }}{% endif %}</span>
    </div>
  {% endif %}
  {# One merged footnote — the desk's base-rate honesty at glance tier #}
  <div class="tonight-baserate">{{ t('Even complete setups fail roughly 4 times in 10 — every card here is a watch item, not a trade signal. Outcomes accrue in the fire receipts below.', '即使条件齐备，历史上约四成仍会失败——每张卡片都是观察项，非交易信号。结果记录见下方触发回执。') }}</div>
  </div>
</section>{# /tonight-section #}

{# ── EARLY ENTRY BOARD ── #}
<section class="early-entry-section">
  <div class="section-header">
    <span class="section-title">{{ t('Early entry board', '早入场看板') }}</span>
    <span class="section-count">— {{ t('hero', '核心') }}</span>
    <span class="section-rule"></span>
  </div>

  <div class="lane-grid">

    {# ─── IGNITION WINDOW LANE (CATALYST_WINDOW) ─── #}
    <div class="lane-col">
      <div class="lane-header ignition">
        <div class="lane-dot ignition"></div>
        <div class="lane-name">{{ t('Ignition window', '点火窗口') }}</div>
        <span class="lane-count-chip ignition">{{ ns.cnt_catalyst }}</span>
      </div>

      {% if ns.cnt_catalyst == 0 %}
      <div class="lane-empty">
        {{ t('No names in the ignition window today — the quiet-build lane is where the next ones come from.', '今日没有标的进入点火窗口 — 下一批将从静默筑底区涌现。') }}
      </div>
      {% else %}
      {% for r in ns.catalyst_rows %}
      {# count positive non-internal chips #}
      {% set ns2 = namespace(k_pos=0, ev1='', ev2='', macd_cross=false, macd_bars=none, fire=false) %}
      {% set chips = r.chips if r.chips is defined and r.chips is not none else {} %}
      {% for k, v in chips.items() %}
        {% if v is sameas true and k not in _INTERNAL_CHIPS %}
          {% set ns2.k_pos = ns2.k_pos + 1 %}
        {% endif %}
      {% endfor %}
      {% set ctx = r.context if r.context is defined and r.context is not none else {} %}
      {% set tf2d = ctx.tf2d_state if ctx.tf2d_state is defined and ctx.tf2d_state is not none else {} %}
      {% if tf2d.macd_approaching_up is defined and tf2d.macd_approaching_up %}{% set ns2.macd_cross = true %}{% endif %}
      {% if tf2d.macd_bars_to_cross is defined and tf2d.macd_bars_to_cross is not none %}{% set ns2.macd_bars = tf2d.macd_bars_to_cross %}{% endif %}
      {% if r.fire_precipice is defined and r.fire_precipice %}{% set ns2.fire = true %}{% endif %}
      {% set spark_cw = tf2d.spark_hist | tojson if tf2d.spark_hist is defined and tf2d.spark_hist is not none else 'null' %}
      {% set _cw_fwd_pe = ctx.fwd_pe if ctx.fwd_pe is defined and ctx.fwd_pe is not none else none %}
      {% set _cw_val_pctile = ctx.valuation_pctile_5y if ctx.valuation_pctile_5y is defined and ctx.valuation_pctile_5y is not none else none %}
      <div class="entry-card ignition" onclick="openCardReceiptFromEl(this)"
           data-ticker="{{ r.ticker }}" data-stage="CATALYST_WINDOW"
           data-days="{{ r.days_in_state if r.days_in_state is defined and r.days_in_state is not none else '' }}"
           data-macd-bars="{{ tf2d.macd_bars_to_cross if tf2d.macd_bars_to_cross is defined and tf2d.macd_bars_to_cross is not none else '' }}"
           data-chips='{{ chips | tojson }}'
           data-fwd-pe="{{ _cw_fwd_pe if _cw_fwd_pe is not none else '' }}"
           data-val-pctile="{{ _cw_val_pctile if _cw_val_pctile is not none else '' }}">
        <div class="card-top">
          <a class="card-ticker" href="us_stocks.html#{{ r.ticker }}" onclick="event.stopPropagation()" style="color:inherit;">{{ r.ticker }}</a>
          <div class="card-right">
            {% if r.days_in_state is defined and r.days_in_state is not none %}
            <div class="card-days"><span class="l-en">{{ r.days_in_state }}s tracked</span><span class="l-zh">已追踪{{ r.days_in_state }}个交易日</span></div>
            {% endif %}
            <svg class="card-sparkline" data-hist='{{ spark_cw }}' viewBox="0 0 64 24"></svg>
          </div>
        </div>
        <div class="evidence-bar">
          <div class="dot-bar" data-k="{{ ns2.k_pos }}" data-n="{{ [ns2.k_pos + 2, 6] | min }}"></div>
          {# K-of-N demotion: plain descriptor replaces bare counts at rest; exact k/n in popover receipt #}
          {% set _cw_ratio = (ns2.k_pos / [ns2.k_pos + 2, 6] | min) if [ns2.k_pos + 2, 6] | min > 0 else 0 %}
          <span class="ev-label">{% if ns2.k_pos >= [ns2.k_pos + 2, 6] | min %}{{ t('All signals in', '信号齐备') }}{% elif _cw_ratio >= 0.6 %}{{ t('Strengthening', '增强中') }}{% else %}{{ t('Building', '酝酿中') }}{% endif %}</span>
        </div>
        <div class="evidence-line" data-chips='{{ chips | tojson }}' data-stage="CATALYST_WINDOW"></div>
        {% if ns2.macd_cross %}
        <div class="timing-chip near">
          {{ t('MACD crossing ↑', 'MACD即将上穿') }}{% if ns2.macd_bars is not none %} · ~{{ ns2.macd_bars | int }} {{ t('days', '天') }}{% endif %}
        </div>
        {% elif tf2d.macd_cross_up is defined and tf2d.macd_cross_up %}
        <div class="timing-chip near">{{ t('MACD crossed ↑ today', 'MACD今日上穿') }}</div>
        {% endif %}
        {% if ns2.fire %}
        <div class="fire-badge">&#x26A1; {{ t('Watch window opened', '观察窗口开启') }}</div>
        {% endif %}
        {# LRV-O9 entry-quality flag: the exit-side lens applied at the entry lane #}
        {% set _er_cw = r.entry_read if r.entry_read is defined and r.entry_read is not none else {} %}
        {% if _er_cw.key is defined and _er_cw.key == 'extended' %}
        {% set _bs_cw = _er_cw.basis if _er_cw.basis is defined and _er_cw.basis is not none else [] %}
        <div class="entry-flag late">&#x26A0; {{ t("Already moved — don't chase", '已经启动——勿追高') }}{% if 'extension_extreme' in _bs_cw and _er_cw.extension_pct_50d is defined and _er_cw.extension_pct_50d is not none and _er_cw.extension_pct_50d > 0 %} · +{{ _er_cw.extension_pct_50d | round | int }}% {{ t('vs 50-day', '对50日线') }}{% endif %}</div>
        {% elif _er_cw.key is defined and _er_cw.key == 'turnaround_watch' %}
        <div class="entry-flag turn">{{ t('Downtrend intact — turnaround attempt only', '下行趋势未改——仅为反转尝试') }}</div>
        {% endif %}
        {{ _opt_cav(_er_cw) }}
      </div>
      {% endfor %}
      {% endif %}
    </div>

    {# ─── QUIET BUILD LANE (QUIET_ACCUMULATION) — ranked by early_entry artifact order ─── #}
    {# early_entry is a ranked LIST of {ticker,state,k_true,n_avail,...} #}
    {# Collect early_entry QA entries in artifact order #}
    {% set ns_ee_qa = namespace(entries=[]) %}
    {% if lr.early_entry is defined and lr.early_entry is not none and lr.early_entry is iterable %}
      {% for ee in lr.early_entry %}
        {% if ee.state is defined and ee.state == 'QUIET_ACCUMULATION' %}
          {% set ns_ee_qa.entries = ns_ee_qa.entries + [ee] %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {# Collect early_entry SUPPRESSED entries in artifact order for first-stirrings lane #}
    {% set ns_ee_supp = namespace(entries=[]) %}
    {% if lr.early_entry is defined and lr.early_entry is not none and lr.early_entry is iterable %}
      {% for ee in lr.early_entry %}
        {% if ee.state is defined and ee.state == 'SUPPRESSED' %}
          {% set ns_ee_supp.entries = ns_ee_supp.entries + [ee] %}
        {% endif %}
      {% endfor %}
    {% endif %}

    <div class="lane-col">
      <div class="lane-header quiet">
        <div class="lane-dot quiet"></div>
        <div class="lane-name">{{ t('Quiet build', '静默筑底') }}</div>
        <span class="lane-count-chip quiet">{{ ns.cnt_quiet }}</span>
      </div>

      {% set ns_qa_shown = namespace(n=0) %}
      {# Use early_entry QA list (ranked artifact order) when available, else fall back to ns.quiet_rows #}
      {% set qa_display = ns_ee_qa.entries if ns_ee_qa.entries | length > 0 else ns.quiet_rows %}
      {% for _item in qa_display %}
      {# early_entry items have .ticker; find the main row by linear scan for full chip/context data #}
      {% if _item.ticker is defined %}
        {% set _ns_rmatch = namespace(found=_item) %}
        {% for _mr in rows %}
          {% if _mr.ticker == _item.ticker %}{% set _ns_rmatch.found = _mr %}{% endif %}
        {% endfor %}
        {% set r = _ns_rmatch.found %}
        {# k_true/n_avail come from the ranked early_entry item directly #}
        {% set _ee_k = _item.k_true if _item.k_true is defined and _item.k_true is not none else none %}
        {% set _ee_n = _item.n_avail if _item.n_avail is defined and _item.n_avail is not none else none %}
      {% else %}
        {% set r = _item %}
        {% set _ee_k = none %}
        {% set _ee_n = none %}
      {% endif %}
      {% if ns_qa_shown.n < 4 and r.ticker is defined %}
        {% set chips = r.chips if r.chips is defined and r.chips is not none else {} %}
        {% set ctx = r.context if r.context is defined and r.context is not none else {} %}
        {% set tf2d = ctx.tf2d_state if ctx.tf2d_state is defined and ctx.tf2d_state is not none else {} %}
        {# k/n from early_entry artifact when present; fall back to chip count #}
        {% set ns4 = namespace(k_pos=0) %}
        {% for ck, cv in chips.items() %}
          {% if cv is sameas true and ck not in _INTERNAL_CHIPS %}
            {% set ns4.k_pos = ns4.k_pos + 1 %}
          {% endif %}
        {% endfor %}
        {# Use ranked early_entry k_true/n_avail directly when available #}
        {% set _card_k = _ee_k if _ee_k is not none else ns4.k_pos %}
        {% set _card_n = _ee_n if _ee_n is not none else ns4.k_pos %}
        {% set macd_near = tf2d.macd_approaching_up is defined and tf2d.macd_approaching_up %}
        {% set macd_crossed = tf2d.macd_cross_up is defined and tf2d.macd_cross_up %}
        {% set macd_bars = tf2d.macd_bars_to_cross if tf2d.macd_bars_to_cross is defined and tf2d.macd_bars_to_cross is not none else none %}
        {% set spark_data_raw = tf2d.spark_hist | tojson if tf2d.spark_hist is defined and tf2d.spark_hist is not none else 'null' %}
        {% set _fwd_pe = ctx.fwd_pe if ctx.fwd_pe is defined and ctx.fwd_pe is not none else none %}
        {% set _val_pctile = ctx.valuation_pctile_5y if ctx.valuation_pctile_5y is defined and ctx.valuation_pctile_5y is not none else none %}
        <div class="entry-card quiet" onclick="openCardReceiptFromEl(this)"
             data-ticker="{{ r.ticker }}" data-stage="QUIET_ACCUMULATION"
             data-days="{{ r.days_in_state if r.days_in_state is defined and r.days_in_state is not none else '' }}"
             data-macd-bars="{{ macd_bars if macd_bars is not none else '' }}"
             data-chips='{{ chips | tojson }}'
             data-fwd-pe="{{ _fwd_pe if _fwd_pe is not none else '' }}"
             data-val-pctile="{{ _val_pctile if _val_pctile is not none else '' }}">
          <div class="card-top">
            <a class="card-ticker" href="us_stocks.html#{{ r.ticker }}" onclick="event.stopPropagation()" style="color:inherit;">{{ r.ticker }}</a>
            <div class="card-right">
              {% if r.days_in_state is defined and r.days_in_state is not none %}
              <div class="card-days"><span class="l-en">{{ r.days_in_state }}s tracked</span><span class="l-zh">已追踪{{ r.days_in_state }}个交易日</span></div>
              {% endif %}
              <svg class="card-sparkline" data-hist='{{ spark_data_raw }}' viewBox="0 0 64 24"></svg>
            </div>
          </div>
          <div class="evidence-bar">
            <div class="dot-bar" data-k="{{ _card_k }}" data-n="{{ _card_n if _card_n > 0 else _card_k }}"></div>
            {# K-of-N demotion: plain descriptor replaces bare counts at rest #}
            {% set _qa_n = _card_n if _card_n > 0 else _card_k %}
            {% set _qa_ratio = (_card_k / _qa_n) if _qa_n > 0 else 0 %}
            <span class="ev-label">{% if _card_k >= _qa_n %}{{ t('All signals in', '信号齐备') }}{% elif _qa_ratio >= 0.6 %}{{ t('Strengthening', '增强中') }}{% else %}{{ t('Building', '酝酿中') }}{% endif %}</span>
          </div>
          <div class="evidence-line" data-chips='{{ chips | tojson }}' data-stage="QUIET_ACCUMULATION"></div>
          {% if macd_near %}
          <div class="timing-chip near">
            {{ t('MACD crossing ↑', 'MACD即将上穿') }}{% if macd_bars is not none %} · ~{{ macd_bars | int }} {{ t('days', '天') }}{% endif %}
          </div>
          {% elif macd_crossed %}
          <div class="timing-chip near">{{ t('MACD crossed ↑ today', 'MACD今日上穿') }}</div>
          {% endif %}
          {% if r.fire_precipice is defined and r.fire_precipice %}
          <div class="fire-badge">&#x26A1; {{ t('Watch window opened', '观察窗口开启') }}</div>
          {% endif %}
          {# LRV-O9 entry-quality flag (QA lane) #}
          {% set _er_qa = r.entry_read if r.entry_read is defined and r.entry_read is not none else {} %}
          {% if _er_qa.key is defined and _er_qa.key == 'extended' %}
          {% set _bs_qa = _er_qa.basis if _er_qa.basis is defined and _er_qa.basis is not none else [] %}
          <div class="entry-flag late">&#x26A0; {{ t("Already moved — don't chase", '已经启动——勿追高') }}{% if 'extension_extreme' in _bs_qa and _er_qa.extension_pct_50d is defined and _er_qa.extension_pct_50d is not none and _er_qa.extension_pct_50d > 0 %} · +{{ _er_qa.extension_pct_50d | round | int }}% {{ t('vs 50-day', '对50日线') }}{% endif %}</div>
          {% elif _er_qa.key is defined and _er_qa.key == 'turnaround_watch' %}
          <div class="entry-flag turn">{{ t('Downtrend intact — turnaround attempt only', '下行趋势未改——仅为反转尝试') }}</div>
          {% endif %}
          {{ _opt_cav(_er_qa) }}
        </div>
        {% set ns_qa_shown.n = ns_qa_shown.n + 1 %}
      {% endif %}
      {% endfor %}
      {% if ns.cnt_quiet > ns_qa_shown.n %}
      <div style="font-size:0.72rem;color:var(--text-muted);padding:6px 4px;">
        +{{ ns.cnt_quiet - ns_qa_shown.n }} {{ t('more in this lane', '个标的在此区间') }}
      </div>
      {% endif %}
    </div>

    {# ─── FIRST STIRRINGS LANE (SUPPRESSED with lead signs) ─── #}
    <div class="lane-col">
      <div class="lane-header suppressed">
        <div class="lane-dot suppressed"></div>
        <div class="lane-name">{{ t('First stirrings', '初动迹象') }}</div>
        <span class="lane-count-chip suppressed">{{ ns.cnt_suppressed }} {{ t('left for dead', '无人问津') }}</span>
      </div>

      {% set ns_supp_shown = namespace(n=0) %}
      {# Use early_entry SUPPRESSED list (ranked artifact order); each entry has k_true/n_avail = lead signals #}
      {% set supp_display = ns_ee_supp.entries if ns_ee_supp.entries | length > 0 else ns.suppressed_rows %}
      {% for _sitem in supp_display %}
      {% if _sitem.ticker is defined %}
        {% set _ns_srmatch = namespace(found=_sitem) %}
        {% for _mr in rows %}
          {% if _mr.ticker == _sitem.ticker %}{% set _ns_srmatch.found = _mr %}{% endif %}
        {% endfor %}
        {% set r = _ns_srmatch.found %}
        {% set _s_ee_k = _sitem.k_true if _sitem.k_true is defined and _sitem.k_true is not none else none %}
        {% set _s_ee_n = _sitem.n_avail if _sitem.n_avail is defined and _sitem.n_avail is not none else none %}
      {% else %}
        {% set r = _sitem %}
        {% set _s_ee_k = none %}
        {% set _s_ee_n = none %}
      {% endif %}
      {% if ns_supp_shown.n < 4 and r.ticker is defined %}
        {% set chips = r.chips if r.chips is defined and r.chips is not none else {} %}
        {# Count lead signals only for fallback when early_entry k_true unavailable #}
        {% set ns5 = namespace(lead_k=0) %}
        {% for lk in _LEAD_KEYS %}
          {% if lk in chips and chips[lk] is sameas true %}{% set ns5.lead_k = ns5.lead_k + 1 %}{% endif %}
        {% endfor %}
        {% set _s_card_k = _s_ee_k if _s_ee_k is not none else ns5.lead_k %}
        {% set _s_card_n = _s_ee_n if _s_ee_n is not none else ns5.lead_k %}
        {% if _s_card_k > 0 %}
          {% set ctx = r.context if r.context is defined and r.context is not none else {} %}
          {% set tf2d = ctx.tf2d_state if ctx.tf2d_state is defined and ctx.tf2d_state is not none else {} %}
          {% set spark_s = tf2d.spark_hist | tojson if tf2d.spark_hist is defined and tf2d.spark_hist is not none else 'null' %}
          {% set _s_fwd_pe = ctx.fwd_pe if ctx.fwd_pe is defined and ctx.fwd_pe is not none else none %}
          {% set _s_val_pctile = ctx.valuation_pctile_5y if ctx.valuation_pctile_5y is defined and ctx.valuation_pctile_5y is not none else none %}
          <div class="entry-card suppressed" onclick="openCardReceiptFromEl(this)"
               data-ticker="{{ r.ticker }}" data-stage="SUPPRESSED"
               data-days="{{ r.days_in_state if r.days_in_state is defined and r.days_in_state is not none else '' }}"
               data-chips='{{ chips | tojson }}'
               data-fwd-pe="{{ _s_fwd_pe if _s_fwd_pe is not none else '' }}"
               data-val-pctile="{{ _s_val_pctile if _s_val_pctile is not none else '' }}">
            <div class="card-top">
              <a class="card-ticker" href="us_stocks.html#{{ r.ticker }}" onclick="event.stopPropagation()" style="color:inherit;">{{ r.ticker }}</a>
              <div class="card-right">
                {% if r.days_in_state is defined and r.days_in_state is not none %}
                <div class="card-days"><span class="l-en">{{ r.days_in_state }}s tracked</span><span class="l-zh">已追踪{{ r.days_in_state }}个交易日</span></div>
                {% endif %}
                <svg class="card-sparkline" data-hist='{{ spark_s }}' viewBox="0 0 64 24" style="flex-shrink:0;"></svg>
              </div>
            </div>
            <div class="evidence-bar">
              <div class="dot-bar" data-k="{{ _s_card_k }}" data-n="{{ _s_card_n if _s_card_n > 0 else _s_card_k }}"></div>
              {# K-of-N demotion: plain descriptor replaces bare counts at rest #}
              {% set _supp_n = _s_card_n if _s_card_n > 0 else _s_card_k %}
              {% set _supp_ratio = (_s_card_k / _supp_n) if _supp_n > 0 else 0 %}
              <span class="ev-label">{% if _s_card_k >= _supp_n %}{{ t('All signals in', '信号齐备') }}{% elif _supp_ratio >= 0.6 %}{{ t('Strengthening', '增强中') }}{% else %}{{ t('Building', '酝酿中') }}{% endif %}</span>
            </div>
            <div class="evidence-line" data-chips='{{ chips | tojson }}' data-stage="SUPPRESSED"></div>
          </div>
          {% set ns_supp_shown.n = ns_supp_shown.n + 1 %}
        {% endif %}
      {% endif %}
      {% endfor %}
      {# "+N more" footer: early_entry SUPPRESSED count vs shown #}
      {% set _supp_total = ns_ee_supp.entries | length if ns_ee_supp.entries | length > 0 else ns.cnt_suppressed %}
      {% if _supp_total > ns_supp_shown.n %}
      <div style="font-size:0.72rem;color:var(--text-muted);padding:6px 4px;">
        +{{ _supp_total - ns_supp_shown.n }} {{ t('more with lead signs', '个有领先信号') }}
      </div>
      {% endif %}
      {% set no_lead_count = ns.cnt_suppressed - _supp_total %}
      {% if no_lead_count > 0 %}
      <div style="font-size:0.72rem;color:var(--text-dim);padding:6px 4px;">
        {{ no_lead_count }} {{ t('without lead signs — ignore for now', '个无领先信号——暂不关注') }}
      </div>
      {% endif %}
    </div>

  </div>{# /lane-grid #}
</section>

{# ── DUAL CARDS: Handoff Watch + Rerating Watch ── #}
<div class="dual-cards">

  {# Handoff Watch #}
  <div class="glass side-card sc-handoff">
    <div class="side-card-title">{{ t('Handoff watch', '接力观察') }}</div>
    <div class="side-card-sub">{{ t("Stretched leaders basing — who steps up next", '已超伸领涨股筑底 — 谁将接棒') }}</div>

    {% if handoff_pairs %}
    <div class="rerating-rows">
      {% for pair in handoff_pairs %}
      <div class="rerating-row">
        <span class="rerating-ticker">{{ pair.extended_basket if pair.extended_basket is defined else '—' }}</span>
        {% set basing = pair.basing_names if pair.basing_names is defined and pair.basing_names is not none else [] %}
        {% for bn in basing %}
        <a href="us_stocks.html#{{ bn.ticker }}" class="rerate-chip" style="font-size:0.72rem;">{{ bn.ticker }}</a>
        {% endfor %}
        {% if pair.extension_pctile is defined and pair.extension_pctile is not none %}
        {# Plain percentile: "9 of 10 past readings" idiom instead of bare Np #}
        {% set _ext_n10 = ([((pair.extension_pctile * 100) / 10) | round | int, 1] | max) %}
        <span class="rerate-chip null-chip" style="margin-left:auto;"
          data-tip-en="stretched further above trend than {{ _ext_n10 }} of 10 past readings"
          data-tip-zh="伸展度超过过去{{ _ext_n10 }}成时间">
          <span class="l-en">{{ _ext_n10 }}/10</span><span class="l-zh">{{ _ext_n10 }}成</span>
        </span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    {# Empty state #}
    <div class="empty-state">
      <div class="empty-label">{{ t('No handoff candidates today', '今日无接力候选') }}</div>
      <div class="empty-sub">{{ t('Nothing is extended enough to trigger a handoff watch. When names in Breaking away become stretched, candidates appear here.', '目前无标的超伸至触发接力观察。当"突破启动"中的标的超伸时，候选将出现在此处。') }}</div>
    </div>

    {# Show "closest to stretched" from handoff_context baskets, sorted by extension_pctile_vs_200d desc, top 3 #}
    {# ZH basket display names #}
    {% set _basket_zh = {
      'mag7': '七巨头',
      'ai_infra': 'AI基础设施',
      'ai_semiconductors': 'AI半导体',
      'semicap_equipment': '半导体设备',
      'memory_storage': '存储芯片',
      'data_center_power': '数据中心电力',
      'ai_software': 'AI软件',
      'ai_neoclouds': 'AI新云',
    } %}
    {# Sort handoff_context by extension_pctile_vs_200d desc (nulls last); pick top 3 with non-null pctile #}
    {% set closest_baskets = namespace(items=[]) %}
    {% if handoff_context and handoff_context | length > 0 %}
      {# Two-pass: collect non-null pctile items sorted desc (Jinja has no sort on key; do selection sort top-3) #}
      {% set _hc_pool = namespace(pool=[]) %}
      {% for hc in handoff_context %}
        {% if hc.extension_pctile_vs_200d is defined and hc.extension_pctile_vs_200d is not none %}
          {% set _hc_pool.pool = _hc_pool.pool + [hc] %}
        {% endif %}
      {% endfor %}
      {# Selection-sort: pick 3 highest pctile items from pool #}
      {% set _picked = namespace(items=[], used=[]) %}
      {% for _i in range(3) %}
        {% if _i < _hc_pool.pool | length %}
          {% set _best = namespace(item=none, val=-1) %}
          {% for hc in _hc_pool.pool %}
            {% if hc.basket not in _picked.used and hc.extension_pctile_vs_200d > _best.val %}
              {% set _best.item = hc %}
              {% set _best.val = hc.extension_pctile_vs_200d %}
            {% endif %}
          {% endfor %}
          {% if _best.item is not none %}
            {% set _picked.items = _picked.items + [_best.item] %}
            {% set _picked.used = _picked.used + [_best.item.basket] %}
          {% endif %}
        {% endif %}
      {% endfor %}
      {% set closest_baskets.items = _picked.items %}
    {% endif %}

    {% if closest_baskets.items | length > 0 %}
    <div class="closest-list">
      <div class="closest-title">{{ t('Closest to stretched — basket extension check', '最接近超伸 — 篮子伸展检查') }}</div>
      {% for item in closest_baskets.items %}
      {% set _slug = item.basket %}
      {% set _pctile = item.extension_pctile_vs_200d %}
      {# Round to nearest tenth: e.g. 92.3 → "9 of 10", 54.4 → "5 of 10", 20.5 → "2 of 10" #}
      {% set _n_of_10 = ((_pctile / 10) | round | int) %}
      {% set _n_of_10 = [_n_of_10, 1] | max %}
      {% set _pctile_text_en = 'stretched further above trend than ' + (_n_of_10 | string) + ' of 10 past readings' %}
      {% set _pctile_text_zh = '伸展度超过过去' + (_n_of_10 | string) + '成时间' %}
      <div class="closest-row">
        <span class="closest-ticker" style="text-decoration:none;cursor:default;">
          <span class="l-en">{{ _slug | replace('_', ' ') | title }}</span><span class="l-zh">{{ _basket_zh[_slug] if _slug in _basket_zh else (_slug | replace('_', ' ') | title) }}</span>
        </span>
        <span class="closest-why">
          <span class="l-en">{{ _pctile_text_en }}</span><span class="l-zh">{{ _pctile_text_zh }}</span>
          {% if item.rs_21d_slope_sign is defined and item.rs_21d_slope_sign is not none and item.rs_21d_slope_sign < 0 %}
          · <em><span class="l-en">strength rolling over</span><span class="l-zh">相对强度回落中</span></em>
          {% endif %}
        </span>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% endif %}{# /handoff_pairs else #}
  </div>

  {# Rerating Watch #}
  {# Partition positives-first; disclose systemic valuation-null once, not per row #}
  {% set _rrp = namespace(pos=[], neg=[], val_any=false) %}
  {% for rr in rerating_watch %}
    {% set rc = rr.chips if rr.chips is defined and rr.chips is not none else {} %}
    {% if rc.multiple_compressed is sameas true %}{% set _rrp.val_any = true %}{% endif %}
    {% if (rc.revision_positive is sameas true) or (rc.revision_breadth_60 is sameas true) or (rc.multiple_compressed is sameas true) %}
      {% set _rrp.pos = _rrp.pos + [rr] %}
    {% else %}
      {% set _rrp.neg = _rrp.neg + [rr] %}
    {% endif %}
  {% endfor %}
  <div class="glass side-card sc-rerate">
    <div class="side-card-title">{{ t('Rerating watch', '重估观察') }}</div>
    <div class="side-card-sub">
      {{ t('Estimates turning up while still cheap', '预期上调而估值仍低') }}
      {% if _rrp.pos | length > 0 %} — <span style="color:var(--col-breakaway);font-weight:700;">{{ _rrp.pos | length }}</span> {{ t('with a live signal', '有活跃信号') }}{% elif rerating_watch | length > 0 %} — {{ rerating_watch | length }} {{ t('tracked', '追踪中') }}{% endif %}
    </div>

    {% if rerating_watch %}
    <div class="rerating-rows">
      {% for rr in (_rrp.pos + _rrp.neg) %}
      {% set rc = rr.chips if rr.chips is defined and rr.chips is not none else {} %}
      {% set rs = rr.state if rr.state is defined and rr.state is not none else 'NONE' %}
      {% set _has_pos = (rc.revision_positive is sameas true) or (rc.revision_breadth_60 is sameas true) or (rc.multiple_compressed is sameas true) %}
      <div class="rerating-row{% if not _has_pos %} rr-dim{% endif %}">
        <a class="rerating-ticker" href="us_stocks.html#{{ rr.ticker }}" style="text-decoration:none;">{{ rr.ticker }}</a>
        <span class="rerating-stage-chip {% if rs == 'BREAKAWAY' %}s-breakaway{% elif rs == 'QUIET_ACCUMULATION' %}s-quiet{% elif rs == 'SUPPRESSED' %}s-suppressed{% elif rs == 'LEADERSHIP' %}s-leadership{% elif rs == 'CROWDED' %}s-crowded{% else %}s-none{% endif %}">
          {% if rs == 'BREAKAWAY' %}{{ t('Breaking away', '突破启动') }}
          {% elif rs == 'QUIET_ACCUMULATION' %}{{ t('Quiet build', '静默筑底') }}
          {% elif rs == 'SUPPRESSED' %}{{ t('Left for dead', '无人问津') }}
          {% elif rs == 'LEADERSHIP' %}{{ t('Leading', '领涨中') }}
          {% elif rs == 'CROWDED' %}{{ t('Crowded', '过度拥挤') }}
          {% else %}{{ t('No signal', '无信号') }}{% endif %}
        </span>
        <div class="rerating-chips">
          {% if rc.revision_positive is sameas true %}<span class="rerate-chip">{{ t('Estimates ↑', '盈利预期↑') }}</span>{% endif %}
          {% if rc.revision_breadth_60 is sameas true %}<span class="rerate-chip">{{ t('Broad breadth', '广泛修正') }}</span>{% endif %}
          {% if rc.multiple_compressed is sameas true %}<span class="rerate-chip">{{ t('Cheap vs history', '估值处于低位') }}</span>{% endif %}
          {% if rc.earnings_within_14d is defined and rc.earnings_within_14d is sameas true %}<span class="rerate-chip warn">{{ t('Earnings &lt;14d', '财报&lt;14天') }}</span>{% endif %}
          {% if not _has_pos %}<span class="rr-watching">{{ t('watching — no rerating signal yet', '观察中——暂无重估信号') }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% if not _rrp.val_any %}
    <div class="rr-footer">{{ t('Valuation-compression leg is seeding — snapshot history still young, so the "cheap vs history" chip is quiet.', '估值压缩指标积累中——快照历史尚浅，"估值处于低位"暂不显示。') }}</div>
    {% endif %}
    {% else %}
    <div class="muted" style="font-size:0.78rem;color:var(--text-muted);">{{ t('No rerating conditions met today.', '今日未满足重估观察条件。') }}</div>
    {% endif %}
  </div>

</div>{# /dual-cards #}

{# ── FIRE RECEIPTS panel ── #}
{% set _fh = lr.fire_history if lr.fire_history is defined and lr.fire_history is not none else [] %}
{% if _fh | length > 0 %}
<section class="fire-receipts-section">
  <div class="section-header">
    <span class="section-title">{{ t('Fire log', '触发记录') }}</span>
    <span class="section-rule"></span>
  </div>
  <div class="glass" style="padding:14px 16px;border-radius:var(--radius-card);">
    <table class="fire-receipts-table">
      <thead>
        <tr>
          <th>{{ t('Date', '日期') }}</th>
          <th>{{ t('Ticker', '代码') }}</th>
          <th>{{ t('Type', '类型') }}</th>
          <th>{{ t('21d vs market', '21日超额') }}</th>
        </tr>
      </thead>
      <tbody>
      {% for item in _fh %}
      <tr>
        <td style="white-space:nowrap;">{{ item.date[:10] if item.date is defined and item.date is not none else '—' }}</td>
        <td><a href="us_stocks.html#{{ item.ticker }}" style="color:inherit;text-decoration:none;">{{ item.ticker if item.ticker is defined else '—' }}</a></td>
        <td>
          {% if item.fire_type is defined and item.fire_type == 'precipice' %}{{ t('Pre-launch watch', '起飞前观察') }}
          {% elif item.fire_type is defined and item.fire_type == 'onset' %}{{ t('Breakout entry', '突破入场') }}
          {% else %}{{ item.fire_type if item.fire_type is defined else '—' }}{% endif %}
        </td>
        <td>
          {% if item.status is defined and item.status == 'matured' and item.ret_excess_spy is defined and item.ret_excess_spy is not none %}
            {% set _ret = item.ret_excess_spy * 100 %}
            <span style="color:{% if _ret >= 0 %}#4ade80{% else %}#f87171{% endif %};">{% if _ret >= 0 %}+{% endif %}{{ '%.1f' | format(_ret) }}%</span>
          {% else %}
          <span style="color:var(--text-dim);font-style:italic;">{{ t('accruing', '累计中') }}</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    <div class="fire-receipts-footer">
      {{ t('Fires are logged and graded automatically after 21 sessions; sample too small for a track record yet.', '触发自动记录，21个交易日后自动评分；样本尚少，未成往绩。') }}
    </div>
  </div>
</section>
{% endif %}

{# ── FULL BOARD ── #}
<section class="full-board-section">
  <div class="board-toggle glass" onclick="toggleBoard(this)">
    <div class="board-toggle-left">
      <span class="board-toggle-label">{{ t('Full board', '完整看板') }}</span>
      <span class="board-toggle-sub">{{ t('All', '全部') }} {{ rows | length }} {{ t('names · dense view', '个标的 · 密集视图') }}</span>
    </div>
    <span class="board-caret" id="board-caret">&#9660;</span>
  </div>
  <div class="board-table-wrap glass" id="board-table-wrap" style="border-radius:0 0 var(--radius-card) var(--radius-card);border-top:none;margin-top:-1px;">
    <table class="board-table">
      <thead>
        <tr>
          <th>{{ t('Ticker', '代码') }}</th>
          <th>{{ t('Stage', '阶段') }}</th>
          <th>{{ t('Stance', '建议') }}</th>
          <th>{{ t('Evidence', '证据') }}</th>
          <th>{{ t('Days', '天数') }}</th>
          <th>{{ t('Momentum', '动量') }}</th>
        </tr>
      </thead>
      <tbody>
      {# Group rows by state in display order #}
      {% set board_groups = [
        ('LEADERSHIP',         'Leading',       '领涨中',    'In favour',               '顺风期',         ns.leadership_rows),
        ('BREAKAWAY',          'Breaking away', '突破启动',  "In motion — don't chase", '行情进行中——勿追', ns.breakaway_rows),
        ('QUIET_ACCUMULATION', 'Quiet build',   '静默筑底',  "Watch — don't chase",     '观察——勿追高',    ns.quiet_rows),
        ('CATALYST_WINDOW',    'Ignition window','点火窗口', 'Get ready',                '做好准备',       ns.catalyst_rows),
        ('SUPPRESSED',         'Left for dead', '无人问津',  'Ignore',                   '暂不关注',       ns.suppressed_rows),
        ('CROWDED',            'Crowded',        '过度拥挤', 'Protect gains',            '保护利润',       ns.crowded_rows),
        ('FAILED',             'Failed break',  '突破失败',  'Stand aside',             '观望回避',       ns.failed_rows),
        ('NONE',               'No signal',     '无信号',    'Ignore',                  '暂不关注',       ns.none_rows),
      ] %}
      {% for grp_key, grp_en, grp_zh, stance_en, stance_zh, grp_rows in board_groups %}
      {% if grp_rows | length > 0 %}
      <tr class="board-grp-hd" onclick="toggleBoardGroup('bg-{{ grp_key }}')">
        <td colspan="6">
          <span class="stage-pill {{ grp_key }}">
            <span class="l-en">{{ grp_en }}</span><span class="l-zh">{{ grp_zh }}</span>
          </span>
          <span style="margin-left:8px;font-size:0.68rem;color:var(--text-dim);">{{ grp_rows | length }} {{ t('names', '个') }}</span>
          <span style="margin-left:4px;font-size:0.66rem;color:var(--text-dim);">· {{ t('click to expand/collapse', '点击展开/折叠') }}</span>
          <span style="float:right;font-size:0.66rem;color:var(--text-dim);font-style:italic;">
            <span class="l-en">{{ stance_en }}</span><span class="l-zh">{{ stance_zh }}</span>
          </span>
        </td>
      </tr>
      <tbody id="bg-{{ grp_key }}" class="board-grp-body collapsed">
      {% for r in grp_rows %}
        {% set chips = r.chips if r.chips is defined and r.chips is not none else {} %}
        {% set ctx = r.context if r.context is defined and r.context is not none else {} %}
        {% set tf2d = ctx.tf2d_state if ctx.tf2d_state is defined and ctx.tf2d_state is not none else {} %}
        {# Build evidence chips (first 2 positive non-internal) #}
        {% set ns_ev = namespace(parts=[]) %}
        {% for ck, cv in chips.items() %}
          {% if cv is sameas true and ck not in _INTERNAL_CHIPS and ns_ev.parts | length < 2 %}
            {% set ns_ev.parts = ns_ev.parts + [ck] %}
          {% endif %}
        {% endfor %}
        {# Chip class by state #}
        {% set chip_cls = 'green' if grp_key == 'BREAKAWAY' else ('blue' if grp_key == 'CATALYST_WINDOW' else 'gray') %}
        <tr>
          <td><a class="ticker-link" href="us_stocks.html#{{ r.ticker }}" style="text-decoration:none;">{{ r.ticker }}</a>
            {% if r.fire_precipice is defined and r.fire_precipice %}<span class="fire-badge" style="font-size:0.6rem;padding:1px 5px;margin-left:4px;">&#x26A1;</span>{% endif %}
          </td>
          <td>
            <span class="stage-pill {{ grp_key }}">
              <span class="l-en">{{ grp_en }}</span><span class="l-zh">{{ grp_zh }}</span>
            </span>
          </td>
          <td style="font-size:0.72rem;color:var(--text-muted);">
            <span class="l-en">{{ stance_en }}</span><span class="l-zh">{{ stance_zh }}</span>
          </td>
          <td>
            <div class="leg-chips">
              {% for ck in ns_ev.parts %}
              <span class="leg-chip {{ chip_cls }}" data-chip-key="{{ ck }}"></span>
              {% endfor %}
            </div>
          </td>
          <td style="color:var(--text-muted);">
            {% if r.days_in_state is defined and r.days_in_state is not none %}<span class="l-en">{{ r.days_in_state }}s</span><span class="l-zh">{{ r.days_in_state }}日</span>{% else %}<em style="font-size:0.68rem;">{{ t('seeding', '初始化') }}</em>{% endif %}
          </td>
          <td>
            {% if tf2d.spark_hist is defined and tf2d.spark_hist is not none %}
            <svg class="board-spark" viewBox="0 0 48 18" data-hist='{{ tf2d.spark_hist | tojson }}'></svg>
            {% else %}
            <svg class="board-spark" viewBox="0 0 48 18"></svg>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
      {% endif %}
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{# ── FIELD GUIDE ── #}
<section class="guide-section">
  <div class="glass guide-wrap">
    <div class="guide-title">{{ t('Field guide — Stage anatomy', '实战手册 — 阶段解析') }}</div>
    <div class="guide-sub">{{ t('What each stage means in plain words. Machine names are in parentheses inside each section.', '每个阶段的通俗释义。机器内部名称括注于各节内部。') }}</div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Left for dead — First stirrings', '无人问津 — 初动迹象') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <div style="margin-bottom:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('Machine state: SUPPRESSED / 机器状态：SUPPRESSED', 'Machine state: SUPPRESSED / 机器状态：SUPPRESSED') }}</div>
        {{ t('RS underperforming for ≥3 months, drawdown ≥25% from 52-week high, valuation often in cheap territory. Sometimes years below the 200dma. Key question: is the compression cyclical or structural?', 'RS连续≥3个月跑输大盘，自52周高点回撤≥25%，估值通常处于低廉区间。有时在200日均线下方数年。关键问题：压缩是周期性的还是结构性的？') }}
        <div style="margin-top:8px;"><em>{{ t('Lead indicators:', '领先指标：') }}</em> <span class="l-en"><code>revision_positive</code> (cut cycle ending), cheap valuation pctile, <code>insider_cluster</code>, OBV divergence</span><span class="l-zh">盈利预期转正（削减周期结束）、低廉估值分位、内部人增持、成交量-价格背离</span></div>
      </div>
    </div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Quiet build — Watch, don\'t chase', '静默筑底 — 观察，勿追') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <div style="margin-bottom:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('Machine state: QUIET_ACCUMULATION / 机器状态：QUIET_ACCUMULATION', 'Machine state: QUIET_ACCUMULATION / 机器状态：QUIET_ACCUMULATION') }}</div>
        {{ t('Base forming: 60-day range compression. At least 2 of: revision cycle turning positive (revision_positive), RS slope turning up while long-term RS still negative (rs_turn), accumulation-day count building (accum_evidence), OBV making new highs while price has not (obv_divergence). Highest-ROI watch stage.', '筑底形成：60日区间压缩。至少2项：预测周期开始转正（revision_positive），RS斜率上升但长期RS仍为负（rs_turn），积累日计数增加（accum_evidence），OBV创新高而价格未创（obv_divergence）。回报率最高的观察阶段。') }}
        <div style="margin-top:8px;"><em>{{ t('Lead:', '领先：') }}</em> <span class="l-en"><code>rs_turn</code>, <code>revision_positive</code>, <code>obv_divergence</code></span><span class="l-zh">相对大盘转强、盈利预期转正、底部买盘积累</span></div>
        <div><em>{{ t('Lag:', '滞后：') }}</em> <span class="l-en">price confirming (<code>bw_emerging</code>)</span><span class="l-zh">价格确认（突破酝酿中）</span></div>
      </div>
    </div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Ignition window — Get ready', '点火窗口 — 做好准备') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <div style="margin-bottom:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('Machine state: CATALYST_WINDOW / 机器状态：CATALYST_WINDOW', 'Machine state: CATALYST_WINDOW / 机器状态：CATALYST_WINDOW') }}</div>
        {{ t('Ignition trigger within 10 sessions: gap ≥+5% on ≥2× 20-day volume (gap_ignition), breakaway watch emerging (bw_emerging), or RS-line making 126-day new high while price has not (rs_line_nh — RS leads price). The Stage-2 foundation is a necessary precondition — ignition without a base almost always reverts.', '10个交易日内出现点火触发：跳空≥+5%且成交量≥20日均量的2倍（gap_ignition），突破观察新兴（bw_emerging），或RS线创126日新高而价格未创（rs_line_nh — RS领先价格）。阶段2基础是必要前提 — 无基础的点火几乎总是反转。') }}
        <div style="margin-top:8px;"><em>{{ t('Strongest leading observable:', '最强领先可观测指标：') }}</em> <span class="l-en"><code>rs_line_nh</code></span><span class="l-zh">相对强度先于股价创新高</span></div>
        <div><em>{{ t('Confirm:', '确认：') }}</em> <span class="l-en"><code>gap_ignition</code>, <code>bw_emerging</code>, 2D MACD cross</span><span class="l-zh">放量跳空上行、突破酝酿中、2日MACD上穿</span></div>
      </div>
    </div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Breaking away — In motion', '突破启动 — 行情进行中') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <div style="margin-bottom:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('Machine state: BREAKAWAY / 机器状态：BREAKAWAY', 'Machine state: BREAKAWAY / 机器状态：BREAKAWAY') }}</div>
        {{ t('Detector-D onset: liquid ∧ rel-breakaway ∧ 63d-new-high ∧ vol-confirm. Continuation: RS top-decile persistence ≥4 weeks (rs_top_decile_4w). Concentration fingerprint: leader RS-accel > 0 while same-basket peer-median RS < 0 (peer_divergence).', '突破探测器D启动：流动性 ∧ 相对突破 ∧ 63日新高 ∧ 成交量确认。延续：RS前十分位持续≥4周（rs_top_decile_4w）。集中度指纹：领头者RS加速>0，同伴中位RS<0（peer_divergence）。') }}
      </div>
    </div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Crowded — Protect gains', '过度拥挤 — 保护利润') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <div style="margin-bottom:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('Machine state: CROWDED / 机器状态：CROWDED', 'Machine state: CROWDED / 机器状态：CROWDED') }}</div>
        {{ t('≥3 of: extension ≥25% vs 50dma (extension_extreme), monthly RSI ≥80 (monthly_rsi_80), parabolic (parabolic), valuation ≥80th pctile 5y (valuation_extreme), analyst buy-share ≥85% (analyst_saturated), basket-correlation ≥0.75 rising from below 0.5 (basket_corr_rising). Late-stage; handoff watch most relevant.', '≥3项：超伸≥25%（extension_extreme），月RSI≥80（monthly_rsi_80），抛物线（parabolic），估值≥5年80分位（valuation_extreme），分析师买入比例≥85%（analyst_saturated），篮子相关性≥0.75且从低于0.5上升（basket_corr_rising）。后期阶段；接力观察最为重要。') }}
        <div style="margin-top:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('A seventh condition — call-skew richness (call_skew_rich) — is measured nightly but does not count toward the ≥3 while we check whether it carries information; on this options history it has so far behaved like chance. It is shown on the row, never counted.', '第七项条件——看涨偏斜过高（call_skew_rich）——每晚计算，但在检验其是否具备信息量期间不计入≥3；就目前的期权历史而言，其表现与随机无异。仅在行内显示，不计入统计。') }}</div>
      </div>
    </div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Failed break — Stand aside', '突破失败 — 观望回避') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <div style="margin-bottom:6px;color:var(--text-dim);font-size:0.72rem;">{{ t('Machine state: FAILED / 机器状态：FAILED', 'Machine state: FAILED / 机器状态：FAILED') }}</div>
        {{ t('Breakaway attempt that reversed — Detector-D "failed" state (bw_failed). Evidence dissipated. Not a permanent label: a name can re-accumulate and re-enter Quiet build (21-session + full de-escalation lockout before the ledger refires).', '突破尝试后反转 — 突破探测器D"失败"状态（bw_failed）。证据消散。不是永久标签：标的可重新积累并重进静默筑底（台账重新触发前需21个交易日 + 完全去升级锁定）。') }}
      </div>
    </div>

    <div class="playbook">
      <div class="pb-hd" onclick="this.classList.toggle('open');this.nextElementSibling.style.display=this.classList.contains('open')?'block':'none';">
        <span>{{ t('Signal classification & base rates', '信号分类与基础成功率') }}</span><span class="car">&#9658;</span>
      </div>
      <div class="pb-bd">
        <p>{{ t('A fire badge means the engine logged the event — not that an outcome is expected. Fires are logged and graded automatically after 21 sessions; sample too small for a track record yet.', '触发标记意味着引擎记录了该事件，而非预期某种结果。触发自动记录，21个交易日后自动评分；样本尚少，未成往绩。') }}</p>
        <div style="margin-top:8px;"><strong>{{ t('Lead signals (appear before price):', '领先信号（先于价格出现）：') }}</strong> <span class="l-en"><code>rs_line_nh</code>, <code>revision_positive</code>, <code>obv_divergence</code>, <code>insider_cluster</code></span><span class="l-zh">相对强度先于股价创新高、盈利预期转正、底部买盘悄然积累、内部人增持</span></div>
        <div><strong>{{ t('Confirm signals (coincide with price):', '确认信号（与价格同步）：') }}</strong> <span class="l-en"><code>gap_ignition</code>, <code>bw_emerging</code>, <code>accum_evidence</code>, 2D MACD cross</span><span class="l-zh">放量跳空上行、突破酝酿中、成交量温和吸筹、2日MACD上穿</span></div>
        <div><strong>{{ t('Lag signals (appear after price):', '滞后信号（价格后出现）：') }}</strong> <span class="l-en"><code>analyst_saturated</code>, <code>call_skew_rich</code></span><span class="l-zh">分析师一致看多、看涨期权被追捧</span></div>
        <div style="margin-top:8px;"><em>{{ t('Value-trap question:', '价值陷阱问题：') }}</em> {{ t('Is the multiple compression cyclical or structural? The chip prints the observable; the answer is yours to supply.', '估值倍数压缩是周期性还是结构性？信号指标呈现可观测指标；答案需要你自己判断。') }}</div>
      </div>
    </div>

  </div>
</section>

{# ── FOOTER ── #}
<footer class="glass">
  <div class="footer-honesty">
    {{ t('Stages describe observed evidence, not predictions. Fires are logged and graded automatically after 21 sessions — the forward ledger keeps score.', '各阶段描述观察到的证据，而非预测。触发自动记录并于21个交易日后自动评分——前瞻台账保存记录。') }}
    {% if lr.history_since is defined and lr.history_since is not none %}
      {%- set _ft_parts = lr.history_since[:10].split('-') -%}
      {%- set _ft_mon_zh = _ft_parts[1] | int if _ft_parts|length >= 2 else 0 -%}
      {%- set _ft_day_zh = _ft_parts[2] | int if _ft_parts|length >= 3 else 0 -%}
    {{ t('State tracking began ' + lr.history_since[:10] + '. Counters accumulate nightly.', '状态追踪始于' + (_ft_mon_zh|string) + '月' + (_ft_day_zh|string) + '日，计数器每晚累积。') }}
    {% endif %}
  </div>
</footer>

</div>{# /page-wrap #}

<script>
/* ── Plain-word chip labels ── */
const CHIP_LABELS_EN = {
  revision_positive: "Estimates turning up",
  rs_turn: "Strength turning vs market",
  accum_evidence: "Volume accumulating",
  obv_divergence: "Buying pressure building under the surface",
  insider_cluster: "Insiders buying",
  gap_ignition: "Gapped up on heavy volume",
  rs_line_nh: "Strength at new highs before price",
  bw_emerging: "Breakout forming",
  drawdown_25pct: "Down 25%+ from highs",
  below_200dma_12m: "A year below trend",
  cheap_pctile_40: "Cheap vs own history",
  monthly_rsi_80: "Monthly momentum extreme",
  extension_extreme: "Stretched far above trend",
  parabolic: "Going parabolic",
  analyst_saturated: "Analysts all-in",
  call_skew_rich: "Call options bid up",
  basket_corr_rising: "Whole group moving as one",
  bw_continuation: "Trend running",
  peer_divergence: "Pulling away from peers",
  rs_top_decile_4w: "Top-tier strength for a month",
  rs_slope_negative_3m: "Relative trend recovering",
  bw_breakaway: "Breakout confirmed",
  valuation_extreme: "Stretched vs own valuation history",
};
const CHIP_LABELS_ZH = {
  revision_positive: "盈利预期转正",
  rs_turn: "相对大盘转强",
  accum_evidence: "成交量温和吸筹",
  obv_divergence: "成交量-价格背离",
  insider_cluster: "内部人增持",
  gap_ignition: "放量跳空上行",
  rs_line_nh: "相对强度先于股价创新高",
  bw_emerging: "突破酝酿中",
  drawdown_25pct: "自高点回撤逾25%",
  below_200dma_12m: "长期低于年线",
  cheap_pctile_40: "估值处于自身低位",
  monthly_rsi_80: "月线动能极端",
  extension_extreme: "远超趋势线",
  parabolic: "抛物线式上涨",
  analyst_saturated: "分析师一致看多",
  call_skew_rich: "看涨期权被追捧",
  basket_corr_rising: "板块同涨同跌",
  bw_continuation: "趋势延续中",
  peer_divergence: "与同行拉开差距",
  rs_top_decile_4w: "强度居前已达一月",
  rs_slope_negative_3m: "相对趋势回升中",
  bw_breakaway: "突破确认",
  valuation_extreme: "估值相对自身历史偏高",
};
const NULL_LABELS_EN = {
  insider_cluster: "no insider data",
  // LRV-R6: the options data exists and keeps accruing — the read is held out of the
  // count until it earns its place, so "no data" would be the wrong reason.
  call_skew_rich: "options read still being checked",
  revision_positive: "no revision data",
  multiple_compressed: "no valuation data",
};
const NULL_LABELS_ZH = {
  insider_cluster: "无内部人数据",
  call_skew_rich: "期权读数仍在检验",
  revision_positive: "无预测修订数据",
  multiple_compressed: "无估值数据",
};
const EXPECTED_CHIPS = {
  QUIET_ACCUMULATION: ['revision_positive','rs_turn','accum_evidence','obv_divergence','insider_cluster','call_skew_rich'],
  CATALYST_WINDOW:    ['gap_ignition','rs_line_nh','bw_emerging','revision_positive','insider_cluster','call_skew_rich'],
  SUPPRESSED:         ['revision_positive','rs_turn','accum_evidence','obv_divergence','insider_cluster'],
  BREAKAWAY:          ['extension_extreme','monthly_rsi_80','bw_continuation','bw_breakaway','accum_evidence','revision_positive'],
};
const INTERNAL_CHIPS = new Set(['qa_context','context_ok','bw_failed','bw_continuation_pre_leadership']);
// Young-data chips: store born 2026-06 — display with ~ prefix and note in receipt
const YOUNG_DATA_CHIPS = new Set(['analyst_saturated','call_skew_rich']);
const YOUNG_DATA_TIP_EN = 'young data — store since Jun 2026';
const YOUNG_DATA_TIP_ZH = '数据较新——2026年6月起';

function isZH() { return document.documentElement.getAttribute('data-lang') === 'zh'; }
function chipLabel(k) { return isZH() ? (CHIP_LABELS_ZH[k] || k) : (CHIP_LABELS_EN[k] || k); }
function nullLabel(k) { return isZH() ? (NULL_LABELS_ZH[k] || k) : (NULL_LABELS_EN[k] || k); }

/* ── Sparkline renderer ── */
function renderSparkline(svg, histData, colorCls) {
  if (!histData || histData.length < 2) return;
  const vals = histData.slice(-10);
  const mn = Math.min(...vals), mx = Math.max(...vals), rng = mx - mn || 1;
  const pts = vals.map((v,i) => {
    const x = (i / (vals.length-1)) * 62 + 1;
    const y = 22 - ((v - mn) / rng) * 20;
    return x + ',' + y;
  }).join(' ');
  const last = vals[vals.length-1], first = vals[0];
  const cls = last > first ? 'up' : last < first ? 'down' : 'flat';
  svg.innerHTML = '<polyline class="spark-path ' + cls + '" points="' + pts + '"/>';
}

function renderMiniSpark(svg, histData) {
  if (!histData || histData.length < 2) return;
  const v = histData.slice(-10);
  const mn = Math.min(...v), mx = Math.max(...v), rng = mx - mn || 1;
  const pts = v.map((val,i) => {
    const x = (i / (v.length-1)) * 46 + 1;
    const y = 16 - ((val - mn) / rng) * 14;
    return x + ',' + y;
  }).join(' ');
  const col = v[v.length-1] > v[0] ? '#4ade80' : '#f87171';
  svg.innerHTML = '<polyline points="' + pts + '" fill="none" stroke="' + col + '" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>';
}

/* ── Dot bar renderer ── */
function renderDotBar(el) {
  const k = parseInt(el.dataset.k || 0);
  const n = parseInt(el.dataset.n || k);
  const parent = el.closest('.entry-card');
  const cls = parent ? (parent.classList.contains('ignition') ? 'ignition' : parent.classList.contains('quiet') ? 'quiet' : 'suppressed') : 'suppressed';
  let html = '';
  for (let i = 0; i < n; i++) {
    html += '<div class="dot-bar-dot ' + (i < k ? 'filled ' + cls : 'empty') + '"></div>';
  }
  el.innerHTML = html;
}

/* ── Evidence line renderer ── */
/* Dual-span (l-en/l-zh) so the [data-lang] CSS swaps language even when
   data-lang is set without a langchange event (same idiom as near-trigger chips). */
function renderEvidenceLine(el) {
  try {
    const chips = JSON.parse(el.dataset.chips || '{}');
    const pos = Object.entries(chips).filter(([k,v]) => v === true && !INTERNAL_CHIPS.has(k));
    const keys = pos.slice(0,2).map(([k]) => k);
    if (!keys.length) { el.textContent = '—'; return; }
    const sep = '<span class="ev-sep">·</span>';
    el.innerHTML =
      '<span class="l-en">' + keys.map(k => CHIP_LABELS_EN[k] || k).join(sep) + '</span>' +
      '<span class="l-zh">' + keys.map(k => CHIP_LABELS_ZH[k] || k).join(sep) + '</span>';
  } catch(e) { el.textContent = '—'; }
}

/* ── Board chip label renderer ── */
function renderBoardChip(el) {
  const k = el.dataset.chipKey;
  el.innerHTML =
    '<span class="l-en">' + (CHIP_LABELS_EN[k] || k) + '</span>' +
    '<span class="l-zh">' + (CHIP_LABELS_ZH[k] || k) + '</span>';
}

/* ── Card receipt via data attributes (safe for JSON chips) ── */
function openCardReceiptFromEl(el) {
  const ticker = el.dataset.ticker;
  const stage  = el.dataset.stage;
  let chips = {};
  try { chips = JSON.parse(el.dataset.chips || '{}'); } catch(e) {}
  const macdBars    = el.dataset.macdBars   ? parseFloat(el.dataset.macdBars)   : null;
  const daysInState = el.dataset.days       ? parseInt(el.dataset.days, 10)     : null;
  const fwdPe       = el.dataset.fwdPe      ? parseFloat(el.dataset.fwdPe)      : null;
  const valPctile   = el.dataset.valPctile  ? parseFloat(el.dataset.valPctile)  : null;
  openCardReceipt(ticker, stage, chips, macdBars, null, daysInState, fwdPe, valPctile);
}

/* ── Card receipt popover ── */
function openCardReceipt(ticker, stage, chips, macdBars, sparkHist, daysInState, fwdPe, valPctile) {
  const zh = isZH();
  const STAGE_PLAIN = {
    CATALYST_WINDOW:    zh ? '点火窗口' : 'Ignition window',
    QUIET_ACCUMULATION: zh ? '静默筑底' : 'Quiet build',
    SUPPRESSED:         zh ? '无人问津' : 'Left for dead',
    BREAKAWAY:          zh ? '突破启动' : 'Breaking away',
    LEADERSHIP:         zh ? '领涨中'   : 'Leading',
    CROWDED:            zh ? '过度拥挤' : 'Crowded',
    FAILED:             zh ? '突破失败' : 'Failed break',
    NONE:               zh ? '无信号'   : 'No signal',
  };
  const stageLabel = STAGE_PLAIN[stage] || stage;
  const stageCls = stage === 'CATALYST_WINDOW' ? 'ignition' : stage === 'SUPPRESSED' ? 'suppressed' : '';

  document.getElementById('card-popover-title').innerHTML =
    '<a href="us_stocks.html#' + ticker + '" style="color:inherit;text-decoration:none;">' + ticker + '</a>' +
    ' · ' + stageLabel;

  const pos = Object.entries(chips).filter(([k,v]) => v === true && !INTERNAL_CHIPS.has(k));
  const expectedKeys = EXPECTED_CHIPS[stage] || [];
  const presentSet = new Set(pos.map(([k]) => k));
  const absentNulls = expectedKeys.filter(k => !presentSet.has(k) && NULL_LABELS_EN[k]);

  let html = '<div class="receipt-chip-list">';
  pos.forEach(([k]) => {
    const ydTip = YOUNG_DATA_CHIPS.has(k) ? (' <span style="opacity:0.6;font-size:0.85em;" title="' + (zh ? YOUNG_DATA_TIP_ZH : YOUNG_DATA_TIP_EN) + '">ⓘ</span>') : '';
    html += '<span class="receipt-chip on ' + stageCls + '">' + chipLabel(k) + ydTip + '</span>';
  });
  absentNulls.forEach(k => {
    html += '<span class="receipt-chip null">' + nullLabel(k) + '</span>';
  });
  html += '</div>';
  html += '<div class="receipt-machine-state">' +
    (zh ? '机器状态：' : 'Machine state: ') + stage + ' · ' +
    (zh ? '仅供展示' : 'display only') + '</div>';

  // Session count note — show when very low (young store)
  if (daysInState !== null && daysInState <= 2) {
    html += '<div class="receipt-seeding-note">' +
      (zh
        ? '追踪仅' + daysInState + '个交易日——状态存储较新'
        : 'Tracked ' + daysInState + ' session' + (daysInState === 1 ? '' : 's') + ' — state store is young') +
      '</div>';
  }

  // Context lines: fwd_pe and valuation_pctile_5y (guarded — only when non-null)
  if (fwdPe != null && !isNaN(fwdPe)) {
    html += '<div class="receipt-context-line">' +
      (zh
        ? '预期市盈率 ' + fwdPe.toFixed(1) + 'x'
        : 'Forward PE ' + fwdPe.toFixed(1) + 'x') +
      '</div>';
  }
  if (valPctile != null && !isNaN(valPctile)) {
    const pct = Math.round(valPctile);
    html += '<div class="receipt-context-line">' +
      (zh
        ? '估值高于自身5年历史 ' + pct + '%'
        : 'Valuation higher than ' + pct + '% of its own 5-year history') +
      '</div>';
  }

  document.getElementById('card-popover-body').innerHTML = html;
  openPopover('card-popover');
}

/* ── Popover helpers ── */
function openPopover(id) { document.getElementById(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closePopover(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow=''; }

/* ── Full board toggle ── */
function toggleBoard(toggleEl) {
  const wrap = document.getElementById('board-table-wrap');
  const caret = document.getElementById('board-caret');
  const isOpen = wrap.classList.contains('open');
  wrap.classList.toggle('open', !isOpen);
  caret.classList.toggle('open', !isOpen);
}

/* ── Board group toggle ── */
function toggleBoardGroup(id) {
  const el = document.getElementById(id);
  if (el) el.classList.toggle('collapsed');
}

/* ── Init: render all dynamic elements after DOM ready ── */
(function init() {
  // Sparklines
  document.querySelectorAll('.card-sparkline[data-hist]').forEach(function(svg) {
    try { renderSparkline(svg, JSON.parse(svg.dataset.hist)); } catch(e) {}
  });
  document.querySelectorAll('.board-spark[data-hist]').forEach(function(svg) {
    try { renderMiniSpark(svg, JSON.parse(svg.dataset.hist)); } catch(e) {}
  });
  // Dot bars
  document.querySelectorAll('.dot-bar[data-k]').forEach(renderDotBar);
  // Evidence lines
  document.querySelectorAll('.evidence-line[data-chips]').forEach(renderEvidenceLine);
  // Board chip labels
  document.querySelectorAll('.leg-chip[data-chip-key]').forEach(renderBoardChip);
  // Near-trigger chip labels (EN and ZH sides)
  function renderNearTriggerChips() {
    document.querySelectorAll('.js-chip-en[data-chip-key]').forEach(function(el) {
      el.textContent = CHIP_LABELS_EN[el.dataset.chipKey] || el.dataset.chipKey.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
    });
    document.querySelectorAll('.js-chip-zh[data-chip-key]').forEach(function(el) {
      el.textContent = CHIP_LABELS_ZH[el.dataset.chipKey] || el.dataset.chipKey.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
    });
  }
  renderNearTriggerChips();

  // Re-render on lang change (theme.js dispatches langchange event)
  document.addEventListener('langchange', function() {
    document.querySelectorAll('.evidence-line[data-chips]').forEach(renderEvidenceLine);
    document.querySelectorAll('.leg-chip[data-chip-key]').forEach(renderBoardChip);
    renderNearTriggerChips();
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
