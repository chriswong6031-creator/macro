{# ── M3 "Fresh conviction" — brand-new positions opened this cycle ───────────
   The replaceable block is the .fc-grid; its section heading and lede stay in
   etfs.html.j2 (hidden on the gated build, un-hidden on hydrate) so the walled
   page ships no orphan heading over content it does not have.

   Params: `rows` (board.fresh). No tier logic. #}
{% from "_etf_macros.html.j2" import t, logo, stance %}
<div class="fc-grid">
  {% for g in rows %}
  <div class="fc" style="animation-delay:{{ (loop.index0 * 0.04) | round(2) }}s">
    <div class="fc-top">{{ logo(g.ticker) }}
      <span class="st-txt"><a href="stock.html#{{ g.ticker }}"><b>{{ g.ticker }}</b></a>
        <span class="nm">{{ clean_name(g.name) }}</span></span>
      <span class="fc-conv">+{{ "%.1f" | format(g.conviction_pp) }}<i>pp</i></span>
    </div>
    <div class="fc-mid">{{ t('opened from zero by', '从零建仓') }}
      <b>{{ g.n_funds }}</b> {{ t('fund', '只基金') if g.n_funds == 1 else t('funds', '只基金') }}</div>
    {# The fund names ARE the evidence here, so they get the room. An active
       manager's mark is a filled chip — a deliberate pick, the strongest form
       of this signal — and the hover names it in both languages. #}
    <div class="fc-funds">
      {% for f in g.funds[:5] %}<span class="fchip{{ ' act' if f.is_active }}"{% if f.is_active %} data-tip-en="{{ f.fund }} is an actively managed fund — a person chose this name" data-tip-zh="{{ f.fund }} 为主动管理基金——由经理人主动选择该个股"{% endif %}>{{ f.fund }}</span>{% endfor %}
      {% if (g.funds | length) > 5 %}<span class="fchip more">+{{ (g.funds | length) - 5 }}</span>{% endif %}
    </div>
    <div class="fc-foot">{{ stance(g.stance) }}</div>
  </div>
  {% endfor %}
</div>
