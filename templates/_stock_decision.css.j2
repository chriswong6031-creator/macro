/* _stock_decision.css.j2 — styling for the shared stockview.js decision-first layout.
   Included inside each analyzer's <style> block. Theme-var routed; directional tones use
   --up/--down (which intentionally swap under html[data-lang="zh"] red=up), while caution /
   conflict / falsifier colors are pinned to --warn so their meaning never inverts. */

/* ---- Layer 1: the decision band ---- */
.sv-decision { margin: 10px 0 6px; }
.sv-verdict-band {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  padding: 12px 14px; border-radius: 12px;
  background: var(--panel2); border: 1px solid var(--line);
}
.sv-state-conflict .sv-verdict-band { border-color: var(--warn); }

/* ---- Two-lane decision: THE NAME (what) · ACT NOW (when/how much) ---- */
.sv-verdict-grid {
  display: grid; grid-template-columns: minmax(150px, 0.8fr) 1.2fr; gap: 12px;
}
.sv-lane {
  padding: 12px 14px; border-radius: 12px;
  background: var(--panel2); border: 1px solid var(--line);
}
.sv-state-conflict .sv-lane-act { border-color: var(--warn); }
.sv-lane-name {
  display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
}
.sv-lane-h {
  font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
  color: var(--muted); margin-bottom: 2px;
}
.sv-lane-name .sv-lane-h { align-self: center; }
.sv-rank-note {
  font-size: 11px; color: var(--muted); cursor: help;
  border-bottom: 1px dotted var(--line);
}
/* the ACT-NOW verb — the one buy-frame instruction, color = meaning (pinned). */
.sv-action {
  display: inline-block; font-size: 22px; font-weight: 800; line-height: 1;
  padding: 6px 14px; border-radius: 10px; letter-spacing: .02em; margin-bottom: 2px;
}
.sv-act-go { color: #fff; background: var(--up); }
.sv-act-wait { color: var(--warn); background: color-mix(in srgb, var(--warn) 16%, var(--panel)); border: 1px solid var(--warn); }
.sv-act-avoid { color: #fff; background: var(--down); }
.sv-act-screen { color: var(--text); background: var(--panel); border: 1px solid var(--line); }
/* B2+B3: TRIM ONLY — demotion from BUY when extended + hold intact; warn-family, downgrade-only */
.sv-act-trim { color: var(--warn); background: color-mix(in srgb, var(--warn) 10%, var(--panel)); border: 1px dashed var(--warn); }
.sv-act-why { margin-top: 4px; }
/* the BRIDGE — reconciles a strong rank with a "don't buy now" action. */
.sv-bridge {
  margin: 10px 0 2px; padding: 8px 12px; border-radius: 10px; font-size: 13px; font-weight: 600;
  color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--panel));
  border: 1px solid var(--warn);
}
.sv-gauge {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 96px; padding: 6px 12px; border-radius: 10px; color: #fff;
  background: var(--muted);
}
.sv-band-high { background: var(--up); }
.sv-band-constructive { background: color-mix(in srgb, var(--up) 62%, var(--panel)); }
.sv-band-neutral { background: var(--muted); }
.sv-band-low { background: var(--down); }
.sv-band-word { font-weight: 700; font-size: 13px; line-height: 1.1; text-align: center; }
.sv-score { font-size: 20px; font-weight: 800; margin-top: 2px; }
.sv-score small { font-size: 11px; font-weight: 600; opacity: .8; }
.sv-verdict-text { flex: 1; min-width: 200px; }
.sv-headline { font-size: 18px; font-weight: 750; line-height: 1.25; color: var(--text); }
.sv-gloss { font-size: 13px; color: var(--muted); margin-top: 3px; }
.sv-trust {
  font-size: 11.5px; padding: 4px 9px; border-radius: 999px;
  background: var(--panel); border: 1px solid var(--line); color: var(--muted);
  align-self: flex-start; white-space: nowrap;
}

.sv-timing { font-size: 13px; color: var(--text); margin: 8px 2px 0; }
.sv-timing-lbl { color: var(--muted); font-weight: 600; }
.sv-dot { color: var(--muted); }
.sv-tag {
  font-weight: 700; padding: 1px 7px; border-radius: 6px;
  background: var(--panel2); border: 1px solid var(--line);
}
.sv-urg-now, .sv-urg-imminent { color: var(--up); border-color: var(--up); }
.sv-urg-caution { color: var(--warn); border-color: var(--warn); }
.sv-urg-exit, .sv-urg-avoid { color: var(--down); border-color: var(--down); }
.sv-cap { color: var(--warn); font-size: 12px; }

.sv-size { display: flex; align-items: center; gap: 8px; margin: 8px 2px 0; font-size: 13px; }
.sv-size-lbl { color: var(--muted); font-weight: 600; }
.sv-size-pct { font-weight: 800; font-size: 15px; color: var(--text); }
.sv-size-avoid { color: var(--down); }
.sv-size-full, .sv-size-three-quarter { color: var(--up); }
.sv-size-bk { color: var(--muted); font-size: 12px; }
.sv-regime { margin: 8px 2px 0; font-size: 12px; color: var(--muted); font-style: italic; }

/* ---- Layer 1b: fingerprint ---- */
.sv-fingerprint {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 10px 0;
}
.sv-axis { min-width: 0; }
.sv-axis-top { display: flex; justify-content: space-between; align-items: baseline; gap: 4px; }
.sv-axis-lbl { font-size: 11.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sv-axis-pct { font-size: 13px; font-weight: 700; color: var(--text); }
.sv-axis-na { font-size: 11px; color: var(--muted); }
.sv-axis-bar { height: 6px; border-radius: 3px; background: var(--panel2); margin-top: 3px; overflow: hidden; }
.sv-axis-fill { display: block; height: 100%; background: var(--link); border-radius: 3px; }
.sv-axis-warn .sv-axis-fill { background: var(--warn); }

/* ---- Layer 1c: honesty row ---- */
.sv-conflict {
  margin: 8px 0 6px; padding: 6px 10px; border-radius: 8px; font-size: 13px; font-weight: 600;
  color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--panel));
  border: 1px solid var(--warn);
}
.sv-conflict-p { font-weight: 700; }
.sv-honesty { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 8px 0; }
.sv-col { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; }
.sv-col-h { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-bottom: 4px; }
.sv-why .sv-col-h { color: var(--up); }
.sv-flip .sv-col-h { color: var(--warn); }
.sv-list { margin: 0; padding-left: 16px; font-size: 13px; line-height: 1.5; }
.sv-list li { margin: 1px 0; }
.sv-fl-high { color: var(--down); font-weight: 600; }
.sv-empty { font-size: 12.5px; color: var(--muted); margin: 2px 0; }

/* ---- Layer 2: evidence lanes ---- */
.sv-sec-h { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 14px 0 6px; }
.sv-evidence { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
.sv-dim {
  background: var(--panel2); border: 1px solid var(--line); border-left-width: 3px;
  border-radius: 8px; padding: 7px 10px; min-width: 0;
}
.sv-dim-lbl { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }
.sv-dim-val { font-size: 13.5px; font-weight: 650; color: var(--text); margin-top: 1px; }
.sv-dim-gloss { font-size: 11px; color: var(--muted); margin-top: 3px; line-height: 1.35; }
.sv-t-good { border-left-color: var(--up); }
.sv-t-bad { border-left-color: var(--down); }
.sv-t-warn { border-left-color: var(--warn); }
.sv-t-neutral { border-left-color: var(--muted); }

/* ---- Layer 2b: country slot cards ---- */
.sv-country { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; margin: 10px 0; }
.sv-card { background: var(--panel2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; }
.sv-card-h { font-size: 12.5px; font-weight: 700; color: var(--text); margin-bottom: 5px; }
.sv-crow { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; padding: 1px 0; }
.sv-ck { color: var(--muted); }
.sv-cv { font-weight: 650; color: var(--text); }
.sv-c-up { color: var(--up); }
.sv-c-down { color: var(--down); }
.sv-cfoot { font-size: 11.5px; color: var(--muted); margin-top: 5px; line-height: 1.4; }

/* ---- Deep-layer collapsed disclosure groups ---- */
.sv-group { margin: 0; border-top: 1px solid var(--line); }
.sv-group > summary {
  cursor: pointer; list-style: none; padding: 12px 2px; font-size: 12.5px; font-weight: 700;
  color: var(--muted); text-transform: uppercase; letter-spacing: .04em;
  display: flex; align-items: center; gap: 8px;
}
.sv-group > summary::-webkit-details-marker { display: none; }
.sv-group > summary::before { content: "▸"; color: var(--muted); transition: transform .15s; }
.sv-group[open] > summary::before { transform: rotate(90deg); }
.sv-group > summary:hover { color: var(--text); }
.sv-group .panel { margin-top: 8px; }
/* the deep-detail disclosure on the header card (cycle & timing) */
.sv-deep > summary { cursor: pointer; font-size: 12.5px; color: var(--muted); padding: 6px 0; }
.sv-deep > summary:hover { color: var(--text); }

@media (max-width: 560px) {
  .sv-verdict-grid { grid-template-columns: 1fr; }
  .sv-lane-name { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; text-align: left; }
  .sv-fingerprint { grid-template-columns: repeat(2, 1fr); }
  .sv-honesty { grid-template-columns: 1fr; }
  .sv-headline { font-size: 17px; }
  .sv-score { font-size: 32px; }
  .sv-action { font-size: 22px; }
}

/* ===========================================================================
   HYBRID POLISH — Refined base + Fintech finish. Big hero numbers, soft
   borderless inner blocks, per-section accent rails. Shared by all 5 markets.
   =========================================================================== */
.sv-verdict-grid { gap: 16px; grid-template-columns: minmax(165px, .78fr) 1.22fr; align-items: stretch; }
/* re-assert the ≤560px single-column collapse: the two-column rule above follows the
   media block in source order at equal specificity, so without this the "Act Now?"
   lane overflows and clips off-screen on phones. */
@media (max-width: 560px) { .sv-verdict-grid { grid-template-columns: 1fr; } }
.sv-lane { border: none; background: var(--panel2); border-radius: 14px; padding: 16px; }
.sv-lane-name { justify-content: center; gap: 7px; }
.sv-state-conflict .sv-lane-act { border: 1px solid color-mix(in srgb, var(--warn) 45%, var(--line)); }
.sv-gauge { min-width: 118px; padding: 12px 16px; border-radius: 14px; }
.sv-band-word { font-size: 14px; }
.sv-score { font-size: 38px; letter-spacing: -.015em; margin-top: 3px; }
.sv-score small { font-size: 13px; }
.sv-action { font-size: 26px; padding: 9px 18px; border-radius: 13px; margin-bottom: 0; }
.sv-act-why { margin-top: 10px; }
.sv-headline { font-size: 19px; font-weight: 700; }
.sv-bridge { border-radius: 13px; padding: 10px 14px; font-weight: 650; }
.sv-trust { align-self: center; }
.sv-rank-note { border-bottom: 1px dotted var(--muted); }
/* evidence + country cards: borderless, softer */
.sv-evidence .sv-dim { border-radius: 11px; }
.sv-card { border: none; border-radius: 13px; padding: 12px 14px; }
/* section group headers: sentence-case, larger, with a per-domain accent rail */
.sv-group { border-top: none; }
.sv-group > summary {
  font-size: 13.5px; text-transform: none; letter-spacing: 0; font-weight: 650;
  color: var(--text); padding: 13px 14px; margin: 6px 0 0;
  border-left: 3px solid var(--muted); border-radius: 0;
  background: color-mix(in srgb, var(--panel2) 60%, transparent);
}
.sv-group > summary:hover { background: var(--panel2); }
#result > details:nth-of-type(1) > summary { border-left-color: #8b5cf6; }
#result > details:nth-of-type(2) > summary { border-left-color: var(--up); }
#result > details:nth-of-type(3) > summary { border-left-color: var(--link); }
#result > details:nth-of-type(4) > summary { border-left-color: var(--muted); }
