{% macro t(en, zh='') -%}<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>{%- endmacro %}
{% macro value(raw, suffix='') -%}
  {%- if raw is none -%}<span class="na">{{ t('Unavailable','不可用') }}</span>
  {%- elif raw|abs >= 100 -%}{{ "{:,.2f}".format(raw) }}{{ suffix }}
  {%- else -%}{{ "{:.2f}".format(raw) }}{{ suffix }}{%- endif -%}
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set seo_title = D.name ~ " Macro Dashboard — MastermindX" %}
{% set seo_desc = D.name ~ " macro regime, policy, inflation, growth, labour, credit, rates, FX, external balance and calibrated market risk." %}
{% set seo_path = D.route %}
<title>{{ seo_title }}</title>
{% include "_seo_head.html.j2" %}
<script>
try{
  var mt=localStorage.getItem('theme');if(mt)document.documentElement.setAttribute('data-theme',mt);
  var ml=localStorage.getItem('lang');if(ml)document.documentElement.setAttribute('data-lang',ml);
}catch(e){}
</script>
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="product-nav-icons.css">
<style>
*{box-sizing:border-box}
:root{color-scheme:dark}
html[data-theme="light"]{color-scheme:light}
body.imd-page{
  --imd-bg:#0a0c11;--imd-panel:rgba(16,22,30,.62);--imd-panel-strong:rgba(13,18,26,.94);
  --imd-border:rgba(255,255,255,.12);--imd-hair:color-mix(in srgb,var(--line) 74%,transparent);
  --imd-shadow:0 8px 32px rgba(0,0,0,.48),inset 0 1px 0 rgba(255,255,255,.055);
  --imd-radius:18px;--imd-num:var(--font-mono,ui-monospace,"SF Mono",Menlo,monospace);
  margin:0;padding:20px;color:var(--text);background:var(--imd-bg);
  font:14px/1.55 var(--font-ui,Inter,-apple-system,"Segoe UI",sans-serif);
  min-height:100vh;
}
html[data-theme="light"] body.imd-page{
  --imd-bg:#f5f7fb;--imd-panel:rgba(255,255,255,.84);--imd-panel-strong:rgba(255,255,255,.98);
  --imd-border:rgba(14,23,38,.09);--imd-shadow:0 8px 30px rgba(18,35,62,.09),inset 0 1px 0 #fff;
}
html[data-lang="zh"] body.imd-page{font-family:"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",sans-serif}
body.imd-page a{color:var(--link);text-decoration:none}
body.imd-page button{font:inherit}
.imd-aurora{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.imd-aurora::before,.imd-aurora::after,.imd-aurora b{content:"";position:absolute;border-radius:50%;filter:blur(100px)}
.imd-aurora::before{width:820px;height:560px;left:6%;top:-260px;background:radial-gradient(ellipse,color-mix(in srgb,var(--link) 15%,transparent),transparent 70%)}
.imd-aurora::after{width:680px;height:560px;right:-160px;bottom:-220px;background:radial-gradient(ellipse,color-mix(in srgb,var(--up) 11%,transparent),transparent 70%)}
.imd-aurora b{width:560px;height:460px;left:45%;top:34%;background:radial-gradient(ellipse,rgba(99,102,241,.08),transparent 70%)}
html[data-theme="light"] .imd-aurora{opacity:.42}
nav.site-nav{position:relative;z-index:20}
.imd-shell{position:relative;z-index:1;max-width:1480px;margin:18px auto 80px}
.imd-card{
  position:relative;background:var(--imd-panel);border:1px solid var(--imd-border);
  border-radius:var(--imd-radius);box-shadow:var(--imd-shadow);backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);padding:20px;min-width:0;
}
.imd-eyebrow{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
.imd-dot{width:7px;height:7px;border-radius:50%;background:var(--up);box-shadow:0 0 14px color-mix(in srgb,var(--up) 65%,transparent)}
.imd-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr);gap:16px;margin-bottom:16px}
.imd-hero-main{overflow:hidden;padding:26px}
.imd-hero-main::after{content:"";position:absolute;width:340px;height:340px;border-radius:50%;right:-120px;top:-170px;background:radial-gradient(circle,color-mix(in srgb,var(--link) 14%,transparent),transparent 68%);pointer-events:none}
.imd-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-top:12px}
.imd-title{margin:0;font-size:clamp(27px,4vw,48px);line-height:1.03;letter-spacing:-.045em}
.imd-title .flag{font-size:.75em;margin-right:8px}
.imd-scope{color:var(--muted);font-size:12px;margin:10px 0 0;max-width:720px}
.imd-asof{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:16px;font-size:11px;color:var(--muted)}
.imd-chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;border:1px solid var(--imd-border);background:color-mix(in srgb,var(--text) 4%,transparent);font-size:10px;font-weight:750}
.imd-chip.fresh,.imd-chip.constructive,.imd-chip.clear{color:var(--up);border-color:color-mix(in srgb,var(--up) 35%,var(--imd-border));background:color-mix(in srgb,var(--up) 9%,transparent)}
.imd-chip.stale,.imd-chip.today,.imd-chip.balanced,.imd-chip.caution{color:var(--warn);border-color:color-mix(in srgb,var(--warn) 38%,var(--imd-border));background:color-mix(in srgb,var(--warn) 9%,transparent)}
.imd-chip.missing,.imd-chip.defensive,.imd-chip.risk{color:var(--down);border-color:color-mix(in srgb,var(--down) 36%,var(--imd-border));background:color-mix(in srgb,var(--down) 8%,transparent)}
.imd-chip.released{color:var(--muted)}
.imd-score-wrap{display:grid;grid-template-columns:164px minmax(0,1fr);gap:20px;align-items:center;margin-top:24px}
.imd-gauge{
  width:154px;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;
  background:conic-gradient(var(--gauge) calc(var(--score)*1%),color-mix(in srgb,var(--text) 9%,transparent) 0);
  position:relative;filter:drop-shadow(0 0 25px color-mix(in srgb,var(--gauge) 18%,transparent));
}
.imd-gauge::before{content:"";position:absolute;inset:11px;border-radius:50%;background:var(--imd-panel-strong);border:1px solid var(--imd-border)}
.imd-gauge-value{position:relative;text-align:center;font:800 48px/.9 var(--imd-num);color:var(--gauge);letter-spacing:-.06em}
.imd-gauge-value small{display:block;margin-top:9px;font:700 9px/1 var(--font-ui,Inter,sans-serif);color:var(--muted);letter-spacing:.08em;text-transform:uppercase}
.imd-score-constructive{--gauge:var(--up)}.imd-score-balanced{--gauge:var(--warn)}.imd-score-defensive{--gauge:var(--down)}
.imd-verdict{font-size:21px;font-weight:800;letter-spacing:-.02em}
.imd-action{margin-top:7px;color:var(--text);font-size:13px;max-width:560px}
.imd-method{color:var(--muted);font-size:10.5px;margin:9px 0 0}
.imd-transition{display:grid;gap:8px}
.imd-transition h2,.imd-section-head h2{font-size:16px;line-height:1.25;margin:0;letter-spacing:-.015em}
.imd-transition h2::before,.imd-section-head h2::before{content:"";display:inline-block;width:3px;height:16px;border-radius:2px;background:linear-gradient(var(--link),color-mix(in srgb,var(--link) 28%,transparent));margin-right:9px;vertical-align:-2px}
.imd-transition-list{display:grid;gap:8px;margin-top:8px}
.imd-condition{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border:1px solid var(--imd-hair);border-radius:12px;background:color-mix(in srgb,var(--text) 3%,transparent);font-size:11.5px}
.imd-condition b{display:grid;place-items:center;flex:0 0 22px;height:22px;border-radius:7px;color:var(--link);background:color-mix(in srgb,var(--link) 12%,transparent);font:750 10px var(--imd-num)}
.imd-trust{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:16px}
.imd-trust-item{padding:13px 15px}
.imd-trust-label{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:800}
.imd-trust-value{margin-top:5px;font:750 15px var(--imd-num);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.imd-trust-value.word{font-family:inherit}
.imd-section{margin-top:25px}
.imd-section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin:0 2px 11px}
.imd-section-head p{margin:0;color:var(--muted);font-size:11px;text-align:right}
.imd-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
button.imd-face{color:inherit;text-align:left;cursor:pointer;width:100%;transition:transform .18s,border-color .18s,background .18s}
button.imd-face:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--link) 32%,var(--imd-border));background:color-mix(in srgb,var(--link) 5%,var(--imd-panel))}
button.imd-face:focus-visible,.imd-close:focus-visible{outline:2px solid var(--link);outline-offset:3px}
.imd-face-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.imd-face-icon{display:grid;place-items:center;width:36px;height:36px;border:1px solid var(--imd-border);border-radius:11px;background:color-mix(in srgb,var(--link) 10%,transparent);font-size:17px}
.imd-open{font-size:9px;color:var(--muted);letter-spacing:.07em;text-transform:uppercase}
.imd-face h3{margin:13px 0 4px;font-size:14px}
.imd-face p{margin:0;color:var(--muted);font-size:11px;min-height:34px}
.imd-face-kpi{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-top:15px;padding-top:12px;border-top:1px solid var(--imd-hair)}
.imd-face-kpi strong{font:800 25px/1 var(--imd-num);letter-spacing:-.045em}
.imd-face-kpi span{color:var(--muted);font-size:9px;text-align:right}
.imd-kpi-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:14px}
.imd-mini{border-top:1px solid var(--imd-hair);padding-top:9px;min-width:0}
.imd-mini span{display:block;color:var(--muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.imd-mini strong{display:block;margin-top:3px;font:750 14px var(--imd-num)}
.imd-chart-card{padding:24px}
.imd-chart-wrap{height:210px;margin-top:13px;position:relative;border:1px solid var(--imd-hair);border-radius:14px;overflow:hidden;background:linear-gradient(180deg,color-mix(in srgb,var(--link) 6%,transparent),transparent)}
.imd-chart-wrap::before,.imd-chart-wrap::after{content:"";position:absolute;left:0;right:0;border-top:1px dashed var(--imd-hair)}
.imd-chart-wrap::before{top:36%}.imd-chart-wrap::after{top:62%}
.imd-chart{position:absolute;inset:16px;width:calc(100% - 32px);height:calc(100% - 32px);overflow:visible}
.imd-chart polygon{fill:url(#scoreFill)}
.imd-chart polyline{fill:none;stroke:var(--link);stroke-width:2.4;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 5px color-mix(in srgb,var(--link) 50%,transparent))}
.imd-chart-meta{display:flex;justify-content:space-between;color:var(--muted);font:10px var(--imd-num);margin-top:9px}
.imd-lenses{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.imd-lens{padding:16px}
.imd-lens h3{font-size:12px;margin:0 0 6px}
.imd-lens p{font-size:10.5px;color:var(--muted);margin:0;min-height:48px}
.imd-lens-v{font:750 14px var(--imd-num);margin-top:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.imd-lens-src{font-size:9px;color:var(--muted);margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.imd-calendar{display:grid;gap:8px}
.imd-event{display:grid;grid-template-columns:105px 1fr auto;gap:14px;align-items:center;padding:13px 15px}
.imd-event-date{font:750 12px var(--imd-num)}
.imd-event h3{margin:0;font-size:12px}.imd-event p{margin:3px 0 0;color:var(--muted);font-size:10px}
.imd-health{overflow:auto;padding:0}
.imd-table{width:100%;border-collapse:collapse;min-width:760px;font-size:11px}
.imd-table th,.imd-table td{padding:12px 14px;border-bottom:1px solid var(--imd-hair);text-align:left;vertical-align:top}
.imd-table th{color:var(--muted);font-size:9px;letter-spacing:.08em;text-transform:uppercase}
.imd-table tr:last-child td{border-bottom:0}
.imd-table .source-role{max-width:340px;color:var(--muted)}
.imd-caveat{margin-top:12px;padding:13px 15px;border-radius:13px;border:1px solid color-mix(in srgb,var(--warn) 32%,var(--imd-border));background:color-mix(in srgb,var(--warn) 7%,transparent);font-size:11px}
.imd-next{display:flex;flex-wrap:wrap;gap:8px}
.imd-next a{display:inline-flex;padding:8px 13px;border:1px solid var(--imd-border);border-radius:999px;color:var(--text);font-size:11px;background:var(--imd-panel)}
.imd-next a.active{color:var(--link);border-color:color-mix(in srgb,var(--link) 40%,var(--imd-border))}
.imd-next a:hover{background:color-mix(in srgb,var(--link) 8%,var(--imd-panel))}
.imd-footer{display:flex;justify-content:space-between;gap:18px;margin-top:22px;padding:16px 4px;color:var(--muted);font-size:10px}
.imd-dlg{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:18px}
.imd-dlg.open{display:flex}
.imd-backdrop{position:absolute;inset:0;background:rgba(3,7,13,.68);backdrop-filter:blur(8px)}
.imd-panel{position:relative;width:min(900px,94vw);max-height:88vh;overflow:auto;background:var(--imd-panel-strong);border:1px solid var(--imd-border);border-radius:22px;box-shadow:0 32px 100px rgba(0,0,0,.65);opacity:0;transform:translateY(12px) scale(.975);transition:opacity .22s,transform .28s}
.imd-dlg.in .imd-panel{opacity:1;transform:none}
.imd-dlg-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--imd-hair);background:var(--imd-panel-strong);backdrop-filter:blur(20px)}
.imd-dlg-head h2{margin:0;font-size:15px}
.imd-close{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;border:1px solid var(--imd-border);background:color-mix(in srgb,var(--text) 5%,transparent);color:var(--text);cursor:pointer}
.imd-dlg-body{padding:20px}
.imd-cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
.imd-receipt{border:1px solid var(--imd-hair);border-radius:13px;padding:13px}
.imd-receipt h3{font-size:11px;margin:0 0 7px}.imd-receipt p{font-size:10.5px;color:var(--muted);margin:0}
.imd-breakdown{display:grid;gap:7px}
.imd-part{display:grid;grid-template-columns:90px 1fr 56px;align-items:center;gap:10px;font-size:10px}
.imd-bar{height:7px;border-radius:5px;background:color-mix(in srgb,var(--text) 7%,transparent);overflow:hidden}
.imd-bar i{display:block;height:100%;background:var(--link);transform-origin:left}
body.imd-lock{overflow:hidden}
@media(max-width:1100px){
  body.imd-page{padding:16px}
  .imd-hero{grid-template-columns:1fr}.imd-transition-list{grid-template-columns:repeat(3,minmax(0,1fr))}
  .imd-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .imd-lenses{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:760px){
  body.imd-page{padding:12px}.imd-shell{margin-top:12px}
  .imd-title-row{display:block}.imd-score-wrap{grid-template-columns:120px minmax(0,1fr);gap:14px}
  .imd-gauge{width:116px}.imd-gauge-value{font-size:37px}
  .imd-transition-list,.imd-grid,.imd-lenses,.imd-cols{grid-template-columns:1fr}
  .imd-trust{grid-template-columns:repeat(2,minmax(0,1fr))}
  .imd-section-head{display:block}.imd-section-head p{text-align:left;margin-top:5px}
  .imd-event{grid-template-columns:88px 1fr}.imd-event .imd-chip{grid-column:2;justify-self:start}
  .imd-dlg{align-items:flex-end;padding:0}.imd-panel{width:100%;max-width:none;max-height:90vh;border-radius:22px 22px 0 0;transform:translateY(100%)}
  .imd-dlg.in .imd-panel{transform:none}.imd-close{width:42px;height:42px}
  .imd-footer{display:block}.imd-footer span{display:block;margin-top:5px}
}
@media(max-width:430px){
  .imd-hero-main,.imd-card{padding:16px}.imd-title{font-size:30px}
  .imd-score-wrap{grid-template-columns:1fr}.imd-gauge{width:130px}
  .imd-trust{grid-template-columns:1fr}.imd-face-kpi strong{font-size:22px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}
}
</style>
</head>
<body class="imd-page imd-score-{{ D.decision.state }}">
<div class="imd-aurora" aria-hidden="true"><b></b></div>

<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search markets" placeholder="Search any market…" data-ph-zh="搜索任意市场…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener"><span class="product-icon product-icon-mastermind" aria-hidden="true"></span>{{ t('Mastermind','操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener"><span class="product-icon product-icon-terminal" aria-hidden="true"></span>{{ t('Terminal','终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
    <div class="lang-toggle" role="group" aria-label="Language"><span class="pill"></span><span class="opt en-opt" data-l="en">EN</span><span class="opt zh-opt" data-l="zh">中文</span></div>
  </div>
</nav>

<main class="imd-shell">
  <section class="imd-hero">
    <article class="imd-card imd-hero-main">
      <div class="imd-eyebrow"><span class="imd-dot"></span>{{ t('International macro command center','国际宏观指挥中心') }}</div>
      <div class="imd-title-row">
        <div>
          <h1 class="imd-title"><span class="flag">{{ D.flag }}</span>{{ t(D.name ~ ' Macro',D.name_zh ~ '宏观') }}</h1>
          <p class="imd-scope">{{ t(D.scope_en,D.scope_zh) }}</p>
        </div>
        <span class="imd-chip {{ D.decision.state }}">{{ t(D.decision.state_en,D.decision.state_zh) }}</span>
      </div>
      <div class="imd-asof">
        <span>{{ t('Data through','数据截至') }} <b>{{ D.asof }}</b></span>
        <span>·</span><span>{{ t('Built','生成') }} {{ D.built }}</span>
        {% if D.regime.data_limited %}<span class="imd-chip missing">{{ t('Limited coverage','覆盖有限') }}</span>{% endif %}
      </div>
      <div class="imd-score-wrap">
        <div class="imd-gauge" style="--score:{{ D.decision.score }}" role="img" aria-label="Decision score {{ D.decision.score }} out of 100">
          <div class="imd-gauge-value">{{ D.decision.score }}<small>{{ t('Decision score','决策分') }}</small></div>
        </div>
        <div>
          <div class="imd-verdict">{{ t(D.decision.state_en ~ ' posture',D.decision.state_zh ~ '姿态') }}</div>
          <div class="imd-action">{{ t(D.decision.action_en,D.decision.action_zh) }}</div>
          <p class="imd-method">{{ t(D.decision.method_en,D.decision.method_zh) }}</p>
        </div>
      </div>
    </article>
    <aside class="imd-card imd-transition">
      <div class="imd-eyebrow">{{ t('What changes the call','哪些条件会改变判断') }}</div>
      <h2>{{ t('Regime transition conditions','周期转折条件') }}</h2>
      <div class="imd-transition-list">
        {% for item in D.decision.transitions_en %}
        <div class="imd-condition"><b>0{{ loop.index }}</b><span>{{ t(item,D.decision.transitions_zh[loop.index0]) }}</span></div>
        {% endfor %}
      </div>
    </aside>
  </section>

  <section class="imd-trust" aria-label="Current macro status">
    <div class="imd-card imd-trust-item"><div class="imd-trust-label">{{ t('Regime','周期') }}</div><div class="imd-trust-value word">{{ D.regime.name }}</div></div>
    <div class="imd-card imd-trust-item"><div class="imd-trust-label">{{ t('Liquidity','流动性') }}</div><div class="imd-trust-value word">{{ D.regime.liquidity|title }}</div></div>
    <div class="imd-card imd-trust-item"><div class="imd-trust-label">{{ t('Recession stress','衰退压力') }}</div><div class="imd-trust-value">{{ value(D.regime.recession_score,'') }}<small>/100</small></div></div>
    <div class="imd-card imd-trust-item"><div class="imd-trust-label">{{ t('21-session pullback','21交易日回撤') }}</div><div class="imd-trust-value">{% if D.risk.h21 is not none %}{{ (D.risk.h21*100)|round(1) }}%{% else %}<span class="na">N/A</span>{% endif %}</div></div>
    <div class="imd-card imd-trust-item"><div class="imd-trust-label">{{ t('Source state','数据状态') }}</div><div class="imd-trust-value word">{% set stale = D.health|selectattr('state','equalto','stale')|list %}{% set missing = D.health|selectattr('state','equalto','missing')|list %}{% if missing %}{{ t('Gaps visible','缺口可见') }}{% elif stale %}{{ t('Stale inputs','输入陈旧') }}{% else %}{{ t('Current','当前') }}{% endif %}</div></div>
  </section>

  <section class="imd-section">
    <div class="imd-section-head"><h2>{{ t('Command cards','指挥卡片') }}</h2><p>{{ t('Open any card for evidence, definitions and provenance.','打开任一卡片查看证据、定义与来源。') }}</p></div>
    <div class="imd-grid">
      <button class="imd-card imd-face" data-dialog="dlg-regime" aria-haspopup="dialog">
        <div class="imd-face-top"><span class="imd-face-icon">◈</span><span class="imd-open">{{ t('Open evidence','打开证据') }} ↗</span></div>
        <h3>{{ t('Regime & action','周期与行动') }}</h3><p>{{ t('Growth, inflation, confidence and the current operating posture.','增长、通胀、置信度与当前操作姿态。') }}</p>
        <div class="imd-face-kpi"><strong>{{ D.regime.name }}</strong><span>{{ t('confidence','置信度') }} {{ (D.regime.confidence*100)|round(0)|int }}%</span></div>
      </button>
      <button class="imd-card imd-face" data-dialog="dlg-economy" aria-haspopup="dialog">
        <div class="imd-face-top"><span class="imd-face-icon">⌁</span><span class="imd-open">{{ t('Open evidence','打开证据') }} ↗</span></div>
        <h3>{{ t('Inflation · growth · labour','通胀 · 增长 · 就业') }}</h3><p>{{ t('The macro core, with release period and missing-state semantics.','宏观核心，包含发布期与缺失状态语义。') }}</p>
        <div class="imd-kpi-grid">
          {% for key in ['cpi_yoy','gdp_yoy','unemployment','realvol'] %}{% set m=D.metrics|selectattr('key','equalto',key)|first %}
          <div class="imd-mini"><span>{{ t(m.label_en,m.label_zh) }}</span><strong>{{ m.value }}</strong></div>{% endfor %}
        </div>
      </button>
      <button class="imd-card imd-face" data-dialog="dlg-policy" aria-haspopup="dialog">
        <div class="imd-face-top"><span class="imd-face-icon">⌂</span><span class="imd-open">{{ t('Open policy','打开政策') }} ↗</span></div>
        <h3>{{ D.policy.bank }}</h3><p>{{ t('Policy rate, curve transmission and the next verified decisions.','政策利率、曲线传导与下一次已核实决议。') }}</p>
        <div class="imd-face-kpi"><strong>{{ value(D.policy.rate,'%') }}</strong><span>{{ t('curve','曲线') }} {{ value(D.policy.curve,'pp') }}</span></div>
      </button>
      <button class="imd-card imd-face" data-dialog="dlg-market" aria-haspopup="dialog">
        <div class="imd-face-top"><span class="imd-face-icon">⌁</span><span class="imd-open">{{ t('Open context','打开背景') }} ↗</span></div>
        <h3>{{ t('Rates · FX · market context','利率 · 汇率 · 市场背景') }}</h3><p>{{ D.market.index_label }} · {{ D.market.currency_label }}</p>
        <div class="imd-kpi-grid">
          {% for key in ['yield_10y','curve','fx','drawdown'] %}{% set m=D.metrics|selectattr('key','equalto',key)|first %}
          <div class="imd-mini"><span>{{ t(m.label_en,m.label_zh) }}</span><strong>{{ m.value }}</strong></div>{% endfor %}
        </div>
      </button>
      <button class="imd-card imd-face" data-dialog="dlg-risk" aria-haspopup="dialog">
        <div class="imd-face-top"><span class="imd-face-icon">⌾</span><span class="imd-open">{{ t('Open risk','打开风险') }} ↗</span></div>
        <h3>{{ t('Calibrated risk monitor','校准风险监测') }}</h3><p>{{ t('Forward pullback odds stay separate from the descriptive macro score.','前瞻回撤概率与描述性宏观分数严格分开。') }}</p>
        <div class="imd-face-kpi"><strong>{% if D.risk.h21 is not none %}{{ (D.risk.h21*100)|round(1) }}%{% else %}N/A{% endif %}</strong><span>{{ t(D.risk.dominant_en or 'No dominant scare',D.risk.dominant_zh or '无主导风险') }}</span></div>
      </button>
      <button class="imd-card imd-face" data-dialog="dlg-health" aria-haspopup="dialog">
        <div class="imd-face-top"><span class="imd-face-icon">✓</span><span class="imd-open">{{ t('Open receipt','打开凭证') }} ↗</span></div>
        <h3>{{ t('Source health & provenance','数据健康与来源') }}</h3><p>{{ t('Official-source targets, operational fallbacks, timestamps and access blockers.','官方目标源、运行备用源、时间戳与访问障碍。') }}</p>
        <div class="imd-kpi-grid">{% for h in D.health %}<div class="imd-mini"><span>{{ t(h.label_en,h.label_zh) }}</span><strong class="{{ h.state }}">{{ h.state|title }}</strong></div>{% endfor %}</div>
      </button>
    </div>
  </section>

  <section class="imd-section">
    <div class="imd-section-head"><h2>{{ t('60-session decision path','60交易日决策路径') }}</h2><p>{{ t('Same descriptive scoring rule through history; the current risk-state adjustment is excluded from prior points.','历史沿用同一描述性规则；过往点位不含当前风险状态调整。') }}</p></div>
    <div class="imd-card imd-chart-card">
      <div class="imd-chart-wrap" role="img" aria-label="60-session decision score history">
        {% if D.history.points %}
        <svg class="imd-chart" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs><linearGradient id="scoreFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--link)" stop-opacity=".24"/><stop offset="1" stop-color="var(--link)" stop-opacity="0"/></linearGradient></defs>
          <polygon points="0,100 {{ D.history.points }} 100,100"></polygon><polyline points="{{ D.history.points }}"></polyline>
        </svg>
        {% else %}<div class="na" style="padding:20px">{{ t('History unavailable','历史不可用') }}</div>{% endif %}
      </div>
      <div class="imd-chart-meta"><span>{{ D.history.start or '—' }}</span><span>{{ t('range','区间') }} {{ D.history.min or '—' }}–{{ D.history.max or '—' }}</span><span>{{ D.history.end or '—' }}</span></div>
    </div>
  </section>

  <section class="imd-section">
    <div class="imd-section-head"><h2>{{ t('Local macro lenses','本地宏观视角') }}</h2><p>{{ t('Country-specific questions, not generic labels with the flag changed.','国家专属问题，而非仅替换国旗的通用标签。') }}</p></div>
    <div class="imd-lenses">
      {% for lens in D.lenses %}
      <article class="imd-card imd-lens">
        <h3>{{ t(lens.title_en,lens.title_zh) }}</h3><p>{{ t(lens.why_en,lens.why_zh) }}</p>
        <div class="imd-lens-v{% if not lens.available %} na{% endif %}">{{ lens.value }}</div>
        <div class="imd-lens-src"><a href="{{ lens.source_url }}" target="_blank" rel="noopener">{{ lens.source }}</a></div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="imd-section">
    <div class="imd-section-head"><h2>{{ t('Verified policy calendar','已核实政策日历') }}</h2><p>{{ t('Past dates show a released state; the dashboard does not invent the decision outcome.','过去日期显示已发布状态；看板不虚构决议结果。') }}</p></div>
    <div class="imd-calendar">
      {% for event in D.events %}
      <article class="imd-card imd-event">
        <div class="imd-event-date">{{ event.date }}</div>
        <div><h3>{{ t(event.name_en,event.name_zh) }}</h3><p>{{ t(event.outcome_en,event.outcome_zh) }} · <a href="{{ event.source }}" target="_blank" rel="noopener">{{ t('official calendar','官方日历') }}</a></p></div>
        <span class="imd-chip {{ event.state }}">{{ event.state|title }}</span>
      </article>
      {% else %}<div class="imd-card na">{{ t('No verified dates available.','暂无已核实日期。') }}</div>{% endfor %}
    </div>
  </section>

  <section class="imd-section">
    <div class="imd-section-head"><h2>{{ t('Source health & data contract','数据健康与数据契约') }}</h2><p>{{ t('Official where practical; every fallback and gap remains visible.','尽可能采用官方源；每项备用源与缺口均保持可见。') }}</p></div>
    <div class="imd-card imd-health">
      <table class="imd-table">
        <thead><tr><th>{{ t('Provider','提供方') }}</th><th>{{ t('Role','用途') }}</th><th>{{ t('Cadence','频率') }}</th><th>{{ t('Access','访问') }}</th><th>{{ t('Status','状态') }}</th></tr></thead>
        <tbody>{% for src in D.sources %}<tr><td><a href="{{ src.url }}" target="_blank" rel="noopener">{{ src.provider }}</a></td><td class="source-role">{{ src.role }}</td><td>{{ src.cadence }}</td><td>{{ src.access }}</td><td>{{ src.status }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    <div class="imd-caveat"><b>{{ t('Known limitation:','已知限制：') }}</b> {{ t(D.caveat_en,D.caveat_zh) }}</div>
  </section>

  <section class="imd-section">
    <div class="imd-section-head"><h2>{{ t('Where next','下一站') }}</h2><p>{{ t('All five dashboards share this contract and interaction model.','五个看板共享此数据契约与交互模型。') }}</p></div>
    <div class="imd-next">
      <a href="intl.html">{{ t('World comparison','全球对比') }}</a>
      {% for n in D.navigation %}<a href="{{ n.route }}" class="{% if n.active %}active{% endif %}">{{ n.name }}</a>{% endfor %}
    </div>
  </section>
  <footer class="imd-footer"><span>MastermindX · {{ D.schema }}</span><span>{{ t('Descriptive research, not investment advice.','描述性研究，不构成投资建议。') }}</span></footer>
</main>

{% macro dialog(id,title_en,title_zh) -%}
<div class="imd-dlg" id="{{ id }}" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title" aria-hidden="true">
  <div class="imd-backdrop" data-close></div>
  <div class="imd-panel" tabindex="-1">
    <div class="imd-dlg-head"><h2 id="{{ id }}-title">{{ t(title_en,title_zh) }}</h2><button class="imd-close" data-close aria-label="Close dialog">×</button></div>
    <div class="imd-dlg-body">{{ caller() }}</div>
  </div>
</div>
{%- endmacro %}

{% call dialog('dlg-regime','Regime & decision receipt','周期与决策凭证') %}
<div class="imd-cols">
  <div class="imd-receipt"><h3>{{ t('Current regime','当前周期') }}</h3><p>{{ D.regime.name }} · {{ D.regime.quad }} · {{ t('confidence','置信度') }} {{ (D.regime.confidence*100)|round(1) }}% · {{ t('liquidity','流动性') }} {{ D.regime.liquidity }}</p></div>
  <div class="imd-receipt"><h3>{{ t('Current action','当前行动') }}</h3><p>{{ t(D.decision.action_en,D.decision.action_zh) }}</p></div>
</div>
<h3 style="margin-top:18px">{{ t('Score construction','分数构成') }}</h3>
<div class="imd-breakdown">{% for key,val in D.decision.parts.items() %}<div class="imd-part"><span>{{ key|replace('_',' ')|title }}</span><div class="imd-bar"><i style="width:{{ [val|abs*3,100]|min }}%"></i></div><b>{{ '%+.1f'|format(val) }}</b></div>{% endfor %}</div>
<p class="imd-method">{{ t(D.decision.method_en,D.decision.method_zh) }}</p>
{% endcall %}

{% call dialog('dlg-economy','Inflation, growth & labour evidence','通胀、增长与就业证据') %}
<div class="imd-cols">{% for m in D.metrics if m.key in ['cpi_yoy','gdp_yoy','unemployment'] %}<div class="imd-receipt"><h3>{{ t(m.label_en,m.label_zh) }}</h3><p><b>{{ m.value }}</b><br>{{ t('Release period','发布期') }}: {{ m.asof or t('unavailable','不可用') }}</p></div>{% endfor %}</div>
<div class="imd-caveat">{{ t('A missing or stale release is a state, not zero. It cannot silently vote in the regime.','缺失或陈旧发布是一种状态，并非零值；不得无声参与周期投票。') }}</div>
{% endcall %}

{% call dialog('dlg-policy','Policy monitor','政策监测') %}
<div class="imd-cols">
  <div class="imd-receipt"><h3>{{ D.policy.bank }}</h3><p>{{ t('Policy / short rate','政策/短端利率') }}: <b>{{ value(D.policy.rate,'%') }}</b><br>{{ t('10y minus short rate','10年期减短端') }}: <b>{{ value(D.policy.curve,'pp') }}</b></p></div>
  <div class="imd-receipt"><h3>{{ t('Interpretation','解读') }}</h3><p>{{ t('The policy monitor reads the rate, curve, inflation and credit transmission together. A meeting headline alone does not change the regime.','政策监测同时读取利率、曲线、通胀与信贷传导；单一会议头条不会改变周期。') }}</p></div>
</div>
<h3 style="margin-top:18px">{{ t('Verified decisions','已核实决议日') }}</h3>
{% for event in D.events %}<div class="imd-condition"><b>{{ loop.index }}</b><span>{{ event.date }} · {{ t(event.outcome_en,event.outcome_zh) }}</span></div>{% endfor %}
{% endcall %}

{% call dialog('dlg-market','Rates, FX & market context','利率、汇率与市场背景') %}
<div class="imd-cols">{% for m in D.metrics if m.key in ['yield_10y','curve','fx','fx_strength_3m','drawdown','realvol'] %}<div class="imd-receipt"><h3>{{ t(m.label_en,m.label_zh) }}</h3><p><b>{{ m.value }}</b>{% if m.asof %}<br>{{ t('Release period','发布期') }}: {{ m.asof }}{% endif %}</p></div>{% endfor %}</div>
<div class="imd-caveat">{{ t(D.scope_en,D.scope_zh) }}</div>
{% endcall %}

{% call dialog('dlg-risk','Calibrated risk receipt','校准风险凭证') %}
<div class="imd-cols">
  <div class="imd-receipt"><h3>{{ t('21-session pullback probability','21交易日回撤概率') }}</h3><p><b>{% if D.risk.h21 is not none %}{{ (D.risk.h21*100)|round(1) }}%{% else %}N/A{% endif %}</b><br>{{ D.risk.measure or t('Calibration unavailable','校准不可用') }}</p></div>
  <div class="imd-receipt"><h3>{{ t('Risk state','风险状态') }}</h3><p><b>{{ D.risk.state or 'N/A' }}</b><br>{{ t(D.risk.dominant_en or 'No dominant scare',D.risk.dominant_zh or '无主导风险') }}</p></div>
</div>
<h3 style="margin-top:18px">{{ t('Active scare families','活跃风险类别') }}</h3>
<div class="imd-cols">{% for scare in D.risk.scares %}<div class="imd-receipt"><h3>{{ t(scare.label_en,scare.label_zh) }}</h3><p>{{ t('Score','分数') }} {{ scare.score }} · {{ scare.band }}{% if scare.firing_legs %}<br>{{ scare.firing_legs|length }} {{ t('confirming legs','项确认指标') }}{% endif %}</p></div>{% else %}<div class="imd-receipt na">{{ t('No calibrated scare data','无校准风险数据') }}</div>{% endfor %}</div>
{% endcall %}

{% call dialog('dlg-health','Source health & provenance','数据健康与来源') %}
<div class="imd-cols">{% for h in D.health %}<div class="imd-receipt"><h3>{{ t(h.label_en,h.label_zh) }} <span class="imd-chip {{ h.state }}">{{ h.state }}</span></h3><p>{{ t('Release period','发布期') }}: {{ h.asof or t('unavailable','不可用') }}{% if h.age_days is not none %}<br>{{ h.age_days }} {{ t('days old','天前') }}{% endif %}</p></div>{% endfor %}</div>
<div class="imd-caveat"><b>{{ t('Known limitation:','已知限制：') }}</b> {{ t(D.caveat_en,D.caveat_zh) }}</div>
{% endcall %}

<script>
(function(){
  'use strict';
  var last=null,closeTimer=null;
  function focusables(d){return Array.prototype.slice.call(d.querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])')).filter(function(x){return !x.disabled&&x.offsetParent!==null;});}
  function openDialog(id,trigger){
    var d=document.getElementById(id);if(!d)return;last=trigger||document.activeElement;
    if(closeTimer){clearTimeout(closeTimer);closeTimer=null}
    d.classList.add('open');d.setAttribute('aria-hidden','false');document.body.classList.add('imd-lock');
    requestAnimationFrame(function(){d.classList.add('in');var f=focusables(d);(f[0]||d.querySelector('.imd-panel')).focus();});
  }
  function closeDialog(d){
    if(!d)return;d.classList.remove('in');d.setAttribute('aria-hidden','true');document.body.classList.remove('imd-lock');
    closeTimer=setTimeout(function(){d.classList.remove('open');if(last&&last.focus)last.focus();},220);
  }
  document.querySelectorAll('[data-dialog]').forEach(function(b){b.addEventListener('click',function(){openDialog(b.getAttribute('data-dialog'),b);});});
  document.querySelectorAll('.imd-dlg [data-close]').forEach(function(b){b.addEventListener('click',function(){closeDialog(b.closest('.imd-dlg'));});});
  document.addEventListener('keydown',function(e){
    var d=document.querySelector('.imd-dlg.open');if(!d)return;
    if(e.key==='Escape'){e.preventDefault();closeDialog(d);return}
    if(e.key==='Tab'){var f=focusables(d);if(!f.length)return;var first=f[0],end=f[f.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();end.focus()}else if(!e.shiftKey&&document.activeElement===end){e.preventDefault();first.focus()}}
  });
})();
</script>
<script src="theme.js"></script>
</body>
</html>
