{#=============================================================================
  seo_learn_index.html.j2 — Learning Center hub
  Context (CONTRACT §5): page, rel, site, tracks (ordered list of
  {key, label, lessons:[{title, description, url_path, ...}]}), plus a
  `flagship` entry for the existing /learn.html Gamma Weather manual.
  page.section == 'learn'.
=============================================================================#}
{% extends "seo_base.html.j2" %}
{% block body_class %}est-learn{% endblock %}

{% block estate_css %}
  .lh-hero{max-width:1120px; margin:22px auto 0; padding:0 24px;}
  .lh-wrap{max-width:1120px; margin:30px auto 0; padding:0 24px;}

  /* flagship — the field manual, given the full-width lead card it earns */
  .lh-flag{display:grid; grid-template-columns:1fr auto; align-items:center; gap:22px;
    border:1px solid color-mix(in srgb,var(--link) 28%,var(--hair-strong)); border-radius:var(--r-lg);
    border-left:3px solid var(--rail); padding:24px 26px; text-decoration:none; position:relative;
    overflow:hidden; box-shadow:var(--ms); background:
      radial-gradient(140% 160% at 0% 0%, color-mix(in srgb,var(--link) 11%,transparent), transparent 56%),
      var(--panel);
    transition:transform .2s,border-color .2s,box-shadow .2s;}
  .lh-flag:hover{transform:translateY(-2px); border-color:var(--link);
    box-shadow:0 20px 44px -22px color-mix(in srgb,var(--link) 46%,transparent); text-decoration:none;}
  .lh-flag .fg-k{font-family:var(--num); font-size:var(--fs-label); letter-spacing:.07em; text-transform:uppercase; color:var(--link);}
  .lh-flag .fg-t{font-family:var(--font-ui); font-size:calc(var(--fs-num-lg) + 4px); font-weight:800; color:var(--ink-1);
    margin:5px 0 0; line-height:1.18; letter-spacing:-.02em;}
  html[data-lang="zh"] .lh-flag .fg-t{letter-spacing:0;}
  .lh-flag .fg-d{font-family:var(--font-ui); font-size:var(--fs-md); color:var(--ink-2); margin:9px 0 0; max-width:62ch;}
  .lh-flag .fg-btn{flex:none; font-family:var(--font-ui);}
  /* ambient hairline curve across the flagship — quiet, monochrome furniture */
  .lh-flag .fg-plot{position:absolute; right:0; bottom:0; width:280px; height:96px; opacity:.28; pointer-events:none;}
  .lh-flag .fg-plot path{fill:none; stroke:var(--ink-3); stroke-width:1.4; stroke-linecap:round;
    stroke-linejoin:round; vector-effect:non-scaling-stroke;}
  @media (max-width:640px){ .lh-flag{grid-template-columns:1fr;} .lh-flag .fg-btn{justify-self:start;} .lh-flag .fg-plot{display:none;} }

  /* tracks — each header wears the regime rail */
  .lh-track{margin-top:38px;}
  .lh-track-h{display:flex; align-items:center; gap:11px; margin:0 0 16px;
    padding:0 0 var(--sp-3); border-bottom:1px solid var(--hair-strong);}
  .lh-track-h::before{content:""; flex:none; align-self:center; width:3px; height:18px; border-radius:2px;
    background:linear-gradient(180deg, var(--rail), color-mix(in srgb,var(--rail) 35%,transparent));}
  .lh-track-h .n{font-family:var(--num); font-variant-numeric:tabular-nums; font-size:var(--fs-label);
    font-weight:700; letter-spacing:.06em; color:var(--ink-3);}
  .lh-track-h .lbl{font-family:var(--font-ui); font-size:calc(var(--fs-h2) + 1px); font-weight:700;
    letter-spacing:-.01em; color:var(--ink-1);}
  html[data-lang="zh"] .lh-track-h .lbl{letter-spacing:0;}
  .lh-track-rule{display:none;}
  .lh-lessons{display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px;}
  .lh-lesson{display:block; border:1px solid var(--hair-strong); border-radius:var(--r-md); padding:16px 18px;
    background:var(--panel); box-shadow:var(--ms); text-decoration:none;
    transition:transform .18s,border-color .18s,box-shadow .18s;}
  .lh-lesson:hover{transform:translateY(-2px); border-color:color-mix(in srgb,var(--link) 45%,var(--hair-strong));
    box-shadow:0 16px 32px -20px color-mix(in srgb,var(--link) 40%,transparent); text-decoration:none;}
  .lh-lesson .ll-t{font-family:var(--font-ui); font-size:calc(var(--fs-md) + 2px); font-weight:700; color:var(--ink-1);
    line-height:1.28; margin:0; letter-spacing:-.01em;}
  html[data-lang="zh"] .lh-lesson .ll-t{letter-spacing:0;}
  .lh-lesson .ll-d{font-family:var(--font-ui); font-size:var(--fs-body); line-height:1.5; color:var(--ink-2); margin:7px 0 0;}
  .lh-lesson .ll-go{font-family:var(--num); font-size:var(--fs-sm); color:var(--link); margin-top:11px; display:inline-block;}
{% endblock %}

{% block main %}
<div class="lh-hero">
  <div class="est-head" style="max-width:none; margin:0; padding:0;">
    <span class="est-kicker">{{ t('Learning Center', '学习中心') }}</span>
    <svg class="plot-line est-kicker-plot" viewBox="0 0 220 14" preserveAspectRatio="none" aria-hidden="true" style="--pl-len:230;">
      <path d="M2 11 C 40 11, 55 4, 90 7 S 150 3, 178 5 S 210 4, 218 3"/>
      <circle class="dot" cx="218" cy="3" r="2.6"/>
    </svg>
    <h1 class="est-title">{{ t('Plain-English lessons on the signals we track', '用大白话讲清我们追踪的信号') }}</h1>
    <p class="est-dek">{{ t('What a 52-week high really tells you. How RSI is actually built. Why position sizing is the one edge you fully control. Honest, source-linked, no jargon walls.',
       '52 周新高到底说明什么。RSI 究竟怎么算。为什么仓位管理是你唯一能完全掌控的优势。诚实、附来源、没有术语墙。') }}</p>
  </div>
</div>

<section class="lh-wrap" aria-label="Lessons">
  {% if flagship %}
  <a class="lh-flag" href="{{ rel }}{{ flagship.url_path.lstrip('/') }}">
    <svg class="fg-plot" viewBox="0 0 280 96" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 78 C 30 78, 46 40, 74 52 S 120 20, 150 34 S 196 8, 224 22 S 262 30, 280 12"/>
    </svg>
    <div>
      <span class="fg-k">{{ t('Flagship field manual · Options', '旗舰实战手册 · 期权') }}</span>
      <div class="fg-t">{% if flagship.title %}{{ flagship.title }}{% else %}{{ t('Gamma Weather: reading the options tape', 'Gamma 天气：读懂期权盘面') }}{% endif %}</div>
      <p class="fg-d">{% if flagship.description %}{{ flagship.description }}{% else %}{{ t('The desk’s full field guide to dealer gamma, charm and the daily options weather — the deepest lesson we publish.',
        '本台关于做市商 Gamma、Charm 与每日期权天气的完整实战指南——我们发布的最深入一课。') }}{% endif %}</p>
    </div>
    <span class="gbtn gbtn-lg fg-btn">{{ t('Read the manual', '阅读手册') }}</span>
  </a>
  {% endif %}

  {% for tr in tracks %}
  <div class="lh-track">
    <h2 class="lh-track-h"><span class="n">{{ '%02d' % loop.index }}</span> <span class="lbl">{{ tr.label }}</span></h2>
    <div class="lh-lessons">
      {% for ls in tr.lessons %}
      <a class="lh-lesson" href="{{ rel }}{{ ls.url_path.lstrip('/') }}">
        <h3 class="ll-t">{{ ls.title }}</h3>
        <p class="ll-d">{{ ls.description }}</p>
        <span class="ll-go">{{ t('Read lesson →', '阅读课程 →') }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>
{% endblock %}
