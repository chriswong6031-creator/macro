}

/* ── Hub v2: Accrual Clocks ─────────────────────────────────────────────── */
.ac-note{font-size:.82rem;color:var(--muted,#8899aa);max-width:720px;margin:0 0 16px;line-height:1.6}
.ac-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;max-width:100%}
.ac-table{width:100%;min-width:640px;border-collapse:collapse;font-size:.8rem}
.ac-table th{text-align:left;padding:8px 12px;font-size:.72rem;font-weight:700;
  color:var(--muted,#8899aa);border-bottom:1px solid var(--border,rgba(255,255,255,.08));
  text-transform:uppercase;letter-spacing:.08em}
.ac-table td{padding:9px 12px;border-bottom:1px solid var(--border,rgba(255,255,255,.04));
  color:var(--text,#e2e8f0);vertical-align:top;line-height:1.4}
.ac-table tr:last-child td{border-bottom:none}
.ac-ledger-name{font-size:.82rem;font-weight:600;color:var(--text,#e2e8f0)}
.ac-ledger-sub{font-size:.7rem;color:var(--muted,#8899aa);margin-top:2px}
.ac-num{font-family:monospace;font-size:.82rem;font-weight:700;color:var(--text,#e2e8f0)}
.ac-na{color:var(--muted,#8899aa);font-size:.82rem}
.ac-proj{font-family:monospace;font-size:.82rem;font-weight:700}
