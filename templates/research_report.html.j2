{%- macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro -%}
{% set nav_prefix = '../' %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ n.title }} — {{ n.inst }}{% if n.date_disp %} · {{ n.date_disp }}{% endif %} | Mastermind Research Vault</title>
<meta name="description" content="{{ meta_desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Mastermind">
<meta property="og:title" content="{{ n.title }} — {{ n.inst }}">
<meta property="og:description" content="{{ meta_desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site_base }}/apple-touch-icon.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ n.title }} — {{ n.inst }}">
<meta name="twitter:description" content="{{ meta_desc }}">
<script type="application/ld+json">{{ jsonld_str | safe }}</script>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="icon" href="../favicon.svg" type="image/svg+xml">
<link rel="icon" href="../favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="../apple-touch-icon.png">
<link rel="stylesheet" href="../theme.css">
<style>
/* ── The Vault BLUE intelligence accent (a STABLE brand token, never price dir) ── */
:root{
  --num: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
  --rv:#4f8ff7; --rv-2:#38bdf8; --rv-ink:#9cc2ff; --rv-dim:rgba(79,143,247,.13); --rv-glow:rgba(79,143,247,.34);
  --gold:#d8b26a; --buy:#45b873; --sell:#dCA24a; --indep:#8c93c8;
  --rr-glass-bg:rgba(16,22,30,.55); --rr-glass-border:rgba(255,255,255,.12);
  --rr-shadow:0 8px 32px rgba(0,0,0,.55), 0 1.5px 0 rgba(255,255,255,.07) inset;
}
html[data-theme="light"]{
  --rv:#285fff; --rv-2:#0f8fd8; --rv-ink:#1b49c8; --rv-dim:rgba(40,95,255,.10); --rv-glow:rgba(40,95,255,.26); --gold:#a9812e;
  --buy:#1f9a55; --sell:#a9781f; --indep:#5b62a8;
  --rr-glass-bg:rgba(255,255,255,.82); --rr-glass-border:rgba(0,0,0,.06);
  --rr-shadow:0 4px 24px rgba(0,0,0,.09), 0 1px 0 rgba(255,255,255,.95) inset;
}
html[data-lang="zh"]{ --buy:#e06464; }
html[data-theme="light"][data-lang="zh"]{ --buy:#cf4040; }
html:not([data-lang="zh"]) .l-zh{ display:none; } html[data-lang="zh"] .l-en{ display:none; }

html,body{ background:var(--bg); }
body{ padding-top:22px; color:var(--text); min-height:100vh; }
.rr-wrap{ max-width:760px; margin:0 auto; padding:26px 22px 96px; }
.rr-aurora{ position:fixed; inset:0; pointer-events:none; z-index:-1; overflow:hidden; }
.rr-aurora::before{ content:""; position:absolute; width:820px; height:640px; top:-220px; left:-160px; border-radius:50%;
  filter:blur(90px); background:radial-gradient(ellipse, rgba(79,143,247,.14) 0%, transparent 70%); }
html[data-theme="light"] .rr-aurora::before{ background:radial-gradient(ellipse, rgba(40,95,255,.06) 0%, transparent 70%); }

.rr-crumb{ font-size:12.5px; color:var(--muted); margin-bottom:16px; display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
.rr-crumb a{ color:var(--rv-ink); text-decoration:none; font-weight:600; }
html[data-theme="light"] .rr-crumb a{ color:var(--rv); }
.rr-crumb a:hover{ text-decoration:underline; }
.rr-crumb .sep{ color:color-mix(in srgb,var(--text) 24%,transparent); }

.rr{ position:relative; padding:26px 26px 22px; border-radius:18px; overflow:hidden;
  background:var(--rr-glass-bg); border:1px solid var(--rr-glass-border); box-shadow:var(--rr-shadow);
  -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px); }
.rr::before{ content:""; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,var(--rv),var(--rv-2)); }
.rr-top{ display:flex; align-items:center; gap:11px; flex-wrap:wrap; margin-bottom:16px; }
.rr-logo{ width:38px; height:38px; border-radius:10px; flex:none; display:grid; place-items:center;
  font-family:var(--num); font-weight:700; font-size:14px; color:#fff; letter-spacing:-.02em;
  background:linear-gradient(150deg,var(--rv),var(--rv-2)); box-shadow:inset 0 1px 0 rgba(255,255,255,.28); }
.rr-inst{ font-size:14px; font-weight:800; color:var(--text); }
.rr-desk{ font-size:12.5px; color:var(--muted); }
.stamp{ display:inline-flex; align-items:center; gap:5px; font-family:var(--num); font-size:10px; font-weight:700;
  letter-spacing:.1em; text-transform:uppercase; padding:3px 9px; border-radius:6px; border:1.5px solid currentColor; }
.stamp.buy{ color:var(--buy); } .stamp.sell{ color:var(--sell); } .stamp.indep{ color:var(--indep); }
.stamp .dt{ width:5px; height:5px; border-radius:50%; background:currentColor; }

.rr h1{ font-weight:800; font-size:clamp(23px,3.3vw,32px); line-height:1.16; letter-spacing:-.02em; color:var(--text); margin:0 0 14px; }
.rr-meta{ display:flex; align-items:center; gap:8px 14px; flex-wrap:wrap; font-family:var(--num); font-size:12px;
  color:var(--muted); font-variant-numeric:tabular-nums; margin-bottom:16px; }
.rr-meta .m-ico{ display:inline-flex; align-items:center; gap:6px; } .rr-meta svg{ width:13px; height:13px; opacity:.75; }
.rr-tks{ display:flex; gap:6px; flex-wrap:wrap; }
.rr-tk{ font-family:var(--num); font-size:11px; font-weight:700; color:var(--rv-ink); padding:2px 8px; border-radius:6px;
  background:var(--rv-dim); border:1px solid color-mix(in srgb,var(--rv) 22%,transparent); }
html[data-theme="light"] .rr-tk{ color:var(--rv); }
.rr-tag{ font-size:11px; font-weight:600; color:var(--muted); padding:2px 8px; border-radius:6px; background:color-mix(in srgb,var(--text) 6%,transparent); }

.rr-teaser{ font-size:16px; line-height:1.6; color:color-mix(in srgb,var(--text) 90%,var(--muted));
  padding:16px 0 4px; border-top:1px solid color-mix(in srgb,var(--text) 8%,transparent); }
.rr-teaser .lead{ font-family:var(--num); font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
  color:var(--muted); display:block; margin-bottom:8px; }

/* the paywall (the gated part — matches the JSON-LD hasPart cssSelector) */
.rr-gate{ margin-top:20px; padding:22px; border-radius:14px; text-align:center;
  background:radial-gradient(120% 130% at 50% 0%, var(--rv-dim), transparent 70%), color-mix(in srgb,var(--rr-glass-bg) 92%,transparent);
  border:1px solid color-mix(in srgb,var(--rv) 26%,transparent); }
.rr-gate .lk{ width:30px; height:30px; color:var(--rv); opacity:.92; }
html[data-theme="light"] .rr-gate .lk{ color:var(--rv); }
.rr-gate h2{ margin:8px 0 6px; font-size:18px; font-weight:800; color:var(--text); }
.rr-gate p{ margin:0 auto 15px; font-size:13.5px; line-height:1.5; color:var(--muted); max-width:46ch; }
.rr-cta{ display:inline-flex; align-items:center; gap:8px; padding:12px 22px; border-radius:11px; font-weight:800; font-size:14px;
  color:#fff; text-decoration:none; background:linear-gradient(120deg,var(--rv),color-mix(in srgb,var(--rv) 74%,var(--rv-2)));
  box-shadow:0 8px 20px -8px var(--rv-glow); transition:.16s; }
.rr-cta:hover{ filter:brightness(1.06); transform:translateY(-1px); }
.rr-cta svg{ width:16px; height:16px; }

.rr-rel{ margin-top:34px; }
.rr-rel h3{ font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:var(--muted); margin:0 0 12px; }
.rr-rel ul{ list-style:none; margin:0; padding:0; display:grid; gap:9px; }
.rr-rel a{ display:block; padding:13px 15px; border-radius:12px; text-decoration:none; color:var(--text);
  background:var(--rr-glass-bg); border:1px solid var(--rr-glass-border); transition:.16s; }
.rr-rel a:hover{ border-color:color-mix(in srgb,var(--rv) 40%,var(--rr-glass-border)); transform:translateY(-1px); }
.rr-rel .r-inst{ font-family:var(--num); font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--rv-ink); }
html[data-theme="light"] .rr-rel .r-inst{ color:var(--rv); }
.rr-rel .r-title{ font-size:14px; font-weight:600; color:var(--text); margin-top:3px; line-height:1.35; }

.rr-foot{ margin-top:38px; padding-top:20px; border-top:1px solid color-mix(in srgb,var(--text) 8%,transparent);
  font-size:12px; line-height:1.6; color:var(--muted); }
.rr-foot b{ color:color-mix(in srgb,var(--text) 80%,var(--muted)); font-weight:700; }
.rr-foot a{ color:var(--rv-ink); text-decoration:none; font-weight:600; } html[data-theme="light"] .rr-foot a{ color:var(--rv); }
.rr-foot a:hover{ text-decoration:underline; }

@media (prefers-reduced-motion:reduce){ .rr-cta:hover,.rr-rel a:hover{ transform:none; } }
</style>
</head>
<body>
{% include "_site_nav.html.j2" %}
<div class="rr-aurora" aria-hidden="true"></div>

<main class="rr-wrap">
  <nav class="rr-crumb" aria-label="Breadcrumb">
    <a href="../research_vault.html">{{ t('Research Vault', '研报库') }}</a>
    <span class="sep">/</span><span>{{ n.inst }}</span>
  </nav>

  <article class="rr">
    <div class="rr-top">
      <span class="rr-logo">{{ n.mono }}</span>
      <span class="rr-inst">{{ n.inst }}</span>
      {% if n.desk %}<span class="rr-desk">· {{ n.desk }}</span>{% endif %}
      <span class="stamp {{ n.stamp_cls }}"><span class="dt"></span>{{ n.stamp }}</span>
    </div>

    <h1>{{ n.title }}</h1>

    <div class="rr-meta">
      {% if n.date_disp %}<span class="m-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>{{ n.date_disp }}</span>{% endif %}
      {% if n.pages %}<span class="m-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>{{ n.pages }} {{ t('pages', '页') }}</span>{% endif %}
      {% if n.tickers %}<span class="rr-tks">{% for tk in n.tickers %}<span class="rr-tk">{{ tk }}</span>{% endfor %}</span>{% endif %}
      {% if n.tags %}{% for tg in n.tags %}<span class="rr-tag">{{ tg }}</span>{% endfor %}{% endif %}
    </div>

    {% if n.teaser %}
    <p class="rr-teaser"><span class="lead">{{ t('From the report', '报告摘录') }}</span>{{ n.teaser }}</p>
    {% endif %}

    <div class="rr-gate">
      <svg class="lk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <h2>{{ t('Read the full report + PDF', '阅读全文与 PDF') }}</h2>
      <p>
        <span class="l-en">The full summary{% if n.n_points > 1 %} ({{ n.n_points }} key points){% endif %} and the original {{ n.inst }} PDF are for Mastermind Pro members.</span>
        <span class="l-zh">完整摘要{% if n.n_points > 1 %}（{{ n.n_points }} 个要点）{% endif %}与 {{ n.inst }} 原始 PDF 为 Mastermind Pro 会员专享。</span>
      </p>
      <a class="rr-cta" href="../research_vault.html?doc={{ n.id }}">
        {{ t('Read on Mastermind', '前往 Mastermind 阅读') }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </article>

  {% if related %}
  <section class="rr-rel">
    <h3>{{ t('Related institutional research', '相关机构研报') }}</h3>
    <ul>
      {% for r in related %}
      <li><a href="{{ r.slug }}.html"><span class="r-inst">{{ r.inst }}</span><span class="r-title">{{ r.title }}</span></a></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <p class="rr-foot">
    <span class="l-en"><b>Not investment advice.</b> Mastermind hosts third-party institutional research for reference and education; ratings and views are the authors', not ours. <a href="../research_vault.html">Browse the full Research Vault →</a></span>
    <span class="l-zh"><b>非投资建议。</b>Mastermind 仅收录第三方机构研究，供参考与学习；其中评级与观点均属作者本人。<a href="../research_vault.html">浏览完整研报库 →</a></span>
  </p>
</main>
<script src="../theme.js"></script>
</body>
</html>
