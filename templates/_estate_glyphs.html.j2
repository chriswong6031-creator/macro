{#-- dispatch: slug → glyph macro. Register new calculators here (one line). --#}
{%- macro glyph(slug, variant='card') -%}
  {%- set v = 'egl-crown' if variant == 'crown' else 'egl-card' -%}
  <svg class="egl {{ v }}" viewBox="0 0 64 40" preserveAspectRatio="xMidYMid meet"
       fill="none" aria-hidden="true" focusable="false">
  {%- if slug == 'position-size' -%}{{ _g_position_size() }}
  {%- elif slug == 'risk-reward' -%}{{ _g_risk_reward() }}
  {%- elif slug == 'trade-profit' -%}{{ _g_trade_profit() }}
  {%- elif slug == 'compounding' -%}{{ _g_compounding() }}
  {%- elif slug == 'cagr' -%}{{ _g_cagr() }}
  {%- elif slug == 'drawdown-recovery' -%}{{ _g_drawdown_recovery() }}
  {%- elif slug == 'retirement' -%}{{ _g_retirement() }}
  {%- elif slug == 'roi' -%}{{ _g_roi() }}
  {%- elif slug == 'dividend' -%}{{ _g_dividend() }}
  {%- elif slug == 'dollar-cost-averaging' -%}{{ _g_dollar_cost_averaging() }}
  {%- elif slug == 'rule-of-72' -%}{{ _g_rule_of_72() }}
  {%- elif slug == 'percentage-gain-loss' -%}{{ _g_percentage_gain_loss() }}
  {%- elif slug == 'savings-goal' -%}{{ _g_savings_goal() }}
  {%- elif slug == 'inflation' -%}{{ _g_inflation() }}
  {%- elif slug == 'net-worth' -%}{{ _g_net_worth() }}
  {%- elif slug == 'options-profit' -%}{{ _g_options_profit() }}
  {%- elif slug == 'stock-average' -%}{{ _g_stock_average() }}
  {%- elif slug == 'margin' -%}{{ _g_margin() }}
  {%- elif slug == 'forex-pip-value' -%}{{ _g_forex_pip_value() }}
  {%- elif slug == 'short-selling' -%}{{ _g_short_selling() }}
  {%- elif slug == 'covered-call' -%}{{ _g_covered_call() }}
  {%- elif slug == 'stop-loss-take-profit' -%}{{ _g_stop_loss_take_profit() }}
  {%- elif slug == 'kelly-criterion' -%}{{ _g_kelly_criterion() }}
  {%- elif slug == 'sharpe-ratio' -%}{{ _g_sharpe_ratio() }}
  {%- elif slug == 'portfolio-rebalancing' -%}{{ _g_portfolio_rebalancing() }}
  {%- elif slug == 'risk-of-ruin' -%}{{ _g_risk_of_ruin() }}
  {%- else -%}{{ _g_default() }}
  {%- endif -%}
  </svg>
{%- endmacro -%}
