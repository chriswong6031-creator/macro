{% extends "report_base.html.j2" %}

{# XG-W7: no X follow line on the China desks — x.com is unreachable behind
   the GFW, so the CTA would be a dead link for this page's core audience. #}
{% block foot_social %}{% endblock %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}
{% set CN = china_news or {} %}
{% set news = CN.news or {} %}
{% set heads = news.headlines if news and news.headlines else [] %}
{% set SYN = (news.synthesis if news and news.synthesis else {}) %}
{% set SYN_THEMES = (SYN.top_themes if SYN.top_themes else []) %}
{% set SYN_TICKERS = (SYN.top_tickers if SYN.top_tickers else []) %}
{% set SYN_SOURCES = (SYN.source_mix if SYN.source_mix else []) %}
{% set lead = heads[0] if heads else none %}
{# Glance-surface chips never show raw slugs or internal scorer strings: channels
   and source tiers map through the engine's bilingual label dicts, and
   importance_reasons stay machine-only in the payload (doctrine Law 2). #}
{% set CHL = CN.channel_label or {} %}
{% set THL = CN.theme_label or {} %}
{% set TIERL = CN.tier_label or {} %}
{% set IMP_ZH = {'high': '高', 'medium': '中', 'low': '低'} %}
{% set TONE_WORD = {'supportive': ['leans supportive', '偏积极'], 'cautious': ['leans cautious', '偏谨慎'], 'steady': ['steady', '平稳'], 'building': ['still building', '积累中'], 'unknown': ['unavailable', '暂无']} %}
{# recognized China exposures — a ticker is a market identifier the reader knows,
   not an internal slug; the plain-word name makes the exposure legible. #}
{% set TKN = {
  '510300.SS': ['CSI 300', '沪深300'], 'ASHR': ['A-shares', 'A股'], 'CNYA': ['China A', '中国A股'],
  'MCHI': ['MSCI China', 'MSCI中国'], 'FXI': ['China large-cap', '中国大盘'], '2800.HK': ['Hang Seng', '恒生'],
  '2822.HK': ['China A50', 'A50'], 'KWEB': ['China internet', '中概互联'], 'CNY': ['yuan', '人民币'],
  'CNH': ['offshore yuan', '离岸人民币'], 'CBON': ['China bonds', '中国债券'], '512800.SS': ['banks', '银行'],
  '512880.SS': ['brokers', '券商'], '512200.SS': ['property', '房地产'], '512760.SS': ['chips', '半导体'],
  '515030.SS': ['EV & battery', '新能源车'], '512400.SS': ['metals', '有色']
} %}

{% block title %}China Tape — Macro Dashboard{% endblock %}

{%- block head_extra %}
{% set seo_title = "China News Feed — Mastermind" %}
{% set seo_desc = "China market news distilled — what moved, why it matters and which groups care, timestamped through each session." %}
{% set seo_path = "china_news.html" %}
{%- include "_seo_head.html.j2" %}
{%- endblock %}

{% block base_css %}
  body { padding-bottom:56px; }
  @media(min-width:1220px){ body{ padding-left:max(18px,calc((100vw - 1216px)/2)); padding-right:max(18px,calc((100vw - 1216px)/2)); } }
  .cn { max-width:1180px; margin:0 auto; }
  /* channel identity hues — category, not price-direction, so no zh red/green flip */
  .th-monetary{--ch:#5b8def}.th-inflation{--ch:#e08b45}.th-growth{--ch:#6cb85a}.th-credit{--ch:#a78bfa}
  .th-fiscal{--ch:#e0a030}.th-policy{--ch:#d0554f}.th-politics{--ch:#c86b8a}.th-tech{--ch:#3fb6c0}
  .th-markets{--ch:#3bb277}.th-macro{--ch:var(--muted)}

  /* ---------- hero ---------- */
  .cn-hero{ padding:26px 0 6px; animation:cnUp .5s cubic-bezier(.2,.7,.3,1) both; }
  .cn-eyebrow{ display:flex; align-items:center; gap:9px; font-size:12px; font-weight:800; color:var(--muted); letter-spacing:.02em; }
  .cn-brand{ font-weight:850; font-size:20px; letter-spacing:-.01em; color:var(--text); }
  .cn-brand .gn{ background:linear-gradient(92deg,#d0554f,#e0a030 52%,#3fb6c0); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .cn-live{ width:8px; height:8px; border-radius:50%; background:var(--up); box-shadow:0 0 0 4px color-mix(in srgb,var(--up) 15%,transparent); animation:cnBreathe 2.6s ease-in-out infinite; }
  .cn-lead{ font-size:clamp(19px,2.5vw,25px); line-height:1.32; font-weight:800; color:var(--text); letter-spacing:-.018em; margin:15px 0 0; max-width:60ch; font-family:Inter,-apple-system,sans-serif; }
  .cn-lead b{ color:var(--text); }
  .cn-lead .q{ color:var(--muted); font-weight:800; }
  .cn-asof{ display:inline-flex; align-items:center; gap:7px; font-size:12px; color:var(--muted); margin-top:10px; }
  .cn-glance{ display:flex; flex-wrap:wrap; gap:8px; margin-top:16px; }
  .cn-gchip{ display:inline-flex; align-items:center; gap:7px; padding:7px 13px; border-radius:999px; border:1px solid var(--line); background:var(--panel); font-size:12.5px; font-weight:600; color:var(--text); }
  .cn-gchip b{ font-weight:850; }
  .cn-gchip .dot{ width:7px; height:7px; border-radius:50%; background:var(--c,var(--muted)); flex:none; }
  .cn-gchip.st-supportive{ --c:var(--up); } .cn-gchip.st-cautious{ --c:var(--warn); } .cn-gchip.st-steady,.cn-gchip.st-building{ --c:var(--muted); }
  .cn-gchip.hot{ border-color:color-mix(in srgb,#d0554f 40%,var(--line)); color:#d0554f; } .cn-gchip.hot .dot{ background:#d0554f; }
  .cn-gchip.led .dot{ background:var(--ch,var(--link)); }

  /* ---------- overview 3-up (the dashboard) ---------- */
  .cn-rail3{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin:22px 0 4px; }
  .ov-card{ position:relative; background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:18px 18px 15px; overflow:hidden; box-shadow:var(--card-shadow); animation:cnUp .5s cubic-bezier(.2,.7,.3,1) both; }
  .cn-rail3 .ov-card:nth-child(2){ animation-delay:.06s; } .cn-rail3 .ov-card:nth-child(3){ animation-delay:.12s; }
  .ov-card::before{ content:''; position:absolute; inset:0 0 auto 0; height:3px; background:var(--ac,var(--link)); }
  .ov-tone{ --ac:var(--up); } .ov-mix{ --ac:#e0a030; } .ov-next{ --ac:#3fb6c0; }
  .ov-h{ display:flex; align-items:center; gap:8px; font-size:11px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); margin:0 0 12px; }
  html[data-lang="zh"] .ov-h{ letter-spacing:.02em; }
  .ov-h .ic{ font-size:13px; }
  .ov-foot{ font-size:11px; color:var(--muted); margin-top:12px; padding-top:10px; border-top:1px solid var(--line); line-height:1.5; }

  /* tone gauge */
  .tg-top{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
  .tg-state{ font-size:20px; font-weight:850; color:var(--text); letter-spacing:-.01em; line-height:1.15; }
  .tg-z{ font-size:24px; font-weight:850; font-variant-numeric:tabular-nums; color:var(--ac); }
  .tg-track{ position:relative; height:8px; border-radius:999px; background:color-mix(in srgb,var(--muted) 22%,transparent); margin:14px 0 4px; }
  .tg-track .mid{ position:absolute; left:50%; top:-3px; bottom:-3px; width:1px; background:var(--muted); opacity:.5; }
  .tg-fill{ position:absolute; top:0; bottom:0; border-radius:999px; background:var(--ac); animation:cnGrow .7s cubic-bezier(.2,.7,.3,1) both; }
  .tg-scale{ display:flex; justify-content:space-between; font-size:9.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--muted); margin-top:5px; }
  .ov-empty{ font-size:13px; color:var(--muted); padding:6px 0 10px; }

  /* tape mix bars */
  .mx-row{ display:grid; grid-template-columns:74px 1fr 26px; align-items:center; gap:9px; padding:4px 0; }
  .mx-name{ font-size:11.5px; font-weight:700; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .mx-bar{ height:7px; border-radius:999px; background:color-mix(in srgb,var(--muted) 18%,transparent); overflow:hidden; }
  .mx-bar i{ display:block; height:100%; border-radius:999px; background:var(--ch,var(--link)); transform-origin:left; animation:cnGrow .7s cubic-bezier(.2,.7,.3,1) both; }
  .mx-n{ font-size:11.5px; font-weight:800; font-variant-numeric:tabular-nums; color:var(--muted); text-align:right; }

  /* next catalyst */
  .nx-when{ display:inline-flex; align-items:baseline; gap:6px; }
  .nx-days{ font-size:30px; font-weight:850; font-variant-numeric:tabular-nums; color:var(--text); line-height:1; letter-spacing:-.02em; }
  .nx-unit{ font-size:12px; font-weight:700; color:var(--muted); }
  .nx-name{ font-size:14px; font-weight:750; color:var(--text); margin:9px 0 2px; line-height:1.3; }
  .nx-date{ font-size:11.5px; color:var(--muted); }

  /* ---------- main: the tape + rail ---------- */
  .cn-main{ display:grid; grid-template-columns:minmax(0,1fr) 300px; gap:20px; align-items:start; margin-top:30px; }
  .cn-toolbar{ position:sticky; top:0; z-index:5; display:flex; flex-wrap:wrap; gap:9px; align-items:center; padding:10px 0 12px; background:linear-gradient(180deg,var(--bg) 74%,transparent); }
  .cn-search{ position:relative; flex:1 1 240px; min-width:190px; }
  .cn-search input{ width:100%; background:var(--panel); border:1px solid var(--line); color:var(--text); border-radius:9px; padding:9px 12px 9px 33px; outline:none; font-size:13px; }
  .cn-search input:focus{ border-color:var(--link); box-shadow:0 0 0 3px color-mix(in srgb,var(--link) 16%,transparent); }
  .cn-search .mag{ position:absolute; left:11px; top:50%; transform:translateY(-50%); color:var(--muted); font-size:14px; }
  .cn-filters{ display:flex; flex-wrap:wrap; gap:6px; }
  .fbtn{ display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line); background:var(--panel); color:var(--muted); border-radius:999px; padding:6px 11px; font-size:11.5px; font-weight:600; cursor:pointer; }
  .fbtn:hover{ color:var(--text); border-color:color-mix(in srgb,var(--link) 45%,var(--line)); }
  .fbtn.on{ color:var(--text); border-color:var(--link); background:color-mix(in srgb,var(--link) 12%,var(--panel)); }
  .fbtn .fc{ font-size:10.5px; font-weight:800; font-variant-numeric:tabular-nums; color:var(--muted); }
  .fbtn.on .fc{ color:var(--link); }
  .fbtn.hidden{ display:none; }
  .cn-count{ margin-left:auto; color:var(--muted); font-size:12px; white-space:nowrap; }

  /* the tape */
  .tp-feed{ position:relative; }
  .tp-item{ display:grid; grid-template-columns:56px 20px minmax(0,1fr); gap:0 13px; padding:0 0 16px; color:var(--text); position:relative; animation:cnUp .45s cubic-bezier(.2,.7,.3,1) both; }
  .tp-when{ grid-column:1; text-align:right; font-size:11.5px; font-weight:700; font-variant-numeric:tabular-nums; color:var(--muted); padding-top:17px; line-height:1.3; white-space:nowrap; }
  .tp-spine{ grid-column:2; position:relative; }
  .tp-spine::before{ content:''; position:absolute; left:50%; transform:translateX(-50%); top:27px; bottom:-16px; width:2px; background:linear-gradient(180deg,color-mix(in srgb,var(--ch,var(--muted)) 45%,var(--line)),color-mix(in srgb,var(--muted) 22%,transparent)); }
  .tp-item:last-child .tp-spine::before{ display:none; }
  .tp-node{ position:absolute; left:50%; top:19px; transform:translateX(-50%); width:12px; height:12px; border-radius:50%; background:var(--ch,var(--muted)); border:3px solid var(--bg); z-index:1; }
  .tp-node.fresh-live{ box-shadow:0 0 0 4px color-mix(in srgb,var(--ch,var(--up)) 20%,transparent); }
  .tp-node.fresh-old{ background:color-mix(in srgb,var(--ch,var(--muted)) 45%,var(--muted)); opacity:.75; }
  .tp-body{ grid-column:3; min-width:0; background:var(--panel); border:1px solid color-mix(in srgb,var(--ch,var(--muted)) 16%,var(--line)); border-left:3px solid color-mix(in srgb,var(--ch,var(--muted)) 62%,var(--line)); border-radius:5px 13px 13px 5px; padding:13px 15px; box-shadow:var(--card-shadow); transition:transform .16s,border-color .16s,box-shadow .16s; }
  .tp-item:hover .tp-body{ transform:translateY(-2px); border-color:color-mix(in srgb,var(--ch,var(--link)) 45%,var(--line)); border-left-color:var(--ch,var(--link)); box-shadow:0 14px 30px -20px color-mix(in srgb,var(--ch,var(--link)) 55%,transparent); }
  .tp-top{ display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-bottom:8px; }
  .cn-tag{ display:inline-flex; align-items:center; gap:5px; padding:3px 9px; border-radius:7px; font-size:10.5px; font-weight:700; letter-spacing:.01em; color:var(--ch,var(--link)); background:color-mix(in srgb,var(--ch,var(--link)) 12%,var(--panel)); border:1px solid color-mix(in srgb,var(--ch,var(--link)) 26%,var(--line)); }
  .cn-src{ font-size:11.5px; font-weight:700; color:var(--muted); }
  .cn-imp{ display:inline-flex; align-items:center; gap:5px; margin-left:auto; font-size:10.5px; font-weight:700; padding:3px 9px; border-radius:7px; border:1px solid var(--line); color:var(--muted); }
  .cn-imp b{ font-variant-numeric:tabular-nums; }
  .cn-imp.imp-high{ color:var(--up); border-color:color-mix(in srgb,var(--up) 45%,var(--line)); background:color-mix(in srgb,var(--up) 9%,var(--panel)); }
  .cn-imp.imp-medium{ color:var(--warn); border-color:color-mix(in srgb,var(--warn) 42%,var(--line)); }
  .tp-title{ font-size:15.5px; line-height:1.32; font-weight:730; margin:0; color:var(--text); }
  .tp-item:hover .tp-title{ color:var(--ch,var(--link)); }
  .tp-sum{ color:var(--muted); font-size:12.5px; line-height:1.5; margin:7px 0 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .tp-chips{ display:flex; flex-wrap:wrap; gap:5px; margin-top:9px; }
  .cn-cchip{ font-size:10.5px; font-weight:600; color:var(--muted); background:color-mix(in srgb,var(--muted) 11%,transparent); border-radius:6px; padding:2px 8px; }
  .cn-tk{ font-size:10.5px; font-weight:800; font-variant-numeric:tabular-nums; color:var(--link); background:color-mix(in srgb,var(--link) 11%,transparent); border-radius:6px; padding:2px 8px; }
  /* the lead story sits larger at the head of the tape */
  .tp-item.lead .tp-body{ border-color:color-mix(in srgb,var(--ch,var(--link)) 28%,var(--line)); border-left-color:var(--ch,var(--link)); background:linear-gradient(180deg,color-mix(in srgb,var(--ch,var(--link)) 5%,var(--panel)),var(--panel)); }
  .tp-item.lead .tp-title{ font-size:19px; line-height:1.26; font-weight:800; letter-spacing:-.01em; }
  .tp-item.lead .tp-sum{ -webkit-line-clamp:3; font-size:13px; }
  .tp-item.lead .tp-node{ width:14px; height:14px; }

  /* ---------- rail (context alongside the tape) ---------- */
  .cn-side{ display:grid; gap:16px; position:sticky; top:12px; }
  .side-card{ background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:15px 16px; box-shadow:var(--card-shadow); }
  .sc-h{ display:flex; align-items:center; gap:7px; margin:0 0 11px; font-size:10.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  html[data-lang="zh"] .sc-h{ letter-spacing:.02em; }
  .cal-row{ display:grid; grid-template-columns:52px 1fr; gap:11px; align-items:start; padding:9px 0; border-bottom:1px solid var(--line); }
  .cal-row:last-child{ border-bottom:0; padding-bottom:0; }
  .cal-when{ text-align:center; }
  .cal-when .cd{ font-size:16px; font-weight:850; font-variant-numeric:tabular-nums; color:var(--text); line-height:1; }
  .cal-when .cu{ font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); display:block; margin-top:2px; }
  .cal-when.soon .cd{ color:#d0554f; }
  .cal-name{ font-size:12px; font-weight:600; color:var(--text); line-height:1.35; min-width:0; }
  .cal-tag{ display:inline-block; font-size:9.5px; font-weight:800; letter-spacing:.03em; text-transform:uppercase; color:var(--muted); background:color-mix(in srgb,var(--muted) 13%,transparent); border-radius:5px; padding:1px 6px; margin-right:6px; vertical-align:1px; }
  .cal-tag.hi{ color:#d0554f; background:color-mix(in srgb,#d0554f 12%,transparent); }
  .exp-pills{ display:flex; flex-wrap:wrap; gap:6px; }
  .exp-pill{ display:inline-flex; flex-direction:column; gap:1px; padding:6px 10px; border-radius:9px; border:1px solid var(--line); background:var(--panel2); min-width:0; }
  .exp-pill .tk{ font-size:11.5px; font-weight:850; font-variant-numeric:tabular-nums; color:var(--link); }
  .exp-pill .nm{ font-size:10px; color:var(--muted); }
  .exp-pill .ct{ font-size:9.5px; font-weight:700; color:var(--muted); }
  .sc-empty{ font-size:12px; color:var(--muted); }

  /* ---------- empty state + disclaimer ---------- */
  .cn-empty{ background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:34px 28px; text-align:center; box-shadow:var(--card-shadow); }
  .cn-empty h2{ font-size:20px; color:var(--text); margin:0 0 8px; letter-spacing:-.01em; }
  .cn-empty p{ color:var(--muted); font-size:13.5px; margin:0; }
  .cn-none{ padding:30px 24px; text-align:center; background:var(--panel); border:1px dashed var(--line); border-radius:14px; }
  .cn-none h3{ font-size:15px; margin:0 0 6px; color:var(--text); }
  .cn-none p{ color:var(--muted); font-size:12.5px; margin:0; }
  .cn-disc{ color:var(--muted); font-size:11.5px; line-height:1.6; margin:26px 0 0; padding-top:14px; border-top:1px solid var(--line); }
  .hidden{ display:none !important; }

  @keyframes cnUp{ from{ opacity:0; transform:translateY(10px); } to{ opacity:1; transform:none; } }
  @keyframes cnBreathe{ 0%,100%{ opacity:.5; transform:scale(.82); } 50%{ opacity:1; transform:scale(1.08); } }
  @keyframes cnGrow{ from{ transform:scaleX(0); } to{ transform:scaleX(1); } }

  @media(max-width:940px){ .cn-rail3{ grid-template-columns:1fr; } .cn-main{ grid-template-columns:1fr; } .cn-side{ position:static; } }
  @media(max-width:560px){
    .cn-toolbar{ position:static; }
    .tp-item{ grid-template-columns:1fr; gap:0; }
    .tp-spine{ display:none; }
    .tp-when{ grid-column:1; text-align:left; padding:0 0 6px; }
    .tp-body{ grid-column:1; }
  }
  @media (prefers-reduced-motion: reduce){
    .cn-hero,.ov-card,.tp-item,.cn-live,.tg-fill,.mx-bar i{ animation:none; }
    *{ transition:none !important; }
  }
{% endblock %}

{% block content %}
<main class="cn">

  <!-- ===================== HERO ===================== -->
  <header class="cn-hero">
    <p class="cn-eyebrow"><span class="cn-live"></span><span class="cn-brand">📡 <span class="gn">{{ t('China Tape', '中国快讯') }}</span></span></p>
    {% if lead %}
      {% set nhi = SYN.high_impact_count or 0 %}
      {% set domc = SYN.dominant_channel or SYN.dominant_theme %}
      {% set doml = CHL.get(domc) or THL.get(domc) or [domc|replace('_',' '), domc|replace('_',' ')] %}
      {% set tw = TONE_WORD.get(CN.tone.band, TONE_WORD['unknown']) if CN.tone else none %}
      <p class="cn-lead">
        <span class="l-en"><b>{{ heads|length }}</b> stor{{ 'y' if heads|length == 1 else 'ies' }} cleared the macro filter{% if tw %}; official policy tone {{ tw[0] }}{% endif %}. {% if nhi %}<b>{{ nhi }}</b> rated high-impact{% if domc %}, led by <b>{{ doml[0] }}</b>{% endif %}.{% else %}None rated high-impact right now.{% endif %}</span>
        <span class="l-zh"><b>{{ heads|length }}</b> 条通过宏观筛选{% if tw %}；官方政策基调{{ tw[1] }}{% endif %}。{% if nhi %}其中 <b>{{ nhi }}</b> 条高影响{% if domc %}，主导<b>{{ doml[1] }}</b>{% endif %}。{% else %}当前暂无高影响条目。{% endif %}</span>
      </p>
      <p class="cn-asof">{{ t('As of', '截至') }} {{ asof or '' }} · {{ t('context, not trade calls', '仅为背景，非交易信号') }}</p>
      <div class="cn-glance">
        {% if CN.tone %}
        {% set tw2 = TONE_WORD.get(CN.tone.band, TONE_WORD['unknown']) %}
        <span class="cn-gchip st-{{ CN.tone.band }}"><span class="dot"></span>{{ t('Policy tone', '政策基调') }} <b>{{ t(tw2[0], tw2[1]) }}</b></span>
        {% endif %}
        {% if SYN.high_impact_count %}<span class="cn-gchip hot"><span class="dot"></span><b>{{ SYN.high_impact_count }}</b> {{ t('high-impact', '高影响') }}</span>{% endif %}
        {% if domc %}<span class="cn-gchip led th-{{ SYN.dominant_theme or 'macro' }}"><span class="dot"></span>{{ t('Led by', '主导') }} <b>{{ t(doml[0], doml[1]) }}</b></span>{% endif %}
        <span class="cn-gchip"><b>{{ heads|length }}</b> {{ t('on the tape', '条在流') }}</span>
        <span class="cn-gchip hidden" id="fresh"><span class="dot" style="background:var(--up)"></span><span id="fresh-t"></span></span>
      </div>
    {% else %}
      <p class="cn-lead">{{ t('The China macro tape is quiet right now.', '当前中国宏观新闻流较安静。') }}</p>
      <p class="cn-asof">{{ t('As of', '截至') }} {{ asof or '' }} · {{ t('context, not trade calls', '仅为背景，非交易信号') }}</p>
    {% endif %}
  </header>

  {% if lead %}
  <!-- ===================== OVERVIEW 3-UP ===================== -->
  <section class="cn-rail3">

    <!-- policy tone -->
    <article class="ov-card ov-tone {{ 'st-'~CN.tone.band if CN.tone }}" {% if CN.tone %}style="--ac:{{ '#3bb277' if CN.tone.band == 'supportive' else 'var(--warn)' if CN.tone.band == 'cautious' else 'var(--muted)' }}"{% endif %}>
      <p class="ov-h"><span class="ic">🏛️</span>{{ t('Policy tone', '政策基调') }}</p>
      {% if CN.tone %}
      {% set tw3 = TONE_WORD.get(CN.tone.band, TONE_WORD['unknown']) %}
      <div class="tg-top">
        <div class="tg-state">{{ t(tw3[0], tw3[1]) }}</div>
        <div class="tg-z">{{ '%+.1f'|format(CN.tone.z) }}</div>
      </div>
      {% set zpos = ((CN.tone.z if CN.tone.z > -2.5 else -2.5) if CN.tone.z < 2.5 else 2.5) %}
      {% set pct = ((zpos + 2.5) / 5 * 100)|round(1) %}
      <div class="tg-track"><span class="mid"></span>
        {% if pct >= 50 %}<span class="tg-fill" style="left:50%;width:{{ (pct-50)|round(1) }}%"></span>{% else %}<span class="tg-fill" style="right:50%;width:{{ (50-pct)|round(1) }}%"></span>{% endif %}
      </div>
      <div class="tg-scale"><span>{{ t('cautious', '谨慎') }}</span><span>{{ t('neutral', '中性') }}</span><span>{{ t('supportive', '积极') }}</span></div>
      <p class="ov-foot">{{ t('CCTV 新闻联播 tone · z-score vs', '央视《新闻联播》基调 · z 分数对比') }} {{ CN.tone.n_days }}{{ t('d baseline', '天基线') }} · {{ CN.tone.asof }}</p>
      {% else %}
      <p class="ov-empty">{{ t('Tone baseline is still building — not enough broadcast history yet.', '基调基线仍在积累——广播历史不足。') }}</p>
      {% endif %}
    </article>

    <!-- what's on the tape -->
    <article class="ov-card ov-mix">
      <p class="ov-h"><span class="ic">🌡️</span>{{ t("What's on the tape", '快讯结构') }}</p>
      {% if SYN_THEMES %}
        {% set mx = SYN_THEMES[:5] %}
        {% set top = mx[0].count if mx and mx[0].count else 1 %}
        {% for th in mx %}
        {% set tl = THL.get(th.theme, [th.theme, th.theme]) %}
        <div class="mx-row th-{{ th.theme }}">
          <span class="mx-name">{{ t(tl[0], tl[1]) }}</span>
          <span class="mx-bar"><i style="width:{{ (100 * th.count / top)|round|int }}%"></i></span>
          <span class="mx-n">{{ th.count }}</span>
        </div>
        {% endfor %}
      {% else %}
      <p class="ov-empty">{{ t('No dominant theme cluster yet.', '暂无主导主题聚类。') }}</p>
      {% endif %}
      {% if SYN_SOURCES %}
      <p class="ov-foot">{{ t('Sources', '来源') }}: {% for s in SYN_SOURCES[:4] %}{% set sl = TIERL.get(s.tier) or [s.tier|replace('_',' '), s.tier|replace('_',' ')] %}{{ t(sl[0], sl[1]) }} {{ s.count }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% endif %}
    </article>

    <!-- next catalyst -->
    <article class="ov-card ov-next">
      <p class="ov-h"><span class="ic">📅</span>{{ t('Next catalyst', '下一催化') }}</p>
      {% set nx = event_strip[0] if event_strip else (calendar[0] if calendar else none) %}
      {% if nx %}
      <div class="nx-when">
        {% if nx.days_until is defined and nx.days_until is not none %}
          {% if nx.days_until <= 0 %}<span class="nx-days" style="color:#d0554f">{{ t('Today', '今日') }}</span>
          {% else %}<span class="nx-days">{{ nx.days_until }}</span><span class="nx-unit">{{ t('days out', '天后') }}</span>{% endif %}
        {% endif %}
      </div>
      <p class="nx-name">{{ t(nx.name_en, nx.name_zh) }}</p>
      <p class="nx-date">{% if nx.md %}{{ t(nx.md, nx.md_zh or nx.md) }}{% elif nx.date %}{{ nx.date }}{% endif %}{% if nx.importance == 'high' %} · <span style="color:#d0554f;font-weight:700">{{ t('high-impact print', '高影响数据') }}</span>{% endif %}</p>
      {% else %}
      <p class="ov-empty">{{ t('No top-tier China prints scheduled in the window.', '窗口内无一线中国数据排期。') }}</p>
      {% endif %}
    </article>
  </section>

  <!-- ===================== THE TAPE + RAIL ===================== -->
  <section class="cn-main">
    <div class="cn-feed-col">
      <div class="cn-toolbar">
        <div class="cn-search"><span class="mag">⌕</span><input id="q" type="search" autocomplete="off" placeholder="Search headlines, channels or tickers…" data-ph-en="Search headlines, channels or tickers…" data-ph-zh="搜索头条、通道或标的…"></div>
        <div class="cn-filters" id="filters">
          <button class="fbtn on" data-theme="all">{{ t('All', '全部') }}</button>
          <button class="fbtn" data-importance="high">{{ t('High impact', '高影响') }}</button>
          {% for key, labels in CN.theme_label.items() %}<button class="fbtn" data-theme="{{ key }}">{{ t(labels[0], labels[1]) }}<span class="fc" data-fc="{{ key }}"></span></button>{% endfor %}
        </div>
        <span class="cn-count" id="count"></span>
      </div>

      <div class="tp-feed" id="feed">
        {% for h in heads %}
        {% set chsearch = [] %}{% for c in h.channels[:5] %}{% set cl = CHL.get(c) or THL.get(c) %}{% if cl %}{% set _ = chsearch.append(cl[0] ~ ' ' ~ cl[1]) %}{% endif %}{% endfor %}
        <a class="tp-item th-{{ h.theme }}{{ ' lead' if loop.first }}" href="{{ h.url or '#' }}" target="_blank" rel="noopener"
           data-theme="{{ h.theme }}" data-importance="{{ h.importance }}"
           data-search="{{ (h.title ~ ' ' ~ (h.title_en or '') ~ ' ' ~ (h.title_zh or '') ~ ' ' ~ h.summary ~ ' ' ~ (h.summary_en or '') ~ ' ' ~ (h.summary_zh or '') ~ ' ' ~ h.source_name ~ ' ' ~ h.channels|join(' ') ~ ' ' ~ chsearch|join(' ') ~ ' ' ~ h.tickers|join(' '))|lower }}">
          <time class="tp-when" data-t="{{ h.time }}" {% if h.time %}datetime="{{ h.time }}"{% endif %}>{% if h.time and h.time[4] == '-' %}{{ h.time[5:10] }}{% if h.time[10:11] in ['T', ' '] and h.time[13:14] == ':' %}<br>{{ h.time[11:16] }}{% endif %}{% else %}—{% endif %}</time>
          <div class="tp-spine"><span class="tp-node" data-t="{{ h.time }}"></span></div>
          <div class="tp-body">
            <div class="tp-top">
              {% set tl = CN.theme_label.get(h.theme, [h.theme, h.theme]) %}
              <span class="cn-tag">{{ t(tl[0], tl[1]) }}</span>
              <span class="cn-src">{{ h.source_name or 'source' }}</span>
              <span class="cn-imp imp-{{ h.importance }}"><b>{{ h.importance_score }}</b> {{ t(h.importance, IMP_ZH.get(h.importance, h.importance)) }}</span>
            </div>
            <h2 class="tp-title"><span class="l-en">{{ h.title_en or h.title }}</span><span class="l-zh">{{ h.title_zh or h.title }}</span></h2>
            {% if h.summary %}<p class="tp-sum"><span class="l-en">{{ h.summary_en or h.summary }}</span><span class="l-zh">{{ h.summary_zh or h.summary }}</span></p>{% endif %}
            <div class="tp-chips">{% for c in h.channels[:4] %}{% set cl = CHL.get(c) or THL.get(c) or [c|replace('_',' '), c|replace('_',' ')] %}<span class="cn-cchip">{{ t(cl[0], cl[1]) }}</span>{% endfor %}{% for tk in h.tickers[:5] %}<span class="cn-tk">{{ tk }}</span>{% endfor %}</div>
          </div>
        </a>
        {% endfor %}
      </div>
      <div class="cn-none hidden" id="none"><h3>{{ t('No stories match that view.', '没有符合当前视图的新闻。') }}</h3><p>{{ t('Clear the search or switch back to All.', '清空搜索或切回全部。') }}</p></div>

      {% if CN.disclaimer %}<p class="cn-disc">{{ t(CN.disclaimer, CN.disclaimer_zh) }}</p>{% endif %}
    </div>

    <aside class="cn-side">
      <section class="side-card">
        <h2 class="sc-h"><span>📅</span>{{ t('Scheduled catalysts', '排定催化') }}</h2>
        {% for c in calendar[:8] %}
        {% set soon = (c.days_until is defined and c.days_until is not none and c.days_until <= 3) %}
        <div class="cal-row">
          <div class="cal-when {{ 'soon' if soon }}">
            {% if c.days_until is defined and c.days_until is not none %}<span class="cd">{{ c.days_until if c.days_until > 0 else '·' }}</span><span class="cu">{{ t('days', '天') if c.days_until > 0 else t('today', '今') }}</span>{% elif c.date %}<span class="cd" style="font-size:12px">{{ c.date[5:] }}</span>{% endif %}
          </div>
          <div class="cal-name"><span class="cal-tag {{ 'hi' if c.importance == 'high' }}">{{ c.type|replace('_', ' ') }}</span>{{ t(c.name_en, c.name_zh) }}</div>
        </div>
        {% else %}<p class="sc-empty">{{ t('No scheduled catalysts in the window.', '窗口内无排定催化。') }}</p>{% endfor %}
      </section>

      {% if SYN_TICKERS %}
      <section class="side-card">
        <h2 class="sc-h"><span>🎯</span>{{ t('Exposures on the tape', '相关标的') }}</h2>
        <div class="exp-pills">
          {% for tk in SYN_TICKERS[:8] %}
          {% set tn = TKN.get(tk.ticker) %}
          <span class="exp-pill"><span class="tk">{{ tk.ticker }}</span>{% if tn %}<span class="nm">{{ t(tn[0], tn[1]) }}</span>{% endif %}{% if tk.count and tk.count > 1 %}<span class="ct">×{{ tk.count }}</span>{% endif %}</span>
          {% endfor %}
        </div>
      </section>
      {% endif %}
    </aside>
  </section>

  {% else %}
  <!-- ===================== EMPTY STATE ===================== -->
  <div class="cn-empty">
    <h2>{{ t('No filtered China headlines on this pull.', '本次抓取暂无筛选中国头条。') }}</h2>
    <p>{{ t('This can happen when official pages are quiet, the flash-wire fetch is unavailable, or no macro-relevant item cleared the gate. Policy tone and scheduled catalysts remain live.', '当官方页面安静、快讯抓取不可用，或没有宏观相关条目通过筛选时会出现这种情况。政策基调与排定催化仍保持更新。') }}</p>
  </div>
  {% if CN.disclaimer %}<p class="cn-disc">{{ t(CN.disclaimer, CN.disclaimer_zh) }}</p>{% endif %}
  {% endif %}
</main>
{% endblock %}

{% block body_scripts %}
<script>
(function(){
  var feed=document.getElementById('feed');
  var rows=feed ? Array.prototype.slice.call(feed.querySelectorAll('.tp-item')) : [];
  var q=document.getElementById('q'), filters=document.getElementById('filters'), count=document.getElementById('count'), none=document.getElementById('none');
  var theme='all', importance='all', term='';
  function isZh(){ return document.documentElement.getAttribute('data-lang')==='zh'; }

  /* ---- timestamps: relative age from the machine-readable ISO (tz-independent) ---- */
  var MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  function ageStr(ms, zh){
    var m=Math.max(0,(Date.now()-ms)/60000);
    if(m<2) return zh?'刚刚':'just now';
    if(m<60) return Math.round(m)+(zh?' 分钟前':'m ago');
    var h=m/60; if(h<24) return Math.round(h)+(zh?' 小时前':'h ago');
    var d=h/24; if(d<8) return Math.round(d)+(zh?' 天前':'d ago');
    var dt=new Date(ms); return zh?((dt.getMonth()+1)+'月'+dt.getDate()+'日'):(MON[dt.getMonth()]+' '+dt.getDate());
  }
  function freshClass(ms){ var h=(Date.now()-ms)/3600000; return h<=8?'fresh-live':(h<=36?'':'fresh-old'); }
  var freshest=null;
  function paintTimes(){
    var zh=isZh();
    rows.forEach(function(r){
      var when=r.querySelector('.tp-when'), node=r.querySelector('.tp-node');
      var iso=when&&when.getAttribute('data-t'); if(!iso){ return; }
      var ms=Date.parse(iso); if(isNaN(ms)){ return; }
      when.textContent=ageStr(ms, zh);
      when.setAttribute('title', iso);
      if(node){ node.classList.remove('fresh-live','fresh-old'); var fc=freshClass(ms); if(fc) node.classList.add(fc); }
      if(freshest===null||ms>freshest) freshest=ms;
    });
    var fw=document.getElementById('fresh'), ft=document.getElementById('fresh-t');
    if(fw&&ft){ if(freshest){ ft.textContent=(zh?'最新 ':'freshest ')+ageStr(freshest, zh); fw.classList.remove('hidden'); } else { fw.classList.add('hidden'); } }
  }

  /* ---- per-theme counts on the filter chips ---- */
  function paintCounts(){
    var tally={};
    rows.forEach(function(r){ var th=r.getAttribute('data-theme'); tally[th]=(tally[th]||0)+1; });
    Array.prototype.forEach.call(document.querySelectorAll('.fc[data-fc]'), function(el){
      var n=tally[el.getAttribute('data-fc')]||0;
      el.textContent=n?n:'';
      el.closest('.fbtn').classList.toggle('hidden', n===0);
    });
  }

  /* ---- search + theme/importance filter ---- */
  function apply(){
    var shown=0;
    rows.forEach(function(r){
      var okTheme=theme==='all'||r.getAttribute('data-theme')===theme;
      var okImp=importance==='all'||r.getAttribute('data-importance')===importance;
      var okQ=!term||(r.getAttribute('data-search')||'').indexOf(term)>=0;
      var show=okTheme&&okImp&&okQ;
      r.classList.toggle('hidden',!show);
      if(show) shown++;
    });
    if(none) none.classList.toggle('hidden', shown>0 || rows.length===0);
    if(count) count.textContent=isZh()?(shown+' 条'):(shown+(shown===1?' story':' stories'));
  }
  function syncPh(){ if(q) q.placeholder=isZh()?(q.getAttribute('data-ph-zh')||''):(q.getAttribute('data-ph-en')||''); }

  if(q) q.addEventListener('input',function(){ term=(q.value||'').trim().toLowerCase(); apply(); });
  if(filters) filters.addEventListener('click',function(e){
    var b=e.target.closest('.fbtn'); if(!b) return;
    Array.prototype.forEach.call(filters.querySelectorAll('.fbtn'),function(x){ x.classList.remove('on'); });
    b.classList.add('on');
    theme=b.getAttribute('data-theme')||'all';
    importance=b.getAttribute('data-importance')||'all';
    if(b.getAttribute('data-importance')) theme='all';
    apply();
  });
  document.addEventListener('langchange',function(){ syncPh(); paintTimes(); apply(); });

  syncPh(); paintCounts(); paintTimes(); apply();
})();
</script>
{% endblock %}
