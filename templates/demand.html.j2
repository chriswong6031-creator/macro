{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Demand Desk — demand vs expectations</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.55 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1120px)/2)); } }
  h1 { font-size:21px; margin:0 0 2px; }
  .lead { color:var(--muted); font-size:13px; margin:0 0 16px; max-width:760px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 18px; margin-bottom:14px; }
  .sec { font-size:12px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:var(--muted); margin:18px 0 8px; }
  /* chain signal cards */
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:12px; }
  .cc { background:var(--panel2); border:1px solid var(--line); border-radius:11px; padding:12px 14px; }
  .cc-h { display:flex; align-items:center; gap:8px; font-weight:700; font-size:13.5px; }
  .cc-tag { font-size:10px; font-weight:800; letter-spacing:.04em; padding:2px 7px; border-radius:6px; border:1px solid var(--line); color:var(--muted); }
  .cc-tag.lead { color:var(--g-cold); border-color:color-mix(in srgb,var(--g-cold) 40%,var(--line)); }
  .cc-big { font-size:20px; font-weight:800; font-variant-numeric:tabular-nums; margin:7px 0 1px; }
  .cc-sub { color:var(--muted); font-size:12px; }
  .cc-ser { display:flex; flex-wrap:wrap; gap:5px; margin-top:8px; }
  .ser { font-size:11px; padding:2px 7px; border-radius:6px; background:var(--bg); border:1px solid var(--line); font-variant-numeric:tabular-nums; }
  .pos{color:var(--up)} .neg{color:var(--down)} .mut{color:var(--muted)}
  /* variant tables */
  .grp-h { display:flex; align-items:center; gap:9px; margin:16px 0 6px; }
  .badge { font-size:11px; font-weight:800; letter-spacing:.03em; padding:3px 9px; border-radius:7px; border:1px solid var(--line); }
  .badge.up { color:var(--up); background:color-mix(in srgb,var(--up) 13%,transparent); border-color:color-mix(in srgb,var(--up) 38%,var(--line)); }
  .badge.risk { color:var(--down); background:color-mix(in srgb,var(--down) 13%,transparent); border-color:color-mix(in srgb,var(--down) 38%,var(--line)); }
  .badge.mut { color:var(--muted); background:var(--panel2); }
  .grp-n { color:var(--muted); font-size:12px; }
  table.dt { width:100%; border-collapse:collapse; font-size:13px; }
  table.dt th { text-align:left; color:var(--muted); font-weight:600; font-size:11.5px; padding:5px 8px; border-bottom:1px solid var(--line); }
  table.dt td { padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  table.dt tr:last-child td { border-bottom:0; }
  .tk { font-weight:800; }
  .tk a { color:var(--link); text-decoration:none; }
  .chip { font-size:10.5px; padding:1px 7px; border-radius:6px; background:var(--panel2); border:1px solid var(--line); color:var(--muted); white-space:nowrap; }
  .chip.coin { border-style:dashed; }
  .num { font-variant-numeric:tabular-nums; }
  details.fold { margin-top:6px; } details.fold > summary { cursor:pointer; color:var(--muted); font-size:12.5px; padding:4px 0; }
  /* accountability */
  .acct { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; }
  .stat .k { color:var(--muted); font-size:11.5px; } .stat .v { font-size:19px; font-weight:800; font-variant-numeric:tabular-nums; }
  .verdict { font-size:11px; font-weight:800; letter-spacing:.04em; padding:3px 9px; border-radius:7px; border:1px solid var(--line); color:var(--muted); }
  .verdict.PENDING { color:var(--g-cold); } .verdict.NEUTRAL { color:var(--muted); }
  .verdict.EDGE_CANDIDATE { color:var(--up); border-color:color-mix(in srgb,var(--up) 40%,var(--line)); }
  .cav { color:var(--muted); font-size:11.5px; line-height:1.5; margin-top:8px; border-top:1px dotted var(--line); padding-top:8px; }
  .faint { color:var(--muted); }
</style>
</head>
<body>
<nav class="site-nav">
  {% include "_navlinks.html.j2" %}
  <div class="nav-ctrls">
    <a class="ai-brief-link" href="mastermind.html">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
    <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span><span class="opt en-opt" data-l="en">EN</span><span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

<h1>🧭 {{ t('Demand Desk', '需求台') }}</h1>
<p class="lead">{{ t('Shows where real demand signals look stronger or weaker than market expectations. Context only; not a buy or sell signal.',
  '显示真实需求信号相对市场预期更强或更弱的位置。仅供参考，非买入或卖出信号。') }}
  <span class="faint">· {{ t('As of', '截至') }} {{ as_of }}</span></p>

<div class="panel">
  <div class="sec">{{ t('The demand pools (independent signals)', '需求来源（独立信号）') }}</div>
  <div class="cards">
    {% for c in cards %}
    <div class="cc">
      <div class="cc-h">{{ t(c.label_en, c.label_zh) }}
        <span class="cc-tag {{ 'lead' if c.leading else '' }}">{{ t('leading','领先') if c.leading else t('coincident','同步') }}</span></div>
      {% if c.yoy_pct is not none %}
        <div class="cc-big {{ 'pos' if c.yoy_pct >= 0 else 'neg' }}">{{ '%+.0f'|format(c.yoy_pct) }}% <span class="cc-sub num">{{ t('YoY','同比') }} · ~${{ '%.0f'|format(c.total_bn) }}B</span></div>
        <div class="cc-sub">{{ t(c.spender_en, c.spender_zh) }} · {{ t(c.trend_en, c.trend_zh) }} · FY{{ c.fy }} · n={{ c.n }}</div>
        {% if c.series %}<div class="cc-ser">{% for p in c.series[-3:] %}<span class="ser">FY{{ p[0] % 100 }} ${{ p[1] }}B</span>{% endfor %}</div>{% endif %}
      {% else %}
        <div class="cc-big">{{ c.n }} <span class="cc-sub">{{ t('names','只') }}</span></div>
        <div class="cc-sub">{{ t(c.spender_en, c.spender_zh) }}</div>
        {% if c.leaders %}<div class="cc-ser">{% for l in c.leaders %}<span class="ser">{{ l.t }} {{ '%+.0f'|format(l.yoy) }}%</span>{% endfor %}</div>{% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>

{% if spender_burden %}
{# W0c — Payer-side capex burden for demand-chain SPENDER cohorts.
   Fingerprint-class (annual XBRL lag); display-only; score_cap=60. #}
<div class="panel">
  <div class="sec">{{ t('Payer-side capex burden (spender cohorts)', '支付方资本开支负担（需求链发起方）') }}
    <span class="help">?<span class="tip"><span class="l-en">Annual company data, usually delayed. High capex plus negative free cash flow can flag funding stress. Context only.</span><span class="l-zh">年度公司数据，通常有滞后。高资本开支叠加负自由现金流，可能提示资金压力。仅供参考。</span></span></span>
  </div>
  {% for chain_key, burden_map in spender_burden.items() %}
  {% if burden_map %}
  <details class="fold" open>
    <summary>
      {% if chain_key == 'ai_datacenter' %}{{ t('AI / datacenter spenders', 'AI／数据中心支付方') }}
      {% elif chain_key == 'housing' %}{{ t('Homebuilder revenue spenders', '建筑商营收来源方') }}
      {% else %}{{ chain_key }}{% endif %}
    </summary>
    <table class="dt" style="margin-top:6px">
      <tr>
        <th>{{ t('Spender','支出方') }}</th>
        <th>{{ t('Capex/OCF','资本开支/OCF') }}</th>
        <th>{{ t('Trend','趋势') }}</th>
        <th>{{ t('FCF ($B)','自由现金流（十亿）') }}</th>
        <th>{{ t('Net-debt Δ ($B)','净债务变化（十亿）') }}</th>
        <th>{{ t('FY','财年') }}</th>
        <th>{{ t('Flag','标记') }}</th>
      </tr>
      {% for ticker, b in burden_map.items() %}
      {% if b is not none %}
      <tr>
        <td class="tk"><a href="stock.html#{{ ticker }}">{{ ticker }}</a></td>
        <td class="num">
          {% if b.capex_ocf_latest is not none %}
            <span class="{{ 'neg' if b.capex_ocf_latest > 80 else '' }}">{{ '%.0f'|format(b.capex_ocf_latest) }}%</span>
          {% else %}—{% endif %}
        </td>
        <td class="faint">{{ t(b.capex_ocf_trend, b.capex_ocf_trend) }}</td>
        <td class="num {% if b.fcf_latest_bn is not none and b.fcf_latest_bn >= 0 %}pos{% elif b.fcf_latest_bn is not none %}neg{% endif %}">
          {% if b.fcf_latest_bn is not none %}{{ '%+.1f'|format(b.fcf_latest_bn) }}{% else %}—{% endif %}
        </td>
        <td class="num {% if b.net_debt_delta_bn is not none and b.net_debt_delta_bn > 0 %}neg{% elif b.net_debt_delta_bn is not none %}pos{% endif %}">
          {% if b.net_debt_delta_bn is not none %}{{ '%+.1f'|format(b.net_debt_delta_bn) }}{% else %}—{% endif %}
        </td>
        <td class="faint">FY{{ b.fy_latest }}</td>
        <td>{% if b.fcf_trap %}<span class="badge risk">{{ t('FCF trap','FCF陷阱') }}</span>{% endif %}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </table>
  </details>
  {% endif %}
  {% endfor %}
  <p class="cav">{{ t('Annual XBRL (fingerprint-class); lag ~90 days from fiscal-year-end. Net-debt delta from balance-sheet YoY — may include acquisitions. Not a sell signal. Display-only.', '年度XBRL（指纹级）；财年末后约90天滞后。净债务变化来自资产负债表同比——可能包含并购。非卖出信号。仅展示。') }}</p>
</div>
{% endif %}

{% macro rowtable(rows) -%}
<table class="dt">
  <tr><th>{{ t('Name','标的') }}</th><th>{{ t('Chain','链条') }}</th><th>{{ t('Independent signal','独立信号') }}</th><th>{{ t('Consensus','共识') }}</th></tr>
  {% for r in rows %}
  <tr>
    <td class="tk"><a href="stock.html#{{ r.ticker }}">{{ r.ticker }}</a></td>
    <td><span class="chip {{ 'coin' if not r.leading else '' }}">{{ r.chain }} · {{ r.tier }}</span></td>
    <td>{% if r.yoy_pct is not none %}<span class="num {{ 'pos' if r.yoy_pct >= 0 else 'neg' }}">{{ '%+.0f'|format(r.yoy_pct) }}%</span> {% endif %}<span class="faint">{{ t(r.trend_en, r.trend_zh) }}</span></td>
    <td class="faint">{{ t(r.consensus_dir, r.consensus_dir) }}</td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}

<div class="panel">
  {% for dv in div_order %}
    {% set rows = groups[dv] %}
    {% set m = div_meta[dv] %}
    {% if rows %}
      {% if dv in ('ahead_of_consensus','consensus_at_risk') %}
        <div class="grp-h"><span class="badge {{ m.cls }}">{{ t(m.en, m.zh) }}</span><span class="grp-n">{{ rows|length }} {{ t('names','只') }}</span></div>
        {% if dv == 'ahead_of_consensus' %}<p class="cav" style="border:0;padding:0;margin:0 0 8px">{{ t('Independent demand running ahead of estimates — the variant list. Worth watching, not a buy signal.','独立需求跑在预期之前——变体清单。值得关注，非买入信号。') }}</p>{% endif %}
        {{ rowtable(rows) }}
      {% else %}
        <details class="fold"><summary>{{ t(m.en, m.zh) }} — {{ rows|length }} {{ t('names','只') }}</summary>{{ rowtable(rows) }}</details>
      {% endif %}
    {% endif %}
  {% endfor %}
</div>

{% if track %}
<div class="panel">
  <div class="sec">{{ t('Accountability — the variant calls are scored forward', '可问责 — 变体判断前向评分') }}</div>
  <div class="acct">
    <div class="stat"><div class="k">{{ t('Open calls','未结判断') }}</div><div class="v">{{ track.open }}</div></div>
    <div class="stat"><div class="k">{{ t('Scored','已评分') }}</div><div class="v">{{ (track.overall or {}).n or 0 }}</div></div>
    <div class="stat"><div class="k">{{ t('Hit rate','命中率') }}</div><div class="v">{% if (track.overall or {}).hit_rate is not none %}{{ '%.0f'|format(track.overall.hit_rate * 100) }}%{% else %}—{% endif %}</div></div>
    {% if phase0 %}<div class="stat"><div class="k">{{ t('Verdict','结论') }}</div><div class="v"><span class="verdict {{ phase0.verdict }}">{{ phase0.verdict }}</span></div></div>{% endif %}
  </div>
  {% if phase0 %}<p class="cav">{{ t(phase0.note, phase0.note_zh) }}</p>{% endif %}
</div>
{% endif %}

<p class="cav" style="max-width:820px">{{ t('Method: each chain aggregates a spender cohort\'s capex/revenue (or a name\'s own RPO) from SEC filings as the forward-demand pool, then compares its trend to the name\'s analyst-revision direction. Cross-company / annual / coarse — a divergence flag, not a forecast. The signal is NOT historically back-testable (annual cadence, no point-in-time consensus history), so the forward-scored ledger above is the only honest validation path.',
  '方法：每条链条以卖方/客户群体的资本开支或营收（或个股自身RPO）作为前瞻需求来源（来自SEC财报），再将其趋势与该股分析师评级调整方向对比。跨公司／年度／粗粒度——是背离标记而非预测。该信号无法用历史数据回测（年度频率、无时点共识历史），故上方前向评分记录是唯一诚实的验证路径。') }}</p>

<script src="theme.js"></script>
<footer class="site-footer" style="margin-top:18px;color:var(--muted);font-size:12px">
  © 2026 Mastermind Inc
</footer>
</body>
</html>
