/* ─── Copy-to-clipboard ─────────────────────────────────────────────────── */
window.tlCopyCode = function(btn) {
  var block = btn.parentElement.querySelector('.code-block');
  if (!block) return;
  var text = block.textContent || '';
  if (navigator.clipboard) {
    navigator.clipboard.writeText(text).then(function() {
      btn.textContent = 'Copied!'; btn.classList.add('copied');
      setTimeout(function(){ btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    });
  }
};

/* ─── i18n: swap placeholders & option text ─────────────────────────────── */
function _swapI18n(zh) {
  // Screener search placeholder
  var si = document.getElementById('screener-search');
  if (si) si.placeholder = zh ? (si.getAttribute('data-ph-zh')||'') : (si.getAttribute('data-ph-en')||'');
  // Band filter options
  var bf = document.getElementById('band-filter');
  if (bf) [].forEach.call(bf.options, function(o){
    o.textContent = zh ? (o.getAttribute('data-zh')||o.textContent) : (o.getAttribute('data-en')||o.textContent);
  });
  // Ticker search placeholder
  var ti = document.getElementById('ticker-search-input');
  if (ti) ti.placeholder = zh ? (ti.getAttribute('data-ph-zh')||'') : (ti.getAttribute('data-ph-en')||'');
}
_swapI18n(isZh());
document.addEventListener('langchange', function(e) {
  _swapI18n(e.detail === 'zh');
  tlRenderScreener();
  tlRenderCatalog();
  tlConflUpdate();
});

/* ─── Data load ─────────────────────────────────────────────────────────── */
Promise.all([
  fetch('factordata/tech_screener.json').then(function(r){ if(!r.ok) throw new Error('screener '+r.status); return r.json(); }),
  fetch('factordata/tech_lab.json').then(function(r){ if(!r.ok) throw new Error('lab '+r.status); return r.json(); })
]).then(function(results) {
  var screener = results[0];
  var lab      = results[1];

  // screener signals (for confluence builder + picker fire counts)
  window._SCREENER_SIGS = screener.signals || {};

  // Build SIG_FIRES map
  SIG_FIRES = {};
  Object.keys(window._SCREENER_SIGS).forEach(function(sid) {
    var sc = window._SCREENER_SIGS[sid];
    SIG_FIRES[sid] = (sc.tickers||[]).map(function(t){ return t.ticker; });
  });

  // Lab signals
  SIGS = lab.signals || {};

  // Stocks
  STKS = screener.stocks || {};

  // Assign family from screener to SIGS (lab may not have it for all)
  Object.keys(window._SCREENER_SIGS).forEach(function(sid) {
    if (SIGS[sid] && !SIGS[sid].family) SIGS[sid].family = window._SCREENER_SIGS[sid].family;
  });

  _loaded = true;

  // Build rows
  tlBuildScreenerRows();
  tlBuildCatalogRows();
  tlBuildTickerList();

  // Render
  tlRenderScreener();
  tlRenderCatalog();
  tlBuildPicker();
  tlBuildConflChips();

  // Populate ticker list in stock tab
  tlTickerSearch('');

  // Init tab
  tlInitTab();

  // Update badges
  var nb = document.getElementById('badge-screener');
  if (nb) nb.textContent = Object.keys(STKS).length;
  var sb = document.getElementById('badge-siglab');
  if (sb) sb.textContent = Object.keys(SIGS).length;

}).catch(function(err) {
  console.error('tech_lab data load failed:', err);
  // Show error in screener
  var tbody = document.getElementById('screener-tbody');
  if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="tl-empty">' + L('Data unavailable — ' + err.message,'数据不可用 — ' + err.message) + '</td></tr>';
  tlInitTab();
});

})();
</script>
{% endblock %}
