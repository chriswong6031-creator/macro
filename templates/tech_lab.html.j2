{% extends "report_base.html.j2" %}
{% macro t(en, zh='') -%}
<span class="l-en">{{ en|safe }}</span><span class="l-zh">{{ (zh if zh else en)|safe }}</span>
{%- endmacro %}

{% block title %}{{ t('Technical Lab', '技术实验室') }} — {{ t('Macro Dashboard', '宏观仪表盘') }}{% endblock %}

{% block base_css %}
/* ── Four-tab workbench layout ── */
.tl-page { max-width:1080px; margin:0 auto; padding:0 20px 48px; }
.tl-hero { margin:24px 0 0; }
.eyebrow { font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:6px; }
.tl-hero h1 { font-size:26px;font-weight:800;margin-bottom:6px; }
.tl-sub { color:var(--muted);font-size:13px;max-width:820px;line-height:1.6; }
.tl-meta { display:flex;gap:7px;flex-wrap:wrap;margin-top:12px; }
.chip { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:var(--panel2);color:var(--muted);border:1px solid var(--line); }
.chip.tag-equities { background:rgba(91,155,240,.15);color:var(--info);border-color:rgba(91,155,240,.3); }
.chip.tag-warn { background:rgba(224,160,48,.12);color:var(--warn);border-color:rgba(224,160,48,.25); }

/* ── Display-only banner ── */
.display-banner { margin:14px 0 0;padding:12px 16px;background:rgba(224,160,48,.08);border:1px solid rgba(224,160,48,.25);border-radius:10px;font-size:12.5px;color:var(--warn);display:flex;align-items:flex-start;gap:10px;line-height:1.6; }
.display-banner .icon { font-size:16px;flex:none;margin-top:1px; }
.display-banner strong { color:var(--text); }
.hb-dots { display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:6px; }
.hb-dot::before { content:"·";margin-right:5px; }
.hb-dot { font-size:11.5px;color:var(--warn); }

/* ── Sample banner ── */
.tl-sample-banner { margin:10px 0 0;background:rgba(224,151,58,.13);border:1px solid rgba(224,151,58,.35);border-radius:10px;padding:10px 14px;font-size:12.5px;color:#c77a1f; }
html[data-theme="dark"] .tl-sample-banner { color:#e0973a; }

/* ── Tab bar ── */
.tab-bar { display:flex;gap:2px;margin:20px 0 0;border-bottom:2px solid var(--line); }
.tab-btn { padding:10px 20px;font-size:13px;font-weight:600;border:none;background:transparent;color:var(--muted);cursor:pointer;transition:color .15s;position:relative;white-space:nowrap; }
.tab-btn:hover { color:var(--text); }
.tab-btn.active { color:var(--link); }
.tab-btn.active::after { content:"";position:absolute;bottom:-2px;left:0;right:0;height:2px;background:var(--link);border-radius:2px 2px 0 0; }
.tab-badge { display:inline-flex;align-items:center;justify-content:center;min-width:18px;height:18px;padding:0 5px;background:var(--panel2);border-radius:9px;font-size:10px;font-weight:700;color:var(--muted);margin-left:6px; }
.tab-btn.active .tab-badge { background:rgba(122,167,224,.2);color:var(--link); }
.tab-panel { display:none;padding-top:20px; }
.tab-panel.active { display:block; }

/* ── Section card ── */
.tl-card { background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px; }
.tl-card-header { display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap; }
.tl-card-header h2 { font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px; }
.h-note { font-size:11px;color:var(--muted);font-weight:400; }

/* ── Table ── */
.tbl-wrap { overflow-x:auto;-webkit-overflow-scrolling:touch; }
table.tl { width:100%;border-collapse:collapse;font-size:12.5px;min-width:480px; }
table.tl th { text-align:left;color:var(--muted);font-weight:600;border-bottom:1px solid var(--line);padding:7px 9px;white-space:nowrap;font-size:11px;letter-spacing:.03em; }
table.tl th.sortable { cursor:pointer;user-select:none; }
table.tl th.sortable:hover { color:var(--text); }
table.tl th.sorted { color:var(--link); }
table.tl td { padding:7px 9px;border-bottom:1px solid var(--line);vertical-align:middle; }
table.tl tr:last-child td { border-bottom:none; }
table.tl tbody tr { cursor:pointer;transition:background .1s; }
table.tl tbody tr:hover { background:var(--panel2); }
table.tl tbody tr.selected { background:rgba(122,167,224,.08); }
td.tl-num,th.tl-num { text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap; }
.tl-tk { font-weight:700;font-size:13px; }
.tl-name { color:var(--muted);font-size:10.5px;display:block;margin-top:1px; }
.tbl-footer { display:flex;align-items:center;justify-content:space-between;padding-top:10px;font-size:11.5px;color:var(--muted);flex-wrap:wrap;gap:8px; }
.tbl-page-btns { display:flex;gap:4px; }
.tbl-page-btn { width:28px;height:28px;border-radius:6px;border:1px solid var(--line);background:var(--panel2);color:var(--muted);font-size:12px;display:flex;align-items:center;justify-content:center;cursor:pointer; }
.tbl-page-btn.active { background:var(--link);color:#fff;border-color:var(--link); }

/* ── Color helpers ── */
.r-pos { color:#1f9a55;font-weight:600; } html[data-theme="dark"] .r-pos { color:#3fc07e; }
.r-neg { color:#d23f3f;font-weight:600; } html[data-theme="dark"] .r-neg { color:#ef6a6a; }
.r-neu { color:var(--muted); }

/* ── Score gauge ── */
.gauge-wrap { display:inline-flex;align-items:center;gap:7px;min-width:100px; }
.gauge { flex:1;min-width:52px;height:6px;border-radius:3px;background:var(--panel2);overflow:hidden; }
.gauge i { display:block;height:100%;border-radius:3px; }
.g-hi i  { background:#1f9a55; } html[data-theme="dark"] .g-hi i { background:#3fc07e; }
.g-mod i { background:#5b8def; }
.g-lo i  { background:var(--muted); }
.g-neg i { background:#d23f3f; } html[data-theme="dark"] .g-neg i { background:#ef6a6a; }
.gauge-score { font-variant-numeric:tabular-nums;font-weight:700;font-size:12.5px;min-width:36px;text-align:right; }

/* ── Band chips ── */
.band-chip { display:inline-block;padding:2px 8px;border-radius:5px;font-size:10px;font-weight:700;letter-spacing:.03em;white-space:nowrap; }
.band-Buy  { background:rgba(31,154,85,.18);color:#1f9a55; } html[data-theme="dark"] .band-Buy { color:#3fc07e; }
.band-Hold { background:rgba(91,141,239,.15);color:#5b8def; }
.band-Sell { background:rgba(210,63,63,.18);color:#d23f3f; } html[data-theme="dark"] .band-Sell { color:#ef6a6a; }

/* ── Signal dots ── */
.sig-dots { display:flex;gap:3px;flex-wrap:wrap;max-width:96px; }
.sig-dot { width:7px;height:7px;border-radius:50%; }
.dot-buy { background:var(--up); }
.dot-sell { background:var(--down); }
.dot-off { background:var(--line); }

/* ═══ TAB 1: SCREENER ═══ */
.screener-layout { display:grid;grid-template-columns:1fr 320px;gap:16px; }
@media(max-width:900px){ .screener-layout { grid-template-columns:1fr; } }
.screener-controls { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px; }
.sc-input { padding:7px 11px;font-size:12.5px;border:1px solid var(--line);border-radius:8px;background:var(--panel2);color:var(--text);outline:none;transition:border-color .15s;flex:1;min-width:120px; }
.sc-input:focus { border-color:var(--link); }
.sc-select { padding:7px 10px;font-size:12.5px;border:1px solid var(--line);border-radius:8px;background:var(--panel2);color:var(--text);cursor:pointer;outline:none; }

/* ── Confluence builder ── */
.confl-builder { background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:12px; }
.confl-title { font-size:13px;font-weight:700;margin-bottom:2px; }
.confl-desc { font-size:11.5px;color:var(--muted);line-height:1.5; }
.confl-section-label { font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:6px; }
.confl-chips { display:flex;flex-wrap:wrap;gap:6px; }
.confl-chip { padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:600;border:1px solid var(--line);background:var(--panel2);color:var(--muted);cursor:pointer;transition:all .13s;user-select:none; }
.confl-chip:hover { border-color:var(--link);color:var(--text); }
.confl-chip.active { background:rgba(122,167,224,.18);border-color:var(--link);color:var(--link); }
.confl-chip.buy-chip.active { background:rgba(31,154,85,.15);border-color:var(--up);color:var(--up); } html[data-theme="dark"] .confl-chip.buy-chip.active { color:#3fc07e;border-color:#3fc07e; }
.logic-toggle { display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;width:fit-content; }
.logic-btn { padding:5px 14px;font-size:12px;font-weight:700;border:none;background:var(--panel2);color:var(--muted);transition:all .12s;cursor:pointer; }
.logic-btn.active { background:var(--link);color:#fff; }
.confl-result { display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:10px;background:var(--panel2);border:1px solid var(--line); }
.confl-count { font-size:28px;font-weight:800;color:var(--link);font-variant-numeric:tabular-nums; }
.confl-count-label { font-size:11px;color:var(--muted);margin-top:2px; }
.confl-result-tickers { font-size:11px;color:var(--muted);max-width:140px;text-align:right;line-height:1.6; }
.tl-empty { color:var(--muted);font-size:13px;padding:20px 0;text-align:center; }
.confl-empty { color:var(--warn);font-size:12px;padding:8px 0; }

/* ═══ TAB 2: SIGNAL LAB ═══ */
.lab-layout { display:grid;grid-template-columns:280px 1fr;gap:16px; }
@media(max-width:800px){ .lab-layout { grid-template-columns:1fr; } }

/* Signal browser picker */
.sig-picker-wrap { display:flex;flex-direction:column;gap:0; }
.sig-family-label { font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding:10px 4px 4px; }
.sig-row { width:100%;text-align:left;padding:7px 8px;border-radius:8px;border:none;background:transparent;color:var(--muted);font-size:12px;transition:all .13s;cursor:pointer;display:flex;align-items:center;gap:8px; }
.sig-row:hover { background:var(--panel2);color:var(--text); }
.sig-row.active { background:rgba(122,167,224,.12);border:1px solid rgba(122,167,224,.3);color:var(--text);font-weight:600; }
.sig-dir-badge { width:16px;height:16px;border-radius:4px;flex:none;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800; }
.dir-up   { background:rgba(31,154,85,.2);color:var(--up); } html[data-theme="dark"] .dir-up { color:#3fc07e; }
.dir-down { background:rgba(210,63,63,.2);color:var(--down); } html[data-theme="dark"] .dir-down { color:#ef6a6a; }
.dir-neu  { background:var(--panel2);color:var(--muted); }
.sig-row-name { flex:1;font-size:11.5px;text-align:left; }
.wr-bar-mini { display:flex;align-items:center;gap:4px;flex:none; }
.wr-track { width:36px;height:5px;background:var(--panel2);border-radius:3px;overflow:hidden;flex:none; }
.wr-fill  { height:100%;border-radius:3px; }
.wr-val   { font-size:10px;font-variant-numeric:tabular-nums;min-width:30px;text-align:right; }
.fire-badge { font-size:9.5px;color:var(--muted);white-space:nowrap;min-width:20px;text-align:right; }
.fire-badge.active { color:var(--up); } html[data-theme="dark"] .fire-badge.active { color:#3fc07e; }

/* Signal catalog (sortable table) */
.catalog-table-wrap { overflow-x:auto; }
.tl-edge-chip { display:inline-block;padding:1px 7px;border-radius:5px;font-size:10px;font-weight:700;white-space:nowrap; }
.edge-strong { background:rgba(31,154,85,.18);color:#1f9a55; } html[data-theme="dark"] .edge-strong { color:#3fc07e; }
.edge-pos    { background:rgba(91,155,240,.15);color:var(--info); }
.edge-neu    { background:var(--panel2);color:var(--muted);border:1px solid var(--line); }
.edge-neg    { background:rgba(210,63,63,.15);color:#d23f3f; } html[data-theme="dark"] .edge-neg { color:#ef6a6a; }
.era-badge2  { display:inline-block;padding:1px 7px;border-radius:5px;font-size:9.5px;font-weight:700;white-space:nowrap; }
.era-stable  { background:rgba(91,155,240,.12);color:var(--info); }
.era-post    { background:rgba(224,160,48,.12);color:var(--warn); }
.era-divg    { background:rgba(210,63,63,.12);color:#d23f3f; }

/* Signal profile (detail pane) */
.sig-profile { padding-left:2px; }
.sig-profile h2 { font-size:18px;font-weight:800;margin-bottom:4px; }
.sig-profile-sub { font-size:12px;color:var(--muted);margin-bottom:14px; }
.stat-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px; }
@media(max-width:600px){ .stat-grid { grid-template-columns:repeat(2,1fr); } }
.stat-cell { background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px; }
.stat-cell .sk { font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted); }
.stat-cell .sv { font-size:22px;font-weight:750;font-variant-numeric:tabular-nums;margin-top:4px;line-height:1; }
.stat-cell .sb { font-size:10.5px;color:var(--muted);margin-top:3px; }
.sv-up  { color:#1f9a55; } html[data-theme="dark"] .sv-up { color:#3fc07e; }
.sv-neg { color:#d23f3f; } html[data-theme="dark"] .sv-neg { color:#ef6a6a; }
.sv-neu { color:var(--text); }

/* Era split 3-row table */
.era-table-wrap { margin-bottom:14px;background:var(--panel);border:1px solid var(--line);border-radius:10px;overflow:hidden; }
.era-table-wrap table { width:100%;border-collapse:collapse;font-size:12px; }
.era-table-wrap th { text-align:left;color:var(--muted);font-weight:600;padding:8px 12px;border-bottom:1px solid var(--line);font-size:10.5px; }
.era-table-wrap td { padding:8px 12px;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums; }
.era-table-wrap tr:last-child td { border-bottom:none; }
.era-tag { display:inline-block;padding:1px 7px;border-radius:4px;font-size:9.5px;font-weight:700;white-space:nowrap; }
.era-pre  { background:rgba(224,160,48,.12);color:var(--warn); }
.era-post { background:rgba(91,155,240,.12);color:var(--info); }
.era-pool { background:var(--panel2);color:var(--muted);border:1px solid var(--line); }

/* Chart area */
.mini-chart-wrap { background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:14px; }
.mini-chart-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px; }
.mini-chart-title { font-size:12.5px;font-weight:700; }
.chart-note { font-size:10.5px;color:var(--muted);margin-top:6px;font-style:italic; }
.chart-ctrl { display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px; }
.chart-ctrl select { padding:5px 8px;font-size:11.5px;border:1px solid var(--line);border-radius:7px;background:var(--panel2);color:var(--text);cursor:pointer;outline:none; }
.chart-container { width:100%;height:220px;position:relative; }
.chart-fallback { display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:12px;font-style:italic;border:1px dashed var(--line);border-radius:8px; }

/* null caveat */
.null-banner { padding:10px 14px;border-radius:9px;background:rgba(139,147,161,.1);border:1px solid rgba(139,147,161,.25);font-size:12px;color:var(--muted);line-height:1.6;margin-top:10px; }
.null-banner strong { color:var(--text); }

/* ═══ TAB 3: STOCK PROFILE ═══ */
.stock-profile-layout { display:grid;grid-template-columns:1fr 300px;gap:16px; }
@media(max-width:860px){ .stock-profile-layout { grid-template-columns:1fr; } }
.profile-header { display:flex;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px; }
.profile-ticker { font-size:32px;font-weight:900;line-height:1; }
.profile-name { font-size:15px;color:var(--muted);margin-bottom:4px; }
.profile-price { font-size:22px;font-weight:700;font-variant-numeric:tabular-nums; }
.profile-actions { display:flex;gap:8px;align-items:flex-start;margin-left:auto; }
.open-terminal-btn { display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:9px;font-size:12.5px;font-weight:700;background:var(--link);color:#fff;border:none;cursor:pointer;transition:opacity .13s; }
.open-terminal-btn:hover { opacity:.88; }
.perf-row { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px; }
.perf-cell { background:var(--panel);border:1px solid var(--line);border-radius:9px;padding:8px 14px;min-width:90px; }
.pk { font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted); }
.pv { font-size:19px;font-weight:700;font-variant-numeric:tabular-nums;margin-top:2px; }
.confl-callout { display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:10px;background:rgba(122,167,224,.08);border:1px solid rgba(122,167,224,.2);margin-bottom:16px;flex-wrap:wrap; }
.confl-n { font-size:36px;font-weight:900;color:var(--link);line-height:1; }
.confl-label { font-size:12px;color:var(--muted);line-height:1.5; }
.confl-label strong { color:var(--text); }
.stock-chart-card { background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:16px; }
.chart-ticker-label { font-size:12px;font-weight:700;color:var(--muted);margin-bottom:8px; }
.stock-chart-container { width:100%;height:240px;position:relative; }
.sig-state-list { display:flex;flex-direction:column;gap:4px; }
.sig-state-row { display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;font-size:12.5px;transition:background .1s; }
.sig-state-row:hover { background:var(--panel2); }
.sig-state-row.on { background:rgba(31,154,85,.08); } html[data-theme="dark"] .sig-state-row.on { background:rgba(63,192,126,.08); }
.sig-state-row.off { opacity:.5; }
.sig-state-name { flex:1; }
.sig-state-age { font-size:10.5px;color:var(--muted);margin-left:auto;white-space:nowrap; }
.sig-on-mark  { color:var(--up);font-size:13px; } html[data-theme="dark"] .sig-on-mark { color:#3fc07e; }
.sig-off-mark { color:var(--muted);font-size:13px; }
.family-divider { font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);padding:10px 0 4px;margin-top:4px; }
.ticker-search-card { background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px; }
.ts-input { width:100%;padding:10px 14px;border:1px solid var(--line);border-radius:9px;background:var(--panel2);color:var(--text);font-size:14px;outline:none;transition:border-color .15s; }
.ts-input:focus { border-color:var(--link); }
.ts-results { display:flex;flex-direction:column;gap:3px;margin-top:8px; }
.ts-result-row { display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;cursor:pointer;transition:background .1s; }
.ts-result-row:hover,.ts-result-row.sel { background:var(--panel2); }
.ts-tk { font-weight:700;font-size:13px;min-width:44px; }
.ts-name { font-size:12px;color:var(--muted);flex:1; }

/* ═══ TAB 4: HOW TO TEST ═══ */
.how-grid { display:grid;grid-template-columns:1fr 1fr;gap:16px; }
@media(max-width:700px){ .how-grid { grid-template-columns:1fr; } }
.how-card { background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:20px; }
.how-card h3 { font-size:14px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px; }
.how-card p,.how-card li { font-size:12.5px;color:var(--muted);line-height:1.7; }
.how-card ul { padding-left:16px;margin-top:6px; }
.code-block { margin-top:10px;padding:12px 14px;background:var(--panel2);border:1px solid var(--line);border-radius:9px;font-family:"SF Mono","Fira Code","JetBrains Mono",Consolas,monospace;font-size:11.5px;color:var(--text);line-height:1.7;overflow-x:auto;white-space:pre;position:relative; }
.code-block-wrap { position:relative; }
.copy-btn { position:absolute;top:8px;right:8px;padding:3px 8px;font-size:10px;font-weight:600;border:1px solid var(--line);border-radius:5px;background:var(--panel);color:var(--muted);cursor:pointer;transition:all .12s;z-index:1; }
.copy-btn:hover { color:var(--text);border-color:var(--muted); }
.copy-btn.copied { color:var(--ok);border-color:var(--ok); }
.code-comment { color:var(--muted); }
.code-kw { color:var(--link); }
.code-str { color:#1f9a55; } html[data-theme="dark"] .code-str { color:#3fc07e; }

/* scrollbar */
::-webkit-scrollbar { width:6px;height:6px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--line);border-radius:3px; }

{% endblock %}

{% block content %}
<div class="tl-page">

{# ── Hero ── #}
<section class="tl-hero">
  <p class="eyebrow">{{ t('Research · Display Only', '研究 · 仅供展示') }}</p>
  <h1>{{ t('Technical Lab', '技术实验室') }}</h1>
  <p class="tl-sub">{{ t(
    'Signal screener + descriptive backtest profiles. Build confluence filters to find names where multiple signals align. Drill into any ticker for a per-stock signal breakdown. Descriptive framing — survivor mega-cap universe, not a verdict.',
    '信号筛选器 + 描述性回测档案。构建多因子共振筛选条件，聚焦多信号同向股票。点击任意标的查看个股信号分解。描述性研究框架 — 幸存大盘股宇宙，非结论性研究。'
  ) }}</p>
  <div class="tl-meta">
    <span class="chip tag-equities">{{ t('Technical Signals', '技术信号') }}</span>
    <span class="chip" id="hero-ts">{{ generated_utc }}</span>
    <span class="chip" id="hero-n-signals">{{ n_signals }} {{ t('signals', '信号') }}</span>
    <span class="chip" id="hero-n-stocks">{{ universe_n_screener or '—' }} {{ t('universe', '覆盖标的') }}</span>
    {% if is_sample %}
    <span class="chip tag-warn">{{ t('Sample data — nightly pending', '样本数据 — 等待夜间生成') }}</span>
    {% endif %}
  </div>
</section>

{% if is_sample %}
<div class="tl-sample-banner">
  &#9888; {{ t(
    'Data files (tech_screener.json, tech_lab.json) are absent — showing sample fixture. Real data populates after the first nightly run.',
    '数据文件（tech_screener.json, tech_lab.json）尚未生成，当前显示样本。首次夜间运行后将填充真实数据。'
  ) }}
</div>
{% endif %}

{# ── Display-only banner (four structural dot-chips from v2) ── #}
<div class="display-banner">
  <span class="icon">&#9432;</span>
  <div>
    <strong>{{ t('Descriptive · Survivor Universe · Not a Verdict.', '描述性 · 幸存者宇宙 · 非结论。') }}</strong>
    <div class="hb-dots">
      <span class="hb-dot">{{ t('Survivor mega-caps only — no delisted stocks', '仅含幸存大盘股，不含退市标的') }}</span>
      <span class="hb-dot">{{ t('Pooled stats include up-market concentration bias', '汇总统计含牛市集中偏差') }}</span>
      <span class="hb-dot">{{ t('Pre/post-2010 era split shown — pooled WR is post-2010 when pre-2010 is absent', '显示2010前后分期，前期缺失时汇总=2010后') }}</span>
      <span class="hb-dot">{{ t('Signal fires are observation counts, not trade recommendations', '触发次数为观察计数，非交易建议') }}</span>
    </div>
  </div>
</div>

{# ── Tab bar ── #}
<div class="tab-bar" id="tab-bar">
  <button class="tab-btn" data-tab="screener" id="tb-screener">
    <span class="l-en">Screener</span><span class="l-zh">筛选器</span>
    <span class="tab-badge" id="badge-screener">{{ universe_n_screener or '—' }}</span>
  </button>
  <button class="tab-btn" data-tab="siglab" id="tb-siglab">
    <span class="l-en">Signal Lab</span><span class="l-zh">信号实验室</span>
    <span class="tab-badge" id="badge-siglab">{{ n_signals }}</span>
  </button>
  <button class="tab-btn" data-tab="stock" id="tb-stock">
    <span class="l-en">Stock Profile</span><span class="l-zh">个股档案</span>
  </button>
  <button class="tab-btn" data-tab="test" id="tb-test">
    <span class="l-en">How to Test</span><span class="l-zh">如何检验</span>
  </button>
</div>

{# ═══════════════════════════════════════════
   TAB 1: SCREENER
═══════════════════════════════════════════ #}
<div class="tab-panel" id="tab-screener">
  <div class="screener-layout">

    <!-- Left: composite table -->
    <div>
      <div class="tl-card">
        <div class="tl-card-header">
          <h2>
            <span class="l-en">Composite Screener</span>
            <span class="l-zh">综合筛选器</span>
            <span class="h-note">
              <span class="l-en">score = buy signals ÷ total signals</span>
              <span class="l-zh">评分 = 买入信号 ÷ 信号总数</span>
            </span>
          </h2>
        </div>
        <div class="screener-controls">
          <input class="sc-input" type="text" id="screener-search"
            data-ph-en="Search ticker…"
            data-ph-zh="搜索标的…"
            placeholder="Search ticker…"
            oninput="tlFilterScreener()">
          <select class="sc-select" id="band-filter" onchange="tlFilterScreener()">
            <option value="" data-en="All Bands" data-zh="全部评级">All Bands</option>
            <option value="Buy" data-en="Buy" data-zh="买入">Buy</option>
            <option value="Hold" data-en="Hold" data-zh="持有">Hold</option>
            <option value="Sell" data-en="Sell" data-zh="卖出">Sell</option>
          </select>
        </div>
        <div class="tbl-wrap">
          <table class="tl" id="screener-table">
            <thead>
              <tr>
                <th>
                  <span class="l-en">Ticker</span>
                  <span class="l-zh">标的</span>
                </th>
                <th class="tl-num">
                  <span class="l-en">Price</span>
                  <span class="l-zh">价格</span>
                </th>
                <th class="tl-num sortable sorted" data-sort="score" onclick="tlSortScreener('score',this)">
                  <span class="l-en">Score ↓</span>
                  <span class="l-zh">评分 ↓</span>
                </th>
                <th>
                  <span class="l-en">Band</span>
                  <span class="l-zh">评级</span>
                </th>
                <th class="tl-num sortable" data-sort="perf7d" onclick="tlSortScreener('perf7d',this)">
                  <span class="l-en">7D</span>
                  <span class="l-zh">7日</span>
                </th>
                <th class="tl-num sortable" data-sort="perf30d" onclick="tlSortScreener('perf30d',this)">
                  <span class="l-en">30D</span>
                  <span class="l-zh">30日</span>
                </th>
                <th>
                  <span class="l-en">Active signals</span>
                  <span class="l-zh">活跃信号</span>
                </th>
              </tr>
            </thead>
            <tbody id="screener-tbody"></tbody>
          </table>
        </div>
        <div class="tbl-footer">
          <span id="screener-count" class="l-en">Loading…</span>
          <div class="tbl-page-btns" id="screener-pages"></div>
        </div>
      </div>
    </div>

    <!-- Right: Confluence builder -->
    <div class="confl-builder">
      <div>
        <div class="confl-title">
          <span class="l-en">Confluence Builder</span>
          <span class="l-zh">共振筛选器</span>
        </div>
        <div class="confl-desc">
          <span class="l-en">Pick 2–4 signals, choose logic, and see how many names currently satisfy the conditions.</span>
          <span class="l-zh">选择 2–4 个信号，设置逻辑，查看当前满足条件的标的数量。</span>
        </div>
      </div>

      <div id="confl-chip-area">
        <!-- Populated from JS after data load -->
        <p class="r-neu" style="font-size:12px;">
          <span class="l-en">Loading signals…</span>
          <span class="l-zh">加载信号中…</span>
        </p>
      </div>

      <div>
        <div class="confl-section-label">
          <span class="l-en">Logic</span>
          <span class="l-zh">逻辑</span>
        </div>
        <div class="logic-toggle">
          <button class="logic-btn active" id="logic-all" onclick="tlConflSetLogic('ALL')">
            <span class="l-en">ALL match</span>
            <span class="l-zh">全部匹配</span>
          </button>
          <button class="logic-btn" id="logic-any" onclick="tlConflSetLogic('ANY')">
            <span class="l-en">ANY match</span>
            <span class="l-zh">任一匹配</span>
          </button>
        </div>
      </div>

      <div class="confl-result" id="confl-result">
        <div>
          <div class="confl-count" id="confl-count">—</div>
          <div class="confl-count-label" id="confl-count-label">
            <span class="l-en">pick signals above</span>
            <span class="l-zh">请选择信号</span>
          </div>
        </div>
        <div class="confl-result-tickers" id="confl-tickers"></div>
      </div>
      <div id="confl-empty-msg" style="display:none;" class="confl-empty">
        <span class="l-en">0 names match — loosen to ANY or drop a signal</span>
        <span class="l-zh">0个标的匹配 — 改为任一匹配或减少信号</span>
      </div>
    </div>
  </div>
</div>

{# ═══════════════════════════════════════════
   TAB 2: SIGNAL LAB
═══════════════════════════════════════════ #}
<div class="tab-panel" id="tab-siglab">
  <div class="lab-layout">

    <!-- Left: signal picker with WR bars (from v1 graft) -->
    <div class="tl-card" style="padding:10px;overflow-y:auto;max-height:800px;">
      <div class="sig-picker-wrap" id="sig-picker">
        <p class="r-neu" style="font-size:12px;padding:8px;">
          <span class="l-en">Loading signals…</span>
          <span class="l-zh">加载信号中…</span>
        </p>
      </div>
    </div>

    <!-- Right: either catalog table (landing) or signal detail pane -->
    <div id="lab-right">

      <!-- Catalog table (default landing view) -->
      <div id="lab-catalog" class="tl-card">
        <div class="tl-card-header">
          <h2>
            <span class="l-en">Signal Catalog</span>
            <span class="l-zh">信号目录</span>
            <span class="h-note" id="catalog-count-note">
              <span class="l-en">click a row to drill in</span>
              <span class="l-zh">点击行查看详情</span>
            </span>
          </h2>
        </div>
        <div class="catalog-table-wrap">
          <table class="tl" id="catalog-table">
            <thead>
              <tr>
                <th class="sortable sorted" data-sort="edge_wr" onclick="tlSortCatalog('edge_wr',this)">
                  <span class="l-en">Signal ↓</span>
                  <span class="l-zh">信号 ↓</span>
                </th>
                <th>
                  <span class="l-en">Family</span>
                  <span class="l-zh">族群</span>
                </th>
                <th>
                  <span class="l-en">Dir</span>
                  <span class="l-zh">方向</span>
                </th>
                <th>
                  <span class="l-en">WR vs Base</span>
                  <span class="l-zh">胜率/基准</span>
                </th>
                <th class="sortable" data-sort="edge_wr" onclick="tlSortCatalog('edge_wr',this)">
                  <span class="l-en">Edge</span>
                  <span class="l-zh">优势</span>
                </th>
                <th>
                  <span class="l-en">Era</span>
                  <span class="l-zh">时代</span>
                </th>
                <th class="sortable tl-num" data-sort="up_tape_pct" onclick="tlSortCatalog('up_tape_pct',this)">
                  <span class="l-en">Up Tape</span>
                  <span class="l-zh">上涨市占</span>
                </th>
                <th class="sortable tl-num" data-sort="n_fires" onclick="tlSortCatalog('n_fires',this)">
                  <span class="l-en">Fires</span>
                  <span class="l-zh">触发</span>
                </th>
              </tr>
            </thead>
            <tbody id="catalog-tbody">
              <tr><td colspan="8" class="tl-empty">
                <span class="l-en">Loading…</span>
                <span class="l-zh">加载中…</span>
              </td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Signal detail pane (hidden until row clicked) -->
      <div id="lab-detail" style="display:none;">
        <div style="margin-bottom:10px;">
          <button onclick="tlShowCatalog()" style="font-size:12px;color:var(--link);background:none;border:none;cursor:pointer;padding:0;">
            ← <span class="l-en">Back to catalog</span><span class="l-zh">返回目录</span>
          </button>
        </div>

        <div class="sig-profile">
          <h2 id="det-name">—</h2>
          <div class="sig-profile-sub" id="det-sub">—</div>

          <!-- 8-cell stat grid -->
          <div class="stat-grid" id="det-stat-grid"></div>

          <!-- Era-split 3-row table (v1 graft) -->
          <div class="era-table-wrap" id="det-era-wrap">
            <table>
              <thead>
                <tr>
                  <th><span class="l-en">Era</span><span class="l-zh">时代</span></th>
                  <th><span class="l-en">WR 21d</span><span class="l-zh">21日胜率</span></th>
                  <th><span class="l-en">Edge WR</span><span class="l-zh">优势胜率</span></th>
                  <th class="tl-num"><span class="l-en">Fires / Months</span><span class="l-zh">触发/月数</span></th>
                </tr>
              </thead>
              <tbody id="det-era-body"></tbody>
            </table>
          </div>

          <!-- Real chart with LWC + tech_events fire markers -->
          <div class="mini-chart-wrap">
            <div class="mini-chart-header">
              <span class="mini-chart-title">
                <span class="l-en">Price chart · signal fires</span>
                <span class="l-zh">价格图 · 信号触发</span>
              </span>
              <div class="chart-ctrl">
                <select id="det-ticker-select" onchange="tlLabChartDraw()">
                  <option value="" data-en="Select ticker with fires…" data-zh="选择触发标的…">Select ticker with fires…</option>
                </select>
              </div>
            </div>
            <div class="chart-container" id="det-chart-container">
              <div class="chart-fallback" id="det-chart-fallback">
                <span class="l-en">Illustrative sketch — select a ticker above to load real bars</span>
                <span class="l-zh">示意图 — 请在上方选择标的以加载真实行情</span>
              </div>
            </div>
            <div class="chart-note" id="det-chart-note" style="display:none;"></div>
          </div>

          <!-- Null caveat -->
          <div class="null-banner" id="det-null-banner" style="display:none;">
            <strong>
              <span class="l-en">No fires accrued yet —</span>
              <span class="l-zh">尚无触发记录 —</span>
            </strong>
            <span class="l-en"> pre-2010 data absent = data gap, not a verdict. Signal retained as a confluence input.</span>
            <span class="l-zh"> 2010年前数据缺失 = 数据空白，非研究结论。信号作为共振输入保留。</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

{# ═══════════════════════════════════════════
   TAB 3: STOCK PROFILE
═══════════════════════════════════════════ #}
<div class="tab-panel" id="tab-stock">
  <div class="stock-profile-layout">

    <!-- Left: chart + signal list -->
    <div>
      <div class="profile-header">
        <div>
          <div class="profile-ticker" id="prof-ticker">—</div>
          <div class="profile-name" id="prof-name"></div>
        </div>
        <div>
          <div class="profile-price" id="prof-price"></div>
        </div>
        <div class="profile-actions">
          <a class="open-terminal-btn" id="prof-terminal-link" href="https://app.mastermind-x.com/terminal" target="_blank" rel="noopener">
            <span>&#8599;</span>
            <span class="l-en">Open in Terminal</span>
            <span class="l-zh">在终端中打开</span>
          </a>
        </div>
      </div>

      <div class="perf-row" id="prof-perf-row">
        <div class="perf-cell">
          <div class="pk">7D</div>
          <div class="pv r-neu" id="prof-7d">—</div>
        </div>
        <div class="perf-cell">
          <div class="pk">30D</div>
          <div class="pv r-neu" id="prof-30d">—</div>
        </div>
        <div class="perf-cell">
          <div class="pk">
            <span class="l-en">Active Buy</span>
            <span class="l-zh">活跃买入</span>
          </div>
          <div class="pv" id="prof-active" style="color:var(--link)">—</div>
        </div>
        <div class="perf-cell">
          <div class="pk">
            <span class="l-en">Score</span>
            <span class="l-zh">评分</span>
          </div>
          <div class="pv" id="prof-score">—</div>
        </div>
      </div>

      <div class="confl-callout" id="prof-callout">
        <div class="confl-n" id="prof-confl-n">—</div>
        <div class="confl-label">
          <strong>
            <span class="l-en">buy signals active</span>
            <span class="l-zh">个买入信号活跃</span>
          </strong><br>
          <span id="prof-callout-sub" class="l-en">out of — tracked</span>
        </div>
        <div>
          <span class="band-chip" id="prof-band"></span>
        </div>
      </div>

      <!-- Real chart with fire markers from tech_events -->
      <div class="stock-chart-card">
        <div class="chart-ticker-label" id="prof-chart-label">
          <span class="l-en">Select a ticker to load the chart</span>
          <span class="l-zh">选择标的以加载图表</span>
        </div>
        <div class="stock-chart-container" id="prof-chart-container">
          <div class="chart-fallback" id="prof-chart-fallback">
            <span class="l-en">Illustrative sketch — real bars unavailable</span>
            <span class="l-zh">示意图 — 真实行情不可用</span>
          </div>
        </div>
        <div class="chart-note" id="prof-chart-note" style="display:none;"></div>
      </div>

      <!-- Signal state list grouped by family -->
      <div class="tl-card">
        <div class="tl-card-header">
          <h2>
            <span class="l-en">All Signal States</span>
            <span class="l-zh">全部信号状态</span>
          </h2>
          <span class="chip" id="prof-sig-counts"></span>
        </div>
        <div id="prof-sig-list">
          <p class="tl-empty">
            <span class="l-en">Select a ticker on the right to see its signal states.</span>
            <span class="l-zh">在右侧选择标的查看信号状态。</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Right: ticker search + era context -->
    <div>
      <div class="ticker-search-card" style="margin-bottom:16px;">
        <div class="confl-title" style="margin-bottom:10px;">
          <span class="l-en">Switch Ticker</span>
          <span class="l-zh">切换标的</span>
        </div>
        <input class="ts-input" type="text" id="ticker-search-input"
          data-ph-en="e.g. AAPL, NVDA…"
          data-ph-zh="如 AAPL, NVDA…"
          placeholder="e.g. AAPL, NVDA…"
          oninput="tlTickerSearch(this.value)">
        <div class="ts-results" id="ts-results"></div>
      </div>

      <div class="tl-card">
        <div class="tl-card-header">
          <h2>
            <span class="l-en">Era-split context</span>
            <span class="l-zh">时代分割背景</span>
          </h2>
        </div>
        <div style="font-size:11.5px;color:var(--muted);line-height:1.7;">
          <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
            <span class="era-badge2 era-pre">pre-2010</span>
            <span class="l-en">No data for most signals</span>
            <span class="l-zh">多数信号缺乏数据</span>
          </div>
          <div style="display:flex;gap:6px;align-items:center;">
            <span class="era-badge2 era-post">post-2010</span>
            <span class="l-en">All pooled stats — QE regime, rates cycle</span>
            <span class="l-zh">所有汇总统计 — QE周期，利率周期</span>
          </div>
          <div class="null-banner" style="margin-top:10px;">
            <strong><span class="l-en">Null reminder:</span><span class="l-zh">空值提示：</span></strong>
            <span class="l-en"> pre-2010 absent = data gap, not a verdict. Signals are retained as confluence inputs.</span>
            <span class="l-zh"> 2010年前缺失 = 数据空白，非研究结论。信号作为共振输入保留。</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

{# ═══════════════════════════════════════════
   TAB 4: HOW TO TEST
═══════════════════════════════════════════ #}
<div class="tab-panel" id="tab-test">
  <div style="margin-bottom:16px;">
    <h2 style="font-size:16px;font-weight:700;margin-bottom:6px;">
      <span class="l-en">How to Test — CLI &amp; pytest reference</span>
      <span class="l-zh">如何检验 — CLI 与 pytest 参考</span>
    </h2>
    <p style="font-size:12.5px;color:var(--muted);line-height:1.6;">
      <span class="l-en">For LLM sessions and human reviewers. All code runs against prod-shaped fixtures under <code>tests/fixtures/tech_parity/</code>. Exit 0 on honest nulls.</span>
      <span class="l-zh">适用于 LLM 会话和人工审核者。所有代码运行于 <code>tests/fixtures/tech_parity/</code> 下的生产形态测试夹具。零触发为诚实空值，退出码为0。</span>
    </p>
  </div>
  <div class="how-grid">

    <div class="how-card">
      <h3>&#9654; <span class="l-en">Signal inventory</span><span class="l-zh">信号列表</span></h3>
      <p>
        <span class="l-en">Print the full catalog as JSON: id, family, kind, direction, bilingual names.</span>
        <span class="l-zh">以 JSON 格式打印完整目录：id、族群、类型、方向、双语名称。</span>
      </p>
      <div class="code-block-wrap">
        <button class="copy-btn" onclick="tlCopyCode(this)">Copy</button>
        <div class="code-block"><span class="code-comment"># list all signals</span>
<span class="code-kw">python</span> -m scripts.tech_lab_cli list

<span class="code-comment"># filter to one family</span>
<span class="code-kw">python</span> -m scripts.tech_lab_cli list --family ichimoku</div>
      </div>
    </div>

    <div class="how-card">
      <h3>&#128203; <span class="l-en">Per-ticker state</span><span class="l-zh">个股信号状态</span></h3>
      <p>
        <span class="l-en">Emit latest per-signal state for one ticker. Output: JSON dict keyed by signal_id with <code>{state, direction, kind, display_en}</code>.</span>
        <span class="l-zh">输出单只股票的最新信号状态。输出：以 signal_id 为键的 JSON，含 <code>{state, direction, kind, display_en}</code>。</span>
      </p>
      <div class="code-block-wrap">
        <button class="copy-btn" onclick="tlCopyCode(this)">Copy</button>
        <div class="code-block"><span class="code-kw">python</span> -m scripts.tech_lab_cli state NVDA
<span class="code-kw">python</span> -m scripts.tech_lab_cli state AAPL | python -m json.tool</div>
      </div>
    </div>

    <div class="how-card">
