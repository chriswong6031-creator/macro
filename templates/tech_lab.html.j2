    firingTickers.map(function(tk){ return '<option value="'+tk+'">'+tk+'</option>'; }).join('');
  if (firingTickers.length > 0) {
    sel.value = firingTickers[0];
    tlLabChartDraw();
  }

  // Show null banner if needed
  var nullBanner = document.getElementById('det-null-banner');
  if (nullBanner) nullBanner.style.display = (sig.n_fires === 0) ? '' : 'none';
};

