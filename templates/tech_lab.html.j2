      '<td class="'+wrCls+'" style="font-variant-numeric:tabular-nums;">'+(r.wr!=null?_wr(r.wr):'—')+'</td>'+
      '<td class="'+eCls+'" style="font-variant-numeric:tabular-nums;">'+(r.edge!=null?_edge(r.edge):'—')+'</td>'+
      '<td class="tl-num" style="font-size:11px;color:var(--muted);">'+(r.fires!=null?r.fires.toLocaleString():'—')+(r.months!=null?' / '+r.months:'')+'</td>'+
      '</tr>';
  }).join('');

  // Populate ticker select for chart
  var sc = (window._SCREENER_SIGS||{})[sid];
  var firingTickers = sc ? (sc.tickers||[]).map(function(t){return t.ticker;}) : [];
  var sel = document.getElementById('det-ticker-select');
