/* ─── Chart helper ─────────────────────────────────────────────────────── */
function tlChartOpts() {
  var isDark = document.documentElement.getAttribute('data-theme') !== 'light';
  return {
    autoSize: true,
    layout: { background: { type: 'solid', color: 'transparent' },
      textColor: isDark ? '#8b93a1' : '#5d6b7e', fontSize: 11 },
    grid: { vertLines: { visible: false }, horzLines: { color: isDark ? '#2a2f3a' : '#eaecf0' } },
    rightPriceScale: { borderColor: isDark ? '#2a2f3a' : '#eaecf0' },
    timeScale: { borderColor: isDark ? '#2a2f3a' : '#eaecf0', timeVisible: false },
    crosshair: { mode: 1 }
  };
}

function tlFetchOhlc(ticker, cb) {
  // Uses the same dbase-resolved URL as stock pages: ohlc/<T>.json
  var url = 'ohlc/' + ticker + '.json';
  fetch(url).then(function(r) {
    if (!r.ok) { cb(null, 'HTTP ' + r.status); return; }
    return r.json();
  }).then(function(d) {
    if (!d) return;
    cb(d, null);
  }).catch(function(e) { cb(null, String(e)); });
}

function tlFetchEvents(ticker, cb) {
  if (EVENTS[ticker]) { cb(EVENTS[ticker]); return; }
  var url = 'factordata/tech_events/' + ticker + '.json';
  fetch(url).then(function(r) {
    if (!r.ok) { cb(null); return; }
    return r.json();
  }).then(function(d) {
    EVENTS[ticker] = d || null;
    cb(d);
  }).catch(function() { cb(null); });
}

function _parseOhlc(d) {
  // tech_screener ohlc format: {dates:[...], bars:[[o,h,l,c,v],...], o:1} or {dates,closes}
  var bars = [];
  if (!d || !d.dates) return bars;
  var dates = d.dates;
  if (d.bars && d.o === 1) {
    for (var i=0; i<dates.length; i++) {
      if (!d.bars[i]) continue;
      bars.push({ time: dates[i], open: d.bars[i][0], high: d.bars[i][1], low: d.bars[i][2], close: d.bars[i][3] });
    }
  } else if (d.closes) {
    for (var i=0; i<dates.length; i++) {
      var c = d.closes[i];
      if (c == null) continue;
      bars.push({ time: dates[i], open: c, high: c, low: c, close: c });
    }
  } else if (Array.isArray(d.bars) && d.bars.length) {
    // array of [date,o,h,l,c] or [date,c]
    for (var i=0; i<d.bars.length; i++) {
      var b = d.bars[i];
      if (b.length >= 5) bars.push({ time: b[0], open: b[1], high: b[2], low: b[3], close: b[4] });
      else if (b.length >= 2) bars.push({ time: b[0], open: b[1], high: b[1], low: b[1], close: b[1] });
    }
  }
  return bars;
}

function tlDrawChart(containerId, fallbackId, noteId, ticker, sigId, ohlcData, eventsData, chartRef) {
  var container = document.getElementById(containerId);
  var fallback  = document.getElementById(fallbackId);
  if (!container) return chartRef;

  // Clear existing chart
  if (chartRef && chartRef._lwChart) {
    try { chartRef._lwChart.remove(); } catch(e){}
    chartRef._lwChart = null;
  }
  container.innerHTML = '';

  if (!ohlcData) {
    if (fallback) { fallback.style.display = ''; fallback.innerHTML = L('Illustrative sketch — real bars unavailable','示意图 — 真实行情不可用'); }
    return chartRef;
  }

  var bars = _parseOhlc(ohlcData);
  if (bars.length < 5) {
    if (fallback) { fallback.style.display = ''; fallback.innerHTML = L('Illustrative sketch — real bars unavailable','示意图 — 真实行情不可用'); }
    return chartRef;
  }

  if (fallback) fallback.style.display = 'none';

  if (typeof LightweightCharts === 'undefined') {
    container.innerHTML = '<div class="chart-fallback">'+L('Charting library failed to load — the rest of the page is unaffected.','图表库加载失败，页面其余部分不受影响。')+'</div>';
    return chartRef;
  }

  var lw = LightweightCharts.createChart(container, tlChartOpts());
  var series = lw.addCandlestickSeries({
    upColor: '#1f9a55', downColor: '#d23f3f',
    borderUpColor: '#1f9a55', borderDownColor: '#d23f3f',
    wickUpColor: '#1f9a55', wickDownColor: '#d23f3f'
  });
  series.setData(bars);

  // Fire markers from tech_events
  if (eventsData && eventsData.signals && sigId && eventsData.signals[sigId]) {
    var sig = eventsData.signals[sigId];
    var fireDates = sig.fires || [];
    var dir = sig.dir || 0;
    var markers = fireDates.map(function(d) {
      return {
        time: d,
        position: dir >= 0 ? 'belowBar' : 'aboveBar',
        color: dir >= 0 ? '#3fc07e' : '#ef6a6a',
        shape: dir >= 0 ? 'arrowUp' : 'arrowDown',
        text: (SIGS[sigId]&&SIGS[sigId].display_en)||sigId
      };
    }).filter(function(m) {
      return bars.some(function(b){ return b.time === m.time; });
    });
    if (markers.length > 0) series.setMarkers(markers);
    var noteEl = document.getElementById(noteId);
    if (noteEl) {
      noteEl.style.display = '';
      noteEl.innerHTML = L(
        ticker + ' · ' + markers.length + ' signal fire markers from tech_events (real dates)',
        ticker + ' · ' + markers.length + ' 个信号触发标记来自 tech_events（真实日期）'
      );
    }
  }

  lw.timeScale().fitContent();
  return { _lwChart: lw, _series: series };
}

/* ─── Signal Lab chart ─────────────────────────────────────────────────── */
window.tlLabChartDraw = function() {
  var sel = document.getElementById('det-ticker-select');
  var ticker = sel ? sel.value : '';
  if (!ticker || !_activeSigId) return;

  tlFetchOhlc(ticker, function(ohlc, err) {
    tlFetchEvents(ticker, function(events) {
      _labChart = tlDrawChart(
        'det-chart-container', 'det-chart-fallback', 'det-chart-note',
        ticker, _activeSigId, ohlc, events, _labChart
      );
    });
  });
};

/* ─── Stock profile ─────────────────────────────────────────────────────── */
window.tlOpenProfile = function(tk) {
  _profTk = tk;
  tlSwitchTab('stock');
  var s = STKS[tk];
  if (!s) return;

  document.getElementById('prof-ticker').textContent = tk;
  document.getElementById('prof-name').textContent = s.name || '';
  document.getElementById('prof-price').textContent = s.price != null ? '$'+s.price.toFixed(2) : '';

  var p7 = s.perf_7d, p30 = s.perf_30d;
  var p7el = document.getElementById('prof-7d');
  p7el.textContent = _pct(p7); p7el.className = 'pv '+(p7!=null?(p7>=0?'r-pos':'r-neg'):'r-neu');
  var p30el = document.getElementById('prof-30d');
  p30el.textContent = _pct(p30); p30el.className = 'pv '+(p30!=null?(p30>=0?'r-pos':'r-neg'):'r-neu');

  var actEl = document.getElementById('prof-active');
  actEl.textContent = (s.active_buy||0) + ' / ' + (s.active_total||0);
  var scEl = document.getElementById('prof-score');
  scEl.textContent = s.score != null ? (s.score > 0?'+':'')+s.score.toFixed(2) : '—';
  scEl.className = 'pv '+(s.score>0.5?'r-pos':s.score<0?'r-neg':'r-neu');

  document.getElementById('prof-confl-n').textContent = s.active_buy || 0;
  document.getElementById('prof-callout-sub').innerHTML = L(
    'out of ' + (s.active_total||0) + ' tracked',
    '共 ' + (s.active_total||0) + ' 个信号中'
  );
  var bandEl = document.getElementById('prof-band');
  bandEl.textContent = s.band || '';
  bandEl.className = 'band-chip ' + _bandClass(s.band);

  // Terminal deep-link with indicator keys
  var famMap = { 'ichimoku': 'ichimoku', 'trend_ribbon': 'ribbon', 'trend': 'ribbon',
    'rsi_stack': 'rsistack', 'rsi_bands': 'rsistack', 'bollinger_events': 'volbox', 'formations': 'volbox' };
  var indKeys = new Set();
  (s.signals||[]).forEach(function(sig) {
    if (sig.state) {
      var k = famMap[sig.family||''];
      if (!k && SIGS[sig.id]) k = famMap[SIGS[sig.id].family||''];
      if (k) indKeys.add(k);
    }
  });
  var linkEl = document.getElementById('prof-terminal-link');
  var indStr = Array.from(indKeys).slice(0,3).join(',');
  linkEl.href = 'https://app.mastermind-x.com/terminal?sym=' + tk + (indStr ? '&ind=' + indStr : '');

  // Signal state list grouped by family
  var famGroups = {};
  (s.signals||[]).forEach(function(sig) {
    var lab = SIGS[sig.id];
    var fam = (lab&&lab.family) || 'other';
    if (!famGroups[fam]) famGroups[fam] = [];
    sig._fam = fam;
    famGroups[fam].push(sig);
  });
  var listEl = document.getElementById('prof-sig-list');
  var listHtml = '';
  Object.keys(famGroups).sort().forEach(function(fam) {
    var isFundamental = fam.indexOf('fundamental') >= 0 || fam.indexOf('insider') >= 0;
    listHtml += '<div class="family-divider">' + esc(_familyLabel(fam));
    if (isFundamental) listHtml += ' <span style="color:var(--warn);font-size:9.5px;">' + L('(display-only)','（仅供展示）') + '</span>';
    listHtml += '</div><div class="sig-state-list">';
    famGroups[fam].forEach(function(sig) {
      var isOn = !!sig.state;
      var label = (SIGS[sig.id]&&SIGS[sig.id].display_en) || sig.display_en || sig.id;
      var ageStr = sig.age_days != null ? sig.age_days + 'd' : '';
      var rowClass = isOn ? 'on' : 'off';
      if (isFundamental) rowClass = 'off';
      listHtml += '<div class="sig-state-row ' + rowClass + '">' +
        (isOn && !isFundamental ? '<span class="sig-on-mark">&#9679;</span>' : '<span class="sig-off-mark">&#9675;</span>') +
        '<span class="sig-state-name">' + esc(label) + '</span>' +
        '<span class="sig-state-age">' + esc(ageStr) + '</span>' +
        '</div>';
    });
    listHtml += '</div>';
  });
  listEl.innerHTML = listHtml || '<p class="tl-empty">No signal data</p>';
  var onCount = (s.signals||[]).filter(function(sig){ return sig.state && !['fundamental_valuation','insider'].includes(sig._fam||''); }).length;
  var offCount = (s.signals||[]).length - onCount;
  document.getElementById('prof-sig-counts').textContent = onCount + ' on / ' + offCount + ' off';

  // Chart label
  document.getElementById('prof-chart-label').innerHTML = L(
    tk + ' · Daily price chart · fire markers from tech_events',
    tk + ' · 日线图 · tech_events 触发标记'
  );

  // Draw stock chart with all fire markers
  tlFetchOhlc(tk, function(ohlc, err) {
    tlFetchEvents(tk, function(events) {
      var container = document.getElementById('prof-chart-container');
      var fallback  = document.getElementById('prof-chart-fallback');
      if (!container) return;

      if (_profChart && _profChart._lwChart) {
        try { _profChart._lwChart.remove(); } catch(e){} _profChart._lwChart = null;
      }
      container.innerHTML = '';

      if (!ohlc) {
        if (fallback) { fallback.style.display = ''; fallback.innerHTML = L('Illustrative sketch — real bars unavailable','示意图 — 真实行情不可用'); }
        return;
      }
      var bars = _parseOhlc(ohlc);
      if (bars.length < 5) {
        if (fallback) { fallback.style.display = ''; fallback.innerHTML = L('Illustrative sketch — real bars unavailable','示意图 — 真实行情不可用'); }
        return;
      }
      if (fallback) fallback.style.display = 'none';
      if (typeof LightweightCharts === 'undefined') {
        container.innerHTML = '<div class="chart-fallback">'+L('Charting library failed to load.','图表库加载失败。')+'</div>'; return;
      }

      var lw = LightweightCharts.createChart(container, tlChartOpts());
      var series = lw.addCandlestickSeries({
        upColor:'#1f9a55', downColor:'#d23f3f',
        borderUpColor:'#1f9a55', borderDownColor:'#d23f3f',
        wickUpColor:'#1f9a55', wickDownColor:'#d23f3f'
      });
      series.setData(bars);

      // ALL signals' fire markers clustered
      var allMarkers = [];
      if (events && events.signals) {
        Object.keys(events.signals).forEach(function(sigId) {
          var sigData = events.signals[sigId];
          var lab = SIGS[sigId];
          var dir = sigData.dir || 0;
          (sigData.fires||[]).forEach(function(d) {
            if (bars.some(function(b){ return b.time === d; })) {
              allMarkers.push({ time: d, position: dir >= 0 ? 'belowBar' : 'aboveBar',
                color: dir >= 0 ? '#3fc07e' : '#ef6a6a',
                shape: dir >= 0 ? 'arrowUp' : 'arrowDown',
                text: (lab&&lab.display_en)||sigId });
            }
          });
        });
        allMarkers.sort(function(a,b){ return a.time < b.time ? -1 : a.time > b.time ? 1 : 0; });
        if (allMarkers.length > 0) series.setMarkers(allMarkers);
        var noteEl = document.getElementById('prof-chart-note');
        if (noteEl) {
          noteEl.style.display = '';
          noteEl.innerHTML = L(
            tk + ' · ' + allMarkers.length + ' fire markers across all signals (real dates from tech_events)',
            tk + ' · ' + allMarkers.length + ' 个信号触发标记（来自 tech_events 真实日期）'
          );
        }
      }
      lw.timeScale().fitContent();
      _profChart = { _lwChart: lw };
    });
  });
};

