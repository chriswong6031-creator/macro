  var eraRows = [
    { tag:'post', cls:'era-post', en:'Post-2010', zh:'2010后', wr:post, edge:sig.edge_wr, fires:sig.n_fires, months:sig.n_months },
    { tag:'pre',  cls:'era-pre',  en:'Pre-2010',  zh:'2010前', wr:pre, edge:null, fires:null, months:null },
    { tag:'pool', cls:'era-pool', en:'Pooled',    zh:'汇总', wr:pool, edge:sig.edge_wr, fires:sig.n_fires, months:sig.n_months }
  ];
  var eraTbody = document.getElementById('det-era-body');
  eraTbody.innerHTML = eraRows.map(function(r) {
    var wrCls = r.wr!=null ? (r.wr>(baseWr||0.55)?'r-pos':r.wr<(baseWr||0.55)-0.02?'r-neg':'') : 'r-neu';
    var eCls  = r.edge!=null ? (r.edge>0.01?'r-pos':r.edge<-0.01?'r-neg':'') : 'r-neu';
    var note  = (r.tag==='pre' && pre == null) ? ' <span style="color:var(--muted);font-size:10px;">'+preNote+'</span>' : '';
