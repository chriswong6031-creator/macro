{% block body_scripts %}
<script src="lightweight-charts.js"></script>
<script>
(function () {
'use strict';

/* ─── i18n helper ─────────────────────────────────────────────────────── */
function L(en, zh) {
  return '<span class="l-en">' + en + '</span><span class="l-zh">' + (zh != null ? zh : en) + '</span>';
}
function isZh() { return document.documentElement.getAttribute('data-lang') === 'zh'; }

/* ─── Global state ─────────────────────────────────────────────────────── */
var SIGS = {};          // tech_lab.json signals
var STKS = {};          // tech_screener.json stocks
var SIG_FIRES = {};     // signal_id → [ticker,...] (from screener)
var EVENTS = {};        // ticker → tech_events payload (cached)
var _loaded = false;

/* screener */
var _screenerRows = [];
var _screenerSort = 'score';
var _screenerAsc  = false;
var _screenerFilter = '';
var _screenerBand = '';
var _screenerPage = 0;
var PAGE_SIZE = 25;

/* catalog */
var _catalogRows = [];
var _catalogSort = 'edge_wr';
var _catalogAsc  = false;

/* confluence */
var _activeConfl = new Set();
var _conflLogic  = 'ALL';
var _MAX_CONFL   = 4;

/* signal lab */
var _activeSigId = null;
var _labChart    = null;
var _labChartSeries = null;
var _labMarkers  = [];

/* stock profile */
var _profTk = null;
var _profChart = null;
var _profChartSeries = null;

/* ─── Tab router (hash-based) ─────────────────────────────────────────── */
var TABS = ['screener','siglab','stock','test'];
function tlSwitchTab(id) {
  TABS.forEach(function(t) {
    var el = document.getElementById('tab-' + t);
    var btn = document.getElementById('tb-' + t);
    if (el) el.classList.toggle('active', t === id);
    if (btn) btn.classList.toggle('active', t === id);
  });
  try { localStorage.setItem('tl_tab', id); } catch(e){}
  if (history.replaceState) history.replaceState(null,'','#'+id);
}
function tlInitTab() {
  var hash = (location.hash||'').replace('#','');
  var stored = '';
  try { stored = localStorage.getItem('tl_tab')||''; } catch(e){}
  var tab = TABS.indexOf(hash) >= 0 ? hash : (TABS.indexOf(stored) >= 0 ? stored : 'screener');
  tlSwitchTab(tab);
}
window.addEventListener('hashchange', function() {
  var h = (location.hash||'').replace('#','');
  if (TABS.indexOf(h) >= 0) tlSwitchTab(h);
});

/* Tab buttons */
document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var t = btn.getAttribute('data-tab');
    if (t) tlSwitchTab(t);
  });
});

/* ─── Helpers ─────────────────────────────────────────────────────────── */
function _pct(v) { return v != null ? (v >= 0 ? '+' : '') + (v * 100).toFixed(1) + '%' : '—'; }
function _wr(v)  { return v != null ? (v * 100).toFixed(1) + '%' : '—'; }
function _edge(v){ return v != null ? (v >= 0 ? '+' : '') + (v * 100).toFixed(1) + 'pp' : '—'; }
function _gaugeClass(score) {
  if (score == null) return 'g-lo';
  if (score >= 0.7) return 'g-hi';
  if (score >= 0.2) return 'g-mod';
  if (score >= -0.2) return 'g-lo';
  return 'g-neg';
}
function _bandClass(b) {
  if (!b) return 'band-Hold';
  if (b === 'Buy') return 'band-Buy';
  if (b === 'Sell') return 'band-Sell';
  return 'band-Hold';
}
function _dirBadge(dir) {
  if (dir > 0) return '<span class="sig-dir-badge dir-up">&#9650;</span>';
  if (dir < 0) return '<span class="sig-dir-badge dir-down">&#9660;</span>';
  return '<span class="sig-dir-badge dir-neu">&#8212;</span>';
}
function _edgeChip(e) {
  if (e == null) return '<span class="tl-edge-chip edge-neu">—</span>';
  var pp = e * 100;
  var cls = pp >= 4 ? 'edge-strong' : pp >= 1 ? 'edge-pos' : pp <= -1 ? 'edge-neg' : 'edge-neu';
  return '<span class="tl-edge-chip ' + cls + '">' + (pp >= 0 ? '+' : '') + pp.toFixed(1) + 'pp</span>';
}
function _eraChip(sig) {
  var pre = sig.wr_pre2010;
  var post = sig.wr_post2010;
  if (pre == null) return '<span class="era-badge2 era-post">post-2010 only</span>';
  if (post == null) return '<span class="era-badge2 era-pre">pre-2010 only</span>';
  var agree = (pre >= sig.base_wr) === (post >= sig.base_wr);
  if (agree) return '<span class="era-badge2 era-stable">stable</span>';
  return '<span class="era-badge2 era-divg">era-divergent</span>';
}
function _familyLabel(f) {
  return (f||'').replace(/_/g,' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); });
}
function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ─── Screener ─────────────────────────────────────────────────────────── */
function tlBuildScreenerRows() {
  _screenerRows = Object.keys(STKS).map(function(tk) {
    var s = STKS[tk];
    return { tk: tk, name: s.name, price: s.price, score: s.score, band: s.band,
      buy: s.active_buy, total: s.active_total,
      perf7d: s.perf_7d, perf30d: s.perf_30d };
  });
}

function tlFilterScreener() {
  _screenerFilter = (document.getElementById('screener-search').value || '').trim().toLowerCase();
  _screenerBand   = document.getElementById('band-filter').value || '';
  _screenerPage   = 0;
  tlRenderScreener();
}

function tlSortScreener(key, th) {
  if (_screenerSort === key) { _screenerAsc = !_screenerAsc; } else { _screenerSort = key; _screenerAsc = false; }
  document.querySelectorAll('#screener-table th').forEach(function(t){ t.classList.remove('sorted'); });
  if (th) th.classList.add('sorted');
  tlRenderScreener();
}

function tlRenderScreener() {
  if (!_loaded) return;
  var rows = _screenerRows.filter(function(r) {
    if (_screenerFilter && !(r.tk.toLowerCase().includes(_screenerFilter) || (r.name||'').toLowerCase().includes(_screenerFilter))) return false;
    if (_screenerBand && r.band !== _screenerBand) return false;
    return true;
  });
  rows.sort(function(a,b) {
    var key = _screenerSort;
    var va = a[key] != null ? a[key] : -999;
    var vb = b[key] != null ? b[key] : -999;
    return _screenerAsc ? va - vb : vb - va;
  });
  var total = rows.length;
  var pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
  _screenerPage = Math.min(_screenerPage, pages - 1);
  var slice = rows.slice(_screenerPage * PAGE_SIZE, (_screenerPage + 1) * PAGE_SIZE);

  var tbody = document.getElementById('screener-tbody');
  tbody.innerHTML = slice.map(function(r) {
    var scorePct = Math.max(0, Math.min(100, (r.score + 1) / 2.2 * 100));
    var gCls = _gaugeClass(r.score);
    var sCls = r.score > 0.5 ? 'r-pos' : r.score < 0 ? 'r-neg' : 'r-neu';
    var dots = '';
    for (var i=0; i<(r.buy||0); i++) dots += '<span class="sig-dot dot-buy"></span>';
    for (var j=0; j<Math.max(0,(r.total||0)-(r.buy||0)); j++) dots += '<span class="sig-dot dot-off"></span>';
    return '<tr onclick="tlOpenProfile(\'' + r.tk + '\')">' +
      '<td><span class="tl-tk">' + esc(r.tk) + '</span><span class="tl-name">' + esc(r.name||'') + '</span></td>' +
      '<td class="tl-num">' + (r.price != null ? '$'+r.price.toFixed(2) : '—') + '</td>' +
      '<td class="tl-num"><div class="gauge-wrap"><div class="gauge '+gCls+'"><i style="width:'+scorePct.toFixed(0)+'%"></i></div>' +
        '<span class="gauge-score '+sCls+'">' + (r.score != null ? (r.score > 0 ? '+' : '')+r.score.toFixed(2) : '—') + '</span></div></td>' +
      '<td><span class="band-chip '+_bandClass(r.band)+'">' + esc(r.band||'—') + '</span></td>' +
      '<td class="tl-num">' + (r.perf7d != null ? '<span class="'+(r.perf7d>=0?'r-pos':'r-neg')+'">' + _pct(r.perf7d) + '</span>' : '<span class="r-neu">—</span>') + '</td>' +
      '<td class="tl-num">' + (r.perf30d != null ? '<span class="'+(r.perf30d>=0?'r-pos':'r-neg')+'">' + _pct(r.perf30d) + '</span>' : '<span class="r-neu">—</span>') + '</td>' +
      '<td><div class="sig-dots">' + dots + '</div></td>' +
      '</tr>';
  }).join('');

  var from = total === 0 ? 0 : _screenerPage * PAGE_SIZE + 1;
  var to = Math.min((_screenerPage + 1) * PAGE_SIZE, total);
  var countEl = document.getElementById('screener-count');
  countEl.innerHTML = L('Showing ' + from + '–' + to + ' of ' + total, '显示 '+from+'–'+to+' 共 '+total);

  // Pagination
  var pgEl = document.getElementById('screener-pages');
  pgEl.innerHTML = '';
  if (pages > 1) {
    for (var p=0; p<pages; p++) {
      (function(pg) {
        var btn = document.createElement('button');
        btn.className = 'tbl-page-btn' + (pg === _screenerPage ? ' active' : '');
        btn.textContent = pg + 1;
        btn.onclick = function(){ _screenerPage = pg; tlRenderScreener(); };
        pgEl.appendChild(btn);
      })(p);
    }
  }
}

/* ─── Confluence Builder ─────────────────────────────────────────────── */
function tlBuildConflChips() {
  // Group by family, show signals with fires first
  var families = {};
  Object.keys(SIG_FIRES).forEach(function(sid) {
    var sc = (window._SCREENER_SIGS||{})[sid];
    if (!sc) return;
    var fam = sc.family || 'other';
    if (!families[fam]) families[fam] = [];
    families[fam].push(sid);
  });

  var html = '';
  Object.keys(families).sort().forEach(function(fam) {
    var sids = families[fam];
    if (!sids.length) return;
    html += '<div><div class="confl-section-label">' + esc(_familyLabel(fam)) + '</div><div class="confl-chips">';
    sids.forEach(function(sid) {
      var sc = (window._SCREENER_SIGS||{})[sid];
      var lab = SIGS[sid];
      var enName = esc((sc&&sc.display_en)||sid);
      var dir = (sc&&sc.direction) || 0;
      var isBuy = dir > 0 ? ' buy-chip' : '';
      html += '<button class="confl-chip' + isBuy + '" data-sid="' + sid + '" onclick="tlConflToggle(this,\'' + sid + '\')">' + enName + '</button>';
    });
    html += '</div></div>';
  });
  var area = document.getElementById('confl-chip-area');
  if (area) area.innerHTML = html || '<p class="r-neu" style="font-size:12px;">No signals with current fires</p>';

  // Set default: pick 2 signals with non-empty intersection (computed dynamically)
  var pairs = Object.keys(SIG_FIRES);
  var defaultA = null, defaultB = null;
  for (var i=0; i<pairs.length && !defaultA; i++) {
    var setA = new Set(SIG_FIRES[pairs[i]]);
    for (var j=i+1; j<pairs.length && !defaultA; j++) {
      var setB = SIG_FIRES[pairs[j]];
      var inter = setB.filter(function(t){ return setA.has(t); });
      if (inter.length >= 1) { defaultA = pairs[i]; defaultB = pairs[j]; }
    }
  }
  if (defaultA && defaultB) {
    _activeConfl.add(defaultA);
    _activeConfl.add(defaultB);
    document.querySelectorAll('#confl-chip-area .confl-chip').forEach(function(btn) {
      var sid = btn.getAttribute('data-sid');
      if (sid === defaultA || sid === defaultB) btn.classList.add('active');
    });
  }
  tlConflUpdate();
}

window.tlConflToggle = function(btn, sid) {
  if (_activeConfl.has(sid)) {
    _activeConfl.delete(sid);
    btn.classList.remove('active');
  } else if (_activeConfl.size < _MAX_CONFL) {
    _activeConfl.add(sid);
    btn.classList.add('active');
  }
  tlConflUpdate();
};

window.tlConflSetLogic = function(l) {
  _conflLogic = l;
  document.getElementById('logic-all').classList.toggle('active', l==='ALL');
  document.getElementById('logic-any').classList.toggle('active', l==='ANY');
  tlConflUpdate();
};

function tlConflUpdate() {
  var countEl = document.getElementById('confl-count');
  var labelEl = document.getElementById('confl-count-label');
  var tksEl   = document.getElementById('confl-tickers');
  var emptyEl = document.getElementById('confl-empty-msg');

  if (_activeConfl.size === 0) {
    countEl.textContent = '—';
    labelEl.innerHTML = L('pick signals above','请选择信号');
    tksEl.innerHTML = '';
    if (emptyEl) emptyEl.style.display = 'none';
    return;
  }
  var sets = Array.from(_activeConfl).map(function(sid){ return new Set(SIG_FIRES[sid]||[]); });
  var result;
  if (_conflLogic === 'ALL') {
    result = sets.reduce(function(acc, s){ return new Set(Array.from(acc).filter(function(x){ return s.has(x); })); });
  } else {
    result = new Set(sets.reduce(function(acc,s){ return acc.concat(Array.from(s)); }, []));
  }
  var tks = Array.from(result);
  countEl.textContent = tks.length;
  var logic_zh = _conflLogic === 'ALL' ? '全部' : '任一';
  labelEl.innerHTML = L('names match · ' + _conflLogic, '个标的匹配 · ' + logic_zh);
  if (tks.length === 0) {
    tksEl.innerHTML = '';
    if (emptyEl) emptyEl.style.display = '';
  } else {
    if (emptyEl) emptyEl.style.display = 'none';
    var show = tks.slice(0,5).map(function(t){ return '<span style="color:var(--link);font-weight:600;">'+esc(t)+'</span>'; }).join(' · ');
    var more = tks.length > 5 ? ' <span>+' + (tks.length-5) + ' more</span>' : '';
    tksEl.innerHTML = show + more;
  }
}

/* ─── Signal Picker (Tab 2) ─────────────────────────────────────────────── */
function tlBuildPicker() {
  var families = {};
  Object.keys(SIGS).forEach(function(sid) {
    var sig = SIGS[sid];
    var fam = sig.family || 'other';
    if (!families[fam]) families[fam] = [];
    families[fam].push(sid);
  });

  var html = '';
  Object.keys(families).sort().forEach(function(fam) {
    var sids = families[fam];
    html += '<div class="sig-family-label">' + esc(_familyLabel(fam)) + '</div>';
    sids.forEach(function(sid) {
      var sig = SIGS[sid];
      var sc = (window._SCREENER_SIGS||{})[sid];
      var nFire = (sc&&sc.n_firing) || 0;
      var wr = sig.wr_post2010 != null ? sig.wr_post2010 : sig.wr_21d;
      var wrFill = wr != null ? Math.max(0,Math.min(100,(wr-0.48)/0.24*100)) : 0;
      var wrColor = wr != null ? (wr > 0.6 ? 'var(--up)' : wr > 0.55 ? 'var(--info)' : 'var(--muted)') : 'var(--line)';
      html += '<button class="sig-row" data-sid="' + sid + '" onclick="tlSelectSignal(\'' + sid + '\')">' +
        _dirBadge(sig.direction) +
        '<span class="sig-row-name">' + esc(sig.display_en||sid) + '</span>' +
        '<span class="wr-bar-mini"><span class="wr-track"><span class="wr-fill" style="width:'+wrFill.toFixed(0)+'%;background:'+wrColor+'"></span></span>' +
        '<span class="wr-val" style="color:'+wrColor+'">' + (wr != null ? (wr*100).toFixed(1)+'%' : '—') + '</span></span>' +
        '<span class="fire-badge' + (nFire > 0 ? ' active' : '') + '">' + (nFire > 0 ? nFire+'▲' : '0') + '</span>' +
        '</button>';
    });
  });

  var picker = document.getElementById('sig-picker');
  if (picker) picker.innerHTML = html;
}

/* ─── Catalog Table ─────────────────────────────────────────────────────── */
function tlBuildCatalogRows() {
  _catalogRows = Object.keys(SIGS).map(function(sid) {
    var s = SIGS[sid];
    return { sid: sid, display_en: s.display_en||sid, family: s.family||'', direction: s.direction||0,
      wr_21d: s.wr_21d, base_wr: s.base_wr, edge_wr: s.edge_wr, up_tape_pct: s.up_tape_pct,
      n_fires: s.n_fires, n_months: s.n_months, wr_pre2010: s.wr_pre2010, wr_post2010: s.wr_post2010, kind: s.kind };
  });
}

window.tlSortCatalog = function(key, th) {
  if (_catalogSort === key) { _catalogAsc = !_catalogAsc; } else { _catalogSort = key; _catalogAsc = false; }
  document.querySelectorAll('#catalog-table th').forEach(function(t){ t.classList.remove('sorted'); });
  if (th) th.classList.add('sorted');
  tlRenderCatalog();
};

function tlRenderCatalog() {
  if (!_loaded) return;
  var rows = _catalogRows.slice().sort(function(a,b) {
    var key = _catalogSort;
    var va = a[key] != null ? a[key] : -999;
    var vb = b[key] != null ? b[key] : -999;
    return _catalogAsc ? va - vb : vb - va;
  });

  var note = document.getElementById('catalog-count-note');
  if (note) note.innerHTML = L(rows.length + ' signals — click a row to drill in', rows.length + ' 个信号 — 点击行查看详情');

  var tbody = document.getElementById('catalog-tbody');
  tbody.innerHTML = rows.map(function(r) {
    var wrBar = '';
    if (r.wr_21d != null) {
      var bx = (r.base_wr||0) * 80;
      var wx = r.wr_21d * 80;
      wrBar = '<svg width="80" height="12" viewBox="0 0 80 12">' +
        '<rect x="0" y="3" width="80" height="6" rx="3" fill="var(--panel2)"/>' +
