{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>{{ s.name_en }} — Strategy</title>
{% include '_plotly_head.html.j2' %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r2:{{C.r2}}; --r3:{{C.r3}}; --ink:{{C.ink}};
  --text:{{C.text}}; --muted:{{C.muted}}; --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}}; --green:#1FA971;
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0 14px;border-bottom:1px solid var(--grid);margin-bottom:24px;position:sticky;top:0;background:var(--bg);z-index:20}
.nav-links{display:flex;align-items:center;gap:2px;flex-wrap:wrap}
a.nav-link{padding:7px 11px;border-radius:9px;font-size:13.5px;font-weight:500;color:var(--muted);text-decoration:none;white-space:nowrap;transition:color .18s,background .18s}
a.nav-link:hover,a.nav-link.active{color:var(--ink);background:#eef1f6}
.nav-dd{position:relative;display:inline-flex}
.nav-dd>a.nav-link .caret{display:inline-block;margin-left:3px;font-size:9px;opacity:.6;transition:transform .2s}
.nav-dd:hover>a.nav-link .caret,.nav-dd:focus-within>a.nav-link .caret{transform:rotate(180deg)}
.nav-dd::after{content:"";position:absolute;left:0;right:0;top:100%;height:9px}
.nav-dd-menu{position:absolute;top:calc(100% + 7px);left:0;min-width:218px;background:var(--card);border:1px solid var(--grid);border-radius:13px;box-shadow:0 12px 34px rgba(16,24,40,.14);padding:6px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:70}
.nav-dd:hover>.nav-dd-menu,.nav-dd:focus-within>.nav-dd-menu{opacity:1;visibility:visible;transform:translateY(0)}
.nav-dd-menu a{display:block;padding:9px 12px;border-radius:9px;font-size:13.5px;font-weight:600;color:var(--text);text-decoration:none;white-space:nowrap;transition:background .15s,color .15s}
.nav-dd-menu a .d{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:2px}
.nav-dd-menu a:hover,.nav-dd-menu a.active{background:#eef1f6;color:var(--ink)}
.nav-ctrls{display:flex;align-items:center;gap:10px;flex:none}
.nav-ctrls .ai-brief-link{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;flex:none;padding:5px 12px;border-radius:999px;background:var(--card);border:1px solid var(--grid);color:var(--text);font-size:12.5px;font-weight:600;line-height:1;text-decoration:none;transition:border-color .15s,color .15s}
.nav-ctrls .ai-brief-link:hover{border-color:var(--blue);color:var(--blue)}
.lang-toggle{display:inline-flex;position:relative;background:#eef1f6;border:1px solid var(--grid);border-radius:999px;padding:3px;cursor:pointer;flex:none}
.lang-toggle .pill{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);border-radius:999px;background:var(--blue);transition:transform .34s cubic-bezier(.34,1.4,.5,1)}
html[data-lang="zh"] .lang-toggle .pill{transform:translateX(100%)}
.lang-toggle .opt{position:relative;z-index:1;min-width:28px;text-align:center;padding:3px 9px;font-size:11.5px;font-weight:600;color:var(--muted);transition:color .25s;user-select:none}
html:not([data-lang="zh"]) .lang-toggle .en-opt{color:#fff}
html[data-lang="zh"] .lang-toggle .zh-opt{color:#fff}
.theme-switch{width:56px;height:27px;border-radius:999px;background:#eef1f6;border:1px solid var(--grid);position:relative;cursor:pointer;padding:0;flex:none}
.theme-switch .ic{position:absolute;top:50%;transform:translateY(-50%);font-size:10.5px;opacity:.5;line-height:1}
.theme-switch .ic.sun{right:8px}.theme-switch .ic.moon{left:8px}
.theme-switch .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 5px rgba(0,0,0,.3);transform:translateX(29px);transition:transform .34s cubic-bezier(.34,1.45,.5,1),background .3s}
.theme-switch .knob::before{content:"☀️"}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280}
html[data-theme="dark"] a.nav-link:hover,html[data-theme="dark"] a.nav-link.active{background:#222732}
html[data-theme="dark"] .nav-dd-menu a:hover,html[data-theme="dark"] .nav-dd-menu a.active{background:#222732}
html[data-theme="dark"] .lang-toggle{background:#222732}
html[data-theme="dark"] .theme-switch{background:#222732}
html[data-theme="dark"] .theme-switch .knob{transform:translateX(0);background:#e8c15a}
html[data-theme="dark"] .theme-switch .knob::before{content:"🌙"}
html[data-theme="dark"] .riskbar{background:repeating-linear-gradient(90deg,#222732,#222732 24px,#2a2f3a 24px,#2a2f3a 25px)}
html[data-theme="dark"] .gtable td.cur{background:#1b2740}
html[data-theme="dark"] .score .s>div{background:var(--grid)}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}
.cols-3{grid-template-columns:repeat(3,1fr)}
.cols-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.cols-2,.cols-3,.cols-4{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h3{margin:0 0 14px;font-size:18px;font-weight:700;color:var(--ink)}
.sub{color:var(--muted);font-size:13px} .faint{color:var(--faint)}
.section-title{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:30px 4px 12px}
.h1{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.tag{display:inline-block;background:#FFF4E0;color:#8a5a00;border-radius:8px;padding:3px 10px;font-size:12.5px;font-weight:700}
.tag.exp{background:#fde7ef;color:#a01457}
html[data-theme="dark"] .tag{background:#3a2f17;color:#e0b25a}
html[data-theme="dark"] .tag.exp{background:#3a1d2b;color:#f08bb4}
.allocbar{height:54px;border-radius:12px;overflow:hidden;display:flex;font-weight:700;color:#fff;margin:12px 0 4px}
.allocbar div{display:flex;align-items:center;justify-content:center;gap:8px;font-size:13.5px;min-width:0}
.seg-spy{background:linear-gradient(90deg,#4a86ff,var(--blue))}
.seg-cash{background:linear-gradient(90deg,#cfd4dc,#9aa4b2)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:6px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:middle}
.dialwrap{display:flex;align-items:center;gap:18px;margin-top:2px}
.dialnum{font-size:54px;font-weight:800;line-height:1;letter-spacing:-.02em}
.pill{display:inline-block;padding:5px 12px;border-radius:9px;font-weight:700;font-size:13px;color:#fff}
.riskbar{height:26px;border-radius:8px;overflow:hidden;display:flex;background:repeating-linear-gradient(90deg,#f0f2f6,#f0f2f6 24px,#e9ecf1 24px,#e9ecf1 25px);border:1px solid var(--grid);margin:8px 0}
.riskbar div{height:100%}
.legtbl{width:100%;border-collapse:collapse;font-size:13px;margin-top:10px}
.legtbl td,.legtbl th{padding:7px 8px;border-bottom:1px solid var(--grid);text-align:right}
.legtbl td.l,.legtbl th.l{text-align:left}
.legtbl .dot{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:7px;vertical-align:middle}
.gtable{width:100%;border-collapse:collapse;font-size:13px;margin-top:6px}
.gtable td,.gtable th{padding:9px 8px;border:1px solid var(--grid);text-align:center}
.gtable th{background:var(--bg);color:var(--muted);font-weight:600;font-size:12px}
.gtable td.rh{text-align:left;font-weight:700;color:var(--ink);background:var(--bg)}
.gtable td.cur{background:#E8EEFF;font-weight:700;color:var(--ink);outline:2px solid var(--blue)}
.score .s{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:4px}
.score .s>div{background:var(--bg);border-radius:10px;padding:12px;text-align:center}
.score .k{font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:600}
.score .v{font-size:21px;font-weight:800;color:var(--ink)}
.score .v small{font-size:12px;font-weight:600;color:var(--muted)}
.win{color:var(--green)} .lose{color:var(--red)}
.tbl{width:100%;border-collapse:collapse;font-size:13.5px}
.tbl td,.tbl th{padding:7px 10px;border-bottom:1px solid var(--grid);text-align:left}
.tbl td.n{text-align:right;font-variant-numeric:tabular-nums}
.note{border-left:3px solid var(--amber);padding:6px 0 6px 14px;margin:8px 0;color:var(--text);font-size:13.5px}
.note.r{border-color:var(--red)} .note.b{border-color:var(--blue)}
.foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--faint);line-height:1.7}
</style>{% include "_vector_polish.html.j2" %}
</head>
<body>
<div class="wrap">
  <div class="topbar">
      {% include "_navlinks.html.j2" %}
    <div class="nav-ctrls">
      <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
      <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
      <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
      <div class="lang-toggle" role="group" aria-label="Language">
        <span class="pill"></span>
        <span class="opt en-opt" data-l="en">EN</span>
        <span class="opt zh-opt" data-l="zh">中文</span>
      </div>
    </div>
  </div>

  <div class="section-title"><a href="{{ back_href|default('strategies.html') }}" style="color:inherit;text-decoration:none">← {{ t(back_label_en|default('Strategies'), back_label_zh|default('策略')) }}</a> · {{ s.icon }} {{ t('Tactical strategy','战术策略') }}</div>
  <div class="h1">{{ t(s.name_en, s.name_zh) }}</div>
  <div class="sub" style="margin-bottom:6px">{{ t(s.thesis_en, s.thesis_zh) }}</div>
  <div class="sub faint" style="margin-bottom:8px">{{ t('As of','截至') }} {{ as_of }} · {{ t(s.bench_en, s.bench_zh) }} · {{ t('current income','当前票息') }} ~{{ income_now }}%</div>
  {% if s.experimental %}<span class="tag exp">⚗ {{ t('Experimental — display-only (Phase-0)','实验性 — 仅展示（Phase-0）') }}</span>{% endif %}
  <span class="tag">{{ t('A drawdown / Sharpe engine — not a yield-maximizer','回撤 / 夏普引擎 — 并非收益最大化工具') }}</span>

  <!-- ===== recommended split + score ===== -->
  <div class="grid cols-2" style="margin-top:14px">
    <div class="card">
      <h3>{{ t('Recommended allocation right now','当前建议仓位') }}</h3>
      <div class="allocbar">
        {% if risk_w %}<div class="seg-spy" style="flex:{{ risk_w }}"><span>{{ t(s.bench_en, s.bench_zh) }}</span><span>{{ risk_w }}%</span></div>{% endif %}
        {% if cash_w %}<div class="seg-cash" style="flex:{{ cash_w }}"><span>{{ t(s.cash_en, s.cash_zh) }}</span><span>{{ cash_w }}%</span></div>{% endif %}
      </div>
      <div class="legend">
        <span><i style="background:var(--blue)"></i>{{ t(s.bench_en, s.bench_zh) }}</span>
        <span><i style="background:#9aa4b2"></i>{{ t(s.cash_en, s.cash_zh) }} ({{ t('cash carry','现金套息') }})</span>
      </div>
      {% if last_switch %}<div class="sub" style="margin-top:12px">{{ t('Last change','上次调整') }}: <b style="color:var(--ink)">{{ last_switch.date }}</b> — {{ last_switch.frm }}% → {{ last_switch.to }}%</div>{% endif %}
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Current income blends the risk-asset yield (when invested) with the cash-leg yield (when de-risked).','当前票息为风险资产收益（在场时）与现金腿收益（降险时）的加权。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t(s.risk_word_en, s.risk_word_zh) }} {{ t('score','评分') }} <span class="faint" style="font-weight:500">(0–100)</span></h3>
      <div class="dialwrap">
        <div class="dialnum" style="color:var(--ink)">{{ score }}</div>
        <div>
          <span class="pill" style="background:{{ band_color }}">{{ t(band_label, band_label_zh) }}</span>
          <div class="sub" style="margin-top:8px">{{ t('Higher = more risk-off. The score sets the risk-asset weight via graded bands (below), with a 5-day debounce to cut whipsaw.','分数越高越偏避险。该分数通过分级区间（见下）设定风险资产权重，并有 5 日缓冲以抑制频繁换仓。') }}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== score leg breakdown ===== -->
  <div class="section-title">{{ t('What is driving the score','分数由什么驱动') }}</div>
  <div class="card">
    <div class="sub" style="margin-bottom:4px">{{ t('Each leg adds points to the 0–100 score (renormalised weighted mean). The bar is the current score, split by contribution.','各分项为 0–100 分数贡献分值（归一化加权平均）。下方进度条为当前分数，按贡献拆分。') }}</div>
    <div class="riskbar">
      {% for lg in legs %}{% if lg.active and lg.points %}<div style="width:{{ lg.points }}%;background:{{ lg.color }}" title="{{ lg.label }}: {{ lg.points }} pts"></div>{% endif %}{% endfor %}
    </div>
    <div class="sub faint" style="font-size:12px">{{ t('Filled width = the score out of 100. Empty = headroom (calm).','填充宽度 = 满分100中的得分。空白 = 余量（平静）。') }}</div>
    <table class="legtbl">
      <tr><th class="l">{{ t('Signal leg','信号分项') }}</th><th>{{ t('Intensity','强度') }}</th><th>{{ t('Weight','权重') }}</th><th>{{ t('Pub lag','发布滞后') }}</th><th>{{ t('Points','贡献分') }}</th></tr>
      {% for lg in legs %}
      <tr>
        <td class="l"><span class="dot" style="background:{{ lg.color }}"></span>{{ t(lg.label, lg.label_zh) }}</td>
        <td>{{ (lg.value|round|int ~ '/100') if lg.value is not none else '—' }}</td>
        <td>{{ '%.1f'|format(lg.weight) }}</td>
        <td>{{ lg.lag }}d</td>
        <td><b>{{ ('%.1f'|format(lg.points)) if lg.points is not none else '—' }}</b></td>
      </tr>
      {% endfor %}
      <tr><td class="l"><b>{{ t('Composite score','综合分数') }}</b></td><td></td><td></td><td></td><td><b>{{ score }}</b></td></tr>
    </table>
  </div>

  <!-- ===== strategy chart ===== -->
  <div class="section-title">{{ t('The strategy in action · benchmark with the model on top','策略实战 · 基准叠加模型') }}</div>
  <div class="card">{{ charts.strategy|safe }}
    <div class="sub" style="margin-top:8px">{{ t('Green = fully invested, amber = trimmed, clear = defensive. ▲/▼ mark every allocation change. The strategy equity (blue) is rescaled onto the benchmark axis so you can read protection vs participation directly.','绿色 = 满仓，琥珀 = 减仓，空白 = 防守。▲/▼ 标注每次仓位变动。策略净值（蓝）已缩放至基准轴，可直接对比保护与参与度。') }}</div>
  </div>

  <!-- ===== growth + drawdown ===== -->
  <div class="grid cols-2">
    <div class="card"><h3>{{ t('Growth of $1 (log) — vs buy & hold','1美元增长（对数）— 对比买入持有') }}</h3>{{ charts.growth|safe }}</div>
    <div class="card"><h3>{{ t('Underwater (drawdown) — vs buy & hold','水下回撤 — 对比买入持有') }}</h3>{{ charts.dd|safe }}</div>
  </div>
  <div class="note b" style="margin-top:14px">{{ t('Honest framing: this does NOT reliably beat buy-and-hold on CAGR — sitting in the cash leg through stress gives up some carry. The edge is the higher Sharpe and the much shallower max drawdown: it times the LEFT TAIL that destroys the yield (the recession/credit/rate shock), not the yield itself.','诚实说明：本策略在年化收益上并不稳定跑赢买入持有 —— 压力期退守现金腿会让出部分套息。优势在于更高的夏普与明显更浅的最大回撤：它择时的是吞噬收益的左尾（衰退/信用/利率冲击），而非收益本身。') }}</div>

  <!-- ===== scorecard tiles ===== -->
  <div class="section-title">{{ t('Backtest scorecard · {y} years vs buy & hold'|replace('{y}', sc.years|string), '回测记分卡 · {y} 年对比买入持有'|replace('{y}', sc.years|string)) }}</div>
  <div class="grid cols-4">
    <div class="card score"><div class="k">CAGR</div><div class="v {{ 'win' if sc.cagr >= sc.hodl_cagr else 'lose' }}">{{ sc.cagr }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_cagr }}%</div></div>
    <div class="card score"><div class="k">Sharpe</div><div class="v {{ 'win' if sc.sharpe >= sc.hodl_sharpe else 'lose' }}">{{ sc.sharpe }}</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_sharpe }}</div></div>
    <div class="card score"><div class="k">{{ t('Max drawdown','最大回撤') }}</div><div class="v {{ 'win' if sc.maxdd >= sc.hodl_maxdd else 'lose' }}">{{ sc.maxdd }}%</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_maxdd }}%</div></div>
    <div class="card score"><div class="k">{{ t('Time invested','在场时间') }}</div><div class="v">{{ sc.time_in_market }}%</div><div class="sub">{{ sc.turnover_annual }}x {{ t('turnover/yr','换手/年') }}</div></div>
  </div>
  <div class="grid cols-3" style="margin-top:18px">
    <div class="card score"><div class="k">Sortino</div><div class="v {{ 'win' if sc.sortino >= sc.hodl_sortino else 'lose' }}">{{ sc.sortino }}</div><div class="sub">{{ t('buy & hold','买入持有') }} {{ sc.hodl_sortino }}</div></div>
    <div class="card score"><div class="k">{{ t('Income yield now','当前票息') }}</div><div class="v">{{ income_now }}%</div><div class="sub">{{ t('blended risk-asset + cash','风险资产 + 现金加权') }}</div></div>
    <div class="card score"><div class="k">{{ t('Deflated Sharpe','贬值夏普') }}</div><div class="v">{% if dsr %}{{ dsr.dsr }}{% else %}—{% endif %}</div><div class="sub">{{ t('multiple-testing haircut','多重检验折减') }}{% if dsr %} · n={{ dsr.n_trials }}{% endif %}</div></div>
  </div>

  <!-- ===== rule-book ===== -->
  <div class="section-title">{{ t('The rule-book · risk band → weight','规则手册 · 风险区间 → 权重') }}</div>
  <div class="card">
    <table class="gtable">
      <tr><th>{{ t('Risk band','风险区间') }}</th><th>{{ t('Score','分数') }}</th><th>{{ t(s.bench_en, s.bench_zh) }} {{ t('weight','权重') }}</th><th>{{ t(s.cash_en, s.cash_zh) }}</th></tr>
      {% for b in bands %}
      <tr><td class="rh {{ 'cur' if b.cur }}">{{ t(b.label, b.label_zh) }}{% if b.cur %} ◀{% endif %}</td>
        <td class="{{ 'cur' if b.cur }}">{{ b.rng }}</td>
        <td class="{{ 'cur' if b.cur }}"><b>{{ b.weight }}%</b></td>
        <td class="{{ 'cur' if b.cur }}">{{ 100 - b.weight }}%</td></tr>
      {% endfor %}
    </table>
    <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('A new band must hold 5 trading days before it takes effect (hysteresis kills whipsaw). Bands and leg weights are pre-registered, not tuned per result.','新区间须连续保持 5 个交易日才生效（滞后机制抑制频繁换仓）。区间与分项权重为预先登记，非按结果调参。') }}</div>
  </div>

  <!-- ===== bear ledger ===== -->
  <div class="section-title">{{ t('Independent bear episodes · the true sample size','独立熊市事件 · 真实样本量') }}</div>
  <div class="card">
    <table class="tbl">
      <tr><th>{{ t('Peak','峰值') }}</th><th>{{ t('Trough','谷底') }}</th><th class="n">{{ t('Buy & hold drawdown','买入持有回撤') }}</th></tr>
      {% for e in episodes %}<tr><td>{{ e.peak }}</td><td>{{ e.trough }}</td><td class="n lose">{{ e.drawdown_pct }}%{% if e.ongoing %} ({{ t('ongoing','进行中') }}){% endif %}</td></tr>{% endfor %}
      {% if not episodes %}<tr><td colspan="3" class="sub">{{ t('No independent ≥20% bear in the available history.','可用历史中无独立的 ≥20% 熊市。') }}</td></tr>{% endif %}
    </table>
    <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('A handful of independent ≥20% bears govern a get-out / get-back-in switch — effective-N, not the day count, bounds confidence. Full leave-one-crisis-out validation is a fast-follow.','少数几次独立的 ≥20% 熊市决定一次离场/再入场切换 — 决定置信度的是有效样本量，而非天数。完整的留一危机验证为后续跟进。') }}</div>
  </div>

  {% if s.caveat_en %}<div class="note r">{{ t(s.caveat_en, s.caveat_zh) }}</div>{% endif %}

  <div class="foot">
    {{ t('Built', '生成于') }} {{ built }}<br>
    <span class="made">© 2026 Mastermind Inc</span>
  </div>
</div>
<script src="theme.js"></script>
</body></html>
