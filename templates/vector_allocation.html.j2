{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
{# "?" affordance: hover/focus reveals a plain-language note. Native title can't
   switch on data-lang, so it carries both languages "EN · ZH" (.qm CSS in _vector_polish). #}
{% macro qmark(en, zh='') -%}
<span class="qm" tabindex="0" role="note" data-tip-en="{{ en }}"{% if zh %} data-tip-zh="{{ zh }}"{% endif %}>?</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% include "_interfonts.html.j2" %}
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);else document.documentElement.setAttribute('data-theme','dark');var l=localStorage.getItem('lang')||(function(){try{var L=navigator.languages||[navigator.language||navigator.userLanguage||''],i;for(i=0;i<L.length;i++)if((L[i]||'').toLowerCase().slice(0,2)==='zh')return'zh';if(/Shanghai|Hong_Kong|Macau|Urumqi|Chongqing|Harbin|Kashgar|Chungking/.test(Intl.DateTimeFormat().resolvedOptions().timeZone||''))return'zh';}catch(e){}return'';})();if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Bitcoin Vector — Allocation Strategy</title>
{% set seo_title = "Bitcoin Vector Allocation — Mastermind" %}{% set seo_desc = "How Bitcoin Vector sizes exposure — the current allocation call and the regime evidence behind it." %}{% set seo_path = "vector_allocation.html" %}
{% include "_seo_head.html.j2" %}
{% include '_plotly_head.html.j2' %}
<style>
:root{
  --blue:{{C.blue}}; --indigo:{{C.indigo}}; --r2:{{C.r2}}; --r3:{{C.bear}}; --ink:{{C.ink}};
  --text:{{C.text}}; --muted:{{C.muted}}; --faint:{{C.faint}}; --red:{{C.red}}; --amber:{{C.amber}};
  --grid:{{C.grid}}; --card:{{C.card}}; --bg:{{C.bg}};
  --bull:var(--blue); --bull-soft:{{C.bull_soft}}; --bear:{{C.bear}}; --bear-soft:{{C.bear_soft}};
  --warn:{{C.warn}}; --neutral:var(--muted);
}
*{box-sizing:border-box}
html:not([data-lang="zh"]) .l-zh{display:none}
html[data-lang="zh"] .l-en{display:none}
html[data-lang="zh"] body{font-family:"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",Inter,sans-serif}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px 60px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 0 14px;border-bottom:1px solid var(--grid);margin-bottom:24px;position:sticky;top:0;background:var(--bg);z-index:20}
.nav-links{display:flex;align-items:center;gap:2px;flex-wrap:wrap}
a.nav-link{padding:7px 11px;border-radius:9px;font-size:13.5px;font-weight:500;color:var(--muted);text-decoration:none;white-space:nowrap;transition:color .18s,background .18s}
a.nav-link:hover,a.nav-link.active{color:var(--ink);background:#eef1f6}
html[data-theme="dark"] a.nav-link:hover,html[data-theme="dark"] a.nav-link.active{background:#222732}
.nav-dd{position:relative;display:inline-flex}
.nav-dd>a.nav-link .caret{display:inline-block;margin-left:3px;font-size:9px;opacity:.6;transition:transform .2s}
.nav-dd:hover>a.nav-link .caret,.nav-dd:focus-within>a.nav-link .caret{transform:rotate(180deg)}
.nav-dd::after{content:"";position:absolute;left:0;right:0;top:100%;height:9px}
.nav-dd-menu{position:absolute;top:calc(100% + 7px);left:0;min-width:218px;background:var(--card);border:1px solid var(--grid);border-radius:13px;box-shadow:0 12px 34px rgba(16,24,40,.14);padding:6px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s;z-index:70}
.nav-dd:hover>.nav-dd-menu,.nav-dd:focus-within>.nav-dd-menu{opacity:1;visibility:visible;transform:translateY(0)}
.nav-dd-menu a{display:block;padding:9px 12px;border-radius:9px;font-size:13.5px;font-weight:600;color:var(--text);text-decoration:none;white-space:nowrap;transition:background .15s,color .15s}
.nav-dd-menu a .d{display:block;font-size:11.5px;font-weight:400;color:var(--muted);margin-top:2px}
.nav-dd-menu a:hover,.nav-dd-menu a.active{background:#eef1f6;color:var(--ink)}
html[data-theme="dark"] .nav-dd-menu a:hover,html[data-theme="dark"] .nav-dd-menu a.active{background:#222732}
.lang-toggle{display:inline-flex;position:relative;background:#eef1f6;border:1px solid var(--grid);border-radius:999px;padding:3px;cursor:pointer;flex:none}
.lang-toggle .pill{position:absolute;top:3px;left:3px;width:calc(50% - 3px);height:calc(100% - 6px);border-radius:999px;background:var(--blue);transition:transform .34s cubic-bezier(.34,1.4,.5,1)}
html[data-lang="zh"] .lang-toggle .pill{transform:translateX(100%)}
.lang-toggle .opt{position:relative;z-index:1;min-width:28px;text-align:center;padding:3px 9px;font-size:11.5px;font-weight:600;color:var(--muted);transition:color .25s;user-select:none}
html:not([data-lang="zh"]) .lang-toggle .en-opt{color:#fff}
html[data-lang="zh"] .lang-toggle .zh-opt{color:#fff}
.nav-ctrls{display:flex;align-items:center;gap:10px;flex:none}
html[data-theme="dark"]{--bg:#0f1115;--card:#181b21;--grid:#2a2f3a;--ink:#e8edf4;--text:#d7dce3;--muted:#8b93a1;--faint:#6b7280;--red:#e06464;--r3:{{C.bear_dk}};--bear:{{C.bear_dk}};--bear-soft:#3a1c1c;--bull-soft:#14233f}
.theme-switch{width:56px;height:27px;border-radius:999px;background:#eef1f6;border:1px solid var(--grid);position:relative;cursor:pointer;padding:0;flex:none}
html[data-theme="dark"] .theme-switch{background:#222732}
.theme-switch .ic{position:absolute;top:50%;transform:translateY(-50%);font-size:10.5px;opacity:.5;line-height:1}
.theme-switch .ic.sun{right:8px}.theme-switch .ic.moon{left:8px}
.theme-switch .knob{position:absolute;top:2px;left:2px;width:22px;height:22px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;font-size:11px;box-shadow:0 2px 5px rgba(0,0,0,.3);transform:translateX(29px);transition:transform .34s cubic-bezier(.34,1.45,.5,1),background .3s}
html[data-theme="dark"] .theme-switch .knob{transform:translateX(0);background:#6888fb}
.grid{display:grid;gap:18px}
.cols-2{grid-template-columns:1.05fr .95fr}
.cols-4{grid-template-columns:repeat(4,1fr)}
@media(max-width:900px){.cols-2,.cols-4{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--grid);border-radius:16px;padding:22px}
.card h3{margin:0 0 14px;font-size:18px;font-weight:700;color:var(--ink)}
.sub{color:var(--muted);font-size:13px} .faint{color:var(--faint)}
.section-title{font-size:13px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:30px 4px 12px}
.h1{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em;margin:6px 0 2px}
.allocbar{height:52px;border-radius:12px;overflow:hidden;display:flex;font-weight:700;color:#fff;margin:10px 0 4px}
.allocbar div{display:flex;align-items:center;justify-content:center;font-size:13px;min-width:0}
.seg-btc{background:linear-gradient(90deg,#6888fb,var(--blue))}
.seg-eth{background:linear-gradient(90deg,#7d72e0,var(--indigo))}
.seg-alts{background:linear-gradient(90deg,#f5c97a,var(--amber))}
.seg-cash{background:linear-gradient(90deg,#cfd4dc,#9aa4b2)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:6px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:middle}
.mini{margin-top:4px}
.mini .lab{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);padding:5px 0;border-top:1px solid var(--grid)}
.mini .lab b{color:var(--ink)}
.gtable{width:100%;border-collapse:collapse;font-size:13px;margin-top:6px}
.gtable td,.gtable th{padding:9px 8px;border:1px solid var(--grid);text-align:center}
.gtable th{background:var(--bg);color:var(--muted);font-weight:600;font-size:12px}
.gtable td.rh{text-align:left;font-weight:700;color:var(--ink);background:var(--bg)}
.gtable td.cur{background:#E8EEFF;font-weight:700;color:var(--ink);outline:2px solid var(--blue)}
.gauge{height:10px;border-radius:6px;background:linear-gradient(90deg,#6888fb 0%,#cfd4dc 50%,var(--amber) 100%);position:relative;margin:10px 0 4px}
.gauge .pin{position:absolute;top:-4px;width:4px;height:18px;border-radius:2px;background:var(--ink);transform:translateX(-50%)}
.score .s{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.score .s>div{background:var(--bg);border-radius:10px;padding:11px;text-align:center}
.score .k{font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:600}
.score .v{font-size:19px;font-weight:800;color:var(--ink)}
.chip{display:inline-block;padding:4px 11px;border-radius:9px;font-weight:700;font-size:13px}
.foot{margin-top:34px;padding-top:18px;border-top:1px solid var(--grid);font-size:12px;color:var(--faint);line-height:1.7}
/* allocation-desk decision hero */
.reco-k{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.deck.t-bull{background:linear-gradient(120% 140% at 0 0,var(--bull-soft),var(--card) 60%)}
.deck.t-bear{background:linear-gradient(120% 140% at 0 0,var(--bear-soft),var(--card) 60%)}
.deck-act{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1.08;margin:6px 0 8px}
.deck-act.t-bull{color:var(--bull)} .deck-act.t-bear{color:var(--bear)} .deck-act.t-neutral{color:var(--ink)}
.deck-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12.5px;color:var(--muted)}
.deck-conv{font-size:11px;font-weight:800;padding:2px 9px;border-radius:7px;letter-spacing:.03em}
.conv-high{background:var(--bull);color:#fff} .conv-high.bear{background:var(--bear)} .conv-moderate{background:var(--warn);color:#fff} .conv-low{background:var(--grid);color:var(--muted)}
.exp-band{font-size:24px;font-weight:800;color:var(--ink);margin:8px 0 6px}
.exp-track{position:relative;height:12px;border-radius:7px;background:var(--grid)}
.exp-fill{position:absolute;top:0;bottom:0;border-radius:7px;background:color-mix(in srgb,var(--bull) 55%,var(--grid))}
.exp-fill.t-bear{background:color-mix(in srgb,var(--bear) 50%,var(--grid))}
.exp-kelly{position:absolute;top:-3px;bottom:-3px;width:3px;margin-left:-1.5px;background:var(--ink);border-radius:2px}
.exp-scale{display:flex;justify-content:space-between;font-size:10px;color:var(--faint);margin-top:4px}
.deck-risk{font-size:12.5px;color:var(--bear);background:var(--bear-soft);border-radius:9px;padding:8px 11px;margin-top:12px;line-height:1.45}
.rchip{font-size:11.5px;font-weight:600;padding:3px 9px;border-radius:8px;background:var(--bg);border:1px solid var(--grid);color:var(--text)}
html[data-theme="dark"] .rchip{background:var(--grid)}
.rchip i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;vertical-align:middle}
.rchip i.bull{background:var(--bull)} .rchip i.bear{background:var(--bear)} .rchip i.neutral{background:var(--muted)}
.kx{display:flex;justify-content:space-between;font-size:13px;padding:6px 0;border-top:1px solid var(--grid)} .kx b{color:var(--ink)}
@media(max-width:700px){
  .topbar{flex-wrap:wrap;row-gap:10px;padding:14px 0 12px}
}
</style>{% include "_vector_polish.html.j2" %}
</head>
<body>
<div class="topbar">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;padding-top:0;padding-bottom:0;border:none;margin:0 auto">
  {% include "_navlinks.html.j2" %}
    <div class="nav-ctrls">
      <a class="ai-brief-link" href="https://bot.mastermind-x.com" target="_blank" rel="noopener">🤖 {{ t('Mastermind', '操盘大脑') }}</a>
      <a class="ai-brief-link terminal-link" href="https://app.mastermind-x.com" target="_blank" rel="noopener">🖥️ {{ t('Terminal', '终端') }}</a>
      <button class="theme-switch" aria-label="Toggle dark / light mode"><span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span></button>
      <div class="lang-toggle" role="group" aria-label="Language">
        <span class="pill"></span>
        <span class="opt en-opt" data-l="en">EN</span>
        <span class="opt zh-opt" data-l="zh">中文</span>
      </div>
    </div>
  </div>
</div>
<div class="wrap">

  <div class="section-title">{{ t('Allocation Strategy · in depth','仓位策略 · 深度') }}</div>
  <div class="h1">{{ t('How much Bitcoin — and Ethereum — to hold right now','当前应配置多少比特币 — 以及以太坊') }}</div>
  <div class="sub" style="margin-bottom:18px">{{ t('As of','截至') }} {{ as_of }} · BTC {{ '$%s'|format('{:,.0f}'.format(price)) }}</div>

  {% if gate.active %}
  <div style="margin:0 0 18px;padding:13px 15px;border:1px solid var(--warn);border-radius:12px;background:color-mix(in srgb, var(--warn) 10%, transparent)">
    <div style="font-weight:700;font-size:14px;color:var(--warn)">⏳ {{ t('Proprietary cycle timer · holding cash','专有周期计时器 · 持有现金') }}</div>
    <div class="sub" style="margin-top:5px;font-size:13px">{{ t('Our cycle timing flags this as a stay-out window for BTC, so the strategy is overridden to 0% (100% cash) and the tactical recommendation below is paused. It re-engages around','我们的周期择时判定当前为 BTC 的回避窗口，因此策略被覆盖为 0%（100% 现金），下方战术建议暂停。将在以下时间前后重新参与') }} <b>{{ gate.release or '—' }}</b>.</div>
  </div>
  {% endif %}

  <!-- ===== ALLOCATION DESK · the decision (shared with the Vector command center) ===== -->
  {# Fix #34 + W3: rec.suppressed_by_blackout (stamped in build_vector.py from the ONE
     gate_state() object) is the authoritative guard — same flag as vector.html.j2, no
     hand-copied window re-derivation, so the two pages cannot drift. #}
  {% if rec and rec.ok and not rec.suppressed_by_blackout %}
  {% set rt = rec.tone %}{% set L = rec.levels %}
  <div class="grid cols-2">
    <div class="card deck t-{{ rt }}">
      <div class="reco-k">▶ {{ t('Recommendation · strategic','建议 · 战略') }}{% if master and master.ok %} · {{ t('Master Signal','主信号') }} {{ '%+d'|format(master.score) }} ({{ t(master.band, master.band_zh) }}){% endif %}</div>
      <div class="deck-act t-{{ rt }}">{{ t(rec.action, rec.action_zh) }}</div>
      <div class="deck-meta">
        <span class="deck-conv {{ rt }} conv-{{ rec.conviction|lower }}">{{ t(rec.conviction ~ ' conviction', rec.conviction ~ ' 信心') }}</span>
        <span>· {{ t(rec.basis_en, rec.basis_zh) }}</span>
      </div>
      <div class="exp-band">{{ t('Target BTC exposure','目标 BTC 仓位') }} {{ rec.exposure_lo }}–{{ rec.exposure_hi }}%</div>
      <div class="exp-track">
        <div class="exp-fill {{ 't-bear' if rt=='bear' else '' }}" style="left:{{ rec.exposure_lo }}%;width:{{ rec.exposure_hi - rec.exposure_lo }}%"></div>
        {% if rec.kelly_pct is not none %}<div class="exp-kelly" style="left:{{ rec.kelly_pct }}%"></div>{% endif %}
      </div>
      <div class="exp-scale"><span>0% {{ t('cash','现金') }}</span><span>{{ t('Kelly','Kelly') }} {{ rec.kelly_pct }}%</span><span>100% {{ t('BTC','BTC') }}</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:12px">
        {% for d in rec.rationale %}<span class="rchip"><i class="{{ d.tone }}"></i>{{ t(d.label_en, d.label_zh) }} · {{ t(d.state_en, d.state_zh) }}</span>{% endfor %}
      </div>
      {% if rec.key_risk_en %}<div class="deck-risk">⚠ {{ t(rec.key_risk_en, rec.key_risk_zh) }}</div>{% endif %}
    </div>
    <div class="card">
      <h3>{{ t('How much — risk-budgeted Kelly','配置多少 — 风险预算 Kelly') }}{{ qmark('Half-Kelly on the calibrated 90-day regime edge, capped so the worst-case 90-day dip stays inside the drawdown budget. Direction is a coin-flip, so this sizes the regime, not the week.','基于已校准的 90 天格局优势的半 Kelly，并设上限使极端 90 天回撤不超过回撤预算。方向接近抛硬币，故仓位针对格局而非本周。') }}</h3>
      {% if sizing %}
      <div style="font-size:30px;font-weight:800;color:{{ 'var(--bull)' if sizing.size_pct>=40 else 'var(--bear)' }}">{{ sizing.size_pct }}%<span class="sub" style="font-size:13px;font-weight:600"> {{ t('of the BTC sleeve','BTC 仓位') }}</span></div>
      <div class="kx"><span>{{ t('Regime edge (90d)','格局优势（90天）') }}</span><b style="color:{{ 'var(--bull)' if sizing.edge_90>=0 else 'var(--bear)' }}">{{ '%+0.0f'|format(sizing.edge_90) }}%</b></div>
      <div class="kx"><span>{{ t('Volatility (90d σ)','波动率（90天 σ）') }}</span><b>{{ sizing.vol_90 }}%</b></div>
      <div class="kx"><span>{{ t('Worst-case 90d dip (p05)','极端 90 天回撤（p05）') }}</span><b style="color:var(--bear)">{{ sizing.tail_90 }}%</b></div>
      <div class="kx"><span>{{ t('Binding constraint','约束因素') }}</span><b>{{ t('drawdown cap','回撤上限') if sizing.binding=='tail' else t('regime edge','格局优势') }}</b></div>
      {% else %}<div class="sub faint">{{ t('Sizing unavailable (insufficient regime history).','无法定仓（格局历史不足）。') }}</div>{% endif %}
      {% if catalyst and catalyst.imminent %}<div class="deck-risk" style="color:var(--warn);background:color-mix(in srgb,var(--warn) 14%,var(--card))">⚠ {{ t('Next macro binary:','下一宏观二元事件：') }} <b>{{ td(catalyst.next_event) }}</b> {{ t('in','还有') }} {{ catalyst.days }} {{ t('days','天') }} — {{ t('don\'t size up into it.','勿在此前加仓。') }}</div>{% endif %}
    </div>
  </div>

  {# forward cones strip — what BTC did next, on days like today #}
  {% if cones and cones.ok and cones.horizons %}
  {% macro sgncol(v) %}{{ 'var(--bull)' if (v is not none and v > 0) else ('var(--bear)' if (v is not none and v < 0) else 'var(--muted)') }}{% endmacro %}
  <div class="card" style="margin-top:18px">
    <h3 style="margin-bottom:4px">{{ t('What BTC did next · on days like today','类似今日的历史日 · BTC 后续走势') }} <span class="faint" style="font-size:12px;font-weight:600">{{ cones.regime or t('all history','全历史') }}</span></h3>
    <div class="sub faint" style="margin:0 0 10px;font-size:12px">{{ t('The real spread of BTC returns over the next 7 / 30 / 90 days, taken from past days in the same regime as today — median = the typical outcome, p25→p75 = the middle 50%. History, not a forecast.','取历史上与今日格局相同的交易日，BTC 在随后 7 / 30 / 90 天的真实收益分布 —— 中位数 = 典型结果，p25→p75 = 中间 50%。是历史，不是预测。') }}</div>
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <tr style="color:var(--muted);font-size:11px;text-transform:uppercase"><td style="padding:5px 4px">{{ t('Horizon','周期') }}</td><td style="text-align:right">p25</td><td style="text-align:right">{{ t('median','中位') }}</td><td style="text-align:right">p75</td><td style="text-align:right">{{ t('odds ↑','上涨概率') }}</td><td style="text-align:right">{{ t('avg dip','常见回撤') }}</td></tr>
      {% for k in ['7d','30d','90d'] %}{% set h = cones.horizons.get(k) %}{% if h and h.p50 is not none %}
      {% set edge = ((h.p_up - h.base_up) * 100) if (h.p_up is not none and h.base_up is not none) else 0 %}
      {% set oddscol = 'var(--muted)' if (h.thin or edge|abs < 5) else ('var(--bull)' if edge >= 5 else 'var(--bear)') %}
      <tr style="border-top:1px solid var(--grid){% if h.thin %};opacity:.6{% endif %}">
        <td style="padding:7px 4px;font-weight:700;color:var(--ink)">{{ k }}{% if h.thin %} <span class="faint" style="font-weight:400">{{ t('thin','样本少') }}</span>{% endif %}</td>
        <td style="text-align:right;color:{{ sgncol(h.p25) }}">{{ '%+0.0f'|format(h.p25) }}%</td>
        <td style="text-align:right;color:{{ sgncol(h.p50) }};font-weight:700">{{ '%+0.0f'|format(h.p50) }}%</td>
        <td style="text-align:right;color:{{ sgncol(h.p75) }}">{{ '%+0.0f'|format(h.p75) }}%</td>
        <td style="text-align:right"><b style="color:{{ oddscol }}">{{ (h.p_up*100)|round|int }}%</b> <span class="faint">{{ t('vs','对比') }} {{ (h.base_up*100)|round|int }}%</span></td>
        <td style="text-align:right;color:var(--bear)">{{ h.dd_avg }}%</td>
      </tr>{% endif %}{% endfor %}
    </table>
    <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Empirical, with zero fitted weights. p25/p75 are colored by their own sign; “odds ↑” is the up-rate vs. the all-history base rate, and only tints when it beats base by more than ±5 points — otherwise direction is a coin-flip and only the size of the move (and the avg dip) matters.','实证，无拟合权重。p25/p75 按自身符号着色；“上涨概率”为相对全历史基准的上涨频率，仅当超出基准 ±5 个百分点以上才着色 —— 否则方向接近抛硬币，只看波动幅度（及常见回撤）。') }}</div>
  </div>
  {% endif %}
  {% endif %}

  <!-- ===== recommended split ===== -->
  <div class="grid cols-2">
    <div class="card">
      {% set rmap = {'bull':'var(--blue)','bear':'var(--r3)','neutral':'var(--muted)'} %}
      <h3>{{ t('Recommended split','建议配置') }}
        <b style="color:{{ rmap.get(grid.regime_key,'var(--muted)') }}"> · {{ td((regime or 'neutral')|capitalize) }} {{ t('regime','格局') }} × {{ td(alt.bucket or 'Mixed') }}</b></h3>
      <div class="allocbar">
        {% if grid.btc %}<div class="seg-btc" style="flex:{{ grid.btc }}">BTC {{ grid.btc }}%</div>{% endif %}
        {% if grid.eth %}<div class="seg-eth" style="flex:{{ grid.eth }}">ETH {{ grid.eth }}%</div>{% endif %}
        {% if grid.alts %}<div class="seg-alts" style="flex:{{ grid.alts }}">{{ t('Alts','山寨') }} {{ grid.alts }}%</div>{% endif %}
        {% if grid.cash %}<div class="seg-cash" style="flex:{{ grid.cash }}">{{ t('Cash','现金') }} {{ grid.cash }}%</div>{% endif %}
      </div>
      <div class="legend">
        <span><i style="background:var(--blue)"></i>Bitcoin</span><span><i style="background:var(--indigo)"></i>Ethereum</span>
        <span><i style="background:var(--amber)"></i>{{ t('Altcoins','山寨币') }}</span><span><i style="background:#9aa4b2"></i>{{ t('Cash / stables','现金 / 稳定币') }}</span>
      </div>
      {% if verdict and verdict.sub %}<div class="sub" style="margin-top:14px;color:var(--ink)">{{ t(verdict.sub, verdict.sub_zh) }}</div>{% endif %}
      <div class="sub" style="margin-top:12px;font-size:12.5px">{{ t('Total crypto exposure here = the tactical allocation','此处的加密总仓位 = 战术仓位') }} <b>{{ alloc_pct }}%</b> {{ t('from the headline Optimal Strategy — this grid just splits that budget across BTC / ETH / alts. When the risk gate is shut','（来自首页”最优策略”）— 本矩阵只是把该预算在 BTC / ETH / 山寨间分配。风险闸门关闭时') }} ({{ alloc_pct }}%){{ t(', this page is','，本页也为') }} <b>{{ 100 - alloc_pct }}% {{ t('cash too','现金') }}</b>{{ t(', matching the main dashboard.','，与主看板一致。') }}</div>
      <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Strategic grid cell for this regime × alt-season','该格局 × 山寨季的战略矩阵单元') }}: <b>BTC {{ grid_full.btc }} · ETH {{ grid_full.eth }} · {{ t('Alts','山寨') }} {{ grid_full.alts }} · {{ t('Cash','现金') }} {{ grid_full.cash }}</b> — {{ t('the split once the gate opens. In a bear / counter-trend regime, cash dominates no matter the alt-season (“nimble trades only, not an investment buy”). A regime overlay, not a precise entry timer.', '即闸门开启后的分配比例。在熊市／逆势格局下，无论山寨季如何都以现金为主（”仅适合灵活短线，并非投资买入”）。这是格局叠加，而非精确入场计时。') }}</div>
    </div>
    <div class="card">
      <h3>{{ t('Where are we in the alt cycle?','处于山寨周期何处？') }}</h3>
      {% set sb = {'BTC season':'var(--blue)','Alt season':'var(--amber)','Mixed':'var(--muted)'} %}
      <div style="display:flex;align-items:baseline;gap:10px">
        <span class="chip" style="background:{{ sb.get(alt.bucket,'var(--bg)') }};color:#fff">{{ td(alt.bucket or '—') }}</span>
        {% if alt.score is not none %}<span class="faint">{{ t('Alt-season score','山寨季评分') }} {{ alt.score|int }}/100</span>{% endif %}
      </div>
      {% if alt.score is not none %}<div class="gauge"><div class="pin" style="left:{{ alt.score }}%"></div></div>
      <div class="legend"><span>{{ t('BTC season','BTC 季') }} (&lt;25)</span><span style="margin-left:auto">{{ t('Alt season','山寨季') }} (&gt;75)</span></div>{% endif %}
      <div class="mini">
        <div class="lab"><span>{{ t('ETH/BTC ratio','ETH/BTC 比率') }}</span><span><b>{{ alt.ethbtc if alt.ethbtc is not none else '—' }}</b>{% if alt.ethbtc_pctile is not none %} <span class="faint">({{ alt.ethbtc_pctile|int }}%ile)</span>{% endif %}</span></div>
        <div class="lab"><span>{{ t('ETH/BTC 8-week trend','ETH/BTC 8 周趋势') }}</span><span><b style="color:{{ 'var(--blue)' if alt.slope and alt.slope>=0 else 'var(--r3)' }}">{{ ('%+0.1f%%'|format(alt.slope)) if alt.slope is not none else '—' }}</b> · {{ t('above 50w MA','高于 50 周均线') if alt.above_ma else t('below 50w MA','低于 50 周均线') }}</span></div>
        <div class="lab"><span>{{ t('BTC dominance','BTC 占比') }}</span><span><b>{{ ('%.1f%%'|format(alt.dom)) if alt.dom is not none else '—' }}</b>{% if alt.ethdom is not none %} <span class="faint">· ETH {{ '%.1f%%'|format(alt.ethdom) }}</span>{% endif %}</span></div>
      </div>
      <div class="sub faint" style="margin-top:10px;font-size:12px">{{ t('ETH/BTC is the longest-history, testable alt proxy (2017→): 0.07 = alt-season confirmed, below 0.05 = deep BTC-season. ETH leads the alts, so it gets weight before pure alts do. Dominance and score are current context (CoinGecko snapshot).', 'ETH/BTC 是历史最久、可检验的山寨代理（2017 起）：0.07 = 确认山寨季，低于 0.05 = 深度 BTC 季。ETH 领先山寨，故先于纯山寨获得配置。占比与评分为当前背景（CoinGecko 快照）。') }}</div>
    </div>
  </div>

  <!-- ===== ETH/BTC chart ===== -->
  <div class="section-title">{{ t('ETH/BTC ratio · the alt-cycle clock','ETH/BTC 比率 · 山寨周期时钟') }}</div>
  <div class="card">{{ chart_ethbtc|safe }}
    <div class="sub" style="margin-top:8px">{{ t('A multi-year base below 0.05 turning up off the 50-week average is the early alt-season bell; a break above 0.07 confirms it. We’re well below 0.05 and still falling — no alt-season in sight.', '在 0.05 下方多年筑底并自 50 周均线上翻，是山寨季的早期信号；突破 0.07 则确认。当前远低于 0.05 且仍在下行 — 暂无山寨季迹象。') }}</div>
  </div>

  <!-- ===== the full grid ===== -->
  <div class="section-title">{{ t('Allocation grid · cycle regime × alt-season','配置矩阵 · 周期格局 × 山寨季') }}</div>
  <div class="card">
    <table class="gtable">
      <tr><th></th><th>{{ t('BTC season','BTC 季') }}</th><th>{{ t('Mixed','混合') }}</th><th>{{ t('Alt season','山寨季') }}</th></tr>
      {% set rows = [('bull','Bull / risk-on','牛市 / 风险偏好'),('neutral','Neutral','中性'),('bear','Bear / counter-trend','熊市 / 逆势')] %}
      {% set g = {'bull':{'btc':'70·20·0·10','mixed':'50·30·15·5','alt':'30·30·35·5'},'neutral':{'btc':'55·15·0·30','mixed':'45·20·5·30','alt':'35·25·20·20'},'bear':{'btc':'25·5·0·70','mixed':'25·10·0·65','alt':'30·15·5·50'}} %}
      {% for rk, rl, rzh in rows %}
      <tr><td class="rh">{{ t(rl, rzh) }}</td>
        {% for sk in ['btc','mixed','alt'] %}<td class="{{ 'cur' if (rk==grid.regime_key and sk==grid.season_key) else '' }}">{{ g[rk][sk] }}</td>{% endfor %}
      </tr>{% endfor %}
    </table>
    <div class="sub faint" style="margin-top:8px;font-size:12px">{{ t('Cells are BTC·ETH·Alts·Cash %. Highlighted = current. Rules: alts only in alt-season and not a bear; ETH leads alts; cash dominates a bear regardless of season. The grid is judgment (labelled context), not a backtested optimum.', '单元格为 BTC·ETH·山寨·现金 %。高亮 = 当前。规则：仅在山寨季且非熊市时配置山寨；ETH 领先山寨；熊市无论季节均以现金为主。该矩阵为判断（背景），而非回测最优。') }}</div>
  </div>

  <!-- ===== BTC strategy variants + backtests ===== -->
  <div class="section-title">{{ t('Bitcoin allocation variants · backtested vs HODL','比特币仓位变体 · 相对 HODL 回测') }}</div>
  <div class="grid cols-4">
    {% set vzh = {'conservative':'保守','moderate':'稳健','aggressive':'进取','optimal':'最优'} %}
    {% for v in ['conservative','moderate','aggressive','optimal'] %}{% set c = cards[v] %}
    <div class="card">
      <h3 style="margin-bottom:8px">{{ t(v|capitalize, vzh[v]) }}</h3>
      <div class="score"><div class="s">
        <div><div class="k">CAGR</div><div class="v">{{ c.cagr }}%</div></div>
        <div><div class="k">Sharpe</div><div class="v">{{ c.sharpe }}</div></div>
        <div><div class="k">MaxDD</div><div class="v">{{ c.maxdd }}%</div></div>
        <div><div class="k">{{ t('In mkt','在场') }}</div><div class="v">{{ c.in_market }}%</div></div>
      </div></div>
    </div>{% endfor %}
  </div>
  <div class="card" style="margin-top:18px">
    <div class="sub">{{ t('All four BTC variants come from a (momentum × risk-index) grid plus a tested valuation overlay: MVRV-Z below 0 sets a floor (buy the bottom), Mayer above 2.4 / Reserve-Risk above 0.02 caps it (trim the top). Every variant beat buy-and-hold on both Sharpe and drawdown since 2015 (HODL’s max drawdown was −84%). Conservative gives up return for the smallest drawdown; Optimal is the best overall risk/reward. The macro overlay (net liquidity, global M2) was tested and deliberately left out of the sizing — it’s strategic context, not a timer.', '四个比特币变体均来自（动量 × 风险指数）矩阵，并叠加经检验的估值层：MVRV-Z 低于 0 设下限（买入底部），Mayer 高于 2.4 / 储备风险高于 0.02 设上限（顶部减仓）。2015 年以来每个变体在夏普与回撤上均优于买入持有（HODL 最大回撤 −84%）。保守型以收益换取最小回撤；最优型为整体最佳风险收益。宏观叠加（净流动性、全球 M2）经检验后被刻意排除在仓位之外 — 它是战略背景，而非计时器。') }}</div>
  </div>

  <div class="foot">
    {{ t('Built', '生成于') }} {{ built }}<br>
    <span class="made">© 2026 Mastermind Inc</span>
  </div>
</div>
<script>
document.querySelector('.lang-btn')?.addEventListener('click',function(){
  var h=document.documentElement, z=h.getAttribute('data-lang')==='zh';
  h.setAttribute('data-lang', z?'en':'zh'); try{localStorage.setItem('lang', z?'en':'zh');}catch(e){}
});
</script>
<script src="theme.js"></script>
</body></html>
