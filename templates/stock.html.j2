<script src="stockbrief.js"></script>
<script>
(function () {
  var cal = null;  // calibration table data (the nav search bar drives navigation now)
  var bcCal = null;  // bottom-confidence per-band held-rate calibration
  // language-aware micro-strings for the JS-rendered scaffolding (the deep
  // per-stock analysis prose comes from the nightly JSON and stays English)
  function lang() { return document.documentElement.getAttribute('data-lang') || 'en'; }
  var T = {
    en: { asof: 'data through', notlib: 'NOT IN LIBRARY',
          notlibmsg: 'Not in the nightly library (S&P 500 + tracked ETFs/commodities/crypto). Add it in one line: config.yml → stock_search.extra_tickers.',
          season: 'Seasonality', failed: '⚠ Failed cycle — price is below the low that started this cycle; the larger trend is usually rolling over.',
          next: 'Next:', cu: ' just crossed up', cd: ' just crossed down',
          bullx: ' bars to bull cross', bearx: ' bars to bear cross',
          ph: 'Search any S&P 500 stock, ETF, commodity or crypto… (e.g. AAPL, Energy, Bitcoin)',
          th_state: 'state', th_n: 'samples', th_up: 'up next month', th_avg: 'avg next month',
          th_dipm: 'typical dip', th_dipb: 'bad-case dip' },
    zh: { asof: '数据截至', notlib: '不在库中',
          notlibmsg: '不在每晚更新的标的库中（标普500 ＋ 跟踪的 ETF／大宗商品／加密货币）。一行即可添加：config.yml → stock_search.extra_tickers。',
          season: '季节性', failed: '⚠ 失败周期 — 价格已跌破启动本周期的低点；此时更大的趋势通常正在转向下行。',
          next: '下一步：', cu: ' 刚上穿', cd: ' 刚下穿',
          bullx: ' 根K线后金叉', bearx: ' 根K线后死叉',
          ph: '搜索任意标普500股票、ETF、大宗商品或加密货币…（例如 AAPL、Energy、Bitcoin）',
          th_state: '状态', th_n: '样本数', th_up: '下月上涨', th_avg: '下月均值',
          th_dipm: '典型回撤', th_dipb: '最坏回撤' } };
  function L(k) { return (T[lang()] || T.en)[k]; }
  // pick the Chinese variant of a composed analysis string when in zh mode
  // (the per-stock JSON carries parallel *_zh fields from engine/cycles.py)
  function lz(en, zh) { return lang() === 'zh' && zh ? zh : (en || ''); }

  // ===== fundamentals suite (Phase 1) — render panels baked by engine/stock_fundamentals.py =====
  var TF = {
    en: { building:'Building — arrives in a later phase.',
          deeponly:'Analyst ratings & price targets aren\'t collected yet — coming in a later (tiered) phase. The figures below are from a ~110-name deep-set snapshot.',
          earnsoon:'Next earnings date, surprise history and estimate-revision trend arrive in Phase 2 (SEC + Nasdaq, keyless).',
          gexsoon:'Per-equity dealer gamma exposure (GEX), the gamma-flip level and IV arrive in Phase 3 — CBOE delayed quotes, per-equity coverage already confirmed.',
          grade:'Quality', valuevs:'Valuation', shyield:'Shareholder yld', nextearn:'Next earnings',
          verdict:'Master verdict', cheap:'cheap vs S&P', rich:'rich vs S&P', na:'n/a', soon:'Phase 2', tbd:'Phase 4',
          archhelp:'Archetype from factor ranks', conf:'confidence',
          fwdpe:'Forward P/E', peyf:'P/E (Yahoo)', pmargin:'Profit margin', roe:'ROE', dyield:'Dividend yld',
          short:'Short interest', shortpct:'Short % of float', dtc:'Days to cover', sichg:'SI change (2wk)',
          insider:'Insider net flow', insiderpct:'Net buying (% cap)', buyers:'distinct insiders (B/S)', buys:'buys / sells', fwdnote_lite:'Forward P/E: trailing only — no free forward estimate at S&P-1500 scale.',
          mediansrc:'sector median', scorelab:'Factor score', compos:'composite percentile vs S&P 1500',
          suehelp:'Standardized unexpected earnings — how far the latest quarter beat its year-ago seasonal expectation, standardized by the company’s own history (post-earnings-announcement drift). Cross-sectional winsorized z vs the S&P 1500; the only positive factor leg to survive the leak-free FDR scorecard. Context, not a standalone signal.',
          suevs:'z vs S&P 1500',
          piotroski:'Piotroski F · Altman Z', ph2:'Phase 2' },
    zh: { building:'建设中——将在后续阶段加入。',
          deeponly:'分析师评级与目标价尚未采集——将在后续（分层）阶段加入。下方数据来自约110只标的的深度集快照。',
          earnsoon:'下次财报日、超预期历史与预期修正趋势将在第二阶段加入（SEC＋纳斯达克，免密钥）。',
          gexsoon:'每只股票的做市商Gamma敞口（GEX）、Gamma翻转价位与隐含波动率将在第三阶段加入——CBOE延迟报价，逐股覆盖已验证。',
          grade:'质量', valuevs:'估值', shyield:'股东回报率', nextearn:'下次财报',
          verdict:'综合判断', cheap:'低于标普', rich:'高于标普', na:'无', soon:'第二阶段', tbd:'第四阶段',
          archhelp:'基于因子排名的画像', conf:'确信度',
          fwdpe:'前瞻市盈率', peyf:'市盈率（雅虎）', pmargin:'利润率', roe:'净资产收益率', dyield:'股息率',
          short:'做空持仓', shortpct:'做空占流通股', dtc:'回补天数', sichg:'做空变化（两周）',
          insider:'内部人净流向', insiderpct:'净买入（占市值%）', buyers:'不同内部人（买/卖）', buys:'买入 / 卖出', fwdnote_lite:'前瞻市盈率：仅历史值——标普1500规模下无免费前瞻预期。',
          mediansrc:'行业中位', scorelab:'因子评分', compos:'相对标普1500综合百分位',
          suehelp:'标准化超预期盈利（SUE）——最新季度相对去年同期季节性预期超出多少，并以公司自身历史标准化（盈利公布后漂移效应）。相对标普1500的横截面缩尾z值；是唯一通过无泄漏FDR评分卡的正向因子。仅供参考，并非独立信号。',
          suevs:'相对标普1500的z',
          piotroski:'Piotroski F · Altman Z', ph2:'第二阶段' } };
  function LF(k) { return (TF[lang()] || TF.en)[k]; }
  function el(id) { return document.getElementById(id); }
  function show(id, on) { var e = el(id); if (e) e.style.display = on ? '' : 'none'; }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
    return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]; }); }
  function fmtNum(n) {
    if (n == null) return LF('na');
    var a = Math.abs(n), s = n < 0 ? '-' : '';
    if (a >= 1e12) return s + '$' + (a/1e12).toFixed(2) + 'T';
    if (a >= 1e9)  return s + '$' + (a/1e9).toFixed(2) + 'B';
    if (a >= 1e6)  return s + '$' + (a/1e6).toFixed(1) + 'M';
    if (a >= 1e3)  return s + '$' + (a/1e3).toFixed(0) + 'K';
    return s + '$' + a.toFixed(0);
  }
  function fmtX(n) { return n == null ? LF('na') : (n < 10 ? n.toFixed(1) : Math.round(n)) + '×'; }
  function fmtPct(n, nd) { return n == null ? LF('na') : n.toFixed(nd == null ? 1 : nd) + '%'; }
  function signPct(n) { if (n == null) return ''; var c = n > 0 ? 'pos' : n < 0 ? 'neg' : 'muted';
    return '<span class="' + c + '">' + (n > 0 ? '+' : '') + n.toFixed(1) + '%</span>'; }
  function gchip(k, v, dashed) { return '<span class="gchip' + (dashed ? ' dashed' : '') + '"><span class="gk">' +
    k + '</span><span class="gv">' + v + '</span></span>'; }
  function gradeFromScore(s) { return s == null ? null : s >= 60 ? 'A' : s >= 30 ? 'B' : s >= 0 ? 'C' : s >= -30 ? 'D' : 'F'; }
  function gradeStyle(g) { var c = (g==='A'||g==='B') ? 'var(--up)' : (g==='D'||g==='F') ? 'var(--down)' : 'var(--muted)';
    return 'color:' + c + ';background:color-mix(in srgb,' + c + ' 14%,transparent)'; }
  function kvRow(k, v, warn) { return '<div class="kv"><span class="kvk">' + k + '</span><span class="kvv' +
    (warn ? ' neg' : '') + '">' + v + '</span></div>'; }

  function radarSVG(radar) {
    var cx = 80, cy = 80, R = 56, N = 6;
    var labs = { value:['Val','价值'], profitability:['Prof','盈利'], quality:['Qual','质量'],
                 investment:['Inv','投资'], payout:['Pay','回报'], low_vol:['LoVol','低波'] };
    function pt(i, r) { var a = (-90 + i*360/N) * Math.PI/180; return [cx + r*Math.cos(a), cy + r*Math.sin(a)]; }
    function poly(r) { var p = []; for (var i=0;i<N;i++){ var xy = pt(i,r); p.push(xy[0].toFixed(1)+','+xy[1].toFixed(1)); } return p.join(' '); }
    var g = '<svg class="radar" width="160" height="176" viewBox="0 0 160 176" aria-hidden="true">';
    g += '<polygon points="' + poly(R) + '" fill="none" stroke="var(--line)"/>';
    g += '<polygon points="' + poly(R*0.5) + '" fill="none" stroke="var(--line)" opacity=".55"/>';
    var dp = [];
    for (var i=0;i<N;i++) {
      var sp = pt(i, R);
      g += '<line x1="'+cx+'" y1="'+cy+'" x2="'+sp[0].toFixed(1)+'" y2="'+sp[1].toFixed(1)+'" stroke="var(--line)" opacity=".5"/>';
      var z = (radar[i] && radar[i].z != null) ? radar[i].z : 0;
      var v = Math.max(0, Math.min(1, (z + 3) / 6));
      var d2 = pt(i, v*R); dp.push(d2[0].toFixed(1)+','+d2[1].toFixed(1));
      var lp = pt(i, R + 13), lab = labs[radar[i].key] || ['',''];
      g += '<text x="'+lp[0].toFixed(1)+'" y="'+lp[1].toFixed(1)+'" font-size="9" fill="var(--muted)" text-anchor="middle" dominant-baseline="middle">' + (lang()==='zh'?lab[1]:lab[0]) + '</text>';
    }
    g += '<polygon points="' + dp.join(' ') + '" fill="var(--link)" fill-opacity=".22" stroke="var(--link)" stroke-width="1.5"/>';
    return g + '</svg>';
  }
  function sparkSVG(arr) {
    if (!arr || arr.length < 2 || arr[0] == null || arr[1] == null) return '';
    var w = 64, h = 20, pad = 3, a = arr[0], b = arr[1];
    var lo = Math.min(a,b), hi = Math.max(a,b), rng = (hi - lo) || Math.abs(hi) || 1;
    function y(v) { return (h - pad) - ((v - lo) / rng) * (h - 2*pad); }
    var up = b >= a, col = up ? 'var(--up)' : 'var(--down)';
    return '<svg class="spark" width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" aria-hidden="true">' +
      '<line x1="'+pad+'" y1="'+y(a).toFixed(1)+'" x2="'+(w-pad)+'" y2="'+y(b).toFixed(1)+'" stroke="'+col+'" stroke-width="1.6"/>' +
      '<circle cx="'+(w-pad)+'" cy="'+y(b).toFixed(1)+'" r="2.2" fill="'+col+'"/></svg>';
  }
  function sparkN(arr, w) {
    var pts = (arr || []).filter(function (x) { return x != null; });
    if (pts.length < 2) return '';
    w = w || 120; var h = 22, pad = 3, n = arr.length, step = (w - 2*pad) / (n - 1);
    var lo = Math.min.apply(null, pts), hi = Math.max.apply(null, pts), rng = (hi - lo) || Math.abs(hi) || 1;
    var d = '', first = true, lx = pad, ly = null;
    for (var i = 0; i < n; i++) {
      if (arr[i] == null) continue;
      var x = pad + i*step, yy = (h - pad) - ((arr[i] - lo) / rng) * (h - 2*pad);
      d += (first ? 'M' : 'L') + x.toFixed(1) + ' ' + yy.toFixed(1) + ' '; first = false; lx = x; ly = yy;
    }
    var up = pts[pts.length-1] >= pts[0], col = up ? 'var(--up)' : 'var(--down)';
    return '<svg class="spark" width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'" aria-hidden="true">' +
      '<path d="'+d+'" fill="none" stroke="'+col+'" stroke-width="1.5"/>' +
      (ly != null ? '<circle cx="'+lx.toFixed(1)+'" cy="'+ly.toFixed(1)+'" r="2" fill="'+col+'"/>' : '') + '</svg>';
  }
  function myRow(lab, series, fmtFn, cagr) {
    var clean = (series || []).filter(function (x) { return x != null; });
    if (!clean.length) return '';
    var last = clean[clean.length - 1];
    var cg = (cagr != null) ? ' <span class="' + (cagr > 0 ? 'pos' : 'neg') + '">' + (cagr > 0 ? '+' : '') + cagr + '%/yr</span>' : '';
    return '<div class="myrow"><span class="mylab">' + lab + '</span>' + sparkN(series, 116) +
           '<span class="myval">' + fmtFn(last) + cg + '</span></div>';
  }
  function valbar(lab, cell, kind) {
    if (!cell || cell.v == null) return '';
    var v = kind === 'x' ? fmtX(cell.v) : fmtPct(cell.v, 1);
    var cheap = cell.cheap == null ? 50 : cell.cheap;
    var col = 'color-mix(in srgb, var(--up) ' + cheap + '%, var(--down))';
    var med = cell.med == null ? '—' : (kind === 'x' ? fmtX(cell.med) : fmtPct(cell.med, 1));
    return '<div class="valbar" title="' + LF('mediansrc') + ' ' + med + '"><span class="vlab">' + lab + '</span>' +
      '<span class="vval">' + v + '</span><span class="vtrack">' +
      '<span class="vfill" style="width:' + cheap + '%;background:' + col + '"></span>' +
      '<span class="vmed" style="left:50%"></span></span></div>';
  }
  function finrow(lab, val, fmt, chg, spark) {
    if (val == null && !(spark && spark[0] != null)) return '';
    var v = val == null ? LF('na') : (fmt === 'num' ? fmtNum(val) : fmtPct(val, 1));
    var sp = spark ? sparkSVG(spark) : '';
    var ch = (chg == null) ? '' : signPct(chg);
    return '<div class="finrow"><span class="flab">' + lab + sp + '</span><span class="fval">' + v + '</span><span class="fchg">' + ch + '</span></div>';
  }
  function zbar(lab, z) {
    var mag = Math.max(0, Math.min(50, Math.abs(z) / 3 * 50));
    var pos = z >= 0, col = pos ? 'var(--up)' : 'var(--down)';
    var style = (pos ? 'left:50%;' : 'right:50%;') + 'width:' + mag + '%';
    return '<div class="zrow"><span class="zlab">' + lab + '</span><span class="ztrack"><span class="zmid"></span>' +
      '<span class="zfill" style="' + style + ';background:' + col + '"></span></span></div>';
  }
  var VROWS = [
    { k:'trailing_pe', en:'P/E (trailing)', zh:'市盈率（历史）', kind:'x' },
    { k:'price_to_book', en:'Price / book', zh:'市净率', kind:'x' },
    { k:'price_to_sales', en:'Price / sales', zh:'市销率', kind:'x' },
    { k:'earnings_yield', en:'Earnings yield', zh:'盈利收益率', kind:'pct' },
    { k:'fcf_proxy_yield', en:'FCF yield (pre-capex)', zh:'自由现金流收益率', kind:'pct' },
    { k:'shareholder_yield', en:'Shareholder yield', zh:'股东回报率', kind:'pct' } ];
  var FROWS = [
    { en:'Revenue', zh:'营收', get:function(f){return f.raw && f.raw.revenue;}, fmt:'num', chg:function(f){return f.rev_growth;} },
    { en:'Gross margin', zh:'毛利率', get:function(f){return f.gross_margin;}, fmt:'pct' },
    { en:'Net margin', zh:'净利率', get:function(f){return f.net_margin;}, fmt:'pct' },
    { en:'Net income', zh:'净利润', get:function(f){return f.raw && f.raw.ni;}, fmt:'num', chg:function(f){return f.ni_growth;}, spark:function(f){return f.spark && f.spark.ni;} },
    { en:'FCF margin', zh:'自由现金流利润率', get:function(f){return f.fcf_margin;}, fmt:'pct' },
    { en:'Return on equity', zh:'净资产收益率', get:function(f){return f.roe;}, fmt:'pct' } ];
  var ZL = { value:['Value','价值'], profitability:['Profitability','盈利能力'], quality:['Quality','质量'],
             investment:['Investment','投资'], payout:['Payout','股东回报'], low_vol:['Low volatility','低波动'],
             low_beta:['Low beta','低贝塔'], accruals:['Low accruals','低应计'], short_interest:['Low short int.','低做空'] };

  function hideFundamentals() {
    ['panel_profile','panel_val','panel_fin','panel_aq','panel_earn','panel_fac','panel_alpha','panel_gex','panel_pos','panel_analyst']
      .forEach(function (id) { show(id, false); });
    show('r_archetype', false); show('r_glance', false);
  }

  // Macro sensitivity chip (engine/stock_macro_sensitivity.py) — rate-beta tier +
  // duration bucket + live-regime head/tailwind + inflation label. Display-only, never
  // scored; every render carries the mandatory single-name-noise caveat.
  function renderMacroSens(d) {
    var box = el('r_macrosens'), ms = d.macro_sensitivity;
    if (!box) return;
    if (!ms) { box.style.display = 'none'; return; }
    box.className = 'macro-sens' + (ms.regime ? ' ms-' + ms.regime : '');
    var ttl = lang() === 'zh' ? '宏观敏感性' : 'Macro sensitivity';
    var chips = [];
    chips.push('<span class="ms-chip ms-' + ms.duration + '">' +
      lz(ms.duration_label.en, ms.duration_label.zh) + '</span>');
    var betaTxt = (ms.rate_beta >= 0 ? '+' : '') + ms.rate_beta.toFixed(2) +
      (ms.rate_beta_se != null ? ' ± ' + ms.rate_beta_se.toFixed(2) : '');
    chips.push('<span class="ms-chip ms-tier-' + ms.tier + '">' +
      (lang() === 'zh' ? '利率beta' : 'Rate β') + ' <b>' + betaTxt + '</b> · ' +
      lz(ms.tier_label.en, ms.tier_label.zh) + '</span>');
    chips.push('<span class="ms-chip ms-' + ms.inflation + '">' +
      lz(ms.inflation_label.en, ms.inflation_label.zh) + '</span>');
    box.innerHTML =
      '<div class="ms-head"><span class="ms-ttl">' + ttl + '</span>' +
        esc(lz(ms.headline.en, ms.headline.zh)) + '</div>' +
      '<div class="ms-chips">' + chips.join('') + '</div>' +
      '<div class="muted" style="font-size:12px;margin-top:5px">' +
        esc(lz(ms.detail.en, ms.detail.zh)) + '</div>' +
      '<div class="ms-cav">' + esc(lz(ms.caveat.en, ms.caveat.zh)) + '</div>';
    box.style.display = 'block';
  }

  function renderFundamentals(d) {
    var prof = d.profile, val = d.valuation, fin = d.financials, fac = d.factors, pos = d.positioning, an = d.analyst;
    var isEquity = !!(prof || val || fin || fac);

    var arch = prof && prof.archetype, archEl = el('r_archetype');
    if (arch) {
      archEl.textContent = lz(arch.label, arch.label_zh);
      archEl.className = 'arch a-' + arch.key;
      archEl.title = LF('archhelp') + ' · ' + lz(arch.why, arch.why_zh) + ' (' + LF('conf') + ': ' + arch.conf_word + ')';
      archEl.style.display = 'inline-flex';
    } else { archEl.style.display = 'none'; }

    var chips = [];
    if (fac && fac.fundamental_score != null) {
      var g = gradeFromScore(fac.fundamental_score);
      chips.push(gchip(LF('grade'), '<span class="grade" style="' + gradeStyle(g) + '">' + g + '</span>'));
    }
    if (val && val.value_z != null)
      chips.push(gchip(LF('valuevs'), '<span class="' + (val.value_z > 0 ? 'pos' : 'neg') + '">' +
        (val.value_z > 0 ? LF('cheap') : LF('rich')) + '</span>'));
    if (val && val.shareholder_yield && val.shareholder_yield.v != null)
      chips.push(gchip(LF('shyield'), fmtPct(val.shareholder_yield.v, 2)));
    if (isEquity) {
      var _earn = d.earnings || {};
      if (_earn.next_date) chips.push(gchip(LF('nextearn'), '<b>' + esc(_earn.next_date) + '</b>'));
      else chips.push(gchip(LF('nextearn'), '<span class="muted">' + LF('na') + '</span>', true));
      var _cv = d.conviction;
      if (_cv && _cv.score != null)
        chips.push(gchip(LF('verdict'), '<span class="cvchip band-' + _cv.band + '">' + _cv.score + '</span>'));
      else chips.push(gchip(LF('verdict'), '<span class="muted">' + LF('na') + '</span>', true));
    }
    var glance = el('r_glance');
    if (chips.length) { glance.innerHTML = chips.join(''); glance.style.display = 'flex'; }
    else glance.style.display = 'none';

    if (prof) {
      el('r_profile_desc').textContent = lz(prof.description, prof.description_zh) || LF('building');
      el('r_profile_desc').className = prof.description ? '' : 'muted';
      var pc = [];
      if (prof.sector) pc.push('<span class="chip">' + esc(prof.sector) + '</span>');
      if (prof.mktcap_tier) pc.push('<span class="chip">' + lz(prof.mktcap_tier.label, prof.mktcap_tier.label_zh) +
        (prof.mktcap_bn != null ? ' · $' + Math.round(prof.mktcap_bn) + 'B' : '') + '</span>');
      if (prof.sic_description) pc.push('<span class="chip">' + esc(prof.sic_description) + '</span>');
      if (prof.exchange) pc.push('<span class="chip">' + esc(prof.exchange) + '</span>');
      el('r_profile_chips').innerHTML = pc.join('');
      show('panel_profile', true);
    } else show('panel_profile', false);

    if (val) {
      el('r_valbars').innerHTML = VROWS.map(function (r) { return valbar(lz(r.en, r.zh), val[r.k], r.kind); }).join('');
      el('r_val_fwd').innerHTML = (val.forward_pe != null)
        ? (lz('Forward P/E','前瞻市盈率') + ': <b>' + val.forward_pe.toFixed(1) + '×</b>')
        : '<span class="muted">' + LF('fwdnote_lite') + '</span>';
      show('panel_val', true);
    } else show('panel_val', false);

    if (fin) {
      // multi-year trend (SEC companyfacts) — sparklines + CAGR; falls back to the
      // single-year rows below when companyfacts hasn't been collected for this name
      var my = fin.multiyear;
      if (my && my.years && my.years.length >= 2) {
        var yspan = ' <span class="muted">(FY' + my.years[0] + '–' + my.years[my.years.length-1] + ')</span>';
        var mrows = [
          myRow(lz('Revenue','营收'), my.revenue, fmtNum, my.rev_cagr),
          myRow(lz('Net margin','净利率'), my.net_margin, function (x){ return x.toFixed(1)+'%'; }, null),
          myRow(lz('Diluted EPS','摊薄EPS'), my.eps, function (x){ return '$'+x.toFixed(2); }, my.eps_cagr),
          myRow(lz('Free cash flow','自由现金流'), my.fcf, fmtNum, null)
        ].join('');
        el('r_multiyear').innerHTML = '<div class="myhdr">' + lz('Multi-year trend','多年趋势') + yspan + '</div>' + mrows;
      } else { el('r_multiyear').innerHTML = ''; }

      el('r_finrows').innerHTML = FROWS.map(function (r) {
        return finrow(lz(r.en, r.zh), r.get(fin), r.fmt, r.chg ? r.chg(fin) : null, r.spark ? r.spark(fin) : null);
      }).join('');
      var more = [];
      more.push(finrow(lz('Return on assets','总资产收益率'), fin.roa, 'pct'));
      more.push(finrow(lz('Debt / assets','负债／资产'), fin.debt_to_assets, 'pct'));
      more.push(finrow(lz('Asset growth (YoY)','资产增长（同比）'), fin.asset_growth, 'pct'));
      more.push(finrow(lz('Accruals (lower = better)','应计（越低越好）'), fin.accruals == null ? null : fin.accruals * 100, 'pct'));
      // Piotroski F + Altman Z health chips (real when companyfacts present, else stub)
      var hz = [];
      if (my && my.piotroski) {
        var f = my.piotroski, fcol = (f.score >= Math.ceil(f.of*0.7)) ? 'var(--up)' : (f.score <= Math.floor(f.of*0.34)) ? 'var(--down)' : 'var(--muted)';
        hz.push('<span class="hchip" style="color:'+fcol+';background:color-mix(in srgb,'+fcol+' 14%,transparent)" title="'+lz('Piotroski F — fundamental-momentum signals passing','Piotroski F — 通过的基本面动能信号')+'">F '+f.score+'/'+f.of+'</span>');
      }
      if (my && my.altman) {
        var z = my.altman, zcol = z.zone==='safe' ? 'var(--up)' : z.zone==='distress' ? 'var(--down)' : 'var(--warn)';
        var zlab = lz({safe:'safe',grey:'grey zone',distress:'distress'}[z.zone], {safe:'安全',grey:'灰色区',distress:'困境'}[z.zone]);
        hz.push('<span class="hchip" style="color:'+zcol+';background:color-mix(in srgb,'+zcol+' 14%,transparent)" title="Altman Z — '+zlab+'">Z '+z.z+' · '+zlab+'</span>');
      }
      more.push('<div class="finrow"><span class="flab">' + LF('piotroski') + '</span><span class="fval">' +
        (hz.length ? hz.join(' ') : '<span class="muted">'+LF('ph2')+'</span>') + '</span><span class="fchg"></span></div>');
      el('r_finmore').innerHTML = more.join('');
      show('panel_fin', true);
    } else show('panel_fin', false);

    var aq = d.accounting_quality;
    if (aq) {
      var vcls = aq.verdict === 'clean' ? 'aq-clean' : aq.verdict === 'warn' ? 'aq-warn' : 'aq-watch';
      var vic = aq.verdict === 'clean' ? '✅' : aq.verdict === 'warn' ? '🚩' : '⚠️';
      var basis = lz(aq.basis, aq.basis_zh);
      if (aq.piotroski && aq.piotroski.of) basis += ' · Piotroski F ' + aq.piotroski.score + '/' + aq.piotroski.of;
      var aqh = '<span class="aq-head ' + vcls + '">' + vic + ' ' + esc(lz(aq.headline, aq.headline_zh)) +
                '</span><span class="aq-basis">' + esc(basis) + '</span>';
      var aqr = (aq.reads || []).map(function (r) {
        return '<div class="aq-read"><span class="aq-dot s-' + esc(r.state) + '"></span>' +
               '<span class="aqk">' + esc(lz(r.label, r.label_zh)) + '</span>' +
               '<span class="aqd">' + esc(lz(r.detail, r.detail_zh)) + '</span></div>';
      }).join('');
      el('r_aq').innerHTML = aqh + '<div class="aq-reads">' + aqr + '</div>' +
        '<p class="aq-foot">' + esc(lz(aq.caveat, aq.caveat_zh)) + '</p>';
      show('panel_aq', true);
    } else show('panel_aq', false);

    if (d.earnings) {
      var ev = d.earnings, eh = '';
      if (ev.next_date) {
        var days = Math.ceil((new Date(ev.next_date + 'T00:00:00') - new Date()) / 86400000);
        var when = days < 0 ? lz('reported','已公布') : days === 0 ? lz('today','今天')
                 : (lz('in','还有') + ' ' + days + lz('d','天'));
        var tm = ev.next_time ? ' · ' + ev.next_time : '';
        var est = ev.eps_forecast != null ? ' · ' + lz('est EPS','预期EPS') + ' $' + ev.eps_forecast : '';
        eh += '<div class="earnhdr"><span class="earndays">' + when + '</span> <span class="muted">' +
              lz('next earnings','下次财报') + ' ' + ev.next_date + tm + est + '</span></div>';
      }
      if (ev.summary) {
        var su = ev.summary, bc = (su.beats >= Math.ceil(su.total*0.75)) ? 'var(--up)'
                : (su.beats <= Math.floor(su.total*0.25)) ? 'var(--down)' : 'var(--muted)';
        var strk = su.streak >= 2 ? ' · ' + su.streak + lz('-streak','连') : '';
        eh += '<div style="margin:6px 0"><span class="hchip" style="color:'+bc+';background:color-mix(in srgb,'+bc+' 14%,transparent)">' +
              lz('beat','超预期') + ' ' + su.beats + '/' + su.total + strk + '</span> <span class="muted">' +
              lz('avg surprise','平均超预期') + ' ' + (su.avg_surprise > 0 ? '+' : '') + su.avg_surprise + '%</span></div>';
      }
      if (ev.sue_z != null) {
        // SUE earnings-momentum z — the validated post-earnings-drift leg (factors.json
        // table 'sue'; survives the leak-free FDR scorecard). title via LF() not the t()
        // macro — a span pair would break the attribute.
        var sz = ev.sue_z;
        var sc = sz >= 0.5 ? 'var(--up)' : sz <= -0.5 ? 'var(--down)' : 'var(--muted)';
        eh += '<div style="margin:6px 0"><span class="hchip" title="' + esc(LF('suehelp')) +
              '" style="color:'+sc+';background:color-mix(in srgb,'+sc+' 14%,transparent)">' +
              lz('earnings momentum (SUE)','盈利动量 (SUE)') + ' ' + (sz > 0 ? '+' : '') + sz.toFixed(2) +
              '</span> <span class="muted">' + LF('suevs') + '</span></div>';
      }
      if (ev.surprises && ev.surprises.length) {
        var er = ev.surprises.map(function (s) {
          var sp = s.surprise_pct;
          return '<tr><td>' + (s.qtr || '') + '</td><td>' + (s.eps != null ? '$'+s.eps : '—') +
                 '</td><td>' + (s.consensus != null ? '$'+s.consensus : '—') + '</td><td class="' +
                 (sp > 0 ? 'pos' : sp < 0 ? 'neg' : '') + '">' + (sp != null ? (sp>0?'+':'')+sp+'%' : '—') + '</td></tr>';
        }).join('');
        eh += '<table class="earntbl"><tr><th>' + lz('quarter','季度') + '</th><th>' + lz('actual','实际') +
              '</th><th>' + lz('est','预期') + '</th><th>' + lz('surprise','超预期') + '</th></tr>' + er + '</table>';
      }
      el('r_earn').innerHTML = eh || ('<div class="stub">' + LF('earnsoon') + '</div>');
      show('panel_earn', true);
    } else if (isEquity) {
      el('r_earn').innerHTML = '<div class="stub">' + LF('earnsoon') + '</div>'; show('panel_earn', true);
    } else show('panel_earn', false);

    if (fac) {
      el('r_radar').innerHTML = fac.radar_ok ? radarSVG(fac.radar) : '';
      var zb = [];
      Object.keys(ZL).forEach(function (k) {
        var z = fac.legs ? fac.legs[k] : null;
        if (z != null) zb.push(zbar(lz(ZL[k][0], ZL[k][1]), z));
      });
      el('r_zbars').innerHTML = zb.join('');
      var sc = fac.fundamental_score;
      el('r_fac_score').innerHTML = (sc == null) ? ''
        : (LF('scorelab') + ': <b>' + (sc > 0 ? '+' : '') + sc + '</b> / ±100 — ' + LF('compos') +
           (fac.n_universe ? ' (n=' + fac.n_universe + ')' : ''));
      show('panel_fac', true);
    } else show('panel_fac', false);

    renderGex(d);

    if (pos && (pos.short || pos.insider)) {
      var html = '';
      if (pos.short) {
        var s = pos.short;
        html += '<div class="posbox"><h3>' + LF('short') + '</h3>' +
          kvRow(LF('shortpct'), s.pct_float == null ? LF('na') : s.pct_float.toFixed(2) + '%', s.pct_float != null && s.pct_float >= 10) +
          kvRow(LF('dtc'), s.days_to_cover == null ? LF('na') : s.days_to_cover.toFixed(1), s.days_to_cover != null && s.days_to_cover >= 5) +
          kvRow(LF('sichg'), s.si_change_pct == null ? LF('na') : signPct(s.si_change_pct), false) + '</div>';
      }
      if (pos.insider) {
        var ins = pos.insider, net = ins.net_usd_mn, irows = '';
        // headline: net buying as a % of market cap (size-normalised, the validated read)
        if (ins.net_mcap_bps != null) {
          var pct = ins.net_mcap_bps / 100, tiny = Math.abs(pct) < 0.005;
          var pctStr = tiny ? '≈0%' : (pct > 0 ? '+' : '') + pct.toFixed(2) + '%';
          var pctCls = tiny ? 'muted' : (pct > 0 ? 'pos' : 'neg');
          irows += kvRow(LF('insiderpct'), '<span class="' + pctCls + '">' + pctStr + '</span>', false);
        }
        var netstr = net == null ? LF('na') : '<span class="' + (net > 0 ? 'pos' : 'neg') + '">' +
          (net > 0 ? '+' : '-') + '$' + Math.abs(net).toFixed(1) + 'M</span>';
        irows += kvRow(LF('insider'), netstr, false);
        // distinct-insider clusters (panel) or buy/sell filing counts (aggregate)
        if (ins.cluster && ins.n_buyers != null) {
          irows += kvRow(LF('buyers'), (ins.n_buyers || 0) + ' / ' + (ins.n_sellers || 0), false);
        } else if (ins.n_buys != null) {
          irows += kvRow(LF('buys'), (ins.n_buys || 0) + ' / ' + (ins.n_sells || 0), false);
        }
        html += '<div class="posbox"><h3>' + LF('insider') + '</h3>' + irows +
          (ins.quarter ? '<p class="srcline">' + esc(ins.quarter) + '</p>' : '') + '</div>';
      }
      el('r_pos').innerHTML = html;
      show('panel_pos', true);
    } else show('panel_pos', false);

    if (isEquity) {
      var ah;
      if (an && an.tier === 'deep') {
        var ar = [];
        if (an.forward_pe != null) ar.push(kvRow(LF('fwdpe'), an.forward_pe.toFixed(1) + '×', false));
        if (an.pe_yf != null) ar.push(kvRow(LF('peyf'), an.pe_yf.toFixed(1) + '×', false));
        if (an.profit_margin != null) ar.push(kvRow(LF('pmargin'), an.profit_margin.toFixed(1) + '%', false));
        if (an.roe != null) ar.push(kvRow(LF('roe'), an.roe.toFixed(1) + '%', false));
        if (an.div_yield != null) ar.push(kvRow(LF('dyield'), an.div_yield.toFixed(2) + '%', false));
        ah = (ar.length ? '<div class="posbox">' + ar.join('') + '</div>' : '') + '<p class="srcline">' + LF('deeponly') + '</p>';
      } else { ah = '<div class="stub">' + LF('deeponly') + '</div>'; }
      el('r_analyst').innerHTML = ah;
      show('panel_analyst', true);
    } else show('panel_analyst', false);
  }
  // internal state -> friendly "LABEL · ACTION" (mirrors engine/cycles.STATE_DISPLAY)
  var DISP = {{ state_display_json | safe }};
  // alert-feed conviction notes keyed by event type — the slimmed events embedded
  // in each stockdata JSON omit these repeated strings; we reattach them client-side
  var AF_META = {{ ticker_alert_meta_json | default('{}', true) | safe }};
  function dlabel(s) { var d = DISP[s]; if (!d) return s; return lang() === 'zh' ? (d.label_zh || d.label) : d.label; }
  function disp(s) {
    var d = DISP[s]; if (!d) return s;
    return lang() === 'zh' ? (d.label_zh || d.label) + ' · ' + (d.action_zh || d.action)
                           : d.label + ' · ' + d.action;
  }
  fetch('stockdata/calibration.json').then(r => r.ok ? r.json() : null)
    .then(d => { cal = d; }).catch(() => {});
  fetch('stockdata/bc_calibration.json').then(r => r.ok ? r.json() : null)
    .then(d => { bcCal = d; }).catch(() => {});
  // historical "cycle-low held" rate for a bottom-confidence score's band
  function bcBand(s) {
    return s < 20 ? '0-20' : s < 40 ? '20-40' : s < 60 ? '40-60' : '60+';
  }

  function fromHash() {
    var t = decodeURIComponent((location.hash || '').slice(1));
    if (t) load(t);
  }
  window.addEventListener('hashchange', fromHash);

  function tf(label, m) {
    if (!m || m.rsi14 == null) return '';
    var macd = m.macd_pos ? '🟢' : '🔴';
    var note = m.macd_cross_up ? L('cu') : m.macd_cross_dn ? L('cd')
      : m.macd_approaching_up ? ' ≈' + m.macd_bars_to_cross + L('bullx')
      : m.macd_approaching_dn ? ' ≈' + m.macd_bars_to_cross + L('bearx') : '';
    return '<span><b>' + label + '</b> · RSI ' + m.rsi14 + ' · Stoch ' + m.stoch +
           ' · MACD ' + macd + note + '</span>';
  }

  // ===== verdict hero + at-a-glance signal strip + alert feed =====
  // The action verb for the verdict (just the ACTION half of DISP, current lang).
  function ladderAction(l) { var dd = DISP[l.state];
    if (dd) return lang() === 'zh' ? (dd.action_zh || dd.action) : dd.action;
