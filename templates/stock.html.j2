<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stock analyzer — cycle & momentum</title>
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,
         "Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:26px max(40px,calc((100vw - 1100px)/2)); } }
  .points { margin:6px 0; padding-left:18px; } .points li { margin:2px 0; }
  .cyclebox { margin:8px 0; padding:9px 12px; border-radius:9px; background:var(--panel2);
              font-size:13px; line-height:1.6; }
  .regline { margin:-2px -4px 6px; padding:6px 9px; border-radius:7px;
             border-left:3px solid var(--muted); }
  .regline.rl-bear { border-left-color:var(--down);
             background:color-mix(in srgb, var(--down) 12%, var(--panel2)); }
  .regline.rl-bull { border-left-color:var(--up);
             background:color-mix(in srgb, var(--up) 12%, var(--panel2)); }
  .regline.rl-neutral { border-left-color:var(--muted);
             background:color-mix(in srgb, var(--muted) 10%, var(--panel2)); }
  .entrybar { display:flex; gap:10px; align-items:flex-start; margin:10px 0 8px;
              padding:9px 12px; border-radius:9px; background:var(--panel2);
              border-left:4px solid var(--muted); font-size:14px; }
  .entrytag { font-weight:800; font-size:12px; letter-spacing:.04em; white-space:nowrap;
              padding:3px 9px; border-radius:7px; background:var(--panel); color:var(--text); border:1px solid var(--line); }
  .urg-now .entrytag { background:var(--up); color:#fff; } .urg-now { border-left-color:var(--up); }
  .urg-imminent .entrytag { background:var(--g-cold); color:#fff; } .urg-imminent { border-left-color:var(--g-cold); }
  .urg-soon { border-left-color:var(--g-cold); } .urg-later { border-left-color:var(--muted); }
  .urg-hold { border-left-color:var(--muted); }
  .urg-caution .entrytag { background:var(--warn); color:#1a1a1a; } .urg-caution { border-left-color:var(--warn); }
  .urg-exit .entrytag { background:var(--down); color:#fff; } .urg-exit { border-left-color:var(--down); }
  .urg-avoid { border-left-color:var(--down); }
  .early { margin:6px 0; padding:8px 12px; border-radius:8px;
           background:color-mix(in srgb, var(--g-cold) 14%, var(--panel2));
           border-left:3px solid var(--g-cold); font-size:13px; color:var(--text); }
  .agewhen { margin:6px 0; padding:7px 11px; border-radius:8px; background:var(--panel2);
             border-left:3px solid var(--link); font-size:13px; color:var(--text); }
  .eqbadge { display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
             border-radius:11px; font-size:12.5px; font-weight:700; cursor:help;
             border:1px solid var(--line); white-space:nowrap; }
  .eqbadge .eqg { font-weight:500; opacity:.8; }
  .eqbadge.eq-up { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
                   border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .eqbadge.eq-down { background:color-mix(in srgb,var(--down) 16%,transparent); color:var(--down);
                     border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .eqbadge.eq-flat { background:var(--panel2); color:var(--muted); }
  a { text-decoration:none; }
  h1 { font-size:20px; margin:0; }
  h2 { font-size:14px; margin:0 0 10px; color:var(--muted); text-transform:uppercase;
       letter-spacing:.06em; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:10px;
           padding:14px 16px; margin-bottom:14px; }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .muted { color:var(--muted); }
  .state { display:inline-block; padding:2px 11px; border-radius:12px; font-weight:700;
           font-size:12.5px; }
  .searchwrap { position:relative; flex:1; min-width:260px; max-width:460px; }
  #q { width:100%; padding:10px 14px; border-radius:10px; border:1px solid var(--line);
       background:var(--panel2); color:var(--text); font-size:15px; outline:none; }
  #q:focus { border-color:var(--link); }
  #sugg { position:absolute; top:104%; left:0; right:0; background:var(--panel);
          border:1px solid var(--line); border-radius:10px; z-index:50; max-height:330px;
          overflow:auto; display:none; box-shadow:var(--popover-shadow); }
  #sugg div { padding:8px 13px; cursor:pointer; display:flex; gap:10px; align-items:center; }
  #sugg div:hover, #sugg div.sel { background:var(--panel2); }
  #sugg b { min-width:58px; }
  #sugg small { color:var(--muted); flex:1; }
  .mtf { display:flex; gap:14px; flex-wrap:wrap; font-size:12.5px; color:var(--muted);
         margin-top:8px; }
  .mtf b { color:var(--text); }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { text-align:left; padding:4px 8px; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:500; }
  #result { display:none; }
  /* tooltip (the help() macro) — mirrors the dashboard's inline rules; stock.html
     never used help() before, so these were missing and the tip leaked as text */
  .help { display: inline-flex; align-items: center; justify-content: center;
          width: 15px; height: 15px; border-radius: 50%; border: 1px solid var(--muted);
          color: var(--muted); font-size: 10px; font-weight: 600; cursor: help;
          position: relative; vertical-align: middle; margin-left: 5px; flex: none; }
  .help .tip { display: none; position: absolute; bottom: 140%; left: 50%;
               transform: translateX(-50%); width: 290px;
               background: var(--panel); border: 1px solid var(--line);
               padding: 9px 11px; border-radius: 8px;
               z-index: 60; font-size: 12px; line-height: 1.45; color: var(--text);
               text-align: left; font-weight: 400; text-transform: none;
               letter-spacing: normal; box-shadow: var(--popover-shadow);
               pointer-events: none; white-space: normal; }
  .help:hover .tip { display: block; }
  .help.edge-left .tip { left: 0; right: auto; transform: none; }
  /* ---- fundamentals suite (Phase 1) ---- */
  .arch { display:inline-flex; align-items:center; gap:5px; padding:3px 11px; border-radius:11px;
          font-size:12.5px; font-weight:700; cursor:help; border:1px solid var(--line); white-space:nowrap; }
  .arch.a-quality_compounder { background:color-mix(in srgb,var(--up) 16%,transparent); color:var(--up);
          border-color:color-mix(in srgb,var(--up) 40%,transparent); }
  .arch.a-dividend_defensive { background:color-mix(in srgb,var(--link) 16%,transparent); color:var(--link);
          border-color:color-mix(in srgb,var(--link) 40%,transparent); }
  .arch.a-deep_value { background:color-mix(in srgb,var(--g-cold) 16%,transparent); color:var(--g-cold);
          border-color:color-mix(in srgb,var(--g-cold) 40%,transparent); }
  .arch.a-high_beta_momentum { background:color-mix(in srgb,var(--warn) 18%,transparent); color:var(--warn);
          border-color:color-mix(in srgb,var(--warn) 45%,transparent); }
  .arch.a-speculative_unprofitable { background:color-mix(in srgb,var(--down) 16%,transparent); color:var(--down);
          border-color:color-mix(in srgb,var(--down) 40%,transparent); }
  .arch.a-mixed { background:var(--panel2); color:var(--muted); }
  .glance { display:flex; flex-wrap:wrap; gap:8px; margin:8px 0 2px; }
  .gchip { padding:5px 11px; border-radius:9px; background:var(--panel2); border:1px solid var(--line);
           font-size:12px; line-height:1.35; min-width:92px; }
  .gchip .gk { color:var(--muted); display:block; font-size:10px; text-transform:uppercase; letter-spacing:.05em; }
  .gchip .gv { font-weight:700; font-size:14px; }
  .gchip.dashed { border-style:dashed; opacity:.7; }
  .chips { display:flex; flex-wrap:wrap; gap:6px; }
  .chip { padding:3px 9px; border-radius:8px; background:var(--panel2); border:1px solid var(--line); font-size:12px; }
  .srcline { color:var(--muted); font-size:11px; margin:8px 0 0; }
  .stub { color:var(--muted); font-size:13px; padding:11px 13px; border-radius:8px;
          background:var(--panel2); border:1px dashed var(--line); }
  .valbar { display:grid; grid-template-columns:148px 72px 1fr; gap:10px; align-items:center; margin:6px 0; }
  .valbar .vlab { color:var(--muted); font-size:12.5px; }
  .valbar .vval { font-weight:700; font-size:13.5px; text-align:right; }
  .vtrack { position:relative; height:9px; border-radius:5px; background:var(--panel2); }
  .vfill { position:absolute; top:0; left:0; bottom:0; border-radius:5px; }
  .vmed { position:absolute; top:-3px; bottom:-3px; width:2px; background:var(--text); opacity:.55; }
  .finrow { display:grid; grid-template-columns:1fr auto 66px; gap:10px; align-items:center;
            padding:5px 0; border-bottom:1px solid var(--line); font-size:13px; }
  .finrow .flab { color:var(--muted); }
  .finrow .fval { font-weight:700; }
  .finrow .fchg { font-size:12px; text-align:right; }
  .spark { vertical-align:middle; margin-left:6px; }
  .facwrap { display:flex; gap:18px; flex-wrap:wrap; align-items:center; }
  .radarbox { flex:0 0 auto; }
  .zbars { flex:1; min-width:240px; }
  .zrow { display:grid; grid-template-columns:108px 1fr; gap:8px; align-items:center; margin:3px 0; font-size:12px; }
  .zrow .zlab { color:var(--muted); }
  .ztrack { position:relative; height:8px; background:var(--panel2); border-radius:4px; }
  .zmid { position:absolute; left:50%; top:-2px; bottom:-2px; width:1px; background:var(--line); }
  .zfill { position:absolute; top:0; bottom:0; border-radius:4px; }
  .twocol { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:560px){ .twocol{ grid-template-columns:1fr; } .valbar{ grid-template-columns:120px 60px 1fr; } }
  .posbox h3 { font-size:11.5px; color:var(--muted); margin:0 0 6px; text-transform:uppercase; letter-spacing:.05em; }
  .kv { display:flex; justify-content:space-between; gap:10px; font-size:13px; padding:4px 0; border-bottom:1px solid var(--line); }
  .kv .kvk { color:var(--muted); } .kv .kvv { font-weight:700; }
  .grade { display:inline-block; min-width:18px; text-align:center; padding:1px 7px; border-radius:7px; font-weight:800; }
</style>
</head>
