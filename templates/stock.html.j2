    }).then(render).catch(function () {
      document.getElementById('result').style.display = 'block';
      document.getElementById('r_name').textContent = t;
      document.getElementById('r_state').textContent = L('notlib');
      document.getElementById('r_state').className = 'state';
      document.getElementById('r_entry').style.display = 'none';
      document.getElementById('r_points').innerHTML = '';
      document.getElementById('r_cyclebox').innerHTML = L('notlibmsg');
      hideFundamentals();
    });
  }

  function render(d) {
    document.getElementById('result').style.display = 'block';
    document.getElementById('r_name').textContent = d.name + ' (' + d.ticker + ')';
    var st = document.getElementById('r_state');
    st.textContent = dlabel(d.ladder.state) || d.ladder.label;
    st.className = 'state st-' + d.ladder.state.replace(/ /g, '_');
    document.getElementById('r_summary').textContent = lz(d.ladder.summary_line, d.ladder.summary_line_zh);
    document.getElementById('r_asof').textContent = L('asof') + ' ' + d.asof;

    var e = d.ladder.entry || {};
    var eb = document.getElementById('r_entry');
    eb.style.display = 'flex';
    eb.className = 'entrybar urg-' + (e.urgency || 'hold');
    document.getElementById('r_tag').textContent = e.tag || '';
    document.getElementById('r_entrytext').textContent = lz(e.text, e.text_zh);

    var ageEl = document.getElementById('r_age');
    if (d.ladder.age_line) {
      ageEl.textContent = lz(d.ladder.age_line, d.ladder.age_line_zh);
      ageEl.style.display = 'block';
    } else { ageEl.style.display = 'none'; }

    var eqEl = document.getElementById('r_eq');
    if (d.ladder.eq_badge) {
      var grade = lang() === 'zh' ? (d.ladder.eq_grade_zh || d.ladder.eq_grade) : d.ladder.eq_grade;
      eqEl.innerHTML = (lang() === 'zh' ? '入场 ' : 'Entry ') + d.ladder.eq_badge +
                       ' <span class="eqg">' + grade + '</span>';
      eqEl.className = 'eqbadge eq-' + (d.ladder.eq_dir || 'flat');
      eqEl.title = lz(d.ladder.eq_tip, d.ladder.eq_tip_zh);
      eqEl.style.display = 'inline-flex';
    } else { eqEl.style.display = 'none'; }

    var pts = (lang() === 'zh' && d.ladder.points_zh && d.ladder.points_zh.length)
      ? d.ladder.points_zh : (d.ladder.points || []);
    document.getElementById('r_points').innerHTML =
      pts.map(function (p) { return '<li>' + p + '</li>'; }).join('');

    var cp = d.ladder.cycle_plain || {};
    var reg = d.ladder.regime || 'neutral';
    var regEmoji = reg === 'bear' ? '🔻' : reg === 'bull' ? '🟢' : '⚪';
    var cyc = '';
    if (d.ladder.regime_line)
      cyc += '<div class="regline rl-' + reg + '"><b>' + regEmoji + ' ' +
             lz(d.ladder.regime_line, d.ladder.regime_line_zh) + '</b></div>';
    cyc += '<div><b>📅 ' + lz(cp.daily_line, cp.daily_line_zh) + '</b> — ' + lz(cp.daily_phase, cp.daily_phase_zh) + '</div>';
    if (cp.weekly_line) cyc += '<div><b>🗓 ' + lz(cp.weekly_line, cp.weekly_line_zh) + '</b> — ' + lz(cp.weekly_phase, cp.weekly_phase_zh) + '</div>';
    if (cp.translation) cyc += '<div class="muted">' + lz(cp.translation, cp.translation_zh) + '</div>';
    if (d.season_this) cyc += '<div class="muted">' + L('season') + ' — ' + d.season_this +
      (d.season_next ? '; ' + d.season_next : '') + '.</div>';
    document.getElementById('r_cyclebox').innerHTML = cyc;

    var early = document.getElementById('r_early');
    if (d.ladder.early_note) { early.textContent = lz(d.ladder.early_note, d.ladder.early_note_zh); early.style.display = 'block'; }
    else { early.style.display = 'none'; }

    document.getElementById('r_flags').textContent = d.cycle.failed_cycle ? L('failed') : '';
    document.getElementById('r_why').textContent = lz(d.ladder.why, d.ladder.why_zh) + ' ' + L('next') + ' ' + lz(d.ladder.next, d.ladder.next_zh);
    window.renderMTF(document.getElementById('r_mtf'), d.mtf);

    var cs = '<tr><th>' + L('th_state') + '</th><th>' + L('th_n') + '</th><th>' + L('th_up') +
             '</th><th>' + L('th_avg') + '</th><th>' + L('th_dipm') + '</th><th>' + L('th_dipb') + '</th></tr>';
    if (cal) {
      Object.keys(cal).forEach(function (s) {
        var v = cal[s];
        var dipMed = v.dd_med_pct != null ? v.dd_med_pct + '%' : '—';
        var dipBad = v.dd_p10_pct != null ? v.dd_p10_pct + '%' : '—';
        cs += '<tr><td><span class="state st-' + s.replace(/ /g, '_') + '">' + disp(s) + '</span></td><td>' +
              v.n + '</td><td>' + v.hit_pct + '%</td><td class="' +
              (v.avg_fwd_pct > 0 ? 'pos' : 'neg') + '">' + v.avg_fwd_pct + '%</td>' +
              '<td class="neg">' + dipMed + '</td><td class="neg">' + dipBad + '</td></tr>';
      });
    }
    document.getElementById('r_cal').innerHTML = cs;

    renderFundamentals(d);

    document.getElementById('tvbox').innerHTML = '<div id="tvchart"></div>';
    try {
      new TradingView.widget({container_id: 'tvchart', symbol: d.ticker.replace('-USD', 'USD'),
        interval: 'D', theme: (localStorage.getItem('theme') === 'light' ? 'light' : 'dark'),
        style: '1', height: 430, width: '100%',
        hide_side_toolbar: true, allow_symbol_change: true,
        studies: ['RSI@tv-basicstudies', 'MACD@tv-basicstudies']});
    } catch (e) { /* chart is garnish — analysis above stands alone */ }
  }
  // recolor visuals when the theme flips
  document.addEventListener('themechange', function () {
    var h = (location.hash || '').slice(1);
    if (h) load(decodeURIComponent(h));
  });
  // re-render scaffolding + labels in the new language when it flips
  document.addEventListener('langchange', function () {
    var h = (location.hash || '').slice(1);
    if (h) load(decodeURIComponent(h));
  });
  // the nav search bar (theme.js) drives navigation via the hash; on open, render
  // whatever's deep-linked (e.g. stock.html#AAPL)
  fromHash();
})();
</script>
<script src="mtf.js"></script>
<script src="theme.js"></script>
<p class="muted" style="font-size:12px">Generated {{ generated_utc }} UTC · charts by TradingView ·
methodology &amp; caveats: see any sector page footer.</p>
<footer class="site-footer">
  <span class="made">Made with ❤️ in Canada</span>
  <span class="dev">Developed by Chris Wong</span>
</footer>
</body>
