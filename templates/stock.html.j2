  <div class="panel">
    <div class="topline">
      <h1>🔎 {{ t('Stock analyzer', '个股分析') }}</h1>
    </div>
    <p class="muted" style="margin:8px 0 0">{{ t('Search any stock, ETF, commodity or crypto in the bar above to analyze it — the same treatment as the sector pages: cycle position (daily + weekly), three-timeframe momentum, a clear entry/exit call, and the measured track record.',
      '在上方搜索栏输入任意股票、ETF、大宗商品或加密货币即可分析 — 与板块页面相同：周期位置（日线＋周线）、三周期动量、明确的进出场判断，以及实测历史表现。') }}</p>
  </div>

  <div id="result">
    <div class="panel">
      <div class="topline">
        <h1 id="r_name"></h1>
        <span id="r_state" class="state"></span>
        <span id="r_eq" class="eqbadge" style="display:none"></span>
        <span id="r_archetype" class="arch" style="display:none"></span>
        <span style="flex:1"></span>
        <span id="r_asof" class="muted"></span>
      </div>
      <p id="r_summary" class="muted" style="margin:2px 0 6px; font-size:13.5px"></p>
      <div id="r_glance" class="glance" style="display:none"></div>
      <div id="r_entry" class="entrybar"><span class="entrytag" id="r_tag"></span><span id="r_entrytext"></span></div>
      <p id="r_age" class="agewhen" style="display:none"></p>
      <p id="r_early" class="early" style="display:none"></p>
      <ul id="r_points" class="points"></ul>
      <div id="r_cyclebox" class="cyclebox"></div>
      <p id="r_flags" class="neg" style="margin:4px 0"></p>
      <details><summary>{{ t('full reasoning', '完整推理') }}</summary><p class="muted" id="r_why" style="margin:6px 0"></p></details>
    </div>

    <!-- ===== Fundamentals suite (Phase 1: surface what we already compute) ===== -->
    <div class="panel" id="panel_profile" style="display:none">
      <h2>🏢 {{ t('Business profile', '公司概况') }}</h2>
      <p id="r_profile_desc" style="margin:0 0 8px"></p>
      <div id="r_profile_chips" class="chips"></div>
      <p id="r_profile_src" class="srcline"></p>
    </div>

    <div class="panel" id="panel_val" style="display:none">
      <h2>💲 {{ t('Valuation', '估值') }}
        {{ help('Trailing multiples from the latest SEC filing divided by the current price. The bar shows how cheap or expensive the name is versus its own GICS sector (green = cheaper, marker = sector median). Forward P/E is only available for a deep set of large caps; every other name shows trailing only — we never impute a forward number.',
          '历史估值倍数＝最新SEC财报÷当前股价。条形显示相对其所属行业的便宜或昂贵程度（绿色＝更便宜，标记＝行业中位）。前瞻市盈率仅对部分大盘股可得，其余仅显示历史值——我们绝不臆造前瞻数字。') }}</h2>
      <div id="r_valbars"></div>
      <p id="r_val_fwd" style="margin-top:8px; font-size:12.5px"></p>
    </div>

    <div class="panel" id="panel_fin" style="display:none">
      <h2>📊 {{ t('Financials &amp; growth', '财务与增长') }}
        {{ help('From SEC EDGAR XBRL (latest fiscal year, lagged to the filing date). Margins and returns are point-in-time; growth is year-over-year where a prior-year figure exists. Multi-year trends, the Piotroski F-score and the Altman Z-score arrive in Phase 2 (SEC companyfacts).',
          '来自SEC EDGAR XBRL（最新财年，滞后至申报日）。利润率与回报为时点值；在有上年数据时显示同比增长。多年趋势、Piotroski F分数与Altman Z分数将在第二阶段（SEC companyfacts）加入。') }}</h2>
      <div id="r_finrows"></div>
      <details><summary>{{ t('more metrics &amp; financial health', '更多指标与财务健康') }}</summary>
        <div id="r_finmore" style="margin-top:6px"></div>
      </details>
    </div>

    <div class="panel" id="panel_earn" style="display:none">
      <h2>📅 {{ t('Earnings', '财报') }}</h2>
      <div id="r_earn"></div>
    </div>

    <div class="panel" id="panel_fac" style="display:none">
      <h2>🧬 {{ t('Factor fingerprint', '因子指纹') }}
        {{ help('Where this name sits on the canonical smart-beta factors versus the S&P 1500 cross-section (winsorized z-scores; 0 = average, +2 = top of the pack, bars right of centre = attractive). These are RELATIVE RANKS lagged to the latest filing — context, not a validated alpha and not a quality verdict.',
          '该标的在标普1500横截面上各经典smart-beta因子的位置（缩尾z分数；0＝平均，+2＝领先，条形位于中线右侧＝有吸引力）。这些是滞后至最新财报的相对排名——仅供参考，并非已验证的超额收益或质量结论。') }}</h2>
      <div class="facwrap">
        <div id="r_radar" class="radarbox"></div>
        <div id="r_zbars" class="zbars"></div>
      </div>
      <p id="r_fac_score" class="muted" style="margin-top:8px; font-size:12.5px"></p>
    </div>

    <div class="panel" id="panel_gex" style="display:none">
      <h2>🎯 {{ t('Options &amp; dealer gamma (GEX)', '期权与做市商Gamma') }}</h2>
      <div id="r_gex"></div>
    </div>

    <div class="panel" id="panel_pos" style="display:none">
      <h2>🩳 {{ t('Positioning', '持仓与做空') }}
        {{ help('Short interest from FINRA (bi-monthly, ~2-week lag). Insider net buying/selling from SEC Form-4 filings. Heavy or rising short interest with insider selling is a caution; insider buying is the higher-conviction signal.',
          '做空数据来自FINRA（每半月，约两周滞后）。内部人净买卖来自SEC Form-4申报。高或上升的做空＋内部人卖出为警示；内部人买入是更高确信度的信号。') }}</h2>
      <div id="r_pos" class="twocol"></div>
    </div>

    <div class="panel" id="panel_analyst" style="display:none">
      <h2>👔 {{ t('Analyst &amp; estimates', '分析师与预期') }}</h2>
      <div id="r_analyst"></div>
    </div>

    <div class="panel">
      <h2>{{ t('Momentum across timeframes', '跨周期动量') }}</h2>
      <div id="r_mtf"></div>
    </div>
    <div class="panel">
      <h2>{{ t('Chart', '图表') }}</h2>
      <div id="tvbox"></div>
    </div>
    <div class="panel">
      <h2>{{ t('How much to trust the state — measured 2000→2026', '这个状态有多可信 — 实测 2000→2026') }}</h2>
      <table id="r_cal"></table>
      <p class="muted" style="font-size:12px; margin-top:8px">{{ t(
        'Stocks drift up over a month from
        every state (the market\'s long upward bias); the spread between states is small, and the
        "scary" states measured slightly better forward returns — markets mean-revert and full
        confirmation costs part of the bounce. Use the state for <b>structure</b> (cycle position,
        confirmation checklist, invalidation level) and size positions instead of seeking certainty.
        <b>Typical dip</b> = the median worst drop over the next month; <b>bad-case dip</b> = the
        worst 1-in-10 month (10th percentile) — the drawdown lens matters more than average return for
        risk states like COUNTER-TREND BOUNCE, since the danger is the path, not the endpoint. (Measured
        on equities at a 1-month horizon — crypto tails are fatter, so treat these as a floor on the risk.)',
        '从任何状态出发，股票在一个月内都倾向于上涨（市场长期向上的偏向）；各状态之间的差距很小，而那些
        "吓人"的状态实测前瞻收益反而略好 — 市场会均值回归，等到完全确认时已错过部分反弹。请把状态用于
        <b>结构判断</b>（周期位置、确认清单、失效价位）并据此控制仓位，而非追求确定性。
        <b>典型回撤</b> = 未来一个月最大跌幅的中位数；<b>最坏回撤</b> = 十分之一的最差月份（第10百分位）—
        对于逆势反弹这类风险状态，回撤视角比平均收益更重要，因为危险在于过程，而非终点。（基于股票的一个月
        周期实测 — 加密货币的尾部更肥，故请将其视为风险下限。）') }}</p>
    </div>
  </div>

<script src="https://s3.tradingview.com/tv.js"></script>
<script>
(function () {
  var cal = null;  // calibration table data (the nav search bar drives navigation now)
  // language-aware micro-strings for the JS-rendered scaffolding (the deep
  // per-stock analysis prose comes from the nightly JSON and stays English)
  function lang() { return document.documentElement.getAttribute('data-lang') || 'en'; }
  var T = {
    en: { asof: 'data through', notlib: 'NOT IN LIBRARY',
          notlibmsg: 'Not in the nightly library (S&P 500 + tracked ETFs/commodities/crypto). Add it in one line: config.yml → stock_search.extra_tickers.',
          season: 'Seasonality', failed: '⚠ Failed cycle — price is below the low that started this cycle; the larger trend is usually rolling over.',
          next: 'Next:', cu: ' just crossed up', cd: ' just crossed down',
          bullx: ' bars to bull cross', bearx: ' bars to bear cross',
