<script>
/* Anticipation panel — additive; fetches anticipationdata/<ticker>.json (watchlist/
   sectors/index for now), renders a compact forward-outcome cone. Graceful 404. */
(function(){
  var panel=document.getElementById('panel_anticipation'); if(!panel) return;
  function safeT(t){return String(t).replace(/[=^]/g,'_');}
  function T(en,zh){return '<span class="l-en">'+en+'</span><span class="l-zh">'+(zh||en)+'</span>';}
  function f1(x){return (x==null||isNaN(x))?'—':Math.round(x*10)/10;}
  function pct(x){return (x==null||isNaN(x))?'—':((x>=0?'+':'')+f1(x)+'%');}
  var HN=['short','medium','long'];
  function Y(r,lo,hi,top,bot){return top+(hi-r)/(hi-lo)*(bot-top);}
  function cone(a){
    var hs=HN.map(function(n){return [n,a.horizons[n]];}).filter(function(p){return p[1]&&p[1].ret_q;});
    if(!hs.length) return '';
    var lo=0,hi=0; hs.forEach(function(p){var q=p[1].ret_q;lo=Math.min(lo,q.p5);hi=Math.max(hi,q.p95);});
    lo*=1.08;hi*=1.08; if(hi-lo<8){hi+=4;lo-=4;}
    var top=24,bot=208,X={},xs=[210,410,628]; hs.forEach(function(p,i){X[p[0]]=xs[i]||(210+i*140);});
    var y0=Y(0,lo,hi,top,bot);
    function ed(k){var s='M64,'+y0;hs.forEach(function(p){s+=' L'+X[p[0]]+','+Y(p[1].ret_q[k],lo,hi,top,bot);});return s;}
    function rv(k){var s='';for(var i=hs.length-1;i>=0;i--){s+=' L'+X[hs[i][0]]+','+Y(hs[i][1].ret_q[k],lo,hi,top,bot);}return s+' L64,'+y0;}
    var lab='<text x="64" y="226" style="fill:var(--muted)" font-size="11">'+T('now','现在')+'</text>';
    hs.forEach(function(p){var m=p[1].range_td||[];var nm={short:'short',medium:'medium',long:'long'}[p[0]],nz={short:'短期',medium:'中期',long:'长期'}[p[0]];
      lab+='<text x="'+X[p[0]]+'" y="226" text-anchor="middle" style="fill:var(--text)" font-size="11">'+T(nm,nz)+' '+(m[0]||'')+'–'+(m[1]||'')+'d</text>';});
    return '<svg viewBox="0 0 680 238" style="width:100%;height:auto;display:block" role="img" aria-label="forward outcome cone">'+
      '<line x1="56" y1="'+y0+'" x2="650" y2="'+y0+'" style="stroke:var(--muted)" stroke-width="1" stroke-dasharray="1 4"/>'+
      '<path d="'+ed('p95')+rv('p75')+' Z" fill="#888780" fill-opacity="0.10"/>'+
      '<path d="'+ed('p75')+rv('p25')+' Z" fill="#888780" fill-opacity="0.20"/>'+
      '<path d="'+ed('p25')+rv('p5')+' Z" fill="#E24B4A" fill-opacity="0.18"/>'+
      '<path d="'+ed('p50')+'" fill="none" style="stroke:var(--text)" stroke-width="1.3" stroke-dasharray="5 4"/>'+lab+'</svg>';
  }
  var BANDWORD={calm:['low','低'],elevated:['moderate','中等'],high:['high','偏高'],extreme:['very high','很高']};
  var BANDCLS={calm:'ap-b-calm',elevated:'ap-b-elev',high:'ap-b-high',extreme:'ap-b-ext'};
  var LEGLAB={real_rate:['real rates','实际利率'],beta_real_rate:['real-rate exposure','实际利率敞口'],
    copper_gold:['copper/gold cyclical impulse','铜金周期脉冲'],vrp:['volatility risk premium','波动风险溢价'],
    tsmom:['trend','趋势'],credit:['credit spreads','信用利差'],credit_vel:['credit-spread velocity','信用利差速度'],
    term:['yield curve','收益率曲线'],netliq:['net liquidity','净流动性'],anfci:['financial conditions','金融条件'],
    oil_mom:['oil momentum','油价动量'],dollar:['the US dollar','美元'],gold:['gold','黄金'],
    oil_vrp:['oil variance premium','油价方差溢价'],mtg:['mortgage rates','按揭利率'],
    steepen_vel:['curve-steepening velocity','曲线陡峭化速度'],slope_x_credit:['curve×credit','曲线×信用'],
    rr_x_growth:['real-rate×growth','实际利率×增长'],rr_x_gold:['real-rate×gold','实际利率×黄金'],
    oil_x_dollar:['oil×dollar','油价×美元']};
  function legName(h){ if(!h.dir_legs||!h.dir_legs.length) return null; return LEGLAB[h.dir_legs[0]]||[h.dir_legs[0],h.dir_legs[0]]; }
  function show(a){
    var bw=BANDWORD[a.index_band]||['n/a','—'], bc=BANDCLS[a.index_band]||'ap-b-elev';
    document.getElementById('ant_sub').innerHTML=
      '<span class="ap-badge '+bc+'">'+T('Stretch/Fragility','拉伸/脆弱度')+' '+(a.anticipation_index!=null?Math.round(a.anticipation_index):'—')+'/100 · '+T(bw[0],bw[1])+'</span>'+
      (a.macro?'<span class="ap-chip">'+T('market stress','市场压力')+' '+Math.round(a.macro.stress_pct)+'% · '+T('widens cone','加宽锥体')+' ×'+a.macro.width_mult+'</span>':'');
    document.getElementById('ant_cone').innerHTML=cone(a);
    document.getElementById('ant_legend').innerHTML=
      '<span class="dir-up">▲ '+T('up-lean','偏多')+'</span> · <span class="dir-flip">▬ '+T('coin-flip','抛硬币')+'</span> · <span class="dir-down">▼ '+T('down-lean','偏空')+'</span> — '+
      T('color shows direction <b>only where validated out-of-sample</b>; the cone (range &amp; typical dip) is the validated read.','颜色仅在<b>经样本外验证</b>处显示方向；锥体（区间与常见回撤）为已验证读数。');
    var ch=''; HN.forEach(function(n){var h=a.horizons[n];if(!h)return;var rq=h.ret_q||{};
      var nm={short:'Short',medium:'Medium',long:'Long'}[n],nz={short:'短期',medium:'中期',long:'长期'}[n];
      var scored=h.direction_scored;
      var cls=scored?(h.direction==='up-lean'?'up':(h.direction==='down-lean'?'down':'')):'';
      var dcls=scored?(h.direction==='up-lean'?'dir-up':(h.direction==='down-lean'?'dir-down':'dir-flip')):'dir-flip';
      var arrow=(scored&&h.direction==='up-lean')?'▲':((scored&&h.direction==='down-lean')?'▼':'▬');
      var dword=!scored?T('Coin-flip','抛硬币'):(h.direction==='up-lean'?T('Up-lean','偏多'):(h.direction==='down-lean'?T('Down-lean','偏空'):T('Neutral','中性')));
      var pu=Math.round((h.p_up||0.5)*100);
      var pill=scored?'<span class="pill ok">✓ '+T('validated','已验证')+'</span>'
                     :'<span class="pill flip">'+(n==='short'?T('not predictable','不可预测'):T('coin-flip','抛硬币'))+'</span>';
      var ln=legName(h);
      var why=scored?'<div class="why">'+T('driven by','驱动：')+' '+(ln?T(ln[0],ln[1]):T('a validated signal','已验证信号'))+(h.oos_r2!=null?' · R² '+h.oos_r2:'')+'</div>'
                    :'<div class="why">'+T('no validated direction','无已验证方向')+'</div>';
      ch+='<div class="hc '+cls+(h.thin?' thin':'')+'">'+
        '<div class="hk">'+T(nm,nz)+' '+(h.range_td?h.range_td.join('–'):'')+'d</div>'+
        '<div class="dblock"><div class="dlab">'+T('DIRECTION','方向')+'</div>'+
          '<div class="dirv '+dcls+'">'+arrow+' '+dword+'<span class="pup">'+pu+'%</span></div>'+
          why+pill+'</div>'+
        '<div class="rblock"><div class="rlab">'+T('RISK','风险')+'</div>'+
          '<div class="rv"><span class="neg">'+T('typ dip','常见回撤')+' '+pct(h.dd_avg)+'</span> · <span class="neg">'+T('worst','最坏')+' '+pct(h.dd_tail)+'</span></div>'+
          '<div class="rv2">'+T('median','中位')+' '+pct(rq.p50)+'</div>'+
        '</div></div>';});
    document.getElementById('ant_cards').innerHTML=ch;
    var anyScored=HN.some(function(n){return a.horizons[n]&&a.horizons[n].direction_scored;});
    document.getElementById('ant_note').innerHTML=anyScored
      ? T('Direction is a validated out-of-sample lean (Clark-West) at the marked horizon; short stays a coin-flip. Risk cone p05–p95, downside emphasized. Display-only — not investment advice.','所示方向为标记周期上经验证的样本外倾向（Clark-West）；短期仍为抛硬币。风险锥 p05–p95，强调下行。仅供参考，非投资建议。')
      : T('Risk cone is the validated read; direction here is a measured coin-flip. Cone p05–p95, downside emphasized. Display-only — not investment advice.','风险锥为已验证读数；此处方向为实测抛硬币。锥 p05–p95，强调下行。仅供参考，非投资建议。');
    panel.style.display='';
  }
  function cur(){try{return decodeURIComponent((location.hash||'').replace(/^#/,'')).trim().toUpperCase();}catch(e){return '';}}
  function load(){var t=cur(); if(!t){panel.style.display='none';return;}
    // full universe: the per-stock library JSON carries .anticipation; sectors/index
    // (not in the stock library) fall back to the standalone builder's per-ticker JSON.
    fetch('stockdata/'+safeT(t)+'.json').then(function(r){return r.ok?r.json():null;}).then(function(j){
      if(j&&j.anticipation){ show(j.anticipation); return; }
      return fetch('anticipationdata/'+safeT(t)+'.json').then(function(r){if(!r.ok)throw 0;return r.json();}).then(show);
    }).catch(function(){panel.style.display='none';});}
  window.addEventListener('hashchange',load); load();
})();
</script>
