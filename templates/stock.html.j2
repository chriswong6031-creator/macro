      '<p class="srcline">' + lz(
        'Context on fragility, NOT a sell. This flag is NOT in the conviction score — Phase-0 found crowding carries no forward-return edge (only a marginal, weak worse-drawdown tendency), and short interest has no point-in-time history to validate.',
        '仅作脆弱性背景，而非卖出信号。该标记不计入信念评分 —— Phase-0 发现拥挤本身没有前瞻收益优势（仅有边际且微弱的更深回撤倾向），且空头数据没有可供验证的时点历史。') + '</p>';
    show('panel_fragility', true);
  }

  function renderSmartMoney(d) {
    var s = d && d.smart_money;
    var hold = (s && s.holders) || [];
    if (!hold.length) { show('panel_smartmoney', false); return; }
    var R = ' style="text-align:right"';
    var head = '<p class="srcline" style="margin:0 0 8px">' +
      '<b>' + s.n_holders + '</b> ' + lz('super-investor fund' + (s.n_holders === 1 ? '' : 's') + ' hold this',
        '家超级投资者基金持有') +
      (s.n_buying ? ' · <span class="pos">' + s.n_buying + ' ' + lz('buying', '买入') + '</span>' : '') +
      (s.n_selling ? ' · <span class="neg">' + s.n_selling + ' ' + lz('selling', '卖出') + '</span>' : '') +
      (s.as_of ? ' · ' + lz('as of', '截至') + ' ' + s.as_of : '') + '</p>';
    // Cross-fund VIP / overlap: how many tracked funds currently hold it, the
    // top holder's conviction, and how concentrated that ownership is (HHI).
    var hhi = s.ownership_hhi, conc = '';
    if (hhi != null) conc = (hhi >= 0.5) ? lz('top-heavy (one fund dominates)', '高度集中（单一基金主导）')
      : (hhi <= 0.3) ? lz('broadly held', '广泛持有') : lz('moderately concentrated', '中度集中');
    var vipline = '';
    if (s.vip) vipline = '<p class="srcline" style="margin:-4px 0 10px">' +
      (s.is_vip ? '<span class="chip" style="--c:var(--ok)">★ ' + lz('VIP consensus', 'VIP 共识') + '</span> ' : '') +
      lz('held by ', '由 ') + '<b>' + s.vip + '</b> ' + lz('tracked fund' + (s.vip === 1 ? '' : 's'), '家跟踪基金') +
      (s.max_book_pct != null ? ' · ' + lz('top conviction ', '最高信念 ') + '<b>' + s.max_book_pct + '%</b> ' + lz('of a book', '的组合占比') : '') +
      (conc ? ' · ' + conc : '') + '</p>';
    var th = '<tr><th>' + lz('fund', '基金') + '</th><th>' + lz('action', '动作') +
      '</th><th' + R + '>' + lz('% of portfolio', '组合占比') +
      '</th><th' + R + '>' + lz('Δ shares', '股数Δ') + '</th></tr>';
    var rows = hold.map(function (h) {
      var a = SMA[h.action] || [h.action, h.action, ''];
      var col = a[2] ? ' style="color:var(--' + a[2] + ')"' : ' class="muted"';
      var dir = lz(a[0], a[1]);
      var pct = (h.pct_portfolio == null) ? '—' : Number(h.pct_portfolio).toFixed(1) + '%';
      var chg = (h.shares_change_pct == null) ? (h.action === 'new' ? lz('new', '新') : '—')
        : (h.shares_change_pct >= 0 ? '+' : '') + Number(h.shares_change_pct).toFixed(0) + '%';
      return '<tr><td><b>' + h.fund + '</b> <span class="muted">' + (h.fund_name || '') + '</span></td>' +
        '<td' + col + '>' + dir + '</td>' +
        '<td' + R + '><b>' + pct + '</b></td>' +
        '<td class="muted"' + R + '>' + chg + '</td></tr>';
    }).join('');
    el('r_smartmoney').innerHTML = head + vipline + '<table>' + th + rows + '</table>' +
      '<p class="srcline">' + lz(
        '13F-HR holdings are filed quarterly with a ~45-day lag — a stale, partial picture of long-only US equity stakes ≥ $100M, with no shorts, options detail, or non-US positions. CUSIPs are name-matched to tickers, so some lines may be missing. Context on who holds this, NOT a buy list or a real-time signal.',
        '13F-HR 持仓为季度申报，约有 45 天滞后 —— 仅为美股多头持仓（≥1亿美元）的陈旧且不完整快照，不含空头、期权细节或非美持仓。CUSIP 通过名称匹配到代码，部分行可能缺失。仅作为「谁持有它」的背景，而非买入清单或实时信号。') + '</p>';
    show('panel_smartmoney', true);
  }

  function render(d) {
    document.getElementById('result').style.display = 'block';
    document.getElementById('r_name').textContent = d.name + ' (' + d.ticker + ')';
    if (d.limited) { renderLimited(d); return; }
    // a full record may follow a limited one — re-show the panels it hid
    ['panel_mtf', 'panel_cal'].forEach(function (id) { var e = document.getElementById(id); if (e) e.style.display = ''; });
    var st = document.getElementById('r_state');
    st.textContent = dlabel(d.ladder.state) || d.ladder.label;
    st.className = 'state st-' + d.ladder.state.replace(/ /g, '_');
    document.getElementById('r_summary').textContent = lz(d.ladder.summary_line, d.ladder.summary_line_zh);
    document.getElementById('r_asof').textContent = L('asof') + ' ' + d.asof;

    renderConviction(d);
    renderVerdict(d);
    renderSignalStrip(d);
    renderAlertFeed(d);

    var ageEl = document.getElementById('r_age');
    if (d.ladder.age_line) {
      ageEl.textContent = lz(d.ladder.age_line, d.ladder.age_line_zh);
      ageEl.style.display = 'block';
    } else { ageEl.style.display = 'none'; }

    var eqEl = document.getElementById('r_eq');
    if (d.ladder.eq_badge) {
      var grade = lang() === 'zh' ? (d.ladder.eq_grade_zh || d.ladder.eq_grade) : d.ladder.eq_grade;
      eqEl.innerHTML = (lang() === 'zh' ? '入场 ' : 'Entry ') + d.ladder.eq_badge +
                       ' <span class="eqg">' + grade + '</span>';
      eqEl.className = 'eqbadge eq-' + (d.ladder.eq_dir || 'flat');
      eqEl.title = lz(d.ladder.eq_tip, d.ladder.eq_tip_zh);
      eqEl.style.display = 'inline-flex';
    } else { eqEl.style.display = 'none'; }

    // Bottom Confidence (multi-timeframe) — only on bottoming states
    var bcEl = document.getElementById('r_bc');
    if (d.ladder.bc_score != null && d.ladder.bc_line) {
      var bcg = lang() === 'zh' ? (d.ladder.bc_grade_zh || d.ladder.bc_grade) : d.ladder.bc_grade;
      var bcLbl = lang() === 'zh' ? '底部信心' : 'Bottom confidence';
      var tfHtml = lz(d.ladder.bc_line, d.ladder.bc_line_zh)
        .replace(/✓/g, '<span class="bc-y">✓</span>').replace(/✗/g, '<span class="bc-n">✗</span>');
      // measured historical "cycle-low held" rate for this score's band
      var bcHist = '';
      if (bcCal && bcCal.bands) {
        var bnd = bcCal.bands[bcBand(d.ladder.bc_score)];
        if (bnd && bnd.held_pct != null) {
          bcHist = '<div class="bc-hist">📊 ' + (lang() === 'zh'
            ? '历史上该档位守住周期低点约 ' + bnd.held_pct + '%（21日）'
            : 'Historically this band held the cycle low ~' + bnd.held_pct + '% of the time (21d)') + '</div>';
        }
      }
      // Phase 2 — knife-risk caution when deeply washed out below the 200-day
      var bcKnife = '';
      if (d.ladder.bc_knife) {
        bcKnife = '<div class="bc-knife bc-knife-' + d.ladder.bc_knife + '">' +
          lz(d.ladder.bc_knife_line, d.ladder.bc_knife_line_zh) + '</div>';
      }
      bcEl.className = 'bcbox bc-' + (d.ladder.bc_grade || 'minimal');
      bcEl.innerHTML =
        '<div class="bc-head"><span class="bc-ttl">🎯 ' + bcLbl + '</span>' +
        '<span class="bc-score ' + 'bcg-' + (d.ladder.bc_grade || 'minimal') + '">' +
        d.ladder.bc_score + '<span class="bc-max">/100</span></span>' +
        '<span class="bc-grade">' + bcg + '</span></div>' +
        '<div class="bc-tf">' + tfHtml + '</div>' + bcHist + bcKnife;
      bcEl.title = lz(d.ladder.bc_tip, d.ladder.bc_tip_zh);
      bcEl.style.display = 'block';
    } else { bcEl.style.display = 'none'; }

    var pts = (lang() === 'zh' && d.ladder.points_zh && d.ladder.points_zh.length)
      ? d.ladder.points_zh : (d.ladder.points || []);
    document.getElementById('r_points').innerHTML =
      pts.map(function (p) { return '<li>' + p + '</li>'; }).join('');

    var cp = d.ladder.cycle_plain || {};
    var reg = d.ladder.regime || 'neutral';
    var regEmoji = reg === 'bear' ? '🔻' : reg === 'bull' ? '🟢' : '⚪';
    var cyc = '';
    if (d.ladder.regime_line)
      cyc += '<div class="regline rl-' + reg + '"><b>' + regEmoji + ' ' +
             lz(d.ladder.regime_line, d.ladder.regime_line_zh) + '</b></div>';
    cyc += '<div><b>📅 ' + lz(cp.daily_line, cp.daily_line_zh) + '</b> — ' + lz(cp.daily_phase, cp.daily_phase_zh) + '</div>';
    if (cp.weekly_line) cyc += '<div><b>🗓 ' + lz(cp.weekly_line, cp.weekly_line_zh) + '</b> — ' + lz(cp.weekly_phase, cp.weekly_phase_zh) + '</div>';
    if (cp.translation) cyc += '<div class="muted">' + lz(cp.translation, cp.translation_zh) + '</div>';
    if (d.season_this) cyc += '<div class="muted">' + L('season') + ' — ' + lz(d.season_this, d.season_this_zh) +
      (d.season_next ? '; ' + lz(d.season_next, d.season_next_zh) : '') + '.</div>';
    document.getElementById('r_cyclebox').innerHTML = cyc;

    var early = document.getElementById('r_early');
    if (d.ladder.early_note) { early.textContent = lz(d.ladder.early_note, d.ladder.early_note_zh); early.style.display = 'block'; }
    else { early.style.display = 'none'; }
    var macro = document.getElementById('r_macro');
    if (d.ladder.macro_line) { macro.textContent = '⚠ ' + lz(d.ladder.macro_line, d.ladder.macro_line_zh); macro.style.display = 'block'; }
    else { macro.style.display = 'none'; }
    renderMacroSens(d);

    document.getElementById('r_flags').textContent = d.cycle.failed_cycle ? L('failed') : '';
    document.getElementById('r_why').textContent = lz(d.ladder.why, d.ladder.why_zh) + ' ' + L('next') + ' ' + lz(d.ladder.next, d.ladder.next_zh);
    window.renderMTF(document.getElementById('r_mtf'), d.mtf);

    var cs = '<tr><th>' + L('th_state') + '</th><th>' + L('th_n') + '</th><th>' + L('th_up') +
             '</th><th>' + L('th_avg') + '</th><th>' + L('th_dipm') + '</th><th>' + L('th_dipb') + '</th></tr>';
    if (cal) {
      Object.keys(cal).forEach(function (s) {
        var v = cal[s];
        var dipMed = v.dd_med_pct != null ? v.dd_med_pct + '%' : '—';
        var dipBad = v.dd_p10_pct != null ? v.dd_p10_pct + '%' : '—';
        cs += '<tr><td><span class="state st-' + s.replace(/ /g, '_') + '">' + disp(s) + '</span></td><td>' +
              v.n + '</td><td>' + v.hit_pct + '%</td><td class="' +
              (v.avg_fwd_pct > 0 ? 'pos' : 'neg') + '">' + v.avg_fwd_pct + '%</td>' +
              '<td class="neg">' + dipMed + '</td><td class="neg">' + dipBad + '</td></tr>';
      });
    }
    document.getElementById('r_cal').innerHTML = cs;

    renderFundamentals(d);
    renderFundFlow(d);
    renderAlpha(d);
    renderFragility(d);
    renderSmartMoney(d);

    tvLoad(d);
  }

  // TradingView chart loader, shared by the full and limited views. Yahoo encodes
  // US share classes with a dash (BRK-B); TradingView uses a dot (BRK.B), and a
  // bare "BRK-B" resolves to a colliding TSX income-strategy ETF. Pin the known
  // US class-shares to NYSE; otherwise convert the trailing class-dash to a dot.
  // Crypto keeps its -USD -> USD mapping.
  function tvLoad(d) {
    document.getElementById('tvbox').innerHTML = '<div id="tvchart"></div>';
    var TV_FIX = {'BRK-A': 'NYSE:BRK.A', 'BRK-B': 'NYSE:BRK.B', 'BF-A': 'NYSE:BF.A',
      'BF-B': 'NYSE:BF.B', 'CWEN-A': 'NYSE:CWEN.A', 'MOG-A': 'NYSE:MOG.A',
      'HEI-A': 'NYSE:HEI.A', 'LEN-B': 'NYSE:LEN.B'};
    var tvsym = TV_FIX[d.ticker] || (d.ticker.indexOf('-USD') >= 0
      ? d.ticker.replace('-USD', 'USD') : d.ticker.replace(/-([A-Z])$/, '.$1'));
    try {
      new TradingView.widget({container_id: 'tvchart', symbol: tvsym,
        interval: 'D', theme: (localStorage.getItem('theme') === 'light' ? 'light' : 'dark'),
        style: '1', height: 430, width: '100%',
        hide_side_toolbar: true, allow_symbol_change: true,
        studies: ['RSI@tv-basicstudies', 'MACD@tv-basicstudies']});
    } catch (e) { /* chart is garnish — analysis above stands alone */ }
  }

  // A brand-new listing (a days-old IPO like SPCX) has no computable cycle ladder
  // yet. Rather than hide it, show an honest limited card: identity + a "too new"
  // banner + the live chart. Mirrors load()'s not-in-library reset so no stale
  // analysis from a previously-viewed ticker leaks through.
  function renderLimited(d) {
    var st = document.getElementById('r_state');
    st.textContent = lang() === 'zh' ? '历史不足' : 'LIMITED';
    st.className = 'state';
    document.getElementById('r_asof').textContent = L('asof') + ' ' + d.asof;
    document.getElementById('r_summary').textContent = '';
    document.getElementById('r_verdict').innerHTML = '';
    document.getElementById('r_sigstrip').innerHTML = '';
    document.getElementById('r_points').innerHTML = '';
    document.getElementById('r_flags').textContent = '';
    document.getElementById('r_why').textContent = '';
    ['r_eq', 'r_bc', 'r_age', 'r_early', 'r_macro', 'r_macrosens', 'r_archetype', 'r_glance', 'r_afbtn', 'panel_mtf', 'panel_cal']
      .forEach(function (id) { var e = document.getElementById(id); if (e) e.style.display = 'none'; });
    if (afCtl) afCtl.close();
    hideFundamentals();
    var n = d.history_days || 0;
    var msg = lz(
      'New listing — first traded ' + d.listed + ', only ' + n + ' session' + (n === 1 ? '' : 's') +
      ' of history. The cycle & momentum model needs ~1 year, so the full read unlocks as data accrues. Live price chart below.',
      '新上市 —— 首个交易日 ' + d.listed + '，目前仅有 ' + n + ' 个交易日。周期与动量模型需约一年历史，完整解读将随数据积累解锁。下方为实时价格图。');
    document.getElementById('r_cyclebox').innerHTML = '<div class="cyclebox">🆕 ' + esc(msg) + '</div>';
    tvLoad(d);
  }
  // recolor visuals when the theme flips
  document.addEventListener('themechange', function () {
    var h = (location.hash || '').slice(1);
    if (h) load(decodeURIComponent(h));
  });
  // re-render scaffolding + labels in the new language when it flips
  document.addEventListener('langchange', function () {
    var h = (location.hash || '').slice(1);
    if (h) load(decodeURIComponent(h));
  });
  // the nav search bar (theme.js) drives navigation via the hash; on open, render
  // whatever's deep-linked (e.g. stock.html#AAPL)
  fromHash();
})();
</script>
