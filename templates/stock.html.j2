  function radarSVG(radar) {
    var cx = 80, cy = 80, R = 56, N = 6;
    var labs = { value:['Val','价值'], profitability:['Prof','盈利'], quality:['Qual','质量'],
                 investment:['Inv','投资'], payout:['Pay','回报'], low_vol:['LoVol','低波'] };
    function pt(i, r) { var a = (-90 + i*360/N) * Math.PI/180; return [cx + r*Math.cos(a), cy + r*Math.sin(a)]; }
    function poly(r) { var p = []; for (var i=0;i<N;i++){ var xy = pt(i,r); p.push(xy[0].toFixed(1)+','+xy[1].toFixed(1)); } return p.join(' '); }
    var g = '<svg class="radar" width="160" height="176" viewBox="0 0 160 176" aria-hidden="true">';
    g += '<polygon points="' + poly(R) + '" fill="none" stroke="var(--line)"/>';
    g += '<polygon points="' + poly(R*0.5) + '" fill="none" stroke="var(--line)" opacity=".55"/>';
