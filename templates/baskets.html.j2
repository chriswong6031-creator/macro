  {% set _tc_tl   = _tc_lead.trailing_leader %}
  {% set _tc_st   = _tc_lead.state %}
  {# Aurora tint class by state #}
  {% set _tc_cls  = 'tc-rotating' if _tc_st == 'rotating' else ('tc-strain' if _tc_st == 'strain' else 'tc-steady') %}
  <div id="theme-context-hero" class="{{ _tc_cls }}">
    <div class="tc-aurora" aria-hidden="true"></div>
    <div class="tc-inner">

      {# ── Top row: H1 + as-of ── #}
