     Idiom = tape band v3 (#2227, operator-ratified): ranked two-column layout,
     ordinals + display names (never slugs), mirrored shared-scale bars, inline
     flow chips when notable, full-tape expander, ONE as-of, one footnote. */
  (function(){
  'use strict';
  function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
  function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c];});}
  function L(en,zh){return'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>';}
  function fmtPct(v){if(v==null)return'—';return(v>=0?'+':'')+v.toFixed(2)+'%';}
  // Disagreement-chip gate (FT-R12): chips only when mode=live (TS-R1).
  // Values (mover chips) are rendered in all modes when a stamped read exists.
  function isChipSuppressed(pulse){
    if(!pulse) return true;
    return (pulse.mode||'live') !== 'live';
  }

  // ── Display names (Law 2: never raw slugs; prettified fallback never blocks render)
  function _slugName(id){return String(id||'').replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});}
  function _theme(id){
    var arr=(window.BASKETS&&window.BASKETS.baskets)||[];
    for(var i=0;i<arr.length;i++){ if(arr[i].id===id) return arr[i]; }
