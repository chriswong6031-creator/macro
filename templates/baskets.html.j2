        <h1 style="font-size:21px;margin:0">🧺 {{ t('Thematic baskets', '主题篮子') }}</h1>
        <span class="asof" style="margin-left:auto"><span class="pfx">{{ t('as of', '截至') }} </span><span id="asof">—</span></span>
      </div>
      <p class="tagline" style="margin:2px 0 10px">{{ t(
        'Equal-weight US theme baskets measured against the S&P 500. Use them to see which themes are leading or fading.',
        '等权重美国主题篮子，对标标普 500。用于观察哪些主题在走强或走弱。') }}</p>
      <p class="story" id="story" style="font-size:14.5px;margin:4px 0 8px;line-height:1.5"></p>

      {# ── Big state line ── #}
      <div style="margin:6px 0 4px">
        <div class="tc-big-state">
          {% if _tc_st == 'rotating' %}{{ t('Money is rotating', '资金正在轮动') }}
          {% elif _tc_st == 'strain' %}{{ t('Leadership under strain', '领涨承压') }}
          {% else %}{{ t('Leadership steady', '领涨格局稳定') }}{% endif %}
        </div>
        <p class="tc-stance-sub">{{ t(_tc_lead.stance_en, _tc_lead.stance_zh) }}</p>
      </div>

      {# ── Context chip row: factor-season + policy-lever + days ── #}
      <div class="tc-chips">
        {# Factor Season chip (preserved per contract; producer lands PR #2854) #}
        {% if factor_season is defined and factor_season is not none %}
        {% set _fs_tone = factor_season.tone if factor_season.tone in ('headwind','tailwind') else '' %}
        <span id="factor-season" class="fs-chip {{ _fs_tone }}"
              data-tip-en="{{ factor_season.tip_en | e }}"
              data-tip-zh="{{ factor_season.tip_zh | e }}">
          {{ t(factor_season.chip_en, factor_season.chip_zh) }}
        </span>
        {% endif %}
        {# Policy-lever chip (injected by JS below) #}
        <span id="ftr-lever-chip"></span>
        {# Days-in-state ── omit when null #}
        {% if _tc_lead.days_in_state is not none and _tc_lead.days_in_state %}
        <span class="tc-days">{{ t(_tc_lead.days_in_state|string + ' days', _tc_lead.days_in_state|string + ' 天') }}</span>
        {% endif %}
      </div>

      {# ── Strength now: green glass chips ── #}
      {% if _tc_lead.strength %}
      <div style="margin:6px 0 4px">
        <span class="muted" style="font-size:11px">{{ t('Strength now', '当前强势') }}</span>
        <div class="tc-chips" style="margin-top:4px">
          {% for s in _tc_lead.strength %}
          <a class="tc-chip up" href="basket/{{ s.id }}.html"
            {% if s.desk_score is defined and s.desk_score is not none %}data-tip-en="desk score {{ s.desk_score }}/100" data-tip-zh="评分 {{ s.desk_score }}/100"{% endif %}>
            {{ t(s.name, s.name_zh) }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# ── Breaking down: red chips; trailing-leader gets 'was #1' tag ── #}
      {% if _tc_lead.breaking %}
      <div style="margin:4px 0 6px">
        <span class="muted" style="font-size:11px">{{ t('Breaking down', '走弱') }}</span>
        <div class="tc-chips" style="margin-top:4px">
          {% for b in _tc_lead.breaking %}
          <a class="tc-chip dn" href="basket/{{ b.id }}.html">
            {{ t(b.name, b.name_zh) }}
            {% if b.id == _tc_tl.id %}<span class="tc-chip was1">{{ t('was #1', '原第一') }}</span>{% endif %}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# ── Migration sentence + alignment tick ── #}
      {% if theme_context.migration is defined and theme_context.migration.note_en %}
      <div class="tc-chips" style="margin-top:6px">
        <span class="tc-chip mig">{{ t(theme_context.migration.note_en, theme_context.migration.note_zh) }}</span>
        {% if theme_context.alignment is defined and theme_context.alignment.sector_rotation_agrees %}
        <span class="tc-chip aln"
              data-tip-en="{{ theme_context.alignment.note_en | e }}"
              data-tip-zh="{{ theme_context.alignment.note_zh | e }}">✓ {{ t('rotation agrees', '轮动一致') }}</span>
        {% endif %}
      </div>
      {% endif %}

      {# ── Receipt ⓘ chip + playbook link ── #}
      <div class="tc-chips" style="margin-top:8px">
        <span class="tc-chip rcpt tc-receipt-tip"
              data-tip-en="Trailing-momentum rank names {{ _tc_tl.name }} first; skips the most recent ~3 weeks by construction; suggested weights unchanged. Shape read only — not a forecast."
              data-tip-zh="趋势动量排名以{{ _tc_tl.name_zh }}居首；设计上跳过最近约3周数据；建议权重不变。仅为形态读数，非预测。">ⓘ {{ t('How this works', '原理说明') }}</span>
        <a class="tc-pb-link" href="allocation.html">{{ t('Open the playbook →', '打开操盘手册 →') }}</a>
      </div>

    </div>{# /tc-inner #}
  </div>
  {% else %}
  {# ── Plain header fallback when theme_context absent ── #}
  <header>
    <div style="display:flex;align-items:baseline;flex-wrap:wrap;gap:12px">
      <h1>🧺 {{ t('Thematic baskets', '主题篮子') }}</h1>
      <span class="asof"><span class="pfx">{{ t('as of', '截至') }} </span><span id="asof">—</span></span>
    </div>
    <p class="story" id="story"></p>
    <p class="tagline">{{ t(
      'Equal-weight US theme baskets measured against the S&P 500. Use them to see which themes are leading or fading.',
      '等权重美国主题篮子，对标标普 500。用于观察哪些主题在走强或走弱。') }}</p>
    <div id="factor-season" style="margin-top:6px">
      {% if factor_season is defined and factor_season is not none %}
