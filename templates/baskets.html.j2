      ${flags.join('')}
    </div>
    <div class="treason">${esc((t.reasons||[]).join(' · '))}</div>
    <div class="tstats">
      <span class="tpill">${L('above 50d','站上50日')} <b>${b.pct50==null?'—':Math.round(b.pct50*100)+'%'}</b></span>
      <span class="tpill">${L('+3% / −3%','+3% / −3%')} <b class="pos">${im.up3||0}</b>/<b class="neg">${im.down3||0}</b></span>
