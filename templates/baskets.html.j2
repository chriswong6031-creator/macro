    {% set cohering = [] %}{% for g in (flow.sectors + flow.baskets) %}{% if g.cohesion_gate.stress_conditional %}{% set _ = cohering.append(g) %}{% endif %}{% endfor %}
    <div class="fl-foot" style="margin-top:10px">
      <span class="muted" style="font-size:11.5px"
        data-tip-en="Co-movement {{ (flow.cluster.absorption*100)|round|int if flow.cluster else '—' }}% · {% if RG.elevated and cohering %}stress-conditional gate active{% else %}gate inactive · VIX {{ (RG.pctile*100)|round|int if RG.pctile is not none else '—' }}%ile{% endif %}"
        data-tip-zh="共动度 {{ (flow.cluster.absorption*100)|round|int if flow.cluster else '—' }}% · {% if RG.elevated and cohering %}应激门限激活{% else %}门限未激活 · VIX {{ (RG.pctile*100)|round|int if RG.pctile is not none else '—' }}分位{% endif %}">
        ▲ {{ t('emerging','新兴') }} · ● {{ t('confirmed','确认') }} · ▽ {{ t('cooling','降温') }} — {{ t('bar = data coherence','长条=数据一致性') }} ⓘ
      </span>
    </div>

    {# ETF style/risk tone and vol pill — client-side, fetched once each #}
    <div id="mf-etf-chips" style="display:flex;flex-wrap:wrap;gap:5px;margin-top:8px"></div>
    <div id="mf-vol-chip" style="margin-top:5px"></div>
  </div>
  {% endif %}

  {# Theme Rotation Desk add-ons (display-only): ETF Pulse (style/risk/sector rotation),
     vol-regime + CBOE put/call chip, and per-theme ATR extension. Renders from
     basketdata/{etf_pulse,vol_sentiment,theme_extension}.json via theme_addons.js. #}
  {# _theme_addons.html.j2 include removed (Op 7 — Stage B rebuilds into Money-flow; partial stays untouched) #}

  <div id="content">
    <section id="table-section">
      <h2>{{ t('Performance table', '表现一览') }}</h2>
      <p class="sub">{{ t(
        "Sortable snapshot of every basket. Toggle between raw return, return versus S&P 500, and each basket's own z-score. Click a basket to see members.",
        '所有篮子的可排序快照。可切换原始回报、相对标普 500 回报和篮子自身 z 分数。点击篮子查看成分。') }}</p>
      <div class="chartbar"><span></span><span class="tabs" id="btbl-mode" role="group"></span></div>
      <div id="btbl-cat-filter" class="btbl-cats"></div>
