.rvx-gcard .gm{font-size:10.5px;color:var(--muted)}
.rvx-gcard.verdict{text-align:left;display:flex;flex-direction:column;justify-content:center}
.rvx-gcard.verdict .gbig{font-size:19px;font-weight:750;color:var(--warn)}
.rvx-minibar{height:6px;border-radius:3px;background:color-mix(in srgb,var(--text) 8%,transparent);margin-top:8px;overflow:hidden;position:relative}
