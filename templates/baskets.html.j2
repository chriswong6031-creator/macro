  lag:{c:'var(--rvx-lag)',en:'Lagging',zh:'落后',se:'Avoid',sz:'回避'}};
const RVX_RECO={enter:['Buy','买入'],accumulate:['Add','加仓'],hold:['Hold','持有'],trim:['Trim','减仓'],avoid:['Avoid','回避']};
const RVX_RECO_C={enter:'var(--rvx-lead)',accumulate:'var(--rvx-lead)',hold:'var(--rvx-improve)',trim:'var(--rvx-weak)',avoid:'var(--rvx-lag)'};
let RVX_D=[], RVX_FILT='all', RVX_SHOWALL=false;
