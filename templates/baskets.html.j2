// Display-only: stamp each theme card with the Divergence Radar real-activity read
// Shared module promise for basketdata/radar.json — deduplicates the double fetch.
// Both decorateRealActivity (card pills) and the radar heading chip use this.
let _radarJsonP = null;
function _fetchRadar(){
  if(!_radarJsonP) _radarJsonP = fetch('basketdata/radar.json',{cache:'no-store'}).then(r=>r.ok?r.json():null).catch(()=>null);
  return _radarJsonP;
}
// (basketdata/radar.json). Bilingual l-en/l-zh spans (toggle-proof). Non-invasive — appends
// one pill to the card's .txrow; silent if the radar JSON is absent. See site/radar.html.
function decorateRealActivity(){
  const ST={POSITIVE_DIVERGENCE:[L('🛰️ activity ahead','🛰️ 活动领先'),'var(--up)'],
            NEGATIVE_DIVERGENCE:[L('🛰️ price ahead','🛰️ 价格领先'),'var(--warn)'],
            CONFIRMED_UP:[L('🛰️ confirmed','🛰️ 已印证'),'var(--muted)'],
            CONFIRMED_DOWN:[L('🛰️ weak','🛰️ 走弱'),'var(--muted)'],
            QUIET:[L('🛰️ quiet','🛰️ 平静'),'var(--muted)']};
  _fetchRadar().then(function(d){
    if(!d||!d.flags) return;
    // Compact radar heading chip
    const chip=document.getElementById('radar-chip');
    if(chip){
      const ahead=d.flags.filter(f=>f.state==='POSITIVE_DIVERGENCE').length;
      const behind=d.flags.filter(f=>f.state==='NEGATIVE_DIVERGENCE').length;
      if(ahead||behind){
        chip.style.display='';
        chip.innerHTML=L('🛰️ activity check: '+ahead+' ahead · '+behind+' behind',
                         '🛰️ 实际活动: '+ahead+' 领先 · '+behind+' 落后');
      }
    }
    d.flags.forEach(function(f){
      // On desktop #theme-<id> IS the .txrow element itself (a div.txrow in the table cell).
      // On mobile #theme-<id> is a .tcard and .txrow is a child. Support both layouts.
      const anchor=document.getElementById('theme-'+(f.basket||''));
      const row=anchor&&anchor.classList.contains('txrow')?anchor:anchor&&anchor.querySelector('.txrow');
      if(!row||row.querySelector('.ra-pill')) return;
      const s=ST[f.state]||ST.QUIET;
      const dv=f.divergence==null?'':' '+(f.divergence>0?'+':'')+f.divergence.toFixed(1);
      const pill=document.createElement('span');
      pill.className='tpill ra-pill'; pill.style.borderColor=s[1]; pill.title='real-activity radar';
      pill.innerHTML=s[0]+dv;
      row.appendChild(pill);
    });
  });
}
