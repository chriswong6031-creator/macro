  <!-- ── Shock de-escalation banner (FTR W1 / PS-R3, de-escalation only) ── -->
  <!-- Fetched live from site/live/shock_state.json. Absent file = no banner (graceful). -->
  <div id="ftr-shock-banner"></div>
  <script>
  (function(){
  'use strict';
  function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
  function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  // Shock banner
  fetch('live/shock_state.json',{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(function(d){
      if(!d||!d.active)return;
      var el=document.getElementById('ftr-shock-banner');
      if(!el)return;
      var msg=isZh()?
        ('⚠ 冲击状态 — 评分与叙事依据冲击前数据计算，有效期至 '+esc(d.expires)+'，届前请酌情折扣。冲击期的剧烈反转多难持续：历史26次中约六成在一天内消退。'):
        ('⚠ SHOCK regime: scores &amp; narrative computed on pre-shock data — discount until '+esc(d.expires)+'. Sharp reversals during shocks usually don&#39;t hold: in 26 past cases about 6 in 10 faded within a day.');
      el.innerHTML='<div class="shock-deesc-banner" style="background:rgba(250,204,21,.10);border:1px solid rgba(250,204,21,.4);color:var(--warn);border-radius:9px;padding:9px 14px;margin:8px 0;font-size:13px">'+msg+'</div>';
    }).catch(function(){/* absent file → no banner */});
  // Policy-lever chip — inject into hero chip row (#ftr-lever-chip)
  fetch('policy_lever.json',{cache:'no-cache'})
    .then(function(r){if(!r.ok)throw 0;return r.json();})
    .then(function(d){
      if(!d||!d.state)return;
      var el=document.getElementById('ftr-lever-chip');
      if(!el)return;
      var s=d.state, c=s==='ARMED'?'var(--down)':s==='ELEVATED'?'var(--orange)':'var(--muted)';
      // plain words at rest; the full framing sentence lives in the hover tip only
      var sEn={'ARMED':'Policy risk: high','ELEVATED':'Policy risk: elevated','QUIET':'Policy backdrop: quiet'}[s]||s;
      var sZh={'ARMED':'政策风险：高','ELEVATED':'政策风险：偏高','QUIET':'政策面：平静'}[s]||s;
      el.innerHTML='<span class="tc-chip lever" data-tip-en="'+esc((d.framing||''))+'" data-tip-zh="'+esc((d.framing_zh||d.framing||''))+'" style="border-color:'+c+';color:'+c+'">'
        +'<span class="l-en">'+esc(sEn)+'</span><span class="l-zh">'+esc(sZh)+'</span></span>';
    }).catch(function(){/* absent file → no chip */});
  })();
  </script>


  <!-- ══════════════════════════════════════════════════════════════════════
       FTR W3+W5: Basket tape band v3 — two-column ranked idiom (ported from
       the #2227 us_stocks dash-tape-band, the operator-ratified redo of the
       #2208 chip strip): state token IS the label, ONE as-of, ranked columns
       (5 leaders | 3 laggards) with ordinals + display names + mirrored
       shared-scale bars, inline flow chips only when notable, "Show full
       tape" expander, one merged footnote.
       Fetched from live/basket_pulse.json + basketdata/turn_watch.json.
       De-escalation / display tier only (FT-R1, FT-R2).
       Stale-gating: disagreement chips SUPPRESSED (never inverted) when stale
       or session==closed (FT-R12). T+1 fade note in the footnote (FT-R3) in
       plain words; the technical receipt lives in the ? tip (Tier 2).
       ══════════════════════════════════════════════════════════════════════ -->
  <!-- ── Slim tape strip (always visible when tape is live; expander opens full band) ── -->
  <div id="ftr-tape-strip" class="ftr-tape-strip" aria-label="Basket tape summary">
    <span class="ftr-strip-token" id="ftr-strip-token">
      <span class="ftr-strip-dot no-anim" id="ftr-strip-dot"></span>
      <span id="ftr-strip-token-lbl">—</span>
    </span>
    <span class="ftr-strip-asof" id="ftr-strip-asof"></span>
    <span id="ftr-strip-leaders"></span>
    <span id="ftr-strip-laggards"></span>
    <button class="ftr-strip-expand" id="ftr-strip-expand" type="button" aria-expanded="false">
      <span class="l-en">Full tape ▾</span><span class="l-zh">完整榜单 ▾</span>
    </button>
  </div>
  <!-- ── Full tape band (collapsible; all internals preserved verbatim) ── -->
  <div id="ftr-tape-full" class="ftr-tape-full">
  <div id="ftr-tape-band" class="ftr-tape-band" aria-label="Basket tape">
    <div class="dtp-row">
      <span class="dtp-token closed" id="ftr-dtp-token"><span class="dtp-dot"></span><span id="ftr-dtp-token-lbl">—</span></span>
      <span class="dtp-asof" id="ftr-tape-asof"></span>
    </div>
    <div class="dtp-body" id="ftr-dtp-body"></div>
    <button class="dtp-more" id="ftr-dtp-more" type="button" aria-expanded="false" hidden></button>
    <!-- T+1 fade note (FT-R3): plain words at a glance; receipt demoted to the ? tip -->
    <div class="dtp-fn ftr-tape-t1"><span class="l-en">Not a buy signal: sharp one-day flips usually don&#39;t hold &mdash; in 26 past cases about 6 in 10 faded within a day.</span><span class="l-zh">非买入信号：剧烈的单日反转多难持续 — 历史26次中约六成在一天内消退。</span> <span class="ftr-t1-help" data-tip-en="Technical receipt: T+1 violent-flip base rate 58% fade (n=26) · flip-confirmation lens · descriptive only, not a directional signal." data-tip-zh="技术说明：T+1剧烈反转基础概率58%消退（n=26）· 翻转确认透镜 · 仅描述、非方向信号。">?</span><span id="ftr-dtp-fn-flow"></span></div>
  </div>
  </div>{# /ftr-tape-full #}

  <script>
  /* FTR W3+W5+W4: tape band v3 + turn-watch card JS (display/de-escalation only)
     FT-R1: never mutates slow state; FT-R2: tier=display; FT-R3: T+1 fade note
     (plain words in the footnote; technical receipt in the ? tip); FT-R12:
     stale-gate suppresses chips; FT-R8: graceful absent-file.
     Idiom = tape band v3 (#2227, operator-ratified): ranked two-column layout,
     ordinals + display names (never slugs), mirrored shared-scale bars, inline
     flow chips when notable, full-tape expander, ONE as-of, one footnote. */
  (function(){
  'use strict';
  function isZh(){return document.documentElement.getAttribute('data-lang')==='zh';}
  function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c];});}
  function L(en,zh){return'<span class="l-en">'+en+'</span><span class="l-zh">'+(zh==null?en:zh)+'</span>';}
  function fmtPct(v){if(v==null)return'—';return(v>=0?'+':'')+v.toFixed(2)+'%';}
  // Disagreement-chip gate (FT-R12): chips only when mode=live (TS-R1).
  // Values (mover chips) are rendered in all modes when a stamped read exists.
  function isChipSuppressed(pulse){
    if(!pulse) return true;
    return (pulse.mode||'live') !== 'live';
  }

  // ── Display names (Law 2: never raw slugs; prettified fallback never blocks render)
  function _slugName(id){return String(id||'').replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();});}
  function _theme(id){
    var arr=(window.BASKETS&&window.BASKETS.baskets)||[];
    for(var i=0;i<arr.length;i++){ if(arr[i].id===id) return arr[i]; }
    return null;
  }
  function nameEn(id){var b=_theme(id);return (b&&b.name)||_slugName(id);}
  function nameZh(id){var b=_theme(id);return (b&&(b.name_zh||b.name))||_slugName(id);}

  // ── Single display-state token (the token IS the label; TS-R1 honest-delay law)
  function _dtpState(pulse){
    var mode    = pulse.mode||'live';
    var session = pulse.session||'closed';
    var ts      = pulse.as_of_quotes||pulse.as_of_utc;
    var asofStr = '';
    if(ts){
      try{
        if(ts.length<=10){ asofStr=ts; }
        else if(mode==='last_rth'&&pulse.settled_close){
          asofStr=new Date(ts).toLocaleString([],{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
        } else {
          asofStr=new Date(ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',timeZoneName:'short'});
        }
      }catch(e){asofStr=ts;}
    }
    /* >12h staleness guard (weekend/holiday frozen file) — a stale file describes
       a finished session; never label it live or post-market */
    var builtMs=Date.parse(pulse.as_of_utc||'');
    var stale=isFinite(builtMs)&&(Date.now()-builtMs)>12*3600e3;
    if(stale){
      if(mode==='live'||mode==='delayed'){ pulse.mode='last_rth'; }
      return {cls:'closed', en:'LAST SESSION · SETTLED', zh:'上一交易时段 · 已收盘', asofStr:asofStr, live:false};
    }
    if(mode==='live'){
      if(session==='pre')
        return {cls:'pre', en:'PREMARKET · 15-MIN DELAYED', zh:'盘前 · 15分钟延迟', asofStr:asofStr, live:true};
      return {cls:'live', en:'LIVE · 15-MIN DELAYED', zh:'实盘 · 15分钟延迟', asofStr:asofStr, live:true};
    }
    if(mode==='last_rth'){
      if(pulse.settled_close)
        return {cls:'post', en:'POST-MARKET · SETTLED CLOSE', zh:'盘后 · 当日收盘', asofStr:asofStr, live:false};
      return {cls:'post', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
    }
    if(mode==='eod')
      return {cls:'closed', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
    if(mode==='delayed'){
      var h=pulse.delay_min_median!=null?Math.round(pulse.delay_min_median/60):0;
      return {cls:'warn', en:'DELAYED · ~'+h+'h', zh:'延迟 · 约'+h+'小时', asofStr:asofStr, live:false};
    }
    return {cls:'closed', en:'LAST SESSION', zh:'上一交易时段', asofStr:asofStr, live:false};
  }

  // ── Tape band v3: ranked leader/laggard columns + complex row + expander ──
  function renderTapeStrip(pulse){
    var band=document.getElementById('ftr-tape-band');
    if(!band) return;

    var st=_dtpState(pulse);
    var tokEl=document.getElementById('ftr-dtp-token');
    var tokLbl=document.getElementById('ftr-dtp-token-lbl');
    if(tokEl){ tokEl.className='dtp-token '+st.cls; }
    if(tokLbl){ tokLbl.innerHTML=L(esc(st.en),esc(st.zh)); }
    var asofEl=document.getElementById('ftr-tape-asof');
    if(asofEl){ asofEl.innerHTML=st.asofStr?L('as of '+esc(st.asofStr),'截至 '+esc(st.asofStr)):''; }
    if(st.live){ band.classList.add('live-mode'); } else { band.classList.remove('live-mode'); }

    var bodyEl=document.getElementById('ftr-dtp-body');
    var moreBtn=document.getElementById('ftr-dtp-more');
    var flowEl=document.getElementById('ftr-dtp-fn-flow');
    if(!bodyEl) return;
    var mode=pulse.mode||'live';
    var all=(pulse.baskets||[]).filter(function(b){return b.live_ew_chg_pct!=null&&b.tape_rank!=null;});
    var session=pulse.session||'closed';
    if(!all.length){
      var loading=(session==='pre'||session==='rth');
      bodyEl.innerHTML='<div class="dtp-empty">'
        +(loading?L('quotes loading…','报价加载中…')
                 :L('No tape data for the last session.','上一交易时段暂无行情数据。'))
        +'</div>';
      if(moreBtn){moreBtn.hidden=true;moreBtn.setAttribute('aria-expanded','false');}
      if(flowEl){flowEl.innerHTML='';}
      return;
    }

    // sort by tape rank — works for live, delayed, last_rth, eod
    all.sort(function(a,b){return b.tape_rank-a.tape_rank;});
    /* laggards only from rows NOT already shown as leaders (sparse days: n<=5 → no laggard group) */
    var top5=all.slice(0,5);
    var bot3=all.length>5?all.slice(Math.max(5,all.length-3)).reverse():[];

    /* honest bars: shared px scale across the shown movers */
    var shown=top5.concat(bot3);
    var maxAbs=0;
    shown.forEach(function(b){var a=Math.abs(b.live_ew_chg_pct);if(a>maxAbs)maxAbs=a;});
    if(!maxAbs)maxAbs=1;

    var flowShown=false, flowAsOf=pulse.day_flow_as_of||null;

    function flowBits(b){
      var f=b.day_flow;
      /* flow is notable when |cmf|>0.05 OR vol_surge>=1.5 (descriptive only) */
      var hasFlow=f&&((f.cmf!=null&&Math.abs(f.cmf)>0.05)||(f.dollar_vol_surge!=null&&f.dollar_vol_surge>=1.5));
      if(!hasFlow) return null;
      flowShown=true;
      var aoStr=f.as_of||flowAsOf||'';
      var volStr=f.dollar_vol_surge!=null?('×'+Number(f.dollar_vol_surge).toFixed(1)):'';
      var dirEn=f.cmf>0.05?'inflow':(f.cmf<-0.05?'outflow':'balanced');
      var dirZh=f.cmf>0.05?'流入':(f.cmf<-0.05?'流出':'均衡');
      var longEn=f.cmf>0.05?'net inflow':(f.cmf<-0.05?'net outflow':'balanced flow');
      var longZh=f.cmf>0.05?'净流入':(f.cmf<-0.05?'净流出':'资金流均衡');
      return {
        en:(volStr?volStr+' vol · ':'')+dirEn,
        zh:(volStr?volStr+' 量 · ':'')+dirZh,
        tipEn:(volStr?volStr+' vol · ':'')+longEn+(aoStr?' (nightly, as of '+aoStr+')':''),
        tipZh:(volStr?volStr+' 量 · ':'')+longZh+(aoStr?'（每晚，截至 '+aoStr+'）':'')
      };
    }

    function rowHtml(b, ordinal){
      var chg=b.live_ew_chg_pct, isUp=chg>=0;
      var barW=Math.max(4,Math.min(56,Math.round(Math.abs(chg)/maxAbs*56)));
      var mid='';
      var fb=flowBits(b);
      if(fb){
        mid+='<span class="dtp-mflow" data-tip-en="'+esc(fb.tipEn)+'" data-tip-zh="'+esc(fb.tipZh)+'">'
          +'<span class="l-en">'+esc(fb.en)+'</span><span class="l-zh">'+esc(fb.zh)+'</span></span>';
      }
      /* 2d suffix: only when the session move flips the 2-day direction (neutral wording — no spin words) */
      if(b.cum_2d_pct!=null&&Math.abs(b.cum_2d_pct)>=1.0){
        var flipSign=(chg>=0&&b.cum_2d_pct<0)||(chg<0&&b.cum_2d_pct>=0);
        if(flipSign){
          var d2pct=(b.cum_2d_pct>=0?'+':'')+b.cum_2d_pct.toFixed(1)+'%';
          var d2TipEn=fmtPct(chg)+' today after a '+d2pct+' two-day run — the session move flips the 2-day direction. Descriptive only.';
          var d2TipZh=fmtPct(chg)+' 今日，近两日累计 '+d2pct+' — 当日走势翻转两日方向。仅供参考。';
          mid+='<span class="dtp-2d" data-tip-en="'+esc(d2TipEn)+'" data-tip-zh="'+esc(d2TipZh)+'">2d '+d2pct+'</span>';
        }
      }
      return '<a class="dtp-mrow" href="basket/'+esc(b.id)+'.html">'
        +'<span class="dtp-rank">'+ordinal+'</span>'
        +'<span class="dtp-mname"><span class="l-en">'+esc(nameEn(b.id))+'</span><span class="l-zh">'+esc(nameZh(b.id))+'</span></span>'
        +mid
        +'<span class="dtp-mpct '+(isUp?'up':'dn')+'">'+fmtPct(chg)+'</span>'
        +'<span class="dtp-mtrack'+(isUp?'':' dn')+'"><span class="dtp-mbar '+(isUp?'up':'dn')+'" style="width:'+barW+'px"></span></span>'
        +'</a>';
    }

    /* column labels adapt to the honest state (TS-R1) */
    var lblUp, lblDn;
    if(st.live){
      lblUp=L('LIVE LEADERS','实时领涨'); lblDn=L('LIVE LAGGARDS','实时领跌');
    } else if(mode==='last_rth'&&pulse.settled_close){
      lblUp=L('SESSION LEADERS — AT THE CLOSE','本交易日领涨 — 收盘');
      lblDn=L('SESSION LAGGARDS — AT THE CLOSE','本交易日领跌 — 收盘');
    } else {
      lblUp=L('LAST SESSION LEADERS','上一交易日领涨');
      lblDn=L('LAST SESSION LAGGARDS','上一交易日领跌');
    }

    var upRows='', dnRows='';
    top5.forEach(function(b,i){upRows+=rowHtml(b,i+1);});
    bot3.forEach(function(b,i){dnRows+=rowHtml(b,i+1);});
    /* footnote flow provenance must reflect only the always-visible rows; the
       fold rows below also run flowBits, so snapshot before building them */
    var flowShownVisible=flowShown;

    /* full tape behind the expander (UI truncation only, TS-R5) — each column
       CONTINUES its own ranking past the preview cut: leaders extend 6..half,
       laggards extend worst-first, the two meet at mid-tape. No row repeats. */
    var half=Math.max(top5.length,Math.ceil(all.length/2));
    var upCont=all.slice(top5.length,half);
    var dnCont=all.slice(half,all.length-bot3.length).reverse();
    var upMore='', dnMore='';
    upCont.forEach(function(b,i){upMore+=rowHtml(b,top5.length+i+1);});
    dnCont.forEach(function(b,i){dnMore+=rowHtml(b,bot3.length+i+1);});

    var colUp='<div class="dtp-col"><div class="dtp-col-lbl up">'+lblUp+'</div>'+upRows;
    if(upMore){colUp+='<div class="dtp-colmore" hidden>'+upMore+'</div>';}
    colUp+='</div>';

    var colDn='<div class="dtp-col"><div class="dtp-col-lbl dn">'+lblDn+'</div>'+dnRows;
    if(dnMore){colDn+='<div class="dtp-colmore" hidden>'+dnMore+'</div>';}
    /* AI-Capex complex row (live mode only — chip suppression law unchanged, FT-R12) */
    if(!isChipSuppressed(pulse)){
      var cx=null;
      (pulse.complexes||[]).forEach(function(c){if(c.complex_id==='ai_capex')cx=c;});
      if(cx&&cx.live_ew_chg_pct!=null){
        var isG=cx.live_ew_chg_pct>=0;
        var cxTipEn='AI-Capex Complex composite basket.'+(cx.only_green_complex?' Only complex in positive territory this session.':'')+' Context only.';
        var cxTipZh='AI资本开支复合板块。'+(cx.only_green_complex?'本交易时段唯一上涨复合板块。':'')+'仅供参考。';
        colDn+='<div class="dtp-col-lbl cx" style="margin-top:7px">'+L('COMPLEX','复合')+'</div>'
          +'<a class="dtp-mrow" href="basket/ai_capex.html" data-tip-en="'+esc(cxTipEn)+'" data-tip-zh="'+esc(cxTipZh)+'">'
          +'<span class="dtp-rank">·</span>'
          +'<span class="dtp-mname"><span class="l-en">AI-Capex Complex</span><span class="l-zh">AI资本开支复合板块</span></span>'
          +'<span class="dtp-mpct '+(isG?'up':'dn')+'">'+fmtPct(cx.live_ew_chg_pct)+'</span>'
          +'<span class="dtp-mtrack'+(isG?'':' dn')+'"><span class="dtp-mbar '+(isG?'up':'dn')+'" style="width:'+Math.max(4,Math.round(Math.abs(cx.live_ew_chg_pct)/maxAbs*56))+'px"></span></span>'
          +'</a>';
      }
    }
    colDn+='</div>';

    bodyEl.innerHTML=colUp+colDn;

    /* flow provenance appended to the single static footnote (merge, never stack) */
    if(flowEl){
      if(flowShownVisible){
        var aoEn=flowAsOf?' (as of '+esc(flowAsOf)+')':'';
        var aoZh=flowAsOf?'（截至 '+esc(flowAsOf)+'）':'';
        flowEl.innerHTML=' · '+L('flow = nightly dollar-volume read'+aoEn+', descriptive only','资金流 = 每晚美元成交量读数'+aoZh+'，仅供描述');
      } else {
        flowEl.innerHTML='';
      }
    }

    if(moreBtn){
      if(!upCont.length&&!dnCont.length){
        moreBtn.hidden=true;
        moreBtn.setAttribute('aria-expanded','false');
      } else {
        var n=all.length;
        var moreLbl=function(open){
          return open?L('Show less ▴','收起 ▴')
                     :L('Show full tape ('+n+') ▾','显示完整行情（'+n+'）▾');
        };
        var setOpen=function(open){
          bodyEl.querySelectorAll('.dtp-colmore').forEach(function(el){el.hidden=!open;});
          moreBtn.setAttribute('aria-expanded',open?'true':'false');
          moreBtn.innerHTML=moreLbl(open);
        };
        moreBtn.hidden=false;
        /* live re-renders rebuild the columns — carry the open state across */
        setOpen(moreBtn.getAttribute('aria-expanded')==='true');
        moreBtn.onclick=function(){setOpen(moreBtn.getAttribute('aria-expanded')!=='true');};
      }
    }
  }

  // ── Per-card tape chip injection (disagreement + heat + stale) ───────────
  // Called after the main theme desk renders. Looks for [id^="theme-"] elements
  // (rendered by baskets_desk.js as id="theme-${t.id}") and appends FTR chip strips.
  function injectCardChips(pulse, turnWatch, sectorPulse, stale){
    // index pulse by basket id
    var pulseById = {};
    (pulse&&pulse.baskets||[]).forEach(function(b){ pulseById[b.id]=b; });
    // index turn_watch by basket id
    var twById = {};
    ((turnWatch&&turnWatch.baskets)||[]).forEach(function(b){ twById[b.basket_id]=b; });
    // index sector_pulse by id
    var spById = {};
    ((sectorPulse&&sectorPulse.themes)||[]).forEach(function(t){ spById[t.id]=t; });

    // Target the theme desk cards (rendered by baskets_desk.js as id="theme-<bid>")
    // baskets_desk.js renders: <div class="tcard" id="theme-${t.id}" ...>
    // No data-bid attr exists; derive bid from the id prefix.
    var cards = document.querySelectorAll('[id^="theme-"]');
    cards.forEach(function(card){
      var bid = card.id.slice(6);  // "theme-".length === 6
      if(!bid) return;
      // Remove any previously injected FTR chips to avoid duplication on re-render
      var old = card.querySelectorAll('.ftr-chip-strip');
      old.forEach(function(el){el.remove();});
      // Remove any previously injected turn-watch cards
      var oldTw = card.querySelectorAll('.ftr-tw-card');
      oldTw.forEach(function(el){el.remove();});

      var pb = pulseById[bid];
      var tw = twById[bid];
      var sp = spById[bid];
      var chips = [];

      // Stale chip (from freshness data or pulse stale flag)
      if(pb && pb.stale){
        chips.push('<span class="ftr-stale-chip">'+L('STALE','数据陈旧')+'</span>');
      }

      // Disagreement chip: suppressed when stale (FT-R12). User-first copy
      // (docs/DESIGN_DOCTRINE.md): plain words at a glance; the tape-rank /
      // reco / base-rate receipt lives in the data-tip (Tier 2).
      if(!stale && pb && !pb.stale && pb.live_ew_chg_pct!=null && pb.tape_rank!=null){
        // Find this basket's slow reco. BASKETS.baskets records are pure
        // definitions (no reco); the scored ratings the cards render from live
        // on BASKETS.theme_intel.themes, with turn_watch slow_reco as fallback.
        var themeIntel = (window.BASKETS&&window.BASKETS.theme_intel)||null;
        var theme = ((themeIntel&&themeIntel.themes)||[]).find(function(t){return t.id===bid;});
        var slowReco = (theme&&theme.reco)||(tw&&tw.slow_reco)||'';
        var slowAsOf = (theme&&theme.reco) ? ((themeIntel&&themeIntel.as_of)||'') : ((tw&&tw.reco_as_of)||'');
        var tapeRankNum = pb.tape_rank;
        var totalBaskets = (pulse&&pulse.baskets||[]).filter(function(b){return b.tape_rank!=null;}).length;
        // Disagreement = tape rank in top third while slow reco is weak, or bottom third while strong
        var isHighRank = tapeRankNum > totalBaskets * 0.67;
        var isLowRank  = tapeRankNum < totalBaskets * 0.33;
        var slowIsWeak = slowReco==='hold'||slowReco==='reduce'||slowReco==='trim'||slowReco==='avoid';
        var slowIsStrong = slowReco==='accumulate'||slowReco==='enter';
        if((isHighRank && slowIsWeak) || (isLowRank && slowIsStrong)){
          var chgStr = (pb.live_ew_chg_pct>=0?'+':'')+pb.live_ew_chg_pct.toFixed(1)+'%';
          var RECO_EN={hold:'Hold',reduce:'Reduce',trim:'Trim',avoid:'Avoid',accumulate:'Accumulate',enter:'Buy'};
          var RECO_ZH={hold:'持有',reduce:'减持',trim:'减仓',avoid:'回避',accumulate:'加仓',enter:'买入'};
          var recoEn=RECO_EN[slowReco]||(theme&&theme.reco_en)||slowReco;
          var recoZh=RECO_ZH[slowReco]||(theme&&theme.reco_zh)||recoEn;
          var dirEn = isHighRank?'strong today':'weak today';
          var dirZh = isHighRank?'今日强势':'今日走弱';
          var dateStr = slowAsOf ? slowAsOf.slice(5) : ''; // MM-DD
          var tipEn='Receipt: tape rank '+tapeRankNum+' of '+totalBaskets+' this session ('+chgStr+') vs slow rating '+slowReco.toUpperCase()+(dateStr?' (as-of '+dateStr+')':'')+' · T+1 fade base rate 58% (n=26) · display tier, never reorders ratings.';
          var tipZh='技术说明：本时段行情排名 '+tapeRankNum+'/'+totalBaskets+'（'+chgStr+'），慢速评级 '+slowReco.toUpperCase()+(dateStr?'（截至'+dateStr+'）':'')+' · T+1消退基础概率58%（n=26）· 仅展示层，不改变评级。';
          chips.push('<span class="ftr-disagree-chip" data-tip-en="'+esc(tipEn)+'" data-tip-zh="'+esc(tipZh)+'">'
            +'<span>'+L(dirEn+' — still rated '+esc(recoEn), dirZh+' — 主评级仍为「'+esc(recoZh)+'」')+'</span>'
            +'<span style="font-size:9.5px;opacity:.75">'+L('~6 in 10 fade in a day','约六成一天内消退')+'</span>'
            +'</span>');
        }
      }

      // Sector pulse heat chip + rank_delta_5d (W8)
      if(sp){
        var heat = sp.heat;
        var rd5 = sp.rank_delta_5d;
        if(heat&&heat!=='idle'){
          var heatLabels = {hot:['HOT','强势'],heating:['HEATING','加热'],cooling:['COOLING','降温'],broken:['BROKEN','破位']};
          var hl = heatLabels[heat]||[heat.toUpperCase(),heat];
          chips.push('<span class="ftr-heat-chip '+heat+'">'+L(esc(hl[0]),esc(hl[1]))+'</span>');
        }
        if(rd5!=null){
          var rdClass = rd5>0?'pos':'neg';
          var rdArrow = rd5>0?'&#8593;':'&#8595;';
          // compact form at rest; full sentence in the hover tip
          chips.push('<span class="chip" style="font-size:10px" data-tip-en="moved '+rdArrow+Math.abs(rd5)+' rank spots this week" data-tip-zh="本周排名变动'+rdArrow+Math.abs(rd5)+'位">'
            +'<span class="'+rdClass+'">'+rdArrow+Math.abs(rd5)+'</span></span>');
        }
      }

      // Emit chip strip if any chips
      if(chips.length){
        var stripEl = document.createElement('div');
        stripEl.className = 'ftr-chip-strip chip-strip';
        stripEl.innerHTML = chips.join('');
        card.appendChild(stripEl);
      }

      // Turn-watch card (W4) — always shown for WATCH/IGNITION regardless of stale.
      // User-first copy per docs/DESIGN_DOCTRINE.md + #2221 vocabulary:
      // STRONG SIGN / EARLY SIGN badges, plain-word legs (technical construction
      // in per-leg data-tips), plain footer; the Oracle-P8 receipt lives in the
      // footer's ? tip (Tier 2). Gate logic and states unchanged.
      if(tw && (tw.state==='WATCH'||tw.state==='IGNITION')){
        var isIgnition = tw.state==='IGNITION';
        var legs = tw.legs||{};
        var k = tw.k||0;
        var LEG_LABELS = {
          impulse_day:       [L('Big up day','单日大涨'),            L('&#8531; of stocks +3%+','&#8531;成分股涨3%+'),
                              'Impulse day: at least one-third of members up 3%+ today.','脉冲日：至少三分之一成分股当日上涨3%以上。'],
          rs_z:              [L('Strong vs market','跑赢大盘'),       L('vs other groups','对比其他板块'),
                              'Relative strength: cross-sectional z-score of returns vs the basket universe.','相对强度：对比全部篮子的横截面收益z值。'],
          breadth_surge:     [L('Breadth jump','广度跃升'),          L('more stocks rising','更多成分上涨'),
                              'Breadth surge: z-score jump in % of members above their 50-day average.','广度突破：成分股站上50日均线比例的z值跃升。'],
          volume_confirm:    [L('Volume backs it','放量配合'),        L('&#215;1.5 usual volume','约1.5倍常量'),
                              'Volume confirm: equal-weight dollar volume at least 1.5× its recent average.','成交量确认：等权美元成交量达近期均值1.5倍以上。'],
          complex_confirm:   [L('Related groups agree','相关板块同步'),L('siblings improving','兄弟板块转强'),
                              'Complex confirm: sibling baskets in the same complex also show positive relative strength.','复合确认：同一复合板块的兄弟篮子相对强度同步转正。'],
          shock_relative_bid:[L('Event-driven','事件驱动'),          L('oil / geopolitics','油价/地缘'),
                              'Shock flag: the move coincides with an oil/geopolitical shock driver.','冲击标志：走势与油价/地缘冲击驱动同时出现。']
        };
        var twTipEn='Technical receipt: fast turn meter, state '+tw.state+' ('+k+' of 6 legs). Backtested basket-level washout→turn edge = null (Oracle P8); T+1 fade base rate 58% (n=26). Slow ratings unchanged; display tier only.';
        var twTipZh='技术说明：快速拐点计量，状态 '+tw.state+'（6条腿中'+k+'条触发）。篮子级洗盘→拐点回测优势为空值（Oracle P8）；T+1消退基础概率58%（n=26）。慢速评级未变；仅展示层。';
        var twHtml = '<div class="ftr-tw-card'+(isIgnition?'':' watch')+'">'
          +'<div class="ftr-tw-hd">'
          +'<span class="ftr-tw-badge'+(isIgnition?'':' watch')+'">'+L(isIgnition?'&#9889; STRONG SIGN':'&#9889; EARLY SIGN', isIgnition?'&#9889; 较强迹象':'&#9889; 初步迹象')+'</span>'
          +'<span class="ftr-tw-k">'+L(k+' of 6 signs',k+' / 6 项迹象')+'</span>'
          +'<span class="ftr-tw-asof">'+L('updated nightly','每晚更新')+(tw.as_of?' · '+esc(tw.as_of):'')+'</span>'
          +'</div>'
          +'<div class="ftr-tw-legs">';
        var legOrder = ['impulse_day','rs_z','breadth_surge','volume_confirm','complex_confirm','shock_relative_bid'];
        legOrder.forEach(function(lk){
          var fired = !!legs[lk];
          var ll = LEG_LABELS[lk]||[lk,lk,'',''];
          var legTip=ll[2]?' data-tip-en="'+esc(ll[2])+'" data-tip-zh="'+esc(ll[3])+'"':'';
          twHtml += '<div class="ftr-tw-leg'+(fired?' fired':'')+'"'+legTip+'>'
            +'<div class="ftr-tw-leg-nm">'+ll[0]+'</div>'
            +'<div class="ftr-tw-leg-val">'+(fired?'&#10003; ':L('— ','— '))+ll[1]+'</div>'
            +'</div>';
        });
        twHtml += '</div>'
          +'<div class="ftr-tw-disc">'+L(
            'Not a buy signal: in 26 past cases about 6 in 10 of these early signs faded within a day. If the turn is real, this theme&#39;s rating upgrades on its own.',
            '非买入信号：历史26次中约六成的早期迹象在一天内消退。若拐点为真，主题评级会自行升级。'
          )+' <span class="ftr-t1-help" data-tip-en="'+esc(twTipEn)+'" data-tip-zh="'+esc(twTipZh)+'">?</span></div></div>';
        var twEl = document.createElement('div');
        twEl.innerHTML = twHtml;
        // Insert before chip strip if present, else at end
        var chipStrip = card.querySelector('.ftr-chip-strip');
        if(chipStrip){ card.insertBefore(twEl.firstChild, chipStrip); }
        else { card.appendChild(twEl.firstChild); }
      }
    });
  }

  // ── Slim tape strip (one-line summary above the full band) ──────────────
  function renderSlimStrip(pulse){
    var strip=document.getElementById('ftr-tape-strip');
    if(!strip) return;
    if(!pulse){ strip.classList.remove('visible'); return; }
    strip.classList.add('visible');
    var st=_dtpState(pulse);
    var tokEl=document.getElementById('ftr-strip-token');
    var tokLbl=document.getElementById('ftr-strip-token-lbl');
    var dotEl=document.getElementById('ftr-strip-dot');
    var asofEl=document.getElementById('ftr-strip-asof');
    if(tokEl){ tokEl.className='ftr-strip-token'+(st.live?' live':''); }
    if(dotEl){ dotEl.className='ftr-strip-dot'+(st.live?'':' no-anim'); }
    if(tokLbl){ tokLbl.innerHTML=L(esc(st.en),esc(st.zh)); }
    if(asofEl){ asofEl.innerHTML=st.asofStr?L(esc(st.asofStr),esc(st.asofStr)):''; }
    var all=(pulse.baskets||[]).filter(function(b){return b.live_ew_chg_pct!=null&&b.tape_rank!=null;});
    all.sort(function(a,b){return b.tape_rank-a.tape_rank;});
    var leadEl=document.getElementById('ftr-strip-leaders');
    var lagEl=document.getElementById('ftr-strip-laggards');
    function chipHtml(b,cls){
      var chg=b.live_ew_chg_pct;
      var nm=nameEn(b.id)||b.id;
      return '<span class="ftr-strip-chip '+cls+'">'+esc(nm)+' '+(chg>=0?'+':'')+chg.toFixed(1)+'%</span>';
    }
    if(leadEl){
      var top3=all.slice(0,3);
      leadEl.innerHTML=top3.map(function(b){return chipHtml(b,'up');}).join('');
    }
    if(lagEl){
      var lag3=all.length>3?all.slice(Math.max(3,all.length-3)).reverse():[];
      lagEl.innerHTML=lag3.map(function(b){return chipHtml(b,'dn');}).join('');
    }
    // Expander toggle wiring (idempotent)
    var btn=document.getElementById('ftr-strip-expand');
    var full=document.getElementById('ftr-tape-full');
    if(btn&&full&&!btn._wired){
      btn._wired=true;
      btn.addEventListener('click',function(){
        var open=full.classList.toggle('open');
        btn.setAttribute('aria-expanded',open?'true':'false');
        btn.innerHTML=open?
          '<span class="l-en">Full tape ▴</span><span class="l-zh">收起 ▴</span>':
          '<span class="l-en">Full tape ▾</span><span class="l-zh">完整榜单 ▾</span>';
      });
    }
  }

  // ── Main fetch + render ───────────────────────────────────────────────────
  function renderTapeBand(pulse, turnWatch, sectorPulse){
    var band = document.getElementById('ftr-tape-band');
    if(!band) return;
    if(!pulse){ band.classList.remove('visible'); return; }

    band.classList.add('visible');
    // Slim strip: state token + top-3 leaders + top-3 laggards + expander
    renderSlimStrip(pulse);
    // Full band: state token + ONE as-of + ranked two-column body
    renderTapeStrip(pulse);

    // Inject per-card chips (called after a small delay to let theme desk render first)
    var chipsSuppressed = isChipSuppressed(pulse);
    setTimeout(function(){
      injectCardChips(pulse, turnWatch, sectorPulse, chipsSuppressed);
    }, 120);
  }

  // ── Fetch all three data sources (tolerant, fail-silent per FT-R8) ───────
  var pulse=null, turnWatch=null, sectorPulse=null;
  function tryRender(){ renderTapeBand(pulse, turnWatch, sectorPulse); }

  function fetchJson(url, cb){
    fetch(url,{cache:'no-cache'})
      .then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(cb)
      .catch(function(){/* absent/error → graceful no-op */});
  }

  fetchJson('live/basket_pulse.json', function(d){ pulse=d; tryRender(); });
  fetchJson('basketdata/turn_watch.json', function(d){ turnWatch=d; tryRender(); });
  fetchJson('basketdata/sector_pulse.json', function(d){ sectorPulse=d; tryRender(); });

  // Re-run chip injection after theme desk is likely rendered (fallback)
  setTimeout(function(){
    if(pulse) injectCardChips(pulse, turnWatch, sectorPulse, isChipSuppressed(pulse));
  }, 800);
  })();
  </script>

  {# ── Theme Context Hero (theme_context.v1, server-rendered) ── #}
  {# When theme_context is absent (off-lane / first run): plain header fallback. #}
  {% if theme_context is defined and theme_context is not none %}
