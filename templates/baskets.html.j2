          {% if _tc_st == 'rotating' %}{{ t('Money is', '资金正在') }} <span class="ac">{{ t('rotating', '轮动') }}</span>
          {% elif _tc_st == 'strain' %}{{ t('Leadership under', '领涨') }} <span class="ac">{{ t('strain', '承压') }}</span>
          {% else %}{{ t('Leadership', '领涨格局') }} <span class="ac">{{ t('steady', '稳定') }}</span>{% endif %}
        </div>
        <p class="rvx-vsub">{% if theme_context.migration is defined and theme_context.migration.note_en %}{{ t(theme_context.migration.note_en, theme_context.migration.note_zh) }} {% endif %}{{ t("Favour the fresh leaders — not last month's winners.", '顺势买入新领涨，而非上月的赢家。') }}</p>
        <span class="rvx-stance">⚑ {{ t(_tc_lead.stance_en, _tc_lead.stance_zh) }}</span>
        <div class="rvx-chips">
          {% if _tc_lead.days_in_state is not none and _tc_lead.days_in_state %}
          <span class="rvx-chip">{{ t(_tc_lead.days_in_state|string + ' days in this state', _tc_lead.days_in_state|string + ' 天处于此状态') }}</span>
          {% endif %}
          {% if factor_season is defined and factor_season is not none %}
          {% set _fs_tone = factor_season.tone if factor_season.tone in ('headwind','tailwind') else '' %}
          <span id="factor-season" class="rvx-chip fs-chip {{ _fs_tone }}" data-tip-en="{{ factor_season.tip_en | e }}" data-tip-zh="{{ factor_season.tip_zh | e }}">{{ t(factor_season.chip_en, factor_season.chip_zh) }}</span>
          {% endif %}
