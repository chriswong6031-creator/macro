.rvx-rtip .rt-nm{font-weight:750;font-size:13px} .rvx-rtip .rt-cat{font-size:10.5px;color:var(--muted);margin-bottom:6px}
.rvx-rtip .rt-row{display:flex;justify-content:space-between;gap:14px;margin:2px 0} .rvx-rtip .rt-row span:last-child{font-family:var(--rvx-num);font-weight:600}
.rvx-rtip .rt-stance{margin-top:7px;font-weight:700;font-size:11.5px}
/* linked board */
.rvx-board-card{padding:14px 16px}
