const COMP_COLOR = {trend:'#5aa7ff',breadth:'#4ade80',impulse:'#a78bfa',macro:'#2dd4bf',mtf:'#f0abfc',volhole:'#fbbf24',crowding:'#fb7185'};
const COMP_LBL = {trend:['trend','趋势'],breadth:['breadth','广度'],impulse:['impulse','脉冲'],macro:['macro','宏观'],mtf:['MTF','多周期'],volhole:['vol-hole','波动洞'],crowding:['crowd','拥挤']};
const COMP_POS = ['trend','breadth','impulse','macro','mtf','volhole'];
const VH_SHORT = {EXPANSION_UP:['breakout','突破','up'],COILED_UP:['coiled↑','蓄势↑','up'],IN_HOLE:['coiled','蓄势','wn'],EXPANDED:['trending','运行',''],COILED_DOWN:['coiled↓','蓄势↓','dn'],EXPANSION_DOWN:['breakdown','跌破','dn']};
const VERD_SHORT = {'TREND-FOLLOW':['aligned↑','共振↑','up'],'BUY-THE-DIP':['dip-buy','逢低','up'],'CAUTION':['unconfirmed','未确认','wn'],'AVOID':['downtrend','下行','dn'],'WAIT':['mixed','分歧','']};

function compBar(c,w){
  const parts=COMP_POS.filter(k=>c[k]!=null).map(k=>({k,v:Math.max(0,(c[k]||0))*(w[k]||0)}));
  parts.push({k:'crowding',v:(c.crowding||0)*(w.crowding||0)});
  const tot=parts.reduce((a,p)=>a+Math.abs(p.v),0)||1;
  const segs=parts.filter(p=>Math.abs(p.v)>0.001).map(p=>`<i style="width:${(Math.abs(p.v)/tot*100).toFixed(1)}%;background:${COMP_COLOR[p.k]};${p.k==='crowding'?'opacity:.55':''}"></i>`).join('');
  return `<div class="cbar" title="contribution to the score">${segs}</div>`;
}
function compLegend(c){
  return `<div class="clegend">`+COMP_POS.filter(k=>c[k]!=null).concat(['crowding']).map(k=>{
    const v=c[k]; const s=(v==null)?'—':((k==='crowding'?'−':(v>=0?'+':''))+Math.abs(v).toFixed(2));
    return `<span><span class="sw" style="background:${COMP_COLOR[k]}"></span>${L(COMP_LBL[k][0],COMP_LBL[k][1])} <b>${s}</b></span>`;
  }).join('')+`</div>`;
}
function themeCard(t){
  const lc=LABEL_COLOR[t.label]||LABEL_COLOR.neutral, rc=RECO_COLOR[t.reco]||RECO_COLOR.hold;
