  {% endif %}

  <section id="actnow-section" style="margin-top:6px">
    <h2>✅ {{ t('What to act on now', '现在该做什么') }}
      <span class="sect-tag">{{ t('buy now · wait for a pullback · reduce / avoid', '立即买入 · 等待回调 · 减仓回避') }}</span>
      <a href="us_stocks.html#action-board" style="font-size:11px;color:var(--muted);font-weight:400;text-decoration:none;margin-left:8px"><span class="l-en">Full board incl. sectors →</span><span class="l-zh">含板块的完整操作板 →</span></a></h2>
    <p class="sub">{{ t(
      'Shortlist by action: buy now, wait for a pullback, or reduce / avoid. Click a theme to see the stocks.',
