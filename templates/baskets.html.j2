// ── Act board: buy / wait / take-profits / avoid, from THEME.act_now ──
const RVX_MOMO={'accelerating':['accelerating','加速'],'decelerating':['decelerating','减速'],'downtrend across timeframes':['downtrend','多周期下行'],'all timeframes aligned up':['aligned up','多周期同向'],'unconfirmed turn vs the bigger trend':['unconfirmed turn','趋势未确认']};
function actRow(x){
  const th=themeById(x.id); const r20=th?relPct(th,'20d'):null;
  let sub;
  if(x.reason_en){ sub=L(esc(x.reason_en),esc(x.reason_zh||x.reason_en)); }
  else { const mo=(x.reasons&&x.reasons[1])||''; const m=RVX_MOMO[mo];
    sub=(r20!=null?'<span class="rvx-num">'+fmtPct(r20)+'</span> '+L('20d vs S&P','20日相对标普'):'')+(m?' · '+L(m[0],m[1]):(mo?' · '+esc(mo):'')); }
  const ern=x.near_earnings_count?' <span class="ern">· '+L(x.near_earnings_count+' report soon',x.near_earnings_count+'家将公布')+'</span>':'';
  const conf=x._conflicted?'<span class="mlcchip">'+L('conflicted','观点冲突')+'</span>':'';
  const tick=x.clean_entry?'<span class="tick">✓</span>':'';
  const ret=r20!=null?'<span class="tret '+(r20>=0?'rvx-up':'rvx-dn')+'">'+fmtPct(r20)+'</span>':'';
  return '<a class="rvx-trow" data-mlc-bid="'+esc(x.id)+'" href="basket/'+encodeURIComponent(x.id)+'.html"><span class="tnm">'+L(esc(x.name),esc(x.name_zh))+conf+'<span class="rsn">'+sub+ern+'</span></span>'+tick+ret+'</a>';
}
function actLane(cls,ic,head,desc,arr){
  const CAP=5, shown=arr.slice(0,CAP);
  const rows=shown.length?shown.map(actRow).join(''):'<div class="rvx-lane-desc" style="min-height:0;padding-top:8px">'+L('Nothing here right now.','暂无。')+'</div>';
  const more=arr.length>CAP?'<a class="more" href="us_stocks.html#action-board">+ '+(arr.length-CAP)+' '+L('more →','更多 →')+'</a>':'';
  return '<div class="rvx-lane '+cls+'"><div class="rvx-lane-h"><span class="ic">'+ic+'</span>'+head+'<span class="ct">'+arr.length+'</span></div><div class="rvx-lane-desc">'+desc+'</div>'+rows+more+'</div>';
}
function renderActBoard(){
  const el=document.getElementById('actnow'); if(!el) return;
  const a=(THEME&&THEME.act_now)||{};
  // MLC-W2b: engine-demoted conflicted items ride the wait lane, tagged so actRow
  // can mark them — their .rsn subline already carries the engine's reason text.
  const conflicted=(a.conflicted||[]).map(x=>Object.assign({},x,{_conflicted:true}));
  const buy=a.buy||[], wait=(a.add_on_pullback||[]).concat(conflicted);
  const reduce=a.reduce||[];
  const isTrim=x=>(x.action==='trim'||x.action_en==='TRIM');
  const trim=reduce.filter(isTrim), avoid=reduce.filter(x=>!isTrim(x));
  el.innerHTML=actLane('buy','🟢',L('Buy now','立即买入'),L('In favour and a clean entry is set up right now.','看好且当前有干净入场点。'),buy)
    +actLane('wait','🔵',L('Wait for a pullback','等待回调'),L('In favour, but stretched — no clean entry yet.','看好但已拉伸 — 暂无干净入场点。'),wait)
    +actLane('trim','🟠',L('Take profits','止盈'),L('Was leading — momentum now rolling over.','曾领涨 — 动能正在回落。'),trim)
    +actLane('avoid','⚪',L('Reduce / avoid','减仓 / 回避'),L('Weak and getting weaker — stand aside.','弱且转弱 — 观望。'),avoid);
  const fn=document.getElementById('actnow-footnote');
  if(fn){ fn.textContent=conflicted.some(x=>x.sector_stance)
    ?L('Conflicted = in favour on its own read, but its sector view says Reduce.','观点冲突 = 自身信号看好，但所属板块评级为减配。'):''; }
  try{ renderStanceChips(); }catch(e){}
}
// MLC-W2b: cross-surface stance chips on act-board rows. Fetches mlcdata/stance_matrix.json
// once (cached so langchange re-renders re-chip without refetching); rows whose four reads
// disagree get a "mixed reads" / "split view" chip with the matrix tip as the hover receipt.
// Rows already carrying the conflicted marker keep it (one chip per row). Fail-silent.
let MLC_MX=null, MLC_MX_REQ=null;
function renderStanceChips(){
  const apply=()=>{ if(!MLC_MX||!MLC_MX.rows) return;
    const byId={}; MLC_MX.rows.forEach(r=>{ if(r&&r.id) byId[r.id]=r; });
    document.querySelectorAll('#actnow .rvx-trow[data-mlc-bid]').forEach(row=>{
      if(row.querySelector('.mlcchip')) return;
      const m=byId[row.getAttribute('data-mlc-bid')];
      if(!m||!m.agreement||(m.agreement!=='mixed'&&m.agreement!=='split')) return;
      const chip=document.createElement('span');
      chip.className='mlcchip';
      chip.setAttribute('data-tip-en',m.tip_en||'');
      chip.setAttribute('data-tip-zh',m.tip_zh||'');
      chip.textContent=m.agreement==='split'?L('split view','严重分歧'):L('mixed reads','观点分歧');
      const nm=row.querySelector('.tnm');
      if(nm){ nm.insertBefore(chip,nm.querySelector('.rsn')); } else row.appendChild(chip);
    });
  };
  if(MLC_MX){ apply(); return; }
  if(!MLC_MX_REQ){
    MLC_MX_REQ=fetch('mlcdata/stance_matrix.json').then(r=>r.ok?r.json():null)
      .then(d=>{ MLC_MX=d; }).catch(function(){/* absent file or fetch error — no chip */});
  }
  MLC_MX_REQ.then(apply).catch(function(){});
}

