{% macro t(en, zh='') -%}
<span class="l-en">{{ en }}</span><span class="l-zh">{{ zh if zh else en }}</span>
{%- endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('Thematic baskets — performance vs S&P 500', '主题篮子 — 相对标普 500 表现') }}</title>
<script>try{var th=localStorage.getItem('theme');if(th)document.documentElement.setAttribute('data-theme',th);var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<link rel="stylesheet" href="theme.css">
<style>
  * { box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font:14px/1.5 -apple-system,"Segoe UI",Roboto,Helvetica,sans-serif; margin:0; padding:18px; }
  @media (min-width:1100px){ body{ padding:24px max(34px,calc((100vw - 1340px)/2)); } }
  a { text-decoration:none; color:inherit; }
  h1 { font-size:21px; margin:0; }
  h2 { font-size:15px; margin:30px 0 4px; display:flex; align-items:center; gap:8px; }
  h2 .idx { font-size:11px; color:var(--muted); border:1px solid var(--line); border-radius:6px; padding:1px 6px; font-weight:600; }
  h3.cat { font-size:12px; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); margin:20px 0 9px; border-bottom:1px solid var(--line); padding-bottom:5px; }
  .muted { color:var(--muted); } .sm { font-size:12px; }
  .pos { color:var(--up); } .neg { color:var(--down); }
  .topline { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-bottom:14px; }
  .panel { background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:6px; margin-top:8px; }
  .panel.pad { padding:14px; }
  .story { font-size:14.5px; margin:8px 0 4px; line-height:1.5; }
  .story b { font-weight:650; }
  .tagline { color:var(--muted); font-size:12.5px; max-width:90ch; margin:4px 0 0; }
  .sub { color:var(--muted); font-size:12.5px; margin:2px 0 8px; max-width:92ch; }
  .chartbar { display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between; margin:8px 0 2px; }
  .tabs { display:inline-flex; border:1px solid var(--line); border-radius:9px; overflow:hidden; }
  .tabs button,.tabs .tab { border:0; background:var(--panel); color:var(--muted); font-size:12px; padding:5px 11px; cursor:pointer; border-right:1px solid var(--line); }
  .tabs button:last-child { border-right:0; }
  .tabs button.on { background:var(--panel2); color:var(--text); font-weight:650; }
  .tabs .rangeN { width:74px; background:var(--panel); color:var(--text); border:0; border-left:1px solid var(--line); padding:5px 8px; font-size:12px; }
  .ts { overflow-x:auto; }
  table { border-collapse:collapse; width:100%; font-size:13px; }
  th,td { padding:6px 9px; border-bottom:1px solid var(--line); white-space:nowrap; }
  th { color:var(--muted); font-weight:500; text-align:right; cursor:pointer; user-select:none; }
  th:first-child,td:first-child { text-align:left; }
  td.num,th.num { text-align:right; font-variant-numeric:tabular-nums; }
  th.sel { color:var(--text); }
  .bname { font-weight:600; cursor:pointer; }
  .bname:hover { color:var(--link); }
  .dot { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:7px; vertical-align:middle; }
  #chart { height:420px; width:100%; }
  .legend { display:flex; flex-wrap:wrap; gap:6px 14px; margin-top:10px; }
  .lchip { display:inline-flex; align-items:center; gap:6px; font-size:12px; cursor:pointer; color:var(--text); }
  .lchip.off { opacity:.34; }
  .lchip .lv { color:var(--muted); font-variant-numeric:tabular-nums; }
  .toolbar { display:flex; align-items:center; gap:10px; margin:10px 0 4px; }
  .toolbar .lbl { font-size:11px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }
  .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(310px,1fr)); gap:13px; }
  .card { background:var(--panel); border:1px solid var(--line); border-left:3px solid var(--c,#888); border-radius:10px; padding:12px 13px; cursor:pointer; transition:border-color .15s; }
  .card:hover { border-color:var(--muted); }
  .card .nm { font-weight:650; font-size:14px; }
  .card .meta { color:var(--muted); font-size:11.5px; margin:3px 0 6px; }
  .card .th { font-size:12px; line-height:1.45; color:var(--text); opacity:.9; margin-bottom:9px; min-height:50px; }
  .card .perf { display:flex; align-items:center; gap:16px; }
  .card .kpi .v { font-size:16px; font-weight:650; font-variant-numeric:tabular-nums; }
  .card .kpi .k { font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
  .card .spark { margin-left:auto; }
  .detail { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:13px 15px; margin-top:12px; scroll-margin-top:14px; }
  .detail h4 { margin:0 0 4px; font-size:15px; display:flex; align-items:center; gap:8px; }
  .detail .th { color:var(--text); opacity:.92; font-size:12.5px; line-height:1.5; margin:0 0 9px; max-width:95ch; }
  .kpirow { display:flex; flex-wrap:wrap; gap:18px; margin:8px 0 10px; }
  .kpirow .k { font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }
  .kpirow .v { font-size:15px; font-weight:650; font-variant-numeric:tabular-nums; }
  .refline { font-size:12px; color:var(--muted); margin:2px 0 9px; }
  .why { color:var(--muted); font-size:12px; white-space:normal; max-width:46ch; }
  details > summary { cursor:pointer; font-size:12.5px; color:var(--muted); margin:6px 0; }
  .warn { display:inline-block; font-size:11px; padding:1px 7px; margin:2px 5px 2px 0; border-radius:7px; background:rgba(250,204,21,.12); border:1px solid rgba(250,204,21,.4); color:var(--warn); }
  .chip { display:inline-block; font-size:11px; padding:1px 7px; margin:0 4px 4px 0; border-radius:7px; background:var(--panel2); border:1px solid var(--line); color:var(--muted); }
  .clog { margin:6px 0 0; padding-left:18px; font-size:12px; color:var(--muted); }
  .clog li { margin:2px 0; }
  footer { color:var(--muted); font-size:11.5px; margin-top:26px; border-top:1px solid var(--line); padding-top:12px; max-width:95ch; }
  .pfx { color:var(--muted); }
  .asof { font-size:12px; color:var(--muted); margin-left:auto; }

  /* ---- Theme Rotation Desk ---- */
  .mctx { display:flex; flex-wrap:wrap; gap:8px 16px; align-items:center; font-size:12.5px;
    background:var(--panel2); border:1px solid var(--line); border-radius:9px; padding:8px 12px; margin:6px 0 12px; }
  .mctx b { font-weight:650; }
  .mctx .mc-k { color:var(--muted); }
  .desk { display:grid; grid-template-columns:repeat(auto-fill,minmax(330px,1fr)); gap:13px; }
  .tcard { background:var(--panel); border:1px solid var(--line); border-left:4px solid var(--tc,#888);
    border-radius:11px; padding:12px 13px 11px; scroll-margin-top:14px; transition:border-color .15s; }
  .tcard:hover { border-color:var(--muted); }
  .tcard .top { display:flex; align-items:center; gap:8px; }
  .tcard .nm { font-weight:660; font-size:14.5px; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .tcard .sc { font-size:23px; font-weight:720; font-variant-numeric:tabular-nums; line-height:1; }
  .tcard .sc small { font-size:11px; color:var(--muted); font-weight:500; }
  .tlabel { font-size:10px; font-weight:700; letter-spacing:.05em; padding:2px 7px; border-radius:6px; text-transform:uppercase; white-space:nowrap; }
  .treco { font-size:11px; font-weight:700; letter-spacing:.03em; padding:2px 9px; border-radius:7px; white-space:nowrap; }
  .tcard .subrow { display:flex; align-items:center; gap:10px; margin:8px 0 7px; font-size:12px; color:var(--muted); }
  .tcard .subrow .spark { margin-left:auto; }
  .cbar { display:flex; height:7px; border-radius:5px; overflow:hidden; background:var(--line); margin:7px 0 6px; }
  .cbar i { display:block; height:100%; }
  .clegend { display:flex; flex-wrap:wrap; gap:3px 11px; font-size:10.5px; color:var(--muted); margin-bottom:6px; }
  .clegend span b { color:var(--text); font-variant-numeric:tabular-nums; font-weight:600; }
  .clegend .sw { display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:3px; vertical-align:middle; }
  .treason { font-size:11.5px; color:var(--text); opacity:.85; line-height:1.4; margin:2px 0 6px; }
  .tstats { display:flex; flex-wrap:wrap; gap:4px 6px; font-size:10.5px; }
  .tpill { background:var(--panel2); border:1px solid var(--line); border-radius:6px; padding:1px 6px; color:var(--muted); }
  .tpill b { color:var(--text); font-variant-numeric:tabular-nums; }
  .tcard details > summary { font-size:11.5px; margin:6px 0 0; }
  .tcard .why { font-size:11.5px; color:var(--muted); margin:5px 0 0; max-width:none; }

  /* ---- 5-day rotation ---- */
  .rotwrap { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width:640px){ .rotwrap{ grid-template-columns:1fr; } }
  .rotcol { background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:10px 12px; }
  .rotcol h4 { margin:0 0 6px; font-size:13px; display:flex; align-items:center; gap:6px; }
  .rotrow { display:flex; align-items:center; gap:8px; padding:5px 0; border-top:1px solid var(--line); font-size:12.5px; }
  .rotrow:first-of-type { border-top:0; }
  .rotrow .rn { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .rotrow .rv { font-variant-numeric:tabular-nums; font-weight:650; }
  .rotrow .rk { font-size:10.5px; color:var(--muted); width:34px; text-align:right; }

  /* ---- impulse / extremes scorecards ---- */
  .scards { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:13px; }
  .scard { background:var(--panel); border:1px solid var(--line); border-radius:11px; padding:13px 15px; }
  .scard .sk { font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .scard .bigrow { display:flex; align-items:baseline; gap:14px; margin:7px 0 8px; }
  .scard .big { font-size:30px; font-weight:720; font-variant-numeric:tabular-nums; line-height:1; }
  .scard .big.dn { color:var(--down); } .scard .big.up { color:var(--up); }
  .scard .sublbl { font-size:11px; color:var(--muted); }
  .duo { display:flex; height:9px; border-radius:6px; overflow:hidden; background:var(--line); margin-top:4px; }
  .duo i { height:100%; display:block; }
  .scard .net { font-size:12.5px; font-variant-numeric:tabular-nums; margin-top:7px; }

  /* ---- bell dropdown ---- */
  .bell { position:relative; }
  .bell-btn { background:var(--panel); border:1px solid var(--line); border-radius:9px; cursor:pointer;
    font-size:15px; line-height:1; padding:6px 9px; color:var(--text); position:relative; }
  .bell-btn:hover { border-color:var(--muted); }
  .bell-badge { position:absolute; top:-6px; right:-6px; background:var(--down); color:#fff; font-size:10px;
    font-weight:700; min-width:16px; height:16px; border-radius:9px; padding:0 4px; display:none;
    align-items:center; justify-content:center; }
  .bell-badge.on { display:flex; }
  .bell-menu { position:absolute; right:0; top:calc(100% + 8px); width:340px; max-width:86vw; max-height:60vh;
    overflow-y:auto; background:var(--panel); border:1px solid var(--line); border-radius:12px;
    box-shadow:0 18px 44px rgba(0,0,0,.34); padding:8px; z-index:60; display:none; }
  .bell-menu.open { display:block; }
  .bell-menu .bhd { font-size:12px; font-weight:650; padding:4px 6px 7px; display:flex; align-items:center; gap:6px; border-bottom:1px solid var(--line); }
  .bell-item { display:block; padding:8px 7px; border-radius:8px; border-bottom:1px solid var(--line); cursor:pointer; }
  .bell-item:last-child { border-bottom:0; }
  .bell-item:hover { background:var(--panel2); }
  .bell-item .bi-hl { font-size:12.5px; font-weight:600; line-height:1.35; }
  .bell-item .bi-dt { font-size:10.5px; color:var(--muted); margin-top:2px; }
  .bell-empty { padding:14px 8px; color:var(--muted); font-size:12px; text-align:center; }
  .sect-tag { font-size:11px; color:var(--muted); border:1px solid var(--line); border-radius:6px; padding:1px 6px; font-weight:600; }
</style>
</head>
<body>
<nav class="site-nav">
    {% include "_navlinks.html.j2" %}
  <div class="nav-search">
    <span class="mag">🔎</span>
    <input type="text" autocomplete="off" aria-label="Search stocks"
      placeholder="Search any stock, ETF, commodity or crypto…" data-ph-zh="搜索任意股票、ETF、商品或加密货币…">
    <div class="nav-sugg"></div>
  </div>
  <div class="nav-ctrls">
    <div class="bell" id="theme-bell">
      <button class="bell-btn" id="bell-btn" aria-label="Theme alerts" title="Theme rotation alerts">🔔<span class="bell-badge" id="bell-badge"></span></button>
      <div class="bell-menu" id="bell-menu" role="menu"></div>
    </div>
    <a class="ai-brief-link" href="aibrief.html">🧠 {{ t('AI Daily Brief', 'AI每日简报') }}</a>
    <button class="theme-switch" aria-label="Toggle dark / light mode">
      <span class="ic sun">☀️</span><span class="ic moon">🌙</span><span class="knob"></span>
    </button>
    <div class="lang-toggle" role="group" aria-label="Language">
      <span class="pill"></span>
      <span class="opt en-opt" data-l="en">EN</span>
      <span class="opt zh-opt" data-l="zh">中文</span>
    </div>
  </div>
</nav>

  <header>
    <div style="display:flex;align-items:baseline;flex-wrap:wrap;gap:12px">
      <h1>🧺 {{ t('Thematic baskets', '主题篮子') }}</h1>
      <span class="asof"><span class="pfx">{{ t('as of', '截至') }} </span><span id="asof">—</span></span>
    </div>
    <p class="story" id="story"></p>
    <p class="tagline">{{ t(
      'Curated thematic stock baskets — every membership decision dated and documented; equal-weighted, monthly-rebalanced, buy-and-hold between rebalances. Where a listed sector ETF approximates the theme the basket is cross-checked against it daily. A monitoring/structure frame, not a buy list.',
      '精选主题股票篮子 — 每次成分调整均注明日期与理由；等权重、按月再平衡、调整间买入持有。若有相近行业 ETF，则按日交叉验证。仅作监测/结构参考，并非买入清单。') }}</p>
  </header>

  <!-- prevailing-narrative scorecard → the Narrative Rotation playbook (filled client-side) -->
  <section id="nr-scorecard" data-alloc="allocation.json" data-page="allocation.html"></section>

  <section id="theme-desk-section" style="margin-top:6px">
    <h2><span class="idx">★</span>🧭 {{ t('Theme Rotation Desk', '主题轮动台') }}
      <span class="sect-tag">{{ t('scored · labeled · actionable', '评分 · 标注 · 可执行') }}</span></h2>
    <p class="sub">{{ t(
      'Every theme scored 0–100 from transparent legs — trend, breadth, ±3% impulse, macro tailwind and a crowding penalty — then labeled (dominant / emerging / fading / deteriorating) with an actionable read. The verb accounts for dominant themes topping out vs less-dominant themes just emerging.',
      '每个主题以透明分项打分 0–100 — 趋势、广度、±3% 脉冲、宏观顺风与拥挤惩罚 — 并标注（主导／新兴／退潮／走弱）及可执行结论。结论会区分见顶的主导主题与刚刚新兴的次主导主题。') }}</p>
    <div class="mctx" id="macro-ctx"></div>
    <p class="muted" id="theme-disclaimer" style="font-size:11.5px;margin:0 0 11px"></p>
    <div class="desk" id="theme-desk"></div>
  </section>

  <section id="rotation-section">
    <h2><span class="idx">★</span>📆 {{ t('5-Day Theme Rotation', '5日主题轮动') }}
      <span class="sect-tag">{{ t('weekly climbers & fallers', '本周上升与下降') }}</span></h2>
    <p class="sub">{{ t(
      'Who moved this week — ranked by 5-day return relative to the S&P 500, with the change in 20-day relative-strength rank over the same 5 sessions. A fast read on which themes to lean into and which are losing the tape.',
      '本周谁在动 — 以相对标普 500 的 5 日回报排名，并标注同期 20 日相对强度排名的变化。快速判断该倾向哪些主题、哪些正在失去走势。') }}</p>
    <div class="rotwrap" id="rotation"></div>
  </section>

  <section id="impulse-section">
    <h2><span class="idx">★</span>⚡ {{ t('Impulse & Extremes', '脉冲与极值') }}
      <span class="sect-tag">{{ t('across the thematic universe', '覆盖全部主题成分') }}</span></h2>
    <p class="sub">{{ t(
      'Breadth of the daily move across every name in the baskets: how many jumped ≥3% vs fell ≥3% (impulse / volatility), and how many printed a fresh 52-week high vs low. Net counts read the tape\'s pressure at a glance.',
      '篮子内所有个股当日波动的广度：多少只上涨≥3%、多少只下跌≥3%（脉冲／波动），以及多少只创 52 周新高对新低。净数一眼读出走势压力。') }}</p>
    <div class="scards" id="scorecards"></div>
  </section>

  {% if flow %}
  {% set SZH = {'Information Technology':'信息技术','Health Care':'医疗保健','Financials':'金融','Consumer Discretionary':'非必需消费','Communication Services':'通信服务','Industrials':'工业','Consumer Staples':'必需消费','Energy':'能源','Utilities':'公用事业','Real Estate':'房地产','Materials':'原材料'} %}
  <div class="panel pad" id="flow-lens" style="margin-top:10px;border-left:3px solid var(--muted)">
    <h2 style="margin:0 0 4px"><span class="idx">00</span>🌐 {{ t('Flow lens — where rotation is concentrating', '资金流透视 — 轮动集中在哪里') }}
      <span class="chip" style="vertical-align:middle">{{ t('display-only', '仅展示') }}</span></h2>
    <p class="tagline" style="margin-top:0">{{ t(
      'A detection + description layer, NOT a forecast. It ranks where cross-sectional flow is concentrating across the unbiased point-in-time GICS sectors and the thematic baskets — rigorously validated to have NO forward edge (rank-IC ~0 on clean sectors; the basket "edge" was survivorship). Use it to focus attention; never to infer returns.',
      '这是探测+描述层，并非预测。它在无偏的时点 GICS 行业与主题篮子中，排出资金横截面集中之处 — 经严格验证无前瞻优势（干净行业上 rank-IC≈0；篮子的"优势"实为幸存者偏差）。用于聚焦关注，绝不用于推断收益。') }}</p>

    {% if flow.cluster %}{% set CL = flow.cluster %}
    <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:9px 12px;margin:6px 0;font-size:13px">
      <b>{{ t('Cross-group structure', '跨组结构') }}</b> <span class="muted">{{ t('supply-chain / theme-spread read', '供应链／主题扩散读数') }}</span><br>
      {{ t('co-movement', '共动度') }} <b>{{ (CL.absorption*100)|round|int }}%</b> ({{ t(CL.regime, {'concentrated':'高度集中','broad':'分散','mixed':'中等'}.get(CL.regime, CL.regime)) }})
      · {{ t('dominant cluster', '主导集群') }}: {% for s in CL.dominant_cluster %}<span class="chip">{{ t(s, SZH.get(s, s)) }}</span>{% endfor %}
      {% if CL.top_pair %}· {{ t('tightest pair', '最紧耦合') }} {{ t(CL.top_pair[0], SZH.get(CL.top_pair[0], CL.top_pair[0])) }} ↔ {{ t(CL.top_pair[1], SZH.get(CL.top_pair[1], CL.top_pair[1])) }} ({{ '%.2f'|format(CL.top_pair_corr) }}){% endif %}
    </div>
    {% endif %}

    <div class="story" style="margin:8px 0 2px">{{ t('Concentrating now', '当前集中') }}
      <span class="muted" style="font-size:12px">— {{ t('descriptive flow + read-quality bar; sectors are unbiased, baskets are hindsight-curated (confidence-capped). Do not rank one type against the other.', '描述性资金流 + 读数质量条；行业无偏，篮子为事后筛选（置信度封顶）。勿跨类型排名。') }}</span></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
      {% for col, label, lzh in [(flow.sectors, 'GICS sectors (unbiased)', 'GICS 行业（无偏）'), (flow.baskets, 'Thematic baskets (capped)', '主题篮子（封顶）')] %}
      <div>
        <div style="font-weight:650;font-size:12px;margin-bottom:3px">{{ t(label, lzh) }}</div>
        {% for g in col[:5] %}
        <div style="display:flex;align-items:center;gap:7px;margin:3px 0">
          <span style="flex:0 0 12px;font-size:11px" title="{{ g.stage }}">{{ {'emerging':'▲','confirmed':'●','cooling':'▽','quiet':'·'}.get(g.stage,'·') }}</span>
          <span style="flex:1;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ t(g.name, g.name_zh) }}{% if g.leadership.breadth=='narrow' %} <span class="chip" style="font-size:10px" title="one name dominates the move">⚠{{ t('narrow','集中') }}</span>{% endif %}</span>
          <div style="flex:0 0 56px;height:6px;background:var(--line);border-radius:4px;overflow:hidden"><div style="height:100%;width:{{ (g.read_quality*100)|round|int }}%;background:var(--muted)"></div></div>
          <span class="muted" style="flex:0 0 30px;text-align:right;font-size:10.5px">{{ '%.2f'|format(g.read_quality) }}</span>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>

    {% set RG = flow.regime %}
    {% set cohering = [] %}{% for g in (flow.sectors + flow.baskets) %}{% if g.cohesion_gate.stress_conditional %}{% set _ = cohering.append(g) %}{% endif %}{% endfor %}
    <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:9px 12px;margin:10px 0 4px;font-size:12.5px">
      <b>{{ t('Cohesion gate', '共动门') }}</b> <span class="muted">({{ t('context only · the one measured-but-modest edge, stress-conditional, 20d', '仅上下文 · 唯一实测但有限的边际信号，压力条件下，20日') }})</span><br>
      {% if RG.elevated and cohering %}⚠ {{ t('Stress regime AND groups cohering', '压力状态 且 多组共动') }}: {% for g in cohering %}<span class="chip">{{ t(g.name, g.name_zh) }}</span>{% endfor %} — {{ t('rotation may be forming (low confidence; a stress dispersion-recovery proxy, not inflows)', '轮动或在形成（低置信度；压力离散修复代理，并非资金流入）') }}
      {% else %}{{ t('inactive', '未激活') }} — {{ t('VIX', 'VIX') }} {% if RG.pctile is not none %}{{ (RG.pctile*100)|round|int }}%ile{% else %}—{% endif %} ({{ t('not a stress regime; cohesion only carries signal under stress', '非压力状态；共动仅在压力下才有意义') }}){% endif %}
    </div>

    <div class="muted" style="font-size:11.5px;margin-top:6px">{{ t('Verdict', '结论') }}: <b>{{ flow.verdict }}</b> · {{ t(
      'never scored, never an axis. The read-quality bar measures data/coherence, NOT directional confidence (there is none). Built on a ~3y cache; reconfirm as data accrues. This is the wide detector that focuses a separate inference layer — it does not draw conclusions itself.',
      '从不评分、绝不入轴。读数质量条衡量数据/一致性，而非方向置信度（不存在）。基于约3年缓存；随数据积累需复核。这是用于聚焦独立推断层的"宽探测器"，本身不下结论。') }}
      <a href="#" onclick="return false" class="muted" style="text-decoration:underline" title="See data/group_flow/validation_meta.json">{{ t('how this was validated', '验证方法') }}</a></div>
  </div>
  {% endif %}

  <div id="content">
    <section id="table-section">
      <h2><span class="idx">01</span>{{ t('Performance table', '表现一览') }}</h2>
      <p class="sub">{{ t(
        "All baskets, watchlist-style. Click a column to sort; toggle the value between raw return, vs S&P 500, and σ (the move z-scored vs the basket's own trailing year — computed horizons only). Click a name to jump to its members.",
        '全部篮子，自选股式表格。点击列标题排序；可在原始回报、相对标普 500、σ（相对该篮子自身过去一年的 z 分数 — 仅限定窗）之间切换。点击名称跳转至成分。') }}</p>
      <div class="chartbar"><span></span><span class="tabs" id="btbl-mode" role="group"></span></div>
      <div class="panel"><div class="ts"><table id="btable"></table></div></div>
    </section>

    <section id="chart-section">
      <h2><span class="idx">02</span>{{ t('Performance', '走势对比') }}</h2>
      <p class="sub">{{ t(
        'Rebased to 0% at the start of the selected window. Click legend entries to toggle baskets. The full "All" range is ~3 years (our free-cache ceiling); series before a basket\'s creation date are a backtest of the membership at creation. Powered by TradingView Lightweight Charts.',
        '在所选窗口起点重设为 0%。点击图例可切换篮子。"全部"区间约 3 年（免费缓存上限）；篮子创建日之前为按创建时成分的回测。由 TradingView Lightweight Charts 提供。') }}</p>
      <div class="chartbar">
        <span class="tabs" id="chart-modes" role="group"></span>
        <span class="tabs" id="chart-ranges" role="group"></span>
      </div>
      <div class="panel pad"><div id="chart"></div><div class="legend" id="chart-legend"></div></div>
    </section>

    <h2 id="categories"><span class="idx">03</span>{{ t('Baskets by category', '按类别分组') }}</h2>
    <div class="toolbar">
      <span class="lbl">{{ t('Horizon', '时间跨度') }}</span>
      <span class="tabs" id="hz-tabs" role="group"></span>
    </div>
    <div id="cards"></div>
    <div id="details"></div>
  </div>

  <footer>
    {{ t(
      'Read-only analytics for informational purposes only — not investment advice. Equal-weighted, point-in-time dated membership, buy-and-hold between changes, over the FREE S&P-1500 price cache (~3y). Membership was curated with knowledge of the period, so the series is HINDSIGHT-curated and descriptive — not an out-of-sample backtest and not a buy list. See LIMITATIONS.md.',
      '仅供参考的只读分析 — 非投资建议。等权重、按时点日期管理成分、调整间买入持有，基于免费标普 1500 价格缓存（约 3 年）。成分在已知该期间表现下整理，故为事后选取的描述性序列 — 并非样本外回测，也非买入清单。参见 LIMITATIONS.md。') }}
    {{ t('Generated', '生成于') }} <span id="gen">{{ generated_utc }}</span>.
  </footer>

<script src="lightweight-charts.js"></script>
<script>
const BASKETS = {{ baskets_json|safe }};
const CHART   = {{ chart_json|safe }};
const THEME   = BASKETS.theme_intel || null;
const THEME_ALERTS = {{ theme_alerts_json|safe }};
const L = (en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`;

const TBL_COLS = ['1d','5d','20d','60d','MTD','YTD'];
const TBL_MODES = [['raw','Raw'],['rel','vs S&P'],['sigma','σ']];
const RANGES = [['3M',63],['6M',126],['YTD','ytd'],['1Y',252],['All',0]];
const HZ_TABS = ['1d','5d','20d','60d','YTD'];
const PALETTE = ['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635','#38bdf8','#e879f9','#34d399','#fbbf24','#60a5fa'];
const colorOf = {}; (BASKETS.baskets||[]).forEach((b,i)=>colorOf[b.id]=PALETTE[i%PALETTE.length]);
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const BENCH_COLOR = () => cssv('--muted') || '#94a3b8';

const fmtPct = x => x==null ? '—' : (x>=0?'+':'')+(x*100).toFixed(1)+'%';
const fmtZ   = x => x==null ? '—' : (x>=0?'+':'')+x.toFixed(1)+'σ';
const cls    = x => x==null ? 'muted' : (x>=0?'pos':'neg');
const esc    = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const lastIdx = a => { for(let i=a.length-1;i>=0;i--) if(a[i]!=null) return i; return -1; };
const hzLabel = c => c==='ytd'?'YTD':c;

function startIdxFor(col,dates,li){
  const u = col.toUpperCase();
  if(u==='MTD'||u==='YTD'){ const p = dates[li].slice(0, u==='MTD'?7:4); let i=li; while(i>0 && dates[i-1].startsWith(p)) i--; return i>0?i-1:null; }
  const i = li-parseInt(col,10); return i>=0?i:null;
}
function winRet(levels,col){ if(!levels) return null; const li=lastIdx(levels); if(li<0) return null;
  const si=startIdxFor(col,CHART.dates,li); if(si==null||levels[si]==null) return null; return levels[li]/levels[si]-1; }
function winZ(levels,col){ const n=parseInt(col,10); if(!n||!levels) return null; const li=lastIdx(levels); if(li<252+n) return null;
  const hr=[]; for(let i=li-252;i<=li;i++) hr.push((levels[i]!=null&&levels[i-n]!=null)?levels[i]/levels[i-n]-1:null);
  const cur=hr[hr.length-1]; const base=hr.slice(0,-1).filter(v=>v!=null); if(cur==null||base.length<200) return null;
  const m=base.reduce((a,b)=>a+b,0)/base.length; const sd=Math.sqrt(base.reduce((a,b)=>a+(b-m)**2,0)/(base.length-1)); return sd>0?(cur-m)/sd:null; }
const ratio = a => a.map((v,i)=>(v!=null&&CHART.bench[i]!=null)?v/CHART.bench[i]:null);

function sparkSvg(values,{w=92,h=26,color=''}={}){
  const vs=(values||[]).filter(v=>v!=null); if(vs.length<2) return '';
  const min=Math.min(...vs),max=Math.max(...vs),span=(max-min)||1;
  const pts=vs.map((v,i)=>[i/(vs.length-1)*w, h-3-(v-min)/span*(h-7)]);
  const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
  const col = color || (vs[vs.length-1]>=vs[0]?cssv('--up'):cssv('--down'));
  const e=pts[pts.length-1];
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><path d="${d}" fill="none" stroke="${col}" stroke-width="1.4"/><circle cx="${e[0].toFixed(1)}" cy="${e[1].toFixed(1)}" r="1.6" fill="${col}"/></svg>`;
}
const sparkTail = (levels,n=60) => (levels||[]).filter(x=>x!=null).slice(-n);

function renderTabs(el, opts, active, cb){
  el.innerHTML = opts.map(([v,lab])=>`<button data-v="${v}" class="${v==active?'on':''}">${lab}</button>`).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{ el.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); cb(b.dataset.v); });
}

// ---- 01 table -------------------------------------------------------------
let btblMode = localStorage.getItem('fw-btbl-mode')||'rel';
let btblSort = JSON.parse(localStorage.getItem('fw-btbl-sort')||'{"col":"20d","dir":-1}');
function renderBTable(){
  const rows = Object.entries(CHART.baskets).map(([id,lv])=>{
    const b=(BASKETS.baskets||[]).find(x=>x.id===id); const rl=ratio(lv);
    const src = btblMode==='raw'?lv:rl;
    const vals={}; TBL_COLS.forEach(c=>{ vals[c]= btblMode==='sigma' ? (/^\d/.test(c)?winZ(rl,c):null) : winRet(src,c); });
    return {id,name:b?b.name:id,color:colorOf[id]||'#888',spark:sparkTail(src),vals};
  });
  const sc=btblSort.col, dir=btblSort.dir;
  rows.sort((a,b)=>{ if(sc==='name') return a.name.localeCompare(b.name)*dir;
    const x=a.vals[sc], y=b.vals[sc]; if(x==null) return 1; if(y==null) return -1; return (x-y)*dir; });
  const fmt = btblMode==='sigma' ? fmtZ : fmtPct;
  const th = c => `<th class="num ${c===sc?'sel':''}" data-c="${c}">${c}${c===sc?(dir<0?' ▾':' ▴'):''}</th>`;
  let html = `<thead><tr><th data-c="name">Basket${sc==='name'?(dir<0?' ▾':' ▴'):''}</th><th class="num">60d</th>${TBL_COLS.map(th).join('')}</tr></thead><tbody>`;
  html += rows.map(r=>`<tr><td class="bname" data-id="${r.id}"><span class="dot" style="background:${r.color}"></span>${esc(r.name)}</td>
    <td class="num">${sparkSvg(r.spark,{color:r.color})}</td>
    ${TBL_COLS.map(c=>`<td class="num ${cls(r.vals[c])}">${r.vals[c]==null?'<span class="muted">—</span>':fmt(r.vals[c])}</td>`).join('')}</tr>`).join('');
  if(btblMode==='raw'){ const bv={}; TBL_COLS.forEach(c=>bv[c]=winRet(CHART.bench,c));
    html += `<tr><td class="bname" style="font-weight:500"><span class="dot" style="background:${BENCH_COLOR()}"></span>S&amp;P 500</td><td></td>${TBL_COLS.map(c=>`<td class="num ${cls(bv[c])}">${fmtPct(bv[c])}</td>`).join('')}</tr>`; }
  html += '</tbody>';
  const tbl=document.getElementById('btable'); tbl.innerHTML=html;
  tbl.querySelectorAll('th[data-c]').forEach(h=>h.onclick=()=>{ const c=h.dataset.c;
    if(c===btblSort.col) btblSort.dir*=-1; else btblSort={col:c,dir:c==='name'?1:-1};
    localStorage.setItem('fw-btbl-sort',JSON.stringify(btblSort)); renderBTable(); });
  tbl.querySelectorAll('.bname[data-id]').forEach(n=>n.onclick=()=>openBasket(n.dataset.id));
}

// ---- 02 chart -------------------------------------------------------------
let chart=null, chartMode='rel', chartRange=252, hidden={};
function chartSets(){
  const sets=Object.entries(CHART.baskets).map(([id,levels])=>{ const b=(BASKETS.baskets||[]).find(x=>x.id===id);
    return {key:id,label:b?b.name:id,color:colorOf[id]||'#888',levels}; });
  if(chartMode==='rel') return sets.map(s=>({...s,levels:ratio(s.levels)}));
  return [...sets,{key:'bench',label:'S&P 500',color:BENCH_COLOR(),levels:CHART.bench}];
}
function rangeStart(dates){ if(chartRange==='ytd'){ const y=dates[dates.length-1].slice(0,4); const i=dates.findIndex(d=>d.startsWith(y)); return i<=0?0:i-1; }
  return chartRange?Math.max(0,dates.length-chartRange):0; }
function chartOpts(){ return { autoSize:true,
  layout:{ background:{type:'solid',color:'transparent'}, textColor:cssv('--muted')||'#9aa4b2', fontSize:11 },
  grid:{ vertLines:{visible:false}, horzLines:{color:cssv('--line')||'#222'} },
  rightPriceScale:{ borderColor:cssv('--line')||'#222' }, timeScale:{ borderColor:cssv('--line')||'#222' },
  crosshair:{ mode:0, vertLine:{labelBackgroundColor:cssv('--panel2')||'#333'}, horzLine:{labelBackgroundColor:cssv('--panel2')||'#333'} } }; }
function renderChart(){
  const el=document.getElementById('chart'); if(typeof LightweightCharts==='undefined'){ el.innerHTML='<p class="muted">The charting library failed to load — the rest of the page is unaffected.</p>'; return; }
  if(!chart){ chart=LightweightCharts.createChart(el,chartOpts()); }
  (chart.__series||[]).forEach(s=>chart.removeSeries(s)); chart.__series=[];
  const start=rangeStart(CHART.dates);
  const sets=chartSets().filter(s=>!hidden[s.key]); const nVis=sets.length;
  sets.forEach(set=>{
    let base=null; const data=[];
    for(let i=start;i<CHART.dates.length;i++){ const v=set.levels[i]; if(v==null) continue; if(base===null) base=v; data.push({time:CHART.dates[i], value:100*(v/base-1)}); }
    if(data.length<2) return;
    const s=chart.addLineSeries({ color:set.color, lineWidth:2, priceLineVisible:false, lastValueVisible:nVis<=4, title:nVis<=4?set.label:'',
      priceFormat:{type:'custom',minMove:0.01,formatter:v=>(v>=0?'+':'')+v.toFixed(1)+'%'} });
    s.setData(data); chart.__series.push(s);
  });
  chart.timeScale().fitContent(); renderChartLegend();
}
function renderChartLegend(){
  const el=document.getElementById('chart-legend'); const st=rangeStart(CHART.dates);
  el.innerHTML=chartSets().map(s=>{ const li=lastIdx(s.levels); let base=null; for(let i=st;i<=li;i++){ if(s.levels[i]!=null){ base=s.levels[i]; break; } }
    const v=(base!=null&&s.levels[li]!=null)?100*(s.levels[li]/base-1):null;
    return `<span class="lchip ${hidden[s.key]?'off':''}" data-k="${s.key}"><span class="dot" style="background:${s.color}"></span>${esc(s.label)} <span class="lv">${v==null?'':(v>=0?'+':'')+v.toFixed(1)+'%'}</span></span>`;
  }).join('');
  el.querySelectorAll('.lchip').forEach(c=>c.onclick=()=>{ hidden[c.dataset.k]=!hidden[c.dataset.k]; renderChart(); });
}
function initChartDefaults(){
  const ranked=(BASKETS.baskets||[]).slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0));
  ranked.slice(6).forEach(b=>hidden[b.id]=true);
}

// ---- 03 cards + details ---------------------------------------------------
let bhz = localStorage.getItem('fw-hz')||'20d';
function kpi(k,p){ const v=p?p.rel:null; return `<div class="kpi"><div class="v ${cls(v)}">${fmtPct(v)}</div><div class="k">${k} vs S&P</div></div>`; }
function renderCards(){
  const el=document.getElementById('cards');
  el.innerHTML=(BASKETS.categories||[]).map(cat=>{
    const cards=(BASKETS.baskets||[]).filter(b=>b.category===cat)
      .sort((a,c)=>((c.perf?.[bhz]?.rel)??-9)-((a.perf?.[bhz]?.rel)??-9))
      .map(b=>{ const spk=sparkTail(ratio(CHART.baskets[b.id]));
        const ref=b.reference?` · tracks ${esc(b.reference.label)} (r ${b.reference.corr.toFixed(2)})`:'';
        return `<div class="card" style="--c:${colorOf[b.id]}" data-id="${b.id}">
          <div class="nm"><span class="dot" style="background:${colorOf[b.id]}"></span>${esc(b.name)}</div>
          <div class="meta">${b.n_members} members · equal-weighted · since ${esc(b.created)}${ref}</div>
          <div class="th">${esc(b.thesis)}</div>
          <div class="perf">${kpi(hzLabel(bhz),b.perf?.[bhz])}${kpi('YTD',b.perf?.ytd)}<span class="spark">${sparkSvg(spk,{w:96,h:30,color:colorOf[b.id]})}</span></div>
        </div>`; }).join('');
    return cards?`<h3 class="cat">${esc(cat)}</h3><div class="cards">${cards}</div>`:'';
  }).join('');
  el.querySelectorAll('.card').forEach(c=>c.onclick=()=>openBasket(c.dataset.id));
}
function memRows(b){ return (b.members||[]).map(m=>`<tr><td><b>${esc(m.symbol)}</b> <span class="muted sm">${esc(m.name)}</span></td>
  <td class="why">${esc(m.rationale)}</td><td class="num muted sm">${esc(m.added)}</td>
  <td class="num ${cls(m.ret_20d)}">${fmtPct(m.ret_20d)}</td><td class="num ${cls(m.ret_ytd)}">${fmtPct(m.ret_ytd)}</td></tr>`).join(''); }
function detailSection(b){
  const p=b.perf||{}; const kr=(k,h)=>`<div><div class="k">${k} vs S&P</div><div class="v ${cls(p[h]?.rel)}">${fmtPct(p[h]?.rel)}</div></div>`;
  const ref=b.reference?`<p class="refline">Cross-checked vs <b>${esc(b.reference.label)}</b>${b.reference.name?' — '+esc(b.reference.name):''}: daily correlation <b>${b.reference.corr.toFixed(2)}</b>, market-adjusted <b>${b.reference.rel_corr.toFixed(2)}</b> over ${b.reference.n} sessions. <span class="muted">(market-adjusted strips shared market beta — basket−S&P vs ETF−S&P.)</span></p>`:'';
  const warns=[]; if((b.missing||[]).length) warns.push(`<span class="warn">excluded (not in free cache): ${b.missing.map(esc).join(', ')}</span>`);
  (b.partial||[]).forEach(pp=>warns.push(`<span class="warn">${esc(pp.symbol)} enters ${esc(pp.from)}</span>`));
  const clog=(b.changelog||[]).map(c=>`<li><b>${esc(c.date)}</b> — ${esc(c.action)}: ${esc(c.note)}</li>`).join('');
  return `<div class="detail" id="b-${b.id}"><h4><span class="dot" style="background:${colorOf[b.id]}"></span>${esc(b.name)} <span class="chip">${esc(b.category)}</span></h4>
    <p class="th">${esc(b.thesis)}</p>
    <div class="kpirow">${kr('20d','20d')}${kr('60d','60d')}${kr('MTD','mtd')}${kr('YTD','ytd')}${kr('Full','full')}</div>
    ${ref}<div>${warns.join(' ')}</div>
    <details open><summary>Members (${b.n_members}) &amp; changelog</summary>
      <div class="ts"><table><thead><tr><th>Symbol</th><th>Rationale</th><th class="num">Added</th><th class="num">20d</th><th class="num">YTD</th></tr></thead><tbody>${memRows(b)}</tbody></table></div>
      <ul class="clog">${clog}</ul>
    </details></div>`;
}
function renderDetails(){
  const el=document.getElementById('details');
  el.innerHTML=(BASKETS.categories||[]).map(cat=>(BASKETS.baskets||[]).filter(b=>b.category===cat)
    .sort((a,c)=>((c.perf?.[bhz]?.rel)??-9)-((a.perf?.[bhz]?.rel)??-9)).map(detailSection).join('')).join('');
}
function openBasket(id){ const d=document.getElementById('b-'+id); if(!d) return; const det=d.querySelector('details'); if(det) det.open=true; d.scrollIntoView({behavior:'smooth',block:'start'}); }

function renderStory(){
  const s=BASKETS.story; if(!s) return;
  const dot=id=>`<span class="dot" style="background:${colorOf[id]||'#888'}"></span>`;
  const lead=(BASKETS.baskets||[]).find(b=>b.name===s.leader), lag=(BASKETS.baskets||[]).find(b=>b.name===s.laggard);
  document.getElementById('story').innerHTML =
    `${lead?dot(lead.id):''}<b>${esc(s.leader)}</b> leads the themes over 20 days (<span class="${cls(s.leader_rel)}">${fmtPct(s.leader_rel)}</span> vs S&amp;P) · ${lag?dot(lag.id):''}<b>${esc(s.laggard)}</b> lags (<span class="${cls(s.laggard_rel)}">${fmtPct(s.laggard_rel)}</span>) · <b>${s.n_baskets}</b> baskets across <b>${s.n_cats}</b> categories.`;
}

// ---- Theme Rotation Desk --------------------------------------------------
const LABEL_COLOR = {
  dominant:      ['rgba(250,204,21,.16)','rgba(250,204,21,.55)','#eab308'],
  emerging:      ['rgba(74,222,128,.15)','rgba(74,222,128,.5)','#22c55e'],
  fading:        ['rgba(251,146,60,.15)','rgba(251,146,60,.5)','#f97316'],
  deteriorating: ['rgba(248,113,113,.15)','rgba(248,113,113,.5)','#ef4444'],
  neutral:       ['var(--panel2)','var(--line)','var(--muted)'],
};
const RECO_COLOR = {
  enter:      ['rgba(34,197,94,.20)','rgba(34,197,94,.65)','#16a34a'],
  accumulate: ['rgba(74,222,128,.14)','rgba(74,222,128,.5)','#22c55e'],
  hold:       ['var(--panel2)','var(--line)','var(--muted)'],
  trim:       ['rgba(251,146,60,.15)','rgba(251,146,60,.55)','#f97316'],
  avoid:      ['rgba(248,113,113,.16)','rgba(248,113,113,.6)','#ef4444'],
};
const badge = (cls,c,en,zh)=>`<span class="${cls}" style="background:${c[0]};border:1px solid ${c[1]};color:${c[2]}">${L(en,zh)}</span>`;
const COMP_COLOR = {trend:'#5aa7ff',breadth:'#4ade80',impulse:'#a78bfa',macro:'#2dd4bf',crowding:'#fb7185'};
const COMP_LBL = {trend:['trend','趋势'],breadth:['breadth','广度'],impulse:['impulse','脉冲'],macro:['macro','宏观'],crowding:['crowd','拥挤']};

function compBar(c,w){
  const parts=['trend','breadth','impulse','macro'].map(k=>({k,v:Math.max(0,(c[k]||0))*w[k]}));
  parts.push({k:'crowding',v:(c.crowding||0)*w.crowding});
  const tot=parts.reduce((a,p)=>a+Math.abs(p.v),0)||1;
  const segs=parts.filter(p=>Math.abs(p.v)>0.001).map(p=>`<i style="width:${(Math.abs(p.v)/tot*100).toFixed(1)}%;background:${COMP_COLOR[p.k]};${p.k==='crowding'?'opacity:.55':''}"></i>`).join('');
  return `<div class="cbar" title="contribution to the score">${segs}</div>`;
}
function compLegend(c){
  return `<div class="clegend">`+['trend','breadth','impulse','macro','crowding'].map(k=>{
    const v=c[k]; const s=(v==null)?'—':((k==='crowding'?'−':(v>=0?'+':''))+Math.abs(v).toFixed(2));
    return `<span><span class="sw" style="background:${COMP_COLOR[k]}"></span>${L(COMP_LBL[k][0],COMP_LBL[k][1])} <b>${s}</b></span>`;
  }).join('')+`</div>`;
}
function themeCard(t){
  const lc=LABEL_COLOR[t.label]||LABEL_COLOR.neutral, rc=RECO_COLOR[t.reco]||RECO_COLOR.hold;
  const r20=t.perf&&t.perf['20d']?t.perf['20d'].rel:null;
  const spk=sparkTail(ratio(CHART.baskets[t.id]||[]),40);
  const b=t.breadth||{}, im=t.impulse||{};
  const top=(t.leadership&&t.leadership.top)||[];
  return `<div class="tcard" id="theme-${t.id}" style="--tc:${lc[2]}">
    <div class="top">
      ${badge('tlabel',lc,t.label_en,t.label_zh)}
      <span class="nm">${L(esc(t.name),esc(t.name_zh))}</span>
      <span class="sc">${t.score}<small>/100</small></span>
    </div>
    <div class="subrow">
      <span>#${t.rank}</span>
      ${badge('treco',rc,t.reco_en,t.reco_zh)}
      <span class="${cls(r20)}">${fmtPct(r20)} 20d</span>
      <span class="spark">${sparkSvg(spk,{w:84,h:24,color:lc[2]})}</span>
    </div>
    ${compBar(t.components,(THEME&&THEME.weights)||{trend:.34,breadth:.22,impulse:.10,macro:.20,crowding:.14})}
    <div class="treason">${esc((t.reasons||[]).join(' · '))}</div>
    <div class="tstats">
      <span class="tpill">${L('above 50d','站上50日')} <b>${b.pct50==null?'—':Math.round(b.pct50*100)+'%'}</b></span>
      <span class="tpill">${L('+3% / −3%','+3% / −3%')} <b class="pos">${im.up3||0}</b>/<b class="neg">${im.down3||0}</b></span>
      <span class="tpill">${L('new hi/lo','新高/低')} <b class="pos">${b.nh||0}</b>/<b class="neg">${b.nl||0}</b></span>
    </div>
    <details><summary>${L('why &amp; components','理由与分项')}</summary>
      <div class="why">${L(esc(t.reco_why_en),esc(t.reco_why_zh))}</div>
      ${compLegend(t.components)}
      ${top.length?`<div class="why">${L('leaders','领涨')}: ${top.map(x=>esc(x.ticker)).join(', ')}${t.leadership.breadth==='narrow'?' ⚠':''}</div>`:''}
    </details>
  </div>`;
}
function renderThemeDesk(){
  const sec=document.getElementById('theme-desk-section');
  if(!THEME||!(THEME.themes||[]).length){ if(sec) sec.style.display='none'; return; }
  document.getElementById('theme-desk').innerHTML=(THEME.themes||[]).map(themeCard).join('');
  const d=THEME.disclaimer||{}; document.getElementById('theme-disclaimer').innerHTML=L(esc(d.en||''),esc(d.zh||''));
}
function renderMacroCtx(){
  if(!THEME) return;
  const m=THEME.macro_context||{};
  const item=(en,zh,v)=>`<span><span class="mc-k">${L(en,zh)}:</span> <b>${esc(v==null?'—':v)}</b></span>`;
  document.getElementById('macro-ctx').innerHTML=
    `<span>${L('Macro backdrop','宏观背景')}: <b>${esc(m.quad_name||m.quad||'—')}</b></span>`
    +item('cycle','周期',m.cycle)+item('Fed','美联储',m.fed_dir)
    +item('NFCI','NFCI',(m.nfci_state||'—')+(m.nfci_trend?(' / '+m.nfci_trend):''))
    +item('USD','美元',m.dollar_regime)+item('bonds','债券',m.bond_cycle);
}
function renderRotation(){
  const sec=document.getElementById('rotation-section');
  if(!THEME||!THEME.rotation_5d){ if(sec) sec.style.display='none'; return; }
  const rot=THEME.rotation_5d;
  const row=t=>{const ar=t.rank_5d>0?'▲':t.rank_5d<0?'▼':'·'; const ac=t.rank_5d>0?'pos':t.rank_5d<0?'neg':'muted';
    return `<div class="rotrow"><span class="rn"><a href="#theme-${t.id}" onclick="openTheme('${t.id}');return false">${L(esc(t.name),esc(t.name_zh))}</a></span>
      <span class="rv ${cls(t.delta_5d)}">${fmtPct(t.delta_5d)}</span>
      <span class="rk ${ac}" title="20d RS rank change">${ar}${t.rank_5d?Math.abs(t.rank_5d):''}</span></div>`;};
  const col=(en,zh,emo,arr)=>`<div class="rotcol"><h4>${emo} ${L(en,zh)}</h4>${arr.length?arr.map(row).join(''):`<div class="muted sm" style="padding:6px 0">${L('none','无')}</div>`}</div>`;
  document.getElementById('rotation').innerHTML=col('Weekly climbers','本周上升','▲',rot.climbers||[])+col('Weekly fallers','本周下降','▽',rot.fallers||[]);
}
function renderScorecards(){
  const sec=document.getElementById('impulse-section');
  if(!THEME||!THEME.impulse_scorecard){ if(sec) sec.style.display='none'; return; }
  const s=THEME.impulse_scorecard, rc=THEME.recommendations||{};
  const duo=(a,b)=>{const t=(a+b)||1;return `<div class="duo"><i style="width:${a/t*100}%;background:var(--up)"></i><i style="width:${b/t*100}%;background:var(--down)"></i></div>`;};
  const cnt=k=>(rc[k]||[]).length;
  const c1=`<div class="scard"><div class="sk">${L('±3% daily impulse','±3% 当日脉冲')}</div>
    <div class="bigrow"><div><div class="big up">${s.up3}</div><div class="sublbl">${L('up ≥3%','涨≥3%')}</div></div>
    <div><div class="big dn">${s.down3}</div><div class="sublbl">${L('down ≥3%','跌≥3%')}</div></div></div>
    ${duo(s.up3,s.down3)}<div class="net">${L('net','净')} <b class="${cls(s.net)}">${s.net>=0?'+':''}${s.net}</b> ${L('of '+s.n+' names',' ／共 '+s.n+' 只')}</div></div>`;
  const c2=`<div class="scard"><div class="sk">${L('52-week extremes','52周极值')}</div>
    <div class="bigrow"><div><div class="big up">${s.nh}</div><div class="sublbl">${L('new highs','新高')}</div></div>
    <div><div class="big dn">${s.nl}</div><div class="sublbl">${L('new lows','新低')}</div></div></div>
    ${duo(s.nh,s.nl)}<div class="net">${L('net','净')} <b class="${cls(s.net_hl)}">${s.net_hl>=0?'+':''}${s.net_hl}</b></div></div>`;
  const c3=`<div class="scard"><div class="sk">${L('recommendation tally','建议统计')}</div>
    <div class="bigrow" style="gap:12px;flex-wrap:wrap">
      <div><div class="big up">${cnt('enter')+cnt('accumulate')}</div><div class="sublbl">${L('enter / add','建仓／加仓')}</div></div>
      <div><div class="big" style="color:var(--muted)">${cnt('hold')}</div><div class="sublbl">${L('hold','持有')}</div></div>
      <div><div class="big dn">${cnt('trim')+cnt('avoid')}</div><div class="sublbl">${L('trim / avoid','减仓／回避')}</div></div>
    </div></div>`;
  document.getElementById('scorecards').innerHTML=c1+c2+c3;
}
function openTheme(id){const d=document.getElementById('theme-'+id);if(!d)return;const det=d.querySelector('details');if(det)det.open=true;
  d.scrollIntoView({behavior:'smooth',block:'center'});d.style.transition='box-shadow .3s';d.style.boxShadow='0 0 0 2px var(--link)';setTimeout(()=>{d.style.boxShadow='';},1200);}

function renderBell(){
  const wrap=document.getElementById('theme-bell'); if(!wrap) return;
  const btn=document.getElementById('bell-btn'), menu=document.getElementById('bell-menu'), badgeEl=document.getElementById('bell-badge');
  const evs=(THEME_ALERTS||[]).slice(0,12);
  const SEEN='fw-theme-bell-seen', lastSeen=localStorage.getItem(SEEN)||'';
  const unread=evs.filter(e=>e.ts>lastSeen).length;
  if(unread>0){ badgeEl.textContent=unread>9?'9+':String(unread); badgeEl.classList.add('on'); }
  const ago=ts=>{const dd=Math.floor((Date.now()-new Date(ts).getTime())/86400000);return dd<=0?L('today','今日'):dd===1?L('1d ago','1天前'):L(dd+'d ago',dd+'天前');};
  menu.innerHTML=`<div class="bhd">🧺 ${L('Theme rotation alerts','主题轮动警报')}<span style="flex:1"></span><a href="alerts.html" class="muted" style="font-size:11px;text-decoration:underline">${L('Alert Center →','警报中心 →')}</a></div>`+
    (evs.length?evs.map(e=>`<div class="bell-item" data-id="${esc(e.asset)}">
      <div class="bi-hl">${L(esc(e.headline),esc(e.headline_zh||e.headline))}</div>
      <div class="bi-dt">${ago(e.ts)}</div></div>`).join(''):`<div class="bell-empty">${L('No recent theme changes — recommendations are steady.','近期无主题变化 — 建议保持稳定。')}</div>`);
  btn.onclick=ev=>{ev.stopPropagation();const open=menu.classList.toggle('open');
    if(open){badgeEl.classList.remove('on'); if(evs.length) localStorage.setItem(SEEN,evs[0].ts);}};
  menu.querySelectorAll('.bell-item').forEach(it=>it.onclick=()=>{menu.classList.remove('open');openTheme(it.dataset.id);});
  document.addEventListener('click',e=>{ if(!wrap.contains(e.target)) menu.classList.remove('open'); });
}

function boot(){
  document.getElementById('asof').textContent=BASKETS.as_of||'—';
  renderMacroCtx(); renderThemeDesk(); renderRotation(); renderScorecards(); renderBell();
  renderStory();
  renderTabs(document.getElementById('btbl-mode'), TBL_MODES, btblMode, v=>{ btblMode=v; localStorage.setItem('fw-btbl-mode',v); renderBTable(); });
  renderTabs(document.getElementById('chart-modes'), [['rel','vs S&P 500'],['abs','Absolute']], chartMode, v=>{ chartMode=v; renderChart(); });
  const rel=document.getElementById('chart-ranges');
  rel.innerHTML=RANGES.map(([lab,v])=>`<button data-v="${v}" class="${v===chartRange?'on':''}">${lab}</button>`).join('')+`<input class="rangeN" type="number" min="5" max="600" placeholder="N days">`;
  rel.querySelectorAll('button').forEach(b=>b.onclick=()=>{ chartRange=(b.dataset.v==='ytd')?'ytd':parseInt(b.dataset.v,10); rel.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); renderChart(); });
  rel.querySelector('.rangeN').onchange=function(){ const n=Math.min(600,Math.max(5,parseInt(this.value,10)||252)); chartRange=n; rel.querySelectorAll('button').forEach(x=>x.classList.remove('on')); renderChart(); };
  renderTabs(document.getElementById('hz-tabs'), HZ_TABS.map(h=>[h,hzLabel(h)]), bhz, v=>{ bhz=v; localStorage.setItem('fw-hz',v); renderCards(); renderDetails(); });
  initChartDefaults();
  renderBTable(); renderChart(); renderCards(); renderDetails();
  if(location.hash.startsWith('#b-')) setTimeout(()=>openBasket(location.hash.slice(3)),200);
  if(location.hash.startsWith('#theme-')) setTimeout(()=>openTheme(location.hash.slice(7)),250);
  document.addEventListener('langchange',()=>{ if(chart){chart.applyOptions(chartOpts());} renderChart(); });
  document.addEventListener('themechange',()=>{ if(chart){chart.applyOptions(chartOpts());} renderChart(); });
}
if(document.readyState!=='loading') boot(); else document.addEventListener('DOMContentLoaded',boot);
</script>
<script src="allocation_scorecard.js"></script>
<script src="theme.js"></script>
</body>
</html>
