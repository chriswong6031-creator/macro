.rvx-fbtn{font:inherit;font-size:12px;padding:5px 11px;border-radius:9px;cursor:pointer;color:var(--muted);background:var(--gbtn-bg);border:1px solid var(--gbtn-brd);box-shadow:inset 0 1px 0 var(--gbtn-sheen);transition:.15s}
.rvx-fbtn:hover{background:var(--gbtn-bg-hover);color:var(--text)}
.rvx-fbtn.on{color:var(--text);border-color:var(--gbtn-brd-hover);background:color-mix(in srgb,var(--info) 16%,var(--gbtn-bg))}
.rvx-fbtn .fc{font-family:var(--rvx-num);opacity:.7;margin-left:4px}
.rvx-brow{display:grid;grid-template-columns:22px minmax(0,1.6fr) 54px 48px 60px 50px 32px;gap:9px;align-items:center;padding:9px 6px;border-top:1px solid var(--rvx-hair);text-decoration:none;color:var(--text);border-radius:8px;animation:rvxRowPop .4s ease both}
@keyframes rvxRowPop{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.rvx-brow:hover{background:color-mix(in srgb,var(--panel2) 50%,transparent)}
.rvx-brow .rk{font-family:var(--rvx-num);font-size:11px;color:var(--muted);text-align:right}
.rvx-brow .bnm{font-weight:600;font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rvx-brow .bnm .cat{font-size:10px;color:var(--muted);font-weight:400}
.rvx-scorebar{height:7px;border-radius:4px;background:color-mix(in srgb,var(--text) 8%,transparent);overflow:hidden;position:relative}
.rvx-scorebar i{position:absolute;inset:0 auto 0 0;border-radius:4px}
.rvx-stag{font-size:10px;font-weight:700;padding:2px 6px;border-radius:6px;text-align:center;white-space:nowrap}
.rvx-brow .mv{font-family:var(--rvx-num);font-size:12px;font-weight:600;text-align:right}
.rvx-brow .spark{height:24px} .rvx-vel{font-family:var(--rvx-num);font-size:11px;text-align:right;font-weight:600}
.rvx-qdot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:5px;vertical-align:middle;flex:none}

/* ── INTERNALS ── */
.rvx-internals{display:grid;grid-template-columns:1.2fr repeat(4,minmax(0,1fr));gap:13px}
.rvx-gcard{padding:14px;border-radius:13px;border:1px solid var(--rvx-hair);background:color-mix(in srgb,var(--panel) 68%,transparent);text-align:center}
