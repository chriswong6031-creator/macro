    </section>

    <section id="chart-section">
      <h2>{{ t('Performance', '走势对比') }}</h2>
      <p class="sub">{{ t(
        'Lines are rebased to 0% at the start of the window. Toggle baskets from the legend; "All" covers the available cache history.',
        '曲线在窗口起点重设为 0%。可在图例中开关篮子；"全部"覆盖可用缓存历史。') }}</p>
      <div class="chartbar">
        <span class="tabs" id="chart-modes" role="group"></span>
        <span class="tabs" id="chart-ranges" role="group"></span>
      </div>
      <div class="panel pad"><div id="chart"></div><div class="legend" id="chart-legend"></div></div>
    </section>

  </div>

  <!-- W2a: hidden live-price spans for basket members so build_live_quotes.scrape_site_symbols
       picks up all ~683 member tickers from this top-level site/baskets.html file.
       The scraper reads site/*.html for data-sym attributes (not site/basket/ subdirs).
       Universe expands after next render+scrape cycle. (FTR W2a) -->
  {% if basket_member_syms is defined and basket_member_syms %}
