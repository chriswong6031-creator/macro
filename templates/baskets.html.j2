<script src="lightweight-charts.js"></script>
<script>
const BASKETS = {{ baskets_json|safe }};
const CHART   = {{ chart_json|safe }};
const THEME   = BASKETS.theme_intel || null;
const THEME_ALERTS = {{ theme_alerts_json|safe }};
/* FIX 1c — strip "(Equal-Weight)" / "（等权）" suffixes from all string values at boot.
   deepStrip covers THEME (same object ref inside BASKETS) and the THEME_ALERTS array. */
function deepStrip(obj) {
  if (!obj || typeof obj !== 'object') return;
  const ewRe = /\s*[（(]\s*(?:equal[-\s]?weight(?:ed)?|等权(?:重)?)\s*[）)]/gi;
  for (const k of Object.keys(obj)) {
    const v = obj[k];
    if (typeof v === 'string') obj[k] = v.replace(ewRe, '');
    else if (v && typeof v === 'object') deepStrip(v);
  }
}
deepStrip(BASKETS); deepStrip(THEME_ALERTS);
const L = (en,zh)=>`<span class="l-en">${en}</span><span class="l-zh">${zh==null?en:zh}</span>`;
// ---- Velocity / Heat helpers (W4 rotation-scorecard upgrade) ------------------
// All labels are DESCRIPTIVE — they characterise current rank/score trajectory; no
// forward-return forecast is implied (house rule: honest framing).
const HEAT_PILL = {
  heating: ['heat-pill heating', '▲', 'heating', '加热'],
  hot:     ['heat-pill hot',     '★', 'hot',     '强势'],
  cooling: ['heat-pill cooling', '▽', 'cooling', '降温'],
  broken:  ['heat-pill broken',  '✕', 'broken',  '破位'],
};
function heatDot(t){
  const h = t && t.pulse_heat;
  if(!h || h==='idle') return '';
  const p = HEAT_PILL[h];
  if(!p) return '';
  return `<span class="${p[0]} heat-dot" data-tip-en="${esc(p[2])} — descriptive" data-tip-zh="${esc(p[3])} — 描述性"></span>`;
}
function rankTrajectory(t){
  const r5 = t && t.pulse_rank_delta_5d;
  const r20 = t && t.pulse_rank_delta_20d;
  if(r5 == null) return '';
  const fmt5 = (r5>0?'▲':'▼')+Math.abs(r5);
  const fmt20 = r20!=null ? ' · 20d '+(r20>0?'▲':'▼')+Math.abs(r20) : '';
  return fmt5 + fmt20;
}
function actNowPulseBar(themes){
  const sizePill = renderRegimeSizing();
  const byHeat = h => (themes||[]).filter(t=>t.pulse_heat===h).sort((a,b)=>(a.rank||999)-(b.rank||999)).slice(0,3);
  const heating = byHeat('heating'), cooling = byHeat('cooling');
  const BASE = window.BASKET_BASE||'basket/';
  const links = arr => arr.map(t=>`<a href="${BASE}${encodeURIComponent(t.id)}.html">${L(esc(t.name),esc(t.name_zh))}</a>`).join(', ');
  const parts = [];
  if(sizePill) parts.push(sizePill);
  if(heating.length) parts.push(`<span class="pulse-grp">🔥 ${L('Heating','加热')}: ${links(heating)}</span>`);
  if(cooling.length) parts.push(`<span class="pulse-grp">❄ ${L('Cooling','降温')}: ${links(cooling)}</span>`);
  if(!parts.length) return '';
  return `<div class="pulse-bar">${parts.join('')}</div>`;
}

const TBL_COLS = ['1d','5d','20d','60d','MTD','YTD'];
const TBL_MODES = [['raw','Raw'],['rel','vs S&P'],['sigma','σ']];
const RANGES = [['3M',63],['6M',126],['YTD','ytd'],['1Y',252],['All',0]];
const HZ_TABS = ['1d','5d','20d','60d','YTD'];
const PALETTE = ['#5aa7ff','#4ade80','#facc15','#fb923c','#f472b6','#2dd4bf','#a78bfa','#fb7185','#a3e635','#38bdf8','#e879f9','#34d399','#fbbf24','#60a5fa'];
const colorOf = {}; (BASKETS.baskets||[]).forEach((b,i)=>colorOf[b.id]=PALETTE[i%PALETTE.length]);
const cssv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const BENCH_COLOR = () => cssv('--muted') || '#94a3b8';

const fmtPct = x => x==null ? '—' : (x>=0?'+':'')+(x*100).toFixed(1)+'%';
const fmtZ   = x => x==null ? '—' : (x>=0?'+':'')+x.toFixed(1)+'σ';
const cls    = x => x==null ? 'muted' : (x>=0?'pos':'neg');
const esc    = s => (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const lastIdx = a => { for(let i=a.length-1;i>=0;i--) if(a[i]!=null) return i; return -1; };
const hzLabel = c => c==='ytd'?'YTD':c;

function startIdxFor(col,dates,li){
  const u = col.toUpperCase();
  if(u==='MTD'||u==='YTD'){ const p = dates[li].slice(0, u==='MTD'?7:4); let i=li; while(i>0 && dates[i-1].startsWith(p)) i--; return i>0?i-1:null; }
  const i = li-parseInt(col,10); return i>=0?i:null;
}
function winRet(levels,col){ if(!levels) return null; const li=lastIdx(levels); if(li<0) return null;
  const si=startIdxFor(col,CHART.dates,li); if(si==null||levels[si]==null) return null; return levels[li]/levels[si]-1; }
function winZ(levels,col){ const n=parseInt(col,10); if(!n||!levels) return null; const li=lastIdx(levels); if(li<252+n) return null;
  const hr=[]; for(let i=li-252;i<=li;i++) hr.push((levels[i]!=null&&levels[i-n]!=null)?levels[i]/levels[i-n]-1:null);
  const cur=hr[hr.length-1]; const base=hr.slice(0,-1).filter(v=>v!=null); if(cur==null||base.length<200) return null;
  const m=base.reduce((a,b)=>a+b,0)/base.length; const sd=Math.sqrt(base.reduce((a,b)=>a+(b-m)**2,0)/(base.length-1)); return sd>0?(cur-m)/sd:null; }
const ratio = a => a.map((v,i)=>(v!=null&&CHART.bench[i]!=null)?v/CHART.bench[i]:null);

function sparkSvg(values,{w=92,h=26,color=''}={}){
  const vs=(values||[]).filter(v=>v!=null); if(vs.length<2) return '';
  const min=Math.min(...vs),max=Math.max(...vs),span=(max-min)||1;
  const pts=vs.map((v,i)=>[i/(vs.length-1)*w, h-3-(v-min)/span*(h-7)]);
  const d=pts.map((p,i)=>(i?'L':'M')+p[0].toFixed(1)+' '+p[1].toFixed(1)).join(' ');
  const col = color || (vs[vs.length-1]>=vs[0]?cssv('--up'):cssv('--down'));
  const e=pts[pts.length-1];
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}"><path d="${d}" fill="none" stroke="${col}" stroke-width="1.4"/><circle cx="${e[0].toFixed(1)}" cy="${e[1].toFixed(1)}" r="1.6" fill="${col}"/></svg>`;
}
const sparkTail = (levels,n=60) => (levels||[]).filter(x=>x!=null).slice(-n);

function renderTabs(el, opts, active, cb){
  el.innerHTML = opts.map(([v,lab])=>`<button data-v="${v}" class="${v==active?'on':''}">${lab}</button>`).join('');
  el.querySelectorAll('button').forEach(b=>b.onclick=()=>{ el.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b)); cb(b.dataset.v); });
}

// ---- 01 table -------------------------------------------------------------
let btblMode = localStorage.getItem('fw-btbl-mode')||'rel';
let btblSort = JSON.parse(localStorage.getItem('fw-btbl-sort')||'{"col":"20d","dir":-1}');
function renderBTable(){
  const rows = Object.entries(CHART.baskets).map(([id,lv])=>{
    const b=(BASKETS.baskets||[]).find(x=>x.id===id); const rl=ratio(lv);
    const src = btblMode==='raw'?lv:rl;
    const vals={}; TBL_COLS.forEach(c=>{ vals[c]= btblMode==='sigma' ? (/^\d/.test(c)?winZ(rl,c):null) : winRet(src,c); });
    return {id,name:b?b.name:id,color:colorOf[id]||'#888',spark:sparkTail(src),vals};
  });
  const sc=btblSort.col, dir=btblSort.dir;
  rows.sort((a,b)=>{ if(sc==='name') return a.name.localeCompare(b.name)*dir;
    const x=a.vals[sc], y=b.vals[sc]; if(x==null) return 1; if(y==null) return -1; return (x-y)*dir; });
  const fmt = btblMode==='sigma' ? fmtZ : fmtPct;
  const th = c => `<th class="num ${c===sc?'sel':''}" data-c="${c}">${c}${c===sc?(dir<0?' ▾':' ▴'):''}</th>`;
  let html = `<thead><tr><th data-c="name">Basket${sc==='name'?(dir<0?' ▾':' ▴'):''}</th><th class="num">60d</th>${TBL_COLS.map(th).join('')}</tr></thead><tbody>`;
  html += rows.map(r=>`<tr><td class="bname" data-id="${r.id}"><span class="dot" style="background:${r.color}"></span>${esc(r.name)}</td>
    <td class="num">${sparkSvg(r.spark,{color:r.color})}</td>
    ${TBL_COLS.map(c=>`<td class="num ${cls(r.vals[c])}">${r.vals[c]==null?'<span class="muted">—</span>':fmt(r.vals[c])}</td>`).join('')}</tr>`).join('');
  if(btblMode==='raw'){ const bv={}; TBL_COLS.forEach(c=>bv[c]=winRet(CHART.bench,c));
    html += `<tr><td class="bname" style="font-weight:500"><span class="dot" style="background:${BENCH_COLOR()}"></span>S&amp;P 500</td><td></td>${TBL_COLS.map(c=>`<td class="num ${cls(bv[c])}">${fmtPct(bv[c])}</td>`).join('')}</tr>`; }
  html += '</tbody>';
  const tbl=document.getElementById('btable'); tbl.innerHTML=html;
  tbl.querySelectorAll('th[data-c]').forEach(h=>h.onclick=()=>{ const c=h.dataset.c;
    if(c===btblSort.col) btblSort.dir*=-1; else btblSort={col:c,dir:c==='name'?1:-1};
    localStorage.setItem('fw-btbl-sort',JSON.stringify(btblSort)); renderBTable(); });
  tbl.querySelectorAll('.bname[data-id]').forEach(n=>n.onclick=()=>openBasket(n.dataset.id));
}

// ---- 02 chart -------------------------------------------------------------
let chart=null, chartMode='rel', chartRange=252, hidden={};
function chartSets(){
  const sets=Object.entries(CHART.baskets).map(([id,levels])=>{ const b=(BASKETS.baskets||[]).find(x=>x.id===id);
    return {key:id,label:b?b.name:id,color:colorOf[id]||'#888',levels}; });
  if(chartMode==='rel') return sets.map(s=>({...s,levels:ratio(s.levels)}));
  return [...sets,{key:'bench',label:'S&P 500',color:BENCH_COLOR(),levels:CHART.bench}];
}
function rangeStart(dates){ if(chartRange==='ytd'){ const y=dates[dates.length-1].slice(0,4); const i=dates.findIndex(d=>d.startsWith(y)); return i<=0?0:i-1; }
  return chartRange?Math.max(0,dates.length-chartRange):0; }
function chartOpts(){ return { autoSize:true,
  layout:{ background:{type:'solid',color:'transparent'}, textColor:cssv('--muted')||'#9aa4b2', fontSize:11 },
  grid:{ vertLines:{visible:false}, horzLines:{color:cssv('--line')||'#222'} },
  rightPriceScale:{ borderColor:cssv('--line')||'#222' }, timeScale:{ borderColor:cssv('--line')||'#222' },
  crosshair:{ mode:0, vertLine:{labelBackgroundColor:cssv('--panel2')||'#333'}, horzLine:{labelBackgroundColor:cssv('--panel2')||'#333'} } }; }
function renderChart(){
  const el=document.getElementById('chart'); if(typeof LightweightCharts==='undefined'){ el.innerHTML='<p class="muted">The charting library failed to load — the rest of the page is unaffected.</p>'; return; }
  if(!chart){ chart=LightweightCharts.createChart(el,chartOpts()); }
  (chart.__series||[]).forEach(s=>chart.removeSeries(s)); chart.__series=[];
  const start=rangeStart(CHART.dates);
  const sets=chartSets().filter(s=>!hidden[s.key]); const nVis=sets.length;
  sets.forEach(set=>{
    let base=null; const data=[];
    for(let i=start;i<CHART.dates.length;i++){ const v=set.levels[i]; if(v==null) continue; if(base===null) base=v; data.push({time:CHART.dates[i], value:100*(v/base-1)}); }
    if(data.length<2) return;
    const s=chart.addLineSeries({ color:set.color, lineWidth:2, priceLineVisible:false, lastValueVisible:nVis<=4, title:nVis<=4?set.label:'',
      priceFormat:{type:'custom',minMove:0.01,formatter:v=>(v>=0?'+':'')+v.toFixed(1)+'%'} });
    s.setData(data); chart.__series.push(s);
  });
  chart.timeScale().fitContent(); renderChartLegend();
}
function renderChartLegend(){
  const el=document.getElementById('chart-legend'); const st=rangeStart(CHART.dates);
  el.innerHTML=chartSets().map(s=>{ const li=lastIdx(s.levels); let base=null; for(let i=st;i<=li;i++){ if(s.levels[i]!=null){ base=s.levels[i]; break; } }
    const v=(base!=null&&s.levels[li]!=null)?100*(s.levels[li]/base-1):null;
    return `<span class="lchip ${hidden[s.key]?'off':''}" data-k="${s.key}"><span class="dot" style="background:${s.color}"></span>${esc(s.label)} <span class="lv">${v==null?'':(v>=0?'+':'')+v.toFixed(1)+'%'}</span></span>`;
  }).join('');
  el.querySelectorAll('.lchip').forEach(c=>c.onclick=()=>{ hidden[c.dataset.k]=!hidden[c.dataset.k]; renderChart(); });
}
function initChartDefaults(){
  const ranked=(BASKETS.baskets||[]).slice().sort((a,b)=>Math.abs((b.perf?.['20d']?.rel)||0)-Math.abs((a.perf?.['20d']?.rel)||0));
  ranked.slice(6).forEach(b=>hidden[b.id]=true);
}

