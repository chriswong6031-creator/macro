          <div class="rvx-hocol out">
            <div class="lbl">{{ t('Losing the lead', '失去领先') }}</div>
            <div class="nm">{{ t(_tc_tl.name, _tc_tl.name_zh) }}</div>
            <div class="meta" id="hero-out-meta" data-id="{{ _tc_tl.id }}">{{ t('was #1', '原第一') }}</div>
          </div>
          <div class="rvx-hoarrow"><svg viewBox="0 0 46 28"><defs><linearGradient id="rvxHo" x1="0" x2="1"><stop offset="0" stop-color="var(--rvx-weak)"/><stop offset="1" stop-color="var(--rvx-lead)"/></linearGradient></defs><path class="ln" d="M3 14 H37"/><path class="hd" d="M33 8 L43 14 L33 20 Z"/></svg></div>
          <div class="rvx-hocol in">
            <div class="lbl">{{ t('Taking the lead', '接过领先') }}</div>
            <div class="nm">{% if _tc_lead.strength %}{{ t(_tc_lead.strength[0].name, _tc_lead.strength[0].name_zh) }}{% if _tc_lead.strength|length > 1 %} · {{ t(_tc_lead.strength[1].name, _tc_lead.strength[1].name_zh) }}{% endif %}{% else %}—{% endif %}</div>
            <div class="meta" id="hero-in-meta"{% if _tc_lead.strength %} data-id="{{ _tc_lead.strength[0].id }}"{% endif %}></div>
          </div>
