<!DOCTYPE html>
<html lang="en" class="cyc-page">
{# Global Market Cycles — bespoke cycle-family page. Data/logic/styles are committed
   site/ assets; this template owns only the page shell + the shared nav include.
   W3.5: markets_engine.js (window.MARKETS_ENGINE) is emitted by build_markets.py and
   loaded BEFORE markets_app.js so the app can use engine pos_v2 as the plotted position.
   Rendered by scripts/build_markets.py into site/markets.html. #}
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>try{var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark');var l=localStorage.getItem('lang');if(l)document.documentElement.setAttribute('data-lang',l);}catch(e){}</script>
<title>Global Market Cycles — Mastermind</title>
<meta name="description" content="Nine national equity-market cycles on one clock — the US, UK, Europe, Japan, China, Hong Kong, Taiwan, India and Canada overlaid on real web-sourced data: observed history, valuations, and where each market sits in its bull/bear lifespan.">
<link rel="stylesheet" href="theme.css">
<link rel="stylesheet" href="cycle.css?v=2">
<link rel="stylesheet" href="markets.css?v=4">
</head>
<body>
{% include "_site_nav.html.j2" %}

<div class="cyc-wrap">
  <header class="cyc-hd">
    <div class="ht">
      <div class="cyc-kicker"><span class="hb"></span> <span class="l-en">Global Market Cycles</span><span class="l-zh">全球市场周期</span></div>
      <h1 class="cyc-title"><span class="l-en">Where every market stands</span><span class="l-zh">各市场所处位置</span></h1>
      <p class="cyc-sub"><span class="l-en">Nine national equity markets on one clock — the US, UK, Europe, Japan, China, Hong Kong,
        Taiwan, India and Canada. The y-axis is a <b>cycle oscillator (0–100)</b>: high = extended near record highs,
        low = washed-out deep below them. Seven markets are engine-backed (country_cycles pos_v2);
        US and Europe show analyst estimates until their proxies are added to the engine.
        Observed history (solid), projection (dashed + uncertainty cone), and curated valuations with as-of dates
        — so you see not just <em>when</em> in the cycle each market sits, but how <em>cheap or rich</em> it is there.</span><span class="l-zh">九个国家股市同框 —— 美国、英国、欧洲、日本、中国、香港、台湾、印度与加拿大。纵轴是<b>周期振荡器（0–100）</b>：高=接近历史高点（拉伸），低=深跌超卖。七个市场使用引擎数据（country_cycles pos_v2）；美国与欧洲的代理 ETF 尚未入引擎，显示分析师估算。实线为历史，虚线（含锥形区间）为预测，并附带标注截止日期的精选估值 —— 让你不仅看到每个市场处于周期的<em>哪个阶段</em>，还能看到它在该位置是<em>便宜还是昂贵</em>。</span></p>
    </div>
    <div class="cyc-ctrls">
      <span class="cyc-asof"><span class="l-en">As of</span><span class="l-zh">截至</span> <span id="cyc-asof">…</span></span>
    </div>
  </header>

  <section class="cyc-stage">
    <div class="cyc-hero">
      <div class="cyc-hero-hd">
        <h2><span class="l-en">Cross-market overlay</span><span class="l-zh">跨市场叠加</span></h2>
        <div class="cyc-hero-tools">
          <div class="cyc-legend">
            <span><i class="ls"></i> <span class="l-en">History</span><span class="l-zh">历史</span></span>
            <span><i class="lp"></i> <span class="l-en">Projection</span><span class="l-zh">预测</span></span>
            <span><i class="lc"></i> <span class="l-en">Uncertainty</span><span class="l-zh">不确定性</span></span>
          </div>{# W3.5: convergence legend item removed — convergenceBands() retired (fake artifact) #}
          <div class="cyc-zoom" id="cyc-zoom" aria-label="Zoom"></div>
        </div>
      </div>
      <div id="mkt-stale-banner"></div>
      <div id="regime-prior-banner"></div>
      <div class="cyc-groups" id="cyc-groups" aria-label="Group filter"></div>
      <div class="cyc-chips" id="cyc-chips" aria-label="Market toggles"></div>
      <div id="cyc-chart" data-h="452" role="img" aria-label="Cross-market overlay chart"></div>
    </div>

    <aside class="cyc-detail" id="cyc-detail">
      <div class="cyc-handle" id="cyc-handle" aria-hidden="true"></div>
      <div class="cyc-panels">
        <div class="cyc-panel show" id="cyc-panel-default"></div>
        <div class="cyc-panel" id="cyc-panel-focus"></div>
      </div>
    </aside>
  </section>

  <section class="mkt-grid">
    <div class="mkt-panel">
      <div class="mkt-phd">
        <h2><span class="l-en">Where they stand today</span><span class="l-zh">今日所处位置</span></h2>
        <div class="mkt-sort" id="mkt-snap-sort" aria-label="Sort"></div>
      </div>
      <div class="mkt-snap" id="mkt-snap" aria-label="Cycle-position ranking"></div>
      <div class="mkt-dispersion" id="mkt-dispersion"></div>
    </div>
    <div class="mkt-panel">
      <div class="mkt-phd">
        <h2><span class="l-en">Valuation map</span><span class="l-zh">估值地图</span></h2>
        <span class="mkt-phd-sub"><span class="l-en">forward P/E × cycle position — cheap·washed-out ↘ rich·at-highs</span><span class="l-zh">预期市盈率 × 周期位置 —— 便宜·超卖 ↘ 贵·高位</span></span>
      </div>
      <div class="mkt-scatter" id="mkt-scatter" role="img" aria-label="Valuation versus cycle-position scatter"></div>
    </div>
  </section>

  <div class="cyc-cards-hd">
    <h2><span class="l-en">Market scorecards</span><span class="l-zh">市场记分卡</span></h2>
    <span class="sub"><span class="l-en">Tap any card — or its line on the chart — to focus it</span><span class="l-zh">点击任意卡片（或图中曲线）以聚焦</span></span>
  </div>
  <div class="cyc-cards" id="cyc-cards"></div>
</div>

<script src="regimedata/regime_prior.js"></script>
<script src="markets_i18n.js?v=2"></script>
<script src="markets_data.js?v=2"></script>
<script src="marketsdata/markets_engine.js?v=1"></script>
<script src="mm_charts.js?v=4"></script>
<script src="markets_app.js?v=7"></script>
<script>try{document.getElementById('cyc-asof').textContent=(window.MARKET_META||{}).asOf||'';}catch(e){}</script>
<script>
/* W4.5 regime-prior reconciliation banner for markets.html.
   Two layers: (0) CONTRADICTION — curated market regime_claim quad (us / hk carry a
   US-quad premise) vs the live engine quad, from MARKETS_ENGINE.regime_disagreement,
   softened to amber when the engine read is itself provisional; (1) prior stale/partial;
   (2) MARKET_META.asOf > 30 days old. Dual-span EN/zh — no t() in attributes. */
(function(){
  try{
    var host=document.getElementById('regime-prior-banner');
    if(!host)return;
    var prior=window.REGIME_PRIOR||{};
    var meta=window.MARKET_META||{};
    var msgs=[];
    // 0. Contradiction: curated market regime_claim vs live engine quad (W4.5 primary signal)
    var rd=(window.MARKETS_ENGINE||{}).regime_disagreement;
    if(rd&&rd.banner_en){
      msgs.push({en:rd.banner_en,zh:rd.banner_zh,cls:rd.cls||'stale-red'});
    }
    // 1. Prior itself stale/partial
    var ps=prior.status;
    if(ps==='stale'||ps==='partial'){
      var sources=prior.sources||{};
      var staleSrcs=[];
      for(var k in sources){if(sources[k]&&(sources[k].status==='stale'||sources[k].status==='unavailable'))staleSrcs.push(k);}
      var enMsg='Regime data is '+ps+' ('+staleSrcs.join(', ')+') — some components may not reflect the latest build.';
      var zhMsg='体制数据状态为'+ps+'（'+staleSrcs.join('、')+'）——部分组件可能未反映最新构建。';
      msgs.push({en:enMsg,zh:zhMsg,cls:'stale-amber'});
    }
    // 2. Curated market prose staleness (>30d from MARKET_META.asOf)
    var curatedAsOf=meta.asOf||null;
    if(curatedAsOf){
      var d=new Date(curatedAsOf+'T00:00:00Z');
      var daysDiff=Math.round((Date.now()-d.getTime())/86400000);
      if(daysDiff>30){
        var cls2=daysDiff>60?'stale-red':'stale-amber';
        var enMsg2='Market narrative notes last updated '+curatedAsOf+' ('+daysDiff+'d ago) — may not reflect the live regime ('+((prior.quad||'?'))+' '+((prior.liquidity||''))+').';
        var zhMsg2='市场叙述最后更新于 '+curatedAsOf+'（已 '+daysDiff+' 天）——可能未反映实时体制（当前：'+(prior.quad||'?')+' '+(prior.liquidity||'')+'）。';
        msgs.push({en:enMsg2,zh:zhMsg2,cls:cls2});
      }
    }
    if(!msgs.length){host.innerHTML='';return;}
    var html='';
    msgs.forEach(function(m){
      html+='<div class="stale-banner '+m.cls+'">'
        +'<span class="l-en">'+m.en+'</span>'
        +'<span class="l-zh">'+m.zh+'</span>'
        +'</div>';
    });
    host.innerHTML=html;
  }catch(e){}
})();
</script>
<script>
/* markets_data.js staleness banner — INTL-47.
   markets_data.js is a hand-curated static file; its MARKET_META.asOf is the
   authoritative freshness date. Show a visible warning when >5 days old so the
   reader is never misled by stale "now" blocks (level / %-off-ATH / valuations). */
(function(){
  try {
    var asOf = (window.MARKET_META||{}).asOf;
    if (!asOf) return;
    var msPerDay = 86400000;
    var ageDays = Math.floor((Date.now() - new Date(asOf).getTime()) / msPerDay);
    if (ageDays <= 5) return;
    var b = document.createElement('div');
    b.id = 'mkt-stale-banner';
    b.style.cssText = 'margin:8px 0 4px;padding:7px 14px;border-radius:8px;background:rgba(217,119,6,.14);border:1px solid rgba(217,119,6,.35);color:var(--amber,#c98a2e);font-size:13px;line-height:1.4;display:flex;gap:8px;align-items:center';
    b.innerHTML = '<span style="font-size:16px">&#9888;</span>'
      + '<span class="l-en"><b>Market snapshot data is ' + ageDays + ' days old</b> (as of ' + asOf + ').'
      + ' Live levels, % off ATH and valuations may be stale — verify before acting.</span>'
      + '<span class="l-zh"><b>市场快照数据已有 ' + ageDays + ' 天</b>（截至 ' + asOf + '）。'
      + '实时价位、偏离历史高点幅度及估值数据可能已过期，操作前请核实。</span>';
    var wrap = document.querySelector('.cyc-wrap');
    if (wrap) wrap.insertBefore(b, wrap.firstChild);
  } catch(e) {}
})();
</script>
<script src="theme.js"></script>
<script defer data-whb data-root="" src="wh_banner.js"></script>
</body>
</html>
