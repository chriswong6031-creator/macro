# Caddyfile — static origin for mastermind-x.com, behind the TencentEdgeOne CDN
# (migrated from Cloudflare — the CF-specific notes below now mean "the CDN edge").
#
# The CDN terminates public TLS at its edge and connects back to this origin.
# `tls internal` serves Caddy's self-signed cert on :443 so the edge<->origin hop
# is still encrypted; the CDN's origin-fetch/SSL mode must ACCEPT a self-signed
# cert (Cloudflare's "Full", or EdgeOne's equivalent non-strict HTTPS origin pull).
# To upgrade later, replace `tls internal` with a CDN Origin Certificate
# (`tls /path/cert.pem /path/key.pem`) and switch the edge to strict verification.
#
# HTTPS ENFORCEMENT: Force-HTTPS is the EDGE's job — enable "Force HTTPS" + HSTS in
# the EdgeOne console. Cloudflare used to redirect http->https AND auto-upgrade
# stray mixed content; EdgeOne does neither by default, so that toggle is now what
# stops http://mastermind-x.com from serving plaintext. This origin deliberately
# does NOT redirect (an origin redirect behind a CDN can loop the edge's origin
# pull — see disable_redirects below); it only ADDS the HSTS response header on the
# site block, which is safe to emit from behind the CDN and hardens return visits.
#
# Pre-launch: the whole site is served but marked noindex so it can't be crawled
# before launch. Product login (Supabase) arrives in Slice 2; for a private beta
# right now, front this with Cloudflare Access (email OTP, zero code).

{
	# The CDN edge owns the public http->https redirect for the proxied hosts; don't
	# fight it with Caddy's automatic upgrade, which can loop the edge's origin pull.
	# Only the grey-cloud admin.* host (direct, no CDN) declares its own explicit
	# http:// redirect block below — disable_redirects just suppresses the AUTO ones.
	auto_https disable_redirects
	# Trust Cloudflare's forwarded client IP (so logs show the real visitor).
	servers {
		trusted_proxies static private_ranges
	}
}

mastermind-x.com, www.mastermind-x.com {
	root * /opt/macro/site
	encode zstd gzip

	# Slice 2 backend — FastAPI (macro-api.service) on localhost. Everything under
	# /api/* is proxied here; the rest is served as static files below. Per-user
	# auth lives in the API (Supabase) + (later) a login wall; no shared password.
	reverse_proxy /api/* 127.0.0.1:8000

	file_server {
		index index.html
	}

	# --- CDN cache safety (2026-07-03 white-page incident) ----------------------
	# macro-update refreshes the served tree with `git reset --hard`, which rewrites
	# changed files IN PLACE — so Caddy can briefly serve a 0-byte file mid-write.
	# With NO Cache-Control the EdgeOne edge cached that empty 200 with no TTL bound
	# and served a white page for ~an hour across us_stocks/macro/china/etc. A short,
	# must-revalidate TTL caps any bad edge entry (HTML <=60s, other static <=300s)
	# and forces the edge to revalidate against the (healthy) origin, so a transient
	# bad render can never get STUCK in cache. Mirrors the greydeercapital.com block
	# below. The zero-window structural fix (atomic swap) lives in update.sh.
	@html {
		path *.html /
		not path /api/*
	}
	@static {
		path /vendor/* *.js *.css *.json *.svg *.png *.jpg *.jpeg *.ico *.webp *.woff *.woff2
		not path /api/*
	}
	header @html   Cache-Control "public, max-age=60, must-revalidate"
	header @static Cache-Control "public, max-age=300, must-revalidate"

	header {
		# PUBLIC (was pre-launch noindex): the site is now open to search engines.
		# The old `X-Robots-Tag "noindex, nofollow, noarchive"` header was removed
		# here so crawlers can index it (paired with robots.txt + sitemap.xml in
		# site/). Re-add that header to pull the whole site back out of search.
		# NOTE: the LIVE header is emitted by the VPS /etc/caddy/Caddyfile, which
		# has diverged from this repo copy — remove the noindex THERE too and
		# `systemctl reload caddy`, or the site stays de-indexed. See
		# [[mastermind-x-origin-tls-direct]].
		# Basic hardening.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Enforce HTTPS on return visits (the edge should set this too). 1 year,
		# matching admin.*; no includeSubDomains — other subdomains manage their own.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Self-signed origin cert; pair with the CDN's non-strict HTTPS origin pull.
	tls internal

	# Access logs go to journald (`journalctl -u caddy`). We deliberately do NOT
	# write a file log: the stock caddy.service systemd sandbox only permits writes
	# under /var/lib/caddy, so a /var/log/caddy file sink fails with EACCES and
	# crashes startup. journald is the idiomatic, sandbox-safe sink.
}

# ---- app.mastermind-x.com — the Mastermind Terminal (Next.js) ----------------
# The charting SaaS frontend, served by terminal.service (next start) on :3000.
# Needs a Cloudflare DNS A record: app -> 146.190.142.17 (proxied), SSL mode "Full".
app.mastermind-x.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	# Self-signed origin cert; pair with Cloudflare SSL mode = "Full".
	tls internal
}

# ---- bot.mastermind-x.com — Brain BOT serve-only mirror (uvicorn :8001) -------
# The Mastermind Brain dashboard (paper-trading FastAPI), served by
# mastermind.service on 127.0.0.1:8001. The app handles its own auth
# (MASTERMIND_PASSWORD in /opt/mastermind/.env; currently disabled). MUST live
# here — without a site block, Caddy's `tls internal` has no cert for this SNI and
# the Cloudflare<->origin handshake fails with HTTP 525. DNS A record:
# bot -> 146.190.142.17 (proxied), SSL mode "Full".
bot.mastermind-x.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8001
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}
	# Self-signed origin cert; pair with Cloudflare SSL mode = "Full".
	tls internal
}

# ---- admin.mastermind-x.com — the Admin console (python -m admin :8787) -------
# Authenticated control + observability console (admin.service on 127.0.0.1:8787).
# UNLIKE the other hosts this is GREY-CLOUD / DNS-only (A record admin ->
# 146.190.142.17, NOT proxied through Cloudflare), so Caddy provisions a REAL
# Let's Encrypt cert over HTTP-01 (port 80 is kept open to all in ufw by
# firewall-cloudflare.sh's grey-cloud escape hatch) — no `tls internal`, no
# Cloudflare in front. The app enforces password + signed-session auth
# (ADMIN_PASSWORD in /etc/macro-admin.env); Caddy adds anti-framing + HSTS headers.
#
# The global `auto_https disable_redirects` (correct for the CF-fronted hosts)
# would otherwise serve this host over PLAINTEXT http:// with no upgrade — and the
# login posts the shared password. So we add an explicit http:// block that
# force-redirects to https:// (Caddy still answers the ACME HTTP-01 challenge on
# :80 ahead of this redirect, so cert issuance/renewal is unaffected).
http://admin.mastermind-x.com {
	redir https://admin.mastermind-x.com{uri} permanent
}

admin.mastermind-x.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# ---- maltese.greydeercapital.com — 线条小狗 Line-Puppy sticker gallery (static) ----
# A SEPARATE Cloudflare zone (greydeercapital.com) proxied to THIS origin; the static
# files live at /opt/maltese (OUTSIDE this /opt/macro checkout — synced by hand via
# scripts/deploy.sh in ~/Documents/线条小狗_stickers). Like the mastermind-x hosts it
# uses `tls internal` paired with Cloudflare SSL mode "Full" (non-strict origin pull).
# This block MUST live in THIS repo file: macro-update reinstalls /etc/caddy/Caddyfile
# from here on every main commit, so a block hand-added on the box alone gets wiped.
# Without a block for this SNI the Cloudflare<->origin handshake fails with HTTP 525.
maltese.greydeercapital.com {
	root * /opt/maltese
	encode zstd gzip
	file_server {
		index index.html
	}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	tls internal
}

# ---- greydeercapital.com — Grey Deer Capital brand site (static) + intake API ----
# Behind Cloudflare (proxied, SSL mode "Full"): `tls internal` serves a self-signed
# origin cert so the edge<->origin hop is encrypted, matching mastermind-x.com.
# Static files live in /opt/greydeercapital; /api/* is the self-hosted inquiry
# intake service (greydeercapital-intake.service) on loopback :8110.
greydeercapital.com, www.greydeercapital.com {
	root * /opt/greydeercapital
	encode zstd gzip

	reverse_proxy /api/* 127.0.0.1:8110

	file_server {
		index index.html
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	# Caching — fonts/vendor are content-addressed (immutable); assets daily; HTML short
	@immutable {
		path /assets/fonts/* /assets/vendor/*
	}
	@assets {
		path /assets/*
		not path /assets/fonts/* /assets/vendor/*
	}
	@html {
		path *.html /
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @assets   Cache-Control "public, max-age=86400"
	header @html     Cache-Control "public, max-age=300, must-revalidate"

	# file_server has no MIME mapping for .webmanifest, so it served the manifest
	# with NO Content-Type. Combined with the nosniff header below, iOS Safari
	# refuses to type it, downloads it as "document.txt", and the page renders
	# white (2026-07-02 mobile bug). Serve the spec Content-Type explicitly.
	@webmanifest path /site.webmanifest
	header @webmanifest Content-Type "application/manifest+json"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		# No third-party origins remain after font self-hosting (2026-07-01).
		# 'unsafe-inline' required: head bootstrap script + inline style attrs.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	tls internal
}
