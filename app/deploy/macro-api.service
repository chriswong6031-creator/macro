[Unit]
Description=macro API (FastAPI serving tier)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/macro
# Optional env: SUPABASE_JWT_SECRET (activates auth), SUPABASE_PROJECT_REF, etc.
# The leading '-' makes the file optional so the service starts without it.
EnvironmentFile=-/etc/macro-api.env
# Shared subscription-provider pool. The Claude OAuth values remain in the
# environment file; Codex keeps its independent refreshable login in this
# root-only state directory so ProtectHome never blocks it.
Environment=CODEX_HOME=/var/lib/macro-codex
Environment=CODEX_ACCOUNT_HOMES=/var/lib/macro-codex:/var/lib/macro-codex-2
Environment=CODEX_PROVIDER_ENABLED=1
Environment=BIOCATALYST_PUBLIC_ROOT=/var/lib/macro-biocatalyst/public
StateDirectory=macro-codex macro-codex-2
StateDirectoryMode=0700
# ── Site Access Gate env (all optional; safe defaults apply when absent) ─────
# SITE_GATE_STATE=/var/lib/macro-api/site_gate.json  # blocklist store (NOT in git)
# SITE_GATE_COUNTRY_HEADER=EO-Client-IPCountry        # CDN country header name
#   EdgeOne:    EO-Client-IPCountry (default)
#   Cloudflare: CF-IPCountry
#   Custom:     set to whatever your CDN emits
# GEOIP_DB=/var/lib/macro-api/GeoLite2-Country.mmdb  # MaxMind db (optional)
#   Absent => country detection falls back to CDN header only; gate still works.
#   Download: MAXMIND_LICENSE_KEY=<key> bash /opt/macro/app/deploy/geoip-setup.sh
# SITE_GATE_PAGE=site/coming-soon.html               # coming-soon HTML (relative to MACRO_REPO)
# ── Billing spine env (MNZ W2 — app/billing.py; all go in /etc/macro-api.env, NEVER git) ─────
# STRIPE_SECRET_KEY=sk_test_...      # server-side Stripe key; routes 503 cleanly when unset
# STRIPE_WEBHOOK_SECRET=whsec_...    # from the Stripe Dashboard webhook endpoint; required for /api/billing/webhook
# SUPABASE_SERVICE_ROLE_KEY=...      # already used by analytics/brain — the webhook writes user_entitlements with it
# MM_SITE_BASE=https://mastermind-x.com   # where hosted Checkout/Portal return (apex, not www)
# STRIPE_AUTOMATIC_TAX=1             # Stripe Tax on (default); set 0 until the account's Tax origin is configured
# ── Static-site access env ───────────────────────────────────────────────────
# REGWALL_ENABLED=1                  # default; 0 is emergency registration-wall rollback
# PAYWALL_ENABLED=0                  # stage safely; set 1 only after docs/ops/site-access.md launch checks
# PAYWALL_AUTH_CACHE_SECONDS=45      # hard-capped at 60s in code
# PAYWALL_ENTITLEMENT_CACHE_SECONDS=60
# PAYWALL_GRACE_SECONDS=86400        # positive-only store-outage grace, hard-capped at 24h
# NOTE: the publishable key is NOT needed — the hosted-Checkout redirect flow never loads Stripe.js in the browser.
# STRIPE_TIMEOUT_SEC=20              # wall-clock cap per Stripe call (the SDK default is NO timeout)
# Full setup: docs/ops/stripe-setup.md
# ── Mail env (SEE W1/W3 — app/mailer.py + app/billing_emails.py) ─────────────
# MAIL_SMTP_HOST/PORT/USER/PASS, MAIL_FROM, MAIL_REPLY_TO, MAIL_SUPPORT_TO, MAIL_UNSUB_SECRET
#   All absent => mail-off mode: every send is still ledgered, nothing leaves the building.
# MAIL_BILLING_ENABLED=1             # default ON. 0 silences billing receipts + the trial
#                                    #   reminder WITHOUT stopping support/ticket mail.
# MAIL_LIFECYCLE_ENABLED=0           # default OFF. 1 arms the in-process trial-ending
#                                    #   sweeper; the log says which state it booted in.
# MAIL_LIFECYCLE_INTERVAL_SEC=21600  # sweeper wake interval (floor 60s); 6h default
# MAIL_SITE_BASE=https://www.mastermind-x.com   # host used in email links (PIN §7)
# Full setup: docs/ops/email-support-setup.md
ExecStart=/opt/macro-api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2
# Light hardening (still runs as root for MVP simplicity; tighten to a dedicated
# user later). The app only reads /opt/macro and writes nothing.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
# BioCatalyst's serving boundary is one-way: macro-api may read the immutable
# public projection, but the worker state tree and credential file do not exist
# inside this service's mount namespace.
# A leading '-' preserves a healthy API while the operator-armed lane is not
# provisioned. Once these paths exist, the same mounts are enforced at restart.
ReadOnlyPaths=-/var/lib/macro-biocatalyst/public
InaccessiblePaths=-/var/lib/macro-biocatalyst/state
InaccessiblePaths=-/var/lib/macro-biocatalyst/activation
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env

[Install]
WantedBy=multi-user.target
