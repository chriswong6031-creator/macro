# Options Context Audit publisher. Distinct from the W1B.1 trusted-context
# owner W2C consumes. It reads the complete owner corpus and the public W1A
# plus trusted stores, then writes only private options-context receipts.
# Failure is loud and independent: it must not relabel trusted-context success.
[Unit]
Description=Publish the Options Context Audit over the complete owner corpus
After=local-fs.target
After=macro-market-memory-context.service

[Service]
Type=oneshot
WorkingDirectory=/opt/macro
ExecStart=/opt/macro-api/.venv/bin/python -m scripts.audit_options_market_memory_context --repository-root /opt/macro --w1a-store-root /var/lib/macro-market-memory/public --trusted-store-root /var/lib/macro-market-memory/public/trusted-v1 --publish-root /var/lib/macro-market-memory/state/context-projection/options-context-receipts
TimeoutStartSec=180
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=256M
MemoryMax=512M
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/macro
ReadOnlyPaths=/var/lib/macro-market-memory/public
ReadWritePaths=/var/lib/macro-market-memory/state/context-projection/options-context-receipts
InaccessiblePaths=/var/lib/macro-market-memory-options
InaccessiblePaths=/etc/macro-market-memory-options
InaccessiblePaths=/var/lib/macro-market-memory/state/sources
InaccessiblePaths=/var/lib/macro-market-memory/state/sources-spy-rest-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/identity-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/breadth-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/technicals-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/technicals-v2
InaccessiblePaths=/var/lib/macro-market-memory/state/experience-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/experience-v2
InaccessiblePaths=/var/lib/macro-market-memory/state/production-record-options-episode-v1
InaccessiblePaths=-/var/lib/macro-api
InaccessiblePaths=-/var/lib/macro-biocatalyst
InaccessiblePaths=-/var/lib/macro-codex
InaccessiblePaths=-/var/lib/macro-codex-2
InaccessiblePaths=-/var/lib/macro-codex-3
InaccessiblePaths=-/var/lib/macro-live
InaccessiblePaths=-/etc/macro-admin.env
InaccessiblePaths=-/etc/macro-api.env
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env
InaccessiblePaths=-/etc/macro-live.env
InaccessiblePaths=-/etc/macro-market-memory.env
InaccessiblePaths=-/etc/macro-ollama.env
InaccessiblePaths=-/etc/macro-sentinel.env
InaccessiblePaths=-/etc/macro-user-backup.env

[Install]
WantedBy=multi-user.target
