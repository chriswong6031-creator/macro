# BioCatalyst B2 ClinicalTrials.gov history archive.
#
# This unit is installed disabled and is armed only with the B1 source soak.
# It deliberately shares the primary worker's state and non-blocking lock: an
# overlap with the launch-critical hourly poll becomes a safe no-op instead of
# two competing publication transactions. The hourly unit explicitly disables
# history refreshes; this daily unit is the only scheduled refresh owner.
[Unit]
Description=Mastermind BioCatalyst daily ClinicalTrials.gov history archive
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/macro-biocatalyst.env

[Service]
Type=oneshot
User=macro-biocatalyst
Group=macro-biocatalyst
WorkingDirectory=/opt/macro
EnvironmentFile=/etc/macro-biocatalyst.env
Environment=BIOCATALYST_STATE_ROOT=/var/lib/macro-biocatalyst/state
Environment=BIOCATALYST_PUBLIC_ROOT=/var/lib/macro-biocatalyst/public
Environment=BIOCATALYST_ACTIVATION_ROOT=/var/lib/macro-biocatalyst/activation
Environment=BIOCATALYST_R2_ACTIVATION_GATE_PATH=/var/lib/macro-biocatalyst/activation/gate.json
Environment=BIOCATALYST_R2_ACTIVATION_HEARTBEAT_PATH=/var/lib/macro-biocatalyst/activation/heartbeat.json
# EnvironmentFile values override Environment= values regardless of textual
# order. Prefix the process so this lane remains the sole scheduled history
# refresh owner even if the shared env file is later set to history=0.
ExecStart=/usr/bin/env BIOCATALYST_HISTORY_ENABLED=1 /opt/macro-biocatalyst/current/bin/python -m scripts.biocatalyst_worker --mode canary_poll
# History collection and immutable R2 verification are intentionally outside
# the 900-second current-record window, but remain bounded below one hour.
TimeoutStartSec=2700
Nice=12
CPUWeight=20
CPUQuota=60%
MemoryHigh=384M
MemoryMax=512M
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/macro-biocatalyst/state
ReadWritePaths=/var/lib/macro-biocatalyst/public
ReadOnlyPaths=/var/lib/macro-biocatalyst/activation
InaccessiblePaths=/etc/macro-biocatalyst.env
InaccessiblePaths=/etc/macro-biocatalyst-control.env
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
