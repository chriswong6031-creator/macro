# Root-only retention-control heartbeat. The collector never receives this
# unit's control/auditor token; it can only read the root-owned gate directory.
[Unit]
Description=Mastermind BioCatalyst R2 retention activation heartbeat
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/macro-biocatalyst.env
ConditionPathExists=/etc/macro-biocatalyst-control.env
ConditionPathExists=/var/lib/macro-biocatalyst/activation/gate.json

[Service]
Type=oneshot
User=root
Group=macro-biocatalyst
WorkingDirectory=/opt/macro
EnvironmentFile=/etc/macro-biocatalyst.env
EnvironmentFile=/etc/macro-biocatalyst-control.env
Environment=BIOCATALYST_ACTIVATION_ROOT=/var/lib/macro-biocatalyst/activation
Environment=BIOCATALYST_R2_ACTIVATION_GATE_PATH=/var/lib/macro-biocatalyst/activation/gate.json
Environment=BIOCATALYST_R2_ACTIVATION_HEARTBEAT_PATH=/var/lib/macro-biocatalyst/activation/heartbeat.json
ExecStart=/usr/bin/env bash /opt/macro/app/deploy/biocatalyst-activation-heartbeat.sh
TimeoutStartSec=300
Nice=12
CPUWeight=10
CPUQuota=30%
MemoryHigh=192M
MemoryMax=256M
IOWeight=10
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/macro-biocatalyst/activation
InaccessiblePaths=/var/lib/macro-biocatalyst/state
InaccessiblePaths=/var/lib/macro-biocatalyst/public
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
