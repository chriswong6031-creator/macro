[Unit]
# PRESS-FEEDS B1 (D05 Addendum 2) — the Trump/markets wire ingestion spine.
# VPS-resident poll daemon: wire RSS + Truth-mirror RSS + twitterapi.io x_relay
# -> relevance -> story clustering -> evidence/draft desk -> optional outbox.
#
# DARK BY DEFAULT. Ships disabled. Arming is an operator step: set
# MARKETING_FASTLANE_ENABLED=1 (drive the loop) and, for outbound social posts,
# MARKETING_PUBLISH_ENABLED=1 (allow outbox emission) in /etc/macro-live.env,
# then `systemctl enable --now marketing-press-feeds`. The Intelligence Desk and
# website wire run with only the first flag; see docs/marketing_publisher_runbook.md.
Description=Mastermind real-time news intelligence daemon (story desk + wire)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/macro
# Kill-switches + optional TWITTERAPI_IO_KEY live in this env file (unset ships dark).
EnvironmentFile=-/etc/macro-live.env
# Attached Codex subscription (operator directive 2026-07-31). The wire rail's
# Chinese headline twin runs on Terra through engine/codex_provider.py instead of
# DEEPSEEK_API_KEY, which was never provisioned on this host — without these two
# lines the daemon sees no login and the zh pass degrades to English-only.
# Same idiom as macro-api.service: ONE attached subscription shared by the API,
# the admin console and this daemon, with the refreshable login in a root-only
# state directory so no unit's ProtectHome can block it. macro-api.service owns
# the StateDirectory= that creates /var/lib/macro-codex (mode 0700); this unit
# only reads it, so it deliberately does not re-declare ownership of the path.
Environment=CODEX_HOME=/var/lib/macro-codex
Environment=CODEX_PROVIDER_ENABLED=1
# --interval 75 keeps the mirror hot-poll inside its 60-90 s window; per-source
# politeness floors + the twitterapi.io per-tier intervals throttle each provider.
ExecStart=/opt/macro/.venv/bin/python -m scripts.marketing_fastlane_daemon --lane press --interval 75
Restart=on-failure
RestartSec=30
Nice=5
CPUWeight=40
CPUQuota=120%
MemoryHigh=768M
MemoryMax=1G
IOWeight=40
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
