[Unit]
Description=Run the bounded Market Memory option-OI availability canary on weekdays
ConditionPathExists=/run/macro-api-market-memory-options-deny.ready
ConditionPathExists=/run/macro-market-memory-options-reciprocal-deny.ready

[Timer]
# This is an operational retry cadence only.  It is not evidence of the
# provider's measurement date, publication time, market session, or freshness.
OnCalendar=Mon..Fri *-*-* 08:20:00 America/New_York
AccuracySec=1min
RandomizedDelaySec=120s
Persistent=false
Unit=macro-market-memory-options.service

[Install]
WantedBy=timers.target
