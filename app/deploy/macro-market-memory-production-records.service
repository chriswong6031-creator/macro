# First admitted Market Memory production-record writer. It reads only the
# committed options signal-episode owner ledger and writes the immutable,
# API-inaccessible options-episode record store. No network, credential,
# public-store, ranking, gating, sizing, or execution surface is available.
[Unit]
Description=Capture admitted options signal episodes into private Market Memory records
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/macro
ExecStart=/opt/macro-api/.venv/bin/python -m scripts.capture_market_memory_options_episodes --repository-root /opt/macro --store-root /var/lib/macro-market-memory/state/production-record-options-episode-v1
TimeoutStartSec=300
Nice=10
CPUWeight=20
CPUQuota=60%
MemoryHigh=1G
MemoryMax=2G
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/macro
ReadWritePaths=/var/lib/macro-market-memory/state/production-record-options-episode-v1
InaccessiblePaths=/var/lib/macro-market-memory-options
InaccessiblePaths=/etc/macro-market-memory-options
InaccessiblePaths=/var/lib/macro-market-memory/public
InaccessiblePaths=/var/lib/macro-market-memory/state/sources
InaccessiblePaths=/var/lib/macro-market-memory/state/context-projection
InaccessiblePaths=/var/lib/macro-market-memory/state/identity-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/breadth-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/technicals-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/experience-v1
InaccessiblePaths=-/opt/macro/.env
InaccessiblePaths=-/var/lib/macro-api
InaccessiblePaths=-/var/lib/macro-biocatalyst
InaccessiblePaths=-/var/lib/macro-codex
InaccessiblePaths=-/var/lib/macro-codex-2
InaccessiblePaths=-/var/lib/macro-codex-3
InaccessiblePaths=-/var/lib/macro-live
InaccessiblePaths=-/etc/macro-admin.env
InaccessiblePaths=-/etc/macro-api.env
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env
InaccessiblePaths=-/etc/macro-biocatalyst-fixed-cohort.env
InaccessiblePaths=-/etc/macro-biocatalyst-fixed-cohort
InaccessiblePaths=-/etc/macro-live.env
InaccessiblePaths=-/etc/macro-market-memory.env
InaccessiblePaths=-/etc/macro-ollama.env
InaccessiblePaths=-/etc/macro-sentinel.env
InaccessiblePaths=-/etc/ssl/cf-origin.key

[Install]
WantedBy=multi-user.target
