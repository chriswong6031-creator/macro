# W1B.1 trusted context publisher. It has no network or credentials. Exact raw
# regime bytes and identity/calendar evidence remain in the private state tree;
# only the label-free macro snapshot and context packet reach the API-readable
# trusted store. The publisher advances public HEAD only after private evidence.
[Unit]
Description=Publish the trusted SPY macro-regime Market Memory canary
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/macro
ExecStart=/opt/macro-api/.venv/bin/python -m scripts.project_market_memory_context --repository-root /opt/macro --public-store-root /var/lib/macro-market-memory/public/trusted-v1 --private-evidence-root /var/lib/macro-market-memory/state/context-projection
TimeoutStartSec=180
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=256M
MemoryMax=512M
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/macro
ReadWritePaths=/var/lib/macro-market-memory/public/trusted-v1
ReadWritePaths=/var/lib/macro-market-memory/state/context-projection
InaccessiblePaths=/var/lib/macro-market-memory-options
InaccessiblePaths=/etc/macro-market-memory-options
InaccessiblePaths=/var/lib/macro-market-memory/state/sources
InaccessiblePaths=-/var/lib/macro-api
InaccessiblePaths=-/var/lib/macro-biocatalyst
InaccessiblePaths=-/var/lib/macro-codex
InaccessiblePaths=-/var/lib/macro-codex-2
InaccessiblePaths=-/var/lib/macro-codex-3
InaccessiblePaths=-/var/lib/macro-live
InaccessiblePaths=-/etc/macro-admin.env
InaccessiblePaths=-/etc/macro-api.env
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env
InaccessiblePaths=-/etc/macro-live.env
InaccessiblePaths=-/etc/macro-market-memory.env
InaccessiblePaths=-/etc/macro-sentinel.env

[Install]
WantedBy=multi-user.target
