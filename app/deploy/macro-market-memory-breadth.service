# W1B.3A private current-tip breadth actual-output publisher. It is
# credential-free and network-dark, and it never writes the API-readable Market
# Memory tree. Historical breadth rows remain reconstruction-only and are never
# ingested by this lane.
[Unit]
Description=Capture private Market Memory breadth actual output
After=local-fs.target

[Service]
Type=oneshot
WorkingDirectory=/opt/macro
ExecStart=/opt/macro-api/.venv/bin/python -m scripts.capture_market_memory_breadth --repository-root /opt/macro --store-root /var/lib/macro-market-memory/state/breadth-v1
TimeoutStartSec=180
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=384M
MemoryMax=768M
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/macro
ReadWritePaths=/var/lib/macro-market-memory/state/breadth-v1
InaccessiblePaths=/var/lib/macro-market-memory-options
InaccessiblePaths=/etc/macro-market-memory-options
InaccessiblePaths=/var/lib/macro-market-memory/public
InaccessiblePaths=/var/lib/macro-market-memory/state/sources
InaccessiblePaths=/var/lib/macro-market-memory/state/context-projection
InaccessiblePaths=/var/lib/macro-market-memory/state/identity-v1
InaccessiblePaths=-/var/lib/macro-api
InaccessiblePaths=-/var/lib/macro-biocatalyst
InaccessiblePaths=-/var/lib/macro-codex
InaccessiblePaths=-/var/lib/macro-codex-2
InaccessiblePaths=-/var/lib/macro-codex-3
InaccessiblePaths=-/var/lib/macro-live
InaccessiblePaths=-/etc/macro-admin.env
InaccessiblePaths=-/etc/macro-api.env
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env
InaccessiblePaths=-/etc/macro-live.env
InaccessiblePaths=-/etc/macro-market-memory.env
InaccessiblePaths=-/etc/macro-ollama.env
InaccessiblePaths=-/etc/macro-sentinel.env

[Install]
WantedBy=multi-user.target
