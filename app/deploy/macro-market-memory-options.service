# W1B.5 private, future-only Massive SPY option-OI endpoint availability
# canary.  This service intentionally captures one bounded first page and never
# follows pagination, constructs a chain, normalizes contract identity, or
# computes an option feature.  Its credential is injected by systemd from a
# root-owned file and is never accepted through the environment or command line.
[Unit]
Description=Capture private Market Memory option-OI availability evidence
Wants=network-online.target
After=local-fs.target network-online.target macro-market-memory-source.service macro-market-memory-context.service macro-market-memory-identity.service macro-market-memory-breadth.service macro-market-memory-technicals.service
Conflicts=macro-market-memory-source.service macro-market-memory-context.service macro-market-memory-identity.service macro-market-memory-breadth.service macro-market-memory-technicals.service
ConditionPathExists=/run/macro-api-market-memory-options-deny.ready
ConditionPathExists=/run/macro-market-memory-options-reciprocal-deny.ready

[Service]
Type=oneshot
User=macro-market-memory-options
Group=macro-market-memory-options
WorkingDirectory=/opt/macro
LoadCredential=massive-option-oi-api-key:/etc/macro-market-memory-options/massive-option-oi-api-key
ExecCondition=/usr/bin/bash /opt/macro/app/deploy/market-memory-options-runtime-fence.sh --check
ExecStart=/opt/macro-api/.venv/bin/python -m scripts.capture_market_memory_option_oi --repository-root /opt/macro --store-root /var/lib/macro-market-memory-options/options-v1
TimeoutStartSec=180
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=384M
MemoryMax=768M
IOWeight=20
LimitCORE=0
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/macro
ReadWritePaths=/var/lib/macro-market-memory-options/options-v1
InaccessiblePaths=/var/lib/macro-market-memory
InaccessiblePaths=-/opt/macro/.env
InaccessiblePaths=-/var/lib/macro-api
InaccessiblePaths=-/var/lib/macro-biocatalyst
InaccessiblePaths=-/var/lib/macro-codex
InaccessiblePaths=-/var/lib/macro-codex-2
InaccessiblePaths=-/var/lib/macro-codex-3
InaccessiblePaths=-/var/lib/macro-live
InaccessiblePaths=/etc/macro-market-memory-options
InaccessiblePaths=-/etc/macro-admin.env
InaccessiblePaths=-/etc/macro-api.env
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env
InaccessiblePaths=-/etc/macro-biocatalyst-fixed-cohort.env
InaccessiblePaths=-/etc/macro-biocatalyst-fixed-cohort
InaccessiblePaths=-/etc/macro-live.env
InaccessiblePaths=-/etc/macro-market-memory.env
InaccessiblePaths=-/etc/macro-sentinel.env
InaccessiblePaths=-/etc/ssl/cf-origin.key

[Install]
WantedBy=multi-user.target
