# W2C private prospective SPY experience accrual.  It reads only already-
# published trusted macro and private technical owner generations, has no
# network or credentials, and writes only its disjoint experience ledger.
[Unit]
Description=Accrue the private preregistered SPY Market Memory experience ledger
After=local-fs.target macro-market-memory-source.service macro-market-memory-context.service macro-market-memory-identity.service macro-market-memory-breadth.service macro-market-memory-technicals.service
Conflicts=macro-market-memory-options.service

[Service]
Type=oneshot
WorkingDirectory=/opt/macro
ExecStart=/opt/macro-api/.venv/bin/python -m scripts.accrue_market_memory_spy_experience --repository-root /opt/macro --experience-root /var/lib/macro-market-memory/state/experience-v1 --trusted-root /var/lib/macro-market-memory/public/trusted-v1 --technical-root /var/lib/macro-market-memory/state/technicals-v1
TimeoutStartSec=1100
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
# Default-deny the complete Market Memory hierarchy, then bind back only the
# two authenticated owner roots and this writer's private ledger.  The
# explicit InaccessiblePaths entries below remain useful defence in depth for
# known legacy/sibling locations, while this empty mount also hides any future
# sibling added under the hierarchy.
TemporaryFileSystem=/var/lib/macro-market-memory:ro
BindReadOnlyPaths=/var/lib/macro-market-memory/public/trusted-v1
BindReadOnlyPaths=/var/lib/macro-market-memory/state/technicals-v1
BindPaths=/var/lib/macro-market-memory/state/experience-v1
ReadOnlyPaths=/opt/macro
ReadOnlyPaths=/var/lib/macro-market-memory/public/trusted-v1
ReadOnlyPaths=/var/lib/macro-market-memory/state/technicals-v1
ReadWritePaths=/var/lib/macro-market-memory/state/experience-v1
InaccessiblePaths=/var/lib/macro-market-memory-options
InaccessiblePaths=/etc/macro-market-memory-options
InaccessiblePaths=/var/lib/macro-market-memory/public/generations
InaccessiblePaths=-/var/lib/macro-market-memory/public/objects
InaccessiblePaths=-/var/lib/macro-market-memory/public/contexts
InaccessiblePaths=-/var/lib/macro-market-memory/public/queries
InaccessiblePaths=/var/lib/macro-market-memory/public/HEAD.json
InaccessiblePaths=/var/lib/macro-market-memory/public/store_manifest.json
InaccessiblePaths=/var/lib/macro-market-memory/state/sources
InaccessiblePaths=/var/lib/macro-market-memory/state/context-projection
InaccessiblePaths=/var/lib/macro-market-memory/state/identity-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/breadth-v1
InaccessiblePaths=/var/lib/macro-market-memory/state/production-record-options-episode-v1
InaccessiblePaths=-/opt/macro/.env
InaccessiblePaths=-/var/lib/macro-api
InaccessiblePaths=-/var/lib/macro-biocatalyst
InaccessiblePaths=-/var/lib/macro-codex
InaccessiblePaths=-/var/lib/macro-codex-2
InaccessiblePaths=-/var/lib/macro-codex-3
InaccessiblePaths=-/var/lib/macro-live
InaccessiblePaths=-/etc/macro-admin.env
InaccessiblePaths=-/etc/macro-api.env
InaccessiblePaths=-/etc/macro-biocatalyst.env
InaccessiblePaths=-/etc/macro-biocatalyst-control.env
InaccessiblePaths=-/etc/macro-biocatalyst-fixed-cohort.env
InaccessiblePaths=-/etc/macro-biocatalyst-fixed-cohort
InaccessiblePaths=-/etc/macro-live.env
InaccessiblePaths=-/etc/macro-market-memory.env
InaccessiblePaths=-/etc/macro-ollama.env
InaccessiblePaths=-/etc/macro-sentinel.env
InaccessiblePaths=-/etc/ssl/cf-origin.key

[Install]
WantedBy=multi-user.target
