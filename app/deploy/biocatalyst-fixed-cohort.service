# B1S2b privileged fixed-cohort transport lane.
#
# This unit is installed INERT and is never enabled or started by
# biocatalyst-fixed-cohort-setup.sh or by app/deploy/update.sh.  It runs under
# its own dedicated macro-biocatalyst-fixed-cohort identity, reads membership
# only from the root-owned immutable manifest that
# /etc/macro-biocatalyst-fixed-cohort/active.json names, and carries no R2 or
# publication credentials of any kind: it cannot write the public projection.
#
# The existing B0a worker lane (/var/lib/macro-biocatalyst and its env files) is
# explicitly masked below so the two lanes cannot read or corrupt each other.
[Unit]
Description=Mastermind BioCatalyst fixed-cohort bounded transport (operator-armed only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/macro-biocatalyst-fixed-cohort.env
ConditionPathExists=/etc/macro-biocatalyst-fixed-cohort/active.json

[Service]
Type=oneshot
User=macro-biocatalyst-fixed-cohort
Group=macro-biocatalyst-fixed-cohort
WorkingDirectory=/opt/macro
# Transport enablement and limits only.  Cohort membership is never an
# environment variable; the runtime refuses to start if one so much as mentions
# an NCT identifier.
EnvironmentFile=/etc/macro-biocatalyst-fixed-cohort.env
ExecStart=/opt/macro-biocatalyst-fixed-cohort/current/bin/python -m scripts.biocatalyst_fixed_cohort_transport --mode collect --manifest /etc/macro-biocatalyst-fixed-cohort/active.json --receipt-root /var/lib/macro-biocatalyst-fixed-cohort/receipts --run-root /var/lib/macro-biocatalyst-fixed-cohort/runs --operational-root /var/lib/macro-biocatalyst-fixed-cohort/operational
# One bounded conversation is two version probes and one page request; the
# transport library owns its own retry budget and byte caps.
TimeoutStartSec=600
Nice=12
CPUWeight=20
CPUQuota=50%
MemoryHigh=256M
MemoryMax=384M
IOWeight=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/macro-biocatalyst-fixed-cohort/runs
ReadWritePaths=/var/lib/macro-biocatalyst-fixed-cohort/receipts
ReadWritePaths=/var/lib/macro-biocatalyst-fixed-cohort/operational
ReadOnlyPaths=/etc/macro-biocatalyst-fixed-cohort
InaccessiblePaths=/etc/macro-biocatalyst-fixed-cohort.env
# Non-overlap with the B0a worker lane.
InaccessiblePaths=/var/lib/macro-biocatalyst
InaccessiblePaths=/etc/macro-biocatalyst.env
InaccessiblePaths=/etc/macro-biocatalyst-control.env
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
