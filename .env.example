# Local secrets template — copy to .env (gitignored) and fill in. CI uses real
# env vars, which always win over the .env file (see lib/config.py:_load_dotenv).

# Buffer personal access token — from Buffer's API/developer settings (GraphQL beta). Used by the W1 social publisher.
BUFFER_TOKEN=

# Global publish kill-switch for the W1 social publisher. UNSET (or 0) = DARK:
# every path runs dry-run and posts nothing. Set to 1 (with BUFFER_TOKEN + a
# configured channel id) to arm live posting. Unset to instantly revert to dry-run.
MARKETING_PUBLISH_ENABLED=

# Amplify's PUBLIC Firebase web key — the one their own fund pages ship in JS, not
# a secret. It reads the sponsor's Firestore holdings feed (collectors/etf_holdings.py
# `_fetch_amplify`, scripts/backfill_etf.py `backfill_amplify`), which is the only
# ~9-month backfillable source on the board outside Global X. Absent, the Amplify
# funds (BLOK/SILJ/BATT) raise and are skipped — never silently emptied.
# daily.yml already passes it from repo secrets, so ONLY local runs need this file;
# a git WORKTREE does not inherit the repo-root .env (it is gitignored, not tracked),
# which is exactly why the 2026-08-12 W2 sweep reported the key "not set" and could
# take no Amplify receipt. Copy it in, or `set -a && . ../../../.env && set +a`.
AMPLIFY_FIREBASE_KEY=

# Optional private Ollama fallback. A lane uses it only when its provider_order
# explicitly includes `ollama`. Plain HTTP is accepted only over loopback or
# Tailscale; do not expose port 11434 to the public internet.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:9b
