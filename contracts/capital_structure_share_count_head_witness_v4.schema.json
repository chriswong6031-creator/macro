{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_share_count_head_witness_v4.schema.json",
  "title": "Native scope-bound share-count publication head witness",
  "description": "The closed v4 head-witness contract for the existing mutable R2 selector. It binds one immutable share-count receipt and ledger selection to an exact R2 scope and a closed transition proof. This schema grants no analytical or decision authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "key_id",
    "sequence",
    "receipt_id",
    "receipt_sha256",
    "receipt_byte_length",
    "receipt_object_key",
    "generation_id",
    "ledger_sha256",
    "ledger_byte_length",
    "ledger_object_key",
    "published_at",
    "previous_receipt",
    "guard_scope",
    "transition",
    "signature"
  ],
  "properties": {
    "schema": {"const": "capital_structure.share_count_head_witness/v4"},
    "key_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551616},
    "receipt_id": {"type": "string", "pattern": "^receipt:cs-share-count-materialization-v2:[a-f0-9]{64}$"},
    "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receipt_byte_length": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "receipt_object_key": {"type": "string", "pattern": "^capital_structure/share_counts/v2/receipts/[a-f0-9]{64}\\.json$"},
    "generation_id": {"type": "string", "pattern": "^generation:cs-share-count-materialization-v2:[a-f0-9]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ledger_byte_length": {"type": "integer", "minimum": 1, "maximum": 134217728},
    "ledger_object_key": {"type": "string", "pattern": "^capital_structure/share_counts/v2/generations/[a-f0-9]{64}/ledger\\.json$"},
    "published_at": {"type": "string", "format": "date-time"},
    "previous_receipt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/receipt_ref"}
      ]
    },
    "guard_scope": {"$ref": "capital_structure_share_count_head_guard_scope.schema.json"},
    "transition": {
      "oneOf": [
        {"$ref": "#/$defs/genesis_transition"},
        {"$ref": "#/$defs/migration_transition"},
        {"$ref": "#/$defs/successor_transition"}
      ]
    },
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "receipt_id", "receipt_sha256", "receipt_byte_length"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551616},
        "receipt_id": {"type": "string", "pattern": "^receipt:cs-share-count-materialization-v2:[a-f0-9]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "receipt_byte_length": {"type": "integer", "minimum": 1, "maximum": 4194304}
      }
    },
    "genesis_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"const": "genesis"}
      }
    },
    "migration_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from_schema", "from_witness_sha256", "v2_anchor_sha256"],
      "properties": {
        "kind": {"const": "migration"},
        "from_schema": {
          "enum": [
            "capital_structure.share_count_head_witness/v2",
            "capital_structure.share_count_head_witness/v3"
          ]
        },
        "from_witness_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "v2_anchor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "successor_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "previous_witness_sha256"],
      "properties": {
        "kind": {"const": "successor"},
        "previous_witness_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"sequence": {"const": 1}},
        "required": ["sequence"]
      },
      "then": {"properties": {"previous_receipt": {"type": "null"}}},
      "else": {"properties": {"previous_receipt": {"$ref": "#/$defs/receipt_ref"}}}
    },
    {
      "if": {
        "properties": {"transition": {"$ref": "#/$defs/genesis_transition"}},
        "required": ["transition"]
      },
      "then": {
        "properties": {
          "sequence": {"const": 1},
          "previous_receipt": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"transition": {"$ref": "#/$defs/successor_transition"}},
        "required": ["transition"]
      },
      "then": {
        "properties": {
          "sequence": {"minimum": 2},
          "previous_receipt": {"$ref": "#/$defs/receipt_ref"}
        }
      }
    }
  ]
}
