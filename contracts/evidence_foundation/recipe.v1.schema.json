{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/evidence_foundation/recipe.v1.schema.json",
  "title": "Evidence Foundation consumer recipe v1",
  "description": "An ordered, versioned composition instruction over EvidenceBlocks for one bounded consumer job. A recipe is not a store and carries no owner fact payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "recipe_id",
    "recipe_name",
    "consumer",
    "subject_key_types",
    "block_specs",
    "identity_joins",
    "refusal_degradation_rules",
    "dedup_dependence_rules",
    "output_mappings",
    "integrity",
    "authority"
  ],
  "properties": {
    "schema": {"const": "evidence_foundation.recipe.v1"},
    "version": {"const": "1.0.0"},
    "recipe_id": {"type": "string", "pattern": "^erp_[a-f0-9]{64}$"},
    "recipe_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "consumer": {"$ref": "#/$defs/consumer"},
    "subject_key_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "block_specs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/blockSpec"}
    },
    "identity_joins": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/identityJoin"}
    },
    "refusal_degradation_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/refusalRule"}
    },
    "dedup_dependence_rules": {"$ref": "#/$defs/dedupRules"},
    "output_mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/outputMapping"}
    },
    "integrity": {"$ref": "#/$defs/integrity"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "objectClass": {
      "enum": [
        "world_observation",
        "derived_view",
        "system_belief",
        "forward_claim",
        "instrument_state"
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workstream", "job", "output_contract"],
      "properties": {
        "workstream": {"type": "string", "pattern": "^WS:[A-Z][A-Z0-9-]*$"},
        "job": {"type": "string", "minLength": 1, "maxLength": 256},
        "output_contract": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "blockSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "block_key",
        "requirement",
        "allowed_owner_stores",
        "allowed_object_classes",
        "evidence_class",
        "minimum_references",
        "maximum_references",
        "on_absent",
        "output_fields"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1, "maximum": 1024},
        "block_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "requirement": {"enum": ["required", "optional"]},
        "allowed_owner_stores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "allowed_object_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/objectClass"}
        },
        "evidence_class": {"enum": ["fact", "deterministic", "model", "human"]},
        "minimum_references": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_references": {"type": "integer", "minimum": 1, "maximum": 64},
        "on_absent": {"enum": ["refuse", "degrade", "omit"]},
        "output_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}
        }
      }
    },
    "identityJoin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "only_via"],
      "properties": {
        "from": {"type": "string", "minLength": 1, "maxLength": 64},
        "to": {"type": "string", "minLength": 1, "maxLength": 64},
        "only_via": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "refusalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "condition", "effect"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
        "condition": {"type": "string", "minLength": 1, "maxLength": 1024},
        "effect": {"enum": ["refuse", "abstain", "degrade", "omit_optional"]}
      }
    },
    "dedupRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_relation_types",
        "nonautomatic_relation_types",
        "reference_count_implies_independence"
      ],
      "properties": {
        "automatic_relation_types": {
          "const": ["exact_duplicate", "same_fact", "same_event"]
        },
        "nonautomatic_relation_types": {
          "const": ["corroborates", "contradicts", "shares_upstream", "corrects", "supersedes", "projects"]
        },
        "reference_count_implies_independence": {"const": false}
      }
    },
    "outputMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_field", "block_key", "when_unavailable"],
      "properties": {
        "output_field": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "block_key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "when_unavailable": {"enum": ["refuse", "explicit_unavailable", "omit_optional"]}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator_receipt_required",
        "dominant_degradation_required",
        "partial_may_look_complete",
        "confidence_requires_receipt",
        "correction_recompilation_required",
        "owner_payload_copy_allowed"
      ],
      "properties": {
        "denominator_receipt_required": {"const": true},
        "dominant_degradation_required": {"const": true},
        "partial_may_look_complete": {"const": false},
        "confidence_requires_receipt": {"const": true},
        "correction_recompilation_required": {"const": true},
        "owner_payload_copy_allowed": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry"],
      "properties": {
        "can_rank": {"const": false},
        "can_gate": {"const": false},
        "can_size": {"const": false},
        "can_originate": {"const": false},
        "can_open_entry": {"const": false}
      }
    }
  }
}

