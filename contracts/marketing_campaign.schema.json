{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "marketing_campaign.v1",
  "title": "Marketing Campaign (campaign.v1)",
  "type": "object",
  "properties": {
    "campaign_id": {"type": "string"},
    "opportunity_id": {"type": "string"},
    "objective": {"type": "string"},
    "audience": {"type": "string"},
    "promise": {"type": "string"},
    "proof": {"type": "string"},
    "destination_product": {"type": "string"},
    "offer": {"type": "string"},
    "channels": {"type": "array", "items": {"type": "string"}},
    "asset_plan": {"type": "array", "items": {"type": "object"}},
    "experiment_id": {"type": ["string", "null"]},
    "budget_envelope": {
      "type": "object",
      "properties": {
        "total_usd": {"type": "number"},
        "spent_usd": {"type": "number"}
      }
    },
    "authority_level": {"type": "string"},
    "start_at": {"type": ["string", "null"]},
    "stop_at": {"type": ["string", "null"]},
    "rollback": {"type": "string"},
    "owner_department": {"type": "string"},
    "mode": {"type": "string", "enum": ["live", "shadow"]},
    "status": {"type": "string"}
  },
  "required": ["campaign_id", "opportunity_id", "objective", "audience", "promise", "owner_department"]
}
