{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_share_count_observation_v2.schema.json",
  "title": "Capital Structure authenticated Company Facts share-count observation v2",
  "description": "Immutable direct Company Facts fact normalization bound to a v2 authenticated bridge receipt. It does not select a current count, calculate dilution, or grant decision authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observation_id", "logical_observation_id", "fact_revision_id", "issuer_id", "metric", "fact", "security_class", "period", "filing", "state", "reported", "normalized", "evidence", "point_in_time", "relationships", "version", "authority"],
  "properties": {
    "schema": {"const": "capital_structure.share_count_observation.v2"},
    "observation_id": {"type": "string", "pattern": "^share-count-v2:cs:[a-f0-9]{24}$"},
    "logical_observation_id": {"type": "string", "pattern": "^share-count-slot-v2:cs:[a-f0-9]{24}$"},
    "fact_revision_id": {"type": "string", "pattern": "^share-count-revision-v2:cs:[a-f0-9]{24}$"},
    "issuer_id": {"type": "string", "pattern": "^issuer:[0-9]{10}$"},
    "metric": {"$ref": "#/$defs/metric"}, "fact": {"$ref": "#/$defs/fact"}, "security_class": {"$ref": "#/$defs/security_class"},
    "period": {"$ref": "#/$defs/period"}, "filing": {"$ref": "#/$defs/filing"}, "state": {"$ref": "#/$defs/state"},
    "reported": {"$ref": "#/$defs/reported"}, "normalized": {"$ref": "#/$defs/normalized"}, "evidence": {"$ref": "#/$defs/evidence"},
    "point_in_time": {"$ref": "#/$defs/point_in_time"}, "relationships": {"$ref": "#/$defs/relationships"}, "version": {"$ref": "#/$defs/version"}, "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "metric": {"type": "object", "additionalProperties": false, "required": ["kind", "scope"], "properties": {"kind": {"enum": ["common_shares_outstanding", "public_float"]}, "scope": {"const": "direct_sec_companyfacts_fact"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["namespace", "name", "unit", "scale", "source_value_encoding"], "properties": {"namespace": {"enum": ["us-gaap", "dei"]}, "name": {"enum": ["CommonStockSharesOutstanding", "EntityCommonStockSharesOutstanding", "EntityPublicFloat"]}, "unit": {"type": "string", "minLength": 1}, "scale": {"const": "1"}, "source_value_encoding": {"const": "companyfacts_actual_units"}}},
    "security_class": {"type": "object", "additionalProperties": false, "required": ["state", "classification", "raw_label", "basis"], "properties": {"state": {"enum": ["concept_semantic", "not_security_specific", "ambiguous"]}, "classification": {"type": ["string", "null"], "enum": ["common_stock", "not_security_specific", null]}, "raw_label": {"type": ["string", "null"], "maxLength": 500}, "basis": {"enum": ["xbrl_concept_semantics", "companyfacts_fact_has_no_security_class", "ambiguous_source_fact"]}}},
    "period": {"type": "object", "additionalProperties": false, "required": ["period_end", "fiscal_year", "fiscal_period", "frame"], "properties": {"period_end": {"type": ["string", "null"], "format": "date"}, "fiscal_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 3000}, "fiscal_period": {"type": ["string", "null"], "maxLength": 32}, "frame": {"type": ["string", "null"], "maxLength": 64}}},
    "filing": {"type": "object", "additionalProperties": false, "required": ["accession", "form", "filed", "accepted_at"], "properties": {"accession": {"type": ["string", "null"], "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "form": {"type": ["string", "null"], "maxLength": 32}, "filed": {"type": ["string", "null"], "format": "date"}, "accepted_at": {"type": ["string", "null"], "format": "date-time"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["disposition", "reason"], "properties": {"disposition": {"enum": ["observed", "deferred", "ambiguous"]}, "reason": {"enum": ["direct_sec_companyfacts_fact", "unexpected_unit", "missing_value", "negative_value", "missing_period_end", "missing_filing_provenance", "materialization_precedes_filed_date", "multiple_distinct_values_for_fact_slot", "multiple_distinct_contexts_for_fact_slot", "malformed_fact_entry"]}}},
    "reported": {"type": "object", "additionalProperties": false, "required": ["value", "unit", "scale"], "properties": {"value": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "unit": {"type": ["string", "null"], "minLength": 1}, "scale": {"type": ["string", "null"], "pattern": "^[0-9]+$"}}},
    "normalized": {"type": "object", "additionalProperties": false, "required": ["value", "unit", "scale", "state"], "properties": {"value": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "unit": {"type": ["string", "null"], "enum": ["shares", "USD", null]}, "scale": {"type": ["string", "null"], "pattern": "^[0-9]+$"}, "state": {"enum": ["observed", "deferred", "ambiguous"]}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["bridge_receipt_id", "source_manifest_id", "fact_entries"], "properties": {"bridge_receipt_id": {"type": "string", "pattern": "^companyfacts-bridge:cs:[a-f0-9]{24}$"}, "source_manifest_id": {"type": "string", "pattern": "^manifest:cs-companyfacts:[a-f0-9]{64}$"}, "fact_entries": {"type": "array", "minItems": 1, "maxItems": 250000, "items": {"$ref": "#/$defs/fact_entry"}}}},
    "fact_entry": {"type": "object", "additionalProperties": false, "required": ["json_pointer", "entry_sha256", "source_issue", "value", "unit", "period_end", "fiscal_year", "fiscal_period", "frame", "filed", "accession", "form", "raw_entry"], "properties": {"json_pointer": {"type": "string", "pattern": "^/facts/(?:us-gaap|dei)/[^/]+/units/[^/]+/[0-9]+$"}, "entry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_issue": {"type": ["string", "null"], "enum": ["unexpected_unit", "missing_value", "negative_value", "missing_period_end", "missing_filing_provenance", "malformed_fact_entry", null]}, "value": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}, "unit": {"type": "string", "minLength": 1}, "period_end": {"type": ["string", "null"], "format": "date"}, "fiscal_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 3000}, "fiscal_period": {"type": ["string", "null"], "maxLength": 32}, "frame": {"type": ["string", "null"], "maxLength": 64}, "filed": {"type": ["string", "null"], "format": "date"}, "accession": {"type": ["string", "null"], "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "form": {"type": ["string", "null"], "maxLength": 32}, "raw_entry": {"description": "Exact decoded JSON value committed by entry_sha256.", "type": ["object", "array", "string", "number", "integer", "boolean", "null"]}}},
    "point_in_time": {"type": "object", "additionalProperties": false, "required": ["source_retrieved_at", "materialized_at", "available_at", "public_available_at"], "properties": {"source_retrieved_at": {"type": "string", "format": "date-time"}, "materialized_at": {"type": "string", "format": "date-time"}, "available_at": {"type": "string", "format": "date-time"}, "public_available_at": {"type": "null"}}},
    "relationships": {"type": "object", "additionalProperties": false, "required": ["supersedes", "contradiction_ids"], "properties": {"supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^share-count-v2:cs:[a-f0-9]{24}$"}}, "contradiction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "version": {"type": "object", "additionalProperties": false, "required": ["immutable_record", "correction_version", "correction_of"], "properties": {"immutable_record": {"const": true}, "correction_version": {"type": "integer", "minimum": 1}, "correction_of": {"type": ["string", "null"], "pattern": "^share-count-v2:cs:[a-f0-9]{24}$"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["is_context_only", "share_count_ledger_authority", "instrument_authority", "capacity_authority", "runway_authority", "risk_authority", "rank_authority", "sizing_authority", "entry_authority", "trade_authority", "prophet_authority"], "properties": {"is_context_only": {"const": true}, "share_count_ledger_authority": {"const": false}, "instrument_authority": {"const": false}, "capacity_authority": {"const": false}, "runway_authority": {"const": false}, "risk_authority": {"const": false}, "rank_authority": {"const": false}, "sizing_authority": {"const": false}, "entry_authority": {"const": false}, "trade_authority": {"const": false}, "prophet_authority": {"const": false}}}
  }
}
