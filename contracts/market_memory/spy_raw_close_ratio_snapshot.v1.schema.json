{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/spy_raw_close_ratio_snapshot.v1.schema.json",
  "title": "Market Memory current SPY raw-close ratio snapshot v1",
  "description": "Strict clock-free W1B.3B feature object. The ratio uses provider-documented unadjusted daily-aggregate closes exactly 20 frozen XNYS session dates apart. The provider bar may include eligible full-market-day trades, so a regular-session close is not authenticated. It is not an economic return; corporate actions are unevaluated; all authority is display/context-only and zero-weight.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "source_observation_id",
    "session",
    "transform_version",
    "subject",
    "state",
    "price_basis",
    "quality",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.spy_raw_close_ratio_snapshot.v1"},
    "snapshot_id": {
      "type": "string",
      "pattern": "^mmtechsnap_[a-f0-9]{64}$"
    },
    "source_observation_id": {
      "type": "string",
      "pattern": "^mmtechsrc_[a-f0-9]{64}$"
    },
    "session": {"$ref": "#/$defs/date"},
    "transform_version": {
      "const": "market_memory.spy_raw_close_ratio_20_sessions.v1"
    },
    "subject": {"$ref": "#/$defs/subject"},
    "state": {"$ref": "#/$defs/state"},
    "price_basis": {"$ref": "#/$defs/priceBasis"},
    "quality": {"$ref": "#/$defs/quality"},
    "limitations": {"$ref": "#/$defs/limitations"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "subject_id",
        "instrument_id",
        "identity_version",
        "mic",
        "currency",
        "universe_id",
        "calendar_id",
        "market_session"
      ],
      "properties": {
        "symbol": {"const": "SPY"},
        "subject_id": {
          "const": "mmsecurity_5fc37e8db34f74314b654c910ea8bacfa7de8b5d2d067f2e5421c9d5745ceb4c"
        },
        "instrument_id": {
          "const": "mmsecurity_6f361f5bad9f06a3b2ff157585d5728f55f77198420959aadd8922d1045c3fea"
        },
        "identity_version": {
          "const": "mmidentityv_65ec5e55473e953b55fa2d146f40e8b56dfae2e68a3df7423405db1034d16903"
        },
        "mic": {"const": "ARCX"},
        "currency": {"const": "USD"},
        "universe_id": {
          "const": "mmuniverse_5f6904b77722f506a8d1d6f283ef69678a1ec7df3b2c1fc25cc1a15a3a4e8e6a"
        },
        "calendar_id": {
          "const": "mmcalendar_a102c5367c17f9c0b4df3af5c2826824fc112935ec76e6d18d55833f53644e0c"
        },
        "market_session": {
          "description": "Identity/calendar binding used for session dates only, not an assertion that the provider daily close is regular-session-only.",
          "const": "XNYS_REGULAR"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "lookback_sessions",
        "support_observations",
        "start_session",
        "end_session",
        "start_close",
        "end_close",
        "value"
      ],
      "properties": {
        "feature": {"const": "price.raw_close_ratio_20_sessions"},
        "lookback_sessions": {"const": 20},
        "support_observations": {"const": 21},
        "start_session": {"$ref": "#/$defs/date"},
        "end_session": {"$ref": "#/$defs/date"},
        "start_close": {"type": "number", "exclusiveMinimum": 0},
        "end_close": {"type": "number", "exclusiveMinimum": 0},
        "value": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "priceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "source_product",
        "source_contract_role",
        "source_contract_sha256",
        "basis_authenticated_by_shape",
        "source_session_scope",
        "regular_session_close_authenticated",
        "xnys_calendar_dates_only",
        "raw_unadjusted",
        "split_adjusted",
        "dividend_adjusted",
        "other_corporate_action_adjusted",
        "economic_return",
        "corporate_action_status",
        "split_detection"
      ],
      "properties": {
        "basis": {"const": "provider_documented_unadjusted_flat_file"},
        "source_product": {"const": "us_stocks_sip/day_aggs_v1"},
        "source_contract_role": {"const": "technical_price_basis_contract"},
        "source_contract_sha256": {
          "const": "ce0244d9c18e3fdcb621c7ced6e3700cb8cb43ff0952b355b82d0542ed6b1be9"
        },
        "basis_authenticated_by_shape": {"const": false},
        "source_session_scope": {
          "const": "provider_daily_aggregate_eligible_trades_full_market_day"
        },
        "regular_session_close_authenticated": {"const": false},
        "xnys_calendar_dates_only": {"const": true},
        "raw_unadjusted": {"const": true},
        "split_adjusted": {"const": false},
        "dividend_adjusted": {"const": false},
        "other_corporate_action_adjusted": {"const": false},
        "economic_return": {"const": false},
        "corporate_action_status": {"const": "not_evaluated"},
        "split_detection": {"const": false}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "flags",
        "actual_output_source",
        "current_endpoint_only",
        "imputed",
        "training_eligible",
        "promotion_eligible"
      ],
      "properties": {
        "status": {"const": "degraded"},
        "flags": {
          "type": "array",
          "prefixItems": [
            {"const": "corporate_actions_not_evaluated"},
            {"const": "raw_unadjusted_not_economic_return"},
            {"const": "regular_session_close_not_authenticated"},
            {"const": "partial_calendar_coverage"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "actual_output_source": {"const": true},
        "current_endpoint_only": {"const": true},
        "imputed": {"const": false},
        "training_eligible": {"const": false},
        "promotion_eligible": {"const": false}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_endpoint_only",
        "historical_rows_support_only",
        "historical_rows_operational",
        "session_calendar_use",
        "provider_daily_aggregate_scope",
        "regular_session_close_authenticated",
        "point_in_time_corporate_actions",
        "total_return",
        "calendar_coverage",
        "calendar_partial_coverage"
      ],
      "properties": {
        "current_endpoint_only": {"const": true},
        "historical_rows_support_only": {"const": true},
        "historical_rows_operational": {"const": false},
        "session_calendar_use": {"const": "dates_only"},
        "provider_daily_aggregate_scope": {
          "const": "provider_daily_aggregate_eligible_trades_full_market_day"
        },
        "regular_session_close_authenticated": {"const": false},
        "point_in_time_corporate_actions": {"const": false},
        "total_return": {"const": false},
        "calendar_coverage": {"const": "full_day_closures_only"},
        "calendar_partial_coverage": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "horizon_role",
        "context_only",
        "proposal_weight",
        "may_rank",
        "may_gate",
        "may_size",
        "may_escalate",
        "may_trade",
        "may_originate",
        "may_select_options_candidate",
        "may_execute",
        "may_write_options_episode",
        "may_append_outcome",
        "may_train_prophet"
      ],
      "properties": {
        "tier": {"const": "display"},
        "horizon_role": {"const": "context"},
        "context_only": {"const": true},
        "proposal_weight": {"const": 0},
        "may_rank": {"const": false},
        "may_gate": {"const": false},
        "may_size": {"const": false},
        "may_escalate": {"const": false},
        "may_trade": {"const": false},
        "may_originate": {"const": false},
        "may_select_options_candidate": {"const": false},
        "may_execute": {"const": false},
        "may_write_options_episode": {"const": false},
        "may_append_outcome": {"const": false},
        "may_train_prophet": {"const": false}
      }
    }
  }
}
