{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/forecast_record.v1.schema.json",
  "title": "Market Memory sealed forecast or abstention record v1",
  "description": "Strict W2A pre-outcome record. Each admitted opportunity record is issued or abstained before its horizon, binds exact state/plan/target/outcome-definition/model/code/config/baseline identities, and cannot carry outcomes, scores, or postmortems. Population completeness is deferred to a later opportunity schedule/writer.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 26,
  "maxProperties": 26,
  "required": [
    "schema",
    "forecast_id",
    "forecast_key",
    "outcome_event_id",
    "trial_registration_id",
    "trial_key",
    "state_snapshot_id",
    "context_id",
    "as_known_at",
    "decision_cutoff",
    "sealed_at",
    "horizon_start",
    "horizon_end",
    "evaluation_at",
    "disposition",
    "abstention_reason",
    "plan_sha256",
    "target_sha256",
    "outcome_definition_sha256",
    "model_sha256",
    "code_sha256",
    "config_sha256",
    "predictive_distribution",
    "baseline_refs",
    "emission_enabled",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.forecast_record.v1"},
    "forecast_id": {"type": "string", "pattern": "^mmforecast_[a-f0-9]{64}$"},
    "forecast_key": {"type": "string", "pattern": "^mmforecastkey_[a-f0-9]{64}$"},
    "outcome_event_id": {"type": "string", "pattern": "^mmoutcomeevent_[a-f0-9]{64}$"},
    "trial_registration_id": {"type": "string", "pattern": "^mmtrial_[a-f0-9]{64}$"},
    "trial_key": {"$ref": "#/$defs/opaque"},
    "state_snapshot_id": {"type": "string", "pattern": "^mmstate_[a-f0-9]{64}$"},
    "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
    "as_known_at": {"$ref": "#/$defs/timestamp"},
    "decision_cutoff": {"$ref": "#/$defs/timestamp"},
    "sealed_at": {"$ref": "#/$defs/timestamp"},
    "horizon_start": {"$ref": "#/$defs/timestamp"},
    "horizon_end": {"$ref": "#/$defs/timestamp"},
    "evaluation_at": {"$ref": "#/$defs/timestamp"},
    "disposition": {"enum": ["issued", "abstained"]},
    "abstention_reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/abstentionReason"}]},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_definition_sha256": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"},
    "code_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "predictive_distribution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/predictiveDistribution"}]},
    "baseline_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "trial_registration.v1.schema.json#/$defs/baseline"}},
    "emission_enabled": {"const": false},
    "authority": {"$ref": "state_snapshot.v1.schema.json#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "issued"}}, "required": ["disposition"]},
      "then": {"properties": {"abstention_reason": {"type": "null"}, "predictive_distribution": {"$ref": "#/$defs/predictiveDistribution"}}}
    },
    {
      "if": {"properties": {"disposition": {"const": "abstained"}}, "required": ["disposition"]},
      "then": {"properties": {"abstention_reason": {"$ref": "#/$defs/abstentionReason"}, "predictive_distribution": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 27, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "abstentionReason": {"enum": ["insufficient_domains", "required_domain_missing", "input_stale", "out_of_distribution", "model_unavailable", "policy_expired", "quality_gate_failed"]},
    "quantile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "required": ["level", "value"],
      "properties": {"level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "value": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}}
    },
    "probability": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "required": ["category", "probability"],
      "properties": {"category": {"$ref": "#/$defs/opaque"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "predictiveDistribution": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["kind", "point", "quantiles", "probabilities"],
      "properties": {
        "kind": {"enum": ["scalar", "quantiles", "categorical"]},
        "point": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}]},
        "quantiles": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/quantile"}},
        "probabilities": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/probability"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "scalar"}}, "required": ["kind"]}, "then": {"properties": {"point": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}, "quantiles": {"maxItems": 0}, "probabilities": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "quantiles"}}, "required": ["kind"]}, "then": {"properties": {"point": {"type": "null"}, "quantiles": {"minItems": 1}, "probabilities": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "categorical"}}, "required": ["kind"]}, "then": {"properties": {"point": {"type": "null"}, "quantiles": {"maxItems": 0}, "probabilities": {"minItems": 2}}}}
      ]
    }
  }
}
