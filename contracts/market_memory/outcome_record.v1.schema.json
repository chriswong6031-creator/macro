{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/outcome_record.v1.schema.json",
  "title": "Market Memory append-only outcome record v1",
  "description": "Strict W2A later-outcome revision keyed by a deterministic shared outcome event. It cannot mutate a state, trial, or forecast and carries complete source/knowledge/observation/recording clocks plus explicit revision lineage.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 23,
  "maxProperties": 23,
  "required": [
    "schema",
    "outcome_record_id",
    "outcome_event_id",
    "context_id",
    "target_sha256",
    "outcome_definition_sha256",
    "horizon_start",
    "horizon_end",
    "evaluation_at",
    "status",
    "outcome_value",
    "reason",
    "effective_at",
    "source_available_at",
    "known_at",
    "observed_at",
    "recorded_at",
    "source_receipts",
    "revision_number",
    "revision_of",
    "revision_reason",
    "emission_enabled",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.outcome_record.v1"},
    "outcome_record_id": {"type": "string", "pattern": "^mmoutcome_[a-f0-9]{64}$"},
    "outcome_event_id": {"type": "string", "pattern": "^mmoutcomeevent_[a-f0-9]{64}$"},
    "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_definition_sha256": {"$ref": "#/$defs/sha256"},
    "horizon_start": {"$ref": "#/$defs/timestamp"},
    "horizon_end": {"$ref": "#/$defs/timestamp"},
    "evaluation_at": {"$ref": "#/$defs/timestamp"},
    "status": {"enum": ["complete", "censored", "missing"]},
    "outcome_value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcomeValue"}]},
    "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/outcomeReason"}]},
    "effective_at": {"$ref": "#/$defs/timestamp"},
    "source_available_at": {"$ref": "#/$defs/timestamp"},
    "known_at": {"$ref": "#/$defs/timestamp"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "source_receipts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/sourceReceipt"}},
    "revision_number": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "revision_of": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^mmoutcome_[a-f0-9]{64}$"}]},
    "revision_reason": {"oneOf": [{"type": "null"}, {"enum": ["source_revision", "quality_correction", "clock_correction", "status_resolution"]}]},
    "emission_enabled": {"const": false},
    "authority": {"$ref": "state_snapshot.v1.schema.json#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {"properties": {"outcome_value": {"$ref": "#/$defs/outcomeValue"}, "reason": {"type": "null"}, "source_receipts": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "censored"}}, "required": ["status"]},
      "then": {"properties": {"outcome_value": {"type": "null"}, "reason": {"enum": ["source_window_incomplete", "instrument_unavailable", "event_invalidated", "coverage_ended"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "missing"}}, "required": ["status"]},
      "then": {"properties": {"outcome_value": {"type": "null"}, "reason": {"enum": ["source_unavailable", "source_not_published", "identity_unresolved", "quality_gate_failed"]}}}
    },
    {
      "if": {"properties": {"revision_number": {"const": 1}}, "required": ["revision_number"]},
      "then": {"properties": {"revision_of": {"type": "null"}, "revision_reason": {"type": "null"}}},
      "else": {"properties": {"revision_of": {"type": "string", "pattern": "^mmoutcome_[a-f0-9]{64}$"}, "revision_reason": {"enum": ["source_revision", "quality_correction", "clock_correction", "status_resolution"]}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 27, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "outcomeReason": {"enum": ["source_window_incomplete", "instrument_unavailable", "event_invalidated", "coverage_ended", "source_unavailable", "source_not_published", "identity_unresolved", "quality_gate_failed"]},
    "outcomeValue": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 3,
      "maxProperties": 3,
      "required": ["value_type", "value", "unit"],
      "properties": {
        "value_type": {"enum": ["number", "integer", "string"]},
        "value": {"anyOf": [{"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}, {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}]},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"}
      },
      "allOf": [
        {"if": {"properties": {"value_type": {"const": "number"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}}}},
        {"if": {"properties": {"value_type": {"const": "integer"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "integer", "minimum": -1000000000000000, "maximum": 1000000000000000}}}},
        {"if": {"properties": {"value_type": {"const": "string"}}, "required": ["value_type"]}, "then": {"properties": {"value": {"type": "string"}}}}
      ]
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["receipt_id", "artifact_sha256", "source_schema", "source_version"],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/opaque"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_schema": {"$ref": "#/$defs/opaque"},
        "source_version": {"$ref": "#/$defs/opaque"}
      }
    }
  }
}
