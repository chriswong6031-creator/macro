{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/spy_listing_observation.v1.schema.json",
  "title": "Market Memory SPY source listing observation v1",
  "description": "One exact complete snapshot occurrence with date-partition precision and an honest post-read availability clock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_observation_id",
    "listing_object_id",
    "subject",
    "date_partition",
    "partition_bounds",
    "listing_state",
    "source_artifact",
    "completion_receipt",
    "pit_basis",
    "operational",
    "measurement_time",
    "available_at",
    "observed_at",
    "evidence_policy",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.spy_listing_observation.v1"},
    "source_observation_id": {"type": "string", "pattern": "^mmidobs_[a-f0-9]{64}$"},
    "listing_object_id": {"type": "string", "pattern": "^mmidobj_[a-f0-9]{64}$"},
    "subject": {"$ref": "#/$defs/subject"},
    "date_partition": {"$ref": "#/$defs/date"},
    "partition_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "lower_bound", "upper_bound_exclusive"],
      "properties": {
        "precision": {"const": "date_partition"},
        "lower_bound": {"$ref": "#/$defs/utc"},
        "upper_bound_exclusive": {"$ref": "#/$defs/utc"}
      }
    },
    "listing_state": {
      "enum": ["present_in_snapshot", "symbol_absent_from_complete_snapshot"]
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256", "bytes", "rows", "parquet_columns"],
      "properties": {
        "kind": {"const": "listing_snapshot"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "rows": {"type": "integer", "minimum": 8000, "maximum": 30000},
        "parquet_columns": {
          "const": ["date", "symbol", "security_name", "exchange", "etf", "test_issue", "is_preferred", "source"]
        }
      }
    },
    "completion_receipt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/completionReceipt"}
      ]
    },
    "pit_basis": {"enum": ["live_captured", "public_reconstruction"]},
    "operational": {"type": "boolean"},
    "measurement_time": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/utc"}]
    },
    "available_at": {"$ref": "#/$defs/utc"},
    "observed_at": {"$ref": "#/$defs/utc"},
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_output_only",
        "source_artifact_bytes_bound",
        "completion_receipt_authenticated",
        "historical_resolver",
        "training_eligible",
        "promotion_eligible",
        "role"
      ],
      "properties": {
        "actual_output_only": {"const": true},
        "source_artifact_bytes_bound": {"const": true},
        "completion_receipt_authenticated": {"type": "boolean"},
        "historical_resolver": {"const": false},
        "training_eligible": {"const": false},
        "promotion_eligible": {"const": false},
        "role": {"const": "context_only"}
      }
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"operational": {"const": true}}},
      "then": {
        "properties": {
          "pit_basis": {"const": "live_captured"},
          "completion_receipt": {"$ref": "#/$defs/completionReceipt"},
          "measurement_time": {"$ref": "#/$defs/utc"},
          "evidence_policy": {
            "properties": {"completion_receipt_authenticated": {"const": true}}
          }
        }
      }
    },
    {
      "if": {"properties": {"operational": {"const": false}}},
      "then": {
        "properties": {
          "pit_basis": {"const": "public_reconstruction"},
          "completion_receipt": {"type": "null"},
          "measurement_time": {"type": "null"},
          "evidence_policy": {
            "properties": {"completion_receipt_authenticated": {"const": false}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "instrument_id", "identity_version"],
      "properties": {
        "subject_id": {"const": "mmsecurity_5fc37e8db34f74314b654c910ea8bacfa7de8b5d2d067f2e5421c9d5745ceb4c"},
        "instrument_id": {"const": "mmsecurity_6f361f5bad9f06a3b2ff157585d5728f55f77198420959aadd8922d1045c3fea"},
        "identity_version": {"const": "mmidentityv_65ec5e55473e953b55fa2d146f40e8b56dfae2e68a3df7423405db1034d16903"}
      }
    },
    "completionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "profile", "receipt_id", "sha256", "bytes", "collector_started_at", "collector_completed_at"],
      "properties": {
        "schema": {"const": "symbol_directory.completion_receipt.v1"},
        "profile": {"const": "symbol_directory.operational_capture.v1"},
        "receipt_id": {"type": "string", "pattern": "^sdreceipt_[a-f0-9]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
        "collector_started_at": {"$ref": "#/$defs/utc"},
        "collector_completed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "authority": {
      "const": {
        "tier": "display",
        "horizon_role": "context",
        "context_only": true,
        "proposal_weight": 0,
        "may_rank": false,
        "may_gate": false,
        "may_size": false,
        "may_escalate": false,
        "may_trade": false,
        "may_originate": false,
        "may_select_options_candidate": false,
        "may_execute": false,
        "may_write_options_episode": false,
        "may_append_outcome": false,
        "may_train_prophet": false
      }
    }
  }
}
