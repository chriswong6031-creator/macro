{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/event_score_record.v1.schema.json",
  "title": "Market Memory synthetic per-event score record v1",
  "description": "Strict W2B1 score for one W2A forecast/outcome revision and its exact synthetic baseline bundle. It contains no aggregate, delta, winner, skill, fitting, or promotion claim.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 34,
  "maxProperties": 34,
  "required": [
    "schema", "event_score_record_id", "baseline_forecast_bundle_id", "forecast_id", "forecast_key",
    "trial_registration_id", "state_snapshot_id", "context_id", "outcome_event_id", "outcome_record_id",
    "outcome_revision_number", "target_sha256", "outcome_definition_sha256", "decision_cutoff", "sealed_at",
    "horizon_start", "horizon_end", "evaluation_at", "outcome_status", "outcome_reason", "outcome_recorded_at",
    "evaluated_at", "evaluator_code_sha256", "evaluator_config_sha256", "formula", "formula_version", "numeric_convention", "orientation",
    "candidate_score", "baseline_scores", "input_profile", "claims", "emission_enabled", "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.event_score_record.v1"},
    "event_score_record_id": {"type": "string", "pattern": "^mmeventscore_[a-f0-9]{64}$"},
    "baseline_forecast_bundle_id": {"type": "string", "pattern": "^mmbaselinebundle_[a-f0-9]{64}$"},
    "forecast_id": {"type": "string", "pattern": "^mmforecast_[a-f0-9]{64}$"},
    "forecast_key": {"type": "string", "pattern": "^mmforecastkey_[a-f0-9]{64}$"},
    "trial_registration_id": {"type": "string", "pattern": "^mmtrial_[a-f0-9]{64}$"},
    "state_snapshot_id": {"type": "string", "pattern": "^mmstate_[a-f0-9]{64}$"},
    "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
    "outcome_event_id": {"type": "string", "pattern": "^mmoutcomeevent_[a-f0-9]{64}$"},
    "outcome_record_id": {"type": "string", "pattern": "^mmoutcome_[a-f0-9]{64}$"},
    "outcome_revision_number": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_definition_sha256": {"$ref": "#/$defs/sha256"},
    "decision_cutoff": {"$ref": "#/$defs/timestamp"},
    "sealed_at": {"$ref": "#/$defs/timestamp"},
    "horizon_start": {"$ref": "#/$defs/timestamp"},
    "horizon_end": {"$ref": "#/$defs/timestamp"},
    "evaluation_at": {"$ref": "#/$defs/timestamp"},
    "outcome_status": {"enum": ["complete", "censored", "missing"]},
    "outcome_reason": {"oneOf": [{"type": "null"}, {"enum": ["source_window_incomplete", "instrument_unavailable", "event_invalidated", "coverage_ended", "source_unavailable", "source_not_published", "identity_unresolved", "quality_gate_failed"]}]},
    "outcome_recorded_at": {"$ref": "#/$defs/timestamp"},
    "evaluated_at": {"$ref": "#/$defs/timestamp"},
    "evaluator_code_sha256": {"$ref": "#/$defs/sha256"},
    "evaluator_config_sha256": {"$ref": "#/$defs/sha256"},
    "formula": {"enum": ["squared_error", "absolute_error", "mean_pinball_loss", "multiclass_log_loss", "multiclass_brier_sum"]},
    "formula_version": {"enum": ["squared_error.v1", "absolute_error.v1", "mean_pinball_loss.v1", "multiclass_log_loss.v1", "multiclass_brier_sum.v1"]},
    "numeric_convention": {"const": "decimal64_half_even_q18/v1"},
    "orientation": {"const": "lower_is_better"},
    "candidate_score": {"$ref": "#/$defs/score"},
    "baseline_scores": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/baselineScore"}},
    "input_profile": {"const": "synthetic_fixture_only"},
    "claims": {"$ref": "baseline_forecast_bundle.v1.schema.json#/$defs/claims"},
    "emission_enabled": {"const": false},
    "authority": {"$ref": "state_snapshot.v1.schema.json#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome_status": {"const": "complete"}}, "required": ["outcome_status"]},
      "then": {
        "properties": {
          "outcome_reason": {"type": "null"},
          "candidate_score": {"properties": {"not_scored_reason": {"oneOf": [{"type": "null"}, {"const": "forecast_abstained"}]}}},
          "baseline_scores": {"items": {"properties": {"not_scored_reason": {"oneOf": [{"type": "null"}, {"const": "baseline_unavailable"}]}}}}
        }
      }
    },
    {
      "if": {"properties": {"outcome_status": {"const": "censored"}}, "required": ["outcome_status"]},
      "then": {
        "properties": {
          "outcome_reason": {"enum": ["source_window_incomplete", "instrument_unavailable", "event_invalidated", "coverage_ended"]},
          "candidate_score": {"properties": {"disposition": {"const": "not_scored"}, "not_scored_reason": {"enum": ["forecast_abstained", "outcome_censored"]}, "score_value": {"type": "null"}}},
          "baseline_scores": {"items": {"properties": {"disposition": {"const": "not_scored"}, "not_scored_reason": {"enum": ["baseline_unavailable", "outcome_censored"]}, "score_value": {"type": "null"}}}}
        }
      }
    },
    {
      "if": {"properties": {"outcome_status": {"const": "missing"}}, "required": ["outcome_status"]},
      "then": {
        "properties": {
          "outcome_reason": {"enum": ["source_unavailable", "source_not_published", "identity_unresolved", "quality_gate_failed"]},
          "candidate_score": {"properties": {"disposition": {"const": "not_scored"}, "not_scored_reason": {"enum": ["forecast_abstained", "outcome_missing"]}, "score_value": {"type": "null"}}},
          "baseline_scores": {"items": {"properties": {"disposition": {"const": "not_scored"}, "not_scored_reason": {"enum": ["baseline_unavailable", "outcome_missing"]}, "score_value": {"type": "null"}}}}
        }
      }
    },
    {"if": {"properties": {"formula": {"const": "squared_error"}}, "required": ["formula"]}, "then": {"properties": {"formula_version": {"const": "squared_error.v1"}}}},
    {"if": {"properties": {"formula": {"const": "absolute_error"}}, "required": ["formula"]}, "then": {"properties": {"formula_version": {"const": "absolute_error.v1"}}}},
    {"if": {"properties": {"formula": {"const": "mean_pinball_loss"}}, "required": ["formula"]}, "then": {"properties": {"formula_version": {"const": "mean_pinball_loss.v1"}}}},
    {"if": {"properties": {"formula": {"const": "multiclass_log_loss"}}, "required": ["formula"]}, "then": {"properties": {"formula_version": {"const": "multiclass_log_loss.v1"}}}},
    {"if": {"properties": {"formula": {"const": "multiclass_brier_sum"}}, "required": ["formula"]}, "then": {"properties": {"formula_version": {"const": "multiclass_brier_sum.v1"}}}},
    {
      "if": {"not": {"properties": {"formula": {"const": "multiclass_log_loss"}}, "required": ["formula"]}},
      "then": {
        "properties": {
          "candidate_score": {"properties": {"score_value": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/scoreValue"}, {"properties": {"kind": {"const": "finite"}}}]}]}}},
          "baseline_scores": {"items": {"properties": {"score_value": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/$defs/scoreValue"}, {"properties": {"kind": {"const": "finite"}}}]}]}}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 27, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "scoreValue": {
      "type": "object", "additionalProperties": false, "minProperties": 2, "maxProperties": 2,
      "required": ["kind", "decimal"],
      "properties": {"kind": {"enum": ["finite", "positive_infinity"]}, "decimal": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 20, "maxLength": 50, "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{18}$"}]}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "finite"}}, "required": ["kind"]}, "then": {"properties": {"decimal": {"type": "string"}}}},
        {"if": {"properties": {"kind": {"const": "positive_infinity"}}, "required": ["kind"]}, "then": {"properties": {"decimal": {"type": "null"}}}}
      ]
    },
    "score": {
      "type": "object", "additionalProperties": false, "minProperties": 3, "maxProperties": 3,
      "required": ["disposition", "not_scored_reason", "score_value"],
      "properties": {
        "disposition": {"enum": ["scored", "not_scored"]},
        "not_scored_reason": {"oneOf": [{"type": "null"}, {"enum": ["forecast_abstained", "baseline_unavailable", "outcome_censored", "outcome_missing"]}]},
        "score_value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scoreValue"}]}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "scored"}}, "required": ["disposition"]}, "then": {"properties": {"not_scored_reason": {"type": "null"}, "score_value": {"$ref": "#/$defs/scoreValue"}}}},
        {"if": {"properties": {"disposition": {"const": "not_scored"}}, "required": ["disposition"]}, "then": {"properties": {"not_scored_reason": {"enum": ["forecast_abstained", "baseline_unavailable", "outcome_censored", "outcome_missing"]}, "score_value": {"type": "null"}}}}
      ]
    },
    "baselineScore": {
      "type": "object", "additionalProperties": false, "minProperties": 6, "maxProperties": 6,
      "required": ["baseline_id", "baseline_version", "config_sha256", "disposition", "not_scored_reason", "score_value"],
      "properties": {
        "baseline_id": {"$ref": "#/$defs/opaque"}, "baseline_version": {"$ref": "#/$defs/opaque"}, "config_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"enum": ["scored", "not_scored"]},
        "not_scored_reason": {"oneOf": [{"type": "null"}, {"enum": ["baseline_unavailable", "outcome_censored", "outcome_missing"]}]},
        "score_value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scoreValue"}]}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "scored"}}, "required": ["disposition"]}, "then": {"properties": {"not_scored_reason": {"type": "null"}, "score_value": {"$ref": "#/$defs/scoreValue"}}}},
        {"if": {"properties": {"disposition": {"const": "not_scored"}}, "required": ["disposition"]}, "then": {"properties": {"not_scored_reason": {"enum": ["baseline_unavailable", "outcome_censored", "outcome_missing"]}, "score_value": {"type": "null"}}}}
      ]
    }
  }
}
