{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/identity_observation_capture_receipt.v1.schema.json",
  "title": "Market Memory private identity observation capture receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "store_id",
    "capture_id",
    "source_observation_id",
    "listing_object",
    "source_artifact",
    "upstream_receipt",
    "prepared_record",
    "observation",
    "captured_at",
    "evidence_policy",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.identity_observation_capture_receipt.v1"},
    "profile": {"const": "market_memory.private.spy_listing_observation.v1"},
    "store_id": {"type": "string", "pattern": "^mmidstore_[a-f0-9]{64}$"},
    "capture_id": {"type": "string", "pattern": "^mmidscan_[a-f0-9]{64}$"},
    "source_observation_id": {"type": "string", "pattern": "^mmidobs_[a-f0-9]{64}$"},
    "listing_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listing_object_id", "sha256", "bytes", "object_key"],
      "properties": {
        "listing_object_id": {"type": "string", "pattern": "^mmidobj_[a-f0-9]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "object_key": {"type": "string", "pattern": "^listing_objects/[a-f0-9]{2}/mmidobj_[a-f0-9]{64}\\.json$"}
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "rows", "object_key"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "rows": {"type": "integer", "minimum": 8000, "maximum": 30000},
        "object_key": {"type": "string", "pattern": "^source_artifacts/[a-f0-9]{2}/[a-f0-9]{64}\\.parquet$"}
      }
    },
    "upstream_receipt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_id", "sha256", "bytes", "object_key"],
          "properties": {
            "receipt_id": {"type": "string", "pattern": "^sdreceipt_[a-f0-9]{64}$"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
            "object_key": {"type": "string", "pattern": "^upstream_receipts/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"}
          }
        }
      ]
    },
    "prepared_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "object_key"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "object_key": {"type": "string", "pattern": "^prepared/[a-f0-9]{2}/mmidobs_[a-f0-9]{64}\\.json$"}
      }
    },
    "observation": {"$ref": "https://mastermind-x.com/contracts/market_memory/spy_listing_observation.v1.schema.json"},
    "captured_at": {"$ref": "#/$defs/utc"},
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact_bytes_bound", "listing_object_content_addressed", "first_market_memory_clock_persisted", "completion_receipt_authenticated", "training_eligible", "promotion_eligible", "role"],
      "properties": {
        "source_artifact_bytes_bound": {"const": true},
        "listing_object_content_addressed": {"const": true},
        "first_market_memory_clock_persisted": {"const": true},
        "completion_receipt_authenticated": {"type": "boolean"},
        "training_eligible": {"const": false},
        "promotion_eligible": {"const": false},
        "role": {"const": "context_only"}
      }
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {
        "required": ["observation"],
        "properties": {
          "observation": {
            "required": ["operational"],
            "properties": {"operational": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "upstream_receipt": {"not": {"type": "null"}},
          "evidence_policy": {
            "properties": {"completion_receipt_authenticated": {"const": true}}
          }
        }
      },
      "else": {
        "properties": {
          "upstream_receipt": {"type": "null"},
          "evidence_policy": {
            "properties": {"completion_receipt_authenticated": {"const": false}}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "authority": {
      "const": {
        "tier": "display",
        "horizon_role": "context",
        "context_only": true,
        "proposal_weight": 0,
        "may_rank": false,
        "may_gate": false,
        "may_size": false,
        "may_escalate": false,
        "may_trade": false,
        "may_originate": false,
        "may_select_options_candidate": false,
        "may_execute": false,
        "may_write_options_episode": false,
        "may_append_outcome": false,
        "may_train_prophet": false
      }
    }
  }
}
