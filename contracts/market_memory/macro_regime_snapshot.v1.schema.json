{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/macro_regime_snapshot.v1.schema.json",
  "title": "Market Memory bounded current macro regime snapshot v1",
  "description": "Strict W1B.1 actual-output projection. Cross-field clock ordering and exact raw/projected byte hashes are revalidated by engine.neuralweb.market_memory_projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "content_sha256",
    "content_bytes",
    "as_of",
    "observed_at",
    "pit_basis",
    "transform_version",
    "source_artifact",
    "state",
    "quality",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.macro_regime_snapshot.v1"},
    "snapshot_id": {
      "type": "string",
      "pattern": "^mmsnap_[a-f0-9]{64}$"
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "content_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "as_of": {"$ref": "#/$defs/timestamp"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "pit_basis": {"const": "live_captured"},
    "transform_version": {
      "const": "market_memory.macro_regime_transform.v1"
    },
    "source_artifact": {"$ref": "#/$defs/sourceArtifact"},
    "state": {"$ref": "#/$defs/state"},
    "quality": {"$ref": "#/$defs/quality"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "quad": {
      "enum": ["Q1", "Q2", "Q3", "Q4"]
    },
    "nullableQuad": {
      "oneOf": [
        {"$ref": "#/$defs/quad"},
        {"type": "null"}
      ]
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_schema_version",
        "source_asof",
        "built_at",
        "raw_sha256",
        "raw_bytes"
      ],
      "properties": {
        "source_id": {"const": "data.regime.latest"},
        "source_schema_version": {"const": 1},
        "source_asof": {"$ref": "#/$defs/date"},
        "built_at": {"$ref": "#/$defs/timestamp"},
        "raw_sha256": {"$ref": "#/$defs/sha256"},
        "raw_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "transitionFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag_breadth_price",
        "flag_credit_equity",
        "flag_ratio_inflection",
        "flag_inflation_basket",
        "flag_confidence_decay",
        "flag_gex",
        "flag_rotation_persistence"
      ],
      "properties": {
        "flag_breadth_price": {"type": "boolean"},
        "flag_credit_equity": {"type": "boolean"},
        "flag_ratio_inflection": {"type": "boolean"},
        "flag_inflation_basket": {"type": "boolean"},
        "flag_confidence_decay": {"type": "boolean"},
        "flag_gex": {"type": "boolean"},
        "flag_rotation_persistence": {"type": "boolean"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quad",
        "raw_quad",
        "pending_quad",
        "pending_days",
        "pending_need",
        "growth_score",
        "inflation_score",
        "growth_confidence",
        "inflation_confidence",
        "confidence",
        "liquidity_overlay",
        "cycle_tag",
        "transition_state",
        "transition_state_raw",
        "transition_ratcheted",
        "transition_dwell_remaining",
        "transition_flags"
      ],
      "properties": {
        "quad": {"$ref": "#/$defs/quad"},
        "raw_quad": {"$ref": "#/$defs/nullableQuad"},
        "pending_quad": {"$ref": "#/$defs/nullableQuad"},
        "pending_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "pending_need": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "growth_score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "inflation_score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "growth_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "inflation_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "liquidity_overlay": {
          "enum": ["expanding", "neutral", "contracting", "unknown"]
        },
        "cycle_tag": {"enum": ["early", "mid", "late", "unknown"]},
        "transition_state": {
          "enum": ["STABLE", "WEAKENING", "TRANSITIONING", "NEW_REGIME"]
        },
        "transition_state_raw": {
          "enum": ["STABLE", "WEAKENING", "TRANSITIONING", "NEW_REGIME"]
        },
        "transition_ratcheted": {"type": "boolean"},
        "transition_dwell_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "transition_flags": {"$ref": "#/$defs/transitionFlags"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actual_output_capture",
        "current_snapshot_only",
        "component_source_receipts_authenticated",
        "feature_projection_eligible",
        "imputed",
        "training_eligible",
        "promotion_eligible"
      ],
      "properties": {
        "status": {"const": "complete"},
        "actual_output_capture": {"const": true},
        "current_snapshot_only": {"const": true},
        "component_source_receipts_authenticated": {"const": false},
        "feature_projection_eligible": {"const": true},
        "imputed": {"const": false},
        "training_eligible": {"const": false},
        "promotion_eligible": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "horizon_role",
        "context_only",
        "proposal_weight",
        "may_rank",
        "may_gate",
        "may_size",
        "may_escalate",
        "may_trade",
        "may_originate",
        "may_select_options_candidate",
        "may_execute",
        "may_write_options_episode",
        "may_append_outcome",
        "may_train_prophet"
      ],
      "properties": {
        "tier": {"const": "display"},
        "horizon_role": {"const": "context"},
        "context_only": {"const": true},
        "proposal_weight": {"const": 0},
        "may_rank": {"const": false},
        "may_gate": {"const": false},
        "may_size": {"const": false},
        "may_escalate": {"const": false},
        "may_trade": {"const": false},
        "may_originate": {"const": false},
        "may_select_options_candidate": {"const": false},
        "may_execute": {"const": false},
        "may_write_options_episode": {"const": false},
        "may_append_outcome": {"const": false},
        "may_train_prophet": {"const": false}
      }
    }
  }
}
