{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/option_oi_probe_receipt.v1.schema.json",
  "title": "Market Memory Massive SPY option-OI first-page probe receipt v1",
  "description": "A sanitized receipt for exactly one bounded, uncompressed, non-redirected GET. It retains no bearer credential and no continuation URL, and proves page completion rather than chain completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "probe_receipt_id",
    "profile",
    "request",
    "transport_policy",
    "response",
    "pagination"
  ],
  "properties": {
    "schema": {"const": "market_memory.option_oi_probe_receipt.v1"},
    "probe_receipt_id": {
      "type": "string",
      "pattern": "^mmoptionoiprobe_[a-f0-9]{64}$"
    },
    "profile": {
      "const": "massive_spy_option_oi_first_page_availability.v1"
    },
    "request": {"$ref": "#/$defs/request"},
    "transport_policy": {"$ref": "#/$defs/transportPolicy"},
    "response": {"$ref": "#/$defs/response"},
    "pagination": {"$ref": "#/$defs/pagination"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "scheme", "host", "path", "query"],
      "properties": {
        "method": {"const": "GET"},
        "scheme": {"const": "https"},
        "host": {"const": "api.massive.com"},
        "path": {"const": "/v3/snapshot/options/SPY"},
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit"],
          "properties": {
            "limit": {"const": "250"}
          }
        }
      }
    },
    "transportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "accept",
        "accept_encoding",
        "trust_env",
        "redirects_allowed",
        "streaming",
        "max_entity_bytes",
        "request_count",
        "continuation_requests"
      ],
      "properties": {
        "authorization": {
          "const": "explicit_bearer_transport_only_not_retained"
        },
        "accept": {"const": "application/json"},
        "accept_encoding": {"const": "identity"},
        "trust_env": {"const": false},
        "redirects_allowed": {"const": false},
        "streaming": {"const": true},
        "max_entity_bytes": {"const": 4194304},
        "request_count": {"const": 1},
        "continuation_requests": {"const": 0}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_code",
        "final_url_matches_request",
        "selected_headers",
        "entity_body",
        "response_body_completed_at"
      ],
      "properties": {
        "status_code": {"const": 200},
        "final_url_matches_request": {"const": true},
        "selected_headers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["content-type"],
          "properties": {
            "content-type": {"const": "application/json"},
            "content-length": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)$"
            }
          }
        },
        "entity_body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "bytes"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            }
          }
        },
        "response_body_completed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_url_present",
        "next_url_projected",
        "page_complete",
        "continuation_followed",
        "intentionally_bounded",
        "chain_complete",
        "contract_universe_complete",
        "atomic_chain_snapshot_verified"
      ],
      "properties": {
        "next_url_present": {"type": "boolean"},
        "next_url_projected": {"const": false},
        "page_complete": {"const": true},
        "continuation_followed": {"const": false},
        "intentionally_bounded": {"const": true},
        "chain_complete": {"const": false},
        "contract_universe_complete": {"const": false},
        "atomic_chain_snapshot_verified": {"const": false}
      }
    }
  }
}
