{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/operating_cortex_registration.v1.schema.json",
  "title": "Market Memory synthetic Operating Cortex registration v1",
  "description": "Strict W5A registration for structural processing of caller-supplied synthetic evidence. It grants no source-authenticity, entailment, attention-quality, forecasting, ranking, aggregation, or trading claim.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 14,
  "maxProperties": 14,
  "required": [
    "schema", "operating_cortex_registration_id", "registration_key", "registered_at",
    "retrieval_registration_id", "retrieval_registration_sha256", "required_evidence_kinds",
    "salience_policy", "citation_policy", "implementation", "input_profile", "claims",
    "emission_enabled", "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.operating_cortex_registration.v1"},
    "operating_cortex_registration_id": {"type": "string", "pattern": "^mmcortexregistration_[a-f0-9]{64}$"},
    "registration_key": {"$ref": "#/$defs/opaque"},
    "registered_at": {"$ref": "#/$defs/timestamp"},
    "retrieval_registration_id": {"type": "string", "pattern": "^mmretrievalregistration_[a-f0-9]{64}$"},
    "retrieval_registration_sha256": {"$ref": "#/$defs/sha256"},
    "required_evidence_kinds": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaque"}
    },
    "salience_policy": {"$ref": "#/$defs/saliencePolicy"},
    "citation_policy": {"$ref": "#/$defs/citationPolicy"},
    "implementation": {"$ref": "#/$defs/implementation"},
    "input_profile": {"const": "synthetic_fixture_only"},
    "claims": {"$ref": "#/$defs/claims"},
    "emission_enabled": {"const": false},
    "authority": {"$ref": "state_snapshot.v1.schema.json#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 27, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "q18": {"type": "string", "minLength": 20, "maxLength": 20, "pattern": "^(?:0\\.[0-9]{18}|1\\.0{18})$"},
    "saliencePolicy": {
      "type": "object", "additionalProperties": false, "minProperties": 5, "maxProperties": 5,
      "required": ["components", "weights", "missing_component", "ordering", "numeric_convention"],
      "properties": {
        "components": {
          "const": ["freshness", "source_quality", "episode_relevance", "contradiction_relevance", "missingness_relevance", "falsifier_relevance"]
        },
        "weights": {
          "type": "object", "additionalProperties": false, "minProperties": 6, "maxProperties": 6,
          "required": ["freshness", "source_quality", "episode_relevance", "contradiction_relevance", "missingness_relevance", "falsifier_relevance"],
          "properties": {
            "freshness": {"const": "0.250000000000000000"},
            "source_quality": {"const": "0.200000000000000000"},
            "episode_relevance": {"const": "0.150000000000000000"},
            "contradiction_relevance": {"const": "0.150000000000000000"},
            "missingness_relevance": {"const": "0.150000000000000000"},
            "falsifier_relevance": {"const": "0.100000000000000000"}
          }
        },
        "missing_component": {"const": "abstain"},
        "ordering": {"const": "score_desc_then_evidence_id_then_abstained_evidence_id"},
        "numeric_convention": {"const": "decimal64_half_even_one_final_q18/v1"}
      }
    },
    "citationPolicy": {
      "type": "object", "additionalProperties": false, "minProperties": 4, "maxProperties": 4,
      "required": ["closure", "entailment", "source_profile", "withholding_precedence"],
      "properties": {
        "closure": {"const": "exact_source_sha256_and_half_open_byte_spans"},
        "entailment": {"const": "not_evaluated"},
        "source_profile": {"const": "caller_supplied_synthetic_exact_bytes"},
        "withholding_precedence": {"const": ["evidence_reference_missing", "required_evidence_kind_missing", "citation_not_closed", "falsifier_reference_missing"]}
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false, "minProperties": 2, "maxProperties": 2,
      "required": ["producer_code_sha256", "producer_config_sha256"],
      "properties": {"producer_code_sha256": {"$ref": "#/$defs/sha256"}, "producer_config_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "claims": {
      "type": "object", "additionalProperties": false, "minProperties": 10, "maxProperties": 10,
      "required": [
        "source_authenticity_established", "citation_entailment_evaluated",
        "evidence_population_complete", "contradiction_population_complete",
        "missingness_population_complete", "falsifier_population_complete",
        "attention_quality_evaluated", "forecast_input_eligible", "aggregate_eligible",
        "skill_claim_eligible"
      ],
      "properties": {
        "source_authenticity_established": {"const": false},
        "citation_entailment_evaluated": {"const": false},
        "evidence_population_complete": {"const": false},
        "contradiction_population_complete": {"const": false},
        "missingness_population_complete": {"const": false},
        "falsifier_population_complete": {"const": false},
        "attention_quality_evaluated": {"const": false},
        "forecast_input_eligible": {"const": false},
        "aggregate_eligible": {"const": false},
        "skill_claim_eligible": {"const": false}
      }
    }
  }
}
