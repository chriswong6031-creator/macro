{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/baseline_forecast_bundle.v1.schema.json",
  "title": "Market Memory synthetic baseline forecast bundle v1",
  "description": "Strict W2B1 synthetic-fixture-only baseline rows bound to one W2A forecast. This record does not authenticate an operational pre-outcome seal, opportunity completeness, aggregate eligibility, or skill.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 20,
  "maxProperties": 20,
  "required": [
    "schema",
    "baseline_forecast_bundle_id",
    "forecast_id",
    "forecast_key",
    "trial_registration_id",
    "state_snapshot_id",
    "context_id",
    "outcome_event_id",
    "target_sha256",
    "outcome_definition_sha256",
    "decision_cutoff",
    "sealed_at",
    "horizon_start",
    "horizon_end",
    "evaluation_at",
    "baseline_rows",
    "input_profile",
    "claims",
    "emission_enabled",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.baseline_forecast_bundle.v1"},
    "baseline_forecast_bundle_id": {"type": "string", "pattern": "^mmbaselinebundle_[a-f0-9]{64}$"},
    "forecast_id": {"type": "string", "pattern": "^mmforecast_[a-f0-9]{64}$"},
    "forecast_key": {"type": "string", "pattern": "^mmforecastkey_[a-f0-9]{64}$"},
    "trial_registration_id": {"type": "string", "pattern": "^mmtrial_[a-f0-9]{64}$"},
    "state_snapshot_id": {"type": "string", "pattern": "^mmstate_[a-f0-9]{64}$"},
    "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
    "outcome_event_id": {"type": "string", "pattern": "^mmoutcomeevent_[a-f0-9]{64}$"},
    "target_sha256": {"$ref": "#/$defs/sha256"},
    "outcome_definition_sha256": {"$ref": "#/$defs/sha256"},
    "decision_cutoff": {"$ref": "#/$defs/timestamp"},
    "sealed_at": {"$ref": "#/$defs/timestamp"},
    "horizon_start": {"$ref": "#/$defs/timestamp"},
    "horizon_end": {"$ref": "#/$defs/timestamp"},
    "evaluation_at": {"$ref": "#/$defs/timestamp"},
    "baseline_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/baselineRow"}
    },
    "input_profile": {"const": "synthetic_fixture_only"},
    "claims": {"$ref": "#/$defs/claims"},
    "emission_enabled": {"const": false},
    "authority": {"$ref": "state_snapshot.v1.schema.json#/$defs/authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 27, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["operational_seal_authenticated", "opportunity_population_complete", "aggregate_eligible", "skill_claim_eligible"],
      "properties": {
        "operational_seal_authenticated": {"const": false},
        "opportunity_population_complete": {"const": false},
        "aggregate_eligible": {"const": false},
        "skill_claim_eligible": {"const": false}
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 3,
      "maxProperties": 3,
      "required": ["kind", "cutoff", "artifact_sha256"],
      "properties": {
        "kind": {"enum": ["fixed_rule", "predecision_fit"]},
        "cutoff": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "artifact_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "fixed_rule"}}, "required": ["kind"]}, "then": {"properties": {"cutoff": {"type": "null"}, "artifact_sha256": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "predecision_fit"}}, "required": ["kind"]}, "then": {"properties": {"cutoff": {"$ref": "#/$defs/timestamp"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}}}
      ]
    },
    "quantile": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "required": ["level", "value"],
      "properties": {"level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "value": {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}}
    },
    "probability": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "required": ["category", "probability"],
      "properties": {"category": {"$ref": "#/$defs/opaque"}, "probability": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "predictiveDistribution": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 4,
      "maxProperties": 4,
      "required": ["kind", "point", "quantiles", "probabilities"],
      "properties": {
        "kind": {"enum": ["scalar", "quantiles", "categorical"]},
        "point": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000}]},
        "quantiles": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/quantile"}},
        "probabilities": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/probability"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "scalar"}}, "required": ["kind"]}, "then": {"properties": {"point": {"type": "number"}, "quantiles": {"maxItems": 0}, "probabilities": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "quantiles"}}, "required": ["kind"]}, "then": {"properties": {"point": {"type": "null"}, "quantiles": {"minItems": 1}, "probabilities": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "categorical"}}, "required": ["kind"]}, "then": {"properties": {"point": {"type": "null"}, "quantiles": {"maxItems": 0}, "probabilities": {"minItems": 2}}}}
      ]
    },
    "baselineRow": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 8,
      "maxProperties": 8,
      "required": ["baseline_id", "baseline_version", "config_sha256", "producer_code_sha256", "fit", "disposition", "unavailable_reason", "predictive_distribution"],
      "properties": {
        "baseline_id": {"$ref": "#/$defs/opaque"},
        "baseline_version": {"$ref": "#/$defs/opaque"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "producer_code_sha256": {"$ref": "#/$defs/sha256"},
        "fit": {"$ref": "#/$defs/fit"},
        "disposition": {"enum": ["issued", "unavailable"]},
        "unavailable_reason": {"oneOf": [{"type": "null"}, {"enum": ["baseline_input_unavailable", "baseline_model_unavailable", "quality_gate_failed", "policy_expired"]}]},
        "predictive_distribution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/predictiveDistribution"}]}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "issued"}}, "required": ["disposition"]}, "then": {"properties": {"unavailable_reason": {"type": "null"}, "predictive_distribution": {"$ref": "#/$defs/predictiveDistribution"}}}},
        {"if": {"properties": {"disposition": {"const": "unavailable"}}, "required": ["disposition"]}, "then": {"properties": {"unavailable_reason": {"enum": ["baseline_input_unavailable", "baseline_model_unavailable", "quality_gate_failed", "policy_expired"]}, "predictive_distribution": {"type": "null"}}}}
      ]
    }
  }
}
