{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/breadth_source_observation.v1.schema.json",
  "title": "Market Memory clock-free current breadth source observation v1",
  "description": "Strict W1B.3A source object. It binds the current Git-owned breadth tip, current constituent roster, canary identity config, and partial-coverage XNYS calendar. The private store owns the first observed/available clock; historical rows are never operationalized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_observation_id",
    "profile",
    "session",
    "sources",
    "temporal_policy",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.breadth_source_observation.v1"},
    "source_observation_id": {
      "type": "string",
      "pattern": "^mmbreadthsrc_[a-f0-9]{64}$"
    },
    "profile": {"const": "sp500_current_membership_breadth.v1"},
    "session": {"$ref": "#/$defs/date"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breadth_actual_output",
        "current_constituents",
        "canary_identity_config",
        "xnys_calendar_module"
      ],
      "properties": {
        "breadth_actual_output": {
          "$ref": "#/$defs/artifact",
          "properties": {
            "repo_path": {"const": "data/breadth/breadth.parquet"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
          }
        },
        "current_constituents": {
          "$ref": "#/$defs/artifact",
          "properties": {
            "repo_path": {"const": "data/breadth/constituents.parquet"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152}
          }
        },
        "canary_identity_config": {
          "$ref": "#/$defs/artifact",
          "properties": {
            "repo_path": {"const": "config/market_memory_canary.v1.json"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 32768}
          }
        },
        "xnys_calendar_module": {
          "$ref": "#/$defs/artifact",
          "properties": {
            "repo_path": {"const": "lib/nyse_calendar.py"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
          }
        }
      }
    },
    "temporal_policy": {"$ref": "#/$defs/temporalPolicy"},
    "limitations": {"$ref": "#/$defs/limitations"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitOid": {
      "type": "string",
      "oneOf": [
        {"pattern": "^[a-f0-9]{40}$"},
        {"pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_path", "sha256", "bytes", "git_blob_oid"],
      "properties": {
        "repo_path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "git_blob_oid": {"$ref": "#/$defs/gitOid"}
      }
    },
    "temporalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_tip_only",
        "historical_rows_operational",
        "availability_clock_owner",
        "projector_samples_clock"
      ],
      "properties": {
        "current_tip_only": {"const": true},
        "historical_rows_operational": {"const": false},
        "availability_clock_owner": {
          "const": "private_breadth_store_first_durable_write"
        },
        "projector_samples_clock": {"const": false}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_membership_only",
        "current_membership_survivor_bias",
        "historical_constituent_point_in_time",
        "calendar_coverage",
        "calendar_partial_coverage",
        "ad_line_excluded"
      ],
      "properties": {
        "current_membership_only": {"const": true},
        "current_membership_survivor_bias": {"const": true},
        "historical_constituent_point_in_time": {"const": false},
        "calendar_coverage": {"const": "full_day_closures_only"},
        "calendar_partial_coverage": {"const": true},
        "ad_line_excluded": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "horizon_role",
        "context_only",
        "proposal_weight",
        "may_rank",
        "may_gate",
        "may_size",
        "may_escalate",
        "may_trade",
        "may_originate",
        "may_select_options_candidate",
        "may_execute",
        "may_write_options_episode",
        "may_append_outcome",
        "may_train_prophet"
      ],
      "properties": {
        "tier": {"const": "display"},
        "horizon_role": {"const": "context"},
        "context_only": {"const": true},
        "proposal_weight": {"const": 0},
        "may_rank": {"const": false},
        "may_gate": {"const": false},
        "may_size": {"const": false},
        "may_escalate": {"const": false},
        "may_trade": {"const": false},
        "may_originate": {"const": false},
        "may_select_options_candidate": {"const": false},
        "may_execute": {"const": false},
        "may_write_options_episode": {"const": false},
        "may_append_outcome": {"const": false},
        "may_train_prophet": {"const": false}
      }
    }
  }
}
