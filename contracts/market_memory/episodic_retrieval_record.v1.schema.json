{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/episodic_retrieval_record.v1.schema.json",
  "title": "Market Memory synthetic supplied-candidate episodic retrieval record v1",
  "description": "Strict W4A audit of every caller-supplied synthetic candidate. Selected candidates are only nearest within the supplied list after exact W2A joins and deterministic temporal exclusions; population completeness, effective n, interval coverage, retrieval quality, and authority remain false.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 17,
  "maxProperties": 17,
  "required": [
    "schema", "episodic_retrieval_record_id", "retrieval_registration_id",
    "trial_registration_id", "trial_plan_sha256", "query", "retrieved_at",
    "retrieval_disposition", "retrieval_reason", "candidates", "selected_forecast_ids",
    "effective_n", "counts", "input_profile", "claims", "emission_enabled", "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.episodic_retrieval_record.v1"},
    "episodic_retrieval_record_id": {"type": "string", "pattern": "^mmepisodicretrieval_[a-f0-9]{64}$"},
    "retrieval_registration_id": {"type": "string", "pattern": "^mmretrievalregistration_[a-f0-9]{64}$"},
    "trial_registration_id": {"type": "string", "pattern": "^mmtrial_[a-f0-9]{64}$"},
    "trial_plan_sha256": {"$ref": "#/$defs/sha256"},
    "query": {"$ref": "#/$defs/query"},
    "retrieved_at": {"$ref": "#/$defs/timestamp"},
    "retrieval_disposition": {"enum": ["completed", "abstained"]},
    "retrieval_reason": {"oneOf": [{"type": "null"}, {"const": "query_coordinate_unavailable"}]},
    "candidates": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/candidate"}},
    "selected_forecast_ids": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^mmforecast_[a-f0-9]{64}$"}
    },
    "effective_n": {"$ref": "#/$defs/effectiveN"},
    "counts": {"$ref": "#/$defs/counts"},
    "input_profile": {"const": "synthetic_fixture_only"},
    "claims": {"$ref": "retrieval_registration.v1.schema.json#/$defs/claims"},
    "emission_enabled": {"const": false},
    "authority": {"$ref": "state_snapshot.v1.schema.json#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"retrieval_disposition": {"const": "completed"}}, "required": ["retrieval_disposition"]},
      "then": {"properties": {"retrieval_reason": {"type": "null"}}}
    },
    {
      "if": {"properties": {"retrieval_disposition": {"const": "abstained"}}, "required": ["retrieval_disposition"]},
      "then": {"properties": {"retrieval_reason": {"const": "query_coordinate_unavailable"}, "selected_forecast_ids": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 27, "maxLength": 27, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
    "opaque": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "forecastId": {"type": "string", "pattern": "^mmforecast_[a-f0-9]{64}$"},
    "nullableQ18": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 20, "maxLength": 38, "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{18}$"}]},
    "subject": {
      "type": "object", "additionalProperties": false, "minProperties": 2, "maxProperties": 2,
      "required": ["subject_id", "instrument_id"],
      "properties": {"subject_id": {"$ref": "#/$defs/opaque"}, "instrument_id": {"$ref": "#/$defs/opaque"}}
    },
    "coordinate": {
      "type": "object", "additionalProperties": false, "minProperties": 2, "maxProperties": 2,
      "required": ["coordinate_id", "value_decimal"],
      "properties": {"coordinate_id": {"$ref": "#/$defs/opaque"}, "value_decimal": {"$ref": "#/$defs/nullableQ18"}}
    },
    "query": {
      "type": "object", "additionalProperties": false, "minProperties": 11, "maxProperties": 11,
      "required": [
        "forecast_id", "forecast_key", "state_snapshot_id", "context_id", "subject",
        "decision_cutoff", "sealed_at", "horizon_start", "horizon_end",
        "forecast_disposition", "coordinates"
      ],
      "properties": {
        "forecast_id": {"$ref": "#/$defs/forecastId"},
        "forecast_key": {"type": "string", "pattern": "^mmforecastkey_[a-f0-9]{64}$"},
        "state_snapshot_id": {"type": "string", "pattern": "^mmstate_[a-f0-9]{64}$"},
        "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
        "subject": {"$ref": "#/$defs/subject"},
        "decision_cutoff": {"$ref": "#/$defs/timestamp"},
        "sealed_at": {"$ref": "#/$defs/timestamp"},
        "horizon_start": {"$ref": "#/$defs/timestamp"},
        "horizon_end": {"$ref": "#/$defs/timestamp"},
        "forecast_disposition": {"enum": ["issued", "abstained"]},
        "coordinates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/coordinate"}}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "minProperties": 17, "maxProperties": 17,
      "required": [
        "forecast_id", "forecast_key", "state_snapshot_id", "context_id", "subject",
        "decision_cutoff", "sealed_at", "horizon_start", "horizon_end",
        "forecast_disposition", "coordinates", "distance_value", "distance_rank",
        "selection_rank", "disposition", "reason", "overlap_with_forecast_ids"
      ],
      "properties": {
        "forecast_id": {"$ref": "#/$defs/forecastId"},
        "forecast_key": {"type": "string", "pattern": "^mmforecastkey_[a-f0-9]{64}$"},
        "state_snapshot_id": {"type": "string", "pattern": "^mmstate_[a-f0-9]{64}$"},
        "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
        "subject": {"$ref": "#/$defs/subject"},
        "decision_cutoff": {"$ref": "#/$defs/timestamp"},
        "sealed_at": {"$ref": "#/$defs/timestamp"},
        "horizon_start": {"$ref": "#/$defs/timestamp"},
        "horizon_end": {"$ref": "#/$defs/timestamp"},
        "forecast_disposition": {"enum": ["issued", "abstained"]},
        "coordinates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/coordinate"}},
        "distance_value": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 20, "maxLength": 37, "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{18}$"}]},
        "distance_rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 128}]},
        "selection_rank": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 32}]},
        "disposition": {"enum": ["ineligible", "not_selected", "selected"]},
        "reason": {"oneOf": [{"type": "null"}, {"enum": ["query_coordinate_unavailable", "self_forecast", "self_context", "subject_or_instrument_mismatch", "not_strictly_earlier", "query_interval_overlap", "candidate_coordinate_unavailable", "selection_interval_overlap", "maximum_results_reached"]}]},
        "overlap_with_forecast_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/forecastId"}}
      }
    },
    "effectiveN": {
      "type": "object", "additionalProperties": false, "minProperties": 3, "maxProperties": 3,
      "required": ["status", "value", "reason"],
      "properties": {"status": {"const": "not_estimated"}, "value": {"type": "null"}, "reason": {"const": "dependence_model_not_evidence_ready"}}
    },
    "counts": {
      "type": "object", "additionalProperties": false, "minProperties": 3, "maxProperties": 3,
      "required": ["supplied_candidates", "distance_eligible_candidates", "selected_nonoverlapping_candidates"],
      "properties": {
        "supplied_candidates": {"type": "integer", "minimum": 0, "maximum": 128},
        "distance_eligible_candidates": {"type": "integer", "minimum": 0, "maximum": 128},
        "selected_nonoverlapping_candidates": {"type": "integer", "minimum": 0, "maximum": 32}
      }
    }
  }
}
