{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/market_memory/event_time_uncertainty.v1.schema.json",
  "title": "Market Memory event-time uncertainty envelope v1",
  "description": "Strict W1B.4A pre-decision date/session uncertainty. Date precision always retains the entire America/New_York civil day. Session sampling never becomes an inferred or selected actual event time.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 16,
  "maxProperties": 16,
  "required": [
    "schema",
    "uncertainty_id",
    "source_event_ref",
    "event_date",
    "event_time_precision",
    "replay_scope",
    "source_timezone",
    "event_time_lower_bound",
    "event_time_upper_bound",
    "bounds_convention",
    "timestamp_inferred",
    "actual_event_time",
    "market_session_window_id",
    "sensitivity_coverage",
    "limitations",
    "authority"
  ],
  "properties": {
    "schema": {"const": "market_memory.event_time_uncertainty.v1"},
    "uncertainty_id": {
      "type": "string",
      "minLength": 78,
      "maxLength": 78,
      "pattern": "^mmuncertainty_[a-f0-9]{64}$"
    },
    "source_event_ref": {"$ref": "#/$defs/sourceEventRef"},
    "event_date": {"$ref": "#/$defs/date"},
    "event_time_precision": {"enum": ["date", "session"]},
    "replay_scope": {"enum": ["civil_date", "market_session"]},
    "source_timezone": {"const": "America/New_York"},
    "event_time_lower_bound": {"$ref": "#/$defs/timestamp"},
    "event_time_upper_bound": {"$ref": "#/$defs/timestamp"},
    "bounds_convention": {"const": "lower_inclusive_upper_exclusive"},
    "timestamp_inferred": {"const": false},
    "actual_event_time": {"type": "null"},
    "market_session_window_id": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/windowId"}
      ]
    },
    "sensitivity_coverage": {
      "enum": [
        "none_civil_date",
        "none_session_window_unresolved",
        "none_non_session",
        "partial_session_sensitivity",
        "session_samples_only"
      ]
    },
    "limitations": {"$ref": "#/$defs/limitations"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_time_precision": {"const": "session"}},
        "required": ["event_time_precision"]
      },
      "then": {
        "properties": {
          "replay_scope": {"const": "market_session"},
          "market_session_window_id": {"$ref": "#/$defs/windowId"},
          "sensitivity_coverage": {"const": "session_samples_only"}
        }
      }
    },
    {
      "if": {
        "properties": {"replay_scope": {"const": "civil_date"}},
        "required": ["replay_scope"]
      },
      "then": {
        "properties": {
          "event_time_precision": {"const": "date"},
          "market_session_window_id": {"type": "null"},
          "sensitivity_coverage": {"const": "none_civil_date"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_time_precision": {"const": "date"},
          "replay_scope": {"const": "market_session"}
        },
        "required": ["event_time_precision", "replay_scope"]
      },
      "then": {
        "properties": {
          "sensitivity_coverage": {
            "enum": [
              "none_session_window_unresolved",
              "none_non_session",
              "partial_session_sensitivity"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sensitivity_coverage": {"const": "none_session_window_unresolved"}
        },
        "required": ["sensitivity_coverage"]
      },
      "then": {
        "properties": {"market_session_window_id": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {
          "sensitivity_coverage": {
            "enum": ["none_non_session", "partial_session_sensitivity"]
          }
        },
        "required": ["sensitivity_coverage"]
      },
      "then": {
        "properties": {
          "market_session_window_id": {"$ref": "#/$defs/windowId"}
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 27,
      "maxLength": 27,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "windowId": {
      "type": "string",
      "minLength": 80,
      "maxLength": 80,
      "pattern": "^mmsessionwindow_[a-f0-9]{64}$"
    },
    "opaqueRef128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "opaqueRef160": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$"
    },
    "opaqueRef256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "opaqueRef64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"
    },
    "sourceEventRef": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 10,
      "maxProperties": 10,
      "required": [
        "owner",
        "source_schema",
        "event_id",
        "event_date_field",
        "predecision_event_sha256",
        "source_contract_sha256",
        "reference_basis",
        "predecision_event_bytes_verified",
        "source_contract_semantics_authenticated",
        "replay_scope_authenticated_by_source"
      ],
      "properties": {
        "owner": {"$ref": "#/$defs/opaqueRef128"},
        "source_schema": {"$ref": "#/$defs/opaqueRef160"},
        "event_id": {"$ref": "#/$defs/opaqueRef256"},
        "event_date_field": {"$ref": "#/$defs/opaqueRef64"},
        "predecision_event_sha256": {"$ref": "#/$defs/sha256"},
        "source_contract_sha256": {"$ref": "#/$defs/sha256"},
        "reference_basis": {
          "const": "caller_attested_predecision_projection"
        },
        "predecision_event_bytes_verified": {"const": false},
        "source_contract_semantics_authenticated": {"const": false},
        "replay_scope_authenticated_by_source": {"const": false}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "actual_time_known",
        "scenario_times_are_observed_event_time",
        "actual_scenario_selected",
        "point_claim_permitted",
        "consumer_conclusion_evaluated"
      ],
      "properties": {
        "actual_time_known": {"const": false},
        "scenario_times_are_observed_event_time": {"const": false},
        "actual_scenario_selected": {"const": false},
        "point_claim_permitted": {"const": false},
        "consumer_conclusion_evaluated": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 15,
      "maxProperties": 15,
      "required": [
        "tier",
        "horizon_role",
        "context_only",
        "proposal_weight",
        "may_rank",
        "may_gate",
        "may_size",
        "may_escalate",
        "may_trade",
        "may_originate",
        "may_select_options_candidate",
        "may_execute",
        "may_write_options_episode",
        "may_append_outcome",
        "may_train_prophet"
      ],
      "properties": {
        "tier": {"const": "display"},
        "horizon_role": {"const": "context"},
        "context_only": {"const": true},
        "proposal_weight": {"const": 0},
        "may_rank": {"const": false},
        "may_gate": {"const": false},
        "may_size": {"const": false},
        "may_escalate": {"const": false},
        "may_trade": {"const": false},
        "may_originate": {"const": false},
        "may_select_options_candidate": {"const": false},
        "may_execute": {"const": false},
        "may_write_options_episode": {"const": false},
        "may_append_outcome": {"const": false},
        "may_train_prophet": {"const": false}
      }
    }
  }
}
