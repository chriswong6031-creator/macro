{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/sector_intelligence/authority_manifest.v1.schema.json",
  "title": "Sector Intelligence Authority Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "manifest_id", "sector", "artifact_ref", "artifact_type", "publication_tier", "max_authority", "allowed_actions", "denied_actions", "consumers", "issued_by", "issued_at", "valid_from", "valid_to", "expires_at", "promotion_evidence_refs", "governance_decision_refs", "kill_switch", "transaction_from", "transaction_to"],
  "properties": {
    "contract_id": {"const": "authority_manifest.v1"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "sector": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "artifact_ref": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "publication_tier": {"type": "string", "enum": ["DISPLAY", "SHADOW", "CONFIRMER", "SCORED"]},
    "max_authority": {"type": "string", "enum": ["A0_OBSERVE", "A1_EXPLAIN", "A2_ATTEND", "A3_DE_ESCALATE", "A4_QUARANTINE", "A5_GOVERN_TIERS", "A6_TUNE"]},
    "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["observe", "explain", "attend", "de_escalate", "quarantine", "govern_tiers", "tune"]}},
    "denied_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["originate_signal", "raise_authority_from_llm", "rank_security", "select_security", "size_position", "gate_decision", "execute_trade"]}},
    "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "promotion_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "governance_decision_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "owner", "reason", "activated_at"],
      "properties": {
        "enabled": {"type": "boolean"},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "activated_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "transaction_from": {"type": "string", "format": "date-time"},
    "transaction_to": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"publication_tier": {"enum": ["CONFIRMER", "SCORED"]}}, "required": ["publication_tier"]},
      "then": {
        "properties": {
          "promotion_evidence_refs": {"minItems": 1},
          "governance_decision_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"max_authority": {"enum": ["A2_ATTEND", "A3_DE_ESCALATE", "A4_QUARANTINE", "A5_GOVERN_TIERS", "A6_TUNE"]}}, "required": ["max_authority"]},
      "then": {"properties": {"governance_decision_refs": {"minItems": 1}}}
    }
  ]
}
