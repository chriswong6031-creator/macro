{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/sector_intelligence/feature_snapshot.v1.schema.json",
  "title": "Sector Intelligence Feature Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "snapshot_id", "sector", "entity_ref", "feature_set_id", "feature_set_version", "as_of", "knowledge_cutoff", "computed_at", "point_in_time_safe", "values", "input_record_refs", "input_claim_refs", "input_hashes", "missingness_summary", "staleness", "producer", "authority_manifest_ref"],
  "properties": {
    "contract_id": {"const": "feature_snapshot.v1"},
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "sector": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "entity_ref": {"type": "string", "minLength": 1},
    "feature_set_id": {"type": "string", "minLength": 1},
    "feature_set_version": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "knowledge_cutoff": {"type": "string", "format": "date-time"},
    "computed_at": {"type": "string", "format": "date-time"},
    "point_in_time_safe": {"type": "boolean"},
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "definition_version", "value", "unit", "missingness", "observed_at", "stale", "source_claim_refs"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "definition_version": {"type": "string", "minLength": 1},
          "value": {"type": ["string", "number", "boolean", "null"]},
          "unit": {"type": ["string", "null"]},
          "missingness": {"type": "string", "enum": ["observed", "not_applicable", "not_available", "stale", "withheld", "license_restricted"]},
          "observed_at": {"type": ["string", "null"], "format": "date-time"},
          "stale": {"type": "boolean"},
          "source_claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "input_record_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "missingness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "missing", "stale"],
      "properties": {
        "present": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "stale": {"type": "integer", "minimum": 0}
      }
    },
    "staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "oldest_input_at", "max_age_seconds", "evaluated_at"],
      "properties": {
        "state": {"type": "string", "enum": ["fresh", "stale", "unknown"]},
        "oldest_input_at": {"type": ["string", "null"], "format": "date-time"},
        "max_age_seconds": {"type": ["integer", "null"], "minimum": 0},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "code_version", "run_id"],
      "properties": {
        "service": {"type": "string", "minLength": 1},
        "code_version": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "authority_manifest_ref": {"type": ["string", "null"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
