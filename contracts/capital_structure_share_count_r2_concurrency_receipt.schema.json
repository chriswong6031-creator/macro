    "scope": {"oneOf": [{"$ref": "#/$defs/admittedScope"}, {"$ref": "#/$defs/unadmittedScope"}]},
    "admittedScope": {"type": "object", "additionalProperties": false, "required": ["admitted", "endpoint_host", "bucket_sha256"], "properties": {"admitted": {"const": true}, "endpoint_host": {"type": "string", "pattern": "^[a-f0-9]{32}(\\.(eu|fedramp))?\\.r2\\.cloudflarestorage\\.com$"}, "bucket_sha256": {"$ref": "#/$defs/sha"}}},
    "unadmittedScope": {"type": "object", "additionalProperties": false, "required": ["admitted", "endpoint_host", "bucket_sha256"], "properties": {"admitted": {"const": false}, "endpoint_host": {"type": "null"}, "bucket_sha256": {"type": "null"}}},
    "github": {"type": "object", "additionalProperties": false, "required": ["repository", "workflow_ref", "run_id", "run_attempt", "commit_sha", "event_name", "actor"], "properties": {"repository": {"const": "mastermindx-market-intelligence/macro"}, "workflow_ref": {"const": "mastermindx-market-intelligence/macro/.github/workflows/capital-share-count-r2-concurrency.yml@refs/heads/main"}, "run_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}, "run_attempt": {"type": "integer", "minimum": 1, "maximum": 1000}, "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "event_name": {"const": "workflow_dispatch"}, "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["source_archive_sha256", "dependency_lock_sha256", "dependency_lock_name"], "properties": {"source_archive_sha256": {"$ref": "#/$defs/sha"}, "dependency_lock_sha256": {"$ref": "#/$defs/sha"}, "dependency_lock_name": {"const": "capital-share-r2-conformance-macos-arm64-py312.lock"}}},
    "topology": {"type": "object", "additionalProperties": false, "required": ["persistent_children", "independent_processes", "independent_sessions", "independent_clients", "retry_mode", "total_max_attempts", "needs_retry_hook_installed"], "properties": {"persistent_children": {"const": true}, "independent_processes": {"const": true}, "independent_sessions": {"const": true}, "independent_clients": {"const": true}, "retry_mode": {"const": "standard"}, "total_max_attempts": {"const": 1}, "needs_retry_hook_installed": {"const": true}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["issued_puts", "before_send_count", "needs_retry_attempts", "response_retry_attempts", "outcome", "http_status", "error_code", "error_status", "exact_client_error", "transport_start_offset_ns", "completed_offset_ns", "request_id_sha256"], "properties": {"issued_puts": {"const": 1}, "before_send_count": {"const": 1}, "needs_retry_attempts": {"const": [1]}, "response_retry_attempts": {"const": 0}, "outcome": {"enum": ["success", "conflict"]}, "http_status": {"oneOf": [{"const": 200}, {"type": "null"}]}, "error_code": {"oneOf": [{"const": "PreconditionFailed"}, {"type": "null"}]}, "error_status": {"oneOf": [{"const": 412}, {"type": "null"}]}, "exact_client_error": {"type": "boolean"}, "transport_start_offset_ns": {"type": "integer", "minimum": 0, "maximum": 240000000000}, "completed_offset_ns": {"type": "integer", "minimum": 0, "maximum": 240000000000}, "request_id_sha256": {"$ref": "#/$defs/nullableSha"}}, "allOf": [{"if": {"properties": {"outcome": {"const": "success"}}}, "then": {"properties": {"http_status": {"const": 200}, "error_code": {"type": "null"}, "error_status": {"type": "null"}, "exact_client_error": {"const": false}}}, "else": {"properties": {"http_status": {"type": "null"}, "error_code": {"const": "PreconditionFailed"}, "error_status": {"const": 412}, "exact_client_error": {"const": true}}}}]},
    "attempts": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/attempt"}, "right": {"$ref": "#/$defs/attempt"}}},
