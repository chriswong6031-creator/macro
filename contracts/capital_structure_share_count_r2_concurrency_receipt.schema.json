  "allOf": [
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {
        "properties": {
          "failure": {"type": "null"},
          "plan_commitment_sha256": {"$ref": "#/$defs/sha"},
          "scope": {"$ref": "#/$defs/admittedScope"},
          "worker_topology": {"$ref": "#/$defs/topology"},
          "rounds": {"$ref": "#/$defs/passedRounds"}
        }
      },
      "else": {
        "properties": {
          "status": {"enum": ["failed", "inconclusive"]},
          "failure": {"$ref": "#/$defs/failure"},
          "worker_topology": {"type": "null"},
          "rounds": {"$ref": "#/$defs/incompleteRounds"}
        }
      }
    }
  ],
  "$defs": {
