    "successor": {"type": "object", "additionalProperties": false, "required": ["commitment_sha256", "transport_interval_overlap", "success_count", "typed_412_precondition_failed_count", "winner_candidate_sha256", "loser_candidate_sha256", "e0_etag_sha256", "winner_etag_sha256", "verified_body_sha256", "etag_changed_from_e0", "worker_attempts"], "properties": {"commitment_sha256": {"$ref": "#/$defs/sha"}, "transport_interval_overlap": {"const": true}, "success_count": {"const": 1}, "typed_412_precondition_failed_count": {"const": 1}, "winner_candidate_sha256": {"$ref": "#/$defs/sha"}, "loser_candidate_sha256": {"$ref": "#/$defs/sha"}, "e0_etag_sha256": {"$ref": "#/$defs/sha"}, "winner_etag_sha256": {"$ref": "#/$defs/sha"}, "verified_body_sha256": {"$ref": "#/$defs/sha"}, "etag_changed_from_e0": {"const": true}, "worker_attempts": {"$ref": "#/$defs/attempts"}}},
    "stale": {"type": "object", "additionalProperties": false, "required": ["http_status", "error_code", "final_etag_sha256", "final_body_sha256", "final_unchanged", "issued_puts", "before_send_count", "needs_retry_attempts", "response_retry_attempts", "request_id_sha256"], "properties": {"http_status": {"const": 412}, "error_code": {"const": "PreconditionFailed"}, "final_etag_sha256": {"$ref": "#/$defs/sha"}, "final_body_sha256": {"$ref": "#/$defs/sha"}, "final_unchanged": {"const": true}, "issued_puts": {"const": 1}, "before_send_count": {"const": 1}, "needs_retry_attempts": {"const": [1]}, "response_retry_attempts": {"const": 0}, "request_id_sha256": {"$ref": "#/$defs/nullableSha"}}},
    "round": {"type": "object", "additionalProperties": false, "required": ["round", "key_sha256", "genesis", "successor", "stale"], "properties": {"round": {"type": "integer", "minimum": 1, "maximum": 8}, "key_sha256": {"$ref": "#/$defs/sha"}, "genesis": {"$ref": "#/$defs/genesis"}, "successor": {"$ref": "#/$defs/successor"}, "stale": {"$ref": "#/$defs/stale"}}},
    "passedRounds": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/round"}},
    "incompleteRounds": {"type": "object", "additionalProperties": false, "required": ["completed_rounds"], "properties": {"completed_rounds": {"type": "array", "maxItems": 8, "items": {"type": "integer", "minimum": 1, "maximum": 8}}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["stage", "category"], "properties": {"stage": {"enum": ["setup", "absence_preflight", "genesis_race", "genesis_verify", "successor_race", "successor_verify", "stale_put", "stale_verify", "probe", "receipt"]}, "category": {"enum": ["configuration", "transport_or_deadline", "malformed_response", "readback_mismatch", "close_failure", "missing_or_duplicate_attempt_evidence", "sequential_transport_spans", "both_writers_succeeded", "lost_or_ambiguous_response", "wrong_conflict_response", "etag_not_new", "stale_write_succeeded", "post_hoc_rewrite", "worker_result_shape"]}}},
