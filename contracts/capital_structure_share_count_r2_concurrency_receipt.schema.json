    "nonclaims": {"type": "object", "additionalProperties": false, "required": ["not_a_share_count_source", "not_a_publication_authority", "not_a_provider_security_or_linearizability_audit", "not_a_server_simultaneity_proof", "not_a_provider_wide_or_future_behavior_proof", "not_a_failure_domain_or_fault_injection_proof", "not_a_multi_key_atomicity_proof", "not_a_production_configuration_or_activation_proof", "not_a_provider_durability_or_availability_proof", "not_a_credential_authentication_proof", "not_a_retention_or_deletion_proof", "not_a_production_retry_semantics_proof", "not_a_trading_or_investment_signal"], "properties": {"not_a_share_count_source": {"const": true}, "not_a_publication_authority": {"const": true}, "not_a_provider_security_or_linearizability_audit": {"const": true}, "not_a_server_simultaneity_proof": {"const": true}, "not_a_provider_wide_or_future_behavior_proof": {"const": true}, "not_a_failure_domain_or_fault_injection_proof": {"const": true}, "not_a_multi_key_atomicity_proof": {"const": true}, "not_a_production_configuration_or_activation_proof": {"const": true}, "not_a_provider_durability_or_availability_proof": {"const": true}, "not_a_credential_authentication_proof": {"const": true}, "not_a_retention_or_deletion_proof": {"const": true}, "not_a_production_retry_semantics_proof": {"const": true}, "not_a_trading_or_investment_signal": {"const": true}}}
  }
