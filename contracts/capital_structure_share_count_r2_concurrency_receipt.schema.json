  "title": "Manual R2 concurrent-writer witness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "status", "failure", "manual_only", "created_at", "deadline_seconds", "round_count", "plan_commitment_sha256", "scope", "github_provenance", "execution_provenance", "worker_topology", "rounds", "output_authority", "nonclaims"],
  "properties": {
    "schema": {"const": "capital_structure.share_count_r2_concurrency_receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^r2-concurrency-witness:cs-share-count-v1:[a-f0-9]{64}$"},
    "status": {"enum": ["passed", "failed", "inconclusive"]},
