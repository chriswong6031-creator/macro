{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermindx.ai/contracts/intelligence_workspace/workspace_layout.v1.schema.json",
  "title": "DeepVue W2-A versioned workspace layout v1",
  "description": "Canonical envelope for a named intelligence workspace (widgets + static link-group graph). See research/DEEPVUE_W2A_WORKSPACE_LAYOUT_CONTRACT_2026-08-26.md (as amended by Amendment A1, Amendment A2, and Amendment A3). Structural shape only — cross-field laws (stored-vs-wire name law, duplicate widget ids, undeclared port references, size/count limits, honest provenance, error precedence) are enforced by engine/intelligence_workspace/workspace_layout.py:validate_envelope, not by this schema alone. `requires` is OPTIONAL (Amendment A2 ruling 11: absent defaults to floor 1); `name` structurally allows a non-null string here because this schema also describes the wire/export shape — validate_envelope's stored mode is what actually requires `null`. Amendment A3 ruling 2 (number law): integer fields are bounded to the IEEE-754 safe range (|n| <= 9007199254740991); `bounded_primitive`'s numeric minimum/maximum mirror that same outer envelope structurally — the NARROWER rule that a non-integral float must additionally satisfy 1e-4 <= |x| < 1e12 is a business rule this schema cannot express type-discriminately and is enforced authoritatively by validate_envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "name", "link_groups", "widgets", "migration"],
  "properties": {
    "schema": {"const": "workspace_layout.v1"},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "floor": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "name": {"type": ["string", "null"], "minLength": 1, "maxLength": 60},
    "link_groups": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/link_group"},
      "propertyNames": {"$ref": "#/$defs/link_group_name"},
      "maxProperties": 8
    },
    "widgets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/widget"}
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_revision"],
      "properties": {
        "source": {"enum": ["legacy_v0", "chart_layout_v1", "chart_layout_v2", "none", "import"]},
        "source_revision": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991}
      }
    }
  },
  "$defs": {
    "not_denied_key": {"not": {"enum": ["__proto__", "constructor", "prototype"]}},
    "link_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type"],
      "properties": {
        "entity_type": {"enum": ["security", "industry", "theme", "portfolio", "event"]}
      }
    },
    "link_group_name": {
      "allOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
        {"$ref": "#/$defs/not_denied_key"}
      ]
    },
    "widget_id": {
      "allOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        {"$ref": "#/$defs/not_denied_key"}
      ]
    },
    "grid_axis": {"type": "integer", "minimum": 0, "maximum": 64},
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "semantic_lane", "context_in", "context_out", "config"],
      "properties": {
        "id": {"$ref": "#/$defs/widget_id"},
        "type": {"enum": ["chart", "brain"]},
        "semantic_lane": {"enum": ["primary", "secondary", "rail", "dock"]},
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": {"$ref": "#/$defs/grid_axis"},
            "y": {"$ref": "#/$defs/grid_axis"},
            "w": {"$ref": "#/$defs/grid_axis"},
            "h": {"$ref": "#/$defs/grid_axis"}
          }
        },
        "context_in": {
          "type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/link_group_name"}
        },
        "context_out": {
          "type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/link_group_name"}
        },
        "config": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "chart"}}},
          "then": {"properties": {"config": {"$ref": "#/$defs/chart_config"}}}
        },
        {
          "if": {"properties": {"type": {"const": "brain"}}},
          "then": {"properties": {"config": {"$ref": "#/$defs/brain_config"}}}
        }
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[\\^A-Z0-9.+:_-]{1,24}$",
      "description": "Amendment A2 ruling 1: covers composite panes (NVDA+AMD), caret index panes (^NDX), and colon venue-qualified tickers (BINANCE:BTCUSDT)."
    },
    "timeframe": {"type": "string", "pattern": "^[A-Za-z0-9]{1,8}$"},
    "chart_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "description": "Amendment A2 ruling 1: covers hyphenated chart types (line-markers)."
    },
    "indicator_id": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$",
          "description": "Amendment A2 ruling 1: covers underscore-prefixed ids (_lab)."
        },
        {"$ref": "#/$defs/not_denied_key"}
      ]
    },
    "param_key": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.]{0,63}$",
          "description": "Amendment A2 ruling 1: covers dotted premium-suite keys (ob.showLast)."
        },
        {"$ref": "#/$defs/not_denied_key"}
      ]
    },
    "bounded_primitive": {
      "type": ["string", "number", "boolean", "null"],
      "maxLength": 64,
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Amendment A3 ruling 2: the numeric envelope structurally mirrors the IEEE-754 safe-integer range; the narrower non-integral-float window (1e-4 <= |x| < 1e12) is enforced by validate_envelope, not expressible type-discriminately here."
    },
    "param_value_d0": {"$ref": "#/$defs/bounded_primitive"},
    "param_value_d1": {
      "anyOf": [
        {"$ref": "#/$defs/bounded_primitive"},
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/param_key"},
          "additionalProperties": {"$ref": "#/$defs/param_value_d0"}
        }
      ]
    },
    "param_value_d2": {
      "anyOf": [
        {"$ref": "#/$defs/bounded_primitive"},
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/param_key"},
          "additionalProperties": {"$ref": "#/$defs/param_value_d1"}
        }
      ]
    },
    "param_value_d3": {
      "anyOf": [
        {"$ref": "#/$defs/bounded_primitive"},
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/param_key"},
          "additionalProperties": {"$ref": "#/$defs/param_value_d2"}
        }
      ],
      "description": "Amendment A2 ruling 1: a per-indicator/per-symbol param's value may nest up to 3 levels deep below the per-indicator object (covers the real `_vis` visibility-range shape)."
    },
    "indicator_params": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/indicator_id"},
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {"$ref": "#/$defs/param_key"},
        "additionalProperties": {"$ref": "#/$defs/param_value_d3"}
      }
    },
    "compare_config": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "#/$defs/symbol"},
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {"$ref": "#/$defs/param_key"},
        "additionalProperties": {"$ref": "#/$defs/param_value_d3"}
      }
    },
    "brain_config": {
      "type": "object",
      "additionalProperties": false
    },
    "chart_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panes": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/symbol"}},
        "paneTfs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/timeframe"}},
        "split": {"type": "integer", "enum": [1, 2, 4]},
        "activePane": {"type": "integer", "minimum": 0, "maximum": 3},
        "sync": {"type": "boolean"},
        "chartType": {"$ref": "#/$defs/chart_type"},
        "inds": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/indicator_id"}},
        "indParams": {"$ref": "#/$defs/indicator_params"},
        "hidden": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/indicator_id"}},
        "compare": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/symbol"}},
        "compareCfg": {"$ref": "#/$defs/compare_config"},
        "lockedVLine": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      }
    }
  }
}
