{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_share_count_retention_receipt.schema.json",
  "title": "Non-authoritative share-count v2 retention receipt",
  "description": "A canonical signed audit record for a bounded pre-production generation-ledger retention run. It is never a mutable selector and grants no analytical or trading authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "created_at", "mode", "head_token_sha256", "selected_receipt_id", "protected_generation_keys", "candidate_generation_keys", "grace_generation_keys", "deleted_generation_keys", "quarantine_seconds", "output_authority", "auth"],
  "properties": {
    "schema": {"const": "capital_structure.share_count_retention_receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^retention:cs-share-count-v2:[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["dry_run", "apply"]},
    "head_token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_receipt_id": {"type": "string", "pattern": "^receipt:cs-share-count-materialization-v2:[a-f0-9]{64}$"},
    "protected_generation_keys": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/generation_key"}},
    "candidate_generation_keys": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/generation_key"}},
    "grace_generation_keys": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/generation_key"}},
    "deleted_generation_keys": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/generation_key"}},
    "quarantine_seconds": {"type": "integer", "minimum": 172800},
    "output_authority": {"$ref": "#/$defs/authority"},
    "auth": {"$ref": "#/$defs/auth"}
  },
  "$defs": {
    "generation_key": {"type": "string", "pattern": "^capital_structure/share_counts/v2/generations/[a-f0-9]{64}/ledger\\.json$"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["is_context_only", "share_count_ledger_authority", "instrument_authority", "capacity_authority", "runway_authority", "risk_authority", "rank_authority", "sizing_authority", "entry_authority", "trade_authority", "prophet_authority"],
      "properties": {
        "is_context_only": {"const": true},
        "share_count_ledger_authority": {"const": false}, "instrument_authority": {"const": false}, "capacity_authority": {"const": false}, "runway_authority": {"const": false}, "risk_authority": {"const": false}, "rank_authority": {"const": false}, "sizing_authority": {"const": false}, "entry_authority": {"const": false}, "trade_authority": {"const": false}, "prophet_authority": {"const": false}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "key_id", "signature"],
      "properties": {
        "scheme": {"const": "hmac-sha256/v1"}, "key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
