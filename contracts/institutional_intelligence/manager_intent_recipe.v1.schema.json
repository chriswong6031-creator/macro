{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K2-B manager-complex and research-intent recipe v1",
  "version": "1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recipe_id", "authority", "evidence_refs", "manager_complex_epochs", "filer_epochs", "vehicle_epochs", "observations", "theme_comparisons", "campaign_transitions", "reliability"],
  "properties": {
    "schema": {"const": "institutional_intelligence.manager_intent_recipe.v1"},
    "recipe_id": {"type": "string", "pattern": "^mri_[a-f0-9]{64}$"},
    "authority": {"$ref": "#/$defs/authority"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "manager_complex_epochs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/managerComplexEpoch"}},
    "filer_epochs": {"type": "array", "items": {"$ref": "#/$defs/filerEpoch"}},
    "vehicle_epochs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vehicleEpoch"}},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "theme_comparisons": {"type": "array", "items": {"$ref": "#/$defs/themeComparison"}},
    "campaign_transitions": {"type": "array", "items": {"$ref": "#/$defs/campaignTransition"}},
    "reliability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reliability"}}
  },
  "$defs": {
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry"],
      "properties": {"can_rank": {"const": false}, "can_gate": {"const": false}, "can_size": {"const": false}, "can_originate": {"const": false}, "can_open_entry": {"const": false}}
    },
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_from", "effective_to", "valid_from", "valid_to", "knowable_from", "knowable_to"],
      "properties": {
        "effective_from": {"type": "string", "format": "date-time"}, "effective_to": {"type": ["string", "null"], "format": "date-time"},
        "valid_from": {"type": "string", "format": "date-time"}, "valid_to": {"type": ["string", "null"], "format": "date-time"},
        "knowable_from": {"type": "string", "format": "date-time"}, "knowable_to": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "epochLineage": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "predecessor_epoch_id", "reason", "append_only"],
      "properties": {"state": {"enum": ["original", "remapped", "corrected", "unresolved"]}, "predecessor_epoch_id": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"], "maxLength": 512}, "append_only": {"const": true}}
    },
    "actorIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "ontology_source", "raw_actor_string", "original_ontology_version", "resolution_state", "remap_lineage"],
      "properties": {
        "role": {"enum": ["institution_or_manager_complex", "fund_company", "fund_vehicle", "manager_or_person", "broker_or_research_house", "analyst", "named_market_actor_or_broker_seat", "holder_controller_or_executive"]},
        "ontology_source": {"enum": ["B0_MANAGER_COMPLEX_DRAFT", "CHINA_ALPHA_INTELLIGENCE_MASTERPLAN"]},
        "raw_actor_string": {"type": "string", "minLength": 1, "maxLength": 512},
        "original_ontology_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "resolution_state": {"enum": ["resolved", "unresolved"]},
        "remap_lineage": {"$ref": "#/$defs/epochLineage"}
      }
    },
    "managerComplexEpoch": {
      "type": "object", "additionalProperties": false,
      "required": ["manager_complex_id", "complex_epoch_id", "interval", "status", "resolution_state", "decision_mode", "actor_identity", "lineage"],
      "properties": {
        "manager_complex_id": {"type": "string", "pattern": "^mcx_[a-z0-9_]+$"}, "complex_epoch_id": {"type": "string", "pattern": "^mce_[a-z0-9_]+$"},
        "interval": {"$ref": "#/$defs/interval"}, "status": {"enum": ["active", "inactive", "unresolved"]}, "resolution_state": {"enum": ["resolved", "unresolved"]},
        "decision_mode": {"enum": ["discretionary", "passive", "systematic", "mixed", "unknown"]}, "actor_identity": {"$ref": "#/$defs/actorIdentity"}, "lineage": {"$ref": "#/$defs/epochLineage"}
      }
    },
    "filerEpoch": {
      "type": "object", "additionalProperties": false,
      "required": ["filer_id", "filer_epoch_id", "manager_complex_id", "complex_epoch_id", "interval", "status", "resolution_state", "lineage"],
      "properties": {
        "filer_id": {"type": "string", "pattern": "^[0-9]{10}$"}, "filer_epoch_id": {"type": "string", "pattern": "^fie_[a-z0-9_]+$"}, "manager_complex_id": {"type": "string"}, "complex_epoch_id": {"type": "string"},
        "interval": {"$ref": "#/$defs/interval"}, "status": {"enum": ["active", "inactive", "unresolved"]}, "resolution_state": {"enum": ["resolved", "unresolved"]}, "lineage": {"$ref": "#/$defs/epochLineage"}
      }
    },
    "vehicleEpoch": {
      "type": "object", "additionalProperties": false,
      "required": ["vehicle_id", "vehicle_epoch_id", "manager_complex_id", "complex_epoch_id", "interval", "status", "resolution_state", "decision_mode", "vehicle_class", "lineage"],
      "properties": {
        "vehicle_id": {"type": "string", "pattern": "^veh_[a-z0-9_]+$"}, "vehicle_epoch_id": {"type": "string", "pattern": "^vie_[a-z0-9_]+$"}, "manager_complex_id": {"type": "string"}, "complex_epoch_id": {"type": "string"},
        "interval": {"$ref": "#/$defs/interval"}, "status": {"enum": ["active", "inactive", "unresolved"]}, "resolution_state": {"enum": ["resolved", "unresolved"]}, "decision_mode": {"enum": ["discretionary", "passive", "systematic", "mixed", "unknown"]},
        "vehicle_class": {"enum": ["concentrated_discretionary_active", "diversified_discretionary_active", "sector_specialist_active", "systematic_active", "thematic_passive", "broad_passive", "options_income_overlay", "leveraged_inverse", "synthetic_fund_of_funds"]},
        "lineage": {"$ref": "#/$defs/epochLineage"}
      }
    },
    "clockBinding": {"type": "object", "additionalProperties": false, "required": ["field", "value"], "properties": {"field": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "referenceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "owner_store", "native_identity", "valid_clock", "available_clock"],
      "properties": {"reference_id": {"type": "string", "pattern": "^efr_[a-f0-9]{64}$"}, "owner_store": {"type": "string", "minLength": 1}, "native_identity": {"type": "object", "minProperties": 1}, "valid_clock": {"$ref": "#/$defs/clockBinding"}, "available_clock": {"$ref": "#/$defs/clockBinding"}}
    },
    "missingReason": {"enum": ["explicit_none", "not_applicable", "not_available_for_date", "source_missing", "rights_blocked", "unresolved_identity", "stale", "unsupported", "reconstructed_not_operational_pit", "quarantined", "unknown"]},
    "reportedShareChange": {"type": "object", "additionalProperties": false, "required": ["kind", "q_prev", "q_now"], "properties": {"kind": {"const": "reported_share_change"}, "q_prev": {"type": ["number", "null"], "minimum": 0}, "q_now": {"type": ["number", "null"], "minimum": 0}}},
    "etfTrueShareResidual": {"type": "object", "additionalProperties": false, "required": ["kind", "q_prev", "q_now", "s_prev", "s_now"], "properties": {"kind": {"const": "etf_true_share_residual"}, "q_prev": {"type": "number", "minimum": 0}, "q_now": {"type": "number", "minimum": 0}, "s_prev": {"type": "number", "exclusiveMinimum": 0}, "s_now": {"type": "number", "exclusiveMinimum": 0}}},
    "flowProxy": {"type": "object", "additionalProperties": false, "required": ["kind", "proxy_method", "q_prev", "q_now"], "properties": {"kind": {"const": "proxy_residual"}, "proxy_method": {"enum": ["continuing_constituent_sum", "continuing_constituent_median", "price_residual_weight"]}, "q_prev": {"type": ["number", "null"], "minimum": 0}, "q_now": {"type": ["number", "null"], "minimum": 0}}},
    "unavailableMeasure": {"type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"const": "unavailable"}, "reason": {"$ref": "#/$defs/missingReason"}}},
    "themeMemberChange": {"type": "object", "additionalProperties": false, "required": ["kind", "q_prev", "q_now"], "properties": {"kind": {"const": "theme_member_reported_share_change"}, "q_prev": {"type": ["number", "null"], "minimum": 0}, "q_now": {"type": ["number", "null"], "minimum": 0}}},
    "complexPresence": {"type": "object", "additionalProperties": false, "required": ["kind", "state", "present_complex_epoch_ids"], "properties": {"kind": {"const": "complex_presence"}, "state": {"enum": ["observed", "unavailable"]}, "present_complex_epoch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mce_[a-z0-9_]+$"}}}},
    "managerDenominator": {"type": "object", "additionalProperties": false, "required": ["kind", "state", "total_positions", "included_positions", "excluded_positions", "missing_positions"], "properties": {"kind": {"const": "public_reported_sleeve"}, "state": {"enum": ["complete", "partial", "unknown"]}, "total_positions": {"type": "integer", "minimum": 0}, "included_positions": {"type": "integer", "minimum": 0}, "excluded_positions": {"type": "integer", "minimum": 0}, "missing_positions": {"type": "integer", "minimum": 0}}},
    "flowDenominator": {"type": "object", "additionalProperties": false, "required": ["kind", "state"], "properties": {"kind": {"const": "vehicle_shares_outstanding"}, "state": {"enum": ["true_observed", "proxy", "unavailable"]}}},
    "themeDenominator": {"type": "object", "additionalProperties": false, "required": ["kind", "comparison_id"], "properties": {"kind": {"const": "pit_theme_membership"}, "comparison_id": {"type": "string", "pattern": "^thc_[a-z0-9_]+$"}}},
    "saturationDenominator": {"type": "object", "additionalProperties": false, "required": ["kind", "eligible_complex_epoch_ids", "excluded_complex_epochs"], "properties": {"kind": {"const": "eligible_research_complexes"}, "eligible_complex_epoch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mce_[a-z0-9_]+$"}}, "excluded_complex_epochs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["complex_epoch_id", "reason"], "properties": {"complex_epoch_id": {"type": "string", "pattern": "^mce_[a-z0-9_]+$"}, "reason": {"enum": ["unresolved", "inactive", "passive", "systematic", "mixed", "unknown", "epoch_not_applicable"]}}}}}},
    "observationCorrection": {"type": "object", "additionalProperties": false, "required": ["kind", "predecessor_observation_id", "reason", "append_only"], "properties": {"kind": {"enum": ["none", "amendment", "restatement", "source_correction", "withdrawal", "superseding_generation"]}, "predecessor_observation_id": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"], "maxLength": 512}, "append_only": {"const": true}}},
    "cusipSecurityBinding": {"type": "object", "additionalProperties": false, "required": ["key_type", "cusip", "dataos_security_id", "dataos_resolution"], "properties": {"key_type": {"const": "cusip"}, "cusip": {"type": "string", "pattern": "^[0-9A-Z]{9}$"}, "dataos_security_id": {"type": ["string", "null"]}, "dataos_resolution": {"enum": ["unresolved_no_authoritative_cusip_plane", "alias_table_resolved"]}}},
    "ownerRow": {"type": "object", "additionalProperties": false, "required": ["accession", "infotable_sk", "row_hash", "cusip"], "properties": {"accession": {"type": "string", "minLength": 1, "maxLength": 32}, "infotable_sk": {"type": "integer", "minimum": 0}, "row_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "cusip": {"type": "string", "pattern": "^[0-9A-Z]{9}$"}}},
    "ownerPeriodBinding": {"type": "object", "additionalProperties": false, "required": ["catalog_binding", "raw_receipt_binding", "row"], "properties": {"catalog_binding": {"$ref": "#/$defs/referenceBinding"}, "raw_receipt_binding": {"$ref": "#/$defs/referenceBinding"}, "row": {"$ref": "#/$defs/ownerRow"}}},
    "ownerRowBinding": {"type": "object", "additionalProperties": false, "required": ["security", "previous", "current"], "properties": {"security": {"$ref": "#/$defs/cusipSecurityBinding"}, "previous": {"$ref": "#/$defs/ownerPeriodBinding"}, "current": {"$ref": "#/$defs/ownerPeriodBinding"}}},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "evidence_basis", "evidence_reference_id", "reference_binding", "vehicle_epoch_id", "subject_id", "theme_id", "theme_epoch_id", "plane", "measure", "denominator", "correction"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^obs_[a-z0-9_]+$"}, "evidence_basis": {"enum": ["source_backed_pointer_only", "synthetic_fixture_positive", "synthetic_fixture_adverse", "source_backed_owner_row"]}, "evidence_reference_id": {"type": "string", "pattern": "^efr_[a-f0-9]{64}$"}, "reference_binding": {"$ref": "#/$defs/referenceBinding"},
        "vehicle_epoch_id": {"type": "string"}, "subject_id": {"type": "string", "minLength": 1, "maxLength": 256}, "theme_id": {"type": "string", "minLength": 1, "maxLength": 256}, "theme_epoch_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "plane": {"enum": ["manager_research_intent", "fund_flow_pressure", "theme_capital_rotation", "institutionalization_saturation"]},
        "measure": {"oneOf": [{"$ref": "#/$defs/reportedShareChange"}, {"$ref": "#/$defs/etfTrueShareResidual"}, {"$ref": "#/$defs/flowProxy"}, {"$ref": "#/$defs/unavailableMeasure"}, {"$ref": "#/$defs/themeMemberChange"}, {"$ref": "#/$defs/complexPresence"}]},
        "denominator": {"oneOf": [{"$ref": "#/$defs/managerDenominator"}, {"$ref": "#/$defs/flowDenominator"}, {"$ref": "#/$defs/themeDenominator"}, {"$ref": "#/$defs/saturationDenominator"}]},
        "correction": {"$ref": "#/$defs/observationCorrection"},
        "owner_row_binding": {"$ref": "#/$defs/ownerRowBinding"}
      },
      "if": {"properties": {"evidence_basis": {"const": "source_backed_owner_row"}}, "required": ["evidence_basis"]},
      "then": {"required": ["owner_row_binding"]},
      "else": {"not": {"required": ["owner_row_binding"]}}
    },
    "themeComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_id", "theme_id", "theme_epoch_id", "target_observation_id", "peer_observation_ids", "as_of", "membership_reference_id", "membership_clock_binding", "denominator_receipt"],
      "properties": {
        "comparison_id": {"type": "string", "pattern": "^thc_[a-z0-9_]+$"}, "theme_id": {"type": "string"}, "theme_epoch_id": {"type": "string"}, "target_observation_id": {"type": "string"}, "peer_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "as_of": {"type": "string", "format": "date-time"}, "membership_reference_id": {"type": "string", "pattern": "^efr_[a-f0-9]{64}$"}, "membership_clock_binding": {"$ref": "#/$defs/clockBinding"},
        "denominator_receipt": {"type": "object", "additionalProperties": false, "required": ["member_observation_ids", "eligible_observation_ids", "excluded_members"], "properties": {"member_observation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}}, "eligible_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "excluded_members": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "reason"], "properties": {"observation_id": {"type": "string"}, "reason": {"enum": ["passive_or_systematic", "mechanical", "rights_blocked", "missing", "unresolved_identity", "unavailable_measure", "epoch_not_applicable", "superseded"]}}}}}}
      }
    },
    "campaignCorrection": {"type": "object", "additionalProperties": false, "required": ["kind", "supersedes_transition_id", "reason", "append_only"], "properties": {"kind": {"enum": ["none", "amendment", "restatement", "source_correction", "withdrawal", "superseding_generation"]}, "supersedes_transition_id": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"], "maxLength": 512}, "append_only": {"const": true}}},
    "campaignTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "campaign_id", "sequence", "previous_transition_id", "subject_id", "manager_complex_id", "complex_epoch_id", "from", "to", "transitioned_at", "observation_ids", "correction"],
      "properties": {"transition_id": {"type": "string", "pattern": "^ctr_[a-z0-9_]+$"}, "campaign_id": {"type": "string", "pattern": "^cmp_[a-z0-9_]+$"}, "sequence": {"type": "integer", "minimum": 1}, "previous_transition_id": {"type": ["string", "null"]}, "subject_id": {"type": "string"}, "manager_complex_id": {"type": "string"}, "complex_epoch_id": {"type": "string"}, "from": {"enum": ["IDLE", "INITIATED", "ACCUMULATING", "PAUSED"]}, "to": {"enum": ["INITIATED", "ACCUMULATING", "PAUSED", "CLOSED"]}, "transitioned_at": {"type": "string", "format": "date-time"}, "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "correction": {"$ref": "#/$defs/campaignCorrection"}}
    },
    "reliability": {
      "type": "object", "additionalProperties": false,
      "required": ["manager_complex_id", "complex_epoch_id", "domain", "horizon", "action", "eligibility_state", "maturity_state", "scored_state", "trial_cutoff_at", "maturity_cutoff_at", "trials", "matured_trials", "scored_trials", "successes", "prior_alpha", "prior_beta", "uncertainty_method", "evaluation_owner", "evaluation_mode", "legacy_grade_imported"],
      "properties": {
        "manager_complex_id": {"type": "string"}, "complex_epoch_id": {"type": "string"}, "domain": {"enum": ["general", "ai_infrastructure", "healthcare", "energy", "financials"]}, "horizon": {"enum": ["5d", "21d", "63d", "quarterly"]}, "action": {"enum": ["reported_add", "initiate", "trim", "exit", "within_theme_preference"]},
        "eligibility_state": {"enum": ["eligible", "insufficient"]}, "maturity_state": {"enum": ["matured", "immature", "insufficient"]}, "scored_state": {"enum": ["scored", "unscored", "insufficient"]}, "trial_cutoff_at": {"type": "string", "format": "date-time"}, "maturity_cutoff_at": {"type": "string", "format": "date-time"},
        "trials": {"type": "integer", "minimum": 0}, "matured_trials": {"type": "integer", "minimum": 0}, "scored_trials": {"type": "integer", "minimum": 0}, "successes": {"type": "integer", "minimum": 0}, "prior_alpha": {"type": "number", "exclusiveMinimum": 0}, "prior_beta": {"type": "number", "exclusiveMinimum": 0},
        "uncertainty_method": {"type": "object", "additionalProperties": false, "required": ["method", "version", "confidence_level"], "properties": {"method": {"const": "beta_binomial_normal_approx"}, "version": {"const": "1.0.0"}, "confidence_level": {"const": 0.95}}},
        "evaluation_owner": {"const": "Eval OS"}, "evaluation_mode": {"const": "prospective_only"}, "legacy_grade_imported": {"const": false}
      }
    }
  }
}
