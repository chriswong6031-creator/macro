{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K2-B manager research intent recipe",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "recipe_id", "authority", "k1_evidence_ref", "manager_complexes", "vehicles", "observations", "campaign_transitions", "reliability"],
  "properties": {
    "schema": {"const": "institutional_intelligence.manager_intent_recipe.v1"},
    "recipe_id": {"type": "string", "pattern": "^mri_[a-f0-9]{64}$"},
    "authority": {"$ref": "#/$defs/authority"},
    "k1_evidence_ref": {"type": "object"},
    "manager_complexes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/complex"}},
    "vehicles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vehicle"}},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "campaign_transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/campaign_transition"}},
    "reliability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reliability"}}
  },
  "$defs": {
    "authority": {"type": "object", "additionalProperties": false, "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry"], "properties": {"can_rank": {"const": false}, "can_gate": {"const": false}, "can_size": {"const": false}, "can_originate": {"const": false}, "can_open_entry": {"const": false}}},
    "complex": {"type": "object", "additionalProperties": false, "required": ["manager_complex_id", "identity_epoch", "actor_class", "actor_class_source", "resolution_state", "filer_ids", "filer_epochs"], "properties": {"manager_complex_id": {"type": "string", "pattern": "^mcx_[a-z0-9_]+$"}, "identity_epoch": {"type": "string", "pattern": "^mce_[a-z0-9_]+$"}, "actor_class": {"enum": ["global_institutional_manager", "cn_public_fund", "cn_insurer", "cn_securities_firm", "cn_qfii", "cn_social_security", "cn_southbound_holder", "cn_lhb_seat", "cn_institutional_visit_actor"]}, "actor_class_source": {"enum": ["B0_MANAGER_COMPLEX_DRAFT", "CHINA_ALPHA_INTELLIGENCE_ARCHITECTURE_FREEZE"]}, "resolution_state": {"enum": ["resolved", "unresolved"]}, "filer_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{10}$"}}, "filer_epochs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["filer_id", "identity_epoch"], "properties": {"filer_id": {"type": "string", "pattern": "^[0-9]{10}$"}, "identity_epoch": {"type": "string", "pattern": "^fie_[a-z0-9_]+$"}}}}, "identity_aliases": {"type": "array", "items": {"type": "string"}}}},
    "vehicle": {"type": "object", "additionalProperties": false, "required": ["vehicle_id", "vehicle_identity_epoch", "manager_complex_id", "manager_identity_epoch", "vehicle_class"], "properties": {"vehicle_id": {"type": "string", "pattern": "^veh_[a-z0-9_]+$"}, "vehicle_identity_epoch": {"type": "string", "pattern": "^vie_[a-z0-9_]+$"}, "manager_complex_id": {"type": "string"}, "manager_identity_epoch": {"type": "string"}, "vehicle_class": {"enum": ["concentrated_discretionary_active", "diversified_discretionary_active", "sector_specialist_active", "systematic_active", "thematic_passive", "broad_passive", "options_income_overlay", "leveraged_inverse", "synthetic_fund_of_funds"]}}},
    "pointer": {"type": "object", "additionalProperties": false, "required": ["reference_id", "owner", "object_id", "accession", "source_url", "published_at", "knowable_at"], "properties": {"reference_id": {"type": "string", "pattern": "^efr_[a-f0-9]{64}$"}, "owner": {"type": "string"}, "object_id": {"type": "string"}, "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "source_url": {"type": "string"}, "published_at": {"type": "string"}, "knowable_at": {"type": "string"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["event_id", "vehicle_id", "subject_id", "plane", "observation_kind", "source_kind", "theme_id", "theme_identity_epoch", "report_period_end", "filed_at", "published_at", "knowable_at", "shares_outstanding", "holdings_normalization", "plane_descriptor", "coverage", "missingness", "evidence_ref"], "properties": {"event_id": {"type": "string", "pattern": "^obs_[a-z0-9_]+$"}, "vehicle_id": {"type": "string"}, "subject_id": {"type": "string", "pattern": "^sec_[a-z0-9_]+$"}, "plane": {"enum": ["manager_research_intent", "fund_flow_pressure", "theme_capital_rotation", "institutionalization_saturation"]}, "observation_kind": {"enum": ["reported_holding_change", "within_theme_preference", "mechanical_flow", "live_flow"]}, "source_kind": {"enum": ["form_13f", "sponsor_holdings", "n_port"]}, "theme_id": {"type": "string"}, "theme_identity_epoch": {"type": "string"}, "report_period_end": {"type": "string"}, "filed_at": {"type": "string"}, "published_at": {"type": "string"}, "knowable_at": {"type": "string"}, "stale_after_days": {"type": "integer", "minimum": 1}, "shares_outstanding": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"enum": ["observed", "absent", "unsupported"]}, "value": {"type": ["number", "null"]}}}, "holdings_normalization": {"type": "object", "additionalProperties": false, "required": ["basis", "prior_holding_shares", "holding_shares", "normalization_state"], "properties": {"basis": {"enum": ["13f_unscaled_reported_shares", "etf_true_shares_outstanding", "unresolved"]}, "prior_holding_shares": {"type": ["number", "null"]}, "holding_shares": {"type": ["number", "null"]}, "normalization_state": {"enum": ["observed", "proxy", "unresolved"]}}}, "plane_descriptor": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"intent_state": {"enum": ["reported_preference", "no_intent_claim"]}, "flow_driver": {"enum": ["subscriptions_redemptions", "reconstitution", "proxy_or_unresolved"]}, "rotation_membership_state": {"enum": ["target_and_peer_pit_bound", "unresolved"]}, "saturation_measure_state": {"enum": ["breadth_observed", "concentration_observed", "unknown"]}}}, "mechanical_residual": {"type": ["object", "null"], "additionalProperties": false, "required": ["basis", "state", "residual_shares"], "properties": {"basis": {"enum": ["true_shares_outstanding", "proxy", "unresolved"]}, "state": {"enum": ["resolved", "proxy", "unresolved"]}, "residual_shares": {"type": ["number", "null"]}}}, "within_theme_comparison": {"type": ["object", "null"], "additionalProperties": false, "required": ["theme_id", "theme_identity_epoch", "target_observation_ids", "comparator_observation_ids", "denominator_observation_ids", "calculation", "as_of", "knowable_at"], "properties": {"theme_id": {"type": "string"}, "theme_identity_epoch": {"type": "string"}, "target_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "comparator_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "denominator_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "calculation": {"enum": ["target_share_delta_over_pit_peer_denominator"]}, "as_of": {"type": "string"}, "knowable_at": {"type": "string"}}}, "coverage": {"type": "object", "additionalProperties": false, "required": ["state", "coverage_class", "rights"], "properties": {"state": {"enum": ["complete", "partial", "unknown"]}, "coverage_class": {"enum": ["source_release_snapshot_only", "current_only", "record_history_complete", "prospective_only"]}, "rights": {"enum": ["permitted", "rights_blocked", "unknown"]}}}, "missingness": {"type": "object", "additionalProperties": false, "required": ["state", "reason", "zero_substituted"], "properties": {"state": {"enum": ["present", "absent"]}, "reason": {"type": ["string", "null"]}, "zero_substituted": {"const": false}}}, "evidence_ref": {"$ref": "#/$defs/pointer"}, "correction": {"type": ["object", "null"], "additionalProperties": false, "required": ["supersedes_event_id", "reason"], "properties": {"supersedes_event_id": {"type": "string"}, "reason": {"type": "string"}}}}},
    "campaign_transition": {"type": "object", "additionalProperties": false, "required": ["transition_id", "campaign_id", "subject_id", "manager_complex_id", "manager_identity_epoch", "from", "to", "transitioned_at", "knowable_at", "observation_ids", "evidence_ref_id"], "properties": {"transition_id": {"type": "string", "pattern": "^ctr_[a-z0-9_]+$"}, "campaign_id": {"type": "string", "pattern": "^cmp_[a-z0-9_]+$"}, "subject_id": {"type": "string"}, "manager_complex_id": {"type": "string"}, "manager_identity_epoch": {"type": "string"}, "from": {"enum": ["IDLE", "INITIATED", "ACCUMULATING", "PAUSED", "CLOSED"]}, "to": {"enum": ["IDLE", "INITIATED", "ACCUMULATING", "PAUSED", "CLOSED"]}, "transitioned_at": {"type": "string"}, "knowable_at": {"type": "string"}, "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_ref_id": {"type": "string"}}},
    "reliability": {"type": "object", "additionalProperties": false, "required": ["manager_complex_id", "manager_identity_epoch", "domain", "horizon", "action", "eligibility_state", "cutoff_at", "matured_at", "maturity_state", "scored_state", "successes", "trials", "prior_rate", "prior_strength", "uncertainty", "oracle_semantics"], "properties": {"manager_complex_id": {"type": "string"}, "manager_identity_epoch": {"type": "string"}, "domain": {"type": "string"}, "horizon": {"type": "string"}, "action": {"type": "string"}, "eligibility_state": {"enum": ["eligible", "insufficient"]}, "cutoff_at": {"type": "string"}, "matured_at": {"type": ["string", "null"]}, "maturity_state": {"enum": ["matured", "insufficient"]}, "scored_state": {"enum": ["scored", "insufficient"]}, "successes": {"type": "integer", "minimum": 0}, "trials": {"type": "integer", "minimum": 0}, "prior_rate": {"type": "number", "minimum": 0, "maximum": 1}, "prior_strength": {"type": "number", "exclusiveMinimum": 0}, "uncertainty": {"type": "object", "additionalProperties": false, "required": ["state", "lower", "upper"], "properties": {"state": {"enum": ["estimated", "insufficient"]}, "lower": {"type": ["number", "null"]}, "upper": {"type": ["number", "null"]}}}, "oracle_semantics": {"const": false}}}
  }
}
