{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K2-B manager research intent recipe",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "recipe_id", "authority", "manager_complexes", "vehicles", "observations", "campaign_transitions", "reliability"],
  "properties": {
    "schema": {"const": "institutional_intelligence.manager_intent_recipe.v1"},
    "recipe_id": {"type": "string", "pattern": "^mri_[a-f0-9]{64}$"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["can_rank", "can_gate", "can_size", "can_originate", "can_open_entry"], "properties": {"can_rank": {"const": false}, "can_gate": {"const": false}, "can_size": {"const": false}, "can_originate": {"const": false}, "can_open_entry": {"const": false}}},
    "manager_complexes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["manager_complex_id", "identity_epoch"], "properties": {"manager_complex_id": {"type": "string", "pattern": "^mcx_[a-z0-9_]+$"}, "identity_epoch": {"type": "string", "pattern": "^mce_[a-z0-9_]+$"}, "identity_aliases": {"type": "array", "items": {"type": "string"}}}}},
    "vehicles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["vehicle_id", "manager_complex_id", "manager_identity_epoch", "vehicle_class"], "properties": {"vehicle_id": {"type": "string", "pattern": "^veh_[a-z0-9_]+$"}, "manager_complex_id": {"type": "string"}, "manager_identity_epoch": {"type": "string"}, "vehicle_class": {"type": "string"}}}},
    "observations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "vehicle_id", "plane", "observation_kind", "source_kind", "evidence_ref", "shares_outstanding", "coverage", "theme_id", "theme_identity_epoch"], "properties": {"event_id": {"type": "string", "pattern": "^obs_[a-z0-9_]+$"}, "vehicle_id": {"type": "string"}, "plane": {"type": "string"}, "observation_kind": {"type": "string"}, "source_kind": {"type": "string"}, "theme_id": {"type": "string"}, "theme_identity_epoch": {"type": "string"}, "report_period_end": {"type": "string"}, "filed_at": {"type": "string"}, "published_at": {"type": "string"}, "knowable_at": {"type": "string"}, "stale_after_days": {"type": "integer", "minimum": 1}, "within_theme_comparison": {"type": "object", "additionalProperties": false, "required": ["theme_id", "theme_identity_epoch"], "properties": {"theme_id": {"type": "string"}, "theme_identity_epoch": {"type": "string"}}}, "shares_outstanding": {"type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": {"state": {"enum": ["observed", "absent", "unsupported"]}, "value": {"type": ["number", "null"]}}}, "coverage": {"type": "object", "additionalProperties": false, "required": ["state", "rights"], "properties": {"state": {"enum": ["complete", "partial", "unknown"]}, "rights": {"enum": ["allowed", "blocked", "unknown"]}}}, "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["reference_id", "owner", "object_id", "accession", "source_url", "published_at", "knowable_at"], "properties": {"reference_id": {"type": "string", "pattern": "^efr_[a-f0-9]{64}$"}, "owner": {"type": "string"}, "object_id": {"type": "string"}, "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"}, "source_url": {"type": "string"}, "published_at": {"type": "string"}, "knowable_at": {"type": "string"}}}, "correction": {"type": "object", "additionalProperties": false, "required": ["supersedes_event_id", "reason"], "properties": {"supersedes_event_id": {"type": "string"}, "reason": {"type": "string"}}}}}},
    "campaign_transitions": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"enum": ["IDLE", "INITIATED", "ACCUMULATING", "PAUSED", "CLOSED"]}, "to": {"enum": ["IDLE", "INITIATED", "ACCUMULATING", "PAUSED", "CLOSED"]}}}},
    "reliability": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["manager_complex_id", "domain", "horizon", "action", "successes", "trials", "prior_rate", "prior_strength", "oracle_semantics"], "properties": {"manager_complex_id": {"type": "string"}, "domain": {"type": "string"}, "horizon": {"type": "string"}, "action": {"type": "string"}, "successes": {"type": "integer", "minimum": 0}, "trials": {"type": "integer", "minimum": 1}, "prior_rate": {"type": "number", "minimum": 0, "maximum": 1}, "prior_strength": {"type": "number", "exclusiveMinimum": 0}, "oracle_semantics": {"const": false}}}}
  }
}
