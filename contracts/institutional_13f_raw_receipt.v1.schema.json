{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/institutional_13f_raw_receipt.v1.schema.json",
  "title": "Institutional 13F raw evidence receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt_id",
    "accession",
    "filer_cik",
    "form",
    "source_url",
    "producer_version",
    "clocks",
    "raw_object"
  ],
  "properties": {
    "schema": {"const": "institutional_13f.raw_evidence_receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^i13fraw_[a-f0-9]{64}$"},
    "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "filer_cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "form": {"enum": ["13F-HR", "13F-HR/A", "13F-NT", "13F-NT/A"]},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://([^/]+\\.)?sec\\.gov/"},
    "producer_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]{0,127}$"},
    "clocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_period", "accepted_at", "retained_at"],
      "properties": {
        "report_period": {"type": "string", "format": "date"},
        "accepted_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "retained_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
      }
    },
    "raw_object": {"$ref": "#/$defs/storedObject"}
  },
  "$defs": {
    "storedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "object_key", "sha256", "byte_length", "content_type", "row_count"],
      "properties": {
        "role": {"const": "raw_submission"},
        "object_key": {
          "type": "string",
          "pattern": "^smart-money/13f/evidence/v1/objects/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.bin$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "content_type": {"const": "application/octet-stream"},
        "row_count": {"type": "null"}
      }
    }
  }
}
