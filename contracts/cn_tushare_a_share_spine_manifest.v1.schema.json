        "cap_trigger_policy": {
          "const": "discard_probe_and_switch_entire_endpoint_requested_interval"
        },
        "method": {"const": "immutable_per_ticker_date_range_campaign"},
        "split_rule": {
          "const": "deterministic_contiguous_market_session_chunks_cap_minus_one_v1"
        },
        "leaf_state_model": {"const": "separate_atomic_json_per_leaf"},
        "attempt_receipt_model": {
          "const": "immutable_numbered_receipt_per_physical_request"
        },
        "retry_priority": {"const": "unattempted_then_fewest_attempts"},
        "bse_alias_resolution": {
          "const": "canonical_preferred_when_equal_conflicting_rows_retained_and_block"
        },
        "transposition_rule": {
          "const": "terminal_campaign_then_exact_day_normalize_replace_and_receipt_bind"
        },
        "request_estimate_formula": {
          "const": "H_e + I_e * ceil(S/(C_e-1)) + R_e"
        },
        "range_shard_implemented": {"type": "boolean"},
        "synthetic_verification_complete": {"type": "boolean"},
        "live_canary_complete": {"type": "boolean"},
        "live_canary_required_for_promotion": {"type": "boolean"}
      }
