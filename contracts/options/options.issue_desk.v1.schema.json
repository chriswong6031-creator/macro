{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mastermind:options:issue-desk:v1",
  "title": "Private operator-reviewed Options Issue Desk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authority", "authority_tier", "mode", "as_of", "built_at",
    "available_at", "policy", "readiness", "proposals", "decisions",
    "positions", "capacity", "provenance"
  ],
  "properties": {
    "schema": {"const": "options.issue_desk/v1"},
    "authority": {"$ref": "#/$defs/authority"},
    "authority_tier": {"const": "operator_reviewed_research_only"},
    "mode": {"const": "private"},
    "as_of": {"type": "string", "format": "date"},
    "built_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "available_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_new_issues", "rolling_sessions", "max_issue_allocation_weight",
        "max_active_per_sleeve", "max_active_per_correlation_cluster",
        "zero_is_valid", "automatic_authority", "post_issue_mutation_v1"
      ],
      "properties": {
        "max_new_issues": {"const": 4},
        "rolling_sessions": {"const": 3},
        "max_issue_allocation_weight": {"const": 0.25},
        "max_active_per_sleeve": {"const": 2},
        "max_active_per_correlation_cluster": {"const": 1},
        "zero_is_valid": {"const": true},
        "automatic_authority": {"const": false},
        "post_issue_mutation_v1": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuance_requires", "current_options_shadow_authority", "brokerage_execution"],
      "properties": {
        "issuance_requires": {"const": "complete_operator_attested_issue_receipt"},
        "current_options_shadow_authority": {"const": "display_only"},
        "brokerage_execution": {"const": false}
      }
    },
    "proposals": {"type": "array", "items": {"$ref": "urn:mastermind:options:issue-desk-proposal:v1"}},
    "decisions": {"type": "array", "items": {"$ref": "urn:mastermind:options:issue-desk-decision:v1"}},
    "positions": {"type": "array", "items": {"$ref": "#/$defs/position"}},
    "capacity": {"$ref": "#/$defs/capacity"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durable_private_store", "snapshot", "public_r2_mirror"],
      "properties": {
        "durable_private_store": {"const": true},
        "snapshot": {"type": "object"},
        "public_r2_mirror": {"const": false}
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_trade", "may_rank", "may_gate", "may_size", "may_automatic"],
      "properties": {
        "may_trade": {"const": false},
        "may_rank": {"const": false},
        "may_gate": {"const": false},
        "may_size": {"const": false},
        "may_automatic": {"const": false}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_new_issues", "rolling_sessions", "issued_in_window", "remaining"],
      "properties": {
        "max_new_issues": {"const": 4},
        "rolling_sessions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        },
        "issued_in_window": {"type": "integer", "minimum": 0, "maximum": 4},
        "remaining": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_type", "decision_at", "available_at", "reason_codes", "reviewer", "post_issue_mutation"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^oidd_[a-f0-9]{24}$"},
        "event_type": {"const": "ISSUED"},
        "decision_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "available_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "reviewer": {"type": "string", "minLength": 1},
        "post_issue_mutation": {"const": false}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_id", "proposal_id", "proposal_revision", "symbol", "lifecycle_state", "brokerage_trade", "issue_receipt", "events", "authority"],
      "properties": {
        "position_id": {"type": "string", "pattern": "^oidpos_[a-f0-9]{24}$"},
        "proposal_id": {"type": "string", "pattern": "^oidp_[a-f0-9]{24}$"},
        "proposal_revision": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string", "pattern": "^[A-Z0-9._-]{1,16}$"},
        "lifecycle_state": {"const": "ISSUED"},
        "brokerage_trade": {"const": false},
        "issue_receipt": {"$ref": "urn:mastermind:options:issue-receipt:v1"},
        "events": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/event"}},
        "authority": {"$ref": "#/$defs/authority"}
      }
    }
  }
}
