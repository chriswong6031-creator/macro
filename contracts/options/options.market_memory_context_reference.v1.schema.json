{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "options.market_memory_context_reference/v1",
  "title": "Exact requested-as-of Market Memory reference for options research",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "reference_id", "owner", "query", "disposition", "reason",
    "context", "evidence_policy", "authority"
  ],
  "properties": {
    "schema": {"const": "options.market_memory_context_reference/v1"},
    "reference_id": {"type": "string", "pattern": "^omctxref_[a-f0-9]{64}$"},
    "owner": {"$ref": "#/$defs/owner"},
    "query": {"$ref": "#/$defs/query"},
    "disposition": {"enum": ["bound", "abstained"]},
    "reason": {
      "oneOf": [
        {"type": "null"},
        {
          "enum": [
            "campaign_retrospective_discovery",
            "identity_not_operationally_supported",
            "exact_requested_as_of_context_absent"
          ]
        }
      ]
    },
    "context": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/context"}
      ]
    },
    "evidence_policy": {"$ref": "#/$defs/evidencePolicy"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"disposition": {"const": "bound"}},
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "context": {"$ref": "#/$defs/context"},
          "query": {
            "properties": {
              "subject": {"$ref": "#/$defs/subject"},
              "identity_config_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"disposition": {"const": "abstained"}},
        "required": ["disposition"]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "campaign_retrospective_discovery",
              "identity_not_operationally_supported",
              "exact_requested_as_of_context_absent"
            ]
          },
          "context": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "instrument_id"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^mmsecurity_[a-f0-9]{64}$"},
        "instrument_id": {"type": "string", "pattern": "^mmsecurity_[a-f0-9]{64}$"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "id", "record_sha256", "ticker", "event_time",
        "requested_as_of", "requested_as_of_basis", "evidence_phase"
      ],
      "properties": {
        "schema": {"enum": ["options.signal_episode/v1", "options.signal_campaign/v1"]},
        "id": {"type": "string", "pattern": "^(?:osep|ocam)_[a-f0-9]{24}$"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "ticker": {"type": "string", "pattern": "^[A-Z0-9.^=_-]{1,20}$"},
        "event_time": {"$ref": "#/$defs/timestamp"},
        "requested_as_of": {"$ref": "#/$defs/timestamp"},
        "requested_as_of_basis": {
          "enum": [
            "durable_available_at",
            "campaign_formed_at_anchor_available_at"
          ]
        },
        "evidence_phase": {
          "enum": [
            "decision_time_actual_output",
            "retrospective_discovery",
            "prospective_after_rule_freeze"
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject", "identity_config_sha256", "event_time", "as_known_at",
        "mode", "fallback_policy"
      ],
      "properties": {
        "subject": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/subject"}
          ]
        },
        "identity_config_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "event_time": {"$ref": "#/$defs/timestamp"},
        "as_known_at": {"$ref": "#/$defs/timestamp"},
        "mode": {"const": "operational_pit"},
        "fallback_policy": {"const": "exact_no_fallback"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id", "packet_sha256", "capture_id", "capture_schema",
        "query_id", "basis", "source_receipt_ids",
        "source_artifact_sha256s", "missing_feature_ids",
        "domain_coverage_sha256"
      ],
      "properties": {
        "context_id": {"type": "string", "pattern": "^mmctx_[a-f0-9]{64}$"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "capture_id": {"type": "string", "pattern": "^mmcapture_[a-f0-9]{64}$"},
        "capture_schema": {
          "enum": [
            "market_memory.capture_receipt.v1",
            "market_memory.trusted_capture_receipt.v1"
          ]
        },
        "query_id": {"type": "string", "pattern": "^mmquery_[a-f0-9]{64}$"},
        "basis": {"const": "exact_requested_as_of_capture"},
        "source_receipt_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^mmsrc_[a-f0-9]{64}$"}
        },
        "source_artifact_sha256s": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "missing_feature_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "domain_coverage_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_requested_as_of_required", "nearest_or_latest_fallback_allowed",
        "reconstruction_fallback_allowed", "hindsight_context_allowed",
        "context_only", "proposal_weight", "retrieval_authority",
        "forecast_authority", "training_eligible", "promotion_eligible"
      ],
      "properties": {
        "exact_requested_as_of_required": {"const": true},
        "nearest_or_latest_fallback_allowed": {"const": false},
        "reconstruction_fallback_allowed": {"const": false},
        "hindsight_context_allowed": {"const": false},
        "context_only": {"const": true},
        "proposal_weight": {"const": 0},
        "retrieval_authority": {"const": false},
        "forecast_authority": {"const": false},
        "training_eligible": {"const": false},
        "promotion_eligible": {"const": false}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier", "horizon_role", "context_only", "proposal_weight", "may_rank",
        "may_gate", "may_size", "may_escalate", "may_trade", "may_originate",
        "may_select_options_candidate", "may_execute", "may_write_options_episode",
        "may_append_outcome", "may_train_prophet"
      ],
      "properties": {
        "tier": {"const": "display"},
        "horizon_role": {"const": "context"},
        "context_only": {"const": true},
        "proposal_weight": {"const": 0},
        "may_rank": {"const": false},
        "may_gate": {"const": false},
        "may_size": {"const": false},
        "may_escalate": {"const": false},
        "may_trade": {"const": false},
        "may_originate": {"const": false},
        "may_select_options_candidate": {"const": false},
        "may_execute": {"const": false},
        "may_write_options_episode": {"const": false},
        "may_append_outcome": {"const": false},
        "may_train_prophet": {"const": false}
      }
    }
  }
}
