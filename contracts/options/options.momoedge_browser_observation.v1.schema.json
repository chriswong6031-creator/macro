{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/options/options.momoedge_browser_observation.v1.schema.json",
  "title": "Observe-only authenticated-page MomoEdge response envelope",
  "description": "A private browser observation. It cannot arm a producer, enroll an event, or count as cohort coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mode", "extension_version", "scheduled_at", "attempted_at",
    "completed_at", "disposition", "reason", "capture", "coverage_eligible", "authority"
  ],
  "properties": {
    "schema": {"const": "options.momoedge_browser_observation/v1"},
    "mode": {"const": "observe_only"},
    "extension_version": {"const": "0.1.0"},
    "scheduled_at": {"$ref": "#/$defs/timestamp"},
    "attempted_at": {"$ref": "#/$defs/timestamp"},
    "completed_at": {"$ref": "#/$defs/timestamp"},
    "disposition": {"enum": ["fresh_response", "unavailable"]},
    "reason": {"oneOf": [{"$ref": "#/$defs/unavailableReason"}, {"type": "null"}]},
    "capture": {"oneOf": [{"$ref": "#/$defs/capture"}, {"type": "null"}]},
    "coverage_eligible": {"const": false},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "fresh_response"}}},
      "then": {
        "properties": {
          "reason": {"type": "null"},
          "capture": {"$ref": "#/$defs/capture"}
        }
      },
      "else": {
        "properties": {
          "reason": {"$ref": "#/$defs/unavailableReason"},
          "capture": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "unavailableReason": {
      "enum": [
        "alarm_late", "capture_in_flight", "capture_timeout", "fetch_wrapper_restore_failed",
        "fresh_request_not_observed", "http_error", "invalid_fresh_response",
        "invalid_response_json", "invalid_response_shape", "multiple_matching_responses",
        "no_matching_tab", "page_execution_failed", "page_fetch_missing", "page_load_failed",
        "page_origin_path_mismatch", "page_runtime_missing", "response_too_large", "runtime_fallback_or_missing",
        "runtime_response_mismatch", "sensitive_key_rejected", "tab_not_ready"
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc", "epoch_ms"],
      "properties": {
        "utc": {"$ref": "#/$defs/timestamp"},
        "epoch_ms": {"type": "number"}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_request_observed", "active_and_source_today_closed_scope",
        "complete_new_york_day_proven", "runtime_response_reconciled",
        "sensitive_keys_absent", "fetch_wrapper_restored"
      ],
      "properties": {
        "fresh_request_observed": {"const": true},
        "active_and_source_today_closed_scope": {"const": true},
        "complete_new_york_day_proven": {"const": false},
        "runtime_response_reconciled": {"const": true},
        "sensitive_keys_absent": {"const": true},
        "fetch_wrapper_restored": {"const": true}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_contract", "response_schema", "source_closed_cutoff_at", "request_started_at",
        "response_completed_at", "http_status", "response_body_base64", "response_byte_count",
        "response_sha256", "row_count", "active_count", "closed_count", "proof"
      ],
      "properties": {
        "request_contract": {"const": "signals_active_plus_source_today_closed_fresh_fetch/v1"},
        "response_schema": {"const": "momoedge_signals_json_array/v1"},
        "source_closed_cutoff_at": {"$ref": "#/$defs/timestamp"},
        "request_started_at": {"$ref": "#/$defs/clock"},
        "response_completed_at": {"$ref": "#/$defs/clock"},
        "http_status": {"type": "integer", "minimum": 200, "maximum": 299},
        "response_body_base64": {"type": "string", "minLength": 4, "maxLength": 800000},
        "response_byte_count": {"type": "integer", "minimum": 1, "maximum": 600000},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 0, "maximum": 2000},
        "active_count": {"type": "integer", "minimum": 0, "maximum": 2000},
        "closed_count": {"type": "integer", "minimum": 0, "maximum": 2000},
        "proof": {"$ref": "#/$defs/proof"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_count_coverage", "may_enroll", "may_score", "may_rank", "may_size", "may_gate"],
      "properties": {
        "may_count_coverage": {"const": false},
        "may_enroll": {"const": false},
        "may_score": {"const": false},
        "may_rank": {"const": false},
        "may_size": {"const": false},
        "may_gate": {"const": false}
      }
    }
  }
}
