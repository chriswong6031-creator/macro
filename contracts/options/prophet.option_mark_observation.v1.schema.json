{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/options/prophet.option_mark_observation.v1.schema.json",
  "title": "Prospective Prophet exact-option mark observation",
  "description": "A host-private immutable prerequisite mark-path observation for every open Prophet plan carrying an option contract. Bid/ask is trade-paired, aged from its distinct quote clock, and never claims NBBO, current, live, executable, fill, trade P&L, or lifecycle outcome semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "observed_at_utc",
    "session_date",
    "storage",
    "prophet_index",
    "source",
    "previous",
    "coverage",
    "rows",
    "limitations",
    "authority"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "observation_id", "key", "sha256", "bytes"],
      "properties": {
        "schema": {"const": "prophet.option_mark_pointer/v1"},
        "observation_id": {"type": "string", "pattern": "^pom_obs_[a-f0-9]{64}$"},
        "key": {
          "type": "string",
          "pattern": "^observations/[0-9]{4}-[0-9]{2}-[0-9]{2}/pom_obs_[a-f0-9]{64}\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank_authority",
        "gate_authority",
        "sizing_authority",
        "issue_authority",
        "trade_authority",
        "prophet_authority",
        "neural_web_authority",
        "training_authority",
        "execution_authority"
      ],
      "properties": {
        "rank_authority": {"const": false},
        "gate_authority": {"const": false},
        "sizing_authority": {"const": false},
        "issue_authority": {"const": false},
        "trade_authority": {"const": false},
        "prophet_authority": {"const": false},
        "neural_web_authority": {"const": false},
        "training_authority": {"const": false},
        "execution_authority": {"const": false}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "right", "expiry", "strike", "strike_millis", "occ_symbol"],
      "properties": {
        "root": {"type": "string", "pattern": "^[A-Z0-9]{1,6}$"},
        "right": {"enum": ["C", "P"]},
        "expiry": {"type": "string", "format": "date"},
        "strike": {"type": "number", "exclusiveMinimum": 0},
        "strike_millis": {"type": "integer", "minimum": 1, "maximum": 99999999},
        "occ_symbol": {"type": "string", "minLength": 21, "maxLength": 21}
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "bid",
        "ask",
        "mid",
        "last",
        "quote_ts_utc",
        "trade_ts_utc",
        "source_sequence",
        "quote_age_seconds",
        "trade_age_seconds"
      ],
      "properties": {
        "label": {"const": "trade_paired_bid_ask"},
        "bid": {"type": "number", "minimum": 0},
        "ask": {"type": "number", "exclusiveMinimum": 0},
        "mid": {"type": "number", "exclusiveMinimum": 0},
        "last": {"type": ["number", "null"], "minimum": 0},
        "quote_ts_utc": {"type": "string", "format": "date-time"},
        "trade_ts_utc": {"type": "string", "format": "date-time"},
        "source_sequence": {"type": ["integer", "null"]},
        "quote_age_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "trade_age_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "entryMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis", "asof", "nbbo", "executable"],
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "basis": {"const": "plan_eod_mid"},
        "asof": {"type": ["string", "null"]},
        "nbbo": {"const": false},
        "executable": {"const": false}
      }
    }
  },
  "properties": {
    "schema": {"const": "prophet.option_mark_observation/v1"},
    "observation_id": {"type": "string", "pattern": "^pom_obs_[a-f0-9]{64}$"},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "session_date": {"type": "string", "format": "date"},
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "public_discovery", "public_redistribution"],
      "properties": {
        "visibility": {"const": "host_private"},
        "public_discovery": {"const": false},
        "public_redistribution": {"const": false}
      }
    },
    "prophet_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "asof", "recorded_at", "semantic_sha256", "source_url"],
      "properties": {
        "schema": {"const": "prophet.index/v1"},
        "asof": {"type": "string", "format": "date"},
        "recorded_at": {"type": ["string", "null"]},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "source_url": {"type": "string", "format": "uri"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "endpoint",
        "quote_label",
        "maximum_quote_age_seconds",
        "latest_selection",
        "nbbo",
        "live",
        "executable",
        "fill",
        "size_retained",
        "venue_retained",
        "condition_retained"
      ],
      "properties": {
        "provider": {"const": "licensed_options_history_feed"},
        "endpoint": {"const": "history_trade_quote"},
        "quote_label": {"const": "trade_paired_bid_ask"},
        "maximum_quote_age_seconds": {"const": 1800},
        "latest_selection": {
          "const": "max_quote_then_trade_then_sequence_when_available"
        },
        "nbbo": {"const": false},
        "live": {"const": false},
        "executable": {"const": false},
        "fill": {"const": false},
        "size_retained": {"const": false},
        "venue_retained": {"const": false},
        "condition_retained": {"const": false}
      }
    },
    "previous": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/pointer"}
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_plan_count",
        "active_option_plan_count",
        "unique_contract_count",
        "source_call_count",
        "available_quote_plan_count",
        "abstained_quote_plan_count",
        "available_mark_change_plan_count",
        "all_active_option_plans_accounted"
      ],
      "properties": {
        "index_plan_count": {"type": "integer", "minimum": 0},
        "active_option_plan_count": {"type": "integer", "minimum": 0},
        "unique_contract_count": {"type": "integer", "minimum": 0},
        "source_call_count": {"type": "integer", "minimum": 0},
        "available_quote_plan_count": {"type": "integer", "minimum": 0},
        "abstained_quote_plan_count": {"type": "integer", "minimum": 0},
        "available_mark_change_plan_count": {"type": "integer", "minimum": 0},
        "all_active_option_plans_accounted": {"const": true}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan",
          "contract",
          "quote_status",
          "quote_reason",
          "quote",
          "plan_entry_mark",
          "mark_change_status",
          "mark_change_reason",
          "mark_change_from_plan_pct",
          "mark_change_basis",
          "plan_state_context"
        ],
        "properties": {
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "asset", "phase", "plan_asof", "recorded_at", "entry_date"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "asset": {"type": "string", "minLength": 1},
              "phase": {"type": "string", "minLength": 1},
              "plan_asof": {"type": ["string", "null"]},
              "recorded_at": {"type": ["string", "null"]},
              "entry_date": {"type": ["string", "null"]}
            }
          },
          "contract": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/contract"}
            ]
          },
          "quote_status": {"enum": ["available", "abstain"]},
          "quote_reason": {
            "type": ["string", "null"],
            "enum": [
              null,
              "INVALID_CONTRACT_IDENTITY",
              "CONTRACT_EXPIRED",
              "SOURCE_UNAVAILABLE",
              "QUOTE_SHAPE_INVALID",
              "QUOTE_AFTER_OBSERVATION",
              "TRADE_AFTER_OBSERVATION",
              "QUOTE_AFTER_TRADE",
              "QUOTE_WRONG_SESSION",
              "TRADE_WRONG_SESSION",
              "QUOTE_OUTSIDE_RTH",
              "QUOTE_TOO_OLD"
            ]
          },
          "quote": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/quote"}
            ]
          },
          "plan_entry_mark": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/entryMark"}
            ]
          },
          "mark_change_status": {"enum": ["available", "unavailable"]},
          "mark_change_reason": {
            "type": ["string", "null"],
            "enum": [
              null,
              "INVALID_CONTRACT_IDENTITY",
              "CONTRACT_EXPIRED",
              "SOURCE_UNAVAILABLE",
              "QUOTE_SHAPE_INVALID",
              "QUOTE_AFTER_OBSERVATION",
              "TRADE_AFTER_OBSERVATION",
              "QUOTE_AFTER_TRADE",
              "QUOTE_WRONG_SESSION",
              "TRADE_WRONG_SESSION",
              "QUOTE_OUTSIDE_RTH",
              "QUOTE_TOO_OLD",
              "ENTRY_MARK_UNAVAILABLE",
              "ENTRY_MARK_BASIS_UNVERIFIED"
            ]
          },
          "mark_change_from_plan_pct": {"type": ["number", "null"], "minimum": -100},
          "mark_change_basis": {"const": "plan_eod_mid_to_trade_paired_mid"},
          "plan_state_context": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "position_assumed"],
            "properties": {
              "state": {"enum": ["watch_only_pre_trigger", "display_plan_active"]},
              "position_assumed": {"const": false}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"quote_status": {"const": "available"}}, "required": ["quote_status"]},
            "then": {
              "properties": {
                "contract": {"type": "object"},
                "quote_reason": {"type": "null"},
                "quote": {"type": "object"}
              }
            },
            "else": {
              "properties": {
                "quote_reason": {"type": "string"},
                "quote": {"type": "null"}
              }
            }
          },
          {
            "if": {"properties": {"mark_change_status": {"const": "available"}}, "required": ["mark_change_status"]},
            "then": {
              "properties": {
                "quote": {"type": "object"},
                "plan_entry_mark": {"type": "object"},
                "mark_change_reason": {"type": "null"},
                "mark_change_from_plan_pct": {"type": "number", "minimum": -100}
              }
            },
            "else": {
              "properties": {
                "mark_change_reason": {"type": "string"},
                "mark_change_from_plan_pct": {"type": "null"}
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mark_change_only",
        "not_trade_pnl",
        "not_lifecycle_outcome",
        "prerequisite_mark_path_only",
        "no_position_assumed",
        "no_provider_observed_entry_or_exit",
        "source_size_venue_and_condition_intentionally_discarded",
        "prospective_from_first_observation_only"
      ],
      "properties": {
        "mark_change_only": {"const": true},
        "not_trade_pnl": {"const": true},
        "not_lifecycle_outcome": {"const": true},
        "prerequisite_mark_path_only": {"const": true},
        "no_position_assumed": {"const": true},
        "no_provider_observed_entry_or_exit": {"const": true},
        "source_size_venue_and_condition_intentionally_discarded": {"const": true},
        "prospective_from_first_observation_only": {"const": true}
      }
    },
    "authority": {"$ref": "#/$defs/authority"}
  }
}
