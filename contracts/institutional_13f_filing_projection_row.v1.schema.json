{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/institutional_13f_filing_projection_row.v1.schema.json",
  "title": "Institutional 13F filing projection row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accession",
    "filer_cik",
    "filer_name",
    "form",
    "filing_date",
    "accepted_at",
    "report_period",
    "report_type",
    "form13f_file_number",
    "is_amendment",
    "amendment_number",
    "amendment_type",
    "amends_accession",
    "lineage_state",
    "confidential_omitted",
    "table_entry_total",
    "table_value_total_usd",
    "other_manager_count",
    "source_receipt_id",
    "normalization_id",
    "raw_sha256",
    "first_seen_at",
    "retained_at",
    "parser_version",
    "quality_state"
  ],
  "properties": {
    "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "filer_cik": {"type": "string", "pattern": "^[0-9]{10}$"},
    "filer_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 1048576},
    "form": {"enum": ["13F-HR", "13F-HR/A", "13F-NT", "13F-NT/A"]},
    "filing_date": {"type": ["string", "null"], "format": "date"},
    "accepted_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "report_period": {"type": "string", "format": "date"},
    "report_type": {"type": ["string", "null"], "minLength": 1, "maxLength": 1048576},
    "form13f_file_number": {"type": ["string", "null"], "minLength": 1, "maxLength": 1048576},
    "is_amendment": {"type": "boolean"},
    "amendment_number": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
    "amendment_type": {"type": ["string", "null"], "minLength": 1, "maxLength": 1048576},
    "amends_accession": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
    },
    "lineage_state": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "confidential_omitted": {"type": ["boolean", "null"]},
    "table_entry_total": {"type": ["integer", "null"], "minimum": 0},
    "table_value_total_usd": {"type": ["integer", "null"], "minimum": 0},
    "other_manager_count": {"type": ["integer", "null"], "minimum": 0},
    "source_receipt_id": {"type": "string", "pattern": "^i13fraw_[a-f0-9]{64}$"},
    "normalization_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 1048576},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "first_seen_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "retained_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "parser_version": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "quality_state": {"type": "string", "minLength": 1, "maxLength": 1048576}
  }
}
