{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_companyfacts_source_receipt.schema.json",
  "title": "Retained SEC Company Facts source receipt",
  "description": "Closed, hash-bound provenance for one externally retained SEC Company Facts snapshot. This is a source snapshot receipt, not a coverage assertion, collector result, share-count selector, or correction record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "source_system", "acquisition_state", "issuer_id",
    "source_url", "source_payload_sha256", "raw_object_locator",
    "manifest_locator", "source_retrieved_at", "system_available_at"
  ],
  "properties": {
    "schema": {"const": "capital_structure.companyfacts_source_receipt.v1"},
    "version": {"const": 1},
    "source_system": {"const": "sec_companyfacts"},
    "acquisition_state": {"const": "provided_snapshot"},
    "issuer_id": {"type": "string", "pattern": "^issuer:[0-9]{10}$"},
    "source_url": {"type": "string", "format": "uri"},
    "source_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_object_locator": {
      "type": "string",
      "pattern": "^capital_structure/sec/companyfacts/sha256/[a-f0-9]{2}/[a-f0-9]{64}$",
      "description": "Content-addressed retained raw-byte locator. The final digest must equal source_payload_sha256."
    },
    "manifest_locator": {
      "type": "string",
      "pattern": "^companyfacts-manifest:cs:[a-f0-9]{64}$",
      "description": "Durable manifest/ledger locator resolving the retained raw object without embedding a storage credential."
    },
    "source_retrieved_at": {"type": "string", "format": "date-time"},
    "system_available_at": {"type": "string", "format": "date-time"}
  }
}
