{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_share_count_ledger_receipt.schema.json",
  "title": "Capital Structure share-count ledger receipt",
  "description": "A closed immutable commit receipt binding the ordered canonical observation IDs and ordered source snapshot IDs at one append-only ledger generation. It is a self-contained integrity chain, not an external timestamp or durable non-repudiation witness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "ledger_receipt_id", "sequence", "predecessor_ledger_receipt_id",
    "committed_at", "observation_ids", "source_snapshot_ids"
  ],
  "properties": {
    "schema": {"const": "capital_structure.share_count_ledger_receipt.v1"},
    "ledger_receipt_id": {"type": "string", "pattern": "^share-count-ledger-receipt:cs:[a-f0-9]{24}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "predecessor_ledger_receipt_id": {
      "type": ["string", "null"],
      "pattern": "^share-count-ledger-receipt:cs:[a-f0-9]{24}$"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Nondecreasing logical chain clock. It may equal its predecessor for same-second commits or inherit the head clock for an older unrelated-issuer backfill; sequence, predecessor and ordered body provide commit identity."
    },
    "observation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^share-count:cs:[a-f0-9]{24}$"}
    },
    "source_snapshot_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^companyfacts-snapshot:cs:[a-f0-9]{24}$"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"predecessor_ledger_receipt_id": {"type": "null"}}},
      "else": {"properties": {"predecessor_ledger_receipt_id": {"type": "string"}}}
    }
  ]
}
