{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/government_revenue/government_budget_program_graph.v1.schema.json",
  "title": "Government Revenue DoD Budget Program Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schema_version", "content_id", "as_of", "known_at", "generated_at",
    "authority", "source_coverage", "documents", "lines", "programs", "edges", "limitations"
  ],
  "properties": {
    "contract": {"const": "government_budget_program_graph.v1"},
    "schema_version": {"const": "1.0.0"},
    "content_id": {"type": "string", "pattern": "^grbg1-[a-f0-9]{24}$"},
    "as_of": {"type": "string", "format": "date"},
    "known_at": {"type": ["string", "null"], "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authority": {"$ref": "#/$defs/authority"},
    "source_coverage": {"$ref": "#/$defs/sourceCoverage"},
    "documents": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/document"}},
    "lines": {
      "type": "array", "maxItems": 5000,
      "items": {"$ref": "https://mastermind-x.com/contracts/government_revenue/government_budget_line.v1.schema.json"}
    },
    "programs": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/program"}},
    "edges": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "https://mastermind-x.com/contracts/government_revenue/government_budget_edge.v1.schema.json"}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "context_only", "can_rank", "can_size", "can_gate", "can_originate_signal", "can_add_candidates", "can_escalate"],
      "properties": {
        "tier": {"const": "display"}, "context_only": {"const": true},
        "can_rank": {"const": false}, "can_size": {"const": false}, "can_gate": {"const": false},
        "can_originate_signal": {"const": false}, "can_add_candidates": {"const": false}, "can_escalate": {"const": false}
      }
    },
    "rail": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {"status": {"enum": ["ok", "partial", "uncollected", "failed"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}}
    },
    "sourceCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["president_budget_request", "authorization", "appropriation_enacted", "execution", "reviewed_award_edges"],
      "properties": {
        "president_budget_request": {"$ref": "#/$defs/rail"},
        "authorization": {"$ref": "#/$defs/rail"},
        "appropriation_enacted": {"$ref": "#/$defs/rail"},
        "execution": {"$ref": "#/$defs/rail"},
        "reviewed_award_edges": {"$ref": "#/$defs/rail"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": [
        "receipt_id", "fiscal_year", "exhibit", "source_url", "content_sha256", "page_count",
        "page_text_sha256s", "extraction_semantic_sha256", "extractor_version", "parser_version", "observed_at"
      ],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^dod-budget:[a-f0-9]{64}$"},
        "fiscal_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "exhibit": {"enum": ["p1", "r1"]},
        "source_url": {"type": "string", "format": "uri", "maxLength": 2000},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "page_text_sha256s": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "extraction_semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "extractor_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "parser_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["program_key", "kind", "native_identifier", "name", "line_keys"],
      "properties": {
        "program_key": {"type": "string", "pattern": "^dod-program:[a-z0-9:_-]{8,600}$"},
        "kind": {"enum": ["procurement_line_item", "rdte_program_element"]},
        "native_identifier": {"type": "string", "minLength": 1, "maxLength": 160},
        "name": {"type": "string", "minLength": 1, "maxLength": 1000},
        "line_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
