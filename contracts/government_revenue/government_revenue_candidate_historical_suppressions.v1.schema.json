{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/government_revenue/government_revenue_candidate_historical_suppressions.v1.schema.json",
  "title": "Government Revenue reviewed historical-candidate suppressions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "reviewed_at",
    "predecessor",
    "policy",
    "entries",
    "authority",
    "limitations"
  ],
  "properties": {
    "contract": {
      "const": "government_revenue.candidate_historical_suppressions.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_content_id", "projection_generated_at"],
      "properties": {
        "queue_content_id": {
          "type": "string",
          "pattern": "^grcq1-[a-f0-9]{24}$"
        },
        "projection_generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "policy": {
      "const": "exact_source_identity_only"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_family",
        "source_event_id",
        "source_record_id",
        "source_rail",
        "source_content_sha256",
        "observed_known_at",
        "decision",
        "reason_code"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^grc1-[a-f0-9]{24}$"
        },
        "candidate_family": {
          "enum": [
            "award_obligation_change",
            "award_ceiling_change",
            "option_exercise",
            "new_award"
          ]
        },
        "source_event_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 640
        },
        "source_rail": {
          "enum": [
            "usaspending_award_action",
            "usaspending_award_snapshot"
          ]
        },
        "source_content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_known_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "const": "do_not_backfill"
        },
        "reason_code": {
          "const": "pre_fix_candidate_became_visible_after_frozen_empty_projection"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "context_only",
        "can_rank",
        "can_size",
        "can_gate",
        "can_originate_signal",
        "can_add_candidates",
        "can_escalate"
      ],
      "properties": {
        "tier": {"const": "infrastructure"},
        "context_only": {"const": true},
        "can_rank": {"const": false},
        "can_size": {"const": false},
        "can_gate": {"const": false},
        "can_originate_signal": {"const": false},
        "can_add_candidates": {"const": false},
        "can_escalate": {"const": false}
      }
    }
  }
}
