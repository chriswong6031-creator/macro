{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/government_revenue/government_recipient_resolution.v1.schema.json",
  "title": "Government Recipient to Issuer Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "schema_version", "record_key", "source_identity_stable", "source_recipient",
    "event_effective_at", "record_known_at", "analysis_as_of",
    "resolution_state", "resolution_rule", "recipient_entity_id", "issuer",
    "ownership_path", "economic_share", "evidence_refs", "reason_codes", "authority"
  ],
  "properties": {
    "contract": {"const": "government_recipient_resolution.v1"},
    "schema_version": {"const": "1.0.0"},
    "record_key": {"type": "string", "minLength": 1},
    "source_identity_stable": {"type": "boolean"},
    "source_recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "external_ids"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "external_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "value"],
            "properties": {
              "namespace": {"enum": ["sam_uei", "cage", "usaspending_recipient_id"]},
              "value": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "event_effective_at": {"$ref": "#/$defs/nullableTemporal"},
    "record_known_at": {"$ref": "#/$defs/nullableTemporal"},
    "analysis_as_of": {"$ref": "#/$defs/nullableTemporal"},
    "resolution_state": {
      "enum": ["confirmed", "reviewed", "candidate_review", "unresolved", "rejected", "out_of_scope", "conflicted"]
    },
    "resolution_rule": {"enum": ["exact_uei", "exact_cage", "exact_source_id", "analyst_override", "none"]},
    "recipient_entity_id": {"type": ["string", "null"]},
    "issuer": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["company_id", "ticker"],
          "properties": {
            "company_id": {"type": "string", "minLength": 1},
            "ticker": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}
          }
        }
      ]
    },
    "ownership_path": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/ownershipEdge"}
    },
    "economic_share": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "nullableTemporal": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "ownershipEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id", "relationship", "child_entity_id", "parent_entity_id",
        "parent_company_id", "economic_share", "valid_from", "valid_to", "known_at", "evidence_refs"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1},
        "child_entity_id": {"type": "string", "minLength": 1},
        "parent_entity_id": {"type": ["string", "null"]},
        "parent_company_id": {"type": ["string", "null"]},
        "economic_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_to": {"$ref": "#/$defs/nullableTemporal"},
        "known_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "context_only", "can_rank", "can_size", "can_gate", "can_originate_signal", "can_add_candidates", "can_escalate"],
      "properties": {
        "tier": {"const": "display"},
        "context_only": {"const": true},
        "can_rank": {"const": false},
        "can_size": {"const": false},
        "can_gate": {"const": false},
        "can_originate_signal": {"const": false},
        "can_add_candidates": {"const": false},
        "can_escalate": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"resolution_state": {"enum": ["confirmed", "reviewed"]}},
        "required": ["resolution_state"]
      },
      "then": {
        "properties": {
          "source_identity_stable": {"const": true},
          "resolution_rule": {"enum": ["exact_uei", "exact_cage", "exact_source_id", "analyst_override"]},
          "event_effective_at": {"type": "string"},
          "record_known_at": {"type": "string"},
          "analysis_as_of": {"type": "string"},
          "recipient_entity_id": {"type": "string", "minLength": 1},
          "issuer": {"type": "object"},
          "ownership_path": {"minItems": 1},
          "economic_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "evidence_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"resolution_state": {"enum": ["unresolved", "rejected", "conflicted"]}},
        "required": ["resolution_state"]
      },
      "then": {
        "properties": {
          "issuer": {"type": "null"},
          "economic_share": {"type": "null"}
        }
      }
    }
  ]
}
