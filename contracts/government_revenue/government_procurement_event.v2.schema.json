{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/government_revenue/government_procurement_event.v2.schema.json",
  "title": "Government Procurement Workspace Event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "event_id", "record_id", "version", "kind", "state",
    "title_original", "title_zh", "translation_status", "agency", "change",
    "opportunity", "recompete", "award_change", "dates", "amounts",
    "primary_date_id", "primary_amount_id", "listed_company_impacts",
    "primary_ticker", "display_priority", "evidence", "authority"
  ],
  "properties": {
    "contract": {"const": "government_procurement_event.v2"},
    "event_id": {"type": "string", "pattern": "^gov(?:ws|opp|awd)-[a-zA-Z0-9_-]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["opportunity", "recompete", "award_change"]},
    "state": {"enum": ["open", "updated", "watch", "cancelled", "archived", "closed", "deleted", "inactive"]},
    "title_original": {"type": "string", "minLength": 1},
    "title_zh": {"type": ["string", "null"]},
    "translation_status": {"enum": ["original", "human", "machine", "unavailable"]},
    "agency": {"$ref": "#/$defs/agency"},
    "change": {"$ref": "#/$defs/change"},
    "opportunity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/opportunity"}]},
    "recompete": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/recompete"}]},
    "award_change": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/awardChange"}]},
    "dates": {"type": "array", "items": {"$ref": "#/$defs/dateFact"}},
    "amounts": {"type": "array", "items": {"$ref": "#/$defs/amountFact"}},
    "primary_date_id": {"type": ["string", "null"]},
    "primary_amount_id": {"type": ["string", "null"]},
    "listed_company_impacts": {"type": "array", "items": {"$ref": "#/$defs/companyImpact"}},
    "primary_ticker": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
    "display_priority": {"$ref": "#/$defs/displayPriority"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "opportunity"}}, "required": ["kind"]},
      "then": {"properties": {"opportunity": {"type": "object"}, "recompete": {"type": "null"}, "award_change": {"type": "null"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "recompete"}}, "required": ["kind"]},
      "then": {"properties": {"opportunity": {"type": "null"}, "recompete": {"type": "object"}, "award_change": {"type": "null"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "award_change"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "opportunity": {"type": "null"},
          "recompete": {"type": "null"},
          "award_change": {"$ref": "#/$defs/awardChange"},
          "evidence": {"properties": {"receipts": {"items": {"$ref": "#/$defs/awardReceipt"}}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "award_change"},
          "award_change": {
            "properties": {"observation_kind": {"const": "snapshot"}},
            "required": ["observation_kind"]
          }
        },
        "required": ["kind", "award_change"]
      },
      "then": {
        "properties": {
          "award_change": {
            "properties": {"source_rail": {"const": "usaspending_award_snapshot"}},
            "required": ["source_rail"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {"const": "award_change"},
          "award_change": {
            "properties": {"observation_kind": {"const": "action"}},
            "required": ["observation_kind"]
          }
        },
        "required": ["kind", "award_change"]
      },
      "then": {
        "properties": {
          "award_change": {
            "properties": {"source_rail": {"const": "usaspending_award_action"}},
            "required": ["source_rail"]
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableTemporal": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}]},
    "agency": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "department_id": {"type": ["string", "null"]},
        "department_name": {"type": ["string", "null"]},
        "subagency_id": {"type": ["string", "null"]},
        "subagency_name": {"type": ["string", "null"]},
        "office_id": {"type": ["string", "null"]},
        "office_name": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "subagency": {"type": ["string", "null"]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "context_only", "can_rank", "can_size", "can_gate", "can_originate_signal", "can_add_candidates", "can_escalate"],
      "properties": {
        "tier": {"const": "display"}, "context_only": {"const": true},
        "can_rank": {"const": false}, "can_size": {"const": false},
        "can_gate": {"const": false}, "can_originate_signal": {"const": false},
        "can_add_candidates": {"const": false}, "can_escalate": {"const": false}
      }
    },
    "changedField": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "before", "after", "semantic", "source_ref"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "before": {"$ref": "#/$defs/changeValue"},
        "after": {"$ref": "#/$defs/changeValue"},
        "semantic": {"enum": ["official", "observed_document_revision"]},
        "source_ref": {"type": ["string", "null"]},
        "before_source_ref": {"type": ["string", "null"]},
        "after_source_ref": {"type": ["string", "null"]},
        "before_receipt_ref": {"type": ["string", "null"]},
        "after_receipt_ref": {"type": ["string", "null"]}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "what_changed_en", "what_changed_zh", "summary_origin", "effective_at", "known_at", "first_seen_at", "last_seen_at", "is_correction", "changed_fields"],
      "properties": {
        "type": {"enum": [
          "new_notice", "amendment", "deadline_changed", "document_changed", "value_changed", "status_changed", "notice_matched", "recompete_watch_entered", "contract_extended", "cancelled", "corrected",
          "new_award", "award_discovered_late", "obligation", "deobligation", "current_value_changed", "ceiling_changed", "award_value_changed", "option_exercised", "period_extended", "period_shortened", "action_revised", "action_corrected", "action_retracted", "reported_obligation_balance_changed"
        ]},
        "what_changed_en": {"type": "string"}, "what_changed_zh": {"type": "string"},
        "summary_origin": {"enum": ["deterministic_template", "human", "model"]},
        "effective_at": {"$ref": "#/$defs/nullableTemporal"},
        "known_at": {"$ref": "#/$defs/nullableTemporal"},
        "first_seen_at": {"$ref": "#/$defs/nullableTemporal"},
        "last_seen_at": {"$ref": "#/$defs/nullableTemporal"},
        "is_correction": {"type": "boolean"},
        "changed_fields": {"type": "array", "items": {"$ref": "#/$defs/changedField"}}
      }
    },
    "changeScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "changeValue": {
      "oneOf": [
        {"$ref": "#/$defs/changeScalar"},
        {"type": "array", "maxItems": 40, "items": {"$ref": "#/$defs/changeScalar"}}
      ]
    },
    "placeOfPerformance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "city": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]},
        "zip": {"type": ["string", "null"]},
        "country": {"type": ["string", "null"]}
      }
    },
    "opportunity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "notice_id", "solicitation_number", "notice_type", "notice_stage",
        "source_status", "current_status", "current_notice_stage", "current_revision",
        "active", "current_state", "current_state_verified", "observation_horizon_at",
        "observation_age_minutes", "observation_basis", "current_state_reason",
        "posted_at", "updated_at", "response_deadline", "archive_at", "naics_codes",
        "psc_codes", "set_aside_code", "set_aside_label", "description_excerpt",
        "place_of_performance", "sam_url"
      ],
      "properties": {
        "notice_id": {"type": "string", "minLength": 1},
        "solicitation_number": {"type": ["string", "null"]},
        "notice_type": {"type": ["string", "null"]},
        "notice_stage": {"type": "string", "minLength": 1},
        "source_status": {"type": "string", "minLength": 1},
        "current_status": {"type": ["string", "null"]},
        "current_notice_stage": {"type": ["string", "null"]},
        "current_revision": {"type": "boolean"},
        "active": {"type": "boolean"},
        "current_state": {"type": "string", "minLength": 1},
        "current_state_verified": {"type": "boolean"},
        "observation_horizon_at": {"$ref": "#/$defs/nullableTemporal"},
        "observation_age_minutes": {"type": ["number", "null"], "minimum": 0},
        "observation_basis": {"type": ["string", "null"]},
        "current_state_reason": {"type": "string", "minLength": 1},
        "posted_at": {"$ref": "#/$defs/nullableTemporal"},
        "updated_at": {"$ref": "#/$defs/nullableTemporal"},
        "response_deadline": {"$ref": "#/$defs/nullableTemporal"},
        "archive_at": {"$ref": "#/$defs/nullableTemporal"},
        "naics_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "psc_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "set_aside_code": {"type": ["string", "null"]},
        "set_aside_label": {"type": ["string", "null"]},
        "description_excerpt": {"type": ["string", "null"]},
        "place_of_performance": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"},
            {"$ref": "#/$defs/placeOfPerformance"}
          ]
        },
        "sam_url": {"type": ["string", "null"], "pattern": "^https://(?:sam\\.gov|api\\.sam\\.gov)(?:/|$)"}
      }
    },
    "recompete": {
      "type": "object", "additionalProperties": false,
      "required": [
        "case_type", "generated_award_id", "piid", "incumbent_recipient_name",
        "incumbent_uei", "current_end_date", "potential_end_date", "days_to_current_end",
        "total_obligated", "current_award_amount", "potential_award_amount",
        "matched_notice_id", "basis_code", "watch_entered_at"
      ],
      "properties": {
        "case_type": {"const": "derived_expiry_watch"},
        "generated_award_id": {"type": ["string", "null"]},
        "piid": {"type": ["string", "null"]},
        "incumbent_recipient_name": {"type": ["string", "null"]},
        "incumbent_uei": {"type": ["string", "null"]},
        "current_end_date": {"$ref": "#/$defs/nullableTemporal"},
        "potential_end_date": {"$ref": "#/$defs/nullableTemporal"},
        "days_to_current_end": {"type": ["integer", "null"]},
        "total_obligated": {"type": ["number", "null"]},
        "current_award_amount": {"type": ["number", "null"]},
        "potential_award_amount": {"type": ["number", "null"]},
        "matched_notice_id": {"type": ["string", "null"]},
        "basis_code": {"const": "pop_end_30_540d"},
        "watch_entered_at": {"$ref": "#/$defs/nullableTemporal"}
      }
    },
    "awardChange": {
      "type": "object", "additionalProperties": false,
      "required": ["award_key", "event_type", "secondary_types", "source_rail", "source_identity", "observation_kind", "coverage_scope", "is_late_discovery"],
      "properties": {
        "award_key": {"type": "string", "minLength": 1},
        "generated_award_id": {"type": ["string", "null"]},
        "piid": {"type": ["string", "null"]},
        "recipient_name": {"type": ["string", "null"]},
        "event_type": {"enum": ["new_award", "award_discovered_late", "obligation", "deobligation", "current_value_changed", "ceiling_changed", "award_value_changed", "option_exercised", "period_extended", "period_shortened", "action_revised", "action_corrected", "action_retracted", "reported_obligation_balance_changed"]},
        "secondary_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_rail": {"enum": ["usaspending_award_snapshot", "usaspending_award_action"]},
        "source_identity": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "content_sha256"],
          "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "content_sha256": {"type": "string", "minLength": 1}}
        },
        "observation_kind": {"enum": ["snapshot", "action"]},
        "coverage_scope": {"type": "string", "minLength": 1},
        "is_late_discovery": {"type": "boolean"},
        "action_id": {"type": ["string", "null"]},
        "prior_source_identity": {"type": ["string", "null"]},
        "text_annotations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "dateFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label_code", "value", "semantic", "known_at", "source_ref"],
      "properties": {
        "id": {"type": "string"}, "label_code": {"type": "string"},
        "value": {"$ref": "#/$defs/nullableTemporal"}, "semantic": {"type": "string"},
        "known_at": {"$ref": "#/$defs/nullableTemporal"}, "source_ref": {"type": ["string", "null"]}
      }
    },
    "amountFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label_code", "value", "currency", "semantic", "as_of", "is_lower_bound", "source_ref"],
      "properties": {
        "id": {"type": "string"}, "label_code": {"type": "string"}, "value": {"type": "number"},
        "currency": {"const": "USD"}, "semantic": {"type": "string"}, "as_of": {"$ref": "#/$defs/nullableTemporal"},
        "is_lower_bound": {"type": "boolean"}, "source_ref": {"type": ["string", "null"]}
      }
    },
    "companyImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "relation_semantic", "confidence", "stance", "stance_scope", "materiality", "evidence_refs", "cross_desk_links"],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
        "company_name": {"type": ["string", "null"]},
        "issuer_company_id": {"type": ["string", "null"]},
        "legal_entity_id": {"type": ["string", "null"]},
        "legal_entity_name": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "relation_semantic": {"enum": ["official", "reviewed", "deterministic_inference", "model_estimate"]},
        "match_method": {"type": ["string", "null"]},
        "resolution_state": {"enum": ["confirmed", "reviewed", null]},
        "ownership_path": {"type": "array", "items": {"$ref": "#/$defs/ownershipEdge"}},
        "confidence": {"enum": ["high", "medium", "low", "unavailable"]},
        "stance": {"enum": ["act", "get_ready", "watch_dont_chase", "protect_gains", "stand_aside", "ignore"]},
        "stance_scope": {"const": "research"},
        "why_it_matters_en": {"type": ["string", "null"]},
        "why_it_matters_zh": {"type": ["string", "null"]},
        "watch_next_en": {"type": ["string", "null"]},
        "watch_next_zh": {"type": ["string", "null"]},
        "label_limit": {"type": ["string", "null"]},
        "materiality": {"$ref": "#/$defs/materiality"},
        "evidence_refs": {"type": "array", "items": {"type": ["string", "null"]}},
        "cross_desk_links": {"type": "array", "items": {"$ref": "#/$defs/crossDeskLink"}}
      }
    },
    "ownershipEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "evidence_refs"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "from_id": {"type": ["string", "null"]},
        "to_id": {"type": ["string", "null"]},
        "relation": {"type": ["string", "null"]},
        "relationship": {"enum": ["wholly_owned", "majority_owned", "partial_owned", "joint_venture", null]},
        "child_entity_id": {"type": ["string", "null"]},
        "parent_entity_id": {"type": ["string", "null"]},
        "parent_company_id": {"type": ["string", "null"]},
        "economic_share": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "valid_from": {"$ref": "#/$defs/nullableTemporal"},
        "valid_to": {"$ref": "#/$defs/nullableTemporal"},
        "effective_at": {"$ref": "#/$defs/nullableTemporal"},
        "known_at": {"$ref": "#/$defs/nullableTemporal"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "materiality": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "basis": {"type": ["string", "null"]},
        "basis_code": {"type": ["string", "null"]},
        "coverage_note": {"type": ["string", "null"]},
        "event_amount_usd": {"type": ["number", "null"]},
        "government_obligations_ttm_usd": {"type": ["number", "null"]},
        "numerator_value": {"type": ["number", "null"]},
        "denominator_value": {"type": ["number", "null"]},
        "ratio": {"type": ["number", "null"]},
        "ratio_pct": {"type": ["number", "null"]},
        "band": {"type": ["string", "null"]},
        "score": {"type": ["number", "null"]}
      }
    },
    "crossDeskLink": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "available": {"type": "boolean"},
        "contract": {"type": ["string", "null"]},
        "entity_id": {"type": ["string", "null"]},
        "entity_type": {"type": ["string", "null"]},
        "href": {"type": ["string", "null"]},
        "label_en": {"type": ["string", "null"]},
        "label_zh": {"type": ["string", "null"]},
        "surface_id": {"type": ["string", "null"]}
      }
    },
    "displayPriority": {
      "type": "object", "additionalProperties": false,
      "required": ["score", "new_information", "company_materiality", "evidence_quality", "formula_version", "is_investment_rank", "tie_breakers"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "new_information": {"type": "number", "minimum": 0, "maximum": 1},
        "company_materiality": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "formula_version": {"const": "govrev_display_priority.v1"},
        "is_investment_rank": {"const": false}, "tie_breakers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "awardReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["ref_id", "publisher", "record_id", "url", "effective_at", "known_at", "retrieved_at", "content_sha256"],
      "properties": {
        "ref_id": {"type": "string", "minLength": 1},
        "publisher": {"const": "USAspending.gov"},
        "record_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://(?:api\\.usaspending\\.gov|usaspending\\.gov)(?:/|$)"},
        "effective_at": {"type": "string", "format": "date-time"},
        "known_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["ref_id", "publisher", "record_id", "url", "effective_at", "known_at", "retrieved_at", "content_sha256"],
      "properties": {
        "ref_id": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]},
        "effective_at": {"$ref": "#/$defs/nullableTemporal"},
        "known_at": {"$ref": "#/$defs/nullableTemporal"},
        "retrieved_at": {"$ref": "#/$defs/nullableTemporal"},
        "content_sha256": {"type": ["string", "null"]}
      }
    },
    "derivation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ref_id": {"type": ["string", "null"]},
        "classification": {"type": ["string", "null"]},
        "formula_version": {"type": ["string", "null"]},
        "basis_refs": {"type": "array", "items": {"type": ["string", "null"]}},
        "known_at": {"$ref": "#/$defs/nullableTemporal"},
        "method": {"type": ["string", "null"]},
        "detail": {"type": ["string", "null"]}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "namespace": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]},
        "values": {"type": "array", "items": {"type": "string"}},
        "source_values": {"type": "array", "items": {"type": "string"}},
        "resolution_values": {"type": "array", "items": {"type": "string"}},
        "recipient_entity_ids": {"type": "array", "items": {"type": "string"}},
        "issuer_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_class", "mapping_class", "receipts", "derivations", "conflicts", "limitations"],
      "properties": {
        "source_class": {"enum": ["official_fact", "observed_source_revision"]},
        "mapping_class": {"enum": ["official", "reviewed", "deterministic_inference", "model_estimate", "unmapped"]},
        "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receipt"}},
        "derivations": {"type": "array", "items": {"$ref": "#/$defs/derivation"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
