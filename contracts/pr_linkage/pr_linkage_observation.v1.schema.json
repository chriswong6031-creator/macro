                      "path_class": {
                        "const": "UNKNOWN"
                      },
                      "allowed_authorities": {
                        "maxItems": 0
                      }
                    }
                  },
                  {
                    "properties": {
                      "resolution": {
                        "const": "AMBIGUOUS"
