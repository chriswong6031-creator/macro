{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mastermind.pr_linkage_observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ruleset_id",
    "ruleset_digest",
    "repository",
    "pull_request",
    "authoring_epoch",
    "changed_paths",
    "agentos",
    "linear",
    "path_ownership",
    "native_linkage",
    "receipt"
  ],
  "properties": {
    "schema": {
      "const": "mastermind.pr_linkage_observation.v1"
    },
    "ruleset_id": {
      "const": "mastermind.pr_linkage_rules.v1"
    },
    "ruleset_digest": {
      "$ref": "#/$defs/digest"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "pull_request": {
      "$ref": "#/$defs/pull_request"
    },
    "authoring_epoch": {
      "$ref": "#/$defs/epoch"
    },
    "changed_paths": {
      "$ref": "#/$defs/paths"
    },
    "agentos": {
      "$ref": "#/$defs/agentos"
    },
    "linear": {
      "$ref": "#/$defs/linear"
    },
    "path_ownership": {
      "$ref": "#/$defs/ownership"
    },
    "native_linkage": {
      "$ref": "#/$defs/native"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "body",
        "branch",
        "base_ref",
        "head_ref"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "head_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "relation",
        "default_ref",
        "cutover_merge_sha",
        "template_blobs",
        "first_strict_pr_number",
        "legacy_open_pr_numbers",
        "receipt_ruleset_digest",
        "cutover_receipt_sha256",
        "diagnostics"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "PARTIAL",
            "UNAVAILABLE",
            "CONTRADICTORY"
          ]
        },
        "relation": {
          "enum": [
            "PRE_CUTOVER",
            "AT_OR_POST_CUTOVER",
            "UNKNOWN"
          ]
        },
        "default_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "cutover_merge_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_blobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "blob_sha"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "blob_sha": {
                "$ref": "#/$defs/sha"
              }
            }
          }
        },
        "first_strict_pr_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "legacy_open_pr_numbers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "receipt_ruleset_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "cutover_receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "paths",
        "diagnostics"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE",
            "CONTRADICTORY"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "change_type",
              "old_path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "change_type": {
                "enum": [
                  "ADDED",
                  "MODIFIED",
                  "DELETED",
                  "RENAMED"
                ]
              },
              "old_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    "agentos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis",
        "workstreams",
        "diagnostics"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE",
            "CONTRADICTORY"
          ]
        },
        "basis": {
          "const": "BASE"
        },
        "workstreams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "waves"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "waves": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    "linear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "issues",
        "diagnostics"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE",
            "CONTRADICTORY"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "target_role",
              "project_id",
              "workstream_key",
              "issue_type",
              "stop_law"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "target_role": {
                "enum": [
                  "DECLARED",
                  "SECONDARY",
                  "PARENT",
                  "PROOF_GATE",
                  "ACCEPTANCE_GATE",
                  "UNKNOWN"
                ]
              },
              "project_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "workstream_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "issue_type": {
                "type": "string"
              },
              "stop_law": {
                "type": "string"
              }
            }
          }
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis",
        "resolutions",
        "diagnostics"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE",
            "CONTRADICTORY"
          ]
        },
        "basis": {
          "const": "BASE_POLICY"
        },
        "resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "resolution",
              "owner_workstream",
              "path_class",
              "allowed_authorities"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "CURRENT",
                  "OLD_RENAME_SOURCE"
                ]
              },
              "resolution": {
                "enum": [
                  "EXACT",
                  "UNOWNED",
                  "AMBIGUOUS"
                ]
              },
              "owner_workstream": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_class": {
                "type": "string"
              },
              "allowed_authorities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "pagination_complete",
        "relationships",
        "diagnostics"
      ],
      "properties": {
        "state": {
          "enum": [
            "PRESENT",
            "PARTIAL",
            "UNAVAILABLE",
            "NOT_APPLICABLE",
            "CONTRADICTORY"
          ]
        },
        "pagination_complete": {
          "type": "boolean"
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue_id",
              "kind",
              "source",
              "state",
              "completion_transition"
            ],
            "properties": {
              "issue_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "completion_transition": {
                "type": "string"
              }
            }
          }
        },
        "diagnostics": {
          "$ref": "#/$defs/diagnostics"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pr_number",
        "base_sha",
        "head_sha",
        "source_sha",
        "body_sha256",
        "observation_sha256",
        "cutover_receipt_sha256",
        "ruleset_digest",
        "snapshot_digests",
        "producer"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "$ref": "#/$defs/sha"
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "source_sha": {
          "$ref": "#/$defs/sha"
        },
        "body_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observation_sha256": {
          "$ref": "#/$defs/digest"
        },
        "cutover_receipt_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "ruleset_digest": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoring_epoch",
            "changed_paths",
            "agentos",
            "linear",
            "path_ownership",
            "native_linkage"
          ],
          "properties": {
            "authoring_epoch": {
              "$ref": "#/$defs/digest"
            },
            "changed_paths": {
              "$ref": "#/$defs/digest"
            },
            "agentos": {
              "$ref": "#/$defs/digest"
            },
            "linear": {
              "$ref": "#/$defs/digest"
            },
            "path_ownership": {
              "$ref": "#/$defs/digest"
            },
            "native_linkage": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "producer": {
          "type": "string"
        }
      }
    }
  }
}
