{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/drugs_at_fda_table_manifest.v1.schema.json",
  "title": "BioCatalyst Drugs at FDA table manifest v1", "type": "object", "additionalProperties": false,
  "required": ["contract_id", "schema_version", "table_manifest_id", "release_id", "archive_sha256", "table_name", "member_sha256", "compressed_byte_count", "uncompressed_byte_count", "zip_crc32", "row_count", "header", "primary_key_fields", "encoding", "field_count_profile", "ordered_row_digest_sha256", "typed_row_semantic_digest_sha256", "row_shape_repairs", "parser_version", "manifest_payload_sha256", "hash_scope"],
  "properties": {"contract_id": {"const": "drugs_at_fda_table_manifest.v1"}, "schema_version": {"const": "1.0.0"}, "table_manifest_id": {"type": "string", "pattern": "^drugs_at_fda_table_[a-f0-9]{24}$"}, "release_id": {"type": "string", "pattern": "^drugs_at_fda_release_[a-f0-9]{24}$"}, "archive_sha256": {"$ref": "#/$defs/sha256"}, "table_name": {"type": "string", "pattern": "^[A-Za-z_]+\\.txt$"}, "member_sha256": {"$ref": "#/$defs/sha256"}, "compressed_byte_count": {"type": "integer", "minimum": 1}, "uncompressed_byte_count": {"type": "integer", "minimum": 1}, "zip_crc32": {"type": "string", "pattern": "^[a-f0-9]{8}$"}, "row_count": {"type": "integer", "minimum": 0}, "header": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "primary_key_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "encoding": {"const": "cp1252"}, "field_count_profile": {"type": "object", "minProperties": 1, "patternProperties": {"^[0-9]+$": {"type": "integer", "minimum": 0}}, "additionalProperties": false}, "ordered_row_digest_sha256": {"$ref": "#/$defs/sha256"}, "typed_row_semantic_digest_sha256": {"$ref": "#/$defs/sha256"}, "row_shape_repairs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["rule", "row_number", "raw_row_sha256", "expected_field_count", "observed_field_count"], "properties": {"rule": {"const": "application_docs_empty_field_before_date"}, "row_number": {"type": "integer", "minimum": 2}, "raw_row_sha256": {"$ref": "#/$defs/sha256"}, "expected_field_count": {"type": "integer", "minimum": 1}, "observed_field_count": {"type": "integer", "minimum": 1}}}}, "parser_version": {"const": "drugs_at_fda_zip_parser.v1"}, "manifest_payload_sha256": {"$ref": "#/$defs/sha256"}, "hash_scope": {"const": "canonical_payload_excluding_manifest_payload_sha256"}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
