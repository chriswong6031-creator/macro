{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/discovery_run.v1.schema.json",
  "title": "BioCatalyst ClinicalTrials.gov Discovery Reconciliation Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "schema_version", "run_id", "source_id", "scope", "scope_ref",
    "scope_payload_sha256", "selection_window", "source_cut", "pages",
    "deduplicated_records", "counts", "run_state", "reconciliation_state",
    "quarantine_codes", "coverage_claim", "started_at", "finished_at",
    "transaction_from", "transaction_to", "hash_scope", "run_payload_sha256"
  ],
  "properties": {
    "contract_id": {"const": "ctgov_discovery_run.v1"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^ctgov_discovery_run_[A-Za-z0-9_-]{1,96}$"},
    "source_id": {"const": "clinicaltrials_gov_v2"},
    "scope": {"$ref": "https://mastermind-x.com/contracts/biocatalyst/discovery_scope.v1.schema.json"},
    "scope_ref": {"type": "string", "pattern": "^ctgov_discovery_scope_[a-f0-9]{24}$"},
    "scope_payload_sha256": {"$ref": "#/$defs/sha256"},
    "selection_window": {"$ref": "#/$defs/selectionWindow"},
    "source_cut": {"$ref": "#/$defs/sourceCut"},
    "pages": {
      "type": "array", "maxItems": 2048,
      "items": {"$ref": "#/$defs/page"}
    },
    "deduplicated_records": {
      "type": "array", "maxItems": 200000,
      "items": {"$ref": "#/$defs/record"}
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["pages", "records_returned", "records_unique", "records_duplicates", "declared_total_count"],
      "properties": {
        "pages": {"type": "integer", "minimum": 0, "maximum": 2048},
        "records_returned": {"type": "integer", "minimum": 0, "maximum": 200000},
        "records_unique": {"type": "integer", "minimum": 0, "maximum": 200000},
        "records_duplicates": {"type": "integer", "minimum": 0, "maximum": 200000},
        "declared_total_count": {"type": "integer", "minimum": 0, "maximum": 200000}
      }
    },
    "run_state": {"type": "string", "enum": ["complete", "quarantined"]},
    "reconciliation_state": {
      "type": "string",
      "enum": [
        "reconciled", "page_chain_invalid", "total_count_mismatch",
        "source_version_race", "source_version_incomplete", "duplicate_content_ambiguity", "scope_selection_violation", "time_chain_invalid"
      ]
    },
    "quarantine_codes": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "DISCOVERY_PAGE_CHAIN_INVALID", "DISCOVERY_TOTAL_COUNT_MISMATCH",
          "DISCOVERY_SOURCE_VERSION_RACE", "DISCOVERY_SOURCE_VERSION_INCOMPLETE", "DISCOVERY_DUPLICATE_CONTENT_AMBIGUITY",
          "DISCOVERY_SCOPE_SELECTION_VIOLATION", "DISCOVERY_TIME_CHAIN_INVALID"
        ]
      }
    },
    "coverage_claim": {"const": "complete_only_for_this_declared_source_query_when_reconciled"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "transaction_from": {"type": "string", "format": "date-time"},
    "transaction_to": {"type": ["string", "null"], "format": "date-time"},
    "hash_scope": {"const": "canonical_payload_excluding_run_payload_sha256"},
    "run_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "sourceDataTimestamp": {"type": "string", "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
    "selectionWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "start_date", "end_date", "query_expression"],
      "properties": {
        "field": {"const": "LastUpdatePostDate"},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "query_expression": {"type": "string", "pattern": "^AREA\\[LastUpdatePostDate\\]RANGE\\[[0-9]{4}-[0-9]{2}-[0-9]{2},[0-9]{4}-[0-9]{2}-[0-9]{2}\\]$"}
      }
    },
    "sourceCut": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dataset_timestamp_before_raw", "dataset_timestamp_after_raw",
        "api_version_before", "api_version_after", "version_before_retrieved_at",
        "version_after_retrieved_at", "first_page_receipt_retrieved_at",
        "terminal_page_receipt_retrieved_at"
      ],
      "properties": {
        "dataset_timestamp_before_raw": {"type": ["string", "null"], "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
        "dataset_timestamp_after_raw": {"type": ["string", "null"], "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
        "api_version_before": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "api_version_after": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "version_before_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "version_after_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "first_page_receipt_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "terminal_page_receipt_retrieved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": [
        "page_ordinal", "response_sha256", "byte_count", "received_at",
        "request_page_token_sha256", "next_page_token_sha256", "total_count", "records"
      ],
      "properties": {
        "page_ordinal": {"type": "integer", "minimum": 0, "maximum": 2047},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "byte_count": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "received_at": {"type": "string", "format": "date-time"},
        "request_page_token_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "next_page_token_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "total_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 200000},
        "records": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/record"}}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["nct_id", "canonical_content_sha256", "last_update_posted_date"],
      "properties": {
        "nct_id": {"$ref": "#/$defs/nctId"},
        "canonical_content_sha256": {"$ref": "#/$defs/sha256"},
        "last_update_posted_date": {"type": "string", "format": "date"}
      }
    }
  }
}
