{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/trial_screen_read_model.v1.schema.json",
  "title": "BioCatalyst Trial Screen Read Model v1",
  "description": "A bounded, current-only ClinicalTrials.gov source-fact screen. It applies literal AND filters and carries no scoring, identity resolution, forecast, alert, or decision authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "schema_version", "as_of", "query", "source", "coverage",
    "sort_order", "pagination", "row_count", "rows", "authority", "capacity"
  ],
  "properties": {
    "contract_id": {"const": "trial_screen_read_model.v1"},
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "format": "date-time"},
    "query": {"$ref": "#/$defs/query"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "dataset_timestamp_raw"],
      "properties": {
        "name": {"const": "ClinicalTrials.gov"},
        "dataset_timestamp_raw": {"$ref": "#/$defs/sourceDataTimestamp"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "configured", "observed", "matched"],
      "properties": {
        "class": {"const": "current_only"},
        "configured": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "observed": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "matched": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "sort_order": {"const": "primary_completion_interval_ascending_then_nct_id"},
    "pagination": {
      "type": "object", "additionalProperties": false,
      "required": ["limit", "offset", "total", "returned", "next_cursor"],
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 250},
        "offset": {"type": "integer", "minimum": 0, "maximum": 10000},
        "total": {"type": "integer", "minimum": 0, "maximum": 10000},
        "returned": {"type": "integer", "minimum": 0, "maximum": 250},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 384}
      }
    },
    "row_count": {"type": "integer", "minimum": 0, "maximum": 250},
    "rows": {"type": "array", "maxItems": 250, "items": {"$ref": "#/$defs/row"}},
    "authority": {"$ref": "#/$defs/authority"},
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_snapshots", "max_page_limit", "max_sanitized_row_bytes", "max_sanitized_scan_bytes", "max_response_bytes", "overflow_behavior"],
      "properties": {
        "max_input_snapshots": {"const": 10000},
        "max_page_limit": {"const": 250},
        "max_sanitized_row_bytes": {"const": 131072},
        "max_sanitized_scan_bytes": {"const": 33554432},
        "max_response_bytes": {"const": 1048576},
        "overflow_behavior": {"const": "reject_no_partial_screen"}
      }
    }
  },
  "$defs": {
    "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceDataTimestamp": {"type": "string", "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
    "nullableTemporal": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}]},
    "state": {"enum": ["observed", "source_null", "source_missing", "not_applicable", "parser_degraded", "license_restricted"]},
    "queryText": {"type": ["string", "null"], "maxLength": 240},
    "queryDate": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sponsor", "condition", "intervention", "phase", "status", "study_type",
        "primary_completion_from", "primary_completion_to", "filter_composition",
        "lexical_matching", "exact_matching", "primary_completion_matching"
      ],
      "properties": {
        "sponsor": {"$ref": "#/$defs/queryText"},
        "condition": {"$ref": "#/$defs/queryText"},
        "intervention": {"$ref": "#/$defs/queryText"},
        "phase": {"$ref": "#/$defs/queryText"},
        "status": {"$ref": "#/$defs/queryText"},
        "study_type": {"$ref": "#/$defs/queryText"},
        "primary_completion_from": {"$ref": "#/$defs/queryDate"},
        "primary_completion_to": {"$ref": "#/$defs/queryDate"},
        "filter_composition": {"const": "literal_and"},
        "lexical_matching": {"const": "sponsor_condition_intervention_name_or_other_names_normalized_substring"},
        "exact_matching": {"const": "phase_status_study_type_normalized_exact"},
        "primary_completion_matching": {"const": "full_interval_containment"}
      }
    },
    "stringFact": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "value": {"type": ["string", "null"], "maxLength": 2000}},
      "allOf": [{"if": {"properties": {"state": {"const": "observed"}}}, "then": {"properties": {"value": {"type": "string"}}}, "else": {"properties": {"value": {"type": "null"}}}}]
    },
    "stringArrayFact": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "values"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "values": {"type": ["array", "null"], "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}},
      "allOf": [{"if": {"properties": {"state": {"const": "observed"}}}, "then": {"properties": {"values": {"type": "array"}}}, "else": {"properties": {"values": {"type": "null"}}}}]
    },
    "sponsorFact": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "value": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["name", "class"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 2000}, "class": {"type": ["string", "null"], "maxLength": 200}}}]}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "observed"}}}, "then": {"properties": {"value": {"type": "object"}}}, "else": {"properties": {"value": {"type": "null"}}}}]
    },
    "enrollmentFact": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "value": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["count", "type"], "properties": {"count": {"type": "integer", "minimum": 0, "maximum": 100000000}, "type": {"enum": ["ACTUAL", "ESTIMATED", "UNKNOWN", null]}}}]}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "observed"}}}, "then": {"properties": {"value": {"type": "object"}}}, "else": {"properties": {"value": {"type": "null"}}}}]
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "aliases", "type"],
      "properties": {"name": {"type": ["string", "null"], "maxLength": 2000}, "aliases": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}, "type": {"type": ["string", "null"], "maxLength": 80}}
    },
    "interventionsFact": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "values"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "values": {"type": ["array", "null"], "maxItems": 128, "items": {"$ref": "#/$defs/intervention"}}},
      "allOf": [{"if": {"properties": {"state": {"const": "observed"}}}, "then": {"properties": {"values": {"type": "array"}}}, "else": {"properties": {"values": {"type": "null"}}}}]
    },
    "primaryCompletionFact": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "literal", "precision", "interval", "type"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "literal": {"type": ["string", "null"], "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
        "precision": {"enum": ["year", "month", "day", null]},
        "interval": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}}]},
        "type": {"enum": ["ACTUAL", "ESTIMATED", "UNKNOWN", null]}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "observed"}}}, "then": {"properties": {"literal": {"type": "string"}, "precision": {"type": "string"}, "interval": {"type": "object"}}}, "else": {"properties": {"literal": {"type": "null"}, "precision": {"const": null}, "interval": {"type": "null"}, "type": {"const": null}}}}]
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["nct_id", "brief_title", "official_title", "overall_status", "study_type", "phases", "sponsor", "enrollment", "conditions", "interventions", "primary_completion", "source"],
      "properties": {
        "nct_id": {"$ref": "#/$defs/nctId"},
        "brief_title": {"$ref": "#/$defs/stringFact"},
        "official_title": {"$ref": "#/$defs/stringFact"},
        "overall_status": {"$ref": "#/$defs/stringFact"},
        "study_type": {"$ref": "#/$defs/stringFact"},
        "phases": {"$ref": "#/$defs/stringArrayFact"},
        "sponsor": {"$ref": "#/$defs/sponsorFact"},
        "enrollment": {"$ref": "#/$defs/enrollmentFact"},
        "conditions": {"$ref": "#/$defs/stringArrayFact"},
        "interventions": {"$ref": "#/$defs/interventionsFact"},
        "primary_completion": {"$ref": "#/$defs/primaryCompletionFact"},
        "source": {"type": "object", "additionalProperties": false, "required": ["url", "last_update_posted_at", "retrieved_at"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://clinicaltrials\\.gov/study/NCT[0-9]{8}$"}, "last_update_posted_at": {"$ref": "#/$defs/nullableTemporal"}, "retrieved_at": {"type": "string", "format": "date-time"}}}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "decision_authority", "maximum_authority", "allowed_uses", "forbidden_uses"],
      "properties": {
        "classification": {"const": "source_fact_screen"},
        "decision_authority": {"const": false},
        "maximum_authority": {"const": "A1_EXPLAIN"},
        "allowed_uses": {"const": ["display", "context", "explain"]},
        "forbidden_uses": {"const": ["originate_signal", "issuer_resolution", "security_resolution", "sponsor_resolution", "trial_resolution", "rank_security", "select_security", "size_position", "gate_decision", "execute_trade", "neural_web_authority", "all_prophet_uses", "forecast_outcome", "assess_materiality", "deliver_alert", "raise_authority"]}
      }
    }
  }
}
