{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/trial_source_snapshot.v1.schema.json",
  "title": "BioCatalyst ClinicalTrials.gov Source Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "schema_version", "source_snapshot_id", "nct_id", "source_id",
    "source_record_ref", "run_ref", "page_receipt_ref", "source_page_study_index", "source_uri", "raw_object_key", "exact_response_sha256",
    "canonical_content_sha256", "hash_scope", "object_key_policy", "array_order_policy",
    "canonicalizer_version", "source_schema_version", "license_class", "rights_note",
    "canonical_study", "source_dataset_timestamp_raw", "source_last_update_posted_at",
    "source_published_at", "source_effective_at", "retrieved_at", "first_seen_at",
    "valid_from", "valid_to", "coverage_class", "transaction_from", "transaction_to"
  ],
  "properties": {
    "contract_id": {"const": "trial_source_snapshot.v1"},
    "schema_version": {"const": "1.0.0"},
    "source_snapshot_id": {"type": "string", "pattern": "^ctgov_snapshot_[a-zA-Z0-9_-]+$"},
    "nct_id": {"$ref": "#/$defs/nctId"},
    "source_id": {"const": "clinicaltrials_gov_v2"},
    "source_record_ref": {"type": "string", "pattern": "^src:ctgov:NCT[0-9]{8}:sha256:[a-f0-9]{64}$"},
    "run_ref": {"type": "string", "pattern": "^ctgov_run_[a-zA-Z0-9_-]+$"},
    "page_receipt_ref": {"type": "string", "pattern": "^ctgov_receipt_[a-zA-Z0-9_-]+$"},
    "source_page_study_index": {"type": "integer", "minimum": 0},
    "source_uri": {"type": "string", "format": "uri", "pattern": "^https://clinicaltrials\\.gov/study/NCT[0-9]{8}$"},
    "raw_object_key": {"type": "string", "pattern": "^biocatalyst/raw/clinicaltrials/v2/NCT[0-9]{8}/[a-f0-9]{64}\\.json$"},
    "exact_response_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_content_sha256": {"$ref": "#/$defs/sha256"},
    "hash_scope": {"const": "canonical_json_entire_study"},
    "object_key_policy": {"const": "sort_lexicographically"},
    "array_order_policy": {"const": "preserve_source_order"},
    "canonicalizer_version": {"const": "canonical_json.v1"},
    "source_schema_version": {"const": "ctgov_api_v2"},
    "license_class": {"const": "us_government_source_facts"},
    "rights_note": {"type": "string", "minLength": 1},
    "canonical_study": {"$ref": "#/$defs/jsonObject"},
    "source_dataset_timestamp_raw": {"$ref": "#/$defs/sourceDataTimestamp"},
    "source_last_update_posted_at": {"$ref": "#/$defs/nullableTemporal"},
    "source_published_at": {"$ref": "#/$defs/nullableTemporal"},
    "source_effective_at": {"$ref": "#/$defs/nullableTemporal"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "valid_from": {"$ref": "#/$defs/nullableTemporal"},
    "valid_to": {"$ref": "#/$defs/nullableTemporal"},
    "coverage_class": {"const": "current_only"},
    "transaction_from": {"type": "string", "format": "date-time"},
    "transaction_to": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceDataTimestamp": {"type": "string", "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
    "nullableTemporal": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date"}, {"type": "string", "format": "date-time"}]},
    "jsonValue": {"oneOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}}, {"$ref": "#/$defs/jsonObject"}]},
    "jsonObject": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
  }
}
