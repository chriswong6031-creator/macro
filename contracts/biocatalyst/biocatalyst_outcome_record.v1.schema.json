{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/biocatalyst_outcome_record.v1.schema.json",
  "title": "BioCatalyst Outcome Record v1 (BC-O1b writer contract)",
  "description": "One outcome observation in the BC-O1b ledger, carried as the payload of an outcome_observation operational record. This is the writer contract the M0a family policy names: it carries the frozen outcome envelope, the known-at clock (effective_at <= known_at <= observed_at), and an explicit censoring state, so a missing outcome is never read as a negative one. The value is the source-native status only; no model may originate or resolve it. A correction is a NEW record naming its predecessor through revision_of.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "outcome_id", "family_id", "subject_ref", "seed_layer", "value", "value_authority", "censoring_state", "terminality", "effective_at", "known_at", "observed_at", "evidence_refs", "policy_version", "resolver_type", "revision_of"],
  "properties": {
    "contract_id": {"const": "biocatalyst_outcome_record.v1"},
    "schema_version": {"const": "1.0.0"},
    "outcome_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,95}$"},
    "family_id": {"$ref": "#/$defs/family_id"},
    "subject_ref": {"$ref": "#/$defs/internal_subject_ref"},
    "seed_layer": {"enum": ["study_conduct", "endpoint_result", "regulatory_disposition", "asset_program_state", "not_in_seed_policy"]},
    "value": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "value_authority": {"const": "source_native_status_only"},
    "censoring_state": {
      "enum": [
        "right_censored_open_window",
        "administratively_censored_at_policy_freeze",
        "interval_censored_between_snapshots",
        "not_censored_terminal_event"
      ]
    },
    "terminality": {"enum": ["terminal", "non_terminal"]},
    "effective_at": {"$ref": "#/$defs/utc_timestamp"},
    "known_at": {"$ref": "#/$defs/utc_timestamp"},
    "observed_at": {"$ref": "#/$defs/utc_timestamp"},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/internal_subject_ref"}},
    "policy_version": {"type": "string", "pattern": "^m0a\\.[0-9]{1,4}$"},
    "resolver_type": {"const": "deterministic_source_statement"},
    "revision_of": {"oneOf": [{"$ref": "#/$defs/record_id"}, {"type": "null"}]}
  },
  "$defs": {
    "record_id": {"type": "string", "pattern": "^bcop_[a-f0-9]{32}$"},
    "utc_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "internal_subject_ref": {"type": "string", "pattern": "^(?:nct:NCT[0-9]{8}|internal:[a-z0-9_.-]{1,64})$"},
    "family_id": {
      "enum": [
        "trial_progression_termination",
        "endpoint_readout",
        "timing_slip",
        "enrollment_site_change",
        "regulatory_outcome",
        "financing_dilution_event",
        "partnership_event",
        "market_reaction",
        "forecast_calibration"
      ]
    }
  }
}
