{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/ctgov_history_run.v1.schema.json",
  "title": "BioCatalyst ClinicalTrials.gov Record History Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "run_id", "source_id", "nct_id", "history_index_receipt_ref", "history_index_post_receipt_ref", "version_manifest", "history_version_receipt_refs", "started_at", "finished_at", "run_state", "completeness_state", "parser_version", "error_codes", "transaction_from", "transaction_to", "run_payload_sha256", "hash_scope"],
  "properties": {
    "contract_id": {"const": "ctgov_history_run.v1"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^ctgov_history_run_[A-Za-z0-9_-]+$"},
    "source_id": {"const": "clinicaltrials_gov_record_history"},
    "nct_id": {"$ref": "#/$defs/nctId"},
    "history_index_receipt_ref": {"type": "string", "pattern": "^ctgov_history_receipt_[A-Za-z0-9_-]+$"},
    "history_index_post_receipt_ref": {"type": "string", "pattern": "^ctgov_history_receipt_[A-Za-z0-9_-]+$"},
    "version_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionManifest"}},
    "history_version_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ctgov_history_receipt_[A-Za-z0-9_-]+$"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "run_state": {"type": "string", "enum": ["started", "complete", "partial", "quarantined", "failed"]},
    "completeness_state": {"type": "string", "enum": ["not_evaluated", "history_complete", "history_incomplete", "source_invariant_failed", "source_schema_drift"]},
    "parser_version": {"const": "clinicaltrials_record_history_parser.v1"},
    "error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "transaction_from": {"type": "string", "format": "date-time"},
    "transaction_to": {"type": ["string", "null"], "format": "date-time"},
    "run_payload_sha256": {"$ref": "#/$defs/sha256"},
    "hash_scope": {"const": "canonical_payload_excluding_run_payload_sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "versionManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["source_version", "display_version", "source_submitted_at", "source_last_update_submit_qc_at", "module_labels"],
      "properties": {
        "source_version": {"type": "integer", "minimum": 0},
        "display_version": {"type": "integer", "minimum": 1},
        "source_submitted_at": {"type": "string", "format": "date"},
        "source_last_update_submit_qc_at": {"type": ["string", "null"], "format": "date"},
        "module_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
