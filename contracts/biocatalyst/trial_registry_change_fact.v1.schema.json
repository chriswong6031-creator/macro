{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/trial_registry_change_fact.v1.schema.json",
  "title": "BioCatalyst Historical Trial Registry Change Fact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "change_fact_id", "nct_id", "diff_ref", "before_source_snapshot_ref", "after_source_snapshot_ref", "before_source_version", "after_source_version", "kind", "source_json_paths", "before_value", "after_value", "semantic_method", "interpretation", "source_fact", "current_only", "coverage_class", "protocol_change_asserted", "materiality_assessed", "authority", "transaction_from", "transaction_to", "fact_payload_sha256", "hash_scope"],
  "properties": {
    "contract_id": {"const": "trial_registry_change_fact.v1"}, "schema_version": {"const": "1.0.0"},
    "change_fact_id": {"type": "string", "pattern": "^trial_registry_change_[A-Za-z0-9_-]+$"}, "nct_id": {"$ref": "#/$defs/nctId"},
    "diff_ref": {"type": "string", "pattern": "^trial_history_diff_[A-Za-z0-9_-]+$"}, "before_source_snapshot_ref": {"type": "string", "pattern": "^ctgov_history_snapshot_[A-Za-z0-9_-]+$"}, "after_source_snapshot_ref": {"type": "string", "pattern": "^ctgov_history_snapshot_[A-Za-z0-9_-]+$"},
    "before_source_version": {"type": "integer", "minimum": 0}, "after_source_version": {"type": "integer", "minimum": 1},
    "kind": {"type": "string", "enum": ["endpoint_added", "endpoint_removed", "endpoint_role_changed", "endpoint_measure_changed", "endpoint_time_frame_changed", "endpoint_description_changed", "enrollment_changed", "registry_status_changed", "study_date_changed", "site_listing_changed", "lead_sponsor_text_changed", "intervention_added", "intervention_removed", "intervention_changed"]},
    "source_json_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}, "before_value": {"$ref": "#/$defs/jsonValue"}, "after_value": {"$ref": "#/$defs/jsonValue"},
    "semantic_method": {"const": "deterministic_registry_field_delta.v1"}, "interpretation": {"const": "registry_record_changed"}, "source_fact": {"const": true}, "current_only": {"const": false}, "coverage_class": {"const": "record_history_complete"}, "protocol_change_asserted": {"const": false}, "materiality_assessed": {"const": false}, "authority": {"$ref": "#/$defs/authority"},
    "transaction_from": {"type": "string", "format": "date-time"}, "transaction_to": {"type": ["string", "null"], "format": "date-time"}, "fact_payload_sha256": {"$ref": "#/$defs/sha256"}, "hash_scope": {"const": "canonical_payload_excluding_fact_payload_sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "jsonValue": {"oneOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}]},
    "authority": {"type": "object", "additionalProperties": false, "required": ["classification", "decision_authority", "allowed_uses", "forbidden_uses"], "properties": {"classification": {"const": "source_fact"}, "decision_authority": {"const": false}, "allowed_uses": {"const": ["display", "context", "explain"]}, "forbidden_uses": {"const": ["originate_signal", "rank_security", "select_security", "size_position", "gate_decision", "execute_trade", "raise_authority"]}}}
  }
}
