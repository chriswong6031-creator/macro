{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://mastermind-x.com/contracts/biocatalyst/fda_regulatory_event.v1.schema.json", "title": "FDA native regulatory event v1", "type": "object", "additionalProperties": false,
  "required": ["contract_id", "schema_version", "regulatory_event_id", "event_kind", "submission_action_join_id", "application_number", "submission_observation_id", "action_type_lookup_id", "action_type_description_source_text", "source_native_orphan", "event_date_source_text", "coverage_class", "current_vs_historical", "source_evidence", "authority", "event_payload_sha256", "hash_scope"],
  "properties": {"contract_id": {"const": "fda_regulatory_event.v1"}, "schema_version": {"const": "1.0.0"}, "regulatory_event_id": {"type": "string", "pattern": "^fda_submission_action_[a-f0-9]{24}$"}, "event_kind": {"const": "submission_action_type_observation"}, "submission_action_join_id": {"type": "string", "pattern": "^[0-9]+$"}, "application_number": {"type": "string", "pattern": "^[0-9]{6}$"}, "submission_observation_id": {"type": ["string", "null"], "pattern": "^fda_submission_[a-f0-9]{24}$"}, "action_type_lookup_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"}, "action_type_description_source_text": {"type": ["string", "null"]}, "source_native_orphan": {"type": "boolean"}, "event_date_source_text": {"const": null}, "coverage_class": {"const": "fda_cder_approved_product_release"}, "current_vs_historical": {"const": "source_release_snapshot_only"}, "source_evidence": {"$ref": "#/$defs/evidence"}, "authority": {"$ref": "#/$defs/authority"}, "event_payload_sha256": {"$ref": "#/$defs/sha256"}, "hash_scope": {"const": "canonical_payload_excluding_event_payload_sha256"}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "release_id", "archive_sha256", "source_release_date", "source_release_time", "source_url", "table_manifest_ids", "observed_at", "parser_version", "source_schema_version", "license_class"], "properties": {"source_id": {"const": "drugs_at_fda"}, "release_id": {"type": "string"}, "archive_sha256": {"$ref": "#/$defs/sha256"}, "source_release_date": {"type": ["string", "null"], "format": "date"}, "source_release_time": {"const": null}, "source_url": {"type": "string", "format": "uri"}, "table_manifest_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "observed_at": {"type": "string", "format": "date-time"}, "parser_version": {"const": "drugs_at_fda_zip_parser.v1"}, "source_schema_version": {"const": "drugs_at_fda_12_tab_tables_2025_01_10"}, "license_class": {"const": "us_government_source_facts"}}}, "authority": {"type": "object", "additionalProperties": false, "required": ["classification", "decision_authority", "allowed_uses", "forbidden_uses"], "properties": {"classification": {"const": "source_fact"}, "decision_authority": {"const": false}, "allowed_uses": {"const": ["display", "context", "explain"]}, "forbidden_uses": {"const": ["originate_signal", "rank_security", "select_security", "size_position", "gate_decision", "execute_trade", "raise_authority"]}}}}
}
