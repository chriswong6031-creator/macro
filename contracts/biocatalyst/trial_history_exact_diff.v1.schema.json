{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/trial_history_exact_diff.v1.schema.json",
  "title": "BioCatalyst Exact Historical Trial Registry Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "diff_id", "nct_id", "before_source_snapshot_ref", "after_source_snapshot_ref", "before_source_version", "after_source_version", "before_content_sha256", "after_content_sha256", "source_record_refs", "operations", "retrieved_at", "source_fact", "current_only", "coverage_class", "semantic_alignment", "interpretation", "protocol_change_asserted", "materiality_assessed", "authority", "transaction_from", "transaction_to", "diff_payload_sha256", "hash_scope"],
  "properties": {
    "contract_id": {"const": "trial_history_exact_diff.v1"}, "schema_version": {"const": "1.0.0"},
    "diff_id": {"type": "string", "pattern": "^trial_history_diff_[A-Za-z0-9_-]+$"}, "nct_id": {"$ref": "#/$defs/nctId"},
    "before_source_snapshot_ref": {"type": "string", "pattern": "^ctgov_history_snapshot_[A-Za-z0-9_-]+$"}, "after_source_snapshot_ref": {"type": "string", "pattern": "^ctgov_history_snapshot_[A-Za-z0-9_-]+$"},
    "before_source_version": {"type": "integer", "minimum": 0}, "after_source_version": {"type": "integer", "minimum": 1},
    "before_content_sha256": {"$ref": "#/$defs/sha256"}, "after_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_record_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^src:ctgov-history:NCT[0-9]{8}:version:[0-9]+:sha256:[a-f0-9]{64}$"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diffOperation"}}, "retrieved_at": {"type": "string", "format": "date-time"},
    "source_fact": {"const": true}, "current_only": {"const": false}, "coverage_class": {"const": "record_history_complete"},
    "semantic_alignment": {"const": "exact_source_json_path_only"}, "interpretation": {"const": "registry_record_changed"}, "protocol_change_asserted": {"const": false}, "materiality_assessed": {"const": false}, "authority": {"$ref": "#/$defs/authority"},
    "transaction_from": {"type": "string", "format": "date-time"}, "transaction_to": {"type": ["string", "null"], "format": "date-time"}, "diff_payload_sha256": {"$ref": "#/$defs/sha256"}, "hash_scope": {"const": "canonical_payload_excluding_diff_payload_sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "nctId": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
    "jsonValue": {"oneOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}]},
    "diffOperation": {"type": "object", "additionalProperties": false, "required": ["op", "json_path", "change_family", "before_state", "before_value", "after_state", "after_value"], "properties": {"op": {"type": "string", "enum": ["add", "remove", "replace"]}, "json_path": {"type": "string", "pattern": "^/"}, "change_family": {"type": "string", "enum": ["registry_status", "enrollment", "study_date", "site_listing", "endpoint_record", "sponsor", "intervention", "other"]}, "before_state": {"type": "string", "enum": ["missing", "present"]}, "before_value": {"$ref": "#/$defs/jsonValue"}, "after_state": {"type": "string", "enum": ["missing", "present"]}, "after_value": {"$ref": "#/$defs/jsonValue"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["classification", "decision_authority", "allowed_uses", "forbidden_uses"], "properties": {"classification": {"const": "source_fact"}, "decision_authority": {"const": false}, "allowed_uses": {"const": ["display", "context", "explain"]}, "forbidden_uses": {"const": ["originate_signal", "rank_security", "select_security", "size_position", "gate_decision", "execute_trade", "raise_authority"]}}}
  }
}
