{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/biocatalyst_retention_preflight.v1.schema.json",
  "title": "BioCatalyst R2 Retention Preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "schema_version", "preflight_id", "checked_at", "provider", "target", "worker_token", "retention", "activation", "hash_scope", "preflight_payload_sha256"],
  "properties": {
    "contract_id": {"const": "biocatalyst_retention_preflight.v1"},
    "schema_version": {"const": "1.0.0"},
    "preflight_id": {"type": "string", "pattern": "^r2_preflight_[a-f0-9]{24}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "provider": {"const": "cloudflare_r2"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["config_binding_sha256", "account_id_sha256", "bucket_sha256", "endpoint_sha256", "jurisdiction"],
      "properties": {
        "config_binding_sha256": {"$ref": "#/$defs/sha256"},
        "account_id_sha256": {"$ref": "#/$defs/sha256"},
        "bucket_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_sha256": {"$ref": "#/$defs/sha256"},
        "jurisdiction": {"enum": ["default", "eu", "fedramp"]}
      }
    },
    "worker_token": {
      "type": "object", "additionalProperties": false,
      "required": ["token_id_sha256", "policy_sha256", "resource_sha256", "permission_group"],
      "properties": {
        "token_id_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "resource_sha256": {"$ref": "#/$defs/sha256"},
        "permission_group": {"const": "Workers R2 Storage Bucket Item Write"}
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["required_prefix", "lock_rule_ids", "lock_rules_sha256", "lifecycle_rules_sha256", "lifecycle_expiration_absent"],
      "properties": {
        "required_prefix": {"const": "biocatalyst/"},
        "lock_rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "lock_rules_sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle_rules_sha256": {"$ref": "#/$defs/sha256"},
        "lifecycle_expiration_absent": {"const": true}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_collection", "ledger_accrual", "public_pointer_advanced"],
      "properties": {
        "source_collection": {"const": false},
        "ledger_accrual": {"const": false},
        "public_pointer_advanced": {"const": false}
      }
    },
    "hash_scope": {"const": "canonical_payload_excluding_preflight_payload_sha256"},
    "preflight_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
