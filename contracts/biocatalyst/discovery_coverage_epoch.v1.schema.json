{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/biocatalyst/discovery_coverage_epoch.v1.schema.json",
  "title": "BioCatalyst ClinicalTrials.gov Discovery Coverage Epoch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "schema_version", "coverage_epoch_id", "source_id",
    "source_native_identifier_kind", "declared_window", "coverage_state",
    "coverage_claim", "included_runs", "gap_windows", "overlap_windows",
    "quarantine_codes", "transaction_from", "transaction_to", "hash_scope",
    "coverage_payload_sha256"
  ],
  "properties": {
    "contract_id": {"const": "ctgov_discovery_coverage_epoch.v1"},
    "schema_version": {"const": "1.0.0"},
    "coverage_epoch_id": {"type": "string", "pattern": "^ctgov_discovery_coverage_[A-Za-z0-9_-]{1,96}$"},
    "source_id": {"const": "clinicaltrials_gov_v2"},
    "source_native_identifier_kind": {"const": "nct_id"},
    "declared_window": {"$ref": "#/$defs/dateWindow"},
    "coverage_state": {"type": "string", "enum": ["complete", "quarantined"]},
    "coverage_claim": {"const": "complete_only_for_evidenced_declared_source_query_scopes"},
    "included_runs": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {"$ref": "#/$defs/includedRun"}
    },
    "gap_windows": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/dateWindow"}},
    "overlap_windows": {"type": "array", "maxItems": 2048, "items": {"$ref": "#/$defs/dateWindow"}},
    "quarantine_codes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "enum": ["DISCOVERY_COVERAGE_GAP", "DISCOVERY_COVERAGE_OVERLAP_REQUIRED"]}
    },
    "transaction_from": {"type": "string", "format": "date-time"},
    "transaction_to": {"type": ["string", "null"], "format": "date-time"},
    "coverage_denominator": {"$ref": "#/$defs/coverageDenominator"},
    "budget_ledger": {"$ref": "#/$defs/budgetLedger"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "discovery_authority": {"$ref": "#/$defs/discoveryAuthority"},
    "hash_scope": {"const": "canonical_payload_excluding_coverage_payload_sha256"},
    "coverage_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverageDenominator": {
      "type": "object", "additionalProperties": false,
      "required": [
        "basis", "semantics", "declared_total_by_scope", "declared_total_sum",
        "observed_unique_records", "unreconciled_records", "known_exclusions"
      ],
      "properties": {
        "basis": {"const": "recorded_source_declared_total_count_per_included_scope"},
        "semantics": {"const": "denominator_is_recorded_evidence_not_inferred_from_query_breadth"},
        "declared_total_by_scope": {
          "type": "array", "minItems": 1, "maxItems": 2048,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["scope_ref", "declared_total_count"],
            "properties": {
              "scope_ref": {"type": "string", "pattern": "^ctgov_discovery_scope_[a-f0-9]{24}$"},
              "declared_total_count": {"type": "integer", "minimum": 0, "maximum": 200000}
            }
          }
        },
        "declared_total_sum": {"type": "integer", "minimum": 0, "maximum": 409600000},
        "observed_unique_records": {"type": "integer", "minimum": 0, "maximum": 200000},
        "unreconciled_records": {"type": "integer", "minimum": 0, "maximum": 409600000},
        "known_exclusions": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "description"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "records_outside_the_declared_selection_window",
                  "records_never_returned_by_the_declared_query_family",
                  "source_records_removed_or_withheld_by_the_registry",
                  "resources_outside_the_declared_studies_endpoint",
                  "records_beyond_the_recorded_budget_stop_condition"
                ]
              },
              "description": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      }
    },
    "budgetLedger": {
      "type": "object", "additionalProperties": false,
      "required": [
        "byte_budget", "bytes_spent", "request_budget", "requests_spent",
        "wall_clock_budget_ms", "wall_clock_spent_ms", "min_request_interval_ms",
        "observed_min_request_interval_ms", "stop_condition"
      ],
      "properties": {
        "byte_budget": {"type": "integer", "minimum": 0, "maximum": 137438953472},
        "bytes_spent": {"type": "integer", "minimum": 0, "maximum": 137438953472},
        "request_budget": {"type": "integer", "minimum": 0, "maximum": 4196352},
        "requests_spent": {"type": "integer", "minimum": 0, "maximum": 4196352},
        "wall_clock_budget_ms": {"type": "integer", "minimum": 0, "maximum": 604800000},
        "wall_clock_spent_ms": {"type": "integer", "minimum": 0, "maximum": 604800000},
        "min_request_interval_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "observed_min_request_interval_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "stop_condition": {
          "type": "string",
          "enum": [
            "declared_window_completed", "byte_budget_reached", "request_budget_reached",
            "wall_clock_budget_reached", "rate_limit_interval_reached",
            "page_cap_reached", "record_cap_reached"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": [
        "replay_determinism", "correction_policy", "withdrawal_policy", "rollback_policy",
        "included_run_payload_digest_sha256", "supersedes_coverage_epoch_id",
        "superseded_by_coverage_epoch_id", "withdrawn_at", "withdrawal_reason_code"
      ],
      "properties": {
        "replay_determinism": {"const": "epoch_is_a_pure_function_of_its_recorded_run_payload_digests"},
        "correction_policy": {"const": "corrections_supersede_by_a_new_epoch_never_by_mutation"},
        "withdrawal_policy": {"const": "withdrawal_closes_transaction_to_and_retains_the_withdrawn_epoch"},
        "rollback_policy": {"const": "rollback_restores_the_prior_superseded_epoch_reference_only"},
        "included_run_payload_digest_sha256": {"$ref": "#/$defs/sha256"},
        "supersedes_coverage_epoch_id": {"type": ["string", "null"], "pattern": "^ctgov_discovery_coverage_[A-Za-z0-9_-]{1,96}$"},
        "superseded_by_coverage_epoch_id": {"type": ["string", "null"], "pattern": "^ctgov_discovery_coverage_[A-Za-z0-9_-]{1,96}$"},
        "withdrawn_at": {"type": ["string", "null"], "format": "date-time"},
        "withdrawal_reason_code": {
          "type": ["string", "null"],
          "enum": [
            null, "source_correction", "budget_or_rate_limit_breach",
            "denominator_unreconciled", "scope_review_revoked"
          ]
        }
      }
    },
    "discoveryAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_inference", "model_authority", "membership_authority", "expansion_policy"],
      "properties": {
        "identity_inference": {"const": "source_native_record_identifiers_only_no_company_or_security_inference"},
        "model_authority": {"const": "no_model_scoring_ordering_sizing_or_alerting_authority"},
        "membership_authority": {"const": "reviewed_fixed_cohort_membership_only"},
        "expansion_policy": {"const": "measured_separately_reviewed_epochs_never_an_unbounded_universe"}
      }
    },
    "sourceDataTimestamp": {"type": "string", "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
    "dateWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      }
    },
    "selectionWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "start_date", "end_date", "query_expression"],
      "properties": {
        "field": {"const": "LastUpdatePostDate"},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "query_expression": {"type": "string", "pattern": "^AREA\\[LastUpdatePostDate\\]RANGE\\[[0-9]{4}-[0-9]{2}-[0-9]{2},[0-9]{4}-[0-9]{2}-[0-9]{2}\\]$"}
      }
    },
    "sourceCut": {
      "type": "object", "additionalProperties": false,
      "required": [
        "dataset_timestamp_before_raw", "dataset_timestamp_after_raw",
        "api_version_before", "api_version_after", "version_before_retrieved_at",
        "version_after_retrieved_at", "first_page_receipt_retrieved_at",
        "terminal_page_receipt_retrieved_at"
      ],
      "properties": {
        "dataset_timestamp_before_raw": {"type": ["string", "null"], "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
        "dataset_timestamp_after_raw": {"type": ["string", "null"], "format": "ctgov-data-timestamp", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})?$"},
        "api_version_before": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "api_version_after": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "version_before_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "version_after_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "first_page_receipt_retrieved_at": {"type": ["string", "null"], "format": "date-time"},
        "terminal_page_receipt_retrieved_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "includedRun": {
      "type": "object", "additionalProperties": false,
      "required": [
        "run_ref", "run_payload_sha256", "run_state", "reconciliation_state", "run_transaction_from", "scope_ref",
        "scope_payload_sha256", "selection_window", "source_cut"
      ],
      "properties": {
        "run_ref": {"type": "string", "pattern": "^ctgov_discovery_run_[A-Za-z0-9_-]{1,96}$"},
        "run_payload_sha256": {"$ref": "#/$defs/sha256"},
        "run_state": {"const": "complete"},
        "reconciliation_state": {"const": "reconciled"},
        "run_transaction_from": {"type": "string", "format": "date-time"},
        "scope_ref": {"type": "string", "pattern": "^ctgov_discovery_scope_[a-f0-9]{24}$"},
        "scope_payload_sha256": {"$ref": "#/$defs/sha256"},
        "selection_window": {"$ref": "#/$defs/selectionWindow"},
        "source_cut": {"$ref": "#/$defs/sourceCut"}
      }
    }
  }
}
