{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-x.com/contracts/capital_structure_share_count_ledger_receipt_v2.schema.json",
  "title": "Authenticated Company Facts share-count ledger receipt v2",
  "description": "A bounded append transition plus domain-separated rolling commitments to the exact ordered v2 observation and source prefixes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledger_receipt_id",
    "sequence",
    "predecessor_ledger_receipt_id",
    "materialized_at",
    "appended",
    "prefixes"
  ],
  "properties": {
    "schema": {"const": "capital_structure.share_count_ledger_receipt.v2"},
    "ledger_receipt_id": {"type": "string", "pattern": "^share-count-ledger-receipt-v2:cs:[a-f0-9]{24}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
    "predecessor_ledger_receipt_id": {"type": ["string", "null"], "pattern": "^share-count-ledger-receipt-v2:cs:[a-f0-9]{24}$"},
    "materialized_at": {"type": "string", "format": "date-time"},
    "appended": {"$ref": "#/$defs/appended"},
    "prefixes": {"$ref": "#/$defs/prefixes"}
  },
  "$defs": {
    "appended": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_ids", "source_snapshot_ids", "bridge_receipt_ids", "source_manifest_ids"],
      "properties": {
        "observation_ids": {"type": "array", "maxItems": 1000000, "uniqueItems": true, "items": {"type": "string", "pattern": "^share-count-v2:cs:[a-f0-9]{24}$"}},
        "source_snapshot_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^companyfacts-snapshot-v2:cs:[a-f0-9]{24}$"}},
        "bridge_receipt_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^companyfacts-bridge:cs:[a-f0-9]{24}$"}},
        "source_manifest_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^manifest:cs-companyfacts:[a-f0-9]{64}$"}}
      }
    },
    "prefixes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "source_snapshots", "bridges", "source_manifests"],
      "properties": {
        "observations": {"$ref": "#/$defs/prefix"},
        "source_snapshots": {"$ref": "#/$defs/prefix"},
        "bridges": {"$ref": "#/$defs/prefix"},
        "source_manifests": {"$ref": "#/$defs/prefix"}
      }
    },
    "prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "rolling_sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "rolling_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sequence": {"const": 1}}, "required": ["sequence"]},
      "then": {"properties": {"predecessor_ledger_receipt_id": {"type": "null"}}},
      "else": {"properties": {"predecessor_ledger_receipt_id": {"type": "string"}}}
    }
  ]
}
