//@version=6
indicator("Mastermind Temporal Recipe Probe v1", overlay=false, format=format.price, precision=16)

int rsiLen = input.int(14, "RSI length", minval=1)
int fastLen = input.int(14, "RSI-MACD fast", minval=1)
int slowLen = input.int(60, "RSI-MACD slow", minval=2)
int signalLen = input.int(5, "RSI-MACD signal", minval=1)
int stochLen = input.int(14, "StochRSI length", minval=1)
int smoothK = input.int(3, "StochRSI K", minval=1)
int smoothD = input.int(3, "StochRSI D", minval=1)

float rsi = ta.rsi(close, rsiLen)
float macd = ta.ema(rsi, fastLen) - ta.ema(rsi, slowLen)
float macdSignal = ta.ema(macd, signalLen)
float macdHist = macd - macdSignal
float rsiLow = ta.lowest(rsi, stochLen)
float rsiHigh = ta.highest(rsi, stochLen)
float rawStoch = rsiHigh == rsiLow ? na : 100.0 * (rsi - rsiLow) / (rsiHigh - rsiLow)
float stochK = ta.sma(rawStoch, smoothK)
float stochD = ta.sma(stochK, smoothD)
int chartTypeCount = (chart.is_standard ? 1 : 0) + (chart.is_heikinashi ? 1 : 0) + (chart.is_renko ? 1 : 0) + (chart.is_linebreak ? 1 : 0) + (chart.is_kagi ? 1 : 0) + (chart.is_pnf ? 1 : 0) + (chart.is_range ? 1 : 0)
bool chartTypeCoherent = chartTypeCount == 1

plot(time, "TG_time_open_ms", display=display.data_window, precision=0)
plot(time_close, "TG_time_close_ms", display=display.data_window, precision=0)
plot(time_tradingday, "TG_time_tradingday_ms", display=display.data_window, precision=0)
plot(time_close - time, "TG_duration_ms", display=display.data_window, precision=0)
plot(bar_index, "TG_bar_index", display=display.data_window, precision=0)
plot(barstate.isconfirmed ? 1.0 : 0.0, "TG_is_confirmed", display=display.data_window, precision=0)
plot(session.ismarket ? 1.0 : 0.0, "TG_is_market", display=display.data_window, precision=0)
plot(session.ispremarket ? 1.0 : 0.0, "TG_is_premarket", display=display.data_window, precision=0)
plot(session.ispostmarket ? 1.0 : 0.0, "TG_is_postmarket", display=display.data_window, precision=0)
plot(session.isfirstbar ? 1.0 : 0.0, "TG_is_firstbar", display=display.data_window, precision=0)
plot(session.islastbar ? 1.0 : 0.0, "TG_is_lastbar", display=display.data_window, precision=0)
plot(session.isfirstbar_regular ? 1.0 : 0.0, "TG_is_firstbar_regular", display=display.data_window, precision=0)
plot(session.islastbar_regular ? 1.0 : 0.0, "TG_is_lastbar_regular", display=display.data_window, precision=0)

plot(open, "TG_open", display=display.data_window, precision=16)
plot(high, "TG_high", display=display.data_window, precision=16)
plot(low, "TG_low", display=display.data_window, precision=16)
plot(close, "TG_close", display=display.data_window, precision=16)
plot(volume, "TG_volume", display=display.data_window, precision=16)
plot(rsi, "TG_rsi", display=display.data_window, precision=16)
plot(macd, "TG_rsi_macd", display=display.data_window, precision=16)
plot(macdSignal, "TG_rsi_macd_signal", display=display.data_window, precision=16)
plot(macdHist, "TG_rsi_macd_hist", display=display.data_window, precision=16)
plot(stochK, "TG_stoch_k", display=display.data_window, precision=16)
plot(stochD, "TG_stoch_d", display=display.data_window, precision=16)

plot(chart.is_standard ? 1.0 : 0.0, "TG_chart_is_standard", display=display.data_window, precision=0)
plot(chart.is_heikinashi ? 1.0 : 0.0, "TG_chart_is_heikinashi", display=display.data_window, precision=0)
plot(chart.is_renko ? 1.0 : 0.0, "TG_chart_is_renko", display=display.data_window, precision=0)
plot(chart.is_linebreak ? 1.0 : 0.0, "TG_chart_is_linebreak", display=display.data_window, precision=0)
plot(chart.is_kagi ? 1.0 : 0.0, "TG_chart_is_kagi", display=display.data_window, precision=0)
plot(chart.is_pnf ? 1.0 : 0.0, "TG_chart_is_pnf", display=display.data_window, precision=0)
plot(chart.is_range ? 1.0 : 0.0, "TG_chart_is_range", display=display.data_window, precision=0)

var table metadata = table.new(position.top_right, 2, 24)
if barstate.islast
    table.cell(metadata, 0, 0, "probe")
    table.cell(metadata, 1, 0, "temporal-recipe-probe-v1")
    table.cell(metadata, 0, 1, "tickerid")
    table.cell(metadata, 1, 1, syminfo.tickerid)
    table.cell(metadata, 0, 2, "main_tickerid")
    table.cell(metadata, 1, 2, syminfo.main_tickerid)
    table.cell(metadata, 0, 3, "exchange/feed")
    table.cell(metadata, 1, 3, syminfo.prefix)
    table.cell(metadata, 0, 4, "type / currency")
    table.cell(metadata, 1, 4, str.format("{0} / {1}", syminfo.type, syminfo.currency))
    table.cell(metadata, 0, 5, "session")
    table.cell(metadata, 1, 5, syminfo.session)
    table.cell(metadata, 0, 6, "exchange timezone")
    table.cell(metadata, 1, 6, syminfo.timezone)
    table.cell(metadata, 0, 7, "timeframe")
    table.cell(metadata, 1, 7, timeframe.period)
    table.cell(metadata, 0, 8, "RSI")
    table.cell(metadata, 1, 8, str.tostring(rsiLen))
    table.cell(metadata, 0, 9, "RSI-MACD fast")
    table.cell(metadata, 1, 9, str.tostring(fastLen))
    table.cell(metadata, 0, 10, "RSI-MACD slow")
    table.cell(metadata, 1, 10, str.tostring(slowLen))
    table.cell(metadata, 0, 11, "RSI-MACD signal")
    table.cell(metadata, 1, 11, str.tostring(signalLen))
    table.cell(metadata, 0, 12, "StochRSI length")
    table.cell(metadata, 1, 12, str.tostring(stochLen))
    table.cell(metadata, 0, 13, "StochRSI K")
    table.cell(metadata, 1, 13, str.tostring(smoothK))
    table.cell(metadata, 0, 14, "StochRSI D")
    table.cell(metadata, 1, 14, str.tostring(smoothD))
    table.cell(metadata, 0, 15, "chart standard")
    table.cell(metadata, 1, 15, str.tostring(chart.is_standard))
    table.cell(metadata, 0, 16, "chart heikinashi")
    table.cell(metadata, 1, 16, str.tostring(chart.is_heikinashi))
    table.cell(metadata, 0, 17, "chart renko")
    table.cell(metadata, 1, 17, str.tostring(chart.is_renko))
    table.cell(metadata, 0, 18, "chart linebreak")
    table.cell(metadata, 1, 18, str.tostring(chart.is_linebreak))
    table.cell(metadata, 0, 19, "chart kagi")
    table.cell(metadata, 1, 19, str.tostring(chart.is_kagi))
    table.cell(metadata, 0, 20, "chart pnf")
    table.cell(metadata, 1, 20, str.tostring(chart.is_pnf))
    table.cell(metadata, 0, 21, "chart range")
    table.cell(metadata, 1, 21, str.tostring(chart.is_range))
    table.cell(metadata, 0, 22, "chart type count")
    table.cell(metadata, 1, 22, str.tostring(chartTypeCount))
    table.cell(metadata, 0, 23, "chart type coherent")
    table.cell(metadata, 1, 23, str.tostring(chartTypeCoherent))
