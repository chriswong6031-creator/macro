      "timestamp_policy": "quote_source_clock",
      "freshness_policy": "owner_native",
      "point_in_time_policy": "current_only",
      "status_policy": "typed_v1",
      "operators": ["eq", "ne", "gt", "gte", "lt", "lte", "between"],
      "renderer": "currency",
      "rights_policy": "subscriber_allowed",
      "consumer_uses": ["display", "query", "ai_fact", "alert_input", "context"],
      "constraints": {"minimum": 0},
      "cost_weight": 2
    },
    {
