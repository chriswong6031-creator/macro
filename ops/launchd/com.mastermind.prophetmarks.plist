<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.mastermind.prophetmarks.plist — launchd agent for the Prophet live-marks publisher.

  Fires every 5 minutes using a timezone-neutral StartInterval.  The runner checks
  America/New_York explicitly, admits one cycle inside 09:25–16:05 ET, and exits.
  build_prophet_marks.py applies the stricter NYSE session/RTH publication guard.

  Do not replace StartInterval with StartCalendarInterval hours.  launchd interprets
  those hours in the Mac's local timezone, and the production M1 is America/Vancouver.

  DO NOT touch the com.mastermind.liveflow lane — this is a separate, independent job.

  INSTALL (as the mac user who runs Theta Terminal — not root):
    cp ops/launchd/com.mastermind.prophetmarks.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mastermind.prophetmarks.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.mastermind.prophetmarks.plist
    rm ~/Library/LaunchAgents/com.mastermind.prophetmarks.plist

  DO NOT load this plist directly from the repo. Copy first — the repo path may not
  match the deployment path, and launchd requires the exact plist path when unloading.

  ENV FILE:
    R2 credentials are sourced from /Users/chriswong/flow-ops-wt/.env via
    run_with_env.sh. Required vars:
      R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET

  LOG TAILING:
    tail -f /tmp/prophetmarks.stdout.log /tmp/prophetmarks.stderr.log

  MANUAL RUN (smoke — no publish):
    set -a
    source /Users/chriswong/flow-ops-wt/.env
    set +a
    cd /Users/chriswong/flow-ops-wt
    python -m scripts.build_prophet_marks

  MANUAL PUBLISH (one cycle):
    set -a
    source /Users/chriswong/flow-ops-wt/.env
    set +a
    cd /Users/chriswong/flow-ops-wt
    python -m scripts.build_prophet_marks  [add the publish flag]
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.prophetmarks</string>

  <!--
    run_with_env.sh sources .env before executing the one-cycle runner.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/flow-ops-wt/.env</string>
    <string>/bin/sh</string>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_prophet_marks_loop.sh</string>
  </array>

  <!-- Working directory = flow-ops-wt (launchd law: never ~/Documents). -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/flow-ops-wt</string>

  <!--
    StartInterval is elapsed time, not a wall-clock hour, so host timezone cannot
    shift the lane.  The runner's explicit America/New_York gate discards cycles
    outside 09:25–16:05 ET; the builder then enforces NYSE sessions and 09:30–16:00.
  -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/flow-ops-wt</string>
    <!-- R2_* and other secrets sourced from .env via run_with_env.sh above. -->
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/prophetmarks.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/prophetmarks.stderr.log</string>

  <!-- Do NOT set KeepAlive: StartInterval owns the five-minute cadence and the
       runner exits after exactly one admitted or skipped cycle. -->
  <key>KeepAlive</key>
  <false/>

  <!-- Throttle: if the job crashes in under 10s, wait 60s before retrying. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
