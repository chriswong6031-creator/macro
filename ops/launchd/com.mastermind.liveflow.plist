<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.mastermind.liveflow.plist — launchd agent for the live options-flow poller.

  Autostart on weekdays at 09:25 ET. The poller runs in RTH-only mode so it self-exits
  after 16:05 ET.  launchd fires it again at 09:25 the next weekday.

  INSTALL (as the mac user who runs Theta Terminal — not root):
    cp ops/launchd/com.mastermind.liveflow.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mastermind.liveflow.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.mastermind.liveflow.plist
    rm ~/Library/LaunchAgents/com.mastermind.liveflow.plist

  DO NOT load this plist directly from the repo. Copy first — the repo path
  may not match the deployment path, and launchd requires the exact plist path
  when unloading.

  THETA TERMINAL DEPENDENCY:
    The poller calls collectors.thetadata.reachable() on startup; if Theta
    Terminal v3 (ThetaTerminalApp) is not running on port 25503 the poller
    exits with code 1.  Start ThetaTerminalApp before 09:25 ET.
    Recommended: add ThetaTerminalApp to Login Items so it launches at boot.

  ENV FILE:
    R2 credentials and other secrets are read from /etc/macro-api.env
    (or the path in EnvironmentVariables below).  Required vars:
      R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET

  STATE RECOVERY:
    Never delete or quarantine the current session's day_state alone. It is the
    transaction partner of the append-only event stage and may own an unstaged
    pending-learning WAL. Preserve both files for forensics, stop the lane for
    that session, and use the reviewed recovery procedure in the runbook (or
    resume cleanly on the next session after the stranded-WAL check is cleared).
    Do not use this combined live poller as a historical smoke test. In
    particular, never run the once or historical-date modes: both can mutate live R2
    current/replay surfaces and historical dates violate exact PIT clocks.
    After a reviewed wipe, let launchd resume on the next live RTH session.
    Offline validation is limited to import and help output; follow
    ops/LIVE_FLOW_RUNBOOK.md for the supervised next-RTH proof.

  LOG TAILING:
    tail -f /tmp/liveflow.stdout.log /tmp/liveflow.stderr.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.liveflow</string>

  <key>ProgramArguments</key>
  <array>
    <!--
      run_with_env.sh sources .env (R2 creds + THETADATA_STORE) before launching Python.
      Adjust python path to match your conda/venv activation.

      DEPLOY-TREE DOCTRINE: these paths point at the DEDICATED deploy tree
      /Users/chriswong/liveflow-ops-wt (pinned to origin/main), NOT a shared
      agent checkout.  A shared checkout is used by many live agent sessions
      and is frequently parked at a detached HEAD that lacks
      scripts/live_flow_poller.py — running launchd from there fails with
      ModuleNotFoundError.

      The deploy tree is a STANDALONE SHALLOW CLONE, not a git worktree.  The
      old `git worktree add` recipe needed a parent checkout that does not
      exist on the M1 ops host, which left the tree with a dangling gitdir:
      pointer and no working git at all.  Refresh it with a depth-1 fetch of
      origin main followed by a hard reset onto FETCH_HEAD; the exact commands,
      the full rebuild recipe and the GitHub auth notes all live in
      ops/LIVE_FLOW_RUNBOOK.md ("Deploy-tree doctrine (live-flow poller)").

      The interpreter below is a symlink to /Users/chriswong/miniconda3/envs/
      plane/bin/python on the M1 (the installed plist spells out the resolved
      path); both are the same binary.
    -->
    <string>/Users/chriswong/liveflow-ops-wt/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/liveflow-ops-wt/.env</string>
    <string>/opt/homebrew/Caskroom/miniconda/base/bin/python</string>
    <string>-m</string>
    <string>scripts.live_flow_poller</string>
    <string>--rth-only</string>
  </array>

  <!--
    Working directory MUST be the dedicated deploy worktree (see doctrine
    note above), NEVER the main checkout — the main checkout's git HEAD is
    controlled by other live sessions and is not a stable deployment target.
  -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/liveflow-ops-wt</string>

  <!--
    run_with_env.sh sources the .env file before executing the poller.
    Secrets (R2 creds, THETADATA_STORE) are loaded from .env — never inlined here.
  -->

  <!--
    Mac is on Pacific time; 06:25 PT = 09:25 ET year-round (5 min before the
    9:30 ET open).  ET and PT share DST transitions so the offset (PT = ET - 3h)
    is constant year-round.  If the Mac's timezone changes, update these entries.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <!-- Monday=1 ... Friday=5 -->
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>25</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>25</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>25</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>25</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>25</integer>
    </dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!--
      Secrets (R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET /
      THETADATA_STORE) are loaded from .env by run_with_env.sh above.
      Do NOT set secrets here — they would appear in the plist on disk.
    -->
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/liveflow-ops-wt</string>
    <!--
      FC-R6 two-tier cadence (R0.5, masterplan 2026-07-31): tier-1 (~33 roots
      incl. Mag7 + memory names) every cycle, tier-2 round-robin in 4 buckets.
      Coded 2026-07 but default-OFF; enabled here 2026-07-31 — halves effective
      staleness for the names that matter under any delta_mode.
    -->
    <key>LIVE_FLOW_TWO_TIER</key>
    <string>1</string>
    <!--
      Prospective SPY Market Memory context capture. The key is a dedicated
      forced-command key: it can invoke only the bounded W1A stdin writer on
      the VPS and cannot obtain a shell, forward ports, or mutate owner
      ledgers. The private key itself remains outside the repository.
    -->
    <key>MARKET_MEMORY_OPTIONS_CONTEXT_CAPTURE</key>
    <string>1</string>
    <key>MARKET_MEMORY_OPTIONS_CONTEXT_OUTBOX</key>
    <string>/Users/chriswong/liveflow-ops-wt/data/live_flow_state/market_memory_options_context</string>
    <key>MARKET_MEMORY_OPTIONS_CONTEXT_SSH_TARGET</key>
    <string>root@146.190.142.17</string>
    <key>MARKET_MEMORY_OPTIONS_CONTEXT_SSH_KEY</key>
    <string>/Users/chriswong/.ssh/market_memory_options_context_capture</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/liveflow.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/liveflow.stderr.log</string>

  <!-- Restart only abnormal exits. A crash, power-recovery relaunch, or
       Theta-unavailable exit is retried so a same-session pending WAL drains;
       the poller's clean post-RTH exit 0 remains stopped until the next calendar
       trigger. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Throttle: if the job exits in under 10s (crash), wait 60s before retrying. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
