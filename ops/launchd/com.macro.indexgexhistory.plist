<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.macro.indexgexhistory.plist — launchd agent for the OIP E3c WEEKLY
  reconstruction of the multi-year index dealer-gamma history.

  WHAT IT RUNS
    ops/launchd/run_index_gex_history.sh
      -> python -m scripts.build_index_gex_history   (rebuild 2017-> for SPY/QQQ/IWM/DIA)
      -> python -m scripts.publish_r2 --dirs index_gex_history --no-manifest  (offsite)
      -> commit + push data/index_gex_history/ from a standalone $HOME push repo

  WHY IT EXISTS
    The rebuild joins the ThetaData greeks + oi stores
    (/Users/chriswong/theta-ops-wt/data/thetadata_eod — ~60 GB) which exist ONLY on
    this host, so CI and the nightly render can never produce it; they read the
    COMMITTED data/index_gex_history/*.parquet instead. Without a scheduled lane the
    store simply stops advancing: it was built by hand once in 2026-06 (#1374) and
    sat frozen at 2026-07-02 for 18 trading sessions while engine/market_gamma kept
    serving percentiles off it. engine/market_gamma now discloses the window and the
    session lag in plain words; this job is what keeps the lag small.

  CADENCE — WEEKLY, OFF-PEAK
    Sunday 20:00 local (23:00 ET Sunday). Chosen against the other options lanes on
    this host so nothing overlaps:
      * com.macro.optionsmatrix           weekdays 16:00 local
      * com.macro.unusualbaseline         weekdays 16:30 local
      * com.macro.theme-options-witness   weekdays 17:15 local
      * com.macro.thetadata-r2sync        DAILY 22:00 local  <- 2h after this job
      * live-flow poller window           06:25-13:05 local (09:25-16:05 ET)
    Sunday also means the week's ThetaData backfill refreshes have all settled, and
    the 22:00 r2sync that follows carries any store deltas offsite anyway.
    A weekly cadence is why engine/market_gamma's staleness threshold is 7 sessions
    rather than 1: ~5 sessions of lag is the NORMAL steady state for this artifact.

  RUNTIME
    ~15-25 min (10 years x 4 roots x per-day compute_gex over the joined chain).
    Deliberately OFF the render path — the nightly engine job's 200-min ceiling is
    treated as full (OIP masterplan §7).

  INSTALL (as the mac user who runs Theta Terminal — not root):
    cp ops/launchd/com.macro.indexgexhistory.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.macro.indexgexhistory.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.macro.indexgexhistory.plist
    rm ~/Library/LaunchAgents/com.macro.indexgexhistory.plist

  DO NOT load this plist directly from the repo. Copy first — the repo path may not
  match the deployment path, and launchd requires the exact plist path when unloading.

  ENV FILE:
    THETADATA_STORE and the R2 credentials are sourced from
    /Users/chriswong/flow-ops-wt/.env via ops/launchd/run_with_env.sh.
    NEVER inline secrets in EnvironmentVariables — use the wrapper.

    Required env vars:
      THETADATA_STORE=/Users/chriswong/theta-ops-wt/data/thetadata_eod
      R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
    THETADATA_STORE is the FIRST link in engine.thetadata_store.resolve_thetadata_store's
    chain; the resolver content-checks it (a stub dir with no eod/ oi/ greeks/ is
    ignored with a loud warning) and falls through to data_dir() then the ops-wt store.

  LOG TAILING:
    tail -f /tmp/index_gex_history.stdout.log /tmp/index_gex_history.stderr.log

  MANUAL RUN (full — rebuild + R2 + push):
    /Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh \
      /Users/chriswong/flow-ops-wt/.env \
      /Users/chriswong/flow-ops-wt/ops/launchd/run_index_gex_history.sh

  MANUAL RUN (push tail only — skips the ~20 min rebuild):
    INDEXGEX_SKIP_ENGINE=1 /Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh \
      /Users/chriswong/flow-ops-wt/.env \
      /Users/chriswong/flow-ops-wt/ops/launchd/run_index_gex_history.sh

  VERIFY IT LANDED:
    python -c "import pandas as pd; d=pd.read_parquet('data/index_gex_history/SPY.parquet'); print(len(d), d.index.max())"
    git log -1 --stat -- data/index_gex_history
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macro.indexgexhistory</string>

  <!--
    run_with_env.sh sources the .env file before executing the runner.
    Args: <env_file> <command> [args...]
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/flow-ops-wt/.env</string>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_index_gex_history.sh</string>
  </array>

  <!-- Working directory must be flow-ops-wt (avoids ~/Documents TCC denial). -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/flow-ops-wt</string>

  <!-- Weekly: Sunday (Weekday 0) 20:00 local. See CADENCE above. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>20</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/flow-ops-wt</string>
    <!--
      THETADATA_STORE and R2_* are sourced from .env via run_with_env.sh above.
      Do NOT set them here to avoid duplication / stale override.
    -->
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/index_gex_history.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/index_gex_history.stderr.log</string>

  <key>KeepAlive</key>
  <false/>

  <!--
    Throttle: if the job exits in under 10s, wait 300s before retrying. A fast exit
    here means the store did not resolve or the rebuild is partial — both are
    operator conditions, so back off hard rather than spinning a 60s retry loop
    against a ~60 GB store.
  -->
  <key>ThrottleInterval</key>
  <integer>300</integer>

  <!--
    The rebuild opens the greeks + oi year parquets per root and boto3's upload
    threads follow in the same process; launchd agents inherit macOS's 256-fd soft
    limit, which the thetadata-r2sync lane already proved too small on GB-class
    greeks parquets (EMFILE, 2026-07-16). Same headroom here.
  -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>

  <!--
    Nice the rebuild: it is a long CPU-bound pandas job on a shared ops host and
    nothing downstream is waiting on it within the hour.
  -->
  <key>Nice</key>
  <integer>5</integer>

</dict>
</plist>
