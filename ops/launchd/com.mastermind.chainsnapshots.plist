<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.mastermind.chainsnapshots.plist — launchd agent for the U-CHAIN
  chain-snapshot poller (scripts/chain_snapshot_poller.py).

  Autostart on weekdays at 09:30 ET. The poller runs in RTH-only mode: it waits
  for actual NYSE open + 5m, sweeps every cadence_min (default 15) minutes,
  and self-exits after 16:00 ET.  launchd fires it again the next weekday.

  INSTALL (as the mac user who runs Theta Terminal — not root):
    cp ops/launchd/com.mastermind.chainsnapshots.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mastermind.chainsnapshots.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.mastermind.chainsnapshots.plist
    rm ~/Library/LaunchAgents/com.mastermind.chainsnapshots.plist

  DO NOT load this plist directly from the repo. Copy first — the repo path
  may not match the deployment path, and launchd requires the exact plist path
  when unloading.

  THETA TERMINAL DEPENDENCY:
    The poller calls collectors.thetadata.reachable() on startup; if Theta
    Terminal v3 (ThetaTerminalApp) is not running on port 25503 the poller
    exits with code 1.  Start ThetaTerminalApp before 09:30 ET.
    Recommended: add ThetaTerminalApp to Login Items so it launches at boot.

  CONCURRENCY BUDGET (HARD):
    max_concurrent=1 in config.yml chain_snapshots — the live_flow poller owns
    2 of the terminal's 8 concurrent request slots during RTH.  NEVER raise
    without explicit Fable adjudication.

  ENV FILE:
    Secrets are read from the .env in the deploy worktree (see below).  This
    lane always writes local parquet (data/chain_snapshots/). Canonical config
    keeps the Light U-CHAIN projection disabled until its M1 rollout gates pass.
    When explicitly enabled, the standard R2 variables are also required; their
    absence fails only the post-availability projection, never the completed
    source receipt.

  LOG TAILING:
    tail -f /tmp/chainsnapshots.stdout.log /tmp/chainsnapshots.stderr.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.chainsnapshots</string>

  <key>ProgramArguments</key>
  <array>
    <!--
      run_with_env.sh sources .env before launching Python.
      Adjust python path to match your conda/venv activation.

      DEPLOY-WORKTREE DOCTRINE (M1 repair, 2026-08-11): these paths point at
      the DEDICATED shallow clone /Users/chriswong/chainsnap-ops-wt. The old
      shared flow-ops-wt is dirty, mixed-vintage, and runs unrelated jobs; it
      must never again supply this producer's code. The dedicated clone's
      data/chain_snapshots symlink retains the stopped, manifest-proven physical
      authority at /Users/chriswong/flow-ops-wt/data/chain_snapshots.
    -->
    <string>/Users/chriswong/chainsnap-ops-wt/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/chainsnap-ops-wt/.env</string>
    <string>/Users/chriswong/miniconda3/envs/plane/bin/python</string>
    <string>-m</string>
    <string>scripts.chain_snapshot_poller</string>
    <string>--rth-only</string>
  </array>

  <!--
    Working directory MUST be the dedicated deploy worktree (see doctrine
    note above), NEVER the main checkout — the main checkout's git HEAD is
    controlled by other live sessions and is not a stable deployment target.
  -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/chainsnap-ops-wt</string>

  <!--
    run_with_env.sh sources the .env file before executing the poller.
    Secrets are loaded from .env — never inlined here.
  -->

  <!--
    Mac is on Pacific time; 06:30 PT = 09:30 ET year-round (the 9:30 ET open).
    ET and PT share DST transitions so the offset (PT = ET - 3h) is constant
    year-round.  If the Mac's timezone changes, update these entries.
    The poller itself waits for actual NYSE open + 5m in RTH-only mode.
  -->
  <key>StartCalendarInterval</key>
  <array>
    <!-- Monday=1 ... Friday=5 -->
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!--
      Secrets are loaded from .env by run_with_env.sh above.
      Do NOT set secrets here — they would appear in the plist on disk.
    -->
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/chainsnap-ops-wt</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/chainsnapshots.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/chainsnapshots.stderr.log</string>

  <!-- Restart crash/nonzero exits after ThrottleInterval so a durable
       intent/decision can recover in-session. A clean RTH-only exit (0)
       stays down until the next StartCalendarInterval. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Throttle: if the job exits in under 10s (crash), wait 60s before retrying. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
