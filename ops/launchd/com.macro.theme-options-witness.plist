<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.macro.theme-options-witness.plist — launchd agent for the TIL W11
  per-theme options-tape crowding-hazard witness builder.

  Runs ops/launchd/run_theme_options_witness.sh on weekdays at 17:15 ET:
  engine.theme_options_witness (build()) + git commit/push tail for the two
  git-tracked artifacts. Scheduled after com.mastermind.optionshub (16:45 ET)
  to avoid concurrent reads from the ThetaData store.

  INSTALL (as the mac user who runs Theta Terminal — not root):
    # 1. one-time: bring flow-ops-wt to a main that CONTAINS the wrapper
    #    script (a stale worktree makes launchd exec a nonexistent path).
    #    The worktree is detached by convention; --detach keeps it so.
    git -C /Users/chriswong/flow-ops-wt fetch origin
    git -C /Users/chriswong/flow-ops-wt checkout --detach origin/main
    # 2. install the agent
    cp ops/launchd/com.macro.theme-options-witness.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.macro.theme-options-witness.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.macro.theme-options-witness.plist
    rm ~/Library/LaunchAgents/com.macro.theme-options-witness.plist

  DO NOT load this plist directly from the repo. Copy first — the repo path
  may not match the deployment path, and launchd requires the exact plist path
  when unloading.

  WORKING DIRECTORY:
    /Users/chriswong/flow-ops-wt — same ops worktree as the options hub.
    This worktree must be on a recent origin/main commit and have a .env file
    sourced via run_with_env.sh.

  ENV FILE:
    R2 credentials and THETADATA_STORE are sourced from
    /Users/chriswong/flow-ops-wt/.env via run_with_env.sh.
    Required env vars:
      THETADATA_STORE=/Users/chriswong/theta-ops-wt/data/thetadata_eod

  STORE ABSENT BEHAVIOR:
    When THETADATA_STORE is set but empty (store not yet populated), the
    builder writes an honest null artifact and exits 0 — never aborts.

  OUTPUT:
    data/neuralweb/theme_options_witness.json  (NW artifact)
    site/basketdata/options_witness.json        (compact site projection)
    Both are git-tracked. run_theme_options_witness.sh commits exactly these
    two paths and pushes to main via /Users/chriswong/witness-push-repo — a
    small standalone sparse clone with its gitdir under $HOME. TCC LAW: git
    inside flow-ops-wt is IMPOSSIBLE under launchd (its gitdir lives under
    ~/Documents, which launchd agents cannot read — verified 2026-07-12), so
    the tail runs fetch/reset/copy/commit/push in the push repo instead
    (self-healing: re-clones if absent). Two-writer coexistence with the
    daily.yml collect-lane witness step (which has no ThetaData store) is the
    engine's keep-last-real law: a store-less run skips its honest-null write
    while the committed artifact holds real legs newer than 6 days, so the
    nightly never clobbers what this lane pushed. (This closes the KNOWN GAP
    of 2026-07-12: writes landed in the worktree and nothing committed them.)

  FLOW-OPS-WT STALENESS (operator note):
    This lane runs git only in the push repo, so it does NOT advance
    flow-ops-wt. Refresh the engine-code surface occasionally (and after any
    engine change) from a normal shell:
      git -C /Users/chriswong/flow-ops-wt fetch origin
      git -C /Users/chriswong/flow-ops-wt checkout --detach origin/main

  LOG TAILING:
    tail -f /tmp/theme_options_witness.stdout.log /tmp/theme_options_witness.stderr.log

  MANUAL RUN (engine only, NO commit/push):
    set -a
    source '/Users/chriswong/flow-ops-wt/.env'
    set +a
    cd '/Users/chriswong/flow-ops-wt'
    python -m engine.theme_options_witness --date $(date +%Y-%m-%d)

  MANUAL RUN (full lane, commits + pushes):
    /Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh \
      /Users/chriswong/flow-ops-wt/.env \
      /Users/chriswong/flow-ops-wt/ops/launchd/run_theme_options_witness.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macro.theme-options-witness</string>

  <!--
    run_with_env.sh sources the .env file before executing the runner script
    (engine + commit/push tail). Args: <env_file> <script>
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/flow-ops-wt/.env</string>
    <string>/Users/chriswong/flow-ops-wt/ops/launchd/run_theme_options_witness.sh</string>
  </array>

  <!-- Working directory: same ops worktree as options hub. -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/flow-ops-wt</string>

  <!--
    Start weekdays at 17:15 ET (after options hub at 16:45 ET + ~30 min headroom).
    System timezone should be America/New_York (or adjust Hour/Minute for local tz).
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/flow-ops-wt</string>
    <!--
      THETADATA_STORE is sourced from .env via run_with_env.sh above.
      Do NOT set it here to avoid duplication / stale override.
    -->
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/theme_options_witness.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/theme_options_witness.stderr.log</string>

  <key>KeepAlive</key>
  <false/>

  <!-- Throttle: if the job crashes in under 10s, wait 60s before retrying. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
