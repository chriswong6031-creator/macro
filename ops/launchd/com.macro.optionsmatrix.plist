<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.macro.optionsmatrix.plist — launchd agent for the nightly options-matrix builder.

  Runs run_options_matrix.sh (which gates on SPY EOD store freshness, then executes
  `python -m scripts.build_options_matrix --publish`) on weekdays at 19:00 local time.

  19:00 gives the ThetaData nightly writer ~3h of headroom after the 16:00 ET close
  and ~2h after the optionshub lane (16:45). The runner script will sleep-retry up to
  6 × 20 min (2 h) if the store is not yet fresh, so even a delayed nightly write
  (reaching the store around 18:45) will be caught before any real work starts.

  INSTALL (as the mac user who owns the Theta Terminal — not root):
    cp ops/launchd/com.macro.optionsmatrix.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.macro.optionsmatrix.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.macro.optionsmatrix.plist
    rm ~/Library/LaunchAgents/com.macro.optionsmatrix.plist

  DO NOT load this plist directly from the repo. Copy first — launchd requires the
  exact plist path when unloading.

  WORKING DIRECTORY:
    /Users/chriswong/flow-ops-wt  (not the main checkout; keeps launchd out of
    ~/Documents which macOS TCC denies to launchd agents)

  ENV FILE:
    R2 credentials and THETADATA_STORE are sourced from
    /Users/chriswong/flow-ops-wt/.env via run_with_env.sh.
    NEVER inline secrets in EnvironmentVariables — use the wrapper.

    Required env vars (must be present in the .env):
      R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
      THETADATA_STORE=/Users/chriswong/theta-ops-wt/data/thetadata_eod

  SMOKE / DRY-RUN (no R2 publish — builds local JSON only):
    set -a
    source /Users/chriswong/flow-ops-wt/.env
    set +a
    MATRIX_FRESHNESS_BYPASS=1 MATRIX_NO_PUBLISH=1 \
      "/Users/chriswong/Documents/Cluade/Macro Dashboard/ops/launchd/run_options_matrix.sh"

  MANUAL RUN (full, with R2 publish — same as nightly launchd):
    set -a
    source /Users/chriswong/flow-ops-wt/.env
    set +a
    MATRIX_FRESHNESS_BYPASS=1 \
      "/Users/chriswong/Documents/Cluade/Macro Dashboard/ops/launchd/run_options_matrix.sh"

  LOG TAILING:
    tail -f /tmp/optionsmatrix.stdout.log /tmp/optionsmatrix.stderr.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.macro.optionsmatrix</string>

  <!--
    run_with_env.sh sources the .env file before executing the runner.
    Args: <env_file> <runner_script>
    The runner script is a shell script (not a Python -m invocation) because it
    contains the freshness-wait loop before handing off to Python.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/flow-ops-wt/.env</string>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard/ops/launchd/run_options_matrix.sh</string>
  </array>

  <!--
    WorkingDirectory must live outside ~/Documents to avoid macOS TCC denial
    for launchd agents. flow-ops-wt is the established pattern for this repo.
  -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/flow-ops-wt</string>

  <!--
    Start weekdays at 19:00 local time.
    System timezone should be America/New_York (or adjust Hour/Minute).
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>19</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>19</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>19</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>19</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>19</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard</string>
    <!--
      THETADATA_STORE is sourced from .env via run_with_env.sh above.
      Set it here too so the freshness-gate Python snippet can find the store
      even if the .env parse fails for any reason (belt-and-suspenders only;
      the .env value takes precedence because run_with_env.sh exports it).
    -->
    <key>THETADATA_STORE</key>
    <string>/Users/chriswong/theta-ops-wt/data/thetadata_eod</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/optionsmatrix.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/optionsmatrix.stderr.log</string>

  <key>KeepAlive</key>
  <false/>

  <!-- Throttle: if the job crashes in under 10s, wait 60s before retrying. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
