<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.mastermind.optionshub.plist — launchd agent for the nightly Options Hub builder.

  Runs build_options_hub_nightly (all available roots, --publish) on weekdays at 16:45 ET.
  The poller exits by 16:05 ET; 16:45 ET gives it 40 min of headroom before the nightly
  build reads from the same thetadata store.

  INSTALL (as the mac user who runs Theta Terminal — not root):
    cp ops/launchd/com.mastermind.optionshub.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.mastermind.optionshub.plist

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.mastermind.optionshub.plist
    rm ~/Library/LaunchAgents/com.mastermind.optionshub.plist

  DO NOT load this plist directly from the repo. Copy first — the repo path
  may not match the deployment path, and launchd requires the exact plist path
  when unloading.

  ENV FILE:
    R2 credentials and THETADATA_STORE are sourced from
    /Users/chriswong/Documents/Cluade/Macro Dashboard/.env via run_with_env.sh.
    NEVER inline secrets in EnvironmentVariables — use the wrapper.

    Required env vars:
      R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET
      THETADATA_STORE=/Users/chriswong/theta-ops-wt/data/thetadata_eod

  LOG TAILING:
    tail -f /tmp/optionshub.stdout.log /tmp/optionshub.stderr.log

  MANUAL RUN (smoke):
    set -a
    source '/Users/chriswong/Documents/Cluade/Macro Dashboard/.env'
    set +a
    cd '/Users/chriswong/Documents/Cluade/Macro Dashboard'
    python -m scripts.build_options_hub_nightly --publish
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mastermind.optionshub</string>

  <!--
    run_with_env.sh sources the .env file before executing the builder.
    Args: <env_file> <python_bin> -m <module> [flags...]
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard/ops/launchd/run_with_env.sh</string>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard/.env</string>
    <string>/opt/homebrew/Caskroom/miniconda/base/bin/python</string>
    <string>-m</string>
    <string>scripts.build_options_hub_nightly</string>
    <string>--publish</string>
  </array>

  <!-- Working directory must be the MAIN checkout (not a worktree). -->
  <key>WorkingDirectory</key>
  <string>/Users/chriswong/Documents/Cluade/Macro Dashboard</string>

  <!--
    Start weekdays at 16:45 ET.
    System timezone should be America/New_York (or adjust Hour/Minute).
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HUB_ROOT_BUDGET_S</key>
    <string>420</string>
    <key>PYTHONPATH</key>
    <string>/Users/chriswong/Documents/Cluade/Macro Dashboard</string>
    <!--
      THETADATA_STORE is sourced from .env via run_with_env.sh above.
      Do NOT set it here to avoid duplication / stale override.
    -->
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/optionshub.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/optionshub.stderr.log</string>

  <key>KeepAlive</key>
  <false/>

  <!-- Throttle: if the job crashes in under 10s, wait 60s before retrying. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

</dict>
</plist>
