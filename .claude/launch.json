{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "slate",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8123", "--directory", "tools/taskboard"],
      "port": 8123
    },
    {
      "name": "repo-root",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-c", "import os,http.server,socketserver;socketserver.TCPServer(('',int(os.environ.get('PORT') or 8899)),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "port": 8899,
      "autoPort": true
    },
    {
      "name": "macro-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-c", "import os,functools,http.server,socketserver;h=functools.partial(http.server.SimpleHTTPRequestHandler,directory='site');socketserver.TCPServer(('',int(os.environ.get('PORT') or 8847)),h).serve_forever()"],
      "port": 8847,
      "autoPort": true
    },
    {
      "name": "macro-admin",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "admin", "--port", "8791"],
      "port": 8791,
      "autoPort": false
    }
  ]
}
